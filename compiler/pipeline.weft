fn pipeline_runtime_mut_slice_address_upper_proven_hash() -> i64 {
  str_hash(__str_ptr("runtime_mut_slice_address_upper_proven"), 0, __str_len("runtime_mut_slice_address_upper_proven"))
}

fn pipeline_runtime_mut_slice_address_full_proven_hash() -> i64 {
  str_hash(__str_ptr("runtime_mut_slice_address_full_proven"), 0, __str_len("runtime_mut_slice_address_full_proven"))
}

fn pipeline_runtime_slice_address_check_mode(callee_hash: i64) -> i64 {
  if callee_hash == pipeline_runtime_slice_address_hash() or callee_hash == pipeline_runtime_mut_slice_address_hash() { 0 }
  else { if callee_hash == pipeline_runtime_slice_address_order_proven_hash() or callee_hash == pipeline_runtime_mut_slice_address_order_proven_hash() { 2 }
  else { if callee_hash == pipeline_runtime_slice_address_upper_proven_hash() or callee_hash == pipeline_runtime_mut_slice_address_upper_proven_hash() { 4 }
  else { if callee_hash == pipeline_runtime_slice_address_full_proven_hash() or callee_hash == pipeline_runtime_mut_slice_address_full_proven_hash() { 6 } else { 0 - 1 } } } }
}

fn pipeline_runtime_slice_address_mutability(callee_hash: i64) -> i64 {
  if pipeline_runtime_slice_address_check_mode(callee_hash) < 0 { 0 - 1 }
  else {
    if callee_hash == pipeline_runtime_mut_slice_address_hash() or callee_hash == pipeline_runtime_mut_slice_address_order_proven_hash() or callee_hash == pipeline_runtime_mut_slice_address_upper_proven_hash() or callee_hash == pipeline_runtime_mut_slice_address_full_proven_hash() { 1 } else { 0 }
  }
}

fn pipeline_runtime_slice_address_is_abi_hash(callee_hash: i64) -> i64 {
  if pipeline_runtime_slice_address_check_mode(callee_hash) >= 0 { 1 } else { 0 }
}

fn pipeline_runtime_slice_address_hash_for_mode(mutable: i64, check_mode: i64) -> i64 {
  if mutable == 1 {
    if check_mode == 6 { pipeline_runtime_mut_slice_address_full_proven_hash() }
    else { if check_mode == 4 { pipeline_runtime_mut_slice_address_upper_proven_hash() }
    else { if check_mode == 2 { pipeline_runtime_mut_slice_address_order_proven_hash() }
    else { pipeline_runtime_mut_slice_address_hash() } } }
  } else {
    if check_mode == 6 { pipeline_runtime_slice_address_full_proven_hash() }
    else { if check_mode == 4 { pipeline_runtime_slice_address_upper_proven_hash() }
    else { if check_mode == 2 { pipeline_runtime_slice_address_order_proven_hash() }
    else { pipeline_runtime_slice_address_hash() } } }
  }
}

fn pipeline_runtime_slice_address_hashes() -> i64 {
  let hashes = nlist_new()
  nlist_add(hashes, pipeline_runtime_slice_address_hash())
  nlist_add(hashes, pipeline_runtime_slice_address_order_proven_hash())
  nlist_add(hashes, pipeline_runtime_slice_address_upper_proven_hash())
  nlist_add(hashes, pipeline_runtime_slice_address_full_proven_hash())
  nlist_add(hashes, pipeline_runtime_mut_slice_address_hash())
  nlist_add(hashes, pipeline_runtime_mut_slice_address_order_proven_hash())
  nlist_add(hashes, pipeline_runtime_mut_slice_address_upper_proven_hash())
  nlist_add(hashes, pipeline_runtime_mut_slice_address_full_proven_hash())
  hashes
}

fn pipeline_array_literal_leaf_stride(tt: i64, array_ty: i64) -> i64 {
  if cg_layout_array_leaf_count(array_ty) == 0 { 0 } else { cg_layout_array_leaf_stride(tt, array_ty) }
}

fn pipeline_array_literal_leaf_kind(tt: i64, array_ty: i64) -> i64 {
  if cg_layout_array_leaf_count(array_ty) == 0 { continuation_cleanup_kind_none() }
  else { cg_layout_array_leaf_drop_kind(tt, array_ty) }
}

fn pipeline_array_literal_layout_is_valid(tt: i64, array_ty: i64, element_count: i64) -> i64 {
  if not ty_is_array(array_ty) or ty_array_length(array_ty) != element_count { 0 }
  else {
    let byte_size = cg_layout_array_size(tt, array_ty)
    let align = cg_layout_array_align(tt, array_ty)
    let leaf_count = cg_layout_array_leaf_count(array_ty)
    let leaf_stride = pipeline_array_literal_leaf_stride(tt, array_ty)
    let leaf_kind = pipeline_array_literal_leaf_kind(tt, array_ty)
    if byte_size < 0 or align <= 0 or leaf_count < 0 { 0 }
    else { if element_count > 0 and (cg_layout_array_stride(tt, array_ty) <= 0 or cg_layout_array_element_size(tt, array_ty) <= 0) { 0 }
    else { pipeline_array_copy_plan_is_valid(byte_size, leaf_count, leaf_stride, leaf_kind) } }
  }
}

-- Allocate and publish the managed owner before any element is evaluated.
-- rc_array_storage_new returns zeroed backing, so J3 may safely release the
-- owner if a later element aborts while managed slots remain uninitialised.
fn pipeline_lower_array_literal_storage(array_ty: i64, element_count: i64, next_value: i64, tt: i64) -> IrLoweredExpr {
  if pipeline_array_literal_layout_is_valid(tt, array_ty, element_count) == 0 {
    ir_lowered_expr_invalid(next_value)
  } else {
    let byte_size = cg_layout_array_size(tt, array_ty)
    let align = cg_layout_array_align(tt, array_ty)
    let leaf_count = cg_layout_array_leaf_count(array_ty)
    let leaf_stride = pipeline_array_literal_leaf_stride(tt, array_ty)
    let leaf_kind = pipeline_array_literal_leaf_kind(tt, array_ty)
    let storage = next_value
    let byte_size_value = storage + 1
    let align_value = storage + 2
    let leaf_count_value = storage + 3
    let leaf_stride_value = storage + 4
    let leaf_kind_value = storage + 5
    let data = storage + 6
    let insts = ir_inst_list_prepend(
      ir_inst_const_i64(byte_size_value, byte_size),
      ir_inst_list_prepend(
        ir_inst_const_i64(align_value, align),
        ir_inst_list_prepend(
          ir_inst_const_i64(leaf_count_value, leaf_count),
          ir_inst_list_prepend(
            ir_inst_const_i64(leaf_stride_value, leaf_stride),
            ir_inst_list_prepend(
              ir_inst_const_i64(leaf_kind_value, leaf_kind),
              ir_inst_list_prepend(
                ir_inst_call_i64(storage, pipeline_rc_array_storage_new_hash(), pipeline_ir_array_storage_new_args(byte_size_value, align_value, leaf_count_value, leaf_stride_value, leaf_kind_value)),
                ir_inst_list_prepend(
                  ir_inst_call_i64(data, pipeline_rc_array_storage_data_hash(), ir_value_list_prepend(storage, ir_value_list_empty())),
                  ir_inst_list_empty()
                )
              )
            )
          )
        )
      )
    )
    ir_lowered_expr(storage, data + 1, insts)
  }
}

fn pipeline_array_literal_element_prim(array_ty: i64) -> i64 {
  let element_ty = if ty_is_array(array_ty) { ty_array_inner(array_ty) } else { 0 }
  if element_ty != 0 and ty_tag(element_ty) == 2 { ty_f1(element_ty) } else { 0 - 1 }
}

-- Store one already-evaluated element using only typed layout/ownership facts.
-- Managed scalar leaves acquire an independent container stake; owned
-- temporaries then release their evaluation stake. Nested arrays copy their
-- inline bytes (retaining leaves) and release only owned source handles.
fn pipeline_lower_array_literal_store_value_typed(element: Expr, value: i64, data: i64, index: i64, array_ty: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> PipelineLoweredArgs {
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let fns = pipeline_handler_lower_ctx_fns(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  let element_ty = ty_array_inner(array_ty)
  let stride = cg_layout_array_stride(tt, array_ty)
  let size = cg_layout_array_element_size(tt, array_ty)
  let offset = cg_layout_checked_mul_nonnegative(index, stride)
  if size <= 0 or stride <= 0 or offset < 0 { pipeline_lowered_args_invalid(next_value) }
  else {
    let offset_value = next_value
    let addr = offset_value + 1
    let prefix = ir_inst_list_prepend(
      ir_inst_const_i64(offset_value, offset),
      ir_inst_list_prepend(ir_inst_binary_i64(addr, ir_binary_op_add(), data, offset_value), ir_inst_list_empty())
    )
    let borrowed = pipeline_expr_result_is_borrowed_for_ty_typed(element, element_ty, src, fns, subst, tt)
    if ty_is_array(element_ty) {
      let leaf_count = cg_layout_array_leaf_count(element_ty)
      let leaf_stride = pipeline_array_literal_leaf_stride(tt, element_ty)
      let leaf_kind = pipeline_array_literal_leaf_kind(tt, element_ty)
      if pipeline_array_copy_plan_is_valid(size, leaf_count, leaf_stride, leaf_kind) == 0 {
        pipeline_lowered_args_invalid(next_value)
      } else {
        let src_data = addr + 1
        let copy = ir_inst_list_prepend(
          ir_inst_call_i64(src_data, pipeline_rc_array_storage_data_hash(), ir_value_list_prepend(value, ir_value_list_empty())),
          ir_inst_list_prepend(ir_inst_array_copy_i64(addr, src_data, size, leaf_count, leaf_stride, leaf_kind), ir_inst_list_empty())
        )
        let release = if borrowed == 0 {
          ir_inst_list_prepend(ir_inst_call_i64(src_data + 1, pipeline_rc_default_release_hash(), ir_value_list_prepend(value, ir_value_list_empty())), ir_inst_list_empty())
        } else { ir_inst_list_empty() }
        let next = if borrowed == 0 { src_data + 2 } else { src_data + 1 }
        pipeline_lowered_args(ir_value_list_empty(), next, ir_inst_list_append(prefix, ir_inst_list_append(copy, release)), 1)
      }
    } else { if cg_layout_vector_record_inline_eligible(tt, element_ty) == 1 {
      let size_value = addr + 1
      let mode_value = size_value + 1
      let store_dst = mode_value + 1
      let type_args = nlist_new_capacity(1)
      nlist_add(type_args, element_ty)
      let store_args = ir_value_list_prepend(addr, ir_value_list_prepend(size_value, ir_value_list_prepend(mode_value, ir_value_list_prepend(value, ir_value_list_empty()))))
      let store = ir_inst_list_prepend(ir_inst_generic_call_i64(store_dst, pipeline_ir_native_vector_storage_store_value_hash(), type_args, store_args), ir_inst_list_empty())
      let release = if borrowed == 0 {
        ir_inst_list_prepend(ir_inst_call_i64(store_dst + 1, pipeline_rc_default_release_hash(), ir_value_list_prepend(value, ir_value_list_empty())), ir_inst_list_empty())
      } else { ir_inst_list_empty() }
      let next = if borrowed == 0 { store_dst + 2 } else { store_dst + 1 }
      let facts = ir_inst_list_prepend(
        ir_inst_const_i64(size_value, size),
        ir_inst_list_prepend(ir_inst_const_i64(mode_value, cg_layout_indexed_element_mode(tt, element_ty)), ir_inst_list_empty())
      )
      pipeline_lowered_args(ir_value_list_empty(), next, ir_inst_list_append(prefix, ir_inst_list_append(facts, ir_inst_list_append(store, release))), 1)
    } else {
      let size_value = addr + 1
      let mode_value = size_value + 1
      let drop_kind = cg_managed_drop_kind_for_ty(element_ty)
      let retain_hash = pipeline_managed_retain_hash_for_kind(drop_kind)
      let retain_dst = mode_value + 1
      let retain = if retain_hash != 0 {
        ir_inst_list_prepend(ir_inst_call_i64(retain_dst, retain_hash, ir_value_list_prepend(value, ir_value_list_empty())), ir_inst_list_empty())
      } else { ir_inst_list_empty() }
      let store_dst = if retain_hash != 0 { retain_dst + 1 } else { retain_dst }
      let store_args = ir_value_list_prepend(addr, ir_value_list_prepend(size_value, ir_value_list_prepend(mode_value, ir_value_list_prepend(value, ir_value_list_empty()))))
      let store = ir_inst_list_prepend(ir_inst_call_i64(store_dst, pipeline_ir_native_intrinsic_mem_store_sized_hash(), store_args), ir_inst_list_empty())
      let release_hash = pipeline_managed_release_hash_for_kind(drop_kind)
      let release = if borrowed == 0 and release_hash != 0 {
        ir_inst_list_prepend(ir_inst_call_i64(store_dst + 1, release_hash, ir_value_list_prepend(value, ir_value_list_empty())), ir_inst_list_empty())
      } else { ir_inst_list_empty() }
      let next = if borrowed == 0 and release_hash != 0 { store_dst + 2 } else { store_dst + 1 }
      let facts = ir_inst_list_prepend(
        ir_inst_const_i64(size_value, size),
        ir_inst_list_prepend(ir_inst_const_i64(mode_value, cg_layout_array_element_mode(tt, array_ty)), ir_inst_list_empty())
      )
      pipeline_lowered_args(ir_value_list_empty(), next, ir_inst_list_append(prefix, ir_inst_list_append(facts, ir_inst_list_append(retain, ir_inst_list_append(store, release)))), 1)
    } }
  }
}

fn pipeline_rc_default_weak_release_hash() -> i64 {
  str_hash(__str_ptr("rc_default_weak_release"), 0, __str_len("rc_default_weak_release"))
}

fn pipeline_closure_default_release_hash() -> i64 {
  str_hash(__str_ptr("closure_default_release"), 0, __str_len("closure_default_release"))
}

fn pipeline_managed_release_hash_for_kind(kind: i64) -> i64 {
  if kind == continuation_cleanup_kind_rc() { pipeline_rc_default_release_hash() }
  else { if kind == continuation_cleanup_kind_closure() { pipeline_closure_default_release_hash() }
  else { if kind == continuation_cleanup_kind_weak() { pipeline_rc_default_weak_release_hash() }
  else { 0 } } }
}

fn pipeline_managed_retain_hash_for_kind(kind: i64) -> i64 {
  if kind == continuation_cleanup_kind_rc() { pipeline_rc_default_retain_hash() }
  else { if kind == continuation_cleanup_kind_closure() { pipeline_closure_default_retain_hash() }
  else { if kind == continuation_cleanup_kind_weak() { pipeline_rc_default_weak_retain_hash() }
  else { 0 } } }
}

-- Domain-separated synthetic key for one generated array destruction plan.
-- Function/name hashes already use a 64-bit key without collision recovery;
-- this follows the same contract while retaining every plan component.
fn pipeline_array_drop_glue_hash(leaf_count: i64, leaf_stride: i64, leaf_kind: i64) -> i64 {
  let raw = (((4705214434749537 * 33 + leaf_count) * 33 + leaf_stride) * 33 + leaf_kind) band 9223372036854775807
  if raw == 0 { 4705214434749537 } else { raw }
}

fn pipeline_array_drop_plan_is_active(leaf_count: i64, leaf_stride: i64, leaf_kind: i64) -> i64 {
  if leaf_count > 0 and leaf_stride > 0 and pipeline_managed_release_hash_for_kind(leaf_kind) != 0 { 1 } else { 0 }
}

fn pipeline_array_drop_plan_is_valid(leaf_count: i64, leaf_stride: i64, leaf_kind: i64) -> i64 {
  if leaf_count < 0 or leaf_stride < 0 { 0 }
  else { if leaf_kind == continuation_cleanup_kind_none() { 1 }
  else { pipeline_array_drop_plan_is_active(leaf_count, leaf_stride, leaf_kind) } }
}

-- Copy/retain glue has a separate synthetic identity from destruction glue:
-- both may coexist for the same shape in one native code stream.
fn pipeline_array_copy_retain_glue_hash(leaf_count: i64, leaf_stride: i64, leaf_kind: i64) -> i64 {
  let raw = (((4705214434749589 * 33 + leaf_count) * 33 + leaf_stride) * 33 + leaf_kind) band 9223372036854775807
  if raw == 0 { 4705214434749589 } else { raw }
}

fn pipeline_array_copy_plan_is_valid(byte_size: i64, leaf_count: i64, leaf_stride: i64, leaf_kind: i64) -> i64 {
  if byte_size < 0 or pipeline_array_drop_plan_is_valid(leaf_count, leaf_stride, leaf_kind) == 0 { 0 }
  else { if pipeline_array_drop_plan_is_active(leaf_count, leaf_stride, leaf_kind) == 0 { 1 }
  else {
    let last = cg_layout_checked_mul_nonnegative(leaf_count - 1, leaf_stride)
    if last < 0 or last > 9223372036854775799 { 0 }
    else { if last + 8 <= byte_size { 1 } else { 0 } }
  } }
}

fn pipeline_managed_release_inst_list(value: i64, ty: i64, dst: i64) -> IrInstList {
  if value < 0 { ir_inst_list_empty() }
  else { pipeline_managed_release_lane_inst_list(value, ty, pipeline_type_value_lane_count_or_one(ty) - 1, dst) }
}

fn pipeline_managed_release_lane_inst_list(value: i64, ty: i64, lane: i64, dst: i64) -> IrInstList {
  if lane < 0 { ir_inst_list_empty() }
  else {
    let callee = pipeline_managed_release_hash_for_kind(pipeline_type_value_lane_release_kind(ty, lane))
    if callee == 0 { pipeline_managed_release_lane_inst_list(value, ty, lane - 1, dst) }
    else {
      let current = ir_inst_call_i64(dst, callee, ir_value_list_prepend(value + lane, ir_value_list_empty()))
      ir_inst_list_prepend(current, pipeline_managed_release_lane_inst_list(value, ty, lane - 1, dst + 1))
    }
  }
}

-- Per-arm ownership normalization for control-flow merges (2q slice 2):
-- when an if/match result mixes borrowed and owned arms, the whole-expr
-- classifier reports owned, so every consumer (return transfer, let
-- retain, arg borrow-retain, masked temp release) treats the merged
-- value as carrying a count. A borrowed arm must retain on its way to
-- the merge or consumers under-retain (vector_get's default param arm
-- dangles). All-borrowed merges classify borrowed and need no arm
-- retains; all-owned arms already carry their count.
fn pipeline_managed_arm_needs_retain(arm_borrowed: i64, whole_borrowed: i64, ty: i64) -> i64 {
  if arm_borrowed == 1 and whole_borrowed == 0 and ty != 0 and ty_is_continuation(ty) == 0 {
    ty_value_has_release_lane(ty)
  } else { 0 }
}

-- Interposes a retain block between a lowered merge arm and its target:
-- the arm was lowered targeting retain_block; the appended block takes
-- the arm result as its param, retains it, and forwards to the real
-- target. No-op when no retain is needed or the arm never reaches its
-- target (the reserved block id stays unused, which is harmless).
fn pipeline_managed_arm_retain_append(arm_blocks: PipelineLoweredBlocks, needs_retain: i64, ty: i64, retain_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  if needs_retain == 0 or pipeline_lowered_blocks_is_valid(arm_blocks) == 0 or pipeline_lowered_blocks_falls_through(arm_blocks) == 0 {
    arm_blocks
  } else {
    let param_value = pipeline_lowered_blocks_next_value(arm_blocks)
    let lanes = pipeline_type_value_lane_count_or_one(ty)
    let params = pipeline_ir_value_lane_ids(param_value, 0, lanes)
    let retain_insts = pipeline_managed_retain_inst_list(param_value, ty, param_value + lanes)
    let block = ir_block_new_params(retain_block, params, retain_insts, ir_term_jump_args(target_block, params))
    pipeline_lowered_blocks_control(
      pipeline_lowered_blocks_next_block(arm_blocks),
      param_value + lanes + ir_inst_list_len(retain_insts),
      ir_block_list_append(pipeline_lowered_blocks_blocks(arm_blocks), ir_block_list_prepend(block, ir_block_list_empty())),
      1,
      1
    )
  }
}

fn pipeline_managed_retain_inst_list(value: i64, ty: i64, dst: i64) -> IrInstList {
  if value < 0 { ir_inst_list_empty() }
  else { pipeline_managed_retain_lane_inst_list(value, ty, 0, pipeline_type_value_lane_count_or_one(ty), dst) }
}

fn pipeline_managed_retain_lane_inst_list(value: i64, ty: i64, lane: i64, lanes: i64, dst: i64) -> IrInstList {
  if lane >= lanes { ir_inst_list_empty() }
  else {
    let callee = pipeline_managed_retain_hash_for_kind(pipeline_type_value_lane_release_kind(ty, lane))
    if callee == 0 { pipeline_managed_retain_lane_inst_list(value, ty, lane + 1, lanes, dst) }
    else {
      let current = ir_inst_call_i64(dst, callee, ir_value_list_prepend(value + lane, ir_value_list_empty()))
      ir_inst_list_prepend(current, pipeline_managed_retain_lane_inst_list(value, ty, lane + 1, lanes, dst + 1))
    }
  }
}

fn pipeline_managed_borrow_retain_arg_typed(expr: Expr, value: i64, expected_ty: i64, next_value: i64, src: i64, fns: i64, subst: i64, tt: i64) -> PipelineLoweredArgs {
  let insts = if expected_ty != 0 and pipeline_expr_result_is_borrowed_for_ty_typed(expr, expected_ty, src, fns, subst, tt) == 1 {
    pipeline_managed_retain_inst_list(value, expected_ty, next_value)
  } else {
    ir_inst_list_empty()
  }
  let next = next_value + ir_inst_list_len(insts)
  pipeline_lowered_args(ir_value_list_empty(), next, insts, 1)
}

fn pipeline_managed_borrow_retain_arg_node(arg_node: i64, value: i64, expected_ty: i64, next_value: i64, src: i64, fns: i64, subst: i64, tt: i64) -> PipelineLoweredArgs {
  let insts = if expected_ty != 0 and pipeline_expr_node_result_is_borrowed_for_ty_typed(arg_node, expected_ty, src, fns, subst, tt) == 1 {
    pipeline_managed_retain_inst_list(value, expected_ty, next_value)
  } else {
    ir_inst_list_empty()
  }
  let next = next_value + ir_inst_list_len(insts)
  pipeline_lowered_args(ir_value_list_empty(), next, insts, 1)
}

fn pipeline_expr_owned_temp_drop_kind_typed(expr: Expr) -> i64 {
  match expr {
    Lambda(params, body) -> continuation_cleanup_kind_closure()
    LetTyped(inner, ann_type) -> pipeline_expr_owned_temp_drop_kind_typed(inner)
    Block(first, rest) -> pipeline_expr_owned_temp_drop_kind_typed(rest)
    _ -> continuation_cleanup_kind_none()
  }
}

fn pipeline_managed_temp_release_inst_list(value: i64, expected_ty: i64, fallback_kind: i64, next_value: i64) -> IrInstList {
  if value < 0 { ir_inst_list_empty() }
  else { if expected_ty != 0 and ty_value_has_release_lane(expected_ty) == 1 {
    pipeline_managed_release_inst_list(value, expected_ty, next_value)
  } else {
    let callee = pipeline_managed_release_hash_for_kind(fallback_kind)
    if callee == 0 { ir_inst_list_empty() }
    else { ir_inst_list_prepend(ir_inst_call_i64(next_value, callee, ir_value_list_prepend(value, ir_value_list_empty())), ir_inst_list_empty()) }
  } }
}

-- Owned managed rvalue temporaries at call-argument position (2q slice
-- 2): call results are owned — mode-8 vector loads retain — so a
-- call/method/ctor/record arg carries a count the caller must release
-- after the call when the callee only borrows the param. Idents, field
-- loads, and other borrowed shapes stay with their owners.
fn pipeline_expr_owned_rvalue_temp_typed(expr: Expr, src: i64, tt: i64) -> i64 {
  match expr {
    Call(ns, nl, args) -> 1
    GenericCall(type_args, inner_call) -> {
      match inner_call {
        Call(ns, nl, args) -> 1
        _ -> pipeline_expr_owned_rvalue_temp_typed(inner_call, src, tt)
      }
    }
    MethodCall(recv, method_hash, args, type_hash) -> 1
    RecordInit(type_ns, type_nl, fields) -> 1
    ArrayLiteral(elements, resolved_ty, span) -> 1
    IndexedGet(base, index, element_ty, fixed_len) -> 1
    IndexedSet(base, index, value, fact) -> 0
    IndexedSlice(base, start, end, fact) -> 0
    Ident(ns, nl) -> pipeline_ident_is_payloadless_ctor(tt, src, ns, nl)
    LetTyped(inner, ann_type) -> pipeline_expr_owned_rvalue_temp_typed(inner, src, tt)
    Block(first, rest) -> pipeline_expr_owned_rvalue_temp_typed(rest, src, tt)
    _ -> 0
  }
}

fn pipeline_expr_node_owned_rvalue_temp_typed(expr: i64, src: i64, tt: i64) -> i64 {
  let stripped = pipeline_expr_node_strip_typed(expr)
  if stripped == 0 { 0 } else { pipeline_expr_owned_rvalue_temp_typed(expr_from_node(stripped), src, tt) }
}

-- An array projection materialises a fresh default-managed backing. It is an
-- owned temporary even though ordinary scalar/managed field projections stay
-- borrowed from their record owner.
fn pipeline_expr_owned_array_value_typed(expr: Expr, expected_ty: i64, src: i64, fns: i64, subst: i64, tt: i64) -> i64 {
  if expected_ty != 0 and ty_is_array(expected_ty) and pipeline_array_expr_result_is_borrowed_typed(expr, src, fns, subst, tt) == 0 { 1 }
  else { 0 }
}

fn pipeline_expr_node_owned_array_value_typed(expr: i64, expected_ty: i64, src: i64, fns: i64, subst: i64, tt: i64) -> i64 {
  let stripped = pipeline_expr_node_strip_typed(expr)
  if stripped == 0 { 0 }
  else { pipeline_expr_owned_array_value_typed(expr_from_node(stripped), expected_ty, src, fns, subst, tt) }
}

fn pipeline_expr_node_owned_temp_drop_kind_typed(expr: i64) -> i64 {
  let stripped = pipeline_expr_node_strip_typed(expr)
  if stripped == 0 { continuation_cleanup_kind_none() } else { pipeline_expr_owned_temp_drop_kind_typed(expr_from_node(stripped)) }
}

fn pipeline_managed_owned_temp_release_args_typed(args: ExprList, values: IrValueList, index: i64, next_value: i64, expected_params: i64, expected_types: i64, expected_subst: i64, expected_offset: i64) -> PipelineLoweredArgs {
  match args {
    ExprListNil -> pipeline_lowered_args(ir_value_list_empty(), next_value, ir_inst_list_empty(), 1)
    ExprListCons(expr, rest_exprs) -> {
      let expected_ty = pipeline_expected_arg_type_node(expected_params, expected_types, index, expected_offset, expected_subst)
      let expr_kind = pipeline_expr_owned_temp_drop_kind_typed(expr)
      let value = pipeline_ir_value_list_get_or(values, index, 0 - 1)
      let release_insts = if expr_kind != continuation_cleanup_kind_none() { pipeline_managed_temp_release_inst_list(value, expected_ty, expr_kind, next_value) } else { ir_inst_list_empty() }
      let next_after_release = next_value + ir_inst_list_len(release_insts)
      let rest = pipeline_managed_owned_temp_release_args_typed(rest_exprs, values, index + 1, next_after_release, expected_params, expected_types, expected_subst, expected_offset)
      if pipeline_lowered_args_is_valid(rest) == 1 {
        pipeline_lowered_args(ir_value_list_empty(), pipeline_lowered_args_next_value(rest), ir_inst_list_append(release_insts, pipeline_lowered_args_insts(rest)), 1)
      } else {
        pipeline_lowered_args_invalid(next_value)
      }
    }
  }
}

fn pipeline_managed_owned_temp_release_arg_nodes(args: i64, arg_count: i64, values: IrValueList, index: i64, next_value: i64, expected_params: i64, expected_types: i64, expected_subst: i64, expected_offset: i64) -> PipelineLoweredArgs {
  if index >= arg_count {
    pipeline_lowered_args(ir_value_list_empty(), next_value, ir_inst_list_empty(), 1)
  } else {
    let expected_ty = pipeline_expected_arg_type_node(expected_params, expected_types, index, expected_offset, expected_subst)
    let arg_node = nlist_get(args, index)
    let expr_kind = pipeline_expr_node_owned_temp_drop_kind_typed(arg_node)
    let value = pipeline_ir_value_list_get_or(values, index, 0 - 1)
    let release_insts = if expr_kind != continuation_cleanup_kind_none() { pipeline_managed_temp_release_inst_list(value, expected_ty, expr_kind, next_value) } else { ir_inst_list_empty() }
    let next_after_release = next_value + ir_inst_list_len(release_insts)
    let rest = pipeline_managed_owned_temp_release_arg_nodes(args, arg_count, values, index + 1, next_after_release, expected_params, expected_types, expected_subst, expected_offset)
    if pipeline_lowered_args_is_valid(rest) == 1 {
      pipeline_lowered_args(ir_value_list_empty(), pipeline_lowered_args_next_value(rest), ir_inst_list_append(release_insts, pipeline_lowered_args_insts(rest)), 1)
    } else {
      pipeline_lowered_args_invalid(next_value)
    }
  }
}

-- Caller-side release for owned temporaries passed to BORROWED params
-- (2q slice 1b, generalized in slice 2). Ownership algebra: a lambda or
-- managed-rvalue arg (call/method/ctor/record result) is a temp the
-- caller owns with count 1. A callee that owns the param releases it at
-- return; a borrow-classified param is never released by the callee, so
-- the caller must release after the call or the temp leaks per
-- execution. Static named-fn pairs and immediates flow through the same
-- release and no-op on the magic guard.
-- mask_offset mirrors expected_offset in the arg-lowering helpers: the
-- borrow mask is indexed by callee param position, and method calls
-- shift args by one for the receiver.
fn pipeline_managed_temp_release_arg_kind(expr_kind: i64, is_rvalue_temp: i64, expected_params: i64, expected_types: i64, index: i64, mask_offset: i64, expected_subst: i64) -> i64 {
  if expr_kind != continuation_cleanup_kind_none() { expr_kind }
  else {
    if is_rvalue_temp == 1 {
      cg_managed_drop_kind_for_ty(pipeline_expected_arg_type_node(expected_params, expected_types, index, mask_offset, expected_subst))
    } else { continuation_cleanup_kind_none() }
  }
}

fn pipeline_managed_lambda_temp_release_args_masked_typed(args: ExprList, values: IrValueList, index: i64, next_value: i64, borrowed_mask: i64, mask_offset: i64, expected_params: i64, expected_types: i64, expected_subst: i64, src: i64, tt: i64) -> PipelineLoweredArgs {
  match args {
    ExprListNil -> pipeline_lowered_args(ir_value_list_empty(), next_value, ir_inst_list_empty(), 1)
    ExprListCons(expr, rest_exprs) -> {
      let expr_kind = pipeline_expr_owned_temp_drop_kind_typed(expr)
      let expected_ty = pipeline_expected_arg_type_node(expected_params, expected_types, index, mask_offset, expected_subst)
      let is_rvalue_temp = if pipeline_expr_owned_rvalue_temp_typed(expr, src, tt) == 1 { 1 }
        else { pipeline_expr_owned_array_value_typed(expr, expected_ty, src, 0, expected_subst, tt) }
      let drop_kind = pipeline_managed_temp_release_arg_kind(expr_kind, is_rvalue_temp, expected_params, expected_types, index, mask_offset, expected_subst)
      let value = pipeline_ir_value_list_get_or(values, index, 0 - 1)
      let needs_release = if drop_kind != continuation_cleanup_kind_none() or (is_rvalue_temp == 1 and ty_value_has_release_lane(expected_ty) == 1) { 1 } else { 0 }
      let release_insts = if needs_release == 1 and value >= 0 and cg_mask_has(borrowed_mask, index + mask_offset) == 1 {
        pipeline_managed_temp_release_inst_list(value, expected_ty, drop_kind, next_value)
      } else { ir_inst_list_empty() }
      let next_after_release = next_value + ir_inst_list_len(release_insts)
      let rest = pipeline_managed_lambda_temp_release_args_masked_typed(rest_exprs, values, index + 1, next_after_release, borrowed_mask, mask_offset, expected_params, expected_types, expected_subst, src, tt)
      pipeline_lowered_args(ir_value_list_empty(), pipeline_lowered_args_next_value(rest), ir_inst_list_append(release_insts, pipeline_lowered_args_insts(rest)), 1)
    }
  }
}

fn pipeline_managed_lambda_temp_release_arg_nodes_masked(args: i64, arg_count: i64, values: IrValueList, index: i64, next_value: i64, borrowed_mask: i64, mask_offset: i64, expected_params: i64, expected_types: i64, expected_subst: i64, src: i64, tt: i64) -> PipelineLoweredArgs {
  if index >= arg_count {
    pipeline_lowered_args(ir_value_list_empty(), next_value, ir_inst_list_empty(), 1)
  } else {
    let arg_node = nlist_get(args, index)
    let expr_kind = pipeline_expr_node_owned_temp_drop_kind_typed(arg_node)
    let expected_ty = pipeline_expected_arg_type_node(expected_params, expected_types, index, mask_offset, expected_subst)
    let is_rvalue_temp = if pipeline_expr_node_owned_rvalue_temp_typed(arg_node, src, tt) == 1 { 1 }
      else { pipeline_expr_node_owned_array_value_typed(arg_node, expected_ty, src, 0, expected_subst, tt) }
    let drop_kind = pipeline_managed_temp_release_arg_kind(expr_kind, is_rvalue_temp, expected_params, expected_types, index, mask_offset, expected_subst)
    let value = pipeline_ir_value_list_get_or(values, index, 0 - 1)
    let needs_release = if drop_kind != continuation_cleanup_kind_none() or (is_rvalue_temp == 1 and ty_value_has_release_lane(expected_ty) == 1) { 1 } else { 0 }
    let release_insts = if needs_release == 1 and value >= 0 and cg_mask_has(borrowed_mask, index + mask_offset) == 1 {
      pipeline_managed_temp_release_inst_list(value, expected_ty, drop_kind, next_value)
    } else { ir_inst_list_empty() }
    let next_after_release = next_value + ir_inst_list_len(release_insts)
    let rest = pipeline_managed_lambda_temp_release_arg_nodes_masked(args, arg_count, values, index + 1, next_after_release, borrowed_mask, mask_offset, expected_params, expected_types, expected_subst, src, tt)
    pipeline_lowered_args(ir_value_list_empty(), pipeline_lowered_args_next_value(rest), ir_inst_list_append(release_insts, pipeline_lowered_args_insts(rest)), 1)
  }
}

fn pipeline_lower_weak_call_typed_to_target_blocks(src: i64, ns: i64, nl: i64, args_expr: ExprList, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let arg_count = expr_list_len(args_expr)
  if arg_count != 1 {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  } else {
    if src_eq(src, ns, nl, "weak_ref") == 1 or src_eq(src, ns, nl, "weak_load") == 1 {
      let call_block = next_block
      let first_arg_block = pipeline_lower_operation_child_start_block(call_block, arg_count)
      let lowered_args = pipeline_lower_call_arg_blocks_typed(args_expr, arg_count, params, locals, module, call_block, 0, 0, pipeline_lower_module_subst(module), 0, 0, next_value, first_arg_block, ir_value_list_empty())
      if pipeline_lowered_call_blocks_is_valid(lowered_args) == 1 {
        let entry = ir_block_new_term(start_block, ir_inst_list_empty(), ir_term_jump(first_arg_block))
        if pipeline_lowered_call_blocks_falls_through(lowered_args) == 0 {
          let blocks = ir_block_list_prepend(entry, pipeline_lowered_call_blocks_blocks(lowered_args))
          pipeline_lowered_blocks_control(pipeline_lowered_call_blocks_next_block(lowered_args), pipeline_lowered_call_blocks_next_value(lowered_args), blocks, 1, 0)
        } else {
          let value = pipeline_ir_value_list_get_or(pipeline_lowered_call_blocks_values(lowered_args), 0, 0 - 1)
          let dst = pipeline_lowered_call_blocks_next_value(lowered_args)
          let runtime_hash = if src_eq(src, ns, nl, "weak_ref") == 1 { pipeline_rc_default_weak_retain_hash() } else { pipeline_rc_default_weak_load_hash() }
          let runtime_args = ir_value_list_prepend(value, ir_value_list_empty())
          let call_inst = ir_inst_list_prepend(ir_inst_call_i64(dst, runtime_hash, runtime_args), ir_inst_list_empty())
          let result_value = if src_eq(src, ns, nl, "weak_ref") == 1 { value } else { dst }
          let call_args = ir_value_list_prepend(result_value, ir_value_list_empty())
          let call = ir_block_new_term(call_block, call_inst, ir_term_jump_args(target_block, call_args))
          let blocks = ir_block_list_prepend(entry, ir_block_list_append(pipeline_lowered_call_blocks_blocks(lowered_args), ir_block_list_prepend(call, ir_block_list_empty())))
          pipeline_lowered_blocks(pipeline_lowered_call_blocks_next_block(lowered_args), dst + 1, blocks, 1)
        }
      } else {
        pipeline_lowered_blocks_invalid(start_block, next_value)
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  }
}

fn pipeline_lower_bridge_mem_call_typed_to_target_blocks(kind: i64, args_expr: ExprList, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  if kind == 0 {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  } else {
    let call_block = next_block
    let arg_count = expr_list_len(args_expr)
    let first_arg_block = pipeline_lower_operation_child_start_block(call_block, arg_count)
    let lowered_args = pipeline_lower_call_arg_blocks_typed(args_expr, arg_count, params, locals, module, call_block, 0, 0, pipeline_lower_module_subst(module), 0, 0, next_value, first_arg_block, ir_value_list_empty())
    if pipeline_lowered_call_blocks_is_valid(lowered_args) == 1 {
      let entry = ir_block_new_term(start_block, ir_inst_list_empty(), ir_term_jump(first_arg_block))
      if pipeline_lowered_call_blocks_falls_through(lowered_args) == 0 {
        let blocks = ir_block_list_prepend(entry, pipeline_lowered_call_blocks_blocks(lowered_args))
        pipeline_lowered_blocks_control(pipeline_lowered_call_blocks_next_block(lowered_args), pipeline_lowered_call_blocks_next_value(lowered_args), blocks, 1, 0)
      } else {
        let values = pipeline_lowered_call_blocks_values(lowered_args)
        let base = pipeline_ir_value_list_get_or(values, 0, 0 - 1)
        let index = pipeline_ir_value_list_get_or(values, 1, 0 - 1)
        let indexed = pipeline_bridge_mem_kind_is_indexed(kind)
        let addr = if indexed == 1 { pipeline_lowered_call_blocks_next_value(lowered_args) } else { base }
        let call_dst = if indexed == 1 { addr + 1 } else { pipeline_lowered_call_blocks_next_value(lowered_args) }
        let pseudo_hash = pipeline_ir_bridge_mem_pseudo_hash(kind)
        let addr_inst = ir_inst_list_prepend(ir_inst_binary_i64(addr, ir_binary_op_add(), base, index), ir_inst_list_empty())
        let call_values = pipeline_ir_bridge_mem_call_args(kind, addr, values)
        let call_inst = ir_inst_list_prepend(ir_inst_call_i64(call_dst, pseudo_hash, call_values), ir_inst_list_empty())
        let bridge_insts = if indexed == 1 { ir_inst_list_append(addr_inst, call_inst) } else { call_inst }
        let call_insts = if pipeline_bridge_mem_kind_is_load(kind) == 1 {
          bridge_insts
        } else {
          let result = call_dst + 1
          ir_inst_list_append(bridge_insts, ir_inst_list_prepend(ir_inst_const_i64(result, 0), ir_inst_list_empty()))
        }
        let result_value = if pipeline_bridge_mem_kind_is_load(kind) == 1 { call_dst } else { call_dst + 1 }
        let call_args = ir_value_list_prepend(result_value, ir_value_list_empty())
        let call = ir_block_new_term(call_block, call_insts, ir_term_jump_args(target_block, call_args))
        let blocks = ir_block_list_prepend(entry, ir_block_list_append(pipeline_lowered_call_blocks_blocks(lowered_args), ir_block_list_prepend(call, ir_block_list_empty())))
        pipeline_lowered_blocks(pipeline_lowered_call_blocks_next_block(lowered_args), result_value + 1, blocks, 1)
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  }
}

fn pipeline_par_scope_body_expr_typed(expr: Expr) -> Expr {
  match expr {
    Lambda(lambda_params, body) -> if param_list_len(lambda_params) == 0 { body } else { UnknownExpr(0) }
    LetTyped(inner, ann_type) -> pipeline_par_scope_body_expr_typed(inner)
    _ -> UnknownExpr(0)
  }
}

fn pipeline_par_scope_body_valid(expr: Expr) -> i64 {
  match expr {
    UnknownExpr(tag) -> 0
    _ -> 1
  }
}

fn pipeline_par_marker_inst(dst: i64) -> IrInstList {
  ir_inst_list_prepend(ir_inst_call_i64(dst, pipeline_ir_pseudo_par_lowering_marker_hash(), ir_value_list_empty()), ir_inst_list_empty())
}

fn pipeline_lower_par_sequential_scope_typed(body_arg: Expr, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let body_expr = pipeline_par_scope_body_expr_typed(body_arg)
  if pipeline_par_scope_body_valid(body_expr) == 0 {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  } else {
    let body_start = next_block
    let body_next_block = pipeline_lower_internal_block_after_target(body_start + 1, target_block)
    let body_module = pipeline_lower_module_with_par_ctx(module, PipelineParLowerSequential)
    let body_blocks = pipeline_lower_expr_typed_to_target_blocks_reserved(body_expr, params, locals, body_module, next_value + 1, body_start, body_next_block, target_block)
    if pipeline_lowered_blocks_is_valid(body_blocks) == 1 {
      let entry = ir_block_new_term(start_block, pipeline_par_marker_inst(next_value), ir_term_jump(body_start))
      let blocks = ir_block_list_prepend(entry, pipeline_lowered_blocks_blocks(body_blocks))
      pipeline_lowered_blocks(pipeline_lowered_blocks_next_block(body_blocks), pipeline_lowered_blocks_next_value(body_blocks), blocks, 1)
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  }
}

fn pipeline_lower_par_pthread_scope_typed(args_expr: ExprList, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  if expr_list_len(args_expr) != 3 {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  } else {
    let workers_expr = pipeline_expr_list_nth_or(args_expr, 0, NilExpr)
    let capacity_expr = pipeline_expr_list_nth_or(args_expr, 1, NilExpr)
    let body_arg = pipeline_expr_list_nth_or(args_expr, 2, NilExpr)
    let body_expr = pipeline_par_scope_body_expr_typed(body_arg)
    if pipeline_par_scope_body_valid(body_expr) == 0 {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    } else {
      let call_block = next_block
      let pool_args = expr_list_prepend(workers_expr, expr_list_prepend(capacity_expr, expr_list_empty()))
      let first_arg_block = pipeline_lower_operation_child_start_block(call_block, 2)
      let lowered_args = pipeline_lower_call_arg_blocks_typed(pool_args, 2, params, locals, module, call_block, 0, 0, pipeline_lower_module_subst(module), 0, 0, next_value + 1, first_arg_block, ir_value_list_empty())
      if pipeline_lowered_call_blocks_is_valid(lowered_args) == 1 {
        let entry = ir_block_new_term(start_block, pipeline_par_marker_inst(next_value), ir_term_jump(first_arg_block))
        if pipeline_lowered_call_blocks_falls_through(lowered_args) == 0 {
          let blocks = ir_block_list_prepend(entry, pipeline_lowered_call_blocks_blocks(lowered_args))
          pipeline_lowered_blocks_control(pipeline_lowered_call_blocks_next_block(lowered_args), pipeline_lowered_call_blocks_next_value(lowered_args), blocks, 1, 0)
        } else {
          let pool_value = pipeline_lowered_call_blocks_next_value(lowered_args)
          let pool_slot = pipeline_ir_addressable_slot_id(pool_value + 1)
          let start_inst = ir_inst_list_prepend(
            ir_inst_call_i64(pool_value, pipeline_par_pthread_pool_start_hash(), pipeline_lowered_call_blocks_values(lowered_args)),
            ir_inst_list_prepend(ir_inst_slot_i64(pool_slot), ir_inst_list_prepend(ir_inst_store_i64(pool_slot, pool_value), ir_inst_list_empty()))
          )
          let after_pool_value = pipeline_ir_max_i64(pool_value + 1, pool_slot + 1)
          let seq_start = pipeline_lower_internal_block_after_target(pipeline_lowered_call_blocks_next_block(lowered_args), target_block)
          let seq_next = pipeline_lower_internal_block_after_target(seq_start + 1, target_block)
          let seq_module = pipeline_lower_module_with_par_ctx(module, PipelineParLowerSequential)
          let seq_blocks = pipeline_lower_expr_typed_to_target_blocks_reserved(body_expr, params, locals, seq_module, after_pool_value, seq_start, seq_next, target_block)
          if pipeline_lowered_blocks_is_valid(seq_blocks) == 0 {
            pipeline_lowered_blocks_invalid(start_block, next_value)
          } else {
            let pthread_start = pipeline_lower_internal_block_after_target(pipeline_lowered_blocks_next_block(seq_blocks), target_block)
            let shutdown_block = pipeline_lower_internal_block_after_target(pthread_start + 1, target_block)
            let pthread_next = pipeline_lower_internal_block_after_target(shutdown_block + 1, target_block)
            let pthread_module = pipeline_lower_module_with_par_ctx(module, PipelineParLowerPthread(pool_slot))
            let pthread_blocks = pipeline_lower_expr_typed_to_target_blocks_reserved(body_expr, params, locals, pthread_module, pipeline_lowered_blocks_next_value(seq_blocks), pthread_start, pthread_next, shutdown_block)
            if pipeline_lowered_blocks_is_valid(pthread_blocks) == 0 {
              pipeline_lowered_blocks_invalid(start_block, next_value)
            } else {
              if pipeline_lowered_blocks_falls_through(pthread_blocks) == 0 {
                pipeline_lowered_blocks_invalid(start_block, next_value)
              } else {
                let body_value = pipeline_lowered_blocks_next_value(pthread_blocks)
                let shutdown_pool = body_value + 1
                let shutdown_dst = shutdown_pool + 1
                let shutdown_args = ir_value_list_prepend(shutdown_pool, ir_value_list_empty())
                let shutdown_inst = ir_inst_list_prepend(
                  ir_inst_load_i64(shutdown_pool, pool_slot),
                  ir_inst_list_prepend(ir_inst_call_i64(shutdown_dst, pipeline_par_pthread_pool_shutdown_hash(), shutdown_args), ir_inst_list_empty())
                )
                let shutdown_block_node = ir_block_new_params(shutdown_block, ir_value_list_prepend(body_value, ir_value_list_empty()), shutdown_inst, ir_term_jump_args(target_block, ir_value_list_prepend(body_value, ir_value_list_empty())))
                let call_block_node = ir_block_new_term(call_block, start_inst, ir_term_branch(pool_value, pthread_start, seq_start))
                let blocks = ir_block_list_prepend(
                  entry,
                  ir_block_list_append(
                    pipeline_lowered_call_blocks_blocks(lowered_args),
                    ir_block_list_prepend(
                      call_block_node,
                      ir_block_list_append(
                        pipeline_lowered_blocks_blocks(seq_blocks),
                        ir_block_list_append(
                          pipeline_lowered_blocks_blocks(pthread_blocks),
                          ir_block_list_prepend(shutdown_block_node, ir_block_list_empty())
                        )
                      )
                    )
                  )
                )
                let out_next_block = pipeline_lower_internal_block_after_target(pipeline_lowered_blocks_next_block(pthread_blocks), shutdown_block + 1)
                let out_next_value = shutdown_dst + 1
                pipeline_lowered_blocks(out_next_block, out_next_value, blocks, 1)
              }
            }
          }
        }
      } else {
        pipeline_lowered_blocks_invalid(start_block, next_value)
      }
    }
  }
}

fn pipeline_lower_par_scope_call_typed_to_target_blocks(ns: i64, nl: i64, args_expr: ExprList, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  if src_eq(src, ns, nl, "par_with_sequential_i64") == 1 and expr_list_len(args_expr) == 1 {
    pipeline_lower_par_sequential_scope_typed(pipeline_expr_list_nth_or(args_expr, 0, NilExpr), params, locals, module, next_value, start_block, next_block, target_block)
  } else {
    if src_eq(src, ns, nl, "par_with_pthread_pool_i64") == 1 and expr_list_len(args_expr) == 3 {
      pipeline_lower_par_pthread_scope_typed(args_expr, params, locals, module, next_value, start_block, next_block, target_block)
    } else {
      pipeline_lower_par_map_call_typed_to_target_blocks(ns, nl, args_expr, params, locals, module, next_value, start_block, next_block, target_block)
    }
  }
}

fn pipeline_lower_par_map_call_typed_to_target_blocks(ns: i64, nl: i64, args_expr: ExprList, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let fns = pipeline_lower_module_fns(module)
  let subst = pipeline_lower_module_subst(module)
  if src_eq(src, ns, nl, "par_map") == 0 or expr_list_len(args_expr) != 2 {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  } else {
    match pipeline_lower_module_par_ctx(module) {
      PipelineParLowerNone -> pipeline_lowered_blocks_invalid(start_block, next_value)
      PipelineParLowerSequential -> {
        let target_hash = pipeline_par_sequential_map_i64_hash()
        let call_block = next_block
        let arg_count = 2
        let first_arg_block = pipeline_lower_operation_child_start_block(call_block, arg_count)
        let expected_params = pipeline_fns_lookup_params_by_hash(fns, target_hash)
        let borrowed_mask = pipeline_fn_effective_borrowable_param_mask_from_pair(fns, pipeline_fns_lookup_pair_by_hash(fns, target_hash), expected_params, subst)
        let lowered_args = pipeline_lower_call_arg_blocks_typed_with_borrow_mask(args_expr, arg_count, params, locals, module, call_block, expected_params, 0, subst, 0, borrowed_mask, 0, next_value, first_arg_block, ir_value_list_empty())
        if pipeline_lowered_call_blocks_is_valid(lowered_args) == 1 {
          let entry = ir_block_new_term(start_block, ir_inst_list_empty(), ir_term_jump(first_arg_block))
          if pipeline_lowered_call_blocks_falls_through(lowered_args) == 0 {
            let blocks = ir_block_list_prepend(entry, pipeline_lowered_call_blocks_blocks(lowered_args))
            pipeline_lowered_blocks_control(pipeline_lowered_call_blocks_next_block(lowered_args), pipeline_lowered_call_blocks_next_value(lowered_args), blocks, 1, 0)
          } else {
            let call_dst = pipeline_lowered_call_blocks_next_value(lowered_args)
            let call_inst = ir_inst_list_prepend(ir_inst_call_i64(call_dst, target_hash, pipeline_lowered_call_blocks_values(lowered_args)), ir_inst_list_empty())
            let call_args = ir_value_list_prepend(call_dst, ir_value_list_empty())
            let call = ir_block_new_term(call_block, call_inst, ir_term_jump_args(target_block, call_args))
            let blocks = ir_block_list_prepend(entry, ir_block_list_append(pipeline_lowered_call_blocks_blocks(lowered_args), ir_block_list_prepend(call, ir_block_list_empty())))
            pipeline_lowered_blocks(pipeline_lowered_call_blocks_next_block(lowered_args), call_dst + 1, blocks, 1)
          }
        } else {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        }
      }
      PipelineParLowerPthread(pool_slot) -> {
        let target_hash = pipeline_par_pthread_pool_map_scoped_i64_hash()
        let call_block = next_block
        let arg_count = 2
        let first_arg_block = pipeline_lower_operation_child_start_block(call_block, arg_count)
        let expected_params = pipeline_fns_lookup_params_by_hash(fns, target_hash)
        let borrowed_mask = pipeline_fn_effective_borrowable_param_mask_from_pair(fns, pipeline_fns_lookup_pair_by_hash(fns, target_hash), expected_params, subst)
        let lowered_args = pipeline_lower_call_arg_blocks_typed_with_borrow_mask(args_expr, arg_count, params, locals, module, call_block, expected_params, 0, subst, 0, borrowed_mask, 0, next_value, first_arg_block, ir_value_list_empty())
        if pipeline_lowered_call_blocks_is_valid(lowered_args) == 1 {
          let entry = ir_block_new_term(start_block, ir_inst_list_empty(), ir_term_jump(first_arg_block))
          if pipeline_lowered_call_blocks_falls_through(lowered_args) == 0 {
            let blocks = ir_block_list_prepend(entry, pipeline_lowered_call_blocks_blocks(lowered_args))
            pipeline_lowered_blocks_control(pipeline_lowered_call_blocks_next_block(lowered_args), pipeline_lowered_call_blocks_next_value(lowered_args), blocks, 1, 0)
          } else {
            let pool_load = pipeline_lowered_call_blocks_next_value(lowered_args)
            let call_dst = pool_load + 1
            let call_values = ir_value_list_append(pipeline_lowered_call_blocks_values(lowered_args), ir_value_list_prepend(pool_load, ir_value_list_empty()))
            let call_inst = ir_inst_list_prepend(
              ir_inst_load_i64(pool_load, pool_slot),
              ir_inst_list_prepend(ir_inst_call_i64(call_dst, target_hash, call_values), ir_inst_list_empty())
            )
            let call_args = ir_value_list_prepend(call_dst, ir_value_list_empty())
            let call = ir_block_new_term(call_block, call_inst, ir_term_jump_args(target_block, call_args))
            let blocks = ir_block_list_prepend(entry, ir_block_list_append(pipeline_lowered_call_blocks_blocks(lowered_args), ir_block_list_prepend(call, ir_block_list_empty())))
            pipeline_lowered_blocks(pipeline_lowered_call_blocks_next_block(lowered_args), call_dst + 1, blocks, 1)
          }
        } else {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        }
      }
    }
  }
}

fn pipeline_expr_typed_size(expr: Expr, budget: i64) -> i64 {
  if budget <= 0 { 0 }
  else {
    match expr {
      BinOp(op, lhs, rhs) -> pipeline_expr_typed_size(rhs, pipeline_expr_typed_size(lhs, budget - 1))
      -- Leaf-only: a call inside the inlined body would need its own callee
      -- resolution in the caller context; reject until that is proven safe.
      Call(cns, cnl, args) -> 0
      GenericCall(type_args, inner_call) -> 0
      If(cond, then_expr, else_expr) -> pipeline_expr_typed_size(else_expr, pipeline_expr_typed_size(then_expr, pipeline_expr_typed_size(cond, budget - 2)))
      While(cond, body) -> pipeline_expr_typed_size(body, pipeline_expr_typed_size(cond, budget - 3))
      Loop(body) -> pipeline_expr_typed_size(body, budget - 3)
      -- Early returns and breaks would transfer control out of the CALLER
      -- when relocated; reject bodies containing them.
      Break(value) -> 0
      Return(value) -> 0
      Let(lns, lnl, value, body) -> pipeline_expr_typed_size(body, pipeline_expr_typed_size(value, budget - 1))
      LetMut(lns, lnl, value, body) -> pipeline_expr_typed_size(body, pipeline_expr_typed_size(value, budget - 1))
      Assign(ans, anl, value) -> pipeline_expr_typed_size(value, budget - 1)
      Block(first, rest) -> pipeline_expr_typed_size(rest, pipeline_expr_typed_size(first, budget))
      FieldAccess(base, fns2, fnl2, fact) -> pipeline_expr_typed_size(base, budget - 1)
      IndexedLen(base, fixed_len) -> pipeline_expr_typed_size(base, budget - 1)
      IndexedGet(base, index, element_ty, fixed_len) -> pipeline_expr_typed_size(index, pipeline_expr_typed_size(base, budget - 1))
      IndexedSet(base, index, value, fact) -> pipeline_expr_typed_size(value, pipeline_expr_typed_size(index, pipeline_expr_typed_size(base, budget - 1)))
      IndexedSlice(base, start, end, fact) -> pipeline_expr_typed_size(end, pipeline_expr_typed_size(start, pipeline_expr_typed_size(base, budget - 1)))
      Not(operand) -> pipeline_expr_typed_size(operand, budget - 1)
      LetTyped(inner, ann_type) -> pipeline_expr_typed_size(inner, budget)
      Ident(ins, inl) -> budget - 1
      IntLit(v, st, ln) -> budget - 1
      BoolLit(v) -> budget - 1
      FloatLit(st, ln) -> budget - 1
      NilExpr -> budget - 1
      ForIter(vns, vnl, collection, body) -> pipeline_expr_typed_size(body, pipeline_expr_typed_size(collection, budget - 3))
      Match(scrutinee, arms) -> 0
      _ -> 0
    }
  }
}

fn pipeline_expr_list_typed_size(exprs: ExprList, budget: i64) -> i64 {
  match exprs {
    ExprListNil -> budget
    ExprListCons(expr, rest) -> pipeline_expr_list_typed_size(rest, pipeline_expr_typed_size(expr, budget))
  }
}

fn pipeline_fn_is_pure(fn_wrap: i64) -> i64 {
  let sig = effect_sig_from_node(fn_effects(fn_wrap))
  match sig {
    MissingEffectSig -> 1
    EffectSig(effects, tail_var) -> {
      if tail_var != 0 { 0 } else { if effect_atom_list_len(effects) == 0 { 1 } else { 0 } }
    }
  }
}

fn pipeline_inline_depth_limit() -> i64 { 3 }
fn pipeline_inline_size_budget() -> i64 { 48 }

fn pipeline_params_any_float(params: i64, nparams: i64) -> i64 {
  let mut found = 0
  for i in 0..nparams {
    let ty = node_f3(nlist_get(params, i))
    if cg_ty_is_f32(ty) == 1 or cg_ty_is_f64(ty) == 1 { found = 1 } else { 0 }
  }
  found
}

fn pipeline_params_all_single_lane(params: i64, nparams: i64) -> i64 {
  let mut ok = 1
  for i in 0..nparams {
    if ty_value_storage_word_count(node_f3(nlist_get(params, i))) != 1 { ok = 0 } else { 0 }
  }
  ok
}

fn pipeline_fn_inline_signature_unmanaged(fn_wrap: i64) -> i64 {
  let inner = pipeline_fn_inner(fn_wrap)
  let callee_params = node_f3(inner)
  if pipeline_ir_native_params_unmanaged(callee_params, nlist_len(callee_params)) == 0 { 0 }
  else { if pipeline_params_all_single_lane(callee_params, nlist_len(callee_params)) == 0 { 0 }
  else { if pipeline_params_any_float(callee_params, nlist_len(callee_params)) == 1 { 0 }
  else {
    -- Float params/returns are excluded: inlining does not yet re-establish
    -- the float-primitive binding on relocated params, so an f32/f64 compare
    -- in the body (e.g. NaN self-inequality) miscomputes. Remove when float
    -- residency threads through the inline param env.
    let ret = fn_ret_type(fn_wrap)
    if ret == 0 or ty_value_storage_word_count(ret) != 1 { 0 }
    else { if cg_ty_is_managed(ret) == 1 { 0 }
    else { if ret != 0 and (cg_ty_is_f32(ret) == 1 or cg_ty_is_f64(ret) == 1) { 0 }
    else { if ret != 0 and pipeline_ty_needs_rc_runtime(ret) { 0 } else { 1 } } }
  } } } }
}

-- Sidecar (expression-position) variant of pure call inlining, for callees
-- whose bodies lower without a CFG. Multi-block callees in expression
-- position keep the call for now.
fn pipeline_lower_pure_call_inline_sidecar(ns: i64, nl: i64, args_exprs: ExprList, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let module = pipeline_handler_lower_ctx_module(lower_ctx)
  if pipeline_lower_module_inline_depth(module) >= pipeline_inline_depth_limit() {
    ir_lowered_expr_invalid(next_value)
  } else {
    let src = pipeline_handler_lower_ctx_src(lower_ctx)
    let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
    let fns = pipeline_handler_lower_ctx_fns(lower_ctx)
    let pair = pipeline_fns_lookup_pair(fns, src, ns, nl)
    if pair == 0 { ir_lowered_expr_invalid(next_value) }
    else {
      let fn_wrap = node_f1(pair)
      let fn_src = node_f2(pair)
      if pipeline_decl_node_is_function(fn_wrap) == 0 or fn_tparams(fn_wrap) != 0 or node_f3(pair) != 0 { ir_lowered_expr_invalid(next_value) }
      else { if pipeline_fn_is_pure(fn_wrap) == 0 or pipeline_fn_inline_signature_unmanaged(fn_wrap) == 0 { ir_lowered_expr_invalid(next_value) }
      else {
        let inner = pipeline_fn_inner(fn_wrap)
        let callee_params = node_f3(inner)
        let body = node_f4(inner)
        let arg_count = expr_list_len(args_exprs)
        if arg_count != nlist_len(callee_params) { ir_lowered_expr_invalid(next_value) }
        else { if pipeline_expr_needs_cfg(body) == 1 { ir_lowered_expr_invalid(next_value) }
        else { if pipeline_expr_typed_size(expr_from_node(pipeline_expr_node_strip_typed(body)), pipeline_inline_size_budget()) <= 0 { ir_lowered_expr_invalid(next_value) }
        else {
          let borrowed_mask = pipeline_fn_effective_borrowable_param_mask_from_pair(fns, pair, callee_params, 0)
          let lowered_args = pipeline_lower_typed_handler_opt_args_expected_borrow_mask(args_exprs, 0, next_value, lower_ctx, callee_params, 0, 0, borrowed_mask)
          if pipeline_lowered_args_is_valid(lowered_args) == 0 { ir_lowered_expr_invalid(next_value) }
          else {
            let inline_env = pipeline_value_env_push_param_values(callee_params, pipeline_lowered_args_values(lowered_args), 0, arg_count, 0, pipeline_value_env_empty())
            let inline_module = PipelineLowerModule(fn_src, tt, fns, pipeline_handler_inline_ctx_empty(), 0, pipeline_lower_module_par_ctx(module), pipeline_lower_module_inline_depth(module) + 1)
            let callee_ctx = pipeline_handler_lower_ctx_from_module(0, inline_env, inline_module)
            let inlined = pipeline_lower_expr_node_typed_sidecar_handler_ctx(body, pipeline_lowered_args_next_value(lowered_args), callee_ctx)
            if ir_lowered_expr_is_valid(inlined) == 0 { ir_lowered_expr_invalid(next_value) }
            else {
              ir_lowered_expr(
                ir_lowered_expr_value(inlined),
                ir_lowered_expr_next_value(inlined),
                ir_inst_list_append(pipeline_lowered_args_insts(lowered_args), ir_lowered_expr_insts(inlined))
              )
            }
          }
        } } }
      } }
    }
  }
}

-- General pure direct-call inlining at typed lowering. Pure callees carry
-- no effect row, so relocating their bodies into the caller cannot change
-- handler semantics; ownership transfer follows the same param-drop and
-- return-transfer discipline as the Par helper inline this generalises.
fn pipeline_lower_pure_direct_call_inline_typed_to_target_blocks(ns: i64, nl: i64, args_expr: ExprList, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  if pipeline_lower_module_inline_depth(module) >= pipeline_inline_depth_limit() {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  } else {
    let caller_src = pipeline_lower_module_src(module)
    let fns = pipeline_lower_module_fns(module)
    let pair = pipeline_fns_lookup_pair(fns, caller_src, ns, nl)
    if pair == 0 {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    } else {
      let fn_wrap = node_f1(pair)
      let fn_src = node_f2(pair)
      if pipeline_decl_node_is_function(fn_wrap) == 0 or fn_tparams(fn_wrap) != 0 or node_f3(pair) != 0 {
        pipeline_lowered_blocks_invalid(start_block, next_value)
      } else { if pipeline_fn_is_pure(fn_wrap) == 0 or pipeline_fn_inline_signature_unmanaged(fn_wrap) == 0 {
        pipeline_lowered_blocks_invalid(start_block, next_value)
      } else {
        let inner = pipeline_fn_inner(fn_wrap)
        let callee_params = node_f3(inner)
        let body = node_f4(inner)
        let arg_count = expr_list_len(args_expr)
        let param_count = nlist_len(callee_params)
        if arg_count != param_count {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        } else { if pipeline_expr_typed_size(expr_from_node(pipeline_expr_node_strip_typed(body)), pipeline_inline_size_budget()) <= 0 {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        } else {
          let call_block = next_block
          let first_arg_block = pipeline_lower_operation_child_start_block(call_block, arg_count)
          let borrowed_mask = pipeline_fn_effective_borrowable_param_mask_from_pair(fns, pair, callee_params, 0)
          let lowered_args = pipeline_lower_call_arg_blocks_typed_with_borrow_mask(args_expr, arg_count, params, locals, module, call_block, callee_params, 0, 0, 0, borrowed_mask, 0, next_value, first_arg_block, ir_value_list_empty())
          if pipeline_lowered_call_blocks_is_valid(lowered_args) == 0 {
            pipeline_lowered_blocks_invalid(start_block, next_value)
          } else {
            let entry = ir_block_new_term(start_block, ir_inst_list_empty(), ir_term_jump(first_arg_block))
            if pipeline_lowered_call_blocks_falls_through(lowered_args) == 0 {
              let blocks = ir_block_list_prepend(entry, pipeline_lowered_call_blocks_blocks(lowered_args))
              pipeline_lowered_blocks_control(pipeline_lowered_call_blocks_next_block(lowered_args), pipeline_lowered_call_blocks_next_value(lowered_args), blocks, 1, 0)
            } else {
              let inline_done_block = pipeline_lower_internal_block_after_target(pipeline_lowered_call_blocks_next_block(lowered_args), target_block)
              let inline_next_block = pipeline_lower_internal_block_after_target(inline_done_block + 1, target_block)
              let inline_locals = pipeline_value_env_push_param_values(callee_params, pipeline_lowered_call_blocks_values(lowered_args), 0, param_count, 0, pipeline_value_env_empty())
              let inline_module = PipelineLowerModule(fn_src, pipeline_lower_module_tt(module), fns, pipeline_handler_inline_ctx_empty(), 0, pipeline_lower_module_par_ctx(module), pipeline_lower_module_inline_depth(module) + 1)
              let inline_body = pipeline_lower_expr_typed_to_target_blocks_reserved(expr_from_node(body), callee_params, inline_locals, inline_module, pipeline_lowered_call_blocks_next_value(lowered_args), call_block, inline_next_block, inline_done_block)
              if pipeline_lowered_blocks_is_valid(inline_body) == 0 {
                pipeline_lowered_blocks_invalid(start_block, next_value)
              } else { if pipeline_lowered_blocks_falls_through(inline_body) == 0 {
                let blocks = ir_block_list_prepend(entry, ir_block_list_append(pipeline_lowered_call_blocks_blocks(lowered_args), pipeline_lowered_blocks_blocks(inline_body)))
                pipeline_lowered_blocks_control(pipeline_lowered_blocks_next_block(inline_body), pipeline_lowered_blocks_next_value(inline_body), blocks, 1, 0)
              } else {
                let body_value = pipeline_lowered_blocks_next_value(inline_body)
                let transfer = pipeline_lower_return_transfer_from_node(body, body_value, body_value + 1, callee_params, inline_locals, inline_module)
                let managed_drops = pipeline_managed_param_release_value_insts_with_borrow_mask(callee_params, pipeline_lowered_call_blocks_values(lowered_args), 0, param_count, ir_lowered_expr_next_value(transfer), borrowed_mask)
                let managed_drop_next = pipeline_managed_param_release_value_next(callee_params, pipeline_lowered_call_blocks_values(lowered_args), 0, param_count, ir_lowered_expr_next_value(transfer), borrowed_mask)
                let owned_drops = pipeline_owned_param_drop_value_insts(callee_params, pipeline_lowered_call_blocks_values(lowered_args), 0, param_count, body, fn_src)
                let done_insts = ir_inst_list_append(ir_lowered_expr_insts(transfer), ir_inst_list_append(managed_drops, owned_drops))
                let done_args = ir_value_list_prepend(ir_lowered_expr_value(transfer), ir_value_list_empty())
                let done_params = ir_value_list_prepend(body_value, ir_value_list_empty())
                let done = ir_block_new_params(inline_done_block, done_params, done_insts, ir_term_jump_args(target_block, done_args))
                let blocks = ir_block_list_prepend(
                  entry,
                  ir_block_list_append(
                    pipeline_lowered_call_blocks_blocks(lowered_args),
                    ir_block_list_append(pipeline_lowered_blocks_blocks(inline_body), ir_block_list_prepend(done, ir_block_list_empty()))
                  )
                )
                pipeline_lowered_blocks(pipeline_lowered_blocks_next_block(inline_body), managed_drop_next, blocks, 1)
              } }
            }
          }
        } }
      } }
    }
  }
}

fn pipeline_lower_par_direct_call_inline_typed_to_target_blocks(ns: i64, nl: i64, args_expr: ExprList, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let par_ctx = pipeline_lower_module_par_ctx(module)
  if pipeline_par_lower_ctx_is_active(par_ctx) == 0 {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  } else {
    let caller_src = pipeline_lower_module_src(module)
    let fns = pipeline_lower_module_fns(module)
    let pair = pipeline_fns_lookup_pair(fns, caller_src, ns, nl)
    if pair == 0 {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    } else {
      let fn_wrap = node_f1(pair)
      let fn_src = node_f2(pair)
      if pipeline_decl_node_is_function(fn_wrap) == 0 or fn_tparams(fn_wrap) != 0 {
        pipeline_lowered_blocks_invalid(start_block, next_value)
      } else {
        let inner = pipeline_fn_inner(fn_wrap)
        let callee_params = node_f3(inner)
        let body = node_f4(inner)
        let arg_count = expr_list_len(args_expr)
        let param_count = nlist_len(callee_params)
        if arg_count != param_count {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        } else { if pipeline_fn_declares_par_effect(fn_wrap) == 0 {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        } else { if pipeline_expr_needs_cfg(body) == 1 {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        } else {
          let call_block = next_block
          let first_arg_block = pipeline_lower_operation_child_start_block(call_block, arg_count)
          let borrowed_mask = pipeline_fn_effective_borrowable_param_mask_from_pair(fns, pair, callee_params, 0)
          let lowered_args = pipeline_lower_call_arg_blocks_typed_with_borrow_mask(args_expr, arg_count, params, locals, module, call_block, callee_params, 0, 0, 0, borrowed_mask, 0, next_value, first_arg_block, ir_value_list_empty())
          if pipeline_lowered_call_blocks_is_valid(lowered_args) == 0 {
            pipeline_lowered_blocks_invalid(start_block, next_value)
          } else {
            let entry = ir_block_new_term(start_block, ir_inst_list_empty(), ir_term_jump(first_arg_block))
            if pipeline_lowered_call_blocks_falls_through(lowered_args) == 0 {
              let blocks = ir_block_list_prepend(entry, pipeline_lowered_call_blocks_blocks(lowered_args))
              pipeline_lowered_blocks_control(pipeline_lowered_call_blocks_next_block(lowered_args), pipeline_lowered_call_blocks_next_value(lowered_args), blocks, 1, 0)
            } else {
              let inline_done_block = pipeline_lower_internal_block_after_target(pipeline_lowered_call_blocks_next_block(lowered_args), target_block)
              let inline_next_block = pipeline_lower_internal_block_after_target(inline_done_block + 1, target_block)
              let inline_locals = pipeline_value_env_push_param_values(callee_params, pipeline_lowered_call_blocks_values(lowered_args), 0, param_count, 0, pipeline_value_env_empty())
              let inline_module = PipelineLowerModule(fn_src, pipeline_lower_module_tt(module), fns, pipeline_handler_inline_ctx_empty(), 0, par_ctx, pipeline_lower_module_inline_depth(module) + 1)
              let inline_body = pipeline_lower_expr_typed_to_target_blocks_reserved(expr_from_node(body), callee_params, inline_locals, inline_module, pipeline_lowered_call_blocks_next_value(lowered_args), call_block, inline_next_block, inline_done_block)
              if pipeline_lowered_blocks_is_valid(inline_body) == 0 {
                pipeline_lowered_blocks_invalid(start_block, next_value)
              } else { if pipeline_lowered_blocks_falls_through(inline_body) == 0 {
                let blocks = ir_block_list_prepend(entry, ir_block_list_append(pipeline_lowered_call_blocks_blocks(lowered_args), pipeline_lowered_blocks_blocks(inline_body)))
                pipeline_lowered_blocks_control(pipeline_lowered_blocks_next_block(inline_body), pipeline_lowered_blocks_next_value(inline_body), blocks, 1, 0)
              } else {
                let body_value = pipeline_lowered_blocks_next_value(inline_body)
                let transfer = pipeline_lower_return_transfer_from_node(body, body_value, body_value + 1, callee_params, inline_locals, inline_module)
                let managed_drops = pipeline_managed_param_release_value_insts_with_borrow_mask(callee_params, pipeline_lowered_call_blocks_values(lowered_args), 0, param_count, ir_lowered_expr_next_value(transfer), borrowed_mask)
                let managed_drop_next = pipeline_managed_param_release_value_next(callee_params, pipeline_lowered_call_blocks_values(lowered_args), 0, param_count, ir_lowered_expr_next_value(transfer), borrowed_mask)
                let owned_drops = pipeline_owned_param_drop_value_insts(callee_params, pipeline_lowered_call_blocks_values(lowered_args), 0, param_count, body, fn_src)
                let done_insts = ir_inst_list_append(ir_lowered_expr_insts(transfer), ir_inst_list_append(managed_drops, owned_drops))
                let done_args = ir_value_list_prepend(ir_lowered_expr_value(transfer), ir_value_list_empty())
                let done_params = ir_value_list_prepend(body_value, ir_value_list_empty())
                let done = ir_block_new_params(inline_done_block, done_params, done_insts, ir_term_jump_args(target_block, done_args))
                let blocks = ir_block_list_prepend(
                  entry,
                  ir_block_list_append(
                    pipeline_lowered_call_blocks_blocks(lowered_args),
                    ir_block_list_append(pipeline_lowered_blocks_blocks(inline_body), ir_block_list_prepend(done, ir_block_list_empty()))
                  )
                )
                pipeline_lowered_blocks(pipeline_lowered_blocks_next_block(inline_body), managed_drop_next, blocks, 1)
              } }
            }
          }
        } } }
      }
    }
  }
}

fn pipeline_lower_call_typed_to_target_blocks(ns: i64, nl: i64, args_expr: ExprList, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let fns = pipeline_lower_module_fns(module)
  let subst = pipeline_lower_module_subst(module)
  let direct = pipeline_call_callee_is_direct(params, locals, src, ns, nl)
  let callee_value = pipeline_call_callee_value(params, locals, src, ns, nl)
  let callee_slot = pipeline_call_callee_slot(locals, src, ns, nl)
  let callee_type_node = pipeline_call_callee_type_node(params, locals, src, ns, nl, subst)
  let indirect_expected_types = pipeline_call_indirect_expected_types(direct, callee_type_node)
  let callee_hash = str_hash(src, ns, nl)
  let par_scope = pipeline_lower_par_scope_call_typed_to_target_blocks(ns, nl, args_expr, params, locals, module, next_value, start_block, next_block, target_block)
  if pipeline_lowered_blocks_is_valid(par_scope) == 1 {
    par_scope
  } else {
  let par_direct_inline = pipeline_lower_par_direct_call_inline_typed_to_target_blocks(ns, nl, args_expr, params, locals, module, next_value, start_block, next_block, target_block)
  if pipeline_lowered_blocks_is_valid(par_direct_inline) == 1 {
    par_direct_inline
  } else {
  let pure_inline = pipeline_lower_pure_direct_call_inline_typed_to_target_blocks(ns, nl, args_expr, params, locals, module, next_value, start_block, next_block, target_block)
  if pipeline_lowered_blocks_is_valid(pure_inline) == 1 {
    pure_inline
  } else {
  let weak = pipeline_lower_weak_call_typed_to_target_blocks(src, ns, nl, args_expr, params, locals, module, next_value, start_block, next_block, target_block)
  if pipeline_lowered_blocks_is_valid(weak) == 1 {
    weak
  } else {
    let native = pipeline_lower_native_intrinsic_call_typed_to_target_blocks(callee_hash, args_expr, params, locals, module, next_value, start_block, next_block, target_block)
    if pipeline_lowered_blocks_is_valid(native) == 1 {
      native
    } else {
      let bridge_kind = if direct == 1 { pipeline_bridge_mem_kind_by_hash(callee_hash, expr_list_len(args_expr)) } else { 0 }
      let bridge = pipeline_lower_bridge_mem_call_typed_to_target_blocks(bridge_kind, args_expr, params, locals, module, next_value, start_block, next_block, target_block)
      if pipeline_lowered_blocks_is_valid(bridge) == 1 {
        bridge
      } else { if direct == 1 or callee_value >= 0 or callee_slot >= 0 {
      let call_block = next_block
      let arg_count = expr_list_len(args_expr)
      let first_arg_block = pipeline_lower_operation_child_start_block(call_block, arg_count)
      let arg_start_value = if callee_slot >= 0 { next_value + 1 } else { next_value }
      let entry_insts = if callee_slot >= 0 {
        ir_inst_list_prepend(ir_inst_load_i64(next_value, callee_slot), ir_inst_list_empty())
      } else { ir_inst_list_empty() }
      let variant_payloads = if direct == 1 { pipeline_variant_payload_types(tt, src, ns, nl) } else { 0 }
      let expected_params = if variant_payloads == 0 and direct == 1 { pipeline_fns_lookup_params(fns, src, ns, nl) } else { 0 }
      let expected_types = if variant_payloads != 0 { variant_payloads } else { indirect_expected_types }
      let direct_fn = if direct == 1 { pipeline_fns_lookup_pair(fns, src, ns, nl) } else { 0 }
      let result_ty = pipeline_call_result_type_node(params, locals, src, tt, fns, subst, ns, nl)
      let borrowed_mask = if variant_payloads == 0 and direct == 1 {
        pipeline_call_borrowable_param_mask(fns, src, ns, nl, expected_params, subst)
      } else { 0 }
      let lowered_args = pipeline_lower_call_arg_blocks_typed_with_borrow_mask(args_expr, arg_count, params, locals, module, call_block, expected_params, expected_types, subst, 0, borrowed_mask, 0, arg_start_value, first_arg_block, ir_value_list_empty())
      if pipeline_lowered_call_blocks_is_valid(lowered_args) == 1 {
        let entry = ir_block_new_term(start_block, entry_insts, ir_term_jump(first_arg_block))
        if pipeline_lowered_call_blocks_falls_through(lowered_args) == 0 {
          let blocks = ir_block_list_prepend(entry, pipeline_lowered_call_blocks_blocks(lowered_args))
          pipeline_lowered_blocks_control(pipeline_lowered_call_blocks_next_block(lowered_args), pipeline_lowered_call_blocks_next_value(lowered_args), blocks, 1, 0)
        } else {
          let call_dst = pipeline_lowered_call_blocks_next_value(lowered_args)
          let indirect_callee = if callee_slot >= 0 { next_value } else { callee_value }
          let logical_args = pipeline_lowered_call_blocks_values(lowered_args)
          let abi_args = if variant_payloads != 0 {
            pipeline_call_abi_args(logical_args, 0, variant_payloads, subst, 0, 0)
          } else { if expected_params != 0 or expected_types != 0 {
            pipeline_call_abi_args(logical_args, expected_params, expected_types, subst, 0, 0)
          } else { logical_args } }
          let call_head = ir_inst_list_prepend(
            pipeline_call_inst_resolved(call_dst, direct, indirect_callee, src, tt, ns, nl, abi_args),
            ir_inst_list_empty()
          )
          let call_insts = if result_ty != 0 {
            ir_inst_list_append(call_head, pipeline_ir_call_result_lane_insts(call_dst, result_ty))
          } else { call_head }
          let result_lanes = if result_ty != 0 { pipeline_type_value_lane_count_or_one(result_ty) } else { 1 }
          let cleanup = pipeline_managed_lambda_temp_release_args_masked_typed(args_expr, logical_args, 0, call_dst + result_lanes, borrowed_mask, 0, expected_params, expected_types, subst, src, tt)
          let call_and_cleanup = ir_inst_list_append(call_insts, pipeline_lowered_args_insts(cleanup))
          let call_args = pipeline_ir_value_lane_ids(call_dst, 0, result_lanes)
          let call = ir_block_new_term(call_block, call_and_cleanup, ir_term_jump_args(target_block, call_args))
          let blocks = ir_block_list_prepend(entry, ir_block_list_append(pipeline_lowered_call_blocks_blocks(lowered_args), ir_block_list_prepend(call, ir_block_list_empty())))
          pipeline_lowered_blocks(pipeline_lowered_call_blocks_next_block(lowered_args), pipeline_lowered_args_next_value(cleanup), blocks, 1)
        }
      } else {
        pipeline_lowered_blocks_invalid(start_block, next_value)
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    } }
    }
  }
  }
  }
  }
}

fn pipeline_lower_expr_typed_unary_merge_to_target_blocks(inner_expr: Expr, op: IrUnaryOp, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let merge_block = next_block
  let value_blocks = pipeline_lower_expr_typed_to_target_blocks_reserved(inner_expr, params, locals, module, next_value, start_block, next_block + 1, merge_block)
  if pipeline_lowered_blocks_is_valid(value_blocks) == 1 {
    if pipeline_lowered_blocks_falls_through(value_blocks) == 0 {
      value_blocks
    } else {
      let value = pipeline_lowered_blocks_next_value(value_blocks)
      let dst = value + 1
      let params_list = ir_value_list_prepend(value, ir_value_list_empty())
      let args = ir_value_list_prepend(dst, ir_value_list_empty())
      let inst = ir_inst_list_prepend(ir_inst_unary_i64(dst, op, value), ir_inst_list_empty())
      let merge = ir_block_new_params(merge_block, params_list, inst, ir_term_jump_args(target_block, args))
      let blocks = ir_block_list_append(pipeline_lowered_blocks_blocks(value_blocks), ir_block_list_prepend(merge, ir_block_list_empty()))
      pipeline_lowered_blocks(pipeline_lowered_blocks_next_block(value_blocks), dst + 1, blocks, 1)
    }
  } else {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  }
}

fn pipeline_lower_try_typed_to_target_blocks(inner_expr: Expr, effect_atom: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let merge_block = next_block
  let value_blocks = pipeline_lower_expr_typed_to_target_blocks_reserved(inner_expr, params, locals, module, next_value, start_block, next_block + 1, merge_block)
  if pipeline_lowered_blocks_is_valid(value_blocks) == 1 {
    if pipeline_lowered_blocks_falls_through(value_blocks) == 0 {
      value_blocks
    } else {
      let value = pipeline_lowered_blocks_next_value(value_blocks)
      let dst = value + 1
      let params_list = ir_value_list_prepend(value, ir_value_list_empty())
      let args = ir_value_list_prepend(dst, ir_value_list_empty())
      let effect_key = pipeline_effect_atom_dispatch_key(effect_atom, pipeline_lower_module_subst(module), effect_fail_head_hash())
      let inst = ir_inst_list_prepend(ir_inst_try_i64(dst, value, effect_key), ir_inst_list_empty())
      let merge = ir_block_new_params(merge_block, params_list, inst, ir_term_jump_args(target_block, args))
      let blocks = ir_block_list_append(pipeline_lowered_blocks_blocks(value_blocks), ir_block_list_prepend(merge, ir_block_list_empty()))
      pipeline_lowered_blocks(pipeline_lowered_blocks_next_block(value_blocks), dst + 1, blocks, 1)
    }
  } else {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  }
}

fn pipeline_lower_logical_typed_to_target_blocks(op: i64, lhs_expr: Expr, rhs_expr: Expr, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let lhs_merge_block = next_block
  let lhs_blocks = pipeline_lower_expr_typed_to_target_blocks_reserved(lhs_expr, params, locals, module, next_value, start_block, next_block + 1, lhs_merge_block)
  if pipeline_lowered_blocks_is_valid(lhs_blocks) == 1 {
    if pipeline_lowered_blocks_falls_through(lhs_blocks) == 0 {
      lhs_blocks
    } else {
      let lhs_value = pipeline_lowered_blocks_next_value(lhs_blocks)
      let rhs_start = pipeline_lowered_blocks_next_block(lhs_blocks)
      let rhs_blocks = pipeline_lower_expr_typed_to_target_blocks_reserved(rhs_expr, params, locals, module, lhs_value + 1, rhs_start, rhs_start + 1, target_block)
      if pipeline_lowered_blocks_is_valid(rhs_blocks) == 1 {
        let const_block = pipeline_lowered_blocks_next_block(rhs_blocks)
        let const_value = pipeline_lowered_blocks_next_value(rhs_blocks)
        let const_lit = if op == 12 { 0 } else { 1 }
        let const_inst = ir_inst_list_prepend(ir_inst_const_i64(const_value, const_lit), ir_inst_list_empty())
        let const_args = ir_value_list_prepend(const_value, ir_value_list_empty())
        let const_node = ir_block_new_term(const_block, const_inst, ir_term_jump_args(target_block, const_args))
        let lhs_params = ir_value_list_prepend(lhs_value, ir_value_list_empty())
        let lhs_term = if op == 12 {
          ir_term_branch(lhs_value, rhs_start, const_block)
        } else {
          ir_term_branch(lhs_value, const_block, rhs_start)
        }
        let lhs_merge = ir_block_new_params(lhs_merge_block, lhs_params, ir_inst_list_empty(), lhs_term)
        let blocks = ir_block_list_append(
          pipeline_lowered_blocks_blocks(lhs_blocks),
          ir_block_list_prepend(lhs_merge, ir_block_list_append(pipeline_lowered_blocks_blocks(rhs_blocks), ir_block_list_prepend(const_node, ir_block_list_empty())))
        )
        pipeline_lowered_blocks(const_block + 1, const_value + 1, blocks, 1)
      } else {
        pipeline_lowered_blocks_invalid(start_block, next_value)
      }
    }
  } else {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  }
}

fn pipeline_lower_binop_typed_to_target_blocks(op: i64, lhs_expr: Expr, rhs_expr: Expr, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  if op == 12 or op == 13 {
    pipeline_lower_logical_typed_to_target_blocks(op, lhs_expr, rhs_expr, params, locals, module, next_value, start_block, next_block, target_block)
  } else {
    let src = pipeline_lower_module_src(module)
    let tt = pipeline_lower_module_tt(module)
    let binary_op = ir_binary_op_from_parser(op)
    if ir_binary_op_is_supported(binary_op) == 1 {
      let float_prim = pipeline_binop_float_prim_typed_temp(op, lhs_expr, rhs_expr, params, locals, src, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module))
      let int_prim = if float_prim == 0 {
        pipeline_binop_int_prim_typed(op, lhs_expr, rhs_expr, params, locals, src, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module))
      } else { 0 - 1 }
      let numeric_prim = if float_prim != 0 { float_prim } else { int_prim }
      let lhs_merge_block = next_block
      let lhs_blocks = pipeline_lower_expr_typed_to_target_blocks_reserved_with_float(lhs_expr, params, locals, module, next_value, start_block, next_block + 1, lhs_merge_block, numeric_prim)
      if pipeline_lowered_blocks_is_valid(lhs_blocks) == 1 {
        if pipeline_lowered_blocks_falls_through(lhs_blocks) == 0 {
          lhs_blocks
        } else {
          let lhs_value = pipeline_lowered_blocks_next_value(lhs_blocks)
          let rhs_start = pipeline_lowered_blocks_next_block(lhs_blocks)
          let rhs_merge_block = rhs_start + 1
          let rhs_blocks = pipeline_lower_expr_typed_to_target_blocks_reserved_with_float(rhs_expr, params, locals, module, lhs_value + 1, rhs_start, rhs_start + 2, rhs_merge_block, numeric_prim)
          if pipeline_lowered_blocks_is_valid(rhs_blocks) == 1 {
            let lhs_params = ir_value_list_prepend(lhs_value, ir_value_list_empty())
            let lhs_merge = ir_block_new_params(lhs_merge_block, lhs_params, ir_inst_list_empty(), ir_term_jump(rhs_start))
            if pipeline_lowered_blocks_falls_through(rhs_blocks) == 0 {
              let blocks = ir_block_list_append(pipeline_lowered_blocks_blocks(lhs_blocks), ir_block_list_prepend(lhs_merge, pipeline_lowered_blocks_blocks(rhs_blocks)))
              pipeline_lowered_blocks_control(pipeline_lowered_blocks_next_block(rhs_blocks), pipeline_lowered_blocks_next_value(rhs_blocks), blocks, 1, 0)
            } else {
              let rhs_value = pipeline_lowered_blocks_next_value(rhs_blocks)
              let body_start = pipeline_lowered_blocks_next_block(rhs_blocks)
              let dst = rhs_value + 1
              let str_eq = if float_prim == 0 and int_prim < 0 { pipeline_binop_is_str_content_eq(op, lhs_expr, rhs_expr, params, locals, src, tt, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module)) } else { 0 }
              let body_insts = if str_eq == 1 {
                pipeline_str_content_eq_insts(op, dst, lhs_value, rhs_value)
              } else {
                let inst = if float_prim != 0 {
                  ir_inst_float_binary_i64(dst, float_prim, binary_op, lhs_value, rhs_value)
                } else { if int_prim >= 0 {
                  ir_inst_float_binary_i64(dst, int_prim, binary_op, lhs_value, rhs_value)
                } else {
                  ir_inst_binary_i64(dst, binary_op, lhs_value, rhs_value)
                } }
                ir_inst_list_prepend(inst, ir_inst_list_empty())
              }
              let result = if str_eq == 1 { pipeline_str_content_eq_result(op, dst) } else { dst }
              let body_args = ir_value_list_prepend(result, ir_value_list_empty())
              let rhs_params = ir_value_list_prepend(rhs_value, ir_value_list_empty())
              let rhs_merge = ir_block_new_params(rhs_merge_block, rhs_params, ir_inst_list_empty(), ir_term_jump(body_start))
              let body_block = ir_block_new_term(body_start, body_insts, ir_term_jump_args(target_block, body_args))
              let blocks = ir_block_list_append(
                pipeline_lowered_blocks_blocks(lhs_blocks),
                ir_block_list_prepend(lhs_merge, ir_block_list_append(pipeline_lowered_blocks_blocks(rhs_blocks), ir_block_list_prepend(rhs_merge, ir_block_list_prepend(body_block, ir_block_list_empty()))))
              )
              pipeline_lowered_blocks(body_start + 1, result + 1, blocks, 1)
            }
          } else {
            pipeline_lowered_blocks_invalid(start_block, next_value)
          }
        }
      } else {
        pipeline_lowered_blocks_invalid(start_block, next_value)
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  }
}

fn pipeline_lower_field_like_typed_to_target_blocks(base_expr: Expr, field_ns: i64, field_nl: i64, access_fact: FieldAccessFact, is_opt: i64, effect_atom: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let base_merge_block = next_block
  let base_blocks = pipeline_lower_expr_typed_to_target_blocks_reserved(base_expr, params, locals, module, next_value, start_block, next_block + 1, base_merge_block)
  if pipeline_lowered_blocks_is_valid(base_blocks) == 1 {
    if pipeline_lowered_blocks_falls_through(base_blocks) == 0 {
      base_blocks
    } else {
      let base_value = pipeline_lowered_blocks_next_value(base_blocks)
      let inferred_base_ty = pipeline_field_base_type_node_typed(base_expr, src, params, locals, module)
      let fact_base_ty = field_access_fact_base_type_node(access_fact)
      let base_ty = if fact_base_ty != 0 { ty_subst(fact_base_ty, pipeline_lower_module_subst(module)) } else { inferred_base_ty }
      let structural = if is_opt == 0 and (field_access_fact_is_structural(access_fact) == 1 or ty_is_record(base_ty)) { 1 } else { 0 }
      let base_lanes = if structural == 1 { pipeline_type_value_lane_count_or_one(base_ty) } else { 1 }
      let dst = base_value + base_lanes
      let base_params = pipeline_ir_value_lane_ids(base_value, 0, base_lanes)
      let fact_field_ty = field_access_fact_field_type_node(access_fact)
      let field_ty = if is_opt == 1 { 0 } else { if fact_field_ty != 0 { ty_subst(fact_field_ty, pipeline_lower_module_subst(module)) } else { pipeline_typed_field_type_for_base(tt, src, field_ns, field_nl, base_expr, params, locals, module) } }
      let result_lanes = if is_opt == 1 { 1 } else { pipeline_type_value_lane_count_or_one(field_ty) }
      let base_field_index = field_access_fact_word_offset_or(access_fact, pipeline_typed_field_index_for_base(tt, src, field_ns, field_nl, base_expr, params, locals, module))
      let field = if structural == 1 {
        ir_lowered_expr(base_value + base_field_index, dst, ir_inst_list_empty())
      } else {
        let storage_layout = pipeline_record_storage_layout_for_base(tt, src, base_expr, params, locals, module)
        if is_opt == 1 {
          let effect_key = pipeline_effect_atom_dispatch_key(effect_atom, pipeline_lower_module_subst(module), effect_maybe_head_hash())
          ir_lowered_expr(dst, dst + 1, pipeline_ir_opt_chain_insts_for_storage_layout(dst, base_value, str_hash(src, field_ns, field_nl), base_field_index, effect_key, storage_layout))
        } else {
          pipeline_lower_field_load_for_storage_layout(dst, base_value, str_hash(src, field_ns, field_nl), base_field_index, field_ty, storage_layout)
        }
      }
      let result_args = pipeline_ir_value_lane_ids(ir_lowered_expr_value(field), 0, result_lanes)
      let merge = ir_block_new_params(base_merge_block, base_params, ir_lowered_expr_insts(field), ir_term_jump_args(target_block, result_args))
      let blocks = ir_block_list_append(pipeline_lowered_blocks_blocks(base_blocks), ir_block_list_prepend(merge, ir_block_list_empty()))
      pipeline_lowered_blocks(pipeline_lowered_blocks_next_block(base_blocks), ir_lowered_expr_next_value(field), blocks, 1)
    }
  } else {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  }
}

-- Record storage owns every managed field count. Normalise a borrowed field
-- expression to an owned count from the declaration's field type, just as
-- variant construction and owning call parameters do. Looking the type up
-- here keeps this an ownership fact rather than a record-name recogniser.
fn pipeline_record_field_word_offset_in_entry(entry: i64, caller_src: i64, field_ns: i64, field_nl: i64, subst: i64) -> i64 {
  if entry == 0 { 0 - 1 }
  else {
    let entry_src = mem_load64_at(entry, 48)
    let nfields = mem_load64_at(entry, 24)
    let fields = mem_load64_at(entry, 32)
    let mut i = 0
    let mut word_offset = 0
    let mut result = 0 - 1
    while i < nfields and result < 0 {
      let declared_ns = mem_load64_at(fields, i * 24)
      let declared_nl = mem_load64_at(fields, i * 24 + 8)
      if declared_nl == field_nl and src_eq_at(caller_src, field_ns, entry_src + declared_ns, 0, field_nl) == 1 {
        result = word_offset
      } else {
        let raw_ty = mem_load64_at(fields, i * 24 + 16)
        let field_ty = if subst == 0 { raw_ty } else { ty_subst(raw_ty, subst) }
        word_offset = word_offset + pipeline_type_value_lane_count_or_one(field_ty)
        i = i + 1
      }
    }
    result
  }
}

fn pipeline_record_field_type_in_entry(entry: i64, caller_src: i64, field_ns: i64, field_nl: i64, subst: i64) -> i64 {
  if entry == 0 { 0 }
  else {
    let entry_src = mem_load64_at(entry, 48)
    let raw_ty = ttable_field_type(entry, entry_src, caller_src, field_ns, field_nl)
    if raw_ty == 0 { 0 } else { if subst == 0 { raw_ty } else { ty_subst(raw_ty, subst) } }
  }
}

fn pipeline_record_field_expected_type(tt: i64, src: i64, type_ns: i64, type_nl: i64, field_ns: i64, field_nl: i64, subst: i64) -> i64 {
  if tt == 0 { 0 }
  else {
    let entry = ttable_lookup(tt, src, type_ns, type_nl)
    pipeline_record_field_type_in_entry(entry, src, field_ns, field_nl, subst)
  }
}

fn pipeline_record_field_word_offset(tt: i64, src: i64, type_ns: i64, type_nl: i64, field_ns: i64, field_nl: i64, subst: i64) -> i64 {
  if tt == 0 { 0 - 1 }
  else { pipeline_record_field_word_offset_in_entry(ttable_lookup(tt, src, type_ns, type_nl), src, field_ns, field_nl, subst) }
}

fn pipeline_record_storage_field_facts_reverse_into(fields: PipelineRecordStorageFieldFactList, out: PipelineRecordStorageFieldFactList) -> PipelineRecordStorageFieldFactList {
  match fields {
    PipelineRecordStorageFieldFactNil -> out
    PipelineRecordStorageFieldFactWord(field_hash, word_offset, byte_offset, field_ty, lanes, rest) -> {
      pipeline_record_storage_field_facts_reverse_into(rest, PipelineRecordStorageFieldFactWord(field_hash, word_offset, byte_offset, field_ty, lanes, out))
    }
    PipelineRecordStorageFieldFactArray(field_hash, word_offset, byte_offset, field_ty, byte_size, align, leaf_count, leaf_stride, leaf_kind, rest) -> {
      pipeline_record_storage_field_facts_reverse_into(rest, PipelineRecordStorageFieldFactArray(field_hash, word_offset, byte_offset, field_ty, byte_size, align, leaf_count, leaf_stride, leaf_kind, out))
    }
  }
}

fn pipeline_record_storage_layout_data_size_or(layout: PipelineRecordStorageLayout, default: i64) -> i64 {
  match layout {
    PipelineRecordStorageLayoutDescribed(data_size, align, fields) -> data_size
    _ -> default
  }
}

fn pipeline_record_storage_layout_align_or(layout: PipelineRecordStorageLayout, default: i64) -> i64 {
  match layout {
    PipelineRecordStorageLayoutDescribed(data_size, align, fields) -> align
    _ -> default
  }
}

fn pipeline_record_storage_layout_fields(layout: PipelineRecordStorageLayout) -> PipelineRecordStorageFieldFactList {
  match layout {
    PipelineRecordStorageLayoutDescribed(data_size, align, fields) -> fields
    _ -> PipelineRecordStorageFieldFactNil
  }
}

fn pipeline_record_storage_layout_is_described(layout: PipelineRecordStorageLayout) -> i64 {
  match layout { PipelineRecordStorageLayoutDescribed(data_size, align, fields) -> 1 _ -> 0 }
}

fn pipeline_record_storage_layout_is_invalid(layout: PipelineRecordStorageLayout) -> i64 {
  match layout { PipelineRecordStorageLayoutInvalid -> 1 _ -> 0 }
}

fn pipeline_record_storage_layout_for_entry(tt: i64, entry: i64, subst: i64) -> PipelineRecordStorageLayout {
  if entry == 0 { PipelineRecordStorageLayoutInvalid }
  else {
    let entry_src = mem_load64_at(entry, 48)
    let nfields = mem_load64_at(entry, 24)
    let fields = mem_load64_at(entry, 32)
    let mut facts = PipelineRecordStorageFieldFactNil
    let mut logical_word_offset = 0
    let mut byte_cursor = 0
    let mut max_align = 1
    let mut has_array = 0
    let mut valid = 1
    let mut i = 0
    while i < nfields {
      let declared_ns = mem_load64_at(fields, i * 24)
      let declared_nl = mem_load64_at(fields, i * 24 + 8)
      let raw_ty = mem_load64_at(fields, i * 24 + 16)
      let field_ty = if subst == 0 { raw_ty } else { ty_subst(raw_ty, subst) }
      let field_hash = str_hash(entry_src, declared_ns, declared_nl)
      if ty_is_array(field_ty) {
        has_array = 1
        let byte_size = cg_layout_array_size(tt, field_ty)
        let align = cg_layout_array_align(tt, field_ty)
        let raw_leaf_count = cg_layout_array_leaf_count(field_ty)
        let raw_leaf_stride = cg_layout_array_leaf_stride(tt, field_ty)
        let raw_leaf_kind = cg_layout_array_leaf_drop_kind(tt, field_ty)
        if byte_size < 0 or align <= 0 or align > 8 or raw_leaf_count < 0 or raw_leaf_stride < 0 or raw_leaf_kind < 0 {
          valid = 0
        } else {
          let byte_offset = cg_layout_align_up(byte_cursor, align)
          let leaf_count = if raw_leaf_count == 0 or raw_leaf_kind == continuation_cleanup_kind_none() { 0 } else { raw_leaf_count }
          let leaf_stride = if leaf_count == 0 { 0 } else { raw_leaf_stride }
          let leaf_kind = if leaf_count == 0 { continuation_cleanup_kind_none() } else { raw_leaf_kind }
          if byte_offset < 0 or pipeline_array_copy_plan_is_valid(byte_size, leaf_count, leaf_stride, leaf_kind) == 0 {
            valid = 0
          } else {
            facts = PipelineRecordStorageFieldFactArray(field_hash, logical_word_offset, byte_offset, field_ty, byte_size, align, leaf_count, leaf_stride, leaf_kind, facts)
            byte_cursor = byte_offset + byte_size
            max_align = cg_layout_max(max_align, align)
          }
        }
        logical_word_offset = logical_word_offset + 1
      } else {
        let lanes = pipeline_type_value_lane_count_or_one(field_ty)
        let field_tag = if field_ty == 0 { 0 - 1 } else { ty_tag(field_ty) }
        let byte_offset = cg_layout_align_up(byte_cursor, 8)
        if field_ty == 0 or lanes <= 0 or field_tag == 18 or field_tag == 19 or byte_offset < 0 or lanes > 2147483639 / 8 {
          valid = 0
        } else {
          facts = PipelineRecordStorageFieldFactWord(field_hash, logical_word_offset, byte_offset, field_ty, lanes, facts)
          byte_cursor = byte_offset + lanes * 8
          max_align = cg_layout_max(max_align, 8)
        }
        logical_word_offset = logical_word_offset + lanes
      }
      i = i + 1
    }
    let data_size = cg_layout_align_up(byte_cursor, max_align)
    -- Compact records retain their established representation even when a
    -- field has no described-layout encoding yet. Those restrictions matter
    -- only once a direct array selects the descriptor-backed representation.
    if has_array == 0 { PipelineRecordStorageLayoutCompact }
    else { if valid == 0 or data_size < 0 or data_size > 2147483639 { PipelineRecordStorageLayoutInvalid }
    else { PipelineRecordStorageLayoutDescribed(data_size, max_align, pipeline_record_storage_field_facts_reverse_into(facts, PipelineRecordStorageFieldFactNil)) } }
  }
}

fn pipeline_record_storage_field_fact_at_word_offset(fields: PipelineRecordStorageFieldFactList, word_offset: i64) -> PipelineRecordStorageFieldFactList {
  match fields {
    PipelineRecordStorageFieldFactNil -> PipelineRecordStorageFieldFactNil
    PipelineRecordStorageFieldFactWord(field_hash, fact_word_offset, byte_offset, field_ty, lanes, rest) -> {
      if fact_word_offset == word_offset { fields } else { pipeline_record_storage_field_fact_at_word_offset(rest, word_offset) }
    }
    PipelineRecordStorageFieldFactArray(field_hash, fact_word_offset, byte_offset, field_ty, byte_size, align, leaf_count, leaf_stride, leaf_kind, rest) -> {
      if fact_word_offset == word_offset { fields } else { pipeline_record_storage_field_fact_at_word_offset(rest, word_offset) }
    }
  }
}

fn pipeline_ir_record_field_value_at_word_offset(fields: IrRecordFieldList, word_offset: i64) -> i64 {
  match fields {
    IrRecordFieldNil -> 0 - 1
    IrRecordFieldCons(field_hash, fact_word_offset, value, rest) -> {
      if fact_word_offset == word_offset { value } else { pipeline_ir_record_field_value_at_word_offset(rest, word_offset) }
    }
  }
}

fn pipeline_ir_record_values_canonical_args(fields: IrRecordFieldList, word_offset: i64, lanes: i64) -> IrValueList {
  if word_offset >= lanes { ir_value_list_empty() }
  else {
    ir_value_list_prepend(
      pipeline_ir_record_field_value_at_word_offset(fields, word_offset),
      pipeline_ir_record_values_canonical_args(fields, word_offset + 1, lanes)
    )
  }
}

fn pipeline_record_layout_materialize_word_lanes(field_hash: i64, word_offset: i64, byte_offset: i64, field_ty: i64, lanes: i64, lane: i64, values: IrRecordFieldList, tail: IrRecordLayoutFieldList) -> PipelineRecordLayoutMaterialization {
  if lane >= lanes { PipelineRecordLayoutMaterialization(tail, 1) }
  else {
    let value = pipeline_ir_record_field_value_at_word_offset(values, word_offset + lane)
    let rest = pipeline_record_layout_materialize_word_lanes(field_hash, word_offset, byte_offset, field_ty, lanes, lane + 1, values, tail)
    match rest {
      PipelineRecordLayoutMaterialization(rest_fields, rest_valid) -> {
        let managed_kind = cg_managed_drop_kind_for_ty_lane(field_ty, lane)
        PipelineRecordLayoutMaterialization(
          ir_record_layout_field_list_prepend_word(field_hash, byte_offset + lane * 8, value, managed_kind, rest_fields),
          if value < 0 or rest_valid == 0 { 0 } else { 1 }
        )
      }
    }
  }
}

fn pipeline_record_layout_materialize_fields(facts: PipelineRecordStorageFieldFactList, values: IrRecordFieldList) -> PipelineRecordLayoutMaterialization {
  match facts {
    PipelineRecordStorageFieldFactNil -> PipelineRecordLayoutMaterialization(ir_record_layout_field_list_empty(), 1)
    PipelineRecordStorageFieldFactWord(field_hash, word_offset, byte_offset, field_ty, lanes, rest) -> {
      let tail = pipeline_record_layout_materialize_fields(rest, values)
      match tail {
        PipelineRecordLayoutMaterialization(tail_fields, tail_valid) -> {
          let current = pipeline_record_layout_materialize_word_lanes(field_hash, word_offset, byte_offset, field_ty, lanes, 0, values, tail_fields)
          match current {
            PipelineRecordLayoutMaterialization(current_fields, current_valid) -> PipelineRecordLayoutMaterialization(current_fields, if tail_valid == 0 or current_valid == 0 { 0 } else { 1 })
          }
        }
      }
    }
    PipelineRecordStorageFieldFactArray(field_hash, word_offset, byte_offset, field_ty, byte_size, align, leaf_count, leaf_stride, leaf_kind, rest) -> {
      let value = pipeline_ir_record_field_value_at_word_offset(values, word_offset)
      let tail = pipeline_record_layout_materialize_fields(rest, values)
      match tail {
        PipelineRecordLayoutMaterialization(tail_fields, tail_valid) -> PipelineRecordLayoutMaterialization(
          ir_record_layout_field_list_prepend_array(field_hash, byte_offset, value, byte_size, leaf_count, leaf_stride, leaf_kind, tail_fields),
          if value < 0 or tail_valid == 0 { 0 } else { 1 }
        )
      }
    }
  }
}

fn pipeline_record_init_inst_for_storage_layout(tt: i64, entry: i64, subst: i64, dst: i64, type_hash: i64, values: IrRecordFieldList) -> IrInst {
  let layout = pipeline_record_storage_layout_for_entry(tt, entry, subst)
  match layout {
    PipelineRecordStorageLayoutCompact -> ir_inst_record_init_i64(dst, type_hash, values)
    PipelineRecordStorageLayoutInvalid -> ir_inst_record_layout_init_i64(dst, type_hash, 0 - 1, 0, ir_record_layout_field_list_empty())
    PipelineRecordStorageLayoutDescribed(data_size, align, facts) -> {
      match pipeline_record_layout_materialize_fields(facts, values) {
        PipelineRecordLayoutMaterialization(fields, valid) -> {
          if valid == 1 { ir_inst_record_layout_init_i64(dst, type_hash, data_size, align, fields) }
          else { ir_inst_record_layout_init_i64(dst, type_hash, 0 - 1, 0, ir_record_layout_field_list_empty()) }
        }
      }
    }
  }
}

-- Described records copy fixed-array bytes into their own allocation. Each
-- source array handle contributes one owned count: borrowed sources were
-- retained while lowering the field, while owned projections transfer their
-- freshly allocated count. Consume that count after the copy has retained any
-- managed leaves for the record's inline representation.
fn pipeline_record_array_source_releases_for_facts(facts: PipelineRecordStorageFieldFactList, values: IrRecordFieldList, next_value: i64) -> PipelineLoweredArgs {
  match facts {
    PipelineRecordStorageFieldFactNil -> pipeline_lowered_args(ir_value_list_empty(), next_value, ir_inst_list_empty(), 1)
    PipelineRecordStorageFieldFactWord(field_hash, word_offset, byte_offset, field_ty, lanes, rest) -> {
      pipeline_record_array_source_releases_for_facts(rest, values, next_value)
    }
    PipelineRecordStorageFieldFactArray(field_hash, word_offset, byte_offset, field_ty, byte_size, align, leaf_count, leaf_stride, leaf_kind, rest) -> {
      let value = pipeline_ir_record_field_value_at_word_offset(values, word_offset)
      if value < 0 {
        pipeline_lowered_args_invalid(next_value)
      } else {
        let release = ir_inst_list_prepend(
          ir_inst_call_i64(next_value, pipeline_rc_default_release_hash(), ir_value_list_prepend(value, ir_value_list_empty())),
          ir_inst_list_empty()
        )
        let tail = pipeline_record_array_source_releases_for_facts(rest, values, next_value + 1)
        if pipeline_lowered_args_is_valid(tail) == 1 {
          pipeline_lowered_args(ir_value_list_empty(), pipeline_lowered_args_next_value(tail), ir_inst_list_append(release, pipeline_lowered_args_insts(tail)), 1)
        } else {
          pipeline_lowered_args_invalid(next_value)
        }
      }
    }
  }
}

fn pipeline_record_array_source_releases_for_storage_layout(tt: i64, entry: i64, subst: i64, values: IrRecordFieldList, next_value: i64) -> PipelineLoweredArgs {
  match pipeline_record_storage_layout_for_entry(tt, entry, subst) {
    PipelineRecordStorageLayoutDescribed(data_size, align, facts) -> pipeline_record_array_source_releases_for_facts(facts, values, next_value)
    _ -> pipeline_lowered_args(ir_value_list_empty(), next_value, ir_inst_list_empty(), 1)
  }
}

fn pipeline_lower_record_field_blocks_typed(fields: RecordFieldList, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, type_ns: i64, type_nl: i64, record_block: i64, next_value: i64, next_block: i64, values: IrRecordFieldList) -> PipelineLoweredRecordFieldBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  match fields {
    RecordFieldListNil -> pipeline_lowered_record_field_blocks(values, pipeline_lower_operation_next_block(next_block, record_block), next_value, ir_block_list_empty(), 1)
    RecordFieldListCons(field, rest_fields) -> {
      match field {
        RecordField(ns, nl, value_expr, fact) -> {
          let structural = if type_ns == 0 and type_nl <= 0 { 1 } else { 0 }
          let field_hash = if structural == 1 { record_field_hash_or(field, 0) } else { str_hash(src, ns, nl) }
          let subst = pipeline_lower_module_subst(module)
          let resolved_field_ty = record_field_resolved_type_node(field)
          let field_ty = if structural == 1 { resolved_field_ty }
            else { pipeline_record_field_expected_type(tt, src, type_ns, type_nl, ns, nl, subst) }
          let word_offset = if structural == 1 { record_field_word_offset_or(field, 0 - 1) }
            else { pipeline_record_field_word_offset(tt, src, type_ns, type_nl, ns, nl, subst) }
          let field_lanes = pipeline_type_value_lane_count_or_one(field_ty)
          if pipeline_expr_needs_lowering_cfg_typed(value_expr, src) == 1 {
            let field_merge_block = next_block + 1
            let field_next_block = next_block + 2
            let field_blocks = pipeline_lower_expr_typed_to_target_blocks_reserved(value_expr, params, locals, module, next_value, next_block, field_next_block, field_merge_block)
            if pipeline_lowered_blocks_is_valid(field_blocks) == 1 {
              if pipeline_lowered_blocks_falls_through(field_blocks) == 0 {
                pipeline_lowered_record_field_blocks_control(
                  values,
                  pipeline_lowered_blocks_next_block(field_blocks),
                  pipeline_lowered_blocks_next_value(field_blocks),
                  pipeline_lowered_blocks_blocks(field_blocks),
                  1,
                  0
                )
              } else {
                let field_value = pipeline_lowered_blocks_next_value(field_blocks)
                let rest_start = pipeline_lowered_blocks_next_block(field_blocks)
                let retain = pipeline_managed_borrow_retain_arg_typed(value_expr, field_value, field_ty, field_value + field_lanes, src, pipeline_lower_module_fns(module), subst, tt)
                let next_values = ir_record_field_list_append(values, pipeline_ir_record_field_lane_entries(field_hash, word_offset, field_value, field_ty))
                let rest = pipeline_lower_record_field_blocks_typed(rest_fields, params, locals, module, type_ns, type_nl, record_block, pipeline_lowered_args_next_value(retain), rest_start, next_values)
                if pipeline_lowered_record_field_blocks_is_valid(rest) == 1 {
                  let last_field = record_field_list_len(rest_fields) == 0
                  let target = if last_field { record_block } else { rest_start }
                  let field_params = pipeline_ir_value_lane_ids(field_value, 0, field_lanes)
                  let jump = if structural == 1 and last_field {
                    ir_term_jump_args(target, pipeline_ir_record_values_canonical_args(next_values, 0, ir_record_field_list_len(next_values)))
                  } else { ir_term_jump(target) }
                  let field_merge = ir_block_new_params(field_merge_block, field_params, pipeline_lowered_args_insts(retain), jump)
                  let blocks = ir_block_list_append(
                    pipeline_lowered_blocks_blocks(field_blocks),
                    ir_block_list_prepend(field_merge, pipeline_lowered_record_field_blocks_blocks(rest))
                  )
                  pipeline_lowered_record_field_blocks_control(
                    pipeline_lowered_record_field_blocks_values(rest),
                    pipeline_lowered_record_field_blocks_next_block(rest),
                    pipeline_lowered_record_field_blocks_next_value(rest),
                    blocks,
                    1,
                    pipeline_lowered_record_field_blocks_falls_through(rest)
                  )
                } else {
                  pipeline_lowered_record_field_blocks_invalid(next_block, next_value)
                }
              }
            } else {
              pipeline_lowered_record_field_blocks_invalid(next_block, next_value)
            }
          } else {
            let lower_ctx = pipeline_handler_lower_ctx_from_module(params, locals, module)
            let lowered = pipeline_lower_expr_typed_sidecar_handler_ctx(value_expr, next_value, lower_ctx)
            if ir_lowered_expr_is_valid(lowered) == 1 {
              let rest_start = next_block + 1
              let retain = pipeline_managed_borrow_retain_arg_typed(value_expr, ir_lowered_expr_value(lowered), field_ty, ir_lowered_expr_next_value(lowered), src, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module), tt)
              let next_values = ir_record_field_list_append(values, pipeline_ir_record_field_lane_entries(field_hash, word_offset, ir_lowered_expr_value(lowered), field_ty))
              let rest = pipeline_lower_record_field_blocks_typed(rest_fields, params, locals, module, type_ns, type_nl, record_block, pipeline_lowered_args_next_value(retain), rest_start, next_values)
              if pipeline_lowered_record_field_blocks_is_valid(rest) == 1 {
                let last_field = record_field_list_len(rest_fields) == 0
                let target = if last_field { record_block } else { rest_start }
                let jump = if structural == 1 and last_field {
                  ir_term_jump_args(target, pipeline_ir_record_values_canonical_args(next_values, 0, ir_record_field_list_len(next_values)))
                } else { ir_term_jump(target) }
                let block = ir_block_new_term(next_block, ir_inst_list_append(ir_lowered_expr_insts(lowered), pipeline_lowered_args_insts(retain)), jump)
                let blocks = ir_block_list_prepend(block, pipeline_lowered_record_field_blocks_blocks(rest))
                pipeline_lowered_record_field_blocks_control(
                  pipeline_lowered_record_field_blocks_values(rest),
                  pipeline_lowered_record_field_blocks_next_block(rest),
                  pipeline_lowered_record_field_blocks_next_value(rest),
                  blocks,
                  1,
                  pipeline_lowered_record_field_blocks_falls_through(rest)
                )
              } else {
                pipeline_lowered_record_field_blocks_invalid(next_block, next_value)
              }
            } else {
              pipeline_lowered_record_field_blocks_invalid(next_block, next_value)
            }
          }
        }
        UnknownRecordField(tag) -> pipeline_lowered_record_field_blocks_invalid(next_block, next_value)
      }
    }
  }
}

fn pipeline_lower_array_literal_element_blocks_typed(elements: ExprList, index: i64, storage: i64, data: i64, array_ty: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  match elements {
    ExprListNil -> pipeline_lowered_blocks_invalid(start_block, next_value)
    ExprListCons(element, rest) -> {
      let src = pipeline_lower_module_src(module)
      let lower_ctx = pipeline_handler_lower_ctx_from_module(params, locals, module)
      let prim = pipeline_array_literal_element_prim(array_ty)
      let is_last = if expr_list_len(rest) == 0 { 1 } else { 0 }
      if pipeline_expr_needs_lowering_cfg_typed(element, src) == 1 {
        let merge_block = next_block
        let rest_start = next_block + 1
        let child = pipeline_lower_expr_typed_to_target_blocks_reserved_with_float(element, params, locals, module, next_value, start_block, next_block + 2, merge_block, prim)
        if pipeline_lowered_blocks_is_valid(child) == 0 {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        } else { if pipeline_lowered_blocks_falls_through(child) == 0 {
          child
        } else {
          let element_value = pipeline_lowered_blocks_next_value(child)
          let stored = pipeline_lower_array_literal_store_value_typed(element, element_value, data, index, array_ty, element_value + 1, lower_ctx)
          if pipeline_lowered_args_is_valid(stored) == 0 {
            pipeline_lowered_blocks_invalid(start_block, next_value)
          } else {
            let jump = if is_last == 1 {
              ir_term_jump_args(target_block, ir_value_list_prepend(storage, ir_value_list_empty()))
            } else { ir_term_jump(rest_start) }
            let merge = ir_block_new_params(merge_block, ir_value_list_prepend(element_value, ir_value_list_empty()), pipeline_lowered_args_insts(stored), jump)
            if is_last == 1 {
              pipeline_lowered_blocks_control(
                pipeline_lowered_blocks_next_block(child),
                pipeline_lowered_args_next_value(stored),
                ir_block_list_append(pipeline_lowered_blocks_blocks(child), ir_block_list_prepend(merge, ir_block_list_empty())),
                1,
                1
              )
            } else {
              let tail = pipeline_lower_array_literal_element_blocks_typed(rest, index + 1, storage, data, array_ty, params, locals, module, pipeline_lowered_args_next_value(stored), rest_start, pipeline_lowered_blocks_next_block(child), target_block)
              if pipeline_lowered_blocks_is_valid(tail) == 0 {
                pipeline_lowered_blocks_invalid(start_block, next_value)
              } else {
                pipeline_lowered_blocks_control(
                  pipeline_lowered_blocks_next_block(tail),
                  pipeline_lowered_blocks_next_value(tail),
                  ir_block_list_append(pipeline_lowered_blocks_blocks(child), ir_block_list_prepend(merge, pipeline_lowered_blocks_blocks(tail))),
                  1,
                  pipeline_lowered_blocks_falls_through(tail)
                )
              }
            }
          }
        } }
      } else {
        let lowered = if pipeline_prim_is_forced_numeric_context(prim) == 1 {
          pipeline_lower_expr_typed_sidecar_handler_opt_with_float_prim(element, next_value, lower_ctx, prim)
        } else {
          pipeline_lower_expr_typed_sidecar_handler_ctx(element, next_value, lower_ctx)
        }
        if ir_lowered_expr_is_valid(lowered) == 0 {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        } else {
          let stored = pipeline_lower_array_literal_store_value_typed(element, ir_lowered_expr_value(lowered), data, index, array_ty, ir_lowered_expr_next_value(lowered), lower_ctx)
          if pipeline_lowered_args_is_valid(stored) == 0 {
            pipeline_lowered_blocks_invalid(start_block, next_value)
          } else {
            let rest_start = next_block
            let jump = if is_last == 1 {
              ir_term_jump_args(target_block, ir_value_list_prepend(storage, ir_value_list_empty()))
            } else { ir_term_jump(rest_start) }
            let block = ir_block_new_term(start_block, ir_inst_list_append(ir_lowered_expr_insts(lowered), pipeline_lowered_args_insts(stored)), jump)
            if is_last == 1 {
              pipeline_lowered_blocks_control(next_block, pipeline_lowered_args_next_value(stored), ir_block_list_prepend(block, ir_block_list_empty()), 1, 1)
            } else {
              let tail = pipeline_lower_array_literal_element_blocks_typed(rest, index + 1, storage, data, array_ty, params, locals, module, pipeline_lowered_args_next_value(stored), rest_start, next_block + 1, target_block)
              if pipeline_lowered_blocks_is_valid(tail) == 0 {
                pipeline_lowered_blocks_invalid(start_block, next_value)
              } else {
                pipeline_lowered_blocks_control(
                  pipeline_lowered_blocks_next_block(tail),
                  pipeline_lowered_blocks_next_value(tail),
                  ir_block_list_prepend(block, pipeline_lowered_blocks_blocks(tail)),
                  1,
                  pipeline_lowered_blocks_falls_through(tail)
                )
              }
            }
          }
        }
      }
    }
  }
}

fn pipeline_lower_array_literal_typed_to_target_blocks(elements: ExprList, resolved_ty: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let array_ty = ty_subst(resolved_ty, pipeline_lower_module_subst(module))
  let count = expr_list_len(elements)
  let storage = pipeline_lower_array_literal_storage(array_ty, count, next_value, pipeline_lower_module_tt(module))
  if ir_lowered_expr_is_valid(storage) == 0 {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  } else { if count == 0 {
    let block = ir_block_new_term(start_block, ir_lowered_expr_insts(storage), ir_term_jump_args(target_block, ir_value_list_prepend(ir_lowered_expr_value(storage), ir_value_list_empty())))
    pipeline_lowered_blocks_control(next_block, ir_lowered_expr_next_value(storage), ir_block_list_prepend(block, ir_block_list_empty()), 1, 1)
  } else {
    let first_element = next_block
    let entry = ir_block_new_term(start_block, ir_lowered_expr_insts(storage), ir_term_jump(first_element))
    let lowered = pipeline_lower_array_literal_element_blocks_typed(elements, 0, ir_lowered_expr_value(storage), ir_lowered_expr_value(storage) + 6, array_ty, params, locals, module, ir_lowered_expr_next_value(storage), first_element, next_block + 1, target_block)
    if pipeline_lowered_blocks_is_valid(lowered) == 0 {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    } else {
      pipeline_lowered_blocks_control(
        pipeline_lowered_blocks_next_block(lowered),
        pipeline_lowered_blocks_next_value(lowered),
        ir_block_list_prepend(entry, pipeline_lowered_blocks_blocks(lowered)),
        1,
        pipeline_lowered_blocks_falls_through(lowered)
      )
    }
  } }
}

fn pipeline_lower_record_init_typed_to_target_blocks(type_ns: i64, type_nl: i64, fields: RecordFieldList, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let record_block = next_block
  let first_field_block = pipeline_lower_operation_child_start_block(record_block, record_field_list_len(fields))
  let lowered_fields = pipeline_lower_record_field_blocks_typed(fields, params, locals, module, type_ns, type_nl, record_block, next_value, first_field_block, ir_record_field_list_empty())
  if pipeline_lowered_record_field_blocks_is_valid(lowered_fields) == 1 {
    let entry = ir_block_new_term(start_block, ir_inst_list_empty(), ir_term_jump(first_field_block))
    if pipeline_lowered_record_field_blocks_falls_through(lowered_fields) == 0 {
      let blocks = ir_block_list_prepend(entry, pipeline_lowered_record_field_blocks_blocks(lowered_fields))
      pipeline_lowered_blocks_control(pipeline_lowered_record_field_blocks_next_block(lowered_fields), pipeline_lowered_record_field_blocks_next_value(lowered_fields), blocks, 1, 0)
    } else {
      let record_dst = pipeline_lowered_record_field_blocks_next_value(lowered_fields)
      if type_ns == 0 and type_nl <= 0 {
        let record_ty = pipeline_structural_record_value_type(fields, if type_nl < 0 { 1 } else { 0 })
        let record_lanes = pipeline_type_value_lane_count_or_one(record_ty)
        let record_args = pipeline_ir_value_lane_ids(record_dst, 0, record_lanes)
        let record = if record_field_list_len(fields) == 0 {
          ir_block_new_term(record_block, ir_inst_list_prepend(ir_inst_const_i64(record_dst, 0), ir_inst_list_empty()), ir_term_jump_args(target_block, record_args))
        } else {
          ir_block_new_params(record_block, record_args, ir_inst_list_empty(), ir_term_jump_args(target_block, record_args))
        }
        let blocks = ir_block_list_prepend(
          entry,
          ir_block_list_append(pipeline_lowered_record_field_blocks_blocks(lowered_fields), ir_block_list_prepend(record, ir_block_list_empty()))
        )
        pipeline_lowered_blocks(pipeline_lowered_record_field_blocks_next_block(lowered_fields), record_dst + record_lanes, blocks, 1)
      } else {
        let record_entry = ttable_lookup(pipeline_lower_module_tt(module), src, type_ns, type_nl)
        let record_inst = ir_inst_list_prepend(
          pipeline_record_init_inst_for_storage_layout(
            pipeline_lower_module_tt(module),
            record_entry,
            pipeline_lower_module_subst(module),
            record_dst,
            str_hash(src, type_ns, type_nl),
            pipeline_lowered_record_field_blocks_values(lowered_fields)
          ),
          ir_inst_list_empty()
        )
        let cleanup = pipeline_record_array_source_releases_for_storage_layout(
          pipeline_lower_module_tt(module),
          record_entry,
          pipeline_lower_module_subst(module),
          pipeline_lowered_record_field_blocks_values(lowered_fields),
          record_dst + 1
        )
        if pipeline_lowered_args_is_valid(cleanup) == 1 {
          let record_args = ir_value_list_prepend(record_dst, ir_value_list_empty())
          let record = ir_block_new_term(record_block, ir_inst_list_append(record_inst, pipeline_lowered_args_insts(cleanup)), ir_term_jump_args(target_block, record_args))
          let blocks = ir_block_list_prepend(
            entry,
            ir_block_list_append(pipeline_lowered_record_field_blocks_blocks(lowered_fields), ir_block_list_prepend(record, ir_block_list_empty()))
          )
          pipeline_lowered_blocks(pipeline_lowered_record_field_blocks_next_block(lowered_fields), pipeline_lowered_args_next_value(cleanup), blocks, 1)
        } else {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        }
      }
    }
  } else {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  }
}

-- Collection handles are sealed, zero-wrapper machine words. A bridge call on
-- a stable named value can therefore lower to the existing transmute identity
-- intrinsic without manufacturing a callee-owned stake: no callee runs and the
-- source binding keeps the handle alive. Keep temporary/compound arguments on
-- the ordinary owning call path because their raw result may alias the stake
-- that temporary cleanup releases after the call.
fn pipeline_collection_handle_word_stable_call(src: i64, ns: i64, nl: i64, args: ExprList) -> i64 {
  let stable_arg = if expr_list_len(args) != 1 { 0 }
  else {
    match pipeline_expr_strip_typed(pipeline_expr_list_nth_or(args, 0, NilExpr)) {
      Ident(arg_ns, arg_nl) -> 1
      _ -> 0
    }
  }
  if stable_arg == 0 { 0 }
  else { if src_eq(src, ns, nl, "vector_storage_handle_word") == 1 or
    src_eq(src, ns, nl, "persistent_vector_storage_handle_word") == 1 or
    src_eq(src, ns, nl, "map_storage_handle_word") == 1 or
    src_eq(src, ns, nl, "set_storage_handle_word") == 1 { 1 }
  else { 0 } }
}

fn pipeline_collection_handle_word_inst(dst: i64, args: IrValueList) -> IrInst {
  ir_inst_call_i64(dst, pipeline_ir_native_intrinsic_transmute_hash(), args)
}

fn pipeline_option_some_hash() -> i64 {
  str_hash(__str_ptr("option_some"), 0, __str_len("option_some"))
}

fn pipeline_option_none_hash() -> i64 {
  str_hash(__str_ptr("option_none"), 0, __str_len("option_none"))
}

fn pipeline_vector_to_array_call_shape(src: i64, ns: i64, nl: i64, args: ExprList, type_args: TypeExprList) -> i64 {
  if src_eq(src, ns, nl, "to_array") != 1 or expr_list_len(args) != 1 or type_expr_list_len(type_args) != 2 { 0 }
  else {
    let element_ty = type_expr_to_node(type_expr_list_nth(type_args, 0))
    let array_ty = type_expr_to_node(type_expr_list_nth(type_args, 1))
    if ty_is_array(array_ty) and ty_eq(ty_array_inner(array_ty), element_ty) and ty_array_length(array_ty) >= 0 { 1 } else { 0 }
  }
}

-- Lower the checker-produced `to_array<T, [T; N]>` fact. The length branch
-- precedes allocation; the success edge copies with the shared array leaf
-- plan (including managed retains), then constructs Some. The failure edge
-- constructs None. A temporary Vector receiver is released on either edge.
fn pipeline_lower_vector_to_array_typed_to_target_blocks(type_args: TypeExprList, args: ExprList, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let fns = pipeline_lower_module_fns(module)
  let subst = pipeline_lower_module_subst(module)
  let concrete_type_args = pipeline_type_expr_list_subst(type_args, subst)
  let valid_shape = if expr_list_len(args) != 1 or type_expr_list_len(concrete_type_args) != 2 { 0 }
    else {
      let expected_element = type_expr_to_node(type_expr_list_nth(concrete_type_args, 0))
      let expected_array = type_expr_to_node(type_expr_list_nth(concrete_type_args, 1))
      if ty_is_array(expected_array) and ty_eq(ty_array_inner(expected_array), expected_element) and ty_array_length(expected_array) >= 0 { 1 } else { 0 }
    }
  if valid_shape == 0 {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  } else {
    let receiver_expr = pipeline_expr_list_nth_or(args, 0, NilExpr)
    let element_ty = type_expr_to_node(type_expr_list_nth(concrete_type_args, 0))
    let array_ty = type_expr_to_node(type_expr_list_nth(concrete_type_args, 1))
    let length = ty_array_length(array_ty)
    let check_block = next_block
    let receiver_blocks = pipeline_lower_expr_typed_to_target_blocks_reserved(receiver_expr, params, locals, module, next_value, start_block, next_block + 1, check_block)
    if pipeline_lowered_blocks_is_valid(receiver_blocks) == 0 { pipeline_lowered_blocks_invalid(start_block, next_value) }
    else { if pipeline_lowered_blocks_falls_through(receiver_blocks) == 0 { receiver_blocks }
    else {
      let receiver_value = pipeline_lowered_blocks_next_value(receiver_blocks)
      let len_value = receiver_value + 1
      let expected_value = len_value + 1
      let equal_value = expected_value + 1
      let element_type_nodes = nlist_new_capacity(1)
      nlist_add(element_type_nodes, element_ty)
      let check_insts = ir_inst_list_prepend(
        ir_inst_generic_call_i64(len_value, pipeline_ir_vector_len_hash(), element_type_nodes, ir_value_list_prepend(receiver_value, ir_value_list_empty())),
        ir_inst_list_prepend(
          ir_inst_const_i64(expected_value, length),
          ir_inst_list_prepend(ir_inst_binary_i64(equal_value, ir_binary_op_eq(), len_value, expected_value), ir_inst_list_empty())
        )
      )
      let match_block = pipeline_lower_internal_block_after_target(pipeline_lowered_blocks_next_block(receiver_blocks), target_block)
      let none_block = pipeline_lower_internal_block_after_target(match_block + 1, target_block)
      let check = ir_block_new_params(check_block, ir_value_list_prepend(receiver_value, ir_value_list_empty()), check_insts, ir_term_branch(equal_value, match_block, none_block))

      let storage = pipeline_lower_array_literal_storage(array_ty, length, equal_value + 1, tt)
      if ir_lowered_expr_is_valid(storage) == 0 { pipeline_lowered_blocks_invalid(start_block, next_value) }
      else {
        let byte_size = cg_layout_array_size(tt, array_ty)
        let leaf_count = cg_layout_array_leaf_count(array_ty)
        let leaf_stride = pipeline_array_literal_leaf_stride(tt, array_ty)
        let leaf_kind = pipeline_array_literal_leaf_kind(tt, array_ty)
        if pipeline_array_copy_plan_is_valid(byte_size, leaf_count, leaf_stride, leaf_kind) == 0 { pipeline_lowered_blocks_invalid(start_block, next_value) }
        else {
          let dest_data = ir_lowered_expr_next_value(storage) - 1
          let source_data = ir_lowered_expr_next_value(storage)
          let some_result = source_data + 1
          let array_type_nodes = nlist_new_capacity(1)
          nlist_add(array_type_nodes, array_ty)
          let source_and_copy = ir_inst_list_prepend(
            ir_inst_generic_call_i64(source_data, pipeline_vector_data_hash(), element_type_nodes, ir_value_list_prepend(receiver_value, ir_value_list_empty())),
            if byte_size == 0 { ir_inst_list_empty() }
            else { ir_inst_list_prepend(ir_inst_array_copy_i64(dest_data, source_data, byte_size, leaf_count, leaf_stride, leaf_kind), ir_inst_list_empty()) }
          )
          let some_call = ir_inst_list_prepend(
            ir_inst_generic_call_i64(some_result, pipeline_option_some_hash(), array_type_nodes, ir_value_list_prepend(ir_lowered_expr_value(storage), ir_value_list_empty())),
            ir_inst_list_empty()
          )
          let receiver_ty = pipeline_return_expr_type_node_typed(receiver_expr, params, locals, module)
          let receiver_borrowed = if receiver_ty == 0 { 1 }
            else { pipeline_expr_result_is_borrowed_for_ty_typed(receiver_expr, receiver_ty, src, fns, subst, tt) }
          let some_release_dst = some_result + 1
          let some_release = if receiver_borrowed == 0 {
            ir_inst_list_prepend(ir_inst_call_i64(some_release_dst, pipeline_rc_default_release_hash(), ir_value_list_prepend(receiver_value, ir_value_list_empty())), ir_inst_list_empty())
          } else { ir_inst_list_empty() }
          let some_next = if receiver_borrowed == 0 { some_release_dst + 1 } else { some_result + 1 }
          let some = ir_block_new_term(
            match_block,
            ir_inst_list_append(ir_lowered_expr_insts(storage), ir_inst_list_append(source_and_copy, ir_inst_list_append(some_call, some_release))),
            ir_term_jump_args(target_block, ir_value_list_prepend(some_result, ir_value_list_empty()))
          )

          let none_result = some_next
          let none_call = ir_inst_list_prepend(ir_inst_generic_call_i64(none_result, pipeline_option_none_hash(), array_type_nodes, ir_value_list_empty()), ir_inst_list_empty())
          let none_release_dst = none_result + 1
          let none_release = if receiver_borrowed == 0 {
            ir_inst_list_prepend(ir_inst_call_i64(none_release_dst, pipeline_rc_default_release_hash(), ir_value_list_prepend(receiver_value, ir_value_list_empty())), ir_inst_list_empty())
          } else { ir_inst_list_empty() }
          let final_value = if receiver_borrowed == 0 { none_release_dst + 1 } else { none_result + 1 }
          let none = ir_block_new_term(none_block, ir_inst_list_append(none_call, none_release), ir_term_jump_args(target_block, ir_value_list_prepend(none_result, ir_value_list_empty())))
          let after_block = pipeline_lower_internal_block_after_target(none_block + 1, target_block)
          let blocks = ir_block_list_append(
            pipeline_lowered_blocks_blocks(receiver_blocks),
            ir_block_list_prepend(check, ir_block_list_prepend(some, ir_block_list_prepend(none, ir_block_list_empty())))
          )
          pipeline_lowered_blocks(after_block, final_value, blocks, 1)
        }
      }
    } }
  }
}

fn pipeline_lower_generic_call_typed_to_target_blocks(type_args: TypeExprList, inner_call: Expr, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let fns = pipeline_lower_module_fns(module)
  let subst = pipeline_lower_module_subst(module)
  let concrete_type_args = pipeline_type_expr_list_subst(type_args, subst)
  match inner_call {
    Call(ns, nl, args_exprs) -> {
      if pipeline_vector_to_array_call_shape(src, ns, nl, args_exprs, concrete_type_args) == 1 {
        pipeline_lower_vector_to_array_typed_to_target_blocks(type_args, args_exprs, params, locals, module, next_value, start_block, next_block, target_block)
      } else { if pipeline_variant_payload_count(tt, src, ns, nl) >= 0 or pipeline_call_callee_is_direct(params, locals, src, ns, nl) == 1 {
        let call_block = next_block
        let arg_count = expr_list_len(args_exprs)
        let first_arg_block = pipeline_lower_operation_child_start_block(call_block, arg_count)
        let template_pair = pipeline_generic_template_find(fns, src, str_hash(src, ns, nl))
        let variant_payloads = pipeline_variant_payload_types(tt, src, ns, nl)
        let variant_tparams = if variant_payloads == 0 { 0 } else { ttable_variant_tparams(tt, src, ns, nl) }
        let template_pair = if variant_payloads == 0 { pipeline_generic_template_find(fns, src, str_hash(src, ns, nl)) } else { 0 }
        let expected_params = if template_pair == 0 { 0 } else { node_f3(pipeline_fn_inner(node_f1(template_pair))) }
        let expected_subst = if variant_payloads != 0 {
          if variant_tparams == 0 { subst } else { cg_build_subst(variant_tparams, type_expr_list_to_nodes(concrete_type_args)) }
        } else {
          if template_pair == 0 { 0 } else { cg_build_subst(fn_tparams(node_f1(template_pair)), type_expr_list_to_nodes(concrete_type_args)) }
        }
        let stable_handle_word = pipeline_collection_handle_word_stable_call(src, ns, nl, args_exprs)
        let borrowed_mask = if stable_handle_word == 1 { 1 }
        else { if variant_payloads == 0 and template_pair != 0 {
          pipeline_fn_effective_borrowable_param_mask_from_pair(fns, template_pair, expected_params, expected_subst)
        } else { 0 } }
        let lowered_args = pipeline_lower_call_arg_blocks_typed_with_borrow_mask(args_exprs, arg_count, params, locals, module, call_block, expected_params, variant_payloads, expected_subst, 0, borrowed_mask, 0, next_value, first_arg_block, ir_value_list_empty())
        if pipeline_lowered_call_blocks_is_valid(lowered_args) == 1 {
          let entry = ir_block_new_term(start_block, ir_inst_list_empty(), ir_term_jump(first_arg_block))
          if pipeline_lowered_call_blocks_falls_through(lowered_args) == 0 {
            let blocks = ir_block_list_prepend(entry, pipeline_lowered_call_blocks_blocks(lowered_args))
            pipeline_lowered_blocks_control(pipeline_lowered_call_blocks_next_block(lowered_args), pipeline_lowered_call_blocks_next_value(lowered_args), blocks, 1, 0)
          } else {
            let call_dst = pipeline_lowered_call_blocks_next_value(lowered_args)
            let logical_args = pipeline_lowered_call_blocks_values(lowered_args)
            let abi_args = if variant_payloads != 0 {
              pipeline_call_abi_args(logical_args, 0, variant_payloads, expected_subst, 0, 0)
            } else { if template_pair != 0 and stable_handle_word == 0 {
              pipeline_call_abi_args(logical_args, expected_params, 0, expected_subst, 0, 0)
            } else { logical_args } }
            let call_head = ir_inst_list_prepend(
              if stable_handle_word == 1 {
                pipeline_collection_handle_word_inst(call_dst, logical_args)
              } else {
                pipeline_generic_call_inst_typed(call_dst, src, tt, ns, nl, concrete_type_args, abi_args)
              },
              ir_inst_list_empty()
            )
            let result_ty = if template_pair == 0 { 0 } else { ty_subst(fn_ret_type(node_f1(template_pair)), expected_subst) }
            let result_lanes = if template_pair != 0 and stable_handle_word == 0 { pipeline_type_value_lane_count_or_one(result_ty) } else { 1 }
            let call_result_lanes = if template_pair != 0 and stable_handle_word == 0 {
              pipeline_ir_call_result_lane_insts(call_dst, result_ty)
            } else { ir_inst_list_empty() }
            let cleanup = pipeline_managed_lambda_temp_release_args_masked_typed(args_exprs, logical_args, 0, call_dst + result_lanes, borrowed_mask, 0, expected_params, variant_payloads, expected_subst, pipeline_lower_module_src(module), pipeline_lower_module_tt(module))
            let call_insts = ir_inst_list_append(call_head, ir_inst_list_append(call_result_lanes, pipeline_lowered_args_insts(cleanup)))
            let call_args = pipeline_ir_value_lane_ids(call_dst, 0, result_lanes)
            let call = ir_block_new_term(call_block, call_insts, ir_term_jump_args(target_block, call_args))
            let blocks = ir_block_list_prepend(entry, ir_block_list_append(pipeline_lowered_call_blocks_blocks(lowered_args), ir_block_list_prepend(call, ir_block_list_empty())))
            pipeline_lowered_blocks(pipeline_lowered_call_blocks_next_block(lowered_args), pipeline_lowered_args_next_value(cleanup), blocks, 1)
          }
        } else {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        }
      } else {
        pipeline_lowered_blocks_invalid(start_block, next_value)
      } }
    }
    _ -> pipeline_lowered_blocks_invalid(start_block, next_value)
  }
}

fn pipeline_lower_method_call_typed_after_receiver(recv_value: i64, recv_blocks: PipelineLoweredBlocks, entry_insts: IrInstList, args_exprs: ExprList, method_hash: i64, method_ref: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let subst = pipeline_lower_module_subst(module)
  let method_params = pipeline_method_ref_params(tt, method_ref, method_hash, subst)
  let borrowed_mask = pipeline_method_ref_borrowable_param_mask(pipeline_lower_module_fns(module), tt, method_ref, method_hash, subst)
  let call_block = next_block
  let arg_count = expr_list_len(args_exprs)
  let first_arg_block = pipeline_lower_operation_child_start_block(call_block, arg_count)
  let lowered_args = pipeline_lower_call_arg_blocks_typed_with_borrow_mask(args_exprs, arg_count, params, locals, module, call_block, method_params, 0, 0, 1, borrowed_mask, 0, recv_value + 1, first_arg_block, ir_value_list_empty())
  if pipeline_lowered_call_blocks_is_valid(lowered_args) == 1 {
    if pipeline_lowered_call_blocks_falls_through(lowered_args) == 0 {
      let blocks = ir_block_list_append(pipeline_lowered_blocks_blocks(recv_blocks), pipeline_lowered_call_blocks_blocks(lowered_args))
      pipeline_lowered_blocks_control(pipeline_lowered_call_blocks_next_block(lowered_args), pipeline_lowered_call_blocks_next_value(lowered_args), blocks, 1, 0)
    } else {
      let call_dst = pipeline_lowered_call_blocks_next_value(lowered_args)
      let call_inst = ir_inst_list_prepend(
        pipeline_method_call_inst(call_dst, method_ref, method_hash, recv_value, pipeline_lowered_call_blocks_values(lowered_args), subst, tt),
        ir_inst_list_empty()
      )
      let cleanup = pipeline_managed_lambda_temp_release_args_masked_typed(args_exprs, pipeline_lowered_call_blocks_values(lowered_args), 0, call_dst + 1, borrowed_mask, 1, method_params, 0, 0, pipeline_lower_module_src(module), pipeline_lower_module_tt(module))
      let call_insts = ir_inst_list_append(call_inst, pipeline_lowered_args_insts(cleanup))
      let call_args = ir_value_list_prepend(call_dst, ir_value_list_empty())
      let call = ir_block_new_term(call_block, call_insts, ir_term_jump_args(target_block, call_args))
      let receiver_params = ir_value_list_prepend(recv_value, ir_value_list_empty())
      let receiver_merge = ir_block_new_params(next_block - 1, receiver_params, entry_insts, ir_term_jump(first_arg_block))
      let blocks = ir_block_list_append(
        pipeline_lowered_blocks_blocks(recv_blocks),
        ir_block_list_prepend(receiver_merge, ir_block_list_append(pipeline_lowered_call_blocks_blocks(lowered_args), ir_block_list_prepend(call, ir_block_list_empty())))
      )
      pipeline_lowered_blocks(pipeline_lowered_call_blocks_next_block(lowered_args), pipeline_lowered_args_next_value(cleanup), blocks, 1)
    }
  } else {
    pipeline_lowered_blocks_invalid(next_block, recv_value + 1)
  }
}

fn pipeline_lower_method_call_typed_after_straight_receiver(recv_value: i64, entry_insts: IrInstList, args_exprs: ExprList, method_hash: i64, method_ref: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let subst = pipeline_lower_module_subst(module)
  let method_params = pipeline_method_ref_params(tt, method_ref, method_hash, subst)
  let borrowed_mask = pipeline_method_ref_borrowable_param_mask(pipeline_lower_module_fns(module), tt, method_ref, method_hash, subst)
  let call_block = next_block
  let arg_count = expr_list_len(args_exprs)
  let first_arg_block = pipeline_lower_operation_child_start_block(call_block, arg_count)
  let lowered_args = pipeline_lower_call_arg_blocks_typed_with_borrow_mask(args_exprs, arg_count, params, locals, module, call_block, method_params, 0, 0, 1, borrowed_mask, 0, recv_value + 1, first_arg_block, ir_value_list_empty())
  if pipeline_lowered_call_blocks_is_valid(lowered_args) == 1 {
    let entry = ir_block_new_term(start_block, entry_insts, ir_term_jump(first_arg_block))
    if pipeline_lowered_call_blocks_falls_through(lowered_args) == 0 {
      let blocks = ir_block_list_prepend(entry, pipeline_lowered_call_blocks_blocks(lowered_args))
      pipeline_lowered_blocks_control(pipeline_lowered_call_blocks_next_block(lowered_args), pipeline_lowered_call_blocks_next_value(lowered_args), blocks, 1, 0)
    } else {
      let call_dst = pipeline_lowered_call_blocks_next_value(lowered_args)
      let call_inst = ir_inst_list_prepend(
        pipeline_method_call_inst(call_dst, method_ref, method_hash, recv_value, pipeline_lowered_call_blocks_values(lowered_args), subst, tt),
        ir_inst_list_empty()
      )
      let cleanup = pipeline_managed_lambda_temp_release_args_masked_typed(args_exprs, pipeline_lowered_call_blocks_values(lowered_args), 0, call_dst + 1, borrowed_mask, 1, method_params, 0, 0, pipeline_lower_module_src(module), pipeline_lower_module_tt(module))
      let call_args = ir_value_list_prepend(call_dst, ir_value_list_empty())
      let call = ir_block_new_term(call_block, ir_inst_list_append(call_inst, pipeline_lowered_args_insts(cleanup)), ir_term_jump_args(target_block, call_args))
      let blocks = ir_block_list_prepend(entry, ir_block_list_append(pipeline_lowered_call_blocks_blocks(lowered_args), ir_block_list_prepend(call, ir_block_list_empty())))
      pipeline_lowered_blocks(pipeline_lowered_call_blocks_next_block(lowered_args), pipeline_lowered_args_next_value(cleanup), blocks, 1)
    }
  } else {
    pipeline_lowered_blocks_invalid(start_block, recv_value + 1)
  }
}

fn pipeline_lower_method_call_typed_to_target_blocks(recv_expr: Expr, method_hash: i64, args_exprs: ExprList, method_ref: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  if pipeline_expr_needs_lowering_cfg_typed(recv_expr, src) == 1 {
    let receiver_merge_block = next_block
    let receiver_blocks = pipeline_lower_expr_typed_to_target_blocks_reserved(recv_expr, params, locals, module, next_value, start_block, next_block + 1, receiver_merge_block)
    if pipeline_lowered_blocks_is_valid(receiver_blocks) == 1 {
      if pipeline_lowered_blocks_falls_through(receiver_blocks) == 0 {
        receiver_blocks
      } else {
        let receiver_value = pipeline_lowered_blocks_next_value(receiver_blocks)
        pipeline_lower_method_call_typed_after_receiver(receiver_value, receiver_blocks, ir_inst_list_empty(), args_exprs, method_hash, method_ref, params, locals, module, receiver_merge_block + 1, target_block)
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  } else {
    let lower_ctx = pipeline_handler_lower_ctx_from_module(params, locals, module)
    let receiver = pipeline_lower_expr_typed_sidecar_handler_ctx(recv_expr, next_value, lower_ctx)
    if ir_lowered_expr_is_valid(receiver) == 1 {
      pipeline_lower_method_call_typed_after_straight_receiver(ir_lowered_expr_value(receiver), ir_lowered_expr_insts(receiver), args_exprs, method_hash, method_ref, params, locals, module, start_block, next_block, target_block)
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  }
}

fn pipeline_expr_is_par_effect_name(src: i64, expr: Expr) -> i64 {
  match expr {
    Ident(eff_ns, eff_nl) -> src_eq(src, eff_ns, eff_nl, "Par")
    LetTyped(inner, ann_type) -> pipeline_expr_is_par_effect_name(src, inner)
    _ -> 0
  }
}

fn pipeline_par_arg_is_unique_typed(arg_expr: Expr, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> i64 {
  let src = pipeline_lower_module_src(module)
  match arg_expr {
    Ident(ns, nl) -> {
      let local_ty = pipeline_value_env_lookup_type_node(locals, src, ns, nl)
      let ty = if local_ty != 0 { local_ty } else { pipeline_param_type_node_by_name(params, src, ns, nl, pipeline_lower_module_subst(module)) }
      if ty == 0 { 0 } else { ty_is_unique(ty) }
    }
    LetTyped(inner, ann_type) -> pipeline_par_arg_is_unique_typed(inner, params, locals, module)
    _ -> {
      let ty = pipeline_return_expr_type_node_typed(arg_expr, params, locals, module)
      if ty == 0 { 0 } else { ty_is_unique(ty) }
    }
  }
}

fn pipeline_lower_par_spawn_inst_typed(args_exprs: ExprList, values: IrValueList, dst: i64, expected_params: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> IrLoweredExpr {
  if ir_value_list_len(values) != 2 {
    ir_lowered_expr_invalid(dst)
  } else {
    let f_value = pipeline_ir_value_list_get_or(values, 0, 0 - 1)
    let arg_value = pipeline_ir_value_list_get_or(values, 1, 0 - 1)
    if f_value < 0 or arg_value < 0 {
      ir_lowered_expr_invalid(dst)
    } else {
      match pipeline_lower_module_par_ctx(module) {
        PipelineParLowerNone -> ir_lowered_expr_invalid(dst)
        PipelineParLowerSequential -> {
          let call_args = ir_value_list_prepend(f_value, ir_value_list_prepend(arg_value, ir_value_list_empty()))
          let call = ir_inst_list_prepend(ir_inst_call_i64(dst, pipeline_par_sequential_submit_hash(), call_args), ir_inst_list_empty())
          let cleanup = pipeline_managed_owned_temp_release_args_typed(args_exprs, values, 0, dst + 1, expected_params, 0, 0, 0)
          ir_lowered_expr(dst, pipeline_lowered_args_next_value(cleanup), ir_inst_list_append(call, pipeline_lowered_args_insts(cleanup)))
        }
        PipelineParLowerPthread(pool_slot) -> {
          let closure_promote = ir_inst_list_prepend(
            ir_inst_call_i64(dst, pipeline_closure_default_promote_hash(), ir_value_list_prepend(f_value, ir_value_list_empty())),
            ir_inst_list_empty()
          )
          let arg_expr = pipeline_expr_list_nth_or(args_exprs, 1, NilExpr)
          let arg_is_unique = pipeline_par_arg_is_unique_typed(arg_expr, params, locals, module)
          let arg_promote_dst = dst + 1
          let arg_promote = if arg_is_unique == 1 {
            ir_inst_list_empty()
          } else {
            ir_inst_list_prepend(
              ir_inst_call_i64(arg_promote_dst, pipeline_rc_default_promote_maybe_hash(), ir_value_list_prepend(arg_value, ir_value_list_empty())),
              ir_inst_list_empty()
            )
          }
          let pool_load = if arg_is_unique == 1 { dst + 1 } else { dst + 2 }
          let pool_load_inst = ir_inst_list_prepend(ir_inst_load_i64(pool_load, pool_slot), ir_inst_list_empty())
          let call_dst = pool_load + 1
          let submit_args = ir_value_list_prepend(pool_load, ir_value_list_prepend(f_value, ir_value_list_prepend(arg_value, ir_value_list_empty())))
          let submit = ir_inst_list_prepend(ir_inst_call_i64(call_dst, pipeline_par_pthread_pool_submit_prepared_hash(), submit_args), ir_inst_list_empty())
          let cleanup = pipeline_managed_owned_temp_release_args_typed(args_exprs, values, 0, call_dst + 1, expected_params, 0, 0, 0)
          let insts = ir_inst_list_append(closure_promote, ir_inst_list_append(arg_promote, ir_inst_list_append(pool_load_inst, ir_inst_list_append(submit, pipeline_lowered_args_insts(cleanup)))))
          ir_lowered_expr(call_dst, pipeline_lowered_args_next_value(cleanup), insts)
        }
      }
    }
  }
}

fn pipeline_lower_par_await_inst_typed(values: IrValueList, dst: i64, module: PipelineLowerModule) -> IrLoweredExpr {
  if ir_value_list_len(values) != 1 {
    ir_lowered_expr_invalid(dst)
  } else {
    let handle_value = pipeline_ir_value_list_get_or(values, 0, 0 - 1)
    if handle_value < 0 {
      ir_lowered_expr_invalid(dst)
    } else {
      match pipeline_lower_module_par_ctx(module) {
        PipelineParLowerNone -> ir_lowered_expr_invalid(dst)
        PipelineParLowerSequential -> {
          let call = ir_inst_list_prepend(ir_inst_call_i64(dst, pipeline_par_task_await_hash(), ir_value_list_prepend(handle_value, ir_value_list_empty())), ir_inst_list_empty())
          ir_lowered_expr(dst, dst + 1, call)
        }
        PipelineParLowerPthread(pool_value) -> {
          let call = ir_inst_list_prepend(ir_inst_call_i64(dst, pipeline_par_pthread_pool_await_hash(), ir_value_list_prepend(handle_value, ir_value_list_empty())), ir_inst_list_empty())
          ir_lowered_expr(dst, dst + 1, call)
        }
      }
    }
  }
}

fn pipeline_lower_par_perform_inst_typed(lhs_expr: Expr, op_ns: i64, op_nl: i64, args_exprs: ExprList, values: IrValueList, dst: i64, expected_params: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> IrLoweredExpr {
  let src = pipeline_lower_module_src(module)
  if pipeline_expr_is_par_effect_name(src, lhs_expr) == 0 {
    ir_lowered_expr_invalid(dst)
  } else {
    if src_eq(src, op_ns, op_nl, "spawn") == 1 {
      pipeline_lower_par_spawn_inst_typed(args_exprs, values, dst, expected_params, params, locals, module)
    } else {
      if src_eq(src, op_ns, op_nl, "await") == 1 {
        pipeline_lower_par_await_inst_typed(values, dst, module)
      } else {
        ir_lowered_expr_invalid(dst)
      }
    }
  }
}

-- A dot-call falling through to the dynamic-perform path is only sound
-- when the base ident names a DECLARED effect: performing an effect
-- hashed from an untyped value's variable name compiles to a runtime
-- trap. tt == 0 stays permissive for ttable-less legacy paths.
fn pipeline_ident_is_declared_effect(tt: i64, src: i64, ns: i64, nl: i64) -> i64 {
  if tt == 0 { 1 }
  else {
    let entry = ttable_lookup(tt, src, ns, nl)
    if entry == 0 { 0 }
    else { if mem_load64_at(entry + 16, 0) == 2 { 1 } else { 0 } }
  }
}

fn pipeline_lower_perform_typed_to_target_blocks(lhs_expr: Expr, op_ns: i64, op_nl: i64, args_exprs: ExprList, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let dispatch_key = pipeline_effect_ref_dispatch_key_typed(pipeline_lower_module_src(module), lhs_expr, pipeline_lower_module_subst(module))
  pipeline_lower_perform_typed_to_target_blocks_keyed(lhs_expr, lhs_expr, op_ns, op_nl, args_exprs, params, locals, module, next_value, start_block, next_block, target_block, dispatch_key)
}

fn pipeline_lower_perform_typed_to_target_blocks_keyed(lhs_expr: Expr, signature_ref: Expr, op_ns: i64, op_nl: i64, args_exprs: ExprList, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64, dispatch_key: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  match lhs_expr {
    Ident(eff_ns, eff_nl) -> {
      let subst = pipeline_lower_module_subst(module)
      let local_recv_ty = pipeline_value_env_lookup_type_node(locals, src, eff_ns, eff_nl)
      let recv_ty = if local_recv_ty != 0 {
        ty_subst(local_recv_ty, subst)
      } else {
        pipeline_param_type_node_by_name(params, src, eff_ns, eff_nl, subst)
      }
      let method_hash = effect_name_hash(src, op_ns, op_nl)
      let method_ref = pipeline_resolve_method_ref(tt, recv_ty, method_hash)
      if method_ref != 0 {
        pipeline_lower_method_call_typed_to_target_blocks(lhs_expr, method_hash, args_exprs, method_ref, params, locals, module, next_value, start_block, next_block, target_block)
      } else { if pipeline_ident_is_declared_effect(tt, src, eff_ns, eff_nl) == 0 {
        pipeline_lowered_blocks_invalid(start_block, next_value)
      } else {
        let call_block = next_block
        let arg_count = expr_list_len(args_exprs)
        let first_arg_block = pipeline_lower_operation_child_start_block(call_block, arg_count)
        let expected_params = pipeline_effect_op_params_nodes_typed(tt, src, signature_ref, op_ns, op_nl, subst)
        let return_ty = pipeline_effect_op_return_type_typed(tt, src, signature_ref, op_ns, op_nl, subst)
        let result_lanes = pipeline_type_value_lane_count_or_one(return_ty)
        let lowered_args = pipeline_lower_call_arg_blocks_typed(args_exprs, arg_count, params, locals, module, call_block, expected_params, 0, 0, 0, 0, next_value, first_arg_block, ir_value_list_empty())
        if pipeline_lowered_call_blocks_is_valid(lowered_args) == 1 {
          let entry = ir_block_new_term(start_block, ir_inst_list_empty(), ir_term_jump(first_arg_block))
          if pipeline_lowered_call_blocks_falls_through(lowered_args) == 0 {
            let blocks = ir_block_list_prepend(entry, pipeline_lowered_call_blocks_blocks(lowered_args))
            pipeline_lowered_blocks_control(pipeline_lowered_call_blocks_next_block(lowered_args), pipeline_lowered_call_blocks_next_value(lowered_args), blocks, 1, 0)
        } else {
          let dst = pipeline_lowered_call_blocks_next_value(lowered_args)
          let logical_args = pipeline_lowered_call_blocks_values(lowered_args)
          let abi_args = pipeline_call_abi_args(logical_args, expected_params, 0, 0, 0, 0)
          let eff_hash = if dispatch_key != 0 { dispatch_key } else { effect_name_hash(src, eff_ns, eff_nl) }
          let op_hash = effect_name_hash(src, op_ns, op_nl)
          let par_lowered = pipeline_lower_par_perform_inst_typed(lhs_expr, op_ns, op_nl, args_exprs, logical_args, dst, expected_params, params, locals, module)
          if ir_lowered_expr_is_valid(par_lowered) == 1 {
            let par_args = pipeline_ir_value_lane_ids(ir_lowered_expr_value(par_lowered), 0, result_lanes)
            let perform_block_node = ir_block_new_term(call_block, ir_lowered_expr_insts(par_lowered), ir_term_jump_args(target_block, par_args))
            let blocks = ir_block_list_prepend(entry, ir_block_list_append(pipeline_lowered_call_blocks_blocks(lowered_args), ir_block_list_prepend(perform_block_node, ir_block_list_empty())))
            pipeline_lowered_blocks(pipeline_lowered_call_blocks_next_block(lowered_args), ir_lowered_expr_next_value(par_lowered), blocks, 1)
          } else {
            let found = pipeline_handler_inline_ctx_find_match(pipeline_lower_module_handlers(module), src, eff_hash, op_hash)
            let tail_inline = pipeline_handler_inline_try_tail_resume(pipeline_lower_module_handlers(module), found, logical_args, pipeline_lower_module_tt(module), pipeline_lower_module_fns(module), dst)
            if ir_lowered_expr_is_valid(tail_inline) == 1 {
              let inline_args = pipeline_ir_value_lane_ids(ir_lowered_expr_value(tail_inline), 0, result_lanes)
              let inline_block_node = ir_block_new_term(call_block, ir_lowered_expr_insts(tail_inline), ir_term_jump_args(target_block, inline_args))
              let blocks = ir_block_list_prepend(entry, ir_block_list_append(pipeline_lowered_call_blocks_blocks(lowered_args), ir_block_list_prepend(inline_block_node, ir_block_list_empty())))
              pipeline_lowered_blocks(pipeline_lowered_call_blocks_next_block(lowered_args), ir_lowered_expr_next_value(tail_inline), blocks, 1)
            } else {
            let op_inst = if pipeline_handler_inline_match_found(found) == 1 {
              ir_inst_handler_direct_i64(
                dst,
                eff_hash,
                  op_hash,
                  pipeline_handler_inline_match_depth_or(found, 0 - 1),
                  pipeline_handler_inline_match_clause_index_or(found, 0 - 1),
                  abi_args
              )
            } else {
              ir_inst_perform_i64(dst, eff_hash, op_hash, abi_args)
            }
            let result_insts = pipeline_ir_call_result_lane_insts(dst, return_ty)
            -- The selected handler clause owns and releases the transported
            -- argument stakes after normalising its result transfer.
            let perform_insts = ir_inst_list_prepend(op_inst, result_insts)
            let perform_args = pipeline_ir_value_lane_ids(dst, 0, result_lanes)
            let perform_block_node = ir_block_new_term(call_block, perform_insts, ir_term_jump_args(target_block, perform_args))
            let blocks = ir_block_list_prepend(entry, ir_block_list_append(pipeline_lowered_call_blocks_blocks(lowered_args), ir_block_list_prepend(perform_block_node, ir_block_list_empty())))
            pipeline_lowered_blocks(pipeline_lowered_call_blocks_next_block(lowered_args), dst + result_lanes, blocks, 1)
            }
          }
        }
      } else {
        pipeline_lowered_blocks_invalid(start_block, next_value)
      }
      } }
    }
    GenericCall(type_args, inner) -> {
      match inner {
        Ident(eff_ns, eff_nl) -> pipeline_lower_perform_typed_to_target_blocks_keyed(Ident(eff_ns, eff_nl), signature_ref, op_ns, op_nl, args_exprs, params, locals, module, next_value, start_block, next_block, target_block, dispatch_key)
        _ -> pipeline_lowered_blocks_invalid(start_block, next_value)
      }
    }
    _ -> pipeline_lowered_blocks_invalid(start_block, next_value)
  }
}

fn pipeline_lower_straight_expr_typed_to_target_blocks(expr: Expr, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let lower_ctx = pipeline_handler_lower_ctx_from_module(params, locals, module)
  let lowered = pipeline_lower_expr_typed_sidecar_handler_ctx(expr, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(lowered) == 1 {
    let args = pipeline_ir_value_lane_ids(ir_lowered_expr_value(lowered), 0, pipeline_expr_value_lane_count(expr, params, locals, module))
    let block = ir_block_new_term(start_block, ir_lowered_expr_insts(lowered), ir_term_jump_args(target_block, args))
    let blocks = ir_block_list_prepend(block, ir_block_list_empty())
    pipeline_lowered_blocks(next_block, ir_lowered_expr_next_value(lowered), blocks, 1)
  } else {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  }
}

fn pipeline_lower_straight_expr_typed_to_target_blocks_with_float(expr: Expr, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64, local_float: i64) -> PipelineLoweredBlocks {
  let lower_ctx = pipeline_handler_lower_ctx_from_module(params, locals, module)
  let lowered = if pipeline_prim_is_forced_numeric_context(local_float) == 1 {
    pipeline_lower_expr_typed_sidecar_handler_opt_with_float_prim(expr, next_value, lower_ctx, local_float)
  } else {
    pipeline_lower_expr_typed_sidecar_handler_ctx(expr, next_value, lower_ctx)
  }
  if ir_lowered_expr_is_valid(lowered) == 1 {
    let args = pipeline_ir_value_lane_ids(ir_lowered_expr_value(lowered), 0, pipeline_expr_value_lane_count(expr, params, locals, module))
    let block = ir_block_new_term(start_block, ir_lowered_expr_insts(lowered), ir_term_jump_args(target_block, args))
    let blocks = ir_block_list_prepend(block, ir_block_list_empty())
    pipeline_lowered_blocks(next_block, ir_lowered_expr_next_value(lowered), blocks, 1)
  } else {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  }
}

fn pipeline_lower_expr_typed_to_target_blocks_reserved_with_float(expr: Expr, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64, local_float: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  if pipeline_prim_is_forced_numeric_context(local_float) == 1 and pipeline_expr_needs_lowering_cfg_typed(expr, src) == 0 {
    pipeline_lower_straight_expr_typed_to_target_blocks_with_float(expr, params, locals, module, next_value, start_block, next_block, target_block, local_float)
  } else { if pipeline_prim_is_forced_numeric_context(local_float) == 1 {
    match expr {
      If(cond, then_expr, else_expr) -> pipeline_lower_if_typed_to_target_blocks_with_float(cond, then_expr, else_expr, local_float, params, locals, module, next_value, start_block, next_block, target_block)
      Match(scrutinee, arms) -> pipeline_lower_match_typed_core_to_target_blocks_with_float(scrutinee, arms, local_float, params, locals, module, next_value, start_block, next_block, target_block)
      _ -> pipeline_lower_expr_typed_to_target_blocks_reserved(expr, params, locals, module, next_value, start_block, next_block, target_block)
    }
  } else {
    pipeline_lower_expr_typed_to_target_blocks_reserved(expr, params, locals, module, next_value, start_block, next_block, target_block)
  } }
}

fn pipeline_lower_straight_expr_typed_to_control_target_blocks(expr: Expr, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let lower_ctx = pipeline_handler_lower_ctx_from_module(params, locals, module)
  let lowered = pipeline_lower_expr_typed_sidecar_handler_ctx(expr, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(lowered) == 1 {
    let block = ir_block_new_term(start_block, ir_lowered_expr_insts(lowered), ir_term_jump(target_block))
    let blocks = ir_block_list_prepend(block, ir_block_list_empty())
    pipeline_lowered_blocks(next_block, ir_lowered_expr_next_value(lowered), blocks, 1)
  } else {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  }
}

fn pipeline_lower_while_typed_with_cond_value(cond_value: i64, cond_blocks: IrBlockList, body_expr: Expr, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, body_start: i64, exit_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let loop_ctx = pipeline_loop_ctx(params, locals, module, target_block, start_block, start_block, 1)
  let body_blocks = pipeline_lower_loop_body_to_target_blocks(expr_to_node(body_expr), loop_ctx, next_value, body_start, next_block)
  if pipeline_lowered_loop_blocks_is_valid(body_blocks) == 1 {
    let nil_value = pipeline_lowered_loop_blocks_next_value(body_blocks)
    let exit_args = ir_value_list_prepend(nil_value, ir_value_list_empty())
    let exit_insts = ir_inst_list_prepend(ir_inst_const_i64(nil_value, 0), ir_inst_list_empty())
    let exit_node = ir_block_new_term(exit_block, exit_insts, ir_term_jump_args(target_block, exit_args))
    let blocks = ir_block_list_append(cond_blocks, ir_block_list_append(pipeline_lowered_loop_blocks_blocks(body_blocks), ir_block_list_prepend(exit_node, ir_block_list_empty())))
    pipeline_lowered_blocks(pipeline_lowered_loop_blocks_next_block(body_blocks), nil_value + 1, blocks, 1)
  } else {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  }
}

fn pipeline_lower_while_typed_to_target_blocks(cond_expr: Expr, body_expr: Expr, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  if pipeline_expr_needs_lowering_cfg_typed(cond_expr, src) == 1 {
    let cond_merge_block = next_block
    let body_start = next_block + 1
    let exit_block = next_block + 2
    let cond_blocks = pipeline_lower_expr_typed_to_target_blocks_reserved(cond_expr, params, locals, module, next_value, start_block, next_block + 3, cond_merge_block)
    if pipeline_lowered_blocks_is_valid(cond_blocks) == 1 {
      if pipeline_lowered_blocks_falls_through(cond_blocks) == 0 {
        cond_blocks
      } else {
        let cond_value = pipeline_lowered_blocks_next_value(cond_blocks)
        let cond_params = ir_value_list_prepend(cond_value, ir_value_list_empty())
        let cond_merge = ir_block_new_params(cond_merge_block, cond_params, ir_inst_list_empty(), ir_term_branch(cond_value, body_start, exit_block))
        let cond_with_merge = ir_block_list_append(pipeline_lowered_blocks_blocks(cond_blocks), ir_block_list_prepend(cond_merge, ir_block_list_empty()))
        pipeline_lower_while_typed_with_cond_value(cond_value, cond_with_merge, body_expr, params, locals, module, cond_value + 1, start_block, body_start, exit_block, pipeline_lowered_blocks_next_block(cond_blocks), target_block)
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  } else {
    let lower_ctx = pipeline_handler_lower_ctx_from_module(params, locals, module)
    let cond = pipeline_lower_expr_typed_sidecar_handler_ctx(cond_expr, next_value, lower_ctx)
    if ir_lowered_expr_is_valid(cond) == 1 {
      let body_start = next_block
      let exit_block = next_block + 1
      let entry = ir_block_new_term(start_block, ir_lowered_expr_insts(cond), ir_term_branch(ir_lowered_expr_value(cond), body_start, exit_block))
      let cond_blocks = ir_block_list_prepend(entry, ir_block_list_empty())
      pipeline_lower_while_typed_with_cond_value(ir_lowered_expr_value(cond), cond_blocks, body_expr, params, locals, module, ir_lowered_expr_next_value(cond), start_block, body_start, exit_block, next_block + 2, target_block)
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  }
}

fn pipeline_lower_match_typed_to_target_blocks(scrutinee: Expr, arms: MatchArmList, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  pipeline_lower_match_typed_core_to_target_blocks(scrutinee, arms, params, locals, module, next_value, start_block, next_block, target_block)
}

fn pipeline_lower_let_typed_to_target_blocks_with_float(ns: i64, nl: i64, init_expr: Expr, body_expr: Expr, local_float: i64, local_type_node: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let inferred_type_node = pipeline_init_type_node_typed(init_expr, params, locals, module)
  let effective_type_node = if local_type_node != 0 { ty_subst(local_type_node, pipeline_lower_module_subst(module)) } else { inferred_type_node }
  let local_lanes = pipeline_type_value_lane_count_or_one(effective_type_node)
  if pipeline_expr_needs_lowering_cfg_typed(init_expr, src) == 1 {
    let local_merge_block = next_block
    let local_value = next_value
    let address_taken = pipeline_expr_typed_address_of_binding(body_expr, src, ns, nl)
    let address_slot = pipeline_ir_addressable_slot_id(local_value + local_lanes)
    let init_blocks = pipeline_lower_expr_typed_to_target_blocks_reserved(init_expr, params, locals, module, local_value + local_lanes, start_block, next_block + 1, local_merge_block)
    if pipeline_lowered_blocks_is_valid(init_blocks) == 1 {
      if pipeline_lowered_blocks_falls_through(init_blocks) == 0 {
        init_blocks
      } else {
        let body_start = pipeline_lowered_blocks_next_block(init_blocks)
        let inferred_float_prim = pipeline_expr_float_prim_typed_temp(init_expr, params, locals, src, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module))
        let float_prim = if local_float == PRIM_F32() or local_float == PRIM_F64() { local_float } else { inferred_float_prim }
        let inferred_type_hash = pipeline_expr_type_hash_typed_temp(init_expr, params, locals, src, tt, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module))
        let annotated_type_hash = if local_type_node != 0 and effective_type_node != 0 { type_hash_of(effective_type_node) } else { 0 }
        let inferred_node_type_hash = if effective_type_node != 0 { type_hash_of(effective_type_node) } else { 0 }
        let local_type_hash = if annotated_type_hash != 0 { annotated_type_hash } else { if inferred_node_type_hash != 0 { inferred_node_type_hash } else { if local_float != 0 and pipeline_prim_is_numeric_context(local_float) == 1 { pipeline_type_hash_of_prim_id(local_float) } else { pipeline_expr_type_hash_sharpen_int_typed(init_expr, inferred_type_hash, params, locals, src, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module)) } } }
        let bind_value = if address_taken == 1 { address_slot } else { local_value }
        let retain_start = if address_taken == 1 {
          pipeline_ir_max_i64(pipeline_lowered_blocks_next_value(init_blocks), address_slot + local_lanes)
        } else {
          pipeline_ir_max_i64(pipeline_lowered_blocks_next_value(init_blocks), local_value + local_lanes)
        }
        let retain_insts = if address_taken == 1 or pipeline_expr_result_is_borrowed_for_ty_typed(init_expr, effective_type_node, src, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module), pipeline_lower_module_tt(module)) == 0 {
          ir_inst_list_empty()
        } else {
          pipeline_managed_retain_inst_list(bind_value, effective_type_node, retain_start)
        }
        let body_next_value = retain_start + ir_inst_list_len(retain_insts)
        let next_locals = if address_taken == 1 {
          pipeline_value_env_push_slot_float_typed_node(locals, ns, nl, address_slot, float_prim, local_type_hash, effective_type_node)
        } else {
          pipeline_value_env_push_float_typed_node(locals, ns, nl, local_value, float_prim, local_type_hash, effective_type_node)
        }
        let owned_type_hash = if local_type_node != 0 and effective_type_node != 0 { cg_owned_drop_type_hash(effective_type_node) } else { 0 }
        let owned_drop_wrap = if owned_type_hash != 0 and address_taken == 0 and pipeline_expr_refs_name_typed(body_expr, src, ns, nl) == 0 { 1 } else { 0 }
        -- Managed bindings release on the fall-through scope exit through
        -- the same interposed block as owned drops (2q slice 2): the
        -- sidecar-body path releases inline, but a CFG body jumps to the
        -- target directly and previously leaked the binding.
        let managed_drop_wrap = if owned_drop_wrap == 0 and address_taken == 0 and effective_type_node != 0 and pipeline_expr_final_returns_binding_typed(body_expr, src, ns, nl) == 0 { ty_value_has_release_lane(effective_type_node) } else { 0 }
        let scope_wrap = if owned_drop_wrap == 1 or managed_drop_wrap == 1 { 1 } else { 0 }
        let drop_block = body_start
        let wrapped_body_start = if scope_wrap == 1 { body_start + 1 } else { body_start }
        let body_target = if scope_wrap == 1 { drop_block } else { target_block }
        let body_blocks = pipeline_lower_expr_typed_to_target_blocks(body_expr, params, next_locals, module, body_next_value, wrapped_body_start, body_target)
        if pipeline_lowered_blocks_is_valid(body_blocks) == 1 {
          let local_params = pipeline_ir_value_lane_ids(local_value, 0, local_lanes)
          let slot_insts = if address_taken == 1 {
            pipeline_ir_slot_lane_init_insts(address_slot, local_value, 0, local_lanes)
          } else { ir_inst_list_empty() }
          let bind_insts = ir_inst_list_prepend(ir_inst_bind_typed_i64(ns, nl, bind_value, effective_type_node), ir_inst_list_empty())
          let local_merge = ir_block_new_params(local_merge_block, local_params, ir_inst_list_append(slot_insts, ir_inst_list_append(retain_insts, bind_insts)), ir_term_jump(wrapped_body_start))
          if scope_wrap == 1 and pipeline_lowered_blocks_falls_through(body_blocks) == 1 {
            let carried = pipeline_lowered_blocks_next_value(body_blocks)
            let carried_lanes = pipeline_expr_value_lane_count(body_expr, params, next_locals, module)
            let carried_args = pipeline_ir_value_lane_ids(carried, 0, carried_lanes)
            let cleanup_value = carried + carried_lanes
            let drop_insts = if owned_drop_wrap == 1 {
              ir_inst_list_prepend(ir_inst_owned_drop_i64(bind_value, owned_type_hash), ir_inst_list_empty())
            } else {
              pipeline_managed_release_inst_list(bind_value, effective_type_node, cleanup_value)
            }
            let after_drop = cleanup_value + ir_inst_list_len(drop_insts)
            let drop_node = ir_block_new_params(drop_block, carried_args, drop_insts, ir_term_jump_args(target_block, carried_args))
            let blocks = ir_block_list_append(
              pipeline_lowered_blocks_blocks(init_blocks),
              ir_block_list_prepend(local_merge, ir_block_list_append(pipeline_lowered_blocks_blocks(body_blocks), ir_block_list_prepend(drop_node, ir_block_list_empty())))
            )
            pipeline_lowered_blocks_control(
              pipeline_lowered_blocks_next_block(body_blocks),
              after_drop,
              blocks,
              1,
              1
            )
          } else {
            let blocks = ir_block_list_append(
              pipeline_lowered_blocks_blocks(init_blocks),
              ir_block_list_prepend(local_merge, pipeline_lowered_blocks_blocks(body_blocks))
            )
            pipeline_lowered_blocks_control(
              pipeline_lowered_blocks_next_block(body_blocks),
              pipeline_lowered_blocks_next_value(body_blocks),
              blocks,
              1,
              pipeline_lowered_blocks_falls_through(body_blocks)
            )
          }
        } else {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        }
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  } else {
    let lower_ctx = pipeline_handler_lower_ctx_from_module(params, locals, module)
    let init = if pipeline_prim_is_forced_numeric_context(local_float) == 1 {
      pipeline_lower_expr_typed_sidecar_handler_opt_with_float_prim(init_expr, next_value, lower_ctx, local_float)
    } else {
      pipeline_lower_expr_typed_sidecar_handler_ctx(init_expr, next_value, lower_ctx)
    }
    if ir_lowered_expr_is_valid(init) == 1 {
      let inferred_float_prim = pipeline_expr_float_prim_typed_temp(init_expr, params, locals, src, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module))
      let float_prim = if local_float == PRIM_F32() or local_float == PRIM_F64() { local_float } else { inferred_float_prim }
      let inferred_type_hash = pipeline_expr_type_hash_typed_temp(init_expr, params, locals, src, tt, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module))
      let annotated_type_hash = if local_type_node != 0 and effective_type_node != 0 { type_hash_of(effective_type_node) } else { 0 }
      let inferred_node_type_hash = if effective_type_node != 0 { type_hash_of(effective_type_node) } else { 0 }
      let local_type_hash = if annotated_type_hash != 0 { annotated_type_hash } else { if inferred_node_type_hash != 0 { inferred_node_type_hash } else { if local_float != 0 and pipeline_prim_is_numeric_context(local_float) == 1 { pipeline_type_hash_of_prim_id(local_float) } else { pipeline_expr_type_hash_sharpen_int_typed(init_expr, inferred_type_hash, params, locals, src, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module)) } } }
      let address_taken = pipeline_expr_typed_address_of_binding(body_expr, src, ns, nl)
      let slot = pipeline_ir_addressable_slot_id(ir_lowered_expr_next_value(init))
      let next_locals = if address_taken == 1 {
        pipeline_value_env_push_slot_float_typed_node(locals, ns, nl, slot, float_prim, local_type_hash, effective_type_node)
      } else {
        pipeline_value_env_push_float_typed_node(locals, ns, nl, ir_lowered_expr_value(init), float_prim, local_type_hash, effective_type_node)
      }
      let slot_insts = if address_taken == 1 {
        pipeline_ir_slot_lane_init_insts(slot, ir_lowered_expr_value(init), 0, local_lanes)
      } else { ir_inst_list_empty() }
      let bind_value = if address_taken == 1 { slot } else { ir_lowered_expr_value(init) }
      let retain_start = if address_taken == 1 { slot + local_lanes } else { ir_lowered_expr_next_value(init) }
      let retain_insts = if address_taken == 1 or pipeline_expr_result_is_borrowed_for_ty_typed(init_expr, effective_type_node, src, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module), pipeline_lower_module_tt(module)) == 0 {
        ir_inst_list_empty()
      } else {
        pipeline_managed_retain_inst_list(bind_value, effective_type_node, retain_start)
      }
      let body_next = retain_start + ir_inst_list_len(retain_insts)
      if pipeline_expr_needs_lowering_cfg_typed(body_expr, src) == 1 {
        -- Owned bindings drop on the fall-through scope exit. The drop block
        -- is interposed between the body and the real target; return paths
        -- bypass it, matching defer-owned lowering. Managed bindings
        -- release through the same interposed block (2q slice 2) — a CFG
        -- body jumps to the target directly and previously leaked.
        let owned_type_hash = if local_type_node != 0 and effective_type_node != 0 { cg_owned_drop_type_hash(effective_type_node) } else { 0 }
        let owned_drop_wrap = if owned_type_hash != 0 and address_taken == 0 and pipeline_expr_refs_name_typed(body_expr, src, ns, nl) == 0 { 1 } else { 0 }
        let managed_drop_wrap = if owned_drop_wrap == 0 and address_taken == 0 and effective_type_node != 0 and pipeline_expr_final_returns_binding_typed(body_expr, src, ns, nl) == 0 { ty_value_has_release_lane(effective_type_node) } else { 0 }
        let scope_wrap = if owned_drop_wrap == 1 or managed_drop_wrap == 1 { 1 } else { 0 }
        let drop_block = next_block
        let body_start = if scope_wrap == 1 { next_block + 1 } else { next_block }
        let body_target = if scope_wrap == 1 { drop_block } else { target_block }
        let body_blocks = pipeline_lower_expr_typed_to_target_blocks(body_expr, params, next_locals, module, body_next, body_start, body_target)
        if pipeline_lowered_blocks_is_valid(body_blocks) == 1 {
          let bind_insts = ir_inst_list_prepend(ir_inst_bind_typed_i64(ns, nl, bind_value, effective_type_node), ir_inst_list_empty())
          let entry = ir_block_new_term(start_block, ir_inst_list_append(ir_lowered_expr_insts(init), ir_inst_list_append(slot_insts, ir_inst_list_append(retain_insts, bind_insts))), ir_term_jump(body_start))
          if scope_wrap == 1 and pipeline_lowered_blocks_falls_through(body_blocks) == 1 {
            let carried = pipeline_lowered_blocks_next_value(body_blocks)
            let carried_lanes = pipeline_expr_value_lane_count(body_expr, params, next_locals, module)
            let carried_args = pipeline_ir_value_lane_ids(carried, 0, carried_lanes)
            let cleanup_value = carried + carried_lanes
            let drop_insts = if owned_drop_wrap == 1 {
              ir_inst_list_prepend(ir_inst_owned_drop_i64(bind_value, owned_type_hash), ir_inst_list_empty())
            } else {
              pipeline_managed_release_inst_list(bind_value, effective_type_node, cleanup_value)
            }
            let after_drop = cleanup_value + ir_inst_list_len(drop_insts)
            let drop_node = ir_block_new_params(drop_block, carried_args, drop_insts, ir_term_jump_args(target_block, carried_args))
            let blocks = ir_block_list_prepend(entry, ir_block_list_append(pipeline_lowered_blocks_blocks(body_blocks), ir_block_list_prepend(drop_node, ir_block_list_empty())))
            pipeline_lowered_blocks_control(
              pipeline_lowered_blocks_next_block(body_blocks),
              after_drop,
              blocks,
              1,
              1
            )
          } else {
            let blocks = ir_block_list_prepend(entry, pipeline_lowered_blocks_blocks(body_blocks))
            pipeline_lowered_blocks_control(
              pipeline_lowered_blocks_next_block(body_blocks),
              pipeline_lowered_blocks_next_value(body_blocks),
              blocks,
              1,
              pipeline_lowered_blocks_falls_through(body_blocks)
            )
          }
        } else {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        }
      } else {
        let body_ctx = pipeline_handler_lower_ctx_from_module(params, next_locals, module)
        let body = pipeline_lower_expr_typed_sidecar_handler_ctx(body_expr, body_next, body_ctx)
        if ir_lowered_expr_is_valid(body) == 1 {
          let args = pipeline_ir_value_lane_ids(ir_lowered_expr_value(body), 0, pipeline_expr_value_lane_count(body_expr, params, next_locals, module))
          let bind_insts = ir_inst_list_prepend(ir_inst_bind_typed_i64(ns, nl, bind_value, effective_type_node), ir_inst_list_empty())
          let release_dst = ir_lowered_expr_next_value(body)
          let body_returns_binding = pipeline_expr_final_returns_binding_typed(body_expr, src, ns, nl)
          let release_insts = if body_returns_binding == 1 { ir_inst_list_empty() } else { pipeline_managed_release_inst_list(bind_value, effective_type_node, release_dst) }
          let owned_type_hash = if local_type_node != 0 and effective_type_node != 0 { cg_owned_drop_type_hash(effective_type_node) } else { 0 }
          let owned_drop_insts = if owned_type_hash != 0 and address_taken == 0 and pipeline_expr_refs_name_typed(body_expr, src, ns, nl) == 0 {
            ir_inst_list_prepend(ir_inst_owned_drop_i64(bind_value, owned_type_hash), ir_inst_list_empty())
          } else { ir_inst_list_empty() }
          let next_after_release = release_dst + ir_inst_list_len(release_insts)
          let insts = ir_inst_list_append(ir_lowered_expr_insts(init), ir_inst_list_append(slot_insts, ir_inst_list_append(retain_insts, ir_inst_list_append(bind_insts, ir_inst_list_append(ir_lowered_expr_insts(body), ir_inst_list_append(owned_drop_insts, release_insts))))))
          let block = ir_block_new_term(start_block, insts, ir_term_jump_args(target_block, args))
          let blocks = ir_block_list_prepend(block, ir_block_list_empty())
          pipeline_lowered_blocks(next_block, next_after_release, blocks, 1)
        } else {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        }
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  }
}

-- Mut-binding scope release (2q slice 2 stage B): the slot's final
-- value drops one count at scope exit. Skipped when the address is
-- taken (raw aliasing) or any final path returns the binding (the
-- transfer machinery owns that hand-off).
fn pipeline_let_mut_scope_needs_release(body_expr: Expr, src: i64, ns: i64, nl: i64, address_taken: i64, effective_type_node: i64) -> i64 {
  if address_taken == 1 or effective_type_node == 0 { 0 }
  else {
    if pipeline_expr_final_returns_binding_typed(body_expr, src, ns, nl) == 1 { 0 }
    else { ty_value_has_release_lane(effective_type_node) }
  }
}

fn pipeline_lower_let_mut_typed_to_target_blocks_with_float(ns: i64, nl: i64, init_expr: Expr, body_expr: Expr, local_float: i64, local_type_node: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let early_inferred_type_node = pipeline_init_type_node_typed(init_expr, params, locals, module)
  let early_effective_type_node = if local_type_node != 0 { ty_subst(local_type_node, pipeline_lower_module_subst(module)) } else { early_inferred_type_node }
  let local_lanes = pipeline_type_value_lane_count_or_one(early_effective_type_node)
  if pipeline_expr_needs_lowering_cfg_typed(init_expr, src) == 1 {
    let local_merge_block = next_block
    let local_value = next_value
    let address_taken = pipeline_expr_typed_address_of_binding(body_expr, src, ns, nl)
    let slot = if address_taken == 1 { pipeline_ir_addressable_slot_id(local_value + local_lanes) } else { local_value + local_lanes }
    let init_blocks = pipeline_lower_expr_typed_to_target_blocks_reserved(init_expr, params, locals, module, slot + local_lanes, start_block, next_block + 1, local_merge_block)
    if pipeline_lowered_blocks_is_valid(init_blocks) == 1 {
      if pipeline_lowered_blocks_falls_through(init_blocks) == 0 {
        init_blocks
      } else {
        let retain_start = pipeline_ir_max_i64(pipeline_lowered_blocks_next_value(init_blocks), slot + local_lanes)
        let body_start = pipeline_lowered_blocks_next_block(init_blocks)
        let slot_insts = pipeline_ir_slot_lane_init_insts(slot, local_value, 0, local_lanes)
        let inferred_float_prim = pipeline_expr_float_prim_typed_temp(init_expr, params, locals, src, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module))
        let float_prim = if local_float == PRIM_F32() or local_float == PRIM_F64() { local_float } else { inferred_float_prim }
        let inferred_type_hash = pipeline_expr_type_hash_typed_temp(init_expr, params, locals, src, tt, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module))
        let inferred_type_node = pipeline_init_type_node_typed(init_expr, params, locals, module)
        let effective_type_node = if local_type_node != 0 { ty_subst(local_type_node, pipeline_lower_module_subst(module)) } else { inferred_type_node }
        let annotated_type_hash = if local_type_node != 0 and effective_type_node != 0 { type_hash_of(effective_type_node) } else { 0 }
        let inferred_node_type_hash = if effective_type_node != 0 { type_hash_of(effective_type_node) } else { 0 }
        let local_type_hash = if annotated_type_hash != 0 { annotated_type_hash } else { if inferred_node_type_hash != 0 { inferred_node_type_hash } else { if local_float != 0 and pipeline_prim_is_numeric_context(local_float) == 1 { pipeline_type_hash_of_prim_id(local_float) } else { pipeline_expr_type_hash_sharpen_int_typed(init_expr, inferred_type_hash, params, locals, src, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module)) } } }
        let retain_insts = if effective_type_node != 0 and pipeline_expr_result_is_borrowed_for_ty_typed(init_expr, effective_type_node, src, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module), pipeline_lower_module_tt(module)) == 1 {
          pipeline_managed_retain_inst_list(local_value, effective_type_node, retain_start)
        } else {
          ir_inst_list_empty()
        }
        let body_next_value = retain_start + ir_inst_list_len(retain_insts)
        let next_locals = pipeline_value_env_push_slot_float_typed_node(locals, ns, nl, slot, float_prim, local_type_hash, effective_type_node)
        let scope_needs_release = pipeline_let_mut_scope_needs_release(body_expr, src, ns, nl, address_taken, effective_type_node)
        let drop_block = body_start
        let wrapped_body_start = if scope_needs_release == 1 { body_start + 1 } else { body_start }
        let body_target = if scope_needs_release == 1 { drop_block } else { target_block }
        let body_blocks = pipeline_lower_expr_typed_to_target_blocks(body_expr, params, next_locals, module, body_next_value, wrapped_body_start, body_target)
        if pipeline_lowered_blocks_is_valid(body_blocks) == 1 {
          let local_params = pipeline_ir_value_lane_ids(local_value, 0, local_lanes)
          let bind_insts = ir_inst_list_prepend(ir_inst_bind_typed_i64(ns, nl, slot, effective_type_node), ir_inst_list_empty())
          let local_merge = ir_block_new_params(local_merge_block, local_params, ir_inst_list_append(slot_insts, ir_inst_list_append(retain_insts, bind_insts)), ir_term_jump(wrapped_body_start))
          if scope_needs_release == 1 and pipeline_lowered_blocks_falls_through(body_blocks) == 1 {
            let carried = pipeline_lowered_blocks_next_value(body_blocks)
            let carried_lanes = pipeline_expr_value_lane_count(body_expr, params, next_locals, module)
            let carried_args = pipeline_ir_value_lane_ids(carried, 0, carried_lanes)
            let cleanup_value = carried + carried_lanes
            let drop_insts = pipeline_managed_slot_cleanup_inst_list(slot, effective_type_node, cleanup_value)
            let drop_node = ir_block_new_params(drop_block, carried_args, drop_insts, ir_term_jump_args(target_block, carried_args))
            let blocks = ir_block_list_append(
              pipeline_lowered_blocks_blocks(init_blocks),
              ir_block_list_prepend(local_merge, ir_block_list_append(pipeline_lowered_blocks_blocks(body_blocks), ir_block_list_prepend(drop_node, ir_block_list_empty())))
            )
            pipeline_lowered_blocks_control(
              pipeline_lowered_blocks_next_block(body_blocks),
              cleanup_value + ir_inst_list_len(drop_insts),
              blocks,
              1,
              1
            )
          } else {
            let blocks = ir_block_list_append(
              pipeline_lowered_blocks_blocks(init_blocks),
              ir_block_list_prepend(local_merge, pipeline_lowered_blocks_blocks(body_blocks))
            )
            pipeline_lowered_blocks_control(
              pipeline_lowered_blocks_next_block(body_blocks),
              pipeline_lowered_blocks_next_value(body_blocks),
              blocks,
              1,
              pipeline_lowered_blocks_falls_through(body_blocks)
            )
          }
        } else {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        }
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  } else {
    let lower_ctx = pipeline_handler_lower_ctx_from_module(params, locals, module)
    let init = if pipeline_prim_is_forced_numeric_context(local_float) == 1 {
      pipeline_lower_expr_typed_sidecar_handler_opt_with_float_prim(init_expr, next_value, lower_ctx, local_float)
    } else {
      pipeline_lower_expr_typed_sidecar_handler_ctx(init_expr, next_value, lower_ctx)
    }
    if ir_lowered_expr_is_valid(init) == 1 {
      let address_taken = pipeline_expr_typed_address_of_binding(body_expr, src, ns, nl)
      let slot = if address_taken == 1 { pipeline_ir_addressable_slot_id(ir_lowered_expr_next_value(init)) } else { ir_lowered_expr_next_value(init) }
      let slot_insts = pipeline_ir_slot_lane_init_insts(slot, ir_lowered_expr_value(init), 0, local_lanes)
      let inferred_float_prim = pipeline_expr_float_prim_typed_temp(init_expr, params, locals, src, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module))
      let float_prim = if local_float == PRIM_F32() or local_float == PRIM_F64() { local_float } else { inferred_float_prim }
      let inferred_type_hash = pipeline_expr_type_hash_typed_temp(init_expr, params, locals, src, tt, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module))
      let inferred_type_node = pipeline_init_type_node_typed(init_expr, params, locals, module)
      let effective_type_node = if local_type_node != 0 { ty_subst(local_type_node, pipeline_lower_module_subst(module)) } else { inferred_type_node }
      let annotated_type_hash = if local_type_node != 0 and effective_type_node != 0 { type_hash_of(effective_type_node) } else { 0 }
      let inferred_node_type_hash = if effective_type_node != 0 { type_hash_of(effective_type_node) } else { 0 }
      let local_type_hash = if annotated_type_hash != 0 { annotated_type_hash } else { if inferred_node_type_hash != 0 { inferred_node_type_hash } else { if local_float != 0 and pipeline_prim_is_numeric_context(local_float) == 1 { pipeline_type_hash_of_prim_id(local_float) } else { pipeline_expr_type_hash_sharpen_int_typed(init_expr, inferred_type_hash, params, locals, src, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module)) } } }
      let retain_insts = if effective_type_node != 0 and pipeline_expr_result_is_borrowed_for_ty_typed(init_expr, effective_type_node, src, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module), pipeline_lower_module_tt(module)) == 1 {
        pipeline_managed_retain_inst_list(ir_lowered_expr_value(init), effective_type_node, slot + local_lanes)
      } else {
        ir_inst_list_empty()
      }
      let body_next_value = slot + local_lanes + ir_inst_list_len(retain_insts)
      let next_locals = pipeline_value_env_push_slot_float_typed_node(locals, ns, nl, slot, float_prim, local_type_hash, effective_type_node)
      let scope_needs_release = pipeline_let_mut_scope_needs_release(body_expr, src, ns, nl, address_taken, effective_type_node)
      if pipeline_expr_needs_lowering_cfg_typed(body_expr, src) == 1 {
        let drop_block = next_block
        let body_start = if scope_needs_release == 1 { next_block + 1 } else { next_block }
        let body_target = if scope_needs_release == 1 { drop_block } else { target_block }
        let body_blocks = pipeline_lower_expr_typed_to_target_blocks(body_expr, params, next_locals, module, body_next_value, body_start, body_target)
        if pipeline_lowered_blocks_is_valid(body_blocks) == 1 {
          let bind_insts = ir_inst_list_prepend(ir_inst_bind_typed_i64(ns, nl, slot, effective_type_node), ir_inst_list_empty())
          let entry_insts = ir_inst_list_append(ir_lowered_expr_insts(init), ir_inst_list_append(slot_insts, ir_inst_list_append(retain_insts, bind_insts)))
          let entry = ir_block_new_term(start_block, entry_insts, ir_term_jump(body_start))
          if scope_needs_release == 1 and pipeline_lowered_blocks_falls_through(body_blocks) == 1 {
            let carried = pipeline_lowered_blocks_next_value(body_blocks)
            let carried_lanes = pipeline_expr_value_lane_count(body_expr, params, next_locals, module)
            let carried_args = pipeline_ir_value_lane_ids(carried, 0, carried_lanes)
            let cleanup_value = carried + carried_lanes
            let drop_insts = pipeline_managed_slot_cleanup_inst_list(slot, effective_type_node, cleanup_value)
            let drop_node = ir_block_new_params(drop_block, carried_args, drop_insts, ir_term_jump_args(target_block, carried_args))
            let blocks = ir_block_list_prepend(entry, ir_block_list_append(pipeline_lowered_blocks_blocks(body_blocks), ir_block_list_prepend(drop_node, ir_block_list_empty())))
            pipeline_lowered_blocks_control(
              pipeline_lowered_blocks_next_block(body_blocks),
              cleanup_value + ir_inst_list_len(drop_insts),
              blocks,
              1,
              1
            )
          } else {
            let blocks = ir_block_list_prepend(entry, pipeline_lowered_blocks_blocks(body_blocks))
            pipeline_lowered_blocks_control(
              pipeline_lowered_blocks_next_block(body_blocks),
              pipeline_lowered_blocks_next_value(body_blocks),
              blocks,
              1,
              pipeline_lowered_blocks_falls_through(body_blocks)
            )
          }
        } else {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        }
      } else {
        let body_ctx = pipeline_handler_lower_ctx_from_module(params, next_locals, module)
        let body = pipeline_lower_expr_typed_sidecar_handler_ctx(body_expr, body_next_value, body_ctx)
        if ir_lowered_expr_is_valid(body) == 1 {
          let cleanup_insts = if scope_needs_release == 1 { pipeline_managed_slot_cleanup_inst_list(slot, effective_type_node, ir_lowered_expr_next_value(body)) } else { ir_inst_list_empty() }
          let after_cleanup = ir_lowered_expr_next_value(body) + ir_inst_list_len(cleanup_insts)
          let args = pipeline_ir_value_lane_ids(ir_lowered_expr_value(body), 0, pipeline_expr_value_lane_count(body_expr, params, next_locals, module))
          let bind_insts = ir_inst_list_prepend(ir_inst_bind_typed_i64(ns, nl, slot, effective_type_node), ir_inst_list_empty())
          let insts = ir_inst_list_append(ir_lowered_expr_insts(init), ir_inst_list_append(slot_insts, ir_inst_list_append(retain_insts, ir_inst_list_append(bind_insts, ir_inst_list_append(ir_lowered_expr_insts(body), cleanup_insts)))))
          let block = ir_block_new_term(start_block, insts, ir_term_jump_args(target_block, args))
          let blocks = ir_block_list_prepend(block, ir_block_list_empty())
          pipeline_lowered_blocks(next_block, after_cleanup, blocks, 1)
        } else {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        }
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  }
}

fn pipeline_lower_let_typed_to_target_blocks_ctx(ns: i64, nl: i64, init_expr: Expr, body_expr: Expr, ctx: PipelineTargetCtx) -> PipelineLoweredBlocks {
  pipeline_lower_let_typed_to_target_blocks_with_float(
    ns,
    nl,
    init_expr,
    body_expr,
    pipeline_target_ctx_local_float(ctx),
    pipeline_target_ctx_local_type_node(ctx),
    pipeline_target_ctx_params(ctx),
    pipeline_target_ctx_locals(ctx),
    pipeline_target_ctx_module(ctx),
    pipeline_target_ctx_next_value(ctx),
    pipeline_target_ctx_start_block(ctx),
    pipeline_target_ctx_next_block(ctx),
    pipeline_target_ctx_target_block(ctx)
  )
}

fn pipeline_lower_let_mut_typed_to_target_blocks_ctx(ns: i64, nl: i64, init_expr: Expr, body_expr: Expr, ctx: PipelineTargetCtx) -> PipelineLoweredBlocks {
  pipeline_lower_let_mut_typed_to_target_blocks_with_float(
    ns,
    nl,
    init_expr,
    body_expr,
    pipeline_target_ctx_local_float(ctx),
    pipeline_target_ctx_local_type_node(ctx),
    pipeline_target_ctx_params(ctx),
    pipeline_target_ctx_locals(ctx),
    pipeline_target_ctx_module(ctx),
    pipeline_target_ctx_next_value(ctx),
    pipeline_target_ctx_start_block(ctx),
    pipeline_target_ctx_next_block(ctx),
    pipeline_target_ctx_target_block(ctx)
  )
}

fn pipeline_lower_let_typed_annotation_to_target_blocks(inner: Expr, ann_type: TypeExpr, ctx: PipelineTargetCtx) -> PipelineLoweredBlocks {
  let ann_ctx = pipeline_target_ctx_with_type_node(pipeline_target_ctx_with_float(ctx, type_expr_prim_id_or(ann_type, 0)), type_expr_to_node(ann_type))
  let inner_tag = expr_tag(inner)
  if inner_tag == 6 {
    pipeline_lower_let_typed_to_target_blocks_ctx(
      expr_let_name_start_or(inner, 0),
      expr_let_name_len_or(inner, 0),
      expr_let_value_or(inner, NilExpr),
      expr_let_body_or(inner, NilExpr),
      ann_ctx
    )
  } else {
    if inner_tag == 11 {
      pipeline_lower_let_mut_typed_to_target_blocks_ctx(
        expr_let_name_start_or(inner, 0),
        expr_let_name_len_or(inner, 0),
        expr_let_value_or(inner, NilExpr),
        expr_let_body_or(inner, NilExpr),
        ann_ctx
      )
    } else {
      pipeline_lower_expr_typed_to_target_blocks_reserved(
      inner,
      pipeline_target_ctx_params(ctx),
      pipeline_target_ctx_locals(ctx),
      pipeline_target_ctx_module(ctx),
      pipeline_target_ctx_next_value(ctx),
      pipeline_target_ctx_start_block(ctx),
      pipeline_target_ctx_next_block(ctx),
      pipeline_target_ctx_target_block(ctx)
      )
    }
  }
}

fn pipeline_lower_expr_typed_to_target_blocks_reserved(expr: Expr, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let target_ctx = pipeline_target_ctx(params, locals, module, next_value, start_block, next_block, target_block)
  let expr_kind = expr_tag(expr)
  if expr_kind == 6 {
    pipeline_lower_let_typed_to_target_blocks_ctx(
      expr_let_name_start_or(expr, 0),
      expr_let_name_len_or(expr, 0),
      expr_let_value_or(expr, NilExpr),
      expr_let_body_or(expr, NilExpr),
      target_ctx
    )
  } else {
    if expr_kind == 11 {
      pipeline_lower_let_mut_typed_to_target_blocks_ctx(
        expr_let_name_start_or(expr, 0),
        expr_let_name_len_or(expr, 0),
        expr_let_value_or(expr, NilExpr),
        expr_let_body_or(expr, NilExpr),
        target_ctx
      )
    } else {
      match expr {
    If(cond, then_expr, else_expr) -> pipeline_lower_if_typed_to_target_blocks(cond, then_expr, else_expr, params, locals, module, next_value, start_block, next_block, target_block)
    While(cond, body) -> pipeline_lower_while_typed_to_target_blocks(cond, body, params, locals, module, next_value, start_block, next_block, target_block)
    ForIter(var_ns, var_nl, collection, body) -> pipeline_lower_for_iter_to_target_blocks(expr_to_node(expr), params, locals, module, next_value, start_block, next_block, target_block)
    Loop(body) -> pipeline_lower_loop_to_target_blocks(expr_to_node(expr), params, locals, module, next_value, start_block, next_block, target_block)
    Defer(cleanup, body) -> pipeline_lower_defer_to_target_blocks(expr_to_node(expr), params, locals, module, next_value, start_block, next_block, target_block)
    Match(scrutinee, arms) -> pipeline_lower_match_typed_to_target_blocks(scrutinee, arms, params, locals, module, next_value, start_block, next_block, target_block)
    BinOp(op, lhs, rhs) -> {
      if pipeline_expr_needs_lowering_cfg_typed(expr, src) == 1 {
        pipeline_lower_binop_typed_to_target_blocks(op, lhs, rhs, params, locals, module, next_value, start_block, next_block, target_block)
      } else {
        pipeline_lower_straight_expr_typed_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      }
    }
    Not(operand) -> pipeline_lower_expr_typed_unary_merge_to_target_blocks(operand, ir_unary_op_not(), params, locals, module, next_value, start_block, next_block, target_block)
    Try(inner, effect_atom) -> pipeline_lower_try_typed_to_target_blocks(inner, effect_atom, params, locals, module, next_value, start_block, next_block, target_block)
    Call(ns, nl, args) -> {
      let par_scope = pipeline_lower_par_scope_call_typed_to_target_blocks(ns, nl, args, params, locals, module, next_value, start_block, next_block, target_block)
      if pipeline_lowered_blocks_is_valid(par_scope) == 1 {
        par_scope
      } else {
        if pipeline_expr_list_needs_lowering_cfg_typed(args, src) == 1 or pipeline_par_lower_ctx_is_active(pipeline_lower_module_par_ctx(module)) == 1 {
          pipeline_lower_call_typed_to_target_blocks(ns, nl, args, params, locals, module, next_value, start_block, next_block, target_block)
        } else {
          pipeline_lower_straight_expr_typed_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
        }
      }
    }
    Perform(lhs, op_ns, op_nl, args) -> {
      if pipeline_expr_is_par_effect_name(pipeline_lower_module_src(module), lhs) == 1 {
        pipeline_lower_perform_typed_to_target_blocks(lhs, op_ns, op_nl, args, params, locals, module, next_value, start_block, next_block, target_block)
      } else {
        if pipeline_expr_needs_lowering_cfg_typed(lhs, src) == 1 or pipeline_expr_list_needs_lowering_cfg_typed(args, src) == 1 {
          pipeline_lower_perform_typed_to_target_blocks(lhs, op_ns, op_nl, args, params, locals, module, next_value, start_block, next_block, target_block)
        } else {
          pipeline_lower_straight_expr_typed_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
        }
      }
    }
    GenericCall(type_args, inner_call) -> pipeline_lower_generic_call_typed_to_target_blocks(type_args, inner_call, params, locals, module, next_value, start_block, next_block, target_block)
    MethodCall(recv, method_hash, args, type_hash) -> pipeline_lower_method_call_typed_to_target_blocks(recv, method_hash, args, type_hash, params, locals, module, next_value, start_block, next_block, target_block)
    FieldAccess(base, field_ns, field_nl, fact) -> pipeline_lower_field_like_typed_to_target_blocks(base, field_ns, field_nl, fact, 0, 0, params, locals, module, next_value, start_block, next_block, target_block)
    IndexedLen(base, fixed_len) -> pipeline_lower_indexed_len_typed_to_target_blocks(base, fixed_len, params, locals, module, next_value, start_block, next_block, target_block)
    IndexedGet(base, index, element_ty, fixed_len) -> pipeline_lower_indexed_get_typed_to_target_blocks(base, index, element_ty, fixed_len, params, locals, module, next_value, start_block, next_block, target_block)
    IndexedSet(base, index, value, fact) -> pipeline_lower_indexed_set_typed_to_target_blocks(base, index, value, fact, params, locals, module, next_value, start_block, next_block, target_block)
    IndexedSlice(base, start, end, fact) -> pipeline_lower_indexed_slice_typed_to_target_blocks(base, start, end, fact, params, locals, module, next_value, start_block, next_block, target_block)
    OptChain(base, field_ns, field_nl, effect_atom) -> pipeline_lower_field_like_typed_to_target_blocks(base, field_ns, field_nl, UnknownFieldAccessFact, 1, effect_atom, params, locals, module, next_value, start_block, next_block, target_block)
    RecordInit(type_ns, type_nl, fields) -> pipeline_lower_record_init_typed_to_target_blocks(type_ns, type_nl, fields, params, locals, module, next_value, start_block, next_block, target_block)
    ArrayLiteral(elements, resolved_ty, span) -> pipeline_lower_array_literal_typed_to_target_blocks(elements, resolved_ty, params, locals, module, next_value, start_block, next_block, target_block)
    Return(value) -> pipeline_lower_return_typed_to_blocks(value, params, locals, module, next_value, start_block, next_block)
    ReturnNoValue -> pipeline_lower_return_typed_to_blocks(NilExpr, params, locals, module, next_value, start_block, next_block)
    Assign(ns, nl, value) -> pipeline_lower_assign_typed_to_target_blocks(ns, nl, value, params, locals, module, next_value, start_block, next_block, target_block)
    Block(first, rest) -> pipeline_lower_block_typed_to_target_blocks(first, rest, params, locals, module, next_value, start_block, next_block, target_block)
    Handle(body, clauses, hret) -> pipeline_lower_handle_typed_to_target_blocks(body, clauses, hret, params, locals, module, next_value, start_block, next_block, target_block)
    Resume(value) -> pipeline_lower_expr_typed_to_target_blocks_reserved(value, params, locals, module, next_value, start_block, next_block, target_block)
    LetTyped(inner, ann_type) -> pipeline_lower_let_typed_annotation_to_target_blocks(inner, ann_type, target_ctx)
    _ -> pipeline_lower_straight_expr_typed_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      }
    }
  }
}

fn pipeline_lower_expr_typed_to_target_blocks(expr: Expr, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let next_block = if target_block == start_block + 1 { start_block + 2 } else { start_block + 1 }
  pipeline_lower_expr_typed_to_target_blocks_reserved(expr, params, locals, module, next_value, start_block, next_block, target_block)
}

-- Discarded-result release (2q slice 2 stage B): a statement-position
-- owned rvalue (call/ctor/record result whose value nobody binds) must
-- drop its count at the discard point or every such statement leaks.
fn pipeline_discard_release_type(expr: Expr, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> i64 {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let ty = pipeline_return_expr_type_node_typed(expr, params, locals, module)
  let is_owned = if pipeline_expr_owned_rvalue_temp_typed(expr, src, tt) == 1 { 1 }
    else { pipeline_expr_owned_array_value_typed(expr, ty, src, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module), tt) }
  if is_owned == 0 { 0 }
  else {
    if ty != 0 and ty_value_has_release_lane(ty) == 1 { ty } else { 0 }
  }
}

fn pipeline_lower_expr_typed_to_control_target_blocks_reserved(expr: Expr, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  if pipeline_expr_needs_lowering_cfg_typed(expr, src) == 1 {
    let discard_block = pipeline_lower_internal_block_after_target(next_block, target_block)
    let value_next_block = pipeline_lower_internal_block_after_target(discard_block + 1, target_block)
    let value_blocks = pipeline_lower_expr_typed_to_target_blocks_reserved(expr, params, locals, module, next_value, start_block, value_next_block, discard_block)
    if pipeline_lowered_blocks_is_valid(value_blocks) == 1 {
      if pipeline_lowered_blocks_falls_through(value_blocks) == 0 {
        value_blocks
      } else {
        let discard_value = pipeline_lowered_blocks_next_value(value_blocks)
        let discard_lanes = pipeline_expr_value_lane_count(expr, params, locals, module)
        let discard_ty = pipeline_discard_release_type(expr, params, locals, module)
        let release_insts = if discard_ty != 0 { pipeline_managed_release_inst_list(discard_value, discard_ty, discard_value + discard_lanes) } else { ir_inst_list_empty() }
        let after_discard = discard_value + discard_lanes + ir_inst_list_len(release_insts)
        let discard_params = pipeline_ir_value_lane_ids(discard_value, 0, discard_lanes)
        let discard_merge = ir_block_new_params(discard_block, discard_params, release_insts, ir_term_jump(target_block))
        let blocks = ir_block_list_append(
          pipeline_lowered_blocks_blocks(value_blocks),
          ir_block_list_prepend(discard_merge, ir_block_list_empty())
        )
        pipeline_lowered_blocks_control(pipeline_lowered_blocks_next_block(value_blocks), after_discard, blocks, 1, 1)
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  } else {
    pipeline_lower_straight_expr_typed_to_control_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
  }
}

fn pipeline_lower_assign_typed_to_target_blocks(ns: i64, nl: i64, value_expr: Expr, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let slot = pipeline_value_env_lookup(locals, src, ns, nl)
  if slot >= 0 {
    if pipeline_value_env_lookup_kind(locals, src, ns, nl) == 1 {
      let slot_ty = pipeline_value_env_lookup_type_node(locals, src, ns, nl)
      let slot_lanes = pipeline_type_value_lane_count_or_one(slot_ty)
      if pipeline_expr_needs_lowering_cfg_typed(value_expr, src) == 1 {
        let assign_block = next_block
        let assign_value = next_value
        let value_blocks = pipeline_lower_expr_typed_to_target_blocks_reserved(value_expr, params, locals, module, assign_value + slot_lanes, start_block, next_block + 1, assign_block)
        if pipeline_lowered_blocks_is_valid(value_blocks) == 1 {
          if pipeline_lowered_blocks_falls_through(value_blocks) == 0 {
            value_blocks
          } else {
            let retain_start = pipeline_ir_max_i64(pipeline_lowered_blocks_next_value(value_blocks), assign_value + slot_lanes)
            let retain_insts = if slot_ty != 0 and pipeline_expr_result_is_borrowed_for_ty_typed(value_expr, slot_ty, src, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module), pipeline_lower_module_tt(module)) == 1 {
              pipeline_managed_retain_inst_list(assign_value, slot_ty, retain_start)
            } else {
              ir_inst_list_empty()
            }
            let after_retain = retain_start + ir_inst_list_len(retain_insts)
            let old_value = after_retain
            let release_count = pipeline_type_managed_release_lane_count(slot_ty)
            let load_old_insts = if release_count > 0 {
              pipeline_ir_slot_managed_lane_load_insts(old_value, slot, slot_ty, 0, slot_lanes)
            } else {
              ir_inst_list_empty()
            }
            let release_insts = if release_count > 0 {
              pipeline_managed_release_inst_list(old_value, slot_ty, old_value + slot_lanes)
            } else {
              ir_inst_list_empty()
            }
            let nil_value = if release_count > 0 { old_value + slot_lanes + ir_inst_list_len(release_insts) } else { old_value }
            let assign_params = pipeline_ir_value_lane_ids(assign_value, 0, slot_lanes)
            let assign_args = ir_value_list_prepend(nil_value, ir_value_list_empty())
            let assign_insts = ir_inst_list_append(
              pipeline_ir_slot_store_lane_insts(slot, assign_value, 0, slot_lanes),
              ir_inst_list_prepend(ir_inst_const_i64(nil_value, 0), ir_inst_list_empty())
            )
            let update_insts = ir_inst_list_append(retain_insts, ir_inst_list_append(load_old_insts, ir_inst_list_append(release_insts, assign_insts)))
            let assign_merge = ir_block_new_params(assign_block, assign_params, update_insts, ir_term_jump_args(target_block, assign_args))
            let blocks = ir_block_list_append(
              pipeline_lowered_blocks_blocks(value_blocks),
              ir_block_list_prepend(assign_merge, ir_block_list_empty())
            )
            pipeline_lowered_blocks(pipeline_lowered_blocks_next_block(value_blocks), nil_value + 1, blocks, 1)
          }
        } else {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        }
      } else {
        pipeline_lower_straight_expr_typed_to_target_blocks(Assign(ns, nl, value_expr), params, locals, module, next_value, start_block, next_block, target_block)
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  } else {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  }
}

fn pipeline_lower_return_typed_to_blocks(value_expr: Expr, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  if pipeline_expr_needs_lowering_cfg_typed(value_expr, src) == 1 {
    let return_block = next_block
    let value_blocks = pipeline_lower_expr_typed_to_target_blocks_reserved(value_expr, params, locals, module, next_value, start_block, next_block + 1, return_block)
    if pipeline_lowered_blocks_is_valid(value_blocks) == 1 {
      if pipeline_lowered_blocks_falls_through(value_blocks) == 0 {
        value_blocks
      } else {
        let return_value = pipeline_lowered_blocks_next_value(value_blocks)
        let return_lanes = pipeline_expr_value_lane_count(value_expr, params, locals, module)
        let return_params = pipeline_ir_value_lane_ids(return_value, 0, return_lanes)
        let transfer = pipeline_lower_return_transfer_typed(value_expr, return_value, return_value + return_lanes, params, locals, module)
        let return_node = ir_block_new_params(return_block, return_params, ir_lowered_expr_insts(transfer), ir_term_return(ir_lowered_expr_value(transfer)))
        let blocks = ir_block_list_append(
          pipeline_lowered_blocks_blocks(value_blocks),
          ir_block_list_prepend(return_node, ir_block_list_empty())
        )
        pipeline_lowered_blocks_control(pipeline_lowered_blocks_next_block(value_blocks), ir_lowered_expr_next_value(transfer), blocks, 1, 0)
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  } else {
    let lower_ctx = pipeline_handler_lower_ctx_from_module(params, locals, module)
    let value = pipeline_lower_expr_typed_sidecar_handler_ctx(value_expr, next_value, lower_ctx)
    if ir_lowered_expr_is_valid(value) == 1 {
      let transfer = pipeline_lower_return_transfer_typed(value_expr, ir_lowered_expr_value(value), ir_lowered_expr_next_value(value), params, locals, module)
      let block = ir_block_new_term(start_block, ir_inst_list_append(ir_lowered_expr_insts(value), ir_lowered_expr_insts(transfer)), ir_term_return(ir_lowered_expr_value(transfer)))
      let blocks = ir_block_list_prepend(block, ir_block_list_empty())
      pipeline_lowered_blocks_control(next_block, ir_lowered_expr_next_value(transfer), blocks, 1, 0)
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  }
}

fn pipeline_lower_if_typed_to_target_blocks_with_float(cond_expr: Expr, then_expr: Expr, else_expr: Expr, result_prim: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let fns = pipeline_lower_module_fns(module)
  let subst = pipeline_lower_module_subst(module)
  let then_ty = pipeline_return_expr_type_node_typed(then_expr, params, locals, module)
  let else_ty = pipeline_return_expr_type_node_typed(else_expr, params, locals, module)
  let then_borrowed = pipeline_expr_result_is_borrowed_for_ty_typed(then_expr, then_ty, src, fns, subst, pipeline_lower_module_tt(module))
  let else_borrowed = pipeline_expr_result_is_borrowed_for_ty_typed(else_expr, else_ty, src, fns, subst, pipeline_lower_module_tt(module))
  let whole_borrowed = if then_borrowed == 1 { else_borrowed } else { 0 }
  let then_retain_hash = pipeline_managed_arm_needs_retain(then_borrowed, whole_borrowed, then_ty)
  let else_retain_hash = pipeline_managed_arm_needs_retain(else_borrowed, whole_borrowed, else_ty)
  if pipeline_expr_needs_lowering_cfg_typed(cond_expr, src) == 1 {
    let cond_merge_block = pipeline_lower_internal_block_after_target(next_block, target_block)
    let cond_blocks = pipeline_lower_expr_typed_to_target_blocks_reserved(cond_expr, params, locals, module, next_value, start_block, cond_merge_block + 1, cond_merge_block)
    if pipeline_lowered_blocks_is_valid(cond_blocks) == 1 {
      if pipeline_lowered_blocks_falls_through(cond_blocks) == 0 {
        cond_blocks
      } else {
        let cond_value = pipeline_lowered_blocks_next_value(cond_blocks)
        let then_start = pipeline_lower_internal_block_after_target(pipeline_lowered_blocks_next_block(cond_blocks), target_block)
        let else_seed = pipeline_lower_internal_block_after_target(then_start + 1, target_block)
        let then_retain_block = if then_retain_hash != 0 { pipeline_lower_internal_block_after_target(else_seed + 1, target_block) } else { 0 }
        let then_target = if then_retain_hash != 0 { then_retain_block } else { target_block }
        let then_inner_next = if then_retain_hash != 0 { pipeline_lower_internal_block_after_target(then_retain_block + 1, target_block) } else { pipeline_lower_internal_block_after_target(else_seed + 1, target_block) }
        let then_blocks_raw = pipeline_lower_expr_typed_to_target_blocks_reserved_with_float(then_expr, params, locals, module, cond_value + 1, then_start, then_inner_next, then_target, result_prim)
        let then_blocks = pipeline_managed_arm_retain_append(then_blocks_raw, then_retain_hash, then_ty, then_retain_block, target_block)
        if pipeline_lowered_blocks_is_valid(then_blocks) == 1 {
          let else_start = pipeline_lower_internal_block_after_target(pipeline_ir_max_i64(pipeline_lowered_blocks_next_block(then_blocks), else_seed), target_block)
          let else_retain_block = if else_retain_hash != 0 { pipeline_lower_internal_block_after_target(else_start + 1, target_block) } else { 0 }
          let else_target = if else_retain_hash != 0 { else_retain_block } else { target_block }
          let else_inner_next = if else_retain_hash != 0 { pipeline_lower_internal_block_after_target(else_retain_block + 1, target_block) } else { pipeline_lower_internal_block_after_target(else_start + 1, target_block) }
          let else_blocks_raw = pipeline_lower_expr_typed_to_target_blocks_reserved_with_float(else_expr, params, locals, module, pipeline_lowered_blocks_next_value(then_blocks), else_start, else_inner_next, else_target, result_prim)
          let else_blocks = pipeline_managed_arm_retain_append(else_blocks_raw, else_retain_hash, else_ty, else_retain_block, target_block)
          if pipeline_lowered_blocks_is_valid(else_blocks) == 1 {
            let cond_params = ir_value_list_prepend(cond_value, ir_value_list_empty())
            let cond_merge = ir_block_new_params(cond_merge_block, cond_params, ir_inst_list_empty(), ir_term_branch(cond_value, then_start, else_start))
            let falls_through = if pipeline_lowered_blocks_falls_through(then_blocks) == 1 { 1 } else { pipeline_lowered_blocks_falls_through(else_blocks) }
            let blocks = ir_block_list_append(
              pipeline_lowered_blocks_blocks(cond_blocks),
              ir_block_list_prepend(cond_merge, ir_block_list_append(pipeline_lowered_blocks_blocks(then_blocks), pipeline_lowered_blocks_blocks(else_blocks)))
            )
            pipeline_lowered_blocks_control(pipeline_lowered_blocks_next_block(else_blocks), pipeline_lowered_blocks_next_value(else_blocks), blocks, 1, falls_through)
          } else {
            pipeline_lowered_blocks_invalid(start_block, next_value)
          }
        } else {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        }
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  } else {
    let lower_ctx = pipeline_handler_lower_ctx_from_module(params, locals, module)
    let cond = pipeline_lower_expr_typed_sidecar_handler_ctx(cond_expr, next_value, lower_ctx)
    if ir_lowered_expr_is_valid(cond) == 1 {
      let then_start = pipeline_lower_internal_block_after_target(next_block, target_block)
      let else_seed = pipeline_lower_internal_block_after_target(then_start + 1, target_block)
      let then_retain_block = if then_retain_hash != 0 { pipeline_lower_internal_block_after_target(else_seed + 1, target_block) } else { 0 }
      let then_target = if then_retain_hash != 0 { then_retain_block } else { target_block }
      let then_inner_next = if then_retain_hash != 0 { pipeline_lower_internal_block_after_target(then_retain_block + 1, target_block) } else { pipeline_lower_internal_block_after_target(else_seed + 1, target_block) }
      let then_blocks_raw = pipeline_lower_expr_typed_to_target_blocks_reserved_with_float(then_expr, params, locals, module, ir_lowered_expr_next_value(cond), then_start, then_inner_next, then_target, result_prim)
      let then_blocks = pipeline_managed_arm_retain_append(then_blocks_raw, then_retain_hash, then_ty, then_retain_block, target_block)
      if pipeline_lowered_blocks_is_valid(then_blocks) == 1 {
        let else_start = pipeline_lower_internal_block_after_target(pipeline_ir_max_i64(pipeline_lowered_blocks_next_block(then_blocks), else_seed), target_block)
        let else_retain_block = if else_retain_hash != 0 { pipeline_lower_internal_block_after_target(else_start + 1, target_block) } else { 0 }
        let else_target = if else_retain_hash != 0 { else_retain_block } else { target_block }
        let else_inner_next = if else_retain_hash != 0 { pipeline_lower_internal_block_after_target(else_retain_block + 1, target_block) } else { pipeline_lower_internal_block_after_target(else_start + 1, target_block) }
        let else_blocks_raw = pipeline_lower_expr_typed_to_target_blocks_reserved_with_float(else_expr, params, locals, module, pipeline_lowered_blocks_next_value(then_blocks), else_start, else_inner_next, else_target, result_prim)
        let else_blocks = pipeline_managed_arm_retain_append(else_blocks_raw, else_retain_hash, else_ty, else_retain_block, target_block)
        if pipeline_lowered_blocks_is_valid(else_blocks) == 1 {
          let entry = ir_block_new_term(start_block, ir_lowered_expr_insts(cond), ir_term_branch(ir_lowered_expr_value(cond), then_start, else_start))
          let falls_through = if pipeline_lowered_blocks_falls_through(then_blocks) == 1 { 1 } else { pipeline_lowered_blocks_falls_through(else_blocks) }
          let blocks = ir_block_list_prepend(entry, ir_block_list_append(pipeline_lowered_blocks_blocks(then_blocks), pipeline_lowered_blocks_blocks(else_blocks)))
          pipeline_lowered_blocks_control(pipeline_lowered_blocks_next_block(else_blocks), pipeline_lowered_blocks_next_value(else_blocks), blocks, 1, falls_through)
        } else {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        }
      } else {
        pipeline_lowered_blocks_invalid(start_block, next_value)
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  }
}

fn pipeline_lower_if_typed_to_target_blocks(cond_expr: Expr, then_expr: Expr, else_expr: Expr, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  pipeline_lower_if_typed_to_target_blocks_with_float(cond_expr, then_expr, else_expr, 0, params, locals, module, next_value, start_block, next_block, target_block)
}

fn pipeline_lower_block_rest_typed_to_target_blocks(rest_expr: Expr, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  if pipeline_expr_is_absent_typed(rest_expr) == 1 {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  } else {
    pipeline_lower_expr_typed_to_target_blocks(rest_expr, params, locals, module, next_value, start_block, target_block)
  }
}

fn pipeline_lower_block_typed_to_target_blocks(first_expr: Expr, rest_expr: Expr, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  if pipeline_expr_is_absent_typed(rest_expr) == 1 {
    pipeline_lower_expr_typed_to_target_blocks_reserved(first_expr, params, locals, module, next_value, start_block, next_block, target_block)
  } else {
    let src = pipeline_lower_module_src(module)
    if pipeline_expr_needs_lowering_cfg_typed(first_expr, src) == 1 {
      let discard_merge_block = pipeline_lower_internal_block_after_target(next_block, target_block)
      let first_next_block = pipeline_lower_internal_block_after_target(discard_merge_block + 1, target_block)
      let first_blocks = pipeline_lower_expr_typed_to_control_target_blocks_reserved(first_expr, params, locals, module, next_value, start_block, first_next_block, discard_merge_block)
      if pipeline_lowered_blocks_is_valid(first_blocks) == 1 {
        if pipeline_lowered_blocks_falls_through(first_blocks) == 0 {
          first_blocks
        } else {
          let rest_next_value = pipeline_lowered_blocks_next_value(first_blocks)
          let rest_start = pipeline_lower_internal_block_after_target(pipeline_ir_max_i64(pipeline_lowered_blocks_next_block(first_blocks), discard_merge_block + 1), target_block)
          let rest_blocks = pipeline_lower_block_rest_typed_to_target_blocks(rest_expr, params, locals, module, rest_next_value, rest_start, target_block)
          if pipeline_lowered_blocks_is_valid(rest_blocks) == 1 {
            let discard_merge = ir_block_new_term(discard_merge_block, ir_inst_list_empty(), ir_term_jump(rest_start))
            let blocks = ir_block_list_append(
              pipeline_lowered_blocks_blocks(first_blocks),
              ir_block_list_prepend(discard_merge, pipeline_lowered_blocks_blocks(rest_blocks))
            )
            pipeline_lowered_blocks_control(
              pipeline_lowered_blocks_next_block(rest_blocks),
              pipeline_lowered_blocks_next_value(rest_blocks),
              blocks,
              1,
              pipeline_lowered_blocks_falls_through(rest_blocks)
            )
          } else {
            pipeline_lowered_blocks_invalid(start_block, next_value)
          }
        }
      } else {
        pipeline_lowered_blocks_invalid(start_block, next_value)
      }
    } else {
      let lower_ctx = pipeline_handler_lower_ctx_from_module(params, locals, module)
      let first = pipeline_lower_expr_typed_sidecar_handler_ctx(first_expr, next_value, lower_ctx)
      if ir_lowered_expr_is_valid(first) == 1 {
        let discard_ty = pipeline_discard_release_type(first_expr, params, locals, module)
        let release_insts = if discard_ty != 0 { pipeline_managed_release_inst_list(ir_lowered_expr_value(first), discard_ty, ir_lowered_expr_next_value(first)) } else { ir_inst_list_empty() }
        let rest_next_value = ir_lowered_expr_next_value(first) + ir_inst_list_len(release_insts)
        let rest_start = pipeline_lower_internal_block_after_target(next_block, target_block)
        let rest_blocks = pipeline_lower_block_rest_typed_to_target_blocks(rest_expr, params, locals, module, rest_next_value, rest_start, target_block)
        if pipeline_lowered_blocks_is_valid(rest_blocks) == 1 {
          let entry = ir_block_new_term(start_block, ir_inst_list_append(ir_lowered_expr_insts(first), release_insts), ir_term_jump(rest_start))
          let blocks = ir_block_list_prepend(entry, pipeline_lowered_blocks_blocks(rest_blocks))
          pipeline_lowered_blocks_control(
            pipeline_lowered_blocks_next_block(rest_blocks),
            pipeline_lowered_blocks_next_value(rest_blocks),
            blocks,
            1,
            pipeline_lowered_blocks_falls_through(rest_blocks)
          )
        } else {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        }
      } else {
        pipeline_lowered_blocks_invalid(start_block, next_value)
      }
    }
  }
}

fn pipeline_lowered_handler_clauses_bodies(lowered: PipelineLoweredHandlerClauses) -> IrHandlerClauseBodyList {
  match lowered {
    PipelineLoweredHandlerClauses(bodies, valid, out_of_line_safe) -> bodies
  }
}

fn pipeline_lowered_handler_clauses_valid(lowered: PipelineLoweredHandlerClauses) -> i64 {
  match lowered {
    PipelineLoweredHandlerClauses(bodies, valid, out_of_line_safe) -> valid
  }
}

fn pipeline_lowered_handler_clauses_out_of_line_safe(lowered: PipelineLoweredHandlerClauses) -> i64 {
  match lowered {
    PipelineLoweredHandlerClauses(bodies, valid, out_of_line_safe) -> out_of_line_safe
  }
}

fn pipeline_handler_capture_locals(captures: i64, index: i64, value_base: i64, locals: PipelineValueEnv) -> PipelineValueEnv {
  if captures == 0 or index >= nlist_len(captures) {
    locals
  } else {
    let capture = nlist_get(captures, index)
    let ty = node_f4(capture)
    let type_hash = if ty == 0 { 0 } else { type_hash_of(ty) }
    let float_prim = pipeline_type_node_prim_id_or(ty, 0)
    let next_locals = pipeline_value_env_push_float_typed_node(
      locals,
      node_f1(capture),
      node_f2(capture),
      value_base + pipeline_capture_value_lane_offset(captures, index),
      float_prim,
      type_hash,
      ty
    )
    pipeline_handler_capture_locals(captures, index + 1, value_base, next_locals)
  }
}

fn pipeline_handler_clause_lowering_locals(clause_params: ParamList, expected_params: i64, param_lanes: i64, captures: i64) -> PipelineValueEnv {
  let capture_lanes = pipeline_capture_value_lane_count(captures)
  let with_captures = pipeline_handler_capture_locals(captures, 0, param_lanes, pipeline_value_env_empty())
  pipeline_handler_clause_lowering_params(clause_params, expected_params, 0, param_lanes + capture_lanes, with_captures)
}

fn pipeline_deferred_body_lowering_locals(captures: i64) -> PipelineValueEnv {
  pipeline_handler_capture_locals(captures, 0, 0, pipeline_value_env_empty())
}

fn pipeline_lower_handler_clause_body_typed(clause: HandlerClause, fn_params: i64, outer_locals: PipelineValueEnv, module: PipelineLowerModule, handle_result_ty: i64) -> IrHandlerClauseBody {
  let src = pipeline_lower_module_src(module)
  match clause {
    HandlerClause(name_info, clause_params, body, continuation) -> {
      let local_scope = pipeline_handler_clause_local_scope(clause_params, continuation)
      let available = pipeline_lambda_capture_env_with_params(fn_params, outer_locals, src)
      let captures = nlist_new()
      pipeline_lambda_capture_expr(body, local_scope, available, src, captures)
      let has_continuation = handler_clause_has_continuation(clause)
      let op_hash = pipeline_handler_clause_op_hash_typed(src, clause)
      let expected_params = match name_info {
        HandlerClauseName(effect_ref, op_ns, op_nl) -> pipeline_effect_op_params_nodes_typed(
          pipeline_lower_module_tt(module),
          src,
          effect_ref,
          op_ns,
          op_nl,
          pipeline_lower_module_subst(module)
        )
        UnknownHandlerClauseName -> 0
      }
      let param_nodes = param_list_to_nodes(clause_params)
      let param_lanes = if expected_params == 0 {
        pipeline_params_value_lane_count(param_nodes)
      } else {
        pipeline_params_value_lane_count(expected_params)
      }
      let resume_ty = match name_info {
        HandlerClauseName(effect_ref, op_ns, op_nl) -> pipeline_effect_op_return_type_typed(
          pipeline_lower_module_tt(module),
          src,
          effect_ref,
          op_ns,
          op_nl,
          pipeline_lower_module_subst(module)
        )
        UnknownHandlerClauseName -> 0
      }
      -- Immediate handler frames borrow captures from the enclosing frame:
      -- the handler cannot outlive that lexical extent. Operation parameters
      -- are different: perform transfers one stake into the selected clause.
      -- The clause return transfer first normalises any borrowed result, then
      -- the clause releases those parameter stakes on every return edge.
      -- Deferred handlers still describe exact capture cleanup kinds below.
      let capture_lanes = pipeline_capture_value_lane_count(captures)
      let base_next = param_lanes + capture_lanes + param_lanes
      -- Reserve a fixed continuation layout independent of managed
      -- capture count: token, cleanup segment, closure, closure env.
      let continuation_closure_value = base_next + 2
      let first_value = if has_continuation == 1 { base_next + 4 } else { base_next }
      let base_locals = pipeline_handler_clause_lowering_locals(clause_params, expected_params, param_lanes, captures)
      let safe_handlers = pipeline_handler_inline_ctx_out_of_line_safe(pipeline_lower_module_handlers(module))
      let body_module = pipeline_lower_module_with_handlers(module, safe_handlers)
      let abortive = handler_clause_is_abortive(clause)
      let abort_result_ty = if abortive == 1 { pipeline_return_expr_type_node_typed(body, 0, base_locals, body_module) } else { 0 }
      let result_ty = if abortive == 1 {
        if abort_result_ty == 0 { handle_result_ty } else { abort_result_ty }
      } else { if has_continuation == 1 { handle_result_ty } else { resume_ty } }
      let typed_params = if expected_params == 0 { param_nodes } else { expected_params }
      let returned_param_index = pipeline_expr_exact_result_param_index_typed(body, param_nodes, src)
      let returned_param_ty = if returned_param_index >= 0 and returned_param_index < nlist_len(typed_params) {
        node_f3(nlist_get(typed_params, returned_param_index))
      } else { 0 }
      -- Operation parameters arrive with an owned transport stake. When
      -- every result path returns one parameter unchanged, transfer that
      -- existing stake directly instead of retaining at the merge and then
      -- releasing the same parameter. Mixed results keep ordinary arm
      -- normalisation.
      let returned_param_mask = if returned_param_index >= 0 and ty_value_has_release_lane(returned_param_ty) == 1 {
        cg_bit(returned_param_index)
      } else { 0 }
      let body_locals = pipeline_handler_clause_locals_with_continuation(base_locals, continuation, continuation_closure_value, resume_ty, result_ty)
      let lower_ctx = pipeline_handler_lower_ctx_from_module(0, body_locals, body_module)
      let lowered = pipeline_lower_expr_typed_hclause_blocks(body, first_value, lower_ctx, result_ty, if returned_param_mask != 0 { 1 } else { 0 })
      if pipeline_lowered_blocks_is_valid(lowered) == 0 {
        IrHandlerClauseBodyInvalid(4)
      } else {
        -- Abortive clauses never return to the perform site. J3 walks the
        -- abandoned frame and consumes every managed transport acquisition,
        -- so releasing those parameters inside the clause would consume the
        -- same stakes twice. Non-abortive clauses still release locally;
        -- an exactly returned parameter transfers its stake instead.
        let param_release_mask = if abortive == 1 { cg_params_managed_mask(typed_params) } else { returned_param_mask }
        let param_drops = pipeline_managed_param_release_insts_at_with_borrow_mask(
          typed_params,
          0,
          nlist_len(typed_params),
          param_lanes + capture_lanes,
          pipeline_lowered_blocks_next_value(lowered),
          param_release_mask
        )
        let dropped_blocks = pipeline_ir_block_list_append_return_drops(pipeline_lowered_blocks_blocks(lowered), param_drops)
        let transferred_param_value_fact = if returned_param_mask != 0 {
          param_lanes + capture_lanes + pipeline_param_value_index_at(typed_params, returned_param_index) + 1
        } else { 0 }
        IrHandlerClauseBody(op_hash, param_lanes, captures, has_continuation, abortive, pipeline_type_value_lane_cleanup_mask(result_ty), transferred_param_value_fact, pipeline_type_value_lane_count_or_one(resume_ty), pipeline_type_value_lane_count_or_one(result_ty), first_value, dropped_blocks)
      }
    }
    UnknownHandlerClause(tag) -> IrHandlerClauseBodyInvalid(5)
  }
}

fn pipeline_lower_handler_clauses_typed(clauses: HandlerClauseList, fn_params: i64, outer_locals: PipelineValueEnv, module: PipelineLowerModule, handle_result_ty: i64) -> PipelineLoweredHandlerClauses {
  match clauses {
    HandlerClauseListNil -> PipelineLoweredHandlerClauses(IrHandlerClauseBodyNil, 1, 1)
    HandlerClauseListCons(clause, rest) -> {
      let body = pipeline_lower_handler_clause_body_typed(clause, fn_params, outer_locals, module, handle_result_ty)
      let lowered_rest = pipeline_lower_handler_clauses_typed(rest, fn_params, outer_locals, module, handle_result_ty)
      let body_valid = match body {
        IrHandlerClauseBody(op_hash, nparams, captures, has_continuation, is_abortive, result_cleanup_kind, transferred_param_value_fact, resume_lanes, result_lanes, first_value, blocks) -> 1
        IrHandlerClauseBodyInvalid(reason) -> 0
      }
      let body_safe = match body {
        IrHandlerClauseBody(op_hash, nparams, captures, has_continuation, is_abortive, result_cleanup_kind, transferred_param_value_fact, resume_lanes, result_lanes, first_value, blocks) -> if nlist_len(captures) == 0 { 1 } else { 0 }
        IrHandlerClauseBodyInvalid(reason) -> 0
      }
      PipelineLoweredHandlerClauses(
        IrHandlerClauseBodyCons(body, pipeline_lowered_handler_clauses_bodies(lowered_rest)),
        body_valid * pipeline_lowered_handler_clauses_valid(lowered_rest),
        body_safe * pipeline_lowered_handler_clauses_out_of_line_safe(lowered_rest)
      )
    }
  }
}

fn pipeline_lower_deferred_handler_body_typed(body: Expr, clauses: HandlerClauseList, lowered_clauses: PipelineLoweredHandlerClauses, fn_params: i64, outer_locals: PipelineValueEnv, module: PipelineLowerModule) -> IrDeferredHandlerBody {
  let src = pipeline_lower_module_src(module)
  let available = pipeline_lambda_capture_env_with_params(fn_params, outer_locals, src)
  let captures = nlist_new()
  pipeline_lambda_capture_expr(body, scope_new(), available, src, captures)
  let capture_lanes = pipeline_capture_value_lane_count(captures)
  let ops_value = capture_lanes
  let first_value = capture_lanes + 1
  let eff_hash = pipeline_handler_clause_dispatch_key_typed(src, handler_clause_list_nth(clauses, 0), pipeline_lower_module_subst(module))
  let safe_outer = pipeline_handler_inline_ctx_out_of_line_safe(pipeline_lower_module_handlers(module))
  let body_handlers = pipeline_handler_inline_ctx_push_typed_src_safe(
    safe_outer,
    eff_hash,
    clauses,
    handler_clause_list_len(clauses),
    src,
    0,
    pipeline_lowered_handler_clauses_out_of_line_safe(lowered_clauses)
  )
  let body_module = pipeline_lower_module_with_handlers(module, body_handlers)
  let body_locals = pipeline_deferred_body_lowering_locals(captures)
  let lower_ctx = pipeline_handler_lower_ctx_from_module(0, body_locals, body_module)
  let result_ty = pipeline_return_expr_type_node_typed(body, fn_params, outer_locals, module)
  let result_lanes = pipeline_type_value_lane_count_or_one(result_ty)
  let lowered = pipeline_lower_expr_typed_hclause_blocks(body, first_value, lower_ctx, result_ty, 0)
  if pipeline_lowered_blocks_is_valid(lowered) == 0 {
    IrDeferredHandlerBodyInvalid(1)
  } else {
    IrDeferredHandlerBody(captures, ops_value, result_lanes, first_value, pipeline_lowered_blocks_blocks(lowered))
  }
}

fn pipeline_lower_handle_typed_to_target_blocks(body_expr: Expr, clauses: HandlerClauseList, hret: HandleReturn, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let nclauses = handler_clause_list_len(clauses)
  if nclauses <= 0 {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  } else {
    let handle_result_ty = match hret {
      NoHandleReturn -> pipeline_return_expr_type_node_typed(body_expr, params, locals, module)
      HandleReturnClause(rns, rnl, rb) -> pipeline_return_expr_type_node_typed(rb, params, locals, module)
    }
    let lowered_clauses = pipeline_lower_handler_clauses_typed(clauses, params, locals, module, handle_result_ty)
    let clause_bodies = pipeline_lowered_handler_clauses_bodies(lowered_clauses)
    if pipeline_handler_clause_list_has_continuation_handler_typed(clauses) == 1 {
      if pipeline_handle_return_is_present(hret) == 1 {
        pipeline_lowered_blocks_invalid(start_block, next_value)
      } else {
      let body_ty = pipeline_return_expr_type_node_typed(body_expr, params, locals, module)
      let result_lanes = pipeline_type_value_lane_count_or_one(body_ty)
      let dst = next_value
      let scratch_base = dst + result_lanes
      let lowered_body = pipeline_lower_deferred_handler_body_typed(body_expr, clauses, lowered_clauses, params, locals, module)
      let eff_hash = pipeline_handler_clause_dispatch_key_typed(src, handler_clause_list_nth(clauses, 0), pipeline_lower_module_subst(module))
      let insts = ir_inst_list_append(
        ir_inst_list_prepend(ir_inst_deferred_handle_i64(dst, src, lowered_body, clause_bodies, nclauses, eff_hash, scratch_base), ir_inst_list_empty()),
        pipeline_ir_call_result_lane_insts(dst, body_ty)
      )
      let args = pipeline_ir_value_lane_ids(dst, 0, result_lanes)
      let block = ir_block_new_term(start_block, insts, ir_term_jump_args(target_block, args))
      pipeline_lowered_blocks(next_block, scratch_base + pipeline_ir_native_deferred_handle_scratch_count(), ir_block_list_prepend(block, ir_block_list_empty()), 1)
      }
    } else {
    let eff_hash = pipeline_handler_clause_dispatch_key_typed(src, handler_clause_list_nth(clauses, 0), pipeline_lower_module_subst(module))
    let next_handlers = pipeline_handler_inline_ctx_push_typed_src_safe(
      pipeline_lower_module_handlers(module),
      eff_hash,
      clauses,
      nclauses,
      src,
      1,
      pipeline_lowered_handler_clauses_out_of_line_safe(lowered_clauses)
    )
    let body_module = pipeline_lower_module_with_handlers(module, next_handlers)
    let body_ty = pipeline_return_expr_type_node_typed(body_expr, params, locals, body_module)
    let body_lanes = pipeline_type_value_lane_count_or_one(body_ty)
    let has_abortive = handler_clause_list_has_abortive(clauses)
    let pop_block = next_block
    let abort_block = if has_abortive == 1 { next_block + 1 } else { 0 - 1 }
    let body_start = if has_abortive == 1 { next_block + 2 } else { next_block + 1 }
    let body_next_block = if has_abortive == 1 { next_block + 3 } else { next_block + 2 }
    let marker = ir_inst_list_prepend(IrHandleI64(0 - 1, src, eff_hash, clause_bodies, nclauses, abort_block), ir_inst_list_empty())
    if pipeline_expr_needs_lowering_cfg_typed(body_expr, src) == 1 or has_abortive == 1 {
      let body_blocks = pipeline_lower_expr_typed_to_target_blocks_reserved(body_expr, params, locals, body_module, next_value, body_start, body_next_block, pop_block)
      if pipeline_lowered_blocks_is_valid(body_blocks) == 1 {
        if pipeline_lowered_blocks_falls_through(body_blocks) == 1 {
          let body_value = pipeline_lowered_blocks_next_value(body_blocks)
          let abort_value = body_value + body_lanes
          let pop_params = pipeline_ir_value_lane_ids(body_value, 0, body_lanes)
          let pop_insts = ir_inst_list_prepend(ir_inst_handler_pop_i64(0 - 1), ir_inst_list_empty())
          let abort_tail = if has_abortive == 1 {
            let abort_insts = ir_inst_list_append(ir_inst_list_prepend(ir_inst_abort_landing_i64(abort_value), ir_inst_list_empty()), pipeline_ir_call_result_lane_insts(abort_value, body_ty))
            let abort_args = pipeline_ir_value_lane_ids(abort_value, 0, body_lanes)
            ir_block_list_prepend(ir_block_new_term(abort_block, abort_insts, ir_term_jump_args(target_block, abort_args)), ir_block_list_empty())
          } else { ir_block_list_empty() }
          let entry = ir_block_new_term(start_block, marker, ir_term_jump(body_start))
          match hret {
            NoHandleReturn -> {
              let pop_args = pipeline_ir_value_lane_ids(body_value, 0, body_lanes)
              let pop = ir_block_new_params(pop_block, pop_params, pop_insts, ir_term_jump_args(target_block, pop_args))
              let blocks = ir_block_list_prepend(
                entry,
                ir_block_list_append(pipeline_lowered_blocks_blocks(body_blocks), ir_block_list_prepend(pop, abort_tail))
              )
              pipeline_lowered_blocks(pipeline_lowered_blocks_next_block(body_blocks), body_value + body_lanes + has_abortive * body_lanes, blocks, 1)
            }
            HandleReturnClause(rns, rnl, rb) -> {
              -- 4c §7.3: transform the completion value. Runs OUTSIDE the
              -- handler scope (after handler_pop, module without the pushed
              -- handler ctx) with the binder bound to the completion value.
              -- Sound because return-clause handlers require all op clauses
              -- to resume (typeck fence): every value reaching pop_block is
              -- genuine completion.
              let ret_start = pipeline_lowered_blocks_next_block(body_blocks)
              let ret_locals = pipeline_value_env_push_float_typed_node(locals, rns, rnl, body_value, pipeline_type_node_prim_id_or(body_ty, 0), if body_ty == 0 { 0 } else { type_hash_of(body_ty) }, body_ty)
              let ret_blocks = pipeline_lower_expr_typed_to_target_blocks_reserved(rb, params, ret_locals, module, body_value + body_lanes + has_abortive * body_lanes, ret_start, ret_start + 1, target_block)
              if pipeline_lowered_blocks_is_valid(ret_blocks) == 1 {
                let pop = ir_block_new_params(pop_block, pop_params, pop_insts, ir_term_jump(ret_start))
                let blocks = ir_block_list_prepend(
                  entry,
                  ir_block_list_append(pipeline_lowered_blocks_blocks(body_blocks),
                    ir_block_list_prepend(pop, ir_block_list_append(pipeline_lowered_blocks_blocks(ret_blocks), abort_tail)))
                )
                pipeline_lowered_blocks(pipeline_lowered_blocks_next_block(ret_blocks), pipeline_lowered_blocks_next_value(ret_blocks), blocks, 1)
              } else {
                pipeline_lowered_blocks_invalid(start_block, next_value)
              }
            }
          }
        } else {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        }
      } else {
        pipeline_lowered_blocks_invalid(start_block, next_value)
      }
    } else {
      let lower_ctx = pipeline_handler_lower_ctx_from_module(params, locals, body_module)
      let call_inline = pipeline_lower_handle_body_call_inline_nodes(expr_to_node(body_expr), eff_hash, next_handlers, lower_ctx, next_value)
      let body = if ir_lowered_expr_is_valid(call_inline) == 1 { call_inline } else { pipeline_lower_expr_typed_sidecar_handler_ctx(body_expr, next_value, lower_ctx) }
      if ir_lowered_expr_is_valid(body) == 1 {
        let insts = if pipeline_ir_insts_handle_frame_free(ir_lowered_expr_insts(body)) == 1 {
          ir_lowered_expr_insts(body)
        } else {
          pipeline_ir_handle_inst_list_typed(src, eff_hash, clause_bodies, nclauses, ir_lowered_expr_insts(body))
        }
        match hret {
          NoHandleReturn -> {
            let args = pipeline_ir_value_lane_ids(ir_lowered_expr_value(body), 0, body_lanes)
            let block = ir_block_new_term(start_block, insts, ir_term_jump_args(target_block, args))
            let blocks = ir_block_list_prepend(block, ir_block_list_empty())
            pipeline_lowered_blocks(next_block, ir_lowered_expr_next_value(body), blocks, 1)
          }
          HandleReturnClause(rns, rnl, rb) -> {
            -- 4c §7.3: completion transform after the popped frame.
            let ret_locals = pipeline_value_env_push_float_typed_node(locals, rns, rnl, ir_lowered_expr_value(body), pipeline_type_node_prim_id_or(body_ty, 0), if body_ty == 0 { 0 } else { type_hash_of(body_ty) }, body_ty)
            let ret_ctx = pipeline_handler_lower_ctx_from_module(params, ret_locals, module)
            let ret = pipeline_lower_expr_typed_sidecar_handler_ctx(rb, ir_lowered_expr_next_value(body), ret_ctx)
            if ir_lowered_expr_is_valid(ret) == 1 {
              let all_insts = ir_inst_list_append(insts, ir_lowered_expr_insts(ret))
              let ret_ty = pipeline_return_expr_type_node_typed(rb, params, ret_locals, module)
              let args = pipeline_ir_value_lane_ids(ir_lowered_expr_value(ret), 0, pipeline_type_value_lane_count_or_one(ret_ty))
              let block = ir_block_new_term(start_block, all_insts, ir_term_jump_args(target_block, args))
              let blocks = ir_block_list_prepend(block, ir_block_list_empty())
              pipeline_lowered_blocks(next_block, ir_lowered_expr_next_value(ret), blocks, 1)
            } else {
              pipeline_lowered_blocks_invalid(start_block, next_value)
            }
          }
        }
      } else {
        pipeline_lowered_blocks_invalid(start_block, next_value)
      }
    }
    }
  }
}

fn pipeline_lower_straight_expr_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let lowered = pipeline_lower_expr_node_with_module_ctx(expr, params, locals, module, next_value)
  if ir_lowered_expr_is_valid(lowered) == 1 {
    let args = pipeline_ir_value_lane_ids(ir_lowered_expr_value(lowered), 0, pipeline_expr_node_value_lane_count(expr, params, locals, module))
    let block = ir_block_new_term(start_block, ir_lowered_expr_insts(lowered), ir_term_jump_args(target_block, args))
    let blocks = ir_block_list_prepend(block, ir_block_list_empty())
    pipeline_lowered_blocks(next_block, ir_lowered_expr_next_value(lowered), blocks, 1)
  } else {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  }
}

fn pipeline_lower_straight_expr_to_control_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let lowered = pipeline_lower_expr_node_with_module_ctx(expr, params, locals, module, next_value)
  if ir_lowered_expr_is_valid(lowered) == 1 {
    let block = ir_block_new_term(start_block, ir_lowered_expr_insts(lowered), ir_term_jump(target_block))
    let blocks = ir_block_list_prepend(block, ir_block_list_empty())
    pipeline_lowered_blocks(next_block, ir_lowered_expr_next_value(lowered), blocks, 1)
  } else {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  }
}

-- Node twin of the typed discard-release classifier.
fn pipeline_discard_release_type_node(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> i64 {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let ty = pipeline_return_expr_type_node_from_node(expr, params, locals, module)
  let is_owned = if pipeline_expr_node_owned_rvalue_temp_typed(expr, src, tt) == 1 { 1 }
    else { pipeline_expr_node_owned_array_value_typed(expr, ty, src, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module), tt) }
  if is_owned == 0 { 0 }
  else {
    if ty != 0 and ty_value_has_release_lane(ty) == 1 { ty } else { 0 }
  }
}

fn pipeline_lower_expr_to_control_target_blocks_reserved(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  if pipeline_expr_needs_cfg(expr) == 1 {
    let discard_block = pipeline_lower_internal_block_after_target(next_block, target_block)
    let value_next_block = pipeline_lower_internal_block_after_target(discard_block + 1, target_block)
    let value_blocks = pipeline_lower_expr_to_target_blocks_reserved(expr, params, locals, module, next_value, start_block, value_next_block, discard_block)
    if pipeline_lowered_blocks_is_valid(value_blocks) == 1 {
      if pipeline_lowered_blocks_falls_through(value_blocks) == 0 {
        value_blocks
      } else {
        let discard_value = pipeline_lowered_blocks_next_value(value_blocks)
        let discard_lanes = pipeline_expr_node_value_lane_count(expr, params, locals, module)
        let discard_ty = pipeline_discard_release_type_node(expr, params, locals, module)
        let release_insts = if discard_ty != 0 { pipeline_managed_release_inst_list(discard_value, discard_ty, discard_value + discard_lanes) } else { ir_inst_list_empty() }
        let after_discard = discard_value + discard_lanes + ir_inst_list_len(release_insts)
        let discard_params = pipeline_ir_value_lane_ids(discard_value, 0, discard_lanes)
        let discard_merge = ir_block_new_params(discard_block, discard_params, release_insts, ir_term_jump(target_block))
        let blocks = ir_block_list_append(
          pipeline_lowered_blocks_blocks(value_blocks),
          ir_block_list_prepend(discard_merge, ir_block_list_empty())
        )
        pipeline_lowered_blocks_control(pipeline_lowered_blocks_next_block(value_blocks), after_discard, blocks, 1, 1)
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  } else {
    pipeline_lower_straight_expr_to_control_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
  }
}

fn pipeline_lower_expr_to_target_blocks_reserved(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let tag = node_tag(expr)
  match tag {
    5 -> pipeline_lower_if_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
    15 -> pipeline_lower_match_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
    25 -> pipeline_lower_return_to_blocks(expr, params, locals, module, next_value, start_block, next_block)
    10 -> pipeline_lower_while_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
    47 -> pipeline_lower_for_iter_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
    49 -> pipeline_lower_loop_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
    3 -> {
      if pipeline_expr_needs_cfg(expr) == 1 {
        pipeline_lower_binop_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      } else {
        pipeline_lower_straight_expr_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      }
    }
    22 -> {
      if pipeline_expr_needs_cfg(expr) == 1 {
        pipeline_lower_not_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      } else {
        pipeline_lower_straight_expr_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      }
    }
    45 -> {
      if pipeline_expr_needs_cfg(expr) == 1 {
        pipeline_lower_try_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      } else {
        pipeline_lower_straight_expr_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      }
    }
    4 -> {
      if pipeline_call_args_have_cfg(node_f3(expr), node_f4(expr), 0) == 1 {
        pipeline_lower_call_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      } else {
        pipeline_lower_straight_expr_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      }
    }
    32 -> {
      if pipeline_expr_needs_cfg(expr) == 1 {
        pipeline_lower_perform_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      } else {
        pipeline_lower_straight_expr_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      }
    }
    33 -> pipeline_lower_handle_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
    36 -> {
      if pipeline_expr_needs_cfg(expr) == 1 {
        pipeline_lower_generic_call_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      } else {
        pipeline_lower_straight_expr_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      }
    }
    41 -> {
      if pipeline_expr_needs_cfg(expr) == 1 {
        pipeline_lower_method_call_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      } else {
        pipeline_lower_straight_expr_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      }
    }
    13 -> {
      if pipeline_expr_needs_cfg(expr) == 1 {
        pipeline_lower_field_access_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      } else {
        pipeline_lower_straight_expr_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      }
    }
    59 -> pipeline_lower_indexed_len_typed_to_target_blocks(expr_from_node(node_f1(expr)), node_f2(expr), params, locals, module, next_value, start_block, next_block, target_block)
    60 -> pipeline_lower_indexed_get_typed_to_target_blocks(expr_from_node(node_f1(expr)), expr_from_node(node_f2(expr)), node_f3(expr), node_f4(expr), params, locals, module, next_value, start_block, next_block, target_block)
    61 -> pipeline_lower_indexed_set_typed_to_target_blocks(expr_from_node(node_f1(expr)), expr_from_node(node_f2(expr)), expr_from_node(node_f3(expr)), node_f4(expr), params, locals, module, next_value, start_block, next_block, target_block)
    62 -> pipeline_lower_indexed_slice_typed_to_target_blocks(expr_from_node(node_f1(expr)), expr_from_node(node_f2(expr)), expr_from_node(node_f3(expr)), node_f4(expr), params, locals, module, next_value, start_block, next_block, target_block)
    48 -> {
      if pipeline_expr_needs_cfg(expr) == 1 {
        pipeline_lower_opt_chain_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      } else {
        pipeline_lower_straight_expr_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      }
    }
    14 -> {
      if pipeline_expr_needs_cfg(expr) == 1 {
        pipeline_lower_record_init_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      } else {
        pipeline_lower_straight_expr_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      }
    }
    58 -> pipeline_lower_array_literal_typed_to_target_blocks(expr_list_from_nodes(node_f1(expr), 0, node_f2(expr)), node_f3(expr), params, locals, module, next_value, start_block, next_block, target_block)
    6 -> {
      if pipeline_expr_needs_cfg(expr) == 1 {
        pipeline_lower_let_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      } else {
        pipeline_lower_straight_expr_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      }
    }
    11 -> {
      if pipeline_expr_needs_cfg(expr) == 1 {
        pipeline_lower_let_mut_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      } else {
        pipeline_lower_straight_expr_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      }
    }
    12 -> {
      if pipeline_expr_needs_cfg(expr) == 1 {
        pipeline_lower_assign_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      } else {
        pipeline_lower_straight_expr_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      }
    }
    7 -> {
      if pipeline_expr_needs_cfg(expr) == 1 {
        pipeline_lower_block_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      } else {
        pipeline_lower_straight_expr_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      }
    }
    37 -> pipeline_lower_expr_typed_to_target_blocks_reserved(expr_from_node(expr), params, locals, module, next_value, start_block, next_block, target_block)
    52 -> pipeline_lower_defer_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
    _ -> pipeline_lower_straight_expr_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
  }
}

fn pipeline_lower_expr_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let next_block = if target_block == start_block + 1 { start_block + 2 } else { start_block + 1 }
  pipeline_lower_expr_to_target_blocks_reserved(expr, params, locals, module, next_value, start_block, next_block, target_block)
}

fn pipeline_lower_return_to_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64) -> PipelineLoweredBlocks {
  let value_expr = node_f1(expr)
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  if pipeline_expr_needs_cfg(value_expr) == 1 {
    let return_block = next_block
    let value_blocks = pipeline_lower_expr_to_target_blocks_reserved(value_expr, params, locals, module, next_value, start_block, next_block + 1, return_block)
    if pipeline_lowered_blocks_is_valid(value_blocks) == 1 {
      if pipeline_lowered_blocks_falls_through(value_blocks) == 0 {
        value_blocks
      } else {
        let return_value = pipeline_lowered_blocks_next_value(value_blocks)
        let return_lanes = pipeline_expr_node_value_lane_count(value_expr, params, locals, module)
        let return_params = pipeline_ir_value_lane_ids(return_value, 0, return_lanes)
        let transfer = pipeline_lower_return_transfer_from_node(value_expr, return_value, return_value + return_lanes, params, locals, module)
        let return_node = ir_block_new_params(return_block, return_params, ir_lowered_expr_insts(transfer), ir_term_return(ir_lowered_expr_value(transfer)))
        let blocks = ir_block_list_append(
          pipeline_lowered_blocks_blocks(value_blocks),
          ir_block_list_prepend(return_node, ir_block_list_empty())
        )
        pipeline_lowered_blocks_control(pipeline_lowered_blocks_next_block(value_blocks), ir_lowered_expr_next_value(transfer), blocks, 1, 0)
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  } else {
    let lower_ctx = pipeline_handler_lower_ctx_from_module(params, locals, module)
    let value = pipeline_lower_expr_node_typed_sidecar_handler_ctx(value_expr, next_value, lower_ctx)
    if ir_lowered_expr_is_valid(value) == 1 {
      let transfer = pipeline_lower_return_transfer_from_node(value_expr, ir_lowered_expr_value(value), ir_lowered_expr_next_value(value), params, locals, module)
      let block = ir_block_new_term(start_block, ir_inst_list_append(ir_lowered_expr_insts(value), ir_lowered_expr_insts(transfer)), ir_term_return(ir_lowered_expr_value(transfer)))
      let blocks = ir_block_list_prepend(block, ir_block_list_empty())
      pipeline_lowered_blocks_control(next_block, ir_lowered_expr_next_value(transfer), blocks, 1, 0)
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  }
}

fn pipeline_lower_defer_cleanup_jump_block_with_after(cleanup_expr: i64, carried_value: i64, carried_lanes: i64, after_insts: IrInstList, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, cleanup_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  if pipeline_expr_needs_cfg(cleanup_expr) == 1 {
    pipeline_lowered_blocks_invalid(cleanup_block, next_value)
  } else {
    let cleanup = pipeline_lower_expr_node_with_module_ctx(cleanup_expr, params, locals, module, next_value)
    if ir_lowered_expr_is_valid(cleanup) == 1 {
      let block_params = pipeline_ir_value_lane_ids(carried_value, 0, carried_lanes)
      let target_args = pipeline_ir_value_lane_ids(carried_value, 0, carried_lanes)
      let insts = ir_inst_list_append(ir_lowered_expr_insts(cleanup), after_insts)
      let block = ir_block_new_params(cleanup_block, block_params, insts, ir_term_jump_args(target_block, target_args))
      pipeline_lowered_blocks(next_block, ir_lowered_expr_next_value(cleanup), ir_block_list_prepend(block, ir_block_list_empty()), 1)
    } else {
      pipeline_lowered_blocks_invalid(cleanup_block, next_value)
    }
  }
}

fn pipeline_lower_defer_cleanup_jump_block(cleanup_expr: i64, carried_value: i64, carried_lanes: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, cleanup_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  pipeline_lower_defer_cleanup_jump_block_with_after(cleanup_expr, carried_value, carried_lanes, ir_inst_list_empty(), params, locals, module, next_value, cleanup_block, next_block, target_block)
}

fn pipeline_lower_defer_cleanup_return_block(cleanup_expr: i64, carried_value: i64, carried_lanes: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, cleanup_block: i64, next_block: i64) -> PipelineLoweredBlocks {
  if pipeline_expr_needs_cfg(cleanup_expr) == 1 {
    pipeline_lowered_blocks_invalid(cleanup_block, next_value)
  } else {
    let cleanup = pipeline_lower_expr_node_with_module_ctx(cleanup_expr, params, locals, module, next_value)
    if ir_lowered_expr_is_valid(cleanup) == 1 {
      let block_params = pipeline_ir_value_lane_ids(carried_value, 0, carried_lanes)
      let block = ir_block_new_params(cleanup_block, block_params, ir_lowered_expr_insts(cleanup), ir_term_return(carried_value))
      pipeline_lowered_blocks_control(next_block, ir_lowered_expr_next_value(cleanup), ir_block_list_prepend(block, ir_block_list_empty()), 1, 0)
    } else {
      pipeline_lowered_blocks_invalid(cleanup_block, next_value)
    }
  }
}

fn pipeline_lower_defer_return_to_blocks(cleanup_expr: i64, return_expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64) -> PipelineLoweredBlocks {
  let value_expr = node_f1(return_expr)
  if pipeline_expr_needs_cfg(value_expr) == 1 {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  } else {
    let value = pipeline_lower_expr_node_with_module_ctx(value_expr, params, locals, module, next_value)
    if ir_lowered_expr_is_valid(value) == 1 {
      let cleanup_block = next_block
      let carried_value = ir_lowered_expr_next_value(value)
      let carried_lanes = pipeline_expr_node_value_lane_count(value_expr, params, locals, module)
      let entry = ir_block_new_term(start_block, ir_lowered_expr_insts(value), ir_term_jump_args(cleanup_block, pipeline_ir_value_lane_ids(ir_lowered_expr_value(value), 0, carried_lanes)))
      let cleanup = pipeline_lower_defer_cleanup_return_block(cleanup_expr, carried_value, carried_lanes, params, locals, module, carried_value + carried_lanes, cleanup_block, next_block + 1)
      if pipeline_lowered_blocks_is_valid(cleanup) == 1 {
        let blocks = ir_block_list_prepend(entry, pipeline_lowered_blocks_blocks(cleanup))
        pipeline_lowered_blocks_control(pipeline_lowered_blocks_next_block(cleanup), pipeline_lowered_blocks_next_value(cleanup), blocks, 1, 0)
      } else {
        pipeline_lowered_blocks_invalid(start_block, next_value)
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  }
}

fn pipeline_lower_defer_if_to_target_blocks(cleanup_expr: i64, body_expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let cond_expr = node_f1(body_expr)
  let then_expr = node_f2(body_expr)
  let else_expr = node_f3(body_expr)
  let cond = pipeline_lower_expr_node_with_module_ctx(cond_expr, params, locals, module, next_value)
  if ir_lowered_expr_is_valid(cond) == 1 {
    let then_start = next_block
    let then_blocks = pipeline_lower_defer_to_target_blocks(node_new(52, cleanup_expr, then_expr, 0, 0), params, locals, module, ir_lowered_expr_next_value(cond), then_start, then_start + 1, target_block)
    if pipeline_lowered_blocks_is_valid(then_blocks) == 1 {
      let else_start = pipeline_lowered_blocks_next_block(then_blocks)
      let else_blocks = pipeline_lower_defer_to_target_blocks(node_new(52, cleanup_expr, else_expr, 0, 0), params, locals, module, pipeline_lowered_blocks_next_value(then_blocks), else_start, else_start + 1, target_block)
      if pipeline_lowered_blocks_is_valid(else_blocks) == 1 {
        let entry = ir_block_new_term(start_block, ir_lowered_expr_insts(cond), ir_term_branch(ir_lowered_expr_value(cond), then_start, else_start))
        let blocks = ir_block_list_prepend(entry, ir_block_list_append(pipeline_lowered_blocks_blocks(then_blocks), pipeline_lowered_blocks_blocks(else_blocks)))
        let falls = pipeline_bool_or(pipeline_lowered_blocks_falls_through(then_blocks), pipeline_lowered_blocks_falls_through(else_blocks))
        pipeline_lowered_blocks_control(pipeline_lowered_blocks_next_block(else_blocks), pipeline_lowered_blocks_next_value(else_blocks), blocks, 1, falls)
      } else {
        pipeline_lowered_blocks_invalid(start_block, next_value)
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  } else {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  }
}

fn pipeline_lower_defer_owned_let_to_target_blocks(cleanup_expr: i64, body_expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let inner = node_f1(body_expr)
  let ann_ty = node_f2(body_expr)
  let type_hash = cg_owned_drop_type_hash(ann_ty)
  if node_tag(inner) != 6 or type_hash == 0 {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  } else {
    let init_expr = node_f3(inner)
    let tail_expr = node_f4(inner)
    if pipeline_expr_needs_cfg(init_expr) == 1 {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    } else {
      let init = pipeline_lower_expr_node_with_module_ctx(init_expr, params, locals, module, next_value)
      if ir_lowered_expr_is_valid(init) == 1 {
        let cleanup_block = next_block
        let body_start = next_block + 1
        let owned_value = ir_lowered_expr_value(init)
        let float_prim = pipeline_expr_float_prim_node_temp(init_expr, params, locals, src, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module))
        let local_type_hash = pipeline_expr_type_hash_node_temp(init_expr, params, locals, src, tt, pipeline_lower_module_fns(module), 0)
        let next_locals = pipeline_value_env_push_float_typed(locals, node_f1(inner), node_f2(inner), owned_value, float_prim, local_type_hash)
        let body_blocks = pipeline_lower_expr_to_target_blocks_reserved(tail_expr, params, next_locals, module, ir_lowered_expr_next_value(init), body_start, body_start + 1, cleanup_block)
        if pipeline_lowered_blocks_is_valid(body_blocks) == 1 {
          if pipeline_lowered_blocks_falls_through(body_blocks) == 0 {
            let entry = ir_block_new_term(start_block, ir_lowered_expr_insts(init), ir_term_jump(body_start))
            pipeline_lowered_blocks_control(
              pipeline_lowered_blocks_next_block(body_blocks),
              pipeline_lowered_blocks_next_value(body_blocks),
              ir_block_list_prepend(entry, pipeline_lowered_blocks_blocks(body_blocks)),
              1,
              0
            )
          } else {
            let carried_value = pipeline_lowered_blocks_next_value(body_blocks)
            let carried_lanes = pipeline_expr_node_value_lane_count(tail_expr, params, next_locals, module)
            let drop_insts = if pipeline_expr_refs_name(tail_expr, src, node_f1(inner), node_f2(inner)) == 0 {
              ir_inst_list_prepend(ir_inst_owned_drop_i64(owned_value, type_hash), ir_inst_list_empty())
            } else {
              ir_inst_list_empty()
            }
            let cleanup = pipeline_lower_defer_cleanup_jump_block_with_after(cleanup_expr, carried_value, carried_lanes, drop_insts, params, locals, module, carried_value + carried_lanes, cleanup_block, pipeline_lowered_blocks_next_block(body_blocks), target_block)
            if pipeline_lowered_blocks_is_valid(cleanup) == 1 {
              let entry = ir_block_new_term(start_block, ir_lowered_expr_insts(init), ir_term_jump(body_start))
              let blocks = ir_block_list_prepend(entry, ir_block_list_append(pipeline_lowered_blocks_blocks(body_blocks), pipeline_lowered_blocks_blocks(cleanup)))
              pipeline_lowered_blocks_control(pipeline_lowered_blocks_next_block(cleanup), pipeline_lowered_blocks_next_value(cleanup), blocks, 1, 1)
            } else {
              pipeline_lowered_blocks_invalid(start_block, next_value)
            }
          }
        } else {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        }
      } else {
        pipeline_lowered_blocks_invalid(start_block, next_value)
      }
    }
  }
}

fn pipeline_lower_defer_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let cleanup_expr = node_f1(expr)
  let body_expr = node_f2(expr)
  let body_tag = node_tag(body_expr)
  if body_tag == 25 {
    pipeline_lower_defer_return_to_blocks(cleanup_expr, body_expr, params, locals, module, next_value, start_block, next_block)
  } else { if body_tag == 5 {
    pipeline_lower_defer_if_to_target_blocks(cleanup_expr, body_expr, params, locals, module, next_value, start_block, next_block, target_block)
  } else { if body_tag == 37 and node_tag(node_f1(body_expr)) == 6 and cg_owned_drop_type_hash(node_f2(body_expr)) != 0 {
    pipeline_lower_defer_owned_let_to_target_blocks(cleanup_expr, body_expr, params, locals, module, next_value, start_block, next_block, target_block)
  } else {
    let cleanup_block = next_block
    let body_blocks = pipeline_lower_expr_to_target_blocks_reserved(body_expr, params, locals, module, next_value, start_block, next_block + 1, cleanup_block)
    if pipeline_lowered_blocks_is_valid(body_blocks) == 1 {
      if pipeline_lowered_blocks_falls_through(body_blocks) == 0 {
        body_blocks
      } else {
        let carried_value = pipeline_lowered_blocks_next_value(body_blocks)
        let carried_lanes = pipeline_expr_node_value_lane_count(body_expr, params, locals, module)
        let cleanup = pipeline_lower_defer_cleanup_jump_block(cleanup_expr, carried_value, carried_lanes, params, locals, module, carried_value + carried_lanes, cleanup_block, pipeline_lowered_blocks_next_block(body_blocks), target_block)
        if pipeline_lowered_blocks_is_valid(cleanup) == 1 {
          let blocks = ir_block_list_append(pipeline_lowered_blocks_blocks(body_blocks), pipeline_lowered_blocks_blocks(cleanup))
          pipeline_lowered_blocks_control(pipeline_lowered_blocks_next_block(cleanup), pipeline_lowered_blocks_next_value(cleanup), blocks, 1, 1)
        } else {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        }
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  } } }
}

fn pipeline_lower_break_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredLoopBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let value_expr = node_f1(expr)
  if value_expr == 0 {
    let value = next_value
    let insts = ir_inst_list_prepend(ir_inst_const_i64(value, 0), ir_inst_list_empty())
    let args = ir_value_list_prepend(value, ir_value_list_empty())
    let block = ir_block_new_term(start_block, insts, ir_term_jump_args(target_block, args))
    let blocks = ir_block_list_prepend(block, ir_block_list_empty())
    pipeline_lowered_loop_blocks(next_block, value + 1, blocks, 1, 1, 0)
  } else {
    if pipeline_expr_needs_cfg(value_expr) == 1 {
      let break_block = next_block
      let value_blocks = pipeline_lower_expr_to_target_blocks_reserved(value_expr, params, locals, module, next_value, start_block, next_block + 1, break_block)
      if pipeline_lowered_blocks_is_valid(value_blocks) == 1 {
        if pipeline_lowered_blocks_falls_through(value_blocks) == 0 {
          pipeline_lowered_loop_blocks_from_expr(value_blocks, 0, 0)
        } else {
          let exit_value = pipeline_lowered_blocks_next_value(value_blocks)
          let exit_params = ir_value_list_prepend(exit_value, ir_value_list_empty())
          let exit_args = ir_value_list_prepend(exit_value, ir_value_list_empty())
          let exit_node = ir_block_new_params(break_block, exit_params, ir_inst_list_empty(), ir_term_jump_args(target_block, exit_args))
          let blocks = ir_block_list_append(
            pipeline_lowered_blocks_blocks(value_blocks),
            ir_block_list_prepend(exit_node, ir_block_list_empty())
          )
          pipeline_lowered_loop_blocks(pipeline_lowered_blocks_next_block(value_blocks), exit_value + 1, blocks, 1, 1, 0)
        }
      } else {
        pipeline_lowered_loop_blocks_invalid(start_block, next_value)
      }
    } else {
      let lower_ctx = pipeline_handler_lower_ctx_from_module(params, locals, module)
      let value = pipeline_lower_expr_node_typed_sidecar_handler_ctx(value_expr, next_value, lower_ctx)
      if ir_lowered_expr_is_valid(value) == 1 {
        let args = ir_value_list_prepend(ir_lowered_expr_value(value), ir_value_list_empty())
        let block = ir_block_new_term(start_block, ir_lowered_expr_insts(value), ir_term_jump_args(target_block, args))
        let blocks = ir_block_list_prepend(block, ir_block_list_empty())
        pipeline_lowered_loop_blocks(next_block, ir_lowered_expr_next_value(value), blocks, 1, 1, 0)
      } else {
        pipeline_lowered_loop_blocks_invalid(start_block, next_value)
      }
    }
  }
}

fn pipeline_lower_nil_break_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredLoopBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let value_expr = node_f1(expr)
  if value_expr == 0 {
    let nil_value = next_value
    let insts = ir_inst_list_prepend(ir_inst_const_i64(nil_value, 0), ir_inst_list_empty())
    let args = ir_value_list_prepend(nil_value, ir_value_list_empty())
    let block = ir_block_new_term(start_block, insts, ir_term_jump_args(target_block, args))
    let blocks = ir_block_list_prepend(block, ir_block_list_empty())
    pipeline_lowered_loop_blocks(next_block, nil_value + 1, blocks, 1, 1, 0)
  } else {
    if pipeline_expr_needs_cfg(value_expr) == 1 {
      let break_block = next_block
      let value_blocks = pipeline_lower_expr_to_target_blocks_reserved(value_expr, params, locals, module, next_value, start_block, next_block + 1, break_block)
      if pipeline_lowered_blocks_is_valid(value_blocks) == 1 {
        if pipeline_lowered_blocks_falls_through(value_blocks) == 0 {
          pipeline_lowered_loop_blocks_from_expr(value_blocks, 0, 0)
        } else {
          let break_value = pipeline_lowered_blocks_next_value(value_blocks)
          let nil_value = break_value + 1
          let break_params = ir_value_list_prepend(break_value, ir_value_list_empty())
          let break_args = ir_value_list_prepend(nil_value, ir_value_list_empty())
          let break_insts = ir_inst_list_prepend(ir_inst_const_i64(nil_value, 0), ir_inst_list_empty())
          let break_node = ir_block_new_params(break_block, break_params, break_insts, ir_term_jump_args(target_block, break_args))
          let blocks = ir_block_list_append(
            pipeline_lowered_blocks_blocks(value_blocks),
            ir_block_list_prepend(break_node, ir_block_list_empty())
          )
          pipeline_lowered_loop_blocks(pipeline_lowered_blocks_next_block(value_blocks), nil_value + 1, blocks, 1, 1, 0)
        }
      } else {
        pipeline_lowered_loop_blocks_invalid(start_block, next_value)
      }
    } else {
      let lower_ctx = pipeline_handler_lower_ctx_from_module(params, locals, module)
      let value = pipeline_lower_expr_node_typed_sidecar_handler_ctx(value_expr, next_value, lower_ctx)
      if ir_lowered_expr_is_valid(value) == 1 {
        let nil_value = ir_lowered_expr_next_value(value)
        let nil_inst = ir_inst_list_prepend(ir_inst_const_i64(nil_value, 0), ir_inst_list_empty())
        let args = ir_value_list_prepend(nil_value, ir_value_list_empty())
        let insts = ir_inst_list_append(ir_lowered_expr_insts(value), nil_inst)
        let block = ir_block_new_term(start_block, insts, ir_term_jump_args(target_block, args))
        let blocks = ir_block_list_prepend(block, ir_block_list_empty())
        pipeline_lowered_loop_blocks(next_block, nil_value + 1, blocks, 1, 1, 0)
      } else {
        pipeline_lowered_loop_blocks_invalid(start_block, next_value)
      }
    }
  }
}

fn pipeline_lower_continue_to_blocks(next_value: i64, start_block: i64, next_block: i64, continue_block: i64) -> PipelineLoweredLoopBlocks {
  let block = ir_block_new_term(start_block, ir_inst_list_empty(), ir_term_jump(continue_block))
  let blocks = ir_block_list_prepend(block, ir_block_list_empty())
  pipeline_lowered_loop_blocks(next_block, next_value, blocks, 1, 0, 0)
}

fn pipeline_lower_loop_defer_cleanup_term_block(cleanup_expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, term: IrTerminator, exits_loop: i64) -> PipelineLoweredLoopBlocks {
  if pipeline_expr_needs_cfg(cleanup_expr) == 1 {
    pipeline_lowered_loop_blocks_invalid(start_block, next_value)
  } else {
    let cleanup = pipeline_lower_expr_node_with_module_ctx(cleanup_expr, params, locals, module, next_value)
    if ir_lowered_expr_is_valid(cleanup) == 1 {
      let block = ir_block_new_term(start_block, ir_lowered_expr_insts(cleanup), term)
      pipeline_lowered_loop_blocks(next_block, ir_lowered_expr_next_value(cleanup), ir_block_list_prepend(block, ir_block_list_empty()), 1, exits_loop, 0)
    } else {
      pipeline_lowered_loop_blocks_invalid(start_block, next_value)
    }
  }
}

fn pipeline_lower_loop_defer_continue_to_blocks(cleanup_expr: i64, ctx: PipelineLoopCtx, next_value: i64, start_block: i64, next_block: i64) -> PipelineLoweredLoopBlocks {
  pipeline_lower_loop_defer_cleanup_term_block(
    cleanup_expr,
    pipeline_loop_ctx_params(ctx),
    pipeline_loop_ctx_locals(ctx),
    pipeline_loop_ctx_module(ctx),
    next_value,
    start_block,
    next_block,
    ir_term_jump(pipeline_loop_ctx_continue_block(ctx)),
    0
  )
}

fn pipeline_lower_loop_defer_break_to_blocks(cleanup_expr: i64, break_expr: i64, ctx: PipelineLoopCtx, next_value: i64, start_block: i64, next_block: i64) -> PipelineLoweredLoopBlocks {
  let params = pipeline_loop_ctx_params(ctx)
  let locals = pipeline_loop_ctx_locals(ctx)
  let module = pipeline_loop_ctx_module(ctx)
  let target_block = pipeline_loop_ctx_target_block(ctx)
  let value_expr = node_f1(break_expr)
  if value_expr == 0 {
    if pipeline_loop_ctx_break_mode(ctx) == 1 {
      let nil_value = next_value
      let cleanup_start = next_block
      let nil_block = ir_block_new_term(start_block, ir_inst_list_prepend(ir_inst_const_i64(nil_value, 0), ir_inst_list_empty()), ir_term_jump(cleanup_start))
      let term = ir_term_jump_args(target_block, ir_value_list_prepend(nil_value, ir_value_list_empty()))
      let cleanup = pipeline_lower_loop_defer_cleanup_term_block(cleanup_expr, params, locals, module, nil_value + 1, cleanup_start, next_block + 1, term, 1)
      if pipeline_lowered_loop_blocks_is_valid(cleanup) == 1 {
        pipeline_lowered_loop_blocks(
          pipeline_lowered_loop_blocks_next_block(cleanup),
          pipeline_lowered_loop_blocks_next_value(cleanup),
          ir_block_list_prepend(nil_block, pipeline_lowered_loop_blocks_blocks(cleanup)),
          1,
          1,
          0
        )
      } else {
        pipeline_lowered_loop_blocks_invalid(start_block, next_value)
      }
    } else {
      pipeline_lower_loop_defer_cleanup_term_block(cleanup_expr, params, locals, module, next_value, start_block, next_block, ir_term_jump(target_block), 1)
    }
  } else {
    if pipeline_expr_needs_cfg(value_expr) == 1 {
      pipeline_lowered_loop_blocks_invalid(start_block, next_value)
    } else {
      let value = pipeline_lower_expr_node_with_module_ctx(value_expr, params, locals, module, next_value)
      if ir_lowered_expr_is_valid(value) == 1 {
        let cleanup_start = next_block
        let entry = ir_block_new_term(start_block, ir_lowered_expr_insts(value), ir_term_jump(cleanup_start))
        let term = ir_term_jump_args(target_block, ir_value_list_prepend(ir_lowered_expr_value(value), ir_value_list_empty()))
        let cleanup = pipeline_lower_loop_defer_cleanup_term_block(cleanup_expr, params, locals, module, ir_lowered_expr_next_value(value), cleanup_start, next_block + 1, term, 1)
        if pipeline_lowered_loop_blocks_is_valid(cleanup) == 1 {
          pipeline_lowered_loop_blocks(
            pipeline_lowered_loop_blocks_next_block(cleanup),
            pipeline_lowered_loop_blocks_next_value(cleanup),
            ir_block_list_prepend(entry, pipeline_lowered_loop_blocks_blocks(cleanup)),
            1,
            1,
            0
          )
        } else {
          pipeline_lowered_loop_blocks_invalid(start_block, next_value)
        }
      } else {
        pipeline_lowered_loop_blocks_invalid(start_block, next_value)
      }
    }
  }
}

fn pipeline_lower_loop_defer_if_to_blocks(cleanup_expr: i64, body_expr: i64, ctx: PipelineLoopCtx, next_value: i64, start_block: i64, next_block: i64) -> PipelineLoweredLoopBlocks {
  let params = pipeline_loop_ctx_params(ctx)
  let locals = pipeline_loop_ctx_locals(ctx)
  let module = pipeline_loop_ctx_module(ctx)
  let cond_expr = node_f1(body_expr)
  let then_expr = node_f2(body_expr)
  let else_expr = node_f3(body_expr)
  let cond = pipeline_lower_expr_node_with_module_ctx(cond_expr, params, locals, module, next_value)
  if ir_lowered_expr_is_valid(cond) == 1 {
    let then_start = next_block
    let then_blocks = pipeline_lower_loop_defer_to_target_blocks(node_new(52, cleanup_expr, then_expr, 0, 0), ctx, ir_lowered_expr_next_value(cond), then_start, then_start + 1)
    if pipeline_lowered_loop_blocks_is_valid(then_blocks) == 1 {
      let else_start = pipeline_lowered_loop_blocks_next_block(then_blocks)
      let else_blocks = pipeline_lower_loop_defer_to_target_blocks(node_new(52, cleanup_expr, else_expr, 0, 0), ctx, pipeline_lowered_loop_blocks_next_value(then_blocks), else_start, else_start + 1)
      if pipeline_lowered_loop_blocks_is_valid(else_blocks) == 1 {
        let entry = ir_block_new_term(start_block, ir_lowered_expr_insts(cond), ir_term_branch(ir_lowered_expr_value(cond), then_start, else_start))
        let blocks = ir_block_list_prepend(entry, ir_block_list_append(pipeline_lowered_loop_blocks_blocks(then_blocks), pipeline_lowered_loop_blocks_blocks(else_blocks)))
        let exits = pipeline_bool_or(pipeline_lowered_loop_blocks_exits_loop(then_blocks), pipeline_lowered_loop_blocks_exits_loop(else_blocks))
        let continues = pipeline_bool_or(pipeline_lowered_loop_blocks_continues_body(then_blocks), pipeline_lowered_loop_blocks_continues_body(else_blocks))
        pipeline_lowered_loop_blocks(pipeline_lowered_loop_blocks_next_block(else_blocks), pipeline_lowered_loop_blocks_next_value(else_blocks), blocks, 1, exits, continues)
      } else {
        pipeline_lowered_loop_blocks_invalid(start_block, next_value)
      }
    } else {
      pipeline_lowered_loop_blocks_invalid(start_block, next_value)
    }
  } else {
    pipeline_lowered_loop_blocks_invalid(start_block, next_value)
  }
}

fn pipeline_lower_loop_defer_normal_cleanup_block(cleanup_expr: i64, carried_value: i64, ctx: PipelineLoopCtx, next_value: i64, cleanup_block: i64, next_block: i64) -> PipelineLoweredLoopBlocks {
  let params = pipeline_loop_ctx_params(ctx)
  let locals = pipeline_loop_ctx_locals(ctx)
  let module = pipeline_loop_ctx_module(ctx)
  if pipeline_expr_needs_cfg(cleanup_expr) == 1 {
    pipeline_lowered_loop_blocks_invalid(cleanup_block, next_value)
  } else {
    let cleanup = pipeline_lower_expr_node_with_module_ctx(cleanup_expr, params, locals, module, next_value)
    if ir_lowered_expr_is_valid(cleanup) == 1 {
      let normal_block = pipeline_loop_ctx_normal_block(ctx)
      let block = if pipeline_loop_ctx_normal_value_mode(ctx) == 1 {
        ir_block_new_params(
          cleanup_block,
          ir_value_list_prepend(carried_value, ir_value_list_empty()),
          ir_lowered_expr_insts(cleanup),
          ir_term_jump_args(normal_block, ir_value_list_prepend(carried_value, ir_value_list_empty()))
        )
      } else {
        ir_block_new_term(cleanup_block, ir_lowered_expr_insts(cleanup), ir_term_jump(normal_block))
      }
      pipeline_lowered_loop_blocks(next_block, ir_lowered_expr_next_value(cleanup), ir_block_list_prepend(block, ir_block_list_empty()), 1, 0, 1)
    } else {
      pipeline_lowered_loop_blocks_invalid(cleanup_block, next_value)
    }
  }
}

fn pipeline_lower_loop_defer_to_target_blocks(expr: i64, ctx: PipelineLoopCtx, next_value: i64, start_block: i64, next_block: i64) -> PipelineLoweredLoopBlocks {
  let cleanup_expr = node_f1(expr)
  let body_expr = node_f2(expr)
  let body_tag = node_tag(body_expr)
  if body_tag == 26 {
    pipeline_lower_loop_defer_break_to_blocks(cleanup_expr, body_expr, ctx, next_value, start_block, next_block)
  } else { if body_tag == 27 {
    pipeline_lower_loop_defer_continue_to_blocks(cleanup_expr, ctx, next_value, start_block, next_block)
  } else { if body_tag == 25 {
    pipeline_lowered_loop_blocks_from_expr(
      pipeline_lower_defer_return_to_blocks(cleanup_expr, body_expr, pipeline_loop_ctx_params(ctx), pipeline_loop_ctx_locals(ctx), pipeline_loop_ctx_module(ctx), next_value, start_block, next_block),
      0,
      0
    )
  } else { if body_tag == 5 {
    pipeline_lower_loop_defer_if_to_blocks(cleanup_expr, body_expr, ctx, next_value, start_block, next_block)
  } else {
    let cleanup_block = next_block
    let body_ctx = if pipeline_loop_ctx_normal_value_mode(ctx) == 1 {
      pipeline_loop_ctx_with_normal_value_block(ctx, cleanup_block)
    } else {
      pipeline_loop_ctx_with_normal_block(ctx, cleanup_block)
    }
    let body_blocks = pipeline_lower_loop_body_to_target_blocks(body_expr, body_ctx, next_value, start_block, next_block + 1)
    if pipeline_lowered_loop_blocks_is_valid(body_blocks) == 1 {
      if pipeline_lowered_loop_blocks_continues_body(body_blocks) == 0 {
        body_blocks
      } else {
        let carried_value = pipeline_lowered_loop_blocks_next_value(body_blocks)
        let cleanup = pipeline_lower_loop_defer_normal_cleanup_block(cleanup_expr, carried_value, ctx, carried_value + 1, cleanup_block, pipeline_lowered_loop_blocks_next_block(body_blocks))
        if pipeline_lowered_loop_blocks_is_valid(cleanup) == 1 {
          let blocks = ir_block_list_append(pipeline_lowered_loop_blocks_blocks(body_blocks), pipeline_lowered_loop_blocks_blocks(cleanup))
          let exits = pipeline_bool_or(pipeline_lowered_loop_blocks_exits_loop(body_blocks), pipeline_lowered_loop_blocks_exits_loop(cleanup))
          pipeline_lowered_loop_blocks(pipeline_lowered_loop_blocks_next_block(cleanup), pipeline_lowered_loop_blocks_next_value(cleanup), blocks, 1, exits, pipeline_lowered_loop_blocks_continues_body(cleanup))
        } else {
          pipeline_lowered_loop_blocks_invalid(start_block, next_value)
        }
      }
    } else {
      pipeline_lowered_loop_blocks_invalid(start_block, next_value)
    }
  } } } }
}

fn pipeline_lower_return_to_loop_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64) -> PipelineLoweredLoopBlocks {
  let lowered = pipeline_lower_return_to_blocks(expr, params, locals, module, next_value, start_block, next_block)
  pipeline_lowered_loop_blocks_from_expr(lowered, 0, 0)
}

fn pipeline_lower_loop_if_to_target_blocks(expr: i64, ctx: PipelineLoopCtx, next_value: i64, start_block: i64, next_block: i64) -> PipelineLoweredLoopBlocks {
  let params = pipeline_loop_ctx_params(ctx)
  let locals = pipeline_loop_ctx_locals(ctx)
  let src = pipeline_loop_ctx_src(ctx)
  let tt = pipeline_loop_ctx_tt(ctx)
  let else_expr = node_f3(expr)
  if else_expr == 0 {
    pipeline_lowered_loop_blocks_invalid(start_block, next_value)
  } else {
    if pipeline_expr_needs_cfg(node_f1(expr)) == 1 {
      -- CFG-shaped condition (and/or short-circuit, nested control): the
      -- straight-line path would evaluate both operands of a logical
      -- guard eagerly — observably equivalent only because checked
      -- vector ops carry their own guards, and it forfeits the branch
      -- facts the RHS needs for elision. Route through the reserved CFG
      -- lowering; simple compares keep the direct-branch fast path.
      let cond_merge_block = next_block
      let cond_blocks = pipeline_lower_expr_to_target_blocks_reserved(node_f1(expr), params, locals, pipeline_loop_ctx_module(ctx), next_value, start_block, next_block + 1, cond_merge_block)
      if pipeline_lowered_blocks_is_valid(cond_blocks) == 1 {
        if pipeline_lowered_blocks_falls_through(cond_blocks) == 0 {
          pipeline_lowered_loop_blocks(pipeline_lowered_blocks_next_block(cond_blocks), pipeline_lowered_blocks_next_value(cond_blocks), pipeline_lowered_blocks_blocks(cond_blocks), 1, 0, 0)
        } else {
          let cond_value = pipeline_lowered_blocks_next_value(cond_blocks)
          let then_start = pipeline_lowered_blocks_next_block(cond_blocks)
          let then_blocks = pipeline_lower_loop_body_to_target_blocks(node_f2(expr), ctx, cond_value + 1, then_start, then_start + 1)
          if pipeline_lowered_loop_blocks_is_valid(then_blocks) == 1 {
            let else_start = pipeline_lowered_loop_blocks_next_block(then_blocks)
            let else_blocks = pipeline_lower_loop_body_to_target_blocks(else_expr, ctx, pipeline_lowered_loop_blocks_next_value(then_blocks), else_start, else_start + 1)
            if pipeline_lowered_loop_blocks_is_valid(else_blocks) == 1 {
              let cond_params = ir_value_list_prepend(cond_value, ir_value_list_empty())
              let cond_merge = ir_block_new_params(cond_merge_block, cond_params, ir_inst_list_empty(), ir_term_branch(cond_value, then_start, else_start))
              let exits_loop = pipeline_bool_or(pipeline_lowered_loop_blocks_exits_loop(then_blocks), pipeline_lowered_loop_blocks_exits_loop(else_blocks))
              let continues_body = pipeline_bool_or(pipeline_lowered_loop_blocks_continues_body(then_blocks), pipeline_lowered_loop_blocks_continues_body(else_blocks))
              let blocks = ir_block_list_append(
                pipeline_lowered_blocks_blocks(cond_blocks),
                ir_block_list_prepend(cond_merge, ir_block_list_append(pipeline_lowered_loop_blocks_blocks(then_blocks), pipeline_lowered_loop_blocks_blocks(else_blocks)))
              )
              pipeline_lowered_loop_blocks(pipeline_lowered_loop_blocks_next_block(else_blocks), pipeline_lowered_loop_blocks_next_value(else_blocks), blocks, 1, exits_loop, continues_body)
            } else {
              pipeline_lowered_loop_blocks_invalid(start_block, next_value)
            }
          } else {
            pipeline_lowered_loop_blocks_invalid(start_block, next_value)
          }
        }
      } else {
        pipeline_lowered_loop_blocks_invalid(start_block, next_value)
      }
    } else {
      let cond = pipeline_lower_expr_node_with_module_ctx(node_f1(expr), params, locals, pipeline_loop_ctx_module(ctx), next_value)
      if ir_lowered_expr_is_valid(cond) == 1 {
        let then_start = next_block
        let then_blocks = pipeline_lower_loop_body_to_target_blocks(node_f2(expr), ctx, ir_lowered_expr_next_value(cond), then_start, then_start + 1)
        if pipeline_lowered_loop_blocks_is_valid(then_blocks) == 1 {
          let else_start = pipeline_lowered_loop_blocks_next_block(then_blocks)
          let else_blocks = pipeline_lower_loop_body_to_target_blocks(else_expr, ctx, pipeline_lowered_loop_blocks_next_value(then_blocks), else_start, else_start + 1)
          if pipeline_lowered_loop_blocks_is_valid(else_blocks) == 1 {
            let entry = ir_block_new_term(start_block, ir_lowered_expr_insts(cond), ir_term_branch(ir_lowered_expr_value(cond), then_start, else_start))
            let exits_loop = pipeline_bool_or(pipeline_lowered_loop_blocks_exits_loop(then_blocks), pipeline_lowered_loop_blocks_exits_loop(else_blocks))
            let continues_body = pipeline_bool_or(pipeline_lowered_loop_blocks_continues_body(then_blocks), pipeline_lowered_loop_blocks_continues_body(else_blocks))
            let blocks = ir_block_list_prepend(
              entry,
              ir_block_list_append(pipeline_lowered_loop_blocks_blocks(then_blocks), pipeline_lowered_loop_blocks_blocks(else_blocks))
            )
            pipeline_lowered_loop_blocks(pipeline_lowered_loop_blocks_next_block(else_blocks), pipeline_lowered_loop_blocks_next_value(else_blocks), blocks, 1, exits_loop, continues_body)
          } else {
            pipeline_lowered_loop_blocks_invalid(start_block, next_value)
          }
        } else {
          pipeline_lowered_loop_blocks_invalid(start_block, next_value)
        }
      } else {
        pipeline_lowered_loop_blocks_invalid(start_block, next_value)
      }
    }
  }
}

fn pipeline_lower_loop_block_to_target_blocks(expr: i64, ctx: PipelineLoopCtx, next_value: i64, start_block: i64, next_block: i64) -> PipelineLoweredLoopBlocks {
  let first_expr = node_f1(expr)
  let rest_node = node_f2(expr)
  if rest_node == 0 {
    pipeline_lower_loop_body_to_target_blocks(first_expr, ctx, next_value, start_block, next_block)
  } else {
    let rest_start = next_block
    let first_ctx = pipeline_loop_ctx_with_normal_block(ctx, rest_start)
    let first_blocks = pipeline_lower_loop_body_to_target_blocks(first_expr, first_ctx, next_value, start_block, next_block + 1)
    if pipeline_lowered_loop_blocks_is_valid(first_blocks) == 1 {
      if pipeline_lowered_loop_blocks_continues_body(first_blocks) == 0 {
        first_blocks
      } else {
        let rest_blocks = pipeline_lower_loop_body_to_target_blocks(rest_node, ctx, pipeline_lowered_loop_blocks_next_value(first_blocks), rest_start, pipeline_lowered_loop_blocks_next_block(first_blocks))
        if pipeline_lowered_loop_blocks_is_valid(rest_blocks) == 1 {
          let exits_loop = pipeline_bool_or(pipeline_lowered_loop_blocks_exits_loop(first_blocks), pipeline_lowered_loop_blocks_exits_loop(rest_blocks))
          let continues_body = pipeline_lowered_loop_blocks_continues_body(rest_blocks)
          let blocks = ir_block_list_append(
            pipeline_lowered_loop_blocks_blocks(first_blocks),
            pipeline_lowered_loop_blocks_blocks(rest_blocks)
          )
          pipeline_lowered_loop_blocks(pipeline_lowered_loop_blocks_next_block(rest_blocks), pipeline_lowered_loop_blocks_next_value(rest_blocks), blocks, 1, exits_loop, continues_body)
        } else {
          pipeline_lowered_loop_blocks_invalid(start_block, next_value)
        }
      }
    } else {
      pipeline_lowered_loop_blocks_invalid(start_block, next_value)
    }
  }
}

fn pipeline_lower_loop_let_to_target_blocks(expr: i64, ctx: PipelineLoopCtx, next_value: i64, start_block: i64, next_block: i64, local_float: i64, local_type_node: i64) -> PipelineLoweredLoopBlocks {
  let params = pipeline_loop_ctx_params(ctx)
  let locals = pipeline_loop_ctx_locals(ctx)
  let src = pipeline_loop_ctx_src(ctx)
  let tt = pipeline_loop_ctx_tt(ctx)
  let module = pipeline_loop_ctx_module(ctx)
  let target_block = pipeline_loop_ctx_target_block(ctx)
  let normal_block = pipeline_loop_ctx_normal_block(ctx)
  let continue_block = pipeline_loop_ctx_continue_block(ctx)
  let break_mode = pipeline_loop_ctx_break_mode(ctx)
  let init_expr = node_f3(expr)
  let body_expr = node_f4(expr)
  let early_inferred_type_node = pipeline_init_type_node_from_node(init_expr, params, locals, module)
  let early_effective_type_node = if local_type_node != 0 { ty_subst(local_type_node, pipeline_lower_module_subst(module)) } else { early_inferred_type_node }
  let local_lanes = pipeline_type_value_lane_count_or_one(early_effective_type_node)
  if pipeline_expr_needs_cfg(init_expr) == 1 {
    let local_merge_block = next_block
    let init_ctx = pipeline_loop_ctx_with_normal_value_block(ctx, local_merge_block)
    let local_value = next_value
    let init_blocks = pipeline_lower_loop_body_to_target_blocks(init_expr, init_ctx, local_value + local_lanes, start_block, next_block + 1)
    if pipeline_lowered_loop_blocks_is_valid(init_blocks) == 1 {
      if pipeline_lowered_loop_blocks_continues_body(init_blocks) == 0 {
        init_blocks
      } else {
        let body_next_value = pipeline_ir_max_i64(pipeline_lowered_loop_blocks_next_value(init_blocks), local_value + local_lanes)
        let body_start = pipeline_lowered_loop_blocks_next_block(init_blocks)
        let inferred_float_prim = pipeline_expr_float_prim_node_temp(init_expr, params, locals, src, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module))
        let float_prim = if local_float == PRIM_F32() or local_float == PRIM_F64() { local_float } else { inferred_float_prim }
        let inferred_type_hash = pipeline_expr_type_hash_node_temp(init_expr, params, locals, src, tt, pipeline_lower_module_fns(pipeline_loop_ctx_module(ctx)), 0)
        let inferred_type_node = pipeline_init_type_node_from_node(init_expr, params, locals, module)
        let effective_type_node = if local_type_node != 0 { ty_subst(local_type_node, pipeline_lower_module_subst(module)) } else { inferred_type_node }
        let annotated_type_hash = if local_type_node != 0 and effective_type_node != 0 { type_hash_of(effective_type_node) } else { 0 }
        let inferred_node_type_hash = if effective_type_node != 0 { type_hash_of(effective_type_node) } else { 0 }
        let local_type_hash = if annotated_type_hash != 0 { annotated_type_hash } else { if inferred_node_type_hash != 0 { inferred_node_type_hash } else { if local_float != 0 and pipeline_prim_is_numeric_context(local_float) == 1 { pipeline_type_hash_of_prim_id(local_float) } else { pipeline_expr_type_hash_sharpen_int_node(init_expr, inferred_type_hash, params, locals, src, tt, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module)) } } }
        let next_locals = pipeline_value_env_push_float_typed_node(locals, node_f1(expr), node_f2(expr), local_value, float_prim, local_type_hash, effective_type_node)
        let retain_insts = if effective_type_node != 0 and pipeline_expr_node_result_is_borrowed_for_ty_typed(init_expr, effective_type_node, src, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module), pipeline_lower_module_tt(module)) == 1 {
          pipeline_managed_retain_inst_list(local_value, effective_type_node, body_next_value)
        } else {
          ir_inst_list_empty()
        }
        let body_entry_value = body_next_value + ir_inst_list_len(retain_insts)
        let body_ctx = pipeline_loop_ctx_full(params, next_locals, pipeline_loop_ctx_module(ctx), target_block, normal_block, continue_block, break_mode, pipeline_loop_ctx_normal_value_mode(ctx))
        let body_blocks = pipeline_lower_loop_body_to_target_blocks(body_expr, body_ctx, body_entry_value, body_start, body_start + 1)
        if pipeline_lowered_loop_blocks_is_valid(body_blocks) == 1 {
          let local_params = pipeline_ir_value_lane_ids(local_value, 0, local_lanes)
          let cleanup_dst = pipeline_lowered_loop_blocks_next_value(body_blocks)
          let owned_type_hash = cg_owned_drop_type_hash(effective_type_node)
          let managed_release_count = pipeline_type_managed_release_lane_count(effective_type_node)
          let cleanup_count = if managed_release_count > 0 or owned_type_hash != 0 {
            pipeline_ir_block_list_loop_scope_cleanup_count(pipeline_lowered_loop_blocks_blocks(body_blocks), local_value, normal_block, continue_block, target_block)
          } else { 0 }
          let cleaned_body_blocks = if cleanup_count > 0 {
            if owned_type_hash != 0 {
              pipeline_ir_block_list_append_loop_owned_cleanup_indexed(pipeline_lowered_loop_blocks_blocks(body_blocks), local_value, owned_type_hash, 0, normal_block, continue_block, target_block)
            } else {
              pipeline_ir_block_list_append_loop_scope_cleanup_indexed(pipeline_lowered_loop_blocks_blocks(body_blocks), local_value, effective_type_node, cleanup_dst, 0, normal_block, continue_block, target_block)
            }
          } else { pipeline_lowered_loop_blocks_blocks(body_blocks) }
          let cleanup_stride = if owned_type_hash != 0 { 1 } else { managed_release_count }
          let next_after_cleanup = cleanup_dst + cleanup_count * cleanup_stride
          let local_merge = ir_block_new_params(local_merge_block, local_params, retain_insts, ir_term_jump(body_start))
          let blocks = ir_block_list_append(
            pipeline_lowered_loop_blocks_blocks(init_blocks),
            ir_block_list_prepend(local_merge, cleaned_body_blocks)
          )
          let exits_loop = pipeline_bool_or(pipeline_lowered_loop_blocks_exits_loop(init_blocks), pipeline_lowered_loop_blocks_exits_loop(body_blocks))
          pipeline_lowered_loop_blocks(
            pipeline_lowered_loop_blocks_next_block(body_blocks),
            next_after_cleanup,
            blocks,
            1,
            exits_loop,
            pipeline_lowered_loop_blocks_continues_body(body_blocks)
          )
        } else {
          pipeline_lowered_loop_blocks_invalid(start_block, next_value)
        }
      }
    } else {
      pipeline_lowered_loop_blocks_invalid(start_block, next_value)
    }
  } else {
    let init = if pipeline_prim_is_forced_numeric_context(local_float) == 1 {
      pipeline_lower_expr_node_with_module_float_ctx(init_expr, params, locals, pipeline_loop_ctx_module(ctx), next_value, local_float)
    } else {
      pipeline_lower_expr_node_with_module_ctx(init_expr, params, locals, pipeline_loop_ctx_module(ctx), next_value)
    }
    if ir_lowered_expr_is_valid(init) == 1 {
      let body_start = next_block
      let inferred_float_prim = pipeline_expr_float_prim_node_temp(init_expr, params, locals, src, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module))
      let float_prim = if local_float == PRIM_F32() or local_float == PRIM_F64() { local_float } else { inferred_float_prim }
      let inferred_type_hash = pipeline_expr_type_hash_node_temp(init_expr, params, locals, src, tt, pipeline_lower_module_fns(pipeline_loop_ctx_module(ctx)), 0)
      let inferred_type_node = pipeline_init_type_node_from_node(init_expr, params, locals, module)
      let effective_type_node = if local_type_node != 0 { ty_subst(local_type_node, pipeline_lower_module_subst(module)) } else { inferred_type_node }
      let annotated_type_hash = if local_type_node != 0 and effective_type_node != 0 { type_hash_of(effective_type_node) } else { 0 }
      let inferred_node_type_hash = if effective_type_node != 0 { type_hash_of(effective_type_node) } else { 0 }
      let local_type_hash = if annotated_type_hash != 0 { annotated_type_hash } else { if inferred_node_type_hash != 0 { inferred_node_type_hash } else { if local_float != 0 and pipeline_prim_is_numeric_context(local_float) == 1 { pipeline_type_hash_of_prim_id(local_float) } else { pipeline_expr_type_hash_sharpen_int_node(init_expr, inferred_type_hash, params, locals, src, tt, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module)) } } }
      let bind_value = ir_lowered_expr_value(init)
      let retain_insts = if effective_type_node != 0 and pipeline_expr_node_result_is_borrowed_for_ty_typed(init_expr, effective_type_node, src, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module), pipeline_lower_module_tt(module)) == 1 {
        pipeline_managed_retain_inst_list(bind_value, effective_type_node, ir_lowered_expr_next_value(init))
      } else {
        ir_inst_list_empty()
      }
      let body_next_value = ir_lowered_expr_next_value(init) + ir_inst_list_len(retain_insts)
      let next_locals = pipeline_value_env_push_float_typed_node(locals, node_f1(expr), node_f2(expr), bind_value, float_prim, local_type_hash, effective_type_node)
      let body_ctx = pipeline_loop_ctx_full(params, next_locals, pipeline_loop_ctx_module(ctx), target_block, normal_block, continue_block, break_mode, pipeline_loop_ctx_normal_value_mode(ctx))
      let body_blocks = pipeline_lower_loop_body_to_target_blocks(body_expr, body_ctx, body_next_value, body_start, body_start + 1)
      if pipeline_lowered_loop_blocks_is_valid(body_blocks) == 1 {
        let cleanup_dst = pipeline_lowered_loop_blocks_next_value(body_blocks)
        let owned_type_hash = cg_owned_drop_type_hash(effective_type_node)
        let managed_release_count = pipeline_type_managed_release_lane_count(effective_type_node)
        let cleanup_count = if managed_release_count > 0 or owned_type_hash != 0 {
          pipeline_ir_block_list_loop_scope_cleanup_count(pipeline_lowered_loop_blocks_blocks(body_blocks), bind_value, normal_block, continue_block, target_block)
        } else { 0 }
        let cleaned_body_blocks = if cleanup_count > 0 {
          if owned_type_hash != 0 {
            pipeline_ir_block_list_append_loop_owned_cleanup_indexed(pipeline_lowered_loop_blocks_blocks(body_blocks), bind_value, owned_type_hash, 0, normal_block, continue_block, target_block)
          } else {
            pipeline_ir_block_list_append_loop_scope_cleanup_indexed(pipeline_lowered_loop_blocks_blocks(body_blocks), bind_value, effective_type_node, cleanup_dst, 0, normal_block, continue_block, target_block)
          }
        } else { pipeline_lowered_loop_blocks_blocks(body_blocks) }
        let cleanup_stride = if owned_type_hash != 0 { 1 } else { managed_release_count }
        let next_after_cleanup = cleanup_dst + cleanup_count * cleanup_stride
        let entry = ir_block_new_term(start_block, ir_inst_list_append(ir_lowered_expr_insts(init), retain_insts), ir_term_jump(body_start))
        let blocks = ir_block_list_prepend(entry, cleaned_body_blocks)
        pipeline_lowered_loop_blocks(
          pipeline_lowered_loop_blocks_next_block(body_blocks),
          next_after_cleanup,
          blocks,
          1,
          pipeline_lowered_loop_blocks_exits_loop(body_blocks),
          pipeline_lowered_loop_blocks_continues_body(body_blocks)
        )
      } else {
        pipeline_lowered_loop_blocks_invalid(start_block, next_value)
      }
    } else {
      pipeline_lowered_loop_blocks_invalid(start_block, next_value)
    }
  }
}

fn pipeline_lower_loop_let_mut_to_target_blocks(expr: i64, ctx: PipelineLoopCtx, next_value: i64, start_block: i64, next_block: i64, local_float: i64, local_type_node: i64) -> PipelineLoweredLoopBlocks {
  let params = pipeline_loop_ctx_params(ctx)
  let locals = pipeline_loop_ctx_locals(ctx)
  let src = pipeline_loop_ctx_src(ctx)
  let tt = pipeline_loop_ctx_tt(ctx)
  let module = pipeline_loop_ctx_module(ctx)
  let target_block = pipeline_loop_ctx_target_block(ctx)
  let normal_block = pipeline_loop_ctx_normal_block(ctx)
  let continue_block = pipeline_loop_ctx_continue_block(ctx)
  let break_mode = pipeline_loop_ctx_break_mode(ctx)
  let init_expr = node_f3(expr)
  let body_expr = node_f4(expr)
  let early_inferred_type_node = pipeline_init_type_node_from_node(init_expr, params, locals, module)
  let early_effective_type_node = if local_type_node != 0 { ty_subst(local_type_node, pipeline_lower_module_subst(module)) } else { early_inferred_type_node }
  let local_lanes = pipeline_type_value_lane_count_or_one(early_effective_type_node)
  if pipeline_expr_needs_cfg(init_expr) == 1 {
    let local_merge_block = next_block
    let init_ctx = pipeline_loop_ctx_with_normal_value_block(ctx, local_merge_block)
    let local_value = next_value
    let slot = local_value + local_lanes
    let init_blocks = pipeline_lower_loop_body_to_target_blocks(init_expr, init_ctx, slot + local_lanes, start_block, next_block + 1)
    if pipeline_lowered_loop_blocks_is_valid(init_blocks) == 1 {
      if pipeline_lowered_loop_blocks_continues_body(init_blocks) == 0 {
        init_blocks
      } else {
        let body_next_value = pipeline_ir_max_i64(pipeline_lowered_loop_blocks_next_value(init_blocks), slot + local_lanes)
        let body_start = pipeline_lowered_loop_blocks_next_block(init_blocks)
        let slot_insts = pipeline_ir_slot_lane_init_insts(slot, local_value, 0, local_lanes)
        let inferred_float_prim = pipeline_expr_float_prim_node_temp(init_expr, params, locals, src, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module))
        let float_prim = if local_float == PRIM_F32() or local_float == PRIM_F64() { local_float } else { inferred_float_prim }
        let inferred_type_hash = pipeline_expr_type_hash_node_temp(init_expr, params, locals, src, tt, pipeline_lower_module_fns(pipeline_loop_ctx_module(ctx)), 0)
        let inferred_type_node = early_inferred_type_node
        let effective_type_node = early_effective_type_node
        let annotated_type_hash = if local_type_node != 0 and effective_type_node != 0 { type_hash_of(effective_type_node) } else { 0 }
        let inferred_node_type_hash = if effective_type_node != 0 { type_hash_of(effective_type_node) } else { 0 }
        let local_type_hash = if annotated_type_hash != 0 { annotated_type_hash } else { if inferred_node_type_hash != 0 { inferred_node_type_hash } else { if local_float != 0 and pipeline_prim_is_numeric_context(local_float) == 1 { pipeline_type_hash_of_prim_id(local_float) } else { pipeline_expr_type_hash_sharpen_int_node(init_expr, inferred_type_hash, params, locals, src, tt, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module)) } } }
        let retain_insts = if effective_type_node != 0 and pipeline_expr_node_result_is_borrowed_for_ty_typed(init_expr, effective_type_node, src, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module), pipeline_lower_module_tt(module)) == 1 {
          pipeline_managed_retain_inst_list(local_value, effective_type_node, body_next_value)
        } else {
          ir_inst_list_empty()
        }
        let body_entry_value = body_next_value + ir_inst_list_len(retain_insts)
        let next_locals = pipeline_value_env_push_slot_float_typed_node(locals, node_f1(expr), node_f2(expr), slot, float_prim, local_type_hash, effective_type_node)
        let body_ctx = pipeline_loop_ctx_full(params, next_locals, pipeline_loop_ctx_module(ctx), target_block, normal_block, continue_block, break_mode, pipeline_loop_ctx_normal_value_mode(ctx))
        let body_blocks = pipeline_lower_loop_body_to_target_blocks(body_expr, body_ctx, body_entry_value, body_start, body_start + 1)
        if pipeline_lowered_loop_blocks_is_valid(body_blocks) == 1 {
          let local_params = pipeline_ir_value_lane_ids(local_value, 0, local_lanes)
          let cleanup_dst = pipeline_lowered_loop_blocks_next_value(body_blocks)
          let release_count = pipeline_type_managed_release_lane_count(effective_type_node)
          let cleanup_count = if release_count > 0 {
            pipeline_ir_block_list_loop_slot_cleanup_count(pipeline_lowered_loop_blocks_blocks(body_blocks), slot, normal_block, continue_block, target_block)
          } else { 0 }
          let cleaned_body_blocks = if cleanup_count > 0 {
            pipeline_ir_block_list_append_loop_slot_cleanup_indexed(pipeline_lowered_loop_blocks_blocks(body_blocks), slot, effective_type_node, cleanup_dst, 0, normal_block, continue_block, target_block)
          } else { pipeline_lowered_loop_blocks_blocks(body_blocks) }
          let next_after_cleanup = cleanup_dst + cleanup_count * release_count * 2
          let local_merge = ir_block_new_params(local_merge_block, local_params, ir_inst_list_append(slot_insts, retain_insts), ir_term_jump(body_start))
          let blocks = ir_block_list_append(
            pipeline_lowered_loop_blocks_blocks(init_blocks),
            ir_block_list_prepend(local_merge, cleaned_body_blocks)
          )
          let exits_loop = pipeline_bool_or(pipeline_lowered_loop_blocks_exits_loop(init_blocks), pipeline_lowered_loop_blocks_exits_loop(body_blocks))
          pipeline_lowered_loop_blocks(
            pipeline_lowered_loop_blocks_next_block(body_blocks),
            next_after_cleanup,
            blocks,
            1,
            exits_loop,
            pipeline_lowered_loop_blocks_continues_body(body_blocks)
          )
        } else {
          pipeline_lowered_loop_blocks_invalid(start_block, next_value)
        }
      }
    } else {
      pipeline_lowered_loop_blocks_invalid(start_block, next_value)
    }
  } else {
    let init = if pipeline_prim_is_forced_numeric_context(local_float) == 1 {
      pipeline_lower_expr_node_with_module_float_ctx(init_expr, params, locals, pipeline_loop_ctx_module(ctx), next_value, local_float)
    } else {
      pipeline_lower_expr_node_with_module_ctx(init_expr, params, locals, pipeline_loop_ctx_module(ctx), next_value)
    }
    if ir_lowered_expr_is_valid(init) == 1 {
      let slot = ir_lowered_expr_next_value(init)
      let body_start = next_block
      let slot_insts = pipeline_ir_slot_lane_init_insts(slot, ir_lowered_expr_value(init), 0, local_lanes)
      let inferred_float_prim = pipeline_expr_float_prim_node_temp(init_expr, params, locals, src, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module))
      let float_prim = if local_float == PRIM_F32() or local_float == PRIM_F64() { local_float } else { inferred_float_prim }
      let inferred_type_hash = pipeline_expr_type_hash_node_temp(init_expr, params, locals, src, tt, pipeline_lower_module_fns(pipeline_loop_ctx_module(ctx)), 0)
      let inferred_type_node = early_inferred_type_node
      let effective_type_node = early_effective_type_node
      let annotated_type_hash = if local_type_node != 0 and effective_type_node != 0 { type_hash_of(effective_type_node) } else { 0 }
      let inferred_node_type_hash = if effective_type_node != 0 { type_hash_of(effective_type_node) } else { 0 }
      let local_type_hash = if annotated_type_hash != 0 { annotated_type_hash } else { if inferred_node_type_hash != 0 { inferred_node_type_hash } else { if local_float != 0 and pipeline_prim_is_numeric_context(local_float) == 1 { pipeline_type_hash_of_prim_id(local_float) } else { pipeline_expr_type_hash_sharpen_int_node(init_expr, inferred_type_hash, params, locals, src, tt, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module)) } } }
      let retain_insts = if effective_type_node != 0 and pipeline_expr_node_result_is_borrowed_for_ty_typed(init_expr, effective_type_node, src, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module), pipeline_lower_module_tt(module)) == 1 {
        pipeline_managed_retain_inst_list(ir_lowered_expr_value(init), effective_type_node, slot + local_lanes)
      } else {
        ir_inst_list_empty()
      }
      let body_next_value = slot + local_lanes + ir_inst_list_len(retain_insts)
      let next_locals = pipeline_value_env_push_slot_float_typed_node(locals, node_f1(expr), node_f2(expr), slot, float_prim, local_type_hash, effective_type_node)
      let body_ctx = pipeline_loop_ctx_full(params, next_locals, pipeline_loop_ctx_module(ctx), target_block, normal_block, continue_block, break_mode, pipeline_loop_ctx_normal_value_mode(ctx))
      let body_blocks = pipeline_lower_loop_body_to_target_blocks(body_expr, body_ctx, body_next_value, body_start, body_start + 1)
      if pipeline_lowered_loop_blocks_is_valid(body_blocks) == 1 {
        let cleanup_dst = pipeline_lowered_loop_blocks_next_value(body_blocks)
        let release_count = pipeline_type_managed_release_lane_count(effective_type_node)
        let cleanup_count = if release_count > 0 {
          pipeline_ir_block_list_loop_slot_cleanup_count(pipeline_lowered_loop_blocks_blocks(body_blocks), slot, normal_block, continue_block, target_block)
        } else { 0 }
        let cleaned_body_blocks = if cleanup_count > 0 {
          pipeline_ir_block_list_append_loop_slot_cleanup_indexed(pipeline_lowered_loop_blocks_blocks(body_blocks), slot, effective_type_node, cleanup_dst, 0, normal_block, continue_block, target_block)
        } else { pipeline_lowered_loop_blocks_blocks(body_blocks) }
        let next_after_cleanup = cleanup_dst + cleanup_count * release_count * 2
        let entry_insts = ir_inst_list_append(ir_lowered_expr_insts(init), ir_inst_list_append(slot_insts, retain_insts))
        let entry = ir_block_new_term(start_block, entry_insts, ir_term_jump(body_start))
        let blocks = ir_block_list_prepend(entry, cleaned_body_blocks)
        pipeline_lowered_loop_blocks(
          pipeline_lowered_loop_blocks_next_block(body_blocks),
          next_after_cleanup,
          blocks,
          1,
          pipeline_lowered_loop_blocks_exits_loop(body_blocks),
          pipeline_lowered_loop_blocks_continues_body(body_blocks)
        )
      } else {
        pipeline_lowered_loop_blocks_invalid(start_block, next_value)
      }
    } else {
      pipeline_lowered_loop_blocks_invalid(start_block, next_value)
    }
  }
}

fn pipeline_lower_loop_body_to_target_blocks(expr: i64, ctx: PipelineLoopCtx, next_value: i64, start_block: i64, next_block: i64) -> PipelineLoweredLoopBlocks {
  let params = pipeline_loop_ctx_params(ctx)
  let locals = pipeline_loop_ctx_locals(ctx)
  let src = pipeline_loop_ctx_src(ctx)
  let tt = pipeline_loop_ctx_tt(ctx)
  let module = pipeline_loop_ctx_module(ctx)
  let target_block = pipeline_loop_ctx_target_block(ctx)
  let continue_block = pipeline_loop_ctx_continue_block(ctx)
  let normal_block = pipeline_loop_ctx_normal_block(ctx)
  let break_mode = pipeline_loop_ctx_break_mode(ctx)
  let tag = node_tag(expr)
  match tag {
    26 -> {
      if break_mode == 1 {
        pipeline_lower_nil_break_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      } else {
        pipeline_lower_break_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      }
    }
    27 -> pipeline_lower_continue_to_blocks(next_value, start_block, next_block, continue_block)
    25 -> pipeline_lower_return_to_loop_blocks(expr, params, locals, module, next_value, start_block, next_block)
    5 -> pipeline_lower_loop_if_to_target_blocks(expr, ctx, next_value, start_block, next_block)
    7 -> pipeline_lower_loop_block_to_target_blocks(expr, ctx, next_value, start_block, next_block)
    6 -> pipeline_lower_loop_let_to_target_blocks(expr, ctx, next_value, start_block, next_block, 0, 0)
    11 -> pipeline_lower_loop_let_mut_to_target_blocks(expr, ctx, next_value, start_block, next_block, 0, 0)
    52 -> pipeline_lower_loop_defer_to_target_blocks(expr, ctx, next_value, start_block, next_block)
    37 -> {
      let inner = node_f1(expr)
      let ann_type_node = node_f2(expr)
      let ann_float = type_expr_prim_id_or(type_expr_from_node(ann_type_node), 0)
      let inner_tag = node_tag(inner)
      if inner_tag == 6 {
        pipeline_lower_loop_let_to_target_blocks(inner, ctx, next_value, start_block, next_block, ann_float, ann_type_node)
      } else {
        if inner_tag == 11 {
          pipeline_lower_loop_let_mut_to_target_blocks(inner, ctx, next_value, start_block, next_block, ann_float, ann_type_node)
        } else {
          pipeline_lower_loop_body_to_target_blocks(inner, ctx, next_value, start_block, next_block)
        }
      }
    }
    _ -> {
      if pipeline_expr_needs_cfg(expr) == 1 {
        let normal_blocks = if pipeline_loop_ctx_normal_value_mode(ctx) == 1 {
          pipeline_lower_expr_to_target_blocks_reserved(expr, params, locals, module, next_value, start_block, next_block, normal_block)
        } else {
          pipeline_lower_expr_to_control_target_blocks_reserved(expr, params, locals, module, next_value, start_block, next_block, normal_block)
        }
        if pipeline_lowered_blocks_is_valid(normal_blocks) == 1 {
          pipeline_lowered_loop_blocks(
            pipeline_lowered_blocks_next_block(normal_blocks),
            pipeline_lowered_blocks_next_value(normal_blocks),
            pipeline_lowered_blocks_blocks(normal_blocks),
            1,
            0,
            pipeline_lowered_blocks_falls_through(normal_blocks)
          )
        } else {
          pipeline_lowered_loop_blocks_invalid(start_block, next_value)
        }
      } else {
        let lower_ctx = pipeline_handler_lower_ctx_from_module(params, locals, module)
        let value = pipeline_lower_expr_node_typed_sidecar_handler_ctx(expr, next_value, lower_ctx)
        if ir_lowered_expr_is_valid(value) == 1 {
          let value_mode = pipeline_loop_ctx_normal_value_mode(ctx)
          let discard_ty = if value_mode == 1 { 0 } else { pipeline_discard_release_type_node(expr, params, locals, module) }
          let discard_insts = if discard_ty != 0 { pipeline_managed_release_inst_list(ir_lowered_expr_value(value), discard_ty, ir_lowered_expr_next_value(value)) } else { ir_inst_list_empty() }
          let after_discard = ir_lowered_expr_next_value(value) + ir_inst_list_len(discard_insts)
          let term = if value_mode == 1 {
            ir_term_jump_args(normal_block, ir_value_list_prepend(ir_lowered_expr_value(value), ir_value_list_empty()))
          } else {
            ir_term_jump(normal_block)
          }
          let block = ir_block_new_term(start_block, ir_inst_list_append(ir_lowered_expr_insts(value), discard_insts), term)
          let blocks = ir_block_list_prepend(block, ir_block_list_empty())
          pipeline_lowered_loop_blocks(next_block, after_discard, blocks, 1, 0, 1)
        } else {
          pipeline_lowered_loop_blocks_invalid(start_block, next_value)
        }
      }
    }
  }
}

fn pipeline_lower_loop_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let ctx = pipeline_loop_ctx(params, locals, module, target_block, start_block, start_block, 0)
  let lowered = pipeline_lower_loop_body_to_target_blocks(node_f1(expr), ctx, next_value, start_block, next_block)
  pipeline_lowered_blocks_control(
    pipeline_lowered_loop_blocks_next_block(lowered),
    pipeline_lowered_loop_blocks_next_value(lowered),
    pipeline_lowered_loop_blocks_blocks(lowered),
    pipeline_lowered_loop_blocks_is_valid(lowered),
    pipeline_lowered_loop_blocks_exits_loop(lowered)
  )
}

fn pipeline_lower_while_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  if pipeline_expr_needs_cfg(node_f1(expr)) == 1 {
    -- CFG-shaped condition (and/or short-circuit, nested control). The
    -- straight-line path below evaluates both logical operands eagerly,
    -- which violates the kernel §5.3.1 short-circuit contract — a
    -- faulting or effectful RHS must not run when the LHS decides. The
    -- typed while lowering has routed these through the reserved CFG
    -- lowering since 2n; this node path (nested whiles reach it through
    -- the loop-body dispatcher) kept the eager form until a guarded
    -- nlist probe in an inner while condition faulted (2v Stage 0).
    let cond_merge_block = next_block
    let body_start = next_block + 1
    let exit_block = next_block + 2
    let cond_blocks = pipeline_lower_expr_to_target_blocks_reserved(node_f1(expr), params, locals, module, next_value, start_block, next_block + 3, cond_merge_block)
    if pipeline_lowered_blocks_is_valid(cond_blocks) == 1 {
      if pipeline_lowered_blocks_falls_through(cond_blocks) == 0 {
        cond_blocks
      } else {
        let cond_value = pipeline_lowered_blocks_next_value(cond_blocks)
        let cond_params = ir_value_list_prepend(cond_value, ir_value_list_empty())
        let cond_merge = ir_block_new_params(cond_merge_block, cond_params, ir_inst_list_empty(), ir_term_branch(cond_value, body_start, exit_block))
        let ctx = pipeline_loop_ctx(params, locals, module, target_block, start_block, start_block, 1)
        let body_blocks = pipeline_lower_loop_body_to_target_blocks(node_f2(expr), ctx, cond_value + 1, body_start, pipeline_lowered_blocks_next_block(cond_blocks))
        if pipeline_lowered_loop_blocks_is_valid(body_blocks) == 1 {
          let nil_value = pipeline_lowered_loop_blocks_next_value(body_blocks)
          let exit_args = ir_value_list_prepend(nil_value, ir_value_list_empty())
          let exit_insts = ir_inst_list_prepend(ir_inst_const_i64(nil_value, 0), ir_inst_list_empty())
          let exit_node = ir_block_new_term(exit_block, exit_insts, ir_term_jump_args(target_block, exit_args))
          let blocks = ir_block_list_append(
            pipeline_lowered_blocks_blocks(cond_blocks),
            ir_block_list_prepend(cond_merge, ir_block_list_append(pipeline_lowered_loop_blocks_blocks(body_blocks), ir_block_list_prepend(exit_node, ir_block_list_empty())))
          )
          pipeline_lowered_blocks(pipeline_lowered_loop_blocks_next_block(body_blocks), nil_value + 1, blocks, 1)
        } else {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        }
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  } else {
  let cond = pipeline_lower_expr_node_with_module_ctx(node_f1(expr), params, locals, module, next_value)
  if ir_lowered_expr_is_valid(cond) == 1 {
    let body_start = next_block
    let exit_block = next_block + 1
    let ctx = pipeline_loop_ctx(params, locals, module, target_block, start_block, start_block, 1)
    let body_blocks = pipeline_lower_loop_body_to_target_blocks(node_f2(expr), ctx, ir_lowered_expr_next_value(cond), body_start, next_block + 2)
    if pipeline_lowered_loop_blocks_is_valid(body_blocks) == 1 {
      let nil_value = pipeline_lowered_loop_blocks_next_value(body_blocks)
      let exit_args = ir_value_list_prepend(nil_value, ir_value_list_empty())
      let exit_insts = ir_inst_list_prepend(ir_inst_const_i64(nil_value, 0), ir_inst_list_empty())
      let entry = ir_block_new_term(start_block, ir_lowered_expr_insts(cond), ir_term_branch(ir_lowered_expr_value(cond), body_start, exit_block))
      let exit_node = ir_block_new_term(exit_block, exit_insts, ir_term_jump_args(target_block, exit_args))
      let blocks = ir_block_list_prepend(
        entry,
        ir_block_list_append(pipeline_lowered_loop_blocks_blocks(body_blocks), ir_block_list_prepend(exit_node, ir_block_list_empty()))
      )
      pipeline_lowered_blocks(pipeline_lowered_loop_blocks_next_block(body_blocks), nil_value + 1, blocks, 1)
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  } else {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  }
  }
}

-- The for-in binder's element type, as a type hash under the module's
-- mono substitution. Without this the binder entered the value env
-- untyped, and a `.method()` call on it in a monomorphised generic fn
-- fell through the perform-vs-method decision into a dynamic PERFORM of
-- an effect named after the variable — an unhandled-perform trap at
-- runtime (2u: e2e_generic_collection returned 133 = 128 + SIGTRAP).
fn pipeline_for_iter_elem_type_node(collection_expr: Expr, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> i64 {
  let tt = pipeline_lower_module_tt(module)
  let collection_ty = pipeline_return_expr_type_node_typed(collection_expr, params, locals, module)
  if collection_ty == 0 { 0 }
  else {
    let elem = for_iter_item_type_from_collection(tt, collection_ty)
    let subst = pipeline_lower_module_subst(module)
    if subst == 0 { elem } else { ty_subst(elem, subst) }
  }
}

fn pipeline_for_iter_elem_type_hash(collection_expr: Expr, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> i64 {
  let elem_ty = pipeline_for_iter_elem_type_node(collection_expr, params, locals, module)
  if elem_ty == 0 { 0 } else { type_hash_of(elem_ty) }
}

fn pipeline_lower_for_list_iter_loop_to_target_blocks(for_ctx: PipelineForIterCtx, current_slot: i64, next_value: i64, start_block: i64, next_block: i64) -> PipelineLoweredBlocks {
  match for_ctx {
    PipelineForIterCtx(expr, params, locals, module, target_block) -> {
      let src = pipeline_lower_module_src(module)
      let tt = pipeline_lower_module_tt(module)
      let body_block = next_block
      let exit_block = next_block + 1
      let advance_block = next_block + 2
      let body_expr_start = next_block + 3
      let body_next_block = next_block + 4
      let check_cur = next_value
      let tag_value = next_value + 1
      let nil_tag = next_value + 2
      let is_nil = next_value + 3
      let check_insts = ir_inst_list_prepend(
        ir_inst_load_i64(check_cur, current_slot),
        ir_inst_list_prepend(
          ir_inst_variant_tag_i64(tag_value, check_cur),
          ir_inst_list_prepend(
            ir_inst_const_i64(nil_tag, pipeline_nil_variant_hash()),
            ir_inst_list_prepend(ir_inst_binary_i64(is_nil, ir_binary_op_eq(), tag_value, nil_tag), ir_inst_list_empty())
          )
        )
      )
      let check_node = ir_block_new_term(start_block, check_insts, ir_term_branch(is_nil, exit_block, body_block))
      let body_cur = is_nil + 1
      let item_value = body_cur + 1
      let body_insts = ir_inst_list_prepend(
        ir_inst_load_i64(body_cur, current_slot),
        ir_inst_list_prepend(ir_inst_variant_payload_i64(item_value, body_cur, 0), ir_inst_list_empty())
      )
      let body_entry = ir_block_new_term(body_block, body_insts, ir_term_jump(body_expr_start))
      let elem_ty = pipeline_for_iter_elem_type_node(expr_from_node(node_f3(expr)), params, locals, module)
      let elem_hash = if elem_ty == 0 { 0 } else { type_hash_of(elem_ty) }
      let elem_prim = if elem_hash < 0 { (0 - elem_hash) - 1 } else { 0 - 1 }
      let elem_float = if elem_prim == PRIM_F64() { elem_prim } else { if elem_prim == PRIM_F32() { elem_prim } else { 0 } }
      let body_locals = pipeline_value_env_push_float_typed_node(locals, node_f1(expr), node_f2(expr), item_value, elem_float, elem_hash, elem_ty)
      let loop_ctx = pipeline_loop_ctx(params, body_locals, module, target_block, advance_block, advance_block, 1)
      let body_blocks = pipeline_lower_loop_body_to_target_blocks(node_f4(expr), loop_ctx, item_value + 1, body_expr_start, body_next_block)
      if pipeline_lowered_loop_blocks_is_valid(body_blocks) == 1 {
        let advance_cur = pipeline_lowered_loop_blocks_next_value(body_blocks)
        let next_cell = advance_cur + 1
        let nil_result = next_cell + 1
        let advance_insts = ir_inst_list_prepend(
          ir_inst_load_i64(advance_cur, current_slot),
          ir_inst_list_prepend(
            ir_inst_variant_payload_i64(next_cell, advance_cur, 1),
            ir_inst_list_prepend(ir_inst_store_i64(current_slot, next_cell), ir_inst_list_empty())
          )
        )
        let advance_node = ir_block_new_term(advance_block, advance_insts, ir_term_jump(start_block))
        let exit_args = ir_value_list_prepend(nil_result, ir_value_list_empty())
        let exit_insts = ir_inst_list_prepend(ir_inst_const_i64(nil_result, 0), ir_inst_list_empty())
        let exit_node = ir_block_new_term(exit_block, exit_insts, ir_term_jump_args(target_block, exit_args))
        let tail_blocks = ir_block_list_append(
          pipeline_lowered_loop_blocks_blocks(body_blocks),
          ir_block_list_prepend(advance_node, ir_block_list_prepend(exit_node, ir_block_list_empty()))
        )
        let blocks = ir_block_list_prepend(check_node, ir_block_list_prepend(body_entry, tail_blocks))
        pipeline_lowered_blocks(pipeline_lowered_loop_blocks_next_block(body_blocks), nil_result + 1, blocks, 1)
      } else {
        pipeline_lowered_blocks_invalid(start_block, next_value)
      }
    }
  }
}

fn pipeline_lower_for_list_iter_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let collection_expr = node_f3(expr)
  if pipeline_expr_needs_cfg(collection_expr) == 1 {
    let collection_merge_block = next_block
    let collection_blocks = pipeline_lower_expr_to_target_blocks_reserved(collection_expr, params, locals, module, next_value, start_block, next_block + 1, collection_merge_block)
    if pipeline_lowered_blocks_is_valid(collection_blocks) == 1 {
      if pipeline_lowered_blocks_falls_through(collection_blocks) == 0 {
        collection_blocks
      } else {
        let collection_value = pipeline_lowered_blocks_next_value(collection_blocks)
        let current_slot = collection_value + 1
        let loop_start = pipeline_lowered_blocks_next_block(collection_blocks)
        let slot_insts = ir_inst_list_prepend(
          ir_inst_slot_i64(current_slot),
          ir_inst_list_prepend(ir_inst_store_i64(current_slot, collection_value), ir_inst_list_empty())
        )
        let collection_params = ir_value_list_prepend(collection_value, ir_value_list_empty())
        let collection_merge = ir_block_new_params(collection_merge_block, collection_params, slot_insts, ir_term_jump(loop_start))
        let for_ctx = PipelineForIterCtx(expr, params, locals, module, target_block)
        let loop_blocks = pipeline_lower_for_list_iter_loop_to_target_blocks(for_ctx, current_slot, current_slot + 1, loop_start, loop_start + 1)
        if pipeline_lowered_blocks_is_valid(loop_blocks) == 1 {
          let blocks = ir_block_list_append(
            pipeline_lowered_blocks_blocks(collection_blocks),
            ir_block_list_prepend(collection_merge, pipeline_lowered_blocks_blocks(loop_blocks))
          )
          pipeline_lowered_blocks(
            pipeline_lowered_blocks_next_block(loop_blocks),
            pipeline_lowered_blocks_next_value(loop_blocks),
            blocks,
            1
          )
        } else {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        }
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  } else {
    let lower_ctx = pipeline_handler_lower_ctx_from_module(params, locals, module)
    let collection = pipeline_lower_expr_node_typed_sidecar_handler_ctx(collection_expr, next_value, lower_ctx)
    if ir_lowered_expr_is_valid(collection) == 1 {
      let current_slot = ir_lowered_expr_next_value(collection)
      let slot_insts = ir_inst_list_prepend(
        ir_inst_slot_i64(current_slot),
        ir_inst_list_prepend(ir_inst_store_i64(current_slot, ir_lowered_expr_value(collection)), ir_inst_list_empty())
      )
      let loop_start = next_block
      let entry_insts = ir_inst_list_append(ir_lowered_expr_insts(collection), slot_insts)
      let entry = ir_block_new_term(start_block, entry_insts, ir_term_jump(loop_start))
      let for_ctx = PipelineForIterCtx(expr, params, locals, module, target_block)
      let loop_blocks = pipeline_lower_for_list_iter_loop_to_target_blocks(for_ctx, current_slot, current_slot + 1, loop_start, next_block + 1)
      if pipeline_lowered_blocks_is_valid(loop_blocks) == 1 {
        let blocks = ir_block_list_prepend(entry, pipeline_lowered_blocks_blocks(loop_blocks))
        pipeline_lowered_blocks(
          pipeline_lowered_blocks_next_block(loop_blocks),
          pipeline_lowered_blocks_next_value(loop_blocks),
          blocks,
          1
        )
      } else {
        pipeline_lowered_blocks_invalid(start_block, next_value)
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  }
}

-- Arrays and slices are primitive finite sequences. Their for lowering keeps
-- the already-evaluated collection live across the loop and consumes the same
-- indexed-address boundary as an explicit `collection[index]`. The typed loop
-- construction itself establishes `0 <= index < len`, so it selects the shared
-- full-proven address fact without a for-specific codegen recognizer.
fn pipeline_lower_for_indexed_iter_loop_to_target_blocks(for_ctx: PipelineForIterCtx, collection_ty: i64, collection_value: i64, release_collection: i64, index_slot: i64, next_value: i64, start_block: i64, next_block: i64) -> PipelineLoweredBlocks {
  match for_ctx {
    PipelineForIterCtx(expr, params, locals, module, target_block) -> {
      let src = pipeline_lower_module_src(module)
      let tt = pipeline_lower_module_tt(module)
      let subst = pipeline_lower_module_subst(module)
      let concrete_collection_ty = if subst == 0 { collection_ty } else { ty_subst(collection_ty, subst) }
      let elem_ty = if ty_is_array(concrete_collection_ty) { ty_array_inner(concrete_collection_ty) } else { ty_slice_inner(concrete_collection_ty) }
      let fixed_len = if ty_is_array(concrete_collection_ty) { ty_array_length(concrete_collection_ty) } else { 0 - 1 }
      let body_block = next_block
      let exit_block = next_block + 1
      let advance_block = next_block + 2
      let body_expr_start = next_block + 3
      let body_next_block = next_block + 4

      let check_index = next_value
      let mut check_cursor = check_index + 1
      let mut check_insts = ir_inst_list_prepend(ir_inst_load_i64(check_index, index_slot), ir_inst_list_empty())
      let check_len = if fixed_len < 0 { collection_value + 1 } else { check_cursor }
      if fixed_len >= 0 {
        check_insts = ir_inst_list_append(check_insts, ir_inst_list_prepend(ir_inst_const_i64(check_len, fixed_len), ir_inst_list_empty()))
        check_cursor = check_cursor + 1
      } else { 0 }
      let has_item = check_cursor
      check_insts = ir_inst_list_append(check_insts, ir_inst_list_prepend(ir_inst_float_binary_i64(has_item, PRIM_USIZE(), IrLt, check_index, check_len), ir_inst_list_empty()))
      check_cursor = check_cursor + 1
      let check_node = ir_block_new_term(start_block, check_insts, ir_term_branch(has_item, body_block, exit_block))

      let body_index = check_cursor
      -- Reaching this block proves the branch condition above; the index starts
      -- at zero and advances by one while the collection length stays fixed.
      let item = pipeline_lower_indexed_get_after_values_typed_with_release(elem_ty, fixed_len, collection_value, body_index, body_index + 1, 0, pipeline_runtime_index_address_full_proven_hash(), pipeline_handler_lower_ctx_from_module(params, locals, module))
      if ir_lowered_expr_is_valid(item) == 0 { pipeline_lowered_blocks_invalid(start_block, next_value) }
      else {
        let item_value = ir_lowered_expr_value(item)
        let elem_hash = type_hash_of(elem_ty)
        let elem_prim = if elem_hash < 0 { (0 - elem_hash) - 1 } else { 0 - 1 }
        let elem_float = if elem_prim == PRIM_F64() { elem_prim } else { if elem_prim == PRIM_F32() { elem_prim } else { 0 } }
        let body_locals = pipeline_value_env_push_float_typed_node(locals, node_f1(expr), node_f2(expr), item_value, elem_float, elem_hash, elem_ty)
        let loop_ctx = pipeline_loop_ctx(params, body_locals, module, target_block, advance_block, advance_block, 1)
        let body_blocks = pipeline_lower_loop_body_to_target_blocks(node_f4(expr), loop_ctx, ir_lowered_expr_next_value(item), body_expr_start, body_next_block)
        if pipeline_lowered_loop_blocks_is_valid(body_blocks) == 0 { pipeline_lowered_blocks_invalid(start_block, next_value) }
        else {
          let item_cleanup_dst = pipeline_lowered_loop_blocks_next_value(body_blocks)
          let item_owned_hash = cg_owned_drop_type_hash(elem_ty)
          let item_release_count = pipeline_type_managed_release_lane_count(elem_ty)
          let item_cleanup_count = if item_release_count > 0 or item_owned_hash != 0 {
            pipeline_ir_block_list_loop_scope_cleanup_count(pipeline_lowered_loop_blocks_blocks(body_blocks), item_value, advance_block, advance_block, target_block)
          } else { 0 }
          let item_cleaned_blocks = if item_cleanup_count > 0 {
            if item_owned_hash != 0 {
              pipeline_ir_block_list_append_loop_owned_cleanup_indexed(pipeline_lowered_loop_blocks_blocks(body_blocks), item_value, item_owned_hash, 0, advance_block, advance_block, target_block)
            } else {
              pipeline_ir_block_list_append_loop_scope_cleanup_indexed(pipeline_lowered_loop_blocks_blocks(body_blocks), item_value, elem_ty, item_cleanup_dst, 0, advance_block, advance_block, target_block)
            }
          } else { pipeline_lowered_loop_blocks_blocks(body_blocks) }
          let item_cleanup_stride = if item_owned_hash != 0 { 1 } else { item_release_count }
          let after_item_cleanup = item_cleanup_dst + item_cleanup_count * item_cleanup_stride

          -- An owned collection temporary is released on break/return here;
          -- normal exhaustion releases it in the exit block below. Borrowed
          -- named arrays and all non-owning slices carry no collection cleanup.
          let collection_cleanup_count = if release_collection == 1 {
            pipeline_ir_block_list_loop_scope_cleanup_count(item_cleaned_blocks, collection_value, 0 - 1, 0 - 1, target_block)
          } else { 0 }
          let body_cleaned_blocks = if collection_cleanup_count > 0 {
            pipeline_ir_block_list_append_loop_scope_cleanup_indexed(item_cleaned_blocks, collection_value, concrete_collection_ty, after_item_cleanup, 0, 0 - 1, 0 - 1, target_block)
          } else { item_cleaned_blocks }
          let collection_cleanup_stride = pipeline_type_managed_release_lane_count(concrete_collection_ty)
          let after_collection_cleanup = after_item_cleanup + collection_cleanup_count * collection_cleanup_stride

          let advance_index = after_collection_cleanup
          let one_value = advance_index + 1
          let next_index = one_value + 1
          let advance_insts = ir_inst_list_prepend(
            ir_inst_load_i64(advance_index, index_slot),
            ir_inst_list_prepend(
              ir_inst_const_i64(one_value, 1),
              ir_inst_list_prepend(
                ir_inst_float_binary_i64(next_index, PRIM_USIZE(), IrAdd, advance_index, one_value),
                ir_inst_list_prepend(ir_inst_store_i64(index_slot, next_index), ir_inst_list_empty())
              )
            )
          )
          let advance_node = ir_block_new_term(advance_block, advance_insts, ir_term_jump(start_block))

          let exit_release_dst = next_index + 1
          let exit_release = if release_collection == 1 {
            pipeline_managed_release_inst_list(collection_value, concrete_collection_ty, exit_release_dst)
          } else { ir_inst_list_empty() }
          let nil_result = exit_release_dst + ir_inst_list_len(exit_release)
          let exit_insts = ir_inst_list_append(exit_release, ir_inst_list_prepend(ir_inst_const_i64(nil_result, 0), ir_inst_list_empty()))
          let exit_node = ir_block_new_term(exit_block, exit_insts, ir_term_jump_args(target_block, ir_value_list_prepend(nil_result, ir_value_list_empty())))
          let body_entry_insts = ir_inst_list_prepend(ir_inst_load_i64(body_index, index_slot), ir_lowered_expr_insts(item))
          let body_entry = ir_block_new_term(body_block, body_entry_insts, ir_term_jump(body_expr_start))
          let blocks = ir_block_list_prepend(
            check_node,
            ir_block_list_prepend(
              body_entry,
              ir_block_list_append(body_cleaned_blocks, ir_block_list_prepend(advance_node, ir_block_list_prepend(exit_node, ir_block_list_empty())))
            )
          )
          pipeline_lowered_blocks(pipeline_lowered_loop_blocks_next_block(body_blocks), nil_result + 1, blocks, 1)
        }
      }
    }
  }
}

fn pipeline_lower_for_indexed_iter_to_target_blocks(expr: i64, collection_ty: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let collection_expr = expr_from_node(node_f3(expr))
  let src = pipeline_lower_module_src(module)
  let collection_lanes = pipeline_type_value_lane_count_or_one(collection_ty)
  let release_collection = if ty_is_array(collection_ty) and pipeline_array_expr_result_is_borrowed_typed(collection_expr, src, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module), pipeline_lower_module_tt(module)) == 0 { 1 } else { 0 }
  if pipeline_expr_needs_lowering_cfg_typed(collection_expr, src) == 1 {
    let collection_merge_block = next_block
    let collection_blocks = pipeline_lower_expr_typed_to_target_blocks_reserved(collection_expr, params, locals, module, next_value, start_block, next_block + 1, collection_merge_block)
    if pipeline_lowered_blocks_is_valid(collection_blocks) == 0 { pipeline_lowered_blocks_invalid(start_block, next_value) }
    else { if pipeline_lowered_blocks_falls_through(collection_blocks) == 0 { collection_blocks }
    else {
      let collection_value = pipeline_lowered_blocks_next_value(collection_blocks)
      let index_slot = collection_value + collection_lanes
      let zero_value = index_slot + 1
      let loop_start = pipeline_lowered_blocks_next_block(collection_blocks)
      let init_insts = ir_inst_list_prepend(
        ir_inst_slot_i64(index_slot),
        ir_inst_list_prepend(
          ir_inst_const_i64(zero_value, 0),
          ir_inst_list_prepend(ir_inst_store_i64(index_slot, zero_value), ir_inst_list_empty())
        )
      )
      let collection_merge = ir_block_new_params(collection_merge_block, pipeline_ir_value_lane_ids(collection_value, 0, collection_lanes), init_insts, ir_term_jump(loop_start))
      let for_ctx = PipelineForIterCtx(expr, params, locals, module, target_block)
      let loop_blocks = pipeline_lower_for_indexed_iter_loop_to_target_blocks(for_ctx, collection_ty, collection_value, release_collection, index_slot, zero_value + 1, loop_start, loop_start + 1)
      if pipeline_lowered_blocks_is_valid(loop_blocks) == 0 { pipeline_lowered_blocks_invalid(start_block, next_value) }
      else {
        let blocks = ir_block_list_append(pipeline_lowered_blocks_blocks(collection_blocks), ir_block_list_prepend(collection_merge, pipeline_lowered_blocks_blocks(loop_blocks)))
        pipeline_lowered_blocks(pipeline_lowered_blocks_next_block(loop_blocks), pipeline_lowered_blocks_next_value(loop_blocks), blocks, 1)
      }
    } }
  } else {
    let collection = pipeline_lower_expr_typed_sidecar_handler_ctx(collection_expr, next_value, pipeline_handler_lower_ctx_from_module(params, locals, module))
    if ir_lowered_expr_is_valid(collection) == 0 { pipeline_lowered_blocks_invalid(start_block, next_value) }
    else {
      let index_slot = ir_lowered_expr_next_value(collection)
      let zero_value = index_slot + 1
      let init_insts = ir_inst_list_prepend(
        ir_inst_slot_i64(index_slot),
        ir_inst_list_prepend(
          ir_inst_const_i64(zero_value, 0),
          ir_inst_list_prepend(ir_inst_store_i64(index_slot, zero_value), ir_inst_list_empty())
        )
      )
      let loop_start = next_block
      let entry = ir_block_new_term(start_block, ir_inst_list_append(ir_lowered_expr_insts(collection), init_insts), ir_term_jump(loop_start))
      let for_ctx = PipelineForIterCtx(expr, params, locals, module, target_block)
      let loop_blocks = pipeline_lower_for_indexed_iter_loop_to_target_blocks(for_ctx, collection_ty, ir_lowered_expr_value(collection), release_collection, index_slot, zero_value + 1, loop_start, next_block + 1)
      if pipeline_lowered_blocks_is_valid(loop_blocks) == 0 { pipeline_lowered_blocks_invalid(start_block, next_value) }
      else {
        pipeline_lowered_blocks(
          pipeline_lowered_blocks_next_block(loop_blocks),
          pipeline_lowered_blocks_next_value(loop_blocks),
          ir_block_list_prepend(entry, pipeline_lowered_blocks_blocks(loop_blocks)),
          1
        )
      }
    }
  }
}

fn pipeline_lower_for_iter_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let collection_ty = pipeline_return_expr_type_node_from_node(node_f3(expr), params, locals, module)
  if ty_is_array(collection_ty) or ty_is_slice(collection_ty) {
    pipeline_lower_for_indexed_iter_to_target_blocks(expr, collection_ty, params, locals, module, next_value, start_block, next_block, target_block)
  } else {
    pipeline_lower_for_list_iter_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
  }
}

fn pipeline_lower_if_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let else_expr = node_f3(expr)
  if else_expr == 0 {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  } else {
    let cond_expr = node_f1(expr)
    let fns = pipeline_lower_module_fns(module)
    let subst = pipeline_lower_module_subst(module)
    let then_ty = pipeline_return_expr_type_node_from_node(node_f2(expr), params, locals, module)
    let else_ty = pipeline_return_expr_type_node_from_node(else_expr, params, locals, module)
    let then_borrowed = pipeline_expr_node_result_is_borrowed_for_ty_typed(node_f2(expr), then_ty, src, fns, subst, tt)
    let else_borrowed = pipeline_expr_node_result_is_borrowed_for_ty_typed(else_expr, else_ty, src, fns, subst, tt)
    let whole_borrowed = if then_borrowed == 1 { else_borrowed } else { 0 }
    let then_retain_hash = pipeline_managed_arm_needs_retain(then_borrowed, whole_borrowed, then_ty)
    let else_retain_hash = pipeline_managed_arm_needs_retain(else_borrowed, whole_borrowed, else_ty)
    if pipeline_expr_needs_cfg(cond_expr) == 1 {
      let cond_merge_block = pipeline_lower_internal_block_after_target(next_block, target_block)
      let cond_blocks = pipeline_lower_expr_to_target_blocks_reserved(cond_expr, params, locals, module, next_value, start_block, cond_merge_block + 1, cond_merge_block)
      if pipeline_lowered_blocks_is_valid(cond_blocks) == 1 {
        if pipeline_lowered_blocks_falls_through(cond_blocks) == 0 {
          cond_blocks
        } else {
          let cond_value = pipeline_lowered_blocks_next_value(cond_blocks)
          let then_start = pipeline_lower_internal_block_after_target(pipeline_lowered_blocks_next_block(cond_blocks), target_block)
          let else_seed = pipeline_lower_internal_block_after_target(then_start + 1, target_block)
          let then_retain_block = if then_retain_hash != 0 { pipeline_lower_internal_block_after_target(else_seed + 1, target_block) } else { 0 }
          let then_target = if then_retain_hash != 0 { then_retain_block } else { target_block }
          let then_inner_next = if then_retain_hash != 0 { pipeline_lower_internal_block_after_target(then_retain_block + 1, target_block) } else { pipeline_lower_internal_block_after_target(else_seed + 1, target_block) }
          let then_blocks_raw = pipeline_lower_expr_to_target_blocks_reserved(node_f2(expr), params, locals, module, cond_value + 1, then_start, then_inner_next, then_target)
          let then_blocks = pipeline_managed_arm_retain_append(then_blocks_raw, then_retain_hash, then_ty, then_retain_block, target_block)
          if pipeline_lowered_blocks_is_valid(then_blocks) == 1 {
            let else_start = pipeline_lower_internal_block_after_target(pipeline_ir_max_i64(pipeline_lowered_blocks_next_block(then_blocks), else_seed), target_block)
            let else_retain_block = if else_retain_hash != 0 { pipeline_lower_internal_block_after_target(else_start + 1, target_block) } else { 0 }
            let else_target = if else_retain_hash != 0 { else_retain_block } else { target_block }
            let else_inner_next = if else_retain_hash != 0 { pipeline_lower_internal_block_after_target(else_retain_block + 1, target_block) } else { pipeline_lower_internal_block_after_target(else_start + 1, target_block) }
            let else_blocks_raw = pipeline_lower_expr_to_target_blocks_reserved(else_expr, params, locals, module, pipeline_lowered_blocks_next_value(then_blocks), else_start, else_inner_next, else_target)
            let else_blocks = pipeline_managed_arm_retain_append(else_blocks_raw, else_retain_hash, else_ty, else_retain_block, target_block)
            if pipeline_lowered_blocks_is_valid(else_blocks) == 1 {
              let cond_params = ir_value_list_prepend(cond_value, ir_value_list_empty())
              let cond_merge = ir_block_new_params(cond_merge_block, cond_params, ir_inst_list_empty(), ir_term_branch(cond_value, then_start, else_start))
              let falls_through = if pipeline_lowered_blocks_falls_through(then_blocks) == 1 { 1 } else { pipeline_lowered_blocks_falls_through(else_blocks) }
              let blocks = ir_block_list_append(
                pipeline_lowered_blocks_blocks(cond_blocks),
                ir_block_list_prepend(
                  cond_merge,
                  ir_block_list_append(pipeline_lowered_blocks_blocks(then_blocks), pipeline_lowered_blocks_blocks(else_blocks))
                )
              )
              pipeline_lowered_blocks_control(pipeline_lowered_blocks_next_block(else_blocks), pipeline_lowered_blocks_next_value(else_blocks), blocks, 1, falls_through)
            } else {
              pipeline_lowered_blocks_invalid(start_block, next_value)
            }
          } else {
            pipeline_lowered_blocks_invalid(start_block, next_value)
          }
        }
      } else {
        pipeline_lowered_blocks_invalid(start_block, next_value)
      }
    } else {
      let cond = pipeline_lower_expr_node_with_module_ctx(cond_expr, params, locals, module, next_value)
      if ir_lowered_expr_is_valid(cond) == 1 {
        let then_start = pipeline_lower_internal_block_after_target(next_block, target_block)
        let else_seed = pipeline_lower_internal_block_after_target(then_start + 1, target_block)
        let then_retain_block = if then_retain_hash != 0 { pipeline_lower_internal_block_after_target(else_seed + 1, target_block) } else { 0 }
        let then_target = if then_retain_hash != 0 { then_retain_block } else { target_block }
        let then_inner_next = if then_retain_hash != 0 { pipeline_lower_internal_block_after_target(then_retain_block + 1, target_block) } else { pipeline_lower_internal_block_after_target(else_seed + 1, target_block) }
        let then_blocks_raw = pipeline_lower_expr_to_target_blocks_reserved(node_f2(expr), params, locals, module, ir_lowered_expr_next_value(cond), then_start, then_inner_next, then_target)
        let then_blocks = pipeline_managed_arm_retain_append(then_blocks_raw, then_retain_hash, then_ty, then_retain_block, target_block)
        if pipeline_lowered_blocks_is_valid(then_blocks) == 1 {
          let else_start = pipeline_lower_internal_block_after_target(pipeline_ir_max_i64(pipeline_lowered_blocks_next_block(then_blocks), else_seed), target_block)
          let else_retain_block = if else_retain_hash != 0 { pipeline_lower_internal_block_after_target(else_start + 1, target_block) } else { 0 }
          let else_target = if else_retain_hash != 0 { else_retain_block } else { target_block }
          let else_inner_next = if else_retain_hash != 0 { pipeline_lower_internal_block_after_target(else_retain_block + 1, target_block) } else { pipeline_lower_internal_block_after_target(else_start + 1, target_block) }
          let else_blocks_raw = pipeline_lower_expr_to_target_blocks_reserved(else_expr, params, locals, module, pipeline_lowered_blocks_next_value(then_blocks), else_start, else_inner_next, else_target)
          let else_blocks = pipeline_managed_arm_retain_append(else_blocks_raw, else_retain_hash, else_ty, else_retain_block, target_block)
          if pipeline_lowered_blocks_is_valid(else_blocks) == 1 {
            let entry = ir_block_new_term(start_block, ir_lowered_expr_insts(cond), ir_term_branch(ir_lowered_expr_value(cond), then_start, else_start))
            let falls_through = if pipeline_lowered_blocks_falls_through(then_blocks) == 1 { 1 } else { pipeline_lowered_blocks_falls_through(else_blocks) }
            let blocks = ir_block_list_prepend(
              entry,
              ir_block_list_append(pipeline_lowered_blocks_blocks(then_blocks), pipeline_lowered_blocks_blocks(else_blocks))
            )
            pipeline_lowered_blocks_control(pipeline_lowered_blocks_next_block(else_blocks), pipeline_lowered_blocks_next_value(else_blocks), blocks, 1, falls_through)
          } else {
            pipeline_lowered_blocks_invalid(start_block, next_value)
          }
        } else {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        }
      } else {
        pipeline_lowered_blocks_invalid(start_block, next_value)
      }
    }
  }
}

fn pipeline_lower_binop_lhs_cfg_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let op = ir_binary_op_from_parser(node_f1(expr))
  let float_prim = pipeline_binop_float_prim_node_temp(node_f1(expr), node_f2(expr), node_f3(expr), params, locals, src, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module))
  let int_prim = if float_prim == 0 {
    pipeline_binop_int_prim_node(node_f1(expr), node_f2(expr), node_f3(expr), params, locals, src, tt, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module))
  } else { 0 - 1 }
  let numeric_prim = if float_prim != 0 { float_prim } else { int_prim }
  let lhs_merge_block = next_block
  let lhs_blocks = pipeline_lower_expr_to_target_blocks_reserved(node_f2(expr), params, locals, module, next_value, start_block, next_block + 1, lhs_merge_block)
  if pipeline_lowered_blocks_is_valid(lhs_blocks) == 1 {
    if pipeline_lowered_blocks_falls_through(lhs_blocks) == 0 {
      lhs_blocks
    } else {
      let lhs_value = pipeline_lowered_blocks_next_value(lhs_blocks)
      let body_start = pipeline_lowered_blocks_next_block(lhs_blocks)
      let lower_ctx = pipeline_handler_lower_ctx_from_module(params, locals, module)
      let rhs = if float_prim != 0 or int_prim >= 0 {
        pipeline_lower_expr_node_typed_sidecar_handler_opt_with_float_prim(node_f3(expr), lhs_value + 1, lower_ctx, numeric_prim)
      } else {
        pipeline_lower_expr_node_with_module_ctx(node_f3(expr), params, locals, module, lhs_value + 1)
      }
      if ir_lowered_expr_is_valid(rhs) == 1 {
        let dst = ir_lowered_expr_next_value(rhs)
        -- str ==/!= is CONTENT equality at every lowering site: the CFG
        -- binop variants must make the same selection as the straight-line
        -- paths or a str compare silently becomes pointer identity
        -- (miscompile class found 2026-08-03: eq inside a while body).
        let str_eq = if float_prim == 0 and int_prim < 0 { pipeline_binop_is_str_content_eq(node_f1(expr), expr_from_node(node_f2(expr)), expr_from_node(node_f3(expr)), params, locals, src, tt, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module)) } else { 0 }
        let binary = if str_eq == 1 {
          pipeline_str_content_eq_insts(node_f1(expr), dst, lhs_value, ir_lowered_expr_value(rhs))
        } else {
          let inst = if float_prim != 0 {
            ir_inst_float_binary_i64(dst, float_prim, op, lhs_value, ir_lowered_expr_value(rhs))
          } else { if int_prim >= 0 {
            ir_inst_float_binary_i64(dst, int_prim, op, lhs_value, ir_lowered_expr_value(rhs))
          } else {
            ir_inst_binary_i64(dst, op, lhs_value, ir_lowered_expr_value(rhs))
          } }
          ir_inst_list_prepend(
            inst,
            ir_inst_list_empty()
          )
        }
        let result = if str_eq == 1 { pipeline_str_content_eq_result(node_f1(expr), dst) } else { dst }
        let body_insts = ir_inst_list_append(ir_lowered_expr_insts(rhs), binary)
        let body_args = ir_value_list_prepend(result, ir_value_list_empty())
        let lhs_params = ir_value_list_prepend(lhs_value, ir_value_list_empty())
        let lhs_merge = ir_block_new_params(lhs_merge_block, lhs_params, ir_inst_list_empty(), ir_term_jump(body_start))
        let body_block = ir_block_new_term(body_start, body_insts, ir_term_jump_args(target_block, body_args))
        let blocks = ir_block_list_append(
          pipeline_lowered_blocks_blocks(lhs_blocks),
          ir_block_list_prepend(lhs_merge, ir_block_list_prepend(body_block, ir_block_list_empty()))
        )
        pipeline_lowered_blocks(body_start + 1, result + 1, blocks, 1)
      } else {
        pipeline_lowered_blocks_invalid(start_block, next_value)
      }
    }
  } else {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  }
}

fn pipeline_lower_binop_rhs_cfg_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let op = ir_binary_op_from_parser(node_f1(expr))
  let float_prim = pipeline_binop_float_prim_node_temp(node_f1(expr), node_f2(expr), node_f3(expr), params, locals, src, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module))
  let int_prim = if float_prim == 0 {
    pipeline_binop_int_prim_node(node_f1(expr), node_f2(expr), node_f3(expr), params, locals, src, tt, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module))
  } else { 0 - 1 }
  let numeric_prim = if float_prim != 0 { float_prim } else { int_prim }
  let lower_ctx = pipeline_handler_lower_ctx_from_module(params, locals, module)
  let lhs = if float_prim != 0 or int_prim >= 0 {
    pipeline_lower_expr_node_typed_sidecar_handler_opt_with_float_prim(node_f2(expr), next_value, lower_ctx, numeric_prim)
  } else {
    pipeline_lower_expr_node_with_module_ctx(node_f2(expr), params, locals, module, next_value)
  }
  if ir_lowered_expr_is_valid(lhs) == 1 {
    let rhs_merge_block = next_block
    let rhs_start = next_block + 1
    let rhs_blocks = pipeline_lower_expr_to_target_blocks_reserved(node_f3(expr), params, locals, module, ir_lowered_expr_next_value(lhs), rhs_start, next_block + 2, rhs_merge_block)
    if pipeline_lowered_blocks_is_valid(rhs_blocks) == 1 {
      let lhs_entry = ir_block_new_term(start_block, ir_lowered_expr_insts(lhs), ir_term_jump(rhs_start))
      if pipeline_lowered_blocks_falls_through(rhs_blocks) == 0 {
        let blocks = ir_block_list_prepend(lhs_entry, pipeline_lowered_blocks_blocks(rhs_blocks))
        pipeline_lowered_blocks_control(pipeline_lowered_blocks_next_block(rhs_blocks), pipeline_lowered_blocks_next_value(rhs_blocks), blocks, 1, 0)
      } else {
        let rhs_value = pipeline_lowered_blocks_next_value(rhs_blocks)
        let body_start = pipeline_lowered_blocks_next_block(rhs_blocks)
        let dst = rhs_value + 1
        -- Same content-eq selection as the straight-line paths (see
        -- pipeline_lower_binop_lhs_cfg_to_target_blocks).
        let str_eq = if float_prim == 0 and int_prim < 0 { pipeline_binop_is_str_content_eq(node_f1(expr), expr_from_node(node_f2(expr)), expr_from_node(node_f3(expr)), params, locals, src, tt, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module)) } else { 0 }
        let binary = if str_eq == 1 {
          pipeline_str_content_eq_insts(node_f1(expr), dst, ir_lowered_expr_value(lhs), rhs_value)
        } else {
          let inst = if float_prim != 0 {
            ir_inst_float_binary_i64(dst, float_prim, op, ir_lowered_expr_value(lhs), rhs_value)
          } else { if int_prim >= 0 {
            ir_inst_float_binary_i64(dst, int_prim, op, ir_lowered_expr_value(lhs), rhs_value)
          } else {
            ir_inst_binary_i64(dst, op, ir_lowered_expr_value(lhs), rhs_value)
          } }
          ir_inst_list_prepend(
            inst,
            ir_inst_list_empty()
          )
        }
        let result = if str_eq == 1 { pipeline_str_content_eq_result(node_f1(expr), dst) } else { dst }
        let body_args = ir_value_list_prepend(result, ir_value_list_empty())
        let rhs_params = ir_value_list_prepend(rhs_value, ir_value_list_empty())
        let rhs_merge = ir_block_new_params(rhs_merge_block, rhs_params, ir_inst_list_empty(), ir_term_jump(body_start))
        let body_block = ir_block_new_term(body_start, binary, ir_term_jump_args(target_block, body_args))
        let blocks = ir_block_list_prepend(
          lhs_entry,
          ir_block_list_append(
            pipeline_lowered_blocks_blocks(rhs_blocks),
            ir_block_list_prepend(rhs_merge, ir_block_list_prepend(body_block, ir_block_list_empty()))
          )
        )
        pipeline_lowered_blocks(body_start + 1, result + 1, blocks, 1)
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  } else {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  }
}

fn pipeline_lower_binop_both_cfg_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let op = ir_binary_op_from_parser(node_f1(expr))
  let float_prim = pipeline_binop_float_prim_node_temp(node_f1(expr), node_f2(expr), node_f3(expr), params, locals, src, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module))
  let int_prim = if float_prim == 0 {
    pipeline_binop_int_prim_node(node_f1(expr), node_f2(expr), node_f3(expr), params, locals, src, tt, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module))
  } else { 0 - 1 }
  let lhs_merge_block = next_block
  let lhs_blocks = pipeline_lower_expr_to_target_blocks_reserved(node_f2(expr), params, locals, module, next_value, start_block, next_block + 1, lhs_merge_block)
  if pipeline_lowered_blocks_is_valid(lhs_blocks) == 1 {
    if pipeline_lowered_blocks_falls_through(lhs_blocks) == 0 {
      lhs_blocks
    } else {
      let lhs_value = pipeline_lowered_blocks_next_value(lhs_blocks)
      let rhs_start = pipeline_lowered_blocks_next_block(lhs_blocks)
      let rhs_merge_block = rhs_start + 1
      let rhs_blocks = pipeline_lower_expr_to_target_blocks_reserved(node_f3(expr), params, locals, module, lhs_value + 1, rhs_start, rhs_start + 2, rhs_merge_block)
      if pipeline_lowered_blocks_is_valid(rhs_blocks) == 1 {
        let lhs_params = ir_value_list_prepend(lhs_value, ir_value_list_empty())
        let lhs_merge = ir_block_new_params(lhs_merge_block, lhs_params, ir_inst_list_empty(), ir_term_jump(rhs_start))
        if pipeline_lowered_blocks_falls_through(rhs_blocks) == 0 {
          let blocks = ir_block_list_append(
            pipeline_lowered_blocks_blocks(lhs_blocks),
            ir_block_list_prepend(lhs_merge, pipeline_lowered_blocks_blocks(rhs_blocks))
          )
          pipeline_lowered_blocks_control(pipeline_lowered_blocks_next_block(rhs_blocks), pipeline_lowered_blocks_next_value(rhs_blocks), blocks, 1, 0)
        } else {
          let rhs_value = pipeline_lowered_blocks_next_value(rhs_blocks)
          let body_start = pipeline_lowered_blocks_next_block(rhs_blocks)
          let dst = rhs_value + 1
          -- Same content-eq selection as the straight-line paths (see
          -- pipeline_lower_binop_lhs_cfg_to_target_blocks).
          let str_eq = if float_prim == 0 and int_prim < 0 { pipeline_binop_is_str_content_eq(node_f1(expr), expr_from_node(node_f2(expr)), expr_from_node(node_f3(expr)), params, locals, src, tt, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module)) } else { 0 }
          let binary = if str_eq == 1 {
            pipeline_str_content_eq_insts(node_f1(expr), dst, lhs_value, rhs_value)
          } else {
            let inst = if float_prim != 0 {
              ir_inst_float_binary_i64(dst, float_prim, op, lhs_value, rhs_value)
            } else { if int_prim >= 0 {
              ir_inst_float_binary_i64(dst, int_prim, op, lhs_value, rhs_value)
            } else {
              ir_inst_binary_i64(dst, op, lhs_value, rhs_value)
            } }
            ir_inst_list_prepend(
              inst,
              ir_inst_list_empty()
            )
          }
          let result = if str_eq == 1 { pipeline_str_content_eq_result(node_f1(expr), dst) } else { dst }
          let body_args = ir_value_list_prepend(result, ir_value_list_empty())
          let rhs_params = ir_value_list_prepend(rhs_value, ir_value_list_empty())
          let rhs_merge = ir_block_new_params(rhs_merge_block, rhs_params, ir_inst_list_empty(), ir_term_jump(body_start))
          let body_block = ir_block_new_term(body_start, binary, ir_term_jump_args(target_block, body_args))
          let blocks = ir_block_list_append(
            pipeline_lowered_blocks_blocks(lhs_blocks),
            ir_block_list_prepend(
              lhs_merge,
              ir_block_list_append(
                pipeline_lowered_blocks_blocks(rhs_blocks),
                ir_block_list_prepend(rhs_merge, ir_block_list_prepend(body_block, ir_block_list_empty()))
              )
            )
          )
          pipeline_lowered_blocks(body_start + 1, result + 1, blocks, 1)
        }
      } else {
        pipeline_lowered_blocks_invalid(start_block, next_value)
      }
    }
  } else {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  }
}

fn pipeline_lower_logical_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let op = node_f1(expr)
  let lhs_merge_block = next_block
  let lhs_blocks = pipeline_lower_expr_to_target_blocks_reserved(node_f2(expr), params, locals, module, next_value, start_block, next_block + 1, lhs_merge_block)
  if pipeline_lowered_blocks_is_valid(lhs_blocks) == 1 {
    if pipeline_lowered_blocks_falls_through(lhs_blocks) == 0 {
      lhs_blocks
    } else {
      let lhs_value = pipeline_lowered_blocks_next_value(lhs_blocks)
      let rhs_start = pipeline_lowered_blocks_next_block(lhs_blocks)
      let rhs_blocks = pipeline_lower_expr_to_target_blocks_reserved(node_f3(expr), params, locals, module, lhs_value + 1, rhs_start, rhs_start + 1, target_block)
      if pipeline_lowered_blocks_is_valid(rhs_blocks) == 1 {
        let const_block = pipeline_lowered_blocks_next_block(rhs_blocks)
        let const_value = pipeline_lowered_blocks_next_value(rhs_blocks)
        let const_lit = if op == 12 { 0 } else { 1 }
        let const_inst = ir_inst_list_prepend(ir_inst_const_i64(const_value, const_lit), ir_inst_list_empty())
        let const_args = ir_value_list_prepend(const_value, ir_value_list_empty())
        let const_node = ir_block_new_term(const_block, const_inst, ir_term_jump_args(target_block, const_args))
        let lhs_params = ir_value_list_prepend(lhs_value, ir_value_list_empty())
        let lhs_term = if op == 12 {
          ir_term_branch(lhs_value, rhs_start, const_block)
        } else {
          ir_term_branch(lhs_value, const_block, rhs_start)
        }
        let lhs_merge = ir_block_new_params(lhs_merge_block, lhs_params, ir_inst_list_empty(), lhs_term)
        let blocks = ir_block_list_append(
          pipeline_lowered_blocks_blocks(lhs_blocks),
          ir_block_list_prepend(
            lhs_merge,
            ir_block_list_append(
              pipeline_lowered_blocks_blocks(rhs_blocks),
              ir_block_list_prepend(const_node, ir_block_list_empty())
            )
          )
        )
        pipeline_lowered_blocks(const_block + 1, const_value + 1, blocks, 1)
      } else {
        pipeline_lowered_blocks_invalid(start_block, next_value)
      }
    }
  } else {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  }
}

fn pipeline_lower_binop_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let op = ir_binary_op_from_parser(node_f1(expr))
  if node_f1(expr) == 12 or node_f1(expr) == 13 {
    pipeline_lower_logical_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
  } else { if ir_binary_op_is_supported(op) == 1 {
    if pipeline_expr_needs_cfg(node_f2(expr)) == 1 {
      if pipeline_expr_needs_cfg(node_f3(expr)) == 1 {
        pipeline_lower_binop_both_cfg_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      } else {
        pipeline_lower_binop_lhs_cfg_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      }
    } else {
      if pipeline_expr_needs_cfg(node_f3(expr)) == 1 {
        pipeline_lower_binop_rhs_cfg_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      } else {
        pipeline_lower_straight_expr_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      }
    }
  } else {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  } }
}

fn pipeline_lower_not_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let value_expr = node_f1(expr)
  if pipeline_expr_needs_cfg(value_expr) == 1 {
    let value_merge_block = next_block
    let value_blocks = pipeline_lower_expr_to_target_blocks_reserved(value_expr, params, locals, module, next_value, start_block, next_block + 1, value_merge_block)
    if pipeline_lowered_blocks_is_valid(value_blocks) == 1 {
      if pipeline_lowered_blocks_falls_through(value_blocks) == 0 {
        value_blocks
      } else {
        let value = pipeline_lowered_blocks_next_value(value_blocks)
        let dst = value + 1
        let value_params = ir_value_list_prepend(value, ir_value_list_empty())
        let result_args = ir_value_list_prepend(dst, ir_value_list_empty())
        let not_inst = ir_inst_list_prepend(ir_inst_unary_i64(dst, ir_unary_op_not(), value), ir_inst_list_empty())
        let merge = ir_block_new_params(value_merge_block, value_params, not_inst, ir_term_jump_args(target_block, result_args))
        let blocks = ir_block_list_append(
          pipeline_lowered_blocks_blocks(value_blocks),
          ir_block_list_prepend(merge, ir_block_list_empty())
        )
        pipeline_lowered_blocks(pipeline_lowered_blocks_next_block(value_blocks), dst + 1, blocks, 1)
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  } else {
    pipeline_lower_straight_expr_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
  }
}

fn pipeline_lower_try_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let value_expr = node_f1(expr)
  if pipeline_expr_needs_cfg(value_expr) == 1 {
    let value_merge_block = next_block
    let value_blocks = pipeline_lower_expr_to_target_blocks_reserved(value_expr, params, locals, module, next_value, start_block, next_block + 1, value_merge_block)
    if pipeline_lowered_blocks_is_valid(value_blocks) == 1 {
      if pipeline_lowered_blocks_falls_through(value_blocks) == 0 {
        value_blocks
      } else {
        let value = pipeline_lowered_blocks_next_value(value_blocks)
        let dst = value + 1
        let value_params = ir_value_list_prepend(value, ir_value_list_empty())
        let result_args = ir_value_list_prepend(dst, ir_value_list_empty())
        let effect_key = pipeline_effect_atom_dispatch_key(node_f2(expr), pipeline_lower_module_subst(module), effect_fail_head_hash())
        let try_inst = ir_inst_list_prepend(ir_inst_try_i64(dst, value, effect_key), ir_inst_list_empty())
        let merge = ir_block_new_params(value_merge_block, value_params, try_inst, ir_term_jump_args(target_block, result_args))
        let blocks = ir_block_list_append(
          pipeline_lowered_blocks_blocks(value_blocks),
          ir_block_list_prepend(merge, ir_block_list_empty())
        )
        pipeline_lowered_blocks(pipeline_lowered_blocks_next_block(value_blocks), dst + 1, blocks, 1)
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  } else {
    pipeline_lower_straight_expr_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
  }
}

fn pipeline_lower_weak_call_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let ns = node_f1(expr)
  let nl = node_f2(expr)
  let arg_count = node_f4(expr)
  if arg_count != 1 {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  } else {
    if src_eq(src, ns, nl, "weak_ref") == 1 or src_eq(src, ns, nl, "weak_load") == 1 {
      let call_block = next_block
      let first_arg_block = pipeline_lower_operation_child_start_block(call_block, arg_count)
      let ctx = pipeline_call_arg_ctx_with_fns(node_f3(expr), arg_count, params, locals, src, pipeline_lower_module_tt(module), call_block, pipeline_lower_module_fns(module))
      let lowered_args = pipeline_lower_call_arg_blocks(ctx, 0, next_value, first_arg_block, ir_value_list_empty())
      if pipeline_lowered_call_blocks_is_valid(lowered_args) == 1 {
        let entry = ir_block_new_term(start_block, ir_inst_list_empty(), ir_term_jump(first_arg_block))
        if pipeline_lowered_call_blocks_falls_through(lowered_args) == 0 {
          let blocks = ir_block_list_prepend(entry, pipeline_lowered_call_blocks_blocks(lowered_args))
          pipeline_lowered_blocks_control(pipeline_lowered_call_blocks_next_block(lowered_args), pipeline_lowered_call_blocks_next_value(lowered_args), blocks, 1, 0)
        } else {
          let value = pipeline_ir_value_list_get_or(pipeline_lowered_call_blocks_values(lowered_args), 0, 0 - 1)
          let dst = pipeline_lowered_call_blocks_next_value(lowered_args)
          let runtime_hash = if src_eq(src, ns, nl, "weak_ref") == 1 { pipeline_rc_default_weak_retain_hash() } else { pipeline_rc_default_weak_load_hash() }
          let runtime_args = ir_value_list_prepend(value, ir_value_list_empty())
          let call_inst = ir_inst_list_prepend(ir_inst_call_i64(dst, runtime_hash, runtime_args), ir_inst_list_empty())
          let result_value = if src_eq(src, ns, nl, "weak_ref") == 1 { value } else { dst }
          let call_args = ir_value_list_prepend(result_value, ir_value_list_empty())
          let call = ir_block_new_term(call_block, call_inst, ir_term_jump_args(target_block, call_args))
          let blocks = ir_block_list_prepend(entry, ir_block_list_append(pipeline_lowered_call_blocks_blocks(lowered_args), ir_block_list_prepend(call, ir_block_list_empty())))
          pipeline_lowered_blocks(pipeline_lowered_call_blocks_next_block(lowered_args), dst + 1, blocks, 1)
        }
      } else {
        pipeline_lowered_blocks_invalid(start_block, next_value)
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  }
}

fn pipeline_lower_call_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let fns = pipeline_lower_module_fns(module)
  let subst = pipeline_lower_module_subst(module)
  let direct = pipeline_call_callee_is_direct(params, locals, src, node_f1(expr), node_f2(expr))
  let callee_value = pipeline_call_callee_value(params, locals, src, node_f1(expr), node_f2(expr))
  let callee_slot = pipeline_call_callee_slot(locals, src, node_f1(expr), node_f2(expr))
  let callee_type_node = pipeline_call_callee_type_node(params, locals, src, node_f1(expr), node_f2(expr), subst)
  let indirect_expected_types = pipeline_call_indirect_expected_types(direct, callee_type_node)
  let weak = pipeline_lower_weak_call_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
  if pipeline_lowered_blocks_is_valid(weak) == 1 {
    weak
  } else {
    let scaled_raw = pipeline_lower_scaled_raw_call_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
    if pipeline_lowered_blocks_is_valid(scaled_raw) == 1 {
      scaled_raw
    } else {
    let bridge_mem = pipeline_lower_bridge_mem_call_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
    if pipeline_lowered_blocks_is_valid(bridge_mem) == 1 {
      bridge_mem
    } else { if direct == 1 or callee_value >= 0 or callee_slot >= 0 {
    let call_block = next_block
    let arg_count = node_f4(expr)
    let first_arg_block = pipeline_lower_operation_child_start_block(call_block, arg_count)
    let arg_start_value = if callee_slot >= 0 { next_value + 1 } else { next_value }
    let entry_insts = if callee_slot >= 0 {
      ir_inst_list_prepend(ir_inst_load_i64(next_value, callee_slot), ir_inst_list_empty())
    } else { ir_inst_list_empty() }
    let base_ctx = pipeline_call_arg_ctx_with_fns(node_f3(expr), arg_count, params, locals, src, tt, call_block, fns)
    let variant_payloads = if direct == 1 { pipeline_variant_payload_types(tt, src, node_f1(expr), node_f2(expr)) } else { 0 }
    let expected_params = if variant_payloads == 0 and direct == 1 {
      pipeline_fns_lookup_params(fns, src, node_f1(expr), node_f2(expr))
    } else { if indirect_expected_types != 0 {
      pipeline_call_expected_param_nodes_from_types(indirect_expected_types)
    } else { 0 } }
    let direct_fn = if direct == 1 { pipeline_fns_lookup_pair(fns, src, node_f1(expr), node_f2(expr)) } else { 0 }
    let result_ty = pipeline_call_result_type_node(params, locals, src, tt, fns, subst, node_f1(expr), node_f2(expr))
    let ctx = pipeline_call_arg_ctx_expected(base_ctx, expected_params, 0)
    let lowered_args = pipeline_lower_call_arg_blocks(ctx, 0, arg_start_value, first_arg_block, ir_value_list_empty())
    if pipeline_lowered_call_blocks_is_valid(lowered_args) == 1 {
      let entry = ir_block_new_term(start_block, entry_insts, ir_term_jump(first_arg_block))
      if pipeline_lowered_call_blocks_falls_through(lowered_args) == 0 {
        let blocks = ir_block_list_prepend(entry, pipeline_lowered_call_blocks_blocks(lowered_args))
        pipeline_lowered_blocks_control(
          pipeline_lowered_call_blocks_next_block(lowered_args),
          pipeline_lowered_call_blocks_next_value(lowered_args),
          blocks,
          1,
          0
        )
      } else {
        let call_dst = pipeline_lowered_call_blocks_next_value(lowered_args)
        let indirect_callee = if callee_slot >= 0 { next_value } else { callee_value }
        let logical_args = pipeline_lowered_call_blocks_values(lowered_args)
        let abi_args = if variant_payloads != 0 {
          pipeline_call_abi_args(logical_args, 0, variant_payloads, subst, 0, 0)
        } else { if expected_params != 0 {
          pipeline_call_abi_args(logical_args, expected_params, 0, subst, 0, 0)
        } else { logical_args } }
        let call_head = ir_inst_list_prepend(
          pipeline_call_inst_resolved(call_dst, direct, indirect_callee, src, tt, node_f1(expr), node_f2(expr), abi_args),
          ir_inst_list_empty()
        )
        let borrowed_mask = if direct == 1 {
          pipeline_call_borrowable_param_mask(fns, src, node_f1(expr), node_f2(expr), expected_params, subst)
        } else { 0 }
        let result_lanes = if result_ty != 0 { pipeline_type_value_lane_count_or_one(result_ty) } else { 1 }
        let call_result_lanes = if result_ty != 0 { pipeline_ir_call_result_lane_insts(call_dst, result_ty) } else { ir_inst_list_empty() }
        let cleanup = pipeline_managed_lambda_temp_release_arg_nodes_masked(node_f3(expr), arg_count, logical_args, 0, call_dst + result_lanes, borrowed_mask, 0, expected_params, variant_payloads, subst, pipeline_lower_module_src(module), pipeline_lower_module_tt(module))
        let call_args = pipeline_ir_value_lane_ids(call_dst, 0, result_lanes)
        let call = ir_block_new_term(call_block, ir_inst_list_append(call_head, ir_inst_list_append(call_result_lanes, pipeline_lowered_args_insts(cleanup))), ir_term_jump_args(target_block, call_args))
        let blocks = ir_block_list_prepend(
          entry,
          ir_block_list_append(pipeline_lowered_call_blocks_blocks(lowered_args), ir_block_list_prepend(call, ir_block_list_empty()))
        )
        pipeline_lowered_blocks(pipeline_lowered_call_blocks_next_block(lowered_args), pipeline_lowered_args_next_value(cleanup), blocks, 1)
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  } else {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  } } }
  }
}

fn pipeline_lower_perform_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  pipeline_lower_perform_typed_to_target_blocks(
    expr_from_node(node_f1(expr)),
    node_f2(expr),
    node_f3(expr),
    expr_list_from_nodes(node_f4(expr), 0, nlist_len(node_f4(expr))),
    params,
    locals,
    module,
    next_value,
    start_block,
    next_block,
    target_block
  )
}

fn pipeline_ir_handle_inst_list_typed(src: i64, eff_hash: i64, clauses: IrHandlerClauseBodyList, nclauses: i64, body_insts: IrInstList) -> IrInstList {
  let pop = ir_inst_list_prepend(ir_inst_handler_pop_i64(0 - 1), ir_inst_list_empty())
  let body_then_pop = ir_inst_list_append(body_insts, pop)
  ir_inst_list_prepend(IrHandleI64(0 - 1, src, eff_hash, clauses, nclauses, 0 - 1), body_then_pop)
}

fn pipeline_ir_handle_inst_list_nodes(src: i64, eff_hash: i64, clauses: IrHandlerClauseBodyList, nclauses: i64, body_insts: IrInstList) -> IrInstList {
  let pop = ir_inst_list_prepend(ir_inst_handler_pop_i64(0 - 1), ir_inst_list_empty())
  let body_then_pop = ir_inst_list_append(body_insts, pop)
  ir_inst_list_prepend(IrHandleI64(0 - 1, src, eff_hash, clauses, nclauses, 0 - 1), body_then_pop)
}

fn pipeline_lower_handle_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let body_expr = node_f1(expr)
  let clauses = node_f2(expr)
  let nclauses = node_f3(expr)
  if nclauses <= 0 {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  } else {
    let typed_clauses = handler_clause_list_from_nodes(clauses, 0, nclauses)
    pipeline_lower_handle_typed_to_target_blocks(expr_from_node(body_expr), typed_clauses, handle_return_from_node(node_f4(expr)), params, locals, module, next_value, start_block, next_block, target_block)
  }
}

fn pipeline_lower_generic_call_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let call_node = node_f2(expr)
  if pipeline_call_callee_is_direct(params, locals, src, node_f1(call_node), node_f2(call_node)) == 1 {
    let call_block = next_block
    let arg_count = node_f4(call_node)
    let first_arg_block = pipeline_lower_operation_child_start_block(call_block, arg_count)
    let base_ctx = pipeline_call_arg_ctx_with_fns(node_f3(call_node), arg_count, params, locals, src, tt, call_block, pipeline_lower_module_fns(module))
    let concrete_type_args = if pipeline_lower_module_subst(module) == 0 { node_f1(expr) } else { type_list_subst(node_f1(expr), pipeline_lower_module_subst(module)) }
    let variant_payloads = pipeline_variant_payload_types(tt, src, node_f1(call_node), node_f2(call_node))
    let variant_tparams = if variant_payloads == 0 { 0 } else { ttable_variant_tparams(tt, src, node_f1(call_node), node_f2(call_node)) }
    let template_pair = if variant_payloads == 0 { pipeline_generic_template_find(pipeline_lower_module_fns(module), src, str_hash(src, node_f1(call_node), node_f2(call_node))) } else { 0 }
    let expected_params = if template_pair == 0 { 0 } else { node_f3(pipeline_fn_inner(node_f1(template_pair))) }
    let expected_subst = if variant_payloads != 0 {
      if variant_tparams == 0 { pipeline_lower_module_subst(module) } else { cg_build_subst(variant_tparams, concrete_type_args) }
    } else {
      if template_pair == 0 { 0 } else { cg_build_subst(fn_tparams(node_f1(template_pair)), concrete_type_args) }
    }
    let ctx = pipeline_call_arg_ctx_expected(base_ctx, expected_params, expected_subst)
    let lowered_args = pipeline_lower_call_arg_blocks(ctx, 0, next_value, first_arg_block, ir_value_list_empty())
    if pipeline_lowered_call_blocks_is_valid(lowered_args) == 1 {
      let entry = ir_block_new_term(start_block, ir_inst_list_empty(), ir_term_jump(first_arg_block))
      if pipeline_lowered_call_blocks_falls_through(lowered_args) == 0 {
        let blocks = ir_block_list_prepend(entry, pipeline_lowered_call_blocks_blocks(lowered_args))
        pipeline_lowered_blocks_control(
          pipeline_lowered_call_blocks_next_block(lowered_args),
          pipeline_lowered_call_blocks_next_value(lowered_args),
          blocks,
          1,
          0
        )
      } else {
        let call_dst = pipeline_lowered_call_blocks_next_value(lowered_args)
        let logical_args = pipeline_lowered_call_blocks_values(lowered_args)
        let abi_args = if variant_payloads != 0 {
          pipeline_call_abi_args(logical_args, 0, variant_payloads, expected_subst, 0, 0)
        } else { if template_pair != 0 {
          pipeline_call_abi_args(logical_args, expected_params, 0, expected_subst, 0, 0)
        } else { logical_args } }
        let call_head = ir_inst_list_prepend(
          pipeline_generic_call_inst(call_dst, src, tt, node_f1(call_node), node_f2(call_node), concrete_type_args, abi_args),
          ir_inst_list_empty()
        )
        let result_ty = if template_pair == 0 { 0 } else { ty_subst(fn_ret_type(node_f1(template_pair)), expected_subst) }
        let result_lanes = if template_pair != 0 { pipeline_type_value_lane_count_or_one(result_ty) } else { 1 }
        let call_insts = if template_pair != 0 {
          ir_inst_list_append(call_head, pipeline_ir_call_result_lane_insts(call_dst, result_ty))
        } else { call_head }
        let call_args = pipeline_ir_value_lane_ids(call_dst, 0, result_lanes)
        let call = ir_block_new_term(call_block, call_insts, ir_term_jump_args(target_block, call_args))
        let blocks = ir_block_list_prepend(
          entry,
          ir_block_list_append(pipeline_lowered_call_blocks_blocks(lowered_args), ir_block_list_prepend(call, ir_block_list_empty()))
        )
        pipeline_lowered_blocks(pipeline_lowered_call_blocks_next_block(lowered_args), call_dst + result_lanes, blocks, 1)
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  } else {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  }
}

fn pipeline_method_arg_ctx(expr: i64, receiver_value: i64, entry_insts: IrInstList, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, target_block: i64) -> PipelineMethodArgCtx {
  PipelineMethodArgCtx(expr, receiver_value, entry_insts, params, locals, module, target_block)
}

fn pipeline_lower_method_args_cfg_to_target_blocks(method_ctx: PipelineMethodArgCtx, next_value: i64, start_block: i64, next_block: i64) -> PipelineLoweredBlocks {
  match method_ctx {
    PipelineMethodArgCtx(expr, receiver_value, entry_insts, params, locals, module, target_block) -> {
      let src = pipeline_lower_module_src(module)
      let tt = pipeline_lower_module_tt(module)
      let args_node = node_f3(expr)
      let call_block = next_block
      let arg_count = nlist_len(args_node)
      let first_arg_block = pipeline_lower_operation_child_start_block(call_block, arg_count)
      let base_ctx = pipeline_call_arg_ctx_with_fns(args_node, arg_count, params, locals, src, tt, call_block, pipeline_lower_module_fns(module))
      let subst = pipeline_lower_module_subst(module)
      let method_params = pipeline_method_ref_params(tt, node_f4(expr), node_f2(expr), subst)
      let ctx = pipeline_call_arg_ctx_expected_with_offset(base_ctx, method_params, 0, 1)
      let lowered_args = pipeline_lower_call_arg_blocks(ctx, 0, next_value, first_arg_block, ir_value_list_empty())
      if pipeline_lowered_call_blocks_is_valid(lowered_args) == 1 {
        let entry = ir_block_new_term(start_block, entry_insts, ir_term_jump(first_arg_block))
        if pipeline_lowered_call_blocks_falls_through(lowered_args) == 0 {
          let blocks = ir_block_list_prepend(entry, pipeline_lowered_call_blocks_blocks(lowered_args))
          pipeline_lowered_blocks_control(
            pipeline_lowered_call_blocks_next_block(lowered_args),
            pipeline_lowered_call_blocks_next_value(lowered_args),
            blocks,
            1,
            0
          )
        } else {
          let call_dst = pipeline_lowered_call_blocks_next_value(lowered_args)
          let call_inst = ir_inst_list_prepend(
            pipeline_method_call_inst(call_dst, node_f4(expr), node_f2(expr), receiver_value, pipeline_lowered_call_blocks_values(lowered_args), subst, tt),
            ir_inst_list_empty()
          )
          let call_args = ir_value_list_prepend(call_dst, ir_value_list_empty())
          let call = ir_block_new_term(call_block, call_inst, ir_term_jump_args(target_block, call_args))
          let blocks = ir_block_list_prepend(
            entry,
            ir_block_list_append(pipeline_lowered_call_blocks_blocks(lowered_args), ir_block_list_prepend(call, ir_block_list_empty()))
          )
          pipeline_lowered_blocks(pipeline_lowered_call_blocks_next_block(lowered_args), call_dst + 1, blocks, 1)
        }
      } else {
        pipeline_lowered_blocks_invalid(start_block, next_value)
      }
    }
  }
}

fn pipeline_lower_method_call_after_cfg_receiver(expr: i64, receiver_blocks: PipelineLoweredBlocks, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let receiver_value = pipeline_lowered_blocks_next_value(receiver_blocks)
  let args_node = node_f3(expr)
  let nargs = nlist_len(args_node)
  let args_need_cfg = pipeline_call_args_have_cfg(args_node, nargs, 0)
  if args_need_cfg == 1 {
    let args_start = pipeline_lowered_blocks_next_block(receiver_blocks)
    let method_ctx = pipeline_method_arg_ctx(expr, receiver_value, ir_inst_list_empty(), params, locals, module, target_block)
    let args_blocks = pipeline_lower_method_args_cfg_to_target_blocks(
      method_ctx,
      receiver_value + 1,
      args_start,
      args_start + 1
    )
    if pipeline_lowered_blocks_is_valid(args_blocks) == 1 {
      let receiver_params = ir_value_list_prepend(receiver_value, ir_value_list_empty())
      let receiver_merge = ir_block_new_params(next_block, receiver_params, ir_inst_list_empty(), ir_term_jump(args_start))
      let blocks = ir_block_list_append(
        pipeline_lowered_blocks_blocks(receiver_blocks),
        ir_block_list_prepend(receiver_merge, pipeline_lowered_blocks_blocks(args_blocks))
      )
      pipeline_lowered_blocks_control(
        pipeline_lowered_blocks_next_block(args_blocks),
        pipeline_lowered_blocks_next_value(args_blocks),
        blocks,
        1,
        pipeline_lowered_blocks_falls_through(args_blocks)
      )
    } else {
      pipeline_lowered_blocks_invalid(next_block, receiver_value + 1)
    }
  } else {
    let lower_ctx = pipeline_handler_lower_ctx_from_module(params, locals, module)
    let subst = pipeline_lower_module_subst(module)
    let method_params = pipeline_method_ref_params(tt, node_f4(expr), node_f2(expr), subst)
    let borrowed_mask = pipeline_method_ref_borrowable_param_mask(pipeline_lower_module_fns(module), tt, node_f4(expr), node_f2(expr), subst)
    let args = pipeline_lower_typed_method_handler_opt_args_expected(expr_list_from_nodes(args_node, 0, nargs), 0, receiver_value + 1, lower_ctx, method_params, 0, borrowed_mask)
    if pipeline_lowered_args_is_valid(args) == 1 {
      let call_dst = pipeline_lowered_args_next_value(args)
      let call_inst = ir_inst_list_prepend(
        pipeline_method_call_inst(call_dst, node_f4(expr), node_f2(expr), receiver_value, pipeline_lowered_args_values(args), subst, tt),
        ir_inst_list_empty()
      )
      let insts = ir_inst_list_append(pipeline_lowered_args_insts(args), call_inst)
      let call_args = ir_value_list_prepend(call_dst, ir_value_list_empty())
      let receiver_params = ir_value_list_prepend(receiver_value, ir_value_list_empty())
      let receiver_merge = ir_block_new_params(next_block, receiver_params, insts, ir_term_jump_args(target_block, call_args))
      let blocks = ir_block_list_append(
        pipeline_lowered_blocks_blocks(receiver_blocks),
        ir_block_list_prepend(receiver_merge, ir_block_list_empty())
      )
      pipeline_lowered_blocks(pipeline_lowered_blocks_next_block(receiver_blocks), call_dst + 1, blocks, 1)
    } else {
      pipeline_lowered_blocks_invalid(next_block, receiver_value + 1)
    }
  }
}

fn pipeline_lower_method_call_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let receiver_expr = node_f1(expr)
  let args_node = node_f3(expr)
  let nargs = nlist_len(args_node)
  if pipeline_expr_needs_cfg(receiver_expr) == 1 {
    let receiver_merge_block = next_block
    let receiver_blocks = pipeline_lower_expr_to_target_blocks_reserved(receiver_expr, params, locals, module, next_value, start_block, next_block + 1, receiver_merge_block)
    if pipeline_lowered_blocks_is_valid(receiver_blocks) == 1 {
      if pipeline_lowered_blocks_falls_through(receiver_blocks) == 0 {
        receiver_blocks
      } else {
        pipeline_lower_method_call_after_cfg_receiver(expr, receiver_blocks, params, locals, module, receiver_merge_block, target_block)
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  } else {
    let lower_ctx = pipeline_handler_lower_ctx_from_module(params, locals, module)
    let receiver = pipeline_lower_expr_node_typed_sidecar_handler_ctx(receiver_expr, next_value, lower_ctx)
    if ir_lowered_expr_is_valid(receiver) == 1 {
      if pipeline_call_args_have_cfg(args_node, nargs, 0) == 1 {
        let method_ctx = pipeline_method_arg_ctx(expr, ir_lowered_expr_value(receiver), ir_lowered_expr_insts(receiver), params, locals, module, target_block)
        pipeline_lower_method_args_cfg_to_target_blocks(
          method_ctx,
          ir_lowered_expr_next_value(receiver),
          start_block,
          next_block
        )
      } else {
        pipeline_lower_straight_expr_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  }
}

fn pipeline_lower_record_field_blocks(ctx: PipelineRecordFieldCtx, index: i64, next_value: i64, next_block: i64, values: IrRecordFieldList) -> PipelineLoweredRecordFieldBlocks {
  match ctx {
    PipelineRecordFieldCtx(fields, nfields, params, locals, module, record_block, type_ns, type_nl) -> {
      let src = pipeline_lower_module_src(module)
      let tt = pipeline_lower_module_tt(module)
      if index >= nfields {
        pipeline_lowered_record_field_blocks(values, pipeline_lower_operation_next_block(next_block, record_block), next_value, ir_block_list_empty(), 1)
      } else {
        let field = nlist_get(fields, index)
        let field_hash = str_hash(src, node_f1(field), node_f2(field))
        let value_expr = node_f3(field)
        let subst = pipeline_lower_module_subst(module)
        let field_ty = pipeline_record_field_expected_type(tt, src, type_ns, type_nl, node_f1(field), node_f2(field), subst)
        let word_offset = pipeline_record_field_word_offset(tt, src, type_ns, type_nl, node_f1(field), node_f2(field), subst)
        let field_lanes = pipeline_type_value_lane_count_or_one(field_ty)
        if pipeline_expr_needs_cfg(value_expr) == 1 {
          let field_merge_block = next_block + 1
          let field_next_block = next_block + 2
          let field_blocks = pipeline_lower_expr_to_target_blocks_reserved(value_expr, params, locals, module, next_value, next_block, field_next_block, field_merge_block)
          if pipeline_lowered_blocks_is_valid(field_blocks) == 1 {
            if pipeline_lowered_blocks_falls_through(field_blocks) == 0 {
              pipeline_lowered_record_field_blocks_control(
                values,
                pipeline_lowered_blocks_next_block(field_blocks),
                pipeline_lowered_blocks_next_value(field_blocks),
                pipeline_lowered_blocks_blocks(field_blocks),
                1,
                0
              )
            } else {
              let field_value = pipeline_lowered_blocks_next_value(field_blocks)
              let rest_start = pipeline_lowered_blocks_next_block(field_blocks)
              let retain = pipeline_managed_borrow_retain_arg_node(value_expr, field_value, field_ty, field_value + field_lanes, src, pipeline_lower_module_fns(module), subst, tt)
              let next_values = ir_record_field_list_append(values, pipeline_ir_record_field_lane_entries(field_hash, word_offset, field_value, field_ty))
              let rest = pipeline_lower_record_field_blocks(ctx, index + 1, pipeline_lowered_args_next_value(retain), rest_start, next_values)
              if pipeline_lowered_record_field_blocks_is_valid(rest) == 1 {
                let target = if index + 1 >= nfields { record_block } else { rest_start }
                let field_params = pipeline_ir_value_lane_ids(field_value, 0, field_lanes)
                let field_merge = ir_block_new_params(field_merge_block, field_params, pipeline_lowered_args_insts(retain), ir_term_jump(target))
                let blocks = ir_block_list_append(
                  pipeline_lowered_blocks_blocks(field_blocks),
                  ir_block_list_prepend(field_merge, pipeline_lowered_record_field_blocks_blocks(rest))
                )
                pipeline_lowered_record_field_blocks_control(
                  pipeline_lowered_record_field_blocks_values(rest),
                  pipeline_lowered_record_field_blocks_next_block(rest),
                  pipeline_lowered_record_field_blocks_next_value(rest),
                  blocks,
                  1,
                  pipeline_lowered_record_field_blocks_falls_through(rest)
                )
              } else {
                pipeline_lowered_record_field_blocks_invalid(next_block, next_value)
              }
            }
          } else {
            pipeline_lowered_record_field_blocks_invalid(next_block, next_value)
          }
        } else {
          let lower_ctx = pipeline_handler_lower_ctx_from_module(params, locals, module)
          let lowered = pipeline_lower_expr_node_typed_sidecar_handler_ctx(value_expr, next_value, lower_ctx)
          if ir_lowered_expr_is_valid(lowered) == 1 {
            let rest_start = next_block + 1
            let retain = pipeline_managed_borrow_retain_arg_node(value_expr, ir_lowered_expr_value(lowered), field_ty, ir_lowered_expr_next_value(lowered), src, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module), tt)
            let next_values = ir_record_field_list_append(values, pipeline_ir_record_field_lane_entries(field_hash, word_offset, ir_lowered_expr_value(lowered), field_ty))
            let rest = pipeline_lower_record_field_blocks(ctx, index + 1, pipeline_lowered_args_next_value(retain), rest_start, next_values)
            if pipeline_lowered_record_field_blocks_is_valid(rest) == 1 {
              let target = if index + 1 >= nfields { record_block } else { rest_start }
              let block = ir_block_new_term(next_block, ir_inst_list_append(ir_lowered_expr_insts(lowered), pipeline_lowered_args_insts(retain)), ir_term_jump(target))
              let blocks = ir_block_list_prepend(block, pipeline_lowered_record_field_blocks_blocks(rest))
              pipeline_lowered_record_field_blocks_control(
                pipeline_lowered_record_field_blocks_values(rest),
                pipeline_lowered_record_field_blocks_next_block(rest),
                pipeline_lowered_record_field_blocks_next_value(rest),
                blocks,
                1,
                pipeline_lowered_record_field_blocks_falls_through(rest)
              )
            } else {
              pipeline_lowered_record_field_blocks_invalid(next_block, next_value)
            }
          } else {
            pipeline_lowered_record_field_blocks_invalid(next_block, next_value)
          }
        }
      }
    }
  }
}

fn pipeline_lower_record_init_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let fields = node_f3(expr)
  let nfields = node_f4(expr)
  let record_block = next_block
  let first_field_block = pipeline_lower_operation_child_start_block(record_block, nfields)
  let ctx = pipeline_record_field_ctx(fields, nfields, params, locals, module, record_block, node_f1(expr), node_f2(expr))
  let lowered_fields = pipeline_lower_record_field_blocks(ctx, 0, next_value, first_field_block, ir_record_field_list_empty())
  if pipeline_lowered_record_field_blocks_is_valid(lowered_fields) == 1 {
    let entry = ir_block_new_term(start_block, ir_inst_list_empty(), ir_term_jump(first_field_block))
    if pipeline_lowered_record_field_blocks_falls_through(lowered_fields) == 0 {
      let blocks = ir_block_list_prepend(entry, pipeline_lowered_record_field_blocks_blocks(lowered_fields))
      pipeline_lowered_blocks_control(
        pipeline_lowered_record_field_blocks_next_block(lowered_fields),
        pipeline_lowered_record_field_blocks_next_value(lowered_fields),
        blocks,
        1,
        0
      )
    } else {
      let record_dst = pipeline_lowered_record_field_blocks_next_value(lowered_fields)
      let record_entry = ttable_lookup(tt, src, node_f1(expr), node_f2(expr))
      let record_inst = ir_inst_list_prepend(
        pipeline_record_init_inst_for_storage_layout(
          tt,
          record_entry,
          pipeline_lower_module_subst(module),
          record_dst,
          str_hash(src, node_f1(expr), node_f2(expr)),
          pipeline_lowered_record_field_blocks_values(lowered_fields)
        ),
        ir_inst_list_empty()
      )
      let cleanup = pipeline_record_array_source_releases_for_storage_layout(
        tt,
        record_entry,
        pipeline_lower_module_subst(module),
        pipeline_lowered_record_field_blocks_values(lowered_fields),
        record_dst + 1
      )
      if pipeline_lowered_args_is_valid(cleanup) == 1 {
        let record_args = ir_value_list_prepend(record_dst, ir_value_list_empty())
        let record = ir_block_new_term(record_block, ir_inst_list_append(record_inst, pipeline_lowered_args_insts(cleanup)), ir_term_jump_args(target_block, record_args))
        let blocks = ir_block_list_prepend(
          entry,
          ir_block_list_append(pipeline_lowered_record_field_blocks_blocks(lowered_fields), ir_block_list_prepend(record, ir_block_list_empty()))
        )
        pipeline_lowered_blocks(pipeline_lowered_record_field_blocks_next_block(lowered_fields), pipeline_lowered_args_next_value(cleanup), blocks, 1)
      } else {
        pipeline_lowered_blocks_invalid(start_block, next_value)
      }
    }
  } else {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  }
}

fn pipeline_lower_field_access_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  pipeline_lower_field_like_typed_to_target_blocks(
    expr_from_node(node_f1(expr)),
    node_f2(expr),
    node_f3(expr),
    field_access_fact_from_node(node_f4(expr)),
    0,
    0,
    params,
    locals,
    module,
    next_value,
    start_block,
    next_block,
    target_block
  )
}

fn pipeline_lower_opt_chain_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let base_expr = node_f1(expr)
  if pipeline_expr_needs_cfg(base_expr) == 1 {
    let base_merge_block = next_block
    let base_blocks = pipeline_lower_expr_to_target_blocks_reserved(base_expr, params, locals, module, next_value, start_block, next_block + 1, base_merge_block)
    if pipeline_lowered_blocks_is_valid(base_blocks) == 1 {
      if pipeline_lowered_blocks_falls_through(base_blocks) == 0 {
        base_blocks
      } else {
        let base_value = pipeline_lowered_blocks_next_value(base_blocks)
        let dst = base_value + 1
        let base_params = ir_value_list_prepend(base_value, ir_value_list_empty())
        let result_args = ir_value_list_prepend(dst, ir_value_list_empty())
        let effect_key = pipeline_effect_atom_dispatch_key(node_f4(expr), pipeline_lower_module_subst(module), effect_maybe_head_hash())
        let storage_layout = pipeline_record_storage_layout_for_base_node(tt, src, base_expr, params, locals, module)
        let opt_inst = pipeline_ir_opt_chain_insts_for_storage_layout(dst, base_value, str_hash(src, node_f2(expr), node_f3(expr)), pipeline_opt_chain_field_index(expr, src, tt), effect_key, storage_layout)
        let merge = ir_block_new_params(base_merge_block, base_params, opt_inst, ir_term_jump_args(target_block, result_args))
        let blocks = ir_block_list_append(
          pipeline_lowered_blocks_blocks(base_blocks),
          ir_block_list_prepend(merge, ir_block_list_empty())
        )
        pipeline_lowered_blocks(pipeline_lowered_blocks_next_block(base_blocks), dst + 1, blocks, 1)
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  } else {
    pipeline_lower_straight_expr_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
  }
}

fn pipeline_lower_let_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let init_expr = node_f3(expr)
  let body_expr = node_f4(expr)
  let inferred_type_node = pipeline_init_type_node_from_node(init_expr, params, locals, module)
  let local_lanes = pipeline_type_value_lane_count_or_one(inferred_type_node)
  if pipeline_expr_needs_cfg(init_expr) == 1 {
    let local_merge_block = next_block
    let local_value = next_value
    let address_taken = pipeline_expr_node_address_of_binding(body_expr, src, node_f1(expr), node_f2(expr))
    let address_slot = pipeline_ir_addressable_slot_id(local_value + local_lanes)
    let init_blocks = pipeline_lower_expr_to_target_blocks_reserved(init_expr, params, locals, module, local_value + local_lanes, start_block, next_block + 1, local_merge_block)
    if pipeline_lowered_blocks_is_valid(init_blocks) == 1 {
      if pipeline_lowered_blocks_falls_through(init_blocks) == 0 {
        init_blocks
      } else {
        let body_next_value = if address_taken == 1 {
          pipeline_ir_max_i64(pipeline_lowered_blocks_next_value(init_blocks), address_slot + local_lanes)
        } else {
          pipeline_ir_max_i64(pipeline_lowered_blocks_next_value(init_blocks), local_value + local_lanes)
        }
        let body_start = pipeline_lowered_blocks_next_block(init_blocks)
        let float_prim = pipeline_expr_float_prim_node_temp(init_expr, params, locals, src, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module))
        let local_type_hash = pipeline_expr_type_hash_node_temp(init_expr, params, locals, src, tt, pipeline_lower_module_fns(module), 0)
        let next_locals = if address_taken == 1 {
          pipeline_value_env_push_slot_float_typed_node(locals, node_f1(expr), node_f2(expr), address_slot, float_prim, local_type_hash, inferred_type_node)
        } else {
          pipeline_value_env_push_float_typed_node(locals, node_f1(expr), node_f2(expr), local_value, float_prim, local_type_hash, inferred_type_node)
        }
        let body_blocks = pipeline_lower_expr_to_target_blocks(body_expr, params, next_locals, module, body_next_value, body_start, target_block)
        if pipeline_lowered_blocks_is_valid(body_blocks) == 1 {
          let local_params = pipeline_ir_value_lane_ids(local_value, 0, local_lanes)
          let slot_insts = if address_taken == 1 {
            pipeline_ir_slot_lane_init_insts(address_slot, local_value, 0, local_lanes)
          } else { ir_inst_list_empty() }
          let local_merge = ir_block_new_params(local_merge_block, local_params, slot_insts, ir_term_jump(body_start))
          let blocks = ir_block_list_append(
            pipeline_lowered_blocks_blocks(init_blocks),
            ir_block_list_prepend(local_merge, pipeline_lowered_blocks_blocks(body_blocks))
          )
          pipeline_lowered_blocks_control(
            pipeline_lowered_blocks_next_block(body_blocks),
            pipeline_lowered_blocks_next_value(body_blocks),
            blocks,
            1,
            pipeline_lowered_blocks_falls_through(body_blocks)
          )
        } else {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        }
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  } else {
    let init = pipeline_lower_expr_node_with_module_ctx(init_expr, params, locals, module, next_value)
    if ir_lowered_expr_is_valid(init) == 1 {
      let float_prim = pipeline_expr_float_prim_node_temp(init_expr, params, locals, src, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module))
      let local_type_hash = pipeline_expr_type_hash_node_temp(init_expr, params, locals, src, tt, pipeline_lower_module_fns(module), 0)
      let address_taken = pipeline_expr_node_address_of_binding(body_expr, src, node_f1(expr), node_f2(expr))
      let slot = pipeline_ir_addressable_slot_id(ir_lowered_expr_next_value(init))
      let next_locals = if address_taken == 1 {
        pipeline_value_env_push_slot_float_typed_node(locals, node_f1(expr), node_f2(expr), slot, float_prim, local_type_hash, inferred_type_node)
      } else {
        pipeline_value_env_push_float_typed_node(locals, node_f1(expr), node_f2(expr), ir_lowered_expr_value(init), float_prim, local_type_hash, inferred_type_node)
      }
      let slot_insts = if address_taken == 1 {
        pipeline_ir_slot_lane_init_insts(slot, ir_lowered_expr_value(init), 0, local_lanes)
      } else { ir_inst_list_empty() }
      let body_next = if address_taken == 1 { slot + local_lanes } else { ir_lowered_expr_next_value(init) }
      if pipeline_expr_needs_cfg(body_expr) == 1 {
        let body_start = next_block
        let body_blocks = pipeline_lower_expr_to_target_blocks(body_expr, params, next_locals, module, body_next, body_start, target_block)
        if pipeline_lowered_blocks_is_valid(body_blocks) == 1 {
          let entry = ir_block_new_term(start_block, ir_inst_list_append(ir_lowered_expr_insts(init), slot_insts), ir_term_jump(body_start))
          let blocks = ir_block_list_prepend(entry, pipeline_lowered_blocks_blocks(body_blocks))
          pipeline_lowered_blocks_control(
            pipeline_lowered_blocks_next_block(body_blocks),
            pipeline_lowered_blocks_next_value(body_blocks),
            blocks,
            1,
            pipeline_lowered_blocks_falls_through(body_blocks)
          )
        } else {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        }
      } else {
        let body = pipeline_lower_expr_node_with_module_ctx(body_expr, params, next_locals, module, body_next)
        if ir_lowered_expr_is_valid(body) == 1 {
          let args = pipeline_ir_value_lane_ids(ir_lowered_expr_value(body), 0, pipeline_expr_node_value_lane_count(body_expr, params, next_locals, module))
          let insts = ir_inst_list_append(ir_lowered_expr_insts(init), ir_inst_list_append(slot_insts, ir_lowered_expr_insts(body)))
          let block = ir_block_new_term(start_block, insts, ir_term_jump_args(target_block, args))
          let blocks = ir_block_list_prepend(block, ir_block_list_empty())
          pipeline_lowered_blocks(next_block, ir_lowered_expr_next_value(body), blocks, 1)
        } else {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        }
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  }
}

fn pipeline_lower_let_mut_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let init_expr = node_f3(expr)
  let body_expr = node_f4(expr)
  let early_effective_type_node = pipeline_init_type_node_from_node(init_expr, params, locals, module)
  let local_lanes = pipeline_type_value_lane_count_or_one(early_effective_type_node)
  if pipeline_expr_needs_cfg(init_expr) == 1 {
    let local_merge_block = next_block
    let local_value = next_value
    let address_taken = pipeline_expr_node_address_of_binding(body_expr, src, node_f1(expr), node_f2(expr))
    let slot = if address_taken == 1 { pipeline_ir_addressable_slot_id(local_value + local_lanes) } else { local_value + local_lanes }
    let init_blocks = pipeline_lower_expr_to_target_blocks_reserved(init_expr, params, locals, module, slot + local_lanes, start_block, next_block + 1, local_merge_block)
    if pipeline_lowered_blocks_is_valid(init_blocks) == 1 {
      if pipeline_lowered_blocks_falls_through(init_blocks) == 0 {
        init_blocks
      } else {
        let retain_start = pipeline_ir_max_i64(pipeline_lowered_blocks_next_value(init_blocks), slot + local_lanes)
        let body_start = pipeline_lowered_blocks_next_block(init_blocks)
        let slot_insts = pipeline_ir_slot_lane_init_insts(slot, local_value, 0, local_lanes)
        let float_prim = pipeline_expr_float_prim_node_temp(init_expr, params, locals, src, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module))
        let inferred_type_hash = pipeline_expr_type_hash_node_temp(init_expr, params, locals, src, tt, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module))
        let effective_type_node = early_effective_type_node
        let inferred_node_type_hash = if effective_type_node != 0 { type_hash_of(effective_type_node) } else { 0 }
        let local_type_hash = if inferred_node_type_hash != 0 { inferred_node_type_hash } else { inferred_type_hash }
        let retain_insts = if effective_type_node != 0 and pipeline_expr_node_result_is_borrowed_for_ty_typed(init_expr, effective_type_node, src, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module), pipeline_lower_module_tt(module)) == 1 {
          pipeline_managed_retain_inst_list(local_value, effective_type_node, retain_start)
        } else {
          ir_inst_list_empty()
        }
        let body_next_value = retain_start + ir_inst_list_len(retain_insts)
        let next_locals = pipeline_value_env_push_slot_float_typed_node(locals, node_f1(expr), node_f2(expr), slot, float_prim, local_type_hash, effective_type_node)
        let scope_needs_release = if address_taken == 1 or effective_type_node == 0 { 0 }
          else { if pipeline_expr_node_final_returns_binding(body_expr, src, node_f1(expr), node_f2(expr)) == 1 { 0 }
          else { ty_value_has_release_lane(effective_type_node) } }
        let drop_block = body_start
        let wrapped_body_start = if scope_needs_release == 1 { body_start + 1 } else { body_start }
        let body_target = if scope_needs_release == 1 { drop_block } else { target_block }
        let body_blocks = pipeline_lower_expr_to_target_blocks(body_expr, params, next_locals, module, body_next_value, wrapped_body_start, body_target)
        if pipeline_lowered_blocks_is_valid(body_blocks) == 1 {
          let local_params = pipeline_ir_value_lane_ids(local_value, 0, local_lanes)
          let local_merge = ir_block_new_params(local_merge_block, local_params, ir_inst_list_append(slot_insts, retain_insts), ir_term_jump(wrapped_body_start))
          if scope_needs_release == 1 and pipeline_lowered_blocks_falls_through(body_blocks) == 1 {
            let carried = pipeline_lowered_blocks_next_value(body_blocks)
            let carried_lanes = pipeline_expr_node_value_lane_count(body_expr, params, next_locals, module)
            let carried_args = pipeline_ir_value_lane_ids(carried, 0, carried_lanes)
            let cleanup_value = carried + carried_lanes
            let drop_insts = pipeline_managed_slot_cleanup_inst_list(slot, effective_type_node, cleanup_value)
            let drop_node = ir_block_new_params(drop_block, carried_args, drop_insts, ir_term_jump_args(target_block, carried_args))
            let blocks = ir_block_list_append(
              pipeline_lowered_blocks_blocks(init_blocks),
              ir_block_list_prepend(local_merge, ir_block_list_append(pipeline_lowered_blocks_blocks(body_blocks), ir_block_list_prepend(drop_node, ir_block_list_empty())))
            )
            pipeline_lowered_blocks_control(
              pipeline_lowered_blocks_next_block(body_blocks),
              cleanup_value + ir_inst_list_len(drop_insts),
              blocks,
              1,
              1
            )
          } else {
            let blocks = ir_block_list_append(
              pipeline_lowered_blocks_blocks(init_blocks),
              ir_block_list_prepend(local_merge, pipeline_lowered_blocks_blocks(body_blocks))
            )
            pipeline_lowered_blocks_control(
              pipeline_lowered_blocks_next_block(body_blocks),
              pipeline_lowered_blocks_next_value(body_blocks),
              blocks,
              1,
              pipeline_lowered_blocks_falls_through(body_blocks)
            )
          }
        } else {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        }
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  } else {
    let init = pipeline_lower_expr_node_with_module_ctx(init_expr, params, locals, module, next_value)
    if ir_lowered_expr_is_valid(init) == 1 {
      let address_taken = pipeline_expr_node_address_of_binding(body_expr, src, node_f1(expr), node_f2(expr))
      let slot = if address_taken == 1 { pipeline_ir_addressable_slot_id(ir_lowered_expr_next_value(init)) } else { ir_lowered_expr_next_value(init) }
      let slot_insts = pipeline_ir_slot_lane_init_insts(slot, ir_lowered_expr_value(init), 0, local_lanes)
      let float_prim = pipeline_expr_float_prim_node_temp(init_expr, params, locals, src, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module))
      let inferred_type_hash = pipeline_expr_type_hash_node_temp(init_expr, params, locals, src, tt, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module))
      let effective_type_node = early_effective_type_node
      let inferred_node_type_hash = if effective_type_node != 0 { type_hash_of(effective_type_node) } else { 0 }
      let local_type_hash = if inferred_node_type_hash != 0 { inferred_node_type_hash } else { inferred_type_hash }
      let retain_insts = if effective_type_node != 0 and pipeline_expr_node_result_is_borrowed_for_ty_typed(init_expr, effective_type_node, src, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module), pipeline_lower_module_tt(module)) == 1 {
        pipeline_managed_retain_inst_list(ir_lowered_expr_value(init), effective_type_node, slot + local_lanes)
      } else {
        ir_inst_list_empty()
      }
      let body_next_value = slot + local_lanes + ir_inst_list_len(retain_insts)
      let next_locals = pipeline_value_env_push_slot_float_typed_node(locals, node_f1(expr), node_f2(expr), slot, float_prim, local_type_hash, effective_type_node)
      let scope_needs_release = if address_taken == 1 or effective_type_node == 0 { 0 }
        else { if pipeline_expr_node_final_returns_binding(body_expr, src, node_f1(expr), node_f2(expr)) == 1 { 0 }
        else { ty_value_has_release_lane(effective_type_node) } }
      if pipeline_expr_needs_cfg(body_expr) == 1 {
        let drop_block = next_block
        let body_start = if scope_needs_release == 1 { next_block + 1 } else { next_block }
        let body_target = if scope_needs_release == 1 { drop_block } else { target_block }
        let body_blocks = pipeline_lower_expr_to_target_blocks(body_expr, params, next_locals, module, body_next_value, body_start, body_target)
        if pipeline_lowered_blocks_is_valid(body_blocks) == 1 {
          let entry_insts = ir_inst_list_append(ir_lowered_expr_insts(init), ir_inst_list_append(slot_insts, retain_insts))
          let entry = ir_block_new_term(start_block, entry_insts, ir_term_jump(body_start))
          if scope_needs_release == 1 and pipeline_lowered_blocks_falls_through(body_blocks) == 1 {
            let carried = pipeline_lowered_blocks_next_value(body_blocks)
            let carried_lanes = pipeline_expr_node_value_lane_count(body_expr, params, next_locals, module)
            let carried_args = pipeline_ir_value_lane_ids(carried, 0, carried_lanes)
            let cleanup_value = carried + carried_lanes
            let drop_insts = pipeline_managed_slot_cleanup_inst_list(slot, effective_type_node, cleanup_value)
            let drop_node = ir_block_new_params(drop_block, carried_args, drop_insts, ir_term_jump_args(target_block, carried_args))
            let blocks = ir_block_list_prepend(entry, ir_block_list_append(pipeline_lowered_blocks_blocks(body_blocks), ir_block_list_prepend(drop_node, ir_block_list_empty())))
            pipeline_lowered_blocks_control(
              pipeline_lowered_blocks_next_block(body_blocks),
              cleanup_value + ir_inst_list_len(drop_insts),
              blocks,
              1,
              1
            )
          } else {
            let blocks = ir_block_list_prepend(entry, pipeline_lowered_blocks_blocks(body_blocks))
            pipeline_lowered_blocks_control(
              pipeline_lowered_blocks_next_block(body_blocks),
              pipeline_lowered_blocks_next_value(body_blocks),
              blocks,
              1,
              pipeline_lowered_blocks_falls_through(body_blocks)
            )
          }
        } else {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        }
      } else {
        let body = pipeline_lower_expr_node_with_module_ctx(body_expr, params, next_locals, module, body_next_value)
        if ir_lowered_expr_is_valid(body) == 1 {
          let cleanup_insts = if scope_needs_release == 1 { pipeline_managed_slot_cleanup_inst_list(slot, effective_type_node, ir_lowered_expr_next_value(body)) } else { ir_inst_list_empty() }
          let after_cleanup = ir_lowered_expr_next_value(body) + ir_inst_list_len(cleanup_insts)
          let args = pipeline_ir_value_lane_ids(ir_lowered_expr_value(body), 0, pipeline_expr_node_value_lane_count(body_expr, params, next_locals, module))
          let insts = ir_inst_list_append(
            ir_lowered_expr_insts(init),
            ir_inst_list_append(slot_insts, ir_inst_list_append(retain_insts, ir_inst_list_append(ir_lowered_expr_insts(body), cleanup_insts)))
          )
          let block = ir_block_new_term(start_block, insts, ir_term_jump_args(target_block, args))
          let blocks = ir_block_list_prepend(block, ir_block_list_empty())
          pipeline_lowered_blocks(next_block, after_cleanup, blocks, 1)
        } else {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        }
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  }
}

fn pipeline_lower_assign_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let slot = pipeline_value_env_lookup(locals, src, node_f1(expr), node_f2(expr))
  if slot >= 0 {
    if pipeline_value_env_lookup_kind(locals, src, node_f1(expr), node_f2(expr)) == 1 {
      let value_expr = node_f3(expr)
      let slot_ty = pipeline_value_env_lookup_type_node(locals, src, node_f1(expr), node_f2(expr))
      let slot_lanes = pipeline_type_value_lane_count_or_one(slot_ty)
      if pipeline_expr_needs_cfg(value_expr) == 1 {
        let assign_block = next_block
        let assign_value = next_value
        let value_blocks = pipeline_lower_expr_to_target_blocks_reserved(value_expr, params, locals, module, assign_value + slot_lanes, start_block, next_block + 1, assign_block)
        if pipeline_lowered_blocks_is_valid(value_blocks) == 1 {
          if pipeline_lowered_blocks_falls_through(value_blocks) == 0 {
            value_blocks
          } else {
            let retain_start = pipeline_ir_max_i64(pipeline_lowered_blocks_next_value(value_blocks), assign_value + slot_lanes)
            let retain_insts = if slot_ty != 0 and pipeline_expr_node_result_is_borrowed_for_ty_typed(value_expr, slot_ty, src, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module), pipeline_lower_module_tt(module)) == 1 {
              pipeline_managed_retain_inst_list(assign_value, slot_ty, retain_start)
            } else { ir_inst_list_empty() }
            let old_value = retain_start + ir_inst_list_len(retain_insts)
            let release_count = pipeline_type_managed_release_lane_count(slot_ty)
            let load_old_insts = if release_count > 0 { pipeline_ir_slot_managed_lane_load_insts(old_value, slot, slot_ty, 0, slot_lanes) } else { ir_inst_list_empty() }
            let release_insts = if release_count > 0 { pipeline_managed_release_inst_list(old_value, slot_ty, old_value + slot_lanes) } else { ir_inst_list_empty() }
            let nil_value = if release_count > 0 { old_value + slot_lanes + ir_inst_list_len(release_insts) } else { old_value }
            let assign_params = pipeline_ir_value_lane_ids(assign_value, 0, slot_lanes)
            let assign_args = ir_value_list_prepend(nil_value, ir_value_list_empty())
            let assign_insts = ir_inst_list_append(
              retain_insts,
              ir_inst_list_append(
                load_old_insts,
                ir_inst_list_append(
                  release_insts,
                  ir_inst_list_append(
                    pipeline_ir_slot_store_lane_insts(slot, assign_value, 0, slot_lanes),
                    ir_inst_list_prepend(ir_inst_const_i64(nil_value, 0), ir_inst_list_empty())
                  )
                )
              )
            )
            let assign_merge = ir_block_new_params(assign_block, assign_params, assign_insts, ir_term_jump_args(target_block, assign_args))
            let blocks = ir_block_list_append(
              pipeline_lowered_blocks_blocks(value_blocks),
              ir_block_list_prepend(assign_merge, ir_block_list_empty())
            )
            pipeline_lowered_blocks(pipeline_lowered_blocks_next_block(value_blocks), nil_value + 1, blocks, 1)
          }
        } else {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        }
      } else {
        pipeline_lower_straight_expr_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  } else {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  }
}

fn pipeline_lower_block_rest_to_target_blocks(rest_node: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  if rest_node == 0 {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  } else {
    pipeline_lower_expr_to_target_blocks(rest_node, params, locals, module, next_value, start_block, target_block)
  }
}

fn pipeline_lower_block_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let first_expr = node_f1(expr)
  let rest_node = node_f2(expr)
  if rest_node == 0 {
    pipeline_lower_expr_to_target_blocks_reserved(first_expr, params, locals, module, next_value, start_block, next_block, target_block)
  } else {
    if pipeline_expr_needs_cfg(first_expr) == 1 {
      let discard_merge_block = pipeline_lower_internal_block_after_target(next_block, target_block)
      let first_next_block = pipeline_lower_internal_block_after_target(discard_merge_block + 1, target_block)
      let first_blocks = pipeline_lower_expr_to_control_target_blocks_reserved(first_expr, params, locals, module, next_value, start_block, first_next_block, discard_merge_block)
      if pipeline_lowered_blocks_is_valid(first_blocks) == 1 {
        if pipeline_lowered_blocks_falls_through(first_blocks) == 0 {
          first_blocks
        } else {
          let rest_next_value = pipeline_lowered_blocks_next_value(first_blocks)
          let rest_start = pipeline_lower_internal_block_after_target(pipeline_ir_max_i64(pipeline_lowered_blocks_next_block(first_blocks), discard_merge_block + 1), target_block)
          let rest_blocks = pipeline_lower_block_rest_to_target_blocks(rest_node, params, locals, module, rest_next_value, rest_start, target_block)
          if pipeline_lowered_blocks_is_valid(rest_blocks) == 1 {
            let discard_merge = ir_block_new_term(discard_merge_block, ir_inst_list_empty(), ir_term_jump(rest_start))
            let blocks = ir_block_list_append(
              pipeline_lowered_blocks_blocks(first_blocks),
              ir_block_list_prepend(discard_merge, pipeline_lowered_blocks_blocks(rest_blocks))
            )
            pipeline_lowered_blocks_control(
              pipeline_lowered_blocks_next_block(rest_blocks),
              pipeline_lowered_blocks_next_value(rest_blocks),
              blocks,
              1,
              pipeline_lowered_blocks_falls_through(rest_blocks)
            )
          } else {
            pipeline_lowered_blocks_invalid(start_block, next_value)
          }
        }
      } else {
        pipeline_lowered_blocks_invalid(start_block, next_value)
      }
    } else {
      let lower_ctx = pipeline_handler_lower_ctx_from_module(params, locals, module)
      let first = pipeline_lower_expr_node_typed_sidecar_handler_ctx(first_expr, next_value, lower_ctx)
      if ir_lowered_expr_is_valid(first) == 1 {
        let rest_start = pipeline_lower_internal_block_after_target(next_block, target_block)
        let rest_blocks = pipeline_lower_block_rest_to_target_blocks(rest_node, params, locals, module, ir_lowered_expr_next_value(first), rest_start, target_block)
        if pipeline_lowered_blocks_is_valid(rest_blocks) == 1 {
          let entry = ir_block_new_term(start_block, ir_lowered_expr_insts(first), ir_term_jump(rest_start))
          let blocks = ir_block_list_prepend(entry, pipeline_lowered_blocks_blocks(rest_blocks))
          pipeline_lowered_blocks_control(
            pipeline_lowered_blocks_next_block(rest_blocks),
            pipeline_lowered_blocks_next_value(rest_blocks),
            blocks,
            1,
            pipeline_lowered_blocks_falls_through(rest_blocks)
          )
        } else {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        }
      } else {
        pipeline_lowered_blocks_invalid(start_block, next_value)
      }
    }
  }
}

fn pipeline_lower_call_arg_blocks(ctx: PipelineCallArgCtx, index: i64, next_value: i64, next_block: i64, values: IrValueList) -> PipelineLoweredCallBlocks {
  let args = pipeline_call_arg_ctx_args(ctx)
  let nargs = pipeline_call_arg_ctx_nargs(ctx)
  let params = pipeline_call_arg_ctx_params(ctx)
  let locals = pipeline_call_arg_ctx_locals(ctx)
  let src = pipeline_call_arg_ctx_src(ctx)
  let tt = pipeline_call_arg_ctx_tt(ctx)
  let module = pipeline_call_arg_ctx_module(ctx)
  let call_block = pipeline_call_arg_ctx_call_block(ctx)
  if index >= nargs {
    pipeline_lowered_call_blocks(values, pipeline_lower_operation_next_block(next_block, call_block), next_value, ir_block_list_empty(), 1)
  } else {
    let arg = nlist_get(args, index)
    if pipeline_expr_needs_cfg(arg) == 1 {
      let arg_merge_block = next_block + 1
      let arg_next_block = next_block + 2
      let arg_blocks = pipeline_lower_expr_to_target_blocks_reserved(arg, params, locals, module, next_value, next_block, arg_next_block, arg_merge_block)
      if pipeline_lowered_blocks_is_valid(arg_blocks) == 1 {
        if pipeline_lowered_blocks_falls_through(arg_blocks) == 0 {
          pipeline_lowered_call_blocks_control(
            values,
            pipeline_lowered_blocks_next_block(arg_blocks),
            pipeline_lowered_blocks_next_value(arg_blocks),
            pipeline_lowered_blocks_blocks(arg_blocks),
            1,
            0
          )
        } else {
          let arg_value = pipeline_lowered_blocks_next_value(arg_blocks)
          let rest_start = pipeline_lowered_blocks_next_block(arg_blocks)
          let expected_ty = pipeline_expected_arg_type_node(pipeline_call_arg_ctx_expected_params(ctx), 0, index, pipeline_call_arg_ctx_expected_offset(ctx), pipeline_call_arg_ctx_expected_subst(ctx))
          let arg_lanes = if expected_ty != 0 { pipeline_type_value_lane_count_or_one(expected_ty) } else { pipeline_expr_node_value_lane_count(arg, params, locals, module) }
          let next_values = ir_value_list_append(values, ir_value_list_prepend(arg_value, ir_value_list_empty()))
          let rest = pipeline_lower_call_arg_blocks(ctx, index + 1, arg_value + arg_lanes, rest_start, next_values)
          if pipeline_lowered_call_blocks_is_valid(rest) == 1 {
            let target = if index + 1 >= nargs { call_block } else { rest_start }
            let arg_params = pipeline_ir_value_lane_ids(arg_value, 0, arg_lanes)
            let arg_merge = ir_block_new_params(arg_merge_block, arg_params, ir_inst_list_empty(), ir_term_jump(target))
            let blocks = ir_block_list_append(
              pipeline_lowered_blocks_blocks(arg_blocks),
              ir_block_list_prepend(arg_merge, pipeline_lowered_call_blocks_blocks(rest))
            )
            pipeline_lowered_call_blocks_control(
              pipeline_lowered_call_blocks_values(rest),
              pipeline_lowered_call_blocks_next_block(rest),
              pipeline_lowered_call_blocks_next_value(rest),
              blocks,
              1,
              pipeline_lowered_call_blocks_falls_through(rest)
            )
          } else {
            pipeline_lowered_call_blocks_invalid(next_block, next_value)
          }
        }
      } else {
        pipeline_lowered_call_blocks_invalid(next_block, next_value)
      }
    } else {
      let expected_float = pipeline_param_float_prim_at(pipeline_call_arg_ctx_expected_params(ctx), index + pipeline_call_arg_ctx_expected_offset(ctx), pipeline_call_arg_ctx_expected_subst(ctx))
      let expected_int = if expected_float == 0 { pipeline_param_int_prim_at(pipeline_call_arg_ctx_expected_params(ctx), index + pipeline_call_arg_ctx_expected_offset(ctx), pipeline_call_arg_ctx_expected_subst(ctx)) } else { 0 - 1 }
      let expected_prim = if expected_float == PRIM_F32() or expected_float == PRIM_F64() { expected_float } else { expected_int }
      let lower_ctx = pipeline_handler_lower_ctx_from_module(params, locals, pipeline_lower_module_with_subst(module, pipeline_call_arg_ctx_expected_subst(ctx)))
      let lowered = if pipeline_prim_is_forced_numeric_context(expected_prim) == 1 {
        pipeline_lower_expr_node_typed_sidecar_handler_opt_with_float_prim(arg, next_value, lower_ctx, expected_prim)
      } else {
        pipeline_lower_expr_node_typed_sidecar_handler_ctx(arg, next_value, lower_ctx)
      }
      if ir_lowered_expr_is_valid(lowered) == 1 {
        let rest_start = next_block + 1
        let next_values = ir_value_list_append(values, ir_value_list_prepend(ir_lowered_expr_value(lowered), ir_value_list_empty()))
        let rest = pipeline_lower_call_arg_blocks(ctx, index + 1, ir_lowered_expr_next_value(lowered), rest_start, next_values)
        if pipeline_lowered_call_blocks_is_valid(rest) == 1 {
          let target = if index + 1 >= nargs { call_block } else { rest_start }
          let block = ir_block_new_term(next_block, ir_lowered_expr_insts(lowered), ir_term_jump(target))
          let blocks = ir_block_list_prepend(block, pipeline_lowered_call_blocks_blocks(rest))
          pipeline_lowered_call_blocks_control(
            pipeline_lowered_call_blocks_values(rest),
            pipeline_lowered_call_blocks_next_block(rest),
            pipeline_lowered_call_blocks_next_value(rest),
            blocks,
            1,
            pipeline_lowered_call_blocks_falls_through(rest)
          )
        } else {
          pipeline_lowered_call_blocks_invalid(next_block, next_value)
        }
      } else {
        pipeline_lowered_call_blocks_invalid(next_block, next_value)
      }
    }
  }
}

fn pipeline_ir_function_key(name_hash: i64, owner_hash: i64) -> i64 {
  if owner_hash == 0 { name_hash }
  else { name_hash * 131 + owner_hash * 17 + 2718281 }
}

fn pipeline_ir_method_patch_key(type_hash: i64, method_hash: i64) -> i64 {
  pipeline_ir_function_key(method_hash, type_hash)
}

fn pipeline_lower_param_bind_insts(params: i64, index: i64, count: i64) -> IrInstList {
  if params == 0 or index >= count {
    ir_inst_list_empty()
  } else {
    let param = nlist_get(params, index)
    let value = pipeline_param_value_index_at(params, index)
    ir_inst_list_prepend(
      ir_inst_bind_typed_i64(node_f1(param), node_f2(param), value, node_f3(param)),
      pipeline_lower_param_bind_insts(params, index + 1, count)
    )
  }
}

fn pipeline_ir_borrowed_param_mask_slot_base() -> i64 { 0 - 72057594037927936 }

fn pipeline_ir_borrowed_param_mask_slot(mask: i64) -> i64 {
  pipeline_ir_borrowed_param_mask_slot_base() - mask
}

fn pipeline_ir_borrowed_param_mask_slot_is(slot: i64) -> i64 {
  let base = pipeline_ir_borrowed_param_mask_slot_base()
  if slot < base and slot >= base - 1152921504606846976 { 1 } else { 0 }
}

fn pipeline_ir_borrowed_param_mask_slot_decode(slot: i64) -> i64 {
  pipeline_ir_borrowed_param_mask_slot_base() - slot
}

fn pipeline_lower_param_bind_insts_with_borrow_mask(params: i64, index: i64, count: i64, borrowed_mask: i64) -> IrInstList {
  let binds = pipeline_lower_param_bind_insts(params, index, count)
  if borrowed_mask == 0 {
    binds
  } else {
    ir_inst_list_append(
      binds,
      ir_inst_list_prepend(ir_inst_slot_i64(pipeline_ir_borrowed_param_mask_slot(borrowed_mask)), ir_inst_list_empty())
    )
  }
}

-- Managed-returning fns no longer force mask 0 (2r slice 1b): the 2q
-- ownership machinery accounts for every param-aliases-result path —
-- bare param returns get transfer retains, ctor/call embedding gets
-- arg borrow-retains, mixed merges get per-arm retains, and record
-- inits/lambda captures/raw stores still BLOCK borrowability in
-- cg_borrow_expr_blocks_name. The old blanket gate predated those
-- and taxed every call to a managed-returning fn with a retain/release
-- pair per managed arg.
fn pipeline_fn_intrinsic_borrowable_param_mask(fn_wrap: i64, fn_src: i64) -> i64 {
  let inner = pipeline_fn_inner(fn_wrap)
  if inner == 0 { 0 }
  else {
    let ns = node_f1(inner)
    let nl = node_f2(inner)
    -- These calls lower to dedicated IR/native operations, bypassing the
    -- callee epilogue. Their vector handle is semantically borrowed, so the
    -- caller must not manufacture an owned argument stake for an epilogue
    -- that will never run.
    if src_eq(fn_src, ns, nl, "vector_len") == 1 or src_eq(fn_src, ns, nl, "vector_get") == 1 or src_eq(fn_src, ns, nl, "vector_set") == 1 { 1 } else { 0 }
  }
}

fn pipeline_fn_borrowable_param_mask_with_params(fn_wrap: i64, fn_src: i64, params: i64, subst: i64) -> i64 {
  if fn_wrap == 0 or params == 0 { 0 }
  else {
    let inner = pipeline_fn_inner(fn_wrap)
    let body = node_f4(inner)
    let mut mask = 0
    let mut i = 0
    let n = nlist_len(params)
    while i < n and i < 60 {
      let p = nlist_get(params, i)
      let raw_ty = node_f3(p)
      let param_ty = if subst == 0 { raw_ty } else { ty_subst(raw_ty, subst) }
      if cg_ty_is_managed(param_ty) == 1 {
        if cg_borrow_expr_blocks_name(body, fn_src, node_f1(p), node_f2(p)) == 0 {
          mask = mask + cg_bit(i)
        } else { 0 }
      } else { 0 }
      i = i + 1
    }
    mask bor pipeline_fn_intrinsic_borrowable_param_mask(fn_wrap, fn_src)
  }
}

fn pipeline_fn_borrowable_param_mask_from_pair(pair: i64, params: i64, subst: i64) -> i64 {
  if pair == 0 { 0 }
  else { pipeline_fn_borrowable_param_mask_with_params(node_f1(pair), node_f2(pair), params, subst) }
}

fn pipeline_fn_effective_borrowable_param_mask_with_params(fns: i64, fn_wrap: i64, fn_src: i64, params: i64, subst: i64) -> i64 {
  let inner = pipeline_fn_inner(fn_wrap)
  let name_hash = if inner == 0 { 0 } else { str_hash(fn_src, node_f1(inner), node_f2(inner)) }
  if name_hash != 0 and pipeline_fns_hash_is_address_taken(fns, name_hash) == 1 {
    0
  } else {
    pipeline_fn_borrowable_param_mask_with_params(fn_wrap, fn_src, params, subst)
  }
}

fn pipeline_fn_effective_borrowable_param_mask_from_pair(fns: i64, pair: i64, params: i64, subst: i64) -> i64 {
  if pair == 0 { 0 }
  else { pipeline_fn_effective_borrowable_param_mask_with_params(fns, node_f1(pair), node_f2(pair), params, subst) }
}

fn pipeline_call_borrowable_param_mask(fns: i64, src: i64, ns: i64, nl: i64, params: i64, subst: i64) -> i64 {
  pipeline_fn_effective_borrowable_param_mask_from_pair(fns, pipeline_fns_lookup_pair(fns, src, ns, nl), params, subst)
}

fn pipeline_fns_lookup_method_pair(fns: i64, type_hash: i64, method_hash: i64) -> i64 {
  if pipeline_fns_fact_list_valid(fns) == 0 { 0 }
  else {
    pipeline_fns_index_probe(node_f2(pipeline_fns_index_bundle(fns)), pipeline_ir_method_patch_key(type_hash, method_hash))
  }
}

fn pipeline_method_borrowable_param_mask(fns: i64, type_hash: i64, method_hash: i64, params: i64, subst: i64) -> i64 {
  pipeline_fn_borrowable_param_mask_from_pair(pipeline_fns_lookup_method_pair(fns, type_hash, method_hash), params, subst)
}

fn pipeline_method_ref_resolution(tt: i64, method_ref: i64, method_hash: i64, outer_subst: i64) -> i64 {
  let concrete_ref = pipeline_concretize_method_ref(tt, method_ref, method_hash, outer_subst)
  ttable_resolve_method(tt, method_ref_receiver_ty(concrete_ref), method_ref_owner_hash(concrete_ref), method_hash)
}

fn pipeline_resolve_method_ref(tt: i64, receiver_ty: i64, method_hash: i64) -> i64 {
  if receiver_ty == 0 { 0 }
  else {
    let owner_hash = type_hash_of(receiver_ty)
    let resolution = ttable_resolve_method(tt, receiver_ty, owner_hash, method_hash)
    if resolution == 0 { 0 }
    else {
      method_ref_new(
        owner_hash,
        receiver_ty,
        method_resolution_ref_type_args(resolution, receiver_ty),
        if method_resolution_tparams(resolution) != 0 { 1 } else { 0 }
      )
    }
  }
}

-- An owner hash of zero is a delayed method-dispatch fact emitted for a call
-- on a bounded type variable. Resolve it only after the enclosing generic
-- substitution is concrete; doing so preserves per-specialisation dispatch
-- and also recovers generic-impl type arguments.
fn pipeline_concretize_method_ref(tt: i64, method_ref: i64, method_hash: i64, outer_subst: i64) -> i64 {
  let substituted = method_ref_subst(method_ref, outer_subst)
  if method_ref_owner_hash(substituted) != 0 { substituted }
  else {
    let resolved = pipeline_resolve_method_ref(tt, method_ref_receiver_ty(substituted), method_hash)
    if resolved == 0 { substituted }
    else { if method_ref_is_associated(substituted) { method_ref_mark_associated(resolved) } else { resolved } }
  }
}

fn pipeline_method_ref_params(tt: i64, method_ref: i64, method_hash: i64, outer_subst: i64) -> i64 {
  let resolution = pipeline_method_ref_resolution(tt, method_ref, method_hash, outer_subst)
  if resolution == 0 { 0 } else { method_resolution_params(resolution) }
}

fn pipeline_method_ref_borrowable_param_mask(fns: i64, tt: i64, method_ref: i64, method_hash: i64, outer_subst: i64) -> i64 {
  let concrete_ref = pipeline_concretize_method_ref(tt, method_ref, method_hash, outer_subst)
  let resolution = ttable_resolve_method(tt, method_ref_receiver_ty(concrete_ref), method_ref_owner_hash(concrete_ref), method_hash)
  if resolution == 0 { 0 }
  else {
    let method = method_resolution_method(resolution)
    pipeline_fn_borrowable_param_mask_with_params(method, method_resolution_src(resolution), node_f3(pipeline_fn_inner(method)), method_resolution_subst(resolution))
  }
}

fn pipeline_method_call_inst(dst: i64, method_ref: i64, method_hash: i64, receiver: i64, args: IrValueList, outer_subst: i64, tt: i64) -> IrInst {
  let concrete_ref = pipeline_concretize_method_ref(tt, method_ref, method_hash, outer_subst)
  if method_ref_is_generic(concrete_ref) {
    ir_inst_generic_call_i64(
      dst,
      pipeline_ir_method_patch_key(method_ref_owner_hash(concrete_ref), method_hash),
      method_ref_type_args(concrete_ref),
      ir_value_list_prepend(receiver, args)
    )
  } else { if method_ref_type_args(concrete_ref) != 0 and nlist_len(method_ref_type_args(concrete_ref)) > 0 {
    ir_inst_call_i64(
      dst,
      mono_spec_hash(pipeline_ir_method_patch_key(method_ref_owner_hash(concrete_ref), method_hash), method_ref_type_args(concrete_ref)),
      ir_value_list_prepend(receiver, args)
    )
  } else {
    ir_inst_method_call_i64(dst, method_ref_owner_hash(concrete_ref), method_hash, receiver, args)
  } }
}

fn pipeline_name_matches(src: i64, a_ns: i64, a_nl: i64, b_ns: i64, b_nl: i64) -> bool {
  if a_nl != b_nl { false }
  else { src_eq_at(src, a_ns, src + b_ns, 0, a_nl) }
}

fn pipeline_param_list_refs_name(params: i64, src: i64, ns: i64, nl: i64) -> i64 {
  if params == 0 { 0 }
  else {
    let mut found = 0
    let mut i = 0
    let n = nlist_len(params)
    while i < n and found == 0 {
      let p = nlist_get(params, i)
      if pipeline_name_matches(src, node_f1(p), node_f2(p), ns, nl) == 1 { found = 1 } else { i = i + 1 }
    }
    found
  }
}

fn pipeline_expr_list_refs_name(args: i64, count: i64, src: i64, ns: i64, nl: i64) -> bool {
  let mut found = false
  let mut i = 0
  while i < count and found == 0 {
    if pipeline_expr_refs_name(nlist_get(args, i), src, ns, nl) == 1 { found = true } else { i = i + 1 }
  }
  found
}

fn pipeline_record_fields_refs_name(fields: i64, count: i64, src: i64, ns: i64, nl: i64) -> bool {
  let mut found = false
  let mut i = 0
  while i < count and found == 0 {
    let field = nlist_get(fields, i)
    if pipeline_expr_refs_name(node_f3(field), src, ns, nl) == 1 { found = 1 } else { i = i + 1 }
  }
  found
}

fn pipeline_match_arms_refs_name(arms: i64, count: i64, src: i64, ns: i64, nl: i64) -> bool {
  let mut found = false
  let mut i = 0
  while i < count and found == 0 {
    let arm = nlist_get(arms, i)
    if pipeline_expr_refs_name(node_f2(arm), src, ns, nl) == 1 { found = true }
    else { if pipeline_expr_refs_name(node_f3(arm), src, ns, nl) == 1 { found = true } else { i = i + 1 } }
  }
  found
}

fn pipeline_handler_clauses_refs_name(clauses: i64, count: i64, src: i64, ns: i64, nl: i64) -> bool {
  let mut found = false
  let mut i = 0
  while i < count and found == 0 {
    let clause = nlist_get(clauses, i)
    if pipeline_param_list_refs_name(node_f2(clause), src, ns, nl) == 1 { i = i + 1 }
    else { if pipeline_expr_refs_name(node_f3(clause), src, ns, nl) == 1 { found = true } else { i = i + 1 } }
  }
  found
}

fn pipeline_expr_refs_name(node: i64, src: i64, ns: i64, nl: i64) -> bool {
  if node == 0 { false }
  else {
    match node_tag(node) {
      2 -> pipeline_name_matches(src, node_f1(node), node_f2(node), ns, nl)
      3 -> pipeline_expr_refs_name(node_f2(node), src, ns, nl) or pipeline_expr_refs_name(node_f3(node), src, ns, nl)
      4 -> pipeline_expr_list_refs_name(node_f3(node), node_f4(node), src, ns, nl)
      5 -> pipeline_expr_refs_name(node_f1(node), src, ns, nl) or pipeline_expr_refs_name(node_f2(node), src, ns, nl) or pipeline_expr_refs_name(node_f3(node), src, ns, nl)
      6 -> {
        if pipeline_expr_refs_name(node_f3(node), src, ns, nl) == 1 { true }
        else { if pipeline_name_matches(src, node_f1(node), node_f2(node), ns, nl) == 1 { false } else { pipeline_expr_refs_name(node_f4(node), src, ns, nl) } }
      }
      7 -> pipeline_expr_refs_name(node_f1(node), src, ns, nl) or pipeline_expr_refs_name(node_f2(node), src, ns, nl)
      10 -> pipeline_expr_refs_name(node_f1(node), src, ns, nl) or pipeline_expr_refs_name(node_f2(node), src, ns, nl)
      11 -> {
        if pipeline_expr_refs_name(node_f3(node), src, ns, nl) == 1 { true }
        else { if pipeline_name_matches(src, node_f1(node), node_f2(node), ns, nl) == 1 { false } else { pipeline_expr_refs_name(node_f4(node), src, ns, nl) } }
      }
      12 -> pipeline_expr_refs_name(node_f3(node), src, ns, nl)
      13 -> pipeline_expr_refs_name(node_f1(node), src, ns, nl)
      59 -> pipeline_expr_refs_name(node_f1(node), src, ns, nl)
      60 -> pipeline_expr_refs_name(node_f1(node), src, ns, nl) or pipeline_expr_refs_name(node_f2(node), src, ns, nl)
      61 -> pipeline_expr_refs_name(node_f1(node), src, ns, nl) or pipeline_expr_refs_name(node_f2(node), src, ns, nl) or pipeline_expr_refs_name(node_f3(node), src, ns, nl)
      62 -> pipeline_expr_refs_name(node_f1(node), src, ns, nl) or pipeline_expr_refs_name(node_f2(node), src, ns, nl) or pipeline_expr_refs_name(node_f3(node), src, ns, nl)
      14 -> pipeline_record_fields_refs_name(node_f3(node), node_f4(node), src, ns, nl)
      58 -> pipeline_expr_list_refs_name(node_f1(node), node_f2(node), src, ns, nl)
      15 -> pipeline_expr_refs_name(node_f1(node), src, ns, nl) or pipeline_match_arms_refs_name(node_f2(node), node_f3(node), src, ns, nl)
      22 -> pipeline_expr_refs_name(node_f1(node), src, ns, nl)
      25 -> pipeline_expr_refs_name(node_f1(node), src, ns, nl)
      26 -> pipeline_expr_refs_name(node_f1(node), src, ns, nl)
      27 -> pipeline_expr_refs_name(node_f1(node), src, ns, nl)
      29 -> {
        if pipeline_param_list_refs_name(node_f1(node), src, ns, nl) == 1 { false } else { pipeline_expr_refs_name(node_f2(node), src, ns, nl) }
      }
      32 -> pipeline_expr_refs_name(node_f1(node), src, ns, nl) or pipeline_expr_list_refs_name(node_f4(node), nlist_len(node_f4(node)), src, ns, nl)
      33 -> pipeline_expr_refs_name(node_f1(node), src, ns, nl) or pipeline_handler_clauses_refs_name(node_f2(node), node_f3(node), src, ns, nl)
      35 -> pipeline_expr_refs_name(node_f1(node), src, ns, nl)
      36 -> pipeline_expr_refs_name(node_f2(node), src, ns, nl)
      37 -> pipeline_expr_refs_name(node_f1(node), src, ns, nl)
      41 -> pipeline_expr_refs_name(node_f1(node), src, ns, nl) or pipeline_expr_list_refs_name(node_f3(node), nlist_len(node_f3(node)), src, ns, nl)
      45 -> pipeline_expr_refs_name(node_f1(node), src, ns, nl)
      46 -> pipeline_expr_refs_name(node_f1(node), src, ns, nl) or pipeline_expr_refs_name(node_f2(node), src, ns, nl)
      47 -> pipeline_expr_refs_name(node_f3(node), src, ns, nl) or pipeline_expr_refs_name(node_f4(node), src, ns, nl)
      48 -> pipeline_expr_refs_name(node_f1(node), src, ns, nl)
      49 -> pipeline_expr_refs_name(node_f1(node), src, ns, nl)
      52 -> pipeline_expr_refs_name(node_f1(node), src, ns, nl) or pipeline_expr_refs_name(node_f2(node), src, ns, nl)
      55 -> pipeline_expr_refs_name(node_f2(node), src, ns, nl)
      56 -> pipeline_expr_refs_name(node_f1(node), src, ns, nl)
      57 -> pipeline_expr_refs_name(node_f1(node), src, ns, nl) or pipeline_expr_refs_name(node_f2(node), src, ns, nl)
      _ -> false
    }
  }
}

fn pipeline_owned_param_drop_insts(params: i64, index: i64, count: i64, body: i64, src: i64) -> IrInstList {
  if params == 0 or index >= count {
    ir_inst_list_empty()
  } else {
    let param = nlist_get(params, index)
    let type_hash = cg_owned_drop_type_hash(node_f3(param))
    let rest = pipeline_owned_param_drop_insts(params, index + 1, count, body, src)
    if type_hash != 0 and pipeline_expr_refs_name(body, src, node_f1(param), node_f2(param)) == 0 {
      ir_inst_list_prepend(ir_inst_owned_drop_i64(pipeline_param_value_index_at(params, index), type_hash), rest)
    } else {
      rest
    }
  }
}

fn pipeline_owned_param_drop_insts_typed(params: i64, index: i64, count: i64, body: Expr, src: i64) -> IrInstList {
  if params == 0 or index >= count {
    ir_inst_list_empty()
  } else {
    let param = nlist_get(params, index)
    let type_hash = cg_owned_drop_type_hash(node_f3(param))
    let rest = pipeline_owned_param_drop_insts_typed(params, index + 1, count, body, src)
    if type_hash != 0 and pipeline_expr_refs_name_typed(body, src, node_f1(param), node_f2(param)) == 0 {
      ir_inst_list_prepend(ir_inst_owned_drop_i64(pipeline_param_value_index_at(params, index), type_hash), rest)
    } else {
      rest
    }
  }
}

fn pipeline_managed_param_release_insts(params: i64, index: i64, count: i64, next_value: i64) -> IrInstList {
  pipeline_managed_param_release_insts_at_with_borrow_mask(params, index, count, 0, next_value, 0)
}

fn pipeline_managed_param_release_insts_with_borrow_mask(params: i64, index: i64, count: i64, next_value: i64, borrowed_mask: i64) -> IrInstList {
  pipeline_managed_param_release_insts_at_with_borrow_mask(params, index, count, 0, next_value, borrowed_mask)
}

-- Release logical parameter heads at a physical SSA base. Ordinary functions
-- start at zero; handler clauses place operation parameters after their
-- capture lanes. The parameter type list is the effect declaration's
-- instantiated signature, not the parser's untyped clause aliases.
fn pipeline_managed_param_release_insts_at_with_borrow_mask(params: i64, index: i64, count: i64, value_base: i64, next_value: i64, borrowed_mask: i64) -> IrInstList {
  if params == 0 or index >= count {
    ir_inst_list_empty()
  } else {
    let param = nlist_get(params, index)
    let ty = node_f3(param)
    let release = if cg_mask_has(borrowed_mask, index) == 1 {
      ir_inst_list_empty()
    } else {
      pipeline_managed_release_inst_list(value_base + pipeline_param_value_index_at(params, index), ty, next_value)
    }
    let next = next_value + ir_inst_list_len(release)
    ir_inst_list_append(release, pipeline_managed_param_release_insts_at_with_borrow_mask(params, index + 1, count, value_base, next, borrowed_mask))
  }
}

fn pipeline_managed_param_release_value_next(params: i64, values: IrValueList, index: i64, count: i64, next_value: i64, borrowed_mask: i64) -> i64 {
  if params == 0 or index >= count {
    next_value
  } else {
    let param = nlist_get(params, index)
    let value = pipeline_ir_value_list_get_or(values, index, 0 - 1)
    let ty = node_f3(param)
    let release_count = pipeline_type_managed_release_lane_count(ty)
    let next = if value >= 0 and cg_mask_has(borrowed_mask, index) == 0 { next_value + release_count } else { next_value }
    pipeline_managed_param_release_value_next(params, values, index + 1, count, next, borrowed_mask)
  }
}

fn pipeline_managed_param_release_value_insts_with_borrow_mask(params: i64, values: IrValueList, index: i64, count: i64, next_value: i64, borrowed_mask: i64) -> IrInstList {
  if params == 0 or index >= count {
    ir_inst_list_empty()
  } else {
    let param = nlist_get(params, index)
    let value = pipeline_ir_value_list_get_or(values, index, 0 - 1)
    let ty = node_f3(param)
    let release = if value >= 0 and cg_mask_has(borrowed_mask, index) == 0 {
      pipeline_managed_release_inst_list(value, ty, next_value)
    } else {
      ir_inst_list_empty()
    }
    let next = next_value + ir_inst_list_len(release)
    ir_inst_list_append(release, pipeline_managed_param_release_value_insts_with_borrow_mask(params, values, index + 1, count, next, borrowed_mask))
  }
}

fn pipeline_owned_param_drop_value_insts(params: i64, values: IrValueList, index: i64, count: i64, body: i64, src: i64) -> IrInstList {
  if params == 0 or index >= count {
    ir_inst_list_empty()
  } else {
    let param = nlist_get(params, index)
    let type_hash = cg_owned_drop_type_hash(node_f3(param))
    let rest = pipeline_owned_param_drop_value_insts(params, values, index + 1, count, body, src)
    let value = pipeline_ir_value_list_get_or(values, index, 0 - 1)
    if type_hash != 0 and value >= 0 and pipeline_expr_refs_name(body, src, node_f1(param), node_f2(param)) == 0 {
      ir_inst_list_prepend(ir_inst_owned_drop_i64(value, type_hash), rest)
    } else {
      rest
    }
  }
}

fn pipeline_managed_param_list_release_insts(params: ParamList, index: i64, value_base: i64, next_value: i64) -> IrInstList {
  match params {
    ParamListNil -> ir_inst_list_empty()
    ParamListCons(param, rest) -> {
      let ty = match param {
        Param(ns, nl, ann_ty, label) -> pipeline_param_type_node_default_i64(param)
        UnknownParam(tag) -> 0
      }
      let release = pipeline_managed_release_inst_list(value_base + index, ty, next_value)
      let next = next_value + ir_inst_list_len(release)
      ir_inst_list_append(release, pipeline_managed_param_list_release_insts(rest, index + pipeline_type_value_lane_count_or_one(ty), value_base, next))
    }
  }
}

fn pipeline_ir_block_append_return_drops(block: IrBlock, drops: IrInstList) -> IrBlock {
  match block {
    IrBlock(id, params, insts, term) -> {
      match term {
        IrTermReturn(value) -> IrBlock(id, params, ir_inst_list_append(insts, drops), term)
        _ -> block
      }
    }
  }
}

fn pipeline_ir_block_list_append_return_drops(blocks: IrBlockList, drops: IrInstList) -> IrBlockList {
  match blocks {
    IrBlockListNil -> IrBlockListNil
    IrBlockListCons(block, rest) -> IrBlockListCons(
      pipeline_ir_block_append_return_drops(block, drops),
      pipeline_ir_block_list_append_return_drops(rest, drops)
    )
  }
}

fn pipeline_ir_block_append_return_lanes(block: IrBlock, return_ty: i64) -> IrBlock {
  match block {
    IrBlock(id, params, insts, term) -> {
      match term {
        IrTermReturn(value) -> IrBlock(id, params, ir_inst_list_append(insts, pipeline_ir_return_lane_insts(value, return_ty)), term)
        _ -> block
      }
    }
  }
}

fn pipeline_ir_block_list_append_return_lanes(blocks: IrBlockList, return_ty: i64) -> IrBlockList {
  match blocks {
    IrBlockListNil -> IrBlockListNil
    IrBlockListCons(block, rest) -> IrBlockListCons(
      pipeline_ir_block_append_return_lanes(block, return_ty),
      pipeline_ir_block_list_append_return_lanes(rest, return_ty)
    )
  }
}

fn pipeline_ir_value_list_contains(values: IrValueList, needle: i64) -> i64 {
  match values {
    IrValueNil -> 0
    IrValueCons(value, rest) -> {
      if value == needle { 1 } else { pipeline_ir_value_list_contains(rest, needle) }
    }
  }
}

fn pipeline_ir_term_transfers_value(term: IrTerminator, value: i64) -> i64 {
  match term {
    IrTermReturn(ret) -> if ret == value { 1 } else { 0 }
    IrTermJump(target, args) -> pipeline_ir_value_list_contains(args, value)
    _ -> 0
  }
}

fn pipeline_ir_inst_list_value_loads_slot(insts: IrInstList, value: i64, slot: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      match inst {
        IrLoadI64(dst, load_slot) -> {
          if dst == value and load_slot == slot { 1 } else { pipeline_ir_inst_list_value_loads_slot(rest, value, slot) }
        }
        _ -> pipeline_ir_inst_list_value_loads_slot(rest, value, slot)
      }
    }
  }
}

fn pipeline_ir_value_list_contains_slot_load(values: IrValueList, insts: IrInstList, slot: i64) -> i64 {
  match values {
    IrValueNil -> 0
    IrValueCons(value, rest) -> {
      if pipeline_ir_inst_list_value_loads_slot(insts, value, slot) == 1 { 1 } else { pipeline_ir_value_list_contains_slot_load(rest, insts, slot) }
    }
  }
}

fn pipeline_ir_term_transfers_slot_value(term: IrTerminator, insts: IrInstList, slot: i64) -> i64 {
  match term {
    IrTermReturn(value) -> pipeline_ir_inst_list_value_loads_slot(insts, value, slot)
    IrTermJump(target, args) -> pipeline_ir_value_list_contains_slot_load(args, insts, slot)
    _ -> 0
  }
}

fn pipeline_ir_term_leaves_loop_scope(term: IrTerminator, normal_block: i64, continue_block: i64, target_block: i64) -> i64 {
  match term {
    IrTermReturn(value) -> 1
    IrTermJump(target, args) -> {
      if target == normal_block or target == continue_block or target == target_block { 1 } else { 0 }
    }
    _ -> 0
  }
}

-- Loop-scope cleanup patches EVERY exit block, so each patched copy
-- must mint its own dst value id (2q slice 2: managed aggregates made
-- the cleanup non-empty, and a shared dst is a multi-block double
-- definition). Callers pre-count with the _count helper to advance
-- next_value, then the appender numbers copies base_dst + index in
-- block-list order.
fn pipeline_ir_block_loop_scope_cleanup_applies(block: IrBlock, bind_value: i64, normal_block: i64, continue_block: i64, target_block: i64) -> i64 {
  match block {
    IrBlock(id, params, insts, term) -> {
      if pipeline_ir_term_leaves_loop_scope(term, normal_block, continue_block, target_block) == 1 and pipeline_ir_term_transfers_value(term, bind_value) == 0 { 1 } else { 0 }
    }
  }
}

fn pipeline_ir_block_list_loop_scope_cleanup_count(blocks: IrBlockList, bind_value: i64, normal_block: i64, continue_block: i64, target_block: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      pipeline_ir_block_loop_scope_cleanup_applies(block, bind_value, normal_block, continue_block, target_block) +
      pipeline_ir_block_list_loop_scope_cleanup_count(rest, bind_value, normal_block, continue_block, target_block)
    }
  }
}

fn pipeline_ir_block_list_append_loop_scope_cleanup_indexed(blocks: IrBlockList, bind_value: i64, ty: i64, base_dst: i64, index: i64, normal_block: i64, continue_block: i64, target_block: i64) -> IrBlockList {
  match blocks {
    IrBlockListNil -> IrBlockListNil
    IrBlockListCons(block, rest) -> {
      let applies = pipeline_ir_block_loop_scope_cleanup_applies(block, bind_value, normal_block, continue_block, target_block)
      let patched = if applies == 1 {
        match block {
          IrBlock(id, params, insts, term) -> IrBlock(id, params, ir_inst_list_append(insts, pipeline_managed_release_inst_list(bind_value, ty, base_dst + index * pipeline_type_managed_release_lane_count(ty))), term)
        }
      } else { block }
      IrBlockListCons(
        patched,
        pipeline_ir_block_list_append_loop_scope_cleanup_indexed(rest, bind_value, ty, base_dst, index + applies, normal_block, continue_block, target_block)
      )
    }
  }
}

fn pipeline_ir_block_list_append_loop_owned_cleanup_indexed(blocks: IrBlockList, bind_value: i64, type_hash: i64, index: i64, normal_block: i64, continue_block: i64, target_block: i64) -> IrBlockList {
  match blocks {
    IrBlockListNil -> IrBlockListNil
    IrBlockListCons(block, rest) -> {
      let applies = pipeline_ir_block_loop_scope_cleanup_applies(block, bind_value, normal_block, continue_block, target_block)
      let patched = if applies == 1 {
        match block {
          IrBlock(id, params, insts, term) -> IrBlock(id, params, ir_inst_list_append(insts, ir_inst_list_prepend(ir_inst_owned_drop_i64(bind_value, type_hash), ir_inst_list_empty())), term)
        }
      } else { block }
      IrBlockListCons(
        patched,
        pipeline_ir_block_list_append_loop_owned_cleanup_indexed(rest, bind_value, type_hash, index + applies, normal_block, continue_block, target_block)
      )
    }
  }
}

fn pipeline_managed_slot_cleanup_inst_list(slot: i64, ty: i64, next_value: i64) -> IrInstList {
  pipeline_managed_slot_cleanup_lane_inst_list(slot, ty, pipeline_type_value_lane_count_or_one(ty) - 1, next_value)
}

fn pipeline_managed_slot_cleanup_lane_inst_list(slot: i64, ty: i64, lane: i64, next_value: i64) -> IrInstList {
  if lane < 0 { ir_inst_list_empty() }
  else {
    let callee = pipeline_managed_release_hash_for_kind(pipeline_type_value_lane_release_kind(ty, lane))
    if callee == 0 { pipeline_managed_slot_cleanup_lane_inst_list(slot, ty, lane - 1, next_value) }
    else {
      let current = ir_inst_list_prepend(
        ir_inst_load_i64(next_value, slot + lane),
        ir_inst_list_prepend(ir_inst_call_i64(next_value + 1, callee, ir_value_list_prepend(next_value, ir_value_list_empty())), ir_inst_list_empty())
      )
      ir_inst_list_append(current, pipeline_managed_slot_cleanup_lane_inst_list(slot, ty, lane - 1, next_value + 2))
    }
  }
}

-- Slot-based twin: each patched copy loads the slot into its own value
-- id and releases through its own dst (two ids per copy).
fn pipeline_ir_block_loop_slot_cleanup_applies(block: IrBlock, slot: i64, normal_block: i64, continue_block: i64, target_block: i64) -> i64 {
  match block {
    IrBlock(id, params, insts, term) -> {
      if pipeline_ir_term_leaves_loop_scope(term, normal_block, continue_block, target_block) == 1 and pipeline_ir_term_transfers_slot_value(term, insts, slot) == 0 { 1 } else { 0 }
    }
  }
}

fn pipeline_ir_block_list_loop_slot_cleanup_count(blocks: IrBlockList, slot: i64, normal_block: i64, continue_block: i64, target_block: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      pipeline_ir_block_loop_slot_cleanup_applies(block, slot, normal_block, continue_block, target_block) +
      pipeline_ir_block_list_loop_slot_cleanup_count(rest, slot, normal_block, continue_block, target_block)
    }
  }
}

fn pipeline_ir_block_list_append_loop_slot_cleanup_indexed(blocks: IrBlockList, slot: i64, ty: i64, base_dst: i64, index: i64, normal_block: i64, continue_block: i64, target_block: i64) -> IrBlockList {
  match blocks {
    IrBlockListNil -> IrBlockListNil
    IrBlockListCons(block, rest) -> {
      let applies = pipeline_ir_block_loop_slot_cleanup_applies(block, slot, normal_block, continue_block, target_block)
      let patched = if applies == 1 {
        match block {
          IrBlock(id, params, insts, term) -> IrBlock(id, params, ir_inst_list_append(insts, pipeline_managed_slot_cleanup_inst_list(slot, ty, base_dst + index * pipeline_type_managed_release_lane_count(ty) * 2)), term)
        }
      } else { block }
      IrBlockListCons(
        patched,
        pipeline_ir_block_list_append_loop_slot_cleanup_indexed(rest, slot, ty, base_dst, index + applies, normal_block, continue_block, target_block)
      )
    }
  }
}

fn pipeline_capture_prepend(ns: i64, nl: i64, value: i64, rest: i64) -> i64 {
  node_new(0, ns, nl, value, rest)
}

fn pipeline_capture_lane_count(capture: i64) -> i64 {
  pipeline_type_value_lane_count_or_one(node_f4(capture))
}

fn pipeline_capture_value_lane_count(captures: i64) -> i64 {
  let mut total = 0
  let n = if captures == 0 { 0 } else { nlist_len(captures) }
  for i in 0..n {
    total = total + pipeline_capture_lane_count(nlist_get(captures, i))
  }
  total
}

fn pipeline_capture_value_lane_offset(captures: i64, index: i64) -> i64 {
  let mut offset = 0
  for i in 0..index {
    offset = offset + pipeline_capture_lane_count(nlist_get(captures, i))
  }
  offset
}

fn pipeline_capture_from_params(params: i64, index: i64, count: i64, rest: i64) -> i64 {
  if params == 0 or index >= count {
    rest
  } else {
    let param = nlist_get(params, index)
    pipeline_capture_from_params(params, index + 1, count, pipeline_capture_prepend(node_f1(param), node_f2(param), index, rest))
  }
}

fn pipeline_capture_from_locals(locals: PipelineValueEnv, rest: i64) -> i64 {
  match locals {
    PipelineValueEnvNil -> rest
    PipelineValueEnvCons(ns, nl, value, kind, float_prim, type_hash, type_node, next) -> pipeline_capture_prepend(ns, nl, value, pipeline_capture_from_locals(next, rest))
  }
}

fn pipeline_capture_env(params: i64, nparams: i64, locals: PipelineValueEnv) -> i64 {
  pipeline_capture_from_locals(locals, pipeline_capture_from_params(params, 0, nparams, 0))
}

fn pipeline_capture_scope(captures: i64, scope: i64) -> i64 {
  if captures == 0 {
    scope
  } else {
    let rest_scope = pipeline_capture_scope(node_f4(captures), scope)
    scope_push(rest_scope, node_f1(captures), node_f2(captures), cg_canonical_value_home(node_f3(captures)))
  }
}

fn pipeline_lambda_capture_entry(ns: i64, nl: i64, value: i64, type_node: i64) -> i64 {
  node_new(4, ns, nl, value, type_node)
}

fn pipeline_lambda_capture_list_has(captures: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let mut found = 0
  let mut i = 0
  while i < nlist_len(captures) {
    let capture = nlist_get(captures, i)
    if node_f2(capture) == nl and src_eq_at(src, ns, src + node_f1(capture), 0, nl) == 1 {
      found = 1
      i = nlist_len(captures)
    } else {
      i = i + 1
    }
  }
  found
}

fn pipeline_lambda_capture_maybe_add(ns: i64, nl: i64, local_scope: i64, locals: PipelineValueEnv, src: i64, captures: i64) -> i64 {
  if scope_lookup(local_scope, src, ns, nl) != 0 - 999 { 0 }
  else {
    let value = pipeline_value_env_lookup(locals, src, ns, nl)
    if value < 0 { 0 }
    else {
      if pipeline_lambda_capture_list_has(captures, src, ns, nl) == 1 { 0 }
      else {
        nlist_add(captures, pipeline_lambda_capture_entry(ns, nl, value, pipeline_value_env_lookup_type_node(locals, src, ns, nl)))
      }
    }
  }
}

fn pipeline_lambda_capture_expr_list(exprs: ExprList, local_scope: i64, locals: PipelineValueEnv, src: i64, captures: i64) -> i64 {
  match exprs {
    ExprListNil -> 0
    ExprListCons(expr, rest) -> {
      pipeline_lambda_capture_expr(expr, local_scope, locals, src, captures)
      pipeline_lambda_capture_expr_list(rest, local_scope, locals, src, captures)
    }
  }
}

fn pipeline_lambda_capture_record_fields(fields: RecordFieldList, local_scope: i64, locals: PipelineValueEnv, src: i64, captures: i64) -> i64 {
  match fields {
    RecordFieldListNil -> 0
    RecordFieldListCons(field, rest) -> {
      pipeline_lambda_capture_expr(record_field_value_expr(field), local_scope, locals, src, captures)
      pipeline_lambda_capture_record_fields(rest, local_scope, locals, src, captures)
    }
  }
}

fn pipeline_lambda_capture_match_arms(arms: MatchArmList, local_scope: i64, locals: PipelineValueEnv, src: i64, captures: i64) -> i64 {
  match arms {
    MatchArmListNil -> 0
    MatchArmListCons(arm, rest) -> {
      let arm_scope = pipeline_typed_ffv_bind_pattern(match_arm_pattern(arm), local_scope, src)
      if match_arm_has_guard(arm) == 1 {
        pipeline_lambda_capture_expr(match_arm_guard_expr(arm), arm_scope, locals, src, captures)
      } else { 0 }
      pipeline_lambda_capture_expr(match_arm_body_expr(arm), arm_scope, locals, src, captures)
      pipeline_lambda_capture_match_arms(rest, local_scope, locals, src, captures)
    }
  }
}

fn pipeline_lambda_capture_handler_clauses(clauses: HandlerClauseList, local_scope: i64, locals: PipelineValueEnv, src: i64, captures: i64) -> i64 {
  match clauses {
    HandlerClauseListNil -> 0
    HandlerClauseListCons(clause, rest) -> {
      let clause_scope = pipeline_typed_ffv_bind_params(handler_clause_params(clause), local_scope)
      let clause_scope2 = match handler_clause_continuation(clause) {
        HandlerClauseContinuation(ns, nl) -> scope_push(clause_scope, ns, nl, 0)
        _ -> clause_scope
      }
      pipeline_lambda_capture_expr(handler_clause_body_expr(clause), clause_scope2, locals, src, captures)
      pipeline_lambda_capture_handler_clauses(rest, local_scope, locals, src, captures)
    }
  }
}

fn pipeline_lambda_capture_expr(expr: Expr, local_scope: i64, locals: PipelineValueEnv, src: i64, captures: i64) -> i64 {
  match expr {
    Ident(ns, nl) -> pipeline_lambda_capture_maybe_add(ns, nl, local_scope, locals, src, captures)
    BinOp(op, lhs, rhs) -> {
      pipeline_lambda_capture_expr(lhs, local_scope, locals, src, captures)
      pipeline_lambda_capture_expr(rhs, local_scope, locals, src, captures)
    }
    Call(ns, nl, args) -> {
      pipeline_lambda_capture_maybe_add(ns, nl, local_scope, locals, src, captures)
      pipeline_lambda_capture_expr_list(args, local_scope, locals, src, captures)
    }
    GenericCall(type_args, inner_call) -> pipeline_lambda_capture_expr(inner_call, local_scope, locals, src, captures)
    If(cond, then_expr, else_expr) -> {
      pipeline_lambda_capture_expr(cond, local_scope, locals, src, captures)
      pipeline_lambda_capture_expr(then_expr, local_scope, locals, src, captures)
      pipeline_lambda_capture_expr(else_expr, local_scope, locals, src, captures)
    }
    While(cond, body) -> {
      pipeline_lambda_capture_expr(cond, local_scope, locals, src, captures)
      pipeline_lambda_capture_expr(body, local_scope, locals, src, captures)
    }
    Loop(body) -> pipeline_lambda_capture_expr(body, local_scope, locals, src, captures)
    Break(value) -> pipeline_lambda_capture_expr(value, local_scope, locals, src, captures)
    Return(value) -> pipeline_lambda_capture_expr(value, local_scope, locals, src, captures)
    Defer(cleanup, body) -> {
      pipeline_lambda_capture_expr(cleanup, local_scope, locals, src, captures)
      pipeline_lambda_capture_expr(body, local_scope, locals, src, captures)
    }
    Let(ns, nl, value, body) -> {
      pipeline_lambda_capture_expr(value, local_scope, locals, src, captures)
      pipeline_lambda_capture_expr(body, scope_push(local_scope, ns, nl, 0), locals, src, captures)
    }
    LetMut(ns, nl, value, body) -> {
      pipeline_lambda_capture_expr(value, local_scope, locals, src, captures)
      pipeline_lambda_capture_expr(body, scope_push(local_scope, ns, nl, 0), locals, src, captures)
    }
    Assign(ns, nl, value) -> {
      pipeline_lambda_capture_maybe_add(ns, nl, local_scope, locals, src, captures)
      pipeline_lambda_capture_expr(value, local_scope, locals, src, captures)
    }
    AddressOf(mutable, target) -> pipeline_lambda_capture_expr(target, local_scope, locals, src, captures)
    Deref(ptr) -> pipeline_lambda_capture_expr(ptr, local_scope, locals, src, captures)
    PtrAssign(ptr, value) -> {
      pipeline_lambda_capture_expr(ptr, local_scope, locals, src, captures)
      pipeline_lambda_capture_expr(value, local_scope, locals, src, captures)
    }
    Block(first, rest) -> {
      pipeline_lambda_capture_expr(first, local_scope, locals, src, captures)
      pipeline_lambda_capture_expr(rest, local_scope, locals, src, captures)
    }
    FieldAccess(base, field_ns, field_nl, fact) -> pipeline_lambda_capture_expr(base, local_scope, locals, src, captures)
    IndexedLen(base, fixed_len) -> pipeline_lambda_capture_expr(base, local_scope, locals, src, captures)
    IndexedGet(base, index, element_ty, fixed_len) -> { pipeline_lambda_capture_expr(base, local_scope, locals, src, captures) pipeline_lambda_capture_expr(index, local_scope, locals, src, captures) }
    IndexedSet(base, index, value, fact) -> { pipeline_lambda_capture_expr(base, local_scope, locals, src, captures) pipeline_lambda_capture_expr(index, local_scope, locals, src, captures) pipeline_lambda_capture_expr(value, local_scope, locals, src, captures) }
    IndexedSlice(base, start, end, fact) -> { pipeline_lambda_capture_expr(base, local_scope, locals, src, captures) pipeline_lambda_capture_expr(start, local_scope, locals, src, captures) pipeline_lambda_capture_expr(end, local_scope, locals, src, captures) }
    RecordInit(type_ns, type_nl, fields) -> pipeline_lambda_capture_record_fields(fields, local_scope, locals, src, captures)
    ArrayLiteral(elements, resolved_ty, span) -> pipeline_lambda_capture_expr_list(elements, local_scope, locals, src, captures)
    Match(scrutinee, arms) -> {
      pipeline_lambda_capture_expr(scrutinee, local_scope, locals, src, captures)
      pipeline_lambda_capture_match_arms(arms, local_scope, locals, src, captures)
    }
    Not(operand) -> pipeline_lambda_capture_expr(operand, local_scope, locals, src, captures)
    Lambda(params, body) -> pipeline_lambda_capture_expr(body, pipeline_typed_ffv_bind_params(params, local_scope), locals, src, captures)
    Perform(lhs, op_ns, op_nl, args) -> {
      pipeline_lambda_capture_expr(lhs, local_scope, locals, src, captures)
      pipeline_lambda_capture_expr_list(args, local_scope, locals, src, captures)
    }
    Handle(body, clauses, hret) -> {
      pipeline_lambda_capture_expr(body, local_scope, locals, src, captures)
      pipeline_lambda_capture_handler_clauses(clauses, local_scope, locals, src, captures)
      match hret {
        NoHandleReturn -> 0
        HandleReturnClause(rns, rnl, rb) -> pipeline_lambda_capture_expr(rb, local_scope, locals, src, captures)
      }
    }
    Resume(value) -> pipeline_lambda_capture_expr(value, local_scope, locals, src, captures)
    MethodCall(recv, method_hash, args, type_hash) -> {
      pipeline_lambda_capture_expr(recv, local_scope, locals, src, captures)
      pipeline_lambda_capture_expr_list(args, local_scope, locals, src, captures)
    }
    Try(inner, effect_atom) -> pipeline_lambda_capture_expr(inner, local_scope, locals, src, captures)
    InterpConcat(left, right) -> {
      pipeline_lambda_capture_expr(left, local_scope, locals, src, captures)
      pipeline_lambda_capture_expr(right, local_scope, locals, src, captures)
    }
    ForIter(var_ns, var_nl, collection, body) -> {
      pipeline_lambda_capture_expr(collection, local_scope, locals, src, captures)
      pipeline_lambda_capture_expr(body, scope_push(local_scope, var_ns, var_nl, 0), locals, src, captures)
    }
    OptChain(base, field_ns, field_nl, effect_atom) -> pipeline_lambda_capture_expr(base, local_scope, locals, src, captures)
    LetTyped(inner, ann_type) -> pipeline_lambda_capture_expr(inner, local_scope, locals, src, captures)
    _ -> 0
  }
}

-- Enclosing-function params live in the ctx param list, not the value env.
-- The capture walk resolves names through the env only, so params referenced
-- inside a lambda must be surfaced there (param i binds IR value i). Locals
-- keep precedence: a param is only added when the env has no binding.
fn pipeline_lambda_capture_env_with_params(fn_params: i64, locals: PipelineValueEnv, src: i64) -> PipelineValueEnv {
  let n = if fn_params == 0 { 0 } else { nlist_len(fn_params) }
  let mut env = locals
  for i in 0..n {
    let param = nlist_get(fn_params, i)
    let p_ns = node_f1(param)
    let p_nl = node_f2(param)
    if pipeline_value_env_lookup(locals, src, p_ns, p_nl) < 0 {
      let ty = node_f3(param)
      let type_hash = if ty == 0 { 0 } else { type_hash_of(ty) }
      let float_prim = type_expr_prim_id_or(type_expr_from_node(ty), 0)
      env = pipeline_value_env_push_float_typed_node(env, p_ns, p_nl, pipeline_param_value_index_at(fn_params, i), float_prim, type_hash, ty)
    } else { 0 }
  }
  env
}

-- ---------------------------------------------------------------------
-- Lambda hoisting (2k slice A): lower every lambda body into a
-- standalone ordinary IrFunction at lowering time. The closure ABI
-- (code ptr called with env in x0, args in x1..) is exactly a normal
-- direct call to fn(env, p1..pn), so the synthetic function needs no
-- special prologue: env is param 0, lambda params are 1..nparams, and
-- the entry preamble loads each capture with const/add/ptr-load
-- triples off env. The body then flows through the optimiser, mem2reg,
-- and residency like every named function. Direct performs use an
-- explicit lowering-time evidence fact whose ops-table pointer is loaded
-- from the closure env.
-- ---------------------------------------------------------------------

fn pipeline_lambda_hoist_subst_mix(subst: i64) -> i64 {
  if subst == 0 { 0 } else {
    let mut h = 0
    let n = nlist_len(subst)
    for i in 0..n {
      h = h * 31 + cg_type_node_hash(node_f2(nlist_get(subst, i)))
    }
    h
  }
}

-- The body NODE POINTER is the site key: unique per lambda site, and
-- pipeline_expr_node_subst_types creates a fresh node per spec whenever
-- the substitution changes anything the body mentions (identical
-- bodies across specs deliberately share one hash — the functions are
-- identical and the collector dedups). Node pointers are deterministic
-- within a build (bump allocation), and the hash never reaches the
-- output bytes — it keys mono_cache entries and branch patches only.
fn pipeline_lambda_evidence_hash_mix(evidence: IrLambdaEvidence) -> i64 {
  match evidence {
    IrLambdaEvidenceNone -> 0
    IrLambdaEvidenceBound(eff_hash, op_hashes, value) -> {
      let mut h = eff_hash
      let n = nlist_len(op_hashes)
      for i in 0..n {
        h = h * 31 + nlist_get(op_hashes, i)
      }
      h
    }
  }
}

fn pipeline_lambda_hoist_hash(src: i64, body_node: i64, subst: i64, evidence: IrLambdaEvidence) -> i64 {
  body_node * 1000003 + pipeline_lambda_hoist_subst_mix(subst) * 31 + pipeline_lambda_evidence_hash_mix(evidence) * 131 + 19790507
}

fn pipeline_lambda_hoist_locals(params: ParamList, captures: i64, nfree: i64) -> PipelineValueEnv {
  -- The env is physical parameter 0. Lambda parameters and captures use
  -- the shared typed value-shape fact, so a slice head is immediately
  -- followed by its length lane in SSA numbering.
  let with_params = pipeline_lambda_hoist_params(params, 0, 1, pipeline_value_env_empty())
  let base = 1 + pipeline_params_value_lane_count(param_list_to_nodes(params))
  let mut locals = with_params
  let mut bi = 0
  while bi < nfree {
    let capture = nlist_get(captures, bi)
    let type_node = node_f4(capture)
    let type_hash = if type_node == 0 { 0 } else { type_hash_of(type_node) }
    let float_prim = pipeline_type_node_prim_id_or(type_node, 0)
    locals = pipeline_value_env_push_float_typed_node(locals, node_f1(capture), node_f2(capture), base + pipeline_capture_value_lane_offset(captures, bi), float_prim, type_hash, type_node)
    bi = bi + 1
  }
  locals
}

fn pipeline_lambda_hoist_preamble(captures: i64, nfree: i64, base: i64) -> IrInstList {
  let mut insts = ir_inst_list_empty()
  let capture_lanes = pipeline_capture_value_lane_count(captures)
  let scratch_base = base + capture_lanes
  let mut word = 0
  for bi in 0..nfree {
    let capture = nlist_get(captures, bi)
    let lanes = pipeline_capture_lane_count(capture)
    for lane in 0..lanes {
      let const_id = scratch_base + word * 2
      let addr_id = const_id + 1
      let val_id = base + word
      let load = ir_inst_list_prepend(
        ir_inst_const_i64(const_id, 8 + word * 16),
        ir_inst_list_prepend(
          ir_inst_binary_i64(addr_id, ir_binary_op_from_parser(1), 0, const_id),
          ir_inst_list_prepend(ir_inst_ptr_load_i64(val_id, addr_id), ir_inst_list_empty())
        )
      )
      insts = ir_inst_list_append(insts, load)
      word = word + 1
    }
  }
  insts
}

fn pipeline_handler_inline_ctx_lambda_evidence_selection(handlers: PipelineHandlerInlineCtx, body: Expr, src: i64, subst: i64) -> PipelineLambdaEvidenceSelection {
  match handlers {
    PipelineHandlerInlineCtxNil -> PipelineLambdaEvidenceSelectionNone
    PipelineHandlerInlineCtxCons(eff_hash, clauses, nclauses, clause_src, direct, evidence, out_of_line_safe, rest) -> {
      if evidence == 1 and nclauses > 0 and pipeline_typed_expr_performs_key(body, src, eff_hash, subst) == 1 {
        PipelineLambdaEvidenceSelectionBound(eff_hash, clauses, nclauses, if clause_src != 0 { clause_src } else { src })
      } else {
        pipeline_handler_inline_ctx_lambda_evidence_selection(rest, body, src, subst)
      }
    }
  }
}

fn pipeline_lambda_evidence_from_selection(selection: PipelineLambdaEvidenceSelection, value: i64) -> IrLambdaEvidence {
  match selection {
    PipelineLambdaEvidenceSelectionNone -> IrLambdaEvidenceNone
    PipelineLambdaEvidenceSelectionBound(eff_hash, clauses, nclauses, clause_src) -> {
      IrLambdaEvidenceBound(eff_hash, pipeline_lambda_evidence_op_hashes(clauses, nclauses, clause_src), value)
    }
  }
}

fn pipeline_lambda_evidence_preamble(evidence: IrLambdaEvidence, nfree: i64, base: i64) -> IrInstList {
  match evidence {
    IrLambdaEvidenceNone -> ir_inst_list_empty()
    IrLambdaEvidenceBound(eff_hash, op_hashes, value) -> {
      let const_id = base
      let addr_id = base + 1
      ir_inst_list_prepend(
        ir_inst_const_i64(const_id, 8 + nfree * 16),
        ir_inst_list_prepend(
          ir_inst_binary_i64(addr_id, ir_binary_op_from_parser(1), 0, const_id),
          ir_inst_list_prepend(ir_inst_ptr_load_i64(value, addr_id), ir_inst_list_empty())
        )
      )
    }
  }
}

fn pipeline_lambda_evidence_value_count(evidence: IrLambdaEvidence) -> i64 {
  match evidence {
    IrLambdaEvidenceNone -> 0
    IrLambdaEvidenceBound(eff_hash, op_hashes, value) -> 3
  }
}

-- Captures loaded from the closure environment are borrowed aliases, just
-- like explicit function parameters. Return transfer must retain them for
-- the caller without emitting the balancing release reserved for owned
-- locals. Keep this classification separate from the physical parameter
-- list: captures remain env fields in the closure ABI.
fn pipeline_lambda_return_transfer_params(lambda_params: ParamList, captures: i64) -> i64 {
  let params = param_list_to_nodes(lambda_params)
  for i in 0..nlist_len(captures) {
    let capture = nlist_get(captures, i)
    nlist_add(params, node_new(2, node_f1(capture), node_f2(capture), node_f4(capture), 0))
  }
  params
}

-- Returns one closure-construction instruction. A failure is represented in
-- IR and traps through the ordinary lowering-failure path; no AST-bearing
-- lambda fallback survives phase 2.
fn pipeline_lower_lambda_hoisted(lambda_params: ParamList, lambda_body: Expr, lambda_captures: i64, lower_ctx: PipelineHandlerLowerCtx, dst: i64) -> IrInstList {
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let fns = pipeline_handler_lower_ctx_fns(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  let nparams = param_list_len(lambda_params)
  let param_lanes = pipeline_params_value_lane_count(param_list_to_nodes(lambda_params))
  let nfree = nlist_len(lambda_captures)
  let capture_lanes = pipeline_capture_value_lane_count(lambda_captures)
  let base = 1 + param_lanes
  let locals = pipeline_lambda_hoist_locals(lambda_params, lambda_captures, nfree)
  let selection = pipeline_handler_inline_ctx_lambda_evidence_selection(pipeline_handler_lower_ctx_handlers(lower_ctx), lambda_body, src, subst)
  let evidence_base = base + capture_lanes * 3
  let evidence_value = evidence_base + 2
  let evidence = pipeline_lambda_evidence_from_selection(selection, evidence_value)
  -- Direct performs in the synthetic function must remain residual: the
  -- creation handler is no longer on the runtime stack when an escaping
  -- closure runs. The evidence-only context exists solely so nested lambdas
  -- can inherit the captured ops table.
  let module = pipeline_lower_module_with_handlers(
    pipeline_lower_module_with_fns_subst(src, tt, fns, subst),
    pipeline_handler_inline_ctx_evidence_only(selection)
  )
  let next_value = evidence_base + pipeline_lambda_evidence_value_count(evidence)
  let return_block = 1
  let lowered = pipeline_lower_expr_typed_to_target_blocks_reserved(lambda_body, 0, locals, module, next_value, 0, 2, return_block)
  if pipeline_lowered_blocks_is_valid(lowered) == 0 {
    ir_inst_list_prepend(ir_inst_lowering_failure_i64(13), ir_inst_list_empty())
  } else {
    let param_nodes = param_list_to_nodes(lambda_params)
    let return_transfer_params = pipeline_lambda_return_transfer_params(lambda_params, lambda_captures)
    let inferred_return_ty = pipeline_return_expr_type_node_typed(lambda_body, param_nodes, locals, module)
    let return_ty = if inferred_return_ty != 0 { inferred_return_ty } else { ty_any() }
    let mut lambda_drop_next = pipeline_lowered_blocks_next_value(lowered)
    let raw_blocks = if pipeline_lowered_blocks_falls_through(lowered) == 1 {
      let return_value = pipeline_lowered_blocks_next_value(lowered)
      let return_lanes = pipeline_type_value_lane_count_or_one(return_ty)
      let transfer = pipeline_lower_return_transfer_typed(lambda_body, return_value, return_value + return_lanes, return_transfer_params, locals, module)
      lambda_drop_next = ir_lowered_expr_next_value(transfer)
      let return_params = pipeline_ir_value_lane_ids(ir_lowered_expr_value(transfer), 0, return_lanes)
      let return_insts = ir_inst_list_append(ir_lowered_expr_insts(transfer), pipeline_ir_return_lane_insts(ir_lowered_expr_value(transfer), return_ty))
      let return_node = ir_block_new_params(return_block, return_params, return_insts, ir_term_return(ir_lowered_expr_value(transfer)))
      ir_block_list_append(pipeline_lowered_blocks_blocks(lowered), ir_block_list_prepend(return_node, ir_block_list_empty()))
    } else {
      pipeline_lowered_blocks_blocks(lowered)
    }
    let lambda_param_drops = pipeline_managed_param_list_release_insts(lambda_params, 0, 1, lambda_drop_next)
    let dropped = pipeline_ir_block_list_append_return_drops(raw_blocks, lambda_param_drops)
    let preamble = ir_inst_list_append(
      pipeline_lambda_hoist_preamble(lambda_captures, nfree, base),
      pipeline_lambda_evidence_preamble(evidence, capture_lanes, evidence_base)
    )
    let blocks = pipeline_ir_block_list_prepend_entry_insts(dropped, 0, preamble)
    let fn_hash = pipeline_lambda_hoist_hash(src, expr_to_node(lambda_body), subst, evidence)
    let f = IrFunction(fn_hash, param_lanes + 1, blocks, src)
    let facts = pipeline_ir_lambda_semantic_facts(lambda_params, lambda_body, lambda_captures, src, fns, return_ty, base, evidence)
    ir_inst_list_prepend(ir_inst_closure_i64(dst, f, lambda_captures, facts), ir_inst_list_empty())
  }
}

fn pipeline_lambda_captures_for(params: ParamList, body: Expr, lower_ctx: PipelineHandlerLowerCtx) -> i64 {
  let captures = nlist_new()
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let env = pipeline_lambda_capture_env_with_params(pipeline_handler_lower_ctx_params(lower_ctx), pipeline_handler_lower_ctx_locals(lower_ctx), src)
  pipeline_lambda_capture_expr(body, pipeline_typed_ffv_bind_params(params, scope_new()), env, src, captures)
  captures
}

fn pipeline_ir_block_prepend_insts(block: IrBlock, prefix: IrInstList) -> IrBlock {
  match block {
    IrBlock(id, params, insts, term) -> IrBlock(id, params, ir_inst_list_append(prefix, insts), term)
  }
}

fn pipeline_ir_block_list_prepend_entry_insts(blocks: IrBlockList, entry_id: i64, prefix: IrInstList) -> IrBlockList {
  match blocks {
    IrBlockListNil -> IrBlockListNil
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          let next_block = if id == entry_id { pipeline_ir_block_prepend_insts(block, prefix) } else { block }
          IrBlockListCons(next_block, pipeline_ir_block_list_prepend_entry_insts(rest, entry_id, prefix))
        }
      }
    }
  }
}

fn pipeline_lower_typed_functions_internal(typed: TypedModule) -> IrFunctionList {
  match typed {
    TypedModule(fns, src, tt) -> pipeline_lower_fns_handler_optimised(fns, tt, src)
  }
}

fn pipeline_binary_buf(binary: BinaryObject) -> rc i64 {
  match binary {
    BinaryObject(o, kind) -> o
  }
}

fn pipeline_type_list_contains_rc(types: i64) -> bool {
  let mut found = false
  let n = if types == 0 { 0 } else { nlist_len(types) }
  let mut i = 0
  while i < n {
    if pipeline_ty_contains_rc(nlist_get(types, i)) {
      found = 1
      i = n
    } else { i = i + 1 }
  }
  found
}

fn pipeline_type_list_contains_closure(types: i64) -> bool {
  let mut found = false
  let n = if types == 0 { 0 } else { nlist_len(types) }
  let mut i = 0
  while i < n {
    if pipeline_ty_contains_closure(nlist_get(types, i)) {
      found = true
      i = n
    } else { i = i + 1 }
  }
  found
}

fn pipeline_type_list_contains_weak(types: i64) -> bool {
  let mut found = false
  let n = if types == 0 { 0 } else { nlist_len(types) }
  let mut i = 0
  while i < n {
    if pipeline_ty_contains_weak(nlist_get(types, i)) {
      found = 1
      i = n
    } else { i = i + 1 }
  }
  found
}

fn pipeline_record_fields_contains_rc(fields: i64) -> bool {
  let mut found = false
  let mut i = 0
  while fields != 0 and i < nlist_len(fields) and not found {
    if pipeline_ty_contains_rc(ty_record_field_type(nlist_get(fields, i))) { found = true }
    else { i = i + 1 }
  }
  found
}

fn pipeline_record_fields_contains_weak(fields: i64) -> bool {
  let mut found = false
  let mut i = 0
  while fields != 0 and i < nlist_len(fields) and not found {
    if pipeline_ty_contains_weak(ty_record_field_type(nlist_get(fields, i))) { found = true }
    else { i = i + 1 }
  }
  found
}

fn pipeline_record_fields_contains_closure(fields: i64) -> bool {
  let mut found = false
  let mut i = 0
  while fields != 0 and i < nlist_len(fields) and not found {
    if pipeline_ty_contains_closure(ty_record_field_type(nlist_get(fields, i))) { found = true }
    else { i = i + 1 }
  }
  found
}

fn pipeline_ty_contains_rc(ty: i64) -> bool {
  if ty == 0 { false }
  else {
    match ty_tag(ty) {
      3 -> pipeline_ty_contains_rc(ty_f1(ty)) or pipeline_ty_contains_rc(ty_f2(ty))
      4 -> pipeline_ty_contains_rc(ty_f1(ty)) or pipeline_ty_contains_rc(ty_f2(ty))
      5 -> pipeline_ty_contains_rc(ty_f1(ty))
      6 -> pipeline_type_list_contains_rc(ty_f1(ty)) or pipeline_ty_contains_rc(ty_f2(ty))
      7 -> pipeline_record_fields_contains_rc(ty_record_fields(ty))
      9 -> {
        if ty_is_rc(ty) == 1 { true }
        else { pipeline_ty_contains_rc(ty_f2(ty)) or pipeline_type_list_contains_rc(ty_f3(ty)) }
      }
      18 -> pipeline_ty_contains_rc(ty_unique_inner(ty))
      19 -> pipeline_ty_contains_rc(ty_owned_inner(ty))
      _ -> false
    }
  }
}

fn pipeline_ty_contains_weak(ty: i64) -> bool {
  if ty == 0 { false }
  else {
    match ty_tag(ty) {
      3 -> pipeline_ty_contains_weak(ty_f1(ty)) or pipeline_ty_contains_weak(ty_f2(ty))
      4 -> pipeline_ty_contains_weak(ty_f1(ty)) or pipeline_ty_contains_weak(ty_f2(ty))
      5 -> pipeline_ty_contains_weak(ty_f1(ty))
      6 -> pipeline_type_list_contains_weak(ty_f1(ty)) or pipeline_ty_contains_weak(ty_f2(ty))
      7 -> pipeline_record_fields_contains_weak(ty_record_fields(ty))
      9 -> pipeline_ty_contains_weak(ty_f2(ty)) or pipeline_type_list_contains_weak(ty_f3(ty))
      16 -> true
      17 -> pipeline_ty_contains_weak(ty_f1(ty))
      18 -> pipeline_ty_contains_weak(ty_unique_inner(ty))
      19 -> pipeline_ty_contains_weak(ty_owned_inner(ty))
      _ -> false
    }
  }
}

fn pipeline_ty_contains_closure(ty: i64) -> bool {
  if ty == 0 { false }
  else {
    match ty_tag(ty) {
      3 -> pipeline_ty_contains_closure(ty_f1(ty)) or pipeline_ty_contains_closure(ty_f2(ty))
      4 -> pipeline_ty_contains_closure(ty_f1(ty)) or pipeline_ty_contains_closure(ty_f2(ty))
      5 -> pipeline_ty_contains_closure(ty_f1(ty))
      6 -> true
      7 -> pipeline_record_fields_contains_closure(ty_record_fields(ty))
      9 -> pipeline_ty_contains_closure(ty_f2(ty)) or pipeline_type_list_contains_closure(ty_f3(ty))
      18 -> pipeline_ty_contains_closure(ty_unique_inner(ty))
      19 -> pipeline_ty_contains_closure(ty_owned_inner(ty))
      _ -> false
    }
  }
}

fn pipeline_ty_needs_rc_runtime(ty: i64) -> bool {
  ty_is_array(ty) or pipeline_ty_contains_rc(ty) or pipeline_ty_contains_closure(ty) or pipeline_ty_contains_weak(ty)
}

fn pipeline_type_expr_list_contains_rc_typed(types: TypeExprList) -> bool {
  match types {
    TypeExprListNil -> false
    TypeExprListCons(ty, rest) -> pipeline_type_expr_contains_rc_typed(ty) or pipeline_type_expr_list_contains_rc_typed(rest)
  }
}

fn pipeline_type_expr_list_contains_weak_typed(types: TypeExprList) -> bool {
  match types {
    TypeExprListNil -> false
    TypeExprListCons(ty, rest) -> pipeline_type_expr_contains_weak_typed(ty) or pipeline_type_expr_list_contains_weak_typed(rest)
  }
}

fn pipeline_type_expr_list_contains_closure_typed(types: TypeExprList) -> bool {
  match types {
    TypeExprListNil -> false
    TypeExprListCons(ty, rest) -> pipeline_type_expr_contains_closure_typed(ty) or pipeline_type_expr_list_contains_closure_typed(rest)
  }
}

fn pipeline_type_expr_contains_rc_typed(ty: TypeExpr) -> bool {
  match ty {
    MissingTypeExpr -> false
    TypeExpr(tag, payload, children) -> {
      if tag == 9 and payload == ty_rc_hash() { true }
      else { pipeline_type_expr_list_contains_rc_typed(children) }
    }
  }
}

fn pipeline_type_expr_contains_weak_typed(ty: TypeExpr) -> bool {
  match ty {
    MissingTypeExpr -> false
    TypeExpr(tag, payload, children) -> {
      if tag == 16 { true }
      else { pipeline_type_expr_list_contains_weak_typed(children) }
    }
  }
}

fn pipeline_type_expr_contains_closure_typed(ty: TypeExpr) -> bool {
  match ty {
    MissingTypeExpr -> false
    TypeExpr(tag, payload, children) -> {
      if tag == 6 { true }
      else { pipeline_type_expr_list_contains_closure_typed(children) }
    }
  }
}

fn pipeline_type_expr_needs_rc_runtime(ty: TypeExpr) -> bool {
  type_expr_tag_or(ty, 0 - 1) == 22 or
  pipeline_type_expr_contains_rc_typed(ty) or
  pipeline_type_expr_contains_closure_typed(ty) or
  pipeline_type_expr_contains_weak_typed(ty)
}

fn pipeline_type_expr_list_needs_rc_runtime_typed(types: TypeExprList) -> bool {
  match types {
    TypeExprListNil -> false
    TypeExprListCons(ty, rest) -> pipeline_type_expr_needs_rc_runtime(ty) or pipeline_type_expr_list_needs_rc_runtime_typed(rest)
  }
}

fn pipeline_params_contain_rc(params: i64) -> i64 {
  let mut found = 0
  let n = if params == 0 { 0 } else { nlist_len(params) }
  let mut i = 0
  while i < n {
    if pipeline_ty_contains_rc(node_f3(nlist_get(params, i))) {
      found = 1
      i = n
    } else { i = i + 1 }
  }
  found
}

fn pipeline_params_need_rc_runtime(params: i64) -> bool {
  let mut found = false
  let n = if params == 0 { 0 } else { nlist_len(params) }
  let mut i = 0
  while i < n {
    if pipeline_ty_needs_rc_runtime(node_f3(nlist_get(params, i))) {
      found = 1
      i = n
    } else { i = i + 1 }
  }
  found
}

fn pipeline_hash_list_contains(list: i64, hash: i64) -> bool {
  let mut found = false
  let n = if list == 0 { 0 } else { nlist_len(list) }
  let mut i = 0
  while i < n {
    if nlist_get(list, i) == hash {
      found = 1
      i = n
    } else { i = i + 1 }
  }
  found
}

fn pipeline_fn_name_hashes(fns: i64) -> i64 {
  let hashes = nlist_new()
  let mut i = 0
  while i < nlist_len(fns) {
    let pair = nlist_get(fns, i)
    let fn_src = node_f2(pair)
    let fn_wrap = node_f1(pair)
    if pipeline_decl_node_is_function(fn_wrap) == 1 {
      let inner = pipeline_fn_inner(fn_wrap)
      nlist_add(hashes, str_hash(fn_src, node_f1(inner), node_f2(inner)))
    } else { 0 }
    i = i + 1
  }
  hashes
}

-- Exact producer for the named-function ownership ABI. A bare resolved
-- function identifier creates IrFunctionRefI64; direct Call names do not.
-- Record every such target before lowering any body, with the same lexical
-- shadowing rules as identifier lowering, so caller and callee can agree
-- that address-taken entries use the indirect all-owned convention.
fn pipeline_function_value_hash_add(result: i64, hash: i64) -> i64 {
  if pipeline_hash_list_contains(result, hash) { 0 } else { nlist_add(result, hash) }
}

fn pipeline_function_value_local_push(locals: i64, src: i64, ns: i64, nl: i64) -> i64 {
  nlist_add(locals, str_hash(src, ns, nl))
}

fn pipeline_function_value_params_push(params: i64, src: i64, locals: i64) -> i64 {
  let n = if params == 0 { 0 } else { nlist_len(params) }
  let mut i = 0
  while i < n {
    let param = nlist_get(params, i)
    pipeline_function_value_local_push(locals, src, node_f1(param), node_f2(param))
    i = i + 1
  }
  0
}

fn pipeline_pattern_push_function_value_locals(pattern: i64, src: i64, locals: i64) -> i64 {
  if pattern == 0 { 0 }
  else {
    match node_tag(pattern) {
      18 -> pipeline_function_value_local_push(locals, src, node_f1(pattern), node_f2(pattern))
      20 -> {
        let raw = node_f3(pattern)
        let count = node_f4(pattern)
        if count > 0 {
          pipeline_function_value_local_push(locals, src, raw, count)
        } else { if count < 0 and raw != 0 {
          let mut i = 0
          while i < 0 - count {
            pipeline_pattern_push_function_value_locals(nlist_get(raw, i), src, locals)
            i = i + 1
          }
          0
        } else { 0 } }
      }
      _ -> 0
    }
  }
}

fn pipeline_expr_list_collect_function_value_hashes(args: i64, count: i64, src: i64, fnindex: i64, locals: i64, result: i64) -> i64 {
  let mut i = 0
  while i < count {
    pipeline_expr_collect_function_value_hashes(nlist_get(args, i), src, fnindex, locals, result)
    i = i + 1
  }
  0
}

fn pipeline_record_fields_collect_function_value_hashes(fields: i64, count: i64, src: i64, fnindex: i64, locals: i64, result: i64) -> i64 {
  let mut i = 0
  while i < count {
    pipeline_expr_collect_function_value_hashes(node_f3(nlist_get(fields, i)), src, fnindex, locals, result)
    i = i + 1
  }
  0
}

fn pipeline_match_arms_collect_function_value_hashes(arms: i64, count: i64, src: i64, fnindex: i64, locals: i64, result: i64) -> i64 {
  let mut i = 0
  while i < count {
    let arm = nlist_get(arms, i)
    let depth = nlist_len(locals)
    pipeline_pattern_push_function_value_locals(node_f1(arm), src, locals)
    pipeline_expr_collect_function_value_hashes(node_f2(arm), src, fnindex, locals, result)
    pipeline_expr_collect_function_value_hashes(node_f3(arm), src, fnindex, locals, result)
    nlist_set_len(locals, depth)
    i = i + 1
  }
  0
}

fn pipeline_handler_clauses_collect_function_value_hashes(clauses: i64, count: i64, src: i64, fnindex: i64, locals: i64, result: i64) -> i64 {
  let mut i = 0
  while i < count {
    let clause = nlist_get(clauses, i)
    let depth = nlist_len(locals)
    pipeline_function_value_params_push(node_f2(clause), src, locals)
    let continuation = node_f4(clause)
    if continuation != 0 {
      pipeline_function_value_local_push(locals, src, node_f1(continuation), node_f2(continuation))
    } else { 0 }
    pipeline_expr_collect_function_value_hashes(node_f3(clause), src, fnindex, locals, result)
    nlist_set_len(locals, depth)
    i = i + 1
  }
  0
}

fn pipeline_expr_collect_function_value_hashes(node: i64, src: i64, fnindex: i64, locals: i64, result: i64) -> i64 {
  if node == 0 { 0 }
  else {
    match node_tag(node) {
      2 -> {
        let hash = str_hash(src, node_f1(node), node_f2(node))
        let pair = pipeline_fns_index_probe(fnindex, hash)
        if pair != 0 and fn_tparams(node_f1(pair)) == 0 and not pipeline_hash_list_contains(locals, hash) {
          pipeline_function_value_hash_add(result, hash)
        } else { 0 }
      }
      3 -> {
        pipeline_expr_collect_function_value_hashes(node_f2(node), src, fnindex, locals, result)
        pipeline_expr_collect_function_value_hashes(node_f3(node), src, fnindex, locals, result)
      }
      4 -> pipeline_expr_list_collect_function_value_hashes(node_f3(node), node_f4(node), src, fnindex, locals, result)
      5 -> {
        pipeline_expr_collect_function_value_hashes(node_f1(node), src, fnindex, locals, result)
        pipeline_expr_collect_function_value_hashes(node_f2(node), src, fnindex, locals, result)
        pipeline_expr_collect_function_value_hashes(node_f3(node), src, fnindex, locals, result)
      }
      6 -> {
        pipeline_expr_collect_function_value_hashes(node_f3(node), src, fnindex, locals, result)
        let depth = nlist_len(locals)
        pipeline_function_value_local_push(locals, src, node_f1(node), node_f2(node))
        pipeline_expr_collect_function_value_hashes(node_f4(node), src, fnindex, locals, result)
        nlist_set_len(locals, depth)
      }
      7 -> {
        pipeline_expr_collect_function_value_hashes(node_f1(node), src, fnindex, locals, result)
        pipeline_expr_collect_function_value_hashes(node_f2(node), src, fnindex, locals, result)
      }
      10 -> {
        pipeline_expr_collect_function_value_hashes(node_f1(node), src, fnindex, locals, result)
        pipeline_expr_collect_function_value_hashes(node_f2(node), src, fnindex, locals, result)
      }
      11 -> {
        pipeline_expr_collect_function_value_hashes(node_f3(node), src, fnindex, locals, result)
        let depth = nlist_len(locals)
        pipeline_function_value_local_push(locals, src, node_f1(node), node_f2(node))
        pipeline_expr_collect_function_value_hashes(node_f4(node), src, fnindex, locals, result)
        nlist_set_len(locals, depth)
      }
      12 -> pipeline_expr_collect_function_value_hashes(node_f3(node), src, fnindex, locals, result)
      13 -> pipeline_expr_collect_function_value_hashes(node_f1(node), src, fnindex, locals, result)
      59 -> pipeline_expr_collect_function_value_hashes(node_f1(node), src, fnindex, locals, result)
      60 -> { pipeline_expr_collect_function_value_hashes(node_f1(node), src, fnindex, locals, result) pipeline_expr_collect_function_value_hashes(node_f2(node), src, fnindex, locals, result) }
      61 -> { pipeline_expr_collect_function_value_hashes(node_f1(node), src, fnindex, locals, result) pipeline_expr_collect_function_value_hashes(node_f2(node), src, fnindex, locals, result) pipeline_expr_collect_function_value_hashes(node_f3(node), src, fnindex, locals, result) }
      62 -> { pipeline_expr_collect_function_value_hashes(node_f1(node), src, fnindex, locals, result) pipeline_expr_collect_function_value_hashes(node_f2(node), src, fnindex, locals, result) pipeline_expr_collect_function_value_hashes(node_f3(node), src, fnindex, locals, result) }
      14 -> pipeline_record_fields_collect_function_value_hashes(node_f3(node), node_f4(node), src, fnindex, locals, result)
      58 -> pipeline_expr_list_collect_function_value_hashes(node_f1(node), node_f2(node), src, fnindex, locals, result)
      15 -> {
        pipeline_expr_collect_function_value_hashes(node_f1(node), src, fnindex, locals, result)
        pipeline_match_arms_collect_function_value_hashes(node_f2(node), node_f3(node), src, fnindex, locals, result)
      }
      22 -> pipeline_expr_collect_function_value_hashes(node_f1(node), src, fnindex, locals, result)
      25 -> pipeline_expr_collect_function_value_hashes(node_f1(node), src, fnindex, locals, result)
      26 -> pipeline_expr_collect_function_value_hashes(node_f1(node), src, fnindex, locals, result)
      29 -> {
        let depth = nlist_len(locals)
        pipeline_function_value_params_push(node_f1(node), src, locals)
        pipeline_expr_collect_function_value_hashes(node_f2(node), src, fnindex, locals, result)
        nlist_set_len(locals, depth)
      }
      32 -> pipeline_expr_list_collect_function_value_hashes(node_f4(node), if node_f4(node) == 0 { 0 } else { nlist_len(node_f4(node)) }, src, fnindex, locals, result)
      33 -> {
        pipeline_expr_collect_function_value_hashes(node_f1(node), src, fnindex, locals, result)
        pipeline_handler_clauses_collect_function_value_hashes(node_f2(node), node_f3(node), src, fnindex, locals, result)
      }
      35 -> pipeline_expr_collect_function_value_hashes(node_f1(node), src, fnindex, locals, result)
      36 -> pipeline_expr_collect_function_value_hashes(node_f2(node), src, fnindex, locals, result)
      37 -> pipeline_expr_collect_function_value_hashes(node_f1(node), src, fnindex, locals, result)
      41 -> {
        pipeline_expr_collect_function_value_hashes(node_f1(node), src, fnindex, locals, result)
        pipeline_expr_list_collect_function_value_hashes(node_f3(node), if node_f3(node) == 0 { 0 } else { nlist_len(node_f3(node)) }, src, fnindex, locals, result)
      }
      45 -> pipeline_expr_collect_function_value_hashes(node_f1(node), src, fnindex, locals, result)
      46 -> {
        pipeline_expr_collect_function_value_hashes(node_f1(node), src, fnindex, locals, result)
        pipeline_expr_collect_function_value_hashes(node_f2(node), src, fnindex, locals, result)
      }
      47 -> {
        pipeline_expr_collect_function_value_hashes(node_f3(node), src, fnindex, locals, result)
        let depth = nlist_len(locals)
        pipeline_function_value_local_push(locals, src, node_f1(node), node_f2(node))
        pipeline_expr_collect_function_value_hashes(node_f4(node), src, fnindex, locals, result)
        nlist_set_len(locals, depth)
      }
      48 -> pipeline_expr_collect_function_value_hashes(node_f1(node), src, fnindex, locals, result)
      49 -> pipeline_expr_collect_function_value_hashes(node_f1(node), src, fnindex, locals, result)
      52 -> {
        pipeline_expr_collect_function_value_hashes(node_f1(node), src, fnindex, locals, result)
        pipeline_expr_collect_function_value_hashes(node_f2(node), src, fnindex, locals, result)
      }
      55 -> pipeline_expr_collect_function_value_hashes(node_f2(node), src, fnindex, locals, result)
      56 -> pipeline_expr_collect_function_value_hashes(node_f1(node), src, fnindex, locals, result)
      57 -> {
        pipeline_expr_collect_function_value_hashes(node_f1(node), src, fnindex, locals, result)
        pipeline_expr_collect_function_value_hashes(node_f2(node), src, fnindex, locals, result)
      }
      _ -> 0
    }
  }
}

fn pipeline_fns_collect_function_value_hashes(fns: i64, fnindex: i64) -> i64 {
  let result = nlist_new()
  let n = nlist_len(fns)
  let mut i = 0
  while i < n {
    let pair = nlist_get(fns, i)
    let decl = node_f1(pair)
    let src = node_f2(pair)
    if pipeline_decl_node_is_function(decl) == 1 {
      let inner = pipeline_fn_inner(decl)
      let locals = nlist_new()
      pipeline_function_value_params_push(node_f3(inner), src, locals)
      pipeline_expr_collect_function_value_hashes(node_f4(inner), src, fnindex, locals, result)
    } else { if pipeline_decl_node_is_test(decl) == 1 {
      pipeline_expr_collect_function_value_hashes(node_f3(decl), src, fnindex, nlist_new(), result)
    } else { 0 } }
    i = i + 1
  }
  result
}

fn pipeline_param_list_needs_rc_runtime_typed(params: ParamList) -> bool {
  match params {
    ParamListNil -> false
    ParamListCons(param, rest) -> {
      match param {
        Param(ns, nl, ty, label) -> pipeline_type_expr_needs_rc_runtime(ty) or pipeline_param_list_needs_rc_runtime_typed(rest)
        UnknownParam(tag) -> pipeline_param_list_needs_rc_runtime_typed(rest)
      }
    }
  }
}

fn pipeline_effect_op_needs_rc_runtime(op: TypeEffectOp) -> bool {
  pipeline_param_list_needs_rc_runtime_typed(type_effect_op_params(op)) or
  pipeline_type_expr_needs_rc_runtime(type_effect_op_return_type(op))
}

fn pipeline_effect_op_list_needs_rc_runtime(ops: TypeEffectOpList) -> bool {
  match ops {
    TypeEffectOpListNil -> false
    TypeEffectOpListCons(op, rest) -> pipeline_effect_op_needs_rc_runtime(op) or pipeline_effect_op_list_needs_rc_runtime(rest)
  }
}

fn pipeline_decl_type_surface_needs_rc_runtime(decl: Decl) -> i64 {
  match decl {
    EffectDecl(ns, nl, ops) -> pipeline_effect_op_list_needs_rc_runtime(ops)
    _ -> false
  }
}

fn pipeline_locals_add_name(locals: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let next = nlist_new()
  let mut i = 0
  while i < nlist_len(locals) {
    nlist_add(next, nlist_get(locals, i))
    i = i + 1
  }
  nlist_add(next, str_hash(src, ns, nl))
  next
}

fn pipeline_params_add_locals(params: i64, src: i64, locals: i64) -> i64 {
  let mut result = locals
  if params == 0 { result }
  else {
    let mut i = 0
    while i < nlist_len(params) {
      let p = nlist_get(params, i)
      result = pipeline_locals_add_name(result, src, node_f1(p), node_f2(p))
      i = i + 1
    }
    result
  }
}

fn pipeline_expr_list_uses_function_value(args: i64, nargs: i64, src: i64, fnhashes: i64, locals: i64) -> bool {
  let mut found = false
  let mut i = 0
  while i < nargs {
    if pipeline_expr_uses_function_value(nlist_get(args, i), src, fnhashes, locals) {
      found = true
      i = nargs
    } else { i = i + 1 }
  }
  found
}

fn pipeline_record_fields_use_function_value(fields: i64, nfields: i64, src: i64, fnhashes: i64, locals: i64) -> bool {
  let mut found = false
  let mut i = 0
  while i < nfields {
    let field = nlist_get(fields, i)
    if pipeline_expr_uses_function_value(node_f3(field), src, fnhashes, locals) {
      found = true
      i = nfields
    } else { i = i + 1 }
  }
  found
}

fn pipeline_match_arms_use_function_value(arms: i64, narms: i64, src: i64, fnhashes: i64, locals: i64) -> bool {
  let mut found = false
  let mut i = 0
  while i < narms {
    let arm = nlist_get(arms, i)
    if pipeline_expr_uses_function_value(node_f2(arm), src, fnhashes, locals) {
      found = true
      i = narms
    } else {
      if pipeline_expr_uses_function_value(node_f3(arm), src, fnhashes, locals) {
        found = true
        i = narms
      } else { i = i + 1 }
    }
  }
  found
}

fn pipeline_handle_clauses_use_function_value(clauses: i64, nclauses: i64, src: i64, fnhashes: i64, locals: i64) -> bool {
  let mut found = false
  let mut i = 0
  while i < nclauses {
    let clause = nlist_get(clauses, i)
    let clause_locals = pipeline_params_add_locals(node_f2(clause), src, locals)
    if pipeline_expr_uses_function_value(node_f3(clause), src, fnhashes, clause_locals) {
      found = true
      i = nclauses
    } else { i = i + 1 }
  }
  found
}

fn pipeline_expr_uses_function_value(node: i64, src: i64, fnhashes: i64, locals: i64) -> bool {
  if node == 0 { false }
  else {
    match node_tag(node) {
      2 -> {
        let h = str_hash(src, node_f1(node), node_f2(node))
        pipeline_hash_list_contains(fnhashes, h) and not pipeline_hash_list_contains(locals, h)
      }
      3 -> pipeline_expr_uses_function_value(node_f2(node), src, fnhashes, locals) or pipeline_expr_uses_function_value(node_f3(node), src, fnhashes, locals)
      4 -> pipeline_expr_list_uses_function_value(node_f3(node), node_f4(node), src, fnhashes, locals)
      5 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals) or pipeline_expr_uses_function_value(node_f2(node), src, fnhashes, locals) or pipeline_expr_uses_function_value(node_f3(node), src, fnhashes, locals)
      6 -> {
        if pipeline_expr_uses_function_value(node_f3(node), src, fnhashes, locals) { true }
        else {
          let next_locals = pipeline_locals_add_name(locals, src, node_f1(node), node_f2(node))
          pipeline_expr_uses_function_value(node_f4(node), src, fnhashes, next_locals)
        }
      }
      7 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals) or pipeline_expr_uses_function_value(node_f2(node), src, fnhashes, locals)
      10 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals) or pipeline_expr_uses_function_value(node_f2(node), src, fnhashes, locals)
      11 -> {
        if pipeline_expr_uses_function_value(node_f3(node), src, fnhashes, locals) { true }
        else {
          let next_locals = pipeline_locals_add_name(locals, src, node_f1(node), node_f2(node))
          pipeline_expr_uses_function_value(node_f4(node), src, fnhashes, next_locals)
        }
      }
      12 -> pipeline_expr_uses_function_value(node_f3(node), src, fnhashes, locals)
      13 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals)
      59 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals)
      60 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals) or pipeline_expr_uses_function_value(node_f2(node), src, fnhashes, locals)
      61 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals) or pipeline_expr_uses_function_value(node_f2(node), src, fnhashes, locals) or pipeline_expr_uses_function_value(node_f3(node), src, fnhashes, locals)
      62 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals) or pipeline_expr_uses_function_value(node_f2(node), src, fnhashes, locals) or pipeline_expr_uses_function_value(node_f3(node), src, fnhashes, locals)
      14 -> pipeline_record_fields_use_function_value(node_f3(node), node_f4(node), src, fnhashes, locals)
      58 -> pipeline_expr_list_uses_function_value(node_f1(node), node_f2(node), src, fnhashes, locals)
      15 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals) or pipeline_match_arms_use_function_value(node_f2(node), node_f3(node), src, fnhashes, locals)
      22 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals)
      25 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals)
      26 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals)
      29 -> {
        let lambda_locals = pipeline_params_add_locals(node_f1(node), src, locals)
        pipeline_expr_uses_function_value(node_f2(node), src, fnhashes, lambda_locals)
      }
      32 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals) or pipeline_expr_list_uses_function_value(node_f4(node), nlist_len(node_f4(node)), src, fnhashes, locals)
      33 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals) or pipeline_handle_clauses_use_function_value(node_f2(node), node_f3(node), src, fnhashes, locals)
      35 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals)
      36 -> pipeline_expr_uses_function_value(node_f2(node), src, fnhashes, locals)
      37 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals)
      41 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals) or pipeline_expr_list_uses_function_value(node_f3(node), nlist_len(node_f3(node)), src, fnhashes, locals)
      45 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals)
      46 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals) or pipeline_expr_uses_function_value(node_f2(node), src, fnhashes, locals)
      47 -> pipeline_expr_uses_function_value(node_f3(node), src, fnhashes, locals) or pipeline_expr_uses_function_value(node_f4(node), src, fnhashes, locals)
      48 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals)
      49 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals)
      52 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals) or pipeline_expr_uses_function_value(node_f2(node), src, fnhashes, locals)
      _ -> false
    }
  }
}

fn pipeline_param_list_add_locals_typed(params: ParamList, src: i64, locals: i64) -> i64 {
  match params {
    ParamListNil -> locals
    ParamListCons(param, rest) -> {
      let next = match param {
        Param(ns, nl, ty, label) -> pipeline_locals_add_name(locals, src, ns, nl)
        UnknownParam(tag) -> locals
      }
      pipeline_param_list_add_locals_typed(rest, src, next)
    }
  }
}

fn pipeline_expr_list_uses_function_value_typed(args: ExprList, src: i64, fnhashes: i64, locals: i64) -> bool {
  match args {
    ExprListNil -> false
    ExprListCons(expr, rest) -> pipeline_expr_uses_function_value_typed(expr, src, fnhashes, locals) or pipeline_expr_list_uses_function_value_typed(rest, src, fnhashes, locals)
  }
}

fn pipeline_record_fields_use_function_value_typed(fields: RecordFieldList, src: i64, fnhashes: i64, locals: i64) -> bool {
  match fields {
    RecordFieldListNil -> false
    RecordFieldListCons(field, rest) -> {
      match field {
        RecordField(ns, nl, value, fact) -> pipeline_expr_uses_function_value_typed(value, src, fnhashes, locals) or pipeline_record_fields_use_function_value_typed(rest, src, fnhashes, locals)
        UnknownRecordField(tag) -> pipeline_record_fields_use_function_value_typed(rest, src, fnhashes, locals)
      }
    }
  }
}

fn pipeline_match_arms_use_function_value_typed(arms: MatchArmList, src: i64, fnhashes: i64, locals: i64) -> bool {
  match arms {
    MatchArmListNil -> false
    MatchArmListCons(arm, rest) -> {
      match arm {
        Arm(pattern, body, guard, has_guard) -> {
          pipeline_expr_uses_function_value_typed(body, src, fnhashes, locals) or
          (if has_guard == 1 { pipeline_expr_uses_function_value_typed(guard, src, fnhashes, locals) } else { false }) or
          pipeline_match_arms_use_function_value_typed(rest, src, fnhashes, locals)
        }
        UnknownArm(tag) -> pipeline_match_arms_use_function_value_typed(rest, src, fnhashes, locals)
      }
    }
  }
}

fn pipeline_handle_clauses_use_function_value_typed(clauses: HandlerClauseList, src: i64, fnhashes: i64, locals: i64) -> bool {
  match clauses {
    HandlerClauseListNil -> false
    HandlerClauseListCons(clause, rest) -> {
      match clause {
        HandlerClause(name_info, params, body, continuation) -> {
          let clause_locals = pipeline_param_list_add_locals_typed(params, src, locals)
          pipeline_expr_uses_function_value_typed(body, src, fnhashes, clause_locals) or
          pipeline_handle_clauses_use_function_value_typed(rest, src, fnhashes, locals)
        }
        UnknownHandlerClause(tag) -> pipeline_handle_clauses_use_function_value_typed(rest, src, fnhashes, locals)
      }
    }
  }
}

fn pipeline_expr_uses_function_value_typed(expr: Expr, src: i64, fnhashes: i64, locals: i64) -> bool {
  match expr {
    Ident(ns, nl) -> {
      let h = str_hash(src, ns, nl)
      pipeline_hash_list_contains(fnhashes, h) and not pipeline_hash_list_contains(locals, h)
    }
    BinOp(op, lhs, rhs) -> pipeline_expr_uses_function_value_typed(lhs, src, fnhashes, locals) or pipeline_expr_uses_function_value_typed(rhs, src, fnhashes, locals)
    Call(ns, nl, args) -> pipeline_expr_list_uses_function_value_typed(args, src, fnhashes, locals)
    GenericCall(type_args, inner_call) -> pipeline_expr_uses_function_value_typed(inner_call, src, fnhashes, locals)
    If(cond, then_expr, else_expr) -> pipeline_expr_uses_function_value_typed(cond, src, fnhashes, locals) or pipeline_expr_uses_function_value_typed(then_expr, src, fnhashes, locals) or pipeline_expr_uses_function_value_typed(else_expr, src, fnhashes, locals)
    While(cond, body) -> pipeline_expr_uses_function_value_typed(cond, src, fnhashes, locals) or pipeline_expr_uses_function_value_typed(body, src, fnhashes, locals)
    Loop(body) -> pipeline_expr_uses_function_value_typed(body, src, fnhashes, locals)
    Break(value) -> pipeline_expr_uses_function_value_typed(value, src, fnhashes, locals)
    Return(value) -> pipeline_expr_uses_function_value_typed(value, src, fnhashes, locals)
    Defer(cleanup, body) -> pipeline_expr_uses_function_value_typed(cleanup, src, fnhashes, locals) or pipeline_expr_uses_function_value_typed(body, src, fnhashes, locals)
    Let(ns, nl, value, body) -> {
      if pipeline_expr_uses_function_value_typed(value, src, fnhashes, locals) { true }
      else {
        let next_locals = pipeline_locals_add_name(locals, src, ns, nl)
        pipeline_expr_uses_function_value_typed(body, src, fnhashes, next_locals)
      }
    }
    LetMut(ns, nl, value, body) -> {
      if pipeline_expr_uses_function_value_typed(value, src, fnhashes, locals) { true }
      else {
        let next_locals = pipeline_locals_add_name(locals, src, ns, nl)
        pipeline_expr_uses_function_value_typed(body, src, fnhashes, next_locals)
      }
    }
    Assign(ns, nl, value) -> pipeline_expr_uses_function_value_typed(value, src, fnhashes, locals)
    AddressOf(mutable, target) -> pipeline_expr_uses_function_value_typed(target, src, fnhashes, locals)
    Deref(ptr) -> pipeline_expr_uses_function_value_typed(ptr, src, fnhashes, locals)
    PtrAssign(ptr, value) -> pipeline_expr_uses_function_value_typed(ptr, src, fnhashes, locals) or pipeline_expr_uses_function_value_typed(value, src, fnhashes, locals)
    Block(first, rest) -> pipeline_expr_uses_function_value_typed(first, src, fnhashes, locals) or pipeline_expr_uses_function_value_typed(rest, src, fnhashes, locals)
    FieldAccess(base, field_ns, field_nl, fact) -> pipeline_expr_uses_function_value_typed(base, src, fnhashes, locals)
    IndexedLen(base, fixed_len) -> pipeline_expr_uses_function_value_typed(base, src, fnhashes, locals)
    IndexedGet(base, index, element_ty, fixed_len) -> pipeline_expr_uses_function_value_typed(base, src, fnhashes, locals) or pipeline_expr_uses_function_value_typed(index, src, fnhashes, locals)
    IndexedSet(base, index, value, fact) -> pipeline_expr_uses_function_value_typed(base, src, fnhashes, locals) or pipeline_expr_uses_function_value_typed(index, src, fnhashes, locals) or pipeline_expr_uses_function_value_typed(value, src, fnhashes, locals)
    IndexedSlice(base, start, end, fact) -> pipeline_expr_uses_function_value_typed(base, src, fnhashes, locals) or pipeline_expr_uses_function_value_typed(start, src, fnhashes, locals) or pipeline_expr_uses_function_value_typed(end, src, fnhashes, locals)
    RecordInit(type_ns, type_nl, fields) -> pipeline_record_fields_use_function_value_typed(fields, src, fnhashes, locals)
    ArrayLiteral(elements, resolved_ty, span) -> pipeline_expr_list_uses_function_value_typed(elements, src, fnhashes, locals)
    Match(scrutinee, arms) -> pipeline_expr_uses_function_value_typed(scrutinee, src, fnhashes, locals) or pipeline_match_arms_use_function_value_typed(arms, src, fnhashes, locals)
    Not(operand) -> pipeline_expr_uses_function_value_typed(operand, src, fnhashes, locals)
    Lambda(params, body) -> {
      let lambda_locals = pipeline_param_list_add_locals_typed(params, src, locals)
      pipeline_expr_uses_function_value_typed(body, src, fnhashes, lambda_locals)
    }
    Perform(lhs, op_ns, op_nl, args) -> pipeline_expr_uses_function_value_typed(lhs, src, fnhashes, locals) or pipeline_expr_list_uses_function_value_typed(args, src, fnhashes, locals)
    Handle(body, clauses, hret) -> pipeline_expr_uses_function_value_typed(body, src, fnhashes, locals) or pipeline_handle_clauses_use_function_value_typed(clauses, src, fnhashes, locals) or (match hret { NoHandleReturn -> false HandleReturnClause(rns, rnl, rb) -> pipeline_expr_uses_function_value_typed(rb, src, fnhashes, locals) })
    Resume(value) -> pipeline_expr_uses_function_value_typed(value, src, fnhashes, locals)
    MethodCall(recv, method_hash, args, type_hash) -> pipeline_expr_uses_function_value_typed(recv, src, fnhashes, locals) or pipeline_expr_list_uses_function_value_typed(args, src, fnhashes, locals)
    Try(inner, effect_atom) -> pipeline_expr_uses_function_value_typed(inner, src, fnhashes, locals)
    InterpConcat(left, right) -> pipeline_expr_uses_function_value_typed(left, src, fnhashes, locals) or pipeline_expr_uses_function_value_typed(right, src, fnhashes, locals)
    ForIter(var_ns, var_nl, collection, body) -> pipeline_expr_uses_function_value_typed(collection, src, fnhashes, locals) or pipeline_expr_uses_function_value_typed(body, src, fnhashes, locals)
    OptChain(base, field_ns, field_nl, effect_atom) -> pipeline_expr_uses_function_value_typed(base, src, fnhashes, locals)
    LetTyped(inner, ann_type) -> pipeline_expr_uses_function_value_typed(inner, src, fnhashes, locals)
    _ -> false
  }
}

fn pipeline_rc_runtime_name(src: i64, ns: i64, nl: i64) -> bool {
  src_eq(src, ns, nl, "rc_default_alloc") == 1 or
  src_eq(src, ns, nl, "rc_default_retain") == 1 or
  src_eq(src, ns, nl, "rc_default_release") == 1 or
  src_eq(src, ns, nl, "rc_default_weak_retain") == 1 or
  src_eq(src, ns, nl, "rc_default_weak_release") == 1 or
  src_eq(src, ns, nl, "rc_default_weak_load") == 1 or
  src_eq(src, ns, nl, "rc_default_promote") == 1 or
  src_eq(src, ns, nl, "rc_is_promoted") == 1 or
  src_eq(src, ns, nl, "weak_ref") == 1 or
  src_eq(src, ns, nl, "weak_load") == 1 or
  src_eq(src, ns, nl, "closure_default_retain") == 1 or
  src_eq(src, ns, nl, "closure_default_release") == 1 or
  src_eq(src, ns, nl, "closure_default_promote") == 1 or
  src_eq(src, ns, nl, "rc_count") == 1
}

fn pipeline_expr_list_needs_rc_runtime(args: i64, nargs: i64, src: i64) -> bool {
  let mut found = false
  let mut i = 0
  while i < nargs {
    if pipeline_expr_needs_rc_runtime(nlist_get(args, i), src) {
      found = true
      i = nargs
    } else { i = i + 1 }
  }
  found
}

fn pipeline_record_fields_need_rc_runtime(fields: i64, nfields: i64, src: i64) -> bool {
  let mut found = false
  let mut i = 0
  while i < nfields {
    let field = nlist_get(fields, i)
    if pipeline_expr_needs_rc_runtime(node_f3(field), src) {
      found = true
      i = nfields
    } else { i = i + 1 }
  }
  found
}

fn pipeline_match_arms_need_rc_runtime(arms: i64, narms: i64, src: i64) -> bool {
  let mut found = false
  let mut i = 0
  while i < narms {
    let arm = nlist_get(arms, i)
    if pipeline_expr_needs_rc_runtime(node_f2(arm), src) {
      found = true
      i = narms
    } else {
      if pipeline_expr_needs_rc_runtime(node_f3(arm), src) {
        found = true
        i = narms
      } else { i = i + 1 }
    }
  }
  found
}

fn pipeline_handle_clauses_need_rc_runtime(clauses: i64, nclauses: i64, src: i64) -> i64 {
  let mut found = false
  let mut i = 0
  while i < nclauses {
    let clause = nlist_get(clauses, i)
    if pipeline_params_need_rc_runtime(node_f2(clause)) {
      found = true
      i = nclauses
    } else {
      if pipeline_expr_needs_rc_runtime(node_f3(clause), src) {
        found = true
        i = nclauses
      } else { i = i + 1 }
    }
  }
  found
}

fn pipeline_expr_needs_rc_runtime(node: i64, src: i64) -> bool {
  if node == 0 { false }
  else {
    match node_tag(node) {
      3 -> pipeline_expr_needs_rc_runtime(node_f2(node), src) or pipeline_expr_needs_rc_runtime(node_f3(node), src)
      4 -> pipeline_rc_runtime_name(src, node_f1(node), node_f2(node)) or pipeline_expr_list_needs_rc_runtime(node_f3(node), node_f4(node), src)
      5 -> pipeline_expr_needs_rc_runtime(node_f1(node), src) or pipeline_expr_needs_rc_runtime(node_f2(node), src) or pipeline_expr_needs_rc_runtime(node_f3(node), src)
      6 -> pipeline_expr_needs_rc_runtime(node_f3(node), src) or pipeline_expr_needs_rc_runtime(node_f4(node), src)
      7 -> pipeline_expr_needs_rc_runtime(node_f1(node), src) or pipeline_expr_needs_rc_runtime(node_f2(node), src)
      10 -> pipeline_expr_needs_rc_runtime(node_f1(node), src) or pipeline_expr_needs_rc_runtime(node_f2(node), src)
      11 -> pipeline_expr_needs_rc_runtime(node_f3(node), src) or pipeline_expr_needs_rc_runtime(node_f4(node), src)
      12 -> pipeline_expr_needs_rc_runtime(node_f3(node), src)
      -- A described fixed-array field projection allocates managed backing.
      -- Keep this syntax-level producer conservative until field-resolution
      -- facts are available in the runtime-selection pass.
      13 -> true
      59 -> pipeline_expr_needs_rc_runtime(node_f1(node), src)
      60 -> true
      61 -> true
      62 -> true
      14 -> pipeline_record_fields_need_rc_runtime(node_f3(node), node_f4(node), src)
      58 -> true
      15 -> pipeline_expr_needs_rc_runtime(node_f1(node), src) or pipeline_match_arms_need_rc_runtime(node_f2(node), node_f3(node), src)
      22 -> pipeline_expr_needs_rc_runtime(node_f1(node), src)
      25 -> pipeline_expr_needs_rc_runtime(node_f1(node), src)
      26 -> pipeline_expr_needs_rc_runtime(node_f1(node), src)
      29 -> true
      32 -> pipeline_expr_needs_rc_runtime(node_f1(node), src) or pipeline_expr_list_needs_rc_runtime(node_f4(node), nlist_len(node_f4(node)), src)
      33 -> true
      35 -> pipeline_expr_needs_rc_runtime(node_f1(node), src)
      36 -> pipeline_type_list_contains_rc(node_f1(node)) or pipeline_type_list_contains_closure(node_f1(node)) or pipeline_type_list_contains_weak(node_f1(node)) or pipeline_expr_needs_rc_runtime(node_f2(node), src)
      37 -> pipeline_ty_needs_rc_runtime(node_f2(node)) or pipeline_expr_needs_rc_runtime(node_f1(node), src)
      41 -> pipeline_expr_needs_rc_runtime(node_f1(node), src) or pipeline_expr_list_needs_rc_runtime(node_f3(node), nlist_len(node_f3(node)), src)
      45 -> pipeline_expr_needs_rc_runtime(node_f1(node), src)
      46 -> pipeline_expr_needs_rc_runtime(node_f1(node), src) or pipeline_expr_needs_rc_runtime(node_f2(node), src)
      47 -> pipeline_expr_needs_rc_runtime(node_f3(node), src) or pipeline_expr_needs_rc_runtime(node_f4(node), src)
      48 -> pipeline_expr_needs_rc_runtime(node_f1(node), src)
      49 -> pipeline_expr_needs_rc_runtime(node_f1(node), src)
      52 -> pipeline_expr_needs_rc_runtime(node_f1(node), src) or pipeline_expr_needs_rc_runtime(node_f2(node), src)
      _ -> false
    }
  }
}

fn pipeline_expr_list_needs_rc_runtime_typed(args: ExprList, src: i64, tt: i64) -> bool {
  match args {
    ExprListNil -> false
    ExprListCons(expr, rest) -> pipeline_expr_needs_rc_runtime_typed(expr, src, tt) or pipeline_expr_list_needs_rc_runtime_typed(rest, src, tt)
  }
}

fn pipeline_record_fields_need_rc_runtime_typed(fields: RecordFieldList, src: i64, tt: i64) -> bool {
  match fields {
    RecordFieldListNil -> false
    RecordFieldListCons(field, rest) -> {
      match field {
        RecordField(ns, nl, value, fact) -> pipeline_expr_needs_rc_runtime_typed(value, src, tt) or pipeline_record_fields_need_rc_runtime_typed(rest, src, tt)
        UnknownRecordField(tag) -> pipeline_record_fields_need_rc_runtime_typed(rest, src, tt)
      }
    }
  }
}

fn pipeline_match_arms_need_rc_runtime_typed(arms: MatchArmList, src: i64, tt: i64) -> bool {
  match arms {
    MatchArmListNil -> false
    MatchArmListCons(arm, rest) -> {
      match arm {
        Arm(pattern, body, guard, has_guard) -> {
          pipeline_expr_needs_rc_runtime_typed(body, src, tt) or
          (if has_guard == 1 { pipeline_expr_needs_rc_runtime_typed(guard, src, tt) } else { false }) or
          pipeline_match_arms_need_rc_runtime_typed(rest, src, tt)
        }
        UnknownArm(tag) -> pipeline_match_arms_need_rc_runtime_typed(rest, src, tt)
      }
    }
  }
}

fn pipeline_handle_clauses_need_rc_runtime_typed(clauses: HandlerClauseList, src: i64, tt: i64) -> bool {
  match clauses {
    HandlerClauseListNil -> false
    HandlerClauseListCons(clause, rest) -> {
      match clause {
        HandlerClause(name_info, params, body, continuation) -> {
          pipeline_param_list_needs_rc_runtime_typed(params) or
          pipeline_expr_needs_rc_runtime_typed(body, src, tt) or
          pipeline_handle_clauses_need_rc_runtime_typed(rest, src, tt)
        }
        UnknownHandlerClause(tag) -> pipeline_handle_clauses_need_rc_runtime_typed(rest, src, tt)
      }
    }
  }
}

fn pipeline_expr_needs_rc_runtime_typed(expr: Expr, src: i64, tt: i64) -> bool {
  match expr {
    -- Payload-less ctor Idents are constructions and allocate a headered
    -- node (see pipeline_ident_is_payloadless_ctor) — a program whose
    -- ONLY construction is nullary still needs the rc runtime bound.
    Ident(ns, nl) -> pipeline_ident_is_payloadless_ctor(tt, src, ns, nl) == 1
    BinOp(op, lhs, rhs) -> pipeline_expr_needs_rc_runtime_typed(lhs, src, tt) or pipeline_expr_needs_rc_runtime_typed(rhs, src, tt)
    -- Payload-carrying variant construction allocates a headered rc
    -- node (2q slice 2); payload-less ctors are immediates.
    Call(ns, nl, args) -> pipeline_rc_runtime_name(src, ns, nl) or pipeline_variant_payload_count(tt, src, ns, nl) >= 1 or pipeline_expr_list_needs_rc_runtime_typed(args, src, tt)
    GenericCall(type_args, inner_call) -> pipeline_type_expr_list_needs_rc_runtime_typed(type_args) or pipeline_expr_needs_rc_runtime_typed(inner_call, src, tt)
    If(cond, then_expr, else_expr) -> pipeline_expr_needs_rc_runtime_typed(cond, src, tt) or pipeline_expr_needs_rc_runtime_typed(then_expr, src, tt) or pipeline_expr_needs_rc_runtime_typed(else_expr, src, tt)
    While(cond, body) -> pipeline_expr_needs_rc_runtime_typed(cond, src, tt) or pipeline_expr_needs_rc_runtime_typed(body, src, tt)
    Loop(body) -> pipeline_expr_needs_rc_runtime_typed(body, src, tt)
    Break(value) -> pipeline_expr_needs_rc_runtime_typed(value, src, tt)
    Return(value) -> pipeline_expr_needs_rc_runtime_typed(value, src, tt)
    Defer(cleanup, body) -> pipeline_expr_needs_rc_runtime_typed(cleanup, src, tt) or pipeline_expr_needs_rc_runtime_typed(body, src, tt)
    Let(ns, nl, value, body) -> pipeline_expr_needs_rc_runtime_typed(value, src, tt) or pipeline_expr_needs_rc_runtime_typed(body, src, tt)
    LetMut(ns, nl, value, body) -> pipeline_expr_needs_rc_runtime_typed(value, src, tt) or pipeline_expr_needs_rc_runtime_typed(body, src, tt)
    Assign(ns, nl, value) -> pipeline_expr_needs_rc_runtime_typed(value, src, tt)
    AddressOf(mutable, target) -> pipeline_expr_needs_rc_runtime_typed(target, src, tt)
    Deref(ptr) -> pipeline_expr_needs_rc_runtime_typed(ptr, src, tt)
    PtrAssign(ptr, value) -> pipeline_expr_needs_rc_runtime_typed(ptr, src, tt) or pipeline_expr_needs_rc_runtime_typed(value, src, tt)
    Block(first, rest) -> pipeline_expr_needs_rc_runtime_typed(first, src, tt) or pipeline_expr_needs_rc_runtime_typed(rest, src, tt)
    -- A described fixed-array field projection allocates managed backing.
    -- Runtime selection runs before declaration-aware lowering, so field
    -- access conservatively keeps the RC support reachable.
    FieldAccess(base, field_ns, field_nl, fact) -> true
    IndexedLen(base, fixed_len) -> pipeline_expr_needs_rc_runtime_typed(base, src, tt)
    IndexedGet(base, index, element_ty, fixed_len) -> true
    IndexedSet(base, index, value, fact) -> true
    IndexedSlice(base, start, end, fact) -> true
    -- Record construction allocates a headered rc node (2q slice 2).
    RecordInit(type_ns, type_nl, fields) -> true
    ArrayLiteral(elements, resolved_ty, span) -> true
    Match(scrutinee, arms) -> pipeline_expr_needs_rc_runtime_typed(scrutinee, src, tt) or pipeline_match_arms_need_rc_runtime_typed(arms, src, tt)
    Not(operand) -> pipeline_expr_needs_rc_runtime_typed(operand, src, tt)
    Lambda(params, body) -> true
    Perform(lhs, op_ns, op_nl, args) -> pipeline_expr_needs_rc_runtime_typed(lhs, src, tt) or pipeline_expr_list_needs_rc_runtime_typed(args, src, tt)
    Handle(body, clauses, hret) -> true
    Resume(value) -> pipeline_expr_needs_rc_runtime_typed(value, src, tt)
    MethodCall(recv, method_hash, args, type_hash) -> pipeline_expr_needs_rc_runtime_typed(recv, src, tt) or pipeline_expr_list_needs_rc_runtime_typed(args, src, tt)
    Try(inner, effect_atom) -> pipeline_expr_needs_rc_runtime_typed(inner, src, tt)
    InterpConcat(left, right) -> pipeline_expr_needs_rc_runtime_typed(left, src, tt) or pipeline_expr_needs_rc_runtime_typed(right, src, tt)
    ForIter(var_ns, var_nl, collection, body) -> pipeline_expr_needs_rc_runtime_typed(collection, src, tt) or pipeline_expr_needs_rc_runtime_typed(body, src, tt)
    OptChain(base, field_ns, field_nl, effect_atom) -> pipeline_expr_needs_rc_runtime_typed(base, src, tt)
    LetTyped(inner, ann_type) -> pipeline_type_expr_needs_rc_runtime(ann_type) or pipeline_expr_needs_rc_runtime_typed(inner, src, tt)
    _ -> false
  }
}

fn pipeline_decl_needs_rc_runtime(decl: Decl, fn_src: i64, fnhashes: i64, tt: i64) -> bool {
  if pipeline_decl_type_surface_needs_rc_runtime(decl) == 1 {
    true
  } else {
    if decl_is_test(decl) == 1 {
      let body = decl_body_expr(decl)
      pipeline_expr_needs_rc_runtime_typed(body, fn_src, tt)
    } else {
      if decl_is_function(decl) == 1 {
        let params = decl_params(decl)
        let body = decl_body_expr(decl)
        let locals = pipeline_param_list_add_locals_typed(params, fn_src, nlist_new())
        pipeline_param_list_needs_rc_runtime_typed(params) or
        pipeline_type_expr_needs_rc_runtime(decl_return_type(decl)) or
        pipeline_expr_needs_rc_runtime_typed(body, fn_src, tt) or
        pipeline_expr_uses_function_value_typed(body, fn_src, fnhashes, locals)
      } else { false }
    }
  }
}

fn pipeline_fns_need_rc_runtime(fns: i64, tt: i64) -> bool {
  let mut found = false
  let fnhashes = pipeline_fn_name_hashes(fns)
  let mut i = 0
  while i < nlist_len(fns) {
    let pair = nlist_get(fns, i)
    if pipeline_decl_needs_rc_runtime(decl_from_node(node_f1(pair)), node_f2(pair), fnhashes, tt) {
      found = true
      i = nlist_len(fns)
    } else { i = i + 1 }
  }
  found
}

fn pipeline_expr_list_needs_effects_runtime(args: i64, nargs: i64, src: i64) -> bool {
  let mut found = false
  let mut i = 0
  while i < nargs {
    if pipeline_expr_needs_effects_runtime(nlist_get(args, i), src) {
      found = true
      i = nargs
    } else { i = i + 1 }
  }
  found
}

fn pipeline_record_fields_need_effects_runtime(fields: i64, nfields: i64, src: i64) -> bool {
  let mut found = false
  let mut i = 0
  while i < nfields {
    let field = nlist_get(fields, i)
    if pipeline_expr_needs_effects_runtime(node_f3(field), src) {
      found = true
      i = nfields
    } else { i = i + 1 }
  }
  found
}

fn pipeline_match_arms_need_effects_runtime(arms: i64, narms: i64, src: i64) -> bool {
  let mut found = false
  let mut i = 0
  while i < narms {
    let arm = nlist_get(arms, i)
    if pipeline_expr_needs_effects_runtime(node_f2(arm), src) {
      found = true
      i = narms
    } else {
      if pipeline_expr_needs_effects_runtime(node_f3(arm), src) {
        found = true
        i = narms
      } else { i = i + 1 }
    }
  }
  found
}

fn pipeline_handle_clauses_need_effects_runtime(clauses: i64, nclauses: i64, src: i64) -> i64 {
  let mut found = false
  let mut i = 0
  while i < nclauses {
    let clause = nlist_get(clauses, i)
    if pipeline_expr_needs_effects_runtime(node_f3(clause), src) {
      found = true
      i = nclauses
    } else { i = i + 1 }
  }
  found
}

fn pipeline_expr_needs_effects_runtime(node: i64, src: i64) -> bool {
  if node == 0 { false }
  else {
    match node_tag(node) {
      3 -> pipeline_expr_needs_effects_runtime(node_f2(node), src) or pipeline_expr_needs_effects_runtime(node_f3(node), src)
      4 -> pipeline_expr_list_needs_effects_runtime(node_f3(node), node_f4(node), src)
      5 -> pipeline_expr_needs_effects_runtime(node_f1(node), src) or pipeline_expr_needs_effects_runtime(node_f2(node), src) or pipeline_expr_needs_effects_runtime(node_f3(node), src)
      6 -> pipeline_expr_needs_effects_runtime(node_f3(node), src) or pipeline_expr_needs_effects_runtime(node_f4(node), src)
      7 -> pipeline_expr_needs_effects_runtime(node_f1(node), src) or pipeline_expr_needs_effects_runtime(node_f2(node), src)
      10 -> pipeline_expr_needs_effects_runtime(node_f1(node), src) or pipeline_expr_needs_effects_runtime(node_f2(node), src)
      11 -> pipeline_expr_needs_effects_runtime(node_f3(node), src) or pipeline_expr_needs_effects_runtime(node_f4(node), src)
      12 -> pipeline_expr_needs_effects_runtime(node_f3(node), src)
      13 -> pipeline_expr_needs_effects_runtime(node_f1(node), src)
      59 -> pipeline_expr_needs_effects_runtime(node_f1(node), src)
      60 -> pipeline_expr_needs_effects_runtime(node_f1(node), src) or pipeline_expr_needs_effects_runtime(node_f2(node), src)
      61 -> pipeline_expr_needs_effects_runtime(node_f1(node), src) or pipeline_expr_needs_effects_runtime(node_f2(node), src) or pipeline_expr_needs_effects_runtime(node_f3(node), src)
      62 -> pipeline_expr_needs_effects_runtime(node_f1(node), src) or pipeline_expr_needs_effects_runtime(node_f2(node), src) or pipeline_expr_needs_effects_runtime(node_f3(node), src)
      14 -> pipeline_record_fields_need_effects_runtime(node_f3(node), node_f4(node), src)
      58 -> pipeline_expr_list_needs_effects_runtime(node_f1(node), node_f2(node), src)
      15 -> pipeline_expr_needs_effects_runtime(node_f1(node), src) or pipeline_match_arms_need_effects_runtime(node_f2(node), node_f3(node), src)
      22 -> pipeline_expr_needs_effects_runtime(node_f1(node), src)
      25 -> pipeline_expr_needs_effects_runtime(node_f1(node), src)
      26 -> pipeline_expr_needs_effects_runtime(node_f1(node), src)
      29 -> pipeline_expr_needs_effects_runtime(node_f2(node), src)
      32 -> true
      33 -> true
      35 -> pipeline_expr_needs_effects_runtime(node_f1(node), src)
      36 -> pipeline_expr_needs_effects_runtime(node_f2(node), src)
      37 -> pipeline_expr_needs_effects_runtime(node_f1(node), src)
      41 -> pipeline_expr_needs_effects_runtime(node_f1(node), src) or pipeline_expr_list_needs_effects_runtime(node_f3(node), nlist_len(node_f3(node)), src)
      45 -> true
      46 -> pipeline_expr_needs_effects_runtime(node_f1(node), src) or pipeline_expr_needs_effects_runtime(node_f2(node), src)
      47 -> pipeline_expr_needs_effects_runtime(node_f3(node), src) or pipeline_expr_needs_effects_runtime(node_f4(node), src)
      48 -> true
      49 -> pipeline_expr_needs_effects_runtime(node_f1(node), src)
      52 -> pipeline_expr_needs_effects_runtime(node_f1(node), src) or pipeline_expr_needs_effects_runtime(node_f2(node), src)
      _ -> false
    }
  }
}

fn pipeline_expr_list_needs_effects_runtime_typed(args: ExprList, src: i64) -> bool {
  match args {
    ExprListNil -> false
    ExprListCons(expr, rest) -> pipeline_expr_needs_effects_runtime_typed(expr, src) or pipeline_expr_list_needs_effects_runtime_typed(rest, src)
  }
}

fn pipeline_record_fields_need_effects_runtime_typed(fields: RecordFieldList, src: i64) -> bool {
  match fields {
    RecordFieldListNil -> false
    RecordFieldListCons(field, rest) -> {
      match field {
        RecordField(ns, nl, value, fact) -> pipeline_expr_needs_effects_runtime_typed(value, src) or pipeline_record_fields_need_effects_runtime_typed(rest, src)
        UnknownRecordField(tag) -> pipeline_record_fields_need_effects_runtime_typed(rest, src)
      }
    }
  }
}

fn pipeline_match_arms_need_effects_runtime_typed(arms: MatchArmList, src: i64) -> bool {
  match arms {
    MatchArmListNil -> false
    MatchArmListCons(arm, rest) -> {
      match arm {
        Arm(pattern, body, guard, has_guard) -> {
          pipeline_expr_needs_effects_runtime_typed(body, src) or
          (if has_guard == 1 { pipeline_expr_needs_effects_runtime_typed(guard, src) } else { false }) or
          pipeline_match_arms_need_effects_runtime_typed(rest, src)
        }
        UnknownArm(tag) -> pipeline_match_arms_need_effects_runtime_typed(rest, src)
      }
    }
  }
}

fn pipeline_handle_clauses_need_effects_runtime_typed(clauses: HandlerClauseList, src: i64) -> bool {
  match clauses {
    HandlerClauseListNil -> false
    HandlerClauseListCons(clause, rest) -> {
      match clause {
        HandlerClause(name_info, params, body, continuation) -> {
          pipeline_expr_needs_effects_runtime_typed(body, src) or
          pipeline_handle_clauses_need_effects_runtime_typed(rest, src)
        }
        UnknownHandlerClause(tag) -> pipeline_handle_clauses_need_effects_runtime_typed(rest, src)
      }
    }
  }
}

fn pipeline_expr_needs_effects_runtime_pair_typed(first: Expr, second: Expr, src: i64) -> bool {
  if pipeline_expr_needs_effects_runtime_typed(first, src) {
    true
  } else {
    pipeline_expr_needs_effects_runtime_typed(second, src)
  }
}

fn pipeline_expr_needs_effects_runtime_three_typed(first: Expr, second: Expr, third: Expr, src: i64) -> bool {
  if pipeline_expr_needs_effects_runtime_typed(first, src) {
    true
  } else {
    pipeline_expr_needs_effects_runtime_pair_typed(second, third, src)
  }
}

fn pipeline_expr_needs_effects_runtime_typed(expr: Expr, src: i64) -> bool {
  match expr {
    BinOp(op, lhs, rhs) -> pipeline_expr_needs_effects_runtime_pair_typed(lhs, rhs, src)
    Call(ns, nl, args) -> pipeline_expr_list_needs_effects_runtime_typed(args, src)
    GenericCall(type_args, inner_call) -> pipeline_expr_needs_effects_runtime_typed(inner_call, src)
    If(cond, then_expr, else_expr) -> pipeline_expr_needs_effects_runtime_three_typed(cond, then_expr, else_expr, src)
    While(cond, body) -> pipeline_expr_needs_effects_runtime_pair_typed(cond, body, src)
    Loop(body) -> pipeline_expr_needs_effects_runtime_typed(body, src)
    Break(value) -> pipeline_expr_needs_effects_runtime_typed(value, src)
    Return(value) -> pipeline_expr_needs_effects_runtime_typed(value, src)
    Defer(cleanup, body) -> pipeline_expr_needs_effects_runtime_pair_typed(cleanup, body, src)
    Let(ns, nl, value, body) -> pipeline_expr_needs_effects_runtime_pair_typed(value, body, src)
    LetMut(ns, nl, value, body) -> pipeline_expr_needs_effects_runtime_pair_typed(value, body, src)
    Assign(ns, nl, value) -> pipeline_expr_needs_effects_runtime_typed(value, src)
    AddressOf(mutable, target) -> pipeline_expr_needs_effects_runtime_typed(target, src)
    Deref(ptr) -> pipeline_expr_needs_effects_runtime_typed(ptr, src)
    PtrAssign(ptr, value) -> pipeline_expr_needs_effects_runtime_pair_typed(ptr, value, src)
    Block(first, rest) -> pipeline_expr_needs_effects_runtime_pair_typed(first, rest, src)
    FieldAccess(base, field_ns, field_nl, fact) -> pipeline_expr_needs_effects_runtime_typed(base, src)
    IndexedLen(base, fixed_len) -> pipeline_expr_needs_effects_runtime_typed(base, src)
    IndexedGet(base, index, element_ty, fixed_len) -> pipeline_expr_needs_effects_runtime_pair_typed(base, index, src)
    IndexedSet(base, index, value, fact) -> pipeline_expr_needs_effects_runtime_three_typed(base, index, value, src)
    IndexedSlice(base, start, end, fact) -> pipeline_expr_needs_effects_runtime_three_typed(base, start, end, src)
    RecordInit(type_ns, type_nl, fields) -> pipeline_record_fields_need_effects_runtime_typed(fields, src)
    ArrayLiteral(elements, resolved_ty, span) -> pipeline_expr_list_needs_effects_runtime_typed(elements, src)
    Match(scrutinee, arms) -> if pipeline_expr_needs_effects_runtime_typed(scrutinee, src) { true } else { pipeline_match_arms_need_effects_runtime_typed(arms, src) }
    Not(operand) -> pipeline_expr_needs_effects_runtime_typed(operand, src)
    Lambda(params, body) -> pipeline_expr_needs_effects_runtime_typed(body, src)
    Perform(lhs, op_ns, op_nl, args) -> true
    Handle(body, clauses, hret) -> true
    Resume(value) -> pipeline_expr_needs_effects_runtime_typed(value, src)
    MethodCall(recv, method_hash, args, type_hash) -> if pipeline_expr_needs_effects_runtime_typed(recv, src) { true } else { pipeline_expr_list_needs_effects_runtime_typed(args, src) }
    Try(inner, effect_atom) -> true
    InterpConcat(left, right) -> pipeline_expr_needs_effects_runtime_pair_typed(left, right, src)
    ForIter(var_ns, var_nl, collection, body) -> pipeline_expr_needs_effects_runtime_pair_typed(collection, body, src)
    OptChain(base, field_ns, field_nl, effect_atom) -> true
    LetTyped(inner, ann_type) -> pipeline_expr_needs_effects_runtime_typed(inner, src)
    _ -> false
  }
}

fn pipeline_decl_needs_effects_runtime(decl: Decl, fn_src: i64) -> bool {
  if decl_is_function(decl) == 1 or decl_is_test(decl) == 1 {
    pipeline_expr_needs_effects_runtime_typed(decl_body_expr(decl), fn_src)
  } else { false }
}

fn pipeline_fns_need_effects_runtime(fns: i64) -> bool {
  let mut found = false
  let mut i = 0
  while i < nlist_len(fns) {
    let pair = nlist_get(fns, i)
    if pipeline_decl_needs_effects_runtime(decl_from_node(node_f1(pair)), node_f2(pair)) {
      found = true
      i = nlist_len(fns)
    } else { i = i + 1 }
  }
  found
}

fn pipeline_expr_list_needs_index_runtime_typed(exprs: ExprList) -> bool {
  match exprs {
    ExprListNil -> false
    ExprListCons(expr, rest) -> pipeline_expr_needs_index_runtime_typed(expr) or pipeline_expr_list_needs_index_runtime_typed(rest)
  }
}

fn pipeline_record_fields_need_index_runtime_typed(fields: RecordFieldList) -> bool {
  match fields {
    RecordFieldListNil -> false
    RecordFieldListCons(field, rest) -> {
      match field {
        RecordField(ns, nl, value, fact) -> pipeline_expr_needs_index_runtime_typed(value) or pipeline_record_fields_need_index_runtime_typed(rest)
        UnknownRecordField(tag) -> pipeline_record_fields_need_index_runtime_typed(rest)
      }
    }
  }
}

fn pipeline_match_arms_need_index_runtime_typed(arms: MatchArmList) -> bool {
  match arms {
    MatchArmListNil -> false
    MatchArmListCons(arm, rest) -> {
      match arm {
        Arm(pattern, body, guard, has_guard) -> {
          pipeline_expr_needs_index_runtime_typed(body) or
          (if has_guard == 1 { pipeline_expr_needs_index_runtime_typed(guard) } else { false }) or
          pipeline_match_arms_need_index_runtime_typed(rest)
        }
        UnknownArm(tag) -> pipeline_match_arms_need_index_runtime_typed(rest)
      }
    }
  }
}

fn pipeline_handler_clauses_need_index_runtime_typed(clauses: HandlerClauseList) -> bool {
  match clauses {
    HandlerClauseListNil -> false
    HandlerClauseListCons(clause, rest) -> {
      match clause {
        HandlerClause(name_info, params, body, continuation) -> pipeline_expr_needs_index_runtime_typed(body) or pipeline_handler_clauses_need_index_runtime_typed(rest)
        UnknownHandlerClause(tag) -> pipeline_handler_clauses_need_index_runtime_typed(rest)
      }
    }
  }
}

fn pipeline_handle_return_needs_index_runtime_typed(hret: HandleReturn) -> bool {
  match hret {
    NoHandleReturn -> false
    HandleReturnClause(ns, nl, body) -> pipeline_expr_needs_index_runtime_typed(body)
  }
}

fn pipeline_expr_needs_index_runtime_typed(expr: Expr) -> bool {
  match expr {
    IndexedGet(base, index, element_ty, fixed_len) -> true
    IndexedSet(base, index, value, fact) -> true
    IndexedSlice(base, start, end, fact) -> true
    BinOp(op, lhs, rhs) -> pipeline_expr_needs_index_runtime_typed(lhs) or pipeline_expr_needs_index_runtime_typed(rhs)
    Call(ns, nl, args) -> pipeline_expr_list_needs_index_runtime_typed(args)
    GenericCall(type_args, inner_call) -> pipeline_expr_needs_index_runtime_typed(inner_call)
    If(cond, then_expr, else_expr) -> pipeline_expr_needs_index_runtime_typed(cond) or pipeline_expr_needs_index_runtime_typed(then_expr) or pipeline_expr_needs_index_runtime_typed(else_expr)
    While(cond, body) -> pipeline_expr_needs_index_runtime_typed(cond) or pipeline_expr_needs_index_runtime_typed(body)
    Loop(body) -> pipeline_expr_needs_index_runtime_typed(body)
    Break(value) -> pipeline_expr_needs_index_runtime_typed(value)
    Return(value) -> pipeline_expr_needs_index_runtime_typed(value)
    Defer(cleanup, body) -> pipeline_expr_needs_index_runtime_typed(cleanup) or pipeline_expr_needs_index_runtime_typed(body)
    Let(ns, nl, value, body) -> pipeline_expr_needs_index_runtime_typed(value) or pipeline_expr_needs_index_runtime_typed(body)
    LetMut(ns, nl, value, body) -> pipeline_expr_needs_index_runtime_typed(value) or pipeline_expr_needs_index_runtime_typed(body)
    Assign(ns, nl, value) -> pipeline_expr_needs_index_runtime_typed(value)
    AddressOf(mutable, target) -> pipeline_expr_needs_index_runtime_typed(target)
    Deref(ptr) -> pipeline_expr_needs_index_runtime_typed(ptr)
    PtrAssign(ptr, value) -> pipeline_expr_needs_index_runtime_typed(ptr) or pipeline_expr_needs_index_runtime_typed(value)
    Block(first, rest) -> pipeline_expr_needs_index_runtime_typed(first) or pipeline_expr_needs_index_runtime_typed(rest)
    FieldAccess(base, field_ns, field_nl, fact) -> pipeline_expr_needs_index_runtime_typed(base)
    IndexedLen(base, fixed_len) -> pipeline_expr_needs_index_runtime_typed(base)
    RecordInit(type_ns, type_nl, fields) -> pipeline_record_fields_need_index_runtime_typed(fields)
    ArrayLiteral(elements, resolved_ty, span) -> pipeline_expr_list_needs_index_runtime_typed(elements)
    Match(scrutinee, arms) -> pipeline_expr_needs_index_runtime_typed(scrutinee) or pipeline_match_arms_need_index_runtime_typed(arms)
    Not(operand) -> pipeline_expr_needs_index_runtime_typed(operand)
    Lambda(params, body) -> pipeline_expr_needs_index_runtime_typed(body)
    Perform(lhs, op_ns, op_nl, args) -> pipeline_expr_needs_index_runtime_typed(lhs) or pipeline_expr_list_needs_index_runtime_typed(args)
    Handle(body, clauses, hret) -> pipeline_expr_needs_index_runtime_typed(body) or pipeline_handler_clauses_need_index_runtime_typed(clauses) or pipeline_handle_return_needs_index_runtime_typed(hret)
    Resume(value) -> pipeline_expr_needs_index_runtime_typed(value)
    MethodCall(recv, method_hash, args, type_hash) -> pipeline_expr_needs_index_runtime_typed(recv) or pipeline_expr_list_needs_index_runtime_typed(args)
    Try(inner, effect_atom) -> pipeline_expr_needs_index_runtime_typed(inner)
    InterpConcat(left, right) -> pipeline_expr_needs_index_runtime_typed(left) or pipeline_expr_needs_index_runtime_typed(right)
    ForIter(var_ns, var_nl, collection, body) -> pipeline_expr_needs_index_runtime_typed(collection) or pipeline_expr_needs_index_runtime_typed(body)
    OptChain(base, field_ns, field_nl, effect_atom) -> pipeline_expr_needs_index_runtime_typed(base)
    LetTyped(inner, ann_type) -> pipeline_expr_needs_index_runtime_typed(inner)
    _ -> false
  }
}

fn pipeline_fns_need_index_runtime(fns: i64) -> bool {
  let mut found = false
  let mut i = 0
  while i < nlist_len(fns) {
    let decl = decl_from_node(node_f1(nlist_get(fns, i)))
    if (decl_is_function(decl) == 1 or decl_is_test(decl) == 1) and pipeline_expr_needs_index_runtime_typed(decl_body_expr(decl)) {
      found = true
      i = nlist_len(fns)
    } else { i = i + 1 }
  }
  found
}

-- Prelude binding parses runtime files, so it is a pipeline entry point:
-- it discharges Diagnose with the standard renderer rather than leaking
-- the effect to every caller.
fn pipeline_bind_runtime_preludes(fns: i64, src: i64, tt: i64) -> i64 {
  handle pipeline_bind_runtime_preludes_inner(fns, src, tt) {
    Diagnose.error(msg, span) -> { pipeline_diagnose_render(tt, src, msg, span) resume(0) }
    Diagnose.warn(msg, span) -> { pipeline_diagnose_render(tt, src, msg, span) resume(0) }
    Diagnose.note(msg, span) -> { pipeline_diagnose_render(tt, src, msg, span) resume(0) }
  }
}

fn pipeline_bind_runtime_preludes_inner(fns: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  let had_index_need = pipeline_fns_need_index_runtime(fns)
  if had_index_need {
    parse_use_file(fns, tt, "runtime/panic.weft")
  } else { 0 }
  let had_effects_need = pipeline_fns_need_effects_runtime(fns)
  -- Aggregate CONSTRUCTION (variant ctor with payloads, record init)
  -- allocates default-managed rc payloads (2q slice 2); the walker
  -- consults the ttable so plain type declarations without construction
  -- do not drag the rc runtime into parse-only tooling output.
  let had_rc_need = pipeline_fns_need_rc_runtime(fns, tt)
  if had_effects_need {
    parse_use_file(fns, tt, "runtime/effects.weft")
  } else { 0 }
  let rc_need = had_rc_need or pipeline_fns_need_rc_runtime(fns, tt)
  if rc_need {
    parse_use_file(fns, tt, "runtime/rc.weft")
  } else { 0 }
  if had_effects_need == 0 {
    if rc_need {
      parse_use_file(fns, tt, "runtime/effects.weft")
    } else { if pipeline_fns_need_effects_runtime(fns) {
      parse_use_file(fns, tt, "runtime/effects.weft")
    } else { 0 } }
  } else { 0 }
  fns
}

fn pipeline_parse_source(src: i64, n: i64) -> AstModule {
  pipeline_parse_source_with_origin(src, n, 0, 1)
}

fn pipeline_strict_for_trust(trusted: i64) -> i64 {
  if trusted == 1 { 0 } else { 1 }
}

fn pipeline_parse_source_with_trust(src: i64, n: i64, trusted: i64) -> AstModule {
  pipeline_parse_source_with_origin(src, n, trusted, pipeline_strict_for_trust(trusted))
}

fn pipeline_mark_root_origin(tt: i64, src: i64, trusted: i64, strict: i64) -> i64 {
  if trusted == 1 {
    ttable_mark_trusted_source(tt, src)
  } else { if strict == 1 {
    ttable_mark_strict_source(tt, src)
  } else { 0 } }
}

fn pipeline_parse_source_with_origin(src: i64, n: i64, trusted: i64, strict: i64) -> AstModule {
  let grammar = weft_grammar()
  let tt = ttable_new()
  pipeline_mark_root_origin(tt, src, trusted, strict)
  let ast = pipeline_parse_module(grammar, src, n, tt)
  match ast {
    AstModule(fns, ast_src, ast_tt) -> {
      pipeline_bind_runtime_preludes(fns, ast_src, ast_tt)
      ast
    }
  }
}

fn pipeline_parse_source_with_diagnostics(src: i64, n: i64) -[Diagnose]> AstModule {
  pipeline_parse_source_with_diagnostics_and_origin(src, n, 0, 1)
}

fn pipeline_parse_source_with_diagnostics_and_trust(src: i64, n: i64, trusted: i64) -[Diagnose]> AstModule {
  pipeline_parse_source_with_diagnostics_and_origin(src, n, trusted, pipeline_strict_for_trust(trusted))
}

fn pipeline_parse_source_with_diagnostics_and_origin(src: i64, n: i64, trusted: i64, strict: i64) -[Diagnose]> AstModule {
  let grammar = weft_grammar()
  let tt = ttable_new()
  pipeline_mark_root_origin(tt, src, trusted, strict)
  let fns = grammar.parse(src, n, tt)
  pipeline_bind_runtime_preludes(fns, src, tt)
  AstModule(fns, src, tt)
}

fn pipeline_check_source(src: i64, n: i64) -> TypedModule {
  pipeline_check_source_with_origin(src, n, 0, 1)
}

fn pipeline_check_source_with_trust(src: i64, n: i64, trusted: i64) -> TypedModule {
  pipeline_check_source_with_origin(src, n, trusted, pipeline_strict_for_trust(trusted))
}

fn pipeline_check_source_with_origin(src: i64, n: i64, trusted: i64, strict: i64) -> TypedModule {
  let ast = pipeline_parse_source_with_origin(src, n, trusted, strict)
  pipeline_check_module(ast)
}

fn pipeline_check_source_with_diagnostics(src: i64, n: i64) -[Diagnose]> TypedModule {
  pipeline_check_source_with_diagnostics_and_origin(src, n, 0, 1)
}

fn pipeline_check_source_with_diagnostics_and_trust(src: i64, n: i64, trusted: i64) -[Diagnose]> TypedModule {
  pipeline_check_source_with_diagnostics_and_origin(src, n, trusted, pipeline_strict_for_trust(trusted))
}

fn pipeline_check_source_with_diagnostics_and_origin(src: i64, n: i64, trusted: i64, strict: i64) -[Diagnose]> TypedModule {
  match pipeline_parse_source_with_diagnostics_and_origin(src, n, trusted, strict) {
    AstModule(fns, ast_src, tt) -> pipeline_check_fns_with_diagnostics(fns, ast_src, tt)
  }
}

fn pipeline_handler_inline_stats(inline_sites: i64, residual_sites: i64) -> PipelineHandlerInlineStats {
  PipelineHandlerInlineStats(inline_sites, residual_sites)
}

fn pipeline_handler_inline_stats_inline_sites(stats: PipelineHandlerInlineStats) -> i64 {
  match stats {
    PipelineHandlerInlineStats(inline_sites, residual_sites) -> inline_sites
  }
}

fn pipeline_handler_inline_stats_residual_sites(stats: PipelineHandlerInlineStats) -> i64 {
  match stats {
    PipelineHandlerInlineStats(inline_sites, residual_sites) -> residual_sites
  }
}

fn pipeline_handler_inline_stats_from_ir_functions(functions: IrFunctionList) -> PipelineHandlerInlineStats {
  PipelineHandlerInlineStats(
    ir_function_list_count_tag(functions, 24),
    ir_function_list_count_tag(functions, 18)
  )
}

fn pipeline_handler_evidence_candidate_sites_from_ir_functions(functions: IrFunctionList) -> i64 {
  ir_function_list_count_tag(functions, 18)
}

fn pipeline_handler_inline_ctx_empty() -> PipelineHandlerInlineCtx {
  PipelineHandlerInlineCtxNil
}

fn pipeline_handler_inline_ctx_push_typed_src(ctx: PipelineHandlerInlineCtx, eff_hash: i64, clauses: HandlerClauseList, nclauses: i64, clause_src: i64) -> PipelineHandlerInlineCtx {
  PipelineHandlerInlineCtxCons(eff_hash, clauses, nclauses, clause_src, 1, 1, 1, ctx)
}

fn pipeline_handler_inline_ctx_push_typed_src_no_evidence(ctx: PipelineHandlerInlineCtx, eff_hash: i64, clauses: HandlerClauseList, nclauses: i64, clause_src: i64) -> PipelineHandlerInlineCtx {
  PipelineHandlerInlineCtxCons(eff_hash, clauses, nclauses, clause_src, 1, 0, 1, ctx)
}

fn pipeline_handler_inline_ctx_push_typed_src_safe(ctx: PipelineHandlerInlineCtx, eff_hash: i64, clauses: HandlerClauseList, nclauses: i64, clause_src: i64, evidence: i64, out_of_line_safe: i64) -> PipelineHandlerInlineCtx {
  PipelineHandlerInlineCtxCons(eff_hash, clauses, nclauses, clause_src, 1, evidence, out_of_line_safe, ctx)
}

fn pipeline_handler_inline_ctx_evidence_only(selection: PipelineLambdaEvidenceSelection) -> PipelineHandlerInlineCtx {
  match selection {
    PipelineLambdaEvidenceSelectionNone -> PipelineHandlerInlineCtxNil
    PipelineLambdaEvidenceSelectionBound(eff_hash, clauses, nclauses, clause_src) -> {
      PipelineHandlerInlineCtxCons(eff_hash, clauses, nclauses, clause_src, 0, 1, 1, PipelineHandlerInlineCtxNil)
    }
  }
}

fn pipeline_handler_inline_ctx_push_typed(ctx: PipelineHandlerInlineCtx, eff_hash: i64, clauses: HandlerClauseList, nclauses: i64) -> PipelineHandlerInlineCtx {
  PipelineHandlerInlineCtxCons(eff_hash, clauses, nclauses, 0, 1, 1, 1, ctx)
}

fn pipeline_handler_inline_ctx_push(ctx: PipelineHandlerInlineCtx, eff_hash: i64, clauses: i64, nclauses: i64) -> PipelineHandlerInlineCtx {
  pipeline_handler_inline_ctx_push_typed(ctx, eff_hash, handler_clause_list_from_nodes(clauses, 0, nclauses), nclauses)
}

fn pipeline_handler_clause_effect_hash(src: i64, clause: i64) -> i64 {
  let names = node_f1(clause)
  effect_ref_name_hash(node_f1(names), src)
}

fn pipeline_handler_clause_op_hash(src: i64, clause: i64) -> i64 {
  let names = node_f1(clause)
  str_hash(src, node_f2(names), node_f3(names))
}

fn pipeline_effect_ref_name_start_typed(effect_ref: Expr, default: i64) -> i64 {
  match effect_ref {
    Ident(ns, nl) -> ns
    GenericCall(type_args, inner) -> {
      match inner {
        Ident(ns, nl) -> ns
        _ -> default
      }
    }
    _ -> default
  }
}

fn pipeline_effect_ref_name_len_typed(effect_ref: Expr, default: i64) -> i64 {
  match effect_ref {
    Ident(ns, nl) -> nl
    GenericCall(type_args, inner) -> {
      match inner {
        Ident(ns, nl) -> nl
        _ -> default
      }
    }
    _ -> default
  }
}

fn pipeline_effect_ref_hash_typed(src: i64, effect_ref: Expr) -> i64 {
  let ns = pipeline_effect_ref_name_start_typed(effect_ref, 0)
  let nl = pipeline_effect_ref_name_len_typed(effect_ref, 0)
  if nl == 0 { 0 } else { str_hash(src, ns, nl) }
}

fn pipeline_effect_atom_dispatch_key(atom: i64, subst: i64, default_head: i64) -> i64 {
  let head = if atom == 0 { default_head } else { ty_f1(atom) }
  let args = if atom == 0 { 0 } else { effect_atom_args(atom) }
  if head == 0 or args == 0 or nlist_len(args) == 0 { head }
  else {
    let concrete = if subst == 0 { args } else { type_list_subst(args, subst) }
    mono_spec_hash(head, concrete)
  }
}

fn pipeline_effect_ref_dispatch_key_typed(src: i64, effect_ref: Expr, subst: i64) -> i64 {
  let head = pipeline_effect_ref_hash_typed(src, effect_ref)
  match effect_ref {
    GenericCall(type_args, inner) -> {
      let args = type_expr_list_to_nodes(type_args)
      pipeline_effect_atom_dispatch_key(ty_effect_app_args(head, args), subst, head)
    }
    _ -> head
  }
}

fn pipeline_effect_ref_dispatch_key_node(src: i64, effect_ref: i64, subst: i64) -> i64 {
  let head = effect_ref_name_hash(effect_ref, src)
  let args = effect_ref_type_args(effect_ref)
  if args == 0 { head }
  else { pipeline_effect_atom_dispatch_key(ty_effect_app_args(head, args), subst, head) }
}

fn pipeline_handler_clause_dispatch_key_typed(src: i64, clause: HandlerClause, subst: i64) -> i64 {
  match clause {
    HandlerClause(name_info, params, body, continuation) -> {
      match name_info {
        HandlerClauseName(effect_ref, op_ns, op_nl) -> pipeline_effect_ref_dispatch_key_typed(src, effect_ref, subst)
        UnknownHandlerClauseName -> 0
      }
    }
    UnknownHandlerClause(tag) -> 0
  }
}

fn pipeline_handler_clause_effect_hash_typed(src: i64, clause: HandlerClause) -> i64 {
  match clause {
    HandlerClause(name_info, params, body, continuation) -> {
      match name_info {
        HandlerClauseName(effect_ref, op_ns, op_nl) -> pipeline_effect_ref_hash_typed(src, effect_ref)
        UnknownHandlerClauseName -> 0
      }
    }
    UnknownHandlerClause(tag) -> 0
  }
}

fn pipeline_handler_clause_op_hash_typed(src: i64, clause: HandlerClause) -> i64 {
  match clause {
    HandlerClause(name_info, params, body, continuation) -> {
      match name_info {
        HandlerClauseName(effect_ref, op_ns, op_nl) -> str_hash(src, op_ns, op_nl)
        UnknownHandlerClauseName -> 0
      }
    }
    UnknownHandlerClause(tag) -> 0
  }
}

fn pipeline_handler_clauses_have_op_hash(src: i64, clauses: i64, nclauses: i64, op_hash: i64) -> i64 {
  let mut found = 0
  let mut i = 0
  while i < nclauses {
    if pipeline_handler_clause_op_hash(src, nlist_get(clauses, i)) == op_hash {
      found = 1
      i = nclauses
    } else { i = i + 1 }
  }
  found
}

fn pipeline_handler_clause_index_for_op_hash(src: i64, clauses: i64, nclauses: i64, op_hash: i64) -> i64 {
  let mut result = 0 - 1
  let mut i = 0
  while i < nclauses {
    if pipeline_handler_clause_op_hash(src, nlist_get(clauses, i)) == op_hash {
      result = i
      i = nclauses
    } else { i = i + 1 }
  }
  result
}

fn pipeline_handler_clause_list_index_for_op_hash(src: i64, clauses: HandlerClauseList, nclauses: i64, op_hash: i64) -> i64 {
  let mut result = 0 - 1
  let mut i = 0
  while i < nclauses {
    if pipeline_handler_clause_op_hash_typed(src, handler_clause_list_nth(clauses, i)) == op_hash {
      result = i
      i = nclauses
    } else { i = i + 1 }
  }
  result
}

fn pipeline_handler_inline_match_found(found: PipelineHandlerInlineMatch) -> i64 {
  match found {
    PipelineHandlerInlineNoMatch -> 0
    PipelineHandlerInlineMatched(handler_depth, clause_index) -> 1
  }
}

fn pipeline_handler_inline_match_depth_or(found: PipelineHandlerInlineMatch, default: i64) -> i64 {
  match found {
    PipelineHandlerInlineNoMatch -> default
    PipelineHandlerInlineMatched(handler_depth, clause_index) -> handler_depth
  }
}

fn pipeline_handler_inline_match_clause_index_or(found: PipelineHandlerInlineMatch, default: i64) -> i64 {
  match found {
    PipelineHandlerInlineNoMatch -> default
    PipelineHandlerInlineMatched(handler_depth, clause_index) -> clause_index
  }
}

fn pipeline_handler_inline_ctx_find_match_at(ctx: PipelineHandlerInlineCtx, src: i64, eff_hash: i64, op_hash: i64, depth: i64) -> PipelineHandlerInlineMatch {
  match ctx {
    PipelineHandlerInlineCtxNil -> PipelineHandlerInlineNoMatch
    PipelineHandlerInlineCtxCons(ctx_eff_hash, clauses, nclauses, clause_src, direct, evidence, out_of_line_safe, rest) -> {
      if direct == 0 {
        pipeline_handler_inline_ctx_find_match_at(rest, src, eff_hash, op_hash, depth)
      } else { if ctx_eff_hash == eff_hash {
        let hash_src = if clause_src != 0 { clause_src } else { src }
        let clause_index = pipeline_handler_clause_list_index_for_op_hash(hash_src, clauses, nclauses, op_hash)
        if clause_index >= 0 {
          PipelineHandlerInlineMatched(depth, clause_index)
        } else {
          pipeline_handler_inline_ctx_find_match_at(rest, src, eff_hash, op_hash, depth + 1)
        }
      } else {
        pipeline_handler_inline_ctx_find_match_at(rest, src, eff_hash, op_hash, depth + 1)
      } }
    }
  }
}

fn pipeline_handler_inline_ctx_find_match(ctx: PipelineHandlerInlineCtx, src: i64, eff_hash: i64, op_hash: i64) -> PipelineHandlerInlineMatch {
  pipeline_handler_inline_ctx_find_match_at(ctx, src, eff_hash, op_hash, 0)
}

fn pipeline_handler_inline_ctx_find(ctx: PipelineHandlerInlineCtx, src: i64, eff_hash: i64, op_hash: i64) -> i64 {
  pipeline_handler_inline_match_found(pipeline_handler_inline_ctx_find_match(ctx, src, eff_hash, op_hash))
}

fn pipeline_handler_inline_ctx_entry_at(ctx: PipelineHandlerInlineCtx, depth: i64) -> PipelineHandlerInlineCtx {
  match ctx {
    PipelineHandlerInlineCtxNil -> PipelineHandlerInlineCtxNil
    PipelineHandlerInlineCtxCons(eff_hash, clauses, nclauses, clause_src, direct, evidence, out_of_line_safe, rest) -> {
      if direct == 0 {
        pipeline_handler_inline_ctx_entry_at(rest, depth)
      } else {
        if depth <= 0 { ctx } else { pipeline_handler_inline_ctx_entry_at(rest, depth - 1) }
      }
    }
  }
}

-- Handler clause and deferred-body functions are emitted out of line.
-- Only enclosing handlers whose operation functions need no lexical
-- captures have the same addressable handler-depth shape there.
fn pipeline_handler_inline_ctx_out_of_line_safe(ctx: PipelineHandlerInlineCtx) -> PipelineHandlerInlineCtx {
  match ctx {
    PipelineHandlerInlineCtxNil -> PipelineHandlerInlineCtxNil
    PipelineHandlerInlineCtxCons(eff_hash, clauses, nclauses, clause_src, direct, evidence, out_of_line_safe, rest) -> {
      let safe_rest = pipeline_handler_inline_ctx_out_of_line_safe(rest)
      if out_of_line_safe == 1 {
        PipelineHandlerInlineCtxCons(eff_hash, clauses, nclauses, clause_src, direct, evidence, out_of_line_safe, safe_rest)
      } else {
        safe_rest
      }
    }
  }
}

-- Tail-resumptive clause inlining: a clause of exactly `op(args) -> resume(expr)`
-- whose expr is closed over the clause params can be evaluated directly at the
-- perform site. This is what lets sealed-Unsafe discharge handles compile to
-- straight-line intrinsics with no runtime handler frame.
fn pipeline_handler_clause_resume_tail_expr(clause: HandlerClause) -> Expr {
  match clause {
    HandlerClause(name, params, body, cont) -> {
      match cont {
        HandlerClauseNoContinuation -> {
          match body {
            Resume(value) -> value
            _ -> UnknownExpr(0)
          }
        }
        _ -> UnknownExpr(0)
      }
    }
    UnknownHandlerClause(tag) -> UnknownExpr(0)
  }
}

fn pipeline_clause_inline_ident_is_param(params: ParamList, ns: i64, nl: i64, src: i64) -> i64 {
  match params {
    ParamListNil -> 0
    ParamListCons(param, rest) -> {
      match param {
        Param(p_ns, p_nl, ty, label) -> {
          if p_nl == nl and src_eq_at(src, ns, src + p_ns, 0, nl) == 1 { 1 } else { pipeline_clause_inline_ident_is_param(rest, ns, nl, src) }
        }
        UnknownParam(tag) -> pipeline_clause_inline_ident_is_param(rest, ns, nl, src)
      }
    }
  }
}

fn pipeline_param_list_concat(a: ParamList, b: ParamList) -> ParamList {
  match a {
    ParamListNil -> b
    ParamListCons(p, rest) -> ParamListCons(p, pipeline_param_list_concat(rest, b))
  }
}

fn pipeline_clause_inline_expr_list_closed(exprs: ExprList, params: ParamList, src: i64, fns: i64) -> i64 {
  match exprs {
    ExprListNil -> 1
    ExprListCons(expr, rest) -> {
      if pipeline_clause_inline_expr_closed(expr, params, src, fns) == 0 { 0 } else { pipeline_clause_inline_expr_list_closed(rest, params, src, fns) }
    }
  }
}

fn pipeline_clause_inline_expr_closed(expr: Expr, params: ParamList, src: i64, fns: i64) -> i64 {
  match expr {
    IntLit(value, start, len) -> 1
    BoolLit(value) -> 1
    NilExpr -> 1
    FloatLit(start, len) -> 1
    Ident(ns, nl) -> pipeline_clause_inline_ident_is_param(params, ns, nl, src)
    Not(operand) -> pipeline_clause_inline_expr_closed(operand, params, src, fns)
    BinOp(op, lhs, rhs) -> {
      if pipeline_clause_inline_expr_closed(lhs, params, src, fns) == 0 { 0 } else { pipeline_clause_inline_expr_closed(rhs, params, src, fns) }
    }
    Call(ns, nl, args) -> {
      let callee_hash = str_hash(src, ns, nl)
      if pipeline_ir_native_intrinsic_kind(callee_hash) == 0 and pipeline_fns_contains_hash(fns, callee_hash) == 0 { 0 }
      else { pipeline_clause_inline_expr_list_closed(args, params, src, fns) }
    }
    Perform(lhs, op_ns, op_nl, args) -> pipeline_clause_inline_expr_list_closed(args, params, src, fns)
    Lambda(lambda_params, lambda_body) -> pipeline_clause_inline_expr_closed(lambda_body, pipeline_param_list_concat(lambda_params, params), src, fns)
    Block(first, rest) -> {
      if pipeline_clause_inline_expr_closed(first, params, src, fns) == 0 { 0 } else { pipeline_clause_inline_expr_closed(rest, params, src, fns) }
    }
    LetTyped(inner, ann_type) -> pipeline_clause_inline_expr_closed(inner, params, src, fns)
    _ -> 0
  }
}

fn pipeline_effect_atoms_contains_hash(atoms: EffectAtomList, eff_hash: i64) -> i64 {
  match atoms {
    EffectAtomListNil -> 0
    EffectAtomListCons(hash, rest) -> if hash == eff_hash { 1 } else { pipeline_effect_atoms_contains_hash(rest, eff_hash) }
  }
}

-- 1 when the callee provably cannot perform eff_hash: a pure signature,
-- or a concrete effect set (no tail variable) that does not mention it.
fn pipeline_fn_effects_exclude_hash(fn_wrap: i64, eff_hash: i64) -> i64 {
  let sig = effect_sig_from_node(fn_effects(fn_wrap))
  match sig {
    MissingEffectSig -> 1
    EffectSig(effects, tail_var) -> {
      if tail_var != 0 { 0 }
      else { if pipeline_effect_atoms_contains_hash(effects, eff_hash) == 1 { 0 } else { 1 } }
    }
  }
}

-- Splicing a clause tail at the perform site is only sound when the tail
-- cannot perform the handler's OWN label: a spliced perform lowers in the
-- handle-body context where the handler's own frame is innermost, so a
-- same-label perform that falls to dynamic dispatch re-enters the very
-- clause being spliced (the under/evidence-masking trap; observed as a
-- doubled resume expression). Conservative: any direct same-label
-- perform, any call whose effect signature may include the label (or has
-- a tail variable), or any shape we cannot see through, blocks the
-- splice — the perform then keeps its dynamic lowering, whose clause
-- call masks the handler's own frame.
fn pipeline_clause_tail_may_perform_hash(expr: Expr, src: i64, eff_hash: i64, fns: i64) -> i64 {
  match expr {
    IntLit(value, start, len) -> 0
    BoolLit(value) -> 0
    NilExpr -> 0
    FloatLit(start, len) -> 0
    Ident(ns, nl) -> 0
    Not(operand) -> pipeline_clause_tail_may_perform_hash(operand, src, eff_hash, fns)
    BinOp(op, lhs, rhs) -> {
      if pipeline_clause_tail_may_perform_hash(lhs, src, eff_hash, fns) == 1 { 1 }
      else { pipeline_clause_tail_may_perform_hash(rhs, src, eff_hash, fns) }
    }
    Block(first, rest) -> {
      if pipeline_clause_tail_may_perform_hash(first, src, eff_hash, fns) == 1 { 1 }
      else { pipeline_clause_tail_may_perform_hash(rest, src, eff_hash, fns) }
    }
    LetTyped(inner, ann_type) -> pipeline_clause_tail_may_perform_hash(inner, src, eff_hash, fns)
    Lambda(lambda_params, lambda_body) -> pipeline_clause_tail_may_perform_hash(lambda_body, src, eff_hash, fns)
    Perform(lhs, op_ns, op_nl, args) -> {
      let own = match lhs {
        Ident(ns, nl) -> if effect_name_hash(src, ns, nl) == eff_hash { 1 } else { 0 }
        _ -> 1
      }
      if own == 1 { 1 } else { pipeline_clause_tail_list_may_perform_hash(args, src, eff_hash, fns) }
    }
    Call(ns, nl, args) -> {
      let callee_hash = str_hash(src, ns, nl)
      let callee_safe = if pipeline_ir_native_intrinsic_kind(callee_hash) != 0 { 1 }
        else {
          let pair = pipeline_fns_lookup_pair_by_hash(fns, callee_hash)
          if pair == 0 { 0 } else { pipeline_fn_effects_exclude_hash(node_f1(pair), eff_hash) }
        }
      if callee_safe == 0 { 1 } else { pipeline_clause_tail_list_may_perform_hash(args, src, eff_hash, fns) }
    }
    _ -> 1
  }
}

fn pipeline_clause_tail_list_may_perform_hash(exprs: ExprList, src: i64, eff_hash: i64, fns: i64) -> i64 {
  match exprs {
    ExprListNil -> 0
    ExprListCons(expr, rest) -> {
      if pipeline_clause_tail_may_perform_hash(expr, src, eff_hash, fns) == 1 { 1 }
      else { pipeline_clause_tail_list_may_perform_hash(rest, src, eff_hash, fns) }
    }
  }
}

fn pipeline_handler_inline_try_tail_resume(handlers: PipelineHandlerInlineCtx, found: PipelineHandlerInlineMatch, arg_values: IrValueList, tt: i64, fns: i64, next_value: i64) -> IrLoweredExpr {
  if pipeline_handler_inline_match_found(found) == 0 {
    ir_lowered_expr_invalid(next_value)
  } else {
    let entry = pipeline_handler_inline_ctx_entry_at(handlers, pipeline_handler_inline_match_depth_or(found, 0))
    match entry {
      PipelineHandlerInlineCtxNil -> ir_lowered_expr_invalid(next_value)
      PipelineHandlerInlineCtxCons(eff_hash, clauses, nclauses, clause_src, direct, evidence, out_of_line_safe, outer) -> {
        if clause_src == 0 {
          ir_lowered_expr_invalid(next_value)
        } else {
          let clause = handler_clause_list_nth(clauses, pipeline_handler_inline_match_clause_index_or(found, 0))
          let tail = pipeline_handler_clause_resume_tail_expr(clause)
          match tail {
            UnknownExpr(tag) -> ir_lowered_expr_invalid(next_value)
            _ -> {
              match clause {
                HandlerClause(name, clause_params, body, cont) -> {
                  -- The re-entry fence is deliberately head-conservative:
                  -- effect signatures expose heads here, while eff_hash is
                  -- now the atom-specific runtime key. Treating that key as
                  -- a head would falsely prove parameterized callees safe.
                  let reentry_head = pipeline_handler_clause_effect_hash_typed(clause_src, handler_clause_list_nth(clauses, 0))
                  if pipeline_clause_inline_expr_closed(tail, clause_params, clause_src, fns) == 0 {
                    ir_lowered_expr_invalid(next_value)
                  } else { if pipeline_clause_tail_may_perform_hash(tail, clause_src, reentry_head, fns) == 1 {
                    ir_lowered_expr_invalid(next_value)
                  } else {
                    let param_nodes = param_list_to_nodes(clause_params)
                    if nlist_len(param_nodes) != ir_value_list_len(arg_values) {
                      ir_lowered_expr_invalid(next_value)
                    } else {
                      let expected_params = match name {
                        HandlerClauseName(effect_ref, op_ns, op_nl) -> pipeline_effect_op_params_nodes_typed(tt, clause_src, effect_ref, op_ns, op_nl, 0)
                        UnknownHandlerClauseName -> 0
                      }
                      let typed_params = if expected_params == 0 { param_nodes } else { expected_params }
                      -- Tail-resume inlining currently aliases operation
                      -- arguments directly into the perform result. Managed
                      -- parameters require a result retain followed by the
                      -- clause-owned parameter release; keep them on the
                      -- ordinary clause path until that transfer is carried
                      -- explicitly by the inline result fact.
                      if cg_params_managed_mask(typed_params) != 0 {
                        ir_lowered_expr_invalid(next_value)
                      } else {
                        let clause_env = pipeline_handler_inline_param_values(clause_params, typed_params, arg_values, 0, pipeline_value_env_empty())
                        let sub_ctx = pipeline_handler_lower_ctx_with_fns_subst(0, clause_env, clause_src, tt, outer, fns, 0)
                        pipeline_lower_expr_typed_sidecar_handler_ctx(tail, next_value, sub_ctx)
                      }
                    }
                  } }
                }
                UnknownHandlerClause(tag) -> ir_lowered_expr_invalid(next_value)
              }
            }
          }
        }
      }
    }
  }
}

fn pipeline_handler_inline_param_values(params: ParamList, expected_params: i64, values: IrValueList, index: i64, env: PipelineValueEnv) -> PipelineValueEnv {
  match params {
    ParamListNil -> env
    ParamListCons(param, rest) -> {
      match param {
        Param(ns, nl, raw_ty, label) -> {
          let expected_ty = if expected_params != 0 and index < nlist_len(expected_params) { node_f3(nlist_get(expected_params, index)) } else { type_expr_to_node(raw_ty) }
          let value = pipeline_ir_value_list_get_or(values, index, 0 - 1)
          let next_env = if value < 0 {
            env
          } else {
            pipeline_value_env_push_float_typed_node(
              env,
              ns,
              nl,
              value,
              pipeline_type_node_prim_id_or(expected_ty, 0),
              if expected_ty == 0 { 0 } else { type_hash_of(expected_ty) },
              expected_ty
            )
          }
          pipeline_handler_inline_param_values(rest, expected_params, values, index + 1, next_env)
        }
        UnknownParam(tag) -> pipeline_handler_inline_param_values(rest, expected_params, values, index + 1, env)
      }
    }
  }
}

fn pipeline_effect_atoms_within_hash(atoms: EffectAtomList, eff_hash: i64) -> i64 {
  match atoms {
    EffectAtomListNil -> 1
    EffectAtomListCons(hash, rest) -> if hash == eff_hash { pipeline_effect_atoms_within_hash(rest, eff_hash) } else { 0 }
  }
}

fn pipeline_fn_effects_within_hash(fn_wrap: i64, eff_hash: i64) -> i64 {
  let sig = effect_sig_from_node(fn_effects(fn_wrap))
  match sig {
    MissingEffectSig -> 1
    EffectSig(effects, tail_var) -> {
      if tail_var != 0 { 0 } else { pipeline_effect_atoms_within_hash(effects, eff_hash) }
    }
  }
}

-- A handle region whose lowered body contains only straight-line data flow
-- and intrinsic calls cannot dispatch dynamically, so the runtime handler
-- frame (ops table + frame node, both bump-allocated per execution) can be
-- elided entirely. Any call, perform, lambda, or nested handler keeps it.
fn pipeline_ir_insts_handle_frame_free(insts: IrInstList) -> i64 {
  match insts {
    IrInstNil -> 1
    IrInstCons(inst, rest) -> {
      let ok = match inst {
        IrConstI64(dst, value) -> 1
        IrNilI64(dst) -> 1
        IrBinaryI64(dst, op, lhs, rhs) -> 1
        IrFloatBinaryI64(dst, slot, op, lhs, rhs) -> 1
        IrUnaryI64(dst, op, operand) -> 1
        IrBindI64(dst, ns, nl, value) -> 1
        IrSlotI64(slot) -> 1
        IrLoadI64(dst, slot) -> 1
        IrStoreI64(slot, value) -> 1
        IrFieldLoadI64(dst, base, field_hash, field_index) -> 1
        IrRecordLayoutWordLoadI64(dst, base, record_data_size, field_hash, byte_offset) -> 1
        IrVariantTagI64(dst, value) -> 1
        IrVariantPayloadI64(dst, value, index) -> 1
        IrCallI64(dst, callee_hash, args) -> if pipeline_ir_native_intrinsic_kind(callee_hash) != 0 { 1 } else { 0 }
        _ -> 0
      }
      if ok == 0 { 0 } else { pipeline_ir_insts_handle_frame_free(rest) }
    }
  }
}

-- Inline a discharge-shaped handle body: `handle helper(args) { clauses }`
-- where helper is a known non-generic fn whose declared effects are covered
-- by this handle. Lowering the helper body under the handle's inline ctx
-- turns its performs into lexical dispatches (and tail-resume inlines),
-- which is what allows frame elision for the sealed-Unsafe idiom.
fn pipeline_lower_handle_body_call_inline_nodes(body_node: i64, handled_eff_hash: i64, next_ctx: PipelineHandlerInlineCtx, next_lower_ctx: PipelineHandlerLowerCtx, next_value: i64) -> IrLoweredExpr {
  let src = pipeline_handler_lower_ctx_src(next_lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(next_lower_ctx)
  let fns = pipeline_handler_lower_ctx_fns(next_lower_ctx)
  let stripped = pipeline_expr_node_strip_typed(body_node)
  if stripped == 0 { ir_lowered_expr_invalid(next_value) }
  else {
    -- GenericCall bodies (handle unsafe_transmute<T, U>(v) { ... })
    -- inline through the same path: unwrap the type args, resolve
    -- them through the enclosing specialisation's subst, and lower
    -- the generic callee's body under the resulting binding. This is
    -- what lets the sealed-Unsafe discharge idiom stay frame-free
    -- inside monomorphized copies (2r slice 0 — the vector-storage
    -- transmute helpers were allocating a frame per element access).
    let tag = node_tag(stripped)
    let type_args = if tag == 36 { node_f1(stripped) } else { 0 }
    let call_node = if tag == 36 { pipeline_expr_node_strip_typed(node_f2(stripped)) } else { stripped }
    if call_node == 0 { ir_lowered_expr_invalid(next_value) }
    else { if node_tag(call_node) != 4 { ir_lowered_expr_invalid(next_value) }
    else { if pipeline_variant_payload_count(tt, src, node_f1(call_node), node_f2(call_node)) >= 0 { ir_lowered_expr_invalid(next_value) }
    else {
      let pair = if type_args == 0 {
        pipeline_fns_lookup_pair(fns, src, node_f1(call_node), node_f2(call_node))
      } else {
        pipeline_generic_template_find(fns, src, str_hash(src, node_f1(call_node), node_f2(call_node)))
      }
      if pair == 0 { ir_lowered_expr_invalid(next_value) }
      else {
        let fn_wrap = node_f1(pair)
        let fn_src = node_f2(pair)
        let tparams = fn_tparams(fn_wrap)
        let generic_ok = if type_args == 0 { if tparams == 0 { 1 } else { 0 } }
          else { if tparams != 0 and nlist_len(tparams) == nlist_len(type_args) { 1 } else { 0 } }
        if pipeline_decl_node_is_function(fn_wrap) == 0 or generic_ok == 0 { ir_lowered_expr_invalid(next_value) }
        else { if pipeline_fn_effects_within_hash(fn_wrap, handled_eff_hash) == 0 { ir_lowered_expr_invalid(next_value) }
        else {
          let inner = pipeline_fn_inner(fn_wrap)
          let callee_params = node_f3(inner)
          let callee_body = node_f4(inner)
          let args = node_f3(call_node)
          let arg_count = node_f4(call_node)
          if arg_count != nlist_len(callee_params) { ir_lowered_expr_invalid(next_value) }
          else { if pipeline_expr_needs_cfg(callee_body) == 1 { ir_lowered_expr_invalid(next_value) }
          else {
            let callee_body_expr = expr_from_node(pipeline_expr_node_strip_typed(callee_body))
            if pipeline_clause_inline_expr_closed(callee_body_expr, param_list_from_param_nodes(callee_params), fn_src, fns) == 0 { ir_lowered_expr_invalid(next_value) }
            else {
              let lowered_args = pipeline_lower_node_handler_opt_args(args, arg_count, next_value, next_lower_ctx)
              if pipeline_lowered_args_is_valid(lowered_args) == 0 { ir_lowered_expr_invalid(next_value) }
              else {
                let outer_subst = pipeline_handler_lower_ctx_subst(next_lower_ctx)
                let callee_subst = if type_args == 0 { 0 } else {
                  let concrete_type_args = if outer_subst == 0 { type_args } else { type_list_subst(type_args, outer_subst) }
                  cg_build_subst(tparams, concrete_type_args)
                }
                let inline_env = pipeline_value_env_push_param_values(callee_params, pipeline_lowered_args_values(lowered_args), 0, arg_count, 0, pipeline_value_env_empty())
                let callee_ctx = pipeline_handler_lower_ctx_with_fns_subst(0, inline_env, fn_src, tt, next_ctx, fns, callee_subst)
                let body = pipeline_lower_expr_node_typed_sidecar_handler_ctx(callee_body, pipeline_lowered_args_next_value(lowered_args), callee_ctx)
                if ir_lowered_expr_is_valid(body) == 0 { ir_lowered_expr_invalid(next_value) }
                else {
                  ir_lowered_expr(
                    ir_lowered_expr_value(body),
                    ir_lowered_expr_next_value(body),
                    ir_inst_list_append(pipeline_lowered_args_insts(lowered_args), ir_lowered_expr_insts(body))
                  )
                }
              }
            }
          } }
        } }
      }
    } } }
  }
}

fn pipeline_handler_lower_ctx_with_fns_subst(params: i64, locals: PipelineValueEnv, src: i64, tt: i64, handlers: PipelineHandlerInlineCtx, fns: i64, subst: i64) -> PipelineHandlerLowerCtx {
  PipelineHandlerLowerCtx(params, locals, pipeline_lower_module_with_handlers(pipeline_lower_module_with_fns_subst(src, tt, fns, subst), handlers), fns)
}

fn pipeline_handler_lower_ctx_from_module(params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> PipelineHandlerLowerCtx {
  PipelineHandlerLowerCtx(params, locals, module, pipeline_lower_module_fns(module))
}

fn pipeline_handler_lower_ctx_with_subst(params: i64, locals: PipelineValueEnv, src: i64, tt: i64, handlers: PipelineHandlerInlineCtx, subst: i64) -> PipelineHandlerLowerCtx {
  pipeline_handler_lower_ctx_with_fns_subst(params, locals, src, tt, handlers, 0, subst)
}

fn pipeline_handler_lower_ctx(params: i64, locals: PipelineValueEnv, src: i64, tt: i64, handlers: PipelineHandlerInlineCtx) -> PipelineHandlerLowerCtx {
  pipeline_handler_lower_ctx_with_subst(params, locals, src, tt, handlers, 0)
}

fn pipeline_handler_lower_ctx_params(lower_ctx: PipelineHandlerLowerCtx) -> i64 {
  match lower_ctx {
    PipelineHandlerLowerCtx(params, locals, module, subst) -> params
  }
}

fn pipeline_handler_lower_ctx_locals(lower_ctx: PipelineHandlerLowerCtx) -> PipelineValueEnv {
  match lower_ctx {
    PipelineHandlerLowerCtx(params, locals, module, subst) -> locals
  }
}

fn pipeline_handler_lower_ctx_module(lower_ctx: PipelineHandlerLowerCtx) -> PipelineLowerModule {
  match lower_ctx {
    PipelineHandlerLowerCtx(params, locals, module, subst) -> module
  }
}

fn pipeline_handler_lower_ctx_src(lower_ctx: PipelineHandlerLowerCtx) -> i64 {
  pipeline_lower_module_src(pipeline_handler_lower_ctx_module(lower_ctx))
}

fn pipeline_handler_lower_ctx_tt(lower_ctx: PipelineHandlerLowerCtx) -> i64 {
  pipeline_lower_module_tt(pipeline_handler_lower_ctx_module(lower_ctx))
}

fn pipeline_handler_lower_ctx_handlers(lower_ctx: PipelineHandlerLowerCtx) -> PipelineHandlerInlineCtx {
  pipeline_lower_module_handlers(pipeline_handler_lower_ctx_module(lower_ctx))
}

fn pipeline_handler_lower_ctx_fns(lower_ctx: PipelineHandlerLowerCtx) -> i64 {
  match lower_ctx {
    PipelineHandlerLowerCtx(params, locals, module, fns) -> fns
  }
}

fn pipeline_handler_lower_ctx_subst(lower_ctx: PipelineHandlerLowerCtx) -> i64 {
  pipeline_lower_module_subst(pipeline_handler_lower_ctx_module(lower_ctx))
}

fn pipeline_handler_lower_ctx_par_ctx(lower_ctx: PipelineHandlerLowerCtx) -> PipelineParLowerCtx {
  pipeline_lower_module_par_ctx(pipeline_handler_lower_ctx_module(lower_ctx))
}

fn pipeline_fn_lower_ctx(handlers: PipelineHandlerInlineCtx, subst: i64, fns: i64) -> PipelineFnLowerCtx {
  PipelineFnLowerCtx(subst, fns, handlers)
}

fn pipeline_fn_lower_ctx_handlers(lower_ctx: PipelineFnLowerCtx) -> PipelineHandlerInlineCtx {
  match lower_ctx {
    PipelineFnLowerCtx(subst, fns, handlers) -> handlers
  }
}

fn pipeline_fn_lower_ctx_subst(lower_ctx: PipelineFnLowerCtx) -> i64 {
  match lower_ctx {
    PipelineFnLowerCtx(subst, fns, handlers) -> subst
  }
}

fn pipeline_fn_lower_ctx_fns(lower_ctx: PipelineFnLowerCtx) -> i64 {
  match lower_ctx {
    PipelineFnLowerCtx(subst, fns, handlers) -> fns
  }
}

fn pipeline_lower_ident_expr_typed_sidecar_handler_opt(ns: i64, nl: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, fns: i64, next_value: i64) -> IrLoweredExpr {
  let local_id = pipeline_value_env_lookup(locals, src, ns, nl)
  if local_id >= 0 {
    if pipeline_value_env_lookup_kind(locals, src, ns, nl) == 1 {
      let local_ty = pipeline_value_env_lookup_type_node(locals, src, ns, nl)
      let lanes = pipeline_type_value_lane_count_or_one(local_ty)
      ir_lowered_expr(
        next_value,
        next_value + lanes,
        pipeline_ir_slot_load_lane_insts(next_value, local_id, 0, lanes)
      )
    } else {
      ir_lowered_expr(local_id, next_value, ir_inst_list_empty())
    }
  } else {
    let param_id = if params == 0 { 0 - 1 } else { pipeline_param_index(params, src, ns, nl) }
    if param_id >= 0 {
      ir_lowered_expr(param_id, next_value, ir_inst_list_empty())
    } else {
      let tag_hash = pipeline_variant_tag_hash(tt, src, ns, nl)
      let payload_count = pipeline_variant_payload_count(tt, src, ns, nl)
      if tag_hash >= 0 {
        if payload_count == 0 {
          ir_lowered_expr(
            next_value,
            next_value + 1,
            ir_inst_list_prepend(ir_inst_variant_init_i64(next_value, tag_hash, ir_value_list_empty(), 0), ir_inst_list_empty())
          )
        } else {
          ir_lowered_expr_invalid(next_value)
        }
      } else {
        let fn_hash = str_hash(src, ns, nl)
        if pipeline_fns_contains_hash(fns, fn_hash) == 1 {
          ir_lowered_expr(
            next_value,
            next_value + 1,
            ir_inst_list_prepend(ir_inst_function_ref_i64(next_value, fn_hash), ir_inst_list_empty())
          )
        } else {
          ir_lowered_expr_invalid(next_value)
        }
      }
    }
  }
}

fn pipeline_lower_typed_handler_opt_args(args: ExprList, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> PipelineLoweredArgs {
  pipeline_lower_typed_handler_opt_args_expected(args, 0, next_value, lower_ctx, 0, 0, 0)
}

fn pipeline_lower_typed_handler_opt_args_expected(args: ExprList, index: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx, expected_params: i64, expected_types: i64, expected_subst: i64) -> PipelineLoweredArgs {
  pipeline_lower_typed_handler_opt_args_expected_borrow_mask(args, index, next_value, lower_ctx, expected_params, expected_types, expected_subst, 0)
}

fn pipeline_lower_typed_handler_opt_args_expected_borrow_mask(args: ExprList, index: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx, expected_params: i64, expected_types: i64, expected_subst: i64, borrowed_mask: i64) -> PipelineLoweredArgs {
  match args {
    ExprListNil -> pipeline_lowered_args(ir_value_list_empty(), next_value, ir_inst_list_empty(), 1)
    ExprListCons(expr, rest_exprs) -> {
      let params = pipeline_handler_lower_ctx_params(lower_ctx)
      let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
      let src = pipeline_handler_lower_ctx_src(lower_ctx)
      let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
      let handlers = pipeline_handler_lower_ctx_handlers(lower_ctx)
      let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
      let expected_float = pipeline_expected_arg_float_prim(expected_params, expected_types, index, 0, expected_subst)
      let expected_int = if expected_float == 0 { pipeline_expected_arg_int_prim(expected_params, expected_types, index, 0, expected_subst) } else { 0 - 1 }
      let expected_prim = if expected_float == PRIM_F32() or expected_float == PRIM_F64() { expected_float } else { expected_int }
      let expected_ty = pipeline_expected_arg_type_node(expected_params, expected_types, index, 0, expected_subst)
      let retain_ty = if cg_mask_has(borrowed_mask, index) == 1 { 0 } else { expected_ty }
      let arg = if pipeline_prim_is_forced_numeric_context(expected_prim) == 1 {
        pipeline_lower_expr_typed_sidecar_handler_opt_with_float_prim(expr, next_value, lower_ctx, expected_prim)
      } else {
        pipeline_lower_expr_typed_sidecar_handler_ctx(expr, next_value, lower_ctx)
      }
      if ir_lowered_expr_is_valid(arg) == 1 {
        let retain = pipeline_managed_borrow_retain_arg_typed(expr, ir_lowered_expr_value(arg), retain_ty, ir_lowered_expr_next_value(arg), src, pipeline_handler_lower_ctx_fns(lower_ctx), expected_subst, pipeline_handler_lower_ctx_tt(lower_ctx))
        let rest = pipeline_lower_typed_handler_opt_args_expected_borrow_mask(rest_exprs, index + 1, pipeline_lowered_args_next_value(retain), lower_ctx, expected_params, expected_types, expected_subst, borrowed_mask)
        if pipeline_lowered_args_is_valid(rest) == 1 {
          let values = ir_value_list_prepend(ir_lowered_expr_value(arg), pipeline_lowered_args_values(rest))
          let insts = ir_inst_list_append(ir_lowered_expr_insts(arg), ir_inst_list_append(pipeline_lowered_args_insts(retain), pipeline_lowered_args_insts(rest)))
          pipeline_lowered_args(values, pipeline_lowered_args_next_value(rest), insts, 1)
        } else {
          pipeline_lowered_args_invalid(next_value)
        }
      } else {
        pipeline_lowered_args_invalid(next_value)
      }
    }
  }
}

fn pipeline_lower_typed_method_handler_opt_args_expected(args: ExprList, index: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx, method_params: i64, expected_subst: i64, borrowed_mask: i64) -> PipelineLoweredArgs {
  match args {
    ExprListNil -> pipeline_lowered_args(ir_value_list_empty(), next_value, ir_inst_list_empty(), 1)
    ExprListCons(expr, rest_exprs) -> {
      let expected_float = pipeline_param_float_prim_at(method_params, index + 1, expected_subst)
      let expected_int = if expected_float == 0 { pipeline_param_int_prim_at(method_params, index + 1, expected_subst) } else { 0 - 1 }
      let expected_prim = if expected_float == PRIM_F32() or expected_float == PRIM_F64() { expected_float } else { expected_int }
      let expected_ty = pipeline_expected_arg_type_node(method_params, 0, index, 1, expected_subst)
      let retain_ty = if cg_mask_has(borrowed_mask, index + 1) == 1 { 0 } else { expected_ty }
      let arg = if pipeline_prim_is_forced_numeric_context(expected_prim) == 1 {
        pipeline_lower_expr_typed_sidecar_handler_opt_with_float_prim(expr, next_value, lower_ctx, expected_prim)
      } else {
        pipeline_lower_expr_typed_sidecar_handler_ctx(expr, next_value, lower_ctx)
      }
      if ir_lowered_expr_is_valid(arg) == 1 {
        let retain = pipeline_managed_borrow_retain_arg_typed(expr, ir_lowered_expr_value(arg), retain_ty, ir_lowered_expr_next_value(arg), pipeline_handler_lower_ctx_src(lower_ctx), pipeline_handler_lower_ctx_fns(lower_ctx), expected_subst, pipeline_handler_lower_ctx_tt(lower_ctx))
        let rest = pipeline_lower_typed_method_handler_opt_args_expected(rest_exprs, index + 1, pipeline_lowered_args_next_value(retain), lower_ctx, method_params, expected_subst, borrowed_mask)
        if pipeline_lowered_args_is_valid(rest) == 1 {
          let values = ir_value_list_prepend(ir_lowered_expr_value(arg), pipeline_lowered_args_values(rest))
          let insts = ir_inst_list_append(ir_lowered_expr_insts(arg), ir_inst_list_append(pipeline_lowered_args_insts(retain), pipeline_lowered_args_insts(rest)))
          pipeline_lowered_args(values, pipeline_lowered_args_next_value(rest), insts, 1)
        } else {
          pipeline_lowered_args_invalid(next_value)
        }
      } else {
        pipeline_lowered_args_invalid(next_value)
      }
    }
  }
}

type PipelineScaledRawAddress {
  PipelineScaledRawAddress(i64, Expr, Expr, i64)
}

type PipelineScaledRawIndex {
  PipelineScaledRawIndex(i64, Expr)
}

fn pipeline_scaled_raw_address(valid: i64, first: Expr, second: Expr, first_is_base: i64) -> PipelineScaledRawAddress {
  PipelineScaledRawAddress(valid, first, second, first_is_base)
}

fn pipeline_scaled_raw_address_invalid() -> PipelineScaledRawAddress {
  PipelineScaledRawAddress(0, NilExpr, NilExpr, 0)
}

fn pipeline_scaled_raw_address_valid(mode: PipelineScaledRawAddress) -> i64 {
  match mode {
    PipelineScaledRawAddress(valid, first, second, first_is_base) -> valid
  }
}

fn pipeline_scaled_raw_address_first(mode: PipelineScaledRawAddress) -> Expr {
  match mode {
    PipelineScaledRawAddress(valid, first, second, first_is_base) -> first
  }
}

fn pipeline_scaled_raw_address_second(mode: PipelineScaledRawAddress) -> Expr {
  match mode {
    PipelineScaledRawAddress(valid, first, second, first_is_base) -> second
  }
}

fn pipeline_scaled_raw_address_first_is_base(mode: PipelineScaledRawAddress) -> i64 {
  match mode {
    PipelineScaledRawAddress(valid, first, second, first_is_base) -> first_is_base
  }
}

fn pipeline_scaled_raw_index(valid: i64, index: Expr) -> PipelineScaledRawIndex {
  PipelineScaledRawIndex(valid, index)
}

fn pipeline_scaled_raw_index_invalid() -> PipelineScaledRawIndex {
  PipelineScaledRawIndex(0, NilExpr)
}

fn pipeline_scaled_raw_index_valid(mode: PipelineScaledRawIndex) -> i64 {
  match mode {
    PipelineScaledRawIndex(valid, index) -> valid
  }
}

fn pipeline_scaled_raw_index_expr(mode: PipelineScaledRawIndex) -> Expr {
  match mode {
    PipelineScaledRawIndex(valid, index) -> index
  }
}

fn pipeline_expr_strip_typed(expr: Expr) -> Expr {
  match expr {
    LetTyped(inner, ann_type) -> pipeline_expr_strip_typed(inner)
    _ -> expr
  }
}

fn pipeline_expr_is_int_lit(expr: Expr, value: i64) -> i64 {
  match pipeline_expr_strip_typed(expr) {
    IntLit(v, start, len) -> if v == value { 1 } else { 0 }
    _ -> 0
  }
}

fn pipeline_scaled_raw_index_from_expr(expr: Expr) -> PipelineScaledRawIndex {
  match pipeline_expr_strip_typed(expr) {
    BinOp(op, lhs, rhs) -> {
      if op == 3 and pipeline_expr_is_int_lit(rhs, 8) == 1 {
        pipeline_scaled_raw_index(1, lhs)
      } else {
        if op == 3 and pipeline_expr_is_int_lit(lhs, 8) == 1 {
          pipeline_scaled_raw_index(1, rhs)
        } else {
          pipeline_scaled_raw_index_invalid()
        }
      }
    }
    _ -> pipeline_scaled_raw_index_invalid()
  }
}

fn pipeline_scaled_raw_address_from_expr(expr: Expr) -> PipelineScaledRawAddress {
  match pipeline_expr_strip_typed(expr) {
    BinOp(op, lhs, rhs) -> {
      if op == 1 {
        let left_index = pipeline_scaled_raw_index_from_expr(lhs)
        if pipeline_scaled_raw_index_valid(left_index) == 1 {
          pipeline_scaled_raw_address(1, pipeline_scaled_raw_index_expr(left_index), rhs, 0)
        } else {
          let right_index = pipeline_scaled_raw_index_from_expr(rhs)
          if pipeline_scaled_raw_index_valid(right_index) == 1 {
            pipeline_scaled_raw_address(1, lhs, pipeline_scaled_raw_index_expr(right_index), 1)
          } else {
            pipeline_scaled_raw_address_invalid()
          }
        }
      } else {
        pipeline_scaled_raw_address_invalid()
      }
    }
    _ -> pipeline_scaled_raw_address_invalid()
  }
}

fn pipeline_expr_list_nth_or(exprs: ExprList, index: i64, default: Expr) -> Expr {
  match exprs {
    ExprListNil -> default
    ExprListCons(expr, rest) -> {
      if index == 0 { expr } else { pipeline_expr_list_nth_or(rest, index - 1, default) }
    }
  }
}

fn pipeline_ir_pseudo_scaled_load64_hash() -> i64 { 0 - 700001 }
fn pipeline_ir_pseudo_scaled_store64_hash() -> i64 { 0 - 700002 }
fn pipeline_ir_pseudo_scaled_store64_discard_hash() -> i64 { 0 - 700003 }
fn pipeline_ir_pseudo_bridge_load64_hash() -> i64 { 0 - 700004 }
fn pipeline_ir_pseudo_bridge_store64_hash() -> i64 { 0 - 700005 }
fn pipeline_ir_pseudo_bridge_store64_discard_hash() -> i64 { 0 - 700006 }
fn pipeline_ir_pseudo_bridge_load8_hash() -> i64 { 0 - 700007 }
fn pipeline_ir_pseudo_bridge_store8_hash() -> i64 { 0 - 700008 }
fn pipeline_ir_pseudo_bridge_store8_discard_hash() -> i64 { 0 - 700009 }
fn pipeline_ir_pseudo_par_lowering_marker_hash() -> i64 { 0 - 700020 }

fn pipeline_par_sequential_submit_hash() -> i64 { str_hash(__str_ptr("par_sequential_submit"), 0, __str_len("par_sequential_submit")) }
fn pipeline_par_task_await_hash() -> i64 { str_hash(__str_ptr("par_task_await"), 0, __str_len("par_task_await")) }
fn pipeline_par_pthread_pool_start_hash() -> i64 { str_hash(__str_ptr("par_pthread_pool_start"), 0, __str_len("par_pthread_pool_start")) }
fn pipeline_par_pthread_pool_submit_prepared_hash() -> i64 { str_hash(__str_ptr("par_pthread_pool_submit_prepared"), 0, __str_len("par_pthread_pool_submit_prepared")) }
fn pipeline_par_pthread_pool_await_hash() -> i64 { str_hash(__str_ptr("par_pthread_pool_await"), 0, __str_len("par_pthread_pool_await")) }
fn pipeline_par_pthread_pool_shutdown_hash() -> i64 { str_hash(__str_ptr("par_pthread_pool_shutdown"), 0, __str_len("par_pthread_pool_shutdown")) }
fn pipeline_par_sequential_map_i64_hash() -> i64 { str_hash(__str_ptr("par_sequential_map_i64"), 0, __str_len("par_sequential_map_i64")) }
fn pipeline_par_pthread_pool_map_scoped_i64_hash() -> i64 { str_hash(__str_ptr("par_pthread_pool_map_scoped_i64"), 0, __str_len("par_pthread_pool_map_scoped_i64")) }
fn pipeline_closure_default_promote_hash() -> i64 { str_hash(__str_ptr("closure_default_promote"), 0, __str_len("closure_default_promote")) }
fn pipeline_rc_default_promote_maybe_hash() -> i64 { str_hash(__str_ptr("rc_default_promote_maybe"), 0, __str_len("rc_default_promote_maybe")) }

fn pipeline_bridge_mem_load64_at_hash() -> i64 { 6169231631054115263 }
fn pipeline_bridge_mem_store64_at_hash() -> i64 { 670126484967890450 }
fn pipeline_bridge_mem_load8_at_hash() -> i64 { 2981907636351453137 }
fn pipeline_bridge_mem_store8_at_hash() -> i64 { 6169221554417243588 }
fn pipeline_bridge_mem_load64_hash() -> i64 { str_hash(__str_ptr("mem_load64"), 0, __str_len("mem_load64")) }
fn pipeline_bridge_mem_store64_hash() -> i64 { str_hash(__str_ptr("mem_store64"), 0, __str_len("mem_store64")) }
fn pipeline_bridge_mem_load8_hash() -> i64 { str_hash(__str_ptr("mem_load8"), 0, __str_len("mem_load8")) }
fn pipeline_bridge_mem_store8_hash() -> i64 { str_hash(__str_ptr("mem_store8"), 0, __str_len("mem_store8")) }

fn pipeline_bridge_mem_kind_by_hash(callee_hash: i64, arity: i64) -> i64 {
  if arity == 2 and callee_hash == pipeline_bridge_mem_load64_at_hash() { 1 }
  else { if arity == 3 and callee_hash == pipeline_bridge_mem_store64_at_hash() { 2 }
  else { if arity == 2 and callee_hash == pipeline_bridge_mem_load8_at_hash() { 3 }
  else { if arity == 3 and callee_hash == pipeline_bridge_mem_store8_at_hash() { 4 }
  else { if arity == 1 and callee_hash == pipeline_bridge_mem_load64_hash() { 5 }
  else { if arity == 2 and callee_hash == pipeline_bridge_mem_store64_hash() { 6 }
  else { if arity == 1 and callee_hash == pipeline_bridge_mem_load8_hash() { 7 }
  else { if arity == 2 and callee_hash == pipeline_bridge_mem_store8_hash() { 8 } else { 0 } } } } } } } }
}

fn pipeline_bridge_mem_kind(src: i64, ns: i64, nl: i64, arity: i64) -> i64 {
  pipeline_bridge_mem_kind_by_hash(str_hash(src, ns, nl), arity)
}

fn pipeline_ir_bridge_mem_pseudo_hash(kind: i64) -> i64 {
  if kind == 1 or kind == 5 { pipeline_ir_pseudo_bridge_load64_hash() }
  else { if kind == 2 or kind == 6 { pipeline_ir_pseudo_bridge_store64_hash() }
  else { if kind == 3 or kind == 7 { pipeline_ir_pseudo_bridge_load8_hash() }
  else { if kind == 4 or kind == 8 { pipeline_ir_pseudo_bridge_store8_hash() } else { 0 } } } }
}

fn pipeline_bridge_mem_kind_is_load(kind: i64) -> i64 {
  kind == 1 or kind == 3 or kind == 5 or kind == 7
}

fn pipeline_bridge_mem_kind_is_indexed(kind: i64) -> i64 {
  kind >= 1 and kind <= 4
}

fn pipeline_ir_bridge_mem_call_args(kind: i64, addr: i64, values: IrValueList) -> IrValueList {
  if pipeline_bridge_mem_kind_is_load(kind) == 1 {
    ir_value_list_prepend(addr, ir_value_list_empty())
  } else {
    let value_index = if pipeline_bridge_mem_kind_is_indexed(kind) == 1 { 2 } else { 1 }
    ir_value_list_prepend(addr, ir_value_list_prepend(pipeline_ir_value_list_get_or(values, value_index, 0 - 1), ir_value_list_empty()))
  }
}

fn pipeline_lower_bridge_mem_from_values(kind: i64, lowered_args: PipelineLoweredArgs) -> IrLoweredExpr {
  if pipeline_lowered_args_is_valid(lowered_args) == 1 and kind != 0 {
    let values = pipeline_lowered_args_values(lowered_args)
    let base = pipeline_ir_value_list_get_or(values, 0, 0 - 1)
    let index = pipeline_ir_value_list_get_or(values, 1, 0 - 1)
    let indexed = pipeline_bridge_mem_kind_is_indexed(kind)
    let addr = if indexed == 1 { pipeline_lowered_args_next_value(lowered_args) } else { base }
    let call_dst = if indexed == 1 { addr + 1 } else { pipeline_lowered_args_next_value(lowered_args) }
    let pseudo_hash = pipeline_ir_bridge_mem_pseudo_hash(kind)
    let addr_inst = ir_inst_list_prepend(ir_inst_binary_i64(addr, ir_binary_op_add(), base, index), ir_inst_list_empty())
    let call_values = pipeline_ir_bridge_mem_call_args(kind, addr, values)
    let call_inst = ir_inst_list_prepend(ir_inst_call_i64(call_dst, pseudo_hash, call_values), ir_inst_list_empty())
    let bridge_insts = if indexed == 1 { ir_inst_list_append(addr_inst, call_inst) } else { call_inst }
    if pipeline_bridge_mem_kind_is_load(kind) == 1 {
      ir_lowered_expr(call_dst, call_dst + 1, ir_inst_list_append(pipeline_lowered_args_insts(lowered_args), bridge_insts))
    } else {
      let result = call_dst + 1
      let result_inst = ir_inst_list_prepend(ir_inst_const_i64(result, 0), ir_inst_list_empty())
      ir_lowered_expr(result, result + 1, ir_inst_list_append(pipeline_lowered_args_insts(lowered_args), ir_inst_list_append(bridge_insts, result_inst)))
    }
  } else {
    ir_lowered_expr_invalid(pipeline_lowered_args_next_value(lowered_args))
  }
}

fn pipeline_lower_scaled_raw_first_second(first: Expr, second: Expr, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> PipelineLoweredArgs {
  let first_lowered = pipeline_lower_expr_typed_sidecar_handler_ctx(first, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(first_lowered) == 1 {
    let second_lowered = pipeline_lower_expr_typed_sidecar_handler_ctx(second, ir_lowered_expr_next_value(first_lowered), lower_ctx)
    if ir_lowered_expr_is_valid(second_lowered) == 1 {
      pipeline_lowered_args(
        ir_value_list_prepend(ir_lowered_expr_value(first_lowered), ir_value_list_prepend(ir_lowered_expr_value(second_lowered), ir_value_list_empty())),
        ir_lowered_expr_next_value(second_lowered),
        ir_inst_list_append(ir_lowered_expr_insts(first_lowered), ir_lowered_expr_insts(second_lowered)),
        1
      )
    } else {
      pipeline_lowered_args_invalid(next_value)
    }
  } else {
    pipeline_lowered_args_invalid(next_value)
  }
}

fn pipeline_lower_scaled_raw_call_typed(callee_hash: i64, args_expr: ExprList, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let kind = pipeline_ir_native_intrinsic_kind(callee_hash)
  if kind == 4 and expr_list_len(args_expr) == 1 {
    let addr_mode = pipeline_scaled_raw_address_from_expr(pipeline_expr_list_nth_or(args_expr, 0, NilExpr))
    if pipeline_scaled_raw_address_valid(addr_mode) == 1 {
      let lowered = pipeline_lower_scaled_raw_first_second(pipeline_scaled_raw_address_first(addr_mode), pipeline_scaled_raw_address_second(addr_mode), next_value, lower_ctx)
      if pipeline_lowered_args_is_valid(lowered) == 1 {
        let first_value = pipeline_ir_value_list_get_or(pipeline_lowered_args_values(lowered), 0, 0 - 1)
        let second_value = pipeline_ir_value_list_get_or(pipeline_lowered_args_values(lowered), 1, 0 - 1)
        let base = if pipeline_scaled_raw_address_first_is_base(addr_mode) == 1 { first_value } else { second_value }
        let index = if pipeline_scaled_raw_address_first_is_base(addr_mode) == 1 { second_value } else { first_value }
        let dst = pipeline_lowered_args_next_value(lowered)
        let call_args = ir_value_list_prepend(base, ir_value_list_prepend(index, ir_value_list_empty()))
        let call = ir_inst_list_prepend(ir_inst_call_i64(dst, pipeline_ir_pseudo_scaled_load64_hash(), call_args), ir_inst_list_empty())
        ir_lowered_expr(dst, dst + 1, ir_inst_list_append(pipeline_lowered_args_insts(lowered), call))
      } else {
        ir_lowered_expr_invalid(next_value)
      }
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    if kind == 2 and expr_list_len(args_expr) == 2 {
      let addr_mode = pipeline_scaled_raw_address_from_expr(pipeline_expr_list_nth_or(args_expr, 0, NilExpr))
      if pipeline_scaled_raw_address_valid(addr_mode) == 1 {
        let lowered_addr = pipeline_lower_scaled_raw_first_second(pipeline_scaled_raw_address_first(addr_mode), pipeline_scaled_raw_address_second(addr_mode), next_value, lower_ctx)
        if pipeline_lowered_args_is_valid(lowered_addr) == 1 {
          let value_expr = pipeline_expr_list_nth_or(args_expr, 1, NilExpr)
          let lowered_value = pipeline_lower_expr_typed_sidecar_handler_ctx(value_expr, pipeline_lowered_args_next_value(lowered_addr), lower_ctx)
          if ir_lowered_expr_is_valid(lowered_value) == 1 {
            let first_value = pipeline_ir_value_list_get_or(pipeline_lowered_args_values(lowered_addr), 0, 0 - 1)
            let second_value = pipeline_ir_value_list_get_or(pipeline_lowered_args_values(lowered_addr), 1, 0 - 1)
            let base = if pipeline_scaled_raw_address_first_is_base(addr_mode) == 1 { first_value } else { second_value }
            let index = if pipeline_scaled_raw_address_first_is_base(addr_mode) == 1 { second_value } else { first_value }
            let dst = ir_lowered_expr_next_value(lowered_value)
            let call_args = ir_value_list_prepend(base, ir_value_list_prepend(index, ir_value_list_prepend(ir_lowered_expr_value(lowered_value), ir_value_list_empty())))
            let call = ir_inst_list_prepend(ir_inst_call_i64(dst, pipeline_ir_pseudo_scaled_store64_hash(), call_args), ir_inst_list_empty())
            ir_lowered_expr(dst, dst + 1, ir_inst_list_append(pipeline_lowered_args_insts(lowered_addr), ir_inst_list_append(ir_lowered_expr_insts(lowered_value), call)))
          } else {
            ir_lowered_expr_invalid(next_value)
          }
        } else {
          ir_lowered_expr_invalid(next_value)
        }
      } else {
        ir_lowered_expr_invalid(next_value)
      }
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  }
}

fn pipeline_lower_bridge_mem_call_typed(src: i64, ns: i64, nl: i64, args_expr: ExprList, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let kind = pipeline_bridge_mem_kind(src, ns, nl, expr_list_len(args_expr))
  if kind == 0 {
    ir_lowered_expr_invalid(next_value)
  } else {
    let args = pipeline_lower_typed_handler_opt_args(args_expr, next_value, lower_ctx)
    pipeline_lower_bridge_mem_from_values(kind, args)
  }
}

fn pipeline_lower_native_intrinsic_call_typed(callee_hash: i64, args_expr: ExprList, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let kind = pipeline_ir_native_intrinsic_kind(callee_hash)
  let arity = pipeline_ir_native_intrinsic_arity(kind)
  let arg_count = expr_list_len(args_expr)
  if kind == 0 or arity != arg_count {
    ir_lowered_expr_invalid(next_value)
  } else {
    if kind == 4 {
      let ptr_expr = pipeline_expr_list_nth_or(args_expr, 0, NilExpr)
      let ptr = pipeline_lower_expr_typed_sidecar_handler_ctx(ptr_expr, next_value, lower_ctx)
      if ir_lowered_expr_is_valid(ptr) == 1 {
        let dst = ir_lowered_expr_next_value(ptr)
        let inst = ir_inst_list_prepend(ir_inst_ptr_load_i64(dst, ir_lowered_expr_value(ptr)), ir_inst_list_empty())
        ir_lowered_expr(dst, dst + 1, ir_inst_list_append(ir_lowered_expr_insts(ptr), inst))
      } else {
        ir_lowered_expr_invalid(next_value)
      }
    } else {
      if kind == 2 {
        let ptr_expr = pipeline_expr_list_nth_or(args_expr, 0, NilExpr)
        let value_expr = pipeline_expr_list_nth_or(args_expr, 1, NilExpr)
        let ptr = pipeline_lower_expr_typed_sidecar_handler_ctx(ptr_expr, next_value, lower_ctx)
        if ir_lowered_expr_is_valid(ptr) == 1 {
          let value = pipeline_lower_expr_typed_sidecar_handler_ctx(value_expr, ir_lowered_expr_next_value(ptr), lower_ctx)
          if ir_lowered_expr_is_valid(value) == 1 {
            let store_dst = ir_lowered_expr_next_value(value)
            let store = ir_inst_list_prepend(ir_inst_ptr_store_i64(store_dst, ir_lowered_expr_value(ptr), ir_lowered_expr_value(value)), ir_inst_list_empty())
            let insts = ir_inst_list_append(ir_lowered_expr_insts(ptr), ir_inst_list_append(ir_lowered_expr_insts(value), store))
            ir_lowered_expr(ir_lowered_expr_value(value), store_dst + 1, insts)
          } else {
            ir_lowered_expr_invalid(next_value)
          }
        } else {
          ir_lowered_expr_invalid(next_value)
        }
      } else {
        let args = pipeline_lower_typed_handler_opt_args(args_expr, next_value, lower_ctx)
        if pipeline_lowered_args_is_valid(args) == 1 {
          let dst = pipeline_lowered_args_next_value(args)
          let call = ir_inst_list_prepend(ir_inst_call_i64(dst, callee_hash, pipeline_lowered_args_values(args)), ir_inst_list_empty())
          ir_lowered_expr(dst, dst + 1, ir_inst_list_append(pipeline_lowered_args_insts(args), call))
        } else {
          ir_lowered_expr_invalid(next_value)
        }
      }
    }
  }
}

fn pipeline_scaled_raw_arg_nodes_for_call(callee_hash: i64, expr: i64) -> i64 {
  let kind = pipeline_ir_native_intrinsic_kind(callee_hash)
  if kind == 4 and node_f4(expr) == 1 {
    let addr_mode = pipeline_scaled_raw_address_from_expr(expr_from_node(nlist_get(node_f3(expr), 0)))
    if pipeline_scaled_raw_address_valid(addr_mode) == 1 {
      let args = nlist_new()
      nlist_add(args, expr_to_node(pipeline_scaled_raw_address_first(addr_mode)))
      nlist_add(args, expr_to_node(pipeline_scaled_raw_address_second(addr_mode)))
      args
    } else { 0 }
  } else {
    if kind == 2 and node_f4(expr) == 2 {
      let addr_mode = pipeline_scaled_raw_address_from_expr(expr_from_node(nlist_get(node_f3(expr), 0)))
      if pipeline_scaled_raw_address_valid(addr_mode) == 1 {
        let args = nlist_new()
        nlist_add(args, expr_to_node(pipeline_scaled_raw_address_first(addr_mode)))
        nlist_add(args, expr_to_node(pipeline_scaled_raw_address_second(addr_mode)))
        nlist_add(args, nlist_get(node_f3(expr), 1))
        args
      } else { 0 }
    } else { 0 }
  }
}

fn pipeline_lower_scaled_raw_call_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let callee_hash = str_hash(src, node_f1(expr), node_f2(expr))
  let kind = pipeline_ir_native_intrinsic_kind(callee_hash)
  let raw_args = pipeline_scaled_raw_arg_nodes_for_call(callee_hash, expr)
  if raw_args == 0 {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  } else {
    let call_block = next_block
    let arg_count = nlist_len(raw_args)
    let first_arg_block = pipeline_lower_operation_child_start_block(call_block, arg_count)
    let ctx = pipeline_call_arg_ctx_with_fns(raw_args, arg_count, params, locals, src, tt, call_block, pipeline_lower_module_fns(module))
    let lowered_args = pipeline_lower_call_arg_blocks(ctx, 0, next_value, first_arg_block, ir_value_list_empty())
    if pipeline_lowered_call_blocks_is_valid(lowered_args) == 1 {
      let entry = ir_block_new_term(start_block, ir_inst_list_empty(), ir_term_jump(first_arg_block))
      if pipeline_lowered_call_blocks_falls_through(lowered_args) == 0 {
        let blocks = ir_block_list_prepend(entry, pipeline_lowered_call_blocks_blocks(lowered_args))
        pipeline_lowered_blocks_control(
          pipeline_lowered_call_blocks_next_block(lowered_args),
          pipeline_lowered_call_blocks_next_value(lowered_args),
          blocks,
          1,
          0
        )
      } else {
        let call_dst = pipeline_lowered_call_blocks_next_value(lowered_args)
        let addr_mode = pipeline_scaled_raw_address_from_expr(expr_from_node(nlist_get(node_f3(expr), 0)))
        let first_value = pipeline_ir_value_list_get_or(pipeline_lowered_call_blocks_values(lowered_args), 0, 0 - 1)
        let second_value = pipeline_ir_value_list_get_or(pipeline_lowered_call_blocks_values(lowered_args), 1, 0 - 1)
        let base = if pipeline_scaled_raw_address_first_is_base(addr_mode) == 1 { first_value } else { second_value }
        let index = if pipeline_scaled_raw_address_first_is_base(addr_mode) == 1 { second_value } else { first_value }
        let pseudo_hash = if kind == 4 { pipeline_ir_pseudo_scaled_load64_hash() } else { pipeline_ir_pseudo_scaled_store64_hash() }
        let call_values = if kind == 4 {
          ir_value_list_prepend(base, ir_value_list_prepend(index, ir_value_list_empty()))
        } else {
          ir_value_list_prepend(base, ir_value_list_prepend(index, ir_value_list_prepend(pipeline_ir_value_list_get_or(pipeline_lowered_call_blocks_values(lowered_args), 2, 0 - 1), ir_value_list_empty())))
        }
        let call_inst = ir_inst_list_prepend(ir_inst_call_i64(call_dst, pseudo_hash, call_values), ir_inst_list_empty())
        let call_args = ir_value_list_prepend(call_dst, ir_value_list_empty())
        let call = ir_block_new_term(call_block, call_inst, ir_term_jump_args(target_block, call_args))
        let blocks = ir_block_list_prepend(
          entry,
          ir_block_list_append(pipeline_lowered_call_blocks_blocks(lowered_args), ir_block_list_prepend(call, ir_block_list_empty()))
        )
        pipeline_lowered_blocks(pipeline_lowered_call_blocks_next_block(lowered_args), call_dst + 1, blocks, 1)
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  }
}

fn pipeline_lower_bridge_mem_call_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let direct = pipeline_call_callee_is_direct(params, locals, src, node_f1(expr), node_f2(expr))
  let kind = if direct == 1 { pipeline_bridge_mem_kind_by_hash(str_hash(src, node_f1(expr), node_f2(expr)), node_f4(expr)) } else { 0 }
  if kind == 0 {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  } else {
    let call_block = next_block
    let arg_count = node_f4(expr)
    let first_arg_block = pipeline_lower_operation_child_start_block(call_block, arg_count)
    let ctx = pipeline_call_arg_ctx_with_fns(node_f3(expr), arg_count, params, locals, src, tt, call_block, pipeline_lower_module_fns(module))
    let lowered_args = pipeline_lower_call_arg_blocks(ctx, 0, next_value, first_arg_block, ir_value_list_empty())
    if pipeline_lowered_call_blocks_is_valid(lowered_args) == 1 {
      let entry = ir_block_new_term(start_block, ir_inst_list_empty(), ir_term_jump(first_arg_block))
      if pipeline_lowered_call_blocks_falls_through(lowered_args) == 0 {
        let blocks = ir_block_list_prepend(entry, pipeline_lowered_call_blocks_blocks(lowered_args))
        pipeline_lowered_blocks_control(
          pipeline_lowered_call_blocks_next_block(lowered_args),
          pipeline_lowered_call_blocks_next_value(lowered_args),
          blocks,
          1,
          0
        )
      } else {
        let values = pipeline_lowered_call_blocks_values(lowered_args)
        let base = pipeline_ir_value_list_get_or(values, 0, 0 - 1)
        let index = pipeline_ir_value_list_get_or(values, 1, 0 - 1)
        let addr = pipeline_lowered_call_blocks_next_value(lowered_args)
        let call_dst = addr + 1
        let pseudo_hash = pipeline_ir_bridge_mem_pseudo_hash(kind)
        let addr_inst = ir_inst_list_prepend(ir_inst_binary_i64(addr, ir_binary_op_add(), base, index), ir_inst_list_empty())
        let call_values = pipeline_ir_bridge_mem_call_args(kind, addr, values)
        let call_inst = ir_inst_list_prepend(ir_inst_call_i64(call_dst, pseudo_hash, call_values), ir_inst_list_empty())
        let call_insts = if kind == 1 or kind == 3 {
          ir_inst_list_append(addr_inst, call_inst)
        } else {
          let result = call_dst + 1
          ir_inst_list_append(addr_inst, ir_inst_list_append(call_inst, ir_inst_list_prepend(ir_inst_const_i64(result, 0), ir_inst_list_empty())))
        }
        let result_value = if kind == 1 or kind == 3 { call_dst } else { call_dst + 1 }
        let call_args = ir_value_list_prepend(result_value, ir_value_list_empty())
        let call = ir_block_new_term(call_block, call_insts, ir_term_jump_args(target_block, call_args))
        let blocks = ir_block_list_prepend(
          entry,
          ir_block_list_append(pipeline_lowered_call_blocks_blocks(lowered_args), ir_block_list_prepend(call, ir_block_list_empty()))
        )
        pipeline_lowered_blocks(pipeline_lowered_call_blocks_next_block(lowered_args), result_value + 1, blocks, 1)
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  }
}

fn pipeline_lower_weak_call_expr_typed_sidecar_handler_opt(src: i64, ns: i64, nl: i64, args_expr: ExprList, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let arg_count = expr_list_len(args_expr)
  if arg_count != 1 {
    ir_lowered_expr_invalid(next_value)
  } else {
    if src_eq(src, ns, nl, "weak_ref") == 1 or src_eq(src, ns, nl, "weak_load") == 1 {
      let value_expr = pipeline_expr_list_nth_or(args_expr, 0, NilExpr)
      let value = pipeline_lower_expr_typed_sidecar_handler_ctx(value_expr, next_value, lower_ctx)
      if ir_lowered_expr_is_valid(value) == 1 {
        let dst = ir_lowered_expr_next_value(value)
        let runtime_hash = if src_eq(src, ns, nl, "weak_ref") == 1 { pipeline_rc_default_weak_retain_hash() } else { pipeline_rc_default_weak_load_hash() }
        let runtime_args = ir_value_list_prepend(ir_lowered_expr_value(value), ir_value_list_empty())
        let call = ir_inst_list_prepend(ir_inst_call_i64(dst, runtime_hash, runtime_args), ir_inst_list_empty())
        let result_value = if src_eq(src, ns, nl, "weak_ref") == 1 { ir_lowered_expr_value(value) } else { dst }
        let insts = ir_inst_list_append(ir_lowered_expr_insts(value), call)
        ir_lowered_expr(result_value, dst + 1, insts)
      } else {
        ir_lowered_expr_invalid(next_value)
      }
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  }
}

fn pipeline_lower_call_expr_typed_sidecar_handler_opt(ns: i64, nl: i64, args_expr: ExprList, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let fns = pipeline_handler_lower_ctx_fns(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  let direct = pipeline_call_callee_is_direct(params, locals, src, ns, nl)
  let callee_value = pipeline_call_callee_value(params, locals, src, ns, nl)
  let callee_slot = pipeline_call_callee_slot(locals, src, ns, nl)
  let callee_type_node = pipeline_call_callee_type_node(params, locals, src, ns, nl, subst)
  let indirect_expected_types = pipeline_call_indirect_expected_types(direct, callee_type_node)
  let weak = pipeline_lower_weak_call_expr_typed_sidecar_handler_opt(src, ns, nl, args_expr, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(weak) == 1 {
    weak
  } else {
  let pure_inline = if direct == 1 and subst == 0 { pipeline_lower_pure_call_inline_sidecar(ns, nl, args_expr, next_value, lower_ctx) } else { ir_lowered_expr_invalid(next_value) }
  if ir_lowered_expr_is_valid(pure_inline) == 1 {
    pure_inline
  } else {
    let scaled_raw = pipeline_lower_scaled_raw_call_typed(str_hash(src, ns, nl), args_expr, next_value, lower_ctx)
    if ir_lowered_expr_is_valid(scaled_raw) == 1 {
      scaled_raw
    } else {
    let intrinsic = pipeline_lower_native_intrinsic_call_typed(str_hash(src, ns, nl), args_expr, next_value, lower_ctx)
    if ir_lowered_expr_is_valid(intrinsic) == 1 {
      intrinsic
    } else {
    let bridge_mem = if direct == 1 { pipeline_lower_bridge_mem_call_typed(src, ns, nl, args_expr, next_value, lower_ctx) } else { ir_lowered_expr_invalid(next_value) }
    if ir_lowered_expr_is_valid(bridge_mem) == 1 {
      bridge_mem
    } else { if direct == 1 or callee_value >= 0 or callee_slot >= 0 {
    let arg_start_value = if callee_slot >= 0 { next_value + 1 } else { next_value }
    let variant_payloads = if direct == 1 { pipeline_variant_payload_types(tt, src, ns, nl) } else { 0 }
    let expected_params = if variant_payloads == 0 and direct == 1 { pipeline_fns_lookup_params(fns, src, ns, nl) } else { 0 }
    let expected_types = if variant_payloads != 0 { variant_payloads } else { indirect_expected_types }
    let direct_fn = if direct == 1 { pipeline_fns_lookup_pair(fns, src, ns, nl) } else { 0 }
    let result_ty = pipeline_call_result_type_node(params, locals, src, tt, fns, subst, ns, nl)
    let borrowed_mask = if variant_payloads == 0 and direct == 1 {
      pipeline_call_borrowable_param_mask(fns, src, ns, nl, expected_params, subst)
    } else { 0 }
    let args = pipeline_lower_typed_handler_opt_args_expected_borrow_mask(args_expr, 0, arg_start_value, lower_ctx, expected_params, expected_types, subst, borrowed_mask)
    if pipeline_lowered_args_is_valid(args) == 1 {
      let dst = pipeline_lowered_args_next_value(args)
      let indirect_callee = if callee_slot >= 0 { next_value } else { callee_value }
      let callee_insts = if callee_slot >= 0 {
        ir_inst_list_prepend(ir_inst_load_i64(next_value, callee_slot), ir_inst_list_empty())
      } else { ir_inst_list_empty() }
      let logical_args = pipeline_lowered_args_values(args)
      let abi_args = if variant_payloads != 0 {
        pipeline_call_abi_args(logical_args, 0, variant_payloads, subst, 0, 0)
      } else { if expected_params != 0 or expected_types != 0 {
        pipeline_call_abi_args(logical_args, expected_params, expected_types, subst, 0, 0)
      } else { logical_args } }
      let call_head = ir_inst_list_prepend(
        pipeline_call_inst_resolved(dst, direct, indirect_callee, src, tt, ns, nl, abi_args),
        ir_inst_list_empty()
      )
      let call = if result_ty != 0 {
        ir_inst_list_append(call_head, pipeline_ir_call_result_lane_insts(dst, result_ty))
      } else { call_head }
      let result_lanes = if result_ty != 0 { pipeline_type_value_lane_count_or_one(result_ty) } else { 1 }
      let cleanup = pipeline_managed_lambda_temp_release_args_masked_typed(args_expr, logical_args, 0, dst + result_lanes, borrowed_mask, 0, expected_params, expected_types, subst, pipeline_handler_lower_ctx_src(lower_ctx), pipeline_handler_lower_ctx_tt(lower_ctx))
      let insts = ir_inst_list_append(callee_insts, ir_inst_list_append(pipeline_lowered_args_insts(args), ir_inst_list_append(call, pipeline_lowered_args_insts(cleanup))))
      ir_lowered_expr(dst, pipeline_lowered_args_next_value(cleanup), insts)
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  } } } }
  }
  }
}

fn pipeline_expr_float_prim_typed(expr: Expr, params: i64, locals: PipelineValueEnv, src: i64, fns: i64, subst: i64) -> i64 {
  match expr {
    IntLit(value, start, len) -> 0
    StringLit(start, len) -> 0
    BoolLit(value) -> 0
    FloatLit(start, len) -> PRIM_F64()
    Ident(ns, nl) -> {
      let local_prim = pipeline_value_env_lookup_float_prim(locals, src, ns, nl)
      if local_prim != 0 { local_prim } else { pipeline_param_float_prim_by_name(params, src, ns, nl, subst) }
    }
    BinOp(op, lhs, rhs) -> pipeline_binop_float_prim_typed(op, lhs, rhs, params, locals, src, fns, subst)
    LetTyped(inner, ann_type) -> {
      let ann_prim = type_expr_prim_id_or(ann_type, 0)
      if ann_prim == PRIM_F32() or ann_prim == PRIM_F64() { ann_prim }
      else { 0 }
    }
    Call(ns, nl, args) -> {
      let direct = pipeline_call_callee_is_direct(params, locals, src, ns, nl)
      if direct == 1 {
        pipeline_fns_lookup_ret_float_prim(fns, src, ns, nl, subst)
      } else {
        let result_ty = pipeline_call_result_type_node(params, locals, src, 0, fns, subst, ns, nl)
        let prim = pipeline_type_node_prim_id_or(result_ty, 0)
        if prim == PRIM_F32() or prim == PRIM_F64() { prim } else { 0 }
      }
    }
    GenericCall(type_args, inner_call) -> {
      match inner_call {
        Call(ns, nl, args) -> {
          let concrete_type_args = pipeline_type_expr_list_subst(type_args, subst)
          let pair = pipeline_generic_template_find(fns, src, str_hash(src, ns, nl))
          if pair == 0 { 0 }
          else {
            let fn_wrap = node_f1(pair)
            let s = cg_build_subst(fn_tparams(fn_wrap), type_expr_list_to_nodes(concrete_type_args))
            pipeline_fn_return_float_prim(fn_wrap, s)
          }
        }
        _ -> 0
      }
    }
    If(cond, then_expr, else_expr) -> 0
    While(cond, body) -> 0
    Loop(body) -> 0
    Break(value) -> 0
    BreakNoValue -> 0
    Continue -> 0
    Return(value) -> 0
    ReturnNoValue -> 0
    Defer(cleanup, body) -> 0
    Let(ns, nl, value, body) -> 0
    LetMut(ns, nl, value, body) -> 0
    Assign(ns, nl, value) -> 0
    AddressOf(mutable, target) -> 0
    Deref(ptr) -> 0
    PtrAssign(ptr, value) -> 0
    Block(first, rest) -> 0
    FieldAccess(base, field_ns, field_nl, fact) -> 0
    IndexedLen(base, fixed_len) -> 0
    IndexedGet(base, index, element_ty, fixed_len) -> {
      let prim = pipeline_type_node_prim_id_or(element_ty, 0)
      if prim == PRIM_F32() or prim == PRIM_F64() { prim } else { 0 }
    }
    IndexedSet(base, index, value, fact) -> 0
    IndexedSlice(base, start, end, fact) -> 0
    RecordInit(type_ns, type_nl, fields) -> 0
    ArrayLiteral(elements, resolved_ty, span) -> 0
    Match(scrutinee, arms) -> 0
    Not(operand) -> 0
    Lambda(params, body) -> 0
    Perform(lhs, op_ns, op_nl, args) -> 0
    Handle(body, clauses, hret) -> 0
    Resume(value) -> 0
    MethodCall(recv, method_hash, args, type_hash) -> 0
    Try(inner, effect_atom) -> 0
    InterpConcat(left, right) -> 0
    ForIter(var_ns, var_nl, collection, body) -> 0
    OptChain(base, field_ns, field_nl, effect_atom) -> 0
    NilExpr -> 0
    UnknownExpr(tag) -> 0
  }
}

fn pipeline_expr_type_hash_typed(expr: Expr, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, fns: i64, subst: i64) -> i64 {
  match expr {
    Ident(ns, nl) -> {
      let local_hash = pipeline_value_env_lookup_type_hash(locals, src, ns, nl)
      if local_hash != 0 { local_hash } else { pipeline_param_type_hash_by_name(params, src, ns, nl, subst) }
    }
    BinOp(op, lhs, rhs) -> {
      if op >= 5 and op <= 10 {
        type_hash_of(ty_bool())
      } else {
        let float_prim = pipeline_binop_float_prim_typed(op, lhs, rhs, params, locals, src, fns, subst)
        if float_prim == PRIM_F32() or float_prim == PRIM_F64() {
          pipeline_type_hash_of_prim_id(float_prim)
        } else {
          let int_prim = pipeline_binop_int_result_prim_typed(op, lhs, rhs, params, locals, src, fns, subst)
          if int_prim >= 0 { pipeline_type_hash_of_prim_id(int_prim) } else { 0 }
        }
      }
    }
    Call(ns, nl, args) -> {
      if pipeline_call_callee_is_direct(params, locals, src, ns, nl) == 1 {
        pipeline_fns_lookup_ret_type_hash(fns, src, ns, nl, subst)
      } else {
        let result_ty = pipeline_call_result_type_node(params, locals, src, tt, fns, subst, ns, nl)
        if result_ty == 0 { 0 } else { type_hash_of(result_ty) }
      }
    }
    GenericCall(type_args, inner_call) -> {
      match inner_call {
        Call(ns, nl, args) -> {
          let pair = pipeline_generic_template_find(fns, src, str_hash(src, ns, nl))
          if pair == 0 { 0 }
          else {
            let fn_wrap = node_f1(pair)
            let concrete = type_expr_list_to_nodes(type_args)
            let s = cg_build_subst(fn_tparams(fn_wrap), concrete)
            type_hash_of(ty_subst(fn_ret_type(fn_wrap), s))
          }
        }
        _ -> 0
      }
    }
    MethodCall(recv, method_hash, args, method_ref) -> {
      let concrete_ref = pipeline_concretize_method_ref(tt, method_ref, method_hash, subst)
      let resolution = ttable_resolve_method(tt, method_ref_receiver_ty(concrete_ref), method_ref_owner_hash(concrete_ref), method_hash)
      if resolution == 0 { 0 } else { type_hash_of(method_resolution_ret(resolution)) }
    }
    RecordInit(type_ns, type_nl, fields) -> type_name_hash(src, type_ns, type_nl)
    ArrayLiteral(elements, resolved_ty, span) -> type_hash_of(ty_subst(resolved_ty, subst))
    IndexedLen(base, fixed_len) -> type_hash_of(ty_usize())
    IndexedGet(base, index, element_ty, fixed_len) -> type_hash_of(ty_subst(element_ty, subst))
    IndexedSet(base, index, value, fact) -> type_hash_of(ty_nil())
    IndexedSlice(base, start, end, fact) -> if fact == 0 { 0 } else { type_hash_of(ty_slice_with_mut(ty_subst(node_f1(fact), subst), node_f4(fact))) }
    LetTyped(inner, ann_type) -> type_hash_of(type_expr_to_node(ann_type))
    _ -> 0
  }
}

fn pipeline_expr_matches_f32_contextual_typed(expr: Expr, prim: i64, params: i64, locals: PipelineValueEnv, src: i64, fns: i64, subst: i64) -> i64 {
  if prim == PRIM_F32() { 1 }
  else {
    match expr {
      FloatLit(start, len) -> 1
      BinOp(op, lhs, rhs) -> {
        if op >= 1 and op <= 4 {
          let lp = pipeline_expr_float_prim_typed(lhs, params, locals, src, fns, subst)
          let rp = pipeline_expr_float_prim_typed(rhs, params, locals, src, fns, subst)
          pipeline_expr_matches_f32_contextual_typed(lhs, lp, params, locals, src, fns, subst) == 1 and
            pipeline_expr_matches_f32_contextual_typed(rhs, rp, params, locals, src, fns, subst) == 1
        } else { 0 }
      }
      LetTyped(inner, ann_type) -> {
        let ann_prim = type_expr_prim_id_or(ann_type, 0)
        if ann_prim == PRIM_F32() { 1 } else { 0 }
      }
      _ -> 0
    }
  }
}

fn pipeline_binop_float_prim_typed(op_id: i64, lhs_expr: Expr, rhs_expr: Expr, params: i64, locals: PipelineValueEnv, src: i64, fns: i64, subst: i64) -> i64 {
  if op_id >= 1 and op_id <= 10 {
    let lp = pipeline_expr_float_prim_typed(lhs_expr, params, locals, src, fns, subst)
    let rp = pipeline_expr_float_prim_typed(rhs_expr, params, locals, src, fns, subst)
    if lp == PRIM_F32() or rp == PRIM_F32() {
      if pipeline_expr_matches_f32_contextual_typed(lhs_expr, lp, params, locals, src, fns, subst) == 1 and
        pipeline_expr_matches_f32_contextual_typed(rhs_expr, rp, params, locals, src, fns, subst) == 1 {
        PRIM_F32()
      } else { 0 }
    } else {
      if lp == PRIM_F64() or rp == PRIM_F64() { PRIM_F64() } else { 0 }
    }
  } else { 0 }
}

fn pipeline_expr_int_prim_typed(expr: Expr, params: i64, locals: PipelineValueEnv, src: i64, fns: i64, subst: i64) -> i64 {
  match expr {
    IntLit(value, start, len) -> PRIM_I64()
    Ident(ns, nl) -> {
      let local_prim = pipeline_type_hash_int_prim_or(pipeline_value_env_lookup_type_hash(locals, src, ns, nl), 0 - 1)
      if local_prim >= 0 { local_prim } else { pipeline_param_int_prim_by_name(params, src, ns, nl, subst) }
    }
    BinOp(op, lhs, rhs) -> pipeline_binop_int_prim_typed(op, lhs, rhs, params, locals, src, fns, subst)
    LetTyped(inner, ann_type) -> {
      let ann_prim = type_expr_prim_id_or(ann_type, 0 - 1)
      if prim_is_integer(ann_prim) == 1 { ann_prim } else { 0 - 1 }
    }
    Call(ns, nl, args) -> {
      let direct = pipeline_call_callee_is_direct(params, locals, src, ns, nl)
      if direct == 1 {
        pipeline_fns_lookup_ret_int_prim(fns, src, ns, nl, subst)
      } else {
        let result_ty = pipeline_call_result_type_node(params, locals, src, 0, fns, subst, ns, nl)
        let prim = pipeline_type_node_prim_id_or(result_ty, 0 - 1)
        if prim_is_integer(prim) == 1 { prim } else { 0 - 1 }
      }
    }
    GenericCall(type_args, inner_call) -> {
      match inner_call {
        Call(ns, nl, args) -> {
          let concrete_type_args = pipeline_type_expr_list_subst(type_args, subst)
          let pair = pipeline_generic_template_find(fns, src, str_hash(src, ns, nl))
          if pair == 0 { 0 - 1 }
          else {
            let fn_wrap = node_f1(pair)
            let s = cg_build_subst(fn_tparams(fn_wrap), type_expr_list_to_nodes(concrete_type_args))
            pipeline_fn_return_int_prim(fn_wrap, s)
          }
        }
        _ -> 0 - 1
      }
    }
    MethodCall(recv, method_hash, args, type_hash) -> 0 - 1
    _ -> 0 - 1
  }
}

fn pipeline_binop_int_op_tracks_prim(op_id: i64) -> i64 {
  if op_id >= 1 and op_id <= 11 { 1 }
  else { if op_id >= 14 and op_id <= 18 { 1 } else { 0 } }
}

fn pipeline_binop_int_candidate_prim(lp: i64, rp: i64) -> i64 {
  if lp >= 0 and lp != PRIM_I64() { lp }
  else { if rp >= 0 and rp != PRIM_I64() { rp }
  else { PRIM_I64() } }
}

fn pipeline_binop_int_result_prim_typed(op_id: i64, lhs_expr: Expr, rhs_expr: Expr, params: i64, locals: PipelineValueEnv, src: i64, fns: i64, subst: i64) -> i64 {
  if pipeline_binop_int_op_tracks_prim(op_id) == 1 {
    let lp = pipeline_expr_int_prim_typed(lhs_expr, params, locals, src, fns, subst)
    let rp = pipeline_expr_int_prim_typed(rhs_expr, params, locals, src, fns, subst)
    pipeline_binop_int_candidate_prim(lp, rp)
  } else { 0 - 1 }
}

fn pipeline_binop_int_prim_typed(op_id: i64, lhs_expr: Expr, rhs_expr: Expr, params: i64, locals: PipelineValueEnv, src: i64, fns: i64, subst: i64) -> i64 {
  let prim = pipeline_binop_int_result_prim_typed(op_id, lhs_expr, rhs_expr, params, locals, src, fns, subst)
  if pipeline_prim_is_non_native_int(prim) == 1 { prim } else { 0 - 1 }
}

fn pipeline_expr_float_prim_node(expr: i64, params: i64, locals: PipelineValueEnv, src: i64, fns: i64, subst: i64) -> i64 {
  let stripped = pipeline_expr_node_strip_typed(expr)
  if stripped == 0 { 0 }
  else {
    let tag = node_tag(stripped)
    if tag == 54 {
      PRIM_F64()
    } else { if tag == 2 {
      let local_prim = pipeline_value_env_lookup_float_prim(locals, src, node_f1(stripped), node_f2(stripped))
      if local_prim != 0 { local_prim } else { pipeline_param_float_prim_by_name(params, src, node_f1(stripped), node_f2(stripped), subst) }
    } else { if tag == 3 {
      pipeline_binop_float_prim_node(node_f1(stripped), node_f2(stripped), node_f3(stripped), params, locals, src, fns, subst)
    } else { if tag == 37 {
      let ann_prim = pipeline_type_node_prim_id_or(node_f2(stripped), 0)
      if ann_prim == PRIM_F32() or ann_prim == PRIM_F64() { ann_prim } else { 0 }
    } else { if tag == 4 {
      let ns = node_f1(stripped)
      let nl = node_f2(stripped)
      let direct = pipeline_call_callee_is_direct(params, locals, src, ns, nl)
      if direct == 1 {
        pipeline_fns_lookup_ret_float_prim(fns, src, ns, nl, subst)
      } else {
        let result_ty = pipeline_call_result_type_node(params, locals, src, 0, fns, subst, ns, nl)
        let prim = pipeline_type_node_prim_id_or(result_ty, 0)
        if prim == PRIM_F32() or prim == PRIM_F64() { prim } else { 0 }
      }
    } else { if tag == 36 {
      let inner_call = node_f2(stripped)
      if inner_call != 0 and node_tag(inner_call) == 4 {
        let concrete_type_args = if subst == 0 { node_f1(stripped) } else { type_list_subst(node_f1(stripped), subst) }
        let pair = pipeline_generic_template_find(fns, src, str_hash(src, node_f1(inner_call), node_f2(inner_call)))
        if pair == 0 { 0 }
        else {
          let fn_wrap = node_f1(pair)
          let s = cg_build_subst(fn_tparams(fn_wrap), concrete_type_args)
          pipeline_fn_return_float_prim(fn_wrap, s)
        }
      } else { 0 }
    } else {
      0
    } } } } } }
  }
}

fn pipeline_expr_type_hash_node(expr: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, fns: i64, subst: i64) -> i64 {
  let stripped = pipeline_expr_node_strip_typed(expr)
  if stripped == 0 { 0 }
  else {
    let tag = node_tag(stripped)
    if tag == 2 {
      let local_hash = pipeline_value_env_lookup_type_hash(locals, src, node_f1(stripped), node_f2(stripped))
      if local_hash != 0 { local_hash } else { pipeline_param_type_hash_by_name(params, src, node_f1(stripped), node_f2(stripped), subst) }
    } else { if tag == 3 {
      let op = node_f1(stripped)
      if op >= 5 and op <= 10 {
        type_hash_of(ty_bool())
      } else {
        let float_prim = pipeline_binop_float_prim_node(op, node_f2(stripped), node_f3(stripped), params, locals, src, fns, subst)
        if float_prim == PRIM_F32() or float_prim == PRIM_F64() {
          pipeline_type_hash_of_prim_id(float_prim)
        } else {
          let int_prim = pipeline_binop_int_result_prim_node(op, node_f2(stripped), node_f3(stripped), params, locals, src, tt, fns, subst)
          if int_prim >= 0 { pipeline_type_hash_of_prim_id(int_prim) } else { 0 }
        }
      }
    } else { if tag == 4 {
      let ns = node_f1(stripped)
      let nl = node_f2(stripped)
      if pipeline_call_callee_is_direct(params, locals, src, ns, nl) == 1 {
        pipeline_fns_lookup_ret_type_hash(fns, src, ns, nl, subst)
      } else {
        let result_ty = pipeline_call_result_type_node(params, locals, src, tt, fns, subst, ns, nl)
        if result_ty == 0 { 0 } else { type_hash_of(result_ty) }
      }
    } else { if tag == 36 {
      let inner_call = node_f2(stripped)
      if inner_call != 0 and node_tag(inner_call) == 4 {
        let pair = pipeline_generic_template_find(fns, src, str_hash(src, node_f1(inner_call), node_f2(inner_call)))
        if pair == 0 { 0 }
        else {
          let concrete = if subst == 0 { node_f1(stripped) } else { type_list_subst(node_f1(stripped), subst) }
          let fn_wrap = node_f1(pair)
          let s = cg_build_subst(fn_tparams(fn_wrap), concrete)
          type_hash_of(ty_subst(fn_ret_type(fn_wrap), s))
        }
      } else { 0 }
    } else { if tag == 41 {
      let method_ref = pipeline_concretize_method_ref(tt, node_f4(stripped), node_f2(stripped), subst)
      let resolution = ttable_resolve_method(tt, method_ref_receiver_ty(method_ref), method_ref_owner_hash(method_ref), node_f2(stripped))
      if resolution == 0 { 0 } else { type_hash_of(method_resolution_ret(resolution)) }
    } else { if tag == 14 {
      type_name_hash(src, node_f1(stripped), node_f2(stripped))
    } else { if tag == 58 {
      type_hash_of(ty_subst(node_f3(stripped), subst))
    } else { if tag == 59 {
      type_hash_of(ty_usize())
    } else { if tag == 60 {
      type_hash_of(ty_subst(node_f3(stripped), subst))
    } else { if tag == 61 {
      type_hash_of(ty_nil())
    } else { if tag == 62 {
      let fact = node_f4(stripped)
      if fact == 0 { 0 } else { type_hash_of(ty_slice_with_mut(ty_subst(node_f1(fact), subst), node_f4(fact))) }
    } else { if tag == 37 {
      type_hash_of(node_f2(stripped))
    } else {
      0
    } } } } } } } } } } } }
  }
}

fn pipeline_expr_matches_f32_contextual_node(expr: i64, prim: i64, params: i64, locals: PipelineValueEnv, src: i64, fns: i64, subst: i64) -> i64 {
  if prim == PRIM_F32() { 1 }
  else {
    let stripped = pipeline_expr_node_strip_typed(expr)
    if stripped != 0 and node_tag(stripped) == 54 {
      1
    } else { if stripped != 0 and node_tag(stripped) == 3 {
      let op = node_f1(stripped)
      if op >= 1 and op <= 4 {
        let lp = pipeline_expr_float_prim_node(node_f2(stripped), params, locals, src, fns, subst)
        let rp = pipeline_expr_float_prim_node(node_f3(stripped), params, locals, src, fns, subst)
        pipeline_expr_matches_f32_contextual_node(node_f2(stripped), lp, params, locals, src, fns, subst) == 1 and
          pipeline_expr_matches_f32_contextual_node(node_f3(stripped), rp, params, locals, src, fns, subst) == 1
      } else { 0 }
    } else { if stripped != 0 and node_tag(stripped) == 37 {
      let ann_prim = pipeline_type_node_prim_id_or(node_f2(stripped), 0)
      if ann_prim == PRIM_F32() { 1 } else { 0 }
    } else {
      0
    } } }
  }
}

fn pipeline_binop_float_prim_node(op_id: i64, lhs_node: i64, rhs_node: i64, params: i64, locals: PipelineValueEnv, src: i64, fns: i64, subst: i64) -> i64 {
  if op_id >= 1 and op_id <= 10 {
    let lp = pipeline_expr_float_prim_node(lhs_node, params, locals, src, fns, subst)
    let rp = pipeline_expr_float_prim_node(rhs_node, params, locals, src, fns, subst)
    if lp == PRIM_F32() or rp == PRIM_F32() {
      if pipeline_expr_matches_f32_contextual_node(lhs_node, lp, params, locals, src, fns, subst) == 1 and
        pipeline_expr_matches_f32_contextual_node(rhs_node, rp, params, locals, src, fns, subst) == 1 {
        PRIM_F32()
      } else { 0 }
    } else {
      if lp == PRIM_F64() or rp == PRIM_F64() { PRIM_F64() } else { 0 }
    }
  } else { 0 }
}

fn pipeline_expr_int_prim_node(expr: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, fns: i64, subst: i64) -> i64 {
  let stripped = pipeline_expr_node_strip_typed(expr)
  if stripped == 0 { 0 - 1 }
  else {
    let tag = node_tag(stripped)
    if tag == 1 {
      PRIM_I64()
    } else { if tag == 2 {
      let local_prim = pipeline_type_hash_int_prim_or(pipeline_value_env_lookup_type_hash(locals, src, node_f1(stripped), node_f2(stripped)), 0 - 1)
      if local_prim >= 0 { local_prim } else { pipeline_param_int_prim_by_name(params, src, node_f1(stripped), node_f2(stripped), subst) }
    } else { if tag == 3 {
      pipeline_binop_int_prim_node(node_f1(stripped), node_f2(stripped), node_f3(stripped), params, locals, src, tt, fns, subst)
    } else { if tag == 37 {
      let ann_prim = pipeline_type_node_prim_id_or(node_f2(stripped), 0 - 1)
      if prim_is_integer(ann_prim) == 1 { ann_prim } else { 0 - 1 }
    } else { if tag == 4 {
      let ns = node_f1(stripped)
      let nl = node_f2(stripped)
      let direct = pipeline_call_callee_is_direct(params, locals, src, ns, nl)
      if direct == 1 {
        pipeline_fns_lookup_ret_int_prim(fns, src, ns, nl, subst)
      } else {
        let result_ty = pipeline_call_result_type_node(params, locals, src, tt, fns, subst, ns, nl)
        let prim = pipeline_type_node_prim_id_or(result_ty, 0 - 1)
        if prim_is_integer(prim) == 1 { prim } else { 0 - 1 }
      }
    } else { if tag == 36 {
      let inner_call = node_f2(stripped)
      if inner_call != 0 and node_tag(inner_call) == 4 {
        let concrete_type_args = if subst == 0 { node_f1(stripped) } else { type_list_subst(node_f1(stripped), subst) }
        let pair = pipeline_generic_template_find(fns, src, str_hash(src, node_f1(inner_call), node_f2(inner_call)))
        if pair == 0 { 0 - 1 }
        else {
          let fn_wrap = node_f1(pair)
          let s = cg_build_subst(fn_tparams(fn_wrap), concrete_type_args)
          pipeline_fn_return_int_prim(fn_wrap, s)
        }
      } else { 0 - 1 }
    } else {
      0 - 1
    } } } } } }
  }
}

fn pipeline_binop_int_prim_node(op_id: i64, lhs_node: i64, rhs_node: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, fns: i64, subst: i64) -> i64 {
  let prim = pipeline_binop_int_result_prim_node(op_id, lhs_node, rhs_node, params, locals, src, tt, fns, subst)
  if pipeline_prim_is_non_native_int(prim) == 1 { prim } else { 0 - 1 }
}

fn pipeline_binop_int_result_prim_node(op_id: i64, lhs_node: i64, rhs_node: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, fns: i64, subst: i64) -> i64 {
  if pipeline_binop_int_op_tracks_prim(op_id) == 1 {
    let lp = pipeline_expr_int_prim_node(lhs_node, params, locals, src, tt, fns, subst)
    let rp = pipeline_expr_int_prim_node(rhs_node, params, locals, src, tt, fns, subst)
    pipeline_binop_int_candidate_prim(lp, rp)
  } else { 0 - 1 }
}

fn pipeline_lower_float_lit_typed(src: i64, start: i64, len: i64, next_value: i64, prim: i64) -> IrLoweredExpr {
  let bits_result = if prim == PRIM_F32() { cg_decimal_f32_bits(src, start, len) } else { cg_decimal_f64_bits(src, start, len) }
  if node_f2(bits_result) == 1 {
    ir_lowered_expr(
      next_value,
      next_value + 1,
      ir_inst_list_prepend(ir_inst_const_i64(next_value, node_f1(bits_result)), ir_inst_list_empty())
    )
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_binop_expr_typed_sidecar_handler_opt_with_float_prim(op_id: i64, lhs_expr: Expr, rhs_expr: Expr, next_value: i64, lower_ctx: PipelineHandlerLowerCtx, prim: i64) -> IrLoweredExpr {
  let lhs = pipeline_lower_expr_typed_sidecar_handler_opt_with_float_prim(lhs_expr, next_value, lower_ctx, prim)
  if ir_lowered_expr_is_valid(lhs) == 1 {
    let rhs = pipeline_lower_expr_typed_sidecar_handler_opt_with_float_prim(rhs_expr, ir_lowered_expr_next_value(lhs), lower_ctx, prim)
    if ir_lowered_expr_is_valid(rhs) == 1 {
      let op = ir_binary_op_from_parser(op_id)
      if ir_binary_op_is_supported(op) == 1 {
        let dst = ir_lowered_expr_next_value(rhs)
        let inst = ir_inst_list_prepend(
          ir_inst_float_binary_i64(dst, prim, op, ir_lowered_expr_value(lhs), ir_lowered_expr_value(rhs)),
          ir_inst_list_empty()
        )
        let insts = ir_inst_list_append(ir_lowered_expr_insts(lhs), ir_inst_list_append(ir_lowered_expr_insts(rhs), inst))
        ir_lowered_expr(dst, dst + 1, insts)
      } else {
        ir_lowered_expr_invalid(next_value)
      }
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_expr_typed_sidecar_handler_opt_with_float_prim(expr: Expr, next_value: i64, lower_ctx: PipelineHandlerLowerCtx, prim: i64) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let ctx = pipeline_handler_lower_ctx_handlers(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  match expr {
    FloatLit(start, len) -> pipeline_lower_float_lit_typed(src, start, len, next_value, prim)
    BinOp(op, lhs, rhs) -> {
      if pipeline_prim_is_forced_numeric_context(prim) == 1 {
        pipeline_lower_binop_expr_typed_sidecar_handler_opt_with_float_prim(op, lhs, rhs, next_value, lower_ctx, prim)
      } else {
        pipeline_lower_expr_typed_sidecar_handler_ctx(expr, next_value, lower_ctx)
      }
    }
    _ -> pipeline_lower_expr_typed_sidecar_handler_ctx(expr, next_value, lower_ctx)
  }
}

fn pipeline_lower_binop_expr_typed_sidecar_handler_opt(op_id: i64, lhs_expr: Expr, rhs_expr: Expr, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let ctx = pipeline_handler_lower_ctx_handlers(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  let float_prim = pipeline_binop_float_prim_typed_temp(op_id, lhs_expr, rhs_expr, params, locals, src, pipeline_handler_lower_ctx_fns(lower_ctx), subst)
  let int_prim = if float_prim == 0 {
    pipeline_binop_int_prim_typed(op_id, lhs_expr, rhs_expr, params, locals, src, pipeline_handler_lower_ctx_fns(lower_ctx), subst)
  } else { 0 - 1 }
  let numeric_prim = if float_prim != 0 { float_prim } else { int_prim }
  let lhs = if float_prim != 0 or int_prim >= 0 {
    pipeline_lower_expr_typed_sidecar_handler_opt_with_float_prim(lhs_expr, next_value, lower_ctx, numeric_prim)
  } else {
    pipeline_lower_expr_typed_sidecar_handler_ctx(lhs_expr, next_value, lower_ctx)
  }
  if ir_lowered_expr_is_valid(lhs) == 1 {
    let rhs = if float_prim != 0 or int_prim >= 0 {
      pipeline_lower_expr_typed_sidecar_handler_opt_with_float_prim(rhs_expr, ir_lowered_expr_next_value(lhs), lower_ctx, numeric_prim)
    } else {
      pipeline_lower_expr_typed_sidecar_handler_ctx(rhs_expr, ir_lowered_expr_next_value(lhs), lower_ctx)
    }
    if ir_lowered_expr_is_valid(rhs) == 1 {
      let op = ir_binary_op_from_parser(op_id)
      if ir_binary_op_is_supported(op) == 1 {
        let dst = ir_lowered_expr_next_value(rhs)
        if float_prim == 0 and int_prim < 0 and pipeline_binop_is_str_content_eq(op_id, lhs_expr, rhs_expr, params, locals, src, tt, pipeline_handler_lower_ctx_fns(lower_ctx), subst) == 1 {
          let result = pipeline_str_content_eq_result(op_id, dst)
          let insts = ir_inst_list_append(
            ir_lowered_expr_insts(lhs),
            ir_inst_list_append(ir_lowered_expr_insts(rhs), pipeline_str_content_eq_insts(op_id, dst, ir_lowered_expr_value(lhs), ir_lowered_expr_value(rhs)))
          )
          ir_lowered_expr(result, result + 1, insts)
        } else {
        let inst = if float_prim != 0 {
          ir_inst_float_binary_i64(dst, float_prim, op, ir_lowered_expr_value(lhs), ir_lowered_expr_value(rhs))
        } else { if int_prim >= 0 {
          ir_inst_float_binary_i64(dst, int_prim, op, ir_lowered_expr_value(lhs), ir_lowered_expr_value(rhs))
        } else {
          ir_inst_binary_i64(dst, op, ir_lowered_expr_value(lhs), ir_lowered_expr_value(rhs))
        } }
        let binary = ir_inst_list_prepend(
          inst,
          ir_inst_list_empty()
        )
        let insts = ir_inst_list_append(
          ir_lowered_expr_insts(lhs),
          ir_inst_list_append(ir_lowered_expr_insts(rhs), binary)
        )
        ir_lowered_expr(dst, dst + 1, insts)
        }
      } else {
        ir_lowered_expr_invalid(next_value)
      }
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_not_expr_typed_sidecar_handler_opt(operand: Expr, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let ctx = pipeline_handler_lower_ctx_handlers(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  let value = pipeline_lower_expr_typed_sidecar_handler_ctx(operand, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(value) == 1 {
    let dst = ir_lowered_expr_next_value(value)
    let unary = ir_inst_list_prepend(
      ir_inst_unary_i64(dst, ir_unary_op_not(), ir_lowered_expr_value(value)),
      ir_inst_list_empty()
    )
    let insts = ir_inst_list_append(ir_lowered_expr_insts(value), unary)
    ir_lowered_expr(dst, dst + 1, insts)
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_block_expr_typed_sidecar_handler_opt(first_expr: Expr, rest_expr: Expr, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let ctx = pipeline_handler_lower_ctx_handlers(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  let first = pipeline_lower_expr_typed_sidecar_handler_ctx(first_expr, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(first) == 1 {
    let discard_ty = pipeline_discard_release_type(first_expr, params, locals, pipeline_handler_lower_ctx_module(lower_ctx))
    let discard_insts = if discard_ty != 0 { pipeline_managed_release_inst_list(ir_lowered_expr_value(first), discard_ty, ir_lowered_expr_next_value(first)) } else { ir_inst_list_empty() }
    let after_discard = ir_lowered_expr_next_value(first) + ir_inst_list_len(discard_insts)
    match rest_expr {
      UnknownExpr(tag) -> {
        if tag == 0 {
          first
        } else {
          let rest = pipeline_lower_expr_typed_sidecar_handler_ctx(rest_expr, after_discard, lower_ctx)
          if ir_lowered_expr_is_valid(rest) == 1 {
            ir_lowered_expr(
              ir_lowered_expr_value(rest),
              ir_lowered_expr_next_value(rest),
              ir_inst_list_append(ir_lowered_expr_insts(first), ir_inst_list_append(discard_insts, ir_lowered_expr_insts(rest)))
            )
          } else {
            ir_lowered_expr_invalid(next_value)
          }
        }
      }
      _ -> {
        let rest = pipeline_lower_expr_typed_sidecar_handler_ctx(rest_expr, after_discard, lower_ctx)
        if ir_lowered_expr_is_valid(rest) == 1 {
          ir_lowered_expr(
            ir_lowered_expr_value(rest),
            ir_lowered_expr_next_value(rest),
            ir_inst_list_append(ir_lowered_expr_insts(first), ir_inst_list_append(discard_insts, ir_lowered_expr_insts(rest)))
          )
        } else {
          ir_lowered_expr_invalid(next_value)
        }
      }
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_name_matches(src: i64, a_ns: i64, a_nl: i64, b_ns: i64, b_nl: i64) -> bool {
  if a_nl != b_nl { false } else { src_eq_at(src, a_ns, src + b_ns, 0, a_nl) }
}

fn pipeline_param_list_contains_name(params: ParamList, src: i64, ns: i64, nl: i64) -> i64 {
  match params {
    ParamListNil -> 0
    ParamListCons(param, rest) -> {
      let found = match param {
        Param(p_ns, p_nl, ty, label) -> pipeline_name_matches(src, ns, nl, p_ns, p_nl)
        UnknownParam(tag) -> 0
      }
      if found == 1 { 1 } else { pipeline_param_list_contains_name(rest, src, ns, nl) }
    }
  }
}

fn pipeline_expr_node_list_address_of_binding(args: i64, count: i64, src: i64, ns: i64, nl: i64) -> bool {
  let mut found = false
  let mut i = 0
  while i < count and found == 0 {
    if pipeline_expr_node_address_of_binding(nlist_get(args, i), src, ns, nl) == 1 { found = true } else { i = i + 1 }
  }
  found
}

fn pipeline_record_field_nodes_address_of_binding(fields: i64, count: i64, src: i64, ns: i64, nl: i64) -> bool {
  let mut found = false
  let mut i = 0
  while i < count and found == false {
    let field = nlist_get(fields, i)
    if pipeline_expr_node_address_of_binding(node_f3(field), src, ns, nl) == 1 { found = 1 } else { i = i + 1 }
  }
  found
}

fn pipeline_handler_clause_nodes_address_of_binding(clauses: i64, count: i64, src: i64, ns: i64, nl: i64) -> bool {
  let mut found = false
  let mut i = 0
  while i < count and found == 0 {
    let clause = nlist_get(clauses, i)
    if pipeline_param_list_refs_name(node_f2(clause), src, ns, nl) == 1 { i = i + 1 }
    else { if pipeline_expr_node_address_of_binding(node_f3(clause), src, ns, nl) == 1 { found = true } else { i = i + 1 } }
  }
  found
}

fn pipeline_match_arm_nodes_address_of_binding(arms: i64, count: i64, src: i64, ns: i64, nl: i64) -> bool {
  let mut found = false
  let mut i = 0
  while i < count and found == 0 {
    let arm = nlist_get(arms, i)
    let guard_hit = if node_f3(arm) == 0 { 0 } else { pipeline_expr_node_address_of_binding(node_f3(arm), src, ns, nl) }
    if guard_hit == 1 { found = true }
    else { if pipeline_expr_node_address_of_binding(node_f2(arm), src, ns, nl) == 1 { found = true } else { i = i + 1 } }
  }
  found
}

fn pipeline_expr_node_address_of_binding(node: i64, src: i64, ns: i64, nl: i64) -> bool {
  let mut result = false
  if node != 0 {
    let tag = node_tag(node)
    let mut handled = false
    if tag == 3 {
      result = pipeline_expr_node_address_of_binding(node_f2(node), src, ns, nl) or pipeline_expr_node_address_of_binding(node_f3(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 4 {
      result = pipeline_expr_node_list_address_of_binding(node_f3(node), node_f4(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 5 {
      result = pipeline_expr_node_address_of_binding(node_f1(node), src, ns, nl) or pipeline_expr_node_address_of_binding(node_f2(node), src, ns, nl) or pipeline_expr_node_address_of_binding(node_f3(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 6 {
      if pipeline_expr_node_address_of_binding(node_f3(node), src, ns, nl) == 1 { result = 1 }
      else { if pipeline_name_matches(src, ns, nl, node_f1(node), node_f2(node)) == 1 { result = 0 } else { result = pipeline_expr_node_address_of_binding(node_f4(node), src, ns, nl) } }
      handled = 1
    } else { false }
    if handled == 0 and tag == 7 {
      result = pipeline_expr_node_address_of_binding(node_f1(node), src, ns, nl) or pipeline_expr_node_address_of_binding(node_f2(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 10 {
      result = pipeline_expr_node_address_of_binding(node_f1(node), src, ns, nl) or pipeline_expr_node_address_of_binding(node_f2(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 11 {
      if pipeline_expr_node_address_of_binding(node_f3(node), src, ns, nl) == 1 { result = 1 }
      else { if pipeline_name_matches(src, ns, nl, node_f1(node), node_f2(node)) == 1 { result = 0 } else { result = pipeline_expr_node_address_of_binding(node_f4(node), src, ns, nl) } }
      handled = 1
    } else { false }
    if handled == 0 and tag == 12 {
      result = pipeline_expr_node_address_of_binding(node_f3(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 13 {
      result = pipeline_expr_node_address_of_binding(node_f1(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 59 {
      result = pipeline_expr_node_address_of_binding(node_f1(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 60 {
      result = pipeline_expr_node_address_of_binding(node_f1(node), src, ns, nl) or pipeline_expr_node_address_of_binding(node_f2(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 61 {
      result = pipeline_expr_node_address_of_binding(node_f1(node), src, ns, nl) or pipeline_expr_node_address_of_binding(node_f2(node), src, ns, nl) or pipeline_expr_node_address_of_binding(node_f3(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 62 {
      result = pipeline_expr_node_address_of_binding(node_f1(node), src, ns, nl) or pipeline_expr_node_address_of_binding(node_f2(node), src, ns, nl) or pipeline_expr_node_address_of_binding(node_f3(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 14 {
      result = pipeline_record_field_nodes_address_of_binding(node_f3(node), node_f4(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 58 {
      result = pipeline_expr_node_list_address_of_binding(node_f1(node), node_f2(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 15 {
      result = pipeline_expr_node_address_of_binding(node_f1(node), src, ns, nl) or pipeline_match_arm_nodes_address_of_binding(node_f2(node), node_f3(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 22 {
      result = pipeline_expr_node_address_of_binding(node_f1(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 25 {
      result = pipeline_expr_node_address_of_binding(node_f1(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 26 {
      result = pipeline_expr_node_address_of_binding(node_f1(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 29 {
      if pipeline_param_list_refs_name(node_f1(node), src, ns, nl) == 1 { result = 0 } else { result = pipeline_expr_node_address_of_binding(node_f2(node), src, ns, nl) }
      handled = 1
    } else { false }
    if handled == 0 and tag == 32 {
      result = pipeline_expr_node_address_of_binding(node_f1(node), src, ns, nl) or pipeline_expr_node_list_address_of_binding(node_f4(node), nlist_len(node_f4(node)), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 33 {
      result = pipeline_expr_node_address_of_binding(node_f1(node), src, ns, nl) or pipeline_handler_clause_nodes_address_of_binding(node_f2(node), node_f3(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 35 {
      result = pipeline_expr_node_address_of_binding(node_f1(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 36 {
      result = pipeline_expr_node_address_of_binding(node_f2(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 37 {
      result = pipeline_expr_node_address_of_binding(node_f1(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 41 {
      result = pipeline_expr_node_address_of_binding(node_f1(node), src, ns, nl) or pipeline_expr_node_list_address_of_binding(node_f3(node), nlist_len(node_f3(node)), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 45 {
      result = pipeline_expr_node_address_of_binding(node_f1(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 46 {
      result = pipeline_expr_node_address_of_binding(node_f1(node), src, ns, nl) or pipeline_expr_node_address_of_binding(node_f2(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 47 {
      if pipeline_expr_node_address_of_binding(node_f3(node), src, ns, nl) == 1 { result = 1 }
      else { if pipeline_name_matches(src, ns, nl, node_f1(node), node_f2(node)) == 1 { result = 0 } else { result = pipeline_expr_node_address_of_binding(node_f4(node), src, ns, nl) } }
      handled = 1
    } else { false }
    if handled == 0 and tag == 48 {
      result = pipeline_expr_node_address_of_binding(node_f1(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 49 {
      result = pipeline_expr_node_address_of_binding(node_f1(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 52 {
      result = pipeline_expr_node_address_of_binding(node_f1(node), src, ns, nl) or pipeline_expr_node_address_of_binding(node_f2(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 55 {
      let target = node_f2(node)
      if node_tag(target) == 2 {
        result = pipeline_name_matches(src, ns, nl, node_f1(target), node_f2(target))
      } else {
        result = pipeline_expr_node_address_of_binding(target, src, ns, nl)
      }
      handled = 1
    } else { false }
    if handled == 0 and tag == 56 {
      result = pipeline_expr_node_address_of_binding(node_f1(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 57 {
      result = pipeline_expr_node_address_of_binding(node_f1(node), src, ns, nl) or pipeline_expr_node_address_of_binding(node_f2(node), src, ns, nl)
      handled = 1
    } else { false }
  } else { false }
  result
}

fn pipeline_expr_address_of_binding(expr: Expr, src: i64, ns: i64, nl: i64) -> i64 {
  pipeline_expr_typed_address_of_binding(expr, src, ns, nl)
}

fn pipeline_param_list_refs_name_typed(params: ParamList, src: i64, ns: i64, nl: i64) -> i64 {
  match params {
    ParamListNil -> 0
    ParamListCons(param, rest) -> {
      match param {
        Param(pns, pnl, ty, label) -> {
          if pipeline_name_matches(src, pns, pnl, ns, nl) == 1 { 1 } else { pipeline_param_list_refs_name_typed(rest, src, ns, nl) }
        }
        UnknownParam(tag) -> pipeline_param_list_refs_name_typed(rest, src, ns, nl)
      }
    }
  }
}

fn pipeline_expr_list_refs_name_typed(exprs: ExprList, src: i64, ns: i64, nl: i64) -> bool {
  match exprs {
    ExprListNil -> false
    ExprListCons(expr, rest) -> {
      if pipeline_expr_refs_name_typed(expr, src, ns, nl) == 1 { true } else { pipeline_expr_list_refs_name_typed(rest, src, ns, nl) }
    }
  }
}

fn pipeline_record_fields_refs_name_typed(fields: RecordFieldList, src: i64, ns: i64, nl: i64) -> bool {
  match fields {
    RecordFieldListNil -> false
    RecordFieldListCons(field, rest) -> {
      match field {
        RecordField(fns, fnl, value, fact) -> {
          if pipeline_expr_refs_name_typed(value, src, ns, nl) == 1 { true } else { pipeline_record_fields_refs_name_typed(rest, src, ns, nl) }
        }
        UnknownRecordField(tag) -> pipeline_record_fields_refs_name_typed(rest, src, ns, nl)
      }
    }
  }
}

fn pipeline_handler_clauses_refs_name_typed(clauses: HandlerClauseList, src: i64, ns: i64, nl: i64) -> bool {
  match clauses {
    HandlerClauseListNil -> false
    HandlerClauseListCons(clause, rest) -> {
      match clause {
        HandlerClause(name_info, params, body, continuation) -> {
          if pipeline_param_list_refs_name_typed(params, src, ns, nl) == 1 { pipeline_handler_clauses_refs_name_typed(rest, src, ns, nl) }
          else { if pipeline_expr_refs_name_typed(body, src, ns, nl) == 1 { true } else { pipeline_handler_clauses_refs_name_typed(rest, src, ns, nl) } }
        }
        UnknownHandlerClause(tag) -> pipeline_handler_clauses_refs_name_typed(rest, src, ns, nl)
      }
    }
  }
}

fn pipeline_match_arms_refs_name_typed(arms: MatchArmList, src: i64, ns: i64, nl: i64) -> bool {
  match arms {
    MatchArmListNil -> false
    MatchArmListCons(arm, rest) -> {
      match arm {
        Arm(pattern, body, guard, has_guard) -> {
          let guard_hit = if has_guard == 0 { false } else { pipeline_expr_refs_name_typed(guard, src, ns, nl) }
          if guard_hit == 1 { true }
          else { if pipeline_expr_refs_name_typed(body, src, ns, nl) == 1 { true } else { pipeline_match_arms_refs_name_typed(rest, src, ns, nl) } }
        }
        UnknownArm(tag) -> pipeline_match_arms_refs_name_typed(rest, src, ns, nl)
      }
    }
  }
}

fn pipeline_expr_refs_name_typed(expr: Expr, src: i64, ns: i64, nl: i64) -> bool {
  match expr {
    NilExpr -> false
    Ident(ens, enl) -> pipeline_name_matches(src, ens, enl, ns, nl)
    BinOp(op, lhs, rhs) -> pipeline_expr_refs_name_typed(lhs, src, ns, nl) or pipeline_expr_refs_name_typed(rhs, src, ns, nl)
    Call(cns, cnl, args) -> pipeline_expr_list_refs_name_typed(args, src, ns, nl)
    GenericCall(type_args, inner_call) -> pipeline_expr_refs_name_typed(inner_call, src, ns, nl)
    If(cond, then_expr, else_expr) -> pipeline_expr_refs_name_typed(cond, src, ns, nl) or pipeline_expr_refs_name_typed(then_expr, src, ns, nl) or pipeline_expr_refs_name_typed(else_expr, src, ns, nl)
    While(cond, body) -> pipeline_expr_refs_name_typed(cond, src, ns, nl) or pipeline_expr_refs_name_typed(body, src, ns, nl)
    Loop(body) -> pipeline_expr_refs_name_typed(body, src, ns, nl)
    Break(value) -> pipeline_expr_refs_name_typed(value, src, ns, nl)
    Return(value) -> pipeline_expr_refs_name_typed(value, src, ns, nl)
    Defer(cleanup, body) -> pipeline_expr_refs_name_typed(cleanup, src, ns, nl) or pipeline_expr_refs_name_typed(body, src, ns, nl)
    Let(bns, bnl, value, body) -> {
      if pipeline_expr_refs_name_typed(value, src, ns, nl) == 1 { true }
      else { if pipeline_name_matches(src, ns, nl, bns, bnl) == 1 { false } else { pipeline_expr_refs_name_typed(body, src, ns, nl) } }
    }
    LetMut(bns, bnl, value, body) -> {
      if pipeline_expr_refs_name_typed(value, src, ns, nl) == 1 { true }
      else { if pipeline_name_matches(src, ns, nl, bns, bnl) == 1 { false } else { pipeline_expr_refs_name_typed(body, src, ns, nl) } }
    }
    Assign(ans, anl, value) -> pipeline_expr_refs_name_typed(value, src, ns, nl)
    AddressOf(mutable, target) -> pipeline_expr_refs_name_typed(target, src, ns, nl)
    Deref(ptr) -> pipeline_expr_refs_name_typed(ptr, src, ns, nl)
    PtrAssign(ptr, value) -> pipeline_expr_refs_name_typed(ptr, src, ns, nl) or pipeline_expr_refs_name_typed(value, src, ns, nl)
    Block(first, rest) -> pipeline_expr_refs_name_typed(first, src, ns, nl) or pipeline_expr_refs_name_typed(rest, src, ns, nl)
    FieldAccess(base, field_ns, field_nl, fact) -> pipeline_expr_refs_name_typed(base, src, ns, nl)
    IndexedLen(base, fixed_len) -> pipeline_expr_refs_name_typed(base, src, ns, nl)
    IndexedGet(base, index, element_ty, fixed_len) -> pipeline_expr_refs_name_typed(base, src, ns, nl) or pipeline_expr_refs_name_typed(index, src, ns, nl)
    IndexedSet(base, index, value, fact) -> pipeline_expr_refs_name_typed(base, src, ns, nl) or pipeline_expr_refs_name_typed(index, src, ns, nl) or pipeline_expr_refs_name_typed(value, src, ns, nl)
    IndexedSlice(base, start, end, fact) -> pipeline_expr_refs_name_typed(base, src, ns, nl) or pipeline_expr_refs_name_typed(start, src, ns, nl) or pipeline_expr_refs_name_typed(end, src, ns, nl)
    RecordInit(type_ns, type_nl, fields) -> pipeline_record_fields_refs_name_typed(fields, src, ns, nl)
    ArrayLiteral(elements, resolved_ty, span) -> pipeline_expr_list_refs_name_typed(elements, src, ns, nl)
    Match(scrutinee, arms) -> pipeline_expr_refs_name_typed(scrutinee, src, ns, nl) or pipeline_match_arms_refs_name_typed(arms, src, ns, nl)
    Not(operand) -> pipeline_expr_refs_name_typed(operand, src, ns, nl)
    Lambda(params, body) -> {
      if pipeline_param_list_refs_name_typed(params, src, ns, nl) == 1 { false } else { pipeline_expr_refs_name_typed(body, src, ns, nl) }
    }
    Perform(lhs, op_ns, op_nl, args) -> pipeline_expr_refs_name_typed(lhs, src, ns, nl) or pipeline_expr_list_refs_name_typed(args, src, ns, nl)
    Handle(body, clauses, hret) -> pipeline_expr_refs_name_typed(body, src, ns, nl) or pipeline_handler_clauses_refs_name_typed(clauses, src, ns, nl) or (match hret { NoHandleReturn -> false HandleReturnClause(rns, rnl, rb) -> pipeline_expr_refs_name_typed(rb, src, ns, nl) })
    Resume(value) -> pipeline_expr_refs_name_typed(value, src, ns, nl)
    MethodCall(recv, method_hash, args, type_hash) -> pipeline_expr_refs_name_typed(recv, src, ns, nl) or pipeline_expr_list_refs_name_typed(args, src, ns, nl)
    Try(inner, effect_atom) -> pipeline_expr_refs_name_typed(inner, src, ns, nl)
    InterpConcat(left, right) -> pipeline_expr_refs_name_typed(left, src, ns, nl) or pipeline_expr_refs_name_typed(right, src, ns, nl)
    ForIter(var_ns, var_nl, collection, body) -> {
      if pipeline_expr_refs_name_typed(collection, src, ns, nl) == 1 { true }
      else { if pipeline_name_matches(src, ns, nl, var_ns, var_nl) == 1 { false } else { pipeline_expr_refs_name_typed(body, src, ns, nl) } }
    }
    OptChain(base, field_ns, field_nl, effect_atom) -> pipeline_expr_refs_name_typed(base, src, ns, nl)
    LetTyped(inner, ann_type) -> pipeline_expr_refs_name_typed(inner, src, ns, nl)
    _ -> false
  }
}

-- Whether ANY final path of the expr can return the binding. Scope
-- release is skipped when this reports 1 — a borrowed merge that
-- aliases the binding must not be freed under the consumer (leak on
-- the other arms is the accepted trade; the mixed borrowed/owned case
-- is handled by per-arm retains, but an all-borrowed merge carries no
-- count of its own).
fn pipeline_expr_final_returns_binding_typed(expr: Expr, src: i64, ns: i64, nl: i64) -> i64 {
  match expr {
    Ident(ens, enl) -> pipeline_name_matches(src, ns, nl, ens, enl)
    Block(first, rest) -> pipeline_expr_final_returns_binding_typed(rest, src, ns, nl)
    Let(bns, bnl, value, body) -> {
      if pipeline_name_matches(src, ns, nl, bns, bnl) == 1 { 0 }
      else { pipeline_expr_final_returns_binding_typed(body, src, ns, nl) }
    }
    LetMut(bns, bnl, value, body) -> {
      if pipeline_name_matches(src, ns, nl, bns, bnl) == 1 { 0 }
      else { pipeline_expr_final_returns_binding_typed(body, src, ns, nl) }
    }
    LetTyped(inner, ann_type) -> pipeline_expr_final_returns_binding_typed(inner, src, ns, nl)
    If(cond, then_expr, else_expr) -> {
      if pipeline_expr_final_returns_binding_typed(then_expr, src, ns, nl) == 1 { 1 }
      else { pipeline_expr_final_returns_binding_typed(else_expr, src, ns, nl) }
    }
    Match(scrutinee, arms) -> pipeline_match_arms_final_return_binding_typed(arms, src, ns, nl)
    Defer(cleanup, body) -> pipeline_expr_final_returns_binding_typed(body, src, ns, nl)
    _ -> 0
  }
}

fn pipeline_expr_exact_result_param_index_typed(expr: Expr, params: i64, src: i64) -> i64 {
  match expr {
    Ident(ns, nl) -> pipeline_param_index(params, src, ns, nl)
    Resume(value) -> pipeline_expr_exact_result_param_index_typed(value, params, src)
    Block(first, rest) -> pipeline_expr_exact_result_param_index_typed(rest, params, src)
    Let(ns, nl, value, body) -> {
      let index = pipeline_expr_exact_result_param_index_typed(body, params, src)
      if index >= 0 {
        let param = nlist_get(params, index)
        if pipeline_name_matches(src, node_f1(param), node_f2(param), ns, nl) == 1 { 0 - 1 } else { index }
      } else { 0 - 1 }
    }
    LetMut(ns, nl, value, body) -> {
      let index = pipeline_expr_exact_result_param_index_typed(body, params, src)
      if index >= 0 {
        let param = nlist_get(params, index)
        if pipeline_name_matches(src, node_f1(param), node_f2(param), ns, nl) == 1 { 0 - 1 } else { index }
      } else { 0 - 1 }
    }
    LetTyped(inner, ann_type) -> pipeline_expr_exact_result_param_index_typed(inner, params, src)
    If(cond, then_expr, else_expr) -> {
      let left = pipeline_expr_exact_result_param_index_typed(then_expr, params, src)
      let right = pipeline_expr_exact_result_param_index_typed(else_expr, params, src)
      if left >= 0 and left == right { left } else { 0 - 1 }
    }
    Defer(cleanup, body) -> pipeline_expr_exact_result_param_index_typed(body, params, src)
    _ -> 0 - 1
  }
}

fn pipeline_match_arms_final_return_binding_typed(arms: MatchArmList, src: i64, ns: i64, nl: i64) -> i64 {
  match arms {
    MatchArmListNil -> 0
    MatchArmListCons(arm, rest) -> {
      let found = match arm {
        Arm(pattern, body, guard, has_guard) -> pipeline_expr_final_returns_binding_typed(body, src, ns, nl)
        UnknownArm(tag) -> 0
      }
      if found == 1 { 1 } else { pipeline_match_arms_final_return_binding_typed(rest, src, ns, nl) }
    }
  }
}

fn pipeline_expr_final_returns_non_param_ident_typed(expr: Expr, params: i64, src: i64) -> i64 {
  match expr {
    Ident(ns, nl) -> if pipeline_param_index(params, src, ns, nl) >= 0 { 0 } else { 1 }
    Block(first, rest) -> pipeline_expr_final_returns_non_param_ident_typed(rest, params, src)
    Let(ns, nl, value, body) -> pipeline_expr_final_returns_non_param_ident_typed(body, params, src)
    LetMut(ns, nl, value, body) -> pipeline_expr_final_returns_non_param_ident_typed(body, params, src)
    LetTyped(inner, ann_type) -> pipeline_expr_final_returns_non_param_ident_typed(inner, params, src)
    Defer(cleanup, body) -> pipeline_expr_final_returns_non_param_ident_typed(body, params, src)
    _ -> 0
  }
}

fn pipeline_expr_result_is_borrowed_with_ctx_typed(expr: Expr, src: i64, fns: i64, subst: i64, tt: i64) -> i64 {
  match expr {
    Ident(ns, nl) -> if pipeline_ident_is_payloadless_ctor(tt, src, ns, nl) == 1 { 0 } else { 1 }
    FieldAccess(base, field_ns, field_nl, fact) -> 1
    IndexedLen(base, fixed_len) -> 0
    IndexedGet(base, index, element_ty, fixed_len) -> 0
    IndexedSet(base, index, value, fact) -> 0
    IndexedSlice(base, start, end, fact) -> 0
    OptChain(base, field_ns, field_nl, effect_atom) -> 1
    Call(ns, nl, args) -> 0
    GenericCall(type_args, inner_call) -> {
      match inner_call {
        Call(ns, nl, args) -> 0
        _ -> pipeline_expr_result_is_borrowed_with_ctx_typed(inner_call, src, fns, subst, tt)
      }
    }
    Block(first, rest) -> pipeline_expr_result_is_borrowed_with_ctx_typed(rest, src, fns, subst, tt)
    -- An immutable binding of an OWNED init transfers that count when
    -- the binding itself is the final result (scope lowering skips its
    -- release). Classifying that case as borrowed made an enclosing
    -- mixed if/match add another arm-normalisation retain. Keep
    -- borrowed inits and let-mut conservative: their binding retain or
    -- later slot contents are not proven here.
    Let(ns, nl, value, body) -> {
      if pipeline_expr_final_returns_binding_typed(body, src, ns, nl) == 1 and pipeline_expr_result_is_borrowed_with_ctx_typed(value, src, fns, subst, tt) == 0 { 0 }
      else { pipeline_expr_result_is_borrowed_with_ctx_typed(body, src, fns, subst, tt) }
    }
    LetMut(ns, nl, value, body) -> pipeline_expr_result_is_borrowed_with_ctx_typed(body, src, fns, subst, tt)
    LetTyped(inner, ann_type) -> pipeline_expr_result_is_borrowed_with_ctx_typed(inner, src, fns, subst, tt)
    If(cond, then_expr, else_expr) -> {
      if pipeline_expr_result_is_borrowed_with_ctx_typed(then_expr, src, fns, subst, tt) == 1 {
        pipeline_expr_result_is_borrowed_with_ctx_typed(else_expr, src, fns, subst, tt)
      } else { 0 }
    }
    Match(scrutinee, arms) -> {
      if pipeline_expr_owned_rvalue_temp_typed(scrutinee, src, tt) == 1 { 0 }
      else { pipeline_match_arms_result_is_borrowed_with_ctx_typed(arms, src, fns, subst, tt) }
    }
    Defer(cleanup, body) -> pipeline_expr_result_is_borrowed_with_ctx_typed(body, src, fns, subst, tt)
    Resume(value) -> pipeline_expr_result_is_borrowed_with_ctx_typed(value, src, fns, subst, tt)
    Handle(body, clauses, hret) -> {
      match hret {
        NoHandleReturn -> pipeline_expr_result_is_borrowed_with_ctx_typed(body, src, fns, subst, tt)
        HandleReturnClause(rns, rnl, rb) -> pipeline_expr_result_is_borrowed_with_ctx_typed(rb, src, fns, subst, tt)
      }
    }
    _ -> 0
  }
}

-- Fixed-array values use one managed storage handle at typed-IR boundaries.
-- A field projection creates a fresh backing copy and is therefore owned;
-- identifiers remain borrowed aliases, while calls retain their established
-- owned-result convention. This is a semantic placement fact shared by every
-- ownership consumer rather than a codegen-side field recognizer.
fn pipeline_array_expr_result_is_borrowed_typed(expr: Expr, src: i64, fns: i64, subst: i64, tt: i64) -> i64 {
  match expr {
    Ident(ns, nl) -> if pipeline_ident_is_payloadless_ctor(tt, src, ns, nl) == 1 { 0 } else { 1 }
    FieldAccess(base, field_ns, field_nl, fact) -> 0
    IndexedGet(base, index, element_ty, fixed_len) -> 0
    IndexedSet(base, index, value, fact) -> 0
    IndexedSlice(base, start, end, fact) -> 0
    Call(ns, nl, args) -> 0
    GenericCall(type_args, inner_call) -> {
      match inner_call {
        Call(ns, nl, args) -> 0
        _ -> pipeline_array_expr_result_is_borrowed_typed(inner_call, src, fns, subst, tt)
      }
    }
    MethodCall(recv, method_hash, args, type_hash) -> 0
    Block(first, rest) -> pipeline_array_expr_result_is_borrowed_typed(rest, src, fns, subst, tt)
    Let(ns, nl, value, body) -> {
      if pipeline_expr_final_returns_binding_typed(body, src, ns, nl) == 1 and pipeline_array_expr_result_is_borrowed_typed(value, src, fns, subst, tt) == 0 { 0 }
      else { pipeline_array_expr_result_is_borrowed_typed(body, src, fns, subst, tt) }
    }
    LetMut(ns, nl, value, body) -> pipeline_array_expr_result_is_borrowed_typed(body, src, fns, subst, tt)
    LetTyped(inner, ann_type) -> pipeline_array_expr_result_is_borrowed_typed(inner, src, fns, subst, tt)
    If(cond, then_expr, else_expr) -> {
      if pipeline_array_expr_result_is_borrowed_typed(then_expr, src, fns, subst, tt) == 1 {
        pipeline_array_expr_result_is_borrowed_typed(else_expr, src, fns, subst, tt)
      } else { 0 }
    }
    Match(scrutinee, arms) -> pipeline_array_match_arms_result_is_borrowed_typed(arms, src, fns, subst, tt)
    Defer(cleanup, body) -> pipeline_array_expr_result_is_borrowed_typed(body, src, fns, subst, tt)
    Resume(value) -> pipeline_array_expr_result_is_borrowed_typed(value, src, fns, subst, tt)
    Handle(body, clauses, hret) -> {
      match hret {
        NoHandleReturn -> pipeline_array_expr_result_is_borrowed_typed(body, src, fns, subst, tt)
        HandleReturnClause(rns, rnl, rb) -> pipeline_array_expr_result_is_borrowed_typed(rb, src, fns, subst, tt)
      }
    }
    _ -> 0
  }
}

fn pipeline_array_match_arms_result_is_borrowed_typed(arms: MatchArmList, src: i64, fns: i64, subst: i64, tt: i64) -> i64 {
  match arms {
    MatchArmListNil -> 1
    MatchArmListCons(arm, rest) -> {
      match arm {
        Arm(pattern, body, guard, has_guard) -> {
          if pipeline_array_expr_result_is_borrowed_typed(body, src, fns, subst, tt) == 1 {
            pipeline_array_match_arms_result_is_borrowed_typed(rest, src, fns, subst, tt)
          } else { 0 }
        }
        UnknownArm(tag) -> 0
      }
    }
  }
}

fn pipeline_expr_result_is_borrowed_for_ty_typed(expr: Expr, ty: i64, src: i64, fns: i64, subst: i64, tt: i64) -> i64 {
  if ty_is_array(ty) { pipeline_array_expr_result_is_borrowed_typed(expr, src, fns, subst, tt) }
  else { pipeline_expr_result_is_borrowed_with_ctx_typed(expr, src, fns, subst, tt) }
}

fn pipeline_match_arms_result_is_borrowed_with_ctx_typed(arms: MatchArmList, src: i64, fns: i64, subst: i64, tt: i64) -> i64 {
  match arms {
    MatchArmListNil -> 1
    MatchArmListCons(arm, rest) -> {
      match arm {
        Arm(pattern, body, guard, has_guard) -> {
          if pipeline_expr_result_is_borrowed_with_ctx_typed(body, src, fns, subst, tt) == 1 {
            pipeline_match_arms_result_is_borrowed_with_ctx_typed(rest, src, fns, subst, tt)
          } else { 0 }
        }
        UnknownArm(tag) -> 0
      }
    }
  }
}

fn pipeline_expr_node_result_is_borrowed_with_ctx_typed(expr: i64, src: i64, fns: i64, subst: i64, tt: i64) -> i64 {
  let stripped = pipeline_expr_node_strip_typed(expr)
  if stripped == 0 { 0 } else { pipeline_expr_result_is_borrowed_with_ctx_typed(expr_from_node(stripped), src, fns, subst, tt) }
}

fn pipeline_expr_node_result_is_borrowed_for_ty_typed(expr: i64, ty: i64, src: i64, fns: i64, subst: i64, tt: i64) -> i64 {
  let stripped = pipeline_expr_node_strip_typed(expr)
  if stripped == 0 { 0 } else { pipeline_expr_result_is_borrowed_for_ty_typed(expr_from_node(stripped), ty, src, fns, subst, tt) }
}

fn pipeline_expr_result_is_any_param_borrow_typed(expr: Expr, params: i64, src: i64) -> i64 {
  match expr {
    Ident(ns, nl) -> if pipeline_param_index(params, src, ns, nl) >= 0 { 1 } else { 0 }
    FieldAccess(base, field_ns, field_nl, fact) -> pipeline_expr_result_is_any_param_borrow_typed(base, params, src)
    IndexedLen(base, fixed_len) -> 0
    IndexedGet(base, index, element_ty, fixed_len) -> 0
    IndexedSet(base, index, value, fact) -> 0
    IndexedSlice(base, start, end, fact) -> 0
    OptChain(base, field_ns, field_nl, effect_atom) -> pipeline_expr_result_is_any_param_borrow_typed(base, params, src)
    Block(first, rest) -> pipeline_expr_result_is_any_param_borrow_typed(rest, params, src)
    Let(ns, nl, value, body) -> pipeline_expr_result_is_any_param_borrow_typed(body, params, src)
    LetMut(ns, nl, value, body) -> pipeline_expr_result_is_any_param_borrow_typed(body, params, src)
    LetTyped(inner, ann_type) -> pipeline_expr_result_is_any_param_borrow_typed(inner, params, src)
    If(cond, then_expr, else_expr) -> {
      if pipeline_expr_result_is_any_param_borrow_typed(then_expr, params, src) == 1 {
        pipeline_expr_result_is_any_param_borrow_typed(else_expr, params, src)
      } else { 0 }
    }
    Match(scrutinee, arms) -> pipeline_match_arms_result_is_any_param_borrow_typed(arms, params, src)
    Defer(cleanup, body) -> pipeline_expr_result_is_any_param_borrow_typed(body, params, src)
    Resume(value) -> pipeline_expr_result_is_any_param_borrow_typed(value, params, src)
    Handle(body, clauses, hret) -> {
      match hret {
        NoHandleReturn -> pipeline_expr_result_is_any_param_borrow_typed(body, params, src)
        HandleReturnClause(rns, rnl, rb) -> pipeline_expr_result_is_any_param_borrow_typed(rb, params, src)
      }
    }
    _ -> 0
  }
}

fn pipeline_match_arms_result_is_any_param_borrow_typed(arms: MatchArmList, params: i64, src: i64) -> i64 {
  match arms {
    MatchArmListNil -> 1
    MatchArmListCons(arm, rest) -> {
      match arm {
        Arm(pattern, body, guard, has_guard) -> {
          if pipeline_expr_result_is_any_param_borrow_typed(body, params, src) == 1 {
            pipeline_match_arms_result_is_any_param_borrow_typed(rest, params, src)
          } else { 0 }
        }
        UnknownArm(tag) -> 0
      }
    }
  }
}

fn pipeline_fns_lookup_returns_param_borrow_by_hash(fns: i64, target_hash: i64) -> i64 {
  let pair = pipeline_fns_lookup_pair_by_hash(fns, target_hash)
  if pair == 0 { 0 }
  else {
    let inner = pipeline_fn_inner(node_f1(pair))
    pipeline_expr_result_is_any_param_borrow_typed(expr_from_node(node_f4(inner)), node_f3(inner), node_f2(pair))
  }
}

fn pipeline_fns_lookup_returns_param_borrow(fns: i64, src: i64, ns: i64, nl: i64) -> i64 {
  if pipeline_fns_fact_list_valid(fns) == 0 { 0 }
  else {
    let n = nlist_len(fns)
    let mut i = 0
    let mut result = 0
    while i < n {
      let pair = nlist_get(fns, i)
      let fn_src = node_f2(pair)
      let fn_wrap = node_f1(pair)
      if pipeline_decl_node_is_function(fn_wrap) == 1 {
        let inner = pipeline_fn_inner(fn_wrap)
        if node_f2(inner) == nl {
          if src_eq_at(src, ns, fn_src + node_f1(inner), 0, nl) == 1 {
            result = pipeline_expr_result_is_any_param_borrow_typed(expr_from_node(node_f4(inner)), node_f3(inner), fn_src)
            i = n
          } else {
            i = i + 1
          }
        } else {
          i = i + 1
        }
      } else {
        i = i + 1
      }
    }
    if result != 0 { result } else { pipeline_fns_lookup_returns_param_borrow_by_hash(fns, str_hash(src, ns, nl)) }
  }
}

fn pipeline_expr_node_final_returns_binding(node: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let stripped = pipeline_expr_node_strip_typed(node)
  if stripped == 0 { 0 }
  else {
    match node_tag(stripped) {
      2 -> pipeline_name_matches(src, ns, nl, node_f1(stripped), node_f2(stripped))
      5 -> {
        if pipeline_expr_node_final_returns_binding(node_f2(stripped), src, ns, nl) == 1 {
          pipeline_expr_node_final_returns_binding(node_f3(stripped), src, ns, nl)
        } else { 0 }
      }
      6 -> {
        if pipeline_name_matches(src, ns, nl, node_f1(stripped), node_f2(stripped)) == 1 { 0 }
        else { pipeline_expr_node_final_returns_binding(node_f4(stripped), src, ns, nl) }
      }
      7 -> pipeline_expr_node_final_returns_binding(node_f2(stripped), src, ns, nl)
      11 -> {
        if pipeline_name_matches(src, ns, nl, node_f1(stripped), node_f2(stripped)) == 1 { 0 }
        else { pipeline_expr_node_final_returns_binding(node_f4(stripped), src, ns, nl) }
      }
      37 -> pipeline_expr_node_final_returns_binding(node_f1(stripped), src, ns, nl)
      52 -> pipeline_expr_node_final_returns_binding(node_f2(stripped), src, ns, nl)
      _ -> 0
    }
  }
}

fn pipeline_expr_node_final_returns_non_param_ident(node: i64, params: i64, src: i64) -> i64 {
  let stripped = pipeline_expr_node_strip_typed(node)
  if stripped == 0 { 0 }
  else { pipeline_expr_final_returns_non_param_ident_typed(expr_from_node(stripped), params, src) }
}

fn pipeline_expr_list_address_of_binding_typed(exprs: ExprList, src: i64, ns: i64, nl: i64) -> bool {
  match exprs {
    ExprListNil -> false
    ExprListCons(expr, rest) -> {
      if pipeline_expr_typed_address_of_binding(expr, src, ns, nl) == 1 { true } else { pipeline_expr_list_address_of_binding_typed(rest, src, ns, nl) }
    }
  }
}

fn pipeline_record_fields_address_of_binding_typed(fields: RecordFieldList, src: i64, ns: i64, nl: i64) -> bool {
  match fields {
    RecordFieldListNil -> false
    RecordFieldListCons(field, rest) -> {
      match field {
        RecordField(fns, fnl, value, fact) -> {
          if pipeline_expr_typed_address_of_binding(value, src, ns, nl) == 1 { true } else { pipeline_record_fields_address_of_binding_typed(rest, src, ns, nl) }
        }
        UnknownRecordField(tag) -> pipeline_record_fields_address_of_binding_typed(rest, src, ns, nl)
      }
    }
  }
}

fn pipeline_handler_clauses_address_of_binding_typed(clauses: HandlerClauseList, src: i64, ns: i64, nl: i64) -> bool {
  match clauses {
    HandlerClauseListNil -> false
    HandlerClauseListCons(clause, rest) -> {
      match clause {
        HandlerClause(name_info, params, body, continuation) -> {
          if pipeline_param_list_refs_name_typed(params, src, ns, nl) == 1 { pipeline_handler_clauses_address_of_binding_typed(rest, src, ns, nl) }
          else { if pipeline_expr_typed_address_of_binding(body, src, ns, nl) == 1 { true } else { pipeline_handler_clauses_address_of_binding_typed(rest, src, ns, nl) } }
        }
        UnknownHandlerClause(tag) -> pipeline_handler_clauses_address_of_binding_typed(rest, src, ns, nl)
      }
    }
  }
}

fn pipeline_match_arms_address_of_binding_typed(arms: MatchArmList, src: i64, ns: i64, nl: i64) -> bool {
  match arms {
    MatchArmListNil -> false
    MatchArmListCons(arm, rest) -> {
      match arm {
        Arm(pattern, body, guard, has_guard) -> {
          let guard_hit = if has_guard == 0 { false } else { pipeline_expr_typed_address_of_binding(guard, src, ns, nl) }
          if guard_hit == 1 { true }
          else { if pipeline_expr_typed_address_of_binding(body, src, ns, nl) == 1 { true } else { pipeline_match_arms_address_of_binding_typed(rest, src, ns, nl) } }
        }
        UnknownArm(tag) -> pipeline_match_arms_address_of_binding_typed(rest, src, ns, nl)
      }
    }
  }
}

fn pipeline_expr_typed_address_of_binding(expr: Expr, src: i64, ns: i64, nl: i64) -> bool {
  match expr {
    NilExpr -> false
    BinOp(op, lhs, rhs) -> pipeline_expr_typed_address_of_binding(lhs, src, ns, nl) or pipeline_expr_typed_address_of_binding(rhs, src, ns, nl)
    Call(cns, cnl, args) -> pipeline_expr_list_address_of_binding_typed(args, src, ns, nl)
    GenericCall(type_args, inner_call) -> pipeline_expr_typed_address_of_binding(inner_call, src, ns, nl)
    If(cond, then_expr, else_expr) -> pipeline_expr_typed_address_of_binding(cond, src, ns, nl) or pipeline_expr_typed_address_of_binding(then_expr, src, ns, nl) or pipeline_expr_typed_address_of_binding(else_expr, src, ns, nl)
    While(cond, body) -> pipeline_expr_typed_address_of_binding(cond, src, ns, nl) or pipeline_expr_typed_address_of_binding(body, src, ns, nl)
    Loop(body) -> pipeline_expr_typed_address_of_binding(body, src, ns, nl)
    Break(value) -> pipeline_expr_typed_address_of_binding(value, src, ns, nl)
    Return(value) -> pipeline_expr_typed_address_of_binding(value, src, ns, nl)
    Defer(cleanup, body) -> pipeline_expr_typed_address_of_binding(cleanup, src, ns, nl) or pipeline_expr_typed_address_of_binding(body, src, ns, nl)
    Let(bns, bnl, value, body) -> {
      if pipeline_expr_typed_address_of_binding(value, src, ns, nl) == 1 { true }
      else { if pipeline_name_matches(src, ns, nl, bns, bnl) == 1 { false } else { pipeline_expr_typed_address_of_binding(body, src, ns, nl) } }
    }
    LetMut(bns, bnl, value, body) -> {
      if pipeline_expr_typed_address_of_binding(value, src, ns, nl) == 1 { true }
      else { if pipeline_name_matches(src, ns, nl, bns, bnl) == 1 { false } else { pipeline_expr_typed_address_of_binding(body, src, ns, nl) } }
    }
    Assign(ans, anl, value) -> pipeline_expr_typed_address_of_binding(value, src, ns, nl)
    AddressOf(mutable, target) -> {
      match target {
        Ident(tns, tnl) -> pipeline_name_matches(src, ns, nl, tns, tnl)
        _ -> pipeline_expr_typed_address_of_binding(target, src, ns, nl)
      }
    }
    Deref(ptr) -> pipeline_expr_typed_address_of_binding(ptr, src, ns, nl)
    PtrAssign(ptr, value) -> pipeline_expr_typed_address_of_binding(ptr, src, ns, nl) or pipeline_expr_typed_address_of_binding(value, src, ns, nl)
    Block(first, rest) -> pipeline_expr_typed_address_of_binding(first, src, ns, nl) or pipeline_expr_typed_address_of_binding(rest, src, ns, nl)
    FieldAccess(base, field_ns, field_nl, fact) -> pipeline_expr_typed_address_of_binding(base, src, ns, nl)
    IndexedLen(base, fixed_len) -> pipeline_expr_typed_address_of_binding(base, src, ns, nl)
    IndexedGet(base, index, element_ty, fixed_len) -> pipeline_expr_typed_address_of_binding(base, src, ns, nl) or pipeline_expr_typed_address_of_binding(index, src, ns, nl)
    IndexedSet(base, index, value, fact) -> pipeline_expr_typed_address_of_binding(base, src, ns, nl) or pipeline_expr_typed_address_of_binding(index, src, ns, nl) or pipeline_expr_typed_address_of_binding(value, src, ns, nl)
    IndexedSlice(base, start, end, fact) -> pipeline_expr_typed_address_of_binding(base, src, ns, nl) or pipeline_expr_typed_address_of_binding(start, src, ns, nl) or pipeline_expr_typed_address_of_binding(end, src, ns, nl)
    RecordInit(type_ns, type_nl, fields) -> pipeline_record_fields_address_of_binding_typed(fields, src, ns, nl)
    ArrayLiteral(elements, resolved_ty, span) -> pipeline_expr_list_address_of_binding_typed(elements, src, ns, nl)
    Match(scrutinee, arms) -> pipeline_expr_typed_address_of_binding(scrutinee, src, ns, nl) or pipeline_match_arms_address_of_binding_typed(arms, src, ns, nl)
    Not(operand) -> pipeline_expr_typed_address_of_binding(operand, src, ns, nl)
    Lambda(params, body) -> {
      if pipeline_param_list_refs_name_typed(params, src, ns, nl) == 1 { false } else { pipeline_expr_typed_address_of_binding(body, src, ns, nl) }
    }
    Perform(lhs, op_ns, op_nl, args) -> pipeline_expr_typed_address_of_binding(lhs, src, ns, nl) or pipeline_expr_list_address_of_binding_typed(args, src, ns, nl)
    Handle(body, clauses, hret) -> pipeline_expr_typed_address_of_binding(body, src, ns, nl) or pipeline_handler_clauses_address_of_binding_typed(clauses, src, ns, nl) or (match hret { NoHandleReturn -> false HandleReturnClause(rns, rnl, rb) -> pipeline_expr_typed_address_of_binding(rb, src, ns, nl) })
    Resume(value) -> pipeline_expr_typed_address_of_binding(value, src, ns, nl)
    MethodCall(recv, method_hash, args, type_hash) -> pipeline_expr_typed_address_of_binding(recv, src, ns, nl) or pipeline_expr_list_address_of_binding_typed(args, src, ns, nl)
    Try(inner, effect_atom) -> pipeline_expr_typed_address_of_binding(inner, src, ns, nl)
    InterpConcat(left, right) -> pipeline_expr_typed_address_of_binding(left, src, ns, nl) or pipeline_expr_typed_address_of_binding(right, src, ns, nl)
    ForIter(var_ns, var_nl, collection, body) -> {
      if pipeline_expr_typed_address_of_binding(collection, src, ns, nl) == 1 { true }
      else { if pipeline_name_matches(src, ns, nl, var_ns, var_nl) == 1 { false } else { pipeline_expr_typed_address_of_binding(body, src, ns, nl) } }
    }
    OptChain(base, field_ns, field_nl, effect_atom) -> pipeline_expr_typed_address_of_binding(base, src, ns, nl)
    LetTyped(inner, ann_type) -> pipeline_expr_typed_address_of_binding(inner, src, ns, nl)
    _ -> false
  }
}

fn pipeline_ir_addressable_slot_id(next_value: i64) -> i64 {
  if next_value < 8 { 8 } else { next_value }
}

fn pipeline_lower_let_expr_typed_sidecar_handler_opt_with_float_prim(ns: i64, nl: i64, value_expr: Expr, body_expr: Expr, next_value: i64, lower_ctx: PipelineHandlerLowerCtx, local_float: i64, local_type_node: i64) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let ctx = pipeline_handler_lower_ctx_handlers(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  let value = if pipeline_prim_is_forced_numeric_context(local_float) == 1 {
    pipeline_lower_expr_typed_sidecar_handler_opt_with_float_prim(value_expr, next_value, lower_ctx, local_float)
  } else {
    pipeline_lower_expr_typed_sidecar_handler_ctx(value_expr, next_value, lower_ctx)
  }
  if ir_lowered_expr_is_valid(value) == 1 {
    let inferred_float_prim = pipeline_expr_float_prim_typed_temp(value_expr, params, locals, src, pipeline_handler_lower_ctx_fns(lower_ctx), subst)
    let float_prim = if local_float == PRIM_F32() or local_float == PRIM_F64() { local_float } else { inferred_float_prim }
    let inferred_type_hash = pipeline_expr_type_hash_typed_temp(value_expr, params, locals, src, tt, pipeline_handler_lower_ctx_fns(lower_ctx), subst)
    let inferred_type_node = pipeline_init_type_node_typed(value_expr, params, locals, pipeline_handler_lower_ctx_module(lower_ctx))
    let effective_type_node = if local_type_node != 0 { ty_subst(local_type_node, subst) } else { inferred_type_node }
    let local_lanes = pipeline_type_value_lane_count_or_one(effective_type_node)
    let annotated_type_hash = if local_type_node != 0 and effective_type_node != 0 { type_hash_of(effective_type_node) } else { 0 }
    let inferred_node_type_hash = if effective_type_node != 0 { type_hash_of(effective_type_node) } else { 0 }
    let local_type_hash = if annotated_type_hash != 0 { annotated_type_hash } else { if inferred_node_type_hash != 0 { inferred_node_type_hash } else { if local_float != 0 and pipeline_prim_is_numeric_context(local_float) == 1 { pipeline_type_hash_of_prim_id(local_float) } else { pipeline_expr_type_hash_sharpen_int_typed(value_expr, inferred_type_hash, params, locals, src, pipeline_handler_lower_ctx_fns(lower_ctx), subst) } } }
    let address_taken = pipeline_expr_address_of_binding(body_expr, src, ns, nl)
    let slot = pipeline_ir_addressable_slot_id(ir_lowered_expr_next_value(value))
    let bind_value_for_retain = if address_taken == 1 { slot } else { ir_lowered_expr_value(value) }
    let retain_insts = if address_taken == 1 or pipeline_expr_result_is_borrowed_for_ty_typed(value_expr, effective_type_node, src, pipeline_handler_lower_ctx_fns(lower_ctx), subst, pipeline_handler_lower_ctx_tt(lower_ctx)) == 0 {
      ir_inst_list_empty()
    } else {
      pipeline_managed_retain_inst_list(bind_value_for_retain, effective_type_node, ir_lowered_expr_next_value(value))
    }
    let body_next = if address_taken == 1 {
      slot + local_lanes
    } else {
      ir_lowered_expr_next_value(value) + ir_inst_list_len(retain_insts)
    }
    let next_locals = if address_taken == 1 {
      pipeline_value_env_push_slot_float_typed_node(locals, ns, nl, slot, float_prim, local_type_hash, effective_type_node)
    } else {
      pipeline_value_env_push_float_typed_node(locals, ns, nl, ir_lowered_expr_value(value), float_prim, local_type_hash, effective_type_node)
    }
    let body_ctx = pipeline_handler_lower_ctx_from_module(params, next_locals, pipeline_handler_lower_ctx_module(lower_ctx))
    let body = pipeline_lower_expr_typed_sidecar_handler_ctx(body_expr, body_next, body_ctx)
    if ir_lowered_expr_is_valid(body) == 1 {
      let bind_value = if address_taken == 1 { slot } else { ir_lowered_expr_value(value) }
      let bind = ir_inst_list_prepend(ir_inst_bind_typed_i64(ns, nl, bind_value, effective_type_node), ir_inst_list_empty())
      let slot_insts = if address_taken == 1 {
        pipeline_ir_slot_lane_init_insts(slot, ir_lowered_expr_value(value), 0, local_lanes)
      } else { ir_inst_list_empty() }
      let release_dst = ir_lowered_expr_next_value(body)
      let body_returns_binding = pipeline_expr_final_returns_binding_typed(body_expr, src, ns, nl)
      let release_insts = if address_taken == 1 or body_returns_binding == 1 { ir_inst_list_empty() } else { pipeline_managed_release_inst_list(bind_value, effective_type_node, release_dst) }
      -- Owned bindings drop at scope exit. A body that references the binding
      -- may move ownership (return or owned-param call), so only the
      -- never-referenced case drops here, matching the defer-owned rule.
      let owned_type_hash = if local_type_node != 0 and effective_type_node != 0 { cg_owned_drop_type_hash(effective_type_node) } else { 0 }
      let owned_drop_insts = if owned_type_hash != 0 and address_taken == 0 and pipeline_expr_refs_name_typed(body_expr, src, ns, nl) == 0 {
        ir_inst_list_prepend(ir_inst_owned_drop_i64(bind_value, owned_type_hash), ir_inst_list_empty())
      } else { ir_inst_list_empty() }
      let next_after_release = release_dst + ir_inst_list_len(release_insts)
      ir_lowered_expr(
        ir_lowered_expr_value(body),
        next_after_release,
        ir_inst_list_append(ir_lowered_expr_insts(value), ir_inst_list_append(slot_insts, ir_inst_list_append(retain_insts, ir_inst_list_append(bind, ir_inst_list_append(ir_lowered_expr_insts(body), ir_inst_list_append(owned_drop_insts, release_insts))))))
      )
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_let_expr_typed_sidecar_handler_opt(ns: i64, nl: i64, value_expr: Expr, body_expr: Expr, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  pipeline_lower_let_expr_typed_sidecar_handler_opt_with_float_prim(ns, nl, value_expr, body_expr, next_value, lower_ctx, 0, 0)
}

fn pipeline_lower_perform_expr_typed_sidecar_handler_opt(lhs_expr: Expr, op_ns: i64, op_nl: i64, args_exprs: ExprList, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let dispatch_key = pipeline_effect_ref_dispatch_key_typed(pipeline_handler_lower_ctx_src(lower_ctx), lhs_expr, pipeline_handler_lower_ctx_subst(lower_ctx))
  pipeline_lower_perform_expr_typed_sidecar_handler_opt_keyed(lhs_expr, lhs_expr, op_ns, op_nl, args_exprs, next_value, lower_ctx, dispatch_key)
}

fn pipeline_lower_perform_expr_typed_sidecar_handler_opt_keyed(lhs_expr: Expr, signature_ref: Expr, op_ns: i64, op_nl: i64, args_exprs: ExprList, next_value: i64, lower_ctx: PipelineHandlerLowerCtx, dispatch_key: i64) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let ctx = pipeline_handler_lower_ctx_handlers(lower_ctx)
  match lhs_expr {
    Ident(eff_ns, eff_nl) -> {
      let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
      let local_recv_ty = pipeline_value_env_lookup_type_node(locals, src, eff_ns, eff_nl)
      let recv_ty = if local_recv_ty != 0 {
        ty_subst(local_recv_ty, subst)
      } else {
        pipeline_param_type_node_by_name(params, src, eff_ns, eff_nl, subst)
      }
      let method_hash = effect_name_hash(src, op_ns, op_nl)
      let method_ref = pipeline_resolve_method_ref(tt, recv_ty, method_hash)
      if method_ref != 0 {
        pipeline_lower_method_call_expr_typed_sidecar_handler_opt(lhs_expr, method_hash, args_exprs, method_ref, next_value, lower_ctx)
      } else { if pipeline_ident_is_declared_effect(tt, src, eff_ns, eff_nl) == 0 {
        ir_lowered_expr_invalid(next_value)
      } else {
        let expected_params = pipeline_effect_op_params_nodes_typed(tt, src, signature_ref, op_ns, op_nl, subst)
        let return_ty = pipeline_effect_op_return_type_typed(tt, src, signature_ref, op_ns, op_nl, subst)
        let result_lanes = pipeline_type_value_lane_count_or_one(return_ty)
        let args = pipeline_lower_typed_handler_opt_args_expected(args_exprs, 0, next_value, lower_ctx, expected_params, 0, 0)
        if pipeline_lowered_args_is_valid(args) == 1 {
          let dst = pipeline_lowered_args_next_value(args)
          let logical_args = pipeline_lowered_args_values(args)
          let abi_args = pipeline_call_abi_args(logical_args, expected_params, 0, 0, 0, 0)
          let eff_hash = if dispatch_key != 0 { dispatch_key } else { effect_name_hash(src, eff_ns, eff_nl) }
          let op_hash = effect_name_hash(src, op_ns, op_nl)
          let module = pipeline_handler_lower_ctx_module(lower_ctx)
          let par_lowered = pipeline_lower_par_perform_inst_typed(lhs_expr, op_ns, op_nl, args_exprs, logical_args, dst, expected_params, params, locals, module)
          if ir_lowered_expr_is_valid(par_lowered) == 1 {
            ir_lowered_expr(
              ir_lowered_expr_value(par_lowered),
              ir_lowered_expr_next_value(par_lowered),
              ir_inst_list_append(pipeline_lowered_args_insts(args), ir_lowered_expr_insts(par_lowered))
            )
          } else {
            let found = pipeline_handler_inline_ctx_find_match(ctx, src, eff_hash, op_hash)
            let tail_inline = pipeline_handler_inline_try_tail_resume(ctx, found, logical_args, tt, pipeline_handler_lower_ctx_fns(lower_ctx), dst)
            if ir_lowered_expr_is_valid(tail_inline) == 1 {
              ir_lowered_expr(
                ir_lowered_expr_value(tail_inline),
                ir_lowered_expr_next_value(tail_inline),
                ir_inst_list_append(pipeline_lowered_args_insts(args), ir_lowered_expr_insts(tail_inline))
              )
            } else {
            let op_inst = if pipeline_handler_inline_match_found(found) == 1 {
              ir_inst_handler_direct_i64(
                dst,
                eff_hash,
                op_hash,
                pipeline_handler_inline_match_depth_or(found, 0 - 1),
                pipeline_handler_inline_match_clause_index_or(found, 0 - 1),
                abi_args
              )
            } else {
              ir_inst_perform_i64(dst, eff_hash, op_hash, abi_args)
            }
            let perform = ir_inst_list_append(ir_inst_list_prepend(op_inst, ir_inst_list_empty()), pipeline_ir_call_result_lane_insts(dst, return_ty))
            let insts = ir_inst_list_append(pipeline_lowered_args_insts(args), perform)
            ir_lowered_expr(dst, dst + result_lanes, insts)
            }
          }
        } else {
          ir_lowered_expr_invalid(next_value)
        }
      } }
    }
    GenericCall(type_args, inner) -> {
      match inner {
        Ident(eff_ns, eff_nl) -> pipeline_lower_perform_expr_typed_sidecar_handler_opt_keyed(Ident(eff_ns, eff_nl), signature_ref, op_ns, op_nl, args_exprs, next_value, lower_ctx, dispatch_key)
        _ -> ir_lowered_expr_invalid(next_value)
      }
    }
    _ -> ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_expr_ident_matches_param(expr: Expr, param: Param, src: i64) -> bool {
  match pipeline_expr_strip_typed(expr) {
    Ident(ns, nl) -> {
      match param {
        Param(p_ns, p_nl, ty, label) -> pipeline_name_matches(src, ns, nl, p_ns, p_nl)
        UnknownParam(tag) -> false
      }
    }
    _ -> false
  }
}

fn pipeline_vector_fold_i64_sum_body(src: i64, body: Expr, first: Param, second: Param) -> i64 {
  match pipeline_expr_strip_typed(body) {
    BinOp(op, lhs, rhs) -> {
      if op == 1 {
        let forward = pipeline_expr_ident_matches_param(lhs, first, src) and pipeline_expr_ident_matches_param(rhs, second, src)
        let reverse = pipeline_expr_ident_matches_param(lhs, second, src) and pipeline_expr_ident_matches_param(rhs, first, src)
        forward or reverse
      } else {
        0
      }
    }
    _ -> 0
  }
}

fn pipeline_vector_fold_i64_sum_lambda(src: i64, callback: Expr) -> i64 {
  match pipeline_expr_strip_typed(callback) {
    Lambda(params, body) -> {
      match params {
        ParamListCons(first, rest) -> {
          match rest {
            ParamListCons(second, tail) -> {
              match tail {
                ParamListNil -> pipeline_vector_fold_i64_sum_body(src, body, first, second)
                _ -> 0
              }
            }
            _ -> 0
          }
        }
        _ -> 0
      }
    }
    _ -> 0
  }
}

fn pipeline_vector_fold_i64_sum_type_args(type_args: TypeExprList) -> i64 {
  if type_expr_list_len(type_args) == 2 and type_expr_list_nth_prim_id_or(type_args, 0, 0 - 1) == PRIM_I64() and type_expr_list_nth_prim_id_or(type_args, 1, 0 - 1) == PRIM_I64() { 1 } else { 0 }
}

fn pipeline_lower_vector_fold_sum_i64_typed(src: i64, ns: i64, nl: i64, args_exprs: ExprList, type_args: TypeExprList, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  if src_eq(src, ns, nl, "vector_fold") == 1 and expr_list_len(args_exprs) == 3 and pipeline_vector_fold_i64_sum_type_args(type_args) == 1 and pipeline_fns_contains_hash(pipeline_handler_lower_ctx_fns(lower_ctx), pipeline_ir_native_vector_sum_i64_hash()) == 1 {
    let callback = pipeline_expr_list_nth_or(args_exprs, 2, NilExpr)
    if pipeline_vector_fold_i64_sum_lambda(src, callback) == 1 {
      let vec_expr = pipeline_expr_list_nth_or(args_exprs, 0, NilExpr)
      let init_expr = pipeline_expr_list_nth_or(args_exprs, 1, NilExpr)
      let vec = pipeline_lower_expr_typed_sidecar_handler_ctx(vec_expr, next_value, lower_ctx)
      if ir_lowered_expr_is_valid(vec) == 1 {
        let init = pipeline_lower_expr_typed_sidecar_handler_ctx(init_expr, ir_lowered_expr_next_value(vec), lower_ctx)
        if ir_lowered_expr_is_valid(init) == 1 {
          let dst = ir_lowered_expr_next_value(init)
          let call_args = ir_value_list_prepend(ir_lowered_expr_value(vec), ir_value_list_prepend(ir_lowered_expr_value(init), ir_value_list_empty()))
          let call = ir_inst_list_prepend(ir_inst_call_i64(dst, pipeline_ir_native_vector_sum_i64_hash(), call_args), ir_inst_list_empty())
          ir_lowered_expr(dst, dst + 1, ir_inst_list_append(ir_lowered_expr_insts(vec), ir_inst_list_append(ir_lowered_expr_insts(init), call)))
        } else {
          ir_lowered_expr_invalid(next_value)
        }
      } else {
        ir_lowered_expr_invalid(next_value)
      }
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_generic_call_expr_typed_sidecar_handler_opt(type_args: TypeExprList, inner_call: Expr, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let fns = pipeline_handler_lower_ctx_fns(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  let concrete_type_args = pipeline_type_expr_list_subst(type_args, subst)
  match inner_call {
    Ident(ns, nl) -> {
      let base_hash = str_hash(src, ns, nl)
      if pipeline_generic_template_find(fns, src, base_hash) == 0 {
        ir_lowered_expr_invalid(next_value)
      } else {
        ir_lowered_expr(
          next_value,
          next_value + 1,
          ir_inst_list_prepend(ir_inst_generic_function_ref_i64(next_value, base_hash, concrete_type_args), ir_inst_list_empty())
        )
      }
    }
    Call(ns, nl, args_exprs) -> {
      if pipeline_variant_payload_count(tt, src, ns, nl) >= 0 or pipeline_call_callee_is_direct(params, locals, src, ns, nl) == 1 {
        let fold_sum = pipeline_lower_vector_fold_sum_i64_typed(src, ns, nl, args_exprs, concrete_type_args, next_value, lower_ctx)
        if ir_lowered_expr_is_valid(fold_sum) == 1 {
          fold_sum
        } else {
          let variant_payloads = pipeline_variant_payload_types(tt, src, ns, nl)
          let variant_tparams = if variant_payloads == 0 { 0 } else { ttable_variant_tparams(tt, src, ns, nl) }
          let template_pair = if variant_payloads == 0 { pipeline_generic_template_find(pipeline_handler_lower_ctx_fns(lower_ctx), src, str_hash(src, ns, nl)) } else { 0 }
          let expected_params = if template_pair == 0 { 0 } else { node_f3(pipeline_fn_inner(node_f1(template_pair))) }
          let expected_subst = if variant_payloads != 0 {
            if variant_tparams == 0 { subst } else { cg_build_subst(variant_tparams, type_expr_list_to_nodes(concrete_type_args)) }
          } else {
            if template_pair == 0 { 0 } else { cg_build_subst(fn_tparams(node_f1(template_pair)), type_expr_list_to_nodes(concrete_type_args)) }
          }
          let stable_handle_word = pipeline_collection_handle_word_stable_call(src, ns, nl, args_exprs)
          let borrowed_mask = if stable_handle_word == 1 { 1 }
          else { if variant_payloads == 0 and template_pair != 0 {
            pipeline_fn_effective_borrowable_param_mask_from_pair(fns, template_pair, expected_params, expected_subst)
          } else { 0 } }
          let args = pipeline_lower_typed_handler_opt_args_expected_borrow_mask(args_exprs, 0, next_value, lower_ctx, expected_params, variant_payloads, expected_subst, borrowed_mask)
          if pipeline_lowered_args_is_valid(args) == 1 {
            let dst = pipeline_lowered_args_next_value(args)
            let logical_args = pipeline_lowered_args_values(args)
            let abi_args = if variant_payloads != 0 {
              pipeline_call_abi_args(logical_args, 0, variant_payloads, expected_subst, 0, 0)
            } else { if template_pair != 0 and stable_handle_word == 0 {
              pipeline_call_abi_args(logical_args, expected_params, 0, expected_subst, 0, 0)
            } else { logical_args } }
            let call_head = ir_inst_list_prepend(
              if stable_handle_word == 1 {
                pipeline_collection_handle_word_inst(dst, logical_args)
              } else {
                pipeline_generic_call_inst_typed(dst, src, tt, ns, nl, concrete_type_args, abi_args)
              },
              ir_inst_list_empty()
            )
            let result_ty = if template_pair == 0 { 0 } else {
              ty_subst(fn_ret_type(node_f1(template_pair)), expected_subst)
            }
            let call = if template_pair != 0 and stable_handle_word == 0 {
              ir_inst_list_append(call_head, pipeline_ir_call_result_lane_insts(dst, result_ty))
            } else { call_head }
            let result_lanes = if template_pair != 0 and stable_handle_word == 0 { pipeline_type_value_lane_count_or_one(result_ty) } else { 1 }
            let cleanup = pipeline_managed_lambda_temp_release_args_masked_typed(args_exprs, logical_args, 0, dst + result_lanes, borrowed_mask, 0, expected_params, variant_payloads, expected_subst, pipeline_handler_lower_ctx_src(lower_ctx), pipeline_handler_lower_ctx_tt(lower_ctx))
            let insts = ir_inst_list_append(pipeline_lowered_args_insts(args), ir_inst_list_append(call, pipeline_lowered_args_insts(cleanup)))
            ir_lowered_expr(dst, pipeline_lowered_args_next_value(cleanup), insts)
          } else {
            ir_lowered_expr_invalid(next_value)
          }
        }
      } else {
        ir_lowered_expr_invalid(next_value)
      }
    }
    _ -> ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_method_call_expr_typed_sidecar_handler_opt(recv_expr: Expr, method_hash: i64, args_exprs: ExprList, method_ref: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let handlers = pipeline_handler_lower_ctx_handlers(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  let receiver = pipeline_lower_expr_typed_sidecar_handler_ctx(recv_expr, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(receiver) == 1 {
    let method_params = pipeline_method_ref_params(tt, method_ref, method_hash, subst)
    let borrowed_mask = pipeline_method_ref_borrowable_param_mask(pipeline_handler_lower_ctx_fns(lower_ctx), tt, method_ref, method_hash, subst)
    let args = pipeline_lower_typed_method_handler_opt_args_expected(args_exprs, 0, ir_lowered_expr_next_value(receiver), lower_ctx, method_params, 0, borrowed_mask)
    if pipeline_lowered_args_is_valid(args) == 1 {
      let dst = pipeline_lowered_args_next_value(args)
      let call = ir_inst_list_prepend(
        pipeline_method_call_inst(dst, method_ref, method_hash, ir_lowered_expr_value(receiver), pipeline_lowered_args_values(args), subst, tt),
        ir_inst_list_empty()
      )
      let cleanup = pipeline_managed_lambda_temp_release_args_masked_typed(args_exprs, pipeline_lowered_args_values(args), 0, dst + 1, borrowed_mask, 1, method_params, 0, 0, pipeline_handler_lower_ctx_src(lower_ctx), pipeline_handler_lower_ctx_tt(lower_ctx))
      let insts = ir_inst_list_append(ir_lowered_expr_insts(receiver), ir_inst_list_append(pipeline_lowered_args_insts(args), ir_inst_list_append(call, pipeline_lowered_args_insts(cleanup))))
      ir_lowered_expr(dst, pipeline_lowered_args_next_value(cleanup), insts)
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_array_literal_elements_straight_typed(elements: ExprList, index: i64, storage: i64, data: i64, array_ty: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  match elements {
    ExprListNil -> ir_lowered_expr(storage, next_value, ir_inst_list_empty())
    ExprListCons(element, rest) -> {
      let prim = pipeline_array_literal_element_prim(array_ty)
      let lowered = if pipeline_prim_is_forced_numeric_context(prim) == 1 {
        pipeline_lower_expr_typed_sidecar_handler_opt_with_float_prim(element, next_value, lower_ctx, prim)
      } else {
        pipeline_lower_expr_typed_sidecar_handler_ctx(element, next_value, lower_ctx)
      }
      if ir_lowered_expr_is_valid(lowered) == 0 {
        ir_lowered_expr_invalid(next_value)
      } else {
        let stored = pipeline_lower_array_literal_store_value_typed(element, ir_lowered_expr_value(lowered), data, index, array_ty, ir_lowered_expr_next_value(lowered), lower_ctx)
        if pipeline_lowered_args_is_valid(stored) == 0 {
          ir_lowered_expr_invalid(next_value)
        } else {
          let tail = pipeline_lower_array_literal_elements_straight_typed(rest, index + 1, storage, data, array_ty, pipeline_lowered_args_next_value(stored), lower_ctx)
          if ir_lowered_expr_is_valid(tail) == 0 {
            ir_lowered_expr_invalid(next_value)
          } else {
            ir_lowered_expr(
              storage,
              ir_lowered_expr_next_value(tail),
              ir_inst_list_append(ir_lowered_expr_insts(lowered), ir_inst_list_append(pipeline_lowered_args_insts(stored), ir_lowered_expr_insts(tail)))
            )
          }
        }
      }
    }
  }
}

fn pipeline_lower_array_literal_expr_typed_sidecar_handler_opt(elements: ExprList, resolved_ty: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let array_ty = ty_subst(resolved_ty, pipeline_handler_lower_ctx_subst(lower_ctx))
  let count = expr_list_len(elements)
  let storage = pipeline_lower_array_literal_storage(array_ty, count, next_value, pipeline_handler_lower_ctx_tt(lower_ctx))
  if ir_lowered_expr_is_valid(storage) == 0 {
    ir_lowered_expr_invalid(next_value)
  } else {
    let data = ir_lowered_expr_value(storage) + 6
    let values = pipeline_lower_array_literal_elements_straight_typed(elements, 0, ir_lowered_expr_value(storage), data, array_ty, ir_lowered_expr_next_value(storage), lower_ctx)
    if ir_lowered_expr_is_valid(values) == 0 {
      ir_lowered_expr_invalid(next_value)
    } else {
      ir_lowered_expr(ir_lowered_expr_value(storage), ir_lowered_expr_next_value(values), ir_inst_list_append(ir_lowered_expr_insts(storage), ir_lowered_expr_insts(values)))
    }
  }
}

fn pipeline_lower_record_fields_typed_sidecar_handler_opt(fields: RecordFieldList, type_ns: i64, type_nl: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> PipelineLoweredRecordFields {
  match fields {
    RecordFieldListNil -> pipeline_lowered_record_fields(ir_record_field_list_empty(), next_value, ir_inst_list_empty(), 1)
    RecordFieldListCons(field, rest_fields) -> {
      match field {
        RecordField(ns, nl, value_expr, fact) -> {
          let params = pipeline_handler_lower_ctx_params(lower_ctx)
          let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
          let src = pipeline_handler_lower_ctx_src(lower_ctx)
          let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
          let handlers = pipeline_handler_lower_ctx_handlers(lower_ctx)
          let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
          let value = pipeline_lower_expr_typed_sidecar_handler_ctx(value_expr, next_value, lower_ctx)
          if ir_lowered_expr_is_valid(value) == 1 {
            let field_ty = pipeline_record_field_expected_type(tt, src, type_ns, type_nl, ns, nl, subst)
            let retain = pipeline_managed_borrow_retain_arg_typed(value_expr, ir_lowered_expr_value(value), field_ty, ir_lowered_expr_next_value(value), src, pipeline_handler_lower_ctx_fns(lower_ctx), subst, tt)
            let rest = pipeline_lower_record_fields_typed_sidecar_handler_opt(rest_fields, type_ns, type_nl, pipeline_lowered_args_next_value(retain), lower_ctx)
            if pipeline_lowered_record_fields_is_valid(rest) == 1 {
              let field_hash = str_hash(src, ns, nl)
              let word_offset = pipeline_record_field_word_offset(tt, src, type_ns, type_nl, ns, nl, subst)
              let values = ir_record_field_list_append(pipeline_ir_record_field_lane_entries(field_hash, word_offset, ir_lowered_expr_value(value), field_ty), pipeline_lowered_record_fields_values(rest))
              let insts = ir_inst_list_append(ir_lowered_expr_insts(value), ir_inst_list_append(pipeline_lowered_args_insts(retain), pipeline_lowered_record_fields_insts(rest)))
              pipeline_lowered_record_fields(values, pipeline_lowered_record_fields_next_value(rest), insts, 1)
            } else {
              pipeline_lowered_record_fields_invalid(next_value)
            }
          } else {
            pipeline_lowered_record_fields_invalid(next_value)
          }
        }
        UnknownRecordField(tag) -> pipeline_lowered_record_fields_invalid(next_value)
      }
    }
  }
}

fn pipeline_lower_record_init_expr_typed_sidecar_handler_opt(type_ns: i64, type_nl: i64, fields_exprs: RecordFieldList, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let fields = pipeline_lower_record_fields_typed_sidecar_handler_opt(fields_exprs, type_ns, type_nl, next_value, lower_ctx)
  if pipeline_lowered_record_fields_is_valid(fields) == 1 {
    let dst = pipeline_lowered_record_fields_next_value(fields)
    let record_entry = ttable_lookup(pipeline_handler_lower_ctx_tt(lower_ctx), src, type_ns, type_nl)
    let record = ir_inst_list_prepend(
      pipeline_record_init_inst_for_storage_layout(
        pipeline_handler_lower_ctx_tt(lower_ctx),
        record_entry,
        pipeline_handler_lower_ctx_subst(lower_ctx),
        dst,
        str_hash(src, type_ns, type_nl),
        pipeline_lowered_record_fields_values(fields)
      ),
      ir_inst_list_empty()
    )
    let cleanup = pipeline_record_array_source_releases_for_storage_layout(
      pipeline_handler_lower_ctx_tt(lower_ctx),
      record_entry,
      pipeline_handler_lower_ctx_subst(lower_ctx),
      pipeline_lowered_record_fields_values(fields),
      dst + 1
    )
    if pipeline_lowered_args_is_valid(cleanup) == 1 {
      ir_lowered_expr(dst, pipeline_lowered_args_next_value(cleanup), ir_inst_list_append(pipeline_lowered_record_fields_insts(fields), ir_inst_list_append(record, pipeline_lowered_args_insts(cleanup))))
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_typed_field_index(tt: i64, src: i64, field_ns: i64, field_nl: i64) -> i64 {
  if tt == 0 { 0 - 1 } else { pipeline_type_find_any_field_index(tt, src, field_ns, field_nl) }
}

fn pipeline_type_field_index_for_type_hash_entries(entries: TypeEntryList, type_hash: i64, src: i64, field_ns: i64, field_nl: i64) -> i64 {
  match entries {
    TypeEntryListNil -> 0 - 1
    TypeEntryListCons(entry, rest) -> {
      match entry {
        TypeRecordEntry(name, tparams, fields) -> {
          let entry_src = type_entry_source_or(entry, 0)
          let entry_ns = type_entry_name_start_or(entry, 0)
          let entry_nl = type_entry_name_len_or(entry, 0)
          if str_hash(entry_src, entry_ns, entry_nl) == type_hash or type_name_hash(entry_src, entry_ns, entry_nl) == type_hash {
            pipeline_type_record_field_index(fields, src, field_ns, field_nl, entry_src, 0)
          } else {
            pipeline_type_field_index_for_type_hash_entries(rest, type_hash, src, field_ns, field_nl)
          }
        }
        _ -> pipeline_type_field_index_for_type_hash_entries(rest, type_hash, src, field_ns, field_nl)
      }
    }
  }
}

-- Field indices must come from the receiver's record type. The name-only
-- any-field search is only a last resort when no type fact is available;
-- with colliding field names across records it picks the wrong layout.
fn pipeline_typed_field_index_for_type_hash(tt: i64, src: i64, field_ns: i64, field_nl: i64, type_hash: i64) -> i64 {
  let typed_idx = if tt == 0 or type_hash == 0 {
    0 - 1
  } else {
    pipeline_type_field_index_for_type_hash_entries(type_entries_from_table(tt), type_hash, src, field_ns, field_nl)
  }
  if typed_idx >= 0 { typed_idx } else { pipeline_typed_field_index(tt, src, field_ns, field_nl) }
}

fn pipeline_field_base_type_hash_direct(base_expr: Expr, src: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> i64 {
  match base_expr {
    Ident(ns, nl) -> {
      let env_hash = pipeline_value_env_lookup_type_hash(locals, src, ns, nl)
      if env_hash != 0 { env_hash } else { pipeline_param_type_hash_by_name(params, src, ns, nl, pipeline_lower_module_subst(module)) }
    }
    RecordInit(type_ns, type_nl, fields) -> type_name_hash(src, type_ns, type_nl)
    _ -> 0
  }
}

fn pipeline_field_base_type_node_typed(base_expr: Expr, src: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> i64 {
  let inferred = pipeline_return_expr_type_node_typed(base_expr, params, locals, module)
  if inferred != 0 { inferred }
  else {
    let type_hash = pipeline_field_base_type_hash_direct(base_expr, src, params, locals, module)
    if type_hash == 0 { 0 } else { ty_named(type_hash, ty_i64()) }
  }
}

fn pipeline_record_instance_subst(entry: i64, base_ty: i64, fallback_subst: i64) -> i64 {
  if entry == 0 or base_ty == 0 or ty_tag(base_ty) != 9 or ty_f3(base_ty) == 0 {
    fallback_subst
  } else {
    let tparams = mem_load64_at(entry, 40)
    if tparams == 0 { fallback_subst } else { build_subst(tparams, ty_f3(base_ty)) }
  }
}

fn pipeline_typed_field_entry_for_base(tt: i64, base_ty: i64) -> i64 {
  if tt == 0 or base_ty == 0 or ty_tag(base_ty) != 9 { 0 }
  else { ttable_lookup_by_type_hash(tt, ty_f1(base_ty)) }
}

fn pipeline_record_storage_layout_for_base(tt: i64, src: i64, base_expr: Expr, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> PipelineRecordStorageLayout {
  let base_ty = pipeline_field_base_type_node_typed(base_expr, src, params, locals, module)
  let entry = pipeline_typed_field_entry_for_base(tt, base_ty)
  if entry == 0 {
    -- An unresolved/generic receiver has no concrete aggregate layout to
    -- describe here. Preserve the historical compact/name-indexed lowering;
    -- monomorphisation supplies concrete specialisations where available.
    PipelineRecordStorageLayoutCompact
  } else {
    let subst = pipeline_record_instance_subst(entry, base_ty, pipeline_lower_module_subst(module))
    pipeline_record_storage_layout_for_entry(tt, entry, subst)
  }
}

fn pipeline_record_storage_layout_for_base_node(tt: i64, src: i64, base_node: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> PipelineRecordStorageLayout {
  let stripped = pipeline_expr_node_strip_typed(base_node)
  if stripped == 0 { PipelineRecordStorageLayoutCompact }
  else { pipeline_record_storage_layout_for_base(tt, src, expr_from_node(stripped), params, locals, module) }
}

fn pipeline_typed_field_type_for_base(tt: i64, src: i64, field_ns: i64, field_nl: i64, base_expr: Expr, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> i64 {
  let base_ty = pipeline_field_base_type_node_typed(base_expr, src, params, locals, module)
  if ty_is_record(base_ty) {
    let field = ty_record_field_by_hash(ty_record_fields(base_ty), str_hash(src, field_ns, field_nl))
    if field == 0 { 0 } else { ty_record_field_type(field) }
  } else {
    let entry = pipeline_typed_field_entry_for_base(tt, base_ty)
    let subst = pipeline_record_instance_subst(entry, base_ty, pipeline_lower_module_subst(module))
    pipeline_record_field_type_in_entry(entry, src, field_ns, field_nl, subst)
  }
}

fn pipeline_typed_field_index_for_base(tt: i64, src: i64, field_ns: i64, field_nl: i64, base_expr: Expr, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> i64 {
  let base_ty = pipeline_field_base_type_node_typed(base_expr, src, params, locals, module)
  if ty_is_record(base_ty) {
    ty_record_field_word_offset(base_ty, str_hash(src, field_ns, field_nl))
  } else {
    let entry = pipeline_typed_field_entry_for_base(tt, base_ty)
    let subst = pipeline_record_instance_subst(entry, base_ty, pipeline_lower_module_subst(module))
    let word_offset = pipeline_record_field_word_offset_in_entry(entry, src, field_ns, field_nl, subst)
    if word_offset >= 0 { word_offset }
    else {
      let node_hash = if base_ty == 0 { 0 } else { type_hash_of(base_ty) }
      pipeline_typed_field_index_for_type_hash(tt, src, field_ns, field_nl, node_hash)
    }
  }
}

fn pipeline_typed_field_index_for_base_node(tt: i64, src: i64, field_ns: i64, field_nl: i64, base_node: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> i64 {
  let stripped = pipeline_expr_node_strip_typed(base_node)
  if stripped == 0 {
    pipeline_typed_field_index(tt, src, field_ns, field_nl)
  } else {
    pipeline_typed_field_index_for_base(tt, src, field_ns, field_nl, expr_from_node(stripped), params, locals, module)
  }
}

fn pipeline_typed_field_type_for_base_node(tt: i64, src: i64, field_ns: i64, field_nl: i64, base_node: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> i64 {
  let stripped = pipeline_expr_node_strip_typed(base_node)
  if stripped == 0 { 0 }
  else { pipeline_typed_field_type_for_base(tt, src, field_ns, field_nl, expr_from_node(stripped), params, locals, module) }
}

fn pipeline_lower_field_access_expr_typed_sidecar_handler_opt(base_expr: Expr, field_ns: i64, field_nl: i64, access_fact: FieldAccessFact, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let handlers = pipeline_handler_lower_ctx_handlers(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  let base = pipeline_lower_expr_typed_sidecar_handler_ctx(base_expr, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(base) == 1 {
    let inferred_base_ty = pipeline_field_base_type_node_typed(base_expr, src, params, locals, pipeline_handler_lower_ctx_module(lower_ctx))
    let fact_base_ty = field_access_fact_base_type_node(access_fact)
    let base_ty = if fact_base_ty != 0 { ty_subst(fact_base_ty, subst) } else { inferred_base_ty }
    let structural = if field_access_fact_is_structural(access_fact) == 1 or ty_is_record(base_ty) { 1 } else { 0 }
    let dst = ir_lowered_expr_next_value(base)
    let fact_field_ty = field_access_fact_field_type_node(access_fact)
    let field_ty = if fact_field_ty != 0 { ty_subst(fact_field_ty, subst) } else { pipeline_typed_field_type_for_base(tt, src, field_ns, field_nl, base_expr, params, locals, pipeline_handler_lower_ctx_module(lower_ctx)) }
    let field_offset = field_access_fact_word_offset_or(access_fact, pipeline_typed_field_index_for_base(tt, src, field_ns, field_nl, base_expr, params, locals, pipeline_handler_lower_ctx_module(lower_ctx)))
    if structural == 1 {
      ir_lowered_expr(ir_lowered_expr_value(base) + field_offset, ir_lowered_expr_next_value(base), ir_lowered_expr_insts(base))
    } else {
      let storage_layout = pipeline_record_storage_layout_for_base(tt, src, base_expr, params, locals, pipeline_handler_lower_ctx_module(lower_ctx))
      let field = pipeline_lower_field_load_for_storage_layout(dst, ir_lowered_expr_value(base), str_hash(src, field_ns, field_nl), field_offset, field_ty, storage_layout)
      ir_lowered_expr(ir_lowered_expr_value(field), ir_lowered_expr_next_value(field), ir_inst_list_append(ir_lowered_expr_insts(base), ir_lowered_expr_insts(field)))
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

-- Consume the checker-produced indexed-length fact. A fixed array's length is
-- constant, but its base expression still evaluates; an owned temporary
-- backing is released afterward. A slice is non-owning and its length is the
-- secondary ABI lane already produced by lowering its base.
fn pipeline_lower_indexed_len_after_base_typed(base_expr: Expr, fixed_len: i64, base_value: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  if fixed_len < 0 {
    ir_lowered_expr(base_value + 1, next_value, ir_inst_list_empty())
  } else {
    let result = next_value
    let borrowed = pipeline_array_expr_result_is_borrowed_typed(
      base_expr,
      pipeline_handler_lower_ctx_src(lower_ctx),
      pipeline_handler_lower_ctx_fns(lower_ctx),
      pipeline_handler_lower_ctx_subst(lower_ctx),
      pipeline_handler_lower_ctx_tt(lower_ctx)
    )
    let release = if borrowed == 0 {
      ir_inst_list_prepend(ir_inst_call_i64(result + 1, pipeline_rc_default_release_hash(), ir_value_list_prepend(base_value, ir_value_list_empty())), ir_inst_list_empty())
    } else { ir_inst_list_empty() }
    let next = if borrowed == 0 { result + 2 } else { result + 1 }
    ir_lowered_expr(result, next, ir_inst_list_prepend(ir_inst_const_i64(result, fixed_len), release))
  }
}

fn pipeline_lower_indexed_len_expr_typed_sidecar_handler_opt(base_expr: Expr, fixed_len: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let base = pipeline_lower_expr_typed_sidecar_handler_ctx(base_expr, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(base) == 1 {
    let result = pipeline_lower_indexed_len_after_base_typed(base_expr, fixed_len, ir_lowered_expr_value(base), ir_lowered_expr_next_value(base), lower_ctx)
    ir_lowered_expr(ir_lowered_expr_value(result), ir_lowered_expr_next_value(result), ir_inst_list_append(ir_lowered_expr_insts(base), ir_lowered_expr_insts(result)))
  } else { ir_lowered_expr_invalid(next_value) }
}

fn pipeline_lower_indexed_len_typed_to_target_blocks(base_expr: Expr, fixed_len: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  if pipeline_expr_needs_cfg_typed(base_expr) == 0 {
    pipeline_lower_straight_expr_typed_to_target_blocks(IndexedLen(base_expr, fixed_len), params, locals, module, next_value, start_block, next_block, target_block)
  } else {
    let base_merge_block = next_block
    let base_blocks = pipeline_lower_expr_typed_to_target_blocks_reserved(base_expr, params, locals, module, next_value, start_block, next_block + 1, base_merge_block)
    if pipeline_lowered_blocks_is_valid(base_blocks) == 1 {
      if pipeline_lowered_blocks_falls_through(base_blocks) == 0 { base_blocks }
      else {
        let base_value = pipeline_lowered_blocks_next_value(base_blocks)
        let base_lanes = if fixed_len < 0 { 2 } else { 1 }
        let result = pipeline_lower_indexed_len_after_base_typed(base_expr, fixed_len, base_value, base_value + base_lanes, pipeline_handler_lower_ctx_from_module(params, locals, module))
        let merge = ir_block_new_params(
          base_merge_block,
          pipeline_ir_value_lane_ids(base_value, 0, base_lanes),
          ir_lowered_expr_insts(result),
          ir_term_jump_args(target_block, ir_value_list_prepend(ir_lowered_expr_value(result), ir_value_list_empty()))
        )
        pipeline_lowered_blocks(
          pipeline_lowered_blocks_next_block(base_blocks),
          ir_lowered_expr_next_value(result),
          ir_block_list_append(pipeline_lowered_blocks_blocks(base_blocks), ir_block_list_prepend(merge, ir_block_list_empty())),
          1
        )
      }
    } else { pipeline_lowered_blocks_invalid(start_block, next_value) }
  }
}

fn pipeline_indexed_element_stride(tt: i64, element_ty: i64) -> i64 {
  let size = cg_layout_indexed_element_size(tt, element_ty)
  let align = cg_layout_indexed_element_align(tt, element_ty)
  if size <= 0 or align <= 0 { 0 - 1 } else { cg_layout_align_up(size, align) }
}

fn pipeline_index_address_args(data: i64, len: i64, index: i64, stride: i64) -> IrValueList {
  ir_value_list_prepend(data, ir_value_list_prepend(len, ir_value_list_prepend(index, ir_value_list_prepend(stride, ir_value_list_empty()))))
}

fn pipeline_slice_address_args(owner: i64, data: i64, len: i64, start: i64, end: i64, stride: i64) -> IrValueList {
  ir_value_list_prepend(owner, ir_value_list_prepend(data, ir_value_list_prepend(len, ir_value_list_prepend(start, ir_value_list_prepend(end, ir_value_list_prepend(stride, ir_value_list_empty()))))))
}

fn pipeline_indexed_slice_fact_element_ty(fact: i64) -> i64 {
  if fact == 0 { 0 } else { node_f1(fact) }
}

fn pipeline_indexed_slice_fact_fixed_len(fact: i64) -> i64 {
  if fact == 0 { 0 - 2 } else { node_f2(fact) }
}

fn pipeline_indexed_slice_fact_base_ty(fact: i64) -> i64 {
  if fact == 0 { 0 } else { node_f3(fact) }
}

fn pipeline_indexed_slice_fact_mutable(fact: i64) -> i64 {
  if fact == 0 { 0 } else { node_f4(fact) }
}

fn pipeline_type_is_vector(ty: i64) -> i64 {
  if ty == 0 or ty_tag(ty) != 9 { 0 }
  else { if ty_f1(ty) == str_hash(__str_ptr("Vector"), 0, __str_len("Vector")) { 1 } else { 0 } }
}

fn pipeline_vector_data_hash() -> i64 {
  str_hash(__str_ptr("vector_data"), 0, __str_len("vector_data"))
}

fn pipeline_indexed_slice_base_lane_count(fact: i64, subst: i64) -> i64 {
  let base_ty = ty_subst(pipeline_indexed_slice_fact_base_ty(fact), subst)
  if ty_is_slice(base_ty) { 2 } else { 1 }
}

-- Construct a non-owning (data, len) pair from checker-produced storage and
-- mutability facts. The runtime call remains an explicit semantic seam so the
-- borrow pass can rebase provenance after optimisation.
fn pipeline_lower_indexed_slice_after_values_typed(base_expr: Expr, start_expr: Expr, end_expr: Expr, fact: i64, base_value: i64, start_value: i64, end_value: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  let element_ty = ty_subst(pipeline_indexed_slice_fact_element_ty(fact), subst)
  let base_ty = ty_subst(pipeline_indexed_slice_fact_base_ty(fact), subst)
  let fixed_len = pipeline_indexed_slice_fact_fixed_len(fact)
  let mutable = pipeline_indexed_slice_fact_mutable(fact)
  let stride = pipeline_indexed_element_stride(tt, element_ty)
  if fact == 0 or stride <= 0 { ir_lowered_expr_invalid(next_value) }
  else {
    let mut insts = ir_inst_list_empty()
    let mut cursor = next_value
    let mut owner = base_value
    let mut data = base_value
    let mut len = base_value + 1
    if pipeline_type_is_vector(base_ty) == 1 {
      let type_args = ty_f3(base_ty)
      data = cursor
      len = cursor + 1
      insts = ir_inst_list_prepend(
        ir_inst_generic_call_i64(data, pipeline_vector_data_hash(), type_args, ir_value_list_prepend(base_value, ir_value_list_empty())),
        ir_inst_list_prepend(
          ir_inst_generic_call_i64(len, pipeline_ir_vector_len_hash(), type_args, ir_value_list_prepend(base_value, ir_value_list_empty())),
          ir_inst_list_empty()
        )
      )
      cursor = cursor + 2
    } else { if fixed_len >= 0 {
      if mutable == 1 {
        let storage = pipeline_lower_array_literal_storage(base_ty, fixed_len, cursor, tt)
        if ir_lowered_expr_is_valid(storage) == 0 { return ir_lowered_expr_invalid(next_value) }
        owner = ir_lowered_expr_value(storage)
        data = ir_lowered_expr_next_value(storage) - 1
        cursor = ir_lowered_expr_next_value(storage)
        let old_data = cursor
        cursor = cursor + 1
        let total_size = cg_layout_storage_size(tt, base_ty)
        let leaf_count = cg_layout_array_leaf_count(base_ty)
        let leaf_stride = pipeline_array_literal_leaf_stride(tt, base_ty)
        let leaf_kind = pipeline_array_literal_leaf_kind(tt, base_ty)
        if pipeline_array_copy_plan_is_valid(total_size, leaf_count, leaf_stride, leaf_kind) == 0 { return ir_lowered_expr_invalid(next_value) }
        match base_expr {
          Ident(ns, nl) -> {
            let slot = pipeline_value_env_lookup(pipeline_handler_lower_ctx_locals(lower_ctx), pipeline_handler_lower_ctx_src(lower_ctx), ns, nl)
            if slot < 0 { return ir_lowered_expr_invalid(next_value) }
            insts = ir_inst_list_append(
              ir_lowered_expr_insts(storage),
              ir_inst_list_prepend(
                ir_inst_call_i64(old_data, pipeline_rc_array_storage_data_hash(), ir_value_list_prepend(base_value, ir_value_list_empty())),
                ir_inst_list_prepend(
                  ir_inst_array_copy_i64(data, old_data, total_size, leaf_count, leaf_stride, leaf_kind),
                  ir_inst_list_prepend(
                    ir_inst_store_i64(slot, owner),
                    ir_inst_list_prepend(ir_inst_call_i64(cursor, pipeline_rc_default_release_hash(), ir_value_list_prepend(base_value, ir_value_list_empty())), ir_inst_list_empty())
                  )
                )
              )
            )
            cursor = cursor + 1
          }
          _ -> return ir_lowered_expr_invalid(next_value)
        }
      } else {
        data = cursor
        insts = ir_inst_list_prepend(ir_inst_call_i64(data, pipeline_rc_array_storage_data_hash(), ir_value_list_prepend(base_value, ir_value_list_empty())), ir_inst_list_empty())
        cursor = cursor + 1
      }
      len = cursor
      insts = ir_inst_list_append(insts, ir_inst_list_prepend(ir_inst_const_i64(len, fixed_len), ir_inst_list_empty()))
      cursor = cursor + 1
    } else { 0 } }
    let actual_start = start_value
    let actual_end = if pipeline_expr_is_nil_lit(end_expr) == 1 { len } else { end_value }
    let stride_value = cursor
    let result = stride_value + 1
    let result_len = result + 1
    let call_hash = if mutable == 1 { pipeline_runtime_mut_slice_address_hash() } else { pipeline_runtime_slice_address_hash() }
    let finish = ir_inst_list_prepend(
      ir_inst_const_i64(stride_value, stride),
      ir_inst_list_prepend(
        ir_inst_call_i64(result, call_hash, pipeline_slice_address_args(owner, data, len, actual_start, actual_end, stride_value)),
        ir_inst_list_prepend(ir_inst_float_binary_i64(result_len, PRIM_USIZE(), IrSub, actual_end, actual_start), ir_inst_list_empty())
      )
    )
    ir_lowered_expr(result, result + 2, ir_inst_list_append(insts, finish))
  }
}

fn pipeline_lower_indexed_slice_expr_typed_sidecar_handler_opt(base_expr: Expr, start_expr: Expr, end_expr: Expr, fact: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let base = pipeline_lower_expr_typed_sidecar_handler_ctx(base_expr, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(base) == 0 { ir_lowered_expr_invalid(next_value) }
  else {
    let start = pipeline_lower_expr_typed_sidecar_handler_opt_with_float_prim(start_expr, ir_lowered_expr_next_value(base), lower_ctx, PRIM_USIZE())
    if ir_lowered_expr_is_valid(start) == 0 { ir_lowered_expr_invalid(next_value) }
    else {
      let end = pipeline_lower_expr_typed_sidecar_handler_opt_with_float_prim(end_expr, ir_lowered_expr_next_value(start), lower_ctx, PRIM_USIZE())
      if ir_lowered_expr_is_valid(end) == 0 { ir_lowered_expr_invalid(next_value) }
      else {
        let sliced = pipeline_lower_indexed_slice_after_values_typed(base_expr, start_expr, end_expr, fact, ir_lowered_expr_value(base), ir_lowered_expr_value(start), ir_lowered_expr_value(end), ir_lowered_expr_next_value(end), lower_ctx)
        ir_lowered_expr(ir_lowered_expr_value(sliced), ir_lowered_expr_next_value(sliced), ir_inst_list_append(ir_lowered_expr_insts(base), ir_inst_list_append(ir_lowered_expr_insts(start), ir_inst_list_append(ir_lowered_expr_insts(end), ir_lowered_expr_insts(sliced)))))
      }
    }
  }
}

fn pipeline_lower_indexed_slice_typed_to_target_blocks(base_expr: Expr, start_expr: Expr, end_expr: Expr, fact: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  if pipeline_expr_needs_lowering_cfg_typed(base_expr, src) == 0 and pipeline_expr_needs_lowering_cfg_typed(start_expr, src) == 0 and pipeline_expr_needs_lowering_cfg_typed(end_expr, src) == 0 {
    pipeline_lower_straight_expr_typed_to_target_blocks(IndexedSlice(base_expr, start_expr, end_expr, fact), params, locals, module, next_value, start_block, next_block, target_block)
  } else {
    let fixed_len = pipeline_indexed_slice_fact_fixed_len(fact)
    let base_merge_block = next_block
    let base_blocks = pipeline_lower_expr_typed_to_target_blocks_reserved(base_expr, params, locals, module, next_value, start_block, next_block + 1, base_merge_block)
    if pipeline_lowered_blocks_is_valid(base_blocks) == 0 { pipeline_lowered_blocks_invalid(start_block, next_value) }
    else { if pipeline_lowered_blocks_falls_through(base_blocks) == 0 { base_blocks }
    else {
      let base_value = pipeline_lowered_blocks_next_value(base_blocks)
      let base_lanes = pipeline_indexed_slice_base_lane_count(fact, pipeline_lower_module_subst(module))
      let start_start = pipeline_lowered_blocks_next_block(base_blocks)
      let start_merge_block = start_start + 1
      let start_blocks = pipeline_lower_expr_typed_to_target_blocks_reserved(start_expr, params, locals, module, base_value + base_lanes, start_start, start_start + 2, start_merge_block)
      let base_merge = ir_block_new_params(base_merge_block, pipeline_ir_value_lane_ids(base_value, 0, base_lanes), ir_inst_list_empty(), ir_term_jump(start_start))
      let base_prefix = ir_block_list_append(pipeline_lowered_blocks_blocks(base_blocks), ir_block_list_prepend(base_merge, ir_block_list_empty()))
      if pipeline_lowered_blocks_is_valid(start_blocks) == 0 { pipeline_lowered_blocks_invalid(start_block, next_value) }
      else { if pipeline_lowered_blocks_falls_through(start_blocks) == 0 {
        pipeline_lowered_blocks_control(pipeline_lowered_blocks_next_block(start_blocks), pipeline_lowered_blocks_next_value(start_blocks), ir_block_list_append(base_prefix, pipeline_lowered_blocks_blocks(start_blocks)), 1, 0)
      } else {
        let start_value = pipeline_lowered_blocks_next_value(start_blocks)
        let end_start = pipeline_lowered_blocks_next_block(start_blocks)
        let end_merge_block = end_start + 1
        let end_blocks = pipeline_lower_expr_typed_to_target_blocks_reserved(end_expr, params, locals, module, start_value + 1, end_start, end_start + 2, end_merge_block)
        let start_merge = ir_block_new_params(start_merge_block, ir_value_list_prepend(start_value, ir_value_list_empty()), ir_inst_list_empty(), ir_term_jump(end_start))
        let start_prefix = ir_block_list_append(base_prefix, ir_block_list_append(pipeline_lowered_blocks_blocks(start_blocks), ir_block_list_prepend(start_merge, ir_block_list_empty())))
        if pipeline_lowered_blocks_is_valid(end_blocks) == 0 { pipeline_lowered_blocks_invalid(start_block, next_value) }
        else { if pipeline_lowered_blocks_falls_through(end_blocks) == 0 {
          pipeline_lowered_blocks_control(pipeline_lowered_blocks_next_block(end_blocks), pipeline_lowered_blocks_next_value(end_blocks), ir_block_list_append(start_prefix, pipeline_lowered_blocks_blocks(end_blocks)), 1, 0)
        } else {
          let end_value = pipeline_lowered_blocks_next_value(end_blocks)
          let sliced = pipeline_lower_indexed_slice_after_values_typed(base_expr, start_expr, end_expr, fact, base_value, start_value, end_value, end_value + 1, pipeline_handler_lower_ctx_from_module(params, locals, module))
          let end_merge = ir_block_new_params(
            end_merge_block,
            ir_value_list_prepend(end_value, ir_value_list_empty()),
            ir_lowered_expr_insts(sliced),
            ir_term_jump_args(target_block, pipeline_ir_value_lane_ids(ir_lowered_expr_value(sliced), 0, 2))
          )
          let blocks = ir_block_list_append(start_prefix, ir_block_list_append(pipeline_lowered_blocks_blocks(end_blocks), ir_block_list_prepend(end_merge, ir_block_list_empty())))
          pipeline_lowered_blocks(pipeline_lowered_blocks_next_block(end_blocks), ir_lowered_expr_next_value(sliced), blocks, 1)
        } }
      } }
    } }
  }
}

fn pipeline_lower_indexed_slice_value(address: i64, next_value: i64) -> IrLoweredExpr {
  let lane_offset = next_value
  let second_address = lane_offset + 1
  let lane_size = second_address + 1
  let lane_mode = lane_size + 1
  let result = lane_mode + 1
  let first_args = ir_value_list_prepend(address, ir_value_list_prepend(lane_size, ir_value_list_prepend(lane_mode, ir_value_list_empty())))
  let second_args = ir_value_list_prepend(second_address, ir_value_list_prepend(lane_size, ir_value_list_prepend(lane_mode, ir_value_list_empty())))
  let insts = ir_inst_list_prepend(
    ir_inst_const_i64(lane_offset, 8),
    ir_inst_list_prepend(
      ir_inst_binary_i64(second_address, ir_binary_op_add(), address, lane_offset),
      ir_inst_list_prepend(
        ir_inst_const_i64(lane_size, 8),
        ir_inst_list_prepend(
          ir_inst_const_i64(lane_mode, 0),
          ir_inst_list_prepend(
            ir_inst_call_i64(result, pipeline_ir_native_intrinsic_mem_load_sized_hash(), first_args),
            ir_inst_list_prepend(ir_inst_call_i64(result + 1, pipeline_ir_native_intrinsic_mem_load_sized_hash(), second_args), ir_inst_list_empty())
          )
        )
      )
    )
  )
  ir_lowered_expr(result, result + 2, insts)
}

-- Consume only checker-produced indexed-storage facts. The runtime boundary
-- owns the unsigned bounds check and canonical panic; layout, ownership, and
-- nested-array value copying stay explicit in typed lowering.
fn pipeline_lower_indexed_get_after_values_typed_with_release(element_ty: i64, fixed_len: i64, base_value: i64, index_value: i64, next_value: i64, release_base: i64, address_hash: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let concrete_element_ty = ty_subst(element_ty, pipeline_handler_lower_ctx_subst(lower_ctx))
  let stride = pipeline_indexed_element_stride(tt, concrete_element_ty)
  let size = cg_layout_indexed_element_size(tt, concrete_element_ty)
  if stride <= 0 or size <= 0 { ir_lowered_expr_invalid(next_value) }
  else {
    let data_value = if fixed_len < 0 { base_value } else { next_value }
    let data_insts = if fixed_len < 0 { ir_inst_list_empty() }
      else { ir_inst_list_prepend(ir_inst_call_i64(data_value, pipeline_rc_array_storage_data_hash(), ir_value_list_prepend(base_value, ir_value_list_empty())), ir_inst_list_empty()) }
    let after_data = if fixed_len < 0 { next_value } else { next_value + 1 }
    let len_value = if fixed_len < 0 { base_value + 1 } else { after_data }
    let len_insts = if fixed_len < 0 { ir_inst_list_empty() }
      else { ir_inst_list_prepend(ir_inst_const_i64(len_value, fixed_len), ir_inst_list_empty()) }
    let after_len = if fixed_len < 0 { after_data } else { after_data + 1 }
    let stride_value = after_len
    let address = stride_value + 1
    let address_insts = ir_inst_list_prepend(
      ir_inst_const_i64(stride_value, stride),
      ir_inst_list_prepend(ir_inst_call_i64(address, address_hash, pipeline_index_address_args(data_value, len_value, index_value, stride_value)), ir_inst_list_empty())
    )
    let after_address = address + 1
    let loaded = if ty_is_array(concrete_element_ty) {
      let storage = pipeline_lower_array_literal_storage(concrete_element_ty, ty_array_length(concrete_element_ty), after_address, tt)
      if ir_lowered_expr_is_valid(storage) == 0 { ir_lowered_expr_invalid(after_address) }
      else {
        let leaf_count = cg_layout_array_leaf_count(concrete_element_ty)
        let leaf_stride = pipeline_array_literal_leaf_stride(tt, concrete_element_ty)
        let leaf_kind = pipeline_array_literal_leaf_kind(tt, concrete_element_ty)
        if pipeline_array_copy_plan_is_valid(size, leaf_count, leaf_stride, leaf_kind) == 0 { ir_lowered_expr_invalid(after_address) }
        else {
          let dest_data = ir_lowered_expr_next_value(storage) - 1
          let copy = ir_inst_list_prepend(ir_inst_array_copy_i64(dest_data, address, size, leaf_count, leaf_stride, leaf_kind), ir_inst_list_empty())
          ir_lowered_expr(ir_lowered_expr_value(storage), ir_lowered_expr_next_value(storage), ir_inst_list_append(ir_lowered_expr_insts(storage), copy))
        }
      }
    } else { if ty_is_slice(concrete_element_ty) {
      pipeline_lower_indexed_slice_value(address, after_address)
    } else { if cg_layout_vector_record_inline_eligible(tt, concrete_element_ty) == 1 {
      let size_value = after_address
      let mode_value = size_value + 1
      let result = mode_value + 1
      let type_args = nlist_new_capacity(1)
      nlist_add(type_args, concrete_element_ty)
      let load_args = ir_value_list_prepend(address, ir_value_list_prepend(size_value, ir_value_list_prepend(mode_value, ir_value_list_empty())))
      let load = ir_inst_list_prepend(
        ir_inst_const_i64(size_value, size),
        ir_inst_list_prepend(
          ir_inst_const_i64(mode_value, cg_layout_indexed_element_mode(tt, concrete_element_ty)),
          ir_inst_list_prepend(ir_inst_generic_call_i64(result, pipeline_ir_native_vector_storage_load_value_in_bounds_hash(), type_args, load_args), ir_inst_list_empty())
        )
      )
      ir_lowered_expr(result, result + 1, load)
    } else {
      let size_value = after_address
      let mode_value = size_value + 1
      let result = mode_value + 1
      let load_args = ir_value_list_prepend(address, ir_value_list_prepend(size_value, ir_value_list_prepend(mode_value, ir_value_list_empty())))
      let load = ir_inst_list_prepend(
        ir_inst_const_i64(size_value, size),
        ir_inst_list_prepend(
          ir_inst_const_i64(mode_value, cg_layout_indexed_element_mode(tt, concrete_element_ty)),
          ir_inst_list_prepend(ir_inst_call_i64(result, pipeline_ir_native_intrinsic_mem_load_sized_hash(), load_args), ir_inst_list_empty())
        )
      )
      let retain = pipeline_managed_retain_inst_list(result, concrete_element_ty, result + 1)
      let after_retain = result + 1 + ir_inst_list_len(retain)
      ir_lowered_expr(result, after_retain, ir_inst_list_append(load, retain))
    } } }
    if ir_lowered_expr_is_valid(loaded) == 0 { loaded }
    else {
      let release_dst = ir_lowered_expr_next_value(loaded)
      let release = if release_base == 1 {
        ir_inst_list_prepend(ir_inst_call_i64(release_dst, pipeline_rc_default_release_hash(), ir_value_list_prepend(base_value, ir_value_list_empty())), ir_inst_list_empty())
      } else { ir_inst_list_empty() }
      let next = if release_base == 1 { release_dst + 1 } else { release_dst }
      let prefix = ir_inst_list_append(data_insts, ir_inst_list_append(len_insts, address_insts))
      ir_lowered_expr(ir_lowered_expr_value(loaded), next, ir_inst_list_append(prefix, ir_inst_list_append(ir_lowered_expr_insts(loaded), release)))
    }
  }
}

fn pipeline_lower_indexed_get_after_values_typed(base_expr: Expr, index_expr: Expr, element_ty: i64, fixed_len: i64, base_value: i64, index_value: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let borrowed_base = if fixed_len < 0 { 1 }
    else { pipeline_array_expr_result_is_borrowed_typed(base_expr, pipeline_handler_lower_ctx_src(lower_ctx), pipeline_handler_lower_ctx_fns(lower_ctx), pipeline_handler_lower_ctx_subst(lower_ctx), pipeline_handler_lower_ctx_tt(lower_ctx)) }
  pipeline_lower_indexed_get_after_values_typed_with_release(element_ty, fixed_len, base_value, index_value, next_value, if borrowed_base == 0 { 1 } else { 0 }, pipeline_runtime_index_address_hash(), lower_ctx)
}

fn pipeline_lower_indexed_get_expr_typed_sidecar_handler_opt(base_expr: Expr, index_expr: Expr, element_ty: i64, fixed_len: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let base = pipeline_lower_expr_typed_sidecar_handler_ctx(base_expr, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(base) == 0 { ir_lowered_expr_invalid(next_value) }
  else {
    let index = pipeline_lower_expr_typed_sidecar_handler_ctx(index_expr, ir_lowered_expr_next_value(base), lower_ctx)
    if ir_lowered_expr_is_valid(index) == 0 { ir_lowered_expr_invalid(next_value) }
    else {
      let loaded = pipeline_lower_indexed_get_after_values_typed(base_expr, index_expr, element_ty, fixed_len, ir_lowered_expr_value(base), ir_lowered_expr_value(index), ir_lowered_expr_next_value(index), lower_ctx)
      ir_lowered_expr(ir_lowered_expr_value(loaded), ir_lowered_expr_next_value(loaded), ir_inst_list_append(ir_lowered_expr_insts(base), ir_inst_list_append(ir_lowered_expr_insts(index), ir_lowered_expr_insts(loaded))))
    }
  }
}

fn pipeline_lower_indexed_get_typed_to_target_blocks(base_expr: Expr, index_expr: Expr, element_ty: i64, fixed_len: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  if pipeline_expr_needs_lowering_cfg_typed(base_expr, pipeline_lower_module_src(module)) == 0 and pipeline_expr_needs_lowering_cfg_typed(index_expr, pipeline_lower_module_src(module)) == 0 {
    pipeline_lower_straight_expr_typed_to_target_blocks(IndexedGet(base_expr, index_expr, element_ty, fixed_len), params, locals, module, next_value, start_block, next_block, target_block)
  } else {
    let base_merge_block = next_block
    let base_blocks = pipeline_lower_expr_typed_to_target_blocks_reserved(base_expr, params, locals, module, next_value, start_block, next_block + 1, base_merge_block)
    if pipeline_lowered_blocks_is_valid(base_blocks) == 0 { pipeline_lowered_blocks_invalid(start_block, next_value) }
    else { if pipeline_lowered_blocks_falls_through(base_blocks) == 0 { base_blocks }
    else {
      let base_value = pipeline_lowered_blocks_next_value(base_blocks)
      let base_lanes = if fixed_len < 0 { 2 } else { 1 }
      let index_start = pipeline_lowered_blocks_next_block(base_blocks)
      let index_merge_block = index_start + 1
      let index_blocks = pipeline_lower_expr_typed_to_target_blocks_reserved(index_expr, params, locals, module, base_value + base_lanes, index_start, index_start + 2, index_merge_block)
      let base_merge = ir_block_new_params(base_merge_block, pipeline_ir_value_lane_ids(base_value, 0, base_lanes), ir_inst_list_empty(), ir_term_jump(index_start))
      if pipeline_lowered_blocks_is_valid(index_blocks) == 0 { pipeline_lowered_blocks_invalid(start_block, next_value) }
      else { if pipeline_lowered_blocks_falls_through(index_blocks) == 0 {
        pipeline_lowered_blocks_control(pipeline_lowered_blocks_next_block(index_blocks), pipeline_lowered_blocks_next_value(index_blocks), ir_block_list_append(pipeline_lowered_blocks_blocks(base_blocks), ir_block_list_prepend(base_merge, pipeline_lowered_blocks_blocks(index_blocks))), 1, 0)
      } else {
        let index_value = pipeline_lowered_blocks_next_value(index_blocks)
        let loaded = pipeline_lower_indexed_get_after_values_typed(base_expr, index_expr, element_ty, fixed_len, base_value, index_value, index_value + 1, pipeline_handler_lower_ctx_from_module(params, locals, module))
        let result_lanes = pipeline_type_value_lane_count_or_one(ty_subst(element_ty, pipeline_lower_module_subst(module)))
        let result_args = pipeline_ir_value_lane_ids(ir_lowered_expr_value(loaded), 0, result_lanes)
        let merge = ir_block_new_params(index_merge_block, ir_value_list_prepend(index_value, ir_value_list_empty()), ir_lowered_expr_insts(loaded), ir_term_jump_args(target_block, result_args))
        let blocks = ir_block_list_append(pipeline_lowered_blocks_blocks(base_blocks), ir_block_list_prepend(base_merge, ir_block_list_append(pipeline_lowered_blocks_blocks(index_blocks), ir_block_list_prepend(merge, ir_block_list_empty()))))
        pipeline_lowered_blocks(pipeline_lowered_blocks_next_block(index_blocks), ir_lowered_expr_next_value(loaded), blocks, 1)
      } }
    } }
  }
}

fn pipeline_indexed_set_fact_element_ty(fact: i64) -> i64 {
  if fact == 0 { 0 } else { node_f1(fact) }
}

fn pipeline_indexed_set_fact_fixed_len(fact: i64) -> i64 {
  if fact == 0 { 0 - 2 } else { node_f2(fact) }
}

fn pipeline_indexed_set_fact_base_ty(fact: i64) -> i64 {
  if fact == 0 { 0 } else { node_f3(fact) }
}

fn pipeline_lower_indexed_scalar_overwrite(value_expr: Expr, element_ty: i64, address: i64, value: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let size = cg_layout_indexed_element_size(tt, element_ty)
  if size <= 0 { ir_lowered_expr_invalid(next_value) }
  else { if cg_layout_vector_record_inline_eligible(tt, element_ty) == 1 {
    let size_value = next_value
    let mode_value = size_value + 1
    let store_dst = mode_value + 1
    let type_args = nlist_new_capacity(1)
    nlist_add(type_args, element_ty)
    let store_args = ir_value_list_prepend(address, ir_value_list_prepend(size_value, ir_value_list_prepend(mode_value, ir_value_list_prepend(value, ir_value_list_empty()))))
    let borrowed = pipeline_expr_result_is_borrowed_for_ty_typed(value_expr, element_ty, pipeline_handler_lower_ctx_src(lower_ctx), pipeline_handler_lower_ctx_fns(lower_ctx), pipeline_handler_lower_ctx_subst(lower_ctx), tt)
    let release = if borrowed == 0 {
      ir_inst_list_prepend(ir_inst_call_i64(store_dst + 1, pipeline_rc_default_release_hash(), ir_value_list_prepend(value, ir_value_list_empty())), ir_inst_list_empty())
    } else { ir_inst_list_empty() }
    let nil_value = if borrowed == 0 { store_dst + 2 } else { store_dst + 1 }
    let insts = ir_inst_list_prepend(
      ir_inst_const_i64(size_value, size),
      ir_inst_list_prepend(
        ir_inst_const_i64(mode_value, cg_layout_indexed_element_mode(tt, element_ty)),
        ir_inst_list_prepend(
          ir_inst_generic_call_i64(store_dst, pipeline_ir_native_vector_storage_store_value_hash(), type_args, store_args),
          ir_inst_list_append(release, ir_inst_list_prepend(ir_inst_const_i64(nil_value, 0), ir_inst_list_empty()))
        )
      )
    )
    ir_lowered_expr(nil_value, nil_value + 1, insts)
  } else {
    let mut insts = ir_inst_list_empty()
    let mut cursor = next_value
    let size_value = cursor
    cursor = cursor + 1
    let mode_value = cursor
    cursor = cursor + 1
    insts = ir_inst_list_append(insts, ir_inst_list_prepend(ir_inst_const_i64(size_value, size), ir_inst_list_prepend(ir_inst_const_i64(mode_value, cg_layout_indexed_element_mode(tt, element_ty)), ir_inst_list_empty())))
    let drop_kind = cg_managed_drop_kind_for_ty(element_ty)
    let retain_hash = pipeline_managed_retain_hash_for_kind(drop_kind)
    let release_hash = pipeline_managed_release_hash_for_kind(drop_kind)
    if retain_hash != 0 {
      insts = ir_inst_list_append(insts, ir_inst_list_prepend(ir_inst_call_i64(cursor, retain_hash, ir_value_list_prepend(value, ir_value_list_empty())), ir_inst_list_empty()))
      cursor = cursor + 1
    } else { 0 }
    let old_value = cursor
    if release_hash != 0 {
      let load_args = ir_value_list_prepend(address, ir_value_list_prepend(size_value, ir_value_list_prepend(mode_value, ir_value_list_empty())))
      insts = ir_inst_list_append(insts, ir_inst_list_prepend(ir_inst_call_i64(old_value, pipeline_ir_native_intrinsic_mem_load_sized_hash(), load_args), ir_inst_list_empty()))
      cursor = cursor + 1
    } else { 0 }
    let store_args = ir_value_list_prepend(address, ir_value_list_prepend(size_value, ir_value_list_prepend(mode_value, ir_value_list_prepend(value, ir_value_list_empty()))))
    insts = ir_inst_list_append(insts, ir_inst_list_prepend(ir_inst_call_i64(cursor, pipeline_ir_native_intrinsic_mem_store_sized_hash(), store_args), ir_inst_list_empty()))
    cursor = cursor + 1
    if release_hash != 0 {
      insts = ir_inst_list_append(insts, ir_inst_list_prepend(ir_inst_call_i64(cursor, release_hash, ir_value_list_prepend(old_value, ir_value_list_empty())), ir_inst_list_empty()))
      cursor = cursor + 1
      let borrowed = pipeline_expr_result_is_borrowed_for_ty_typed(value_expr, element_ty, pipeline_handler_lower_ctx_src(lower_ctx), pipeline_handler_lower_ctx_fns(lower_ctx), pipeline_handler_lower_ctx_subst(lower_ctx), tt)
      if borrowed == 0 {
        insts = ir_inst_list_append(insts, ir_inst_list_prepend(ir_inst_call_i64(cursor, release_hash, ir_value_list_prepend(value, ir_value_list_empty())), ir_inst_list_empty()))
        cursor = cursor + 1
      } else { 0 }
    } else { 0 }
    let nil_value = cursor
    insts = ir_inst_list_append(insts, ir_inst_list_prepend(ir_inst_const_i64(nil_value, 0), ir_inst_list_empty()))
    ir_lowered_expr(nil_value, nil_value + 1, insts)
  } }
}

fn pipeline_lower_indexed_slice_overwrite(address: i64, value: i64, next_value: i64) -> IrLoweredExpr {
  let lane_offset = next_value
  let second_address = lane_offset + 1
  let lane_size = second_address + 1
  let lane_mode = lane_size + 1
  let first_store = lane_mode + 1
  let second_store = first_store + 1
  let nil_value = second_store + 1
  let first_args = ir_value_list_prepend(address, ir_value_list_prepend(lane_size, ir_value_list_prepend(lane_mode, ir_value_list_prepend(value, ir_value_list_empty()))))
  let second_args = ir_value_list_prepend(second_address, ir_value_list_prepend(lane_size, ir_value_list_prepend(lane_mode, ir_value_list_prepend(value + 1, ir_value_list_empty()))))
  let insts = ir_inst_list_prepend(
    ir_inst_const_i64(lane_offset, 8),
    ir_inst_list_prepend(
      ir_inst_binary_i64(second_address, ir_binary_op_add(), address, lane_offset),
      ir_inst_list_prepend(
        ir_inst_const_i64(lane_size, 8),
        ir_inst_list_prepend(
          ir_inst_const_i64(lane_mode, 0),
          ir_inst_list_prepend(
            ir_inst_call_i64(first_store, pipeline_ir_native_intrinsic_mem_store_sized_hash(), first_args),
            ir_inst_list_prepend(
              ir_inst_call_i64(second_store, pipeline_ir_native_intrinsic_mem_store_sized_hash(), second_args),
              ir_inst_list_prepend(ir_inst_const_i64(nil_value, 0), ir_inst_list_empty())
            )
          )
        )
      )
    )
  )
  ir_lowered_expr(nil_value, nil_value + 1, insts)
}

fn pipeline_lower_indexed_array_overwrite(value_expr: Expr, element_ty: i64, address: i64, value: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let size = cg_layout_storage_size(tt, element_ty)
  let leaf_count = cg_layout_array_leaf_count(element_ty)
  let leaf_stride = pipeline_array_literal_leaf_stride(tt, element_ty)
  let leaf_kind = pipeline_array_literal_leaf_kind(tt, element_ty)
  if pipeline_array_copy_plan_is_valid(size, leaf_count, leaf_stride, leaf_kind) == 0 { ir_lowered_expr_invalid(next_value) }
  else {
    let src_data = next_value
    let after_copy = src_data + 1
    let borrowed = pipeline_array_expr_result_is_borrowed_typed(value_expr, pipeline_handler_lower_ctx_src(lower_ctx), pipeline_handler_lower_ctx_fns(lower_ctx), pipeline_handler_lower_ctx_subst(lower_ctx), tt)
    let release = if borrowed == 0 {
      ir_inst_list_prepend(ir_inst_call_i64(after_copy, pipeline_rc_default_release_hash(), ir_value_list_prepend(value, ir_value_list_empty())), ir_inst_list_empty())
    } else { ir_inst_list_empty() }
    let nil_value = if borrowed == 0 { after_copy + 1 } else { after_copy }
    let insts = ir_inst_list_prepend(
      ir_inst_call_i64(src_data, pipeline_rc_array_storage_data_hash(), ir_value_list_prepend(value, ir_value_list_empty())),
      ir_inst_list_prepend(
        ir_inst_array_drop_i64(address, leaf_count, leaf_stride, leaf_kind),
        ir_inst_list_prepend(
          ir_inst_array_copy_i64(address, src_data, size, leaf_count, leaf_stride, leaf_kind),
          ir_inst_list_append(release, ir_inst_list_prepend(ir_inst_const_i64(nil_value, 0), ir_inst_list_empty()))
        )
      )
    )
    ir_lowered_expr(nil_value, nil_value + 1, insts)
  }
}

fn pipeline_lower_indexed_overwrite(value_expr: Expr, element_ty: i64, address: i64, value: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  if ty_is_array(element_ty) { pipeline_lower_indexed_array_overwrite(value_expr, element_ty, address, value, next_value, lower_ctx) }
  else { if ty_is_slice(element_ty) { pipeline_lower_indexed_slice_overwrite(address, value, next_value) }
  else { pipeline_lower_indexed_scalar_overwrite(value_expr, element_ty, address, value, next_value, lower_ctx) } }
}

fn pipeline_lower_indexed_set_after_values_typed(base_expr: Expr, index_expr: Expr, value_expr: Expr, fact: i64, base_value: i64, index_value: i64, value: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  let element_ty = ty_subst(pipeline_indexed_set_fact_element_ty(fact), subst)
  let base_ty = ty_subst(pipeline_indexed_set_fact_base_ty(fact), subst)
  let fixed_len = pipeline_indexed_set_fact_fixed_len(fact)
  let stride = pipeline_indexed_element_stride(tt, element_ty)
  if fact == 0 or stride <= 0 { ir_lowered_expr_invalid(next_value) }
  else {
    let mut prefix = ir_inst_list_empty()
    let mut cursor = next_value
    let mut data = base_value
    let mut active_storage = base_value
    if fixed_len >= 0 {
      let storage = pipeline_lower_array_literal_storage(base_ty, fixed_len, cursor, tt)
      if ir_lowered_expr_is_valid(storage) == 0 { return ir_lowered_expr_invalid(next_value) }
      active_storage = ir_lowered_expr_value(storage)
      data = ir_lowered_expr_next_value(storage) - 1
      cursor = ir_lowered_expr_next_value(storage)
      let old_data = cursor
      cursor = cursor + 1
      let total_size = cg_layout_storage_size(tt, base_ty)
      let leaf_count = cg_layout_array_leaf_count(base_ty)
      let leaf_stride = pipeline_array_literal_leaf_stride(tt, base_ty)
      let leaf_kind = pipeline_array_literal_leaf_kind(tt, base_ty)
      if pipeline_array_copy_plan_is_valid(total_size, leaf_count, leaf_stride, leaf_kind) == 0 { return ir_lowered_expr_invalid(next_value) }
      let copy = ir_inst_list_prepend(
        ir_inst_call_i64(old_data, pipeline_rc_array_storage_data_hash(), ir_value_list_prepend(base_value, ir_value_list_empty())),
        ir_inst_list_prepend(ir_inst_array_copy_i64(data, old_data, total_size, leaf_count, leaf_stride, leaf_kind), ir_inst_list_empty())
      )
      prefix = ir_inst_list_append(ir_lowered_expr_insts(storage), copy)
    } else { 0 }
    let len_value = if fixed_len < 0 { base_value + 1 } else { cursor }
    if fixed_len >= 0 {
      prefix = ir_inst_list_append(prefix, ir_inst_list_prepend(ir_inst_const_i64(len_value, fixed_len), ir_inst_list_empty()))
      cursor = cursor + 1
    } else { 0 }
    let stride_value = cursor
    let address = stride_value + 1
    cursor = address + 1
    prefix = ir_inst_list_append(prefix, ir_inst_list_prepend(
      ir_inst_const_i64(stride_value, stride),
      ir_inst_list_prepend(ir_inst_call_i64(address, pipeline_runtime_index_address_hash(), pipeline_index_address_args(data, len_value, index_value, stride_value)), ir_inst_list_empty())
    ))
    let overwritten = pipeline_lower_indexed_overwrite(value_expr, element_ty, address, value, cursor, lower_ctx)
    if ir_lowered_expr_is_valid(overwritten) == 0 { overwritten }
    else {
      let mut post = ir_inst_list_empty()
      let mut after = ir_lowered_expr_next_value(overwritten)
      if fixed_len >= 0 {
        match base_expr {
          Ident(ns, nl) -> {
            let slot = pipeline_value_env_lookup(pipeline_handler_lower_ctx_locals(lower_ctx), pipeline_handler_lower_ctx_src(lower_ctx), ns, nl)
            if slot < 0 { return ir_lowered_expr_invalid(next_value) }
            post = ir_inst_list_prepend(
              ir_inst_store_i64(slot, active_storage),
              ir_inst_list_prepend(ir_inst_call_i64(after, pipeline_rc_default_release_hash(), ir_value_list_prepend(base_value, ir_value_list_empty())), ir_inst_list_empty())
            )
            after = after + 1
          }
          _ -> return ir_lowered_expr_invalid(next_value)
        }
      } else { 0 }
      ir_lowered_expr(ir_lowered_expr_value(overwritten), after, ir_inst_list_append(prefix, ir_inst_list_append(ir_lowered_expr_insts(overwritten), post)))
    }
  }
}

fn pipeline_lower_indexed_set_expr_typed_sidecar_handler_opt(base_expr: Expr, index_expr: Expr, value_expr: Expr, fact: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let base = pipeline_lower_expr_typed_sidecar_handler_ctx(base_expr, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(base) == 0 { ir_lowered_expr_invalid(next_value) }
  else {
    let index = pipeline_lower_expr_typed_sidecar_handler_ctx(index_expr, ir_lowered_expr_next_value(base), lower_ctx)
    if ir_lowered_expr_is_valid(index) == 0 { ir_lowered_expr_invalid(next_value) }
    else {
      let element_ty = ty_subst(pipeline_indexed_set_fact_element_ty(fact), pipeline_handler_lower_ctx_subst(lower_ctx))
      let prim = pipeline_type_node_prim_id_or(element_ty, 0)
      let value = if pipeline_prim_is_forced_numeric_context(prim) == 1 {
        pipeline_lower_expr_typed_sidecar_handler_opt_with_float_prim(value_expr, ir_lowered_expr_next_value(index), lower_ctx, prim)
      } else { pipeline_lower_expr_typed_sidecar_handler_ctx(value_expr, ir_lowered_expr_next_value(index), lower_ctx) }
      if ir_lowered_expr_is_valid(value) == 0 { ir_lowered_expr_invalid(next_value) }
      else {
        let set = pipeline_lower_indexed_set_after_values_typed(base_expr, index_expr, value_expr, fact, ir_lowered_expr_value(base), ir_lowered_expr_value(index), ir_lowered_expr_value(value), ir_lowered_expr_next_value(value), lower_ctx)
        ir_lowered_expr(ir_lowered_expr_value(set), ir_lowered_expr_next_value(set), ir_inst_list_append(ir_lowered_expr_insts(base), ir_inst_list_append(ir_lowered_expr_insts(index), ir_inst_list_append(ir_lowered_expr_insts(value), ir_lowered_expr_insts(set)))))
      }
    }
  }
}

fn pipeline_lower_indexed_set_typed_to_target_blocks(base_expr: Expr, index_expr: Expr, value_expr: Expr, fact: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  if pipeline_expr_needs_lowering_cfg_typed(index_expr, pipeline_lower_module_src(module)) == 0 and pipeline_expr_needs_lowering_cfg_typed(value_expr, pipeline_lower_module_src(module)) == 0 {
    pipeline_lower_straight_expr_typed_to_target_blocks(IndexedSet(base_expr, index_expr, value_expr, fact), params, locals, module, next_value, start_block, next_block, target_block)
  } else {
    let lower_ctx = pipeline_handler_lower_ctx_from_module(params, locals, module)
    let base = pipeline_lower_expr_typed_sidecar_handler_ctx(base_expr, next_value, lower_ctx)
    if ir_lowered_expr_is_valid(base) == 0 { pipeline_lowered_blocks_invalid(start_block, next_value) }
    else {
      let index_start = next_block
      let index_merge_block = index_start + 1
      let index_blocks = pipeline_lower_expr_typed_to_target_blocks_reserved(index_expr, params, locals, module, ir_lowered_expr_next_value(base), index_start, index_start + 2, index_merge_block)
      let entry = ir_block_new_term(start_block, ir_lowered_expr_insts(base), ir_term_jump(index_start))
      if pipeline_lowered_blocks_is_valid(index_blocks) == 0 { pipeline_lowered_blocks_invalid(start_block, next_value) }
      else { if pipeline_lowered_blocks_falls_through(index_blocks) == 0 {
        pipeline_lowered_blocks_control(pipeline_lowered_blocks_next_block(index_blocks), pipeline_lowered_blocks_next_value(index_blocks), ir_block_list_prepend(entry, pipeline_lowered_blocks_blocks(index_blocks)), 1, 0)
      } else {
        let index_value = pipeline_lowered_blocks_next_value(index_blocks)
        let value_start = pipeline_lowered_blocks_next_block(index_blocks)
        let value_merge_block = value_start + 1
        let element_ty = ty_subst(pipeline_indexed_set_fact_element_ty(fact), pipeline_lower_module_subst(module))
        let prim = pipeline_type_node_prim_id_or(element_ty, 0)
        let value_blocks = pipeline_lower_expr_typed_to_target_blocks_reserved_with_float(value_expr, params, locals, module, index_value + 1, value_start, value_start + 2, value_merge_block, prim)
        let index_merge = ir_block_new_params(index_merge_block, ir_value_list_prepend(index_value, ir_value_list_empty()), ir_inst_list_empty(), ir_term_jump(value_start))
        if pipeline_lowered_blocks_is_valid(value_blocks) == 0 { pipeline_lowered_blocks_invalid(start_block, next_value) }
        else { if pipeline_lowered_blocks_falls_through(value_blocks) == 0 {
          let blocks = ir_block_list_prepend(entry, ir_block_list_append(pipeline_lowered_blocks_blocks(index_blocks), ir_block_list_prepend(index_merge, pipeline_lowered_blocks_blocks(value_blocks))))
          pipeline_lowered_blocks_control(pipeline_lowered_blocks_next_block(value_blocks), pipeline_lowered_blocks_next_value(value_blocks), blocks, 1, 0)
        } else {
          let value_head = pipeline_lowered_blocks_next_value(value_blocks)
          let value_lanes = pipeline_expr_value_lane_count(value_expr, params, locals, module)
          let set = pipeline_lower_indexed_set_after_values_typed(base_expr, index_expr, value_expr, fact, ir_lowered_expr_value(base), index_value, value_head, value_head + value_lanes, lower_ctx)
          let value_merge = ir_block_new_params(value_merge_block, pipeline_ir_value_lane_ids(value_head, 0, value_lanes), ir_lowered_expr_insts(set), ir_term_jump_args(target_block, ir_value_list_prepend(ir_lowered_expr_value(set), ir_value_list_empty())))
          let blocks = ir_block_list_prepend(entry, ir_block_list_append(pipeline_lowered_blocks_blocks(index_blocks), ir_block_list_prepend(index_merge, ir_block_list_append(pipeline_lowered_blocks_blocks(value_blocks), ir_block_list_prepend(value_merge, ir_block_list_empty())))))
          pipeline_lowered_blocks(pipeline_lowered_blocks_next_block(value_blocks), ir_lowered_expr_next_value(set), blocks, 1)
        } }
      } }
    }
  }
}

fn pipeline_lower_opt_chain_expr_typed_sidecar_handler_opt(base_expr: Expr, field_ns: i64, field_nl: i64, effect_atom: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let handlers = pipeline_handler_lower_ctx_handlers(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  let base = pipeline_lower_expr_typed_sidecar_handler_ctx(base_expr, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(base) == 1 {
    let dst = ir_lowered_expr_next_value(base)
    let effect_key = pipeline_effect_atom_dispatch_key(effect_atom, subst, effect_maybe_head_hash())
    let storage_layout = pipeline_record_storage_layout_for_base(tt, src, base_expr, params, locals, pipeline_handler_lower_ctx_module(lower_ctx))
    let opt = pipeline_ir_opt_chain_insts_for_storage_layout(dst, ir_lowered_expr_value(base), str_hash(src, field_ns, field_nl), pipeline_typed_field_index_for_base(tt, src, field_ns, field_nl, base_expr, params, locals, pipeline_handler_lower_ctx_module(lower_ctx)), effect_key, storage_layout)
    ir_lowered_expr(dst, dst + 1, ir_inst_list_append(ir_lowered_expr_insts(base), opt))
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_try_expr_typed_sidecar_handler_opt(inner_expr: Expr, effect_atom: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let handlers = pipeline_handler_lower_ctx_handlers(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  let value = pipeline_lower_expr_typed_sidecar_handler_ctx(inner_expr, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(value) == 1 {
    let dst = ir_lowered_expr_next_value(value)
    let effect_key = pipeline_effect_atom_dispatch_key(effect_atom, subst, effect_fail_head_hash())
    let try_inst = ir_inst_list_prepend(ir_inst_try_i64(dst, ir_lowered_expr_value(value), effect_key), ir_inst_list_empty())
    ir_lowered_expr(dst, dst + 1, ir_inst_list_append(ir_lowered_expr_insts(value), try_inst))
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_interp_concat_expr_typed_sidecar_handler_opt(left_expr: Expr, right_expr: Expr, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let handlers = pipeline_handler_lower_ctx_handlers(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  let left = pipeline_lower_expr_typed_sidecar_handler_ctx(left_expr, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(left) == 1 {
    let right = pipeline_lower_expr_typed_sidecar_handler_ctx(right_expr, ir_lowered_expr_next_value(left), lower_ctx)
    if ir_lowered_expr_is_valid(right) == 1 {
      let dst = ir_lowered_expr_next_value(right)
      let concat = ir_inst_list_prepend(ir_inst_string_concat_i64(dst, ir_lowered_expr_value(left), ir_lowered_expr_value(right)), ir_inst_list_empty())
      let insts = ir_inst_list_append(ir_lowered_expr_insts(left), ir_inst_list_append(ir_lowered_expr_insts(right), concat))
      ir_lowered_expr(dst, dst + 1, insts)
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_if_expr_typed_hclause_blocks(cond_expr: Expr, then_expr: Expr, else_expr: Expr, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> PipelineLoweredBlocks {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let handlers = pipeline_handler_lower_ctx_handlers(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  let cond = pipeline_lower_expr_typed_sidecar_handler_ctx(cond_expr, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(cond) == 1 {
    let branch_value_start = ir_lowered_expr_next_value(cond)
    let then_lowered = pipeline_lower_expr_typed_sidecar_handler_ctx(then_expr, branch_value_start, lower_ctx)
    let else_lowered = pipeline_lower_expr_typed_sidecar_handler_ctx(else_expr, branch_value_start, lower_ctx)
    if ir_lowered_expr_is_valid(then_lowered) == 1 and ir_lowered_expr_is_valid(else_lowered) == 1 {
      let result_value = pipeline_ir_max_i64(ir_lowered_expr_next_value(then_lowered), ir_lowered_expr_next_value(else_lowered))
      let entry = ir_block_new_term(0, ir_lowered_expr_insts(cond), ir_term_branch(ir_lowered_expr_value(cond), 1, 2))
      let then_args = ir_value_list_prepend(ir_lowered_expr_value(then_lowered), ir_value_list_empty())
      let then_block = ir_block_new_term(1, ir_lowered_expr_insts(then_lowered), ir_term_jump_args(3, then_args))
      let else_args = ir_value_list_prepend(ir_lowered_expr_value(else_lowered), ir_value_list_empty())
      let else_block = ir_block_new_term(2, ir_lowered_expr_insts(else_lowered), ir_term_jump_args(3, else_args))
      let merge_params = ir_value_list_prepend(result_value, ir_value_list_empty())
      let merge = ir_block_new_params(3, merge_params, ir_inst_list_empty(), ir_term_return(result_value))
      let blocks = ir_block_list_prepend(entry, ir_block_list_prepend(then_block, ir_block_list_prepend(else_block, ir_block_list_prepend(merge, ir_block_list_empty()))))
      pipeline_lowered_blocks(4, result_value + 1, blocks, 1)
    } else {
      pipeline_lowered_blocks_invalid(0, next_value)
    }
  } else {
    pipeline_lowered_blocks_invalid(0, next_value)
  }
}

fn pipeline_lower_expr_typed_hclause_blocks(body_expr: Expr, next_value: i64, lower_ctx: PipelineHandlerLowerCtx, return_ty: i64, transfers_owned_param: i64) -> PipelineLoweredBlocks {
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let module = pipeline_handler_lower_ctx_module(lower_ctx)
  let return_block = 1
  let lowered = pipeline_lower_expr_typed_to_target_blocks_reserved(body_expr, 0, locals, module, next_value, 0, 2, return_block)
  if pipeline_lowered_blocks_is_valid(lowered) == 1 {
    if pipeline_lowered_blocks_falls_through(lowered) == 1 {
      let return_value = pipeline_lowered_blocks_next_value(lowered)
      let return_lanes = pipeline_type_value_lane_count_or_one(return_ty)
      let return_params = pipeline_ir_value_lane_ids(return_value, 0, return_lanes)
      let transfer = if transfers_owned_param == 1 {
        ir_lowered_expr(return_value, return_value + return_lanes, ir_inst_list_empty())
      } else {
        pipeline_lower_return_transfer_typed_with_ty(
          body_expr,
          return_value,
          return_value + return_lanes,
          pipeline_handler_lower_ctx_params(lower_ctx),
          locals,
          module,
          return_ty
        )
      }
      let return_insts = ir_inst_list_append(ir_lowered_expr_insts(transfer), pipeline_ir_return_lane_insts(ir_lowered_expr_value(transfer), return_ty))
      let return_node = ir_block_new_params(return_block, return_params, return_insts, ir_term_return(ir_lowered_expr_value(transfer)))
      let blocks = ir_block_list_append(
        pipeline_lowered_blocks_blocks(lowered),
        ir_block_list_prepend(return_node, ir_block_list_empty())
      )
      pipeline_lowered_blocks_control(pipeline_lowered_blocks_next_block(lowered), ir_lowered_expr_next_value(transfer), blocks, 1, 0)
    } else {
      lowered
    }
  } else {
    pipeline_lowered_blocks_invalid(0, next_value)
  }
}

fn pipeline_lower_let_mut_expr_typed_sidecar_handler_opt_with_float_prim(ns: i64, nl: i64, value_expr: Expr, body_expr: Expr, next_value: i64, lower_ctx: PipelineHandlerLowerCtx, local_float: i64, local_type_node: i64) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let handlers = pipeline_handler_lower_ctx_handlers(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  let value = if pipeline_prim_is_forced_numeric_context(local_float) == 1 {
    pipeline_lower_expr_typed_sidecar_handler_opt_with_float_prim(value_expr, next_value, lower_ctx, local_float)
  } else {
    pipeline_lower_expr_typed_sidecar_handler_ctx(value_expr, next_value, lower_ctx)
  }
  if ir_lowered_expr_is_valid(value) == 1 {
    let address_taken = pipeline_expr_address_of_binding(body_expr, src, ns, nl)
    let slot = if address_taken == 1 {
      pipeline_ir_addressable_slot_id(ir_lowered_expr_next_value(value))
    } else {
      ir_lowered_expr_next_value(value)
    }
    let inferred_float_prim = pipeline_expr_float_prim_typed_temp(value_expr, params, locals, src, pipeline_handler_lower_ctx_fns(lower_ctx), subst)
    let float_prim = if local_float == PRIM_F32() or local_float == PRIM_F64() { local_float } else { inferred_float_prim }
    let inferred_type_hash = pipeline_expr_type_hash_typed_temp(value_expr, params, locals, src, tt, pipeline_handler_lower_ctx_fns(lower_ctx), subst)
    let inferred_type_node = pipeline_init_type_node_typed(value_expr, params, locals, pipeline_handler_lower_ctx_module(lower_ctx))
    let effective_type_node = if local_type_node != 0 { ty_subst(local_type_node, subst) } else { inferred_type_node }
    let local_lanes = pipeline_type_value_lane_count_or_one(effective_type_node)
    let slot_insts = pipeline_ir_slot_lane_init_insts(slot, ir_lowered_expr_value(value), 0, local_lanes)
    let annotated_type_hash = if local_type_node != 0 and effective_type_node != 0 { type_hash_of(effective_type_node) } else { 0 }
    let inferred_node_type_hash = if effective_type_node != 0 { type_hash_of(effective_type_node) } else { 0 }
    let local_type_hash = if annotated_type_hash != 0 { annotated_type_hash } else { if inferred_node_type_hash != 0 { inferred_node_type_hash } else { if local_float != 0 and pipeline_prim_is_numeric_context(local_float) == 1 { pipeline_type_hash_of_prim_id(local_float) } else { pipeline_expr_type_hash_sharpen_int_typed(value_expr, inferred_type_hash, params, locals, src, pipeline_handler_lower_ctx_fns(lower_ctx), subst) } } }
    let retain_insts = if effective_type_node != 0 and pipeline_expr_result_is_borrowed_for_ty_typed(value_expr, effective_type_node, src, pipeline_handler_lower_ctx_fns(lower_ctx), subst, pipeline_handler_lower_ctx_tt(lower_ctx)) == 1 {
      pipeline_managed_retain_inst_list(ir_lowered_expr_value(value), effective_type_node, slot + local_lanes)
    } else {
      ir_inst_list_empty()
    }
    let body_next_value = slot + local_lanes + ir_inst_list_len(retain_insts)
    let next_locals = pipeline_value_env_push_slot_float_typed_node(locals, ns, nl, slot, float_prim, local_type_hash, effective_type_node)
    let body_ctx = pipeline_handler_lower_ctx_from_module(params, next_locals, pipeline_handler_lower_ctx_module(lower_ctx))
    let body = pipeline_lower_expr_typed_sidecar_handler_ctx(body_expr, body_next_value, body_ctx)
    if ir_lowered_expr_is_valid(body) == 1 {
      let scope_needs_release = pipeline_let_mut_scope_needs_release(body_expr, src, ns, nl, address_taken, effective_type_node)
      let cleanup_insts = if scope_needs_release == 1 { pipeline_managed_slot_cleanup_inst_list(slot, effective_type_node, ir_lowered_expr_next_value(body)) } else { ir_inst_list_empty() }
      let after_cleanup = ir_lowered_expr_next_value(body) + ir_inst_list_len(cleanup_insts)
      let bind = ir_inst_list_prepend(ir_inst_bind_typed_i64(ns, nl, slot, effective_type_node), ir_inst_list_empty())
      let insts = ir_inst_list_append(ir_lowered_expr_insts(value), ir_inst_list_append(slot_insts, ir_inst_list_append(retain_insts, ir_inst_list_append(bind, ir_inst_list_append(ir_lowered_expr_insts(body), cleanup_insts)))))
      ir_lowered_expr(ir_lowered_expr_value(body), after_cleanup, insts)
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_let_mut_expr_typed_sidecar_handler_opt(ns: i64, nl: i64, value_expr: Expr, body_expr: Expr, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  pipeline_lower_let_mut_expr_typed_sidecar_handler_opt_with_float_prim(ns, nl, value_expr, body_expr, next_value, lower_ctx, 0, 0)
}

fn pipeline_lower_address_of_expr_typed_sidecar_handler_opt(mutable: i64, target: Expr, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  match target {
    Ident(ns, nl) -> {
      let local = pipeline_value_env_lookup(locals, src, ns, nl)
      if local >= 0 {
        if pipeline_value_env_lookup_kind(locals, src, ns, nl) == 1 {
          ir_lowered_expr(
            next_value,
            next_value + 1,
            ir_inst_list_prepend(ir_inst_address_of_slot_i64(next_value, local), ir_inst_list_empty())
          )
        } else {
          let slot = pipeline_ir_addressable_slot_id(next_value)
          let local_ty = pipeline_value_env_lookup_type_node(locals, src, ns, nl)
          let lanes = pipeline_type_value_lane_count_or_one(local_ty)
          let ptr = slot + lanes
          let insts = ir_inst_list_append(
            pipeline_ir_slot_lane_init_insts(slot, local, 0, lanes),
            ir_inst_list_prepend(ir_inst_address_of_slot_i64(ptr, slot), ir_inst_list_empty())
          )
          ir_lowered_expr(ptr, ptr + 1, insts)
        }
      } else {
        let param_id = if params == 0 { 0 - 1 } else { pipeline_param_index(params, src, ns, nl) }
        if param_id >= 0 {
          let slot = pipeline_ir_addressable_slot_id(next_value)
          let param_ty = pipeline_param_type_node_by_name(params, src, ns, nl, pipeline_handler_lower_ctx_subst(lower_ctx))
          let lanes = pipeline_type_value_lane_count_or_one(param_ty)
          let ptr = slot + lanes
          let insts = ir_inst_list_append(
            pipeline_ir_slot_lane_init_insts(slot, param_id, 0, lanes),
            ir_inst_list_prepend(ir_inst_address_of_slot_i64(ptr, slot), ir_inst_list_empty())
          )
          ir_lowered_expr(ptr, ptr + 1, insts)
        } else {
          ir_lowered_expr_invalid(next_value)
        }
      }
    }
    _ -> ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_deref_expr_typed_sidecar_handler_opt(ptr_expr: Expr, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let ptr = pipeline_lower_expr_typed_sidecar_handler_ctx(ptr_expr, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(ptr) == 1 {
    let dst = ir_lowered_expr_next_value(ptr)
    let inst = ir_inst_list_prepend(ir_inst_ptr_load_i64(dst, ir_lowered_expr_value(ptr)), ir_inst_list_empty())
    ir_lowered_expr(dst, dst + 1, ir_inst_list_append(ir_lowered_expr_insts(ptr), inst))
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_ptr_assign_expr_typed_sidecar_handler_opt(ptr_expr: Expr, value_expr: Expr, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let ptr = pipeline_lower_expr_typed_sidecar_handler_ctx(ptr_expr, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(ptr) == 1 {
    let value = pipeline_lower_expr_typed_sidecar_handler_ctx(value_expr, ir_lowered_expr_next_value(ptr), lower_ctx)
    if ir_lowered_expr_is_valid(value) == 1 {
      let dst = ir_lowered_expr_next_value(value)
      let inst = ir_inst_list_prepend(ir_inst_ptr_store_i64(dst, ir_lowered_expr_value(ptr), ir_lowered_expr_value(value)), ir_inst_list_empty())
      ir_lowered_expr(dst, dst + 1, ir_inst_list_append(ir_lowered_expr_insts(ptr), ir_inst_list_append(ir_lowered_expr_insts(value), inst)))
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_assign_expr_typed_sidecar_handler_opt(ns: i64, nl: i64, value_expr: Expr, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let handlers = pipeline_handler_lower_ctx_handlers(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  let slot = pipeline_value_env_lookup(locals, src, ns, nl)
  if slot >= 0 and pipeline_value_env_lookup_kind(locals, src, ns, nl) == 1 {
    let slot_float = pipeline_value_env_lookup_float_prim(locals, src, ns, nl)
    let slot_int = if slot_float == 0 { pipeline_type_hash_int_prim_or(pipeline_value_env_lookup_type_hash(locals, src, ns, nl), 0 - 1) } else { 0 - 1 }
    let slot_prim = if slot_float == PRIM_F32() or slot_float == PRIM_F64() { slot_float } else { slot_int }
    let slot_ty = pipeline_value_env_lookup_type_node(locals, src, ns, nl)
    let slot_lanes = pipeline_type_value_lane_count_or_one(slot_ty)
    let value = if pipeline_prim_is_forced_numeric_context(slot_prim) == 1 {
      pipeline_lower_expr_typed_sidecar_handler_opt_with_float_prim(value_expr, next_value, lower_ctx, slot_prim)
    } else {
      pipeline_lower_expr_typed_sidecar_handler_ctx(value_expr, next_value, lower_ctx)
    }
    if ir_lowered_expr_is_valid(value) == 1 {
      let retain_insts = if slot_ty != 0 and pipeline_expr_result_is_borrowed_for_ty_typed(value_expr, slot_ty, src, pipeline_handler_lower_ctx_fns(lower_ctx), subst, pipeline_handler_lower_ctx_tt(lower_ctx)) == 1 {
        pipeline_managed_retain_inst_list(ir_lowered_expr_value(value), slot_ty, ir_lowered_expr_next_value(value))
      } else {
        ir_inst_list_empty()
      }
      let after_retain = ir_lowered_expr_next_value(value) + ir_inst_list_len(retain_insts)
      let old_value = after_retain
      let release_count = pipeline_type_managed_release_lane_count(slot_ty)
      let load_old_insts = if release_count > 0 {
        pipeline_ir_slot_managed_lane_load_insts(old_value, slot, slot_ty, 0, slot_lanes)
      } else {
        ir_inst_list_empty()
      }
      let release_insts = if release_count > 0 {
        pipeline_managed_release_inst_list(old_value, slot_ty, old_value + slot_lanes)
      } else {
        ir_inst_list_empty()
      }
      let nil_value = if release_count > 0 { old_value + slot_lanes + ir_inst_list_len(release_insts) } else { old_value }
      let assign_insts = ir_inst_list_append(
        pipeline_ir_slot_store_lane_insts(slot, ir_lowered_expr_value(value), 0, slot_lanes),
        ir_inst_list_prepend(ir_inst_const_i64(nil_value, 0), ir_inst_list_empty())
      )
      let update_insts = ir_inst_list_append(retain_insts, ir_inst_list_append(load_old_insts, ir_inst_list_append(release_insts, assign_insts)))
      ir_lowered_expr(nil_value, nil_value + 1, ir_inst_list_append(ir_lowered_expr_insts(value), update_insts))
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_handle_return_is_present(hret: HandleReturn) -> i64 {
  match hret {
    NoHandleReturn -> 0
    HandleReturnClause(rns, rnl, rb) -> 1
  }
}

fn pipeline_lower_handle_expr_typed_sidecar_handler_opt(body_expr: Expr, clauses: HandlerClauseList, hret: HandleReturn, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  if pipeline_handle_return_is_present(hret) == 1 {
    -- 4c: return-clause handles lower through the CFG path only.
    ir_lowered_expr_invalid(next_value)
  } else {
  pipeline_lower_handle_expr_typed_sidecar_inner(body_expr, clauses, next_value, lower_ctx)
  }
}

fn pipeline_lower_handle_expr_typed_sidecar_inner(body_expr: Expr, clauses: HandlerClauseList, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let ctx = pipeline_handler_lower_ctx_handlers(lower_ctx)
  let nclauses = handler_clause_list_len(clauses)
  if nclauses <= 0 {
    ir_lowered_expr_invalid(next_value)
  } else {
    let handle_result_ty = pipeline_return_expr_type_node_typed(body_expr, params, locals, pipeline_handler_lower_ctx_module(lower_ctx))
    let lowered_clauses = pipeline_lower_handler_clauses_typed(clauses, params, locals, pipeline_handler_lower_ctx_module(lower_ctx), handle_result_ty)
    let clause_bodies = pipeline_lowered_handler_clauses_bodies(lowered_clauses)
    let eff_hash = pipeline_handler_clause_dispatch_key_typed(src, handler_clause_list_nth(clauses, 0), pipeline_handler_lower_ctx_subst(lower_ctx))
    let next_ctx = pipeline_handler_inline_ctx_push_typed_src_safe(ctx, eff_hash, clauses, nclauses, src, 1, pipeline_lowered_handler_clauses_out_of_line_safe(lowered_clauses))
    let next_lower_ctx = pipeline_handler_lower_ctx_from_module(params, locals, pipeline_lower_module_with_handlers(pipeline_handler_lower_ctx_module(lower_ctx), next_ctx))
    let call_inline = pipeline_lower_handle_body_call_inline_nodes(expr_to_node(body_expr), eff_hash, next_ctx, next_lower_ctx, next_value)
    let lowered = if ir_lowered_expr_is_valid(call_inline) == 1 { call_inline } else { pipeline_lower_expr_typed_sidecar_handler_ctx(body_expr, next_value, next_lower_ctx) }
    if ir_lowered_expr_is_valid(lowered) == 1 {
      if pipeline_ir_insts_handle_frame_free(ir_lowered_expr_insts(lowered)) == 1 {
        lowered
      } else {
        let insts = pipeline_ir_handle_inst_list_typed(src, eff_hash, clause_bodies, nclauses, ir_lowered_expr_insts(lowered))
        ir_lowered_expr(
          ir_lowered_expr_value(lowered),
          ir_lowered_expr_next_value(lowered),
          insts
        )
      }
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  }
}

type PipelineScaledRawNodeAddress {
  PipelineScaledRawNodeAddress(i64, i64, i64, i64)
}

type PipelineScaledRawNodeIndex {
  PipelineScaledRawNodeIndex(i64, i64)
}

fn pipeline_expr_node_strip_typed(expr: i64) -> i64 {
  if expr != 0 and node_tag(expr) == 37 {
    pipeline_expr_node_strip_typed(node_f1(expr))
  } else {
    expr
  }
}

fn pipeline_type_node_prim_id_or(ty: i64, default: i64) -> i64 {
  if ty == 0 { default } else { type_expr_prim_id_or(type_expr_from_node(ty), default) }
}

fn pipeline_expr_node_is_int_lit(expr: i64, value: i64) -> i64 {
  let stripped = pipeline_expr_node_strip_typed(expr)
  if stripped != 0 and node_tag(stripped) == 1 {
    if node_f1(stripped) == value { 1 } else { 0 }
  } else {
    0
  }
}

fn pipeline_scaled_raw_node_index(valid: i64, index: i64) -> PipelineScaledRawNodeIndex {
  PipelineScaledRawNodeIndex(valid, index)
}

fn pipeline_scaled_raw_node_index_invalid() -> PipelineScaledRawNodeIndex {
  PipelineScaledRawNodeIndex(0, 0)
}

fn pipeline_scaled_raw_node_index_valid(mode: PipelineScaledRawNodeIndex) -> i64 {
  match mode {
    PipelineScaledRawNodeIndex(valid, index) -> valid
  }
}

fn pipeline_scaled_raw_node_index_expr(mode: PipelineScaledRawNodeIndex) -> i64 {
  match mode {
    PipelineScaledRawNodeIndex(valid, index) -> index
  }
}

fn pipeline_scaled_raw_node_address(valid: i64, first: i64, second: i64, first_is_base: i64) -> PipelineScaledRawNodeAddress {
  PipelineScaledRawNodeAddress(valid, first, second, first_is_base)
}

fn pipeline_scaled_raw_node_address_invalid() -> PipelineScaledRawNodeAddress {
  PipelineScaledRawNodeAddress(0, 0, 0, 0)
}

fn pipeline_scaled_raw_node_address_valid(mode: PipelineScaledRawNodeAddress) -> i64 {
  match mode {
    PipelineScaledRawNodeAddress(valid, first, second, first_is_base) -> valid
  }
}

fn pipeline_scaled_raw_node_address_first(mode: PipelineScaledRawNodeAddress) -> i64 {
  match mode {
    PipelineScaledRawNodeAddress(valid, first, second, first_is_base) -> first
  }
}

fn pipeline_scaled_raw_node_address_second(mode: PipelineScaledRawNodeAddress) -> i64 {
  match mode {
    PipelineScaledRawNodeAddress(valid, first, second, first_is_base) -> second
  }
}

fn pipeline_scaled_raw_node_address_first_is_base(mode: PipelineScaledRawNodeAddress) -> i64 {
  match mode {
    PipelineScaledRawNodeAddress(valid, first, second, first_is_base) -> first_is_base
  }
}

fn pipeline_scaled_raw_index_from_node(expr: i64) -> PipelineScaledRawNodeIndex {
  let stripped = pipeline_expr_node_strip_typed(expr)
  if stripped != 0 and node_tag(stripped) == 3 {
    if node_f1(stripped) == 3 and pipeline_expr_node_is_int_lit(node_f3(stripped), 8) == 1 {
      pipeline_scaled_raw_node_index(1, node_f2(stripped))
    } else {
      if node_f1(stripped) == 3 and pipeline_expr_node_is_int_lit(node_f2(stripped), 8) == 1 {
        pipeline_scaled_raw_node_index(1, node_f3(stripped))
      } else {
        pipeline_scaled_raw_node_index_invalid()
      }
    }
  } else {
    pipeline_scaled_raw_node_index_invalid()
  }
}

fn pipeline_scaled_raw_address_from_node(expr: i64) -> PipelineScaledRawNodeAddress {
  let stripped = pipeline_expr_node_strip_typed(expr)
  if stripped != 0 and node_tag(stripped) == 3 and node_f1(stripped) == 1 {
    let left_index = pipeline_scaled_raw_index_from_node(node_f2(stripped))
    if pipeline_scaled_raw_node_index_valid(left_index) == 1 {
      pipeline_scaled_raw_node_address(1, pipeline_scaled_raw_node_index_expr(left_index), node_f3(stripped), 0)
    } else {
      let right_index = pipeline_scaled_raw_index_from_node(node_f3(stripped))
      if pipeline_scaled_raw_node_index_valid(right_index) == 1 {
        pipeline_scaled_raw_node_address(1, node_f2(stripped), pipeline_scaled_raw_node_index_expr(right_index), 1)
      } else {
        pipeline_scaled_raw_node_address_invalid()
      }
    }
  } else {
    pipeline_scaled_raw_node_address_invalid()
  }
}

fn pipeline_lower_node_handler_opt_args(args: i64, arg_count: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> PipelineLoweredArgs {
  pipeline_lower_node_handler_opt_args_expected_offset(args, arg_count, 0, next_value, lower_ctx, 0, 0, 0, 0)
}

fn pipeline_lower_node_handler_opt_args_expected(args: i64, arg_count: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx, expected_params: i64, expected_subst: i64) -> PipelineLoweredArgs {
  pipeline_lower_node_handler_opt_args_expected_offset(args, arg_count, 0, next_value, lower_ctx, expected_params, 0, expected_subst, 0)
}

fn pipeline_lower_node_handler_opt_args_expected_types(args: i64, arg_count: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx, expected_types: i64, expected_subst: i64) -> PipelineLoweredArgs {
  pipeline_lower_node_handler_opt_args_expected_offset(args, arg_count, 0, next_value, lower_ctx, 0, expected_types, expected_subst, 0)
}

fn pipeline_lower_node_handler_opt_args_expected_offset(args: i64, arg_count: i64, index: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx, expected_params: i64, expected_types: i64, expected_subst: i64, expected_offset: i64) -> PipelineLoweredArgs {
  pipeline_lower_node_handler_opt_args_expected_offset_borrow_mask(args, arg_count, index, next_value, lower_ctx, expected_params, expected_types, expected_subst, expected_offset, 0)
}

fn pipeline_lower_node_handler_opt_args_expected_offset_borrow_mask(args: i64, arg_count: i64, index: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx, expected_params: i64, expected_types: i64, expected_subst: i64, expected_offset: i64, borrowed_mask: i64) -> PipelineLoweredArgs {
  if index >= arg_count {
    pipeline_lowered_args(ir_value_list_empty(), next_value, ir_inst_list_empty(), 1)
  } else {
    let arg_node = nlist_get(args, index)
    let expected_float = pipeline_expected_arg_float_prim(expected_params, expected_types, index, expected_offset, expected_subst)
    let expected_int = if expected_float == 0 { pipeline_expected_arg_int_prim(expected_params, expected_types, index, expected_offset, expected_subst) } else { 0 - 1 }
    let expected_prim = if expected_float == PRIM_F32() or expected_float == PRIM_F64() { expected_float } else { expected_int }
    let expected_ty = pipeline_expected_arg_type_node(expected_params, expected_types, index, expected_offset, expected_subst)
    let retain_ty = if cg_mask_has(borrowed_mask, index + expected_offset) == 1 { 0 } else { expected_ty }
    let arg = if pipeline_prim_is_forced_numeric_context(expected_prim) == 1 {
      pipeline_lower_expr_node_typed_sidecar_handler_opt_with_float_prim(arg_node, next_value, lower_ctx, expected_prim)
    } else {
      pipeline_lower_expr_node_typed_sidecar_handler_ctx(arg_node, next_value, lower_ctx)
    }
    if ir_lowered_expr_is_valid(arg) == 1 {
      let retain = pipeline_managed_borrow_retain_arg_node(arg_node, ir_lowered_expr_value(arg), retain_ty, ir_lowered_expr_next_value(arg), pipeline_handler_lower_ctx_src(lower_ctx), pipeline_handler_lower_ctx_fns(lower_ctx), expected_subst, pipeline_handler_lower_ctx_tt(lower_ctx))
      let rest = pipeline_lower_node_handler_opt_args_expected_offset_borrow_mask(args, arg_count, index + 1, pipeline_lowered_args_next_value(retain), lower_ctx, expected_params, expected_types, expected_subst, expected_offset, borrowed_mask)
      if pipeline_lowered_args_is_valid(rest) == 1 {
        let values = ir_value_list_prepend(ir_lowered_expr_value(arg), pipeline_lowered_args_values(rest))
        let insts = ir_inst_list_append(ir_lowered_expr_insts(arg), ir_inst_list_append(pipeline_lowered_args_insts(retain), pipeline_lowered_args_insts(rest)))
        pipeline_lowered_args(values, pipeline_lowered_args_next_value(rest), insts, 1)
      } else {
        pipeline_lowered_args_invalid(next_value)
      }
    } else {
      pipeline_lowered_args_invalid(next_value)
    }
  }
}

fn pipeline_lower_record_field_nodes_handler_opt(fields: i64, field_count: i64, index: i64, type_ns: i64, type_nl: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> PipelineLoweredRecordFields {
  if index >= field_count {
    pipeline_lowered_record_fields(ir_record_field_list_empty(), next_value, ir_inst_list_empty(), 1)
  } else {
    let field = nlist_get(fields, index)
    if field != 0 and node_tag(field) == 2 {
      let src = pipeline_handler_lower_ctx_src(lower_ctx)
      let value_expr = node_f3(field)
      let value = pipeline_lower_expr_node_typed_sidecar_handler_ctx(value_expr, next_value, lower_ctx)
      if ir_lowered_expr_is_valid(value) == 1 {
        let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
        let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
        let field_ty = pipeline_record_field_expected_type(tt, src, type_ns, type_nl, node_f1(field), node_f2(field), subst)
        let retain = pipeline_managed_borrow_retain_arg_node(value_expr, ir_lowered_expr_value(value), field_ty, ir_lowered_expr_next_value(value), src, pipeline_handler_lower_ctx_fns(lower_ctx), subst, tt)
        let rest = pipeline_lower_record_field_nodes_handler_opt(fields, field_count, index + 1, type_ns, type_nl, pipeline_lowered_args_next_value(retain), lower_ctx)
        if pipeline_lowered_record_fields_is_valid(rest) == 1 {
          let field_hash = str_hash(src, node_f1(field), node_f2(field))
          let word_offset = pipeline_record_field_word_offset(tt, src, type_ns, type_nl, node_f1(field), node_f2(field), subst)
          let values = ir_record_field_list_append(pipeline_ir_record_field_lane_entries(field_hash, word_offset, ir_lowered_expr_value(value), field_ty), pipeline_lowered_record_fields_values(rest))
          let insts = ir_inst_list_append(ir_lowered_expr_insts(value), ir_inst_list_append(pipeline_lowered_args_insts(retain), pipeline_lowered_record_fields_insts(rest)))
          pipeline_lowered_record_fields(values, pipeline_lowered_record_fields_next_value(rest), insts, 1)
        } else {
          pipeline_lowered_record_fields_invalid(next_value)
        }
      } else {
        pipeline_lowered_record_fields_invalid(next_value)
      }
    } else {
      pipeline_lowered_record_fields_invalid(next_value)
    }
  }
}

fn pipeline_lower_scaled_raw_first_second_nodes(first: i64, second: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> PipelineLoweredArgs {
  let first_lowered = pipeline_lower_expr_node_typed_sidecar_handler_ctx(first, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(first_lowered) == 1 {
    let second_lowered = pipeline_lower_expr_node_typed_sidecar_handler_ctx(second, ir_lowered_expr_next_value(first_lowered), lower_ctx)
    if ir_lowered_expr_is_valid(second_lowered) == 1 {
      pipeline_lowered_args(
        ir_value_list_prepend(ir_lowered_expr_value(first_lowered), ir_value_list_prepend(ir_lowered_expr_value(second_lowered), ir_value_list_empty())),
        ir_lowered_expr_next_value(second_lowered),
        ir_inst_list_append(ir_lowered_expr_insts(first_lowered), ir_lowered_expr_insts(second_lowered)),
        1
      )
    } else {
      pipeline_lowered_args_invalid(next_value)
    }
  } else {
    pipeline_lowered_args_invalid(next_value)
  }
}

fn pipeline_lower_scaled_raw_call_node(callee_hash: i64, args: i64, arg_count: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let kind = pipeline_ir_native_intrinsic_kind(callee_hash)
  if kind == 4 and arg_count == 1 {
    let addr_mode = pipeline_scaled_raw_address_from_node(nlist_get(args, 0))
    if pipeline_scaled_raw_node_address_valid(addr_mode) == 1 {
      let lowered = pipeline_lower_scaled_raw_first_second_nodes(pipeline_scaled_raw_node_address_first(addr_mode), pipeline_scaled_raw_node_address_second(addr_mode), next_value, lower_ctx)
      if pipeline_lowered_args_is_valid(lowered) == 1 {
        let first_value = pipeline_ir_value_list_get_or(pipeline_lowered_args_values(lowered), 0, 0 - 1)
        let second_value = pipeline_ir_value_list_get_or(pipeline_lowered_args_values(lowered), 1, 0 - 1)
        let base = if pipeline_scaled_raw_node_address_first_is_base(addr_mode) == 1 { first_value } else { second_value }
        let index = if pipeline_scaled_raw_node_address_first_is_base(addr_mode) == 1 { second_value } else { first_value }
        let dst = pipeline_lowered_args_next_value(lowered)
        let call_args = ir_value_list_prepend(base, ir_value_list_prepend(index, ir_value_list_empty()))
        let call = ir_inst_list_prepend(ir_inst_call_i64(dst, pipeline_ir_pseudo_scaled_load64_hash(), call_args), ir_inst_list_empty())
        ir_lowered_expr(dst, dst + 1, ir_inst_list_append(pipeline_lowered_args_insts(lowered), call))
      } else {
        ir_lowered_expr_invalid(next_value)
      }
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    if kind == 2 and arg_count == 2 {
      let addr_mode = pipeline_scaled_raw_address_from_node(nlist_get(args, 0))
      if pipeline_scaled_raw_node_address_valid(addr_mode) == 1 {
        let lowered_addr = pipeline_lower_scaled_raw_first_second_nodes(pipeline_scaled_raw_node_address_first(addr_mode), pipeline_scaled_raw_node_address_second(addr_mode), next_value, lower_ctx)
        if pipeline_lowered_args_is_valid(lowered_addr) == 1 {
          let lowered_value = pipeline_lower_expr_node_typed_sidecar_handler_ctx(nlist_get(args, 1), pipeline_lowered_args_next_value(lowered_addr), lower_ctx)
          if ir_lowered_expr_is_valid(lowered_value) == 1 {
            let first_value = pipeline_ir_value_list_get_or(pipeline_lowered_args_values(lowered_addr), 0, 0 - 1)
            let second_value = pipeline_ir_value_list_get_or(pipeline_lowered_args_values(lowered_addr), 1, 0 - 1)
            let base = if pipeline_scaled_raw_node_address_first_is_base(addr_mode) == 1 { first_value } else { second_value }
            let index = if pipeline_scaled_raw_node_address_first_is_base(addr_mode) == 1 { second_value } else { first_value }
            let dst = ir_lowered_expr_next_value(lowered_value)
            let call_args = ir_value_list_prepend(base, ir_value_list_prepend(index, ir_value_list_prepend(ir_lowered_expr_value(lowered_value), ir_value_list_empty())))
            let call = ir_inst_list_prepend(ir_inst_call_i64(dst, pipeline_ir_pseudo_scaled_store64_hash(), call_args), ir_inst_list_empty())
            ir_lowered_expr(dst, dst + 1, ir_inst_list_append(pipeline_lowered_args_insts(lowered_addr), ir_inst_list_append(ir_lowered_expr_insts(lowered_value), call)))
          } else {
            ir_lowered_expr_invalid(next_value)
          }
        } else {
          ir_lowered_expr_invalid(next_value)
        }
      } else {
        ir_lowered_expr_invalid(next_value)
      }
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  }
}

fn pipeline_lower_bridge_mem_call_node(src: i64, ns: i64, nl: i64, args: i64, arg_count: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let kind = pipeline_bridge_mem_kind(src, ns, nl, arg_count)
  if kind == 0 {
    ir_lowered_expr_invalid(next_value)
  } else {
    pipeline_lower_bridge_mem_from_values(kind, pipeline_lower_node_handler_opt_args(args, arg_count, next_value, lower_ctx))
  }
}

fn pipeline_lower_native_intrinsic_call_node(callee_hash: i64, args: i64, arg_count: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let kind = pipeline_ir_native_intrinsic_kind(callee_hash)
  let arity = pipeline_ir_native_intrinsic_arity(kind)
  if kind == 0 or arity != arg_count {
    ir_lowered_expr_invalid(next_value)
  } else {
    if kind == 4 {
      let ptr = pipeline_lower_expr_node_typed_sidecar_handler_ctx(nlist_get(args, 0), next_value, lower_ctx)
      if ir_lowered_expr_is_valid(ptr) == 1 {
        let dst = ir_lowered_expr_next_value(ptr)
        let inst = ir_inst_list_prepend(ir_inst_ptr_load_i64(dst, ir_lowered_expr_value(ptr)), ir_inst_list_empty())
        ir_lowered_expr(dst, dst + 1, ir_inst_list_append(ir_lowered_expr_insts(ptr), inst))
      } else {
        ir_lowered_expr_invalid(next_value)
      }
    } else {
      if kind == 2 {
        let ptr = pipeline_lower_expr_node_typed_sidecar_handler_ctx(nlist_get(args, 0), next_value, lower_ctx)
        if ir_lowered_expr_is_valid(ptr) == 1 {
          let value = pipeline_lower_expr_node_typed_sidecar_handler_ctx(nlist_get(args, 1), ir_lowered_expr_next_value(ptr), lower_ctx)
          if ir_lowered_expr_is_valid(value) == 1 {
            let store_dst = ir_lowered_expr_next_value(value)
            let store = ir_inst_list_prepend(ir_inst_ptr_store_i64(store_dst, ir_lowered_expr_value(ptr), ir_lowered_expr_value(value)), ir_inst_list_empty())
            let insts = ir_inst_list_append(ir_lowered_expr_insts(ptr), ir_inst_list_append(ir_lowered_expr_insts(value), store))
            ir_lowered_expr(ir_lowered_expr_value(value), store_dst + 1, insts)
          } else {
            ir_lowered_expr_invalid(next_value)
          }
        } else {
          ir_lowered_expr_invalid(next_value)
        }
      } else {
        let lowered_args = pipeline_lower_node_handler_opt_args(args, arg_count, next_value, lower_ctx)
        if pipeline_lowered_args_is_valid(lowered_args) == 1 {
          let dst = pipeline_lowered_args_next_value(lowered_args)
          let call = ir_inst_list_prepend(ir_inst_call_i64(dst, callee_hash, pipeline_lowered_args_values(lowered_args)), ir_inst_list_empty())
          ir_lowered_expr(dst, dst + 1, ir_inst_list_append(pipeline_lowered_args_insts(lowered_args), call))
        } else {
          ir_lowered_expr_invalid(next_value)
        }
      }
    }
  }
}

fn pipeline_lower_weak_call_node_typed_sidecar_handler_opt(src: i64, ns: i64, nl: i64, args: i64, arg_count: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  if arg_count != 1 {
    ir_lowered_expr_invalid(next_value)
  } else {
    if src_eq(src, ns, nl, "weak_ref") == 1 or src_eq(src, ns, nl, "weak_load") == 1 {
      let value = pipeline_lower_expr_node_typed_sidecar_handler_ctx(nlist_get(args, 0), next_value, lower_ctx)
      if ir_lowered_expr_is_valid(value) == 1 {
        let dst = ir_lowered_expr_next_value(value)
        let runtime_hash = if src_eq(src, ns, nl, "weak_ref") == 1 { pipeline_rc_default_weak_retain_hash() } else { pipeline_rc_default_weak_load_hash() }
        let runtime_args = ir_value_list_prepend(ir_lowered_expr_value(value), ir_value_list_empty())
        let call = ir_inst_list_prepend(ir_inst_call_i64(dst, runtime_hash, runtime_args), ir_inst_list_empty())
        let result_value = if src_eq(src, ns, nl, "weak_ref") == 1 { ir_lowered_expr_value(value) } else { dst }
        let insts = ir_inst_list_append(ir_lowered_expr_insts(value), call)
        ir_lowered_expr(result_value, dst + 1, insts)
      } else {
        ir_lowered_expr_invalid(next_value)
      }
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  }
}

fn pipeline_generic_infer_subst_add(s: i64, var_id: i64, actual_ty: i64) -> i64 {
  if actual_ty == 0 { s }
  else {
    let old = subst_lookup(s, var_id)
    if old == 0 { subst_add(s, var_id, actual_ty) } else { s }
  }
}

fn pipeline_generic_infer_subst_type_list(expected: i64, actual: i64, s: i64) -> i64 {
  if expected == 0 or actual == 0 { s }
  else {
    let n = nlist_len(expected)
    let mut i = 0
    let mut result = s
    while i < n {
      if i < nlist_len(actual) {
        result = pipeline_generic_infer_subst_ty(nlist_get(expected, i), nlist_get(actual, i), result)
      } else { 0 }
      i = i + 1
    }
    result
  }
}

fn pipeline_generic_infer_subst_ty(expected_ty: i64, actual_ty: i64, s: i64) -> i64 {
  if expected_ty == 0 or actual_ty == 0 { s }
  else {
    let tag = ty_tag(expected_ty)
    match tag {
      12 -> pipeline_generic_infer_subst_add(s, ty_f1(expected_ty), actual_ty)
      3 -> pipeline_generic_infer_subst_ty(ty_f2(expected_ty), actual_ty, pipeline_generic_infer_subst_ty(ty_f1(expected_ty), actual_ty, s))
      4 -> pipeline_generic_infer_subst_ty(ty_f2(expected_ty), actual_ty, pipeline_generic_infer_subst_ty(ty_f1(expected_ty), actual_ty, s))
      5 -> pipeline_generic_infer_subst_ty(ty_f1(expected_ty), actual_ty, s)
      6 -> {
        if ty_tag(actual_ty) == 6 {
          let with_params = pipeline_generic_infer_subst_type_list(ty_f1(expected_ty), ty_f1(actual_ty), s)
          pipeline_generic_infer_subst_ty(ty_f2(expected_ty), ty_f2(actual_ty), with_params)
        } else { s }
      }
      9 -> {
        if ty_tag(actual_ty) == 9 and ty_f1(expected_ty) == ty_f1(actual_ty) {
          let with_inner = pipeline_generic_infer_subst_ty(ty_f2(expected_ty), ty_f2(actual_ty), s)
          pipeline_generic_infer_subst_type_list(ty_f3(expected_ty), ty_f3(actual_ty), with_inner)
        } else { s }
      }
      14 -> {
        if ty_tag(actual_ty) == 14 {
          let with_input = pipeline_generic_infer_subst_ty(ty_f1(expected_ty), ty_f1(actual_ty), s)
          pipeline_generic_infer_subst_ty(ty_f2(expected_ty), ty_f2(actual_ty), with_input)
        } else { s }
      }
      15 -> if ty_tag(actual_ty) == 15 { pipeline_generic_infer_subst_ty(ty_f1(expected_ty), ty_f1(actual_ty), s) } else { s }
      16 -> if ty_tag(actual_ty) == 16 { pipeline_generic_infer_subst_ty(ty_f1(expected_ty), ty_f1(actual_ty), s) } else { s }
      17 -> if ty_tag(actual_ty) == 17 { pipeline_generic_infer_subst_ty(ty_f1(expected_ty), ty_f1(actual_ty), s) } else { s }
      18 -> if ty_tag(actual_ty) == 18 { pipeline_generic_infer_subst_ty(ty_f1(expected_ty), ty_f1(actual_ty), s) } else { s }
      19 -> if ty_tag(actual_ty) == 19 { pipeline_generic_infer_subst_ty(ty_f1(expected_ty), ty_f1(actual_ty), s) } else { s }
      22 -> if ty_tag(actual_ty) == 22 and ty_array_length(expected_ty) == ty_array_length(actual_ty) {
        pipeline_generic_infer_subst_ty(ty_array_inner(expected_ty), ty_array_inner(actual_ty), s)
      } else { s }
      _ -> s
    }
  }
}

fn pipeline_expr_node_default_type_node(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> i64 {
  let inferred = pipeline_return_expr_type_node_from_node(expr, params, locals, module)
  if inferred != 0 { inferred }
  else {
    let stripped = pipeline_expr_node_strip_typed(expr)
    if stripped == 0 { 0 }
    else {
      let tag = node_tag(stripped)
      if tag == 1 or tag == 24 { ty_i64() }
      else { if tag == 9 { ty_str() }
      else { if tag == 54 { ty_f64() }
      else { if tag == 51 { ty_nil() }
      else { 0 } } } }
    }
  }
}

fn pipeline_infer_generic_type_args_node(tparams: i64, expected_params: i64, args: i64, arg_count: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> i64 {
  if tparams == 0 { 0 }
  else {
    let subst = subst_new()
    let mut i = 0
    while i < arg_count {
      if expected_params != 0 and i < nlist_len(expected_params) {
        let expected_ty = node_f3(nlist_get(expected_params, i))
        let actual_ty = pipeline_expr_node_default_type_node(nlist_get(args, i), params, locals, module)
        pipeline_generic_infer_subst_ty(expected_ty, actual_ty, subst)
      } else { 0 }
      i = i + 1
    }
    let result = nlist_new()
    let mut j = 0
    let mut valid = 1
    while j < nlist_len(tparams) {
      let tp = nlist_get(tparams, j)
      let concrete = subst_lookup(subst, node_f3(tp))
      if concrete == 0 {
        valid = 0
        j = nlist_len(tparams)
      } else {
        nlist_add(result, concrete)
        j = j + 1
      }
    }
    if valid == 1 { result } else { 0 }
  }
}

fn pipeline_lower_inferred_generic_call_node_typed_sidecar_handler_opt(ns: i64, nl: i64, args: i64, arg_count: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let fns = pipeline_handler_lower_ctx_fns(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  let template_pair = pipeline_generic_template_find(fns, src, str_hash(src, ns, nl))
  if template_pair == 0 {
    ir_lowered_expr_invalid(next_value)
  } else {
    let fn_wrap = node_f1(template_pair)
    let tparams = fn_tparams(fn_wrap)
    if tparams == 0 {
      ir_lowered_expr_invalid(next_value)
    } else {
      let expected_params = node_f3(pipeline_fn_inner(fn_wrap))
      let inferred_type_args = pipeline_infer_generic_type_args_node(tparams, expected_params, args, arg_count, params, locals, pipeline_handler_lower_ctx_module(lower_ctx))
      if inferred_type_args == 0 {
        ir_lowered_expr_invalid(next_value)
      } else {
        let concrete_type_args = if subst == 0 { inferred_type_args } else { type_list_subst(inferred_type_args, subst) }
        let expected_subst = cg_build_subst(tparams, concrete_type_args)
        let borrowed_mask = pipeline_fn_effective_borrowable_param_mask_from_pair(fns, template_pair, expected_params, expected_subst)
        let lowered_args = pipeline_lower_node_handler_opt_args_expected_offset_borrow_mask(args, arg_count, 0, next_value, lower_ctx, expected_params, 0, expected_subst, 0, borrowed_mask)
        if pipeline_lowered_args_is_valid(lowered_args) == 1 {
          let dst = pipeline_lowered_args_next_value(lowered_args)
          let logical_args = pipeline_lowered_args_values(lowered_args)
          let abi_args = pipeline_call_abi_args(logical_args, expected_params, 0, expected_subst, 0, 0)
          let result_ty = ty_subst(fn_ret_type(fn_wrap), expected_subst)
          let call_head = ir_inst_list_prepend(
            pipeline_generic_call_inst(dst, src, tt, ns, nl, concrete_type_args, abi_args),
            ir_inst_list_empty()
          )
          let call = ir_inst_list_append(call_head, pipeline_ir_call_result_lane_insts(dst, result_ty))
          let result_lanes = pipeline_type_value_lane_count_or_one(result_ty)
          let cleanup = pipeline_managed_lambda_temp_release_arg_nodes_masked(args, arg_count, logical_args, 0, dst + result_lanes, borrowed_mask, 0, expected_params, 0, expected_subst, pipeline_handler_lower_ctx_src(lower_ctx), pipeline_handler_lower_ctx_tt(lower_ctx))
          ir_lowered_expr(dst, pipeline_lowered_args_next_value(cleanup), ir_inst_list_append(pipeline_lowered_args_insts(lowered_args), ir_inst_list_append(call, pipeline_lowered_args_insts(cleanup))))
        } else {
          ir_lowered_expr_invalid(next_value)
        }
      }
    }
  }
}

fn pipeline_lower_call_node_typed_sidecar_handler_opt(ns: i64, nl: i64, args: i64, arg_count: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let fns = pipeline_handler_lower_ctx_fns(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  let callee_hash = str_hash(src, ns, nl)
  let direct = pipeline_call_callee_is_direct(params, locals, src, ns, nl)
  let callee_value = pipeline_call_callee_value(params, locals, src, ns, nl)
  let callee_slot = pipeline_call_callee_slot(locals, src, ns, nl)
  let callee_type_node = pipeline_call_callee_type_node(params, locals, src, ns, nl, subst)
  let indirect_expected_types = pipeline_call_indirect_expected_types(direct, callee_type_node)
  let weak = pipeline_lower_weak_call_node_typed_sidecar_handler_opt(src, ns, nl, args, arg_count, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(weak) == 1 {
    weak
  } else {
    let scaled_raw = pipeline_lower_scaled_raw_call_node(callee_hash, args, arg_count, next_value, lower_ctx)
    if ir_lowered_expr_is_valid(scaled_raw) == 1 {
      scaled_raw
    } else {
    let intrinsic = pipeline_lower_native_intrinsic_call_node(callee_hash, args, arg_count, next_value, lower_ctx)
    if ir_lowered_expr_is_valid(intrinsic) == 1 {
      intrinsic
    } else {
    let bridge_mem = if direct == 1 { pipeline_lower_bridge_mem_call_node(src, ns, nl, args, arg_count, next_value, lower_ctx) } else { ir_lowered_expr_invalid(next_value) }
    if ir_lowered_expr_is_valid(bridge_mem) == 1 {
      bridge_mem
    } else {
    let inferred_generic = if direct == 1 { pipeline_lower_inferred_generic_call_node_typed_sidecar_handler_opt(ns, nl, args, arg_count, next_value, lower_ctx) } else { ir_lowered_expr_invalid(next_value) }
    if ir_lowered_expr_is_valid(inferred_generic) == 1 {
      inferred_generic
    } else { if direct == 1 or callee_value >= 0 or callee_slot >= 0 {
    let arg_start_value = if callee_slot >= 0 { next_value + 1 } else { next_value }
    let variant_payloads = if direct == 1 { pipeline_variant_payload_types(tt, src, ns, nl) } else { 0 }
    let expected_params = if variant_payloads == 0 and direct == 1 { pipeline_fns_lookup_params(fns, src, ns, nl) } else { 0 }
    let expected_types = if variant_payloads != 0 { variant_payloads } else { indirect_expected_types }
    let direct_fn = if direct == 1 { pipeline_fns_lookup_pair(fns, src, ns, nl) } else { 0 }
    let result_ty = pipeline_call_result_type_node(params, locals, src, tt, fns, subst, ns, nl)
    let borrowed_mask = if variant_payloads == 0 and direct == 1 {
      pipeline_call_borrowable_param_mask(fns, src, ns, nl, expected_params, subst)
    } else { 0 }
    let lowered_args = if expected_types != 0 {
      pipeline_lower_node_handler_opt_args_expected_types(args, arg_count, arg_start_value, lower_ctx, expected_types, subst)
    } else {
      pipeline_lower_node_handler_opt_args_expected_offset_borrow_mask(args, arg_count, 0, arg_start_value, lower_ctx, expected_params, 0, subst, 0, borrowed_mask)
    }
    if pipeline_lowered_args_is_valid(lowered_args) == 1 {
      let dst = pipeline_lowered_args_next_value(lowered_args)
      let indirect_callee = if callee_slot >= 0 { next_value } else { callee_value }
      let callee_insts = if callee_slot >= 0 {
        ir_inst_list_prepend(ir_inst_load_i64(next_value, callee_slot), ir_inst_list_empty())
      } else { ir_inst_list_empty() }
      let logical_args = pipeline_lowered_args_values(lowered_args)
      let abi_args = if variant_payloads != 0 {
        pipeline_call_abi_args(logical_args, 0, variant_payloads, subst, 0, 0)
      } else { if expected_params != 0 or expected_types != 0 {
        pipeline_call_abi_args(logical_args, expected_params, expected_types, subst, 0, 0)
      } else { logical_args } }
      let call_head = ir_inst_list_prepend(
        pipeline_call_inst_resolved(dst, direct, indirect_callee, src, tt, ns, nl, abi_args),
        ir_inst_list_empty()
      )
      let call = if result_ty != 0 {
        ir_inst_list_append(call_head, pipeline_ir_call_result_lane_insts(dst, result_ty))
      } else { call_head }
      let result_lanes = if result_ty != 0 { pipeline_type_value_lane_count_or_one(result_ty) } else { 1 }
      let cleanup = pipeline_managed_lambda_temp_release_arg_nodes_masked(args, arg_count, logical_args, 0, dst + result_lanes, borrowed_mask, 0, expected_params, expected_types, subst, pipeline_handler_lower_ctx_src(lower_ctx), pipeline_handler_lower_ctx_tt(lower_ctx))
      let insts = ir_inst_list_append(callee_insts, ir_inst_list_append(pipeline_lowered_args_insts(lowered_args), ir_inst_list_append(call, pipeline_lowered_args_insts(cleanup))))
      ir_lowered_expr(dst, pipeline_lowered_args_next_value(cleanup), insts)
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  } } } } }
  }
}

fn pipeline_lower_generic_call_node_typed_sidecar_handler_opt(type_args: i64, inner_call: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let fns = pipeline_handler_lower_ctx_fns(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  if inner_call != 0 and node_tag(inner_call) == 2 {
    let ns = node_f1(inner_call)
    let nl = node_f2(inner_call)
    let base_hash = str_hash(src, ns, nl)
    if pipeline_generic_template_find(fns, src, base_hash) == 0 {
      ir_lowered_expr_invalid(next_value)
    } else {
      let concrete_type_args = if subst == 0 { type_args } else { type_list_subst(type_args, subst) }
      ir_lowered_expr(
        next_value,
        next_value + 1,
        ir_inst_list_prepend(
          ir_inst_generic_function_ref_i64(next_value, base_hash, type_expr_list_from_type_nodes(concrete_type_args)),
          ir_inst_list_empty()
        )
      )
    }
  } else { if inner_call != 0 and node_tag(inner_call) == 4 {
    let ns = node_f1(inner_call)
    let nl = node_f2(inner_call)
    let args = node_f3(inner_call)
    let arg_count = node_f4(inner_call)
    if pipeline_variant_payload_count(tt, src, ns, nl) >= 0 or pipeline_call_callee_is_direct(params, locals, src, ns, nl) == 1 {
      let concrete_type_args = if subst == 0 { type_args } else { type_list_subst(type_args, subst) }
      let variant_payloads = pipeline_variant_payload_types(tt, src, ns, nl)
      let variant_tparams = if variant_payloads == 0 { 0 } else { ttable_variant_tparams(tt, src, ns, nl) }
      let template_pair = if variant_payloads == 0 { pipeline_generic_template_find(pipeline_handler_lower_ctx_fns(lower_ctx), src, str_hash(src, ns, nl)) } else { 0 }
      let expected_params = if template_pair == 0 { 0 } else { node_f3(pipeline_fn_inner(node_f1(template_pair))) }
      let expected_subst = if variant_payloads != 0 {
        if variant_tparams == 0 { subst } else { cg_build_subst(variant_tparams, concrete_type_args) }
      } else {
        if template_pair == 0 { 0 } else { cg_build_subst(fn_tparams(node_f1(template_pair)), concrete_type_args) }
      }
      let stable_handle_word = pipeline_collection_handle_word_stable_call(src, ns, nl, expr_list_from_nodes(args, 0, arg_count))
      let borrowed_mask = if stable_handle_word == 1 { 1 }
      else { if variant_payloads == 0 and template_pair != 0 {
        pipeline_fn_effective_borrowable_param_mask_from_pair(fns, template_pair, expected_params, expected_subst)
      } else { 0 } }
      let lowered_args = if variant_payloads != 0 {
        pipeline_lower_node_handler_opt_args_expected_types(args, arg_count, next_value, lower_ctx, variant_payloads, expected_subst)
      } else {
        pipeline_lower_node_handler_opt_args_expected_offset_borrow_mask(args, arg_count, 0, next_value, lower_ctx, expected_params, 0, expected_subst, 0, borrowed_mask)
      }
      if pipeline_lowered_args_is_valid(lowered_args) == 1 {
        let dst = pipeline_lowered_args_next_value(lowered_args)
        let logical_args = pipeline_lowered_args_values(lowered_args)
        let abi_args = if variant_payloads != 0 {
          pipeline_call_abi_args(logical_args, 0, variant_payloads, expected_subst, 0, 0)
        } else { if template_pair != 0 and stable_handle_word == 0 {
          pipeline_call_abi_args(logical_args, expected_params, 0, expected_subst, 0, 0)
        } else { logical_args } }
        let call_head = ir_inst_list_prepend(
          if stable_handle_word == 1 {
            pipeline_collection_handle_word_inst(dst, logical_args)
          } else {
            pipeline_generic_call_inst(dst, src, tt, ns, nl, concrete_type_args, abi_args)
          },
          ir_inst_list_empty()
        )
        let result_ty = if template_pair == 0 { 0 } else { ty_subst(fn_ret_type(node_f1(template_pair)), expected_subst) }
        let call = if template_pair != 0 and stable_handle_word == 0 {
          ir_inst_list_append(call_head, pipeline_ir_call_result_lane_insts(dst, result_ty))
        } else { call_head }
        let result_lanes = if template_pair != 0 and stable_handle_word == 0 { pipeline_type_value_lane_count_or_one(result_ty) } else { 1 }
        let cleanup = pipeline_managed_lambda_temp_release_arg_nodes_masked(args, arg_count, logical_args, 0, dst + result_lanes, borrowed_mask, 0, expected_params, variant_payloads, expected_subst, pipeline_handler_lower_ctx_src(lower_ctx), pipeline_handler_lower_ctx_tt(lower_ctx))
        ir_lowered_expr(dst, pipeline_lowered_args_next_value(cleanup), ir_inst_list_append(pipeline_lowered_args_insts(lowered_args), ir_inst_list_append(call, pipeline_lowered_args_insts(cleanup))))
      } else {
        ir_lowered_expr_invalid(next_value)
      }
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  } }
}

fn pipeline_lower_method_call_node_typed_sidecar_handler_opt(recv_node: i64, method_hash: i64, args: i64, arg_count: i64, method_ref: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  let receiver = pipeline_lower_expr_node_typed_sidecar_handler_ctx(recv_node, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(receiver) == 1 {
    let method_params = pipeline_method_ref_params(tt, method_ref, method_hash, subst)
    let borrowed_mask = pipeline_method_ref_borrowable_param_mask(pipeline_handler_lower_ctx_fns(lower_ctx), tt, method_ref, method_hash, subst)
    let lowered_args = pipeline_lower_node_handler_opt_args_expected_offset_borrow_mask(args, arg_count, 0, ir_lowered_expr_next_value(receiver), lower_ctx, method_params, 0, 0, 1, borrowed_mask)
    if pipeline_lowered_args_is_valid(lowered_args) == 1 {
      let dst = pipeline_lowered_args_next_value(lowered_args)
      let call = ir_inst_list_prepend(
        pipeline_method_call_inst(dst, method_ref, method_hash, ir_lowered_expr_value(receiver), pipeline_lowered_args_values(lowered_args), subst, tt),
        ir_inst_list_empty()
      )
      let cleanup = pipeline_managed_lambda_temp_release_arg_nodes_masked(args, arg_count, pipeline_lowered_args_values(lowered_args), 0, dst + 1, borrowed_mask, 1, method_params, 0, 0, pipeline_handler_lower_ctx_src(lower_ctx), pipeline_handler_lower_ctx_tt(lower_ctx))
      ir_lowered_expr(dst, pipeline_lowered_args_next_value(cleanup), ir_inst_list_append(ir_lowered_expr_insts(receiver), ir_inst_list_append(pipeline_lowered_args_insts(lowered_args), ir_inst_list_append(call, pipeline_lowered_args_insts(cleanup)))))
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_binop_node_typed_sidecar_handler_opt_with_float_prim(op_id: i64, lhs_node: i64, rhs_node: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx, prim: i64) -> IrLoweredExpr {
  let lhs = pipeline_lower_expr_node_typed_sidecar_handler_opt_with_float_prim(lhs_node, next_value, lower_ctx, prim)
  if ir_lowered_expr_is_valid(lhs) == 1 {
    let rhs = pipeline_lower_expr_node_typed_sidecar_handler_opt_with_float_prim(rhs_node, ir_lowered_expr_next_value(lhs), lower_ctx, prim)
    if ir_lowered_expr_is_valid(rhs) == 1 {
      let op = ir_binary_op_from_parser(op_id)
      if ir_binary_op_is_supported(op) == 1 {
        let dst = ir_lowered_expr_next_value(rhs)
        let inst = ir_inst_list_prepend(
          ir_inst_float_binary_i64(dst, prim, op, ir_lowered_expr_value(lhs), ir_lowered_expr_value(rhs)),
          ir_inst_list_empty()
        )
        ir_lowered_expr(dst, dst + 1, ir_inst_list_append(ir_lowered_expr_insts(lhs), ir_inst_list_append(ir_lowered_expr_insts(rhs), inst)))
      } else {
        ir_lowered_expr_invalid(next_value)
      }
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_expr_node_typed_sidecar_handler_opt_with_float_prim(expr: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx, prim: i64) -> IrLoweredExpr {
  let stripped = pipeline_expr_node_strip_typed(expr)
  if stripped != 0 and node_tag(stripped) == 54 {
    pipeline_lower_float_lit_typed(pipeline_handler_lower_ctx_src(lower_ctx), node_f1(stripped), node_f2(stripped), next_value, prim)
  } else {
    if stripped != 0 and node_tag(stripped) == 3 and pipeline_prim_is_forced_numeric_context(prim) == 1 {
      pipeline_lower_binop_node_typed_sidecar_handler_opt_with_float_prim(node_f1(stripped), node_f2(stripped), node_f3(stripped), next_value, lower_ctx, prim)
    } else {
      pipeline_lower_expr_node_typed_sidecar_handler_ctx(stripped, next_value, lower_ctx)
    }
  }
}

fn pipeline_lower_binop_node_typed_sidecar_handler_opt(op_id: i64, lhs_node: i64, rhs_node: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  let float_prim = pipeline_binop_float_prim_node_temp(op_id, lhs_node, rhs_node, params, locals, src, pipeline_handler_lower_ctx_fns(lower_ctx), subst)
  let int_prim = if float_prim == 0 {
    pipeline_binop_int_prim_node(op_id, lhs_node, rhs_node, params, locals, src, tt, pipeline_handler_lower_ctx_fns(lower_ctx), subst)
  } else { 0 - 1 }
  let numeric_prim = if float_prim != 0 { float_prim } else { int_prim }
  let lhs = if float_prim != 0 or int_prim >= 0 {
    pipeline_lower_expr_node_typed_sidecar_handler_opt_with_float_prim(lhs_node, next_value, lower_ctx, numeric_prim)
  } else {
    pipeline_lower_expr_node_typed_sidecar_handler_ctx(lhs_node, next_value, lower_ctx)
  }
  if ir_lowered_expr_is_valid(lhs) == 1 {
    let rhs = if float_prim != 0 or int_prim >= 0 {
      pipeline_lower_expr_node_typed_sidecar_handler_opt_with_float_prim(rhs_node, ir_lowered_expr_next_value(lhs), lower_ctx, numeric_prim)
    } else {
      pipeline_lower_expr_node_typed_sidecar_handler_ctx(rhs_node, ir_lowered_expr_next_value(lhs), lower_ctx)
    }
    if ir_lowered_expr_is_valid(rhs) == 1 {
      let op = ir_binary_op_from_parser(op_id)
      if ir_binary_op_is_supported(op) == 1 {
        let dst = ir_lowered_expr_next_value(rhs)
        -- Same content-eq selection as the straight-line paths (see
        -- pipeline_lower_binop_lhs_cfg_to_target_blocks).
        let str_eq = if float_prim == 0 and int_prim < 0 { pipeline_binop_is_str_content_eq(op_id, expr_from_node(lhs_node), expr_from_node(rhs_node), params, locals, src, tt, pipeline_handler_lower_ctx_fns(lower_ctx), subst) } else { 0 }
        let binary = if str_eq == 1 {
          pipeline_str_content_eq_insts(op_id, dst, ir_lowered_expr_value(lhs), ir_lowered_expr_value(rhs))
        } else {
          let inst = if float_prim != 0 {
            ir_inst_float_binary_i64(dst, float_prim, op, ir_lowered_expr_value(lhs), ir_lowered_expr_value(rhs))
          } else { if int_prim >= 0 {
            ir_inst_float_binary_i64(dst, int_prim, op, ir_lowered_expr_value(lhs), ir_lowered_expr_value(rhs))
          } else {
            ir_inst_binary_i64(dst, op, ir_lowered_expr_value(lhs), ir_lowered_expr_value(rhs))
          } }
          ir_inst_list_prepend(inst, ir_inst_list_empty())
        }
        let result = if str_eq == 1 { pipeline_str_content_eq_result(op_id, dst) } else { dst }
        ir_lowered_expr(result, result + 1, ir_inst_list_append(ir_lowered_expr_insts(lhs), ir_inst_list_append(ir_lowered_expr_insts(rhs), binary)))
      } else {
        ir_lowered_expr_invalid(next_value)
      }
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_not_node_typed_sidecar_handler_opt(operand_node: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let value = pipeline_lower_expr_node_typed_sidecar_handler_ctx(operand_node, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(value) == 1 {
    let dst = ir_lowered_expr_next_value(value)
    let unary = ir_inst_list_prepend(ir_inst_unary_i64(dst, ir_unary_op_not(), ir_lowered_expr_value(value)), ir_inst_list_empty())
    ir_lowered_expr(dst, dst + 1, ir_inst_list_append(ir_lowered_expr_insts(value), unary))
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_block_node_typed_sidecar_handler_opt(first_node: i64, rest_node: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let first = pipeline_lower_expr_node_typed_sidecar_handler_ctx(first_node, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(first) == 1 {
    if rest_node == 0 {
      first
    } else {
      let rest = pipeline_lower_expr_node_typed_sidecar_handler_ctx(rest_node, ir_lowered_expr_next_value(first), lower_ctx)
      if ir_lowered_expr_is_valid(rest) == 1 {
        ir_lowered_expr(ir_lowered_expr_value(rest), ir_lowered_expr_next_value(rest), ir_inst_list_append(ir_lowered_expr_insts(first), ir_lowered_expr_insts(rest)))
      } else {
        ir_lowered_expr_invalid(next_value)
      }
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_let_node_typed_sidecar_handler_opt_with_float_prim(ns: i64, nl: i64, value_node: i64, body_node: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx, local_float: i64, local_type_node: i64) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let handlers = pipeline_handler_lower_ctx_handlers(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  let value = if pipeline_prim_is_forced_numeric_context(local_float) == 1 {
    pipeline_lower_expr_node_typed_sidecar_handler_opt_with_float_prim(value_node, next_value, lower_ctx, local_float)
  } else {
    pipeline_lower_expr_node_typed_sidecar_handler_ctx(value_node, next_value, lower_ctx)
  }
  if ir_lowered_expr_is_valid(value) == 1 {
    let inferred_float_prim = pipeline_expr_float_prim_node_temp(value_node, params, locals, src, pipeline_handler_lower_ctx_fns(lower_ctx), subst)
    let float_prim = if local_float == PRIM_F32() or local_float == PRIM_F64() { local_float } else { inferred_float_prim }
    let inferred_type_hash = pipeline_expr_type_hash_node_temp(value_node, params, locals, src, tt, pipeline_handler_lower_ctx_fns(lower_ctx), subst)
    let inferred_type_node = pipeline_init_type_node_from_node(value_node, params, locals, pipeline_handler_lower_ctx_module(lower_ctx))
    let effective_type_node = if local_type_node != 0 { ty_subst(local_type_node, subst) } else { inferred_type_node }
    let local_lanes = pipeline_type_value_lane_count_or_one(effective_type_node)
    let annotated_type_hash = if local_type_node != 0 and effective_type_node != 0 { type_hash_of(effective_type_node) } else { 0 }
    let inferred_node_type_hash = if effective_type_node != 0 { type_hash_of(effective_type_node) } else { 0 }
    let local_type_hash = if annotated_type_hash != 0 { annotated_type_hash } else { if inferred_node_type_hash != 0 { inferred_node_type_hash } else { if local_float != 0 and pipeline_prim_is_numeric_context(local_float) == 1 { pipeline_type_hash_of_prim_id(local_float) } else { pipeline_expr_type_hash_sharpen_int_node(value_node, inferred_type_hash, params, locals, src, tt, pipeline_handler_lower_ctx_fns(lower_ctx), subst) } } }
    let address_taken = pipeline_expr_node_address_of_binding(body_node, src, ns, nl)
    let slot = pipeline_ir_addressable_slot_id(ir_lowered_expr_next_value(value))
    let bind_value_for_retain = if address_taken == 1 { slot } else { ir_lowered_expr_value(value) }
    let retain_insts = if address_taken == 1 or pipeline_expr_node_result_is_borrowed_for_ty_typed(value_node, effective_type_node, src, pipeline_handler_lower_ctx_fns(lower_ctx), subst, pipeline_handler_lower_ctx_tt(lower_ctx)) == 0 {
      ir_inst_list_empty()
    } else {
      pipeline_managed_retain_inst_list(bind_value_for_retain, effective_type_node, ir_lowered_expr_next_value(value))
    }
    let body_next = if address_taken == 1 {
      slot + local_lanes
    } else {
      ir_lowered_expr_next_value(value) + ir_inst_list_len(retain_insts)
    }
    let next_locals = if address_taken == 1 {
      pipeline_value_env_push_slot_float_typed_node(locals, ns, nl, slot, float_prim, local_type_hash, effective_type_node)
    } else {
      pipeline_value_env_push_float_typed_node(locals, ns, nl, ir_lowered_expr_value(value), float_prim, local_type_hash, effective_type_node)
    }
    let body_ctx = pipeline_handler_lower_ctx_from_module(params, next_locals, pipeline_handler_lower_ctx_module(lower_ctx))
    let body = pipeline_lower_expr_node_typed_sidecar_handler_ctx(body_node, body_next, body_ctx)
    if ir_lowered_expr_is_valid(body) == 1 {
      let bind_value = if address_taken == 1 { slot } else { ir_lowered_expr_value(value) }
      let bind = ir_inst_list_prepend(ir_inst_bind_typed_i64(ns, nl, bind_value, effective_type_node), ir_inst_list_empty())
      let slot_insts = if address_taken == 1 {
        pipeline_ir_slot_lane_init_insts(slot, ir_lowered_expr_value(value), 0, local_lanes)
      } else { ir_inst_list_empty() }
      let release_dst = ir_lowered_expr_next_value(body)
      let body_returns_binding = pipeline_expr_node_final_returns_binding(body_node, src, ns, nl)
      let release_insts = if address_taken == 1 or body_returns_binding == 1 { ir_inst_list_empty() } else { pipeline_managed_release_inst_list(bind_value, effective_type_node, release_dst) }
      -- Owned bindings drop at scope exit; see the expr variant for the
      -- never-referenced rule shared with defer-owned lowering.
      let owned_type_hash = if local_type_node != 0 and effective_type_node != 0 { cg_owned_drop_type_hash(effective_type_node) } else { 0 }
      let owned_drop_insts = if owned_type_hash != 0 and address_taken == 0 and pipeline_expr_refs_name(body_node, src, ns, nl) == 0 {
        ir_inst_list_prepend(ir_inst_owned_drop_i64(bind_value, owned_type_hash), ir_inst_list_empty())
      } else { ir_inst_list_empty() }
      let next_after_release = release_dst + ir_inst_list_len(release_insts)
      ir_lowered_expr(
        ir_lowered_expr_value(body),
        next_after_release,
        ir_inst_list_append(ir_lowered_expr_insts(value), ir_inst_list_append(slot_insts, ir_inst_list_append(retain_insts, ir_inst_list_append(bind, ir_inst_list_append(ir_lowered_expr_insts(body), ir_inst_list_append(owned_drop_insts, release_insts))))))
      )
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_let_mut_node_typed_sidecar_handler_opt_with_float_prim(ns: i64, nl: i64, value_node: i64, body_node: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx, local_float: i64, local_type_node: i64) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let handlers = pipeline_handler_lower_ctx_handlers(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  let value = if pipeline_prim_is_forced_numeric_context(local_float) == 1 {
    pipeline_lower_expr_node_typed_sidecar_handler_opt_with_float_prim(value_node, next_value, lower_ctx, local_float)
  } else {
    pipeline_lower_expr_node_typed_sidecar_handler_ctx(value_node, next_value, lower_ctx)
  }
  if ir_lowered_expr_is_valid(value) == 1 {
    let address_taken = pipeline_expr_node_address_of_binding(body_node, src, ns, nl)
    let slot = if address_taken == 1 {
      pipeline_ir_addressable_slot_id(ir_lowered_expr_next_value(value))
    } else {
      ir_lowered_expr_next_value(value)
    }
    let inferred_float_prim = pipeline_expr_float_prim_node_temp(value_node, params, locals, src, pipeline_handler_lower_ctx_fns(lower_ctx), subst)
    let float_prim = if local_float == PRIM_F32() or local_float == PRIM_F64() { local_float } else { inferred_float_prim }
    let inferred_type_hash = pipeline_expr_type_hash_node_temp(value_node, params, locals, src, tt, pipeline_handler_lower_ctx_fns(lower_ctx), subst)
    let inferred_type_node = pipeline_init_type_node_from_node(value_node, params, locals, pipeline_handler_lower_ctx_module(lower_ctx))
    let effective_type_node = if local_type_node != 0 { ty_subst(local_type_node, subst) } else { inferred_type_node }
    let local_lanes = pipeline_type_value_lane_count_or_one(effective_type_node)
    let slot_insts = pipeline_ir_slot_lane_init_insts(slot, ir_lowered_expr_value(value), 0, local_lanes)
    let annotated_type_hash = if local_type_node != 0 and effective_type_node != 0 { type_hash_of(effective_type_node) } else { 0 }
    let inferred_node_type_hash = if effective_type_node != 0 { type_hash_of(effective_type_node) } else { 0 }
    let local_type_hash = if annotated_type_hash != 0 { annotated_type_hash } else { if inferred_node_type_hash != 0 { inferred_node_type_hash } else { if local_float != 0 and pipeline_prim_is_numeric_context(local_float) == 1 { pipeline_type_hash_of_prim_id(local_float) } else { pipeline_expr_type_hash_sharpen_int_node(value_node, inferred_type_hash, params, locals, src, tt, pipeline_handler_lower_ctx_fns(lower_ctx), subst) } } }
    let retain_insts = if effective_type_node != 0 and pipeline_expr_node_result_is_borrowed_for_ty_typed(value_node, effective_type_node, src, pipeline_handler_lower_ctx_fns(lower_ctx), subst, pipeline_handler_lower_ctx_tt(lower_ctx)) == 1 {
      pipeline_managed_retain_inst_list(ir_lowered_expr_value(value), effective_type_node, slot + local_lanes)
    } else {
      ir_inst_list_empty()
    }
    let body_next_value = slot + local_lanes + ir_inst_list_len(retain_insts)
    let next_locals = pipeline_value_env_push_slot_float_typed_node(locals, ns, nl, slot, float_prim, local_type_hash, effective_type_node)
    let body_ctx = pipeline_handler_lower_ctx_from_module(params, next_locals, pipeline_handler_lower_ctx_module(lower_ctx))
    let body = pipeline_lower_expr_node_typed_sidecar_handler_ctx(body_node, body_next_value, body_ctx)
    if ir_lowered_expr_is_valid(body) == 1 {
      let bind = ir_inst_list_prepend(ir_inst_bind_typed_i64(ns, nl, slot, effective_type_node), ir_inst_list_empty())
      -- Straight node-side lowering is the normal path for non-CFG
      -- functions. Keep its mutable-slot lifetime contract identical to the
      -- typed path: the final slot value, not merely the initializer, owns
      -- the scope stake. Indexed COW mutation depends on this load-after-
      -- store cleanup to release the replacement backing.
      let scope_needs_release = if address_taken == 1 or effective_type_node == 0 { 0 }
        else { if pipeline_expr_node_final_returns_binding(body_node, src, ns, nl) == 1 { 0 }
        else { ty_value_has_release_lane(effective_type_node) } }
      let cleanup_insts = if scope_needs_release == 1 { pipeline_managed_slot_cleanup_inst_list(slot, effective_type_node, ir_lowered_expr_next_value(body)) } else { ir_inst_list_empty() }
      let after_cleanup = ir_lowered_expr_next_value(body) + ir_inst_list_len(cleanup_insts)
      ir_lowered_expr(ir_lowered_expr_value(body), after_cleanup, ir_inst_list_append(ir_lowered_expr_insts(value), ir_inst_list_append(slot_insts, ir_inst_list_append(retain_insts, ir_inst_list_append(bind, ir_inst_list_append(ir_lowered_expr_insts(body), cleanup_insts))))))
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_assign_node_typed_sidecar_handler_opt(ns: i64, nl: i64, value_node: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  let slot = pipeline_value_env_lookup(locals, src, ns, nl)
  if slot >= 0 and pipeline_value_env_lookup_kind(locals, src, ns, nl) == 1 {
    let slot_float = pipeline_value_env_lookup_float_prim(locals, src, ns, nl)
    let slot_int = if slot_float == 0 { pipeline_type_hash_int_prim_or(pipeline_value_env_lookup_type_hash(locals, src, ns, nl), 0 - 1) } else { 0 - 1 }
    let slot_prim = if slot_float == PRIM_F32() or slot_float == PRIM_F64() { slot_float } else { slot_int }
    let slot_ty = pipeline_value_env_lookup_type_node(locals, src, ns, nl)
    let slot_lanes = pipeline_type_value_lane_count_or_one(slot_ty)
    let value = if pipeline_prim_is_forced_numeric_context(slot_prim) == 1 {
      pipeline_lower_expr_node_typed_sidecar_handler_opt_with_float_prim(value_node, next_value, lower_ctx, slot_prim)
    } else {
      pipeline_lower_expr_node_typed_sidecar_handler_ctx(value_node, next_value, lower_ctx)
    }
    if ir_lowered_expr_is_valid(value) == 1 {
      let retain_insts = if slot_ty != 0 and pipeline_expr_node_result_is_borrowed_for_ty_typed(value_node, slot_ty, src, pipeline_handler_lower_ctx_fns(lower_ctx), subst, pipeline_handler_lower_ctx_tt(lower_ctx)) == 1 {
        pipeline_managed_retain_inst_list(ir_lowered_expr_value(value), slot_ty, ir_lowered_expr_next_value(value))
      } else {
        ir_inst_list_empty()
      }
      let after_retain = ir_lowered_expr_next_value(value) + ir_inst_list_len(retain_insts)
      let old_value = after_retain
      let release_count = pipeline_type_managed_release_lane_count(slot_ty)
      let load_old_insts = if release_count > 0 {
        pipeline_ir_slot_managed_lane_load_insts(old_value, slot, slot_ty, 0, slot_lanes)
      } else {
        ir_inst_list_empty()
      }
      let release_insts = if release_count > 0 {
        pipeline_managed_release_inst_list(old_value, slot_ty, old_value + slot_lanes)
      } else {
        ir_inst_list_empty()
      }
      let nil_value = if release_count > 0 { old_value + slot_lanes + ir_inst_list_len(release_insts) } else { old_value }
      let assign_insts = ir_inst_list_append(
        pipeline_ir_slot_store_lane_insts(slot, ir_lowered_expr_value(value), 0, slot_lanes),
        ir_inst_list_prepend(ir_inst_const_i64(nil_value, 0), ir_inst_list_empty())
      )
      let update_insts = ir_inst_list_append(retain_insts, ir_inst_list_append(load_old_insts, ir_inst_list_append(release_insts, assign_insts)))
      ir_lowered_expr(nil_value, nil_value + 1, ir_inst_list_append(ir_lowered_expr_insts(value), update_insts))
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_address_of_node_typed_sidecar_handler_opt(mutable: i64, target: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  if target != 0 and node_tag(target) == 2 {
    let ns = node_f1(target)
    let nl = node_f2(target)
    let local = pipeline_value_env_lookup(locals, src, ns, nl)
    if local >= 0 {
      if pipeline_value_env_lookup_kind(locals, src, ns, nl) == 1 {
        ir_lowered_expr(next_value, next_value + 1, ir_inst_list_prepend(ir_inst_address_of_slot_i64(next_value, local), ir_inst_list_empty()))
      } else {
        let slot = pipeline_ir_addressable_slot_id(next_value)
        let local_ty = pipeline_value_env_lookup_type_node(locals, src, ns, nl)
        let lanes = pipeline_type_value_lane_count_or_one(local_ty)
        let ptr = slot + lanes
        let insts = ir_inst_list_append(
          pipeline_ir_slot_lane_init_insts(slot, local, 0, lanes),
          ir_inst_list_prepend(ir_inst_address_of_slot_i64(ptr, slot), ir_inst_list_empty())
        )
        ir_lowered_expr(ptr, ptr + 1, insts)
      }
    } else {
      let param_id = if params == 0 { 0 - 1 } else { pipeline_param_index(params, src, ns, nl) }
      if param_id >= 0 {
        let slot = pipeline_ir_addressable_slot_id(next_value)
        let param_ty = pipeline_param_type_node_by_name(params, src, ns, nl, pipeline_handler_lower_ctx_subst(lower_ctx))
        let lanes = pipeline_type_value_lane_count_or_one(param_ty)
        let ptr = slot + lanes
        let insts = ir_inst_list_append(
          pipeline_ir_slot_lane_init_insts(slot, param_id, 0, lanes),
          ir_inst_list_prepend(ir_inst_address_of_slot_i64(ptr, slot), ir_inst_list_empty())
        )
        ir_lowered_expr(ptr, ptr + 1, insts)
      } else {
        ir_lowered_expr_invalid(next_value)
      }
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_deref_node_typed_sidecar_handler_opt(ptr_node: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let ptr = pipeline_lower_expr_node_typed_sidecar_handler_ctx(ptr_node, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(ptr) == 1 {
    let dst = ir_lowered_expr_next_value(ptr)
    let inst = ir_inst_list_prepend(ir_inst_ptr_load_i64(dst, ir_lowered_expr_value(ptr)), ir_inst_list_empty())
    ir_lowered_expr(dst, dst + 1, ir_inst_list_append(ir_lowered_expr_insts(ptr), inst))
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_ptr_assign_node_typed_sidecar_handler_opt(ptr_node: i64, value_node: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let ptr = pipeline_lower_expr_node_typed_sidecar_handler_ctx(ptr_node, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(ptr) == 1 {
    let value = pipeline_lower_expr_node_typed_sidecar_handler_ctx(value_node, ir_lowered_expr_next_value(ptr), lower_ctx)
    if ir_lowered_expr_is_valid(value) == 1 {
      let dst = ir_lowered_expr_next_value(value)
      let inst = ir_inst_list_prepend(ir_inst_ptr_store_i64(dst, ir_lowered_expr_value(ptr), ir_lowered_expr_value(value)), ir_inst_list_empty())
      ir_lowered_expr(dst, dst + 1, ir_inst_list_append(ir_lowered_expr_insts(ptr), ir_inst_list_append(ir_lowered_expr_insts(value), inst)))
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_field_access_node_typed_sidecar_handler_opt(base_node: i64, field_ns: i64, field_nl: i64, access_fact_node: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  pipeline_lower_field_access_expr_typed_sidecar_handler_opt(
    expr_from_node(base_node),
    field_ns,
    field_nl,
    field_access_fact_from_node(access_fact_node),
    next_value,
    lower_ctx
  )
}

fn pipeline_lower_indexed_len_node_typed_sidecar_handler_opt(base_node: i64, fixed_len: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let base = pipeline_lower_expr_node_typed_sidecar_handler_ctx(base_node, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(base) == 1 {
    let base_expr = expr_from_node(base_node)
    let result = pipeline_lower_indexed_len_after_base_typed(base_expr, fixed_len, ir_lowered_expr_value(base), ir_lowered_expr_next_value(base), lower_ctx)
    ir_lowered_expr(ir_lowered_expr_value(result), ir_lowered_expr_next_value(result), ir_inst_list_append(ir_lowered_expr_insts(base), ir_lowered_expr_insts(result)))
  } else { ir_lowered_expr_invalid(next_value) }
}

fn pipeline_lower_indexed_get_node_typed_sidecar_handler_opt(base_node: i64, index_node: i64, element_ty: i64, fixed_len: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let base = pipeline_lower_expr_node_typed_sidecar_handler_ctx(base_node, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(base) == 0 { ir_lowered_expr_invalid(next_value) }
  else {
    let index = pipeline_lower_expr_node_typed_sidecar_handler_ctx(index_node, ir_lowered_expr_next_value(base), lower_ctx)
    if ir_lowered_expr_is_valid(index) == 0 { ir_lowered_expr_invalid(next_value) }
    else {
      let loaded = pipeline_lower_indexed_get_after_values_typed(expr_from_node(base_node), expr_from_node(index_node), element_ty, fixed_len, ir_lowered_expr_value(base), ir_lowered_expr_value(index), ir_lowered_expr_next_value(index), lower_ctx)
      ir_lowered_expr(ir_lowered_expr_value(loaded), ir_lowered_expr_next_value(loaded), ir_inst_list_append(ir_lowered_expr_insts(base), ir_inst_list_append(ir_lowered_expr_insts(index), ir_lowered_expr_insts(loaded))))
    }
  }
}

fn pipeline_lower_indexed_set_node_typed_sidecar_handler_opt(base_node: i64, index_node: i64, value_node: i64, fact: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  pipeline_lower_indexed_set_expr_typed_sidecar_handler_opt(expr_from_node(base_node), expr_from_node(index_node), expr_from_node(value_node), fact, next_value, lower_ctx)
}

fn pipeline_lower_indexed_slice_node_typed_sidecar_handler_opt(base_node: i64, start_node: i64, end_node: i64, fact: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  pipeline_lower_indexed_slice_expr_typed_sidecar_handler_opt(expr_from_node(base_node), expr_from_node(start_node), expr_from_node(end_node), fact, next_value, lower_ctx)
}

fn pipeline_lower_opt_chain_node_typed_sidecar_handler_opt(base_node: i64, field_ns: i64, field_nl: i64, effect_atom: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let base = pipeline_lower_expr_node_typed_sidecar_handler_ctx(base_node, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(base) == 1 {
    let dst = ir_lowered_expr_next_value(base)
    let effect_key = pipeline_effect_atom_dispatch_key(effect_atom, pipeline_handler_lower_ctx_subst(lower_ctx), effect_maybe_head_hash())
    let storage_layout = pipeline_record_storage_layout_for_base_node(tt, src, base_node, pipeline_handler_lower_ctx_params(lower_ctx), pipeline_handler_lower_ctx_locals(lower_ctx), pipeline_handler_lower_ctx_module(lower_ctx))
    let opt = pipeline_ir_opt_chain_insts_for_storage_layout(dst, ir_lowered_expr_value(base), str_hash(src, field_ns, field_nl), pipeline_typed_field_index_for_base_node(tt, src, field_ns, field_nl, base_node, pipeline_handler_lower_ctx_params(lower_ctx), pipeline_handler_lower_ctx_locals(lower_ctx), pipeline_handler_lower_ctx_module(lower_ctx)), effect_key, storage_layout)
    ir_lowered_expr(dst, dst + 1, ir_inst_list_append(ir_lowered_expr_insts(base), opt))
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_record_init_node_typed_sidecar_handler_opt(type_ns: i64, type_nl: i64, fields: i64, field_count: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let lowered_fields = pipeline_lower_record_field_nodes_handler_opt(fields, field_count, 0, type_ns, type_nl, next_value, lower_ctx)
  if pipeline_lowered_record_fields_is_valid(lowered_fields) == 1 {
    let dst = pipeline_lowered_record_fields_next_value(lowered_fields)
    let record_entry = ttable_lookup(pipeline_handler_lower_ctx_tt(lower_ctx), src, type_ns, type_nl)
    let record = ir_inst_list_prepend(
      pipeline_record_init_inst_for_storage_layout(
        pipeline_handler_lower_ctx_tt(lower_ctx),
        record_entry,
        pipeline_handler_lower_ctx_subst(lower_ctx),
        dst,
        str_hash(src, type_ns, type_nl),
        pipeline_lowered_record_fields_values(lowered_fields)
      ),
      ir_inst_list_empty()
    )
    let cleanup = pipeline_record_array_source_releases_for_storage_layout(
      pipeline_handler_lower_ctx_tt(lower_ctx),
      record_entry,
      pipeline_handler_lower_ctx_subst(lower_ctx),
      pipeline_lowered_record_fields_values(lowered_fields),
      dst + 1
    )
    if pipeline_lowered_args_is_valid(cleanup) == 1 {
      ir_lowered_expr(dst, pipeline_lowered_args_next_value(cleanup), ir_inst_list_append(pipeline_lowered_record_fields_insts(lowered_fields), ir_inst_list_append(record, pipeline_lowered_args_insts(cleanup))))
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_try_node_typed_sidecar_handler_opt(inner_node: i64, effect_atom: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let value = pipeline_lower_expr_node_typed_sidecar_handler_ctx(inner_node, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(value) == 1 {
    let dst = ir_lowered_expr_next_value(value)
    let effect_key = pipeline_effect_atom_dispatch_key(effect_atom, pipeline_handler_lower_ctx_subst(lower_ctx), effect_fail_head_hash())
    let try_inst = ir_inst_list_prepend(ir_inst_try_i64(dst, ir_lowered_expr_value(value), effect_key), ir_inst_list_empty())
    ir_lowered_expr(dst, dst + 1, ir_inst_list_append(ir_lowered_expr_insts(value), try_inst))
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_interp_concat_node_typed_sidecar_handler_opt(left_node: i64, right_node: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let left = pipeline_lower_expr_node_typed_sidecar_handler_ctx(left_node, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(left) == 1 {
    let right = pipeline_lower_expr_node_typed_sidecar_handler_ctx(right_node, ir_lowered_expr_next_value(left), lower_ctx)
    if ir_lowered_expr_is_valid(right) == 1 {
      let dst = ir_lowered_expr_next_value(right)
      let concat = ir_inst_list_prepend(ir_inst_string_concat_i64(dst, ir_lowered_expr_value(left), ir_lowered_expr_value(right)), ir_inst_list_empty())
      ir_lowered_expr(dst, dst + 1, ir_inst_list_append(ir_lowered_expr_insts(left), ir_inst_list_append(ir_lowered_expr_insts(right), concat)))
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_perform_node_typed_sidecar_handler_opt(lhs_node: i64, op_ns: i64, op_nl: i64, args: i64, arg_count: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let ctx = pipeline_handler_lower_ctx_handlers(lower_ctx)
  let effect_ident = effect_ref_ident_node(lhs_node)
  if effect_ident != 0 {
    let eff_ns = node_f1(effect_ident)
    let eff_nl = node_f2(effect_ident)
    let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
    let local_recv_ty = pipeline_value_env_lookup_type_node(locals, src, eff_ns, eff_nl)
    let recv_ty = if local_recv_ty != 0 {
      ty_subst(local_recv_ty, subst)
    } else {
      pipeline_param_type_node_by_name(params, src, eff_ns, eff_nl, subst)
    }
    let method_hash = effect_name_hash(src, op_ns, op_nl)
    let method_ref = pipeline_resolve_method_ref(pipeline_handler_lower_ctx_tt(lower_ctx), recv_ty, method_hash)
    if method_ref != 0 {
      pipeline_lower_method_call_node_typed_sidecar_handler_opt(lhs_node, method_hash, args, arg_count, method_ref, next_value, lower_ctx)
    } else {
      let effect_ref = expr_from_node(lhs_node)
      let expected_params = pipeline_effect_op_params_nodes_typed(pipeline_handler_lower_ctx_tt(lower_ctx), src, effect_ref, op_ns, op_nl, subst)
      let return_ty = pipeline_effect_op_return_type_typed(pipeline_handler_lower_ctx_tt(lower_ctx), src, effect_ref, op_ns, op_nl, subst)
      let result_lanes = pipeline_type_value_lane_count_or_one(return_ty)
      let lowered_args = pipeline_lower_node_handler_opt_args_expected(args, arg_count, next_value, lower_ctx, expected_params, 0)
      if pipeline_lowered_args_is_valid(lowered_args) == 1 {
        let dst = pipeline_lowered_args_next_value(lowered_args)
        let logical_args = pipeline_lowered_args_values(lowered_args)
        let abi_args = pipeline_call_abi_args(logical_args, expected_params, 0, 0, 0, 0)
        let eff_hash = pipeline_effect_ref_dispatch_key_node(src, lhs_node, subst)
        let op_hash = effect_name_hash(src, op_ns, op_nl)
        let found = pipeline_handler_inline_ctx_find_match(ctx, src, eff_hash, op_hash)
        let tail_inline = pipeline_handler_inline_try_tail_resume(ctx, found, logical_args, pipeline_handler_lower_ctx_tt(lower_ctx), pipeline_handler_lower_ctx_fns(lower_ctx), dst)
        if ir_lowered_expr_is_valid(tail_inline) == 1 {
          ir_lowered_expr(
            ir_lowered_expr_value(tail_inline),
            ir_lowered_expr_next_value(tail_inline),
            ir_inst_list_append(pipeline_lowered_args_insts(lowered_args), ir_lowered_expr_insts(tail_inline))
          )
        } else {
        let op_inst = if pipeline_handler_inline_match_found(found) == 1 {
          ir_inst_handler_direct_i64(dst, eff_hash, op_hash, pipeline_handler_inline_match_depth_or(found, 0 - 1), pipeline_handler_inline_match_clause_index_or(found, 0 - 1), abi_args)
        } else {
          ir_inst_perform_i64(dst, eff_hash, op_hash, abi_args)
        }
        let perform = ir_inst_list_append(ir_inst_list_prepend(op_inst, ir_inst_list_empty()), pipeline_ir_call_result_lane_insts(dst, return_ty))
        let insts = ir_inst_list_append(pipeline_lowered_args_insts(lowered_args), perform)
        ir_lowered_expr(dst, dst + result_lanes, insts)
        }
      } else {
        ir_lowered_expr_invalid(next_value)
      }
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_handle_node_typed_sidecar_handler_opt(body_node: i64, clauses_node: i64, nclauses: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  if nclauses <= 0 {
    ir_lowered_expr_invalid(next_value)
  } else {
    let params = pipeline_handler_lower_ctx_params(lower_ctx)
    let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
    let src = pipeline_handler_lower_ctx_src(lower_ctx)
    let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
    let ctx = pipeline_handler_lower_ctx_handlers(lower_ctx)
    let clauses = handler_clause_list_from_nodes(clauses_node, 0, nclauses)
    let handle_result_ty = pipeline_return_expr_type_node_from_node(body_node, params, locals, pipeline_handler_lower_ctx_module(lower_ctx))
    let lowered_clauses = pipeline_lower_handler_clauses_typed(clauses, params, locals, pipeline_handler_lower_ctx_module(lower_ctx), handle_result_ty)
    let clause_bodies = pipeline_lowered_handler_clauses_bodies(lowered_clauses)
    if pipeline_handler_clause_list_has_continuation_handler_typed(clauses) == 1 {
      let result_lanes = pipeline_type_value_lane_count_or_one(handle_result_ty)
      let scratch_base = next_value + result_lanes
      let lowered_body = pipeline_lower_deferred_handler_body_typed(expr_from_node(body_node), clauses, lowered_clauses, params, locals, pipeline_handler_lower_ctx_module(lower_ctx))
      let eff_hash = pipeline_handler_clause_dispatch_key_typed(src, handler_clause_list_nth(clauses, 0), pipeline_handler_lower_ctx_subst(lower_ctx))
      let inst = ir_inst_deferred_handle_i64(next_value, src, lowered_body, clause_bodies, nclauses, eff_hash, scratch_base)
      let insts = ir_inst_list_append(ir_inst_list_prepend(inst, ir_inst_list_empty()), pipeline_ir_call_result_lane_insts(next_value, handle_result_ty))
      ir_lowered_expr(next_value, scratch_base + pipeline_ir_native_deferred_handle_scratch_count(), insts)
    } else {
    let eff_hash = pipeline_handler_clause_dispatch_key_typed(src, handler_clause_list_nth(clauses, 0), pipeline_handler_lower_ctx_subst(lower_ctx))
    let next_ctx = pipeline_handler_inline_ctx_push_typed_src_safe(ctx, eff_hash, clauses, nclauses, src, 1, pipeline_lowered_handler_clauses_out_of_line_safe(lowered_clauses))
    let next_lower_ctx = pipeline_handler_lower_ctx_from_module(params, locals, pipeline_lower_module_with_handlers(pipeline_handler_lower_ctx_module(lower_ctx), next_ctx))
    let call_inline = pipeline_lower_handle_body_call_inline_nodes(body_node, eff_hash, next_ctx, next_lower_ctx, next_value)
    let lowered = if ir_lowered_expr_is_valid(call_inline) == 1 { call_inline } else { pipeline_lower_expr_node_typed_sidecar_handler_ctx(body_node, next_value, next_lower_ctx) }
    if ir_lowered_expr_is_valid(lowered) == 1 {
      if pipeline_ir_insts_handle_frame_free(ir_lowered_expr_insts(lowered)) == 1 {
        lowered
      } else {
        let insts = pipeline_ir_handle_inst_list_nodes(src, eff_hash, clause_bodies, nclauses, ir_lowered_expr_insts(lowered))
        ir_lowered_expr(ir_lowered_expr_value(lowered), ir_lowered_expr_next_value(lowered), insts)
      }
    } else {
      ir_lowered_expr_invalid(next_value)
    }
    }
  }
}

fn pipeline_lower_expr_node_typed_sidecar_handler_raw(expr: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  if expr == 0 {
    ir_lowered_expr_invalid(next_value)
  } else {
    if node_tag(expr) == 37 {
      let inner = node_f1(expr)
      let inner_stripped = pipeline_expr_node_strip_typed(inner)
      let ann_prim = pipeline_type_node_prim_id_or(node_f2(expr), 0 - 1)
      if inner_stripped == 0 {
        ir_lowered_expr_invalid(next_value)
      } else {
        let inner_tag = node_tag(inner_stripped)
        if inner_tag == 6 {
          pipeline_lower_let_node_typed_sidecar_handler_opt_with_float_prim(node_f1(inner_stripped), node_f2(inner_stripped), node_f3(inner_stripped), node_f4(inner_stripped), next_value, lower_ctx, ann_prim, node_f2(expr))
        } else { if inner_tag == 11 {
          pipeline_lower_let_mut_node_typed_sidecar_handler_opt_with_float_prim(node_f1(inner_stripped), node_f2(inner_stripped), node_f3(inner_stripped), node_f4(inner_stripped), next_value, lower_ctx, ann_prim, node_f2(expr))
        } else {
          if pipeline_prim_is_forced_numeric_context(ann_prim) == 1 {
            pipeline_lower_expr_node_typed_sidecar_handler_opt_with_float_prim(inner, next_value, lower_ctx, ann_prim)
          } else {
            pipeline_lower_expr_node_typed_sidecar_handler_ctx(inner, next_value, lower_ctx)
          }
        } }
      }
    } else {
    let stripped = pipeline_expr_node_strip_typed(expr)
    let tag = node_tag(stripped)
    if tag == 1 {
      ir_lowered_expr(next_value, next_value + 1, ir_inst_list_prepend(ir_inst_const_i64(next_value, node_f1(stripped)), ir_inst_list_empty()))
    } else { if tag == 24 {
      ir_lowered_expr(next_value, next_value + 1, ir_inst_list_prepend(ir_inst_const_i64(next_value, node_f1(stripped)), ir_inst_list_empty()))
    } else { if tag == 51 {
      ir_lowered_expr(next_value, next_value + 1, ir_inst_list_prepend(ir_inst_nil_i64(next_value), ir_inst_list_empty()))
    } else { if tag == 9 {
      ir_lowered_expr(next_value, next_value + 1, ir_inst_list_prepend(ir_inst_string_lit(next_value, node_f1(stripped), node_f2(stripped)), ir_inst_list_empty()))
    } else { if tag == 54 {
      pipeline_lower_float_lit_typed(pipeline_handler_lower_ctx_src(lower_ctx), node_f1(stripped), node_f2(stripped), next_value, PRIM_F64())
    } else { if tag == 2 {
      pipeline_lower_ident_expr_typed_sidecar_handler_opt(node_f1(stripped), node_f2(stripped), pipeline_handler_lower_ctx_params(lower_ctx), pipeline_handler_lower_ctx_locals(lower_ctx), pipeline_handler_lower_ctx_src(lower_ctx), pipeline_handler_lower_ctx_tt(lower_ctx), pipeline_handler_lower_ctx_fns(lower_ctx), next_value)
    } else { if tag == 3 {
      pipeline_lower_binop_node_typed_sidecar_handler_opt(node_f1(stripped), node_f2(stripped), node_f3(stripped), next_value, lower_ctx)
    } else { if tag == 4 {
      pipeline_lower_call_node_typed_sidecar_handler_opt(node_f1(stripped), node_f2(stripped), node_f3(stripped), node_f4(stripped), next_value, lower_ctx)
    } else { if tag == 6 {
      pipeline_lower_let_node_typed_sidecar_handler_opt_with_float_prim(node_f1(stripped), node_f2(stripped), node_f3(stripped), node_f4(stripped), next_value, lower_ctx, 0, 0)
    } else { if tag == 7 {
      pipeline_lower_block_node_typed_sidecar_handler_opt(node_f1(stripped), node_f2(stripped), next_value, lower_ctx)
    } else { if tag == 11 {
      pipeline_lower_let_mut_node_typed_sidecar_handler_opt_with_float_prim(node_f1(stripped), node_f2(stripped), node_f3(stripped), node_f4(stripped), next_value, lower_ctx, 0, 0)
    } else { if tag == 12 {
      pipeline_lower_assign_node_typed_sidecar_handler_opt(node_f1(stripped), node_f2(stripped), node_f3(stripped), next_value, lower_ctx)
    } else { if tag == 13 {
      pipeline_lower_field_access_node_typed_sidecar_handler_opt(node_f1(stripped), node_f2(stripped), node_f3(stripped), node_f4(stripped), next_value, lower_ctx)
    } else { if tag == 59 {
      pipeline_lower_indexed_len_node_typed_sidecar_handler_opt(node_f1(stripped), node_f2(stripped), next_value, lower_ctx)
    } else { if tag == 60 {
      pipeline_lower_indexed_get_node_typed_sidecar_handler_opt(node_f1(stripped), node_f2(stripped), node_f3(stripped), node_f4(stripped), next_value, lower_ctx)
    } else { if tag == 61 {
      pipeline_lower_indexed_set_node_typed_sidecar_handler_opt(node_f1(stripped), node_f2(stripped), node_f3(stripped), node_f4(stripped), next_value, lower_ctx)
    } else { if tag == 62 {
      pipeline_lower_indexed_slice_node_typed_sidecar_handler_opt(node_f1(stripped), node_f2(stripped), node_f3(stripped), node_f4(stripped), next_value, lower_ctx)
    } else { if tag == 14 {
      pipeline_lower_record_init_node_typed_sidecar_handler_opt(node_f1(stripped), node_f2(stripped), node_f3(stripped), node_f4(stripped), next_value, lower_ctx)
    } else { if tag == 58 {
      pipeline_lower_array_literal_expr_typed_sidecar_handler_opt(expr_list_from_nodes(node_f1(stripped), 0, node_f2(stripped)), node_f3(stripped), next_value, lower_ctx)
    } else { if tag == 22 {
      pipeline_lower_not_node_typed_sidecar_handler_opt(node_f1(stripped), next_value, lower_ctx)
    } else { if tag == 29 {
      let lambda_subst = pipeline_handler_lower_ctx_subst(lower_ctx)
      let lambda_param_nodes = if lambda_subst == 0 { node_f1(stripped) } else { cg_params_subst(node_f1(stripped), lambda_subst) }
      let lambda_params = param_list_from_param_nodes(lambda_param_nodes)
      let lambda_body = expr_from_node(pipeline_expr_node_subst_types(node_f2(stripped), lambda_subst))
      let lambda_captures = pipeline_lambda_captures_for(lambda_params, lambda_body, lower_ctx)
      -- Reserves TWO ids: closure emission stores the capture env at
      -- dst + 1. A single-id reservation let later values (e.g.
      -- loop-hoisted constants) share the env's spill slot and be
      -- clobbered by the env store at runtime.
      let lambda_insts = pipeline_lower_lambda_hoisted(lambda_params, lambda_body, lambda_captures, lower_ctx, next_value)
      ir_lowered_expr(next_value, next_value + 2, lambda_insts)
    } else { if tag == 32 {
      pipeline_lower_perform_node_typed_sidecar_handler_opt(node_f1(stripped), node_f2(stripped), node_f3(stripped), node_f4(stripped), nlist_len(node_f4(stripped)), next_value, lower_ctx)
    } else { if tag == 33 {
      pipeline_lower_handle_node_typed_sidecar_handler_opt(node_f1(stripped), node_f2(stripped), node_f3(stripped), next_value, lower_ctx)
    } else { if tag == 35 {
      pipeline_lower_expr_node_typed_sidecar_handler_ctx(node_f1(stripped), next_value, lower_ctx)
    } else { if tag == 36 {
      pipeline_lower_generic_call_node_typed_sidecar_handler_opt(node_f1(stripped), node_f2(stripped), next_value, lower_ctx)
    } else { if tag == 41 {
      pipeline_lower_method_call_node_typed_sidecar_handler_opt(node_f1(stripped), node_f2(stripped), node_f3(stripped), nlist_len(node_f3(stripped)), node_f4(stripped), next_value, lower_ctx)
    } else { if tag == 45 {
      pipeline_lower_try_node_typed_sidecar_handler_opt(node_f1(stripped), node_f2(stripped), next_value, lower_ctx)
    } else { if tag == 46 {
      pipeline_lower_interp_concat_node_typed_sidecar_handler_opt(node_f1(stripped), node_f2(stripped), next_value, lower_ctx)
    } else { if tag == 48 {
      pipeline_lower_opt_chain_node_typed_sidecar_handler_opt(node_f1(stripped), node_f2(stripped), node_f3(stripped), node_f4(stripped), next_value, lower_ctx)
    } else { if tag == 55 {
      pipeline_lower_address_of_node_typed_sidecar_handler_opt(node_f1(stripped), node_f2(stripped), next_value, lower_ctx)
    } else { if tag == 56 {
      pipeline_lower_deref_node_typed_sidecar_handler_opt(node_f1(stripped), next_value, lower_ctx)
    } else { if tag == 57 {
      pipeline_lower_ptr_assign_node_typed_sidecar_handler_opt(node_f1(stripped), node_f2(stripped), next_value, lower_ctx)
    } else {
      ir_lowered_expr_invalid(next_value)
    } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } }
    }
  }
}

fn pipeline_lower_expr_typed_sidecar_handler_ctx(expr: Expr, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let ctx = pipeline_handler_lower_ctx_handlers(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  match expr {
    IntLit(value, start, len) -> ir_lowered_expr(
      next_value,
      next_value + 1,
      ir_inst_list_prepend(ir_inst_const_i64(next_value, value), ir_inst_list_empty())
    )
    BoolLit(value) -> ir_lowered_expr(
      next_value,
      next_value + 1,
      ir_inst_list_prepend(ir_inst_const_i64(next_value, value), ir_inst_list_empty())
    )
    NilExpr -> ir_lowered_expr(
      next_value,
      next_value + 1,
      ir_inst_list_prepend(ir_inst_nil_i64(next_value), ir_inst_list_empty())
    )
    Lambda(params, body) -> {
      let lambda_subst = pipeline_handler_lower_ctx_subst(lower_ctx)
      let lambda_params = pipeline_lambda_ir_params_subst(params, lambda_subst)
      let lambda_body = pipeline_lambda_ir_body_subst(body, lambda_subst)
      let lambda_captures = pipeline_lambda_captures_for(lambda_params, lambda_body, lower_ctx)
      -- next_value + 2: the native emission stores the capture env at
      -- dst + 1 (see the node-path arm for the collision this reserves
      -- against).
      let lambda_insts = pipeline_lower_lambda_hoisted(lambda_params, lambda_body, lambda_captures, lower_ctx, next_value)
      ir_lowered_expr(next_value, next_value + 2, lambda_insts)
    }
    StringLit(start, len) -> ir_lowered_expr(
      next_value,
      next_value + 1,
      ir_inst_list_prepend(ir_inst_string_lit(next_value, start, len), ir_inst_list_empty())
    )
    FloatLit(start, len) -> pipeline_lower_float_lit_typed(src, start, len, next_value, PRIM_F64())
    Ident(ns, nl) -> pipeline_lower_ident_expr_typed_sidecar_handler_opt(ns, nl, params, locals, src, tt, pipeline_handler_lower_ctx_fns(lower_ctx), next_value)
    Call(ns, nl, args) -> pipeline_lower_call_expr_typed_sidecar_handler_opt(ns, nl, args, next_value, lower_ctx)
    BinOp(op, lhs, rhs) -> pipeline_lower_binop_expr_typed_sidecar_handler_opt(op, lhs, rhs, next_value, lower_ctx)
    Let(ns, nl, value, body) -> pipeline_lower_let_expr_typed_sidecar_handler_opt(ns, nl, value, body, next_value, lower_ctx)
    LetMut(ns, nl, value, body) -> pipeline_lower_let_mut_expr_typed_sidecar_handler_opt(ns, nl, value, body, next_value, lower_ctx)
    Assign(ns, nl, value) -> pipeline_lower_assign_expr_typed_sidecar_handler_opt(ns, nl, value, next_value, lower_ctx)
    AddressOf(mutable, target) -> pipeline_lower_address_of_expr_typed_sidecar_handler_opt(mutable, target, next_value, lower_ctx)
    Deref(ptr) -> pipeline_lower_deref_expr_typed_sidecar_handler_opt(ptr, next_value, lower_ctx)
    PtrAssign(ptr, value) -> pipeline_lower_ptr_assign_expr_typed_sidecar_handler_opt(ptr, value, next_value, lower_ctx)
    Block(first, rest) -> pipeline_lower_block_expr_typed_sidecar_handler_opt(first, rest, next_value, lower_ctx)
    Not(operand) -> pipeline_lower_not_expr_typed_sidecar_handler_opt(operand, next_value, lower_ctx)
    FieldAccess(base, field_ns, field_nl, fact) -> pipeline_lower_field_access_expr_typed_sidecar_handler_opt(base, field_ns, field_nl, fact, next_value, lower_ctx)
    IndexedLen(base, fixed_len) -> pipeline_lower_indexed_len_expr_typed_sidecar_handler_opt(base, fixed_len, next_value, lower_ctx)
    IndexedGet(base, index, element_ty, fixed_len) -> pipeline_lower_indexed_get_expr_typed_sidecar_handler_opt(base, index, element_ty, fixed_len, next_value, lower_ctx)
    IndexedSet(base, index, value, fact) -> pipeline_lower_indexed_set_expr_typed_sidecar_handler_opt(base, index, value, fact, next_value, lower_ctx)
    IndexedSlice(base, start, end, fact) -> pipeline_lower_indexed_slice_expr_typed_sidecar_handler_opt(base, start, end, fact, next_value, lower_ctx)
    RecordInit(type_ns, type_nl, fields) -> pipeline_lower_record_init_expr_typed_sidecar_handler_opt(type_ns, type_nl, fields, next_value, lower_ctx)
    ArrayLiteral(elements, resolved_ty, span) -> pipeline_lower_array_literal_expr_typed_sidecar_handler_opt(elements, resolved_ty, next_value, lower_ctx)
    Perform(lhs, op_ns, op_nl, args) -> pipeline_lower_perform_expr_typed_sidecar_handler_opt(lhs, op_ns, op_nl, args, next_value, lower_ctx)
    Handle(body, clauses, hret) -> pipeline_lower_handle_expr_typed_sidecar_handler_opt(body, clauses, hret, next_value, lower_ctx)
    Resume(value) -> pipeline_lower_expr_typed_sidecar_handler_ctx(value, next_value, lower_ctx)
    GenericCall(type_args, inner_call) -> pipeline_lower_generic_call_expr_typed_sidecar_handler_opt(type_args, inner_call, next_value, lower_ctx)
    MethodCall(recv, method_hash, args, type_hash) -> pipeline_lower_method_call_expr_typed_sidecar_handler_opt(recv, method_hash, args, type_hash, next_value, lower_ctx)
    Try(inner, effect_atom) -> pipeline_lower_try_expr_typed_sidecar_handler_opt(inner, effect_atom, next_value, lower_ctx)
    InterpConcat(left, right) -> pipeline_lower_interp_concat_expr_typed_sidecar_handler_opt(left, right, next_value, lower_ctx)
    OptChain(base, field_ns, field_nl, effect_atom) -> pipeline_lower_opt_chain_expr_typed_sidecar_handler_opt(base, field_ns, field_nl, effect_atom, next_value, lower_ctx)
    LetTyped(inner, ann_type) -> {
      let ann_prim = type_expr_prim_id_or(ann_type, 0)
      let ann_node = type_expr_to_node(ann_type)
      match inner {
        Let(ns, nl, value, body) -> pipeline_lower_let_expr_typed_sidecar_handler_opt_with_float_prim(ns, nl, value, body, next_value, lower_ctx, ann_prim, ann_node)
        LetMut(ns, nl, value, body) -> pipeline_lower_let_mut_expr_typed_sidecar_handler_opt_with_float_prim(ns, nl, value, body, next_value, lower_ctx, ann_prim, ann_node)
        _ -> {
          if pipeline_prim_is_forced_numeric_context(ann_prim) == 1 {
            pipeline_lower_expr_typed_sidecar_handler_opt_with_float_prim(inner, next_value, lower_ctx, ann_prim)
          } else {
            pipeline_lower_expr_typed_sidecar_handler_ctx(inner, next_value, lower_ctx)
          }
        }
      }
    }
    _ -> ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_expr_typed_sidecar_handler_opt_with_subst(expr: Expr, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, next_value: i64, ctx: PipelineHandlerInlineCtx, subst: i64) -> IrLoweredExpr {
  pipeline_lower_expr_typed_sidecar_handler_ctx(expr, next_value, pipeline_handler_lower_ctx_with_subst(params, locals, src, tt, ctx, subst))
}

fn pipeline_lower_expr_typed_sidecar_handler_opt_with_fns(expr: Expr, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, next_value: i64, ctx: PipelineHandlerInlineCtx, fns: i64) -> IrLoweredExpr {
  pipeline_lower_expr_typed_sidecar_handler_ctx(expr, next_value, pipeline_handler_lower_ctx_with_fns_subst(params, locals, src, tt, ctx, fns, 0))
}

fn pipeline_lower_expr_typed_sidecar_handler_opt(expr: Expr, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, next_value: i64, ctx: PipelineHandlerInlineCtx) -> IrLoweredExpr {
  pipeline_lower_expr_typed_sidecar_handler_opt_with_subst(expr, params, locals, src, tt, next_value, ctx, 0)
}

fn pipeline_lower_expr_node_typed_sidecar_handler_ctx(expr: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  pipeline_lower_expr_node_typed_sidecar_handler_raw(expr, next_value, lower_ctx)
}

fn pipeline_lower_expr_node_typed_sidecar_handler_opt_with_subst(expr: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, next_value: i64, ctx: PipelineHandlerInlineCtx, subst: i64) -> IrLoweredExpr {
  pipeline_lower_expr_node_typed_sidecar_handler_ctx(expr, next_value, pipeline_handler_lower_ctx_with_subst(params, locals, src, tt, ctx, subst))
}

fn pipeline_lower_expr_node_typed_sidecar_handler_opt_with_fns(expr: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, next_value: i64, ctx: PipelineHandlerInlineCtx, fns: i64) -> IrLoweredExpr {
  pipeline_lower_expr_node_typed_sidecar_handler_ctx(expr, next_value, pipeline_handler_lower_ctx_with_fns_subst(params, locals, src, tt, ctx, fns, 0))
}

fn pipeline_lower_expr_node_typed_sidecar_handler_opt(expr: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, next_value: i64, ctx: PipelineHandlerInlineCtx) -> IrLoweredExpr {
  pipeline_lower_expr_node_typed_sidecar_handler_opt_with_subst(expr, params, locals, src, tt, next_value, ctx, 0)
}

fn pipeline_lowering_failure_function(fn_key: i64, nparams: i64, src: i64, reason: i64) -> IrFunction {
  let insts = ir_inst_list_prepend(ir_inst_lowering_failure_i64(reason), ir_inst_list_empty())
  let block = ir_block_new_term(0, insts, ir_term_return(0))
  ir_function_new_src(fn_key, nparams, block, src)
}

fn pipeline_lowering_failure_function_list(fn_key: i64, nparams: i64, src: i64, reason: i64) -> IrFunctionList {
  ir_function_list_prepend(pipeline_lowering_failure_function(fn_key, nparams, src, reason), ir_function_list_empty())
}

fn pipeline_lower_straight_fn_handler_optimised(inner: i64, params: i64, src: i64, tt: i64, nparams: i64, param_lanes: i64, fn_key: i64, fns: i64, return_ty: i64, return_float: i64, borrowed_mask: i64) -> IrFunctionList {
  let body = node_f4(inner)
  let lower_ctx = pipeline_handler_lower_ctx_with_fns_subst(params, pipeline_value_env_empty(), src, tt, pipeline_handler_inline_ctx_empty(), fns, 0)
  let lowered = if return_float == PRIM_F32() or return_float == PRIM_F64() {
    pipeline_lower_expr_node_typed_sidecar_handler_opt_with_float_prim(body, param_lanes, lower_ctx, return_float)
  } else {
    pipeline_lower_expr_node_typed_sidecar_handler_ctx(body, param_lanes, lower_ctx)
  }
  if ir_lowered_expr_is_valid(lowered) == 1 {
    let param_binds = pipeline_lower_param_bind_insts_with_borrow_mask(params, 0, nparams, borrowed_mask)
    let module = pipeline_lower_module_with_fns_subst(src, tt, fns, 0)
    let transfer = pipeline_lower_return_transfer_from_node(body, ir_lowered_expr_value(lowered), ir_lowered_expr_next_value(lowered), params, pipeline_value_env_empty(), module)
    let managed_param_drops = pipeline_managed_param_release_insts_with_borrow_mask(params, 0, nparams, ir_lowered_expr_next_value(transfer), borrowed_mask)
    let owned_param_drops = pipeline_owned_param_drop_insts(params, 0, nparams, body, src)
    let param_drops = ir_inst_list_append(managed_param_drops, owned_param_drops)
    let insts = ir_inst_list_append(param_binds, ir_inst_list_append(ir_lowered_expr_insts(lowered), ir_inst_list_append(ir_lowered_expr_insts(transfer), param_drops)))
    let return_insts = ir_inst_list_append(insts, pipeline_ir_return_lane_insts(ir_lowered_expr_value(transfer), return_ty))
    let block = ir_block_new_term(0, return_insts, ir_term_return(ir_lowered_expr_value(transfer)))
    let f = ir_function_new_src(fn_key, param_lanes, block, src)
    ir_function_list_prepend(f, ir_function_list_empty())
  } else {
    pipeline_lowering_failure_function_list(fn_key, param_lanes, src, 1)
  }
}

fn pipeline_lower_cfg_fn_typed_handler_optimised_with_ctx(inner: i64, params: i64, src: i64, tt: i64, nparams: i64, param_lanes: i64, fn_key: i64, return_ty: i64, handlers: PipelineHandlerInlineCtx, subst: i64, fns: i64, borrowed_mask: i64) -> IrFunctionList {
  let body = node_f4(inner)
  let final_merge_block = 1
  let locals = pipeline_value_env_empty()
  let module = pipeline_lower_module_with_handlers(
    pipeline_lower_module_with_fns_subst(src, tt, fns, subst),
    handlers
  )
  let lowered = pipeline_lower_expr_typed_to_target_blocks_reserved(expr_from_node(body), params, locals, module, param_lanes, 0, 2, final_merge_block)
  if pipeline_lowered_blocks_is_valid(lowered) == 1 {
    if pipeline_lowered_blocks_falls_through(lowered) == 1 {
      let final_value = pipeline_lowered_blocks_next_value(lowered)
      let return_lanes = pipeline_type_value_lane_count_or_one(return_ty)
      let final_params = pipeline_ir_value_lane_ids(final_value, 0, return_lanes)
      let transfer = pipeline_lower_return_transfer_from_node(body, final_value, final_value + return_lanes, params, locals, module)
      let final_merge = ir_block_new_params(final_merge_block, final_params, ir_lowered_expr_insts(transfer), ir_term_return(ir_lowered_expr_value(transfer)))
      let blocks = ir_block_list_append(
        pipeline_lowered_blocks_blocks(lowered),
          ir_block_list_prepend(final_merge, ir_block_list_empty())
      )
      let with_binds = pipeline_ir_block_list_prepend_entry_insts(blocks, 0, pipeline_lower_param_bind_insts_with_borrow_mask(params, 0, nparams, borrowed_mask))
      let managed_param_drops = pipeline_managed_param_release_insts_with_borrow_mask(params, 0, nparams, pipeline_ir_function_next_value(param_lanes, with_binds), borrowed_mask)
      let owned_param_drops = pipeline_owned_param_drop_insts(params, 0, nparams, body, src)
      let param_drops = ir_inst_list_append(managed_param_drops, owned_param_drops)
      let with_drops = pipeline_ir_block_list_append_return_drops(with_binds, param_drops)
      let with_return_lanes = pipeline_ir_block_list_append_return_lanes(with_drops, return_ty)
      let f = ir_function_new_blocks_src(fn_key, param_lanes, with_return_lanes, src)
      ir_function_list_prepend(f, ir_function_list_empty())
    } else {
      let with_binds = pipeline_ir_block_list_prepend_entry_insts(pipeline_lowered_blocks_blocks(lowered), 0, pipeline_lower_param_bind_insts_with_borrow_mask(params, 0, nparams, borrowed_mask))
      let managed_param_drops = pipeline_managed_param_release_insts_with_borrow_mask(params, 0, nparams, pipeline_ir_function_next_value(param_lanes, with_binds), borrowed_mask)
      let owned_param_drops = pipeline_owned_param_drop_insts(params, 0, nparams, body, src)
      let param_drops = ir_inst_list_append(managed_param_drops, owned_param_drops)
      let with_drops = pipeline_ir_block_list_append_return_drops(with_binds, param_drops)
      let with_return_lanes = pipeline_ir_block_list_append_return_lanes(with_drops, return_ty)
      let f = ir_function_new_blocks_src(fn_key, param_lanes, with_return_lanes, src)
      ir_function_list_prepend(f, ir_function_list_empty())
    }
  } else {
    pipeline_lowering_failure_function_list(fn_key, param_lanes, src, 2)
  }
}

fn pipeline_lower_cfg_fn_typed_handler_optimised(inner: i64, params: i64, src: i64, tt: i64, nparams: i64, fn_key: i64) -> IrFunctionList {
  pipeline_lower_cfg_fn_typed_handler_optimised_with_ctx(inner, params, src, tt, nparams, pipeline_params_value_lane_count(params), fn_key, 0, pipeline_handler_inline_ctx_empty(), 0, 0, 0)
}

fn pipeline_lower_simple_fn_handler_optimised(pair: i64, tt: i64, fns: i64) -> IrFunctionList {
  let fn_wrap = node_f1(pair)
  let fn_src = node_f2(pair)
  let inner = pipeline_fn_inner(fn_wrap)
  let params = node_f3(inner)
  let body = node_f4(inner)
  let nparams = nlist_len(params)
  let param_lanes = pipeline_params_value_lane_count(params)
  let name_hash = str_hash(fn_src, node_f1(inner), node_f2(inner))
  let fn_key = if node_f3(pair) == 0 { name_hash } else { pipeline_impl_pair_method_key(pair, name_hash) }
  let return_ty = fn_ret_type(fn_wrap)
  let return_float = pipeline_fn_return_float_prim(fn_wrap, 0)
  let borrowed_mask = pipeline_fn_effective_borrowable_param_mask_with_params(fns, fn_wrap, fn_src, params, 0)
  let typed_body_needs_cfg = pipeline_expr_needs_par_scope_cfg_typed(expr_from_node(body), fn_src)
  if pipeline_expr_needs_cfg(body) == 1 or typed_body_needs_cfg == 1 {
    pipeline_lower_cfg_fn_typed_handler_optimised_with_ctx(inner, params, fn_src, tt, nparams, param_lanes, fn_key, return_ty, pipeline_handler_inline_ctx_empty(), 0, fns, borrowed_mask)
  } else {
    pipeline_lower_straight_fn_handler_optimised(inner, params, fn_src, tt, nparams, param_lanes, fn_key, fns, return_ty, return_float, borrowed_mask)
  }
}

fn pipeline_lower_fns_handler_optimised(fns: i64, tt: i64, user_src: i64) -> IrFunctionList {
  let mut result = ir_function_list_empty()
  let n = nlist_len(fns)
  for i in 0..n {
    let pair = nlist_get(fns, i)
    let fn_wrap = node_f1(pair)
    if pipeline_decl_node_is_function(fn_wrap) == 1 and fn_tparams(fn_wrap) == 0 {
      let one = pipeline_lower_simple_fn_handler_optimised(pair, tt, fns)
      match one {
        IrFunctionNil -> 0
        IrFunctionCons(f, rest) -> {
          result = ir_function_list_prepend(f, result)
          0
        }
      }
    } else { 0 }
  }
  result
}

fn pipeline_ir_function_list_append(left: IrFunctionList, right: IrFunctionList) -> IrFunctionList {
  match left {
    IrFunctionNil -> right
    IrFunctionCons(f, rest) -> ir_function_list_prepend(f, pipeline_ir_function_list_append(rest, right))
  }
}

fn pipeline_ir_function_list_reverse_append(functions: IrFunctionList, acc: IrFunctionList) -> IrFunctionList {
  match functions {
    IrFunctionNil -> acc
    IrFunctionCons(f, rest) -> pipeline_ir_function_list_reverse_append(rest, ir_function_list_prepend(f, acc))
  }
}

fn pipeline_ir_function_list_reverse(functions: IrFunctionList) -> IrFunctionList {
  pipeline_ir_function_list_reverse_append(functions, ir_function_list_empty())
}

fn pipeline_ir_function_list_dedup_seen(functions: IrFunctionList, seen: i64) -> IrFunctionList {
  match functions {
    IrFunctionNil -> ir_function_list_empty()
    IrFunctionCons(f, rest) -> {
      match f {
        IrFunction(hash, params, blocks, src) -> {
          if pipeline_hash_nlist_contains(seen, hash) == 1 {
            pipeline_ir_function_list_dedup_seen(rest, seen)
          } else {
            nlist_add(seen, hash)
            ir_function_list_prepend(f, pipeline_ir_function_list_dedup_seen(rest, seen))
          }
        }
      }
    }
  }
}

fn pipeline_ir_function_list_dedup(functions: IrFunctionList) -> IrFunctionList {
  pipeline_ir_function_list_dedup_seen(functions, nlist_new())
}

fn pipeline_generic_template_find(fns: i64, user_src: i64, name_hash: i64) -> i64 {
  if pipeline_fns_fact_list_valid(fns) == 0 { 0 }
  else {
    let bundle = pipeline_fns_index_bundle(fns)
    let generic = pipeline_fns_index_probe(node_f3(bundle), name_hash)
    if generic != 0 { generic }
    else {
      let method = pipeline_fns_index_probe(node_f2(bundle), name_hash)
      if method != 0 and fn_tparams(node_f1(method)) != 0 { method } else { 0 }
    }
  }
}

fn pipeline_generic_template_pairs(fns: i64) -> i64 {
  let result = nlist_new()
  if pipeline_fns_fact_list_valid(fns) == 0 { 0 }
  else {
    let n = nlist_len(fns)
    for i in 0..n {
      let pair = nlist_get(fns, i)
      let fn_wrap = node_f1(pair)
      if pipeline_decl_node_is_function(fn_wrap) == 1 and fn_tparams(fn_wrap) != 0 {
        nlist_add(result, pair)
      } else { 0 }
    }
  }
  result
}

fn pipeline_lower_generic_specialisation_handler_optimised(pair: i64, type_args: i64, tt: i64, handlers: PipelineHandlerInlineCtx, fns: i64) -> IrFunctionList {
  if pair == 0 {
    ir_function_list_empty()
  } else {
    let fn_wrap = node_f1(pair)
    let fn_src = node_f2(pair)
    let inner = pipeline_fn_inner(fn_wrap)
    let body = node_f4(inner)
    let name_hash = str_hash(fn_src, node_f1(inner), node_f2(inner))
    let fn_key = mono_spec_hash(pipeline_ir_function_key(name_hash, node_f3(pair)), type_args)
    let subst = cg_build_subst(fn_tparams(fn_wrap), type_args)
    let params = cg_params_subst(node_f3(inner), subst)
    let nparams = nlist_len(params)
    let param_lanes = pipeline_params_value_lane_count(params)
    let return_ty = ty_subst(fn_ret_type(fn_wrap), subst)
    let return_float = pipeline_fn_return_float_prim(fn_wrap, subst)
    let borrowed_mask = pipeline_fn_effective_borrowable_param_mask_with_params(fns, fn_wrap, fn_src, params, subst)
    -- Generic specialisations are emitted as standalone functions. They must
    -- not capture a caller's lexical handler depth; performs across this
    -- boundary are handled by the runtime/evidence path until hidden evidence
    -- is threaded into the generic ABI.
    let out_of_line_handlers = pipeline_handler_inline_ctx_empty()
    let typed_body_needs_cfg = pipeline_expr_needs_par_scope_cfg_typed(expr_from_node(body), fn_src)
    if pipeline_expr_needs_cfg(body) == 1 or typed_body_needs_cfg == 1 {
      pipeline_lower_cfg_fn_typed_handler_optimised_with_ctx(inner, params, fn_src, tt, nparams, param_lanes, fn_key, return_ty, out_of_line_handlers, subst, fns, borrowed_mask)
    } else {
      let lower_ctx = pipeline_handler_lower_ctx_with_fns_subst(params, pipeline_value_env_empty(), fn_src, tt, out_of_line_handlers, fns, subst)
      let lowered = if return_float == PRIM_F32() or return_float == PRIM_F64() {
        pipeline_lower_expr_node_typed_sidecar_handler_opt_with_float_prim(body, param_lanes, lower_ctx, return_float)
      } else {
        pipeline_lower_expr_node_typed_sidecar_handler_ctx(body, param_lanes, lower_ctx)
      }
      if ir_lowered_expr_is_valid(lowered) == 1 {
        let param_binds = pipeline_lower_param_bind_insts_with_borrow_mask(params, 0, nparams, borrowed_mask)
        let module = pipeline_lower_module_with_fns_subst(fn_src, tt, fns, subst)
        let transfer = pipeline_lower_return_transfer_from_node(body, ir_lowered_expr_value(lowered), ir_lowered_expr_next_value(lowered), params, pipeline_value_env_empty(), module)
        let managed_param_drops = pipeline_managed_param_release_insts_with_borrow_mask(params, 0, nparams, ir_lowered_expr_next_value(transfer), borrowed_mask)
        let owned_param_drops = pipeline_owned_param_drop_insts(params, 0, nparams, body, fn_src)
        let param_drops = ir_inst_list_append(managed_param_drops, owned_param_drops)
        let insts = ir_inst_list_append(param_binds, ir_inst_list_append(ir_lowered_expr_insts(lowered), ir_inst_list_append(ir_lowered_expr_insts(transfer), param_drops)))
        let return_insts = ir_inst_list_append(insts, pipeline_ir_return_lane_insts(ir_lowered_expr_value(transfer), return_ty))
        let block = ir_block_new_term(0, return_insts, ir_term_return(ir_lowered_expr_value(transfer)))
        let f = ir_function_new_src(fn_key, param_lanes, block, fn_src)
        ir_function_list_prepend(f, ir_function_list_empty())
      } else {
        pipeline_lowering_failure_function_list(fn_key, param_lanes, fn_src, 3)
      }
    }
  }
}

fn pipeline_collect_generic_specs_list(nodes: i64, count: i64, fns: i64, user_src: i64, tt: i64, handlers: PipelineHandlerInlineCtx) -> IrFunctionList {
  let mut result = ir_function_list_empty()
  for i in 0..count {
    let one = pipeline_collect_generic_specs_expr(nlist_get(nodes, i), fns, user_src, tt, handlers)
    result = pipeline_ir_function_list_reverse_append(one, result)
  }
  pipeline_ir_function_list_reverse(result)
}

fn pipeline_collect_generic_specs_record_fields(fields: i64, nfields: i64, fns: i64, user_src: i64, tt: i64, handlers: PipelineHandlerInlineCtx) -> IrFunctionList {
  let mut result = ir_function_list_empty()
  for i in 0..nfields {
    let field = nlist_get(fields, i)
    let one = pipeline_collect_generic_specs_expr(node_f3(field), fns, user_src, tt, handlers)
    result = pipeline_ir_function_list_reverse_append(one, result)
  }
  pipeline_ir_function_list_reverse(result)
}

fn pipeline_collect_generic_specs_clause_bodies(clauses: i64, nclauses: i64, fns: i64, user_src: i64, tt: i64, handlers: PipelineHandlerInlineCtx) -> IrFunctionList {
  let mut result = ir_function_list_empty()
  for i in 0..nclauses {
    let clause = nlist_get(clauses, i)
    let one = pipeline_collect_generic_specs_expr(node_f3(clause), fns, user_src, tt, handlers)
    result = pipeline_ir_function_list_reverse_append(one, result)
  }
  pipeline_ir_function_list_reverse(result)
}

fn pipeline_collect_generic_specs_match_arms(arms: i64, narms: i64, fns: i64, user_src: i64, tt: i64, handlers: PipelineHandlerInlineCtx) -> IrFunctionList {
  let mut result = ir_function_list_empty()
  for i in 0..narms {
    let arm = nlist_get(arms, i)
    let body_specs = pipeline_collect_generic_specs_expr(node_f2(arm), fns, user_src, tt, handlers)
    let guard_node = node_f3(arm)
    let guard_specs = if guard_node == 0 { ir_function_list_empty() } else { pipeline_collect_generic_specs_expr(guard_node, fns, user_src, tt, handlers) }
    result = pipeline_ir_function_list_reverse_append(guard_specs, pipeline_ir_function_list_reverse_append(body_specs, result))
  }
  pipeline_ir_function_list_reverse(result)
}

fn pipeline_collect_generic_specs_block(first: i64, rest: i64, fns: i64, user_src: i64, tt: i64, handlers: PipelineHandlerInlineCtx) -> IrFunctionList {
  let first_specs = pipeline_collect_generic_specs_expr(first, fns, user_src, tt, handlers)
  if rest == 0 {
    first_specs
  } else {
    pipeline_ir_function_list_append(first_specs, pipeline_collect_generic_specs_expr(rest, fns, user_src, tt, handlers))
  }
}

fn pipeline_collect_generic_specs_handle(expr: i64, fns: i64, user_src: i64, tt: i64, handlers: PipelineHandlerInlineCtx) -> IrFunctionList {
  let body = node_f1(expr)
  let clauses = node_f2(expr)
  let nclauses = node_f3(expr)
  let clause_specs = pipeline_collect_generic_specs_clause_bodies(clauses, nclauses, fns, user_src, tt, handlers)
  if nclauses <= 0 {
    pipeline_ir_function_list_append(clause_specs, pipeline_collect_generic_specs_expr(body, fns, user_src, tt, handlers))
  } else {
    let eff_hash = pipeline_handler_clause_effect_hash(user_src, nlist_get(clauses, 0))
    let next_handlers = pipeline_handler_inline_ctx_push_typed_src(handlers, eff_hash, handler_clause_list_from_nodes(clauses, 0, nclauses), nclauses, user_src)
    pipeline_ir_function_list_append(clause_specs, pipeline_collect_generic_specs_expr(body, fns, user_src, tt, next_handlers))
  }
}

fn pipeline_collect_generic_specs_generic_call(expr: i64, fns: i64, user_src: i64, tt: i64, handlers: PipelineHandlerInlineCtx) -> IrFunctionList {
  let call_node = node_f2(expr)
  let arg_specs = pipeline_collect_generic_specs_list(node_f3(call_node), node_f4(call_node), fns, user_src, tt, handlers)
  let name_hash = str_hash(user_src, node_f1(call_node), node_f2(call_node))
  if src_eq(user_src, node_f1(call_node), node_f2(call_node), "to_array") == 1 and nlist_len(node_f1(expr)) == 2 {
    -- The checker-produced second argument is the exact `[T; N]` layout;
    -- typed lowering replaces this call and the post-IR collector discovers
    -- the generated Option constructor specialisations.
    arg_specs
  } else {
    let pair = pipeline_generic_template_find(fns, user_src, name_hash)
    let specialised = pipeline_lower_generic_specialisation_handler_optimised(pair, node_f1(expr), tt, handlers, fns)
    pipeline_ir_function_list_append(arg_specs, specialised)
  }
}

fn pipeline_collect_generic_specs_method_call(expr: i64, fns: i64, user_src: i64, tt: i64, handlers: PipelineHandlerInlineCtx) -> IrFunctionList {
  let receiver_specs = pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers)
  let arg_specs = pipeline_collect_generic_specs_list(node_f3(expr), nlist_len(node_f3(expr)), fns, user_src, tt, handlers)
  let children = pipeline_ir_function_list_append(receiver_specs, arg_specs)
  let method_ref = node_f4(expr)
  if method_ref_is_generic(method_ref) {
    let base_hash = pipeline_ir_method_patch_key(method_ref_owner_hash(method_ref), node_f2(expr))
    let pair = pipeline_generic_template_find(fns, user_src, base_hash)
    pipeline_ir_function_list_append(children, pipeline_lower_generic_specialisation_handler_optimised(pair, method_ref_type_args(method_ref), tt, handlers, fns))
  } else { children }
}

fn pipeline_collect_generic_specs_expr(expr: i64, fns: i64, user_src: i64, tt: i64, handlers: PipelineHandlerInlineCtx) -> IrFunctionList {
  if expr == 0 {
    ir_function_list_empty()
  } else {
    let tag = node_tag(expr)
    match tag {
      3 -> pipeline_ir_function_list_append(
        pipeline_collect_generic_specs_expr(node_f2(expr), fns, user_src, tt, handlers),
        pipeline_collect_generic_specs_expr(node_f3(expr), fns, user_src, tt, handlers)
      )
      4 -> pipeline_collect_generic_specs_list(node_f3(expr), node_f4(expr), fns, user_src, tt, handlers)
      5 -> pipeline_ir_function_list_append(
        pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers),
        pipeline_ir_function_list_append(
          pipeline_collect_generic_specs_expr(node_f2(expr), fns, user_src, tt, handlers),
          pipeline_collect_generic_specs_expr(node_f3(expr), fns, user_src, tt, handlers)
        )
      )
      6 -> pipeline_ir_function_list_append(
        pipeline_collect_generic_specs_expr(node_f3(expr), fns, user_src, tt, handlers),
        pipeline_collect_generic_specs_expr(node_f4(expr), fns, user_src, tt, handlers)
      )
      7 -> pipeline_collect_generic_specs_block(node_f1(expr), node_f2(expr), fns, user_src, tt, handlers)
      10 -> pipeline_ir_function_list_append(
        pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers),
        pipeline_collect_generic_specs_expr(node_f2(expr), fns, user_src, tt, handlers)
      )
      11 -> pipeline_ir_function_list_append(
        pipeline_collect_generic_specs_expr(node_f3(expr), fns, user_src, tt, handlers),
        pipeline_collect_generic_specs_expr(node_f4(expr), fns, user_src, tt, handlers)
      )
      12 -> pipeline_collect_generic_specs_expr(node_f3(expr), fns, user_src, tt, handlers)
      13 -> pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers)
      59 -> pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers)
      60 -> { pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers) pipeline_collect_generic_specs_expr(node_f2(expr), fns, user_src, tt, handlers) }
      61 -> { pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers) pipeline_collect_generic_specs_expr(node_f2(expr), fns, user_src, tt, handlers) pipeline_collect_generic_specs_expr(node_f3(expr), fns, user_src, tt, handlers) }
      62 -> { pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers) pipeline_collect_generic_specs_expr(node_f2(expr), fns, user_src, tt, handlers) pipeline_collect_generic_specs_expr(node_f3(expr), fns, user_src, tt, handlers) }
      14 -> pipeline_collect_generic_specs_record_fields(node_f3(expr), node_f4(expr), fns, user_src, tt, handlers)
      58 -> pipeline_collect_generic_specs_list(node_f1(expr), node_f2(expr), fns, user_src, tt, handlers)
      15 -> pipeline_ir_function_list_append(
        pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers),
        pipeline_collect_generic_specs_match_arms(node_f2(expr), node_f3(expr), fns, user_src, tt, handlers)
      )
      22 -> pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers)
      25 -> pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers)
      26 -> pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers)
      29 -> pipeline_collect_generic_specs_expr(node_f2(expr), fns, user_src, tt, handlers)
      32 -> pipeline_collect_generic_specs_list(node_f4(expr), nlist_len(node_f4(expr)), fns, user_src, tt, handlers)
      33 -> pipeline_collect_generic_specs_handle(expr, fns, user_src, tt, handlers)
      35 -> pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers)
      36 -> pipeline_collect_generic_specs_generic_call(expr, fns, user_src, tt, handlers)
      37 -> pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers)
      41 -> pipeline_collect_generic_specs_method_call(expr, fns, user_src, tt, handlers)
      45 -> pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers)
      46 -> pipeline_ir_function_list_append(
        pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers),
        pipeline_collect_generic_specs_expr(node_f2(expr), fns, user_src, tt, handlers)
      )
      47 -> pipeline_ir_function_list_append(
        pipeline_collect_generic_specs_expr(node_f3(expr), fns, user_src, tt, handlers),
        pipeline_collect_generic_specs_expr(node_f4(expr), fns, user_src, tt, handlers)
      )
      48 -> pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers)
      49 -> pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers)
      52 -> pipeline_ir_function_list_append(
        pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers),
        pipeline_collect_generic_specs_expr(node_f2(expr), fns, user_src, tt, handlers)
      )
      _ -> ir_function_list_empty()
    }
  }
}

fn pipeline_collect_generic_specs_fns(fns: i64, tt: i64, user_src: i64) -> IrFunctionList {
  let mut result = ir_function_list_empty()
  let n = nlist_len(fns)
  for i in 0..n {
    let pair = nlist_get(fns, i)
    let fn_wrap = node_f1(pair)
    if pipeline_decl_node_is_function(fn_wrap) == 1 and fn_tparams(fn_wrap) == 0 {
      let fn_src = node_f2(pair)
      let inner = pipeline_fn_inner(fn_wrap)
      let specs = pipeline_collect_generic_specs_expr(node_f4(inner), fns, fn_src, tt, pipeline_handler_inline_ctx_empty())
      result = pipeline_ir_function_list_reverse_append(specs, result)
    } else { 0 }
  }
  pipeline_ir_function_list_reverse(result)
}

fn pipeline_collect_generic_specs_ir_inst(inst: IrInst, templates: i64, all_fns: i64, tt: i64, src: i64) -> IrFunctionList {
  match inst {
    IrGenericCallI64(dst, callee_hash, type_args, args) -> {
      if pipeline_ir_native_generic_call_emission_intercepted(callee_hash, type_args, args, tt) == 1 {
        ir_function_list_empty()
      } else {
        let pair = pipeline_generic_template_find(templates, 0, callee_hash)
        pipeline_lower_generic_specialisation_handler_optimised(pair, type_expr_list_to_nodes(type_args), tt, pipeline_handler_inline_ctx_empty(), all_fns)
      }
    }
    IrGenericFunctionRefI64(dst, callee_hash, type_args) -> {
      if type_expr_list_len(type_args) == 0 { ir_function_list_empty() }
      else {
        let pair = pipeline_generic_template_find(templates, 0, callee_hash)
        pipeline_lower_generic_specialisation_handler_optimised(pair, type_expr_list_to_nodes(type_args), tt, pipeline_handler_inline_ctx_empty(), all_fns)
      }
    }
    -- Hoisted lambda: the carried function's blocks hold the generic
    -- call sites the body Expr used to hold.
    IrClosureI64(dst, f, captures, eff) -> {
      match f {
        IrFunction(chash, cparams, cblocks, csrc) -> pipeline_collect_generic_specs_ir_blocks(cblocks, templates, all_fns, tt, src)
      }
    }
    _ -> ir_function_list_empty()
  }
}

fn pipeline_collect_generic_specs_ir_insts(insts: IrInstList, templates: i64, all_fns: i64, tt: i64, src: i64) -> IrFunctionList {
  match insts {
    IrInstNil -> ir_function_list_empty()
    IrInstCons(inst, rest) -> {
      pipeline_ir_function_list_append(
        pipeline_collect_generic_specs_ir_inst(inst, templates, all_fns, tt, src),
        pipeline_collect_generic_specs_ir_insts(rest, templates, all_fns, tt, src)
      )
    }
  }
}

fn pipeline_collect_generic_specs_ir_blocks(blocks: IrBlockList, templates: i64, all_fns: i64, tt: i64, src: i64) -> IrFunctionList {
  match blocks {
    IrBlockListNil -> ir_function_list_empty()
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          pipeline_ir_function_list_append(
            pipeline_collect_generic_specs_ir_insts(insts, templates, all_fns, tt, src),
            pipeline_collect_generic_specs_ir_blocks(rest, templates, all_fns, tt, src)
          )
        }
      }
    }
  }
}

fn pipeline_collect_generic_specs_ir_functions(functions: IrFunctionList, templates: i64, all_fns: i64, tt: i64) -> IrFunctionList {
  match functions {
    IrFunctionNil -> ir_function_list_empty()
    IrFunctionCons(f, rest) -> {
      pipeline_ir_function_list_append(
        pipeline_collect_generic_specs_ir_function(f, templates, all_fns, tt),
        pipeline_collect_generic_specs_ir_functions(rest, templates, all_fns, tt)
      )
    }
  }
}

fn pipeline_collect_generic_specs_ir_function(f: IrFunction, templates: i64, all_fns: i64, tt: i64) -> IrFunctionList {
  match f {
    IrFunction(hash, param_count, blocks, src) -> pipeline_collect_generic_specs_ir_blocks(blocks, templates, all_fns, tt, src)
  }
}

fn pipeline_generic_spec_closure_state_result(state: PipelineGenericSpecClosureState) -> IrFunctionList {
  match state {
    PipelineGenericSpecClosureState(result, work) -> result
  }
}

fn pipeline_generic_spec_closure_state_work(state: PipelineGenericSpecClosureState) -> IrFunctionList {
  match state {
    PipelineGenericSpecClosureState(result, work) -> work
  }
}

fn pipeline_collect_generic_specs_add_unseen(candidates: IrFunctionList, seen: i64, result: IrFunctionList, work: IrFunctionList) -> PipelineGenericSpecClosureState {
  match candidates {
    IrFunctionNil -> PipelineGenericSpecClosureState(result, work)
    IrFunctionCons(f, rest) -> {
      match f {
        IrFunction(hash, param_count, blocks, src) -> {
          if pipeline_hash_nlist_contains(seen, hash) == 1 {
            pipeline_collect_generic_specs_add_unseen(rest, seen, result, work)
          } else {
            nlist_add(seen, hash)
            pipeline_collect_generic_specs_add_unseen(rest, seen, ir_function_list_prepend(f, result), ir_function_list_prepend(f, work))
          }
        }
      }
    }
  }
}

fn pipeline_collect_generic_specs_closure_work(result: IrFunctionList, work: IrFunctionList, seen: i64, templates: i64, all_fns: i64, tt: i64) -> IrFunctionList {
  match work {
    IrFunctionNil -> pipeline_ir_function_list_reverse(result)
    IrFunctionCons(f, rest) -> {
      let nested = pipeline_collect_generic_specs_ir_function(f, templates, all_fns, tt)
      let next = pipeline_collect_generic_specs_add_unseen(nested, seen, result, rest)
      pipeline_collect_generic_specs_closure_work(
        pipeline_generic_spec_closure_state_result(next),
        pipeline_generic_spec_closure_state_work(next),
        seen,
        templates,
        all_fns,
        tt
      )
    }
  }
}

fn pipeline_collect_generic_specs_closure(specs: IrFunctionList, templates: i64, all_fns: i64, tt: i64) -> IrFunctionList {
  let seen = nlist_new()
  let seed = pipeline_collect_generic_specs_add_unseen(specs, seen, ir_function_list_empty(), ir_function_list_empty())
  pipeline_collect_generic_specs_closure_work(
    pipeline_generic_spec_closure_state_result(seed),
    pipeline_generic_spec_closure_state_work(seed),
    seen,
    templates,
    all_fns,
    tt
  )
}

fn pipeline_lower_ir(typed: TypedModule) -> IrModule {
  match typed {
    TypedModule(fns, src, tt) -> {
      let sidecar = pipeline_lower_typed_functions_internal(typed)
      IrModule(sidecar)
    }
  }
}

fn pipeline_ir_function_list_find_hash(functions: IrFunctionList, name_hash: i64) -> IrFunctionList {
  let mut cur = functions
  let mut found = ir_function_list_empty()
  let mut done = 0
  while done == 0 {
    match cur {
      IrFunctionNil -> { done = 1 0 }
      IrFunctionCons(f, rest) -> {
        match f {
          IrFunction(hash, params, blocks, src) -> {
            if hash == name_hash {
              found = ir_function_list_prepend(f, ir_function_list_empty())
              done = 1
            } else {
              cur = rest
            }
          }
        }
        0
      }
    }
  }
  found
}

-- ======================================================================
-- Static callback identity specialisation (2k banked devirt)
--
-- A named function value is an immutable static closure pair and
-- IrFunctionRefI64 is its semantic identity producer. Generic
-- specialisations that receive such a value are cloned per call-site
-- recipe (parameter index -> named function hash). Inside the clone,
-- recipe-bound indirect calls become ordinary direct calls. A recipe is
-- forwarded through nested generic calls, so helper chains specialise
-- transitively without assuming that every call site in the program has
-- the same callback.
--
-- IrFunctionRefI64 names an env-free direct target. IrClosureI64 names
-- an ordinary hoisted fn whose per-instance environment is recovered
-- from the pair and passed explicitly as arg 0. Values produced by
-- calls, loads, merges, or mutable slots remain dynamic.
-- ======================================================================

fn pipeline_ir_function_ref_target_hash(callee_hash: i64, type_args: TypeExprList) -> i64 {
  if type_expr_list_len(type_args) == 0 { callee_hash }
  else { mono_spec_hash(callee_hash, type_expr_list_to_nodes(type_args)) }
}

fn pipeline_ir_identity_specialisations_functions(result: PipelineIrIdentitySpecialisations) -> IrFunctionList {
  match result {
    PipelineIrIdentitySpecialisations(functions, requests) -> functions
  }
}

fn pipeline_ir_identity_specialisations_requests(result: PipelineIrIdentitySpecialisations) -> i64 {
  match result {
    PipelineIrIdentitySpecialisations(functions, requests) -> requests
  }
}

fn pipeline_ir_identity_value_defs_insts(insts: IrInstList, defs: i64) -> i64 {
  match insts {
    IrInstNil -> defs
    IrInstCons(inst, rest) -> {
      match inst {
        -- Descriptor layout: [SSA value, target hash, kind, 0].
        -- kind 1 is a static named-function pair; kind 2 is a closure
        -- pair whose environment must be loaded and passed as arg 0.
        IrFunctionRefI64(dst, callee_hash) -> nlist_add(defs, node_new(0, dst, callee_hash, 1, 0))
        IrGenericFunctionRefI64(dst, callee_hash, type_args) -> nlist_add(defs, node_new(0, dst, pipeline_ir_function_ref_target_hash(callee_hash, type_args), 1, 0))
        IrClosureI64(dst, f, captures, evidence) -> nlist_add(defs, node_new(0, dst, pipeline_ir_function_hash(f), 2, 0))
        _ -> 0
      }
      pipeline_ir_identity_value_defs_insts(rest, defs)
    }
  }
}

fn pipeline_ir_identity_value_defs_blocks(blocks: IrBlockList, defs: i64) -> i64 {
  match blocks {
    IrBlockListNil -> defs
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> pipeline_ir_identity_value_defs_insts(insts, defs)
      }
      pipeline_ir_identity_value_defs_blocks(rest, defs)
    }
  }
}

fn pipeline_ir_identity_value_defs(blocks: IrBlockList) -> i64 {
  pipeline_ir_identity_value_defs_blocks(blocks, nlist_new())
}

fn pipeline_ir_identity_has_value_defs_insts(insts: IrInstList) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let hit = match inst {
        IrFunctionRefI64(dst, callee_hash) -> 1
        IrGenericFunctionRefI64(dst, callee_hash, type_args) -> 1
        IrClosureI64(dst, f, captures, evidence) -> 1
        _ -> 0
      }
      if hit == 1 { 1 } else { pipeline_ir_identity_has_value_defs_insts(rest) }
    }
  }
}

fn pipeline_ir_identity_has_value_defs_blocks(blocks: IrBlockList) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      let hit = match block {
        IrBlock(id, params, insts, term) -> pipeline_ir_identity_has_value_defs_insts(insts)
      }
      if hit == 1 { 1 } else { pipeline_ir_identity_has_value_defs_blocks(rest) }
    }
  }
}

fn pipeline_ir_identity_value_def_lookup(defs: i64, value: i64) -> i64 {
  let mut identity = 0
  let mut i = 0
  let n = nlist_len(defs)
  while i < n and identity == 0 {
    let entry = nlist_get(defs, i)
    if node_f1(entry) == value { identity = entry } else { i = i + 1 }
  }
  identity
}

-- Recipe entries are raw scratch nodes [parameter index, callee hash].
-- They never enter the IR and are reclaimed with the surrounding
-- compile arena.
fn pipeline_ir_identity_recipe_lookup(recipe: i64, param_index: i64) -> i64 {
  let mut identity = 0
  let mut i = 0
  let n = nlist_len(recipe)
  while i < n and identity == 0 {
    let entry = nlist_get(recipe, i)
    if node_f1(entry) == param_index { identity = entry } else { i = i + 1 }
  }
  identity
}

fn pipeline_ir_identity_value(value: i64, defs: i64, recipe: i64, param_count: i64) -> i64 {
  let local = pipeline_ir_identity_value_def_lookup(defs, value)
  if local != 0 { local }
  else { if value >= 0 and value < param_count {
    pipeline_ir_identity_recipe_lookup(recipe, value)
  } else { 0 } }
}

fn pipeline_ir_identity_values_contains(values: IrValueList, value: i64) -> i64 {
  match values {
    IrValueNil -> 0
    IrValueCons(head, rest) -> {
      if head == value { 1 } else { pipeline_ir_identity_values_contains(rest, value) }
    }
  }
}

-- A binding is useful only when the corresponding parameter is called
-- indirectly here or forwarded into another generic call. This keeps
-- function values that are merely returned/stored on the canonical
-- body and avoids emitting no-op clones.
fn pipeline_ir_identity_param_relevant_insts(insts: IrInstList, param_index: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let hit = match inst {
        IrIndirectCallI64(dst, callee, args) -> if callee == param_index { 1 } else { 0 }
        IrGenericCallI64(dst, callee_hash, type_args, args) -> pipeline_ir_identity_values_contains(args, param_index)
        _ -> 0
      }
      if hit == 1 { 1 } else { pipeline_ir_identity_param_relevant_insts(rest, param_index) }
    }
  }
}

fn pipeline_ir_identity_param_relevant_blocks(blocks: IrBlockList, param_index: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      let hit = match block {
        IrBlock(id, params, insts, term) -> pipeline_ir_identity_param_relevant_insts(insts, param_index)
      }
      if hit == 1 { 1 } else { pipeline_ir_identity_param_relevant_blocks(rest, param_index) }
    }
  }
}

fn pipeline_ir_identity_recipe_from_args_inner(args: IrValueList, index: i64, defs: i64, caller_recipe: i64, caller_param_count: i64, base_blocks: IrBlockList, result: i64) -> i64 {
  match args {
    IrValueNil -> result
    IrValueCons(value, rest) -> {
      let identity = pipeline_ir_identity_value(value, defs, caller_recipe, caller_param_count)
      if identity != 0 and pipeline_ir_identity_param_relevant_blocks(base_blocks, index) == 1 {
        nlist_add(result, node_new(0, index, node_f2(identity), node_f3(identity), 0))
      } else { 0 }
      pipeline_ir_identity_recipe_from_args_inner(rest, index + 1, defs, caller_recipe, caller_param_count, base_blocks, result)
    }
  }
}

fn pipeline_ir_identity_recipe_from_args(args: IrValueList, defs: i64, caller_recipe: i64, caller_param_count: i64, base: IrFunction) -> i64 {
  match base {
    IrFunction(hash, param_count, blocks, src) -> {
      pipeline_ir_identity_recipe_from_args_inner(args, 0, defs, caller_recipe, caller_param_count, blocks, nlist_new())
    }
  }
}

fn pipeline_ir_identity_recipe_equal(left: i64, right: i64) -> i64 {
  let n = nlist_len(left)
  if n != nlist_len(right) { 0 }
  else {
    let mut same = 1
    let mut i = 0
    while i < n and same == 1 {
      let a = nlist_get(left, i)
      let b = nlist_get(right, i)
      if node_f1(a) == node_f1(b) and node_f2(a) == node_f2(b) and node_f3(a) == node_f3(b) {
        i = i + 1
      } else {
        same = 0
      }
    }
    same
  }
}

fn pipeline_ir_identity_request_lookup(requests: i64, base_hash: i64, recipe: i64) -> i64 {
  let mut clone_hash = 0
  let mut i = 0
  let n = nlist_len(requests)
  while i < n and clone_hash == 0 {
    let entry = nlist_get(requests, i)
    if node_f1(entry) == base_hash and pipeline_ir_identity_recipe_equal(node_f3(entry), recipe) == 1 {
      clone_hash = node_f2(entry)
    } else {
      i = i + 1
    }
  }
  clone_hash
}

fn pipeline_ir_identity_function_hash_exists(functions: IrFunctionList, target_hash: i64) -> i64 {
  match functions {
    IrFunctionNil -> 0
    IrFunctionCons(f, rest) -> {
      match f {
        IrFunction(hash, params, blocks, src) -> {
          if hash == target_hash { 1 } else { pipeline_ir_identity_function_hash_exists(rest, target_hash) }
        }
      }
    }
  }
}

fn pipeline_ir_identity_request_hash_exists(requests: i64, target_hash: i64) -> i64 {
  let mut found = 0
  let mut i = 0
  let n = nlist_len(requests)
  while i < n and found == 0 {
    if node_f2(nlist_get(requests, i)) == target_hash { found = 1 } else { i = i + 1 }
  }
  found
}

fn pipeline_ir_identity_recipe_hash(base_hash: i64, recipe: i64) -> i64 {
  let mut h = base_hash * 1000003 + 32452843
  let n = nlist_len(recipe)
  for i in 0..n {
    let entry = nlist_get(recipe, i)
    h = h * 31 + node_f1(entry) * 131 + node_f2(entry) + node_f3(entry) * 8191
  }
  if h == 0 { 49979687 } else { h }
}

fn pipeline_ir_identity_request_ensure(requests: i64, all_functions: IrFunctionList, base_hash: i64, recipe: i64) -> i64 {
  let existing = pipeline_ir_identity_request_lookup(requests, base_hash, recipe)
  if existing != 0 { existing }
  else {
    let mut clone_hash = pipeline_ir_identity_recipe_hash(base_hash, recipe)
    while pipeline_ir_identity_function_hash_exists(all_functions, clone_hash) == 1 or pipeline_ir_identity_request_hash_exists(requests, clone_hash) == 1 {
      clone_hash = clone_hash + 104729
      if clone_hash == 0 { clone_hash = 49979687 } else { 0 }
    }
    nlist_add(requests, node_new(0, base_hash, clone_hash, recipe, 0))
    clone_hash
  }
}

fn pipeline_ir_identity_inst_rewrite_insts(result: PipelineIrIdentityInstRewrite) -> IrInstList {
  match result {
    PipelineIrIdentityInstRewrite(insts, next_value) -> insts
  }
}

fn pipeline_ir_identity_inst_rewrite_next_value(result: PipelineIrIdentityInstRewrite) -> i64 {
  match result {
    PipelineIrIdentityInstRewrite(insts, next_value) -> next_value
  }
}

fn pipeline_ir_identity_block_rewrite_blocks(result: PipelineIrIdentityBlockRewrite) -> IrBlockList {
  match result {
    PipelineIrIdentityBlockRewrite(blocks, next_value) -> blocks
  }
}

fn pipeline_ir_identity_block_rewrite_next_value(result: PipelineIrIdentityBlockRewrite) -> i64 {
  match result {
    PipelineIrIdentityBlockRewrite(blocks, next_value) -> next_value
  }
}

fn pipeline_ir_identity_direct_call_rewrite(dst: i64, callee: i64, args: IrValueList, identity: i64, next_value: i64) -> PipelineIrIdentityInstRewrite {
  let target = node_f2(identity)
  let kind = node_f3(identity)
  if kind == 1 {
    PipelineIrIdentityInstRewrite(
      ir_inst_list_prepend(IrCallI64(dst, target, args), ir_inst_list_empty()),
      next_value
    )
  } else {
    -- A hoisted lambda is an ordinary fn(env, args...). Recover env
    -- from the closure pair and feed it as direct arg 0. Three fresh
    -- SSA ids stay above the function's existing value range.
    let offset = next_value
    let address = next_value + 1
    let env = next_value + 2
    let insts = ir_inst_list_prepend(
      IrConstI64(offset, 8),
      ir_inst_list_prepend(
        IrBinaryI64(address, IrAdd, callee, offset),
        ir_inst_list_prepend(
          IrPtrLoadI64(env, address),
          ir_inst_list_prepend(IrCallI64(dst, target, ir_value_list_prepend(env, args)), ir_inst_list_empty())
        )
      )
    )
    PipelineIrIdentityInstRewrite(insts, next_value + 3)
  }
}

fn pipeline_ir_identity_rewrite_inst(inst: IrInst, defs: i64, recipe: i64, param_count: i64, all_functions: IrFunctionList, requests: i64, next_value: i64) -> PipelineIrIdentityInstRewrite {
  match inst {
    IrIndirectCallI64(dst, callee, args) -> {
      let identity = pipeline_ir_identity_value(callee, defs, recipe, param_count)
      if identity == 0 {
        PipelineIrIdentityInstRewrite(ir_inst_list_prepend(inst, ir_inst_list_empty()), next_value)
      } else {
        pipeline_ir_identity_direct_call_rewrite(dst, callee, args, identity, next_value)
      }
    }
    IrGenericCallI64(dst, callee_hash, type_args, args) -> {
      let base_hash = mono_spec_hash(callee_hash, type_expr_list_to_nodes(type_args))
      match pipeline_ir_function_list_find_hash(all_functions, base_hash) {
        IrFunctionNil -> PipelineIrIdentityInstRewrite(ir_inst_list_prepend(inst, ir_inst_list_empty()), next_value)
        IrFunctionCons(base, rest) -> {
          let call_recipe = pipeline_ir_identity_recipe_from_args(args, defs, recipe, param_count, base)
          if nlist_len(call_recipe) == 0 {
            PipelineIrIdentityInstRewrite(ir_inst_list_prepend(inst, ir_inst_list_empty()), next_value)
          } else {
            let clone_hash = pipeline_ir_identity_request_ensure(requests, all_functions, base_hash, call_recipe)
            PipelineIrIdentityInstRewrite(
              ir_inst_list_prepend(IrCallI64(dst, clone_hash, args), ir_inst_list_empty()),
              next_value
            )
          }
        }
      }
    }
    _ -> PipelineIrIdentityInstRewrite(ir_inst_list_prepend(inst, ir_inst_list_empty()), next_value)
  }
}

fn pipeline_ir_identity_rewrite_insts(insts: IrInstList, defs: i64, recipe: i64, param_count: i64, all_functions: IrFunctionList, requests: i64, next_value: i64) -> PipelineIrIdentityInstRewrite {
  match insts {
    IrInstNil -> PipelineIrIdentityInstRewrite(IrInstNil, next_value)
    IrInstCons(inst, rest) -> {
      let head = pipeline_ir_identity_rewrite_inst(inst, defs, recipe, param_count, all_functions, requests, next_value)
      let tail = pipeline_ir_identity_rewrite_insts(
        rest,
        defs,
        recipe,
        param_count,
        all_functions,
        requests,
        pipeline_ir_identity_inst_rewrite_next_value(head)
      )
      PipelineIrIdentityInstRewrite(
        ir_inst_list_append(pipeline_ir_identity_inst_rewrite_insts(head), pipeline_ir_identity_inst_rewrite_insts(tail)),
        pipeline_ir_identity_inst_rewrite_next_value(tail)
      )
    }
  }
}

fn pipeline_ir_identity_rewrite_blocks(blocks: IrBlockList, defs: i64, recipe: i64, param_count: i64, all_functions: IrFunctionList, requests: i64, next_value: i64) -> PipelineIrIdentityBlockRewrite {
  match blocks {
    IrBlockListNil -> PipelineIrIdentityBlockRewrite(IrBlockListNil, next_value)
    IrBlockListCons(block, rest) -> {
      let rewritten_insts = match block {
        IrBlock(id, params, insts, term) -> {
          pipeline_ir_identity_rewrite_insts(insts, defs, recipe, param_count, all_functions, requests, next_value)
        }
      }
      let rewritten_block = match block {
        IrBlock(id, params, insts, term) -> {
          IrBlock(id, params, pipeline_ir_identity_inst_rewrite_insts(rewritten_insts), term)
        }
      }
      let rewritten_rest = pipeline_ir_identity_rewrite_blocks(
        rest,
        defs,
        recipe,
        param_count,
        all_functions,
        requests,
        pipeline_ir_identity_inst_rewrite_next_value(rewritten_insts)
      )
      PipelineIrIdentityBlockRewrite(
        ir_block_list_prepend(rewritten_block, pipeline_ir_identity_block_rewrite_blocks(rewritten_rest)),
        pipeline_ir_identity_block_rewrite_next_value(rewritten_rest)
      )
    }
  }
}

fn pipeline_ir_identity_rewrite_function(f: IrFunction, output_hash: i64, recipe: i64, all_functions: IrFunctionList, requests: i64) -> IrFunction {
  match f {
    IrFunction(hash, param_count, blocks, src) -> {
      if nlist_len(recipe) == 0 and pipeline_ir_identity_has_value_defs_blocks(blocks) == 0 {
        f
      } else {
        let defs = pipeline_ir_identity_value_defs(blocks)
        let rewritten = pipeline_ir_identity_rewrite_blocks(
          blocks,
          defs,
          recipe,
          param_count,
          all_functions,
          requests,
          pipeline_ir_function_next_value(param_count, blocks)
        )
        ir_function_new_blocks_src(output_hash, param_count, pipeline_ir_identity_block_rewrite_blocks(rewritten), src)
      }
    }
  }
}

fn pipeline_ir_identity_rewrite_originals(functions: IrFunctionList, all_functions: IrFunctionList, requests: i64, empty_recipe: i64) -> IrFunctionList {
  match functions {
    IrFunctionNil -> IrFunctionNil
    IrFunctionCons(f, rest) -> {
      let hash = pipeline_ir_function_hash(f)
      ir_function_list_prepend(
        pipeline_ir_identity_rewrite_function(f, hash, empty_recipe, all_functions, requests),
        pipeline_ir_identity_rewrite_originals(rest, all_functions, requests, empty_recipe)
      )
    }
  }
}

fn pipeline_ir_identity_specialise(functions: IrFunctionList) -> PipelineIrIdentitySpecialisations {
  let requests = nlist_new()
  let empty_recipe = nlist_new()
  let rewritten = pipeline_ir_identity_rewrite_originals(functions, functions, requests, empty_recipe)
  let mut clones = ir_function_list_empty()
  let mut i = 0
  -- requests may grow while a clone is rewritten: this is the
  -- recipe-aware transitive closure over nested generic calls.
  while i < nlist_len(requests) {
    let request = nlist_get(requests, i)
    let base_hash = node_f1(request)
    let clone_hash = node_f2(request)
    let recipe = node_f3(request)
    match pipeline_ir_function_list_find_hash(functions, base_hash) {
      IrFunctionNil -> 0
      IrFunctionCons(base, rest) -> {
        clones = ir_function_list_prepend(
          pipeline_ir_identity_rewrite_function(base, clone_hash, recipe, functions, requests),
          clones
        )
        0
      }
    }
    i = i + 1
  }
  PipelineIrIdentitySpecialisations(
    pipeline_ir_function_list_append(rewritten, pipeline_ir_function_list_reverse(clones)),
    requests
  )
}

fn pipeline_ir_identity_facts_extend(requests: i64, base_facts: PipelineIrSemanticFactList) -> PipelineIrSemanticFactList {
  let mut facts = base_facts
  let n = nlist_len(requests)
  for i in 0..n {
    let request = nlist_get(requests, i)
    let base_hash = node_f1(request)
    let fact = pipeline_ir_semantic_fact_find(base_facts, base_hash)
    if fact != 0 {
      let borrow = pipeline_ir_semantic_borrow_fact_find(base_facts, base_hash)
      facts = pipeline_ir_semantic_facts_prepend_with_borrow(node_f2(request), fact, borrow, facts)
    } else { 0 }
  }
  facts
}

fn pipeline_ir_native_params_unmanaged(params: i64, nparams: i64) -> i64 {
  let mut ok = 1
  for i in 0..nparams {
    let p = nlist_get(params, i)
    if cg_ty_is_managed(node_f3(p)) == 1 { ok = 0 } else { 0 }
  }
  ok
}

fn pipeline_ir_native_ty_supported_word_scalar(ty: i64) -> i64 {
  1
}

fn pipeline_ir_native_params_supported_word_scalar(params: i64, nparams: i64) -> i64 {
  let mut ok = 1
  for i in 0..nparams {
    let p = nlist_get(params, i)
    if pipeline_ir_native_ty_supported_word_scalar(node_f3(p)) == 0 { ok = 0 } else { 0 }
  }
  ok
}

fn pipeline_ir_native_ty_is_fp_scalar(ty: i64) -> i64 {
  if ty == 0 { 0 }
  else {
    if ty_eq(ty, ty_f64()) == 1 { 1 }
    else { if ty_eq(ty, ty_f32()) == 1 { 1 } else { 0 } }
  }
}

fn pipeline_ir_native_params_no_fp(params: i64, nparams: i64) -> i64 {
  let mut ok = 1
  for i in 0..nparams {
    let p = nlist_get(params, i)
    if pipeline_ir_native_ty_is_fp_scalar(node_f3(p)) == 1 { ok = 0 } else { 0 }
  }
  ok
}

