-- Residency metrics (register residency): pure post-scans over the emitted code buffer.
-- These measure sp-based memory traffic in the artifact itself rather than
-- relying on emission-site counters, so every emitter path is covered.

pub(package) fn pipeline_native_code_word(code: i64, pos: i64) -> i64 {
  let p = buf_ptr(code)
  let b0 = mem_load8_at(p, pos)
  let b1 = mem_load8_at(p, pos + 1)
  let b2 = mem_load8_at(p, pos + 2)
  let b3 = mem_load8_at(p, pos + 3)
  b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
}

-- Every remaining BRK after forward-reference resolution is a deliberate
-- fail-loud edge. Preserve its one-word site (and therefore every final code
-- offset) by branching to a per-site island appended after ordinary native
-- functions. The island transports both the immediate reason and original
-- code offset, then tail-branches to runtime_trap; no signal handler or
-- ucontext parsing enters the trusted boundary.
pub(package) fn pipeline_native_brk_reason(word: i64) -> i64 {
  let delta = word - 3560890368
  if delta < 0 or delta > 2097120 or delta % 32 != 0 { 0 - 1 } else { delta / 32 }
}

pub(package) fn pipeline_native_materialize_traps(code: i64, runtime_trap_target: i64) -> i64 {
  let original_end = buf_len(code)
  let sites = nlist_new()
  let mut pos = 0
  while pos < original_end {
    let reason = pipeline_native_brk_reason(pipeline_native_code_word(code, pos))
    if reason >= 0 { nlist_add(sites, node_new(0, pos, reason, 0, 0)) 0 } else { 0 }
    pos = pos + 4
  }
  for i in 0..nlist_len(sites) {
    let site = nlist_get(sites, i)
    let trap_pos = node_f1(site)
    let reason = node_f2(site)
    let island = buf_len(code)
    emit_mov_imm_safe(code, 0, reason)
    emit_mov_imm_safe(code, 1, trap_pos)
    let tail = buf_len(code)
    bu32(code, encode_b(runtime_trap_target - tail))
    bytes_set_u32(code, trap_pos, encode_b(island - trap_pos))
  }
  nlist_len(sites)
}

pub(package) fn pipeline_native_code_brk_count(code: i64, limit: i64) -> i64 {
  let mut count = 0
  let mut pos = 0
  while pos < limit {
    if pipeline_native_brk_reason(pipeline_native_code_word(code, pos)) >= 0 { count = count + 1 } else { 0 }
    pos = pos + 4
  }
  count
}

pub(package) fn pipeline_native_unmaterialized_trap_count(native: NativeModule) -> i64 {
  match native {
    NativeModule(code, fm, functions) -> pipeline_native_code_brk_count(code, fmap_native_provenance_table_offset(fm))
  }
}

-- kind 0: ldr Xt, [sp, #imm]      (spill reloads)
-- kind 1: str Xt, [sp, #imm]      (spill stores)
-- kind 2: ldp Xt, Xt2, [sp], #16  (GPR epilogue pair loads)
-- kind 3: stp Xt, Xt2, [sp, -16]! (GPR prologue pair stores)
-- kind 4: ldp Dt, Dt2, [sp], #16  (FP epilogue pair loads)
-- kind 5: stp Dt, Dt2, [sp, -16]! (FP prologue pair stores)
pub(package) fn pipeline_native_sp_traffic_count(native: NativeModule, kind: i64) -> i64 {
  match native {
    NativeModule(code, fm, functions) -> {
      let words = buf_len(code) / 4
      let mut count = 0
      for i in 0..words {
        let word = pipeline_native_code_word(code, i * 4)
        let rn = word / 32 - word / 1024 * 32
        if rn == 31 {
          let op22 = word / 4194304
          let want = if kind == 0 { 997 }
            else { if kind == 1 { 996 }
            else { if kind == 2 { 675 }
            else { if kind == 3 { 678 }
            else { if kind == 4 { 435 } else { 438 } } } } }
          if op22 == want { count = count + 1 } else { 0 }
        } else { 0 }
      }
      count
    }
  }
}

pub(package) fn pipeline_native_sp_load_count(native: NativeModule) -> i64 {
  pipeline_native_sp_traffic_count(native, 0)
}

pub(package) fn pipeline_native_sp_store_count(native: NativeModule) -> i64 {
  pipeline_native_sp_traffic_count(native, 1)
}

pub(package) fn pipeline_native_sp_pair_load_count(native: NativeModule) -> i64 {
  pipeline_native_sp_traffic_count(native, 2)
}

pub(package) fn pipeline_native_sp_pair_store_count(native: NativeModule) -> i64 {
  pipeline_native_sp_traffic_count(native, 3)
}

pub(package) fn pipeline_native_sp_fp_pair_load_count(native: NativeModule) -> i64 {
  pipeline_native_sp_traffic_count(native, 4)
}

pub(package) fn pipeline_native_sp_fp_pair_store_count(native: NativeModule) -> i64 {
  pipeline_native_sp_traffic_count(native, 5)
}

-- Count exact instruction words in the emitted buffer. Lets tests assert
-- structural facts such as "no stp x8, x9 pair save remains anywhere".
pub(package) fn pipeline_native_code_word_count(native: NativeModule, target: i64) -> i64 {
  match native {
    NativeModule(code, fm, functions) -> {
      let words = buf_len(code) / 4
      let mut count = 0
      for i in 0..words {
        if pipeline_native_code_word(code, i * 4) == target { count = count + 1 } else { 0 }
      }
      count
    }
  }
}

