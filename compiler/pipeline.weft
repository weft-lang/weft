pub(package) type PipelinePatternBindResult {
  PipelinePatternBindResult(PipelineValueEnv, IrInstList, i64, i64)
}

-- A recursive pattern is lowered as a short-circuit sequence. Each step runs
-- only after every parent/left sibling has matched, so nested tag and payload
-- reads never inspect an unmatched representation. condition < 0 denotes an
-- unconditional extraction/binding step.
pub(package) type PipelinePatternStep {
  PipelinePatternStep(IrInstList, i64)
}

pub(package) type PipelinePatternStepList {
  PipelinePatternStepNil,
  PipelinePatternStepCons(PipelinePatternStep, PipelinePatternStepList)
}

pub(package) type PipelinePatternPlan {
  PipelinePatternPlan(PipelineValueEnv, PipelinePatternStepList, i64, i64)
}

-- A successful consuming pattern is committed only after every discriminator
-- and guard succeeds. Entries describe independent arm-owned bindings:
-- tag 1 linear (f1 value, f2 type, f3/f4 name), tag 2 managed copy.
-- The residual plan contains only wildcard/unbound linear leaves.
pub(package) type PipelinePatternOwnership {
  PipelinePatternOwnership(i64, i64, i64, i64)
}

pub(package) type PipelineHandlerInlineStats {
  PipelineHandlerInlineStats(i64, i64)
}

-- Dense value-indexed const map: header = [known_ptr, value_ptr, cap].
-- SSA ids are unique and the verifier enforces cross-block dominance, so
-- one monotone in-place map per function round replaces the assoc list
-- that made every operand lookup O(consts-so-far).
pub(package) type PipelineIrConstEnv {
  PipelineIrConstEnvNil,
  PipelineIrConstEnvDense(i64)
}

pub(package) type PipelineIrConstLookup {
  PipelineIrConstLookup(i64, i64)
}

pub(package) type PipelineIrAliasEnv {
  PipelineIrAliasEnvNil,
  PipelineIrAliasEnvDense(i64)
}

pub(package) type PipelineIrRewrite {
  PipelineIrRewriteUnchanged,
  PipelineIrRewriteConst(i64),
  PipelineIrRewriteCopy(i64),
  PipelineIrRewriteInsts(IrInstList, i64)
}

pub(package) type PipelineIrSemanticFactList {
  PipelineIrSemanticFactNil,
  -- function hash, existing effect/ownership/ABI fact, typed borrow facts,
  -- lower subtree, upper subtree.
  PipelineIrSemanticFactNode(i64, i64, IrBorrowFacts, PipelineIrSemanticFactList, PipelineIrSemanticFactList)
}

-- Exact standard-library traversal identities become typed semantic facts at
-- declaration resolution. The compact code stored by codegen is an internal
-- memory-layout projection, never the vocabulary used by optimisers.
