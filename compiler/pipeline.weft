  if subst == 0 {
    types
  } else {
    type_expr_list_from_type_nodes(type_list_subst(type_expr_list_to_nodes(types), subst))
  }
}

fn pipeline_type_node_subst_or_same(ty: i64, subst: i64) -> i64 {
  if subst == 0 or ty == 0 { ty } else { ty_subst(ty, subst) }
}

fn pipeline_type_node_list_subst(types: i64, subst: i64) -> i64 {
