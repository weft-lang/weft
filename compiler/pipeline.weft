  if pipeline_ir_const_lookup_valid(found) == 1 {
    pipeline_ir_block_entry_fact_add_result(facts, 0)
  } else {
    pipeline_ir_block_entry_fact_add_result(pipeline_ir_block_entry_facts_prepend_ctor(block_id, value_id, ctor_hash, facts), 1)
  }
}

