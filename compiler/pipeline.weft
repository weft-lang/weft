}

impl TypedGrammar for WeftGrammar {
  fn check(self: i64, fns: i64, src: i64, tt: i64) -[Diagnose]> i64 {
    let ct = build_ctable(tt, src)
    ttable_set_ct(tt, ct)
    handle check_user_fns(fns, src, tt) {
      Conformance.conforms(ty, trh) -> resume(ctable_conforms_type(ct, ty, trh))
    }
  }
}

-- Render a diagnostic whose span may point into any loaded source buffer.
-- Absolute spans resolve through the ttable source registry (file path +
-- line/col in the owning buffer); anything else falls back to root-relative
-- rendering.
fn pipeline_diagnose_render(tt: i64, src: i64, msg: str, span: i64) -> i64 {
  let entry = ttable_find_source_entry(tt, span)
  if entry == 0 { diagnose_render(src, msg, span) }
  else {
    let buf = mem_load64_at(entry, 0)
    let path_ptr = mem_load64_at(entry + 16, 0)
    let path_len = mem_load64_at(entry + 24, 0)
    if path_len > 0 {
      sys_write(2, path_ptr, path_len)
      eprint(": ")
    } else { 0 }
    eprint_span(buf, span - buf)
    eprint(msg)
    eprint("\n")
  }
}

fn pipeline_parse(grammar: WeftGrammar, src: i64, n: i64, tt: i64) -> i64 {
  handle grammar.parse(src, n, tt) {
    Diagnose.error(msg, span) -> { pipeline_diagnose_render(tt, src, msg, span) resume(0) }
    Diagnose.warn(msg, span) -> { pipeline_diagnose_render(tt, src, msg, span) resume(0) }
    Diagnose.note(msg, span) -> { pipeline_diagnose_render(tt, src, msg, span) resume(0) }
  }
}

fn pipeline_check(grammar: WeftGrammar, fns: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  grammar.check(fns, src, tt)
}

fn pipeline_parse_module(grammar: WeftGrammar, src: i64, n: i64, tt: i64) -> AstModule {
  let fns = pipeline_parse(grammar, src, n, tt)
  AstModule(fns, src, tt)
}

fn pipeline_check_fns_with_diagnostics(fns: i64, src: i64, tt: i64) -[Diagnose]> TypedModule {
  let grammar = weft_grammar()
  pipeline_check(grammar, fns, src, tt)
  TypedModule(fns, src, tt)
}

fn pipeline_check_fns(fns: i64, src: i64, tt: i64) -> TypedModule {
  handle pipeline_check_fns_with_diagnostics(fns, src, tt) {
    Diagnose.error(msg, span) -> { pipeline_diagnose_render(tt, src, msg, span) resume(0) }
    Diagnose.warn(msg, span) -> { pipeline_diagnose_render(tt, src, msg, span) resume(0) }
    Diagnose.note(msg, span) -> { pipeline_diagnose_render(tt, src, msg, span) resume(0) }
  }
}

fn pipeline_check_fns_error_count(fns: i64, src: i64, tt: i64) -> i64 {
  let grammar = weft_grammar()
  handle pipeline_check(grammar, fns, src, tt) {
    Diagnose.error(msg, span) -> { pipeline_diagnose_render(tt, src, msg, span) resume(0) }
    Diagnose.warn(msg, span) -> { pipeline_diagnose_render(tt, src, msg, span) resume(0) }
    Diagnose.note(msg, span) -> { pipeline_diagnose_render(tt, src, msg, span) resume(0) }
  }
}

fn pipeline_check_module(ast: AstModule) -> TypedModule {
  match ast {
    AstModule(fns, src, tt) -> pipeline_check_fns(fns, src, tt)
  }
}

fn pipeline_ast_fns(ast: AstModule) -> i64 {
  match ast {
    AstModule(fns, src, tt) -> fns
  }
}

fn pipeline_typed_fns(typed: TypedModule) -> i64 {
  match typed {
    TypedModule(fns, src, tt) -> fns
  }
}

fn pipeline_ir_empty() -> IrModule {
  IrModule(ir_function_list_empty())
}

fn pipeline_ir_module(functions: IrFunctionList) -> IrModule {
  IrModule(functions)
}

fn pipeline_ir_functions(ir: IrModule) -> IrFunctionList {
  match ir {
    IrModule(functions) -> functions
    OptimisedIrModule(functions, inline_sites, residual_sites, evidence_candidate_sites, const_fold_sites, algebraic_fold_sites, dead_inst_sites, semantic_facts, pure_call_dce_sites, match_final_arm_elision_sites, block_entry_narrowing_sites, direct_call_inline_sites) -> functions
  }
}

fn pipeline_ir_is_optimised(ir: IrModule) -> i64 {
  match ir {
    IrModule(functions) -> 0
    OptimisedIrModule(functions, inline_sites, residual_sites, evidence_candidate_sites, const_fold_sites, algebraic_fold_sites, dead_inst_sites, semantic_facts, pure_call_dce_sites, match_final_arm_elision_sites, block_entry_narrowing_sites, direct_call_inline_sites) -> 1
  }
}

