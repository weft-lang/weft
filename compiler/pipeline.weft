}

fn pipeline_lower_module_with_handlers(module: PipelineLowerModule, handlers: PipelineHandlerInlineCtx) -> PipelineLowerModule {
  match module {
    PipelineLowerModule(src, tt, fns, old_handlers, subst, par_ctx, inline_depth) -> PipelineLowerModule(src, tt, fns, handlers, subst, par_ctx, inline_depth)
  }
}

fn pipeline_lower_module_with_par_ctx(module: PipelineLowerModule, par_ctx: PipelineParLowerCtx) -> PipelineLowerModule {
  match module {
    PipelineLowerModule(src, tt, fns, handlers, subst, old_par_ctx, inline_depth) -> PipelineLowerModule(src, tt, fns, handlers, subst, par_ctx, inline_depth)
  }
}

