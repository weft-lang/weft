  else { if callee_hash == pipeline_ir_pseudo_scaled_store64_hash() { 36 }
  else { if callee_hash == pipeline_ir_pseudo_scaled_store64_discard_hash() { 37 } else { 0 } } }
  let pseudo2 = if pseudo != 0 { pseudo }
  else { if callee_hash == pipeline_ir_pseudo_bridge_load64_hash() { 38 }
  else { if callee_hash == pipeline_ir_pseudo_bridge_store64_hash() { 39 }
  else { if callee_hash == pipeline_ir_pseudo_bridge_store64_discard_hash() { 40 }
  else { if callee_hash == pipeline_ir_pseudo_bridge_load8_hash() { 41 }
  else { if callee_hash == pipeline_ir_pseudo_bridge_store8_hash() { 42 }
  else { if callee_hash == pipeline_ir_pseudo_bridge_store8_discard_hash() { 43 } else { 0 } } } } } } }
  if pseudo2 != 0 { pseudo2 }
  else {
  let int_cast_prim = pipeline_ir_native_intrinsic_int_cast_target_prim(callee_hash)
  if int_cast_prim >= 0 { 11 }
  else { if pipeline_ir_native_intrinsic_signed_int_to_f64_hash(callee_hash) == 1 { 25 }
  else { if pipeline_ir_native_intrinsic_unsigned_int_to_f64_hash(callee_hash) == 1 { 26 }
