}

fn pipeline_match_arm_nodes_subst_types(arms: i64, count: i64, subst: i64) -> i64 {
  if subst == 0 {
    arms
  } else {
    let out = nlist_new()
    for i in 0..count {
      let arm = nlist_get(arms, i)
      let guard = if node_f3(arm) == 0 { 0 } else { pipeline_expr_node_subst_types(node_f3(arm), subst) }
      nlist_add(out, node_new(node_tag(arm), node_f1(arm), pipeline_expr_node_subst_types(node_f2(arm), subst), guard, node_f4(arm)))
    }
    out
  }
}

fn pipeline_handler_clause_nodes_subst_types(clauses: i64, count: i64, subst: i64) -> i64 {
