pub(package) type PipelineOptimisedFunctions {
  PipelineOptimisedFunctions(IrFunctionList, i64, i64, i64, i64, i64, i64)
}

pub(package) type PipelineHandlerInlineCtx {
  PipelineHandlerInlineCtxNil,
  -- eff_hash, clauses, nclauses, clause_src, direct, evidence,
  -- out_of_line_safe, rest.
  -- clause_src is the source buffer the clause nodes point into; op-name
  -- hashing and clause-body inlining must use it, not the perform site's
  -- src. direct marks entries backed by a lexical handler context;
  -- evidence marks entries whose ops table may be captured by a closure.
  -- out_of_line_safe records that every clause is capture-free, so a
  -- separately emitted enclosing clause/deferred body can address it.
  PipelineHandlerInlineCtxCons(i64, HandlerClauseList, i64, i64, i64, i64, i64, PipelineHandlerInlineCtx)
}

pub(package) type PipelineLambdaEvidenceSelection {
  PipelineLambdaEvidenceSelectionNone,
  PipelineLambdaEvidenceSelectionBound(i64, HandlerClauseList, i64, i64)
}

pub(package) type PipelineHandlerInlineMatch {
  PipelineHandlerInlineNoMatch,
  PipelineHandlerInlineMatched(i64, i64)
}

pub(package) type PipelineHandlerLowerCtx {
  PipelineHandlerLowerCtx(i64, PipelineValueEnv, PipelineLowerModule, i64)
}

pub(package) type PipelineFnLowerCtx {
  PipelineFnLowerCtx(i64, i64, PipelineHandlerInlineCtx)
}

pub(package) type PipelineNativeHandlerCtx {
  PipelineNativeHandlerCtxNil,
  -- effect hash, emitted clause infos, count, ops SSA, frame SSA,
  -- abortive-frame bit, rest.
  PipelineNativeHandlerCtxCons(i64, i64, i64, i64, i64, i64, PipelineNativeHandlerCtx)
}

