fn pipeline_fn_inner(fn_wrap: i64) -> i64 {
  if node_tag(fn_wrap) == 23 { node_f1(fn_wrap) } else { fn_wrap }
}

fn pipeline_first_fn_body_node(fns: i64) -> i64 {
  if nlist_len(fns) == 0 { 0 }
  else {
    let pair = nlist_get(fns, 0)
    let inner = pipeline_fn_inner(node_f1(pair))
    node_f4(inner)
  }
}

fn pipeline_first_decl_node(fns: i64) -> i64 {
  if nlist_len(fns) == 0 { 0 }
  else {
    let pair = nlist_get(fns, 0)
    node_f1(pair)
  }
}

fn pipeline_ast_first_decl(ast: AstModule) -> Decl {
  match ast {
    AstModule(fns, src, tt) -> decl_from_node(pipeline_first_decl_node(fns))
  }
}

fn pipeline_typed_first_decl(typed: TypedModule) -> Decl {
  match typed {
    TypedModule(fns, src, tt) -> decl_from_node(pipeline_first_decl_node(fns))
  }
}

fn pipeline_ast_decls(ast: AstModule) -> DeclList {
  match ast {
    AstModule(fns, src, tt) -> decl_list_from_fn_pairs(fns, 0)
  }
}

fn pipeline_typed_decls(typed: TypedModule) -> DeclList {
