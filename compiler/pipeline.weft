pub(package) fn pipeline_native_source_location_for_pair(pair: i64, tt: i64) -> PipelineNativeSourceLocation {
  if pair == 0 { PipelineNativeSourceUnknown }
  else {
    let fn_wrap = node_f1(pair)
    let inner = pipeline_fn_inner(fn_wrap)
    let src = node_f2(pair)
    let name_start = node_f1(inner)
    let name_len = node_f2(inner)
    let span = src + name_start
    let entry = if tt == 0 { 0 } else { ttable_find_source_entry(tt, span) }
    let source_buf = if entry == 0 { src } else { mem_load64_at(entry, 0) }
    let path_ptr = if entry == 0 { 0 } else { mem_load64_at(entry + 16, 0) }
    let path_len = if entry == 0 { 0 } else { mem_load64_at(entry + 24, 0) }
    let offset = span - source_buf
    let mut line = 1
    let mut col = 1
    let mut i = 0
    while i < offset {
      if mem_load8_at(source_buf, i) == 10 {
        line = line + 1
        col = 1
      } else { col = col + 1 }
      i = i + 1
    }
    PipelineNativeSourceKnown(src, name_start, name_len, path_ptr, path_len, line, col)
  }
}

pub(package) fn pipeline_native_source_location_for_hash(fns: i64, hash: i64, tt: i64) -> PipelineNativeSourceLocation {
  if pipeline_fns_fact_list_valid(fns) == 0 { PipelineNativeSourceUnknown }
  else {
    let bundle = pipeline_fns_index_bundle(fns)
    let named = pipeline_fns_index_probe(node_f1(bundle), hash)
    let pair = if named != 0 { named } else { pipeline_fns_index_probe(node_f2(bundle), hash) }
    pipeline_native_source_location_for_pair(pair, tt)
  }
}

pub(package) fn pipeline_native_ir_source_for_hash(functions: IrFunctionList, hash: i64) -> i64 {
  match functions {
    IrFunctionNil -> 0
    IrFunctionCons(f, rest) -> {
      match f {
        IrFunction(fn_hash, params, blocks, src) -> {
          if fn_hash == hash { src } else { pipeline_native_ir_source_for_hash(rest, hash) }
        }
      }
    }
  }
}

pub(package) fn pipeline_native_provenance_facts_for(functions: IrFunctionList, fm: i64) -> PipelineNativeProvenanceFactList {
  let layout = fmap_native_layout_facts(fm)
  let fns = fmap_native_fns(fm)
  let tt = fmap_get_tt(fm)
  let mut facts = PipelineNativeProvenanceFactNil
  let mut i = nlist_len(layout)
  while i > 0 {
    i = i - 1
    let entry = nlist_get(layout, i)
    let start = node_f1(entry)
    let end = node_f2(entry)
    let hash = node_f3(entry)
    let framed = node_f4(entry)
    let src = pipeline_native_ir_source_for_hash(functions, hash)
    let location = pipeline_native_source_location_for_hash(fns, hash, tt)
    facts = PipelineNativeProvenanceFactCons(
      PipelineNativeProvenanceFact(start, end, hash, framed, src, location),
      facts
    )
  }
  facts
}

pub(package) fn pipeline_native_provenance_facts_from(native: NativeModule) -> PipelineNativeProvenanceFactList {
  match native {
    NativeModule(code, fm, functions) -> pipeline_native_provenance_facts_for(functions, fm)
  }
}

pub(package) fn pipeline_native_provenance_facts(native: NativeModule) -> PipelineNativeProvenanceFactList {
  pipeline_native_provenance_facts_from(native)
}

pub(package) fn pipeline_native_provenance_fact_count(facts: PipelineNativeProvenanceFactList) -> i64 {
  match facts {
    PipelineNativeProvenanceFactNil -> 0
    PipelineNativeProvenanceFactCons(fact, rest) -> 1 + pipeline_native_provenance_fact_count(rest)
  }
}

pub(package) fn pipeline_native_provenance_named_count(facts: PipelineNativeProvenanceFactList) -> i64 {
  match facts {
    PipelineNativeProvenanceFactNil -> 0
    PipelineNativeProvenanceFactCons(fact, rest) -> {
      match fact {
        PipelineNativeProvenanceFact(start, end, hash, framed, src, location) -> {
          match location {
            PipelineNativeSourceUnknown -> pipeline_native_provenance_named_count(rest)
            PipelineNativeSourceKnown(name_src, name_start, name_len, path_ptr, path_len, line, col) -> 1 + pipeline_native_provenance_named_count(rest)
          }
        }
      }
    }
  }
}

pub(package) fn pipeline_native_provenance_ranges_valid(facts: PipelineNativeProvenanceFactList, previous_end: i64) -> i64 {
  match facts {
    PipelineNativeProvenanceFactNil -> 1
    PipelineNativeProvenanceFactCons(fact, rest) -> {
      match fact {
        PipelineNativeProvenanceFact(start, end, hash, framed, src, location) -> {
          if start < previous_end or end <= start or (framed != 0 and framed != 1) { 0 }
          else { pipeline_native_provenance_ranges_valid(rest, end) }
        }
      }
    }
  }
}

pub(package) fn pipeline_native_provenance_lookup_hash_or(facts: PipelineNativeProvenanceFactList, code_offset: i64, default: i64) -> i64 {
  match facts {
    PipelineNativeProvenanceFactNil -> default
    PipelineNativeProvenanceFactCons(fact, rest) -> {
      match fact {
        PipelineNativeProvenanceFact(start, end, hash, framed, src, location) -> {
          if code_offset >= start and code_offset < end { hash }
          else { pipeline_native_provenance_lookup_hash_or(rest, code_offset, default) }
        }
      }
    }
  }
}

pub(package) fn pipeline_native_provenance_table_magic() -> i64 { 1464225841 }
pub(package) fn pipeline_native_provenance_table_version() -> i64 { 1 }
pub(package) fn pipeline_native_provenance_table_header_size() -> i64 { 64 }
pub(package) fn pipeline_native_provenance_table_entry_size() -> i64 { 72 }
pub(package) fn pipeline_native_provenance_table_file_entry_size() -> i64 { 16 }

-- Read-only native-provenance ABI, all little-endian u64 and all string
-- offsets relative to the table base:
--   header: magic, version, fn count/size, file count/size, code offset, size
--   function: [start,end), hash, flags, name offset/len, file index, line, col
--   file: path offset, path len
-- Flags bit 0 is framed; bit 1 means the checked name/location fields exist.

pub(package) fn pipeline_native_provenance_bytes_equal(a: i64, b: i64, n: i64) -> i64 {
  let mut equal = 1
  let mut i = 0
  while i < n and equal == 1 {
    if mem_load8_at(a, i) != mem_load8_at(b, i) { equal = 0 } else { i = i + 1 }
  }
  equal
}

pub(package) fn pipeline_native_provenance_file_index(files: i64, path_ptr: i64, path_len: i64) -> i64 {
  let mut result = 0 - 1
  let mut i = 0
  while i < nlist_len(files) {
    let file = nlist_get(files, i)
    if node_f2(file) == path_len and pipeline_native_provenance_bytes_equal(node_f1(file), path_ptr, path_len) == 1 {
      result = node_f3(file)
      i = nlist_len(files)
    } else { i = i + 1 }
  }
  result
}

pub(package) fn pipeline_native_provenance_collect_files(facts: PipelineNativeProvenanceFactList, files: i64) -> i64 {
  match facts {
    PipelineNativeProvenanceFactNil -> files
    PipelineNativeProvenanceFactCons(fact, rest) -> {
      match fact {
        PipelineNativeProvenanceFact(start, end, hash, framed, src, location) -> {
          match location {
            PipelineNativeSourceUnknown -> 0
            PipelineNativeSourceKnown(name_src, name_start, name_len, path_ptr, path_len, line, col) -> {
              if path_len > 0 and pipeline_native_provenance_file_index(files, path_ptr, path_len) < 0 {
                nlist_add(files, node_new(0, path_ptr, path_len, nlist_len(files), 0))
              } else { 0 }
            }
          }
        }
      }
      pipeline_native_provenance_collect_files(rest, files)
    }
  }
}

pub(package) fn pipeline_native_provenance_files(facts: PipelineNativeProvenanceFactList) -> i64 {
  pipeline_native_provenance_collect_files(facts, nlist_new())
}

pub(package) fn pipeline_native_provenance_name_bytes(facts: PipelineNativeProvenanceFactList) -> i64 {
  match facts {
    PipelineNativeProvenanceFactNil -> 0
    PipelineNativeProvenanceFactCons(fact, rest) -> {
      match fact {
        PipelineNativeProvenanceFact(start, end, hash, framed, src, location) -> {
          match location {
            PipelineNativeSourceUnknown -> pipeline_native_provenance_name_bytes(rest)
            PipelineNativeSourceKnown(name_src, name_start, name_len, path_ptr, path_len, line, col) -> name_len + pipeline_native_provenance_name_bytes(rest)
          }
        }
      }
    }
  }
}

pub(package) fn pipeline_native_provenance_file_bytes(files: i64) -> i64 {
  let mut total = 0
  for i in 0..nlist_len(files) { total = total + node_f2(nlist_get(files, i)) }
  total
}

pub(package) fn pipeline_native_provenance_write_entries(facts: PipelineNativeProvenanceFactList, table: i64, strings: i64, files: i64, string_base: i64) -> i64 {
  match facts {
    PipelineNativeProvenanceFactNil -> 0
    PipelineNativeProvenanceFactCons(fact, rest) -> {
      match fact {
        PipelineNativeProvenanceFact(start, end, hash, framed, src, location) -> {
          bu64(table, start)
          bu64(table, end)
          bu64(table, hash)
          match location {
            PipelineNativeSourceUnknown -> {
              bu64(table, framed)
              bu64(table, 0)
              bu64(table, 0)
              bu64(table, 0 - 1)
              bu64(table, 0)
              bu64(table, 0)
            }
            PipelineNativeSourceKnown(name_src, name_start, name_len, path_ptr, path_len, line, col) -> {
              let name_off = string_base + buf_len(strings)
              let file_index = if path_len > 0 { pipeline_native_provenance_file_index(files, path_ptr, path_len) } else { 0 - 1 }
              bscopy(strings, name_src + name_start, name_len, 0)
              bu64(table, framed + 2)
              bu64(table, name_off)
              bu64(table, name_len)
              bu64(table, file_index)
              bu64(table, line)
              bu64(table, col)
            }
          }
        }
      }
      pipeline_native_provenance_write_entries(rest, table, strings, files, string_base)
    }
  }
}

pub(package) fn pipeline_native_provenance_write_files(files: i64, table: i64, strings: i64, string_base: i64) -> i64 {
  for i in 0..nlist_len(files) {
    let file = nlist_get(files, i)
    let path_ptr = node_f1(file)
    let path_len = node_f2(file)
    let path_off = string_base + buf_len(strings)
    bscopy(strings, path_ptr, path_len, 0)
    bu64(table, path_off)
    bu64(table, path_len)
  }
  0
}

pub(package) fn pipeline_native_provenance_table(facts: PipelineNativeProvenanceFactList, table_code_offset: i64) -> rc i64 {
  let files = pipeline_native_provenance_files(facts)
  let function_count = pipeline_native_provenance_fact_count(facts)
  let file_count = nlist_len(files)
  let fixed_size = pipeline_native_provenance_table_header_size() + function_count * pipeline_native_provenance_table_entry_size() + file_count * pipeline_native_provenance_table_file_entry_size()
  let total_size = fixed_size + pipeline_native_provenance_name_bytes(facts) + pipeline_native_provenance_file_bytes(files)
  let table = buf_new(total_size)
  let strings = buf_new(total_size - fixed_size)
  bu64(table, pipeline_native_provenance_table_magic())
  bu64(table, pipeline_native_provenance_table_version())
  bu64(table, function_count)
  bu64(table, pipeline_native_provenance_table_entry_size())
  bu64(table, file_count)
  bu64(table, pipeline_native_provenance_table_file_entry_size())
  bu64(table, table_code_offset)
  bu64(table, total_size)
  pipeline_native_provenance_write_entries(facts, table, strings, files, fixed_size)
  pipeline_native_provenance_write_files(files, table, strings, fixed_size)
  bscopy(table, buf_ptr(strings), buf_len(strings), 0)
  table
}

pub(package) fn pipeline_native_provenance_append_table(code: i64, fm: i64, functions: IrFunctionList) -> i64 {
  let align_remainder = buf_len(code) - buf_len(code) / 8 * 8
  if align_remainder != 0 { bfill(code, 8 - align_remainder) } else { 0 }
  let table_offset = buf_len(code)
  let table = pipeline_native_provenance_table(pipeline_native_provenance_facts_for(functions, fm), table_offset)
  bscopy(code, buf_ptr(table), buf_len(table), 0)
  fmap_set_native_provenance_table(fm, table_offset, buf_len(table))
  table_offset
}

pub(package) fn pipeline_native_provenance_patch_executable(code: i64, fm: i64) -> i64 {
  let adrp_pos = fmap_native_provenance_adrp_pos(fm)
  let table_offset = fmap_native_provenance_table_offset(fm)
  let page_delta = table_offset / 4096 - adrp_pos / 4096
  bytes_set_u32(code, adrp_pos, encode_adrp(17, page_delta))
  bytes_set_u32(code, adrp_pos + 4, encode_add_imm(17, 17, table_offset - table_offset / 4096 * 4096))
  table_offset
}

pub(package) fn pipeline_native_provenance_prepare_object(code: i64, fm: i64) -> i64 {
  let adrp_pos = fmap_native_provenance_adrp_pos(fm)
  bytes_set_u32(code, adrp_pos, encode_adrp(17, 0))
  bytes_set_u32(code, adrp_pos + 4, encode_add_imm(17, 17, 0))
  adrp_pos
}

