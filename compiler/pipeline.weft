  }
}

pub(package) fn pipeline_ir_typed_direct_effect_named_handler_scan(config: HandlerConfiguration, body: Expr, fact: HandlerInstallFact, src: i64) -> i64 {
  let args = pipeline_ir_typed_direct_effect_expr_list_scan(handler_configuration_args(config), src)
  let body_scan = pipeline_ir_typed_direct_effect_expr_scan(body, src)
  let implementation = if pipeline_handler_install_is_resolved(fact) == 1 {
    pipeline_ir_typed_direct_effect_handler_clauses_scan(
      pipeline_handler_install_clauses(fact),
      pipeline_handler_install_source_or(fact, src)
    )
  } else { pipeline_ir_effect_scan_flag(2) }
  pipeline_ir_effect_scan_merge(args, pipeline_ir_effect_scan_merge(body_scan, implementation))
}

pub(package) fn pipeline_ir_typed_direct_effect_named_call_scan(ns: i64, nl: i64, args: ExprList, src: i64) -> i64 {
  let pure_intrinsic = intrinsic_pure_effect_call_name(src, ns, nl)
  let direct_flags = intrinsic_semantic_effect_flags(src, ns, nl)
  let callee_scan = if pure_intrinsic == 1 {
    pipeline_ir_effect_scan_flag(0)
  } else {
    if direct_flags != 0 { pipeline_ir_effect_scan_flag(direct_flags) } else { pipeline_ir_effect_scan_callee(str_hash(src, ns, nl)) }
  }
  pipeline_ir_effect_scan_merge(callee_scan, pipeline_ir_typed_direct_effect_expr_list_scan(args, src))
}

pub(package) fn pipeline_ir_typed_direct_effect_call_scan(expr: Expr, src: i64) -> i64 {
  match expr {
    Call(ns, nl, args) -> pipeline_ir_typed_direct_effect_named_call_scan(ns, nl, args, src)
    GenericCall(type_args, inner_call) -> pipeline_ir_typed_direct_effect_call_scan(inner_call, src)
    _ -> pipeline_ir_typed_direct_effect_expr_scan(expr, src)
  }
}

pub(package) fn pipeline_ir_typed_direct_effect_expr_scan(expr: Expr, src: i64) -> i64 {
  match expr {
    IntLit(value, start, len) -> pipeline_ir_effect_scan_flag(0)
    StringLit(start, len) -> pipeline_ir_effect_scan_flag(0)
    BoolLit(value) -> pipeline_ir_effect_scan_flag(0)
    FloatLit(start, len) -> pipeline_ir_effect_scan_flag(0)
    Ident(ns, nl) -> pipeline_ir_effect_scan_flag(0)
    BorrowIdent(ns, nl, owner, mutable) -> pipeline_ir_effect_scan_flag(0)
    BinOp(op, lhs, rhs) -> pipeline_ir_effect_scan_merge(pipeline_ir_typed_direct_effect_expr_scan(lhs, src), pipeline_ir_typed_direct_effect_expr_scan(rhs, src))
    Call(ns, nl, args) -> pipeline_ir_typed_direct_effect_named_call_scan(ns, nl, args, src)
    GenericCall(type_args, inner_call) -> pipeline_ir_typed_direct_effect_call_scan(inner_call, src)
    If(cond, then_expr, else_expr) -> pipeline_ir_effect_scan_merge(pipeline_ir_effect_scan_merge(pipeline_ir_typed_direct_effect_expr_scan(cond, src), pipeline_ir_typed_direct_effect_expr_scan(then_expr, src)), pipeline_ir_typed_direct_effect_expr_scan(else_expr, src))
    While(cond, body) -> pipeline_ir_effect_scan_merge(pipeline_ir_typed_direct_effect_expr_scan(cond, src), pipeline_ir_typed_direct_effect_expr_scan(body, src))
    Loop(body) -> pipeline_ir_typed_direct_effect_expr_scan(body, src)
    Break(value) -> pipeline_ir_typed_direct_effect_expr_scan(value, src)
    BreakNoValue -> pipeline_ir_effect_scan_flag(0)
    Continue -> pipeline_ir_effect_scan_flag(0)
    Return(value) -> pipeline_ir_typed_direct_effect_expr_scan(value, src)
    ReturnNoValue -> pipeline_ir_effect_scan_flag(0)
    Defer(cleanup, body, source_site) -> pipeline_ir_effect_scan_merge(pipeline_ir_typed_direct_effect_expr_scan(cleanup, src), pipeline_ir_typed_direct_effect_expr_scan(body, src))
    Let(ns, nl, value, body) -> pipeline_ir_effect_scan_merge(pipeline_ir_typed_direct_effect_expr_scan(value, src), pipeline_ir_typed_direct_effect_expr_scan(body, src))
    LetMut(ns, nl, value, body) -> pipeline_ir_effect_scan_merge(pipeline_ir_typed_direct_effect_expr_scan(value, src), pipeline_ir_typed_direct_effect_expr_scan(body, src))
    Assign(ns, nl, value) -> pipeline_ir_typed_direct_effect_expr_scan(value, src)
    AddressOf(mutable, target) -> pipeline_ir_effect_scan_merge(pipeline_ir_effect_scan_flag(2), pipeline_ir_typed_direct_effect_expr_scan(target, src))
    Deref(ptr) -> pipeline_ir_effect_scan_merge(pipeline_ir_effect_scan_flag(2), pipeline_ir_typed_direct_effect_expr_scan(ptr, src))
    PtrAssign(ptr, value) -> pipeline_ir_effect_scan_merge(pipeline_ir_effect_scan_flag(2), pipeline_ir_effect_scan_merge(pipeline_ir_typed_direct_effect_expr_scan(ptr, src), pipeline_ir_typed_direct_effect_expr_scan(value, src)))
    Block(first, rest) -> pipeline_ir_effect_scan_merge(pipeline_ir_typed_direct_effect_expr_scan(first, src), pipeline_ir_typed_direct_effect_expr_scan(rest, src))
    FieldAccess(base, field_ns, field_nl, fact) -> pipeline_ir_typed_direct_effect_expr_scan(base, src)
    RecordUpdate(base, fields, fact) -> pipeline_ir_effect_scan_merge(pipeline_ir_typed_direct_effect_expr_scan(base, src), pipeline_ir_typed_direct_effect_record_fields_scan(fields, src))
    IndexedLen(base, fixed_len) -> pipeline_ir_typed_direct_effect_expr_scan(base, src)
    IndexedGet(base, index, element_ty, fixed_len) -> pipeline_ir_effect_scan_merge(pipeline_ir_typed_direct_effect_expr_scan(base, src), pipeline_ir_typed_direct_effect_expr_scan(index, src))
    IndexedSet(base, index, value, fact) -> pipeline_ir_effect_scan_merge(pipeline_ir_typed_direct_effect_expr_scan(base, src), pipeline_ir_effect_scan_merge(pipeline_ir_typed_direct_effect_expr_scan(index, src), pipeline_ir_typed_direct_effect_expr_scan(value, src)))
    IndexedSlice(base, start, end, fact) -> pipeline_ir_effect_scan_merge(pipeline_ir_typed_direct_effect_expr_scan(base, src), pipeline_ir_effect_scan_merge(pipeline_ir_typed_direct_effect_expr_scan(start, src), pipeline_ir_typed_direct_effect_expr_scan(end, src)))
    RecordInit(type_ns, type_nl, fields) -> pipeline_ir_typed_direct_effect_record_fields_scan(fields, src)
    ArrayLiteral(elements, resolved_ty, span) -> pipeline_ir_typed_direct_effect_expr_list_scan(elements, src)
    Match(scrutinee, arms) -> pipeline_ir_effect_scan_merge(pipeline_ir_typed_direct_effect_expr_scan(scrutinee, src), pipeline_ir_typed_direct_effect_match_arms_scan(arms, src))
    Not(operand) -> pipeline_ir_typed_direct_effect_expr_scan(operand, src)
    Lambda(params, body, source_site) -> pipeline_ir_typed_direct_effect_expr_scan(body, src)
    Perform(lhs, op_ns, op_nl, args) -> pipeline_ir_effect_scan_merge(pipeline_ir_effect_scan_flag(4), pipeline_ir_effect_scan_merge(pipeline_ir_typed_direct_effect_expr_scan(lhs, src), pipeline_ir_typed_direct_effect_expr_list_scan(args, src)))
    Handle(body, clauses, hret) -> pipeline_ir_effect_scan_merge(pipeline_ir_typed_direct_effect_expr_scan(body, src), pipeline_ir_effect_scan_merge(pipeline_ir_typed_direct_effect_handler_clauses_scan(clauses, src), match hret { NoHandleReturn -> 0 HandleReturnClause(rns, rnl, rb) -> pipeline_ir_typed_direct_effect_expr_scan(rb, src) }))
    WithHandler(config, body, fact, source_site) -> pipeline_ir_typed_direct_effect_named_handler_scan(config, body, fact, src)
    Resume(value) -> pipeline_ir_typed_direct_effect_expr_scan(value, src)
    MethodCall(recv, method_hash, args, type_hash) -> pipeline_ir_effect_scan_merge(pipeline_ir_effect_scan_flag(2), pipeline_ir_effect_scan_merge(pipeline_ir_typed_direct_effect_expr_scan(recv, src), pipeline_ir_typed_direct_effect_expr_list_scan(args, src)))
    Try(inner, effect_atom) -> pipeline_ir_effect_scan_merge(pipeline_ir_effect_scan_flag(4), pipeline_ir_typed_direct_effect_expr_scan(inner, src))
    InterpConcat(left, right) -> pipeline_ir_effect_scan_merge(pipeline_ir_typed_direct_effect_expr_scan(left, src), pipeline_ir_typed_direct_effect_expr_scan(right, src))
    ForIter(var_ns, var_nl, collection, body) -> pipeline_ir_effect_scan_merge(pipeline_ir_typed_direct_effect_expr_scan(collection, src), pipeline_ir_typed_direct_effect_expr_scan(body, src))
    OptChain(base, field_ns, field_nl, effect_atom) -> pipeline_ir_effect_scan_merge(pipeline_ir_effect_scan_flag(4), pipeline_ir_typed_direct_effect_expr_scan(base, src))
    LetTyped(inner, ann_type) -> pipeline_ir_typed_direct_effect_expr_scan(inner, src)
    NilExpr -> pipeline_ir_effect_scan_flag(0)
    UnknownExpr(tag) -> pipeline_ir_effect_scan_flag(2)
  }
}

