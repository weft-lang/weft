}

-- Value-keyed row-upper: v < len(vec)/width for an SSA value v (a load
-- of a row-bounded slot, immutable thereafter). First vector for
-- (width, value) at this block, or -1.
pub(package) fn pipeline_ir_block_entry_vector_row_upper_vec_chain(facts: PipelineIrBlockEntryFactChain, block_id: i64, width: i64, value_id: i64) -> i64 {
  match facts {
    PipelineIrBlockEntryFactNil -> 0 - 1
