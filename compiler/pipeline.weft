fn pipeline_expr_has_match_typed(expr: Expr) -> bool {
  match expr {
    Match(scrutinee, arms) -> true
    BinOp(op, lhs, rhs) -> pipeline_expr_has_match_typed(lhs) or pipeline_expr_has_match_typed(rhs)
    Call(ns, nl, args) -> pipeline_expr_list_has_match_typed(args)
    GenericCall(type_args, inner_call) -> pipeline_expr_has_match_typed(inner_call)
    If(cond, then_expr, else_expr) -> pipeline_expr_has_match_typed(cond) or pipeline_expr_has_match_typed(then_expr) or pipeline_expr_has_match_typed(else_expr)
    While(cond, body) -> pipeline_expr_has_match_typed(cond) or pipeline_expr_has_match_typed(body)
    Loop(body) -> pipeline_expr_has_match_typed(body)
    Break(value) -> pipeline_expr_has_match_typed(value)
    Return(value) -> pipeline_expr_has_match_typed(value)
    Defer(cleanup, body) -> pipeline_expr_has_match_typed(cleanup) or pipeline_expr_has_match_typed(body)
    Let(ns, nl, value, body) -> pipeline_expr_has_match_typed(value) or pipeline_expr_has_match_typed(body)
    LetMut(ns, nl, value, body) -> pipeline_expr_has_match_typed(value) or pipeline_expr_has_match_typed(body)
    Assign(ns, nl, value) -> pipeline_expr_has_match_typed(value)
    AddressOf(mutable, target) -> pipeline_expr_has_match_typed(target)
    Deref(ptr) -> pipeline_expr_has_match_typed(ptr)
    PtrAssign(ptr, value) -> pipeline_expr_has_match_typed(ptr) or pipeline_expr_has_match_typed(value)
    Block(first, rest) -> pipeline_expr_has_match_typed(first) or pipeline_expr_has_match_typed(rest)
    FieldAccess(base, field_ns, field_nl, fact) -> pipeline_expr_has_match_typed(base)
    IndexedLen(base, fixed_len) -> pipeline_expr_has_match_typed(base)
    IndexedGet(base, index, element_ty, fixed_len) -> pipeline_expr_has_match_typed(base) or pipeline_expr_has_match_typed(index)
    IndexedSet(base, index, value, fact) -> pipeline_expr_has_match_typed(base) or pipeline_expr_has_match_typed(index) or pipeline_expr_has_match_typed(value)
    IndexedSlice(base, start, end, fact) -> pipeline_expr_has_match_typed(base) or pipeline_expr_has_match_typed(start) or pipeline_expr_has_match_typed(end)
    RecordInit(type_ns, type_nl, fields) -> pipeline_record_fields_have_match_typed(fields)
    ArrayLiteral(elements, resolved_ty, span) -> pipeline_expr_list_has_match_typed(elements)
    Not(operand) -> pipeline_expr_has_match_typed(operand)
    Lambda(params, body) -> pipeline_expr_has_match_typed(body)
    Perform(lhs, op_ns, op_nl, args) -> pipeline_expr_has_match_typed(lhs) or pipeline_expr_list_has_match_typed(args)
    Handle(body, clauses, hret) -> pipeline_expr_has_match_typed(body) or pipeline_handler_clause_list_has_match_typed(clauses) or (match hret { NoHandleReturn -> false HandleReturnClause(rns, rnl, rb) -> pipeline_expr_has_match_typed(rb) })
    Resume(value) -> pipeline_expr_has_match_typed(value)
    MethodCall(recv, method_hash, args, type_hash) -> pipeline_expr_has_match_typed(recv) or pipeline_expr_list_has_match_typed(args)
    Try(inner, effect_atom) -> pipeline_expr_has_match_typed(inner)
    InterpConcat(left, right) -> pipeline_expr_has_match_typed(left) or pipeline_expr_has_match_typed(right)
    ForIter(var_ns, var_nl, collection, body) -> pipeline_expr_has_match_typed(collection) or pipeline_expr_has_match_typed(body)
    OptChain(base, field_ns, field_nl, effect_atom) -> pipeline_expr_has_match_typed(base)
    LetTyped(inner, ann_type) -> pipeline_expr_has_match_typed(inner)
    _ -> false
  }
}

fn pipeline_call_is_raw_intrinsic(src: i64, ns: i64, nl: i64) -> i64 {
  if src_eq(src, ns, nl, "__mem_load64") == 1 { 1 }
  else { if src_eq(src, ns, nl, "__mem_store64") == 1 { 1 }
  else { if src_eq(src, ns, nl, "__mem_load8") == 1 { 1 }
  else { if src_eq(src, ns, nl, "__mem_store8") == 1 { 1 }
  else { if src_eq(src, ns, nl, "__bump_alloc") == 1 { 1 }
  else { 0 } } } } }
}

fn pipeline_expr_list_has_raw_intrinsic_typed(exprs: ExprList, src: i64) -> bool {
  match exprs {
    ExprListNil -> false
    ExprListCons(expr, rest) -> if pipeline_expr_has_raw_intrinsic_typed(expr, src) == 1 { true } else { pipeline_expr_list_has_raw_intrinsic_typed(rest, src) }
  }
}

fn pipeline_record_fields_have_raw_intrinsic_typed(fields: RecordFieldList, src: i64) -> bool {
  match fields {
    RecordFieldListNil -> false
    RecordFieldListCons(field, rest) -> {
      let found = match field {
        RecordField(ns, nl, value, fact) -> pipeline_expr_has_raw_intrinsic_typed(value, src)
        UnknownRecordField(tag) -> false
      }
      if found == 1 { true } else { pipeline_record_fields_have_raw_intrinsic_typed(rest, src) }
    }
  }
}

fn pipeline_match_arms_have_raw_intrinsic_typed(arms: MatchArmList, src: i64) -> bool {
  match arms {
    MatchArmListNil -> false
    MatchArmListCons(arm, rest) -> {
      let found = match arm {
        Arm(pattern, body, guard, has_guard) -> {
          if has_guard == 1 {
            pipeline_expr_has_raw_intrinsic_typed(guard, src) or pipeline_expr_has_raw_intrinsic_typed(body, src)
          } else {
            pipeline_expr_has_raw_intrinsic_typed(body, src)
          }
        }
        UnknownArm(tag) -> false
      }
      if found == 1 { true } else { pipeline_match_arms_have_raw_intrinsic_typed(rest, src) }
    }
  }
}

fn pipeline_handler_clause_list_has_raw_intrinsic_typed(clauses: HandlerClauseList, src: i64) -> bool {
  match clauses {
    HandlerClauseListNil -> false
    HandlerClauseListCons(clause, rest) -> if pipeline_expr_has_raw_intrinsic_typed(handler_clause_body_expr(clause), src) == 1 { true } else { pipeline_handler_clause_list_has_raw_intrinsic_typed(rest, src) }
  }
}

fn pipeline_expr_has_raw_intrinsic_typed(expr: Expr, src: i64) -> bool {
  match expr {
    Call(ns, nl, args) -> if pipeline_call_is_raw_intrinsic(src, ns, nl) == 1 { true } else { pipeline_expr_list_has_raw_intrinsic_typed(args, src) }
    BinOp(op, lhs, rhs) -> pipeline_expr_has_raw_intrinsic_typed(lhs, src) or pipeline_expr_has_raw_intrinsic_typed(rhs, src)
    GenericCall(type_args, inner_call) -> pipeline_expr_has_raw_intrinsic_typed(inner_call, src)
    If(cond, then_expr, else_expr) -> pipeline_expr_has_raw_intrinsic_typed(cond, src) or pipeline_expr_has_raw_intrinsic_typed(then_expr, src) or pipeline_expr_has_raw_intrinsic_typed(else_expr, src)
    While(cond, body) -> pipeline_expr_has_raw_intrinsic_typed(cond, src) or pipeline_expr_has_raw_intrinsic_typed(body, src)
    Loop(body) -> pipeline_expr_has_raw_intrinsic_typed(body, src)
    Break(value) -> pipeline_expr_has_raw_intrinsic_typed(value, src)
    Return(value) -> pipeline_expr_has_raw_intrinsic_typed(value, src)
    Defer(cleanup, body) -> pipeline_expr_has_raw_intrinsic_typed(cleanup, src) or pipeline_expr_has_raw_intrinsic_typed(body, src)
    Let(ns, nl, value, body) -> pipeline_expr_has_raw_intrinsic_typed(value, src) or pipeline_expr_has_raw_intrinsic_typed(body, src)
    LetMut(ns, nl, value, body) -> pipeline_expr_has_raw_intrinsic_typed(value, src) or pipeline_expr_has_raw_intrinsic_typed(body, src)
    Assign(ns, nl, value) -> pipeline_expr_has_raw_intrinsic_typed(value, src)
    AddressOf(mutable, target) -> pipeline_expr_has_raw_intrinsic_typed(target, src)
    Deref(ptr) -> pipeline_expr_has_raw_intrinsic_typed(ptr, src)
    PtrAssign(ptr, value) -> pipeline_expr_has_raw_intrinsic_typed(ptr, src) or pipeline_expr_has_raw_intrinsic_typed(value, src)
    Block(first, rest) -> pipeline_expr_has_raw_intrinsic_typed(first, src) or pipeline_expr_has_raw_intrinsic_typed(rest, src)
    FieldAccess(base, field_ns, field_nl, fact) -> pipeline_expr_has_raw_intrinsic_typed(base, src)
    IndexedLen(base, fixed_len) -> pipeline_expr_has_raw_intrinsic_typed(base, src)
    IndexedGet(base, index, element_ty, fixed_len) -> pipeline_expr_has_raw_intrinsic_typed(base, src) or pipeline_expr_has_raw_intrinsic_typed(index, src)
    IndexedSet(base, index, value, fact) -> pipeline_expr_has_raw_intrinsic_typed(base, src) or pipeline_expr_has_raw_intrinsic_typed(index, src) or pipeline_expr_has_raw_intrinsic_typed(value, src)
    IndexedSlice(base, start, end, fact) -> pipeline_expr_has_raw_intrinsic_typed(base, src) or pipeline_expr_has_raw_intrinsic_typed(start, src) or pipeline_expr_has_raw_intrinsic_typed(end, src)
    RecordInit(type_ns, type_nl, fields) -> pipeline_record_fields_have_raw_intrinsic_typed(fields, src)
    ArrayLiteral(elements, resolved_ty, span) -> pipeline_expr_list_has_raw_intrinsic_typed(elements, src)
    Match(scrutinee, arms) -> pipeline_expr_has_raw_intrinsic_typed(scrutinee, src) or pipeline_match_arms_have_raw_intrinsic_typed(arms, src)
    Not(operand) -> pipeline_expr_has_raw_intrinsic_typed(operand, src)
    Lambda(params, body) -> pipeline_expr_has_raw_intrinsic_typed(body, src)
    Perform(lhs, op_ns, op_nl, args) -> pipeline_expr_has_raw_intrinsic_typed(lhs, src) or pipeline_expr_list_has_raw_intrinsic_typed(args, src)
    Handle(body, clauses, hret) -> pipeline_expr_has_raw_intrinsic_typed(body, src) or pipeline_handler_clause_list_has_raw_intrinsic_typed(clauses, src) or (match hret { NoHandleReturn -> false HandleReturnClause(rns, rnl, rb) -> pipeline_expr_has_raw_intrinsic_typed(rb, src) })
    Resume(value) -> pipeline_expr_has_raw_intrinsic_typed(value, src)
    MethodCall(recv, method_hash, args, type_hash) -> pipeline_expr_has_raw_intrinsic_typed(recv, src) or pipeline_expr_list_has_raw_intrinsic_typed(args, src)
    Try(inner, effect_atom) -> pipeline_expr_has_raw_intrinsic_typed(inner, src)
    InterpConcat(left, right) -> pipeline_expr_has_raw_intrinsic_typed(left, src) or pipeline_expr_has_raw_intrinsic_typed(right, src)
    ForIter(var_ns, var_nl, collection, body) -> pipeline_expr_has_raw_intrinsic_typed(collection, src) or pipeline_expr_has_raw_intrinsic_typed(body, src)
    OptChain(base, field_ns, field_nl, effect_atom) -> pipeline_expr_has_raw_intrinsic_typed(base, src)
    LetTyped(inner, ann_type) -> pipeline_expr_has_raw_intrinsic_typed(inner, src)
    _ -> false
  }
}

-- Identity-home store for above-home-count counter values (handler
-- scratch, closure/env counters). ck: the identity home now holds dst —
-- these stores were the un-instrumented def sites the v2 replay exposed
-- (reads of handler scratch flow through load_reg and ARE recorded, so
-- an unrecorded write here surfaces as a CLOBBERED false violation).
fn pipeline_ir_native_store_reg(code: i64, facts: PipelineIrNativeValueHomeFacts, dst: i64, phys: i64) -> i64 {
  if dst < 0 { 0 }
  else { if dst < 8 {
    bu32(code, encode_add_imm(dst + 19, phys, 0))
    pipeline_ir_native_ck_def(code, facts, dst + 19, dst)
  } else {
    emit_store_reg(code, dst, phys)
    pipeline_ir_native_ck_def(code, facts, 0 - (dst - 7), dst)
  } }
}

fn pipeline_ir_native_pinned_slot_none() -> i64 { 0 }
fn pipeline_ir_native_pinned_slot_max_count() -> i64 { 3 }
fn pipeline_ir_native_pinned_slot_kind_generic() -> i64 { 0 }
fn pipeline_ir_native_pinned_slot_kind_loop() -> i64 { 1 }

fn pipeline_ir_native_pinned_slot_phys_for_index(index: i64) -> i64 {
  if index == 0 { 8 }
  else { if index == 1 { 10 }
  else { if index == 2 { 11 }
  else { 0 } } }
}

fn pipeline_ir_native_pinned_slot_new(slot: i64, phys: i64, kind: i64, rest: i64) -> i64 {
  node_new(0, slot, phys, rest, kind)
}

fn pipeline_ir_native_pinned_slot_lookup(pinned: i64, value: i64) -> i64 {
  let mut cur = pinned
  let mut phys = 0
  while cur != 0 and phys == 0 {
    if node_f1(cur) == value {
      phys = node_f2(cur)
    } else {
      cur = node_f3(cur)
    }
  }
  phys
}

fn pipeline_ir_native_pinned_slot_count(pinned: i64) -> i64 {
  let mut cur = pinned
  let mut count = 0
  while cur != 0 {
    count = count + 1
    cur = node_f3(cur)
  }
  count
}

fn pipeline_ir_native_pinned_slot_contains(pinned: i64, slot: i64) -> i64 {
  if pipeline_ir_native_pinned_slot_lookup(pinned, slot) != 0 { 1 } else { 0 }
}

fn pipeline_ir_native_pinned_slot_kind_count(pinned: i64, kind: i64) -> i64 {
  let mut cur = pinned
  let mut count = 0
  while cur != 0 {
    if node_f4(cur) == kind { count = count + 1 } else { 0 }
    cur = node_f3(cur)
  }
  count
}

fn pipeline_ir_native_pinned_slot_add_candidate_kind(pinned: i64, slot: i64, kind: i64) -> i64 {
  if slot < 8 { pinned }
  else { if pipeline_ir_native_pinned_slot_contains(pinned, slot) == 1 { pinned }
  else {
    let count = pipeline_ir_native_pinned_slot_count(pinned)
    if count >= pipeline_ir_native_pinned_slot_max_count() {
      pinned
    } else {
      let phys = pipeline_ir_native_pinned_slot_phys_for_index(count)
      if phys == 0 { pinned } else { pipeline_ir_native_pinned_slot_new(slot, phys, kind, pinned) }
    }
  } }
}

fn pipeline_ir_native_pinned_slot_add_candidate(pinned: i64, slot: i64) -> i64 {
  pipeline_ir_native_pinned_slot_add_candidate_kind(pinned, slot, pipeline_ir_native_pinned_slot_kind_generic())
}

fn pipeline_ir_native_identity_home(value: i64) -> i64 {
  cg_canonical_value_home(value)
}

fn pipeline_ir_native_value_home_apply_assignments(assignments: i64, homes: i64, next_value: i64) -> i64 {
  if assignments == 0 {
    0
  } else {
    -- The linked assignment ledger is newest-first. Apply the tail first
    -- so the same value's newest allocator decision remains authoritative.
    pipeline_ir_native_value_home_apply_assignments(node_f3(assignments), homes, next_value)
    let value = node_f1(assignments)
    if value >= 0 and value < next_value {
      pipeline_ir_native_resident_dense_set(homes, value, node_f2(assignments))
    } else { 0 }
  }
}

fn pipeline_ir_native_value_home_facts(next_value: i64, assignments: i64) -> PipelineIrNativeValueHomeFacts {
  let homes = nlist_new()
  for value in 0..next_value {
    nlist_add(homes, pipeline_ir_native_identity_home(value))
  }
  pipeline_ir_native_value_home_apply_assignments(assignments, homes, next_value)
  PipelineIrNativeValueHomeFacts(homes, assignments, node_new(0, pipeline_ir_native_forward_marker(), 0 - 1, 0, 0))
}

fn pipeline_ir_native_identity_home_facts(next_value: i64) -> PipelineIrNativeValueHomeFacts {
  PipelineIrNativeIdentityHomeFacts(next_value, node_new(0, pipeline_ir_native_forward_marker(), 0 - 1, 0, 0))
}

fn pipeline_ir_native_value_home_facts_forward(facts: PipelineIrNativeValueHomeFacts) -> i64 {
  match facts {
    PipelineIrNativeValueHomeFacts(homes, assignments, forward) -> forward
    PipelineIrNativeIdentityHomeFacts(next_value, forward) -> forward
  }
}

fn pipeline_ir_native_value_home_lookup(facts: PipelineIrNativeValueHomeFacts, value: i64) -> i64 {
  match facts {
    PipelineIrNativeValueHomeFacts(homes, assignments, forward) -> {
      if value >= 0 and value < nlist_len(homes) { nlist_get(homes, value) } else { 0 }
    }
    PipelineIrNativeIdentityHomeFacts(next_value, forward) -> {
      if value >= 0 and value < next_value { pipeline_ir_native_identity_home(value) } else { 0 }
    }
  }
}

fn pipeline_ir_native_value_home_fact_count(facts: PipelineIrNativeValueHomeFacts) -> i64 {
  match facts {
    PipelineIrNativeValueHomeFacts(homes, assignments, forward) -> nlist_len(homes)
    PipelineIrNativeIdentityHomeFacts(next_value, forward) -> next_value
  }
}

fn pipeline_ir_native_value_home_count_include(count: i64, value: i64) -> i64 {
  if value >= count { value + 1 } else { count }
}

fn pipeline_ir_native_value_home_count_include_evidence(count: i64, fm: i64) -> i64 {
  pipeline_ir_native_value_home_count_include(count, fmap_lambda_evidence_value(fm))
}

fn pipeline_ir_native_value_home_count_include_handlers(count: i64, handlers: PipelineNativeHandlerCtx) -> i64 {
  match handlers {
    PipelineNativeHandlerCtxNil -> count
    PipelineNativeHandlerCtxCons(eff_hash, infos, nclauses, ops_ctr, frame_ctr, is_abortive, rest) -> {
      let with_ops = pipeline_ir_native_value_home_count_include(count, ops_ctr)
      let with_frame = pipeline_ir_native_value_home_count_include(with_ops, frame_ctr)
      pipeline_ir_native_value_home_count_include_handlers(with_frame, rest)
    }
  }
}

fn pipeline_ir_native_handler_scratch_base() -> i64 { 200 }

fn pipeline_ir_native_handler_home_scan_depth(scan: PipelineIrNativeHandlerHomeScan) -> i64 {
  match scan {
    PipelineIrNativeHandlerHomeScan(depth, max_depth) -> depth
  }
}

fn pipeline_ir_native_handler_home_scan_max_depth(scan: PipelineIrNativeHandlerHomeScan) -> i64 {
  match scan {
    PipelineIrNativeHandlerHomeScan(depth, max_depth) -> max_depth
  }
}

fn pipeline_ir_native_handler_home_scan_insts(insts: IrInstList, scan: PipelineIrNativeHandlerHomeScan) -> PipelineIrNativeHandlerHomeScan {
  match insts {
    IrInstNil -> scan
    IrInstCons(inst, rest) -> {
      let depth = pipeline_ir_native_handler_home_scan_depth(scan)
      let max_depth = pipeline_ir_native_handler_home_scan_max_depth(scan)
      let next = match inst {
        IrHandleI64(dst, handle_src, effect_hash, clauses, nclauses, reserved) -> {
          let pushed = depth + 1
          PipelineIrNativeHandlerHomeScan(pushed, if pushed > max_depth { pushed } else { max_depth })
        }
        IrHandlerPopI64(frame) -> PipelineIrNativeHandlerHomeScan(if depth > 0 { depth - 1 } else { 0 }, max_depth)
        IrAbortLandingI64(dst) -> scan
        _ -> scan
      }
      pipeline_ir_native_handler_home_scan_insts(rest, next)
    }
  }
}

fn pipeline_ir_native_handler_home_scan_blocks(blocks: IrBlockList, scan: PipelineIrNativeHandlerHomeScan) -> PipelineIrNativeHandlerHomeScan {
  match blocks {
    IrBlockListNil -> scan
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          pipeline_ir_native_handler_home_scan_blocks(rest, pipeline_ir_native_handler_home_scan_insts(insts, scan))
        }
      }
    }
  }
}

fn pipeline_ir_native_value_home_count_include_handler_scratch(count: i64, blocks: IrBlockList, initial_depth: i64) -> i64 {
  let scan = pipeline_ir_native_handler_home_scan_blocks(blocks, PipelineIrNativeHandlerHomeScan(initial_depth, initial_depth))
  let max_depth = pipeline_ir_native_handler_home_scan_max_depth(scan)
  if max_depth > 0 {
    let handler_count = pipeline_ir_native_handler_scratch_base() + max_depth * 2
    if handler_count > count { handler_count } else { count }
  } else {
    count
  }
}

fn pipeline_ir_native_identity_home_facts_like(facts: PipelineIrNativeValueHomeFacts) -> PipelineIrNativeValueHomeFacts {
  match facts {
    PipelineIrNativeValueHomeFacts(homes, assignments, forward) -> pipeline_ir_native_identity_home_facts(nlist_len(homes))
    PipelineIrNativeIdentityHomeFacts(next_value, forward) -> facts
  }
}

-- Adjacent def-use load forwarding. A mutable cell beside the immutable
-- dense home facts records the last spilled value together with the register
-- it was stored FROM and the code position after the store. A later operand
-- load may reuse that register only if the code buffer has not grown since
-- (the register is provably untouched). Only the last-loaded operand path
-- (load_rhs) consumes forwards, so an earlier operand's forwarded register
-- cannot be clobbered by a subsequent operand load in the same instruction.
fn pipeline_ir_native_forward_marker() -> i64 { 0 - 987654321 }

-- 2v Stage 2 dead spill-store deletion: a call-shaped def whose result
-- is never used (no inst use, no term use, not a block param) gets this
-- pseudo-home in the pinned map. store_reg_pinned emits NOTHING for it
-- (the call executes; only the dead result store is deleted); every
-- read path traps loudly — a read of a discard-homed value means the
-- use analysis lied. IR-level DCE already deletes dead PURE defs, so
-- this catches exactly the effectful remainder (statement-position
-- calls). Restricted to inst_call_read_safe def shapes so machinery
-- with bespoke, uninstrumented canonical-home reads (intrinsics,
-- perform, handler frames, closures, vector lanes) can never carry it.
fn pipeline_ir_native_discard_home() -> i64 { 999 }

-- 2v Stage 3 constant rematerialization: a frame-homed IrConstI64 in
-- [0, 65535] whose every use reads through the pinned-aware load path
-- re-materializes with a single movz at each use instead of reloading
-- from its slot — and its canonical store disappears with the loads.
-- The constant is carried IN the pinned-map phys encoding:
-- phys = remat_base + k. Runs after every placement pass, so it only
-- takes constants no register class wanted (a pool/bank home is
-- strictly better: uses read the register for free).
fn pipeline_ir_native_remat_base() -> i64 { 1000000 }
-- Second remat window: movn-range negatives. phys = movn_base + k
-- encodes constant ~k = -(k+1), covering [-65536, -1] in one movn.
-- The window sits ABOVE movz's [1000000, 1065535]; every reader's
-- `>= remat_base` branch must test `>= remat_movn_base` FIRST or a
-- movn phys decodes as a garbage movz constant.
fn pipeline_ir_native_remat_movn_base() -> i64 { 1200000 }

fn pipeline_ir_native_forward_record(facts: PipelineIrNativeValueHomeFacts, code: i64, value: i64, phys: i64) -> i64 {
  let cell = pipeline_ir_native_value_home_facts_forward(facts)
  if cell == 0 { 0 }
  else {
    mem_store64_at(cell, 16, value)
    mem_store64_at(cell, 32, buf_len(code) * 64 + phys)
    0
  }
}

fn pipeline_ir_native_forward_hit(facts: PipelineIrNativeValueHomeFacts, code: i64, value: i64) -> i64 {
  let cell = pipeline_ir_native_value_home_facts_forward(facts)
  if cell == 0 { 0 }
  else {
    if node_f2(cell) == value {
      let packed = node_f4(cell)
      let pos = packed / 64
      if pos == buf_len(code) {
        let phys = packed - pos * 64
        pipeline_ir_native_ck_read(code, facts, phys, value)
        phys
      } else { 0 }
    } else { 0 }
  }
}

-- 2v allocation checker (Stage 0): emission-time read/def event ledger.
-- The ledger handle lives in the forwarding cell's free f3 field (0 =
-- disarmed) so the load/store choke points need no signature change; it is
-- armed per function under audit mode only. Event nodes are
-- node(kind, byte_off, loc, value) with kind 0 = READ (loc must hold
-- value when execution reaches byte_off) and 1 = DEF (loc holds value
-- from byte_off on). Locations: 0-30 GPRs, negative -(slot+1) frame
-- slots. FP homes are not evented in Stage 0 v1.
fn pipeline_ir_native_ck_events(facts: PipelineIrNativeValueHomeFacts) -> i64 {
  let cell = pipeline_ir_native_value_home_facts_forward(facts)
  if cell == 0 { 0 } else { node_f3(cell) }
}

fn pipeline_ir_native_ck_arm(facts: PipelineIrNativeValueHomeFacts) -> i64 {
  let cell = pipeline_ir_native_value_home_facts_forward(facts)
  if cell == 0 { 0 } else {
    mem_store64_at(cell, 24, nlist_new())
    0
  }
}

fn pipeline_ir_native_ck_read(code: i64, facts: PipelineIrNativeValueHomeFacts, loc: i64, value: i64) -> i64 {
  let events = pipeline_ir_native_ck_events(facts)
  if events == 0 { 0 } else {
    nlist_add(events, node_new(0, buf_len(code), loc, value, 0))
    0
  }
}

fn pipeline_ir_native_ck_def(code: i64, facts: PipelineIrNativeValueHomeFacts, loc: i64, value: i64) -> i64 {
  let events = pipeline_ir_native_ck_events(facts)
  if events == 0 { 0 } else {
    nlist_add(events, node_new(1, buf_len(code), loc, value, 0))
    0
  }
}

-- FP residents are encoded in the pinned map as 1000 + fd (the
-- cg_f64_fp_regid convention). They are only ever read at the f64
-- materialisation/operand sites; a GPR-path read is a selection bug, so
-- the GPR helpers trap loudly instead of emitting a garbage register.
fn pipeline_ir_native_fp_resident_fd(facts: PipelineIrNativeValueHomeFacts, value: i64) -> i64 {
  let phys = pipeline_ir_native_value_home_lookup(facts, value)
  -- FP homes occupy exactly 1000+d0 .. 1000+d15; discard and remat
  -- pseudo-homes live outside this window and are not FP residents.
  if phys >= 1000 and phys <= 1015 { phys - 1000 } else { 0 }
}

fn pipeline_ir_native_load_reg(code: i64, facts: PipelineIrNativeValueHomeFacts, value: i64) -> i64 {
  let phys = pipeline_ir_native_value_home_lookup(facts, value)
  if phys >= pipeline_ir_native_remat_movn_base() {
    bu32(code, encode_movn(16, phys - pipeline_ir_native_remat_movn_base()))
    16
  } else { if phys >= pipeline_ir_native_remat_base() {
    bu32(code, encode_movz(16, phys - pipeline_ir_native_remat_base(), 0))
    16
  } else { if phys >= 1000 or phys == pipeline_ir_native_discard_home() {
    bu32(code, encode_brk(20))
    17
  } else { if phys < 0 {
    pipeline_ir_native_ck_read(code, facts, phys, value)
    emit_load_spill_offset(code, 16, (0 - phys - 1) * 8)
    16
  } else { if phys != 0 {
    pipeline_ir_native_ck_read(code, facts, phys, value)
    phys
  } else {
    bu32(code, encode_brk(20))
    17
  } } } } }
}

fn pipeline_ir_native_load_rhs(code: i64, facts: PipelineIrNativeValueHomeFacts, value: i64) -> i64 {
  let phys = pipeline_ir_native_value_home_lookup(facts, value)
  if phys >= pipeline_ir_native_remat_movn_base() {
    bu32(code, encode_movn(17, phys - pipeline_ir_native_remat_movn_base()))
    17
  } else { if phys >= pipeline_ir_native_remat_base() {
    bu32(code, encode_movz(17, phys - pipeline_ir_native_remat_base(), 0))
    17
  } else { if phys >= 1000 or phys == pipeline_ir_native_discard_home() {
    bu32(code, encode_brk(20))
    17
  } else { if phys < 0 {
    pipeline_ir_native_ck_read(code, facts, phys, value)
    emit_load_spill_offset(code, 17, (0 - phys - 1) * 8)
    17
  } else { if phys != 0 {
    pipeline_ir_native_ck_read(code, facts, phys, value)
    phys
  } else {
    bu32(code, encode_brk(20))
    17
  } } } } }
}

fn pipeline_ir_native_store_reg_pinned(code: i64, facts: PipelineIrNativeValueHomeFacts, dst: i64, phys: i64) -> i64 {
  if dst < 0 { 0 }
  else {
    let pinned_phys = pipeline_ir_native_value_home_lookup(facts, dst)
    if pinned_phys == pipeline_ir_native_discard_home() or pinned_phys >= pipeline_ir_native_remat_base() {
      -- Discard: dead result, store deleted. Remat: every use
      -- re-materializes the constant, so the home is never read and
      -- the store is equally dead.
      0
    } else {
    if pinned_phys >= 1000 {
      bu32(code, encode_brk(20))
    } else { if pinned_phys < 0 {
      emit_store_spill_offset(code, phys, (0 - pinned_phys - 1) * 8)
    } else { if pinned_phys != 0 {
      bu32(code, encode_add_imm(pinned_phys, phys, 0))
    } else {
      bu32(code, encode_brk(20))
    } } }
    -- ck: the home now holds dst. The x17 staging register is also
    -- rebound to dst — forward_hit is the only consumer of a
    -- source-register binding and forwarding only ever reads x17. A
    -- non-x17 source keeps its OLD binding: the move leaves the source
    -- register's previous tenant intact (the copied value equals it),
    -- and rebinding it under the copy's id erased claims the replay
    -- still needs (the Stage 0 bring-up false-positive class).
    if pinned_phys < 0 or (pinned_phys != 0 and pinned_phys < 1000) {
      pipeline_ir_native_ck_def(code, facts, pinned_phys, dst)
      if phys == 17 {
        pipeline_ir_native_ck_def(code, facts, phys, dst)
      } else { 0 }
    } else { 0 }
    -- Only x17-resident results are forwardable: the spill-load and
    -- multi-instruction op scratch paths clobber x15/x16 but never x17
    -- before operands are read.
    if pinned_phys < 0 and pinned_phys == pipeline_ir_native_identity_home(dst) and phys == 17 {
      pipeline_ir_native_forward_record(facts, code, dst, phys)
    } else { 0 }
    }
  }
}

fn pipeline_ir_native_fp_env_empty() -> PipelineIrNativeFpEnv {
  PipelineIrNativeFpEnvNil
}

fn pipeline_ir_native_fp_env_single(value: i64, prim: i64, fd: i64) -> PipelineIrNativeFpEnv {
  PipelineIrNativeFpEnvCons(value, prim, fd, PipelineIrNativeFpEnvNil)
}

fn pipeline_ir_native_fp_env_prepend(env: PipelineIrNativeFpEnv, value: i64, prim: i64, fd: i64) -> PipelineIrNativeFpEnv {
  PipelineIrNativeFpEnvCons(value, prim, fd, env)
}

fn pipeline_ir_native_fp_env_drop_fd(env: PipelineIrNativeFpEnv, fd: i64) -> PipelineIrNativeFpEnv {
  match env {
    PipelineIrNativeFpEnvNil -> PipelineIrNativeFpEnvNil
    PipelineIrNativeFpEnvCons(value, prim, entry_fd, rest) -> {
      let filtered = pipeline_ir_native_fp_env_drop_fd(rest, fd)
      if entry_fd == fd { filtered } else { PipelineIrNativeFpEnvCons(value, prim, entry_fd, filtered) }
    }
  }
}

fn pipeline_ir_native_vector_data_reg() -> i64 { 9 }

fn pipeline_ir_native_vector_data_fact_list_empty() -> PipelineIrNativeVectorDataFactList {
  PipelineIrNativeVectorDataFactNil
}

fn pipeline_ir_native_vector_data_facts_unassigned(entries: PipelineIrNativeVectorDataFactList) -> PipelineIrNativeVectorDataFacts {
  PipelineIrNativeVectorDataFacts(0, entries)
}

fn pipeline_ir_native_vector_data_facts_home(facts: PipelineIrNativeVectorDataFacts) -> i64 {
  match facts {
    PipelineIrNativeVectorDataFacts(home, entries) -> home
  }
}

fn pipeline_ir_native_vector_data_facts_entries(facts: PipelineIrNativeVectorDataFacts) -> PipelineIrNativeVectorDataFactList {
  match facts {
    PipelineIrNativeVectorDataFacts(home, entries) -> entries
  }
}

fn pipeline_ir_native_vector_data_facts_have_access(facts: PipelineIrNativeVectorDataFacts) -> i64 {
  match pipeline_ir_native_vector_data_facts_entries(facts) {
    PipelineIrNativeVectorDataFactNil -> 0
    PipelineIrNativeVectorDataFactCons(dst, vec, reload, rest) -> 1
  }
}

fn pipeline_ir_native_vector_data_facts_assign_home(facts: PipelineIrNativeVectorDataFacts) -> PipelineIrNativeVectorDataFacts {
  if pipeline_ir_native_vector_data_facts_have_access(facts) == 1 {
    -- x9 is the first allocator-owned cache-class home. Unlike the scalar
    -- pool, lane emission never uses it as an operand/result scratch.
    PipelineIrNativeVectorDataFacts(pipeline_ir_native_vector_data_reg(), pipeline_ir_native_vector_data_facts_entries(facts))
  } else {
    facts
  }
}

fn pipeline_ir_native_vector_data_fact_reload_for(entries: PipelineIrNativeVectorDataFactList, dst: i64, vec: i64) -> i64 {
  match entries {
    PipelineIrNativeVectorDataFactNil -> 0 - 1
    PipelineIrNativeVectorDataFactCons(fact_dst, fact_vec, reload, rest) -> {
      if fact_dst == dst {
        if fact_vec == vec { reload } else { 0 - 1 }
      } else {
        pipeline_ir_native_vector_data_fact_reload_for(rest, dst, vec)
      }
    }
  }
}

-- This is the cache-segment fact producer's clobber contract. Keep the
-- whitelist synchronized with actual instruction emission: every omitted
-- instruction begins a new segment, so facts fail closed.
fn pipeline_ir_native_inst_preserves_vector_data_fact(inst: IrInst) -> i64 {
  match inst {
    IrConstI64(dst, value) -> 1
    IrNilI64(dst) -> 1
    IrBinaryI64(dst, op, lhs, rhs) -> 1
    IrFloatBinaryI64(dst, prim, op, lhs, rhs) -> 1
    IrUnaryI64(dst, op, value) -> 1
    IrSlotI64(slot) -> 1
    IrLoadI64(dst, slot) -> 1
    IrStoreI64(slot, value) -> 1
    IrVectorGetI64(dst, vec, index, fallback, check_mode) -> 1
    IrVectorSetI64(dst, vec, index, value, check_mode) -> 1
    IrBindI64(ns, nl, value, ty) -> 1
    IrVariantTagI64(dst, value) -> 1
    IrVariantPayloadI64(dst, value, index) -> 1
    IrFieldLoadI64(dst, base, field_hash, field_index) -> 1
    IrRecordLayoutWordLoadI64(dst, base, record_data_size, field_hash, byte_offset) -> 1
    IrResumeI64(dst, value) -> 1
    IrAbortLandingI64(dst) -> 1
    _ -> 0
  }
}

fn pipeline_ir_native_vector_data_facts_for_insts(insts: IrInstList, cached_vec: i64, entries: PipelineIrNativeVectorDataFactList) -> PipelineIrNativeVectorDataFactList {
  match insts {
    IrInstNil -> entries
    IrInstCons(inst, rest) -> {
      match inst {
        IrVectorGetI64(dst, vec, index, fallback, check_mode) -> {
          let reload = if cached_vec == vec { 0 } else { 1 }
          pipeline_ir_native_vector_data_facts_for_insts(rest, vec, PipelineIrNativeVectorDataFactCons(dst, vec, reload, entries))
        }
        IrVectorSetI64(dst, vec, index, value, check_mode) -> {
          let reload = if cached_vec == vec { 0 } else { 1 }
          pipeline_ir_native_vector_data_facts_for_insts(rest, vec, PipelineIrNativeVectorDataFactCons(dst, vec, reload, entries))
        }
        _ -> {
          let next_cached = if pipeline_ir_native_inst_preserves_vector_data_fact(inst) == 1 { cached_vec } else { 0 - 1 }
          pipeline_ir_native_vector_data_facts_for_insts(rest, next_cached, entries)
        }
      }
    }
  }
}

fn pipeline_ir_native_vector_data_facts_for_blocks_from(blocks: IrBlockList, entries: PipelineIrNativeVectorDataFactList) -> PipelineIrNativeVectorDataFactList {
  match blocks {
    IrBlockListNil -> entries
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          -- Cache contents are not a CFG fact: each emitted block begins a
          -- fresh segment exactly as the former emission-time env did.
          let next = pipeline_ir_native_vector_data_facts_for_insts(insts, 0 - 1, entries)
          pipeline_ir_native_vector_data_facts_for_blocks_from(rest, next)
        }
      }
    }
  }
}

fn pipeline_ir_native_vector_data_facts_for_blocks(blocks: IrBlockList) -> PipelineIrNativeVectorDataFacts {
  let entries = pipeline_ir_native_vector_data_facts_for_blocks_from(blocks, pipeline_ir_native_vector_data_fact_list_empty())
  pipeline_ir_native_vector_data_facts_unassigned(entries)
}

fn pipeline_ir_native_int_list_contains(list: i64, value: i64) -> i64 {
  let mut found = 0
  let n = nlist_len(list)
  let mut i = 0
  while i < n and found == 0 {
    if nlist_get(list, i) == value { found = 1 } else { i = i + 1 }
  }
  found
}

fn pipeline_ir_native_int_list_add_unique(list: i64, value: i64) -> i64 {
  if value < 0 { 0 }
  else { if pipeline_ir_native_int_list_contains(list, value) == 1 { 0 }
  else { nlist_add(list, value) 1 } }
}

fn pipeline_ir_native_mark_value_list(values: IrValueList, out: i64) -> i64 {
  match values {
    IrValueNil -> 0
    IrValueCons(value, rest) -> {
      pipeline_ir_native_int_list_add_unique(out, value) +
        pipeline_ir_native_mark_value_list(rest, out)
    }
  }
}

fn pipeline_ir_native_mark_record_field_values(fields: IrRecordFieldList, out: i64) -> i64 {
  match fields {
    IrRecordFieldNil -> 0
    IrRecordFieldCons(field_hash, word_offset, value, rest) -> {
      pipeline_ir_native_int_list_add_unique(out, value) +
        pipeline_ir_native_mark_record_field_values(rest, out)
    }
  }
}

fn pipeline_ir_native_mark_record_layout_field_values(fields: IrRecordLayoutFieldList, out: i64) -> i64 {
  match fields {
    IrRecordLayoutFieldNil -> 0
    IrRecordLayoutFieldWord(field_hash, byte_offset, value, managed_kind, rest) -> {
      pipeline_ir_native_int_list_add_unique(out, value) + pipeline_ir_native_mark_record_layout_field_values(rest, out)
    }
    IrRecordLayoutFieldArray(field_hash, byte_offset, data, byte_size, leaf_count, leaf_stride, leaf_kind, rest) -> {
      pipeline_ir_native_int_list_add_unique(out, data) + pipeline_ir_native_mark_record_layout_field_values(rest, out)
    }
  }
}

fn pipeline_ir_native_mark_lambda_captures(captures: i64, out: i64) -> i64 {
  let mut i = 0
  let n = if captures == 0 { 0 } else { nlist_len(captures) }
  while i < n {
    let capture = nlist_get(captures, i)
    let lanes = pipeline_capture_lane_count(capture)
    for lane in 0..lanes {
      pipeline_ir_native_int_list_add_unique(out, node_f3(capture) + lane)
    }
    i = i + 1
  }
  0
}

fn pipeline_ir_native_f64_facts(values: i64, slot_candidates: i64, gpr_values: i64, slot_homes: PipelineIrNativeF64SlotHomeList) -> PipelineIrNativeF64Facts {
  PipelineIrNativeF64Facts(values, slot_candidates, gpr_values, slot_homes)
}

fn pipeline_ir_native_f64_facts_values(facts: PipelineIrNativeF64Facts) -> i64 {
  match facts {
    PipelineIrNativeF64Facts(values, slot_candidates, gpr_values, slot_homes) -> values
  }
}

fn pipeline_ir_native_f64_facts_slot_candidates(facts: PipelineIrNativeF64Facts) -> i64 {
  match facts {
    PipelineIrNativeF64Facts(values, slot_candidates, gpr_values, slot_homes) -> slot_candidates
  }
}

fn pipeline_ir_native_f64_facts_gpr_values(facts: PipelineIrNativeF64Facts) -> i64 {
  match facts {
    PipelineIrNativeF64Facts(values, slot_candidates, gpr_values, slot_homes) -> gpr_values
  }
}

fn pipeline_ir_native_f64_facts_slot_homes(facts: PipelineIrNativeF64Facts) -> PipelineIrNativeF64SlotHomeList {
  match facts {
    PipelineIrNativeF64Facts(values, slot_candidates, gpr_values, slot_homes) -> slot_homes
  }
}

-- Constants are flavor-neutral: a const takes its flavor from each
-- consumer (an f64 use pays the fmov staging either way), and with
-- same-value const dedup one const inst can seed both an f64
-- accumulator and an integer loop variable — letting it carry or
-- receive f64-ness through stores would infect integer slots with FP
-- staging. Genuine f64 slots still infer through their non-const
-- stores (accumulator updates are float-binary results).
fn pipeline_ir_native_f64_value_pass_inst(inst: IrInst, f64_values: i64, f64_slots: i64, const_dsts: i64) -> i64 {
  match inst {
    IrFloatBinaryI64(dst, prim, op, lhs, rhs) -> {
      if prim == PRIM_F64() {
        pipeline_ir_native_int_list_add_unique(f64_values, dst) +
          pipeline_ir_native_int_list_add_unique(f64_values, lhs) +
          pipeline_ir_native_int_list_add_unique(f64_values, rhs)
      } else { 0 }
    }
    IrCallI64(dst, callee_hash, args) -> {
      let kind = pipeline_ir_native_intrinsic_kind(callee_hash)
      if kind == 25 or kind == 26 or kind == 30 {
        pipeline_ir_native_int_list_add_unique(f64_values, dst)
      } else { if kind == 29 or kind == 31 {
        pipeline_ir_native_int_list_add_unique(f64_values, pipeline_ir_value_list_get_or(args, 0, 0 - 1))
      } else { if kind == 32 {
        pipeline_ir_native_int_list_add_unique(f64_values, dst) +
          pipeline_ir_native_int_list_add_unique(f64_values, pipeline_ir_value_list_get_or(args, 0, 0 - 1))
      } else { 0 } } }
    }
    IrStoreI64(slot, value) -> {
      if pipeline_ir_native_int_list_contains(const_dsts, value) == 1 { 0 }
      else {
        if pipeline_ir_native_int_list_contains(f64_values, value) == 1 {
          pipeline_ir_native_int_list_add_unique(f64_slots, slot)
        } else { if pipeline_ir_native_int_list_contains(f64_slots, slot) == 1 {
          pipeline_ir_native_int_list_add_unique(f64_values, value)
        } else { 0 } }
      }
    }
    IrLoadI64(dst, slot) -> {
      if pipeline_ir_native_int_list_contains(f64_slots, slot) == 1 {
        pipeline_ir_native_int_list_add_unique(f64_values, dst)
      } else { 0 }
    }
    _ -> 0
  }
}

fn pipeline_ir_native_f64_collect_const_dsts(blocks: IrBlockList, const_dsts: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          let mut cur = insts
          let mut done = 0
          while done == 0 {
            match cur {
              IrInstNil -> { done = 1 }
              IrInstCons(inst, irest) -> {
                match inst {
                  IrConstI64(dst, value) -> pipeline_ir_native_int_list_add_unique(const_dsts, dst)
                  IrNilI64(dst) -> pipeline_ir_native_int_list_add_unique(const_dsts, dst)
                  _ -> 0
                }
                cur = irest
              }
            }
          }
        }
      }
      pipeline_ir_native_f64_collect_const_dsts(rest, const_dsts)
    }
  }
}

fn pipeline_ir_native_f64_value_pass_insts(insts: IrInstList, f64_values: i64, f64_slots: i64, const_dsts: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      pipeline_ir_native_f64_value_pass_inst(inst, f64_values, f64_slots, const_dsts) +
        pipeline_ir_native_f64_value_pass_insts(rest, f64_values, f64_slots, const_dsts)
    }
  }
}

fn pipeline_ir_native_f64_value_pass_blocks(blocks: IrBlockList, f64_values: i64, f64_slots: i64, const_dsts: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          pipeline_ir_native_f64_value_pass_insts(insts, f64_values, f64_slots, const_dsts) +
            pipeline_ir_native_f64_value_pass_blocks(rest, f64_values, f64_slots, const_dsts)
        }
      }
    }
  }
}

fn pipeline_ir_native_f64_value_fixpoint(blocks: IrBlockList, f64_values: i64, f64_slots: i64, const_dsts: i64) -> i64 {
  let before = nlist_len(f64_values) + nlist_len(f64_slots)
  pipeline_ir_native_f64_value_pass_blocks(blocks, f64_values, f64_slots, const_dsts)
  let after = nlist_len(f64_values) + nlist_len(f64_slots)
  if after == before { after } else { pipeline_ir_native_f64_value_fixpoint(blocks, f64_values, f64_slots, const_dsts) }
}

fn pipeline_ir_native_f64_gpr_pass_inst(inst: IrInst, f64_slots: i64, gpr_values: i64) -> i64 {
  match inst {
    IrStringConcatI64(dst, left, right) -> pipeline_ir_native_int_list_add_unique(gpr_values, left) + pipeline_ir_native_int_list_add_unique(gpr_values, right)
    IrBinaryI64(dst, op, lhs, rhs) -> pipeline_ir_native_int_list_add_unique(gpr_values, lhs) + pipeline_ir_native_int_list_add_unique(gpr_values, rhs)
    IrUnaryI64(dst, op, value) -> pipeline_ir_native_int_list_add_unique(gpr_values, value)
    IrAddressOfSlotI64(dst, slot) -> 0
    IrPtrLoadI64(dst, ptr) -> pipeline_ir_native_int_list_add_unique(gpr_values, ptr)
    IrPtrStoreI64(dst, ptr, value) -> pipeline_ir_native_int_list_add_unique(gpr_values, ptr) + pipeline_ir_native_int_list_add_unique(gpr_values, value)
    IrCallI64(dst, callee_hash, args) -> pipeline_ir_native_mark_value_list(args, gpr_values)
    IrIndirectCallI64(dst, callee, args) -> pipeline_ir_native_int_list_add_unique(gpr_values, callee) + pipeline_ir_native_mark_value_list(args, gpr_values)
    IrGenericCallI64(dst, callee_hash, type_args, args) -> pipeline_ir_native_mark_value_list(args, gpr_values)
    IrVectorGetI64(dst, vec, index, fallback, check_mode) -> pipeline_ir_native_int_list_add_unique(gpr_values, vec) + pipeline_ir_native_int_list_add_unique(gpr_values, index) + pipeline_ir_native_int_list_add_unique(gpr_values, fallback)
    IrVectorSetI64(dst, vec, index, value, check_mode) -> pipeline_ir_native_int_list_add_unique(gpr_values, vec) + pipeline_ir_native_int_list_add_unique(gpr_values, index) + pipeline_ir_native_int_list_add_unique(gpr_values, value)
    IrMethodCallI64(dst, type_hash, method_hash, receiver, args) -> pipeline_ir_native_int_list_add_unique(gpr_values, receiver) + pipeline_ir_native_mark_value_list(args, gpr_values)
    IrOwnedDropI64(value, type_hash) -> pipeline_ir_native_int_list_add_unique(gpr_values, value)
    IrArrayCopyI64(dst_data, src_data, byte_size, leaf_count, leaf_stride, leaf_kind) -> pipeline_ir_native_int_list_add_unique(gpr_values, dst_data) + pipeline_ir_native_int_list_add_unique(gpr_values, src_data)
    IrArrayDropI64(data, leaf_count, leaf_stride, leaf_kind) -> pipeline_ir_native_int_list_add_unique(gpr_values, data)
    IrVariantInitI64(dst, tag_hash, args, field_mask) -> pipeline_ir_native_mark_value_list(args, gpr_values)
    IrVariantTagI64(dst, value) -> pipeline_ir_native_int_list_add_unique(gpr_values, value)
    IrVariantPayloadI64(dst, value, index) -> pipeline_ir_native_int_list_add_unique(gpr_values, value)
    IrRecordInitI64(dst, type_hash, fields) -> pipeline_ir_native_mark_record_field_values(fields, gpr_values)
    IrRecordLayoutInitI64(dst, type_hash, data_size, align, fields) -> pipeline_ir_native_mark_record_layout_field_values(fields, gpr_values)
    IrRecordLayoutArrayLoadI64(dst_data, base, record_data_size, byte_offset, byte_size, leaf_count, leaf_stride, leaf_kind) -> pipeline_ir_native_int_list_add_unique(gpr_values, dst_data) + pipeline_ir_native_int_list_add_unique(gpr_values, base)
    IrRecordLayoutWordLoadI64(dst, base, record_data_size, field_hash, byte_offset) -> pipeline_ir_native_int_list_add_unique(gpr_values, base)
    IrFieldLoadI64(dst, base, field_hash, field_index) -> pipeline_ir_native_int_list_add_unique(gpr_values, base)
    IrResumeI64(dst, value) -> pipeline_ir_native_int_list_add_unique(gpr_values, value)
    IrTryI64(dst, value, effect_key) -> pipeline_ir_native_int_list_add_unique(gpr_values, value)
    IrOptChainI64(dst, base, field_hash, field_index, effect_key) -> pipeline_ir_native_int_list_add_unique(gpr_values, base)
    IrClosureI64(dst, f, captures, eff) -> pipeline_ir_native_mark_lambda_captures(captures, gpr_values)
    IrFunctionRefI64(dst, callee_hash) -> 0
    IrGenericFunctionRefI64(dst, callee_hash, type_args) -> 0
    IrStoreI64(slot, value) -> {
      if pipeline_ir_native_int_list_contains(f64_slots, slot) == 1 { 0 }
      else { pipeline_ir_native_int_list_add_unique(gpr_values, value) }
    }
    _ -> 0
  }
}

fn pipeline_ir_native_f64_gpr_pass_insts(insts: IrInstList, f64_slots: i64, gpr_values: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      pipeline_ir_native_f64_gpr_pass_inst(inst, f64_slots, gpr_values) +
        pipeline_ir_native_f64_gpr_pass_insts(rest, f64_slots, gpr_values)
    }
  }
}

fn pipeline_ir_native_f64_gpr_pass_term(term: IrTerminator, gpr_values: i64) -> i64 {
  match term {
    IrTermReturn(value) -> pipeline_ir_native_int_list_add_unique(gpr_values, value)
    IrTermJump(target, args) -> pipeline_ir_native_mark_value_list(args, gpr_values)
    IrTermBranch(cond, then_block, else_block) -> pipeline_ir_native_int_list_add_unique(gpr_values, cond)
    _ -> 0
  }
}

fn pipeline_ir_native_f64_gpr_pass_blocks(blocks: IrBlockList, f64_slots: i64, gpr_values: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          pipeline_ir_native_f64_gpr_pass_insts(insts, f64_slots, gpr_values) +
            pipeline_ir_native_f64_gpr_pass_term(term, gpr_values) +
            pipeline_ir_native_f64_gpr_pass_blocks(rest, f64_slots, gpr_values)
        }
      }
    }
  }
}

fn pipeline_ir_native_f64_facts_for_blocks(blocks: IrBlockList) -> PipelineIrNativeF64Facts {
  let values = nlist_new()
  let slots = nlist_new()
  let const_dsts = nlist_new()
  pipeline_ir_native_f64_collect_const_dsts(blocks, const_dsts)
  pipeline_ir_native_f64_value_fixpoint(blocks, values, slots, const_dsts)
  let gpr_values = nlist_new()
  pipeline_ir_native_f64_gpr_pass_blocks(blocks, slots, gpr_values)
  pipeline_ir_native_f64_facts(values, slots, gpr_values, PipelineIrNativeF64SlotHomeNil)
}

fn pipeline_ir_native_f64_slot_max_count() -> i64 { 8 }

fn pipeline_ir_native_f64_slot_phys_for_index(index: i64) -> i64 {
  let phys = cg_preserved_f64_fp_min() + index
  if phys <= cg_preserved_f64_fp_max() { phys } else { 0 - 1 }
}

fn pipeline_ir_native_f64_slot_home_lookup_list(homes: PipelineIrNativeF64SlotHomeList, slot: i64) -> i64 {
  match homes {
    PipelineIrNativeF64SlotHomeNil -> 0 - 1
    PipelineIrNativeF64SlotHomeCons(fact_slot, fd, rest) -> {
      if fact_slot == slot { fd } else { pipeline_ir_native_f64_slot_home_lookup_list(rest, slot) }
    }
  }
}

fn pipeline_ir_native_f64_slot_home_lookup(facts: PipelineIrNativeF64Facts, slot: i64) -> i64 {
  pipeline_ir_native_f64_slot_home_lookup_list(pipeline_ir_native_f64_facts_slot_homes(facts), slot)
}

fn pipeline_ir_native_f64_slot_home_count_list(homes: PipelineIrNativeF64SlotHomeList) -> i64 {
  match homes {
    PipelineIrNativeF64SlotHomeNil -> 0
    PipelineIrNativeF64SlotHomeCons(slot, fd, rest) -> 1 + pipeline_ir_native_f64_slot_home_count_list(rest)
  }
}

fn pipeline_ir_native_f64_slot_home_count(facts: PipelineIrNativeF64Facts) -> i64 {
  pipeline_ir_native_f64_slot_home_count_list(pipeline_ir_native_f64_facts_slot_homes(facts))
}

fn pipeline_ir_native_f64_slot_home_add(homes: PipelineIrNativeF64SlotHomeList, slot: i64) -> PipelineIrNativeF64SlotHomeList {
  if pipeline_ir_native_f64_slot_home_lookup_list(homes, slot) >= 0 { homes }
  else {
    let count = pipeline_ir_native_f64_slot_home_count_list(homes)
    if count >= pipeline_ir_native_f64_slot_max_count() { homes }
    else {
      let fd = pipeline_ir_native_f64_slot_phys_for_index(count)
      if fd < 0 { homes } else { PipelineIrNativeF64SlotHomeCons(slot, fd, homes) }
    }
  }
}

fn pipeline_ir_native_f64_assign_slot_homes_inner(blocks: IrBlockList, candidates: i64, index: i64, homes: PipelineIrNativeF64SlotHomeList) -> PipelineIrNativeF64SlotHomeList {
  let n = nlist_len(candidates)
  if index >= n { homes }
  else {
    let slot = nlist_get(candidates, index)
    let next_homes = if pipeline_ir_native_blocks_take_slot_address(blocks, slot) == 0 and
      pipeline_ir_native_blocks_load_slot(blocks, slot) == 1 and
      pipeline_ir_native_blocks_store_slot(blocks, slot) == 1 {
      pipeline_ir_native_f64_slot_home_add(homes, slot)
    } else { homes }
    pipeline_ir_native_f64_assign_slot_homes_inner(blocks, candidates, index + 1, next_homes)
  }
}

fn pipeline_ir_native_f64_facts_assign_slot_homes(blocks: IrBlockList, facts: PipelineIrNativeF64Facts) -> PipelineIrNativeF64Facts {
  let candidates = pipeline_ir_native_f64_facts_slot_candidates(facts)
  let homes = pipeline_ir_native_f64_assign_slot_homes_inner(blocks, candidates, 0, PipelineIrNativeF64SlotHomeNil)
  pipeline_ir_native_f64_facts(pipeline_ir_native_f64_facts_values(facts), candidates, pipeline_ir_native_f64_facts_gpr_values(facts), homes)
}

fn pipeline_ir_native_fp_env_lookup(env: PipelineIrNativeFpEnv, value: i64, prim: i64) -> i64 {
  match env {
    PipelineIrNativeFpEnvNil -> 0 - 1
    PipelineIrNativeFpEnvCons(entry_value, entry_prim, entry_fd, rest) -> {
      if entry_value == value and entry_prim == prim { entry_fd }
      else { pipeline_ir_native_fp_env_lookup(rest, value, prim) }
    }
  }
}

fn pipeline_ir_native_float_result_env(dst: i64, prim: i64, op: IrBinaryOp) -> PipelineIrNativeFpEnv {
  match op {
    IrAdd -> pipeline_ir_native_fp_env_single(dst, prim, 0)
    IrSub -> pipeline_ir_native_fp_env_single(dst, prim, 0)
    IrMul -> pipeline_ir_native_fp_env_single(dst, prim, 0)
    IrDiv -> pipeline_ir_native_fp_env_single(dst, prim, 0)
    _ -> pipeline_ir_native_fp_env_empty()
  }
}

fn pipeline_ir_native_emit_f64_to(code: i64, dst_fd: i64, pinned: PipelineIrNativeValueHomeFacts, fp_env: PipelineIrNativeFpEnv, value: i64) -> i64 {
  let res_fd = pipeline_ir_native_fp_resident_fd(pinned, value)
  if res_fd != 0 {
    if res_fd == dst_fd { 0 } else { bu32(code, encode_fmov_d_from_d(dst_fd, res_fd)) }
  } else {
    let found = pipeline_ir_native_fp_env_lookup(fp_env, value, PRIM_F64())
    if found >= 0 {
      if found == dst_fd { 0 } else { bu32(code, encode_fmov_d_from_d(dst_fd, found)) }
    } else {
      let lp = pipeline_ir_native_load_reg(code, pinned, value)
      bu32(code, encode_fmov_d_from_x(dst_fd, lp))
    }
  }
}

fn pipeline_ir_native_emit_f32_to(code: i64, dst_fd: i64, pinned: PipelineIrNativeValueHomeFacts, fp_env: PipelineIrNativeFpEnv, value: i64) -> i64 {
  let found = pipeline_ir_native_fp_env_lookup(fp_env, value, PRIM_F32())
  if found >= 0 {
    if found == dst_fd { 0 } else { bu32(code, encode_fmov_s_from_s(dst_fd, found)) }
  } else {
    let lp = pipeline_ir_native_load_reg(code, pinned, value)
    bu32(code, encode_fmov_s_from_w(dst_fd, lp))
  }
}

fn pipeline_ir_native_record_float_result(code: i64, dst: i64, prim: i64, op: IrBinaryOp, fp_env: PipelineIrNativeFpEnv) -> PipelineIrNativeFpEnv {
  pipeline_ir_native_float_result_env(dst, prim, op)
}

fn pipeline_ir_native_emit_stack_slot_addr(code: i64, dst_phys: i64, slot: i64) -> i64 {
  if slot < 8 {
    bu32(code, encode_brk(19))
  } else {
    let byte_off = (slot - 8) * 8
    if byte_off <= 4095 {
      bu32(code, encode_add_imm(dst_phys, 31, byte_off))
    } else {
      emit_mov_imm_safe(code, dst_phys, byte_off)
      bu32(code, encode_add_reg(dst_phys, 31, dst_phys))
    }
  }
}

fn pipeline_ir_native_emit_address_of_slot(code: i64, dst: i64, slot: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  pipeline_ir_native_emit_stack_slot_addr(code, 17, slot)
  pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17)
  fmap_inc_typed_address_of_emit_count(fm)
}

fn pipeline_ir_native_emit_ptr_load(code: i64, dst: i64, ptr: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let ptr_phys = pipeline_ir_native_load_reg(code, pinned, ptr)
  bu32(code, cg_ldr(17, ptr_phys, 0))
  pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17)
  fmap_inc_typed_deref_emit_count(fm)
}

fn pipeline_ir_native_emit_ptr_store(code: i64, dst: i64, ptr: i64, value: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let value_phys = pipeline_ir_native_load_reg(code, pinned, value)
  if value_phys == 17 { 0 } else { bu32(code, encode_add_imm(17, value_phys, 0)) }
  let ptr_phys = pipeline_ir_native_load_reg(code, pinned, ptr)
  bu32(code, cg_str(17, ptr_phys, 0))
  emit_mov_imm_safe(code, 17, 0)
  pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17)
  fmap_inc_typed_ptr_assign_emit_count(fm)
}

-- Direct destination register for a result: the assigned physical home or
-- x17 for spill/discard homes (which then go through the store/forward
-- path). Result-producing single-destination
-- sequences may write their home directly and skip the x17 bounce; the
-- destination never aliases an operand source because SSA destinations are
-- fresh and operand loads use x16/x17/pinned regs, not unwritten bank homes.
fn pipeline_ir_native_result_reg(dst: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let pinned_phys = pipeline_ir_native_value_home_lookup(pinned, dst)
  if pinned_phys >= 1000 { 17 }
  else { if pinned_phys < 0 { 17 }
  else { if pinned_phys == pipeline_ir_native_discard_home() { 17 }
  else { if pinned_phys != 0 { pinned_phys } else { 17 } } } }
}

fn pipeline_ir_native_emit_const(code: i64, dst: i64, value: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  -- A remat-homed constant emits nothing at its def: every use
  -- re-materializes it and the home is never read.
  if dst >= 0 and pipeline_ir_native_value_home_lookup(pinned, dst) >= pipeline_ir_native_remat_base() { 0 }
  else {
    let rd = pipeline_ir_native_result_reg(dst, pinned)
    emit_mov_imm_safe(code, rd, value)
    if rd == 17 {
      if dst >= 0 { pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17) } else { 0 }
    } else { pipeline_ir_native_ck_def(code, pinned, rd, dst) }
  }
}

fn pipeline_ir_native_emit_binary(code: i64, dst: i64, op: IrBinaryOp, lhs: i64, rhs: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  -- Capture the forward before any operand load emits code. The spill loads
  -- use x16 for lhs, so a value forwarded in x17 survives the other
  -- operand's load regardless of which side it feeds.
  let fwd_l = pipeline_ir_native_forward_hit(pinned, code, lhs)
  let fwd_r = if fwd_l != 0 { 0 } else { pipeline_ir_native_forward_hit(pinned, code, rhs) }
  let lp = if fwd_l != 0 { fwd_l } else { pipeline_ir_native_load_reg(code, pinned, lhs) }
  let rp = if fwd_r != 0 { fwd_r } else { if fwd_l != 0 and rhs == lhs { fwd_l } else { if fwd_l != 0 { pipeline_ir_native_load_reg(code, pinned, rhs) } else { pipeline_ir_native_load_rhs(code, pinned, rhs) } } }
  let rd = pipeline_ir_native_result_reg(dst, pinned)
  cg_binop_emit(code, ir_binary_op_tag(op), rd, lp, rp)
  if rd == 17 { pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17) } else { pipeline_ir_native_ck_def(code, pinned, rd, dst) }
}

fn pipeline_ir_binary_op_result_is_operand_width(op: IrBinaryOp) -> i64 {
  match op {
    IrAdd -> 1
    IrSub -> 1
    IrMul -> 1
    IrDiv -> 1
    IrMod -> 1
    IrBand -> 1
    IrBor -> 1
    IrBxor -> 1
    IrBshl -> 1
    IrBshr -> 1
    _ -> 0
  }
}

fn pipeline_ir_native_emit_int_binary(code: i64, dst: i64, prim: i64, op: IrBinaryOp, lhs: i64, rhs: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let lp = pipeline_ir_native_load_reg(code, pinned, lhs)
  let rp = pipeline_ir_native_load_rhs(code, pinned, rhs)
  let unsigned = prim_is_unsigned_integer(prim)
  let rd = pipeline_ir_native_result_reg(dst, pinned)
  cg_binop_emit_typed(code, ir_binary_op_tag(op), rd, lp, rp, unsigned)
  if pipeline_ir_binary_op_result_is_operand_width(op) == 1 {
    cg_emit_int_normalize(code, prim, rd)
  } else {
    0
  }
  if rd == 17 { pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17) } else { pipeline_ir_native_ck_def(code, pinned, rd, dst) }
}

fn pipeline_ir_native_emit_float_binary(code: i64, dst: i64, prim: i64, op: IrBinaryOp, lhs: i64, rhs: i64, pinned: PipelineIrNativeValueHomeFacts, fp_env: PipelineIrNativeFpEnv) -> PipelineIrNativeFpEnv {
  let op_tag = ir_binary_op_tag(op)
  if prim_is_integer(prim) == 1 {
    pipeline_ir_native_emit_int_binary(code, dst, prim, op, lhs, rhs, pinned)
    fp_env
  } else { if prim == PRIM_F32() {
    pipeline_ir_native_emit_f32_to(code, 1, pinned, fp_env, rhs)
    pipeline_ir_native_emit_f32_to(code, 0, pinned, fp_env, lhs)
    match op {
      IrAdd -> {
        bu32(code, encode_fadd_s(0, 0, 1))
        bu32(code, encode_fmov_w_from_s(17, 0))
        pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17)
        pipeline_ir_native_record_float_result(code, dst, prim, op, fp_env)
      }
      IrSub -> {
        bu32(code, encode_fsub_s(0, 0, 1))
        bu32(code, encode_fmov_w_from_s(17, 0))
        pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17)
        pipeline_ir_native_record_float_result(code, dst, prim, op, fp_env)
      }
      IrMul -> {
        bu32(code, encode_fmul_s(0, 0, 1))
        bu32(code, encode_fmov_w_from_s(17, 0))
        pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17)
        pipeline_ir_native_record_float_result(code, dst, prim, op, fp_env)
      }
      IrDiv -> {
        bu32(code, encode_fdiv_s(0, 0, 1))
        bu32(code, encode_fmov_w_from_s(17, 0))
        pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17)
        pipeline_ir_native_record_float_result(code, dst, prim, op, fp_env)
      }
      _ -> {
        bu32(code, encode_fcmp_s(0, 1))
        bu32(code, encode_cset(17, cg_cmp_cond_for_op(op_tag, 0)))
        pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17)
        pipeline_ir_native_record_float_result(code, dst, prim, op, fp_env)
      }
    }
  } else {
    -- FP-resident operands are read from their pool register directly;
    -- non-resident operands stage through d0/d1 as before. An FP-resident
    -- destination takes the arithmetic result in its pool register with no
    -- fmov/store tail, and the d0 reuse env is dropped because operand
    -- staging may have clobbered d0.
    let lhs_fd = pipeline_ir_native_fp_resident_fd(pinned, lhs)
    let rhs_fd = pipeline_ir_native_fp_resident_fd(pinned, rhs)
    if rhs_fd == 0 { pipeline_ir_native_emit_f64_to(code, 1, pinned, fp_env, rhs) } else { 0 }
    if lhs_fd == 0 { pipeline_ir_native_emit_f64_to(code, 0, pinned, fp_env, lhs) } else { 0 }
    let rn = if lhs_fd != 0 { lhs_fd } else { 0 }
    let rm = if rhs_fd != 0 { rhs_fd } else { 1 }
    let dst_fd = pipeline_ir_native_fp_resident_fd(pinned, dst)
    match op {
      IrAdd -> {
        if dst_fd != 0 {
          bu32(code, encode_fadd_d(dst_fd, rn, rm))
          pipeline_ir_native_fp_env_empty()
        } else {
          bu32(code, encode_fadd_d(0, rn, rm))
          bu32(code, encode_fmov_x_from_d(17, 0))
          pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17)
          pipeline_ir_native_record_float_result(code, dst, prim, op, fp_env)
        }
      }
      IrSub -> {
        if dst_fd != 0 {
          bu32(code, encode_fsub_d(dst_fd, rn, rm))
          pipeline_ir_native_fp_env_empty()
        } else {
          bu32(code, encode_fsub_d(0, rn, rm))
          bu32(code, encode_fmov_x_from_d(17, 0))
          pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17)
          pipeline_ir_native_record_float_result(code, dst, prim, op, fp_env)
        }
      }
      IrMul -> {
        if dst_fd != 0 {
          bu32(code, encode_fmul_d(dst_fd, rn, rm))
          pipeline_ir_native_fp_env_empty()
        } else {
          bu32(code, encode_fmul_d(0, rn, rm))
          bu32(code, encode_fmov_x_from_d(17, 0))
          pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17)
          pipeline_ir_native_record_float_result(code, dst, prim, op, fp_env)
        }
      }
      IrDiv -> {
        if dst_fd != 0 {
          bu32(code, encode_fdiv_d(dst_fd, rn, rm))
          pipeline_ir_native_fp_env_empty()
        } else {
          bu32(code, encode_fdiv_d(0, rn, rm))
          bu32(code, encode_fmov_x_from_d(17, 0))
          pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17)
          pipeline_ir_native_record_float_result(code, dst, prim, op, fp_env)
        }
      }
      _ -> {
        bu32(code, encode_fcmp_d(rn, rm))
        bu32(code, encode_cset(17, cg_cmp_cond_for_op(op_tag, 0)))
        pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17)
        pipeline_ir_native_record_float_result(code, dst, prim, op, fp_env)
      }
    }
  } }
}

fn pipeline_ir_native_emit_unary(code: i64, dst: i64, op: IrUnaryOp, value: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let vp = pipeline_ir_native_load_reg(code, pinned, value)
  match op {
    IrNot -> {
      let rd = pipeline_ir_native_result_reg(dst, pinned)
      bu32(code, encode_cmp(vp, 31))
      bu32(code, encode_cset(rd, 0))
      if rd == 17 { pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17) } else { pipeline_ir_native_ck_def(code, pinned, rd, dst) }
    }
    _ -> 0
  }
}

fn pipeline_ir_native_handler_ctx_len(ctx: PipelineNativeHandlerCtx) -> i64 {
  match ctx {
    PipelineNativeHandlerCtxNil -> 0
    PipelineNativeHandlerCtxCons(eff_hash, infos, nclauses, ops_ctr, frame_ctr, is_abortive, rest) -> 1 + pipeline_ir_native_handler_ctx_len(rest)
  }
}

fn pipeline_ir_native_handler_ctx_at(ctx: PipelineNativeHandlerCtx, depth: i64) -> PipelineNativeHandlerCtx {
  match ctx {
    PipelineNativeHandlerCtxNil -> PipelineNativeHandlerCtxNil
    PipelineNativeHandlerCtxCons(eff_hash, infos, nclauses, ops_ctr, frame_ctr, is_abortive, rest) -> {
      if depth <= 0 { ctx } else { pipeline_ir_native_handler_ctx_at(rest, depth - 1) }
    }
  }
}

fn pipeline_ir_native_hclause_infos_uncaptured(infos: i64, nclauses: i64) -> i64 {
  let mut ok = 1
  let mut i = 0
  while i < nclauses {
    let info = pipeline_word_array_get(infos, i)
    if pipeline_hclause_info_nfree(info) != 0 {
      ok = 0
      i = nclauses
    } else {
      i = i + 1
    }
  }
  ok
}

fn pipeline_ir_native_handler_ctx_uncaptured(ctx: PipelineNativeHandlerCtx) -> PipelineNativeHandlerCtx {
  match ctx {
    PipelineNativeHandlerCtxNil -> PipelineNativeHandlerCtxNil
    PipelineNativeHandlerCtxCons(eff_hash, infos, nclauses, ops_ctr, frame_ctr, is_abortive, rest) -> {
      let filtered_rest = pipeline_ir_native_handler_ctx_uncaptured(rest)
      if pipeline_ir_native_hclause_infos_uncaptured(infos, nclauses) == 1 {
        PipelineNativeHandlerCtxCons(eff_hash, infos, nclauses, ops_ctr, frame_ctr, is_abortive, filtered_rest)
      } else {
        filtered_rest
      }
    }
  }
}

-- ======================================================================
-- 4j J3: abort-cleanup descriptor facts and stack-resident shadow chain
-- ======================================================================
--
-- The 2q continuation descriptor vocabulary establishes the cleanup kinds,
-- but one captured segment cannot describe an ordinary dynamic call chain.
-- Tier-2 abort therefore uses a dedicated walk structure: one 24-byte record
-- per IR binding that owns an eventual release/Drop, stored in that native
-- function's stack frame. Records link only while an abortive handler is
-- active. Ordinary cleanup disarms the exact record; abort pops records and
-- calls their stored cleanup pointers until the handle-entry boundary.
--
-- Fact node fields: acquisition-site SSA, owned value SSA, action (release
-- hash or owned type hash), kind (1 managed release / 2 owned Drop), record
-- index. The site is the unique result SSA of the instruction that acquires
-- the obligation; this keeps two retains of the same pointer as two records.
fn pipeline_ir_abort_cleanup_managed_kind() -> i64 { 1 }
fn pipeline_ir_abort_cleanup_owned_kind() -> i64 { 2 }
fn pipeline_ir_abort_cleanup_array_kind() -> i64 { 3 }

fn pipeline_ir_abort_cleanup_inst_has_action(inst: IrInst, value: i64, action: i64, kind: i64) -> i64 {
  match inst {
    IrCallI64(dst, callee_hash, args) -> {
      if kind == pipeline_ir_abort_cleanup_managed_kind() and callee_hash == action and pipeline_ir_value_list_get_or(args, 0, 0 - 1) == value { 1 } else { 0 }
    }
    IrOwnedDropI64(drop_value, type_hash) -> {
      if kind == pipeline_ir_abort_cleanup_owned_kind() and drop_value == value and type_hash == action { 1 } else { 0 }
    }
    IrArrayDropI64(data, leaf_count, leaf_stride, leaf_kind) -> {
      if kind == pipeline_ir_abort_cleanup_array_kind() and data == value and
        pipeline_array_drop_glue_hash(leaf_count, leaf_stride, leaf_kind) == action { 1 } else { 0 }
    }
    _ -> 0
  }
}

fn pipeline_ir_abort_cleanup_inst_list_has_action(insts: IrInstList, value: i64, action: i64, kind: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      if pipeline_ir_abort_cleanup_inst_has_action(inst, value, action, kind) == 1 { 1 }
      else { pipeline_ir_abort_cleanup_inst_list_has_action(rest, value, action, kind) }
    }
  }
}

fn pipeline_ir_abort_cleanup_blocks_have_action(blocks: IrBlockList, value: i64, action: i64, kind: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          if pipeline_ir_abort_cleanup_inst_list_has_action(insts, value, action, kind) == 1 { 1 }
          else { pipeline_ir_abort_cleanup_blocks_have_action(rest, value, action, kind) }
        }
      }
    }
  }
}

fn pipeline_ir_abort_cleanup_fact_exists(facts: i64, value: i64, action: i64, kind: i64) -> i64 {
  let mut found = 0
  let n = nlist_len(facts)
  let mut i = 0
  while i < n and found == 0 {
    let fact = nlist_get(facts, i)
    if node_f1(fact) == value and node_f2(fact) == action and node_f3(fact) == kind { found = 1 }
    else { i = i + 1 }
  }
  found
}

fn pipeline_ir_abort_cleanup_is_managed_release_hash(hash: i64) -> i64 {
  if hash == pipeline_rc_default_release_hash() or hash == pipeline_closure_default_release_hash() or hash == pipeline_rc_default_weak_release_hash() { 1 } else { 0 }
}

fn pipeline_ir_abort_cleanup_is_managed_retain_hash(hash: i64) -> i64 {
  if hash == pipeline_rc_default_retain_hash() or hash == pipeline_closure_default_retain_hash() or hash == pipeline_rc_default_weak_retain_hash() { 1 } else { 0 }
}

fn pipeline_ir_abort_cleanup_release_for_retain(hash: i64) -> i64 {
  if hash == pipeline_rc_default_retain_hash() { pipeline_rc_default_release_hash() }
  else { if hash == pipeline_closure_default_retain_hash() { pipeline_closure_default_release_hash() }
  else { if hash == pipeline_rc_default_weak_retain_hash() { pipeline_rc_default_weak_release_hash() }
  else { 0 } } }
}

fn pipeline_ir_abort_cleanup_rc_alloc_hash() -> i64 {
  str_hash(__str_ptr("rc_default_alloc"), 0, __str_len("rc_default_alloc"))
}

fn pipeline_ir_abort_cleanup_add_action_fact(facts: i64, value: i64, action: i64, kind: i64) -> i64 {
  if value < 0 or action == 0 or pipeline_ir_abort_cleanup_fact_exists(facts, value, action, kind) == 1 { 0 }
  else { nlist_add(facts, node_new(0, value, action, kind, nlist_len(facts))) }
}

fn pipeline_ir_abort_cleanup_collect_inst_list(insts: IrInstList, all_blocks: IrBlockList, facts: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      match inst {
        IrCallI64(dst, callee_hash, args) -> {
          if pipeline_ir_abort_cleanup_is_managed_release_hash(callee_hash) == 1 {
            pipeline_ir_abort_cleanup_add_action_fact(facts, pipeline_ir_value_list_get_or(args, 0, 0 - 1), callee_hash, pipeline_ir_abort_cleanup_managed_kind())
          } else { 0 }
        }
        IrOwnedDropI64(value, type_hash) -> pipeline_ir_abort_cleanup_add_action_fact(facts, value, type_hash, pipeline_ir_abort_cleanup_owned_kind())
        IrArrayDropI64(data, leaf_count, leaf_stride, leaf_kind) -> {
          if pipeline_array_drop_plan_is_active(leaf_count, leaf_stride, leaf_kind) == 1 {
            pipeline_ir_abort_cleanup_add_action_fact(facts, data, pipeline_array_drop_glue_hash(leaf_count, leaf_stride, leaf_kind), pipeline_ir_abort_cleanup_array_kind())
          } else { 0 }
        }
        _ -> 0
      }
      pipeline_ir_abort_cleanup_collect_inst_list(rest, all_blocks, facts)
    }
  }
}

fn pipeline_ir_abort_cleanup_collect_blocks(blocks: IrBlockList, all_blocks: IrBlockList, facts: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> pipeline_ir_abort_cleanup_collect_inst_list(insts, all_blocks, facts)
      }
      pipeline_ir_abort_cleanup_collect_blocks(rest, all_blocks, facts)
    }
  }
}

fn pipeline_ir_abort_cleanup_acquisition_fact_exists(facts: i64, site: i64, value: i64, action: i64, kind: i64) -> i64 {
  let mut found = 0
  let n = nlist_len(facts)
  let mut i = 0
  while i < n and found == 0 {
    let fact = nlist_get(facts, i)
    if node_tag(fact) == site and node_f1(fact) == value and node_f2(fact) == action and node_f3(fact) == kind { found = 1 }
    else { i = i + 1 }
  }
  found
}

fn pipeline_ir_abort_cleanup_add_acquisition_fact(facts: i64, site: i64, value: i64, action: i64, kind: i64) -> i64 {
  if site < 0 or value < 0 or action == 0 or pipeline_ir_abort_cleanup_acquisition_fact_exists(facts, site, value, action, kind) == 1 { 0 }
  else { nlist_add(facts, node_new(site, value, action, kind, nlist_len(facts))) }
}

fn pipeline_ir_abort_cleanup_find_action_kind(actions: i64, value: i64, kind: i64) -> i64 {
  let mut found = 0
  let n = nlist_len(actions)
  let mut i = 0
  while i < n and found == 0 {
    let fact = nlist_get(actions, i)
    if node_f1(fact) == value and node_f3(fact) == kind { found = fact }
    else { i = i + 1 }
  }
  found
}

fn pipeline_ir_abort_cleanup_call_result_lane_release_hash(callee_hash: i64, fns: i64, lane: i64) -> i64 {
  if lane == 0 and (callee_hash == pipeline_ir_abort_cleanup_rc_alloc_hash() or callee_hash == pipeline_rc_array_storage_new_hash() or callee_hash == pipeline_rc_default_weak_load_hash()) {
    pipeline_rc_default_release_hash()
  } else {
    pipeline_managed_release_hash_for_kind(
      cg_managed_drop_kind_for_ty_lane(pipeline_fns_lookup_ret_type_node_by_hash(fns, callee_hash, 0), lane)
    )
  }
}

fn pipeline_ir_abort_cleanup_generic_ret_type(callee_hash: i64, type_args: TypeExprList, fns: i64) -> i64 {
  let pair = pipeline_fns_lookup_pair_by_hash(fns, callee_hash)
  if pair == 0 { 0 }
  else { cg_generic_subst_ret(node_f1(pair), type_expr_list_to_nodes(type_args)) }
}

fn pipeline_ir_abort_cleanup_ret_type_lane_release_hash(ret_ty: i64, lane: i64) -> i64 {
  pipeline_managed_release_hash_for_kind(cg_managed_drop_kind_for_ty_lane(ret_ty, lane))
}

fn pipeline_ir_abort_cleanup_collect_acquisition_inst(inst: IrInst, actions: i64, facts: i64, fns: i64) -> i64 {
  let site = pipeline_ir_inst_def_or(inst, 0 - 1)
  let owned = if site >= 0 { pipeline_ir_abort_cleanup_find_action_kind(actions, site, pipeline_ir_abort_cleanup_owned_kind()) } else { 0 }
  let managed = if site >= 0 { pipeline_ir_abort_cleanup_find_action_kind(actions, site, pipeline_ir_abort_cleanup_managed_kind()) } else { 0 }
  let array = if site >= 0 { pipeline_ir_abort_cleanup_find_action_kind(actions, site, pipeline_ir_abort_cleanup_array_kind()) } else { 0 }
  if owned != 0 {
    pipeline_ir_abort_cleanup_add_acquisition_fact(facts, site, site, node_f2(owned), pipeline_ir_abort_cleanup_owned_kind())
  } else {
    if managed != 0 {
      pipeline_ir_abort_cleanup_add_acquisition_fact(facts, site, site, node_f2(managed), pipeline_ir_abort_cleanup_managed_kind())
    } else {
      if array != 0 {
        pipeline_ir_abort_cleanup_add_acquisition_fact(facts, site, site, node_f2(array), pipeline_ir_abort_cleanup_array_kind())
      } else { 0 }
    }
  }
  match inst {
    IrCallI64(dst, callee_hash, args) -> {
      if pipeline_ir_abort_cleanup_is_managed_retain_hash(callee_hash) == 1 {
        pipeline_ir_abort_cleanup_add_acquisition_fact(
          facts,
          dst,
          pipeline_ir_value_list_get_or(args, 0, 0 - 1),
          pipeline_ir_abort_cleanup_release_for_retain(callee_hash),
          pipeline_ir_abort_cleanup_managed_kind()
        )
      } else {
        let ret_ty = pipeline_fns_lookup_ret_type_node_by_hash(fns, callee_hash, 0)
        let owned_action = cg_owned_drop_type_hash(ret_ty)
        if owned_action != 0 {
          pipeline_ir_abort_cleanup_add_acquisition_fact(facts, dst, dst, owned_action, pipeline_ir_abort_cleanup_owned_kind())
        } else {
          let release = pipeline_ir_abort_cleanup_call_result_lane_release_hash(callee_hash, fns, 0)
          if release != 0 {
            pipeline_ir_abort_cleanup_add_acquisition_fact(facts, dst, dst, release, pipeline_ir_abort_cleanup_managed_kind())
          } else { 0 }
        }
      }
    }
    IrGenericCallI64(dst, callee_hash, type_args, args) -> {
      let ret_ty = pipeline_ir_abort_cleanup_generic_ret_type(callee_hash, type_args, fns)
      let owned_action = cg_owned_drop_type_hash(ret_ty)
      if owned_action != 0 {
        pipeline_ir_abort_cleanup_add_acquisition_fact(facts, dst, dst, owned_action, pipeline_ir_abort_cleanup_owned_kind())
      } else {
        let release = pipeline_ir_abort_cleanup_ret_type_lane_release_hash(ret_ty, 0)
        if release != 0 {
          pipeline_ir_abort_cleanup_add_acquisition_fact(facts, dst, dst, release, pipeline_ir_abort_cleanup_managed_kind())
        } else { 0 }
      }
    }
    IrStringLit(dst, start, len) -> pipeline_ir_abort_cleanup_add_acquisition_fact(facts, dst, dst, pipeline_rc_default_release_hash(), pipeline_ir_abort_cleanup_managed_kind())
    IrStringConcatI64(dst, left, right) -> pipeline_ir_abort_cleanup_add_acquisition_fact(facts, dst, dst, pipeline_rc_default_release_hash(), pipeline_ir_abort_cleanup_managed_kind())
    IrClosureI64(dst, fn_value, captures, evidence) -> pipeline_ir_abort_cleanup_add_acquisition_fact(facts, dst, dst, pipeline_closure_default_release_hash(), pipeline_ir_abort_cleanup_managed_kind())
    IrVariantInitI64(dst, tag_hash, payloads, field_mask) -> {
      if owned == 0 { pipeline_ir_abort_cleanup_add_acquisition_fact(facts, dst, dst, pipeline_rc_default_release_hash(), pipeline_ir_abort_cleanup_managed_kind()) } else { 0 }
    }
    IrRecordInitI64(dst, type_hash, fields) -> {
      if owned == 0 { pipeline_ir_abort_cleanup_add_acquisition_fact(facts, dst, dst, pipeline_rc_default_release_hash(), pipeline_ir_abort_cleanup_managed_kind()) } else { 0 }
    }
    IrRecordLayoutInitI64(dst, type_hash, data_size, align, fields) -> {
      if owned == 0 { pipeline_ir_abort_cleanup_add_acquisition_fact(facts, dst, dst, pipeline_rc_default_release_hash(), pipeline_ir_abort_cleanup_managed_kind()) } else { 0 }
    }
    _ -> 0
  }
}

fn pipeline_ir_abort_cleanup_collect_acquisition_inst_list_with_call(insts: IrInstList, actions: i64, facts: i64, fns: i64, call_ret_ty: i64, call_dst: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      pipeline_ir_abort_cleanup_collect_acquisition_inst(inst, actions, facts, fns)
      match inst {
        IrCallI64(dst, callee_hash, args) -> pipeline_ir_abort_cleanup_collect_acquisition_inst_list_with_call(rest, actions, facts, fns, pipeline_fns_lookup_ret_type_node_by_hash(fns, callee_hash, 0), dst)
        IrGenericCallI64(dst, callee_hash, type_args, args) -> pipeline_ir_abort_cleanup_collect_acquisition_inst_list_with_call(rest, actions, facts, fns, pipeline_ir_abort_cleanup_generic_ret_type(callee_hash, type_args, fns), dst)
        IrCallResultLaneI64(dst, lane) -> {
          if call_ret_ty != 0 and lane > 0 and dst == call_dst + lane {
            let release = pipeline_ir_abort_cleanup_ret_type_lane_release_hash(call_ret_ty, lane)
            if release != 0 {
              pipeline_ir_abort_cleanup_add_acquisition_fact(facts, dst, dst, release, pipeline_ir_abort_cleanup_managed_kind())
            } else { 0 }
            pipeline_ir_abort_cleanup_collect_acquisition_inst_list_with_call(rest, actions, facts, fns, call_ret_ty, call_dst)
          } else {
            pipeline_ir_abort_cleanup_collect_acquisition_inst_list_with_call(rest, actions, facts, fns, 0, 0 - 1)
          }
        }
        _ -> pipeline_ir_abort_cleanup_collect_acquisition_inst_list_with_call(rest, actions, facts, fns, 0, 0 - 1)
      }
    }
  }
}

fn pipeline_ir_abort_cleanup_collect_acquisition_inst_list(insts: IrInstList, actions: i64, facts: i64, fns: i64) -> i64 {
  pipeline_ir_abort_cleanup_collect_acquisition_inst_list_with_call(insts, actions, facts, fns, 0, 0 - 1)
}

fn pipeline_ir_abort_cleanup_collect_acquisition_blocks(blocks: IrBlockList, actions: i64, facts: i64, fns: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> pipeline_ir_abort_cleanup_collect_acquisition_inst_list(insts, actions, facts, fns)
      }
      pipeline_ir_abort_cleanup_collect_acquisition_blocks(rest, actions, facts, fns)
    }
  }
}

fn pipeline_ir_abort_cleanup_facts_for_blocks(blocks: IrBlockList, fns: i64) -> i64 {
  let actions = nlist_new()
  pipeline_ir_abort_cleanup_collect_blocks(blocks, blocks, actions)
  let facts = nlist_new()
  pipeline_ir_abort_cleanup_collect_acquisition_blocks(blocks, actions, facts, fns)
  facts
}

fn pipeline_ir_abort_cleanup_blocks_need_instrumentation(blocks: IrBlockList, facts: i64) -> i64 {
  if facts != 0 and nlist_len(facts) > 0 { 1 }
  else {
    let actions = nlist_new()
    pipeline_ir_abort_cleanup_collect_blocks(blocks, blocks, actions)
    if nlist_len(actions) > 0 { 1 } else { 0 }
  }
}

fn pipeline_ir_abort_cleanup_frame_size(base_frame: i64, facts: i64, instrumented: i64) -> i64 {
  let n = if facts == 0 { 0 } else { nlist_len(facts) }
  if instrumented == 0 { base_frame }
  else { cg_align16(base_frame + 32 + n * handler_abort_cleanup_record_size()) }
}

fn pipeline_ir_abort_cleanup_record_offset(base: i64, fact: i64) -> i64 {
  base + 32 + node_f4(fact) * handler_abort_cleanup_record_size()
}

fn pipeline_ir_abort_cleanup_expected_value_offset(base: i64) -> i64 { base + 8 }
fn pipeline_ir_abort_cleanup_expected_action_offset(base: i64) -> i64 { base + 16 }
fn pipeline_ir_abort_cleanup_link_address_offset(base: i64) -> i64 { base + 24 }

fn pipeline_ir_abort_cleanup_emit_sp_address(code: i64, dst: i64, byte_off: i64) -> i64 {
  emit_stack_address_offset(code, dst, byte_off)
}

fn pipeline_ir_abort_cleanup_emit_function_address(code: i64, target: i64, patch_key: i64, available: i64, fm: i64) -> i64 {
  let direct_off = target - buf_len(code)
  if target > 1 and pipeline_ir_native_adr_offset_fits(direct_off) == 1 {
    let adr_pos = buf_len(code)
    bu32(code, encode_adr(17, target - adr_pos))
  } else {
    -- Adjacent B thunk gives ADR a fixed in-range target and lets the shared
    -- hash patcher resolve forward or distant cleanup functions.
    bu32(code, encode_b(8))
    let thunk = buf_len(code)
    if target > 1 {
      bu32(code, encode_b(target - thunk))
    } else {
      if available == 1 {
        fmap_add_branch_patch_by_hash(fm, thunk, patch_key)
        bu32(code, encode_b(0))
      } else {
        bu32(code, encode_brk(27))
      }
    }
    let adr_pos = buf_len(code)
    bu32(code, encode_adr(17, thunk - adr_pos))
  }
}

fn pipeline_ir_abort_cleanup_emit_action_address(code: i64, fact: i64, fm: i64) -> i64 {
  let action = node_f2(fact)
  let kind = node_f3(fact)
  if kind == pipeline_ir_abort_cleanup_managed_kind() {
    let mono_target = mono_cache_lookup(fmap_mono_cache(fm), action)
    let target = if mono_target > 1 { mono_target } else { fmap_lookup_by_hash(fm, action) }
    let available = if mono_target != 0 or fmap_contains_hash(fm, action) == 1 { 1 } else { 0 }
    pipeline_ir_abort_cleanup_emit_function_address(code, target, action, available, fm)
  } else {
    if kind == pipeline_ir_abort_cleanup_array_kind() {
      -- The plan-specific glue may be emitted later in this function. Its
      -- synthetic mono-cache key deliberately permits this forward ADR.
      let target = mono_cache_lookup(fmap_mono_cache(fm), action)
      pipeline_ir_abort_cleanup_emit_function_address(code, if target > 1 { target } else { 0 }, action, 1, fm)
    } else {
      let method_hash = cg_drop_method_hash()
      let mm = fmap_mmap(fm)
      let target = mmap_lookup(mm, action, method_hash)
      let patch_key = pipeline_ir_native_method_forward_key(mm, action, method_hash, 0)
      let available = if target > 0 or (patch_key != 0 and mono_cache_lookup(fmap_mono_cache(fm), patch_key) != 0) { 1 } else { 0 }
      pipeline_ir_abort_cleanup_emit_function_address(code, target, patch_key, available, fm)
    }
  }
}

fn pipeline_ir_abort_cleanup_emit_function_entry(code: i64, fm: i64) -> i64 {
  let facts = fmap_current_abort_cleanup_facts(fm)
  if facts == 0 or nlist_len(facts) == 0 { 0 }
  else {
    bu32(code, cg_ldr(15, 28, runtime_state_abort_cleanup_active_offset()))
    let inactive = buf_len(code)
    bu32(code, 0)
    bu32(code, cg_ldr(16, 28, runtime_state_abort_cleanup_top_offset()))
    emit_store_spill_offset(code, 16, fmap_current_abort_cleanup_boundary(fm))
    cg_patch_cbz(code, inactive, 15, buf_len(code))
  }
}

fn pipeline_ir_abort_cleanup_emit_function_exit(code: i64, fm: i64) -> i64 {
  let facts = fmap_current_abort_cleanup_facts(fm)
  if facts == 0 or nlist_len(facts) == 0 { 0 }
  else {
    bu32(code, cg_ldr(15, 28, runtime_state_abort_cleanup_active_offset()))
    let inactive = buf_len(code)
    bu32(code, 0)
    emit_load_spill_offset(code, 16, fmap_current_abort_cleanup_boundary(fm))
    bu32(code, cg_str(16, 28, runtime_state_abort_cleanup_top_offset()))
    cg_patch_cbz(code, inactive, 15, buf_len(code))
  }
}

fn pipeline_ir_abort_cleanup_emit_register_fact(code: i64, fact: i64, value: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  -- x1-x14 are allocator residents. Bookkeeping only reads a value's home
  -- and otherwise stays in the reserved x15-x17 scratch set.
  pipeline_ir_abort_cleanup_emit_disarm_fact(code, fact, fm)
  bu32(code, cg_ldr(15, 28, runtime_state_abort_cleanup_active_offset()))
  let inactive = buf_len(code)
  bu32(code, 0)
  pipeline_ir_abort_cleanup_emit_sp_address(code, 17, pipeline_ir_abort_cleanup_record_offset(fmap_current_abort_cleanup_base(fm), fact))
  bu32(code, cg_ldr(15, 28, runtime_state_abort_cleanup_top_offset()))
  bu32(code, cg_str(15, 17, handler_abort_cleanup_record_prev_offset()))
  if node_tag(fact) == value {
    let value_phys = pipeline_ir_native_load_reg(code, pinned, value)
    bu32(code, cg_str(value_phys, 17, handler_abort_cleanup_record_value_offset()))
  } else { 0 }
  pipeline_ir_abort_cleanup_emit_sp_address(code, 15, pipeline_ir_abort_cleanup_record_offset(fmap_current_abort_cleanup_base(fm), fact))
  pipeline_ir_abort_cleanup_emit_action_address(code, fact, fm)
  bu32(code, cg_str(17, 15, handler_abort_cleanup_record_fn_offset()))
  bu32(code, cg_str(15, 28, runtime_state_abort_cleanup_top_offset()))
  cg_patch_cbz(code, inactive, 15, buf_len(code))
}

fn pipeline_ir_abort_cleanup_emit_register_site_from(code: i64, facts: i64, site: i64, index: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  if facts == 0 or index >= nlist_len(facts) { 0 }
  else {
    let fact = nlist_get(facts, index)
    if node_tag(fact) == site { pipeline_ir_abort_cleanup_emit_register_fact(code, fact, node_f1(fact), fm, pinned) } else { 0 }
    pipeline_ir_abort_cleanup_emit_register_site_from(code, facts, site, index + 1, fm, pinned)
  }
}

fn pipeline_ir_abort_cleanup_emit_register_site(code: i64, site: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  if site < 0 { 0 }
  else { pipeline_ir_abort_cleanup_emit_register_site_from(code, fmap_current_abort_cleanup_facts(fm), site, 0, fm, pinned) }
}

-- A retain's cleanup value is an INPUT while the acquisition site is the
-- call's result SSA. Stage that input before the call, while the allocator's
-- ordinary argument liveness still guarantees its home; link the prepared
-- record only after the call returns successfully.
fn pipeline_ir_abort_cleanup_emit_prepare_site_from(code: i64, facts: i64, site: i64, index: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  if facts == 0 or index >= nlist_len(facts) { 0 }
  else {
    let fact = nlist_get(facts, index)
    if node_tag(fact) == site and node_f1(fact) != site {
      pipeline_ir_abort_cleanup_emit_sp_address(code, 17, pipeline_ir_abort_cleanup_record_offset(fmap_current_abort_cleanup_base(fm), fact))
      let value_phys = pipeline_ir_native_load_reg(code, pinned, node_f1(fact))
      bu32(code, cg_str(value_phys, 17, handler_abort_cleanup_record_value_offset()))
    } else { 0 }
    pipeline_ir_abort_cleanup_emit_prepare_site_from(code, facts, site, index + 1, fm, pinned)
  }
}

fn pipeline_ir_abort_cleanup_emit_prepare_site(code: i64, site: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  if site < 0 { 0 }
  else { pipeline_ir_abort_cleanup_emit_prepare_site_from(code, fmap_current_abort_cleanup_facts(fm), site, 0, fm, pinned) }
}

fn pipeline_ir_abort_cleanup_emit_disarm_fact(code: i64, fact: i64, fm: i64) -> i64 {
  if fact == 0 { 0 }
  else {
    bu32(code, cg_ldr(15, 28, runtime_state_abort_cleanup_active_offset()))
    let inactive = buf_len(code)
    bu32(code, 0)
    bu32(code, encode_add_imm(15, 28, runtime_state_abort_cleanup_top_offset()))
    emit_store_spill_offset(code, 15, pipeline_ir_abort_cleanup_link_address_offset(fmap_current_abort_cleanup_base(fm)))
    pipeline_ir_abort_cleanup_emit_sp_address(code, 16, pipeline_ir_abort_cleanup_record_offset(fmap_current_abort_cleanup_base(fm), fact))
    emit_store_spill_offset(code, 16, pipeline_ir_abort_cleanup_expected_value_offset(fmap_current_abort_cleanup_base(fm)))
    bu32(code, encode_add_imm(15, 28, runtime_state_abort_cleanup_top_offset()))
    bu32(code, cg_ldr(15, 15, 0))
    let scan = buf_len(code)
    bu32(code, encode_cmp(15, 31))
    let done_empty = buf_len(code)
    bu32(code, 0)
    emit_load_spill_offset(code, 16, pipeline_ir_abort_cleanup_expected_value_offset(fmap_current_abort_cleanup_base(fm)))
    bu32(code, encode_cmp(15, 16))
    let found = buf_len(code)
    bu32(code, 0)
    bu32(code, encode_add_imm(17, 15, handler_abort_cleanup_record_prev_offset()))
    emit_store_spill_offset(code, 17, pipeline_ir_abort_cleanup_link_address_offset(fmap_current_abort_cleanup_base(fm)))
    bu32(code, cg_ldr(15, 15, handler_abort_cleanup_record_prev_offset()))
    let scan_back = buf_len(code)
    bu32(code, encode_b(scan - scan_back))
    let splice = buf_len(code)
    cg_patch_b_cond(code, found, 0, splice)
    emit_load_spill_offset(code, 16, pipeline_ir_abort_cleanup_link_address_offset(fmap_current_abort_cleanup_base(fm)))
    bu32(code, cg_ldr(17, 15, handler_abort_cleanup_record_prev_offset()))
    bu32(code, cg_str(17, 16, 0))
    let done = buf_len(code)
    cg_patch_b_cond(code, done_empty, 0, done)
    cg_patch_cbz(code, inactive, 15, done)
  }
}

-- Remove one dynamic obligation matching (value, cleanup function). This is
-- deliberately a one-record operation: two retains of the same pointer are
-- two counts and two records, and one ordinary release consumes only one.
fn pipeline_ir_abort_cleanup_emit_disarm_action(code: i64, value: i64, action: i64, kind: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  if value < 0 or action == 0 { 0 }
  else {
    let value_phys = pipeline_ir_native_load_reg(code, pinned, value)
    emit_store_spill_offset(code, value_phys, pipeline_ir_abort_cleanup_expected_value_offset(fmap_current_abort_cleanup_base(fm)))
    pipeline_ir_abort_cleanup_emit_action_address(code, node_new(0, 0, action, kind, 0), fm)
    emit_store_spill_offset(code, 17, pipeline_ir_abort_cleanup_expected_action_offset(fmap_current_abort_cleanup_base(fm)))
    bu32(code, cg_ldr(15, 28, runtime_state_abort_cleanup_active_offset()))
    let inactive = buf_len(code)
    bu32(code, 0)
    bu32(code, encode_add_imm(15, 28, runtime_state_abort_cleanup_top_offset()))
    emit_store_spill_offset(code, 15, pipeline_ir_abort_cleanup_link_address_offset(fmap_current_abort_cleanup_base(fm)))
    bu32(code, cg_ldr(15, 15, 0))
    let scan = buf_len(code)
    bu32(code, encode_cmp(15, 31))
    let done_empty = buf_len(code)
    bu32(code, 0)
    emit_load_spill_offset(code, 16, pipeline_ir_abort_cleanup_expected_value_offset(fmap_current_abort_cleanup_base(fm)))
    bu32(code, cg_ldr(17, 15, handler_abort_cleanup_record_value_offset()))
    bu32(code, encode_cmp(17, 16))
    let advance_value = buf_len(code)
    bu32(code, 0)
    emit_load_spill_offset(code, 16, pipeline_ir_abort_cleanup_expected_action_offset(fmap_current_abort_cleanup_base(fm)))
    bu32(code, cg_ldr(17, 15, handler_abort_cleanup_record_fn_offset()))
    bu32(code, encode_cmp(17, 16))
    let found = buf_len(code)
    bu32(code, 0)
    let advance = buf_len(code)
    cg_patch_b_cond(code, advance_value, 1, advance)
    bu32(code, encode_add_imm(17, 15, handler_abort_cleanup_record_prev_offset()))
    emit_store_spill_offset(code, 17, pipeline_ir_abort_cleanup_link_address_offset(fmap_current_abort_cleanup_base(fm)))
    bu32(code, cg_ldr(15, 15, handler_abort_cleanup_record_prev_offset()))
    let scan_back = buf_len(code)
    bu32(code, encode_b(scan - scan_back))
    let splice = buf_len(code)
    cg_patch_b_cond(code, found, 0, splice)
    emit_load_spill_offset(code, 16, pipeline_ir_abort_cleanup_link_address_offset(fmap_current_abort_cleanup_base(fm)))
    bu32(code, cg_ldr(17, 15, handler_abort_cleanup_record_prev_offset()))
    bu32(code, cg_str(17, 16, 0))
    let done = buf_len(code)
    cg_patch_b_cond(code, done_empty, 0, done)
    cg_patch_cbz(code, inactive, 15, done)
  }
}

fn pipeline_ir_abort_cleanup_emit_disarm_managed(code: i64, value: i64, callee_hash: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  if pipeline_ir_abort_cleanup_is_managed_release_hash(callee_hash) == 1 {
    pipeline_ir_abort_cleanup_emit_disarm_action(code, value, callee_hash, pipeline_ir_abort_cleanup_managed_kind(), fm, pinned)
  } else { 0 }
}

fn pipeline_ir_abort_cleanup_emit_disarm_owned(code: i64, value: i64, type_hash: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  pipeline_ir_abort_cleanup_emit_disarm_action(code, value, type_hash, pipeline_ir_abort_cleanup_owned_kind(), fm, pinned)
}

fn pipeline_ir_abort_cleanup_emit_disarm_array(code: i64, data: i64, leaf_count: i64, leaf_stride: i64, leaf_kind: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  if pipeline_array_drop_plan_is_active(leaf_count, leaf_stride, leaf_kind) == 1 {
    pipeline_ir_abort_cleanup_emit_disarm_action(code, data, pipeline_array_drop_glue_hash(leaf_count, leaf_stride, leaf_kind), pipeline_ir_abort_cleanup_array_kind(), fm, pinned)
  } else { 0 }
}

fn pipeline_ir_native_move_args(code: i64, args: IrValueList, index: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  match args {
    IrValueNil -> 0
    IrValueCons(value, rest) -> {
      let phys = pipeline_ir_native_load_reg(code, pinned, value)
      bu32(code, encode_add_imm(index + 1, phys, 0))
      pipeline_ir_native_move_args(code, rest, index + 1, pinned)
    }
  }
}

fn pipeline_ir_native_move_call_args(code: i64, args: IrValueList, index: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  match args {
    IrValueNil -> 0
    IrValueCons(value, rest) -> {
      let phys = pipeline_ir_native_load_reg(code, pinned, value)
      bu32(code, encode_add_imm(index, phys, 0))
      pipeline_ir_native_move_call_args(code, rest, index + 1, pinned)
    }
  }
}

fn pipeline_handler_clause_lowering_params(params: ParamList, expected_params: i64, index: i64, value_base: i64, locals: PipelineValueEnv) -> PipelineValueEnv {
  match params {
    ParamListNil -> locals
    ParamListCons(param, rest) -> {
      match param {
        Param(ns, nl, ty, label) -> {
          -- Clause bindings are syntactically aliases, so their parser
          -- nodes carry no useful annotation. The effect declaration is
          -- the semantic producer for their lowering type.
          let declared_type_node = type_expr_to_node(ty)
          let expected_type_node = if expected_params != 0 and index < nlist_len(expected_params) {
            node_f3(nlist_get(expected_params, index))
          } else { 0 }
          let type_node = if expected_type_node != 0 { expected_type_node } else { declared_type_node }
          let type_hash = if type_node == 0 { 0 } else { type_hash_of(type_node) }
          let float_prim = pipeline_type_node_prim_id_or(type_node, 0)
          let lanes = pipeline_type_value_lane_count_or_one(type_node)
          pipeline_handler_clause_lowering_params(rest, expected_params, index + 1, value_base + lanes, pipeline_value_env_push_float_typed_node(locals, ns, nl, value_base, float_prim, type_hash, type_node))
        }
        UnknownParam(tag) -> pipeline_handler_clause_lowering_params(rest, expected_params, index + 1, value_base + 1, locals)
      }
    }
  }
}

fn pipeline_lambda_hoist_params(params: ParamList, index: i64, value_base: i64, locals: PipelineValueEnv) -> PipelineValueEnv {
  match params {
    ParamListNil -> locals
    ParamListCons(param, rest) -> {
      match param {
        Param(ns, nl, ty, label) -> {
          let type_node = pipeline_param_type_node_default_i64(param)
          let type_hash = if type_node == 0 { 0 } else { type_hash_of(type_node) }
          let float_prim = type_expr_prim_id_or(ty, 0)
          let next_value_base = value_base + pipeline_type_value_lane_count_or_one(type_node)
          pipeline_lambda_hoist_params(rest, index + 1, next_value_base, pipeline_value_env_push_float_typed_node(locals, ns, nl, value_base, float_prim, type_hash, type_node))
        }
        UnknownParam(tag) -> pipeline_lambda_hoist_params(rest, index + 1, value_base + 1, locals)
      }
    }
  }
}

fn pipeline_ir_native_emit_hclause_loads(code: i64, nparams: i64, free_vars: i64, nfree: i64) -> i64 {
  let mut bi = 0
  while bi < nfree {
    let value_id = nparams + bi
    let dst = reg_phys(value_id)
    bu32(code, cg_ldr(dst, 0, bi * 8))
    if value_id >= 8 {
      emit_store_reg(code, value_id, dst)
    } else { 0 }
    bi = bi + 1
  }
  let mut pi = 0
  while pi < nparams {
    let value_id = nparams + nfree + pi
    emit_store_counter_from_phys(code, value_id, pi + 1)
    pi = pi + 1
  }
  0
}

fn pipeline_ir_native_emit_lambda_loads(code: i64, nparams: i64, nfree: i64) -> i64 {
  let mut bi = 0
  while bi < nfree {
    let value_id = bi
    let dst = reg_phys(value_id)
    bu32(code, cg_ldr(dst, 0, 8 + bi * 16))
    if value_id >= 8 {
      emit_store_reg(code, value_id, dst)
    } else { 0 }
    bi = bi + 1
  }
  let mut pi = 0
  while pi < nparams {
    emit_store_counter_from_phys(code, nfree + pi, pi + 1)
    pi = pi + 1
  }
  0
}

-- Tracked raw-counter read: emit_load_reg semantics (bank register or
-- canonical slot by counter id) with a ledger READ event, so handler
-- and lambda machinery consumption is verified against the store_reg
-- DEF events. Reads of cells the replay never saw defined stay BOTTOM
-- and are skipped, so instrumenting is always sound.
fn pipeline_ir_native_load_reg_raw(code: i64, facts: PipelineIrNativeValueHomeFacts, counter: i64) -> i64 {
  if counter < 8 {
    pipeline_ir_native_ck_read(code, facts, counter + 19, counter)
  } else {
    pipeline_ir_native_ck_read(code, facts, pipeline_ir_native_identity_home(counter), counter)
  }
  emit_load_reg(code, counter)
}

-- Identity-home read for above-home-count counter values. ck: records
-- the READ so scratch-counter consumption is verified against the
-- store_reg defs (this was the unrecorded-read side of the handler
-- machinery; unrecorded reads are sound but unchecked).
fn pipeline_ir_native_load_reg_temp(code: i64, facts: PipelineIrNativeValueHomeFacts, counter: i64, temp: i64) -> i64 {
  if counter < 8 {
    pipeline_ir_native_ck_read(code, facts, counter + 19, counter)
    counter + 19
  } else {
    pipeline_ir_native_ck_read(code, facts, 0 - (counter - 7), counter)
    let slot = (counter - 8) * 8
    emit_load_spill_offset(code, temp, slot)
    temp
  }
}

fn pipeline_handler_clause_local_scope_params(params: ParamList, index: i64, lambda_scope: i64) -> i64 {
  match params {
    ParamListNil -> lambda_scope
    ParamListCons(param, rest) -> {
      match param {
        Param(ns, nl, ty, label) -> pipeline_handler_clause_local_scope_params(rest, index + 1, scope_push(lambda_scope, ns, nl, index + 1))
        UnknownParam(tag) -> pipeline_handler_clause_local_scope_params(rest, index + 1, lambda_scope)
      }
    }
  }
}

fn pipeline_handler_clause_local_scope(params: ParamList, continuation: HandlerClauseContinuation) -> i64 {
  let param_scope = pipeline_handler_clause_local_scope_params(params, 0, scope_new())
  match continuation {
    HandlerClauseContinuation(ns, nl) -> scope_push(param_scope, ns, nl, cg_continuation_reg())
    _ -> param_scope
  }
}

fn pipeline_ir_native_deferred_packet_max_args() -> i64 { 7 }
fn pipeline_ir_native_deferred_packet_arg_offset() -> i64 { 32 }
fn pipeline_ir_native_deferred_packet_size() -> i64 { pipeline_ir_native_deferred_packet_arg_offset() + 7 * 8 }
-- Four fixed temporaries plus the complete x0-x7 result bank.
fn pipeline_ir_native_deferred_handle_scratch_count() -> i64 { 12 }

fn pipeline_ir_native_emit_deferred_packet_zero_args(code: i64, packet_phys: i64, index: i64) -> i64 {
  if index >= pipeline_ir_native_deferred_packet_max_args() { 0 }
  else {
    emit_mov_imm(code, 9, 0)
    bu32(code, cg_str(9, packet_phys, pipeline_ir_native_deferred_packet_arg_offset() + index * 8))
    pipeline_ir_native_emit_deferred_packet_zero_args(code, packet_phys, index + 1)
  }
}

fn pipeline_ir_native_emit_deferred_packet_args(code: i64, packet_phys: i64, args: IrValueList, index: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  if index >= pipeline_ir_native_deferred_packet_max_args() { 0 }
  else {
    match args {
      IrValueNil -> pipeline_ir_native_emit_deferred_packet_zero_args(code, packet_phys, index)
      IrValueCons(value, rest) -> {
        let phys = pipeline_ir_native_load_reg(code, pinned, value)
        bu32(code, cg_str(phys, packet_phys, pipeline_ir_native_deferred_packet_arg_offset() + index * 8))
        pipeline_ir_native_emit_deferred_packet_args(code, packet_phys, rest, index + 1, pinned)
      }
    }
  }
}

fn pipeline_ir_native_deferred_cleanup_drop_kind(kind: i64) -> i64 {
  if kind == continuation_cleanup_kind_rc() { continuation_cleanup_kind_rc_drop_only() }
  else { if kind == continuation_cleanup_kind_closure() { continuation_cleanup_kind_closure_drop_only() }
  else { if kind == continuation_cleanup_kind_weak() { continuation_cleanup_kind_weak_drop_only() }
  else { continuation_cleanup_kind_none() } } }
}

fn pipeline_ir_native_deferred_cleanup_stack_count(fm: i64) -> i64 {
  let stack = cg_cleanup_stack(fm)
  let n = nlist_len(stack)
  let mut count = 0
  let mut i = 0
  while i < n {
    let entry = nlist_get(stack, i)
    let kind = pipeline_ir_native_deferred_cleanup_drop_kind(cg_cleanup_descriptor_kind(entry))
    if kind != continuation_cleanup_kind_none() { count = count + 1 } else { 0 }
    i = i + 1
  }
  count
}

fn pipeline_ir_native_emit_deferred_capture_owner_load(code: i64, owner_reg: i64, prompt_reg: i64) -> i64 {
  emit_mov_imm(code, owner_reg, 0)
  bu32(code, cg_ldr(prompt_reg, 28, runtime_state_deferred_prompt_offset()))
  let no_prompt_pos = buf_len(code)
  bu32(code, 0)
  bu32(code, cg_ldr(owner_reg, prompt_reg, fiber_prompt_capture_owner_offset()))
  cg_patch_cbz(code, no_prompt_pos, prompt_reg, buf_len(code))
  owner_reg
}

fn pipeline_ir_native_emit_deferred_capture_owner_cleanup_entry(code: i64, desc_reg: i64, segment_reg: i64, index: i64, owner_reg: i64) -> i64 {
  bu32(code, cg_str(owner_reg, segment_reg, index * 8))
  emit_mov_imm(code, 9, continuation_cleanup_kind_closure_drop_only())
  bu32(code, cg_str(9, desc_reg, continuation_cleanup_desc_header_size() + index * continuation_cleanup_entry_size() + continuation_cleanup_entry_kind_offset()))
  emit_mov_imm(code, 9, index * 8)
  bu32(code, cg_str(9, desc_reg, continuation_cleanup_desc_header_size() + index * continuation_cleanup_entry_size() + continuation_cleanup_entry_slot_offset()))
  emit_mov_imm(code, 9, 1)
  bu32(code, cg_str(9, desc_reg, continuation_cleanup_desc_header_size() + index * continuation_cleanup_entry_size() + continuation_cleanup_entry_live_offset()))
  0
}

fn pipeline_ir_native_emit_deferred_packet_cleanup(code: i64, packet_phys: i64, fm: i64) -> i64 {
  let stack = cg_cleanup_stack(fm)
  let n = nlist_len(stack)
  let count = pipeline_ir_native_deferred_cleanup_stack_count(fm)
  if count <= 0 {
    pipeline_ir_native_emit_deferred_capture_owner_load(code, 14, 13)
    let no_cleanup_pos = buf_len(code)
    bu32(code, 0)
    cg_bump_alloc_imm(code, 10, continuation_cleanup_desc_size(1))
    emit_mov_imm(code, 9, 1)
    bu32(code, cg_str(9, 10, 0))
    cg_bump_alloc_imm(code, 12, 8)
    pipeline_ir_native_emit_deferred_capture_owner_load(code, 14, 13)
    pipeline_ir_native_emit_deferred_capture_owner_cleanup_entry(code, 10, 12, 0, 14)
    bu32(code, cg_str(10, packet_phys, 16))
    bu32(code, cg_str(12, packet_phys, 24))
    let cleanup_done_pos = buf_len(code)
    bu32(code, 0)
    let no_cleanup = buf_len(code)
    cg_patch_cbz(code, no_cleanup_pos, 14, no_cleanup)
    emit_mov_imm(code, 9, 0)
    bu32(code, cg_str(9, packet_phys, 16))
    bu32(code, cg_str(9, packet_phys, 24))
    cg_patch_b(code, cleanup_done_pos, buf_len(code))
  } else {
    cg_bump_alloc_imm(code, 10, continuation_cleanup_desc_size(count + 1))
    emit_mov_imm(code, 9, count + 1)
    bu32(code, cg_str(9, 10, 0))
    cg_bump_alloc_imm(code, 12, (count + 1) * 8)
    let mut out = 0
    let mut i = 0
    while i < n {
      let entry = nlist_get(stack, i)
      let kind = pipeline_ir_native_deferred_cleanup_drop_kind(cg_cleanup_descriptor_kind(entry))
      if kind != continuation_cleanup_kind_none() {
        let rid = node_f1(entry)
        let value_phys = emit_load_home(code, rid, 17)
        bu32(code, cg_str(value_phys, 12, out * 8))
        emit_mov_imm(code, 9, kind)
        bu32(code, cg_str(9, 10, continuation_cleanup_desc_header_size() + out * continuation_cleanup_entry_size() + continuation_cleanup_entry_kind_offset()))
        emit_mov_imm(code, 9, out * 8)
        bu32(code, cg_str(9, 10, continuation_cleanup_desc_header_size() + out * continuation_cleanup_entry_size() + continuation_cleanup_entry_slot_offset()))
        emit_mov_imm(code, 9, 1)
        bu32(code, cg_str(9, 10, continuation_cleanup_desc_header_size() + out * continuation_cleanup_entry_size() + continuation_cleanup_entry_live_offset()))
        out = out + 1
      } else { 0 }
      i = i + 1
    }
    pipeline_ir_native_emit_deferred_capture_owner_load(code, 14, 13)
    pipeline_ir_native_emit_deferred_capture_owner_cleanup_entry(code, 10, 12, out, 14)
    bu32(code, cg_str(10, packet_phys, 16))
    bu32(code, cg_str(12, packet_phys, 24))
  }
}

fn pipeline_ir_native_emit_deferred_suspend_direct(code: i64, dst: i64, entry_phys: i64, args: IrValueList, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let argc = ir_value_list_len(args)
  if argc > pipeline_ir_native_deferred_packet_max_args() {
    bu32(code, encode_brk(18))
  } else {
    cg_bump_alloc_imm(code, 15, pipeline_ir_native_deferred_packet_size())
    bu32(code, cg_str(entry_phys, 15, 0))
    emit_mov_imm(code, 9, argc)
    bu32(code, cg_str(9, 15, 8))
    pipeline_ir_native_emit_deferred_packet_cleanup(code, 15, fm)
    pipeline_ir_native_emit_deferred_packet_args(code, 15, args, 0, pinned)
    bu32(code, encode_add_imm(0, 15, 0))
    cg_emit_call_lit(code, fm, "fiber_suspend")
    pipeline_ir_native_store_reg_pinned(code, pinned, dst, 0)
  }
}

fn pipeline_ir_native_emit_deferred_suspend_dynamic(code: i64, dst: i64, entry_phys: i64, args: IrValueList, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let argc = ir_value_list_len(args)
  if argc > pipeline_ir_native_deferred_packet_max_args() {
    bu32(code, encode_brk(18))
  } else {
    pipeline_ir_native_store_reg_pinned(code, pinned, dst, entry_phys)
    cg_bump_alloc_imm(code, 15, pipeline_ir_native_deferred_packet_size())
    let saved_entry_phys = pipeline_ir_native_load_reg(code, pinned, dst)
    bu32(code, cg_str(saved_entry_phys, 15, 0))
    emit_mov_imm(code, 9, argc)
    bu32(code, cg_str(9, 15, 8))
    pipeline_ir_native_emit_deferred_packet_cleanup(code, 15, fm)
    pipeline_ir_native_emit_deferred_packet_args(code, 15, args, 0, pinned)
    bu32(code, encode_add_imm(0, 15, 0))
    cg_emit_call_lit(code, fm, "fiber_suspend")
    pipeline_ir_native_store_reg_pinned(code, pinned, dst, 0)
  }
}

fn pipeline_ir_native_emit_deferred_call_packet_regs(code: i64, packet_reg: i64, ops_reg: i64) -> i64 {
  bu32(code, cg_ldr(12, packet_reg, 0))
  bu32(code, cg_ldr(9, 12, handler_ops_fn_ptr_offset()))
  bu32(code, cg_ldr(0, 12, handler_ops_env_ptr_offset()))
  bu32(code, cg_ldr(1, packet_reg, 16))
  bu32(code, cg_str(1, 28, runtime_state_deferred_cleanup_desc_offset()))
  bu32(code, cg_ldr(1, packet_reg, 24))
  bu32(code, cg_str(1, 28, runtime_state_deferred_cleanup_segment_offset()))
  bu32(code, cg_ldr(1, packet_reg, 32))
  bu32(code, cg_ldr(2, packet_reg, 40))
  bu32(code, cg_ldr(3, packet_reg, 48))
  bu32(code, cg_ldr(4, packet_reg, 56))
  bu32(code, cg_ldr(5, packet_reg, 64))
  bu32(code, cg_ldr(6, packet_reg, 72))
  bu32(code, cg_ldr(7, packet_reg, 80))
  bu32(code, encode_blr(9))
  emit_mov_imm(code, 9, 0)
  bu32(code, cg_str(9, 28, runtime_state_deferred_cleanup_desc_offset()))
  bu32(code, cg_str(9, 28, runtime_state_deferred_cleanup_segment_offset()))
}

fn pipeline_ir_native_deferred_resume_context_size() -> i64 { 56 }
fn pipeline_ir_native_deferred_resume_context_cleanup_desc_offset() -> i64 { 40 }
fn pipeline_ir_native_deferred_resume_context_cleanup_segment_offset() -> i64 { 48 }

fn pipeline_ir_native_save_deferred_runtime_state_to_reg(code: i64, ctx_reg: i64) -> i64 {
  cg_bump_alloc_imm(code, ctx_reg, pipeline_ir_native_deferred_resume_context_size())
  bu32(code, cg_ldr(9, 28, runtime_state_deferred_ops_offset()))
  bu32(code, cg_str(9, ctx_reg, deferred_runtime_context_ops_offset()))
  bu32(code, cg_ldr(9, 28, runtime_state_deferred_prompt_offset()))
  bu32(code, cg_str(9, ctx_reg, deferred_runtime_context_prompt_offset()))
  bu32(code, cg_ldr(9, 28, runtime_state_deferred_effect_hash_offset()))
  bu32(code, cg_str(9, ctx_reg, deferred_runtime_context_effect_hash_offset()))
  bu32(code, cg_ldr(9, 28, runtime_state_deferred_op_count_offset()))
  bu32(code, cg_str(9, ctx_reg, deferred_runtime_context_op_count_offset()))
  bu32(code, cg_ldr(9, 28, runtime_state_deferred_prev_offset()))
  bu32(code, cg_str(9, ctx_reg, deferred_runtime_context_prev_offset()))
  bu32(code, cg_ldr(9, 28, runtime_state_deferred_cleanup_desc_offset()))
  bu32(code, cg_str(9, ctx_reg, pipeline_ir_native_deferred_resume_context_cleanup_desc_offset()))
  bu32(code, cg_ldr(9, 28, runtime_state_deferred_cleanup_segment_offset()))
  bu32(code, cg_str(9, ctx_reg, pipeline_ir_native_deferred_resume_context_cleanup_segment_offset()))
}

fn pipeline_ir_native_restore_deferred_runtime_state_from_reg(code: i64, ctx_reg: i64) -> i64 {
  bu32(code, cg_ldr(9, ctx_reg, deferred_runtime_context_ops_offset()))
  bu32(code, cg_str(9, 28, runtime_state_deferred_ops_offset()))
  bu32(code, cg_ldr(9, ctx_reg, deferred_runtime_context_prompt_offset()))
  bu32(code, cg_str(9, 28, runtime_state_deferred_prompt_offset()))
  bu32(code, cg_ldr(9, ctx_reg, deferred_runtime_context_effect_hash_offset()))
  bu32(code, cg_str(9, 28, runtime_state_deferred_effect_hash_offset()))
  bu32(code, cg_ldr(9, ctx_reg, deferred_runtime_context_op_count_offset()))
  bu32(code, cg_str(9, 28, runtime_state_deferred_op_count_offset()))
  bu32(code, cg_ldr(9, ctx_reg, deferred_runtime_context_prev_offset()))
  bu32(code, cg_str(9, 28, runtime_state_deferred_prev_offset()))
  bu32(code, cg_ldr(9, ctx_reg, pipeline_ir_native_deferred_resume_context_cleanup_desc_offset()))
  bu32(code, cg_str(9, 28, runtime_state_deferred_cleanup_desc_offset()))
  bu32(code, cg_ldr(9, ctx_reg, pipeline_ir_native_deferred_resume_context_cleanup_segment_offset()))
  bu32(code, cg_str(9, 28, runtime_state_deferred_cleanup_segment_offset()))
}

fn pipeline_ir_native_install_captured_deferred_runtime_state(code: i64, prompt_reg: i64, ops_reg: i64, effect_hash_reg: i64, op_count_reg: i64, prev_reg: i64) -> i64 {
  bu32(code, cg_str(prompt_reg, 28, runtime_state_deferred_prompt_offset()))
  bu32(code, cg_str(ops_reg, 28, runtime_state_deferred_ops_offset()))
  bu32(code, cg_str(effect_hash_reg, 28, runtime_state_deferred_effect_hash_offset()))
  bu32(code, cg_str(op_count_reg, 28, runtime_state_deferred_op_count_offset()))
  bu32(code, cg_str(prev_reg, 28, runtime_state_deferred_prev_offset()))
  emit_mov_imm(code, 9, 0)
  bu32(code, cg_str(9, 28, runtime_state_deferred_cleanup_desc_offset()))
  bu32(code, cg_str(9, 28, runtime_state_deferred_cleanup_segment_offset()))
}

fn pipeline_ir_native_store_phys_lanes(code: i64, base_reg: i64, offset: i64, value_base_reg: i64, lanes: i64) -> i64 {
  for lane in 0..lanes {
    bu32(code, cg_str(value_base_reg + lane, base_reg, offset + lane * 8))
  }
  0
}

fn pipeline_ir_native_load_phys_lanes(code: i64, base_reg: i64, offset: i64, value_base_reg: i64, lanes: i64) -> i64 {
  for lane in 0..lanes {
    bu32(code, cg_ldr(value_base_reg + lane, base_reg, offset + lane * 8))
  }
  0
}

fn pipeline_ir_native_load_resume_as_result_lanes(code: i64, env_reg: i64, resume_lanes: i64, result_lanes: i64) -> i64 {
  for lane in 0..result_lanes {
    if lane < resume_lanes {
      bu32(code, cg_ldr(lane, env_reg, 104 + lane * 8))
    } else {
      emit_mov_imm(code, lane, 0)
    }
  }
  0
}

fn pipeline_ir_native_hclause_continuation_closure_entry(code: i64, fm: i64, resume_lanes: i64, result_lanes: i64) -> i64 {
  let skip_pos = buf_len(code)
  bu32(code, 0)
  let entry = buf_len(code)
  -- This synthesized entry writes x19-x26 directly, so it must keep the
  -- full value-bank save regardless of the enclosing function's mask.
  let old_gpr_pairs = fmap_current_gpr_pairs(fm)
  fmap_set_current_gpr_pairs(fm, 4)
  emit_prologue_current(code, fm)
  bu32(code, encode_add_imm(19, 0, 0))
  pipeline_ir_native_store_phys_lanes(code, 19, 104, 1, resume_lanes)
  bu32(code, cg_ldr(20, 19, 8))
  bu32(code, cg_ldr(21, 19, 24))
  bu32(code, cg_ldr(22, 19, 40))
  bu32(code, cg_ldr(23, 19, 56))
  bu32(code, cg_ldr(24, 19, 72))
  bu32(code, cg_ldr(25, 19, 88))
  bu32(code, encode_add_imm(0, 20, 0))
  cg_emit_call_lit(code, fm, "continuation_resume_managed")
  bu32(code, encode_cmp(21, 31))
  let has_prompt_pos = buf_len(code)
  bu32(code, 0)
  pipeline_ir_native_load_resume_as_result_lanes(code, 19, resume_lanes, result_lanes)
  let done_without_restore_pos = buf_len(code)
  bu32(code, 0)
  let has_prompt = buf_len(code)
  cg_patch_b_cond(code, has_prompt_pos, 1, has_prompt)
  pipeline_ir_native_save_deferred_runtime_state_to_reg(code, 26)
  pipeline_ir_native_install_captured_deferred_runtime_state(code, 21, 22, 23, 24, 25)
  bu32(code, encode_add_imm(0, 21, 0))
  pipeline_ir_native_load_phys_lanes(code, 19, 104, 1, resume_lanes)
  cg_emit_call_lit(code, fm, "fiber_resume")
  pipeline_ir_native_store_phys_lanes(code, 19, 104, 0, result_lanes)
  bu32(code, encode_add_imm(23, 0, 0))
  cg_emit_call_lit(code, fm, "fiber_is_done")
  bu32(code, encode_cmp(0, 31))
  let suspended_pos = buf_len(code)
  bu32(code, 0)
  pipeline_ir_native_load_phys_lanes(code, 19, 104, 0, result_lanes)
  let done_from_fiber_pos = buf_len(code)
  bu32(code, 0)
  let suspended = buf_len(code)
  cg_patch_b_cond(code, suspended_pos, 0, suspended)
  pipeline_ir_native_emit_deferred_call_packet_regs(code, 23, 22)
  pipeline_ir_native_store_phys_lanes(code, 19, 104, 0, result_lanes)
  let restore = buf_len(code)
  cg_patch_b(code, done_from_fiber_pos, restore)
  pipeline_ir_native_restore_deferred_runtime_state_from_reg(code, 26)
  pipeline_ir_native_load_phys_lanes(code, 19, 104, 0, result_lanes)
  let finish = buf_len(code)
  cg_patch_b(code, done_without_restore_pos, finish)
  emit_epilogue_current(code, fm)
  fmap_set_current_gpr_pairs(fm, old_gpr_pairs)
  cg_patch_b(code, skip_pos, buf_len(code))
  entry
}

fn pipeline_ir_native_hclause_continuation_env_size(resume_lanes: i64, result_lanes: i64) -> i64 {
  104 + pipeline_ir_max_i64(resume_lanes, result_lanes) * 8
}

fn pipeline_ir_native_emit_hclause_continuation_closure(code: i64, fm: i64, token_ctr: i64, closure_ctr: i64, env_ctr: i64, has_continuation: i64, resume_lanes: i64, result_lanes: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  if has_continuation == 1 {
      let entry = pipeline_ir_native_hclause_continuation_closure_entry(code, fm, resume_lanes, result_lanes)
      cg_emit_rc_default_alloc_nozero_lit(code, fm, continuation_cleanup_kind_closure(), 16, 8)
      pipeline_ir_native_store_reg(code, pinned, closure_ctr, 0)
      cg_emit_rc_default_alloc_nozero_raw(code, fm, pipeline_ir_native_hclause_continuation_env_size(resume_lanes, result_lanes), 8)
      pipeline_ir_native_store_reg(code, pinned, env_ctr, 0)
      let env_phys = pipeline_ir_native_load_reg_temp(code, pinned, env_ctr, 16)
      emit_mov_imm(code, 9, 6)
      bu32(code, cg_str(9, env_phys, 0))
      let token_phys = pipeline_ir_native_load_reg_temp(code, pinned, token_ctr, 17)
      bu32(code, cg_str(token_phys, env_phys, 8))
      emit_mov_imm(code, 9, continuation_cleanup_kind_continuation())
      bu32(code, cg_str(9, env_phys, 16))
      bu32(code, cg_ldr(9, 28, runtime_state_deferred_prompt_offset()))
      bu32(code, cg_str(9, env_phys, 24))
      emit_mov_imm(code, 9, continuation_cleanup_kind_none())
      bu32(code, cg_str(9, env_phys, 32))
      bu32(code, cg_ldr(9, 28, runtime_state_deferred_ops_offset()))
      bu32(code, cg_str(9, env_phys, 40))
      emit_mov_imm(code, 9, continuation_cleanup_kind_none())
      bu32(code, cg_str(9, env_phys, 48))
      bu32(code, cg_ldr(9, 28, runtime_state_deferred_effect_hash_offset()))
      bu32(code, cg_str(9, env_phys, 56))
      emit_mov_imm(code, 9, continuation_cleanup_kind_none())
      bu32(code, cg_str(9, env_phys, 64))
      bu32(code, cg_ldr(9, 28, runtime_state_deferred_op_count_offset()))
      bu32(code, cg_str(9, env_phys, 72))
      emit_mov_imm(code, 9, continuation_cleanup_kind_none())
      bu32(code, cg_str(9, env_phys, 80))
      bu32(code, cg_ldr(9, 28, runtime_state_deferred_prev_offset()))
      bu32(code, cg_str(9, env_phys, 88))
      emit_mov_imm(code, 9, continuation_cleanup_kind_none())
      bu32(code, cg_str(9, env_phys, 96))
      let closure_phys = pipeline_ir_native_load_reg_temp(code, pinned, closure_ctr, 16)
      let adr_pos = buf_len(code)
      bu32(code, encode_adr(17, entry - adr_pos))
      bu32(code, cg_str(17, closure_phys, 0))
      let env_phys2 = pipeline_ir_native_load_reg_temp(code, pinned, env_ctr, 17)
      bu32(code, cg_str(env_phys2, closure_phys, 8))
      env_ctr + 1
  } else { token_ctr }
}

fn pipeline_handler_clause_locals_with_continuation(locals: PipelineValueEnv, continuation: HandlerClauseContinuation, continuation_value: i64, input_ty: i64, result_ty: i64) -> PipelineValueEnv {
  match continuation {
    HandlerClauseContinuation(ns, nl) -> {
      let input_types = nlist_new()
      nlist_add(input_types, input_ty)
      let fn_ty = ty_fn(input_types, result_ty, ty_effect_pure())
      pipeline_value_env_push_float_typed_node(locals, ns, nl, continuation_value, 0, type_hash_of(fn_ty), fn_ty)
    }
    _ -> locals
  }
}

fn pipeline_ir_native_release_hclause_continuation_closure(code: i64, fm: i64, has_continuation: i64, closure_value: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  if has_continuation == 1 {
      let closure_phys = pipeline_ir_native_load_reg(code, pinned, closure_value)
      bu32(code, encode_add_imm(0, closure_phys, 0))
      cg_emit_call_lit(code, fm, "closure_default_release")
  } else { 0 }
}

fn pipeline_typed_ffv_bind_pattern_list(patterns: PatternList, scope: i64, src: i64) -> i64 {
  match patterns {
    PatternListNil -> scope
    PatternListCons(pattern, rest) -> pipeline_typed_ffv_bind_pattern_list(rest, pipeline_typed_ffv_bind_pattern(pattern, scope, src), src)
  }
}

fn pipeline_typed_ffv_bind_pattern(pattern: Pattern, scope: i64, src: i64) -> i64 {
  match pattern {
    Binding(ns, nl) -> scope_push(scope, ns, nl, 0)
    CtorPattern(tag_ns, tag_nl, bindings) -> pipeline_typed_ffv_bind_pattern_list(bindings, scope, src)
    -- Typed binding introduces a name exactly like Binding — the free
    -- variable scan must see it or lambda capture analysis treats the
    -- name as captured from the enclosing scope.
    TypedBinding(ns, nl, ann) -> scope_push(scope, ns, nl, 0)
    _ -> scope
  }
}

fn pipeline_typed_ffv_bind_params(params: ParamList, scope: i64) -> i64 {
  match params {
    ParamListNil -> scope
    ParamListCons(param, rest) -> {
      match param {
        Param(ns, nl, ty, label) -> pipeline_typed_ffv_bind_params(rest, scope_push(scope, ns, nl, 0))
        UnknownParam(tag) -> pipeline_typed_ffv_bind_params(rest, scope)
      }
    }
  }
}

fn pipeline_typed_find_free_vars_expr_list(exprs: ExprList, local_scope: i64, enclosing_scope: i64, src: i64, free_vars: i64) -> i64 {
  match exprs {
    ExprListNil -> 0
    ExprListCons(expr, rest) -> {
      pipeline_typed_find_free_vars_expr(expr, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_expr_list(rest, local_scope, enclosing_scope, src, free_vars)
    }
  }
}

fn pipeline_typed_find_free_vars_record_fields(fields: RecordFieldList, local_scope: i64, enclosing_scope: i64, src: i64, free_vars: i64) -> i64 {
  match fields {
    RecordFieldListNil -> 0
    RecordFieldListCons(field, rest) -> {
      pipeline_typed_find_free_vars_expr(record_field_value_expr(field), local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_record_fields(rest, local_scope, enclosing_scope, src, free_vars)
    }
  }
}

fn pipeline_typed_find_free_vars_match_arms(arms: MatchArmList, local_scope: i64, enclosing_scope: i64, src: i64, free_vars: i64) -> i64 {
  match arms {
    MatchArmListNil -> 0
    MatchArmListCons(arm, rest) -> {
      let arm_scope = pipeline_typed_ffv_bind_pattern(match_arm_pattern(arm), local_scope, src)
      if match_arm_has_guard(arm) == 1 {
        pipeline_typed_find_free_vars_expr(match_arm_guard_expr(arm), arm_scope, enclosing_scope, src, free_vars)
      } else { 0 }
      pipeline_typed_find_free_vars_expr(match_arm_body_expr(arm), arm_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_match_arms(rest, local_scope, enclosing_scope, src, free_vars)
    }
  }
}

fn pipeline_typed_find_free_vars_handler_clauses(clauses: HandlerClauseList, local_scope: i64, enclosing_scope: i64, src: i64, free_vars: i64) -> i64 {
  match clauses {
    HandlerClauseListNil -> 0
    HandlerClauseListCons(clause, rest) -> {
      let clause_scope = pipeline_typed_ffv_bind_params(handler_clause_params(clause), local_scope)
      let clause_scope2 = match handler_clause_continuation(clause) {
        HandlerClauseContinuation(ns, nl) -> scope_push(clause_scope, ns, nl, 0)
        _ -> clause_scope
      }
      pipeline_typed_find_free_vars_expr(handler_clause_body_expr(clause), clause_scope2, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_handler_clauses(rest, local_scope, enclosing_scope, src, free_vars)
    }
  }
}

fn pipeline_typed_find_free_vars_expr(expr: Expr, local_scope: i64, enclosing_scope: i64, src: i64, free_vars: i64) -> i64 {
  match expr {
    Ident(ns, nl) -> ffv_add_name(ns, nl, local_scope, enclosing_scope, src, free_vars)
    BinOp(op, lhs, rhs) -> {
      pipeline_typed_find_free_vars_expr(lhs, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_expr(rhs, local_scope, enclosing_scope, src, free_vars)
    }
    Call(ns, nl, args) -> {
      ffv_add_name(ns, nl, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_expr_list(args, local_scope, enclosing_scope, src, free_vars)
    }
    GenericCall(type_args, inner_call) -> pipeline_typed_find_free_vars_expr(inner_call, local_scope, enclosing_scope, src, free_vars)
    If(cond, then_expr, else_expr) -> {
      pipeline_typed_find_free_vars_expr(cond, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_expr(then_expr, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_expr(else_expr, local_scope, enclosing_scope, src, free_vars)
    }
    While(cond, body) -> {
      pipeline_typed_find_free_vars_expr(cond, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_expr(body, local_scope, enclosing_scope, src, free_vars)
    }
    Loop(body) -> pipeline_typed_find_free_vars_expr(body, local_scope, enclosing_scope, src, free_vars)
    Break(value) -> pipeline_typed_find_free_vars_expr(value, local_scope, enclosing_scope, src, free_vars)
    Return(value) -> pipeline_typed_find_free_vars_expr(value, local_scope, enclosing_scope, src, free_vars)
    Defer(cleanup, body) -> {
      pipeline_typed_find_free_vars_expr(cleanup, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_expr(body, local_scope, enclosing_scope, src, free_vars)
    }
    Let(ns, nl, value, body) -> {
      pipeline_typed_find_free_vars_expr(value, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_expr(body, scope_push(local_scope, ns, nl, 0), enclosing_scope, src, free_vars)
    }
    LetMut(ns, nl, value, body) -> {
      pipeline_typed_find_free_vars_expr(value, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_expr(body, scope_push(local_scope, ns, nl, 0), enclosing_scope, src, free_vars)
    }
    Assign(ns, nl, value) -> {
      ffv_add_name(ns, nl, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_expr(value, local_scope, enclosing_scope, src, free_vars)
    }
    AddressOf(mutable, target) -> pipeline_typed_find_free_vars_expr(target, local_scope, enclosing_scope, src, free_vars)
    Deref(ptr) -> pipeline_typed_find_free_vars_expr(ptr, local_scope, enclosing_scope, src, free_vars)
    PtrAssign(ptr, value) -> {
      pipeline_typed_find_free_vars_expr(ptr, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_expr(value, local_scope, enclosing_scope, src, free_vars)
    }
    Block(first, rest) -> {
      pipeline_typed_find_free_vars_expr(first, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_expr(rest, local_scope, enclosing_scope, src, free_vars)
    }
    FieldAccess(base, field_ns, field_nl, fact) -> pipeline_typed_find_free_vars_expr(base, local_scope, enclosing_scope, src, free_vars)
    IndexedLen(base, fixed_len) -> pipeline_typed_find_free_vars_expr(base, local_scope, enclosing_scope, src, free_vars)
    IndexedGet(base, index, element_ty, fixed_len) -> { pipeline_typed_find_free_vars_expr(base, local_scope, enclosing_scope, src, free_vars) pipeline_typed_find_free_vars_expr(index, local_scope, enclosing_scope, src, free_vars) }
    IndexedSet(base, index, value, fact) -> { pipeline_typed_find_free_vars_expr(base, local_scope, enclosing_scope, src, free_vars) pipeline_typed_find_free_vars_expr(index, local_scope, enclosing_scope, src, free_vars) pipeline_typed_find_free_vars_expr(value, local_scope, enclosing_scope, src, free_vars) }
    IndexedSlice(base, start, end, fact) -> { pipeline_typed_find_free_vars_expr(base, local_scope, enclosing_scope, src, free_vars) pipeline_typed_find_free_vars_expr(start, local_scope, enclosing_scope, src, free_vars) pipeline_typed_find_free_vars_expr(end, local_scope, enclosing_scope, src, free_vars) }
    RecordInit(type_ns, type_nl, fields) -> pipeline_typed_find_free_vars_record_fields(fields, local_scope, enclosing_scope, src, free_vars)
    ArrayLiteral(elements, resolved_ty, span) -> pipeline_typed_find_free_vars_expr_list(elements, local_scope, enclosing_scope, src, free_vars)
    Match(scrutinee, arms) -> {
      pipeline_typed_find_free_vars_expr(scrutinee, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_match_arms(arms, local_scope, enclosing_scope, src, free_vars)
    }
    Not(operand) -> pipeline_typed_find_free_vars_expr(operand, local_scope, enclosing_scope, src, free_vars)
    Lambda(params, body) -> pipeline_typed_find_free_vars_expr(body, pipeline_typed_ffv_bind_params(params, local_scope), enclosing_scope, src, free_vars)
    Perform(lhs, op_ns, op_nl, args) -> {
      pipeline_typed_find_free_vars_expr(lhs, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_expr_list(args, local_scope, enclosing_scope, src, free_vars)
    }
    Handle(body, clauses, hret) -> {
      pipeline_typed_find_free_vars_expr(body, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_handler_clauses(clauses, local_scope, enclosing_scope, src, free_vars)
      match hret {
        NoHandleReturn -> 0
        HandleReturnClause(rns, rnl, rb) -> pipeline_typed_find_free_vars_expr(rb, local_scope, enclosing_scope, src, free_vars)
      }
    }
    Resume(value) -> pipeline_typed_find_free_vars_expr(value, local_scope, enclosing_scope, src, free_vars)
    MethodCall(recv, method_hash, args, type_hash) -> {
      pipeline_typed_find_free_vars_expr(recv, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_expr_list(args, local_scope, enclosing_scope, src, free_vars)
    }
    Try(inner, effect_atom) -> pipeline_typed_find_free_vars_expr(inner, local_scope, enclosing_scope, src, free_vars)
    InterpConcat(left, right) -> {
      pipeline_typed_find_free_vars_expr(left, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_expr(right, local_scope, enclosing_scope, src, free_vars)
    }
    ForIter(var_ns, var_nl, collection, body) -> {
      pipeline_typed_find_free_vars_expr(collection, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_expr(body, scope_push(local_scope, var_ns, var_nl, 0), enclosing_scope, src, free_vars)
    }
    OptChain(base, field_ns, field_nl, effect_atom) -> pipeline_typed_find_free_vars_expr(base, local_scope, enclosing_scope, src, free_vars)
    LetTyped(inner, ann_type) -> pipeline_typed_find_free_vars_expr(inner, local_scope, enclosing_scope, src, free_vars)
    _ -> 0
  }
}

fn pipeline_ir_native_emit_hclause_body_trap(code: i64, fm: i64) -> i64 {
  let skip_pos = buf_len(code)
  bu32(code, 0)
  let clause_start = buf_len(code)
  emit_prologue_current(code, fm)
  bu32(code, encode_brk(18))
  emit_epilogue_current(code, fm)
  cg_patch_b(code, skip_pos, buf_len(code))
  pipeline_hclause_info_new(clause_start, nlist_new(), 0)
}

fn pipeline_ir_native_hclause_capture_cleanup_kind(fm: i64, capture: i64) -> i64 {
  cg_cleanup_kind_for_rid(fm, pipeline_ir_native_identity_home(node_f3(capture)))
}

fn pipeline_ir_native_hclause_managed_capture_count(fm: i64, captures: i64) -> i64 {
  let mut count = 0
  let n = if captures == 0 { 0 } else { nlist_len(captures) }
  for i in 0..n {
    if pipeline_ir_native_hclause_capture_cleanup_kind(fm, nlist_get(captures, i)) != continuation_cleanup_kind_none() {
      count = count + 1
    } else { 0 }
  }
  count
}

fn pipeline_ir_native_emit_hclause_continuation_segment_lowered(code: i64, fm: i64, nparams: i64, captures: i64, desc_ctr: i64, segment_ctr: i64) -> i64 {
  let count = pipeline_ir_native_hclause_managed_capture_count(fm, captures)
  emit_mov_imm_safe(code, 0, count)
  cg_emit_call_lit(code, fm, "continuation_cleanup_desc_new")
  cg_hclause_store_x0(code, desc_ctr)
  emit_mov_imm_safe(code, 0, count * 8)
  cg_emit_call_lit(code, fm, "alloc_zeroed")
  cg_hclause_store_x0(code, segment_ctr)
  let mut out = 0
  let nfree = if captures == 0 { 0 } else { nlist_len(captures) }
  for i in 0..nfree {
    let capture = nlist_get(captures, i)
    let kind = pipeline_ir_native_hclause_capture_cleanup_kind(fm, capture)
    if kind != continuation_cleanup_kind_none() {
      let value_rid = pipeline_ir_native_identity_home(nparams + pipeline_capture_value_lane_offset(captures, i))
      let segment_phys = emit_load_reg(code, segment_ctr)
      let value_phys = emit_load_home(code, value_rid, 17)
      let slot = out * 8
      bu32(code, cg_str(value_phys, segment_phys, slot))
      cg_emit_managed_retain_kind_regid(code, fm, kind, value_rid)
      let desc_phys = emit_load_reg(code, desc_ctr)
      bu32(code, encode_add_imm(0, desc_phys, 0))
      emit_mov_imm_safe(code, 1, out)
      emit_mov_imm_safe(code, 2, kind)
      emit_mov_imm_safe(code, 3, slot)
      emit_mov_imm_safe(code, 4, 1)
      cg_emit_call_lit(code, fm, "continuation_cleanup_desc_set")
      out = out + 1
    } else { 0 }
  }
  out
}

fn pipeline_ir_native_emit_hclause_continuation_lowered(code: i64, fm: i64, nparams: i64, captures: i64, token_ctr: i64, segment_ctr: i64, has_continuation: i64) -> i64 {
  if has_continuation == 0 { token_ctr }
  else {
    bu32(code, cg_ldr(9, 28, runtime_state_deferred_cleanup_desc_offset()))
    bu32(code, encode_cmp(9, 31))
    let no_packet_cleanup_pos = buf_len(code)
    bu32(code, 0)
    bu32(code, encode_add_imm(0, 9, 0))
    cg_emit_call_lit(code, fm, "continuation_new_with_cleanup_desc")
    cg_hclause_store_x0(code, token_ctr)
    let packet_token_phys = emit_load_reg(code, token_ctr)
    bu32(code, encode_add_imm(0, packet_token_phys, 0))
    bu32(code, cg_ldr(9, 28, runtime_state_deferred_cleanup_segment_offset()))
    bu32(code, encode_add_imm(1, 9, 0))
    emit_mov_imm(code, 2, 0)
    emit_mov_imm(code, 3, 0)
    cg_emit_call_lit(code, fm, "continuation_set_segment")
    let done_packet_cleanup_pos = buf_len(code)
    bu32(code, 0)
    let no_packet_cleanup = buf_len(code)
    cg_patch_b_cond(code, no_packet_cleanup_pos, 0, no_packet_cleanup)
    let desc_count = pipeline_ir_native_hclause_managed_capture_count(fm, captures)
    if desc_count > 0 {
      pipeline_ir_native_emit_hclause_continuation_segment_lowered(code, fm, nparams, captures, token_ctr, segment_ctr)
      let desc_phys = emit_load_reg(code, token_ctr)
      bu32(code, encode_add_imm(0, desc_phys, 0))
      cg_emit_call_lit(code, fm, "continuation_new_with_cleanup_desc")
      cg_hclause_store_x0(code, token_ctr)
      let token_phys = emit_load_reg(code, token_ctr)
      bu32(code, encode_add_imm(0, token_phys, 0))
      let segment_phys = emit_load_reg(code, segment_ctr)
      bu32(code, encode_add_imm(1, segment_phys, 0))
      emit_mov_imm(code, 2, 0)
      emit_mov_imm(code, 3, 0)
      cg_emit_call_lit(code, fm, "continuation_set_segment")
    } else {
      cg_emit_call_lit(code, fm, "continuation_new_noop")
      cg_hclause_store_x0(code, token_ctr)
    }
    cg_patch_b(code, done_packet_cleanup_pos, buf_len(code))
    emit_mov_imm(code, 9, 0)
    bu32(code, cg_str(9, 28, runtime_state_deferred_cleanup_desc_offset()))
    bu32(code, cg_str(9, 28, runtime_state_deferred_cleanup_segment_offset()))
    token_ctr
  }
}

fn pipeline_ir_native_emit_hclause_body_ir(body: IrHandlerClauseBody, code: i64, src: i64, fm: i64, active_handlers: PipelineNativeHandlerCtx, fns: i64) -> i64 {
  match body {
    IrHandlerClauseBodyInvalid(reason) -> pipeline_ir_native_emit_hclause_body_trap(code, fm)
    IrHandlerClauseBody(op_hash, nparams, captures, has_continuation, is_abortive, result_cleanup_kind, transferred_param_value_fact, resume_lanes, result_lanes, first_value, blocks) -> {
      let nfree = pipeline_capture_value_lane_count(captures)
      let skip_pos = buf_len(code)
      bu32(code, 0)
      let clause_start = buf_len(code)
      let old_frame = fmap_current_frame_size(fm)
      let old_preserve_fp = fmap_current_preserve_fp(fm)
      let old_gpr_pairs = fmap_current_gpr_pairs(fm)
      let old_abort_cleanup_facts = fmap_current_abort_cleanup_facts(fm)
      let old_abort_cleanup_base = fmap_current_abort_cleanup_base(fm)
      let old_abort_cleanup_boundary = fmap_current_abort_cleanup_boundary(fm)
      let old_abort_cleanup_block = fmap_current_abort_cleanup_block(fm)
      let old_array_storage_facts = fmap_current_array_storage_facts(fm)
      let old_cleanup_depth = nlist_len(cg_cleanup_stack(fm))
      -- A handler clause is an out-of-line synthetic function. SSA ids in
      -- its parameter/capture ABI start again at zero and must not alias
      -- cleanup entries owned by the function whose handle emitted it.
      cg_cleanup_restore(fm, 0)
      let f64_facts = pipeline_ir_native_f64_facts_assign_slot_homes(blocks, pipeline_ir_native_f64_facts_for_blocks(blocks))
      let vector_data_facts = pipeline_ir_native_vector_data_facts_assign_home(pipeline_ir_native_vector_data_facts_for_blocks(blocks))
      let f64_slot_count = pipeline_ir_native_f64_slot_home_count(f64_facts)
      let body_max_next = pipeline_ir_function_next_value(first_value, blocks)
      let return_save = if has_continuation == 1 { body_max_next + 8 } else { body_max_next }
      let abort_frame_value = return_save + result_lanes
      let block_frame = pipeline_ir_native_scalar_frame_size_for_blocks(first_value, blocks)
      let continuation_frame = if has_continuation == 1 { pipeline_ir_native_frame_size_for_next_value(return_save + result_lanes) } else { block_frame }
      let save_frame = if is_abortive == 1 { pipeline_ir_native_frame_size_for_next_value(abort_frame_value + 1) } else { continuation_frame }
      let abort_cleanup_facts = pipeline_ir_abort_cleanup_facts_for_blocks(blocks, fns)
      let abort_cleanup_instrumented = pipeline_ir_abort_cleanup_blocks_need_instrumentation(blocks, abort_cleanup_facts)
      let array_storage_base = pipeline_ir_max_i64(block_frame, save_frame)
      let array_storage_facts = pipeline_ir_native_array_storage_facts_for_blocks(blocks, array_storage_base)
      let abort_cleanup_base = pipeline_ir_native_array_storage_frame_size(array_storage_base, array_storage_facts)
      fmap_set_current_array_storage_facts(fm, array_storage_facts)
      fmap_set_current_abort_cleanup_facts(fm, abort_cleanup_facts)
      fmap_set_current_abort_cleanup_base(fm, abort_cleanup_base)
      fmap_set_current_abort_cleanup_boundary(fm, abort_cleanup_base)
      fmap_set_current_frame_size(fm, pipeline_ir_abort_cleanup_frame_size(abort_cleanup_base, abort_cleanup_facts, abort_cleanup_instrumented))
      if f64_slot_count > 0 { fmap_set_current_preserve_fp(fm, 1) } else { 0 }
      fmap_set_current_gpr_pairs(fm, 4)
      emit_prologue_current(code, fm)
      let continuation_token_value = nparams + nfree + nparams
      let continuation_segment_value = continuation_token_value + 1
      let continuation_closure_value = continuation_token_value + 2
      let continuation_env_value = continuation_token_value + 3
      let safe_handlers = pipeline_ir_native_handler_ctx_uncaptured(active_handlers)
      let base_home_count = pipeline_ir_native_value_home_count_include_evidence(pipeline_ir_native_value_home_count_for_blocks(first_value, blocks), fm)
      let body_home_count = if is_abortive == 1 { pipeline_ir_native_value_home_count_include(base_home_count, abort_frame_value) } else { base_home_count }
      let contextual_home_count = pipeline_ir_native_value_home_count_include_handlers(body_home_count, safe_handlers)
      let pinned = pipeline_ir_native_identity_home_facts(pipeline_ir_native_value_home_count_include_handler_scratch(contextual_home_count, blocks, pipeline_ir_native_handler_ctx_len(safe_handlers)))
      -- Capture before any clause-body work can perform another effect and
      -- overwrite the shared dispatcher slot.
      if is_abortive == 1 {
        bu32(code, cg_ldr(9, 28, runtime_state_dispatch_frame_offset()))
        pipeline_ir_native_store_reg(code, pinned, abort_frame_value, 9)
      } else { 0 }
      pipeline_ir_native_emit_hclause_loads(code, nparams, captures, nfree)
      -- Boundary capture uses scratch registers, so it must follow incoming
      -- clause-parameter/capture materialisation under Weft's wide register
      -- ABI.
      pipeline_ir_abort_cleanup_emit_function_entry(code, fm)
      if has_continuation == 1 {
        pipeline_ir_native_emit_hclause_continuation_lowered(code, fm, nparams, captures, continuation_token_value, continuation_segment_value, has_continuation)
        pipeline_ir_native_emit_hclause_continuation_closure(code, fm, continuation_token_value, continuation_closure_value, continuation_env_value, has_continuation, resume_lanes, result_lanes, pinned)
      } else { 0 }
      let temp_base = body_max_next + 8
      let abort_adr_patches = nlist_new()
      let state = pipeline_ir_native_emit_blocks(blocks, blocks, code, scope_new(), src, fm, safe_handlers, fns, f64_facts, vector_data_facts, abort_adr_patches, pipeline_ir_native_cfg_state(pipeline_ir_native_label_map_empty(), 0, pinned, temp_base))
      let labels = pipeline_ir_native_label_map_add(pipeline_ir_native_cfg_state_labels(state), pipeline_ir_native_epilogue_label(), buf_len(code))
      pipeline_ir_native_patch_all(code, labels, pipeline_ir_native_cfg_state_patches(state))
      pipeline_ir_native_patch_abort_adrs(code, labels, abort_adr_patches)
      if is_abortive == 1 and result_cleanup_kind != continuation_cleanup_kind_none() {
        -- The abort walk consumes every tracked stake acquired after the
        -- handle boundary, including each result lane's original transport
        -- stake. Save the complete ABI result bank before the first retain
        -- call, create one untracked crossing stake for every managed lane,
        -- then restore every lane. These native epilogue calls sit outside
        -- the clause IR fact set, so the walk cannot consume them as well.
        for lane in 0..result_lanes {
          pipeline_ir_native_store_reg(code, pinned, return_save + lane, lane)
        }
        for lane in 0..result_lanes {
          let lane_kind = pipeline_value_lane_cleanup_mask_kind(result_cleanup_kind, lane)
          if lane_kind != continuation_cleanup_kind_none() {
            cg_emit_managed_retain_kind_regid(code, fm, lane_kind, pipeline_ir_native_identity_home(return_save + lane))
          } else { 0 }
        }
        for lane in 0..result_lanes {
          let retained_result = emit_load_reg(code, return_save + lane)
          bu32(code, encode_add_imm(lane, retained_result, 0))
        }
      } else { 0 }
      if has_continuation == 1 {
        for lane in 0..result_lanes {
          pipeline_ir_native_store_reg(code, pinned, return_save + lane, lane)
        }
        pipeline_ir_native_release_hclause_continuation_closure(code, fm, has_continuation, continuation_closure_value, pinned)
        for lane in 0..result_lanes {
          let saved_result = emit_load_reg(code, return_save + lane)
          bu32(code, encode_add_imm(lane, saved_result, 0))
        }
      } else { 0 }
      if is_abortive == 1 {
        let abort_frame_phys = pipeline_ir_native_load_reg(code, pinned, abort_frame_value)
        cg_habort_restore_and_ret(code, abort_frame_phys, 0, result_lanes)
      } else {
        pipeline_ir_abort_cleanup_emit_function_exit(code, fm)
        emit_epilogue_current(code, fm)
      }
      fmap_set_current_frame_size(fm, old_frame)
      fmap_set_current_preserve_fp(fm, old_preserve_fp)
      fmap_set_current_gpr_pairs(fm, old_gpr_pairs)
      fmap_set_current_abort_cleanup_facts(fm, old_abort_cleanup_facts)
      fmap_set_current_abort_cleanup_base(fm, old_abort_cleanup_base)
      fmap_set_current_abort_cleanup_boundary(fm, old_abort_cleanup_boundary)
      fmap_set_current_abort_cleanup_block(fm, old_abort_cleanup_block)
      fmap_set_current_array_storage_facts(fm, old_array_storage_facts)
      cg_cleanup_restore(fm, old_cleanup_depth)
      cg_patch_b(code, skip_pos, buf_len(code))
      pipeline_hclause_info_new(clause_start, captures, nfree)
    }
  }
}

fn pipeline_type_record_field_name_matches(field: TypeRecordField, src: i64, field_ns: i64, field_nl: i64, entry_src: i64) -> i64 {
  match field {
    TypeRecordField(ns, nl, ty) -> {
      if nl == field_nl {
        src_eq_at(src, field_ns, entry_src + ns, 0, field_nl)
      } else {
        0
      }
    }
    MissingTypeRecordField -> 0
  }
}

fn pipeline_type_record_field_index(fields: TypeRecordFieldList, src: i64, field_ns: i64, field_nl: i64, entry_src: i64, index: i64) -> i64 {
  match fields {
    TypeRecordFieldListNil -> 0 - 1
    TypeRecordFieldListCons(field, rest) -> {
      if pipeline_type_record_field_name_matches(field, src, field_ns, field_nl, entry_src) == 1 {
        index
      } else {
        pipeline_type_record_field_index(rest, src, field_ns, field_nl, entry_src, index + 1)
      }
    }
  }
}

fn pipeline_type_find_any_field_index_entries(entries: TypeEntryList, src: i64, field_ns: i64, field_nl: i64) -> i64 {
  match entries {
    TypeEntryListNil -> 0
    TypeEntryListCons(entry, rest) -> {
      match entry {
        TypeRecordEntry(name, tparams, fields) -> {
          let entry_src = type_entry_source_or(entry, 0)
          let idx = pipeline_type_record_field_index(fields, src, field_ns, field_nl, entry_src, 0)
          if idx >= 0 { idx } else { pipeline_type_find_any_field_index_entries(rest, src, field_ns, field_nl) }
        }
        _ -> pipeline_type_find_any_field_index_entries(rest, src, field_ns, field_nl)
      }
    }
  }
}

fn pipeline_type_find_any_field_index(tt: i64, src: i64, field_ns: i64, field_nl: i64) -> i64 {
  pipeline_type_find_any_field_index_entries(type_entries_from_table(tt), src, field_ns, field_nl)
}

fn pipeline_ir_native_emit_hclause_body(body: IrHandlerClauseBody, code: i64, src: i64, fm: i64, active_handlers: PipelineNativeHandlerCtx, fns: i64) -> i64 {
  pipeline_ir_native_emit_hclause_body_ir(body, code, src, fm, active_handlers, fns)
}

fn pipeline_ir_native_hclause_env_from_captures(code: i64, ops_ctr: i64, ci: i64, captures: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let capture_lanes = pipeline_capture_value_lane_count(captures)
  let env_size = capture_lanes * 8
  emit_mov_imm(code, 0, env_size)
  cg_bump_alloc_reg(code, 17, 0)
  let nfree = if captures == 0 { 0 } else { nlist_len(captures) }
  for ei in 0..nfree {
    let capture = nlist_get(captures, ei)
    let offset = pipeline_capture_value_lane_offset(captures, ei)
    let lanes = pipeline_capture_lane_count(capture)
    for lane in 0..lanes {
      let ep = pipeline_ir_native_load_value_temp_pinned(code, pinned, node_f3(capture) + lane, 9)
      bu32(code, cg_str(ep, 17, (offset + lane) * 8))
    }
  }
  let ops_phys = pipeline_ir_native_load_reg_raw(code, pinned, ops_ctr)
  bu32(code, cg_str(17, ops_phys, ci * handler_ops_entry_size() + handler_ops_env_ptr_offset()))
}

fn pipeline_ir_native_hfill_ops(clauses: IrHandlerClauseBodyList, n: i64, infos: i64, code: i64, ops_ctr: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  for ci in 0..n {
    let clause = ir_handler_clause_body_list_nth(clauses, ci)
    let op_hash = match clause {
      IrHandlerClauseBody(body_op_hash, nparams, captures, has_continuation, is_abortive, result_cleanup_kind, transferred_param_value_fact, resume_lanes, result_lanes, first_value, blocks) -> body_op_hash
      IrHandlerClauseBodyInvalid(reason) -> 0
    }
    let info = pipeline_word_array_get(infos, ci)
    let cs = pipeline_hclause_info_clause_start(info)
    let fvs = pipeline_hclause_info_free_vars(info)
    let nfree = pipeline_hclause_info_nfree(info)
    let ops_phys = pipeline_ir_native_load_reg_raw(code, pinned, ops_ctr)
    emit_mov_imm_safe(code, 17, op_hash)
    bu32(code, cg_str(17, ops_phys, ci * handler_ops_entry_size() + handler_ops_op_hash_offset()))
    let adr_pos = buf_len(code)
    bu32(code, encode_adr(17, cs - adr_pos))
    let ops_p2 = pipeline_ir_native_load_reg_raw(code, pinned, ops_ctr)
    bu32(code, cg_str(17, ops_p2, ci * handler_ops_entry_size() + handler_ops_fn_ptr_offset()))
    if nfree > 0 {
      pipeline_ir_native_hclause_env_from_captures(code, ops_ctr, ci, fvs, pinned)
    } else {
      emit_mov_imm(code, 17, 0)
      let ops_p3 = pipeline_ir_native_load_reg_raw(code, pinned, ops_ctr)
      bu32(code, cg_str(17, ops_p3, ci * handler_ops_entry_size() + handler_ops_env_ptr_offset()))
    }
  }
  0
}

fn pipeline_ir_native_deferred_managed_capture_count(captures: i64) -> i64 {
  let n = if captures == 0 { 0 } else { nlist_len(captures) }
  let mut count = 0
  for i in 0..n {
    let capture = nlist_get(captures, i)
    if ty_value_has_release_lane(node_f4(capture)) == 1 { count = count + 1 } else { 0 }
  }
  count
}

fn pipeline_ir_native_emit_deferred_capture_owner_release(code: i64, fm: i64) -> i64 {
  bu32(code, cg_ldr(16, 28, runtime_state_deferred_prompt_offset()))
  let no_prompt_pos = buf_len(code)
  bu32(code, 0)
  bu32(code, cg_ldr(0, 16, fiber_prompt_capture_owner_offset()))
  bu32(code, cg_str(31, 16, fiber_prompt_capture_owner_offset()))
  let no_owner_pos = buf_len(code)
  bu32(code, 0)
  cg_emit_call_lit(code, fm, "closure_default_release")
  let done = buf_len(code)
  cg_patch_cbz(code, no_prompt_pos, 16, done)
  cg_patch_cbz(code, no_owner_pos, 0, done)
  0
}

fn pipeline_ir_native_emit_deferred_capture_owner_new(code: i64, fm: i64, prompt_ctr: i64, env_ctr: i64, captures: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  if pipeline_ir_native_deferred_managed_capture_count(captures) > 0 {
    cg_emit_rc_default_alloc_nozero_lit(code, fm, continuation_cleanup_kind_closure(), 16, 8)
    emit_mov_imm(code, 9, 0)
    bu32(code, cg_str(9, 0, 0))
    let env_phys = pipeline_ir_native_load_reg_temp(code, pinned, env_ctr, 17)
    bu32(code, cg_str(env_phys, 0, 8))
    let prompt_phys = pipeline_ir_native_load_reg_temp(code, pinned, prompt_ctr, 16)
    bu32(code, cg_str(0, prompt_phys, fiber_prompt_capture_owner_offset()))
  } else { 0 }
  0
}

fn pipeline_ir_native_emit_deferred_capture_env_release_if_unowned(code: i64, fm: i64, captures: i64, nfree: i64) -> i64 {
  if nfree > 0 and pipeline_ir_native_deferred_managed_capture_count(captures) == 0 {
    cg_emit_call_lit(code, fm, "rc_default_release")
  } else { 0 }
  0
}

fn pipeline_ir_native_emit_deferred_capture_owner_release_if_owned(code: i64, fm: i64, captures: i64) -> i64 {
  if pipeline_ir_native_deferred_managed_capture_count(captures) > 0 {
    pipeline_ir_native_emit_deferred_capture_owner_release(code, fm)
  } else {
    0
  }
  0
}

fn pipeline_ir_native_emit_deferred_body_function(body: IrDeferredHandlerBody, eff_hash: i64, nclauses: i64, clause_infos: i64, code: i64, src: i64, fm: i64, active_handlers: PipelineNativeHandlerCtx, fns: i64) -> i64 {
  match body {
    IrDeferredHandlerBodyInvalid(reason) -> pipeline_ir_native_emit_hclause_body_trap(code, fm)
    IrDeferredHandlerBody(captures, ops_value, result_lanes, first_value, blocks) -> {
      let nfree = pipeline_capture_value_lane_count(captures)
      let skip_pos = buf_len(code)
      bu32(code, 0)
      let body_start = buf_len(code)
      let old_frame = fmap_current_frame_size(fm)
      let old_preserve_fp = fmap_current_preserve_fp(fm)
      let old_gpr_pairs = fmap_current_gpr_pairs(fm)
      let old_abort_cleanup_facts = fmap_current_abort_cleanup_facts(fm)
      let old_abort_cleanup_base = fmap_current_abort_cleanup_base(fm)
      let old_abort_cleanup_boundary = fmap_current_abort_cleanup_boundary(fm)
      let old_abort_cleanup_block = fmap_current_abort_cleanup_block(fm)
      let old_array_storage_facts = fmap_current_array_storage_facts(fm)
      let old_cleanup_depth = nlist_len(cg_cleanup_stack(fm))
      -- The deferred body is a synthetic fiber function. Its capture
      -- environment borrows from the enclosing handle frame, so inheriting
      -- that frame's parameter cleanup entries makes dropping k release a
      -- borrowed capture before the outer epilogue releases its real stake.
      -- Callees running inside the fiber establish their own parameter
      -- cleanup scopes when emitted as ordinary functions.
      cg_cleanup_restore(fm, 0)
      let f64_facts = pipeline_ir_native_f64_facts_assign_slot_homes(blocks, pipeline_ir_native_f64_facts_for_blocks(blocks))
      let vector_data_facts = pipeline_ir_native_vector_data_facts_assign_home(pipeline_ir_native_vector_data_facts_for_blocks(blocks))
      let f64_slot_count = pipeline_ir_native_f64_slot_home_count(f64_facts)
      let body_next_value = pipeline_ir_function_next_value(first_value, blocks)
      let return_save = body_next_value + 8
      let block_frame = pipeline_ir_native_scalar_frame_size_for_blocks(first_value, blocks)
      let return_frame = pipeline_ir_native_frame_size_for_next_value(return_save + result_lanes)
      let abort_cleanup_facts = pipeline_ir_abort_cleanup_facts_for_blocks(blocks, fns)
      let abort_cleanup_instrumented = pipeline_ir_abort_cleanup_blocks_need_instrumentation(blocks, abort_cleanup_facts)
      let array_storage_base = pipeline_ir_max_i64(block_frame, return_frame)
      let array_storage_facts = pipeline_ir_native_array_storage_facts_for_blocks(blocks, array_storage_base)
      let abort_cleanup_base = pipeline_ir_native_array_storage_frame_size(array_storage_base, array_storage_facts)
      fmap_set_current_array_storage_facts(fm, array_storage_facts)
      fmap_set_current_abort_cleanup_facts(fm, abort_cleanup_facts)
      fmap_set_current_abort_cleanup_base(fm, abort_cleanup_base)
      fmap_set_current_abort_cleanup_boundary(fm, abort_cleanup_base)
      fmap_set_current_frame_size(fm, pipeline_ir_abort_cleanup_frame_size(abort_cleanup_base, abort_cleanup_facts, abort_cleanup_instrumented))
      if f64_slot_count > 0 { fmap_set_current_preserve_fp(fm, 1) } else { 0 }
      fmap_set_current_gpr_pairs(fm, 4)
      emit_prologue_current(code, fm)
      pipeline_ir_abort_cleanup_emit_function_entry(code, fm)
      pipeline_ir_native_emit_lambda_loads(code, 0, nfree)
      -- An all-unmanaged environment dies after the prologue loads. A managed
      -- environment belongs to the prompt's closure-shaped capture owner and
      -- survives until normal fiber completion or continuation drop.
      pipeline_ir_native_emit_deferred_capture_env_release_if_unowned(code, fm, captures, nfree)
      let safe_handlers = pipeline_ir_native_handler_ctx_uncaptured(active_handlers)
      let fiber_handlers = PipelineNativeHandlerCtxCons(eff_hash, clause_infos, nclauses, ops_value, 0 - 1, 0, safe_handlers)
      let body_home_count = pipeline_ir_native_value_home_count_include_evidence(pipeline_ir_native_value_home_count_for_blocks(first_value, blocks), fm)
      let saved_home_count = pipeline_ir_native_value_home_count_include(body_home_count, return_save + result_lanes - 1)
      let contextual_home_count = pipeline_ir_native_value_home_count_include_handlers(saved_home_count, fiber_handlers)
      let pinned = pipeline_ir_native_identity_home_facts(pipeline_ir_native_value_home_count_include_handler_scratch(contextual_home_count, blocks, pipeline_ir_native_handler_ctx_len(fiber_handlers)))
      bu32(code, cg_ldr(17, 28, runtime_state_deferred_ops_offset()))
      pipeline_ir_native_store_reg(code, pinned, ops_value, 17)
      let temp_base = return_save + result_lanes
      let abort_adr_patches = nlist_new()
      let state = pipeline_ir_native_emit_blocks(blocks, blocks, code, scope_new(), src, fm, fiber_handlers, fns, f64_facts, vector_data_facts, abort_adr_patches, pipeline_ir_native_cfg_state(pipeline_ir_native_label_map_empty(), 0, pinned, temp_base))
      let labels = pipeline_ir_native_label_map_add(pipeline_ir_native_cfg_state_labels(state), pipeline_ir_native_epilogue_label(), buf_len(code))
      pipeline_ir_native_patch_all(code, labels, pipeline_ir_native_cfg_state_patches(state))
      pipeline_ir_native_patch_abort_adrs(code, labels, abort_adr_patches)
      for lane in 0..result_lanes {
        pipeline_ir_native_store_reg(code, pinned, return_save + lane, lane)
      }
      pipeline_ir_native_emit_deferred_capture_owner_release_if_owned(code, fm, captures)
      for lane in 0..result_lanes {
        let saved_result = emit_load_reg(code, return_save + lane)
        bu32(code, encode_add_imm(lane, saved_result, 0))
      }
      pipeline_ir_abort_cleanup_emit_function_exit(code, fm)
      emit_epilogue_current(code, fm)
      fmap_set_current_frame_size(fm, old_frame)
      fmap_set_current_preserve_fp(fm, old_preserve_fp)
      fmap_set_current_gpr_pairs(fm, old_gpr_pairs)
      fmap_set_current_abort_cleanup_facts(fm, old_abort_cleanup_facts)
      fmap_set_current_abort_cleanup_base(fm, old_abort_cleanup_base)
      fmap_set_current_abort_cleanup_boundary(fm, old_abort_cleanup_boundary)
      fmap_set_current_abort_cleanup_block(fm, old_abort_cleanup_block)
      fmap_set_current_array_storage_facts(fm, old_array_storage_facts)
      cg_cleanup_restore(fm, old_cleanup_depth)
      cg_patch_b(code, skip_pos, buf_len(code))
      pipeline_hclause_info_new(body_start, captures, nfree)
    }
  }
}

fn pipeline_ir_native_emit_deferred_push_runtime_state(code: i64) -> i64 {
  cg_bump_alloc_imm(code, 17, deferred_runtime_context_size())
  bu32(code, cg_ldr(9, 28, runtime_state_deferred_ops_offset()))
  bu32(code, cg_str(9, 17, deferred_runtime_context_ops_offset()))
  bu32(code, cg_ldr(9, 28, runtime_state_deferred_prompt_offset()))
  bu32(code, cg_str(9, 17, deferred_runtime_context_prompt_offset()))
  bu32(code, cg_ldr(9, 28, runtime_state_deferred_effect_hash_offset()))
  bu32(code, cg_str(9, 17, deferred_runtime_context_effect_hash_offset()))
  bu32(code, cg_ldr(9, 28, runtime_state_deferred_op_count_offset()))
  bu32(code, cg_str(9, 17, deferred_runtime_context_op_count_offset()))
  bu32(code, cg_ldr(9, 28, runtime_state_deferred_prev_offset()))
  bu32(code, cg_str(9, 17, deferred_runtime_context_prev_offset()))
  bu32(code, cg_str(17, 28, runtime_state_deferred_prev_offset()))
}

fn pipeline_ir_native_emit_deferred_pop_runtime_state(code: i64) -> i64 {
  bu32(code, cg_ldr(17, 28, runtime_state_deferred_prev_offset()))
  bu32(code, cg_ldr(9, 17, deferred_runtime_context_ops_offset()))
  bu32(code, cg_str(9, 28, runtime_state_deferred_ops_offset()))
  bu32(code, cg_ldr(9, 17, deferred_runtime_context_prompt_offset()))
  bu32(code, cg_str(9, 28, runtime_state_deferred_prompt_offset()))
  bu32(code, cg_ldr(9, 17, deferred_runtime_context_effect_hash_offset()))
  bu32(code, cg_str(9, 28, runtime_state_deferred_effect_hash_offset()))
  bu32(code, cg_ldr(9, 17, deferred_runtime_context_op_count_offset()))
  bu32(code, cg_str(9, 28, runtime_state_deferred_op_count_offset()))
  bu32(code, cg_ldr(9, 17, deferred_runtime_context_prev_offset()))
  bu32(code, cg_str(9, 28, runtime_state_deferred_prev_offset()))
}

fn pipeline_ir_native_emit_capture_env_entries(code: i64, fm: i64, env_ctr: i64, captures: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let capture_lanes = pipeline_capture_value_lane_count(captures)
  if capture_lanes <= 0 {
    emit_mov_imm(code, 17, 0)
    pipeline_ir_native_store_reg(code, pinned, env_ctr, 17)
  } else {
    let env_size = 8 + capture_lanes * 16
    cg_emit_rc_default_alloc_nozero_raw(code, fm, env_size, 8)
    pipeline_ir_native_store_reg(code, pinned, env_ctr, 0)
    let env_phys = pipeline_ir_native_load_reg_raw(code, pinned, env_ctr)
    emit_mov_imm(code, 9, capture_lanes)
    bu32(code, cg_str(9, env_phys, 0))
    -- The environment is closure-shaped. Every managed lane receives one
    -- fiber stake and publishes its exact release kind; when any exist, a
    -- prompt-owned closure pair releases the complete bundle on normal fiber
    -- completion or continuation drop.
    let nfree = if captures == 0 { 0 } else { nlist_len(captures) }
    for i in 0..nfree {
      let capture = nlist_get(captures, i)
      let offset = pipeline_capture_value_lane_offset(captures, i)
      let lanes = pipeline_capture_lane_count(capture)
      for lane in 0..lanes {
        let word = offset + lane
        let value_phys = pipeline_ir_native_load_value_temp_pinned(code, pinned, node_f3(capture) + lane, 9)
        let current_env = pipeline_ir_native_load_reg_temp(code, pinned, env_ctr, 16)
        bu32(code, cg_str(value_phys, current_env, 8 + word * 16))
        let kind = cg_managed_drop_kind_for_ty_lane(node_f4(capture), lane)
        if kind == continuation_cleanup_kind_rc() { cg_emit_rc_retain_phys(code, fm, value_phys) }
        else { if kind == continuation_cleanup_kind_closure() { cg_emit_closure_retain_phys(code, fm, value_phys) }
        else { if kind == continuation_cleanup_kind_weak() { cg_emit_weak_retain_phys(code, fm, value_phys) } else { 0 } } }
        emit_mov_imm(code, 9, kind)
        let current_env2 = pipeline_ir_native_load_reg_temp(code, pinned, env_ctr, 16)
        bu32(code, cg_str(9, current_env2, 16 + word * 16))
      }
    }
  }
  0
}

fn pipeline_ir_native_emit_deferred_handle(code: i64, dst: i64, src: i64, body: IrDeferredHandlerBody, clauses: IrHandlerClauseBodyList, nclauses: i64, eff_hash: i64, scratch_base: i64, fm: i64, ctx: PipelineNativeEmitCtx) -> i64 {
  let handlers = pipeline_ir_native_emit_ctx_handlers(ctx)
  let fns = pipeline_ir_native_emit_ctx_fns(ctx)
  let pinned = pipeline_ir_native_emit_ctx_pinned(ctx)
  let clause_infos = pipeline_word_array_new(nclauses)
  for ci in 0..nclauses {
    let info = pipeline_ir_native_emit_hclause_body(ir_handler_clause_body_list_nth(clauses, ci), code, src, fm, handlers, fns)
    pipeline_word_array_set(clause_infos, ci, info)
  }
  let body_info = pipeline_ir_native_emit_deferred_body_function(body, eff_hash, nclauses, clause_infos, code, src, fm, handlers, fns)
  let ops_ctr = scratch_base
  let env_ctr = ops_ctr + 1
  let segment_ctr = ops_ctr + 2
  let prompt_ctr = ops_ctr + 3
  let result_ctr = ops_ctr + 4
  let result_lanes = match body {
    IrDeferredHandlerBody(captures, ops_value, lanes, first_value, blocks) -> lanes
    IrDeferredHandlerBodyInvalid(reason) -> 1
  }
  pipeline_ir_native_emit_deferred_push_runtime_state(code)
  cg_bump_alloc_imm(code, 16, nclauses * handler_ops_entry_size())
  pipeline_ir_native_store_reg(code, pinned, ops_ctr, 16)
  pipeline_ir_native_hfill_ops(clauses, nclauses, clause_infos, code, ops_ctr, pinned)
  pipeline_ir_native_emit_capture_env_entries(code, fm, env_ctr, pipeline_hclause_info_free_vars(body_info), pinned)
  -- Match runtime/effects.weft fiber_default_stack_size(). The native
  -- backend reserves a conservative 2 KiB home area per recursive frame;
  -- abort-cleanup records pushed the 64 KiB segment past its safe depth.
  emit_mov_imm(code, 0, 131072)
  cg_emit_call_lit(code, fm, "fiber_segment_new")
  pipeline_ir_native_store_reg(code, pinned, segment_ctr, 0)
  let segment_phys = pipeline_ir_native_load_reg_temp(code, pinned, segment_ctr, 16)
  bu32(code, encode_add_imm(0, segment_phys, 0))
  cg_emit_call_lit(code, fm, "fiber_prompt_new")
  pipeline_ir_native_store_reg(code, pinned, prompt_ctr, 0)
  pipeline_ir_native_emit_deferred_capture_owner_new(code, fm, prompt_ctr, env_ctr, pipeline_hclause_info_free_vars(body_info), pinned)
  let prompt_phys = pipeline_ir_native_load_reg_temp(code, pinned, prompt_ctr, 16)
  bu32(code, cg_str(prompt_phys, 28, runtime_state_deferred_prompt_offset()))
  let ops_phys = pipeline_ir_native_load_reg_temp(code, pinned, ops_ctr, 17)
  bu32(code, cg_str(ops_phys, 28, runtime_state_deferred_ops_offset()))
  emit_mov_imm_safe(code, 9, eff_hash)
  bu32(code, cg_str(9, 28, runtime_state_deferred_effect_hash_offset()))
  emit_mov_imm(code, 9, nclauses)
  bu32(code, cg_str(9, 28, runtime_state_deferred_op_count_offset()))
  bu32(code, encode_add_imm(0, prompt_phys, 0))
  let adr_pos = buf_len(code)
  bu32(code, encode_adr(1, pipeline_hclause_info_clause_start(body_info) - adr_pos))
  let env_phys = pipeline_ir_native_load_reg_temp(code, pinned, env_ctr, 17)
  bu32(code, encode_add_imm(2, env_phys, 0))
  cg_emit_call_lit(code, fm, "fiber_trampoline")
  for lane in 0..result_lanes {
    pipeline_ir_native_store_reg(code, pinned, result_ctr + lane, lane)
  }
  cg_emit_call_lit(code, fm, "fiber_is_done")
  bu32(code, encode_cmp(0, 31))
  let suspended_pos = buf_len(code)
  bu32(code, 0)
  for lane in 0..result_lanes {
    let done_result_phys = pipeline_ir_native_load_reg(code, pinned, result_ctr + lane)
    pipeline_ir_native_store_reg_pinned(code, pinned, dst + lane, done_result_phys)
  }
  let done_jump_pos = buf_len(code)
  bu32(code, 0)
  let suspended = buf_len(code)
  cg_patch_b_cond(code, suspended_pos, 0, suspended)
  let packet_phys = pipeline_ir_native_load_reg_temp(code, pinned, result_ctr, 16)
  pipeline_ir_native_emit_deferred_call_packet_regs(code, packet_phys, 0)
  for lane in 0..result_lanes {
    pipeline_ir_native_store_reg_pinned(code, pinned, dst + lane, lane)
  }
  let finish = buf_len(code)
  cg_patch_b(code, done_jump_pos, finish)
  pipeline_ir_native_emit_deferred_pop_runtime_state(code)
  -- Match the ordinary call ABI: lane zero is defined by the deferred
  -- handle instruction and the following IrCallResultLane nodes read the
  -- remaining physical result registers.
  for lane in 0..result_lanes {
    let result_phys = pipeline_ir_native_load_reg(code, pinned, dst + lane)
    if result_phys != lane { bu32(code, encode_add_imm(lane, result_phys, 0)) } else { 0 }
  }
  0
}

fn pipeline_ir_native_emit_handle(code: i64, src: i64, fm: i64, eff_hash: i64, clauses: IrHandlerClauseBodyList, nclauses: i64, abort_block: i64, emit_ctx: PipelineNativeEmitCtx) -> PipelineNativeHandlerCtx {
  let ctx = pipeline_ir_native_emit_ctx_handlers(emit_ctx)
  let fns = pipeline_ir_native_emit_ctx_fns(emit_ctx)
  let pinned = pipeline_ir_native_emit_ctx_pinned(emit_ctx)
  if nclauses <= 0 { ctx }
  else {
    let clause_infos = pipeline_word_array_new(nclauses)
    for ci in 0..nclauses {
      let info = pipeline_ir_native_emit_hclause_body(ir_handler_clause_body_list_nth(clauses, ci), code, src, fm, ctx, fns)
      pipeline_word_array_set(clause_infos, ci, info)
    }
    let depth = pipeline_ir_native_handler_ctx_len(ctx)
    let ops_ctr = pipeline_ir_native_handler_scratch_base() + depth * 2
    let frame_ctr = ops_ctr + 1
    cg_bump_alloc_imm(code, 16, nclauses * handler_ops_entry_size())
    pipeline_ir_native_store_reg(code, pinned, ops_ctr, 16)
    pipeline_ir_native_hfill_ops(clauses, nclauses, clause_infos, code, ops_ctr, pinned)
    let adr_pos = cg_hbuild_frame_maybe_abort(code, eff_hash, nclauses, ops_ctr, if abort_block >= 0 { 1 } else { 0 })
    if adr_pos > 0 {
      nlist_add(pipeline_ir_native_emit_ctx_adr_patches(emit_ctx), node_new(0, adr_pos, abort_block, 0, 0))
    } else { 0 }
    pipeline_ir_native_store_reg(code, pinned, frame_ctr, 27)
    PipelineNativeHandlerCtxCons(eff_hash, clause_infos, nclauses, ops_ctr, frame_ctr, if abort_block >= 0 { 1 } else { 0 }, ctx)
  }
}

fn pipeline_ir_native_emit_direct(code: i64, dst: i64, handler_depth: i64, clause_index: i64, args: IrValueList, ctx: PipelineNativeHandlerCtx, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let found = pipeline_ir_native_handler_ctx_at(ctx, handler_depth)
  match found {
    PipelineNativeHandlerCtxNil -> 0
    PipelineNativeHandlerCtxCons(eff_hash, infos, nclauses, ops_ctr, frame_ctr, is_abortive, rest) -> {
      if frame_ctr < 0 {
        let ops_phys = pipeline_ir_native_load_reg(code, pinned, ops_ctr)
        bu32(code, encode_add_imm(13, ops_phys, clause_index * handler_ops_entry_size()))
        pipeline_ir_native_emit_deferred_suspend_direct(code, dst, 13, args, fm, pinned)
      } else {
        let info = pipeline_word_array_get(infos, clause_index)
        let clause_start = pipeline_hclause_info_clause_start(info)
        pipeline_ir_native_move_args(code, args, 0, pinned)
        let nfree = pipeline_hclause_info_nfree(info)
        if nfree == 0 {
          emit_mov_imm(code, 0, 0)
        } else {
          let ops_phys = pipeline_ir_native_load_reg(code, pinned, ops_ctr)
          bu32(code, cg_ldr(0, ops_phys, clause_index * handler_ops_entry_size() + handler_ops_env_ptr_offset()))
        }
        -- Mask the handler's own frame during the clause call (same
        -- contract as pipeline_ir_native_emit_masked_clause_call): a
        -- dynamic perform inside the clause must not find this frame,
        -- or a clause performing its own label re-enters itself. The
        -- statically known frame register gives prev without the
        -- runtime-state slot.
        let frame_phys = pipeline_ir_native_load_reg(code, pinned, frame_ctr)
        -- The clause cannot read x27: it is masked for sound dispatch.
        -- Hand the actual frame over through runtime state, matching the
        -- dynamic handler_find_entry path. Its prologue snapshots the slot.
        bu32(code, cg_str(frame_phys, 28, runtime_state_dispatch_frame_offset()))
        bu32(code, cg_ldr(15, frame_phys, handler_frame_prev_offset()))
        bu32(code, encode_sub_imm(31, 31, 16))
        bu32(code, encode_str(27, 31, 0))
        bu32(code, encode_add_imm(27, 15, 0))
        let cur = buf_len(code)
        bu32(code, encode_bl(clause_start - cur))
        bu32(code, encode_ldr(27, 31, 0))
        bu32(code, encode_add_imm(31, 31, 16))
        pipeline_ir_native_store_reg_pinned(code, pinned, dst, 0)
      }
    }
  }
}

fn pipeline_ir_native_emit_perform_via_evidence(code: i64, dst: i64, clause_index: i64, args: IrValueList, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let ev_phys = pipeline_ir_native_load_reg(code, pinned, fmap_lambda_evidence_value(fm))
  bu32(code, encode_add_imm(13, ev_phys, clause_index * handler_ops_entry_size()))
  bu32(code, cg_ldr(9, 13, handler_ops_fn_ptr_offset()))
  bu32(code, cg_ldr(0, 13, handler_ops_env_ptr_offset()))
  pipeline_ir_native_move_args(code, args, 0, pinned)
  bu32(code, encode_blr(9))
  pipeline_ir_native_store_reg_pinned(code, pinned, dst, 0)
  fmap_inc_effect_evidence_count(fm)
}

fn pipeline_ir_native_emit_perform(code: i64, dst: i64, effect_hash: i64, op_hash: i64, args: IrValueList, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let evidence_index = if fmap_lambda_evidence_eff(fm) == effect_hash { pipeline_nlist_index_of(fmap_lambda_evidence_ops(fm), op_hash) } else { 0 - 1 }
  if evidence_index >= 0 {
    pipeline_ir_native_emit_perform_via_evidence(code, dst, evidence_index, args, fm, pinned)
    0
  } else {
  bu32(code, cg_ldr(14, 28, runtime_state_deferred_ops_offset()))
  bu32(code, cg_ldr(10, 28, runtime_state_deferred_prev_offset()))
  bu32(code, cg_ldr(15, 28, runtime_state_deferred_effect_hash_offset()))
  bu32(code, cg_ldr(12, 28, runtime_state_deferred_op_count_offset()))
  emit_mov_imm_safe(code, 16, effect_hash)
  emit_mov_imm_safe(code, 17, op_hash)
  let frame_loop = buf_len(code)
  let no_deferred_pos = buf_len(code)
  bu32(code, 0)
  bu32(code, encode_cmp(15, 16))
  let effect_miss_pos = buf_len(code)
  bu32(code, 0)
  emit_mov_imm(code, 11, 0)
  bu32(code, encode_add_imm(13, 14, 0))
  let scan_loop = buf_len(code)
  bu32(code, encode_cmp(11, 12))
  let scan_done_pos = buf_len(code)
  bu32(code, 0)
  bu32(code, cg_ldr(15, 13, handler_ops_op_hash_offset()))
  bu32(code, encode_cmp(15, 17))
  let found_pos = buf_len(code)
  bu32(code, 0)
  bu32(code, encode_add_imm(13, 13, handler_ops_entry_size()))
  bu32(code, encode_add_imm(11, 11, 1))
  let loop_back_pos = buf_len(code)
  bu32(code, 0)
  let found = buf_len(code)
  cg_patch_b(code, loop_back_pos, scan_loop)
  cg_patch_b_cond(code, found_pos, 0, found)
  pipeline_ir_native_emit_deferred_suspend_dynamic(code, dst, 13, args, fm, pinned)
  let deferred_done_pos = buf_len(code)
  bu32(code, 0)
  let next_frame = buf_len(code)
  cg_patch_b_cond(code, effect_miss_pos, 1, next_frame)
  cg_patch_b_cond(code, scan_done_pos, 10, next_frame)
  let no_prev_pos = buf_len(code)
  bu32(code, 0)
  bu32(code, cg_ldr(14, 10, deferred_runtime_context_ops_offset()))
  bu32(code, cg_ldr(15, 10, deferred_runtime_context_effect_hash_offset()))
  bu32(code, cg_ldr(12, 10, deferred_runtime_context_op_count_offset()))
  bu32(code, cg_ldr(10, 10, deferred_runtime_context_prev_offset()))
  let next_loop_pos = buf_len(code)
  bu32(code, 0)
  let normal_lookup = buf_len(code)
  cg_patch_cbz(code, no_deferred_pos, 14, normal_lookup)
  cg_patch_cbz(code, no_prev_pos, 10, normal_lookup)
  cg_patch_b(code, next_loop_pos, frame_loop)
  cg_perform_lookup(code, fm, effect_hash, op_hash)
  bu32(code, cg_ldr(9, 13, handler_ops_fn_ptr_offset()))
  bu32(code, cg_ldr(0, 13, handler_ops_env_ptr_offset()))
  pipeline_ir_native_move_args(code, args, 0, pinned)
  pipeline_ir_native_emit_masked_clause_call(code)
  pipeline_ir_native_store_reg_pinned(code, pinned, dst, 0)
  cg_patch_b(code, deferred_done_pos, buf_len(code))
  }
}

-- Call the clause (fn ptr in x9, args staged) with the found handler's
-- own frame masked out of the dispatch context: handler_find_entry
-- stashed the found frame's prev in runtime state, and the clause runs
-- with x27 = that prev so a clause performing an effect of its OWN
-- label dispatches to the enclosing handler instead of re-entering
-- itself (unbounded self-recursion otherwise). x27 is saved across the
-- call on the stack; sp is adjusted only around the BLR, after all arg
-- staging, so spill-slot offsets are unaffected.
fn pipeline_ir_native_emit_masked_clause_call(code: i64) -> i64 {
  bu32(code, cg_ldr(15, 28, runtime_state_dispatch_prev_offset()))
  bu32(code, encode_sub_imm(31, 31, 16))
  bu32(code, encode_str(27, 31, 0))
  bu32(code, encode_add_imm(27, 15, 0))
  bu32(code, encode_blr(9))
  bu32(code, encode_ldr(27, 31, 0))
  bu32(code, encode_add_imm(31, 31, 16))
}

fn pipeline_ir_native_emit_mem_load_sized_result(code: i64) -> i64 {
  emit_mov_imm_safe(code, 13, cg_layout_vector_record_mode())
  bu32(code, encode_cmp(2, 13))
  let not_record_pos = buf_len(code)
  bu32(code, 0)
  cg_bump_alloc_reg(code, 17, 1)
  cg_emit_mem_copy_regs(code, 17, 0, 1)
  let done_from_record = buf_len(code)
  bu32(code, 0)

  let scalar_start = buf_len(code)
  cg_patch_b_cond(code, not_record_pos, 1, scalar_start)
  emit_mov_imm_safe(code, 17, 0)
  emit_mov_imm_safe(code, 13, 0)
  bu32(code, encode_cmp(1, 13))
  let size_zero_pos = buf_len(code)
  bu32(code, 0)

  emit_mov_imm_safe(code, 13, 8)
  bu32(code, encode_cmp(1, 13))
  let not_8_pos = buf_len(code)
  bu32(code, 0)
  bu32(code, cg_ldr(17, 0, 0))
  let done_from_8 = buf_len(code)
  bu32(code, 0)

  let check_4 = buf_len(code)
  cg_patch_b_cond(code, not_8_pos, 1, check_4)
  emit_mov_imm_safe(code, 13, 4)
  bu32(code, encode_cmp(1, 13))
  let not_4_pos = buf_len(code)
  bu32(code, 0)
  emit_mov_imm_safe(code, 17, 0)
  cg_i_sized_load_or_byte(code, 0, 0)
  cg_i_sized_load_or_byte(code, 1, 8)
  cg_i_sized_load_or_byte(code, 2, 16)
  cg_i_sized_load_or_byte(code, 3, 24)
  emit_mov_imm_safe(code, 13, 6)
  bu32(code, encode_cmp(2, 13))
  let load4_unsigned_pos = buf_len(code)
  bu32(code, 0)
  bu32(code, encode_sxtw(17, 17))
  let done_from_4 = buf_len(code)
  bu32(code, 0)
  let load4_unsigned = buf_len(code)
  cg_patch_b_cond(code, load4_unsigned_pos, 1, load4_unsigned)
  let done_from_4_unsigned = buf_len(code)
  bu32(code, 0)

  let check_2 = buf_len(code)
  cg_patch_b_cond(code, not_4_pos, 1, check_2)
  emit_mov_imm_safe(code, 13, 2)
  bu32(code, encode_cmp(1, 13))
  let not_2_pos = buf_len(code)
  bu32(code, 0)
  emit_mov_imm_safe(code, 17, 0)
  cg_i_sized_load_or_byte(code, 0, 0)
  cg_i_sized_load_or_byte(code, 1, 8)
  emit_mov_imm_safe(code, 13, 4)
  bu32(code, encode_cmp(2, 13))
  let load2_unsigned_pos = buf_len(code)
  bu32(code, 0)
  bu32(code, encode_sxth(17, 17))
  let done_from_2 = buf_len(code)
  bu32(code, 0)
  let load2_unsigned = buf_len(code)
  cg_patch_b_cond(code, load2_unsigned_pos, 1, load2_unsigned)
  let done_from_2_unsigned = buf_len(code)
  bu32(code, 0)

  let load_1 = buf_len(code)
  cg_patch_b_cond(code, not_2_pos, 1, load_1)
  emit_mov_imm_safe(code, 17, 0)
  bu32(code, cg_ldrb(17, 0, 0))
  emit_mov_imm_safe(code, 13, 2)
  bu32(code, encode_cmp(2, 13))
  let load1_unsigned_pos = buf_len(code)
  bu32(code, 0)
  bu32(code, encode_sxtb(17, 17))

  let done = buf_len(code)
  cg_patch_b_cond(code, size_zero_pos, 0, done)
  cg_patch_b(code, done_from_8, done)
  cg_patch_b(code, done_from_4, done)
  cg_patch_b(code, done_from_4_unsigned, done)
  cg_patch_b(code, done_from_2, done)
  cg_patch_b(code, done_from_2_unsigned, done)
  cg_patch_b_cond(code, load1_unsigned_pos, 1, done)
  cg_patch_b(code, done_from_record, done)
}

fn pipeline_ir_native_emit_mem_store_sized_result(code: i64) -> i64 {
  emit_mov_imm_safe(code, 13, cg_layout_vector_record_mode())
  bu32(code, encode_cmp(2, 13))
  let not_record_pos = buf_len(code)
  bu32(code, 0)
  cg_emit_mem_copy_regs(code, 0, 3, 1)
  let done_from_record = buf_len(code)
  bu32(code, 0)

  let scalar_start = buf_len(code)
  cg_patch_b_cond(code, not_record_pos, 1, scalar_start)
  emit_mov_imm_safe(code, 13, 0)
  bu32(code, encode_cmp(1, 13))
  let size_zero_pos = buf_len(code)
  bu32(code, 0)

  emit_mov_imm_safe(code, 13, 8)
  bu32(code, encode_cmp(1, 13))
  let not_8_pos = buf_len(code)
  bu32(code, 0)
  bu32(code, cg_str(3, 0, 0))
  let done_from_8 = buf_len(code)
  bu32(code, 0)

  let check_4 = buf_len(code)
  cg_patch_b_cond(code, not_8_pos, 1, check_4)
  emit_mov_imm_safe(code, 13, 4)
  bu32(code, encode_cmp(1, 13))
  let not_4_pos = buf_len(code)
  bu32(code, 0)
  cg_i_sized_store_byte(code, 0, 0)
  cg_i_sized_store_byte(code, 1, 8)
  cg_i_sized_store_byte(code, 2, 16)
  cg_i_sized_store_byte(code, 3, 24)
  let done_from_4 = buf_len(code)
  bu32(code, 0)

  let check_2 = buf_len(code)
  cg_patch_b_cond(code, not_4_pos, 1, check_2)
  emit_mov_imm_safe(code, 13, 2)
  bu32(code, encode_cmp(1, 13))
  let not_2_pos = buf_len(code)
  bu32(code, 0)
  cg_i_sized_store_byte(code, 0, 0)
  cg_i_sized_store_byte(code, 1, 8)
  let done_from_2 = buf_len(code)
  bu32(code, 0)

  let store_1 = buf_len(code)
  cg_patch_b_cond(code, not_2_pos, 1, store_1)
  bu32(code, cg_strb(3, 0, 0))

  let done = buf_len(code)
  cg_patch_b_cond(code, size_zero_pos, 0, done)
  cg_patch_b(code, done_from_8, done)
  cg_patch_b(code, done_from_4, done)
  cg_patch_b(code, done_from_2, done)
  cg_patch_b(code, done_from_record, done)
  bu32(code, encode_add_imm(17, 3, 0))
}

fn pipeline_ir_native_emit_intrinsic_call(code: i64, dst: i64, callee_hash: i64, kind: i64, args: IrValueList, pinned: PipelineIrNativeValueHomeFacts, fm: i64) -> i64 {
  -- Bespoke-read arms skip move_call_args: kinds 35-44 always did; 2/3/8
  -- joined in 2v C1b so their scratch stays off the caller-saved pools
  -- (x0/x1 staging was their only pool contact). Their operands read
  -- via load_reg (pinned-aware, ck-evented) directly in the arm.
  let bespoke_reads = if kind >= 35 and kind <= 44 { 1 } else { if kind == 2 or kind == 3 or kind == 8 { 1 } else { 0 } }
  if bespoke_reads == 1 { 0 } else { pipeline_ir_native_move_call_args(code, args, 0, pinned) }
  if kind == 44 {
    -- str content equality: strs are [ptr(0), len(8)] descriptors and
    -- nil is 0, so identity decides first (covers nil==nil and shared
    -- descriptors), then either side nil -> 0 (a str is never 0), then
    -- length + byte compare. Union-typed operands (str | nil) reach
    -- this legally, so the nil guards are load-bearing. Result in x17.
    let a_phys = pipeline_ir_native_load_reg(code, pinned, pipeline_ir_value_list_get_or(args, 0, 0 - 1))
    if a_phys == 14 { 0 } else { bu32(code, encode_add_imm(14, a_phys, 0)) }
    let b_phys = pipeline_ir_native_load_reg(code, pinned, pipeline_ir_value_list_get_or(args, 1, 0 - 1))
    if b_phys == 15 { 0 } else { bu32(code, encode_add_imm(15, b_phys, 0)) }
    emit_mov_imm_safe(code, 17, 1)
    bu32(code, encode_cmp(14, 15))
    let ident_eq_pos = buf_len(code)
    bu32(code, 0)
    emit_mov_imm_safe(code, 17, 0)
    let a_nil_pos = buf_len(code)
    bu32(code, 0)
    let b_nil_pos = buf_len(code)
    bu32(code, 0)
    bu32(code, cg_ldr(12, 14, 8))
    bu32(code, cg_ldr(13, 15, 8))
    bu32(code, encode_cmp(12, 13))
    let len_ne_pos = buf_len(code)
    bu32(code, 0)
    bu32(code, cg_ldr(14, 14, 0))
    bu32(code, cg_ldr(15, 15, 0))
    emit_mov_imm_safe(code, 17, 1)
    let loop_start = buf_len(code)
    let empty_pos = buf_len(code)
    bu32(code, 0)
    bu32(code, cg_ldrb(10, 14, 0))
    bu32(code, cg_ldrb(11, 15, 0))
    bu32(code, encode_cmp(10, 11))
    let byte_ne_pos = buf_len(code)
    bu32(code, 0)
    bu32(code, encode_add_imm(14, 14, 1))
    bu32(code, encode_add_imm(15, 15, 1))
    bu32(code, encode_sub_imm(12, 12, 1))
    let loop_back_pos = buf_len(code)
    bu32(code, 0)
    let ne_found = buf_len(code)
    emit_mov_imm_safe(code, 17, 0)
    let done = buf_len(code)
    cg_patch_b(code, loop_back_pos, loop_start)
    cg_patch_cbz(code, empty_pos, 12, done)
    cg_patch_b_cond(code, byte_ne_pos, 1, ne_found)
    cg_patch_b_cond(code, len_ne_pos, 1, done)
    cg_patch_b_cond(code, ident_eq_pos, 0, done)
    cg_patch_cbz(code, a_nil_pos, 14, done)
    cg_patch_cbz(code, b_nil_pos, 15, done)
    pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17)
  } else { if kind == 35 {
    -- 2v C1b re-scratch (kinds 35-43): base/addr staged in x15, a
    -- store's value carried in x17 (the result cell — it survives
    -- load_reg, whose spill/remat staging is x16), the last-loaded
    -- operand read direct. Formerly x12/x14 — pool contact for no
    -- reason; these arms are pool-transparent now.
    let base_phys = pipeline_ir_native_load_reg(code, pinned, pipeline_ir_value_list_get_or(args, 0, 0 - 1))
    if base_phys == 15 { 0 } else { bu32(code, encode_add_imm(15, base_phys, 0)) }
    let index_phys = pipeline_ir_native_load_reg(code, pinned, pipeline_ir_value_list_get_or(args, 1, 0 - 1))
    bu32(code, encode_ldr_reg_lsl3(17, 15, index_phys))
    fmap_inc_scaled_mem_lowering_count(fm)
    pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17)
  } else { if kind == 36 {
    let value_phys = pipeline_ir_native_load_reg(code, pinned, pipeline_ir_value_list_get_or(args, 2, 0 - 1))
    if value_phys == 17 { 0 } else { bu32(code, encode_add_imm(17, value_phys, 0)) }
    let base_phys = pipeline_ir_native_load_reg(code, pinned, pipeline_ir_value_list_get_or(args, 0, 0 - 1))
    if base_phys == 15 { 0 } else { bu32(code, encode_add_imm(15, base_phys, 0)) }
    let index_phys = pipeline_ir_native_load_reg(code, pinned, pipeline_ir_value_list_get_or(args, 1, 0 - 1))
    bu32(code, encode_str_reg_lsl3(17, 15, index_phys))
    fmap_inc_scaled_mem_lowering_count(fm)
    pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17)
  } else { if kind == 37 {
    let value_phys = pipeline_ir_native_load_reg(code, pinned, pipeline_ir_value_list_get_or(args, 2, 0 - 1))
    if value_phys == 17 { 0 } else { bu32(code, encode_add_imm(17, value_phys, 0)) }
    let base_phys = pipeline_ir_native_load_reg(code, pinned, pipeline_ir_value_list_get_or(args, 0, 0 - 1))
    if base_phys == 15 { 0 } else { bu32(code, encode_add_imm(15, base_phys, 0)) }
    let index_phys = pipeline_ir_native_load_reg(code, pinned, pipeline_ir_value_list_get_or(args, 1, 0 - 1))
    bu32(code, encode_str_reg_lsl3(17, 15, index_phys))
    emit_mov_imm_safe(code, 17, 0)
    fmap_inc_scaled_mem_lowering_count(fm)
    fmap_inc_discard_store_count(fm)
    pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17)
  } else { if kind == 38 {
    let addr_phys = pipeline_ir_native_load_reg(code, pinned, pipeline_ir_value_list_get_or(args, 0, 0 - 1))
    bu32(code, cg_ldr(17, addr_phys, 0))
    fmap_add_direct_call_inline_count(fm, 1)
    pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17)
  } else { if kind == 39 {
    let value_phys = pipeline_ir_native_load_reg(code, pinned, pipeline_ir_value_list_get_or(args, 1, 0 - 1))
    if value_phys == 17 { 0 } else { bu32(code, encode_add_imm(17, value_phys, 0)) }
    let addr_phys = pipeline_ir_native_load_reg(code, pinned, pipeline_ir_value_list_get_or(args, 0, 0 - 1))
    bu32(code, cg_str(17, addr_phys, 0))
    fmap_add_direct_call_inline_count(fm, 1)
    pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17)
  } else { if kind == 40 {
    let value_phys = pipeline_ir_native_load_reg(code, pinned, pipeline_ir_value_list_get_or(args, 1, 0 - 1))
    if value_phys == 17 { 0 } else { bu32(code, encode_add_imm(17, value_phys, 0)) }
    let addr_phys = pipeline_ir_native_load_reg(code, pinned, pipeline_ir_value_list_get_or(args, 0, 0 - 1))
    bu32(code, cg_str(17, addr_phys, 0))
    emit_mov_imm_safe(code, 17, 0)
    fmap_inc_discard_store_count(fm)
    fmap_add_direct_call_inline_count(fm, 1)
    pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17)
  } else { if kind == 41 {
    let addr_phys = pipeline_ir_native_load_reg(code, pinned, pipeline_ir_value_list_get_or(args, 0, 0 - 1))
    bu32(code, cg_ldrb(17, addr_phys, 0))
    fmap_add_direct_call_inline_count(fm, 1)
    pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17)
  } else { if kind == 42 {
    let value_phys = pipeline_ir_native_load_reg(code, pinned, pipeline_ir_value_list_get_or(args, 1, 0 - 1))
    if value_phys == 17 { 0 } else { bu32(code, encode_add_imm(17, value_phys, 0)) }
    let addr_phys = pipeline_ir_native_load_reg(code, pinned, pipeline_ir_value_list_get_or(args, 0, 0 - 1))
    bu32(code, cg_strb(17, addr_phys, 0))
    fmap_add_direct_call_inline_count(fm, 1)
    pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17)
  } else { if kind == 43 {
    let value_phys = pipeline_ir_native_load_reg(code, pinned, pipeline_ir_value_list_get_or(args, 1, 0 - 1))
    if value_phys == 17 { 0 } else { bu32(code, encode_add_imm(17, value_phys, 0)) }
    let addr_phys = pipeline_ir_native_load_reg(code, pinned, pipeline_ir_value_list_get_or(args, 0, 0 - 1))
    bu32(code, cg_strb(17, addr_phys, 0))
    emit_mov_imm_safe(code, 17, 0)
    fmap_inc_discard_store_count(fm)
    fmap_add_direct_call_inline_count(fm, 1)
    pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17)
  } else { if kind == 34 {
    bu32(code, encode_add_imm(16, 0, 0))
    bu32(code, encode_add_imm(0, 1, 0))
    bu32(code, encode_add_imm(1, 2, 0))
    bu32(code, encode_add_imm(2, 3, 0))
    bu32(code, encode_add_imm(3, 4, 0))
    bu32(code, encode_add_imm(4, 5, 0))
    bu32(code, encode_add_imm(5, 6, 0))
    bu32(code, encode_movk(16, 512, 16))
    bu32(code, encode_svc())
    let ok_pos = buf_len(code)
    bu32(code, 0)
    bu32(code, encode_sub_reg(0, 31, 0))
    cg_patch_b_cond(code, ok_pos, 3, buf_len(code))
    bu32(code, encode_add_imm(17, 0, 0))
    let syscall_pinned_result_phys = pipeline_ir_native_value_home_lookup(pinned, dst)
    if syscall_pinned_result_phys == pipeline_ir_native_discard_home() {
      0
    } else {
    if syscall_pinned_result_phys >= 1000 {
      bu32(code, encode_brk(20))
    } else { if syscall_pinned_result_phys < 0 {
      emit_store_spill_offset(code, 17, (0 - syscall_pinned_result_phys - 1) * 8)
    } else { if syscall_pinned_result_phys != 0 {
      bu32(code, encode_add_imm(syscall_pinned_result_phys, 17, 0))
    } else {
      if dst < 0 { 0 }
      else { if dst < 8 {
        bu32(code, encode_add_imm(dst + 19, 17, 0))
      } else {
        emit_store_reg(code, dst, 17)
      } }
    } } }
    }
  } else { if kind == 23 {
    pipeline_ir_native_emit_mem_load_sized_result(code)
  } else { if kind == 24 {
    pipeline_ir_native_emit_mem_store_sized_result(code)
  } else { if kind == 25 {
    bu32(code, encode_scvtf_d_from_x(0, 0))
    bu32(code, encode_fmov_x_from_d(17, 0))
  } else { if kind == 26 {
    bu32(code, encode_ucvtf_d_from_x(0, 0))
    bu32(code, encode_fmov_x_from_d(17, 0))
  } else { if kind == 27 {
    bu32(code, encode_scvtf_s_from_x(0, 0))
    bu32(code, encode_fmov_w_from_s(17, 0))
  } else { if kind == 28 {
    bu32(code, encode_ucvtf_s_from_x(0, 0))
    bu32(code, encode_fmov_w_from_s(17, 0))
  } else { if kind == 29 {
    bu32(code, encode_fmov_d_from_x(0, 0))
    bu32(code, encode_fcvtzs_x_from_d(17, 0))
  } else { if kind == 30 {
    bu32(code, encode_fmov_s_from_w(0, 0))
    bu32(code, encode_fcvt_d_from_s(0, 0))
    bu32(code, encode_fmov_x_from_d(17, 0))
  } else { if kind == 31 {
    bu32(code, encode_fmov_d_from_x(0, 0))
    bu32(code, encode_fcvt_s_from_d(0, 0))
    bu32(code, encode_fmov_w_from_s(17, 0))
  } else { if kind == 32 {
    bu32(code, encode_fmov_d_from_x(0, 0))
    bu32(code, encode_fsqrt_d(0, 0))
    bu32(code, encode_fmov_x_from_d(17, 0))
  } else { if kind == 33 {
    bu32(code, encode_fmov_s_from_w(0, 0))
    bu32(code, encode_fsqrt_s(0, 0))
    bu32(code, encode_fmov_w_from_s(17, 0))
  } else { if kind == 1 {
    cg_bump_alloc_reg(code, 17, 0)
  } else { if kind == 2 {
    -- 2v C1b re-scratch: addr in x15, value read direct (load_reg's
    -- spill/remat staging is x16, so x15 survives the second read).
    -- Pool-transparent: writes only x15/x16/x17.
    let ms_addr_phys = pipeline_ir_native_load_reg(code, pinned, pipeline_ir_value_list_get_or(args, 0, 0 - 1))
    if ms_addr_phys == 15 { 0 } else { bu32(code, encode_add_imm(15, ms_addr_phys, 0)) }
    let ms_value_phys = pipeline_ir_native_load_reg(code, pinned, pipeline_ir_value_list_get_or(args, 1, 0 - 1))
    bu32(code, cg_str(ms_value_phys, 15, 0))
    bu32(code, encode_add_imm(17, ms_value_phys, 0))
  } else { if kind == 3 {
    let ms8_addr_phys = pipeline_ir_native_load_reg(code, pinned, pipeline_ir_value_list_get_or(args, 0, 0 - 1))
    if ms8_addr_phys == 15 { 0 } else { bu32(code, encode_add_imm(15, ms8_addr_phys, 0)) }
    let ms8_value_phys = pipeline_ir_native_load_reg(code, pinned, pipeline_ir_value_list_get_or(args, 1, 0 - 1))
    bu32(code, cg_strb(ms8_value_phys, 15, 0))
    bu32(code, encode_add_imm(17, ms8_value_phys, 0))
  } else { if kind == 4 {
    bu32(code, cg_ldr(17, 0, 0))
  } else { if kind == 5 {
    bu32(code, cg_ldrb(17, 0, 0))
  } else { if kind == 6 {
    bu32(code, cg_ldr(17, 0, 0))
  } else { if kind == 7 {
    bu32(code, cg_ldr(17, 0, 8))
  } else { if kind == 8 {
    -- 2v C1b re-scratch: lhs in x15, rhs read direct.
    let ro_a_phys = pipeline_ir_native_load_reg(code, pinned, pipeline_ir_value_list_get_or(args, 0, 0 - 1))
    if ro_a_phys == 15 { 0 } else { bu32(code, encode_add_imm(15, ro_a_phys, 0)) }
    let ro_b_phys = pipeline_ir_native_load_reg(code, pinned, pipeline_ir_value_list_get_or(args, 1, 0 - 1))
    bu32(code, encode_add_reg(17, 15, ro_b_phys))
  } else { if kind == 9 {
    bu32(code, encode_add_imm(17, 0, 0))
  } else { if kind == 10 {
    bu32(code, encode_add_imm(17, 0, 0))
  } else { if kind == 11 {
    bu32(code, encode_add_imm(17, 0, 0))
    cg_emit_int_normalize(code, pipeline_ir_native_intrinsic_int_cast_target_prim(callee_hash), 17)
  } else { if kind == 12 {
    -- 2v C1b re-scratch: loaded value x15, status x16, the lock
    -- constant lives in x17 until the trailing result write. Formerly
    -- x9/x10/x11 — pool and pin-bank contact for no reason.
    emit_mov_imm_safe(code, 17, 1)
    let loop_start = buf_len(code)
    bu32(code, encode_ldaxr(15, 0))
    bu32(code, encode_cmp(15, 31))
    let busy_pos = buf_len(code)
    bu32(code, 0)
    bu32(code, encode_stlxr(16, 17, 0))
    bu32(code, encode_cmp(16, 31))
    let lost_pos = buf_len(code)
    bu32(code, 0)
    cg_patch_b_cond(code, busy_pos, 1, loop_start)
    cg_patch_b_cond(code, lost_pos, 1, loop_start)
    emit_mov_imm_safe(code, 17, 0)
  } else { if kind == 13 {
    bu32(code, encode_stlr(31, 0))
    emit_mov_imm_safe(code, 17, 0)
  } else { if kind == 14 {
    bu32(code, encode_add_imm(9, 0, 0))
    bu32(code, encode_add_imm(0, 1, 0))
    bu32(code, encode_blr(9))
    bu32(code, encode_add_imm(17, 0, 0))
  } else { if kind == 15 {
    bu32(code, cg_ldr(9, 0, 0))
    bu32(code, cg_ldr(0, 0, 8))
    bu32(code, encode_blr(9))
    bu32(code, encode_add_imm(17, 0, 0))
  } else { if kind == 16 {
    let adr_pos = buf_len(code)
    bu32(code, 0)
    cg_fiber_prompt_save_handler_state(code, 0, 10)
    bu32(code, encode_add_imm(19, 0, 0))
    bu32(code, encode_add_imm(20, 1, 0))
    bu32(code, encode_add_imm(21, 2, 0))
    bu32(code, cg_str(19, 28, runtime_state_fiber_prompt_offset()))
    bu32(code, encode_movz(10, 0, 0))
    bu32(code, cg_str(10, 28, runtime_state_fiber_done_offset()))
    bu32(code, cg_ldr(22, 19, fiber_prompt_segment_offset()))
    bu32(code, cg_ldr(22, 22, fiber_segment_stack_top_offset()))
    cg_fiber_restore_sp_from(code, 22)
    bu32(code, encode_add_imm(0, 21, 0))
    bu32(code, encode_blr(20))
    bu32(code, encode_movz(10, 1, 0))
    bu32(code, cg_str(10, 28, runtime_state_fiber_done_offset()))
    bu32(code, encode_movz(10, 0, 0))
    bu32(code, cg_str(10, 28, runtime_state_fiber_prompt_offset()))
    cg_fiber_restore_handler_and_ret(code, 19, 0, 8)
    let after_pos = buf_len(code)
    bytes_set_u32(code, adr_pos, encode_adr(10, after_pos - adr_pos))
    bu32(code, encode_add_imm(17, 0, 0))
  } else { if kind == 17 {
    bu32(code, encode_add_imm(11, 0, 0))
    bu32(code, cg_ldr(9, 28, runtime_state_fiber_prompt_offset()))
    bu32(code, cg_ldr(10, 9, fiber_prompt_segment_offset()))
    let adr_pos = buf_len(code)
    bu32(code, 0)
    cg_fiber_segment_save_state(code, 10, 12)
    bu32(code, encode_movz(13, 0, 0))
    bu32(code, cg_str(13, 28, runtime_state_fiber_done_offset()))
    bu32(code, cg_str(13, 28, runtime_state_fiber_prompt_offset()))
    cg_fiber_restore_handler_and_ret(code, 9, 11, 1)
    let after_pos = buf_len(code)
    bytes_set_u32(code, adr_pos, encode_adr(12, after_pos - adr_pos))
    bu32(code, encode_add_imm(17, 0, 0))
  } else { if kind == 18 {
    let adr_pos = buf_len(code)
    bu32(code, 0)
    cg_fiber_prompt_save_handler_state(code, 0, 10)
    bu32(code, encode_add_imm(19, 0, 0))
    bu32(code, cg_str(19, 28, runtime_state_fiber_prompt_offset()))
    bu32(code, encode_movz(10, 0, 0))
    bu32(code, cg_str(10, 28, runtime_state_fiber_done_offset()))
    bu32(code, cg_ldr(9, 19, fiber_prompt_segment_offset()))
    cg_fiber_restore_fiber_and_ret(code, 9, 1, 8)
    let after_pos = buf_len(code)
    bytes_set_u32(code, adr_pos, encode_adr(10, after_pos - adr_pos))
    bu32(code, encode_add_imm(17, 0, 0))
  } else { if kind == 19 {
    bu32(code, cg_ldr(17, 28, runtime_state_fiber_done_offset()))
  } else { if kind == 20 {
    bu32(code, encode_add_imm(17, 28, 0))
  } else { if kind == 21 {
    bu32(code, encode_add_imm(28, 0, 0))
    bu32(code, encode_add_imm(17, 28, 0))
  } else { if kind == 22 {
    bu32(code, encode_add_imm(27, 0, 0))
    bu32(code, encode_add_imm(17, 27, 0))
  } else {
    bu32(code, encode_brk(16))
  } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } }
  if kind >= 35 and kind <= 44 { 0 } else { pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17) }
}

fn pipeline_ir_native_hash_name(name: str) -> i64 {
  str_hash(__str_ptr(name), 0, __str_len(name))
}

-- GOT indices compare baked name-hash literals: hash_name previously ran
-- nineteen times per emitted direct call and dominated self-compile
-- profiles. The literals are locked to the hash function by a regression
-- test asserting each equals pipeline_ir_native_hash_name of its name.
fn pipeline_ir_native_got_index_for_hash(callee_hash: i64) -> i64 {
  if callee_hash == 7225106348905112601 { 0 }
  else { if callee_hash == 7062114375511230302 { 1 }
  else { if callee_hash == 8245973757253621670 { 2 }
  else { if callee_hash == 2927634193657110521 { 3 }
  else { if callee_hash == 1386322662856562595 { 4 }
  else { if callee_hash == 8245973757253896919 { 5 }
  else { if callee_hash == 4584027116252628073 { 6 }
  else { if callee_hash == 8245973757254067880 { 7 }
  else { if callee_hash == 8245973757253972190 { 8 }
  else { if callee_hash == 4584027116276555614 { 9 }
  else { if callee_hash == 7381017885952607431 { 10 }
  else { if callee_hash == 7381017885952498738 { 11 }
  else { if callee_hash == 4851938335444742673 { 12 }
  else { if callee_hash == 5906731616008132625 { 13 }
  else { if callee_hash == 8608565206147275382 { 14 }
  else { if callee_hash == 8608565206146786421 { 15 }
  else { if callee_hash == 3781520049545320844 { 16 }
  else { if callee_hash == 677546992517388457 { 17 }
  else { if callee_hash == 4337046861457177760 { 18 }
  else { if callee_hash == 5225036492025295558 { 19 }
  else { if callee_hash == 1649736456565456175 { 20 }
  else { if callee_hash == 3698942247301517355 { 21 }
  else { if callee_hash == 7062114365761545085 { 22 }
  else { if callee_hash == 7062114369200356615 { 23 }
  else { if callee_hash == 6757899404283056959 { 24 }
  else { if callee_hash == 8245973757254120168 { 25 }
  else { if callee_hash == 4584027116264744637 { 26 }
  else { if callee_hash == 3698942246871268454 { 27 }
  else { if callee_hash == 3698942246871248060 { 28 }
  else { if callee_hash == 3698942247301519254 { 29 }
  else { if callee_hash == 7062114344432915092 { 30 }
  else { if callee_hash == 8245973757254000858 { 31 }
  else { if callee_hash == 4584027116273322333 { 0 - 1 }
  else { if callee_hash == 1414571441097212663 { 32 }
  else { if callee_hash == 3772788422263312345 { 33 }
  else { if callee_hash == 4625190581279062124 { 34 }
  else { if callee_hash == 3772788426195212223 { 35 }
  else { if callee_hash == 8245973757253821048 { 36 }
  else { 0 - 1 } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } }
}

fn pipeline_ir_native_emit_got_call(code: i64, dst: i64, gi: i64, args: IrValueList, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  pipeline_ir_native_move_call_args(code, args, 0, pinned)
  let cur = buf_len(code)
  fmap_add_got_patch(fm, cur, gi)
  bu32(code, encode_bl(0))
  pipeline_ir_native_store_reg_pinned(code, pinned, dst, 0)
}

fn pipeline_ir_native_emit_call(code: i64, dst: i64, callee_hash: i64, args: IrValueList, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let intrinsic_kind = pipeline_ir_native_intrinsic_kind(callee_hash)
  if callee_hash == pipeline_ir_pseudo_par_lowering_marker_hash() {
    fmap_inc_par_lowering_count(fm)
  } else { if intrinsic_kind != 0 {
    pipeline_ir_native_emit_intrinsic_call(code, dst, callee_hash, intrinsic_kind, args, pinned, fm)
  } else { if callee_hash == pipeline_ir_vector_len_hash() and ir_value_list_len(args) == 1 {
    pipeline_ir_native_emit_vector_len_i64(code, dst, pipeline_ir_value_list_get_or(args, 0, 0 - 1), fm, pinned)
  } else {
    let got_index = pipeline_ir_native_got_index_for_hash(callee_hash)
    if got_index >= 0 {
      pipeline_ir_native_emit_got_call(code, dst, got_index, args, fm, pinned)
    } else {
      pipeline_ir_native_move_call_args(code, args, 0, pinned)
      let mono_target = mono_cache_lookup(fmap_mono_cache(fm), callee_hash)
      let target = if mono_target == 0 {
        fmap_lookup_by_hash(fm, callee_hash)
      } else {
        mono_target
      }
      let cur = buf_len(code)
      if target <= 1 {
        if mono_cache_lookup(fmap_mono_cache(fm), callee_hash) != 0 {
          fmap_add_patch(fm, cur, 0, callee_hash, 0)
          bu32(code, encode_bl(0))
        } else { if fmap_contains_hash(fm, callee_hash) == 1 {
          fmap_add_patch_by_hash(fm, cur, callee_hash)
          bu32(code, encode_bl(0))
        } else {
          bu32(code, encode_brk(8))
        } }
      } else {
        bu32(code, encode_bl(target - cur))
      }
      pipeline_ir_native_store_reg_pinned(code, pinned, dst, 0)
    }
  } } }
}

fn pipeline_ir_native_emit_call_result_lane(code: i64, dst: i64, lane: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  if lane <= 0 or lane > 7 {
    bu32(code, encode_brk(25))
  } else {
    pipeline_ir_native_store_reg_pinned(code, pinned, dst, lane)
  }
}

fn pipeline_ir_native_emit_return_lane(code: i64, lane: i64, value: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  if lane <= 0 or lane > 7 {
    bu32(code, encode_brk(26))
  } else {
    let phys = pipeline_ir_native_load_reg(code, pinned, value)
    if phys != lane { bu32(code, encode_add_imm(lane, phys, 0)) } else { 0 }
  }
}

fn pipeline_ir_native_emit_indirect_call(code: i64, dst: i64, callee: i64, args: IrValueList, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let callee_phys = pipeline_ir_native_load_reg(code, pinned, callee)
  bu32(code, cg_ldr(9, callee_phys, 0))
  bu32(code, cg_ldr(0, callee_phys, 8))
  pipeline_ir_native_move_call_args(code, args, 1, pinned)
  bu32(code, encode_blr(9))
  pipeline_ir_native_store_reg_pinned(code, pinned, dst, 0)
}

fn pipeline_ir_native_lambda_store_capture_value(code: i64, fm: i64, env_ctr: i64, index: i64, capture: i64, lane: i64, pinned: PipelineIrNativeValueHomeFacts, real: PipelineIrNativeValueHomeFacts) -> i64 {
  -- Dual facts: `pinned` is the identity view (canonical-home
  -- addressing — spill_pinned_lambda_capture_values materialised every
  -- displaced capture there), `real` carries the armed ledger. The
  -- identity view's ledger is never armed, so each canonical read is
  -- recorded against `real` explicitly; the emitted bytes are
  -- unchanged.
  let cap_value = node_f3(capture) + lane
  pipeline_ir_native_ck_read(code, real, pipeline_ir_native_identity_home(cap_value), cap_value)
  let enc_phys = pipeline_ir_native_load_value_temp_pinned(code, pinned, cap_value, 9)
  let env_phys = pipeline_ir_native_load_reg_temp(code, real, env_ctr, 16)
  let val_off = 8 + index * 16
  let flag_off = 16 + index * 16
  bu32(code, cg_str(enc_phys, env_phys, val_off))
  -- Ownership is a lane fact: slices keep their non-owning length lane while
  -- closed structural aggregates can carry managed fields at any position.
  let cap_kind = cg_managed_drop_kind_for_ty_lane(node_f4(capture), lane)
  if cap_kind == continuation_cleanup_kind_rc() {
    cg_emit_rc_retain_phys(code, fm, enc_phys)
    let env_phys2 = pipeline_ir_native_load_reg_raw(code, real, env_ctr)
    emit_mov_imm(code, 9, 1)
    bu32(code, cg_str(9, env_phys2, flag_off))
  } else { if cap_kind == continuation_cleanup_kind_closure() {
    cg_emit_closure_retain_phys(code, fm, enc_phys)
    let env_phys3 = pipeline_ir_native_load_reg_raw(code, real, env_ctr)
    emit_mov_imm(code, 9, 2)
    bu32(code, cg_str(9, env_phys3, flag_off))
  } else { if cap_kind == continuation_cleanup_kind_weak() {
    cg_emit_weak_retain_phys(code, fm, enc_phys)
    let env_phys4 = pipeline_ir_native_load_reg_raw(code, real, env_ctr)
    emit_mov_imm(code, 9, 4)
    bu32(code, cg_str(9, env_phys4, flag_off))
  } else {
    let env_phys5 = pipeline_ir_native_load_reg_raw(code, real, env_ctr)
    emit_mov_imm(code, 9, 0)
    bu32(code, cg_str(9, env_phys5, flag_off))
  } } }
}

-- Load a value from its explicit home fact (swap-promoted bank register,
-- displaced spill home, volatile register, or canonical home) at emission
-- sites that recover value ids outside the main instruction walk.
fn pipeline_ir_native_load_value_temp_pinned(code: i64, pinned: PipelineIrNativeValueHomeFacts, value: i64, temp: i64) -> i64 {
  let phys = pipeline_ir_native_value_home_lookup(pinned, value)
  if phys >= pipeline_ir_native_remat_movn_base() {
    bu32(code, encode_movn(temp, phys - pipeline_ir_native_remat_movn_base()))
    temp
  } else { if phys >= pipeline_ir_native_remat_base() {
    bu32(code, encode_movz(temp, phys - pipeline_ir_native_remat_base(), 0))
    temp
  } else { if phys >= 1000 or phys == pipeline_ir_native_discard_home() {
    bu32(code, encode_brk(20))
    17
  } else { if phys < 0 {
    pipeline_ir_native_ck_read(code, pinned, phys, value)
    emit_load_spill_offset(code, temp, (0 - phys - 1) * 8)
    temp
  } else { if phys != 0 {
    pipeline_ir_native_ck_read(code, pinned, phys, value)
    phys
  } else {
    bu32(code, encode_brk(20))
    17
  } } } } }
}

fn pipeline_ir_native_spill_pinned_value(code: i64, value: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let phys = pipeline_ir_native_value_home_lookup(pinned, value)
  if phys >= pipeline_ir_native_remat_movn_base() {
    bu32(code, encode_movn(16, phys - pipeline_ir_native_remat_movn_base()))
    pipeline_ir_native_store_reg(code, pinned, value, 16)
  } else { if phys >= pipeline_ir_native_remat_base() {
    -- A remat-homed constant has no canonical store anywhere; sites
    -- that later read the canonical home through identity facts
    -- (lambda env builds) need it materialised first.
    bu32(code, encode_movz(16, phys - pipeline_ir_native_remat_base(), 0))
    pipeline_ir_native_store_reg(code, pinned, value, 16)
  } else { if phys > 0 and phys < 1000 and phys != pipeline_ir_native_discard_home() and phys != pipeline_ir_native_identity_home(value) {
    pipeline_ir_native_store_reg(code, pinned, value, phys)
  } else { 0 } } }
}

fn pipeline_ir_native_spill_pinned_lambda_capture_value(code: i64, capture: i64, lane: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  pipeline_ir_native_spill_pinned_value(code, node_f3(capture) + lane, pinned)
}

fn pipeline_ir_native_spill_pinned_lambda_capture_values(code: i64, captures: i64, nfree: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let mut i = 0
  while i < nfree {
    let capture = nlist_get(captures, i)
    let lanes = pipeline_capture_lane_count(capture)
    for lane in 0..lanes {
      pipeline_ir_native_spill_pinned_lambda_capture_value(code, capture, lane, pinned)
    }
    i = i + 1
  }
  0
}

fn pipeline_ir_native_lambda_store_capture_values(code: i64, fm: i64, env_ctr: i64, captures: i64, nfree: i64, pinned: PipelineIrNativeValueHomeFacts, real: PipelineIrNativeValueHomeFacts) -> i64 {
  let mut i = 0
  let mut word = 0
  while i < nfree {
    let capture = nlist_get(captures, i)
    let lanes = pipeline_capture_lane_count(capture)
    for lane in 0..lanes {
      pipeline_ir_native_lambda_store_capture_value(code, fm, env_ctr, word, capture, lane, pinned, real)
      word = word + 1
    }
    i = i + 1
  }
  0
}

fn pipeline_typed_expr_list_performs_key(exprs: ExprList, src: i64, effect_key: i64, subst: i64) -> i64 {
  match exprs {
    ExprListNil -> 0
    ExprListCons(expr, rest) -> {
      if pipeline_typed_expr_performs_key(expr, src, effect_key, subst) == 1 { 1 } else { pipeline_typed_expr_list_performs_key(rest, src, effect_key, subst) }
    }
  }
}

fn pipeline_typed_expr_performs_key(expr: Expr, src: i64, effect_key: i64, subst: i64) -> i64 {
  match expr {
    Perform(lhs, op_ns, op_nl, args) -> {
      let hit = if pipeline_effect_ref_dispatch_key_typed(src, lhs, subst) == effect_key { 1 } else { 0 }
      if hit == 1 { 1 } else { pipeline_typed_expr_list_performs_key(args, src, effect_key, subst) }
    }
    BinOp(op, lhs, rhs) -> if pipeline_typed_expr_performs_key(lhs, src, effect_key, subst) == 1 { 1 } else { pipeline_typed_expr_performs_key(rhs, src, effect_key, subst) }
    Call(ns, nl, args) -> pipeline_typed_expr_list_performs_key(args, src, effect_key, subst)
    GenericCall(type_args, inner_call) -> pipeline_typed_expr_performs_key(inner_call, src, effect_key, subst)
    If(cond, then_expr, else_expr) -> if pipeline_typed_expr_performs_key(cond, src, effect_key, subst) == 1 { 1 } else { if pipeline_typed_expr_performs_key(then_expr, src, effect_key, subst) == 1 { 1 } else { pipeline_typed_expr_performs_key(else_expr, src, effect_key, subst) } }
    While(cond, body) -> if pipeline_typed_expr_performs_key(cond, src, effect_key, subst) == 1 { 1 } else { pipeline_typed_expr_performs_key(body, src, effect_key, subst) }
    Loop(body) -> pipeline_typed_expr_performs_key(body, src, effect_key, subst)
    Break(value) -> pipeline_typed_expr_performs_key(value, src, effect_key, subst)
    Return(value) -> pipeline_typed_expr_performs_key(value, src, effect_key, subst)
    Defer(cleanup, body) -> if pipeline_typed_expr_performs_key(cleanup, src, effect_key, subst) == 1 { 1 } else { pipeline_typed_expr_performs_key(body, src, effect_key, subst) }
    Let(ns, nl, value, body) -> if pipeline_typed_expr_performs_key(value, src, effect_key, subst) == 1 { 1 } else { pipeline_typed_expr_performs_key(body, src, effect_key, subst) }
    LetMut(ns, nl, value, body) -> if pipeline_typed_expr_performs_key(value, src, effect_key, subst) == 1 { 1 } else { pipeline_typed_expr_performs_key(body, src, effect_key, subst) }
    Assign(ns, nl, value) -> pipeline_typed_expr_performs_key(value, src, effect_key, subst)
    Block(first, rest) -> if pipeline_typed_expr_performs_key(first, src, effect_key, subst) == 1 { 1 } else { pipeline_typed_expr_performs_key(rest, src, effect_key, subst) }
    -- A nested closure can escape its enclosing closure. The outer env must
    -- therefore carry the lexical handler evidence that the inner closure
    -- will copy into its own env when constructed.
    Lambda(params, body) -> pipeline_typed_expr_performs_key(body, src, effect_key, subst)
    FieldAccess(base, field_ns, field_nl, fact) -> pipeline_typed_expr_performs_key(base, src, effect_key, subst)
    IndexedLen(base, fixed_len) -> pipeline_typed_expr_performs_key(base, src, effect_key, subst)
    IndexedGet(base, index, element_ty, fixed_len) -> if pipeline_typed_expr_performs_key(base, src, effect_key, subst) == 1 { 1 } else { pipeline_typed_expr_performs_key(index, src, effect_key, subst) }
    IndexedSet(base, index, value, fact) -> if pipeline_typed_expr_performs_key(base, src, effect_key, subst) == 1 or pipeline_typed_expr_performs_key(index, src, effect_key, subst) == 1 or pipeline_typed_expr_performs_key(value, src, effect_key, subst) == 1 { 1 } else { 0 }
    IndexedSlice(base, start, end, fact) -> if pipeline_typed_expr_performs_key(base, src, effect_key, subst) == 1 or pipeline_typed_expr_performs_key(start, src, effect_key, subst) == 1 or pipeline_typed_expr_performs_key(end, src, effect_key, subst) == 1 { 1 } else { 0 }
    Match(scrutinee, arms) -> if pipeline_typed_expr_performs_key(scrutinee, src, effect_key, subst) == 1 { 1 } else { pipeline_typed_match_arms_perform_key(arms, src, effect_key, subst) }
    Not(operand) -> pipeline_typed_expr_performs_key(operand, src, effect_key, subst)
    Resume(value) -> pipeline_typed_expr_performs_key(value, src, effect_key, subst)
    Try(inner, effect_atom) -> {
      if pipeline_effect_atom_dispatch_key(effect_atom, subst, effect_fail_head_hash()) == effect_key { 1 }
      else { pipeline_typed_expr_performs_key(inner, src, effect_key, subst) }
    }
    OptChain(base, field_ns, field_nl, effect_atom) -> {
      if pipeline_effect_atom_dispatch_key(effect_atom, subst, effect_maybe_head_hash()) == effect_key { 1 }
      else { pipeline_typed_expr_performs_key(base, src, effect_key, subst) }
    }
    InterpConcat(left, right) -> if pipeline_typed_expr_performs_key(left, src, effect_key, subst) == 1 { 1 } else { pipeline_typed_expr_performs_key(right, src, effect_key, subst) }
    ForIter(var_ns, var_nl, collection, body) -> if pipeline_typed_expr_performs_key(collection, src, effect_key, subst) == 1 { 1 } else { pipeline_typed_expr_performs_key(body, src, effect_key, subst) }
    LetTyped(inner, ann_type) -> pipeline_typed_expr_performs_key(inner, src, effect_key, subst)
    MethodCall(recv, method_hash, args, type_hash) -> if pipeline_typed_expr_performs_key(recv, src, effect_key, subst) == 1 { 1 } else { pipeline_typed_expr_list_performs_key(args, src, effect_key, subst) }
    _ -> 0
  }
}

fn pipeline_typed_match_arms_perform_key(arms: MatchArmList, src: i64, effect_key: i64, subst: i64) -> i64 {
  match arms {
    MatchArmListNil -> 0
    MatchArmListCons(arm, rest) -> {
      let hit = match arm {
        Arm(pattern, body, guard, has_guard) -> pipeline_typed_expr_performs_key(body, src, effect_key, subst)
        UnknownArm(tag) -> 0
      }
      if hit == 1 { 1 } else { pipeline_typed_match_arms_perform_key(rest, src, effect_key, subst) }
    }
  }
}

fn pipeline_lambda_evidence_op_hashes(clauses: HandlerClauseList, nclauses: i64, hash_src: i64) -> i64 {
  let hashes = nlist_new()
  for ci in 0..nclauses {
    nlist_add(hashes, pipeline_handler_clause_op_hash_typed(hash_src, handler_clause_list_nth(clauses, ci)))
  }
  hashes
}

-- Raw registry entry: fn hash, effect hash, ordered op hashes, evidence SSA
-- value. The registry is derived exclusively from IrClosureI64 lowering
-- facts before ordinary-function emission.
fn pipeline_ir_lambda_evidence_fact(fn_hash: i64, eff_hash: i64, op_hashes: i64, value: i64) -> i64 {
  node_new(0, fn_hash, eff_hash, op_hashes, value)
}

fn pipeline_ir_lambda_evidence_registry_ensure(fm: i64) -> i64 {
  let existing = fmap_lambda_evidence_facts(fm)
  if existing != 0 { existing }
  else {
    let facts = nlist_new()
    fmap_set_lambda_evidence_facts(fm, facts)
    facts
  }
}

fn pipeline_ir_lambda_evidence_registry_lookup(fm: i64, fn_hash: i64) -> i64 {
  let facts = fmap_lambda_evidence_facts(fm)
  if facts == 0 { 0 }
  else {
    let n = nlist_len(facts)
    let mut found = 0
    let mut i = 0
    while i < n and found == 0 {
      let fact = nlist_get(facts, i)
      if node_f1(fact) == fn_hash { found = fact } else { i = i + 1 }
    }
    found
  }
}

fn pipeline_ir_lambda_evidence_registry_add(fm: i64, fn_hash: i64, evidence: IrLambdaEvidence) -> i64 {
  match evidence {
    IrLambdaEvidenceNone -> 0
    IrLambdaEvidenceBound(eff_hash, op_hashes, value) -> {
      if pipeline_ir_lambda_evidence_registry_lookup(fm, fn_hash) != 0 { 0 }
      else {
        nlist_add(pipeline_ir_lambda_evidence_registry_ensure(fm), pipeline_ir_lambda_evidence_fact(fn_hash, eff_hash, op_hashes, value))
        0
      }
    }
  }
}

fn pipeline_ir_native_handler_evidence_ops_value(handlers: PipelineNativeHandlerCtx, eff_hash: i64, src: i64) -> i64 {
  match handlers {
    PipelineNativeHandlerCtxNil -> 0 - 1
    PipelineNativeHandlerCtxCons(ctx_eff, infos, nclauses, ops_ctr, frame_ctr, is_abortive, rest) -> {
      if frame_ctr >= 0 and nclauses > 0 {
        if ctx_eff == eff_hash { ops_ctr }
        else { pipeline_ir_native_handler_evidence_ops_value(rest, eff_hash, src) }
      } else {
        pipeline_ir_native_handler_evidence_ops_value(rest, eff_hash, src)
      }
    }
  }
}

fn pipeline_ir_native_closure_evidence_ops_value(evidence: IrLambdaEvidence, handlers: PipelineNativeHandlerCtx, fm: i64, src: i64) -> i64 {
  match evidence {
    IrLambdaEvidenceNone -> 0 - 1
    IrLambdaEvidenceBound(eff_hash, op_hashes, value) -> {
      let active = pipeline_ir_native_handler_evidence_ops_value(handlers, eff_hash, src)
      if active >= 0 { active }
      else {
        if fmap_lambda_evidence_eff(fm) == eff_hash { fmap_lambda_evidence_value(fm) }
        else { 0 - 1 }
      }
    }
  }
}

fn pipeline_nlist_index_of(list: i64, target: i64) -> i64 {
  if list == 0 { 0 - 1 }
  else {
    let n = nlist_len(list)
    let mut i = 0
    let mut result = 0 - 1
    while i < n {
      if nlist_get(list, i) == target {
        result = i
        i = n
      } else { i = i + 1 }
    }
    result
  }
}

fn pipeline_ir_native_emit_lambda_env_evidence_store(code: i64, env_ctr: i64, nfree: i64, evidence_ops_ctr: i64, real: PipelineIrNativeValueHomeFacts) -> i64 {
  if evidence_ops_ctr < 0 { 0 }
  else {
    let ops_phys = pipeline_ir_native_load_reg_temp(code, real, evidence_ops_ctr, 16)
    let env_phys = pipeline_ir_native_load_reg_temp(code, real, env_ctr, 17)
    bu32(code, cg_str(ops_phys, env_phys, 8 + nfree * 16))
  }
}

fn pipeline_ir_native_emit_lambda_env_captures(code: i64, fm: i64, closure_ctr: i64, captures: i64, nfree: i64, pinned: PipelineIrNativeValueHomeFacts, real: PipelineIrNativeValueHomeFacts, evidence_ops_ctr: i64) -> i64 {
  if nfree <= 0 and evidence_ops_ctr < 0 {
    let closure_phys = pipeline_ir_native_load_reg_raw(code, real, closure_ctr)
    emit_mov_imm(code, 17, 0)
    bu32(code, cg_str(17, closure_phys, 8))
  } else {
    let env_size = 8 + nfree * 16 + if evidence_ops_ctr < 0 { 0 } else { 8 }
    cg_emit_rc_default_alloc_nozero_raw(code, fm, env_size, 8)
    let env_ctr = closure_ctr + 1
    pipeline_ir_native_store_reg(code, real, env_ctr, 0)
    let env_phys = pipeline_ir_native_load_reg_raw(code, real, env_ctr)
    emit_mov_imm(code, 9, nfree)
    bu32(code, cg_str(9, env_phys, 0))
    pipeline_ir_native_lambda_store_capture_values(code, fm, env_ctr, captures, nlist_len(captures), pinned, real)
    pipeline_ir_native_emit_lambda_env_evidence_store(code, env_ctr, nfree, evidence_ops_ctr, real)
    let closure_phys2 = pipeline_ir_native_load_reg_temp(code, real, closure_ctr, 16)
    let env_phys2 = pipeline_ir_native_load_reg_temp(code, real, env_ctr, 17)
    bu32(code, cg_str(env_phys2, closure_phys2, 8))
  }
}

-- A named fn used as a value captures nothing: its [thunk_ptr, env=0]
-- pair is a constant. Sites share a lazily-initialised 16-byte slot in
-- zero-fill data keyed by callee hash instead of allocating a fresh rc
-- pair per execution (2q slice 1). The thunk stays per-site: the
-- cold-path ADR that materialises its address reaches only ±1MB, and a
-- shared thunk emitted at the first site can sit further away.
-- Retain/release/cleanup on the slot address no-op structurally:
-- rc_default_payload_has_magic bounds-checks against the rc heap arena
-- before reading any header, and the slot lives outside it.
fn pipeline_ir_native_emit_function_ref(code: i64, dst: i64, callee_hash: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let b_over_pos = buf_len(code)
  bu32(code, 0)
  let thunk_off = buf_len(code)
  bu32(code, encode_add_imm(0, 1, 0))
  bu32(code, encode_add_imm(1, 2, 0))
  bu32(code, encode_add_imm(2, 3, 0))
  bu32(code, encode_add_imm(3, 4, 0))
  bu32(code, encode_add_imm(4, 5, 0))
  bu32(code, encode_add_imm(5, 6, 0))
  bu32(code, encode_add_imm(6, 7, 0))
  let branch_pos = buf_len(code)
  let mono_target = mono_cache_lookup(fmap_mono_cache(fm), callee_hash)
  let target = if mono_target == 0 {
    fmap_lookup_by_hash(fm, callee_hash)
  } else {
    mono_target
  }
  if target > 1 {
    bu32(code, encode_b(target - branch_pos))
  } else {
    if mono_cache_lookup(fmap_mono_cache(fm), callee_hash) != 0 or fmap_contains_hash(fm, callee_hash) == 1 {
      fmap_add_branch_patch_by_hash(fm, branch_pos, callee_hash)
      bu32(code, encode_b(0))
    } else {
      bu32(code, encode_brk(18))
    }
  }
  bytes_set_u32(code, b_over_pos, encode_b(buf_len(code) - b_over_pos))
  let cached = fmap_static_pair_slot_lookup(fm, callee_hash)
  let slot_off = if cached < 0 { fmap_static_pair_slot_reserve(fm, callee_hash) } else { cached }
  fmap_inc_static_pair_site_count(fm)
  -- ADRP page delta is patched by the executable emitter once the data
  -- page position is known, or relocated by PAGE21/PAGEOFF12 in the .o
  -- path. The ADD low bits are final for executables (the data page is
  -- 4KB-aligned) and overwritten by ld for objects.
  let adrp_pos = buf_len(code)
  fmap_add_static_pair_patch(fm, adrp_pos, slot_off)
  bu32(code, encode_adrp(17, 0))
  bu32(code, encode_add_imm(17, 17, slot_off - slot_off / 4096 * 4096))
  bu32(code, cg_ldr(9, 17, 0))
  bu32(code, encode_cbnz(9, 12))
  let adr_pos = buf_len(code)
  bu32(code, encode_adr(9, thunk_off - adr_pos))
  bu32(code, cg_str(9, 17, 0))
  pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17)
}

-- Hoisted-closure construction (2k slice A): the body is a standalone
-- ordinary function emitted through the normal per-function driver, so
-- this site only builds the [code, env] pair. An already-emitted target
-- within ADR's +/-1MB range is addressed directly; forward/distant
-- targets use a 4-byte local `b <fn>` thunk resolved by the same hash-
-- patch machinery as direct calls. The closure ABI is exactly a direct
-- call with env first, so no argument shifting is needed (unlike the
-- named-fn-as-value thunk).
fn pipeline_ir_native_adr_offset_fits(offset: i64) -> i64 {
  if offset >= 0 - 1048576 and offset <= 1048575 { 1 } else { 0 }
}

fn pipeline_ir_native_emit_closure(code: i64, dst: i64, f: IrFunction, captures: i64, evidence: IrLambdaEvidence, fm: i64, ctx: PipelineNativeEmitCtx) -> i64 {
  let pinned = pipeline_ir_native_emit_ctx_pinned(ctx)
  let handlers = pipeline_ir_native_emit_ctx_handlers(ctx)
  let fns = pipeline_ir_native_emit_ctx_fns(ctx)
  let nfree = nlist_len(captures)
  let capture_lanes = pipeline_capture_value_lane_count(captures)
  fmap_inc_hoisted_closure_emit_count(fm)
  match f {
    IrFunction(fn_hash, fparams, fblocks, fsrc) -> {
      pipeline_ir_lambda_evidence_registry_add(fm, fn_hash, evidence)
      if nfree > 0 {
        pipeline_ir_native_spill_pinned_lambda_capture_values(code, captures, nfree, pinned)
      } else { 0 }
      cg_emit_rc_default_alloc_nozero_lit(code, fm, continuation_cleanup_kind_closure(), 16, 8)
      pipeline_ir_native_store_reg_pinned(code, pinned, dst, 0)
      let closure_phys = pipeline_ir_native_load_reg(code, pinned, dst)
      let mono_target = mono_cache_lookup(fmap_mono_cache(fm), fn_hash)
      let emitted_target = if mono_target > 1 { mono_target } else { fmap_lookup_by_hash(fm, fn_hash) }
      let direct_offset = emitted_target - buf_len(code)
      if emitted_target > 1 and pipeline_ir_native_adr_offset_fits(direct_offset) == 1 {
        let adr_pos = buf_len(code)
        bu32(code, encode_adr(17, emitted_target - adr_pos))
      } else {
        -- Keep the thunk adjacent to its address materialisation: ADR
        -- reaches it for every function size, and B reaches the target
        -- across the whole native module. The leading branch skips the
        -- thunk without disturbing the live closure pointer register.
        bu32(code, encode_b(8))
        let thunk_off = buf_len(code)
        if emitted_target > 1 {
          bu32(code, encode_b(emitted_target - thunk_off))
        } else {
          if mono_target != 0 or fmap_contains_hash(fm, fn_hash) == 1 {
            fmap_add_branch_patch_by_hash(fm, thunk_off, fn_hash)
            bu32(code, encode_b(0))
          } else {
            bu32(code, encode_brk(19))
          }
        }
        let adr_pos = buf_len(code)
        bu32(code, encode_adr(17, thunk_off - adr_pos))
      }
      bu32(code, cg_str(17, closure_phys, 0))
      pipeline_ir_native_spill_pinned_value(code, dst, pinned)
      let evidence_ops = pipeline_ir_native_closure_evidence_ops_value(evidence, handlers, fm, fsrc)
      match evidence {
        IrLambdaEvidenceNone -> 0
        IrLambdaEvidenceBound(eff_hash, op_hashes, value) -> {
          if evidence_ops < 0 { bu32(code, encode_brk(20)) } else { 0 }
        }
      }
      pipeline_ir_native_emit_lambda_env_captures(code, fm, dst, captures, capture_lanes, pipeline_ir_native_identity_home_facts_like(pinned), pinned, evidence_ops)
    }
  }
}

fn pipeline_ir_native_vector_push_hash() -> i64 {
  str_hash(__str_ptr("vector_push"), 0, __str_len("vector_push"))
}

fn pipeline_ir_native_vector_sum_i64_hash() -> i64 {
