-- GPR clobber footprint of an inline-emitting intrinsic. This fact feeds the
-- resident-value allocator's interference model. Bit n set =
-- the emission may write xn, INCLUDING move_call_args staging
-- (x0..arity-1 for move_call_args kinds), load_reg spill/remat staging
-- (x16), and the x17 result cell. 0 - 1 = full caller-saved clobber
-- (true barrier): real calls (14/15), fiber stack switches (16-18),
-- syscalls/platform ABI leaves (34/47-143), bump-alloc and
-- the sized mem family (1/23/24 — their grow/copy arms BL out), and
-- any unknown kind. d/s-register scratch (the float converts 25-33
-- stage through d0/s0) is NOT covered here — the fp barrier
-- classification owns the FP file. x27/x28 writes (kinds 21/22) are
-- outside the tracked file. The scratch audit moved bespoke arms off the
-- pools: 2/3/8 read via load_reg with x15 staging (no move_call_args),
-- 12 loops through x15/x16/x17, 35-37 stage base in x15 and the value
-- in x17, 38-43 carry the value in x17 and read the address direct.
-- Only content-eq (44) still needs pool scratch (x10-x15 — a 6-register
-- byte loop; 4 non-pool scratch regs exist). Audited against
-- pipeline_ir_native_emit_intrinsic_call arm by arm 2026-08-03; a new
-- intrinsic kind MUST be added here or it is conservatively a true
-- barrier.
pub(package) fn pipeline_ir_native_intrinsic_clobber_mask(kind: i64) -> i64 {
  if kind == 45 { return 131072 } else { 0 }           -- x17
  if kind == 46 { return 65536 } else { 0 }            -- x16 load scratch; x27 is outside the pool
  if kind >= 47 and kind <= 143 { return 0 - 1 } else { 0 }
  -- 196608 = x16|x17; 196609 adds x0; 229376 = x15|x16|x17; 229377 adds x0
  if kind == 2 or kind == 3 or kind == 8 { 229376 }
  else { if kind == 4 or kind == 5 or kind == 6 or kind == 7 or kind == 9 or kind == 10 or kind == 11 { 196609 }
  else { if kind == 12 { 229377 }
  else { if kind == 13 { 196609 }
  else { if kind == 19 or kind == 20 { 196608 }
  else { if kind == 21 or kind == 22 { 196609 }
  else { if kind >= 25 and kind <= 33 { 196609 }
  else { if kind >= 35 and kind <= 37 { 229376 }
  else { if kind >= 38 and kind <= 43 { 196608 }
  else { if kind == 44 { 261120 }                     -- x10-x15|x16|x17
  else { 0 - 1 } } } } } } } } } }
}

-- An intrinsic is pool-transparent when its
-- audited clobber mask misses every register the caller-saved pools can
-- hand out (x1-x14; bits 1-14 = 32766) — the emission touches only x0
-- arg staging, x16 spill scratch, and the x17 result cell (plus x27/x28
-- for the runtime-state writers, outside the tracked file). A
-- pool-transparent intrinsic is NO BARRIER AT ALL to the resident walk:
-- operand reads stage through move_call_args and the result store goes
-- through store_reg_pinned, both pinned-map-aware, so pool, bank, split,
-- and naked tenancies survive it (no BL is emitted, so naked's missing
-- lr save is safe too). CONTRACT: flipping simple also short-circuits
-- fp_simple, so a mask below 32768 additionally asserts the arm never
-- writes the d2-d7 FP pool — kinds 25-33 stage through d0/s0 only,
-- every other transparent kind is GPR-pure. Auditing a new kind's mask
-- into the transparent range asserts BOTH register files.
pub(package) fn pipeline_ir_native_intrinsic_pool_transparent(kind: i64) -> i64 {
  let mask = pipeline_ir_native_intrinsic_clobber_mask(kind)
  if mask == 0 - 1 { 0 }
  else { if (mask band 32766) == 0 { 1 } else { 0 } }
}

