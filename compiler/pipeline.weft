fn pipeline_lowered_loop_blocks_invalid(next_block: i64, next_value: i64) -> PipelineLoweredLoopBlocks {
  PipelineLoweredLoopBlocks(next_block, next_value, ir_block_list_empty(), 0, 0, 0)
}

