  else { if callee_hash == pipeline_ir_native_intrinsic_fiber_suspend_hash() { 17 }
  else { if callee_hash == pipeline_ir_native_intrinsic_fiber_resume_hash() { 18 }
  else { if callee_hash == pipeline_ir_native_intrinsic_fiber_is_done_hash() { 19 }
  else { if callee_hash == pipeline_ir_native_intrinsic_runtime_state_hash() { 20 }
