}

fn pipeline_lowered_loop_blocks_from_expr(lowered: PipelineLoweredBlocks, exits_loop: i64, continues_body: i64) -> PipelineLoweredLoopBlocks {
  PipelineLoweredLoopBlocks(
    pipeline_lowered_blocks_next_block(lowered),
    pipeline_lowered_blocks_next_value(lowered),
    pipeline_lowered_blocks_blocks(lowered),
    pipeline_lowered_blocks_is_valid(lowered),
    exits_loop,
    continues_body
  )
}

