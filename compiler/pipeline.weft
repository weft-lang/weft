fn pipeline_handle_clauses_use_function_value(clauses: i64, nclauses: i64, src: i64, fnhashes: i64, locals: i64) -> i64 {
  let mut found = false
  let mut i = 0
  while i < nclauses {
    let clause = nlist_get(clauses, i)
    let clause_locals = pipeline_params_add_locals(node_f2(clause), src, locals)
    if pipeline_expr_uses_function_value(node_f3(clause), src, fnhashes, clause_locals) {
      found = true
      i = nclauses
    } else { i = i + 1 }
  }
  found
}

fn pipeline_expr_uses_function_value(node: i64, src: i64, fnhashes: i64, locals: i64) -> i64 {
  if node == 0 { false }
  else {
    match node_tag(node) {
      2 -> {
        let h = str_hash(src, node_f1(node), node_f2(node))
        pipeline_hash_list_contains(fnhashes, h) and not pipeline_hash_list_contains(locals, h)
      }
      3 -> pipeline_expr_uses_function_value(node_f2(node), src, fnhashes, locals) or pipeline_expr_uses_function_value(node_f3(node), src, fnhashes, locals)
      4 -> pipeline_expr_list_uses_function_value(node_f3(node), node_f4(node), src, fnhashes, locals)
      5 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals) or pipeline_expr_uses_function_value(node_f2(node), src, fnhashes, locals) or pipeline_expr_uses_function_value(node_f3(node), src, fnhashes, locals)
      6 -> {
        if pipeline_expr_uses_function_value(node_f3(node), src, fnhashes, locals) { true }
        else {
          let next_locals = pipeline_locals_add_name(locals, src, node_f1(node), node_f2(node))
          pipeline_expr_uses_function_value(node_f4(node), src, fnhashes, next_locals)
        }
      }
      7 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals) or pipeline_expr_uses_function_value(node_f2(node), src, fnhashes, locals)
      10 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals) or pipeline_expr_uses_function_value(node_f2(node), src, fnhashes, locals)
      11 -> {
        if pipeline_expr_uses_function_value(node_f3(node), src, fnhashes, locals) { true }
        else {
          let next_locals = pipeline_locals_add_name(locals, src, node_f1(node), node_f2(node))
          pipeline_expr_uses_function_value(node_f4(node), src, fnhashes, next_locals)
        }
      }
      12 -> pipeline_expr_uses_function_value(node_f3(node), src, fnhashes, locals)
      13 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals)
      14 -> pipeline_record_fields_use_function_value(node_f3(node), node_f4(node), src, fnhashes, locals)
      15 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals) or pipeline_match_arms_use_function_value(node_f2(node), node_f3(node), src, fnhashes, locals)
      22 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals)
      25 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals)
      26 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals)
      29 -> {
        let lambda_locals = pipeline_params_add_locals(node_f1(node), src, locals)
        pipeline_expr_uses_function_value(node_f2(node), src, fnhashes, lambda_locals)
      }
      32 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals) or pipeline_expr_list_uses_function_value(node_f4(node), nlist_len(node_f4(node)), src, fnhashes, locals)
      33 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals) or pipeline_handle_clauses_use_function_value(node_f2(node), node_f3(node), src, fnhashes, locals)
      35 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals)
      36 -> pipeline_expr_uses_function_value(node_f2(node), src, fnhashes, locals)
      37 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals)
      41 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals) or pipeline_expr_list_uses_function_value(node_f3(node), nlist_len(node_f3(node)), src, fnhashes, locals)
      45 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals)
      46 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals) or pipeline_expr_uses_function_value(node_f2(node), src, fnhashes, locals)
      47 -> pipeline_expr_uses_function_value(node_f3(node), src, fnhashes, locals) or pipeline_expr_uses_function_value(node_f4(node), src, fnhashes, locals)
      48 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals)
      49 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals)
      52 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals) or pipeline_expr_uses_function_value(node_f2(node), src, fnhashes, locals)
      _ -> false
    }
  }
}

fn pipeline_rc_runtime_name(src: i64, ns: i64, nl: i64) -> i64 {
  src_eq(src, ns, nl, "rc_default_alloc") == 1 or
  src_eq(src, ns, nl, "rc_default_retain") == 1 or
  src_eq(src, ns, nl, "rc_default_release") == 1 or
  src_eq(src, ns, nl, "closure_default_retain") == 1 or
  src_eq(src, ns, nl, "closure_default_release") == 1 or
  src_eq(src, ns, nl, "rc_count") == 1
}

fn pipeline_expr_list_needs_rc_runtime(args: i64, nargs: i64, src: i64) -> i64 {
  let mut found = false
  let mut i = 0
  while i < nargs {
    if pipeline_expr_needs_rc_runtime(nlist_get(args, i), src) {
      found = true
