pub(package) fn pipeline_ir_native_intrinsic_tcp_kind(callee_hash: i64) -> i64 {
  if callee_hash == pipeline_ir_native_intrinsic_platform_tcp_af_inet_hash() { return 100 } else { 0 }
  if callee_hash == pipeline_ir_native_intrinsic_platform_tcp_af_inet6_hash() { return 101 } else { 0 }
  if callee_hash == pipeline_ir_native_intrinsic_platform_tcp_sockaddr_prefix_hash() { return 102 } else { 0 }
  if callee_hash == pipeline_ir_native_intrinsic_platform_tcp_socket_hash() { return 103 } else { 0 }
  if callee_hash == pipeline_ir_native_intrinsic_platform_tcp_connect_hash() { return 104 } else { 0 }
  if callee_hash == pipeline_ir_native_intrinsic_platform_tcp_bind_hash() { return 105 } else { 0 }
  if callee_hash == pipeline_ir_native_intrinsic_platform_tcp_listen_hash() { return 106 } else { 0 }
