fn pipeline_native_binary_format(native: NativeModule) -> BinaryFormat {
  match native {
    NativeModule(code, fm, functions) -> {
      let ngot = __mem_load64(fm + 128)
      binary_format_default_for_relocations(ngot)
    }
  }
}

fn pipeline_native_binary_format_kind(native: NativeModule) -> i64 {
  binary_format_kind(pipeline_native_binary_format(native))
}

