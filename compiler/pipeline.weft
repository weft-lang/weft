    HandlerClauseListNil -> false
    HandlerClauseListCons(clause, rest) -> {
      if pipeline_expr_has_non_native_scalar_typed(handler_clause_body_expr(clause)) == 1 {
        true
      } else {
        pipeline_handler_clause_list_has_non_native_scalar_typed(rest)
      }
    }
  }
}

fn pipeline_expr_has_non_native_scalar_typed(expr: Expr) -> bool {
  match expr {
    IntLit(value, start, len) -> false
    BoolLit(value) -> false
    Ident(ns, nl) -> false
    NilExpr -> false
    BreakNoValue -> false
    Continue -> false
    ReturnNoValue -> false
    StringLit(start, len) -> true
    FloatLit(start, len) -> true
    BinOp(op, lhs, rhs) -> pipeline_expr_has_non_native_scalar_typed(lhs) or pipeline_expr_has_non_native_scalar_typed(rhs)
    Call(ns, nl, args) -> pipeline_expr_list_has_non_native_scalar_typed(args)
    GenericCall(type_args, inner_call) -> pipeline_expr_has_non_native_scalar_typed(inner_call)
    If(cond, then_expr, else_expr) -> pipeline_expr_has_non_native_scalar_typed(cond) or pipeline_expr_has_non_native_scalar_typed(then_expr) or pipeline_expr_has_non_native_scalar_typed(else_expr)
    While(cond, body) -> pipeline_expr_has_non_native_scalar_typed(cond) or pipeline_expr_has_non_native_scalar_typed(body)
    Loop(body) -> pipeline_expr_has_non_native_scalar_typed(body)
    Break(value) -> pipeline_expr_has_non_native_scalar_typed(value)
    Return(value) -> pipeline_expr_has_non_native_scalar_typed(value)
    Defer(cleanup, body) -> pipeline_expr_has_non_native_scalar_typed(cleanup) or pipeline_expr_has_non_native_scalar_typed(body)
    Let(ns, nl, value, body) -> pipeline_expr_has_non_native_scalar_typed(value) or pipeline_expr_has_non_native_scalar_typed(body)
    LetMut(ns, nl, value, body) -> pipeline_expr_has_non_native_scalar_typed(value) or pipeline_expr_has_non_native_scalar_typed(body)
    Assign(ns, nl, value) -> pipeline_expr_has_non_native_scalar_typed(value)
    AddressOf(mutable, target) -> pipeline_expr_has_non_native_scalar_typed(target)
    Deref(ptr) -> pipeline_expr_has_non_native_scalar_typed(ptr)
    PtrAssign(ptr, value) -> pipeline_expr_has_non_native_scalar_typed(ptr) or pipeline_expr_has_non_native_scalar_typed(value)
    Block(first, rest) -> pipeline_expr_has_non_native_scalar_typed(first) or pipeline_expr_has_non_native_scalar_typed(rest)
    FieldAccess(base, field_ns, field_nl, fact) -> pipeline_expr_has_non_native_scalar_typed(base)
    IndexedLen(base, fixed_len) -> pipeline_expr_has_non_native_scalar_typed(base)
    IndexedGet(base, index, element_ty, fixed_len) -> pipeline_expr_has_non_native_scalar_typed(base) or pipeline_expr_has_non_native_scalar_typed(index) or pipeline_prim_is_non_native_int(pipeline_type_node_prim_id_or(element_ty, 0)) == 1
    IndexedSet(base, index, value, fact) -> pipeline_expr_has_non_native_scalar_typed(base) or pipeline_expr_has_non_native_scalar_typed(index) or pipeline_expr_has_non_native_scalar_typed(value)
    IndexedSlice(base, start, end, fact) -> pipeline_expr_has_non_native_scalar_typed(base) or pipeline_expr_has_non_native_scalar_typed(start) or pipeline_expr_has_non_native_scalar_typed(end)
    RecordInit(type_ns, type_nl, fields) -> pipeline_record_fields_have_non_native_scalar_typed(fields)
    ArrayLiteral(elements, resolved_ty, span) -> pipeline_expr_list_has_non_native_scalar_typed(elements)
    Match(scrutinee, arms) -> pipeline_expr_has_non_native_scalar_typed(scrutinee) or pipeline_match_arms_have_non_native_scalar_typed(arms)
    Not(operand) -> pipeline_expr_has_non_native_scalar_typed(operand)
    Lambda(params, body) -> pipeline_expr_has_non_native_scalar_typed(body)
    Perform(lhs, op_ns, op_nl, args) -> pipeline_expr_has_non_native_scalar_typed(lhs) or pipeline_expr_list_has_non_native_scalar_typed(args)
    Handle(body, clauses, hret) -> pipeline_expr_has_non_native_scalar_typed(body) or pipeline_handler_clause_list_has_non_native_scalar_typed(clauses) or (match hret { NoHandleReturn -> false HandleReturnClause(rns, rnl, rb) -> pipeline_expr_has_non_native_scalar_typed(rb) })
    Resume(value) -> pipeline_expr_has_non_native_scalar_typed(value)
    MethodCall(recv, method_hash, args, type_hash) -> pipeline_expr_has_non_native_scalar_typed(recv) or pipeline_expr_list_has_non_native_scalar_typed(args)
    Try(inner, effect_atom) -> pipeline_expr_has_non_native_scalar_typed(inner)
    InterpConcat(left, right) -> pipeline_expr_has_non_native_scalar_typed(left) or pipeline_expr_has_non_native_scalar_typed(right)
    ForIter(var_ns, var_nl, collection, body) -> pipeline_expr_has_non_native_scalar_typed(collection) or pipeline_expr_has_non_native_scalar_typed(body)
    OptChain(base, field_ns, field_nl, effect_atom) -> pipeline_expr_has_non_native_scalar_typed(base)
    LetTyped(inner, ann_type) -> {
      if pipeline_type_expr_is_non_native_scalar(ann_type) == 1 { true } else { pipeline_expr_has_non_native_scalar_typed(inner) }
    }
    UnknownExpr(tag) -> true
    _ -> true
  }
}

