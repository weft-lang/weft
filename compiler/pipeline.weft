fn pipeline_ir_semantic_fact_count_list(facts: PipelineIrSemanticFactList) -> i64 {
  match facts {
    PipelineIrSemanticFactNil -> 0
    PipelineIrSemanticFactNode(hash, fact, borrow, left, right) -> 1 + pipeline_ir_semantic_fact_count_list(left) + pipeline_ir_semantic_fact_count_list(right)
  }
}

fn pipeline_ir_semantic_fact_count(ir: IrModule) -> i64 {
  pipeline_ir_semantic_fact_count_list(pipeline_ir_semantic_facts(ir))
}

fn pipeline_ir_semantic_borrow_parameter_owner_count_list(facts: PipelineIrSemanticFactList, index: i64) -> i64 {
  match facts {
    PipelineIrSemanticFactNil -> 0
    PipelineIrSemanticFactNode(hash, fact, borrow, left, right) -> {
      ir_borrow_value_facts_count_parameter_owner(ir_borrow_facts_values(borrow), index) +
      pipeline_ir_semantic_borrow_parameter_owner_count_list(left, index) +
      pipeline_ir_semantic_borrow_parameter_owner_count_list(right, index)
    }
  }
}

fn pipeline_ir_semantic_borrow_parameter_owner_count(ir: IrModule, index: i64) -> i64 {
  pipeline_ir_semantic_borrow_parameter_owner_count_list(pipeline_ir_semantic_facts(ir), index)
}

