fn pipeline_native_remat_probe_count(native: NativeModule, which: i64) -> i64 {
  match native {
    NativeModule(code, fm, functions) -> {
      if which == 0 { fmap_ir_native_remat_small_def_count(fm) }
      else { if which == 1 { fmap_ir_native_remat_small_use_count(fm) }
      else { if which == 2 { fmap_ir_native_remat_large_def_count(fm) }
      else { if which == 3 { fmap_ir_native_remat_large_use_count(fm) }
      else { if which == 4 { fmap_ir_native_remat_movn_def_count(fm) }
      else { fmap_ir_native_remat_movn_use_count(fm) } } } } }
    }
  }
}

fn pipeline_native_leaf_probe_count(native: NativeModule, which: i64) -> i64 {
  match native {
    NativeModule(code, fm, functions) -> {
      if which == 0 { fmap_ir_native_leaf_fn_count(fm) }
      else { if which == 1 { fmap_ir_native_leaf_fn_pair_count(fm) }
      else { if which == 2 { fmap_ir_native_leaf_small_fn_count(fm) }
      else { fmap_ir_native_leaf_small_fn_pair_count(fm) } } }
    }
  }
}

fn pipeline_native_crossblock_probe_count(native: NativeModule, which: i64) -> i64 {
  match native {
    NativeModule(code, fm, functions) -> {
      if which == 0 { fmap_ir_native_crossblock_def_count(fm) }
      else { fmap_ir_native_crossblock_use_count(fm) }
    }
  }
}

fn pipeline_native_split_probe_count(native: NativeModule, which: i64) -> i64 {
  match native {
    NativeModule(code, fm, functions) -> {
      if which == 0 { fmap_ir_native_split_candidate_count(fm) }
      else { if which == 1 { fmap_ir_native_split_segment_use_count(fm) }
      else { if which == 2 { fmap_ir_native_split_resident_count(fm) }
      else { fmap_ir_native_fwd_only_count(fm) } } }
    }
  }
}

fn pipeline_native_residual_probe_count(native: NativeModule, which: i64) -> i64 {
