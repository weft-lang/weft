-- Record nodes are default-managed like variants (2q slice 2).
fn pipeline_ir_native_emit_record_init(code: i64, dst: i64, type_hash: i64, fields: IrRecordFieldList, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let size = ir_record_field_list_len(fields) * 8
