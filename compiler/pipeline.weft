pub(package) fn pipeline_effect_hash_par() -> i64 {
  effect_name_hash(__str_ptr("Par"), 0, __str_len("Par"))
}

pub(package) fn pipeline_fn_declares_par_effect(fn_wrap: i64) -> i64 {
  effect_sig_contains_hash(effect_sig_from_node(fn_effects(fn_wrap)), pipeline_effect_hash_par())
}

pub(package) fn pipeline_type_value_lane_count_or_one(ty: i64) -> i64 {
  let words = ty_value_storage_word_count(ty)
  if words > 0 { words } else { 1 }
}

pub(package) fn pipeline_type_value_lane_release_kind(ty: i64, lane: i64) -> i64 {
  cg_managed_drop_kind_for_ty_lane(ty, lane)
}

pub(package) fn pipeline_type_managed_release_lane_count(ty: i64) -> i64 {
  let lanes = pipeline_type_value_lane_count_or_one(ty)
  let mut count = 0
  for lane in 0..lanes {
    if pipeline_type_value_lane_release_kind(ty, lane) != continuation_cleanup_kind_none() { count = count + 1 } else { 0 }
  }
  count
}

-- Three bits per value lane preserve the existing cleanup-kind numbers
-- (none=0, rc=1, closure=2, weak=4). A scalar mask is therefore byte-for-byte
-- identical to the old scalar kind while structural results can describe
-- managed fields at arbitrary lane positions.
pub(package) fn pipeline_type_value_lane_cleanup_mask(ty: i64) -> i64 {
  let lanes = pipeline_type_value_lane_count_or_one(ty)
  let mut mask = 0
  for lane in 0..lanes {
    mask = mask + pipeline_type_value_lane_release_kind(ty, lane) * cg_bit(lane * 3)
  }
  mask
}

pub(package) fn pipeline_value_lane_cleanup_mask_kind(mask: i64, lane: i64) -> i64 {
  (mask / cg_bit(lane * 3)) band 7
}

pub(package) fn pipeline_par_work_descriptor_reason_unknown_shape() -> i64 { 1 }
pub(package) fn pipeline_par_work_descriptor_reason_too_wide() -> i64 { 2 }
pub(package) fn pipeline_par_work_descriptor_reason_invalid_lane() -> i64 { 3 }

pub(package) fn pipeline_par_work_descriptor_zero() -> PipelineParWorkDescriptor {
  PipelineParWorkDescriptorZero
}

pub(package) fn pipeline_par_work_descriptor_for_type(ty: i64) -> PipelineParWorkDescriptor {
  let shape = ir_value_shape_for_type(ty)
  if shape == ir_value_shape_unknown() {
    PipelineParWorkDescriptorInvalid(pipeline_par_work_descriptor_reason_unknown_shape())
  } else {
    let lanes = ir_value_shape_lane_count(shape)
    if lanes < 0 or lanes > 8 {
      PipelineParWorkDescriptorInvalid(pipeline_par_work_descriptor_reason_too_wide())
    } else {
      let cleanup = nlist_new_capacity(lanes)
      let mut valid = 1
      for lane in 0..lanes {
        let lane_class = ir_value_shape_lane_at_or(shape, lane, 0)
        let cleanup_kind = pipeline_type_value_lane_release_kind(ty, lane)
        if lane_class != ir_value_lane_gpr() and lane_class != ir_value_lane_f32() and lane_class != ir_value_lane_f64() {
          valid = 0
        } else {
          if cleanup_kind != continuation_cleanup_kind_none() and cleanup_kind != continuation_cleanup_kind_rc() and cleanup_kind != continuation_cleanup_kind_closure() and cleanup_kind != continuation_cleanup_kind_weak() {
            valid = 0
          } else {
            if lane_class != ir_value_lane_gpr() and cleanup_kind != continuation_cleanup_kind_none() { valid = 0 }
            else { nlist_add(cleanup, cleanup_kind) }
          }
        }
      }
      if valid == 1 and nlist_len(cleanup) == lanes { PipelineParWorkDescriptorLanes(shape, cleanup) }
      else { PipelineParWorkDescriptorInvalid(pipeline_par_work_descriptor_reason_invalid_lane()) }
    }
  }
}

pub(package) fn pipeline_par_work_descriptor_is_valid(descriptor: PipelineParWorkDescriptor) -> i64 {
  match descriptor {
    PipelineParWorkDescriptorZero -> 1
    PipelineParWorkDescriptorLanes(shape, cleanup) -> {
      let lanes = ir_value_shape_lane_count(shape)
      if lanes <= 0 or lanes > 8 or cleanup == 0 or nlist_len(cleanup) != lanes { 0 }
      else {
        let mut valid = 1
        let mut lane = 0
        while lane < lanes and valid == 1 {
          let lane_class = ir_value_shape_lane_at_or(shape, lane, 0)
          let cleanup_kind = nlist_get(cleanup, lane)
          let class_valid = if lane_class == ir_value_lane_gpr() or lane_class == ir_value_lane_f32() or lane_class == ir_value_lane_f64() { 1 } else { 0 }
          let cleanup_valid = if cleanup_kind == continuation_cleanup_kind_none() or cleanup_kind == continuation_cleanup_kind_rc() or cleanup_kind == continuation_cleanup_kind_closure() or cleanup_kind == continuation_cleanup_kind_weak() { 1 } else { 0 }
          if class_valid == 0 or cleanup_valid == 0 or (lane_class != ir_value_lane_gpr() and cleanup_kind != continuation_cleanup_kind_none()) { valid = 0 }
          else { lane = lane + 1 }
        }
        valid
      }
    }
    PipelineParWorkDescriptorInvalid(reason) -> 0
  }
}

pub(package) fn pipeline_par_work_descriptor_reason(descriptor: PipelineParWorkDescriptor) -> i64 {
  match descriptor {
    PipelineParWorkDescriptorInvalid(reason) -> reason
    _ -> 0
  }
}

pub(package) fn pipeline_par_work_descriptor_lane_count(descriptor: PipelineParWorkDescriptor) -> i64 {
  match descriptor {
    PipelineParWorkDescriptorZero -> 0
    PipelineParWorkDescriptorLanes(shape, cleanup) -> ir_value_shape_lane_count(shape)
    PipelineParWorkDescriptorInvalid(reason) -> 0 - 1
  }
}

pub(package) fn pipeline_par_work_descriptor_storage_size(descriptor: PipelineParWorkDescriptor) -> i64 {
  let lanes = pipeline_par_work_descriptor_lane_count(descriptor)
  if lanes < 0 { 0 - 1 } else { lanes * 8 }
}

pub(package) fn pipeline_par_work_descriptor_storage_align(descriptor: PipelineParWorkDescriptor) -> i64 {
  let lanes = pipeline_par_work_descriptor_lane_count(descriptor)
  if lanes < 0 { 0 - 1 } else { if lanes == 0 { 1 } else { 8 } }
}

pub(package) fn pipeline_par_work_descriptor_lane_class(descriptor: PipelineParWorkDescriptor, lane: i64) -> i64 {
  match descriptor {
    PipelineParWorkDescriptorLanes(shape, cleanup) -> ir_value_shape_lane_at_or(shape, lane, 0)
    _ -> 0
  }
}

pub(package) fn pipeline_par_work_descriptor_lane_cleanup_kind(descriptor: PipelineParWorkDescriptor, lane: i64) -> i64 {
  match descriptor {
    PipelineParWorkDescriptorLanes(shape, cleanup) -> {
      if lane < 0 or lane >= nlist_len(cleanup) { continuation_cleanup_kind_none() }
      else { nlist_get(cleanup, lane) }
    }
    _ -> continuation_cleanup_kind_none()
  }
}

pub(package) fn pipeline_params_value_lane_count(params: i64) -> i64 {
  if params == 0 { 0 }
  else {
    let mut total = 0
    for i in 0..nlist_len(params) {
      total = total + pipeline_type_value_lane_count_or_one(node_f3(nlist_get(params, i)))
    }
    total
  }
}

pub(package) fn pipeline_params_have_structural_shape(params: i64) -> i64 {
  if params == 0 { 0 }
  else {
    let mut found = 0
    for i in 0..nlist_len(params) {
      if ty_is_record(node_f3(nlist_get(params, i))) { found = 1 } else { 0 }
    }
    found
  }
}

pub(package) fn pipeline_params_have_open_structural_shape(params: i64) -> i64 {
  if params == 0 { 0 }
  else {
    let mut found = 0
    for i in 0..nlist_len(params) {
      let param_ty = node_f3(nlist_get(params, i))
      if ty_is_record(param_ty) and ty_record_open(param_ty) == 1 { found = 1 } else { 0 }
    }
    found
  }
}

pub(package) fn pipeline_param_value_index_at(params: i64, index: i64) -> i64 {
  if params == 0 or index < 0 or index >= nlist_len(params) { 0 - 1 }
  else {
    let mut value_index = 0
    for i in 0..index {
      value_index = value_index + pipeline_type_value_lane_count_or_one(node_f3(nlist_get(params, i)))
    }
    value_index
  }
}

pub(package) fn pipeline_param_index(params: i64, src: i64, ns: i64, nl: i64) -> i64 {
  if params == 0 {
    0 - 1
  } else {
    let n = nlist_len(params)
    let mut i = 0
    let mut value_index = 0
    let mut result = 0 - 1
    while i < n {
      let p = nlist_get(params, i)
      if node_f2(p) == nl {
        if src_eq_at(src, ns, src + node_f1(p), 0, nl) == 1 {
          result = value_index
          i = n
        } else {
          value_index = value_index + pipeline_type_value_lane_count_or_one(node_f3(p))
          i = i + 1
        }
      } else {
        value_index = value_index + pipeline_type_value_lane_count_or_one(node_f3(p))
        i = i + 1
      }
    }
    result
  }
}

pub(package) fn pipeline_param_type_hash_by_name(params: i64, src: i64, ns: i64, nl: i64, subst: i64) -> i64 {
  if params == 0 { 0 }
  else {
    let n = nlist_len(params)
    let mut i = 0
    let mut result = 0
    while i < n {
      let p = nlist_get(params, i)
      if node_f2(p) == nl {
        if src_eq_at(src, ns, src + node_f1(p), 0, nl) == 1 {
          let raw_ty = node_f3(p)
          let ty = if raw_ty == 0 or subst == 0 { raw_ty } else { ty_subst(raw_ty, subst) }
          result = if ty == 0 { 0 } else { type_hash_of(ty) }
          i = n
        } else {
          i = i + 1
        }
      } else {
        i = i + 1
      }
    }
    result
  }
}

pub(package) fn pipeline_param_type_node_by_name(params: i64, src: i64, ns: i64, nl: i64, subst: i64) -> i64 {
  if params == 0 { 0 }
  else {
    let n = nlist_len(params)
    let mut i = 0
    let mut result = 0
    while i < n {
      let p = nlist_get(params, i)
      if node_f2(p) == nl {
        if src_eq_at(src, ns, src + node_f1(p), 0, nl) == 1 {
          let raw_ty = node_f3(p)
          result = if subst == 0 { raw_ty } else { ty_subst(raw_ty, subst) }
          i = n
        } else {
          i = i + 1
        }
      } else {
        i = i + 1
      }
    }
    result
  }
}

pub(package) fn pipeline_param_float_prim_by_name(params: i64, src: i64, ns: i64, nl: i64, subst: i64) -> i64 {
  if params == 0 { 0 }
  else {
    let n = nlist_len(params)
    let mut i = 0
    let mut result = 0
    while i < n {
      let p = nlist_get(params, i)
      if node_f2(p) == nl {
        if src_eq_at(src, ns, src + node_f1(p), 0, nl) == 1 {
          let raw_ty = node_f3(p)
          let ty = if subst == 0 { raw_ty } else { ty_subst(raw_ty, subst) }
          let prim = type_expr_prim_id_or(type_expr_from_node(ty), 0)
          if prim == PRIM_F32() or prim == PRIM_F64() { result = prim } else { result = 0 }
          i = n
        } else {
          i = i + 1
        }
      } else {
        i = i + 1
      }
    }
    result
  }
}

pub(package) fn pipeline_fns_fact_list_valid(fns: i64) -> i64 {
  if fns <= 4096 { 0 } else { 1 }
}

pub(package) fn pipeline_fns_context_ttable(fns: i64) -> i64 {
  if pipeline_fns_fact_list_valid(fns) == 0 { 0 }
  else {
    let cached = mem_load64_at(fns, 24)
    if cached == 0 { 0 } else { node_tag(cached) }
  }
}

pub(package) fn pipeline_fns_bind_ttable(fns: i64, tt: i64) -> i64 {
  if pipeline_fns_fact_list_valid(fns) == 0 or tt == 0 { 0 }
  else {
    let cached = mem_load64_at(fns, 24)
    if cached == 0 {
      mem_store64_at(fns, 24, node_new(tt, 0, 0, 0, 0))
    } else { if node_tag(cached) == 0 { mem_store64_at(cached, 0, tt) } else { 0 } }
    tt
  }
}

-- Decl-list lookup index (name-resolution indexing): a hash-ordered tree over the function
-- declarations, keyed by name hash, valued by the decl pair, built once
-- per list length into the nlist's fourth header word. Insertion follows
-- list order and keeps the first entry per hash, matching the linear
-- scans' first-declaration-wins resolution exactly.
pub(package) fn pipeline_fns_index_insert(tree: i64, hash: i64, pair: i64) -> i64 {
  let leaf = node_new(0, hash, pair, 0, 0)
  if tree == 0 { leaf }
  else {
    let mut cur = tree
    let mut done = 0
    while done == 0 {
      let cur_hash = node_f1(cur)
      if hash < cur_hash {
        if node_f3(cur) == 0 {
          mem_store64_at(cur, 24, leaf)
          done = 1
        } else { cur = node_f3(cur) }
      } else { if hash > cur_hash {
        if node_f4(cur) == 0 {
          mem_store64_at(cur, 32, leaf)
          done = 1
        } else { cur = node_f4(cur) }
      } else {
        done = 1
      } }
    }
    tree
  }
}

pub(package) fn pipeline_fns_index_insert_replace(tree: i64, hash: i64, pair: i64) -> i64 {
  -- Last-wins variant for generic templates, matching the linear scan
  -- that kept overwriting its result to the end of the list.
  let leaf = node_new(0, hash, pair, 0, 0)
  if tree == 0 { leaf }
  else {
    let mut cur = tree
    let mut done = 0
    while done == 0 {
      let cur_hash = node_f1(cur)
      if hash < cur_hash {
        if node_f3(cur) == 0 {
          mem_store64_at(cur, 24, leaf)
          done = 1
        } else { cur = node_f3(cur) }
      } else { if hash > cur_hash {
        if node_f4(cur) == 0 {
          mem_store64_at(cur, 32, leaf)
          done = 1
        } else { cur = node_f4(cur) }
      } else {
        mem_store64_at(cur, 16, pair)
        done = 1
      } }
    }
    tree
  }
}

pub(package) fn pipeline_fns_index_probe(tree: i64, hash: i64) -> i64 {
  let mut cur = tree
  let mut result = 0
  while cur != 0 {
    let cur_hash = node_f1(cur)
    if hash == cur_hash {
      result = node_f2(cur)
      cur = 0
    } else { if hash < cur_hash { cur = node_f3(cur) } else { cur = node_f4(cur) } }
  }
  result
}

pub(package) fn pipeline_fns_index_magic() -> i64 { 762342361276 }

pub(package) fn pipeline_impl_pair_target_type_args(pair: i64) -> i64 {
  if node_f3(pair) == 0 { 0 }
  else {
    let target_ty = node_f4(pair)
    if target_ty != 0 and ty_tag(target_ty) == 9 { ty_f3(target_ty) } else { 0 }
  }
}

-- The checker uses a nominal head hash to find declarations, then compares the
-- complete target type. Native dispatch needs the same exact identity without
-- changing that semantic lookup convention: opaque declarations therefore
-- derive their ABI key from the producer-owned DeclId.
pub(package) fn pipeline_native_ownership_dispatch_key(inner_key: i64, mode: i64) -> i64 {
  -- Ownership qualifiers erase from the calling convention, but not from
  -- protocol selection. Keep their method namespaces disjoint without adding
  -- a value tag, wrapper allocation, or runtime branch.
  inner_key * 131 + mode * 17 + 314159
}

pub(package) fn pipeline_native_dispatch_type_hash(ty: i64, fallback: i64) -> i64 {
  if ty_is_unique(ty) {
    pipeline_native_ownership_dispatch_key(pipeline_native_dispatch_type_hash(ty_unique_inner(ty), fallback), 1)
  } else { if ty_is_owned(ty) {
    pipeline_native_ownership_dispatch_key(pipeline_native_dispatch_type_hash(ty_owned_inner(ty), fallback), 2)
  } else { if ty != 0 and ty_tag(ty) == 9 and ty_named_is_opaque(ty) {
    module_decl_fact_derived_native_key(ty_named_opaque_declaration(ty), ty_f1(ty))
  } else { fallback } } }
}

pub(package) fn pipeline_impl_pair_native_type_hash(pair: i64) -> i64 {
  if pair == 0 or node_f3(pair) == 0 { 0 }
  else {
    let target_key = pipeline_native_dispatch_type_hash(node_f4(pair), node_f3(pair))
    if target_key != node_f3(pair) { target_key }
    else {
      let method_decl = node_tag(pair)
      let owner = if method_decl == 0 { 0 } else { module_decl_fact_owner(method_decl) }
      module_decl_fact_native_key_or(owner, target_key)
    }
  }
}

pub(package) fn pipeline_impl_pair_method_key(pair: i64, name_hash: i64) -> i64 {
  let base = pipeline_ir_method_patch_key(pipeline_impl_pair_native_type_hash(pair), name_hash)
  let args = pipeline_impl_pair_target_type_args(pair)
  if fn_tparams(node_f1(pair)) == 0 and args != 0 and nlist_len(args) > 0 { mono_spec_hash(base, args) } else { base }
}

pub(package) fn pipeline_fn_pair_name_hash(pair: i64) -> i64 {
  let fn_wrap = node_f1(pair)
  let inner = pipeline_fn_inner(fn_wrap)
  str_hash(node_f2(pair), node_f1(inner), node_f2(inner))
}

-- The task scheduler's typed carrier pack is a compiler intrinsic, so its native key must
-- name the producer declaration rather than merely repeat its short spelling.
-- An unrelated user function called `runtime_spawn_work_pack` therefore keeps
-- its ordinary declaration key and can never enter the intrinsic lowering.
pub(package) fn pipeline_task_work_pack_native_key() -> i64 {
  str_hash(
    __str_ptr("runtime/spawn_task::runtime_spawn_work_pack#native"),
    0,
    __str_len("runtime/spawn_task::runtime_spawn_work_pack#native")
  )
}

pub(package) fn pipeline_fn_pair_key(pair: i64) -> i64 {
  if pair == 0 { 0 }
  else {
    let name_hash = pipeline_fn_pair_name_hash(pair)
    if node_f3(pair) != 0 { pipeline_impl_pair_method_key(pair, name_hash) }
    else { if typeck_decl_identity_is(node_tag(pair), "runtime/spawn_task", "runtime_spawn_work_pack") == 1 {
      pipeline_task_work_pack_native_key()
    } else { module_decl_fact_native_key_or(node_tag(pair), name_hash) } }
  }
}

pub(package) fn pipeline_fns_native_key_insert(tree: i64, hash: i64, pair: i64) -> i64 {
  let leaf = node_new(0, hash, pair, 0, 0)
  if tree == 0 { leaf }
  else {
    let mut cur = tree
    let mut done = 0
    while done == 0 {
      let cur_hash = node_f1(cur)
      if hash < cur_hash {
        if node_f3(cur) == 0 { mem_store64_at(cur, 24, leaf) done = 1 }
        else { cur = node_f3(cur) }
      } else { if hash > cur_hash {
        if node_f4(cur) == 0 { mem_store64_at(cur, 32, leaf) done = 1 }
        else { cur = node_f4(cur) }
      } else {
        let existing = node_f2(cur)
        let existing_decl = node_tag(existing)
        let decl = node_tag(pair)
        if existing_decl != 0 and decl != 0 and existing_decl != decl {
          module_decl_fact_mark_native_collision(existing_decl, hash)
          module_decl_fact_mark_native_collision(decl, hash)
        } else { 0 }
        done = 1
      } }
    }
    tree
  }
}

pub(package) fn pipeline_fns_prepare_native_keys(fns: i64) -> i64 {
  let mut tree = 0
  for i in 0..nlist_len(fns) {
    let pair = nlist_get(fns, i)
    if pipeline_decl_node_is_function(node_f1(pair)) == 1 and node_f3(pair) == 0 {
      tree = pipeline_fns_native_key_insert(tree, pipeline_fn_pair_name_hash(pair), pair)
    } else { 0 }
  }
  0
}

-- One walk builds three trees: function names (first-wins), method pairs
-- keyed by the (type, method) patch key (first-wins), and generic
-- templates (last-wins). The auxiliary node also carries the exact set
-- of named functions created as first-class values. Indirect calls use
-- an all-owned ABI, so those address-taken entries must use borrow mask
-- zero at both direct and indirect call sites.
--
-- The cache node may die in a bump rollback while the list header
-- survives; rolled-back memory is zeroed (or reused), so validity
-- requires the length, the owning list pointer, and a magic to all match
-- before the trees or address-taken facts are trusted.
pub(package) fn pipeline_fns_index_bundle(fns: i64) -> i64 {
  let cached = mem_load64_at(fns, 24)
  let context_tt = if cached == 0 { 0 } else { node_tag(cached) }
  let n = nlist_len(fns)
  let aux_ok = if cached != 0 {
    let aux = node_f4(cached)
    if aux != 0 and node_f1(aux) == n and node_f2(aux) == fns and node_f3(aux) == pipeline_fns_index_magic() { 1 } else { 0 }
  } else { 0 }
  if aux_ok == 1 { cached }
  else {
    pipeline_fns_prepare_native_keys(fns)
    let mut name_tree = 0
    let mut method_tree = 0
    let mut template_tree = 0
    let mut i = 0
    while i < n {
      let pair = nlist_get(fns, i)
      let fn_wrap = node_f1(pair)
      if pipeline_decl_node_is_function(fn_wrap) == 1 {
        let inner = pipeline_fn_inner(fn_wrap)
        let fn_src = node_f2(pair)
        let name_hash = str_hash(fn_src, node_f1(inner), node_f2(inner))
        let fn_key = if node_f3(pair) == 0 { pipeline_fn_pair_key(pair) } else { name_hash }
        name_tree = pipeline_fns_index_insert(name_tree, fn_key, pair)
        if node_f3(pair) != 0 {
          method_tree = pipeline_fns_index_insert(method_tree, pipeline_impl_pair_method_key(pair, name_hash), pair)
        } else { 0 }
        -- Generic methods are already indexed by their qualified method key
        -- above. Admitting them to the unqualified template tree lets an
        -- impl method replace a free generic function with the same name.
        if (fn_tparams(fn_wrap) != 0 or pipeline_params_have_structural_shape(node_f3(inner)) == 1) and node_f3(pair) == 0 {
          template_tree = pipeline_fns_index_insert_replace(template_tree, fn_key, pair)
        } else { 0 }
      } else { 0 }
      i = i + 1
    }
    -- The syntax walk below receives the name index directly; carry the
    -- module table in its otherwise-unused root tag so aliases resolve to
    -- the same declaration key as lowering.
    if name_tree != 0 and context_tt != 0 { mem_store64_at(name_tree, 0, context_tt) } else { 0 }
    let address_taken = pipeline_fns_collect_function_value_hashes(fns, name_tree)
    let bundle = node_new(context_tt, name_tree, method_tree, template_tree, node_new(0, n, fns, pipeline_fns_index_magic(), address_taken))
    mem_store64_at(fns, 24, bundle)
    bundle
  }
}

pub(package) fn pipeline_fns_index(fns: i64) -> i64 {
  node_f1(pipeline_fns_index_bundle(fns))
}

pub(package) fn pipeline_fns_address_taken_hashes(fns: i64) -> i64 {
  if pipeline_fns_fact_list_valid(fns) == 0 { 0 }
  else { node_f4(node_f4(pipeline_fns_index_bundle(fns))) }
}

pub(package) fn pipeline_fns_hash_is_address_taken(fns: i64, target_hash: i64) -> i64 {
  if pipeline_hash_list_contains(pipeline_fns_address_taken_hashes(fns), target_hash) { 1 } else { 0 }
}

pub(package) fn pipeline_fns_lookup_pair_by_hash(fns: i64, target_hash: i64) -> i64 {
  if pipeline_fns_fact_list_valid(fns) == 0 { 0 }
  else {
    pipeline_fns_index_probe(pipeline_fns_index(fns), target_hash)
  }
}

-- Native call IR uses the qualified (owner, method) key for generic methods.
-- Call-semantic consumers therefore need the same two-index lookup as native
-- dispatch instead of assuming every callable lives in the free-function tree.
pub(package) fn pipeline_fns_lookup_callable_pair_by_hash(fns: i64, target_hash: i64) -> i64 {
  let named = pipeline_fns_lookup_pair_by_hash(fns, target_hash)
  if named != 0 { named }
  else { if pipeline_fns_fact_list_valid(fns) == 0 { 0 }
  else { pipeline_fns_index_probe(node_f2(pipeline_fns_index_bundle(fns)), target_hash) } }
}

pub(package) fn pipeline_fns_lookup_pair(fns: i64, src: i64, ns: i64, nl: i64) -> i64 {
  pipeline_fns_lookup_pair_by_hash(fns, str_hash(src, ns, nl))
}

pub(package) fn pipeline_fns_lookup_pair_resolved(fns: i64, tt: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let decl = if tt == 0 { 0 }
    else { module_scope_lookup_declaration(tt, src, module_decl_namespace_value(), src, ns, nl) }
  if decl != 0 {
    let pair = module_decl_fact_function_pair(decl)
    if pair != 0 and pipeline_decl_node_is_function(node_f1(pair)) == 1 { pair } else { 0 }
  } else { if tt == 0 or module_fact_find_source(tt, src) == 0 {
    pipeline_fns_lookup_pair(fns, src, ns, nl)
  } else { 0 } }
}

pub(package) fn pipeline_fns_resolved_decl(tt: i64, src: i64, ns: i64, nl: i64) -> i64 {
  if tt == 0 { 0 }
  else { module_scope_lookup_declaration(tt, src, module_decl_namespace_value(), src, ns, nl) }
}

pub(package) fn pipeline_fns_resolved_native_entry(tt: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let decl = pipeline_fns_resolved_decl(tt, src, ns, nl)
  if decl == 0 or ttable_native_symbol_for_decl(tt, decl) == 0 { 0 }
  else { ftypes_find_decl(ttable_get_checked_functions(tt), decl) }
}

pub(package) fn pipeline_fns_resolved_key(fns: i64, tt: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let pair = pipeline_fns_lookup_pair_resolved(fns, tt, src, ns, nl)
  if pair != 0 { pipeline_fn_pair_key(pair) }
  else {
    let decl = pipeline_fns_resolved_decl(tt, src, ns, nl)
    if decl != 0 and ttable_native_symbol_for_decl(tt, decl) != 0 {
      -- Synthetic declarations have no AST pair and therefore never enter
      -- the ordinary collision pass. Always derive their key from DeclId.
      module_decl_fact_derived_native_key(decl, str_hash(src, ns, nl))
    } else { str_hash(src, ns, nl) }
  }
}

pub(package) fn pipeline_fns_lookup_params_by_hash(fns: i64, target_hash: i64) -> i64 {
  let pair = pipeline_fns_lookup_pair_by_hash(fns, target_hash)
  if pair == 0 { 0 }
  else { node_f3(pipeline_fn_inner(node_f1(pair))) }
}

pub(package) fn pipeline_fns_lookup_params(fns: i64, src: i64, ns: i64, nl: i64) -> i64 {
  pipeline_fns_lookup_params_by_hash(fns, str_hash(src, ns, nl))
}

pub(package) fn pipeline_fns_lookup_params_resolved(fns: i64, tt: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let pair = pipeline_fns_lookup_pair_resolved(fns, tt, src, ns, nl)
  if pair != 0 { node_f3(pipeline_fn_inner(node_f1(pair))) }
  else { ftypes_entry_params(pipeline_fns_resolved_native_entry(tt, src, ns, nl)) }
}

pub(package) fn pipeline_fns_contains_hash(fns: i64, target_hash: i64) -> i64 {
  -- Probe then re-apply the non-generic filter; coherence forbids a
  -- same-name generic and non-generic pair, so this matches the linear
  -- scan's answer.
  let pair = pipeline_fns_lookup_pair_by_hash(fns, target_hash)
  if pair == 0 { 0 }
  else { if fn_tparams(node_f1(pair)) == 0 { 1 } else { 0 } }
}

pub(package) fn pipeline_fns_lookup_ret_type_hash_by_hash(fns: i64, target_hash: i64, subst: i64) -> i64 {
  let pair = pipeline_fns_lookup_pair_by_hash(fns, target_hash)
  if pair == 0 { 0 }
  else {
    let fn_wrap = node_f1(pair)
    let raw_ty = fn_ret_type(fn_wrap)
    let ty = if subst == 0 { raw_ty } else { ty_subst(raw_ty, subst) }
    type_hash_of(ty)
  }
}

pub(package) fn pipeline_fns_lookup_ret_type_hash(fns: i64, src: i64, ns: i64, nl: i64, subst: i64) -> i64 {
  pipeline_fns_lookup_ret_type_hash_by_hash(fns, str_hash(src, ns, nl), subst)
}

pub(package) fn pipeline_fns_lookup_ret_type_node_by_hash(fns: i64, target_hash: i64, subst: i64) -> i64 {
  let pair = pipeline_fns_lookup_pair_by_hash(fns, target_hash)
  if pair == 0 { 0 }
  else {
    let fn_wrap = node_f1(pair)
    let raw_ty = fn_ret_type(fn_wrap)
    if subst == 0 { raw_ty } else { ty_subst(raw_ty, subst) }
  }
}

pub(package) fn pipeline_fns_lookup_ret_type_node(fns: i64, src: i64, ns: i64, nl: i64, subst: i64) -> i64 {
  pipeline_fns_lookup_ret_type_node_by_hash(fns, str_hash(src, ns, nl), subst)
}

pub(package) fn pipeline_fns_lookup_ret_float_prim_by_hash(fns: i64, target_hash: i64, subst: i64) -> i64 {
  let pair = pipeline_fns_lookup_pair_by_hash(fns, target_hash)
  if pair == 0 { 0 }
  else {
    pipeline_fn_return_float_prim(node_f1(pair), subst)
  }
}

pub(package) fn pipeline_fns_lookup_ret_float_prim(fns: i64, src: i64, ns: i64, nl: i64, subst: i64) -> i64 {
  pipeline_fns_lookup_ret_float_prim_by_hash(fns, str_hash(src, ns, nl), subst)
}

pub(package) fn pipeline_param_float_prim_at(params: i64, index: i64, subst: i64) -> i64 {
  if params == 0 or index < 0 or index >= nlist_len(params) {
    0
  } else {
    let raw_ty = node_f3(nlist_get(params, index))
    let ty = if subst == 0 { raw_ty } else { ty_subst(raw_ty, subst) }
    let prim = type_expr_prim_id_or(type_expr_from_node(ty), 0)
    if prim == PRIM_F32() or prim == PRIM_F64() { prim } else { 0 }
  }
}

pub(package) fn pipeline_type_hash_int_prim_or(type_hash: i64, default: i64) -> i64 {
  if type_hash < 0 {
    let prim = (0 - type_hash) - 1
    if prim_is_integer(prim) == 1 { prim } else { default }
  } else {
    default
  }
}

pub(package) fn pipeline_type_hash_of_prim_id(prim: i64) -> i64 {
  (0 - prim) - 1
}

pub(package) fn pipeline_param_int_prim_by_name(params: i64, src: i64, ns: i64, nl: i64, subst: i64) -> i64 {
  pipeline_type_hash_int_prim_or(pipeline_param_type_hash_by_name(params, src, ns, nl, subst), 0 - 1)
}

pub(package) fn pipeline_param_int_prim_at(params: i64, index: i64, subst: i64) -> i64 {
  if params == 0 or index < 0 or index >= nlist_len(params) {
    0 - 1
  } else {
    let raw_ty = node_f3(nlist_get(params, index))
    let ty = if subst == 0 { raw_ty } else { ty_subst(raw_ty, subst) }
    let prim = type_expr_prim_id_or(type_expr_from_node(ty), 0 - 1)
    if prim_is_integer(prim) == 1 { prim } else { 0 - 1 }
  }
}

pub(package) fn pipeline_type_node_float_prim_at(types: i64, index: i64, subst: i64) -> i64 {
  if types == 0 or index < 0 or index >= nlist_len(types) {
    0
  } else {
    let raw_ty = nlist_get(types, index)
    let ty = if subst == 0 { raw_ty } else { ty_subst(raw_ty, subst) }
    let prim = type_expr_prim_id_or(type_expr_from_node(ty), 0)
    if prim == PRIM_F32() or prim == PRIM_F64() { prim } else { 0 }
  }
}

pub(package) fn pipeline_type_node_int_prim_at(types: i64, index: i64, subst: i64) -> i64 {
  if types == 0 or index < 0 or index >= nlist_len(types) {
    0 - 1
  } else {
    let raw_ty = nlist_get(types, index)
    let ty = if subst == 0 { raw_ty } else { ty_subst(raw_ty, subst) }
    let prim = type_expr_prim_id_or(type_expr_from_node(ty), 0 - 1)
    if prim_is_integer(prim) == 1 { prim } else { 0 - 1 }
  }
}

pub(package) fn pipeline_expected_arg_float_prim(expected_params: i64, expected_types: i64, index: i64, expected_offset: i64, subst: i64) -> i64 {
  if expected_types != 0 {
    pipeline_type_node_float_prim_at(expected_types, index, subst)
  } else {
    pipeline_param_float_prim_at(expected_params, index + expected_offset, subst)
  }
}

pub(package) fn pipeline_expected_arg_int_prim(expected_params: i64, expected_types: i64, index: i64, expected_offset: i64, subst: i64) -> i64 {
  if expected_types != 0 {
    pipeline_type_node_int_prim_at(expected_types, index, subst)
  } else {
    pipeline_param_int_prim_at(expected_params, index + expected_offset, subst)
  }
}

pub(package) fn pipeline_expected_arg_type_node(expected_params: i64, expected_types: i64, index: i64, expected_offset: i64, subst: i64) -> i64 {
  let raw_ty = if expected_types != 0 {
    if index < 0 or index >= nlist_len(expected_types) { 0 } else { nlist_get(expected_types, index) }
  } else {
    if expected_params == 0 or index + expected_offset < 0 or index + expected_offset >= nlist_len(expected_params) { 0 }
    else { node_f3(nlist_get(expected_params, index + expected_offset)) }
  }
  if raw_ty == 0 { 0 } else { if subst == 0 { raw_ty } else { ty_subst(raw_ty, subst) } }
}

pub(package) fn pipeline_ir_value_lane_ids(value: i64, lane: i64, count: i64) -> IrValueList {
  if lane >= count { ir_value_list_empty() }
  else { ir_value_list_prepend(value + lane, pipeline_ir_value_lane_ids(value, lane + 1, count)) }
}

pub(package) fn pipeline_ir_slot_lane_init_insts(slot: i64, value: i64, lane: i64, count: i64) -> IrInstList {
  if lane >= count { ir_inst_list_empty() }
  else {
    ir_inst_list_prepend(
      ir_inst_slot_i64(slot + lane),
      ir_inst_list_prepend(
        ir_inst_store_i64(slot + lane, value + lane),
        pipeline_ir_slot_lane_init_insts(slot, value, lane + 1, count)
      )
    )
  }
}

pub(package) fn pipeline_ir_slot_load_lane_insts(dst: i64, slot: i64, lane: i64, count: i64) -> IrInstList {
  if lane >= count { ir_inst_list_empty() }
  else {
    ir_inst_list_prepend(
      ir_inst_load_i64(dst + lane, slot + lane),
      pipeline_ir_slot_load_lane_insts(dst, slot, lane + 1, count)
    )
  }
}

-- A mutable linear binding owns the value currently stored in its slot.
-- Loads retain the slot provenance as a semantic fact; rebinding commits a
-- newly evaluated value only after its lanes have been stored. One marker
-- vocabulary covers scalar owned resources, flattened aggregates, and
-- pointer-backed named aggregates so abort cleanup consumes the same fact as
-- ordinary cleanup instead of rediscovering ownership from runtime identity.
pub(package) fn pipeline_ir_structural_slot_alias_insts(value: i64, slot: i64, plan: i64) -> IrInstList {
  if plan != 0 {
    ir_inst_list_prepend(ir_inst_structural_slot_alias_i64(value, slot, plan), ir_inst_list_empty())
  } else { ir_inst_list_empty() }
}

pub(package) fn pipeline_ir_structural_slot_rebind_insts(value: i64, slot: i64, plan: i64) -> IrInstList {
  if plan != 0 {
    ir_inst_list_prepend(ir_inst_structural_slot_rebind_i64(value, slot, plan), ir_inst_list_empty())
  } else { ir_inst_list_empty() }
}

pub(package) fn pipeline_ir_slot_store_lane_insts(slot: i64, value: i64, lane: i64, count: i64) -> IrInstList {
  if lane >= count { ir_inst_list_empty() }
  else {
    ir_inst_list_prepend(
      ir_inst_store_i64(slot + lane, value + lane),
      pipeline_ir_slot_store_lane_insts(slot, value, lane + 1, count)
    )
  }
}

pub(package) fn pipeline_ir_slot_managed_lane_load_insts(dst: i64, slot: i64, ty: i64, lane: i64, count: i64) -> IrInstList {
  if lane >= count { ir_inst_list_empty() }
  else {
    let rest = pipeline_ir_slot_managed_lane_load_insts(dst, slot, ty, lane + 1, count)
    if pipeline_type_value_lane_release_kind(ty, lane) == continuation_cleanup_kind_none() { rest }
    else { ir_inst_list_prepend(ir_inst_load_i64(dst + lane, slot + lane), rest) }
  }
}

pub(package) fn pipeline_ir_record_field_lane_entries_inner(field_hash: i64, word_offset: i64, value: i64, lane: i64, count: i64) -> IrRecordFieldList {
  if lane >= count { ir_record_field_list_empty() }
  else {
    ir_record_field_list_prepend(
      field_hash,
      word_offset + lane,
      value + lane,
      pipeline_ir_record_field_lane_entries_inner(field_hash, word_offset, value, lane + 1, count)
    )
  }
}

pub(package) fn pipeline_ir_record_field_lane_entries(field_hash: i64, word_offset: i64, value: i64, ty: i64) -> IrRecordFieldList {
  pipeline_ir_record_field_lane_entries_inner(field_hash, word_offset, value, 0, pipeline_type_value_lane_count_or_one(ty))
}

pub(package) fn pipeline_ir_field_load_lane_insts_inner(dst: i64, base: i64, field_hash: i64, word_offset: i64, lane: i64, count: i64) -> IrInstList {
  if lane >= count { ir_inst_list_empty() }
  else {
    ir_inst_list_prepend(
      ir_inst_field_load_i64(dst + lane, base, field_hash, word_offset + lane),
      pipeline_ir_field_load_lane_insts_inner(dst, base, field_hash, word_offset, lane + 1, count)
    )
  }
}

pub(package) fn pipeline_ir_field_load_lane_insts(dst: i64, base: i64, field_hash: i64, word_offset: i64, ty: i64) -> IrInstList {
  pipeline_ir_field_load_lane_insts_inner(dst, base, field_hash, word_offset, 0, pipeline_type_value_lane_count_or_one(ty))
}

pub(package) fn pipeline_ir_record_layout_word_load_lane_insts_inner(dst: i64, base: i64, record_data_size: i64, field_hash: i64, byte_offset: i64, lane: i64, count: i64) -> IrInstList {
  if lane >= count { ir_inst_list_empty() }
  else {
    ir_inst_list_prepend(
      ir_inst_record_layout_word_load_i64(dst + lane, base, record_data_size, field_hash, byte_offset + lane * 8),
      pipeline_ir_record_layout_word_load_lane_insts_inner(dst, base, record_data_size, field_hash, byte_offset, lane + 1, count)
    )
  }
}

pub(package) fn pipeline_ir_invalid_field_load_lane_insts(dst: i64, lane: i64, count: i64) -> IrInstList {
  if lane >= count { ir_inst_list_prepend(ir_inst_lowering_failure_i64(14), ir_inst_list_empty()) }
  else { ir_inst_list_prepend(ir_inst_const_i64(dst + lane, 0), pipeline_ir_invalid_field_load_lane_insts(dst, lane + 1, count)) }
}

pub(package) fn pipeline_ir_field_load_lane_insts_for_storage_layout(dst: i64, base: i64, field_hash: i64, word_offset: i64, ty: i64, layout: PipelineRecordStorageLayout) -> IrInstList {
  let lanes = pipeline_type_value_lane_count_or_one(ty)
  match layout {
    PipelineRecordStorageLayoutCompact -> pipeline_ir_field_load_lane_insts(dst, base, field_hash, word_offset, ty)
    PipelineRecordStorageLayoutInvalid -> pipeline_ir_invalid_field_load_lane_insts(dst, 0, lanes)
    PipelineRecordStorageLayoutDescribed(record_data_size, record_align, fields) -> {
      match pipeline_record_storage_field_fact_at_word_offset(fields, word_offset) {
        PipelineRecordStorageFieldFactWord(fact_hash, fact_word_offset, byte_offset, field_ty, fact_lanes, rest) -> {
          if fact_hash == field_hash and fact_lanes == lanes {
            pipeline_ir_record_layout_word_load_lane_insts_inner(dst, base, record_data_size, field_hash, byte_offset, 0, lanes)
          } else { pipeline_ir_invalid_field_load_lane_insts(dst, 0, lanes) }
        }
        -- Array projection changes ownership and therefore goes through the
        -- IrLoweredExpr-producing wrapper below. A caller that bypasses that
        -- semantic placement fact remains fail-closed.
        PipelineRecordStorageFieldFactArray(fact_hash, fact_word_offset, byte_offset, field_ty, byte_size, align, leaf_count, leaf_stride, leaf_kind, rest) -> {
          pipeline_ir_invalid_field_load_lane_insts(dst, 0, lanes)
        }
        PipelineRecordStorageFieldFactNil -> pipeline_ir_invalid_field_load_lane_insts(dst, 0, lanes)
      }
    }
  }
}

pub(package) fn pipeline_ir_array_storage_new_args(byte_size_value: i64, align_value: i64, leaf_count_value: i64, leaf_stride_value: i64, leaf_kind_value: i64) -> IrValueList {
  ir_value_list_prepend(
    byte_size_value,
    ir_value_list_prepend(
      align_value,
      ir_value_list_prepend(
        leaf_count_value,
        ir_value_list_prepend(leaf_stride_value, ir_value_list_prepend(leaf_kind_value, ir_value_list_empty()))
      )
    )
  )
}

-- An extracted array is a fresh semantic value, not an interior borrow of the
-- record. Allocate its default-managed backing first, expose the backing data
-- only to the copy instruction, and return the owned storage handle. Higher
-- lowering then uses the ordinary managed-value ownership machinery.
pub(package) fn pipeline_ir_owned_record_array_load(dst: i64, base: i64, record_data_size: i64, byte_offset: i64, byte_size: i64, align: i64, leaf_count: i64, leaf_stride: i64, leaf_kind: i64) -> IrLoweredExpr {
  let byte_size_value = dst + 1
  let align_value = dst + 2
  let leaf_count_value = dst + 3
  let leaf_stride_value = dst + 4
  let leaf_kind_value = dst + 5
  let data = dst + 6
  let insts = ir_inst_list_prepend(
    ir_inst_const_i64(byte_size_value, byte_size),
    ir_inst_list_prepend(
      ir_inst_const_i64(align_value, align),
      ir_inst_list_prepend(
        ir_inst_const_i64(leaf_count_value, leaf_count),
        ir_inst_list_prepend(
          ir_inst_const_i64(leaf_stride_value, leaf_stride),
          ir_inst_list_prepend(
            ir_inst_const_i64(leaf_kind_value, leaf_kind),
            ir_inst_list_prepend(
              ir_inst_call_i64(dst, pipeline_rc_array_storage_new_hash(), pipeline_ir_array_storage_new_args(byte_size_value, align_value, leaf_count_value, leaf_stride_value, leaf_kind_value)),
              ir_inst_list_prepend(
                ir_inst_call_i64(data, pipeline_rc_array_storage_data_hash(), ir_value_list_prepend(dst, ir_value_list_empty())),
                ir_inst_list_prepend(
                  ir_inst_record_layout_array_load_i64(data, base, record_data_size, byte_offset, byte_size, leaf_count, leaf_stride, leaf_kind),
                  ir_inst_list_empty()
                )
              )
            )
          )
        )
      )
    )
  )
  ir_lowered_expr(dst, data + 1, insts)
}

pub(package) fn pipeline_lower_field_load_for_storage_layout(dst: i64, base: i64, field_hash: i64, word_offset: i64, ty: i64, layout: PipelineRecordStorageLayout) -> IrLoweredExpr {
  let lanes = pipeline_type_value_lane_count_or_one(ty)
  match layout {
    PipelineRecordStorageLayoutDescribed(record_data_size, record_align, fields) -> {
      match pipeline_record_storage_field_fact_at_word_offset(fields, word_offset) {
        PipelineRecordStorageFieldFactArray(fact_hash, fact_word_offset, byte_offset, field_ty, byte_size, align, leaf_count, leaf_stride, leaf_kind, rest) -> {
          if fact_hash == field_hash and ty_is_array(ty) {
            pipeline_ir_owned_record_array_load(dst, base, record_data_size, byte_offset, byte_size, align, leaf_count, leaf_stride, leaf_kind)
          } else {
            ir_lowered_expr(dst, dst + lanes, pipeline_ir_invalid_field_load_lane_insts(dst, 0, lanes))
          }
        }
        _ -> ir_lowered_expr(dst, dst + lanes, pipeline_ir_field_load_lane_insts_for_storage_layout(dst, base, field_hash, word_offset, ty, layout))
      }
    }
    _ -> ir_lowered_expr(dst, dst + lanes, pipeline_ir_field_load_lane_insts_for_storage_layout(dst, base, field_hash, word_offset, ty, layout))
  }
}

pub(package) fn pipeline_ir_opt_chain_insts_for_storage_layout(dst: i64, base: i64, field_hash: i64, word_offset: i64, effect_key: i64, layout: PipelineRecordStorageLayout) -> IrInstList {
  match layout {
    PipelineRecordStorageLayoutCompact -> ir_inst_list_prepend(ir_inst_opt_chain_i64(dst, base, field_hash, word_offset, effect_key), ir_inst_list_empty())
    -- Optional projection needs the same descriptor-aware field selection as a
    -- direct projection, plus its Maybe wrapping. Keep described and invalid
    -- layouts fenced until that combined producer exists.
    _ -> ir_inst_list_prepend(ir_inst_const_i64(dst, 0), ir_inst_list_prepend(ir_inst_lowering_failure_i64(15), ir_inst_list_empty()))
  }
}

pub(package) fn pipeline_ir_variant_payload_lane_insts_inner(dst: i64, base: i64, word_offset: i64, lane: i64, count: i64) -> IrInstList {
  if lane >= count { ir_inst_list_empty() }
  else {
    ir_inst_list_prepend(
      ir_inst_variant_payload_i64(dst + lane, base, word_offset + lane),
      pipeline_ir_variant_payload_lane_insts_inner(dst, base, word_offset, lane + 1, count)
    )
  }
}

pub(package) fn pipeline_ir_variant_payload_lane_insts(dst: i64, base: i64, word_offset: i64, ty: i64) -> IrInstList {
  pipeline_ir_variant_payload_lane_insts_inner(dst, base, word_offset, 0, pipeline_type_value_lane_count_or_one(ty))
}

pub(package) fn pipeline_expr_value_lane_count(expr: Expr, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> i64 {
  pipeline_type_value_lane_count_or_one(pipeline_return_expr_type_node_typed(expr, params, locals, module))
}

pub(package) fn pipeline_expr_node_value_lane_count(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> i64 {
  pipeline_type_value_lane_count_or_one(pipeline_return_expr_type_node_from_node(expr, params, locals, module))
}

-- Lowering keeps one logical head value per source argument for ownership
-- accounting. Only the ABI call list is flattened, using the shared typed
-- value-shape fact; every extra lane is the consecutive SSA id after its
-- logical head.
pub(package) fn pipeline_call_abi_args(values: IrValueList, expected_params: i64, expected_types: i64, subst: i64, expected_offset: i64, index: i64) -> IrValueList {
  match values {
    IrValueNil -> ir_value_list_empty()
    IrValueCons(value, rest) -> {
      let ty = pipeline_expected_arg_type_node(expected_params, expected_types, index, expected_offset, subst)
      let lanes = pipeline_type_value_lane_count_or_one(ty)
      ir_value_list_append(
        pipeline_ir_value_lane_ids(value, 0, lanes),
        pipeline_call_abi_args(rest, expected_params, expected_types, subst, expected_offset, index + 1)
      )
    }
  }
}

pub(package) fn pipeline_ir_call_result_lane_insts(dst: i64, ty: i64) -> IrInstList {
  let lanes = pipeline_type_value_lane_count_or_one(ty)
  let mut insts = ir_inst_list_empty()
  for lane in 1..lanes {
    insts = ir_inst_list_append(insts, ir_inst_list_prepend(ir_inst_call_result_lane_i64(dst + lane, lane), ir_inst_list_empty()))
  }
  insts
}

pub(package) fn pipeline_ir_return_lane_insts(value: i64, ty: i64) -> IrInstList {
  let lanes = pipeline_type_value_lane_count_or_one(ty)
  let mut insts = ir_inst_list_empty()
  for lane in 1..lanes {
    insts = ir_inst_list_append(insts, ir_inst_list_prepend(ir_inst_return_lane_i64(lane, value + lane), ir_inst_list_empty()))
  }
  insts
}

pub(package) fn pipeline_lookup_effect_op(tt: i64, src: i64, eff_ns: i64, eff_nl: i64, op_ns: i64, op_nl: i64) -> TypeEffectOp {
  if tt == 0 { MissingTypeEffectOp }
  else {
    let entry = ttable_lookup(tt, src, eff_ns, eff_nl)
    if entry == 0 { MissingTypeEffectOp }
    else {
      let kind = mem_load64_at(entry, 16)
      if kind != 2 { MissingTypeEffectOp }
      else {
        let entry_src = mem_load64_at(entry, 48)
        let target_hash = effect_name_hash(src, op_ns, op_nl)
        let nops = mem_load64_at(entry, 24)
        let ops = mem_load64_at(entry, 32)
        let mut i = 0
        let mut result = MissingTypeEffectOp
        while i < nops {
          let op = nlist_get(ops, i)
          let op_hash = effect_name_hash(entry_src, node_f1(op), node_f2(op))
          if op_hash == target_hash {
            result = type_effect_op_from_node(op)
            i = nops
          } else {
            i = i + 1
          }
        }
        result
      }
    }
  }
}

pub(package) fn pipeline_lookup_effect_op_decl(tt: i64, decl: i64, src: i64, op_ns: i64, op_nl: i64) -> TypeEffectOp {
  let entry = if decl == 0 { 0 } else { ttable_lookup_decl_fact(tt, decl) }
  if entry == 0 { MissingTypeEffectOp }
  else {
    let entry_src = mem_load64_at(entry, 48)
    let target_hash = effect_name_hash(src, op_ns, op_nl)
    let ops = mem_load64_at(entry, 32)
    let mut i = 0
    let mut result = MissingTypeEffectOp
    while i < mem_load64_at(entry, 24) {
      let op = nlist_get(ops, i)
      if effect_name_hash(entry_src, node_f1(op), node_f2(op)) == target_hash {
        result = type_effect_op_from_node(op)
        i = mem_load64_at(entry, 24)
      } else { i = i + 1 }
    }
    result
  }
}

pub(package) fn pipeline_lookup_effect_op_typed(tt: i64, src: i64, effect_ref: Expr, op_ns: i64, op_nl: i64) -> TypeEffectOp {
  match effect_ref {
    FieldAccess(base, field_ns, field_nl, fact) -> pipeline_lookup_effect_op_decl(tt, field_access_fact_declaration(fact), src, op_ns, op_nl)
    _ -> pipeline_lookup_effect_op(tt, src, pipeline_effect_ref_name_start_typed(effect_ref, 0), pipeline_effect_ref_name_len_typed(effect_ref, 0), op_ns, op_nl)
  }
}

pub(package) fn pipeline_lookup_effect_op_params_nodes(tt: i64, src: i64, eff_ns: i64, eff_nl: i64, op_ns: i64, op_nl: i64) -> i64 {
  let op = pipeline_lookup_effect_op(tt, src, eff_ns, eff_nl, op_ns, op_nl)
  param_list_to_nodes(type_effect_op_params(op))
}

pub(package) fn pipeline_effect_ref_decl_subst_typed(tt: i64, src: i64, effect_ref: Expr, outer_subst: i64) -> i64 {
  let ns = pipeline_effect_ref_name_start_typed(effect_ref, 0)
  let nl = pipeline_effect_ref_name_len_typed(effect_ref, 0)
  let entry = match effect_ref {
    FieldAccess(base, field_ns, field_nl, fact) -> {
      let decl = field_access_fact_declaration(fact)
      if decl == 0 { 0 } else { ttable_lookup_decl_fact(tt, decl) }
    }
    _ -> if tt == 0 or nl == 0 { 0 } else { ttable_lookup(tt, src, ns, nl) }
  }
  match effect_ref {
    GenericCall(type_args, inner) -> {
      let raw_args = type_expr_list_to_nodes(type_args)
      let args = if outer_subst == 0 { raw_args } else { type_list_subst(raw_args, outer_subst) }
      effect_entry_atom_subst(entry, ty_effect_app_args(effect_name_hash(src, ns, nl), args))
    }
    FieldAccess(base, field_ns, field_nl, fact) -> {
      match fact {
        ResolvedEffectAccessFact(decl, type_args) -> {
          let raw_args = type_expr_list_to_nodes(type_args)
          let args = if outer_subst == 0 { raw_args } else { type_list_subst(raw_args, outer_subst) }
          effect_entry_atom_subst(entry, ty_effect_app_args(effect_name_hash(src, ns, nl), args))
        }
        _ -> 0
      }
    }
    _ -> 0
  }
}

pub(package) fn pipeline_effect_op_params_nodes_typed(tt: i64, src: i64, effect_ref: Expr, op_ns: i64, op_nl: i64, outer_subst: i64) -> i64 {
  let ns = pipeline_effect_ref_name_start_typed(effect_ref, 0)
  let nl = pipeline_effect_ref_name_len_typed(effect_ref, 0)
  let raw = param_list_to_nodes(type_effect_op_params(pipeline_lookup_effect_op_typed(tt, src, effect_ref, op_ns, op_nl)))
  let effect_subst = pipeline_effect_ref_decl_subst_typed(tt, src, effect_ref, outer_subst)
  let locally_concrete = if effect_subst == 0 { raw } else { cg_params_subst(raw, effect_subst) }
  if outer_subst == 0 { locally_concrete } else { cg_params_subst(locally_concrete, outer_subst) }
}

pub(package) fn pipeline_effect_op_return_type_typed(tt: i64, src: i64, effect_ref: Expr, op_ns: i64, op_nl: i64, outer_subst: i64) -> i64 {
  let ns = pipeline_effect_ref_name_start_typed(effect_ref, 0)
  let nl = pipeline_effect_ref_name_len_typed(effect_ref, 0)
  let raw = type_expr_to_node(type_effect_op_return_type(pipeline_lookup_effect_op_typed(tt, src, effect_ref, op_ns, op_nl)))
  let effect_subst = pipeline_effect_ref_decl_subst_typed(tt, src, effect_ref, outer_subst)
  let locally_concrete = if raw != 0 and effect_subst != 0 { ty_subst(raw, effect_subst) } else { raw }
  if locally_concrete != 0 and outer_subst != 0 { ty_subst(locally_concrete, outer_subst) } else { locally_concrete }
}

pub(package) fn pipeline_fn_return_int_prim(fn_wrap: i64, subst: i64) -> i64 {
  let raw_ty = fn_ret_type(fn_wrap)
  let concrete_ty = if subst == 0 { raw_ty } else { ty_subst(raw_ty, subst) }
  let prim = type_expr_prim_id_or(type_expr_from_node(concrete_ty), 0 - 1)
  if prim_is_integer(prim) == 1 { prim } else { 0 - 1 }
}

pub(package) fn pipeline_fns_lookup_ret_int_prim_by_hash(fns: i64, target_hash: i64, subst: i64) -> i64 {
  let pair = pipeline_fns_lookup_pair_by_hash(fns, target_hash)
  if pair == 0 { 0 - 1 }
  else {
    pipeline_fn_return_int_prim(node_f1(pair), subst)
  }
}

pub(package) fn pipeline_fns_lookup_ret_int_prim(fns: i64, src: i64, ns: i64, nl: i64, subst: i64) -> i64 {
  pipeline_fns_lookup_ret_int_prim_by_hash(fns, str_hash(src, ns, nl), subst)
}

pub(package) fn pipeline_prim_is_native_i64_equivalent(prim: i64) -> i64 {
  prim == PRIM_I64() or prim == PRIM_ISIZE()
}

pub(package) fn pipeline_prim_is_non_native_int(prim: i64) -> i64 {
  prim_is_integer(prim) == 1 and pipeline_prim_is_native_i64_equivalent(prim) == 0
}

pub(package) fn pipeline_prim_is_numeric_context(prim: i64) -> i64 {
  prim == PRIM_F32() or prim == PRIM_F64() or prim_is_integer(prim) == 1
}

pub(package) fn pipeline_prim_is_forced_numeric_context(prim: i64) -> i64 {
  if prim == PRIM_F32() or prim == PRIM_F64() {
    1
  } else {
    prim_is_integer(prim) == 1 and pipeline_prim_is_native_i64_equivalent(prim) == 0
  }
}

pub(package) fn pipeline_fns_call_arg_float_prim(fns: i64, src: i64, ns: i64, nl: i64, arg_index: i64, subst: i64) -> i64 {
  pipeline_param_float_prim_at(pipeline_fns_lookup_params(fns, src, ns, nl), arg_index, subst)
}

pub(package) fn pipeline_fn_return_float_prim(fn_wrap: i64, subst: i64) -> i64 {
  let raw_ty = fn_ret_type(fn_wrap)
  let concrete_ty = if subst == 0 { raw_ty } else { ty_subst(raw_ty, subst) }
  let prim = type_expr_prim_id_or(type_expr_from_node(concrete_ty), 0)
  if prim == PRIM_F32() or prim == PRIM_F64() { prim } else { 0 }
}

pub(package) fn pipeline_value_env_empty() -> PipelineValueEnv {
  PipelineValueEnvNil
}

pub(package) fn pipeline_value_env_push(env: PipelineValueEnv, ns: i64, nl: i64, value: i64) -> PipelineValueEnv {
  PipelineValueEnvCons(ns, nl, value, 0, 0, 0, 0, env)
}

pub(package) fn pipeline_value_env_push_float(env: PipelineValueEnv, ns: i64, nl: i64, value: i64, float_prim: i64) -> PipelineValueEnv {
  PipelineValueEnvCons(ns, nl, value, 0, float_prim, 0, 0, env)
}

pub(package) fn pipeline_value_env_push_float_typed(env: PipelineValueEnv, ns: i64, nl: i64, value: i64, float_prim: i64, type_hash: i64) -> PipelineValueEnv {
  PipelineValueEnvCons(ns, nl, value, 0, float_prim, type_hash, 0, env)
}

pub(package) fn pipeline_value_env_push_float_typed_node(env: PipelineValueEnv, ns: i64, nl: i64, value: i64, float_prim: i64, type_hash: i64, type_node: i64) -> PipelineValueEnv {
  PipelineValueEnvCons(ns, nl, value, 0, float_prim, type_hash, type_node, env)
}

pub(package) fn pipeline_value_env_push_slot(env: PipelineValueEnv, ns: i64, nl: i64, slot: i64) -> PipelineValueEnv {
  PipelineValueEnvCons(ns, nl, slot, 1, 0, 0, 0, env)
}

pub(package) fn pipeline_value_env_push_slot_float(env: PipelineValueEnv, ns: i64, nl: i64, slot: i64, float_prim: i64) -> PipelineValueEnv {
  PipelineValueEnvCons(ns, nl, slot, 1, float_prim, 0, 0, env)
}

pub(package) fn pipeline_value_env_push_slot_float_typed(env: PipelineValueEnv, ns: i64, nl: i64, slot: i64, float_prim: i64, type_hash: i64) -> PipelineValueEnv {
  PipelineValueEnvCons(ns, nl, slot, 1, float_prim, type_hash, 0, env)
}

pub(package) fn pipeline_value_env_push_slot_float_typed_node(env: PipelineValueEnv, ns: i64, nl: i64, slot: i64, float_prim: i64, type_hash: i64, type_node: i64) -> PipelineValueEnv {
  PipelineValueEnvCons(ns, nl, slot, 1, float_prim, type_hash, type_node, env)
}

pub(package) fn pipeline_value_env_push_param_values(params: i64, values: IrValueList, index: i64, count: i64, subst: i64, env: PipelineValueEnv) -> PipelineValueEnv {
  if params == 0 or index >= count {
    env
  } else {
    let param = nlist_get(params, index)
    let raw_ty = node_f3(param)
    let ty = if subst == 0 { raw_ty } else { ty_subst(raw_ty, subst) }
    let type_hash = if ty == 0 { 0 } else { type_hash_of(ty) }
    let float_prim = type_expr_prim_id_or(type_expr_from_node(ty), 0)
    let value = pipeline_ir_value_list_get_or(values, index, 0 - 1)
    let next = if value < 0 {
      env
    } else {
      pipeline_value_env_push_float_typed_node(env, node_f1(param), node_f2(param), value, float_prim, type_hash, ty)
    }
    pipeline_value_env_push_param_values(params, values, index + 1, count, subst, next)
  }
}

pub(package) fn pipeline_value_env_lookup(env: PipelineValueEnv, src: i64, ns: i64, nl: i64) -> i64 {
  match env {
    PipelineValueEnvNil -> 0 - 1
    PipelineValueEnvCons(bind_ns, bind_nl, value, kind, float_prim, type_hash, type_node, rest) -> {
      if bind_nl == nl {
        if src_eq_at(src, ns, src + bind_ns, 0, nl) == 1 {
          value
        } else {
          pipeline_value_env_lookup(rest, src, ns, nl)
        }
      } else {
        pipeline_value_env_lookup(rest, src, ns, nl)
      }
    } }
  }
}

pub(package) fn pipeline_value_env_lookup_kind(env: PipelineValueEnv, src: i64, ns: i64, nl: i64) -> i64 {
  match env {
    PipelineValueEnvNil -> 0 - 1
    PipelineValueEnvCons(bind_ns, bind_nl, value, kind, float_prim, type_hash, type_node, rest) -> {
      if bind_nl == nl {
        if src_eq_at(src, ns, src + bind_ns, 0, nl) == 1 {
          kind
        } else {
          pipeline_value_env_lookup_kind(rest, src, ns, nl)
        }
      } else {
        pipeline_value_env_lookup_kind(rest, src, ns, nl)
      }
    }
  }
}

pub(package) fn pipeline_value_env_lookup_float_prim(env: PipelineValueEnv, src: i64, ns: i64, nl: i64) -> i64 {
  match env {
    PipelineValueEnvNil -> 0
    PipelineValueEnvCons(bind_ns, bind_nl, value, kind, float_prim, type_hash, type_node, rest) -> {
      if bind_nl == nl {
        if src_eq_at(src, ns, src + bind_ns, 0, nl) == 1 {
          float_prim
        } else {
          pipeline_value_env_lookup_float_prim(rest, src, ns, nl)
        }
      } else {
        pipeline_value_env_lookup_float_prim(rest, src, ns, nl)
      }
    }
  }
}

pub(package) fn pipeline_value_env_lookup_type_hash(env: PipelineValueEnv, src: i64, ns: i64, nl: i64) -> i64 {
  match env {
    PipelineValueEnvNil -> 0
    PipelineValueEnvCons(bind_ns, bind_nl, value, kind, float_prim, type_hash, type_node, rest) -> {
      if bind_nl == nl {
        if src_eq_at(src, ns, src + bind_ns, 0, nl) == 1 {
          type_hash
        } else {
          pipeline_value_env_lookup_type_hash(rest, src, ns, nl)
        }
      } else {
        pipeline_value_env_lookup_type_hash(rest, src, ns, nl)
      }
    }
  }
}

pub(package) fn pipeline_value_env_lookup_type_node(env: PipelineValueEnv, src: i64, ns: i64, nl: i64) -> i64 {
  match env {
    PipelineValueEnvNil -> 0
    PipelineValueEnvCons(bind_ns, bind_nl, value, kind, float_prim, type_hash, type_node, rest) -> {
      if bind_nl == nl {
        if src_eq_at(src, ns, src + bind_ns, 0, nl) == 1 {
          type_node
        } else {
          pipeline_value_env_lookup_type_node(rest, src, ns, nl)
        }
      } else {
        pipeline_value_env_lookup_type_node(rest, src, ns, nl)
      }
    }
  }
}

pub(package) fn pipeline_param_type_node_default_i64(param: Param) -> i64 {
  match param {
    Param(ns, nl, ty, label) -> {
      match ty {
        MissingTypeExpr -> ty_i64()
        _ -> type_expr_to_node(ty)
      }
    }
    UnknownParam(tag) -> ty_i64()
  }
}

pub(package) fn pipeline_param_list_type_nodes_default_i64_into(params: ParamList, nodes: i64) -> i64 {
  match params {
    ParamListNil -> nodes
    ParamListCons(param, rest) -> {
      nlist_add(nodes, pipeline_param_type_node_default_i64(param))
      pipeline_param_list_type_nodes_default_i64_into(rest, nodes)
    }
  }
}

pub(package) fn pipeline_param_list_type_nodes_default_i64(params: ParamList) -> i64 {
  pipeline_param_list_type_nodes_default_i64_into(params, nlist_new())
}

pub(package) fn pipeline_lambda_type_node(params: ParamList) -> i64 {
  ty_fn(pipeline_param_list_type_nodes_default_i64(params), ty_any(), ty_effect_pure())
}

pub(package) fn pipeline_lambda_type_node_typed(lambda_params: ParamList, body: Expr, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> i64 {
  let src = pipeline_lower_module_src(module)
  let available = pipeline_lambda_capture_env_with_params(params, locals, src)
  let lambda_param_nodes = param_list_to_nodes(lambda_params)
  let inferred_return = pipeline_return_expr_type_node_typed(body, lambda_param_nodes, available, module)
  let return_ty = if inferred_return != 0 { inferred_return } else { ty_any() }
  ty_fn(pipeline_param_list_type_nodes_default_i64(lambda_params), return_ty, ty_effect_pure())
}

pub(package) fn pipeline_structural_record_types_into(fields: RecordFieldList, types: i64) -> i64 {
  match fields {
    RecordFieldListNil -> types
    RecordFieldListCons(field, rest) -> {
      nlist_add(types, record_field_resolved_type_node(field))
      pipeline_structural_record_types_into(rest, types)
    }
  }
}

pub(package) fn pipeline_structural_record_fields_into(fields: RecordFieldList, typed_fields: i64) -> i64 {
  match fields {
    RecordFieldListNil -> typed_fields
    RecordFieldListCons(field, rest) -> {
      match field {
        RecordField(ns, nl, value, fact) -> {
          nlist_add(typed_fields, ty_record_field(record_field_hash_or(field, 0), record_field_resolved_type_node(field), ns, nl))
          pipeline_structural_record_fields_into(rest, typed_fields)
        }
        UnknownRecordField(tag) -> pipeline_structural_record_fields_into(rest, typed_fields)
      }
    }
  }
}

pub(package) fn pipeline_structural_record_value_type(fields: RecordFieldList, tuple_kind: i64) -> i64 {
  if tuple_kind == 1 {
    ty_tuple(pipeline_structural_record_types_into(fields, nlist_new()))
  } else {
    ty_record(pipeline_structural_record_fields_into(fields, nlist_new()), 0)
  }
}

pub(package) fn pipeline_expr_type_node_typed(expr: Expr) -> i64 {
  match expr {
    IntLit(value, start, len) -> ty_i64()
    StringLit(start, len) -> ty_str()
    BoolLit(value) -> ty_bool()
    FloatLit(start, len) -> ty_f64()
    NilExpr -> ty_nil()
    Lambda(params, body, source_site) -> pipeline_lambda_type_node(params)
    ArrayLiteral(elements, resolved_ty, span) -> resolved_ty
    IndexedLen(base, fixed_len) -> ty_usize()
    IndexedGet(base, index, element_ty, fixed_len) -> element_ty
    IndexedSet(base, index, value, fact) -> ty_nil()
    IndexedSlice(base, start, end, fact) -> if fact == 0 { ty_any() } else { ty_slice_with_mut(node_f1(fact), node_f4(fact)) }
    RecordInit(type_ns, type_nl, fields) -> if type_ns == 0 and type_nl <= 0 {
      pipeline_structural_record_value_type(fields, if type_nl < 0 { 1 } else { 0 })
    } else { 0 }
    RecordUpdate(base, fields, fact) -> record_update_fact_result_type_node(fact)
    _ -> 0
  }
}

pub(package) fn pipeline_expr_type_node_from_node(expr: i64) -> i64 {
  let stripped = pipeline_expr_node_strip_typed(expr)
  if stripped == 0 { 0 }
  else {
    if node_tag(stripped) == 29 {
      pipeline_lambda_type_node(param_list_from_nodes(node_f1(stripped), 0, node_f3(stripped)))
    } else {
      if node_tag(stripped) == 37 { node_f2(stripped) }
      else { if node_tag(stripped) == 58 { node_f3(stripped) }
      else { if node_tag(stripped) == 59 { ty_usize() }
      else { if node_tag(stripped) == 60 { node_f3(stripped) }
      else { if node_tag(stripped) == 61 { ty_nil() }
      else { if node_tag(stripped) == 62 {
        let fact = node_f4(stripped)
        if fact == 0 { ty_any() } else { ty_slice_with_mut(node_f1(fact), node_f4(fact)) }
      } else { if node_tag(stripped) == 63 {
        let fact = node_f4(stripped)
        if fact == 0 { 0 } else { node_f1(fact) }
      } else { 0 } } } } } } }
    }
  }
}

pub(package) fn pipeline_function_return_type_with_subst(fn_wrap: i64, subst: i64, tt: i64) -> i64 {
  if subst == 0 { fn_ret_type(fn_wrap) }
  else { typeck_subst_resolve_associated_type(fn_ret_type(fn_wrap), fn_tparams(fn_wrap), subst, tt) }
}

-- Qualified module calls are represented as Perform(FieldAccess(...)) so the
-- declaration fact, rather than the surface spelling, distinguishes them
-- from effect operations. Preserve that producer-owned result type here;
-- otherwise a let-bound imported `Generic<T>` loses T's concrete shape and
-- constructor patterns fall back to a single payload lane.
pub(package) fn pipeline_qualified_function_result_type_node_typed(call: Expr, type_args: TypeExprList, module: PipelineLowerModule) -> i64 {
  match call {
    Perform(FieldAccess(base, field_ns, field_nl, fact), op_ns, op_nl, args) -> {
      let pair = module_decl_fact_function_pair(field_access_fact_declaration(fact))
      if pair == 0 { 0 }
      else {
        let fn_wrap = node_f1(pair)
        let concrete_args = pipeline_type_expr_list_subst(type_args, pipeline_lower_module_subst(module))
        let call_subst = if fn_tparams(fn_wrap) == 0 or type_expr_list_len(concrete_args) == 0 {
          pipeline_lower_module_subst(module)
        } else {
          cg_build_subst(fn_tparams(fn_wrap), type_expr_list_to_nodes(concrete_args))
        }
        pipeline_function_return_type_with_subst(fn_wrap, call_subst, pipeline_lower_module_tt(module))
      }
    }
    _ -> 0
  }
}

-- Calls on bounded type variables remain neutral Perform nodes after checking:
-- the concrete implementation is a monomorphisation fact, not a property of
-- the shared generic template. Mirror lowering's lexical-receiver resolution
-- here so result shape, ownership and cleanup all consume that same concrete
-- method fact before the expression can be mistaken for an effect operation.
pub(package) fn pipeline_delayed_method_result_type_node_typed(lhs: Expr, method_ns: i64, method_nl: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> i64 {
  match lhs {
    Ident(ns, nl) -> {
      let src = pipeline_lower_module_src(module)
      let subst = pipeline_lower_module_subst(module)
      let local_ty = pipeline_value_env_lookup_type_node(locals, src, ns, nl)
      let receiver_ty = if local_ty != 0 {
        ty_subst(local_ty, subst)
      } else {
        pipeline_param_type_node_by_name(params, src, ns, nl, subst)
      }
      let method_hash = effect_name_hash(src, method_ns, method_nl)
      let method_ref = pipeline_resolve_method_ref(pipeline_lower_module_tt(module), receiver_ty, method_hash)
      if method_ref == 0 { 0 }
      else {
        pipeline_method_ref_result_type(
          pipeline_lower_module_tt(module), method_ref, method_hash, subst
        )
      }
    }
    _ -> 0
  }
}

-- A handler return clause binds the handled body's completion value. Result
-- shape is therefore a two-step fact: infer the body first, then infer the
-- transform with that typed binder in scope. Treating the clause like an
-- ordinary expression loses generic/wide completion shapes (`T`, tuples,
-- slices) and makes later CFG edges carry only the head lane.
pub(package) fn pipeline_handle_result_type_node_typed(body: Expr, hret: HandleReturn, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> i64 {
  let body_ty = pipeline_return_expr_type_node_typed(body, params, locals, module)
  match hret {
    NoHandleReturn -> body_ty
    HandleReturnClause(rns, rnl, rb) -> {
      let return_locals = pipeline_value_env_push_float_typed_node(
        locals,
        rns,
        rnl,
        0,
        pipeline_type_node_prim_id_or(body_ty, 0),
        if body_ty == 0 { 0 } else { type_hash_of(body_ty) },
        body_ty
      )
      pipeline_return_expr_type_node_typed(rb, params, return_locals, module)
    }
  }
}

pub(package) fn pipeline_return_expr_type_node_typed(expr: Expr, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> i64 {
  let src = pipeline_lower_module_src(module)
  let fns = pipeline_lower_module_fns(module)
  let subst = pipeline_lower_module_subst(module)
  match expr {
    Ident(ns, nl) -> {
      let local_ty = pipeline_value_env_lookup_type_node(locals, src, ns, nl)
      if local_ty != 0 { local_ty } else { pipeline_param_type_node_by_name(params, src, ns, nl, subst) }
    }
    BorrowIdent(ns, nl, owner, mutable) -> {
      let local_ty = pipeline_value_env_lookup_type_node(locals, src, ns, nl)
      let bound_ty = if local_ty != 0 { local_ty } else { pipeline_param_type_node_by_name(params, src, ns, nl, subst) }
      if bound_ty == 0 { 0 }
      else { if ty_is_borrow(bound_ty) { bound_ty }
      else {
        let borrowed_ty = if ty_is_owned(bound_ty) { ty_owned_inner(bound_ty) }
          else { if ty_is_unique(bound_ty) { ty_unique_inner(bound_ty) } else { bound_ty } }
        ty_borrow_with_mut(borrowed_ty, mutable)
      } }
    }
    Call(ns, nl, args) -> {
      pipeline_call_result_type_node(params, locals, src, pipeline_lower_module_tt(module), fns, subst, ns, nl)
    }
    GenericCall(type_args, inner_call) -> {
      let qualified = pipeline_qualified_function_result_type_node_typed(inner_call, type_args, module)
      if qualified != 0 { qualified }
      else { match inner_call {
        Call(ns, nl, args) -> {
          let pair = pipeline_generic_template_find(fns, src, str_hash(src, ns, nl))
          if pair == 0 {
            let tt = pipeline_lower_module_tt(module)
            let concrete = pipeline_type_expr_list_subst(type_args, subst)
            let opaque = typeck_named_type_from_declaration(
              tt,
              pipeline_local_opaque_type_declaration(tt, src, ns, nl),
              type_expr_list_to_nodes(concrete)
            )
            if opaque != 0 {
              opaque
            } else {
              pipeline_variant_parent_type_node_with_args(
                tt,
                src,
                ns,
                nl,
                type_expr_list_to_nodes(concrete)
              )
            }
          }
          else {
            let fn_wrap = node_f1(pair)
            let concrete = pipeline_type_expr_list_subst(type_args, subst)
            let s = cg_build_subst(fn_tparams(fn_wrap), type_expr_list_to_nodes(concrete))
            pipeline_function_return_type_with_subst(fn_wrap, s, pipeline_lower_module_tt(module))
          }
        }
        _ -> pipeline_return_expr_type_node_typed(inner_call, params, locals, module)
      } }
    }
    -- Method resolution is a checker-owned fact. Consume its exact result
    -- type here instead of asking callers to rediscover the return shape from
    -- syntax. General `for` elaboration depends on this for Iterator<Item>,
    -- and the same rule keeps let/control-flow inference precise for generic
    -- inherent and trait methods.
    MethodCall(recv, method_hash, args, method_ref) -> pipeline_method_ref_result_type(
      pipeline_lower_module_tt(module),
      method_ref,
      method_hash,
      subst
    )
    Perform(lhs, op_ns, op_nl, args) -> {
      let delayed_method = pipeline_delayed_method_result_type_node_typed(lhs, op_ns, op_nl, params, locals, module)
      if delayed_method != 0 { delayed_method }
      else {
        let qualified = pipeline_qualified_function_result_type_node_typed(expr, type_expr_list_empty(), module)
        if qualified != 0 { qualified }
        else { pipeline_effect_op_return_type_typed(
          pipeline_lower_module_tt(module),
          src,
          lhs,
          op_ns,
          op_nl,
          subst
        ) }
      }
    }
    RecordInit(type_ns, type_nl, fields) -> if type_ns == 0 and type_nl <= 0 {
      ty_subst(
        pipeline_structural_record_value_type(fields, if type_nl < 0 { 1 } else { 0 }),
        subst
      )
    } else { typecheck_resolve_type(pipeline_lower_module_tt(module), src, type_ns, type_nl) }
    RecordUpdate(base, fields, fact) -> ty_subst(record_update_fact_result_type_node(fact), subst)
    FieldAccess(base, field_ns, field_nl, fact) -> {
      let resolved = field_access_fact_field_type_node(fact)
      if resolved != 0 { ty_subst(resolved, subst) }
      else {
        pipeline_typed_field_type_for_base(
          pipeline_lower_module_tt(module),
          src,
          field_ns,
          field_nl,
          base,
          params,
          locals,
          module
        )
      }
    }
    ArrayLiteral(elements, resolved_ty, span) -> ty_subst(resolved_ty, subst)
    IndexedLen(base, fixed_len) -> ty_usize()
    IndexedGet(base, index, element_ty, fixed_len) -> ty_subst(element_ty, subst)
    IndexedSet(base, index, value, fact) -> ty_nil()
    IndexedSlice(base, start, end, fact) -> if fact == 0 { ty_any() } else { ty_slice_with_mut(ty_subst(node_f1(fact), subst), node_f4(fact)) }
    Block(first, rest) -> pipeline_return_expr_type_node_typed(rest, params, locals, module)
    -- A body that returns its own binding types as the binding's init:
    -- transfer retains for match-arm-local bindings depend on this (the
    -- binding is not in the fn-level locals env at transfer time).
    Let(ns, nl, value, body) -> {
      let body_ty = pipeline_return_expr_type_node_typed(body, params, locals, module)
      if body_ty != 0 { body_ty }
      else {
        if pipeline_expr_final_returns_binding_typed(body, src, ns, nl) == 1 {
          pipeline_return_expr_type_node_typed(value, params, locals, module)
        } else { 0 }
      }
    }
    LetMut(ns, nl, value, body) -> {
      let body_ty = pipeline_return_expr_type_node_typed(body, params, locals, module)
      if body_ty != 0 { body_ty }
      else {
        if pipeline_expr_final_returns_binding_typed(body, src, ns, nl) == 1 {
          pipeline_return_expr_type_node_typed(value, params, locals, module)
        } else { 0 }
      }
    }
    LetTyped(inner, ann_type) -> {
      let ann_ty = ty_subst(type_expr_to_node(ann_type), subst)
      let ann_hash = type_hash_of(ann_ty)
      match inner {
        Let(ns, nl, value, body) -> pipeline_return_expr_type_node_typed(
          body,
          params,
          pipeline_value_env_push_float_typed_node(locals, ns, nl, 0, 0, ann_hash, ann_ty),
          module
        )
        LetMut(ns, nl, value, body) -> pipeline_return_expr_type_node_typed(
          body,
          params,
          pipeline_value_env_push_float_typed_node(locals, ns, nl, 0, 0, ann_hash, ann_ty),
          module
        )
        _ -> ann_ty
      }
    }
    Defer(cleanup, body, source_site) -> pipeline_return_expr_type_node_typed(body, params, locals, module)
    Resume(value) -> pipeline_return_expr_type_node_typed(value, params, locals, module)
    Try(inner, effect_atom) -> pipeline_try_success_type(
      pipeline_return_expr_type_node_typed(inner, params, locals, module)
    )
    Handle(body, clauses, hret) -> pipeline_handle_result_type_node_typed(body, hret, params, locals, module)
    WithHandler(config, body, fact, source_site) -> pipeline_return_expr_type_node_typed(body, params, locals, module)
    If(cond, then_expr, else_expr) -> {
      let then_ty = pipeline_return_expr_type_node_typed(then_expr, params, locals, module)
      let else_ty = pipeline_return_expr_type_node_typed(else_expr, params, locals, module)
      pipeline_control_result_type_join(then_ty, else_ty)
    }
    Match(scrutinee, arms) -> {
      let scrutinee_ty = pipeline_return_expr_type_node_typed(scrutinee, params, locals, module)
      pipeline_match_arms_result_type_node_with_scrutinee_typed(arms, params, locals, module, scrutinee_ty)
    }
    Lambda(lambda_params, body, source_site) -> pipeline_lambda_type_node_typed(lambda_params, body, params, locals, module)
    _ -> pipeline_expr_type_node_typed(expr)
  }
}

-- Control-flow result shape is the join of its reachable completions. `never`
-- contributes no values to that join: an abortive Fail arm cannot force a
-- wide sibling result back to the one-lane fallback. Unknown inference remains
-- unknown so lowering does not invent a shape that the checker did not prove.
pub(package) fn pipeline_control_result_type_join(left: i64, right: i64) -> i64 {
  if left == 0 or right == 0 { 0 }
  else { if ty_eq(left, ty_never()) { right }
  else { if ty_eq(right, ty_never()) { left }
  else { if type_hash_of(left) == type_hash_of(right) { left } else { 0 } } } }
}

pub(package) fn pipeline_type_result_never(ty: i64) -> i64 {
  if ty != 0 and ty_eq(ty, ty_never()) { 1 } else { 0 }
}

-- Index of a named binding within a ctor pattern's binding list, or -1.
pub(package) fn pipeline_pattern_binding_index(bindings: PatternList, src: i64, ns: i64, nl: i64, index: i64) -> i64 {
  match bindings {
    PatternListNil -> 0 - 1
    PatternListCons(binding, rest) -> {
      let found = match binding {
        Binding(bns, bnl) -> pipeline_name_matches(src, ns, nl, bns, bnl)
        _ -> 0
      }
      if found == 1 { index } else { pipeline_pattern_binding_index(rest, src, ns, nl, index + 1) }
    }
  }
}

-- Resolve a binding anywhere inside a recursive pattern against the concrete
-- type tested at that point. This is the ownership/type-fact counterpart of
-- recursive pattern lowering: a nested payload returned from an arm remains
-- a typed borrow, so the merge can retain it before releasing an owned
-- scrutinee.
pub(package) fn pipeline_pattern_binding_type_node_list(patterns: PatternList, payload_types: i64, subst: i64, index: i64, src: i64, ns: i64, nl: i64, module: PipelineLowerModule) -> i64 {
  match patterns {
    PatternListNil -> 0
    PatternListCons(pattern, rest) -> {
      let payload_ty = pipeline_expected_arg_type_node(0, payload_types, index, 0, subst)
      let found = pipeline_pattern_binding_type_node(pattern, payload_ty, src, ns, nl, module)
      if found != 0 { found }
      else { pipeline_pattern_binding_type_node_list(rest, payload_types, subst, index + 1, src, ns, nl, module) }
    }
  }
}

pub(package) fn pipeline_pattern_binding_type_node_tuple(patterns: PatternList, tuple_ty: i64, index: i64, src: i64, ns: i64, nl: i64, module: PipelineLowerModule) -> i64 {
  match patterns {
    PatternListNil -> 0
    PatternListCons(pattern, rest) -> {
      let field = ty_record_field_at_layout_index(tuple_ty, index)
      let field_ty = if field == 0 { 0 } else { ty_record_field_type(field) }
      let found = pipeline_pattern_binding_type_node(pattern, field_ty, src, ns, nl, module)
      if found != 0 { found }
      else { pipeline_pattern_binding_type_node_tuple(rest, tuple_ty, index + 1, src, ns, nl, module) }
    }
  }
}

pub(package) fn pipeline_pattern_binding_type_node_fields(fields: PatternFieldList, src: i64, ns: i64, nl: i64, module: PipelineLowerModule) -> i64 {
  match fields {
    PatternFieldListNil -> 0
    PatternFieldListCons(field, rest) -> {
      let found = match field {
        PatternField(field_ns, field_nl, pattern, fact) -> {
          let raw_ty = field_access_fact_field_type_node(fact)
          let field_ty = if raw_ty == 0 { 0 } else { ty_subst(raw_ty, pipeline_lower_module_subst(module)) }
          pipeline_pattern_binding_type_node(pattern, field_ty, src, ns, nl, module)
        }
        UnknownPatternField(tag) -> 0
      }
      if found != 0 { found } else { pipeline_pattern_binding_type_node_fields(rest, src, ns, nl, module) }
    }
  }
}

pub(package) fn pipeline_pattern_opaque_representation(type_entry: i64, destructured_ty: i64, module: PipelineLowerModule) -> i64 {
  if ty_named_is_opaque(destructured_ty) { ty_named_opaque_representation(destructured_ty) }
  else {
    let raw = ttable_entry_opaque_representation(type_entry)
    let tparams = mem_load64_at(type_entry, 40)
    let subst = pipeline_lower_module_subst(module)
    if tparams == 0 { raw }
    else { if subst == 0 { 0 } else { ty_subst(raw, subst) } }
  }
}

pub(package) fn pipeline_pattern_binding_type_node(pattern: Pattern, scrutinee_ty: i64, src: i64, ns: i64, nl: i64, module: PipelineLowerModule) -> i64 {
  match pattern {
    Binding(bns, bnl) -> if pipeline_name_matches(src, ns, nl, bns, bnl) == 1 { scrutinee_ty } else { 0 }
    TypedBinding(bns, bnl, ann) -> if pipeline_name_matches(src, ns, nl, bns, bnl) == 1 {
      ty_subst(ann, pipeline_lower_module_subst(module))
    } else { 0 }
    CtorPattern(tag_ns, tag_nl, patterns, declaration) -> {
      let destructured_ty = typeck_match_pattern_scrutinee_type(pattern_to_node(pattern), scrutinee_ty)
      let type_entry = if declaration == 0 { 0 } else { ttable_lookup_decl_fact(pipeline_lower_module_tt(module), declaration) }
      if type_entry != 0 and mem_load64_at(type_entry, 16) == 5 {
        let representation = pipeline_pattern_opaque_representation(type_entry, destructured_ty, module)
        let payload_types = nlist_new()
        nlist_add(payload_types, representation)
        pipeline_pattern_binding_type_node_list(patterns, payload_types, 0, 0, src, ns, nl, module)
      } else {
        let ctor_src = if declaration == 0 { src } else { module_decl_fact_source(declaration) }
        let ctor_ns = if declaration == 0 { tag_ns } else { module_decl_fact_name_ptr(declaration) - ctor_src }
        let subst = pipeline_match_variant_instance_subst(
          pipeline_lower_module_tt(module),
          ctor_src,
          ctor_ns,
          tag_nl,
          scrutinee_ty,
          pipeline_lower_module_subst(module)
        )
        let payload_types = pipeline_variant_payload_types(pipeline_lower_module_tt(module), ctor_src, ctor_ns, tag_nl)
        pipeline_pattern_binding_type_node_list(patterns, payload_types, subst, 0, src, ns, nl, module)
      }
    }
    RecordPattern(fields) -> pipeline_pattern_binding_type_node_fields(fields, src, ns, nl, module)
    TuplePattern(items) -> pipeline_pattern_binding_type_node_tuple(items, scrutinee_ty, 0, src, ns, nl, module)
    _ -> 0
  }
}

-- Result type of a match arm. The accessor shape — an arm body that
-- returns a ctor-pattern payload binding — resolves the Ident against
-- the ctor's payload types (managed aggregate ownership): the ownership machinery needs
-- Named payload types to classify accessor returns as managed borrows,
-- or the transfer retain never fires while callee/caller releases do.
pub(package) fn pipeline_match_arm_result_type_node_typed(arm: MatchArm, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> i64 {
  match arm {
    Arm(pattern, body, guard, has_guard) -> {
      let direct = pipeline_return_expr_type_node_typed(body, params, locals, module)
      if direct != 0 { direct }
      else {
        let src = pipeline_lower_module_src(module)
        let payload_ty = match pattern {
          CtorPattern(tag_ns, tag_nl, bindings, declaration) -> {
            match body {
              Ident(ns, nl) -> {
                let idx = pipeline_pattern_binding_index(bindings, src, ns, nl, 0)
                if idx < 0 { 0 }
                else {
                  let ctor_src = if declaration == 0 { src } else { module_decl_fact_source(declaration) }
                  let ctor_ns = if declaration == 0 { tag_ns } else { module_decl_fact_name_ptr(declaration) - ctor_src }
                  let payload_types = pipeline_variant_payload_types(pipeline_lower_module_tt(module), ctor_src, ctor_ns, tag_nl)
                  pipeline_expected_arg_type_node(0, payload_types, idx, 0, pipeline_lower_module_subst(module))
                }
              }
              _ -> 0
            }
          }
          _ -> 0
        }
        if payload_ty != 0 { payload_ty }
        else {
          -- Payload-less variant ctors in arm position are Ident-shaped
          -- (e.g. `UnknownHandlerClause(tag) -> ParamListNil`): resolve
          -- them here so accessors' arms agree on the type and the
          -- transfer retain fires. Scoped to match arms on purpose —
          -- resolving ctor Idents in general expression positions
          -- changes if-arm mixedness and emission broadly.
          match body {
            Ident(ns, nl) -> pipeline_variant_parent_type_node(pipeline_lower_module_tt(module), src, ns, nl)
            _ -> 0
          }
        }
      }
    }
    UnknownArm(tag) -> 0
  }
}

pub(package) fn pipeline_match_arm_result_type_node_with_scrutinee_typed(arm: MatchArm, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, scrutinee_ty: i64) -> i64 {
  let direct = pipeline_match_arm_result_type_node_typed(arm, params, locals, module)
  if direct != 0 {
    match arm {
      Arm(pattern, body, guard, has_guard) -> match pattern {
        CtorPattern(tag_ns, tag_nl, bindings, declaration) -> {
          let ctor_src = if declaration == 0 { pipeline_lower_module_src(module) } else { module_decl_fact_source(declaration) }
          let ctor_ns = if declaration == 0 { tag_ns } else { module_decl_fact_name_ptr(declaration) - ctor_src }
          let subst = pipeline_match_variant_instance_subst(
            pipeline_lower_module_tt(module),
            ctor_src,
            ctor_ns,
            tag_nl,
            scrutinee_ty,
            pipeline_lower_module_subst(module)
          )
          if subst == 0 { direct } else { ty_subst(direct, subst) }
        }
        _ -> direct
      }
      UnknownArm(tag) -> direct
    }
  }
  else {
    match arm {
      Arm(pattern, body, guard, has_guard) -> {
        match body {
          Ident(ns, nl) -> pipeline_pattern_binding_type_node(
            pattern,
            scrutinee_ty,
            pipeline_lower_module_src(module),
            ns,
            nl,
            module
          )
          _ -> 0
        }
      }
      UnknownArm(tag) -> 0
    }
  }
}

pub(package) fn pipeline_match_arms_result_type_node_typed(arms: MatchArmList, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> i64 {
  match arms {
    MatchArmListNil -> 0
    MatchArmListCons(arm, rest) -> {
      let ty = pipeline_match_arm_result_type_node_typed(arm, params, locals, module)
      if ty == 0 { 0 }
      else {
        match rest {
          MatchArmListNil -> ty
          MatchArmListCons(next_arm, next_rest) -> {
            let rest_ty = pipeline_match_arms_result_type_node_typed(rest, params, locals, module)
            pipeline_control_result_type_join(ty, rest_ty)
          }
        }
      }
    }
  }
}

pub(package) fn pipeline_match_arms_result_type_node_with_scrutinee_typed(arms: MatchArmList, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, scrutinee_ty: i64) -> i64 {
  match arms {
    MatchArmListNil -> 0
    MatchArmListCons(arm, rest) -> {
      let ty = pipeline_match_arm_result_type_node_with_scrutinee_typed(arm, params, locals, module, scrutinee_ty)
      if ty == 0 { 0 }
      else {
        match rest {
          MatchArmListNil -> ty
          MatchArmListCons(next_arm, next_rest) -> {
            let rest_ty = pipeline_match_arms_result_type_node_with_scrutinee_typed(rest, params, locals, module, scrutinee_ty)
            pipeline_control_result_type_join(ty, rest_ty)
          }
        }
      }
    }
  }
}

pub(package) fn pipeline_return_expr_type_node_from_node(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> i64 {
  let stripped = pipeline_expr_node_strip_typed(expr)
  if stripped == 0 { 0 } else { pipeline_return_expr_type_node_typed(expr_from_node(stripped), params, locals, module) }
}

-- Binding-init type inference: like the return-expr inference plus a
-- payload-less-ctor fallback (let mut t = DNil is Ident-shaped). The
-- fallback is scoped to INIT positions on purpose — resolving ctor
-- Idents in general expression positions flips if-arm mixedness and
-- changes emission broadly.
pub(package) fn pipeline_init_type_node_typed(init_expr: Expr, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> i64 {
  let direct = pipeline_return_expr_type_node_typed(init_expr, params, locals, module)
  if direct != 0 { direct }
  else {
    match init_expr {
      Ident(ns, nl) -> pipeline_variant_parent_type_node(pipeline_lower_module_tt(module), pipeline_lower_module_src(module), ns, nl)
      _ -> 0
    }
  }
}

pub(package) fn pipeline_init_type_node_from_node(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> i64 {
  let stripped = pipeline_expr_node_strip_typed(expr)
  if stripped == 0 { 0 } else { pipeline_init_type_node_typed(expr_from_node(stripped), params, locals, module) }
}

pub(package) fn pipeline_lower_return_transfer_typed_with_ty(value_expr: Expr, value: i64, next_value: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, forced_ty: i64) -> IrLoweredExpr {
  let src = pipeline_lower_module_src(module)
  let fns = pipeline_lower_module_fns(module)
  let subst = pipeline_lower_module_subst(module)
  let inferred_ty = pipeline_return_expr_type_node_typed(value_expr, params, locals, module)
  let ty = if forced_ty != 0 { forced_ty } else { inferred_ty }
  let retain = if ty != 0 and ty_is_continuation(ty) == 0 and pipeline_expr_result_is_borrowed_for_ty_typed(value_expr, ty, src, fns, subst, pipeline_lower_module_tt(module)) == 1 {
    pipeline_managed_retain_inst_list_with_origin(value, ty, next_value, ir_managed_stake_origin_result_transfer())
  } else {
    ir_inst_list_empty()
  }
  let after_retain = next_value + ir_inst_list_len(retain)
  -- The local-release half exists only to balance the transfer retain
  -- above. A let whose final binding already transfers an owned count
  -- needs neither operation; releasing without a retain returns a
  -- zero-count payload to the caller.
  let release = if ir_inst_list_len(retain) > 0 and pipeline_expr_final_returns_non_param_ident_typed(value_expr, params, src) == 1 {
    pipeline_managed_release_inst_list_with_origin(value, ty, after_retain, ir_managed_stake_origin_result_transfer())
  } else {
    ir_inst_list_empty()
  }
  let after_release = after_retain + ir_inst_list_len(release)
  ir_lowered_expr(value, after_release, ir_inst_list_append(retain, release))
}

pub(package) fn pipeline_lower_return_transfer_typed(value_expr: Expr, value: i64, next_value: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> IrLoweredExpr {
  pipeline_lower_return_transfer_typed_with_ty(value_expr, value, next_value, params, locals, module, 0)
}

pub(package) fn pipeline_lower_return_transfer_from_node_with_fallback_ty(value_expr: i64, value: i64, next_value: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, fallback_ty: i64) -> IrLoweredExpr {
  let src = pipeline_lower_module_src(module)
  let fns = pipeline_lower_module_fns(module)
  let subst = pipeline_lower_module_subst(module)
  let inferred_ty = pipeline_return_expr_type_node_from_node(value_expr, params, locals, module)
  -- Expression inference may carry a more precise internal ownership class
  -- than the declared ABI type, so keep it when available. The declaration
  -- closes only genuine inference gaps, notably nested opaque destructures.
  let ty = if inferred_ty != 0 { inferred_ty } else { fallback_ty }
  let retain = if ty != 0 and ty_is_continuation(ty) == 0 and pipeline_expr_node_result_is_borrowed_for_ty_typed(value_expr, ty, src, fns, subst, pipeline_lower_module_tt(module)) == 1 {
    pipeline_managed_retain_inst_list_with_origin(value, ty, next_value, ir_managed_stake_origin_result_transfer())
  } else {
    ir_inst_list_empty()
  }
  let after_retain = next_value + ir_inst_list_len(retain)
  let release = if ir_inst_list_len(retain) > 0 and pipeline_expr_node_final_returns_non_param_ident(value_expr, params, src) == 1 {
    pipeline_managed_release_inst_list_with_origin(value, ty, after_retain, ir_managed_stake_origin_result_transfer())
  } else {
    ir_inst_list_empty()
  }
  let after_release = after_retain + ir_inst_list_len(release)
  ir_lowered_expr(value, after_release, ir_inst_list_append(retain, release))
}

pub(package) fn pipeline_lower_return_transfer_from_node(value_expr: i64, value: i64, next_value: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> IrLoweredExpr {
  pipeline_lower_return_transfer_from_node_with_fallback_ty(value_expr, value, next_value, params, locals, module, 0)
}

