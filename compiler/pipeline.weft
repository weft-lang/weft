    PipelineNativeEmitCtx(scope, handlers, pinned, f64_facts, fns, fp_env, vector_data_facts, adr_patches, old_pending_direct_dst) -> PipelineNativeEmitCtx(scope, handlers, pinned, f64_facts, fns, fp_env, vector_data_facts, adr_patches, pending_direct_dst)
  }
