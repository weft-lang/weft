pub(package) fn pipeline_ir_typed_direct_effect_match_arm_collect(arm: MatchArm, src: i64, callees: i64) -> i64 {
  match arm {
    Arm(pattern, body, guard, has_guard) -> {
      let guard_flags = if has_guard == 0 { 0 } else { pipeline_ir_typed_direct_effect_expr_collect(guard, src, callees) }
      pipeline_ir_effect_flags_merge(pipeline_ir_typed_direct_effect_expr_collect(body, src, callees), guard_flags)
    }
    UnknownArm(tag) -> 2
