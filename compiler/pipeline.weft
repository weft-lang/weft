    PipelineIrBlockEntryVectorSlotRowUpperFact(fact_block, fact_vec, row_width, slot_id, rest) -> pipeline_ir_block_entry_vector_upper_fact_lookup_chain(rest, block_id, vec_value, index_value)
    PipelineIrBlockEntryVectorRowUpperFact(fact_block, fact_vec, row_width, slot_id, rest) -> pipeline_ir_block_entry_vector_upper_fact_lookup_chain(rest, block_id, vec_value, index_value)
    PipelineIrBlockEntryVariantOriginFact(fact_block, fact_value, ctor_hash, payloads, rest) -> pipeline_ir_block_entry_vector_upper_fact_lookup_chain(rest, block_id, vec_value, index_value)
