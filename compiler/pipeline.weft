-- Static reclamation-class census ---------------------------------
--
-- The counter vector is a query value over final typed IR plus the native
-- allocation/reuse decisions:
--   0 counted residual, 1 stack/inline, 2 region, 3 arena,
--   4 reuse, 5 Unique, 6 owned, 7 frozen-region, 8 promotion boundaries.
-- Indices 0..7 are mutually exclusive allocation-site classes; index 8 is a
-- transition-site diagnostic and is intentionally outside the total.
pub(package) fn pipeline_rc_site_census_new() -> i64 { alloc_zeroed(72) }
pub(package) fn pipeline_rc_site_census_get(census: i64, index: i64) -> i64 {
  if census == 0 or index < 0 or index >= 9 { 0 } else { mem_load64_at(census, index * 8) }
}
pub(package) fn pipeline_rc_site_census_add(census: i64, index: i64, amount: i64) -> i64 {
  if census == 0 or index < 0 or index >= 9 or amount == 0 { 0 }
  else { mem_store64_at(census, index * 8, mem_load64_at(census, index * 8) + amount) 0 }
}
pub(package) fn pipeline_rc_site_census_total(census: i64) -> i64 {
  let mut total = 0
  for i in 0..8 { total = total + pipeline_rc_site_census_get(census, i) }
  total
}

-- Native calls that always produce a distinct default-managed allocation.
-- Keep this semantic root registry shared by the reclamation census and
-- provenance producers. Reuse is deliberately excluded because it may return
-- its input token.
pub(package) fn pipeline_ir_native_fresh_managed_alloc_hash(hash: i64) -> i64 {
  if hash == pipeline_ir_native_hash_name("rc_default_alloc") or
     hash == pipeline_ir_native_hash_name("rc_default_alloc_masked") or
     hash == pipeline_ir_native_hash_name("rc_default_alloc_described") or
     hash == pipeline_ir_native_hash_name("rc_default_alloc_finalized") { 1 }
  else { 0 }
}

pub(package) fn pipeline_ir_module_is_sdk_path(tt: i64, module_entry: i64, path: str) -> i64 {
  if module_entry == 0 { 0 }
  else {
    let package_id = module_fact_entry_package(module_entry)
    if package_id == 0 or pkg_identity_is_sdk(tt, package_id) == 1 {
      module_fact_path_eq(module_entry, __str_ptr(path), __str_len(path), package_id)
    } else { 0 }
  }
}

pub(package) fn pipeline_ir_traversal_role_code(role: PipelineIrTraversalRole) -> i64 {
  match role {
    PipelineIrTraversalNone -> 0
    PipelineIrTraversalRangeI64 -> 1
    PipelineIrTraversalMap -> 2
    PipelineIrTraversalFilter -> 3
    PipelineIrTraversalTake -> 4
    PipelineIrTraversalFold -> 5
    PipelineIrTraversalRangeMapFilterTakeFoldI64 -> 6
    PipelineIrTraversalFromGenerator -> 7
    PipelineIrTraversalCount -> 8
    PipelineIrTraversalFirst -> 9
    PipelineIrTraversalLast -> 10
    PipelineIrTraversalNth -> 11
    PipelineIrTraversalFind -> 12
    PipelineIrTraversalFindMap -> 13
    PipelineIrTraversalAny -> 14
    PipelineIrTraversalAll -> 15
    PipelineIrTraversalReduce -> 16
    PipelineIrTraversalEmpty -> 17
    PipelineIrTraversalOnce -> 18
    PipelineIrTraversalChain -> 19
    PipelineIrTraversalSkip -> 20
    PipelineIrTraversalTakeWhile -> 21
    PipelineIrTraversalSkipWhile -> 22
    PipelineIrTraversalEnumerate -> 23
    PipelineIrTraversalZip -> 24
    PipelineIrTraversalFilterMap -> 25
    PipelineIrTraversalEach -> 26
    PipelineIrTraversalFlatMap -> 27
    PipelineIrTraversalScan -> 28
    PipelineIrTraversalPosition -> 29
    PipelineIrTraversalMin -> 30
    PipelineIrTraversalMax -> 31
    PipelineIrTraversalFlatten -> 32
    PipelineIrTraversalPartition -> 33
    PipelineIrTraversalEachChunk -> 34
    PipelineIrTraversalEachWindow -> 35
  }
}

pub(package) fn pipeline_ir_traversal_role_from_code(code: i64) -> PipelineIrTraversalRole {
  match code {
    1 -> PipelineIrTraversalRangeI64
    2 -> PipelineIrTraversalMap
    3 -> PipelineIrTraversalFilter
    4 -> PipelineIrTraversalTake
    5 -> PipelineIrTraversalFold
    6 -> PipelineIrTraversalRangeMapFilterTakeFoldI64
    7 -> PipelineIrTraversalFromGenerator
    8 -> PipelineIrTraversalCount
    9 -> PipelineIrTraversalFirst
    10 -> PipelineIrTraversalLast
    11 -> PipelineIrTraversalNth
    12 -> PipelineIrTraversalFind
    13 -> PipelineIrTraversalFindMap
    14 -> PipelineIrTraversalAny
    15 -> PipelineIrTraversalAll
    16 -> PipelineIrTraversalReduce
    17 -> PipelineIrTraversalEmpty
    18 -> PipelineIrTraversalOnce
    19 -> PipelineIrTraversalChain
    20 -> PipelineIrTraversalSkip
    21 -> PipelineIrTraversalTakeWhile
    22 -> PipelineIrTraversalSkipWhile
    23 -> PipelineIrTraversalEnumerate
    24 -> PipelineIrTraversalZip
    25 -> PipelineIrTraversalFilterMap
    26 -> PipelineIrTraversalEach
    27 -> PipelineIrTraversalFlatMap
    28 -> PipelineIrTraversalScan
    29 -> PipelineIrTraversalPosition
    30 -> PipelineIrTraversalMin
    31 -> PipelineIrTraversalMax
    32 -> PipelineIrTraversalFlatten
    33 -> PipelineIrTraversalPartition
    34 -> PipelineIrTraversalEachChunk
    35 -> PipelineIrTraversalEachWindow
    _ -> PipelineIrTraversalNone
  }
}

pub(package) fn pipeline_ir_traversal_role_same(left: PipelineIrTraversalRole, right: PipelineIrTraversalRole) -> i64 {
  if pipeline_ir_traversal_role_code(left) == pipeline_ir_traversal_role_code(right) { 1 } else { 0 }
}

pub(package) fn pipeline_ir_traversal_cardinality(role: PipelineIrTraversalRole) -> PipelineIrTraversalCardinality {
  match role {
    PipelineIrTraversalNone -> PipelineIrTraversalCardinalityUnknown
    PipelineIrTraversalFromGenerator -> PipelineIrTraversalCardinalityUnknown
    PipelineIrTraversalRangeI64 -> PipelineIrTraversalCardinalityRangeArguments(0, 1)
    PipelineIrTraversalEmpty -> PipelineIrTraversalCardinalityExactZero
    PipelineIrTraversalOnce -> PipelineIrTraversalCardinalityExactOne
    PipelineIrTraversalMap -> PipelineIrTraversalCardinalityPreservesInput
    PipelineIrTraversalEnumerate -> PipelineIrTraversalCardinalityPreservesInput
    PipelineIrTraversalFilter -> PipelineIrTraversalCardinalityAtMostInput
    PipelineIrTraversalFilterMap -> PipelineIrTraversalCardinalityAtMostInput
    PipelineIrTraversalFlatMap -> PipelineIrTraversalCardinalityFlatMapInput
    PipelineIrTraversalFlatten -> PipelineIrTraversalCardinalityFlatMapInput
    PipelineIrTraversalTakeWhile -> PipelineIrTraversalCardinalityAtMostInput
    PipelineIrTraversalSkipWhile -> PipelineIrTraversalCardinalityAtMostInput
    PipelineIrTraversalTake -> PipelineIrTraversalCardinalityCapByArgument(1)
    PipelineIrTraversalSkip -> PipelineIrTraversalCardinalitySkipByArgument(1)
    PipelineIrTraversalChain -> PipelineIrTraversalCardinalitySumInputs
    PipelineIrTraversalZip -> PipelineIrTraversalCardinalityMinInputs
    PipelineIrTraversalScan -> PipelineIrTraversalCardinalityAtMostInput
    PipelineIrTraversalFold -> PipelineIrTraversalCardinalityNoIteratorResult
    PipelineIrTraversalCount -> PipelineIrTraversalCardinalityNoIteratorResult
    PipelineIrTraversalFirst -> PipelineIrTraversalCardinalityNoIteratorResult
    PipelineIrTraversalLast -> PipelineIrTraversalCardinalityNoIteratorResult
    PipelineIrTraversalNth -> PipelineIrTraversalCardinalityNoIteratorResult
    PipelineIrTraversalPosition -> PipelineIrTraversalCardinalityNoIteratorResult
    PipelineIrTraversalMin -> PipelineIrTraversalCardinalityNoIteratorResult
    PipelineIrTraversalMax -> PipelineIrTraversalCardinalityNoIteratorResult
    PipelineIrTraversalFind -> PipelineIrTraversalCardinalityNoIteratorResult
    PipelineIrTraversalFindMap -> PipelineIrTraversalCardinalityNoIteratorResult
    PipelineIrTraversalAny -> PipelineIrTraversalCardinalityNoIteratorResult
    PipelineIrTraversalAll -> PipelineIrTraversalCardinalityNoIteratorResult
    PipelineIrTraversalReduce -> PipelineIrTraversalCardinalityNoIteratorResult
    PipelineIrTraversalPartition -> PipelineIrTraversalCardinalityNoIteratorResult
    PipelineIrTraversalEachChunk -> PipelineIrTraversalCardinalityNoIteratorResult
    PipelineIrTraversalEachWindow -> PipelineIrTraversalCardinalityNoIteratorResult
    PipelineIrTraversalEach -> PipelineIrTraversalCardinalityNoIteratorResult
    PipelineIrTraversalRangeMapFilterTakeFoldI64 -> PipelineIrTraversalCardinalityNoIteratorResult
  }
}

pub(package) fn pipeline_ir_traversal_order(role: PipelineIrTraversalRole) -> PipelineIrTraversalOrder {
  match role {
    PipelineIrTraversalNone -> PipelineIrTraversalOrderUnknown
    PipelineIrTraversalFlatMap -> PipelineIrTraversalOrderNestedSource
    PipelineIrTraversalFlatten -> PipelineIrTraversalOrderNestedSource
    PipelineIrTraversalChain -> PipelineIrTraversalOrderLeftThenRight
    PipelineIrTraversalZip -> PipelineIrTraversalOrderPairByPosition
    PipelineIrTraversalPartition -> PipelineIrTraversalOrderStablePartition
    PipelineIrTraversalEachChunk -> PipelineIrTraversalOrderChunkedSource(1)
    PipelineIrTraversalEachWindow -> PipelineIrTraversalOrderWindowedSource(1)
    _ -> PipelineIrTraversalOrderSource
  }
}

pub(package) fn pipeline_ir_traversal_buffering(role: PipelineIrTraversalRole) -> PipelineIrTraversalBuffering {
  match role {
    PipelineIrTraversalPartition -> PipelineIrTraversalBufferingGrowingOutputs(2)
    PipelineIrTraversalEachChunk -> PipelineIrTraversalBufferingBoundedByArgument(1)
    PipelineIrTraversalEachWindow -> PipelineIrTraversalBufferingRollingWindow(1)
    _ -> PipelineIrTraversalBufferingUnknown
  }
}

pub(package) fn pipeline_ir_traversal_pull(role: PipelineIrTraversalRole) -> PipelineIrTraversalPull {
  match role {
    PipelineIrTraversalNone -> PipelineIrTraversalPullUnknown
    PipelineIrTraversalFlatMap -> PipelineIrTraversalPullLazyMayExpandInput
    PipelineIrTraversalFlatten -> PipelineIrTraversalPullLazyMayExpandInput
    PipelineIrTraversalTake -> PipelineIrTraversalPullLazyMayStopSource
    PipelineIrTraversalTakeWhile -> PipelineIrTraversalPullLazyMayStopSource
    PipelineIrTraversalFirst -> PipelineIrTraversalPullConsumerMayStopEarly
    PipelineIrTraversalNth -> PipelineIrTraversalPullConsumerMayStopEarly
    PipelineIrTraversalPosition -> PipelineIrTraversalPullConsumerMayStopEarly
    PipelineIrTraversalFind -> PipelineIrTraversalPullConsumerMayStopEarly
    PipelineIrTraversalFindMap -> PipelineIrTraversalPullConsumerMayStopEarly
    PipelineIrTraversalAny -> PipelineIrTraversalPullConsumerMayStopEarly
    PipelineIrTraversalAll -> PipelineIrTraversalPullConsumerMayStopEarly
    PipelineIrTraversalFold -> PipelineIrTraversalPullConsumerExhausts
    PipelineIrTraversalCount -> PipelineIrTraversalPullConsumerExhausts
    PipelineIrTraversalLast -> PipelineIrTraversalPullConsumerExhausts
    PipelineIrTraversalMin -> PipelineIrTraversalPullConsumerExhausts
    PipelineIrTraversalMax -> PipelineIrTraversalPullConsumerExhausts
    PipelineIrTraversalReduce -> PipelineIrTraversalPullConsumerExhausts
    PipelineIrTraversalPartition -> PipelineIrTraversalPullConsumerExhausts
    PipelineIrTraversalEachChunk -> PipelineIrTraversalPullConsumerExhausts
    PipelineIrTraversalEachWindow -> PipelineIrTraversalPullConsumerExhausts
    PipelineIrTraversalEach -> PipelineIrTraversalPullConsumerExhausts
    PipelineIrTraversalRangeMapFilterTakeFoldI64 -> PipelineIrTraversalPullConsumerMayStopEarly
    _ -> PipelineIrTraversalPullLazy
  }
}

pub(package) fn pipeline_ir_traversal_callback(role: PipelineIrTraversalRole) -> PipelineIrTraversalCallback {
  match role {
    PipelineIrTraversalMap -> PipelineIrTraversalCallbackPure(1)
    PipelineIrTraversalFilter -> PipelineIrTraversalCallbackPure(1)
    PipelineIrTraversalFilterMap -> PipelineIrTraversalCallbackPure(1)
    PipelineIrTraversalFlatMap -> PipelineIrTraversalCallbackPure(1)
    PipelineIrTraversalTakeWhile -> PipelineIrTraversalCallbackPure(1)
    PipelineIrTraversalSkipWhile -> PipelineIrTraversalCallbackPure(1)
    PipelineIrTraversalScan -> PipelineIrTraversalCallbackPure(2)
    PipelineIrTraversalFold -> PipelineIrTraversalCallbackPure(2)
    PipelineIrTraversalPosition -> PipelineIrTraversalCallbackPure(1)
    PipelineIrTraversalFind -> PipelineIrTraversalCallbackPure(1)
    PipelineIrTraversalFindMap -> PipelineIrTraversalCallbackPure(1)
    PipelineIrTraversalAny -> PipelineIrTraversalCallbackPure(1)
    PipelineIrTraversalAll -> PipelineIrTraversalCallbackPure(1)
    PipelineIrTraversalReduce -> PipelineIrTraversalCallbackPure(2)
    PipelineIrTraversalPartition -> PipelineIrTraversalCallbackPure(1)
    PipelineIrTraversalEachChunk -> PipelineIrTraversalCallbackEffectful(2)
    PipelineIrTraversalEachWindow -> PipelineIrTraversalCallbackEffectfulScopedView(2)
    PipelineIrTraversalEach -> PipelineIrTraversalCallbackEffectful(1)
    PipelineIrTraversalRangeMapFilterTakeFoldI64 -> PipelineIrTraversalCallbackPure3(2, 3, 6)
    _ -> PipelineIrTraversalCallbackNone
  }
}

-- Resolve the SDK iterator vocabulary once, at the declaration fact producer.
-- Downstream optimisation sees only the typed role carried by the semantic
-- fact; an unrelated package may use the same short names without acquiring
-- traversal semantics.
pub(package) fn pipeline_ir_iterator_traversal_role(pair: i64, name_hash: i64, tt: i64) -> PipelineIrTraversalRole {
  if pair == 0 { PipelineIrTraversalNone }
  else {
    let decl = node_tag(pair)
    match decl {
      0 -> PipelineIrTraversalNone
      candidate if typeck_decl_identity_is(candidate, "stdlib/iter/core", "from_generator") == 1 -> PipelineIrTraversalFromGenerator
      candidate if typeck_decl_identity_is(candidate, "stdlib/iter/core", "range") == 1 -> PipelineIrTraversalRangeI64
      candidate if typeck_decl_identity_is(candidate, "stdlib/iter/core", "empty") == 1 -> PipelineIrTraversalEmpty
      candidate if typeck_decl_identity_is(candidate, "stdlib/iter/core", "once") == 1 -> PipelineIrTraversalOnce
      candidate if typeck_decl_identity_is(candidate, "stdlib/iter/core", "map") == 1 -> PipelineIrTraversalMap
      candidate if typeck_decl_identity_is(candidate, "stdlib/iter/core", "filter") == 1 -> PipelineIrTraversalFilter
      candidate if typeck_decl_identity_is(candidate, "stdlib/iter/core", "filter_map") == 1 -> PipelineIrTraversalFilterMap
      candidate if typeck_decl_identity_is(candidate, "stdlib/iter/core", "flat_map") == 1 -> PipelineIrTraversalFlatMap
      candidate if typeck_decl_identity_is(candidate, "stdlib/iter/core", "flatten") == 1 -> PipelineIrTraversalFlatten
      candidate if typeck_decl_identity_is(candidate, "stdlib/iter/core", "take") == 1 -> PipelineIrTraversalTake
      candidate if typeck_decl_identity_is(candidate, "stdlib/iter/core", "chain") == 1 -> PipelineIrTraversalChain
      candidate if typeck_decl_identity_is(candidate, "stdlib/iter/core", "skip") == 1 -> PipelineIrTraversalSkip
      candidate if typeck_decl_identity_is(candidate, "stdlib/iter/core", "take_while") == 1 -> PipelineIrTraversalTakeWhile
      candidate if typeck_decl_identity_is(candidate, "stdlib/iter/core", "skip_while") == 1 -> PipelineIrTraversalSkipWhile
      candidate if typeck_decl_identity_is(candidate, "stdlib/iter/core", "enumerate") == 1 -> PipelineIrTraversalEnumerate
      candidate if typeck_decl_identity_is(candidate, "stdlib/iter/core", "zip") == 1 -> PipelineIrTraversalZip
      candidate if typeck_decl_identity_is(candidate, "stdlib/iter/core", "scan") == 1 -> PipelineIrTraversalScan
      candidate if typeck_decl_identity_is(candidate, "stdlib/iter/core", "fold") == 1 -> PipelineIrTraversalFold
      candidate if typeck_decl_identity_is(candidate, "stdlib/iter/core", "count") == 1 -> PipelineIrTraversalCount
      candidate if typeck_decl_identity_is(candidate, "stdlib/iter/core", "first") == 1 -> PipelineIrTraversalFirst
      candidate if typeck_decl_identity_is(candidate, "stdlib/iter/core", "last") == 1 -> PipelineIrTraversalLast
      candidate if typeck_decl_identity_is(candidate, "stdlib/iter/core", "nth") == 1 -> PipelineIrTraversalNth
      candidate if typeck_decl_identity_is(candidate, "stdlib/iter/core", "position") == 1 -> PipelineIrTraversalPosition
      candidate if typeck_decl_identity_is(candidate, "stdlib/iter/core", "min") == 1 -> PipelineIrTraversalMin
      candidate if typeck_decl_identity_is(candidate, "stdlib/iter/core", "max") == 1 -> PipelineIrTraversalMax
      candidate if typeck_decl_identity_is(candidate, "stdlib/iter/core", "find") == 1 -> PipelineIrTraversalFind
      candidate if typeck_decl_identity_is(candidate, "stdlib/iter/core", "find_map") == 1 -> PipelineIrTraversalFindMap
      candidate if typeck_decl_identity_is(candidate, "stdlib/iter/core", "any") == 1 -> PipelineIrTraversalAny
      candidate if typeck_decl_identity_is(candidate, "stdlib/iter/core", "all") == 1 -> PipelineIrTraversalAll
      candidate if typeck_decl_identity_is(candidate, "stdlib/iter/core", "reduce") == 1 -> PipelineIrTraversalReduce
      candidate if typeck_decl_identity_is(candidate, "stdlib/iter/materialize", "partition") == 1 -> PipelineIrTraversalPartition
      candidate if typeck_decl_identity_is(candidate, "stdlib/iter/materialize", "each_chunk") == 1 -> PipelineIrTraversalEachChunk
      candidate if typeck_decl_identity_is(candidate, "stdlib/iter/materialize", "each_window") == 1 -> PipelineIrTraversalEachWindow
      candidate if typeck_decl_identity_is(candidate, "stdlib/iter/core", "each") == 1 -> PipelineIrTraversalEach
      candidate if typeck_decl_identity_is(candidate, "stdlib/iter/core", "iter_range_map_filter_take_fold_i64") == 1 -> PipelineIrTraversalRangeMapFilterTakeFoldI64
      _ -> PipelineIrTraversalNone
    }
  }
}

-- Resolve the SDK dense-table vocabulary once, beside the traversal role
-- producer. This lets representation-sensitive passes follow exact methods
-- without granting semantics to unrelated `rows`, `get`, or `set` names.
pub(package) fn pipeline_ir_dense_table_role(pair: i64, name_hash: i64, tt: i64) -> i64 {
  if pair == 0 { cg_semantic_dense_table_role_none() }
  else {
    let decl = node_tag(pair)
    if decl == 0 { cg_semantic_dense_table_role_none() }
    else {
      let module_entry = module_decl_fact_module(decl)
      if pipeline_ir_module_is_sdk_path(tt, module_entry, "stdlib/f64_table.weft") != 1 {
        cg_semantic_dense_table_role_none()
      } else {
        if name_hash == pipeline_ir_native_hash_name("rows") { cg_semantic_dense_table_role_rows() }
        else { if name_hash == pipeline_ir_native_hash_name("get") { cg_semantic_dense_table_role_get() }
        else { if name_hash == pipeline_ir_native_hash_name("set") { cg_semantic_dense_table_role_set() }
        else { if name_hash == pipeline_ir_native_hash_name("f64_table_row_count") { cg_semantic_dense_table_role_storage_rows() }
        else { if name_hash == pipeline_ir_native_hash_name("f64_table_get") { cg_semantic_dense_table_role_storage_get() }
        else { if name_hash == pipeline_ir_native_hash_name("f64_table_set") { cg_semantic_dense_table_role_storage_set() }
        else { cg_semantic_dense_table_role_none() } } } } } }
      }
    }
  }
}

pub(package) fn pipeline_ir_native_fresh_managed_alloc_decl(pair: i64, name_hash: i64, tt: i64) -> i64 {
  if pair == 0 or pipeline_ir_native_fresh_managed_alloc_hash(name_hash) != 1 { 0 }
  else {
    let decl = node_tag(pair)
    if decl == 0 { 0 }
    else {
      let module_entry = module_decl_fact_module(decl)
      pipeline_ir_module_is_sdk_path(tt, module_entry, "runtime/rc.weft")
    }
  }
}

-- Exact storage-preserving native contracts live beside allocation roots.
-- `unsafe_transmute` changes only static identity; its single value parameter
-- is therefore the return provenance even though the Unsafe effect transport
-- is opaque to ordinary source-summary recursion.
pub(package) fn pipeline_ir_native_exact_alias_param_or(pair: i64, name_hash: i64, default: i64, tt: i64) -> i64 {
  if pair == 0 or name_hash != pipeline_ir_native_hash_name("unsafe_transmute") { default }
  else {
    let decl = node_tag(pair)
    if decl == 0 { default }
    else {
      let module_entry = module_decl_fact_module(decl)
      if pipeline_ir_module_is_sdk_path(tt, module_entry, "runtime/unsafe.weft") == 1 { 0 } else { default }
    }
  }
}

pub(package) fn pipeline_rc_site_call_class(hash: i64) -> i64 {
  if pipeline_ir_native_fresh_managed_alloc_hash(hash) == 1 { 0 }
  else { if hash == pipeline_ir_native_hash_name("rc_persistent_region_new") or
            hash == pipeline_ir_native_hash_name("rc_persistent_region_alloc") or
            hash == pipeline_ir_native_hash_name("rc_persistent_region_alloc_unlocked") { 2 }
  else { if hash == pipeline_ir_native_hash_name("alloc_bump") or
            hash == pipeline_ir_native_hash_name("alloc_zeroed") or
            hash == pipeline_ir_native_hash_name("alloc_words") or
            hash == pipeline_ir_native_intrinsic_bump_alloc_hash() { 3 }
  else { if hash == pipeline_ir_native_hash_name("rc_default_promote") or
            hash == pipeline_ir_native_hash_name("rc_default_promote_maybe") or
            hash == pipeline_ir_native_hash_name("closure_default_promote") { 8 }
  else { 0 - 1 } } } }
}

pub(package) fn pipeline_rc_site_census_call(census: i64, hash: i64) -> i64 {
  let class = pipeline_rc_site_call_class(hash)
  if class >= 0 { pipeline_rc_site_census_add(census, class, 1) } else { 0 }
}

pub(package) fn pipeline_rc_site_census_handler_clauses(clauses: IrHandlerClauseBodyList, census: i64) -> i64 {
  match clauses {
    IrHandlerClauseBodyNil -> 0
    IrHandlerClauseBodyCons(body, rest) -> {
      match body {
        IrHandlerClauseBody(op_hash, nparams, captures, has_continuation, is_abortive, result_cleanup_kind, transferred_param_value_fact, resume_lanes, result_lanes, first_value, blocks) -> pipeline_rc_site_census_blocks(blocks, census)
        IrHandlerClauseBodyInvalid(reason) -> 0
      }
      pipeline_rc_site_census_handler_clauses(rest, census)
    }
  }
}

pub(package) fn pipeline_rc_site_census_deferred_body(body: IrDeferredHandlerBody, census: i64) -> i64 {
  match body {
    IrDeferredHandlerBody(body_src, captures, ops_value, result_lanes, first_value, blocks, completion) -> {
      pipeline_rc_site_census_blocks(blocks, census)
      match completion {
        IrDeferredCompletionBodyNone -> 0
        IrDeferredCompletionBody(input_lanes, output_lanes, completion_first_value, completion_blocks) -> pipeline_rc_site_census_blocks(completion_blocks, census)
        IrDeferredCompletionBodyInvalid(reason) -> 0
      }
    }
    IrDeferredHandlerBodyInvalid(reason) -> 0
  }
}

pub(package) fn pipeline_rc_site_census_insts(insts: IrInstList, census: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      match inst {
        IrClosureI64(dst, f, captures, evidence) -> pipeline_rc_site_census_add(census, 0, 1)
        IrVariantInitI64(dst, tag_hash, payloads, field_mask) -> pipeline_rc_site_census_add(census, 0, 1)
        IrRecordInitI64(dst, type_hash, fields) -> pipeline_rc_site_census_add(census, 0, 1)
        IrRecordLayoutInitI64(dst, type_hash, data_size, align, fields) -> pipeline_rc_site_census_add(census, 0, 1)
        IrReuseInitI64(token, constructor) -> pipeline_rc_site_census_add(census, 0, 1)
        IrArrayStorageI64(dst, byte_size, align) -> pipeline_rc_site_census_add(census, 1, 1)
        IrCallI64(dst, callee_hash, args) -> pipeline_rc_site_census_call(census, callee_hash)
        IrGenericCallI64(dst, callee_hash, type_args, args) -> pipeline_rc_site_census_call(census, callee_hash)
        IrHandleI64(dst, handle_src, effect_hash, clauses, nclauses, reserved) -> pipeline_rc_site_census_handler_clauses(clauses, census)
        IrDeferredHandleI64(dst, handle_src, body, clauses, nclauses, effect_hash, scratch_base) -> {
          pipeline_rc_site_census_deferred_body(body, census)
          pipeline_rc_site_census_handler_clauses(clauses, census)
        }
        _ -> 0
      }
      pipeline_rc_site_census_insts(rest, census)
    }
  }
}

pub(package) fn pipeline_rc_site_census_blocks(blocks: IrBlockList, census: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block { IrBlock(id, params, insts, term) -> pipeline_rc_site_census_insts(insts, census) }
      pipeline_rc_site_census_blocks(rest, census)
    }
  }
}

pub(package) fn pipeline_rc_site_census_functions(functions: IrFunctionList, census: i64) -> i64 {
  match functions {
    IrFunctionNil -> 0
    IrFunctionCons(function, rest) -> {
      match function { IrFunction(hash, params, blocks, src) -> pipeline_rc_site_census_blocks(blocks, census) }
      pipeline_rc_site_census_functions(rest, census)
    }
    _ -> 0
  }
}

pub(package) fn pipeline_rc_reclamation_site_census(ir: IrModule, native: NativeModule) -> i64 {
  let census = pipeline_rc_site_census_new()
  pipeline_rc_site_census_functions(pipeline_ir_functions(ir), census)
  -- These native decisions reclassify residual IR sites. They are currently
  -- zero on the compiler corpus, but making the transfer explicit keeps the
  -- census honest when the first volume lever starts moving sites.
  let stack_moves = pipeline_native_alloc_elision_count(native)
  let reuse_moves = pipeline_native_managed_reuse_lowering_count(native)
  let counted = pipeline_rc_site_census_get(census, 0)
  let moved = if stack_moves + reuse_moves < counted { stack_moves + reuse_moves } else { counted }
  mem_store64_at(census, 0, counted - moved)
  pipeline_rc_site_census_add(census, 1, stack_moves)
  pipeline_rc_site_census_add(census, 4, reuse_moves)
  census
}

pub(package) fn pipeline_ir_semantic_fact_count_list(facts: PipelineIrSemanticFactList) -> i64 {
  match facts {
    PipelineIrSemanticFactNil -> 0
    PipelineIrSemanticFactNode(hash, fact, borrow, left, right) -> 1 + pipeline_ir_semantic_fact_count_list(left) + pipeline_ir_semantic_fact_count_list(right)
  }
}

pub(package) fn pipeline_ir_semantic_fact_count(ir: IrModule) -> i64 {
  pipeline_ir_semantic_fact_count_list(pipeline_ir_semantic_facts(ir))
}

pub(package) fn pipeline_ir_semantic_borrow_parameter_owner_count_list(facts: PipelineIrSemanticFactList, index: i64) -> i64 {
  match facts {
    PipelineIrSemanticFactNil -> 0
    PipelineIrSemanticFactNode(hash, fact, borrow, left, right) -> {
      ir_borrow_value_facts_count_parameter_owner(ir_borrow_facts_values(borrow), index) +
      pipeline_ir_semantic_borrow_parameter_owner_count_list(left, index) +
      pipeline_ir_semantic_borrow_parameter_owner_count_list(right, index)
    }
  }
}

pub(package) fn pipeline_ir_semantic_borrow_parameter_owner_count(ir: IrModule, index: i64) -> i64 {
  pipeline_ir_semantic_borrow_parameter_owner_count_list(pipeline_ir_semantic_facts(ir), index)
}

