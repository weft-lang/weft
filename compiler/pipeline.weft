      let guard_scan = if has_guard == 0 { pipeline_ir_effect_scan_flag(0) } else { pipeline_ir_typed_direct_effect_expr_scan(guard, src) }
      pipeline_ir_effect_scan_merge(pipeline_ir_typed_direct_effect_expr_scan(body, src), guard_scan)
    }
    UnknownArm(tag) -> pipeline_ir_effect_scan_flag(2)
