fn pipeline_record_field_nodes_subst_types(fields: i64, count: i64, subst: i64) -> i64 {
  if subst == 0 {
    fields
  } else {
    let out = nlist_new()
    for i in 0..count {
      let field = nlist_get(fields, i)
      nlist_add(out, node_new(node_tag(field), node_f1(field), node_f2(field), pipeline_expr_node_subst_types(node_f3(field), subst), node_f4(field)))
    }
