-- compiler/pipeline.weft -- Compiler pass boundaries
use "compiler/ir.weft"

-- Transitional compiler-as-data pass results. The payloads are still the
-- existing parser/checker/codegen handles while the public boundary moves
-- toward Ast -> TypedAst -> IrModule -> BinaryObject.
type AstModule {
  AstModule(i64, i64, i64)
}

type TypedModule {
  TypedModule(i64, i64, i64)
}

type IrModule {
  IrModule(i64, i64, IrFunctionList)
}

type BinaryObject {
  BinaryObject(i64)
}

type PipelineValueEnv {
  PipelineValueEnvNil,
  PipelineValueEnvCons(i64, i64, i64, i64, PipelineValueEnv)
}

type PipelineLoweredArgs {
  PipelineLoweredArgs(IrValueList, i64, IrInstList, i64)
}

type PipelineLoweredBlocks {
  PipelineLoweredBlocks(i64, i64, IrBlockList, i64, i64)
}

type PipelineLoweredCallBlocks {
  PipelineLoweredCallBlocks(IrValueList, i64, i64, IrBlockList, i64, i64)
}

type PipelineLoweredLoopBlocks {
  PipelineLoweredLoopBlocks(i64, i64, IrBlockList, i64, i64, i64)
}

type PipelineCallArgCtx {
  PipelineCallArgCtx(i64, i64, i64, PipelineValueEnv, i64, i64)
}

type PipelineLoopCtx {
  PipelineLoopCtx(i64, PipelineValueEnv, i64, i64, i64, i64)
}

fn pipeline_parse(grammar: WeftGrammar, src: i64, n: i64, tt: i64) -> i64 {
  grammar.parse(src, n, tt)
}

fn pipeline_check(fns: i64, src: i64, tt: i64) -> i64 {
  let ct = build_ctable(tt, src)
  ttable_set_ct(tt, ct)
  handle check_user_fns(fns, src, tt) {
    Conformance.conforms(th, trh) -> resume(ctable_conforms(ct, th, trh))
  }
}

fn pipeline_parse_module(grammar: WeftGrammar, src: i64, n: i64, tt: i64) -> AstModule {
  let fns = pipeline_parse(grammar, src, n, tt)
  AstModule(fns, src, tt)
}

fn pipeline_check_fns(fns: i64, src: i64, tt: i64) -> TypedModule {
  pipeline_check(fns, src, tt)
  TypedModule(fns, src, tt)
}

fn pipeline_check_module(ast: AstModule) -> TypedModule {
  match ast {
    AstModule(fns, src, tt) -> pipeline_check_fns(fns, src, tt)
  }
}

fn pipeline_ast_fns(ast: AstModule) -> i64 {
  match ast {
    AstModule(fns, src, tt) -> fns
  }
}

fn pipeline_typed_fns(typed: TypedModule) -> i64 {
  match typed {
    TypedModule(fns, src, tt) -> fns
  }
}

fn pipeline_ir_result(code: i64, fm: i64) -> IrModule {
  IrModule(code, fm, ir_function_list_empty())
}

fn pipeline_ir_result_with_functions(code: i64, fm: i64, functions: IrFunctionList) -> IrModule {
  IrModule(code, fm, functions)
}

fn pipeline_binary_object(o: i64) -> BinaryObject {
  BinaryObject(o)
}

fn pipeline_ir_code(ir: IrModule) -> i64 {
  match ir {
    IrModule(code, fm, functions) -> code
  }
}

fn pipeline_ir_fmap(ir: IrModule) -> i64 {
  match ir {
    IrModule(code, fm, functions) -> fm
  }
}

fn pipeline_ir_functions(ir: IrModule) -> IrFunctionList {
  match ir {
    IrModule(code, fm, functions) -> functions
  }
}

fn pipeline_ir_function_count(ir: IrModule) -> i64 {
  ir_function_list_len(pipeline_ir_functions(ir))
}

fn pipeline_ir_inst_count(ir: IrModule) -> i64 {
  ir_function_list_inst_count(pipeline_ir_functions(ir))
}

fn pipeline_fn_inner(fn_wrap: i64) -> i64 {
  if node_tag(fn_wrap) == 23 { node_f1(fn_wrap) } else { fn_wrap }
}

fn pipeline_param_index(params: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let n = nlist_len(params)
  let mut i = 0
  let mut result = 0 - 1
  while i < n {
    let p = nlist_get(params, i)
    if node_f2(p) == nl {
      if src_eq_at(src, ns, src + node_f1(p), 0, nl) == 1 {
        result = i
        i = n
      } else {
        i = i + 1
      }
    } else {
      i = i + 1
    }
  }
  result
}

fn pipeline_value_env_empty() -> PipelineValueEnv {
  PipelineValueEnvNil
}

fn pipeline_value_env_push(env: PipelineValueEnv, ns: i64, nl: i64, value: i64) -> PipelineValueEnv {
  PipelineValueEnvCons(ns, nl, value, 0, env)
}

fn pipeline_value_env_push_slot(env: PipelineValueEnv, ns: i64, nl: i64, slot: i64) -> PipelineValueEnv {
  PipelineValueEnvCons(ns, nl, slot, 1, env)
}

fn pipeline_value_env_lookup(env: PipelineValueEnv, src: i64, ns: i64, nl: i64) -> i64 {
  match env {
    PipelineValueEnvNil -> 0 - 1
    PipelineValueEnvCons(bind_ns, bind_nl, value, kind, rest) -> {
      if bind_nl == nl {
        if src_eq_at(src, ns, src + bind_ns, 0, nl) == 1 {
          value
        } else {
          pipeline_value_env_lookup(rest, src, ns, nl)
        }
      } else {
        pipeline_value_env_lookup(rest, src, ns, nl)
      }
    }
  }
}

fn pipeline_value_env_lookup_kind(env: PipelineValueEnv, src: i64, ns: i64, nl: i64) -> i64 {
  match env {
    PipelineValueEnvNil -> 0 - 1
    PipelineValueEnvCons(bind_ns, bind_nl, value, kind, rest) -> {
      if bind_nl == nl {
        if src_eq_at(src, ns, src + bind_ns, 0, nl) == 1 {
          kind
        } else {
          pipeline_value_env_lookup_kind(rest, src, ns, nl)
        }
      } else {
        pipeline_value_env_lookup_kind(rest, src, ns, nl)
      }
    }
  }
}

fn pipeline_lowered_args(values: IrValueList, next_value: i64, insts: IrInstList, valid: i64) -> PipelineLoweredArgs {
  PipelineLoweredArgs(values, next_value, insts, valid)
}

fn pipeline_lowered_args_invalid(next_value: i64) -> PipelineLoweredArgs {
  PipelineLoweredArgs(ir_value_list_empty(), next_value, ir_inst_list_empty(), 0)
}

fn pipeline_lowered_args_values(lowered: PipelineLoweredArgs) -> IrValueList {
  match lowered {
    PipelineLoweredArgs(values, next_value, insts, valid) -> values
  }
}

fn pipeline_lowered_args_next_value(lowered: PipelineLoweredArgs) -> i64 {
  match lowered {
    PipelineLoweredArgs(values, next_value, insts, valid) -> next_value
  }
}

fn pipeline_lowered_args_insts(lowered: PipelineLoweredArgs) -> IrInstList {
  match lowered {
    PipelineLoweredArgs(values, next_value, insts, valid) -> insts
  }
}

fn pipeline_lowered_args_is_valid(lowered: PipelineLoweredArgs) -> i64 {
  match lowered {
    PipelineLoweredArgs(values, next_value, insts, valid) -> valid
  }
}

fn pipeline_lowered_blocks(next_block: i64, next_value: i64, blocks: IrBlockList, valid: i64) -> PipelineLoweredBlocks {
  PipelineLoweredBlocks(next_block, next_value, blocks, valid, 1)
}

