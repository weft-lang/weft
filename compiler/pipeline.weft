fn pipeline_ir_function_count(ir: IrModule) -> i64 {
  ir_function_list_len(pipeline_ir_functions(ir))
}

fn pipeline_ir_inst_count(ir: IrModule) -> i64 {
  ir_function_list_inst_count(pipeline_ir_functions(ir))
}

fn pipeline_fn_inner(fn_wrap: i64) -> i64 {
  if node_tag(fn_wrap) == 23 { node_f1(fn_wrap) } else { fn_wrap }
}

fn pipeline_decl_node_is_function(node: i64) -> i64 {
  if node == 0 { 0 }
  else {
    if node_tag(node) == 8 { 1 }
    else { if node_tag(node) == 23 { pipeline_decl_node_is_function(node_f1(node)) } else { 0 } }
  }
}

fn pipeline_decl_node_is_test(node: i64) -> i64 {
  if node == 0 { 0 }
  else {
    if node_tag(node) == 50 { 1 }
    else { if node_tag(node) == 23 { pipeline_decl_node_is_test(node_f1(node)) } else { 0 } }
  }
}

fn pipeline_first_fn_body_node(fns: i64) -> i64 {
  if nlist_len(fns) == 0 { 0 }
  else {
    let pair = nlist_get(fns, 0)
    let inner = pipeline_fn_inner(node_f1(pair))
    node_f4(inner)
  }
}

fn pipeline_first_decl_node(fns: i64) -> i64 {
  if nlist_len(fns) == 0 { 0 }
  else {
    let pair = nlist_get(fns, 0)
    node_f1(pair)
  }
}

fn pipeline_ast_first_decl(ast: AstModule) -> Decl {
  match ast {
    AstModule(fns, src, tt) -> decl_from_node(pipeline_first_decl_node(fns))
  }
}

fn pipeline_typed_first_decl(typed: TypedModule) -> Decl {
  match typed {
    TypedModule(fns, src, tt) -> decl_from_node(pipeline_first_decl_node(fns))
  }
}

fn pipeline_ast_decls(ast: AstModule) -> DeclList {
  match ast {
    AstModule(fns, src, tt) -> decl_list_from_fn_pairs(fns, 0)
  }
}

fn pipeline_typed_decls(typed: TypedModule) -> DeclList {
  match typed {
    TypedModule(fns, src, tt) -> decl_list_from_fn_pairs(fns, 0)
  }
}

fn pipeline_ast_type_entries(ast: AstModule) -> TypeEntryList {
  match ast {
    AstModule(fns, src, tt) -> type_entries_from_table(tt)
  }
}

fn pipeline_typed_type_entries(typed: TypedModule) -> TypeEntryList {
  match typed {
    TypedModule(fns, src, tt) -> type_entries_from_table(tt)
  }
}

fn pipeline_ast_migration_metrics_from(decls: DeclList, entries: TypeEntryList) -> AstMigrationMetrics {
  let unknowns = decl_list_tree_unknown_count(decls) + type_entry_list_tree_unknown_count(entries)
  let raw_slots = decl_list_tree_raw_bridge_slot_count(decls) + type_entry_list_tree_raw_bridge_slot_count(entries)
  let ready = if unknowns == 0 and raw_slots == 0 { 1 } else { 0 }
  AstMigrationMetrics(decl_list_len(decls), type_entry_list_len(entries), unknowns, raw_slots, ready)
}

fn pipeline_ast_migration_metrics(ast: AstModule) -> AstMigrationMetrics {
  pipeline_ast_migration_metrics_from(pipeline_ast_decls(ast), pipeline_ast_type_entries(ast))
}

fn pipeline_typed_ast_migration_metrics(typed: TypedModule) -> AstMigrationMetrics {
  pipeline_ast_migration_metrics_from(pipeline_typed_decls(typed), pipeline_typed_type_entries(typed))
}

fn pipeline_ast_migration_decl_count(metrics: AstMigrationMetrics) -> i64 {
  match metrics {
    AstMigrationMetrics(decls, type_entries, unknowns, raw_slots, ready) -> decls
  }
}

fn pipeline_ast_migration_type_entry_count(metrics: AstMigrationMetrics) -> i64 {
  match metrics {
