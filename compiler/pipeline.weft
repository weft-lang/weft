fn pipeline_binary_object(o: i64) -> BinaryObject {
  BinaryObject(o, pipeline_binary_kind_unknown())
}

fn pipeline_binary_object_with_kind(o: i64, kind: i64) -> BinaryObject {
  BinaryObject(o, kind)
}

fn pipeline_binary_kind_unknown() -> i64 { 0 }
fn pipeline_binary_kind_macho_executable() -> i64 { binary_format_kind(binary_format_macho_executable()) }
fn pipeline_binary_kind_macho_object() -> i64 { binary_format_kind(binary_format_macho_object()) }
fn pipeline_binary_kind_elf_executable() -> i64 { binary_format_kind(binary_format_elf_executable()) }
fn pipeline_binary_kind_elf_object() -> i64 { binary_format_kind(binary_format_elf_object()) }

fn pipeline_binary_kind(binary: BinaryObject) -> i64 {
  match binary {
    BinaryObject(o, kind) -> kind
  }
}

fn pipeline_native_code(native: NativeModule) -> i64 {
