}

fn pipeline_optimised_insts_killed_slots(opt: PipelineOptimisedInsts) -> PipelineIrKilledSlotEnv {
  pipeline_ir_local_fact_env_killed_slots(pipeline_optimised_insts_local_facts(opt))
}

