pub(package) fn pipeline_fn_inner(fn_wrap: i64) -> i64 {
  if node_tag(fn_wrap) == 23 { node_f1(fn_wrap) } else { fn_wrap }
}

pub(package) fn pipeline_decl_node_is_function(node: i64) -> i64 {
  if node == 0 { 0 }
  else {
    if node_tag(node) == 8 { 1 }
    else { if node_tag(node) == 23 { pipeline_decl_node_is_function(node_f1(node)) } else { 0 } }
  }
}

pub(package) fn pipeline_decl_node_is_test(node: i64) -> i64 {
  if node == 0 { 0 }
  else {
    if node_tag(node) == 50 { 1 }
    else { if node_tag(node) == 23 { pipeline_decl_node_is_test(node_f1(node)) } else { 0 } }
  }
}

pub(package) fn pipeline_first_fn_body_node(fns: i64) -> i64 {
  if nlist_len(fns) == 0 { 0 }
  else {
    let pair = nlist_get(fns, 0)
    let inner = pipeline_fn_inner(node_f1(pair))
    node_f4(inner)
  }
}

pub(package) fn pipeline_first_fn_body_node_for_source(fns: i64, source: i64) -> i64 {
  let nfns = nlist_len(fns)
  for i in 0..nfns {
    let pair = nlist_get(fns, i)
    let fn_wrap = node_f1(pair)
    if node_f2(pair) == source and pipeline_decl_node_is_function(fn_wrap) == 1 {
      return node_f4(pipeline_fn_inner(fn_wrap))
    } else { 0 }
  }
  0
}

pub(package) fn pipeline_first_decl_node(fns: i64) -> i64 {
  if nlist_len(fns) == 0 { 0 }
  else {
    let pair = nlist_get(fns, 0)
    node_f1(pair)
  }
}

