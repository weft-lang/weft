pub(package) fn pipeline_ir_block_fact_bool_result(eq_truth: i64, invert: i64) -> PipelineIrConstLookup {
  let value = if invert == 1 {
    if eq_truth == 1 { 0 } else { 1 }
  } else {
    eq_truth
  }
  pipeline_ir_const_lookup(1, value)
}

pub(package) fn pipeline_ir_block_fact_bool_const_compare(block_id: i64, block_facts: PipelineIrBlockEntryFactChain, value_id: i64, const_value: i64, invert: i64) -> PipelineIrConstLookup {
  let known = pipeline_ir_block_entry_bool_fact_lookup_chain(block_facts, block_id, value_id)
  if pipeline_ir_const_lookup_valid(known) == 1 {
    let eq_truth = if pipeline_ir_const_lookup_value(known) == const_value { 1 } else { 0 }
    pipeline_ir_block_fact_bool_result(eq_truth, invert)
  } else {
    pipeline_ir_const_lookup(0, 0)
  }
}

pub(package) fn pipeline_ir_block_fact_zero_const_compare(block_id: i64, block_facts: PipelineIrBlockEntryFactChain, value_id: i64, const_value: i64, invert: i64) -> PipelineIrConstLookup {
  let known = pipeline_ir_block_entry_zero_fact_lookup_chain(block_facts, block_id, value_id)
  if pipeline_ir_const_lookup_valid(known) == 1 {
    let is_zero = pipeline_ir_const_lookup_value(known)
    if const_value == 0 {
      pipeline_ir_block_fact_bool_result(is_zero, invert)
    } else {
      if is_zero == 1 {
        pipeline_ir_block_fact_bool_result(0, invert)
      } else {
        pipeline_ir_const_lookup(0, 0)
      }
    }
  } else {
    pipeline_ir_const_lookup(0, 0)
  }
}

pub(package) fn pipeline_ir_block_fact_nil_compare_value(block_id: i64, block_facts: PipelineIrBlockEntryFactChain, value_id: i64, invert: i64) -> PipelineIrConstLookup {
  let known = pipeline_ir_block_entry_nil_fact_lookup_chain(block_facts, block_id, value_id)
  if pipeline_ir_const_lookup_valid(known) == 1 {
    pipeline_ir_block_fact_bool_result(pipeline_ir_const_lookup_value(known), invert)
  } else {
    pipeline_ir_const_lookup(0, 0)
  }
}

pub(package) fn pipeline_ir_block_fact_nil_compare(block_id: i64, block_facts: PipelineIrBlockEntryFactChain, nil_env: PipelineIrNilEnv, lhs: i64, rhs: i64, invert: i64) -> PipelineIrConstLookup {
  if pipeline_ir_nil_env_contains(nil_env, rhs) == 1 {
    pipeline_ir_block_fact_nil_compare_value(block_id, block_facts, lhs, invert)
  } else {
    if pipeline_ir_nil_env_contains(nil_env, lhs) == 1 {
      pipeline_ir_block_fact_nil_compare_value(block_id, block_facts, rhs, invert)
    } else {
      pipeline_ir_const_lookup(0, 0)
    }
  }
}

pub(package) fn pipeline_ir_block_fact_tag_const_compare(block_id: i64, block_facts: PipelineIrBlockEntryFactChain, tag_env: PipelineIrTagEnv, tag_value: i64, ctor_hash: i64, invert: i64) -> PipelineIrConstLookup {
  let base = pipeline_ir_tag_env_lookup(tag_env, tag_value)
  if pipeline_ir_const_lookup_valid(base) == 1 {
    let base_value = pipeline_ir_const_lookup_value(base)
    let known = pipeline_ir_block_entry_ctor_fact_lookup_chain(block_facts, block_id, base_value)
    if pipeline_ir_const_lookup_valid(known) == 1 {
      let eq_truth = if pipeline_ir_const_lookup_value(known) == ctor_hash { 1 } else { 0 }
      pipeline_ir_block_fact_bool_result(eq_truth, invert)
    } else {
      if pipeline_ir_block_entry_not_ctor_fact_lookup_chain(block_facts, block_id, base_value, ctor_hash) == 1 {
        pipeline_ir_block_fact_bool_result(0, invert)
      } else {
        pipeline_ir_const_lookup(0, 0)
      }
    }
  } else {
    pipeline_ir_const_lookup(0, 0)
  }
}

pub(package) fn pipeline_ir_block_fact_binary_const(block_id: i64, block_facts: PipelineIrBlockEntryFactChain, local_facts: PipelineIrLocalFactEnv, op: IrBinaryOp, lhs: i64, rhs: i64, left: PipelineIrConstLookup, right: PipelineIrConstLookup) -> PipelineIrConstLookup {
  let tag_env = pipeline_ir_local_fact_env_tag_env(local_facts)
  let nil_env = pipeline_ir_local_fact_env_nil_env(local_facts)
  match op {
    IrEq -> {
      let nil_fold = pipeline_ir_block_fact_nil_compare(block_id, block_facts, nil_env, lhs, rhs, 0)
      if pipeline_ir_const_lookup_valid(nil_fold) == 1 {
        nil_fold
      } else {
        if pipeline_ir_const_lookup_valid(right) == 1 {
        let bool_fold = pipeline_ir_block_fact_bool_const_compare(block_id, block_facts, lhs, pipeline_ir_const_lookup_value(right), 0)
        if pipeline_ir_const_lookup_valid(bool_fold) == 1 {
          bool_fold
        } else {
          let zero_fold = pipeline_ir_block_fact_zero_const_compare(block_id, block_facts, lhs, pipeline_ir_const_lookup_value(right), 0)
          if pipeline_ir_const_lookup_valid(zero_fold) == 1 {
            zero_fold
          } else {
            pipeline_ir_block_fact_tag_const_compare(block_id, block_facts, tag_env, lhs, pipeline_ir_const_lookup_value(right), 0)
          }
        }
      } else {
        if pipeline_ir_const_lookup_valid(left) == 1 {
          let bool_fold = pipeline_ir_block_fact_bool_const_compare(block_id, block_facts, rhs, pipeline_ir_const_lookup_value(left), 0)
          if pipeline_ir_const_lookup_valid(bool_fold) == 1 {
            bool_fold
          } else {
            let zero_fold = pipeline_ir_block_fact_zero_const_compare(block_id, block_facts, rhs, pipeline_ir_const_lookup_value(left), 0)
            if pipeline_ir_const_lookup_valid(zero_fold) == 1 {
              zero_fold
            } else {
              pipeline_ir_block_fact_tag_const_compare(block_id, block_facts, tag_env, rhs, pipeline_ir_const_lookup_value(left), 0)
            }
          }
        } else {
          pipeline_ir_const_lookup(0, 0)
        }
      }
      }
    }
    IrNe -> {
      let nil_fold = pipeline_ir_block_fact_nil_compare(block_id, block_facts, nil_env, lhs, rhs, 1)
      if pipeline_ir_const_lookup_valid(nil_fold) == 1 {
        nil_fold
      } else {
        if pipeline_ir_const_lookup_valid(right) == 1 {
        let bool_fold = pipeline_ir_block_fact_bool_const_compare(block_id, block_facts, lhs, pipeline_ir_const_lookup_value(right), 1)
        if pipeline_ir_const_lookup_valid(bool_fold) == 1 {
          bool_fold
        } else {
          let zero_fold = pipeline_ir_block_fact_zero_const_compare(block_id, block_facts, lhs, pipeline_ir_const_lookup_value(right), 1)
          if pipeline_ir_const_lookup_valid(zero_fold) == 1 {
            zero_fold
          } else {
            pipeline_ir_block_fact_tag_const_compare(block_id, block_facts, tag_env, lhs, pipeline_ir_const_lookup_value(right), 1)
          }
        }
      } else {
        if pipeline_ir_const_lookup_valid(left) == 1 {
          let bool_fold = pipeline_ir_block_fact_bool_const_compare(block_id, block_facts, rhs, pipeline_ir_const_lookup_value(left), 1)
          if pipeline_ir_const_lookup_valid(bool_fold) == 1 {
            bool_fold
          } else {
            let zero_fold = pipeline_ir_block_fact_zero_const_compare(block_id, block_facts, rhs, pipeline_ir_const_lookup_value(left), 1)
            if pipeline_ir_const_lookup_valid(zero_fold) == 1 {
              zero_fold
            } else {
              pipeline_ir_block_fact_tag_const_compare(block_id, block_facts, tag_env, rhs, pipeline_ir_const_lookup_value(left), 1)
            }
          }
        } else {
          pipeline_ir_const_lookup(0, 0)
        }
      }
      }
    }
    _ -> pipeline_ir_const_lookup(0, 0)
  }
}

-- The alias env is PER BLOCK (each block folds from a fresh env), but a
-- value's uses may live in other blocks: splitting passes spread
-- straight-line code across block boundaries and the IR permits direct
-- cross-block value references. Dropping the definition here therefore
-- leaves later blocks using an undefined value. Materialise the copy as
-- dst = src | src (single inst, no extra operand) and record the alias:
-- same-block uses still canonicalise, cross-block uses keep a live
-- definition, and the liveness-driven DCE removes the copy when every
-- use was rewritten.
pub(package) fn pipeline_optimise_ir_copy_result(dst: i64, source: i64, env: PipelineIrConstEnv, aliases: PipelineIrAliasEnv, local_facts: PipelineIrLocalFactEnv, next_value: i64) -> PipelineOptimisedInsts {
  let nil_env = pipeline_ir_local_fact_env_nil_env(local_facts)
  let canonical = pipeline_ir_alias_env_lookup_or(aliases, source)
  let next_aliases = pipeline_ir_alias_env_bind(aliases, dst, canonical)
  let source_const = pipeline_ir_const_env_lookup(env, canonical)
  let next_env = if pipeline_ir_const_lookup_valid(source_const) == 1 {
    pipeline_ir_const_env_bind(env, dst, pipeline_ir_const_lookup_value(source_const))
  } else {
    env
  }
  let next_nil_env = if pipeline_ir_nil_env_contains(nil_env, canonical) == 1 {
    pipeline_ir_nil_env_bind(nil_env, dst)
  } else {
    nil_env
  }
  let copy_inst = ir_inst_binary_i64(dst, ir_binary_op_from_parser(15), canonical, canonical)
  pipeline_optimised_insts(ir_inst_list_prepend(copy_inst, ir_inst_list_empty()), next_env, next_aliases, pipeline_ir_local_fact_env_with_nil_env(local_facts, next_nil_env), next_value, 0, 1, 0)
}

pub(package) fn pipeline_optimise_ir_block_fact_copy_result(dst: i64, source: i64, env: PipelineIrConstEnv, aliases: PipelineIrAliasEnv, local_facts: PipelineIrLocalFactEnv, next_value: i64) -> PipelineOptimisedInsts {
  let nil_env = pipeline_ir_local_fact_env_nil_env(local_facts)
  let canonical = pipeline_ir_alias_env_lookup_or(aliases, source)
  let next_aliases = pipeline_ir_alias_env_bind(aliases, dst, canonical)
  let source_const = pipeline_ir_const_env_lookup(env, canonical)
  let next_env = if pipeline_ir_const_lookup_valid(source_const) == 1 {
    pipeline_ir_const_env_bind(env, dst, pipeline_ir_const_lookup_value(source_const))
  } else {
    env
  }
  let next_nil_env = if pipeline_ir_nil_env_contains(nil_env, canonical) == 1 {
    pipeline_ir_nil_env_bind(nil_env, dst)
  } else {
    nil_env
  }
  -- Materialised for the same cross-block reason as
  -- pipeline_optimise_ir_copy_result above.
  let copy_inst = ir_inst_binary_i64(dst, ir_binary_op_from_parser(15), canonical, canonical)
  pipeline_optimised_insts(ir_inst_list_prepend(copy_inst, ir_inst_list_empty()), next_env, next_aliases, pipeline_ir_local_fact_env_with_nil_env(local_facts, next_nil_env), next_value, 0, 0, 1)
}

pub(package) fn pipeline_optimise_ir_rewrite_result(dst: i64, rewrite: PipelineIrRewrite, env: PipelineIrConstEnv, aliases: PipelineIrAliasEnv, local_facts: PipelineIrLocalFactEnv, next_value: i64) -> PipelineOptimisedInsts {
  match rewrite {
    PipelineIrRewriteUnchanged -> pipeline_optimised_insts(ir_inst_list_empty(), env, aliases, local_facts, next_value, 0, 0, 0)
    PipelineIrRewriteConst(value) -> {
      let folded_inst = ir_inst_const_i64(dst, value)
      let next_env = pipeline_ir_const_env_bind(env, dst, value)
      pipeline_optimised_insts(ir_inst_list_prepend(folded_inst, ir_inst_list_empty()), next_env, aliases, local_facts, next_value, 0, 1, 0)
    }
    PipelineIrRewriteCopy(source) -> pipeline_optimise_ir_copy_result(dst, source, env, aliases, local_facts, next_value)
    PipelineIrRewriteInsts(insts, rewrite_next) -> {
      let next_env = pipeline_ir_const_env_from_inst_list(insts, env)
      pipeline_optimised_insts(insts, next_env, aliases, local_facts, rewrite_next, 0, 1, 0)
    }
  }
}

pub(package) fn pipeline_ir_inline_simplify_inst(inst: IrInst, env: PipelineIrConstEnv, facts: PipelineIrSemanticFactList, next_value: i64) -> PipelineOptimisedInsts {
  match inst {
    IrConstI64(dst, value) -> {
      let next_env = pipeline_ir_const_env_bind(env, dst, value)
      pipeline_optimised_insts(ir_inst_list_prepend(inst, ir_inst_list_empty()), next_env, pipeline_ir_alias_env_empty(), pipeline_ir_local_fact_env_empty(), next_value, 0, 0, 0)
    }
    IrNilI64(dst) -> {
      let next_env = pipeline_ir_const_env_bind(env, dst, 0)
      pipeline_optimised_insts(ir_inst_list_prepend(inst, ir_inst_list_empty()), next_env, pipeline_ir_alias_env_empty(), pipeline_ir_local_fact_env_empty(), next_value, 0, 0, 0)
    }
    IrCallI64(dst, callee_hash, args) -> {
      let rewrite = pipeline_ir_f64_table_rewrite_call(dst, callee_hash, args, facts, next_value)
      match rewrite {
        PipelineIrRewriteInsts(insts, rewrite_next) -> {
          let next_env = pipeline_ir_const_env_from_inst_list(insts, env)
          pipeline_optimised_insts(insts, next_env, pipeline_ir_alias_env_empty(), pipeline_ir_local_fact_env_empty(), rewrite_next, 0, 1, 0)
        }
        _ -> pipeline_optimised_insts(ir_inst_list_prepend(inst, ir_inst_list_empty()), env, pipeline_ir_alias_env_empty(), pipeline_ir_local_fact_env_empty(), next_value, 0, 0, 0)
      }
    }
    _ -> pipeline_optimised_insts(ir_inst_list_prepend(inst, ir_inst_list_empty()), env, pipeline_ir_alias_env_empty(), pipeline_ir_local_fact_env_empty(), next_value, 0, 0, 0)
  }
}

pub(package) fn pipeline_ir_inline_simplify_inst_list(insts: IrInstList, env: PipelineIrConstEnv, facts: PipelineIrSemanticFactList, next_value: i64) -> PipelineOptimisedInsts {
  match insts {
    IrInstNil -> pipeline_optimised_insts(ir_inst_list_empty(), env, pipeline_ir_alias_env_empty(), pipeline_ir_local_fact_env_empty(), next_value, 0, 0, 0)
    IrInstCons(inst, rest) -> {
      let head = pipeline_ir_inline_simplify_inst(inst, env, facts, next_value)
      let tail = pipeline_ir_inline_simplify_inst_list(rest, pipeline_optimised_insts_env(head), facts, pipeline_optimised_insts_next_value(head))
      pipeline_optimised_insts(
        ir_inst_list_append(pipeline_optimised_insts_insts(head), pipeline_optimised_insts_insts(tail)),
        pipeline_optimised_insts_env(tail),
        pipeline_ir_alias_env_empty(),
        pipeline_ir_local_fact_env_empty(),
        pipeline_optimised_insts_next_value(tail),
        pipeline_optimised_insts_const_fold_sites(head) + pipeline_optimised_insts_const_fold_sites(tail),
        pipeline_optimised_insts_algebraic_fold_sites(head) + pipeline_optimised_insts_algebraic_fold_sites(tail),
        0
      )
    }
  }
}

pub(package) fn pipeline_ir_inst_list_has_ptr_store(insts: IrInstList) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      match inst {
        IrPtrStoreI64(dst, ptr, value) -> 1
        -- Bridge-shaped inline bodies keep raw stores as pseudo-bridge
        -- CALLS, so any embedded call is conservatively len-mutating.
        IrCallI64(dst, callee_hash, args) -> 1
        IrManagedStakeI64(dst, value, cleanup_kind, delta, origin) -> 1
        _ -> pipeline_ir_inst_list_has_ptr_store(rest)
      }
    }
  }
}

pub(package) fn pipeline_ir_inline_materialize_result(dst: i64, result_value: i64, inline_insts: IrInstList, env: PipelineIrConstEnv, aliases: PipelineIrAliasEnv, local_facts: PipelineIrLocalFactEnv, facts: PipelineIrSemanticFactList, next_value: i64) -> PipelineOptimisedInsts {
  let simplified = pipeline_ir_inline_simplify_inst_list(inline_insts, env, facts, next_value)
  let simplified_insts = pipeline_optimised_insts_insts(simplified)
  let simplified_env = pipeline_optimised_insts_env(simplified)
  let simplified_next = pipeline_optimised_insts_next_value(simplified)
  -- Inlined bodies bypass the per-inst walker, so a raw store inside
  -- one must kill length facts here just as the IrPtrStoreI64 arm would.
  let base_facts = if pipeline_ir_inst_list_has_ptr_store(inline_insts) == 1 {
    pipeline_ir_local_fact_env_kill_len_facts(local_facts)
  } else {
    local_facts
  }
  let inline_facts = pipeline_ir_local_fact_env_with_call_cse(base_facts, pipeline_ir_call_cse_env_empty())
  if dst == result_value {
    pipeline_optimised_insts_direct(simplified_insts, simplified_env, aliases, inline_facts, simplified_next, 1)
  } else {
    let result_const = pipeline_ir_const_env_lookup(simplified_env, result_value)
    if pipeline_ir_const_lookup_valid(result_const) == 1 {
      let materialized = ir_inst_list_append(
        simplified_insts,
        ir_inst_list_prepend(ir_inst_const_i64(dst, pipeline_ir_const_lookup_value(result_const)), ir_inst_list_empty())
      )
      let next_env = pipeline_ir_const_env_bind(simplified_env, dst, pipeline_ir_const_lookup_value(result_const))
      pipeline_optimised_insts_direct(materialized, next_env, aliases, inline_facts, simplified_next, 1)
    } else {
      let zero_value = pipeline_ir_max_i64(simplified_next, dst + 1)
      let copy_insts = ir_inst_list_prepend(
        ir_inst_const_i64(zero_value, 0),
        ir_inst_list_prepend(ir_inst_binary_i64(dst, ir_binary_op_add(), result_value, zero_value), ir_inst_list_empty())
      )
      let materialized = ir_inst_list_append(simplified_insts, copy_insts)
      let next_env = pipeline_ir_const_env_bind(simplified_env, zero_value, 0)
      pipeline_optimised_insts_direct(materialized, next_env, aliases, inline_facts, zero_value + 1, 1)
    }
  }
}

pub(package) fn pipeline_ir_inline_value_env_bind(env: PipelineIrInlineValueEnv, from_value: i64, to_value: i64) -> PipelineIrInlineValueEnv {
  PipelineIrInlineValueEnvCons(from_value, to_value, env)
}

pub(package) fn pipeline_ir_inline_value_env_lookup_or(env: PipelineIrInlineValueEnv, from_value: i64, default: i64) -> i64 {
  match env {
    PipelineIrInlineValueEnvNil -> default
    PipelineIrInlineValueEnvCons(entry_from, entry_to, rest) -> {
      if entry_from == from_value { entry_to }
      else { pipeline_ir_inline_value_env_lookup_or(rest, from_value, default) }
    }
  }
}

pub(package) fn pipeline_ir_rewrite_inline_value_list(values: IrValueList, env: PipelineIrInlineValueEnv) -> IrValueList {
  match values {
    IrValueNil -> ir_value_list_empty()
    IrValueCons(value, rest) -> {
      ir_value_list_prepend(pipeline_ir_inline_value_env_lookup_or(env, value, value), pipeline_ir_rewrite_inline_value_list(rest, env))
    }
  }
}

pub(package) fn pipeline_ir_inline_arg_env(args: IrValueList, index: i64, env: PipelineIrInlineValueEnv) -> PipelineIrInlineValueEnv {
  match args {
    IrValueNil -> env
    IrValueCons(value, rest) -> pipeline_ir_inline_arg_env(rest, index + 1, pipeline_ir_inline_value_env_bind(env, index, value))
  }
}

pub(package) fn pipeline_ir_raw_memory_inline_call_hash(callee_hash: i64) -> i64 {
  if callee_hash == pipeline_ir_native_intrinsic_mem_load64_hash() { 1 }
  else { if callee_hash == pipeline_ir_native_intrinsic_mem_store64_hash() { 1 }
  else { if callee_hash == pipeline_ir_native_intrinsic_mem_load8_hash() { 1 }
  else { if callee_hash == pipeline_ir_native_intrinsic_mem_store8_hash() { 1 }
  -- The pseudo forms the clone rewrites raw memory calls into are the
  -- same emit-supported operations: without them the inline closure
  -- stalls one level up (a wrapper that inlined a memory helper could
  -- never itself become a candidate).
  else { if callee_hash == pipeline_ir_pseudo_bridge_load64_hash() { 1 }
  else { if callee_hash == pipeline_ir_pseudo_bridge_store64_hash() { 1 }
  else { if callee_hash == pipeline_ir_pseudo_bridge_store64_discard_hash() { 1 }
  else { if callee_hash == pipeline_ir_pseudo_bridge_load8_hash() { 1 }
  else { if callee_hash == pipeline_ir_pseudo_bridge_store8_hash() { 1 }
  else { if callee_hash == pipeline_ir_pseudo_bridge_store8_discard_hash() { 1 }
  else { if callee_hash == pipeline_ir_pseudo_scaled_load64_hash() { 1 }
  else { if callee_hash == pipeline_ir_pseudo_scaled_store64_hash() { 1 }
  else { if callee_hash == pipeline_ir_pseudo_scaled_store64_discard_hash() { 1 } else { 0 } } } } } } } } } } } } }
}

pub(package) fn pipeline_ir_pure_intrinsic_inline_call_hash(callee_hash: i64) -> i64 {
  if callee_hash == pipeline_ir_native_intrinsic_f64_sqrt_hash() { 1 }
  else { if callee_hash == pipeline_ir_native_intrinsic_f32_sqrt_hash() { 1 } else { 0 } }
}


-- Structurally-tiny pure prepass for candidate closure: a single-block,
-- small, unmanaged, pure-scalar function is recorded here even when its
-- body calls other functions. Candidate eligibility may then admit calls
-- whose targets are in this set — helper CHAINS (u32 -> rotr32 -> bsig0)
-- become candidates and the iterated optimise passes collapse them
-- bottom-up one level per pass.
pub(package) fn pipeline_ir_tiny_pure_hashes(functions: IrFunctionList, facts: PipelineIrSemanticFactList, holder: i64) -> i64 {
  match functions {
    IrFunctionNil -> 0
    IrFunctionCons(f, rest) -> {
      match f {
        IrFunction(hash, param_count, blocks, src) -> {
          match blocks {
            IrBlockListCons(block, IrBlockListNil) -> {
              match block {
                IrBlock(id, params, insts, term) -> {
                  if ir_value_list_len(params) == 0 and ir_inst_list_len(insts) <= 9 and pipeline_ir_semantic_fact_lookup_consuming_param_mask(facts, hash) == 0 and pipeline_ir_semantic_fact_lookup_pure_scalar_result(facts, hash) == 1 {
                    match term {
                      IrTermReturn(return_value) -> pipeline_ir_hash_tree_add_unique(holder, hash)
                      _ -> 0
                    }
                  } else { 0 }
                }
              }
            }
            _ -> 0
          }
        }
      }
      pipeline_ir_tiny_pure_hashes(rest, facts, holder)
    }
  }
}

pub(package) fn pipeline_ir_tiny_pure_hash_tree(functions: IrFunctionList, facts: PipelineIrSemanticFactList) -> i64 {
  let holder = alloc_words(1)
  mem_store64_at(holder, 0, 0)
  pipeline_ir_tiny_pure_hashes(functions, facts, holder)
  mem_load64_at(holder, 0)
}

pub(package) fn pipeline_ir_inlineable_call_hash(callee_hash: i64) -> i64 {
  if pipeline_ir_raw_memory_inline_call_hash(callee_hash) == 1 { 1 }
  else { pipeline_ir_pure_intrinsic_inline_call_hash(callee_hash) }
}

pub(package) fn pipeline_ir_inline_clone_call_hash(callee_hash: i64) -> i64 {
  if callee_hash == pipeline_ir_native_intrinsic_mem_load64_hash() {
    pipeline_ir_pseudo_bridge_load64_hash()
  } else { if callee_hash == pipeline_ir_native_intrinsic_mem_store64_hash() {
    pipeline_ir_pseudo_bridge_store64_hash()
  } else { if callee_hash == pipeline_ir_native_intrinsic_mem_load8_hash() {
    pipeline_ir_pseudo_bridge_load8_hash()
  } else { if callee_hash == pipeline_ir_native_intrinsic_mem_store8_hash() {
    pipeline_ir_pseudo_bridge_store8_hash()
  } else {
    callee_hash
  } } } }
}

pub(package) fn pipeline_ir_tiny_inline_inst_supported(inst: IrInst, tiny_pure: i64, self_hash: i64) -> i64 {
  match inst {
    IrBindI64(ns, nl, value, ty) -> 1
    IrConstI64(dst, value) -> 1
    IrNilI64(dst) -> 1
    IrBinaryI64(dst, op, lhs, rhs) -> ir_binary_op_is_supported(op)
    IrFloatBinaryI64(dst, prim, op, lhs, rhs) -> ir_binary_op_is_supported(op)
    IrUnaryI64(dst, op, value) -> {
      match op {
        IrNot -> 1
        _ -> 0
      }
    }
    -- A call is clonable when the callee is an allowlisted bridge shape,
    -- or itself a structurally-tiny pure function (helper chains); the
    -- iterated passes then collapse one chain level per pass. Self-calls
    -- stay behind the call boundary (a pure one-block self-call is an
    -- infinite loop, but the guard keeps clone growth trivially bounded).
    IrCallI64(dst, callee_hash, args) -> {
      if pipeline_ir_inlineable_call_hash(callee_hash) == 1 { 1 }
      else { if callee_hash != self_hash and pipeline_ir_hash_tree_contains(tiny_pure, callee_hash) == 1 { 1 } else { 0 } }
    }
    IrManagedStakeI64(dst, value, cleanup_kind, delta, origin) -> 1
    -- Borrow-mask markers describe the callee boundary and disappear when
    -- every managed parameter is proven borrowed by candidate eligibility.
    IrSlotI64(slot) -> pipeline_ir_borrowed_param_mask_slot_is(slot)
    IrPtrLoadI64(dst, ptr) -> 1
    IrPtrStoreI64(dst, ptr, value) -> 1
    IrVectorGetI64(dst, vec, index, fallback, check_mode) -> 1
    IrVectorSetI64(dst, vec, index, value, check_mode) -> 1
    _ -> 0
  }
}

pub(package) fn pipeline_ir_tiny_inline_inst_list_supported(insts: IrInstList, tiny_pure: i64, self_hash: i64) -> i64 {
  match insts {
    IrInstNil -> 1
    IrInstCons(inst, rest) -> {
      if pipeline_ir_tiny_inline_inst_supported(inst, tiny_pure, self_hash) == 1 {
        pipeline_ir_tiny_inline_inst_list_supported(rest, tiny_pure, self_hash)
      } else {
        0
      }
    }
  }
}


-- Clone-time revalidation mirrors eligibility, with candidate membership
-- as the chain oracle: a call inside a cloned body is fine when its
-- target is a bridge shape or another candidate — the spliced call is
-- inlined by a later pass.
pub(package) fn pipeline_ir_tiny_inline_clone_call_ok(callee_hash: i64, inline_candidates: PipelineIrInlineCandidateList, self_hash: i64) -> i64 {
  if pipeline_ir_inlineable_call_hash(callee_hash) == 1 { 1 }
  else { if callee_hash == self_hash { 0 }
  else {
    match pipeline_ir_inline_candidate_lookup(inline_candidates, callee_hash) {
      IrFunctionNil -> 0
      IrFunctionCons(cf, crest) -> 1
    }
  } }
}

pub(package) fn pipeline_ir_tiny_inline_clone_supported(insts: IrInstList, inline_candidates: PipelineIrInlineCandidateList, self_hash: i64) -> i64 {
  match insts {
    IrInstNil -> 1
    IrInstCons(inst, rest) -> {
      let ok = match inst {
        IrCallI64(dst, callee_hash, args) -> pipeline_ir_tiny_inline_clone_call_ok(callee_hash, inline_candidates, self_hash)
        _ -> pipeline_ir_tiny_inline_inst_supported(inst, 0, self_hash)
      }
      if ok == 1 { pipeline_ir_tiny_inline_clone_supported(rest, inline_candidates, self_hash) } else { 0 }
    }
  }
}

pub(package) fn pipeline_ir_inline_clone_result(ok: i64, insts: IrInstList, env: PipelineIrInlineValueEnv, next_value: i64) -> PipelineIrInlineCloneResult {
  PipelineIrInlineCloneResult(ok, insts, env, next_value)
}

pub(package) fn pipeline_ir_inline_clone_result_ok(result: PipelineIrInlineCloneResult) -> i64 {
  match result {
    PipelineIrInlineCloneResult(ok, insts, env, next_value) -> ok
  }
}

pub(package) fn pipeline_ir_inline_clone_result_insts(result: PipelineIrInlineCloneResult) -> IrInstList {
  match result {
    PipelineIrInlineCloneResult(ok, insts, env, next_value) -> insts
  }
}

pub(package) fn pipeline_ir_inline_clone_result_env(result: PipelineIrInlineCloneResult) -> PipelineIrInlineValueEnv {
  match result {
    PipelineIrInlineCloneResult(ok, insts, env, next_value) -> env
  }
}

pub(package) fn pipeline_ir_inline_clone_result_next_value(result: PipelineIrInlineCloneResult) -> i64 {
  match result {
    PipelineIrInlineCloneResult(ok, insts, env, next_value) -> next_value
  }
}

pub(package) fn pipeline_ir_inline_clone_dst(original_dst: i64, return_value: i64, desired_result: i64, next_value: i64) -> i64 {
  if original_dst == return_value and desired_result >= 0 { desired_result } else { next_value }
}

pub(package) fn pipeline_ir_inline_clone_next(cloned_dst: i64, next_value: i64) -> i64 {
  if cloned_dst >= next_value { cloned_dst + 1 } else { next_value }
}

pub(package) fn pipeline_ir_inline_clone_inst(inst: IrInst, inline_env: PipelineIrInlineValueEnv, return_value: i64, desired_result: i64, next_value: i64) -> PipelineIrInlineCloneResult {
  match inst {
    IrBindI64(ns, nl, value, ty) -> {
      pipeline_ir_inline_clone_result(1, ir_inst_list_empty(), inline_env, next_value)
    }
    IrConstI64(dst, value) -> {
      let new_dst = pipeline_ir_inline_clone_dst(dst, return_value, desired_result, next_value)
      let cloned = ir_inst_const_i64(new_dst, value)
      pipeline_ir_inline_clone_result(1, ir_inst_list_prepend(cloned, ir_inst_list_empty()), pipeline_ir_inline_value_env_bind(inline_env, dst, new_dst), pipeline_ir_inline_clone_next(new_dst, next_value))
    }
    IrNilI64(dst) -> {
      let new_dst = pipeline_ir_inline_clone_dst(dst, return_value, desired_result, next_value)
      let cloned = ir_inst_nil_i64(new_dst)
      pipeline_ir_inline_clone_result(1, ir_inst_list_prepend(cloned, ir_inst_list_empty()), pipeline_ir_inline_value_env_bind(inline_env, dst, new_dst), pipeline_ir_inline_clone_next(new_dst, next_value))
    }
    IrBinaryI64(dst, op, lhs, rhs) -> {
      if ir_binary_op_is_supported(op) == 1 {
        let new_dst = pipeline_ir_inline_clone_dst(dst, return_value, desired_result, next_value)
        let cloned = ir_inst_binary_i64(
          new_dst,
          op,
          pipeline_ir_inline_value_env_lookup_or(inline_env, lhs, lhs),
          pipeline_ir_inline_value_env_lookup_or(inline_env, rhs, rhs)
        )
        pipeline_ir_inline_clone_result(1, ir_inst_list_prepend(cloned, ir_inst_list_empty()), pipeline_ir_inline_value_env_bind(inline_env, dst, new_dst), pipeline_ir_inline_clone_next(new_dst, next_value))
      } else {
        pipeline_ir_inline_clone_result(0, ir_inst_list_empty(), inline_env, next_value)
      }
    }
    IrFloatBinaryI64(dst, prim, op, lhs, rhs) -> {
      if ir_binary_op_is_supported(op) == 1 {
        let new_dst = pipeline_ir_inline_clone_dst(dst, return_value, desired_result, next_value)
        let cloned = ir_inst_float_binary_i64(
          new_dst,
          prim,
          op,
          pipeline_ir_inline_value_env_lookup_or(inline_env, lhs, lhs),
          pipeline_ir_inline_value_env_lookup_or(inline_env, rhs, rhs)
        )
        pipeline_ir_inline_clone_result(1, ir_inst_list_prepend(cloned, ir_inst_list_empty()), pipeline_ir_inline_value_env_bind(inline_env, dst, new_dst), pipeline_ir_inline_clone_next(new_dst, next_value))
      } else {
        pipeline_ir_inline_clone_result(0, ir_inst_list_empty(), inline_env, next_value)
      }
    }
    IrUnaryI64(dst, op, value) -> {
      match op {
        IrNot -> {
          let new_dst = pipeline_ir_inline_clone_dst(dst, return_value, desired_result, next_value)
          let cloned = ir_inst_unary_i64(new_dst, op, pipeline_ir_inline_value_env_lookup_or(inline_env, value, value))
          pipeline_ir_inline_clone_result(1, ir_inst_list_prepend(cloned, ir_inst_list_empty()), pipeline_ir_inline_value_env_bind(inline_env, dst, new_dst), pipeline_ir_inline_clone_next(new_dst, next_value))
        }
        _ -> pipeline_ir_inline_clone_result(0, ir_inst_list_empty(), inline_env, next_value)
      }
    }
    IrCallI64(dst, callee_hash, args) -> {
      -- Bridge-shape callees map to their pseudo-bridge ids; any other
      -- call (a fellow tiny-pure candidate, admitted by the clone
      -- support gate) is copied verbatim with remapped arguments and
      -- collapses on a later inline pass.
      let new_dst = pipeline_ir_inline_clone_dst(dst, return_value, desired_result, next_value)
      let cloned = ir_inst_call_i64(
        new_dst,
        pipeline_ir_inline_clone_call_hash(callee_hash),
        pipeline_ir_rewrite_inline_value_list(args, inline_env)
      )
      pipeline_ir_inline_clone_result(1, ir_inst_list_prepend(cloned, ir_inst_list_empty()), pipeline_ir_inline_value_env_bind(inline_env, dst, new_dst), pipeline_ir_inline_clone_next(new_dst, next_value))
    }
    IrGenericCallI64(dst, callee_hash, type_args, args) -> {
      let new_dst = pipeline_ir_inline_clone_dst(dst, return_value, desired_result, next_value)
      let cloned = IrGenericCallI64(
        new_dst,
        callee_hash,
        type_args,
        pipeline_ir_rewrite_inline_value_list(args, inline_env)
      )
      pipeline_ir_inline_clone_result(1, ir_inst_list_prepend(cloned, ir_inst_list_empty()), pipeline_ir_inline_value_env_bind(inline_env, dst, new_dst), pipeline_ir_inline_clone_next(new_dst, next_value))
    }
    IrResumeI64(dst, value) -> {
      let new_dst = pipeline_ir_inline_clone_dst(dst, return_value, desired_result, next_value)
      let cloned = IrResumeI64(new_dst, pipeline_ir_inline_value_env_lookup_or(inline_env, value, value))
      pipeline_ir_inline_clone_result(1, ir_inst_list_prepend(cloned, ir_inst_list_empty()), pipeline_ir_inline_value_env_bind(inline_env, dst, new_dst), pipeline_ir_inline_clone_next(new_dst, next_value))
    }
    IrManagedStakeI64(dst, value, cleanup_kind, delta, origin) -> {
      let new_dst = pipeline_ir_inline_clone_dst(dst, return_value, desired_result, next_value)
      let cloned = IrManagedStakeI64(
        new_dst,
        pipeline_ir_inline_value_env_lookup_or(inline_env, value, value),
        cleanup_kind,
        delta,
        origin
      )
      pipeline_ir_inline_clone_result(1, ir_inst_list_prepend(cloned, ir_inst_list_empty()), pipeline_ir_inline_value_env_bind(inline_env, dst, new_dst), pipeline_ir_inline_clone_next(new_dst, next_value))
    }
    IrSlotI64(slot) -> {
      if pipeline_ir_borrowed_param_mask_slot_is(slot) == 1 {
        pipeline_ir_inline_clone_result(1, ir_inst_list_empty(), inline_env, next_value)
      } else {
        pipeline_ir_inline_clone_result(0, ir_inst_list_empty(), inline_env, next_value)
      }
    }
    IrPtrLoadI64(dst, ptr) -> {
      let new_dst = pipeline_ir_inline_clone_dst(dst, return_value, desired_result, next_value)
      let cloned = ir_inst_ptr_load_i64(new_dst, pipeline_ir_inline_value_env_lookup_or(inline_env, ptr, ptr))
      pipeline_ir_inline_clone_result(1, ir_inst_list_prepend(cloned, ir_inst_list_empty()), pipeline_ir_inline_value_env_bind(inline_env, dst, new_dst), pipeline_ir_inline_clone_next(new_dst, next_value))
    }
    IrPtrStoreI64(dst, ptr, value) -> {
      let new_dst = pipeline_ir_inline_clone_dst(dst, return_value, desired_result, next_value)
      let cloned = ir_inst_ptr_store_i64(
        new_dst,
        pipeline_ir_inline_value_env_lookup_or(inline_env, ptr, ptr),
        pipeline_ir_inline_value_env_lookup_or(inline_env, value, value)
      )
      pipeline_ir_inline_clone_result(1, ir_inst_list_prepend(cloned, ir_inst_list_empty()), pipeline_ir_inline_value_env_bind(inline_env, dst, new_dst), pipeline_ir_inline_clone_next(new_dst, next_value))
    }
    IrVectorGetI64(dst, vec, index, fallback, check_mode) -> {
      let new_dst = pipeline_ir_inline_clone_dst(dst, return_value, desired_result, next_value)
      let cloned = IrVectorGetI64(
        new_dst,
        pipeline_ir_inline_value_env_lookup_or(inline_env, vec, vec),
        pipeline_ir_inline_value_env_lookup_or(inline_env, index, index),
        pipeline_ir_inline_value_env_lookup_or(inline_env, fallback, fallback),
        check_mode
      )
      pipeline_ir_inline_clone_result(1, ir_inst_list_prepend(cloned, ir_inst_list_empty()), pipeline_ir_inline_value_env_bind(inline_env, dst, new_dst), pipeline_ir_inline_clone_next(new_dst, next_value))
    }
    IrVectorSetI64(dst, vec, index, value, check_mode) -> {
      let new_dst = pipeline_ir_inline_clone_dst(dst, return_value, desired_result, next_value)
      let cloned = IrVectorSetI64(
        new_dst,
        pipeline_ir_inline_value_env_lookup_or(inline_env, vec, vec),
        pipeline_ir_inline_value_env_lookup_or(inline_env, index, index),
        pipeline_ir_inline_value_env_lookup_or(inline_env, value, value),
        check_mode
      )
      pipeline_ir_inline_clone_result(1, ir_inst_list_prepend(cloned, ir_inst_list_empty()), pipeline_ir_inline_value_env_bind(inline_env, dst, new_dst), pipeline_ir_inline_clone_next(new_dst, next_value))
    }
    _ -> pipeline_ir_inline_clone_result(0, ir_inst_list_empty(), inline_env, next_value)
  }
}

pub(package) fn pipeline_ir_inline_clone_inst_list(insts: IrInstList, inline_env: PipelineIrInlineValueEnv, return_value: i64, desired_result: i64, next_value: i64) -> PipelineIrInlineCloneResult {
  match insts {
    IrInstNil -> pipeline_ir_inline_clone_result(1, ir_inst_list_empty(), inline_env, next_value)
    IrInstCons(inst, rest) -> {
      let head = pipeline_ir_inline_clone_inst(inst, inline_env, return_value, desired_result, next_value)
      if pipeline_ir_inline_clone_result_ok(head) == 1 {
        let tail = pipeline_ir_inline_clone_inst_list(rest, pipeline_ir_inline_clone_result_env(head), return_value, desired_result, pipeline_ir_inline_clone_result_next_value(head))
        if pipeline_ir_inline_clone_result_ok(tail) == 1 {
          pipeline_ir_inline_clone_result(
            1,
            ir_inst_list_append(pipeline_ir_inline_clone_result_insts(head), pipeline_ir_inline_clone_result_insts(tail)),
            pipeline_ir_inline_clone_result_env(tail),
            pipeline_ir_inline_clone_result_next_value(tail)
          )
        } else {
          tail
        }
      } else {
        head
      }
    }
  }
}

pub(package) fn pipeline_ir_inline_result(ok: i64, insts: IrInstList, result_value: i64, next_value: i64) -> PipelineIrInlineResult {
  PipelineIrInlineResult(ok, insts, result_value, next_value)
}

pub(package) fn pipeline_ir_inline_result_ok(result: PipelineIrInlineResult) -> i64 {
  match result {
    PipelineIrInlineResult(ok, insts, result_value, next_value) -> ok
  }
}

pub(package) fn pipeline_ir_inline_result_insts(result: PipelineIrInlineResult) -> IrInstList {
  match result {
    PipelineIrInlineResult(ok, insts, result_value, next_value) -> insts
  }
}

pub(package) fn pipeline_ir_inline_result_value(result: PipelineIrInlineResult) -> i64 {
  match result {
    PipelineIrInlineResult(ok, insts, result_value, next_value) -> result_value
  }
}

pub(package) fn pipeline_ir_inline_result_next_value(result: PipelineIrInlineResult) -> i64 {
  match result {
    PipelineIrInlineResult(ok, insts, result_value, next_value) -> next_value
  }
}

pub(package) fn pipeline_ir_try_inline_direct_call(callee_hash: i64, args: IrValueList, inline_candidates: PipelineIrInlineCandidateList, facts: PipelineIrSemanticFactList, desired_result: i64, next_value: i64) -> PipelineIrInlineResult {
  let found = pipeline_ir_inline_candidate_lookup(inline_candidates, callee_hash)
  match found {
    IrFunctionNil -> pipeline_ir_inline_result(0, ir_inst_list_empty(), 0, next_value)
    IrFunctionCons(callee, rest) -> {
      match callee {
        IrFunction(hash, param_count, blocks, src) -> {
          if ir_value_list_len(args) != param_count {
            pipeline_ir_inline_result(0, ir_inst_list_empty(), 0, next_value)
          } else {
            match blocks {
              IrBlockListCons(block, IrBlockListNil) -> {
                match block {
                  IrBlock(id, params, insts, term) -> {
                    if ir_value_list_len(params) != 0 or ir_inst_list_len(insts) > 9 or pipeline_ir_tiny_inline_clone_supported(insts, inline_candidates, hash) != 1 {
                      pipeline_ir_inline_result(0, ir_inst_list_empty(), 0, next_value)
                    } else {
                      match term {
	                        IrTermReturn(return_value) -> {
	                          let arg_env = pipeline_ir_inline_arg_env(args, 0, PipelineIrInlineValueEnvNil)
	                          let cloned = pipeline_ir_inline_clone_inst_list(insts, arg_env, return_value, desired_result, next_value)
                          if pipeline_ir_inline_clone_result_ok(cloned) == 1 {
                            let mapped_return = pipeline_ir_inline_value_env_lookup_or(pipeline_ir_inline_clone_result_env(cloned), return_value, 0 - 1)
                            if mapped_return >= 0 {
                              pipeline_ir_inline_result(1, pipeline_ir_inline_clone_result_insts(cloned), mapped_return, pipeline_ir_inline_clone_result_next_value(cloned))
                            } else {
                              pipeline_ir_inline_result(0, ir_inst_list_empty(), 0, next_value)
                            }
                          } else {
                            pipeline_ir_inline_result(0, ir_inst_list_empty(), 0, next_value)
                          }
                        }
                        _ -> pipeline_ir_inline_result(0, ir_inst_list_empty(), 0, next_value)
                      }
                    }
                  }
                }
              }
              _ -> pipeline_ir_inline_result(0, ir_inst_list_empty(), 0, next_value)
            }
          }
        }
      }
    }
  }
}

-- ======================================================================
-- Multi-block tiny-fn inlining (multi-block inlining): splice small pure
-- unmanaged-param callees whose bodies carry control flow — the
-- null-guarded storage accessors and comparator shapes the
-- single-block splice above can never take. Eligibility consumes the
-- semantic fact list (purity, managed masks); nothing is re-derived
-- from syntax. The splice runs per host function before the fold, so
-- copy-prop, CSE, and DCE then chew on the merged body.
-- ======================================================================

pub(package) fn pipeline_ir_multi_inline_blocks_cap() -> i64 { 10 }
pub(package) fn pipeline_ir_multi_inline_insts_cap() -> i64 { 32 }
pub(package) fn pipeline_ir_multi_inline_site_cap() -> i64 { 32 }
pub(package) fn pipeline_ir_multi_inline_dense_table_site_cap() -> i64 { 96 }

-- ----------------------------------------------------------------------
-- Spec facts (generic-specialization facts): generic specialisations carry no semantic
-- facts (the fact plane is keyed by declaration name hash), which kept
-- every spec out of the inline candidate set. This producer walks the
-- lowered module's generic call sites — the same site-driven discovery
-- the spec collector uses — and registers a fact under each spec hash,
-- built from the template's substituted signature and the template's
-- body effect flags (the body is identical modulo types).
-- ----------------------------------------------------------------------

pub(package) fn pipeline_ir_spec_fact_add(spec_hash: i64, pair: i64, targ_nodes: i64, flag_map: i64, facts: PipelineIrSemanticFactList) -> PipelineIrSemanticFactList {
  if pipeline_ir_semantic_fact_find(facts, spec_hash) != 0 { facts }
  else {
    let fn_wrap = node_f1(pair)
    let fn_src = node_f2(pair)
    let inner = pipeline_fn_inner(fn_wrap)
    let subst = cg_build_subst(fn_tparams(fn_wrap), targ_nodes)
    let params = cg_params_shape_specialise(node_f3(inner), fn_tparams(fn_wrap), targ_nodes)
    let ret_ty = cg_generic_subst_ret(fn_wrap, targ_nodes)
    let eff = effect_sig_from_node(fn_effects(fn_wrap))
    let declared_alloc = effect_sig_contains_hash(eff, effect_name_hash(__str_ptr("Alloc"), 0, 5))
    let declared_unsafe = effect_sig_contains_hash(eff, effect_name_hash(__str_ptr("Unsafe"), 0, 6))
    let template_name_hash = str_hash(fn_src, node_f1(inner), node_f2(inner))
    let template_hash = pipeline_fn_pair_key(pair)
    let effect_summary = cg_semantic_effect_summary_new(effect_sig_is_closed_or(eff, 1), effect_sig_count_or(eff, 0), declared_alloc, declared_unsafe)
    let fact = cg_semantic_fact_new_with_effect_summary(0, effect_summary, params, ret_ty, 0, pipeline_ir_effect_flag_map_lookup(flag_map, template_hash))
    let signature_borrow = pipeline_ir_borrow_facts_for_signature(params, ret_ty)
    let summary_hash = if pipeline_ir_semantic_fact_find(facts, template_hash) != 0 { template_hash } else { template_name_hash }
    let template_fact = pipeline_ir_semantic_fact_find(facts, summary_hash)
    cg_semantic_fact_set_traversal_code(fact, cg_semantic_fact_traversal_code(template_fact))
    cg_semantic_fact_set_dense_table_role(fact, cg_semantic_fact_dense_table_role(template_fact))
    let alias_mask = cg_semantic_fact_return_alias_param_mask(template_fact)
    cg_semantic_fact_set_return_alias_param_mask(fact, alias_mask)
    let template_borrow = pipeline_ir_semantic_borrow_fact_find(facts, summary_hash)
    let summary = if ty_is_slice(ret_ty) and alias_mask != 0 {
      ir_borrow_summary_known(pipeline_ir_return_alias_params_from_mask(alias_mask, 0, nlist_len(params)))
    } else { if ty_is_slice(ret_ty) { ir_borrow_facts_summary(template_borrow) }
    else { ir_borrow_facts_summary(signature_borrow) } }
    let borrow = ir_borrow_facts_with_summary(signature_borrow, summary)
    pipeline_ir_semantic_facts_prepend_with_borrow(spec_hash, fact, borrow, facts)
  }
}

pub(package) fn pipeline_ir_spec_facts_insts(insts: IrInstList, templates: i64, flag_map: i64, facts: PipelineIrSemanticFactList) -> PipelineIrSemanticFactList {
  match insts {
    IrInstNil -> facts
    IrInstCons(inst, rest) -> {
      let next = match inst {
        IrGenericCallI64(dst, callee_hash, type_args, args) -> {
          let pair = pipeline_generic_template_find(templates, 0, callee_hash)
          if pair == 0 { facts }
          else {
            let nodes = type_expr_list_to_nodes(type_args)
            pipeline_ir_spec_fact_add(mono_spec_hash(callee_hash, nodes), pair, nodes, flag_map, facts)
          }
        }
        IrGenericFunctionRefI64(dst, callee_hash, type_args) -> {
          if type_expr_list_len(type_args) == 0 { facts }
          else {
            let pair = pipeline_generic_template_find(templates, 0, callee_hash)
            if pair == 0 { facts }
            else {
              let nodes = type_expr_list_to_nodes(type_args)
              pipeline_ir_spec_fact_add(mono_spec_hash(callee_hash, nodes), pair, nodes, flag_map, facts)
            }
          }
        }
        _ -> facts
      }
      pipeline_ir_spec_facts_insts(rest, templates, flag_map, next)
    }
  }
}

pub(package) fn pipeline_ir_spec_facts_blocks(blocks: IrBlockList, templates: i64, flag_map: i64, facts: PipelineIrSemanticFactList) -> PipelineIrSemanticFactList {
  match blocks {
    IrBlockListNil -> facts
    IrBlockListCons(block, rest) -> {
      let next = match block {
        IrBlock(id, params, insts, term) -> pipeline_ir_spec_facts_insts(insts, templates, flag_map, facts)
      }
      pipeline_ir_spec_facts_blocks(rest, templates, flag_map, next)
    }
  }
}

pub(package) fn pipeline_ir_spec_facts_extend(functions: IrFunctionList, templates: i64, flag_map: i64, facts: PipelineIrSemanticFactList) -> PipelineIrSemanticFactList {
  match functions {
    IrFunctionNil -> facts
    IrFunctionCons(f, rest) -> {
      let next = match f {
        IrFunction(hash, nparams, blocks, src) -> pipeline_ir_spec_facts_blocks(blocks, templates, flag_map, facts)
      }
      pipeline_ir_spec_facts_extend(rest, templates, flag_map, next)
    }
  }
}

pub(package) fn pipeline_ir_multi_inline_inst_supported(inst: IrInst, self_hash: i64, structural: i64, direct_retain_return: i64) -> i64 {
  match inst {
    IrConstI64(dst, value) -> 1
    IrNilI64(dst) -> 1
    IrBinaryI64(dst, op, lhs, rhs) -> ir_binary_op_is_supported(op)
    IrFloatBinaryI64(dst, prim, op, lhs, rhs) -> ir_binary_op_is_supported(op)
    IrUnaryI64(dst, op, value) -> 1
    IrPtrLoadI64(dst, ptr) -> 1
    IrBindI64(ns, nl, value, ty) -> 1
    -- Slot cells (mut locals) renumber like any other def; the magic
    -- borrowed-param-mask marker is dropped at clone time instead (it
    -- describes the callee's own parameter contract, which dissolves
    -- when the body is spliced into a host).
    IrSlotI64(slot) -> 1
    IrLoadI64(dst, slot) -> 1
    IrStoreI64(slot, value) -> 1
    -- Variant construction and resolved record reads are admitted only for
    -- declaration-role-gated structural methods. Their exact bodies carry
    -- the complete payload ownership protocol; unrelated candidates remain
    -- fenced regardless of instruction shape.
    IrVariantInitI64(dst, tag_hash, payloads, field_mask) -> structural
    IrVariantTagI64(dst, value) -> 1
    IrVariantPayloadI64(dst, value, index) -> 1
    IrRecordLayoutWordLoadI64(dst, base, record_data_size, field_hash, byte_offset) -> structural
    IrFieldLoadI64(dst, base, field_hash, field_index) -> structural
    -- Typed vector accesses are already semantic IR facts: cloning their
    -- operands and preserved proof mode is strictly more faithful than
    -- forcing a tiny accessor wrapper to survive as a hot call boundary.
    IrVectorGetI64(dst, vec, index, fallback, check_mode) -> 1
    IrVectorSetI64(dst, vec, index, value, check_mode) -> 1
    -- The unmatched-arm trap: no operands, no result, emits a BRK.
    -- Admitting it (match-bodied accessors) is affordable only because
    -- splices are loop-gated; ungated it blew probe compiles from
    -- seconds past the suite timeout.
    IrLoweringFailureI64(reason) -> 1
    -- A self-call would re-expose a candidate site on every splice and
    -- burn the whole growth budget on one recursive body.
    -- A trusted source-level retain is a real ownership acquisition but not
    -- an IrManagedStakeI64: only lowering may manufacture that instruction.
    -- A direct retain-return fact proves the retained word itself crosses the
    -- boundary. Other helpers may package it behind an owned contract, whose
    -- exact transfer the splicer cannot yet synthesize.
    IrCallI64(dst, callee_hash, args) -> {
      if callee_hash == self_hash or
        (direct_retain_return == 0 and pipeline_ir_abort_cleanup_is_managed_retain_hash(callee_hash) == 1) { 0 } else { 1 }
    }
    IrManagedStakeI64(dst, value, cleanup_kind, delta, origin) -> 1
    IrGenericCallI64(dst, callee_hash, type_args, args) -> {
      if mono_spec_hash(callee_hash, type_expr_list_to_nodes(type_args)) == self_hash { 0 } else { 1 }
    }
    IrMethodCallI64(dst, type_hash, method_hash, receiver, args) -> {
      if pipeline_ir_method_patch_key(type_hash, method_hash) == self_hash { 0 } else { 1 }
    }
    _ -> 0
  }
}

pub(package) fn pipeline_ir_multi_inline_insts_ok(insts: IrInstList, self_hash: i64, structural: i64, direct_retain_return: i64) -> i64 {
  match insts {
    IrInstNil -> 1
    IrInstCons(inst, rest) -> {
      if pipeline_ir_multi_inline_inst_supported(inst, self_hash, structural, direct_retain_return) == 1 {
        pipeline_ir_multi_inline_insts_ok(rest, self_hash, structural, direct_retain_return)
      } else { 0 }
    }
  }
}

pub(package) fn pipeline_ir_multi_inline_term_ok(term: IrTerminator) -> i64 {
  match term {
    IrTermReturn(value) -> 1
    IrTermJump(target, args) -> 1
    IrTermBranch(cond, then_target, else_target) -> 1
    IrTermUnreachable -> 1
    IrTermNone -> 0
  }
}

pub(package) fn pipeline_ir_multi_inline_blocks_ok(blocks: IrBlockList, self_hash: i64, structural: i64, direct_retain_return: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 1
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          if pipeline_ir_multi_inline_insts_ok(insts, self_hash, structural, direct_retain_return) == 1 and pipeline_ir_multi_inline_term_ok(term) == 1 {
            pipeline_ir_multi_inline_blocks_ok(rest, self_hash, structural, direct_retain_return)
          } else { 0 }
        }
      }
    }
  }
}

pub(package) fn pipeline_ir_multi_inline_entry_params_empty(blocks: IrBlockList) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> if ir_value_list_len(params) == 0 { 1 } else { 0 }
      }
    }
  }
}

pub(package) fn pipeline_ir_multi_inline_eligible(f: IrFunction, facts: PipelineIrSemanticFactList, index_hash: i64, index_lower_hash: i64, index_upper_hash: i64, index_full_hash: i64, slice_hashes: i64) -> i64 {
  match f {
    IrFunction(hash, param_count, blocks, src) -> {
      let nblocks = ir_block_list_len(blocks)
      let dense_table_role = pipeline_ir_semantic_fact_lookup_dense_table_role(facts, hash)
      let structural = if dense_table_role == cg_semantic_dense_table_role_none() { 0 } else { 1 }
      let fact = pipeline_ir_semantic_fact_find(facts, hash)
      let direct_retain_return = cg_semantic_fact_direct_retain_return(fact)
      let block_cap = if structural == 1 { 12 } else { pipeline_ir_multi_inline_blocks_cap() }
      -- Storage operations and indexed-address proof modes are semantic fact
      -- producers/consumers. Keep them intact until the local rewrite pass has
      -- consumed their resolved roles. The generated defer action is likewise
      -- a cleanup-fact carrier: dynamic-wind cleanup must see its call to pair
      -- the scheduled closure with the abort descriptor.
      if hash == pipeline_runtime_defer_abort_cleanup_hash() or hash == pipeline_ir_vector_len_hash() or dense_table_role == cg_semantic_dense_table_role_storage_rows() or dense_table_role == cg_semantic_dense_table_role_storage_get() or dense_table_role == cg_semantic_dense_table_role_storage_set() or hash == index_hash or hash == index_lower_hash or hash == index_upper_hash or hash == index_full_hash or pipeline_hash_list_contains(slice_hashes, hash) == 1 { 0 }
      else { if nblocks < 1 or nblocks > block_cap { 0 }
      else { if ir_block_list_inst_count(blocks) > pipeline_ir_multi_inline_insts_cap() { 0 }
      -- Managed params and managed returns are admissible: lowered
      -- bodies embed their whole ownership protocol (transfer retains,
      -- borrow-masked or owned param releases, return transfers), so a
      -- verbatim splice preserves balance. What must hold is a scalar-lane
      -- ABI: each logical param and the result has exactly one known GPR,
      -- f32, or f64 lane. Aggregate and unknown shapes stay behind calls.
      else { if pipeline_ir_semantic_fact_lookup_single_lane_call(facts, hash) != 1 { 0 }
      -- A single-return identity currently materialises the destination with
      -- integer add-zero in the continuation. That is valid for a GPR lane,
      -- but would destroy an FP lane's representation contract. Keep only
      -- that exact float-alias shape behind the call until the splice can
      -- publish an explicit SSA alias.
      else {
        let return_value = pipeline_ir_multi_single_return_value(blocks)
        if pipeline_ir_multi_return_count(blocks) == 1 and return_value >= 0 and return_value < param_count and ir_value_shape_is_single_gpr(cg_semantic_fact_return_shape(fact)) != 1 { 0 }
      -- Single-block candidates are admitted. The historic exclusion
      -- (sorted_map put wrote search flags as entry keys) was not a
      -- splice-mechanics bug: the miswire was constant-intrinsic
      -- generic call sites (vector_element_mode_of and friends), whose
      -- spec bodies are placeholders — those sites are now opaque at
      -- the split site, see
      -- pipeline_ir_native_generic_call_constant_intrinsic.
        else { if pipeline_ir_multi_inline_entry_params_empty(blocks) == 0 { 0 }
        else { pipeline_ir_multi_inline_blocks_ok(blocks, hash, structural, direct_retain_return) } }
      } } } } }
    }
  }
}

pub(package) fn pipeline_ir_multi_inline_candidates_walk_with_index_hashes(functions: IrFunctionList, facts: PipelineIrSemanticFactList, index_hash: i64, index_lower_hash: i64, index_upper_hash: i64, index_full_hash: i64, slice_hashes: i64) -> PipelineIrInlineCandidateList {
  match functions {
    IrFunctionNil -> PipelineIrInlineCandidateNil
    IrFunctionCons(f, rest) -> {
      let tail = pipeline_ir_multi_inline_candidates_walk_with_index_hashes(rest, facts, index_hash, index_lower_hash, index_upper_hash, index_full_hash, slice_hashes)
      match f {
        IrFunction(hash, param_count, blocks, src) -> {
          if pipeline_ir_multi_inline_eligible(f, facts, index_hash, index_lower_hash, index_upper_hash, index_full_hash, slice_hashes) == 1 {
            pipeline_ir_inline_candidate_prepend(hash, f, tail)
          } else {
            tail
          }
        }
      }
    }
  }
}

pub(package) fn pipeline_ir_multi_inline_candidates_walk(functions: IrFunctionList, facts: PipelineIrSemanticFactList) -> PipelineIrInlineCandidateList {
  -- Hash string literals once per candidate census. Recomputing them in
  -- the per-function eligibility predicate retained 832 bytes of bump state
  -- per function and violated the optimiser's marginal-scratch contract.
  pipeline_ir_multi_inline_candidates_walk_with_index_hashes(
    functions,
    facts,
    pipeline_runtime_index_address_hash(),
    pipeline_runtime_index_address_lower_proven_hash(),
    pipeline_runtime_index_address_upper_proven_hash(),
    pipeline_runtime_index_address_full_proven_hash(),
    pipeline_runtime_slice_address_hashes()
  )
}

-- Clone context: value env (callee id -> host id), next host value id,
-- block env (callee block id -> host block id), next host block id.
pub(package) type PipelineIrMultiCloneCtx {
  PipelineIrMultiCloneCtx(PipelineIrInlineValueEnv, i64, PipelineIrInlineValueEnv, i64)
}

pub(package) fn pipeline_ir_multi_clone_ctx_venv(ctx: PipelineIrMultiCloneCtx) -> PipelineIrInlineValueEnv {
  match ctx { PipelineIrMultiCloneCtx(venv, next_value, benv, next_block) -> venv }
}

pub(package) fn pipeline_ir_multi_clone_ctx_next_value(ctx: PipelineIrMultiCloneCtx) -> i64 {
  match ctx { PipelineIrMultiCloneCtx(venv, next_value, benv, next_block) -> next_value }
}

pub(package) fn pipeline_ir_multi_clone_ctx_benv(ctx: PipelineIrMultiCloneCtx) -> PipelineIrInlineValueEnv {
  match ctx { PipelineIrMultiCloneCtx(venv, next_value, benv, next_block) -> benv }
}

pub(package) fn pipeline_ir_multi_clone_ctx_next_block(ctx: PipelineIrMultiCloneCtx) -> i64 {
  match ctx { PipelineIrMultiCloneCtx(venv, next_value, benv, next_block) -> next_block }
}

-- The borrowed-param-mask marker is an IrSlotI64 whose id sits at or
-- below this base; it describes the callee's own parameter contract
-- and is dropped when the body is spliced into a host.
pub(package) fn pipeline_ir_multi_slot_is_marker(slot: i64) -> i64 {
  if slot <= pipeline_ir_borrowed_param_mask_slot_base() { 1 } else { 0 }
}

pub(package) fn pipeline_ir_multi_inline_inst_dst(inst: IrInst) -> i64 {
  match inst {
    IrConstI64(dst, value) -> dst
    IrNilI64(dst) -> dst
    IrBinaryI64(dst, op, lhs, rhs) -> dst
    IrFloatBinaryI64(dst, prim, op, lhs, rhs) -> dst
    IrUnaryI64(dst, op, value) -> dst
    IrPtrLoadI64(dst, ptr) -> dst
    IrCallI64(dst, callee_hash, args) -> dst
    IrManagedStakeI64(dst, value, cleanup_kind, delta, origin) -> dst
    IrSlotI64(slot) -> if pipeline_ir_multi_slot_is_marker(slot) == 1 { 0 - 1 } else { slot }
    IrLoadI64(dst, slot) -> dst
    IrVariantInitI64(dst, tag_hash, payloads, field_mask) -> dst
    IrVariantTagI64(dst, value) -> dst
    IrVariantPayloadI64(dst, value, index) -> dst
    IrRecordLayoutWordLoadI64(dst, base, record_data_size, field_hash, byte_offset) -> dst
    IrFieldLoadI64(dst, base, field_hash, field_index) -> dst
    IrVectorGetI64(dst, vec, index, fallback, check_mode) -> dst
    IrVectorSetI64(dst, vec, index, value, check_mode) -> dst
    IrGenericCallI64(dst, callee_hash, type_args, args) -> dst
    IrMethodCallI64(dst, type_hash, method_hash, receiver, args) -> dst
    _ -> 0 - 1
  }
}

pub(package) fn pipeline_ir_multi_defs_values(values: IrValueList, ctx: PipelineIrMultiCloneCtx) -> PipelineIrMultiCloneCtx {
  match values {
    IrValueNil -> ctx
    IrValueCons(value, rest) -> {
      let nv = pipeline_ir_multi_clone_ctx_next_value(ctx)
      let next = PipelineIrMultiCloneCtx(
        pipeline_ir_inline_value_env_bind(pipeline_ir_multi_clone_ctx_venv(ctx), value, nv),
        nv + 1,
        pipeline_ir_multi_clone_ctx_benv(ctx),
        pipeline_ir_multi_clone_ctx_next_block(ctx)
      )
      pipeline_ir_multi_defs_values(rest, next)
    }
  }
}

pub(package) fn pipeline_ir_multi_defs_insts(insts: IrInstList, ctx: PipelineIrMultiCloneCtx) -> PipelineIrMultiCloneCtx {
  match insts {
    IrInstNil -> ctx
    IrInstCons(inst, rest) -> {
      let dst = pipeline_ir_multi_inline_inst_dst(inst)
      let next = if dst < 0 { ctx } else {
        let nv = pipeline_ir_multi_clone_ctx_next_value(ctx)
        PipelineIrMultiCloneCtx(
          pipeline_ir_inline_value_env_bind(pipeline_ir_multi_clone_ctx_venv(ctx), dst, nv),
          nv + 1,
          pipeline_ir_multi_clone_ctx_benv(ctx),
          pipeline_ir_multi_clone_ctx_next_block(ctx)
        )
      }
      pipeline_ir_multi_defs_insts(rest, next)
    }
  }
}

pub(package) fn pipeline_ir_multi_defs_blocks(blocks: IrBlockList, ctx: PipelineIrMultiCloneCtx) -> PipelineIrMultiCloneCtx {
  match blocks {
    IrBlockListNil -> ctx
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          let nb = pipeline_ir_multi_clone_ctx_next_block(ctx)
          let with_block = PipelineIrMultiCloneCtx(
            pipeline_ir_multi_clone_ctx_venv(ctx),
            pipeline_ir_multi_clone_ctx_next_value(ctx),
            pipeline_ir_inline_value_env_bind(pipeline_ir_multi_clone_ctx_benv(ctx), id, nb),
            nb + 1
          )
          let with_params = pipeline_ir_multi_defs_values(params, with_block)
          let with_insts = pipeline_ir_multi_defs_insts(insts, with_params)
          pipeline_ir_multi_defs_blocks(rest, with_insts)
        }
      }
    }
  }
}

-- Uses must resolve through the env: callee bodies only reference their
-- own params (pre-bound to call args) and local defs. An unbound use
-- means the candidate body was not self-contained; the splice bails.
pub(package) fn pipeline_ir_multi_uses_bound_values(values: IrValueList, venv: PipelineIrInlineValueEnv) -> i64 {
  match values {
    IrValueNil -> 1
    IrValueCons(value, rest) -> {
      if pipeline_ir_inline_value_env_lookup_or(venv, value, 0 - 1) < 0 { 0 }
      else { pipeline_ir_multi_uses_bound_values(rest, venv) }
    }
  }
}

pub(package) fn pipeline_ir_multi_uses_bound_inst(inst: IrInst, venv: PipelineIrInlineValueEnv) -> i64 {
  match inst {
    IrConstI64(dst, value) -> 1
    IrNilI64(dst) -> 1
    IrBinaryI64(dst, op, lhs, rhs) -> {
      if pipeline_ir_inline_value_env_lookup_or(venv, lhs, 0 - 1) < 0 { 0 }
      else { if pipeline_ir_inline_value_env_lookup_or(venv, rhs, 0 - 1) < 0 { 0 } else { 1 } }
    }
    IrFloatBinaryI64(dst, prim, op, lhs, rhs) -> {
      if pipeline_ir_inline_value_env_lookup_or(venv, lhs, 0 - 1) < 0 { 0 }
      else { if pipeline_ir_inline_value_env_lookup_or(venv, rhs, 0 - 1) < 0 { 0 } else { 1 } }
    }
    IrUnaryI64(dst, op, value) -> if pipeline_ir_inline_value_env_lookup_or(venv, value, 0 - 1) < 0 { 0 } else { 1 }
    IrPtrLoadI64(dst, ptr) -> if pipeline_ir_inline_value_env_lookup_or(venv, ptr, 0 - 1) < 0 { 0 } else { 1 }
    IrBindI64(ns, nl, value, ty) -> 1
    IrLoweringFailureI64(reason) -> 1
    IrCallI64(dst, callee_hash, args) -> pipeline_ir_multi_uses_bound_values(args, venv)
    IrManagedStakeI64(dst, value, cleanup_kind, delta, origin) -> if pipeline_ir_inline_value_env_lookup_or(venv, value, 0 - 1) < 0 { 0 } else { 1 }
    IrSlotI64(slot) -> 1
    IrLoadI64(dst, slot) -> {
      if pipeline_ir_multi_slot_is_marker(slot) == 1 { 0 }
      else { if pipeline_ir_inline_value_env_lookup_or(venv, slot, 0 - 1) < 0 { 0 } else { 1 } }
    }
    IrStoreI64(slot, value) -> {
      if pipeline_ir_multi_slot_is_marker(slot) == 1 { 0 }
      else { if pipeline_ir_inline_value_env_lookup_or(venv, slot, 0 - 1) < 0 { 0 }
      else { if pipeline_ir_inline_value_env_lookup_or(venv, value, 0 - 1) < 0 { 0 } else { 1 } } }
    }
    IrVariantInitI64(dst, tag_hash, payloads, field_mask) -> pipeline_ir_multi_uses_bound_values(payloads, venv)
    IrVariantTagI64(dst, value) -> if pipeline_ir_inline_value_env_lookup_or(venv, value, 0 - 1) < 0 { 0 } else { 1 }
    IrVariantPayloadI64(dst, value, index) -> if pipeline_ir_inline_value_env_lookup_or(venv, value, 0 - 1) < 0 { 0 } else { 1 }
    IrRecordLayoutWordLoadI64(dst, base, record_data_size, field_hash, byte_offset) -> if pipeline_ir_inline_value_env_lookup_or(venv, base, 0 - 1) < 0 { 0 } else { 1 }
    IrFieldLoadI64(dst, base, field_hash, field_index) -> if pipeline_ir_inline_value_env_lookup_or(venv, base, 0 - 1) < 0 { 0 } else { 1 }
    IrVectorGetI64(dst, vec, index, fallback, check_mode) -> {
      if pipeline_ir_inline_value_env_lookup_or(venv, vec, 0 - 1) < 0 { 0 }
      else { if pipeline_ir_inline_value_env_lookup_or(venv, index, 0 - 1) < 0 { 0 }
      else { if pipeline_ir_inline_value_env_lookup_or(venv, fallback, 0 - 1) < 0 { 0 } else { 1 } } }
    }
    IrVectorSetI64(dst, vec, index, value, check_mode) -> {
      if pipeline_ir_inline_value_env_lookup_or(venv, vec, 0 - 1) < 0 { 0 }
      else { if pipeline_ir_inline_value_env_lookup_or(venv, index, 0 - 1) < 0 { 0 }
      else { if pipeline_ir_inline_value_env_lookup_or(venv, value, 0 - 1) < 0 { 0 } else { 1 } } }
    }
    IrGenericCallI64(dst, callee_hash, type_args, args) -> pipeline_ir_multi_uses_bound_values(args, venv)
    IrMethodCallI64(dst, type_hash, method_hash, receiver, args) -> {
      if pipeline_ir_inline_value_env_lookup_or(venv, receiver, 0 - 1) < 0 { 0 }
      else { pipeline_ir_multi_uses_bound_values(args, venv) }
    }
    _ -> 0
  }
}

pub(package) fn pipeline_ir_multi_uses_bound_term(term: IrTerminator, venv: PipelineIrInlineValueEnv) -> i64 {
  match term {
    IrTermReturn(value) -> if pipeline_ir_inline_value_env_lookup_or(venv, value, 0 - 1) < 0 { 0 } else { 1 }
    IrTermJump(target, args) -> pipeline_ir_multi_uses_bound_values(args, venv)
    IrTermBranch(cond, then_target, else_target) -> if pipeline_ir_inline_value_env_lookup_or(venv, cond, 0 - 1) < 0 { 0 } else { 1 }
    IrTermUnreachable -> 1
    IrTermNone -> 0
  }
}

pub(package) fn pipeline_ir_multi_uses_bound_blocks(blocks: IrBlockList, venv: PipelineIrInlineValueEnv) -> i64 {
  match blocks {
    IrBlockListNil -> 1
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          let mut cur = insts
          let mut ok = 1
          while ok == 1 {
            match cur {
              IrInstNil -> { ok = 2 }
              IrInstCons(inst, tail) -> {
                if pipeline_ir_multi_uses_bound_inst(inst, venv) == 0 { ok = 0 } else { cur = tail }
              }
            }
          }
          if ok == 0 { 0 }
          else { if pipeline_ir_multi_uses_bound_term(term, venv) == 0 { 0 }
          else { pipeline_ir_multi_uses_bound_blocks(rest, venv) } }
        }
      }
    }
  }
}

pub(package) fn pipeline_ir_multi_map_value(venv: PipelineIrInlineValueEnv, value: i64) -> i64 {
  pipeline_ir_inline_value_env_lookup_or(venv, value, value)
}

pub(package) fn pipeline_ir_multi_map_values(values: IrValueList, venv: PipelineIrInlineValueEnv) -> IrValueList {
  match values {
    IrValueNil -> IrValueNil
    IrValueCons(value, rest) -> IrValueCons(pipeline_ir_multi_map_value(venv, value), pipeline_ir_multi_map_values(rest, venv))
  }
}

pub(package) fn pipeline_ir_multi_clone_insts(insts: IrInstList, venv: PipelineIrInlineValueEnv) -> IrInstList {
  match insts {
    IrInstNil -> IrInstNil
    IrInstCons(inst, rest) -> {
      let tail = pipeline_ir_multi_clone_insts(rest, venv)
      match inst {
        IrConstI64(dst, value) -> IrInstCons(ir_inst_const_i64(pipeline_ir_multi_map_value(venv, dst), value), tail)
        IrNilI64(dst) -> IrInstCons(ir_inst_nil_i64(pipeline_ir_multi_map_value(venv, dst)), tail)
        IrBinaryI64(dst, op, lhs, rhs) -> IrInstCons(ir_inst_binary_i64(pipeline_ir_multi_map_value(venv, dst), op, pipeline_ir_multi_map_value(venv, lhs), pipeline_ir_multi_map_value(venv, rhs)), tail)
        IrFloatBinaryI64(dst, prim, op, lhs, rhs) -> IrInstCons(ir_inst_float_binary_i64(pipeline_ir_multi_map_value(venv, dst), prim, op, pipeline_ir_multi_map_value(venv, lhs), pipeline_ir_multi_map_value(venv, rhs)), tail)
        IrUnaryI64(dst, op, value) -> IrInstCons(ir_inst_unary_i64(pipeline_ir_multi_map_value(venv, dst), op, pipeline_ir_multi_map_value(venv, value)), tail)
        IrPtrLoadI64(dst, ptr) -> IrInstCons(ir_inst_ptr_load_i64(pipeline_ir_multi_map_value(venv, dst), pipeline_ir_multi_map_value(venv, ptr)), tail)
        IrBindI64(ns, nl, value, ty) -> tail
        IrLoweringFailureI64(reason) -> IrInstCons(inst, tail)
        IrCallI64(dst, callee_hash, args) -> IrInstCons(ir_inst_call_i64(pipeline_ir_multi_map_value(venv, dst), callee_hash, pipeline_ir_multi_map_values(args, venv)), tail)
        IrManagedStakeI64(dst, value, cleanup_kind, delta, origin) -> IrInstCons(IrManagedStakeI64(pipeline_ir_multi_map_value(venv, dst), pipeline_ir_multi_map_value(venv, value), cleanup_kind, delta, origin), tail)
        IrSlotI64(slot) -> {
          -- The borrowed-param-mask marker describes the callee's own
          -- parameter contract; it dissolves with the call boundary.
          if pipeline_ir_multi_slot_is_marker(slot) == 1 { tail }
          else { IrInstCons(ir_inst_slot_i64(pipeline_ir_multi_map_value(venv, slot)), tail) }
        }
        IrLoadI64(dst, slot) -> IrInstCons(ir_inst_load_i64(pipeline_ir_multi_map_value(venv, dst), pipeline_ir_multi_map_value(venv, slot)), tail)
        IrStoreI64(slot, value) -> IrInstCons(ir_inst_store_i64(pipeline_ir_multi_map_value(venv, slot), pipeline_ir_multi_map_value(venv, value)), tail)
        IrVariantInitI64(dst, tag_hash, payloads, field_mask) -> IrInstCons(IrVariantInitI64(pipeline_ir_multi_map_value(venv, dst), tag_hash, pipeline_ir_multi_map_values(payloads, venv), field_mask), tail)
        IrVariantTagI64(dst, value) -> IrInstCons(ir_inst_variant_tag_i64(pipeline_ir_multi_map_value(venv, dst), pipeline_ir_multi_map_value(venv, value)), tail)
        IrVariantPayloadI64(dst, value, index) -> IrInstCons(ir_inst_variant_payload_i64(pipeline_ir_multi_map_value(venv, dst), pipeline_ir_multi_map_value(venv, value), index), tail)
        IrRecordLayoutWordLoadI64(dst, base, record_data_size, field_hash, byte_offset) -> IrInstCons(IrRecordLayoutWordLoadI64(pipeline_ir_multi_map_value(venv, dst), pipeline_ir_multi_map_value(venv, base), record_data_size, field_hash, byte_offset), tail)
        IrFieldLoadI64(dst, base, field_hash, field_index) -> IrInstCons(IrFieldLoadI64(pipeline_ir_multi_map_value(venv, dst), pipeline_ir_multi_map_value(venv, base), field_hash, field_index), tail)
        IrVectorGetI64(dst, vec, index, fallback, check_mode) -> IrInstCons(ir_inst_vector_get_i64(pipeline_ir_multi_map_value(venv, dst), pipeline_ir_multi_map_value(venv, vec), pipeline_ir_multi_map_value(venv, index), pipeline_ir_multi_map_value(venv, fallback), check_mode), tail)
        IrVectorSetI64(dst, vec, index, value, check_mode) -> IrInstCons(ir_inst_vector_set_i64(pipeline_ir_multi_map_value(venv, dst), pipeline_ir_multi_map_value(venv, vec), pipeline_ir_multi_map_value(venv, index), pipeline_ir_multi_map_value(venv, value), check_mode), tail)
        IrGenericCallI64(dst, callee_hash, type_args, args) -> IrInstCons(IrGenericCallI64(pipeline_ir_multi_map_value(venv, dst), callee_hash, type_args, pipeline_ir_multi_map_values(args, venv)), tail)
        IrMethodCallI64(dst, type_hash, method_hash, receiver, args) -> IrInstCons(IrMethodCallI64(pipeline_ir_multi_map_value(venv, dst), type_hash, method_hash, pipeline_ir_multi_map_value(venv, receiver), pipeline_ir_multi_map_values(args, venv)), tail)
        _ -> tail
      }
    }
  }
}

-- return_args = 1 keeps the parameter-passing continuation (needed when
-- the candidate has several return sites); return_args = 0 emits a bare
-- jump — the caller has bound the single return value directly onto the
-- call's dst. A single-predecessor block PARAMETER is the shape the
-- fold's chain collapse mishandles (use-before-def after merging), so
-- single-return candidates avoid it entirely.
pub(package) fn pipeline_ir_multi_clone_term(term: IrTerminator, venv: PipelineIrInlineValueEnv, benv: PipelineIrInlineValueEnv, cont_block: i64, return_args: i64) -> IrTerminator {
  match term {
    IrTermReturn(value) -> {
      if return_args == 1 {
        ir_term_jump_args(cont_block, IrValueCons(pipeline_ir_multi_map_value(venv, value), IrValueNil))
      } else {
        ir_term_jump(cont_block)
      }
    }
    IrTermJump(target, args) -> ir_term_jump_args(pipeline_ir_multi_map_value(benv, target), pipeline_ir_multi_map_values(args, venv))
    IrTermBranch(cond, then_target, else_target) -> ir_term_branch(pipeline_ir_multi_map_value(venv, cond), pipeline_ir_multi_map_value(benv, then_target), pipeline_ir_multi_map_value(benv, else_target))
    IrTermUnreachable -> IrTermUnreachable
    IrTermNone -> IrTermNone
  }
}

pub(package) fn pipeline_ir_multi_return_count(blocks: IrBlockList) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      let one = match block {
        IrBlock(id, params, insts, term) -> {
          match term {
            IrTermReturn(value) -> 1
            _ -> 0
          }
        }
      }
      one + pipeline_ir_multi_return_count(rest)
    }
  }
}

pub(package) fn pipeline_ir_multi_single_return_value(blocks: IrBlockList) -> i64 {
  match blocks {
    IrBlockListNil -> 0 - 1
    IrBlockListCons(block, rest) -> {
      let one = match block {
        IrBlock(id, params, insts, term) -> {
          match term {
            IrTermReturn(value) -> value
            _ -> 0 - 1
          }
        }
      }
      if one >= 0 { one } else { pipeline_ir_multi_single_return_value(rest) }
    }
  }
}

pub(package) fn pipeline_ir_multi_clone_blocks(blocks: IrBlockList, venv: PipelineIrInlineValueEnv, benv: PipelineIrInlineValueEnv, cont_block: i64, return_args: i64) -> IrBlockList {
  match blocks {
    IrBlockListNil -> IrBlockListNil
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          IrBlockListCons(
            ir_block_new_params(
              pipeline_ir_multi_map_value(benv, id),
              pipeline_ir_multi_map_values(params, venv),
              pipeline_ir_multi_clone_insts(insts, venv),
              pipeline_ir_multi_clone_term(term, venv, benv, cont_block, return_args)
            ),
            pipeline_ir_multi_clone_blocks(rest, venv, benv, cont_block, return_args)
          )
        }
      }
    }
  }
}

-- Split result: found flag, reversed prefix insts, call fields, suffix.
pub(package) type PipelineIrMultiSplit {
  PipelineIrMultiSplit(i64, IrInstList, i64, i64, IrValueList, IrInstList)
}

pub(package) fn pipeline_ir_multi_split_insts(insts: IrInstList, candidates: PipelineIrInlineCandidateList, self_hash: i64, prefix: IrInstList, tt: i64) -> PipelineIrMultiSplit {
  match insts {
    IrInstNil -> PipelineIrMultiSplit(0, prefix, 0, 0, IrValueNil, IrInstNil)
    IrInstCons(inst, rest) -> {
      match inst {
        IrCallI64(dst, callee_hash, args) -> {
          if callee_hash != self_hash {
            match pipeline_ir_inline_candidate_lookup(candidates, callee_hash) {
              IrFunctionNil -> pipeline_ir_multi_split_insts(rest, candidates, self_hash, IrInstCons(inst, prefix), tt)
              IrFunctionCons(cf, crest) -> PipelineIrMultiSplit(1, prefix, dst, callee_hash, args, rest)
            }
          } else {
            pipeline_ir_multi_split_insts(rest, candidates, self_hash, IrInstCons(inst, prefix), tt)
          }
        }
        -- Generic call sites resolve to their specialisation's hash: the
        -- collected spec IrFunction is the candidate body. Emission-
        -- intercepted sites are opaque: the backend substitutes per-spec
        -- constants (element size/mode) or byte-accurate inline-record
        -- code — splicing the collected spec body there wires in the
        -- placeholder/word-generic semantics instead (the 1-block
        -- miswire: element mode 0 on managed vectors; word loads on
        -- packed inline records).
        IrGenericCallI64(dst, callee_hash, type_args, args) -> {
          let spec_hash = mono_spec_hash(callee_hash, type_expr_list_to_nodes(type_args))
          if spec_hash != self_hash and pipeline_ir_native_generic_call_emission_intercepted(callee_hash, type_args, args, tt) == 0 {
            match pipeline_ir_inline_candidate_lookup(candidates, spec_hash) {
              IrFunctionNil -> pipeline_ir_multi_split_insts(rest, candidates, self_hash, IrInstCons(inst, prefix), tt)
              IrFunctionCons(cf, crest) -> PipelineIrMultiSplit(1, prefix, dst, spec_hash, args, rest)
            }
          } else {
            pipeline_ir_multi_split_insts(rest, candidates, self_hash, IrInstCons(inst, prefix), tt)
          }
        }
        -- A resolved inherent method call already carries its exact native
        -- owner and method identity. Rebuild the ordinary ABI argument list
        -- from the receiver's first lane plus the stored tail and splice the
        -- same declaration-keyed candidate as a direct call.
        IrMethodCallI64(dst, type_hash, method_hash, receiver, args) -> {
          let callee_hash = pipeline_ir_method_patch_key(type_hash, method_hash)
          if callee_hash != self_hash {
            match pipeline_ir_inline_candidate_lookup(candidates, callee_hash) {
              IrFunctionNil -> pipeline_ir_multi_split_insts(rest, candidates, self_hash, IrInstCons(inst, prefix), tt)
              IrFunctionCons(cf, crest) -> PipelineIrMultiSplit(1, prefix, dst, callee_hash, IrValueCons(receiver, args), rest)
            }
          } else {
            pipeline_ir_multi_split_insts(rest, candidates, self_hash, IrInstCons(inst, prefix), tt)
          }
        }
        _ -> pipeline_ir_multi_split_insts(rest, candidates, self_hash, IrInstCons(inst, prefix), tt)
      }
    }
  }
}

pub(package) fn pipeline_ir_multi_split_found(split: PipelineIrMultiSplit) -> i64 {
  match split { PipelineIrMultiSplit(found, prefix, dst, callee_hash, args, suffix) -> found }
}

pub(package) fn pipeline_ir_inst_list_reverse_onto(insts: IrInstList, acc: IrInstList) -> IrInstList {
  match insts {
    IrInstNil -> acc
    IrInstCons(inst, rest) -> pipeline_ir_inst_list_reverse_onto(rest, IrInstCons(inst, acc))
  }
}

pub(package) fn pipeline_ir_block_list_max_id(blocks: IrBlockList, current: i64) -> i64 {
  match blocks {
    IrBlockListNil -> current
    IrBlockListCons(block, rest) -> {
      let one = match block {
        IrBlock(id, params, insts, term) -> if id > current { id } else { current }
      }
      pipeline_ir_block_list_max_id(rest, one)
    }
  }
}

-- ----------------------------------------------------------------------
-- Loop residency for splice gating: a block is loop-resident when it can
-- reach itself through the CFG. Splicing pays where calls repeat — loop
-- bodies — while cold straight-line sites keep their (cheap, one-shot)
-- calls, which is what contains the optimiser cost on enlarged hosts.
-- Small hosts (at most the candidate block cap) splice everywhere so
-- wrapper bodies still swallow their branchy callees and become
-- candidates themselves. Computed once on the raw host; blocks created
-- by a splice inherit the residency of the site they came from.
-- ----------------------------------------------------------------------

pub(package) fn pipeline_ir_multi_loop_cap() -> i64 { 128 }

pub(package) fn pipeline_ir_multi_succ_push(stack: i64, target: i64, visited: i64, n: i64) -> i64 {
  if target >= 0 and target < n and nlist_get(visited, target) == 0 {
    nlist_add(stack, target)
    pipeline_ir_native_resident_dense_set(visited, target, 1)
  } else { 0 }
}

-- Marks every block on a cycle: BFS from each block's successors; the
-- block is resident when the walk returns to it.
pub(package) fn pipeline_ir_multi_loop_resident_env(blocks: IrBlockList) -> PipelineIrInlineValueEnv {
  let max_id = pipeline_ir_block_list_max_id(blocks, 0 - 1)
  if max_id < 0 or max_id + 1 > pipeline_ir_multi_loop_cap() { PipelineIrInlineValueEnvNil }
  else {
    let n = max_id + 1
    -- successor table: two slots per block (jump/branch targets)
    let succ_a = pipeline_ir_native_resident_dense_new(n, 0 - 1)
    let succ_b = pipeline_ir_native_resident_dense_new(n, 0 - 1)
    let mut cur = blocks
    let mut walking = 1
    while walking == 1 {
      match cur {
        IrBlockListNil -> { walking = 0 }
        IrBlockListCons(block, rest) -> {
          match block {
            IrBlock(id, params, insts, term) -> {
              if id >= 0 and id < n {
                match term {
                  IrTermJump(target, args) -> pipeline_ir_native_resident_dense_set(succ_a, id, target)
                  IrTermBranch(cond, then_block, else_block) -> {
                    pipeline_ir_native_resident_dense_set(succ_a, id, then_block)
                    pipeline_ir_native_resident_dense_set(succ_b, id, else_block)
                  }
                  _ -> 0
                }
              } else { 0 }
            }
          }
          cur = rest
        }
      }
    }
    let mut env = PipelineIrInlineValueEnvNil
    let mut s = 0
    while s < n {
      -- BFS from s's successors; resident when s is reached again
      let visited = pipeline_ir_native_resident_dense_new(n, 0)
      let stack = nlist_new()
      pipeline_ir_multi_succ_push(stack, nlist_get(succ_a, s), visited, n)
      pipeline_ir_multi_succ_push(stack, nlist_get(succ_b, s), visited, n)
      let mut hit = 0
      while nlist_len(stack) > 0 and hit == 0 {
        let top = nlist_get(stack, nlist_len(stack) - 1)
        nlist_set_len(stack, nlist_len(stack) - 1)
        if top == s { hit = 1 }
        else {
          pipeline_ir_multi_succ_push(stack, nlist_get(succ_a, top), visited, n)
          pipeline_ir_multi_succ_push(stack, nlist_get(succ_b, top), visited, n)
        }
      }
      if hit == 1 { env = pipeline_ir_inline_value_env_bind(env, s, 1) } else { 0 }
      s = s + 1
    }
    env
  }
}

-- Pass state: changed flag, rebuilt blocks, next value id, next block id.
pub(package) type PipelineIrMultiPassResult {
  PipelineIrMultiPassResult(i64, IrBlockList, i64, i64)
}

pub(package) fn pipeline_ir_multi_pass_changed(r: PipelineIrMultiPassResult) -> i64 {
  match r { PipelineIrMultiPassResult(changed, blocks, next_value, next_block) -> changed }
}

pub(package) fn pipeline_ir_multi_pass_blocks(r: PipelineIrMultiPassResult) -> IrBlockList {
  match r { PipelineIrMultiPassResult(changed, blocks, next_value, next_block) -> blocks }
}

pub(package) fn pipeline_ir_multi_pass_next_value(r: PipelineIrMultiPassResult) -> i64 {
  match r { PipelineIrMultiPassResult(changed, blocks, next_value, next_block) -> next_value }
}

pub(package) fn pipeline_ir_multi_pass_next_block(r: PipelineIrMultiPassResult) -> i64 {
  match r { PipelineIrMultiPassResult(changed, blocks, next_value, next_block) -> next_block }
}

-- Splice one candidate call found in the given host block. Returns the
-- replacement blocks (host head, callee clones, continuation) or an
-- unchanged result when the clone is not self-contained.
pub(package) fn pipeline_ir_multi_splice_block(host: IrBlock, split: PipelineIrMultiSplit, candidates: PipelineIrInlineCandidateList, next_value: i64, next_block: i64) -> PipelineIrMultiPassResult {
  match host {
    IrBlock(host_id, host_params, host_insts, host_term) -> {
      match split {
        PipelineIrMultiSplit(found, rev_prefix, dst, callee_hash, args, suffix) -> {
          match pipeline_ir_inline_candidate_lookup(candidates, callee_hash) {
            IrFunctionNil -> PipelineIrMultiPassResult(0, IrBlockListCons(host, IrBlockListNil), next_value, next_block)
            IrFunctionCons(callee, crest) -> {
              match callee {
                IrFunction(chash, cparam_count, cblocks, csrc) -> {
                  if ir_value_list_len(args) != cparam_count {
                    PipelineIrMultiPassResult(0, IrBlockListCons(host, IrBlockListNil), next_value, next_block)
                  } else {
                    let cont_block = next_block
                    let arg_env = pipeline_ir_inline_arg_env(args, 0, PipelineIrInlineValueEnvNil)
                    let seeded = PipelineIrMultiCloneCtx(arg_env, next_value, PipelineIrInlineValueEnvNil, next_block + 1)
                    let ctx = pipeline_ir_multi_defs_blocks(cblocks, seeded)
                    let venv = pipeline_ir_multi_clone_ctx_venv(ctx)
                    let benv = pipeline_ir_multi_clone_ctx_benv(ctx)
                    if pipeline_ir_multi_uses_bound_blocks(cblocks, venv) == 0 {
                      PipelineIrMultiPassResult(0, IrBlockListCons(host, IrBlockListNil), next_value, next_block)
                    } else {
                      let entry_target = pipeline_ir_inline_value_env_lookup_or(benv, ir_block_id(pipeline_ir_block_list_first(cblocks)), 0 - 1)
                      if entry_target < 0 {
                        PipelineIrMultiPassResult(0, IrBlockListCons(host, IrBlockListNil), next_value, next_block)
                      } else {
                        let head = ir_block_new_params(host_id, host_params, pipeline_ir_inst_list_reverse_onto(rev_prefix, IrInstNil), ir_term_jump(entry_target))
                        let ret_count = pipeline_ir_multi_return_count(cblocks)
                        let ret_value = pipeline_ir_multi_single_return_value(cblocks)
                        if ret_count == 1 and ret_value >= cparam_count {
                          -- Single local return: bind the return value straight
                          -- onto the call's dst (the shadowing prepend wins over
                          -- the fresh id from the defs pass) and keep the
                          -- continuation parameterless.
                          let bound = pipeline_ir_inline_value_env_bind(venv, ret_value, dst)
                          let clones = pipeline_ir_multi_clone_blocks(cblocks, bound, benv, cont_block, 0)
                          let cont = ir_block_new_params(cont_block, IrValueNil, suffix, host_term)
                          PipelineIrMultiPassResult(
                            1,
                            IrBlockListCons(head, ir_block_list_append(clones, IrBlockListCons(cont, IrBlockListNil))),
                            pipeline_ir_multi_clone_ctx_next_value(ctx),
                            pipeline_ir_multi_clone_ctx_next_block(ctx)
                          )
                        } else { if ret_count == 1 {
                          -- Single return of a callee parameter: define dst in
                          -- the continuation as arg + 0 (the algebraic fold
                          -- collapses the identity add into an alias).
                          let arg = pipeline_ir_inline_value_env_lookup_or(venv, ret_value, 0 - 1)
                          if arg < 0 {
                            PipelineIrMultiPassResult(0, IrBlockListCons(host, IrBlockListNil), next_value, next_block)
                          } else {
                            let zero_id = pipeline_ir_multi_clone_ctx_next_value(ctx)
                            let clones = pipeline_ir_multi_clone_blocks(cblocks, venv, benv, cont_block, 0)
                            let cont_insts = IrInstCons(
                              ir_inst_const_i64(zero_id, 0),
                              IrInstCons(ir_inst_binary_i64(dst, ir_binary_op_from_parser(1), arg, zero_id), suffix)
                            )
                            let cont = ir_block_new_params(cont_block, IrValueNil, cont_insts, host_term)
                            PipelineIrMultiPassResult(
                              1,
                              IrBlockListCons(head, ir_block_list_append(clones, IrBlockListCons(cont, IrBlockListNil))),
                              zero_id + 1,
                              pipeline_ir_multi_clone_ctx_next_block(ctx)
                            )
                          }
                        } else {
                          let clones = pipeline_ir_multi_clone_blocks(cblocks, venv, benv, cont_block, 1)
                          let cont = ir_block_new_params(cont_block, IrValueCons(dst, IrValueNil), suffix, host_term)
                          PipelineIrMultiPassResult(
                            1,
                            IrBlockListCons(head, ir_block_list_append(clones, IrBlockListCons(cont, IrBlockListNil))),
                            pipeline_ir_multi_clone_ctx_next_value(ctx),
                            pipeline_ir_multi_clone_ctx_next_block(ctx)
                          )
                        } }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

pub(package) fn pipeline_ir_block_list_first(blocks: IrBlockList) -> IrBlock {
  match blocks {
    IrBlockListNil -> ir_block_new(0 - 1, ir_inst_list_empty())
    IrBlockListCons(block, rest) -> block
  }
}

pub(package) fn pipeline_ir_dense_table_call_insts(insts: IrInstList, facts: PipelineIrSemanticFactList) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let role = match inst {
        IrCallI64(dst, callee_hash, args) -> pipeline_ir_semantic_fact_lookup_dense_table_role(facts, callee_hash)
        IrMethodCallI64(dst, type_hash, method_hash, receiver, args) -> pipeline_ir_semantic_fact_lookup_dense_table_role(facts, pipeline_ir_method_patch_key(type_hash, method_hash))
        _ -> cg_semantic_dense_table_role_none()
      }
      if role != cg_semantic_dense_table_role_none() { 1 } else { pipeline_ir_dense_table_call_insts(rest, facts) }
    }
  }
}

pub(package) fn pipeline_ir_dense_table_call_blocks(blocks: IrBlockList, facts: PipelineIrSemanticFactList) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(IrBlock(id, params, insts, term), rest) -> {
      if pipeline_ir_dense_table_call_insts(insts, facts) == 1 { 1 } else { pipeline_ir_dense_table_call_blocks(rest, facts) }
    }
  }
}

-- One sweep: rewrite the first block containing a candidate call.
-- gate_all = 1 splices every block (small hosts); otherwise only blocks
-- present in the residency env split.
pub(package) fn pipeline_ir_multi_inline_sweep(blocks: IrBlockList, candidates: PipelineIrInlineCandidateList, self_hash: i64, next_value: i64, next_block: i64, gate_all: i64, resident: PipelineIrInlineValueEnv, tt: i64) -> PipelineIrMultiPassResult {
  match blocks {
    IrBlockListNil -> PipelineIrMultiPassResult(0, IrBlockListNil, next_value, next_block)
    IrBlockListCons(block, rest) -> {
      let hot = match block {
        IrBlock(id, params, insts, term) -> {
          if gate_all == 1 { 1 } else { pipeline_ir_inline_value_env_lookup_or(resident, id, 0) }
        }
      }
      let split = if hot == 1 {
        match block {
          IrBlock(id, params, insts, term) -> pipeline_ir_multi_split_insts(insts, candidates, self_hash, IrInstNil, tt)
        }
      } else {
        PipelineIrMultiSplit(0, IrInstNil, 0, 0, IrValueNil, IrInstNil)
      }
      if pipeline_ir_multi_split_found(split) == 1 {
        let spliced = pipeline_ir_multi_splice_block(block, split, candidates, next_value, next_block)
        if pipeline_ir_multi_pass_changed(spliced) == 1 {
          PipelineIrMultiPassResult(
            1,
            ir_block_list_append(pipeline_ir_multi_pass_blocks(spliced), rest),
            pipeline_ir_multi_pass_next_value(spliced),
            pipeline_ir_multi_pass_next_block(spliced)
          )
        } else {
          let tail = pipeline_ir_multi_inline_sweep(rest, candidates, self_hash, next_value, next_block, gate_all, resident, tt)
          PipelineIrMultiPassResult(
            pipeline_ir_multi_pass_changed(tail),
            IrBlockListCons(block, pipeline_ir_multi_pass_blocks(tail)),
            pipeline_ir_multi_pass_next_value(tail),
            pipeline_ir_multi_pass_next_block(tail)
          )
        }
      } else {
        let tail = pipeline_ir_multi_inline_sweep(rest, candidates, self_hash, next_value, next_block, gate_all, resident, tt)
        PipelineIrMultiPassResult(
          pipeline_ir_multi_pass_changed(tail),
          IrBlockListCons(block, pipeline_ir_multi_pass_blocks(tail)),
          pipeline_ir_multi_pass_next_value(tail),
          pipeline_ir_multi_pass_next_block(tail)
        )
      }
    }
  }
}

-- Function-level driver: splice until no candidate calls remain or the
-- site cap bounds growth (mutual-recursion backstop). Returns via the
-- pass-result shape: changed carries the site count.
pub(package) fn pipeline_ir_multi_inline_function_blocks(self_hash: i64, param_count: i64, blocks: IrBlockList, candidates: PipelineIrInlineCandidateList, facts: PipelineIrSemanticFactList, tt: i64) -> PipelineIrMultiPassResult {
  match candidates {
    PipelineIrInlineCandidateNil -> PipelineIrMultiPassResult(0, blocks, pipeline_ir_function_next_value(param_count, blocks), pipeline_ir_block_list_max_id(blocks, 0) + 1)
    PipelineIrInlineCandidateNode(chash, cf, clower, chigher) -> {
      -- Small hosts splice everywhere (cheap, and wrapper bodies must
      -- still swallow their branchy callees to become candidates);
      -- larger hosts splice only loop-resident sites. Blocks a splice
      -- creates inherit the (resident) site's eligibility.
      let has_dense_table_call = pipeline_ir_dense_table_call_blocks(blocks, facts)
      let gate_all = if ir_block_list_len(blocks) <= pipeline_ir_multi_inline_blocks_cap() or has_dense_table_call == 1 { 1 } else { 0 }
      let site_cap = if has_dense_table_call == 1 { pipeline_ir_multi_inline_dense_table_site_cap() } else { pipeline_ir_multi_inline_site_cap() }
      let mut resident = if gate_all == 1 { PipelineIrInlineValueEnvNil } else { pipeline_ir_multi_loop_resident_env(blocks) }
      let mut current = blocks
      let mut next_value = pipeline_ir_function_next_value(param_count, blocks)
      let mut next_block = pipeline_ir_block_list_max_id(blocks, 0) + 1
      let mut sites = 0
      let mut go = 1
      while go == 1 and sites < site_cap {
        let swept = pipeline_ir_multi_inline_sweep(current, candidates, self_hash, next_value, next_block, gate_all, resident, tt)
        if pipeline_ir_multi_pass_changed(swept) == 1 {
          current = pipeline_ir_multi_pass_blocks(swept)
          next_value = pipeline_ir_multi_pass_next_value(swept)
          let new_next_block = pipeline_ir_multi_pass_next_block(swept)
          let mut nb = next_block
          while nb < new_next_block {
            resident = pipeline_ir_inline_value_env_bind(resident, nb, 1)
            nb = nb + 1
          }
          next_block = new_next_block
          sites = sites + 1
        } else {
          go = 0
        }
      }
      PipelineIrMultiPassResult(sites, current, next_value, next_block)
    }
  }
}

pub(package) fn pipeline_ir_inst_preserves_pure_call_cse(inst: IrInst, facts: PipelineIrSemanticFactList) -> i64 {
  match inst {
    IrConstI64(dst, value) -> 1
    IrNilI64(dst) -> 1
    IrBinaryI64(dst, op, lhs, rhs) -> 1
    IrFloatBinaryI64(dst, prim, op, lhs, rhs) -> 1
    IrUnaryI64(dst, op, value) -> 1
    IrCallI64(dst, callee_hash, args) -> pipeline_ir_semantic_fact_lookup_pure_nonconsuming_scalar_result(facts, callee_hash)
    _ -> 0
  }
}

pub(package) fn pipeline_ir_vector_check_mode_add(check_mode: i64, bit: i64) -> i64 {
  check_mode bor bit
}

pub(package) fn pipeline_ir_indexed_address_value_const(value_defs: i64, env: PipelineIrConstEnv, aliases: PipelineIrAliasEnv, value: i64) -> PipelineIrConstLookup {
  let local = pipeline_ir_const_env_lookup_alias(env, aliases, value)
  if pipeline_ir_const_lookup_valid(local) == 1 { local }
  else {
    let direct = pipeline_ir_value_def_lookup(value_defs, value)
    if direct != 0 and node_f1(direct) == 1 { pipeline_ir_const_lookup(1, node_f2(direct)) }
    else {
      let canonical = pipeline_ir_value_def_lookup(value_defs, pipeline_ir_alias_env_lookup_or(aliases, value))
      if canonical != 0 and node_f1(canonical) == 1 { pipeline_ir_const_lookup(1, node_f2(canonical)) }
      else { pipeline_ir_const_lookup(0, 0) }
    }
  }
}

pub(package) fn pipeline_ir_indexed_address_upper_bound_proven(block_id: i64, block_facts: PipelineIrBlockEntryFactChain, value_defs: i64, env: PipelineIrConstEnv, aliases: PipelineIrAliasEnv, len_value: i64, index_value: i64) -> i64 {
  let known_len = pipeline_ir_indexed_address_value_const(value_defs, env, aliases, len_value)
  let known_index = pipeline_ir_indexed_address_value_const(value_defs, env, aliases, index_value)
  if pipeline_ir_const_lookup_valid(known_len) == 1 and pipeline_ir_const_lookup_valid(known_index) == 1 and pipeline_ir_const_lookup_value(known_len) >= 0 and pipeline_ir_const_lookup_value(known_index) >= 0 and pipeline_ir_const_lookup_value(known_index) < pipeline_ir_const_lookup_value(known_len) {
    1
  } else {
    let length_key = pipeline_ir_indexed_length_key(len_value, known_len)
    if pipeline_ir_block_entry_indexed_upper_fact_lookup_chain(block_facts, block_id, index_value, length_key) == 1 { 1 }
    else {
      let canonical_index = pipeline_ir_alias_env_lookup_or(aliases, index_value)
      if canonical_index == index_value { 0 }
      else { pipeline_ir_block_entry_indexed_upper_fact_lookup_chain(block_facts, block_id, canonical_index, length_key) }
    }
  }
}

pub(package) fn pipeline_ir_indexed_address_tightened_check_mode(block_id: i64, block_facts: PipelineIrBlockEntryFactChain, value_defs: i64, env: PipelineIrConstEnv, aliases: PipelineIrAliasEnv, len_value: i64, index_value: i64, check_mode: i64) -> i64 {
  -- The helper ABI admits only usize indices, so lower-bound proof is a typed
  -- fact rather than a local comparison rediscovered by codegen.
  let lower_mode = pipeline_ir_vector_check_mode_add(check_mode, pipeline_ir_vector_check_lower_bound_bit())
  if pipeline_ir_indexed_address_upper_bound_proven(block_id, block_facts, value_defs, env, aliases, len_value, index_value) == 1 {
    pipeline_ir_vector_check_mode_add(lower_mode, pipeline_ir_vector_check_upper_bound_bit())
  } else {
    lower_mode
  }
}

pub(package) fn pipeline_ir_indexed_address_upper_or_equal_proven(block_id: i64, block_facts: PipelineIrBlockEntryFactChain, value_defs: i64, env: PipelineIrConstEnv, aliases: PipelineIrAliasEnv, upper_value: i64, lower_value: i64) -> i64 {
  let canonical_upper = pipeline_ir_alias_env_lookup_or(aliases, upper_value)
  let canonical_lower = pipeline_ir_alias_env_lookup_or(aliases, lower_value)
  if canonical_upper == canonical_lower { 1 }
  else {
    let known_upper = pipeline_ir_indexed_address_value_const(value_defs, env, aliases, upper_value)
    let known_lower = pipeline_ir_indexed_address_value_const(value_defs, env, aliases, lower_value)
    if pipeline_ir_const_lookup_valid(known_upper) == 1 and pipeline_ir_const_lookup_valid(known_lower) == 1 and pipeline_ir_const_lookup_value(known_upper) >= 0 and pipeline_ir_const_lookup_value(known_lower) >= 0 and pipeline_ir_const_lookup_value(known_lower) <= pipeline_ir_const_lookup_value(known_upper) { 1 }
    else {
      let upper_key = pipeline_ir_indexed_length_key(upper_value, known_upper)
      let canonical_upper_key = pipeline_ir_indexed_length_key(canonical_upper, known_upper)
      if pipeline_ir_block_entry_indexed_upper_or_equal_fact_lookup_chain(block_facts, block_id, lower_value, upper_key) == 1 or pipeline_ir_block_entry_indexed_upper_or_equal_fact_lookup_chain(block_facts, block_id, canonical_lower, upper_key) == 1 or pipeline_ir_block_entry_indexed_upper_or_equal_fact_lookup_chain(block_facts, block_id, lower_value, canonical_upper_key) == 1 or pipeline_ir_block_entry_indexed_upper_or_equal_fact_lookup_chain(block_facts, block_id, canonical_lower, canonical_upper_key) == 1 { 1 }
      else { pipeline_ir_indexed_address_upper_bound_proven(block_id, block_facts, value_defs, env, aliases, upper_value, lower_value) }
    }
  }
}

pub(package) fn pipeline_ir_slice_address_tightened_check_mode(block_id: i64, block_facts: PipelineIrBlockEntryFactChain, value_defs: i64, env: PipelineIrConstEnv, aliases: PipelineIrAliasEnv, len_value: i64, start_value: i64, end_value: i64, check_mode: i64) -> i64 {
  let order_mode = if pipeline_ir_indexed_address_upper_or_equal_proven(block_id, block_facts, value_defs, env, aliases, end_value, start_value) == 1 {
    pipeline_ir_vector_check_mode_add(check_mode, pipeline_ir_vector_check_lower_bound_bit())
  } else { check_mode }
  if pipeline_ir_indexed_address_upper_or_equal_proven(block_id, block_facts, value_defs, env, aliases, len_value, end_value) == 1 {
    pipeline_ir_vector_check_mode_add(order_mode, pipeline_ir_vector_check_upper_bound_bit())
  } else { order_mode }
}

pub(package) fn pipeline_ir_vector_index_slot(block_id: i64, local_facts: PipelineIrLocalFactEnv, index: i64) -> PipelineIrConstLookup {
  let slot = pipeline_ir_load_slot_env_lookup(pipeline_ir_local_fact_env_load_slots(local_facts), index)
  if pipeline_ir_const_lookup_valid(slot) == 1 and pipeline_ir_killed_slot_env_contains(pipeline_ir_local_fact_env_killed_slots(local_facts), pipeline_ir_const_lookup_value(slot)) == 0 {
    slot
  } else {
    pipeline_ir_const_lookup(0, 0)
  }
}

pub(package) fn pipeline_ir_vector_index_lower_bound_proven(block_id: i64, block_facts: PipelineIrBlockEntryFactChain, env: PipelineIrConstEnv, local_facts: PipelineIrLocalFactEnv, index: i64) -> i64 {
  if pipeline_ir_nonneg_env_contains(pipeline_ir_local_fact_env_nonneg(local_facts), index) == 1 { 1 }
  else { pipeline_ir_vector_index_lower_bound_proven_base(block_id, block_facts, env, local_facts, index) }
}

pub(package) fn pipeline_ir_vector_index_lower_bound_proven_base(block_id: i64, block_facts: PipelineIrBlockEntryFactChain, env: PipelineIrConstEnv, local_facts: PipelineIrLocalFactEnv, index: i64) -> i64 {
  let known_const = pipeline_ir_const_env_lookup(env, index)
  if pipeline_ir_const_lookup_valid(known_const) == 1 and pipeline_ir_const_lookup_value(known_const) >= 0 {
    1
  } else {
    let known_nonnegative = pipeline_ir_block_entry_nonnegative_fact_lookup_chain(block_facts, block_id, index)
    if pipeline_ir_const_lookup_valid(known_nonnegative) == 1 and pipeline_ir_const_lookup_value(known_nonnegative) == 1 {
      1
    } else {
      let known_zero = pipeline_ir_block_entry_zero_fact_lookup_chain(block_facts, block_id, index)
      if pipeline_ir_const_lookup_valid(known_zero) == 1 and pipeline_ir_const_lookup_value(known_zero) == 1 {
        1
      } else {
        let slot = pipeline_ir_vector_index_slot(block_id, local_facts, index)
        if pipeline_ir_const_lookup_valid(slot) == 1 {
          let slot_nonnegative = pipeline_ir_block_entry_slot_scalar_fact_lookup_chain(block_facts, block_id, pipeline_ir_const_lookup_value(slot), pipeline_ir_scalar_fact_kind_nonnegative())
          if pipeline_ir_const_lookup_valid(slot_nonnegative) == 1 and pipeline_ir_const_lookup_value(slot_nonnegative) == 1 {
            1
          } else {
            let slot_zero = pipeline_ir_block_entry_slot_scalar_fact_lookup_chain(block_facts, block_id, pipeline_ir_const_lookup_value(slot), pipeline_ir_scalar_fact_kind_zero())
            if pipeline_ir_const_lookup_valid(slot_zero) == 1 and pipeline_ir_const_lookup_value(slot_zero) == 1 { 1 } else { 0 }
          }
        } else {
          0
        }
      }
    }
  }
}

pub(package) fn pipeline_ir_vector_index_upper_bound_proven(block_id: i64, block_facts: PipelineIrBlockEntryFactChain, local_facts: PipelineIrLocalFactEnv, vec: i64, index: i64) -> i64 {
  if pipeline_ir_block_entry_vector_upper_fact_lookup_chain(block_facts, block_id, vec, index) == 1 {
    1
  } else {
    if pipeline_ir_row_upper_env_headroom(pipeline_ir_local_fact_env_row_upper(local_facts), index, vec) >= 1 {
      1
    } else {
      let slot = pipeline_ir_vector_index_slot(block_id, local_facts, index)
      if pipeline_ir_const_lookup_valid(slot) == 1 {
        pipeline_ir_block_entry_vector_slot_upper_fact_lookup_chain(block_facts, block_id, vec, pipeline_ir_const_lookup_value(slot))
      } else {
        0
      }
    }
  }
}

pub(package) fn pipeline_ir_vector_tightened_check_mode(block_id: i64, block_facts: PipelineIrBlockEntryFactChain, env: PipelineIrConstEnv, local_facts: PipelineIrLocalFactEnv, vec: i64, index: i64, check_mode: i64) -> i64 {
  let known_nil = pipeline_ir_block_entry_nil_fact_lookup_chain(block_facts, block_id, vec)
  let non_null_mode = if pipeline_ir_const_lookup_valid(known_nil) == 1 and pipeline_ir_const_lookup_value(known_nil) == 0 {
    pipeline_ir_vector_check_mode_add(check_mode, pipeline_ir_vector_check_non_null_bit())
  } else {
    check_mode
  }
  let lower_mode = if pipeline_ir_vector_index_lower_bound_proven(block_id, block_facts, env, local_facts, index) == 1 {
    pipeline_ir_vector_check_mode_add(non_null_mode, pipeline_ir_vector_check_lower_bound_bit())
  } else {
    non_null_mode
  }
  -- Upper-bound facts describe the vector's length when the fact was
  -- established; once a shrink-capable instruction has run in this
  -- block they no longer bound the current length.
  if pipeline_ir_local_fact_env_len_killed(local_facts) == 0 and pipeline_ir_vector_index_upper_bound_proven(block_id, block_facts, local_facts, vec, index) == 1 {
    pipeline_ir_vector_check_mode_add(lower_mode, pipeline_ir_vector_check_upper_bound_bit())
  } else {
    lower_mode
  }
}

-- Offset nonnegativity: dst = x + c with 1 <= c <= 4095, x proven
-- nonnegative, and x bounded above by some vector's length — a real
-- length is far below the integer maximum, so the sum cannot wrap. The
-- result is a stable fact about an SSA value; no kill logic applies.
pub(package) fn pipeline_ir_binary_offset_nonneg(block_id: i64, block_facts: PipelineIrBlockEntryFactChain, env: PipelineIrConstEnv, local_facts: PipelineIrLocalFactEnv, op: IrBinaryOp, lhs: i64, rhs: i64, lc: PipelineIrConstLookup, rc: PipelineIrConstLookup) -> i64 {
  if ir_binary_op_tag(op) != 1 { 0 }
  else {
    let x = if pipeline_ir_const_lookup_valid(rc) == 1 { lhs } else { if pipeline_ir_const_lookup_valid(lc) == 1 { rhs } else { 0 - 1 } }
    let c = if pipeline_ir_const_lookup_valid(rc) == 1 { pipeline_ir_const_lookup_value(rc) } else { if pipeline_ir_const_lookup_valid(lc) == 1 { pipeline_ir_const_lookup_value(lc) } else { 0 } }
    if x < 0 or c < 1 or c > 4095 { 0 }
    else {
      if pipeline_ir_vector_index_lower_bound_proven(block_id, block_facts, env, local_facts, x) == 0 { 0 }
      else {
        if pipeline_ir_block_entry_vector_upper_any_lookup_chain(block_facts, block_id, x) == 1 { 1 }
        else {
          let slot = pipeline_ir_vector_index_slot(block_id, local_facts, x)
          if pipeline_ir_const_lookup_valid(slot) == 1 {
            pipeline_ir_block_entry_vector_slot_upper_any_lookup_chain(block_facts, block_id, pipeline_ir_const_lookup_value(slot))
          } else { 0 }
        }
      }
    }
  }
}

-- Scaled-index derivation over the local env.
--   mul: dst = x * w (w const in [1,4095]) with x a live slot load whose
--        slot carries a row-upper fact (load < len(vec)/w) at this
--        block's entry and x proven nonnegative (the quotient bound
--        makes x*w <= len - w, so the product cannot wrap):
--        dst <= len(vec) - w and dst is nonnegative.
--   add: dst = m + f (f const in [0,4095]) with m carrying derived
--        headroom h > f: dst <= len(vec) - (h - f); nonnegative when m
--        is (the length bound keeps the sum far below the maximum).
-- Refused once len facts are killed in this block: entry facts no
-- longer describe the current length.
pub(package) fn pipeline_ir_binary_row_derive(block_id: i64, block_facts: PipelineIrBlockEntryFactChain, env: PipelineIrConstEnv, local_facts: PipelineIrLocalFactEnv, op: IrBinaryOp, lhs: i64, rhs: i64, lc: PipelineIrConstLookup, rc: PipelineIrConstLookup, dst: i64) -> PipelineIrLocalFactEnv {
  if pipeline_ir_local_fact_env_len_killed(local_facts) == 1 { local_facts }
  else {
    let tag = ir_binary_op_tag(op)
    if tag == 3 {
      let x = if pipeline_ir_const_lookup_valid(rc) == 1 { lhs } else { if pipeline_ir_const_lookup_valid(lc) == 1 { rhs } else { 0 - 1 } }
      let w = if pipeline_ir_const_lookup_valid(rc) == 1 { pipeline_ir_const_lookup_value(rc) } else { if pipeline_ir_const_lookup_valid(lc) == 1 { pipeline_ir_const_lookup_value(lc) } else { 0 } }
      if x < 0 or w < 1 or w > 4095 { local_facts }
      else {
        let slot = pipeline_ir_vector_index_slot(block_id, local_facts, x)
        let slot_vec = if pipeline_ir_const_lookup_valid(slot) == 1 {
          pipeline_ir_block_entry_vector_slot_row_upper_vec_chain(block_facts, block_id, w, pipeline_ir_const_lookup_value(slot))
        } else { 0 - 1 }
        if slot_vec >= 0 {
          if pipeline_ir_vector_index_lower_bound_proven(block_id, block_facts, env, local_facts, x) == 0 { local_facts }
          else {
            pipeline_ir_local_fact_env_bind_nonneg(pipeline_ir_local_fact_env_bind_row_upper(local_facts, dst, slot_vec, w), dst)
          }
        } else {
          -- Value-keyed fallback: the fact carries nonnegativity, so no
          -- separate lower-bound proof is needed.
          let value_vec = pipeline_ir_block_entry_vector_row_upper_vec_chain(block_facts, block_id, w, x)
          if value_vec >= 0 {
            pipeline_ir_local_fact_env_bind_nonneg(pipeline_ir_local_fact_env_bind_row_upper(local_facts, dst, value_vec, w), dst)
          } else { local_facts }
        }
      }
    } else {
      if tag == 1 {
        let m = if pipeline_ir_const_lookup_valid(rc) == 1 { lhs } else { if pipeline_ir_const_lookup_valid(lc) == 1 { rhs } else { 0 - 1 } }
        let f = if pipeline_ir_const_lookup_valid(rc) == 1 { pipeline_ir_const_lookup_value(rc) } else { if pipeline_ir_const_lookup_valid(lc) == 1 { pipeline_ir_const_lookup_value(lc) } else { 0 - 1 } }
        if m < 0 or f < 0 or f > 4095 { local_facts }
        else {
          let entry = pipeline_ir_row_upper_env_find(pipeline_ir_local_fact_env_row_upper(local_facts), m)
          if node_f1(entry) == 0 { local_facts }
          else {
            let h = node_f3(entry)
            if f >= h { local_facts }
            else {
              let with_row = pipeline_ir_local_fact_env_bind_row_upper(local_facts, dst, node_f2(entry), h - f)
              if pipeline_ir_nonneg_env_contains(pipeline_ir_local_fact_env_nonneg(local_facts), m) == 1 {
                pipeline_ir_local_fact_env_bind_nonneg(with_row, dst)
              } else { with_row }
            }
          }
        }
      } else { local_facts }
    }
  }
}

-- Shared tail for a binary instruction that no fold rewrote: value-number
-- it against the block's pure-binary table. A hit keeps the instruction
-- (cross-block uses of dst stay defined; DCE sweeps it when dead) and
-- aliases dst to the canonical value so downstream uses share it. A miss
-- records the key and derives the offset/row facts as before.
pub(package) fn pipeline_optimise_ir_binary_unchanged(rewritten: IrInst, dst: i64, op: IrBinaryOp, lhs: i64, rhs: i64, left: PipelineIrConstLookup, right: PipelineIrConstLookup, block_id: i64, block_facts: PipelineIrBlockEntryFactChain, env: PipelineIrConstEnv, aliases: PipelineIrAliasEnv, local_facts: PipelineIrLocalFactEnv, next_value: i64) -> PipelineOptimisedInsts {
  let packed = ir_binary_op_tag(op) * 4 + pipeline_ir_bin_cse_operand_kind(left, lhs) * 2 + pipeline_ir_bin_cse_operand_kind(right, rhs)
  let lval = pipeline_ir_bin_cse_operand_val(left, lhs)
  let rval = pipeline_ir_bin_cse_operand_val(right, rhs)
  let table = pipeline_ir_local_fact_env_bin_cse(local_facts)
  let hit = pipeline_ir_bin_cse_lookup(table, packed, lval, rval)
  if hit >= 0 and hit != dst {
    pipeline_optimised_insts(ir_inst_list_prepend(rewritten, ir_inst_list_empty()), env, pipeline_ir_alias_env_bind(aliases, dst, hit), local_facts, next_value, 0, 0, 0)
  } else {
    let offset_facts = if pipeline_ir_binary_offset_nonneg(block_id, block_facts, env, local_facts, op, lhs, rhs, left, right) == 1 {
      pipeline_ir_local_fact_env_bind_nonneg(local_facts, dst)
    } else { local_facts }
    let kept_facts = pipeline_ir_binary_row_derive(block_id, block_facts, env, offset_facts, op, lhs, rhs, left, right, dst)
    let table2 = if table == 0 { nlist_new() } else { table }
    nlist_add(table2, node_new(0, packed, lval, rval, dst))
    pipeline_optimised_insts(ir_inst_list_prepend(rewritten, ir_inst_list_empty()), env, aliases, pipeline_ir_local_fact_env_with_bin_cse(kept_facts, table2), next_value, 0, 0, 0)
  }
}

pub(package) fn pipeline_optimise_ir_inst(inst: IrInst, block_id: i64, block_facts: PipelineIrBlockEntryFactChain, env: PipelineIrConstEnv, aliases: PipelineIrAliasEnv, local_facts: PipelineIrLocalFactEnv, ctx: PipelineIrOptimiseContext, next_value: i64) -> PipelineOptimisedInsts {
  let facts = pipeline_ir_optimise_context_facts(ctx)
  let inline_candidates = pipeline_ir_optimise_context_inline_candidates(ctx)
  let tag_env = pipeline_ir_local_fact_env_tag_env(local_facts)
  let nil_env = pipeline_ir_local_fact_env_nil_env(local_facts)
  let rewritten = pipeline_ir_rewrite_inst_uses(inst, aliases)
  match rewritten {
    IrConstI64(dst, value) -> {
      let next_env = pipeline_ir_const_env_bind(env, dst, value)
      -- Same-value const dedup (packed tag 999001 in the block's value-
      -- numbering table): identical bit patterns alias to the first
      -- materialisation; the kept duplicate is dead-pure and sweeps.
      let table = pipeline_ir_local_fact_env_bin_cse(local_facts)
      let hit = pipeline_ir_bin_cse_lookup(table, 999001, value, 0)
      if hit >= 0 and hit != dst {
        pipeline_optimised_insts(ir_inst_list_prepend(rewritten, ir_inst_list_empty()), next_env, pipeline_ir_alias_env_bind(aliases, dst, hit), local_facts, next_value, 0, 0, 0)
      } else {
        let table2 = if table == 0 { nlist_new() } else { table }
        nlist_add(table2, node_new(0, 999001, value, 0, dst))
        pipeline_optimised_insts(ir_inst_list_prepend(rewritten, ir_inst_list_empty()), next_env, aliases, pipeline_ir_local_fact_env_with_bin_cse(local_facts, table2), next_value, 0, 0, 0)
      }
    }
    IrNilI64(dst) -> {
      let next_env = pipeline_ir_const_env_bind(env, dst, 0)
      let next_nil_env = pipeline_ir_nil_env_bind(nil_env, dst)
      pipeline_optimised_insts(ir_inst_list_prepend(rewritten, ir_inst_list_empty()), next_env, aliases, pipeline_ir_local_fact_env_with_nil_env(local_facts, next_nil_env), next_value, 0, 0, 0)
    }
    IrBinaryI64(dst, op, lhs, rhs) -> {
      let left = pipeline_ir_const_env_lookup(env, lhs)
      let right = pipeline_ir_const_env_lookup(env, rhs)
      if pipeline_ir_const_lookup_valid(left) == 1 and pipeline_ir_const_lookup_valid(right) == 1 {
        let folded = pipeline_ir_const_eval(op, pipeline_ir_const_lookup_value(left), pipeline_ir_const_lookup_value(right))
        if pipeline_ir_const_lookup_valid(folded) == 1 {
          let value = pipeline_ir_const_lookup_value(folded)
          let folded_inst = ir_inst_const_i64(dst, value)
          let next_env = pipeline_ir_const_env_bind(env, dst, value)
          pipeline_optimised_insts(ir_inst_list_prepend(folded_inst, ir_inst_list_empty()), next_env, aliases, local_facts, next_value, 1, 0, 0)
        } else {
          let fact_fold = pipeline_ir_block_fact_binary_const(block_id, block_facts, local_facts, op, lhs, rhs, left, right)
          if pipeline_ir_const_lookup_valid(fact_fold) == 1 {
            let value = pipeline_ir_const_lookup_value(fact_fold)
            let folded_inst = ir_inst_const_i64(dst, value)
            let next_env = pipeline_ir_const_env_bind(env, dst, value)
            pipeline_optimised_insts(ir_inst_list_prepend(folded_inst, ir_inst_list_empty()), next_env, aliases, local_facts, next_value, 1, 0, 1)
          } else {
            let rewrite = pipeline_ir_algebraic_rewrite(dst, op, lhs, rhs, left, right, next_value)
            match rewrite {
              PipelineIrRewriteUnchanged -> pipeline_optimise_ir_binary_unchanged(rewritten, dst, op, lhs, rhs, left, right, block_id, block_facts, env, aliases, local_facts, next_value)
              _ -> pipeline_optimise_ir_rewrite_result(dst, rewrite, env, aliases, local_facts, next_value)
            }
          }
        }
      } else {
        let fact_fold = pipeline_ir_block_fact_binary_const(block_id, block_facts, local_facts, op, lhs, rhs, left, right)
        if pipeline_ir_const_lookup_valid(fact_fold) == 1 {
          let value = pipeline_ir_const_lookup_value(fact_fold)
          let folded_inst = ir_inst_const_i64(dst, value)
          let next_env = pipeline_ir_const_env_bind(env, dst, value)
          pipeline_optimised_insts(ir_inst_list_prepend(folded_inst, ir_inst_list_empty()), next_env, aliases, local_facts, next_value, 1, 0, 1)
        } else {
          let rewrite = pipeline_ir_algebraic_rewrite(dst, op, lhs, rhs, left, right, next_value)
          match rewrite {
            PipelineIrRewriteUnchanged -> pipeline_optimise_ir_binary_unchanged(rewritten, dst, op, lhs, rhs, left, right, block_id, block_facts, env, aliases, local_facts, next_value)
            _ -> pipeline_optimise_ir_rewrite_result(dst, rewrite, env, aliases, local_facts, next_value)
          }
        }
      }
    }
    IrFloatBinaryI64(dst, prim, op, lhs, rhs) -> {
      pipeline_optimised_insts(ir_inst_list_prepend(rewritten, ir_inst_list_empty()), env, aliases, local_facts, next_value, 0, 0, 0)
    }
    IrVariantTagI64(dst, base) -> {
      let known = pipeline_ir_block_entry_ctor_fact_lookup_chain(block_facts, block_id, base)
      if pipeline_ir_const_lookup_valid(known) == 1 {
        let value = pipeline_ir_const_lookup_value(known)
        let folded_inst = ir_inst_const_i64(dst, value)
        let next_env = pipeline_ir_const_env_bind(env, dst, value)
        pipeline_optimised_insts(ir_inst_list_prepend(folded_inst, ir_inst_list_empty()), next_env, aliases, local_facts, next_value, 1, 0, 1)
      } else {
        let next_tag_env = pipeline_ir_tag_env_bind(tag_env, dst, base)
        pipeline_optimised_insts(ir_inst_list_prepend(rewritten, ir_inst_list_empty()), env, aliases, pipeline_ir_local_fact_env_with_tag_env(local_facts, next_tag_env), next_value, 0, 0, 0)
      }
    }
    IrVariantPayloadI64(dst, base, index) -> {
      -- Variant-payload const-folding is disabled: the block-entry
      -- variant-origin fact records the payload SSA value id from the init
      -- site, but copy-propagating the extracted binding to that id is
      -- unsound across blocks (the id can be out of context in the
      -- extraction block, e.g. a nested if-let/match on a variant payload
      -- folded to the wrong value). Re-enable once variant-origin facts are
      -- keyed by a value that provably dominates the extraction.
      pipeline_optimised_insts(ir_inst_list_prepend(rewritten, ir_inst_list_empty()), env, aliases, local_facts, next_value, 0, 0, 0)
    }
    IrCallI64(dst, callee_hash, args) -> {
      let indexed_mode = pipeline_runtime_index_address_check_mode(callee_hash)
      let slice_mode = pipeline_runtime_slice_address_check_mode(callee_hash)
      if indexed_mode >= 0 and ir_value_list_len(args) == 4 {
        -- Block-entry facts are keyed to the pre-rewrite SSA operands. Use
        -- those for proof lookup, then retain the alias-rewritten argument
        -- list in the emitted call.
        let fact_args = match inst {
          IrCallI64(original_dst, original_hash, original_args) -> original_args
          _ -> args
        }
        let len_value = pipeline_ir_value_list_get_or(fact_args, 1, 0 - 1)
        let index_value = pipeline_ir_value_list_get_or(fact_args, 2, 0 - 1)
        let tightened_mode = pipeline_ir_indexed_address_tightened_check_mode(block_id, block_facts, pipeline_ir_optimise_context_value_defs(ctx), env, aliases, len_value, index_value, indexed_mode)
        let tightened_hash = pipeline_runtime_index_address_hash_for_mode(tightened_mode)
        let tightened = if tightened_hash == callee_hash { rewritten } else { IrCallI64(dst, tightened_hash, args) }
        let narrowed = if tightened_hash == callee_hash { 0 } else { 1 }
        pipeline_optimised_insts(ir_inst_list_prepend(tightened, ir_inst_list_empty()), env, aliases, pipeline_ir_local_fact_env_with_call_cse(local_facts, pipeline_ir_call_cse_env_empty()), next_value, 0, 0, narrowed)
      } else { if slice_mode >= 0 and ir_value_list_len(args) == 6 {
        let fact_args = match inst {
          IrCallI64(original_dst, original_hash, original_args) -> original_args
          _ -> args
        }
        let len_value = pipeline_ir_value_list_get_or(fact_args, 2, 0 - 1)
        let start_value = pipeline_ir_value_list_get_or(fact_args, 3, 0 - 1)
        let end_value = pipeline_ir_value_list_get_or(fact_args, 4, 0 - 1)
        let tightened_mode = pipeline_ir_slice_address_tightened_check_mode(block_id, block_facts, pipeline_ir_optimise_context_value_defs(ctx), env, aliases, len_value, start_value, end_value, slice_mode)
        let tightened_hash = pipeline_runtime_slice_address_hash_for_mode(pipeline_runtime_slice_address_mutability(callee_hash), tightened_mode)
        let tightened = if tightened_hash == callee_hash { rewritten } else { IrCallI64(dst, tightened_hash, args) }
        let narrowed = if tightened_hash == callee_hash { 0 } else { 1 }
        pipeline_optimised_insts(ir_inst_list_prepend(tightened, ir_inst_list_empty()), env, aliases, pipeline_ir_local_fact_env_with_call_cse(local_facts, pipeline_ir_call_cse_env_empty()), next_value, 0, 0, narrowed)
      } else {
        let table_rewrite = pipeline_ir_f64_table_rewrite_call(dst, callee_hash, args, facts, next_value)
        match table_rewrite {
          PipelineIrRewriteUnchanged -> {
	          let inline = pipeline_ir_try_inline_direct_call(callee_hash, args, inline_candidates, facts, dst, next_value)
            if pipeline_ir_inline_result_ok(inline) == 1 {
              let inline_insts = pipeline_ir_inline_result_insts(inline)
              let result_value = pipeline_ir_inline_result_value(inline)
              let inline_next = pipeline_ir_inline_result_next_value(inline)
              pipeline_ir_inline_materialize_result(dst, result_value, inline_insts, env, aliases, local_facts, facts, inline_next)
            } else {
              -- A pure callee, vector_len, or sealed managed bookkeeping
              -- cannot shrink a live vector; any other call may, so
              -- length-derived facts stop tightening bounds checks for the
              -- rest of this block.
              if pipeline_ir_semantic_fact_lookup_pure(facts, callee_hash) == 1 or callee_hash == pipeline_ir_vector_len_hash() or pipeline_ir_len_facts_stable_managed_call_hash(callee_hash) == 1 or pipeline_ir_pure_intrinsic_inline_call_hash(callee_hash) == 1 {
                pipeline_optimised_insts(ir_inst_list_prepend(rewritten, ir_inst_list_empty()), env, aliases, pipeline_ir_local_fact_env_with_call_cse(local_facts, pipeline_ir_call_cse_env_empty()), next_value, 0, 0, 0)
              } else {
                pipeline_optimised_insts(ir_inst_list_prepend(rewritten, ir_inst_list_empty()), env, aliases, pipeline_ir_local_fact_env_with_call_cse(pipeline_ir_local_fact_env_kill_len_facts(local_facts), pipeline_ir_call_cse_env_empty()), next_value, 0, 0, 0)
              }
            }
          }
          _ -> pipeline_optimise_ir_rewrite_result(dst, table_rewrite, env, aliases, pipeline_ir_local_fact_env_with_call_cse(local_facts, pipeline_ir_call_cse_env_empty()), next_value)
        }
      } }
    }
    IrManagedStakeI64(dst, value, cleanup_kind, delta, origin) -> {
      -- Ownership bookkeeping is observable and call-shaped, so it clears
      -- call CSE. It cannot mutate a vector's length, preserving the same
      -- bounds facts as the former sealed runtime-helper call.
      pipeline_optimised_insts(
        ir_inst_list_prepend(rewritten, ir_inst_list_empty()),
        env,
        aliases,
        pipeline_ir_local_fact_env_with_call_cse(local_facts, pipeline_ir_call_cse_env_empty()),
        next_value,
        0,
        0,
        0
      )
    }
    IrVectorGetI64(dst, vec, index, fallback, check_mode) -> {
      let tightened_mode = pipeline_ir_vector_tightened_check_mode(block_id, block_facts, env, local_facts, vec, index, check_mode)
      let next_facts = pipeline_ir_local_fact_env_with_call_cse(local_facts, pipeline_ir_call_cse_env_empty())
      -- Redundant-get elimination: same vector, index, and fallback with
      -- no intervening mutation event yields the same value. Hits keep
      -- the instruction (cross-block uses of dst stay defined; DCE
      -- sweeps it when dead) and alias dst to the first get's value.
      let idx_c = pipeline_ir_const_env_lookup(env, index)
      let fb_c = pipeline_ir_const_env_lookup(env, fallback)
      let packed = pipeline_ir_bin_cse_operand_kind(idx_c, index) * 2 + pipeline_ir_bin_cse_operand_kind(fb_c, fallback)
      let idx_val = pipeline_ir_bin_cse_operand_val(idx_c, index)
      let fb_val = pipeline_ir_bin_cse_operand_val(fb_c, fallback)
      let vtable = pipeline_ir_local_fact_env_vget_cse(next_facts)
      let hit = pipeline_ir_vget_cse_lookup(vtable, packed, idx_val, fb_val, vec)
      if hit >= 0 and hit != dst {
        let kept = if tightened_mode != check_mode { IrVectorGetI64(dst, vec, index, fallback, tightened_mode) } else { rewritten }
        pipeline_optimised_insts(ir_inst_list_prepend(kept, ir_inst_list_empty()), env, pipeline_ir_alias_env_bind(aliases, dst, hit), next_facts, next_value, 0, 0, 0)
      } else {
        let vtable2 = if vtable == 0 { nlist_new() } else { vtable }
        nlist_add(vtable2, node_new(0, packed, idx_val, fb_val, node_new(0, vec, dst, 0, 0)))
        let bound_facts = pipeline_ir_local_fact_env_with_vget_cse(next_facts, vtable2)
        if tightened_mode != check_mode {
          let tightened = IrVectorGetI64(dst, vec, index, fallback, tightened_mode)
          pipeline_optimised_insts(ir_inst_list_prepend(tightened, ir_inst_list_empty()), env, aliases, bound_facts, next_value, 0, 0, 1)
        } else {
          pipeline_optimised_insts(ir_inst_list_prepend(rewritten, ir_inst_list_empty()), env, aliases, bound_facts, next_value, 0, 0, 0)
        }
      }
    }
    IrVectorSetI64(dst, vec, index, value, check_mode) -> {
      let tightened_mode = pipeline_ir_vector_tightened_check_mode(block_id, block_facts, env, local_facts, vec, index, check_mode)
      -- A set may write any vector the tracked handles alias: clear the
      -- redundant-get table.
      let next_facts = pipeline_ir_local_fact_env_with_vget_cse(pipeline_ir_local_fact_env_with_call_cse(local_facts, pipeline_ir_call_cse_env_empty()), 0)
      if tightened_mode != check_mode {
        let tightened = IrVectorSetI64(dst, vec, index, value, tightened_mode)
        pipeline_optimised_insts(ir_inst_list_prepend(tightened, ir_inst_list_empty()), env, aliases, next_facts, next_value, 0, 0, 1)
      } else {
        pipeline_optimised_insts(ir_inst_list_prepend(rewritten, ir_inst_list_empty()), env, aliases, next_facts, next_value, 0, 0, 0)
      }
    }
    IrLoadI64(dst, slot_id) -> {
      let next_facts = pipeline_ir_local_fact_env_bind_load_slot(local_facts, dst, slot_id)
      pipeline_optimised_insts(ir_inst_list_prepend(rewritten, ir_inst_list_empty()), env, aliases, next_facts, next_value, 0, 0, 0)
    }
    IrStoreI64(slot_id, value) -> {
      let next_facts = pipeline_ir_local_fact_env_kill_slot(local_facts, slot_id)
      pipeline_optimised_insts(ir_inst_list_prepend(rewritten, ir_inst_list_empty()), env, aliases, next_facts, next_value, 0, 0, 0)
    }
    IrPtrStoreI64(dst, ptr, value) -> {
      let next_facts = pipeline_ir_local_fact_env_kill_all_slots(local_facts)
      pipeline_optimised_insts(ir_inst_list_prepend(rewritten, ir_inst_list_empty()), env, aliases, next_facts, next_value, 0, 0, 0)
    }
    IrPerformI64(dst, effect_hash, op_hash, args) -> {
      -- Handlers run arbitrary code: length facts stop tightening.
      pipeline_optimised_insts(ir_inst_list_prepend(rewritten, ir_inst_list_empty()), env, aliases, pipeline_ir_local_fact_env_kill_len_facts(local_facts), next_value, 0, 0, 0)
    }
    IrHandlerDirectI64(dst, effect_hash, op_hash, handler_depth, clause_index, args) -> {
      pipeline_optimised_insts(ir_inst_list_prepend(rewritten, ir_inst_list_empty()), env, aliases, pipeline_ir_local_fact_env_kill_len_facts(local_facts), next_value, 0, 0, 0)
    }
    -- Indirect, generic, and method calls run arbitrary code. Before
    -- jump-chain merging the CFG call lowering kept them at block
    -- boundaries where the cross-block stability rule applied; merged
    -- blocks need the same kill locally (runtime lock:
    -- bounds_runtime_lambda_shrink_takes_fallback).
    IrIndirectCallI64(dst, callee, args, result_ty) -> {
      pipeline_optimised_insts(ir_inst_list_prepend(rewritten, ir_inst_list_empty()), env, aliases, pipeline_ir_local_fact_env_kill_len_facts(pipeline_ir_local_fact_env_with_call_cse(local_facts, pipeline_ir_call_cse_env_empty())), next_value, 0, 0, 0)
    }
    IrGenericCallI64(dst, callee_hash, type_args, args) -> {
      pipeline_optimised_insts(ir_inst_list_prepend(rewritten, ir_inst_list_empty()), env, aliases, pipeline_ir_local_fact_env_kill_len_facts(pipeline_ir_local_fact_env_with_call_cse(local_facts, pipeline_ir_call_cse_env_empty())), next_value, 0, 0, 0)
    }
    IrMethodCallI64(dst, type_hash, method_hash, receiver, args) -> {
      pipeline_optimised_insts(ir_inst_list_prepend(rewritten, ir_inst_list_empty()), env, aliases, pipeline_ir_local_fact_env_kill_len_facts(pipeline_ir_local_fact_env_with_call_cse(local_facts, pipeline_ir_call_cse_env_empty())), next_value, 0, 0, 0)
    }
    _ -> {
      pipeline_optimised_insts(ir_inst_list_prepend(rewritten, ir_inst_list_empty()), env, aliases, pipeline_ir_local_fact_env_with_call_cse(local_facts, pipeline_ir_call_cse_env_empty()), next_value, 0, 0, 0)
    }
  }
}

pub(package) fn pipeline_optimise_ir_inst_list(insts: IrInstList, block_id: i64, block_facts: PipelineIrBlockEntryFactChain, env: PipelineIrConstEnv, aliases: PipelineIrAliasEnv, local_facts: PipelineIrLocalFactEnv, ctx: PipelineIrOptimiseContext, next_value: i64) -> PipelineOptimisedInsts {
  match insts {
    IrInstNil -> pipeline_optimised_insts(ir_inst_list_empty(), env, aliases, local_facts, next_value, 0, 0, 0)
    IrInstCons(inst, rest) -> {
      let head = pipeline_optimise_ir_inst(inst, block_id, block_facts, env, aliases, local_facts, ctx, next_value)
      let tail = pipeline_optimise_ir_inst_list(
        rest,
        block_id,
        block_facts,
        pipeline_optimised_insts_env(head),
        pipeline_optimised_insts_aliases(head),
        pipeline_optimised_insts_local_facts(head),
        ctx,
        pipeline_optimised_insts_next_value(head)
      )
      PipelineOptimisedInsts(
        ir_inst_list_append(pipeline_optimised_insts_insts(head), pipeline_optimised_insts_insts(tail)),
        pipeline_optimised_insts_env(tail),
        pipeline_optimised_insts_aliases(tail),
        pipeline_optimised_insts_local_facts(tail),
        pipeline_optimised_insts_next_value(tail),
        pipeline_optimised_insts_const_fold_sites(head) + pipeline_optimised_insts_const_fold_sites(tail),
        pipeline_optimised_insts_algebraic_fold_sites(head) + pipeline_optimised_insts_algebraic_fold_sites(tail),
        pipeline_optimised_insts_block_entry_narrowing_sites(head) + pipeline_optimised_insts_block_entry_narrowing_sites(tail),
        pipeline_optimised_insts_direct_call_inline_sites(head) + pipeline_optimised_insts_direct_call_inline_sites(tail)
      )
    }
  }
}

pub(package) fn pipeline_ir_const_env_from_inst(inst: IrInst, env: PipelineIrConstEnv) -> PipelineIrConstEnv {
  match inst {
    IrConstI64(dst, value) -> pipeline_ir_const_env_bind(env, dst, value)
    IrNilI64(dst) -> pipeline_ir_const_env_bind(env, dst, 0)
    _ -> env
  }
}

pub(package) fn pipeline_ir_const_env_from_inst_list(insts: IrInstList, env: PipelineIrConstEnv) -> PipelineIrConstEnv {
  match insts {
    IrInstNil -> env
    IrInstCons(inst, rest) -> pipeline_ir_const_env_from_inst_list(rest, pipeline_ir_const_env_from_inst(inst, env))
  }
}

pub(package) fn pipeline_ir_const_env_from_block(block: IrBlock, env: PipelineIrConstEnv) -> PipelineIrConstEnv {
  match block {
    IrBlock(id, params, insts, term) -> pipeline_ir_const_env_from_inst_list(insts, env)
  }
}

pub(package) fn pipeline_ir_const_env_from_block_list(blocks: IrBlockList, env: PipelineIrConstEnv) -> PipelineIrConstEnv {
  match blocks {
    IrBlockListNil -> env
    IrBlockListCons(block, rest) -> pipeline_ir_const_env_from_block_list(rest, pipeline_ir_const_env_from_block(block, env))
  }
}

pub(package) fn pipeline_ir_block_list_has_branch_to(blocks: IrBlockList, target: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          match term {
            IrTermBranch(cond, then_block, else_block) -> {
              if then_block == target or else_block == target { 1 }
              else { pipeline_ir_block_list_has_branch_to(rest, target) }
            }
            _ -> pipeline_ir_block_list_has_branch_to(rest, target)
          }
        }
      }
    }
  }
}

pub(package) fn pipeline_ir_block_param_const_merge(blocks: IrBlockList, target: i64, index: i64, consts: PipelineIrConstEnv, seen: i64, valid: i64, value: i64) -> PipelineIrConstLookup {
  match blocks {
    IrBlockListNil -> {
      if seen == 1 and valid == 1 { pipeline_ir_const_lookup(1, value) }
      else { pipeline_ir_const_lookup(0, 0) }
    }
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          match term {
            IrTermJump(jump_target, args) -> {
              if jump_target == target {
                if seen == 1 and valid == 0 {
                  pipeline_ir_block_param_const_merge(rest, target, index, consts, seen, valid, value)
                } else {
                  let arg = pipeline_ir_value_list_get_or(args, index, 0 - 1)
                  let found = pipeline_ir_const_env_lookup(consts, arg)
                  if pipeline_ir_const_lookup_valid(found) == 1 {
                    let found_value = pipeline_ir_const_lookup_value(found)
                    if seen == 0 {
                      pipeline_ir_block_param_const_merge(rest, target, index, consts, 1, 1, found_value)
                    } else {
                      if found_value == value {
                        pipeline_ir_block_param_const_merge(rest, target, index, consts, seen, valid, value)
                      } else {
                        pipeline_ir_block_param_const_merge(rest, target, index, consts, 1, 0, value)
                      }
                    }
                  } else {
                    pipeline_ir_block_param_const_merge(rest, target, index, consts, 1, 0, value)
                  }
                }
              } else {
                pipeline_ir_block_param_const_merge(rest, target, index, consts, seen, valid, value)
              }
            }
            _ -> pipeline_ir_block_param_const_merge(rest, target, index, consts, seen, valid, value)
          }
        }
      }
    }
  }
}

pub(package) fn pipeline_ir_block_param_const_lookup(blocks: IrBlockList, target: i64, index: i64, consts: PipelineIrConstEnv) -> PipelineIrConstLookup {
  pipeline_ir_block_param_const_lookup_with_branch_flag(blocks, target, index, consts, pipeline_ir_block_list_has_branch_to(blocks, target))
}

pub(package) fn pipeline_ir_block_param_const_lookup_with_branch_flag(blocks: IrBlockList, target: i64, index: i64, consts: PipelineIrConstEnv, has_branch_to_target: i64) -> PipelineIrConstLookup {
  if has_branch_to_target == 1 {
    pipeline_ir_const_lookup(0, 0)
  } else {
    pipeline_ir_block_param_const_merge(blocks, target, index, consts, 0, 1, 0)
  }
}

pub(package) fn pipeline_ir_block_param_const_env_params(params: IrValueList, index: i64, target: i64, blocks: IrBlockList, consts: PipelineIrConstEnv, env: PipelineIrConstEnv, has_branch_to_target: i64) -> PipelineIrConstEnv {
  match params {
    IrValueNil -> env
    IrValueCons(param, rest) -> {
      let found = pipeline_ir_block_param_const_lookup_with_branch_flag(blocks, target, index, consts, has_branch_to_target)
      let next_env = if pipeline_ir_const_lookup_valid(found) == 1 {
        pipeline_ir_const_env_bind(env, param, pipeline_ir_const_lookup_value(found))
      } else {
        env
      }
      pipeline_ir_block_param_const_env_params(rest, index + 1, target, blocks, consts, next_env, has_branch_to_target)
    }
  }
}

pub(package) fn pipeline_ir_block_param_const_env(block: IrBlock, blocks: IrBlockList, consts: PipelineIrConstEnv) -> PipelineIrConstEnv {
  match block {
    IrBlock(id, params, insts, term) -> {
      match params {
        IrValueNil -> consts
        _ -> pipeline_ir_block_param_const_env_params(params, 0, id, blocks, consts, consts, pipeline_ir_block_list_has_branch_to(blocks, id))
      }
    }
  }
}

pub(package) fn pipeline_ir_live_set_empty() -> PipelineIrLiveSet {
  PipelineIrLiveSetNil
}

pub(package) fn pipeline_ir_live_set_dense_word_count(limit: i64) -> i64 {
  if limit <= 0 { 0 } else { (limit + 63) / 64 }
}

pub(package) fn pipeline_ir_live_set_dense_clear(array: i64, words: i64, index: i64) -> i64 {
  let mut i = index
  while i < words {
    pipeline_word_array_set(array, i, 0)
    i = i + 1
  }
  0
}

pub(package) fn pipeline_ir_live_set_dense(limit: i64) -> PipelineIrLiveSet {
  let words = pipeline_ir_live_set_dense_word_count(limit)
  if words <= 0 {
    PipelineIrLiveSetNil
  } else {
    let array = pipeline_word_array_new(words)
    pipeline_ir_live_set_dense_clear(array, words, 0)
    PipelineIrLiveSetBits(array, words, 0)
  }
}

pub(package) fn pipeline_ir_live_set_dense_contains(array: i64, words: i64, value: i64) -> i64 {
  if value < 0 {
    0
  } else {
    let word_index = value / 64
    if word_index >= words {
      0
    } else {
      let mask = 1 bshl (value % 64)
      if (pipeline_word_array_get(array, word_index) band mask) != 0 { 1 } else { 0 }
    }
  }
}

pub(package) fn pipeline_ir_live_set_contains(live: PipelineIrLiveSet, value: i64) -> i64 {
  match live {
    PipelineIrLiveSetNil -> 0
    PipelineIrLiveSetCons(v, rest) -> {
      if v == value { 1 } else { pipeline_ir_live_set_contains(rest, value) }
    }
    PipelineIrLiveSetBits(array, words, count) -> pipeline_ir_live_set_dense_contains(array, words, value)
  }
}

pub(package) fn pipeline_ir_live_set_len(live: PipelineIrLiveSet) -> i64 {
  match live {
    PipelineIrLiveSetNil -> 0
    PipelineIrLiveSetCons(v, rest) -> 1 + pipeline_ir_live_set_len(rest)
    PipelineIrLiveSetBits(array, words, count) -> count
  }
}

pub(package) fn pipeline_ir_live_set_add(live: PipelineIrLiveSet, value: i64) -> PipelineIrLiveSet {
  if value < 0 { live }
  else {
    match live {
      PipelineIrLiveSetBits(array, words, count) -> {
        let word_index = value / 64
        if word_index >= words {
          if pipeline_ir_live_set_contains(live, value) == 1 { live }
          else { PipelineIrLiveSetCons(value, live) }
        } else {
          let mask = 1 bshl (value % 64)
          let word = pipeline_word_array_get(array, word_index)
          if (word band mask) != 0 {
            live
          } else {
            pipeline_word_array_set(array, word_index, word bor mask)
            PipelineIrLiveSetBits(array, words, count + 1)
          }
        }
      }
      _ -> {
        if pipeline_ir_live_set_contains(live, value) == 1 { live }
        else { PipelineIrLiveSetCons(value, live) }
      }
    }
  }
}

pub(package) fn pipeline_ir_live_set_add_structural_drop(live: PipelineIrLiveSet, value: i64, plan: i64) -> PipelineIrLiveSet {
  let words = pipeline_structural_drop_plan_use_words(plan)
  let mut next = live
  for lane in 0..words {
    next = pipeline_ir_live_set_add(next, value + lane)
  }
  next
}

pub(package) fn pipeline_ir_live_set_remove(live: PipelineIrLiveSet, value: i64) -> PipelineIrLiveSet {
  match live {
    PipelineIrLiveSetNil -> PipelineIrLiveSetNil
    PipelineIrLiveSetCons(v, rest) -> {
      let filtered = pipeline_ir_live_set_remove(rest, value)
      if v == value { filtered } else { PipelineIrLiveSetCons(v, filtered) }
    }
    PipelineIrLiveSetBits(array, words, count) -> {
      if value < 0 {
        live
      } else {
        let word_index = value / 64
        if word_index >= words {
          live
        } else {
          let mask = 1 bshl (value % 64)
          let word = pipeline_word_array_get(array, word_index)
          if (word band mask) == 0 {
            live
          } else {
            pipeline_word_array_set(array, word_index, word - mask)
            PipelineIrLiveSetBits(array, words, count - 1)
          }
        }
      }
    }
  }
}

pub(package) fn pipeline_ir_live_set_add_values(live: PipelineIrLiveSet, values: IrValueList) -> PipelineIrLiveSet {
  match values {
    IrValueNil -> live
    IrValueCons(value, rest) -> pipeline_ir_live_set_add_values(pipeline_ir_live_set_add(live, value), rest)
  }
}

pub(package) fn pipeline_ir_live_set_add_record_fields(live: PipelineIrLiveSet, fields: IrRecordFieldList) -> PipelineIrLiveSet {
  match fields {
    IrRecordFieldNil -> live
    IrRecordFieldCons(field_hash, word_offset, value, rest) -> pipeline_ir_live_set_add_record_fields(pipeline_ir_live_set_add(live, value), rest)
  }
}

pub(package) fn pipeline_ir_live_set_add_record_layout_fields(live: PipelineIrLiveSet, fields: IrRecordLayoutFieldList) -> PipelineIrLiveSet {
  match fields {
    IrRecordLayoutFieldNil -> live
    IrRecordLayoutFieldWord(field_hash, byte_offset, value, managed_kind, rest) -> pipeline_ir_live_set_add_record_layout_fields(pipeline_ir_live_set_add(live, value), rest)
    IrRecordLayoutFieldArray(field_hash, byte_offset, data, byte_size, leaf_count, leaf_stride, leaf_kind, rest) -> pipeline_ir_live_set_add_record_layout_fields(pipeline_ir_live_set_add(live, data), rest)
  }
}

pub(package) fn pipeline_ir_live_set_add_lambda_captures(captures: i64, live: PipelineIrLiveSet) -> PipelineIrLiveSet {
  let mut result = live
  let mut i = 0
  let n = if captures == 0 { 0 } else { nlist_len(captures) }
  while i < n {
    let capture = nlist_get(captures, i)
    let lanes = pipeline_capture_lane_count(capture)
    for lane in 0..lanes {
      result = pipeline_ir_live_set_add(result, node_f3(capture) + lane)
    }
    i = i + 1
  }
  result
}

pub(package) fn pipeline_ir_live_set_add_handler_clause_captures(clauses: IrHandlerClauseBodyList, live: PipelineIrLiveSet) -> PipelineIrLiveSet {
  match clauses {
    IrHandlerClauseBodyNil -> live
    IrHandlerClauseBodyCons(body, rest) -> {
      let next = match body {
        IrHandlerClauseBody(op_hash, nparams, captures, has_continuation, is_abortive, result_cleanup_kind, transferred_param_value_fact, resume_lanes, result_lanes, first_value, blocks) -> pipeline_ir_live_set_add_lambda_captures(captures, live)
        IrHandlerClauseBodyInvalid(reason) -> live
      }
      pipeline_ir_live_set_add_handler_clause_captures(rest, next)
    }
  }
}

pub(package) fn pipeline_ir_live_set_add_deferred_body_captures(body: IrDeferredHandlerBody, live: PipelineIrLiveSet) -> PipelineIrLiveSet {
  match body {
    IrDeferredHandlerBody(body_src, captures, ops_value, result_lanes, first_value, blocks, completion) -> pipeline_ir_live_set_add_lambda_captures(captures, live)
    IrDeferredHandlerBodyInvalid(reason) -> live
  }
}

pub(package) fn pipeline_ir_branch_target_paramless(blocks: IrBlockList, target: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          if id == target {
            if ir_value_list_len(params) == 0 { 1 } else { 0 }
          } else {
            pipeline_ir_branch_target_paramless(rest, target)
          }
        }
      }
    }
  }
}

pub(package) fn pipeline_ir_live_set_add_jump_args_for_live_params(args: IrValueList, params: IrValueList, live: PipelineIrLiveSet) -> PipelineIrLiveSet {
  match args {
    IrValueNil -> live
    IrValueCons(arg, arg_rest) -> {
      match params {
        IrValueNil -> pipeline_ir_live_set_add_values(live, args)
        IrValueCons(param, param_rest) -> {
          let next = if pipeline_ir_live_set_contains(live, param) == 1 {
            pipeline_ir_live_set_add(live, arg)
          } else {
            live
          }
          pipeline_ir_live_set_add_jump_args_for_live_params(arg_rest, param_rest, next)
        }
      }
    }
  }
}

pub(package) fn pipeline_ir_live_set_add_jump_args_for_target_params(blocks: IrBlockList, target: i64, args: IrValueList, live: PipelineIrLiveSet) -> PipelineIrLiveSet {
  match blocks {
    IrBlockListNil -> pipeline_ir_live_set_add_values(live, args)
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          if id == target {
            pipeline_ir_live_set_add_jump_args_for_live_params(args, params, live)
          } else {
            pipeline_ir_live_set_add_jump_args_for_target_params(rest, target, args, live)
          }
        }
      }
    }
  }
}

pub(package) fn pipeline_ir_live_set_add_term_with_blocks(term: IrTerminator, live: PipelineIrLiveSet, blocks: IrBlockList) -> PipelineIrLiveSet {
  match term {
    IrTermNone -> live
    IrTermUnreachable -> live
    IrTermReturn(value) -> pipeline_ir_live_set_add(live, value)
    IrTermJump(target, args) -> {
      if ir_value_list_len(args) == 0 {
        live
      } else {
        pipeline_ir_live_set_add_jump_args_for_target_params(blocks, target, args, live)
      }
    }
    IrTermBranch(cond, then_block, else_block) -> pipeline_ir_live_set_add(live, cond)
  }
}

pub(package) fn pipeline_ir_folded_term(term: IrTerminator, block_entry_narrowing_sites: i64) -> PipelineIrFoldedTerm {
  PipelineIrFoldedTerm(term, block_entry_narrowing_sites)
}

pub(package) fn pipeline_ir_folded_term_term(result: PipelineIrFoldedTerm) -> IrTerminator {
  match result {
    PipelineIrFoldedTerm(term, block_entry_narrowing_sites) -> term
  }
}

pub(package) fn pipeline_ir_folded_term_block_entry_narrowing_sites(result: PipelineIrFoldedTerm) -> i64 {
  match result {
    PipelineIrFoldedTerm(term, block_entry_narrowing_sites) -> block_entry_narrowing_sites
  }
}

pub(package) fn pipeline_ir_fold_branch_term(term: IrTerminator, env: PipelineIrConstEnv, block_id: i64, block_facts: PipelineIrBlockEntryFactChain, blocks: IrBlockList) -> PipelineIrFoldedTerm {
  match term {
    IrTermBranch(cond, then_block, else_block) -> {
      let found = pipeline_ir_const_env_lookup(env, cond)
      if pipeline_ir_const_lookup_valid(found) == 1 {
        let target = if pipeline_ir_const_lookup_value(found) != 0 { then_block } else { else_block }
        if pipeline_ir_branch_target_paramless(blocks, target) == 1 {
          pipeline_ir_folded_term(ir_term_jump(target), 0)
        } else {
          pipeline_ir_folded_term(term, 0)
        }
      } else {
        let known = pipeline_ir_block_entry_bool_fact_lookup_chain(block_facts, block_id, cond)
        if pipeline_ir_const_lookup_valid(known) == 1 {
          let target = if pipeline_ir_const_lookup_value(known) != 0 { then_block } else { else_block }
          if pipeline_ir_branch_target_paramless(blocks, target) == 1 {
            pipeline_ir_folded_term(ir_term_jump(target), 1)
          } else {
            pipeline_ir_folded_term(term, 0)
          }
        } else {
          let zero_known = pipeline_ir_block_entry_zero_fact_lookup_chain(block_facts, block_id, cond)
          if pipeline_ir_const_lookup_valid(zero_known) == 1 {
            let target = if pipeline_ir_const_lookup_value(zero_known) == 0 { then_block } else { else_block }
            if pipeline_ir_branch_target_paramless(blocks, target) == 1 {
              pipeline_ir_folded_term(ir_term_jump(target), 1)
            } else {
              pipeline_ir_folded_term(term, 0)
            }
          } else {
            pipeline_ir_folded_term(term, 0)
          }
        }
      }
    }
    _ -> pipeline_ir_folded_term(term, 0)
  }
}

pub(package) fn pipeline_ir_reachable_seed(blocks: IrBlockList) -> PipelineIrLiveSet {
  match blocks {
    IrBlockListNil -> pipeline_ir_live_set_empty()
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> pipeline_ir_live_set_add(pipeline_ir_live_set_dense(pipeline_ir_max_block_id_list(blocks, 0) + 1), id)
      }
    }
  }
}

pub(package) fn pipeline_ir_reachable_add_term(term: IrTerminator, reachable: PipelineIrLiveSet) -> PipelineIrLiveSet {
  match term {
    IrTermNone -> reachable
    IrTermUnreachable -> reachable
    IrTermReturn(value) -> reachable
    IrTermJump(target, args) -> pipeline_ir_live_set_add(reachable, target)
    IrTermBranch(cond, then_block, else_block) -> pipeline_ir_live_set_add(pipeline_ir_live_set_add(reachable, then_block), else_block)
  }
}

pub(package) fn pipeline_ir_reachable_add_abort_insts(insts: IrInstList, reachable: PipelineIrLiveSet) -> PipelineIrLiveSet {
  match insts {
    IrInstNil -> reachable
    IrInstCons(inst, rest) -> {
      let next = match inst {
        IrHandleI64(dst, handle_src, effect_hash, clauses, nclauses, abort_block) -> {
          if abort_block >= 0 { pipeline_ir_live_set_add(reachable, abort_block) } else { reachable }
        }
        _ -> reachable
      }
      pipeline_ir_reachable_add_abort_insts(rest, next)
    }
  }
}

pub(package) fn pipeline_ir_reachable_add_block_successors(block: IrBlock, reachable: PipelineIrLiveSet) -> PipelineIrLiveSet {
  match block {
    IrBlock(id, params, insts, term) -> {
      if pipeline_ir_live_set_contains(reachable, id) == 1 {
        pipeline_ir_reachable_add_term(term, pipeline_ir_reachable_add_abort_insts(insts, reachable))
      } else {
        reachable
      }
    }
  }
}

pub(package) fn pipeline_ir_reachable_add_successors(blocks: IrBlockList, reachable: PipelineIrLiveSet) -> PipelineIrLiveSet {
  match blocks {
    IrBlockListNil -> reachable
    IrBlockListCons(block, rest) -> {
      let next = pipeline_ir_reachable_add_block_successors(block, reachable)
      pipeline_ir_reachable_add_successors(rest, next)
    }
  }
}

pub(package) fn pipeline_ir_reachable_fixpoint(blocks: IrBlockList, reachable: PipelineIrLiveSet) -> PipelineIrLiveSet {
  let next = pipeline_ir_reachable_add_successors(blocks, reachable)
  if pipeline_ir_live_set_len(next) == pipeline_ir_live_set_len(reachable) {
    next
  } else {
    pipeline_ir_reachable_fixpoint(blocks, next)
  }
}

pub(package) fn pipeline_ir_filter_reachable_blocks_with(blocks: IrBlockList, reachable: PipelineIrLiveSet) -> IrBlockList {
  match blocks {
    IrBlockListNil -> ir_block_list_empty()
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          let tail = pipeline_ir_filter_reachable_blocks_with(rest, reachable)
          if pipeline_ir_live_set_contains(reachable, id) == 1 {
            ir_block_list_prepend(block, tail)
          } else {
            tail
          }
        }
      }
    }
  }
}

pub(package) fn pipeline_ir_filter_reachable_blocks(blocks: IrBlockList) -> IrBlockList {
  let reachable = pipeline_ir_reachable_fixpoint(blocks, pipeline_ir_reachable_seed(blocks))
  pipeline_ir_filter_reachable_blocks_with(blocks, reachable)
}

pub(package) fn pipeline_ir_inst_def_or(inst: IrInst, default: i64) -> i64 {
  match inst {
    IrConstI64(dst, value) -> dst
    IrNilI64(dst) -> dst
    IrStringLit(dst, start, len) -> dst
    IrStringConcatI64(dst, left, right) -> dst
    IrBinaryI64(dst, op, lhs, rhs) -> dst
    IrFloatBinaryI64(dst, prim, op, lhs, rhs) -> dst
    IrUnaryI64(dst, op, value) -> dst
    IrClosureI64(dst, f, captures, eff) -> dst
    IrFunctionRefI64(dst, callee_hash) -> dst
    IrGenericFunctionRefI64(dst, callee_hash, type_args) -> dst
    IrAddressOfSlotI64(dst, slot) -> dst
    IrPtrLoadI64(dst, ptr) -> dst
    IrPtrStoreI64(dst, ptr, value) -> dst
    IrLoweringFailureI64(reason) -> default
    IrPerformI64(dst, effect_hash, op_hash, args) -> dst
    IrHandlerDirectI64(dst, effect_hash, op_hash, handler_depth, clause_index, args) -> dst
    IrHandlerPopI64(frame) -> default
    IrAbortLandingI64(dst) -> dst
    IrBindI64(ns, nl, value, ty) -> default
    IrHandleI64(dst, handle_src, body, clauses, nclauses, captures) -> dst
    IrDeferredHandleI64(dst, handle_src, body_expr, clauses, nclauses, captures, scratch_base) -> dst
    IrResumeI64(dst, value) -> dst
    IrTryI64(dst, value, effect_key, error_lanes) -> dst
    IrTryLinearI64(dst, value, effect_key, parent_plan, ok_plan, error_plan) -> dst
    IrTryResultLaneI64(dst, scratch) -> dst
    IrOptChainI64(dst, base, field_hash, field_index, effect_key) -> dst
    IrCallI64(dst, callee_hash, args) -> dst
    IrCallResultLaneI64(dst, lane) -> dst
    IrReturnLaneI64(lane, value) -> default
    IrIndirectCallI64(dst, callee, args, result_ty) -> dst
    IrGenericCallI64(dst, callee_hash, type_args, args) -> dst
    IrVectorGetI64(dst, vec, index, fallback, check_mode) -> dst
    IrVectorSetI64(dst, vec, index, value, check_mode) -> dst
    IrMethodCallI64(dst, type_hash, method_hash, receiver, args) -> dst
    IrOwnedDropI64(value, type_hash) -> default
    IrStructuralDropI64(value, plan) -> default
    IrStructuralSlotI64(value, slot, plan, mode) -> default
    IrStructuralSplitI64(value, parent_plan, residual_plan, release_backing) -> default
    IrArrayStorageI64(dst, byte_size, align) -> dst
    IrArrayStorageDescribeI64(storage, byte_size, fields) -> default
    IrArrayCopyI64(dst_data, src_data, byte_size, leaf_count, leaf_stride, leaf_kind) -> default
    IrArrayDropI64(data, leaf_count, leaf_stride, leaf_kind) -> default
    IrVariantInitI64(dst, tag_hash, payloads, field_mask) -> dst
    IrVariantTagI64(dst, base) -> dst
    IrVariantPayloadI64(dst, base, index) -> dst
    IrRecordInitI64(dst, type_hash, fields) -> dst
    IrRecordLayoutInitI64(dst, type_hash, data_size, align, fields) -> dst
    IrRecordLayoutArrayLoadI64(dst_data, base, record_data_size, byte_offset, byte_size, leaf_count, leaf_stride, leaf_kind) -> default
    IrRecordLayoutWordLoadI64(dst, base, record_data_size, field_hash, byte_offset) -> dst
    IrFieldLoadI64(dst, base, field_hash, field_index) -> dst
    IrSlotI64(slot) -> default
    IrLoadI64(dst, slot) -> dst
    IrStoreI64(slot, value) -> default
    IrManagedStakeI64(dst, value, cleanup_kind, delta, origin) -> dst
    IrManagedTransferI64(call_dst, callee_hash, value, arg_lane, cleanup_kind) -> default
    IrReuseInitI64(token, constructor) -> pipeline_ir_inst_def_or(constructor, default)
  }
}

pub(package) fn pipeline_ir_inst_is_dead_pure_candidate(inst: IrInst, facts: PipelineIrSemanticFactList) -> i64 {
  match inst {
    IrConstI64(dst, value) -> 1
    IrNilI64(dst) -> 1
    IrBinaryI64(dst, op, lhs, rhs) -> 1
    IrFloatBinaryI64(dst, prim, op, lhs, rhs) -> 1
    IrUnaryI64(dst, op, value) -> 1
    IrVariantTagI64(dst, base) -> 1
    -- Payload extraction and field load are single non-faulting reads of
    -- a live base (match lowering only emits them under the matching
    -- arm), exactly like the tag read: an unused result is removable.
    -- Match lowering extracts every arm binding whether or not the arm
    -- body uses it, so this is the pass that sweeps the unused ones.
    IrVariantPayloadI64(dst, base, index) -> 1
    IrFieldLoadI64(dst, base, field_hash, field_index) -> 1
    -- A vector get reads without mutating and cannot fault (out-of-range
    -- resolves to the fallback), so an unused result is removable — the
    -- redundant-get elimination relies on this to sweep aliased gets.
    IrVectorGetI64(dst, vec, index, fallback, check_mode) -> 1
    IrCallI64(dst, callee_hash, args) -> {
      -- This compiler-inserted call is the executable half of a scheduled
      -- defer obligation. It has no source call-site from which the semantic
      -- effect summary can rediscover Unsafe, so preserve it explicitly.
      if callee_hash == pipeline_runtime_defer_abort_cleanup_hash() { 0 }
      else { if pipeline_ir_pure_intrinsic_inline_call_hash(callee_hash) == 1 { 1 }
      else {
        -- Effect purity does not erase deterministic reclamation. A call
        -- with a by-value managed/owned lane consumes that stake even when
        -- its result is dead; removing the boundary would strand the caller
        -- retain and skip the callee's typed cleanup.
        pipeline_ir_semantic_fact_lookup_pure_nonconsuming(facts, callee_hash)
      }
      }
    }
    _ -> 0
  }
}

pub(package) fn pipeline_ir_inst_is_semantic_pure_call_candidate(inst: IrInst, facts: PipelineIrSemanticFactList) -> i64 {
  match inst {
    IrCallI64(dst, callee_hash, args) -> pipeline_ir_semantic_fact_lookup_pure(facts, callee_hash)
    _ -> 0
  }
}

pub(package) fn pipeline_ir_live_set_add_inst_uses(inst: IrInst, live: PipelineIrLiveSet) -> PipelineIrLiveSet {
  match inst {
    IrConstI64(dst, value) -> live
    IrNilI64(dst) -> live
    IrStringLit(dst, start, len) -> live
    IrStringConcatI64(dst, left, right) -> pipeline_ir_live_set_add(pipeline_ir_live_set_add(live, left), right)
    IrBinaryI64(dst, op, lhs, rhs) -> pipeline_ir_live_set_add(pipeline_ir_live_set_add(live, lhs), rhs)
    IrFloatBinaryI64(dst, prim, op, lhs, rhs) -> pipeline_ir_live_set_add(pipeline_ir_live_set_add(live, lhs), rhs)
    IrUnaryI64(dst, op, value) -> pipeline_ir_live_set_add(live, value)
    IrClosureI64(dst, f, captures, eff) -> pipeline_ir_live_set_add_lambda_captures(captures, live)
    IrFunctionRefI64(dst, callee_hash) -> live
    IrGenericFunctionRefI64(dst, callee_hash, type_args) -> live
    IrAddressOfSlotI64(dst, slot) -> pipeline_ir_live_set_add(live, slot)
    IrPtrLoadI64(dst, ptr) -> pipeline_ir_live_set_add(live, ptr)
    IrPtrStoreI64(dst, ptr, value) -> pipeline_ir_live_set_add(pipeline_ir_live_set_add(live, ptr), value)
    IrLoweringFailureI64(reason) -> live
    IrPerformI64(dst, effect_hash, op_hash, args) -> pipeline_ir_live_set_add_values(live, args)
    IrHandlerDirectI64(dst, effect_hash, op_hash, handler_depth, clause_index, args) -> pipeline_ir_live_set_add_values(live, args)
    IrHandlerPopI64(frame) -> pipeline_ir_live_set_add(live, frame)
    IrAbortLandingI64(dst) -> live
    IrBindI64(ns, nl, value, ty) -> pipeline_ir_live_set_add(live, value)
    IrHandleI64(dst, handle_src, effect_hash, clauses, nclauses, reserved) -> pipeline_ir_live_set_add_handler_clause_captures(clauses, live)
    IrDeferredHandleI64(dst, handle_src, body, clauses, nclauses, effect_hash, scratch_base) -> {
      pipeline_ir_live_set_add_deferred_body_captures(body, pipeline_ir_live_set_add_handler_clause_captures(clauses, live))
    }
    IrResumeI64(dst, value) -> pipeline_ir_live_set_add(live, value)
    IrTryI64(dst, value, effect_key, error_lanes) -> pipeline_ir_live_set_add(live, value)
    IrTryLinearI64(dst, value, effect_key, parent_plan, ok_plan, error_plan) -> pipeline_ir_live_set_add(live, value)
    IrTryResultLaneI64(dst, scratch) -> live
    IrOptChainI64(dst, base, field_hash, field_index, effect_key) -> pipeline_ir_live_set_add(live, base)
    IrCallI64(dst, callee_hash, args) -> pipeline_ir_live_set_add_values(live, args)
    -- Secondary result lanes are projections of a call-shaped definition.
    -- Keeping a projected lane therefore keeps its explicit or compact-form
    -- head definition live; otherwise DCE can delete a pure call while leaving
    -- a live lane read behind.
    IrCallResultLaneI64(dst, lane) -> pipeline_ir_live_set_add(live, ir_call_result_lane_head(dst, lane))
    IrReturnLaneI64(lane, value) -> pipeline_ir_live_set_add(live, value)
    IrIndirectCallI64(dst, callee, args, result_ty) -> pipeline_ir_live_set_add_values(pipeline_ir_live_set_add(live, callee), args)
    IrGenericCallI64(dst, callee_hash, type_args, args) -> pipeline_ir_live_set_add_values(live, args)
    IrVectorGetI64(dst, vec, index, fallback, check_mode) -> pipeline_ir_live_set_add(pipeline_ir_live_set_add(pipeline_ir_live_set_add(live, vec), index), fallback)
    IrVectorSetI64(dst, vec, index, value, check_mode) -> pipeline_ir_live_set_add(pipeline_ir_live_set_add(pipeline_ir_live_set_add(live, vec), index), value)
    IrMethodCallI64(dst, type_hash, method_hash, receiver, args) -> pipeline_ir_live_set_add_values(pipeline_ir_live_set_add(live, receiver), args)
    IrOwnedDropI64(value, type_hash) -> pipeline_ir_live_set_add(live, value)
    IrStructuralDropI64(value, plan) -> pipeline_ir_live_set_add_structural_drop(live, value, plan)
    IrStructuralSlotI64(value, slot, plan, mode) -> {
      if mode == 2 {
        pipeline_ir_live_set_add_structural_drop(pipeline_ir_live_set_add_structural_drop(live, value, plan), slot, plan)
      } else { if mode == 3 or mode == 4 or mode == 5 {
        pipeline_ir_live_set_add_structural_drop(live, value, plan)
      } else { live } }
    }
    IrStructuralSplitI64(value, parent_plan, residual_plan, release_backing) -> pipeline_ir_live_set_add_structural_drop(live, value, parent_plan)
    IrArrayStorageI64(dst, byte_size, align) -> live
    IrArrayStorageDescribeI64(storage, byte_size, fields) -> pipeline_ir_live_set_add(live, storage)
    IrArrayCopyI64(dst_data, src_data, byte_size, leaf_count, leaf_stride, leaf_kind) -> pipeline_ir_live_set_add(pipeline_ir_live_set_add(live, dst_data), src_data)
    IrArrayDropI64(data, leaf_count, leaf_stride, leaf_kind) -> pipeline_ir_live_set_add(live, data)
    IrVariantInitI64(dst, tag_hash, payloads, field_mask) -> pipeline_ir_live_set_add_values(live, payloads)
    IrVariantTagI64(dst, base) -> pipeline_ir_live_set_add(live, base)
    IrVariantPayloadI64(dst, base, index) -> pipeline_ir_live_set_add(live, base)
    IrRecordInitI64(dst, type_hash, fields) -> pipeline_ir_live_set_add_record_fields(live, fields)
    IrRecordLayoutInitI64(dst, type_hash, data_size, align, fields) -> pipeline_ir_live_set_add_record_layout_fields(live, fields)
    IrRecordLayoutArrayLoadI64(dst_data, base, record_data_size, byte_offset, byte_size, leaf_count, leaf_stride, leaf_kind) -> pipeline_ir_live_set_add(pipeline_ir_live_set_add(live, dst_data), base)
    IrRecordLayoutWordLoadI64(dst, base, record_data_size, field_hash, byte_offset) -> pipeline_ir_live_set_add(live, base)
    IrFieldLoadI64(dst, base, field_hash, field_index) -> pipeline_ir_live_set_add(live, base)
    IrSlotI64(slot) -> live
    IrLoadI64(dst, slot) -> pipeline_ir_live_set_add(live, slot)
    IrStoreI64(slot, value) -> pipeline_ir_live_set_add(pipeline_ir_live_set_add(live, slot), value)
    IrManagedStakeI64(dst, value, cleanup_kind, delta, origin) -> pipeline_ir_live_set_add(live, value)
    IrManagedTransferI64(call_dst, callee_hash, value, arg_lane, cleanup_kind) -> pipeline_ir_live_set_add(live, value)
    IrReuseInitI64(token, constructor) -> pipeline_ir_live_set_add_inst_uses(constructor, pipeline_ir_live_set_add(live, token))
  }
}

pub(package) fn pipeline_ir_mark_inst_live(inst: IrInst, live: PipelineIrLiveSet, facts: PipelineIrSemanticFactList) -> PipelineIrLiveSet {
  let dst = pipeline_ir_inst_def_or(inst, 0 - 1)
  let candidate = pipeline_ir_inst_is_dead_pure_candidate(inst, facts)
  if candidate == 1 {
    if dst >= 0 and pipeline_ir_live_set_contains(live, dst) == 1 {
      pipeline_ir_live_set_add_inst_uses(inst, live)
    } else {
      live
    }
  } else {
    pipeline_ir_live_set_add_inst_uses(inst, live)
  }
}

pub(package) fn pipeline_ir_mark_inst_list_live(insts: IrInstList, live: PipelineIrLiveSet, facts: PipelineIrSemanticFactList) -> PipelineIrLiveSet {
  let mut cur = insts
  let mut reversed = ir_inst_list_empty()
  let mut done = 0
  while done == 0 {
    match cur {
      IrInstNil -> { done = 1 }
      IrInstCons(inst, rest) -> {
        reversed = ir_inst_list_prepend(inst, reversed)
        cur = rest
      }
    }
  }

  let mut live_out = live
  let mut scan = reversed
  done = 0
  while done == 0 {
    match scan {
      IrInstNil -> { done = 1 }
      IrInstCons(inst, rest) -> {
        live_out = pipeline_ir_mark_inst_live(inst, live_out, facts)
        scan = rest
      }
    }
  }
  live_out
}

pub(package) fn pipeline_ir_mark_block_live(block: IrBlock, live: PipelineIrLiveSet, facts: PipelineIrSemanticFactList, all_blocks: IrBlockList) -> PipelineIrLiveSet {
  match block {
    IrBlock(id, params, insts, term) -> {
      let live_after_term = pipeline_ir_live_set_add_term_with_blocks(term, live, all_blocks)
      pipeline_ir_mark_inst_list_live(insts, live_after_term, facts)
    }
  }
}

pub(package) fn pipeline_ir_mark_block_list_live(blocks: IrBlockList, live: PipelineIrLiveSet, facts: PipelineIrSemanticFactList, all_blocks: IrBlockList) -> PipelineIrLiveSet {
  let mut cur = blocks
  let mut reversed = ir_block_list_empty()
  let mut done = 0
  while done == 0 {
    match cur {
      IrBlockListNil -> { done = 1 }
      IrBlockListCons(block, rest) -> {
        reversed = ir_block_list_prepend(block, reversed)
        cur = rest
      }
    }
  }

  cur = reversed
  let mut live_out = live
  done = 0
  while done == 0 {
    match cur {
      IrBlockListNil -> { done = 1 }
      IrBlockListCons(block, rest) -> {
        live_out = pipeline_ir_mark_block_live(block, live_out, facts, all_blocks)
        cur = rest
      }
    }
  }
  live_out
}

pub(package) fn pipeline_ir_function_live_fixpoint(blocks: IrBlockList, live: PipelineIrLiveSet, facts: PipelineIrSemanticFactList) -> PipelineIrLiveSet {
  let mut cur_live = live
  let mut done = 0
  while done == 0 {
    let next = pipeline_ir_mark_block_list_live(blocks, cur_live, facts, blocks)
    -- Length convergence is sound because live marking is monotone: live-set
    -- updates only add values and never replace or remove existing entries.
    if pipeline_ir_live_set_len(next) == pipeline_ir_live_set_len(cur_live) {
      cur_live = next
      done = 1
    } else {
      cur_live = next
    }
  }
  cur_live
}

pub(package) fn pipeline_ir_value_list_filter_live(values: IrValueList, live: PipelineIrLiveSet) -> IrValueList {
  match values {
    IrValueNil -> ir_value_list_empty()
    IrValueCons(value, rest) -> {
      let tail = pipeline_ir_value_list_filter_live(rest, live)
      if pipeline_ir_live_set_contains(live, value) == 1 {
        ir_value_list_prepend(value, tail)
      } else {
        tail
      }
    }
  }
}

pub(package) fn pipeline_ir_trim_jump_args_for_live_params(args: IrValueList, params: IrValueList, live: PipelineIrLiveSet) -> IrValueList {
  match args {
    IrValueNil -> ir_value_list_empty()
    IrValueCons(arg, arg_rest) -> {
      match params {
        IrValueNil -> ir_value_list_empty()
        IrValueCons(param, param_rest) -> {
          let tail = pipeline_ir_trim_jump_args_for_live_params(arg_rest, param_rest, live)
          if pipeline_ir_live_set_contains(live, param) == 1 {
            ir_value_list_prepend(arg, tail)
          } else {
            tail
          }
        }
      }
    }
  }
}

pub(package) fn pipeline_ir_trim_jump_args_for_target_params(blocks: IrBlockList, target: i64, args: IrValueList, live: PipelineIrLiveSet) -> IrValueList {
  match blocks {
    IrBlockListNil -> args
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          if id == target {
            pipeline_ir_trim_jump_args_for_live_params(args, params, live)
          } else {
            pipeline_ir_trim_jump_args_for_target_params(rest, target, args, live)
          }
        }
      }
    }
  }
}

pub(package) fn pipeline_ir_trim_term_jump_args(term: IrTerminator, blocks: IrBlockList, live: PipelineIrLiveSet) -> IrTerminator {
  match term {
    IrTermJump(target, args) -> {
      if ir_value_list_len(args) == 0 {
        term
      } else {
        ir_term_jump_args(target, pipeline_ir_trim_jump_args_for_target_params(blocks, target, args, live))
      }
    }
    _ -> term
  }
}

pub(package) fn pipeline_ir_trim_block_params(block: IrBlock, all_blocks: IrBlockList, live: PipelineIrLiveSet) -> IrBlock {
  match block {
    IrBlock(id, params, insts, term) -> {
      ir_block_new_params(id, pipeline_ir_value_list_filter_live(params, live), insts, pipeline_ir_trim_term_jump_args(term, all_blocks, live))
    }
  }
}

pub(package) fn pipeline_ir_trim_block_param_list(blocks: IrBlockList, all_blocks: IrBlockList, live: PipelineIrLiveSet) -> IrBlockList {
  match blocks {
    IrBlockListNil -> ir_block_list_empty()
    IrBlockListCons(block, rest) -> {
      ir_block_list_prepend(
        pipeline_ir_trim_block_params(block, all_blocks, live),
        pipeline_ir_trim_block_param_list(rest, all_blocks, live)
      )
    }
  }
}

pub(package) fn pipeline_dce_insts(insts: IrInstList, live: PipelineIrLiveSet, dead_inst_sites: i64, pure_call_dce_sites: i64) -> PipelineDceInsts {
  PipelineDceInsts(insts, live, dead_inst_sites, pure_call_dce_sites)
}

pub(package) fn pipeline_dce_insts_insts(dce: PipelineDceInsts) -> IrInstList {
  match dce {
    PipelineDceInsts(insts, live, dead_inst_sites, pure_call_dce_sites) -> insts
  }
}

pub(package) fn pipeline_dce_insts_live(dce: PipelineDceInsts) -> PipelineIrLiveSet {
  match dce {
    PipelineDceInsts(insts, live, dead_inst_sites, pure_call_dce_sites) -> live
  }
}

pub(package) fn pipeline_dce_insts_dead_inst_sites(dce: PipelineDceInsts) -> i64 {
  match dce {
    PipelineDceInsts(insts, live, dead_inst_sites, pure_call_dce_sites) -> dead_inst_sites
  }
}

pub(package) fn pipeline_dce_insts_pure_call_dce_sites(dce: PipelineDceInsts) -> i64 {
  match dce {
    PipelineDceInsts(insts, live, dead_inst_sites, pure_call_dce_sites) -> pure_call_dce_sites
  }
}

pub(package) fn pipeline_dce_sweep_ir_inst(inst: IrInst, live: PipelineIrLiveSet, facts: PipelineIrSemanticFactList) -> PipelineDceInsts {
  let dst = pipeline_ir_inst_def_or(inst, 0 - 1)
  let candidate = pipeline_ir_inst_is_dead_pure_candidate(inst, facts)
  if candidate == 1 and dst >= 0 and pipeline_ir_live_set_contains(live, dst) == 0 {
    let pure_call_dce = pipeline_ir_inst_is_semantic_pure_call_candidate(inst, facts)
    pipeline_dce_insts(ir_inst_list_empty(), live, 1, pure_call_dce)
  } else {
    match inst {
      IrCallI64(call_dst, callee_hash, args) -> {
        if callee_hash == pipeline_ir_pseudo_scaled_store64_hash() and call_dst >= 0 and pipeline_ir_live_set_contains(live, call_dst) == 0 {
          pipeline_dce_insts(ir_inst_list_prepend(ir_inst_call_i64(0 - 1, pipeline_ir_pseudo_scaled_store64_discard_hash(), args), ir_inst_list_empty()), live, 0, 0)
        } else { if callee_hash == pipeline_ir_pseudo_bridge_store64_hash() and call_dst >= 0 and pipeline_ir_live_set_contains(live, call_dst) == 0 {
          pipeline_dce_insts(ir_inst_list_prepend(ir_inst_call_i64(0 - 1, pipeline_ir_pseudo_bridge_store64_discard_hash(), args), ir_inst_list_empty()), live, 0, 0)
        } else { if callee_hash == pipeline_ir_pseudo_bridge_store8_hash() and call_dst >= 0 and pipeline_ir_live_set_contains(live, call_dst) == 0 {
          pipeline_dce_insts(ir_inst_list_prepend(ir_inst_call_i64(0 - 1, pipeline_ir_pseudo_bridge_store8_discard_hash(), args), ir_inst_list_empty()), live, 0, 0)
        } else {
          pipeline_dce_insts(ir_inst_list_prepend(inst, ir_inst_list_empty()), live, 0, 0)
        } } }
      }
      _ -> pipeline_dce_insts(ir_inst_list_prepend(inst, ir_inst_list_empty()), live, 0, 0)
    }
  }
}

pub(package) fn pipeline_dce_sweep_ir_inst_list(insts: IrInstList, live: PipelineIrLiveSet, facts: PipelineIrSemanticFactList) -> PipelineDceInsts {
  let mut cur = insts
  let mut reversed = ir_inst_list_empty()
  let mut dead_inst_sites = 0
  let mut pure_call_dce_sites = 0
  let mut done = 0
  while done == 0 {
    match cur {
      IrInstNil -> { done = 1 }
      IrInstCons(inst, rest) -> {
        let swept = pipeline_dce_sweep_ir_inst(inst, live, facts)
        dead_inst_sites = dead_inst_sites + pipeline_dce_insts_dead_inst_sites(swept)
        pure_call_dce_sites = pure_call_dce_sites + pipeline_dce_insts_pure_call_dce_sites(swept)
        match pipeline_dce_insts_insts(swept) {
          IrInstNil -> 0
          IrInstCons(out_inst, ignored_rest) -> {
            reversed = ir_inst_list_prepend(out_inst, reversed)
            0
          }
        }
        cur = rest
      }
    }
  }

  let mut scan = reversed
  let mut out = ir_inst_list_empty()
  done = 0
  while done == 0 {
    match scan {
      IrInstNil -> { done = 1 }
      IrInstCons(inst, rest) -> {
        out = ir_inst_list_prepend(inst, out)
        scan = rest
      }
    }
  }

  pipeline_dce_insts(out, live, dead_inst_sites, pure_call_dce_sites)
}

pub(package) fn pipeline_dce_sweep_ir_block(block: IrBlock, live: PipelineIrLiveSet, facts: PipelineIrSemanticFactList) -> PipelineOptimisedBlocks {
  match block {
    IrBlock(id, params, insts, term) -> {
      let dce = pipeline_dce_sweep_ir_inst_list(insts, live, facts)
      pipeline_optimised_blocks(
        ir_block_list_prepend(ir_block_new_params(id, params, pipeline_dce_insts_insts(dce), term), ir_block_list_empty()),
        0,
        0,
        0,
        pipeline_dce_insts_dead_inst_sites(dce),
        pipeline_dce_insts_pure_call_dce_sites(dce),
        0,
        0
      )
    }
  }
}

pub(package) fn pipeline_dce_sweep_ir_block_list(blocks: IrBlockList, live: PipelineIrLiveSet, facts: PipelineIrSemanticFactList) -> PipelineOptimisedBlocks {
  let mut cur = blocks
  let mut reversed = ir_block_list_empty()
  let mut dead_inst_sites = 0
  let mut pure_call_dce_sites = 0
  let mut done = 0
  while done == 0 {
    match cur {
      IrBlockListNil -> { done = 1 }
      IrBlockListCons(block, rest) -> {
        let swept = pipeline_dce_sweep_ir_block(block, live, facts)
        dead_inst_sites = dead_inst_sites + pipeline_optimised_blocks_dead_inst_sites(swept)
        pure_call_dce_sites = pure_call_dce_sites + pipeline_optimised_blocks_pure_call_dce_sites(swept)
        match pipeline_optimised_blocks_blocks(swept) {
          IrBlockListNil -> 0
          IrBlockListCons(out_block, ignored_rest) -> {
            reversed = ir_block_list_prepend(out_block, reversed)
            0
          }
        }
        cur = rest
      }
    }
  }

  let mut scan = reversed
  let mut out = ir_block_list_empty()
  done = 0
  while done == 0 {
    match scan {
      IrBlockListNil -> { done = 1 }
      IrBlockListCons(block, rest) -> {
        out = ir_block_list_prepend(block, out)
        scan = rest
      }
    }
  }

  pipeline_optimised_blocks(out, 0, 0, 0, dead_inst_sites, pure_call_dce_sites, 0, 0)
}

pub(package) fn pipeline_optimised_blocks(blocks: IrBlockList, next_value: i64, const_fold_sites: i64, algebraic_fold_sites: i64, dead_inst_sites: i64, pure_call_dce_sites: i64, block_entry_narrowing_sites: i64, direct_call_inline_sites: i64) -> PipelineOptimisedBlocks {
  PipelineOptimisedBlocks(blocks, next_value, const_fold_sites, algebraic_fold_sites, dead_inst_sites, pure_call_dce_sites, block_entry_narrowing_sites, direct_call_inline_sites)
}

pub(package) fn pipeline_optimised_blocks_blocks(opt: PipelineOptimisedBlocks) -> IrBlockList {
  match opt {
    PipelineOptimisedBlocks(blocks, next_value, const_fold_sites, algebraic_fold_sites, dead_inst_sites, pure_call_dce_sites, block_entry_narrowing_sites, direct_call_inline_sites) -> blocks
  }
}

pub(package) fn pipeline_optimised_blocks_next_value(opt: PipelineOptimisedBlocks) -> i64 {
  match opt {
    PipelineOptimisedBlocks(blocks, next_value, const_fold_sites, algebraic_fold_sites, dead_inst_sites, pure_call_dce_sites, block_entry_narrowing_sites, direct_call_inline_sites) -> next_value
  }
}

pub(package) fn pipeline_optimised_blocks_const_fold_sites(opt: PipelineOptimisedBlocks) -> i64 {
  match opt {
    PipelineOptimisedBlocks(blocks, next_value, const_fold_sites, algebraic_fold_sites, dead_inst_sites, pure_call_dce_sites, block_entry_narrowing_sites, direct_call_inline_sites) -> const_fold_sites
  }
}

pub(package) fn pipeline_optimised_blocks_algebraic_fold_sites(opt: PipelineOptimisedBlocks) -> i64 {
  match opt {
    PipelineOptimisedBlocks(blocks, next_value, const_fold_sites, algebraic_fold_sites, dead_inst_sites, pure_call_dce_sites, block_entry_narrowing_sites, direct_call_inline_sites) -> algebraic_fold_sites
  }
}

pub(package) fn pipeline_optimised_blocks_dead_inst_sites(opt: PipelineOptimisedBlocks) -> i64 {
  match opt {
    PipelineOptimisedBlocks(blocks, next_value, const_fold_sites, algebraic_fold_sites, dead_inst_sites, pure_call_dce_sites, block_entry_narrowing_sites, direct_call_inline_sites) -> dead_inst_sites
  }
}

pub(package) fn pipeline_optimised_blocks_pure_call_dce_sites(opt: PipelineOptimisedBlocks) -> i64 {
  match opt {
    PipelineOptimisedBlocks(blocks, next_value, const_fold_sites, algebraic_fold_sites, dead_inst_sites, pure_call_dce_sites, block_entry_narrowing_sites, direct_call_inline_sites) -> pure_call_dce_sites
  }
}

pub(package) fn pipeline_optimised_blocks_block_entry_narrowing_sites(opt: PipelineOptimisedBlocks) -> i64 {
  match opt {
    PipelineOptimisedBlocks(blocks, next_value, const_fold_sites, algebraic_fold_sites, dead_inst_sites, pure_call_dce_sites, block_entry_narrowing_sites, direct_call_inline_sites) -> block_entry_narrowing_sites
  }
}

pub(package) fn pipeline_optimised_blocks_direct_call_inline_sites(opt: PipelineOptimisedBlocks) -> i64 {
  match opt {
    PipelineOptimisedBlocks(blocks, next_value, const_fold_sites, algebraic_fold_sites, dead_inst_sites, pure_call_dce_sites, block_entry_narrowing_sites, direct_call_inline_sites) -> direct_call_inline_sites
  }
}

pub(package) fn pipeline_optimise_ir_block(block: IrBlock, env: PipelineIrConstEnv, ctx: PipelineIrOptimiseContext, block_facts: PipelineIrBlockEntryFactList, next_value: i64, all_blocks: IrBlockList) -> PipelineOptimisedBlocks {
  match block {
    IrBlock(id, params, insts, term) -> {
      -- One descent per block: the instruction walk consumes the resolved
      -- entry chain, not the plane (13.4% of self-compile was re-descending
      -- the block tree per fact query).
      let entry_chain = pipeline_ir_block_entry_facts_block_chain(block_facts, id)
      let opt = pipeline_optimise_ir_inst_list(insts, id, entry_chain, env, pipeline_ir_alias_env_empty(), pipeline_ir_local_fact_env(pipeline_ir_call_cse_env_empty(), pipeline_ir_tag_env_empty(), pipeline_ir_nil_env_empty()), ctx, next_value)
      let rewritten_term = pipeline_ir_rewrite_term(term, pipeline_optimised_insts_aliases(opt))
      let folded_term = pipeline_ir_fold_branch_term(rewritten_term, pipeline_optimised_insts_env(opt), id, entry_chain, all_blocks)
      pipeline_optimised_blocks(
        ir_block_list_prepend(ir_block_new_params(id, params, pipeline_optimised_insts_insts(opt), pipeline_ir_folded_term_term(folded_term)), ir_block_list_empty()),
        pipeline_optimised_insts_next_value(opt),
        pipeline_optimised_insts_const_fold_sites(opt),
        pipeline_optimised_insts_algebraic_fold_sites(opt),
        0,
        0,
        pipeline_optimised_insts_block_entry_narrowing_sites(opt) + pipeline_ir_folded_term_block_entry_narrowing_sites(folded_term),
        pipeline_optimised_insts_direct_call_inline_sites(opt)
      )
    }
  }
}

pub(package) fn pipeline_optimise_ir_block_list_with_param_consts(blocks: IrBlockList, all_blocks: IrBlockList, consts: PipelineIrConstEnv, ctx: PipelineIrOptimiseContext, block_facts: PipelineIrBlockEntryFactList, next_value: i64) -> PipelineOptimisedBlocks {
  match blocks {
    IrBlockListNil -> pipeline_optimised_blocks(ir_block_list_empty(), next_value, 0, 0, 0, 0, 0, 0)
    IrBlockListCons(block, rest) -> {
      let env = pipeline_ir_block_param_const_env(block, all_blocks, consts)
      let head = pipeline_optimise_ir_block(block, env, ctx, block_facts, next_value, all_blocks)
      let tail = pipeline_optimise_ir_block_list_with_param_consts(rest, all_blocks, consts, ctx, block_facts, pipeline_optimised_blocks_next_value(head))
      pipeline_optimised_blocks(
        ir_block_list_append(pipeline_optimised_blocks_blocks(head), pipeline_optimised_blocks_blocks(tail)),
        pipeline_optimised_blocks_next_value(tail),
        pipeline_optimised_blocks_const_fold_sites(head) + pipeline_optimised_blocks_const_fold_sites(tail),
        pipeline_optimised_blocks_algebraic_fold_sites(head) + pipeline_optimised_blocks_algebraic_fold_sites(tail),
        pipeline_optimised_blocks_dead_inst_sites(head) + pipeline_optimised_blocks_dead_inst_sites(tail),
        pipeline_optimised_blocks_pure_call_dce_sites(head) + pipeline_optimised_blocks_pure_call_dce_sites(tail),
        pipeline_optimised_blocks_block_entry_narrowing_sites(head) + pipeline_optimised_blocks_block_entry_narrowing_sites(tail),
        pipeline_optimised_blocks_direct_call_inline_sites(head) + pipeline_optimised_blocks_direct_call_inline_sites(tail)
      )
    }
  }
}

-- Const-argument jump threading: a jump feeding a known-const bool to an
-- empty single-param merge that immediately branches on that param can
-- jump straight to the decided successor. The short-circuit lowering's
-- const path then bypasses the merge, leaving it single-pred so merge
-- param aliasing and fact propagation see through it. Conservative
-- gates: the merge has exactly one param, no instructions, branches on
-- the param, the param is used nowhere else, and the decided successor
-- takes no params.
pub(package) fn pipeline_ir_thread_find_const(insts: IrInstList, value: i64) -> PipelineIrConstLookup {
  match insts {
    IrInstNil -> pipeline_ir_const_lookup(0, 0)
    IrInstCons(inst, rest) -> {
      match inst {
        IrConstI64(dst, cval) -> if dst == value { pipeline_ir_const_lookup(1, cval) } else { pipeline_ir_thread_find_const(rest, value) }
        _ -> pipeline_ir_thread_find_const(rest, value)
      }
    }
  }
}

-- node(0, 1, then, else, param) for a threadable merge, or 0.
pub(package) fn pipeline_ir_thread_merge_shape(blocks: IrBlockList, target_id: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          if id == target_id {
            match insts {
              IrInstNil -> {
                match params {
                  IrValueCons(p, prest) -> {
                    match prest {
                      IrValueNil -> {
                        match term {
                          IrTermBranch(cond, then_block, else_block) -> {
                            if cond == p { node_new(0, 1, then_block, else_block, p) } else { 0 }
                          }
                          _ -> 0
                        }
                      }
                      _ -> 0
                    }
                  }
                  IrValueNil -> 0
                }
              }
              _ -> 0
            }
          } else { pipeline_ir_thread_merge_shape(rest, target_id) }
        }
      }
    }
  }
}

pub(package) fn pipeline_ir_thread_param_used_elsewhere(blocks: IrBlockList, merge_id: i64, param: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          let mut used = 0
          let mut cur = insts
          let mut done = 0
          while done == 0 {
            match cur {
              IrInstNil -> { done = 1 }
              IrInstCons(inst, tail) -> {
                let mut uses = pipeline_ir_live_set_add_inst_uses(inst, pipeline_ir_live_set_empty())
                let mut udone = 0
                while udone == 0 {
                  match uses {
                    PipelineIrLiveSetNil -> { udone = 1 }
                    PipelineIrLiveSetCons(u, urest) -> {
                      if u == param { used = 1 } else { 0 }
                      uses = urest
                    }
                    PipelineIrLiveSetBits(ua, uw, uc) -> { udone = 1 }
                  }
                }
                cur = tail
              }
            }
          }
          if used == 0 and id != merge_id {
            let mut tuses = pipeline_ir_native_resident_term_uses(term)
            let mut tdone = 0
            while tdone == 0 {
              match tuses {
                PipelineIrLiveSetNil -> { tdone = 1 }
                PipelineIrLiveSetCons(tu, trest) -> {
                  if tu == param { used = 1 } else { 0 }
                  tuses = trest
                }
                PipelineIrLiveSetBits(ta, tw, tc) -> { tdone = 1 }
              }
            }
          } else { 0 }
          if used == 1 { 1 } else { pipeline_ir_thread_param_used_elsewhere(rest, merge_id, param) }
        }
      }
    }
  }
}

pub(package) fn pipeline_ir_block_has_params(blocks: IrBlockList, target_id: i64) -> i64 {
  match pipeline_ir_block_params_or(blocks, target_id, ir_value_list_empty()) {
    IrValueNil -> 0
    IrValueCons(p, rest) -> 1
  }
}

pub(package) fn pipeline_ir_thread_const_arg_jumps(blocks: IrBlockList, all_blocks: IrBlockList) -> IrBlockList {
  match blocks {
    IrBlockListNil -> IrBlockListNil
    IrBlockListCons(block, rest) -> {
      let threaded = match block {
        IrBlock(id, params, insts, term) -> {
          match term {
            IrTermJump(target, args) -> {
              match args {
                IrValueCons(a, arest) -> {
                  match arest {
                    IrValueNil -> {
                      let shape = pipeline_ir_thread_merge_shape(all_blocks, target)
                      if shape != 0 {
                        let cval = pipeline_ir_thread_find_const(insts, a)
                        if pipeline_ir_const_lookup_valid(cval) == 1 and pipeline_ir_thread_param_used_elsewhere(all_blocks, target, node_f4(shape)) == 0 {
                          let new_target = if pipeline_ir_const_lookup_value(cval) != 0 { node_f2(shape) } else { node_f3(shape) }
                          if pipeline_ir_block_has_params(all_blocks, new_target) == 0 {
                            ir_block_new_params(id, params, insts, ir_term_jump(new_target))
                          } else { block }
                        } else { block }
                      } else { block }
                    }
                    _ -> block
                  }
                }
                IrValueNil -> block
              }
            }
            _ -> block
          }
        }
      }
      IrBlockListCons(threaded, pipeline_ir_thread_const_arg_jumps(rest, all_blocks))
    }
  }
}

-- ── jump-chain merging ──
-- The CFG call lowering splits every call into its own block; once the
-- fold rewrites or inlines the call away, the fragmentation remains and
-- hides straight-line code from the block-local passes (value numbering,
-- fact envs) and inflates block counts against the fact-plane limits.
-- Merge one level of A --jump--> B per fold round, where B's only
-- predecessor is that jump and B is not the entry: B's params are
-- globally substituted by A's jump args, B's body appends to A. Chains
-- collapse over successive rounds. A consumed B always jumps to a
-- non-consumed block (its pred is mergeable, which disqualifies its own
-- consumption this round), so appends never cascade within one round.

pub(package) fn pipeline_ir_merge_bind_params(env: PipelineIrAliasEnv, params: IrValueList, args: IrValueList) -> PipelineIrAliasEnv {
  match params {
    IrValueNil -> env
    IrValueCons(param, param_rest) -> {
      match args {
        IrValueNil -> env
        IrValueCons(arg, arg_rest) -> pipeline_ir_merge_bind_params(pipeline_ir_alias_env_bind(env, param, arg), param_rest, arg_rest)
      }
    }
  }
}

pub(package) fn pipeline_ir_merge_find_body(blocks: IrBlockList, target: i64) -> IrBlockList {
  match blocks {
    IrBlockListNil -> IrBlockListNil
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          if id == target { blocks } else { pipeline_ir_merge_find_body(rest, target) }
        }
      }
    }
  }
}

pub(package) fn pipeline_ir_rewrite_inst_list_uses(insts: IrInstList, env: PipelineIrAliasEnv) -> IrInstList {
  match insts {
    IrInstNil -> IrInstNil
    IrInstCons(inst, rest) -> IrInstCons(pipeline_ir_rewrite_inst_uses(inst, env), pipeline_ir_rewrite_inst_list_uses(rest, env))
  }
}

pub(package) fn pipeline_ir_inst_multi_lane_capture_uses(inst: IrInst, value: i64) -> i64 {
  match inst {
    IrClosureI64(dst, f, captures, evidence) -> {
      let n = if captures == 0 { 0 } else { nlist_len(captures) }
      let mut found = 0
      let mut i = 0
      while i < n and found == 0 {
        let capture = nlist_get(captures, i)
        let lanes = pipeline_capture_lane_count(capture)
        if lanes > 1 and value >= node_f3(capture) and value < node_f3(capture) + lanes { found = 1 } else { 0 }
        i = i + 1
      }
      found
    }
    -- Flat structural cleanup has the same head-plus-consecutive-lanes
    -- contract as a multi-lane closure capture. Keep the block-parameter
    -- materialisation boundary that established that adjacency; independently
    -- aliasing its lanes can place unrelated SSA definitions between them.
    IrStructuralDropI64(base, plan) -> {
      let words = pipeline_structural_drop_plan_use_words(plan)
      if words > 1 and value >= base and value < base + words { 1 } else { 0 }
    }
    IrStructuralSlotI64(base, slot, plan, mode) -> {
      let words = pipeline_structural_drop_plan_use_words(plan)
      if (mode == 1 or mode == 2 or mode == 3 or mode == 4 or mode == 5) and
        words > 1 and value >= base and value < base + words { 1 } else { 0 }
    }
    IrStructuralSplitI64(base, parent_plan, residual_plan, release_backing) -> {
      let words = pipeline_structural_drop_plan_use_words(parent_plan)
      if words > 1 and value >= base and value < base + words { 1 } else { 0 }
    }
    _ -> 0
  }
}

pub(package) fn pipeline_ir_inst_list_multi_lane_capture_uses(insts: IrInstList, value: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      if pipeline_ir_inst_multi_lane_capture_uses(inst, value) == 1 { 1 }
      else { pipeline_ir_inst_list_multi_lane_capture_uses(rest, value) }
    }
  }
}

pub(package) fn pipeline_ir_blocks_multi_lane_capture_use(blocks: IrBlockList, value: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> match block {
      IrBlock(id, params, insts, term) -> {
        if pipeline_ir_inst_list_multi_lane_capture_uses(insts, value) == 1 { 1 }
        else { pipeline_ir_blocks_multi_lane_capture_use(rest, value) }
      }
    }
  }
}

pub(package) fn pipeline_ir_value_list_feeds_multi_lane_capture(values: IrValueList, blocks: IrBlockList) -> i64 {
  match values {
    IrValueNil -> 0
    IrValueCons(value, rest) -> {
      if pipeline_ir_blocks_multi_lane_capture_use(blocks, value) == 1 { 1 }
      else { pipeline_ir_value_list_feeds_multi_lane_capture(rest, blocks) }
    }
  }
}

pub(package) fn pipeline_ir_block_params_feed_multi_lane_capture(blocks: IrBlockList, target: i64) -> i64 {
  pipeline_ir_value_list_feeds_multi_lane_capture(
    pipeline_ir_block_params_or(blocks, target, ir_value_list_empty()),
    blocks
  )
}

pub(package) fn pipeline_ir_merge_jump_chains_once(blocks: IrBlockList) -> IrBlockList {
  let max_id = pipeline_ir_native_resident_max_block_id(blocks)
  if max_id < 0 { blocks }
  else {
    let n = max_id + 1
    let pred_count = pipeline_ir_native_resident_dense_new(n, 0)
    let jump_pred = pipeline_ir_native_resident_dense_new(n, 0 - 1)
    pipeline_ir_native_resident_count_preds(blocks, pred_count, jump_pred, max_id)
    let entry = match blocks {
      IrBlockListNil -> 0 - 1
      IrBlockListCons(block, rest) -> match block { IrBlock(id, params, insts, term) -> id }
    }
    -- mergeable: single pred, reached by a jump, not entry, not a self-loop
    let mergeable = pipeline_ir_native_resident_dense_new(n, 0)
    let mut i = 0
    while i < n {
      let jp = nlist_get(jump_pred, i)
      -- Multi-lane captures and flat structural cleanup retain the typed
      -- value-shape invariant that every lane follows the logical head. The
      -- merge alias environment rewrites block params independently and
      -- globally, so consuming one of those materialisation boundaries could
      -- turn a head rewrite into a false adjacency claim. Keep precisely the
      -- boundaries that establish such ranges.
      if nlist_get(pred_count, i) == 1 and jp >= 0 and jp != i and i != entry and pipeline_ir_block_params_feed_multi_lane_capture(blocks, i) == 0 {
        pipeline_ir_native_resident_dense_set(mergeable, i, 1)
      } else { 0 }
      i = i + 1
    }
    -- consumed this round: mergeable AND the pred is not itself mergeable
    let consumed = pipeline_ir_native_resident_dense_new(n, 0)
    let mut any = 0
    let mut c = 0
    while c < n {
      if nlist_get(mergeable, c) == 1 {
        let jp2 = nlist_get(jump_pred, c)
        if jp2 >= 0 and jp2 <= max_id and nlist_get(mergeable, jp2) == 0 {
          pipeline_ir_native_resident_dense_set(consumed, c, 1)
          any = 1
        } else { 0 }
      } else { 0 }
      c = c + 1
    }
    if any == 0 { blocks }
    else {
      -- alias env: consumed block params -> the consuming jump's args
      let mut env = pipeline_ir_alias_env_empty()
      let mut cur = blocks
      let mut walking = 1
      while walking == 1 {
        match cur {
          IrBlockListNil -> { walking = 0 }
          IrBlockListCons(block, rest) -> {
            match block {
              IrBlock(id, params, insts, term) -> {
                match term {
                  IrTermJump(target, args) -> {
                    if target >= 0 and target <= max_id and nlist_get(consumed, target) == 1 and nlist_get(jump_pred, target) == id {
                      let target_params = pipeline_ir_block_params_or(blocks, target, ir_value_list_empty())
                      env = pipeline_ir_merge_bind_params(env, target_params, args)
                    } else { 0 }
                  }
                  _ -> 0
                }
              }
            }
            cur = rest
          }
        }
      }
      pipeline_ir_merge_rebuild(blocks, blocks, consumed, max_id, env)
    }
  }
}

pub(package) fn pipeline_ir_merge_rebuild(scan: IrBlockList, all_blocks: IrBlockList, consumed: i64, max_id: i64, env: PipelineIrAliasEnv) -> IrBlockList {
  match scan {
    IrBlockListNil -> IrBlockListNil
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          if id >= 0 and id <= max_id and nlist_get(consumed, id) == 1 {
            pipeline_ir_merge_rebuild(rest, all_blocks, consumed, max_id, env)
          } else {
            let new_insts = pipeline_ir_rewrite_inst_list_uses(insts, env)
            let new_term = pipeline_ir_rewrite_term(term, env)
            let merged = match new_term {
              IrTermJump(target, args) -> {
                if target >= 0 and target <= max_id and nlist_get(consumed, target) == 1 {
                  match pipeline_ir_merge_find_body(all_blocks, target) {
                    IrBlockListNil -> ir_block_new_params(id, params, new_insts, new_term)
                    IrBlockListCons(tblock, trest) -> {
                      match tblock {
                        IrBlock(tid, tparams, tinsts, tterm) -> {
                          ir_block_new_params(id, params, ir_inst_list_append(new_insts, pipeline_ir_rewrite_inst_list_uses(tinsts, env)), pipeline_ir_rewrite_term(tterm, env))
                        }
                      }
                    }
                  }
                } else {
                  ir_block_new_params(id, params, new_insts, new_term)
                }
              }
              _ -> ir_block_new_params(id, params, new_insts, new_term)
            }
            IrBlockListCons(merged, pipeline_ir_merge_rebuild(rest, all_blocks, consumed, max_id, env))
          }
        }
      }
    }
  }
}


-- ── loop-invariant code motion ──
-- Pure instructions (consts, i64/float binaries, unaries) whose
-- operands are all defined outside a loop hoist to the loop's
-- preheader: block-local value numbering cannot span a backedge, so a
-- loop body recomputes row bases and re-materialises fallback consts
-- on every iteration. A loop is a backedge S --> T with T dominating S;
-- its body is T, S, and every block that reaches S without passing T;
-- the preheader is T's unique non-backedge predecessor when it ends in
-- a plain jump. Hoisted operands must be function params or defined in
-- a block dominating the preheader (the verifier's kind-7 dominance
-- check now backstops this gate after every transform). Innermost
-- loops hoist first; iterating the fold re-hoists through outer levels.

pub(package) fn pipeline_ir_licm_value_def_blocks(blocks: IrBlockList, next_value: i64) -> i64 {
  let map = pipeline_ir_native_resident_dense_new(next_value, 0 - 1)
  let mut cur = blocks
  let mut walking = 1
  while walking == 1 {
    match cur {
      IrBlockListNil -> { walking = 0 }
      IrBlockListCons(block, rest) -> {
        match block {
          IrBlock(id, params, insts, term) -> {
            let mut pcur = params
            let mut pdone = 0
            while pdone == 0 {
              match pcur {
                IrValueNil -> { pdone = 1 }
                IrValueCons(p, prest) -> {
                  if p >= 0 and p < next_value { pipeline_ir_native_resident_dense_set(map, p, id) } else { 0 }
                  pcur = prest
                }
              }
            }
            let mut icur = insts
            let mut idone = 0
            while idone == 0 {
              match icur {
                IrInstNil -> { idone = 1 }
                IrInstCons(inst, irest) -> {
                  let d = pipeline_ir_inst_def_or(inst, 0 - 1)
                  if d >= 0 and d < next_value { pipeline_ir_native_resident_dense_set(map, d, id) } else { 0 }
                  icur = irest
                }
              }
            }
          }
        }
        cur = rest
      }
    }
  }
  map
}

pub(package) fn pipeline_ir_licm_inst_pure(inst: IrInst) -> i64 {
  match inst {
    IrConstI64(dst, value) -> 1
    IrNilI64(dst) -> 1
    IrBinaryI64(dst, op, lhs, rhs) -> 1
    IrFloatBinaryI64(dst, prim, op, lhs, rhs) -> 1
    IrUnaryI64(dst, op, value) -> 1
    _ -> 0
  }
}

pub(package) fn pipeline_ir_licm_operand_ok(v: i64, param_count: i64, def_blocks: i64, next_value: i64, in_loop: i64, dom_sets: i64, dom_max: i64, dom_words: i64, pre: i64) -> i64 {
  -- Only true function params are entry-defined; the value counter
  -- starts at nparams, so ids in [nparams, 8) are ordinary body temps
  -- that may be loop-defined (treating them as invariant miscompiled).
  if v < param_count { 1 }
  else { if v < 0 or v >= next_value { 0 }
  else {
    let db = nlist_get(def_blocks, v)
    if db < 0 { 0 }
    else { if nlist_get(in_loop, db) == 1 { 0 }
    else {
      if db == pre { 1 }
      else { if db >= 0 and db <= dom_max and pre >= 0 and pre <= dom_max {
        pipeline_ir_native_dominators_bit_get_checked(dom_sets, dom_words, pre, db)
      } else { 0 } }
    } }
  } }
}

pub(package) fn pipeline_ir_native_dominators_bit_get_checked(dom_sets: i64, dom_words: i64, block: i64, other: i64) -> i64 {
  pipeline_ir_dominators_bit_get(dom_sets, dom_words, block, other)
}

pub(package) fn pipeline_ir_licm_inst_operands_ok(inst: IrInst, param_count: i64, def_blocks: i64, next_value: i64, in_loop: i64, dom_sets: i64, dom_max: i64, dom_words: i64, pre: i64) -> i64 {
  match inst {
    IrConstI64(dst, value) -> 1
    IrNilI64(dst) -> 1
    IrBinaryI64(dst, op, lhs, rhs) -> {
      if pipeline_ir_licm_operand_ok(lhs, param_count, def_blocks, next_value, in_loop, dom_sets, dom_max, dom_words, pre) == 1 {
        pipeline_ir_licm_operand_ok(rhs, param_count, def_blocks, next_value, in_loop, dom_sets, dom_max, dom_words, pre)
      } else { 0 }
    }
    IrFloatBinaryI64(dst, prim, op, lhs, rhs) -> {
      if pipeline_ir_licm_operand_ok(lhs, param_count, def_blocks, next_value, in_loop, dom_sets, dom_max, dom_words, pre) == 1 {
        pipeline_ir_licm_operand_ok(rhs, param_count, def_blocks, next_value, in_loop, dom_sets, dom_max, dom_words, pre)
      } else { 0 }
    }
    IrUnaryI64(dst, op, value) -> pipeline_ir_licm_operand_ok(value, param_count, def_blocks, next_value, in_loop, dom_sets, dom_max, dom_words, pre)
    _ -> 0
  }
}

pub(package) fn pipeline_ir_licm_hoist_one_loop(blocks: IrBlockList, param_count: i64, s: i64, t: i64, max_id: i64, dom_sets: i64, dom_words: i64) -> IrBlockList {
  -- loop membership: T, S, and blocks reaching S without passing T
  let n = max_id + 1
  let in_loop = pipeline_ir_native_resident_dense_new(n, 0)
  pipeline_ir_native_resident_dense_set(in_loop, t, 1)
  pipeline_ir_native_resident_dense_set(in_loop, s, 1)
  let mut b = 0
  while b < n {
    if nlist_get(in_loop, b) == 0 and b != t {
      if pipeline_ir_dominators_bit_get(dom_sets, dom_words, b, t) == 1 {
        if b == s or pipeline_ir_block_reaches_avoiding(blocks, max_id, b, s, t) == 1 {
          pipeline_ir_native_resident_dense_set(in_loop, b, 1)
        } else { 0 }
      } else { 0 }
    } else { 0 }
    b = b + 1
  }
  -- preheader: T's unique non-backedge jump predecessor
  let mut pre = 0 - 1
  let mut pre_count = 0
  let mut pcur = blocks
  let mut pwalk = 1
  while pwalk == 1 {
    match pcur {
      IrBlockListNil -> { pwalk = 0 }
      IrBlockListCons(block, rest) -> {
        match block {
          IrBlock(id, params, insts, term) -> {
            let hits = pipeline_ir_term_predecessor_count(term, t)
            if hits > 0 and nlist_get(in_loop, id) == 0 {
              pre_count = pre_count + hits
              match term {
                IrTermJump(target, args) -> { pre = id }
                _ -> { pre = 0 - 1 }
              }
            } else { 0 }
          }
        }
        pcur = rest
      }
    }
  }
  if pre < 0 or pre_count != 1 { blocks }
  else {
    let next_value = pipeline_ir_function_next_value(param_count, blocks)
    let def_blocks = pipeline_ir_licm_value_def_blocks(blocks, next_value)
    -- collect hoistable insts from loop blocks, fixpoint so chains
    -- (const feeding a mul) hoist together; hoisted defs re-mark as
    -- preheader-resident for later candidates
    let hoisted = nlist_new()
    let mut changed = 1
    while changed == 1 {
      changed = 0
      let mut hcur = blocks
      let mut hwalk = 1
      while hwalk == 1 {
        match hcur {
          IrBlockListNil -> { hwalk = 0 }
          IrBlockListCons(block, rest) -> {
            match block {
              IrBlock(id, params, insts, term) -> {
                if id >= 0 and id <= max_id and nlist_get(in_loop, id) == 1 {
                  let mut icur = insts
                  let mut idone = 0
                  while idone == 0 {
                    match icur {
                      IrInstNil -> { idone = 1 }
                      IrInstCons(inst, irest) -> {
                        let d = pipeline_ir_inst_def_or(inst, 0 - 1)
                        let already = if d >= 0 and d < next_value { if nlist_get(def_blocks, d) == pre { 1 } else { 0 } } else { 1 }
                        if already == 0 and pipeline_ir_licm_inst_pure(inst) == 1 and pipeline_ir_licm_inst_operands_ok(inst, param_count, def_blocks, next_value, in_loop, dom_sets, max_id, dom_words, pre) == 1 {
                          nlist_add(hoisted, d)
                          changed = 0
                        } else { 0 }
                        icur = irest
                      }
                    }
                  }
                } else { 0 }
              }
            }
            hcur = rest
          }
        }
      }
    }
    if nlist_len(hoisted) == 0 { blocks }
    else {
      pipeline_ir_licm_rebuild(blocks, in_loop, max_id, pre, hoisted)
    }
  }
}

pub(package) fn pipeline_ir_licm_value_in_list(list: i64, v: i64) -> i64 {
  pipeline_ir_native_int_list_contains(list, v)
}

pub(package) fn pipeline_ir_licm_rebuild(blocks: IrBlockList, in_loop: i64, max_id: i64, pre: i64, hoisted: i64) -> IrBlockList {
  -- first sweep: pull hoisted insts (in block order, which preserves
  -- their original dependency order) out of loop blocks
  let mut collected = ir_inst_list_empty()
  let mut cur = blocks
  let mut walking = 1
  let mut kept_blocks = IrBlockListNil
  while walking == 1 {
    match cur {
      IrBlockListNil -> { walking = 0 }
      IrBlockListCons(block, rest) -> {
        match block {
          IrBlock(id, params, insts, term) -> {
            if id >= 0 and id <= max_id and nlist_get(in_loop, id) == 1 {
              let mut keep = ir_inst_list_empty()
              let mut icur = insts
              let mut idone = 0
              while idone == 0 {
                match icur {
                  IrInstNil -> { idone = 1 }
                  IrInstCons(inst, irest) -> {
                    let d = pipeline_ir_inst_def_or(inst, 0 - 1)
                    if d >= 0 and pipeline_ir_licm_value_in_list(hoisted, d) == 1 {
                      collected = ir_inst_list_append(collected, ir_inst_list_prepend(inst, ir_inst_list_empty()))
                    } else {
                      keep = ir_inst_list_append(keep, ir_inst_list_prepend(inst, ir_inst_list_empty()))
                    }
                    icur = irest
                  }
                }
              }
              kept_blocks = pipeline_ir_licm_blocks_append(kept_blocks, ir_block_new_params(id, params, keep, term))
            } else {
              kept_blocks = pipeline_ir_licm_blocks_append(kept_blocks, block)
            }
          }
        }
        cur = rest
      }
    }
  }
  -- order the collected insts by dependency: block order is not
  -- dominance order, so an inst may precede its operand's def in the
  -- raw sweep. Repeatedly append insts whose hoisted operands are all
  -- already emitted.
  let ordered = pipeline_ir_licm_order_collected(collected, hoisted)
  -- second sweep: append the ordered insts to the preheader
  let mut final_blocks = IrBlockListNil
  let mut fcur = kept_blocks
  let mut fwalk = 1
  while fwalk == 1 {
    match fcur {
      IrBlockListNil -> { fwalk = 0 }
      IrBlockListCons(block, rest) -> {
        match block {
          IrBlock(id, params, insts, term) -> {
            if id == pre {
              final_blocks = pipeline_ir_licm_blocks_append(final_blocks, ir_block_new_params(id, params, ir_inst_list_append(insts, ordered), term))
            } else {
              final_blocks = pipeline_ir_licm_blocks_append(final_blocks, block)
            }
          }
        }
        fcur = rest
      }
    }
  }
  final_blocks
}

pub(package) fn pipeline_ir_licm_inst_operands_emitted(inst: IrInst, pending: i64) -> i64 {
  match inst {
    IrBinaryI64(dst, op, lhs, rhs) -> {
      if pipeline_ir_native_int_list_contains(pending, lhs) == 1 { 0 }
      else { if pipeline_ir_native_int_list_contains(pending, rhs) == 1 { 0 } else { 1 } }
    }
    IrFloatBinaryI64(dst, prim, op, lhs, rhs) -> {
      if pipeline_ir_native_int_list_contains(pending, lhs) == 1 { 0 }
      else { if pipeline_ir_native_int_list_contains(pending, rhs) == 1 { 0 } else { 1 } }
    }
    IrUnaryI64(dst, op, value) -> if pipeline_ir_native_int_list_contains(pending, value) == 1 { 0 } else { 1 }
    _ -> 1
  }
}

pub(package) fn pipeline_ir_licm_order_collected(collected: IrInstList, hoisted: i64) -> IrInstList {
  let pending = nlist_new()
  let n = nlist_len(hoisted)
  let mut i = 0
  while i < n {
    nlist_add(pending, nlist_get(hoisted, i))
    i = i + 1
  }
  let mut ordered = ir_inst_list_empty()
  let mut remaining = collected
  let mut rounds = 0
  while nlist_len(pending) > 0 and rounds < n + 2 {
    let mut next_remaining = ir_inst_list_empty()
    let mut cur = remaining
    let mut done = 0
    while done == 0 {
      match cur {
        IrInstNil -> { done = 1 }
        IrInstCons(inst, rest) -> {
          if pipeline_ir_licm_inst_operands_emitted(inst, pending) == 1 {
            ordered = ir_inst_list_append(ordered, ir_inst_list_prepend(inst, ir_inst_list_empty()))
            let d = pipeline_ir_inst_def_or(inst, 0 - 1)
            pipeline_ir_licm_pending_remove(pending, d)
          } else {
            next_remaining = ir_inst_list_append(next_remaining, ir_inst_list_prepend(inst, ir_inst_list_empty()))
          }
          cur = rest
        }
      }
    }
    remaining = next_remaining
    rounds = rounds + 1
  }
  -- anything left unplaced (should not happen) is appended to keep the
  -- defs present; the verifier flags ordering if it ever fires
  ir_inst_list_append(ordered, remaining)
}

pub(package) fn pipeline_ir_licm_pending_remove(pending: i64, v: i64) -> i64 {
  let n = nlist_len(pending)
  let mut i = 0
  let mut found = 0 - 1
  while i < n and found < 0 {
    if nlist_get(pending, i) == v { found = i } else { i = i + 1 }
  }
  if found >= 0 {
    pipeline_ir_native_resident_dense_set(pending, found, nlist_get(pending, n - 1))
    nlist_set_len(pending, n - 1)
  } else { 0 }
}

pub(package) fn pipeline_ir_licm_blocks_append(blocks: IrBlockList, block: IrBlock) -> IrBlockList {
  match blocks {
    IrBlockListNil -> IrBlockListCons(block, IrBlockListNil)
    IrBlockListCons(head, rest) -> IrBlockListCons(head, pipeline_ir_licm_blocks_append(rest, block))
  }
}

pub(package) fn pipeline_ir_licm_has_candidate_backedge(blocks: IrBlockList, max_id: i64) -> i64 {
  -- cheap pre-gate: a jump whose target's entry precedes it in layout
  -- order is the only shape that can be a backedge; skip the dominator
  -- computation entirely for straight-line functions.
  let entry_pos = pipeline_ir_native_resident_dense_new(max_id + 1, 0 - 1)
  let mut pos = 0
  let mut cur = blocks
  let mut walking = 1
  while walking == 1 {
    match cur {
      IrBlockListNil -> { walking = 0 }
      IrBlockListCons(block, rest) -> {
        match block {
          IrBlock(id, params, insts, term) -> {
            if id >= 0 and id <= max_id { pipeline_ir_native_resident_dense_set(entry_pos, id, pos) } else { 0 }
            pos = pos + 1
          }
        }
        cur = rest
      }
    }
  }
  let mut found = 0
  let mut pos2 = 0
  let mut cur2 = blocks
  let mut walking2 = 1
  while walking2 == 1 {
    match cur2 {
      IrBlockListNil -> { walking2 = 0 }
      IrBlockListCons(block, rest) -> {
        match block {
          IrBlock(id, params, insts, term) -> {
            match term {
              IrTermJump(target, args) -> {
                if target >= 0 and target <= max_id and nlist_get(entry_pos, target) >= 0 and nlist_get(entry_pos, target) <= pos2 { found = 1 } else { 0 }
              }
              _ -> 0
            }
            pos2 = pos2 + 1
          }
        }
        cur2 = rest
      }
    }
  }
  found
}

pub(package) fn pipeline_ir_hoist_loop_invariants(blocks: IrBlockList, param_count: i64) -> IrBlockList {
  let max_id = pipeline_ir_native_resident_max_block_id(blocks)
  if max_id < 0 or max_id > 63 or ir_block_list_len(blocks) > 64 { blocks }
  else { if pipeline_ir_licm_has_candidate_backedge(blocks, max_id) == 0 { blocks }
  else {
    let dom_sets = pipeline_ir_dominators(blocks, max_id)
    let dom_words = pipeline_ir_dominators_words(max_id)
    -- find backedges S -> T (T dominates S) and hoist each loop once;
    -- innermost first is approximated by processing deeper targets
    -- first (higher entry gpos = later block), and the fold fixpoint
    -- re-runs the pass for chained levels.
    let mut result = blocks
    let mut scan = blocks
    let mut walking = 1
    while walking == 1 {
      match scan {
        IrBlockListNil -> { walking = 0 }
        IrBlockListCons(block, rest) -> {
          match block {
            IrBlock(id, params, insts, term) -> {
              match term {
                IrTermJump(target, args) -> {
                  if target >= 0 and target <= max_id and id >= 0 and id <= max_id {
                    if pipeline_ir_dominators_bit_get(dom_sets, dom_words, id, target) == 1 {
                      result = pipeline_ir_licm_hoist_one_loop(result, param_count, id, target, max_id, dom_sets, dom_words)
                    } else { 0 }
                  } else { 0 }
                }
                _ -> 0
              }
            }
          }
          scan = rest
        }
      }
    }
    result
  } }
}

-- Collapse whole chains before the next fold round: one merge level per
-- call, iterated to a fixpoint here so the fold's own fixpoint does not
-- spend a full (fact pass + walk) round per chain link.
pub(package) fn pipeline_ir_merge_jump_chains(blocks: IrBlockList) -> IrBlockList {
  let mut cur = blocks
  let mut prev_count = ir_block_list_len(cur) + 1
  while ir_block_list_len(cur) < prev_count {
    prev_count = ir_block_list_len(cur)
    cur = pipeline_ir_merge_jump_chains_once(cur)
  }
  cur
}


pub(package) fn pipeline_ir_cfg_fold_once(blocks: IrBlockList, ctx: PipelineIrOptimiseContext, next_value: i64) -> PipelineOptimisedBlocks {
  let consts = pipeline_ir_const_env_from_block_list(blocks, pipeline_ir_const_env_empty())
  let block_facts = pipeline_ir_block_entry_facts_from_blocks_with_pure(blocks, pipeline_ir_optimise_context_pure_callees(ctx))
  let folded = pipeline_optimise_ir_block_list_with_param_consts(blocks, blocks, consts, ctx, block_facts, next_value)
  let folded_raw = pipeline_optimised_blocks_blocks(folded)
  let threaded_blocks = pipeline_ir_thread_const_arg_jumps(folded_raw, folded_raw)
  let merged_blocks = pipeline_ir_merge_jump_chains(threaded_blocks)
  let hoisted_blocks = pipeline_ir_hoist_loop_invariants(merged_blocks, pipeline_ir_optimise_context_fn_param_count(ctx))
  let reachable_blocks = pipeline_ir_filter_reachable_blocks(hoisted_blocks)
  pipeline_optimised_blocks(
    reachable_blocks,
    pipeline_optimised_blocks_next_value(folded),
    pipeline_optimised_blocks_const_fold_sites(folded),
    pipeline_optimised_blocks_algebraic_fold_sites(folded),
    0,
    0,
    pipeline_optimised_blocks_block_entry_narrowing_sites(folded),
    pipeline_optimised_blocks_direct_call_inline_sites(folded)
  )
}

pub(package) fn pipeline_ir_cfg_fold_fixpoint(
  blocks: IrBlockList,
  ctx: PipelineIrOptimiseContext,
  next_value: i64,
  remaining: i64,
  prev_block_count: i64,
  prev_inst_count: i64,
  prev_binary_count: i64,
  prev_branch_count: i64
) -> PipelineOptimisedBlocks {
  let step = pipeline_ir_cfg_fold_once(blocks, ctx, next_value)
  let step_blocks = pipeline_optimised_blocks_blocks(step)
  let step_block_count = ir_block_list_len(step_blocks)
  let step_inst_count = ir_block_list_inst_count(step_blocks)
  let step_binary_count = ir_block_list_count_tag(step_blocks, 2)
  let step_branch_count = ir_block_list_count_term_tag(step_blocks, 3)
  let stable = step_block_count == prev_block_count and step_inst_count == prev_inst_count and step_binary_count == prev_binary_count and step_branch_count == prev_branch_count
  if remaining <= 1 or stable {
    step
  } else {
    let tail = pipeline_ir_cfg_fold_fixpoint(
      step_blocks,
      ctx,
      pipeline_optimised_blocks_next_value(step),
      remaining - 1,
      step_block_count,
      step_inst_count,
      step_binary_count,
      step_branch_count
    )
    pipeline_optimised_blocks(
      pipeline_optimised_blocks_blocks(tail),
      pipeline_optimised_blocks_next_value(tail),
      pipeline_optimised_blocks_const_fold_sites(step) + pipeline_optimised_blocks_const_fold_sites(tail),
      pipeline_optimised_blocks_algebraic_fold_sites(step) + pipeline_optimised_blocks_algebraic_fold_sites(tail),
      0,
      0,
      pipeline_optimised_blocks_block_entry_narrowing_sites(step) + pipeline_optimised_blocks_block_entry_narrowing_sites(tail),
      pipeline_optimised_blocks_direct_call_inline_sites(step) + pipeline_optimised_blocks_direct_call_inline_sites(tail)
    )
  }
}

pub(package) fn pipeline_optimised_functions(functions: IrFunctionList, const_fold_sites: i64, algebraic_fold_sites: i64, dead_inst_sites: i64, pure_call_dce_sites: i64, block_entry_narrowing_sites: i64, direct_call_inline_sites: i64) -> PipelineOptimisedFunctions {
  PipelineOptimisedFunctions(functions, const_fold_sites, algebraic_fold_sites, dead_inst_sites, pure_call_dce_sites, block_entry_narrowing_sites, direct_call_inline_sites)
}

pub(package) fn pipeline_optimised_functions_functions(opt: PipelineOptimisedFunctions) -> IrFunctionList {
  match opt {
    PipelineOptimisedFunctions(functions, const_fold_sites, algebraic_fold_sites, dead_inst_sites, pure_call_dce_sites, block_entry_narrowing_sites, direct_call_inline_sites) -> functions
  }
}

pub(package) fn pipeline_optimised_functions_const_fold_sites(opt: PipelineOptimisedFunctions) -> i64 {
  match opt {
    PipelineOptimisedFunctions(functions, const_fold_sites, algebraic_fold_sites, dead_inst_sites, pure_call_dce_sites, block_entry_narrowing_sites, direct_call_inline_sites) -> const_fold_sites
  }
}

pub(package) fn pipeline_optimised_functions_algebraic_fold_sites(opt: PipelineOptimisedFunctions) -> i64 {
  match opt {
    PipelineOptimisedFunctions(functions, const_fold_sites, algebraic_fold_sites, dead_inst_sites, pure_call_dce_sites, block_entry_narrowing_sites, direct_call_inline_sites) -> algebraic_fold_sites
  }
}

pub(package) fn pipeline_optimised_functions_dead_inst_sites(opt: PipelineOptimisedFunctions) -> i64 {
  match opt {
    PipelineOptimisedFunctions(functions, const_fold_sites, algebraic_fold_sites, dead_inst_sites, pure_call_dce_sites, block_entry_narrowing_sites, direct_call_inline_sites) -> dead_inst_sites
  }
}

pub(package) fn pipeline_optimised_functions_pure_call_dce_sites(opt: PipelineOptimisedFunctions) -> i64 {
  match opt {
    PipelineOptimisedFunctions(functions, const_fold_sites, algebraic_fold_sites, dead_inst_sites, pure_call_dce_sites, block_entry_narrowing_sites, direct_call_inline_sites) -> pure_call_dce_sites
  }
}

pub(package) fn pipeline_optimised_functions_block_entry_narrowing_sites(opt: PipelineOptimisedFunctions) -> i64 {
  match opt {
    PipelineOptimisedFunctions(functions, const_fold_sites, algebraic_fold_sites, dead_inst_sites, pure_call_dce_sites, block_entry_narrowing_sites, direct_call_inline_sites) -> block_entry_narrowing_sites
  }
}

pub(package) fn pipeline_optimised_functions_direct_call_inline_sites(opt: PipelineOptimisedFunctions) -> i64 {
  match opt {
    PipelineOptimisedFunctions(functions, const_fold_sites, algebraic_fold_sites, dead_inst_sites, pure_call_dce_sites, block_entry_narrowing_sites, direct_call_inline_sites) -> direct_call_inline_sites
  }
}

-- ══════════════════════════════════════════════════════════════
-- IR verifier (IR verification): structural validity of a function's IR
-- after any transform. Checks: every used value is defined somewhere
-- (function params, block params, instruction destinations — the use
-- oracle is pipeline_ir_live_set_add_inst_uses, the same enumeration
-- the optimiser and residency scan rely on); no duplicate SSA
-- definitions; jump and branch targets exist; jump argument counts
-- match target parameter counts; terminators present. Returns 0 for
-- valid IR, else an encoded first error:
--   kind * 1_000_000_000 + block_id * 1_000_000 + detail
-- kinds: 1 duplicate definition (detail = value id)
--        2 use of undefined value (detail = value id)
--        3 missing terminator (IrTermNone)
--        4 branch/jump target does not exist (detail = target id)
--        5 jump arg count mismatch (detail = target id)
--        6 intra-block use before def (detail = value id)
--        7 cross-block use not dominated by its definition (detail =
--          value id; slots exempt, unreachable blocks unchecked)
-- ══════════════════════════════════════════════════════════════

pub(package) fn pipeline_ir_verify_error(kind: i64, block_id: i64, detail: i64) -> i64 {
  kind * 1000000000 + block_id * 1000000 + detail
}

pub(package) fn pipeline_ir_verify_mark_def(defined: i64, words: i64, value: i64, block_id: i64) -> i64 {
  if value < 0 { 0 }
  else {
    let word_index = value / 64
    if word_index >= words { pipeline_ir_verify_error(1, block_id, value) }
    else {
      let mask = 1 bshl (value % 64)
      let word = pipeline_word_array_get(defined, word_index)
      if (word band mask) != 0 {
        pipeline_ir_verify_error(1, block_id, value)
      } else {
        pipeline_word_array_set(defined, word_index, word bor mask)
        0
      }
    }
  }
}

pub(package) fn pipeline_ir_verify_value_defined(defined: i64, words: i64, value: i64) -> i64 {
  if value < 0 { 1 }
  else {
    let word_index = value / 64
    if word_index >= words { 0 }
    else {
      if (pipeline_word_array_get(defined, word_index) band (1 bshl (value % 64))) != 0 { 1 } else { 0 }
    }
  }
}

pub(package) fn pipeline_ir_verify_mark_params(params: IrValueList, defined: i64, words: i64, block_id: i64) -> i64 {
  match params {
    IrValueNil -> 0
    IrValueCons(value, rest) -> {
      let err = pipeline_ir_verify_mark_def(defined, words, value, block_id)
      if err != 0 { err } else { pipeline_ir_verify_mark_params(rest, defined, words, block_id) }
    }
  }
}

pub(package) fn pipeline_ir_verify_mark_bit(defined: i64, words: i64, value: i64) -> i64 {
  if value < 0 { 0 }
  else {
    let word_index = value / 64
    if word_index >= words { 0 }
    else {
      pipeline_word_array_set(defined, word_index, pipeline_word_array_get(defined, word_index) bor (1 bshl (value % 64)))
    }
  }
}

pub(package) fn pipeline_ir_verify_mark_insts(insts: IrInstList, defined: i64, words: i64, block_id: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let dst = pipeline_ir_inst_def_or(inst, 0 - 1)
      let err = if dst >= 0 { pipeline_ir_verify_mark_def(defined, words, dst, block_id) } else { 0 }
      -- Slots share the value namespace and the use oracle counts slot
      -- operands as uses; a declaration or a store establishes the
      -- slot (repeated stores are not duplicate definitions).
      match inst {
        IrSlotI64(slot_id) -> pipeline_ir_verify_mark_bit(defined, words, slot_id)
        IrStoreI64(slot_id, value) -> pipeline_ir_verify_mark_bit(defined, words, slot_id)
        _ -> 0
      }
      if err != 0 { err } else { pipeline_ir_verify_mark_insts(rest, defined, words, block_id) }
    }
  }
}

pub(package) fn pipeline_ir_verify_mark_blocks(blocks: IrBlockList, defined: i64, words: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          let perr = pipeline_ir_verify_mark_params(params, defined, words, id)
          if perr != 0 { perr }
          else {
            let ierr = pipeline_ir_verify_mark_insts(insts, defined, words, id)
            if ierr != 0 { ierr } else { pipeline_ir_verify_mark_blocks(rest, defined, words) }
          }
        }
      }
    }
  }
}

pub(package) fn pipeline_ir_verify_uses_chain(uses: PipelineIrLiveSet, defined: i64, words: i64, block_id: i64) -> i64 {
  match uses {
    PipelineIrLiveSetNil -> 0
    PipelineIrLiveSetCons(value, rest) -> {
      if pipeline_ir_verify_value_defined(defined, words, value) == 0 {
        pipeline_ir_verify_error(2, block_id, value)
      } else {
        pipeline_ir_verify_uses_chain(rest, defined, words, block_id)
      }
    }
    PipelineIrLiveSetBits(array, bwords, count) -> 0
  }
}

pub(package) fn pipeline_ir_verify_insts_uses(insts: IrInstList, defined: i64, words: i64, block_id: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let err = pipeline_ir_verify_uses_chain(pipeline_ir_live_set_add_inst_uses(inst, pipeline_ir_live_set_empty()), defined, words, block_id)
      if err != 0 { err } else { pipeline_ir_verify_insts_uses(rest, defined, words, block_id) }
    }
  }
}

pub(package) fn pipeline_ir_verify_block_exists(blocks: IrBlockList, target: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          if id == target { 1 } else { pipeline_ir_verify_block_exists(rest, target) }
        }
      }
    }
  }
}

pub(package) fn pipeline_ir_verify_term(term: IrTerminator, all_blocks: IrBlockList, defined: i64, words: i64, block_id: i64) -> i64 {
  match term {
    IrTermNone -> pipeline_ir_verify_error(3, block_id, 0)
    IrTermUnreachable -> 0
    IrTermReturn(value) -> {
      if pipeline_ir_verify_value_defined(defined, words, value) == 0 {
        pipeline_ir_verify_error(2, block_id, value)
      } else { 0 }
    }
    IrTermJump(target, args) -> {
      if pipeline_ir_verify_block_exists(all_blocks, target) == 0 {
        pipeline_ir_verify_error(4, block_id, target)
      } else {
        let params = pipeline_ir_block_params_or(all_blocks, target, ir_value_list_empty())
        if ir_value_list_len(args) != ir_value_list_len(params) {
          pipeline_ir_verify_error(5, block_id, target)
        } else {
          pipeline_ir_verify_args_defined(args, defined, words, block_id)
        }
      }
    }
    IrTermBranch(cond, then_block, else_block) -> {
      if pipeline_ir_verify_value_defined(defined, words, cond) == 0 {
        pipeline_ir_verify_error(2, block_id, cond)
      } else {
        if pipeline_ir_verify_block_exists(all_blocks, then_block) == 0 {
          pipeline_ir_verify_error(4, block_id, then_block)
        } else {
          if pipeline_ir_verify_block_exists(all_blocks, else_block) == 0 {
            pipeline_ir_verify_error(4, block_id, else_block)
          } else { 0 }
        }
      }
    }
  }
}

pub(package) fn pipeline_ir_verify_args_defined(args: IrValueList, defined: i64, words: i64, block_id: i64) -> i64 {
  match args {
    IrValueNil -> 0
    IrValueCons(value, rest) -> {
      if pipeline_ir_verify_value_defined(defined, words, value) == 0 {
        pipeline_ir_verify_error(2, block_id, value)
      } else {
        pipeline_ir_verify_args_defined(rest, defined, words, block_id)
      }
    }
  }
}

pub(package) fn pipeline_ir_verify_blocks(blocks: IrBlockList, all_blocks: IrBlockList, defined: i64, words: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          let uerr = pipeline_ir_verify_insts_uses(insts, defined, words, id)
          if uerr != 0 { uerr }
          else {
            let terr = pipeline_ir_verify_term(term, all_blocks, defined, words, id)
            if terr != 0 { terr } else { pipeline_ir_verify_blocks(rest, all_blocks, defined, words) }
          }
        }
      }
    }
  }
}

-- Intra-block ordering: an operand defined in the SAME block must be
-- defined by an earlier instruction (or a block param). Cross-block uses
-- are dominance territory and stay unchecked here. Epoch stamping avoids
-- a per-block reset of the dense arrays.
pub(package) fn pipeline_ir_verify_block_order(blocks: IrBlockList, next_value: i64) -> i64 {
  let def_idx = pipeline_ir_native_resident_dense_new(next_value, 0 - 1)
  let def_epoch = pipeline_ir_native_resident_dense_new(next_value, 0 - 1)
  let mut epoch = 0
  let mut err = 0
  let mut cur_blocks = blocks
  let mut blocks_done = 0
  while blocks_done == 0 and err == 0 {
    match cur_blocks {
      IrBlockListNil -> { blocks_done = 1 }
      IrBlockListCons(block, rest_blocks) -> {
        match block {
          IrBlock(id, params, insts, term) -> {
            let mut p_cur = params
            let mut p_done = 0
            while p_done == 0 {
              match p_cur {
                IrValueNil -> { p_done = 1 }
                IrValueCons(pv, p_rest) -> {
                  if pv >= 0 and pv < next_value {
                    pipeline_ir_native_resident_dense_set(def_idx, pv, 0 - 1)
                    pipeline_ir_native_resident_dense_set(def_epoch, pv, epoch)
                  } else { 0 }
                  p_cur = p_rest
                }
              }
            }
            let mut idx = 0
            let mut cur = insts
            let mut done = 0
            while done == 0 {
              match cur {
                IrInstNil -> { done = 1 }
                IrInstCons(inst, tail) -> {
                  let d = pipeline_ir_inst_def_or(inst, 0 - 1)
                  if d >= 0 and d < next_value {
                    pipeline_ir_native_resident_dense_set(def_idx, d, idx)
                    pipeline_ir_native_resident_dense_set(def_epoch, d, epoch)
                  } else { 0 }
                  idx = idx + 1
                  cur = tail
                }
              }
            }
            idx = 0
            cur = insts
            done = 0
            while done == 0 and err == 0 {
              match cur {
                IrInstNil -> { done = 1 }
                IrInstCons(inst, tail) -> {
                  let mut uses = pipeline_ir_live_set_add_inst_uses(inst, pipeline_ir_live_set_empty())
                  let mut uses_done = 0
                  while uses_done == 0 and err == 0 {
                    match uses {
                      PipelineIrLiveSetNil -> { uses_done = 1 }
                      PipelineIrLiveSetCons(u, rest_uses) -> {
                        if u >= 0 and u < next_value {
                          if nlist_get(def_epoch, u) == epoch and nlist_get(def_idx, u) >= idx {
                            err = pipeline_ir_verify_error(6, id, u)
                          } else { 0 }
                        } else { 0 }
                        uses = rest_uses
                      }
                      PipelineIrLiveSetBits(barray, bwords, bcount) -> { uses_done = 1 }
                    }
                  }
                  idx = idx + 1
                  cur = tail
                }
              }
            }
            epoch = epoch + 1
            cur_blocks = rest_blocks
          }
        }
      }
    }
  }
  err
}


-- Cross-block dominance (kind 7): a value used in block B but defined in
-- block D != B is only valid when D dominates B. Dominator bitsets are the
-- standard iterative dataflow — dom[entry] = {entry}, others start full,
-- edge relaxation dom[S] &= dom[B] | {S} until fixpoint — over dense block
-- ids with the list head as entry. Slot ids (established by IrSlotI64 /
-- IrStoreI64) are excluded: slot initialisation is a path property that
-- mem2reg will retire, not an SSA dominance property. Unreachable blocks
-- keep full dominator sets and are not flagged here.



-- ══════════════════════════════════════════════════════════════
-- Live intervals (register residency stage 3, second producer). Flattens the per-block
-- liveness rows into per-value [start, end] positions over a global
-- instruction numbering in block layout order, and records whether each
-- interval crosses a call site — the deciding input for callee-saved
-- versus caller-saved pool assignment in the linear scan.
--   def at position p        -> start = min(start, p)
--   use at position p        -> end   = max(end, p)
--   value in live_in[B]      -> covers block B's start position
--   value in live_out[B]     -> covers block B's end position
-- Slot ids (multiple stores) union naturally under min/max.
-- Handle layout: [start_ptr, end_ptr, has_ptr, call_pos_ptr, call_count,
-- next_value].
-- ══════════════════════════════════════════════════════════════

pub(package) fn pipeline_ir_intervals_touch(iv: i64, value: i64, position: i64) -> i64 {
  let n = mem_load64_at(iv, 40)
  if value < 0 or value >= n { 0 }
  else {
    let start_base = mem_load64_at(iv, 0)
    let end_base = mem_load64_at(iv, 8)
    let has_base = mem_load64_at(iv, 16)
    if mem_load64_at(has_base, value * 8) == 0 {
      mem_store64_at(has_base, value * 8, 1)
      mem_store64_at(start_base, value * 8, position)
      mem_store64_at(end_base, value * 8, position)
    } else {
      if position < mem_load64_at(start_base, value * 8) { mem_store64_at(start_base, value * 8, position) } else { 0 }
      if position > mem_load64_at(end_base, value * 8) { mem_store64_at(end_base, value * 8, position) } else { 0 }
    }
  }
}

pub(package) fn pipeline_ir_intervals_has(iv: i64, value: i64) -> bool {
  let n = mem_load64_at(iv, 40)
  if value < 0 or value >= n { false }
  else { mem_load64_at(mem_load64_at(iv, 16), value * 8) == 1 }
}

pub(package) fn pipeline_ir_intervals_start_or(iv: i64, value: i64, missing: i64) -> i64 {
  if pipeline_ir_intervals_has(iv, value) { mem_load64_at(mem_load64_at(iv, 0), value * 8) } else { missing }
}

pub(package) fn pipeline_ir_intervals_end_or(iv: i64, value: i64, missing: i64) -> i64 {
  if pipeline_ir_intervals_has(iv, value) { mem_load64_at(mem_load64_at(iv, 8), value * 8) } else { missing }
}

-- Does [start, end] contain any recorded call position? Call positions
-- are appended in walk order, which is ascending, so a linear probe with
-- early exit stays cheap at realistic call counts.
pub(package) fn pipeline_ir_intervals_crosses_call(iv: i64, value: i64) -> bool {
  if pipeline_ir_intervals_has(iv, value) == 0 { false }
  else {
    let start = pipeline_ir_intervals_start_or(iv, value, 0)
    let end = pipeline_ir_intervals_end_or(iv, value, 0)
    let calls = mem_load64_at(iv, 24)
    let count = mem_load64_at(iv, 32)
    let mut i = 0
    let mut found = false
    while i < count {
      let cp = mem_load64_at(calls, i * 8)
      if cp > end { i = count }
      else {
        if cp > start and cp < end { found = true i = count } else { i = i + 1 }
      }
    }
    found
  }
}

pub(package) fn pipeline_ir_intervals_inst_is_call(inst: IrInst) -> bool {
  match inst {
    IrCallI64(dst, callee_hash, args) -> true
    IrManagedStakeI64(dst, value, cleanup_kind, delta, origin) -> true
    IrIndirectCallI64(dst, callee, args, result_ty) -> true
    IrGenericCallI64(dst, callee_hash, type_args, args) -> true
    IrMethodCallI64(dst, type_hash, method_hash, receiver, args) -> true
    IrPerformI64(dst, effect_hash, op_hash, args) -> true
    IrHandlerDirectI64(dst, effect_hash, op_hash, handler_depth, clause_index, args) -> true
    IrHandleI64(dst, src, body, clauses, nclauses, captures) -> true
    IrDeferredHandleI64(dst, src, body, clauses, nclauses, captures, scratch_base) -> true
    IrResumeI64(dst, value) -> true
    -- Variant/record construction emits a BL to rc_default_alloc
    -- (managed aggregate ownership): a call barrier for volatile residency.
    IrVariantInitI64(dst, tag_hash, args, field_mask) -> true
    IrRecordInitI64(dst, type_hash, fields) -> true
    IrRecordLayoutInitI64(dst, type_hash, data_size, align, fields) -> true
    IrReuseInitI64(token, constructor) -> true
    _ -> false
  }
}

pub(package) fn pipeline_ir_intervals_compute(blocks: IrBlockList, param_count: i64, next_value: i64, lv: i64) -> i64 {
  let iv = alloc_words(6)
  mem_store64_at(iv, 0, alloc_words(next_value + 1))
  mem_store64_at(iv, 8, alloc_words(next_value + 1))
  mem_store64_at(iv, 16, alloc_zeroed((next_value + 1) * 8))
  let call_cap = ir_block_list_inst_count(blocks) + 1
  mem_store64_at(iv, 24, alloc_words(call_cap))
  mem_store64_at(iv, 32, 0)
  mem_store64_at(iv, 40, next_value + 1)
  let mut position = 0
  let mut cur = blocks
  let mut done = 0
  while done == 0 {
    match cur {
      IrBlockListNil -> { done = 1 }
      IrBlockListCons(block, rest) -> {
        match block {
          IrBlock(id, params, insts, term) -> {
            let block_start = position
            -- Everything live into the block covers its start.
            let mut v = 0
            while v <= next_value {
              if pipeline_ir_liveness_live_in_contains(lv, id, v) { pipeline_ir_intervals_touch(iv, v, block_start) } else { 0 }
              v = v + 1
            }
            let mut p_cur = params
            let mut p_done = 0
            while p_done == 0 {
              match p_cur {
                IrValueNil -> { p_done = 1 }
                IrValueCons(pv, p_rest) -> {
                  pipeline_ir_intervals_touch(iv, pv, block_start)
                  p_cur = p_rest
                }
              }
            }
            let mut i_cur = insts
            let mut i_done = 0
            while i_done == 0 {
              match i_cur {
                IrInstNil -> { i_done = 1 }
                IrInstCons(inst, i_rest) -> {
                  position = position + 1
                  -- Variant/record init reads its payload args AFTER the
                  -- rc_default_alloc BL (unlike real calls, which stage
                  -- args before the branch), so an interval ending exactly
                  -- at the barrier would read a clobbered register. Bump
                  -- those uses one position so crosses_call sees them
                  -- spanning the barrier (managed aggregate ownership).
                  let use_position = match inst {
                    IrVariantInitI64(vdst, vtag_hash, vargs, vfield_mask) -> position + 1
                    IrRecordInitI64(rdst, rtype_hash, rfields) -> position + 1
                    IrRecordLayoutInitI64(rdst, rtype_hash, rdata_size, ralign, rfields) -> position + 1
                    _ -> position
                  }
                  let mut uses = pipeline_ir_live_set_add_inst_uses(inst, pipeline_ir_live_set_empty())
                  let mut u_done = 0
                  while u_done == 0 {
                    match uses {
                      PipelineIrLiveSetNil -> { u_done = 1 }
                      PipelineIrLiveSetCons(u, u_rest) -> {
                        pipeline_ir_intervals_touch(iv, u, use_position)
                        uses = u_rest
                      }
                      PipelineIrLiveSetBits(array, bwords, count) -> { u_done = 1 }
                    }
                  }
                  let d = pipeline_ir_inst_def_or(inst, 0 - 1)
                  if d >= 0 { pipeline_ir_intervals_touch(iv, d, position) } else { 0 }
                  match inst {
                    IrSlotI64(slot_id) -> pipeline_ir_intervals_touch(iv, slot_id, position)
                    _ -> 0
                  }
                  if pipeline_ir_intervals_inst_is_call(inst) {
                    let cc = mem_load64_at(iv, 32)
                    mem_store64_at(mem_load64_at(iv, 24), cc * 8, position)
                    mem_store64_at(iv, 32, cc + 1)
                  } else { 0 }
                  i_cur = i_rest
                }
              }
            }
            position = position + 1
            let block_end = position
            match term {
              IrTermNone -> 0
              IrTermUnreachable -> 0
              IrTermReturn(value) -> pipeline_ir_intervals_touch(iv, value, block_end)
              IrTermJump(target, args) -> {
                let mut a_cur = args
                let mut a_done = 0
                while a_done == 0 {
                  match a_cur {
                    IrValueNil -> { a_done = 1 }
                    IrValueCons(av, a_rest) -> {
                      pipeline_ir_intervals_touch(iv, av, block_end)
                      a_cur = a_rest
                    }
                  }
                }
                0
              }
              IrTermBranch(cond, then_block, else_block) -> pipeline_ir_intervals_touch(iv, cond, block_end)
            }
            let mut w = 0
            while w <= next_value {
              if pipeline_ir_liveness_live_out_contains(lv, id, w) { pipeline_ir_intervals_touch(iv, w, block_end) } else { 0 }
              w = w + 1
            }
            position = position + 1
            cur = rest
          }
        }
      }
    }
  }
  iv
}

-- ══════════════════════════════════════════════════════════════
-- Per-block liveness facts (register residency stage 3 substrate). Standard backward
-- dataflow to fixpoint over dense bitset rows keyed by block id:
--   live_in[b]  = use[b] | (live_out[b] & ~def[b])
--   live_out[b] = union of live_in over successors
-- use[b] is upward-exposed uses (used before any in-block def); block
-- params count as defs at block entry; jump arguments are uses in the
-- SOURCE block and the target's params are defs in the TARGET, which
-- models the phi transfer exactly. Slot ids share the value namespace,
-- so slot liveness falls out of the same rows (the coalescer's food).
-- Handle layout: [use_ptr, def_ptr, in_ptr, out_ptr, words, nblocks].
-- ══════════════════════════════════════════════════════════════

pub(package) fn pipeline_ir_liveness_row(base: i64, words: i64, block_id: i64) -> i64 {
  base + block_id * words * 8
}

pub(package) fn pipeline_ir_liveness_words(lv: i64) -> i64 {
  mem_load64_at(lv, 32)
}

pub(package) fn pipeline_ir_liveness_nblocks(lv: i64) -> i64 {
  mem_load64_at(lv, 40)
}

pub(package) fn pipeline_ir_liveness_row_set(base: i64, words: i64, block_id: i64, value: i64) -> i64 {
  if value < 0 { 0 }
  else {
    let row = pipeline_ir_liveness_row(base, words, block_id)
    pipeline_word_array_set(row, value / 64, pipeline_word_array_get(row, value / 64) bor (1 bshl (value % 64)))
  }
}

pub(package) fn pipeline_ir_liveness_row_contains(base: i64, words: i64, block_id: i64, value: i64) -> bool {
  if value < 0 { false }
  else {
    let row = pipeline_ir_liveness_row(base, words, block_id)
    let bit = pipeline_word_array_get(row, value / 64) band (1 bshl (value % 64))
    bit != 0
  }
}

pub(package) fn pipeline_ir_liveness_live_out_contains(lv: i64, block_id: i64, value: i64) -> bool {
  pipeline_ir_liveness_row_contains(mem_load64_at(lv, 24), pipeline_ir_liveness_words(lv), block_id, value)
}

pub(package) fn pipeline_ir_liveness_live_in_contains(lv: i64, block_id: i64, value: i64) -> bool {
  pipeline_ir_liveness_row_contains(mem_load64_at(lv, 16), pipeline_ir_liveness_words(lv), block_id, value)
}

pub(package) fn pipeline_ir_liveness_row_count(base: i64, words: i64, block_id: i64) -> i64 {
  let row = pipeline_ir_liveness_row(base, words, block_id)
  let mut total = 0
  let mut w = 0
  while w < words {
    let mut word = pipeline_word_array_get(row, w)
    while word != 0 {
      total = total + (word band 1)
      word = word bshr 1
    }
    w = w + 1
  }
  total
}

pub(package) fn pipeline_ir_liveness_live_out_count(lv: i64, block_id: i64) -> i64 {
  pipeline_ir_liveness_row_count(mem_load64_at(lv, 24), pipeline_ir_liveness_words(lv), block_id)
}

pub(package) fn pipeline_ir_liveness_live_in_count(lv: i64, block_id: i64) -> i64 {
  pipeline_ir_liveness_row_count(mem_load64_at(lv, 16), pipeline_ir_liveness_words(lv), block_id)
}

-- Uses of a terminator alone (no successor params — those are defs in
-- the target block under the phi model).
pub(package) fn pipeline_ir_liveness_term_uses(term: IrTerminator, use_base: i64, def_base: i64, words: i64, block_id: i64) -> i64 {
  match term {
    IrTermNone -> 0
    IrTermUnreachable -> 0
    IrTermReturn(value) -> pipeline_ir_liveness_use_if_exposed(use_base, def_base, words, block_id, value)
    IrTermJump(target, args) -> pipeline_ir_liveness_args_uses(args, use_base, def_base, words, block_id)
    IrTermBranch(cond, then_block, else_block) -> pipeline_ir_liveness_use_if_exposed(use_base, def_base, words, block_id, cond)
  }
}

pub(package) fn pipeline_ir_liveness_args_uses(args: IrValueList, use_base: i64, def_base: i64, words: i64, block_id: i64) -> i64 {
  match args {
    IrValueNil -> 0
    IrValueCons(value, rest) -> {
      pipeline_ir_liveness_use_if_exposed(use_base, def_base, words, block_id, value)
      pipeline_ir_liveness_args_uses(rest, use_base, def_base, words, block_id)
    }
  }
}

-- A use is upward-exposed only when the block has not defined it yet.
pub(package) fn pipeline_ir_liveness_use_if_exposed(use_base: i64, def_base: i64, words: i64, block_id: i64, value: i64) -> i64 {
  if value < 0 { 0 }
  else {
    if pipeline_ir_liveness_row_contains(def_base, words, block_id, value) { 0 }
    else { pipeline_ir_liveness_row_set(use_base, words, block_id, value) }
  }
}

pub(package) fn pipeline_ir_liveness_gen_kill_block(block: IrBlock, use_base: i64, def_base: i64, words: i64) -> i64 {
  match block {
    IrBlock(id, params, insts, term) -> {
      let mut p_cur = params
      let mut p_done = 0
      while p_done == 0 {
        match p_cur {
          IrValueNil -> { p_done = 1 }
          IrValueCons(pv, p_rest) -> {
            pipeline_ir_liveness_row_set(def_base, words, id, pv)
            p_cur = p_rest
          }
        }
      }
      let mut cur = insts
      let mut done = 0
      while done == 0 {
        match cur {
          IrInstNil -> { done = 1 }
          IrInstCons(inst, rest) -> {
            let mut uses = pipeline_ir_live_set_add_inst_uses(inst, pipeline_ir_live_set_empty())
            let mut u_done = 0
            while u_done == 0 {
              match uses {
                PipelineIrLiveSetNil -> { u_done = 1 }
                PipelineIrLiveSetCons(u, u_rest) -> {
                  pipeline_ir_liveness_use_if_exposed(use_base, def_base, words, id, u)
                  uses = u_rest
                }
                PipelineIrLiveSetBits(array, bwords, count) -> { u_done = 1 }
              }
            }
            let d = pipeline_ir_inst_def_or(inst, 0 - 1)
            if d >= 0 { pipeline_ir_liveness_row_set(def_base, words, id, d) } else { 0 }
            -- Slot declarations and stores establish the slot id for
            -- exposure purposes (repeated stores are fine).
            match inst {
              IrSlotI64(slot_id) -> pipeline_ir_liveness_row_set(def_base, words, id, slot_id)
              _ -> 0
            }
            cur = rest
          }
        }
      }
      pipeline_ir_liveness_term_uses(term, use_base, def_base, words, id)
    }
  }
}

-- live_out[source] |= live_in[target]; returns 1 when source grew.
pub(package) fn pipeline_ir_liveness_flow_edge(in_base: i64, out_base: i64, words: i64, source: i64, target: i64) -> i64 {
  let s_row = pipeline_ir_liveness_row(out_base, words, source)
  let t_row = pipeline_ir_liveness_row(in_base, words, target)
  let mut w = 0
  let mut changed = 0
  while w < words {
    let old = pipeline_word_array_get(s_row, w)
    let merged = old bor pipeline_word_array_get(t_row, w)
    if merged != old {
      pipeline_word_array_set(s_row, w, merged)
      changed = 1
    } else { 0 }
    w = w + 1
  }
  changed
}

pub(package) fn pipeline_ir_liveness_recompute_in(use_base: i64, def_base: i64, in_base: i64, out_base: i64, words: i64, block_id: i64) -> i64 {
  let u_row = pipeline_ir_liveness_row(use_base, words, block_id)
  let d_row = pipeline_ir_liveness_row(def_base, words, block_id)
  let i_row = pipeline_ir_liveness_row(in_base, words, block_id)
  let o_row = pipeline_ir_liveness_row(out_base, words, block_id)
  let mut w = 0
  let mut changed = 0
  while w < words {
    let old = pipeline_word_array_get(i_row, w)
    let next = pipeline_word_array_get(u_row, w) bor (pipeline_word_array_get(o_row, w) band (pipeline_word_array_get(d_row, w) bxor (0 - 1)))
    if next != old {
      pipeline_word_array_set(i_row, w, next)
      changed = 1
    } else { 0 }
    w = w + 1
  }
  changed
}

pub(package) fn pipeline_ir_liveness_flow_block(block: IrBlock, lv: i64) -> i64 {
  let use_base = mem_load64_at(lv, 0)
  let def_base = mem_load64_at(lv, 8)
  let in_base = mem_load64_at(lv, 16)
  let out_base = mem_load64_at(lv, 24)
  let words = pipeline_ir_liveness_words(lv)
  match block {
    IrBlock(id, params, insts, term) -> {
      let mut changed = 0
      match term {
        IrTermNone -> 0
        IrTermUnreachable -> 0
        IrTermReturn(value) -> 0
        IrTermJump(target, args) -> {
          changed = changed bor pipeline_ir_liveness_flow_edge(in_base, out_base, words, id, target)
          0
        }
        IrTermBranch(cond, then_block, else_block) -> {
          changed = changed bor pipeline_ir_liveness_flow_edge(in_base, out_base, words, id, then_block)
          changed = changed bor pipeline_ir_liveness_flow_edge(in_base, out_base, words, id, else_block)
          0
        }
      }
      changed bor pipeline_ir_liveness_recompute_in(use_base, def_base, in_base, out_base, words, id)
    }
  }
}

pub(package) fn pipeline_ir_liveness_flow_blocks(blocks: IrBlockList, lv: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      -- Flow the tail first: block layout is roughly topological, so a
      -- reverse sweep converges the backward problem in few rounds.
      let tail_changed = pipeline_ir_liveness_flow_blocks(rest, lv)
      tail_changed bor pipeline_ir_liveness_flow_block(block, lv)
    }
  }
}

pub(package) fn pipeline_ir_liveness_compute(blocks: IrBlockList, param_count: i64, next_value: i64) -> i64 {
  let nblocks = pipeline_ir_verify_max_block_id(blocks) + 1
  let words = (next_value + 64) / 64
  let plane = nblocks * words
  let lv = alloc_words(6)
  mem_store64_at(lv, 0, alloc_zeroed(plane * 8))
  mem_store64_at(lv, 8, alloc_zeroed(plane * 8))
  mem_store64_at(lv, 16, alloc_zeroed(plane * 8))
  mem_store64_at(lv, 24, alloc_zeroed(plane * 8))
  mem_store64_at(lv, 32, words)
  mem_store64_at(lv, 40, nblocks)
  let use_base = mem_load64_at(lv, 0)
  let def_base = mem_load64_at(lv, 8)
  let mut cur = blocks
  let mut done = 0
  while done == 0 {
    match cur {
      IrBlockListNil -> { done = 1 }
      IrBlockListCons(block, rest) -> {
        pipeline_ir_liveness_gen_kill_block(block, use_base, def_base, words)
        cur = rest
      }
    }
  }
  let mut rounds = 0
  let mut changed = 1
  while changed == 1 and rounds <= nblocks + 2 {
    changed = pipeline_ir_liveness_flow_blocks(blocks, lv)
    rounds = rounds + 1
  }
  lv
}

pub(package) fn pipeline_ir_verify_max_block_id(blocks: IrBlockList) -> i64 {
  let mut max_id = 0
  let mut cur = blocks
  let mut done = 0
  while done == 0 {
    match cur {
      IrBlockListNil -> { done = 1 }
      IrBlockListCons(block, rest) -> {
        match block {
          IrBlock(id, params, insts, term) -> {
            if id > max_id { max_id = id } else { 0 }
            cur = rest
          }
        }
      }
    }
  }
  max_id
}

pub(package) fn pipeline_ir_verify_dom_words(doms: i64, nblocks: i64, words: i64, block_id: i64) -> i64 {
  doms + block_id * words * 8
}

pub(package) fn pipeline_ir_verify_dom_has(doms: i64, nblocks: i64, words: i64, block_id: i64, dom_id: i64) -> i64 {
  let base = pipeline_ir_verify_dom_words(doms, nblocks, words, block_id)
  if (pipeline_word_array_get(base, dom_id / 64) band (1 bshl (dom_id % 64))) != 0 { 1 } else { 0 }
}

-- Dominator computation is the shared pipeline_ir_dominators (shared dominator analysis) —
-- identical layout (block-id rows, 64-bit words) and identical
-- relaxation semantics; the verifier keeps only its read accessors.

-- def_block: dense value id -> defining block id; -1 for function params
-- (dominate everything), -2 for undefined (kind 2 catches those earlier).
-- slot_ids marks ids that behave as slots and are exempt from dominance.
pub(package) fn pipeline_ir_verify_fill_def_blocks(blocks: IrBlockList, def_block: i64, slot_ids: i64, next_value: i64) -> i64 {
  let mut cur = blocks
  let mut done = 0
  while done == 0 {
    match cur {
      IrBlockListNil -> { done = 1 }
      IrBlockListCons(block, rest) -> {
        match block {
          IrBlock(id, params, insts, term) -> {
            let mut p_cur = params
            let mut p_done = 0
            while p_done == 0 {
              match p_cur {
                IrValueNil -> { p_done = 1 }
                IrValueCons(pv, p_rest) -> {
                  if pv >= 0 and pv < next_value { pipeline_ir_native_resident_dense_set(def_block, pv, id) } else { 0 }
                  p_cur = p_rest
                }
              }
            }
            let mut i_cur = insts
            let mut i_done = 0
            while i_done == 0 {
              match i_cur {
                IrInstNil -> { i_done = 1 }
                IrInstCons(inst, i_rest) -> {
                  let d = pipeline_ir_inst_def_or(inst, 0 - 1)
                  if d >= 0 and d < next_value { pipeline_ir_native_resident_dense_set(def_block, d, id) } else { 0 }
                  match inst {
                    IrSlotI64(slot_id) -> if slot_id >= 0 and slot_id < next_value { pipeline_ir_native_resident_dense_set(slot_ids, slot_id, 1) } else { 0 }
                    IrStoreI64(slot_id, value) -> if slot_id >= 0 and slot_id < next_value { pipeline_ir_native_resident_dense_set(slot_ids, slot_id, 1) } else { 0 }
                    _ -> 0
                  }
                  i_cur = i_rest
                }
              }
            }
            cur = rest
          }
        }
      }
    }
  }
  0
}

pub(package) fn pipeline_ir_verify_dominated_use(u: i64, block_id: i64, def_block: i64, slot_ids: i64, doms: i64, nblocks: i64, words: i64, next_value: i64) -> i64 {
  if u < 0 or u >= next_value { 0 }
  else { if nlist_get(slot_ids, u) == 1 { 0 }
  else {
    let d = nlist_get(def_block, u)
    if d == 0 - 1 or d == 0 - 2 { 0 }
    else { if d == block_id { 0 }
    else { if pipeline_ir_verify_dom_has(doms, nblocks, words, block_id, d) == 1 { 0 }
    else { pipeline_ir_verify_error(7, block_id, u) } } }
  } }
}

pub(package) fn pipeline_ir_verify_dominated_uses_chain(uses: PipelineIrLiveSet, block_id: i64, def_block: i64, slot_ids: i64, doms: i64, nblocks: i64, words: i64, next_value: i64) -> i64 {
  match uses {
    PipelineIrLiveSetNil -> 0
    PipelineIrLiveSetCons(value, rest) -> {
      let err = pipeline_ir_verify_dominated_use(value, block_id, def_block, slot_ids, doms, nblocks, words, next_value)
      if err != 0 { err } else { pipeline_ir_verify_dominated_uses_chain(rest, block_id, def_block, slot_ids, doms, nblocks, words, next_value) }
    }
    PipelineIrLiveSetBits(array, bwords, count) -> 0
  }
}

pub(package) fn pipeline_ir_verify_dominated_args(args: IrValueList, block_id: i64, def_block: i64, slot_ids: i64, doms: i64, nblocks: i64, words: i64, next_value: i64) -> i64 {
  match args {
    IrValueNil -> 0
    IrValueCons(value, rest) -> {
      let err = pipeline_ir_verify_dominated_use(value, block_id, def_block, slot_ids, doms, nblocks, words, next_value)
      if err != 0 { err } else { pipeline_ir_verify_dominated_args(rest, block_id, def_block, slot_ids, doms, nblocks, words, next_value) }
    }
  }
}

pub(package) fn pipeline_ir_verify_dominance(blocks: IrBlockList, param_count: i64, next_value: i64) -> i64 {
  let nblocks = pipeline_ir_verify_max_block_id(blocks) + 1
  if nblocks <= 1 { 0 }
  else {
    let words = (nblocks + 63) / 64
    -- Shared dominator analysis (shared dominator analysis): identical row/word layout, the
    -- entry is the first block in layout order in both.
    let doms = pipeline_ir_dominators(blocks, nblocks - 1)
    let def_block = pipeline_ir_native_resident_dense_new(next_value, 0 - 2)
    let slot_ids = pipeline_ir_native_resident_dense_new(next_value, 0)
    let mut p = 0
    while p < param_count {
      pipeline_ir_native_resident_dense_set(def_block, p, 0 - 1)
      p = p + 1
    }
    pipeline_ir_verify_fill_def_blocks(blocks, def_block, slot_ids, next_value)
    let mut err = 0
    let mut cur = blocks
    let mut done = 0
    while done == 0 and err == 0 {
      match cur {
        IrBlockListNil -> { done = 1 }
        IrBlockListCons(block, rest) -> {
          match block {
            IrBlock(id, params, insts, term) -> {
              let mut i_cur = insts
              let mut i_done = 0
              while i_done == 0 and err == 0 {
                match i_cur {
                  IrInstNil -> { i_done = 1 }
                  IrInstCons(inst, i_rest) -> {
                    err = pipeline_ir_verify_dominated_uses_chain(pipeline_ir_live_set_add_inst_uses(inst, pipeline_ir_live_set_empty()), id, def_block, slot_ids, doms, nblocks, words, next_value)
                    i_cur = i_rest
                  }
                }
              }
              if err == 0 {
                err = match term {
                  IrTermNone -> 0
                  IrTermUnreachable -> 0
                  IrTermReturn(value) -> pipeline_ir_verify_dominated_use(value, id, def_block, slot_ids, doms, nblocks, words, next_value)
                  IrTermJump(target, args) -> pipeline_ir_verify_dominated_args(args, id, def_block, slot_ids, doms, nblocks, words, next_value)
                  IrTermBranch(cond, then_block, else_block) -> pipeline_ir_verify_dominated_use(cond, id, def_block, slot_ids, doms, nblocks, words, next_value)
                }
              } else { 0 }
              cur = rest
            }
          }
        }
      }
    }
    err
  }
}

pub(package) fn pipeline_ir_verify_function(f: IrFunction) -> i64 {
  match f {
    IrFunction(hash, param_count, blocks, src) -> {
      let next_value = pipeline_ir_function_next_value(param_count, blocks)
      let words = pipeline_ir_live_set_dense_word_count(next_value + 1)
      if words <= 0 { 0 }
      else {
        let defined = pipeline_word_array_new(words)
        pipeline_ir_live_set_dense_clear(defined, words, 0)
        let mut p = 0
        while p < param_count {
          pipeline_ir_verify_mark_def(defined, words, p, 0 - 1)
          p = p + 1
        }
        let derr = pipeline_ir_verify_mark_blocks(blocks, defined, words)
        if derr != 0 { derr }
        else {
          let uerr = pipeline_ir_verify_blocks(blocks, blocks, defined, words)
          if uerr != 0 { uerr }
          else {
            let oerr = pipeline_ir_verify_block_order(blocks, next_value)
            if oerr != 0 { oerr }
            else { pipeline_ir_verify_dominance(blocks, param_count, next_value) }
          }
        }
      }
    }
  }
}

-- Verify every function in a list; returns 0 or the first error with
-- the function's position folded in as err + index * 100_000_000_000.
pub(package) fn pipeline_ir_verify_function_list(functions: IrFunctionList, index: i64) -> i64 {
  match functions {
    IrFunctionNil -> 0
    IrFunctionCons(f, rest) -> {
      let err = pipeline_ir_verify_function(f)
      if err != 0 { err + index * 100000000000 }
      else { pipeline_ir_verify_function_list(rest, index + 1) }
    }
  }
}

pub(package) fn pipeline_ir_verify_module(ir: IrModule) -> i64 {
  pipeline_ir_verify_function_list(pipeline_ir_functions(ir), 0)
}

pub(package) fn pipeline_optimise_ir_function(f: IrFunction, inline_candidates: PipelineIrInlineCandidateList, multi_candidates: PipelineIrInlineCandidateList, facts: PipelineIrSemanticFactList, pure_callees: i64, tt: i64) -> PipelineOptimisedFunctions {
  match f {
    IrFunction(hash, params, raw_blocks, src) -> {
      let multi = pipeline_ir_multi_inline_function_blocks(hash, params, raw_blocks, multi_candidates, facts, tt)
      let multi_sites = pipeline_ir_multi_pass_changed(multi)
      let blocks = pipeline_ir_multi_pass_blocks(multi)
      let first_next_value = pipeline_ir_multi_pass_next_value(multi)
      let block_count = ir_block_list_len(blocks)
      let ctx = pipeline_ir_optimise_context5(facts, inline_candidates, pure_callees, params, pipeline_ir_value_def_table(blocks, params))
      let folded = if block_count == 1 {
        pipeline_optimise_ir_block_list_with_param_consts(blocks, blocks, pipeline_ir_const_env_empty(), ctx, pipeline_ir_block_entry_facts_empty(), first_next_value)
      } else {
        pipeline_ir_cfg_fold_fixpoint(
          blocks,
          ctx,
          first_next_value,
          block_count + 2,
          block_count,
          ir_block_list_inst_count(blocks),
          ir_block_list_count_tag(blocks, 2),
          ir_block_list_count_term_tag(blocks, 3)
        )
      }
      let folded_blocks = pipeline_optimised_blocks_blocks(folded)
      -- The local fold may expose a multi-block call by erasing a tiny outer
      -- wrapper. Revisit the multi-block candidates once before final CFG
      -- cleanup so resolved method surfaces do not become runtime boundaries
      -- merely because of pass order. Re-fold only when that revisit changed
      -- the function.
      let post_multi = pipeline_ir_multi_inline_function_blocks(hash, params, folded_blocks, multi_candidates, facts, tt)
      let post_multi_sites = pipeline_ir_multi_pass_changed(post_multi)
      let post_multi_blocks = pipeline_ir_multi_pass_blocks(post_multi)
      let post_folded = if post_multi_sites == 0 {
        pipeline_optimised_blocks(post_multi_blocks, pipeline_ir_multi_pass_next_value(post_multi), 0, 0, 0, 0, 0, 0)
      } else {
        let post_block_count = ir_block_list_len(post_multi_blocks)
        let post_ctx = pipeline_ir_optimise_context5(facts, inline_candidates, pure_callees, params, pipeline_ir_value_def_table(post_multi_blocks, params))
        if post_block_count == 1 {
          pipeline_optimise_ir_block_list_with_param_consts(post_multi_blocks, post_multi_blocks, pipeline_ir_const_env_empty(), post_ctx, pipeline_ir_block_entry_facts_empty(), pipeline_ir_multi_pass_next_value(post_multi))
        } else {
          pipeline_ir_cfg_fold_fixpoint(
            post_multi_blocks,
            post_ctx,
            pipeline_ir_multi_pass_next_value(post_multi),
            post_block_count + 2,
            post_block_count,
            ir_block_list_inst_count(post_multi_blocks),
            ir_block_list_count_tag(post_multi_blocks, 2),
            ir_block_list_count_term_tag(post_multi_blocks, 3)
          )
        }
      }
      let final_folded_blocks = pipeline_optimised_blocks_blocks(post_folded)
      let normalised = pipeline_ir_normalise_branch_targets(final_folded_blocks)
      let normalised_blocks = pipeline_ir_normalised_blocks_blocks(normalised)
      let live = pipeline_ir_function_live_fixpoint(normalised_blocks, pipeline_ir_live_set_dense(pipeline_optimised_blocks_next_value(post_folded) + 1), facts)
      let trimmed_blocks = pipeline_ir_trim_block_param_list(normalised_blocks, normalised_blocks, live)
      let dce = pipeline_dce_sweep_ir_block_list(trimmed_blocks, live, facts)
      pipeline_optimised_functions(
        ir_function_list_prepend(ir_function_new_blocks_src(hash, params, pipeline_optimised_blocks_blocks(dce), src), ir_function_list_empty()),
        pipeline_optimised_blocks_const_fold_sites(folded) + pipeline_optimised_blocks_const_fold_sites(post_folded),
        pipeline_optimised_blocks_algebraic_fold_sites(folded) + pipeline_optimised_blocks_algebraic_fold_sites(post_folded),
        pipeline_optimised_blocks_dead_inst_sites(dce),
        pipeline_optimised_blocks_pure_call_dce_sites(dce),
        pipeline_optimised_blocks_block_entry_narrowing_sites(folded) + pipeline_optimised_blocks_block_entry_narrowing_sites(post_folded),
        pipeline_optimised_blocks_direct_call_inline_sites(folded) + pipeline_optimised_blocks_direct_call_inline_sites(post_folded) + multi_sites + post_multi_sites
      )
    }
  }
}

pub(package) fn pipeline_ir_capture_payload_in_range(captures: i64, lower: i64, upper: i64) -> i64 {
  if captures != 0 and captures >= lower and captures < upper { 1 } else { 0 }
}

pub(package) fn pipeline_ir_handler_clause_capture_payload_in_range(clauses: IrHandlerClauseBodyList, lower: i64, upper: i64) -> i64 {
  match clauses {
    IrHandlerClauseBodyNil -> 0
    IrHandlerClauseBodyCons(body, rest) -> {
      let hit = match body {
        IrHandlerClauseBody(op_hash, nparams, captures, has_continuation, is_abortive, result_cleanup_kind, transferred_param_value_fact, resume_lanes, result_lanes, first_value, blocks) -> pipeline_ir_capture_payload_in_range(captures, lower, upper)
        IrHandlerClauseBodyInvalid(reason) -> 0
      }
      if hit == 1 { 1 } else { pipeline_ir_handler_clause_capture_payload_in_range(rest, lower, upper) }
    }
  }
}

pub(package) fn pipeline_ir_deferred_body_capture_payload_in_range(body: IrDeferredHandlerBody, lower: i64, upper: i64) -> i64 {
  match body {
    IrDeferredHandlerBody(body_src, captures, ops_value, result_lanes, first_value, blocks, completion) -> pipeline_ir_capture_payload_in_range(captures, lower, upper)
    IrDeferredHandlerBodyInvalid(reason) -> 0
  }
}

pub(package) fn pipeline_ir_inst_list_capture_payload_in_range(insts: IrInstList, lower: i64, upper: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let hit = match inst {
        IrClosureI64(dst, f, captures, eff) -> pipeline_ir_capture_payload_in_range(captures, lower, upper)
        IrHandleI64(dst, handle_src, effect_hash, clauses, nclauses, abort_block) -> pipeline_ir_handler_clause_capture_payload_in_range(clauses, lower, upper)
        IrDeferredHandleI64(dst, handle_src, body, clauses, nclauses, effect_hash, scratch_base) -> {
          if pipeline_ir_deferred_body_capture_payload_in_range(body, lower, upper) == 1 { 1 }
          else { pipeline_ir_handler_clause_capture_payload_in_range(clauses, lower, upper) }
        }
        _ -> 0
      }
      if hit == 1 { 1 } else { pipeline_ir_inst_list_capture_payload_in_range(rest, lower, upper) }
    }
  }
}

pub(package) fn pipeline_ir_block_list_capture_payload_in_range(blocks: IrBlockList, lower: i64, upper: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      let hit = match block {
        IrBlock(id, params, insts, term) -> pipeline_ir_inst_list_capture_payload_in_range(insts, lower, upper)
      }
      if hit == 1 { 1 } else { pipeline_ir_block_list_capture_payload_in_range(rest, lower, upper) }
    }
  }
}

pub(package) fn pipeline_ir_function_list_capture_payload_in_range(functions: IrFunctionList, lower: i64, upper: i64) -> i64 {
  match functions {
    IrFunctionNil -> 0
    IrFunctionCons(f, rest) -> {
      let hit = match f {
        IrFunction(hash, nparams, blocks, src) -> pipeline_ir_block_list_capture_payload_in_range(blocks, lower, upper)
      }
      if hit == 1 { 1 } else { pipeline_ir_function_list_capture_payload_in_range(rest, lower, upper) }
    }
  }
}

pub(package) fn pipeline_optimise_ir_function_list_with_candidates(functions: IrFunctionList, inline_candidates: PipelineIrInlineCandidateList, multi_candidates: PipelineIrInlineCandidateList, facts: PipelineIrSemanticFactList, user_src: i64, pure_callees: i64, tt: i64) -> PipelineOptimisedFunctions {
  match functions {
    IrFunctionNil -> pipeline_optimised_functions(ir_function_list_empty(), 0, 0, 0, 0, 0, 0)
    IrFunctionCons(f, rest) -> {
      let local_candidates = match f {
        IrFunction(hash, param_count, blocks, src) -> inline_candidates
      }
      -- Per-function scratch reclaim (scratch reclamation's mark/restore contract, applied
      -- where the ledger says it pays: the fold's bump scratch — CSE
      -- tables, entry-fact worklists, liveness word arrays — is the
      -- single largest RSS block in a self-compile). The audit that
      -- licenses this: the result is rc ADTs plus scalars; rebuilt insts
      -- carry only value ids; pass-through insts reference below-mark
      -- payloads (lambda capture nlists from lowering, string offsets
      -- into source); the CSE nlists live in the local fact env, which
      -- the result type does not carry; facts/candidates/pure_callees
      -- are read-only during the pass and allocated below the mark.
      -- Arena and heap descriptors live at the head of their own
      -- mappings (never in bump memory), so rc heap growth mid-window
      -- is rollback-immune, and restore_same_segment itself proves
      -- same-segment membership against the live segment base.
      let osr_mark = alloc_bump_mark()
      let layout_cache_checkpoint = ttable_linear_layout_cache_checkpoint(tt)
      let head = pipeline_optimise_ir_function(f, local_candidates, multi_candidates, facts, pure_callees, tt)
      let osr_end = alloc_bump_mark()
      -- Alias rewriting is normally allocation-free at the result boundary,
      -- but a closure capture whose SSA value changes needs a replacement
      -- nlist to preserve optimiser purity. That list is a genuine output
      -- payload: keep this function's bump window committed so the recursive
      -- tail starts its own scratch mark above it. Functions without such an
      -- escaping payload retain the per-function reclaim fast path.
      let keeps_bump_payload = pipeline_ir_function_list_capture_payload_in_range(pipeline_optimised_functions_functions(head), osr_mark, osr_end)
      if keeps_bump_payload == 0 {
        ttable_linear_layout_cache_restore(tt, layout_cache_checkpoint)
        alloc_bump_restore_same_segment(osr_mark)
      } else { 0 }
      let tail = pipeline_optimise_ir_function_list_with_candidates(rest, inline_candidates, multi_candidates, facts, user_src, pure_callees, tt)
      pipeline_optimised_functions(
        pipeline_ir_function_list_append(pipeline_optimised_functions_functions(head), pipeline_optimised_functions_functions(tail)),
        pipeline_optimised_functions_const_fold_sites(head) + pipeline_optimised_functions_const_fold_sites(tail),
        pipeline_optimised_functions_algebraic_fold_sites(head) + pipeline_optimised_functions_algebraic_fold_sites(tail),
        pipeline_optimised_functions_dead_inst_sites(head) + pipeline_optimised_functions_dead_inst_sites(tail),
        pipeline_optimised_functions_pure_call_dce_sites(head) + pipeline_optimised_functions_pure_call_dce_sites(tail),
        pipeline_optimised_functions_block_entry_narrowing_sites(head) + pipeline_optimised_functions_block_entry_narrowing_sites(tail),
        pipeline_optimised_functions_direct_call_inline_sites(head) + pipeline_optimised_functions_direct_call_inline_sites(tail)
      )
    }
  }
}

pub(package) fn pipeline_optimise_ir_function_list(functions: IrFunctionList, all_functions: IrFunctionList, facts: PipelineIrSemanticFactList, user_src: i64, tt: i64) -> PipelineOptimisedFunctions {
  let pure_callees = pipeline_ir_pure_callee_tree(facts)
  -- Pre-collapse the candidate BODIES against each other so helper
  -- chains (u32 -> rotr32 -> bsig0) are flat before the full passes:
  -- candidates are tiny single-block functions, so iterating over just
  -- them is cheap, and callers then splice fully-flattened bodies in
  -- one shot. Sites counted during pre-collapse are scaffolding on
  -- throwaway copies and are not reported. The cap bounds clone growth
  -- for any accidental candidate cycle.
  let mut candidates = pipeline_ir_inline_candidates_from_functions(all_functions, facts, user_src)
  let mut ci = 0
  while ci < 4 {
    let cand_fns = pipeline_ir_inline_candidate_functions(candidates, ir_function_list_empty())
    let copt = pipeline_optimise_ir_function_list_with_candidates(cand_fns, candidates, PipelineIrInlineCandidateNil, facts, user_src, pure_callees, tt)
    if pipeline_optimised_functions_direct_call_inline_sites(copt) == 0 { ci = 4 }
    else {
      candidates = pipeline_ir_inline_candidates_from_functions(pipeline_optimised_functions_functions(copt), facts, user_src)
      ci = ci + 1
    }
  }
  -- The historic two full passes: the first splices flattened candidate
  -- bodies into every caller; rebuilding candidates from that result
  -- lets the second close callers that only became tiny after pass one.
  -- Multi-block candidates (null-guarded accessors, comparator shapes)
  -- splice as a pre-pass inside each function's optimisation; the second
  -- pass rebuild lets wrappers that swallowed a branchy body feed their
  -- own callers.
  let multi_candidates = pipeline_ir_multi_inline_candidates_walk(all_functions, facts)
  let first = pipeline_optimise_ir_function_list_with_candidates(functions, candidates, multi_candidates, facts, user_src, pure_callees, tt)
  let first_functions = pipeline_optimised_functions_functions(first)
  let second_candidates = pipeline_ir_inline_candidates_from_functions(first_functions, facts, user_src)
  let second_multi = pipeline_ir_multi_inline_candidates_walk(first_functions, facts)
  let second = pipeline_optimise_ir_function_list_with_candidates(first_functions, second_candidates, second_multi, facts, user_src, pure_callees, tt)
  pipeline_optimised_functions(
    pipeline_optimised_functions_functions(second),
    pipeline_optimised_functions_const_fold_sites(first) + pipeline_optimised_functions_const_fold_sites(second),
    pipeline_optimised_functions_algebraic_fold_sites(first) + pipeline_optimised_functions_algebraic_fold_sites(second),
    pipeline_optimised_functions_dead_inst_sites(first) + pipeline_optimised_functions_dead_inst_sites(second),
    pipeline_optimised_functions_pure_call_dce_sites(first) + pipeline_optimised_functions_pure_call_dce_sites(second),
    pipeline_optimised_functions_block_entry_narrowing_sites(first) + pipeline_optimised_functions_block_entry_narrowing_sites(second),
    pipeline_optimised_functions_direct_call_inline_sites(first) + pipeline_optimised_functions_direct_call_inline_sites(second)
  )
}

pub(package) fn pipeline_optimise_ir(ir: IrModule) -> IrModule {
  match ir {
    IrModule(functions) -> {
      let facts = pipeline_ir_semantic_facts_empty()
      let opt = pipeline_optimise_ir_function_list(functions, functions, facts, 0, 0)
      OptimisedIrModule(
        pipeline_optimised_functions_functions(opt),
        0,
        0,
        0,
        pipeline_optimised_functions_const_fold_sites(opt),
        pipeline_optimised_functions_algebraic_fold_sites(opt),
        pipeline_optimised_functions_dead_inst_sites(opt),
        facts,
        pipeline_optimised_functions_pure_call_dce_sites(opt),
        0,
        pipeline_optimised_functions_block_entry_narrowing_sites(opt),
        pipeline_optimised_functions_direct_call_inline_sites(opt)
      )
    }
    OptimisedIrModule(functions, inline_sites, residual_sites, evidence_candidate_sites, const_fold_sites, algebraic_fold_sites, dead_inst_sites, semantic_facts, pure_call_dce_sites, match_final_arm_elision_sites, block_entry_narrowing_sites, direct_call_inline_sites) -> ir
  }
}

-- ======================================================================
-- Slot-to-SSA promotion: mem2reg over optimised typed IR.
-- Mutable locals lower to frame slots; every never-address-taken,
-- non-f64, cleanly-referenced slot whose loads are store-dominated is
-- rewritten to SSA values, with pruned block params at joins where the
-- promoted variable is live-in (the liveness fact producer supplies
-- the pruning). Runs after the per-function optimiser so slot-keyed
-- fact machinery upstream is undisturbed; the residency pools
-- downstream then see loop-carried variables as block params instead
-- of memory traffic. Functions containing lambdas or handlers bail
-- (captures resolve variables through scope bindings the rewrite
-- would go stale on); unreachable blocks, oversized CFGs, and any
-- structural surprise bail per-function, leaving the input untouched.
-- The IR verifier covers the whole compiler's optimised output in the
-- suite, so a bad rewrite is a test failure, not a bisection.

pub(package) fn pipeline_mem2reg_reverse_insts(list: IrInstList, acc: IrInstList) -> IrInstList {
  match list {
    IrInstNil -> acc
    IrInstCons(inst, rest) -> pipeline_mem2reg_reverse_insts(rest, ir_inst_list_prepend(inst, acc))
  }
}

pub(package) fn pipeline_mem2reg_reverse_blocks(list: IrBlockList, acc: IrBlockList) -> IrBlockList {
  match list {
    IrBlockListNil -> acc
    IrBlockListCons(b, rest) -> pipeline_mem2reg_reverse_blocks(rest, ir_block_list_prepend(b, acc))
  }
}

pub(package) fn pipeline_mem2reg_block_for_id(blocks: IrBlockList, want: i64) -> IrBlock {
  match blocks {
    IrBlockListNil -> ir_block_new_term(0 - 1, ir_inst_list_empty(), ir_term_return(0))
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          if id == want { block } else { pipeline_mem2reg_block_for_id(rest, want) }
        }
      }
    }
  }
}

-- Candidacy scan: declared slots, minus address-taken, minus slots
-- referenced by anything except the slot family and binds (binds are
-- rewritten to the reaching value). Store VALUE operands and terminator
-- uses that name a declared slot disqualify it.
pub(package) fn pipeline_mem2reg_scan_uses(uses: PipelineIrLiveSet, declared: i64, disq: i64, next_value: i64) -> i64 {
  match uses {
    PipelineIrLiveSetNil -> 0
    PipelineIrLiveSetCons(u, rest) -> {
      if u >= 0 and u < next_value {
        if nlist_get(declared, u) == 1 { pipeline_ir_native_resident_dense_set(disq, u, 1) } else { 0 }
      } else { 0 }
      pipeline_mem2reg_scan_uses(rest, declared, disq, next_value)
    }
    PipelineIrLiveSetBits(array, words, count) -> 0
  }
}

-- Zero-allocation twin of the general scan arm: marks disq for every
-- operand of `inst` that names a declared slot, without materialising
-- a use set. MUST enumerate exactly the operands
-- pipeline_ir_live_set_add_inst_uses reports — the two are locked
-- together by mem2reg_dense_uses_match_oracle in the metrics test;
-- extend BOTH (and the test) when adding IR instructions.
pub(package) fn pipeline_mem2reg_mark_use(u: i64, declared: i64, disq: i64, next_value: i64) -> i64 {
  if u >= 0 and u < next_value {
    if nlist_get(declared, u) == 1 { pipeline_ir_native_resident_dense_set(disq, u, 1) } else { 0 }
  } else { 0 }
  0
}

pub(package) fn pipeline_mem2reg_mark_structural_drop(value: i64, plan: i64, declared: i64, disq: i64, next_value: i64) -> i64 {
  let words = pipeline_structural_drop_plan_use_words(plan)
  for lane in 0..words {
    pipeline_mem2reg_mark_use(value + lane, declared, disq, next_value)
  }
  0
}

pub(package) fn pipeline_mem2reg_mark_values(values: IrValueList, declared: i64, disq: i64, next_value: i64) -> i64 {
  match values {
    IrValueNil -> 0
    IrValueCons(v, rest) -> {
      pipeline_mem2reg_mark_use(v, declared, disq, next_value)
      pipeline_mem2reg_mark_values(rest, declared, disq, next_value)
    }
  }
}

pub(package) fn pipeline_mem2reg_mark_record_fields(fields: IrRecordFieldList, declared: i64, disq: i64, next_value: i64) -> i64 {
  match fields {
    IrRecordFieldNil -> 0
    IrRecordFieldCons(field_hash, word_offset, value, rest) -> {
      pipeline_mem2reg_mark_use(value, declared, disq, next_value)
      pipeline_mem2reg_mark_record_fields(rest, declared, disq, next_value)
    }
  }
}

pub(package) fn pipeline_mem2reg_mark_record_layout_fields(fields: IrRecordLayoutFieldList, declared: i64, disq: i64, next_value: i64) -> i64 {
  match fields {
    IrRecordLayoutFieldNil -> 0
    IrRecordLayoutFieldWord(field_hash, byte_offset, value, managed_kind, rest) -> {
      pipeline_mem2reg_mark_use(value, declared, disq, next_value)
      pipeline_mem2reg_mark_record_layout_fields(rest, declared, disq, next_value)
    }
    IrRecordLayoutFieldArray(field_hash, byte_offset, data, byte_size, leaf_count, leaf_stride, leaf_kind, rest) -> {
      pipeline_mem2reg_mark_use(data, declared, disq, next_value)
      pipeline_mem2reg_mark_record_layout_fields(rest, declared, disq, next_value)
    }
  }
}

pub(package) fn pipeline_mem2reg_mark_inst_uses_dense(inst: IrInst, declared: i64, disq: i64, next_value: i64) -> i64 {
  match inst {
    IrConstI64(dst, value) -> 0
    IrNilI64(dst) -> 0
    IrStringLit(dst, start, len) -> 0
    IrStringConcatI64(dst, left, right) -> {
      pipeline_mem2reg_mark_use(left, declared, disq, next_value)
      pipeline_mem2reg_mark_use(right, declared, disq, next_value)
    }
    IrBinaryI64(dst, op, lhs, rhs) -> {
      pipeline_mem2reg_mark_use(lhs, declared, disq, next_value)
      pipeline_mem2reg_mark_use(rhs, declared, disq, next_value)
    }
    IrFloatBinaryI64(dst, prim, op, lhs, rhs) -> {
      pipeline_mem2reg_mark_use(lhs, declared, disq, next_value)
      pipeline_mem2reg_mark_use(rhs, declared, disq, next_value)
    }
    IrUnaryI64(dst, op, value) -> pipeline_mem2reg_mark_use(value, declared, disq, next_value)
    IrFunctionRefI64(dst, callee_hash) -> 0
    IrGenericFunctionRefI64(dst, callee_hash, type_args) -> 0
    IrPtrLoadI64(dst, ptr) -> pipeline_mem2reg_mark_use(ptr, declared, disq, next_value)
    IrPtrStoreI64(dst, ptr, value) -> {
      pipeline_mem2reg_mark_use(ptr, declared, disq, next_value)
      pipeline_mem2reg_mark_use(value, declared, disq, next_value)
    }
    IrLoweringFailureI64(reason) -> 0
    IrPerformI64(dst, effect_hash, op_hash, args) -> pipeline_mem2reg_mark_values(args, declared, disq, next_value)
    IrHandlerDirectI64(dst, effect_hash, op_hash, handler_depth, clause_index, args) -> pipeline_mem2reg_mark_values(args, declared, disq, next_value)
    IrHandlerPopI64(frame) -> pipeline_mem2reg_mark_use(frame, declared, disq, next_value)
    IrAbortLandingI64(dst) -> 0
    IrResumeI64(dst, value) -> pipeline_mem2reg_mark_use(value, declared, disq, next_value)
    IrTryI64(dst, value, effect_key, error_lanes) -> pipeline_mem2reg_mark_use(value, declared, disq, next_value)
    IrTryLinearI64(dst, value, effect_key, parent_plan, ok_plan, error_plan) -> pipeline_mem2reg_mark_use(value, declared, disq, next_value)
    IrOptChainI64(dst, base, field_hash, field_index, effect_key) -> pipeline_mem2reg_mark_use(base, declared, disq, next_value)
    IrCallI64(dst, callee_hash, args) -> pipeline_mem2reg_mark_values(args, declared, disq, next_value)
    IrIndirectCallI64(dst, callee, args, result_ty) -> {
      pipeline_mem2reg_mark_use(callee, declared, disq, next_value)
      pipeline_mem2reg_mark_values(args, declared, disq, next_value)
    }
    IrGenericCallI64(dst, callee_hash, type_args, args) -> pipeline_mem2reg_mark_values(args, declared, disq, next_value)
    IrVectorGetI64(dst, vec, index, fallback, check_mode) -> {
      pipeline_mem2reg_mark_use(vec, declared, disq, next_value)
      pipeline_mem2reg_mark_use(index, declared, disq, next_value)
      pipeline_mem2reg_mark_use(fallback, declared, disq, next_value)
    }
    IrVectorSetI64(dst, vec, index, value, check_mode) -> {
      pipeline_mem2reg_mark_use(vec, declared, disq, next_value)
      pipeline_mem2reg_mark_use(index, declared, disq, next_value)
      pipeline_mem2reg_mark_use(value, declared, disq, next_value)
    }
    IrMethodCallI64(dst, type_hash, method_hash, receiver, args) -> {
      pipeline_mem2reg_mark_use(receiver, declared, disq, next_value)
      pipeline_mem2reg_mark_values(args, declared, disq, next_value)
    }
    IrOwnedDropI64(value, type_hash) -> pipeline_mem2reg_mark_use(value, declared, disq, next_value)
    IrStructuralDropI64(value, plan) -> pipeline_mem2reg_mark_structural_drop(value, plan, declared, disq, next_value)
    IrStructuralSplitI64(value, parent_plan, residual_plan, release_backing) -> pipeline_mem2reg_mark_structural_drop(value, parent_plan, declared, disq, next_value)
    IrArrayCopyI64(dst_data, src_data, byte_size, leaf_count, leaf_stride, leaf_kind) -> {
      pipeline_mem2reg_mark_use(dst_data, declared, disq, next_value)
      pipeline_mem2reg_mark_use(src_data, declared, disq, next_value)
    }
    IrArrayDropI64(data, leaf_count, leaf_stride, leaf_kind) -> pipeline_mem2reg_mark_use(data, declared, disq, next_value)
    IrVariantInitI64(dst, tag_hash, payloads, field_mask) -> pipeline_mem2reg_mark_values(payloads, declared, disq, next_value)
    IrVariantTagI64(dst, base) -> pipeline_mem2reg_mark_use(base, declared, disq, next_value)
    IrVariantPayloadI64(dst, base, index) -> pipeline_mem2reg_mark_use(base, declared, disq, next_value)
    IrRecordInitI64(dst, type_hash, fields) -> pipeline_mem2reg_mark_record_fields(fields, declared, disq, next_value)
    IrRecordLayoutInitI64(dst, type_hash, data_size, align, fields) -> pipeline_mem2reg_mark_record_layout_fields(fields, declared, disq, next_value)
    IrRecordLayoutArrayLoadI64(dst_data, base, record_data_size, byte_offset, byte_size, leaf_count, leaf_stride, leaf_kind) -> {
      pipeline_mem2reg_mark_use(dst_data, declared, disq, next_value)
      pipeline_mem2reg_mark_use(base, declared, disq, next_value)
    }
    IrRecordLayoutWordLoadI64(dst, base, record_data_size, field_hash, byte_offset) -> pipeline_mem2reg_mark_use(base, declared, disq, next_value)
    IrFieldLoadI64(dst, base, field_hash, field_index) -> pipeline_mem2reg_mark_use(base, declared, disq, next_value)
    -- Anything not enumerated falls back to the allocating oracle so a
    -- new instruction can never silently under-report a slot reference.
    _ -> pipeline_mem2reg_scan_uses(pipeline_ir_live_set_add_inst_uses(inst, pipeline_ir_live_set_empty()), declared, disq, next_value)
  }
}

pub(package) fn pipeline_mem2reg_scan_inst(inst: IrInst, declared: i64, disq: i64, next_value: i64) -> i64 {
  match inst {
    IrSlotI64(s) -> {
      if s >= 0 and s < next_value { pipeline_ir_native_resident_dense_set(declared, s, 1) } else { 0 }
      0
    }
    IrAddressOfSlotI64(d, s) -> {
      if s >= 0 and s < next_value { pipeline_ir_native_resident_dense_set(disq, s, 1) } else { 0 }
      0
    }
    IrLoadI64(d, s) -> 0
    IrStoreI64(s, v) -> {
      if v >= 0 and v < next_value {
        if nlist_get(declared, v) == 1 { pipeline_ir_native_resident_dense_set(disq, v, 1) } else { 0 }
      } else { 0 }
      0
    }
    IrBindI64(ns, nl, v, ty) -> 0
    _ -> pipeline_mem2reg_mark_inst_uses_dense(inst, declared, disq, next_value)
  }
}

pub(package) fn pipeline_mem2reg_term_succ0(term: IrTerminator) -> i64 {
  match term {
    IrTermJump(t, args) -> t
    IrTermBranch(c, bt, be) -> bt
    _ -> 0 - 1
  }
}

pub(package) fn pipeline_mem2reg_term_succ1(term: IrTerminator) -> i64 {
  match term {
    IrTermBranch(c, bt, be) -> be
    _ -> 0 - 1
  }
}

-- Iterative post-order DFS over successor arrays; returns 1 when every
-- existing block is reachable from the entry, 0 to bail. rpo_out is
-- filled with block ids in reverse post-order.
pub(package) fn pipeline_mem2reg_rpo(entry_id: i64, succ0: i64, succ1: i64, exists: i64, nids: i64, rpo_out: i64) -> i64 {
  let visited = pipeline_ir_native_resident_dense_new(nids, 0)
  let post = nlist_new()
  -- Explicit stack of (id, phase): phase 0 = expand, 1 = emit.
  let stack_id = nlist_new()
  let stack_phase = nlist_new()
  nlist_add(stack_id, entry_id)
  nlist_add(stack_phase, 0)
  let mut sp = 1
  while sp > 0 {
    let id = nlist_get(stack_id, sp - 1)
    let phase = nlist_get(stack_phase, sp - 1)
    sp = sp - 1
    if phase == 1 {
      nlist_add(post, id)
    } else {
      if nlist_get(visited, id) == 1 { 0 } else {
        pipeline_ir_native_resident_dense_set(visited, id, 1)
        -- re-push for emission, then children (reverse order so succ0
        -- expands first; post-order emit order does not matter for
        -- correctness, only that preds of non-headers precede them in RPO).
        if sp < nlist_len(stack_id) {
          pipeline_ir_native_resident_dense_set(stack_id, sp, id)
          pipeline_ir_native_resident_dense_set(stack_phase, sp, 1)
        } else {
          nlist_add(stack_id, id)
          nlist_add(stack_phase, 1)
        }
        sp = sp + 1
        let s1 = nlist_get(succ1, id)
        if s1 >= 0 and s1 < nids and nlist_get(visited, s1) == 0 {
          if sp < nlist_len(stack_id) {
            pipeline_ir_native_resident_dense_set(stack_id, sp, s1)
            pipeline_ir_native_resident_dense_set(stack_phase, sp, 0)
          } else {
            nlist_add(stack_id, s1)
            nlist_add(stack_phase, 0)
          }
          sp = sp + 1
          0
        } else { 0 }
        let s0 = nlist_get(succ0, id)
        if s0 >= 0 and s0 < nids and nlist_get(visited, s0) == 0 {
          if sp < nlist_len(stack_id) {
            pipeline_ir_native_resident_dense_set(stack_id, sp, s0)
            pipeline_ir_native_resident_dense_set(stack_phase, sp, 0)
          } else {
            nlist_add(stack_id, s0)
            nlist_add(stack_phase, 0)
          }
          sp = sp + 1
          0
        } else { 0 }
      }
    }
  }
  -- Reachability: every existing id must be visited.
  let mut all = 1
  let mut ck = 0
  while ck < nids {
    if nlist_get(exists, ck) == 1 and nlist_get(visited, ck) == 0 { all = 0 } else { 0 }
    ck = ck + 1
  }
  if all == 1 {
    -- reverse post into rpo_out
    let np = nlist_len(post)
    let mut ri = 0
    while ri < np {
      nlist_add(rpo_out, nlist_get(post, np - 1 - ri))
      ri = ri + 1
    }
    1
  } else { 0 }
}

-- Simulate one block's inst list over the candidate map m (dense ncand
-- row), binding load aliases into env. Returns 0 on success, 1 on a
-- structural surprise (load or bind before any reaching store).
pub(package) fn pipeline_mem2reg_sim_insts(insts: IrInstList, cand_index: i64, m: i64, env: PipelineIrAliasEnv, next_value: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let fail = match inst {
        IrStoreI64(s, v) -> {
          if s >= 0 and s < next_value {
            let ci = nlist_get(cand_index, s)
            if ci >= 0 { pipeline_ir_native_resident_dense_set(m, ci, pipeline_ir_alias_env_lookup_or(env, v)) } else { 0 }
          } else { 0 }
          0
        }
        IrLoadI64(d, s) -> {
          if s >= 0 and s < next_value {
            let ci = nlist_get(cand_index, s)
            if ci >= 0 {
              if nlist_get(m, ci) < 0 { 1 }
              else {
                pipeline_ir_alias_env_bind(env, d, nlist_get(m, ci))
                0
              }
            } else { 0 }
          } else { 0 }
        }
        _ -> 0
      }
      if fail == 1 { 1 } else { pipeline_mem2reg_sim_insts(rest, cand_index, m, env, next_value) }
    }
  }
}

pub(package) fn pipeline_mem2reg_row_base(plane: i64, id: i64, ncand: i64) -> i64 { id * ncand }

pub(package) fn pipeline_mem2reg_copy_row(src_plane: i64, src_id: i64, dst: i64, ncand: i64) -> i64 {
  let mut i = 0
  while i < ncand {
    pipeline_ir_native_resident_dense_set(dst, i, nlist_get(src_plane, src_id * ncand + i))
    i = i + 1
  }
  0
}

pub(package) fn pipeline_mem2reg_store_row(dst_plane: i64, dst_id: i64, src: i64, ncand: i64) -> i64 {
  let mut i = 0
  while i < ncand {
    pipeline_ir_native_resident_dense_set(dst_plane, dst_id * ncand + i, nlist_get(src, i))
    i = i + 1
  }
  0
}

-- Entry map for a block: params row when it has params allocated
-- (multi-pred), the unique pred's exit row when single-pred, all -1
-- for the entry block.
pub(package) fn pipeline_mem2reg_in_map(id: i64, entry_id: i64, pred_count: i64, pred1: i64, param_plane: i64, param_repl: i64, exit_plane: i64, ncand: i64) -> i64 {
  let m = pipeline_ir_native_resident_dense_new(ncand, 0 - 1)
  if id == entry_id { 0 }
  else { if nlist_get(pred_count, id) >= 2 {
    pipeline_mem2reg_copy_row(param_plane, id, m, ncand)
    -- Removed trivial phis leave their single incoming value behind.
    let mut ri = 0
    while ri < ncand {
      if nlist_get(m, ri) < 0 and nlist_get(param_repl, id * ncand + ri) >= 0 {
        pipeline_ir_native_resident_dense_set(m, ri, nlist_get(param_repl, id * ncand + ri))
      } else { 0 }
      ri = ri + 1
    }
    0
  } else { if nlist_get(pred_count, id) == 1 {
    pipeline_mem2reg_copy_row(exit_plane, nlist_get(pred1, id), m, ncand)
  } else { 0 } } }
  m
}

-- Appended jump args for an edge into `target`: the exit-map values of
-- the source block for every candidate the target has a param for, in
-- ascending candidate order (matching param append order).
pub(package) fn pipeline_mem2reg_edge_args(target: i64, m: i64, param_plane: i64, ncand: i64, args: IrValueList, env: PipelineIrAliasEnv) -> IrValueList {
  let mut extra = ir_value_list_empty()
  let mut ci = ncand - 1
  while ci >= 0 {
    if nlist_get(param_plane, target * ncand + ci) >= 0 {
      extra = ir_value_list_prepend(pipeline_ir_alias_env_lookup_or(env, nlist_get(m, ci)), extra)
    } else { 0 }
    ci = ci - 1
  }
  ir_value_list_append(args, extra)
}

pub(package) fn pipeline_mem2reg_target_needs_args(target: i64, param_plane: i64, ncand: i64) -> i64 {
  let mut ci = 0
  let mut needs = 0
  while ci < ncand {
    if nlist_get(param_plane, target * ncand + ci) >= 0 { needs = 1 ci = ncand } else { ci = ci + 1 }
  }
  needs
}

pub(package) fn pipeline_mem2reg_function(irf: IrFunction) -> IrFunction {
  match irf {
    IrFunction(hash, param_count, blocks, src) -> {
      if pipeline_ir_native_blocks_have_handles(blocks) == 1 { irf }
      else { if pipeline_ir_native_blocks_have_lambdas(blocks) == 1 { irf }
      else {
        let next_value = pipeline_ir_function_next_value(param_count, blocks)
        let max_id = pipeline_ir_verify_max_block_id(blocks)
        if next_value <= 0 or max_id < 0 or max_id > 400 { irf }
        else {
          let nids = max_id + 1
          -- Candidacy scan, two-staged: declarations first (so a
          -- reference positioned before its slot's declaration in
          -- layout order can never dodge the check), and the reference
          -- pass only runs when the function declares slots at all.
          let declared = pipeline_ir_native_resident_dense_new(next_value, 0)
          let disq = pipeline_ir_native_resident_dense_new(next_value, 0)
          let mut any_declared = 0
          let mut d_cur = blocks
          let mut d_done = 0
          while d_done == 0 {
            match d_cur {
              IrBlockListNil -> { d_done = 1 }
              IrBlockListCons(block, rest) -> {
                match block {
                  IrBlock(id, params, insts, term) -> {
                    let mut dc = insts
                    let mut dc_done = 0
                    while dc_done == 0 {
                      match dc {
                        IrInstNil -> { dc_done = 1 }
                        IrInstCons(inst, itail) -> {
                          match inst {
                            IrSlotI64(sd) -> {
                              if sd >= 0 and sd < next_value {
                                pipeline_ir_native_resident_dense_set(declared, sd, 1)
                                any_declared = 1
                                0
                              } else { 0 }
                            }
                            IrAddressOfSlotI64(da, sa) -> {
                              if sa >= 0 and sa < next_value { pipeline_ir_native_resident_dense_set(disq, sa, 1) } else { 0 }
                            }
                            _ -> 0
                          }
                          dc = itail
                        }
                      }
                    }
                    d_cur = rest
                  }
                }
              }
            }
          }
          if any_declared == 0 { irf }
          else {
          let mut sc_cur = blocks
          let mut sc_done = 0
          while sc_done == 0 {
            match sc_cur {
              IrBlockListNil -> { sc_done = 1 }
              IrBlockListCons(block, rest) -> {
                match block {
                  IrBlock(id, params, insts, term) -> {
                    let mut ic = insts
                    let mut id2 = 0
                    while id2 == 0 {
                      match ic {
                        IrInstNil -> { id2 = 1 }
                        IrInstCons(inst, itail) -> {
                          pipeline_mem2reg_scan_inst(inst, declared, disq, next_value)
                          ic = itail
                        }
                      }
                    }
                    pipeline_mem2reg_scan_uses(pipeline_ir_native_resident_term_uses(term), declared, disq, next_value)
                    sc_cur = rest
                  }
                }
              }
            }
          }
          -- Cheap pre-gate: the f64 fixpoint, slot-pin scan, and
          -- liveness only run when the dense scan left a live candidate.
          let mut any_cand = 0
          let mut ac0 = 0
          while ac0 < next_value {
            if nlist_get(declared, ac0) == 1 and nlist_get(disq, ac0) == 0 { any_cand = 1 ac0 = next_value } else { ac0 = ac0 + 1 }
          }
          if any_cand == 0 { irf }
          else {
          -- f64 slot candidates keep their typed FP-allocation path.
          let f64_facts = pipeline_ir_native_f64_facts_for_blocks(blocks)
          let f64_slot_list = pipeline_ir_native_f64_facts_slot_candidates(f64_facts)
          let nf64 = nlist_len(f64_slot_list)
          let mut f64_i = 0
          while f64_i < nf64 {
            let fslot = nlist_get(f64_slot_list, f64_i)
            if fslot >= 0 and fslot < next_value { pipeline_ir_native_resident_dense_set(disq, fslot, 1) } else { 0 }
            f64_i = f64_i + 1
          }
          -- Slots the leaf slot-pin pass already serves stay slots: a
          -- loop-pinned slot lives in x8/x10/x11 full-time with ZERO
          -- memory traffic — promotion would demote it to a frame-homed
          -- block param (the sieve +47% inversion). Promotion targets
          -- the slots that machinery bails on: call-bearing loops.
          let mut pin_cur = pipeline_ir_native_pinned_slot_for_function(irf)
          while pin_cur != 0 {
            if node_f1(pin_cur) != pipeline_ir_native_forward_marker() {
              let pslot = node_f1(pin_cur)
              if pslot >= 0 and pslot < next_value { pipeline_ir_native_resident_dense_set(disq, pslot, 1) } else { 0 }
            } else { 0 }
            pin_cur = node_f3(pin_cur)
          }
          let mut any_cand2 = 0
          let mut ac = 0
          while ac < next_value {
            if nlist_get(declared, ac) == 1 and nlist_get(disq, ac) == 0 { any_cand2 = 1 ac = next_value } else { ac = ac + 1 }
          }
          if any_cand2 == 0 { irf }
          else {
            -- Entry-live slots (a path loads before any store) bail.
            let lv = pipeline_ir_liveness_compute(blocks, param_count, next_value)
            let entry_id = match blocks {
              IrBlockListCons(b0, r0) -> match b0 { IrBlock(eid, ep, ei, et) -> eid }
              IrBlockListNil -> 0 - 1
            }
            let cand_index = pipeline_ir_native_resident_dense_new(next_value, 0 - 1)
            let cand_slot = nlist_new()
            let mut ncand = 0
            let mut cb = 0
            while cb < next_value {
              if nlist_get(declared, cb) == 1 and nlist_get(disq, cb) == 0 {
                if pipeline_ir_liveness_live_in_contains(lv, entry_id, cb) { 0 } else {
                  pipeline_ir_native_resident_dense_set(cand_index, cb, ncand)
                  nlist_add(cand_slot, cb)
                  ncand = ncand + 1
                  0
                }
              } else { 0 }
              cb = cb + 1
            }
            if ncand == 0 or nids * ncand > 40000 { irf }
            else {
              -- CFG arrays.
              let exists = pipeline_ir_native_resident_dense_new(nids, 0)
              let pred_count = pipeline_ir_native_resident_dense_new(nids, 0)
              let pred1 = pipeline_ir_native_resident_dense_new(nids, 0 - 1)
              let pred_lists = pipeline_ir_native_resident_dense_new(nids, 0)
              let succ0 = pipeline_ir_native_resident_dense_new(nids, 0 - 1)
              let succ1 = pipeline_ir_native_resident_dense_new(nids, 0 - 1)
              let mut cf_cur = blocks
              let mut cf_done = 0
              while cf_done == 0 {
                match cf_cur {
                  IrBlockListNil -> { cf_done = 1 }
                  IrBlockListCons(block, rest) -> {
                    match block {
                      IrBlock(id, params, insts, term) -> {
                        pipeline_ir_native_resident_dense_set(exists, id, 1)
                        let s0 = pipeline_mem2reg_term_succ0(term)
                        let s1 = pipeline_mem2reg_term_succ1(term)
                        pipeline_ir_native_resident_dense_set(succ0, id, s0)
                        pipeline_ir_native_resident_dense_set(succ1, id, s1)
                        if s0 >= 0 and s0 < nids {
                          pipeline_ir_native_resident_dense_set(pred_count, s0, nlist_get(pred_count, s0) + 1)
                          if nlist_get(pred1, s0) < 0 { pipeline_ir_native_resident_dense_set(pred1, s0, id) } else { 0 }
                          if nlist_get(pred_lists, s0) == 0 { pipeline_ir_native_resident_dense_set(pred_lists, s0, nlist_new()) } else { 0 }
                          nlist_add(nlist_get(pred_lists, s0), id)
                          0
                        } else { 0 }
                        if s1 >= 0 and s1 < nids {
                          pipeline_ir_native_resident_dense_set(pred_count, s1, nlist_get(pred_count, s1) + 1)
                          if nlist_get(pred1, s1) < 0 { pipeline_ir_native_resident_dense_set(pred1, s1, id) } else { 0 }
                          if nlist_get(pred_lists, s1) == 0 { pipeline_ir_native_resident_dense_set(pred_lists, s1, nlist_new()) } else { 0 }
                          nlist_add(nlist_get(pred_lists, s1), id)
                          0
                        } else { 0 }
                        cf_cur = rest
                      }
                    }
                  }
                }
              }
              let rpo = nlist_new()
              if pipeline_mem2reg_rpo(entry_id, succ0, succ1, exists, nids, rpo) == 0 { irf }
              else {
                -- Pruned param allocation at multi-pred joins.
                let param_plane = pipeline_ir_native_resident_dense_new(nids * ncand, 0 - 1)
                let param_repl = pipeline_ir_native_resident_dense_new(nids * ncand, 0 - 1)
                let exit_plane = pipeline_ir_native_resident_dense_new(nids * ncand, 0 - 1)
                let mut fresh = next_value
                let nrpo = nlist_len(rpo)
                let mut pa = 0
                while pa < nrpo {
                  let pid = nlist_get(rpo, pa)
                  if nlist_get(pred_count, pid) >= 2 {
                    let mut pc = 0
                    while pc < ncand {
                      if pipeline_ir_liveness_live_in_contains(lv, pid, nlist_get(cand_slot, pc)) {
                        pipeline_ir_native_resident_dense_set(param_plane, pid * ncand + pc, fresh)
                        fresh = fresh + 1
                        0
                      } else { 0 }
                      pc = pc + 1
                    }
                    0
                  } else { 0 }
                  pa = pa + 1
                }
                -- Pass A: RPO simulation filling exit rows and the alias env.
                let env = pipeline_ir_alias_env_empty()
                let mut sim_fail = 0
                let mut sa = 0
                while sa < nrpo and sim_fail == 0 {
                  let sid = nlist_get(rpo, sa)
                  let m = pipeline_mem2reg_in_map(sid, entry_id, pred_count, pred1, param_plane, param_repl, exit_plane, ncand)
                  let sblock = pipeline_mem2reg_block_for_id(blocks, sid)
                  match sblock {
                    IrBlock(bid, bparams, binsts, bterm) -> {
                      sim_fail = pipeline_mem2reg_sim_insts(binsts, cand_index, m, env, next_value)
                    }
                  }
                  pipeline_mem2reg_store_row(exit_plane, sid, m, ncand)
                  sa = sa + 1
                }
                if sim_fail == 1 { irf }
                else {
                  -- Trivial-phi removal (Braun): a param whose incoming
                  -- values resolve to a single distinct value besides
                  -- itself is redundant — the variable was not changed
                  -- around that join. Alias it away; removals cascade.
                  let mut phi_changed = 1
                  while phi_changed == 1 {
                    phi_changed = 0
                    let mut tb = 0
                    while tb < nrpo {
                      let tid3 = nlist_get(rpo, tb)
                      if nlist_get(pred_count, tid3) >= 2 {
                        let mut tc = 0
                        while tc < ncand {
                          let tp = nlist_get(param_plane, tid3 * ncand + tc)
                          if tp >= 0 {
                            let plist = nlist_get(pred_lists, tid3)
                            let npred = if plist != 0 { nlist_len(plist) } else { 0 }
                            let mut distinct = 0 - 1
                            let mut multi = 0
                            let mut pi3 = 0
                            while pi3 < npred {
                              let pin = nlist_get(exit_plane, nlist_get(plist, pi3) * ncand + tc)
                              let inv = if pin >= 0 { pipeline_ir_alias_env_lookup_or(env, pin) } else { 0 - 1 }
                              if inv < 0 { multi = 1 } else {
                                if inv != tp {
                                  if distinct < 0 { distinct = inv }
                                  else { if inv != distinct { multi = 1 } else { 0 } }
                                  0
                                } else { 0 }
                              }
                              pi3 = pi3 + 1
                            }
                            if multi == 0 and distinct >= 0 {
                              pipeline_ir_alias_env_bind(env, tp, distinct)
                              pipeline_ir_native_resident_dense_set(param_plane, tid3 * ncand + tc, 0 - 1)
                              pipeline_ir_native_resident_dense_set(param_repl, tid3 * ncand + tc, distinct)
                              phi_changed = 1
                            } else { 0 }
                            0
                          } else { 0 }
                          tc = tc + 1
                        }
                        0
                      } else { 0 }
                      tb = tb + 1
                    }
                  }
                  -- Pass B: layout-order rewrite.
                  let mut tramp_next = nids
                  let mut out_rev = ir_block_list_empty()
                  let mut pending_tramps = ir_block_list_empty()
                  let mut rw_fail = 0
                  let mut rw_cur = blocks
                  let mut rw_done = 0
                  while rw_done == 0 and rw_fail == 0 {
                    match rw_cur {
                      IrBlockListNil -> { rw_done = 1 }
                      IrBlockListCons(block, rest) -> {
                        match block {
                          IrBlock(id, params, insts, term) -> {
                            let m = pipeline_mem2reg_in_map(id, entry_id, pred_count, pred1, param_plane, param_repl, exit_plane, ncand)
                            -- Append this block's new params in candidate order.
                            let mut new_params_extra = ir_value_list_empty()
                            let mut npc = ncand - 1
                            while npc >= 0 {
                              if nlist_get(param_plane, id * ncand + npc) >= 0 {
                                new_params_extra = ir_value_list_prepend(nlist_get(param_plane, id * ncand + npc), new_params_extra)
                              } else { 0 }
                              npc = npc - 1
                            }
                            let new_params = ir_value_list_append(params, new_params_extra)
                            -- Rewrite insts, dropping the promoted slot family.
                            let mut acc_rev = ir_inst_list_empty()
                            let mut wi = insts
                            let mut wdone = 0
                            while wdone == 0 and rw_fail == 0 {
                              match wi {
                                IrInstNil -> { wdone = 1 }
                                IrInstCons(inst, itail) -> {
                                  match inst {
                                    IrSlotI64(s) -> {
                                      if s >= 0 and s < next_value and nlist_get(cand_index, s) >= 0 { 0 }
                                      else { acc_rev = ir_inst_list_prepend(inst, acc_rev) 0 }
                                    }
                                    IrStoreI64(s, v) -> {
                                      let sci = if s >= 0 and s < next_value { nlist_get(cand_index, s) } else { 0 - 1 }
                                      if sci >= 0 {
                                        pipeline_ir_native_resident_dense_set(m, sci, pipeline_ir_alias_env_lookup_or(env, v))
                                      } else {
                                        acc_rev = ir_inst_list_prepend(pipeline_ir_rewrite_inst_uses(inst, env), acc_rev)
                                        0
                                      }
                                      0
                                    }
                                    IrLoadI64(d, s) -> {
                                      let lci = if s >= 0 and s < next_value { nlist_get(cand_index, s) } else { 0 - 1 }
                                      if lci >= 0 { 0 }
                                      else { acc_rev = ir_inst_list_prepend(pipeline_ir_rewrite_inst_uses(inst, env), acc_rev) 0 }
                                    }
                                    IrBindI64(ns, nl, v, ty) -> {
                                      let bci = if v >= 0 and v < next_value { nlist_get(cand_index, v) } else { 0 - 1 }
                                      if bci >= 0 {
                                        if nlist_get(m, bci) < 0 { rw_fail = 1 0 }
                                        else { acc_rev = ir_inst_list_prepend(ir_inst_bind_typed_i64(ns, nl, pipeline_ir_alias_env_lookup_or(env, nlist_get(m, bci)), ty), acc_rev) 0 }
                                        0
                                      } else {
                                        acc_rev = ir_inst_list_prepend(pipeline_ir_rewrite_inst_uses(inst, env), acc_rev)
                                        0
                                      }
                                    }
                                    _ -> {
                                      acc_rev = ir_inst_list_prepend(pipeline_ir_rewrite_inst_uses(inst, env), acc_rev)
                                      0
                                    }
                                  }
                                  wi = itail
                                }
                              }
                            }
                            let new_insts = pipeline_mem2reg_reverse_insts(acc_rev, ir_inst_list_empty())
                            -- Rewrite terminator and thread edge args.
                            let rterm = pipeline_ir_rewrite_term(term, env)
                            let final_term = match rterm {
                              IrTermJump(jt, jargs) -> {
                                if jt >= 0 and jt < nids and pipeline_mem2reg_target_needs_args(jt, param_plane, ncand) == 1 {
                                  ir_term_jump_args(jt, pipeline_mem2reg_edge_args(jt, m, param_plane, ncand, jargs, env))
                                } else { rterm }
                              }
                              IrTermBranch(bc, bt, be) -> {
                                -- Trampolines land immediately after their
                                -- source block in layout: a trampoline at the
                                -- list tail would manufacture backward edges
                                -- that blow up every position-window rounding
                                -- downstream (the residency pools would see
                                -- loop-sized windows everywhere).
                                let nt = if bt >= 0 and bt < nids and pipeline_mem2reg_target_needs_args(bt, param_plane, ncand) == 1 {
                                  let tid = tramp_next
                                  tramp_next = tramp_next + 1
                                  pending_tramps = ir_block_list_prepend(ir_block_new_term(tid, ir_inst_list_empty(), ir_term_jump_args(bt, pipeline_mem2reg_edge_args(bt, m, param_plane, ncand, ir_value_list_empty(), env))), pending_tramps)
                                  tid
                                } else { bt }
                                let ne = if be >= 0 and be < nids and pipeline_mem2reg_target_needs_args(be, param_plane, ncand) == 1 {
                                  let tid2 = tramp_next
                                  tramp_next = tramp_next + 1
                                  pending_tramps = ir_block_list_prepend(ir_block_new_term(tid2, ir_inst_list_empty(), ir_term_jump_args(be, pipeline_mem2reg_edge_args(be, m, param_plane, ncand, ir_value_list_empty(), env))), pending_tramps)
                                  tid2
                                } else { be }
                                ir_term_branch(bc, nt, ne)
                              }
                              _ -> rterm
                            }
                            out_rev = ir_block_list_prepend(ir_block_new_params(id, new_params, new_insts, final_term), out_rev)
                            -- Flush this block's trampolines right behind it.
                            let mut fl = pipeline_mem2reg_reverse_blocks(pending_tramps, ir_block_list_empty())
                            pending_tramps = ir_block_list_empty()
                            let mut fl_done = 0
                            while fl_done == 0 {
                              match fl {
                                IrBlockListNil -> { fl_done = 1 }
                                IrBlockListCons(tb, tb_rest) -> {
                                  out_rev = ir_block_list_prepend(tb, out_rev)
                                  fl = tb_rest
                                }
                              }
                            }
                            rw_cur = rest
                          }
                        }
                      }
                    }
                  }
                  if rw_fail == 1 { irf }
                  else {
                    IrFunction(hash, param_count, pipeline_mem2reg_reverse_blocks(out_rev, ir_block_list_empty()), src)
                  }
                }
              }
            }
          }
          }
          }
        }
      } }
    }
  }
}

pub(package) fn pipeline_mem2reg_function_list(functions: IrFunctionList) -> IrFunctionList {
  match functions {
    IrFunctionNil -> IrFunctionNil
    IrFunctionCons(irf, rest) -> IrFunctionCons(pipeline_mem2reg_function(irf), pipeline_mem2reg_function_list(rest))
    _ -> functions
  }
}

-- Test-facing: count residual slot declarations in an optimised module.
pub(package) fn pipeline_ir_module_slot_inst_count(ir: IrModule) -> i64 {
  let mut count = 0
  let mut fcur = pipeline_ir_functions(ir)
  let mut fdone = 0
  while fdone == 0 {
    match fcur {
      IrFunctionNil -> { fdone = 1 }
      IrFunctionCons(irf, rest) -> {
        let mut bcur = pipeline_ir_function_blocks(irf)
        let mut bdone = 0
        while bdone == 0 {
          match bcur {
            IrBlockListNil -> { bdone = 1 }
            IrBlockListCons(block, brest) -> {
              match block {
                IrBlock(id, params, insts, term) -> {
                  let mut icur = insts
                  let mut idone = 0
                  while idone == 0 {
                    match icur {
                      IrInstNil -> { idone = 1 }
                      IrInstCons(inst, itail) -> {
                        match inst {
                          IrSlotI64(s) -> { count = count + 1 0 }
                          _ -> 0
                        }
                        icur = itail
                      }
                    }
                  }
                  bcur = brest
                }
              }
            }
          }
        }
        fcur = rest
      }
      _ -> { fdone = 1 }
    }
  }
  count
}

-- ══════════════════════════════════════════════════════════════
-- Loop-param induction + post-promotion check re-tightening (slot-to-SSA promotion).
--
-- mem2reg turns loop variables into header block params, but check
-- modes were decided by the pre-promotion fact pass, whose slot
-- induction rules have no param analog — value facts cannot cross a
-- loop backedge (circular meet). These rules port the slot induction
-- to header params. A block param is IMMUTABLE for the whole
-- iteration, so a strict bound established in any block that
-- dominates a backedge's source bounds exactly the value the backedge
-- arithmetic consumes: the slot rules' cycle conditions are
-- unnecessary here.
--
-- Rules (every incoming jump edge must satisfy a leg; branch edges
-- into a param-carrying block disqualify it):
--   L0 (param >= 0): identity | const >= 0 | vector_len result |
--      value nonneg-provable at the source block | another L0 param |
--      param + 1 where a strict upper bound on the param holds in a
--      block dominating the source (wrap-free: p < X <= MAX).
--   L1 (param >= -1): as L0 with tolerance one: const >= -1, or
--      q - 1 with q nonneg-provable at the source. L1 seeds no direct
--      fact; it only feeds the derived-offset rule below.
--   U(h) (param < len(v) - h): fresh legs establish the bound
--      (q - c with q < len(v) at the source: h = c; a value already
--      carrying an upper fact for v: h = 0); carrying legs preserve
--      any h (identity, or param - c with c >= 0 and the param
--      nonneg-provable at the source so the subtraction cannot wrap
--      below). Increment backedges are rejected: re-establishing an
--      upper bound after an increment is the guard-true machinery's
--      territory, not a header invariant. Requires whole-function
--      len-stability (the seeded facts describe current lengths).
-- Seeding: L0 params seed value nonneg facts and U params seed
-- vector-upper facts in every block — sound because any block where
-- the param is consulted is dominated by its header (SSA dominance),
-- where the invariant holds. Derived offsets: dst = p + c
-- (c in [1, 4095]) with p in L0 or L1 and p carrying U (the upper
-- bound makes the sum wrap-free) seeds nonneg(dst) at dst's block,
-- plus an upper fact when c <= h.
-- ══════════════════════════════════════════════════════════════

-- Scan a block's entry chain for a true bool fact about param p.
-- mode 1: strict upper bound (lt(p, x) / gt(x, p)) -> 1.
-- mode 2: strict upper bound whose bound value is a vector_len result
--         -> the vector's value id.
-- mode 3: constant lower bound at zero (ge(p, c>=0) / le(c>=0, p)) -> 1.
-- Returns -1 when no matching fact exists.
pub(package) fn pipeline_ir_chain_param_bool_scan(chain: PipelineIrBlockEntryFactChain, table: i64, p: i64, mode: i64) -> i64 {
  match chain {
    PipelineIrBlockEntryFactNil -> 0 - 1
    PipelineIrBlockEntryCtorFact(fact_block, value_id, ctor_hash, rest) -> pipeline_ir_chain_param_bool_scan(rest, table, p, mode)
    PipelineIrBlockEntryNotCtorFact(fact_block, value_id, ctor_hash, rest) -> pipeline_ir_chain_param_bool_scan(rest, table, p, mode)
    PipelineIrBlockEntryScalarFact(fact_block, value_id, kind, value, rest) -> {
      let hit = if kind == pipeline_ir_scalar_fact_kind_bool() and value == 1 {
        let def = pipeline_ir_value_def_lookup(table, value_id)
        if def != 0 and node_f1(def) == 3 {
          let code = node_f2(def)
          if mode == 3 {
            let bounded = if code == 6 { node_f3(def) } else { if code == 5 { node_f4(def) } else { 0 - 1 } }
            let low = if code == 6 { node_f4(def) } else { if code == 5 { node_f3(def) } else { 0 - 1 } }
            if bounded == p and low >= 0 {
              let low_def = pipeline_ir_value_def_lookup(table, low)
              if low_def != 0 and node_f1(low_def) == 1 and node_f2(low_def) >= 0 { 1 } else { 0 - 1 }
            } else { 0 - 1 }
          } else {
            let bounded = if code == 3 { node_f3(def) } else { if code == 4 { node_f4(def) } else { 0 - 1 } }
            let bound = if code == 3 { node_f4(def) } else { if code == 4 { node_f3(def) } else { 0 - 1 } }
            if bounded == p and bound >= 0 {
              if mode == 1 { 1 } else {
                let bound_def = pipeline_ir_value_def_lookup(table, bound)
                if bound_def != 0 and node_f1(bound_def) == 4 { node_f2(bound_def) } else { 0 - 1 }
              }
            } else { 0 - 1 }
          }
        } else { 0 - 1 }
      } else { 0 - 1 }
      if hit >= 0 { hit } else { pipeline_ir_chain_param_bool_scan(rest, table, p, mode) }
    }
    PipelineIrBlockEntrySlotScalarFact(fact_block, slot_id, kind, value, rest) -> pipeline_ir_chain_param_bool_scan(rest, table, p, mode)
    PipelineIrBlockEntryVectorLenFact(fact_block, len_value, vec_value, rest) -> pipeline_ir_chain_param_bool_scan(rest, table, p, mode)
    PipelineIrBlockEntryVectorUpperFact(fact_block, vec_value, index_value, rest) -> pipeline_ir_chain_param_bool_scan(rest, table, p, mode)
    PipelineIrBlockEntryVectorSlotUpperFact(fact_block, vec_value, slot_id, rest) -> pipeline_ir_chain_param_bool_scan(rest, table, p, mode)
    PipelineIrBlockEntryVectorSlotRowUpperFact(fact_block, vec_value, row_width, slot_id, rest) -> pipeline_ir_chain_param_bool_scan(rest, table, p, mode)
    PipelineIrBlockEntryVectorRowUpperFact(fact_block, vec_value, row_width, slot_id, rest) -> pipeline_ir_chain_param_bool_scan(rest, table, p, mode)
    PipelineIrBlockEntryVariantOriginFact(fact_block, value_id, ctor_hash, payloads, rest) -> pipeline_ir_chain_param_bool_scan(rest, table, p, mode)
  }
}

-- First vector-upper fact about value v in a block's entry chain:
-- returns the vector's value id, or -1.
pub(package) fn pipeline_ir_chain_value_upper_vec(chain: PipelineIrBlockEntryFactChain, v: i64) -> i64 {
  match chain {
    PipelineIrBlockEntryFactNil -> 0 - 1
    PipelineIrBlockEntryCtorFact(fact_block, value_id, ctor_hash, rest) -> pipeline_ir_chain_value_upper_vec(rest, v)
    PipelineIrBlockEntryNotCtorFact(fact_block, value_id, ctor_hash, rest) -> pipeline_ir_chain_value_upper_vec(rest, v)
    PipelineIrBlockEntryScalarFact(fact_block, value_id, kind, value, rest) -> pipeline_ir_chain_value_upper_vec(rest, v)
    PipelineIrBlockEntrySlotScalarFact(fact_block, slot_id, kind, value, rest) -> pipeline_ir_chain_value_upper_vec(rest, v)
    PipelineIrBlockEntryVectorLenFact(fact_block, len_value, vec_value, rest) -> pipeline_ir_chain_value_upper_vec(rest, v)
    PipelineIrBlockEntryVectorUpperFact(fact_block, vec_value, index_value, rest) -> {
      if index_value == v { vec_value } else { pipeline_ir_chain_value_upper_vec(rest, v) }
    }
    PipelineIrBlockEntryVectorSlotUpperFact(fact_block, vec_value, slot_id, rest) -> pipeline_ir_chain_value_upper_vec(rest, v)
    PipelineIrBlockEntryVectorSlotRowUpperFact(fact_block, vec_value, row_width, slot_id, rest) -> pipeline_ir_chain_value_upper_vec(rest, v)
    PipelineIrBlockEntryVectorRowUpperFact(fact_block, vec_value, row_width, slot_id, rest) -> pipeline_ir_chain_value_upper_vec(rest, v)
    PipelineIrBlockEntryVariantOriginFact(fact_block, value_id, ctor_hash, payloads, rest) -> pipeline_ir_chain_value_upper_vec(rest, v)
  }
}

pub(package) fn pipeline_ir_param_nlist_contains(l: i64, v: i64) -> i64 {
  let n = nlist_len(l)
  let mut i = 0
  let mut found = 0
  while i < n {
    if nlist_get(l, i) == v { found = 1 i = n } else { i = i + 1 }
  }
  found
}

-- Const definition of a value via the def table.
pub(package) fn pipeline_ir_param_arg_const(table: i64, v: i64) -> PipelineIrConstLookup {
  let def = pipeline_ir_value_def_lookup(table, v)
  if def != 0 and node_f1(def) == 1 { pipeline_ir_const_lookup(1, node_f2(def)) } else { pipeline_ir_const_lookup(0, 0) }
}

-- A strict upper bound on param p holds in some block that dominates
-- use_block (including use_block itself). Immutability of p makes
-- dominance alone sufficient: every path from the param's binding to
-- use_block passes the check, and the check constrains the same SSA
-- value the consumer reads.
pub(package) fn pipeline_ir_param_bound_above_dominating(blocks: IrBlockList, table: i64, facts: PipelineIrBlockEntryFactList, p: i64, use_block: i64, dom_sets: i64, dom_max: i64, dom_words: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          let hit = if id >= 0 and id <= dom_max and use_block >= 0 and use_block <= dom_max {
            if pipeline_ir_dominators_bit_get(dom_sets, dom_words, use_block, id) == 1 {
              if pipeline_ir_chain_param_bool_scan(pipeline_ir_block_entry_facts_block_chain(facts, id), table, p, 1) >= 0 { 1 } else { 0 }
            } else { 0 }
          } else { 0 }
          if hit == 1 { 1 } else { pipeline_ir_param_bound_above_dominating(rest, table, facts, p, use_block, dom_sets, dom_max, dom_words) }
        }
      }
    }
  }
}

-- Value provably nonnegative at a source block: nonneg const,
-- vector_len result, a nonneg/zero fact in the block's entry chain, a
-- ge/le-const bool fact, or membership in the proven-L0 param set.
pub(package) fn pipeline_ir_param_value_nonneg_at(facts: PipelineIrBlockEntryFactList, table: i64, block_id: i64, l0: i64, v: i64) -> i64 {
  let c = pipeline_ir_param_arg_const(table, v)
  if pipeline_ir_const_lookup_valid(c) == 1 and pipeline_ir_const_lookup_value(c) >= 0 { 1 }
  else {
    let def = pipeline_ir_value_def_lookup(table, v)
    if def != 0 and node_f1(def) == 4 { 1 }
    else {
      if pipeline_ir_param_nlist_contains(l0, v) == 1 { 1 }
      else {
        let chain = pipeline_ir_block_entry_facts_block_chain(facts, block_id)
        let nonneg = pipeline_ir_block_entry_nonnegative_fact_lookup_chain(chain, block_id, v)
        if pipeline_ir_const_lookup_valid(nonneg) == 1 and pipeline_ir_const_lookup_value(nonneg) == 1 { 1 }
        else {
          let zero = pipeline_ir_block_entry_zero_fact_lookup_chain(chain, block_id, v)
          if pipeline_ir_const_lookup_valid(zero) == 1 and pipeline_ir_const_lookup_value(zero) == 1 { 1 }
          else { if pipeline_ir_chain_param_bool_scan(chain, table, v, 3) >= 0 { 1 } else { 0 } }
        }
      }
    }
  }
}

pub(package) fn pipeline_ir_param_block_is_branch_target(blocks: IrBlockList, id: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(bid, params, insts, term) -> {
          let hit = match term {
            IrTermBranch(cond, then_block, else_block) -> if then_block == id or else_block == id { 1 } else { 0 }
            _ -> 0
          }
          if hit == 1 { 1 } else { pipeline_ir_param_block_is_branch_target(rest, id) }
        }
      }
    }
  }
}

-- L0 legs over every jump edge into hdr for the param at index k.
-- Returns the edge count when all legs pass, -1 otherwise.
pub(package) fn pipeline_ir_param_l0_edges(blocks: IrBlockList, all_blocks: IrBlockList, table: i64, facts: PipelineIrBlockEntryFactList, hdr: i64, k: i64, p: i64, l0: i64, dom_sets: i64, dom_max: i64, dom_words: i64, count: i64) -> i64 {
  match blocks {
    IrBlockListNil -> count
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          let verdict = match term {
            IrTermJump(target, args) -> {
              if target != hdr { 0 }
              else {
                let a = pipeline_ir_value_list_get_or(args, k, 0 - 1)
                if a < 0 { 0 - 1 }
                else { if a == p { 1 }
                else { if pipeline_ir_param_value_nonneg_at(facts, table, id, l0, a) == 1 { 1 }
                else {
                  let def = pipeline_ir_value_def_lookup(table, a)
                  let inc_ok = if def != 0 and node_f1(def) == 5 {
                    let lc = pipeline_ir_param_arg_const(table, node_f3(def))
                    let rc = pipeline_ir_param_arg_const(table, node_f4(def))
                    let self_inc = if node_f3(def) == p and pipeline_ir_const_lookup_valid(rc) == 1 and pipeline_ir_const_lookup_value(rc) == 1 { 1 } else { if node_f4(def) == p and pipeline_ir_const_lookup_valid(lc) == 1 and pipeline_ir_const_lookup_value(lc) == 1 { 1 } else { 0 } }
                    if self_inc == 1 { pipeline_ir_param_bound_above_dominating(all_blocks, table, facts, p, id, dom_sets, dom_max, dom_words) } else { 0 }
                  } else { 0 }
                  if inc_ok == 1 { 1 } else { 0 - 1 }
                } } }
              }
            }
            _ -> 0
          }
          if verdict < 0 { 0 - 1 } else { pipeline_ir_param_l0_edges(rest, all_blocks, table, facts, hdr, k, p, l0, dom_sets, dom_max, dom_words, count + verdict) }
        }
      }
    }
  }
}

-- L1 legs (tolerance one). Returns edge count or -1.
pub(package) fn pipeline_ir_param_l1_edges(blocks: IrBlockList, table: i64, facts: PipelineIrBlockEntryFactList, hdr: i64, k: i64, p: i64, l0: i64, count: i64) -> i64 {
  match blocks {
    IrBlockListNil -> count
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          let verdict = match term {
            IrTermJump(target, args) -> {
              if target != hdr { 0 }
              else {
                let a = pipeline_ir_value_list_get_or(args, k, 0 - 1)
                if a < 0 { 0 - 1 }
                else { if a == p { 1 }
                else {
                  let c = pipeline_ir_param_arg_const(table, a)
                  if pipeline_ir_const_lookup_valid(c) == 1 and pipeline_ir_const_lookup_value(c) >= 0 - 1 { 1 }
                  else { if pipeline_ir_param_value_nonneg_at(facts, table, id, l0, a) == 1 { 1 }
                  else {
                    let def = pipeline_ir_value_def_lookup(table, a)
                    let dec_ok = if def != 0 and node_f1(def) == 7 {
                      let rc = pipeline_ir_param_arg_const(table, node_f4(def))
                      if pipeline_ir_const_lookup_valid(rc) == 1 and pipeline_ir_const_lookup_value(rc) == 1 {
                        pipeline_ir_param_value_nonneg_at(facts, table, id, l0, node_f3(def))
                      } else { 0 }
                    } else { 0 }
                    if dec_ok == 1 { 1 } else { 0 - 1 }
                  } }
                } }
              }
            }
            _ -> 0
          }
          if verdict < 0 { 0 - 1 } else { pipeline_ir_param_l1_edges(rest, table, facts, hdr, k, p, l0, count + verdict) }
        }
      }
    }
  }
}

-- U legs: state travels as node(ok, vec, h_min, fresh_count) with
-- vec = -1 until a fresh leg fixes it. Fresh legs from different
-- vectors, increment backedges, or unprovable args poison the param.
pub(package) fn pipeline_ir_param_u_edges(blocks: IrBlockList, table: i64, facts: PipelineIrBlockEntryFactList, hdr: i64, k: i64, p: i64, l0: i64, l1: i64, state: i64) -> i64 {
  match blocks {
    IrBlockListNil -> state
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          if node_f1(state) == 0 { state }
          else {
            let next = match term {
              IrTermJump(target, args) -> {
                if target != hdr { state }
                else {
                  let a = pipeline_ir_value_list_get_or(args, k, 0 - 1)
                  if a < 0 { node_new(0, 0, 0, 0, 0) }
                  else { if a == p { state }
                  else {
                    let chain = pipeline_ir_block_entry_facts_block_chain(facts, id)
                    let def = pipeline_ir_value_def_lookup(table, a)
                    let is_sub = if def != 0 and node_f1(def) == 7 { 1 } else { 0 }
                    let sub_c = if is_sub == 1 { pipeline_ir_param_arg_const(table, node_f4(def)) } else { pipeline_ir_const_lookup(0, 0) }
                    let self_dec = if is_sub == 1 and node_f3(def) == p and pipeline_ir_const_lookup_valid(sub_c) == 1 and pipeline_ir_const_lookup_value(sub_c) >= 0 { 1 } else { 0 }
                    if self_dec == 1 {
                      let p_low = if pipeline_ir_param_nlist_contains(l1, p) == 1 { 1 } else { pipeline_ir_param_value_nonneg_at(facts, table, id, l0, p) }
                      if p_low == 1 { state } else { node_new(0, 0, 0, 0, 0) }
                    } else {
                      -- Fresh leg: q - c with q bounded at the source,
                      -- or a value already carrying an upper fact.
                      let fresh = if is_sub == 1 and pipeline_ir_const_lookup_valid(sub_c) == 1 and pipeline_ir_const_lookup_value(sub_c) >= 1 and pipeline_ir_const_lookup_value(sub_c) <= 4095 {
                        let q = node_f3(def)
                        let qv = pipeline_ir_chain_value_upper_vec(chain, q)
                        let qv2 = if qv >= 0 { qv } else { pipeline_ir_chain_param_bool_scan(chain, table, q, 2) }
                        if qv2 >= 0 { node_new(0, 1, qv2, pipeline_ir_const_lookup_value(sub_c), 0) } else { node_new(0, 0, 0, 0, 0) }
                      } else {
                        let av = pipeline_ir_chain_value_upper_vec(chain, a)
                        let av2 = if av >= 0 { av } else { pipeline_ir_chain_param_bool_scan(chain, table, a, 2) }
                        if av2 >= 0 { node_new(0, 1, av2, 0, 0) } else { node_new(0, 0, 0, 0, 0) }
                      }
                      if node_f1(fresh) == 0 { node_new(0, 0, 0, 0, 0) }
                      else {
                        let vec = node_f2(fresh)
                        let h = node_f3(fresh)
                        if node_f2(state) >= 0 and node_f2(state) != vec { node_new(0, 0, 0, 0, 0) }
                        else {
                          let new_h = if node_f4(state) == 0 { h } else { if h < node_f3(state) { h } else { node_f3(state) } }
                          node_new(0, 1, vec, new_h, node_f4(state) + 1)
                        }
                      }
                    }
                  } }
                }
              }
              _ -> state
            }
            pipeline_ir_param_u_edges(rest, table, facts, hdr, k, p, l0, l1, next)
          }
        }
      }
    }
  }
}

pub(package) fn pipeline_ir_seed_param_nonneg_blocks(blocks: IrBlockList, p: i64, facts: PipelineIrBlockEntryFactList) -> PipelineIrBlockEntryFactList {
  match blocks {
    IrBlockListNil -> facts
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          pipeline_ir_seed_param_nonneg_blocks(rest, p, pipeline_ir_block_entry_fact_add_result_facts(pipeline_ir_block_entry_facts_add_scalar(facts, id, p, pipeline_ir_scalar_fact_kind_nonnegative(), 1)))
        }
      }
    }
  }
}

pub(package) fn pipeline_ir_seed_param_upper_blocks(blocks: IrBlockList, vec: i64, p: i64, facts: PipelineIrBlockEntryFactList) -> PipelineIrBlockEntryFactList {
  match blocks {
    IrBlockListNil -> facts
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          pipeline_ir_seed_param_upper_blocks(rest, vec, p, pipeline_ir_block_entry_fact_add_result_facts(pipeline_ir_block_entry_facts_add_vector_upper(facts, id, vec, p)))
        }
      }
    }
  }
}

-- Derived offsets: dst = p + c in some block, p in L0 or L1, p
-- carrying a U entry (the upper bound keeps the sum far below the
-- integer maximum, so the addition cannot wrap). Seeds nonneg(dst)
-- at the defining block, plus an upper fact when c <= h.
pub(package) fn pipeline_ir_seed_param_offset_insts(insts: IrInstList, block_id: i64, table: i64, l0: i64, l1: i64, u_params: i64, facts: PipelineIrBlockEntryFactList, counter: i64) -> PipelineIrBlockEntryFactList {
  match insts {
    IrInstNil -> facts
    IrInstCons(inst, rest) -> {
      let next = match inst {
        IrBinaryI64(dst, op, lhs, rhs) -> {
          if pipeline_ir_binary_is_add(op) == 1 {
            let lc = pipeline_ir_param_arg_const(table, lhs)
            let rc = pipeline_ir_param_arg_const(table, rhs)
            let x = if pipeline_ir_const_lookup_valid(rc) == 1 { lhs } else { if pipeline_ir_const_lookup_valid(lc) == 1 { rhs } else { 0 - 1 } }
            let c = if pipeline_ir_const_lookup_valid(rc) == 1 { pipeline_ir_const_lookup_value(rc) } else { if pipeline_ir_const_lookup_valid(lc) == 1 { pipeline_ir_const_lookup_value(lc) } else { 0 } }
            if x >= 0 and c >= 1 and c <= 4095 {
              if pipeline_ir_param_nlist_contains(l0, x) == 1 or pipeline_ir_param_nlist_contains(l1, x) == 1 {
                let n = nlist_len(u_params)
                let mut i = 0
                let mut vec = 0 - 1
                let mut h = 0 - 1
                while i < n {
                  let entry = nlist_get(u_params, i)
                  if node_f1(entry) == x { vec = node_f2(entry) h = node_f3(entry) i = n } else { i = i + 1 }
                }
                if vec >= 0 {
                  mem_store64_at(counter, 0, mem_load64_at(counter, 0) + 1)
                  let with_nonneg = pipeline_ir_block_entry_fact_add_result_facts(pipeline_ir_block_entry_facts_add_scalar(facts, block_id, dst, pipeline_ir_scalar_fact_kind_nonnegative(), 1))
                  if c <= h {
                    pipeline_ir_block_entry_fact_add_result_facts(pipeline_ir_block_entry_facts_add_vector_upper(with_nonneg, block_id, vec, dst))
                  } else { with_nonneg }
                } else { facts }
              } else { facts }
            } else { facts }
          } else { facts }
        }
        _ -> facts
      }
      pipeline_ir_seed_param_offset_insts(rest, block_id, table, l0, l1, u_params, next, counter)
    }
  }
}

pub(package) fn pipeline_ir_seed_param_offset_blocks(blocks: IrBlockList, table: i64, l0: i64, l1: i64, u_params: i64, facts: PipelineIrBlockEntryFactList, counter: i64) -> PipelineIrBlockEntryFactList {
  match blocks {
    IrBlockListNil -> facts
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          pipeline_ir_seed_param_offset_blocks(rest, table, l0, l1, u_params, pipeline_ir_seed_param_offset_insts(insts, id, table, l0, l1, u_params, facts, counter), counter)
        }
      }
    }
  }
}

-- Compute L0/L1/U verdicts for every multi-pred header param and seed
-- the resulting facts. counter receives the number of seeded findings
-- so the caller can skip the re-tightening walk when nothing changed.
pub(package) fn pipeline_ir_seed_param_induction_facts(blocks: IrBlockList, cfg: i64, facts: PipelineIrBlockEntryFactList, max_id: i64, counter: i64, dom: i64) -> PipelineIrBlockEntryFactList {
  let table = pipeline_ir_cfg_bundle_def_table(cfg)
  let dom_sets = pipeline_ir_dom_handle_ensure(dom, blocks, max_id)
  let dom_words = pipeline_ir_dom_handle_words(dom)
  let len_stable = pipeline_ir_cfg_bundle_len_stable(cfg)
  let l0 = nlist_new()
  let l1 = nlist_new()
  let u_params = nlist_new()
  -- L0 rounds: two passes so a header can consume another header's
  -- proven params (nested loops initialise inner params from outer).
  let mut round = 0
  while round < 2 {
    let mut cur = blocks
    let mut done = 0
    while done == 0 {
      match cur {
        IrBlockListNil -> { done = 1 }
        IrBlockListCons(block, rest) -> {
          match block {
            IrBlock(id, params, insts, term) -> {
              if ir_value_list_len(params) >= 1 and pipeline_ir_cfg_bundle_pred_count(cfg, id) >= 2 and pipeline_ir_param_block_is_branch_target(blocks, id) == 0 {
                let np = ir_value_list_len(params)
                let mut k = 0
                while k < np {
                  let p = pipeline_ir_value_list_get_or(params, k, 0 - 1)
                  if p >= 0 and pipeline_ir_param_nlist_contains(l0, p) == 0 {
                    if pipeline_ir_param_l0_edges(blocks, blocks, table, facts, id, k, p, l0, dom_sets, max_id, dom_words, 0) >= 1 { nlist_add(l0, p) } else { 0 }
                  } else { 0 }
                  k = k + 1
                }
                0
              } else { 0 }
              cur = rest
            }
          }
        }
      }
    }
    round = round + 1
  }
  -- L1 + U single passes over the same headers.
  let mut cur2 = blocks
  let mut done2 = 0
  while done2 == 0 {
    match cur2 {
      IrBlockListNil -> { done2 = 1 }
      IrBlockListCons(block, rest) -> {
        match block {
          IrBlock(id, params, insts, term) -> {
            if ir_value_list_len(params) >= 1 and pipeline_ir_cfg_bundle_pred_count(cfg, id) >= 2 and pipeline_ir_param_block_is_branch_target(blocks, id) == 0 {
              let np = ir_value_list_len(params)
              let mut k = 0
              while k < np {
                let p = pipeline_ir_value_list_get_or(params, k, 0 - 1)
                if p >= 0 {
                  if pipeline_ir_param_nlist_contains(l0, p) == 0 and pipeline_ir_param_nlist_contains(l1, p) == 0 {
                    if pipeline_ir_param_l1_edges(blocks, table, facts, id, k, p, l0, 0) >= 1 { nlist_add(l1, p) } else { 0 }
                  } else { 0 }
                  if len_stable == 1 {
                    let ustate = pipeline_ir_param_u_edges(blocks, table, facts, id, k, p, l0, l1, node_new(0, 1, 0 - 1, 0, 0))
                    if node_f1(ustate) == 1 and node_f4(ustate) >= 1 and node_f2(ustate) >= 0 { nlist_add(u_params, node_new(0, p, node_f2(ustate), node_f3(ustate), 0)) } else { 0 }
                  } else { 0 }
                } else { 0 }
                k = k + 1
              }
              0
            } else { 0 }
            cur2 = rest
          }
        }
      }
    }
  }
  -- Seeding.
  let mut result = facts
  let nl0 = nlist_len(l0)
  let mut i0 = 0
  while i0 < nl0 {
    result = pipeline_ir_seed_param_nonneg_blocks(blocks, nlist_get(l0, i0), result)
    mem_store64_at(counter, 0, mem_load64_at(counter, 0) + 1)
    i0 = i0 + 1
  }
  let nu = nlist_len(u_params)
  let mut iu = 0
  while iu < nu {
    let entry = nlist_get(u_params, iu)
    result = pipeline_ir_seed_param_upper_blocks(blocks, node_f2(entry), node_f1(entry), result)
    mem_store64_at(counter, 0, mem_load64_at(counter, 0) + 1)
    iu = iu + 1
  }
  pipeline_ir_seed_param_offset_blocks(blocks, table, l0, l1, u_params, result, counter)
}

pub(package) fn pipeline_ir_blocks_vector_mode_missing(blocks: IrBlockList) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          if pipeline_ir_insts_vector_mode_missing(insts) == 1 { 1 } else { pipeline_ir_blocks_vector_mode_missing(rest) }
        }
      }
    }
  }
}

pub(package) fn pipeline_ir_insts_vector_mode_missing(insts: IrInstList) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let hit = match inst {
        IrVectorGetI64(dst, vec, index, fallback, check_mode) -> if (check_mode band 6) != 6 { 1 } else { 0 }
        IrVectorSetI64(dst, vec, index, value, check_mode) -> if (check_mode band 6) != 6 { 1 } else { 0 }
        _ -> 0
      }
      if hit == 1 { 1 } else { pipeline_ir_insts_vector_mode_missing(rest) }
    }
  }
}

pub(package) fn pipeline_ir_blocks_have_param_header_pc(blocks: IrBlockList, pc: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          if ir_value_list_len(params) >= 1 and pipeline_ir_block_pred_count_get(pc, id) >= 2 { 1 } else { pipeline_ir_blocks_have_param_header_pc(rest, pc) }
        }
      }
    }
  }
}

-- A loop-shaped header param: some jump edge feeds it its own value
-- plus/minus something, or another value's add/sub result. Merge-only
-- headers (no self-arithmetic anywhere) can never pass the induction
-- legs that matter, so the expensive fact-plane build is skipped.
pub(package) fn pipeline_ir_blocks_have_loop_shaped_param(blocks: IrBlockList, all_blocks: IrBlockList, pc: i64, table: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          let hit = match term {
            IrTermJump(target, args) -> {
              if pipeline_ir_block_pred_count_get(pc, target) >= 2 {
                pipeline_ir_args_have_param_arith(args, pipeline_ir_block_params_or(all_blocks, target, ir_value_list_empty()), table)
              } else { 0 }
            }
            _ -> 0
          }
          if hit == 1 { 1 } else { pipeline_ir_blocks_have_loop_shaped_param(rest, all_blocks, pc, table) }
        }
      }
    }
  }
}

pub(package) fn pipeline_ir_args_have_param_arith(args: IrValueList, params: IrValueList, table: i64) -> i64 {
  match args {
    IrValueNil -> 0
    IrValueCons(a, arest) -> {
      match params {
        IrValueNil -> 0
        IrValueCons(p, prest) -> {
          let def = pipeline_ir_value_def_lookup(table, a)
          let hit = if def != 0 and (node_f1(def) == 5 or node_f1(def) == 7) {
            if node_f3(def) == p or node_f4(def) == p { 1 } else { 0 }
          } else { 0 }
          if hit == 1 { 1 } else { pipeline_ir_args_have_param_arith(arest, prest, table) }
        }
      }
    }
  }
}

-- Post-promotion re-tightening: rebuild the fact plane over promoted
-- IR, add param-induction facts, and re-run the existing
-- fact-consuming walk. Check modes only gain bits (the walk's
-- tightening is bor-monotone); every kill rule the main pass applies
-- runs here through the same code.
pub(package) fn pipeline_mem2reg_retighten_function(irf: IrFunction, facts: PipelineIrSemanticFactList, pure_callees: i64) -> IrFunction {
  match irf {
    IrFunction(hash, param_count, blocks, src) -> {
      if pipeline_ir_blocks_vector_mode_missing(blocks) == 0 { irf }
      else { if pipeline_ir_native_blocks_have_handles(blocks) == 1 { irf }
      else { if pipeline_ir_native_blocks_have_lambdas(blocks) == 1 { irf }
      else {
        let block_count = ir_block_list_len(blocks)
        let max_id = pipeline_ir_verify_max_block_id(blocks)
        if block_count < 2 or max_id < 0 or max_id > 63 or block_count > pipeline_ir_block_entry_fact_effective_block_limit(blocks) { irf }
        else {
          -- Cheap-first gates: pred counts alone decide the header
          -- check; the full bundle (def table, len-stable map) builds
          -- only for functions with a multi-pred param header, and the
          -- fact plane only for those with a loop-shaped param (some
          -- backedge feeds a param its own add/sub — merge-only
          -- headers are already served by the main pass's fact joins).
          let pc = pipeline_ir_block_pred_counts(blocks)
          if pipeline_ir_blocks_have_param_header_pc(blocks, pc) == 0 { irf }
          else {
          let bundle = pipeline_ir_cfg_fact_bundle_with_pure(blocks, pure_callees)
          if pipeline_ir_blocks_have_loop_shaped_param(blocks, blocks, pc, pipeline_ir_cfg_bundle_def_table(bundle)) == 0 { irf }
          else {
            let seed = pipeline_ir_block_entry_facts_from_blocks_inner(blocks, blocks, bundle, pipeline_ir_block_entry_facts_empty())
            let propagated = pipeline_ir_block_entry_facts_propagate_fixpoint(blocks, bundle, seed, block_count + 1)
            -- One shared dominator handle serves all four consumers (shared dominator analysis).
            let dom = pipeline_ir_dom_handle_new()
            let with_nonneg = pipeline_ir_seed_slot_nonneg_facts(blocks, bundle, propagated, dom)
            let with_upper = pipeline_ir_seed_slot_upper_facts(blocks, bundle, with_nonneg, dom)
            let base = pipeline_ir_flood_slot_row_upper_facts(blocks, bundle, with_upper, dom)
            let counter = alloc_words(1)
            mem_store64_at(counter, 0, 0)
            let enriched = pipeline_ir_seed_param_induction_facts(blocks, bundle, base, max_id, counter, dom)
            if mem_load64_at(counter, 0) == 0 { irf }
            else {
              let consts = pipeline_ir_const_env_from_block_list(blocks, pipeline_ir_const_env_empty())
              let ctx = pipeline_ir_optimise_context4(facts, PipelineIrInlineCandidateNil, pure_callees, param_count)
              let next_value = pipeline_ir_function_next_value(param_count, blocks)
              let walked = pipeline_optimise_ir_block_list_with_param_consts(blocks, blocks, consts, ctx, enriched, next_value)
              ir_function_new_blocks_src(hash, param_count, pipeline_optimised_blocks_blocks(walked), src)
            }
          }
          }
        }
      } } } }
    }
  }
}

pub(package) fn pipeline_mem2reg_retighten_function_list(functions: IrFunctionList, facts: PipelineIrSemanticFactList, pure_callees: i64) -> IrFunctionList {
  match functions {
    IrFunctionNil -> IrFunctionNil
    IrFunctionCons(irf, rest) -> IrFunctionCons(pipeline_mem2reg_retighten_function(irf, facts, pure_callees), pipeline_mem2reg_retighten_function_list(rest, facts, pure_callees))
    _ -> functions
  }
}

-- promote = 0 stops before slot-to-SSA promotion: the slot-keyed fact
-- probes in the bounds metrics analyse the IR the fact plane actually
-- runs on (facts are decided before promotion rewrites the slots away).
pub(package) fn pipeline_optimise_typed_ir_pre_promotion(typed: TypedModule, ir: IrModule) -> IrModule {
  pipeline_optimise_typed_ir_with_promotion(typed, ir, 0)
}

-- Collect hoisted lambda-body functions carried by IrClosureI64 insts
-- (lambda hoisting) into the module function list, recursively (a hoisted
-- body may itself construct closures). Dedup by hash: the same site in
-- a shared template can surface through multiple spec functions.

pub(package) fn pipeline_ir_hoisted_fns_handler_clauses(clauses: IrHandlerClauseBodyList, acc: IrFunctionList) -> IrFunctionList {
  match clauses {
    IrHandlerClauseBodyNil -> acc
    IrHandlerClauseBodyCons(body, rest) -> {
      let next = match body {
        IrHandlerClauseBody(op_hash, nparams, captures, has_continuation, is_abortive, result_cleanup_kind, transferred_param_value_fact, resume_lanes, result_lanes, first_value, blocks) -> pipeline_ir_hoisted_fns_blocks(blocks, acc)
        IrHandlerClauseBodyInvalid(reason) -> acc
      }
      pipeline_ir_hoisted_fns_handler_clauses(rest, next)
    }
  }
}

pub(package) fn pipeline_ir_hoisted_fns_deferred_body(body: IrDeferredHandlerBody, acc: IrFunctionList) -> IrFunctionList {
  match body {
    IrDeferredHandlerBody(body_src, captures, ops_value, result_lanes, first_value, blocks, completion) -> {
      let body_fns = pipeline_ir_hoisted_fns_blocks(blocks, acc)
      match completion {
        IrDeferredCompletionBodyNone -> body_fns
        IrDeferredCompletionBody(input_lanes, output_lanes, completion_first_value, completion_blocks) -> pipeline_ir_hoisted_fns_blocks(completion_blocks, body_fns)
        IrDeferredCompletionBodyInvalid(reason) -> body_fns
      }
    }
    IrDeferredHandlerBodyInvalid(reason) -> acc
  }
}

pub(package) fn pipeline_ir_hoisted_fns_insts(insts: IrInstList, acc: IrFunctionList) -> IrFunctionList {
  match insts {
    IrInstNil -> acc
    IrInstCons(inst, rest) -> {
      let next = match inst {
        IrClosureI64(dst, f, captures, eff) -> {
          match f {
            IrFunction(chash, cparams, cblocks, csrc) -> pipeline_ir_hoisted_fns_blocks(cblocks, ir_function_list_prepend(f, acc))
          }
        }
        IrHandleI64(dst, handle_src, effect_hash, clauses, nclauses, reserved) -> pipeline_ir_hoisted_fns_handler_clauses(clauses, acc)
        IrDeferredHandleI64(dst, handle_src, body, clauses, nclauses, effect_hash, scratch_base) -> {
          pipeline_ir_hoisted_fns_deferred_body(body, pipeline_ir_hoisted_fns_handler_clauses(clauses, acc))
        }
        _ -> acc
      }
      pipeline_ir_hoisted_fns_insts(rest, next)
    }
  }
}

pub(package) fn pipeline_ir_hoisted_fns_blocks(blocks: IrBlockList, acc: IrFunctionList) -> IrFunctionList {
  match blocks {
    IrBlockListNil -> acc
    IrBlockListCons(block, rest) -> {
      let next = match block {
        IrBlock(id, params, insts, term) -> pipeline_ir_hoisted_fns_insts(insts, acc)
      }
      pipeline_ir_hoisted_fns_blocks(rest, next)
    }
  }
}

pub(package) fn pipeline_ir_hoisted_lambda_fns_extend(functions: IrFunctionList) -> IrFunctionList {
  let mut acc = ir_function_list_empty()
  let mut cur = functions
  let mut walking = 1
  while walking == 1 {
    match cur {
      IrFunctionNil -> { walking = 0 }
      IrFunctionCons(f, rest) -> {
        match f {
          IrFunction(hash, params, blocks, src) -> {
            acc = pipeline_ir_hoisted_fns_blocks(blocks, acc)
            0
          }
        }
        cur = rest
      }
    }
  }
  match acc {
    IrFunctionNil -> functions
    IrFunctionCons(f, rest) -> pipeline_ir_function_list_append(functions, pipeline_ir_function_list_dedup(acc))
  }
}

pub(package) fn pipeline_ir_lambda_semantic_facts_handler_clauses(clauses: IrHandlerClauseBodyList, facts: PipelineIrSemanticFactList) -> PipelineIrSemanticFactList {
  match clauses {
    IrHandlerClauseBodyNil -> facts
    IrHandlerClauseBodyCons(body, rest) -> {
      let next = match body {
        IrHandlerClauseBody(op_hash, nparams, captures, has_continuation, is_abortive, result_cleanup_kind, transferred_param_value_fact, resume_lanes, result_lanes, first_value, blocks) -> pipeline_ir_lambda_semantic_facts_blocks(blocks, facts)
        IrHandlerClauseBodyInvalid(reason) -> facts
      }
      pipeline_ir_lambda_semantic_facts_handler_clauses(rest, next)
    }
  }
}

pub(package) fn pipeline_ir_lambda_semantic_facts_deferred_body(body: IrDeferredHandlerBody, facts: PipelineIrSemanticFactList) -> PipelineIrSemanticFactList {
  match body {
    IrDeferredHandlerBody(body_src, captures, ops_value, result_lanes, first_value, blocks, completion) -> {
      let body_facts = pipeline_ir_lambda_semantic_facts_blocks(blocks, facts)
      match completion {
        IrDeferredCompletionBodyNone -> body_facts
        IrDeferredCompletionBody(input_lanes, output_lanes, completion_first_value, completion_blocks) -> pipeline_ir_lambda_semantic_facts_blocks(completion_blocks, body_facts)
        IrDeferredCompletionBodyInvalid(reason) -> body_facts
      }
    }
    IrDeferredHandlerBodyInvalid(reason) -> facts
  }
}

pub(package) fn pipeline_ir_lambda_semantic_facts_insts(insts: IrInstList, facts: PipelineIrSemanticFactList) -> PipelineIrSemanticFactList {
  match insts {
    IrInstNil -> facts
    IrInstCons(inst, rest) -> {
      let next = match inst {
        IrClosureI64(dst, f, captures, lambda_facts) -> {
          match f {
            IrFunction(hash, nparams, blocks, src) -> {
              let with_current = pipeline_ir_semantic_facts_prepend_with_borrow(
                hash,
                ir_lambda_semantic_facts_fact(lambda_facts),
                ir_lambda_semantic_facts_borrow(lambda_facts),
                facts
              )
              pipeline_ir_lambda_semantic_facts_blocks(blocks, with_current)
            }
          }
        }
        IrHandleI64(dst, handle_src, effect_hash, clauses, nclauses, reserved) -> pipeline_ir_lambda_semantic_facts_handler_clauses(clauses, facts)
        IrDeferredHandleI64(dst, handle_src, body, clauses, nclauses, effect_hash, scratch_base) -> {
          pipeline_ir_lambda_semantic_facts_deferred_body(body, pipeline_ir_lambda_semantic_facts_handler_clauses(clauses, facts))
        }
        _ -> facts
      }
      pipeline_ir_lambda_semantic_facts_insts(rest, next)
    }
  }
}

pub(package) fn pipeline_ir_lambda_semantic_facts_blocks(blocks: IrBlockList, facts: PipelineIrSemanticFactList) -> PipelineIrSemanticFactList {
  match blocks {
    IrBlockListNil -> facts
    IrBlockListCons(block, rest) -> {
      let next = match block {
        IrBlock(id, params, insts, term) -> pipeline_ir_lambda_semantic_facts_insts(insts, facts)
      }
      pipeline_ir_lambda_semantic_facts_blocks(rest, next)
    }
  }
}

pub(package) fn pipeline_ir_lambda_semantic_facts_extend(functions: IrFunctionList, facts: PipelineIrSemanticFactList) -> PipelineIrSemanticFactList {
  match functions {
    IrFunctionNil -> facts
    IrFunctionCons(f, rest) -> {
      let next = match f {
        IrFunction(hash, nparams, blocks, src) -> pipeline_ir_lambda_semantic_facts_blocks(blocks, facts)
      }
      pipeline_ir_lambda_semantic_facts_extend(rest, next)
    }
  }
}

-- Fresh managed-return provenance ---------------------------------
--
-- This is the allocation half of the consuming-update summary. Start from
-- semantic allocation roots and managed constructors, propagate through exact
-- call-return aliases and concrete generic factories, and require every
-- reachable return path to carry fresh storage. Consumers read the shared fact;
-- they never recognize Map, Vector, or another library family by name.

pub(package) fn pipeline_ir_fresh_return_allocator_hash(hash: i64) -> i64 {
  pipeline_ir_native_fresh_managed_alloc_hash(hash)
}

pub(package) fn pipeline_ir_fresh_return_param_head_or(shapes: i64, index: i64, default: i64) -> i64 {
  if shapes == 0 or index < 0 or index >= nlist_len(shapes) { default }
  else {
    let mut head = 0
    let mut i = 0
    while i < index and head >= 0 {
      let lanes = ir_value_shape_lane_count(nlist_get(shapes, i))
      if lanes < 0 { head = 0 - 1 } else { head = head + lanes }
      i = i + 1
    }
    if head < 0 { default } else { head }
  }
}

pub(package) fn pipeline_ir_fresh_return_alias_mask_all(mask: i64, index: i64, args: IrValueList, shapes: i64, fresh: PipelineIrLiveSet, seen: i64) -> i64 {
  if index >= 60 or shapes == 0 or index >= nlist_len(shapes) { if seen > 0 { 1 } else { 0 } }
  else {
    if (mask band cg_bit(index)) == 0 {
      pipeline_ir_fresh_return_alias_mask_all(mask, index + 1, args, shapes, fresh, seen)
    } else {
      let head = pipeline_ir_fresh_return_param_head_or(shapes, index, 0 - 1)
      let arg = if head < 0 { 0 - 1 } else { ir_value_list_nth_or(args, head, 0 - 1) }
      if arg < 0 or pipeline_ir_live_set_contains(fresh, arg) != 1 { 0 }
      else { pipeline_ir_fresh_return_alias_mask_all(mask, index + 1, args, shapes, fresh, seen + 1) }
    }
  }
}

pub(package) fn pipeline_ir_fresh_return_call_produces(callee_hash: i64, args: IrValueList, facts: PipelineIrSemanticFactList, fresh: PipelineIrLiveSet) -> i64 {
  if pipeline_ir_fresh_return_allocator_hash(callee_hash) == 1 { 1 }
  else { if callee_hash == pipeline_ir_native_intrinsic_transmute_hash() {
    let source = ir_value_list_nth_or(args, 0, 0 - 1)
    if source >= 0 and pipeline_ir_live_set_contains(fresh, source) == 1 { 1 } else { 0 }
  } else {
    let fact = pipeline_ir_semantic_fact_find(facts, callee_hash)
    if cg_semantic_fact_fresh_managed_return(fact) == 1 { 1 }
    else {
      let alias_mask = cg_semantic_fact_return_alias_param_mask(fact)
      if alias_mask == 0 { 0 }
      else { pipeline_ir_fresh_return_alias_mask_all(alias_mask, 0, args, cg_semantic_fact_param_shapes(fact), fresh, 0) }
    }
  } }
}

pub(package) fn pipeline_ir_fresh_return_add_inst(inst: IrInst, facts: PipelineIrSemanticFactList, fresh: PipelineIrLiveSet) -> PipelineIrLiveSet {
  match inst {
    IrStringLit(dst, start, len) -> pipeline_ir_live_set_add(fresh, dst)
    IrStringConcatI64(dst, left, right) -> pipeline_ir_live_set_add(fresh, dst)
    IrClosureI64(dst, function, captures, lambda_facts) -> pipeline_ir_live_set_add(fresh, dst)
    IrVariantInitI64(dst, tag_hash, payloads, field_mask) -> pipeline_ir_live_set_add(fresh, dst)
    IrRecordInitI64(dst, type_hash, fields) -> pipeline_ir_live_set_add(fresh, dst)
    IrRecordLayoutInitI64(dst, type_hash, data_size, align, fields) -> pipeline_ir_live_set_add(fresh, dst)
    IrReuseInitI64(token, constructor) -> pipeline_ir_live_set_add(fresh, pipeline_ir_inst_def_or(constructor, 0 - 1))
    -- IrResumeI64 is the lowered tail-resume copy: native emission moves its
    -- input directly into the destination, so provenance follows the alias.
    IrResumeI64(dst, value) -> if pipeline_ir_live_set_contains(fresh, value) == 1 { pipeline_ir_live_set_add(fresh, dst) } else { fresh }
    IrCallI64(dst, callee_hash, args) -> if pipeline_ir_fresh_return_call_produces(callee_hash, args, facts, fresh) == 1 { pipeline_ir_live_set_add(fresh, dst) } else { fresh }
    IrGenericCallI64(dst, callee_hash, type_args, args) -> {
      let concrete = pipeline_ir_function_ref_target_hash(callee_hash, type_args)
      if pipeline_ir_fresh_return_call_produces(concrete, args, facts, fresh) == 1 { pipeline_ir_live_set_add(fresh, dst) } else { fresh }
    }
    IrMethodCallI64(dst, type_hash, method_hash, receiver, args) -> {
      let qualified = pipeline_ir_method_patch_key(type_hash, method_hash)
      let callee_hash = if pipeline_ir_semantic_fact_find(facts, qualified) != 0 { qualified } else { method_hash }
      let call_args = ir_value_list_prepend(receiver, args)
      if pipeline_ir_fresh_return_call_produces(callee_hash, call_args, facts, fresh) == 1 { pipeline_ir_live_set_add(fresh, dst) } else { fresh }
    }
    _ -> fresh
  }
}

pub(package) fn pipeline_ir_fresh_return_add_insts(insts: IrInstList, facts: PipelineIrSemanticFactList, fresh: PipelineIrLiveSet) -> PipelineIrLiveSet {
  match insts {
    IrInstNil -> fresh
    IrInstCons(inst, rest) -> pipeline_ir_fresh_return_add_insts(rest, facts, pipeline_ir_fresh_return_add_inst(inst, facts, fresh))
  }
}

pub(package) fn pipeline_ir_fresh_return_add_block_insts(blocks: IrBlockList, facts: PipelineIrSemanticFactList, fresh: PipelineIrLiveSet) -> PipelineIrLiveSet {
  match blocks {
    IrBlockListNil -> fresh
    IrBlockListCons(block, rest) -> match block {
      IrBlock(id, params, insts, term) -> pipeline_ir_fresh_return_add_block_insts(rest, facts, pipeline_ir_fresh_return_add_insts(insts, facts, fresh))
    }
  }
}

-- Positive means at least one reachable incoming edge and every corresponding
-- argument is fresh. Negative counts incoming edges after the first failure.
pub(package) fn pipeline_ir_fresh_return_incoming_state(blocks: IrBlockList, target: i64, lane: i64, fresh: PipelineIrLiveSet, reachable: PipelineIrLiveSet, state: i64) -> i64 {
  match blocks {
    IrBlockListNil -> state
    IrBlockListCons(block, rest) -> match block {
      IrBlock(id, params, insts, term) -> {
        let next = if pipeline_ir_live_set_contains(reachable, id) != 1 { state }
        else { if pipeline_ir_small_variant_insts_never_reach_term(insts) == 1 { state }
        else {
          match term {
            IrTermJump(jump_target, args) -> {
              if jump_target != target { state }
              else {
                let arg = ir_value_list_nth_or(args, lane, 0 - 1)
                if state < 0 { state - 1 }
                else { if arg >= 0 and pipeline_ir_live_set_contains(fresh, arg) == 1 { state + 1 } else { 0 - state - 1 } }
              }
            }
            _ -> state
          }
        } }
        pipeline_ir_fresh_return_incoming_state(rest, target, lane, fresh, reachable, next)
      }
    }
  }
}

pub(package) fn pipeline_ir_fresh_return_add_params(params: IrValueList, lane: i64, target: i64, blocks: IrBlockList, fresh: PipelineIrLiveSet, reachable: PipelineIrLiveSet) -> PipelineIrLiveSet {
  match params {
    IrValueNil -> fresh
    IrValueCons(param, rest) -> {
      let incoming = pipeline_ir_fresh_return_incoming_state(blocks, target, lane, fresh, reachable, 0)
      let next = if incoming > 0 { pipeline_ir_live_set_add(fresh, param) } else { fresh }
      pipeline_ir_fresh_return_add_params(rest, lane + 1, target, blocks, next, reachable)
    }
  }
}

pub(package) fn pipeline_ir_fresh_return_add_block_params(blocks: IrBlockList, all_blocks: IrBlockList, fresh: PipelineIrLiveSet, reachable: PipelineIrLiveSet) -> PipelineIrLiveSet {
  match blocks {
    IrBlockListNil -> fresh
    IrBlockListCons(block, rest) -> match block {
      IrBlock(id, params, insts, term) -> {
        let next = pipeline_ir_fresh_return_add_params(params, 0, id, all_blocks, fresh, reachable)
        pipeline_ir_fresh_return_add_block_params(rest, all_blocks, next, reachable)
      }
    }
  }
}

pub(package) fn pipeline_ir_fresh_return_values(blocks: IrBlockList, facts: PipelineIrSemanticFactList, next_value: i64) -> PipelineIrLiveSet {
  let reachable = pipeline_ir_reachable_fixpoint(blocks, pipeline_ir_reachable_seed(blocks))
  let mut fresh = pipeline_ir_live_set_dense(next_value + 1)
  let mut changed = 1
  let mut budget = next_value + ir_block_list_len(blocks) + 2
  while changed == 1 and budget > 0 {
    let before = pipeline_ir_live_set_len(fresh)
    fresh = pipeline_ir_fresh_return_add_block_insts(blocks, facts, fresh)
    fresh = pipeline_ir_fresh_return_add_block_params(blocks, blocks, fresh, reachable)
    changed = if pipeline_ir_live_set_len(fresh) == before { 0 } else { 1 }
    budget = budget - 1
  }
  fresh
}

pub(package) fn pipeline_ir_fresh_return_terms_all(blocks: IrBlockList, fresh: PipelineIrLiveSet, reachable: PipelineIrLiveSet, returns: i64) -> i64 {
  match blocks {
    IrBlockListNil -> if returns > 0 { returns } else { 0 }
    IrBlockListCons(block, rest) -> match block {
      IrBlock(id, params, insts, term) -> {
        if pipeline_ir_live_set_contains(reachable, id) != 1 {
          pipeline_ir_fresh_return_terms_all(rest, fresh, reachable, returns)
        } else {
          match term {
            IrTermReturn(value) -> {
              if pipeline_ir_live_set_contains(fresh, value) != 1 { 0 }
              else { pipeline_ir_fresh_return_terms_all(rest, fresh, reachable, returns + 1) }
            }
            _ -> pipeline_ir_fresh_return_terms_all(rest, fresh, reachable, returns)
          }
        }
      }
    }
  }
}

pub(package) fn pipeline_ir_fresh_return_function_proves(function: IrFunction, facts: PipelineIrSemanticFactList) -> i64 {
  match function {
    IrFunction(hash, param_count, blocks, src) -> {
      let fact = pipeline_ir_semantic_fact_find(facts, hash)
      if cg_semantic_fact_managed_return(fact) != 1 { 0 }
      else {
        let reachable = pipeline_ir_reachable_fixpoint(blocks, pipeline_ir_reachable_seed(blocks))
        let fresh = pipeline_ir_fresh_return_values(blocks, facts, pipeline_ir_function_next_value(param_count, blocks))
        if pipeline_ir_fresh_return_terms_all(blocks, fresh, reachable, 0) > 0 { 1 } else { 0 }
      }
    }
  }
}

pub(package) fn pipeline_ir_fresh_return_enrich_once(functions: IrFunctionList, facts: PipelineIrSemanticFactList) -> i64 {
  match functions {
    IrFunctionNil -> 0
    IrFunctionCons(function, rest) -> match function {
      IrFunction(hash, param_count, blocks, src) -> {
        let fact = pipeline_ir_semantic_fact_find(facts, hash)
        let add = if fact != 0 and cg_semantic_fact_fresh_managed_return(fact) == 0 and pipeline_ir_fresh_return_function_proves(function, facts) == 1 {
          cg_semantic_fact_set_fresh_managed_return(fact, 1)
          1
        } else { 0 }
        add + pipeline_ir_fresh_return_enrich_once(rest, facts)
      }
    }
  }
}

pub(package) fn pipeline_ir_fresh_return_enrich(functions: IrFunctionList, facts: PipelineIrSemanticFactList) -> PipelineIrSemanticFactList {
  let mut changed = 1
  let mut budget = ir_function_list_len(functions) + 1
  while changed > 0 and budget > 0 {
    changed = pipeline_ir_fresh_return_enrich_once(functions, facts)
    budget = budget - 1
  }
  facts
}

-- A direct retain-return helper is the one source-level retain shape whose
-- call boundary may dissolve without inventing a new ownership transfer: the
-- retain result itself is the function result. Keep this as a semantic fact
-- so every inliner consumes one proof instead of recognising helper names.
pub(package) fn pipeline_ir_direct_retain_return_counts(insts: IrInstList, return_value: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let one = match inst {
        IrCallI64(dst, callee_hash, args) -> {
          if pipeline_ir_abort_cleanup_is_managed_retain_hash(callee_hash) == 1 {
            2 + (if dst == return_value { 1 } else { 0 })
          } else { 0 }
        }
        _ -> 0
      }
      one + pipeline_ir_direct_retain_return_counts(rest, return_value)
    }
  }
}

pub(package) fn pipeline_ir_direct_retain_return_function_proves(function: IrFunction) -> i64 {
  match function {
    IrFunction(hash, param_count, blocks, src) -> match blocks {
      IrBlockListCons(IrBlock(id, params, insts, IrTermReturn(return_value)), IrBlockListNil) -> {
        if pipeline_ir_direct_retain_return_counts(insts, return_value) == 3 { 1 } else { 0 }
      }
      _ -> 0
    }
  }
}

pub(package) fn pipeline_ir_direct_retain_return_enrich(functions: IrFunctionList, facts: PipelineIrSemanticFactList) -> PipelineIrSemanticFactList {
  match functions {
    IrFunctionNil -> facts
    IrFunctionCons(function, rest) -> match function {
      IrFunction(hash, param_count, blocks, src) -> {
        let fact = pipeline_ir_semantic_fact_find(facts, hash)
        if fact != 0 and pipeline_ir_direct_retain_return_function_proves(function) == 1 {
          cg_semantic_fact_set_direct_retain_return(fact, 1)
        } else { 0 }
        pipeline_ir_direct_retain_return_enrich(rest, facts)
      }
    }
  }
}

-- Small-variant scalar replacement -------------------------------
--
-- A fresh variant with one unmanaged payload is two scalar facts wrapped in
-- an allocation. Once inlining has made the whole lifetime local, close that
-- representation through exact SSA transport, reject the complete connected
-- component on any opaque/escaping use, and split safe block parameters into
-- tag + payload lanes. This is deliberately representation-driven: no source,
-- function, type, or constructor name participates in eligibility.

pub(package) fn pipeline_ir_small_variant_facts_candidates(facts: PipelineIrSmallVariantFacts) -> PipelineIrLiveSet {
  match facts { PipelineIrSmallVariantFacts(candidates, unsafe_values, tags, payloads, next_value, sites) -> candidates }
}

pub(package) fn pipeline_ir_small_variant_facts_unsafe(facts: PipelineIrSmallVariantFacts) -> PipelineIrLiveSet {
  match facts { PipelineIrSmallVariantFacts(candidates, unsafe_values, tags, payloads, next_value, sites) -> unsafe_values }
}

pub(package) fn pipeline_ir_small_variant_facts_tags(facts: PipelineIrSmallVariantFacts) -> PipelineIrConstEnv {
  match facts { PipelineIrSmallVariantFacts(candidates, unsafe_values, tags, payloads, next_value, sites) -> tags }
}

pub(package) fn pipeline_ir_small_variant_facts_payloads(facts: PipelineIrSmallVariantFacts) -> PipelineIrConstEnv {
  match facts { PipelineIrSmallVariantFacts(candidates, unsafe_values, tags, payloads, next_value, sites) -> payloads }
}

pub(package) fn pipeline_ir_small_variant_facts_next_value(facts: PipelineIrSmallVariantFacts) -> i64 {
  match facts { PipelineIrSmallVariantFacts(candidates, unsafe_values, tags, payloads, next_value, sites) -> next_value }
}

pub(package) fn pipeline_ir_small_variant_facts_sites(facts: PipelineIrSmallVariantFacts) -> i64 {
  match facts { PipelineIrSmallVariantFacts(candidates, unsafe_values, tags, payloads, next_value, sites) -> sites }
}

pub(package) fn pipeline_ir_small_variant_constructor_eligible(inst: IrInst) -> i64 {
  match inst {
    IrVariantInitI64(dst, tag_hash, payloads, field_mask) -> if field_mask == 0 and ir_value_list_len(payloads) == 1 { 1 } else { 0 }
    _ -> 0
  }
}

pub(package) fn pipeline_ir_small_variant_blocks_have_candidate(blocks: IrBlockList) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> match block {
      IrBlock(id, params, insts, term) -> {
        let mut cur = insts
        let mut found = 0
        let mut walking = 1
        while walking == 1 {
          match cur {
            IrInstNil -> { walking = 0 }
            IrInstCons(inst, tail) -> {
              if pipeline_ir_small_variant_constructor_eligible(inst) == 1 { found = 1 walking = 0 }
              else { cur = tail }
            }
          }
        }
        if found == 1 { 1 } else { pipeline_ir_small_variant_blocks_have_candidate(rest) }
      }
    }
  }
}

pub(package) fn pipeline_ir_small_variant_blocks_have_projection(blocks: IrBlockList) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> match block {
      IrBlock(id, params, insts, term) -> {
        let mut cur = insts
        let mut found = 0
        let mut walking = 1
        while walking == 1 {
          match cur {
            IrInstNil -> { walking = 0 }
            IrInstCons(inst, tail) -> match inst {
              IrVariantTagI64(dst, base) -> { found = 1 walking = 0 }
              IrVariantPayloadI64(dst, base, index) -> if index == 0 { found = 1 walking = 0 } else { cur = tail }
              _ -> { cur = tail }
            }
          }
        }
        if found == 1 { 1 } else { pipeline_ir_small_variant_blocks_have_projection(rest) }
      }
    }
  }
}

pub(package) fn pipeline_ir_small_variant_producer_clone_hash(producers: i64, base_hash: i64) -> i64 {
  let mut clone_hash = 0
  let mut i = 0
  while i < nlist_len(producers) and clone_hash == 0 {
    let entry = nlist_get(producers, i)
    if node_f1(entry) == base_hash { clone_hash = node_f2(entry) } else { i = i + 1 }
  }
  clone_hash
}

pub(package) fn pipeline_ir_small_variant_call_base_hash(inst: IrInst) -> i64 {
  match inst {
    IrCallI64(dst, callee_hash, args) -> callee_hash
    IrGenericCallI64(dst, callee_hash, type_args, args) -> pipeline_ir_function_ref_target_hash(callee_hash, type_args)
    _ -> 0
  }
}

pub(package) fn pipeline_ir_small_variant_add_candidate_insts(insts: IrInstList, producers: i64, candidates: PipelineIrLiveSet) -> PipelineIrLiveSet {
  match insts {
    IrInstNil -> candidates
    IrInstCons(inst, rest) -> {
      let next = match inst {
        IrVariantInitI64(dst, tag_hash, payloads, field_mask) -> {
          if field_mask == 0 and ir_value_list_len(payloads) == 1 { pipeline_ir_live_set_add(candidates, dst) } else { candidates }
        }
        IrManagedStakeI64(dst, value, cleanup_kind, delta, origin) -> {
          if pipeline_ir_live_set_contains(candidates, value) == 1 { pipeline_ir_live_set_add(candidates, dst) } else { candidates }
        }
        IrResumeI64(dst, value) -> {
          if pipeline_ir_live_set_contains(candidates, value) == 1 { pipeline_ir_live_set_add(candidates, dst) } else { candidates }
        }
        IrCallI64(dst, callee_hash, args) -> if pipeline_ir_small_variant_producer_clone_hash(producers, callee_hash) != 0 { pipeline_ir_live_set_add(candidates, dst) } else { candidates }
        IrGenericCallI64(dst, callee_hash, type_args, args) -> {
          if pipeline_ir_small_variant_producer_clone_hash(producers, pipeline_ir_function_ref_target_hash(callee_hash, type_args)) != 0 { pipeline_ir_live_set_add(candidates, dst) } else { candidates }
        }
        _ -> candidates
      }
      pipeline_ir_small_variant_add_candidate_insts(rest, producers, next)
    }
  }
}

pub(package) fn pipeline_ir_small_variant_add_candidate_block_insts(blocks: IrBlockList, producers: i64, candidates: PipelineIrLiveSet) -> PipelineIrLiveSet {
  match blocks {
    IrBlockListNil -> candidates
    IrBlockListCons(block, rest) -> match block {
      IrBlock(id, params, insts, term) -> pipeline_ir_small_variant_add_candidate_block_insts(rest, producers, pipeline_ir_small_variant_add_candidate_insts(insts, producers, candidates))
    }
  }
}

pub(package) fn pipeline_ir_small_variant_insts_never_reach_term(insts: IrInstList) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> match inst {
      IrLoweringFailureI64(reason) -> 1
      _ -> pipeline_ir_small_variant_insts_never_reach_term(rest)
    }
  }
}

-- Positive means at least one incoming jump and all corresponding arguments
-- are candidates. A negative state records a missing/noncandidate argument or
-- a parameterless branch predecessor, so joins fail closed.
pub(package) fn pipeline_ir_small_variant_incoming_state(blocks: IrBlockList, target: i64, lane: i64, candidates: PipelineIrLiveSet, state: i64) -> i64 {
  match blocks {
    IrBlockListNil -> state
    IrBlockListCons(block, rest) -> match block {
      IrBlock(id, params, insts, term) -> {
        let next = if pipeline_ir_small_variant_insts_never_reach_term(insts) == 1 { state } else { match term {
          IrTermJump(jump_target, args) -> {
            if jump_target != target { state }
            else {
              let arg = ir_value_list_nth_or(args, lane, 0 - 1)
              if state < 0 { state - 1 }
              else { if arg >= 0 and pipeline_ir_live_set_contains(candidates, arg) == 1 { state + 1 } else { 0 - state - 1 } }
            }
          }
          IrTermBranch(cond, then_block, else_block) -> {
            if then_block == target or else_block == target {
              if state < 0 { state - 1 } else { 0 - state - 1 }
            } else { state }
          }
          _ -> state
        } }
        pipeline_ir_small_variant_incoming_state(rest, target, lane, candidates, next)
      }
    }
  }
}

pub(package) fn pipeline_ir_small_variant_add_candidate_params(params: IrValueList, lane: i64, target: i64, blocks: IrBlockList, candidates: PipelineIrLiveSet) -> PipelineIrLiveSet {
  match params {
    IrValueNil -> candidates
    IrValueCons(param, rest) -> {
      let incoming = pipeline_ir_small_variant_incoming_state(blocks, target, lane, candidates, 0)
      let next = if incoming > 0 { pipeline_ir_live_set_add(candidates, param) } else { candidates }
      pipeline_ir_small_variant_add_candidate_params(rest, lane + 1, target, blocks, next)
    }
  }
}

pub(package) fn pipeline_ir_small_variant_add_candidate_block_params(blocks: IrBlockList, all_blocks: IrBlockList, candidates: PipelineIrLiveSet) -> PipelineIrLiveSet {
  match blocks {
    IrBlockListNil -> candidates
    IrBlockListCons(block, rest) -> match block {
      IrBlock(id, params, insts, term) -> {
        let next = pipeline_ir_small_variant_add_candidate_params(params, 0, id, all_blocks, candidates)
        pipeline_ir_small_variant_add_candidate_block_params(rest, all_blocks, next)
      }
    }
  }
}

pub(package) fn pipeline_ir_small_variant_candidate_closure(blocks: IrBlockList, producers: i64, next_value: i64) -> PipelineIrLiveSet {
  let mut candidates = pipeline_ir_live_set_dense(next_value + 1)
  let mut changed = 1
  let mut budget = next_value + ir_block_list_len(blocks) + 2
  while changed == 1 and budget > 0 {
    let before = pipeline_ir_live_set_len(candidates)
    candidates = pipeline_ir_small_variant_add_candidate_block_insts(blocks, producers, candidates)
    candidates = pipeline_ir_small_variant_add_candidate_block_params(blocks, blocks, candidates)
    changed = if pipeline_ir_live_set_len(candidates) == before { 0 } else { 1 }
    budget = budget - 1
  }
  candidates
}

pub(package) fn pipeline_ir_small_variant_mark_candidate_uses(uses: PipelineIrLiveSet, candidates: PipelineIrLiveSet, unsafe_values: PipelineIrLiveSet) -> PipelineIrLiveSet {
  match uses {
    PipelineIrLiveSetNil -> unsafe_values
    PipelineIrLiveSetCons(value, rest) -> {
      let next = if pipeline_ir_live_set_contains(candidates, value) == 1 { pipeline_ir_live_set_add(unsafe_values, value) } else { unsafe_values }
      pipeline_ir_small_variant_mark_candidate_uses(rest, candidates, next)
    }
    -- Instruction-use collection starts from the linked empty set, so a dense
    -- set here indicates a producer bug. Mark nothing and let verification keep
    -- the original representation rather than reading scratch as a list.
    PipelineIrLiveSetBits(array, words, count) -> unsafe_values
  }
}

pub(package) fn pipeline_ir_small_variant_mark_opaque_inst(inst: IrInst, candidates: PipelineIrLiveSet, unsafe_values: PipelineIrLiveSet) -> PipelineIrLiveSet {
  match inst {
    -- Binding metadata names an already-materialised SSA home. It emits no
    -- managed action for ordinary variants, so the selected tag lane remains
    -- a valid debug/scope home. Explicit `owned` bindings still fail closed.
    IrBindI64(ns, nl, value, ty) -> {
      if cg_owned_drop_type_hash(ty) == 0 { unsafe_values }
      else { pipeline_ir_small_variant_mark_candidate_uses(pipeline_ir_live_set_add_inst_uses(inst, pipeline_ir_live_set_empty()), candidates, unsafe_values) }
    }
    IrVariantTagI64(dst, base) -> unsafe_values
    IrVariantPayloadI64(dst, base, index) -> {
      if index == 0 { unsafe_values } else { if pipeline_ir_live_set_contains(candidates, base) == 1 { pipeline_ir_live_set_add(unsafe_values, base) } else { unsafe_values } }
    }
    IrManagedStakeI64(dst, value, cleanup_kind, delta, origin) -> {
      if pipeline_ir_live_set_contains(candidates, value) == 1 and pipeline_ir_live_set_contains(candidates, dst) == 1 { unsafe_values }
      else { pipeline_ir_small_variant_mark_candidate_uses(pipeline_ir_live_set_add_inst_uses(inst, pipeline_ir_live_set_empty()), candidates, unsafe_values) }
    }
    IrResumeI64(dst, value) -> {
      if pipeline_ir_live_set_contains(candidates, value) == 1 and pipeline_ir_live_set_contains(candidates, dst) == 1 { unsafe_values }
      else { pipeline_ir_small_variant_mark_candidate_uses(pipeline_ir_live_set_add_inst_uses(inst, pipeline_ir_live_set_empty()), candidates, unsafe_values) }
    }
    _ -> pipeline_ir_small_variant_mark_candidate_uses(pipeline_ir_live_set_add_inst_uses(inst, pipeline_ir_live_set_empty()), candidates, unsafe_values)
  }
}

pub(package) fn pipeline_ir_small_variant_mark_opaque_insts(insts: IrInstList, candidates: PipelineIrLiveSet, unsafe_values: PipelineIrLiveSet) -> PipelineIrLiveSet {
  match insts {
    IrInstNil -> unsafe_values
    IrInstCons(inst, rest) -> pipeline_ir_small_variant_mark_opaque_insts(rest, candidates, pipeline_ir_small_variant_mark_opaque_inst(inst, candidates, unsafe_values))
  }
}

pub(package) fn pipeline_ir_small_variant_mark_jump_opaque(args: IrValueList, params: IrValueList, candidates: PipelineIrLiveSet, unsafe_values: PipelineIrLiveSet) -> PipelineIrLiveSet {
  match args {
    IrValueNil -> unsafe_values
    IrValueCons(arg, arg_rest) -> match params {
      IrValueNil -> pipeline_ir_small_variant_mark_candidate_uses(pipeline_ir_live_set_add_values(pipeline_ir_live_set_empty(), args), candidates, unsafe_values)
      IrValueCons(param, param_rest) -> {
        let arg_candidate = pipeline_ir_live_set_contains(candidates, arg)
        let param_candidate = pipeline_ir_live_set_contains(candidates, param)
        let next = if arg_candidate == 1 and param_candidate != 1 { pipeline_ir_live_set_add(unsafe_values, arg) }
        else { if param_candidate == 1 and arg_candidate != 1 { pipeline_ir_live_set_add(unsafe_values, param) } else { unsafe_values } }
        pipeline_ir_small_variant_mark_jump_opaque(arg_rest, param_rest, candidates, next)
      }
    }
  }
}

pub(package) fn pipeline_ir_small_variant_mark_opaque_term(term: IrTerminator, blocks: IrBlockList, candidates: PipelineIrLiveSet, unsafe_values: PipelineIrLiveSet, allow_return: i64) -> PipelineIrLiveSet {
  match term {
    IrTermNone -> unsafe_values
    IrTermUnreachable -> unsafe_values
    IrTermReturn(value) -> if allow_return == 1 { unsafe_values } else { if pipeline_ir_live_set_contains(candidates, value) == 1 { pipeline_ir_live_set_add(unsafe_values, value) } else { unsafe_values } }
    IrTermBranch(cond, then_block, else_block) -> if pipeline_ir_live_set_contains(candidates, cond) == 1 { pipeline_ir_live_set_add(unsafe_values, cond) } else { unsafe_values }
    IrTermJump(target, args) -> pipeline_ir_small_variant_mark_jump_opaque(args, pipeline_ir_native_block_params_or(blocks, target, ir_value_list_empty()), candidates, unsafe_values)
  }
}

pub(package) fn pipeline_ir_small_variant_initial_unsafe(blocks: IrBlockList, all_blocks: IrBlockList, candidates: PipelineIrLiveSet, unsafe_values: PipelineIrLiveSet, allow_return: i64) -> PipelineIrLiveSet {
  match blocks {
    IrBlockListNil -> unsafe_values
    IrBlockListCons(block, rest) -> match block {
      IrBlock(id, params, insts, term) -> {
        let after_insts = pipeline_ir_small_variant_mark_opaque_insts(insts, candidates, unsafe_values)
        let after_term = if pipeline_ir_small_variant_insts_never_reach_term(insts) == 1 { after_insts }
        else { pipeline_ir_small_variant_mark_opaque_term(term, all_blocks, candidates, after_insts, allow_return) }
        pipeline_ir_small_variant_initial_unsafe(rest, all_blocks, candidates, after_term, allow_return)
      }
    }
  }
}

pub(package) fn pipeline_ir_small_variant_connect_pair(left: i64, right: i64, candidates: PipelineIrLiveSet, unsafe_values: PipelineIrLiveSet) -> PipelineIrLiveSet {
  if pipeline_ir_live_set_contains(candidates, left) != 1 or pipeline_ir_live_set_contains(candidates, right) != 1 { unsafe_values }
  else {
    if pipeline_ir_live_set_contains(unsafe_values, left) == 1 or pipeline_ir_live_set_contains(unsafe_values, right) == 1 {
      pipeline_ir_live_set_add(pipeline_ir_live_set_add(unsafe_values, left), right)
    } else { unsafe_values }
  }
}

pub(package) fn pipeline_ir_small_variant_connect_insts(insts: IrInstList, candidates: PipelineIrLiveSet, unsafe_values: PipelineIrLiveSet) -> PipelineIrLiveSet {
  match insts {
    IrInstNil -> unsafe_values
    IrInstCons(inst, rest) -> {
      let next = match inst {
        IrManagedStakeI64(dst, value, cleanup_kind, delta, origin) -> pipeline_ir_small_variant_connect_pair(dst, value, candidates, unsafe_values)
        IrResumeI64(dst, value) -> pipeline_ir_small_variant_connect_pair(dst, value, candidates, unsafe_values)
        _ -> unsafe_values
      }
      pipeline_ir_small_variant_connect_insts(rest, candidates, next)
    }
  }
}

pub(package) fn pipeline_ir_small_variant_connect_jump(args: IrValueList, params: IrValueList, candidates: PipelineIrLiveSet, unsafe_values: PipelineIrLiveSet) -> PipelineIrLiveSet {
  match args {
    IrValueNil -> unsafe_values
    IrValueCons(arg, arg_rest) -> match params {
      IrValueNil -> unsafe_values
      IrValueCons(param, param_rest) -> pipeline_ir_small_variant_connect_jump(arg_rest, param_rest, candidates, pipeline_ir_small_variant_connect_pair(arg, param, candidates, unsafe_values))
    }
  }
}

pub(package) fn pipeline_ir_small_variant_connect_blocks(blocks: IrBlockList, all_blocks: IrBlockList, candidates: PipelineIrLiveSet, unsafe_values: PipelineIrLiveSet) -> PipelineIrLiveSet {
  match blocks {
    IrBlockListNil -> unsafe_values
    IrBlockListCons(block, rest) -> match block {
      IrBlock(id, params, insts, term) -> {
        let after_insts = pipeline_ir_small_variant_connect_insts(insts, candidates, unsafe_values)
        let after_term = if pipeline_ir_small_variant_insts_never_reach_term(insts) == 1 { after_insts } else { match term {
          IrTermJump(target, args) -> pipeline_ir_small_variant_connect_jump(args, pipeline_ir_native_block_params_or(all_blocks, target, ir_value_list_empty()), candidates, after_insts)
          _ -> after_insts
        } }
        pipeline_ir_small_variant_connect_blocks(rest, all_blocks, candidates, after_term)
      }
    }
  }
}

pub(package) fn pipeline_ir_small_variant_unsafe_closure(blocks: IrBlockList, candidates: PipelineIrLiveSet, next_value: i64, allow_return: i64) -> PipelineIrLiveSet {
  let mut unsafe_values = pipeline_ir_small_variant_initial_unsafe(blocks, blocks, candidates, pipeline_ir_live_set_dense(next_value + 1), allow_return)
  let mut changed = 1
  let mut budget = next_value + ir_block_list_len(blocks) + 2
  while changed == 1 and budget > 0 {
    let before = pipeline_ir_live_set_len(unsafe_values)
    unsafe_values = pipeline_ir_small_variant_connect_blocks(blocks, blocks, candidates, unsafe_values)
    changed = if pipeline_ir_live_set_len(unsafe_values) == before { 0 } else { 1 }
    budget = budget - 1
  }
  unsafe_values
}

pub(package) fn pipeline_ir_small_variant_is_safe(facts: PipelineIrSmallVariantFacts, value: i64) -> i64 {
  if pipeline_ir_live_set_contains(pipeline_ir_small_variant_facts_candidates(facts), value) != 1 { 0 }
  else { if pipeline_ir_live_set_contains(pipeline_ir_small_variant_facts_unsafe(facts), value) == 1 { 0 } else { 1 } }
}

pub(package) fn pipeline_ir_small_variant_bind_map(facts: PipelineIrSmallVariantFacts, value: i64, tag: i64, payload: i64) -> PipelineIrSmallVariantFacts {
  match facts {
    PipelineIrSmallVariantFacts(candidates, unsafe_values, tags, payloads, next_value, sites) -> {
      pipeline_ir_const_env_bind(tags, value, tag)
      pipeline_ir_const_env_bind(payloads, value, payload)
      PipelineIrSmallVariantFacts(candidates, unsafe_values, tags, payloads, next_value, sites)
    }
  }
}

pub(package) fn pipeline_ir_small_variant_bind_primary_inst_maps(insts: IrInstList, producers: i64, facts: PipelineIrSmallVariantFacts) -> PipelineIrSmallVariantFacts {
  match insts {
    IrInstNil -> facts
    IrInstCons(inst, rest) -> {
      let next = match inst {
        IrVariantInitI64(dst, tag_hash, payloads, field_mask) -> {
          if pipeline_ir_small_variant_is_safe(facts, dst) == 1 {
            match facts {
              PipelineIrSmallVariantFacts(candidates, unsafe_values, tags, payload_map, next_value, sites) -> {
                pipeline_ir_const_env_bind(tags, dst, dst)
                pipeline_ir_const_env_bind(payload_map, dst, ir_value_list_nth_or(payloads, 0, 0 - 1))
                PipelineIrSmallVariantFacts(candidates, unsafe_values, tags, payload_map, next_value, sites + 1)
              }
            }
          } else { facts }
        }
        IrCallI64(dst, callee_hash, args) -> {
          if pipeline_ir_small_variant_producer_clone_hash(producers, callee_hash) != 0 and pipeline_ir_small_variant_is_safe(facts, dst) == 1 {
            match facts {
              PipelineIrSmallVariantFacts(candidates, unsafe_values, tags, payloads, next_value, sites) -> {
                pipeline_ir_const_env_bind(tags, dst, dst)
                pipeline_ir_const_env_bind(payloads, dst, next_value)
                PipelineIrSmallVariantFacts(candidates, unsafe_values, tags, payloads, next_value + 1, sites + 1)
              }
            }
          } else { facts }
        }
        IrGenericCallI64(dst, callee_hash, type_args, args) -> {
          let concrete = pipeline_ir_function_ref_target_hash(callee_hash, type_args)
          if pipeline_ir_small_variant_producer_clone_hash(producers, concrete) != 0 and pipeline_ir_small_variant_is_safe(facts, dst) == 1 {
            match facts {
              PipelineIrSmallVariantFacts(candidates, unsafe_values, tags, payloads, next_value, sites) -> {
                pipeline_ir_const_env_bind(tags, dst, dst)
                pipeline_ir_const_env_bind(payloads, dst, next_value)
                PipelineIrSmallVariantFacts(candidates, unsafe_values, tags, payloads, next_value + 1, sites + 1)
              }
            }
          } else { facts }
        }
        _ -> facts
      }
      pipeline_ir_small_variant_bind_primary_inst_maps(rest, producers, next)
    }
  }
}

pub(package) fn pipeline_ir_small_variant_bind_param_maps(params: IrValueList, facts: PipelineIrSmallVariantFacts) -> PipelineIrSmallVariantFacts {
  match params {
    IrValueNil -> facts
    IrValueCons(param, rest) -> {
      let next = if pipeline_ir_small_variant_is_safe(facts, param) == 1 {
        match facts {
          PipelineIrSmallVariantFacts(candidates, unsafe_values, tags, payloads, next_value, sites) -> {
            pipeline_ir_const_env_bind(tags, param, param)
            pipeline_ir_const_env_bind(payloads, param, next_value)
            PipelineIrSmallVariantFacts(candidates, unsafe_values, tags, payloads, next_value + 1, sites)
          }
        }
      } else { facts }
      pipeline_ir_small_variant_bind_param_maps(rest, next)
    }
  }
}

pub(package) fn pipeline_ir_small_variant_bind_primary_maps(blocks: IrBlockList, producers: i64, facts: PipelineIrSmallVariantFacts) -> PipelineIrSmallVariantFacts {
  match blocks {
    IrBlockListNil -> facts
    IrBlockListCons(block, rest) -> match block {
      IrBlock(id, params, insts, term) -> {
        let with_params = pipeline_ir_small_variant_bind_param_maps(params, facts)
        let with_insts = pipeline_ir_small_variant_bind_primary_inst_maps(insts, producers, with_params)
        pipeline_ir_small_variant_bind_primary_maps(rest, producers, with_insts)
      }
    }
  }
}

pub(package) fn pipeline_ir_small_variant_map_lookup(env: PipelineIrConstEnv, value: i64) -> PipelineIrConstLookup {
  pipeline_ir_const_env_lookup(env, value)
}

pub(package) fn pipeline_ir_small_variant_bind_alias_map(facts: PipelineIrSmallVariantFacts, dst: i64, source: i64) -> i64 {
  if pipeline_ir_small_variant_is_safe(facts, dst) != 1 or pipeline_ir_small_variant_is_safe(facts, source) != 1 { 0 }
  else {
    let tags = pipeline_ir_small_variant_facts_tags(facts)
    let payloads = pipeline_ir_small_variant_facts_payloads(facts)
    let existing = pipeline_ir_small_variant_map_lookup(tags, dst)
    let source_tag = pipeline_ir_small_variant_map_lookup(tags, source)
    let source_payload = pipeline_ir_small_variant_map_lookup(payloads, source)
    if pipeline_ir_const_lookup_valid(existing) == 1 or pipeline_ir_const_lookup_valid(source_tag) != 1 or pipeline_ir_const_lookup_valid(source_payload) != 1 { 0 }
    else {
      pipeline_ir_const_env_bind(tags, dst, pipeline_ir_const_lookup_value(source_tag))
      pipeline_ir_const_env_bind(payloads, dst, pipeline_ir_const_lookup_value(source_payload))
      1
    }
  }
}

pub(package) fn pipeline_ir_small_variant_bind_alias_insts(insts: IrInstList, facts: PipelineIrSmallVariantFacts) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let added = match inst {
        IrManagedStakeI64(dst, value, cleanup_kind, delta, origin) -> pipeline_ir_small_variant_bind_alias_map(facts, dst, value)
        IrResumeI64(dst, value) -> pipeline_ir_small_variant_bind_alias_map(facts, dst, value)
        _ -> 0
      }
      added + pipeline_ir_small_variant_bind_alias_insts(rest, facts)
    }
  }
}

pub(package) fn pipeline_ir_small_variant_bind_alias_blocks(blocks: IrBlockList, facts: PipelineIrSmallVariantFacts) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> match block {
      IrBlock(id, params, insts, term) -> pipeline_ir_small_variant_bind_alias_insts(insts, facts) + pipeline_ir_small_variant_bind_alias_blocks(rest, facts)
    }
  }
}

pub(package) fn pipeline_ir_small_variant_close_alias_maps(blocks: IrBlockList, facts: PipelineIrSmallVariantFacts) -> PipelineIrSmallVariantFacts {
  let mut changed = 1
  let mut budget = pipeline_ir_small_variant_facts_next_value(facts) + 1
  while changed > 0 and budget > 0 {
    changed = pipeline_ir_small_variant_bind_alias_blocks(blocks, facts)
    budget = budget - 1
  }
  facts
}

pub(package) fn pipeline_ir_small_variant_analyse(blocks: IrBlockList, first_next_value: i64, producers: i64, allow_return: i64) -> PipelineIrSmallVariantFacts {
  let candidates = pipeline_ir_small_variant_candidate_closure(blocks, producers, first_next_value)
  let unsafe_values = pipeline_ir_small_variant_unsafe_closure(blocks, candidates, first_next_value, allow_return)
  let empty = PipelineIrSmallVariantFacts(candidates, unsafe_values, pipeline_ir_const_env_empty(), pipeline_ir_const_env_empty(), first_next_value, 0)
  pipeline_ir_small_variant_close_alias_maps(blocks, pipeline_ir_small_variant_bind_primary_maps(blocks, producers, empty))
}

pub(package) fn pipeline_ir_small_variant_tag_lookup(facts: PipelineIrSmallVariantFacts, value: i64) -> PipelineIrConstLookup {
  pipeline_ir_small_variant_map_lookup(pipeline_ir_small_variant_facts_tags(facts), value)
}

pub(package) fn pipeline_ir_small_variant_payload_lookup(facts: PipelineIrSmallVariantFacts, value: i64) -> PipelineIrConstLookup {
  pipeline_ir_small_variant_map_lookup(pipeline_ir_small_variant_facts_payloads(facts), value)
}

pub(package) fn pipeline_ir_small_variant_aliases_insts(insts: IrInstList, facts: PipelineIrSmallVariantFacts, aliases: PipelineIrAliasEnv) -> PipelineIrAliasEnv {
  match insts {
    IrInstNil -> aliases
    IrInstCons(inst, rest) -> {
      let next = match inst {
        IrVariantTagI64(dst, base) -> {
          let found = pipeline_ir_small_variant_tag_lookup(facts, base)
          if pipeline_ir_small_variant_is_safe(facts, base) == 1 and pipeline_ir_const_lookup_valid(found) == 1 {
            pipeline_ir_alias_env_bind(aliases, dst, pipeline_ir_const_lookup_value(found))
          } else { aliases }
        }
        IrVariantPayloadI64(dst, base, index) -> {
          let found = pipeline_ir_small_variant_payload_lookup(facts, base)
          if index == 0 and pipeline_ir_small_variant_is_safe(facts, base) == 1 and pipeline_ir_const_lookup_valid(found) == 1 {
            pipeline_ir_alias_env_bind(aliases, dst, pipeline_ir_const_lookup_value(found))
          } else { aliases }
        }
        _ -> aliases
      }
      pipeline_ir_small_variant_aliases_insts(rest, facts, next)
    }
  }
}

pub(package) fn pipeline_ir_small_variant_aliases_blocks(blocks: IrBlockList, facts: PipelineIrSmallVariantFacts, aliases: PipelineIrAliasEnv) -> PipelineIrAliasEnv {
  match blocks {
    IrBlockListNil -> aliases
    IrBlockListCons(block, rest) -> match block {
      IrBlock(id, params, insts, term) -> pipeline_ir_small_variant_aliases_blocks(rest, facts, pipeline_ir_small_variant_aliases_insts(insts, facts, aliases))
    }
  }
}

pub(package) fn pipeline_ir_small_variant_map_value_or(found: PipelineIrConstLookup, aliases: PipelineIrAliasEnv, default: i64) -> i64 {
  if pipeline_ir_const_lookup_valid(found) == 1 { pipeline_ir_alias_env_lookup_or(aliases, pipeline_ir_const_lookup_value(found)) } else { default }
}

pub(package) fn pipeline_ir_small_variant_used_add(used: i64, clone_hash: i64) -> i64 {
  if clone_hash != 0 and pipeline_hash_nlist_contains(used, clone_hash) != 1 { nlist_add(used, clone_hash) } else { 0 }
  clone_hash
}

pub(package) fn pipeline_ir_small_variant_rewrite_insts(insts: IrInstList, facts: PipelineIrSmallVariantFacts, aliases: PipelineIrAliasEnv, producers: i64, used: i64) -> IrInstList {
  match insts {
    IrInstNil -> ir_inst_list_empty()
    IrInstCons(inst, rest) -> {
      let tail = pipeline_ir_small_variant_rewrite_insts(rest, facts, aliases, producers, used)
      match inst {
        IrVariantInitI64(dst, tag_hash, payloads, field_mask) -> {
          if pipeline_ir_small_variant_is_safe(facts, dst) == 1 { ir_inst_list_prepend(IrConstI64(dst, tag_hash), tail) }
          else { ir_inst_list_prepend(pipeline_ir_rewrite_inst_uses(inst, aliases), tail) }
        }
        IrVariantTagI64(dst, base) -> {
          if pipeline_ir_small_variant_is_safe(facts, base) == 1 { tail }
          else { ir_inst_list_prepend(pipeline_ir_rewrite_inst_uses(inst, aliases), tail) }
        }
        IrVariantPayloadI64(dst, base, index) -> {
          if index == 0 and pipeline_ir_small_variant_is_safe(facts, base) == 1 { tail }
          else { ir_inst_list_prepend(pipeline_ir_rewrite_inst_uses(inst, aliases), tail) }
        }
        IrManagedStakeI64(dst, value, cleanup_kind, delta, origin) -> {
          if pipeline_ir_small_variant_is_safe(facts, value) == 1 and pipeline_ir_small_variant_is_safe(facts, dst) == 1 { tail }
          else { ir_inst_list_prepend(pipeline_ir_rewrite_inst_uses(inst, aliases), tail) }
        }
        IrResumeI64(dst, value) -> {
          if pipeline_ir_small_variant_is_safe(facts, value) == 1 and pipeline_ir_small_variant_is_safe(facts, dst) == 1 { tail }
          else { ir_inst_list_prepend(pipeline_ir_rewrite_inst_uses(inst, aliases), tail) }
        }
        IrCallI64(dst, callee_hash, args) -> {
          let clone_hash = pipeline_ir_small_variant_producer_clone_hash(producers, callee_hash)
          let payload = pipeline_ir_small_variant_payload_lookup(facts, dst)
          if clone_hash != 0 and pipeline_ir_small_variant_is_safe(facts, dst) == 1 and pipeline_ir_const_lookup_valid(payload) == 1 {
            pipeline_ir_small_variant_used_add(used, clone_hash)
            ir_inst_list_prepend(
              IrCallI64(dst, clone_hash, pipeline_ir_rewrite_value_list(args, aliases)),
              ir_inst_list_prepend(ir_inst_call_result_lane_for_head_i64(pipeline_ir_const_lookup_value(payload), 1, dst), tail)
            )
          } else { ir_inst_list_prepend(pipeline_ir_rewrite_inst_uses(inst, aliases), tail) }
        }
        IrGenericCallI64(dst, callee_hash, type_args, args) -> {
          let concrete = pipeline_ir_function_ref_target_hash(callee_hash, type_args)
          let clone_hash = pipeline_ir_small_variant_producer_clone_hash(producers, concrete)
          let payload = pipeline_ir_small_variant_payload_lookup(facts, dst)
          if clone_hash != 0 and pipeline_ir_small_variant_is_safe(facts, dst) == 1 and pipeline_ir_const_lookup_valid(payload) == 1 {
            pipeline_ir_small_variant_used_add(used, clone_hash)
            ir_inst_list_prepend(
              IrCallI64(dst, clone_hash, pipeline_ir_rewrite_value_list(args, aliases)),
              ir_inst_list_prepend(ir_inst_call_result_lane_for_head_i64(pipeline_ir_const_lookup_value(payload), 1, dst), tail)
            )
          } else { ir_inst_list_prepend(pipeline_ir_rewrite_inst_uses(inst, aliases), tail) }
        }
        _ -> ir_inst_list_prepend(pipeline_ir_rewrite_inst_uses(inst, aliases), tail)
      }
    }
  }
}

pub(package) fn pipeline_ir_small_variant_rewrite_params_extra(params: IrValueList, facts: PipelineIrSmallVariantFacts, aliases: PipelineIrAliasEnv) -> IrValueList {
  match params {
    IrValueNil -> ir_value_list_empty()
    IrValueCons(param, rest) -> {
      let tail = pipeline_ir_small_variant_rewrite_params_extra(rest, facts, aliases)
      if pipeline_ir_small_variant_is_safe(facts, param) == 1 {
        let found = pipeline_ir_small_variant_payload_lookup(facts, param)
        if pipeline_ir_const_lookup_valid(found) == 1 { ir_value_list_prepend(pipeline_ir_const_lookup_value(found), tail) } else { tail }
      } else { tail }
    }
  }
}

pub(package) fn pipeline_ir_small_variant_rewrite_jump_base(args: IrValueList, params: IrValueList, facts: PipelineIrSmallVariantFacts, aliases: PipelineIrAliasEnv) -> IrValueList {
  match args {
    IrValueNil -> ir_value_list_empty()
    IrValueCons(arg, arg_rest) -> match params {
      IrValueNil -> pipeline_ir_rewrite_value_list(args, aliases)
      IrValueCons(param, param_rest) -> {
        let tail = pipeline_ir_small_variant_rewrite_jump_base(arg_rest, param_rest, facts, aliases)
        if pipeline_ir_small_variant_is_safe(facts, param) == 1 {
          let found = pipeline_ir_small_variant_tag_lookup(facts, arg)
          ir_value_list_prepend(pipeline_ir_small_variant_map_value_or(found, aliases, pipeline_ir_alias_env_lookup_or(aliases, arg)), tail)
        } else { ir_value_list_prepend(pipeline_ir_alias_env_lookup_or(aliases, arg), tail) }
      }
    }
  }
}

pub(package) fn pipeline_ir_small_variant_rewrite_jump_extra(args: IrValueList, params: IrValueList, facts: PipelineIrSmallVariantFacts, aliases: PipelineIrAliasEnv) -> IrValueList {
  match args {
    IrValueNil -> ir_value_list_empty()
    IrValueCons(arg, arg_rest) -> match params {
      IrValueNil -> ir_value_list_empty()
      IrValueCons(param, param_rest) -> {
        let tail = pipeline_ir_small_variant_rewrite_jump_extra(arg_rest, param_rest, facts, aliases)
        if pipeline_ir_small_variant_is_safe(facts, param) == 1 {
          let found = pipeline_ir_small_variant_payload_lookup(facts, arg)
          if pipeline_ir_const_lookup_valid(found) == 1 { ir_value_list_prepend(pipeline_ir_alias_env_lookup_or(aliases, pipeline_ir_const_lookup_value(found)), tail) }
          else { ir_value_list_prepend(pipeline_ir_alias_env_lookup_or(aliases, arg), tail) }
        } else { tail }
      }
    }
  }
}

pub(package) fn pipeline_ir_small_variant_rewrite_term(term: IrTerminator, all_blocks: IrBlockList, facts: PipelineIrSmallVariantFacts, aliases: PipelineIrAliasEnv, return_mode: i64) -> IrTerminator {
  match term {
    IrTermJump(target, args) -> {
      let params = pipeline_ir_native_block_params_or(all_blocks, target, ir_value_list_empty())
      IrTermJump(target, ir_value_list_append(
        pipeline_ir_small_variant_rewrite_jump_base(args, params, facts, aliases),
        pipeline_ir_small_variant_rewrite_jump_extra(args, params, facts, aliases)
      ))
    }
    IrTermReturn(value) -> {
      if return_mode == 1 and pipeline_ir_small_variant_is_safe(facts, value) == 1 {
        let tag = pipeline_ir_small_variant_tag_lookup(facts, value)
        IrTermReturn(pipeline_ir_small_variant_map_value_or(tag, aliases, pipeline_ir_alias_env_lookup_or(aliases, value)))
      } else { pipeline_ir_rewrite_term(term, aliases) }
    }
    _ -> pipeline_ir_rewrite_term(term, aliases)
  }
}

pub(package) fn pipeline_ir_small_variant_rewrite_blocks(blocks: IrBlockList, all_blocks: IrBlockList, facts: PipelineIrSmallVariantFacts, aliases: PipelineIrAliasEnv, producers: i64, used: i64, return_mode: i64) -> IrBlockList {
  match blocks {
    IrBlockListNil -> ir_block_list_empty()
    IrBlockListCons(block, rest) -> match block {
      IrBlock(id, params, insts, term) -> {
        let new_params = ir_value_list_append(params, pipeline_ir_small_variant_rewrite_params_extra(params, facts, aliases))
        let base_insts = pipeline_ir_small_variant_rewrite_insts(insts, facts, aliases, producers, used)
        let new_insts = match term {
          IrTermReturn(value) -> {
            if return_mode == 1 and pipeline_ir_small_variant_is_safe(facts, value) == 1 {
              let payload = pipeline_ir_small_variant_payload_lookup(facts, value)
              if pipeline_ir_const_lookup_valid(payload) == 1 {
                ir_inst_list_append(base_insts, ir_inst_list_prepend(IrReturnLaneI64(1, pipeline_ir_alias_env_lookup_or(aliases, pipeline_ir_const_lookup_value(payload))), ir_inst_list_empty()))
              } else { base_insts }
            } else { base_insts }
          }
          _ -> base_insts
        }
        ir_block_list_prepend(
          IrBlock(id, new_params, new_insts, pipeline_ir_small_variant_rewrite_term(term, all_blocks, facts, aliases, return_mode)),
          pipeline_ir_small_variant_rewrite_blocks(rest, all_blocks, facts, aliases, producers, used, return_mode)
        )
      }
    }
  }
}

pub(package) fn pipeline_ir_small_variant_blocks_have_producer_call(blocks: IrBlockList, producers: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> match block {
      IrBlock(id, params, insts, term) -> {
        let mut cur = insts
        let mut found = 0
        let mut walking = 1
        while walking == 1 {
          match cur {
            IrInstNil -> { walking = 0 }
            IrInstCons(inst, tail) -> {
              let base_hash = pipeline_ir_small_variant_call_base_hash(inst)
              if base_hash != 0 and pipeline_ir_small_variant_producer_clone_hash(producers, base_hash) != 0 { found = 1 walking = 0 }
              else { cur = tail }
            }
          }
        }
        if found == 1 { 1 } else { pipeline_ir_small_variant_blocks_have_producer_call(rest, producers) }
      }
    }
  }
}

pub(package) fn pipeline_ir_small_variant_returns_all_safe(blocks: IrBlockList, facts: PipelineIrSmallVariantFacts, returns: i64) -> i64 {
  match blocks {
    IrBlockListNil -> if returns > 0 { returns } else { 0 }
    IrBlockListCons(block, rest) -> match block {
      IrBlock(id, params, insts, term) -> match term {
        IrTermReturn(value) -> {
          if pipeline_ir_small_variant_is_safe(facts, value) != 1 { 0 }
          else { pipeline_ir_small_variant_returns_all_safe(rest, facts, returns + 1) }
        }
        _ -> pipeline_ir_small_variant_returns_all_safe(rest, facts, returns)
      }
    }
  }
}

pub(package) fn pipeline_ir_small_variant_producer_eligible(function: IrFunction, semantic_facts: PipelineIrSemanticFactList) -> i64 {
  match function {
    IrFunction(hash, param_count, blocks, src) -> {
      let semantic = pipeline_ir_semantic_fact_find(semantic_facts, hash)
      if semantic == 0 or cg_semantic_fact_managed_return(semantic) != 1 or cg_semantic_fact_fresh_managed_return(semantic) != 1 or pipeline_ir_small_variant_blocks_have_candidate(blocks) != 1 { 0 }
      else {
        let first_next_value = pipeline_ir_function_next_value(param_count, blocks)
        let layout_facts = pipeline_ir_small_variant_analyse(blocks, first_next_value, nlist_new(), 1)
        if pipeline_ir_small_variant_facts_sites(layout_facts) > 0 and pipeline_ir_small_variant_returns_all_safe(blocks, layout_facts, 0) > 0 { 1 } else { 0 }
      }
    }
  }
}

pub(package) fn pipeline_ir_small_variant_producer_hash(base_hash: i64) -> i64 {
  let hash = base_hash * 1000003 + 104395303
  if hash == 0 { 104395303 } else { hash }
}

pub(package) fn pipeline_ir_small_variant_producer_hash_exists(producers: i64, target: i64) -> i64 {
  let mut found = 0
  let mut i = 0
  while i < nlist_len(producers) and found == 0 {
    if node_f2(nlist_get(producers, i)) == target { found = 1 } else { i = i + 1 }
  }
  found
}

pub(package) fn pipeline_ir_small_variant_producer_add(producers: i64, functions: IrFunctionList, base_hash: i64) -> i64 {
  if pipeline_ir_small_variant_producer_clone_hash(producers, base_hash) != 0 { 0 }
  else {
    let mut clone_hash = pipeline_ir_small_variant_producer_hash(base_hash)
    while pipeline_ir_identity_function_hash_exists(functions, clone_hash) == 1 or pipeline_ir_small_variant_producer_hash_exists(producers, clone_hash) == 1 {
      clone_hash = clone_hash + 104729
      if clone_hash == 0 { clone_hash = 104395303 } else { 0 }
    }
    nlist_add(producers, node_new(0, base_hash, clone_hash, 0, 0))
    1
  }
}

pub(package) fn pipeline_ir_small_variant_producers_discover(functions: IrFunctionList, all_functions: IrFunctionList, semantic_facts: PipelineIrSemanticFactList, producers: i64) -> i64 {
  match functions {
    IrFunctionNil -> 0
    IrFunctionCons(function, rest) -> {
      let added = if pipeline_ir_small_variant_producer_eligible(function, semantic_facts) == 1 {
        pipeline_ir_small_variant_producer_add(producers, all_functions, pipeline_ir_function_hash(function))
      } else { 0 }
      added + pipeline_ir_small_variant_producers_discover(rest, all_functions, semantic_facts, producers)
    }
  }
}

pub(package) fn pipeline_ir_small_variant_scalarise_function_with(function: IrFunction, output_hash: i64, semantic_facts: PipelineIrSemanticFactList, producers: i64, used: i64, return_mode: i64) -> IrFunction {
  match function {
    IrFunction(hash, param_count, blocks, src) -> {
      -- Every profitable canonical lifetime must eventually expose the tag or
      -- payload. Functions without either projection cannot consume the
      -- scalar representation, so reject them before constructor/call scans.
      -- Producer clones are the exception: their return itself is the split.
      if return_mode != 1 and pipeline_ir_small_variant_blocks_have_projection(blocks) != 1 { function }
      else {
        let local_candidate = pipeline_ir_small_variant_blocks_have_candidate(blocks)
        if local_candidate != 1 and pipeline_ir_small_variant_blocks_have_producer_call(blocks, producers) != 1 {
          if output_hash == hash { function } else { IrFunction(output_hash, param_count, blocks, src) }
        }
        else {
          let first_next_value = pipeline_ir_function_next_value(param_count, blocks)
          let layout_facts = pipeline_ir_small_variant_analyse(blocks, first_next_value, producers, return_mode)
          if pipeline_ir_small_variant_facts_sites(layout_facts) == 0 {
            if output_hash == hash { function } else { IrFunction(output_hash, param_count, blocks, src) }
          }
          else {
            let aliases = pipeline_ir_small_variant_aliases_blocks(blocks, layout_facts, pipeline_ir_alias_env_empty())
            let rewritten = pipeline_ir_small_variant_rewrite_blocks(blocks, blocks, layout_facts, aliases, producers, used, return_mode)
            let next_value = pipeline_ir_small_variant_facts_next_value(layout_facts)
            let live = pipeline_ir_function_live_fixpoint(rewritten, pipeline_ir_live_set_dense(next_value + 1), semantic_facts)
            let trimmed = pipeline_ir_trim_block_param_list(rewritten, rewritten, live)
            let dce = pipeline_dce_sweep_ir_block_list(trimmed, live, semantic_facts)
            IrFunction(output_hash, param_count, pipeline_optimised_blocks_blocks(dce), src)
          }
        }
      }
    }
  }
}

pub(package) fn pipeline_ir_small_variant_scalarise_functions_with(functions: IrFunctionList, semantic_facts: PipelineIrSemanticFactList, producers: i64, used: i64) -> IrFunctionList {
  match functions {
    IrFunctionNil -> IrFunctionNil
    IrFunctionCons(function, rest) -> IrFunctionCons(
      pipeline_ir_small_variant_scalarise_function_with(function, pipeline_ir_function_hash(function), semantic_facts, producers, used, 0),
      pipeline_ir_small_variant_scalarise_functions_with(rest, semantic_facts, producers, used)
    )
    _ -> functions
  }
}

pub(package) fn pipeline_ir_small_variant_clone_functions(producers: i64, index: i64, used: i64, functions: IrFunctionList, semantic_facts: PipelineIrSemanticFactList) -> IrFunctionList {
  if index >= nlist_len(producers) { ir_function_list_empty() }
  else {
    let entry = nlist_get(producers, index)
    let base_hash = node_f1(entry)
    let clone_hash = node_f2(entry)
    let tail = pipeline_ir_small_variant_clone_functions(producers, index + 1, used, functions, semantic_facts)
    if pipeline_hash_nlist_contains(used, clone_hash) != 1 { tail }
    else {
      match pipeline_ir_function_list_find_hash(functions, base_hash) {
        IrFunctionNil -> tail
        IrFunctionCons(base, rest) -> ir_function_list_prepend(
          pipeline_ir_small_variant_scalarise_function_with(base, clone_hash, semantic_facts, nlist_new(), nlist_new(), 1),
          tail
        )
      }
    }
  }
}

pub(package) fn pipeline_ir_small_variant_clone_fact(base_fact: i64) -> i64 {
  if base_fact == 0 { 0 }
  else {
    let fact = alloc_words(cg_semantic_fact_size() / 8)
    mem_copy(fact, base_fact, cg_semantic_fact_size())
    mem_store64_at(fact + 48, 0, 0)
    mem_store64_at(fact + 64, 0, 0)
    mem_store64_at(fact + 80, 0, ir_value_shape_gpr_words(2))
    mem_store64_at(fact + 104, 0, 0)
    mem_store64_at(fact + 112, 0, 0)
    mem_store64_at(fact + 120, 0, 0)
    fact
  }
}

pub(package) fn pipeline_ir_small_variant_clone_facts_extend(producers: i64, index: i64, used: i64, base_facts: PipelineIrSemanticFactList, facts: PipelineIrSemanticFactList) -> PipelineIrSemanticFactList {
  if index >= nlist_len(producers) { facts }
  else {
    let entry = nlist_get(producers, index)
    let base_hash = node_f1(entry)
    let clone_hash = node_f2(entry)
    let next = if pipeline_hash_nlist_contains(used, clone_hash) != 1 { facts }
    else {
      let fact = pipeline_ir_small_variant_clone_fact(pipeline_ir_semantic_fact_find(base_facts, base_hash))
      if fact == 0 { facts } else { pipeline_ir_semantic_facts_prepend_with_borrow(clone_hash, fact, ir_borrow_facts_empty(), facts) }
    }
    pipeline_ir_small_variant_clone_facts_extend(producers, index + 1, used, base_facts, next)
  }
}

pub(package) fn pipeline_ir_small_variant_specialisations_functions(result: PipelineIrSmallVariantSpecialisations) -> IrFunctionList {
  match result { PipelineIrSmallVariantSpecialisations(functions, facts, count) -> functions }
}

pub(package) fn pipeline_ir_small_variant_specialisations_facts(result: PipelineIrSmallVariantSpecialisations) -> PipelineIrSemanticFactList {
  match result { PipelineIrSmallVariantSpecialisations(functions, facts, count) -> facts }
}

pub(package) fn pipeline_ir_small_variant_specialisations_count(result: PipelineIrSmallVariantSpecialisations) -> i64 {
  match result { PipelineIrSmallVariantSpecialisations(functions, facts, count) -> count }
}

pub(package) fn pipeline_ir_small_variant_specialisation_within_budget(function_count: i64) -> i64 {
  -- This implementation discovers producers with a global scan and then
  -- probes every consumer against that set.  That is profitable for ordinary
  -- modules, but not for self-hosting-scale modules where only a handful of
  -- the discovered producers are consumed.  Keep the optimization bounded
  -- until the wider scalar replacement work replaces discovery with a demand-driven index.
  if function_count >= 0 and function_count <= 1024 { 1 } else { 0 }
}

pub(package) fn pipeline_ir_small_variant_specialise(functions: IrFunctionList, semantic_facts: PipelineIrSemanticFactList) -> PipelineIrSmallVariantSpecialisations {
  if pipeline_ir_small_variant_specialisation_within_budget(ir_function_list_len(functions)) != 1 {
    PipelineIrSmallVariantSpecialisations(functions, semantic_facts, 0)
  }
  else {
    let producers = nlist_new()
    pipeline_ir_small_variant_producers_discover(functions, functions, semantic_facts, producers)
    if nlist_len(producers) == 0 { PipelineIrSmallVariantSpecialisations(functions, semantic_facts, 0) }
    else {
      let used = nlist_new()
      let rewritten = pipeline_ir_small_variant_scalarise_functions_with(functions, semantic_facts, producers, used)
      let clones = pipeline_ir_small_variant_clone_functions(producers, 0, used, functions, semantic_facts)
      let facts = pipeline_ir_small_variant_clone_facts_extend(producers, 0, used, semantic_facts, semantic_facts)
      PipelineIrSmallVariantSpecialisations(pipeline_ir_function_list_append(rewritten, clones), facts, ir_function_list_len(clones))
    }
  }
}

-- Drop-guided, frame-limited reuse --------------------------------
--
-- Run only after precise RC insertion and the ordinary typed-IR optimiser.
-- Facts map SSA allocations in the current block to exact compact constructor
-- shapes. A release may become a token producer only when an equal-shape
-- constructor follows through bookkeeping-only instructions; therefore no
-- effect/abort edge can strand the token. The token is an SSA result consumed
-- once by IrReuseInitI64 and never crosses a block, call, closure, or frame.

pub(package) fn pipeline_ir_reuse_drop_hash() -> i64 {
  pipeline_ir_native_hash_name("rc_default_drop_reuse")
}

pub(package) fn pipeline_ir_reuse_shape_for_inst(inst: IrInst) -> i64 {
  match inst {
    IrVariantInitI64(dst, tag_hash, payloads, field_mask) -> node_new(0, dst, 1, tag_hash, ir_value_list_len(payloads))
    IrRecordInitI64(dst, type_hash, fields) -> node_new(0, dst, 2, type_hash, ir_record_field_list_len(fields))
    IrReuseInitI64(token, constructor) -> pipeline_ir_reuse_shape_for_inst(constructor)
    _ -> 0
  }
}

pub(package) fn pipeline_ir_reuse_shape_add(facts: i64, inst: IrInst) -> i64 {
  let shape = pipeline_ir_reuse_shape_for_inst(inst)
  if shape == 0 { 0 } else { nlist_add(facts, shape) 1 }
}

pub(package) fn pipeline_ir_reuse_shape_find(facts: i64, value: i64) -> i64 {
  let mut found = 0
  let mut i = nlist_len(facts) - 1
  while i >= 0 and found == 0 {
    let shape = nlist_get(facts, i)
    if node_f1(shape) == value { found = shape } else { i = i - 1 }
  }
  found
}

pub(package) fn pipeline_ir_reuse_constructor_matches(inst: IrInst, shape: i64) -> i64 {
  if shape == 0 { 0 }
  else {
    match inst {
      IrVariantInitI64(dst, tag_hash, payloads, field_mask) -> {
        if node_f2(shape) == 1 and node_f3(shape) == tag_hash and node_f4(shape) == ir_value_list_len(payloads) { 1 } else { 0 }
      }
      IrRecordInitI64(dst, type_hash, fields) -> {
        if node_f2(shape) == 2 and node_f3(shape) == type_hash and node_f4(shape) == ir_record_field_list_len(fields) { 1 } else { 0 }
      }
      _ -> 0
    }
  }
}

pub(package) fn pipeline_ir_reuse_prefix_is_non_aborting(inst: IrInst) -> i64 {
  match inst {
    IrConstI64(dst, value) -> 1
    IrNilI64(dst) -> 1
    IrBindI64(ns, nl, value, ty) -> 1
    IrFunctionRefI64(dst, callee_hash) -> 1
    IrGenericFunctionRefI64(dst, callee_hash, type_args) -> 1
    _ -> 0
  }
}

pub(package) fn pipeline_ir_reuse_has_target(insts: IrInstList, shape: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      if pipeline_ir_reuse_constructor_matches(inst, shape) == 1 { 1 }
      else { if pipeline_ir_reuse_prefix_is_non_aborting(inst) == 1 { pipeline_ir_reuse_has_target(rest, shape) } else { 0 } }
    }
  }
}

pub(package) fn pipeline_ir_reuse_wrap_target(insts: IrInstList, token: i64, shape: i64) -> IrInstList {
  match insts {
    IrInstNil -> IrInstNil
    IrInstCons(inst, rest) -> {
      if pipeline_ir_reuse_constructor_matches(inst, shape) == 1 {
        IrInstCons(IrReuseInitI64(token, inst), rest)
      } else {
        IrInstCons(inst, pipeline_ir_reuse_wrap_target(rest, token, shape))
      }
    }
  }
}

pub(package) fn pipeline_ir_reuse_inst_list_add_uses(insts: IrInstList, live: PipelineIrLiveSet) -> PipelineIrLiveSet {
  match insts {
    IrInstNil -> live
    IrInstCons(inst, rest) -> pipeline_ir_reuse_inst_list_add_uses(rest, pipeline_ir_live_set_add_inst_uses(inst, live))
  }
}

pub(package) fn pipeline_ir_reuse_term_add_uses(term: IrTerminator, live: PipelineIrLiveSet) -> PipelineIrLiveSet {
  match term {
    IrTermNone -> live
    IrTermUnreachable -> live
    IrTermReturn(value) -> pipeline_ir_live_set_add(live, value)
    IrTermJump(target, args) -> pipeline_ir_live_set_add_values(live, args)
    IrTermBranch(cond, then_block, else_block) -> pipeline_ir_live_set_add(live, cond)
  }
}

pub(package) fn pipeline_ir_reuse_release_result_unused(rest: IrInstList, term: IrTerminator, value: i64) -> i64 {
  let live = pipeline_ir_reuse_term_add_uses(term, pipeline_ir_reuse_inst_list_add_uses(rest, pipeline_ir_live_set_empty()))
  if pipeline_ir_live_set_contains(live, value) == 1 { 0 } else { 1 }
}

pub(package) fn pipeline_ir_reuse_handler_clauses(clauses: IrHandlerClauseBodyList) -> IrHandlerClauseBodyList {
  match clauses {
    IrHandlerClauseBodyNil -> IrHandlerClauseBodyNil
    IrHandlerClauseBodyCons(body, rest) -> {
      let next = match body {
        IrHandlerClauseBody(op_hash, nparams, captures, has_continuation, is_abortive, result_cleanup_kind, transferred_param_value_fact, resume_lanes, result_lanes, first_value, blocks) -> {
          IrHandlerClauseBody(op_hash, nparams, captures, has_continuation, is_abortive, result_cleanup_kind, transferred_param_value_fact, resume_lanes, result_lanes, first_value, pipeline_ir_reuse_blocks(blocks))
        }
        IrHandlerClauseBodyInvalid(reason) -> body
      }
      IrHandlerClauseBodyCons(next, pipeline_ir_reuse_handler_clauses(rest))
    }
  }
}

pub(package) fn pipeline_ir_reuse_deferred_body(body: IrDeferredHandlerBody) -> IrDeferredHandlerBody {
  match body {
    IrDeferredHandlerBody(body_src, captures, ops_value, result_lanes, first_value, blocks, completion) -> {
      let rewritten_completion = match completion {
        IrDeferredCompletionBodyNone -> completion
        IrDeferredCompletionBody(input_lanes, output_lanes, completion_first_value, completion_blocks) -> IrDeferredCompletionBody(input_lanes, output_lanes, completion_first_value, pipeline_ir_reuse_blocks(completion_blocks))
        IrDeferredCompletionBodyInvalid(reason) -> completion
      }
      IrDeferredHandlerBody(body_src, captures, ops_value, result_lanes, first_value, pipeline_ir_reuse_blocks(blocks), rewritten_completion)
    }
    IrDeferredHandlerBodyInvalid(reason) -> body
  }
}

pub(package) fn pipeline_ir_reuse_nested_inst(inst: IrInst) -> IrInst {
  match inst {
    IrHandleI64(dst, handle_src, effect_hash, clauses, nclauses, reserved) -> IrHandleI64(dst, handle_src, effect_hash, pipeline_ir_reuse_handler_clauses(clauses), nclauses, reserved)
    IrDeferredHandleI64(dst, handle_src, body, clauses, nclauses, effect_hash, scratch_base) -> IrDeferredHandleI64(dst, handle_src, pipeline_ir_reuse_deferred_body(body), pipeline_ir_reuse_handler_clauses(clauses), nclauses, effect_hash, scratch_base)
    _ -> inst
  }
}

pub(package) fn pipeline_ir_reuse_insts(insts: IrInstList, term: IrTerminator, facts: i64) -> IrInstList {
  match insts {
    IrInstNil -> IrInstNil
    IrInstCons(raw_inst, rest) -> {
      let inst = pipeline_ir_reuse_nested_inst(raw_inst)
      match inst {
        IrManagedStakeI64(dst, source, cleanup_kind, delta, origin) -> {
          let shape = if cleanup_kind == continuation_cleanup_kind_rc() and delta == 0 - 1 {
            pipeline_ir_reuse_shape_find(facts, source)
          } else { 0 }
          if shape != 0 and pipeline_ir_reuse_release_result_unused(rest, term, dst) == 1 and pipeline_ir_reuse_has_target(rest, shape) == 1 {
            let producer = IrCallI64(dst, pipeline_ir_reuse_drop_hash(), ir_value_list_prepend(source, ir_value_list_empty()))
            let wrapped = pipeline_ir_reuse_wrap_target(rest, dst, shape)
            IrInstCons(producer, pipeline_ir_reuse_insts(wrapped, term, facts))
          } else {
            IrInstCons(inst, pipeline_ir_reuse_insts(rest, term, facts))
          }
        }
        IrCallI64(dst, callee_hash, args) -> {
          let source = pipeline_ir_value_list_get_or(args, 0, 0 - 1)
          let shape = if callee_hash == pipeline_rc_default_release_hash() and ir_value_list_len(args) == 1 {
            pipeline_ir_reuse_shape_find(facts, source)
          } else { 0 }
          if shape != 0 and pipeline_ir_reuse_release_result_unused(rest, term, dst) == 1 and pipeline_ir_reuse_has_target(rest, shape) == 1 {
            let producer = IrCallI64(dst, pipeline_ir_reuse_drop_hash(), args)
            let wrapped = pipeline_ir_reuse_wrap_target(rest, dst, shape)
            IrInstCons(producer, pipeline_ir_reuse_insts(wrapped, term, facts))
          } else {
            IrInstCons(inst, pipeline_ir_reuse_insts(rest, term, facts))
          }
        }
        _ -> {
          pipeline_ir_reuse_shape_add(facts, inst)
          IrInstCons(inst, pipeline_ir_reuse_insts(rest, term, facts))
        }
      }
    }
  }
}

pub(package) fn pipeline_ir_reuse_block(block: IrBlock) -> IrBlock {
  match block {
    IrBlock(id, params, insts, term) -> IrBlock(id, params, pipeline_ir_reuse_insts(insts, term, nlist_new()), term)
  }
}

pub(package) fn pipeline_ir_reuse_blocks(blocks: IrBlockList) -> IrBlockList {
  match blocks {
    IrBlockListNil -> IrBlockListNil
    IrBlockListCons(block, rest) -> IrBlockListCons(pipeline_ir_reuse_block(block), pipeline_ir_reuse_blocks(rest))
  }
}

-- ======================================================================
-- Consuming ownership transfer (Morphic / Swift SIL ladder)
--
-- A compiler-generated retain immediately establishes a callee-owned stake.
-- When the caller's original stake has its exact last use at that call, move
-- the original stake instead: delete the temporary acquire and the caller's
-- later consume, and record the transfer explicitly. This first rung is
-- deliberately same-block and exact-identity. It crosses neither aliases nor
-- CFG joins; RC-identity classes are a later producer, not a guess here.
-- ======================================================================

pub(package) fn pipeline_ir_ownership_transfer_call_hash(inst: IrInst) -> i64 {
  match inst {
    IrCallI64(dst, callee_hash, args) -> callee_hash
    IrGenericCallI64(dst, callee_hash, type_args, args) -> mono_spec_hash(callee_hash, type_expr_list_to_nodes(type_args))
    _ -> 0
  }
}

pub(package) fn pipeline_ir_ownership_transfer_call_dst_or(inst: IrInst, default: i64) -> i64 {
  match inst {
    IrCallI64(dst, callee_hash, args) -> dst
    IrGenericCallI64(dst, callee_hash, type_args, args) -> dst
    _ -> default
  }
}

-- Exact physical ABI lane, or -1 unless the value occurs exactly once.
pub(package) fn pipeline_ir_ownership_transfer_arg_lane(values: IrValueList, source: i64) -> i64 {
  let mut cur = values
  let mut index = 0
  let mut found = 0 - 1
  let mut count = 0
  let mut done = 0
  while done == 0 {
    match cur {
      IrValueNil -> { done = 1 }
      IrValueCons(value, rest) -> {
        if value == source {
          found = index
          count = count + 1
        } else { 0 }
        index = index + 1
        cur = rest
      }
    }
  }
  if count == 1 { found } else { 0 - 1 }
}

pub(package) fn pipeline_ir_ownership_transfer_call_args(inst: IrInst) -> IrValueList {
  match inst {
    IrCallI64(dst, callee_hash, args) -> args
    IrGenericCallI64(dst, callee_hash, type_args, args) -> args
    _ -> IrValueNil
  }
}

-- Entry binds are the canonical logical-parameter -> physical-lane map. The
-- borrowed-mask marker is generated from the same checked signature. Reading
-- both facts avoids re-inferring ownership from source syntax or helper names.
pub(package) fn pipeline_ir_ownership_transfer_owned_lane_insts(insts: IrInstList, param_count: i64, arg_lane: i64, cleanup_kind: i64, borrowed_mask: i64, logical_index: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> match inst {
      IrBindI64(ns, nl, head, ty) -> {
        if head >= 0 and head < param_count {
          let lanes = pipeline_type_value_lane_count_or_one(ty)
          if arg_lane >= head and arg_lane < head + lanes {
            if cg_mask_has(borrowed_mask, logical_index) == 0 and pipeline_type_value_lane_release_kind(ty, arg_lane - head) == cleanup_kind { 1 } else { 0 }
          } else {
            pipeline_ir_ownership_transfer_owned_lane_insts(rest, param_count, arg_lane, cleanup_kind, borrowed_mask, logical_index + 1)
          }
        } else {
          pipeline_ir_ownership_transfer_owned_lane_insts(rest, param_count, arg_lane, cleanup_kind, borrowed_mask, logical_index)
        }
      }
      _ -> pipeline_ir_ownership_transfer_owned_lane_insts(rest, param_count, arg_lane, cleanup_kind, borrowed_mask, logical_index)
    }
  }
}

pub(package) fn pipeline_ir_ownership_transfer_function_owns_lane(function: IrFunction, arg_count: i64, arg_lane: i64, cleanup_kind: i64) -> i64 {
  match function {
    IrFunction(hash, param_count, blocks, src) -> {
      if arg_count != param_count or arg_lane < 0 or arg_lane >= param_count { 0 }
      else {
        match blocks {
          IrBlockListCons(block, rest) -> match block {
            IrBlock(id, params, insts, term) -> {
              let borrowed_mask = pipeline_ir_native_borrowed_param_mask_from_inst_list(insts)
              pipeline_ir_ownership_transfer_owned_lane_insts(insts, param_count, arg_lane, cleanup_kind, borrowed_mask, 0)
            }
          }
          _ -> 0
        }
      }
    }
  }
}

-- Result fields: tag=1, call destination, exact (possibly mono) callee hash,
-- physical argument lane, cleanup kind. Zero means the call is not an exact
-- owned-lane consumer of this provenance.
pub(package) fn pipeline_ir_ownership_transfer_call_info(inst: IrInst, source: i64, cleanup_kind: i64, facts: PipelineIrSemanticFactList, functions: IrFunctionList) -> i64 {
  let callee_hash = pipeline_ir_ownership_transfer_call_hash(inst)
  let args = pipeline_ir_ownership_transfer_call_args(inst)
  let arg_lane = pipeline_ir_ownership_transfer_arg_lane(args, source)
  let call_dst = pipeline_ir_ownership_transfer_call_dst_or(inst, 0 - 1)
  if callee_hash == 0 or call_dst < 0 or arg_lane < 0 or pipeline_ir_semantic_fact_lookup_pure(facts, callee_hash) != 1 { 0 }
  else {
    match pipeline_ir_function_list_find_hash(functions, callee_hash) {
      IrFunctionCons(function, IrFunctionNil) -> {
        if pipeline_ir_ownership_transfer_function_owns_lane(function, ir_value_list_len(args), arg_lane, cleanup_kind) == 1 {
          node_new(1, call_dst, callee_hash, arg_lane, cleanup_kind)
        } else { 0 }
      }
      _ -> 0
    }
  }
}

pub(package) fn pipeline_ir_ownership_transfer_value_unused(insts: IrInstList, term: IrTerminator, value: i64) -> i64 {
  let live = pipeline_ir_reuse_term_add_uses(term, pipeline_ir_reuse_inst_list_add_uses(insts, pipeline_ir_live_set_empty()))
  if pipeline_ir_live_set_contains(live, value) == 1 { 0 } else { 1 }
}

pub(package) fn pipeline_ir_ownership_transfer_after_is_exact(insts: IrInstList, term: IrTerminator, source: i64, cleanup_kind: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> match inst {
      IrManagedStakeI64(dst, value, release_kind, delta, origin) -> {
        if value == source and release_kind == cleanup_kind and delta == 0 - 1 {
          if pipeline_ir_ownership_transfer_value_unused(rest, term, dst) == 1 and pipeline_ir_ownership_transfer_value_unused(rest, term, source) == 1 { 1 } else { 0 }
        } else {
          let uses = pipeline_ir_live_set_add_inst_uses(inst, pipeline_ir_live_set_empty())
          if pipeline_ir_live_set_contains(uses, source) == 1 { 0 }
          else { pipeline_ir_ownership_transfer_after_is_exact(rest, term, source, cleanup_kind) }
        }
      }
      _ -> {
        let uses = pipeline_ir_live_set_add_inst_uses(inst, pipeline_ir_live_set_empty())
        if pipeline_ir_live_set_contains(uses, source) == 1 { 0 }
        else { pipeline_ir_ownership_transfer_after_is_exact(rest, term, source, cleanup_kind) }
      }
    }
  }
}

pub(package) fn pipeline_ir_ownership_transfer_candidate(insts: IrInstList, term: IrTerminator, retain_dst: i64, source: i64, cleanup_kind: i64, facts: PipelineIrSemanticFactList, functions: IrFunctionList) -> i64 {
  if pipeline_ir_ownership_transfer_value_unused(insts, term, retain_dst) != 1 { 0 }
  else {
    match insts {
      IrInstNil -> 0
      IrInstCons(inst, rest) -> match inst {
        IrManagedTransferI64(call_dst, callee_hash, value, arg_lane, marker_kind) -> {
          if callee_hash == pipeline_direct_managed_transfer_hash() and value == source and marker_kind == cleanup_kind {
            pipeline_ir_ownership_transfer_candidate(rest, term, retain_dst, source, cleanup_kind, facts, functions)
          } else {
            let uses = pipeline_ir_live_set_add_inst_uses(inst, pipeline_ir_live_set_empty())
            if pipeline_ir_live_set_contains(uses, source) == 1 { 0 }
            else { pipeline_ir_ownership_transfer_candidate(rest, term, retain_dst, source, cleanup_kind, facts, functions) }
          }
        }
        _ -> {
        let info = pipeline_ir_ownership_transfer_call_info(inst, source, cleanup_kind, facts, functions)
        if info != 0 {
          if pipeline_ir_ownership_transfer_after_is_exact(rest, term, source, cleanup_kind) == 1 { info } else { 0 }
        } else {
          let uses = pipeline_ir_live_set_add_inst_uses(inst, pipeline_ir_live_set_empty())
          if pipeline_ir_live_set_contains(uses, source) == 1 { 0 }
          else { pipeline_ir_ownership_transfer_candidate(rest, term, retain_dst, source, cleanup_kind, facts, functions) }
        }
        }
      }
    }
  }
}

pub(package) fn pipeline_ir_ownership_transfer_remove_release(insts: IrInstList, source: i64, cleanup_kind: i64) -> IrInstList {
  match insts {
    IrInstNil -> IrInstNil
    IrInstCons(inst, rest) -> match inst {
      IrManagedStakeI64(dst, value, release_kind, delta, origin) -> {
        if value == source and release_kind == cleanup_kind and delta == 0 - 1 { rest }
        else { IrInstCons(inst, pipeline_ir_ownership_transfer_remove_release(rest, source, cleanup_kind)) }
      }
      _ -> IrInstCons(inst, pipeline_ir_ownership_transfer_remove_release(rest, source, cleanup_kind))
    }
  }
}

pub(package) fn pipeline_ir_ownership_transfer_rewrite_rest(insts: IrInstList, source: i64, cleanup_kind: i64, info: i64) -> IrInstList {
  match insts {
    IrInstNil -> IrInstNil
    IrInstCons(inst, rest) -> match inst {
      IrManagedTransferI64(call_dst, callee_hash, value, arg_lane, marker_kind) -> {
        if callee_hash == pipeline_direct_managed_transfer_hash() and value == source and marker_kind == cleanup_kind {
          pipeline_ir_ownership_transfer_rewrite_rest(rest, source, cleanup_kind, info)
        } else {
          IrInstCons(inst, pipeline_ir_ownership_transfer_rewrite_rest(rest, source, cleanup_kind, info))
        }
      }
      _ -> {
      let call_dst = pipeline_ir_ownership_transfer_call_dst_or(inst, 0 - 1)
      let call_hash = pipeline_ir_ownership_transfer_call_hash(inst)
      if call_dst == node_f1(info) and call_hash == node_f2(info) and pipeline_ir_ownership_transfer_arg_lane(pipeline_ir_ownership_transfer_call_args(inst), source) == node_f3(info) {
        let marker = IrManagedTransferI64(call_dst, call_hash, source, node_f3(info), cleanup_kind)
        IrInstCons(marker, IrInstCons(inst, pipeline_ir_ownership_transfer_remove_release(rest, source, cleanup_kind)))
      } else {
        IrInstCons(inst, pipeline_ir_ownership_transfer_rewrite_rest(rest, source, cleanup_kind, info))
      }
      }
    }
  }
}

pub(package) fn pipeline_ir_ownership_transfer_insts(insts: IrInstList, term: IrTerminator, facts: PipelineIrSemanticFactList, functions: IrFunctionList) -> IrInstList {
  match insts {
    IrInstNil -> IrInstNil
    IrInstCons(inst, rest) -> match inst {
      IrManagedStakeI64(dst, source, cleanup_kind, delta, origin) -> {
        let info = if delta == 1 { pipeline_ir_ownership_transfer_candidate(rest, term, dst, source, cleanup_kind, facts, functions) } else { 0 }
        if info != 0 {
          pipeline_ir_ownership_transfer_insts(pipeline_ir_ownership_transfer_rewrite_rest(rest, source, cleanup_kind, info), term, facts, functions)
        } else {
          IrInstCons(inst, pipeline_ir_ownership_transfer_insts(rest, term, facts, functions))
        }
      }
      _ -> IrInstCons(inst, pipeline_ir_ownership_transfer_insts(rest, term, facts, functions))
    }
  }
}

pub(package) fn pipeline_ir_ownership_transfer_blocks(blocks: IrBlockList, facts: PipelineIrSemanticFactList, functions: IrFunctionList) -> IrBlockList {
  match blocks {
    IrBlockListNil -> IrBlockListNil
    IrBlockListCons(block, rest) -> {
      let rewritten = match block {
        IrBlock(id, params, insts, term) -> IrBlock(id, params, pipeline_ir_ownership_transfer_insts(insts, term, facts, functions), term)
      }
      IrBlockListCons(rewritten, pipeline_ir_ownership_transfer_blocks(rest, facts, functions))
    }
  }
}

pub(package) fn pipeline_ir_ownership_transfer_functions(functions: IrFunctionList, all_functions: IrFunctionList, facts: PipelineIrSemanticFactList) -> IrFunctionList {
  match functions {
    IrFunctionNil -> IrFunctionNil
    IrFunctionCons(function, rest) -> {
      let rewritten = match function {
        IrFunction(hash, params, blocks, src) -> IrFunction(hash, params, pipeline_ir_ownership_transfer_blocks(blocks, facts, all_functions), src)
      }
      IrFunctionCons(rewritten, pipeline_ir_ownership_transfer_functions(rest, all_functions, facts))
    }
  }
}

-- ======================================================================
-- Consuming same-layout specialisation (Morphic / Perceus ladder)
--
-- A persistent update is eligible only when the shared semantic plane says:
-- closed/pure effect contract, fresh managed result, and an exact managed
-- parameter lane with the same representation. The callee's entry marker must
-- independently prove that lane borrowed. No collection or constructor name
-- participates in selection.
-- ======================================================================

pub(package) fn pipeline_ir_consuming_request_lookup(requests: i64, base_hash: i64, arg_lane: i64) -> i64 {
  let mut clone_hash = 0
  let mut i = 0
  while i < nlist_len(requests) and clone_hash == 0 {
    let request = nlist_get(requests, i)
    if node_f1(request) == base_hash and node_f3(request) == arg_lane { clone_hash = node_f2(request) }
    else { i = i + 1 }
  }
  clone_hash
}

pub(package) fn pipeline_ir_consuming_request_hash_exists(requests: i64, hash: i64) -> i64 {
  let mut found = 0
  let mut i = 0
  while i < nlist_len(requests) and found == 0 {
    if node_f2(nlist_get(requests, i)) == hash { found = 1 } else { i = i + 1 }
  }
  found
}

pub(package) fn pipeline_ir_consuming_request_hash(base_hash: i64, arg_lane: i64) -> i64 {
  let hash = base_hash * 1000003 + arg_lane * 104729 + 86028121
  if hash == 0 { 86028121 } else { hash }
}

pub(package) fn pipeline_ir_consuming_request_ensure(requests: i64, functions: IrFunctionList, base_hash: i64, arg_lane: i64, cleanup_kind: i64) -> i64 {
  let existing = pipeline_ir_consuming_request_lookup(requests, base_hash, arg_lane)
  if existing != 0 { existing }
  else {
    let mut clone_hash = pipeline_ir_consuming_request_hash(base_hash, arg_lane)
    while pipeline_ir_identity_function_hash_exists(functions, clone_hash) == 1 or pipeline_ir_consuming_request_hash_exists(requests, clone_hash) == 1 {
      clone_hash = clone_hash + 104729
      if clone_hash == 0 { clone_hash = 86028121 } else { 0 }
    }
    nlist_add(requests, node_new(0, base_hash, clone_hash, arg_lane, cleanup_kind))
    clone_hash
  }
}

-- Result: 1 owned, 2 borrowed, 0 not an exact managed lane. Entry binds map
-- logical parameters to physical ABI heads; the marker is logical-param keyed.
pub(package) fn pipeline_ir_consuming_lane_mode_insts(insts: IrInstList, param_count: i64, arg_lane: i64, cleanup_kind: i64, borrowed_mask: i64, logical_index: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> match inst {
      IrBindI64(ns, nl, head, ty) -> {
        if head >= 0 and head < param_count {
          let lanes = pipeline_type_value_lane_count_or_one(ty)
          if arg_lane >= head and arg_lane < head + lanes {
            if pipeline_type_value_lane_release_kind(ty, arg_lane - head) != cleanup_kind { 0 }
            else { if cg_mask_has(borrowed_mask, logical_index) == 1 { 2 } else { 1 } }
          } else {
            pipeline_ir_consuming_lane_mode_insts(rest, param_count, arg_lane, cleanup_kind, borrowed_mask, logical_index + 1)
          }
        } else {
          pipeline_ir_consuming_lane_mode_insts(rest, param_count, arg_lane, cleanup_kind, borrowed_mask, logical_index)
        }
      }
      _ -> pipeline_ir_consuming_lane_mode_insts(rest, param_count, arg_lane, cleanup_kind, borrowed_mask, logical_index)
    }
  }
}

pub(package) fn pipeline_ir_consuming_function_lane_mode(function: IrFunction, arg_count: i64, arg_lane: i64, cleanup_kind: i64) -> i64 {
  match function {
    IrFunction(hash, param_count, blocks, src) -> {
      if arg_count != param_count or arg_lane < 0 or arg_lane >= param_count { 0 }
      else { match blocks {
        IrBlockListCons(block, rest) -> match block {
          IrBlock(id, params, insts, term) -> pipeline_ir_consuming_lane_mode_insts(insts, param_count, arg_lane, cleanup_kind, pipeline_ir_native_borrowed_param_mask_from_inst_list(insts), 0)
        }
        _ -> 0
      } }
    }
  }
}

pub(package) fn pipeline_ir_consuming_function_candidate_eligible(function: IrFunction, facts: PipelineIrSemanticFactList) -> i64 {
  match function {
    IrFunction(hash, param_count, blocks, src) -> {
      let fact = pipeline_ir_semantic_fact_find(facts, hash)
      if fact != 0 and
         cg_semantic_fact_effect_contract_pure(fact) == 1 and
         cg_semantic_fact_managed_return(fact) == 1 and
         cg_semantic_fact_fresh_managed_return(fact) == 1 and
         cg_semantic_fact_same_managed_return_param_mask(fact) != 0 { 1 }
      else { 0 }
    }
  }
}

-- A small, fact-selected hash tree keeps the all-instruction walks cheap.
-- Building it visits each function once; discovery then avoids consulting the
-- full fact plane or function list for the overwhelmingly common noncandidate
-- call head.
pub(package) fn pipeline_ir_consuming_function_candidates(functions: IrFunctionList, facts: PipelineIrSemanticFactList) -> PipelineIrInlineCandidateList {
  match functions {
    IrFunctionNil -> PipelineIrInlineCandidateNil
    IrFunctionCons(function, rest) -> {
      let tail = pipeline_ir_consuming_function_candidates(rest, facts)
      match function {
        IrFunction(hash, param_count, blocks, src) -> {
          if pipeline_ir_consuming_function_candidate_eligible(function, facts) == 1 {
            pipeline_ir_inline_candidate_prepend(hash, function, tail)
          } else { tail }
        }
      }
    }
  }
}

-- Exact physical source lane or -1. Multiple eligible dead lanes are left
-- unspecialised: choosing among them would make reuse identity order-sensitive.
pub(package) fn pipeline_ir_consuming_candidate_lane(inst: IrInst, rest: IrInstList, term: IrTerminator, facts: PipelineIrSemanticFactList, candidates: PipelineIrInlineCandidateList) -> i64 {
  let callee_hash = pipeline_ir_ownership_transfer_call_hash(inst)
  if callee_hash == 0 { 0 - 1 }
  else { match pipeline_ir_inline_candidate_lookup(candidates, callee_hash) {
    IrFunctionNil -> 0 - 1
    IrFunctionCons(function, IrFunctionNil) -> {
    let args = pipeline_ir_ownership_transfer_call_args(inst)
    let fact = pipeline_ir_semantic_fact_find(facts, callee_hash)
    if fact == 0 or ir_value_list_len(args) == 0 { 0 - 1 }
    else {
      let same_mask = cg_semantic_fact_same_managed_return_param_mask(fact)
      let mut lane = 0
      let mut found = 0 - 1
      let mut count = 0
      while lane < ir_value_list_len(args) and lane < 60 {
        if (same_mask band cg_bit(lane)) != 0 {
          let source = ir_value_list_nth_or(args, lane, 0 - 1)
          let borrowed = pipeline_ir_consuming_function_lane_mode(function, ir_value_list_len(args), lane, continuation_cleanup_kind_rc())
          if source >= 0 and borrowed == 2 and pipeline_ir_ownership_transfer_after_is_exact(rest, term, source, continuation_cleanup_kind_rc()) == 1 {
            found = lane
            count = count + 1
          } else { 0 }
        } else { 0 }
        lane = lane + 1
      }
      if count == 1 { found } else { 0 - 1 }
    }
    }
    _ -> 0 - 1
  } }
}

pub(package) fn pipeline_ir_consuming_discover_insts(insts: IrInstList, term: IrTerminator, facts: PipelineIrSemanticFactList, candidates: PipelineIrInlineCandidateList, functions: IrFunctionList, requests: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let lane = pipeline_ir_consuming_candidate_lane(inst, rest, term, facts, candidates)
      if lane >= 0 {
        pipeline_ir_consuming_request_ensure(requests, functions, pipeline_ir_ownership_transfer_call_hash(inst), lane, continuation_cleanup_kind_rc())
      } else { 0 }
      pipeline_ir_consuming_discover_insts(rest, term, facts, candidates, functions, requests)
    }
  }
}

pub(package) fn pipeline_ir_consuming_discover_blocks(blocks: IrBlockList, facts: PipelineIrSemanticFactList, candidates: PipelineIrInlineCandidateList, functions: IrFunctionList, requests: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block { IrBlock(id, params, insts, term) -> pipeline_ir_consuming_discover_insts(insts, term, facts, candidates, functions, requests) }
      pipeline_ir_consuming_discover_blocks(rest, facts, candidates, functions, requests)
    }
  }
}

pub(package) fn pipeline_ir_consuming_discover_functions(functions: IrFunctionList, all_functions: IrFunctionList, facts: PipelineIrSemanticFactList, candidates: PipelineIrInlineCandidateList, requests: i64) -> i64 {
  match functions {
    IrFunctionNil -> 0
    IrFunctionCons(function, rest) -> {
      match function { IrFunction(hash, param_count, blocks, src) -> pipeline_ir_consuming_discover_blocks(blocks, facts, candidates, all_functions, requests) }
      pipeline_ir_consuming_discover_functions(rest, all_functions, facts, candidates, requests)
    }
  }
}

pub(package) fn pipeline_ir_consuming_needed_seed_terms(blocks: IrBlockList, needed: PipelineIrLiveSet) -> PipelineIrLiveSet {
  match blocks {
    IrBlockListNil -> needed
    IrBlockListCons(block, rest) -> match block {
      IrBlock(id, params, insts, term) -> {
        let next = match term {
          IrTermReturn(value) -> pipeline_ir_live_set_add(needed, value)
          _ -> needed
        }
        pipeline_ir_consuming_needed_seed_terms(rest, next)
      }
    }
  }
}

pub(package) fn pipeline_ir_consuming_needed_add_alias_args(mask: i64, index: i64, args: IrValueList, shapes: i64, needed: PipelineIrLiveSet) -> PipelineIrLiveSet {
  if index >= 60 or shapes == 0 or index >= nlist_len(shapes) { needed }
  else {
    let next = if (mask band cg_bit(index)) == 0 { needed }
    else {
      let head = pipeline_ir_fresh_return_param_head_or(shapes, index, 0 - 1)
      let arg = if head < 0 { 0 - 1 } else { ir_value_list_nth_or(args, head, 0 - 1) }
      if arg < 0 { needed } else { pipeline_ir_live_set_add(needed, arg) }
    }
    pipeline_ir_consuming_needed_add_alias_args(mask, index + 1, args, shapes, next)
  }
}

pub(package) fn pipeline_ir_consuming_needed_add_call(dst: i64, callee_hash: i64, args: IrValueList, facts: PipelineIrSemanticFactList, needed: PipelineIrLiveSet) -> PipelineIrLiveSet {
  if pipeline_ir_live_set_contains(needed, dst) != 1 { needed }
  else { if callee_hash == pipeline_ir_native_intrinsic_transmute_hash() {
    let source = ir_value_list_nth_or(args, 0, 0 - 1)
    if source < 0 { needed } else { pipeline_ir_live_set_add(needed, source) }
  } else {
    let fact = pipeline_ir_semantic_fact_find(facts, callee_hash)
    if fact == 0 { needed }
    else {
      let mask = cg_semantic_fact_return_alias_param_mask(fact)
      if mask == 0 { needed }
      else { pipeline_ir_consuming_needed_add_alias_args(mask, 0, args, cg_semantic_fact_param_shapes(fact), needed) }
    }
  } }
}

pub(package) fn pipeline_ir_consuming_needed_add_inst(inst: IrInst, facts: PipelineIrSemanticFactList, needed: PipelineIrLiveSet) -> PipelineIrLiveSet {
  match inst {
    IrResumeI64(dst, value) -> if pipeline_ir_live_set_contains(needed, dst) == 1 { pipeline_ir_live_set_add(needed, value) } else { needed }
    IrCallI64(dst, callee_hash, args) -> pipeline_ir_consuming_needed_add_call(dst, callee_hash, args, facts, needed)
    IrGenericCallI64(dst, callee_hash, type_args, args) -> pipeline_ir_consuming_needed_add_call(dst, pipeline_ir_function_ref_target_hash(callee_hash, type_args), args, facts, needed)
    IrMethodCallI64(dst, type_hash, method_hash, receiver, args) -> {
      let qualified = pipeline_ir_method_patch_key(type_hash, method_hash)
      let callee_hash = if pipeline_ir_semantic_fact_find(facts, qualified) != 0 { qualified } else { method_hash }
      pipeline_ir_consuming_needed_add_call(dst, callee_hash, ir_value_list_prepend(receiver, args), facts, needed)
    }
    _ -> needed
  }
}

pub(package) fn pipeline_ir_consuming_needed_add_insts(insts: IrInstList, facts: PipelineIrSemanticFactList, needed: PipelineIrLiveSet) -> PipelineIrLiveSet {
  match insts {
    IrInstNil -> needed
    IrInstCons(inst, rest) -> pipeline_ir_consuming_needed_add_insts(rest, facts, pipeline_ir_consuming_needed_add_inst(inst, facts, needed))
  }
}

pub(package) fn pipeline_ir_consuming_needed_add_block_insts(blocks: IrBlockList, facts: PipelineIrSemanticFactList, needed: PipelineIrLiveSet) -> PipelineIrLiveSet {
  match blocks {
    IrBlockListNil -> needed
    IrBlockListCons(block, rest) -> match block {
      IrBlock(id, params, insts, term) -> pipeline_ir_consuming_needed_add_block_insts(rest, facts, pipeline_ir_consuming_needed_add_insts(insts, facts, needed))
    }
  }
}

pub(package) fn pipeline_ir_consuming_needed_add_jump_args(args: IrValueList, params: IrValueList, needed: PipelineIrLiveSet) -> PipelineIrLiveSet {
  match args {
    IrValueNil -> needed
    IrValueCons(arg, arg_rest) -> match params {
      IrValueNil -> needed
      IrValueCons(param, param_rest) -> {
        let next = if pipeline_ir_live_set_contains(needed, param) == 1 { pipeline_ir_live_set_add(needed, arg) } else { needed }
        pipeline_ir_consuming_needed_add_jump_args(arg_rest, param_rest, next)
      }
    }
  }
}

pub(package) fn pipeline_ir_consuming_needed_add_jumps(blocks: IrBlockList, all_blocks: IrBlockList, needed: PipelineIrLiveSet) -> PipelineIrLiveSet {
  match blocks {
    IrBlockListNil -> needed
    IrBlockListCons(block, rest) -> match block {
      IrBlock(id, params, insts, term) -> {
        let next = match term {
          IrTermJump(target, args) -> pipeline_ir_consuming_needed_add_jump_args(args, pipeline_ir_native_block_params_or(all_blocks, target, ir_value_list_empty()), needed)
          _ -> needed
        }
        pipeline_ir_consuming_needed_add_jumps(rest, all_blocks, next)
      }
    }
  }
}

pub(package) fn pipeline_ir_consuming_needed_values(blocks: IrBlockList, facts: PipelineIrSemanticFactList, next_value: i64) -> PipelineIrLiveSet {
  let mut needed = pipeline_ir_consuming_needed_seed_terms(blocks, pipeline_ir_live_set_dense(next_value + 1))
  let mut changed = 1
  let mut budget = next_value + ir_block_list_len(blocks) + 2
  while changed == 1 and budget > 0 {
    let before = pipeline_ir_live_set_len(needed)
    needed = pipeline_ir_consuming_needed_add_block_insts(blocks, facts, needed)
    needed = pipeline_ir_consuming_needed_add_jumps(blocks, blocks, needed)
    changed = if pipeline_ir_live_set_len(needed) == before { 0 } else { 1 }
    budget = budget - 1
  }
  needed
}

pub(package) fn pipeline_ir_consuming_raw_root_count(insts: IrInstList, needed: PipelineIrLiveSet) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let add = match inst {
        IrCallI64(dst, callee_hash, args) -> {
          if callee_hash == pipeline_ir_native_hash_name("rc_default_alloc") and ir_value_list_len(args) == 2 and pipeline_ir_live_set_contains(needed, dst) == 1 { 1 } else { 0 }
        }
        _ -> 0
      }
      add + pipeline_ir_consuming_raw_root_count(rest, needed)
    }
  }
}

pub(package) fn pipeline_ir_consuming_managed_retain_arg_or(inst: IrInst, default: i64) -> i64 {
  match inst {
    IrCallI64(dst, callee_hash, args) -> {
      if pipeline_ir_abort_cleanup_is_managed_retain_hash(callee_hash) == 1 { ir_value_list_nth_or(args, 0, default) } else { default }
    }
    IrManagedStakeI64(dst, value, cleanup_kind, delta, origin) -> if delta == 1 { value } else { default }
    _ -> default
  }
}

pub(package) fn pipeline_ir_consuming_insts_define_value(insts: IrInstList, value: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      if pipeline_ir_inst_def_or(inst, 0 - 1) == value { 1 }
      else { pipeline_ir_consuming_insts_define_value(rest, value) }
    }
  }
}

pub(package) fn pipeline_ir_consuming_retain_suffix_valid_inner(insts: IrInstList, all_insts: IrInstList, root_dst: i64, source: i64) -> i64 {
  match insts {
    IrInstNil -> 1
    IrInstCons(inst, rest) -> {
      let arg = pipeline_ir_consuming_managed_retain_arg_or(inst, 0 - 1)
      if arg >= 0 and (arg == root_dst or arg == source or pipeline_ir_consuming_insts_define_value(all_insts, arg) == 1) { 0 }
      else { pipeline_ir_consuming_retain_suffix_valid_inner(rest, all_insts, root_dst, source) }
    }
  }
}

pub(package) fn pipeline_ir_consuming_retain_suffix_valid(insts: IrInstList, root_dst: i64, source: i64) -> i64 {
  pipeline_ir_consuming_retain_suffix_valid_inner(insts, insts, root_dst, source)
}

pub(package) fn pipeline_ir_consuming_collect_retains(insts: IrInstList) -> IrInstList {
  match insts {
    IrInstNil -> IrInstNil
    IrInstCons(inst, rest) -> {
      if pipeline_ir_consuming_managed_retain_arg_or(inst, 0 - 1) >= 0 {
        IrInstCons(inst, pipeline_ir_consuming_collect_retains(rest))
      } else { pipeline_ir_consuming_collect_retains(rest) }
    }
  }
}

pub(package) fn pipeline_ir_consuming_remove_retains(insts: IrInstList) -> IrInstList {
  match insts {
    IrInstNil -> IrInstNil
    IrInstCons(inst, rest) -> {
      if pipeline_ir_consuming_managed_retain_arg_or(inst, 0 - 1) >= 0 { pipeline_ir_consuming_remove_retains(rest) }
      else { IrInstCons(inst, pipeline_ir_consuming_remove_retains(rest)) }
    }
  }
}

pub(package) fn pipeline_ir_consuming_rewrite_raw_root(insts: IrInstList, needed: PipelineIrLiveSet, source: i64, next_value: i64) -> PipelineIrConsumingCloneResult {
  match insts {
    IrInstNil -> PipelineIrConsumingCloneInvalid
    IrInstCons(inst, rest) -> match inst {
      IrCallI64(dst, callee_hash, args) -> {
        if callee_hash == pipeline_ir_native_hash_name("rc_default_alloc") and ir_value_list_len(args) == 2 and pipeline_ir_live_set_contains(needed, dst) == 1 {
          if pipeline_ir_consuming_retain_suffix_valid(rest, dst, source) != 1 { PipelineIrConsumingCloneInvalid }
          else {
            let retains = pipeline_ir_consuming_collect_retains(rest)
            let suffix = pipeline_ir_consuming_remove_retains(rest)
            let producer = IrCallI64(next_value, pipeline_ir_reuse_drop_hash(), ir_value_list_prepend(source, ir_value_list_empty()))
            let reused = IrReuseInitI64(next_value, inst)
            PipelineIrConsumingCloneOk(
              ir_inst_list_append(retains, IrInstCons(producer, IrInstCons(reused, suffix))),
              next_value + 1
            )
          }
        } else {
          match pipeline_ir_consuming_rewrite_raw_root(rest, needed, source, next_value) {
            PipelineIrConsumingCloneInvalid -> PipelineIrConsumingCloneInvalid
            PipelineIrConsumingCloneOk(rewritten, next) -> PipelineIrConsumingCloneOk(IrInstCons(inst, rewritten), next)
          }
        }
      }
      _ -> match pipeline_ir_consuming_rewrite_raw_root(rest, needed, source, next_value) {
        PipelineIrConsumingCloneInvalid -> PipelineIrConsumingCloneInvalid
        PipelineIrConsumingCloneOk(rewritten, next) -> PipelineIrConsumingCloneOk(IrInstCons(inst, rewritten), next)
      }
    }
  }
}

pub(package) fn pipeline_ir_consuming_expandable_call_info(insts: IrInstList, needed: PipelineIrLiveSet, facts: PipelineIrSemanticFactList, functions: IrFunctionList) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let dst = pipeline_ir_ownership_transfer_call_dst_or(inst, 0 - 1)
      let hash = pipeline_ir_ownership_transfer_call_hash(inst)
      let fact = pipeline_ir_semantic_fact_find(facts, hash)
      let eligible = if dst < 0 or hash == 0 or fact == 0 or pipeline_ir_live_set_contains(needed, dst) != 1 { 0 }
      else { if pipeline_ir_fresh_return_allocator_hash(hash) == 1 { 0 }
      else { if cg_semantic_fact_fresh_managed_return(fact) != 1 { 0 }
      else { match pipeline_ir_function_list_find_hash(functions, hash) {
        IrFunctionCons(function, IrFunctionNil) -> 1
        _ -> 0
      } } } }
      if eligible == 1 { node_new(0, dst, hash, 0, 0) }
      else { pipeline_ir_consuming_expandable_call_info(rest, needed, facts, functions) }
    }
  }
}

pub(package) fn pipeline_ir_consuming_clone_call(inst: IrInst, callee: IrFunction, next_value: i64) -> PipelineIrConsumingCloneResult {
  let args = pipeline_ir_ownership_transfer_call_args(inst)
  let desired_result = pipeline_ir_ownership_transfer_call_dst_or(inst, 0 - 1)
  match callee {
    IrFunction(hash, param_count, blocks, src) -> {
      if desired_result < 0 or ir_value_list_len(args) != param_count { PipelineIrConsumingCloneInvalid }
      else { match blocks {
        IrBlockListCons(block, IrBlockListNil) -> match block {
          IrBlock(id, params, callee_insts, term) -> {
            if ir_value_list_len(params) != 0 { PipelineIrConsumingCloneInvalid }
            else { match term {
              IrTermReturn(return_value) -> {
                let cloned = pipeline_ir_inline_clone_inst_list(callee_insts, pipeline_ir_inline_arg_env(args, 0, PipelineIrInlineValueEnvNil), return_value, desired_result, next_value)
                if pipeline_ir_inline_clone_result_ok(cloned) != 1 { PipelineIrConsumingCloneInvalid }
                else { PipelineIrConsumingCloneOk(pipeline_ir_inline_clone_result_insts(cloned), pipeline_ir_inline_clone_result_next_value(cloned)) }
              }
              _ -> PipelineIrConsumingCloneInvalid
            } }
          }
        }
        _ -> PipelineIrConsumingCloneInvalid
      } }
    }
  }
}

pub(package) fn pipeline_ir_consuming_splice_call(insts: IrInstList, target_dst: i64, target_hash: i64, functions: IrFunctionList, next_value: i64) -> PipelineIrConsumingCloneResult {
  match insts {
    IrInstNil -> PipelineIrConsumingCloneInvalid
    IrInstCons(inst, rest) -> {
      if pipeline_ir_ownership_transfer_call_dst_or(inst, 0 - 1) == target_dst and pipeline_ir_ownership_transfer_call_hash(inst) == target_hash {
        match pipeline_ir_function_list_find_hash(functions, target_hash) {
          IrFunctionCons(callee, IrFunctionNil) -> match pipeline_ir_consuming_clone_call(inst, callee, next_value) {
            PipelineIrConsumingCloneInvalid -> PipelineIrConsumingCloneInvalid
            PipelineIrConsumingCloneOk(cloned, next) -> PipelineIrConsumingCloneOk(ir_inst_list_append(cloned, rest), next)
          }
          _ -> PipelineIrConsumingCloneInvalid
        }
      } else {
        match pipeline_ir_consuming_splice_call(rest, target_dst, target_hash, functions, next_value) {
          PipelineIrConsumingCloneInvalid -> PipelineIrConsumingCloneInvalid
          PipelineIrConsumingCloneOk(rewritten, next) -> PipelineIrConsumingCloneOk(IrInstCons(inst, rewritten), next)
        }
      }
    }
  }
}

-- Expand only the fresh producer chain that feeds this result. Each recursive
-- step removes one named factory boundary; the budget prevents recursive or
-- malformed fact graphs from cloning indefinitely. At the bottom exactly one
-- canonical raw allocation must remain on the return provenance path.
pub(package) fn pipeline_ir_consuming_expand_factory(insts: IrInstList, result_value: i64, source: i64, next_value: i64, facts: PipelineIrSemanticFactList, functions: IrFunctionList, budget: i64) -> PipelineIrConsumingCloneResult {
  if budget <= 0 { PipelineIrConsumingCloneInvalid }
  else {
    let blocks = ir_block_list_prepend(ir_block_new_term(0, insts, IrTermReturn(result_value)), ir_block_list_empty())
    let needed = pipeline_ir_consuming_needed_values(blocks, facts, next_value)
    let info = pipeline_ir_consuming_expandable_call_info(insts, needed, facts, functions)
    if info != 0 {
      match pipeline_ir_consuming_splice_call(insts, node_f1(info), node_f2(info), functions, next_value) {
        PipelineIrConsumingCloneInvalid -> PipelineIrConsumingCloneInvalid
        PipelineIrConsumingCloneOk(rewritten, next) -> pipeline_ir_consuming_expand_factory(rewritten, result_value, source, next, facts, functions, budget - 1)
      }
    } else {
      if pipeline_ir_consuming_raw_root_count(insts, needed) != 1 { PipelineIrConsumingCloneInvalid }
      else { pipeline_ir_consuming_rewrite_raw_root(insts, needed, source, next_value) }
    }
  }
}

pub(package) fn pipeline_ir_consuming_expand_call(inst: IrInst, source: i64, next_value: i64, facts: PipelineIrSemanticFactList, functions: IrFunctionList) -> PipelineIrConsumingCloneResult {
  let hash = pipeline_ir_ownership_transfer_call_hash(inst)
  match pipeline_ir_function_list_find_hash(functions, hash) {
    IrFunctionCons(callee, IrFunctionNil) -> match pipeline_ir_consuming_clone_call(inst, callee, next_value) {
      PipelineIrConsumingCloneInvalid -> PipelineIrConsumingCloneInvalid
      PipelineIrConsumingCloneOk(cloned, next) -> pipeline_ir_consuming_expand_factory(cloned, pipeline_ir_ownership_transfer_call_dst_or(inst, 0 - 1), source, next, facts, functions, ir_function_list_len(functions) + 1)
    }
    _ -> PipelineIrConsumingCloneInvalid
  }
}

pub(package) fn pipeline_ir_consuming_rewrite_block_insts(insts: IrInstList, needed: PipelineIrLiveSet, source: i64, facts: PipelineIrSemanticFactList, functions: IrFunctionList, next_value: i64) -> PipelineIrConsumingCloneResult {
  match insts {
    IrInstNil -> PipelineIrConsumingCloneOk(IrInstNil, next_value)
    IrInstCons(inst, rest) -> {
      let dst = pipeline_ir_ownership_transfer_call_dst_or(inst, 0 - 1)
      let hash = pipeline_ir_ownership_transfer_call_hash(inst)
      let fact = pipeline_ir_semantic_fact_find(facts, hash)
      let eligible = if dst < 0 or hash == 0 or fact == 0 or pipeline_ir_live_set_contains(needed, dst) != 1 { 0 }
      else { if pipeline_ir_fresh_return_allocator_hash(hash) == 1 or cg_semantic_fact_fresh_managed_return(fact) != 1 { 0 } else { 1 } }
      let head = if eligible == 1 { pipeline_ir_consuming_expand_call(inst, source, next_value, facts, functions) }
        else { PipelineIrConsumingCloneOk(IrInstCons(inst, IrInstNil), next_value) }
      match head {
        PipelineIrConsumingCloneInvalid -> PipelineIrConsumingCloneInvalid
        PipelineIrConsumingCloneOk(head_insts, head_next) -> match pipeline_ir_consuming_rewrite_block_insts(rest, needed, source, facts, functions, head_next) {
          PipelineIrConsumingCloneInvalid -> PipelineIrConsumingCloneInvalid
          PipelineIrConsumingCloneOk(tail_insts, tail_next) -> PipelineIrConsumingCloneOk(ir_inst_list_append(head_insts, tail_insts), tail_next)
        }
      }
    }
  }
}

pub(package) fn pipeline_ir_consuming_rewrite_blocks(blocks: IrBlockList, needed: PipelineIrLiveSet, source: i64, facts: PipelineIrSemanticFactList, functions: IrFunctionList, next_value: i64) -> PipelineIrConsumingBlockResult {
  match blocks {
    IrBlockListNil -> PipelineIrConsumingBlocksOk(IrBlockListNil, next_value)
    IrBlockListCons(block, rest) -> match block {
      IrBlock(id, params, insts, term) -> {
        match pipeline_ir_consuming_rewrite_block_insts(insts, needed, source, facts, functions, next_value) {
          PipelineIrConsumingCloneInvalid -> PipelineIrConsumingBlocksInvalid
          PipelineIrConsumingCloneOk(rewritten, rewritten_next) -> {
            let root_count = pipeline_ir_consuming_raw_root_count(rewritten, needed)
            let rooted = if root_count == 0 { PipelineIrConsumingCloneOk(rewritten, rewritten_next) }
              else { if root_count == 1 { pipeline_ir_consuming_rewrite_raw_root(rewritten, needed, source, rewritten_next) }
              else { PipelineIrConsumingCloneInvalid } }
            match rooted {
              PipelineIrConsumingCloneInvalid -> PipelineIrConsumingBlocksInvalid
              PipelineIrConsumingCloneOk(rooted_insts, rooted_next) -> match pipeline_ir_consuming_rewrite_blocks(rest, needed, source, facts, functions, rooted_next) {
                PipelineIrConsumingBlocksInvalid -> PipelineIrConsumingBlocksInvalid
                PipelineIrConsumingBlocksOk(rest_blocks, final_next) -> PipelineIrConsumingBlocksOk(IrBlockListCons(IrBlock(id, params, rooted_insts, term), rest_blocks), final_next)
              }
            }
          }
        }
      }
    }
  }
}

pub(package) fn pipeline_ir_consuming_logical_param_for_lane_insts(insts: IrInstList, param_count: i64, arg_lane: i64, logical_index: i64) -> i64 {
  match insts {
    IrInstNil -> 0 - 1
    IrInstCons(inst, rest) -> match inst {
      IrBindI64(ns, nl, head, ty) -> {
        if head >= 0 and head < param_count {
          let lanes = pipeline_type_value_lane_count_or_one(ty)
          if arg_lane >= head and arg_lane < head + lanes { logical_index }
          else { pipeline_ir_consuming_logical_param_for_lane_insts(rest, param_count, arg_lane, logical_index + 1) }
        } else { pipeline_ir_consuming_logical_param_for_lane_insts(rest, param_count, arg_lane, logical_index) }
      }
      _ -> pipeline_ir_consuming_logical_param_for_lane_insts(rest, param_count, arg_lane, logical_index)
    }
  }
}

pub(package) fn pipeline_ir_consuming_clear_borrow_marker_insts(insts: IrInstList, logical_index: i64) -> IrInstList {
  match insts {
    IrInstNil -> IrInstNil
    IrInstCons(inst, rest) -> match inst {
      IrSlotI64(slot) -> {
        if pipeline_ir_borrowed_param_mask_slot_is(slot) == 1 {
          let mask = pipeline_ir_borrowed_param_mask_slot_decode(slot)
          let next_mask = mask band (cg_bit(logical_index) bxor (0 - 1))
          if next_mask == 0 { pipeline_ir_consuming_clear_borrow_marker_insts(rest, logical_index) }
          else { IrInstCons(IrSlotI64(pipeline_ir_borrowed_param_mask_slot(next_mask)), pipeline_ir_consuming_clear_borrow_marker_insts(rest, logical_index)) }
        } else { IrInstCons(inst, pipeline_ir_consuming_clear_borrow_marker_insts(rest, logical_index)) }
      }
      _ -> IrInstCons(inst, pipeline_ir_consuming_clear_borrow_marker_insts(rest, logical_index))
    }
  }
}

pub(package) fn pipeline_ir_consuming_clear_borrow_marker_blocks(blocks: IrBlockList, logical_index: i64, entry: i64) -> IrBlockList {
  match blocks {
    IrBlockListNil -> IrBlockListNil
    IrBlockListCons(block, rest) -> match block {
      IrBlock(id, params, insts, term) -> {
        let next_insts = if id == entry { pipeline_ir_consuming_clear_borrow_marker_insts(insts, logical_index) } else { insts }
        IrBlockListCons(IrBlock(id, params, next_insts, term), pipeline_ir_consuming_clear_borrow_marker_blocks(rest, logical_index, entry))
      }
    }
  }
}

pub(package) fn pipeline_ir_consuming_block_has_drop(insts: IrInstList, source: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> match inst {
      IrCallI64(dst, callee_hash, args) -> {
        if callee_hash == pipeline_ir_reuse_drop_hash() and ir_value_list_nth_or(args, 0, 0 - 1) == source { 1 }
        else { pipeline_ir_consuming_block_has_drop(rest, source) }
      }
      _ -> pipeline_ir_consuming_block_has_drop(rest, source)
    }
  }
}

pub(package) fn pipeline_ir_consuming_abort_edge_count(insts: IrInstList, target: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let add = match inst {
        IrHandleI64(dst, handle_src, effect_hash, clauses, nclauses, abort_block) -> if abort_block == target { 1 } else { 0 }
        _ -> 0
      }
      add + pipeline_ir_consuming_abort_edge_count(rest, target)
    }
  }
}

-- Positive means at least one reachable predecessor and all predecessor-out
-- facts are true; negative records a failing predecessor.
pub(package) fn pipeline_ir_consuming_predecessor_state(blocks: IrBlockList, target: i64, out: i64, reachable: PipelineIrLiveSet, state: i64) -> i64 {
  match blocks {
    IrBlockListNil -> state
    IrBlockListCons(block, rest) -> match block {
      IrBlock(id, params, insts, term) -> {
        let edges = pipeline_ir_term_predecessor_count(term, target) + pipeline_ir_consuming_abort_edge_count(insts, target)
        let next = if edges == 0 or pipeline_ir_live_set_contains(reachable, id) != 1 { state }
        else { if state < 0 or mem_load64_at(out, id * 8) != 1 { 0 - (if state < 0 { 0 - state } else { state }) - edges }
        else { state + edges } }
        pipeline_ir_consuming_predecessor_state(rest, target, out, reachable, next)
      }
    }
  }
}

pub(package) fn pipeline_ir_consuming_must_step(blocks: IrBlockList, all_blocks: IrBlockList, entry: i64, source: i64, reachable: PipelineIrLiveSet, out: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> match block {
      IrBlock(id, params, insts, term) -> {
        let next = if pipeline_ir_live_set_contains(reachable, id) != 1 { 0 }
        else { if pipeline_ir_consuming_block_has_drop(insts, source) == 1 { 1 }
        else { if id == entry { 0 }
        else { if pipeline_ir_consuming_predecessor_state(all_blocks, id, out, reachable, 0) > 0 { 1 } else { 0 } } } }
        let changed = if mem_load64_at(out, id * 8) == next { 0 } else { mem_store64_at(out, id * 8, next) 1 }
        changed bor pipeline_ir_consuming_must_step(rest, all_blocks, entry, source, reachable, out)
      }
    }
  }
}

pub(package) fn pipeline_ir_consuming_seed_must_out(blocks: IrBlockList, entry: i64, source: i64, reachable: PipelineIrLiveSet, out: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> match block {
      IrBlock(id, params, insts, term) -> {
        if pipeline_ir_live_set_contains(reachable, id) == 1 {
          mem_store64_at(out, id * 8, if id == entry { pipeline_ir_consuming_block_has_drop(insts, source) } else { 1 })
        } else { 0 }
        pipeline_ir_consuming_seed_must_out(rest, entry, source, reachable, out)
      }
    }
  }
}

pub(package) fn pipeline_ir_consuming_returns_must_drop(blocks: IrBlockList, reachable: PipelineIrLiveSet, out: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 1
    IrBlockListCons(block, rest) -> match block {
      IrBlock(id, params, insts, term) -> {
        let ok = if pipeline_ir_live_set_contains(reachable, id) != 1 { 1 }
        else { match term { IrTermReturn(value) -> mem_load64_at(out, id * 8) _ -> 1 } }
        if ok != 1 { 0 } else { pipeline_ir_consuming_returns_must_drop(rest, reachable, out) }
      }
    }
  }
}

pub(package) fn pipeline_ir_consuming_function_must_drop(blocks: IrBlockList, source: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(first, rest) -> match first {
      IrBlock(entry, params, insts, term) -> {
        let max_id = pipeline_ir_verify_max_block_id(blocks)
        let reachable = pipeline_ir_reachable_fixpoint(blocks, pipeline_ir_reachable_seed(blocks))
        let out = alloc_zeroed((max_id + 1) * 8)
        pipeline_ir_consuming_seed_must_out(blocks, entry, source, reachable, out)
        let mut changed = 1
        let mut rounds = 0
        while changed == 1 and rounds <= max_id + 2 {
          changed = pipeline_ir_consuming_must_step(blocks, blocks, entry, source, reachable, out)
          rounds = rounds + 1
        }
        pipeline_ir_consuming_returns_must_drop(blocks, reachable, out)
      }
    }
  }
}

pub(package) fn pipeline_ir_consuming_clone_function(base: IrFunction, clone_hash: i64, arg_lane: i64, facts: PipelineIrSemanticFactList, functions: IrFunctionList) -> IrFunctionList {
  match base {
    IrFunction(base_hash, param_count, blocks, src) -> {
      if pipeline_ir_consuming_function_lane_mode(base, param_count, arg_lane, continuation_cleanup_kind_rc()) != 2 { IrFunctionNil }
      else { match blocks {
        IrBlockListNil -> IrFunctionNil
        IrBlockListCons(entry_block, rest) -> match entry_block {
          IrBlock(entry, params, insts, term) -> {
            let logical_index = pipeline_ir_consuming_logical_param_for_lane_insts(insts, param_count, arg_lane, 0)
            if logical_index < 0 { IrFunctionNil }
            else {
              let next_value = pipeline_ir_function_next_value(param_count, blocks)
              let needed = pipeline_ir_consuming_needed_values(blocks, facts, next_value)
              match pipeline_ir_consuming_rewrite_blocks(blocks, needed, arg_lane, facts, functions, next_value) {
                PipelineIrConsumingBlocksInvalid -> IrFunctionNil
                PipelineIrConsumingBlocksOk(rewritten, next) -> {
                  let owned_blocks = pipeline_ir_consuming_clear_borrow_marker_blocks(rewritten, logical_index, entry)
                  if pipeline_ir_consuming_function_must_drop(owned_blocks, arg_lane) != 1 { IrFunctionNil }
                  else { IrFunctionCons(IrFunction(clone_hash, param_count, owned_blocks, src), IrFunctionNil) }
                }
              }
            }
          }
        }
      } }
    }
  }
}

pub(package) fn pipeline_ir_consuming_build_clones(requests: i64, index: i64, functions: IrFunctionList, facts: PipelineIrSemanticFactList) -> IrFunctionList {
  if index >= nlist_len(requests) { IrFunctionNil }
  else {
    let request = nlist_get(requests, index)
    let clone = match pipeline_ir_function_list_find_hash(functions, node_f1(request)) {
      IrFunctionCons(base, IrFunctionNil) -> pipeline_ir_consuming_clone_function(base, node_f2(request), node_f3(request), facts, functions)
      _ -> IrFunctionNil
    }
    pipeline_ir_function_list_append(clone, pipeline_ir_consuming_build_clones(requests, index + 1, functions, facts))
  }
}

pub(package) fn pipeline_ir_consuming_facts_extend(requests: i64, index: i64, valid_clones: IrFunctionList, base_facts: PipelineIrSemanticFactList, facts: PipelineIrSemanticFactList) -> PipelineIrSemanticFactList {
  if index >= nlist_len(requests) { facts }
  else {
    let request = nlist_get(requests, index)
    let clone_hash = node_f2(request)
    let next = if pipeline_ir_identity_function_hash_exists(valid_clones, clone_hash) != 1 { facts }
    else {
      let base_hash = node_f1(request)
      let fact = pipeline_ir_semantic_fact_find(base_facts, base_hash)
      if fact == 0 { facts }
      else { pipeline_ir_semantic_facts_prepend_with_borrow(clone_hash, fact, pipeline_ir_semantic_borrow_fact_find(base_facts, base_hash), facts) }
    }
    pipeline_ir_consuming_facts_extend(requests, index + 1, valid_clones, base_facts, next)
  }
}

pub(package) fn pipeline_ir_consuming_rewrite_call(inst: IrInst, clone_hash: i64) -> IrInst {
  match inst {
    IrCallI64(dst, callee_hash, args) -> IrCallI64(dst, clone_hash, args)
    IrGenericCallI64(dst, callee_hash, type_args, args) -> IrCallI64(dst, clone_hash, args)
    _ -> inst
  }
}

pub(package) fn pipeline_ir_consuming_rewrite_insts(insts: IrInstList, term: IrTerminator, facts: PipelineIrSemanticFactList, candidates: PipelineIrInlineCandidateList, requests: i64, valid_clones: IrFunctionList) -> IrInstList {
  match insts {
    IrInstNil -> IrInstNil
    IrInstCons(inst, rest) -> {
      let lane = pipeline_ir_consuming_candidate_lane(inst, rest, term, facts, candidates)
      let base_hash = pipeline_ir_ownership_transfer_call_hash(inst)
      let clone_hash = if lane < 0 { 0 } else { pipeline_ir_consuming_request_lookup(requests, base_hash, lane) }
      if clone_hash != 0 and pipeline_ir_identity_function_hash_exists(valid_clones, clone_hash) == 1 {
        let args = pipeline_ir_ownership_transfer_call_args(inst)
        let source = ir_value_list_nth_or(args, lane, 0 - 1)
        let dst = pipeline_ir_ownership_transfer_call_dst_or(inst, 0 - 1)
        let marker = IrManagedTransferI64(dst, clone_hash, source, lane, continuation_cleanup_kind_rc())
        let call = pipeline_ir_consuming_rewrite_call(inst, clone_hash)
        let tail = pipeline_ir_ownership_transfer_remove_release(rest, source, continuation_cleanup_kind_rc())
        IrInstCons(marker, IrInstCons(call, pipeline_ir_consuming_rewrite_insts(tail, term, facts, candidates, requests, valid_clones)))
      } else {
        IrInstCons(inst, pipeline_ir_consuming_rewrite_insts(rest, term, facts, candidates, requests, valid_clones))
      }
    }
  }
}

pub(package) fn pipeline_ir_consuming_rewrite_blocks_final(blocks: IrBlockList, facts: PipelineIrSemanticFactList, candidates: PipelineIrInlineCandidateList, requests: i64, valid_clones: IrFunctionList) -> IrBlockList {
  match blocks {
    IrBlockListNil -> IrBlockListNil
    IrBlockListCons(block, rest) -> match block {
      IrBlock(id, params, insts, term) -> IrBlockListCons(
        IrBlock(id, params, pipeline_ir_consuming_rewrite_insts(insts, term, facts, candidates, requests, valid_clones), term),
        pipeline_ir_consuming_rewrite_blocks_final(rest, facts, candidates, requests, valid_clones)
      )
    }
  }
}

pub(package) fn pipeline_ir_consuming_rewrite_functions(functions: IrFunctionList, facts: PipelineIrSemanticFactList, candidates: PipelineIrInlineCandidateList, requests: i64, valid_clones: IrFunctionList) -> IrFunctionList {
  match functions {
    IrFunctionNil -> IrFunctionNil
    IrFunctionCons(function, rest) -> match function {
      IrFunction(hash, param_count, blocks, src) -> IrFunctionCons(
        IrFunction(hash, param_count, pipeline_ir_consuming_rewrite_blocks_final(blocks, facts, candidates, requests, valid_clones), src),
        pipeline_ir_consuming_rewrite_functions(rest, facts, candidates, requests, valid_clones)
      )
    }
  }
}

pub(package) fn pipeline_ir_consuming_specialisations_functions(result: PipelineIrConsumingSpecialisations) -> IrFunctionList {
  match result { PipelineIrConsumingSpecialisations(functions, facts, count) -> functions }
}

pub(package) fn pipeline_ir_consuming_specialisations_facts(result: PipelineIrConsumingSpecialisations) -> PipelineIrSemanticFactList {
  match result { PipelineIrConsumingSpecialisations(functions, facts, count) -> facts }
}

pub(package) fn pipeline_ir_consuming_specialisations_count(result: PipelineIrConsumingSpecialisations) -> i64 {
  match result { PipelineIrConsumingSpecialisations(functions, facts, count) -> count }
}

pub(package) fn pipeline_ir_consuming_specialise(functions: IrFunctionList, canonical_functions: IrFunctionList, facts: PipelineIrSemanticFactList, typed_fns: i64, src: i64, tt: i64) -> PipelineIrConsumingSpecialisations {
  let requests = nlist_new()
  let candidates = pipeline_ir_consuming_function_candidates(functions, facts)
  pipeline_ir_consuming_discover_functions(functions, functions, facts, candidates, requests)
  if nlist_len(requests) == 0 { PipelineIrConsumingSpecialisations(functions, facts, 0) }
  else {
    let raw_clones = pipeline_ir_consuming_build_clones(requests, 0, canonical_functions, facts)
    if ir_function_list_len(raw_clones) == 0 { PipelineIrConsumingSpecialisations(functions, facts, 0) }
    else {
      let clone_facts = pipeline_ir_consuming_facts_extend(requests, 0, raw_clones, facts, facts)
      let clone_universe = pipeline_ir_function_list_append(canonical_functions, raw_clones)
      let clone_opt = pipeline_optimise_ir_function_list(raw_clones, clone_universe, clone_facts, src, tt)
      let optimised_clones = pipeline_mem2reg_retighten_function_list(
        pipeline_mem2reg_function_list(pipeline_optimised_functions_functions(clone_opt)),
        clone_facts,
        pipeline_ir_pure_callee_tree(clone_facts)
      )
      let rewritten = pipeline_ir_consuming_rewrite_functions(functions, facts, candidates, requests, optimised_clones)
      let combined = pipeline_ir_function_list_append(rewritten, optimised_clones)
      let enriched_facts = pipeline_ir_semantic_borrow_values_enrich_functions(clone_facts, combined, typed_fns, tt)
      PipelineIrConsumingSpecialisations(combined, enriched_facts, ir_function_list_len(optimised_clones))
    }
  }
}

pub(package) fn pipeline_ir_reuse_functions(functions: IrFunctionList) -> IrFunctionList {
  match functions {
    IrFunctionNil -> IrFunctionNil
    IrFunctionCons(function, rest) -> {
      let rewritten = match function {
        IrFunction(hash, params, blocks, src) -> IrFunction(hash, params, pipeline_ir_reuse_blocks(blocks), src)
      }
      IrFunctionCons(rewritten, pipeline_ir_reuse_functions(rest))
    }
    _ -> functions
  }
}

pub(package) type PipelineIrTraversalCall {
  PipelineIrTraversalCallMissing,
  PipelineIrTraversalCallFound(IrInst, i64, PipelineIrTraversalRole, IrValueList)
}

pub(package) type PipelineIrTraversalFusion {
  PipelineIrTraversalFusionInvalid,
  -- range/map/filter/take/fold destinations, scalar inputs and callbacks,
  -- then the fact-selected implementation target.
  PipelineIrTraversalFusionFound(i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64)
}

pub(package) type PipelineIrTraversalFusionList {
  PipelineIrTraversalFusionNil,
  PipelineIrTraversalFusionCons(PipelineIrTraversalFusion, PipelineIrTraversalFusionList)
}

pub(package) fn pipeline_ir_traversal_inst_call(inst: IrInst, facts: PipelineIrSemanticFactList) -> PipelineIrTraversalCall {
  match inst {
    IrCallI64(dst, callee_hash, args) -> {
      let role = pipeline_ir_semantic_fact_lookup_traversal_role(facts, callee_hash)
      match role {
        PipelineIrTraversalNone -> PipelineIrTraversalCallMissing
        _ -> PipelineIrTraversalCallFound(inst, dst, role, args)
      }
    }
    IrGenericCallI64(dst, callee_hash, type_args, args) -> {
      let role = pipeline_ir_semantic_fact_lookup_traversal_role(facts, callee_hash)
      match role {
        PipelineIrTraversalNone -> PipelineIrTraversalCallMissing
        _ -> PipelineIrTraversalCallFound(inst, dst, role, args)
      }
    }
    _ -> PipelineIrTraversalCallMissing
  }
}

pub(package) fn pipeline_ir_traversal_call_for_value(insts: IrInstList, value: i64, facts: PipelineIrSemanticFactList) -> PipelineIrTraversalCall {
  match insts {
    IrInstNil -> PipelineIrTraversalCallMissing
    IrInstCons(inst, rest) -> {
      let call = pipeline_ir_traversal_inst_call(inst, facts)
      match call {
        PipelineIrTraversalCallMissing -> pipeline_ir_traversal_call_for_value(rest, value, facts)
        PipelineIrTraversalCallFound(found_inst, dst, role, args) -> {
          if dst == value { call } else { pipeline_ir_traversal_call_for_value(rest, value, facts) }
        }
      }
    }
  }
}

pub(package) fn pipeline_ir_traversal_count_same(left: PipelineIrTraversalExtent, right: PipelineIrTraversalExtent) -> i64 {
  match left {
    PipelineIrTraversalCountUnknown -> match right { PipelineIrTraversalCountUnknown -> 1 _ -> 0 }
    PipelineIrTraversalCountZero -> match right { PipelineIrTraversalCountZero -> 1 _ -> 0 }
    PipelineIrTraversalCountOne -> match right { PipelineIrTraversalCountOne -> 1 _ -> 0 }
    PipelineIrTraversalCountArgument(left_value) -> match right {
      PipelineIrTraversalCountArgument(right_value) -> if left_value == right_value { 1 } else { 0 }
      _ -> 0
    }
    PipelineIrTraversalCountRange(left_start, left_end) -> match right {
      PipelineIrTraversalCountRange(right_start, right_end) -> if left_start == right_start and left_end == right_end { 1 } else { 0 }
      _ -> 0
    }
    PipelineIrTraversalCountMin(left_first, left_second) -> match right {
      PipelineIrTraversalCountMin(right_first, right_second) -> {
        if pipeline_ir_traversal_count_same(left_first, right_first) == 1 and
           pipeline_ir_traversal_count_same(left_second, right_second) == 1 { 1 } else { 0 }
      }
      _ -> 0
    }
    PipelineIrTraversalCountSum(left_first, left_second) -> match right {
      PipelineIrTraversalCountSum(right_first, right_second) -> {
        if pipeline_ir_traversal_count_same(left_first, right_first) == 1 and
           pipeline_ir_traversal_count_same(left_second, right_second) == 1 { 1 } else { 0 }
      }
      _ -> 0
    }
    PipelineIrTraversalCountSaturatingSubtract(left_first, left_second) -> match right {
      PipelineIrTraversalCountSaturatingSubtract(right_first, right_second) -> {
        if pipeline_ir_traversal_count_same(left_first, right_first) == 1 and
           pipeline_ir_traversal_count_same(left_second, right_second) == 1 { 1 } else { 0 }
      }
      _ -> 0
    }
  }
}

pub(package) fn pipeline_ir_traversal_count_is_unknown(count: PipelineIrTraversalExtent) -> i64 {
  match count { PipelineIrTraversalCountUnknown -> 1 _ -> 0 }
}

pub(package) fn pipeline_ir_traversal_count_is_zero(count: PipelineIrTraversalExtent) -> i64 {
  match count { PipelineIrTraversalCountZero -> 1 _ -> 0 }
}

pub(package) fn pipeline_ir_traversal_count_min(left: PipelineIrTraversalExtent, right: PipelineIrTraversalExtent) -> PipelineIrTraversalExtent {
  if pipeline_ir_traversal_count_is_unknown(left) == 1 { right }
  else { if pipeline_ir_traversal_count_is_unknown(right) == 1 { left }
  else { if pipeline_ir_traversal_count_is_zero(left) == 1 or pipeline_ir_traversal_count_is_zero(right) == 1 { PipelineIrTraversalCountZero }
  else { if pipeline_ir_traversal_count_same(left, right) == 1 { left }
  else { PipelineIrTraversalCountMin(left, right) } } } }
}

pub(package) fn pipeline_ir_traversal_count_sum(left: PipelineIrTraversalExtent, right: PipelineIrTraversalExtent) -> PipelineIrTraversalExtent {
  if pipeline_ir_traversal_count_is_unknown(left) == 1 or pipeline_ir_traversal_count_is_unknown(right) == 1 { PipelineIrTraversalCountUnknown }
  else { if pipeline_ir_traversal_count_is_zero(left) == 1 { right }
  else { if pipeline_ir_traversal_count_is_zero(right) == 1 { left }
  else { PipelineIrTraversalCountSum(left, right) } } }
}

pub(package) fn pipeline_ir_traversal_count_subtract(left: PipelineIrTraversalExtent, right: PipelineIrTraversalExtent) -> PipelineIrTraversalExtent {
  if pipeline_ir_traversal_count_is_unknown(left) == 1 { PipelineIrTraversalCountUnknown }
  else { if pipeline_ir_traversal_count_is_zero(left) == 1 { PipelineIrTraversalCountZero }
  else { if pipeline_ir_traversal_count_is_zero(right) == 1 { left }
  else { PipelineIrTraversalCountSaturatingSubtract(left, right) } } }
}

pub(package) fn pipeline_ir_traversal_bounds_unknown() -> PipelineIrTraversalBounds {
  PipelineIrTraversalBounds(PipelineIrTraversalCountZero, PipelineIrTraversalCountUnknown)
}

pub(package) fn pipeline_ir_traversal_bounds_exact(count: PipelineIrTraversalExtent) -> PipelineIrTraversalBounds {
  PipelineIrTraversalBounds(count, count)
}

pub(package) fn pipeline_ir_traversal_bounds_lower(bounds: PipelineIrTraversalBounds) -> PipelineIrTraversalExtent {
  match bounds { PipelineIrTraversalBounds(lower, upper) -> lower }
}

pub(package) fn pipeline_ir_traversal_bounds_upper(bounds: PipelineIrTraversalBounds) -> PipelineIrTraversalExtent {
  match bounds { PipelineIrTraversalBounds(lower, upper) -> upper }
}

pub(package) fn pipeline_ir_traversal_bounds_at_most(bounds: PipelineIrTraversalBounds) -> PipelineIrTraversalBounds {
  PipelineIrTraversalBounds(PipelineIrTraversalCountZero, pipeline_ir_traversal_bounds_upper(bounds))
}

pub(package) fn pipeline_ir_traversal_bounds_cap(bounds: PipelineIrTraversalBounds, limit: PipelineIrTraversalExtent) -> PipelineIrTraversalBounds {
  PipelineIrTraversalBounds(
    pipeline_ir_traversal_count_min(pipeline_ir_traversal_bounds_lower(bounds), limit),
    pipeline_ir_traversal_count_min(pipeline_ir_traversal_bounds_upper(bounds), limit)
  )
}

pub(package) fn pipeline_ir_traversal_bounds_skip(bounds: PipelineIrTraversalBounds, count: PipelineIrTraversalExtent) -> PipelineIrTraversalBounds {
  PipelineIrTraversalBounds(
    pipeline_ir_traversal_count_subtract(pipeline_ir_traversal_bounds_lower(bounds), count),
    pipeline_ir_traversal_count_subtract(pipeline_ir_traversal_bounds_upper(bounds), count)
  )
}

pub(package) fn pipeline_ir_traversal_bounds_sum(left: PipelineIrTraversalBounds, right: PipelineIrTraversalBounds) -> PipelineIrTraversalBounds {
  PipelineIrTraversalBounds(
    pipeline_ir_traversal_count_sum(pipeline_ir_traversal_bounds_lower(left), pipeline_ir_traversal_bounds_lower(right)),
    pipeline_ir_traversal_count_sum(pipeline_ir_traversal_bounds_upper(left), pipeline_ir_traversal_bounds_upper(right))
  )
}

pub(package) fn pipeline_ir_traversal_bounds_min(left: PipelineIrTraversalBounds, right: PipelineIrTraversalBounds) -> PipelineIrTraversalBounds {
  PipelineIrTraversalBounds(
    pipeline_ir_traversal_count_min(pipeline_ir_traversal_bounds_lower(left), pipeline_ir_traversal_bounds_lower(right)),
    pipeline_ir_traversal_count_min(pipeline_ir_traversal_bounds_upper(left), pipeline_ir_traversal_bounds_upper(right))
  )
}

-- Compose the declaration-produced traversal roles over one SSA block. The
-- budget fails closed for malformed or unexpectedly cyclic IR. Ownership
-- aliases are deliberately not guessed here; the producer value must be the
-- exact argument selected by checked lowering.
pub(package) fn pipeline_ir_traversal_bounds_for_value_with_budget(
  insts: IrInstList,
  value: i64,
  facts: PipelineIrSemanticFactList,
  budget: i64
) -> PipelineIrTraversalBounds {
  if budget <= 0 { pipeline_ir_traversal_bounds_unknown() }
  else {
    match pipeline_ir_traversal_call_for_value(insts, value, facts) {
      PipelineIrTraversalCallMissing -> pipeline_ir_traversal_bounds_unknown()
      PipelineIrTraversalCallFound(inst, dst, role, args) -> {
        let first_value = ir_value_list_nth_or(args, 0, 0 - 1)
        let second_value = ir_value_list_nth_or(args, 1, 0 - 1)
        match pipeline_ir_traversal_cardinality(role) {
          PipelineIrTraversalCardinalityUnknown -> pipeline_ir_traversal_bounds_unknown()
          PipelineIrTraversalCardinalityRangeArguments(start_index, end_index) -> pipeline_ir_traversal_bounds_exact(
            PipelineIrTraversalCountRange(
              ir_value_list_nth_or(args, start_index, 0 - 1),
              ir_value_list_nth_or(args, end_index, 0 - 1)
            )
          )
          PipelineIrTraversalCardinalityExactZero -> pipeline_ir_traversal_bounds_exact(PipelineIrTraversalCountZero)
          PipelineIrTraversalCardinalityExactOne -> pipeline_ir_traversal_bounds_exact(PipelineIrTraversalCountOne)
          PipelineIrTraversalCardinalityPreservesInput -> pipeline_ir_traversal_bounds_for_value_with_budget(insts, first_value, facts, budget - 1)
          PipelineIrTraversalCardinalityAtMostInput -> pipeline_ir_traversal_bounds_at_most(
            pipeline_ir_traversal_bounds_for_value_with_budget(insts, first_value, facts, budget - 1)
          )
          PipelineIrTraversalCardinalityFlatMapInput -> {
            let input_bounds = pipeline_ir_traversal_bounds_for_value_with_budget(insts, first_value, facts, budget - 1)
            match pipeline_ir_traversal_bounds_upper(input_bounds) {
              PipelineIrTraversalCountZero -> pipeline_ir_traversal_bounds_exact(PipelineIrTraversalCountZero)
              _ -> pipeline_ir_traversal_bounds_unknown()
            }
          }
          PipelineIrTraversalCardinalityCapByArgument(index) -> pipeline_ir_traversal_bounds_cap(
            pipeline_ir_traversal_bounds_for_value_with_budget(insts, first_value, facts, budget - 1),
            PipelineIrTraversalCountArgument(ir_value_list_nth_or(args, index, 0 - 1))
          )
          PipelineIrTraversalCardinalitySkipByArgument(index) -> pipeline_ir_traversal_bounds_skip(
            pipeline_ir_traversal_bounds_for_value_with_budget(insts, first_value, facts, budget - 1),
            PipelineIrTraversalCountArgument(ir_value_list_nth_or(args, index, 0 - 1))
          )
          PipelineIrTraversalCardinalitySumInputs -> pipeline_ir_traversal_bounds_sum(
            pipeline_ir_traversal_bounds_for_value_with_budget(insts, first_value, facts, budget - 1),
            pipeline_ir_traversal_bounds_for_value_with_budget(insts, second_value, facts, budget - 1)
          )
          PipelineIrTraversalCardinalityMinInputs -> pipeline_ir_traversal_bounds_min(
            pipeline_ir_traversal_bounds_for_value_with_budget(insts, first_value, facts, budget - 1),
            pipeline_ir_traversal_bounds_for_value_with_budget(insts, second_value, facts, budget - 1)
          )
          PipelineIrTraversalCardinalityNoIteratorResult -> pipeline_ir_traversal_bounds_unknown()
        }
      }
    }
  }
}

pub(package) fn pipeline_ir_traversal_bounds_for_value(insts: IrInstList, value: i64, facts: PipelineIrSemanticFactList) -> PipelineIrTraversalBounds {
  pipeline_ir_traversal_bounds_for_value_with_budget(insts, value, facts, 64)
}

pub(package) fn pipeline_ir_traversal_allocation(bounds: PipelineIrTraversalBounds) -> PipelineIrTraversalAllocation {
  let lower = pipeline_ir_traversal_bounds_lower(bounds)
  let upper = pipeline_ir_traversal_bounds_upper(bounds)
  if pipeline_ir_traversal_count_same(lower, upper) == 1 { PipelineIrTraversalAllocationExact(lower) }
  else { if pipeline_ir_traversal_count_is_zero(lower) == 1 { PipelineIrTraversalAllocationNone }
  else { PipelineIrTraversalAllocationReserveLower(lower) } }
}

pub(package) fn pipeline_ir_traversal_count_sum_fits(left: i64, right: i64) -> i64 {
  if left < 0 or right < 0 { 0 }
  else { if left > 9223372036854775807 - right { 0 } else { 1 } }
}

pub(package) fn pipeline_ir_traversal_range_count_fits(start: i64, end: i64) -> i64 {
  if end <= start or start >= 0 { 1 }
  else {
    let largest_safe_end = start + 9223372036854775807
    if end > largest_safe_end { 0 } else { 1 }
  }
}

pub(package) fn pipeline_ir_traversal_range_count(start: i64, end: i64) -> i64 {
  if end <= start { 0 }
  else { if start >= 0 { end - start }
  else {
    let largest_safe_end = start + 9223372036854775807
    if end > largest_safe_end { 0 } else { end - start }
  } }
}

pub(package) fn pipeline_ir_traversal_count_eval(insts: IrInstList, count: PipelineIrTraversalExtent) -> PipelineIrConstLookup {
  match count {
    PipelineIrTraversalCountUnknown -> pipeline_ir_const_lookup(0, 0)
    PipelineIrTraversalCountZero -> pipeline_ir_const_lookup(1, 0)
    PipelineIrTraversalCountOne -> pipeline_ir_const_lookup(1, 1)
    PipelineIrTraversalCountArgument(value) -> {
      let found = pipeline_ir_inst_list_const_def_lookup(insts, value)
      if pipeline_ir_const_lookup_valid(found) == 1 and pipeline_ir_const_lookup_value(found) >= 0 { found }
      else { pipeline_ir_const_lookup(0, 0) }
    }
    PipelineIrTraversalCountRange(start, end) -> {
      let found_start = pipeline_ir_inst_list_const_def_lookup(insts, start)
      let found_end = pipeline_ir_inst_list_const_def_lookup(insts, end)
      if pipeline_ir_const_lookup_valid(found_start) == 1 and pipeline_ir_const_lookup_valid(found_end) == 1 and
         pipeline_ir_traversal_range_count_fits(pipeline_ir_const_lookup_value(found_start), pipeline_ir_const_lookup_value(found_end)) == 1 {
        pipeline_ir_const_lookup(1, pipeline_ir_traversal_range_count(pipeline_ir_const_lookup_value(found_start), pipeline_ir_const_lookup_value(found_end)))
      } else { pipeline_ir_const_lookup(0, 0) }
    }
    PipelineIrTraversalCountMin(left, right) -> {
      let found_left = pipeline_ir_traversal_count_eval(insts, left)
      let found_right = pipeline_ir_traversal_count_eval(insts, right)
      if pipeline_ir_const_lookup_valid(found_left) == 1 and pipeline_ir_const_lookup_valid(found_right) == 1 {
        let left_value = pipeline_ir_const_lookup_value(found_left)
        let right_value = pipeline_ir_const_lookup_value(found_right)
        pipeline_ir_const_lookup(1, if left_value < right_value { left_value } else { right_value })
      } else { pipeline_ir_const_lookup(0, 0) }
    }
    PipelineIrTraversalCountSum(left, right) -> {
      let found_left = pipeline_ir_traversal_count_eval(insts, left)
      let found_right = pipeline_ir_traversal_count_eval(insts, right)
      if pipeline_ir_const_lookup_valid(found_left) == 1 and pipeline_ir_const_lookup_valid(found_right) == 1 and
         pipeline_ir_traversal_count_sum_fits(pipeline_ir_const_lookup_value(found_left), pipeline_ir_const_lookup_value(found_right)) == 1 {
        pipeline_ir_const_lookup(1, pipeline_ir_const_lookup_value(found_left) + pipeline_ir_const_lookup_value(found_right))
      } else { pipeline_ir_const_lookup(0, 0) }
    }
    PipelineIrTraversalCountSaturatingSubtract(left, right) -> {
      let found_left = pipeline_ir_traversal_count_eval(insts, left)
      let found_right = pipeline_ir_traversal_count_eval(insts, right)
      if pipeline_ir_const_lookup_valid(found_left) == 1 and pipeline_ir_const_lookup_valid(found_right) == 1 {
        let left_value = pipeline_ir_const_lookup_value(found_left)
        let right_value = pipeline_ir_const_lookup_value(found_right)
        pipeline_ir_const_lookup(1, if right_value >= left_value { 0 } else { left_value - right_value })
      } else { pipeline_ir_const_lookup(0, 0) }
    }
  }
}

pub(package) fn pipeline_ir_traversal_generic_i64_args(inst: IrInst, count: i64) -> i64 {
  match inst {
    IrGenericCallI64(dst, callee_hash, type_args, args) -> {
      if type_expr_list_len(type_args) != count { 0 }
      else {
        let mut valid = 1
        for i in 0..count {
          let arg_ty = type_expr_to_node(type_expr_list_nth(type_args, i))
          let scalar_i64 = ty_tag(arg_ty) == 2 and ty_f1(arg_ty) == PRIM_I64()
          let source_i64 = if i != 0 or not ty_is_owned(arg_ty) { false }
            else {
              let source = ty_f1(arg_ty)
              let source_args = if ty_tag(source) == 9 { ty_f3(source) } else { 0 }
              ty_tag(source) == 9 and ty_named_is_opaque(source) and
                typeck_decl_identity_is(ty_named_opaque_declaration(source), "stdlib/iter/protocol", "Iterator") == 1 and
                source_args != 0 and nlist_len(source_args) == 1 and
                ty_tag(nlist_get(source_args, 0)) == 2 and ty_f1(nlist_get(source_args, 0)) == PRIM_I64()
            }
          if not scalar_i64 and not source_i64 {
            valid = 0
          } else { 0 }
        }
        valid
      }
    }
    _ -> 0
  }
}

pub(package) fn pipeline_ir_semantic_fact_hash_for_traversal_role(facts: PipelineIrSemanticFactList, role: PipelineIrTraversalRole, default: i64) -> i64 {
  match facts {
    PipelineIrSemanticFactNil -> default
    PipelineIrSemanticFactNode(hash, fact, borrow, left, right) -> {
      if cg_semantic_fact_traversal_code(fact) == pipeline_ir_traversal_role_code(role) { hash }
      else {
        let lower = pipeline_ir_semantic_fact_hash_for_traversal_role(left, role, default)
        if lower != default { lower } else { pipeline_ir_semantic_fact_hash_for_traversal_role(right, role, default) }
      }
    }
  }
}

pub(package) fn pipeline_ir_traversal_term_uses_value(term: IrTerminator, value: i64) -> i64 {
  match term {
    IrTermReturn(result) -> if result == value { 1 } else { 0 }
    IrTermJump(target, args) -> pipeline_ir_live_set_contains(pipeline_ir_live_set_add_values(pipeline_ir_live_set_empty(), args), value)
    IrTermBranch(condition, then_block, else_block) -> if condition == value { 1 } else { 0 }
    _ -> 0
  }
}

pub(package) fn pipeline_ir_traversal_inst_list_use_count(insts: IrInstList, value: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      pipeline_ir_live_set_contains(pipeline_ir_live_set_add_inst_uses(inst, pipeline_ir_live_set_empty()), value) +
      pipeline_ir_traversal_inst_list_use_count(rest, value)
    }
  }
}

pub(package) fn pipeline_ir_traversal_block_list_use_count(blocks: IrBlockList, value: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(IrBlock(id, params, insts, term), rest) -> {
      pipeline_ir_traversal_inst_list_use_count(insts, value) +
      pipeline_ir_traversal_term_uses_value(term, value) +
      pipeline_ir_traversal_block_list_use_count(rest, value)
    }
  }
}

pub(package) fn pipeline_ir_traversal_inst_list_stake_count(insts: IrInstList, value: i64, delta: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let add = match inst {
        IrManagedStakeI64(dst, stake_value, cleanup_kind, stake_delta, origin) -> {
          if stake_value == value and stake_delta == delta { 1 } else { 0 }
        }
        _ -> 0
      }
      add + pipeline_ir_traversal_inst_list_stake_count(rest, value, delta)
    }
  }
}

pub(package) fn pipeline_ir_traversal_block_list_stake_count(blocks: IrBlockList, value: i64, delta: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(IrBlock(id, params, insts, term), rest) -> {
      pipeline_ir_traversal_inst_list_stake_count(insts, value, delta) +
      pipeline_ir_traversal_block_list_stake_count(rest, value, delta)
    }
  }
}

pub(package) fn pipeline_ir_traversal_inst_list_direct_transfer_count(insts: IrInstList, value: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let add = match inst {
        IrManagedTransferI64(call_dst, callee_hash, transferred, arg_lane, cleanup_kind) -> {
          if callee_hash == pipeline_direct_managed_transfer_hash() and transferred == value { 1 } else { 0 }
        }
        _ -> 0
      }
      add + pipeline_ir_traversal_inst_list_direct_transfer_count(rest, value)
    }
  }
}

pub(package) fn pipeline_ir_traversal_block_list_direct_transfer_count(blocks: IrBlockList, value: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(IrBlock(id, params, insts, term), rest) -> {
      pipeline_ir_traversal_inst_list_direct_transfer_count(insts, value) +
      pipeline_ir_traversal_block_list_direct_transfer_count(rest, value)
    }
  }
}

pub(package) fn pipeline_ir_traversal_inst_list_bind_count(insts: IrInstList, value: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let add = match inst {
        IrBindI64(ns, nl, bound, ty) -> if bound == value { 1 } else { 0 }
        _ -> 0
      }
      add + pipeline_ir_traversal_inst_list_bind_count(rest, value)
    }
  }
}

pub(package) fn pipeline_ir_traversal_block_list_bind_count(blocks: IrBlockList, value: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(IrBlock(id, params, insts, term), rest) -> {
      pipeline_ir_traversal_inst_list_bind_count(insts, value) +
      pipeline_ir_traversal_block_list_bind_count(rest, value)
    }
  }
}

pub(package) fn pipeline_ir_traversal_inst_list_linear_transfer_count(insts: IrInstList, value: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let add = match inst {
        IrStructuralSlotI64(transferred, slot, plan, mode) -> if mode == 3 and transferred == value { 1 } else { 0 }
        _ -> 0
      }
      add + pipeline_ir_traversal_inst_list_linear_transfer_count(rest, value)
    }
  }
}

pub(package) fn pipeline_ir_traversal_block_list_linear_transfer_count(blocks: IrBlockList, value: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(IrBlock(id, params, insts, term), rest) -> pipeline_ir_traversal_inst_list_linear_transfer_count(insts, value) +
      pipeline_ir_traversal_block_list_linear_transfer_count(rest, value)
  }
}

pub(package) fn pipeline_ir_traversal_stake_results_unused_insts(insts: IrInstList, blocks: IrBlockList, value: i64) -> i64 {
  match insts {
    IrInstNil -> 1
    IrInstCons(inst, rest) -> {
      let valid = match inst {
        IrManagedStakeI64(dst, stake_value, cleanup_kind, delta, origin) -> {
          if stake_value == value { if pipeline_ir_traversal_block_list_use_count(blocks, dst) == 0 { 1 } else { 0 } }
          else { 1 }
        }
        _ -> 1
      }
      if valid != 1 { 0 } else { pipeline_ir_traversal_stake_results_unused_insts(rest, blocks, value) }
    }
  }
}

pub(package) fn pipeline_ir_traversal_stake_results_unused(blocks: IrBlockList, all_blocks: IrBlockList, value: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 1
    IrBlockListCons(IrBlock(id, params, insts, term), rest) -> {
      if pipeline_ir_traversal_stake_results_unused_insts(insts, all_blocks, value) != 1 { 0 }
      else { pipeline_ir_traversal_stake_results_unused(rest, all_blocks, value) }
    }
  }
}

pub(package) fn pipeline_ir_traversal_captured_callback_valid(blocks: IrBlockList, value: i64) -> i64 {
  let uses = pipeline_ir_traversal_block_list_use_count(blocks, value)
  let retains = pipeline_ir_traversal_block_list_stake_count(blocks, value, 1)
  let releases = pipeline_ir_traversal_block_list_stake_count(blocks, value, 0 - 1)
  let transfers = pipeline_ir_traversal_block_list_direct_transfer_count(blocks, value)
  if uses == 2 + transfers and retains == 1 and releases == 0 and transfers <= 1 { 1 }
  else {
    if uses == 1 + transfers and retains == 0 and releases == 0 and transfers <= 1 and pipeline_ir_abort_cleanup_blocks_define_closure(blocks, value) == 1 { 1 }
    else { 0 }
  }
}

pub(package) fn pipeline_ir_traversal_fold_callback_valid(blocks: IrBlockList, value: i64) -> i64 {
  let uses = pipeline_ir_traversal_block_list_use_count(blocks, value)
  let retains = pipeline_ir_traversal_block_list_stake_count(blocks, value, 1)
  let releases = pipeline_ir_traversal_block_list_stake_count(blocks, value, 0 - 1)
  let transfers = pipeline_ir_traversal_block_list_direct_transfer_count(blocks, value)
  if uses == 1 + transfers and retains == 0 and releases == 0 and transfers <= 1 { 1 }
  else {
    if uses == 2 + transfers and retains == 0 and releases == 1 and transfers <= 1 and pipeline_ir_abort_cleanup_blocks_define_closure(blocks, value) == 1 { 1 }
    else { 0 }
  }
}

pub(package) fn pipeline_ir_traversal_fusion_ledger_valid(
  blocks: IrBlockList,
  range_value: i64,
  map_value: i64,
  filter_value: i64,
  take_value: i64,
  mapper: i64,
  predicate: i64,
  folder: i64
) -> i64 {
  -- Each intermediate owned iterator is used only by its binding, the next
  -- consuming adapter, and that call boundary's explicit linear-transfer
  -- fact. Requiring the fact keeps fusion downstream of ownership semantics;
  -- the rewrite erases it together with the eliminated adapter call.
  if pipeline_ir_traversal_block_list_use_count(blocks, range_value) != 2 { 0 }
  else { if pipeline_ir_traversal_block_list_use_count(blocks, map_value) != 3 { 0 }
  else { if pipeline_ir_traversal_block_list_use_count(blocks, filter_value) != 3 { 0 }
  else { if pipeline_ir_traversal_block_list_use_count(blocks, take_value) != 3 { 0 }
  else { if pipeline_ir_traversal_block_list_linear_transfer_count(blocks, range_value) != 1 or
             pipeline_ir_traversal_block_list_linear_transfer_count(blocks, map_value) != 1 or
             pipeline_ir_traversal_block_list_linear_transfer_count(blocks, filter_value) != 1 or
             pipeline_ir_traversal_block_list_linear_transfer_count(blocks, take_value) != 1 { 0 }
  else { if pipeline_ir_traversal_captured_callback_valid(blocks, mapper) != 1 { 0 }
  else { if pipeline_ir_traversal_captured_callback_valid(blocks, predicate) != 1 { 0 }
  else { if pipeline_ir_traversal_fold_callback_valid(blocks, folder) != 1 { 0 }
  else { if pipeline_ir_traversal_block_list_bind_count(blocks, map_value) != 1 or
             pipeline_ir_traversal_block_list_bind_count(blocks, filter_value) != 1 or
             pipeline_ir_traversal_block_list_bind_count(blocks, take_value) != 1 { 0 }
  else { if pipeline_ir_traversal_block_list_stake_count(blocks, map_value, 1) != 0 or
             pipeline_ir_traversal_block_list_stake_count(blocks, map_value, 0 - 1) != 0 or
             pipeline_ir_traversal_block_list_stake_count(blocks, filter_value, 1) != 0 or
             pipeline_ir_traversal_block_list_stake_count(blocks, filter_value, 0 - 1) != 0 or
             pipeline_ir_traversal_block_list_stake_count(blocks, take_value, 1) != 0 or
             pipeline_ir_traversal_block_list_stake_count(blocks, take_value, 0 - 1) != 0 { 0 }
  else {
    if pipeline_ir_traversal_stake_results_unused(blocks, blocks, map_value) != 1 or
       pipeline_ir_traversal_stake_results_unused(blocks, blocks, filter_value) != 1 or
       pipeline_ir_traversal_stake_results_unused(blocks, blocks, take_value) != 1 { 0 }
    else { 1 }
  } } } } } } } } } } }
}

pub(package) fn pipeline_ir_traversal_fusion_from_inst(
  inst: IrInst,
  insts: IrInstList,
  blocks: IrBlockList,
  facts: PipelineIrSemanticFactList,
  helper_hash: i64
) -> PipelineIrTraversalFusion {
  let fold_call = pipeline_ir_traversal_inst_call(inst, facts)
  match fold_call {
    PipelineIrTraversalCallMissing -> PipelineIrTraversalFusionInvalid
    PipelineIrTraversalCallFound(fold_inst, fold_dst, fold_role, fold_args) -> {
      if pipeline_ir_traversal_role_same(fold_role, PipelineIrTraversalFold) != 1 or ir_value_list_len(fold_args) != 3 or helper_hash == 0 { PipelineIrTraversalFusionInvalid }
      else {
        let take_value = ir_value_list_nth_or(fold_args, 0, 0 - 1)
        let init = ir_value_list_nth_or(fold_args, 1, 0 - 1)
        let folder = ir_value_list_nth_or(fold_args, 2, 0 - 1)
        let fold_fact = match fold_inst {
          IrCallI64(dst, callee_hash, args) -> pipeline_ir_semantic_fact_find(facts, callee_hash)
          IrGenericCallI64(dst, callee_hash, type_args, args) -> pipeline_ir_semantic_fact_find(facts, mono_spec_hash(callee_hash, type_expr_list_to_nodes(type_args)))
          _ -> 0
        }
        if cg_semantic_fact_i64_return(fold_fact) != 1 { PipelineIrTraversalFusionInvalid }
        else {
          match pipeline_ir_traversal_call_for_value(insts, take_value, facts) {
            PipelineIrTraversalCallMissing -> PipelineIrTraversalFusionInvalid
            PipelineIrTraversalCallFound(take_inst, take_dst, take_role, take_args) -> {
              if pipeline_ir_traversal_role_same(take_role, PipelineIrTraversalTake) != 1 or ir_value_list_len(take_args) != 2 or pipeline_ir_traversal_generic_i64_args(take_inst, 1) != 1 { PipelineIrTraversalFusionInvalid }
              else {
                let filter_value = ir_value_list_nth_or(take_args, 0, 0 - 1)
                let limit = ir_value_list_nth_or(take_args, 1, 0 - 1)
                match pipeline_ir_traversal_call_for_value(insts, filter_value, facts) {
                  PipelineIrTraversalCallMissing -> PipelineIrTraversalFusionInvalid
                  PipelineIrTraversalCallFound(filter_inst, filter_dst, filter_role, filter_args) -> {
                    if pipeline_ir_traversal_role_same(filter_role, PipelineIrTraversalFilter) != 1 or ir_value_list_len(filter_args) != 2 or pipeline_ir_traversal_generic_i64_args(filter_inst, 1) != 1 { PipelineIrTraversalFusionInvalid }
                    else {
                      let map_value = ir_value_list_nth_or(filter_args, 0, 0 - 1)
                      let predicate = ir_value_list_nth_or(filter_args, 1, 0 - 1)
                      match pipeline_ir_traversal_call_for_value(insts, map_value, facts) {
                        PipelineIrTraversalCallMissing -> PipelineIrTraversalFusionInvalid
                        PipelineIrTraversalCallFound(map_inst, map_dst, map_role, map_args) -> {
                          if pipeline_ir_traversal_role_same(map_role, PipelineIrTraversalMap) != 1 or ir_value_list_len(map_args) != 2 or pipeline_ir_traversal_generic_i64_args(map_inst, 2) != 1 { PipelineIrTraversalFusionInvalid }
                          else {
                            let range_value = ir_value_list_nth_or(map_args, 0, 0 - 1)
                            let mapper = ir_value_list_nth_or(map_args, 1, 0 - 1)
                            match pipeline_ir_traversal_call_for_value(insts, range_value, facts) {
                              PipelineIrTraversalCallMissing -> PipelineIrTraversalFusionInvalid
                              PipelineIrTraversalCallFound(range_inst, range_dst, range_role, range_args) -> {
                                if pipeline_ir_traversal_role_same(range_role, PipelineIrTraversalRangeI64) != 1 or ir_value_list_len(range_args) != 2 { PipelineIrTraversalFusionInvalid }
                                else {
                                  let start = ir_value_list_nth_or(range_args, 0, 0 - 1)
                                  let end = ir_value_list_nth_or(range_args, 1, 0 - 1)
                                  if pipeline_ir_traversal_fusion_ledger_valid(blocks, range_value, map_value, filter_value, take_value, mapper, predicate, folder) != 1 {
                                    PipelineIrTraversalFusionInvalid
                                  } else {
                                    PipelineIrTraversalFusionFound(range_dst, map_dst, filter_dst, take_dst, fold_dst, start, end, mapper, predicate, limit, init, folder, helper_hash)
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

pub(package) fn pipeline_ir_traversal_collect_fusions(insts: IrInstList, all_insts: IrInstList, blocks: IrBlockList, facts: PipelineIrSemanticFactList, helper_hash: i64) -> PipelineIrTraversalFusionList {
  match insts {
    IrInstNil -> PipelineIrTraversalFusionNil
    IrInstCons(inst, rest) -> {
      let tail = pipeline_ir_traversal_collect_fusions(rest, all_insts, blocks, facts, helper_hash)
      match pipeline_ir_traversal_fusion_from_inst(inst, all_insts, blocks, facts, helper_hash) {
        PipelineIrTraversalFusionInvalid -> tail
        PipelineIrTraversalFusionFound(range_dst, map_dst, filter_dst, take_dst, fold_dst, start, end, mapper, predicate, limit, init, folder, target) -> {
          PipelineIrTraversalFusionCons(
            PipelineIrTraversalFusionFound(range_dst, map_dst, filter_dst, take_dst, fold_dst, start, end, mapper, predicate, limit, init, folder, target),
            tail
          )
        }
      }
    }
  }
}

pub(package) fn pipeline_ir_traversal_fusion_call_action(fusions: PipelineIrTraversalFusionList, dst: i64) -> i64 {
  match fusions {
    PipelineIrTraversalFusionNil -> 0
    PipelineIrTraversalFusionCons(fusion, rest) -> match fusion {
      PipelineIrTraversalFusionInvalid -> pipeline_ir_traversal_fusion_call_action(rest, dst)
      PipelineIrTraversalFusionFound(range_dst, map_dst, filter_dst, take_dst, fold_dst, start, end, mapper, predicate, limit, init, folder, helper_hash) -> {
        if dst == fold_dst { 2 }
        else { if dst == range_dst or dst == map_dst or dst == filter_dst or dst == take_dst { 1 }
        else { pipeline_ir_traversal_fusion_call_action(rest, dst) } }
      }
    }
  }
}

pub(package) fn pipeline_ir_traversal_fusion_for_fold(fusions: PipelineIrTraversalFusionList, dst: i64) -> PipelineIrTraversalFusion {
  match fusions {
    PipelineIrTraversalFusionNil -> PipelineIrTraversalFusionInvalid
    PipelineIrTraversalFusionCons(fusion, rest) -> match fusion {
      PipelineIrTraversalFusionInvalid -> pipeline_ir_traversal_fusion_for_fold(rest, dst)
      PipelineIrTraversalFusionFound(range_dst, map_dst, filter_dst, take_dst, fold_dst, start, end, mapper, predicate, limit, init, folder, helper_hash) -> {
        if dst == fold_dst { fusion } else { pipeline_ir_traversal_fusion_for_fold(rest, dst) }
      }
    }
  }
}

pub(package) fn pipeline_ir_traversal_fusion_erases_owned_value(fusions: PipelineIrTraversalFusionList, value: i64) -> i64 {
  match fusions {
    PipelineIrTraversalFusionNil -> 0
    PipelineIrTraversalFusionCons(fusion, rest) -> match fusion {
      PipelineIrTraversalFusionInvalid -> pipeline_ir_traversal_fusion_erases_owned_value(rest, value)
      PipelineIrTraversalFusionFound(range_dst, map_dst, filter_dst, take_dst, fold_dst, start, end, mapper, predicate, limit, init, folder, helper_hash) -> {
        if value == range_dst or value == map_dst or value == filter_dst or value == take_dst { 1 }
        else { pipeline_ir_traversal_fusion_erases_owned_value(rest, value) }
      }
    }
  }
}

pub(package) fn pipeline_ir_traversal_fusion_erases_bind_value(fusions: PipelineIrTraversalFusionList, value: i64) -> i64 {
  match fusions {
    PipelineIrTraversalFusionNil -> 0
    PipelineIrTraversalFusionCons(fusion, rest) -> match fusion {
      PipelineIrTraversalFusionInvalid -> pipeline_ir_traversal_fusion_erases_bind_value(rest, value)
      PipelineIrTraversalFusionFound(range_dst, map_dst, filter_dst, take_dst, fold_dst, start, end, mapper, predicate, limit, init, folder, helper_hash) -> {
        if value == map_dst or value == filter_dst or value == take_dst { 1 }
        else { pipeline_ir_traversal_fusion_erases_bind_value(rest, value) }
      }
    }
  }
}

pub(package) fn pipeline_ir_traversal_fused_call_insts(fusion: PipelineIrTraversalFusion, dst: i64) -> IrInstList {
  match fusion {
    PipelineIrTraversalFusionInvalid -> ir_inst_list_empty()
    PipelineIrTraversalFusionFound(range_dst, map_dst, filter_dst, take_dst, fold_dst, start, end, mapper, predicate, limit, init, folder, helper_hash) -> {
      let args = ir_value_list_prepend(start,
        ir_value_list_prepend(end,
          ir_value_list_prepend(mapper,
            ir_value_list_prepend(predicate,
              ir_value_list_prepend(limit,
                ir_value_list_prepend(init,
                  ir_value_list_prepend(folder, ir_value_list_empty())
                )
              )
            )
          )
        )
      )
      ir_inst_list_prepend(
        ir_inst_call_i64(dst, helper_hash, args),
        ir_inst_list_prepend(
          pipeline_managed_release_inst_with_origin(map_dst, mapper, continuation_cleanup_kind_closure(), ir_managed_stake_origin_call_transport()),
          ir_inst_list_prepend(
            pipeline_managed_release_inst_with_origin(filter_dst, predicate, continuation_cleanup_kind_closure(), ir_managed_stake_origin_call_transport()),
            ir_inst_list_empty()
          )
        )
      )
    }
  }
}

pub(package) fn pipeline_ir_traversal_rewrite_insts(insts: IrInstList, fusions: PipelineIrTraversalFusionList) -> IrInstList {
  match insts {
    IrInstNil -> IrInstNil
    IrInstCons(inst, rest) -> {
      let tail = pipeline_ir_traversal_rewrite_insts(rest, fusions)
      match inst {
        IrCallI64(dst, callee_hash, args) -> {
          let action = pipeline_ir_traversal_fusion_call_action(fusions, dst)
          if action == 1 { tail }
          else { if action == 2 { ir_inst_list_append(pipeline_ir_traversal_fused_call_insts(pipeline_ir_traversal_fusion_for_fold(fusions, dst), dst), tail) }
          else { ir_inst_list_prepend(inst, tail) } }
        }
        IrGenericCallI64(dst, callee_hash, type_args, args) -> {
          let action = pipeline_ir_traversal_fusion_call_action(fusions, dst)
          if action == 1 { tail }
          else { if action == 2 { ir_inst_list_append(pipeline_ir_traversal_fused_call_insts(pipeline_ir_traversal_fusion_for_fold(fusions, dst), dst), tail) }
          else { ir_inst_list_prepend(inst, tail) } }
        }
        IrBindI64(ns, nl, value, ty) -> {
          if pipeline_ir_traversal_fusion_erases_bind_value(fusions, value) == 1 { tail } else { ir_inst_list_prepend(inst, tail) }
        }
        IrManagedStakeI64(stake_dst, value, cleanup_kind, delta, origin) -> {
          if pipeline_ir_traversal_fusion_erases_owned_value(fusions, value) == 1 { tail } else { ir_inst_list_prepend(inst, tail) }
        }
        IrStructuralSlotI64(value, slot, plan, mode) -> {
          if mode == 3 and pipeline_ir_traversal_fusion_erases_owned_value(fusions, value) == 1 { tail }
          else { ir_inst_list_prepend(inst, tail) }
        }
        IrManagedTransferI64(call_dst, callee_hash, value, arg_lane, cleanup_kind) -> {
          if callee_hash == pipeline_direct_managed_transfer_hash() and pipeline_ir_traversal_fusion_call_action(fusions, call_dst) != 0 { tail }
          else { ir_inst_list_prepend(inst, tail) }
        }
        _ -> ir_inst_list_prepend(inst, tail)
      }
    }
  }
}

pub(package) fn pipeline_ir_traversal_fuse_blocks(blocks: IrBlockList, all_blocks: IrBlockList, facts: PipelineIrSemanticFactList, helper_hash: i64) -> IrBlockList {
  match blocks {
    IrBlockListNil -> IrBlockListNil
    IrBlockListCons(block, rest) -> {
      let rewritten = match block {
        IrBlock(id, params, insts, term) -> {
          let fusions = pipeline_ir_traversal_collect_fusions(insts, insts, all_blocks, facts, helper_hash)
          match fusions {
            PipelineIrTraversalFusionNil -> block
            _ -> IrBlock(id, params, pipeline_ir_traversal_rewrite_insts(insts, fusions), term)
          }
        }
      }
      ir_block_list_prepend(rewritten, pipeline_ir_traversal_fuse_blocks(rest, all_blocks, facts, helper_hash))
    }
  }
}

pub(package) fn pipeline_ir_traversal_fuse_functions_with(functions: IrFunctionList, facts: PipelineIrSemanticFactList, helper_hash: i64) -> IrFunctionList {
  match functions {
    IrFunctionNil -> IrFunctionNil
    IrFunctionCons(IrFunction(hash, param_count, blocks, src), rest) -> {
      ir_function_list_prepend(
        ir_function_new_blocks_src(hash, param_count, pipeline_ir_traversal_fuse_blocks(blocks, blocks, facts, helper_hash), src),
        pipeline_ir_traversal_fuse_functions_with(rest, facts, helper_hash)
      )
    }
  }
}

pub(package) fn pipeline_ir_traversal_fuse_functions(functions: IrFunctionList, facts: PipelineIrSemanticFactList) -> IrFunctionList {
  let helper_hash = pipeline_ir_semantic_fact_hash_for_traversal_role(facts, PipelineIrTraversalRangeMapFilterTakeFoldI64, 0)
  if helper_hash == 0 { functions } else { pipeline_ir_traversal_fuse_functions_with(functions, facts, helper_hash) }
}

pub(package) type PipelineTypedOptimisationPrefix {
  PipelineTypedOptimisationPrefix(IrFunctionList, PipelineIrSemanticFactList)
}

pub(package) fn pipeline_typed_optimisation_prefix_functions(prefix: PipelineTypedOptimisationPrefix) -> IrFunctionList {
  match prefix { PipelineTypedOptimisationPrefix(functions, facts) -> functions }
}

pub(package) fn pipeline_typed_optimisation_prefix_facts(prefix: PipelineTypedOptimisationPrefix) -> PipelineIrSemanticFactList {
  match prefix { PipelineTypedOptimisationPrefix(functions, facts) -> facts }
}

-- Produce the whole-program identities and semantic facts immediately before
-- the expensive two-pass function-local optimiser. This prefix is deliberately
-- rerun for an importing root so root-triggered generic and callback
-- specialisations remain an overlay rather than leaking into the dependency
-- product.
pub(package) fn pipeline_typed_optimisation_prefix(typed: TypedModule, ir: IrModule) -> PipelineTypedOptimisationPrefix {
  match typed {
    TypedModule(fns, src, tt) -> {
      let base_functions = pipeline_ir_functions(ir)
      let templates = pipeline_generic_template_pairs(fns)
      let source_specs = pipeline_collect_generic_specs_fns(fns, tt, src)
      let ir_specs = pipeline_collect_generic_specs_ir_functions(base_functions, templates, fns, tt)
      let direct_generic_specs = pipeline_ir_function_list_dedup(pipeline_ir_function_list_append(source_specs, ir_specs))
      let generic_specs = pipeline_collect_generic_specs_closure(direct_generic_specs, templates, fns, tt)
      let canonical_functions = pipeline_ir_hoisted_lambda_fns_extend(pipeline_ir_function_list_append(base_functions, generic_specs))
      let decl_facts = pipeline_ir_semantic_facts_from_fns_with_tt(fns, 0, tt)
      let spec_facts = pipeline_ir_spec_facts_extend(canonical_functions, templates, pipeline_ir_semantic_facts_effect_flag_map(decl_facts), decl_facts)
      let lambda_facts = pipeline_ir_lambda_semantic_facts_extend(canonical_functions, spec_facts)
      let identities = pipeline_ir_identity_specialise(canonical_functions)
      let functions = pipeline_ir_identity_specialisations_functions(identities)
      let semantic_facts = pipeline_ir_identity_facts_extend(pipeline_ir_identity_specialisations_requests(identities), lambda_facts)
      let fused_functions = pipeline_ir_traversal_fuse_functions(functions, semantic_facts)
      let retain_facts = pipeline_ir_direct_retain_return_enrich(fused_functions, semantic_facts)
      PipelineTypedOptimisationPrefix(fused_functions, pipeline_ir_fresh_return_enrich(fused_functions, retain_facts))
    }
  }
}

pub(package) fn pipeline_optimised_dependency_product_functions(product: PipelineOptimisedDependencyProduct) -> IrFunctionList {
  match product {
    PipelineOptimisedDependencyProduct(functions, consts, algebraic, dead, pure_dce, narrowing, direct_inline) -> functions
    PipelineOptimisedDependencyProductUnavailable -> ir_function_list_empty()
  }
}

pub(package) fn pipeline_optimised_dependency_product_is_available(product: PipelineOptimisedDependencyProduct) -> i64 {
  match product {
    PipelineOptimisedDependencyProduct(functions, consts, algebraic, dead, pure_dce, narrowing, direct_inline) -> 1
    PipelineOptimisedDependencyProductUnavailable -> 0
  }
}

pub(package) fn pipeline_ir_function_list_without_product(functions: IrFunctionList, product_functions: IrFunctionList) -> IrFunctionList {
  match functions {
    IrFunctionNil -> ir_function_list_empty()
    IrFunctionCons(function, rest) -> match function {
      IrFunction(hash, params, blocks, src) -> {
        let tail = pipeline_ir_function_list_without_product(rest, product_functions)
        match pipeline_ir_function_list_find_hash(product_functions, hash) {
          IrFunctionNil -> ir_function_list_prepend(function, tail)
          IrFunctionCons(found, ignored) -> tail
        }
      }
    }
  }
}

pub(package) fn pipeline_ir_function_list_replace_from_product(functions: IrFunctionList, product_functions: IrFunctionList, overlay_functions: IrFunctionList) -> IrFunctionList {
  match functions {
    IrFunctionNil -> ir_function_list_empty()
    IrFunctionCons(function, rest) -> match function {
      IrFunction(hash, params, blocks, src) -> {
        let replacement = match pipeline_ir_function_list_find_hash(product_functions, hash) {
          IrFunctionNil -> match pipeline_ir_function_list_find_hash(overlay_functions, hash) {
            IrFunctionNil -> function
            IrFunctionCons(found, ignored) -> found
          }
          IrFunctionCons(found, ignored) -> found
        }
        ir_function_list_prepend(replacement, pipeline_ir_function_list_replace_from_product(rest, product_functions, overlay_functions))
      }
    }
  }
}

pub(package) fn pipeline_optimised_dependency_product_build(typed: TypedModule) -> PipelineOptimisedDependencyProduct {
  match typed {
    TypedModule(fns, src, tt) -> {
      let prefix = pipeline_typed_optimisation_prefix(typed, pipeline_lower_ir(typed))
      let functions = pipeline_typed_optimisation_prefix_functions(prefix)
      let facts = pipeline_typed_optimisation_prefix_facts(prefix)
      let opt = pipeline_optimise_ir_function_list(functions, functions, facts, src, tt)
      let promoted = pipeline_mem2reg_retighten_function_list(
        pipeline_mem2reg_function_list(pipeline_optimised_functions_functions(opt)),
        facts,
        pipeline_ir_pure_callee_tree(facts)
      )
      PipelineOptimisedDependencyProduct(
        promoted,
        pipeline_optimised_functions_const_fold_sites(opt),
        pipeline_optimised_functions_algebraic_fold_sites(opt),
        pipeline_optimised_functions_dead_inst_sites(opt),
        pipeline_optimised_functions_pure_call_dce_sites(opt),
        pipeline_optimised_functions_block_entry_narrowing_sites(opt),
        pipeline_optimised_functions_direct_call_inline_sites(opt)
      )
    }
  }
}

-- Optimise only the root overlay while retaining cached dependency functions
-- as candidates in both historic full passes. The ordinary helper rebuilds
-- second-pass candidates from its result list; for an overlay that list omits
-- dependencies, which would silently lose the second wave of dependency
-- inlining even though the first pass had the complete universe.
pub(package) fn pipeline_optimise_ir_function_overlay(
  functions: IrFunctionList,
  all_functions: IrFunctionList,
  reusable_functions: IrFunctionList,
  facts: PipelineIrSemanticFactList,
  user_src: i64,
  tt: i64
) -> PipelineOptimisedFunctions {
  let pure_callees = pipeline_ir_pure_callee_tree(facts)
  let mut candidates = pipeline_ir_inline_candidates_from_functions(all_functions, facts, user_src)
  let mut ci = 0
  while ci < 4 {
    let candidate_functions = pipeline_ir_inline_candidate_functions(candidates, ir_function_list_empty())
    let candidate_opt = pipeline_optimise_ir_function_list_with_candidates(candidate_functions, candidates, PipelineIrInlineCandidateNil, facts, user_src, pure_callees, tt)
    if pipeline_optimised_functions_direct_call_inline_sites(candidate_opt) == 0 { ci = 4 }
    else {
      candidates = pipeline_ir_inline_candidates_from_functions(pipeline_optimised_functions_functions(candidate_opt), facts, user_src)
      ci = ci + 1
    }
  }
  let multi_candidates = pipeline_ir_multi_inline_candidates_walk(all_functions, facts)
  let first = pipeline_optimise_ir_function_list_with_candidates(functions, candidates, multi_candidates, facts, user_src, pure_callees, tt)
  let first_functions = pipeline_optimised_functions_functions(first)
  let second_universe = pipeline_ir_function_list_append(reusable_functions, first_functions)
  let second_candidates = pipeline_ir_inline_candidates_from_functions(second_universe, facts, user_src)
  let second_multi = pipeline_ir_multi_inline_candidates_walk(second_universe, facts)
  let second = pipeline_optimise_ir_function_list_with_candidates(first_functions, second_candidates, second_multi, facts, user_src, pure_callees, tt)
  pipeline_optimised_functions(
    pipeline_optimised_functions_functions(second),
    pipeline_optimised_functions_const_fold_sites(first) + pipeline_optimised_functions_const_fold_sites(second),
    pipeline_optimised_functions_algebraic_fold_sites(first) + pipeline_optimised_functions_algebraic_fold_sites(second),
    pipeline_optimised_functions_dead_inst_sites(first) + pipeline_optimised_functions_dead_inst_sites(second),
    pipeline_optimised_functions_pure_call_dce_sites(first) + pipeline_optimised_functions_pure_call_dce_sites(second),
    pipeline_optimised_functions_block_entry_narrowing_sites(first) + pipeline_optimised_functions_block_entry_narrowing_sites(second),
    pipeline_optimised_functions_direct_call_inline_sites(first) + pipeline_optimised_functions_direct_call_inline_sites(second)
  )
}

pub(package) fn pipeline_optimised_functions_with_dependency_product(
  functions: IrFunctionList,
  facts: PipelineIrSemanticFactList,
  src: i64,
  tt: i64,
  product: PipelineOptimisedDependencyProduct
) -> PipelineOptimisedFunctions {
  match product {
    PipelineOptimisedDependencyProduct(product_functions, base_consts, base_algebraic, base_dead, base_pure_dce, base_narrowing, base_direct_inline) -> {
      let overlay = pipeline_ir_function_list_without_product(functions, product_functions)
      let overlay_opt = pipeline_optimise_ir_function_overlay(overlay, functions, product_functions, facts, src, tt)
      let combined = pipeline_ir_function_list_replace_from_product(functions, product_functions, pipeline_optimised_functions_functions(overlay_opt))
      pipeline_optimised_functions(
        combined,
        base_consts + pipeline_optimised_functions_const_fold_sites(overlay_opt),
        base_algebraic + pipeline_optimised_functions_algebraic_fold_sites(overlay_opt),
        base_dead + pipeline_optimised_functions_dead_inst_sites(overlay_opt),
        base_pure_dce + pipeline_optimised_functions_pure_call_dce_sites(overlay_opt),
        base_narrowing + pipeline_optimised_functions_block_entry_narrowing_sites(overlay_opt),
        base_direct_inline + pipeline_optimised_functions_direct_call_inline_sites(overlay_opt)
      )
    }
    PipelineOptimisedDependencyProductUnavailable -> pipeline_optimise_ir_function_list(functions, functions, facts, src, tt)
  }
}

pub(package) fn pipeline_finish_typed_optimisation(
  typed: TypedModule,
  canonical_functions: IrFunctionList,
  facts: PipelineIrSemanticFactList,
  opt: PipelineOptimisedFunctions,
  promoted_functions: IrFunctionList,
  promote: i64
) -> IrModule {
  match typed {
    TypedModule(fns, src, tt) -> {
      let small_variants = if promote == 1 {
        pipeline_ir_small_variant_specialise(promoted_functions, facts)
      } else { PipelineIrSmallVariantSpecialisations(promoted_functions, facts, 0) }
      let scalarised_functions = pipeline_ir_small_variant_specialisations_functions(small_variants)
      let scalarised_facts = pipeline_ir_small_variant_specialisations_facts(small_variants)
      let final_semantic_facts = pipeline_ir_semantic_borrow_values_enrich_functions(scalarised_facts, scalarised_functions, fns, tt)
      let consuming = if promote == 1 {
        pipeline_ir_consuming_specialise(scalarised_functions, canonical_functions, final_semantic_facts, fns, src, tt)
      } else { PipelineIrConsumingSpecialisations(scalarised_functions, final_semantic_facts, 0) }
      let consuming_functions = pipeline_ir_consuming_specialisations_functions(consuming)
      let consuming_facts = pipeline_ir_consuming_specialisations_facts(consuming)
      let transferred_functions = if promote == 1 {
        pipeline_ir_ownership_transfer_functions(consuming_functions, consuming_functions, consuming_facts)
      } else { consuming_functions }
      let final_functions = if promote == 1 { pipeline_ir_reuse_functions(transferred_functions) } else { transferred_functions }
      OptimisedIrModule(
        final_functions,
        0,
        0,
        0,
        pipeline_optimised_functions_const_fold_sites(opt),
        pipeline_optimised_functions_algebraic_fold_sites(opt),
        pipeline_optimised_functions_dead_inst_sites(opt),
        consuming_facts,
        pipeline_optimised_functions_pure_call_dce_sites(opt),
        0,
        pipeline_optimised_functions_block_entry_narrowing_sites(opt),
        pipeline_optimised_functions_direct_call_inline_sites(opt)
      )
    }
  }
}

pub(package) fn pipeline_optimise_typed_ir(typed: TypedModule, ir: IrModule) -> IrModule {
  pipeline_optimise_typed_ir_with_promotion(typed, ir, 1)
}

pub(package) fn pipeline_optimise_typed_ir_with_dependency_product(typed: TypedModule, ir: IrModule, product: PipelineOptimisedDependencyProduct) -> IrModule {
  match typed {
    TypedModule(fns, src, tt) -> {
      let prefix = pipeline_typed_optimisation_prefix(typed, ir)
      let functions = pipeline_typed_optimisation_prefix_functions(prefix)
      let facts = pipeline_typed_optimisation_prefix_facts(prefix)
      let opt = pipeline_optimised_functions_with_dependency_product(functions, facts, src, tt, product)
      let product_functions = pipeline_optimised_dependency_product_functions(product)
      let promoted_overlay = pipeline_mem2reg_retighten_function_list(
        pipeline_mem2reg_function_list(pipeline_ir_function_list_without_product(pipeline_optimised_functions_functions(opt), product_functions)),
        facts,
        pipeline_ir_pure_callee_tree(facts)
      )
      let promoted = pipeline_ir_function_list_replace_from_product(functions, product_functions, promoted_overlay)
      pipeline_finish_typed_optimisation(typed, functions, facts, opt, promoted, 1)
    }
  }
}

pub(package) fn pipeline_optimise_typed_ir_with_promotion(typed: TypedModule, ir: IrModule, promote: i64) -> IrModule {
  match typed {
    TypedModule(fns, src, tt) -> {
      let prefix = pipeline_typed_optimisation_prefix(typed, ir)
      let functions = pipeline_typed_optimisation_prefix_functions(prefix)
      let fresh_return_facts = pipeline_typed_optimisation_prefix_facts(prefix)
      let opt = pipeline_optimise_ir_function_list(functions, functions, fresh_return_facts, src, tt)
      let promoted_functions = if promote == 1 {
        pipeline_mem2reg_retighten_function_list(pipeline_mem2reg_function_list(pipeline_optimised_functions_functions(opt)), fresh_return_facts, pipeline_ir_pure_callee_tree(fresh_return_facts))
      } else {
        pipeline_optimised_functions_functions(opt)
      }
      pipeline_finish_typed_optimisation(typed, functions, fresh_return_facts, opt, promoted_functions, promote)
    }
  }
}

-- Validate the native stage before packaging it. Keeping this boundary public
-- inside the compiler package lets measurement/tooling compose the same
-- lowering stages without duplicating the fail-closed emission policy.
pub(package) fn pipeline_emit_checked_native_binary(native: NativeModule, src: i64) -> BinaryObject {
  -- An emission error means the code buffer carries BRK traps in place
  -- of real calls. Returning an empty binary makes every frontend fail
  -- instead of writing a poisoned executable that exits 0.
  let errors = pipeline_native_emit_error_count(native)
  if errors != 0 {
    eprint("compile: emission failed with ")
    eprint_i(errors)
    eprint(" errors\n")
    BinaryObject(buf_new(0), binary_format_kind(pipeline_native_binary_format(native)))
  } else { if pipeline_native_unmaterialized_trap_count(native) != 0 {
    eprint("compile: emission retained signal-only traps\n")
    BinaryObject(buf_new(0), binary_format_kind(pipeline_native_binary_format(native)))
  } else {
    pipeline_emit_native_binary(native, src)
  } }
}

-- Product finalization consumes the same NativeModule facts as relocatable
-- object emission. A closed native graph produces an executable directly;
-- the explicit archive residual remains an object only while the archive
-- member resolver is unfinished. No package semantics are inferred here.
pub(package) fn pipeline_native_link_trust_grants(fm: i64) -> List<NativeArtifactTrustGrant> {
  let tt = fmap_get_tt(fm)
  let manifest = ttable_get_root_manifest(tt)
  let mut facts = Nil<NativeArtifactTrustGrant>()
  if manifest != 0 {
    let root_package = pkg_str_view(pkg_manifest_package_start(manifest), pkg_manifest_package_len(manifest))
    let root_version = pkg_str_view(pkg_manifest_version_ptr(manifest), pkg_manifest_version_len(manifest))
    let trusted = pkg_manifest_trusted_bindings(manifest)
    for i in 0..nlist_len(trusted) {
      facts = facts.append(NativeArtifactTrustGrant(
        root_package,
        root_version,
        "path:.",
        "root",
        pkg_manifest_text(nlist_get(trusted, i))
      ))
    }
    let grants = pkg_manifest_trust_grants(manifest)
    for i in 0..nlist_len(grants) {
      let grant = nlist_get(grants, i)
      let modules = pkg_trust_grant_modules(grant)
      for module_index in 0..nlist_len(modules) {
        facts = facts.append(NativeArtifactTrustGrant(
          pkg_str_view(pkg_trust_grant_name_ptr(grant), pkg_trust_grant_name_len(grant)),
          pkg_str_view(pkg_trust_grant_version_ptr(grant), pkg_trust_grant_version_len(grant)),
          pkg_str_view(pkg_trust_grant_source_ptr(grant), pkg_trust_grant_source_len(grant)),
          pkg_str_view(pkg_trust_grant_content_ptr(grant), pkg_trust_grant_content_len(grant)),
          pkg_manifest_text(nlist_get(modules, module_index))
        ))
      }
    }
  } else { 0 }
  let sdk_package = ttable_sdk_package_id(tt)
  let sdk_identity = if sdk_package > 0 { pkg_identity_find_id(tt, sdk_package) } else { 0 }
  if sdk_identity != 0 {
    let sdk_manifest = pkg_identity_manifest(sdk_identity)
    let sdk_name = pkg_str_view(pkg_manifest_package_start(sdk_manifest), pkg_manifest_package_len(sdk_manifest))
    let sdk_version = pkg_str_view(pkg_manifest_version_ptr(sdk_manifest), pkg_manifest_version_len(sdk_manifest))
    let sdk_source = pkg_str_view(pkg_identity_source_ptr(sdk_identity), pkg_identity_source_len(sdk_identity))
    let sdk_content = pkg_str_view(pkg_identity_content_ptr(sdk_identity), pkg_identity_content_len(sdk_identity))
    let trusted = pkg_manifest_trusted_bindings(sdk_manifest)
    for i in 0..nlist_len(trusted) {
      facts = facts.append(NativeArtifactTrustGrant(
        sdk_name,
        sdk_version,
        sdk_source,
        sdk_content,
        pkg_manifest_text(nlist_get(trusted, i))
      ))
    }
  } else { 0 }
  facts
}

pub(package) fn pipeline_native_link_debug_functions(facts: PipelineNativeProvenanceFactList) -> List<NativeLinkDebugFunction> {
  match facts {
    PipelineNativeProvenanceFactNil -> Nil<NativeLinkDebugFunction>()
    PipelineNativeProvenanceFactCons(fact, rest) -> match fact {
      PipelineNativeProvenanceFact(start, end, hash, framed, src, location) -> match location {
        PipelineNativeSourceUnknown -> pipeline_native_link_debug_functions(rest)
        PipelineNativeSourceKnown(name_src, name_start, name_len, path_ptr, path_len, line, col) -> {
          let file = if path_len > 0 { pkg_str_view(path_ptr, path_len) } else { "<stdin>" }
          Cons<NativeLinkDebugFunction>(
            NativeLinkDebugFunction(
              start,
              end,
              pkg_str_view(name_src + name_start, name_len),
              file,
              line,
              col,
              framed == 1
            ),
            pipeline_native_link_debug_functions(rest)
          )
        }
      }
    }
  }
}

pub(package) type PipelineNativeDebugMode {
  PipelineNativeDebugInformationIncluded,
  PipelineNativeDebugInformationStripped
}

pub(package) fn pipeline_native_link_debug_information(native: NativeModule, mode: PipelineNativeDebugMode) -> NativeLinkDebugInformation {
  match mode {
    PipelineNativeDebugInformationStripped -> NativeLinkDebugInformationAbsent
    PipelineNativeDebugInformationIncluded -> {
      let functions = pipeline_native_link_debug_functions(pipeline_native_provenance_facts(native))
      if compiler_signed_count(functions.len()) == 0 { NativeLinkDebugInformationAbsent }
      else { NativeLinkDwarfFunctionLineInformation(functions) }
    }
  }
}

pub(package) fn pipeline_native_link_plan(native: NativeModule, debug_mode: PipelineNativeDebugMode) -> NativeLinkPlan {
  match native {
    NativeModule(code, fm, functions) -> NativeLinkPlan(
      fmap_native_target(fm),
      code,
      native_link_plan_libraries_from_fmap(fm, fmap_native_target(fm)),
      native_link_plan_imports_from_fmap(fm),
      native_link_plan_relocations_from_fmap(fm),
      fmap_static_value_slot_count(fm),
      pipeline_native_link_debug_information(native, debug_mode),
      pipeline_native_link_trust_grants(fm)
    )
  }
}

pub(package) fn pipeline_native_link_outcome(native: NativeModule, debug_mode: PipelineNativeDebugMode) -> NativeLinkOutcome {
  native_link_resolve(pipeline_native_link_plan(native, debug_mode))
}

pub(package) fn pipeline_native_link_relocation_encoding_name(encoding: NativeLinkRelocationEncoding) -> str {
  match encoding {
    NativeLinkBranch26Encoding -> "branch26"
    NativeLinkPage21Encoding -> "page21"
    NativeLinkPageOff12Encoding -> "pageoff12"
    NativeLinkGotPage21Encoding -> "got-page21"
    NativeLinkGotPageOff12Encoding -> "got-pageoff12"
    NativeLinkAbsolute64Encoding -> "absolute64"
    NativeLinkPageAddressEncoding -> "page-address"
  }
}

pub(package) fn pipeline_native_link_report_errors(errors: List<NativeLinkError>) -> i64 {
  let mut current = errors
  let mut done = false
  while done == false {
    match current {
      Nil -> { done = true 0 }
      Cons(error, rest) -> {
        match error {
          NativeLinkUnsupportedSystemLibrary(name) -> {
            eprint("link: unsupported system library '") eprint(name) eprint("'\n")
          }
          NativeLinkUnsupportedTargetLibrary(target, name) -> {
            eprint("link: library '") eprint(name) eprint("' is not supported for target '")
            eprint(native_link_target_name(target)) eprint("'\n")
          }
          NativeLinkMissingArchiveArtifact(name, path) -> {
            eprint("link: selected archive '") eprint(name) eprint("' has no acquired artifact bytes at '") eprint(path) eprint("'\n")
          }
          NativeLinkMalformedArchive(name, path) -> {
            eprint("link: selected archive '") eprint(name) eprint("' is not a supported aarch64 object archive: '") eprint(path) eprint("'\n")
          }
          NativeLinkUndefinedArchiveSymbol(name) -> {
            eprint("link: archive closure leaves undefined symbol '") eprint(name) eprint("'\n")
          }
          NativeLinkDuplicateStrongSymbol(name) -> {
            eprint("link: selected archive members define strong symbol '") eprint(name) eprint("' more than once\n")
          }
          NativeLinkUnsupportedArchiveRelocation(name, kind) -> {
            eprint("link: unsupported aarch64 archive relocation kind ") eprint_i(kind) eprint(" for '") eprint(name) eprint("'\n")
          }
          NativeLinkRelocationSiteOutOfRange(encoding, address) -> {
            eprint("link: ") eprint(pipeline_native_link_relocation_encoding_name(encoding))
            eprint(" relocation site is outside emitted code at byte ") eprint_i(address) eprint("\n")
          }
          NativeLinkRelocationTargetOutOfRange(encoding, address, target) -> {
            eprint("link: ") eprint(pipeline_native_link_relocation_encoding_name(encoding))
            eprint(" relocation target is out of range from byte ") eprint_i(address)
            eprint(" to byte ") eprint_i(target) eprint("\n")
          }
          NativeLinkRelocationTargetMisaligned(encoding, address, target) -> {
            eprint("link: ") eprint(pipeline_native_link_relocation_encoding_name(encoding))
            eprint(" relocation target is not aligned for its instruction from byte ") eprint_i(address)
            eprint(" to byte ") eprint_i(target) eprint("\n")
          }
          NativeLinkMissingDynamicArtifact(name) -> {
            eprint("link: selected dynamic library '") eprint(name) eprint("' has no valid artifact identity\n")
          }
          NativeLinkUndeclaredDynamicDependency(owner, dependency) -> {
            eprint("link: dynamic library '") eprint(owner)
            eprint("' requires undeclared dynamic dependency '") eprint(dependency) eprint("'\n")
          }
          NativeLinkInvalidImportIndex(index) -> {
            eprint("link: invalid import index ") eprint_i(index) eprint("\n")
          }
          NativeLinkInvalidLibraryIndex(index) -> {
            eprint("link: invalid library index ") eprint_i(index) eprint("\n")
          }
        }
        current = rest
        0
      }
    }
  }
  0
}

pub(package) type PipelineNativeProduct {
  PipelineNativeProductReady(BinaryObject, NativeArtifactFacts),
  PipelineNativeProductFailed(BinaryObject)
}

pub(package) fn pipeline_checked_native_product(native: NativeModule, src: i64, debug_mode: PipelineNativeDebugMode) -> PipelineNativeProduct {
  if pipeline_native_emit_error_count(native) != 0 or pipeline_native_unmaterialized_trap_count(native) != 0 {
    PipelineNativeProductFailed(pipeline_emit_checked_native_binary(native, src))
  } else {
    match pipeline_native_link_outcome(native, debug_mode) {
      NativeLinkSucceeded(graph, facts) -> match native_link_graph_target(graph) {
        NativeLinkMacosAarch64 -> PipelineNativeProductReady(
          BinaryObject(emit_native_link_macho(graph), pipeline_binary_kind_macho_executable()),
          facts
        )
        NativeLinkLinuxAarch64 -> match pipeline_emit_native_elf_graph(graph) {
          PipelineElfGraphProductReady(binary) -> PipelineNativeProductReady(binary, facts)
          PipelineElfGraphProductFailed(binary) -> PipelineNativeProductFailed(binary)
        }
      }
      NativeLinkRejected(errors) -> {
        pipeline_native_link_report_errors(errors)
        PipelineNativeProductFailed(BinaryObject(buf_new(0), binary_format_kind(pipeline_native_binary_format(native))))
      }
    }
  }
}

pub(package) fn pipeline_native_artifact_facts_render(facts: NativeArtifactFacts) -> str {
  native_link_artifact_facts_render(facts)
}

pub(package) fn pipeline_emit_checked_native_product_binary(native: NativeModule, src: i64) -> BinaryObject {
  match pipeline_checked_native_product(native, src, PipelineNativeDebugInformationIncluded) {
    PipelineNativeProductReady(binary, facts) -> binary
    PipelineNativeProductFailed(binary) -> binary
  }
}

pub(package) fn pipeline_emit_native_with_debug_mode(typed: TypedModule, debug_mode: PipelineNativeDebugMode) -> BinaryObject {
  match typed {
    TypedModule(fns, src, tt) -> {
      let ir = pipeline_lower_ir(typed)
      let optimised = pipeline_optimise_typed_ir(typed, ir)
      let native = pipeline_lower_native_module_closed(typed, optimised)
      match pipeline_checked_native_product(native, src, debug_mode) {
        PipelineNativeProductReady(binary, facts) -> binary
        PipelineNativeProductFailed(binary) -> binary
      }
    }
  }
}

pub(package) fn pipeline_emit_native_with_debug_mode_and_dependency_product(
  typed: TypedModule,
  debug_mode: PipelineNativeDebugMode,
  product: PipelineOptimisedDependencyProduct
) -> BinaryObject {
  match typed {
    TypedModule(fns, src, tt) -> {
      let ir = pipeline_lower_ir(typed)
      let optimised = pipeline_optimise_typed_ir_with_dependency_product(typed, ir, product)
      let native = pipeline_lower_native_module_closed(typed, optimised)
      match pipeline_checked_native_product(native, src, debug_mode) {
        PipelineNativeProductReady(binary, facts) -> binary
        PipelineNativeProductFailed(binary) -> binary
      }
    }
  }
}

pub(package) fn pipeline_emit_native(typed: TypedModule) -> BinaryObject {
  pipeline_emit_native_with_debug_mode(typed, PipelineNativeDebugInformationIncluded)
}

-- compiler/pipeline_match.weft -- Match lowering helpers

pub(package) fn pipeline_match_ctor_arms_exhaustive(tt: i64, src: i64, arms: i64, n_arms: i64, tag_ns: i64, tag_nl: i64) -> i64 {
  pipeline_match_ctor_arms_exhaustive_typed(tt, src, match_arm_list_from_nodes(arms, 0, n_arms), tag_ns, tag_nl)
}

pub(package) fn pipeline_match_variant_name_matches(src: i64, entry_src: i64, variant: TypeVariant, tag_ns: i64, tag_nl: i64) -> i64 {
  match variant {
    TypeVariant(variant_ns, variant_nl, payload_count, payloads) -> {
      if variant_nl == tag_nl {
        src_eq_at(src, tag_ns, entry_src + variant_ns, 0, tag_nl)
      } else {
        0
      }
    }
    MissingTypeVariant -> 0
  }
}

pub(package) fn pipeline_match_variant_list_has_name(src: i64, entry_src: i64, variants: TypeVariantList, tag_ns: i64, tag_nl: i64) -> i64 {
  match variants {
    TypeVariantListNil -> 0
    TypeVariantListCons(variant, rest) -> {
      if pipeline_match_variant_name_matches(src, entry_src, variant, tag_ns, tag_nl) == 1 {
        1
      } else {
        pipeline_match_variant_list_has_name(src, entry_src, rest, tag_ns, tag_nl)
      }
    }
  }
}

pub(package) fn pipeline_pattern_ctor_source(declaration: i64, fallback: i64) -> i64 { if declaration == 0 { fallback } else { module_decl_fact_source(declaration) } }
pub(package) fn pipeline_pattern_ctor_start(declaration: i64, fallback: i64, source: i64) -> i64 { if declaration == 0 { fallback } else { module_decl_fact_name_ptr(declaration) - source } }

pub(package) fn pipeline_match_arm_has_ctor_typed(arms: MatchArmList, src: i64, entry_src: i64, variant: TypeVariant) -> i64 {
  match arms {
    MatchArmListNil -> 0
    MatchArmListCons(arm, rest) -> {
      let found = match arm {
        Arm(pattern, body, guard, has_guard) -> {
          match pattern {
            CtorPattern(tag_ns, tag_nl, bindings, declaration) -> {
              let ctor_src = pipeline_pattern_ctor_source(declaration, src)
              let ctor_ns = pipeline_pattern_ctor_start(declaration, tag_ns, ctor_src)
              if has_guard == 0 {
                pipeline_match_variant_name_matches(ctor_src, entry_src, variant, ctor_ns, tag_nl)
              } else {
                0
              }
            }
            _ -> 0
          }
        }
        _ -> 0
      }
      if found == 1 { 1 } else { pipeline_match_arm_has_ctor_typed(rest, src, entry_src, variant) }
    }
  }
}

pub(package) fn pipeline_match_arms_cover_variants_typed(arms: MatchArmList, src: i64, entry_src: i64, variants: TypeVariantList) -> i64 {
  match variants {
    TypeVariantListNil -> 1
    TypeVariantListCons(variant, rest) -> {
      if pipeline_match_arm_has_ctor_typed(arms, src, entry_src, variant) == 1 {
        pipeline_match_arms_cover_variants_typed(arms, src, entry_src, rest)
      } else {
        0
      }
    }
  }
}

pub(package) fn pipeline_match_ctor_entry_exhaustive_typed(entry: TypeEntry, src: i64, arms: MatchArmList, tag_ns: i64, tag_nl: i64) -> i64 {
  match entry {
    TypeVariantEntry(name, tparams, variants) -> {
      let entry_src = type_entry_source_or(entry, 0)
      if pipeline_match_variant_list_has_name(src, entry_src, variants, tag_ns, tag_nl) == 1 {
        pipeline_match_arms_cover_variants_typed(arms, src, entry_src, variants)
      } else {
        0 - 1
      }
    }
    _ -> 0 - 1
  }
}

pub(package) fn pipeline_match_ctor_entries_exhaustive_typed(entries: TypeEntryList, src: i64, arms: MatchArmList, tag_ns: i64, tag_nl: i64) -> i64 {
  match entries {
    TypeEntryListNil -> 0
    TypeEntryListCons(entry, rest) -> {
      let found = pipeline_match_ctor_entry_exhaustive_typed(entry, src, arms, tag_ns, tag_nl)
      if found >= 0 {
        found
      } else {
        pipeline_match_ctor_entries_exhaustive_typed(rest, src, arms, tag_ns, tag_nl)
      }
    }
  }
}

pub(package) fn pipeline_match_ctor_arms_exhaustive_typed(tt: i64, src: i64, arms: MatchArmList, tag_ns: i64, tag_nl: i64) -> i64 {
  if tt == 0 {
    0
  } else {
    pipeline_match_ctor_entries_exhaustive_typed(type_entries_from_table(tt), src, arms, tag_ns, tag_nl)
  }
}

pub(package) fn pipeline_lower_match_body_to_blocks(body_expr: Expr, locals: PipelineValueEnv, entry_insts: IrInstList, ctx: PipelineMatchCtx, arm_index: i64, next_value: i64, start_block: i64) -> PipelineLoweredBlocks {
  match ctx {
    PipelineMatchCtx(arms, n_arms, scrutinee_value, params, outer_locals, module, target_block, normalise_owned, scrutinee_ty, result_prim, loop_target_block, loop_normal_block, loop_continue_block, loop_break_mode) -> {
      let src = pipeline_lower_module_src(module)
      let tt = pipeline_lower_module_tt(module)
      let arm = match_arm_list_nth(arms, arm_index)
      let pattern = match_arm_pattern(arm)
      let parent_plan = pipeline_linear_cleanup_plan(tt, scrutinee_ty)
      let ownership_entries = nlist_new()
      let ownership = if parent_plan == 0 {
        pipeline_pattern_ownership_result(0, 0, 1)
      } else {
        pipeline_pattern_ownership_collect(pattern, scrutinee_ty, parent_plan, locals, module, ownership_entries)
      }
      let ownership_valid = match ownership { PipelinePatternOwnership(residual, release_backing, valid, reserved) -> valid }
      let ownership_commit = pipeline_pattern_ownership_commit(
        ownership_entries, 0, scrutinee_value, parent_plan, next_value, ir_inst_list_empty(), tt
      )
      let residual_plan = match ownership { PipelinePatternOwnership(residual, release_backing, valid, reserved) -> residual }
      let release_backing = match ownership { PipelinePatternOwnership(residual, release, valid, reserved) -> release }
      let whole_binding = match pattern { Binding(ns, nl) -> 1 TypedBinding(ns, nl, ann) -> 1 _ -> 0 }
      let split_insts = if parent_plan != 0 and whole_binding == 0 {
        ir_inst_list_prepend(ir_inst_structural_split_i64(scrutinee_value, parent_plan, residual_plan, release_backing), ir_inst_list_empty())
      } else { ir_inst_list_empty() }
      let ownership_entry_insts = ir_inst_list_append(
        entry_insts, ir_inst_list_append(ir_lowered_expr_insts(ownership_commit), split_insts)
      )
      let body_next_value = ir_lowered_expr_next_value(ownership_commit)
      let cleanup_needed = pipeline_pattern_ownership_cleanup_needed(ownership_entries, body_expr, src, tt)
      -- Per-arm ownership normalization (managed aggregate ownership): a borrowed arm in
      -- a mixed borrowed/owned match retains on its way to the merge so
      -- the merged value carries the count consumers assume. See
      -- pipeline_managed_arm_needs_retain.
      let fns = pipeline_lower_module_fns(module)
      let subst = pipeline_lower_module_subst(module)
      let body_ty = pipeline_return_expr_type_node_typed(body_expr, params, locals, module)
      let arm_borrowed = pipeline_expr_result_is_borrowed_with_ctx_typed(body_expr, src, fns, subst, tt)
      let whole_borrowed = if normalise_owned == 1 { 0 } else { pipeline_match_arms_result_is_borrowed_with_ctx_typed(arms, src, fns, subst, tt) }
      let retain_hash = pipeline_managed_arm_needs_retain(arm_borrowed, whole_borrowed, body_ty)
      if ownership_valid == 0 {
        pipeline_lowered_blocks_invalid(start_block, next_value)
      } else { if pipeline_expr_needs_cfg_typed(body_expr) == 1 {
        let body_start = if target_block == start_block + 1 { start_block + 2 } else { start_block + 1 }
        let retain_seed = if target_block == body_start + 1 { body_start + 2 } else { body_start + 1 }
        let retain_block = if retain_hash != 0 { retain_seed } else { 0 }
        let cleanup_seed_raw = if retain_hash != 0 { retain_block + 1 } else { retain_seed }
        let cleanup_seed = pipeline_lower_internal_block_after_target(cleanup_seed_raw, target_block)
        let cleanup_block = if cleanup_needed == 1 { cleanup_seed } else { 0 }
        let after_arm_target = if cleanup_needed == 1 { cleanup_block } else { target_block }
        let body_target = if retain_hash != 0 { retain_block } else { after_arm_target }
        let body_next_seed = if cleanup_needed == 1 { cleanup_block + 1 } else { if retain_hash != 0 { retain_block + 1 } else { body_start + 1 } }
        let body_next = if target_block == body_next_seed { body_next_seed + 1 } else { body_next_seed }
        let body_blocks_raw = if loop_target_block >= 0 {
          let body_loop_ctx = pipeline_loop_ctx_full(
            params, locals, module, loop_target_block, body_target,
            loop_continue_block, loop_break_mode, 0
          )
          let loop_blocks = pipeline_lower_loop_body_to_target_blocks(
            expr_to_node(body_expr), body_loop_ctx, body_next_value, body_start, body_next
          )
          pipeline_lowered_blocks_control(
            pipeline_lowered_loop_blocks_next_block(loop_blocks),
            pipeline_lowered_loop_blocks_next_value(loop_blocks),
            pipeline_lowered_loop_blocks_blocks(loop_blocks),
            pipeline_lowered_loop_blocks_is_valid(loop_blocks),
            pipeline_lowered_loop_blocks_continues_body(loop_blocks)
          )
        } else {
          pipeline_lower_expr_typed_to_target_blocks_reserved_with_float(body_expr, params, locals, module, body_next_value, body_start, body_next, body_target, result_prim)
        }
        let body_blocks = pipeline_managed_arm_retain_append(body_blocks_raw, retain_hash, body_ty, retain_block, after_arm_target)
        if pipeline_lowered_blocks_is_valid(body_blocks) == 1 {
          let inferred_result_lanes = pipeline_type_value_lane_count_or_one(body_ty)
          let result_lanes = pipeline_ir_cleanup_carried_lane_count(body_blocks, cleanup_block, inferred_result_lanes, cleanup_needed)
          let fallthrough_value = pipeline_lowered_blocks_next_value(body_blocks)
          let fallthrough_cleanup = pipeline_pattern_ownership_cleanup(ownership_entries, body_expr, src, tt, fallthrough_value + result_lanes)
          let cleanup_span = ir_lowered_expr_next_value(fallthrough_cleanup) - fallthrough_value - result_lanes
          let return_base = ir_lowered_expr_next_value(fallthrough_cleanup)
          let return_cleaned_blocks = pipeline_ir_block_list_append_return_pattern_cleanup(
            pipeline_lowered_blocks_blocks(body_blocks), ownership_entries, body_expr, src, tt, return_base, 0
          )
          let return_count = pipeline_ir_block_list_return_count(pipeline_lowered_blocks_blocks(body_blocks))
          let loop_base = return_base + return_count * cleanup_span
          let loop_count = if loop_target_block >= 0 {
            pipeline_ir_block_list_loop_pattern_cleanup_count(
              pipeline_lowered_blocks_blocks(body_blocks), loop_continue_block, loop_target_block
            )
          } else { 0 }
          let cleaned_body_blocks = if loop_target_block >= 0 {
            pipeline_ir_block_list_append_loop_pattern_cleanup(
              return_cleaned_blocks, ownership_entries, body_expr, src, tt,
              loop_base, 0, loop_continue_block, loop_target_block
            )
          } else { return_cleaned_blocks }
          let cleanup_node = if cleanup_needed == 1 and pipeline_lowered_blocks_falls_through(body_blocks) == 1 {
            let carried = pipeline_ir_value_lane_ids(fallthrough_value, 0, result_lanes)
            ir_block_list_prepend(
              ir_block_new_params(cleanup_block, carried, ir_lowered_expr_insts(fallthrough_cleanup), ir_term_jump_args(target_block, carried)),
              ir_block_list_empty()
            )
          } else { ir_block_list_empty() }
          let entry = ir_block_new_term(start_block, ownership_entry_insts, ir_term_jump(body_start))
          let blocks = ir_block_list_prepend(entry, ir_block_list_append(cleaned_body_blocks, cleanup_node))
          pipeline_lowered_blocks_control(
            pipeline_lowered_blocks_next_block(body_blocks),
            loop_base + loop_count * cleanup_span,
            blocks,
            1,
            pipeline_lowered_blocks_falls_through(body_blocks)
          )
        } else {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        }
      } else {
        let lower_ctx = pipeline_handler_lower_ctx_from_module(params, locals, module)
        let lowered = if pipeline_prim_is_forced_numeric_context(result_prim) == 1 {
          pipeline_lower_expr_typed_sidecar_handler_opt_with_float_prim(body_expr, body_next_value, lower_ctx, result_prim)
        } else { pipeline_lower_expr_typed_sidecar_handler_ctx(body_expr, body_next_value, lower_ctx) }
        if ir_lowered_expr_is_valid(lowered) == 1 {
          let retain_insts = if retain_hash != 0 {
            pipeline_managed_retain_inst_list_with_origin(ir_lowered_expr_value(lowered), body_ty, ir_lowered_expr_next_value(lowered), ir_managed_stake_origin_arm_normalization())
          } else { ir_inst_list_empty() }
          let after_retain = ir_lowered_expr_next_value(lowered) + ir_inst_list_len(retain_insts)
          let cleanup = pipeline_pattern_ownership_cleanup(ownership_entries, body_expr, src, tt, after_retain)
          let args = pipeline_ir_value_lane_ids(ir_lowered_expr_value(lowered), 0, pipeline_type_value_lane_count_or_one(body_ty))
          let insts = ir_inst_list_append(ownership_entry_insts, ir_inst_list_append(ir_lowered_expr_insts(lowered), ir_inst_list_append(retain_insts, ir_lowered_expr_insts(cleanup))))
          let never_result = pipeline_type_result_never(body_ty)
          let term = if never_result == 1 { ir_term_unreachable() } else { ir_term_jump_args(target_block, args) }
          let block = ir_block_new_term(start_block, insts, term)
          pipeline_lowered_blocks_control(start_block + 1, ir_lowered_expr_next_value(cleanup), ir_block_list_prepend(block, ir_block_list_empty()), 1, 1 - never_result)
        } else {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        }
      } }
    }
  }
}

pub(package) fn pipeline_lower_match_ctor_bindings_to_result(bindings: PatternList, payload_types: i64, subst: i64, parent_ty: i64, tt: i64, payload_index: i64, payload_word: i64, scrutinee_value: i64, locals: PipelineValueEnv, insts: IrInstList, next_value: i64) -> PipelinePatternBindResult {
  match bindings {
    PatternListNil -> PipelinePatternBindResult(locals, insts, next_value, 1)
    PatternListCons(binding, rest) -> {
      match binding {
        Binding(ns, nl) -> {
          let value = next_value
          let payload_float = pipeline_expected_arg_float_prim(0, payload_types, payload_index, 0, subst)
          let payload_ty = pipeline_expected_arg_type_node(0, payload_types, payload_index, 0, subst)
          let payload_view = pipeline_pattern_child_view(parent_ty, payload_ty, tt)
          let payload_lanes = pipeline_type_value_lane_count_or_one(payload_ty)
          let payload = pipeline_ir_variant_payload_lane_insts(value, scrutinee_value, payload_word, payload_ty)
          let payload_type_hash = if payload_ty == 0 { 0 } else { type_hash_of(payload_ty) }
          pipeline_lower_match_ctor_bindings_to_result(
            rest,
            payload_types,
            subst,
            parent_ty,
            tt,
            payload_index + 1,
            payload_word + payload_lanes,
            scrutinee_value,
            pipeline_value_env_push_float_typed_node(locals, ns, nl, value, payload_float, if payload_view == 0 { payload_type_hash } else { type_hash_of(payload_view) }, payload_view),
            ir_inst_list_append(insts, payload),
            next_value + payload_lanes
          )
        }
        _ -> {
          let payload_ty = pipeline_expected_arg_type_node(0, payload_types, payload_index, 0, subst)
          pipeline_lower_match_ctor_bindings_to_result(rest, payload_types, subst, parent_ty, tt, payload_index + 1, payload_word + pipeline_type_value_lane_count_or_one(payload_ty), scrutinee_value, locals, insts, next_value)
        }
      }
    }
  }
}

pub(package) fn pipeline_match_variant_instance_subst(tt: i64, src: i64, tag_ns: i64, tag_nl: i64, scrutinee_ty: i64, fallback_subst: i64) -> i64 {
  let entry = if tt == 0 { 0 } else { ttable_variant_scan(tt, src, tag_ns, tag_nl, 0, 3, 0) }
  if entry == 0 or scrutinee_ty == 0 or ty_tag(scrutinee_ty) != 9 or ty_f3(scrutinee_ty) == 0 or mem_load64_at(entry, 56) != ty_f1(scrutinee_ty) {
    fallback_subst
  } else {
    let tparams = mem_load64_at(entry, 40)
    if tparams == 0 { fallback_subst } else { build_subst(tparams, ty_f3(scrutinee_ty)) }
  }
}

pub(package) fn pipeline_pattern_step_list_append(steps: PipelinePatternStepList, step: PipelinePatternStep) -> PipelinePatternStepList {
  match steps {
    PipelinePatternStepNil -> PipelinePatternStepCons(step, PipelinePatternStepNil)
    PipelinePatternStepCons(head, rest) -> PipelinePatternStepCons(head, pipeline_pattern_step_list_append(rest, step))
  }
}

pub(package) fn pipeline_pattern_step_list_len(steps: PipelinePatternStepList) -> i64 {
  match steps {
    PipelinePatternStepNil -> 0
    PipelinePatternStepCons(step, rest) -> 1 + pipeline_pattern_step_list_len(rest)
  }
}

pub(package) fn pipeline_pattern_nested_list_needs_recursive_lowering(patterns: PatternList) -> i64 {
  match patterns {
    PatternListNil -> 0
    PatternListCons(pattern, rest) -> {
      let needs = match pattern {
        Wildcard -> 0
        Binding(ns, nl) -> 0
        _ -> 1
      }
      if needs == 1 { 1 } else { pipeline_pattern_nested_list_needs_recursive_lowering(rest) }
    }
  }
}

pub(package) fn pipeline_pattern_needs_recursive_lowering(pattern: Pattern) -> i64 {
  match pattern {
    CtorPattern(tag_ns, tag_nl, patterns, declaration) -> {
      if declaration != 0 and module_decl_fact_namespace(declaration) == module_decl_namespace_type() { 1 }
      else { pipeline_pattern_nested_list_needs_recursive_lowering(patterns) }
    }
    RecordPattern(fields) -> 1
    TuplePattern(items) -> 1
    _ -> 0
  }
}

pub(package) fn pipeline_pattern_float_prim_for_type(ty: i64) -> i64 {
  if ty == 0 { 0 }
  else {
    let prim = type_expr_prim_id_or(type_expr_from_node(ty), 0)
    if prim == PRIM_F32() or prim == PRIM_F64() { prim } else { 0 }
  }
}

pub(package) fn pipeline_pattern_child_view(parent_ty: i64, child_ty: i64, tt: i64) -> i64 {
  if not ty_is_borrow(parent_ty) or child_ty == 0 { child_ty }
  else {
    let plan = pipeline_linear_cleanup_plan(tt, child_ty)
    if plan != 0 {
      ty_borrow(if ty_is_owned(child_ty) { ty_owned_inner(child_ty) } else { child_ty })
    } else { child_ty }
  }
}

pub(package) fn pipeline_plan_recursive_pattern(pattern: Pattern, value: i64, value_ty: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, steps: PipelinePatternStepList) -> PipelinePatternPlan {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  match pattern {
    Wildcard -> PipelinePatternPlan(locals, steps, next_value, 1)
    Binding(ns, nl) -> {
      let ty_hash = if value_ty == 0 { 0 } else { type_hash_of(value_ty) }
      let next_locals = pipeline_value_env_push_float_typed_node(locals, ns, nl, value, pipeline_pattern_float_prim_for_type(value_ty), ty_hash, value_ty)
      PipelinePatternPlan(next_locals, steps, next_value, 1)
    }
    IntPattern(expected, start, len) -> {
      let expected_value = next_value
      let cmp_value = next_value + 1
      let insts = ir_inst_list_prepend(
        ir_inst_const_i64(expected_value, expected),
        ir_inst_list_prepend(ir_inst_binary_i64(cmp_value, ir_binary_op_eq(), value, expected_value), ir_inst_list_empty())
      )
      PipelinePatternPlan(locals, pipeline_pattern_step_list_append(steps, PipelinePatternStep(insts, cmp_value)), next_value + 2, 1)
    }
    NilPattern(ns, nl) -> {
      let expected_value = next_value
      let cmp_value = next_value + 1
      let insts = ir_inst_list_prepend(
        ir_inst_const_i64(expected_value, 0),
        ir_inst_list_prepend(ir_inst_binary_i64(cmp_value, ir_binary_op_eq(), value, expected_value), ir_inst_list_empty())
      )
      PipelinePatternPlan(locals, pipeline_pattern_step_list_append(steps, PipelinePatternStep(insts, cmp_value)), next_value + 2, 1)
    }
    TypedBinding(ns, nl, ann) -> {
      let ann_hash = if ann == 0 { 0 } else { type_hash_of(ann) }
      let next_locals = pipeline_value_env_push_float_typed_node(locals, ns, nl, value, pipeline_pattern_float_prim_for_type(ann), ann_hash, ann)
      if value_ty != 0 and ty_narrow_drop_nil(value_ty) != 0 {
        let expected_value = next_value
        let cmp_value = next_value + 1
        let insts = ir_inst_list_prepend(
          ir_inst_const_i64(expected_value, 0),
          ir_inst_list_prepend(ir_inst_binary_i64(cmp_value, ir_binary_op_ne(), value, expected_value), ir_inst_list_empty())
        )
        PipelinePatternPlan(next_locals, pipeline_pattern_step_list_append(steps, PipelinePatternStep(insts, cmp_value)), next_value + 2, 1)
      } else {
        PipelinePatternPlan(next_locals, steps, next_value, 1)
      }
    }
    CtorPattern(tag_ns, tag_nl, children, declaration) -> {
      let destructured_ty = typeck_match_pattern_scrutinee_type(pattern_to_node(pattern), value_ty)
      let opaque_entry = if declaration == 0 { 0 } else { ttable_lookup_decl_fact(tt, declaration) }
      if opaque_entry != 0 and mem_load64_at(opaque_entry, 16) == 5 {
        let representation = pipeline_pattern_opaque_representation(opaque_entry, destructured_ty, module)
        let representation_view = pipeline_pattern_child_view(value_ty, representation, tt)
        let product_steps = pipeline_pattern_step_list_append(steps, PipelinePatternStep(ir_inst_list_empty(), 0 - 1))
        match children {
          PatternListCons(child, PatternListNil) -> pipeline_plan_recursive_pattern(child, value, representation_view, locals, module, next_value, product_steps)
          _ -> PipelinePatternPlan(locals, steps, next_value, 0)
        }
      } else {
      let ctor_src = pipeline_pattern_ctor_source(declaration, src)
      let ctor_ns = pipeline_pattern_ctor_start(declaration, tag_ns, ctor_src)
      let expected_tag = pipeline_variant_tag_hash(tt, ctor_src, ctor_ns, tag_nl)
      if expected_tag < 0 {
        PipelinePatternPlan(locals, steps, next_value, 0)
      } else {
        let tag_value = next_value
        let expected_value = next_value + 1
        let cmp_value = next_value + 2
        let insts = ir_inst_list_prepend(
          ir_inst_variant_tag_i64(tag_value, value),
          ir_inst_list_prepend(
            ir_inst_const_i64(expected_value, expected_tag),
            ir_inst_list_prepend(ir_inst_binary_i64(cmp_value, ir_binary_op_eq(), tag_value, expected_value), ir_inst_list_empty())
          )
        )
        let next_steps = pipeline_pattern_step_list_append(steps, PipelinePatternStep(insts, cmp_value))
        let payload_types = pipeline_variant_payload_types(tt, ctor_src, ctor_ns, tag_nl)
        let subst = pipeline_match_variant_instance_subst(tt, ctor_src, ctor_ns, tag_nl, destructured_ty, pipeline_lower_module_subst(module))
        pipeline_plan_recursive_ctor_children(children, payload_types, subst, value_ty, 0, 0, value, locals, module, next_value + 3, next_steps)
      }
      }
    }
    RecordPattern(fields) -> {
      -- Products have no runtime discriminator once the checker proves the
      -- shape. Keep one unconditional step so a binding-only product still
      -- has a CFG entry and shares the recursive arm path.
      let product_steps = pipeline_pattern_step_list_append(steps, PipelinePatternStep(ir_inst_list_empty(), 0 - 1))
      pipeline_plan_recursive_record_fields(fields, value, value_ty, locals, module, next_value, product_steps)
    }
    TuplePattern(items) -> {
      let product_steps = pipeline_pattern_step_list_append(steps, PipelinePatternStep(ir_inst_list_empty(), 0 - 1))
      pipeline_plan_recursive_tuple_children(items, value, value_ty, 0, 0, locals, module, next_value, product_steps)
    }
    UnknownPattern(tag) -> PipelinePatternPlan(locals, steps, next_value, 0)
  }
}

pub(package) fn pipeline_plan_recursive_ctor_children(children: PatternList, payload_types: i64, subst: i64, parent_ty: i64, payload_index: i64, payload_word: i64, base_value: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, steps: PipelinePatternStepList) -> PipelinePatternPlan {
  match children {
    PatternListNil -> PipelinePatternPlan(locals, steps, next_value, 1)
    PatternListCons(child, rest) -> {
      let child_ty = pipeline_expected_arg_type_node(0, payload_types, payload_index, 0, subst)
      let child_view = pipeline_pattern_child_view(parent_ty, child_ty, pipeline_lower_module_tt(module))
      let child_lanes = pipeline_type_value_lane_count_or_one(child_ty)
      match child {
        Wildcard -> pipeline_plan_recursive_ctor_children(rest, payload_types, subst, parent_ty, payload_index + 1, payload_word + child_lanes, base_value, locals, module, next_value, steps)
        _ -> {
          let child_value = next_value
          let loads = pipeline_ir_variant_payload_lane_insts(child_value, base_value, payload_word, child_ty)
          let loaded_steps = pipeline_pattern_step_list_append(steps, PipelinePatternStep(loads, 0 - 1))
          match pipeline_plan_recursive_pattern(child, child_value, child_view, locals, module, next_value + child_lanes, loaded_steps) {
            PipelinePatternPlan(child_locals, child_steps, after_child, valid) -> {
              if valid == 0 { PipelinePatternPlan(locals, steps, next_value, 0) }
              else { pipeline_plan_recursive_ctor_children(rest, payload_types, subst, parent_ty, payload_index + 1, payload_word + child_lanes, base_value, child_locals, module, after_child, child_steps) }
            }
          }
        }
      }
    }
  }
}

pub(package) fn pipeline_pattern_nominal_record_layout(value_ty: i64, module: PipelineLowerModule) -> PipelineRecordStorageLayout {
  let tt = pipeline_lower_module_tt(module)
  let entry = ttable_lookup_named_type(tt, value_ty)
  if entry == 0 { PipelineRecordStorageLayoutInvalid }
  else {
    let subst = pipeline_record_instance_subst(entry, value_ty, pipeline_lower_module_subst(module))
    pipeline_record_storage_layout_for_entry(tt, entry, subst)
  }
}

pub(package) fn pipeline_plan_recursive_record_fields(fields: PatternFieldList, base_value: i64, base_ty: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, steps: PipelinePatternStepList) -> PipelinePatternPlan {
  let layout_ty = if ty_is_borrow(base_ty) { ty_borrow_inner(base_ty) } else { base_ty }
  match fields {
    PatternFieldListNil -> PipelinePatternPlan(locals, steps, next_value, 1)
    PatternFieldListCons(field, rest) -> {
      match field {
        PatternField(ns, nl, child, fact) -> {
          let raw_ty = field_access_fact_field_type_node(fact)
          let child_ty = if raw_ty == 0 { 0 } else { ty_subst(raw_ty, pipeline_lower_module_subst(module)) }
          let child_view = pipeline_pattern_child_view(base_ty, child_ty, pipeline_lower_module_tt(module))
          let field_hash = str_hash(pipeline_lower_module_src(module), ns, nl)
          let fact_offset = field_access_fact_word_offset_or(fact, 0 - 1)
          let structural = if ty_is_record(layout_ty) { 1 } else { 0 }
          let word_offset = if structural == 1 { ty_record_field_word_offset(layout_ty, field_hash) }
            else {
              let entry = ttable_lookup_named_type(pipeline_lower_module_tt(module), layout_ty)
              let record_subst = pipeline_record_instance_subst(entry, layout_ty, pipeline_lower_module_subst(module))
              let specialised = pipeline_record_field_word_offset_in_entry(entry, pipeline_lower_module_src(module), ns, nl, record_subst)
              if specialised >= 0 { specialised } else { fact_offset }
            }
          match child {
            Wildcard -> pipeline_plan_recursive_record_fields(rest, base_value, base_ty, locals, module, next_value, steps)
            _ -> {
              if word_offset < 0 or child_ty == 0 {
                PipelinePatternPlan(locals, steps, next_value, 0)
              } else { if structural == 1 {
                match pipeline_plan_recursive_pattern(child, base_value + word_offset, child_view, locals, module, next_value, steps) {
                  PipelinePatternPlan(child_locals, child_steps, after_child, valid) -> {
                    if valid == 0 { PipelinePatternPlan(locals, steps, next_value, 0) }
                    else { pipeline_plan_recursive_record_fields(rest, base_value, base_ty, child_locals, module, after_child, child_steps) }
                  }
                }
              } else {
                let loaded = pipeline_lower_field_load_for_storage_layout(next_value, base_value, field_hash, word_offset, child_ty, pipeline_pattern_nominal_record_layout(layout_ty, module))
                if ir_lowered_expr_is_valid(loaded) == 0 {
                  PipelinePatternPlan(locals, steps, next_value, 0)
                } else {
                  let load_steps = pipeline_pattern_step_list_append(steps, PipelinePatternStep(ir_lowered_expr_insts(loaded), 0 - 1))
                  match pipeline_plan_recursive_pattern(child, ir_lowered_expr_value(loaded), child_view, locals, module, ir_lowered_expr_next_value(loaded), load_steps) {
                    PipelinePatternPlan(child_locals, child_steps, after_child, valid) -> {
                      if valid == 0 { PipelinePatternPlan(locals, steps, next_value, 0) }
                      else { pipeline_plan_recursive_record_fields(rest, base_value, base_ty, child_locals, module, after_child, child_steps) }
                    }
                  }
                }
              } }
            }
          }
        }
        UnknownPatternField(tag) -> PipelinePatternPlan(locals, steps, next_value, 0)
      }
    }
  }
}

pub(package) fn pipeline_plan_recursive_tuple_children(items: PatternList, base_value: i64, tuple_ty: i64, index: i64, word_offset: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, steps: PipelinePatternStepList) -> PipelinePatternPlan {
  let layout_ty = if ty_is_borrow(tuple_ty) { ty_borrow_inner(tuple_ty) } else { tuple_ty }
  match items {
    PatternListNil -> PipelinePatternPlan(locals, steps, next_value, 1)
    PatternListCons(child, rest) -> {
      let field = ty_record_field_at_layout_index(layout_ty, index)
      let child_ty = if field == 0 { 0 } else { ty_record_field_type(field) }
      let child_view = pipeline_pattern_child_view(tuple_ty, child_ty, pipeline_lower_module_tt(module))
      let lanes = pipeline_type_value_lane_count_or_one(child_ty)
      if child_ty == 0 {
        PipelinePatternPlan(locals, steps, next_value, 0)
      } else {
        match child {
          Wildcard -> pipeline_plan_recursive_tuple_children(rest, base_value, tuple_ty, index + 1, word_offset + lanes, locals, module, next_value, steps)
          _ -> match pipeline_plan_recursive_pattern(child, base_value + word_offset, child_view, locals, module, next_value, steps) {
            PipelinePatternPlan(child_locals, child_steps, after_child, valid) -> {
              if valid == 0 { PipelinePatternPlan(locals, steps, next_value, 0) }
              else { pipeline_plan_recursive_tuple_children(rest, base_value, tuple_ty, index + 1, word_offset + lanes, child_locals, module, after_child, child_steps) }
            }
          }
        }
      }
    }
  }
}

pub(package) fn pipeline_pattern_ownership_result(residual: i64, release_backing: i64, valid: i64) -> PipelinePatternOwnership {
  PipelinePatternOwnership(residual, release_backing, valid, 0)
}

pub(package) fn pipeline_pattern_ownership_add_binding(entries: i64, pattern: Pattern, value_ty: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> i64 {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  if ty_is_borrow(value_ty) { 1 }
  else {
  match pattern {
    Binding(ns, nl) -> {
      let value = pipeline_value_env_lookup(locals, src, ns, nl)
      let plan = pipeline_linear_cleanup_plan(tt, value_ty)
      if value < 0 { 0 }
      else { if plan != 0 { nlist_add(entries, node_new(1, value, value_ty, ns, nl)) }
      else { if value_ty != 0 and ty_value_has_release_lane(value_ty) == 1 { nlist_add(entries, node_new(2, value, value_ty, ns, nl)) } else { 0 } } }
      1
    }
    TypedBinding(ns, nl, ann) -> {
      let value = pipeline_value_env_lookup(locals, src, ns, nl)
      let ty = if ann == 0 { value_ty } else { ann }
      let plan = pipeline_linear_cleanup_plan(tt, ty)
      if value < 0 { 0 }
      else { if plan != 0 { nlist_add(entries, node_new(1, value, ty, ns, nl)) }
      else { if ty != 0 and ty_value_has_release_lane(ty) == 1 { nlist_add(entries, node_new(2, value, ty, ns, nl)) } else { 0 } } }
      1
    }
    _ -> 0
  }
  }
}

pub(package) fn pipeline_pattern_ownership_component_at(components: i64, index: i64) -> i64 {
  let mut found = 0
  let count = if components == 0 { 0 } else { nlist_len(components) }
  let mut i = 0
  while i < count and found == 0 {
    let component = nlist_get(components, i)
    if typeck_linear_layout_component_index(component) == index { found = component } else { i = i + 1 }
  }
  found
}

pub(package) fn pipeline_pattern_ownership_component_hash(components: i64, field_hash: i64) -> i64 {
  let mut found = 0
  let count = if components == 0 { 0 } else { nlist_len(components) }
  let mut i = 0
  while i < count and found == 0 {
    let component = nlist_get(components, i)
    if typeck_linear_layout_component_key(component) == field_hash { found = component } else { i = i + 1 }
  }
  found
}

pub(package) fn pipeline_pattern_ownership_variant_alternative(plan: i64, tag_hash: i64) -> i64 {
  if plan == 0 or typeck_linear_layout_plan_kind(plan) != 5 { 0 }
  else { pipeline_ir_abort_cleanup_variant_alternative_for_tag(typeck_linear_layout_plan_children(plan), tag_hash) }
}

pub(package) fn pipeline_pattern_ownership_pattern_list(patterns: PatternList, payload_types: i64, subst: i64, parent_ty: i64, index: i64, plan_components: i64, locals: PipelineValueEnv, module: PipelineLowerModule, entries: i64, residuals: i64) -> i64 {
  match patterns {
    PatternListNil -> 1
    PatternListCons(pattern, rest) -> {
      let child_ty = pipeline_expected_arg_type_node(0, payload_types, index, 0, subst)
      let child_view = pipeline_pattern_child_view(parent_ty, child_ty, pipeline_lower_module_tt(module))
      let component = pipeline_pattern_ownership_component_at(plan_components, index)
      let child_plan = if component == 0 { 0 } else { typeck_linear_layout_component_plan(component) }
      match pipeline_pattern_ownership_collect(pattern, child_view, child_plan, locals, module, entries) {
        PipelinePatternOwnership(residual, release_backing, valid, reserved) -> {
          if valid == 0 { 0 }
          else {
            if residual != 0 {
              let carried = if component != 0 {
                typeck_linear_layout_component(
                  typeck_linear_layout_component_kind(component), typeck_linear_layout_component_key(component),
                  typeck_linear_layout_component_index(component), typeck_linear_layout_component_offset(component), residual
                )
              } else { typeck_linear_layout_component(3, 0, index, index + 1, residual) }
              nlist_add(residuals, carried)
            } else { 0 }
            pipeline_pattern_ownership_pattern_list(rest, payload_types, subst, parent_ty, index + 1, plan_components, locals, module, entries, residuals)
          }
        }
      }
    }
  }
}

pub(package) fn pipeline_pattern_ownership_record_fields(fields: PatternFieldList, parent_ty: i64, plan_components: i64, locals: PipelineValueEnv, module: PipelineLowerModule, entries: i64, residuals: i64, seen: i64) -> i64 {
  match fields {
    PatternFieldListNil -> 1
    PatternFieldListCons(field, rest) -> {
      match field {
        PatternField(ns, nl, pattern, fact) -> {
          let raw_ty = field_access_fact_field_type_node(fact)
          let child_ty = if raw_ty == 0 { 0 } else { ty_subst(raw_ty, pipeline_lower_module_subst(module)) }
          let child_view = pipeline_pattern_child_view(parent_ty, child_ty, pipeline_lower_module_tt(module))
          let field_hash = str_hash(pipeline_lower_module_src(module), ns, nl)
          let component = pipeline_pattern_ownership_component_hash(plan_components, field_hash)
          let child_plan = if component == 0 { 0 } else { typeck_linear_layout_component_plan(component) }
          match pipeline_pattern_ownership_collect(pattern, child_view, child_plan, locals, module, entries) {
            PipelinePatternOwnership(residual, release_backing, valid, reserved) -> {
              if valid == 0 { 0 }
              else {
                nlist_add(seen, field_hash)
                if residual != 0 and component != 0 {
                  nlist_add(residuals, typeck_linear_layout_component(
                    typeck_linear_layout_component_kind(component), typeck_linear_layout_component_key(component),
                    typeck_linear_layout_component_index(component), typeck_linear_layout_component_offset(component), residual
                  ))
                } else { 0 }
                pipeline_pattern_ownership_record_fields(rest, parent_ty, plan_components, locals, module, entries, residuals, seen)
              }
            }
          }
        }
        UnknownPatternField(tag) -> 0
      }
    }
  }
}

pub(package) fn pipeline_pattern_ownership_hash_seen(seen: i64, hash: i64) -> i64 {
  let mut found = 0
  let mut i = 0
  while i < nlist_len(seen) and found == 0 {
    if nlist_get(seen, i) == hash { found = 1 } else { i = i + 1 }
  }
  found
}

-- Rebuild a record residual in semantic declaration order. Patterns are free
-- to spell fields in any order, but Drop order belongs to the layout fact,
-- never the source pattern traversal.
pub(package) fn pipeline_pattern_ownership_canonical_record_components(components: i64, seen: i64, replacements: i64) -> i64 {
  let residuals = nlist_new()
  let count = if components == 0 { 0 } else { nlist_len(components) }
  for i in 0..count {
    let component = nlist_get(components, i)
    let replacement = pipeline_pattern_ownership_component_hash(replacements, typeck_linear_layout_component_key(component))
    if replacement != 0 { nlist_add(residuals, replacement) }
    else { if pipeline_pattern_ownership_hash_seen(seen, typeck_linear_layout_component_key(component)) == 0 {
      nlist_add(residuals, component)
    } else { 0 } }
  }
  residuals
}

pub(package) fn pipeline_pattern_ownership_tuple_items(items: PatternList, tuple_ty: i64, index: i64, plan_components: i64, locals: PipelineValueEnv, module: PipelineLowerModule, entries: i64, residuals: i64) -> i64 {
  match items {
    PatternListNil -> 1
    PatternListCons(pattern, rest) -> {
      let destructured_ty = if ty_is_borrow(tuple_ty) { ty_borrow_inner(tuple_ty) } else { tuple_ty }
      let field = ty_record_field_at_layout_index(destructured_ty, index)
      let child_ty = if field == 0 { 0 } else { ty_record_field_type(field) }
      let child_view = pipeline_pattern_child_view(tuple_ty, child_ty, pipeline_lower_module_tt(module))
      let component = pipeline_pattern_ownership_component_at(plan_components, index)
      let child_plan = if component == 0 { 0 } else { typeck_linear_layout_component_plan(component) }
      match pipeline_pattern_ownership_collect(pattern, child_view, child_plan, locals, module, entries) {
        PipelinePatternOwnership(residual, release_backing, valid, reserved) -> {
          if valid == 0 { 0 }
          else {
            if residual != 0 and component != 0 {
              nlist_add(residuals, typeck_linear_layout_component(
                typeck_linear_layout_component_kind(component), typeck_linear_layout_component_key(component),
                typeck_linear_layout_component_index(component), typeck_linear_layout_component_offset(component), residual
              ))
            } else { 0 }
            pipeline_pattern_ownership_tuple_items(rest, tuple_ty, index + 1, plan_components, locals, module, entries, residuals)
          }
        }
      }
    }
  }
}

pub(package) fn pipeline_pattern_ownership_collect(pattern: Pattern, value_ty: i64, plan: i64, locals: PipelineValueEnv, module: PipelineLowerModule, entries: i64) -> PipelinePatternOwnership {
  let tt = pipeline_lower_module_tt(module)
  match pattern {
    Wildcard -> pipeline_pattern_ownership_result(plan, 0, 1)
    Binding(ns, nl) -> {
      pipeline_pattern_ownership_add_binding(entries, pattern, value_ty, locals, module)
      pipeline_pattern_ownership_result(0, 0, 1)
    }
    TypedBinding(ns, nl, ann) -> {
      pipeline_pattern_ownership_add_binding(entries, pattern, value_ty, locals, module)
      pipeline_pattern_ownership_result(0, 0, 1)
    }
    IntPattern(expected, start, len) -> pipeline_pattern_ownership_result(plan, 0, 1)
    NilPattern(ns, nl) -> pipeline_pattern_ownership_result(plan, 0, 1)
    CtorPattern(tag_ns, tag_nl, children, declaration) -> {
      let destructured_ty = typeck_match_pattern_scrutinee_type(pattern_to_node(pattern), value_ty)
      let opaque_entry = if declaration == 0 { 0 } else { ttable_lookup_decl_fact(tt, declaration) }
      if opaque_entry != 0 and mem_load64_at(opaque_entry, 16) == 5 {
        let representation = pipeline_pattern_opaque_representation(opaque_entry, destructured_ty, module)
        let representation_view = pipeline_pattern_child_view(value_ty, representation, tt)
        let child_plan = if plan != 0 and typeck_linear_layout_plan_kind(plan) == 6 { typeck_linear_layout_plan_children(plan) } else { 0 }
        match children {
          PatternListCons(child, PatternListNil) -> match pipeline_pattern_ownership_collect(child, representation_view, child_plan, locals, module, entries) {
            PipelinePatternOwnership(residual, child_release, valid, reserved) -> {
              pipeline_pattern_ownership_result(typeck_linear_layout_residual_wrapper_plan(plan, residual), child_release, valid)
            }
          }
          _ -> pipeline_pattern_ownership_result(0, 0, 0)
        }
      } else {
        let ctor_src = pipeline_pattern_ctor_source(declaration, pipeline_lower_module_src(module))
        let ctor_ns = pipeline_pattern_ctor_start(declaration, tag_ns, ctor_src)
        let tag_hash = pipeline_variant_tag_hash(tt, ctor_src, ctor_ns, tag_nl)
        let payload_types = pipeline_variant_payload_types(tt, ctor_src, ctor_ns, tag_nl)
        let subst = pipeline_match_variant_instance_subst(tt, ctor_src, ctor_ns, tag_nl, destructured_ty, pipeline_lower_module_subst(module))
        let alternative = pipeline_pattern_ownership_variant_alternative(plan, tag_hash)
        let plan_components = if alternative == 0 { 0 } else { typeck_linear_layout_variant_payloads(alternative) }
        let residuals = nlist_new()
        let valid = pipeline_pattern_ownership_pattern_list(children, payload_types, subst, value_ty, 0, plan_components, locals, module, entries, residuals)
        if valid == 0 { pipeline_pattern_ownership_result(0, 0, 0) }
        else {
          let alternatives = nlist_new()
          if nlist_len(residuals) > 0 {
            let alt_index = if alternative == 0 { 0 } else { typeck_linear_layout_variant_index(alternative) }
            let words = if alternative == 0 { 1 } else { typeck_linear_layout_variant_words(alternative) }
            nlist_add(alternatives, typeck_linear_layout_variant_alternative(tag_hash, alt_index, residuals, words))
          } else { 0 }
          let residual = typeck_linear_layout_residual_plan(plan, alternatives)
          let exact_residual = if residual == 0 and plan != 0 and pipeline_structural_drop_plan_storage_mode(plan) == 3 {
            typeck_linear_layout_residual_backing_plan(plan)
          } else { residual }
          pipeline_pattern_ownership_result(exact_residual, 0, 1)
        }
      }
    }
    RecordPattern(fields) -> {
      let components = if plan == 0 { 0 } else { typeck_linear_layout_plan_children(plan) }
      let replacements = nlist_new()
      let seen = nlist_new()
      let valid = pipeline_pattern_ownership_record_fields(fields, value_ty, components, locals, module, entries, replacements, seen)
      let residuals = pipeline_pattern_ownership_canonical_record_components(components, seen, replacements)
      if valid == 0 { pipeline_pattern_ownership_result(0, 0, 0) }
      else {
        let residual = typeck_linear_layout_residual_plan(plan, residuals)
        let exact_residual = if residual == 0 and plan != 0 and pipeline_structural_drop_plan_storage_mode(plan) == 3 {
          typeck_linear_layout_residual_backing_plan(plan)
        } else { residual }
        pipeline_pattern_ownership_result(exact_residual, 0, 1)
      }
    }
    TuplePattern(items) -> {
      let components = if plan == 0 { 0 } else { typeck_linear_layout_plan_children(plan) }
      let residuals = nlist_new()
      let valid = pipeline_pattern_ownership_tuple_items(items, value_ty, 0, components, locals, module, entries, residuals)
      if valid == 0 { pipeline_pattern_ownership_result(0, 0, 0) }
      else { pipeline_pattern_ownership_result(typeck_linear_layout_residual_plan(plan, residuals), 0, 1) }
    }
    UnknownPattern(tag) -> pipeline_pattern_ownership_result(0, 0, 0)
  }
}

pub(package) fn pipeline_pattern_ownership_commit(entries: i64, index: i64, parent_value: i64, parent_plan: i64, next_value: i64, insts: IrInstList, tt: i64) -> IrLoweredExpr {
  if entries == 0 or index >= nlist_len(entries) { ir_lowered_expr(0, next_value, insts) }
  else {
    let entry = nlist_get(entries, index)
    let kind = node_tag(entry)
    let value = node_f1(entry)
    let ty = node_f2(entry)
    let add = if kind == 1 {
      let entry_plan = pipeline_linear_cleanup_plan(tt, ty)
      if value == parent_value and entry_plan != 0 and parent_plan != 0 and typeck_linear_layout_plan_identity(entry_plan) == typeck_linear_layout_plan_identity(parent_plan) {
        ir_inst_list_empty()
      } else { ir_inst_list_prepend(ir_inst_bind_typed_i64(node_f3(entry), node_f4(entry), value, ty), ir_inst_list_empty()) }
    } else { if kind == 2 {
      pipeline_managed_retain_inst_list_with_origin(value, ty, next_value, ir_managed_stake_origin_binding())
    } else { ir_inst_list_empty() } }
    pipeline_pattern_ownership_commit(entries, index + 1, parent_value, parent_plan, next_value + ir_inst_list_len(add), ir_inst_list_append(insts, add), tt)
  }
}

pub(package) fn pipeline_pattern_ownership_cleanup(entries: i64, body: Expr, src: i64, tt: i64, next_value: i64) -> IrLoweredExpr {
  let mut insts = ir_inst_list_empty()
  let mut next = next_value
  let count = if entries == 0 { 0 } else { nlist_len(entries) }
  for reverse_index in 0..count {
    let entry = nlist_get(entries, count - reverse_index - 1)
    let kind = node_tag(entry)
    let value = node_f1(entry)
    let ty = node_f2(entry)
    let ns = node_f3(entry)
    let nl = node_f4(entry)
    let cleanup = if kind == 1 {
      let plan = pipeline_linear_cleanup_plan(tt, ty)
      if plan != 0 and pipeline_expr_refs_name_typed(body, src, ns, nl) == 0 {
        pipeline_linear_cleanup_inst_list(value, plan)
      } else { ir_inst_list_empty() }
    } else { if kind == 2 {
      if pipeline_expr_final_returns_binding_typed(body, src, ns, nl) == 1 { ir_inst_list_empty() }
      else { pipeline_managed_release_inst_list_with_origin(value, ty, next, ir_managed_stake_origin_binding()) }
    } else { ir_inst_list_empty() } }
    insts = ir_inst_list_append(insts, cleanup)
    next = next + ir_inst_list_len(cleanup)
  }
  ir_lowered_expr(0, next, insts)
}

pub(package) fn pipeline_pattern_ownership_cleanup_needed(entries: i64, body: Expr, src: i64, tt: i64) -> i64 {
  let cleanup = pipeline_pattern_ownership_cleanup(entries, body, src, tt, 0)
  if ir_inst_list_len(ir_lowered_expr_insts(cleanup)) > 0 { 1 } else { 0 }
}

pub(package) fn pipeline_ir_block_list_append_return_pattern_cleanup(blocks: IrBlockList, entries: i64, body: Expr, src: i64, tt: i64, base_dst: i64, return_index: i64) -> IrBlockList {
  match blocks {
    IrBlockListNil -> IrBlockListNil
    IrBlockListCons(block, rest) -> {
      let applies = match block {
        IrBlock(id, params, insts, term) -> match term { IrTermReturn(value) -> 1 _ -> 0 }
      }
      let patched = if applies == 1 {
        let stride_probe = pipeline_pattern_ownership_cleanup(entries, body, src, tt, 0)
        let stride = ir_lowered_expr_next_value(stride_probe)
        let cleanup = pipeline_pattern_ownership_cleanup(entries, body, src, tt, base_dst + return_index * stride)
        match block {
          IrBlock(id, params, insts, term) -> IrBlock(id, params, ir_inst_list_append(insts, ir_lowered_expr_insts(cleanup)), term)
        }
      } else { block }
      IrBlockListCons(
        patched,
        pipeline_ir_block_list_append_return_pattern_cleanup(rest, entries, body, src, tt, base_dst, return_index + applies)
      )
    }
  }
}

pub(package) fn pipeline_ir_term_jumps_to_loop_control(term: IrTerminator, continue_block: i64, target_block: i64) -> i64 {
  match term {
    IrTermJump(target, args) -> if target == continue_block or target == target_block { 1 } else { 0 }
    _ -> 0
  }
}

pub(package) fn pipeline_ir_block_list_loop_pattern_cleanup_count(blocks: IrBlockList, continue_block: i64, target_block: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      let applies = match block {
        IrBlock(id, params, insts, term) -> pipeline_ir_term_jumps_to_loop_control(term, continue_block, target_block)
      }
      applies + pipeline_ir_block_list_loop_pattern_cleanup_count(rest, continue_block, target_block)
    }
  }
}

pub(package) fn pipeline_ir_block_list_append_loop_pattern_cleanup(blocks: IrBlockList, entries: i64, body: Expr, src: i64, tt: i64, base_dst: i64, index: i64, continue_block: i64, target_block: i64) -> IrBlockList {
  match blocks {
    IrBlockListNil -> IrBlockListNil
    IrBlockListCons(block, rest) -> {
      let applies = match block {
        IrBlock(id, params, insts, term) -> pipeline_ir_term_jumps_to_loop_control(term, continue_block, target_block)
      }
      let patched = if applies == 1 {
        let stride_probe = pipeline_pattern_ownership_cleanup(entries, body, src, tt, 0)
        let stride = ir_lowered_expr_next_value(stride_probe)
        let cleanup = pipeline_pattern_ownership_cleanup(entries, body, src, tt, base_dst + index * stride)
        match block {
          IrBlock(id, params, insts, term) -> IrBlock(id, params, ir_inst_list_append(insts, ir_lowered_expr_insts(cleanup)), term)
        }
      } else { block }
      IrBlockListCons(
        patched,
        pipeline_ir_block_list_append_loop_pattern_cleanup(rest, entries, body, src, tt, base_dst, index + applies, continue_block, target_block)
      )
    }
  }
}

pub(package) fn pipeline_pattern_block_after_steps(block: i64, steps: PipelinePatternStepList, target_block: i64) -> i64 {
  match steps {
    PipelinePatternStepNil -> block
    PipelinePatternStepCons(step, rest) -> pipeline_pattern_block_after_steps(pipeline_lower_internal_block_after_target(block + 1, target_block), rest, target_block)
  }
}

pub(package) fn pipeline_pattern_steps_to_blocks(steps: PipelinePatternStepList, block: i64, success_block: i64, failure_block: i64, target_block: i64) -> IrBlockList {
  match steps {
    PipelinePatternStepNil -> ir_block_list_empty()
    PipelinePatternStepCons(step, rest) -> {
      match step {
        PipelinePatternStep(insts, condition) -> {
          let next = match rest {
            PipelinePatternStepNil -> success_block
            _ -> pipeline_lower_internal_block_after_target(block + 1, target_block)
          }
          let term = if condition < 0 { ir_term_jump(next) } else { ir_term_branch(condition, next, failure_block) }
          ir_block_list_prepend(ir_block_new_term(block, insts, term), pipeline_pattern_steps_to_blocks(rest, next, success_block, failure_block, target_block))
        }
      }
    }
  }
}

pub(package) fn pipeline_lower_match_recursive_pattern_arm_to_blocks(ctx: PipelineMatchCtx, index: i64, next_value: i64, start_block: i64) -> PipelineLoweredBlocks {
  match ctx {
    PipelineMatchCtx(arms, n_arms, scrutinee_value, params, locals, module, target_block, normalise_owned, scrutinee_ty, result_prim, loop_target_block, loop_normal_block, loop_continue_block, loop_break_mode) -> {
      let arm = match_arm_list_nth(arms, index)
      let pat = match_arm_pattern(arm)
      match pipeline_plan_recursive_pattern(pat, scrutinee_value, scrutinee_ty, locals, module, next_value, PipelinePatternStepNil) {
        PipelinePatternPlan(pattern_locals, steps, after_pattern, valid) -> {
          if valid == 0 or pipeline_pattern_step_list_len(steps) == 0 {
            pipeline_lowered_blocks_invalid(start_block, next_value)
          } else {
            let success_start = pipeline_pattern_block_after_steps(start_block, steps, target_block)
            if match_arm_has_guard(arm) == 1 {
              let rest_gate = pipeline_lower_internal_block_after_target(success_start + 1, target_block)
              let guarded = pipeline_lower_match_cfg_guarded_arm_to_blocks(ctx, index, pattern_locals, ir_inst_list_empty(), after_pattern, success_start, rest_gate)
              if pipeline_lowered_blocks_is_valid(guarded) == 0 {
                pipeline_lowered_blocks_invalid(start_block, next_value)
              } else {
                let pattern_blocks = pipeline_pattern_steps_to_blocks(steps, start_block, success_start, rest_gate, target_block)
                pipeline_lowered_blocks_control(
                  pipeline_lowered_blocks_next_block(guarded),
                  pipeline_lowered_blocks_next_value(guarded),
                  ir_block_list_append(pattern_blocks, pipeline_lowered_blocks_blocks(guarded)),
                  1,
                  pipeline_lowered_blocks_falls_through(guarded)
                )
              }
            } else {
              let body = pipeline_lower_match_body_to_blocks(match_arm_body_expr(arm), pattern_locals, ir_inst_list_empty(), ctx, index, after_pattern, success_start)
              if pipeline_lowered_blocks_is_valid(body) == 0 {
                pipeline_lowered_blocks_invalid(start_block, next_value)
              } else {
                let rest_start = pipeline_lowered_blocks_next_block(body)
                let rest = pipeline_lower_match_rest_to_blocks(ctx, index + 1, pipeline_lowered_blocks_next_value(body), rest_start, rest_start + 1)
                if pipeline_lowered_blocks_is_valid(rest) == 0 {
                  pipeline_lowered_blocks_invalid(start_block, next_value)
                } else {
                  let pattern_blocks = pipeline_pattern_steps_to_blocks(steps, start_block, success_start, rest_start, target_block)
                  let blocks = ir_block_list_append(pattern_blocks, ir_block_list_append(pipeline_lowered_blocks_blocks(body), pipeline_lowered_blocks_blocks(rest)))
                  let falls = if pipeline_lowered_blocks_falls_through(body) == 1 { 1 } else { pipeline_lowered_blocks_falls_through(rest) }
                  pipeline_lowered_blocks_control(pipeline_lowered_blocks_next_block(rest), pipeline_lowered_blocks_next_value(rest), blocks, 1, falls)
                }
              }
            }
          }
        }
      }
    }
  }
}

pub(package) fn pipeline_lower_match_ctor_body_to_blocks(pat: Pattern, body: Expr, ctx: PipelineMatchCtx, arm_index: i64, next_value: i64, start_block: i64) -> PipelineLoweredBlocks {
  match ctx {
    PipelineMatchCtx(arms, n_arms, scrutinee_value, params, locals, module, target_block, normalise_owned, scrutinee_ty, result_prim, loop_target_block, loop_normal_block, loop_continue_block, loop_break_mode) -> {
      let src = pipeline_lower_module_src(module)
      let tt = pipeline_lower_module_tt(module)
      match pat {
        CtorPattern(tag_ns, tag_nl, bindings, declaration) -> {
          let ctor_src = pipeline_pattern_ctor_source(declaration, src)
          let ctor_ns = pipeline_pattern_ctor_start(declaration, tag_ns, ctor_src)
          let tag_hash = pipeline_variant_tag_hash(tt, ctor_src, ctor_ns, tag_nl)
          if tag_hash < 0 {
            pipeline_lowered_blocks_invalid(start_block, next_value)
          } else {
            let payload_types = pipeline_variant_payload_types(tt, ctor_src, ctor_ns, tag_nl)
            let subst = pipeline_match_variant_instance_subst(tt, ctor_src, ctor_ns, tag_nl, scrutinee_ty, pipeline_lower_module_subst(module))
            match pipeline_lower_match_ctor_bindings_to_result(bindings, payload_types, subst, scrutinee_ty, tt, 0, 0, scrutinee_value, locals, ir_inst_list_empty(), next_value) {
              PipelinePatternBindResult(payload_locals, payload_insts, body_start_value, valid) -> {
                if valid == 1 {
                  pipeline_lower_match_body_to_blocks(body, payload_locals, payload_insts, ctx, arm_index, body_start_value, start_block)
                } else {
                  pipeline_lowered_blocks_invalid(start_block, next_value)
                }
              }
            }
          }
        }
        _ -> pipeline_lowered_blocks_invalid(start_block, next_value)
      }
    }
  }
}

pub(package) fn pipeline_lower_match_multi_ctor_body_to_blocks(pat: Pattern, body: Expr, ctx: PipelineMatchCtx, arm_index: i64, next_value: i64, start_block: i64) -> PipelineLoweredBlocks {
  pipeline_lower_match_ctor_body_to_blocks(pat, body, ctx, arm_index, next_value, start_block)
}

pub(package) fn pipeline_lower_match_no_match_to_blocks(ctx: PipelineMatchCtx, next_value: i64, start_block: i64) -> PipelineLoweredBlocks {
  match ctx {
    PipelineMatchCtx(arms, n_arms, scrutinee_value, params, locals, module, target_block, normalise_owned, scrutinee_ty, result_prim, loop_target_block, loop_normal_block, loop_continue_block, loop_break_mode) -> {
      let result_value = next_value
      let result_ty = pipeline_match_arms_result_type_node_with_scrutinee_typed(arms, params, locals, module, scrutinee_ty)
      let result_lanes = pipeline_type_value_lane_count_or_one(result_ty)
      let mut insts = ir_inst_list_empty()
      for lane in 0..result_lanes {
        insts = ir_inst_list_append(insts, ir_inst_list_prepend(ir_inst_const_i64(result_value + lane, 0), ir_inst_list_empty()))
      }
      insts = ir_inst_list_append(insts, ir_inst_list_prepend(ir_inst_lowering_failure_i64(12), ir_inst_list_empty()))
      -- Exhaustiveness failure is non-returning. Giving the trap a synthetic
      -- successor creates an impossible CFG edge; inside a loop that edge can
      -- feed mutually exclusive not-constructor facts back to the match head
      -- and make valid arms appear unreachable.
      let block = ir_block_new_term(start_block, insts, ir_term_unreachable())
      pipeline_lowered_blocks_control(start_block + 1, result_value + result_lanes, ir_block_list_prepend(block, ir_block_list_empty()), 1, 0)
    }
  }
}

pub(package) fn pipeline_lower_match_rest_to_blocks(ctx: PipelineMatchCtx, index: i64, next_value: i64, start_block: i64, next_block: i64) -> PipelineLoweredBlocks {
  match ctx {
    PipelineMatchCtx(arms, n_arms, scrutinee_value, params, locals, module, target_block, normalise_owned, scrutinee_ty, result_prim, loop_target_block, loop_normal_block, loop_continue_block, loop_break_mode) -> {
      if index >= n_arms {
        pipeline_lower_match_no_match_to_blocks(ctx, next_value, start_block)
      } else {
        pipeline_lower_match_arm_to_blocks(ctx, index, next_value, start_block, next_block)
      }
    }
  }
}

pub(package) fn pipeline_lower_match_guarded_arm_to_blocks(ctx: PipelineMatchCtx, index: i64, arm_locals: PipelineValueEnv, entry_insts: IrInstList, next_value: i64, start_block: i64, next_block: i64) -> PipelineLoweredBlocks {
  match ctx {
    PipelineMatchCtx(arms, n_arms, scrutinee_value, params, locals, module, target_block, normalise_owned, scrutinee_ty, result_prim, loop_target_block, loop_normal_block, loop_continue_block, loop_break_mode) -> {
      let src = pipeline_lower_module_src(module)
      let tt = pipeline_lower_module_tt(module)
      let arm = match_arm_list_nth(arms, index)
      let guard_expr = match_arm_guard_expr(arm)
      if pipeline_expr_needs_cfg_typed(guard_expr) == 1 {
        pipeline_lowered_blocks_invalid(start_block, next_value)
      } else {
        let lower_ctx = pipeline_handler_lower_ctx_with_fns_subst(params, arm_locals, src, tt, pipeline_handler_inline_ctx_empty(), pipeline_lower_module_fns(module), 0)
        let guard_value = pipeline_lower_expr_typed_sidecar_handler_ctx(guard_expr, next_value, lower_ctx)
        if ir_lowered_expr_is_valid(guard_value) == 1 {
          let body_start = next_block
          let body_blocks = pipeline_lower_match_body_to_blocks(match_arm_body_expr(arm), arm_locals, ir_inst_list_empty(), ctx, index, ir_lowered_expr_next_value(guard_value), body_start)
          if pipeline_lowered_blocks_is_valid(body_blocks) == 1 {
            let rest_start = pipeline_lowered_blocks_next_block(body_blocks)
            let rest_blocks = pipeline_lower_match_rest_to_blocks(ctx, index + 1, pipeline_lowered_blocks_next_value(body_blocks), rest_start, rest_start + 1)
            if pipeline_lowered_blocks_is_valid(rest_blocks) == 1 {
              let guard_insts = ir_inst_list_append(entry_insts, ir_lowered_expr_insts(guard_value))
              let guard_block = ir_block_new_term(start_block, guard_insts, ir_term_branch(ir_lowered_expr_value(guard_value), body_start, rest_start))
              let blocks = ir_block_list_prepend(
                guard_block,
                ir_block_list_append(pipeline_lowered_blocks_blocks(body_blocks), pipeline_lowered_blocks_blocks(rest_blocks))
              )
              let falls_through = if pipeline_lowered_blocks_falls_through(body_blocks) == 1 { 1 } else { pipeline_lowered_blocks_falls_through(rest_blocks) }
              pipeline_lowered_blocks_control(pipeline_lowered_blocks_next_block(rest_blocks), pipeline_lowered_blocks_next_value(rest_blocks), blocks, 1, falls_through)
            } else {
              pipeline_lowered_blocks_invalid(start_block, next_value)
            }
          } else {
            pipeline_lowered_blocks_invalid(start_block, next_value)
          }
        } else {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        }
      }
    }
  }
}

pub(package) fn pipeline_lower_match_cfg_guarded_arm_to_blocks(ctx: PipelineMatchCtx, index: i64, arm_locals: PipelineValueEnv, entry_insts: IrInstList, next_value: i64, start_block: i64, next_block: i64) -> PipelineLoweredBlocks {
  match ctx {
    PipelineMatchCtx(arms, n_arms, scrutinee_value, params, locals, module, target_block, normalise_owned, scrutinee_ty, result_prim, loop_target_block, loop_normal_block, loop_continue_block, loop_break_mode) -> {
      let arm = match_arm_list_nth(arms, index)
      let guard_expr = match_arm_guard_expr(arm)
      let rest_gate_block = next_block
      let guard_start = next_block + 1
      let guard_merge_block = next_block + 2
      let guard_blocks = pipeline_lower_expr_typed_to_target_blocks_reserved(guard_expr, params, arm_locals, module, next_value, guard_start, guard_merge_block + 1, guard_merge_block)
      if pipeline_lowered_blocks_is_valid(guard_blocks) == 1 {
        if pipeline_lowered_blocks_falls_through(guard_blocks) == 0 {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        } else {
          let guard_value = pipeline_lowered_blocks_next_value(guard_blocks)
          let body_start = pipeline_lowered_blocks_next_block(guard_blocks)
          let body_blocks = pipeline_lower_match_body_to_blocks(match_arm_body_expr(arm), arm_locals, ir_inst_list_empty(), ctx, index, guard_value + 1, body_start)
          if pipeline_lowered_blocks_is_valid(body_blocks) == 1 {
            let rest_start = pipeline_lowered_blocks_next_block(body_blocks)
            let rest_blocks = pipeline_lower_match_rest_to_blocks(ctx, index + 1, pipeline_lowered_blocks_next_value(body_blocks), rest_start, rest_start + 1)
            if pipeline_lowered_blocks_is_valid(rest_blocks) == 1 {
              let guard_params = ir_value_list_prepend(guard_value, ir_value_list_empty())
              let entry = ir_block_new_term(start_block, entry_insts, ir_term_jump(guard_start))
              let guard_merge = ir_block_new_params(guard_merge_block, guard_params, ir_inst_list_empty(), ir_term_branch(guard_value, body_start, rest_gate_block))
              let rest_gate = ir_block_new_term(rest_gate_block, ir_inst_list_empty(), ir_term_jump(rest_start))
              let blocks = ir_block_list_prepend(
                entry,
                ir_block_list_append(
                  pipeline_lowered_blocks_blocks(guard_blocks),
                  ir_block_list_prepend(
                    guard_merge,
                    ir_block_list_append(
                      pipeline_lowered_blocks_blocks(body_blocks),
                      ir_block_list_prepend(rest_gate, pipeline_lowered_blocks_blocks(rest_blocks))
                    )
                  )
                )
              )
              let falls_through = if pipeline_lowered_blocks_falls_through(body_blocks) == 1 { 1 } else { pipeline_lowered_blocks_falls_through(rest_blocks) }
              pipeline_lowered_blocks_control(pipeline_lowered_blocks_next_block(rest_blocks), pipeline_lowered_blocks_next_value(rest_blocks), blocks, 1, falls_through)
            } else {
              pipeline_lowered_blocks_invalid(start_block, next_value)
            }
          } else {
            pipeline_lowered_blocks_invalid(start_block, next_value)
          }
        }
      } else {
        pipeline_lowered_blocks_invalid(start_block, next_value)
      }
    }
  }
}

-- is_ctor modes: 0 = plain tested arm (int/nil compares), 1 = ctor arm
-- (payload bindings derived inside), 2 = typed binding arm — the name
-- binds to the scrutinee value at the NARROWED annotation type, in
-- scope for both the guard and the body.
pub(package) fn pipeline_lower_match_tested_arm_with_compare_to_blocks(ctx: PipelineMatchCtx, index: i64, next_value: i64, start_block: i64, next_block: i64, pat: Pattern, is_ctor: i64, compare_insts: IrInstList, cmp_value: i64) -> PipelineLoweredBlocks {
  match ctx {
    PipelineMatchCtx(arms, n_arms, scrutinee_value, params, locals, module, target_block, normalise_owned, scrutinee_ty, result_prim, loop_target_block, loop_normal_block, loop_continue_block, loop_break_mode) -> {
      let src = pipeline_lower_module_src(module)
      let tt = pipeline_lower_module_tt(module)
      let arm = match_arm_list_nth(arms, index)
      let body = match_arm_body_expr(arm)
      let guard_expr = match_arm_guard_expr(arm)
      let base_locals = if is_ctor == 2 {
        match pat {
          TypedBinding(tb_ns, tb_nl, tb_ann) -> pipeline_value_env_push_float_typed_node(locals, tb_ns, tb_nl, scrutinee_value, 0, if tb_ann == 0 { 0 } else { type_hash_of(tb_ann) }, tb_ann)
          _ -> locals
        }
      } else { locals }
      if match_arm_has_guard(arm) != 0 {
        if is_ctor == 1 {
          match pat {
            CtorPattern(tag_ns, tag_nl, bindings, declaration) -> {
              let ctor_src = pipeline_pattern_ctor_source(declaration, src)
              let ctor_ns = pipeline_pattern_ctor_start(declaration, tag_ns, ctor_src)
              let payload_types = pipeline_variant_payload_types(tt, ctor_src, ctor_ns, tag_nl)
              let subst = pipeline_match_variant_instance_subst(tt, ctor_src, ctor_ns, tag_nl, scrutinee_ty, pipeline_lower_module_subst(module))
              match pipeline_lower_match_ctor_bindings_to_result(bindings, payload_types, subst, scrutinee_ty, tt, 0, 0, scrutinee_value, locals, ir_inst_list_empty(), cmp_value + 1) {
                PipelinePatternBindResult(payload_locals, payload_insts, guard_start_value, valid) -> {
                  if valid == 1 {
                    let guard_start = next_block
                    let body_start = next_block + 1
                    if pipeline_expr_needs_cfg_typed(guard_expr) == 1 {
                      let rest_gate = next_block + 1
                      let guarded_blocks = pipeline_lower_match_cfg_guarded_arm_to_blocks(ctx, index, payload_locals, payload_insts, guard_start_value, guard_start, rest_gate)
                      if pipeline_lowered_blocks_is_valid(guarded_blocks) == 1 {
                        let entry = ir_block_new_term(start_block, compare_insts, ir_term_branch(cmp_value, guard_start, rest_gate))
                        let blocks = ir_block_list_prepend(entry, pipeline_lowered_blocks_blocks(guarded_blocks))
                        pipeline_lowered_blocks_control(
                          pipeline_lowered_blocks_next_block(guarded_blocks),
                          pipeline_lowered_blocks_next_value(guarded_blocks),
                          blocks,
                          1,
                          pipeline_lowered_blocks_falls_through(guarded_blocks)
                        )
                      } else {
                        pipeline_lowered_blocks_invalid(start_block, next_value)
                      }
                    } else {
                      let lower_ctx = pipeline_handler_lower_ctx_with_fns_subst(params, payload_locals, src, tt, pipeline_handler_inline_ctx_empty(), pipeline_lower_module_fns(module), 0)
                      let guard_value = pipeline_lower_expr_typed_sidecar_handler_ctx(guard_expr, guard_start_value, lower_ctx)
                      if ir_lowered_expr_is_valid(guard_value) == 1 {
                        let body_blocks = pipeline_lower_match_body_to_blocks(body, payload_locals, ir_inst_list_empty(), ctx, index, ir_lowered_expr_next_value(guard_value), body_start)
                        if pipeline_lowered_blocks_is_valid(body_blocks) == 1 {
                          let rest_start = pipeline_lowered_blocks_next_block(body_blocks)
                          let rest_blocks = pipeline_lower_match_rest_to_blocks(ctx, index + 1, pipeline_lowered_blocks_next_value(body_blocks), rest_start, rest_start + 1)
                          if pipeline_lowered_blocks_is_valid(rest_blocks) == 1 {
                            let guard_insts = ir_inst_list_append(payload_insts, ir_lowered_expr_insts(guard_value))
                            let guard_block = ir_block_new_term(guard_start, guard_insts, ir_term_branch(ir_lowered_expr_value(guard_value), body_start, rest_start))
                            let entry = ir_block_new_term(start_block, compare_insts, ir_term_branch(cmp_value, guard_start, rest_start))
                            let blocks = ir_block_list_prepend(
                              entry,
                              ir_block_list_prepend(
                                guard_block,
                                ir_block_list_append(pipeline_lowered_blocks_blocks(body_blocks), pipeline_lowered_blocks_blocks(rest_blocks))
                              )
                            )
                            let falls_through = if pipeline_lowered_blocks_falls_through(body_blocks) == 1 { 1 } else { pipeline_lowered_blocks_falls_through(rest_blocks) }
                            pipeline_lowered_blocks_control(pipeline_lowered_blocks_next_block(rest_blocks), pipeline_lowered_blocks_next_value(rest_blocks), blocks, 1, falls_through)
                          } else {
                            pipeline_lowered_blocks_invalid(start_block, next_value)
                          }
                        } else {
                          pipeline_lowered_blocks_invalid(start_block, next_value)
                        }
                      } else {
                        pipeline_lowered_blocks_invalid(start_block, next_value)
                      }
                    }
                  } else {
                    pipeline_lowered_blocks_invalid(start_block, next_value)
                  }
                }
              }
            }
            _ -> pipeline_lowered_blocks_invalid(start_block, next_value)
          }
        } else {
          let guard_start = next_block
          let body_start = next_block + 1
          if pipeline_expr_needs_cfg_typed(guard_expr) == 1 {
            let rest_gate = next_block + 1
            let guarded_blocks = pipeline_lower_match_cfg_guarded_arm_to_blocks(ctx, index, base_locals, ir_inst_list_empty(), cmp_value + 1, guard_start, rest_gate)
            if pipeline_lowered_blocks_is_valid(guarded_blocks) == 1 {
              let entry = ir_block_new_term(start_block, compare_insts, ir_term_branch(cmp_value, guard_start, rest_gate))
              let blocks = ir_block_list_prepend(entry, pipeline_lowered_blocks_blocks(guarded_blocks))
              pipeline_lowered_blocks_control(
                pipeline_lowered_blocks_next_block(guarded_blocks),
                pipeline_lowered_blocks_next_value(guarded_blocks),
                blocks,
                1,
                pipeline_lowered_blocks_falls_through(guarded_blocks)
              )
            } else {
              pipeline_lowered_blocks_invalid(start_block, next_value)
            }
          } else {
            let lower_ctx = pipeline_handler_lower_ctx_with_fns_subst(params, base_locals, src, tt, pipeline_handler_inline_ctx_empty(), pipeline_lower_module_fns(module), 0)
            let guard_value = pipeline_lower_expr_typed_sidecar_handler_ctx(guard_expr, cmp_value + 1, lower_ctx)
            if ir_lowered_expr_is_valid(guard_value) == 1 {
              let body_blocks = pipeline_lower_match_body_to_blocks(body, base_locals, ir_inst_list_empty(), ctx, index, ir_lowered_expr_next_value(guard_value), body_start)
              if pipeline_lowered_blocks_is_valid(body_blocks) == 1 {
                let rest_start = pipeline_lowered_blocks_next_block(body_blocks)
                let rest_blocks = pipeline_lower_match_rest_to_blocks(ctx, index + 1, pipeline_lowered_blocks_next_value(body_blocks), rest_start, rest_start + 1)
                if pipeline_lowered_blocks_is_valid(rest_blocks) == 1 {
                  let guard_block = ir_block_new_term(guard_start, ir_lowered_expr_insts(guard_value), ir_term_branch(ir_lowered_expr_value(guard_value), body_start, rest_start))
                  let entry = ir_block_new_term(start_block, compare_insts, ir_term_branch(cmp_value, guard_start, rest_start))
                  let blocks = ir_block_list_prepend(
                    entry,
                    ir_block_list_prepend(
                      guard_block,
                      ir_block_list_append(pipeline_lowered_blocks_blocks(body_blocks), pipeline_lowered_blocks_blocks(rest_blocks))
                    )
                  )
                  let falls_through = if pipeline_lowered_blocks_falls_through(body_blocks) == 1 { 1 } else { pipeline_lowered_blocks_falls_through(rest_blocks) }
                  pipeline_lowered_blocks_control(pipeline_lowered_blocks_next_block(rest_blocks), pipeline_lowered_blocks_next_value(rest_blocks), blocks, 1, falls_through)
                } else {
                  pipeline_lowered_blocks_invalid(start_block, next_value)
                }
              } else {
                pipeline_lowered_blocks_invalid(start_block, next_value)
              }
            } else {
              pipeline_lowered_blocks_invalid(start_block, next_value)
            }
          }
        }
      } else {
        let body_start = next_block
        let body_blocks = if is_ctor == 1 {
          pipeline_lower_match_ctor_body_to_blocks(pat, body, ctx, index, cmp_value + 1, body_start)
        } else {
          pipeline_lower_match_body_to_blocks(body, base_locals, ir_inst_list_empty(), ctx, index, cmp_value + 1, body_start)
        }
        if pipeline_lowered_blocks_is_valid(body_blocks) == 1 {
          let rest_start = pipeline_lowered_blocks_next_block(body_blocks)
          let rest_blocks = pipeline_lower_match_rest_to_blocks(ctx, index + 1, pipeline_lowered_blocks_next_value(body_blocks), rest_start, rest_start + 1)
          if pipeline_lowered_blocks_is_valid(rest_blocks) == 1 {
            let entry = ir_block_new_term(start_block, compare_insts, ir_term_branch(cmp_value, body_start, rest_start))
            let blocks = ir_block_list_prepend(
              entry,
              ir_block_list_append(pipeline_lowered_blocks_blocks(body_blocks), pipeline_lowered_blocks_blocks(rest_blocks))
            )
            pipeline_lowered_blocks(pipeline_lowered_blocks_next_block(rest_blocks), pipeline_lowered_blocks_next_value(rest_blocks), blocks, 1)
          } else {
            pipeline_lowered_blocks_invalid(start_block, next_value)
          }
        } else {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        }
      }
    }
  }
}

pub(package) fn pipeline_lower_match_tested_arm_to_blocks(ctx: PipelineMatchCtx, index: i64, next_value: i64, start_block: i64, next_block: i64) -> PipelineLoweredBlocks {
  match ctx {
    PipelineMatchCtx(arms, n_arms, scrutinee_value, params, locals, module, target_block, normalise_owned, scrutinee_ty, result_prim, loop_target_block, loop_normal_block, loop_continue_block, loop_break_mode) -> {
      let src = pipeline_lower_module_src(module)
      let tt = pipeline_lower_module_tt(module)
      let arm = match_arm_list_nth(arms, index)
      let pat = match_arm_pattern(arm)
      match pat {
        IntPattern(value, start, len) -> {
          let expected_value = next_value + 1
          let cmp_value = next_value + 2
          let compare_insts = ir_inst_list_prepend(
            ir_inst_const_i64(expected_value, value),
            ir_inst_list_prepend(ir_inst_binary_i64(cmp_value, ir_binary_op_eq(), scrutinee_value, expected_value), ir_inst_list_empty())
          )
          pipeline_lower_match_tested_arm_with_compare_to_blocks(ctx, index, next_value, start_block, next_block, pat, 0, compare_insts, cmp_value)
        }
        -- nil arm (kernel §6.2): nil is 0 and no other member of a
        -- nil-sentinel union is ever 0, so the test is a zero compare.
        NilPattern(pns, pnl) -> {
          let expected_value = next_value + 1
          let cmp_value = next_value + 2
          let compare_insts = ir_inst_list_prepend(
            ir_inst_const_i64(expected_value, 0),
            ir_inst_list_prepend(ir_inst_binary_i64(cmp_value, ir_binary_op_eq(), scrutinee_value, expected_value), ir_inst_list_empty())
          )
          pipeline_lower_match_tested_arm_with_compare_to_blocks(ctx, index, next_value, start_block, next_block, pat, 0, compare_insts, cmp_value)
        }
        -- Typed arm over a nil-sentinel union: the checker admitted it,
        -- so the annotation is exactly the non-nil part — test != 0 and
        -- bind the name at the narrowed type (is_ctor mode 2 threads
        -- the binding through the guard and body paths).
        TypedBinding(pns, pnl, ann) -> {
          let expected_value = next_value + 1
          let cmp_value = next_value + 2
          let compare_insts = ir_inst_list_prepend(
            ir_inst_const_i64(expected_value, 0),
            ir_inst_list_prepend(ir_inst_binary_i64(cmp_value, ir_binary_op_ne(), scrutinee_value, expected_value), ir_inst_list_empty())
          )
          pipeline_lower_match_tested_arm_with_compare_to_blocks(ctx, index, next_value, start_block, next_block, pat, 2, compare_insts, cmp_value)
        }
        CtorPattern(tag_ns, tag_nl, bindings, declaration) -> {
          let ctor_src = pipeline_pattern_ctor_source(declaration, src)
          let ctor_ns = pipeline_pattern_ctor_start(declaration, tag_ns, ctor_src)
          let expected_const = pipeline_variant_tag_hash(tt, ctor_src, ctor_ns, tag_nl)
          if expected_const < 0 {
            pipeline_lowered_blocks_invalid(start_block, next_value)
          } else {
            let tag_value = next_value
            let expected_value = next_value + 1
            let cmp_value = next_value + 2
            let compare_insts = ir_inst_list_prepend(
              ir_inst_variant_tag_i64(tag_value, scrutinee_value),
              ir_inst_list_prepend(
                ir_inst_const_i64(expected_value, expected_const),
                ir_inst_list_prepend(ir_inst_binary_i64(cmp_value, ir_binary_op_eq(), tag_value, expected_value), ir_inst_list_empty())
              )
            )
            pipeline_lower_match_tested_arm_with_compare_to_blocks(ctx, index, next_value, start_block, next_block, pat, 1, compare_insts, cmp_value)
          }
        }
        _ -> pipeline_lowered_blocks_invalid(start_block, next_value)
      }
    }
  }
}

pub(package) fn pipeline_lower_match_tested_arm_to_blocks_legacy_unused(ctx: PipelineMatchCtx, index: i64, next_value: i64, start_block: i64, next_block: i64) -> PipelineLoweredBlocks {
  pipeline_lowered_blocks_invalid(start_block, next_value)
}

pub(package) fn pipeline_lower_match_arm_to_blocks(ctx: PipelineMatchCtx, index: i64, next_value: i64, start_block: i64, next_block: i64) -> PipelineLoweredBlocks {
  match ctx {
    PipelineMatchCtx(arms, n_arms, scrutinee_value, params, locals, module, target_block, normalise_owned, scrutinee_ty, result_prim, loop_target_block, loop_normal_block, loop_continue_block, loop_break_mode) -> {
      if index >= n_arms {
        pipeline_lowered_blocks_invalid(start_block, next_value)
      } else {
        let arm = match_arm_list_nth(arms, index)
        let pat = match_arm_pattern(arm)
        let pat_tag = pattern_tag(pat)
        if match_arm_has_guard(arm) != 0 {
          let guard_expr = match_arm_guard_expr(arm)
          match pat {
            Wildcard -> {
              if pipeline_expr_needs_cfg_typed(guard_expr) == 1 {
                pipeline_lower_match_cfg_guarded_arm_to_blocks(ctx, index, locals, ir_inst_list_empty(), next_value, start_block, next_block)
              } else {
                pipeline_lower_match_guarded_arm_to_blocks(ctx, index, locals, ir_inst_list_empty(), next_value, start_block, next_block)
              }
            }
            Binding(ns, nl) -> {
              let scrutinee_type_hash = if scrutinee_ty == 0 { 0 } else { type_hash_of(scrutinee_ty) }
              let match_locals = pipeline_value_env_push_float_typed_node(locals, ns, nl, scrutinee_value, 0, scrutinee_type_hash, scrutinee_ty)
              if pipeline_expr_needs_cfg_typed(guard_expr) == 1 {
                pipeline_lower_match_cfg_guarded_arm_to_blocks(ctx, index, match_locals, ir_inst_list_empty(), next_value, start_block, next_block)
              } else {
                pipeline_lower_match_guarded_arm_to_blocks(ctx, index, match_locals, ir_inst_list_empty(), next_value, start_block, next_block)
              }
            }
            IntPattern(value, start, len) -> pipeline_lower_match_tested_arm_to_blocks(ctx, index, next_value, start_block, next_block)
            CtorPattern(tag_ns, tag_nl, bindings, declaration) -> {
              if pipeline_pattern_needs_recursive_lowering(pat) == 1 {
                pipeline_lower_match_recursive_pattern_arm_to_blocks(ctx, index, next_value, start_block)
              } else { pipeline_lower_match_tested_arm_to_blocks(ctx, index, next_value, start_block, next_block) }
            }
            -- Typed arm: tested (nil sentinel) when the scrutinee is a
            -- nil union; otherwise the annotation covers the whole
            -- scrutinee (checker-enforced) and the arm is a typed
            -- catch-all binding.
            TypedBinding(tb_ns, tb_nl, tb_ann) -> {
              if scrutinee_ty != 0 and ty_narrow_drop_nil(scrutinee_ty) != 0 {
                pipeline_lower_match_tested_arm_to_blocks(ctx, index, next_value, start_block, next_block)
              } else {
                let tb_hash = if tb_ann == 0 { 0 } else { type_hash_of(tb_ann) }
                let tb_locals = pipeline_value_env_push_float_typed_node(locals, tb_ns, tb_nl, scrutinee_value, 0, tb_hash, tb_ann)
                if pipeline_expr_needs_cfg_typed(guard_expr) == 1 {
                  pipeline_lower_match_cfg_guarded_arm_to_blocks(ctx, index, tb_locals, ir_inst_list_empty(), next_value, start_block, next_block)
                } else {
                  pipeline_lower_match_guarded_arm_to_blocks(ctx, index, tb_locals, ir_inst_list_empty(), next_value, start_block, next_block)
                }
              }
            }
            NilPattern(pn_ns, pn_nl) -> pipeline_lower_match_tested_arm_to_blocks(ctx, index, next_value, start_block, next_block)
            RecordPattern(fields) -> pipeline_lower_match_recursive_pattern_arm_to_blocks(ctx, index, next_value, start_block)
            TuplePattern(items) -> pipeline_lower_match_recursive_pattern_arm_to_blocks(ctx, index, next_value, start_block)
            _ -> pipeline_lowered_blocks_invalid(start_block, next_value)
          }
        } else {
          match pat {
            Wildcard -> pipeline_lower_match_body_to_blocks(match_arm_body_expr(arm), locals, ir_inst_list_empty(), ctx, index, next_value, start_block)
            Binding(ns, nl) -> {
              let scrutinee_type_hash = if scrutinee_ty == 0 { 0 } else { type_hash_of(scrutinee_ty) }
              let match_locals = pipeline_value_env_push_float_typed_node(locals, ns, nl, scrutinee_value, 0, scrutinee_type_hash, scrutinee_ty)
              pipeline_lower_match_body_to_blocks(match_arm_body_expr(arm), match_locals, ir_inst_list_empty(), ctx, index, next_value, start_block)
            }
            IntPattern(value, start, len) -> pipeline_lower_match_tested_arm_to_blocks(ctx, index, next_value, start_block, next_block)
            CtorPattern(tag_ns, tag_nl, bindings, declaration) -> {
              if pipeline_pattern_needs_recursive_lowering(pat) == 1 {
                pipeline_lower_match_recursive_pattern_arm_to_blocks(ctx, index, next_value, start_block)
              } else { pipeline_lower_match_tested_arm_to_blocks(ctx, index, next_value, start_block, next_block) }
            }
            TypedBinding(tb_ns, tb_nl, tb_ann) -> {
              if scrutinee_ty != 0 and ty_narrow_drop_nil(scrutinee_ty) != 0 {
                pipeline_lower_match_tested_arm_to_blocks(ctx, index, next_value, start_block, next_block)
              } else {
                let tb_hash = if tb_ann == 0 { 0 } else { type_hash_of(tb_ann) }
                let tb_locals = pipeline_value_env_push_float_typed_node(locals, tb_ns, tb_nl, scrutinee_value, 0, tb_hash, tb_ann)
                pipeline_lower_match_body_to_blocks(match_arm_body_expr(arm), tb_locals, ir_inst_list_empty(), ctx, index, next_value, start_block)
              }
            }
            NilPattern(pn_ns, pn_nl) -> pipeline_lower_match_tested_arm_to_blocks(ctx, index, next_value, start_block, next_block)
            RecordPattern(fields) -> pipeline_lower_match_recursive_pattern_arm_to_blocks(ctx, index, next_value, start_block)
            TuplePattern(items) -> pipeline_lower_match_recursive_pattern_arm_to_blocks(ctx, index, next_value, start_block)
            _ -> pipeline_lowered_blocks_invalid(start_block, next_value)
          }
        }
      }
    }
  }
}

pub(package) fn pipeline_lower_match_arm_to_blocks_legacy_unused(ctx: PipelineMatchCtx, index: i64, next_value: i64, start_block: i64, next_block: i64) -> PipelineLoweredBlocks {
  pipeline_lowered_blocks_invalid(start_block, next_value)
}
