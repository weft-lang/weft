}

-- Row-upper fact: load(slot_id) < len(vec_value) / width held at
-- block_id's entry (established by a strict loop-guard compare against
-- a quotient of the vector's length).
fn pipeline_ir_block_entry_vector_slot_row_upper_fact_lookup_chain(facts: PipelineIrBlockEntryFactChain, block_id: i64, vec_value: i64, width: i64, slot_id: i64) -> i64 {
  match facts {
    PipelineIrBlockEntryFactNil -> 0
    PipelineIrBlockEntryCtorFact(fact_block, fact_value, ctor_hash, rest) -> pipeline_ir_block_entry_vector_slot_row_upper_fact_lookup_chain(rest, block_id, vec_value, width, slot_id)
    PipelineIrBlockEntryNotCtorFact(fact_block, fact_value, ctor_hash, rest) -> pipeline_ir_block_entry_vector_slot_row_upper_fact_lookup_chain(rest, block_id, vec_value, width, slot_id)
    PipelineIrBlockEntryScalarFact(fact_block, fact_value, kind, value, rest) -> pipeline_ir_block_entry_vector_slot_row_upper_fact_lookup_chain(rest, block_id, vec_value, width, slot_id)
    PipelineIrBlockEntrySlotScalarFact(fact_block, fact_slot, kind, value, rest) -> pipeline_ir_block_entry_vector_slot_row_upper_fact_lookup_chain(rest, block_id, vec_value, width, slot_id)
    PipelineIrBlockEntryVectorLenFact(fact_block, len_value, fact_vec, rest) -> pipeline_ir_block_entry_vector_slot_row_upper_fact_lookup_chain(rest, block_id, vec_value, width, slot_id)
    PipelineIrBlockEntryVectorUpperFact(fact_block, fact_vec, fact_index, rest) -> pipeline_ir_block_entry_vector_slot_row_upper_fact_lookup_chain(rest, block_id, vec_value, width, slot_id)
    PipelineIrBlockEntryVectorSlotUpperFact(fact_block, fact_vec, fact_slot, rest) -> pipeline_ir_block_entry_vector_slot_row_upper_fact_lookup_chain(rest, block_id, vec_value, width, slot_id)
    PipelineIrBlockEntryVectorSlotRowUpperFact(fact_block, fact_vec, row_width, fact_slot, rest) -> {
      if fact_block == block_id and fact_vec == vec_value and row_width == width and fact_slot == slot_id {
        1
      } else {
        pipeline_ir_block_entry_vector_slot_row_upper_fact_lookup_chain(rest, block_id, vec_value, width, slot_id)
      }
    }
    PipelineIrBlockEntryVectorRowUpperFact(fact_block, fact_vec, row_width, fact_value, rest) -> pipeline_ir_block_entry_vector_slot_row_upper_fact_lookup_chain(rest, block_id, vec_value, width, slot_id)
    PipelineIrBlockEntryVariantOriginFact(fact_block, fact_value, ctor_hash, payloads, rest) -> pipeline_ir_block_entry_vector_slot_row_upper_fact_lookup_chain(rest, block_id, vec_value, width, slot_id)
  }
}

fn pipeline_ir_block_entry_vector_slot_row_upper_fact_lookup(facts: PipelineIrBlockEntryFactList, block_id: i64, vec_value: i64, width: i64, slot_id: i64) -> i64 {
  pipeline_ir_block_entry_vector_slot_row_upper_fact_lookup_chain(pipeline_ir_block_entry_facts_block_chain(facts, block_id), block_id, vec_value, width, slot_id)
}

-- First vector with a row-upper fact for (width, slot) at this block,
-- or -1.
fn pipeline_ir_block_entry_vector_slot_row_upper_vec_chain(facts: PipelineIrBlockEntryFactChain, block_id: i64, width: i64, slot_id: i64) -> i64 {
  match facts {
    PipelineIrBlockEntryFactNil -> 0 - 1
    PipelineIrBlockEntryCtorFact(fact_block, fact_value, ctor_hash, rest) -> pipeline_ir_block_entry_vector_slot_row_upper_vec_chain(rest, block_id, width, slot_id)
    PipelineIrBlockEntryNotCtorFact(fact_block, fact_value, ctor_hash, rest) -> pipeline_ir_block_entry_vector_slot_row_upper_vec_chain(rest, block_id, width, slot_id)
    PipelineIrBlockEntryScalarFact(fact_block, fact_value, kind, value, rest) -> pipeline_ir_block_entry_vector_slot_row_upper_vec_chain(rest, block_id, width, slot_id)
    PipelineIrBlockEntrySlotScalarFact(fact_block, fact_slot, kind, value, rest) -> pipeline_ir_block_entry_vector_slot_row_upper_vec_chain(rest, block_id, width, slot_id)
    PipelineIrBlockEntryVectorLenFact(fact_block, len_value, fact_vec, rest) -> pipeline_ir_block_entry_vector_slot_row_upper_vec_chain(rest, block_id, width, slot_id)
    PipelineIrBlockEntryVectorUpperFact(fact_block, fact_vec, fact_index, rest) -> pipeline_ir_block_entry_vector_slot_row_upper_vec_chain(rest, block_id, width, slot_id)
    PipelineIrBlockEntryVectorSlotUpperFact(fact_block, fact_vec, fact_slot, rest) -> pipeline_ir_block_entry_vector_slot_row_upper_vec_chain(rest, block_id, width, slot_id)
    PipelineIrBlockEntryVectorSlotRowUpperFact(fact_block, fact_vec, row_width, fact_slot, rest) -> {
      if fact_block == block_id and row_width == width and fact_slot == slot_id { fact_vec }
      else { pipeline_ir_block_entry_vector_slot_row_upper_vec_chain(rest, block_id, width, slot_id) }
    }
    PipelineIrBlockEntryVectorRowUpperFact(fact_block, fact_vec, row_width, fact_value, rest) -> pipeline_ir_block_entry_vector_slot_row_upper_vec_chain(rest, block_id, width, slot_id)
    PipelineIrBlockEntryVariantOriginFact(fact_block, fact_value, ctor_hash, payloads, rest) -> pipeline_ir_block_entry_vector_slot_row_upper_vec_chain(rest, block_id, width, slot_id)
  }
}

fn pipeline_ir_block_entry_vector_slot_row_upper_vec(facts: PipelineIrBlockEntryFactList, block_id: i64, width: i64, slot_id: i64) -> i64 {
  pipeline_ir_block_entry_vector_slot_row_upper_vec_chain(pipeline_ir_block_entry_facts_block_chain(facts, block_id), block_id, width, slot_id)
}

-- Value-keyed row-upper: v < len(vec)/width for an SSA value v (a load
-- of a row-bounded slot, immutable thereafter). First vector for
-- (width, value) at this block, or -1.
fn pipeline_ir_block_entry_vector_row_upper_vec_chain(facts: PipelineIrBlockEntryFactChain, block_id: i64, width: i64, value_id: i64) -> i64 {
  match facts {
    PipelineIrBlockEntryFactNil -> 0 - 1
    PipelineIrBlockEntryCtorFact(fact_block, fact_value, ctor_hash, rest) -> pipeline_ir_block_entry_vector_row_upper_vec_chain(rest, block_id, width, value_id)
    PipelineIrBlockEntryNotCtorFact(fact_block, fact_value, ctor_hash, rest) -> pipeline_ir_block_entry_vector_row_upper_vec_chain(rest, block_id, width, value_id)
    PipelineIrBlockEntryScalarFact(fact_block, fact_value, kind, value, rest) -> pipeline_ir_block_entry_vector_row_upper_vec_chain(rest, block_id, width, value_id)
    PipelineIrBlockEntrySlotScalarFact(fact_block, fact_slot, kind, value, rest) -> pipeline_ir_block_entry_vector_row_upper_vec_chain(rest, block_id, width, value_id)
    PipelineIrBlockEntryVectorLenFact(fact_block, len_value, fact_vec, rest) -> pipeline_ir_block_entry_vector_row_upper_vec_chain(rest, block_id, width, value_id)
    PipelineIrBlockEntryVectorUpperFact(fact_block, fact_vec, fact_index, rest) -> pipeline_ir_block_entry_vector_row_upper_vec_chain(rest, block_id, width, value_id)
    PipelineIrBlockEntryVectorSlotUpperFact(fact_block, fact_vec, fact_slot, rest) -> pipeline_ir_block_entry_vector_row_upper_vec_chain(rest, block_id, width, value_id)
    PipelineIrBlockEntryVectorSlotRowUpperFact(fact_block, fact_vec, row_width, fact_slot, rest) -> pipeline_ir_block_entry_vector_row_upper_vec_chain(rest, block_id, width, value_id)
    PipelineIrBlockEntryVectorRowUpperFact(fact_block, fact_vec, row_width, fact_value, rest) -> {
      if fact_block == block_id and row_width == width and fact_value == value_id { fact_vec }
      else { pipeline_ir_block_entry_vector_row_upper_vec_chain(rest, block_id, width, value_id) }
    }
    PipelineIrBlockEntryVariantOriginFact(fact_block, fact_value, ctor_hash, payloads, rest) -> pipeline_ir_block_entry_vector_row_upper_vec_chain(rest, block_id, width, value_id)
  }
}

fn pipeline_ir_block_entry_vector_row_upper_vec(facts: PipelineIrBlockEntryFactList, block_id: i64, width: i64, value_id: i64) -> i64 {
  pipeline_ir_block_entry_vector_row_upper_vec_chain(pipeline_ir_block_entry_facts_block_chain(facts, block_id), block_id, width, value_id)
}

-- "Bounded by some vector's length": evidence that a value cannot be
-- near the top of the integer range, so adding a small constant cannot
-- wrap. Which vector bounds it does not matter.
fn pipeline_ir_block_entry_vector_upper_any_lookup_chain(facts: PipelineIrBlockEntryFactChain, block_id: i64, index_value: i64) -> i64 {
  match facts {
    PipelineIrBlockEntryFactNil -> 0
    PipelineIrBlockEntryCtorFact(fact_block, fact_value, ctor_hash, rest) -> pipeline_ir_block_entry_vector_upper_any_lookup_chain(rest, block_id, index_value)
    PipelineIrBlockEntryNotCtorFact(fact_block, fact_value, ctor_hash, rest) -> pipeline_ir_block_entry_vector_upper_any_lookup_chain(rest, block_id, index_value)
    PipelineIrBlockEntryScalarFact(fact_block, fact_value, kind, value, rest) -> pipeline_ir_block_entry_vector_upper_any_lookup_chain(rest, block_id, index_value)
    PipelineIrBlockEntrySlotScalarFact(fact_block, slot_id, kind, value, rest) -> pipeline_ir_block_entry_vector_upper_any_lookup_chain(rest, block_id, index_value)
    PipelineIrBlockEntryVectorLenFact(fact_block, len_value, fact_vec, rest) -> pipeline_ir_block_entry_vector_upper_any_lookup_chain(rest, block_id, index_value)
    PipelineIrBlockEntryVectorUpperFact(fact_block, fact_vec, fact_index, rest) -> {
      if fact_block == block_id and fact_index == index_value { 1 }
      else { pipeline_ir_block_entry_vector_upper_any_lookup_chain(rest, block_id, index_value) }
    }
    PipelineIrBlockEntryVectorSlotUpperFact(fact_block, fact_vec, slot_id, rest) -> pipeline_ir_block_entry_vector_upper_any_lookup_chain(rest, block_id, index_value)
    PipelineIrBlockEntryVectorSlotRowUpperFact(fact_block, fact_vec, row_width, slot_id, rest) -> pipeline_ir_block_entry_vector_upper_any_lookup_chain(rest, block_id, index_value)
    PipelineIrBlockEntryVectorRowUpperFact(fact_block, fact_vec, row_width, slot_id, rest) -> pipeline_ir_block_entry_vector_upper_any_lookup_chain(rest, block_id, index_value)
    PipelineIrBlockEntryVariantOriginFact(fact_block, fact_value, ctor_hash, payloads, rest) -> pipeline_ir_block_entry_vector_upper_any_lookup_chain(rest, block_id, index_value)
  }
}

fn pipeline_ir_block_entry_vector_upper_any_lookup(facts: PipelineIrBlockEntryFactList, block_id: i64, index_value: i64) -> i64 {
  pipeline_ir_block_entry_vector_upper_any_lookup_chain(pipeline_ir_block_entry_facts_block_chain(facts, block_id), block_id, index_value)
}

fn pipeline_ir_block_entry_vector_slot_upper_any_lookup_chain(facts: PipelineIrBlockEntryFactChain, block_id: i64, slot_id: i64) -> i64 {
  match facts {
    PipelineIrBlockEntryFactNil -> 0
    PipelineIrBlockEntryCtorFact(fact_block, fact_value, ctor_hash, rest) -> pipeline_ir_block_entry_vector_slot_upper_any_lookup_chain(rest, block_id, slot_id)
    PipelineIrBlockEntryNotCtorFact(fact_block, fact_value, ctor_hash, rest) -> pipeline_ir_block_entry_vector_slot_upper_any_lookup_chain(rest, block_id, slot_id)
    PipelineIrBlockEntryScalarFact(fact_block, fact_value, kind, value, rest) -> pipeline_ir_block_entry_vector_slot_upper_any_lookup_chain(rest, block_id, slot_id)
    PipelineIrBlockEntrySlotScalarFact(fact_block, fact_slot, kind, value, rest) -> pipeline_ir_block_entry_vector_slot_upper_any_lookup_chain(rest, block_id, slot_id)
    PipelineIrBlockEntryVectorLenFact(fact_block, len_value, fact_vec, rest) -> pipeline_ir_block_entry_vector_slot_upper_any_lookup_chain(rest, block_id, slot_id)
    PipelineIrBlockEntryVectorUpperFact(fact_block, fact_vec, fact_index, rest) -> pipeline_ir_block_entry_vector_slot_upper_any_lookup_chain(rest, block_id, slot_id)
    PipelineIrBlockEntryVectorSlotUpperFact(fact_block, fact_vec, fact_slot, rest) -> {
      if fact_block == block_id and fact_slot == slot_id { 1 }
      else { pipeline_ir_block_entry_vector_slot_upper_any_lookup_chain(rest, block_id, slot_id) }
    }
    -- A row bound (load < len/w) also bounds the slot by a real vector
    -- length, which is all this lookup certifies.
    PipelineIrBlockEntryVectorSlotRowUpperFact(fact_block, fact_vec, row_width, fact_slot, rest) -> {
      if fact_block == block_id and fact_slot == slot_id { 1 }
      else { pipeline_ir_block_entry_vector_slot_upper_any_lookup_chain(rest, block_id, slot_id) }
    }
    PipelineIrBlockEntryVectorRowUpperFact(fact_block, fact_vec, row_width, fact_value, rest) -> pipeline_ir_block_entry_vector_slot_upper_any_lookup_chain(rest, block_id, slot_id)
    PipelineIrBlockEntryVariantOriginFact(fact_block, fact_value, ctor_hash, payloads, rest) -> pipeline_ir_block_entry_vector_slot_upper_any_lookup_chain(rest, block_id, slot_id)
  }
}

fn pipeline_ir_block_entry_vector_slot_upper_any_lookup(facts: PipelineIrBlockEntryFactList, block_id: i64, slot_id: i64) -> i64 {
  pipeline_ir_block_entry_vector_slot_upper_any_lookup_chain(pipeline_ir_block_entry_facts_block_chain(facts, block_id), block_id, slot_id)
}

fn pipeline_ir_block_entry_variant_origin_exists_chain(facts: PipelineIrBlockEntryFactChain, block_id: i64, value_id: i64) -> i64 {
  match facts {
    PipelineIrBlockEntryFactNil -> 0
    PipelineIrBlockEntryCtorFact(fact_block, fact_value, ctor_hash, rest) -> pipeline_ir_block_entry_variant_origin_exists_chain(rest, block_id, value_id)
    PipelineIrBlockEntryNotCtorFact(fact_block, fact_value, ctor_hash, rest) -> pipeline_ir_block_entry_variant_origin_exists_chain(rest, block_id, value_id)
    PipelineIrBlockEntryScalarFact(fact_block, fact_value, kind, value, rest) -> pipeline_ir_block_entry_variant_origin_exists_chain(rest, block_id, value_id)
    PipelineIrBlockEntrySlotScalarFact(fact_block, slot_id, kind, value, rest) -> pipeline_ir_block_entry_variant_origin_exists_chain(rest, block_id, value_id)
    PipelineIrBlockEntryVectorLenFact(fact_block, len_value, vec_value, rest) -> pipeline_ir_block_entry_variant_origin_exists_chain(rest, block_id, value_id)
    PipelineIrBlockEntryVectorUpperFact(fact_block, vec_value, index_value, rest) -> pipeline_ir_block_entry_variant_origin_exists_chain(rest, block_id, value_id)
    PipelineIrBlockEntryVectorSlotUpperFact(fact_block, vec_value, slot_id, rest) -> pipeline_ir_block_entry_variant_origin_exists_chain(rest, block_id, value_id)
    PipelineIrBlockEntryVectorSlotRowUpperFact(fact_block, vec_value, row_width, slot_id, rest) -> pipeline_ir_block_entry_variant_origin_exists_chain(rest, block_id, value_id)
    PipelineIrBlockEntryVectorRowUpperFact(fact_block, vec_value, row_width, slot_id, rest) -> pipeline_ir_block_entry_variant_origin_exists_chain(rest, block_id, value_id)
    PipelineIrBlockEntryVariantOriginFact(fact_block, fact_value, ctor_hash, payloads, rest) -> {
      if fact_block == block_id and fact_value == value_id {
        1
      } else {
        pipeline_ir_block_entry_variant_origin_exists_chain(rest, block_id, value_id)
      }
    }
  }
}

fn pipeline_ir_block_entry_variant_origin_exists(facts: PipelineIrBlockEntryFactList, block_id: i64, value_id: i64) -> i64 {
  pipeline_ir_block_entry_variant_origin_exists_chain(pipeline_ir_block_entry_facts_block_chain(facts, block_id), block_id, value_id)
}

fn pipeline_ir_block_entry_variant_payload_lookup_chain(facts: PipelineIrBlockEntryFactChain, block_id: i64, value_id: i64, index: i64) -> PipelineIrConstLookup {
  match facts {
    PipelineIrBlockEntryFactNil -> pipeline_ir_const_lookup(0, 0)
    PipelineIrBlockEntryCtorFact(fact_block, fact_value, ctor_hash, rest) -> pipeline_ir_block_entry_variant_payload_lookup_chain(rest, block_id, value_id, index)
    PipelineIrBlockEntryNotCtorFact(fact_block, fact_value, ctor_hash, rest) -> pipeline_ir_block_entry_variant_payload_lookup_chain(rest, block_id, value_id, index)
    PipelineIrBlockEntryScalarFact(fact_block, fact_value, kind, value, rest) -> pipeline_ir_block_entry_variant_payload_lookup_chain(rest, block_id, value_id, index)
    PipelineIrBlockEntrySlotScalarFact(fact_block, slot_id, kind, value, rest) -> pipeline_ir_block_entry_variant_payload_lookup_chain(rest, block_id, value_id, index)
    PipelineIrBlockEntryVectorLenFact(fact_block, len_value, vec_value, rest) -> pipeline_ir_block_entry_variant_payload_lookup_chain(rest, block_id, value_id, index)
    PipelineIrBlockEntryVectorUpperFact(fact_block, vec_value, index_value, rest) -> pipeline_ir_block_entry_variant_payload_lookup_chain(rest, block_id, value_id, index)
    PipelineIrBlockEntryVectorSlotUpperFact(fact_block, vec_value, slot_id, rest) -> pipeline_ir_block_entry_variant_payload_lookup_chain(rest, block_id, value_id, index)
    PipelineIrBlockEntryVectorSlotRowUpperFact(fact_block, vec_value, row_width, slot_id, rest) -> pipeline_ir_block_entry_variant_payload_lookup_chain(rest, block_id, value_id, index)
    PipelineIrBlockEntryVectorRowUpperFact(fact_block, vec_value, row_width, slot_id, rest) -> pipeline_ir_block_entry_variant_payload_lookup_chain(rest, block_id, value_id, index)
    PipelineIrBlockEntryVariantOriginFact(fact_block, fact_value, ctor_hash, payloads, rest) -> {
      if fact_block == block_id and fact_value == value_id {
        let payload = pipeline_ir_value_list_get_or(payloads, index, 0 - 1)
        if payload >= 0 { pipeline_ir_const_lookup(1, payload) } else { pipeline_ir_const_lookup(0, 0) }
      } else {
        pipeline_ir_block_entry_variant_payload_lookup_chain(rest, block_id, value_id, index)
      }
    }
  }
}

fn pipeline_ir_block_entry_variant_payload_lookup(facts: PipelineIrBlockEntryFactList, block_id: i64, value_id: i64, index: i64) -> PipelineIrConstLookup {
  pipeline_ir_block_entry_variant_payload_lookup_chain(pipeline_ir_block_entry_facts_block_chain(facts, block_id), block_id, value_id, index)
}

