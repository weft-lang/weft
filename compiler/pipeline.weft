pub(package) fn pipeline_ast_migration_metrics_from(decls: DeclList, entries: TypeEntryList) -> AstMigrationMetrics {
  let unknowns = decl_list_tree_unknown_count(decls) + type_entry_list_tree_unknown_count(entries)
  let raw_slots = decl_list_tree_raw_bridge_slot_count(decls) + type_entry_list_tree_raw_bridge_slot_count(entries)
  let ready = if unknowns == 0 and raw_slots == 0 { 1 } else { 0 }
  AstMigrationMetrics(decl_list_len(decls), type_entry_list_len(entries), unknowns, raw_slots, ready)
}

pub(package) fn pipeline_ast_migration_metrics(ast: AstModule) -> AstMigrationMetrics {
