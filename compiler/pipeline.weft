  else { if callee_hash == pipeline_ir_native_intrinsic_set_handler_stack_hash() { 22 }
  else { if callee_hash == pipeline_ir_native_intrinsic_str_content_eq_hash() { 44 } else { 0 } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } }
  }
}

-- GPR clobber footprint of an inline-emitting intrinsic (2v Stage 2
-- C0 fact producer; the C1 colorer's interference input). Bit n set =
-- the emission may write xn, INCLUDING move_call_args staging
-- (x0..arity-1 for move_call_args kinds), load_reg spill/remat staging
-- (x16), and the x17 result cell. 0 - 1 = full caller-saved clobber
-- (true barrier): real calls (14/15), fiber stack switches (16-18),
-- syscall (34 — the kernel owns the caller-saved file), bump-alloc and
-- the sized mem family (1/23/24 — their grow/copy arms BL out), and
-- any unknown kind. d/s-register scratch (the float converts 25-33
-- stage through d0/s0) is NOT covered here — the fp barrier
-- classification owns the FP file. x27/x28 writes (kinds 21/22) are
-- outside the tracked file. C1b re-scratched the bespoke arms off the
-- pools: 2/3/8 read via load_reg with x15 staging (no move_call_args),
-- 12 loops through x15/x16/x17, 35-37 stage base in x15 and the value
-- in x17, 38-43 carry the value in x17 and read the address direct.
-- Only content-eq (44) still needs pool scratch (x10-x15 — a 6-register
-- byte loop; 4 non-pool scratch regs exist). Audited against
-- pipeline_ir_native_emit_intrinsic_call arm by arm 2026-08-03; a new
-- intrinsic kind MUST be added here or it is conservatively a true
-- barrier.
fn pipeline_ir_native_intrinsic_clobber_mask(kind: i64) -> i64 {
  -- 196608 = x16|x17; 196609 adds x0; 229376 = x15|x16|x17; 229377 adds x0
  if kind == 2 or kind == 3 or kind == 8 { 229376 }
  else { if kind == 4 or kind == 5 or kind == 6 or kind == 7 or kind == 9 or kind == 10 or kind == 11 { 196609 }
  else { if kind == 12 { 229377 }
  else { if kind == 13 { 196609 }
  else { if kind == 19 or kind == 20 { 196608 }
  else { if kind == 21 or kind == 22 { 196609 }
  else { if kind >= 25 and kind <= 33 { 196609 }
  else { if kind >= 35 and kind <= 37 { 229376 }
  else { if kind >= 38 and kind <= 43 { 196608 }
  else { if kind == 44 { 261120 }                     -- x10-x15|x16|x17
  else { 0 - 1 } } } } } } } } } }
}

-- 2v Stage 2 C1 simple-flip: an intrinsic is pool-transparent when its
-- audited clobber mask misses every register the caller-saved pools can
-- hand out (x1-x14; bits 1-14 = 32766) — the emission touches only x0
-- arg staging, x16 spill scratch, and the x17 result cell (plus x27/x28
-- for the runtime-state writers, outside the tracked file). A
-- pool-transparent intrinsic is NO BARRIER AT ALL to the resident walk:
-- operand reads stage through move_call_args and the result store goes
-- through store_reg_pinned, both pinned-map-aware, so pool, bank, split,
-- and naked tenancies survive it (no BL is emitted, so naked's missing
-- lr save is safe too). CONTRACT: flipping simple also short-circuits
-- fp_simple, so a mask below 32768 additionally asserts the arm never
-- writes the d2-d7 FP pool — kinds 25-33 stage through d0/s0 only,
-- every other transparent kind is GPR-pure. Auditing a new kind's mask
-- into the transparent range asserts BOTH register files.
fn pipeline_ir_native_intrinsic_pool_transparent(kind: i64) -> i64 {
  let mask = pipeline_ir_native_intrinsic_clobber_mask(kind)
  if mask == 0 - 1 { 0 }
  else { if (mask band 32766) == 0 { 1 } else { 0 } }
}

fn pipeline_ir_native_intrinsic_arity(kind: i64) -> i64 {
  if kind == 44 { 2 }
  else { if kind == 35 { 2 }
  else { if kind == 36 { 3 }
  else { if kind == 37 { 3 }
  else { if kind == 38 { 1 }
  else { if kind == 39 { 2 }
  else { if kind == 40 { 2 }
  else { if kind == 41 { 1 }
  else { if kind == 42 { 2 }
  else { if kind == 43 { 2 }
  else { if kind == 1 { 1 }
  else { if kind == 2 { 2 }
  else { if kind == 3 { 2 }
  else { if kind == 4 { 1 }
  else { if kind == 5 { 1 }
  else { if kind == 6 { 1 }
  else { if kind == 7 { 1 }
  else { if kind == 8 { 2 }
  else { if kind == 9 { 1 }
  else { if kind == 10 { 1 }
  else { if kind == 11 { 1 }
  else { if kind == 12 { 1 }
  else { if kind == 13 { 1 }
  else { if kind == 14 { 2 }
  else { if kind == 15 { 2 }
  else { if kind == 16 { 3 }
  else { if kind == 17 { 1 }
  else { if kind == 18 { 2 }
  else { if kind == 19 { 0 }
  else { if kind == 20 { 0 }
  else { if kind == 21 { 1 }
  else { if kind == 22 { 1 }
  else { if kind == 23 { 3 }
  else { if kind == 24 { 4 }
  else { if kind == 25 { 1 }
  else { if kind == 26 { 1 }
  else { if kind == 27 { 1 }
  else { if kind == 28 { 1 }
  else { if kind == 29 { 1 }
  else { if kind == 30 { 1 }
  else { if kind == 31 { 1 }
  else { if kind == 32 { 1 }
  else { if kind == 33 { 1 }
  else { if kind == 34 { 7 } else { 0 - 1 } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } }
}

fn pipeline_ir_native_intrinsic_supported(callee_hash: i64, args: IrValueList) -> i64 {
  let kind = pipeline_ir_native_intrinsic_kind(callee_hash)
  if kind == 0 { 0 }
  else { if ir_value_list_len(args) == pipeline_ir_native_intrinsic_arity(kind) { 1 } else { 0 } }
}

fn pipeline_ir_native_call_supported(callee_hash: i64, args: IrValueList, fm: i64, facts: PipelineIrSemanticFactList) -> i64 {
  if pipeline_ir_native_intrinsic_supported(callee_hash, args) == 1 {
    1
  } else {
    if fmap_contains_hash(fm, callee_hash) == 1 {
      1
    } else {
      if mono_cache_lookup(fmap_mono_cache(fm), callee_hash) > 0 { 1 } else { 0 }
    }
  }
}

fn pipeline_ir_native_generic_call_supported(callee_hash: i64, type_args: TypeExprList, fm: i64) -> i64 {
  let spec_hash = mono_spec_hash(callee_hash, type_expr_list_to_nodes(type_args))
  if mono_cache_lookup(fmap_mono_cache(fm), spec_hash) != 0 { 1 } else { 0 }
}

fn pipeline_ir_native_binary_op_supported(op: IrBinaryOp) -> i64 {
  ir_binary_op_is_supported(op)
}

fn pipeline_fmap_hash_owner_count(fm: i64, target_hash: i64) -> i64 {
  let n = mem_load64_at(fm + 8, 0)
  let d = mem_load64_at(fm, 0)
  let mut i = 0
  let mut count = 0
  while i < n {
    let e_ns = mem_load64_at(d + i * 40, 0)
    let e_nl = mem_load64_at(d + i * 40 + 8, 0)
    let e_src = mem_load64_at(d + i * 40 + 24, 0)
    if str_hash(e_src, e_ns, e_nl) == target_hash {
      count = count + 1
    } else { 0 }
    i = i + 1
  }
  count
}

fn pipeline_ir_native_block_param_count_or(blocks: IrBlockList, target: i64, default: i64) -> i64 {
  match blocks {
    IrBlockListNil -> default
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          if id == target {
            ir_value_list_len(params)
          } else {
            pipeline_ir_native_block_param_count_or(rest, target, default)
          }
        }
      }
    }
  }
}

fn pipeline_ir_native_first_block_param_term_detail(term: IrTerminator, all_blocks: IrBlockList) -> i64 {
  match term {
    IrTermJump(target, args) -> {
      let target_params = pipeline_ir_native_block_param_count_or(all_blocks, target, 0 - 1)
      let arg_count = ir_value_list_len(args)
      if target_params < 0 or arg_count != target_params {
        node_new(0, 2, target, arg_count, target_params)
      } else {
        0
      }
    }
    IrTermBranch(cond, then_block, else_block) -> {
      let then_params = pipeline_ir_native_block_param_count_or(all_blocks, then_block, 0 - 1)
      let else_params = pipeline_ir_native_block_param_count_or(all_blocks, else_block, 0 - 1)
      if then_params < 0 or else_params < 0 or then_params != 0 or else_params != 0 {
        node_new(0, 3, then_block, then_params, else_params)
      } else {
        0
      }
    }
    _ -> 0
  }
}

fn pipeline_ir_native_first_block_param_term_detail_blocks(blocks: IrBlockList, all_blocks: IrBlockList) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          let detail = pipeline_ir_native_first_block_param_term_detail(term, all_blocks)
          if detail != 0 {
            detail
          } else {
            pipeline_ir_native_first_block_param_term_detail_blocks(rest, all_blocks)
          }
        }
      }
    }
  }
}

fn pipeline_ir_native_block_params_or(blocks: IrBlockList, target: i64, default: IrValueList) -> IrValueList {
  match blocks {
    IrBlockListNil -> default
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          if id == target {
            params
          } else {
            pipeline_ir_native_block_params_or(rest, target, default)
          }
        }
      }
    }
  }
}

