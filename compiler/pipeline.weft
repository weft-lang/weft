fn pipeline_ir_semantic_fact_count_list(facts: PipelineIrSemanticFactList) -> i64 {
  match facts {
    PipelineIrSemanticFactNil -> 0
    PipelineIrSemanticFactCons(hash, fact, rest) -> 1 + pipeline_ir_semantic_fact_count_list(rest)
  }
}

fn pipeline_ir_semantic_fact_count(ir: IrModule) -> i64 {
  pipeline_ir_semantic_fact_count_list(pipeline_ir_semantic_facts(ir))
}

fn pipeline_ir_semantic_closed_effect_fact_count_list(facts: PipelineIrSemanticFactList) -> i64 {
  match facts {
    PipelineIrSemanticFactNil -> 0
    PipelineIrSemanticFactCons(hash, fact, rest) -> {
      let add = if cg_semantic_fact_closed(fact) == 1 { 1 } else { 0 }
      add + pipeline_ir_semantic_closed_effect_fact_count_list(rest)
    }
  }
}

fn pipeline_ir_semantic_closed_effect_fact_count(ir: IrModule) -> i64 {
  pipeline_ir_semantic_closed_effect_fact_count_list(pipeline_ir_semantic_facts(ir))
}

