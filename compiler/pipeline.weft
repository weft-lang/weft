-- Retarget only definition-owned lookup facts while preserving the caller's
-- installed-handler, parallel-scope, function-table, and inlining contexts.
-- Named handler clauses are checked and lowered in their defining module;
-- their handled body remains in the installing caller module.
pub(package) fn pipeline_lower_module_retarget(module: PipelineLowerModule, src: i64, subst: i64) -> PipelineLowerModule {
  match module {
    PipelineLowerModule(old_src, tt, fns, handlers, old_subst, par_ctx, inline_depth) -> PipelineLowerModule(src, tt, fns, handlers, subst, par_ctx, inline_depth)
  }
}

