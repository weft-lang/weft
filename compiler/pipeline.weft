    Handle(body, clauses, hret) -> pipeline_expr_has_generator_i64_new_typed(body, src) or pipeline_handler_clause_list_has_generator_i64_new_typed(clauses, src) or (match hret { NoHandleReturn -> false HandleReturnClause(rns, rnl, rb) -> pipeline_expr_has_generator_i64_new_typed(rb, src) })
