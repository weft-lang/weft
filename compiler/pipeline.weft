-- Local scalar-replacement representation fact. `candidates` is the monotone closure of
-- one-word, unmanaged variant constructors through exact SSA transport;
-- `unsafe_values` is the connected subset with an escaping/opaque use. The
-- two dense maps describe the scalar representation selected for every safe
-- value: constructor tag and payload lane. Consumers never rescan source
-- names or types.
pub(package) type PipelineIrSmallVariantFacts {
  PipelineIrSmallVariantFacts(PipelineIrLiveSet, PipelineIrLiveSet, PipelineIrConstEnv, PipelineIrConstEnv, i64, i64)
}

pub(package) type PipelineIrSmallVariantSpecialisations {
  PipelineIrSmallVariantSpecialisations(IrFunctionList, PipelineIrSemanticFactList, i64)
}

pub(package) type PipelineDceInsts {
  PipelineDceInsts(IrInstList, PipelineIrLiveSet, i64, i64)
}

