pub(package) fn pipeline_ir_native_vector_word_type_args(type_args: TypeExprList) -> i64 {
  let prim = type_expr_list_nth_prim_id_or(type_args, 0, 0 - 1)
  if type_expr_list_len(type_args) == 1 and (prim == PRIM_I64() or prim == PRIM_F64()) { 1 } else { 0 }
}

pub(package) fn pipeline_ir_native_vector_type_arg_node(type_args: TypeExprList) -> i64 {
  if type_expr_list_len(type_args) == 1 {
    type_expr_to_node(type_expr_list_nth(type_args, 0))
  } else {
    0
  }
}

pub(package) fn pipeline_ir_native_map_scalar_payload_intrinsic(callee_hash: i64, type_args: TypeExprList, args: IrValueList, tt: i64) -> i64 {
  if tt == 0 { 0 }
  else {
    let nargs = ir_value_list_len(args)
    let shape = if callee_hash == pipeline_ir_native_map_storage_load_owned_hash() and nargs == 1 { 1 }
    else { if (callee_hash == pipeline_ir_native_map_storage_retain_word_hash() or callee_hash == pipeline_ir_native_map_storage_retain_stored_hash()) and nargs == 2 { 1 }
    else { 0 } }
    if shape == 0 { 0 }
    else {
      let ty = pipeline_ir_native_vector_type_arg_node(type_args)
      if ty != 0 and cg_managed_drop_kind_for_ty(ty) == 0 { 1 } else { 0 }
    }
  }
}

pub(package) fn pipeline_ir_native_emit_const_i64(code: i64, dst: i64, value: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  emit_mov_imm_safe(code, 17, value)
  pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17)
}

pub(package) fn pipeline_ir_native_emit_vector_element_size_of(code: i64, dst: i64, type_args: TypeExprList, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let ty = pipeline_ir_native_vector_type_arg_node(type_args)
  let size = cg_layout_vector_element_size(fmap_get_tt(fm), ty)
  let value = if size < 0 { 8 } else { size }
  pipeline_ir_native_emit_const_i64(code, dst, value, pinned)
}

pub(package) fn pipeline_ir_native_emit_vector_element_mode_of(code: i64, dst: i64, type_args: TypeExprList, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let ty = pipeline_ir_native_vector_type_arg_node(type_args)
  pipeline_ir_native_emit_const_i64(code, dst, cg_layout_vector_element_mode(fmap_get_tt(fm), ty), pinned)
}

pub(package) fn pipeline_ir_native_emit_vector_element_leaf_count_of(code: i64, dst: i64, type_args: TypeExprList, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let ty = pipeline_ir_native_vector_type_arg_node(type_args)
  let count = if ty != 0 and ty_is_array(ty) { cg_layout_array_leaf_count(ty) } else { 0 - 1 }
  pipeline_ir_native_emit_const_i64(code, dst, count, pinned)
}

pub(package) fn pipeline_ir_native_emit_vector_element_leaf_stride_of(code: i64, dst: i64, type_args: TypeExprList, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let ty = pipeline_ir_native_vector_type_arg_node(type_args)
  let count = if ty != 0 and ty_is_array(ty) { cg_layout_array_leaf_count(ty) } else { 0 }
  let stride = if count > 0 { cg_layout_array_leaf_stride(fmap_get_tt(fm), ty) } else { 0 }
  pipeline_ir_native_emit_const_i64(code, dst, if stride < 0 { 0 } else { stride }, pinned)
}

pub(package) fn pipeline_ir_native_emit_vector_element_leaf_kind_of(code: i64, dst: i64, type_args: TypeExprList, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let ty = pipeline_ir_native_vector_type_arg_node(type_args)
  let count = if ty != 0 and ty_is_array(ty) { cg_layout_array_leaf_count(ty) } else { 0 }
  let kind = if count > 0 { cg_layout_array_leaf_drop_kind(fmap_get_tt(fm), ty) } else { 0 }
  pipeline_ir_native_emit_const_i64(code, dst, if kind < 0 { 0 } else { kind }, pinned)
}

pub(package) fn pipeline_ir_native_emit_map_storage_cleanup_kind_of(code: i64, dst: i64, type_args: TypeExprList, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let ty = pipeline_ir_native_vector_type_arg_node(type_args)
  pipeline_ir_native_emit_const_i64(code, dst, cg_managed_drop_kind_for_ty(ty), pinned)
}

pub(package) fn pipeline_ir_native_emit_addr_plus_imm(code: i64, dst_reg: i64, base_reg: i64, offset: i64) -> i64 {
  if offset <= 4095 {
    bu32(code, encode_add_imm(dst_reg, base_reg, offset))
  } else {
    emit_mov_imm_safe(code, 13, offset)
    bu32(code, encode_add_reg(dst_reg, base_reg, 13))
  }
}

pub(package) fn pipeline_ir_native_emit_inline_record_store_field(code: i64, addr_reg: i64, value_reg: i64, tt: i64, ty: i64, field_index: i64) -> i64 {
  let entry = cg_layout_record_entry(tt, ty)
  let fty = cg_layout_field_type_at(entry, ty, field_index)
  let offset = cg_layout_field_offset(tt, ty, field_index)
  let size = cg_layout_inline_size(tt, fty)
  let mode = cg_layout_vector_element_mode(tt, fty)
  if offset < 0 or size <= 0 { 0 }
  else {
    pipeline_ir_native_emit_addr_plus_imm(code, 0, addr_reg, offset)
    emit_mov_imm_safe(code, 1, size)
    emit_mov_imm_safe(code, 2, mode)
    bu32(code, cg_ldr(3, value_reg, field_index * 8))
    pipeline_ir_native_emit_mem_store_sized_result(code)
  }
}

pub(package) fn pipeline_ir_native_emit_inline_record_store_fields(code: i64, addr_reg: i64, value_reg: i64, tt: i64, ty: i64, index: i64, count: i64) -> i64 {
  if index >= count { 0 }
  else {
    pipeline_ir_native_emit_inline_record_store_field(code, addr_reg, value_reg, tt, ty, index)
    pipeline_ir_native_emit_inline_record_store_fields(code, addr_reg, value_reg, tt, ty, index + 1, count)
  }
}

pub(package) fn pipeline_ir_native_emit_vector_storage_store_inline_record(code: i64, dst: i64, type_args: TypeExprList, args: IrValueList, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let ty = pipeline_ir_native_vector_type_arg_node(type_args)
  let tt = fmap_get_tt(fm)
  let entry = cg_layout_record_entry(tt, ty)
  let count = if entry == 0 { 0 } else { mem_load64_at(entry + 24, 0) }
  let addr = pipeline_ir_value_list_get_or(args, 0, 0 - 1)
  let value = pipeline_ir_value_list_get_or(args, 3, 0 - 1)
  let addr_phys = pipeline_ir_native_load_reg(code, pinned, addr)
  if addr_phys == 14 { 0 } else { bu32(code, encode_add_imm(14, addr_phys, 0)) }
  let value_phys = pipeline_ir_native_load_reg(code, pinned, value)
  if value_phys == 15 { 0 } else { bu32(code, encode_add_imm(15, value_phys, 0)) }
  pipeline_ir_native_emit_inline_record_store_fields(code, 14, 15, tt, ty, 0, count)
  emit_mov_imm_safe(code, 17, 0)
  pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17)
  fmap_inc_vector_lowering_count(fm)
}

pub(package) fn pipeline_ir_native_emit_inline_record_load_field(code: i64, fm: i64, addr_reg: i64, record_reg: i64, tt: i64, ty: i64, field_index: i64) -> i64 {
  let entry = cg_layout_record_entry(tt, ty)
  let fty = cg_layout_field_type_at(entry, ty, field_index)
  let offset = cg_layout_field_offset(tt, ty, field_index)
  let size = cg_layout_inline_size(tt, fty)
  let mode = cg_layout_vector_element_mode(tt, fty)
  if offset < 0 or size <= 0 { 0 }
  else {
    pipeline_ir_native_emit_addr_plus_imm(code, 0, addr_reg, offset)
    emit_mov_imm_safe(code, 1, size)
    emit_mov_imm_safe(code, 2, mode)
    pipeline_ir_native_emit_mem_load_sized_result(code, fm)
    bu32(code, cg_str(17, record_reg, field_index * 8))
  }
}

pub(package) fn pipeline_ir_native_emit_inline_record_load_fields(code: i64, fm: i64, addr_reg: i64, record_reg: i64, tt: i64, ty: i64, index: i64, count: i64) -> i64 {
  if index >= count { 0 }
  else {
    pipeline_ir_native_emit_inline_record_load_field(code, fm, addr_reg, record_reg, tt, ty, index)
    pipeline_ir_native_emit_inline_record_load_fields(code, fm, addr_reg, record_reg, tt, ty, index + 1, count)
  }
}

pub(package) fn pipeline_ir_native_emit_vector_storage_load_inline_record(code: i64, dst: i64, type_args: TypeExprList, args: IrValueList, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let ty = pipeline_ir_native_vector_type_arg_node(type_args)
  let tt = fmap_get_tt(fm)
  let entry = cg_layout_record_entry(tt, ty)
  let count = if entry == 0 { 0 } else { mem_load64_at(entry + 24, 0) }
  let addr = pipeline_ir_value_list_get_or(args, 0, 0 - 1)
  let record_size = count * 8
  let alloc_size = if record_size < 8 { 8 } else { record_size }
  -- The bump allocator's growth arm uses x14 while establishing the
  -- replacement region. Materialise the source address only after the
  -- allocation so a first-use grow cannot replace it with the allocator's
  -- size-plus-header temporary (and turn the field loads into small-address
  -- dereferences).
  cg_bump_alloc_imm(code, fm, 17, alloc_size)
  let addr_phys = pipeline_ir_native_load_reg(code, pinned, addr)
  if addr_phys == 14 { 0 } else { bu32(code, encode_add_imm(14, addr_phys, 0)) }
  bu32(code, encode_add_imm(15, 17, 0))
  pipeline_ir_native_emit_inline_record_load_fields(code, fm, 14, 15, tt, ty, 0, count)
  pipeline_ir_native_store_reg_pinned(code, pinned, dst, 15)
  fmap_inc_vector_lowering_count(fm)
}

pub(package) fn pipeline_ir_vector_storage_inline_record_type_tt(type_args: TypeExprList, tt: i64) -> i64 {
  let ty = pipeline_ir_native_vector_type_arg_node(type_args)
  if cg_layout_vector_record_inline_eligible(tt, ty) == 1 { 1 } else { 0 }
}

pub(package) fn pipeline_ir_native_vector_storage_inline_record_type(type_args: TypeExprList, fm: i64) -> i64 {
  pipeline_ir_vector_storage_inline_record_type_tt(type_args, fmap_get_tt(fm))
}

-- Mirrors pipeline_ir_native_emit_generic_call's dispatch: generic-call
-- sites the backend does NOT lower as a plain call to the collected
-- spec body. Constant intrinsics substitute a per-spec value; the
-- scalar CHAMP payload helpers substitute identity/no-op ownership code; the
-- vector store/load family substitutes byte-accurate inline-record
-- code when the element type is an inline record. Any pass that
-- resolves a generic call site to its spec body (the multi-inliner's
-- splice) must leave these sites opaque — the spec body is not the
-- site's semantics. tt == 0 (the untyped optimise path) is
-- conservative: the whole family stays opaque.
pub(package) fn pipeline_ir_native_generic_call_emission_intercepted(callee_hash: i64, type_args: TypeExprList, args: IrValueList, tt: i64) -> i64 {
  if pipeline_ir_native_generic_call_constant_intrinsic(callee_hash, args) == 1 { 1 }
  else { if ((callee_hash == pipeline_ir_native_par_work_pack_hash() or callee_hash == pipeline_ir_native_task_work_pack_hash()) and ir_value_list_len(args) == 1) or
    ((callee_hash == pipeline_ir_native_par_work_take_hash() or callee_hash == pipeline_ir_native_task_work_take_hash()) and ir_value_list_len(args) == 1) { 1 }
  else { if pipeline_ir_native_map_scalar_payload_intrinsic(callee_hash, type_args, args, tt) == 1 { 1 }
  else {
    let nargs = ir_value_list_len(args)
    let store_family = if (callee_hash == pipeline_ir_native_vector_storage_store_value_hash() or callee_hash == pipeline_ir_native_vector_store_value_hash()) and nargs == 4 { 1 } else { 0 }
    let load_family = if (callee_hash == pipeline_ir_native_vector_storage_load_value_hash() or callee_hash == pipeline_ir_native_vector_load_value_hash()) and nargs == 4 { 1 } else { 0 }
    let load_ib = if callee_hash == pipeline_ir_native_vector_storage_load_value_in_bounds_hash() and nargs == 3 { 1 } else { 0 }
    if store_family == 0 and load_family == 0 and load_ib == 0 { 0 }
    else { if tt == 0 { 1 }
    else { pipeline_ir_vector_storage_inline_record_type_tt(type_args, tt) } }
  } } }
}

pub(package) fn pipeline_ir_native_emit_map_scalar_payload(code: i64, dst: i64, callee_hash: i64, args: IrValueList, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  if callee_hash == pipeline_ir_native_map_storage_retain_word_hash() {
    pipeline_ir_native_emit_const_i64(code, dst, 0, pinned)
  } else {
    let index = if callee_hash == pipeline_ir_native_map_storage_load_owned_hash() { 0 } else { 1 }
    let value = pipeline_ir_value_list_get_or(args, index, 0 - 1)
    let phys = pipeline_ir_native_load_reg(code, pinned, value)
    pipeline_ir_native_store_reg_pinned(code, pinned, dst, phys)
  }
}

pub(package) fn pipeline_ir_native_emit_vector_reserve_call(code: i64, vec_reg: i64, needed_reg: i64, type_args: TypeExprList, fm: i64) -> i64 {
  if vec_reg == 0 { 0 } else { bu32(code, encode_add_imm(0, vec_reg, 0)) }
  if needed_reg == 1 { 0 } else { bu32(code, encode_add_imm(1, needed_reg, 0)) }
  let reserve_hash = pipeline_ir_native_vector_reserve_hash()
  let spec_hash = mono_spec_hash(reserve_hash, type_expr_list_to_nodes(type_args))
  let target = mono_cache_lookup(fmap_mono_cache(fm), spec_hash)
  let cur = buf_len(code)
  if target <= 1 {
    fmap_add_patch(fm, cur, 0, spec_hash, 0)
    bu32(code, encode_bl(0))
  } else {
    bu32(code, encode_bl(target - cur))
  }
}

pub(package) fn pipeline_ir_native_emit_vector_len_i64(code: i64, dst: i64, vec: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  emit_mov_imm_safe(code, 17, 0)
  let vec_phys = pipeline_ir_native_load_reg(code, pinned, vec)
  if vec_phys == 14 { 0 } else { bu32(code, encode_add_imm(14, vec_phys, 0)) }
  let null_pos = buf_len(code)
  bu32(code, 0)
  bu32(code, cg_ldr(17, 14, 8))
  let done = buf_len(code)
  cg_patch_cbz(code, null_pos, 14, done)
  pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17)
  fmap_inc_vector_lowering_count(fm)
}

pub(package) fn pipeline_ir_native_emit_vector_push_word(code: i64, dst: i64, vec: i64, value: i64, type_args: TypeExprList, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  emit_mov_imm_safe(code, 17, 0)
  let vec_phys = pipeline_ir_native_load_reg(code, pinned, vec)
  if vec_phys == 14 { 0 } else { bu32(code, encode_add_imm(14, vec_phys, 0)) }
  let null_pos = buf_len(code)
  bu32(code, 0)

  bu32(code, cg_ldr(15, 14, 8))
  bu32(code, encode_add_imm(16, 15, 1))
  bu32(code, cg_ldr(11, 14, 16))
  cg_cmp_emit(code, 9, 13, 16, 11)
  let grow_pos = buf_len(code)
  bu32(code, 0)

  let store_start = buf_len(code)
  let vec_store_phys = pipeline_ir_native_load_reg(code, pinned, vec)
  if vec_store_phys == 14 { 0 } else { bu32(code, encode_add_imm(14, vec_store_phys, 0)) }
  let value_phys = pipeline_ir_native_load_reg(code, pinned, value)
  if value_phys == 12 { 0 } else { bu32(code, encode_add_imm(12, value_phys, 0)) }
  bu32(code, cg_ldr(15, 14, 8))
  bu32(code, cg_ldr(16, 14, 0))
  bu32(code, encode_str_reg_lsl3(12, 16, 15))
  bu32(code, encode_add_imm(15, 15, 1))
  bu32(code, cg_str(15, 14, 8))
  emit_mov_imm_safe(code, 17, 1)
  let skip_grow_pos = buf_len(code)
  bu32(code, 0)

  let grow_start = buf_len(code)
  cg_patch_cbz(code, grow_pos, 13, grow_start)
  let vec_grow_phys = pipeline_ir_native_load_reg(code, pinned, vec)
  if vec_grow_phys == 14 { 0 } else { bu32(code, encode_add_imm(14, vec_grow_phys, 0)) }
  bu32(code, cg_ldr(15, 14, 8))
  bu32(code, encode_add_imm(16, 15, 1))
  pipeline_ir_native_emit_vector_reserve_call(code, 14, 16, type_args, fm)
  let reserve_failed_pos = buf_len(code)
  bu32(code, 0)
  let back_pos = buf_len(code)
  bu32(code, encode_b(store_start - back_pos))

  let done = buf_len(code)
  cg_patch_cbz(code, null_pos, 14, done)
  cg_patch_cbz(code, reserve_failed_pos, 0, done)
  bytes_set_u32(code, skip_grow_pos, encode_b(done - skip_grow_pos))
  pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17)
  fmap_inc_vector_lowering_count(fm)
  fmap_inc_vector_scaled_addr_count(fm)
  fmap_inc_vector_push_no_grow_count(fm)
}

pub(package) fn pipeline_ir_native_emit_generic_call_default(code: i64, dst: i64, callee_hash: i64, type_args: TypeExprList, args: IrValueList, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let spec_hash = mono_spec_hash(callee_hash, type_expr_list_to_nodes(type_args))
  let target = mono_cache_lookup(fmap_mono_cache(fm), spec_hash)
  if target == 0 {
    bu32(code, encode_brk(8))
  } else {
    pipeline_ir_native_move_call_args(code, args, 0, pinned)
    let cur = buf_len(code)
    if target <= 1 {
      fmap_add_patch(fm, cur, 0, spec_hash, 0)
      bu32(code, encode_bl(0))
    } else {
      bu32(code, encode_bl(target - cur))
    }
    pipeline_ir_native_store_reg_pinned(code, pinned, dst, 0)
  }
}

pub(package) fn pipeline_ir_native_emit_generic_call(code: i64, dst: i64, callee_hash: i64, type_args: TypeExprList, args: IrValueList, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  if callee_hash == pipeline_ir_native_vector_element_size_of_hash() and ir_value_list_len(args) == 0 {
    pipeline_ir_native_emit_vector_element_size_of(code, dst, type_args, fm, pinned)
  } else { if callee_hash == pipeline_ir_native_vector_element_mode_of_hash() and ir_value_list_len(args) == 0 {
    pipeline_ir_native_emit_vector_element_mode_of(code, dst, type_args, fm, pinned)
  } else { if callee_hash == pipeline_ir_native_vector_element_leaf_count_of_hash() and ir_value_list_len(args) == 0 {
    pipeline_ir_native_emit_vector_element_leaf_count_of(code, dst, type_args, fm, pinned)
  } else { if callee_hash == pipeline_ir_native_vector_element_leaf_stride_of_hash() and ir_value_list_len(args) == 0 {
    pipeline_ir_native_emit_vector_element_leaf_stride_of(code, dst, type_args, fm, pinned)
  } else { if callee_hash == pipeline_ir_native_vector_element_leaf_kind_of_hash() and ir_value_list_len(args) == 0 {
    pipeline_ir_native_emit_vector_element_leaf_kind_of(code, dst, type_args, fm, pinned)
  } else { if callee_hash == pipeline_ir_native_map_storage_cleanup_kind_of_hash() and ir_value_list_len(args) == 0 {
    pipeline_ir_native_emit_map_storage_cleanup_kind_of(code, dst, type_args, fm, pinned)
  } else { if (callee_hash == pipeline_ir_native_par_work_pack_hash() or callee_hash == pipeline_ir_native_task_work_pack_hash()) and ir_value_list_len(args) == 1 {
    pipeline_ir_native_emit_par_work_pack(code, dst, type_args, args, fm, pinned, if callee_hash == pipeline_ir_native_task_work_pack_hash() { 1 } else { 0 })
  } else { if (callee_hash == pipeline_ir_native_par_work_take_hash() or callee_hash == pipeline_ir_native_task_work_take_hash()) and ir_value_list_len(args) == 1 {
    pipeline_ir_native_emit_par_work_take(code, dst, type_args, args, fm, pinned, if callee_hash == pipeline_ir_native_task_work_take_hash() { 1 } else { 0 })
  } else { if pipeline_ir_native_map_scalar_payload_intrinsic(callee_hash, type_args, args, fmap_get_tt(fm)) == 1 {
    pipeline_ir_native_emit_map_scalar_payload(code, dst, callee_hash, args, pinned)
  } else { if (callee_hash == pipeline_ir_native_vector_storage_store_value_hash() or callee_hash == pipeline_ir_native_vector_store_value_hash()) and ir_value_list_len(args) == 4 and pipeline_ir_native_vector_storage_inline_record_type(type_args, fm) == 1 {
    pipeline_ir_native_emit_vector_storage_store_inline_record(code, dst, type_args, args, fm, pinned)
  } else { if ((callee_hash == pipeline_ir_native_vector_storage_load_value_hash() or callee_hash == pipeline_ir_native_vector_load_value_hash()) and ir_value_list_len(args) == 4 and pipeline_ir_native_vector_storage_inline_record_type(type_args, fm) == 1) or
    (callee_hash == pipeline_ir_native_vector_storage_load_value_in_bounds_hash() and ir_value_list_len(args) == 3 and pipeline_ir_native_vector_storage_inline_record_type(type_args, fm) == 1) {
    pipeline_ir_native_emit_vector_storage_load_inline_record(code, dst, type_args, args, fm, pinned)
  } else {
    pipeline_ir_native_emit_generic_call_default(code, dst, callee_hash, type_args, args, fm, pinned)
  } } } } } } } } } } }
  fmap_inc_typed_generic_call_emit_count(fm)
}

pub(package) fn pipeline_ir_native_method_forward_key(mm: i64, type_hash: i64, method_hash: i64, type_hash_is_trait: i64) -> i64 {
  if type_hash_is_trait == 1 {
    let owner_hash = mmap_lookup_type_by_method(mm, method_hash)
    if owner_hash == 0 { 0 } else { pipeline_ir_method_patch_key(owner_hash, method_hash) }
  } else {
    pipeline_ir_method_patch_key(type_hash, method_hash)
  }
}

pub(package) fn pipeline_ir_native_emit_method_call(code: i64, dst: i64, type_hash: i64, method_hash: i64, receiver: i64, args: IrValueList, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let mm = fmap_mmap(fm)
  let recv_phys = pipeline_ir_native_load_reg(code, pinned, receiver)
  bu32(code, encode_add_imm(0, recv_phys, 0))
  pipeline_ir_native_move_call_args(code, args, 1, pinned)
  let type_hash_is_trait = ttable_hash_is_trait(fmap_get_tt(fm), type_hash)
  let mut target = mmap_lookup(mm, type_hash, method_hash)
  if target == 0 and type_hash_is_trait == 1 {
    target = mmap_lookup_by_method(mm, method_hash)
  } else { target = target }
  if target <= 1 {
    let patch_key = pipeline_ir_native_method_forward_key(mm, type_hash, method_hash, type_hash_is_trait)
    if patch_key != 0 and mono_cache_lookup(fmap_mono_cache(fm), patch_key) != 0 {
      let cur = buf_len(code)
      fmap_add_patch(fm, cur, 0, patch_key, 0)
      bu32(code, encode_bl(0))
      pipeline_ir_native_store_reg_pinned(code, pinned, dst, 0)
      fmap_inc_typed_method_call_emit_count(fm)
    } else {
      -- Keep the trap as local poison for direct emitter tests, but make it
      -- impossible for pipeline_emit_native to publish the poisoned binary.
      fmap_inc_emit_error_count(fm)
      bu32(code, encode_brk(9))
    }
  } else {
    let cur = buf_len(code)
    bu32(code, encode_bl(target - cur))
    pipeline_ir_native_store_reg_pinned(code, pinned, dst, 0)
    fmap_inc_typed_method_call_emit_count(fm)
  }
}

pub(package) fn pipeline_ir_native_emit_owned_drop(code: i64, value: i64, type_hash: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  pipeline_ir_native_emit_method_call(code, 0 - 1, type_hash, cg_drop_method_hash(), value, ir_value_list_empty(), fm, pinned)
}

pub(package) fn pipeline_ir_native_emit_array_storage(code: i64, dst: i64, byte_size: i64, align: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let fact = pipeline_ir_native_array_storage_fact_lookup(fmap_current_array_storage_facts(fm), dst)
  if fact == 0 or node_f3(fact) != byte_size or node_f4(fact) != align or
    pipeline_ir_native_array_storage_shape_is_valid(byte_size, align) == 0 {
    fmap_inc_emit_error_count(fm)
    bu32(code, encode_brk(29))
  } else {
    let offset = node_f2(fact)
    emit_stack_address_offset(code, 15, offset)
    pipeline_ir_native_store_reg_pinned(code, pinned, dst, 15)
    if byte_size > 0 {
      emit_mov_imm_safe(code, 16, byte_size)
      emit_mov_imm_safe(code, 17, 0)
      let loop_start = buf_len(code)
      let done_pos = buf_len(code)
      bu32(code, 0)
      bu32(code, cg_strb(17, 15, 0))
      bu32(code, encode_add_imm(15, 15, 1))
      bu32(code, encode_sub_imm(16, 16, 1))
      let back = buf_len(code)
      bu32(code, encode_b(loop_start - back))
      cg_patch_cbz(code, done_pos, 16, buf_len(code))
    } else { 0 }
  }
}

pub(package) fn pipeline_ir_native_emit_array_leaf_retain(code: i64, leaf_kind: i64, fm: i64) -> i64 {
  if leaf_kind == continuation_cleanup_kind_rc() {
    cg_emit_call_lit(code, fm, "rc_default_retain")
  } else { if leaf_kind == continuation_cleanup_kind_closure() {
    cg_emit_call_lit(code, fm, "closure_default_retain")
  } else { if leaf_kind == continuation_cleanup_kind_weak() {
    cg_emit_call_lit(code, fm, "rc_default_weak_retain")
  } else { 0 } } }
}

pub(package) fn pipeline_ir_native_ensure_array_copy_retain_glue(code: i64, leaf_count: i64, leaf_stride: i64, leaf_kind: i64, fm: i64) -> i64 {
  let key = pipeline_array_copy_retain_glue_hash(leaf_count, leaf_stride, leaf_kind)
  let cached = mono_cache_lookup(fmap_mono_cache(fm), key)
  if cached > 1 { cached }
  else {
    let skip = buf_len(code)
    bu32(code, 0)
    let entry = buf_len(code)
    mono_cache_add(fmap_mono_cache(fm), key, entry)
    -- [sp+0]=cursor, [sp+8]=remaining, [sp+16]=stride, [sp+24]=LR.
    bu32(code, encode_sub_imm(31, 31, 32))
    emit_store_spill_offset(code, 0, 0)
    emit_mov_imm_safe(code, 16, leaf_count)
    emit_store_spill_offset(code, 16, 8)
    emit_mov_imm_safe(code, 16, leaf_stride)
    emit_store_spill_offset(code, 16, 16)
    emit_store_spill_offset(code, 30, 24)
    let loop_start = buf_len(code)
    emit_load_spill_offset(code, 16, 8)
    let done_pos = buf_len(code)
    bu32(code, 0)
    emit_load_spill_offset(code, 15, 0)
    bu32(code, cg_ldr(0, 15, 0))
    pipeline_ir_native_emit_array_leaf_retain(code, leaf_kind, fm)
    emit_load_spill_offset(code, 15, 0)
    emit_load_spill_offset(code, 16, 16)
    bu32(code, encode_add_reg(15, 15, 16))
    emit_store_spill_offset(code, 15, 0)
    emit_load_spill_offset(code, 16, 8)
    bu32(code, encode_sub_imm(16, 16, 1))
    emit_store_spill_offset(code, 16, 8)
    let back = buf_len(code)
    bu32(code, encode_b(loop_start - back))
    let done = buf_len(code)
    cg_patch_cbz(code, done_pos, 16, done)
    emit_load_spill_offset(code, 30, 24)
    bu32(code, encode_add_imm(31, 31, 32))
    bu32(code, encode_ret())
    cg_patch_b(code, skip, buf_len(code))
    entry
  }
}

pub(package) fn pipeline_ir_native_emit_array_copy(code: i64, dst_data: i64, src_data: i64, byte_size: i64, leaf_count: i64, leaf_stride: i64, leaf_kind: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  if pipeline_array_copy_plan_is_valid(byte_size, leaf_count, leaf_stride, leaf_kind) == 0 {
    fmap_inc_emit_error_count(fm)
    bu32(code, encode_brk(30))
  } else {
    if byte_size > 0 {
      let dst_phys = pipeline_ir_native_load_reg(code, pinned, dst_data)
      if dst_phys == 15 { 0 } else { bu32(code, encode_add_imm(15, dst_phys, 0)) }
      let src_phys = pipeline_ir_native_load_reg(code, pinned, src_data)
      if src_phys == 16 { 0 } else { bu32(code, encode_add_imm(16, src_phys, 0)) }
      emit_mov_imm_safe(code, 17, byte_size)
      cg_emit_mem_copy_regs(code, 15, 16, 17)
      if pipeline_array_drop_plan_is_active(leaf_count, leaf_stride, leaf_kind) == 1 {
        let target = pipeline_ir_native_ensure_array_copy_retain_glue(code, leaf_count, leaf_stride, leaf_kind, fm)
        bu32(code, encode_add_imm(0, 15, 0))
        let call = buf_len(code)
        bu32(code, encode_bl(target - call))
      } else { 0 }
    } else { 0 }
  }
}

pub(package) fn pipeline_ir_native_emit_array_leaf_release(code: i64, leaf_kind: i64, fm: i64) -> i64 {
  if leaf_kind == continuation_cleanup_kind_rc() {
    cg_emit_call_lit(code, fm, "rc_default_release")
  } else { if leaf_kind == continuation_cleanup_kind_closure() {
    cg_emit_call_lit(code, fm, "closure_default_release")
  } else { if leaf_kind == continuation_cleanup_kind_weak() {
    cg_emit_call_lit(code, fm, "rc_default_weak_release")
  } else { 0 } } }
}

-- Materialise one plan-specific out-of-line helper in the native code stream.
-- It takes the array data pointer in x0 and walks leaves in source order. A
-- branch skips the helper during ordinary fallthrough; both normal ArrayDrop
-- calls and dynamic-wind cleanup records address the same generated entry.
pub(package) fn pipeline_ir_native_ensure_array_drop_glue(code: i64, leaf_count: i64, leaf_stride: i64, leaf_kind: i64, fm: i64) -> i64 {
  let key = pipeline_array_drop_glue_hash(leaf_count, leaf_stride, leaf_kind)
  let cached = mono_cache_lookup(fmap_mono_cache(fm), key)
  if cached > 1 { cached }
  else {
    let skip = buf_len(code)
    bu32(code, 0)
    let entry = buf_len(code)
    mono_cache_add(fmap_mono_cache(fm), key, entry)
    -- [sp+0]=cursor, [sp+8]=remaining, [sp+16]=stride, [sp+24]=LR.
    bu32(code, encode_sub_imm(31, 31, 32))
    emit_store_spill_offset(code, 0, 0)
    emit_mov_imm_safe(code, 16, leaf_count)
    emit_store_spill_offset(code, 16, 8)
    emit_mov_imm_safe(code, 16, leaf_stride)
    emit_store_spill_offset(code, 16, 16)
    emit_store_spill_offset(code, 30, 24)
    let loop_start = buf_len(code)
    emit_load_spill_offset(code, 16, 8)
    let done_pos = buf_len(code)
    bu32(code, 0)
    emit_load_spill_offset(code, 15, 0)
    bu32(code, cg_ldr(0, 15, 0))
    pipeline_ir_native_emit_array_leaf_release(code, leaf_kind, fm)
    emit_load_spill_offset(code, 15, 0)
    emit_load_spill_offset(code, 16, 16)
    bu32(code, encode_add_reg(15, 15, 16))
    emit_store_spill_offset(code, 15, 0)
    emit_load_spill_offset(code, 16, 8)
    bu32(code, encode_sub_imm(16, 16, 1))
    emit_store_spill_offset(code, 16, 8)
    let back = buf_len(code)
    bu32(code, encode_b(loop_start - back))
    let done = buf_len(code)
    cg_patch_cbz(code, done_pos, 16, done)
    emit_load_spill_offset(code, 30, 24)
    bu32(code, encode_add_imm(31, 31, 32))
    bu32(code, encode_ret())
    cg_patch_b(code, skip, buf_len(code))
    entry
  }
}

pub(package) fn pipeline_ir_native_emit_array_drop(code: i64, data: i64, leaf_count: i64, leaf_stride: i64, leaf_kind: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  if pipeline_array_drop_plan_is_valid(leaf_count, leaf_stride, leaf_kind) == 0 {
    fmap_inc_emit_error_count(fm)
    bu32(code, encode_brk(28))
  } else {
    if pipeline_array_drop_plan_is_active(leaf_count, leaf_stride, leaf_kind) == 1 {
      let target = pipeline_ir_native_ensure_array_drop_glue(code, leaf_count, leaf_stride, leaf_kind, fm)
      let data_phys = pipeline_ir_native_load_reg(code, pinned, data)
      if data_phys == 0 { 0 } else { bu32(code, encode_add_imm(0, data_phys, 0)) }
      let call = buf_len(code)
      bu32(code, encode_bl(target - call))
    } else { 0 }
  }
}

-- Structural resource cleanup consumes the substituted checker plan carried by
-- IrStructuralDropI64. Named records and variants are one managed pointer, so
-- they share a plan-specific out-of-line thunk between normal and abort paths.
-- Anonymous records/tuples remain flattened typed-IR lanes and are walked
-- inline. No native consumer reconstructs ownership from type syntax.
pub(package) fn pipeline_structural_drop_glue_hash(plan: i64) -> i64 {
  let identity = typeck_linear_layout_plan_identity(plan)
  let raw = (6739482174051931 * 33 + identity * 31 + typeck_linear_layout_plan_kind(plan) * 17) band 9223372036854775807
  if raw <= 1 { raw + 6739482174051931 } else { raw }
}

pub(package) fn pipeline_structural_drop_plan_value_words(plan: i64) -> i64 {
  let kind = typeck_linear_layout_plan_kind(plan)
  if kind == 4 or kind == 5 { 1 }
  else { typeck_linear_layout_plan_words(plan) }
}

-- Native root storage: 1 one scalar resource word, 2 flattened SSA words,
-- 3 one managed aggregate pointer. Opaque declarations preserve their exact
-- representation mode rather than becoming a fourth backend shape.
pub(package) fn pipeline_structural_drop_plan_storage_mode(plan: i64) -> i64 {
  let kind = typeck_linear_layout_plan_kind(plan)
  if kind == 1 { 1 }
  else { if kind == 2 or kind == 3 { 2 }
  else { if kind == 4 or kind == 5 { 3 }
  else { if kind == 6 { pipeline_structural_drop_plan_storage_mode(typeck_linear_layout_plan_children(plan)) }
  else { if kind == 7 { 3 }
  else { 0 } } } } }
}

-- The generic IR vocabulary deliberately exposes structural cleanup as one
-- base operand plus an opaque checker plan. Native analyses still need the
-- whole consecutive range for flattened records and tuples; managed named
-- aggregates and scalar resources remain one-word uses.
pub(package) fn pipeline_structural_drop_plan_use_words(plan: i64) -> i64 {
  if pipeline_structural_drop_plan_storage_mode(plan) == 2 {
    let words = typeck_linear_layout_plan_words(plan)
    if words > 0 { words } else { 1 }
  } else { 1 }
}

pub(package) fn pipeline_structural_drop_components_are_valid(components: i64, words: i64) -> i64 {
  if components == 0 or nlist_len(components) == 0 { 0 }
  else {
    let mut valid = 1
    let mut i = 0
    while i < nlist_len(components) and valid == 1 {
      let component = nlist_get(components, i)
      let child = typeck_linear_layout_component_plan(component)
      let offset = typeck_linear_layout_component_offset(component)
      let child_words = pipeline_structural_drop_plan_value_words(child)
      if component == 0 or offset < 0 or child_words <= 0 or offset > words - child_words or
        pipeline_structural_drop_plan_is_valid(child) == 0 { valid = 0 }
      else { i = i + 1 }
    }
    valid
  }
}

pub(package) fn pipeline_structural_drop_alternatives_are_valid(alternatives: i64) -> i64 {
  if alternatives == 0 or nlist_len(alternatives) == 0 { 0 }
  else {
    let mut valid = 1
    let mut i = 0
    while i < nlist_len(alternatives) and valid == 1 {
      let alternative = nlist_get(alternatives, i)
      let words = typeck_linear_layout_variant_words(alternative)
      let payloads = typeck_linear_layout_variant_payloads(alternative)
      if alternative == 0 or node_tag(alternative) != 4 or words < 1 or
        (payloads != 0 and nlist_len(payloads) > 0 and pipeline_structural_drop_components_are_valid(payloads, words) == 0) { valid = 0 }
      else { i = i + 1 }
    }
    valid
  }
}

pub(package) fn pipeline_structural_drop_plan_is_valid(plan: i64) -> i64 {
  if plan == 0 or typeck_linear_layout_plan_identity(plan) == 0 { 0 }
  else {
    let kind = typeck_linear_layout_plan_kind(plan)
    let words = typeck_linear_layout_plan_words(plan)
    let children = typeck_linear_layout_plan_children(plan)
    if kind == 1 { if words > 0 and cg_owned_drop_type_hash(typeck_linear_layout_plan_type(plan)) != 0 { 1 } else { 0 } }
    else { if kind == 2 or kind == 3 or kind == 4 {
      if words > 0 { pipeline_structural_drop_components_are_valid(children, words) } else { 0 }
    } else { if kind == 5 {
      pipeline_structural_drop_alternatives_are_valid(children)
    } else { if kind == 6 {
      if words > 0 and children != 0 and pipeline_structural_drop_plan_is_valid(children) == 1 and
        pipeline_structural_drop_plan_value_words(children) == words { 1 } else { 0 }
    } else { if kind == 7 { if words == 1 and children == 0 { 1 } else { 0 } }
    else { 0 } } } } }
  }
}

-- Invoke a concrete owned resource's Drop implementation with the resource in
-- x0. This is the same method-resolution contract as IrOwnedDropI64, without
-- manufacturing an SSA home inside generated cleanup glue.
pub(package) fn pipeline_ir_native_emit_structural_owned_leaf_x0(code: i64, plan: i64, fm: i64) -> i64 {
  let owned_ty = typeck_linear_layout_plan_type(plan)
  let type_hash = cg_owned_drop_type_hash(owned_ty)
  let method_hash = cg_drop_method_hash()
  let mm = fmap_mmap(fm)
  let inner_ty = if ty_is_owned(owned_ty) { ty_owned_inner(owned_ty) } else { 0 }
  let type_args = if inner_ty != 0 and ty_tag(inner_ty) == 9 { ty_f3(inner_ty) } else { 0 }
  let method_pair = pipeline_fns_lookup_method_pair(fmap_native_fns(fm), type_hash, method_hash)
  let generic_key = if type_args != 0 and nlist_len(type_args) > 0 and method_pair != 0 and fn_tparams(node_f1(method_pair)) != 0 {
    mono_spec_hash(pipeline_ir_method_patch_key(type_hash, method_hash), type_args)
  } else { 0 }
  let mut target = if generic_key != 0 {
    mono_cache_lookup(fmap_mono_cache(fm), generic_key)
  } else {
    mmap_lookup(mm, type_hash, method_hash)
  }
  if target <= 1 {
    let patch_key = pipeline_ir_native_method_forward_key(mm, type_hash, method_hash, 0)
    let forward_key = if generic_key != 0 { generic_key } else { patch_key }
    if forward_key != 0 and mono_cache_lookup(fmap_mono_cache(fm), forward_key) != 0 {
      let cur = buf_len(code)
      fmap_add_patch(fm, cur, 0, forward_key, 0)
      bu32(code, encode_bl(0))
      fmap_inc_typed_method_call_emit_count(fm)
    } else {
      fmap_inc_emit_error_count(fm)
      bu32(code, encode_brk(66))
    }
  } else {
    let cur = buf_len(code)
    bu32(code, encode_bl(target - cur))
    fmap_inc_typed_method_call_emit_count(fm)
  }
}

pub(package) fn pipeline_ir_native_emit_structural_memory_plan(code: i64, plan: i64, word_offset: i64, fm: i64) -> i64 {
  let kind = typeck_linear_layout_plan_kind(plan)
  if kind == 1 {
    emit_load_spill_offset(code, 15, 0)
    pipeline_ir_native_emit_addr_plus_imm(code, 16, 15, word_offset * 8)
    bu32(code, cg_ldr(0, 16, 0))
    pipeline_ir_native_emit_structural_owned_leaf_x0(code, plan, fm)
  } else { if kind == 2 or kind == 3 or kind == 4 {
    pipeline_ir_native_emit_structural_memory_components(code, typeck_linear_layout_plan_children(plan), word_offset, fm)
  } else { if kind == 5 {
    let alternatives = typeck_linear_layout_plan_children(plan)
    for i in 0..nlist_len(alternatives) {
      let alternative = nlist_get(alternatives, i)
      emit_load_spill_offset(code, 15, 0)
      pipeline_ir_native_emit_addr_plus_imm(code, 16, 15, word_offset * 8)
      bu32(code, cg_ldr(16, 16, 0))
      emit_mov_imm_safe(code, 17, typeck_linear_layout_variant_hash(alternative))
      bu32(code, encode_cmp(16, 17))
      let skip = buf_len(code)
      bu32(code, 0)
      let payloads = typeck_linear_layout_variant_payloads(alternative)
      if payloads != 0 { pipeline_ir_native_emit_structural_memory_components(code, payloads, word_offset, fm) } else { 0 }
      cg_patch_b_cond(code, skip, 1, buf_len(code))
    }
    0
  } else { if kind == 6 {
    pipeline_ir_native_emit_structural_memory_plan(code, typeck_linear_layout_plan_children(plan), word_offset, fm)
  } else { if kind == 7 { 0 }
  else { 0 } } } } }
}

pub(package) fn pipeline_ir_native_emit_structural_memory_components(code: i64, components: i64, base_word_offset: i64, fm: i64) -> i64 {
  let mut i = nlist_len(components)
  while i > 0 {
    let component = nlist_get(components, i - 1)
    let child = typeck_linear_layout_component_plan(component)
    let child_offset = base_word_offset + typeck_linear_layout_component_offset(component)
    let child_mode = pipeline_structural_drop_plan_storage_mode(child)
    if child_mode == 3 {
      let target = pipeline_ir_native_ensure_structural_drop_glue(code, child, fm)
      emit_load_spill_offset(code, 15, 0)
      pipeline_ir_native_emit_addr_plus_imm(code, 16, 15, child_offset * 8)
      bu32(code, cg_ldr(0, 16, 0))
      let call = buf_len(code)
      bu32(code, encode_bl(target - call))
    } else {
      pipeline_ir_native_emit_structural_memory_plan(code, child, child_offset, fm)
    }
    i = i - 1
  }
  0
}

pub(package) fn pipeline_ir_native_emit_structural_scalar_plan_x0(code: i64, plan: i64, fm: i64) -> i64 {
  let kind = typeck_linear_layout_plan_kind(plan)
  if kind == 1 { pipeline_ir_native_emit_structural_owned_leaf_x0(code, plan, fm) }
  else { if kind == 6 { pipeline_ir_native_emit_structural_scalar_plan_x0(code, typeck_linear_layout_plan_children(plan), fm) }
  else {
    fmap_inc_emit_error_count(fm)
    bu32(code, encode_brk(66))
  } }
}

pub(package) fn pipeline_ir_native_ensure_structural_drop_glue(code: i64, plan: i64, fm: i64) -> i64 {
  let key = pipeline_structural_drop_glue_hash(plan)
  let cached = mono_cache_lookup(fmap_mono_cache(fm), key)
  if cached > 1 { cached }
  else {
    let skip = buf_len(code)
    bu32(code, 0)
    let entry = buf_len(code)
    mono_cache_add(fmap_mono_cache(fm), key, entry)
    -- [sp+0]=managed aggregate pointer, [sp+8]=LR.
    bu32(code, encode_sub_imm(31, 31, 16))
    emit_store_spill_offset(code, 0, 0)
    emit_store_spill_offset(code, 30, 8)
    let storage_mode = pipeline_structural_drop_plan_storage_mode(plan)
    if storage_mode == 1 {
      pipeline_ir_native_emit_structural_scalar_plan_x0(code, plan, fm)
    } else {
      pipeline_ir_native_emit_structural_memory_plan(code, plan, 0, fm)
    }
    if storage_mode == 3 {
      emit_load_spill_offset(code, 0, 0)
      cg_emit_call_lit(code, fm, "rc_default_release")
    } else { 0 }
    emit_load_spill_offset(code, 30, 8)
    bu32(code, encode_add_imm(31, 31, 16))
    bu32(code, encode_ret())
    cg_patch_b(code, skip, buf_len(code))
    entry
  }
}

pub(package) fn pipeline_ir_native_emit_structural_value_plan(code: i64, value: i64, plan: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let kind = typeck_linear_layout_plan_kind(plan)
  if kind == 1 {
    let phys = pipeline_ir_native_load_reg(code, pinned, value)
    if phys == 0 { 0 } else { bu32(code, encode_add_imm(0, phys, 0)) }
    pipeline_ir_native_emit_structural_owned_leaf_x0(code, plan, fm)
  } else { if kind == 2 or kind == 3 {
    let components = typeck_linear_layout_plan_children(plan)
    let mut i = nlist_len(components)
    while i > 0 {
      let component = nlist_get(components, i - 1)
      pipeline_ir_native_emit_structural_value_plan(code, value + typeck_linear_layout_component_offset(component), typeck_linear_layout_component_plan(component), fm, pinned)
      i = i - 1
    }
    0
  } else { if kind == 4 or kind == 5 or kind == 7 {
    let target = pipeline_ir_native_ensure_structural_drop_glue(code, plan, fm)
    let phys = pipeline_ir_native_load_reg(code, pinned, value)
    if phys == 0 { 0 } else { bu32(code, encode_add_imm(0, phys, 0)) }
    let call = buf_len(code)
    bu32(code, encode_bl(target - call))
  } else { if kind == 6 {
    pipeline_ir_native_emit_structural_value_plan(code, value, typeck_linear_layout_plan_children(plan), fm, pinned)
  } else { 0 } } } }
}

pub(package) fn pipeline_ir_abort_cleanup_emit_slot_alias_guard(code: i64, value: i64, fm: i64) -> i64 {
  let alias = pipeline_ir_abort_cleanup_find_slot_alias_value(fmap_current_abort_cleanup_facts(fm), value)
  if alias == 0 { 0 - 1 }
  else {
    pipeline_ir_abort_cleanup_emit_sp_address(
      code, 15, pipeline_ir_abort_cleanup_record_offset(fmap_current_abort_cleanup_base(fm), alias)
    )
    bu32(code, cg_ldr(15, 15, handler_abort_cleanup_record_action_offset()))
    let uninitialized = buf_len(code)
    bu32(code, 0)
    uninitialized
  }
}

pub(package) fn pipeline_ir_native_emit_structural_drop_active(code: i64, value: i64, plan: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  -- Splice the aggregate obligation before user Drop code can perform an
  -- abort. The shared thunk then consumes every owned child and backing.
  pipeline_ir_abort_cleanup_emit_disarm_structural(code, value, plan, fm, pinned)
  pipeline_ir_native_emit_structural_value_plan(code, value, plan, fm, pinned)
}

pub(package) fn pipeline_ir_native_emit_structural_drop(code: i64, value: i64, plan: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  if pipeline_structural_drop_plan_is_valid(plan) == 0 {
    fmap_inc_emit_error_count(fm)
    bu32(code, encode_brk(66))
  } else {
    -- Exit cleanup is conservative across pattern control flow. When its
    -- value came from a mutable linear slot, the canonical record says
    -- whether a preceding split already moved that owner.
    let uninitialized = pipeline_ir_abort_cleanup_emit_slot_alias_guard(code, value, fm)
    pipeline_ir_native_emit_structural_drop_active(code, value, plan, fm, pinned)
    if uninitialized >= 0 { cg_patch_cbz(code, uninitialized, 15, buf_len(code)) } else { 0 }
  }
}

-- Drop the current mutable-slot owner only while its canonical ownership fact
-- is initialized. A move through a slot alias clears the same exact record;
-- subsequent reassignment therefore replaces an empty slot instead of
-- invoking Drop twice on the transferred resource.
pub(package) fn pipeline_ir_native_emit_structural_slot_drop(code: i64, value: i64, slot: i64, plan: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let plan_kind = typeck_linear_layout_plan_kind(plan)
  let owning_kind = pipeline_ir_abort_cleanup_plan_owning_kind(plan)
  let fact = pipeline_ir_abort_cleanup_find_acquisition_site_kind(
    fmap_current_abort_cleanup_facts(fm), pipeline_ir_abort_cleanup_structural_slot_site(slot), owning_kind
  )
  if fact == 0 or pipeline_structural_drop_plan_is_valid(plan) == 0 {
    fmap_inc_emit_error_count(fm)
    bu32(code, encode_brk(67))
  } else {
    pipeline_ir_abort_cleanup_emit_sp_address(
      code, 15, pipeline_ir_abort_cleanup_record_offset(fmap_current_abort_cleanup_base(fm), fact)
    )
    bu32(code, cg_ldr(15, 15, handler_abort_cleanup_record_action_offset()))
    let uninitialized = buf_len(code)
    bu32(code, 0)
    if plan_kind == 1 {
      if pipeline_linear_cleanup_plan_uses_structural_glue(plan) == 1 {
        pipeline_ir_abort_cleanup_emit_disarm_structural(code, value, plan, fm, pinned)
      } else {
        let type_hash = cg_owned_drop_type_hash(typeck_linear_layout_plan_type(plan))
        pipeline_ir_abort_cleanup_emit_disarm_owned(code, value, type_hash, fm, pinned)
      }
      let phys = pipeline_ir_native_load_reg(code, pinned, value)
      if phys == 0 { 0 } else { bu32(code, encode_add_imm(0, phys, 0)) }
      pipeline_ir_native_emit_structural_owned_leaf_x0(code, plan, fm)
    } else {
      pipeline_ir_native_emit_structural_drop_active(code, value, plan, fm, pinned)
    }
    cg_patch_cbz(code, uninitialized, 15, buf_len(code))
  }
}

pub(package) fn pipeline_ir_native_emit_structural_split(code: i64, value: i64, parent_plan: i64, residual_plan: i64, release_backing: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  if pipeline_structural_drop_plan_is_valid(parent_plan) == 0 or
    (residual_plan != 0 and pipeline_structural_drop_plan_is_valid(residual_plan) == 0) {
    fmap_inc_emit_error_count(fm)
    bu32(code, encode_brk(68))
  } else {
    -- Pattern loads are aliases until this instruction. Moved child binds have
    -- already armed their replacement records; now detach the exact parent
    -- record before wildcard Drop or backing release can enter user code.
    pipeline_ir_abort_cleanup_emit_disarm_structural(code, value, parent_plan, fm, pinned)
    pipeline_ir_abort_cleanup_emit_linear_transfer_facts(code, value, parent_plan, fm)
    if residual_plan != 0 {
      pipeline_ir_native_emit_structural_value_plan(code, value, residual_plan, fm, pinned)
    } else { if release_backing == 1 {
      let phys = pipeline_ir_native_load_reg(code, pinned, value)
      if phys == 0 { 0 } else { bu32(code, encode_add_imm(0, phys, 0)) }
      cg_emit_call_lit(code, fm, "rc_default_release")
    } else { 0 } }
  }
}

pub(package) fn pipeline_ir_native_emit_string_lit(code: i64, dst: i64, start: i64, len: i64, src: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  -- A literal is immutable program data, not a runtime allocation. Its bytes
  -- stay inline in the native image and its stable (pointer, length)
  -- descriptor occupies a dedicated zero-fill static-value slot. Every
  -- evaluation writes the same two words before returning the slot; the
  -- idempotent stores make concurrent evaluation observationally identical.
  let skip = buf_len(code)
  bu32(code, 0)
  let data = buf_len(code)
  for i in 0..len { bu8(code, mem_load8(src + start + i)) }
  while (buf_len(code) band 3) != 0 { bu8(code, 0) }
  let data_end = buf_len(code)
  let audit_exclusions = fmap_audit_nested(fm)
  if audit_exclusions != 0 and data_end > data {
    -- Static bytes share the text image but are skipped by the branch above;
    -- they are neither instructions nor a nested call boundary. Preserve the
    -- exact interval so the residency auditor never decodes data as AArch64.
    nlist_add(audit_exclusions, node_new(1, data, data_end, 0, 0))
    0
  } else { 0 }
  cg_patch_b(code, skip, buf_len(code))

  pipeline_ir_native_emit_image_address(code, 15, data)
  let slot_off = fmap_static_literal_slot_reserve(fm)
  let adrp_pos = buf_len(code)
  fmap_add_static_value_patch(fm, adrp_pos, slot_off)
  bu32(code, encode_adrp(17, 0))
  bu32(code, encode_add_imm(17, 17, slot_off - slot_off / 4096 * 4096))
  bu32(code, cg_str(15, 17, 0))
  emit_mov_imm_safe(code, 16, len)
  bu32(code, cg_str(16, 17, 8))
  pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17)
}

pub(package) fn pipeline_ir_native_emit_string_concat(code: i64, dst: i64, left: i64, right: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let lp = pipeline_ir_native_load_reg(code, pinned, left)
  bu32(code, encode_add_imm(0, lp, 0))
  let rp = pipeline_ir_native_load_reg(code, pinned, right)
  bu32(code, encode_add_imm(1, rp, 0))
  let target = fmap_lookup_by_hash(fm, interp_str_concat_hash())
  let cur = buf_len(code)
  if target > 0 {
    bu32(code, encode_bl(target - cur))
  } else {
    fmap_add_patch_by_hash(fm, cur, interp_str_concat_hash())
    bu32(code, encode_bl(0))
  }
  pipeline_ir_native_store_reg_pinned(code, pinned, dst, 0)
}

pub(package) fn pipeline_ir_native_emit_variant_payloads(code: i64, base_reg: i64, args: IrValueList, index: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  match args {
    IrValueNil -> {
      if index == 0 {
        emit_mov_imm_safe(code, 16, 0)
        bu32(code, cg_str(16, base_reg, 8))
      } else { 0 }
    }
    IrValueCons(value, rest) -> {
      let val_phys = pipeline_ir_native_load_reg(code, pinned, value)
      bu32(code, cg_str(val_phys, base_reg, 8 + index * 8))
      pipeline_ir_native_emit_variant_payloads(code, base_reg, rest, index + 1, pinned)
    }
  }
}

-- Ordinary variant nodes are default-managed (managed aggregate ownership): construction
-- allocates a headered rc payload so release at end-of-lifetime actually
-- reclaims. Payload value loads happen after the BL — value homes are
-- call-surviving and forwarding entries invalidate on buffer growth.
-- Deep-release field mask for a variant ctor: 2 bits per payload word
-- (word 0 is the tag). Constructor lowering already resolved the exact
-- declaration and passes that declaration's payload types here. Re-scanning
-- by an unqualified tag hash can select another imported table entry whose
-- opaque metadata still has an unresolved one-word shape, shifting every
-- later managed payload bit.
pub(package) fn pipeline_field_mask_add_type_lanes(mask: i64, ty: i64, word: i64) -> i64 {
  let lanes = pipeline_type_value_lane_count_or_one(ty)
  let mut result = mask
  let mut lane = 0
  while lane < lanes and word + lane < 16 {
    result = result bor (cg_field_mask_kind_for_ty_lane(ty, lane) bshl ((word + lane) * 2))
    lane = lane + 1
  }
  result
}

pub(package) fn pipeline_variant_field_mask_for_payload_types(payload_types: i64, subst: i64) -> i64 {
  let np = if payload_types == 0 { 0 } else { nlist_len(payload_types) }
  let mut mask = 0
  let mut i = 0
  let mut word = 1
  while i < np {
    let ty = pipeline_expected_arg_type_node(0, payload_types, i, 0, subst)
    if word < 16 {
      mask = pipeline_field_mask_add_type_lanes(mask, ty, word)
    } else { 0 }
    word = word + pipeline_type_value_lane_count_or_one(ty)
    i = i + 1
  }
  mask
}

-- Legacy/test-facing tag lookup. Production constructor lowering uses the
-- declaration-resolved payload-list producer above.
pub(package) fn pipeline_variant_field_mask(tt: i64, tag_hash: i64, subst: i64) -> i64 {
  if tt == 0 { 0 }
  else {
    let n = mem_load64_at(tt, 8)
    let d = mem_load64_at(tt, 0)
    let mut ti = 0
    let mut mask = 0
    let mut found = 0
    while ti < n and found == 0 {
      let entry = d + ti * 64
      if mem_load64_at(entry, 16) == 1 {
        let nvariants = mem_load64_at(entry, 24)
        let variants = mem_load64_at(entry, 32)
        let mut vi = 0
        while vi < nvariants and found == 0 {
          if mem_load64_at(variants + vi * 40 + 16, 0) == tag_hash {
            found = 1
            mask = pipeline_variant_field_mask_for_payload_types(mem_load64_at(variants + vi * 40 + 32, 0), subst)
          } else { vi = vi + 1 }
        }
      } else { 0 }
      ti = ti + 1
    }
    mask
  }
}

-- Record twin: word i = ttable field i.
pub(package) fn pipeline_record_field_mask(tt: i64, type_hash: i64) -> i64 {
  if tt == 0 { 0 }
  else {
    let entry = ttable_lookup_by_type_hash(tt, type_hash)
    if entry == 0 { 0 }
    else {
      let nfields = mem_load64_at(entry, 24)
      let fields = mem_load64_at(entry, 32)
      let mut mask = 0
      let mut i = 0
      let mut word = 0
      while i < nfields {
        let ty = mem_load64_at(fields + i * 24 + 16, 0)
        if word < 16 {
          mask = pipeline_field_mask_add_type_lanes(mask, ty, word)
        } else { 0 }
        word = word + pipeline_type_value_lane_count_or_one(ty)
        i = i + 1
      }
      mask
    }
  }
}

pub(package) fn pipeline_ir_native_finish_variant_init(code: i64, dst: i64, tag_hash: i64, args: IrValueList, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let nargs = ir_value_list_len(args)
  bu32(code, encode_add_imm(14, 0, 0))
  emit_mov_imm_safe(code, 16, tag_hash)
  bu32(code, cg_str(16, 14, 0))
  -- min_size rounds a payload-less ctor up to 16 bytes; that second word
  -- is inside the payload but no payload store reaches it, so with the
  -- zero fill gone it must be initialised explicitly.
  if nargs == 0 {
    emit_mov_imm(code, 16, 0)
    bu32(code, cg_str(16, 14, 8))
  } else { 0 }
  pipeline_ir_native_emit_variant_payloads(code, 14, args, 0, pinned)
  pipeline_ir_native_store_reg_pinned(code, pinned, dst, 14)
}

pub(package) fn pipeline_ir_native_emit_variant_init(code: i64, dst: i64, tag_hash: i64, args: IrValueList, field_mask: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let alloc_size = 8 + ir_value_list_len(args) * 8
  let min_size = if alloc_size < 16 { 16 } else { alloc_size }
  cg_emit_rc_default_alloc_masked_lit(code, fm, continuation_cleanup_kind_rc(), min_size, 8, field_mask)
  pipeline_ir_native_finish_variant_init(code, dst, tag_hash, args, pinned)
}

pub(package) fn pipeline_ir_native_emit_variant_reuse_init(code: i64, token: i64, dst: i64, tag_hash: i64, args: IrValueList, field_mask: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let alloc_size = 8 + ir_value_list_len(args) * 8
  let min_size = if alloc_size < 16 { 16 } else { alloc_size }
  let token_phys = pipeline_ir_native_load_reg(code, pinned, token)
  cg_emit_rc_default_alloc_masked_reuse_lit(code, fm, token_phys, continuation_cleanup_kind_rc(), min_size, 8, field_mask)
  pipeline_ir_native_finish_variant_init(code, dst, tag_hash, args, pinned)
}

pub(package) fn pipeline_ir_native_emit_variant_tag(code: i64, dst: i64, value: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let phys = pipeline_ir_native_load_reg(code, pinned, value)
  if phys == 14 { 0 } else { bu32(code, encode_add_imm(14, phys, 0)) }
  let rd = pipeline_ir_native_result_reg(dst, pinned)
  -- Nullary constructors are the negated tag hash. A negative word is not a
  -- native payload pointer, and reversing the sign restores the same semantic
  -- tag consumed by pattern matching. Retain the pre-existing small-positive
  -- scalar path used by local one-payload variant replacement.
  bu32(code, encode_cmp(14, 31))
  let scalar_pos = buf_len(code)
  bu32(code, encode_b_cond(0, 11))
  emit_mov_imm_safe(code, 16, 4294967296)
  bu32(code, encode_cmp(14, 16))
  let load_pos = buf_len(code)
  bu32(code, encode_b_cond(0, 10))
  bu32(code, encode_add_imm(rd, 14, 0))
  let done_pos = buf_len(code)
  bu32(code, encode_b(0))
  let load_start = buf_len(code)
  bu32(code, cg_ldr(rd, 14, 0))
  let load_done_pos = buf_len(code)
  bu32(code, encode_b(0))
  let scalar_start = buf_len(code)
  bu32(code, encode_sub_reg(rd, 31, 14))
  let done = buf_len(code)
  bytes_set_u32(code, scalar_pos, encode_b_cond(scalar_start - scalar_pos, 11))
  bytes_set_u32(code, load_pos, encode_b_cond(load_start - load_pos, 10))
  bytes_set_u32(code, done_pos, encode_b(done - done_pos))
  bytes_set_u32(code, load_done_pos, encode_b(done - load_done_pos))
  if rd == 17 { pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17) } else { pipeline_ir_native_ck_def(code, pinned, rd, dst) }
}

pub(package) fn pipeline_ir_native_emit_variant_payload(code: i64, dst: i64, value: i64, index: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let phys = pipeline_ir_native_load_reg(code, pinned, value)
  let rd = pipeline_ir_native_result_reg(dst, pinned)
  bu32(code, cg_ldr(rd, phys, 8 + index * 8))
  if rd == 17 { pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17) } else { pipeline_ir_native_ck_def(code, pinned, rd, dst) }
}

pub(package) fn pipeline_ir_native_record_field_index_hash(fields: TypeRecordFieldList, entry_src: i64, field_hash: i64, index: i64) -> i64 {
  match fields {
    TypeRecordFieldListNil -> 0 - 1
    TypeRecordFieldListCons(field, rest) -> {
      match field {
        TypeRecordField(ns, nl, ty) -> {
          if str_hash(entry_src, ns, nl) == field_hash {
            index
          } else {
            pipeline_ir_native_record_field_index_hash(rest, entry_src, field_hash, index + 1)
          }
        }
        MissingTypeRecordField -> pipeline_ir_native_record_field_index_hash(rest, entry_src, field_hash, index + 1)
      }
    }
  }
}

pub(package) fn pipeline_ir_native_record_field_index_by_hash_entries(entries: TypeEntryList, type_hash: i64, field_hash: i64) -> i64 {
  match entries {
    TypeEntryListNil -> 0 - 1
    TypeEntryListCons(entry, rest) -> {
      match entry {
        TypeRecordEntry(name, tparams, fields) -> {
          let entry_src = type_entry_source_or(entry, 0)
          let entry_hash = str_hash(entry_src, type_entry_name_start_or(entry, 0), type_entry_name_len_or(entry, 0))
          if entry_hash == type_hash or type_name_hash(entry_src, type_entry_name_start_or(entry, 0), type_entry_name_len_or(entry, 0)) == type_hash {
            let idx = pipeline_ir_native_record_field_index_hash(fields, entry_src, field_hash, 0)
            if idx >= 0 { idx } else { pipeline_ir_native_record_field_index_by_hash_entries(rest, type_hash, field_hash) }
          } else {
            pipeline_ir_native_record_field_index_by_hash_entries(rest, type_hash, field_hash)
          }
        }
        _ -> pipeline_ir_native_record_field_index_by_hash_entries(rest, type_hash, field_hash)
      }
    }
  }
}

pub(package) fn pipeline_ir_native_record_field_index_by_hash(tt: i64, type_hash: i64, field_hash: i64) -> i64 {
  pipeline_ir_native_record_field_index_by_hash_entries(type_entries_from_table(tt), type_hash, field_hash)
}

pub(package) fn pipeline_record_layout_descriptor_magic() -> i64 { 6289345512910263 }

pub(package) fn pipeline_record_layout_managed_kind_is_valid(kind: i64) -> i64 {
  if kind == continuation_cleanup_kind_none() { 1 }
  else { if pipeline_managed_release_hash_for_kind(kind) != 0 { 1 } else { 0 } }
}

pub(package) fn pipeline_record_layout_fields_are_valid_inner(fields: IrRecordLayoutFieldList, data_size: i64, minimum_offset: i64) -> i64 {
  match fields {
    IrRecordLayoutFieldNil -> 1
    IrRecordLayoutFieldWord(field_hash, byte_offset, value, managed_kind, rest) -> {
      if byte_offset < minimum_offset or byte_offset > data_size - 8 or pipeline_record_layout_managed_kind_is_valid(managed_kind) == 0 { 0 }
      else { pipeline_record_layout_fields_are_valid_inner(rest, data_size, byte_offset + 8) }
    }
    IrRecordLayoutFieldArray(field_hash, byte_offset, data, byte_size, leaf_count, leaf_stride, leaf_kind, rest) -> {
      if byte_offset < minimum_offset or byte_size < 0 or byte_offset > data_size - byte_size or pipeline_array_copy_plan_is_valid(byte_size, leaf_count, leaf_stride, leaf_kind) == 0 { 0 }
      else { pipeline_record_layout_fields_are_valid_inner(rest, data_size, byte_offset + byte_size) }
    }
  }
}

pub(package) fn pipeline_record_layout_fields_are_valid(data_size: i64, align: i64, fields: IrRecordLayoutFieldList) -> i64 {
  -- Runtime word 0 adds the descriptor pointer and bit 31 of the low size
  -- word is the descriptor flag, so visible data must leave both representable.
  if data_size < 0 or data_size > 2147483639 or align <= 0 or align > 8 or (align band (align - 1)) != 0 { 0 }
  else { if pipeline_record_layout_descriptor_entry_count(fields) > 4096 { 0 }
  else { pipeline_record_layout_fields_are_valid_inner(fields, data_size, 0) } }
}

pub(package) fn pipeline_record_layout_descriptor_entry_count(fields: IrRecordLayoutFieldList) -> i64 {
  match fields {
    IrRecordLayoutFieldNil -> 0
    IrRecordLayoutFieldWord(field_hash, byte_offset, value, managed_kind, rest) -> {
      let self = if managed_kind == continuation_cleanup_kind_none() { 0 } else { 1 }
      self + pipeline_record_layout_descriptor_entry_count(rest)
    }
    IrRecordLayoutFieldArray(field_hash, byte_offset, data, byte_size, leaf_count, leaf_stride, leaf_kind, rest) -> {
      let self = if pipeline_array_drop_plan_is_active(leaf_count, leaf_stride, leaf_kind) == 1 { 1 } else { 0 }
      self + pipeline_record_layout_descriptor_entry_count(rest)
    }
  }
}

pub(package) fn pipeline_record_layout_descriptor_hash_mix(seed: i64, value: i64) -> i64 {
  (seed * 33 + value) band 9223372036854775807
}

pub(package) fn pipeline_record_layout_descriptor_hash_fields(fields: IrRecordLayoutFieldList, seed: i64) -> i64 {
  match fields {
    IrRecordLayoutFieldNil -> seed
    IrRecordLayoutFieldWord(field_hash, byte_offset, value, managed_kind, rest) -> {
      if managed_kind == continuation_cleanup_kind_none() {
        pipeline_record_layout_descriptor_hash_fields(rest, seed)
      } else {
        let h1 = pipeline_record_layout_descriptor_hash_mix(seed, 1)
        let h2 = pipeline_record_layout_descriptor_hash_mix(h1, byte_offset)
        let h3 = pipeline_record_layout_descriptor_hash_mix(h2, 1)
        let h4 = pipeline_record_layout_descriptor_hash_mix(h3, 8)
        pipeline_record_layout_descriptor_hash_fields(rest, pipeline_record_layout_descriptor_hash_mix(h4, managed_kind))
      }
    }
    IrRecordLayoutFieldArray(field_hash, byte_offset, data, byte_size, leaf_count, leaf_stride, leaf_kind, rest) -> {
      if pipeline_array_drop_plan_is_active(leaf_count, leaf_stride, leaf_kind) == 0 {
        pipeline_record_layout_descriptor_hash_fields(rest, seed)
      } else {
        let h1 = pipeline_record_layout_descriptor_hash_mix(seed, 2)
        let h2 = pipeline_record_layout_descriptor_hash_mix(h1, byte_offset)
        let h3 = pipeline_record_layout_descriptor_hash_mix(h2, leaf_count)
        let h4 = pipeline_record_layout_descriptor_hash_mix(h3, leaf_stride)
        pipeline_record_layout_descriptor_hash_fields(rest, pipeline_record_layout_descriptor_hash_mix(h4, leaf_kind))
      }
    }
  }
}

pub(package) fn pipeline_record_layout_descriptor_hash(data_size: i64, fields: IrRecordLayoutFieldList) -> i64 {
  let raw = pipeline_record_layout_descriptor_hash_fields(fields, pipeline_record_layout_descriptor_hash_mix(4705214434749621, data_size))
  if raw == 0 { 4705214434749621 } else { raw }
}

pub(package) fn pipeline_ir_native_emit_record_layout_descriptor_fields(code: i64, fields: IrRecordLayoutFieldList) -> i64 {
  match fields {
    IrRecordLayoutFieldNil -> 0
    IrRecordLayoutFieldWord(field_hash, byte_offset, value, managed_kind, rest) -> {
      if managed_kind != continuation_cleanup_kind_none() {
        bu64(code, byte_offset)
        bu64(code, 1)
        bu64(code, 8)
        bu64(code, managed_kind)
      } else { 0 }
      pipeline_ir_native_emit_record_layout_descriptor_fields(code, rest)
    }
    IrRecordLayoutFieldArray(field_hash, byte_offset, data, byte_size, leaf_count, leaf_stride, leaf_kind, rest) -> {
      if pipeline_array_drop_plan_is_active(leaf_count, leaf_stride, leaf_kind) == 1 {
        bu64(code, byte_offset)
        bu64(code, leaf_count)
        bu64(code, leaf_stride)
        bu64(code, leaf_kind)
      } else { 0 }
      pipeline_ir_native_emit_record_layout_descriptor_fields(code, rest)
    }
  }
}

pub(package) fn pipeline_ir_native_ensure_record_layout_descriptor(code: i64, data_size: i64, fields: IrRecordLayoutFieldList, fm: i64) -> i64 {
  let key = pipeline_record_layout_descriptor_hash(data_size, fields)
  let cached = mono_cache_lookup(fmap_mono_cache(fm), key)
  if cached > 1 { cached }
  else {
    let skip = buf_len(code)
    bu32(code, 0)
    if (buf_len(code) band 7) != 0 { bu32(code, 0) } else { 0 }
    let descriptor = buf_len(code)
    mono_cache_add(fmap_mono_cache(fm), key, descriptor)
    bu64(code, pipeline_record_layout_descriptor_magic())
    bu64(code, data_size)
    bu64(code, pipeline_record_layout_descriptor_entry_count(fields))
    pipeline_ir_native_emit_record_layout_descriptor_fields(code, fields)
    cg_patch_b(code, skip, buf_len(code))
    descriptor
  }
}

pub(package) fn pipeline_ir_native_emit_array_storage_describe(code: i64, storage: i64, data_size: i64, fields: IrRecordLayoutFieldList, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  if pipeline_record_layout_fields_are_valid(data_size, 8, fields) == 0 {
    fmap_inc_emit_error_count(fm)
    bu32(code, encode_brk(68))
  } else {
    let descriptor = pipeline_ir_native_ensure_record_layout_descriptor(code, data_size, fields, fm)
    let storage_phys = pipeline_ir_native_load_reg(code, pinned, storage)
    if storage_phys == 14 { 0 } else { bu32(code, encode_add_imm(14, storage_phys, 0)) }
    pipeline_ir_native_emit_image_address(code, 17, descriptor)
    bu32(code, cg_str(17, 14, 40))
  }
}

-- Static ParWork descriptor ABI. The header is five words followed by one
-- two-word entry per ABI lane:
--   magic, version, lane count, storage bytes, storage alignment,
--   then (lane class, cleanup kind)*.
-- Cleanup kind is the single ownership plan consumed by the trusted retain,
-- release, promotion, and move primitives. Moving copies every lane and
-- disarms the source; managed duplication uses this kind to retain first.
pub(package) fn pipeline_par_work_descriptor_magic() -> i64 { 6289459449259127 }
pub(package) fn pipeline_par_work_descriptor_version() -> i64 { 1 }
pub(package) fn pipeline_par_work_descriptor_header_size() -> i64 { 40 }
pub(package) fn pipeline_par_work_descriptor_entry_size() -> i64 { 16 }

pub(package) fn pipeline_par_work_descriptor_hash(descriptor: PipelineParWorkDescriptor) -> i64 {
  if pipeline_par_work_descriptor_is_valid(descriptor) == 0 { 0 }
  else {
    let lanes = pipeline_par_work_descriptor_lane_count(descriptor)
    let mut hash = pipeline_record_layout_descriptor_hash_mix(4705427653822157, lanes)
    hash = pipeline_record_layout_descriptor_hash_mix(hash, pipeline_par_work_descriptor_storage_size(descriptor))
    hash = pipeline_record_layout_descriptor_hash_mix(hash, pipeline_par_work_descriptor_storage_align(descriptor))
    for lane in 0..lanes {
      hash = pipeline_record_layout_descriptor_hash_mix(hash, pipeline_par_work_descriptor_lane_class(descriptor, lane))
      hash = pipeline_record_layout_descriptor_hash_mix(hash, pipeline_par_work_descriptor_lane_cleanup_kind(descriptor, lane))
    }
    if hash <= 1 { 4705427653822157 } else { hash }
  }
}

pub(package) fn pipeline_ir_native_emit_par_work_descriptor_entries(code: i64, descriptor: PipelineParWorkDescriptor) -> i64 {
  let lanes = pipeline_par_work_descriptor_lane_count(descriptor)
  if lanes > 0 {
    for lane in 0..lanes {
      bu64(code, pipeline_par_work_descriptor_lane_class(descriptor, lane))
      bu64(code, pipeline_par_work_descriptor_lane_cleanup_kind(descriptor, lane))
    }
    0
  } else { 0 }
}

pub(package) fn pipeline_ir_native_ensure_par_work_descriptor(code: i64, descriptor: PipelineParWorkDescriptor, fm: i64) -> i64 {
  if pipeline_par_work_descriptor_is_valid(descriptor) == 0 { 0 }
  else {
    let key = pipeline_par_work_descriptor_hash(descriptor)
    let cached = mono_cache_lookup(fmap_mono_cache(fm), key)
    if cached > 1 { cached }
    else {
      let skip = buf_len(code)
      bu32(code, 0)
      if (buf_len(code) band 7) != 0 { bu32(code, 0) } else { 0 }
      let emitted = buf_len(code)
      mono_cache_add(fmap_mono_cache(fm), key, emitted)
      bu64(code, pipeline_par_work_descriptor_magic())
      bu64(code, pipeline_par_work_descriptor_version())
      bu64(code, pipeline_par_work_descriptor_lane_count(descriptor))
      bu64(code, pipeline_par_work_descriptor_storage_size(descriptor))
      bu64(code, pipeline_par_work_descriptor_storage_align(descriptor))
      pipeline_ir_native_emit_par_work_descriptor_entries(code, descriptor)
      cg_patch_b(code, skip, buf_len(code))
      emitted
    }
  }
}

pub(package) fn pipeline_ir_native_par_work_result_type(type_args: TypeExprList) -> i64 {
  if type_expr_list_len(type_args) < 1 { 0 }
  else { type_expr_to_node(type_expr_list_nth(type_args, 0)) }
}

pub(package) fn pipeline_ir_native_par_work_worker_hash(descriptor: PipelineParWorkDescriptor, task_owned: i64) -> i64 {
  pipeline_record_layout_descriptor_hash_mix(
    pipeline_record_layout_descriptor_hash_mix(5813497741338901, pipeline_par_work_descriptor_hash(descriptor)),
    task_owned
  )
}

-- Materialise an address within the current native image without ADR's ±1 MiB
-- reach limit. Starting from this instruction's relocation-invariant PC means
-- the sequence remains valid when an object section is placed at any address;
-- no page-alignment assumption or host-linker relocation is introduced.
pub(package) fn pipeline_ir_native_emit_image_address(
  code: i64,
  destination: i64,
  target: i64
) -> i64 {
  let site = buf_len(code)
  let delta = target - site
  let scratch = if destination == 17 { 16 } else { 17 }
  bu32(code, encode_adr(destination, 0))
  if delta == 0 { 0 }
  else {
    emit_mov_imm_safe(code, scratch, if delta < 0 { 0 - delta } else { delta })
    bu32(code, if delta < 0 {
      encode_sub_reg(destination, destination, scratch)
    } else {
      encode_add_reg(destination, destination, scratch)
    })
  }
  site
}

-- Materialise the per-result-shape worker entry consumed by every Par policy.
-- x0 is the sealed carrier. The thunk invokes its stored zero-argument closure,
-- stores each ABI result lane through the descriptor-validating runtime API,
-- and publishes the completed result. Publication promotes the result, retires
-- the carrier's closure stake, and only then exposes readiness, so a joiner may
-- clean the carrier immediately without racing a post-publication worker access.
-- The policy layer therefore executes one uniform `(ParWork) -> nil` ABI and
-- never needs to know T.
pub(package) fn pipeline_ir_native_ensure_par_work_worker(code: i64, descriptor: PipelineParWorkDescriptor, fm: i64, task_owned: i64) -> i64 {
  if pipeline_par_work_descriptor_is_valid(descriptor) == 0 { 0 }
  else {
    let key = pipeline_ir_native_par_work_worker_hash(descriptor, task_owned)
    let cached = mono_cache_lookup(fmap_mono_cache(fm), key)
    if cached > 1 { cached }
    else {
      let skip = buf_len(code)
      bu32(code, 0)
      let entry = buf_len(code)
      mono_cache_add(fmap_mono_cache(fm), key, entry)
      let lanes = pipeline_par_work_descriptor_lane_count(descriptor)
      -- [sp+0]=work, [sp+8..64]=up to eight result lanes, [sp+72]=LR.
      bu32(code, encode_sub_imm(31, 31, 80))
      emit_store_spill_offset(code, 0, 0)
      emit_store_spill_offset(code, 30, 72)
      -- Carrier layout: descriptor, worker entry, closure fn, closure env,
      -- result state, initialized mask, then descriptor-sized result data.
      bu32(code, cg_ldr(9, 0, 16))
      bu32(code, cg_ldr(0, 0, 24))
      bu32(code, encode_blr(9))
      for lane in 0..lanes { emit_store_spill_offset(code, lane, 8 + lane * 8) }
      for lane in 0..lanes {
        emit_load_spill_offset(code, 0, 0)
        emit_mov_imm_safe(code, 1, lane)
        emit_load_spill_offset(code, 2, 8 + lane * 8)
        cg_emit_call_lit(code, fm, "runtime_par_work_result_store_lane")
        bu32(code, encode_cbnz(0, 8))
        bu32(code, encode_brk(46))
      }
      emit_load_spill_offset(code, 0, 0)
      if task_owned == 1 { cg_emit_call_lit(code, fm, "runtime_spawn_work_result_publish") }
      else { cg_emit_call_lit(code, fm, "runtime_par_work_result_publish") }
      bu32(code, encode_cbnz(0, 8))
      bu32(code, encode_brk(46))
      emit_load_spill_offset(code, 30, 72)
      bu32(code, encode_add_imm(31, 31, 80))
      emit_mov_imm_safe(code, 0, 0)
      bu32(code, encode_ret())
      cg_patch_b(code, skip, buf_len(code))
      entry
    }
  }
}

pub(package) fn pipeline_ir_native_emit_par_work_pack(code: i64, dst: i64, type_args: TypeExprList, args: IrValueList, fm: i64, pinned: PipelineIrNativeValueHomeFacts, task_owned: i64) -> i64 {
  let result_ty = pipeline_ir_native_par_work_result_type(type_args)
  let descriptor = if result_ty == 0 { PipelineParWorkDescriptorInvalid(pipeline_par_work_descriptor_reason_unknown_shape()) }
    else { pipeline_par_work_descriptor_for_type(result_ty) }
  if ir_value_list_len(args) != 1 or pipeline_par_work_descriptor_is_valid(descriptor) == 0 {
    fmap_inc_emit_error_count(fm)
    bu32(code, encode_brk(46))
  } else {
    let descriptor_entry = pipeline_ir_native_ensure_par_work_descriptor(code, descriptor, fm)
    let worker_entry = pipeline_ir_native_ensure_par_work_worker(code, descriptor, fm, task_owned)
    -- A function value is one managed pointer to the stable [code, env]
    -- closure pair. Read both carrier fields before staging descriptor and
    -- worker addresses; treating them as two call arguments bypasses this
    -- intrinsic because the language ABI deliberately exposes one value.
    let closure_value = pipeline_ir_value_list_get_or(args, 0, 0 - 1)
    let closure_phys = pipeline_ir_native_load_value_temp_pinned(code, pinned, closure_value, 15)
    if closure_phys != 15 { bu32(code, encode_add_imm(15, closure_phys, 0)) } else { 0 }
    bu32(code, cg_ldr(2, 15, 0))
    bu32(code, cg_ldr(3, 15, 8))
    pipeline_ir_native_emit_image_address(code, 0, descriptor_entry)
    pipeline_ir_native_emit_image_address(code, 1, worker_entry)
    if task_owned == 1 { cg_emit_call_lit(code, fm, "runtime_spawn_work_new_raw") }
    else { cg_emit_call_lit(code, fm, "runtime_par_work_new_raw") }
    pipeline_ir_native_store_reg_pinned(code, pinned, dst, 0)
  }
}

pub(package) fn pipeline_ir_native_emit_par_work_take(code: i64, dst: i64, type_args: TypeExprList, args: IrValueList, fm: i64, pinned: PipelineIrNativeValueHomeFacts, task_owned: i64) -> i64 {
  let result_ty = pipeline_ir_native_par_work_result_type(type_args)
  let descriptor = if result_ty == 0 { PipelineParWorkDescriptorInvalid(pipeline_par_work_descriptor_reason_unknown_shape()) }
    else { pipeline_par_work_descriptor_for_type(result_ty) }
  if ir_value_list_len(args) != 1 or pipeline_par_work_descriptor_is_valid(descriptor) == 0 {
    fmap_inc_emit_error_count(fm)
    bu32(code, encode_brk(46))
  } else {
    let descriptor_entry = pipeline_ir_native_ensure_par_work_descriptor(code, descriptor, fm)
    let work_value = pipeline_ir_value_list_get_or(args, 0, 0 - 1)
    let work_phys = pipeline_ir_native_load_value_temp_pinned(code, pinned, work_value, 15)
    if work_phys != 15 { bu32(code, encode_add_imm(15, work_phys, 0)) } else { 0 }
    let lanes = pipeline_par_work_descriptor_lane_count(descriptor)
    let lane_storage_bytes = if lanes <= 1 { 16 } else { ((lanes * 8 + 15) / 16) * 16 }
    let storage_bytes = lane_storage_bytes + if task_owned == 1 { 16 } else { 0 }
    bu32(code, encode_sub_imm(31, 31, storage_bytes))
    if task_owned == 1 { emit_store_spill_offset(code, 15, lane_storage_bytes) } else { 0 }
    bu32(code, encode_add_imm(0, 15, 0))
    pipeline_ir_native_emit_image_address(code, 1, descriptor_entry)
    bu32(code, encode_add_imm(2, 31, 0))
    cg_emit_call_lit(code, fm, "runtime_par_work_result_move_to_expected")
    bu32(code, encode_cbnz(0, 8))
    bu32(code, encode_brk(46))
    if task_owned == 1 {
      emit_load_spill_offset(code, 0, lane_storage_bytes)
      cg_emit_call_lit(code, fm, "runtime_spawn_work_free_moved")
      bu32(code, encode_cbnz(0, 8))
      bu32(code, encode_brk(46))
    } else { 0 }
    if lanes == 0 {
      emit_mov_imm_safe(code, 0, 0)
    } else {
      for lane in 0..lanes { emit_load_spill_offset(code, lane, lane * 8) }
    }
    bu32(code, encode_add_imm(31, 31, storage_bytes))
    pipeline_ir_native_store_reg_pinned(code, pinned, dst, 0)
  }
}

pub(package) fn pipeline_ir_native_emit_record_layout_zero_data(code: i64, dst: i64, data_size: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  if data_size > 0 {
    let base_phys = pipeline_ir_native_load_reg(code, pinned, dst)
    pipeline_ir_native_emit_addr_plus_imm(code, 15, base_phys, 8)
    emit_mov_imm_safe(code, 16, data_size)
    emit_mov_imm_safe(code, 17, 0)
    let loop_start = buf_len(code)
    let done_pos = buf_len(code)
    bu32(code, 0)
    bu32(code, cg_strb(17, 15, 0))
    bu32(code, encode_add_imm(15, 15, 1))
    bu32(code, encode_sub_imm(16, 16, 1))
    let back = buf_len(code)
    bu32(code, encode_b(loop_start - back))
    cg_patch_cbz(code, done_pos, 16, buf_len(code))
  } else { 0 }
}

pub(package) fn pipeline_ir_native_emit_record_layout_fields(code: i64, dst: i64, fields: IrRecordLayoutFieldList, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  match fields {
    IrRecordLayoutFieldNil -> 0
    IrRecordLayoutFieldWord(field_hash, byte_offset, value, managed_kind, rest) -> {
      let base_phys = pipeline_ir_native_load_reg(code, pinned, dst)
      if base_phys == 14 { 0 } else { bu32(code, encode_add_imm(14, base_phys, 0)) }
      let value_phys = pipeline_ir_native_load_reg(code, pinned, value)
      if value_phys == 17 { 0 } else { bu32(code, encode_add_imm(17, value_phys, 0)) }
      pipeline_ir_native_emit_addr_plus_imm(code, 15, 14, byte_offset + 8)
      bu32(code, cg_str(17, 15, 0))
      pipeline_ir_native_emit_record_layout_fields(code, dst, rest, fm, pinned)
    }
    IrRecordLayoutFieldArray(field_hash, byte_offset, storage, byte_size, leaf_count, leaf_stride, leaf_kind, rest) -> {
      if byte_size > 0 {
        let base_phys = pipeline_ir_native_load_reg(code, pinned, dst)
        if base_phys == 14 { 0 } else { bu32(code, encode_add_imm(14, base_phys, 0)) }
        let storage_phys = pipeline_ir_native_load_reg(code, pinned, storage)
        if storage_phys == 16 { 0 } else { bu32(code, encode_add_imm(16, storage_phys, 0)) }
        bu32(code, cg_ldr(16, 16, 0))
        pipeline_ir_native_emit_addr_plus_imm(code, 15, 14, byte_offset + 8)
        emit_mov_imm_safe(code, 17, byte_size)
        cg_emit_mem_copy_regs(code, 15, 16, 17)
        if pipeline_array_drop_plan_is_active(leaf_count, leaf_stride, leaf_kind) == 1 {
          let target = pipeline_ir_native_ensure_array_copy_retain_glue(code, leaf_count, leaf_stride, leaf_kind, fm)
          bu32(code, encode_add_imm(0, 15, 0))
          let call = buf_len(code)
          bu32(code, encode_bl(target - call))
        } else { 0 }
      } else { 0 }
      pipeline_ir_native_emit_record_layout_fields(code, dst, rest, fm, pinned)
    }
  }
}

pub(package) fn pipeline_ir_native_emit_record_layout_init(code: i64, dst: i64, type_hash: i64, data_size: i64, align: i64, fields: IrRecordLayoutFieldList, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  if pipeline_record_layout_fields_are_valid(data_size, align, fields) == 0 {
    fmap_inc_emit_error_count(fm)
    bu32(code, encode_brk(31))
  } else {
    let descriptor = pipeline_ir_native_ensure_record_layout_descriptor(code, data_size, fields, fm)
    emit_mov_imm_safe(code, 0, data_size)
    emit_mov_imm_safe(code, 1, align)
    pipeline_ir_native_emit_image_address(code, 2, descriptor)
    cg_emit_call_lit(code, fm, "rc_default_alloc_described")
    pipeline_ir_native_store_reg_pinned(code, pinned, dst, 0)
    pipeline_ir_native_emit_record_layout_zero_data(code, dst, data_size, pinned)
    pipeline_ir_native_emit_record_layout_fields(code, dst, fields, fm, pinned)
  }
}

pub(package) fn pipeline_record_layout_array_load_is_valid(record_data_size: i64, byte_offset: i64, byte_size: i64, leaf_count: i64, leaf_stride: i64, leaf_kind: i64) -> i64 {
  if record_data_size < 0 or record_data_size > 2147483639 or byte_offset < 0 or byte_size < 0 { 0 }
  else { if byte_offset > record_data_size - byte_size { 0 }
  else { pipeline_array_copy_plan_is_valid(byte_size, leaf_count, leaf_stride, leaf_kind) } }
}

pub(package) fn pipeline_ir_native_emit_record_layout_array_load(code: i64, dst_data: i64, base: i64, record_data_size: i64, byte_offset: i64, byte_size: i64, leaf_count: i64, leaf_stride: i64, leaf_kind: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  if pipeline_record_layout_array_load_is_valid(record_data_size, byte_offset, byte_size, leaf_count, leaf_stride, leaf_kind) == 0 {
    fmap_inc_emit_error_count(fm)
    bu32(code, encode_brk(32))
  } else {
    if byte_size > 0 {
      let dst_phys = pipeline_ir_native_load_reg(code, pinned, dst_data)
      if dst_phys == 15 { 0 } else { bu32(code, encode_add_imm(15, dst_phys, 0)) }
      let base_phys = pipeline_ir_native_load_reg(code, pinned, base)
      pipeline_ir_native_emit_addr_plus_imm(code, 16, base_phys, byte_offset + 8)
      emit_mov_imm_safe(code, 17, byte_size)
      cg_emit_mem_copy_regs(code, 15, 16, 17)
      if pipeline_array_drop_plan_is_active(leaf_count, leaf_stride, leaf_kind) == 1 {
        let target = pipeline_ir_native_ensure_array_copy_retain_glue(code, leaf_count, leaf_stride, leaf_kind, fm)
        bu32(code, encode_add_imm(0, 15, 0))
        let call = buf_len(code)
        bu32(code, encode_bl(target - call))
      } else { 0 }
    } else { 0 }
  }
}

pub(package) fn pipeline_record_layout_word_load_is_valid(record_data_size: i64, byte_offset: i64) -> i64 {
  if record_data_size < 0 or record_data_size > 2147483639 or byte_offset < 0 { 0 }
  else { if byte_offset > record_data_size - 8 { 0 } else { 1 } }
}

pub(package) fn pipeline_ir_native_emit_record_layout_word_load(code: i64, dst: i64, base: i64, record_data_size: i64, byte_offset: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  if pipeline_record_layout_word_load_is_valid(record_data_size, byte_offset) == 0 {
    fmap_inc_emit_error_count(fm)
    bu32(code, encode_brk(33))
  } else {
    let base_phys = pipeline_ir_native_load_reg(code, pinned, base)
    pipeline_ir_native_emit_addr_plus_imm(code, 16, base_phys, byte_offset + 8)
    let rd = pipeline_ir_native_result_reg(dst, pinned)
    bu32(code, cg_ldr(rd, 16, 0))
    if rd == 17 { pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17) } else { pipeline_ir_native_ck_def(code, pinned, rd, dst) }
  }
}

pub(package) fn pipeline_ir_native_emit_record_fields(code: i64, base_reg: i64, fields: IrRecordFieldList, type_hash: i64, index: i64, tt: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  match fields {
    IrRecordFieldNil -> 0
    IrRecordFieldCons(field_hash, word_offset, value, rest) -> {
      let idx = if word_offset >= 0 { word_offset } else { index }
      let val_phys = pipeline_ir_native_load_reg(code, pinned, value)
      bu32(code, cg_str(val_phys, base_reg, idx * 8))
      pipeline_ir_native_emit_record_fields(code, base_reg, rest, type_hash, index + 1, tt, pinned)
    }
  }
}

-- Record nodes are default-managed like variants (managed aggregate ownership).
pub(package) fn pipeline_ir_native_finish_record_init(code: i64, dst: i64, type_hash: i64, fields: IrRecordFieldList, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let size = ir_record_field_list_len(fields) * 8
  bu32(code, encode_add_imm(14, 0, 0))
  -- A field-less record still rounds up to one word that no field store
  -- covers; initialise it explicitly now that the alloc does not zero.
  if size < 8 {
    emit_mov_imm(code, 16, 0)
    bu32(code, cg_str(16, 14, 0))
  } else { 0 }
  pipeline_ir_native_emit_record_fields(code, 14, fields, type_hash, 0, fmap_get_tt(fm), pinned)
  pipeline_ir_native_store_reg_pinned(code, pinned, dst, 14)
}

pub(package) fn pipeline_ir_native_emit_record_init(code: i64, dst: i64, type_hash: i64, fields: IrRecordFieldList, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let size = ir_record_field_list_len(fields) * 8
  let alloc_size = if size < 8 { 8 } else { size }
  let mask = pipeline_record_field_mask(fmap_get_tt(fm), type_hash)
  cg_emit_rc_default_alloc_masked_lit(code, fm, continuation_cleanup_kind_rc(), alloc_size, 8, mask)
  pipeline_ir_native_finish_record_init(code, dst, type_hash, fields, fm, pinned)
}

pub(package) fn pipeline_ir_native_emit_record_reuse_init(code: i64, token: i64, dst: i64, type_hash: i64, fields: IrRecordFieldList, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let size = ir_record_field_list_len(fields) * 8
  let alloc_size = if size < 8 { 8 } else { size }
  let mask = pipeline_record_field_mask(fmap_get_tt(fm), type_hash)
  let token_phys = pipeline_ir_native_load_reg(code, pinned, token)
  cg_emit_rc_default_alloc_masked_reuse_lit(code, fm, token_phys, continuation_cleanup_kind_rc(), alloc_size, 8, mask)
  pipeline_ir_native_finish_record_init(code, dst, type_hash, fields, fm, pinned)
}

-- Consuming-update clones expose the canonical raw allocation root before the
-- ordinary optimiser can inline it away. IrReuseInitI64 keeps that root and
-- its linear token indivisible in typed IR; this dynamic-size arm preserves
-- the source allocator's two SSA operands while supplying the zero field mask
-- used by rc_default_alloc. A later explicit rc_set_field_mask_word remains
-- authoritative for trusted raw factories.
pub(package) fn pipeline_ir_native_emit_raw_call_reuse_init(code: i64, token: i64, dst: i64, callee_hash: i64, args: IrValueList, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  if callee_hash != pipeline_ir_native_hash_name("rc_default_alloc") or ir_value_list_len(args) != 2 {
    fmap_inc_emit_error_count(fm)
    bu32(code, encode_brk(63))
  } else {
    let call_args = ir_value_list_prepend(token, args)
    pipeline_ir_native_move_call_args(code, call_args, 0, pinned)
    emit_mov_imm_safe(code, 3, 0)
    cg_record_typed_managed_reuse_lowering(fm, continuation_cleanup_kind_rc())
    cg_emit_call_lit(code, fm, "rc_default_alloc_masked_reuse")
    pipeline_ir_native_store_reg_pinned(code, pinned, dst, 0)
  }
}

pub(package) fn pipeline_ir_native_emit_field_load(code: i64, dst: i64, base: i64, field_index: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let idx = if field_index >= 0 { field_index } else { 0 }
  let base_phys = pipeline_ir_native_load_reg(code, pinned, base)
  let rd = pipeline_ir_native_result_reg(dst, pinned)
  bu32(code, cg_ldr(rd, base_phys, idx * 8))
  if rd == 17 { pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17) } else { pipeline_ir_native_ck_def(code, pinned, rd, dst) }
}

pub(package) fn pipeline_ir_native_emit_try(code: i64, dst: i64, value: i64, effect_key: i64, error_lanes: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let staged_error_lanes = if error_lanes <= 0 or error_lanes > 8 {
    fmap_inc_emit_error_count(fm)
    bu32(code, encode_brk(70))
    1
  } else { error_lanes }
  -- The result value must be re-loaded at EVERY use: a spilled result
  -- reloads into x16, which the tag-constant materialization below also
  -- uses (three chained ? spilled the third result and the payload load
  -- dereferenced the constant in the original minimal repro), and the error path
  -- reads the payload after a BL that clobbers every caller-saved
  -- scratch. load_reg is free for register-resident homes and re-emits
  -- the spill load otherwise.
  let tag_phys = pipeline_ir_native_load_reg(code, pinned, value)
  bu32(code, cg_ldr(17, tag_phys, 0))
  emit_mov_imm_safe(code, 16, pipeline_try_ok_tag_hash())
  bu32(code, encode_cmp(17, 16))
  let bne_pos = buf_len(code)
  bu32(code, 0)
  let ok_phys = pipeline_ir_native_load_reg(code, pinned, value)
  bu32(code, cg_ldr(17, ok_phys, 8))
  pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17)
  let b_over_pos = buf_len(code)
  bu32(code, 0)
  let err_start = buf_len(code)
  cg_perform_lookup(code, fm, effect_key, effect_fail_op_hash())
  bu32(code, cg_ldr(17, 13, 8))
  bu32(code, cg_ldr(0, 13, 16))
  let err_phys = pipeline_ir_native_load_reg(code, pinned, value)
  if err_phys != 14 { bu32(code, encode_add_imm(14, err_phys, 0)) } else { 0 }
  for lane in 0..staged_error_lanes {
    bu32(code, cg_ldr(lane + 1, 14, 8 + lane * 8))
  }
  pipeline_ir_native_emit_masked_clause_call(code)
  pipeline_ir_native_store_reg_pinned(code, pinned, dst, 0)
  let after = buf_len(code)
  bytes_set_u32(code, bne_pos, encode_b_cond(err_start - bne_pos, 1))
  bytes_set_u32(code, b_over_pos, encode_b(after - b_over_pos))
}

pub(package) fn pipeline_ir_native_emit_try_linear(code: i64, dst: i64, value: i64, effect_key: i64, parent_plan: i64, ok_plan: i64, error_plan: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let variant_plan = pipeline_try_variant_plan(parent_plan)
  let success_lanes = pipeline_try_linear_success_lane_count(parent_plan)
  let error_lanes = pipeline_try_linear_error_lane_count(parent_plan)
  let scratch_base = dst + success_lanes
  if pipeline_structural_drop_plan_is_valid(parent_plan) == 0 or
    pipeline_structural_drop_plan_storage_mode(parent_plan) != 3 or
    typeck_linear_layout_plan_kind(variant_plan) != 5 or
    (ok_plan != 0 and pipeline_structural_drop_plan_is_valid(ok_plan) == 0) or
    (error_plan != 0 and pipeline_structural_drop_plan_is_valid(error_plan) == 0) or
    success_lanes <= 0 or success_lanes > 8 or error_lanes <= 0 or error_lanes > 8 {
    fmap_inc_emit_error_count(fm)
    bu32(code, encode_brk(69))
  } else {
    -- The spare SSA home is part of this instruction's IR contract. It keeps
    -- either selected payload alive while detaching and freeing the Result
    -- backing; unlike a raw stack push it does not invalidate frame-relative
    -- homes or abort-cleanup shadow offsets. This synthetic value has no
    -- ordinary IR def/use interval, so it must use its canonical home rather
    -- than an allocator assignment that can be volatile or discarded. The
    -- final destination may itself be a caller-saved resident, so publish it
    -- only after the split's release call has returned.
    let tag_phys = pipeline_ir_native_load_reg(code, pinned, value)
    bu32(code, cg_ldr(17, tag_phys, 0))
    emit_mov_imm_safe(code, 16, pipeline_try_ok_tag_hash())
    bu32(code, encode_cmp(17, 16))
    let bne_pos = buf_len(code)
    bu32(code, 0)

    for lane in 0..success_lanes {
      let ok_phys = pipeline_ir_native_load_reg(code, pinned, value)
      bu32(code, cg_ldr(17, ok_phys, 8 + lane * 8))
      pipeline_ir_native_store_reg(code, pinned, scratch_base + lane, 17)
    }
    pipeline_ir_native_emit_structural_split(code, value, parent_plan, 0, 1, fm, pinned)
    let saved_ok = pipeline_ir_native_load_reg_temp(code, pinned, scratch_base, 16)
    pipeline_ir_native_store_reg_pinned(code, pinned, dst, saved_ok)
    let b_over_pos = buf_len(code)
    bu32(code, 0)

    let err_start = buf_len(code)
    for lane in 0..error_lanes {
      let err_phys = pipeline_ir_native_load_reg(code, pinned, value)
      bu32(code, cg_ldr(17, err_phys, 8 + lane * 8))
      pipeline_ir_native_store_reg(code, pinned, scratch_base + lane, 17)
    }
    -- Transfer the selected error payload to the Fail clause and consume the
    -- abandoned success obligation before any user handler code can run.
    pipeline_ir_native_emit_structural_split(code, value, parent_plan, 0, 1, fm, pinned)
    cg_perform_lookup(code, fm, effect_key, effect_fail_op_hash())
    bu32(code, cg_ldr(17, 13, 8))
    bu32(code, cg_ldr(0, 13, 16))
    for lane in 0..error_lanes {
      let saved_error = pipeline_ir_native_load_reg_temp(code, pinned, scratch_base + lane, 16)
      bu32(code, encode_add_imm(lane + 1, saved_error, 0))
    }
    pipeline_ir_native_emit_masked_clause_call(code)
    pipeline_ir_native_store_reg_pinned(code, pinned, dst, 0)

    let after = buf_len(code)
    bytes_set_u32(code, bne_pos, encode_b_cond(err_start - bne_pos, 1))
    bytes_set_u32(code, b_over_pos, encode_b(after - b_over_pos))
  }
}

pub(package) fn pipeline_ir_native_emit_try_result_lane(
  code: i64,
  dst: i64,
  scratch: i64,
  pinned: PipelineIrNativeValueHomeFacts
) -> i64 {
  let saved = pipeline_ir_native_load_reg_temp(code, pinned, scratch, 16)
  pipeline_ir_native_store_reg_pinned(code, pinned, dst, saved)
}

pub(package) fn pipeline_ir_native_emit_opt_chain(code: i64, dst: i64, base: i64, field_index: i64, effect_key: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let base_phys = pipeline_ir_native_load_reg(code, pinned, base)
  let cbz_pos = buf_len(code)
  bu32(code, 0)
  let idx = if field_index >= 0 { field_index } else { 0 }
  bu32(code, cg_ldr(17, base_phys, idx * 8))
  pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17)
  let b_over_pos = buf_len(code)
  bu32(code, 0)
  let nil_start = buf_len(code)
  cg_perform_lookup(code, fm, effect_key, effect_maybe_op_hash())
  bu32(code, cg_ldr(17, 13, 8))
  bu32(code, cg_ldr(0, 13, 16))
  pipeline_ir_native_emit_masked_clause_call(code)
  pipeline_ir_native_store_reg_pinned(code, pinned, dst, 0)
  let after = buf_len(code)
  cg_patch_cbz(code, cbz_pos, base_phys, nil_start)
  bytes_set_u32(code, b_over_pos, encode_b(after - b_over_pos))
}

pub(package) fn pipeline_ir_vector_check_non_null_bit() -> i64 { 1 }

pub(package) fn pipeline_ir_vector_check_lower_bound_bit() -> i64 { 2 }

pub(package) fn pipeline_ir_vector_check_upper_bound_bit() -> i64 { 4 }

pub(package) fn pipeline_ir_vector_check_has(check_mode: i64, bit: i64) -> i64 {
  if (check_mode band bit) != 0 { 1 } else { 0 }
}

pub(package) fn pipeline_ir_native_emit_vector_index_valid_mode(code: i64, vec_reg: i64, index_reg: i64, check_mode: i64) -> i64 {
  let patches = nlist_new()
  if pipeline_ir_vector_check_has(check_mode, pipeline_ir_vector_check_non_null_bit()) == 1 {
    0
  } else {
    let null_pos = buf_len(code)
    bu32(code, 0)
    nlist_add(patches, null_pos)
  }
  if pipeline_ir_vector_check_has(check_mode, pipeline_ir_vector_check_lower_bound_bit()) == 1 {
    0
  } else {
    emit_mov_imm_safe(code, 16, 0)
    cg_cmp_emit(code, 10, 13, index_reg, 16)
    let nonneg_pos = buf_len(code)
    bu32(code, 0)
    nlist_add(patches, nonneg_pos)
  }
  if pipeline_ir_vector_check_has(check_mode, pipeline_ir_vector_check_upper_bound_bit()) == 1 {
    0
  } else {
    bu32(code, cg_ldr(16, vec_reg, 8))
    cg_cmp_emit(code, 7, 13, index_reg, 16)
    let in_bounds_pos = buf_len(code)
    bu32(code, 0)
    nlist_add(patches, in_bounds_pos)
  }
  patches
}

pub(package) fn pipeline_ir_native_patch_vector_index_valid_mode(code: i64, patches: i64, vec_reg: i64, cond_reg: i64, check_mode: i64, done: i64) -> i64 {
  let has_null = if pipeline_ir_vector_check_has(check_mode, pipeline_ir_vector_check_non_null_bit()) == 1 { 0 } else { 1 }
  let has_lower = if pipeline_ir_vector_check_has(check_mode, pipeline_ir_vector_check_lower_bound_bit()) == 1 { 0 } else { 1 }
  let has_upper = if pipeline_ir_vector_check_has(check_mode, pipeline_ir_vector_check_upper_bound_bit()) == 1 { 0 } else { 1 }
  if has_null == 1 { cg_patch_cbz(code, nlist_get(patches, 0), vec_reg, done) } else { 0 }
  if has_lower == 1 { cg_patch_cbz(code, nlist_get(patches, has_null), cond_reg, done) } else { 0 }
  if has_upper == 1 { cg_patch_cbz(code, nlist_get(patches, has_null + has_lower), cond_reg, done) } else { 0 }
}

pub(package) fn pipeline_ir_native_record_vector_check_elision(fm: i64, check_mode: i64) -> i64 {
  let lower = pipeline_ir_vector_check_has(check_mode, pipeline_ir_vector_check_lower_bound_bit())
  let upper = pipeline_ir_vector_check_has(check_mode, pipeline_ir_vector_check_upper_bound_bit())
  if lower == 1 or upper == 1 { fmap_inc_vector_bounds_elision_count(fm) } else { 0 }
  if lower == 1 and upper == 1 { fmap_inc_vector_full_bounds_elision_count(fm) } else { 0 }
  if lower == 1 or upper == 1 { fmap_inc_indexed_bounds_elision_count(fm) } else { 0 }
  if lower == 1 and upper == 1 { fmap_inc_indexed_full_bounds_elision_count(fm) } else { 0 }
}

pub(package) fn pipeline_ir_native_record_indexed_call_elision(fm: i64, callee_hash: i64) -> i64 {
  let indexed_mode = pipeline_runtime_index_address_check_mode(callee_hash)
  let check_mode = if indexed_mode >= 0 { indexed_mode } else { pipeline_runtime_slice_address_check_mode(callee_hash) }
  if check_mode >= 0 {
    let lower = pipeline_ir_vector_check_has(check_mode, pipeline_ir_vector_check_lower_bound_bit())
    let upper = pipeline_ir_vector_check_has(check_mode, pipeline_ir_vector_check_upper_bound_bit())
    if lower == 1 or upper == 1 { fmap_inc_indexed_bounds_elision_count(fm) } else { 0 }
    if lower == 1 and upper == 1 { fmap_inc_indexed_full_bounds_elision_count(fm) } else { 0 }
  } else { 0 }
}

pub(package) fn pipeline_ir_native_emit_vector_data_for_access(code: i64, dst: i64, vec: i64, vec_phys: i64, facts: PipelineIrNativeVectorDataFacts, fm: i64) -> i64 {
  let home = pipeline_ir_native_vector_data_facts_home(facts)
  let reload = pipeline_ir_native_vector_data_fact_reload_for(pipeline_ir_native_vector_data_facts_entries(facts), dst, vec)
  if home == 0 or reload < 0 {
    -- A vector access without its typed fact is a producer/consumer contract
    -- violation. Trap the emitted path instead of silently reviving a local
    -- emission-time recognizer.
    bu32(code, encode_brk(62))
    home
  } else { if reload == 0 {
    fmap_inc_vector_data_hoist_use_count(fm)
    home
  } else {
    bu32(code, cg_ldr(home, vec_phys, 0))
    fmap_inc_vector_data_hoist_count(fm)
    home
  } }
}

pub(package) fn pipeline_ir_native_emit_vector_get_i64(code: i64, dst: i64, vec: i64, index: i64, fallback: i64, check_mode: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts, vector_data_facts: PipelineIrNativeVectorDataFacts) -> i64 {
  -- The fallback path is cold: check failures branch to a stub after the
  -- lane load that seeds the destination and rejoins, so the happy path
  -- never stages the fallback. With every check elided the fallback is
  -- not materialised at all. An FP-resident destination carries the
  -- result in its pool register on both paths with no GPR round-trip.
  let dst_fd = pipeline_ir_native_fp_resident_fd(pinned, dst)
  let vec_phys = pipeline_ir_native_load_reg(code, pinned, vec)
  if vec_phys == 14 { 0 } else { bu32(code, encode_add_imm(14, vec_phys, 0)) }
  let index_phys = pipeline_ir_native_load_reg(code, pinned, index)
  if index_phys == 15 { 0 } else { bu32(code, encode_add_imm(15, index_phys, 0)) }
  let patches = pipeline_ir_native_emit_vector_index_valid_mode(code, 14, 15, check_mode)
  let vector_data_home = pipeline_ir_native_emit_vector_data_for_access(code, dst, vec, 14, vector_data_facts, fm)
  if dst_fd != 0 {
    bu32(code, encode_ldr_d_reg_lsl3(dst_fd, vector_data_home, 15))
  } else {
    bu32(code, encode_ldr_reg_lsl3(17, vector_data_home, 15))
  }
  if nlist_len(patches) > 0 {
    let skip_pos = buf_len(code)
    bu32(code, 0)
    let stub = buf_len(code)
    let fallback_phys = pipeline_ir_native_load_reg(code, pinned, fallback)
    if dst_fd != 0 { bu32(code, encode_fmov_d_from_x(dst_fd, fallback_phys)) } else { bu32(code, encode_add_imm(17, fallback_phys, 0)) }
    let done = buf_len(code)
    pipeline_ir_native_patch_vector_index_valid_mode(code, patches, 14, 13, check_mode, stub)
    cg_patch_b(code, skip_pos, done)
  } else { 0 }
  if dst_fd == 0 { pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17) } else { 0 }
  fmap_inc_vector_lowering_count(fm)
  fmap_inc_vector_scaled_addr_count(fm)
  pipeline_ir_native_record_vector_check_elision(fm, check_mode)
  0
}

pub(package) fn pipeline_ir_native_emit_vector_set_i64(code: i64, dst: i64, vec: i64, index: i64, value: i64, check_mode: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts, vector_data_facts: PipelineIrNativeVectorDataFacts) -> i64 {
  let value_fd = pipeline_ir_native_fp_resident_fd(pinned, value)
  if value_fd == 0 {
    let value_phys = pipeline_ir_native_load_reg(code, pinned, value)
    if value_phys == 12 { 0 } else { bu32(code, encode_add_imm(12, value_phys, 0)) }
  } else { 0 }
  let vec_phys = pipeline_ir_native_load_reg(code, pinned, vec)
  if vec_phys == 14 { 0 } else { bu32(code, encode_add_imm(14, vec_phys, 0)) }
  let index_phys = pipeline_ir_native_load_reg(code, pinned, index)
  if index_phys == 15 { 0 } else { bu32(code, encode_add_imm(15, index_phys, 0)) }
  emit_mov_imm_safe(code, 17, 0)
  let patches = pipeline_ir_native_emit_vector_index_valid_mode(code, 14, 15, check_mode)
  let vector_data_home = pipeline_ir_native_emit_vector_data_for_access(code, dst, vec, 14, vector_data_facts, fm)
  if value_fd != 0 {
    bu32(code, encode_str_d_reg_lsl3(value_fd, vector_data_home, 15))
  } else {
    bu32(code, encode_str_reg_lsl3(12, vector_data_home, 15))
  }
  emit_mov_imm_safe(code, 17, 1)
  let done = buf_len(code)
  pipeline_ir_native_patch_vector_index_valid_mode(code, patches, 14, 13, check_mode, done)
  pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17)
  fmap_inc_vector_lowering_count(fm)
  fmap_inc_vector_scaled_addr_count(fm)
  pipeline_ir_native_record_vector_check_elision(fm, check_mode)
  0
}

pub(package) fn pipeline_ir_native_pop_one(code: i64, facts: PipelineIrNativeValueHomeFacts, ctx: PipelineNativeHandlerCtx) -> PipelineNativeHandlerCtx {
  match ctx {
    PipelineNativeHandlerCtxNil -> PipelineNativeHandlerCtxNil
    PipelineNativeHandlerCtxCons(eff_hash, infos, nclauses, ops_ctr, frame_ctr, is_abortive, rest) -> {
      let fp = pipeline_ir_native_load_reg_raw(code, facts, frame_ctr)
      if is_abortive == 1 {
        bu32(code, cg_ldr(9, fp, handler_frame_abort_cleanup_boundary_offset()))
        bu32(code, cg_str(9, 28, runtime_state_abort_cleanup_top_offset()))
        bu32(code, cg_ldr(9, fp, handler_frame_abort_prev_active_offset()))
        bu32(code, cg_str(9, 28, runtime_state_abort_cleanup_active_offset()))
      } else { 0 }
      bu32(code, cg_ldr(27, fp, handler_frame_prev_offset()))
      rest
    }
  }
}

