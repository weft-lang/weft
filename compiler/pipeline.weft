type PipelineNativeEmitCtx {
  -- The final field is a mutable list of handle-abort ADR patches owned by
  -- the current CFG emission. Nested clause functions get their own list.
  PipelineNativeEmitCtx(i64, PipelineNativeHandlerCtx, PipelineIrNativeValueHomeFacts, PipelineIrNativeF64Facts, i64, PipelineIrNativeFpEnv, PipelineIrNativeVectorDataFacts, i64)
}

