fn pipeline_expr_needs_effects_runtime(node: i64, src: i64) -> i64 {
  if node == 0 { false }
  else {
    match node_tag(node) {
      3 -> pipeline_expr_needs_effects_runtime(node_f2(node), src) or pipeline_expr_needs_effects_runtime(node_f3(node), src)
      4 -> pipeline_expr_list_needs_effects_runtime(node_f3(node), node_f4(node), src)
      5 -> pipeline_expr_needs_effects_runtime(node_f1(node), src) or pipeline_expr_needs_effects_runtime(node_f2(node), src) or pipeline_expr_needs_effects_runtime(node_f3(node), src)
      6 -> pipeline_expr_needs_effects_runtime(node_f3(node), src) or pipeline_expr_needs_effects_runtime(node_f4(node), src)
      7 -> pipeline_expr_needs_effects_runtime(node_f1(node), src) or pipeline_expr_needs_effects_runtime(node_f2(node), src)
      10 -> pipeline_expr_needs_effects_runtime(node_f1(node), src) or pipeline_expr_needs_effects_runtime(node_f2(node), src)
      11 -> pipeline_expr_needs_effects_runtime(node_f3(node), src) or pipeline_expr_needs_effects_runtime(node_f4(node), src)
      12 -> pipeline_expr_needs_effects_runtime(node_f3(node), src)
      13 -> pipeline_expr_needs_effects_runtime(node_f1(node), src)
      14 -> pipeline_record_fields_need_effects_runtime(node_f3(node), node_f4(node), src)
      15 -> pipeline_expr_needs_effects_runtime(node_f1(node), src) or pipeline_match_arms_need_effects_runtime(node_f2(node), node_f3(node), src)
      22 -> pipeline_expr_needs_effects_runtime(node_f1(node), src)
      25 -> pipeline_expr_needs_effects_runtime(node_f1(node), src)
      26 -> pipeline_expr_needs_effects_runtime(node_f1(node), src)
      29 -> pipeline_expr_needs_effects_runtime(node_f2(node), src)
      32 -> true
      33 -> true
      35 -> pipeline_expr_needs_effects_runtime(node_f1(node), src)
      36 -> pipeline_expr_needs_effects_runtime(node_f2(node), src)
      37 -> pipeline_expr_needs_effects_runtime(node_f1(node), src)
      41 -> pipeline_expr_needs_effects_runtime(node_f1(node), src) or pipeline_expr_list_needs_effects_runtime(node_f3(node), nlist_len(node_f3(node)), src)
      45 -> true
      46 -> pipeline_expr_needs_effects_runtime(node_f1(node), src) or pipeline_expr_needs_effects_runtime(node_f2(node), src)
      47 -> pipeline_expr_needs_effects_runtime(node_f3(node), src) or pipeline_expr_needs_effects_runtime(node_f4(node), src)
      48 -> true
      49 -> pipeline_expr_needs_effects_runtime(node_f1(node), src)
      52 -> pipeline_expr_needs_effects_runtime(node_f1(node), src) or pipeline_expr_needs_effects_runtime(node_f2(node), src)
      _ -> false
    }
  }
}

fn pipeline_fn_needs_effects_runtime(fn_wrap: i64, fn_src: i64, is_test: i64) -> i64 {
  if is_test == 1 {
    pipeline_expr_needs_effects_runtime(node_f3(fn_wrap), fn_src)
  } else {
    let inner = pipeline_fn_inner(fn_wrap)
    pipeline_expr_needs_effects_runtime(node_f4(inner), fn_src)
  }
}

fn pipeline_fns_need_effects_runtime(fns: i64) -> i64 {
  let mut found = false
  let mut i = 0
  while i < nlist_len(fns) {
    let pair = nlist_get(fns, i)
    if pipeline_fn_needs_effects_runtime(node_f1(pair), node_f2(pair), node_f4(pair)) {
      found = true
      i = nlist_len(fns)
    } else { i = i + 1 }
  }
  found
}

fn pipeline_bind_runtime_preludes(fns: i64, src: i64, tt: i64) -> i64 {
  let had_effects_need = pipeline_fns_need_effects_runtime(fns)
  let had_rc_need = pipeline_fns_need_rc_runtime(fns)
  if had_effects_need {
    parse_use_file(fns, tt, "runtime/effects.weft")
  } else { 0 }
  if had_rc_need {
    parse_use_file(fns, tt, "runtime/rc.weft")
  } else { 0 }
  if had_effects_need == 0 {
    if had_rc_need {
      parse_use_file(fns, tt, "runtime/effects.weft")
    } else { if pipeline_fns_need_effects_runtime(fns) {
      parse_use_file(fns, tt, "runtime/effects.weft")
    } else { 0 } }
  } else { 0 }
  fns
}

fn pipeline_parse_source(src: i64, n: i64) -> AstModule {
  let grammar = weft_grammar()
  let tt = ttable_new()
  let ast = pipeline_parse_module(grammar, src, n, tt)
  match ast {
    AstModule(fns, ast_src, ast_tt) -> {
      pipeline_bind_runtime_preludes(fns, ast_src, ast_tt)
      ast
    }
  }
}

fn pipeline_parse_source_with_diagnostics(src: i64, n: i64) -[Diagnose]> AstModule {
  let grammar = weft_grammar()
  let tt = ttable_new()
  let fns = grammar.parse(src, n, tt)
  pipeline_bind_runtime_preludes(fns, src, tt)
  AstModule(fns, src, tt)
}

fn pipeline_check_source(src: i64, n: i64) -> TypedModule {
  let ast = pipeline_parse_source(src, n)
  pipeline_check_module(ast)
}

fn pipeline_check_source_with_diagnostics(src: i64, n: i64) -[Diagnose]> TypedModule {
  match pipeline_parse_source_with_diagnostics(src, n) {
    AstModule(fns, ast_src, tt) -> pipeline_check_fns_with_diagnostics(fns, ast_src, tt)
  }
}

fn pipeline_handler_inline_stats(inline_sites: i64, residual_sites: i64) -> PipelineHandlerInlineStats {
  PipelineHandlerInlineStats(inline_sites, residual_sites)
}

fn pipeline_handler_inline_stats_empty() -> PipelineHandlerInlineStats {
  PipelineHandlerInlineStats(0, 0)
}

fn pipeline_handler_inline_stats_inline() -> PipelineHandlerInlineStats {
  PipelineHandlerInlineStats(1, 0)
}

fn pipeline_handler_inline_stats_residual() -> PipelineHandlerInlineStats {
  PipelineHandlerInlineStats(0, 1)
}

fn pipeline_handler_inline_stats_inline_sites(stats: PipelineHandlerInlineStats) -> i64 {
  match stats {
    PipelineHandlerInlineStats(inline_sites, residual_sites) -> inline_sites
  }
}

fn pipeline_handler_inline_stats_residual_sites(stats: PipelineHandlerInlineStats) -> i64 {
  match stats {
    PipelineHandlerInlineStats(inline_sites, residual_sites) -> residual_sites
  }
}

fn pipeline_handler_inline_stats_add(a: PipelineHandlerInlineStats, b: PipelineHandlerInlineStats) -> PipelineHandlerInlineStats {
  PipelineHandlerInlineStats(
    pipeline_handler_inline_stats_inline_sites(a) + pipeline_handler_inline_stats_inline_sites(b),
    pipeline_handler_inline_stats_residual_sites(a) + pipeline_handler_inline_stats_residual_sites(b)
  )
}

fn pipeline_handler_inline_stats_from_ir_functions(functions: IrFunctionList) -> PipelineHandlerInlineStats {
  PipelineHandlerInlineStats(
    ir_function_list_count_tag(functions, 24),
    ir_function_list_count_tag(functions, 18)
  )
}

fn pipeline_effect_sig_has_hash(eff: i64, eff_hash: i64) -> i64 {
  if eff == 0 { 0 }
  else { if ty_tag(eff) != 10 { 0 }
  else {
    let effects = ty_f1(eff)
    let mut found = 0
    let mut i = 0
    while i < nlist_len(effects) {
      let app = nlist_get(effects, i)
      if ty_tag(app) == 11 {
        if ty_f1(app) == eff_hash {
          found = 1
          i = nlist_len(effects)
        } else { i = i + 1 }
      } else { i = i + 1 }
    }
    found
  } }
}

fn pipeline_handler_evidence_candidate_expr_list_stats(nodes: i64, nargs: i64, src: i64, ctx: PipelineHandlerInlineCtx, current_eff: i64) -> i64 {
  let mut count = 0
  let mut i = 0
  while i < nargs {
    count = count + pipeline_handler_evidence_candidate_expr_stats(nlist_get(nodes, i), src, ctx, current_eff)
    i = i + 1
  }
  count
}

fn pipeline_handler_evidence_candidate_record_fields_stats(fields: i64, nfields: i64, src: i64, ctx: PipelineHandlerInlineCtx, current_eff: i64) -> i64 {
  let mut count = 0
  let mut i = 0
  while i < nfields {
    let field = nlist_get(fields, i)
    count = count + pipeline_handler_evidence_candidate_expr_stats(node_f3(field), src, ctx, current_eff)
    i = i + 1
  }
  count
}

fn pipeline_handler_evidence_candidate_match_arms_stats(arms: i64, narms: i64, src: i64, ctx: PipelineHandlerInlineCtx, current_eff: i64) -> i64 {
  let mut count = 0
  let mut i = 0
  while i < narms {
    let arm = nlist_get(arms, i)
    count = count + pipeline_handler_evidence_candidate_expr_stats(node_f2(arm), src, ctx, current_eff)
    count = count + pipeline_handler_evidence_candidate_expr_stats(node_f3(arm), src, ctx, current_eff)
    i = i + 1
  }
  count
}

fn pipeline_handler_evidence_candidate_clause_bodies_stats(clauses: i64, nclauses: i64, src: i64, ctx: PipelineHandlerInlineCtx, current_eff: i64) -> i64 {
  let mut count = 0
  let mut i = 0
  while i < nclauses {
    let clause = nlist_get(clauses, i)
    count = count + pipeline_handler_evidence_candidate_expr_stats(node_f3(clause), src, ctx, current_eff)
    i = i + 1
  }
  count
}

fn pipeline_handler_evidence_candidate_block_stats(first: i64, rest: i64, src: i64, ctx: PipelineHandlerInlineCtx, current_eff: i64) -> i64 {
  let first_count = pipeline_handler_evidence_candidate_expr_stats(first, src, ctx, current_eff)
  if rest == 0 {
    first_count
  } else {
    first_count + pipeline_handler_evidence_candidate_expr_stats(rest, src, ctx, current_eff)
  }
}

fn pipeline_handler_evidence_candidate_perform_stats(expr: i64, src: i64, ctx: PipelineHandlerInlineCtx, current_eff: i64) -> i64 {
  let lhs = node_f1(expr)
  let args = node_f4(expr)
  let arg_count = pipeline_handler_evidence_candidate_expr_list_stats(args, nlist_len(args), src, ctx, current_eff)
  if node_tag(lhs) == 2 {
    let eff_hash = str_hash(src, node_f1(lhs), node_f2(lhs))
    let op_hash = str_hash(src, node_f2(expr), node_f3(expr))
    let site_count = if pipeline_handler_inline_ctx_find(ctx, src, eff_hash, op_hash) == 1 {
      0
    } else {
      pipeline_effect_sig_has_hash(current_eff, eff_hash)
    }
    arg_count + site_count
  } else {
    arg_count
  }
}

fn pipeline_handler_evidence_candidate_handle_stats(expr: i64, src: i64, ctx: PipelineHandlerInlineCtx, current_eff: i64) -> i64 {
  let body = node_f1(expr)
  let clauses = node_f2(expr)
  let nclauses = node_f3(expr)
  let clause_count = pipeline_handler_evidence_candidate_clause_bodies_stats(clauses, nclauses, src, ctx, current_eff)
  if nclauses <= 0 {
    clause_count + pipeline_handler_evidence_candidate_expr_stats(body, src, ctx, current_eff)
  } else {
    let eff_hash = pipeline_handler_clause_effect_hash(src, nlist_get(clauses, 0))
    let next_ctx = pipeline_handler_inline_ctx_push(ctx, eff_hash, clauses, nclauses)
    clause_count + pipeline_handler_evidence_candidate_expr_stats(body, src, next_ctx, current_eff)
  }
}

fn pipeline_handler_evidence_candidate_expr_stats(expr: i64, src: i64, ctx: PipelineHandlerInlineCtx, current_eff: i64) -> i64 {
  if expr == 0 {
    0
  } else {
    let tag = node_tag(expr)
    match tag {
      3 -> pipeline_handler_evidence_candidate_expr_stats(node_f2(expr), src, ctx, current_eff) + pipeline_handler_evidence_candidate_expr_stats(node_f3(expr), src, ctx, current_eff)
      4 -> pipeline_handler_evidence_candidate_expr_list_stats(node_f3(expr), node_f4(expr), src, ctx, current_eff)
      5 -> pipeline_handler_evidence_candidate_expr_stats(node_f1(expr), src, ctx, current_eff) + pipeline_handler_evidence_candidate_expr_stats(node_f2(expr), src, ctx, current_eff) + pipeline_handler_evidence_candidate_expr_stats(node_f3(expr), src, ctx, current_eff)
      6 -> pipeline_handler_evidence_candidate_expr_stats(node_f3(expr), src, ctx, current_eff) + pipeline_handler_evidence_candidate_expr_stats(node_f4(expr), src, ctx, current_eff)
      7 -> pipeline_handler_evidence_candidate_block_stats(node_f1(expr), node_f2(expr), src, ctx, current_eff)
      10 -> pipeline_handler_evidence_candidate_expr_stats(node_f1(expr), src, ctx, current_eff) + pipeline_handler_evidence_candidate_expr_stats(node_f2(expr), src, ctx, current_eff)
      11 -> pipeline_handler_evidence_candidate_expr_stats(node_f3(expr), src, ctx, current_eff) + pipeline_handler_evidence_candidate_expr_stats(node_f4(expr), src, ctx, current_eff)
      12 -> pipeline_handler_evidence_candidate_expr_stats(node_f3(expr), src, ctx, current_eff)
      13 -> pipeline_handler_evidence_candidate_expr_stats(node_f1(expr), src, ctx, current_eff)
      14 -> pipeline_handler_evidence_candidate_record_fields_stats(node_f3(expr), node_f4(expr), src, ctx, current_eff)
      15 -> pipeline_handler_evidence_candidate_expr_stats(node_f1(expr), src, ctx, current_eff) + pipeline_handler_evidence_candidate_match_arms_stats(node_f2(expr), node_f3(expr), src, ctx, current_eff)
      22 -> pipeline_handler_evidence_candidate_expr_stats(node_f1(expr), src, ctx, current_eff)
      25 -> pipeline_handler_evidence_candidate_expr_stats(node_f1(expr), src, ctx, current_eff)
      26 -> pipeline_handler_evidence_candidate_expr_stats(node_f1(expr), src, ctx, current_eff)
      29 -> pipeline_handler_evidence_candidate_expr_stats(node_f2(expr), src, ctx, current_eff)
      32 -> pipeline_handler_evidence_candidate_perform_stats(expr, src, ctx, current_eff)
      33 -> pipeline_handler_evidence_candidate_handle_stats(expr, src, ctx, current_eff)
      35 -> pipeline_handler_evidence_candidate_expr_stats(node_f1(expr), src, ctx, current_eff)
      36 -> pipeline_handler_evidence_candidate_expr_stats(node_f2(expr), src, ctx, current_eff)
      37 -> pipeline_handler_evidence_candidate_expr_stats(node_f1(expr), src, ctx, current_eff)
      41 -> pipeline_handler_evidence_candidate_expr_stats(node_f1(expr), src, ctx, current_eff) + pipeline_handler_evidence_candidate_expr_list_stats(node_f3(expr), nlist_len(node_f3(expr)), src, ctx, current_eff)
      45 -> pipeline_handler_evidence_candidate_expr_stats(node_f1(expr), src, ctx, current_eff)
      46 -> pipeline_handler_evidence_candidate_expr_stats(node_f1(expr), src, ctx, current_eff) + pipeline_handler_evidence_candidate_expr_stats(node_f2(expr), src, ctx, current_eff)
      47 -> pipeline_handler_evidence_candidate_expr_stats(node_f3(expr), src, ctx, current_eff) + pipeline_handler_evidence_candidate_expr_stats(node_f4(expr), src, ctx, current_eff)
      48 -> pipeline_handler_evidence_candidate_expr_stats(node_f1(expr), src, ctx, current_eff)
      49 -> pipeline_handler_evidence_candidate_expr_stats(node_f1(expr), src, ctx, current_eff)
      52 -> pipeline_handler_evidence_candidate_expr_stats(node_f1(expr), src, ctx, current_eff) + pipeline_handler_evidence_candidate_expr_stats(node_f2(expr), src, ctx, current_eff)
      _ -> 0
    }
  }
}

fn pipeline_handler_evidence_candidate_fn_stats(fn_wrap: i64, fn_src: i64) -> i64 {
  let inner = pipeline_fn_inner(fn_wrap)
  pipeline_handler_evidence_candidate_expr_stats(node_f4(inner), fn_src, pipeline_handler_inline_ctx_empty(), fn_effects(fn_wrap))
}

fn pipeline_handler_evidence_candidate_fns_stats(fns: i64, user_src: i64) -> i64 {
  let mut count = 0
  let mut i = 0
  while i < nlist_len(fns) {
    let pair = nlist_get(fns, i)
    let fn_src = node_f2(pair)
    if fn_src == user_src {
      let fn_wrap = node_f1(pair)
      if fn_tparams(fn_wrap) == 0 {
        count = count + pipeline_handler_evidence_candidate_fn_stats(fn_wrap, fn_src)
      } else { 0 }
    } else { 0 }
    i = i + 1
  }
  count
}

fn pipeline_handler_inline_ctx_empty() -> PipelineHandlerInlineCtx {
  PipelineHandlerInlineCtxNil
}

fn pipeline_handler_inline_ctx_push(ctx: PipelineHandlerInlineCtx, eff_hash: i64, clauses: i64, nclauses: i64) -> PipelineHandlerInlineCtx {
  PipelineHandlerInlineCtxCons(eff_hash, clauses, nclauses, ctx)
}

fn pipeline_handler_clause_effect_hash(src: i64, clause: i64) -> i64 {
  let names = node_f1(clause)
  str_hash(src, node_f1(names), node_f2(names))
}

fn pipeline_handler_clause_op_hash(src: i64, clause: i64) -> i64 {
  let names = node_f1(clause)
  str_hash(src, node_f3(names), node_f4(names))
}

fn pipeline_handler_clauses_have_op_hash(src: i64, clauses: i64, nclauses: i64, op_hash: i64) -> i64 {
  let mut found = 0
  let mut i = 0
  while i < nclauses {
    if pipeline_handler_clause_op_hash(src, nlist_get(clauses, i)) == op_hash {
      found = 1
      i = nclauses
    } else { i = i + 1 }
  }
  found
}

fn pipeline_handler_clause_index_for_op_hash(src: i64, clauses: i64, nclauses: i64, op_hash: i64) -> i64 {
  let mut result = 0 - 1
  let mut i = 0
  while i < nclauses {
    if pipeline_handler_clause_op_hash(src, nlist_get(clauses, i)) == op_hash {
      result = i
      i = nclauses
    } else { i = i + 1 }
  }
  result
}

fn pipeline_handler_inline_match_found(found: PipelineHandlerInlineMatch) -> i64 {
  match found {
    PipelineHandlerInlineNoMatch -> 0
    PipelineHandlerInlineMatched(handler_depth, clause_index) -> 1
  }
}

fn pipeline_handler_inline_match_depth_or(found: PipelineHandlerInlineMatch, default: i64) -> i64 {
  match found {
    PipelineHandlerInlineNoMatch -> default
    PipelineHandlerInlineMatched(handler_depth, clause_index) -> handler_depth
  }
}

fn pipeline_handler_inline_match_clause_index_or(found: PipelineHandlerInlineMatch, default: i64) -> i64 {
  match found {
    PipelineHandlerInlineNoMatch -> default
    PipelineHandlerInlineMatched(handler_depth, clause_index) -> clause_index
  }
}

fn pipeline_handler_inline_ctx_find_match_at(ctx: PipelineHandlerInlineCtx, src: i64, eff_hash: i64, op_hash: i64, depth: i64) -> PipelineHandlerInlineMatch {
  match ctx {
    PipelineHandlerInlineCtxNil -> PipelineHandlerInlineNoMatch
    PipelineHandlerInlineCtxCons(ctx_eff_hash, clauses, nclauses, rest) -> {
      if ctx_eff_hash == eff_hash {
        let clause_index = pipeline_handler_clause_index_for_op_hash(src, clauses, nclauses, op_hash)
        if clause_index >= 0 {
          PipelineHandlerInlineMatched(depth, clause_index)
        } else {
          pipeline_handler_inline_ctx_find_match_at(rest, src, eff_hash, op_hash, depth + 1)
        }
      } else {
        pipeline_handler_inline_ctx_find_match_at(rest, src, eff_hash, op_hash, depth + 1)
      }
    }
  }
}

fn pipeline_handler_inline_ctx_find_match(ctx: PipelineHandlerInlineCtx, src: i64, eff_hash: i64, op_hash: i64) -> PipelineHandlerInlineMatch {
  pipeline_handler_inline_ctx_find_match_at(ctx, src, eff_hash, op_hash, 0)
}

fn pipeline_handler_inline_ctx_find(ctx: PipelineHandlerInlineCtx, src: i64, eff_hash: i64, op_hash: i64) -> i64 {
  pipeline_handler_inline_match_found(pipeline_handler_inline_ctx_find_match(ctx, src, eff_hash, op_hash))
}

fn pipeline_handler_inline_expr_list_stats(nodes: i64, nargs: i64, src: i64, ctx: PipelineHandlerInlineCtx) -> PipelineHandlerInlineStats {
  let mut stats = pipeline_handler_inline_stats_empty()
  let mut i = 0
  while i < nargs {
    stats = pipeline_handler_inline_stats_add(stats, pipeline_handler_inline_expr_stats(nlist_get(nodes, i), src, ctx))
    i = i + 1
  }
  stats
}

fn pipeline_handler_inline_record_fields_stats(fields: i64, nfields: i64, src: i64, ctx: PipelineHandlerInlineCtx) -> PipelineHandlerInlineStats {
  let mut stats = pipeline_handler_inline_stats_empty()
  let mut i = 0
  while i < nfields {
    let field = nlist_get(fields, i)
    stats = pipeline_handler_inline_stats_add(stats, pipeline_handler_inline_expr_stats(node_f3(field), src, ctx))
    i = i + 1
  }
  stats
}

fn pipeline_handler_inline_match_arms_stats(arms: i64, narms: i64, src: i64, ctx: PipelineHandlerInlineCtx) -> PipelineHandlerInlineStats {
  let mut stats = pipeline_handler_inline_stats_empty()
  let mut i = 0
  while i < narms {
    let arm = nlist_get(arms, i)
    let body_stats = pipeline_handler_inline_expr_stats(node_f2(arm), src, ctx)
    let guard_stats = pipeline_handler_inline_expr_stats(node_f3(arm), src, ctx)
    stats = pipeline_handler_inline_stats_add(stats, pipeline_handler_inline_stats_add(body_stats, guard_stats))
    i = i + 1
  }
  stats
}

fn pipeline_handler_inline_clause_bodies_stats(clauses: i64, nclauses: i64, src: i64, ctx: PipelineHandlerInlineCtx) -> PipelineHandlerInlineStats {
  let mut stats = pipeline_handler_inline_stats_empty()
  let mut i = 0
  while i < nclauses {
    let clause = nlist_get(clauses, i)
    stats = pipeline_handler_inline_stats_add(stats, pipeline_handler_inline_expr_stats(node_f3(clause), src, ctx))
    i = i + 1
  }
  stats
}

fn pipeline_handler_inline_block_stats(first: i64, rest: i64, src: i64, ctx: PipelineHandlerInlineCtx) -> PipelineHandlerInlineStats {
  let first_stats = pipeline_handler_inline_expr_stats(first, src, ctx)
  if rest == 0 {
    first_stats
  } else {
    pipeline_handler_inline_stats_add(first_stats, pipeline_handler_inline_expr_stats(rest, src, ctx))
  }
}

fn pipeline_handler_inline_perform_stats(expr: i64, src: i64, ctx: PipelineHandlerInlineCtx) -> PipelineHandlerInlineStats {
  let lhs = node_f1(expr)
  let args = node_f4(expr)
  let arg_stats = pipeline_handler_inline_expr_list_stats(args, nlist_len(args), src, ctx)
  if node_tag(lhs) == 2 {
    let eff_hash = str_hash(src, node_f1(lhs), node_f2(lhs))
    let op_hash = str_hash(src, node_f2(expr), node_f3(expr))
    let site_stats = if pipeline_handler_inline_ctx_find(ctx, src, eff_hash, op_hash) == 1 {
      pipeline_handler_inline_stats_inline()
    } else {
      pipeline_handler_inline_stats_residual()
    }
    pipeline_handler_inline_stats_add(arg_stats, site_stats)
  } else {
    arg_stats
  }
}

fn pipeline_handler_inline_handle_stats(expr: i64, src: i64, ctx: PipelineHandlerInlineCtx) -> PipelineHandlerInlineStats {
  let body = node_f1(expr)
  let clauses = node_f2(expr)
  let nclauses = node_f3(expr)
  let clause_stats = pipeline_handler_inline_clause_bodies_stats(clauses, nclauses, src, ctx)
  if nclauses <= 0 {
    pipeline_handler_inline_stats_add(clause_stats, pipeline_handler_inline_expr_stats(body, src, ctx))
  } else {
    let eff_hash = pipeline_handler_clause_effect_hash(src, nlist_get(clauses, 0))
    let next_ctx = pipeline_handler_inline_ctx_push(ctx, eff_hash, clauses, nclauses)
    let body_stats = pipeline_handler_inline_expr_stats(body, src, next_ctx)
    pipeline_handler_inline_stats_add(clause_stats, body_stats)
  }
}

fn pipeline_handler_inline_expr_stats(expr: i64, src: i64, ctx: PipelineHandlerInlineCtx) -> PipelineHandlerInlineStats {
  if expr == 0 {
    pipeline_handler_inline_stats_empty()
  } else {
    let tag = node_tag(expr)
    match tag {
      3 -> pipeline_handler_inline_stats_add(
        pipeline_handler_inline_expr_stats(node_f2(expr), src, ctx),
        pipeline_handler_inline_expr_stats(node_f3(expr), src, ctx)
      )
      4 -> pipeline_handler_inline_expr_list_stats(node_f3(expr), node_f4(expr), src, ctx)
      5 -> pipeline_handler_inline_stats_add(
        pipeline_handler_inline_expr_stats(node_f1(expr), src, ctx),
        pipeline_handler_inline_stats_add(
          pipeline_handler_inline_expr_stats(node_f2(expr), src, ctx),
          pipeline_handler_inline_expr_stats(node_f3(expr), src, ctx)
        )
      )
      6 -> pipeline_handler_inline_stats_add(
        pipeline_handler_inline_expr_stats(node_f3(expr), src, ctx),
        pipeline_handler_inline_expr_stats(node_f4(expr), src, ctx)
      )
      7 -> pipeline_handler_inline_block_stats(node_f1(expr), node_f2(expr), src, ctx)
      10 -> pipeline_handler_inline_stats_add(
        pipeline_handler_inline_expr_stats(node_f1(expr), src, ctx),
        pipeline_handler_inline_expr_stats(node_f2(expr), src, ctx)
      )
      11 -> pipeline_handler_inline_stats_add(
        pipeline_handler_inline_expr_stats(node_f3(expr), src, ctx),
        pipeline_handler_inline_expr_stats(node_f4(expr), src, ctx)
      )
      12 -> pipeline_handler_inline_expr_stats(node_f3(expr), src, ctx)
      13 -> pipeline_handler_inline_expr_stats(node_f1(expr), src, ctx)
      14 -> pipeline_handler_inline_record_fields_stats(node_f3(expr), node_f4(expr), src, ctx)
      15 -> pipeline_handler_inline_stats_add(
        pipeline_handler_inline_expr_stats(node_f1(expr), src, ctx),
        pipeline_handler_inline_match_arms_stats(node_f2(expr), node_f3(expr), src, ctx)
      )
      22 -> pipeline_handler_inline_expr_stats(node_f1(expr), src, ctx)
      25 -> pipeline_handler_inline_expr_stats(node_f1(expr), src, ctx)
      26 -> pipeline_handler_inline_expr_stats(node_f1(expr), src, ctx)
      29 -> pipeline_handler_inline_expr_stats(node_f2(expr), src, ctx)
      32 -> pipeline_handler_inline_perform_stats(expr, src, ctx)
      33 -> pipeline_handler_inline_handle_stats(expr, src, ctx)
      35 -> pipeline_handler_inline_expr_stats(node_f1(expr), src, ctx)
      36 -> pipeline_handler_inline_expr_stats(node_f2(expr), src, ctx)
      37 -> pipeline_handler_inline_expr_stats(node_f1(expr), src, ctx)
      41 -> pipeline_handler_inline_stats_add(
        pipeline_handler_inline_expr_stats(node_f1(expr), src, ctx),
        pipeline_handler_inline_expr_list_stats(node_f3(expr), nlist_len(node_f3(expr)), src, ctx)
      )
      45 -> pipeline_handler_inline_expr_stats(node_f1(expr), src, ctx)
      46 -> pipeline_handler_inline_stats_add(
        pipeline_handler_inline_expr_stats(node_f1(expr), src, ctx),
        pipeline_handler_inline_expr_stats(node_f2(expr), src, ctx)
      )
      47 -> pipeline_handler_inline_stats_add(
        pipeline_handler_inline_expr_stats(node_f3(expr), src, ctx),
        pipeline_handler_inline_expr_stats(node_f4(expr), src, ctx)
      )
      48 -> pipeline_handler_inline_expr_stats(node_f1(expr), src, ctx)
      49 -> pipeline_handler_inline_expr_stats(node_f1(expr), src, ctx)
      52 -> pipeline_handler_inline_stats_add(
        pipeline_handler_inline_expr_stats(node_f1(expr), src, ctx),
        pipeline_handler_inline_expr_stats(node_f2(expr), src, ctx)
      )
      _ -> pipeline_handler_inline_stats_empty()
    }
  }
}

fn pipeline_handler_inline_fn_stats(fn_wrap: i64, fn_src: i64) -> PipelineHandlerInlineStats {
  let inner = pipeline_fn_inner(fn_wrap)
  pipeline_handler_inline_expr_stats(node_f4(inner), fn_src, pipeline_handler_inline_ctx_empty())
}

fn pipeline_handler_inline_fns_stats(fns: i64, user_src: i64) -> PipelineHandlerInlineStats {
  let mut stats = pipeline_handler_inline_stats_empty()
  let mut i = 0
  while i < nlist_len(fns) {
    let pair = nlist_get(fns, i)
    let fn_src = node_f2(pair)
    if fn_src == user_src {
      let fn_wrap = node_f1(pair)
      if fn_tparams(fn_wrap) == 0 {
        stats = pipeline_handler_inline_stats_add(stats, pipeline_handler_inline_fn_stats(fn_wrap, fn_src))
      } else { 0 }
    } else { 0 }
    i = i + 1
  }
  stats
}

fn pipeline_handler_lower_ctx(params: i64, locals: PipelineValueEnv, src: i64, tt: i64, handlers: PipelineHandlerInlineCtx) -> PipelineHandlerLowerCtx {
  PipelineHandlerLowerCtx(params, locals, src, tt, handlers)
}

fn pipeline_handler_lower_ctx_params(lower_ctx: PipelineHandlerLowerCtx) -> i64 {
  match lower_ctx {
    PipelineHandlerLowerCtx(params, locals, src, tt, handlers) -> params
  }
}

fn pipeline_handler_lower_ctx_locals(lower_ctx: PipelineHandlerLowerCtx) -> PipelineValueEnv {
  match lower_ctx {
    PipelineHandlerLowerCtx(params, locals, src, tt, handlers) -> locals
  }
}

fn pipeline_handler_lower_ctx_src(lower_ctx: PipelineHandlerLowerCtx) -> i64 {
  match lower_ctx {
    PipelineHandlerLowerCtx(params, locals, src, tt, handlers) -> src
  }
}

fn pipeline_handler_lower_ctx_tt(lower_ctx: PipelineHandlerLowerCtx) -> i64 {
  match lower_ctx {
    PipelineHandlerLowerCtx(params, locals, src, tt, handlers) -> tt
  }
}

fn pipeline_handler_lower_ctx_handlers(lower_ctx: PipelineHandlerLowerCtx) -> PipelineHandlerInlineCtx {
  match lower_ctx {
    PipelineHandlerLowerCtx(params, locals, src, tt, handlers) -> handlers
  }
}

fn pipeline_lower_handler_opt_args(args: i64, nargs: i64, index: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> PipelineLoweredArgs {
  if index >= nargs {
    pipeline_lowered_args(ir_value_list_empty(), next_value, ir_inst_list_empty(), 1)
  } else {
    let params = pipeline_handler_lower_ctx_params(lower_ctx)
    let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
    let src = pipeline_handler_lower_ctx_src(lower_ctx)
    let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
    let handlers = pipeline_handler_lower_ctx_handlers(lower_ctx)
    let arg = pipeline_lower_expr_sidecar_handler_opt(nlist_get(args, index), params, locals, src, tt, next_value, handlers)
    if ir_lowered_expr_is_valid(arg) == 1 {
      let rest = pipeline_lower_handler_opt_args(args, nargs, index + 1, ir_lowered_expr_next_value(arg), lower_ctx)
      if pipeline_lowered_args_is_valid(rest) == 1 {
        let values = ir_value_list_prepend(ir_lowered_expr_value(arg), pipeline_lowered_args_values(rest))
        let insts = ir_inst_list_append(ir_lowered_expr_insts(arg), pipeline_lowered_args_insts(rest))
        pipeline_lowered_args(values, pipeline_lowered_args_next_value(rest), insts, 1)
      } else {
        pipeline_lowered_args_invalid(next_value)
      }
    } else {
      pipeline_lowered_args_invalid(next_value)
    }
  }
}

fn pipeline_lower_binop_expr_sidecar_handler_opt(expr: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, next_value: i64, ctx: PipelineHandlerInlineCtx) -> IrLoweredExpr {
  let lhs = pipeline_lower_expr_sidecar_handler_opt(node_f2(expr), params, locals, src, tt, next_value, ctx)
  if ir_lowered_expr_is_valid(lhs) == 1 {
    let rhs = pipeline_lower_expr_sidecar_handler_opt(node_f3(expr), params, locals, src, tt, ir_lowered_expr_next_value(lhs), ctx)
    if ir_lowered_expr_is_valid(rhs) == 1 {
      let op = ir_binary_op_from_parser(node_f1(expr))
      if ir_binary_op_is_supported(op) == 1 {
        let dst = ir_lowered_expr_next_value(rhs)
        let binary = ir_inst_list_prepend(
          ir_inst_binary_i64(dst, op, ir_lowered_expr_value(lhs), ir_lowered_expr_value(rhs)),
          ir_inst_list_empty()
        )
        let insts = ir_inst_list_append(
          ir_lowered_expr_insts(lhs),
          ir_inst_list_append(ir_lowered_expr_insts(rhs), binary)
        )
        ir_lowered_expr(dst, dst + 1, insts)
      } else {
        ir_lowered_expr_invalid(next_value)
      }
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_block_expr_sidecar_handler_opt(expr: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, next_value: i64, ctx: PipelineHandlerInlineCtx) -> IrLoweredExpr {
  let first = pipeline_lower_expr_sidecar_handler_opt(node_f1(expr), params, locals, src, tt, next_value, ctx)
  if ir_lowered_expr_is_valid(first) == 1 {
    let rest_node = node_f2(expr)
    if rest_node == 0 {
      first
    } else {
      let rest = pipeline_lower_expr_sidecar_handler_opt(rest_node, params, locals, src, tt, ir_lowered_expr_next_value(first), ctx)
      if ir_lowered_expr_is_valid(rest) == 1 {
        ir_lowered_expr(
          ir_lowered_expr_value(rest),
          ir_lowered_expr_next_value(rest),
          ir_inst_list_append(ir_lowered_expr_insts(first), ir_lowered_expr_insts(rest))
        )
      } else {
        ir_lowered_expr_invalid(next_value)
      }
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_let_expr_sidecar_handler_opt(expr: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, next_value: i64, ctx: PipelineHandlerInlineCtx) -> IrLoweredExpr {
  let value = pipeline_lower_expr_sidecar_handler_opt(node_f3(expr), params, locals, src, tt, next_value, ctx)
  if ir_lowered_expr_is_valid(value) == 1 {
    let next_locals = pipeline_value_env_push(locals, node_f1(expr), node_f2(expr), ir_lowered_expr_value(value))
    let body = pipeline_lower_expr_sidecar_handler_opt(node_f4(expr), params, next_locals, src, tt, ir_lowered_expr_next_value(value), ctx)
    if ir_lowered_expr_is_valid(body) == 1 {
      let bind = ir_inst_list_prepend(ir_inst_bind_i64(node_f1(expr), node_f2(expr), ir_lowered_expr_value(value)), ir_inst_list_empty())
      ir_lowered_expr(
        ir_lowered_expr_value(body),
        ir_lowered_expr_next_value(body),
        ir_inst_list_append(ir_lowered_expr_insts(value), ir_inst_list_append(bind, ir_lowered_expr_insts(body)))
      )
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_perform_expr_sidecar_handler_opt(expr: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, next_value: i64, ctx: PipelineHandlerInlineCtx) -> IrLoweredExpr {
  let lhs = node_f1(expr)
  if node_tag(lhs) == 2 {
    let args_node = node_f4(expr)
    let lower_ctx = pipeline_handler_lower_ctx(params, locals, src, tt, ctx)
    let args = pipeline_lower_handler_opt_args(args_node, nlist_len(args_node), 0, next_value, lower_ctx)
    if pipeline_lowered_args_is_valid(args) == 1 {
      let dst = pipeline_lowered_args_next_value(args)
      let eff_hash = effect_name_hash(src, node_f1(lhs), node_f2(lhs))
      let op_hash = effect_name_hash(src, node_f2(expr), node_f3(expr))
      let found = pipeline_handler_inline_ctx_find_match(ctx, src, eff_hash, op_hash)
      let op_inst = if pipeline_handler_inline_match_found(found) == 1 {
        ir_inst_handler_direct_i64(
          dst,
          eff_hash,
          op_hash,
          pipeline_handler_inline_match_depth_or(found, 0 - 1),
          pipeline_handler_inline_match_clause_index_or(found, 0 - 1),
          pipeline_lowered_args_values(args)
        )
      } else {
        ir_inst_perform_i64(dst, eff_hash, op_hash, pipeline_lowered_args_values(args))
      }
      let perform = ir_inst_list_prepend(op_inst, ir_inst_list_empty())
      let insts = ir_inst_list_append(pipeline_lowered_args_insts(args), perform)
      ir_lowered_expr(dst, dst + 1, insts)
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_generic_call_expr_sidecar_handler_opt(expr: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, next_value: i64, ctx: PipelineHandlerInlineCtx) -> IrLoweredExpr {
  let call_node = node_f2(expr)
  if pipeline_call_callee_is_direct(params, locals, src, node_f1(call_node), node_f2(call_node)) == 1 {
    let lower_ctx = pipeline_handler_lower_ctx(params, locals, src, tt, ctx)
    let args = pipeline_lower_handler_opt_args(node_f3(call_node), node_f4(call_node), 0, next_value, lower_ctx)
    if pipeline_lowered_args_is_valid(args) == 1 {
      let dst = pipeline_lowered_args_next_value(args)
      let call = ir_inst_list_prepend(
        pipeline_generic_call_inst(dst, src, tt, node_f1(call_node), node_f2(call_node), node_f1(expr), pipeline_lowered_args_values(args)),
        ir_inst_list_empty()
      )
      let insts = ir_inst_list_append(pipeline_lowered_args_insts(args), call)
      ir_lowered_expr(dst, dst + 1, insts)
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_handle_expr_sidecar_handler_opt(expr: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, next_value: i64, ctx: PipelineHandlerInlineCtx) -> IrLoweredExpr {
  let body = node_f1(expr)
  let clauses = node_f2(expr)
  let nclauses = node_f3(expr)
  if nclauses <= 0 {
    pipeline_lower_expr_sidecar(expr, params, locals, src, tt, next_value)
  } else {
    let eff_hash = pipeline_handler_clause_effect_hash(src, nlist_get(clauses, 0))
    let next_ctx = pipeline_handler_inline_ctx_push(ctx, eff_hash, clauses, nclauses)
    let lowered = pipeline_lower_expr_sidecar_handler_opt(body, params, locals, src, tt, next_value, next_ctx)
    if ir_lowered_expr_is_valid(lowered) == 1 {
      let marker = ir_inst_list_prepend(ir_inst_handle_i64(0 - 1, body, clauses, nclauses), ir_inst_list_empty())
      let pop = ir_inst_list_prepend(ir_inst_handler_pop_i64(0 - 1), ir_inst_list_empty())
      ir_lowered_expr(
        ir_lowered_expr_value(lowered),
        ir_lowered_expr_next_value(lowered),
        ir_inst_list_append(marker, ir_inst_list_append(ir_lowered_expr_insts(lowered), pop))
      )
    } else {
      pipeline_lower_expr_sidecar(expr, params, locals, src, tt, next_value)
    }
  }
}

fn pipeline_lower_expr_sidecar_handler_opt(expr: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, next_value: i64, ctx: PipelineHandlerInlineCtx) -> IrLoweredExpr {
  let tag = node_tag(expr)
  match tag {
    1 -> pipeline_lower_expr_sidecar(expr, params, locals, src, tt, next_value)
    2 -> pipeline_lower_expr_sidecar(expr, params, locals, src, tt, next_value)
    3 -> pipeline_lower_binop_expr_sidecar_handler_opt(expr, params, locals, src, tt, next_value, ctx)
    6 -> pipeline_lower_let_expr_sidecar_handler_opt(expr, params, locals, src, tt, next_value, ctx)
    7 -> pipeline_lower_block_expr_sidecar_handler_opt(expr, params, locals, src, tt, next_value, ctx)
    9 -> pipeline_lower_expr_sidecar(expr, params, locals, src, tt, next_value)
    22 -> pipeline_lower_not_expr_sidecar(expr, params, locals, src, tt, next_value)
    24 -> pipeline_lower_expr_sidecar(expr, params, locals, src, tt, next_value)
    32 -> pipeline_lower_perform_expr_sidecar_handler_opt(expr, params, locals, src, tt, next_value, ctx)
    33 -> pipeline_lower_handle_expr_sidecar_handler_opt(expr, params, locals, src, tt, next_value, ctx)
    36 -> pipeline_lower_generic_call_expr_sidecar_handler_opt(expr, params, locals, src, tt, next_value, ctx)
    37 -> pipeline_lower_expr_sidecar_handler_opt(node_f1(expr), params, locals, src, tt, next_value, ctx)
    51 -> pipeline_lower_expr_sidecar(expr, params, locals, src, tt, next_value)
    _ -> ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_straight_fn_handler_optimised(inner: i64, params: i64, src: i64, tt: i64, nparams: i64) -> IrFunctionList {
  let body = node_f4(inner)
  let lowered = pipeline_lower_expr_sidecar_handler_opt(body, params, pipeline_value_env_empty(), src, tt, nparams, pipeline_handler_inline_ctx_empty())
  if ir_lowered_expr_is_valid(lowered) == 1 {
    let block = ir_block_new_term(0, ir_lowered_expr_insts(lowered), ir_term_return(ir_lowered_expr_value(lowered)))
    let f = ir_function_new(str_hash(src, node_f1(inner), node_f2(inner)), nparams, block)
    ir_function_list_prepend(f, ir_function_list_empty())
  } else {
    pipeline_lower_straight_fn_sidecar(inner, params, src, tt, nparams)
  }
}

fn pipeline_lower_simple_fn_handler_optimised(pair: i64, tt: i64) -> IrFunctionList {
  let fn_wrap = node_f1(pair)
  let fn_src = node_f2(pair)
  let inner = pipeline_fn_inner(fn_wrap)
  let params = node_f3(inner)
  let body = node_f4(inner)
  let nparams = nlist_len(params)
  if pipeline_expr_needs_cfg(body) == 1 {
    pipeline_lower_simple_fn_sidecar(pair, tt)
  } else {
    pipeline_lower_straight_fn_handler_optimised(inner, params, fn_src, tt, nparams)
  }
}

fn pipeline_lower_fns_handler_optimised(fns: i64, tt: i64, user_src: i64) -> IrFunctionList {
  let mut result = ir_function_list_empty()
  let n = nlist_len(fns)
  for i in 0..n {
    let pair = nlist_get(fns, i)
    if node_f2(pair) == user_src {
      if fn_tparams(node_f1(pair)) == 0 {
        let one = pipeline_lower_simple_fn_handler_optimised(pair, tt)
        match one {
          IrFunctionNil -> 0
          IrFunctionCons(f, rest) -> { result = ir_function_list_prepend(f, result) }
        }
      } else { 0 }
    } else { 0 }
  }
  result
}

fn pipeline_ir_function_list_append(left: IrFunctionList, right: IrFunctionList) -> IrFunctionList {
  match left {
    IrFunctionNil -> right
    IrFunctionCons(f, rest) -> ir_function_list_prepend(f, pipeline_ir_function_list_append(rest, right))
  }
}

fn pipeline_generic_template_find(fns: i64, user_src: i64, name_hash: i64) -> i64 {
  let mut result = 0
  let n = nlist_len(fns)
  for i in 0..n {
    let pair = nlist_get(fns, i)
    let fn_src = node_f2(pair)
    if fn_src == user_src {
      let fn_wrap = node_f1(pair)
      let inner = pipeline_fn_inner(fn_wrap)
      let h = str_hash(fn_src, node_f1(inner), node_f2(inner))
      if h == name_hash {
        if fn_tparams(fn_wrap) != 0 {
          result = pair
        } else { 0 }
      } else { 0 }
    } else { 0 }
  }
  result
}

fn pipeline_lower_generic_specialisation_handler_optimised(pair: i64, type_args: i64, tt: i64, handlers: PipelineHandlerInlineCtx) -> IrFunctionList {
  if pair == 0 {
    ir_function_list_empty()
  } else {
    let fn_wrap = node_f1(pair)
    let fn_src = node_f2(pair)
    let inner = pipeline_fn_inner(fn_wrap)
    let body = node_f4(inner)
    if pipeline_expr_needs_cfg(body) == 1 {
      ir_function_list_empty()
    } else {
      let subst = cg_build_subst(fn_tparams(fn_wrap), type_args)
      let params = cg_params_subst(node_f3(inner), subst)
      let nparams = nlist_len(params)
      let lowered = pipeline_lower_expr_sidecar_handler_opt(body, params, pipeline_value_env_empty(), fn_src, tt, nparams, handlers)
      if ir_lowered_expr_is_valid(lowered) == 1 {
        let block = ir_block_new_term(0, ir_lowered_expr_insts(lowered), ir_term_return(ir_lowered_expr_value(lowered)))
        let name_hash = str_hash(fn_src, node_f1(inner), node_f2(inner))
        let f = ir_function_new(mono_spec_hash(name_hash, type_args), nparams, block)
        if ir_function_count_tag(f, 24) > 0 or ir_function_count_tag(f, 18) > 0 {
          ir_function_list_prepend(f, ir_function_list_empty())
        } else {
          ir_function_list_empty()
        }
      } else {
        ir_function_list_empty()
      }
    }
  }
}

fn pipeline_collect_generic_specs_list(nodes: i64, count: i64, fns: i64, user_src: i64, tt: i64, handlers: PipelineHandlerInlineCtx) -> IrFunctionList {
  let mut result = ir_function_list_empty()
  for i in 0..count {
    let one = pipeline_collect_generic_specs_expr(nlist_get(nodes, i), fns, user_src, tt, handlers)
    result = pipeline_ir_function_list_append(result, one)
  }
  result
}

fn pipeline_collect_generic_specs_record_fields(fields: i64, nfields: i64, fns: i64, user_src: i64, tt: i64, handlers: PipelineHandlerInlineCtx) -> IrFunctionList {
  let mut result = ir_function_list_empty()
  for i in 0..nfields {
    let field = nlist_get(fields, i)
    result = pipeline_ir_function_list_append(result, pipeline_collect_generic_specs_expr(node_f3(field), fns, user_src, tt, handlers))
  }
  result
}

fn pipeline_collect_generic_specs_clause_bodies(clauses: i64, nclauses: i64, fns: i64, user_src: i64, tt: i64, handlers: PipelineHandlerInlineCtx) -> IrFunctionList {
  let mut result = ir_function_list_empty()
  for i in 0..nclauses {
    let clause = nlist_get(clauses, i)
    result = pipeline_ir_function_list_append(result, pipeline_collect_generic_specs_expr(node_f3(clause), fns, user_src, tt, handlers))
  }
  result
}

fn pipeline_collect_generic_specs_match_arms(arms: i64, narms: i64, fns: i64, user_src: i64, tt: i64, handlers: PipelineHandlerInlineCtx) -> IrFunctionList {
  let mut result = ir_function_list_empty()
  for i in 0..narms {
    let arm = nlist_get(arms, i)
    result = pipeline_ir_function_list_append(result, pipeline_collect_generic_specs_expr(node_f2(arm), fns, user_src, tt, handlers))
    result = pipeline_ir_function_list_append(result, pipeline_collect_generic_specs_expr(node_f3(arm), fns, user_src, tt, handlers))
  }
  result
}

fn pipeline_collect_generic_specs_block(first: i64, rest: i64, fns: i64, user_src: i64, tt: i64, handlers: PipelineHandlerInlineCtx) -> IrFunctionList {
  let first_specs = pipeline_collect_generic_specs_expr(first, fns, user_src, tt, handlers)
  if rest == 0 {
    first_specs
  } else {
    pipeline_ir_function_list_append(first_specs, pipeline_collect_generic_specs_expr(rest, fns, user_src, tt, handlers))
  }
}

fn pipeline_collect_generic_specs_handle(expr: i64, fns: i64, user_src: i64, tt: i64, handlers: PipelineHandlerInlineCtx) -> IrFunctionList {
  let body = node_f1(expr)
  let clauses = node_f2(expr)
  let nclauses = node_f3(expr)
  let clause_specs = pipeline_collect_generic_specs_clause_bodies(clauses, nclauses, fns, user_src, tt, handlers)
  if nclauses <= 0 {
    pipeline_ir_function_list_append(clause_specs, pipeline_collect_generic_specs_expr(body, fns, user_src, tt, handlers))
  } else {
    let eff_hash = pipeline_handler_clause_effect_hash(user_src, nlist_get(clauses, 0))
    let next_handlers = pipeline_handler_inline_ctx_push(handlers, eff_hash, clauses, nclauses)
    pipeline_ir_function_list_append(clause_specs, pipeline_collect_generic_specs_expr(body, fns, user_src, tt, next_handlers))
  }
}

fn pipeline_collect_generic_specs_generic_call(expr: i64, fns: i64, user_src: i64, tt: i64, handlers: PipelineHandlerInlineCtx) -> IrFunctionList {
  let call_node = node_f2(expr)
  let arg_specs = pipeline_collect_generic_specs_list(node_f3(call_node), node_f4(call_node), fns, user_src, tt, handlers)
  let name_hash = str_hash(user_src, node_f1(call_node), node_f2(call_node))
  let pair = pipeline_generic_template_find(fns, user_src, name_hash)
  let specialised = pipeline_lower_generic_specialisation_handler_optimised(pair, node_f1(expr), tt, handlers)
  pipeline_ir_function_list_append(arg_specs, specialised)
}

fn pipeline_collect_generic_specs_expr(expr: i64, fns: i64, user_src: i64, tt: i64, handlers: PipelineHandlerInlineCtx) -> IrFunctionList {
  if expr == 0 {
    ir_function_list_empty()
  } else {
    let tag = node_tag(expr)
    match tag {
      3 -> pipeline_ir_function_list_append(
        pipeline_collect_generic_specs_expr(node_f2(expr), fns, user_src, tt, handlers),
        pipeline_collect_generic_specs_expr(node_f3(expr), fns, user_src, tt, handlers)
      )
      4 -> pipeline_collect_generic_specs_list(node_f3(expr), node_f4(expr), fns, user_src, tt, handlers)
      5 -> pipeline_ir_function_list_append(
        pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers),
        pipeline_ir_function_list_append(
          pipeline_collect_generic_specs_expr(node_f2(expr), fns, user_src, tt, handlers),
          pipeline_collect_generic_specs_expr(node_f3(expr), fns, user_src, tt, handlers)
        )
      )
      6 -> pipeline_ir_function_list_append(
        pipeline_collect_generic_specs_expr(node_f3(expr), fns, user_src, tt, handlers),
        pipeline_collect_generic_specs_expr(node_f4(expr), fns, user_src, tt, handlers)
      )
      7 -> pipeline_collect_generic_specs_block(node_f1(expr), node_f2(expr), fns, user_src, tt, handlers)
      10 -> pipeline_ir_function_list_append(
        pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers),
        pipeline_collect_generic_specs_expr(node_f2(expr), fns, user_src, tt, handlers)
      )
      11 -> pipeline_ir_function_list_append(
        pipeline_collect_generic_specs_expr(node_f3(expr), fns, user_src, tt, handlers),
        pipeline_collect_generic_specs_expr(node_f4(expr), fns, user_src, tt, handlers)
      )
      12 -> pipeline_collect_generic_specs_expr(node_f3(expr), fns, user_src, tt, handlers)
      13 -> pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers)
      14 -> pipeline_collect_generic_specs_record_fields(node_f3(expr), node_f4(expr), fns, user_src, tt, handlers)
      15 -> pipeline_ir_function_list_append(
        pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers),
        pipeline_collect_generic_specs_match_arms(node_f2(expr), node_f3(expr), fns, user_src, tt, handlers)
      )
      22 -> pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers)
      25 -> pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers)
      26 -> pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers)
      29 -> pipeline_collect_generic_specs_expr(node_f2(expr), fns, user_src, tt, handlers)
      32 -> pipeline_collect_generic_specs_list(node_f4(expr), nlist_len(node_f4(expr)), fns, user_src, tt, handlers)
      33 -> pipeline_collect_generic_specs_handle(expr, fns, user_src, tt, handlers)
      35 -> pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers)
      36 -> pipeline_collect_generic_specs_generic_call(expr, fns, user_src, tt, handlers)
      37 -> pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers)
      41 -> pipeline_ir_function_list_append(
        pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers),
        pipeline_collect_generic_specs_list(node_f3(expr), nlist_len(node_f3(expr)), fns, user_src, tt, handlers)
      )
      45 -> pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers)
      46 -> pipeline_ir_function_list_append(
        pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers),
        pipeline_collect_generic_specs_expr(node_f2(expr), fns, user_src, tt, handlers)
      )
      47 -> pipeline_ir_function_list_append(
        pipeline_collect_generic_specs_expr(node_f3(expr), fns, user_src, tt, handlers),
        pipeline_collect_generic_specs_expr(node_f4(expr), fns, user_src, tt, handlers)
      )
      48 -> pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers)
      49 -> pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers)
      52 -> pipeline_ir_function_list_append(
        pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers),
        pipeline_collect_generic_specs_expr(node_f2(expr), fns, user_src, tt, handlers)
      )
      _ -> ir_function_list_empty()
    }
  }
}

fn pipeline_collect_generic_specs_fns(fns: i64, tt: i64, user_src: i64) -> IrFunctionList {
  let mut result = ir_function_list_empty()
  let n = nlist_len(fns)
  for i in 0..n {
    let pair = nlist_get(fns, i)
    if node_f2(pair) == user_src {
      let fn_wrap = node_f1(pair)
      if fn_tparams(fn_wrap) == 0 {
        let inner = pipeline_fn_inner(fn_wrap)
        let specs = pipeline_collect_generic_specs_expr(node_f4(inner), fns, user_src, tt, pipeline_handler_inline_ctx_empty())
        result = pipeline_ir_function_list_append(result, specs)
      } else { 0 }
    } else { 0 }
  }
  result
}

fn pipeline_lower_ir(typed: TypedModule) -> IrModule {
  match typed {
    TypedModule(fns, src, tt) -> {
      let sidecar = pipeline_lower_typed_functions_internal(typed)
      IrModule(sidecar)
    }
  }
}

fn pipeline_ir_function_list_find_hash(functions: IrFunctionList, name_hash: i64) -> IrFunctionList {
  match functions {
    IrFunctionNil -> ir_function_list_empty()
    IrFunctionCons(f, rest) -> {
      match f {
        IrFunction(hash, params, blocks) -> {
          if hash == name_hash {
            ir_function_list_prepend(f, ir_function_list_empty())
          } else {
            pipeline_ir_function_list_find_hash(rest, name_hash)
          }
        }
      }
    }
  }
}

fn pipeline_ir_native_params_unmanaged(params: i64, nparams: i64) -> i64 {
  let mut ok = 1
  for i in 0..nparams {
    let p = nlist_get(params, i)
    if cg_ty_is_managed(node_f3(p)) == 1 { ok = 0 } else { 0 }
  }
  ok
}

fn pipeline_ir_native_inst_supported(inst: IrInst) -> i64 {
  match inst {
    IrConstI64(dst, value) -> 1
    IrBinaryI64(dst, op, lhs, rhs) -> ir_binary_op_is_supported(op)
    IrHandleI64(dst, body, clauses, nclauses) -> 1
    IrHandlerDirectI64(dst, effect_hash, op_hash, handler_depth, clause_index, args) -> 1
    IrHandlerPopI64(frame) -> 1
    IrBindI64(ns, nl, value) -> 1
    IrPerformI64(dst, effect_hash, op_hash, args) -> 1
    _ -> 0
  }
}

fn pipeline_ir_native_inst_list_supported(insts: IrInstList) -> i64 {
  match insts {
    IrInstNil -> 1
    IrInstCons(inst, rest) -> {
      if pipeline_ir_native_inst_supported(inst) == 1 {
        pipeline_ir_native_inst_list_supported(rest)
      } else {
        0
      }
    }
  }
}

fn pipeline_ir_native_block_supported(block: IrBlock) -> i64 {
  match block {
    IrBlock(id, params, insts, term) -> {
      match term {
        IrTermReturn(value) -> {
          if ir_value_list_len(params) == 0 {
            pipeline_ir_native_inst_list_supported(insts)
          } else {
            0
          }
        }
        _ -> 0
      }
    }
  }
}

fn pipeline_handler_clauses_have_continuation(clauses: i64, nclauses: i64) -> i64 {
  let mut result = 0
  let mut i = 0
  while i < nclauses {
    if node_f4(nlist_get(clauses, i)) != 0 {
      result = 1
      i = nclauses
    } else {
      i = i + 1
    }
  }
  result
}

fn pipeline_handler_clause_bodies_have_continuation(clauses: i64, nclauses: i64) -> i64 {
  let mut result = 0
  let mut i = 0
  while i < nclauses {
    if pipeline_expr_has_continuation_handler(node_f3(nlist_get(clauses, i))) == 1 {
      result = 1
      i = nclauses
    } else {
      i = i + 1
    }
  }
  result
}

fn pipeline_expr_list_has_continuation_handler(nodes: i64, count: i64) -> i64 {
  let mut result = 0
  let mut i = 0
  while i < count {
    if pipeline_expr_has_continuation_handler(nlist_get(nodes, i)) == 1 {
      result = 1
      i = count
    } else {
      i = i + 1
    }
  }
  result
}

fn pipeline_expr_has_continuation_handler(expr: i64) -> i64 {
  if expr == 0 {
    0
  } else {
    match node_tag(expr) {
      3 -> pipeline_expr_has_continuation_handler(node_f2(expr)) or pipeline_expr_has_continuation_handler(node_f3(expr))
      5 -> pipeline_expr_has_continuation_handler(node_f1(expr)) or pipeline_expr_has_continuation_handler(node_f2(expr)) or pipeline_expr_has_continuation_handler(node_f3(expr))
      6 -> pipeline_expr_has_continuation_handler(node_f3(expr)) or pipeline_expr_has_continuation_handler(node_f4(expr))
      7 -> pipeline_expr_has_continuation_handler(node_f1(expr)) or pipeline_expr_has_continuation_handler(node_f2(expr))
      12 -> pipeline_expr_has_continuation_handler(node_f3(expr))
      13 -> pipeline_expr_has_continuation_handler(node_f1(expr))
      14 -> pipeline_expr_list_has_continuation_handler(node_f3(expr), node_f4(expr))
      15 -> pipeline_expr_has_continuation_handler(node_f1(expr))
      22 -> pipeline_expr_has_continuation_handler(node_f1(expr))
      25 -> pipeline_expr_has_continuation_handler(node_f1(expr))
      26 -> pipeline_expr_has_continuation_handler(node_f1(expr))
      29 -> pipeline_expr_has_continuation_handler(node_f2(expr))
      32 -> pipeline_expr_list_has_continuation_handler(node_f4(expr), nlist_len(node_f4(expr)))
      33 -> {
        let clauses = node_f2(expr)
        let nclauses = node_f3(expr)
        pipeline_handler_clauses_have_continuation(clauses, nclauses) or
        pipeline_expr_has_continuation_handler(node_f1(expr)) or
        pipeline_handler_clause_bodies_have_continuation(clauses, nclauses)
      }
      36 -> {
        let call_node = node_f2(expr)
        pipeline_expr_list_has_continuation_handler(node_f3(call_node), node_f4(call_node))
      }
      37 -> pipeline_expr_has_continuation_handler(node_f1(expr))
      41 -> pipeline_expr_has_continuation_handler(node_f1(expr)) or pipeline_expr_list_has_continuation_handler(node_f3(expr), nlist_len(node_f3(expr)))
      45 -> pipeline_expr_has_continuation_handler(node_f1(expr))
      46 -> pipeline_expr_has_continuation_handler(node_f1(expr)) or pipeline_expr_has_continuation_handler(node_f2(expr))
      47 -> pipeline_expr_has_continuation_handler(node_f3(expr)) or pipeline_expr_has_continuation_handler(node_f4(expr))
      48 -> pipeline_expr_has_continuation_handler(node_f1(expr))
      49 -> pipeline_expr_has_continuation_handler(node_f1(expr))
      52 -> pipeline_expr_has_continuation_handler(node_f1(expr)) or pipeline_expr_has_continuation_handler(node_f2(expr))
      _ -> 0
    }
  }
}

fn pipeline_expr_list_has_generator_i64_new(nodes: i64, count: i64, src: i64) -> i64 {
  let mut result = 0
  let mut i = 0
  while i < count {
    if pipeline_expr_has_generator_i64_new(nlist_get(nodes, i), src) == 1 {
      result = 1
      i = count
    } else {
      i = i + 1
    }
  }
  result
}

fn pipeline_handler_clauses_have_generator_i64_new(clauses: i64, nclauses: i64, src: i64) -> i64 {
  let mut result = 0
  let mut i = 0
  while i < nclauses {
    if pipeline_expr_has_generator_i64_new(node_f3(nlist_get(clauses, i)), src) == 1 {
      result = 1
      i = nclauses
    } else {
      i = i + 1
    }
  }
  result
}

fn pipeline_expr_has_generator_i64_new(expr: i64, src: i64) -> i64 {
  if expr == 0 {
    0
  } else {
    match node_tag(expr) {
      3 -> pipeline_expr_has_generator_i64_new(node_f2(expr), src) or pipeline_expr_has_generator_i64_new(node_f3(expr), src)
      4 -> {
        if src_eq(src, node_f1(expr), node_f2(expr), "generator_i64_new") == 1 { 1 }
        else { pipeline_expr_list_has_generator_i64_new(node_f3(expr), node_f4(expr), src) }
      }
      5 -> pipeline_expr_has_generator_i64_new(node_f1(expr), src) or pipeline_expr_has_generator_i64_new(node_f2(expr), src) or pipeline_expr_has_generator_i64_new(node_f3(expr), src)
      6 -> pipeline_expr_has_generator_i64_new(node_f3(expr), src) or pipeline_expr_has_generator_i64_new(node_f4(expr), src)
      7 -> pipeline_expr_has_generator_i64_new(node_f1(expr), src) or pipeline_expr_has_generator_i64_new(node_f2(expr), src)
      10 -> pipeline_expr_has_generator_i64_new(node_f1(expr), src) or pipeline_expr_has_generator_i64_new(node_f2(expr), src)
      11 -> pipeline_expr_has_generator_i64_new(node_f3(expr), src) or pipeline_expr_has_generator_i64_new(node_f4(expr), src)
      12 -> pipeline_expr_has_generator_i64_new(node_f3(expr), src)
      13 -> pipeline_expr_has_generator_i64_new(node_f1(expr), src)
      14 -> pipeline_expr_list_has_generator_i64_new(node_f3(expr), node_f4(expr), src)
      15 -> pipeline_expr_has_generator_i64_new(node_f1(expr), src)
      22 -> pipeline_expr_has_generator_i64_new(node_f1(expr), src)
      25 -> pipeline_expr_has_generator_i64_new(node_f1(expr), src)
      26 -> pipeline_expr_has_generator_i64_new(node_f1(expr), src)
      29 -> pipeline_expr_has_generator_i64_new(node_f2(expr), src)
      32 -> pipeline_expr_list_has_generator_i64_new(node_f4(expr), nlist_len(node_f4(expr)), src)
      33 -> {
        let clauses = node_f2(expr)
        let nclauses = node_f3(expr)
        pipeline_expr_has_generator_i64_new(node_f1(expr), src) or
        pipeline_handler_clauses_have_generator_i64_new(clauses, nclauses, src)
      }
      36 -> {
        let call_node = node_f2(expr)
        if src_eq(src, node_f1(call_node), node_f2(call_node), "generator_new") == 1 { 1 }
        else { pipeline_expr_list_has_generator_i64_new(node_f3(call_node), node_f4(call_node), src) }
      }
      37 -> pipeline_expr_has_generator_i64_new(node_f1(expr), src)
      41 -> pipeline_expr_has_generator_i64_new(node_f1(expr), src) or pipeline_expr_list_has_generator_i64_new(node_f3(expr), nlist_len(node_f3(expr)), src)
      45 -> pipeline_expr_has_generator_i64_new(node_f1(expr), src)
      46 -> pipeline_expr_has_generator_i64_new(node_f1(expr), src) or pipeline_expr_has_generator_i64_new(node_f2(expr), src)
      47 -> pipeline_expr_has_generator_i64_new(node_f3(expr), src) or pipeline_expr_has_generator_i64_new(node_f4(expr), src)
      48 -> pipeline_expr_has_generator_i64_new(node_f1(expr), src)
      49 -> pipeline_expr_has_generator_i64_new(node_f1(expr), src)
      52 -> pipeline_expr_has_generator_i64_new(node_f1(expr), src) or pipeline_expr_has_generator_i64_new(node_f2(expr), src)
      _ -> 0
    }
  }
}

fn pipeline_ir_native_function_supported(fn_wrap: i64, f: IrFunction, fn_src: i64) -> i64 {
  let fn_node = unwrap_fn(fn_wrap)
  let body = node_f4(fn_node)
  let params = node_f3(fn_node)
  let nparams = nlist_len(params)
  let unmanaged = if cg_ty_is_managed(fn_ret_type(fn_wrap)) == 1 {
    0
  } else {
    pipeline_ir_native_params_unmanaged(params, nparams)
  }
  if unmanaged == 0 { 0 }
  else { if pipeline_expr_has_continuation_handler(body) == 1 { 0 }
  else { if pipeline_expr_has_generator_i64_new(body, fn_src) == 1 { 0 }
  else { if ir_function_count_tag(f, 24) <= 0 { 0 }
  else { if ir_function_count_tag(f, 18) != 0 { 0 }
  else { if ir_function_count_tag(f, 19) <= 0 { 0 }
  else { if ir_function_count_tag(f, 19) != ir_function_count_tag(f, 25) { 0 }
  else {
    match f {
      IrFunction(hash, param_count, blocks) -> {
        match blocks {
          IrBlockListCons(block, IrBlockListNil) -> pipeline_ir_native_block_supported(block)
          _ -> 0
        }
      }
    }
  } } } } } } }
}

fn pipeline_ir_native_store_reg(code: i64, dst: i64, phys: i64) -> i64 {
  if dst < 0 { 0 }
  else { if dst < 8 {
    bu32(code, encode_add_imm(dst + 19, phys, 0))
  } else {
    emit_store_reg(code, dst, phys)
  } }
}

fn pipeline_ir_native_emit_const(code: i64, dst: i64, value: i64) -> i64 {
  emit_mov_imm_safe(code, 17, value)
  pipeline_ir_native_store_reg(code, dst, 17)
}

fn pipeline_ir_native_emit_binary(code: i64, dst: i64, op: IrBinaryOp, lhs: i64, rhs: i64) -> i64 {
  let lp = emit_load_reg(code, lhs)
  let rp = emit_load_rhs(code, rhs)
  cg_binop_emit(code, ir_binary_op_tag(op), 17, lp, rp)
  pipeline_ir_native_store_reg(code, dst, 17)
}

fn pipeline_ir_native_handler_ctx_len(ctx: PipelineNativeHandlerCtx) -> i64 {
  match ctx {
    PipelineNativeHandlerCtxNil -> 0
    PipelineNativeHandlerCtxCons(clauses, infos, nclauses, ops_ctr, frame_ctr, rest) -> 1 + pipeline_ir_native_handler_ctx_len(rest)
  }
}

fn pipeline_ir_native_handler_ctx_at(ctx: PipelineNativeHandlerCtx, depth: i64) -> PipelineNativeHandlerCtx {
  match ctx {
    PipelineNativeHandlerCtxNil -> PipelineNativeHandlerCtxNil
    PipelineNativeHandlerCtxCons(clauses, infos, nclauses, ops_ctr, frame_ctr, rest) -> {
      if depth <= 0 { ctx } else { pipeline_ir_native_handler_ctx_at(rest, depth - 1) }
    }
  }
}

fn pipeline_ir_native_move_args(code: i64, args: IrValueList, index: i64) -> i64 {
  match args {
    IrValueNil -> 0
    IrValueCons(value, rest) -> {
      let phys = emit_load_reg(code, value)
      bu32(code, encode_add_imm(index + 1, phys, 0))
      pipeline_ir_native_move_args(code, rest, index + 1)
    }
  }
}

fn pipeline_ir_native_emit_handle(code: i64, scope: i64, src: i64, fm: i64, body: i64, clauses: i64, nclauses: i64, ctx: PipelineNativeHandlerCtx) -> PipelineNativeHandlerCtx {
  if nclauses <= 0 { ctx }
  else {
    let first_names = node_f1(nlist_get(clauses, 0))
    let eff_hash = str_hash(src, node_f1(first_names), node_f2(first_names))
    let clause_infos = alloc_bump(nclauses * 8)
    for ci in 0..nclauses {
      let info = cg_hclause_body(nlist_get(clauses, ci), code, scope, src, fm)
      __mem_store64(clause_infos + ci * 8, info)
    }
    let depth = pipeline_ir_native_handler_ctx_len(ctx)
    let ops_ctr = 200 + depth * 2
    let frame_ctr = ops_ctr + 1
    cg_bump_alloc_imm(code, 16, nclauses * handler_ops_entry_size())
    emit_store_reg(code, ops_ctr, 16)
    cg_hfill_ops(clauses, nclauses, clause_infos, code, scope, src, ops_ctr)
    cg_hbuild_frame(code, eff_hash, nclauses, ops_ctr)
    emit_store_reg(code, frame_ctr, 27)
    PipelineNativeHandlerCtxCons(clauses, clause_infos, nclauses, ops_ctr, frame_ctr, ctx)
  }
}

fn pipeline_ir_native_emit_direct(code: i64, dst: i64, handler_depth: i64, clause_index: i64, args: IrValueList, ctx: PipelineNativeHandlerCtx) -> i64 {
  let found = pipeline_ir_native_handler_ctx_at(ctx, handler_depth)
  match found {
    PipelineNativeHandlerCtxNil -> 0
    PipelineNativeHandlerCtxCons(clauses, infos, nclauses, ops_ctr, frame_ctr, rest) -> {
      let info = __mem_load64(infos + clause_index * 8)
      let clause_start = __mem_load64(info)
      pipeline_ir_native_move_args(code, args, 0)
      let nfree = __mem_load64(info + 16)
      if nfree == 0 {
        emit_mov_imm(code, 0, 0)
      } else {
        let ops_phys = emit_load_reg(code, ops_ctr)
        bu32(code, cg_ldr(0, ops_phys, clause_index * handler_ops_entry_size() + handler_ops_env_ptr_offset()))
      }
      let cur = buf_len(code)
      bu32(code, encode_bl(clause_start - cur))
      pipeline_ir_native_store_reg(code, dst, 0)
    }
  }
}

fn pipeline_ir_native_emit_perform(code: i64, dst: i64, effect_hash: i64, op_hash: i64, args: IrValueList, fm: i64) -> i64 {
  cg_perform_lookup(code, fm, effect_hash, op_hash)
  bu32(code, cg_ldr(9, 13, handler_ops_fn_ptr_offset()))
  bu32(code, cg_ldr(0, 13, handler_ops_env_ptr_offset()))
  pipeline_ir_native_move_args(code, args, 0)
  bu32(code, encode_blr(9))
  pipeline_ir_native_store_reg(code, dst, 0)
}

fn pipeline_ir_native_pop_one(code: i64, ctx: PipelineNativeHandlerCtx) -> PipelineNativeHandlerCtx {
  match ctx {
    PipelineNativeHandlerCtxNil -> PipelineNativeHandlerCtxNil
    PipelineNativeHandlerCtxCons(clauses, infos, nclauses, ops_ctr, frame_ctr, rest) -> {
      let fp = emit_load_reg(code, frame_ctr)
      bu32(code, cg_ldr(27, fp, handler_frame_prev_offset()))
      rest
    }
  }
}

fn pipeline_ir_native_emit_ctx_scope(ctx: PipelineNativeEmitCtx) -> i64 {
  match ctx {
    PipelineNativeEmitCtx(scope, handlers) -> scope
  }
}

fn pipeline_ir_native_emit_ctx_handlers(ctx: PipelineNativeEmitCtx) -> PipelineNativeHandlerCtx {
  match ctx {
    PipelineNativeEmitCtx(scope, handlers) -> handlers
  }
}

fn pipeline_ir_native_emit_inst(inst: IrInst, code: i64, src: i64, fm: i64, ctx: PipelineNativeEmitCtx) -> PipelineNativeEmitCtx {
  let scope = pipeline_ir_native_emit_ctx_scope(ctx)
  let handlers = pipeline_ir_native_emit_ctx_handlers(ctx)
  match inst {
    IrConstI64(dst, value) -> { pipeline_ir_native_emit_const(code, dst, value) ctx }
    IrBinaryI64(dst, op, lhs, rhs) -> { pipeline_ir_native_emit_binary(code, dst, op, lhs, rhs) ctx }
    IrBindI64(ns, nl, value) -> PipelineNativeEmitCtx(scope_push(scope, ns, nl, reg_id(value)), handlers)
    IrHandleI64(dst, body, clauses, nclauses) -> {
      let next_handlers = pipeline_ir_native_emit_handle(code, scope, src, fm, body, clauses, nclauses, handlers)
      PipelineNativeEmitCtx(scope, next_handlers)
    }
    IrHandlerPopI64(frame) -> PipelineNativeEmitCtx(scope, pipeline_ir_native_pop_one(code, handlers))
    IrHandlerDirectI64(dst, effect_hash, op_hash, handler_depth, clause_index, args) -> {
      pipeline_ir_native_emit_direct(code, dst, handler_depth, clause_index, args, handlers)
      ctx
    }
    IrPerformI64(dst, effect_hash, op_hash, args) -> {
      pipeline_ir_native_emit_perform(code, dst, effect_hash, op_hash, args, fm)
      ctx
    }
    _ -> ctx
  }
}

fn pipeline_ir_native_emit_inst_list(insts: IrInstList, code: i64, src: i64, fm: i64, ctx: PipelineNativeEmitCtx) -> PipelineNativeEmitCtx {
  match insts {
    IrInstNil -> ctx
    IrInstCons(inst, rest) -> {
      let next_ctx = pipeline_ir_native_emit_inst(inst, code, src, fm, ctx)
      pipeline_ir_native_emit_inst_list(rest, code, src, fm, next_ctx)
    }
  }
}

fn pipeline_ir_native_pop_handlers(code: i64, ctx: PipelineNativeHandlerCtx) -> i64 {
  match ctx {
    PipelineNativeHandlerCtxNil -> 0
    PipelineNativeHandlerCtxCons(clauses, infos, nclauses, ops_ctr, frame_ctr, rest) -> {
      let fp = emit_load_reg(code, frame_ctr)
      bu32(code, cg_ldr(27, fp, handler_frame_prev_offset()))
      pipeline_ir_native_pop_handlers(code, rest)
    }
  }
}

fn pipeline_ir_native_emit_term(term: IrTerminator, code: i64) -> i64 {
  match term {
    IrTermReturn(value) -> {
      let result_phys = emit_load_reg(code, value)
      bu32(code, encode_add_imm(0, result_phys, 0))
    }
    _ -> emit_mov_imm(code, 0, 0)
  }
}

fn pipeline_ir_native_emit_block(block: IrBlock, code: i64, scope: i64, src: i64, fm: i64) -> i64 {
  match block {
    IrBlock(id, params, insts, term) -> {
      let ctx = pipeline_ir_native_emit_inst_list(insts, code, src, fm, PipelineNativeEmitCtx(scope, PipelineNativeHandlerCtxNil))
      pipeline_ir_native_pop_handlers(code, pipeline_ir_native_emit_ctx_handlers(ctx))
      pipeline_ir_native_emit_term(term, code)
    }
  }
}

fn pipeline_cg_fn_from_ir(fn_wrap: i64, irf: IrFunction, code: i64, fm: i64, src: i64, owner_hash: i64) -> i64 {
  let fn_node = unwrap_fn(fn_wrap)
  let ns = node_f1(fn_node)
  let nl = node_f2(fn_node)
  let params = node_f3(fn_node)
  let old_ret_ty = fmap_get_current_ret_ty(fm)
  let ret_ty = fn_ret_type(fn_wrap)
  fmap_set_current_ret_ty(fm, ret_ty)
  cg_cleanup_restore(fm, 0)
  let fn_off = buf_len(code)
  fmap_update_offset_qualified(fm, src, ns, nl, owner_hash, fn_off)
  emit_prologue(code)
  let nparams = nlist_len(params)
  let scope = cg_fn_params(params, nparams, src, scope_new(), code, fm)
  match irf {
    IrFunction(hash, param_count, blocks) -> {
      match blocks {
        IrBlockListCons(block, rest) -> pipeline_ir_native_emit_block(block, code, scope, src, fm)
        IrBlockListNil -> emit_mov_imm(code, 0, 0)
      }
    }
  }
  emit_epilogue(code)
  fmap_set_current_ret_ty(fm, old_ret_ty)
  0
}

fn pipeline_cg_module_with_ir(fns: i64, ir_functions: IrFunctionList, code: i64, fm: i64) -> i64 {
  let n = nlist_len(fns)
  let mm = __mem_load64(fm + 72)
  let tm = __mem_load64(fm + 80)
  let btm = fmap_borrow_tmap(fm)
  for i in 0..n {
    let pair = nlist_get(fns, i)
    let fn_wrap = node_f1(pair)
    let fn_node = unwrap_fn(fn_wrap)
    let fn_src = node_f2(pair)
    let type_hash = node_f3(pair)
    fmap_add_qualified(fm, fn_src, node_f1(fn_node), node_f2(fn_node), type_hash, 0)
    if type_hash == 0 {
      cg_ftypes_add(fmap_get_cg_ftypes(fm), fn_src, node_f1(fn_node), node_f2(fn_node), fn_ret_type(fn_wrap), node_f3(fn_node), fn_effects(fn_wrap))
    } else { 0 }
    if type_hash != 0 {
      let method_hash = str_hash(fn_src, node_f1(fn_node), node_f2(fn_node))
      mmap_add(mm, type_hash, method_hash, 0, node_f3(fn_node))
    } else { 0 }
    let tparams = fn_tparams(fn_wrap)
    if tparams != 0 {
      let name_hash = str_hash(fn_src, node_f1(fn_node), node_f2(fn_node))
      mono_tmap_add(tm, name_hash, fn_wrap, fn_src)
    } else {
      if type_hash == 0 {
        let name_hash = str_hash(fn_src, node_f1(fn_node), node_f2(fn_node))
        borrow_tmap_add(btm, name_hash, fn_wrap, fn_src, type_hash)
      } else { 0 }
    }
  }
  let mut emitted = 0
  for j in 0..n {
    let pair = nlist_get(fns, j)
    let fn_wrap = node_f1(pair)
    let fn_node = unwrap_fn(fn_wrap)
    let fn_src = node_f2(pair)
    let type_hash = node_f3(pair)
    let name_hash = str_hash(fn_src, node_f1(fn_node), node_f2(fn_node))
    let found = pipeline_ir_function_list_find_hash(ir_functions, name_hash)
    let mut used_ir = 0
    match found {
      IrFunctionNil -> 0
      IrFunctionCons(irf, rest) -> {
        if pipeline_ir_native_function_supported(fn_wrap, irf, fn_src) == 1 {
          pipeline_cg_fn_from_ir(fn_wrap, irf, code, fm, fn_src, type_hash)
          emitted = emitted + 1
          used_ir = 1
        } else { 0 }
      }
    }
    if used_ir == 0 {
      cg_fn(fn_wrap, code, fm, fn_src, type_hash)
    } else { 0 }
    if type_hash != 0 {
      let method_hash = str_hash(fn_src, node_f1(fn_node), node_f2(fn_node))
      let off = fmap_lookup_qualified(fm, fn_src, node_f1(fn_node), node_f2(fn_node), type_hash)
      mmap_update(mm, type_hash, method_hash, off)
    } else { 0 }
  }
  __mem_store64(fm + 176, emitted)
  code
}

fn pipeline_lower_native_module(typed: TypedModule, ir: IrModule) -> NativeModule {
  match typed {
    TypedModule(fns, src, tt) -> {
      let functions = pipeline_ir_functions(ir)
      let code = buf_new(1048576)
      let fm = fmap_new()
      emit_heap_init(code)
      let bl_main_pos = buf_len(code)
      bu32(code, 0)
      bu32(code, encode_ldp_post(29, 30, 31, 16))
      bu32(code, encode_ret())
      fmap_set_tt(fm, tt)
      fmap_set_rc_elision_enabled(fm, cg_rc_elision_enabled_for_fns(fns, src))
      if pipeline_ir_is_optimised(ir) == 1 {
        pipeline_cg_module_with_ir(fns, functions, code, fm)
      } else {
        cg_module(fns, code, fm)
      }
      patch_forward_refs(fm, code)
      let main_off = find_main_in_fmap(fm)
      bytes_set_u32(code, bl_main_pos, encode_bl(main_off - bl_main_pos))
      NativeModule(code, fm, functions)
    }
  }
}

fn pipeline_lower_native_ir(typed: TypedModule) -> NativeModule {
  let ir = pipeline_lower_ir(typed)
  pipeline_lower_native_module(typed, ir)
}

fn pipeline_empty_binary_for_format(format: BinaryFormat) -> BinaryObject {
  BinaryObject(buf_new(0), binary_format_kind(format))
}

fn pipeline_emit_native_macho_object(format: BinaryFormat, code: i64, fm: i64, src: i64) -> BinaryObject {
  let ngot = __mem_load64(fm + 128)
  let o = compile_object(code, fm, src, ngot)
  BinaryObject(o, binary_format_kind(format))
}

fn pipeline_emit_native_macho_executable(format: BinaryFormat, code: i64) -> BinaryObject {
  let o = emit_macho(code, 0)
  BinaryObject(o, binary_format_kind(format))
}

fn pipeline_emit_native_binary_as(format: BinaryFormat, native: NativeModule, src: i64) -> BinaryObject {
  match native {
    NativeModule(code, fm, functions) -> {
      let backend = binary_format_backend(format)
      match backend {
        BinaryFormatBackendMachOObject -> pipeline_emit_native_macho_object(format, code, fm, src)
        BinaryFormatBackendMachOExecutable -> pipeline_emit_native_macho_executable(format, code)
        BinaryFormatBackendUnsupported -> pipeline_empty_binary_for_format(format)
      }
    }
  }
}

fn pipeline_emit_native_binary(native: NativeModule, src: i64) -> BinaryObject {
  pipeline_emit_native_binary_as(pipeline_native_binary_format(native), native, src)
}

fn pipeline_optimise_ir(ir: IrModule) -> IrModule {
  match ir {
    IrModule(functions) -> OptimisedIrModule(functions, 0, 0, 0)
    OptimisedIrModule(functions, inline_sites, residual_sites, evidence_candidate_sites) -> ir
  }
}

fn pipeline_optimise_typed_ir(typed: TypedModule, ir: IrModule) -> IrModule {
  match typed {
    TypedModule(fns, src, tt) -> {
      let base_functions = pipeline_lower_fns_handler_optimised(fns, tt, src)
      let generic_specs = pipeline_collect_generic_specs_fns(fns, tt, src)
      let functions = pipeline_ir_function_list_append(base_functions, generic_specs)
      let stats = pipeline_handler_inline_stats_add(
        pipeline_handler_inline_fns_stats(fns, src),
        pipeline_handler_inline_stats_from_ir_functions(generic_specs)
      )
      let evidence_candidate_sites = pipeline_handler_evidence_candidate_fns_stats(fns, src)
      OptimisedIrModule(
        functions,
        pipeline_handler_inline_stats_inline_sites(stats),
        pipeline_handler_inline_stats_residual_sites(stats),
        evidence_candidate_sites
      )
    }
  }
}

fn pipeline_emit_native(typed: TypedModule) -> BinaryObject {
  match typed {
    TypedModule(fns, src, tt) -> {
      let ir = pipeline_lower_ir(typed)
      let optimised = pipeline_optimise_typed_ir(typed, ir)
      let native = pipeline_lower_native_module(typed, optimised)
      pipeline_emit_native_binary(native, src)
    }
  }
}

fn pipeline_write_binary(binary: BinaryObject) -> i64 {
  match binary {
    BinaryObject(o, kind) -> {
      sys_write(1, buf_ptr(o), buf_len(o))
      0
    }
  }
}

fn pipeline_compile_native_source(src: i64, n: i64) -> i64 {
  let typed = pipeline_check_source(src, n)
  let binary = pipeline_emit_native(typed)
  pipeline_write_binary(binary)
}
