pub(package) fn pipeline_ir_block_entry_indexed_upper_fact_lookup_chain(facts: PipelineIrBlockEntryFactChain, block_id: i64, index_value: i64, length_key: i64) -> i64 {
  let found = pipeline_ir_block_entry_scalar_fact_lookup_chain(facts, block_id, index_value, pipeline_ir_scalar_fact_kind_indexed_upper())
  if pipeline_ir_const_lookup_valid(found) == 1 and pipeline_ir_const_lookup_value(found) == length_key { 1 } else { 0 }
}

