pub(package) fn pipeline_ir_local_fact_env_kill_len_facts(facts: PipelineIrLocalFactEnv) -> PipelineIrLocalFactEnv {
  pipeline_ir_local_fact_env_full10(pipeline_ir_local_fact_env_call_cse(facts), pipeline_ir_local_fact_env_tag_env(facts), pipeline_ir_local_fact_env_nil_env(facts), pipeline_ir_local_fact_env_load_slots(facts), pipeline_ir_local_fact_env_killed_slots(facts), 1, pipeline_ir_local_fact_env_nonneg(facts), pipeline_ir_local_fact_env_row_upper(facts), pipeline_ir_local_fact_env_bin_cse(facts), 0)
}

pub(package) fn pipeline_ir_local_fact_env_with_call_cse(facts: PipelineIrLocalFactEnv, call_cse: PipelineIrCallCseEnv) -> PipelineIrLocalFactEnv {
  pipeline_ir_local_fact_env_full10(call_cse, pipeline_ir_local_fact_env_tag_env(facts), pipeline_ir_local_fact_env_nil_env(facts), pipeline_ir_local_fact_env_load_slots(facts), pipeline_ir_local_fact_env_killed_slots(facts), pipeline_ir_local_fact_env_len_killed(facts), pipeline_ir_local_fact_env_nonneg(facts), pipeline_ir_local_fact_env_row_upper(facts), pipeline_ir_local_fact_env_bin_cse(facts), pipeline_ir_local_fact_env_vget_cse(facts))
}

pub(package) fn pipeline_ir_local_fact_env_with_tag_env(facts: PipelineIrLocalFactEnv, tag_env: PipelineIrTagEnv) -> PipelineIrLocalFactEnv {
