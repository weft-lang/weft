-- compiler/pipeline.weft -- Compiler pass boundaries
use "compiler/ir.weft"

-- Transitional compiler-as-data pass results. The payloads are still the
-- existing parser/checker/codegen handles while the public boundary moves
-- toward Ast -> TypedAst -> IrModule -> BinaryObject.
type AstModule {
  AstModule(i64, i64, i64)
}

type TypedModule {
  TypedModule(i64, i64, i64)
}

type IrModule {
  IrModule(i64, i64, IrFunctionList)
}

type BinaryObject {
  BinaryObject(i64)
}

fn pipeline_parse(grammar: WeftGrammar, src: i64, n: i64, tt: i64) -> i64 {
  grammar.parse(src, n, tt)
}

fn pipeline_check(fns: i64, src: i64, tt: i64) -> i64 {
  let ct = build_ctable(tt, src)
  ttable_set_ct(tt, ct)
  handle check_user_fns(fns, src, tt) {
    Conformance.conforms(th, trh) -> resume(ctable_conforms(ct, th, trh))
  }
}

fn pipeline_parse_module(grammar: WeftGrammar, src: i64, n: i64, tt: i64) -> AstModule {
  let fns = pipeline_parse(grammar, src, n, tt)
  AstModule(fns, src, tt)
}

fn pipeline_check_fns(fns: i64, src: i64, tt: i64) -> TypedModule {
  pipeline_check(fns, src, tt)
  TypedModule(fns, src, tt)
}

fn pipeline_check_module(ast: AstModule) -> TypedModule {
  match ast {
    AstModule(fns, src, tt) -> pipeline_check_fns(fns, src, tt)
  }
}

fn pipeline_ast_fns(ast: AstModule) -> i64 {
  match ast {
    AstModule(fns, src, tt) -> fns
  }
}

fn pipeline_typed_fns(typed: TypedModule) -> i64 {
  match typed {
    TypedModule(fns, src, tt) -> fns
  }
}

fn pipeline_ir_result(code: i64, fm: i64) -> IrModule {
  IrModule(code, fm, ir_function_list_empty())
}

fn pipeline_ir_result_with_functions(code: i64, fm: i64, functions: IrFunctionList) -> IrModule {
  IrModule(code, fm, functions)
}

fn pipeline_binary_object(o: i64) -> BinaryObject {
  BinaryObject(o)
}

fn pipeline_ir_code(ir: IrModule) -> i64 {
  match ir {
    IrModule(code, fm, functions) -> code
  }
}

fn pipeline_ir_fmap(ir: IrModule) -> i64 {
  match ir {
    IrModule(code, fm, functions) -> fm
  }
}

fn pipeline_ir_functions(ir: IrModule) -> IrFunctionList {
  match ir {
    IrModule(code, fm, functions) -> functions
  }
}

fn pipeline_ir_function_count(ir: IrModule) -> i64 {
  ir_function_list_len(pipeline_ir_functions(ir))
}

fn pipeline_ir_inst_count(ir: IrModule) -> i64 {
  ir_function_list_inst_count(pipeline_ir_functions(ir))
}

fn pipeline_binary_buf(binary: BinaryObject) -> i64 {
  match binary {
    BinaryObject(o) -> o
  }
}

fn pipeline_parse_source(src: i64, n: i64) -> AstModule {
  let grammar = weft_grammar()
  let tt = ttable_new()
  pipeline_parse_module(grammar, src, n, tt)
}

fn pipeline_check_source(src: i64, n: i64) -> TypedModule {
  let ast = pipeline_parse_source(src, n)
  pipeline_check_module(ast)
}

fn pipeline_lower_ir(typed: TypedModule) -> IrModule {
  match typed {
    TypedModule(fns, src, tt) -> {
      let code = buf_new(1048576)
      let fm = fmap_new()
      emit_heap_init(code)
      let bl_main_pos = buf_len(code)
      bu32(code, 0)
      bu32(code, encode_ldp_post(29, 30, 31, 16))
      bu32(code, encode_ret())
      fmap_set_tt(fm, tt)
      cg_module(fns, code, fm)
      patch_forward_refs(fm, code)
      let main_off = find_main_in_fmap(fm)
      bytes_set_u32(code, bl_main_pos, encode_bl(main_off - bl_main_pos))
      IrModule(code, fm, ir_function_list_empty())
    }
  }
}

fn pipeline_emit_binary(ir: IrModule, src: i64) -> BinaryObject {
  match ir {
    IrModule(code, fm, functions) -> {
      let ngot = __mem_load64(fm + 128)
      if ngot > 0 {
        let o = compile_object(code, fm, src, ngot)
        BinaryObject(o)
      } else {
        let o = emit_macho(code, 0)
        BinaryObject(o)
      }
    }
  }
}

fn pipeline_optimise_ir(ir: IrModule) -> IrModule {
  ir
}

fn pipeline_emit_native(typed: TypedModule) -> BinaryObject {
  match typed {
    TypedModule(fns, src, tt) -> {
      let ir = pipeline_lower_ir(typed)
      let optimised = pipeline_optimise_ir(ir)
      pipeline_emit_binary(optimised, src)
    }
  }
}

fn pipeline_write_binary(binary: BinaryObject) -> i64 {
  match binary {
    BinaryObject(o) -> {
      sys_write(1, buf_ptr(o), buf_len(o))
      0
    }
  }
}

fn pipeline_compile_native_source(src: i64, n: i64) -> i64 {
  let typed = pipeline_check_source(src, n)
  let binary = pipeline_emit_native(typed)
  pipeline_write_binary(binary)
}
