fn pipeline_lower_expr_sidecar(expr: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, next_value: i64) -> IrLoweredExpr {
  let tag = node_tag(expr)
  match tag {
    1 -> ir_lowered_expr(
      next_value,
      next_value + 1,
      ir_inst_list_prepend(ir_inst_const_i64(next_value, node_f1(expr)), ir_inst_list_empty())
    )
    24 -> ir_lowered_expr(
      next_value,
      next_value + 1,
      ir_inst_list_prepend(ir_inst_const_i64(next_value, node_f1(expr)), ir_inst_list_empty())
    )
    51 -> ir_lowered_expr(
      next_value,
      next_value + 1,
      ir_inst_list_prepend(ir_inst_const_i64(next_value, 0), ir_inst_list_empty())
    )
    9 -> ir_lowered_expr(
      next_value,
      next_value + 1,
      ir_inst_list_prepend(ir_inst_string_lit(next_value, node_f1(expr), node_f2(expr)), ir_inst_list_empty())
    )
    29 -> ir_lowered_expr(
      next_value,
      next_value + 1,
      ir_inst_list_prepend(ir_inst_lambda_i64(next_value, node_f1(expr), node_f2(expr), node_f3(expr)), ir_inst_list_empty())
    )
    2 -> {
      let local_id = pipeline_value_env_lookup(locals, src, node_f1(expr), node_f2(expr))
      if local_id >= 0 {
        if pipeline_value_env_lookup_kind(locals, src, node_f1(expr), node_f2(expr)) == 1 {
          ir_lowered_expr(
            next_value,
            next_value + 1,
            ir_inst_list_prepend(ir_inst_load_i64(next_value, local_id), ir_inst_list_empty())
          )
        } else {
          ir_lowered_expr(local_id, next_value, ir_inst_list_empty())
        }
      } else {
        let param_id = pipeline_param_index(params, src, node_f1(expr), node_f2(expr))
        if param_id >= 0 {
          ir_lowered_expr(param_id, next_value, ir_inst_list_empty())
        } else {
          let tag_hash = pipeline_variant_tag_hash(tt, src, node_f1(expr), node_f2(expr))
          let payload_count = pipeline_variant_payload_count(tt, src, node_f1(expr), node_f2(expr))
          if tag_hash >= 0 {
            if payload_count == 0 {
              ir_lowered_expr(
                next_value,
                next_value + 1,
                ir_inst_list_prepend(ir_inst_variant_init_i64(next_value, tag_hash, ir_value_list_empty()), ir_inst_list_empty())
              )
            } else {
              ir_lowered_expr_invalid(next_value)
            }
          } else {
            ir_lowered_expr_invalid(next_value)
          }
        }
      }
    }
    3 -> pipeline_lower_binop_expr_sidecar(expr, params, locals, src, tt, next_value)
    22 -> pipeline_lower_not_expr_sidecar(expr, params, locals, src, tt, next_value)
    46 -> pipeline_lower_interp_concat_expr_sidecar(expr, params, locals, src, tt, next_value)
    4 -> pipeline_lower_call_expr_sidecar(expr, params, locals, src, tt, next_value)
    32 -> pipeline_lower_perform_expr_sidecar(expr, params, locals, src, tt, next_value)
    33 -> ir_lowered_expr(
      next_value,
      next_value + 1,
      ir_inst_list_prepend(ir_inst_handle_i64(next_value, node_f1(expr), node_f2(expr), node_f3(expr)), ir_inst_list_empty())
    )
    35 -> pipeline_lower_resume_expr_sidecar(expr, params, locals, src, tt, next_value)
    45 -> pipeline_lower_try_expr_sidecar(expr, params, locals, src, tt, next_value)
    36 -> pipeline_lower_generic_call_expr_sidecar(expr, params, locals, src, tt, next_value)
    41 -> pipeline_lower_method_call_expr_sidecar(expr, params, locals, src, tt, next_value)
    13 -> pipeline_lower_field_access_expr_sidecar(expr, params, locals, src, tt, next_value)
    48 -> pipeline_lower_opt_chain_expr_sidecar(expr, params, locals, src, tt, next_value)
    14 -> pipeline_lower_record_init_expr_sidecar(expr, params, locals, src, tt, next_value)
    6 -> pipeline_lower_let_expr_sidecar(expr, params, locals, src, tt, next_value)
    11 -> pipeline_lower_let_mut_expr_sidecar(expr, params, locals, src, tt, next_value)
    12 -> pipeline_lower_assign_expr_sidecar(expr, params, locals, src, tt, next_value)
    7 -> pipeline_lower_block_expr_sidecar(expr, params, locals, src, tt, next_value)
    37 -> pipeline_lower_expr_sidecar(node_f1(expr), params, locals, src, tt, next_value)
    _ -> ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_not_expr_sidecar(expr: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, next_value: i64) -> IrLoweredExpr {
  let value = pipeline_lower_expr_sidecar(node_f1(expr), params, locals, src, tt, next_value)
  if ir_lowered_expr_is_valid(value) == 1 {
    let dst = ir_lowered_expr_next_value(value)
    let unary = ir_inst_list_prepend(
      ir_inst_unary_i64(dst, ir_unary_op_not(), ir_lowered_expr_value(value)),
      ir_inst_list_empty()
    )
    let insts = ir_inst_list_append(ir_lowered_expr_insts(value), unary)
    ir_lowered_expr(dst, dst + 1, insts)
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_binop_expr_sidecar(expr: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, next_value: i64) -> IrLoweredExpr {
  let lhs = pipeline_lower_expr_sidecar(node_f2(expr), params, locals, src, tt, next_value)
  if ir_lowered_expr_is_valid(lhs) == 1 {
    let rhs = pipeline_lower_expr_sidecar(node_f3(expr), params, locals, src, tt, ir_lowered_expr_next_value(lhs))
    if ir_lowered_expr_is_valid(rhs) == 1 {
      let op = ir_binary_op_from_parser(node_f1(expr))
      if ir_binary_op_is_supported(op) == 1 {
        let dst = ir_lowered_expr_next_value(rhs)
        let binary = ir_inst_list_prepend(
          ir_inst_binary_i64(dst, op, ir_lowered_expr_value(lhs), ir_lowered_expr_value(rhs)),
          ir_inst_list_empty()
        )
        let insts = ir_inst_list_append(
          ir_lowered_expr_insts(lhs),
          ir_inst_list_append(ir_lowered_expr_insts(rhs), binary)
        )
        ir_lowered_expr(dst, dst + 1, insts)
      } else {
        ir_lowered_expr_invalid(next_value)
      }
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_interp_concat_expr_sidecar(expr: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, next_value: i64) -> IrLoweredExpr {
  let left = pipeline_lower_expr_sidecar(node_f1(expr), params, locals, src, tt, next_value)
  if ir_lowered_expr_is_valid(left) == 1 {
    let right = pipeline_lower_expr_sidecar(node_f2(expr), params, locals, src, tt, ir_lowered_expr_next_value(left))
    if ir_lowered_expr_is_valid(right) == 1 {
      let dst = ir_lowered_expr_next_value(right)
      let concat = ir_inst_list_prepend(
        ir_inst_string_concat_i64(dst, ir_lowered_expr_value(left), ir_lowered_expr_value(right)),
        ir_inst_list_empty()
      )
      let insts = ir_inst_list_append(
        ir_lowered_expr_insts(left),
        ir_inst_list_append(ir_lowered_expr_insts(right), concat)
      )
      ir_lowered_expr(dst, dst + 1, insts)
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_call_callee_is_direct(params: i64, locals: PipelineValueEnv, src: i64, ns: i64, nl: i64) -> i64 {
  if pipeline_value_env_lookup(locals, src, ns, nl) >= 0 { 0 }
  else { if pipeline_param_index(params, src, ns, nl) >= 0 { 0 }
  else { 1 } }
}

fn pipeline_call_callee_value(params: i64, locals: PipelineValueEnv, src: i64, ns: i64, nl: i64) -> i64 {
  let local = pipeline_value_env_lookup(locals, src, ns, nl)
  if local >= 0 {
    if pipeline_value_env_lookup_kind(locals, src, ns, nl) == 0 { local } else { 0 - 1 }
  } else {
    pipeline_param_index(params, src, ns, nl)
  }
}

fn pipeline_call_callee_slot(locals: PipelineValueEnv, src: i64, ns: i64, nl: i64) -> i64 {
  let local = pipeline_value_env_lookup(locals, src, ns, nl)
  if local >= 0 {
    if pipeline_value_env_lookup_kind(locals, src, ns, nl) == 1 { local } else { 0 - 1 }
  } else {
    0 - 1
  }
}

fn pipeline_variant_tag_hash(tt: i64, src: i64, ns: i64, nl: i64) -> i64 {
  if tt == 0 { 0 - 1 } else { ttable_find_variant(tt, src, ns, nl) }
}

fn pipeline_variant_payload_count(tt: i64, src: i64, ns: i64, nl: i64) -> i64 {
  if tt == 0 { 0 - 1 } else { ttable_variant_payload_count(tt, src, ns, nl) }
}

fn pipeline_direct_call_inst(dst: i64, src: i64, tt: i64, ns: i64, nl: i64, args: IrValueList) -> IrInst {
  let tag_hash = pipeline_variant_tag_hash(tt, src, ns, nl)
  if tag_hash >= 0 {
    ir_inst_variant_init_i64(dst, tag_hash, args)
  } else {
    ir_inst_call_i64(dst, str_hash(src, ns, nl), args)
  }
}

fn pipeline_generic_call_inst(dst: i64, src: i64, tt: i64, ns: i64, nl: i64, type_args: i64, args: IrValueList) -> IrInst {
  let tag_hash = pipeline_variant_tag_hash(tt, src, ns, nl)
  if tag_hash >= 0 {
    ir_inst_variant_init_i64(dst, tag_hash, args)
  } else {
    ir_inst_generic_call_i64(dst, str_hash(src, ns, nl), type_args, args)
  }
}

fn pipeline_generic_call_inst_typed(dst: i64, src: i64, tt: i64, ns: i64, nl: i64, type_args: TypeExprList, args: IrValueList) -> IrInst {
  let tag_hash = pipeline_variant_tag_hash(tt, src, ns, nl)
  if tag_hash >= 0 {
    ir_inst_variant_init_i64(dst, tag_hash, args)
  } else {
    IrGenericCallI64(dst, str_hash(src, ns, nl), type_args, args)
  }
}

fn pipeline_call_inst_resolved(dst: i64, direct: i64, indirect_callee: i64, src: i64, tt: i64, ns: i64, nl: i64, args: IrValueList) -> IrInst {
  if direct == 1 {
    pipeline_direct_call_inst(dst, src, tt, ns, nl, args)
  } else {
    ir_inst_indirect_call_i64(dst, indirect_callee, args)
  }
}

fn pipeline_perform_inst(dst: i64, src: i64, lhs: i64, op_ns: i64, op_nl: i64, args: IrValueList) -> IrInst {
  ir_inst_perform_i64(dst, effect_name_hash(src, node_f1(lhs), node_f2(lhs)), effect_name_hash(src, op_ns, op_nl), args)
}

fn pipeline_lower_call_args_sidecar(args: i64, nargs: i64, index: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, next_value: i64) -> PipelineLoweredArgs {
  if index >= nargs {
    pipeline_lowered_args(ir_value_list_empty(), next_value, ir_inst_list_empty(), 1)
  } else {
    let arg = pipeline_lower_expr_sidecar(nlist_get(args, index), params, locals, src, tt, next_value)
    if ir_lowered_expr_is_valid(arg) == 1 {
      let rest = pipeline_lower_call_args_sidecar(args, nargs, index + 1, params, locals, src, tt, ir_lowered_expr_next_value(arg))
      if pipeline_lowered_args_is_valid(rest) == 1 {
        let values = ir_value_list_prepend(ir_lowered_expr_value(arg), pipeline_lowered_args_values(rest))
        let insts = ir_inst_list_append(ir_lowered_expr_insts(arg), pipeline_lowered_args_insts(rest))
        pipeline_lowered_args(values, pipeline_lowered_args_next_value(rest), insts, 1)
      } else {
        pipeline_lowered_args_invalid(next_value)
      }
    } else {
      pipeline_lowered_args_invalid(next_value)
    }
  }
}

fn pipeline_lower_call_expr_sidecar(expr: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, next_value: i64) -> IrLoweredExpr {
  let direct = pipeline_call_callee_is_direct(params, locals, src, node_f1(expr), node_f2(expr))
  let callee_value = pipeline_call_callee_value(params, locals, src, node_f1(expr), node_f2(expr))
  let callee_slot = pipeline_call_callee_slot(locals, src, node_f1(expr), node_f2(expr))
  if direct == 1 or callee_value >= 0 or callee_slot >= 0 {
    let arg_start_value = if callee_slot >= 0 { next_value + 1 } else { next_value }
    let args = pipeline_lower_call_args_sidecar(node_f3(expr), node_f4(expr), 0, params, locals, src, tt, arg_start_value)
    if pipeline_lowered_args_is_valid(args) == 1 {
      let dst = pipeline_lowered_args_next_value(args)
      let indirect_callee = if callee_slot >= 0 { next_value } else { callee_value }
      let callee_insts = if callee_slot >= 0 {
        ir_inst_list_prepend(ir_inst_load_i64(next_value, callee_slot), ir_inst_list_empty())
      } else { ir_inst_list_empty() }
      let call = ir_inst_list_prepend(
        pipeline_call_inst_resolved(dst, direct, indirect_callee, src, tt, node_f1(expr), node_f2(expr), pipeline_lowered_args_values(args)),
        ir_inst_list_empty()
      )
      let insts = ir_inst_list_append(callee_insts, ir_inst_list_append(pipeline_lowered_args_insts(args), call))
      ir_lowered_expr(dst, dst + 1, insts)
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_perform_expr_sidecar(expr: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, next_value: i64) -> IrLoweredExpr {
  let lhs = node_f1(expr)
  if node_tag(lhs) == 2 {
    let args_node = node_f4(expr)
    let args = pipeline_lower_call_args_sidecar(args_node, nlist_len(args_node), 0, params, locals, src, tt, next_value)
    if pipeline_lowered_args_is_valid(args) == 1 {
      let dst = pipeline_lowered_args_next_value(args)
      let perform = ir_inst_list_prepend(
        pipeline_perform_inst(dst, src, lhs, node_f2(expr), node_f3(expr), pipeline_lowered_args_values(args)),
        ir_inst_list_empty()
      )
      let insts = ir_inst_list_append(pipeline_lowered_args_insts(args), perform)
      ir_lowered_expr(dst, dst + 1, insts)
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_resume_expr_sidecar(expr: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, next_value: i64) -> IrLoweredExpr {
  let value = pipeline_lower_expr_sidecar(node_f1(expr), params, locals, src, tt, next_value)
  if ir_lowered_expr_is_valid(value) == 1 {
    let dst = ir_lowered_expr_next_value(value)
    let resume_inst = ir_inst_list_prepend(ir_inst_resume_i64(dst, ir_lowered_expr_value(value)), ir_inst_list_empty())
    let insts = ir_inst_list_append(ir_lowered_expr_insts(value), resume_inst)
    ir_lowered_expr(dst, dst + 1, insts)
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_try_expr_sidecar(expr: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, next_value: i64) -> IrLoweredExpr {
  let value = pipeline_lower_expr_sidecar(node_f1(expr), params, locals, src, tt, next_value)
  if ir_lowered_expr_is_valid(value) == 1 {
    let dst = ir_lowered_expr_next_value(value)
    let try_inst = ir_inst_list_prepend(
      ir_inst_try_i64(dst, ir_lowered_expr_value(value)),
      ir_inst_list_empty()
    )
    ir_lowered_expr(dst, dst + 1, ir_inst_list_append(ir_lowered_expr_insts(value), try_inst))
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_generic_call_expr_sidecar(expr: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, next_value: i64) -> IrLoweredExpr {
  let call_node = node_f2(expr)
  if pipeline_call_callee_is_direct(params, locals, src, node_f1(call_node), node_f2(call_node)) == 1 {
    let args = pipeline_lower_call_args_sidecar(node_f3(call_node), node_f4(call_node), 0, params, locals, src, tt, next_value)
    if pipeline_lowered_args_is_valid(args) == 1 {
      let dst = pipeline_lowered_args_next_value(args)
      let call = ir_inst_list_prepend(
        pipeline_generic_call_inst(dst, src, tt, node_f1(call_node), node_f2(call_node), node_f1(expr), pipeline_lowered_args_values(args)),
        ir_inst_list_empty()
      )
      let insts = ir_inst_list_append(pipeline_lowered_args_insts(args), call)
      ir_lowered_expr(dst, dst + 1, insts)
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_method_call_expr_sidecar(expr: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, next_value: i64) -> IrLoweredExpr {
  let receiver = pipeline_lower_expr_sidecar(node_f1(expr), params, locals, src, tt, next_value)
  if ir_lowered_expr_is_valid(receiver) == 1 {
    let args_node = node_f3(expr)
    let args = pipeline_lower_call_args_sidecar(args_node, nlist_len(args_node), 0, params, locals, src, tt, ir_lowered_expr_next_value(receiver))
    if pipeline_lowered_args_is_valid(args) == 1 {
      let dst = pipeline_lowered_args_next_value(args)
      let call = ir_inst_list_prepend(
        ir_inst_method_call_i64(dst, node_f4(expr), node_f2(expr), ir_lowered_expr_value(receiver), pipeline_lowered_args_values(args)),
        ir_inst_list_empty()
      )
      let insts = ir_inst_list_append(
        ir_lowered_expr_insts(receiver),
        ir_inst_list_append(pipeline_lowered_args_insts(args), call)
      )
      ir_lowered_expr(dst, dst + 1, insts)
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_record_fields_sidecar(fields: i64, nfields: i64, index: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, next_value: i64) -> PipelineLoweredRecordFields {
  if index >= nfields {
    pipeline_lowered_record_fields(ir_record_field_list_empty(), next_value, ir_inst_list_empty(), 1)
  } else {
    let field = nlist_get(fields, index)
    let value = pipeline_lower_expr_sidecar(node_f3(field), params, locals, src, tt, next_value)
    if ir_lowered_expr_is_valid(value) == 1 {
      let rest = pipeline_lower_record_fields_sidecar(fields, nfields, index + 1, params, locals, src, tt, ir_lowered_expr_next_value(value))
      if pipeline_lowered_record_fields_is_valid(rest) == 1 {
        let field_hash = str_hash(src, node_f1(field), node_f2(field))
        let values = ir_record_field_list_prepend(field_hash, ir_lowered_expr_value(value), pipeline_lowered_record_fields_values(rest))
        let insts = ir_inst_list_append(ir_lowered_expr_insts(value), pipeline_lowered_record_fields_insts(rest))
        pipeline_lowered_record_fields(values, pipeline_lowered_record_fields_next_value(rest), insts, 1)
      } else {
        pipeline_lowered_record_fields_invalid(next_value)
      }
    } else {
      pipeline_lowered_record_fields_invalid(next_value)
    }
  }
}

fn pipeline_lower_record_init_expr_sidecar(expr: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, next_value: i64) -> IrLoweredExpr {
  let fields = pipeline_lower_record_fields_sidecar(node_f3(expr), node_f4(expr), 0, params, locals, src, tt, next_value)
  if pipeline_lowered_record_fields_is_valid(fields) == 1 {
    let dst = pipeline_lowered_record_fields_next_value(fields)
    let record = ir_inst_list_prepend(
      ir_inst_record_init_i64(dst, str_hash(src, node_f1(expr), node_f2(expr)), pipeline_lowered_record_fields_values(fields)),
      ir_inst_list_empty()
    )
    let insts = ir_inst_list_append(pipeline_lowered_record_fields_insts(fields), record)
    ir_lowered_expr(dst, dst + 1, insts)
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_field_access_index(expr: i64) -> i64 {
  if node_f4(expr) > 0 { node_f4(expr) - 1 } else { 0 - 1 }
}

fn pipeline_lower_field_access_expr_sidecar(expr: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, next_value: i64) -> IrLoweredExpr {
  let base = pipeline_lower_expr_sidecar(node_f1(expr), params, locals, src, tt, next_value)
  if ir_lowered_expr_is_valid(base) == 1 {
    let dst = ir_lowered_expr_next_value(base)
    let field = ir_inst_list_prepend(
      ir_inst_field_load_i64(dst, ir_lowered_expr_value(base), str_hash(src, node_f2(expr), node_f3(expr)), pipeline_field_access_index(expr)),
      ir_inst_list_empty()
    )
    let insts = ir_inst_list_append(ir_lowered_expr_insts(base), field)
    ir_lowered_expr(dst, dst + 1, insts)
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_opt_chain_field_index(expr: i64, src: i64, tt: i64) -> i64 {
  if tt == 0 { 0 - 1 } else { ttable_find_any_field(tt, src, node_f2(expr), node_f3(expr)) }
}

fn pipeline_lower_opt_chain_expr_sidecar(expr: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, next_value: i64) -> IrLoweredExpr {
  let base = pipeline_lower_expr_sidecar(node_f1(expr), params, locals, src, tt, next_value)
  if ir_lowered_expr_is_valid(base) == 1 {
    let dst = ir_lowered_expr_next_value(base)
    let opt = ir_inst_list_prepend(
      ir_inst_opt_chain_i64(dst, ir_lowered_expr_value(base), str_hash(src, node_f2(expr), node_f3(expr)), pipeline_opt_chain_field_index(expr, src, tt)),
      ir_inst_list_empty()
    )
    let insts = ir_inst_list_append(ir_lowered_expr_insts(base), opt)
    ir_lowered_expr(dst, dst + 1, insts)
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_block_expr_sidecar(expr: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, next_value: i64) -> IrLoweredExpr {
  let first = pipeline_lower_expr_sidecar(node_f1(expr), params, locals, src, tt, next_value)
  if ir_lowered_expr_is_valid(first) == 1 {
    let rest_node = node_f2(expr)
    if rest_node == 0 {
      first
    } else {
      let rest = pipeline_lower_expr_sidecar(rest_node, params, locals, src, tt, ir_lowered_expr_next_value(first))
      if ir_lowered_expr_is_valid(rest) == 1 {
        let insts = ir_inst_list_append(ir_lowered_expr_insts(first), ir_lowered_expr_insts(rest))
        ir_lowered_expr(ir_lowered_expr_value(rest), ir_lowered_expr_next_value(rest), insts)
      } else {
        ir_lowered_expr_invalid(next_value)
      }
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_let_expr_sidecar(expr: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, next_value: i64) -> IrLoweredExpr {
  let value = pipeline_lower_expr_sidecar(node_f3(expr), params, locals, src, tt, next_value)
  if ir_lowered_expr_is_valid(value) == 1 {
    let next_locals = pipeline_value_env_push(locals, node_f1(expr), node_f2(expr), ir_lowered_expr_value(value))
    let body = pipeline_lower_expr_sidecar(node_f4(expr), params, next_locals, src, tt, ir_lowered_expr_next_value(value))
    if ir_lowered_expr_is_valid(body) == 1 {
      let insts = ir_inst_list_append(ir_lowered_expr_insts(value), ir_lowered_expr_insts(body))
      ir_lowered_expr(ir_lowered_expr_value(body), ir_lowered_expr_next_value(body), insts)
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_let_mut_expr_sidecar(expr: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, next_value: i64) -> IrLoweredExpr {
  let value = pipeline_lower_expr_sidecar(node_f3(expr), params, locals, src, tt, next_value)
  if ir_lowered_expr_is_valid(value) == 1 {
    let slot = ir_lowered_expr_next_value(value)
    let slot_insts = ir_inst_list_prepend(
      ir_inst_slot_i64(slot),
      ir_inst_list_prepend(ir_inst_store_i64(slot, ir_lowered_expr_value(value)), ir_inst_list_empty())
    )
    let next_locals = pipeline_value_env_push_slot(locals, node_f1(expr), node_f2(expr), slot)
    let body = pipeline_lower_expr_sidecar(node_f4(expr), params, next_locals, src, tt, slot + 1)
    if ir_lowered_expr_is_valid(body) == 1 {
      let insts = ir_inst_list_append(
        ir_lowered_expr_insts(value),
        ir_inst_list_append(slot_insts, ir_lowered_expr_insts(body))
      )
      ir_lowered_expr(ir_lowered_expr_value(body), ir_lowered_expr_next_value(body), insts)
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_assign_expr_sidecar(expr: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, next_value: i64) -> IrLoweredExpr {
  let slot = pipeline_value_env_lookup(locals, src, node_f1(expr), node_f2(expr))
  if slot >= 0 {
    if pipeline_value_env_lookup_kind(locals, src, node_f1(expr), node_f2(expr)) == 1 {
      let value = pipeline_lower_expr_sidecar(node_f3(expr), params, locals, src, tt, next_value)
      if ir_lowered_expr_is_valid(value) == 1 {
        let nil_value = ir_lowered_expr_next_value(value)
        let assign_insts = ir_inst_list_prepend(
          ir_inst_store_i64(slot, ir_lowered_expr_value(value)),
          ir_inst_list_prepend(ir_inst_const_i64(nil_value, 0), ir_inst_list_empty())
        )
        let insts = ir_inst_list_append(ir_lowered_expr_insts(value), assign_insts)
        ir_lowered_expr(nil_value, nil_value + 1, insts)
      } else {
        ir_lowered_expr_invalid(next_value)
      }
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_match_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let scrutinee_expr = node_f1(expr)
  let arms = node_f2(expr)
  let n_arms = node_f3(expr)
  if n_arms <= 0 {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  } else {
    if pipeline_expr_needs_cfg(scrutinee_expr) == 1 {
      let scrutinee_merge_block = next_block
      let scrutinee_blocks = pipeline_lower_expr_to_target_blocks_reserved(scrutinee_expr, params, locals, module, next_value, start_block, next_block + 1, scrutinee_merge_block)
      if pipeline_lowered_blocks_is_valid(scrutinee_blocks) == 1 {
        if pipeline_lowered_blocks_falls_through(scrutinee_blocks) == 0 {
          scrutinee_blocks
        } else {
          let scrutinee_value = pipeline_lowered_blocks_next_value(scrutinee_blocks)
          let first_arm = pipeline_lowered_blocks_next_block(scrutinee_blocks)
          let ctx = PipelineMatchCtx(arms, n_arms, scrutinee_value, params, locals, module, target_block)
          let arm_blocks = pipeline_lower_match_arm_to_blocks(ctx, 0, scrutinee_value + 1, first_arm, first_arm + 1)
          if pipeline_lowered_blocks_is_valid(arm_blocks) == 1 {
            let scrutinee_params = ir_value_list_prepend(scrutinee_value, ir_value_list_empty())
            let scrutinee_merge = ir_block_new_params(scrutinee_merge_block, scrutinee_params, ir_inst_list_empty(), ir_term_jump(first_arm))
            let blocks = ir_block_list_append(
              pipeline_lowered_blocks_blocks(scrutinee_blocks),
              ir_block_list_prepend(scrutinee_merge, pipeline_lowered_blocks_blocks(arm_blocks))
            )
            pipeline_lowered_blocks_control(
              pipeline_lowered_blocks_next_block(arm_blocks),
              pipeline_lowered_blocks_next_value(arm_blocks),
              blocks,
              1,
              pipeline_lowered_blocks_falls_through(arm_blocks)
            )
          } else {
            pipeline_lowered_blocks_invalid(start_block, next_value)
          }
        }
      } else {
        pipeline_lowered_blocks_invalid(start_block, next_value)
      }
    } else {
      let scrutinee = pipeline_lower_expr_sidecar(scrutinee_expr, params, locals, src, tt, next_value)
      if ir_lowered_expr_is_valid(scrutinee) == 1 {
        let first_arm = next_block
        let ctx = PipelineMatchCtx(arms, n_arms, ir_lowered_expr_value(scrutinee), params, locals, module, target_block)
        let arm_blocks = pipeline_lower_match_arm_to_blocks(ctx, 0, ir_lowered_expr_next_value(scrutinee), first_arm, first_arm + 1)
        if pipeline_lowered_blocks_is_valid(arm_blocks) == 1 {
          let entry = ir_block_new_term(start_block, ir_lowered_expr_insts(scrutinee), ir_term_jump(first_arm))
          let blocks = ir_block_list_prepend(entry, pipeline_lowered_blocks_blocks(arm_blocks))
          pipeline_lowered_blocks(pipeline_lowered_blocks_next_block(arm_blocks), pipeline_lowered_blocks_next_value(arm_blocks), blocks, 1)
        } else {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        }
      } else {
        pipeline_lowered_blocks_invalid(start_block, next_value)
      }
    }
  }
}

fn pipeline_call_args_have_cfg(args: i64, nargs: i64, index: i64) -> i64 {
  if index >= nargs {
    0
  } else {
    if pipeline_expr_needs_cfg(nlist_get(args, index)) == 1 {
      1
    } else {
      pipeline_call_args_have_cfg(args, nargs, index + 1)
    }
  }
}

fn pipeline_record_fields_have_cfg(fields: i64, nfields: i64, index: i64) -> i64 {
  if index >= nfields {
    0
  } else {
    let field = nlist_get(fields, index)
    if pipeline_expr_needs_cfg(node_f3(field)) == 1 {
      1
    } else {
      pipeline_record_fields_have_cfg(fields, nfields, index + 1)
    }
  }
}

fn pipeline_expr_needs_cfg(expr: i64) -> i64 {
  let tag = node_tag(expr)
  match tag {
    5 -> 1
    15 -> 1
    25 -> 1
    26 -> 1
    27 -> 1
    10 -> 1
    47 -> 1
    49 -> 1
    3 -> if pipeline_expr_needs_cfg(node_f2(expr)) == 1 { 1 } else { pipeline_expr_needs_cfg(node_f3(expr)) }
    22 -> pipeline_expr_needs_cfg(node_f1(expr))
    45 -> pipeline_expr_needs_cfg(node_f1(expr))
    46 -> if pipeline_expr_needs_cfg(node_f1(expr)) == 1 { 1 } else { pipeline_expr_needs_cfg(node_f2(expr)) }
    4 -> pipeline_call_args_have_cfg(node_f3(expr), node_f4(expr), 0)
    32 -> {
      let args_node = node_f4(expr)
      pipeline_call_args_have_cfg(args_node, nlist_len(args_node), 0)
    }
    36 -> {
      let call_node = node_f2(expr)
      pipeline_call_args_have_cfg(node_f3(call_node), node_f4(call_node), 0)
    }
    41 -> {
      let args_node = node_f3(expr)
      if pipeline_expr_needs_cfg(node_f1(expr)) == 1 { 1 } else { pipeline_call_args_have_cfg(args_node, nlist_len(args_node), 0) }
    }
    13 -> pipeline_expr_needs_cfg(node_f1(expr))
    48 -> pipeline_expr_needs_cfg(node_f1(expr))
    14 -> pipeline_record_fields_have_cfg(node_f3(expr), node_f4(expr), 0)
    6 -> if pipeline_expr_needs_cfg(node_f3(expr)) == 1 { 1 } else { pipeline_expr_needs_cfg(node_f4(expr)) }
    11 -> if pipeline_expr_needs_cfg(node_f3(expr)) == 1 { 1 } else { pipeline_expr_needs_cfg(node_f4(expr)) }
    12 -> pipeline_expr_needs_cfg(node_f3(expr))
    7 -> {
      let rest_node = node_f2(expr)
      if pipeline_expr_needs_cfg(node_f1(expr)) == 1 {
        1
      } else {
        if rest_node == 0 { 0 } else { pipeline_expr_needs_cfg(rest_node) }
      }
    }
    37 -> pipeline_expr_needs_cfg(node_f1(expr))
    _ -> 0
  }
}

fn pipeline_lower_straight_expr_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let lowered = pipeline_lower_expr_sidecar(expr, params, locals, src, tt, next_value)
  if ir_lowered_expr_is_valid(lowered) == 1 {
    let args = ir_value_list_prepend(ir_lowered_expr_value(lowered), ir_value_list_empty())
    let block = ir_block_new_term(start_block, ir_lowered_expr_insts(lowered), ir_term_jump_args(target_block, args))
    let blocks = ir_block_list_prepend(block, ir_block_list_empty())
    pipeline_lowered_blocks(next_block, ir_lowered_expr_next_value(lowered), blocks, 1)
  } else {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  }
}

fn pipeline_lower_expr_to_target_blocks_reserved(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let tag = node_tag(expr)
  match tag {
    5 -> pipeline_lower_if_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
    15 -> pipeline_lower_match_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
    25 -> pipeline_lower_return_to_blocks(expr, params, locals, src, tt, next_value, start_block, next_block)
    10 -> pipeline_lower_while_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
    47 -> pipeline_lower_for_iter_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
    49 -> pipeline_lower_loop_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
    3 -> {
      if pipeline_expr_needs_cfg(expr) == 1 {
        pipeline_lower_binop_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      } else {
        pipeline_lower_straight_expr_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      }
    }
    22 -> {
      if pipeline_expr_needs_cfg(expr) == 1 {
        pipeline_lower_not_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      } else {
        pipeline_lower_straight_expr_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      }
    }
    45 -> {
      if pipeline_expr_needs_cfg(expr) == 1 {
        pipeline_lower_try_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      } else {
        pipeline_lower_straight_expr_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      }
    }
    4 -> {
      if pipeline_call_args_have_cfg(node_f3(expr), node_f4(expr), 0) == 1 {
        pipeline_lower_call_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      } else {
        pipeline_lower_straight_expr_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      }
    }
    32 -> {
      if pipeline_expr_needs_cfg(expr) == 1 {
        pipeline_lower_perform_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      } else {
        pipeline_lower_straight_expr_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      }
    }
    36 -> {
      if pipeline_expr_needs_cfg(expr) == 1 {
        pipeline_lower_generic_call_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      } else {
        pipeline_lower_straight_expr_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      }
    }
    41 -> {
      if pipeline_expr_needs_cfg(expr) == 1 {
        pipeline_lower_method_call_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      } else {
        pipeline_lower_straight_expr_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      }
    }
    13 -> {
      if pipeline_expr_needs_cfg(expr) == 1 {
        pipeline_lower_field_access_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      } else {
        pipeline_lower_straight_expr_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      }
    }
    48 -> {
      if pipeline_expr_needs_cfg(expr) == 1 {
        pipeline_lower_opt_chain_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      } else {
        pipeline_lower_straight_expr_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      }
    }
    14 -> {
      if pipeline_expr_needs_cfg(expr) == 1 {
        pipeline_lower_record_init_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      } else {
        pipeline_lower_straight_expr_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      }
    }
    6 -> {
      if pipeline_expr_needs_cfg(expr) == 1 {
        pipeline_lower_let_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      } else {
        pipeline_lower_straight_expr_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      }
    }
    11 -> {
      if pipeline_expr_needs_cfg(expr) == 1 {
        pipeline_lower_let_mut_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      } else {
        pipeline_lower_straight_expr_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      }
    }
    12 -> {
      if pipeline_expr_needs_cfg(expr) == 1 {
        pipeline_lower_assign_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      } else {
        pipeline_lower_straight_expr_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      }
    }
    7 -> {
      if pipeline_expr_needs_cfg(expr) == 1 {
        pipeline_lower_block_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      } else {
        pipeline_lower_straight_expr_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      }
    }
    37 -> pipeline_lower_expr_to_target_blocks_reserved(node_f1(expr), params, locals, module, next_value, start_block, next_block, target_block)
    _ -> pipeline_lower_straight_expr_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
  }
}

fn pipeline_lower_expr_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, next_value: i64, start_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let next_block = if target_block == start_block + 1 { start_block + 2 } else { start_block + 1 }
  let module = pipeline_lower_module(src, tt)
  pipeline_lower_expr_to_target_blocks_reserved(expr, params, locals, module, next_value, start_block, next_block, target_block)
}

fn pipeline_lower_return_to_blocks(expr: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, next_value: i64, start_block: i64, next_block: i64) -> PipelineLoweredBlocks {
  let value_expr = node_f1(expr)
  let module = pipeline_lower_module(src, tt)
  if pipeline_expr_needs_cfg(value_expr) == 1 {
    let return_block = next_block
    let value_blocks = pipeline_lower_expr_to_target_blocks_reserved(value_expr, params, locals, module, next_value, start_block, next_block + 1, return_block)
    if pipeline_lowered_blocks_is_valid(value_blocks) == 1 {
      if pipeline_lowered_blocks_falls_through(value_blocks) == 0 {
        value_blocks
      } else {
        let return_value = pipeline_lowered_blocks_next_value(value_blocks)
        let return_params = ir_value_list_prepend(return_value, ir_value_list_empty())
        let return_node = ir_block_new_params(return_block, return_params, ir_inst_list_empty(), ir_term_return(return_value))
        let blocks = ir_block_list_append(
          pipeline_lowered_blocks_blocks(value_blocks),
          ir_block_list_prepend(return_node, ir_block_list_empty())
        )
        pipeline_lowered_blocks_control(pipeline_lowered_blocks_next_block(value_blocks), return_value + 1, blocks, 1, 0)
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  } else {
    let value = pipeline_lower_expr_sidecar(value_expr, params, locals, src, tt, next_value)
    if ir_lowered_expr_is_valid(value) == 1 {
      let block = ir_block_new_term(start_block, ir_lowered_expr_insts(value), ir_term_return(ir_lowered_expr_value(value)))
      let blocks = ir_block_list_prepend(block, ir_block_list_empty())
      pipeline_lowered_blocks_control(next_block, ir_lowered_expr_next_value(value), blocks, 1, 0)
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  }
}

fn pipeline_lower_break_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredLoopBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let value_expr = node_f1(expr)
  if value_expr == 0 {
    let value = next_value
    let insts = ir_inst_list_prepend(ir_inst_const_i64(value, 0), ir_inst_list_empty())
    let args = ir_value_list_prepend(value, ir_value_list_empty())
    let block = ir_block_new_term(start_block, insts, ir_term_jump_args(target_block, args))
    let blocks = ir_block_list_prepend(block, ir_block_list_empty())
    pipeline_lowered_loop_blocks(next_block, value + 1, blocks, 1, 1, 0)
  } else {
    if pipeline_expr_needs_cfg(value_expr) == 1 {
      let break_block = next_block
      let value_blocks = pipeline_lower_expr_to_target_blocks_reserved(value_expr, params, locals, module, next_value, start_block, next_block + 1, break_block)
      if pipeline_lowered_blocks_is_valid(value_blocks) == 1 {
        if pipeline_lowered_blocks_falls_through(value_blocks) == 0 {
          pipeline_lowered_loop_blocks_from_expr(value_blocks, 0, 0)
        } else {
          let exit_value = pipeline_lowered_blocks_next_value(value_blocks)
          let exit_params = ir_value_list_prepend(exit_value, ir_value_list_empty())
          let exit_args = ir_value_list_prepend(exit_value, ir_value_list_empty())
          let exit_node = ir_block_new_params(break_block, exit_params, ir_inst_list_empty(), ir_term_jump_args(target_block, exit_args))
          let blocks = ir_block_list_append(
            pipeline_lowered_blocks_blocks(value_blocks),
            ir_block_list_prepend(exit_node, ir_block_list_empty())
          )
          pipeline_lowered_loop_blocks(pipeline_lowered_blocks_next_block(value_blocks), exit_value + 1, blocks, 1, 1, 0)
        }
      } else {
        pipeline_lowered_loop_blocks_invalid(start_block, next_value)
      }
    } else {
      let value = pipeline_lower_expr_sidecar(value_expr, params, locals, src, tt, next_value)
      if ir_lowered_expr_is_valid(value) == 1 {
        let args = ir_value_list_prepend(ir_lowered_expr_value(value), ir_value_list_empty())
        let block = ir_block_new_term(start_block, ir_lowered_expr_insts(value), ir_term_jump_args(target_block, args))
        let blocks = ir_block_list_prepend(block, ir_block_list_empty())
        pipeline_lowered_loop_blocks(next_block, ir_lowered_expr_next_value(value), blocks, 1, 1, 0)
      } else {
        pipeline_lowered_loop_blocks_invalid(start_block, next_value)
      }
    }
  }
}

fn pipeline_lower_nil_break_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredLoopBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let value_expr = node_f1(expr)
  if value_expr == 0 {
    let nil_value = next_value
    let insts = ir_inst_list_prepend(ir_inst_const_i64(nil_value, 0), ir_inst_list_empty())
    let args = ir_value_list_prepend(nil_value, ir_value_list_empty())
    let block = ir_block_new_term(start_block, insts, ir_term_jump_args(target_block, args))
    let blocks = ir_block_list_prepend(block, ir_block_list_empty())
    pipeline_lowered_loop_blocks(next_block, nil_value + 1, blocks, 1, 1, 0)
  } else {
    if pipeline_expr_needs_cfg(value_expr) == 1 {
      let break_block = next_block
      let value_blocks = pipeline_lower_expr_to_target_blocks_reserved(value_expr, params, locals, module, next_value, start_block, next_block + 1, break_block)
      if pipeline_lowered_blocks_is_valid(value_blocks) == 1 {
        if pipeline_lowered_blocks_falls_through(value_blocks) == 0 {
          pipeline_lowered_loop_blocks_from_expr(value_blocks, 0, 0)
        } else {
          let break_value = pipeline_lowered_blocks_next_value(value_blocks)
          let nil_value = break_value + 1
          let break_params = ir_value_list_prepend(break_value, ir_value_list_empty())
          let break_args = ir_value_list_prepend(nil_value, ir_value_list_empty())
          let break_insts = ir_inst_list_prepend(ir_inst_const_i64(nil_value, 0), ir_inst_list_empty())
          let break_node = ir_block_new_params(break_block, break_params, break_insts, ir_term_jump_args(target_block, break_args))
          let blocks = ir_block_list_append(
            pipeline_lowered_blocks_blocks(value_blocks),
            ir_block_list_prepend(break_node, ir_block_list_empty())
          )
          pipeline_lowered_loop_blocks(pipeline_lowered_blocks_next_block(value_blocks), nil_value + 1, blocks, 1, 1, 0)
        }
      } else {
        pipeline_lowered_loop_blocks_invalid(start_block, next_value)
      }
    } else {
      let value = pipeline_lower_expr_sidecar(value_expr, params, locals, src, tt, next_value)
      if ir_lowered_expr_is_valid(value) == 1 {
        let nil_value = ir_lowered_expr_next_value(value)
        let nil_inst = ir_inst_list_prepend(ir_inst_const_i64(nil_value, 0), ir_inst_list_empty())
        let args = ir_value_list_prepend(nil_value, ir_value_list_empty())
        let insts = ir_inst_list_append(ir_lowered_expr_insts(value), nil_inst)
        let block = ir_block_new_term(start_block, insts, ir_term_jump_args(target_block, args))
        let blocks = ir_block_list_prepend(block, ir_block_list_empty())
        pipeline_lowered_loop_blocks(next_block, nil_value + 1, blocks, 1, 1, 0)
      } else {
        pipeline_lowered_loop_blocks_invalid(start_block, next_value)
      }
    }
  }
}

fn pipeline_lower_continue_to_blocks(next_value: i64, start_block: i64, next_block: i64, continue_block: i64) -> PipelineLoweredLoopBlocks {
  let block = ir_block_new_term(start_block, ir_inst_list_empty(), ir_term_jump(continue_block))
  let blocks = ir_block_list_prepend(block, ir_block_list_empty())
  pipeline_lowered_loop_blocks(next_block, next_value, blocks, 1, 0, 0)
}

fn pipeline_lower_return_to_loop_blocks(expr: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, next_value: i64, start_block: i64, next_block: i64) -> PipelineLoweredLoopBlocks {
  let lowered = pipeline_lower_return_to_blocks(expr, params, locals, src, tt, next_value, start_block, next_block)
  pipeline_lowered_loop_blocks_from_expr(lowered, 0, 0)
}

fn pipeline_lower_loop_if_to_target_blocks(expr: i64, ctx: PipelineLoopCtx, next_value: i64, start_block: i64, next_block: i64) -> PipelineLoweredLoopBlocks {
  let params = pipeline_loop_ctx_params(ctx)
  let locals = pipeline_loop_ctx_locals(ctx)
  let src = pipeline_loop_ctx_src(ctx)
  let tt = pipeline_loop_ctx_tt(ctx)
  let else_expr = node_f3(expr)
  if else_expr == 0 {
    pipeline_lowered_loop_blocks_invalid(start_block, next_value)
  } else {
    let cond = pipeline_lower_expr_sidecar(node_f1(expr), params, locals, src, tt, next_value)
    if ir_lowered_expr_is_valid(cond) == 1 {
      let then_start = next_block
      let then_blocks = pipeline_lower_loop_body_to_target_blocks(node_f2(expr), ctx, ir_lowered_expr_next_value(cond), then_start, then_start + 1)
      if pipeline_lowered_loop_blocks_is_valid(then_blocks) == 1 {
        let else_start = pipeline_lowered_loop_blocks_next_block(then_blocks)
        let else_blocks = pipeline_lower_loop_body_to_target_blocks(else_expr, ctx, pipeline_lowered_loop_blocks_next_value(then_blocks), else_start, else_start + 1)
        if pipeline_lowered_loop_blocks_is_valid(else_blocks) == 1 {
          let entry = ir_block_new_term(start_block, ir_lowered_expr_insts(cond), ir_term_branch(ir_lowered_expr_value(cond), then_start, else_start))
          let exits_loop = pipeline_bool_or(pipeline_lowered_loop_blocks_exits_loop(then_blocks), pipeline_lowered_loop_blocks_exits_loop(else_blocks))
          let continues_body = pipeline_bool_or(pipeline_lowered_loop_blocks_continues_body(then_blocks), pipeline_lowered_loop_blocks_continues_body(else_blocks))
          let blocks = ir_block_list_prepend(
            entry,
            ir_block_list_append(pipeline_lowered_loop_blocks_blocks(then_blocks), pipeline_lowered_loop_blocks_blocks(else_blocks))
          )
          pipeline_lowered_loop_blocks(pipeline_lowered_loop_blocks_next_block(else_blocks), pipeline_lowered_loop_blocks_next_value(else_blocks), blocks, 1, exits_loop, continues_body)
        } else {
          pipeline_lowered_loop_blocks_invalid(start_block, next_value)
        }
      } else {
        pipeline_lowered_loop_blocks_invalid(start_block, next_value)
      }
    } else {
      pipeline_lowered_loop_blocks_invalid(start_block, next_value)
    }
  }
}

fn pipeline_lower_loop_block_to_target_blocks(expr: i64, ctx: PipelineLoopCtx, next_value: i64, start_block: i64, next_block: i64) -> PipelineLoweredLoopBlocks {
  let first_expr = node_f1(expr)
  let rest_node = node_f2(expr)
  if rest_node == 0 {
    pipeline_lower_loop_body_to_target_blocks(first_expr, ctx, next_value, start_block, next_block)
  } else {
    let rest_start = next_block
    let first_ctx = pipeline_loop_ctx_with_normal_block(ctx, rest_start)
    let first_blocks = pipeline_lower_loop_body_to_target_blocks(first_expr, first_ctx, next_value, start_block, next_block + 1)
    if pipeline_lowered_loop_blocks_is_valid(first_blocks) == 1 {
      if pipeline_lowered_loop_blocks_continues_body(first_blocks) == 0 {
        first_blocks
      } else {
        let rest_blocks = pipeline_lower_loop_body_to_target_blocks(rest_node, ctx, pipeline_lowered_loop_blocks_next_value(first_blocks), rest_start, pipeline_lowered_loop_blocks_next_block(first_blocks))
        if pipeline_lowered_loop_blocks_is_valid(rest_blocks) == 1 {
          let exits_loop = pipeline_bool_or(pipeline_lowered_loop_blocks_exits_loop(first_blocks), pipeline_lowered_loop_blocks_exits_loop(rest_blocks))
          let continues_body = pipeline_lowered_loop_blocks_continues_body(rest_blocks)
          let blocks = ir_block_list_append(
            pipeline_lowered_loop_blocks_blocks(first_blocks),
            pipeline_lowered_loop_blocks_blocks(rest_blocks)
          )
          pipeline_lowered_loop_blocks(pipeline_lowered_loop_blocks_next_block(rest_blocks), pipeline_lowered_loop_blocks_next_value(rest_blocks), blocks, 1, exits_loop, continues_body)
        } else {
          pipeline_lowered_loop_blocks_invalid(start_block, next_value)
        }
      }
    } else {
      pipeline_lowered_loop_blocks_invalid(start_block, next_value)
    }
  }
}

fn pipeline_lower_loop_body_to_target_blocks(expr: i64, ctx: PipelineLoopCtx, next_value: i64, start_block: i64, next_block: i64) -> PipelineLoweredLoopBlocks {
  let params = pipeline_loop_ctx_params(ctx)
  let locals = pipeline_loop_ctx_locals(ctx)
  let src = pipeline_loop_ctx_src(ctx)
  let tt = pipeline_loop_ctx_tt(ctx)
  let module = pipeline_lower_module(src, tt)
  let target_block = pipeline_loop_ctx_target_block(ctx)
  let continue_block = pipeline_loop_ctx_continue_block(ctx)
  let normal_block = pipeline_loop_ctx_normal_block(ctx)
  let break_mode = pipeline_loop_ctx_break_mode(ctx)
  let tag = node_tag(expr)
  match tag {
    26 -> {
      if break_mode == 1 {
        pipeline_lower_nil_break_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      } else {
        pipeline_lower_break_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      }
    }
    27 -> pipeline_lower_continue_to_blocks(next_value, start_block, next_block, continue_block)
    25 -> pipeline_lower_return_to_loop_blocks(expr, params, locals, src, tt, next_value, start_block, next_block)
    5 -> pipeline_lower_loop_if_to_target_blocks(expr, ctx, next_value, start_block, next_block)
    7 -> pipeline_lower_loop_block_to_target_blocks(expr, ctx, next_value, start_block, next_block)
    37 -> pipeline_lower_loop_body_to_target_blocks(node_f1(expr), ctx, next_value, start_block, next_block)
    _ -> {
      if pipeline_expr_needs_cfg(expr) == 1 {
        let normal_blocks = pipeline_lower_expr_to_target_blocks_reserved(expr, params, locals, module, next_value, start_block, next_block, normal_block)
        if pipeline_lowered_blocks_is_valid(normal_blocks) == 1 {
          pipeline_lowered_loop_blocks(
            pipeline_lowered_blocks_next_block(normal_blocks),
            pipeline_lowered_blocks_next_value(normal_blocks),
            pipeline_lowered_blocks_blocks(normal_blocks),
            1,
            0,
            pipeline_lowered_blocks_falls_through(normal_blocks)
          )
        } else {
          pipeline_lowered_loop_blocks_invalid(start_block, next_value)
        }
      } else {
        let value = pipeline_lower_expr_sidecar(expr, params, locals, src, tt, next_value)
        if ir_lowered_expr_is_valid(value) == 1 {
          let block = ir_block_new_term(start_block, ir_lowered_expr_insts(value), ir_term_jump(normal_block))
          let blocks = ir_block_list_prepend(block, ir_block_list_empty())
          pipeline_lowered_loop_blocks(next_block, ir_lowered_expr_next_value(value), blocks, 1, 0, 1)
        } else {
          pipeline_lowered_loop_blocks_invalid(start_block, next_value)
        }
      }
    }
  }
}

fn pipeline_lower_loop_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let ctx = pipeline_loop_ctx(params, locals, src, tt, target_block, start_block, start_block, 0)
  let lowered = pipeline_lower_loop_body_to_target_blocks(node_f1(expr), ctx, next_value, start_block, next_block)
  pipeline_lowered_blocks_control(
    pipeline_lowered_loop_blocks_next_block(lowered),
    pipeline_lowered_loop_blocks_next_value(lowered),
    pipeline_lowered_loop_blocks_blocks(lowered),
    pipeline_lowered_loop_blocks_is_valid(lowered),
    pipeline_lowered_loop_blocks_exits_loop(lowered)
  )
}

fn pipeline_lower_while_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let cond = pipeline_lower_expr_sidecar(node_f1(expr), params, locals, src, tt, next_value)
  if ir_lowered_expr_is_valid(cond) == 1 {
    let body_start = next_block
    let exit_block = next_block + 1
    let ctx = pipeline_loop_ctx(params, locals, src, tt, target_block, start_block, start_block, 1)
    let body_blocks = pipeline_lower_loop_body_to_target_blocks(node_f2(expr), ctx, ir_lowered_expr_next_value(cond), body_start, next_block + 2)
    if pipeline_lowered_loop_blocks_is_valid(body_blocks) == 1 {
      let nil_value = pipeline_lowered_loop_blocks_next_value(body_blocks)
      let exit_args = ir_value_list_prepend(nil_value, ir_value_list_empty())
      let exit_insts = ir_inst_list_prepend(ir_inst_const_i64(nil_value, 0), ir_inst_list_empty())
      let entry = ir_block_new_term(start_block, ir_lowered_expr_insts(cond), ir_term_branch(ir_lowered_expr_value(cond), body_start, exit_block))
      let exit_node = ir_block_new_term(exit_block, exit_insts, ir_term_jump_args(target_block, exit_args))
      let blocks = ir_block_list_prepend(
        entry,
        ir_block_list_append(pipeline_lowered_loop_blocks_blocks(body_blocks), ir_block_list_prepend(exit_node, ir_block_list_empty()))
      )
      pipeline_lowered_blocks(pipeline_lowered_loop_blocks_next_block(body_blocks), nil_value + 1, blocks, 1)
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  } else {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  }
}

fn pipeline_lower_for_iter_loop_to_target_blocks(for_ctx: PipelineForIterCtx, current_slot: i64, next_value: i64, start_block: i64, next_block: i64) -> PipelineLoweredBlocks {
  match for_ctx {
    PipelineForIterCtx(expr, params, locals, module, target_block) -> {
      let src = pipeline_lower_module_src(module)
      let tt = pipeline_lower_module_tt(module)
      let body_block = next_block
      let exit_block = next_block + 1
      let advance_block = next_block + 2
      let body_expr_start = next_block + 3
      let body_next_block = next_block + 4
      let check_cur = next_value
      let tag_value = next_value + 1
      let nil_tag = next_value + 2
      let is_nil = next_value + 3
      let check_insts = ir_inst_list_prepend(
        ir_inst_load_i64(check_cur, current_slot),
        ir_inst_list_prepend(
          ir_inst_variant_tag_i64(tag_value, check_cur),
          ir_inst_list_prepend(
            ir_inst_const_i64(nil_tag, pipeline_nil_variant_hash()),
            ir_inst_list_prepend(ir_inst_binary_i64(is_nil, ir_binary_op_eq(), tag_value, nil_tag), ir_inst_list_empty())
          )
        )
      )
      let check_node = ir_block_new_term(start_block, check_insts, ir_term_branch(is_nil, exit_block, body_block))
      let body_cur = is_nil + 1
      let item_value = body_cur + 1
      let body_insts = ir_inst_list_prepend(
        ir_inst_load_i64(body_cur, current_slot),
        ir_inst_list_prepend(ir_inst_variant_payload_i64(item_value, body_cur, 0), ir_inst_list_empty())
      )
      let body_entry = ir_block_new_term(body_block, body_insts, ir_term_jump(body_expr_start))
      let body_locals = pipeline_value_env_push(locals, node_f1(expr), node_f2(expr), item_value)
      let loop_ctx = pipeline_loop_ctx(params, body_locals, src, tt, target_block, advance_block, advance_block, 1)
      let body_blocks = pipeline_lower_loop_body_to_target_blocks(node_f4(expr), loop_ctx, item_value + 1, body_expr_start, body_next_block)
      if pipeline_lowered_loop_blocks_is_valid(body_blocks) == 1 {
        let advance_cur = pipeline_lowered_loop_blocks_next_value(body_blocks)
        let next_cell = advance_cur + 1
        let nil_result = next_cell + 1
        let advance_insts = ir_inst_list_prepend(
          ir_inst_load_i64(advance_cur, current_slot),
          ir_inst_list_prepend(
            ir_inst_variant_payload_i64(next_cell, advance_cur, 1),
            ir_inst_list_prepend(ir_inst_store_i64(current_slot, next_cell), ir_inst_list_empty())
          )
        )
        let advance_node = ir_block_new_term(advance_block, advance_insts, ir_term_jump(start_block))
        let exit_args = ir_value_list_prepend(nil_result, ir_value_list_empty())
        let exit_insts = ir_inst_list_prepend(ir_inst_const_i64(nil_result, 0), ir_inst_list_empty())
        let exit_node = ir_block_new_term(exit_block, exit_insts, ir_term_jump_args(target_block, exit_args))
        let tail_blocks = ir_block_list_append(
          pipeline_lowered_loop_blocks_blocks(body_blocks),
          ir_block_list_prepend(advance_node, ir_block_list_prepend(exit_node, ir_block_list_empty()))
        )
        let blocks = ir_block_list_prepend(check_node, ir_block_list_prepend(body_entry, tail_blocks))
        pipeline_lowered_blocks(pipeline_lowered_loop_blocks_next_block(body_blocks), nil_result + 1, blocks, 1)
      } else {
        pipeline_lowered_blocks_invalid(start_block, next_value)
      }
    }
  }
}

fn pipeline_lower_for_iter_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let collection_expr = node_f3(expr)
  if pipeline_expr_needs_cfg(collection_expr) == 1 {
    let collection_merge_block = next_block
    let collection_blocks = pipeline_lower_expr_to_target_blocks_reserved(collection_expr, params, locals, module, next_value, start_block, next_block + 1, collection_merge_block)
    if pipeline_lowered_blocks_is_valid(collection_blocks) == 1 {
      if pipeline_lowered_blocks_falls_through(collection_blocks) == 0 {
        collection_blocks
      } else {
        let collection_value = pipeline_lowered_blocks_next_value(collection_blocks)
        let current_slot = collection_value + 1
        let loop_start = pipeline_lowered_blocks_next_block(collection_blocks)
        let slot_insts = ir_inst_list_prepend(
          ir_inst_slot_i64(current_slot),
          ir_inst_list_prepend(ir_inst_store_i64(current_slot, collection_value), ir_inst_list_empty())
        )
        let collection_params = ir_value_list_prepend(collection_value, ir_value_list_empty())
        let collection_merge = ir_block_new_params(collection_merge_block, collection_params, slot_insts, ir_term_jump(loop_start))
        let for_ctx = PipelineForIterCtx(expr, params, locals, module, target_block)
        let loop_blocks = pipeline_lower_for_iter_loop_to_target_blocks(for_ctx, current_slot, current_slot + 1, loop_start, loop_start + 1)
        if pipeline_lowered_blocks_is_valid(loop_blocks) == 1 {
          let blocks = ir_block_list_append(
            pipeline_lowered_blocks_blocks(collection_blocks),
            ir_block_list_prepend(collection_merge, pipeline_lowered_blocks_blocks(loop_blocks))
          )
          pipeline_lowered_blocks(
            pipeline_lowered_blocks_next_block(loop_blocks),
            pipeline_lowered_blocks_next_value(loop_blocks),
            blocks,
            1
          )
        } else {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        }
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  } else {
    let collection = pipeline_lower_expr_sidecar(collection_expr, params, locals, src, tt, next_value)
    if ir_lowered_expr_is_valid(collection) == 1 {
      let current_slot = ir_lowered_expr_next_value(collection)
      let slot_insts = ir_inst_list_prepend(
        ir_inst_slot_i64(current_slot),
        ir_inst_list_prepend(ir_inst_store_i64(current_slot, ir_lowered_expr_value(collection)), ir_inst_list_empty())
      )
      let loop_start = next_block
      let entry_insts = ir_inst_list_append(ir_lowered_expr_insts(collection), slot_insts)
      let entry = ir_block_new_term(start_block, entry_insts, ir_term_jump(loop_start))
      let for_ctx = PipelineForIterCtx(expr, params, locals, module, target_block)
      let loop_blocks = pipeline_lower_for_iter_loop_to_target_blocks(for_ctx, current_slot, current_slot + 1, loop_start, next_block + 1)
      if pipeline_lowered_blocks_is_valid(loop_blocks) == 1 {
        let blocks = ir_block_list_prepend(entry, pipeline_lowered_blocks_blocks(loop_blocks))
        pipeline_lowered_blocks(
          pipeline_lowered_blocks_next_block(loop_blocks),
          pipeline_lowered_blocks_next_value(loop_blocks),
          blocks,
          1
        )
      } else {
        pipeline_lowered_blocks_invalid(start_block, next_value)
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  }
}

fn pipeline_lower_if_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let else_expr = node_f3(expr)
  if else_expr == 0 {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  } else {
    let cond = pipeline_lower_expr_sidecar(node_f1(expr), params, locals, src, tt, next_value)
    if ir_lowered_expr_is_valid(cond) == 1 {
      let then_start = next_block
      let then_blocks = pipeline_lower_expr_to_target_blocks(node_f2(expr), params, locals, src, tt, ir_lowered_expr_next_value(cond), then_start, target_block)
      if pipeline_lowered_blocks_is_valid(then_blocks) == 1 {
        let else_start = pipeline_lowered_blocks_next_block(then_blocks)
        let else_blocks = pipeline_lower_expr_to_target_blocks(else_expr, params, locals, src, tt, pipeline_lowered_blocks_next_value(then_blocks), else_start, target_block)
        if pipeline_lowered_blocks_is_valid(else_blocks) == 1 {
          let entry = ir_block_new_term(start_block, ir_lowered_expr_insts(cond), ir_term_branch(ir_lowered_expr_value(cond), then_start, else_start))
          let falls_through = if pipeline_lowered_blocks_falls_through(then_blocks) == 1 { 1 } else { pipeline_lowered_blocks_falls_through(else_blocks) }
          let blocks = ir_block_list_prepend(
            entry,
            ir_block_list_append(pipeline_lowered_blocks_blocks(then_blocks), pipeline_lowered_blocks_blocks(else_blocks))
          )
          pipeline_lowered_blocks_control(pipeline_lowered_blocks_next_block(else_blocks), pipeline_lowered_blocks_next_value(else_blocks), blocks, 1, falls_through)
        } else {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        }
      } else {
        pipeline_lowered_blocks_invalid(start_block, next_value)
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  }
}

fn pipeline_lower_binop_lhs_cfg_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let op = ir_binary_op_from_parser(node_f1(expr))
  let lhs_merge_block = next_block
  let lhs_blocks = pipeline_lower_expr_to_target_blocks_reserved(node_f2(expr), params, locals, module, next_value, start_block, next_block + 1, lhs_merge_block)
  if pipeline_lowered_blocks_is_valid(lhs_blocks) == 1 {
    if pipeline_lowered_blocks_falls_through(lhs_blocks) == 0 {
      lhs_blocks
    } else {
      let lhs_value = pipeline_lowered_blocks_next_value(lhs_blocks)
      let body_start = pipeline_lowered_blocks_next_block(lhs_blocks)
      let rhs = pipeline_lower_expr_sidecar(node_f3(expr), params, locals, src, tt, lhs_value + 1)
      if ir_lowered_expr_is_valid(rhs) == 1 {
        let dst = ir_lowered_expr_next_value(rhs)
        let binary = ir_inst_list_prepend(
          ir_inst_binary_i64(dst, op, lhs_value, ir_lowered_expr_value(rhs)),
          ir_inst_list_empty()
        )
        let body_insts = ir_inst_list_append(ir_lowered_expr_insts(rhs), binary)
        let body_args = ir_value_list_prepend(dst, ir_value_list_empty())
        let lhs_params = ir_value_list_prepend(lhs_value, ir_value_list_empty())
        let lhs_merge = ir_block_new_params(lhs_merge_block, lhs_params, ir_inst_list_empty(), ir_term_jump(body_start))
        let body_block = ir_block_new_term(body_start, body_insts, ir_term_jump_args(target_block, body_args))
        let blocks = ir_block_list_append(
          pipeline_lowered_blocks_blocks(lhs_blocks),
          ir_block_list_prepend(lhs_merge, ir_block_list_prepend(body_block, ir_block_list_empty()))
        )
        pipeline_lowered_blocks(body_start + 1, dst + 1, blocks, 1)
      } else {
        pipeline_lowered_blocks_invalid(start_block, next_value)
      }
    }
  } else {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  }
}

fn pipeline_lower_binop_rhs_cfg_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let op = ir_binary_op_from_parser(node_f1(expr))
  let lhs = pipeline_lower_expr_sidecar(node_f2(expr), params, locals, src, tt, next_value)
  if ir_lowered_expr_is_valid(lhs) == 1 {
    let rhs_merge_block = next_block
    let rhs_start = next_block + 1
    let rhs_blocks = pipeline_lower_expr_to_target_blocks_reserved(node_f3(expr), params, locals, module, ir_lowered_expr_next_value(lhs), rhs_start, next_block + 2, rhs_merge_block)
    if pipeline_lowered_blocks_is_valid(rhs_blocks) == 1 {
      let lhs_entry = ir_block_new_term(start_block, ir_lowered_expr_insts(lhs), ir_term_jump(rhs_start))
      if pipeline_lowered_blocks_falls_through(rhs_blocks) == 0 {
        let blocks = ir_block_list_prepend(lhs_entry, pipeline_lowered_blocks_blocks(rhs_blocks))
        pipeline_lowered_blocks_control(pipeline_lowered_blocks_next_block(rhs_blocks), pipeline_lowered_blocks_next_value(rhs_blocks), blocks, 1, 0)
      } else {
        let rhs_value = pipeline_lowered_blocks_next_value(rhs_blocks)
        let body_start = pipeline_lowered_blocks_next_block(rhs_blocks)
        let dst = rhs_value + 1
        let binary = ir_inst_list_prepend(
          ir_inst_binary_i64(dst, op, ir_lowered_expr_value(lhs), rhs_value),
          ir_inst_list_empty()
        )
        let body_args = ir_value_list_prepend(dst, ir_value_list_empty())
        let rhs_params = ir_value_list_prepend(rhs_value, ir_value_list_empty())
        let rhs_merge = ir_block_new_params(rhs_merge_block, rhs_params, ir_inst_list_empty(), ir_term_jump(body_start))
        let body_block = ir_block_new_term(body_start, binary, ir_term_jump_args(target_block, body_args))
        let blocks = ir_block_list_prepend(
          lhs_entry,
          ir_block_list_append(
            pipeline_lowered_blocks_blocks(rhs_blocks),
            ir_block_list_prepend(rhs_merge, ir_block_list_prepend(body_block, ir_block_list_empty()))
          )
        )
        pipeline_lowered_blocks(body_start + 1, dst + 1, blocks, 1)
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  } else {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  }
}

fn pipeline_lower_binop_both_cfg_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let op = ir_binary_op_from_parser(node_f1(expr))
  let lhs_merge_block = next_block
  let lhs_blocks = pipeline_lower_expr_to_target_blocks_reserved(node_f2(expr), params, locals, module, next_value, start_block, next_block + 1, lhs_merge_block)
  if pipeline_lowered_blocks_is_valid(lhs_blocks) == 1 {
    if pipeline_lowered_blocks_falls_through(lhs_blocks) == 0 {
      lhs_blocks
    } else {
      let lhs_value = pipeline_lowered_blocks_next_value(lhs_blocks)
      let rhs_start = pipeline_lowered_blocks_next_block(lhs_blocks)
      let rhs_merge_block = rhs_start + 1
      let rhs_blocks = pipeline_lower_expr_to_target_blocks_reserved(node_f3(expr), params, locals, module, lhs_value + 1, rhs_start, rhs_start + 2, rhs_merge_block)
      if pipeline_lowered_blocks_is_valid(rhs_blocks) == 1 {
        let lhs_params = ir_value_list_prepend(lhs_value, ir_value_list_empty())
        let lhs_merge = ir_block_new_params(lhs_merge_block, lhs_params, ir_inst_list_empty(), ir_term_jump(rhs_start))
        if pipeline_lowered_blocks_falls_through(rhs_blocks) == 0 {
          let blocks = ir_block_list_append(
            pipeline_lowered_blocks_blocks(lhs_blocks),
            ir_block_list_prepend(lhs_merge, pipeline_lowered_blocks_blocks(rhs_blocks))
          )
          pipeline_lowered_blocks_control(pipeline_lowered_blocks_next_block(rhs_blocks), pipeline_lowered_blocks_next_value(rhs_blocks), blocks, 1, 0)
        } else {
          let rhs_value = pipeline_lowered_blocks_next_value(rhs_blocks)
          let body_start = pipeline_lowered_blocks_next_block(rhs_blocks)
          let dst = rhs_value + 1
          let binary = ir_inst_list_prepend(
            ir_inst_binary_i64(dst, op, lhs_value, rhs_value),
            ir_inst_list_empty()
          )
          let body_args = ir_value_list_prepend(dst, ir_value_list_empty())
          let rhs_params = ir_value_list_prepend(rhs_value, ir_value_list_empty())
          let rhs_merge = ir_block_new_params(rhs_merge_block, rhs_params, ir_inst_list_empty(), ir_term_jump(body_start))
          let body_block = ir_block_new_term(body_start, binary, ir_term_jump_args(target_block, body_args))
          let blocks = ir_block_list_append(
            pipeline_lowered_blocks_blocks(lhs_blocks),
            ir_block_list_prepend(
              lhs_merge,
              ir_block_list_append(
                pipeline_lowered_blocks_blocks(rhs_blocks),
                ir_block_list_prepend(rhs_merge, ir_block_list_prepend(body_block, ir_block_list_empty()))
              )
            )
          )
          pipeline_lowered_blocks(body_start + 1, dst + 1, blocks, 1)
        }
      } else {
        pipeline_lowered_blocks_invalid(start_block, next_value)
      }
    }
  } else {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  }
}

fn pipeline_lower_binop_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let op = ir_binary_op_from_parser(node_f1(expr))
  if ir_binary_op_is_supported(op) == 1 {
    if pipeline_expr_needs_cfg(node_f2(expr)) == 1 {
      if pipeline_expr_needs_cfg(node_f3(expr)) == 1 {
        pipeline_lower_binop_both_cfg_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      } else {
        pipeline_lower_binop_lhs_cfg_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      }
    } else {
      if pipeline_expr_needs_cfg(node_f3(expr)) == 1 {
        pipeline_lower_binop_rhs_cfg_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      } else {
        pipeline_lower_straight_expr_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      }
    }
  } else {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  }
}

fn pipeline_lower_not_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let value_expr = node_f1(expr)
  if pipeline_expr_needs_cfg(value_expr) == 1 {
    let value_merge_block = next_block
    let value_blocks = pipeline_lower_expr_to_target_blocks_reserved(value_expr, params, locals, module, next_value, start_block, next_block + 1, value_merge_block)
    if pipeline_lowered_blocks_is_valid(value_blocks) == 1 {
      if pipeline_lowered_blocks_falls_through(value_blocks) == 0 {
        value_blocks
      } else {
        let value = pipeline_lowered_blocks_next_value(value_blocks)
        let dst = value + 1
        let value_params = ir_value_list_prepend(value, ir_value_list_empty())
        let result_args = ir_value_list_prepend(dst, ir_value_list_empty())
        let not_inst = ir_inst_list_prepend(ir_inst_unary_i64(dst, ir_unary_op_not(), value), ir_inst_list_empty())
        let merge = ir_block_new_params(value_merge_block, value_params, not_inst, ir_term_jump_args(target_block, result_args))
        let blocks = ir_block_list_append(
          pipeline_lowered_blocks_blocks(value_blocks),
          ir_block_list_prepend(merge, ir_block_list_empty())
        )
        pipeline_lowered_blocks(pipeline_lowered_blocks_next_block(value_blocks), dst + 1, blocks, 1)
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  } else {
    pipeline_lower_straight_expr_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
  }
}

fn pipeline_lower_try_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let value_expr = node_f1(expr)
  if pipeline_expr_needs_cfg(value_expr) == 1 {
    let value_merge_block = next_block
    let value_blocks = pipeline_lower_expr_to_target_blocks_reserved(value_expr, params, locals, module, next_value, start_block, next_block + 1, value_merge_block)
    if pipeline_lowered_blocks_is_valid(value_blocks) == 1 {
      if pipeline_lowered_blocks_falls_through(value_blocks) == 0 {
        value_blocks
      } else {
        let value = pipeline_lowered_blocks_next_value(value_blocks)
        let dst = value + 1
        let value_params = ir_value_list_prepend(value, ir_value_list_empty())
        let result_args = ir_value_list_prepend(dst, ir_value_list_empty())
        let try_inst = ir_inst_list_prepend(ir_inst_try_i64(dst, value), ir_inst_list_empty())
        let merge = ir_block_new_params(value_merge_block, value_params, try_inst, ir_term_jump_args(target_block, result_args))
        let blocks = ir_block_list_append(
          pipeline_lowered_blocks_blocks(value_blocks),
          ir_block_list_prepend(merge, ir_block_list_empty())
        )
        pipeline_lowered_blocks(pipeline_lowered_blocks_next_block(value_blocks), dst + 1, blocks, 1)
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  } else {
    pipeline_lower_straight_expr_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
  }
}

fn pipeline_lower_call_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let direct = pipeline_call_callee_is_direct(params, locals, src, node_f1(expr), node_f2(expr))
  let callee_value = pipeline_call_callee_value(params, locals, src, node_f1(expr), node_f2(expr))
  let callee_slot = pipeline_call_callee_slot(locals, src, node_f1(expr), node_f2(expr))
  if direct == 1 or callee_value >= 0 or callee_slot >= 0 {
    let call_block = next_block
    let first_arg_block = next_block + 1
    let arg_start_value = if callee_slot >= 0 { next_value + 1 } else { next_value }
    let entry_insts = if callee_slot >= 0 {
      ir_inst_list_prepend(ir_inst_load_i64(next_value, callee_slot), ir_inst_list_empty())
    } else { ir_inst_list_empty() }
    let ctx = pipeline_call_arg_ctx(node_f3(expr), node_f4(expr), params, locals, src, tt, call_block)
    let lowered_args = pipeline_lower_call_arg_blocks(ctx, 0, arg_start_value, first_arg_block, ir_value_list_empty())
    if pipeline_lowered_call_blocks_is_valid(lowered_args) == 1 {
      let entry = ir_block_new_term(start_block, entry_insts, ir_term_jump(first_arg_block))
      if pipeline_lowered_call_blocks_falls_through(lowered_args) == 0 {
        let blocks = ir_block_list_prepend(entry, pipeline_lowered_call_blocks_blocks(lowered_args))
        pipeline_lowered_blocks_control(
          pipeline_lowered_call_blocks_next_block(lowered_args),
          pipeline_lowered_call_blocks_next_value(lowered_args),
          blocks,
          1,
          0
        )
      } else {
        let call_dst = pipeline_lowered_call_blocks_next_value(lowered_args)
        let indirect_callee = if callee_slot >= 0 { next_value } else { callee_value }
        let call_inst = ir_inst_list_prepend(
          pipeline_call_inst_resolved(call_dst, direct, indirect_callee, src, tt, node_f1(expr), node_f2(expr), pipeline_lowered_call_blocks_values(lowered_args)),
          ir_inst_list_empty()
        )
        let call_args = ir_value_list_prepend(call_dst, ir_value_list_empty())
        let call = ir_block_new_term(call_block, call_inst, ir_term_jump_args(target_block, call_args))
        let blocks = ir_block_list_prepend(
          entry,
          ir_block_list_append(pipeline_lowered_call_blocks_blocks(lowered_args), ir_block_list_prepend(call, ir_block_list_empty()))
        )
        pipeline_lowered_blocks(pipeline_lowered_call_blocks_next_block(lowered_args), call_dst + 1, blocks, 1)
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  } else {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  }
}

fn pipeline_lower_perform_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let lhs = node_f1(expr)
  if node_tag(lhs) == 2 {
    let perform_block = next_block
    let first_arg_block = next_block + 1
    let args_node = node_f4(expr)
    let ctx = pipeline_call_arg_ctx(args_node, nlist_len(args_node), params, locals, src, tt, perform_block)
    let lowered_args = pipeline_lower_call_arg_blocks(ctx, 0, next_value, first_arg_block, ir_value_list_empty())
    if pipeline_lowered_call_blocks_is_valid(lowered_args) == 1 {
      let entry = ir_block_new_term(start_block, ir_inst_list_empty(), ir_term_jump(first_arg_block))
      if pipeline_lowered_call_blocks_falls_through(lowered_args) == 0 {
        let blocks = ir_block_list_prepend(entry, pipeline_lowered_call_blocks_blocks(lowered_args))
        pipeline_lowered_blocks_control(
          pipeline_lowered_call_blocks_next_block(lowered_args),
          pipeline_lowered_call_blocks_next_value(lowered_args),
          blocks,
          1,
          0
        )
      } else {
        let dst = pipeline_lowered_call_blocks_next_value(lowered_args)
        let perform_inst = ir_inst_list_prepend(
          pipeline_perform_inst(dst, src, lhs, node_f2(expr), node_f3(expr), pipeline_lowered_call_blocks_values(lowered_args)),
          ir_inst_list_empty()
        )
        let result_args = ir_value_list_prepend(dst, ir_value_list_empty())
        let perform = ir_block_new_term(perform_block, perform_inst, ir_term_jump_args(target_block, result_args))
        let blocks = ir_block_list_prepend(
          entry,
          ir_block_list_append(pipeline_lowered_call_blocks_blocks(lowered_args), ir_block_list_prepend(perform, ir_block_list_empty()))
        )
        pipeline_lowered_blocks(pipeline_lowered_call_blocks_next_block(lowered_args), dst + 1, blocks, 1)
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  } else {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  }
}

fn pipeline_lower_generic_call_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let call_node = node_f2(expr)
  if pipeline_call_callee_is_direct(params, locals, src, node_f1(call_node), node_f2(call_node)) == 1 {
    let call_block = next_block
    let first_arg_block = next_block + 1
    let ctx = pipeline_call_arg_ctx(node_f3(call_node), node_f4(call_node), params, locals, src, tt, call_block)
    let lowered_args = pipeline_lower_call_arg_blocks(ctx, 0, next_value, first_arg_block, ir_value_list_empty())
    if pipeline_lowered_call_blocks_is_valid(lowered_args) == 1 {
      let entry = ir_block_new_term(start_block, ir_inst_list_empty(), ir_term_jump(first_arg_block))
      if pipeline_lowered_call_blocks_falls_through(lowered_args) == 0 {
        let blocks = ir_block_list_prepend(entry, pipeline_lowered_call_blocks_blocks(lowered_args))
        pipeline_lowered_blocks_control(
          pipeline_lowered_call_blocks_next_block(lowered_args),
          pipeline_lowered_call_blocks_next_value(lowered_args),
          blocks,
          1,
          0
        )
      } else {
        let call_dst = pipeline_lowered_call_blocks_next_value(lowered_args)
        let call_inst = ir_inst_list_prepend(
          pipeline_generic_call_inst(call_dst, src, tt, node_f1(call_node), node_f2(call_node), node_f1(expr), pipeline_lowered_call_blocks_values(lowered_args)),
          ir_inst_list_empty()
        )
        let call_args = ir_value_list_prepend(call_dst, ir_value_list_empty())
        let call = ir_block_new_term(call_block, call_inst, ir_term_jump_args(target_block, call_args))
        let blocks = ir_block_list_prepend(
          entry,
          ir_block_list_append(pipeline_lowered_call_blocks_blocks(lowered_args), ir_block_list_prepend(call, ir_block_list_empty()))
        )
        pipeline_lowered_blocks(pipeline_lowered_call_blocks_next_block(lowered_args), call_dst + 1, blocks, 1)
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  } else {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  }
}

fn pipeline_method_arg_ctx(expr: i64, receiver_value: i64, entry_insts: IrInstList, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, target_block: i64) -> PipelineMethodArgCtx {
  PipelineMethodArgCtx(expr, receiver_value, entry_insts, params, locals, src, tt, target_block)
}

fn pipeline_lower_method_args_cfg_to_target_blocks(method_ctx: PipelineMethodArgCtx, next_value: i64, start_block: i64, next_block: i64) -> PipelineLoweredBlocks {
  match method_ctx {
    PipelineMethodArgCtx(expr, receiver_value, entry_insts, params, locals, src, tt, target_block) -> {
      let args_node = node_f3(expr)
      let call_block = next_block
      let first_arg_block = next_block + 1
      let ctx = pipeline_call_arg_ctx(args_node, nlist_len(args_node), params, locals, src, tt, call_block)
      let lowered_args = pipeline_lower_call_arg_blocks(ctx, 0, next_value, first_arg_block, ir_value_list_empty())
      if pipeline_lowered_call_blocks_is_valid(lowered_args) == 1 {
        let entry = ir_block_new_term(start_block, entry_insts, ir_term_jump(first_arg_block))
        if pipeline_lowered_call_blocks_falls_through(lowered_args) == 0 {
          let blocks = ir_block_list_prepend(entry, pipeline_lowered_call_blocks_blocks(lowered_args))
          pipeline_lowered_blocks_control(
            pipeline_lowered_call_blocks_next_block(lowered_args),
            pipeline_lowered_call_blocks_next_value(lowered_args),
            blocks,
            1,
            0
          )
        } else {
          let call_dst = pipeline_lowered_call_blocks_next_value(lowered_args)
          let call_inst = ir_inst_list_prepend(
            ir_inst_method_call_i64(call_dst, node_f4(expr), node_f2(expr), receiver_value, pipeline_lowered_call_blocks_values(lowered_args)),
            ir_inst_list_empty()
          )
          let call_args = ir_value_list_prepend(call_dst, ir_value_list_empty())
          let call = ir_block_new_term(call_block, call_inst, ir_term_jump_args(target_block, call_args))
          let blocks = ir_block_list_prepend(
            entry,
            ir_block_list_append(pipeline_lowered_call_blocks_blocks(lowered_args), ir_block_list_prepend(call, ir_block_list_empty()))
          )
          pipeline_lowered_blocks(pipeline_lowered_call_blocks_next_block(lowered_args), call_dst + 1, blocks, 1)
        }
      } else {
        pipeline_lowered_blocks_invalid(start_block, next_value)
      }
    }
  }
}

fn pipeline_lower_method_call_after_cfg_receiver(expr: i64, receiver_blocks: PipelineLoweredBlocks, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let receiver_value = pipeline_lowered_blocks_next_value(receiver_blocks)
  let args_node = node_f3(expr)
  let nargs = nlist_len(args_node)
  let args_need_cfg = pipeline_call_args_have_cfg(args_node, nargs, 0)
  if args_need_cfg == 1 {
    let args_start = pipeline_lowered_blocks_next_block(receiver_blocks)
    let method_ctx = pipeline_method_arg_ctx(expr, receiver_value, ir_inst_list_empty(), params, locals, src, tt, target_block)
    let args_blocks = pipeline_lower_method_args_cfg_to_target_blocks(
      method_ctx,
      receiver_value + 1,
      args_start,
      args_start + 1
    )
    if pipeline_lowered_blocks_is_valid(args_blocks) == 1 {
      let receiver_params = ir_value_list_prepend(receiver_value, ir_value_list_empty())
      let receiver_merge = ir_block_new_params(next_block, receiver_params, ir_inst_list_empty(), ir_term_jump(args_start))
      let blocks = ir_block_list_append(
        pipeline_lowered_blocks_blocks(receiver_blocks),
        ir_block_list_prepend(receiver_merge, pipeline_lowered_blocks_blocks(args_blocks))
      )
      pipeline_lowered_blocks_control(
        pipeline_lowered_blocks_next_block(args_blocks),
        pipeline_lowered_blocks_next_value(args_blocks),
        blocks,
        1,
        pipeline_lowered_blocks_falls_through(args_blocks)
      )
    } else {
      pipeline_lowered_blocks_invalid(next_block, receiver_value + 1)
    }
  } else {
    let args = pipeline_lower_call_args_sidecar(args_node, nargs, 0, params, locals, src, tt, receiver_value + 1)
    if pipeline_lowered_args_is_valid(args) == 1 {
      let call_dst = pipeline_lowered_args_next_value(args)
      let call_inst = ir_inst_list_prepend(
        ir_inst_method_call_i64(call_dst, node_f4(expr), node_f2(expr), receiver_value, pipeline_lowered_args_values(args)),
        ir_inst_list_empty()
      )
      let insts = ir_inst_list_append(pipeline_lowered_args_insts(args), call_inst)
      let call_args = ir_value_list_prepend(call_dst, ir_value_list_empty())
      let receiver_params = ir_value_list_prepend(receiver_value, ir_value_list_empty())
      let receiver_merge = ir_block_new_params(next_block, receiver_params, insts, ir_term_jump_args(target_block, call_args))
      let blocks = ir_block_list_append(
        pipeline_lowered_blocks_blocks(receiver_blocks),
        ir_block_list_prepend(receiver_merge, ir_block_list_empty())
      )
      pipeline_lowered_blocks(pipeline_lowered_blocks_next_block(receiver_blocks), call_dst + 1, blocks, 1)
    } else {
      pipeline_lowered_blocks_invalid(next_block, receiver_value + 1)
    }
  }
}

fn pipeline_lower_method_call_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let receiver_expr = node_f1(expr)
  let args_node = node_f3(expr)
  let nargs = nlist_len(args_node)
  if pipeline_expr_needs_cfg(receiver_expr) == 1 {
    let receiver_merge_block = next_block
    let receiver_blocks = pipeline_lower_expr_to_target_blocks_reserved(receiver_expr, params, locals, module, next_value, start_block, next_block + 1, receiver_merge_block)
    if pipeline_lowered_blocks_is_valid(receiver_blocks) == 1 {
      if pipeline_lowered_blocks_falls_through(receiver_blocks) == 0 {
        receiver_blocks
      } else {
        pipeline_lower_method_call_after_cfg_receiver(expr, receiver_blocks, params, locals, src, tt, receiver_merge_block, target_block)
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  } else {
    let receiver = pipeline_lower_expr_sidecar(receiver_expr, params, locals, src, tt, next_value)
    if ir_lowered_expr_is_valid(receiver) == 1 {
      if pipeline_call_args_have_cfg(args_node, nargs, 0) == 1 {
        let method_ctx = pipeline_method_arg_ctx(expr, ir_lowered_expr_value(receiver), ir_lowered_expr_insts(receiver), params, locals, src, tt, target_block)
        pipeline_lower_method_args_cfg_to_target_blocks(
          method_ctx,
          ir_lowered_expr_next_value(receiver),
          start_block,
          next_block
        )
      } else {
        pipeline_lower_straight_expr_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  }
}

fn pipeline_lower_record_field_blocks(ctx: PipelineRecordFieldCtx, index: i64, next_value: i64, next_block: i64, values: IrRecordFieldList) -> PipelineLoweredRecordFieldBlocks {
  match ctx {
    PipelineRecordFieldCtx(fields, nfields, params, locals, src, tt, record_block) -> {
      let module = pipeline_lower_module(src, tt)
      if index >= nfields {
        pipeline_lowered_record_field_blocks(values, next_block, next_value, ir_block_list_empty(), 1)
      } else {
        let field = nlist_get(fields, index)
        let field_hash = str_hash(src, node_f1(field), node_f2(field))
        let value_expr = node_f3(field)
        if pipeline_expr_needs_cfg(value_expr) == 1 {
          let field_merge_block = next_block + 1
          let field_next_block = next_block + 2
          let field_blocks = pipeline_lower_expr_to_target_blocks_reserved(value_expr, params, locals, module, next_value, next_block, field_next_block, field_merge_block)
          if pipeline_lowered_blocks_is_valid(field_blocks) == 1 {
            if pipeline_lowered_blocks_falls_through(field_blocks) == 0 {
              pipeline_lowered_record_field_blocks_control(
                values,
                pipeline_lowered_blocks_next_block(field_blocks),
                pipeline_lowered_blocks_next_value(field_blocks),
                pipeline_lowered_blocks_blocks(field_blocks),
                1,
                0
              )
            } else {
              let field_value = pipeline_lowered_blocks_next_value(field_blocks)
              let rest_start = pipeline_lowered_blocks_next_block(field_blocks)
              let next_values = ir_record_field_list_append(values, ir_record_field_list_prepend(field_hash, field_value, ir_record_field_list_empty()))
              let rest = pipeline_lower_record_field_blocks(ctx, index + 1, field_value + 1, rest_start, next_values)
              if pipeline_lowered_record_field_blocks_is_valid(rest) == 1 {
                let target = if index + 1 >= nfields { record_block } else { rest_start }
                let field_params = ir_value_list_prepend(field_value, ir_value_list_empty())
                let field_merge = ir_block_new_params(field_merge_block, field_params, ir_inst_list_empty(), ir_term_jump(target))
                let blocks = ir_block_list_append(
                  pipeline_lowered_blocks_blocks(field_blocks),
                  ir_block_list_prepend(field_merge, pipeline_lowered_record_field_blocks_blocks(rest))
                )
                pipeline_lowered_record_field_blocks_control(
                  pipeline_lowered_record_field_blocks_values(rest),
                  pipeline_lowered_record_field_blocks_next_block(rest),
                  pipeline_lowered_record_field_blocks_next_value(rest),
                  blocks,
                  1,
                  pipeline_lowered_record_field_blocks_falls_through(rest)
                )
              } else {
                pipeline_lowered_record_field_blocks_invalid(next_block, next_value)
              }
            }
          } else {
            pipeline_lowered_record_field_blocks_invalid(next_block, next_value)
          }
        } else {
          let lowered = pipeline_lower_expr_sidecar(value_expr, params, locals, src, tt, next_value)
          if ir_lowered_expr_is_valid(lowered) == 1 {
            let rest_start = next_block + 1
            let next_values = ir_record_field_list_append(values, ir_record_field_list_prepend(field_hash, ir_lowered_expr_value(lowered), ir_record_field_list_empty()))
            let rest = pipeline_lower_record_field_blocks(ctx, index + 1, ir_lowered_expr_next_value(lowered), rest_start, next_values)
            if pipeline_lowered_record_field_blocks_is_valid(rest) == 1 {
              let target = if index + 1 >= nfields { record_block } else { rest_start }
              let block = ir_block_new_term(next_block, ir_lowered_expr_insts(lowered), ir_term_jump(target))
              let blocks = ir_block_list_prepend(block, pipeline_lowered_record_field_blocks_blocks(rest))
              pipeline_lowered_record_field_blocks_control(
                pipeline_lowered_record_field_blocks_values(rest),
                pipeline_lowered_record_field_blocks_next_block(rest),
                pipeline_lowered_record_field_blocks_next_value(rest),
                blocks,
                1,
                pipeline_lowered_record_field_blocks_falls_through(rest)
              )
            } else {
              pipeline_lowered_record_field_blocks_invalid(next_block, next_value)
            }
          } else {
            pipeline_lowered_record_field_blocks_invalid(next_block, next_value)
          }
        }
      }
    }
  }
}

fn pipeline_lower_record_init_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let fields = node_f3(expr)
  let nfields = node_f4(expr)
  let record_block = next_block
  let first_field_block = next_block + 1
  let ctx = pipeline_record_field_ctx(fields, nfields, params, locals, src, tt, record_block)
  let lowered_fields = pipeline_lower_record_field_blocks(ctx, 0, next_value, first_field_block, ir_record_field_list_empty())
  if pipeline_lowered_record_field_blocks_is_valid(lowered_fields) == 1 {
    let entry = ir_block_new_term(start_block, ir_inst_list_empty(), ir_term_jump(first_field_block))
    if pipeline_lowered_record_field_blocks_falls_through(lowered_fields) == 0 {
      let blocks = ir_block_list_prepend(entry, pipeline_lowered_record_field_blocks_blocks(lowered_fields))
      pipeline_lowered_blocks_control(
        pipeline_lowered_record_field_blocks_next_block(lowered_fields),
        pipeline_lowered_record_field_blocks_next_value(lowered_fields),
        blocks,
        1,
        0
      )
    } else {
      let record_dst = pipeline_lowered_record_field_blocks_next_value(lowered_fields)
      let record_inst = ir_inst_list_prepend(
        ir_inst_record_init_i64(record_dst, str_hash(src, node_f1(expr), node_f2(expr)), pipeline_lowered_record_field_blocks_values(lowered_fields)),
        ir_inst_list_empty()
      )
      let record_args = ir_value_list_prepend(record_dst, ir_value_list_empty())
      let record = ir_block_new_term(record_block, record_inst, ir_term_jump_args(target_block, record_args))
      let blocks = ir_block_list_prepend(
        entry,
        ir_block_list_append(pipeline_lowered_record_field_blocks_blocks(lowered_fields), ir_block_list_prepend(record, ir_block_list_empty()))
      )
      pipeline_lowered_blocks(pipeline_lowered_record_field_blocks_next_block(lowered_fields), record_dst + 1, blocks, 1)
    }
  } else {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  }
}

fn pipeline_lower_field_access_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let base_expr = node_f1(expr)
  if pipeline_expr_needs_cfg(base_expr) == 1 {
    let base_merge_block = next_block
    let base_blocks = pipeline_lower_expr_to_target_blocks_reserved(base_expr, params, locals, module, next_value, start_block, next_block + 1, base_merge_block)
    if pipeline_lowered_blocks_is_valid(base_blocks) == 1 {
      if pipeline_lowered_blocks_falls_through(base_blocks) == 0 {
        base_blocks
      } else {
        let base_value = pipeline_lowered_blocks_next_value(base_blocks)
        let dst = base_value + 1
        let base_params = ir_value_list_prepend(base_value, ir_value_list_empty())
        let result_args = ir_value_list_prepend(dst, ir_value_list_empty())
        let field_inst = ir_inst_list_prepend(
          ir_inst_field_load_i64(dst, base_value, str_hash(src, node_f2(expr), node_f3(expr)), pipeline_field_access_index(expr)),
          ir_inst_list_empty()
        )
        let merge = ir_block_new_params(base_merge_block, base_params, field_inst, ir_term_jump_args(target_block, result_args))
        let blocks = ir_block_list_append(
          pipeline_lowered_blocks_blocks(base_blocks),
          ir_block_list_prepend(merge, ir_block_list_empty())
        )
        pipeline_lowered_blocks(pipeline_lowered_blocks_next_block(base_blocks), dst + 1, blocks, 1)
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  } else {
    pipeline_lower_straight_expr_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
  }
}

fn pipeline_lower_opt_chain_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let base_expr = node_f1(expr)
  if pipeline_expr_needs_cfg(base_expr) == 1 {
    let base_merge_block = next_block
    let base_blocks = pipeline_lower_expr_to_target_blocks_reserved(base_expr, params, locals, module, next_value, start_block, next_block + 1, base_merge_block)
    if pipeline_lowered_blocks_is_valid(base_blocks) == 1 {
      if pipeline_lowered_blocks_falls_through(base_blocks) == 0 {
        base_blocks
      } else {
        let base_value = pipeline_lowered_blocks_next_value(base_blocks)
        let dst = base_value + 1
        let base_params = ir_value_list_prepend(base_value, ir_value_list_empty())
        let result_args = ir_value_list_prepend(dst, ir_value_list_empty())
        let opt_inst = ir_inst_list_prepend(
          ir_inst_opt_chain_i64(dst, base_value, str_hash(src, node_f2(expr), node_f3(expr)), pipeline_opt_chain_field_index(expr, src, tt)),
          ir_inst_list_empty()
        )
        let merge = ir_block_new_params(base_merge_block, base_params, opt_inst, ir_term_jump_args(target_block, result_args))
        let blocks = ir_block_list_append(
          pipeline_lowered_blocks_blocks(base_blocks),
          ir_block_list_prepend(merge, ir_block_list_empty())
        )
        pipeline_lowered_blocks(pipeline_lowered_blocks_next_block(base_blocks), dst + 1, blocks, 1)
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  } else {
    pipeline_lower_straight_expr_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
  }
}

fn pipeline_lower_let_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let init_expr = node_f3(expr)
  let body_expr = node_f4(expr)
  if pipeline_expr_needs_cfg(init_expr) == 1 {
    let local_merge_block = next_block
    let init_blocks = pipeline_lower_expr_to_target_blocks_reserved(init_expr, params, locals, module, next_value, start_block, next_block + 1, local_merge_block)
    if pipeline_lowered_blocks_is_valid(init_blocks) == 1 {
      if pipeline_lowered_blocks_falls_through(init_blocks) == 0 {
        init_blocks
      } else {
        let local_value = pipeline_lowered_blocks_next_value(init_blocks)
        let body_start = pipeline_lowered_blocks_next_block(init_blocks)
        let next_locals = pipeline_value_env_push(locals, node_f1(expr), node_f2(expr), local_value)
        let body_blocks = pipeline_lower_expr_to_target_blocks(body_expr, params, next_locals, src, tt, local_value + 1, body_start, target_block)
        if pipeline_lowered_blocks_is_valid(body_blocks) == 1 {
          let local_params = ir_value_list_prepend(local_value, ir_value_list_empty())
          let local_merge = ir_block_new_params(local_merge_block, local_params, ir_inst_list_empty(), ir_term_jump(body_start))
          let blocks = ir_block_list_append(
            pipeline_lowered_blocks_blocks(init_blocks),
            ir_block_list_prepend(local_merge, pipeline_lowered_blocks_blocks(body_blocks))
          )
          pipeline_lowered_blocks_control(
            pipeline_lowered_blocks_next_block(body_blocks),
            pipeline_lowered_blocks_next_value(body_blocks),
            blocks,
            1,
            pipeline_lowered_blocks_falls_through(body_blocks)
          )
        } else {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        }
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  } else {
    let init = pipeline_lower_expr_sidecar(init_expr, params, locals, src, tt, next_value)
    if ir_lowered_expr_is_valid(init) == 1 {
      let next_locals = pipeline_value_env_push(locals, node_f1(expr), node_f2(expr), ir_lowered_expr_value(init))
      if pipeline_expr_needs_cfg(body_expr) == 1 {
        let body_start = next_block
        let body_blocks = pipeline_lower_expr_to_target_blocks(body_expr, params, next_locals, src, tt, ir_lowered_expr_next_value(init), body_start, target_block)
        if pipeline_lowered_blocks_is_valid(body_blocks) == 1 {
          let entry = ir_block_new_term(start_block, ir_lowered_expr_insts(init), ir_term_jump(body_start))
          let blocks = ir_block_list_prepend(entry, pipeline_lowered_blocks_blocks(body_blocks))
          pipeline_lowered_blocks_control(
            pipeline_lowered_blocks_next_block(body_blocks),
            pipeline_lowered_blocks_next_value(body_blocks),
            blocks,
            1,
            pipeline_lowered_blocks_falls_through(body_blocks)
          )
        } else {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        }
      } else {
        let body = pipeline_lower_expr_sidecar(body_expr, params, next_locals, src, tt, ir_lowered_expr_next_value(init))
        if ir_lowered_expr_is_valid(body) == 1 {
          let args = ir_value_list_prepend(ir_lowered_expr_value(body), ir_value_list_empty())
          let insts = ir_inst_list_append(ir_lowered_expr_insts(init), ir_lowered_expr_insts(body))
          let block = ir_block_new_term(start_block, insts, ir_term_jump_args(target_block, args))
          let blocks = ir_block_list_prepend(block, ir_block_list_empty())
          pipeline_lowered_blocks(next_block, ir_lowered_expr_next_value(body), blocks, 1)
        } else {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        }
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  }
}

fn pipeline_lower_let_mut_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let init_expr = node_f3(expr)
  let body_expr = node_f4(expr)
  if pipeline_expr_needs_cfg(init_expr) == 1 {
    let local_merge_block = next_block
    let init_blocks = pipeline_lower_expr_to_target_blocks_reserved(init_expr, params, locals, module, next_value, start_block, next_block + 1, local_merge_block)
    if pipeline_lowered_blocks_is_valid(init_blocks) == 1 {
      if pipeline_lowered_blocks_falls_through(init_blocks) == 0 {
        init_blocks
      } else {
        let local_value = pipeline_lowered_blocks_next_value(init_blocks)
        let slot = local_value + 1
        let body_start = pipeline_lowered_blocks_next_block(init_blocks)
        let slot_insts = ir_inst_list_prepend(
          ir_inst_slot_i64(slot),
          ir_inst_list_prepend(ir_inst_store_i64(slot, local_value), ir_inst_list_empty())
        )
        let next_locals = pipeline_value_env_push_slot(locals, node_f1(expr), node_f2(expr), slot)
        let body_blocks = pipeline_lower_expr_to_target_blocks(body_expr, params, next_locals, src, tt, slot + 1, body_start, target_block)
        if pipeline_lowered_blocks_is_valid(body_blocks) == 1 {
          let local_params = ir_value_list_prepend(local_value, ir_value_list_empty())
          let local_merge = ir_block_new_params(local_merge_block, local_params, slot_insts, ir_term_jump(body_start))
          let blocks = ir_block_list_append(
            pipeline_lowered_blocks_blocks(init_blocks),
            ir_block_list_prepend(local_merge, pipeline_lowered_blocks_blocks(body_blocks))
          )
          pipeline_lowered_blocks_control(
            pipeline_lowered_blocks_next_block(body_blocks),
            pipeline_lowered_blocks_next_value(body_blocks),
            blocks,
            1,
            pipeline_lowered_blocks_falls_through(body_blocks)
          )
        } else {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        }
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  } else {
    let init = pipeline_lower_expr_sidecar(init_expr, params, locals, src, tt, next_value)
    if ir_lowered_expr_is_valid(init) == 1 {
      let slot = ir_lowered_expr_next_value(init)
      let slot_insts = ir_inst_list_prepend(
        ir_inst_slot_i64(slot),
        ir_inst_list_prepend(ir_inst_store_i64(slot, ir_lowered_expr_value(init)), ir_inst_list_empty())
      )
      let next_locals = pipeline_value_env_push_slot(locals, node_f1(expr), node_f2(expr), slot)
      if pipeline_expr_needs_cfg(body_expr) == 1 {
        let body_start = next_block
        let body_blocks = pipeline_lower_expr_to_target_blocks(body_expr, params, next_locals, src, tt, slot + 1, body_start, target_block)
        if pipeline_lowered_blocks_is_valid(body_blocks) == 1 {
          let entry_insts = ir_inst_list_append(ir_lowered_expr_insts(init), slot_insts)
          let entry = ir_block_new_term(start_block, entry_insts, ir_term_jump(body_start))
          let blocks = ir_block_list_prepend(entry, pipeline_lowered_blocks_blocks(body_blocks))
          pipeline_lowered_blocks_control(
            pipeline_lowered_blocks_next_block(body_blocks),
            pipeline_lowered_blocks_next_value(body_blocks),
            blocks,
            1,
            pipeline_lowered_blocks_falls_through(body_blocks)
          )
        } else {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        }
      } else {
        let body = pipeline_lower_expr_sidecar(body_expr, params, next_locals, src, tt, slot + 1)
        if ir_lowered_expr_is_valid(body) == 1 {
          let args = ir_value_list_prepend(ir_lowered_expr_value(body), ir_value_list_empty())
          let insts = ir_inst_list_append(
            ir_lowered_expr_insts(init),
            ir_inst_list_append(slot_insts, ir_lowered_expr_insts(body))
          )
          let block = ir_block_new_term(start_block, insts, ir_term_jump_args(target_block, args))
          let blocks = ir_block_list_prepend(block, ir_block_list_empty())
          pipeline_lowered_blocks(next_block, ir_lowered_expr_next_value(body), blocks, 1)
        } else {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        }
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  }
}

fn pipeline_lower_assign_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let slot = pipeline_value_env_lookup(locals, src, node_f1(expr), node_f2(expr))
  if slot >= 0 {
    if pipeline_value_env_lookup_kind(locals, src, node_f1(expr), node_f2(expr)) == 1 {
      let value_expr = node_f3(expr)
      if pipeline_expr_needs_cfg(value_expr) == 1 {
        let assign_block = next_block
        let value_blocks = pipeline_lower_expr_to_target_blocks_reserved(value_expr, params, locals, module, next_value, start_block, next_block + 1, assign_block)
        if pipeline_lowered_blocks_is_valid(value_blocks) == 1 {
          if pipeline_lowered_blocks_falls_through(value_blocks) == 0 {
            value_blocks
          } else {
            let assign_value = pipeline_lowered_blocks_next_value(value_blocks)
            let nil_value = assign_value + 1
            let assign_params = ir_value_list_prepend(assign_value, ir_value_list_empty())
            let assign_args = ir_value_list_prepend(nil_value, ir_value_list_empty())
            let assign_insts = ir_inst_list_prepend(
              ir_inst_store_i64(slot, assign_value),
              ir_inst_list_prepend(ir_inst_const_i64(nil_value, 0), ir_inst_list_empty())
            )
            let assign_merge = ir_block_new_params(assign_block, assign_params, assign_insts, ir_term_jump_args(target_block, assign_args))
            let blocks = ir_block_list_append(
              pipeline_lowered_blocks_blocks(value_blocks),
              ir_block_list_prepend(assign_merge, ir_block_list_empty())
            )
            pipeline_lowered_blocks(pipeline_lowered_blocks_next_block(value_blocks), nil_value + 1, blocks, 1)
          }
        } else {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        }
      } else {
        pipeline_lower_straight_expr_to_target_blocks(expr, params, locals, module, next_value, start_block, next_block, target_block)
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  } else {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  }
}

fn pipeline_lower_block_rest_to_target_blocks(rest_node: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, next_value: i64, start_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  if rest_node == 0 {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  } else {
    pipeline_lower_expr_to_target_blocks(rest_node, params, locals, src, tt, next_value, start_block, target_block)
  }
}

fn pipeline_lower_block_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let first_expr = node_f1(expr)
  let rest_node = node_f2(expr)
  if rest_node == 0 {
    pipeline_lower_expr_to_target_blocks_reserved(first_expr, params, locals, module, next_value, start_block, next_block, target_block)
  } else {
    if pipeline_expr_needs_cfg(first_expr) == 1 {
      let discard_merge_block = next_block
      let first_blocks = pipeline_lower_expr_to_target_blocks_reserved(first_expr, params, locals, module, next_value, start_block, next_block + 1, discard_merge_block)
      if pipeline_lowered_blocks_is_valid(first_blocks) == 1 {
        if pipeline_lowered_blocks_falls_through(first_blocks) == 0 {
          first_blocks
        } else {
          let first_value = pipeline_lowered_blocks_next_value(first_blocks)
          let rest_start = pipeline_lowered_blocks_next_block(first_blocks)
          let rest_blocks = pipeline_lower_block_rest_to_target_blocks(rest_node, params, locals, src, tt, first_value + 1, rest_start, target_block)
          if pipeline_lowered_blocks_is_valid(rest_blocks) == 1 {
            let discard_params = ir_value_list_prepend(first_value, ir_value_list_empty())
            let discard_merge = ir_block_new_params(discard_merge_block, discard_params, ir_inst_list_empty(), ir_term_jump(rest_start))
            let blocks = ir_block_list_append(
              pipeline_lowered_blocks_blocks(first_blocks),
              ir_block_list_prepend(discard_merge, pipeline_lowered_blocks_blocks(rest_blocks))
            )
            pipeline_lowered_blocks_control(
              pipeline_lowered_blocks_next_block(rest_blocks),
              pipeline_lowered_blocks_next_value(rest_blocks),
              blocks,
              1,
              pipeline_lowered_blocks_falls_through(rest_blocks)
            )
          } else {
            pipeline_lowered_blocks_invalid(start_block, next_value)
          }
        }
      } else {
        pipeline_lowered_blocks_invalid(start_block, next_value)
      }
    } else {
      let first = pipeline_lower_expr_sidecar(first_expr, params, locals, src, tt, next_value)
      if ir_lowered_expr_is_valid(first) == 1 {
        let rest_start = next_block
        let rest_blocks = pipeline_lower_block_rest_to_target_blocks(rest_node, params, locals, src, tt, ir_lowered_expr_next_value(first), rest_start, target_block)
        if pipeline_lowered_blocks_is_valid(rest_blocks) == 1 {
          let entry = ir_block_new_term(start_block, ir_lowered_expr_insts(first), ir_term_jump(rest_start))
          let blocks = ir_block_list_prepend(entry, pipeline_lowered_blocks_blocks(rest_blocks))
          pipeline_lowered_blocks_control(
            pipeline_lowered_blocks_next_block(rest_blocks),
            pipeline_lowered_blocks_next_value(rest_blocks),
            blocks,
            1,
            pipeline_lowered_blocks_falls_through(rest_blocks)
          )
        } else {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        }
      } else {
        pipeline_lowered_blocks_invalid(start_block, next_value)
      }
    }
  }
}

fn pipeline_lower_call_arg_blocks(ctx: PipelineCallArgCtx, index: i64, next_value: i64, next_block: i64, values: IrValueList) -> PipelineLoweredCallBlocks {
  let args = pipeline_call_arg_ctx_args(ctx)
  let nargs = pipeline_call_arg_ctx_nargs(ctx)
  let params = pipeline_call_arg_ctx_params(ctx)
  let locals = pipeline_call_arg_ctx_locals(ctx)
  let src = pipeline_call_arg_ctx_src(ctx)
  let tt = pipeline_call_arg_ctx_tt(ctx)
  let module = pipeline_lower_module(src, tt)
  let call_block = pipeline_call_arg_ctx_call_block(ctx)
  if index >= nargs {
    pipeline_lowered_call_blocks(values, next_block, next_value, ir_block_list_empty(), 1)
  } else {
    let arg = nlist_get(args, index)
    if pipeline_expr_needs_cfg(arg) == 1 {
      let arg_merge_block = next_block + 1
      let arg_next_block = next_block + 2
      let arg_blocks = pipeline_lower_expr_to_target_blocks_reserved(arg, params, locals, module, next_value, next_block, arg_next_block, arg_merge_block)
      if pipeline_lowered_blocks_is_valid(arg_blocks) == 1 {
        if pipeline_lowered_blocks_falls_through(arg_blocks) == 0 {
          pipeline_lowered_call_blocks_control(
            values,
            pipeline_lowered_blocks_next_block(arg_blocks),
            pipeline_lowered_blocks_next_value(arg_blocks),
            pipeline_lowered_blocks_blocks(arg_blocks),
            1,
            0
          )
        } else {
          let arg_value = pipeline_lowered_blocks_next_value(arg_blocks)
          let rest_start = pipeline_lowered_blocks_next_block(arg_blocks)
          let next_values = ir_value_list_append(values, ir_value_list_prepend(arg_value, ir_value_list_empty()))
          let rest = pipeline_lower_call_arg_blocks(ctx, index + 1, arg_value + 1, rest_start, next_values)
          if pipeline_lowered_call_blocks_is_valid(rest) == 1 {
            let target = if index + 1 >= nargs { call_block } else { rest_start }
            let arg_params = ir_value_list_prepend(arg_value, ir_value_list_empty())
            let arg_merge = ir_block_new_params(arg_merge_block, arg_params, ir_inst_list_empty(), ir_term_jump(target))
            let blocks = ir_block_list_append(
              pipeline_lowered_blocks_blocks(arg_blocks),
              ir_block_list_prepend(arg_merge, pipeline_lowered_call_blocks_blocks(rest))
            )
            pipeline_lowered_call_blocks_control(
              pipeline_lowered_call_blocks_values(rest),
              pipeline_lowered_call_blocks_next_block(rest),
              pipeline_lowered_call_blocks_next_value(rest),
              blocks,
              1,
              pipeline_lowered_call_blocks_falls_through(rest)
            )
          } else {
            pipeline_lowered_call_blocks_invalid(next_block, next_value)
          }
        }
      } else {
        pipeline_lowered_call_blocks_invalid(next_block, next_value)
      }
    } else {
      let lowered = pipeline_lower_expr_sidecar(arg, params, locals, src, tt, next_value)
      if ir_lowered_expr_is_valid(lowered) == 1 {
        let rest_start = next_block + 1
        let next_values = ir_value_list_append(values, ir_value_list_prepend(ir_lowered_expr_value(lowered), ir_value_list_empty()))
        let rest = pipeline_lower_call_arg_blocks(ctx, index + 1, ir_lowered_expr_next_value(lowered), rest_start, next_values)
        if pipeline_lowered_call_blocks_is_valid(rest) == 1 {
          let target = if index + 1 >= nargs { call_block } else { rest_start }
          let block = ir_block_new_term(next_block, ir_lowered_expr_insts(lowered), ir_term_jump(target))
          let blocks = ir_block_list_prepend(block, pipeline_lowered_call_blocks_blocks(rest))
          pipeline_lowered_call_blocks_control(
            pipeline_lowered_call_blocks_values(rest),
            pipeline_lowered_call_blocks_next_block(rest),
            pipeline_lowered_call_blocks_next_value(rest),
            blocks,
            1,
            pipeline_lowered_call_blocks_falls_through(rest)
          )
        } else {
          pipeline_lowered_call_blocks_invalid(next_block, next_value)
        }
      } else {
        pipeline_lowered_call_blocks_invalid(next_block, next_value)
      }
    }
  }
}

fn pipeline_lower_straight_fn_sidecar(inner: i64, params: i64, src: i64, tt: i64, nparams: i64) -> IrFunctionList {
  let body = node_f4(inner)
  let lowered = pipeline_lower_expr_sidecar(body, params, pipeline_value_env_empty(), src, tt, nparams)
  if ir_lowered_expr_is_valid(lowered) == 1 {
    let block = ir_block_new_term(0, ir_lowered_expr_insts(lowered), ir_term_return(ir_lowered_expr_value(lowered)))
    let f = ir_function_new(str_hash(src, node_f1(inner), node_f2(inner)), nparams, block)
    ir_function_list_prepend(f, ir_function_list_empty())
  } else {
    ir_function_list_empty()
  }
}

fn pipeline_lower_cfg_fn_sidecar(inner: i64, params: i64, src: i64, tt: i64, nparams: i64) -> IrFunctionList {
  let body = node_f4(inner)
  let final_merge_block = 1
  let locals = pipeline_value_env_empty()
  let module = pipeline_lower_module(src, tt)
  let lowered = pipeline_lower_expr_to_target_blocks_reserved(body, params, locals, module, nparams, 0, 2, final_merge_block)
  if pipeline_lowered_blocks_is_valid(lowered) == 1 {
    if pipeline_lowered_blocks_falls_through(lowered) == 1 {
      let final_value = pipeline_lowered_blocks_next_value(lowered)
      let final_params = ir_value_list_prepend(final_value, ir_value_list_empty())
      let final_merge = ir_block_new_params(final_merge_block, final_params, ir_inst_list_empty(), ir_term_return(final_value))
      let blocks = ir_block_list_append(
        pipeline_lowered_blocks_blocks(lowered),
        ir_block_list_prepend(final_merge, ir_block_list_empty())
      )
      let f = ir_function_new_blocks(str_hash(src, node_f1(inner), node_f2(inner)), nparams, blocks)
      ir_function_list_prepend(f, ir_function_list_empty())
    } else {
      let f = ir_function_new_blocks(str_hash(src, node_f1(inner), node_f2(inner)), nparams, pipeline_lowered_blocks_blocks(lowered))
      ir_function_list_prepend(f, ir_function_list_empty())
    }
  } else {
    ir_function_list_empty()
  }
}

fn pipeline_lower_simple_fn_sidecar(pair: i64, tt: i64) -> IrFunctionList {
  let fn_wrap = node_f1(pair)
  let fn_src = node_f2(pair)
  let inner = pipeline_fn_inner(fn_wrap)
  let params = node_f3(inner)
  let body = node_f4(inner)
  let nparams = nlist_len(params)
  if pipeline_expr_needs_cfg(body) == 1 {
    pipeline_lower_cfg_fn_sidecar(inner, params, fn_src, tt, nparams)
  } else {
    pipeline_lower_straight_fn_sidecar(inner, params, fn_src, tt, nparams)
  }
}

fn pipeline_lower_fns_sidecar(fns: i64, tt: i64, user_src: i64) -> IrFunctionList {
  let mut result = ir_function_list_empty()
  let n = nlist_len(fns)
  for i in 0..n {
    let pair = nlist_get(fns, i)
    if node_f2(pair) == user_src {
      let one = pipeline_lower_simple_fn_sidecar(pair, tt)
      match one {
        IrFunctionNil -> 0
        IrFunctionCons(f, rest) -> { result = ir_function_list_prepend(f, result) }
      }
    } else { 0 }
  }
  result
}

fn pipeline_lower_typed_functions_internal(typed: TypedModule) -> IrFunctionList {
  match typed {
    TypedModule(fns, src, tt) -> pipeline_lower_fns_sidecar(fns, tt, src)
  }
}

fn pipeline_binary_buf(binary: BinaryObject) -> i64 {
  match binary {
    BinaryObject(o, kind) -> o
  }
}

fn pipeline_type_list_contains_rc(types: i64) -> i64 {
  if types == 0 { false }
  else {
    let mut found = false
    let mut i = 0
    while i < nlist_len(types) {
      if pipeline_ty_contains_rc(nlist_get(types, i)) {
        found = true
        i = nlist_len(types)
      } else { i = i + 1 }
    }
    found
  }
}

fn pipeline_type_list_contains_closure(types: i64) -> i64 {
  if types == 0 { false }
  else {
    let mut found = false
    let mut i = 0
    while i < nlist_len(types) {
      if pipeline_ty_contains_closure(nlist_get(types, i)) {
        found = true
        i = nlist_len(types)
      } else { i = i + 1 }
    }
    found
  }
}

fn pipeline_type_list_contains_weak(types: i64) -> i64 {
  if types == 0 { false }
  else {
    let mut found = false
    let mut i = 0
    while i < nlist_len(types) {
      if pipeline_ty_contains_weak(nlist_get(types, i)) {
        found = true
        i = nlist_len(types)
      } else { i = i + 1 }
    }
    found
  }
}

fn pipeline_ty_contains_rc(ty: i64) -> i64 {
  if ty == 0 { false }
  else {
    match ty_tag(ty) {
      3 -> pipeline_ty_contains_rc(ty_f1(ty)) or pipeline_ty_contains_rc(ty_f2(ty))
      4 -> pipeline_ty_contains_rc(ty_f1(ty)) or pipeline_ty_contains_rc(ty_f2(ty))
      5 -> pipeline_ty_contains_rc(ty_f1(ty))
      6 -> pipeline_type_list_contains_rc(ty_f1(ty)) or pipeline_ty_contains_rc(ty_f2(ty))
      9 -> {
        if ty_is_rc(ty) == 1 { true }
        else { pipeline_ty_contains_rc(ty_f2(ty)) or pipeline_type_list_contains_rc(ty_f3(ty)) }
      }
      18 -> pipeline_ty_contains_rc(ty_unique_inner(ty))
      19 -> pipeline_ty_contains_rc(ty_owned_inner(ty))
      _ -> false
    }
  }
}

fn pipeline_ty_contains_weak(ty: i64) -> i64 {
  if ty == 0 { false }
  else {
    match ty_tag(ty) {
      3 -> pipeline_ty_contains_weak(ty_f1(ty)) or pipeline_ty_contains_weak(ty_f2(ty))
      4 -> pipeline_ty_contains_weak(ty_f1(ty)) or pipeline_ty_contains_weak(ty_f2(ty))
      5 -> pipeline_ty_contains_weak(ty_f1(ty))
      6 -> pipeline_type_list_contains_weak(ty_f1(ty)) or pipeline_ty_contains_weak(ty_f2(ty))
      9 -> pipeline_ty_contains_weak(ty_f2(ty)) or pipeline_type_list_contains_weak(ty_f3(ty))
      16 -> true
      17 -> pipeline_ty_contains_weak(ty_f1(ty))
      18 -> pipeline_ty_contains_weak(ty_unique_inner(ty))
      19 -> pipeline_ty_contains_weak(ty_owned_inner(ty))
      _ -> false
    }
  }
}

fn pipeline_ty_contains_closure(ty: i64) -> i64 {
  if ty == 0 { false }
  else {
    match ty_tag(ty) {
      3 -> pipeline_ty_contains_closure(ty_f1(ty)) or pipeline_ty_contains_closure(ty_f2(ty))
      4 -> pipeline_ty_contains_closure(ty_f1(ty)) or pipeline_ty_contains_closure(ty_f2(ty))
      5 -> pipeline_ty_contains_closure(ty_f1(ty))
      6 -> true
      9 -> pipeline_ty_contains_closure(ty_f2(ty)) or pipeline_type_list_contains_closure(ty_f3(ty))
      18 -> pipeline_ty_contains_closure(ty_unique_inner(ty))
      19 -> pipeline_ty_contains_closure(ty_owned_inner(ty))
      _ -> false
    }
  }
}

fn pipeline_ty_needs_rc_runtime(ty: i64) -> i64 {
  pipeline_ty_contains_rc(ty) or pipeline_ty_contains_closure(ty) or pipeline_ty_contains_weak(ty)
}

fn pipeline_params_contain_rc(params: i64) -> i64 {
  if params == 0 { false }
  else {
    let mut found = false
    let mut i = 0
    while i < nlist_len(params) {
      if pipeline_ty_contains_rc(node_f3(nlist_get(params, i))) {
        found = true
        i = nlist_len(params)
      } else { i = i + 1 }
    }
    found
  }
}

fn pipeline_params_need_rc_runtime(params: i64) -> i64 {
  if params == 0 { false }
  else {
    let mut found = false
    let mut i = 0
    while i < nlist_len(params) {
      if pipeline_ty_needs_rc_runtime(node_f3(nlist_get(params, i))) {
        found = true
        i = nlist_len(params)
      } else { i = i + 1 }
    }
    found
  }
}

fn pipeline_hash_list_contains(list: i64, hash: i64) -> i64 {
  let mut found = false
  let mut i = 0
  while i < nlist_len(list) {
    if nlist_get(list, i) == hash {
      found = true
      i = nlist_len(list)
    } else { i = i + 1 }
  }
  found
}

fn pipeline_fn_name_hashes(fns: i64) -> i64 {
  let hashes = nlist_new()
  let mut i = 0
  while i < nlist_len(fns) {
    let pair = nlist_get(fns, i)
    if node_f4(pair) == 1 { 0 }
    else {
      let fn_wrap = node_f1(pair)
      let fn_src = node_f2(pair)
      let inner = pipeline_fn_inner(fn_wrap)
      nlist_add(hashes, str_hash(fn_src, node_f1(inner), node_f2(inner)))
    }
    i = i + 1
  }
  hashes
}

fn pipeline_locals_add_name(locals: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let next = nlist_new()
  let mut i = 0
  while i < nlist_len(locals) {
    nlist_add(next, nlist_get(locals, i))
    i = i + 1
  }
  nlist_add(next, str_hash(src, ns, nl))
  next
}

fn pipeline_params_add_locals(params: i64, src: i64, locals: i64) -> i64 {
  let mut result = locals
  if params == 0 { result }
  else {
    let mut i = 0
    while i < nlist_len(params) {
      let p = nlist_get(params, i)
      result = pipeline_locals_add_name(result, src, node_f1(p), node_f2(p))
      i = i + 1
    }
    result
  }
}

fn pipeline_expr_list_uses_function_value(args: i64, nargs: i64, src: i64, fnhashes: i64, locals: i64) -> i64 {
  let mut found = false
  let mut i = 0
  while i < nargs {
    if pipeline_expr_uses_function_value(nlist_get(args, i), src, fnhashes, locals) {
      found = true
      i = nargs
    } else { i = i + 1 }
  }
  found
}

fn pipeline_record_fields_use_function_value(fields: i64, nfields: i64, src: i64, fnhashes: i64, locals: i64) -> i64 {
  let mut found = false
  let mut i = 0
  while i < nfields {
    let field = nlist_get(fields, i)
    if pipeline_expr_uses_function_value(node_f3(field), src, fnhashes, locals) {
      found = true
      i = nfields
    } else { i = i + 1 }
  }
  found
}

fn pipeline_match_arms_use_function_value(arms: i64, narms: i64, src: i64, fnhashes: i64, locals: i64) -> i64 {
  let mut found = false
  let mut i = 0
  while i < narms {
    let arm = nlist_get(arms, i)
    if pipeline_expr_uses_function_value(node_f2(arm), src, fnhashes, locals) {
      found = true
      i = narms
    } else {
      if pipeline_expr_uses_function_value(node_f3(arm), src, fnhashes, locals) {
        found = true
        i = narms
      } else { i = i + 1 }
    }
  }
  found
}

fn pipeline_handle_clauses_use_function_value(clauses: i64, nclauses: i64, src: i64, fnhashes: i64, locals: i64) -> i64 {
  let mut found = false
  let mut i = 0
  while i < nclauses {
    let clause = nlist_get(clauses, i)
    let clause_locals = pipeline_params_add_locals(node_f2(clause), src, locals)
    if pipeline_expr_uses_function_value(node_f3(clause), src, fnhashes, clause_locals) {
      found = true
      i = nclauses
    } else { i = i + 1 }
  }
  found
}

fn pipeline_expr_uses_function_value(node: i64, src: i64, fnhashes: i64, locals: i64) -> i64 {
  if node == 0 { false }
  else {
    match node_tag(node) {
      2 -> {
        let h = str_hash(src, node_f1(node), node_f2(node))
        pipeline_hash_list_contains(fnhashes, h) and not pipeline_hash_list_contains(locals, h)
      }
      3 -> pipeline_expr_uses_function_value(node_f2(node), src, fnhashes, locals) or pipeline_expr_uses_function_value(node_f3(node), src, fnhashes, locals)
      4 -> pipeline_expr_list_uses_function_value(node_f3(node), node_f4(node), src, fnhashes, locals)
      5 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals) or pipeline_expr_uses_function_value(node_f2(node), src, fnhashes, locals) or pipeline_expr_uses_function_value(node_f3(node), src, fnhashes, locals)
      6 -> {
        if pipeline_expr_uses_function_value(node_f3(node), src, fnhashes, locals) { true }
        else {
          let next_locals = pipeline_locals_add_name(locals, src, node_f1(node), node_f2(node))
          pipeline_expr_uses_function_value(node_f4(node), src, fnhashes, next_locals)
        }
      }
      7 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals) or pipeline_expr_uses_function_value(node_f2(node), src, fnhashes, locals)
      10 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals) or pipeline_expr_uses_function_value(node_f2(node), src, fnhashes, locals)
      11 -> {
        if pipeline_expr_uses_function_value(node_f3(node), src, fnhashes, locals) { true }
        else {
          let next_locals = pipeline_locals_add_name(locals, src, node_f1(node), node_f2(node))
          pipeline_expr_uses_function_value(node_f4(node), src, fnhashes, next_locals)
        }
      }
      12 -> pipeline_expr_uses_function_value(node_f3(node), src, fnhashes, locals)
      13 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals)
      14 -> pipeline_record_fields_use_function_value(node_f3(node), node_f4(node), src, fnhashes, locals)
      15 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals) or pipeline_match_arms_use_function_value(node_f2(node), node_f3(node), src, fnhashes, locals)
      22 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals)
      25 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals)
      26 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals)
      29 -> {
        let lambda_locals = pipeline_params_add_locals(node_f1(node), src, locals)
        pipeline_expr_uses_function_value(node_f2(node), src, fnhashes, lambda_locals)
      }
      32 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals) or pipeline_expr_list_uses_function_value(node_f4(node), nlist_len(node_f4(node)), src, fnhashes, locals)
      33 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals) or pipeline_handle_clauses_use_function_value(node_f2(node), node_f3(node), src, fnhashes, locals)
      35 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals)
      36 -> pipeline_expr_uses_function_value(node_f2(node), src, fnhashes, locals)
      37 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals)
      41 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals) or pipeline_expr_list_uses_function_value(node_f3(node), nlist_len(node_f3(node)), src, fnhashes, locals)
      45 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals)
      46 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals) or pipeline_expr_uses_function_value(node_f2(node), src, fnhashes, locals)
      47 -> pipeline_expr_uses_function_value(node_f3(node), src, fnhashes, locals) or pipeline_expr_uses_function_value(node_f4(node), src, fnhashes, locals)
      48 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals)
      49 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals)
      52 -> pipeline_expr_uses_function_value(node_f1(node), src, fnhashes, locals) or pipeline_expr_uses_function_value(node_f2(node), src, fnhashes, locals)
      _ -> false
    }
  }
}

fn pipeline_rc_runtime_name(src: i64, ns: i64, nl: i64) -> i64 {
  src_eq(src, ns, nl, "rc_default_alloc") == 1 or
  src_eq(src, ns, nl, "rc_default_retain") == 1 or
  src_eq(src, ns, nl, "rc_default_release") == 1 or
  src_eq(src, ns, nl, "rc_default_weak_retain") == 1 or
  src_eq(src, ns, nl, "rc_default_weak_release") == 1 or
  src_eq(src, ns, nl, "rc_default_weak_load") == 1 or
  src_eq(src, ns, nl, "rc_default_promote") == 1 or
  src_eq(src, ns, nl, "rc_is_promoted") == 1 or
  src_eq(src, ns, nl, "weak_ref") == 1 or
  src_eq(src, ns, nl, "weak_load") == 1 or
  src_eq(src, ns, nl, "closure_default_retain") == 1 or
  src_eq(src, ns, nl, "closure_default_release") == 1 or
  src_eq(src, ns, nl, "closure_default_promote") == 1 or
  src_eq(src, ns, nl, "rc_count") == 1
}

fn pipeline_expr_list_needs_rc_runtime(args: i64, nargs: i64, src: i64) -> i64 {
  let mut found = false
  let mut i = 0
  while i < nargs {
    if pipeline_expr_needs_rc_runtime(nlist_get(args, i), src) {
      found = true
      i = nargs
    } else { i = i + 1 }
  }
  found
}

fn pipeline_record_fields_need_rc_runtime(fields: i64, nfields: i64, src: i64) -> i64 {
  let mut found = false
  let mut i = 0
  while i < nfields {
    let field = nlist_get(fields, i)
    if pipeline_expr_needs_rc_runtime(node_f3(field), src) {
      found = true
      i = nfields
    } else { i = i + 1 }
  }
  found
}

fn pipeline_match_arms_need_rc_runtime(arms: i64, narms: i64, src: i64) -> i64 {
  let mut found = false
  let mut i = 0
  while i < narms {
    let arm = nlist_get(arms, i)
    if pipeline_expr_needs_rc_runtime(node_f2(arm), src) {
      found = true
      i = narms
    } else {
      if pipeline_expr_needs_rc_runtime(node_f3(arm), src) {
        found = true
        i = narms
      } else { i = i + 1 }
    }
  }
  found
}

fn pipeline_handle_clauses_need_rc_runtime(clauses: i64, nclauses: i64, src: i64) -> i64 {
  let mut found = false
  let mut i = 0
  while i < nclauses {
    let clause = nlist_get(clauses, i)
    if pipeline_params_need_rc_runtime(node_f2(clause)) {
      found = true
      i = nclauses
    } else {
      if pipeline_expr_needs_rc_runtime(node_f3(clause), src) {
        found = true
        i = nclauses
      } else { i = i + 1 }
    }
  }
  found
}

fn pipeline_expr_needs_rc_runtime(node: i64, src: i64) -> i64 {
  if node == 0 { false }
  else {
    match node_tag(node) {
      3 -> pipeline_expr_needs_rc_runtime(node_f2(node), src) or pipeline_expr_needs_rc_runtime(node_f3(node), src)
      4 -> pipeline_rc_runtime_name(src, node_f1(node), node_f2(node)) or pipeline_expr_list_needs_rc_runtime(node_f3(node), node_f4(node), src)
      5 -> pipeline_expr_needs_rc_runtime(node_f1(node), src) or pipeline_expr_needs_rc_runtime(node_f2(node), src) or pipeline_expr_needs_rc_runtime(node_f3(node), src)
      6 -> pipeline_expr_needs_rc_runtime(node_f3(node), src) or pipeline_expr_needs_rc_runtime(node_f4(node), src)
      7 -> pipeline_expr_needs_rc_runtime(node_f1(node), src) or pipeline_expr_needs_rc_runtime(node_f2(node), src)
      10 -> pipeline_expr_needs_rc_runtime(node_f1(node), src) or pipeline_expr_needs_rc_runtime(node_f2(node), src)
      11 -> pipeline_expr_needs_rc_runtime(node_f3(node), src) or pipeline_expr_needs_rc_runtime(node_f4(node), src)
      12 -> pipeline_expr_needs_rc_runtime(node_f3(node), src)
      13 -> pipeline_expr_needs_rc_runtime(node_f1(node), src)
      14 -> pipeline_record_fields_need_rc_runtime(node_f3(node), node_f4(node), src)
      15 -> pipeline_expr_needs_rc_runtime(node_f1(node), src) or pipeline_match_arms_need_rc_runtime(node_f2(node), node_f3(node), src)
      22 -> pipeline_expr_needs_rc_runtime(node_f1(node), src)
      25 -> pipeline_expr_needs_rc_runtime(node_f1(node), src)
      26 -> pipeline_expr_needs_rc_runtime(node_f1(node), src)
      29 -> true
      32 -> pipeline_expr_needs_rc_runtime(node_f1(node), src) or pipeline_expr_list_needs_rc_runtime(node_f4(node), nlist_len(node_f4(node)), src)
      33 -> true
      35 -> pipeline_expr_needs_rc_runtime(node_f1(node), src)
      36 -> pipeline_type_list_contains_rc(node_f1(node)) or pipeline_type_list_contains_closure(node_f1(node)) or pipeline_type_list_contains_weak(node_f1(node)) or pipeline_expr_needs_rc_runtime(node_f2(node), src)
      37 -> pipeline_ty_needs_rc_runtime(node_f2(node)) or pipeline_expr_needs_rc_runtime(node_f1(node), src)
      41 -> pipeline_expr_needs_rc_runtime(node_f1(node), src) or pipeline_expr_list_needs_rc_runtime(node_f3(node), nlist_len(node_f3(node)), src)
      45 -> pipeline_expr_needs_rc_runtime(node_f1(node), src)
      46 -> pipeline_expr_needs_rc_runtime(node_f1(node), src) or pipeline_expr_needs_rc_runtime(node_f2(node), src)
      47 -> pipeline_expr_needs_rc_runtime(node_f3(node), src) or pipeline_expr_needs_rc_runtime(node_f4(node), src)
      48 -> pipeline_expr_needs_rc_runtime(node_f1(node), src)
      49 -> pipeline_expr_needs_rc_runtime(node_f1(node), src)
      52 -> pipeline_expr_needs_rc_runtime(node_f1(node), src) or pipeline_expr_needs_rc_runtime(node_f2(node), src)
      _ -> false
    }
  }
}

fn pipeline_fn_needs_rc_runtime(fn_wrap: i64, fn_src: i64, is_test: i64, fnhashes: i64) -> i64 {
  if is_test == 1 {
    pipeline_expr_needs_rc_runtime(node_f3(fn_wrap), fn_src) or
    pipeline_expr_uses_function_value(node_f3(fn_wrap), fn_src, fnhashes, nlist_new())
  } else {
    let inner = pipeline_fn_inner(fn_wrap)
    let locals = pipeline_params_add_locals(node_f3(inner), fn_src, nlist_new())
    pipeline_params_need_rc_runtime(node_f3(inner)) or
    pipeline_ty_needs_rc_runtime(fn_ret_type(fn_wrap)) or
    pipeline_expr_needs_rc_runtime(node_f4(inner), fn_src) or
    pipeline_expr_uses_function_value(node_f4(inner), fn_src, fnhashes, locals)
  }
}

fn pipeline_fns_need_rc_runtime(fns: i64) -> i64 {
  let mut found = false
  let fnhashes = pipeline_fn_name_hashes(fns)
  let mut i = 0
  while i < nlist_len(fns) {
    let pair = nlist_get(fns, i)
    if pipeline_fn_needs_rc_runtime(node_f1(pair), node_f2(pair), node_f4(pair), fnhashes) {
      found = true
      i = nlist_len(fns)
    } else { i = i + 1 }
  }
  found
}

fn pipeline_expr_list_needs_effects_runtime(args: i64, nargs: i64, src: i64) -> i64 {
  let mut found = false
  let mut i = 0
  while i < nargs {
    if pipeline_expr_needs_effects_runtime(nlist_get(args, i), src) {
      found = true
      i = nargs
    } else { i = i + 1 }
  }
  found
}

fn pipeline_record_fields_need_effects_runtime(fields: i64, nfields: i64, src: i64) -> i64 {
  let mut found = false
  let mut i = 0
  while i < nfields {
    let field = nlist_get(fields, i)
    if pipeline_expr_needs_effects_runtime(node_f3(field), src) {
      found = true
      i = nfields
    } else { i = i + 1 }
  }
  found
}

fn pipeline_match_arms_need_effects_runtime(arms: i64, narms: i64, src: i64) -> i64 {
  let mut found = false
  let mut i = 0
  while i < narms {
    let arm = nlist_get(arms, i)
    if pipeline_expr_needs_effects_runtime(node_f2(arm), src) {
      found = true
      i = narms
    } else {
      if pipeline_expr_needs_effects_runtime(node_f3(arm), src) {
        found = true
        i = narms
      } else { i = i + 1 }
    }
  }
  found
}

fn pipeline_handle_clauses_need_effects_runtime(clauses: i64, nclauses: i64, src: i64) -> i64 {
  let mut found = false
  let mut i = 0
  while i < nclauses {
    let clause = nlist_get(clauses, i)
    if pipeline_expr_needs_effects_runtime(node_f3(clause), src) {
      found = true
      i = nclauses
    } else { i = i + 1 }
  }
  found
}

fn pipeline_expr_needs_effects_runtime(node: i64, src: i64) -> i64 {
  if node == 0 { false }
  else {
    match node_tag(node) {
      3 -> pipeline_expr_needs_effects_runtime(node_f2(node), src) or pipeline_expr_needs_effects_runtime(node_f3(node), src)
      4 -> pipeline_expr_list_needs_effects_runtime(node_f3(node), node_f4(node), src)
      5 -> pipeline_expr_needs_effects_runtime(node_f1(node), src) or pipeline_expr_needs_effects_runtime(node_f2(node), src) or pipeline_expr_needs_effects_runtime(node_f3(node), src)
      6 -> pipeline_expr_needs_effects_runtime(node_f3(node), src) or pipeline_expr_needs_effects_runtime(node_f4(node), src)
      7 -> pipeline_expr_needs_effects_runtime(node_f1(node), src) or pipeline_expr_needs_effects_runtime(node_f2(node), src)
      10 -> pipeline_expr_needs_effects_runtime(node_f1(node), src) or pipeline_expr_needs_effects_runtime(node_f2(node), src)
      11 -> pipeline_expr_needs_effects_runtime(node_f3(node), src) or pipeline_expr_needs_effects_runtime(node_f4(node), src)
      12 -> pipeline_expr_needs_effects_runtime(node_f3(node), src)
      13 -> pipeline_expr_needs_effects_runtime(node_f1(node), src)
      14 -> pipeline_record_fields_need_effects_runtime(node_f3(node), node_f4(node), src)
      15 -> pipeline_expr_needs_effects_runtime(node_f1(node), src) or pipeline_match_arms_need_effects_runtime(node_f2(node), node_f3(node), src)
      22 -> pipeline_expr_needs_effects_runtime(node_f1(node), src)
      25 -> pipeline_expr_needs_effects_runtime(node_f1(node), src)
      26 -> pipeline_expr_needs_effects_runtime(node_f1(node), src)
      29 -> pipeline_expr_needs_effects_runtime(node_f2(node), src)
      32 -> true
      33 -> true
      35 -> pipeline_expr_needs_effects_runtime(node_f1(node), src)
      36 -> pipeline_expr_needs_effects_runtime(node_f2(node), src)
      37 -> pipeline_expr_needs_effects_runtime(node_f1(node), src)
      41 -> pipeline_expr_needs_effects_runtime(node_f1(node), src) or pipeline_expr_list_needs_effects_runtime(node_f3(node), nlist_len(node_f3(node)), src)
      45 -> true
      46 -> pipeline_expr_needs_effects_runtime(node_f1(node), src) or pipeline_expr_needs_effects_runtime(node_f2(node), src)
      47 -> pipeline_expr_needs_effects_runtime(node_f3(node), src) or pipeline_expr_needs_effects_runtime(node_f4(node), src)
      48 -> true
      49 -> pipeline_expr_needs_effects_runtime(node_f1(node), src)
      52 -> pipeline_expr_needs_effects_runtime(node_f1(node), src) or pipeline_expr_needs_effects_runtime(node_f2(node), src)
      _ -> false
    }
  }
}

fn pipeline_fn_needs_effects_runtime(fn_wrap: i64, fn_src: i64, is_test: i64) -> i64 {
  if is_test == 1 {
    pipeline_expr_needs_effects_runtime(node_f3(fn_wrap), fn_src)
  } else {
    let inner = pipeline_fn_inner(fn_wrap)
    pipeline_expr_needs_effects_runtime(node_f4(inner), fn_src)
  }
}

fn pipeline_fns_need_effects_runtime(fns: i64) -> i64 {
  let mut found = false
  let mut i = 0
  while i < nlist_len(fns) {
    let pair = nlist_get(fns, i)
    if pipeline_fn_needs_effects_runtime(node_f1(pair), node_f2(pair), node_f4(pair)) {
      found = true
      i = nlist_len(fns)
    } else { i = i + 1 }
  }
  found
}

fn pipeline_bind_runtime_preludes(fns: i64, src: i64, tt: i64) -> i64 {
  let had_effects_need = pipeline_fns_need_effects_runtime(fns)
  let had_rc_need = pipeline_fns_need_rc_runtime(fns)
  if had_effects_need {
    parse_use_file(fns, tt, "runtime/effects.weft")
  } else { 0 }
  if had_rc_need {
    parse_use_file(fns, tt, "runtime/rc.weft")
  } else { 0 }
  if had_effects_need == 0 {
    if had_rc_need {
      parse_use_file(fns, tt, "runtime/effects.weft")
    } else { if pipeline_fns_need_effects_runtime(fns) {
      parse_use_file(fns, tt, "runtime/effects.weft")
    } else { 0 } }
  } else { 0 }
  fns
}

fn pipeline_parse_source(src: i64, n: i64) -> AstModule {
  pipeline_parse_source_with_origin(src, n, 0, 1)
}

fn pipeline_strict_for_trust(trusted: i64) -> i64 {
  if trusted == 1 { 0 } else { 1 }
}

fn pipeline_parse_source_with_trust(src: i64, n: i64, trusted: i64) -> AstModule {
  pipeline_parse_source_with_origin(src, n, trusted, pipeline_strict_for_trust(trusted))
}

fn pipeline_mark_root_origin(tt: i64, src: i64, trusted: i64, strict: i64) -> i64 {
  if trusted == 1 {
    ttable_mark_trusted_source(tt, src)
  } else { if strict == 1 {
    ttable_mark_strict_source(tt, src)
  } else { 0 } }
}

fn pipeline_parse_source_with_origin(src: i64, n: i64, trusted: i64, strict: i64) -> AstModule {
  let grammar = weft_grammar()
  let tt = ttable_new()
  pipeline_mark_root_origin(tt, src, trusted, strict)
  let ast = pipeline_parse_module(grammar, src, n, tt)
  match ast {
    AstModule(fns, ast_src, ast_tt) -> {
      pipeline_bind_runtime_preludes(fns, ast_src, ast_tt)
      ast
    }
  }
}

fn pipeline_parse_source_with_diagnostics(src: i64, n: i64) -[Diagnose]> AstModule {
  pipeline_parse_source_with_diagnostics_and_origin(src, n, 0, 1)
}

fn pipeline_parse_source_with_diagnostics_and_trust(src: i64, n: i64, trusted: i64) -[Diagnose]> AstModule {
  pipeline_parse_source_with_diagnostics_and_origin(src, n, trusted, pipeline_strict_for_trust(trusted))
}

fn pipeline_parse_source_with_diagnostics_and_origin(src: i64, n: i64, trusted: i64, strict: i64) -[Diagnose]> AstModule {
  let grammar = weft_grammar()
  let tt = ttable_new()
  pipeline_mark_root_origin(tt, src, trusted, strict)
  let fns = grammar.parse(src, n, tt)
  pipeline_bind_runtime_preludes(fns, src, tt)
  AstModule(fns, src, tt)
}

fn pipeline_check_source(src: i64, n: i64) -> TypedModule {
  pipeline_check_source_with_origin(src, n, 0, 1)
}

fn pipeline_check_source_with_trust(src: i64, n: i64, trusted: i64) -> TypedModule {
  pipeline_check_source_with_origin(src, n, trusted, pipeline_strict_for_trust(trusted))
}

fn pipeline_check_source_with_origin(src: i64, n: i64, trusted: i64, strict: i64) -> TypedModule {
  let ast = pipeline_parse_source_with_origin(src, n, trusted, strict)
  pipeline_check_module(ast)
}

fn pipeline_check_source_with_diagnostics(src: i64, n: i64) -[Diagnose]> TypedModule {
  pipeline_check_source_with_diagnostics_and_origin(src, n, 0, 1)
}

fn pipeline_check_source_with_diagnostics_and_trust(src: i64, n: i64, trusted: i64) -[Diagnose]> TypedModule {
  pipeline_check_source_with_diagnostics_and_origin(src, n, trusted, pipeline_strict_for_trust(trusted))
}

fn pipeline_check_source_with_diagnostics_and_origin(src: i64, n: i64, trusted: i64, strict: i64) -[Diagnose]> TypedModule {
  match pipeline_parse_source_with_diagnostics_and_origin(src, n, trusted, strict) {
    AstModule(fns, ast_src, tt) -> pipeline_check_fns_with_diagnostics(fns, ast_src, tt)
  }
}

fn pipeline_handler_inline_stats(inline_sites: i64, residual_sites: i64) -> PipelineHandlerInlineStats {
  PipelineHandlerInlineStats(inline_sites, residual_sites)
}

fn pipeline_handler_inline_stats_inline_sites(stats: PipelineHandlerInlineStats) -> i64 {
  match stats {
    PipelineHandlerInlineStats(inline_sites, residual_sites) -> inline_sites
  }
}

fn pipeline_handler_inline_stats_residual_sites(stats: PipelineHandlerInlineStats) -> i64 {
  match stats {
    PipelineHandlerInlineStats(inline_sites, residual_sites) -> residual_sites
  }
}

fn pipeline_handler_inline_stats_from_ir_functions(functions: IrFunctionList) -> PipelineHandlerInlineStats {
  PipelineHandlerInlineStats(
    ir_function_list_count_tag(functions, 24),
    ir_function_list_count_tag(functions, 18)
  )
}

fn pipeline_handler_evidence_candidate_sites_from_ir_functions(functions: IrFunctionList) -> i64 {
  ir_function_list_count_tag(functions, 18)
}

fn pipeline_handler_inline_ctx_empty() -> PipelineHandlerInlineCtx {
  PipelineHandlerInlineCtxNil
}

fn pipeline_handler_inline_ctx_push_typed(ctx: PipelineHandlerInlineCtx, eff_hash: i64, clauses: HandlerClauseList, nclauses: i64) -> PipelineHandlerInlineCtx {
  PipelineHandlerInlineCtxCons(eff_hash, clauses, nclauses, ctx)
}

fn pipeline_handler_inline_ctx_push(ctx: PipelineHandlerInlineCtx, eff_hash: i64, clauses: i64, nclauses: i64) -> PipelineHandlerInlineCtx {
  pipeline_handler_inline_ctx_push_typed(ctx, eff_hash, handler_clause_list_from_nodes(clauses, 0, nclauses), nclauses)
}

fn pipeline_handler_clause_effect_hash(src: i64, clause: i64) -> i64 {
  let names = node_f1(clause)
  str_hash(src, node_f1(names), node_f2(names))
}

fn pipeline_handler_clause_op_hash(src: i64, clause: i64) -> i64 {
  let names = node_f1(clause)
  str_hash(src, node_f3(names), node_f4(names))
}

fn pipeline_handler_clause_effect_hash_typed(src: i64, clause: HandlerClause) -> i64 {
  match clause {
    HandlerClause(name_info, params, body, continuation) -> {
      match name_info {
        HandlerClauseName(eff_ns, eff_nl, op_ns, op_nl) -> str_hash(src, eff_ns, eff_nl)
        UnknownHandlerClauseName -> 0
      }
    }
    UnknownHandlerClause(tag) -> 0
  }
}

fn pipeline_handler_clause_op_hash_typed(src: i64, clause: HandlerClause) -> i64 {
  match clause {
    HandlerClause(name_info, params, body, continuation) -> {
      match name_info {
        HandlerClauseName(eff_ns, eff_nl, op_ns, op_nl) -> str_hash(src, op_ns, op_nl)
        UnknownHandlerClauseName -> 0
      }
    }
    UnknownHandlerClause(tag) -> 0
  }
}

fn pipeline_handler_clauses_have_op_hash(src: i64, clauses: i64, nclauses: i64, op_hash: i64) -> i64 {
  let mut found = 0
  let mut i = 0
  while i < nclauses {
    if pipeline_handler_clause_op_hash(src, nlist_get(clauses, i)) == op_hash {
      found = 1
      i = nclauses
    } else { i = i + 1 }
  }
  found
}

fn pipeline_handler_clause_index_for_op_hash(src: i64, clauses: i64, nclauses: i64, op_hash: i64) -> i64 {
  let mut result = 0 - 1
  let mut i = 0
  while i < nclauses {
    if pipeline_handler_clause_op_hash(src, nlist_get(clauses, i)) == op_hash {
      result = i
      i = nclauses
    } else { i = i + 1 }
  }
  result
}

fn pipeline_handler_clause_list_index_for_op_hash(src: i64, clauses: HandlerClauseList, nclauses: i64, op_hash: i64) -> i64 {
  let mut result = 0 - 1
  let mut i = 0
  while i < nclauses {
    if pipeline_handler_clause_op_hash_typed(src, handler_clause_list_nth(clauses, i)) == op_hash {
      result = i
      i = nclauses
    } else { i = i + 1 }
  }
  result
}

fn pipeline_handler_inline_match_found(found: PipelineHandlerInlineMatch) -> i64 {
  match found {
    PipelineHandlerInlineNoMatch -> 0
    PipelineHandlerInlineMatched(handler_depth, clause_index) -> 1
  }
}

fn pipeline_handler_inline_match_depth_or(found: PipelineHandlerInlineMatch, default: i64) -> i64 {
  match found {
    PipelineHandlerInlineNoMatch -> default
    PipelineHandlerInlineMatched(handler_depth, clause_index) -> handler_depth
  }
}

fn pipeline_handler_inline_match_clause_index_or(found: PipelineHandlerInlineMatch, default: i64) -> i64 {
  match found {
    PipelineHandlerInlineNoMatch -> default
    PipelineHandlerInlineMatched(handler_depth, clause_index) -> clause_index
  }
}

fn pipeline_handler_inline_ctx_find_match_at(ctx: PipelineHandlerInlineCtx, src: i64, eff_hash: i64, op_hash: i64, depth: i64) -> PipelineHandlerInlineMatch {
  match ctx {
    PipelineHandlerInlineCtxNil -> PipelineHandlerInlineNoMatch
    PipelineHandlerInlineCtxCons(ctx_eff_hash, clauses, nclauses, rest) -> {
      if ctx_eff_hash == eff_hash {
        let clause_index = pipeline_handler_clause_list_index_for_op_hash(src, clauses, nclauses, op_hash)
        if clause_index >= 0 {
          PipelineHandlerInlineMatched(depth, clause_index)
        } else {
          pipeline_handler_inline_ctx_find_match_at(rest, src, eff_hash, op_hash, depth + 1)
        }
      } else {
        pipeline_handler_inline_ctx_find_match_at(rest, src, eff_hash, op_hash, depth + 1)
      }
    }
  }
}

fn pipeline_handler_inline_ctx_find_match(ctx: PipelineHandlerInlineCtx, src: i64, eff_hash: i64, op_hash: i64) -> PipelineHandlerInlineMatch {
  pipeline_handler_inline_ctx_find_match_at(ctx, src, eff_hash, op_hash, 0)
}

fn pipeline_handler_inline_ctx_find(ctx: PipelineHandlerInlineCtx, src: i64, eff_hash: i64, op_hash: i64) -> i64 {
  pipeline_handler_inline_match_found(pipeline_handler_inline_ctx_find_match(ctx, src, eff_hash, op_hash))
}

fn pipeline_handler_lower_ctx(params: i64, locals: PipelineValueEnv, src: i64, tt: i64, handlers: PipelineHandlerInlineCtx) -> PipelineHandlerLowerCtx {
  PipelineHandlerLowerCtx(params, locals, src, tt, handlers)
}

fn pipeline_handler_lower_ctx_params(lower_ctx: PipelineHandlerLowerCtx) -> i64 {
  match lower_ctx {
    PipelineHandlerLowerCtx(params, locals, src, tt, handlers) -> params
  }
}

fn pipeline_handler_lower_ctx_locals(lower_ctx: PipelineHandlerLowerCtx) -> PipelineValueEnv {
  match lower_ctx {
    PipelineHandlerLowerCtx(params, locals, src, tt, handlers) -> locals
  }
}

fn pipeline_handler_lower_ctx_src(lower_ctx: PipelineHandlerLowerCtx) -> i64 {
  match lower_ctx {
    PipelineHandlerLowerCtx(params, locals, src, tt, handlers) -> src
  }
}

fn pipeline_handler_lower_ctx_tt(lower_ctx: PipelineHandlerLowerCtx) -> i64 {
  match lower_ctx {
    PipelineHandlerLowerCtx(params, locals, src, tt, handlers) -> tt
  }
}

fn pipeline_handler_lower_ctx_handlers(lower_ctx: PipelineHandlerLowerCtx) -> PipelineHandlerInlineCtx {
  match lower_ctx {
    PipelineHandlerLowerCtx(params, locals, src, tt, handlers) -> handlers
  }
}

fn pipeline_lower_handler_opt_args(args: i64, nargs: i64, index: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> PipelineLoweredArgs {
  if index >= nargs {
    pipeline_lowered_args(ir_value_list_empty(), next_value, ir_inst_list_empty(), 1)
  } else {
    let params = pipeline_handler_lower_ctx_params(lower_ctx)
    let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
    let src = pipeline_handler_lower_ctx_src(lower_ctx)
    let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
    let handlers = pipeline_handler_lower_ctx_handlers(lower_ctx)
    let arg = pipeline_lower_expr_sidecar_handler_opt(nlist_get(args, index), params, locals, src, tt, next_value, handlers)
    if ir_lowered_expr_is_valid(arg) == 1 {
      let rest = pipeline_lower_handler_opt_args(args, nargs, index + 1, ir_lowered_expr_next_value(arg), lower_ctx)
      if pipeline_lowered_args_is_valid(rest) == 1 {
        let values = ir_value_list_prepend(ir_lowered_expr_value(arg), pipeline_lowered_args_values(rest))
        let insts = ir_inst_list_append(ir_lowered_expr_insts(arg), pipeline_lowered_args_insts(rest))
        pipeline_lowered_args(values, pipeline_lowered_args_next_value(rest), insts, 1)
      } else {
        pipeline_lowered_args_invalid(next_value)
      }
    } else {
      pipeline_lowered_args_invalid(next_value)
    }
  }
}

fn pipeline_lower_binop_expr_sidecar_handler_opt(expr: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, next_value: i64, ctx: PipelineHandlerInlineCtx) -> IrLoweredExpr {
  let lhs = pipeline_lower_expr_sidecar_handler_opt(node_f2(expr), params, locals, src, tt, next_value, ctx)
  if ir_lowered_expr_is_valid(lhs) == 1 {
    let rhs = pipeline_lower_expr_sidecar_handler_opt(node_f3(expr), params, locals, src, tt, ir_lowered_expr_next_value(lhs), ctx)
    if ir_lowered_expr_is_valid(rhs) == 1 {
      let op = ir_binary_op_from_parser(node_f1(expr))
      if ir_binary_op_is_supported(op) == 1 {
        let dst = ir_lowered_expr_next_value(rhs)
        let binary = ir_inst_list_prepend(
          ir_inst_binary_i64(dst, op, ir_lowered_expr_value(lhs), ir_lowered_expr_value(rhs)),
          ir_inst_list_empty()
        )
        let insts = ir_inst_list_append(
          ir_lowered_expr_insts(lhs),
          ir_inst_list_append(ir_lowered_expr_insts(rhs), binary)
        )
        ir_lowered_expr(dst, dst + 1, insts)
      } else {
        ir_lowered_expr_invalid(next_value)
      }
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_block_expr_sidecar_handler_opt(expr: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, next_value: i64, ctx: PipelineHandlerInlineCtx) -> IrLoweredExpr {
  let first = pipeline_lower_expr_sidecar_handler_opt(node_f1(expr), params, locals, src, tt, next_value, ctx)
  if ir_lowered_expr_is_valid(first) == 1 {
    let rest_node = node_f2(expr)
    if rest_node == 0 {
      first
    } else {
      let rest = pipeline_lower_expr_sidecar_handler_opt(rest_node, params, locals, src, tt, ir_lowered_expr_next_value(first), ctx)
      if ir_lowered_expr_is_valid(rest) == 1 {
        ir_lowered_expr(
          ir_lowered_expr_value(rest),
          ir_lowered_expr_next_value(rest),
          ir_inst_list_append(ir_lowered_expr_insts(first), ir_lowered_expr_insts(rest))
        )
      } else {
        ir_lowered_expr_invalid(next_value)
      }
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_let_expr_sidecar_handler_opt(expr: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, next_value: i64, ctx: PipelineHandlerInlineCtx) -> IrLoweredExpr {
  let value = pipeline_lower_expr_sidecar_handler_opt(node_f3(expr), params, locals, src, tt, next_value, ctx)
  if ir_lowered_expr_is_valid(value) == 1 {
    let next_locals = pipeline_value_env_push(locals, node_f1(expr), node_f2(expr), ir_lowered_expr_value(value))
    let body = pipeline_lower_expr_sidecar_handler_opt(node_f4(expr), params, next_locals, src, tt, ir_lowered_expr_next_value(value), ctx)
    if ir_lowered_expr_is_valid(body) == 1 {
      let bind = ir_inst_list_prepend(ir_inst_bind_i64(node_f1(expr), node_f2(expr), ir_lowered_expr_value(value)), ir_inst_list_empty())
      ir_lowered_expr(
        ir_lowered_expr_value(body),
        ir_lowered_expr_next_value(body),
        ir_inst_list_append(ir_lowered_expr_insts(value), ir_inst_list_append(bind, ir_lowered_expr_insts(body)))
      )
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_perform_expr_sidecar_handler_opt(expr: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, next_value: i64, ctx: PipelineHandlerInlineCtx) -> IrLoweredExpr {
  let lhs = node_f1(expr)
  if node_tag(lhs) == 2 {
    let args_node = node_f4(expr)
    let lower_ctx = pipeline_handler_lower_ctx(params, locals, src, tt, ctx)
    let args = pipeline_lower_handler_opt_args(args_node, nlist_len(args_node), 0, next_value, lower_ctx)
    if pipeline_lowered_args_is_valid(args) == 1 {
      let dst = pipeline_lowered_args_next_value(args)
      let eff_hash = effect_name_hash(src, node_f1(lhs), node_f2(lhs))
      let op_hash = effect_name_hash(src, node_f2(expr), node_f3(expr))
      let found = pipeline_handler_inline_ctx_find_match(ctx, src, eff_hash, op_hash)
      let op_inst = if pipeline_handler_inline_match_found(found) == 1 {
        ir_inst_handler_direct_i64(
          dst,
          eff_hash,
          op_hash,
          pipeline_handler_inline_match_depth_or(found, 0 - 1),
          pipeline_handler_inline_match_clause_index_or(found, 0 - 1),
          pipeline_lowered_args_values(args)
        )
      } else {
        ir_inst_perform_i64(dst, eff_hash, op_hash, pipeline_lowered_args_values(args))
      }
      let perform = ir_inst_list_prepend(op_inst, ir_inst_list_empty())
      let insts = ir_inst_list_append(pipeline_lowered_args_insts(args), perform)
      ir_lowered_expr(dst, dst + 1, insts)
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_generic_call_expr_sidecar_handler_opt(expr: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, next_value: i64, ctx: PipelineHandlerInlineCtx) -> IrLoweredExpr {
  let call_node = node_f2(expr)
  if pipeline_call_callee_is_direct(params, locals, src, node_f1(call_node), node_f2(call_node)) == 1 {
    let lower_ctx = pipeline_handler_lower_ctx(params, locals, src, tt, ctx)
    let args = pipeline_lower_handler_opt_args(node_f3(call_node), node_f4(call_node), 0, next_value, lower_ctx)
    if pipeline_lowered_args_is_valid(args) == 1 {
      let dst = pipeline_lowered_args_next_value(args)
      let call = ir_inst_list_prepend(
        pipeline_generic_call_inst(dst, src, tt, node_f1(call_node), node_f2(call_node), node_f1(expr), pipeline_lowered_args_values(args)),
        ir_inst_list_empty()
      )
      let insts = ir_inst_list_append(pipeline_lowered_args_insts(args), call)
      ir_lowered_expr(dst, dst + 1, insts)
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_handle_expr_sidecar_handler_opt(expr: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, next_value: i64, ctx: PipelineHandlerInlineCtx) -> IrLoweredExpr {
  let body = node_f1(expr)
  let clauses = node_f2(expr)
  let nclauses = node_f3(expr)
  if nclauses <= 0 {
    pipeline_lower_expr_sidecar(expr, params, locals, src, tt, next_value)
  } else {
    let eff_hash = pipeline_handler_clause_effect_hash(src, nlist_get(clauses, 0))
    let next_ctx = pipeline_handler_inline_ctx_push(ctx, eff_hash, clauses, nclauses)
    let lowered = pipeline_lower_expr_sidecar_handler_opt(body, params, locals, src, tt, next_value, next_ctx)
    if ir_lowered_expr_is_valid(lowered) == 1 {
      let marker = ir_inst_list_prepend(ir_inst_handle_i64(0 - 1, body, clauses, nclauses), ir_inst_list_empty())
      let pop = ir_inst_list_prepend(ir_inst_handler_pop_i64(0 - 1), ir_inst_list_empty())
      ir_lowered_expr(
        ir_lowered_expr_value(lowered),
        ir_lowered_expr_next_value(lowered),
        ir_inst_list_append(marker, ir_inst_list_append(ir_lowered_expr_insts(lowered), pop))
      )
    } else {
      pipeline_lower_expr_sidecar(expr, params, locals, src, tt, next_value)
    }
  }
}

fn pipeline_lower_expr_sidecar_handler_opt(expr: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, next_value: i64, ctx: PipelineHandlerInlineCtx) -> IrLoweredExpr {
  let tag = node_tag(expr)
  match tag {
    1 -> pipeline_lower_expr_sidecar(expr, params, locals, src, tt, next_value)
    2 -> pipeline_lower_expr_sidecar(expr, params, locals, src, tt, next_value)
    3 -> pipeline_lower_binop_expr_sidecar_handler_opt(expr, params, locals, src, tt, next_value, ctx)
    6 -> pipeline_lower_let_expr_sidecar_handler_opt(expr, params, locals, src, tt, next_value, ctx)
    7 -> pipeline_lower_block_expr_sidecar_handler_opt(expr, params, locals, src, tt, next_value, ctx)
    9 -> pipeline_lower_expr_sidecar(expr, params, locals, src, tt, next_value)
    22 -> pipeline_lower_not_expr_sidecar(expr, params, locals, src, tt, next_value)
    24 -> pipeline_lower_expr_sidecar(expr, params, locals, src, tt, next_value)
    32 -> pipeline_lower_perform_expr_sidecar_handler_opt(expr, params, locals, src, tt, next_value, ctx)
    33 -> pipeline_lower_handle_expr_sidecar_handler_opt(expr, params, locals, src, tt, next_value, ctx)
    35 -> pipeline_lower_expr_sidecar_handler_opt(node_f1(expr), params, locals, src, tt, next_value, ctx)
    36 -> pipeline_lower_generic_call_expr_sidecar_handler_opt(expr, params, locals, src, tt, next_value, ctx)
    37 -> pipeline_lower_expr_sidecar_handler_opt(node_f1(expr), params, locals, src, tt, next_value, ctx)
    51 -> pipeline_lower_expr_sidecar(expr, params, locals, src, tt, next_value)
    _ -> ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_ident_expr_typed_sidecar_handler_opt(ns: i64, nl: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, next_value: i64) -> IrLoweredExpr {
  let local_id = pipeline_value_env_lookup(locals, src, ns, nl)
  if local_id >= 0 {
    if pipeline_value_env_lookup_kind(locals, src, ns, nl) == 1 {
      ir_lowered_expr(
        next_value,
        next_value + 1,
        ir_inst_list_prepend(ir_inst_load_i64(next_value, local_id), ir_inst_list_empty())
      )
    } else {
      ir_lowered_expr(local_id, next_value, ir_inst_list_empty())
    }
  } else {
    let param_id = pipeline_param_index(params, src, ns, nl)
    if param_id >= 0 {
      ir_lowered_expr(param_id, next_value, ir_inst_list_empty())
    } else {
      let tag_hash = pipeline_variant_tag_hash(tt, src, ns, nl)
      let payload_count = pipeline_variant_payload_count(tt, src, ns, nl)
      if tag_hash >= 0 {
        if payload_count == 0 {
          ir_lowered_expr(
            next_value,
            next_value + 1,
            ir_inst_list_prepend(ir_inst_variant_init_i64(next_value, tag_hash, ir_value_list_empty()), ir_inst_list_empty())
          )
        } else {
          ir_lowered_expr_invalid(next_value)
        }
      } else {
        ir_lowered_expr_invalid(next_value)
      }
    }
  }
}

fn pipeline_lower_typed_handler_opt_args(args: ExprList, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> PipelineLoweredArgs {
  match args {
    ExprListNil -> pipeline_lowered_args(ir_value_list_empty(), next_value, ir_inst_list_empty(), 1)
    ExprListCons(expr, rest_exprs) -> {
      let params = pipeline_handler_lower_ctx_params(lower_ctx)
      let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
      let src = pipeline_handler_lower_ctx_src(lower_ctx)
      let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
      let handlers = pipeline_handler_lower_ctx_handlers(lower_ctx)
      let arg = pipeline_lower_expr_typed_sidecar_handler_opt(expr, params, locals, src, tt, next_value, handlers)
      if ir_lowered_expr_is_valid(arg) == 1 {
        let rest = pipeline_lower_typed_handler_opt_args(rest_exprs, ir_lowered_expr_next_value(arg), lower_ctx)
        if pipeline_lowered_args_is_valid(rest) == 1 {
          let values = ir_value_list_prepend(ir_lowered_expr_value(arg), pipeline_lowered_args_values(rest))
          let insts = ir_inst_list_append(ir_lowered_expr_insts(arg), pipeline_lowered_args_insts(rest))
          pipeline_lowered_args(values, pipeline_lowered_args_next_value(rest), insts, 1)
        } else {
          pipeline_lowered_args_invalid(next_value)
        }
      } else {
        pipeline_lowered_args_invalid(next_value)
      }
    }
  }
}

fn pipeline_lower_binop_expr_typed_sidecar_handler_opt(op_id: i64, lhs_expr: Expr, rhs_expr: Expr, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let ctx = pipeline_handler_lower_ctx_handlers(lower_ctx)
  let lhs = pipeline_lower_expr_typed_sidecar_handler_opt(lhs_expr, params, locals, src, tt, next_value, ctx)
  if ir_lowered_expr_is_valid(lhs) == 1 {
    let rhs = pipeline_lower_expr_typed_sidecar_handler_opt(rhs_expr, params, locals, src, tt, ir_lowered_expr_next_value(lhs), ctx)
    if ir_lowered_expr_is_valid(rhs) == 1 {
      let op = ir_binary_op_from_parser(op_id)
      if ir_binary_op_is_supported(op) == 1 {
        let dst = ir_lowered_expr_next_value(rhs)
        let binary = ir_inst_list_prepend(
          ir_inst_binary_i64(dst, op, ir_lowered_expr_value(lhs), ir_lowered_expr_value(rhs)),
          ir_inst_list_empty()
        )
        let insts = ir_inst_list_append(
          ir_lowered_expr_insts(lhs),
          ir_inst_list_append(ir_lowered_expr_insts(rhs), binary)
        )
        ir_lowered_expr(dst, dst + 1, insts)
      } else {
        ir_lowered_expr_invalid(next_value)
      }
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_not_expr_typed_sidecar_handler_opt(operand: Expr, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let ctx = pipeline_handler_lower_ctx_handlers(lower_ctx)
  let value = pipeline_lower_expr_typed_sidecar_handler_opt(operand, params, locals, src, tt, next_value, ctx)
  if ir_lowered_expr_is_valid(value) == 1 {
    let dst = ir_lowered_expr_next_value(value)
    let unary = ir_inst_list_prepend(
      ir_inst_unary_i64(dst, ir_unary_op_not(), ir_lowered_expr_value(value)),
      ir_inst_list_empty()
    )
    let insts = ir_inst_list_append(ir_lowered_expr_insts(value), unary)
    ir_lowered_expr(dst, dst + 1, insts)
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_block_expr_typed_sidecar_handler_opt(first_expr: Expr, rest_expr: Expr, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let ctx = pipeline_handler_lower_ctx_handlers(lower_ctx)
  let first = pipeline_lower_expr_typed_sidecar_handler_opt(first_expr, params, locals, src, tt, next_value, ctx)
  if ir_lowered_expr_is_valid(first) == 1 {
    match rest_expr {
      UnknownExpr(tag) -> {
        if tag == 0 {
          first
        } else {
          let rest = pipeline_lower_expr_typed_sidecar_handler_opt(rest_expr, params, locals, src, tt, ir_lowered_expr_next_value(first), ctx)
          if ir_lowered_expr_is_valid(rest) == 1 {
            ir_lowered_expr(
              ir_lowered_expr_value(rest),
              ir_lowered_expr_next_value(rest),
              ir_inst_list_append(ir_lowered_expr_insts(first), ir_lowered_expr_insts(rest))
            )
          } else {
            ir_lowered_expr_invalid(next_value)
          }
        }
      }
      _ -> {
        let rest = pipeline_lower_expr_typed_sidecar_handler_opt(rest_expr, params, locals, src, tt, ir_lowered_expr_next_value(first), ctx)
        if ir_lowered_expr_is_valid(rest) == 1 {
          ir_lowered_expr(
            ir_lowered_expr_value(rest),
            ir_lowered_expr_next_value(rest),
            ir_inst_list_append(ir_lowered_expr_insts(first), ir_lowered_expr_insts(rest))
          )
        } else {
          ir_lowered_expr_invalid(next_value)
        }
      }
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_let_expr_typed_sidecar_handler_opt(ns: i64, nl: i64, value_expr: Expr, body_expr: Expr, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let ctx = pipeline_handler_lower_ctx_handlers(lower_ctx)
  let value = pipeline_lower_expr_typed_sidecar_handler_opt(value_expr, params, locals, src, tt, next_value, ctx)
  if ir_lowered_expr_is_valid(value) == 1 {
    let next_locals = pipeline_value_env_push(locals, ns, nl, ir_lowered_expr_value(value))
    let body = pipeline_lower_expr_typed_sidecar_handler_opt(body_expr, params, next_locals, src, tt, ir_lowered_expr_next_value(value), ctx)
    if ir_lowered_expr_is_valid(body) == 1 {
      let bind = ir_inst_list_prepend(ir_inst_bind_i64(ns, nl, ir_lowered_expr_value(value)), ir_inst_list_empty())
      ir_lowered_expr(
        ir_lowered_expr_value(body),
        ir_lowered_expr_next_value(body),
        ir_inst_list_append(ir_lowered_expr_insts(value), ir_inst_list_append(bind, ir_lowered_expr_insts(body)))
      )
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_perform_expr_typed_sidecar_handler_opt(lhs_expr: Expr, op_ns: i64, op_nl: i64, args_exprs: ExprList, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let ctx = pipeline_handler_lower_ctx_handlers(lower_ctx)
  match lhs_expr {
    Ident(eff_ns, eff_nl) -> {
      let args = pipeline_lower_typed_handler_opt_args(args_exprs, next_value, lower_ctx)
      if pipeline_lowered_args_is_valid(args) == 1 {
        let dst = pipeline_lowered_args_next_value(args)
        let eff_hash = effect_name_hash(src, eff_ns, eff_nl)
        let op_hash = effect_name_hash(src, op_ns, op_nl)
        let found = pipeline_handler_inline_ctx_find_match(ctx, src, eff_hash, op_hash)
        let op_inst = if pipeline_handler_inline_match_found(found) == 1 {
          ir_inst_handler_direct_i64(
            dst,
            eff_hash,
            op_hash,
            pipeline_handler_inline_match_depth_or(found, 0 - 1),
            pipeline_handler_inline_match_clause_index_or(found, 0 - 1),
            pipeline_lowered_args_values(args)
          )
        } else {
          ir_inst_perform_i64(dst, eff_hash, op_hash, pipeline_lowered_args_values(args))
        }
        let perform = ir_inst_list_prepend(op_inst, ir_inst_list_empty())
        let insts = ir_inst_list_append(pipeline_lowered_args_insts(args), perform)
        ir_lowered_expr(dst, dst + 1, insts)
      } else {
        ir_lowered_expr_invalid(next_value)
      }
    }
    _ -> ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_generic_call_expr_typed_sidecar_handler_opt(type_args: TypeExprList, inner_call: Expr, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  match inner_call {
    Call(ns, nl, args_exprs) -> {
      if pipeline_variant_payload_count(tt, src, ns, nl) >= 0 {
        ir_lowered_expr_invalid(next_value)
      } else { if pipeline_call_callee_is_direct(params, locals, src, ns, nl) == 1 {
        let args = pipeline_lower_typed_handler_opt_args(args_exprs, next_value, lower_ctx)
        if pipeline_lowered_args_is_valid(args) == 1 {
          let dst = pipeline_lowered_args_next_value(args)
          let call = ir_inst_list_prepend(
            pipeline_generic_call_inst_typed(dst, src, tt, ns, nl, type_args, pipeline_lowered_args_values(args)),
            ir_inst_list_empty()
          )
          let insts = ir_inst_list_append(pipeline_lowered_args_insts(args), call)
          ir_lowered_expr(dst, dst + 1, insts)
        } else {
          ir_lowered_expr_invalid(next_value)
        }
      } else {
        ir_lowered_expr_invalid(next_value)
      } }
    }
    _ -> ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_handle_expr_typed_sidecar_handler_opt(body_expr: Expr, clauses: HandlerClauseList, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let ctx = pipeline_handler_lower_ctx_handlers(lower_ctx)
  let nclauses = handler_clause_list_len(clauses)
  if nclauses <= 0 {
    ir_lowered_expr_invalid(next_value)
  } else {
    let eff_hash = pipeline_handler_clause_effect_hash_typed(src, handler_clause_list_nth(clauses, 0))
    let next_ctx = pipeline_handler_inline_ctx_push_typed(ctx, eff_hash, clauses, nclauses)
    let lowered = pipeline_lower_expr_typed_sidecar_handler_opt(body_expr, params, locals, src, tt, next_value, next_ctx)
    if ir_lowered_expr_is_valid(lowered) == 1 {
      let marker = ir_inst_list_prepend(IrHandleI64(0 - 1, body_expr, clauses, nclauses), ir_inst_list_empty())
      let pop = ir_inst_list_prepend(ir_inst_handler_pop_i64(0 - 1), ir_inst_list_empty())
      ir_lowered_expr(
        ir_lowered_expr_value(lowered),
        ir_lowered_expr_next_value(lowered),
        ir_inst_list_append(marker, ir_inst_list_append(ir_lowered_expr_insts(lowered), pop))
      )
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  }
}

fn pipeline_lower_expr_typed_sidecar_handler_opt(expr: Expr, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, next_value: i64, ctx: PipelineHandlerInlineCtx) -> IrLoweredExpr {
  let lower_ctx = pipeline_handler_lower_ctx(params, locals, src, tt, ctx)
  match expr {
    IntLit(value) -> ir_lowered_expr(
      next_value,
      next_value + 1,
      ir_inst_list_prepend(ir_inst_const_i64(next_value, value), ir_inst_list_empty())
    )
    BoolLit(value) -> ir_lowered_expr(
      next_value,
      next_value + 1,
      ir_inst_list_prepend(ir_inst_const_i64(next_value, value), ir_inst_list_empty())
    )
    NilExpr -> ir_lowered_expr(
      next_value,
      next_value + 1,
      ir_inst_list_prepend(ir_inst_const_i64(next_value, 0), ir_inst_list_empty())
    )
    StringLit(start, len) -> ir_lowered_expr(
      next_value,
      next_value + 1,
      ir_inst_list_prepend(ir_inst_string_lit(next_value, start, len), ir_inst_list_empty())
    )
    Ident(ns, nl) -> pipeline_lower_ident_expr_typed_sidecar_handler_opt(ns, nl, params, locals, src, tt, next_value)
    BinOp(op, lhs, rhs) -> pipeline_lower_binop_expr_typed_sidecar_handler_opt(op, lhs, rhs, next_value, lower_ctx)
    Let(ns, nl, value, body) -> pipeline_lower_let_expr_typed_sidecar_handler_opt(ns, nl, value, body, next_value, lower_ctx)
    Block(first, rest) -> pipeline_lower_block_expr_typed_sidecar_handler_opt(first, rest, next_value, lower_ctx)
    Not(operand) -> pipeline_lower_not_expr_typed_sidecar_handler_opt(operand, next_value, lower_ctx)
    Perform(lhs, op_ns, op_nl, args) -> pipeline_lower_perform_expr_typed_sidecar_handler_opt(lhs, op_ns, op_nl, args, next_value, lower_ctx)
    Handle(body, clauses) -> pipeline_lower_handle_expr_typed_sidecar_handler_opt(body, clauses, next_value, lower_ctx)
    Resume(value) -> pipeline_lower_expr_typed_sidecar_handler_opt(value, params, locals, src, tt, next_value, ctx)
    GenericCall(type_args, inner_call) -> pipeline_lower_generic_call_expr_typed_sidecar_handler_opt(type_args, inner_call, next_value, lower_ctx)
    LetTyped(inner, ann_type) -> pipeline_lower_expr_typed_sidecar_handler_opt(inner, params, locals, src, tt, next_value, ctx)
    _ -> ir_lowered_expr_invalid(next_value)
  }
}

fn pipeline_lower_straight_fn_handler_optimised(inner: i64, params: i64, src: i64, tt: i64, nparams: i64) -> IrFunctionList {
  let body = node_f4(inner)
  let lowered = pipeline_lower_expr_sidecar_handler_opt(body, params, pipeline_value_env_empty(), src, tt, nparams, pipeline_handler_inline_ctx_empty())
  if ir_lowered_expr_is_valid(lowered) == 1 {
    let block = ir_block_new_term(0, ir_lowered_expr_insts(lowered), ir_term_return(ir_lowered_expr_value(lowered)))
    let f = ir_function_new(str_hash(src, node_f1(inner), node_f2(inner)), nparams, block)
    ir_function_list_prepend(f, ir_function_list_empty())
  } else {
    pipeline_lower_straight_fn_sidecar(inner, params, src, tt, nparams)
  }
}

fn pipeline_lower_simple_fn_handler_optimised(pair: i64, tt: i64) -> IrFunctionList {
  let fn_wrap = node_f1(pair)
  let fn_src = node_f2(pair)
  let inner = pipeline_fn_inner(fn_wrap)
  let params = node_f3(inner)
  let body = node_f4(inner)
  let nparams = nlist_len(params)
  if pipeline_expr_needs_cfg(body) == 1 {
    pipeline_lower_simple_fn_sidecar(pair, tt)
  } else {
    pipeline_lower_straight_fn_handler_optimised(inner, params, fn_src, tt, nparams)
  }
}

fn pipeline_lower_fns_handler_optimised(fns: i64, tt: i64, user_src: i64) -> IrFunctionList {
  let mut result = ir_function_list_empty()
  let n = nlist_len(fns)
  for i in 0..n {
    let pair = nlist_get(fns, i)
    if node_f2(pair) == user_src {
      if fn_tparams(node_f1(pair)) == 0 {
        let one = pipeline_lower_simple_fn_handler_optimised(pair, tt)
        match one {
          IrFunctionNil -> 0
          IrFunctionCons(f, rest) -> { result = ir_function_list_prepend(f, result) }
        }
      } else { 0 }
    } else { 0 }
  }
  result
}

fn pipeline_ir_function_list_append(left: IrFunctionList, right: IrFunctionList) -> IrFunctionList {
  match left {
    IrFunctionNil -> right
    IrFunctionCons(f, rest) -> ir_function_list_prepend(f, pipeline_ir_function_list_append(rest, right))
  }
}

fn pipeline_generic_template_find(fns: i64, user_src: i64, name_hash: i64) -> i64 {
  let mut result = 0
  let n = nlist_len(fns)
  for i in 0..n {
    let pair = nlist_get(fns, i)
    let fn_src = node_f2(pair)
    if fn_src == user_src {
      let fn_wrap = node_f1(pair)
      let inner = pipeline_fn_inner(fn_wrap)
      let h = str_hash(fn_src, node_f1(inner), node_f2(inner))
      if h == name_hash {
        if fn_tparams(fn_wrap) != 0 {
          result = pair
        } else { 0 }
      } else { 0 }
    } else { 0 }
  }
  result
}

fn pipeline_lower_generic_specialisation_handler_optimised(pair: i64, type_args: i64, tt: i64, handlers: PipelineHandlerInlineCtx) -> IrFunctionList {
  if pair == 0 {
    ir_function_list_empty()
  } else {
    let fn_wrap = node_f1(pair)
    let fn_src = node_f2(pair)
    let inner = pipeline_fn_inner(fn_wrap)
    let body = node_f4(inner)
    if pipeline_expr_needs_cfg(body) == 1 {
      ir_function_list_empty()
    } else {
      let subst = cg_build_subst(fn_tparams(fn_wrap), type_args)
      let params = cg_params_subst(node_f3(inner), subst)
      let nparams = nlist_len(params)
      let lowered = pipeline_lower_expr_sidecar_handler_opt(body, params, pipeline_value_env_empty(), fn_src, tt, nparams, handlers)
      if ir_lowered_expr_is_valid(lowered) == 1 {
        let block = ir_block_new_term(0, ir_lowered_expr_insts(lowered), ir_term_return(ir_lowered_expr_value(lowered)))
        let name_hash = str_hash(fn_src, node_f1(inner), node_f2(inner))
        let f = ir_function_new(mono_spec_hash(name_hash, type_args), nparams, block)
        if ir_function_count_tag(f, 24) > 0 or ir_function_count_tag(f, 18) > 0 {
          ir_function_list_prepend(f, ir_function_list_empty())
        } else {
          ir_function_list_empty()
        }
      } else {
        ir_function_list_empty()
      }
    }
  }
}

fn pipeline_collect_generic_specs_list(nodes: i64, count: i64, fns: i64, user_src: i64, tt: i64, handlers: PipelineHandlerInlineCtx) -> IrFunctionList {
  let mut result = ir_function_list_empty()
  for i in 0..count {
    let one = pipeline_collect_generic_specs_expr(nlist_get(nodes, i), fns, user_src, tt, handlers)
    result = pipeline_ir_function_list_append(result, one)
  }
  result
}

fn pipeline_collect_generic_specs_record_fields(fields: i64, nfields: i64, fns: i64, user_src: i64, tt: i64, handlers: PipelineHandlerInlineCtx) -> IrFunctionList {
  let mut result = ir_function_list_empty()
  for i in 0..nfields {
    let field = nlist_get(fields, i)
    result = pipeline_ir_function_list_append(result, pipeline_collect_generic_specs_expr(node_f3(field), fns, user_src, tt, handlers))
  }
  result
}

fn pipeline_collect_generic_specs_clause_bodies(clauses: i64, nclauses: i64, fns: i64, user_src: i64, tt: i64, handlers: PipelineHandlerInlineCtx) -> IrFunctionList {
  let mut result = ir_function_list_empty()
  for i in 0..nclauses {
    let clause = nlist_get(clauses, i)
    result = pipeline_ir_function_list_append(result, pipeline_collect_generic_specs_expr(node_f3(clause), fns, user_src, tt, handlers))
  }
  result
}

fn pipeline_collect_generic_specs_match_arms(arms: i64, narms: i64, fns: i64, user_src: i64, tt: i64, handlers: PipelineHandlerInlineCtx) -> IrFunctionList {
  let mut result = ir_function_list_empty()
  for i in 0..narms {
    let arm = nlist_get(arms, i)
    result = pipeline_ir_function_list_append(result, pipeline_collect_generic_specs_expr(node_f2(arm), fns, user_src, tt, handlers))
    result = pipeline_ir_function_list_append(result, pipeline_collect_generic_specs_expr(node_f3(arm), fns, user_src, tt, handlers))
  }
  result
}

fn pipeline_collect_generic_specs_block(first: i64, rest: i64, fns: i64, user_src: i64, tt: i64, handlers: PipelineHandlerInlineCtx) -> IrFunctionList {
  let first_specs = pipeline_collect_generic_specs_expr(first, fns, user_src, tt, handlers)
  if rest == 0 {
    first_specs
  } else {
    pipeline_ir_function_list_append(first_specs, pipeline_collect_generic_specs_expr(rest, fns, user_src, tt, handlers))
  }
}

fn pipeline_collect_generic_specs_handle(expr: i64, fns: i64, user_src: i64, tt: i64, handlers: PipelineHandlerInlineCtx) -> IrFunctionList {
  let body = node_f1(expr)
  let clauses = node_f2(expr)
  let nclauses = node_f3(expr)
  let clause_specs = pipeline_collect_generic_specs_clause_bodies(clauses, nclauses, fns, user_src, tt, handlers)
  if nclauses <= 0 {
    pipeline_ir_function_list_append(clause_specs, pipeline_collect_generic_specs_expr(body, fns, user_src, tt, handlers))
  } else {
    let eff_hash = pipeline_handler_clause_effect_hash(user_src, nlist_get(clauses, 0))
    let next_handlers = pipeline_handler_inline_ctx_push(handlers, eff_hash, clauses, nclauses)
    pipeline_ir_function_list_append(clause_specs, pipeline_collect_generic_specs_expr(body, fns, user_src, tt, next_handlers))
  }
}

fn pipeline_collect_generic_specs_generic_call(expr: i64, fns: i64, user_src: i64, tt: i64, handlers: PipelineHandlerInlineCtx) -> IrFunctionList {
  let call_node = node_f2(expr)
  let arg_specs = pipeline_collect_generic_specs_list(node_f3(call_node), node_f4(call_node), fns, user_src, tt, handlers)
  let name_hash = str_hash(user_src, node_f1(call_node), node_f2(call_node))
  let pair = pipeline_generic_template_find(fns, user_src, name_hash)
  let specialised = pipeline_lower_generic_specialisation_handler_optimised(pair, node_f1(expr), tt, handlers)
  pipeline_ir_function_list_append(arg_specs, specialised)
}

fn pipeline_collect_generic_specs_expr(expr: i64, fns: i64, user_src: i64, tt: i64, handlers: PipelineHandlerInlineCtx) -> IrFunctionList {
  if expr == 0 {
    ir_function_list_empty()
  } else {
    let tag = node_tag(expr)
    match tag {
      3 -> pipeline_ir_function_list_append(
        pipeline_collect_generic_specs_expr(node_f2(expr), fns, user_src, tt, handlers),
        pipeline_collect_generic_specs_expr(node_f3(expr), fns, user_src, tt, handlers)
      )
      4 -> pipeline_collect_generic_specs_list(node_f3(expr), node_f4(expr), fns, user_src, tt, handlers)
      5 -> pipeline_ir_function_list_append(
        pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers),
        pipeline_ir_function_list_append(
          pipeline_collect_generic_specs_expr(node_f2(expr), fns, user_src, tt, handlers),
          pipeline_collect_generic_specs_expr(node_f3(expr), fns, user_src, tt, handlers)
        )
      )
      6 -> pipeline_ir_function_list_append(
        pipeline_collect_generic_specs_expr(node_f3(expr), fns, user_src, tt, handlers),
        pipeline_collect_generic_specs_expr(node_f4(expr), fns, user_src, tt, handlers)
      )
      7 -> pipeline_collect_generic_specs_block(node_f1(expr), node_f2(expr), fns, user_src, tt, handlers)
      10 -> pipeline_ir_function_list_append(
        pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers),
        pipeline_collect_generic_specs_expr(node_f2(expr), fns, user_src, tt, handlers)
      )
      11 -> pipeline_ir_function_list_append(
        pipeline_collect_generic_specs_expr(node_f3(expr), fns, user_src, tt, handlers),
        pipeline_collect_generic_specs_expr(node_f4(expr), fns, user_src, tt, handlers)
      )
      12 -> pipeline_collect_generic_specs_expr(node_f3(expr), fns, user_src, tt, handlers)
      13 -> pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers)
      14 -> pipeline_collect_generic_specs_record_fields(node_f3(expr), node_f4(expr), fns, user_src, tt, handlers)
      15 -> pipeline_ir_function_list_append(
        pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers),
        pipeline_collect_generic_specs_match_arms(node_f2(expr), node_f3(expr), fns, user_src, tt, handlers)
      )
      22 -> pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers)
      25 -> pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers)
      26 -> pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers)
      29 -> pipeline_collect_generic_specs_expr(node_f2(expr), fns, user_src, tt, handlers)
      32 -> pipeline_collect_generic_specs_list(node_f4(expr), nlist_len(node_f4(expr)), fns, user_src, tt, handlers)
      33 -> pipeline_collect_generic_specs_handle(expr, fns, user_src, tt, handlers)
      35 -> pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers)
      36 -> pipeline_collect_generic_specs_generic_call(expr, fns, user_src, tt, handlers)
      37 -> pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers)
      41 -> pipeline_ir_function_list_append(
        pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers),
        pipeline_collect_generic_specs_list(node_f3(expr), nlist_len(node_f3(expr)), fns, user_src, tt, handlers)
      )
      45 -> pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers)
      46 -> pipeline_ir_function_list_append(
        pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers),
        pipeline_collect_generic_specs_expr(node_f2(expr), fns, user_src, tt, handlers)
      )
      47 -> pipeline_ir_function_list_append(
        pipeline_collect_generic_specs_expr(node_f3(expr), fns, user_src, tt, handlers),
        pipeline_collect_generic_specs_expr(node_f4(expr), fns, user_src, tt, handlers)
      )
      48 -> pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers)
      49 -> pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers)
      52 -> pipeline_ir_function_list_append(
        pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers),
        pipeline_collect_generic_specs_expr(node_f2(expr), fns, user_src, tt, handlers)
      )
      _ -> ir_function_list_empty()
    }
  }
}

fn pipeline_collect_generic_specs_fns(fns: i64, tt: i64, user_src: i64) -> IrFunctionList {
  let mut result = ir_function_list_empty()
  let n = nlist_len(fns)
  for i in 0..n {
    let pair = nlist_get(fns, i)
    if node_f2(pair) == user_src {
      let fn_wrap = node_f1(pair)
      if fn_tparams(fn_wrap) == 0 {
        let inner = pipeline_fn_inner(fn_wrap)
        let specs = pipeline_collect_generic_specs_expr(node_f4(inner), fns, user_src, tt, pipeline_handler_inline_ctx_empty())
        result = pipeline_ir_function_list_append(result, specs)
      } else { 0 }
    } else { 0 }
  }
  result
}

fn pipeline_lower_ir(typed: TypedModule) -> IrModule {
  match typed {
    TypedModule(fns, src, tt) -> {
      let sidecar = pipeline_lower_typed_functions_internal(typed)
      IrModule(sidecar)
    }
  }
}

fn pipeline_ir_function_list_find_hash(functions: IrFunctionList, name_hash: i64) -> IrFunctionList {
  match functions {
    IrFunctionNil -> ir_function_list_empty()
    IrFunctionCons(f, rest) -> {
      match f {
        IrFunction(hash, params, blocks) -> {
          if hash == name_hash {
            ir_function_list_prepend(f, ir_function_list_empty())
          } else {
            pipeline_ir_function_list_find_hash(rest, name_hash)
          }
        }
      }
    }
  }
}

fn pipeline_ir_native_params_unmanaged(params: i64, nparams: i64) -> i64 {
  let mut ok = 1
  for i in 0..nparams {
    let p = nlist_get(params, i)
    if cg_ty_is_managed(node_f3(p)) == 1 { ok = 0 } else { 0 }
  }
  ok
}

fn pipeline_ir_native_inst_supported(inst: IrInst) -> i64 {
  match inst {
    IrConstI64(dst, value) -> 1
    IrBinaryI64(dst, op, lhs, rhs) -> ir_binary_op_is_supported(op)
    IrHandleI64(dst, body, clauses, nclauses) -> 1
    IrHandlerDirectI64(dst, effect_hash, op_hash, handler_depth, clause_index, args) -> 1
    IrHandlerPopI64(frame) -> 1
    IrBindI64(ns, nl, value) -> 1
    IrPerformI64(dst, effect_hash, op_hash, args) -> 1
    _ -> 0
  }
}

fn pipeline_ir_native_inst_list_supported(insts: IrInstList) -> i64 {
  match insts {
    IrInstNil -> 1
    IrInstCons(inst, rest) -> {
      if pipeline_ir_native_inst_supported(inst) == 1 {
        pipeline_ir_native_inst_list_supported(rest)
      } else {
        0
      }
    }
  }
}

fn pipeline_ir_native_block_supported(block: IrBlock) -> i64 {
  match block {
    IrBlock(id, params, insts, term) -> {
      match term {
        IrTermReturn(value) -> {
          if ir_value_list_len(params) == 0 {
            pipeline_ir_native_inst_list_supported(insts)
          } else {
            0
          }
        }
        _ -> 0
      }
    }
  }
}

fn pipeline_expr_list_has_continuation_handler_typed(exprs: ExprList) -> i64 {
  match exprs {
    ExprListNil -> 0
    ExprListCons(expr, rest) -> {
      if pipeline_expr_has_continuation_handler_typed(expr) == 1 {
        1
      } else {
        pipeline_expr_list_has_continuation_handler_typed(rest)
      }
    }
  }
}

fn pipeline_record_fields_have_continuation_handler_typed(fields: RecordFieldList) -> i64 {
  match fields {
    RecordFieldListNil -> 0
    RecordFieldListCons(field, rest) -> {
      let found = match field {
        RecordField(ns, nl, value) -> pipeline_expr_has_continuation_handler_typed(value)
        UnknownRecordField(tag) -> 0
      }
      if found == 1 { 1 } else { pipeline_record_fields_have_continuation_handler_typed(rest) }
    }
  }
}

fn pipeline_match_arms_have_continuation_handler_typed(arms: MatchArmList) -> i64 {
  match arms {
    MatchArmListNil -> 0
    MatchArmListCons(arm, rest) -> {
      let found = match arm {
        Arm(pattern, body, guard, has_guard) -> {
          if has_guard == 1 {
            pipeline_expr_has_continuation_handler_typed(guard) or pipeline_expr_has_continuation_handler_typed(body)
          } else {
            pipeline_expr_has_continuation_handler_typed(body)
          }
        }
        UnknownArm(tag) -> 0
      }
      if found == 1 { 1 } else { pipeline_match_arms_have_continuation_handler_typed(rest) }
    }
  }
}

fn pipeline_handler_clause_list_has_continuation_handler_typed(clauses: HandlerClauseList) -> i64 {
  match clauses {
    HandlerClauseListNil -> 0
    HandlerClauseListCons(clause, rest) -> {
      let found = if handler_clause_has_continuation(clause) == 1 {
        1
      } else {
        pipeline_expr_has_continuation_handler_typed(handler_clause_body_expr(clause))
      }
      if found == 1 { 1 } else { pipeline_handler_clause_list_has_continuation_handler_typed(rest) }
    }
  }
}

fn pipeline_expr_has_continuation_handler_typed(expr: Expr) -> i64 {
  match expr {
    BinOp(op, lhs, rhs) -> pipeline_expr_has_continuation_handler_typed(lhs) or pipeline_expr_has_continuation_handler_typed(rhs)
    Call(ns, nl, args) -> pipeline_expr_list_has_continuation_handler_typed(args)
    GenericCall(type_args, inner_call) -> pipeline_expr_has_continuation_handler_typed(inner_call)
    If(cond, then_expr, else_expr) -> pipeline_expr_has_continuation_handler_typed(cond) or pipeline_expr_has_continuation_handler_typed(then_expr) or pipeline_expr_has_continuation_handler_typed(else_expr)
    While(cond, body) -> pipeline_expr_has_continuation_handler_typed(cond) or pipeline_expr_has_continuation_handler_typed(body)
    Loop(body) -> pipeline_expr_has_continuation_handler_typed(body)
    Break(value) -> pipeline_expr_has_continuation_handler_typed(value)
    Return(value) -> pipeline_expr_has_continuation_handler_typed(value)
    Defer(cleanup, body) -> pipeline_expr_has_continuation_handler_typed(cleanup) or pipeline_expr_has_continuation_handler_typed(body)
    Let(ns, nl, value, body) -> pipeline_expr_has_continuation_handler_typed(value) or pipeline_expr_has_continuation_handler_typed(body)
    LetMut(ns, nl, value, body) -> pipeline_expr_has_continuation_handler_typed(value) or pipeline_expr_has_continuation_handler_typed(body)
    Assign(ns, nl, value) -> pipeline_expr_has_continuation_handler_typed(value)
    AddressOf(mutable, target) -> pipeline_expr_has_continuation_handler_typed(target)
    Deref(ptr) -> pipeline_expr_has_continuation_handler_typed(ptr)
    PtrAssign(ptr, value) -> pipeline_expr_has_continuation_handler_typed(ptr) or pipeline_expr_has_continuation_handler_typed(value)
    Block(first, rest) -> pipeline_expr_has_continuation_handler_typed(first) or pipeline_expr_has_continuation_handler_typed(rest)
    FieldAccess(base, field_ns, field_nl) -> pipeline_expr_has_continuation_handler_typed(base)
    RecordInit(type_ns, type_nl, fields) -> pipeline_record_fields_have_continuation_handler_typed(fields)
    Match(scrutinee, arms) -> pipeline_expr_has_continuation_handler_typed(scrutinee) or pipeline_match_arms_have_continuation_handler_typed(arms)
    Not(operand) -> pipeline_expr_has_continuation_handler_typed(operand)
    Lambda(params, body) -> pipeline_expr_has_continuation_handler_typed(body)
    Perform(lhs, op_ns, op_nl, args) -> pipeline_expr_has_continuation_handler_typed(lhs) or pipeline_expr_list_has_continuation_handler_typed(args)
    Handle(body, clauses) -> pipeline_expr_has_continuation_handler_typed(body) or pipeline_handler_clause_list_has_continuation_handler_typed(clauses)
    Resume(value) -> pipeline_expr_has_continuation_handler_typed(value)
    MethodCall(recv, method_hash, args, type_hash) -> pipeline_expr_has_continuation_handler_typed(recv) or pipeline_expr_list_has_continuation_handler_typed(args)
    Try(inner) -> pipeline_expr_has_continuation_handler_typed(inner)
    InterpConcat(left, right) -> pipeline_expr_has_continuation_handler_typed(left) or pipeline_expr_has_continuation_handler_typed(right)
    ForIter(var_ns, var_nl, collection, body) -> pipeline_expr_has_continuation_handler_typed(collection) or pipeline_expr_has_continuation_handler_typed(body)
    OptChain(base, field_ns, field_nl) -> pipeline_expr_has_continuation_handler_typed(base)
    LetTyped(inner, ann_type) -> pipeline_expr_has_continuation_handler_typed(inner)
    _ -> 0
  }
}

fn pipeline_expr_list_has_generator_i64_new_typed(exprs: ExprList, src: i64) -> i64 {
  match exprs {
    ExprListNil -> 0
    ExprListCons(expr, rest) -> {
      if pipeline_expr_has_generator_i64_new_typed(expr, src) == 1 {
        1
      } else {
        pipeline_expr_list_has_generator_i64_new_typed(rest, src)
      }
    }
  }
}

fn pipeline_record_fields_have_generator_i64_new_typed(fields: RecordFieldList, src: i64) -> i64 {
  match fields {
    RecordFieldListNil -> 0
    RecordFieldListCons(field, rest) -> {
      let found = match field {
        RecordField(ns, nl, value) -> pipeline_expr_has_generator_i64_new_typed(value, src)
        UnknownRecordField(tag) -> 0
      }
      if found == 1 { 1 } else { pipeline_record_fields_have_generator_i64_new_typed(rest, src) }
    }
  }
}

fn pipeline_match_arms_have_generator_i64_new_typed(arms: MatchArmList, src: i64) -> i64 {
  match arms {
    MatchArmListNil -> 0
    MatchArmListCons(arm, rest) -> {
      let found = match arm {
        Arm(pattern, body, guard, has_guard) -> {
          if has_guard == 1 {
            pipeline_expr_has_generator_i64_new_typed(guard, src) or pipeline_expr_has_generator_i64_new_typed(body, src)
          } else {
            pipeline_expr_has_generator_i64_new_typed(body, src)
          }
        }
        UnknownArm(tag) -> 0
      }
      if found == 1 { 1 } else { pipeline_match_arms_have_generator_i64_new_typed(rest, src) }
    }
