  match exprs {
    ExprListNil -> 0
    ExprListCons(expr, rest) -> pipeline_ir_effect_flags_merge(pipeline_ir_typed_direct_effect_expr_collect(expr, src, callees), pipeline_ir_typed_direct_effect_expr_list_collect(rest, src, callees))
  }
}

