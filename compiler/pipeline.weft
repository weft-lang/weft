fn pipeline_handler_clause_list_has_generator_i64_new_typed(clauses: HandlerClauseList, src: i64) -> i64 {
  match clauses {
    HandlerClauseListNil -> 0
    HandlerClauseListCons(clause, rest) -> {
      if pipeline_expr_has_generator_i64_new_typed(handler_clause_body_expr(clause), src) == 1 {
        1
      } else {
        pipeline_handler_clause_list_has_generator_i64_new_typed(rest, src)
      }
    }
  }
}

fn pipeline_expr_has_generator_i64_new_typed(expr: Expr, src: i64) -> i64 {
  match expr {
    BinOp(op, lhs, rhs) -> pipeline_expr_has_generator_i64_new_typed(lhs, src) or pipeline_expr_has_generator_i64_new_typed(rhs, src)
    Call(ns, nl, args) -> {
      if src_eq(src, ns, nl, "generator_i64_new") == 1 { 1 }
      else { pipeline_expr_list_has_generator_i64_new_typed(args, src) }
    }
    GenericCall(type_args, inner_call) -> {
      match inner_call {
        Call(ns, nl, args) -> {
          if src_eq(src, ns, nl, "generator_new") == 1 { 1 }
          else { pipeline_expr_list_has_generator_i64_new_typed(args, src) }
        }
        _ -> pipeline_expr_has_generator_i64_new_typed(inner_call, src)
      }
    }
    If(cond, then_expr, else_expr) -> pipeline_expr_has_generator_i64_new_typed(cond, src) or pipeline_expr_has_generator_i64_new_typed(then_expr, src) or pipeline_expr_has_generator_i64_new_typed(else_expr, src)
    While(cond, body) -> pipeline_expr_has_generator_i64_new_typed(cond, src) or pipeline_expr_has_generator_i64_new_typed(body, src)
    Loop(body) -> pipeline_expr_has_generator_i64_new_typed(body, src)
    Break(value) -> pipeline_expr_has_generator_i64_new_typed(value, src)
    Return(value) -> pipeline_expr_has_generator_i64_new_typed(value, src)
    Defer(cleanup, body) -> pipeline_expr_has_generator_i64_new_typed(cleanup, src) or pipeline_expr_has_generator_i64_new_typed(body, src)
    Let(ns, nl, value, body) -> pipeline_expr_has_generator_i64_new_typed(value, src) or pipeline_expr_has_generator_i64_new_typed(body, src)
    LetMut(ns, nl, value, body) -> pipeline_expr_has_generator_i64_new_typed(value, src) or pipeline_expr_has_generator_i64_new_typed(body, src)
    Assign(ns, nl, value) -> pipeline_expr_has_generator_i64_new_typed(value, src)
    AddressOf(mutable, target) -> pipeline_expr_has_generator_i64_new_typed(target, src)
    Deref(ptr) -> pipeline_expr_has_generator_i64_new_typed(ptr, src)
    PtrAssign(ptr, value) -> pipeline_expr_has_generator_i64_new_typed(ptr, src) or pipeline_expr_has_generator_i64_new_typed(value, src)
    Block(first, rest) -> pipeline_expr_has_generator_i64_new_typed(first, src) or pipeline_expr_has_generator_i64_new_typed(rest, src)
    FieldAccess(base, field_ns, field_nl) -> pipeline_expr_has_generator_i64_new_typed(base, src)
    RecordInit(type_ns, type_nl, fields) -> pipeline_record_fields_have_generator_i64_new_typed(fields, src)
    Match(scrutinee, arms) -> pipeline_expr_has_generator_i64_new_typed(scrutinee, src) or pipeline_match_arms_have_generator_i64_new_typed(arms, src)
    Not(operand) -> pipeline_expr_has_generator_i64_new_typed(operand, src)
    Lambda(params, body) -> pipeline_expr_has_generator_i64_new_typed(body, src)
    Perform(lhs, op_ns, op_nl, args) -> pipeline_expr_has_generator_i64_new_typed(lhs, src) or pipeline_expr_list_has_generator_i64_new_typed(args, src)
    Handle(body, clauses) -> pipeline_expr_has_generator_i64_new_typed(body, src) or pipeline_handler_clause_list_has_generator_i64_new_typed(clauses, src)
    Resume(value) -> pipeline_expr_has_generator_i64_new_typed(value, src)
    MethodCall(recv, method_hash, args, type_hash) -> pipeline_expr_has_generator_i64_new_typed(recv, src) or pipeline_expr_list_has_generator_i64_new_typed(args, src)
    Try(inner) -> pipeline_expr_has_generator_i64_new_typed(inner, src)
    InterpConcat(left, right) -> pipeline_expr_has_generator_i64_new_typed(left, src) or pipeline_expr_has_generator_i64_new_typed(right, src)
    ForIter(var_ns, var_nl, collection, body) -> pipeline_expr_has_generator_i64_new_typed(collection, src) or pipeline_expr_has_generator_i64_new_typed(body, src)
    OptChain(base, field_ns, field_nl) -> pipeline_expr_has_generator_i64_new_typed(base, src)
    LetTyped(inner, ann_type) -> pipeline_expr_has_generator_i64_new_typed(inner, src)
    _ -> 0
  }
}

fn pipeline_ir_native_function_supported(fn_wrap: i64, f: IrFunction, fn_src: i64) -> i64 {
  let fn_node = unwrap_fn(fn_wrap)
  let body = node_f4(fn_node)
  let body_expr = expr_from_node(body)
  let params = node_f3(fn_node)
  let nparams = nlist_len(params)
  let unmanaged = if cg_ty_is_managed(fn_ret_type(fn_wrap)) == 1 {
    0
  } else {
    pipeline_ir_native_params_unmanaged(params, nparams)
  }
  if unmanaged == 0 { 0 }
  else { if pipeline_expr_has_continuation_handler_typed(body_expr) == 1 { 0 }
  else { if pipeline_expr_has_generator_i64_new_typed(body_expr, fn_src) == 1 { 0 }
  else { if ir_function_count_tag(f, 24) <= 0 { 0 }
  else { if ir_function_count_tag(f, 18) != 0 { 0 }
  else { if ir_function_count_tag(f, 19) <= 0 { 0 }
  else { if ir_function_count_tag(f, 19) != ir_function_count_tag(f, 25) { 0 }
  else {
    match f {
      IrFunction(hash, param_count, blocks) -> {
        match blocks {
          IrBlockListCons(block, IrBlockListNil) -> pipeline_ir_native_block_supported(block)
          _ -> 0
        }
      }
    }
  } } } } } } }
}

fn pipeline_ir_native_store_reg(code: i64, dst: i64, phys: i64) -> i64 {
  if dst < 0 { 0 }
  else { if dst < 8 {
    bu32(code, encode_add_imm(dst + 19, phys, 0))
  } else {
    emit_store_reg(code, dst, phys)
  } }
}

fn pipeline_ir_native_emit_const(code: i64, dst: i64, value: i64) -> i64 {
  emit_mov_imm_safe(code, 17, value)
  pipeline_ir_native_store_reg(code, dst, 17)
}

fn pipeline_ir_native_emit_binary(code: i64, dst: i64, op: IrBinaryOp, lhs: i64, rhs: i64) -> i64 {
  let lp = emit_load_reg(code, lhs)
  let rp = emit_load_rhs(code, rhs)
  cg_binop_emit(code, ir_binary_op_tag(op), 17, lp, rp)
  pipeline_ir_native_store_reg(code, dst, 17)
}

fn pipeline_ir_native_handler_ctx_len(ctx: PipelineNativeHandlerCtx) -> i64 {
  match ctx {
    PipelineNativeHandlerCtxNil -> 0
    PipelineNativeHandlerCtxCons(clauses, infos, nclauses, ops_ctr, frame_ctr, rest) -> 1 + pipeline_ir_native_handler_ctx_len(rest)
  }
}

fn pipeline_ir_native_handler_ctx_at(ctx: PipelineNativeHandlerCtx, depth: i64) -> PipelineNativeHandlerCtx {
  match ctx {
    PipelineNativeHandlerCtxNil -> PipelineNativeHandlerCtxNil
    PipelineNativeHandlerCtxCons(clauses, infos, nclauses, ops_ctr, frame_ctr, rest) -> {
      if depth <= 0 { ctx } else { pipeline_ir_native_handler_ctx_at(rest, depth - 1) }
    }
  }
}

fn pipeline_ir_native_hclause_infos_uncaptured(infos: i64, nclauses: i64) -> i64 {
  let mut ok = 1
  let mut i = 0
  while i < nclauses {
    let info = __mem_load64(infos + i * 8)
    if __mem_load64(info + 16) != 0 {
      ok = 0
      i = nclauses
    } else {
      i = i + 1
    }
  }
  ok
}

fn pipeline_ir_native_handler_ctx_uncaptured(ctx: PipelineNativeHandlerCtx) -> PipelineNativeHandlerCtx {
  match ctx {
    PipelineNativeHandlerCtxNil -> PipelineNativeHandlerCtxNil
    PipelineNativeHandlerCtxCons(clauses, infos, nclauses, ops_ctr, frame_ctr, rest) -> {
      let filtered_rest = pipeline_ir_native_handler_ctx_uncaptured(rest)
      if pipeline_ir_native_hclause_infos_uncaptured(infos, nclauses) == 1 {
        PipelineNativeHandlerCtxCons(clauses, infos, nclauses, ops_ctr, frame_ctr, filtered_rest)
      } else {
        filtered_rest
      }
    }
  }
}

fn pipeline_ir_native_handler_ctx_to_inline_ctx(ctx: PipelineNativeHandlerCtx, src: i64) -> PipelineHandlerInlineCtx {
  match ctx {
    PipelineNativeHandlerCtxNil -> pipeline_handler_inline_ctx_empty()
    PipelineNativeHandlerCtxCons(clauses, infos, nclauses, ops_ctr, frame_ctr, rest) -> {
      let rest_ctx = pipeline_ir_native_handler_ctx_to_inline_ctx(rest, src)
      if nclauses <= 0 {
        rest_ctx
      } else {
        let eff_hash = pipeline_handler_clause_effect_hash_typed(src, handler_clause_list_nth(clauses, 0))
        pipeline_handler_inline_ctx_push_typed(rest_ctx, eff_hash, clauses, nclauses)
      }
    }
  }
}

fn pipeline_ir_native_move_args(code: i64, args: IrValueList, index: i64) -> i64 {
  match args {
    IrValueNil -> 0
    IrValueCons(value, rest) -> {
      let phys = emit_load_reg(code, value)
      bu32(code, encode_add_imm(index + 1, phys, 0))
      pipeline_ir_native_move_args(code, rest, index + 1)
    }
  }
}

fn pipeline_ir_native_hclause_free_vars_unmanaged(free_vars: i64, nfree: i64, scope: i64, src: i64) -> i64 {
  let mut ok = 1
  let mut i = 0
  while i < nfree {
    let fv = nlist_get(free_vars, i)
    if cg_ty_is_managed(scope_lookup_type(scope, src, node_f1(fv), node_f2(fv))) == 1 {
      ok = 0
      i = nfree
    } else {
      i = i + 1
    }
  }
  ok
}

fn pipeline_ir_native_hclause_param_unmanaged(param: Param) -> i64 {
  match param {
    Param(ns, nl, ty, label) -> {
      if cg_ty_is_managed(type_expr_to_node(ty)) == 1 { 0 } else { 1 }
    }
    UnknownParam(tag) -> 0
  }
}

fn pipeline_ir_native_hclause_params_unmanaged(params: ParamList) -> i64 {
  match params {
    ParamListNil -> 1
    ParamListCons(param, rest) -> {
      if pipeline_ir_native_hclause_param_unmanaged(param) == 1 {
        pipeline_ir_native_hclause_params_unmanaged(rest)
      } else { 0 }
    }
  }
}

fn pipeline_ir_native_hclause_return_unmanaged(clause: HandlerClause, src: i64, fm: i64) -> i64 {
  match clause {
    HandlerClause(name_info, params, body, continuation) -> {
      match name_info {
        HandlerClauseName(eff_ns, eff_nl, op_ns, op_nl) -> {
          let ret_ty = cg_effect_op_ret_type(fmap_get_tt(fm), src, eff_ns, eff_nl, op_ns, op_nl)
          if cg_ty_is_managed(ret_ty) == 1 { 0 } else { 1 }
        }
        UnknownHandlerClauseName -> 0
      }
    }
    UnknownHandlerClause(tag) -> 0
  }
}

fn pipeline_ir_native_hclause_locals_params(params: ParamList, index: i64, value_base: i64, locals: PipelineValueEnv) -> PipelineValueEnv {
  match params {
    ParamListNil -> locals
    ParamListCons(param, rest) -> {
      match param {
        Param(ns, nl, ty, label) -> pipeline_ir_native_hclause_locals_params(rest, index + 1, value_base, pipeline_value_env_push(locals, ns, nl, value_base + index))
        UnknownParam(tag) -> pipeline_ir_native_hclause_locals_params(rest, index + 1, value_base, locals)
      }
    }
  }
}

fn pipeline_ir_native_hclause_locals(params: ParamList, nparams: i64, free_vars: i64, nfree: i64) -> PipelineValueEnv {
  let mut locals = pipeline_value_env_empty()
  let mut bi = 0
  while bi < nfree {
    let fv = nlist_get(free_vars, bi)
    locals = pipeline_value_env_push(locals, node_f1(fv), node_f2(fv), nparams + bi)
    bi = bi + 1
  }
  pipeline_ir_native_hclause_locals_params(params, 0, nparams + nfree, locals)
}

fn pipeline_ir_native_hclause_scope_params(params: ParamList, index: i64, value_base: i64, body_scope: i64) -> i64 {
  match params {
    ParamListNil -> body_scope
    ParamListCons(param, rest) -> {
      match param {
        Param(ns, nl, ty, label) -> {
          let next_scope = scope_push_typed(body_scope, ns, nl, reg_id(value_base + index), type_expr_to_node(ty))
          pipeline_ir_native_hclause_scope_params(rest, index + 1, value_base, next_scope)
        }
        UnknownParam(tag) -> pipeline_ir_native_hclause_scope_params(rest, index + 1, value_base, body_scope)
      }
    }
  }
}

fn pipeline_ir_native_hclause_scope(params: ParamList, nparams: i64, free_vars: i64, nfree: i64, enclosing_scope: i64, src: i64) -> i64 {
  let mut body_scope = scope_new()
  let mut bi = 0
  while bi < nfree {
    let fv = nlist_get(free_vars, bi)
    let value_id = nparams + bi
    let cap_ty = scope_lookup_type(enclosing_scope, src, node_f1(fv), node_f2(fv))
    body_scope = scope_push_typed(body_scope, node_f1(fv), node_f2(fv), reg_id(value_id), cap_ty)
    bi = bi + 1
  }
  pipeline_ir_native_hclause_scope_params(params, 0, nparams + nfree, body_scope)
}

fn pipeline_ir_native_emit_hclause_loads(code: i64, nparams: i64, free_vars: i64, nfree: i64) -> i64 {
  let mut bi = 0
  while bi < nfree {
    let value_id = nparams + bi
    let dst = reg_phys(value_id)
    bu32(code, cg_ldr(dst, 0, bi * 8))
    if value_id >= 8 {
      emit_store_reg(code, value_id, dst)
    } else { 0 }
    bi = bi + 1
  }
  let mut pi = 0
  while pi < nparams {
    let value_id = nparams + nfree + pi
    emit_store_counter_from_phys(code, value_id, pi + 1)
    pi = pi + 1
  }
  0
}

fn pipeline_ir_native_hclause_lambda_scope_params(params: ParamList, index: i64, lambda_scope: i64) -> i64 {
  match params {
    ParamListNil -> lambda_scope
    ParamListCons(param, rest) -> {
      match param {
        Param(ns, nl, ty, label) -> pipeline_ir_native_hclause_lambda_scope_params(rest, index + 1, scope_push(lambda_scope, ns, nl, index + 1))
        UnknownParam(tag) -> pipeline_ir_native_hclause_lambda_scope_params(rest, index + 1, lambda_scope)
      }
    }
  }
}

fn pipeline_ir_native_hclause_lambda_scope(params: ParamList, continuation: HandlerClauseContinuation) -> i64 {
  let param_scope = pipeline_ir_native_hclause_lambda_scope_params(params, 0, scope_new())
  match continuation {
    HandlerClauseContinuation(ns, nl) -> scope_push(param_scope, ns, nl, cg_continuation_reg())
    _ -> param_scope
  }
}

fn pipeline_ir_native_hclause_params_type_scope(params: ParamList, index: i64, base_scope: i64) -> i64 {
  match params {
    ParamListNil -> base_scope
    ParamListCons(param, rest) -> {
      match param {
        Param(ns, nl, ty, label) -> {
          let next_scope = scope_push_typed(base_scope, ns, nl, reg_id(index), type_expr_to_node(ty))
          pipeline_ir_native_hclause_params_type_scope(rest, index + 1, next_scope)
        }
        UnknownParam(tag) -> pipeline_ir_native_hclause_params_type_scope(rest, index + 1, base_scope)
      }
    }
  }
}

fn pipeline_ir_native_emit_hclause_continuation(code: i64, fm: i64, body_scope: i64, outer_scope: i64, src: i64, free_vars: i64, body_ctr: i64, continuation: HandlerClauseContinuation) -> i64 {
  match continuation {
    HandlerClauseContinuation(ns, nl) -> {
      let nfree = nlist_len(free_vars)
      let desc_count = cg_hclause_managed_free_count(free_vars, nfree, outer_scope, src, fm)
      if desc_count > 0 {
        cg_emit_hclause_continuation_segment(code, fm, body_scope, outer_scope, src, free_vars, body_ctr, body_ctr + 1)
        let desc_phys = emit_load_reg(code, body_ctr)
        bu32(code, encode_add_imm(0, desc_phys, 0))
        cg_emit_call_lit(code, fm, "continuation_new_with_cleanup_desc")
        cg_hclause_store_x0(code, body_ctr)
        let token_phys = emit_load_reg(code, body_ctr)
        bu32(code, encode_add_imm(0, token_phys, 0))
        let segment_phys = emit_load_reg(code, body_ctr + 1)
        bu32(code, encode_add_imm(1, segment_phys, 0))
        emit_mov_imm(code, 2, 0)
        emit_mov_imm(code, 3, 0)
        cg_emit_call_lit(code, fm, "continuation_set_segment")
        body_ctr + 2
      } else {
        cg_emit_call_lit(code, fm, "continuation_new_noop")
        cg_hclause_store_x0(code, body_ctr)
        body_ctr + 1
      }
    }
    _ -> body_ctr
  }
}

fn pipeline_ir_native_hclause_scope_with_continuation(body_scope: i64, continuation: HandlerClauseContinuation, body_ctr: i64) -> i64 {
  match continuation {
    HandlerClauseContinuation(ns, nl) -> scope_push_typed(body_scope, ns, nl, cg_continuation_reg(), reg_id(body_ctr))
    _ -> body_scope
  }
}

fn pipeline_ir_native_drop_hclause_continuation(code: i64, fm: i64, body_scope: i64, src: i64, continuation: HandlerClauseContinuation) -> i64 {
  match continuation {
    HandlerClauseContinuation(ns, nl) -> {
      let token_rid = scope_lookup_type(body_scope, src, ns, nl)
      if token_rid != 0 {
        let token_phys = emit_load_reg_id(code, token_rid, 16)
        bu32(code, encode_add_imm(0, token_phys, 0))
        cg_emit_call_lit(code, fm, "continuation_drop_managed")
      } else { 0 }
    }
    _ -> 0
  }
}

fn pipeline_typed_ffv_bind_pattern_list(patterns: PatternList, scope: i64, src: i64) -> i64 {
  match patterns {
    PatternListNil -> scope
    PatternListCons(pattern, rest) -> pipeline_typed_ffv_bind_pattern_list(rest, pipeline_typed_ffv_bind_pattern(pattern, scope, src), src)
  }
}

fn pipeline_typed_ffv_bind_pattern(pattern: Pattern, scope: i64, src: i64) -> i64 {
  match pattern {
    Binding(ns, nl) -> scope_push(scope, ns, nl, 0)
    CtorPattern(tag_ns, tag_nl, bindings) -> pipeline_typed_ffv_bind_pattern_list(bindings, scope, src)
    _ -> scope
  }
}

fn pipeline_typed_ffv_bind_params(params: ParamList, scope: i64) -> i64 {
  match params {
    ParamListNil -> scope
    ParamListCons(param, rest) -> {
      match param {
        Param(ns, nl, ty, label) -> pipeline_typed_ffv_bind_params(rest, scope_push(scope, ns, nl, 0))
        UnknownParam(tag) -> pipeline_typed_ffv_bind_params(rest, scope)
      }
    }
  }
}

fn pipeline_typed_find_free_vars_expr_list(exprs: ExprList, local_scope: i64, enclosing_scope: i64, src: i64, free_vars: i64) -> i64 {
  match exprs {
    ExprListNil -> 0
    ExprListCons(expr, rest) -> {
      pipeline_typed_find_free_vars_expr(expr, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_expr_list(rest, local_scope, enclosing_scope, src, free_vars)
    }
  }
}

fn pipeline_typed_find_free_vars_record_fields(fields: RecordFieldList, local_scope: i64, enclosing_scope: i64, src: i64, free_vars: i64) -> i64 {
  match fields {
    RecordFieldListNil -> 0
    RecordFieldListCons(field, rest) -> {
      pipeline_typed_find_free_vars_expr(record_field_value_expr(field), local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_record_fields(rest, local_scope, enclosing_scope, src, free_vars)
    }
  }
}

fn pipeline_typed_find_free_vars_match_arms(arms: MatchArmList, local_scope: i64, enclosing_scope: i64, src: i64, free_vars: i64) -> i64 {
  match arms {
    MatchArmListNil -> 0
    MatchArmListCons(arm, rest) -> {
      let arm_scope = pipeline_typed_ffv_bind_pattern(match_arm_pattern(arm), local_scope, src)
      if match_arm_has_guard(arm) == 1 {
        pipeline_typed_find_free_vars_expr(match_arm_guard_expr(arm), arm_scope, enclosing_scope, src, free_vars)
      } else { 0 }
      pipeline_typed_find_free_vars_expr(match_arm_body_expr(arm), arm_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_match_arms(rest, local_scope, enclosing_scope, src, free_vars)
    }
  }
}

fn pipeline_typed_find_free_vars_handler_clauses(clauses: HandlerClauseList, local_scope: i64, enclosing_scope: i64, src: i64, free_vars: i64) -> i64 {
  match clauses {
    HandlerClauseListNil -> 0
    HandlerClauseListCons(clause, rest) -> {
      let clause_scope = pipeline_typed_ffv_bind_params(handler_clause_params(clause), local_scope)
      let clause_scope2 = match handler_clause_continuation(clause) {
        HandlerClauseContinuation(ns, nl) -> scope_push(clause_scope, ns, nl, 0)
        _ -> clause_scope
      }
      pipeline_typed_find_free_vars_expr(handler_clause_body_expr(clause), clause_scope2, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_handler_clauses(rest, local_scope, enclosing_scope, src, free_vars)
    }
  }
}

fn pipeline_typed_find_free_vars_expr(expr: Expr, local_scope: i64, enclosing_scope: i64, src: i64, free_vars: i64) -> i64 {
  match expr {
    Ident(ns, nl) -> ffv_add_name(ns, nl, local_scope, enclosing_scope, src, free_vars)
    BinOp(op, lhs, rhs) -> {
      pipeline_typed_find_free_vars_expr(lhs, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_expr(rhs, local_scope, enclosing_scope, src, free_vars)
    }
    Call(ns, nl, args) -> {
      ffv_add_name(ns, nl, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_expr_list(args, local_scope, enclosing_scope, src, free_vars)
    }
    GenericCall(type_args, inner_call) -> pipeline_typed_find_free_vars_expr(inner_call, local_scope, enclosing_scope, src, free_vars)
    If(cond, then_expr, else_expr) -> {
      pipeline_typed_find_free_vars_expr(cond, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_expr(then_expr, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_expr(else_expr, local_scope, enclosing_scope, src, free_vars)
    }
    While(cond, body) -> {
      pipeline_typed_find_free_vars_expr(cond, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_expr(body, local_scope, enclosing_scope, src, free_vars)
    }
    Loop(body) -> pipeline_typed_find_free_vars_expr(body, local_scope, enclosing_scope, src, free_vars)
    Break(value) -> pipeline_typed_find_free_vars_expr(value, local_scope, enclosing_scope, src, free_vars)
    Return(value) -> pipeline_typed_find_free_vars_expr(value, local_scope, enclosing_scope, src, free_vars)
    Defer(cleanup, body) -> {
      pipeline_typed_find_free_vars_expr(cleanup, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_expr(body, local_scope, enclosing_scope, src, free_vars)
    }
    Let(ns, nl, value, body) -> {
      pipeline_typed_find_free_vars_expr(value, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_expr(body, scope_push(local_scope, ns, nl, 0), enclosing_scope, src, free_vars)
    }
    LetMut(ns, nl, value, body) -> {
      pipeline_typed_find_free_vars_expr(value, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_expr(body, scope_push(local_scope, ns, nl, 0), enclosing_scope, src, free_vars)
    }
    Assign(ns, nl, value) -> {
      ffv_add_name(ns, nl, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_expr(value, local_scope, enclosing_scope, src, free_vars)
    }
    AddressOf(mutable, target) -> pipeline_typed_find_free_vars_expr(target, local_scope, enclosing_scope, src, free_vars)
    Deref(ptr) -> pipeline_typed_find_free_vars_expr(ptr, local_scope, enclosing_scope, src, free_vars)
    PtrAssign(ptr, value) -> {
      pipeline_typed_find_free_vars_expr(ptr, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_expr(value, local_scope, enclosing_scope, src, free_vars)
    }
    Block(first, rest) -> {
      pipeline_typed_find_free_vars_expr(first, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_expr(rest, local_scope, enclosing_scope, src, free_vars)
    }
    FieldAccess(base, field_ns, field_nl) -> pipeline_typed_find_free_vars_expr(base, local_scope, enclosing_scope, src, free_vars)
    RecordInit(type_ns, type_nl, fields) -> pipeline_typed_find_free_vars_record_fields(fields, local_scope, enclosing_scope, src, free_vars)
    Match(scrutinee, arms) -> {
      pipeline_typed_find_free_vars_expr(scrutinee, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_match_arms(arms, local_scope, enclosing_scope, src, free_vars)
    }
    Not(operand) -> pipeline_typed_find_free_vars_expr(operand, local_scope, enclosing_scope, src, free_vars)
    Lambda(params, body) -> pipeline_typed_find_free_vars_expr(body, pipeline_typed_ffv_bind_params(params, local_scope), enclosing_scope, src, free_vars)
    Perform(lhs, op_ns, op_nl, args) -> {
      pipeline_typed_find_free_vars_expr(lhs, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_expr_list(args, local_scope, enclosing_scope, src, free_vars)
    }
    Handle(body, clauses) -> {
      pipeline_typed_find_free_vars_expr(body, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_handler_clauses(clauses, local_scope, enclosing_scope, src, free_vars)
    }
    Resume(value) -> pipeline_typed_find_free_vars_expr(value, local_scope, enclosing_scope, src, free_vars)
    MethodCall(recv, method_hash, args, type_hash) -> {
      pipeline_typed_find_free_vars_expr(recv, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_expr_list(args, local_scope, enclosing_scope, src, free_vars)
    }
    Try(inner) -> pipeline_typed_find_free_vars_expr(inner, local_scope, enclosing_scope, src, free_vars)
    InterpConcat(left, right) -> {
      pipeline_typed_find_free_vars_expr(left, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_expr(right, local_scope, enclosing_scope, src, free_vars)
    }
    ForIter(var_ns, var_nl, collection, body) -> {
      pipeline_typed_find_free_vars_expr(collection, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_expr(body, scope_push(local_scope, var_ns, var_nl, 0), enclosing_scope, src, free_vars)
    }
    OptChain(base, field_ns, field_nl) -> pipeline_typed_find_free_vars_expr(base, local_scope, enclosing_scope, src, free_vars)
    LetTyped(inner, ann_type) -> pipeline_typed_find_free_vars_expr(inner, local_scope, enclosing_scope, src, free_vars)
    _ -> 0
  }
}

fn pipeline_ir_native_hclause_lower_supported(lowered: IrLoweredExpr) -> i64 {
  if ir_lowered_expr_is_valid(lowered) == 0 { 0 }
  else {
    let insts = ir_lowered_expr_insts(lowered)
    if ir_inst_list_count_tag(insts, 19) != 0 { 0 }
    else { pipeline_ir_native_inst_list_supported(insts) }
  }
}

fn pipeline_ir_native_emit_hclause_body_ir(clause: HandlerClause, code: i64, scope: i64, src: i64, fm: i64, active_handlers: PipelineNativeHandlerCtx) -> i64 {
  if handler_clause_has_continuation(clause) != 0 { 0 }
  else {
    let params = handler_clause_params(clause)
    let cbody_expr = handler_clause_body_expr(clause)
    let nparams = param_list_len(params)
    if pipeline_ir_native_hclause_params_unmanaged(params) == 0 { 0 }
    else { if pipeline_ir_native_hclause_return_unmanaged(clause, src, fm) == 0 { 0 }
    else {
      let lambda_scope = pipeline_ir_native_hclause_lambda_scope_params(params, 0, scope_new())
      let free_vars = nlist_new()
      pipeline_typed_find_free_vars_expr(cbody_expr, lambda_scope, scope, src, free_vars)
      let nfree = nlist_len(free_vars)
      if pipeline_ir_native_hclause_free_vars_unmanaged(free_vars, nfree, scope, src) == 0 { 0 }
      else {
        let safe_handlers = pipeline_ir_native_handler_ctx_uncaptured(active_handlers)
        let inline_ctx = pipeline_ir_native_handler_ctx_to_inline_ctx(safe_handlers, src)
        let locals = pipeline_ir_native_hclause_locals(params, nparams, free_vars, nfree)
        let next_value = nparams + nfree + nparams
        let lowered = pipeline_lower_expr_typed_sidecar_handler_opt(cbody_expr, 0, locals, src, fmap_get_tt(fm), next_value, inline_ctx)
        if pipeline_ir_native_hclause_lower_supported(lowered) == 0 { 0 }
        else {
          let skip_pos = buf_len(code)
          bu32(code, 0)
          let clause_start = buf_len(code)
          emit_prologue(code)
          pipeline_ir_native_emit_hclause_loads(code, nparams, free_vars, nfree)
          let body_scope = pipeline_ir_native_hclause_scope(params, nparams, free_vars, nfree, scope, src)
          pipeline_ir_native_emit_inst_list(ir_lowered_expr_insts(lowered), code, src, fm, PipelineNativeEmitCtx(body_scope, safe_handlers))
          let rp = emit_load_reg(code, ir_lowered_expr_value(lowered))
          bu32(code, encode_add_imm(0, rp, 0))
          emit_epilogue(code)
          cg_patch_b(code, skip_pos, buf_len(code))
          let info = alloc_bump(24)
          __mem_store64(info, clause_start)
          __mem_store64(info + 8, free_vars)
          __mem_store64(info + 16, nfree)
          info
        }
      }
    } }
  }
}

fn pipeline_cg_expr_typed_raw(expr: Expr, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  fmap_inc_typed_raw_fallback_count(fm)
  cg_expr(expr_to_node(expr), code, scope, src, ctr, fm)
}

fn pipeline_cg_call_args_eval_typed(args: ExprList, index: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, info: i64) -> i64 {
  match args {
    ExprListNil -> ctr
    ExprListCons(arg, rest) -> {
      let params = node_f1(info)
      let kind = node_f2(info)
      let results = node_f3(info)
      let param_ty = cg_param_info_ty(params, index, kind)
      let c1 = pipeline_cg_expr_as_type_typed(arg, param_ty, code, scope, src, ctr, fm)
      __mem_store64(results + index * 8, c1 - 1)
      pipeline_cg_call_args_eval_typed(rest, index + 1, code, scope, src, c1, fm, info)
    }
  }
}

fn pipeline_cg_call_args_retain_typed(args: ExprList, index: i64, code: i64, scope: i64, src: i64, fm: i64, info: i64) -> i64 {
  match args {
    ExprListNil -> 0
    ExprListCons(arg, rest) -> {
      let params = node_f1(info)
      let kind = node_f2(info)
      let results = node_f3(info)
      let borrowed_mask = node_f4(info)
      let param_ty = cg_param_info_ty(params, index, kind)
      if cg_ty_is_managed(param_ty) == 1 {
        if cg_mask_has(borrowed_mask, index) == 1 {
          fmap_inc_rc_elision_count(fm)
        } else {
          if cg_expr_is_borrow_for_ty(param_ty, expr_to_node(arg), scope, src, fm) == 1 {
            cg_emit_managed_retain_regid(code, fm, param_ty, reg_id(__mem_load64(results + index * 8)))
          } else { 0 }
        }
      } else { 0 }
      pipeline_cg_call_args_retain_typed(rest, index + 1, code, scope, src, fm, info)
    }
  }
}

fn pipeline_cg_call_args_typed(args: ExprList, nargs: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, info: i64) -> i64 {
  let start = node_f1(info)
  let params = node_f2(info)
  let kind = node_f3(info)
  let borrowed_mask = node_f4(info)
  let results = alloc_bump(nargs * 8 + 8)
  let typed_info = node_new(0, params, kind, results, borrowed_mask)
  let c = pipeline_cg_call_args_eval_typed(args, 0, code, scope, src, ctr, fm, typed_info)
  pipeline_cg_call_args_retain_typed(args, 0, code, scope, src, fm, typed_info)
  for j in 0..nargs {
    let result_ctr = __mem_load64(results + j * 8)
    let arg_phys = emit_load_reg(code, result_ctr)
    bu32(code, encode_add_imm(j + start, arg_phys, 0))
  }
  c
}

fn pipeline_cg_call_try_direct_typed(ns: i64, nl: i64, args: ExprList, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let nargs = expr_list_len(args)
  let raw = node_new(4, ns, nl, expr_list_to_nodes(args), nargs)
  if cg_call_is_weak_ref(raw, scope, src) == 1 { 0 - 1 }
  else { if cg_call_is_weak_load(raw, scope, src) == 1 { 0 - 1 }
  else { if cg_call_is_vector_len(raw, scope, src) == 1 { 0 - 1 }
  else { if cg_call_is_f64_table_row_count(raw, scope, src) == 1 { 0 - 1 }
  else { if cg_call_is_f64_table_get_static(raw, scope, src) == 1 { 0 - 1 }
  else { if cg_call_is_f64_table_set_static(raw, scope, src) == 1 { 0 - 1 }
  else { if cg_call_is_scoped_arena_helper(raw, scope, src) == 1 { 0 - 1 }
  else { if cg_call_is_par_sequential_helper(raw, scope, src, fm) == 1 { 0 - 1 }
  else { if cg_call_is_par_pthread_pool_helper(raw, scope, src, fm) == 1 { 0 - 1 }
  else { if cg_call_is_generator_yield_i64(raw, scope, src, fm) == 1 { 0 - 1 }
  else { if cg_call_is_generator_i64_new(raw, scope, src, fm) == 1 { 0 - 1 }
  else {
    let tt = fmap_get_tt(fm)
    let tag_hash = if tt > 0 { ttable_find_variant(tt, src, ns, nl) } else { 0 - 1 }
    if tag_hash >= 0 { 0 - 1 }
    else { if scope_lookup(scope, src, ns, nl) != 0 - 999 { 0 - 1 }
    else { if got_index(src, ns, nl) >= 0 { 0 - 1 }
    else { if is_intrinsic(src, ns, nl) == 1 { 0 - 1 }
    else { if src_eq(src, ns, nl, "__call_closure_i64") == 1 { 0 - 1 }
    else {
      let params = cg_ftypes_lookup_params(fmap_get_cg_ftypes(fm), src, ns, nl)
      let fiber_entry = cg_fiber_entry_for_direct_call(fm, src, ns, nl)
      let borrow_entry = cg_borrow_entry_for_direct_call(fm, src, ns, nl)
      let evidence_info = if borrow_entry == 0 { 0 } else { cg_effect_evidence_info_for_direct_call(raw, fm, src, borrow_entry, scope) }
      let borrow_eligible = if borrow_entry == 0 { 0 } else { cg_fn_borrowable_param_mask(node_f2(borrow_entry), node_f3(borrow_entry)) }
      let borrow_mask = if borrow_entry == 0 { 0 } else { cg_borrow_mask_for_call(expr_list_to_nodes(args), nargs, params, scope, src, fm, borrow_eligible) }
      let tiny_entry = cg_tiny_inline_entry_for_direct_call(raw, src, fm)
      if fiber_entry != 0 and cg_fiber_entry_supports_active(fiber_entry, fm) == 1 { 0 - 1 }
      else { if evidence_info != 0 { 0 - 1 }
      else { if borrow_mask != 0 { 0 - 1 }
      else { if cg_tiny_inline_entry_supported(tiny_entry, nargs, fm) == 1 { 0 - 1 }
      else {
        pipeline_cg_call_args_typed(args, nargs, code, scope, src, ctr, fm, node_new(0, 0, params, 0, 0))
        cg_record_rc_default_alloc_candidate(raw, scope, src, fm)
        fmap_inc_typed_direct_call_emit_count(fm)
        cg_call_emit(code, src, ns, nl, fm, ctr)
      } } } }
    } } } } }
  } } } } } } } } } } }
}

fn pipeline_cg_call_typed(ns: i64, nl: i64, args: ExprList, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let direct = pipeline_cg_call_try_direct_typed(ns, nl, args, code, scope, src, ctr, fm)
  if direct >= 0 {
    direct
  } else {
    cg_call(node_new(4, ns, nl, expr_list_to_nodes(args), expr_list_len(args)), code, scope, src, ctr, fm)
  }
}

fn pipeline_cg_store_x0_typed_result(code: i64, ctr: i64) -> i64 {
  if ctr < 8 {
    bu32(code, encode_add_imm(ctr + 19, 0, 0))
  } else {
    emit_store_reg(code, ctr, 0)
  }
}

fn pipeline_cg_generic_call_special_name(ns: i64, nl: i64, src: i64) -> i64 {
  if src_eq(src, ns, nl, "generator_yield") == 1 { 1 }
  else { if src_eq(src, ns, nl, "generator_new") == 1 { 1 }
  else { if src_eq(src, ns, nl, "generator_result_or") == 1 { 1 }
  else { if src_eq(src, ns, nl, "generator_drop") == 1 { 1 }
  else { if src_eq(src, ns, nl, "par_map") == 1 { 1 }
  else { if src_eq(src, ns, nl, "vector_element_size_of") == 1 { 1 }
  else { if src_eq(src, ns, nl, "vector_element_mode_of") == 1 { 1 }
  else { if src_eq(src, ns, nl, "vector_get") == 1 { 1 }
  else { if src_eq(src, ns, nl, "vector_set") == 1 { 1 }
  else { if src_eq(src, ns, nl, "vector_push") == 1 { 1 }
  else { if src_eq(src, ns, nl, "vector_fold") == 1 { 1 }
  else { if src_eq(src, ns, nl, "list_fold") == 1 { 1 }
  else { 0 } } } } } } } } } } } }
}

fn pipeline_cg_generic_call_emit_typed_args(args: ExprList, nargs: i64, params: i64, target: i64, ctx: PipelineCgExprCtx) -> i64 {
  match ctx {
    PipelineCgExprCtx(code, scope, src, ctr, fm) -> {
      let c = pipeline_cg_call_args_typed(args, nargs, code, scope, src, ctr, fm, node_new(0, 0, params, 0, 0))
      cg_vector_all_facts_invalidate(fm)
      let cur = buf_len(code)
      bu32(code, encode_bl(target - cur))
      pipeline_cg_store_x0_typed_result(code, c)
      fmap_inc_typed_generic_call_emit_count(fm)
      c + 1
    }
  }
}

fn pipeline_cg_generic_compile_specialisation_typed(type_args: i64, name_hash: i64, tmpl_entry: i64, code: i64, scope: i64, ctr: i64, fm: i64) -> i64 {
  let tmpl_wrap = __mem_load64(tmpl_entry + 8)
  let tmpl_src = __mem_load64(tmpl_entry + 16)
  let tmpl_inner = unwrap_fn(tmpl_wrap)
  let subst = cg_build_subst(fn_tparams(tmpl_wrap), type_args)
  let subst_ret = cg_generic_subst_ret(tmpl_wrap, type_args)
  let body = node_f4(tmpl_inner)
  let params = cg_params_subst(node_f3(tmpl_inner), subst)
  let nparams = nlist_len(params)
  let b_over_pos = buf_len(code)
  bu32(code, 0)
  let fn_off = buf_len(code)
  mono_cache_add(__mem_load64(fm + 88), mono_spec_hash(name_hash, type_args), fn_off)
  let old_preserve_fp = cg_enter_function_fp_preserve(fm, body, cg_params_type_scope(params, nparams, scope_new()), tmpl_src)
  emit_prologue_current(code, fm)
  if nparams > 8 {
    eprint("error: specialised function has more than 8 parameters\n")
  } else { 0 }
  let old_ret_ty = fmap_get_current_ret_ty(fm)
  let old_cleanup_stack = cg_cleanup_stack(fm)
  let old_loop_cleanup_depth = __mem_load64(fm + 152)
  let old_generic_subst = fmap_current_generic_subst(fm)
  fmap_set_current_ret_ty(fm, subst_ret)
  fmap_set_current_generic_subst(fm, subst)
  __mem_store64(fm + 144, nlist_new())
  __mem_store64(fm + 152, 0)
  let fn_scope = cg_fn_params(params, nparams, tmpl_src, scope_new(), code, fm)
  let body_ctr = pipeline_cg_expr_typed(expr_from_node(body), code, fn_scope, tmpl_src, nparams, fm)
  let save_ctr = body_ctr
  cg_match_store_result(code, save_ctr, body_ctr)
  if cg_ty_is_managed(subst_ret) == 1 {
    if cg_expr_is_borrow_for_ty(subst_ret, body, fn_scope, tmpl_src, fm) == 1 {
      cg_emit_managed_retain_regid(code, fm, subst_ret, reg_id(save_ctr))
    } else { 0 }
  } else { 0 }
  cg_emit_cleanups_to_depth(code, tmpl_src, save_ctr + 1, fm, 0)
  cg_cleanup_restore(fm, 0)
  fmap_set_current_ret_ty(fm, old_ret_ty)
  fmap_set_current_generic_subst(fm, old_generic_subst)
  __mem_store64(fm + 144, old_cleanup_stack)
  __mem_store64(fm + 152, old_loop_cleanup_depth)
  let result_phys = emit_load_reg(code, save_ctr)
  bu32(code, encode_add_imm(0, result_phys, 0))
  emit_epilogue_current(code, fm)
  cg_restore_function_fp_preserve(fm, old_preserve_fp)
  cg_patch_b(code, b_over_pos, buf_len(code))
  fn_off
}

fn pipeline_cg_generic_call_try_direct_typed(type_args_typed: TypeExprList, inner_call: Expr, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  match inner_call {
    Call(ns, nl, args) -> {
      let nargs = expr_list_len(args)
      let raw_type_args0 = type_expr_list_to_nodes(type_args_typed)
      let raw_call = node_new(4, ns, nl, expr_list_to_nodes(args), nargs)
      let raw_node0 = node_new(36, raw_type_args0, raw_call, 0, 0)
      if scope_lookup(scope, src, ns, nl) != 0 - 999 { 0 - 1 }
      else { if pipeline_cg_generic_call_special_name(ns, nl, src) == 1 { 0 - 1 }
      else {
        let evidence_entry = cg_evidence_generic_entry_for_call(raw_node0, fm, src)
        let evidence_info = if evidence_entry == 0 { 0 } else { cg_effect_evidence_info_for_generic_call(raw_node0, fm, src, evidence_entry, scope) }
        if evidence_info != 0 {
          cg_call_effect_evidence_generic(raw_node0, code, scope, src, ctr, fm, evidence_entry, evidence_info)
        } else {
          let type_args = cg_type_args_in_current_context(fm, raw_type_args0)
          let name_hash = str_hash(src, ns, nl)
          let spec_hash = mono_spec_hash(name_hash, type_args)
          let call_params = cg_generic_subst_params(fm, name_hash, type_args)
          let mc = __mem_load64(fm + 88)
          let cached = mono_cache_lookup(mc, spec_hash)
          if cached > 0 {
            pipeline_cg_generic_call_emit_typed_args(args, nargs, call_params, cached, PipelineCgExprCtx(code, scope, src, ctr, fm))
          } else {
            let tm = __mem_load64(fm + 80)
            let tmpl_entry = mono_tmap_lookup(tm, name_hash)
            if tmpl_entry == 0 {
              pipeline_cg_call_typed(ns, nl, args, code, scope, src, ctr, fm)
            } else {
              let fn_off = pipeline_cg_generic_compile_specialisation_typed(type_args, name_hash, tmpl_entry, code, scope, ctr, fm)
              let tmpl_wrap = __mem_load64(tmpl_entry + 8)
              let tmpl_inner = unwrap_fn(tmpl_wrap)
              let subst = cg_build_subst(fn_tparams(tmpl_wrap), type_args)
              let params = cg_params_subst(node_f3(tmpl_inner), subst)
              pipeline_cg_generic_call_emit_typed_args(args, nargs, params, fn_off, PipelineCgExprCtx(code, scope, src, ctr, fm))
            }
          }
        }
      } }
    }
    _ -> 0 - 1
  }
}

fn pipeline_cg_generic_call_typed(type_args: TypeExprList, inner_call: Expr, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let direct = pipeline_cg_generic_call_try_direct_typed(type_args, inner_call, code, scope, src, ctr, fm)
  if direct >= 0 {
    direct
  } else {
    cg_generic_call(node_new(36, type_expr_list_to_nodes(type_args), expr_to_node(inner_call), 0, 0), code, scope, src, ctr, fm)
  }
}

fn pipeline_cg_resume_typed(value: Expr, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let c1 = pipeline_cg_expr_typed(value, code, scope, src, ctr, fm)
  let result_phys = emit_load_reg(code, c1 - 1)
  bu32(code, encode_add_imm(0, result_phys, 0))
  emit_epilogue_current(code, fm)
  ctr + 1
}

fn pipeline_cg_address_of_typed(mutable: i64, target: Expr, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  match target {
    Ident(ns, nl) -> {
      let rid = scope_lookup(scope, src, ns, nl)
      let result = if rid < 0 {
        cg_address_of_stack_rid(code, rid, ctr)
      } else {
        pipeline_cg_address_of_heap_cell_typed(target, code, scope, src, ctr, fm)
      }
      fmap_inc_typed_address_of_emit_count(fm)
      result
    }
    _ -> {
      let result = pipeline_cg_address_of_heap_cell_typed(target, code, scope, src, ctr, fm)
      fmap_inc_typed_address_of_emit_count(fm)
      result
    }
  }
}

fn pipeline_cg_address_of_heap_cell_typed(target: Expr, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let c1 = pipeline_cg_expr_typed(target, code, scope, src, ctr, fm)
  let value_phys = emit_load_reg(code, c1 - 1)
  emit_mov_imm_safe(code, 16, 8)
  cg_bump_alloc_reg(code, 17, 16)
  bu32(code, cg_str(value_phys, 17, 0))
  emit_store_counter_from_phys(code, ctr, 17)
  ctr + 1
}

fn pipeline_cg_deref_typed(ptr: Expr, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let c1 = pipeline_cg_expr_typed(ptr, code, scope, src, ctr, fm)
  let ptr_phys = emit_load_reg(code, c1 - 1)
  bu32(code, cg_ldr(17, ptr_phys, 0))
  emit_store_counter_from_phys(code, ctr, 17)
  fmap_inc_typed_deref_emit_count(fm)
  ctr + 1
}

fn pipeline_cg_ptr_assign_typed(ptr: Expr, value: Expr, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let ptr_ty = pipeline_cg_expr_type_typed(ptr, scope, src, fm)
  let target_ty = if ty_is_ptr(ptr_ty) == 1 { ty_ptr_inner(ptr_ty) } else { ty_i64() }
  let cptr = pipeline_cg_expr_typed(ptr, code, scope, src, ctr, fm)
  let cval = pipeline_cg_expr_as_type_typed(value, target_ty, code, scope, src, cptr, fm)
  fmap_set_nonnegative_top(fm, 0)
  fmap_set_vector_data_top(fm, 0)
  cg_vector_facts_invalidate(fm)
  if cg_ty_is_managed(target_ty) == 1 {
    let val_rid = reg_id(cval - 1)
    if cg_expr_is_borrow_for_ty(target_ty, expr_to_node(value), scope, src, fm) == 1 {
      cg_emit_managed_retain_regid(code, fm, target_ty, val_rid)
    } else { 0 }
    let old_ptr_phys = emit_load_counter_to(code, cptr - 1, 17)
    bu32(code, cg_ldr(16, old_ptr_phys, 0))
    cg_emit_managed_release_phys_for_ty(code, fm, target_ty, 16)
  } else { 0 }
  let ptr_phys = emit_load_counter_to(code, cptr - 1, 16)
  let val_phys = emit_load_counter_to(code, cval - 1, 17)
  bu32(code, cg_str(val_phys, ptr_phys, 0))
  fmap_inc_typed_ptr_assign_emit_count(fm)
  cval
}

fn pipeline_cg_field_owner_type_for_any_field(tt: i64, src: i64, field_ns: i64, field_nl: i64) -> i64 {
  if tt == 0 { 0 }
  else {
    let n = __mem_load64(tt + 8)
    let d = __mem_load64(tt)
    let mut i = 0
    let mut result = 0
    while i < n {
      let entry = d + i * 56
      let kind = __mem_load64(entry + 16)
      if kind == 0 {
        let entry_src = __mem_load64(entry + 48)
        let idx = ttable_field_index(entry, entry_src, src, field_ns, field_nl)
        if idx >= 0 {
          result = ty_named(type_name_hash(entry_src, __mem_load64(entry), __mem_load64(entry + 8)), ty_i64())
          i = n
        } else {
          i = i + 1
        }
      } else {
        i = i + 1
      }
    }
    result
  }
}

fn pipeline_cg_field_layout_type_typed(base_ty: i64, tt: i64, src: i64, field_ns: i64, field_nl: i64) -> i64 {
  if cg_layout_vector_record_inline_eligible(tt, base_ty) == 1 { base_ty }
  else {
    let unresolved_named = if base_ty != 0 and ty_tag(base_ty) == 9 and ty_is_rc(base_ty) != 1 {
      cg_layout_record_entry(tt, base_ty) == 0
    } else { 0 }
    if type_is_unknown_or_any(base_ty) == 1 or unresolved_named == 1 {
      let owner_ty = pipeline_cg_field_owner_type_for_any_field(tt, src, field_ns, field_nl)
      if cg_layout_vector_record_inline_eligible(tt, owner_ty) == 1 { owner_ty } else { base_ty }
    } else { base_ty }
  }
}

fn pipeline_cg_field_access_typed(base: Expr, field_ns: i64, field_nl: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let tt = fmap_get_tt(fm)
  let base_ty = pipeline_cg_expr_type_typed(base, scope, src, fm)
  let layout_ty = pipeline_cg_field_layout_type_typed(base_ty, tt, src, field_ns, field_nl)
  let inline_record = cg_layout_vector_record_inline_eligible(tt, layout_ty)
  let c1 = pipeline_cg_expr_typed(base, code, scope, src, ctr, fm)
  let base_phys = emit_load_reg(code, c1 - 1)
  let idx = if layout_ty != 0 and ty_tag(layout_ty) == 9 {
    let found = ttable_find_field_by_type_hash(tt, ty_f1(layout_ty), src, field_ns, field_nl)
    if found >= 0 { found } else { ttable_find_any_field(tt, src, field_ns, field_nl) }
  } else { ttable_find_any_field(tt, src, field_ns, field_nl) }
  if inline_record == 1 {
    let off = cg_layout_field_offset(tt, layout_ty, idx)
    let size = cg_layout_field_size(tt, layout_ty, idx)
    let fty = cg_layout_field_type_at(cg_layout_record_entry(tt, layout_ty), layout_ty, idx)
    cg_emit_load_sized_from_addr(code, 17, base_phys, off, size, cg_layout_vector_element_mode(tt, fty))
  } else {
    let off = idx * 8
    bu32(code, cg_ldr(17, base_phys, off))
  }
  if c1 < 8 {
    bu32(code, encode_add_imm(c1 + 19, 17, 0))
  } else {
    emit_store_reg(code, c1, 17)
  }
  c1 + 1
}

fn pipeline_cg_expr_as_type_typed(expr: Expr, target_ty: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let raw = expr_to_node(expr)
  if cg_ty_is_f32(target_ty) == 1 and cg_expr_matches_f32_contextual(raw, cg_expr_type(raw, scope, src, fm)) == 1 {
    cg_expr_as_type(raw, target_ty, code, scope, src, ctr, fm)
  } else {
    pipeline_cg_expr_typed(expr, code, scope, src, ctr, fm)
  }
}

fn pipeline_cg_field_access_expr_type_typed(base: Expr, field_ns: i64, field_nl: i64, scope: i64, src: i64, fm: i64) -> i64 {
  let base_ty = pipeline_cg_expr_type_typed(base, scope, src, fm)
  let tt = fmap_get_tt(fm)
  let layout_ty = pipeline_cg_field_layout_type_typed(base_ty, tt, src, field_ns, field_nl)
  let idx = if layout_ty != 0 and ty_tag(layout_ty) == 9 {
    ttable_find_field_by_type_hash(tt, ty_f1(layout_ty), src, field_ns, field_nl)
  } else { 0 - 1 }
  let entry = cg_layout_record_entry(tt, layout_ty)
  let fty = cg_layout_field_type_at(entry, layout_ty, idx)
  if fty != 0 { fty } else { ty_i64() }
}

fn pipeline_cg_generic_call_expr_type_typed(type_args_typed: TypeExprList, inner_call: Expr, scope: i64, src: i64, fm: i64) -> i64 {
  match inner_call {
    Call(ns, nl, args) -> {
      let raw_type_args = type_expr_list_to_nodes(type_args_typed)
      let raw_call = node_new(4, ns, nl, expr_list_to_nodes(args), expr_list_len(args))
      let raw_node = node_new(36, raw_type_args, raw_call, 0, 0)
      let special_ty = cg_generic_call_expr_type(raw_node, fm, src)
      if special_ty != 0 { special_ty }
      else {
        let type_args = cg_type_args_in_current_context(fm, raw_type_args)
        let name_hash = str_hash(src, ns, nl)
        let tmpl_entry = mono_tmap_lookup(__mem_load64(fm + 80), name_hash)
        if tmpl_entry == 0 { cg_ftypes_lookup_ret(fmap_get_cg_ftypes(fm), src, ns, nl) }
        else {
          cg_generic_subst_ret(__mem_load64(tmpl_entry + 8), type_args)
        }
      }
    }
    _ -> cg_expr_type(node_new(36, type_expr_list_to_nodes(type_args_typed), expr_to_node(inner_call), 0, 0), scope, src, fm)
  }
}

fn pipeline_cg_expr_type_typed(expr: Expr, scope: i64, src: i64, fm: i64) -> i64 {
  match expr {
    GenericCall(type_args, inner_call) -> pipeline_cg_generic_call_expr_type_typed(type_args, inner_call, scope, src, fm)
    FieldAccess(base, field_ns, field_nl) -> pipeline_cg_field_access_expr_type_typed(base, field_ns, field_nl, scope, src, fm)
    MethodCall(recv, method_hash, args, type_hash) -> {
      let ret = ttable_lookup_method_ret(fmap_get_tt(fm), type_hash, method_hash)
      if ret != 0 { ret } else { ty_i64() }
    }
    AddressOf(mutable, target) -> ty_ptr_with_mut(pipeline_cg_expr_type_typed(target, scope, src, fm), mutable)
    Deref(ptr) -> {
      let ptr_ty = pipeline_cg_expr_type_typed(ptr, scope, src, fm)
      if ty_is_ptr(ptr_ty) == 1 { ty_ptr_inner(ptr_ty) } else { ty_i64() }
    }
    Let(ns, nl, value, body) -> {
      let binding_ty = pipeline_cg_expr_type_typed(value, scope, src, fm)
      let new_scope = scope_push_typed(scope, ns, nl, 0, binding_ty)
      pipeline_cg_expr_type_typed(body, new_scope, src, fm)
    }
    LetMut(ns, nl, value, body) -> {
      let binding_ty = pipeline_cg_expr_type_typed(value, scope, src, fm)
      let new_scope = scope_push_typed(scope, ns, nl, 0, binding_ty)
      pipeline_cg_expr_type_typed(body, new_scope, src, fm)
    }
    ForIter(var_ns, var_nl, collection, body) -> ty_nil()
    LetTyped(inner, ann_type) -> {
      let ann_ty = type_expr_to_node(ann_type)
      match inner {
        Let(ns, nl, value, body) -> {
          let new_scope = scope_push_typed(scope, ns, nl, 0, ann_ty)
          pipeline_cg_expr_type_typed(body, new_scope, src, fm)
        }
        LetMut(ns, nl, value, body) -> {
          let new_scope = scope_push_typed(scope, ns, nl, 0, ann_ty)
          pipeline_cg_expr_type_typed(body, new_scope, src, fm)
        }
        _ -> cg_expr_type(expr_to_node(expr), scope, src, fm)
      }
    }
    Block(first, rest) -> pipeline_cg_expr_type_typed(rest, scope, src, fm)
    Defer(cleanup, body) -> pipeline_cg_expr_type_typed(body, scope, src, fm)
    If(cond, then_body, else_body) -> cg_merge_expr_type(pipeline_cg_expr_type_typed(then_body, scope, src, fm), pipeline_cg_expr_type_typed(else_body, scope, src, fm))
    _ -> cg_expr_type(expr_to_node(expr), scope, src, fm)
  }
}

fn pipeline_cg_record_fields_typed(fields: RecordFieldList, index: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, info: i64) -> i64 {
  match fields {
    RecordFieldListNil -> ctr
    RecordFieldListCons(field, rest) -> {
      match field {
        RecordField(f_ns, f_nl, value) -> {
          let tt = fmap_get_tt(fm)
          let base_ctr = node_f1(info)
          let record_ty = node_f2(info)
          let inline_record = node_f3(info)
          let type_hash = ty_f1(record_ty)
          let field_idx = ttable_find_field_by_type_hash(tt, type_hash, src, f_ns, f_nl)
          let idx = if field_idx >= 0 { field_idx } else { index }
          let fty = cg_layout_field_type_at(cg_layout_record_entry(tt, record_ty), record_ty, idx)
          let c1 = if fty != 0 {
            pipeline_cg_expr_as_type_typed(value, fty, code, scope, src, ctr, fm)
          } else {
            pipeline_cg_expr_typed(value, code, scope, src, ctr, fm)
          }
          let base_phys = emit_load_reg(code, base_ctr)
          let val_phys = emit_load_rhs(code, c1 - 1)
          if inline_record == 1 {
            let off = cg_layout_field_offset(tt, record_ty, idx)
            let size = cg_layout_field_size(tt, record_ty, idx)
            cg_emit_store_sized_to_addr(code, base_phys, off, val_phys, size)
          } else {
            let off = idx * 8
            bu32(code, cg_str(val_phys, base_phys, off))
          }
          pipeline_cg_record_fields_typed(rest, index + 1, code, scope, src, c1, fm, info)
        }
        UnknownRecordField(tag) -> pipeline_cg_record_fields_typed(rest, index + 1, code, scope, src, ctr, fm, info)
      }
    }
  }
}

fn pipeline_cg_record_init_typed(type_ns: i64, type_nl: i64, fields: RecordFieldList, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let tt = fmap_get_tt(fm)
  let record_ty = ty_named(type_name_hash(src, type_ns, type_nl), ty_i64())
  let inline_record = cg_layout_vector_record_inline_eligible(tt, record_ty)
  let inline_size = if inline_record == 1 { cg_layout_record_inline_size(tt, record_ty) } else { 0 - 1 }
  let size = if inline_size > 0 { inline_size } else { record_field_list_len(fields) * 8 }
  emit_mov_imm(code, 0, size)
  cg_bump_alloc_reg(code, 17, 0)
  if ctr < 8 {
    bu32(code, encode_add_imm(ctr + 19, 17, 0))
  } else {
    emit_store_reg(code, ctr, 17)
  }
  pipeline_cg_record_fields_typed(fields, 0, code, scope, src, ctr + 1, fm, node_new(0, ctr, record_ty, inline_record, 0))
  ctr + 1
}

fn pipeline_cg_method_expr_as_param_typed(expr: Expr, params: i64, index: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let param_ty = cg_param_ty(params, index)
  if param_ty != 0 {
    pipeline_cg_expr_as_type_typed(expr, param_ty, code, scope, src, ctr, fm)
  } else {
    pipeline_cg_expr_typed(expr, code, scope, src, ctr, fm)
  }
}

fn pipeline_cg_method_args_eval_typed(args: ExprList, index: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, info: i64) -> i64 {
  match args {
    ExprListNil -> ctr
    ExprListCons(arg, rest) -> {
      let params = node_f1(info)
      let results = node_f2(info)
      let c1 = pipeline_cg_method_expr_as_param_typed(arg, params, index + 1, code, scope, src, ctr, fm)
      __mem_store64(results + (index + 1) * 8, c1 - 1)
      pipeline_cg_method_args_eval_typed(rest, index + 1, code, scope, src, c1, fm, info)
    }
  }
}

fn pipeline_cg_method_args_retain_typed(args: ExprList, index: i64, code: i64, scope: i64, src: i64, fm: i64, params: i64, results: i64) -> i64 {
  match args {
    ExprListNil -> 0
    ExprListCons(arg, rest) -> {
      let param_ty = cg_param_ty(params, index + 1)
      if cg_ty_is_managed(param_ty) == 1 {
        if cg_expr_is_borrow_for_ty(param_ty, expr_to_node(arg), scope, src, fm) == 1 {
          cg_emit_managed_retain_regid(code, fm, param_ty, reg_id(__mem_load64(results + (index + 1) * 8)))
        } else { 0 }
      } else { 0 }
      pipeline_cg_method_args_retain_typed(rest, index + 1, code, scope, src, fm, params, results)
    }
  }
}

fn pipeline_cg_method_call_typed(recv: Expr, method_hash: i64, args: ExprList, type_hash: i64, ctx: PipelineCgExprCtx) -> i64 {
  match ctx {
    PipelineCgExprCtx(code, scope, src, ctr, fm) -> {
      let nargs = expr_list_len(args)
      let mm = __mem_load64(fm + 72)
      let mut params = mmap_lookup_params(mm, type_hash, method_hash)
      let type_hash_is_trait = ttable_hash_is_trait(fmap_get_tt(fm), type_hash)
      if params == 0 and type_hash_is_trait == 1 { params = mmap_lookup_params_by_method(mm, method_hash) } else { params = params }
      let c1 = pipeline_cg_method_expr_as_param_typed(recv, params, 0, code, scope, src, ctr, fm)
      let self_ctr = c1 - 1
      let results = alloc_bump((nargs + 1) * 8)
      __mem_store64(results, self_ctr)
      let c = pipeline_cg_method_args_eval_typed(args, 0, code, scope, src, c1, fm, node_new(0, params, results, 0, 0))
      if params != 0 {
        let self_ty = cg_param_ty(params, 0)
        if cg_ty_is_managed(self_ty) == 1 {
          if cg_expr_is_borrow_for_ty(self_ty, expr_to_node(recv), scope, src, fm) == 1 {
            cg_emit_managed_retain_regid(code, fm, self_ty, reg_id(self_ctr))
          } else { 0 }
        } else { 0 }
        pipeline_cg_method_args_retain_typed(args, 0, code, scope, src, fm, params, results)
      } else { 0 }
      for j in 0..nargs + 1 {
        let result_ctr = __mem_load64(results + j * 8)
        let phys = emit_load_reg(code, result_ctr)
        bu32(code, encode_add_imm(j, phys, 0))
      }
      let mut target = mmap_lookup(mm, type_hash, method_hash)
      if target == 0 and type_hash_is_trait == 1 {
        target = mmap_lookup_by_method(mm, method_hash)
      } else { target = target }
      let cur = buf_len(code)
      if target == 0 {
        eprint("error: method not found (type_hash=")
        eprint_i(type_hash)
        eprint(", method_hash=")
        eprint_i(method_hash)
        eprint(")\n")
        bu32(code, encode_bl(0))
      } else {
        bu32(code, encode_bl(target - cur))
      }
      if c < 8 {
        bu32(code, encode_add_imm(c + 19, 0, 0))
      } else { emit_store_reg(code, c, 0) }
      fmap_inc_typed_method_call_emit_count(fm)
      c + 1
    }
  }
}

fn pipeline_cg_interp_concat_typed(left: Expr, right: Expr, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let c1 = pipeline_cg_expr_typed(left, code, scope, src, ctr, fm)
  let c2 = pipeline_cg_expr_typed(right, code, scope, src, c1, fm)
  let lp = emit_load_reg(code, c1 - 1)
  bu32(code, encode_add_imm(0, lp, 0))
  let rp = emit_load_reg(code, c2 - 1)
  bu32(code, encode_add_imm(1, rp, 0))
  let target = fmap_lookup_by_hash(fm, interp_str_concat_hash())
  let cur = buf_len(code)
  if target > 0 {
    bu32(code, encode_bl(target - cur))
  } else {
    fmap_add_patch_by_name(fm, cur, "str_concat")
    bu32(code, encode_bl(0))
  }
  if c2 < 8 {
    bu32(code, encode_add_imm(c2 + 19, 0, 0))
  } else { emit_store_reg(code, c2, 0) }
  c2 + 1
}

fn pipeline_cg_opt_chain_typed(base: Expr, field_ns: i64, field_nl: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let c1 = pipeline_cg_expr_typed(base, code, scope, src, ctr, fm)
  let base_ctr = c1 - 1
  let base_phys = emit_load_reg(code, base_ctr)
  let cbz_pos = buf_len(code)
  bu32(code, 0)
  let tt = fmap_get_tt(fm)
  let idx = if tt > 0 { ttable_find_any_field(tt, src, field_ns, field_nl) } else { 0 }
  let ok_phys = emit_load_reg(code, base_ctr)
  bu32(code, cg_ldr(17, ok_phys, idx * 8))
  if ctr < 8 {
    bu32(code, encode_add_imm(ctr + 19, 17, 0))
  } else { emit_store_reg(code, ctr, 17) }
  let b_over_pos = buf_len(code)
  bu32(code, 0)
  let nil_start = buf_len(code)
  cg_perform_lookup(code, fm, 210682486643, 6385518581)
  bu32(code, cg_ldr(9, 13, 8))
  bu32(code, cg_ldr(0, 13, 16))
  bu32(code, encode_blr(9))
  if ctr < 8 {
    bu32(code, encode_add_imm(ctr + 19, 0, 0))
  } else { emit_store_reg(code, ctr, 0) }
  let after = buf_len(code)
  let bd = buf_ptr(code)
  cg_patch_cbz(code, cbz_pos, base_phys, nil_start)
  let b_enc = encode_b(after - b_over_pos)
  __mem_store8(bd + b_over_pos, b_enc - b_enc / 256 * 256)
  __mem_store8(bd + b_over_pos + 1, b_enc / 256 - b_enc / 65536 * 256)
  __mem_store8(bd + b_over_pos + 2, b_enc / 65536 - b_enc / 16777216 * 256)
  __mem_store8(bd + b_over_pos + 3, b_enc / 16777216 - b_enc / 4294967296 * 256)
  ctr + 1
}

fn pipeline_cg_try_typed(inner: Expr, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let c1 = pipeline_cg_expr_typed(inner, code, scope, src, ctr, fm)
  let result_ctr = c1 - 1
  let result_phys = emit_load_reg(code, result_ctr)
  bu32(code, cg_ldr(17, result_phys, 0))
  emit_mov_imm(code, 16, 5862623)
  bu32(code, encode_cmp(17, 16))
  let bne_pos = buf_len(code)
  bu32(code, 0)
  let ok_phys = emit_load_reg(code, result_ctr)
  bu32(code, cg_ldr(17, ok_phys, 8))
  if ctr < 8 {
    bu32(code, encode_add_imm(ctr + 19, 17, 0))
  } else { emit_store_reg(code, ctr, 17) }
  let b_over_pos = buf_len(code)
  bu32(code, 0)
  let err_start = buf_len(code)
  cg_perform_lookup(code, fm, 6384065697, 6385215681)
  bu32(code, cg_ldr(9, 13, 8))
  bu32(code, cg_ldr(0, 13, 16))
  let err_arg_phys = emit_load_reg(code, result_ctr)
  bu32(code, cg_ldr(17, err_arg_phys, 8))
  bu32(code, encode_add_imm(1, 17, 0))
  bu32(code, encode_blr(9))
  if ctr < 8 {
    bu32(code, encode_add_imm(ctr + 19, 0, 0))
  } else { emit_store_reg(code, ctr, 0) }
  let after = buf_len(code)
  let bne_enc = encode_b_cond(err_start - bne_pos, 1)
  let bd = buf_ptr(code)
  __mem_store8(bd + bne_pos, bne_enc - bne_enc / 256 * 256)
  __mem_store8(bd + bne_pos + 1, bne_enc / 256 - bne_enc / 65536 * 256)
  __mem_store8(bd + bne_pos + 2, bne_enc / 65536 - bne_enc / 16777216 * 256)
  __mem_store8(bd + bne_pos + 3, bne_enc / 16777216 - bne_enc / 4294967296 * 256)
  let b_enc = encode_b(after - b_over_pos)
  __mem_store8(bd + b_over_pos, b_enc - b_enc / 256 * 256)
  __mem_store8(bd + b_over_pos + 1, b_enc / 256 - b_enc / 65536 * 256)
  __mem_store8(bd + b_over_pos + 2, b_enc / 65536 - b_enc / 16777216 * 256)
  __mem_store8(bd + b_over_pos + 3, b_enc / 16777216 - b_enc / 4294967296 * 256)
  ctr + 1
}

fn pipeline_cg_perform_args_eval_typed(args: ExprList, index: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, results: i64) -> i64 {
  match args {
    ExprListNil -> ctr
    ExprListCons(arg, rest) -> {
      let c1 = pipeline_cg_expr_typed(arg, code, scope, src, ctr, fm)
      __mem_store64(results + index * 8, c1 - 1)
      pipeline_cg_perform_args_eval_typed(rest, index + 1, code, scope, src, c1, fm, results)
    }
  }
}

fn pipeline_cg_perform_typed(lhs: Expr, op_ns: i64, op_nl: i64, args: ExprList, ctx: PipelineCgExprCtx) -> i64 {
  match ctx {
    PipelineCgExprCtx(code, scope, src, ctr, fm) -> {
      match lhs {
        Ident(eff_ns, eff_nl) -> {
          let lhs_raw = node_new(2, eff_ns, eff_nl, 0, 0)
          let raw = node_new(32, lhs_raw, op_ns, op_nl, expr_list_to_nodes(args))
          let eff_hash = str_hash(src, eff_ns, eff_nl)
          let op_hash = str_hash(src, op_ns, op_nl)
          if cg_fiber_lowering_matches(fm, eff_hash, op_hash) == 1 {
            fmap_inc_typed_fiber_perform_raw_count(fm)
            cg_perform(raw, code, scope, src, ctr, fm)
          } else { if cg_perform_is_scoped_alloc(raw, src, fm) == 1 {
            fmap_inc_typed_scoped_alloc_perform_raw_count(fm)
            cg_perform(raw, code, scope, src, ctr, fm)
          } else { if cg_perform_is_direct_par(raw, src, fm) == 1 {
            fmap_inc_typed_direct_par_perform_raw_count(fm)
            cg_perform(raw, code, scope, src, ctr, fm)
          } else {
            let nargs = expr_list_len(args)
            let arg_results = alloc_bump(nargs * 8 + 8)
            let c = pipeline_cg_perform_args_eval_typed(args, 0, code, scope, src, ctr, fm, arg_results)
            let raw_args = expr_list_to_nodes(args)
            let op_params = cg_effect_op_params(fmap_get_tt(fm), src, eff_ns, eff_nl, op_ns, op_nl)
            cg_perform_retain_borrowed_args(raw_args, nargs, op_params, arg_results, code, scope, src, fm)
            let evidence_ctr = cg_effect_evidence_find(fm, eff_hash, op_hash)
            fmap_inc_typed_perform_emit_count(fm)
            if evidence_ctr >= 0 {
              let evidence_op_index = cg_effect_evidence_find_op_index(fm, eff_hash, op_hash)
              let base_phys = emit_load_reg(code, evidence_ctr)
              bu32(code, encode_add_imm(13, base_phys, evidence_op_index * handler_ops_entry_size()))
              bu32(code, cg_ldr(9, 13, handler_ops_fn_ptr_offset()))
              bu32(code, cg_ldr(0, 13, handler_ops_env_ptr_offset()))
              for j in 0..nargs {
                let actr = __mem_load64(arg_results + j * 8)
                let ap = emit_load_reg(code, actr)
                bu32(code, encode_add_imm(j + 1, ap, 0))
              }
              bu32(code, encode_blr(9))
              if c < 8 {
                bu32(code, encode_add_imm(c + 19, 0, 0))
              } else { emit_store_reg(code, c, 0) }
              c + 1
            } else {
              let inline_match = cg_handler_inline_find(fm, src, eff_hash, op_hash)
              if inline_match != 0 {
                let info = __mem_load64(inline_match + cg_handler_inline_match_info_offset())
                let clause_start = __mem_load64(info)
                for j2 in 0..nargs {
                  let actr2 = __mem_load64(arg_results + j2 * 8)
                  let ap2 = emit_load_reg(code, actr2)
                  bu32(code, encode_add_imm(j2 + 1, ap2, 0))
                }
                let nfree = __mem_load64(inline_match + cg_handler_inline_match_nfree_offset())
                if nfree == 0 {
                  emit_mov_imm(code, 0, 0)
                } else {
                  let op_index = __mem_load64(inline_match + cg_handler_inline_match_index_offset())
                  let ops_ctr = __mem_load64(inline_match + cg_handler_inline_match_ops_ctr_offset())
                  let ops_phys = emit_load_reg(code, ops_ctr)
                  bu32(code, cg_ldr(0, ops_phys, op_index * handler_ops_entry_size() + handler_ops_env_ptr_offset()))
                }
                let cur = buf_len(code)
                bu32(code, encode_bl(clause_start - cur))
                if c < 8 {
                  bu32(code, encode_add_imm(c + 19, 0, 0))
                } else { emit_store_reg(code, c, 0) }
                c + 1
              } else {
                cg_perform_lookup(code, fm, eff_hash, op_hash)
                bu32(code, cg_ldr(9, 13, handler_ops_fn_ptr_offset()))
                bu32(code, cg_ldr(0, 13, handler_ops_env_ptr_offset()))
                for j3 in 0..nargs {
                  let actr3 = __mem_load64(arg_results + j3 * 8)
                  let ap3 = emit_load_reg(code, actr3)
                  bu32(code, encode_add_imm(j3 + 1, ap3, 0))
                }
                bu32(code, encode_blr(9))
                if c < 8 {
                  bu32(code, encode_add_imm(c + 19, 0, 0))
                } else { emit_store_reg(code, c, 0) }
                c + 1
              }
            }
          } } }
        }
        _ -> pipeline_cg_expr_typed_raw(Perform(lhs, op_ns, op_nl, args), code, scope, src, ctr, fm)
      }
    }
  }
}

fn pipeline_cg_perform_typed_from_raw(raw: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  pipeline_cg_perform_typed(
    expr_from_node(node_f1(raw)),
    node_f2(raw),
    node_f3(raw),
    expr_list_from_nodes(node_f4(raw), 0, nlist_len(node_f4(raw))),
    PipelineCgExprCtx(code, scope, src, ctr, fm)
  )
}

fn pipeline_handler_clause_list_has_continuation_typed(clauses: HandlerClauseList, nclauses: i64) -> i64 {
  let mut result = 0
  for ci in 0..nclauses {
    if handler_clause_has_continuation(handler_clause_list_nth(clauses, ci)) == 1 {
      result = 1
    } else { 0 }
  }
  result
}

fn pipeline_cg_handle_typed_raw(body: Expr, clauses: HandlerClauseList, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  cg_expr(expr_to_node(Handle(body, clauses)), code, scope, src, ctr, fm)
}

fn pipeline_cg_empty_handle_typed(body: Expr, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  fmap_inc_typed_empty_handle_emit_count(fm)
  pipeline_cg_expr_typed(body, code, scope, src, ctr, fm)
}

fn pipeline_cg_continuation_handle_typed_raw(body: Expr, clauses: HandlerClauseList, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  fmap_inc_typed_continuation_handle_raw_count(fm)
  pipeline_cg_handle_typed_raw(body, clauses, code, scope, src, ctr, fm)
}

fn pipeline_cg_handle_typed_from_raw(raw: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  pipeline_cg_handle_typed(
    expr_from_node(node_f1(raw)),
    handler_clause_list_from_nodes(node_f2(raw), 0, node_f3(raw)),
    PipelineCgExprCtx(code, scope, src, ctr, fm)
  )
}

fn pipeline_cg_handle_typed(body: Expr, clauses: HandlerClauseList, ctx: PipelineCgExprCtx) -> i64 {
  match ctx {
    PipelineCgExprCtx(code, scope, src, ctr, fm) -> {
      let nclauses = handler_clause_list_len(clauses)
      if nclauses <= 0 {
        pipeline_cg_empty_handle_typed(body, code, scope, src, ctr, fm)
      } else { if pipeline_handler_clause_list_has_continuation_typed(clauses, nclauses) == 1 {
        pipeline_cg_continuation_handle_typed_raw(body, clauses, code, scope, src, ctr, fm)
      } else {
        let eff_hash = pipeline_handler_clause_effect_hash_typed(src, handler_clause_list_nth(clauses, 0))
        let clause_infos = alloc_bump(nclauses * 8)
        for ci in 0..nclauses {
          let info = pipeline_ir_native_emit_hclause_body_cg(handler_clause_list_nth(clauses, ci), code, scope, src, fm)
          __mem_store64(clause_infos + ci * 8, info)
        }
        cg_bump_alloc_imm(code, 16, nclauses * handler_ops_entry_size())
        if ctr < 8 {
          bu32(code, encode_add_imm(ctr + 19, 16, 0))
        } else { emit_store_reg(code, ctr, 16) }
        let ops_ctr = ctr
        pipeline_ir_native_hfill_ops(clauses, nclauses, clause_infos, code, scope, src, ops_ctr)
        cg_hbuild_frame(code, eff_hash, nclauses, ops_ctr)
        let frame_ctr = ops_ctr + 1
        if frame_ctr < 8 {
          bu32(code, encode_add_imm(frame_ctr + 19, 27, 0))
        } else { emit_store_reg(code, frame_ctr, 27) }
        let raw_clauses = handler_clause_list_to_nodes(clauses)
        cg_handler_inline_push(fm, eff_hash, raw_clauses, clause_infos, nclauses, ops_ctr)
        let br = pipeline_cg_expr_typed(body, code, scope, src, frame_ctr + 1, fm)
        cg_handler_inline_pop(fm)
        let fp = emit_load_reg(code, frame_ctr)
        bu32(code, cg_ldr(27, fp, handler_frame_prev_offset()))
        let bp = emit_load_reg(code, br - 1)
        if ctr < 8 {
          bu32(code, encode_add_imm(ctr + 19, bp, 0))
        } else {
          bu32(code, encode_add_imm(17, bp, 0))
          emit_store_reg(code, ctr, 17)
        }
        fmap_inc_typed_handle_emit_count(fm)
        ctr + 1
      } }
    }
  }
}

fn pipeline_cg_binop_typed_raw(op: i64, lhs: Expr, rhs: Expr, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  cg_binop(node_new(3, op, expr_to_node(lhs), expr_to_node(rhs), 0), code, scope, src, ctr, fm)
}

fn pipeline_cg_binop_typed(op: i64, lhs: Expr, rhs: Expr, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let raw = node_new(3, op, expr_to_node(lhs), expr_to_node(rhs), 0)
  let float_kind = cg_binop_float_kind(raw, scope, src, fm)
  if op == 12 or op == 13 {
    pipeline_cg_binop_typed_raw(op, lhs, rhs, code, scope, src, ctr, fm)
  } else { if float_kind != 0 {
    pipeline_cg_binop_typed_raw(op, lhs, rhs, code, scope, src, ctr, fm)
  } else {
    let c1 = pipeline_cg_expr_typed(lhs, code, scope, src, ctr, fm)
    let c2 = pipeline_cg_expr_typed(rhs, code, scope, src, c1, fm)
    let lhs_phys = emit_load_reg(code, c1 - 1)
    let rhs_phys = emit_load_rhs(code, c2 - 1)
    let result_prim = cg_binop_int_result_prim(raw, scope, src, fm)
    let unsigned = cg_prim_is_unsigned_integer(result_prim)
    if op >= 5 and op <= 10 {
      cg_cmp_emit_typed(code, op, 17, lhs_phys, rhs_phys, unsigned)
    } else {
      cg_binop_emit_typed(code, op, 17, lhs_phys, rhs_phys, unsigned)
    }
    if op <= 4 or op == 11 or op >= 14 {
      cg_emit_int_normalize(code, result_prim, 17)
    } else { 0 }
    if ctr < 8 {
      bu32(code, encode_add_imm(ctr + 19, 17, 0))
    } else {
      emit_store_reg(code, ctr, 17)
    }
    ctr + 1
  } }
}

fn pipeline_cg_not_typed(operand: Expr, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let c1 = pipeline_cg_expr_typed(operand, code, scope, src, ctr, fm)
  let val_phys = emit_load_reg(code, c1 - 1)
  bu32(code, encode_cmp(val_phys, 31))
  if ctr < 8 {
    bu32(code, encode_cset(ctr + 19, 0))
  } else {
    bu32(code, encode_cset(17, 0))
    emit_store_reg(code, ctr, 17)
  }
  ctr + 1
}

fn pipeline_cg_if_typed(cond: Expr, then_body: Expr, else_body: Expr, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let direct_branch = cg_direct_branch_false(expr_to_node(cond), code, scope, src, ctr, fm)
  let mut cond_phys = 0
  let mut branch_pos = 0
  if direct_branch == 0 {
    let c1 = pipeline_cg_expr_typed(cond, code, scope, src, ctr, fm)
    cond_phys = emit_load_reg(code, c1 - 1)
    branch_pos = buf_len(code)
    bu32(code, 0)
  } else {
    branch_pos = node_f1(direct_branch)
  }
  let c2 = pipeline_cg_expr_typed(then_body, code, scope, src, ctr, fm)
  cg_match_store_result(code, ctr, c2)
  let b_pos = buf_len(code)
  bu32(code, 0)
  let else_start = buf_len(code)
  let c3 = pipeline_cg_expr_typed(else_body, code, scope, src, ctr, fm)
  cg_match_store_result(code, ctr, c3)
  let after_else = buf_len(code)
  if direct_branch == 0 {
    cg_patch_cbz(code, branch_pos, cond_phys, else_start)
  } else {
    cg_patch_branch_cond_list(code, branch_pos, else_start)
  }
  cg_patch_b(code, b_pos, after_else)
  ctr + 1
}

fn pipeline_cg_match_state(scrutinee_ctr: i64, arm_index: i64) -> i64 {
  node_new(0, scrutinee_ctr, arm_index, 0, 0)
}

fn pipeline_cg_match_state_scrutinee_ctr(state: i64) -> i64 { node_f1(state) }
fn pipeline_cg_match_state_arm_index(state: i64) -> i64 { node_f2(state) }

fn pipeline_cg_match_next_state(state: i64) -> i64 {
  pipeline_cg_match_state(pipeline_cg_match_state_scrutinee_ctr(state), pipeline_cg_match_state_arm_index(state) + 1)
}

fn pipeline_cg_match_remaining_typed(arms: MatchArmList, n_arms: i64, ctx: PipelineCgExprCtx, state: i64) -> i64 {
  match ctx {
    PipelineCgExprCtx(code, scope, src, ctr, fm) -> {
      let old_known = fmap_match_known_ctor_hash(fm)
      let remaining_hash = if old_known >= 0 { old_known } else { cg_match_remaining_known_ctor_hash(fm) }
      let did_set = if old_known < 0 and remaining_hash >= 0 {
        fmap_set_match_known_ctor_hash(fm, remaining_hash)
        1
      } else { 0 }
      let result = pipeline_cg_match_arms_typed(arms, n_arms, ctx, pipeline_cg_match_next_state(state))
      if did_set == 1 { fmap_set_match_known_ctor_hash(fm, old_known) } else { 0 }
      result
    }
  }
}

fn pipeline_cg_match_bind_scope_typed(pat: Pattern, scope: i64, src: i64, fm: i64, scrutinee_ctr: i64) -> i64 {
  match pat {
    Binding(ns, nl) -> {
      scope_push_typed_meta(scope, ns, nl, reg_id(scrutinee_ctr), fmap_match_scrutinee_type(fm), fmap_match_value_origin(fm))
    }
    _ -> scope
  }
}

fn pipeline_cg_match_low_arm_typed(arms: MatchArmList, n_arms: i64, ctx: PipelineCgExprCtx, state: i64) -> i64 {
  match ctx {
    PipelineCgExprCtx(code, scope, src, ctr, fm) -> {
      let arm = match_arm_list_nth(arms, pipeline_cg_match_state_arm_index(state))
      let pat = match_arm_pattern(arm)
      let body = match_arm_body_expr(arm)
      let guard = match_arm_guard_expr(arm)
      let has_guard = match_arm_has_guard(arm)
      let scrutinee_ctr = pipeline_cg_match_state_scrutinee_ctr(state)
      let body_scope = if pattern_tag(pat) == 18 { pipeline_cg_match_bind_scope_typed(pat, scope, src, fm, scrutinee_ctr) } else { scope }
      if has_guard == 0 {
        let c_body = pipeline_cg_expr_typed(body, code, body_scope, src, ctr, fm)
        cg_match_store_result(code, ctr, c_body)
        ctr + 1
      } else {
        let guard_cbz = pipeline_cg_rc_reuse_guard_cbz_typed(guard, has_guard, code, body_scope, src, ctr, fm)
        let c_body = pipeline_cg_expr_typed(body, code, body_scope, src, ctr, fm)
        cg_match_store_result(code, ctr, c_body)
        let b_pos = buf_len(code)
        bu32(code, 0)
        let next_start = buf_len(code)
        cg_patch_cbz(code, guard_cbz / 256, guard_cbz % 256, next_start)
        pipeline_cg_match_remaining_typed(arms, n_arms, ctx, state)
        let after = buf_len(code)
        cg_patch_b(code, b_pos, after)
        ctr + 1
      }
    }
  }
}

fn pipeline_cg_match_int_arm_typed(arms: MatchArmList, n_arms: i64, ctx: PipelineCgExprCtx, state: i64) -> i64 {
  match ctx {
    PipelineCgExprCtx(code, scope, src, ctr, fm) -> {
      let arm = match_arm_list_nth(arms, pipeline_cg_match_state_arm_index(state))
      let pat_raw = pattern_to_node(match_arm_pattern(arm))
      let body = match_arm_body_expr(arm)
      let guard = match_arm_guard_expr(arm)
      let has_guard = match_arm_has_guard(arm)
      let lit_val = node_f1(pat_raw)
      let scrutinee_ctr = pipeline_cg_match_state_scrutinee_ctr(state)
      let scr_phys = emit_load_reg(code, scrutinee_ctr)
      emit_mov_imm_safe(code, 17, lit_val)
      bu32(code, encode_cmp(scr_phys, 17))
      bu32(code, encode_cset(17, 0))
      let cbz_pos = buf_len(code)
      bu32(code, 0)
      let guard_cbz = pipeline_cg_rc_reuse_guard_cbz_typed(guard, has_guard, code, scope, src, ctr, fm)
      let c_body = pipeline_cg_expr_typed(body, code, scope, src, ctr, fm)
      cg_match_store_result(code, ctr, c_body)
      let b_pos = buf_len(code)
      bu32(code, 0)
      let next_start = buf_len(code)
      cg_patch_cbz(code, cbz_pos, 17, next_start)
      if has_guard != 0 { cg_patch_cbz(code, guard_cbz / 256, guard_cbz % 256, next_start) } else { 0 }
      pipeline_cg_match_remaining_typed(arms, n_arms, ctx, state)
      let after = buf_len(code)
      cg_patch_b(code, b_pos, after)
      ctr + 1
    }
  }
}

fn pipeline_cg_match_ctor_arm_typed(arms: MatchArmList, n_arms: i64, ctx: PipelineCgExprCtx, state: i64) -> i64 {
  match ctx {
    PipelineCgExprCtx(code, scope, src, ctr, fm) -> {
      let arm = match_arm_list_nth(arms, pipeline_cg_match_state_arm_index(state))
      let pat = match_arm_pattern(arm)
      let pat_raw = pattern_to_node(pat)
      let body = match_arm_body_expr(arm)
      let guard = match_arm_guard_expr(arm)
      let has_guard = match_arm_has_guard(arm)
      let scrutinee_ctr = pipeline_cg_match_state_scrutinee_ctr(state)
      let expected_hash = str_hash(src, node_f1(pat_raw), node_f2(pat_raw))
      let known_hash = fmap_match_known_ctor_hash(fm)
      let known_match = if known_hash == expected_hash { 1 } else { 0 }
      if known_hash >= 0 and known_match != 1 {
        fmap_inc_set_narrowing_elision_count(fm)
        pipeline_cg_match_remaining_typed(arms, n_arms, ctx, state)
      } else { if known_match == 1 {
        fmap_inc_set_narrowing_elision_count(fm)
        let body_scope = if node_f4(pat_raw) != 0 {
          cg_match_ctor_bind_only(code, scope, src, ctr, fm, scrutinee_ctr, pat_raw)
        } else { scope }
        let body_ctr = if node_f4(pat_raw) != 0 {
          if node_f4(pat_raw) < 0 { ctr + (0 - node_f4(pat_raw)) } else { ctr + 1 }
        } else { ctr }
        let guard_cbz = pipeline_cg_rc_reuse_guard_cbz_typed(guard, has_guard, code, body_scope, src, body_ctr, fm)
        let result = pipeline_cg_expr_typed(body, code, body_scope, src, body_ctr, fm)
        cg_match_store_result(code, ctr, result)
        if has_guard != 0 {
          let b_pos = buf_len(code)
          bu32(code, 0)
          let next_start = buf_len(code)
          cg_patch_cbz(code, guard_cbz / 256, guard_cbz % 256, next_start)
          pipeline_cg_match_remaining_typed(arms, n_arms, ctx, state)
          let after = buf_len(code)
          cg_patch_b(code, b_pos, after)
        } else { 0 }
        ctr + 1
      } else {
        cg_match_ctor_test(code, scrutinee_ctr, expected_hash)
        let cbz_pos = buf_len(code)
        bu32(code, 0)
        let body_scope = if node_f4(pat_raw) != 0 {
          cg_match_ctor_bind_only(code, scope, src, ctr, fm, scrutinee_ctr, pat_raw)
        } else { scope }
        let body_ctr = if node_f4(pat_raw) != 0 {
          if node_f4(pat_raw) < 0 { ctr + (0 - node_f4(pat_raw)) } else { ctr + 1 }
        } else { ctr }
        let guard_cbz = pipeline_cg_rc_reuse_guard_cbz_typed(guard, has_guard, code, body_scope, src, body_ctr, fm)
        let result = pipeline_cg_expr_typed(body, code, body_scope, src, body_ctr, fm)
        cg_match_store_result(code, ctr, result)
        let b_pos = buf_len(code)
        bu32(code, 0)
        let next_start = buf_len(code)
        cg_patch_cbz(code, cbz_pos, 17, next_start)
        if has_guard != 0 { cg_patch_cbz(code, guard_cbz / 256, guard_cbz % 256, next_start) } else { 0 }
        let old_eliminated = fmap_match_eliminated_hashes(fm)
        if has_guard == 0 {
          fmap_set_match_eliminated_hashes(fm, cg_hash_stack_push(old_eliminated, expected_hash))
        } else { 0 }
        pipeline_cg_match_remaining_typed(arms, n_arms, ctx, state)
        if has_guard == 0 { fmap_set_match_eliminated_hashes(fm, old_eliminated) } else { 0 }
        let after = buf_len(code)
        cg_patch_b(code, b_pos, after)
        ctr + 1
      } }
    }
  }
}

fn pipeline_cg_match_arms_typed(arms: MatchArmList, n_arms: i64, ctx: PipelineCgExprCtx, state: i64) -> i64 {
  match ctx {
    PipelineCgExprCtx(code, scope, src, ctr, fm) -> {
      let arm_index = pipeline_cg_match_state_arm_index(state)
      if arm_index >= n_arms {
        bu32(code, encode_brk(1))
        cg_int(node_new(1, 0, 0, 0, 0), code, ctr)
      } else {
        let pat_tag = pattern_tag(match_arm_pattern(match_arm_list_nth(arms, arm_index)))
        if pat_tag <= 18 {
          pipeline_cg_match_low_arm_typed(arms, n_arms, ctx, state)
        } else { if pat_tag == 19 {
          pipeline_cg_match_int_arm_typed(arms, n_arms, ctx, state)
        } else {
          pipeline_cg_match_ctor_arm_typed(arms, n_arms, ctx, state)
        } }
      }
    }
  }
}

fn pipeline_cg_match_typed(scrutinee: Expr, arms: MatchArmList, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let scrutinee_raw = expr_to_node(scrutinee)
  let known_hash = cg_expr_known_ctor_hash(scrutinee_raw, scope, src, fm)
  let scrutinee_ty = cg_expr_type(scrutinee_raw, scope, src, fm)
  let value_origin = cg_expr_value_origin(scrutinee_raw, scope, src, fm)
  let c1 = pipeline_cg_expr_typed(scrutinee, code, scope, src, ctr, fm)
  let old_known_hash = fmap_match_known_ctor_hash(fm)
  let old_scrutinee_ty = fmap_match_scrutinee_type(fm)
  let old_value_origin = fmap_match_value_origin(fm)
  let old_eliminated = fmap_match_eliminated_hashes(fm)
  fmap_set_match_known_ctor_hash(fm, known_hash)
  fmap_set_match_scrutinee_type(fm, scrutinee_ty)
  fmap_set_match_value_origin(fm, value_origin)
  fmap_set_match_eliminated_hashes(fm, 0)
  let result = pipeline_cg_match_arms_typed(arms, match_arm_list_len(arms), PipelineCgExprCtx(code, scope, src, c1, fm), pipeline_cg_match_state(c1 - 1, 0))
  fmap_set_match_known_ctor_hash(fm, old_known_hash)
  fmap_set_match_scrutinee_type(fm, old_scrutinee_ty)
  fmap_set_match_value_origin(fm, old_value_origin)
  fmap_set_match_eliminated_hashes(fm, old_eliminated)
  result
}

fn pipeline_cg_let_typed_raw(ns: i64, nl: i64, value: Expr, body: Expr, ctx: PipelineCgExprCtx) -> i64 {
  match ctx {
    PipelineCgExprCtx(code, scope, src, ctr, fm) -> {
      cg_let(node_new(6, ns, nl, expr_to_node(value), expr_to_node(body)), code, scope, src, ctr, fm)
    }
  }
}

fn pipeline_cg_let_try_f64_local_register_typed(ns: i64, nl: i64, value: Expr, body: Expr, binding_ty: i64, ctx: PipelineCgExprCtx) -> i64 {
  match ctx {
    PipelineCgExprCtx(code, scope, src, ctr, fm) -> {
      if cg_ty_is_f64(binding_ty) != 1 { 0 - 1 }
      else {
        let val_raw = expr_to_node(value)
        let body_raw = expr_to_node(body)
        if cg_expr_mentions_name(body_raw, src, ns, nl) != 1 { 0 - 1 }
        else { if cg_expr_has_name_write_or_bind(body_raw, src, ns, nl) == 1 { 0 - 1 }
        else { if cg_expr_has_call(body_raw) == 1 and cg_expr_has_f64_local_fp_clobber(body_raw, scope, src, fm) == 1 { 0 - 1 }
        else { if cg_f64_tree_can_direct(val_raw, scope, src, fm) != 1 { 0 - 1 }
        else {
          let rid = cg_scope_first_free_loop_f64_fp_regid(scope)
          if rid == 0 { 0 - 1 }
          else {
            let fd = cg_f64_fp_regid_phys(rid)
            let depth = cg_f64_tree_depth(val_raw, scope, src, fm)
            if fd + depth > 32 { 0 - 1 }
            else {
              cg_emit_f64_value_to_d(val_raw, code, scope, src, ctr, fm, fd)
              fmap_inc_f64_local_register_count(fm)
              let new_scope = scope_push_typed_meta(scope, ns, nl, rid, binding_ty, cg_expr_value_origin(val_raw, scope, src, fm))
              pipeline_cg_expr_typed(body, code, new_scope, src, ctr, fm)
            }
          }
        } } } }
      }
    }
  }
}

fn pipeline_cg_let_address_taken_typed(ns: i64, nl: i64, value: Expr, body: Expr, binding_ty: i64, ctx: PipelineCgExprCtx) -> i64 {
  match ctx {
    PipelineCgExprCtx(code, scope, src, ctr, fm) -> {
      let c1 = pipeline_cg_expr_typed(value, code, scope, src, ctr, fm)
      let address_ctr = if c1 - 1 < 8 { 8 } else { c1 - 1 }
      let value_phys = emit_load_reg(code, c1 - 1)
      bu32(code, encode_add_imm(17, value_phys, 0))
      emit_store_reg(code, address_ctr, 17)
      let val_rid = reg_id(address_ctr)
      let value_origin = cg_expr_value_origin(expr_to_node(value), scope, src, fm)
      let new_scope = scope_push_typed_meta(scope, ns, nl, val_rid, binding_ty, value_origin)
      pipeline_cg_expr_typed(body, code, new_scope, src, address_ctr + 1, fm)
    }
  }
}

fn pipeline_cg_rc_reuse_emit_after_prefix_binding_typed(ns: i64, nl: i64, prefix_value: Expr, rest: Expr, prefix_ty: i64, ctx: PipelineCgExprCtx, released_rid: i64, plan: i64) -> i64 {
  match ctx {
    PipelineCgExprCtx(code, scope, src, ctr, fm) -> {
      let release_size = cg_rc_reuse_plan_size(plan)
      let prefix_count = cg_rc_reuse_plan_prefix_count(plan)
      let c_prefix = pipeline_cg_expr_typed(prefix_value, code, scope, src, ctr, fm)
      let prefix_rid = reg_id(c_prefix - 1)
      let prefix_origin = cg_expr_value_origin(expr_to_node(prefix_value), scope, src, fm)
      let prefix_scope = scope_push_typed_meta(scope, ns, nl, prefix_rid, prefix_ty, prefix_origin)
      let old_vector_len_alias_top = fmap_vector_len_alias_top(fm)
      let old_vector_capacity_top = fmap_vector_capacity_top(fm)
      cg_vector_len_alias_push_if_needed(fm, src, ns, nl, expr_to_node(prefix_value), scope)
      cg_vector_capacity_push_if_needed(fm, src, ns, nl, expr_to_node(prefix_value), scope)
      let rest_plan = cg_rc_reuse_plan_new_with_prefix_count(cg_rc_reuse_plan_kind_after_prefix(), release_size, prefix_count - 1)
      let br = pipeline_cg_rc_reuse_emit_after_prefix_let_typed(rest, code, prefix_scope, src, c_prefix, fm, released_rid, rest_plan)
      fmap_set_vector_len_alias_top(fm, old_vector_len_alias_top)
      fmap_set_vector_capacity_top(fm, old_vector_capacity_top)
      br
    }
  }
}

fn pipeline_cg_rc_reuse_emit_after_prefix_let_typed(body: Expr, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, released_rid: i64, plan: i64) -> i64 {
  let release_size = cg_rc_reuse_plan_size(plan)
  let prefix_count = cg_rc_reuse_plan_prefix_count(plan)
  if prefix_count <= 0 {
    cg_inc_managed_reuse_lowering(fm, continuation_cleanup_kind_rc())
    cg_emit_managed_release_kind_regid_with_size(code, fm, continuation_cleanup_kind_rc(), released_rid, release_size)
    pipeline_cg_expr_typed(body, code, scope, src, ctr, fm)
  } else {
    match body {
      Let(ns, nl, prefix_value, rest) -> {
        let prefix_ty = cg_expr_type(expr_to_node(prefix_value), scope, src, fm)
        pipeline_cg_rc_reuse_emit_after_prefix_binding_typed(ns, nl, prefix_value, rest, prefix_ty, PipelineCgExprCtx(code, scope, src, ctr, fm), released_rid, plan)
      }
      LetTyped(inner, ann_type) -> {
        match inner {
          Let(ns, nl, prefix_value, rest) -> {
            pipeline_cg_rc_reuse_emit_after_prefix_binding_typed(ns, nl, prefix_value, rest, type_expr_to_node(ann_type), PipelineCgExprCtx(code, scope, src, ctr, fm), released_rid, plan)
          }
          _ -> cg_rc_reuse_emit_after_prefix_let(expr_to_node(body), code, scope, src, ctr, fm, released_rid, plan)
        }
      }
      _ -> cg_rc_reuse_emit_after_prefix_let(expr_to_node(body), code, scope, src, ctr, fm, released_rid, plan)
    }
  }
}

fn pipeline_cg_rc_reuse_store_branch_result_typed(code: i64, ctr: i64, result_ctr: i64) -> i64 {
  cg_match_store_result(code, ctr, result_ctr)
}

fn pipeline_cg_rc_reuse_emit_branch_if_typed(body: Expr, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, released_rid: i64, plan: i64) -> i64 {
  match body {
    If(cond, then_body, else_body) -> {
      let direct_branch = cg_direct_branch_false(expr_to_node(cond), code, scope, src, ctr, fm)
      let mut cond_phys = 0
      let mut branch_pos = 0
      if direct_branch == 0 {
        let c1 = pipeline_cg_expr_typed(cond, code, scope, src, ctr, fm)
        cond_phys = emit_load_reg(code, c1 - 1)
        branch_pos = buf_len(code)
        bu32(code, 0)
      } else {
        branch_pos = node_f1(direct_branch)
      }
      let c2 = pipeline_cg_rc_reuse_emit_after_prefix_let_typed(then_body, code, scope, src, ctr, fm, released_rid, cg_rc_reuse_plan_then(plan))
      pipeline_cg_rc_reuse_store_branch_result_typed(code, ctr, c2)
      let b_pos = buf_len(code)
      bu32(code, 0)
      let else_start = buf_len(code)
      let c3 = pipeline_cg_rc_reuse_emit_after_prefix_let_typed(else_body, code, scope, src, ctr, fm, released_rid, cg_rc_reuse_plan_else(plan))
      pipeline_cg_rc_reuse_store_branch_result_typed(code, ctr, c3)
      let after_else = buf_len(code)
      if direct_branch == 0 {
        cg_patch_cbz(code, branch_pos, cond_phys, else_start)
      } else {
        cg_patch_branch_cond_list(code, branch_pos, else_start)
      }
      cg_patch_b(code, b_pos, after_else)
      ctr + 1
    }
    _ -> cg_rc_reuse_emit_branch_if(expr_to_node(body), code, scope, src, ctr, fm, released_rid, plan)
  }
}

fn pipeline_cg_rc_reuse_emit_match_next_typed(arms: MatchArmList, n_arms: i64, ctx: PipelineCgExprCtx, state: i64) -> i64 {
  let next_state = cg_rc_reuse_match_state(
    cg_rc_reuse_match_state_scrutinee_ctr(state),
    cg_rc_reuse_match_state_released_rid(state),
    cg_rc_reuse_match_state_plans(state),
    cg_rc_reuse_match_state_arm_index(state) + 1
  )
  pipeline_cg_rc_reuse_emit_match_arms_typed(arms, n_arms, ctx, next_state)
}

fn pipeline_cg_rc_reuse_guard_cbz_typed(guard: Expr, has_guard: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  if has_guard == 0 {
    0
  } else {
    let cg = pipeline_cg_expr_typed(guard, code, scope, src, ctr, fm)
    let gp = emit_load_reg(code, cg - 1)
    let gpos = buf_len(code)
    bu32(code, 0)
    gpos * 256 + gp
  }
}

fn pipeline_cg_rc_reuse_emit_match_ctor_arm_typed(arms: MatchArmList, n_arms: i64, ctx: PipelineCgExprCtx, state: i64) -> i64 {
  match ctx {
    PipelineCgExprCtx(code, scope, src, ctr, fm) -> {
      let arm_index = cg_rc_reuse_match_state_arm_index(state)
      let arm = match_arm_list_nth(arms, arm_index)
      let pat = match_arm_pattern(arm)
      let pat_raw = pattern_to_node(pat)
      let body = match_arm_body_expr(arm)
      let guard = match_arm_guard_expr(arm)
      let has_guard = match_arm_has_guard(arm)
      let arm_plan = nlist_get(cg_rc_reuse_match_state_plans(state), arm_index)
      let released_rid = cg_rc_reuse_match_state_released_rid(state)
      let scrutinee_ctr = cg_rc_reuse_match_state_scrutinee_ctr(state)
      let expected_hash = str_hash(src, node_f1(pat_raw), node_f2(pat_raw))
      let known_hash = fmap_match_known_ctor_hash(fm)
      let known_match = if known_hash == expected_hash { 1 } else { 0 }
      if known_hash >= 0 and known_match != 1 {
        fmap_inc_set_narrowing_elision_count(fm)
        pipeline_cg_rc_reuse_emit_match_next_typed(arms, n_arms, ctx, state)
      } else { if known_match == 1 {
        fmap_inc_set_narrowing_elision_count(fm)
        let body_scope = if node_f4(pat_raw) != 0 {
          cg_match_ctor_bind_only(code, scope, src, ctr, fm, scrutinee_ctr, pat_raw)
        } else { scope }
        let body_ctr = if node_f4(pat_raw) != 0 {
          if node_f4(pat_raw) < 0 { ctr + (0 - node_f4(pat_raw)) } else { ctr + 1 }
        } else { ctr }
        let guard_cbz = pipeline_cg_rc_reuse_guard_cbz_typed(guard, has_guard, code, body_scope, src, body_ctr, fm)
        let c_body = pipeline_cg_rc_reuse_emit_after_prefix_let_typed(body, code, body_scope, src, body_ctr, fm, released_rid, arm_plan)
        cg_match_store_result(code, ctr, c_body)
        if has_guard != 0 {
          let b_pos = buf_len(code)
          bu32(code, 0)
          let next_start = buf_len(code)
          cg_patch_cbz(code, guard_cbz / 256, guard_cbz % 256, next_start)
          pipeline_cg_rc_reuse_emit_match_next_typed(arms, n_arms, ctx, state)
          let after = buf_len(code)
          cg_patch_b(code, b_pos, after)
        } else { 0 }
        ctr + 1
      } else {
        cg_match_ctor_test(code, scrutinee_ctr, expected_hash)
        let cbz_pos = buf_len(code)
        bu32(code, 0)
        let body_scope = if node_f4(pat_raw) != 0 {
          cg_match_ctor_bind_only(code, scope, src, ctr, fm, scrutinee_ctr, pat_raw)
        } else { scope }
        let body_ctr = if node_f4(pat_raw) != 0 {
          if node_f4(pat_raw) < 0 { ctr + (0 - node_f4(pat_raw)) } else { ctr + 1 }
        } else { ctr }
        let guard_cbz = pipeline_cg_rc_reuse_guard_cbz_typed(guard, has_guard, code, body_scope, src, body_ctr, fm)
        let c_body = pipeline_cg_rc_reuse_emit_after_prefix_let_typed(body, code, body_scope, src, body_ctr, fm, released_rid, arm_plan)
        cg_match_store_result(code, ctr, c_body)
        let b_pos = buf_len(code)
        bu32(code, 0)
        let next_start = buf_len(code)
        cg_patch_cbz(code, cbz_pos, 17, next_start)
        if has_guard != 0 { cg_patch_cbz(code, guard_cbz / 256, guard_cbz % 256, next_start) } else { 0 }
        pipeline_cg_rc_reuse_emit_match_next_typed(arms, n_arms, ctx, state)
        let after = buf_len(code)
        cg_patch_b(code, b_pos, after)
        ctr + 1
      } }
    }
  }
}

fn pipeline_cg_rc_reuse_emit_match_arms_typed(arms: MatchArmList, n_arms: i64, ctx: PipelineCgExprCtx, state: i64) -> i64 {
  match ctx {
    PipelineCgExprCtx(code, scope, src, ctr, fm) -> {
      let arm_index = cg_rc_reuse_match_state_arm_index(state)
      if arm_index >= n_arms {
        bu32(code, encode_brk(1))
        cg_int(node_new(1, 0, 0, 0, 0), code, ctr)
      } else {
        let arm = match_arm_list_nth(arms, arm_index)
        let pat = match_arm_pattern(arm)
        let pat_raw = pattern_to_node(pat)
        let body = match_arm_body_expr(arm)
        let guard = match_arm_guard_expr(arm)
        let has_guard = match_arm_has_guard(arm)
        let plans = cg_rc_reuse_match_state_plans(state)
        let arm_plan = nlist_get(plans, arm_index)
        let released_rid = cg_rc_reuse_match_state_released_rid(state)
        let scrutinee_ctr = cg_rc_reuse_match_state_scrutinee_ctr(state)
        let pat_tag = pattern_tag(pat)
        match pat_tag {
          17 -> {
            if has_guard == 0 {
              let c_body = pipeline_cg_rc_reuse_emit_after_prefix_let_typed(body, code, scope, src, ctr, fm, released_rid, arm_plan)
              cg_match_store_result(code, ctr, c_body)
              ctr + 1
            } else {
              let guard_cbz = pipeline_cg_rc_reuse_guard_cbz_typed(guard, has_guard, code, scope, src, ctr, fm)
              let c_body = pipeline_cg_rc_reuse_emit_after_prefix_let_typed(body, code, scope, src, ctr, fm, released_rid, arm_plan)
              cg_match_store_result(code, ctr, c_body)
              let b_pos = buf_len(code)
              bu32(code, 0)
              let next_start = buf_len(code)
              cg_patch_cbz(code, guard_cbz / 256, guard_cbz % 256, next_start)
              pipeline_cg_rc_reuse_emit_match_next_typed(arms, n_arms, ctx, state)
              let after = buf_len(code)
              cg_patch_b(code, b_pos, after)
              ctr + 1
            }
          }
          19 -> {
            let lit_val = node_f1(pat_raw)
            let scr_phys = emit_load_reg(code, scrutinee_ctr)
            emit_mov_imm_safe(code, 17, lit_val)
            bu32(code, encode_cmp(scr_phys, 17))
            bu32(code, encode_cset(17, 0))
            let cbz_pos = buf_len(code)
            bu32(code, 0)
            let guard_cbz = pipeline_cg_rc_reuse_guard_cbz_typed(guard, has_guard, code, scope, src, ctr, fm)
            let c_body = pipeline_cg_rc_reuse_emit_after_prefix_let_typed(body, code, scope, src, ctr, fm, released_rid, arm_plan)
            cg_match_store_result(code, ctr, c_body)
            let b_pos = buf_len(code)
            bu32(code, 0)
            let next_start = buf_len(code)
            cg_patch_cbz(code, cbz_pos, 17, next_start)
            if has_guard != 0 { cg_patch_cbz(code, guard_cbz / 256, guard_cbz % 256, next_start) } else { 0 }
            pipeline_cg_rc_reuse_emit_match_next_typed(arms, n_arms, ctx, state)
            let after = buf_len(code)
            cg_patch_b(code, b_pos, after)
            ctr + 1
          }
          20 -> pipeline_cg_rc_reuse_emit_match_ctor_arm_typed(arms, n_arms, ctx, state)
          _ -> {
            bu32(code, encode_brk(1))
            cg_int(node_new(1, 0, 0, 0, 0), code, ctr)
          }
        }
      }
    }
  }
}

fn pipeline_cg_rc_reuse_emit_match_typed(body: Expr, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, released_rid: i64, plan: i64) -> i64 {
  match body {
    Match(scrutinee, arms) -> {
      let scrutinee_raw = expr_to_node(scrutinee)
      let known_hash = cg_expr_known_ctor_hash(scrutinee_raw, scope, src, fm)
      let scrutinee_ty = cg_expr_type(scrutinee_raw, scope, src, fm)
      let value_origin = cg_expr_value_origin(scrutinee_raw, scope, src, fm)
      let c1 = pipeline_cg_expr_typed(scrutinee, code, scope, src, ctr, fm)
      let old_known_hash = fmap_match_known_ctor_hash(fm)
      let old_scrutinee_ty = fmap_match_scrutinee_type(fm)
      let old_value_origin = fmap_match_value_origin(fm)
      let old_eliminated = fmap_match_eliminated_hashes(fm)
      fmap_set_match_known_ctor_hash(fm, known_hash)
      fmap_set_match_scrutinee_type(fm, scrutinee_ty)
      fmap_set_match_value_origin(fm, value_origin)
      fmap_set_match_eliminated_hashes(fm, 0)
      let state = cg_rc_reuse_match_state(c1 - 1, released_rid, cg_rc_reuse_plan_arms(plan), 0)
      let result = pipeline_cg_rc_reuse_emit_match_arms_typed(arms, match_arm_list_len(arms), PipelineCgExprCtx(code, scope, src, c1, fm), state)
      fmap_set_match_known_ctor_hash(fm, old_known_hash)
      fmap_set_match_scrutinee_type(fm, old_scrutinee_ty)
      fmap_set_match_value_origin(fm, old_value_origin)
      fmap_set_match_eliminated_hashes(fm, old_eliminated)
      result
    }
    _ -> cg_rc_reuse_emit_match(expr_to_node(body), code, scope, src, ctr, fm, released_rid, plan)
  }
}

fn pipeline_cg_let_cleanup_typed(ns: i64, nl: i64, value: Expr, body: Expr, binding_ty: i64, ctx: PipelineCgExprCtx) -> i64 {
  match ctx {
    PipelineCgExprCtx(code, scope, src, ctr, fm) -> {
      let val_raw = expr_to_node(value)
      let body_raw = expr_to_node(body)
      let reuse_facts = cg_rc_reuse_facts_for_let(binding_ty, val_raw, body_raw, scope, src, ns, nl, fm)
      let reuse_plan = cg_rc_reuse_plan_for_facts(body_raw, scope, src, ns, nl, fm, reuse_facts)
      let reuse_plan_kind = cg_rc_reuse_plan_kind(reuse_plan)
        let depth = cg_cleanup_count(fm)
        let c1 = pipeline_cg_expr_typed(value, code, scope, src, ctr, fm)
        let address_taken = cg_expr_takes_address_of_name(body_raw, src, ns, nl)
        let address_ctr = if address_taken == 1 {
          if c1 - 1 < 8 { 8 } else { c1 - 1 }
        } else { c1 - 1 }
        if address_taken == 1 {
          let value_phys = emit_load_reg(code, c1 - 1)
          bu32(code, encode_add_imm(17, value_phys, 0))
          emit_store_reg(code, address_ctr, 17)
        } else { 0 }
        let body_ctr = if address_taken == 1 { address_ctr + 1 } else { c1 }
        let val_rid = reg_id(address_ctr)
        let reuse_plan_size = cg_rc_reuse_plan_size(reuse_plan)
        if cg_ty_is_managed(binding_ty) == 1 {
          if reuse_plan_kind == cg_rc_reuse_plan_kind_immediate() {
            cg_inc_managed_reuse_lowering(fm, continuation_cleanup_kind_rc())
            cg_emit_managed_release_kind_regid_with_size(code, fm, continuation_cleanup_kind_rc(), val_rid, reuse_plan_size)
          } else {
            cg_record_rc_reuse_body_candidate_with_facts(fm, body_raw, scope, src, reuse_facts)
            let elide_alias = cg_managed_let_alias_can_elide(binding_ty, val_raw, body_raw, src, fm)
            if elide_alias == 1 {
              fmap_inc_rc_elision_count(fm)
            } else {
              if cg_expr_is_borrow_for_ty(binding_ty, val_raw, scope, src, fm) == 1 {
                cg_emit_managed_retain_regid(code, fm, binding_ty, val_rid)
              } else { 0 }
              cg_cleanup_push_for_ty_sized(fm, binding_ty, val_rid, cg_managed_cleanup_release_size_for_expr(binding_ty, val_raw, scope, src, fm))
            }
          }
        } else { 0 }
        let owned_scope_cleanup = cg_owned_scope_cleanup_for_ty(fm, binding_ty, depth)
        if ty_is_owned(binding_ty) == 1 { cg_cleanup_push_owned_drop_for_ty(fm, binding_ty, val_rid) } else { 0 }
        let value_origin = if expr_tag(value) == 29 {
          cg_origin_make_lambda(val_raw, scope)
        } else { cg_expr_value_origin(val_raw, scope, src, fm) }
        let new_scope = scope_push_typed_meta(scope, ns, nl, val_rid, binding_ty, value_origin)
        let old_vector_len_alias_top = fmap_vector_len_alias_top(fm)
        let old_vector_capacity_top = fmap_vector_capacity_top(fm)
        cg_vector_len_alias_push_if_needed(fm, src, ns, nl, val_raw, scope)
        cg_vector_capacity_push_if_needed(fm, src, ns, nl, val_raw, scope)
        let br = if reuse_plan_kind == cg_rc_reuse_plan_kind_after_prefix() {
          pipeline_cg_rc_reuse_emit_after_prefix_let_typed(body, code, new_scope, src, body_ctr, fm, val_rid, reuse_plan)
        } else { if reuse_plan_kind == cg_rc_reuse_plan_kind_branch() {
          pipeline_cg_rc_reuse_emit_branch_if_typed(body, code, new_scope, src, body_ctr, fm, val_rid, reuse_plan)
        } else { if reuse_plan_kind == cg_rc_reuse_plan_kind_match() {
          pipeline_cg_rc_reuse_emit_match_typed(body, code, new_scope, src, body_ctr, fm, val_rid, reuse_plan)
        } else { pipeline_cg_expr_typed(body, code, new_scope, src, body_ctr, fm) } } }
        fmap_set_vector_len_alias_top(fm, old_vector_len_alias_top)
        fmap_set_vector_capacity_top(fm, old_vector_capacity_top)
        let emit_scope_cleanup = if reuse_plan_kind == cg_rc_reuse_plan_kind_after_prefix() or reuse_plan_kind == cg_rc_reuse_plan_kind_branch() or reuse_plan_kind == cg_rc_reuse_plan_kind_match() {
          0
        } else { if cg_ty_is_managed(binding_ty) == 1 {
          1
        } else { if owned_scope_cleanup == 1 and cg_cleanup_count(fm) > depth { 1 } else { 0 } } }
        if emit_scope_cleanup == 1 {
          let save_ctr = br
          cg_match_store_result(code, save_ctr, br)
          if cg_expr_is_borrow_for_ty(binding_ty, body_raw, new_scope, src, fm) == 1 {
            cg_emit_managed_retain_regid(code, fm, binding_ty, reg_id(save_ctr))
          } else { 0 }
          cg_emit_cleanups_to_depth(code, src, save_ctr + 1, fm, depth)
          cg_cleanup_restore(fm, depth)
          cg_match_store_result(code, ctr, save_ctr + 1)
          ctr + 1
        } else { br }
    }
  }
}

fn pipeline_cg_let_typed(ns: i64, nl: i64, value: Expr, body: Expr, binding_ty: i64, ctx: PipelineCgExprCtx) -> i64 {
  match ctx {
    PipelineCgExprCtx(code, scope, src, ctr, fm) -> {
      let body_raw = expr_to_node(body)
      if binding_ty == 0 or cg_ty_is_managed(binding_ty) == 1 or ty_is_owned(binding_ty) == 1 or ty_is_unique(binding_ty) == 1 {
        pipeline_cg_let_cleanup_typed(ns, nl, value, body, binding_ty, ctx)
      } else { if cg_ty_is_f64(binding_ty) == 1 {
        let f64_local = pipeline_cg_let_try_f64_local_register_typed(ns, nl, value, body, binding_ty, ctx)
        if f64_local >= 0 { f64_local } else { pipeline_cg_let_typed_raw(ns, nl, value, body, ctx) }
      } else { if cg_ty_is_f32(binding_ty) == 1 {
        pipeline_cg_let_typed_raw(ns, nl, value, body, ctx)
      } else { if cg_expr_takes_address_of_name(body_raw, src, ns, nl) == 1 {
        pipeline_cg_let_address_taken_typed(ns, nl, value, body, binding_ty, ctx)
      } else {
        let c1 = pipeline_cg_expr_typed(value, code, scope, src, ctr, fm)
        let val_rid = reg_id(c1 - 1)
        let value_origin = cg_expr_value_origin(expr_to_node(value), scope, src, fm)
        let new_scope = scope_push_typed_meta(scope, ns, nl, val_rid, binding_ty, value_origin)
        pipeline_cg_expr_typed(body, code, new_scope, src, c1, fm)
      } } } }
    }
  }
}

fn pipeline_cg_let_mut_typed_raw(ns: i64, nl: i64, value: Expr, body: Expr, binding_ty: i64, ctx: PipelineCgExprCtx) -> i64 {
  match ctx {
    PipelineCgExprCtx(code, scope, src, ctr, fm) -> {
      cg_let_mut_with_type(node_new(11, ns, nl, expr_to_node(value), expr_to_node(body)), code, scope, src, ctr, fm, binding_ty, 0 - 1)
    }
  }
}

fn pipeline_cg_let_mut_managed_typed(ns: i64, nl: i64, value: Expr, body: Expr, binding_ty: i64, ctx: PipelineCgExprCtx) -> i64 {
  match ctx {
    PipelineCgExprCtx(code, scope, src, ctr, fm) -> {
      fmap_inc_typed_let_mut_managed_emit_count(fm)
      let val_raw = expr_to_node(value)
      let body_raw = expr_to_node(body)
      let depth = cg_cleanup_count(fm)
      let c1 = pipeline_cg_expr_as_type_typed(value, binding_ty, code, scope, src, ctr, fm)
      let val_phys = emit_load_reg(code, c1 - 1)
      let mut_ctr = if c1 - 1 < 8 { 8 } else { c1 - 1 }
      bu32(code, encode_add_imm(17, val_phys, 0))
      emit_store_reg(code, mut_ctr, 17)
      let val_rid = reg_id(mut_ctr)
      cg_record_rc_reuse_body_candidate(fm, binding_ty, val_raw, body_raw, scope, src, ns, nl)
      if cg_expr_is_borrow_for_ty(binding_ty, val_raw, scope, src, fm) == 1 {
        cg_emit_managed_retain_regid(code, fm, binding_ty, val_rid)
      } else { 0 }
      cg_cleanup_push_for_ty_sized(fm, binding_ty, val_rid, cg_managed_cleanup_release_size_for_expr(binding_ty, val_raw, scope, src, fm))
      let new_scope = scope_push_typed(scope, ns, nl, val_rid, binding_ty)
      let old_nonnegative_top = fmap_nonnegative_top(fm)
      if cg_expr_is_nonnegative_i64_literal(val_raw) == 1 { cg_nonnegative_push(fm, src, ns, nl) } else { 0 }
      let br = pipeline_cg_expr_typed(body, code, new_scope, src, mut_ctr + 1, fm)
      fmap_set_nonnegative_top(fm, old_nonnegative_top)
      let save_ctr = br
      cg_match_store_result(code, save_ctr, br)
      if cg_expr_is_borrow_for_ty(binding_ty, body_raw, new_scope, src, fm) == 1 {
        cg_emit_managed_retain_regid(code, fm, binding_ty, reg_id(save_ctr))
      } else { 0 }
      cg_emit_cleanups_to_depth(code, src, save_ctr + 1, fm, depth)
      cg_cleanup_restore(fm, depth)
      cg_match_store_result(code, ctr, save_ctr + 1)
      ctr + 1
    }
  }
}

fn pipeline_cg_let_mut_linear_typed(ns: i64, nl: i64, value: Expr, body: Expr, binding_ty: i64, ctx: PipelineCgExprCtx) -> i64 {
  match ctx {
    PipelineCgExprCtx(code, scope, src, ctr, fm) -> {
      fmap_inc_typed_let_mut_linear_emit_count(fm)
      let val_raw = expr_to_node(value)
      let body_raw = expr_to_node(body)
      let depth = cg_cleanup_count(fm)
      let c1 = pipeline_cg_expr_as_type_typed(value, binding_ty, code, scope, src, ctr, fm)
      let val_phys = emit_load_reg(code, c1 - 1)
      let mut_ctr = if c1 - 1 < 8 { 8 } else { c1 - 1 }
      bu32(code, encode_add_imm(17, val_phys, 0))
      emit_store_reg(code, mut_ctr, 17)
      let val_rid = reg_id(mut_ctr)
      let owned_scope_cleanup = cg_owned_scope_cleanup_for_ty(fm, binding_ty, depth)
      if ty_is_owned(binding_ty) == 1 { cg_cleanup_push_owned_drop_for_ty(fm, binding_ty, val_rid) } else { 0 }
      let new_scope = scope_push_typed(scope, ns, nl, val_rid, binding_ty)
      let old_nonnegative_top = fmap_nonnegative_top(fm)
      if cg_expr_is_nonnegative_i64_literal(val_raw) == 1 { cg_nonnegative_push(fm, src, ns, nl) } else { 0 }
      let br = pipeline_cg_expr_typed(body, code, new_scope, src, mut_ctr + 1, fm)
      fmap_set_nonnegative_top(fm, old_nonnegative_top)
      if owned_scope_cleanup == 1 and cg_cleanup_count(fm) > depth {
        let save_ctr = br
        cg_match_store_result(code, save_ctr, br)
        if cg_expr_is_borrow_for_ty(binding_ty, body_raw, new_scope, src, fm) == 1 {
          cg_emit_managed_retain_regid(code, fm, binding_ty, reg_id(save_ctr))
        } else { 0 }
        cg_emit_cleanups_to_depth(code, src, save_ctr + 1, fm, depth)
        cg_cleanup_restore(fm, depth)
        cg_match_store_result(code, ctr, save_ctr + 1)
        ctr + 1
      } else { br }
    }
  }
}

fn pipeline_cg_let_mut_typed(ns: i64, nl: i64, value: Expr, body: Expr, binding_ty: i64, ctx: PipelineCgExprCtx) -> i64 {
  match ctx {
    PipelineCgExprCtx(code, scope, src, ctr, fm) -> {
      let is_fp_scalar = cg_ty_is_f64(binding_ty) == 1 or cg_ty_is_f32(binding_ty) == 1
      if binding_ty == 0 {
        pipeline_cg_let_mut_typed_raw(ns, nl, value, body, binding_ty, ctx)
      } else { if cg_ty_is_managed(binding_ty) == 1 {
        pipeline_cg_let_mut_managed_typed(ns, nl, value, body, binding_ty, ctx)
      } else { if ty_is_owned(binding_ty) == 1 or ty_is_unique(binding_ty) == 1 {
        pipeline_cg_let_mut_linear_typed(ns, nl, value, body, binding_ty, ctx)
      } else {
        if is_fp_scalar == 1 { fmap_inc_typed_let_mut_fp_emit_count(fm) } else { 0 }
        let value_raw = expr_to_node(value)
        let c1 = pipeline_cg_expr_as_type_typed(value, binding_ty, code, scope, src, ctr, fm)
        let val_phys = emit_load_reg(code, c1 - 1)
        let mut_ctr = if c1 - 1 < 8 { 8 } else { c1 - 1 }
        bu32(code, encode_add_imm(17, val_phys, 0))
        emit_store_reg(code, mut_ctr, 17)
        let new_scope = scope_push_typed(scope, ns, nl, reg_id(mut_ctr), binding_ty)
        let old_nonnegative_top = fmap_nonnegative_top(fm)
        if cg_expr_is_nonnegative_i64_literal(value_raw) == 1 { cg_nonnegative_push(fm, src, ns, nl) } else { 0 }
        let br = pipeline_cg_expr_typed(body, code, new_scope, src, mut_ctr + 1, fm)
        fmap_set_nonnegative_top(fm, old_nonnegative_top)
        br
      } } }
    }
  }
}

fn pipeline_cg_assign_typed(ns: i64, nl: i64, value: Expr, ctx: PipelineCgExprCtx) -> i64 {
  match ctx {
    PipelineCgExprCtx(code, scope, src, ctr, fm) -> {
      let value_raw = expr_to_node(value)
      let raw = node_new(12, ns, nl, value_raw, 0)
      let var_rid = scope_lookup(scope, src, ns, nl)
      let var_ty = scope_lookup_type(scope, src, ns, nl)
      if var_rid == 0 - 999 {
        cg_assign(raw, code, scope, src, ctr, fm)
      } else { if cg_regid_is_f64_fp(var_rid) == 1 and ty_eq(var_ty, ty_f64()) == 1 {
        cg_assign(raw, code, scope, src, ctr, fm)
      } else {
        let c1 = pipeline_cg_expr_as_type_typed(value, var_ty, code, scope, src, ctr, fm)
        let val_rid = reg_id(c1 - 1)
        if cg_assignment_preserves_existing_nonnegative(fm, raw, src) != 1 {
          fmap_set_nonnegative_top(fm, 0)
        } else { 0 }
        if cg_vector_data_find(fm, src, ns, nl) >= 0 {
          fmap_set_vector_data_top(fm, 0)
        } else { 0 }
        cg_vector_facts_invalidate(fm)
        if cg_ty_is_managed(var_ty) == 1 {
          if cg_expr_is_borrow_for_ty(var_ty, value_raw, scope, src, fm) == 1 {
            cg_emit_managed_retain_regid(code, fm, var_ty, val_rid)
          } else { 0 }
          cg_emit_managed_release_regid(code, fm, var_ty, var_rid)
        } else { 0 }
        let val_phys = emit_load_reg(code, c1 - 1)
        if var_rid < 0 {
          let slot = 0 - var_rid - 1
          bu32(code, cg_str(val_phys, 31, slot * 8))
        } else {
          bu32(code, encode_add_imm(var_rid, val_phys, 0))
        }
        c1
      } }
    }
  }
}

fn pipeline_cg_cleanup_push_typed(fm: i64, cleanup: Expr, scope: i64) -> i64 {
  cg_cleanup_push_typed_marker(fm, expr_to_node(cleanup), scope)
}

fn pipeline_cg_emit_cleanup_entry_typed(code: i64, src: i64, ctr: i64, fm: i64, entry: i64) -> i64 {
  if cg_cleanup_entry_is_typed_marker(entry) == 1 {
    fmap_inc_typed_cleanup_emit_count(fm)
    pipeline_cg_expr_typed(expr_from_node(node_f1(entry)), code, node_f2(entry), src, ctr, fm)
  } else {
    cg_emit_cleanup_entry(code, src, ctr, fm, entry)
  }
}

fn pipeline_cg_emit_cleanups_to_depth_phase_typed(code: i64, src: i64, ctr: i64, fm: i64, depth: i64, phase: i64) -> i64 {
  let stack = cg_cleanup_stack(fm)
  let old_len = nlist_len(stack)
  let mut remaining = old_len - depth
  let mut c = ctr
  while remaining > 0 {
    let i = depth + remaining - 1
    let entry = nlist_get(stack, i)
    if cg_cleanup_entry_phase(entry) == phase {
      __mem_store64(stack + 8, i)
      c = pipeline_cg_emit_cleanup_entry_typed(code, src, c, fm, entry)
      __mem_store64(stack + 8, old_len)
    } else { 0 }
    remaining = remaining - 1
  }
  __mem_store64(stack + 8, old_len)
  c
}

fn pipeline_cg_emit_cleanups_to_depth_typed(code: i64, src: i64, ctr: i64, fm: i64, depth: i64) -> i64 {
  let c1 = pipeline_cg_emit_cleanups_to_depth_phase_typed(code, src, ctr, fm, depth, 1)
  let c2 = pipeline_cg_emit_cleanups_to_depth_phase_typed(code, src, c1, fm, depth, 2)
  pipeline_cg_emit_cleanups_to_depth_phase_typed(code, src, c2, fm, depth, 3)
}

fn pipeline_cg_defer_typed(cleanup: Expr, body: Expr, ctx: PipelineCgExprCtx) -> i64 {
  match ctx {
    PipelineCgExprCtx(code, scope, src, ctr, fm) -> {
      let depth = cg_cleanup_count(fm)
      pipeline_cg_cleanup_push_typed(fm, cleanup, scope)
      let br = pipeline_cg_expr_typed(body, code, scope, src, ctr, fm)
      let save_ctr = br
      cg_match_store_result(code, save_ctr, br)
      pipeline_cg_emit_cleanups_to_depth_typed(code, src, save_ctr + 1, fm, depth)
      cg_cleanup_restore(fm, depth)
      cg_match_store_result(code, ctr, save_ctr + 1)
      ctr + 1
    }
  }
}

fn pipeline_cg_return_typed(value: Expr, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let ret_ty = fmap_get_current_ret_ty(fm)
  let c1 = pipeline_cg_expr_as_type_typed(value, ret_ty, code, scope, src, ctr, fm)
  let save_ctr = c1
  cg_match_store_result(code, save_ctr, c1)
  if cg_ty_is_managed(ret_ty) == 1 {
    if cg_expr_is_borrow_for_ty(ret_ty, expr_to_node(value), scope, src, fm) == 1 {
      cg_emit_managed_retain_regid(code, fm, ret_ty, reg_id(save_ctr))
    } else { 0 }
  } else { 0 }
  pipeline_cg_emit_cleanups_to_depth_typed(code, src, save_ctr + 1, fm, 0)
  let result_phys = emit_load_reg(code, save_ctr)
  bu32(code, encode_add_imm(0, result_phys, 0))
  emit_epilogue_current(code, fm)
  ctr + 1
}

fn pipeline_cg_return_no_value_typed(code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  cg_int(node_new(1, 0, 0, 0, 0), code, ctr)
  pipeline_cg_emit_cleanups_to_depth_typed(code, src, ctr + 1, fm, 0)
  let result_phys = emit_load_reg(code, ctr)
  bu32(code, encode_add_imm(0, result_phys, 0))
  emit_epilogue_current(code, fm)
  ctr + 1
}

fn pipeline_cg_break_typed(value: Expr, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let c1 = pipeline_cg_expr_typed(value, code, scope, src, ctr, fm)
  let loop_result_ctr = fmap_loop_result_ctr(fm)
  if loop_result_ctr >= 0 {
    cg_match_store_result(code, loop_result_ctr, c1)
  } else { 0 }
  pipeline_cg_emit_cleanups_to_depth_typed(code, src, c1, fm, __mem_load64(fm + 152))
  let patches = __mem_load64(fm + 64)
  if patches > 0 {
    nlist_add(patches, buf_len(code))
    bu32(code, 0)
  } else {
    eprint("error: break outside of loop\n")
  }
  cg_int(node_new(1, 0, 0, 0, 0), code, ctr)
}

fn pipeline_cg_break_no_value_typed(code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  pipeline_cg_emit_cleanups_to_depth_typed(code, src, ctr, fm, __mem_load64(fm + 152))
  let patches = __mem_load64(fm + 64)
  if patches > 0 {
    nlist_add(patches, buf_len(code))
    bu32(code, 0)
  } else {
    eprint("error: break outside of loop\n")
  }
  cg_int(node_new(1, 0, 0, 0, 0), code, ctr)
}

fn pipeline_cg_continue_typed(code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let loop_start = __mem_load64(fm + 56)
  if loop_start > 0 {
    pipeline_cg_emit_cleanups_to_depth_typed(code, src, ctr, fm, __mem_load64(fm + 152))
    let cur = buf_len(code)
    bu32(code, encode_b(loop_start - cur))
  } else {
    eprint("error: continue outside of loop\n")
  }
  cg_int(node_new(1, 0, 0, 0, 0), code, ctr)
}

fn pipeline_cg_loop_typed(body: Expr, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let old_loop_start = __mem_load64(fm + 56)
  let old_break_patches = __mem_load64(fm + 64)
  let old_loop_cleanup_depth = __mem_load64(fm + 152)
  let old_loop_result_ctr = fmap_loop_result_ctr(fm)
  let loop_start = buf_len(code)
  let break_patches = nlist_new()
  __mem_store64(fm + 56, loop_start)
  __mem_store64(fm + 64, break_patches)
  __mem_store64(fm + 152, cg_cleanup_count(fm))
  fmap_set_loop_result_ctr(fm, ctr)
  pipeline_cg_expr_typed(body, code, scope, src, ctr, fm)
  bu32(code, encode_b(loop_start - buf_len(code)))
  let after_loop = buf_len(code)
  cg_patch_breaks(code, break_patches, after_loop)
  __mem_store64(fm + 56, old_loop_start)
  __mem_store64(fm + 64, old_break_patches)
  __mem_store64(fm + 152, old_loop_cleanup_depth)
  fmap_set_loop_result_ctr(fm, old_loop_result_ctr)
  ctr + 1
}

fn pipeline_cg_while_typed(cond: Expr, body: Expr, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let old_loop_start = __mem_load64(fm + 56)
  let old_break_patches = __mem_load64(fm + 64)
  let old_loop_cleanup_depth = __mem_load64(fm + 152)
  let old_loop_result_ctr = fmap_loop_result_ctr(fm)
  let old_vector_bounds_top = fmap_vector_bounds_top(fm)
  let old_vector_data_top = fmap_vector_data_top(fm)
  let old_vector_push_proof_top = fmap_vector_push_proof_top(fm)
  let old_nonnegative_top = fmap_nonnegative_top(fm)
  let old_loop_addr_recur_top = fmap_loop_addr_recur_top(fm)
  let loop_start = buf_len(code)
  let break_patches = nlist_new()
  __mem_store64(fm + 56, loop_start)
  __mem_store64(fm + 64, break_patches)
  __mem_store64(fm + 152, cg_cleanup_count(fm))
  fmap_set_loop_result_ctr(fm, 0 - 1)
  let c1 = pipeline_cg_expr_typed(cond, code, scope, src, ctr, fm)
  let cond_phys = emit_load_reg(code, c1 - 1)
  let branch_pos = buf_len(code)
  bu32(code, 0)
  pipeline_cg_expr_typed(body, code, scope, src, c1, fm)
  fmap_set_vector_bounds_top(fm, old_vector_bounds_top)
  fmap_set_vector_data_top(fm, old_vector_data_top)
  fmap_set_vector_push_proof_top(fm, old_vector_push_proof_top)
  fmap_set_nonnegative_top(fm, old_nonnegative_top)
  fmap_set_loop_addr_recur_top(fm, old_loop_addr_recur_top)
  let b_pos = buf_len(code)
  bu32(code, encode_b(loop_start - b_pos))
  let after_loop = buf_len(code)
  cg_patch_cbz(code, branch_pos, cond_phys, after_loop)
  cg_patch_breaks(code, break_patches, after_loop)
  __mem_store64(fm + 56, old_loop_start)
  __mem_store64(fm + 64, old_break_patches)
  __mem_store64(fm + 152, old_loop_cleanup_depth)
  fmap_set_loop_result_ctr(fm, old_loop_result_ctr)
  cg_int(node_new(1, 0, 0, 0, 0), code, ctr)
}

fn pipeline_cg_lambda_typed(params_typed: ParamList, body_typed: Expr, ctx: PipelineCgExprCtx) -> i64 {
  match ctx {
    PipelineCgExprCtx(code, scope, src, ctr, fm) -> {
      fmap_inc_typed_lambda_emit_count(fm)
      let params = param_list_to_nodes(params_typed)
      let body = expr_to_node(body_typed)
      let nparams = param_list_len(params_typed)
      let lambda_raw = node_new(29, params, body, nparams, 0)
      let lambda_scope = pipeline_ir_native_hclause_lambda_scope_params(params_typed, 0, scope_new())
      let free_vars = nlist_new()
      pipeline_typed_find_free_vars_expr(body_typed, lambda_scope, scope, src, free_vars)
      let nfree = nlist_len(free_vars)
      let lambda_evidence_info = cg_effect_evidence_info_for_lambda(lambda_raw, fm, src)
      let lambda_evidence_slots = if lambda_evidence_info == 0 { 0 } else { 1 }
      let skip_pos = buf_len(code)
      bu32(code, 0)
      let lambda_start = buf_len(code)
      let preserve_scope = pipeline_ir_native_hclause_params_type_scope(
        params_typed,
        0,
        cg_free_vars_type_scope(free_vars, nfree, scope, src, scope_new())
      )
      let old_preserve_fp = pipeline_cg_enter_function_fp_preserve_typed(fm, body_typed, preserve_scope, src)
      emit_prologue_current(code, fm)
      let old_ret_ty = fmap_get_current_ret_ty(fm)
      let old_cleanup_stack = cg_cleanup_stack(fm)
      let old_loop_cleanup_depth = __mem_load64(fm + 152)
      let old_par_lowering_top = fmap_par_lowering_top(fm)
      let old_handler_inline_top = fmap_handler_inline_top(fm)
      let old_evidence_top = fmap_effect_evidence_top(fm)
      let old_callback_top = fmap_effect_callback_top(fm)
      let old_reuse_token = cg_reuse_token_snapshot(fm)
      __mem_store64(fm + 144, nlist_new())
      __mem_store64(fm + 152, 0)
      cg_reuse_token_clear(fm)
      fmap_set_par_lowering_top(fm, 0)
      fmap_set_handler_inline_top(fm, 0)
      fmap_set_effect_evidence_top(fm, 0)
      fmap_set_effect_callback_top(fm, 0)
      let mut body_scope = scope_new()
      let mut body_ctr = nparams
      for ci in 0..nfree {
        let fv = nlist_get(free_vars, ci)
        let cap_reg = body_ctr + 19
        let cap_off = 8 + ci * 16
        if body_ctr < 8 {
          bu32(code, cg_ldr(cap_reg, 0, cap_off))
        } else {
          bu32(code, cg_ldr(17, 0, cap_off))
          emit_store_reg(code, body_ctr, 17)
        }
        let cap_ty = scope_lookup_type(scope, src, node_f1(fv), node_f2(fv))
        body_scope = scope_push_typed(body_scope, node_f1(fv), node_f2(fv), reg_id(body_ctr), cap_ty)
        body_ctr = body_ctr + 1
      }
      if lambda_evidence_info != 0 {
        let evidence_off = 8 + nfree * 16
        if body_ctr < 8 {
          bu32(code, cg_ldr(body_ctr + 19, 0, evidence_off))
        } else {
          bu32(code, cg_ldr(17, 0, evidence_off))
          emit_store_reg(code, body_ctr, 17)
        }
        cg_effect_evidence_push_ops(fm, cg_evidence_info_ops(lambda_evidence_info), body_ctr)
        body_ctr = body_ctr + 1
      } else { 0 }
      for param_i in 0..nparams {
        let p = nlist_get(params, param_i)
        let src_reg = param_i + 1
        let param_ty = node_f3(p)
        if body_ctr < 8 {
          let dst_reg = reg_phys(body_ctr)
          bu32(code, encode_add_imm(dst_reg, src_reg, 0))
          body_scope = scope_push_typed(body_scope, node_f1(p), node_f2(p), dst_reg, param_ty)
          cg_cleanup_push_for_ty(fm, param_ty, dst_reg)
        } else {
          emit_store_reg(code, body_ctr, src_reg)
          body_scope = scope_push_typed(body_scope, node_f1(p), node_f2(p), reg_id(body_ctr), param_ty)
          cg_cleanup_push_for_ty(fm, param_ty, reg_id(body_ctr))
        }
        body_ctr = body_ctr + 1
      }
      let lambda_ret_ty = pipeline_cg_expr_type_typed(body_typed, body_scope, src, fm)
      fmap_set_current_ret_ty(fm, lambda_ret_ty)
      let body_result = pipeline_cg_expr_typed(body_typed, code, body_scope, src, body_ctr, fm)
      let save_ctr = body_result
      cg_match_store_result(code, save_ctr, body_result)
      if cg_ty_is_managed(lambda_ret_ty) == 1 {
        if cg_expr_is_borrow_for_ty(lambda_ret_ty, body, body_scope, src, fm) == 1 {
          cg_emit_managed_retain_regid(code, fm, lambda_ret_ty, reg_id(save_ctr))
        } else { 0 }
      } else { 0 }
      pipeline_cg_emit_cleanups_to_depth_typed(code, src, save_ctr + 1, fm, 0)
      cg_cleanup_restore(fm, 0)
      let result_phys = emit_load_reg(code, save_ctr)
      bu32(code, encode_add_imm(0, result_phys, 0))
      emit_epilogue_current(code, fm)
      cg_restore_function_fp_preserve(fm, old_preserve_fp)
      fmap_set_current_ret_ty(fm, old_ret_ty)
      __mem_store64(fm + 144, old_cleanup_stack)
      __mem_store64(fm + 152, old_loop_cleanup_depth)
      fmap_set_par_lowering_top(fm, old_par_lowering_top)
      fmap_set_handler_inline_top(fm, old_handler_inline_top)
      fmap_set_effect_evidence_top(fm, old_evidence_top)
      fmap_set_effect_callback_top(fm, old_callback_top)
      cg_reuse_token_restore(fm, old_reuse_token)
      let after_lambda = buf_len(code)
      cg_patch_b(code, skip_pos, after_lambda)
      cg_emit_rc_default_alloc_lit(code, fm, continuation_cleanup_kind_closure(), 16, 8)
      if ctr < 8 {
        bu32(code, encode_add_imm(ctr + 19, 0, 0))
      } else {
        emit_store_reg(code, ctr, 0)
      }
      let closure_rid = reg_id(ctr)
      let closure_phys1 = emit_load_reg(code, ctr)
      let adr_pos = buf_len(code)
      let adr_off = lambda_start - adr_pos
      bu32(code, encode_adr(17, adr_off))
      bu32(code, cg_str(17, closure_phys1, 0))
      let env_slots = nfree + lambda_evidence_slots
      if env_slots > 0 {
        let env_size = 8 + env_slots * 16
        emit_mov_imm(code, 0, env_size)
        emit_mov_imm(code, 1, 8)
        cg_emit_call_lit(code, fm, "rc_default_alloc")
        let env_ctr = ctr + 1
        if env_ctr < 8 {
          bu32(code, encode_add_imm(env_ctr + 19, 0, 0))
        } else {
          emit_store_reg(code, env_ctr, 0)
        }
        let env_phys0 = emit_load_reg(code, env_ctr)
        emit_mov_imm(code, 9, env_slots)
        bu32(code, cg_str(9, env_phys0, 0))
        for ei in 0..nfree {
          let fv = nlist_get(free_vars, ei)
          let enc_reg = scope_lookup(scope, src, node_f1(fv), node_f2(fv))
          let enc_phys = if enc_reg < 0 {
            let slot = 0 - enc_reg - 1
            bu32(code, cg_ldr(9, 31, slot * 8))
            9
          } else { enc_reg }
          let env_phys = emit_load_reg(code, env_ctr)
          let val_off = 8 + ei * 16
          let flag_off = 16 + ei * 16
          bu32(code, cg_str(enc_phys, env_phys, val_off))
          let cap_ty = scope_lookup_type(scope, src, node_f1(fv), node_f2(fv))
          let cap_kind = cg_managed_drop_kind_for_ty(cap_ty)
          if cap_kind == continuation_cleanup_kind_rc() {
            cg_emit_rc_retain_phys(code, fm, enc_phys)
            let env_phys2 = emit_load_reg(code, env_ctr)
            emit_mov_imm(code, 9, 1)
            bu32(code, cg_str(9, env_phys2, flag_off))
          } else {
            if cap_kind == continuation_cleanup_kind_closure() {
              cg_emit_closure_retain_phys(code, fm, enc_phys)
              let env_phys3 = emit_load_reg(code, env_ctr)
              emit_mov_imm(code, 9, 2)
              bu32(code, cg_str(9, env_phys3, flag_off))
            } else {
              if cap_kind == continuation_cleanup_kind_weak() {
                cg_emit_weak_retain_phys(code, fm, enc_phys)
                let env_phys4 = emit_load_reg(code, env_ctr)
                emit_mov_imm(code, 9, 4)
                bu32(code, cg_str(9, env_phys4, flag_off))
              } else {
                let env_phys5 = emit_load_reg(code, env_ctr)
                emit_mov_imm(code, 9, 0)
                bu32(code, cg_str(9, env_phys5, flag_off))
              }
            }
          }
        }
        if lambda_evidence_info != 0 {
          let evidence_val_off = 8 + nfree * 16
          let evidence_flag_off = 16 + nfree * 16
          cg_emit_active_evidence_base_value(code, fm, src, lambda_evidence_info, 9)
          let env_phys_evidence = emit_load_reg(code, env_ctr)
          bu32(code, cg_str(9, env_phys_evidence, evidence_val_off))
          let env_phys_evidence_flag = emit_load_reg(code, env_ctr)
          emit_mov_imm(code, 9, 0)
          bu32(code, cg_str(9, env_phys_evidence_flag, evidence_flag_off))
        } else { 0 }
        let closure_phys2 = if closure_rid < 0 {
          let slot2 = 0 - closure_rid - 1
          bu32(code, cg_ldr(16, 31, slot2 * 8))
          16
        } else { closure_rid }
        let env_phys4 = emit_load_rhs(code, env_ctr)
        bu32(code, cg_str(env_phys4, closure_phys2, 8))
      } else {
        let closure_phys3 = if closure_rid < 0 {
          let slot3 = 0 - closure_rid - 1
          bu32(code, cg_ldr(16, 31, slot3 * 8))
          16
        } else { closure_rid }
        emit_mov_imm(code, 17, 0)
        bu32(code, cg_str(17, closure_phys3, 8))
      }
      ctr + 1
    }
  }
}

fn pipeline_cons_variant_hash() -> i64 {
  str_hash(__str_ptr("Cons"), 0, __str_len("Cons"))
}

fn pipeline_cg_for_iter_item_type_typed(collection: Expr, scope: i64, src: i64, fm: i64) -> i64 {
  let collection_ty = pipeline_cg_expr_type_typed(collection, scope, src, fm)
  cg_named_variant_payload_type_by_hash(fmap_get_tt(fm), collection_ty, pipeline_cons_variant_hash(), 0)
}

fn pipeline_cg_for_iter_typed(var_ns: i64, var_nl: i64, collection: Expr, body: Expr, ctx: PipelineCgExprCtx) -> i64 {
  match ctx {
    PipelineCgExprCtx(code, scope, src, ctr, fm) -> {
      fmap_inc_typed_for_iter_emit_count(fm)
      let old_loop_start = __mem_load64(fm + 56)
      let old_break_patches = __mem_load64(fm + 64)
      let old_loop_cleanup_depth = __mem_load64(fm + 152)
      let old_loop_result_ctr = fmap_loop_result_ctr(fm)
      let c1 = pipeline_cg_expr_typed(collection, code, scope, src, ctr, fm)
      let col_ctr = c1 - 1
      let break_patches = nlist_new()
      let loop_cleanup_depth = cg_cleanup_count(fm)
      let entry_jump = buf_len(code)
      bu32(code, 0)
      let advance_start = buf_len(code)
      let col_phys_advance = emit_load_reg(code, col_ctr)
      bu32(code, cg_ldr(17, col_phys_advance, 16))
      if col_ctr < 8 {
        bu32(code, encode_add_imm(col_ctr + 19, 17, 0))
      } else { emit_store_reg(code, col_ctr, 17) }
      let check_start = buf_len(code)
      cg_patch_b(code, entry_jump, check_start)
      __mem_store64(fm + 56, advance_start)
      __mem_store64(fm + 64, break_patches)
      __mem_store64(fm + 152, loop_cleanup_depth)
      fmap_set_loop_result_ctr(fm, 0 - 1)
      let col_phys_check = emit_load_reg(code, col_ctr)
      bu32(code, cg_ldr(17, col_phys_check, 0))
      emit_mov_imm(code, 16, pipeline_nil_variant_hash())
      bu32(code, encode_cmp(17, 16))
      let beq_pos = buf_len(code)
      bu32(code, 0)
      let col_phys_item = emit_load_reg(code, col_ctr)
      bu32(code, cg_ldr(17, col_phys_item, 8))
      let item_ctr = c1
      if item_ctr < 8 {
        bu32(code, encode_add_imm(item_ctr + 19, 17, 0))
      } else { emit_store_reg(code, item_ctr, 17) }
      let item_ty = pipeline_cg_for_iter_item_type_typed(collection, scope, src, fm)
      let body_scope = scope_push_typed(scope, var_ns, var_nl, reg_id(item_ctr), item_ty)
      pipeline_cg_expr_typed(body, code, body_scope, src, item_ctr + 1, fm)
      bu32(code, encode_b(advance_start - buf_len(code)))
      let loop_end = buf_len(code)
      let beq_enc = encode_b_cond(loop_end - beq_pos, 0)
      let bd = buf_ptr(code)
      __mem_store8(bd + beq_pos, beq_enc - beq_enc / 256 * 256)
      __mem_store8(bd + beq_pos + 1, beq_enc / 256 - beq_enc / 65536 * 256)
      __mem_store8(bd + beq_pos + 2, beq_enc / 65536 - beq_enc / 16777216 * 256)
      __mem_store8(bd + beq_pos + 3, beq_enc / 16777216 - beq_enc / 4294967296 * 256)
      cg_patch_breaks(code, break_patches, loop_end)
      __mem_store64(fm + 56, old_loop_start)
      __mem_store64(fm + 64, old_break_patches)
      __mem_store64(fm + 152, old_loop_cleanup_depth)
      fmap_set_loop_result_ctr(fm, old_loop_result_ctr)
      cg_int(node_new(1, 0, 0, 0, 0), code, ctr)
    }
  }
}

fn pipeline_cg_expr_discard_typed(expr: Expr, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  pipeline_cg_expr_typed(expr, code, scope, src, ctr, fm)
  ctr
}

fn pipeline_cg_expr_typed(expr: Expr, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  match expr {
    IntLit(value) -> cg_int(node_new(1, value, 0, 0, 0), code, ctr)
    BoolLit(value) -> cg_int(node_new(1, value, 0, 0, 0), code, ctr)
    NilExpr -> cg_int(node_new(1, 0, 0, 0, 0), code, ctr)
    StringLit(start, len) -> cg_string(node_new(9, start, len, 0, 0), code, scope, src, ctr, fm)
    Ident(ns, nl) -> cg_ident(node_new(2, ns, nl, 0, 0), code, scope, src, ctr, fm)
    BinOp(op, lhs, rhs) -> pipeline_cg_binop_typed(op, lhs, rhs, code, scope, src, ctr, fm)
    Not(operand) -> pipeline_cg_not_typed(operand, code, scope, src, ctr, fm)
    If(cond, then_body, else_body) -> pipeline_cg_if_typed(cond, then_body, else_body, code, scope, src, ctr, fm)
    While(cond, body) -> pipeline_cg_while_typed(cond, body, code, scope, src, ctr, fm)
    Loop(body) -> pipeline_cg_loop_typed(body, code, scope, src, ctr, fm)
    Break(value) -> pipeline_cg_break_typed(value, code, scope, src, ctr, fm)
    BreakNoValue -> pipeline_cg_break_no_value_typed(code, scope, src, ctr, fm)
    Continue -> pipeline_cg_continue_typed(code, scope, src, ctr, fm)
    Return(value) -> pipeline_cg_return_typed(value, code, scope, src, ctr, fm)
    ReturnNoValue -> pipeline_cg_return_no_value_typed(code, scope, src, ctr, fm)
    Match(scrutinee, arms) -> pipeline_cg_match_typed(scrutinee, arms, code, scope, src, ctr, fm)
    Let(ns, nl, value, body) -> pipeline_cg_let_typed(ns, nl, value, body, pipeline_cg_expr_type_typed(value, scope, src, fm), PipelineCgExprCtx(code, scope, src, ctr, fm))
    LetMut(ns, nl, value, body) -> pipeline_cg_let_mut_typed(ns, nl, value, body, pipeline_cg_expr_type_typed(value, scope, src, fm), PipelineCgExprCtx(code, scope, src, ctr, fm))
    Assign(ns, nl, value) -> pipeline_cg_assign_typed(ns, nl, value, PipelineCgExprCtx(code, scope, src, ctr, fm))
    Call(ns, nl, args) -> pipeline_cg_call_typed(ns, nl, args, code, scope, src, ctr, fm)
    GenericCall(type_args, inner_call) -> pipeline_cg_generic_call_typed(type_args, inner_call, code, scope, src, ctr, fm)
    Lambda(params, body) -> pipeline_cg_lambda_typed(params, body, PipelineCgExprCtx(code, scope, src, ctr, fm))
    Perform(lhs, op_ns, op_nl, args) -> pipeline_cg_perform_typed(lhs, op_ns, op_nl, args, PipelineCgExprCtx(code, scope, src, ctr, fm))
    Handle(body, clauses) -> pipeline_cg_handle_typed(body, clauses, PipelineCgExprCtx(code, scope, src, ctr, fm))
    Resume(value) -> pipeline_cg_resume_typed(value, code, scope, src, ctr, fm)
    AddressOf(mutable, target) -> pipeline_cg_address_of_typed(mutable, target, code, scope, src, ctr, fm)
    Deref(ptr) -> pipeline_cg_deref_typed(ptr, code, scope, src, ctr, fm)
    PtrAssign(ptr, value) -> pipeline_cg_ptr_assign_typed(ptr, value, code, scope, src, ctr, fm)
    FieldAccess(base, field_ns, field_nl) -> pipeline_cg_field_access_typed(base, field_ns, field_nl, code, scope, src, ctr, fm)
    RecordInit(type_ns, type_nl, fields) -> pipeline_cg_record_init_typed(type_ns, type_nl, fields, code, scope, src, ctr, fm)
    MethodCall(recv, method_hash, args, type_hash) -> pipeline_cg_method_call_typed(recv, method_hash, args, type_hash, PipelineCgExprCtx(code, scope, src, ctr, fm))
    InterpConcat(left, right) -> pipeline_cg_interp_concat_typed(left, right, code, scope, src, ctr, fm)
    OptChain(base, field_ns, field_nl) -> pipeline_cg_opt_chain_typed(base, field_ns, field_nl, code, scope, src, ctr, fm)
    Try(inner) -> pipeline_cg_try_typed(inner, code, scope, src, ctr, fm)
    Defer(cleanup, body) -> pipeline_cg_defer_typed(cleanup, body, PipelineCgExprCtx(code, scope, src, ctr, fm))
    ForIter(var_ns, var_nl, collection, body) -> pipeline_cg_for_iter_typed(var_ns, var_nl, collection, body, PipelineCgExprCtx(code, scope, src, ctr, fm))
    Block(first, rest) -> {
      pipeline_cg_expr_discard_typed(first, code, scope, src, ctr, fm)
      pipeline_cg_expr_typed(rest, code, scope, src, ctr, fm)
    }
    LetTyped(inner, ann_type) -> {
      match inner {
        Let(ns, nl, value, body) -> pipeline_cg_let_typed(ns, nl, value, body, type_expr_to_node(ann_type), PipelineCgExprCtx(code, scope, src, ctr, fm))
        LetMut(ns, nl, value, body) -> pipeline_cg_let_mut_typed(ns, nl, value, body, type_expr_to_node(ann_type), PipelineCgExprCtx(code, scope, src, ctr, fm))
        _ -> pipeline_cg_expr_as_type_typed(inner, type_expr_to_node(ann_type), code, scope, src, ctr, fm)
      }
    }
    UnknownExpr(tag) -> pipeline_cg_expr_typed_raw(expr, code, scope, src, ctr, fm)
  }
}

fn pipeline_cg_expr_list_needs_preserved_f64_fp_typed(args: ExprList, scope: i64, src: i64, fm: i64) -> i64 {
  match args {
    ExprListNil -> 0
    ExprListCons(expr, rest) -> {
      if pipeline_cg_expr_needs_preserved_f64_fp_typed(expr, scope, src, fm) == 1 {
        1
      } else {
        pipeline_cg_expr_list_needs_preserved_f64_fp_typed(rest, scope, src, fm)
      }
    }
  }
}

fn pipeline_cg_record_fields_need_preserved_f64_fp_typed(fields: RecordFieldList, scope: i64, src: i64, fm: i64) -> i64 {
  match fields {
    RecordFieldListNil -> 0
    RecordFieldListCons(field, rest) -> {
      let found = match field {
        RecordField(ns, nl, value) -> pipeline_cg_expr_needs_preserved_f64_fp_typed(value, scope, src, fm)
        UnknownRecordField(tag) -> 0
      }
      if found == 1 { 1 } else { pipeline_cg_record_fields_need_preserved_f64_fp_typed(rest, scope, src, fm) }
    }
  }
}

fn pipeline_cg_handler_clauses_need_preserved_f64_fp_typed(clauses: HandlerClauseList, scope: i64, src: i64, fm: i64) -> i64 {
  match clauses {
    HandlerClauseListNil -> 0
    HandlerClauseListCons(clause, rest) -> {
      let found = match clause {
        HandlerClause(name_info, params, body, continuation) -> {
          let body_scope = pipeline_ir_native_hclause_params_type_scope(params, 0, scope)
          pipeline_cg_expr_needs_preserved_f64_fp_typed(body, body_scope, src, fm)
        }
        UnknownHandlerClause(tag) -> 0
      }
      if found == 1 { 1 } else { pipeline_cg_handler_clauses_need_preserved_f64_fp_typed(rest, scope, src, fm) }
    }
  }
}

fn pipeline_cg_expr_needs_preserved_f64_fp_typed(expr: Expr, scope: i64, src: i64, fm: i64) -> i64 {
  match expr {
    BinOp(op, lhs, rhs) -> {
      if pipeline_cg_expr_needs_preserved_f64_fp_typed(lhs, scope, src, fm) == 1 {
        1
      } else {
        pipeline_cg_expr_needs_preserved_f64_fp_typed(rhs, scope, src, fm)
      }
    }
    Call(ns, nl, args) -> pipeline_cg_expr_list_needs_preserved_f64_fp_typed(args, scope, src, fm)
    GenericCall(type_args, inner_call) -> {
      match inner_call {
        Call(ns, nl, args) -> pipeline_cg_expr_list_needs_preserved_f64_fp_typed(args, scope, src, fm)
        _ -> cg_expr_needs_preserved_f64_fp(expr_to_node(expr), scope, src, fm)
      }
    }
    Not(operand) -> pipeline_cg_expr_needs_preserved_f64_fp_typed(operand, scope, src, fm)
    FieldAccess(base, field_ns, field_nl) -> pipeline_cg_expr_needs_preserved_f64_fp_typed(base, scope, src, fm)
    RecordInit(type_ns, type_nl, fields) -> pipeline_cg_record_fields_need_preserved_f64_fp_typed(fields, scope, src, fm)
    MethodCall(recv, method_hash, args, type_hash) -> {
      if pipeline_cg_expr_needs_preserved_f64_fp_typed(recv, scope, src, fm) == 1 {
        1
      } else {
        pipeline_cg_expr_list_needs_preserved_f64_fp_typed(args, scope, src, fm)
      }
    }
    InterpConcat(left, right) -> {
      if pipeline_cg_expr_needs_preserved_f64_fp_typed(left, scope, src, fm) == 1 {
        1
      } else {
        pipeline_cg_expr_needs_preserved_f64_fp_typed(right, scope, src, fm)
      }
    }
    OptChain(base, field_ns, field_nl) -> pipeline_cg_expr_needs_preserved_f64_fp_typed(base, scope, src, fm)
    Try(inner) -> pipeline_cg_expr_needs_preserved_f64_fp_typed(inner, scope, src, fm)
    Resume(value) -> pipeline_cg_expr_needs_preserved_f64_fp_typed(value, scope, src, fm)
    Perform(lhs, op_ns, op_nl, args) -> {
      if pipeline_cg_expr_needs_preserved_f64_fp_typed(lhs, scope, src, fm) == 1 {
        1
      } else {
        pipeline_cg_expr_list_needs_preserved_f64_fp_typed(args, scope, src, fm)
      }
    }
    Handle(body, clauses) -> {
      if pipeline_cg_expr_needs_preserved_f64_fp_typed(body, scope, src, fm) == 1 {
        1
      } else {
        pipeline_cg_handler_clauses_need_preserved_f64_fp_typed(clauses, scope, src, fm)
      }
    }
    While(cond, body) -> {
      if pipeline_cg_expr_needs_preserved_f64_fp_typed(cond, scope, src, fm) == 1 {
        1
      } else {
        pipeline_cg_expr_needs_preserved_f64_fp_typed(body, scope, src, fm)
      }
    }
    Loop(body) -> pipeline_cg_expr_needs_preserved_f64_fp_typed(body, scope, src, fm)
    Break(value) -> pipeline_cg_expr_needs_preserved_f64_fp_typed(value, scope, src, fm)
    Return(value) -> pipeline_cg_expr_needs_preserved_f64_fp_typed(value, scope, src, fm)
    BreakNoValue -> 0
    ReturnNoValue -> 0
    Continue -> 0
    Let(ns, nl, value, body) -> {
      if pipeline_cg_expr_needs_preserved_f64_fp_typed(value, scope, src, fm) == 1 {
        1
      } else {
        let binding_ty = pipeline_cg_expr_type_typed(value, scope, src, fm)
        let body_scope = scope_push_typed(scope, ns, nl, 0, binding_ty)
        pipeline_cg_expr_needs_preserved_f64_fp_typed(body, body_scope, src, fm)
      }
    }
    LetMut(ns, nl, value, body) -> {
      if pipeline_cg_expr_needs_preserved_f64_fp_typed(value, scope, src, fm) == 1 {
        1
      } else {
        pipeline_cg_expr_needs_preserved_f64_fp_typed(body, scope, src, fm)
      }
    }
    Assign(ns, nl, value) -> pipeline_cg_expr_needs_preserved_f64_fp_typed(value, scope, src, fm)
    Defer(cleanup, body) -> {
      if pipeline_cg_expr_needs_preserved_f64_fp_typed(cleanup, scope, src, fm) == 1 {
        1
      } else {
        pipeline_cg_expr_needs_preserved_f64_fp_typed(body, scope, src, fm)
      }
    }
    Block(first, rest) -> {
      if pipeline_cg_expr_needs_preserved_f64_fp_typed(first, scope, src, fm) == 1 {
        1
      } else {
        pipeline_cg_expr_needs_preserved_f64_fp_typed(rest, scope, src, fm)
      }
    }
    LetTyped(inner, ann_type) -> pipeline_cg_expr_needs_preserved_f64_fp_typed(inner, scope, src, fm)
    Lambda(params, body) -> {
      let body_scope = pipeline_ir_native_hclause_params_type_scope(params, 0, scope)
      pipeline_cg_expr_needs_preserved_f64_fp_typed(body, body_scope, src, fm)
    }
    ForIter(var_ns, var_nl, collection, body) -> {
      if pipeline_cg_expr_needs_preserved_f64_fp_typed(collection, scope, src, fm) == 1 {
        1
      } else {
        let item_ty = pipeline_cg_for_iter_item_type_typed(collection, scope, src, fm)
        let body_scope = scope_push_typed(scope, var_ns, var_nl, 0, item_ty)
        pipeline_cg_expr_needs_preserved_f64_fp_typed(body, body_scope, src, fm)
      }
    }
    _ -> cg_expr_needs_preserved_f64_fp(expr_to_node(expr), scope, src, fm)
  }
}

fn pipeline_cg_enter_function_fp_preserve_typed(fm: i64, body: Expr, scope: i64, src: i64) -> i64 {
  let old = fmap_current_preserve_fp(fm)
  let need = pipeline_cg_expr_needs_preserved_f64_fp_typed(body, scope, src, fm)
  fmap_set_current_preserve_fp(fm, need)
  if need == 1 { fmap_inc_fp_preserve_function_count(fm) } else { 0 }
  old
}

fn pipeline_ir_native_emit_hclause_body_cg(clause: HandlerClause, code: i64, scope: i64, src: i64, fm: i64) -> i64 {
  match clause {
    HandlerClause(name_info, params, cbody_expr, continuation) -> {
      let nparams = param_list_len(params)
      let lambda_scope = pipeline_ir_native_hclause_lambda_scope(params, continuation)
      let free_vars = nlist_new()
      pipeline_typed_find_free_vars_expr(cbody_expr, lambda_scope, scope, src, free_vars)
      let nfree = nlist_len(free_vars)
      let skip_pos = buf_len(code)
      bu32(code, 0)
      let clause_start = buf_len(code)
      let type_scope = pipeline_ir_native_hclause_params_type_scope(
        params,
        0,
        cg_free_vars_type_scope(free_vars, nfree, scope, src, scope_new())
      )
      let old_preserve_fp = pipeline_cg_enter_function_fp_preserve_typed(fm, cbody_expr, type_scope, src)
      emit_prologue_current(code, fm)
      pipeline_ir_native_emit_hclause_loads(code, nparams, free_vars, nfree)
      let base_scope = pipeline_ir_native_hclause_scope(params, nparams, free_vars, nfree, scope, src)
      let base_ctr = nparams + nfree + nparams
      let body_ctr = pipeline_ir_native_emit_hclause_continuation(code, fm, base_scope, scope, src, free_vars, base_ctr, continuation)
      let body_scope = pipeline_ir_native_hclause_scope_with_continuation(base_scope, continuation, base_ctr)
      let br = pipeline_cg_expr_typed(cbody_expr, code, body_scope, src, body_ctr, fm)
      pipeline_ir_native_drop_hclause_continuation(code, fm, body_scope, src, continuation)
      let rp = emit_load_reg(code, br - 1)
      bu32(code, encode_add_imm(0, rp, 0))
      emit_epilogue_current(code, fm)
      cg_restore_function_fp_preserve(fm, old_preserve_fp)
      cg_patch_b(code, skip_pos, buf_len(code))
      let info = alloc_bump(24)
      __mem_store64(info, clause_start)
      __mem_store64(info + 8, free_vars)
      __mem_store64(info + 16, nfree)
      info
    }
    UnknownHandlerClause(tag) -> 0
  }
}

fn pipeline_ir_native_emit_hclause_body(clause: HandlerClause, code: i64, scope: i64, src: i64, fm: i64, active_handlers: PipelineNativeHandlerCtx) -> i64 {
  let opt = pipeline_ir_native_emit_hclause_body_ir(clause, code, scope, src, fm, active_handlers)
  if opt != 0 {
    opt
  } else {
    pipeline_ir_native_emit_hclause_body_cg(clause, code, scope, src, fm)
  }
}

fn pipeline_ir_native_hfill_ops(clauses: HandlerClauseList, n: i64, infos: i64, code: i64, scope: i64, src: i64, ops_ctr: i64) -> i64 {
  for ci in 0..n {
    let clause = handler_clause_list_nth(clauses, ci)
    let op_hash = pipeline_handler_clause_op_hash_typed(src, clause)
    let info = __mem_load64(infos + ci * 8)
    let cs = __mem_load64(info)
    let fvs = __mem_load64(info + 8)
    let nfree = __mem_load64(info + 16)
    let ops_phys = emit_load_reg(code, ops_ctr)
    emit_mov_imm_safe(code, 17, op_hash)
    bu32(code, cg_str(17, ops_phys, ci * handler_ops_entry_size() + handler_ops_op_hash_offset()))
    let adr_pos = buf_len(code)
    bu32(code, encode_adr(17, cs - adr_pos))
    let ops_p2 = emit_load_reg(code, ops_ctr)
    bu32(code, cg_str(17, ops_p2, ci * handler_ops_entry_size() + handler_ops_fn_ptr_offset()))
    if nfree > 0 {
      cg_hclause_env(code, scope, src, ops_ctr, ci, fvs, nfree)
    } else {
      emit_mov_imm(code, 17, 0)
      let ops_p3 = emit_load_reg(code, ops_ctr)
      bu32(code, cg_str(17, ops_p3, ci * handler_ops_entry_size() + handler_ops_env_ptr_offset()))
    }
  }
  0
}

fn pipeline_ir_native_emit_handle(code: i64, scope: i64, src: i64, fm: i64, clauses: HandlerClauseList, nclauses: i64, ctx: PipelineNativeHandlerCtx) -> PipelineNativeHandlerCtx {
  if nclauses <= 0 { ctx }
  else {
    let eff_hash = pipeline_handler_clause_effect_hash_typed(src, handler_clause_list_nth(clauses, 0))
    let clause_infos = alloc_bump(nclauses * 8)
    for ci in 0..nclauses {
      let info = pipeline_ir_native_emit_hclause_body(handler_clause_list_nth(clauses, ci), code, scope, src, fm, ctx)
      __mem_store64(clause_infos + ci * 8, info)
    }
    let depth = pipeline_ir_native_handler_ctx_len(ctx)
    let ops_ctr = 200 + depth * 2
    let frame_ctr = ops_ctr + 1
    cg_bump_alloc_imm(code, 16, nclauses * handler_ops_entry_size())
    emit_store_reg(code, ops_ctr, 16)
    pipeline_ir_native_hfill_ops(clauses, nclauses, clause_infos, code, scope, src, ops_ctr)
    cg_hbuild_frame(code, eff_hash, nclauses, ops_ctr)
    emit_store_reg(code, frame_ctr, 27)
    PipelineNativeHandlerCtxCons(clauses, clause_infos, nclauses, ops_ctr, frame_ctr, ctx)
  }
}

fn pipeline_ir_native_emit_direct(code: i64, dst: i64, handler_depth: i64, clause_index: i64, args: IrValueList, ctx: PipelineNativeHandlerCtx) -> i64 {
  let found = pipeline_ir_native_handler_ctx_at(ctx, handler_depth)
  match found {
    PipelineNativeHandlerCtxNil -> 0
    PipelineNativeHandlerCtxCons(clauses, infos, nclauses, ops_ctr, frame_ctr, rest) -> {
      let info = __mem_load64(infos + clause_index * 8)
      let clause_start = __mem_load64(info)
      pipeline_ir_native_move_args(code, args, 0)
      let nfree = __mem_load64(info + 16)
      if nfree == 0 {
        emit_mov_imm(code, 0, 0)
      } else {
        let ops_phys = emit_load_reg(code, ops_ctr)
        bu32(code, cg_ldr(0, ops_phys, clause_index * handler_ops_entry_size() + handler_ops_env_ptr_offset()))
      }
      let cur = buf_len(code)
      bu32(code, encode_bl(clause_start - cur))
      pipeline_ir_native_store_reg(code, dst, 0)
    }
  }
}

fn pipeline_ir_native_emit_perform(code: i64, dst: i64, effect_hash: i64, op_hash: i64, args: IrValueList, fm: i64) -> i64 {
  cg_perform_lookup(code, fm, effect_hash, op_hash)
  bu32(code, cg_ldr(9, 13, handler_ops_fn_ptr_offset()))
  bu32(code, cg_ldr(0, 13, handler_ops_env_ptr_offset()))
  pipeline_ir_native_move_args(code, args, 0)
  bu32(code, encode_blr(9))
  pipeline_ir_native_store_reg(code, dst, 0)
}

fn pipeline_ir_native_pop_one(code: i64, ctx: PipelineNativeHandlerCtx) -> PipelineNativeHandlerCtx {
  match ctx {
    PipelineNativeHandlerCtxNil -> PipelineNativeHandlerCtxNil
    PipelineNativeHandlerCtxCons(clauses, infos, nclauses, ops_ctr, frame_ctr, rest) -> {
      let fp = emit_load_reg(code, frame_ctr)
      bu32(code, cg_ldr(27, fp, handler_frame_prev_offset()))
      rest
    }
  }
}

fn pipeline_ir_native_emit_ctx_scope(ctx: PipelineNativeEmitCtx) -> i64 {
  match ctx {
    PipelineNativeEmitCtx(scope, handlers) -> scope
  }
}

fn pipeline_ir_native_emit_ctx_handlers(ctx: PipelineNativeEmitCtx) -> PipelineNativeHandlerCtx {
  match ctx {
    PipelineNativeEmitCtx(scope, handlers) -> handlers
  }
}

fn pipeline_ir_native_emit_inst(inst: IrInst, code: i64, src: i64, fm: i64, ctx: PipelineNativeEmitCtx) -> PipelineNativeEmitCtx {
  let scope = pipeline_ir_native_emit_ctx_scope(ctx)
  let handlers = pipeline_ir_native_emit_ctx_handlers(ctx)
  match inst {
    IrConstI64(dst, value) -> { pipeline_ir_native_emit_const(code, dst, value) ctx }
    IrBinaryI64(dst, op, lhs, rhs) -> { pipeline_ir_native_emit_binary(code, dst, op, lhs, rhs) ctx }
    IrBindI64(ns, nl, value) -> PipelineNativeEmitCtx(scope_push(scope, ns, nl, reg_id(value)), handlers)
    IrHandleI64(dst, body, clauses, nclauses) -> {
      let next_handlers = pipeline_ir_native_emit_handle(code, scope, src, fm, clauses, nclauses, handlers)
      PipelineNativeEmitCtx(scope, next_handlers)
    }
    IrHandlerPopI64(frame) -> PipelineNativeEmitCtx(scope, pipeline_ir_native_pop_one(code, handlers))
    IrHandlerDirectI64(dst, effect_hash, op_hash, handler_depth, clause_index, args) -> {
      pipeline_ir_native_emit_direct(code, dst, handler_depth, clause_index, args, handlers)
      ctx
    }
    IrPerformI64(dst, effect_hash, op_hash, args) -> {
      pipeline_ir_native_emit_perform(code, dst, effect_hash, op_hash, args, fm)
      ctx
    }
    _ -> ctx
  }
}

fn pipeline_ir_native_emit_inst_list(insts: IrInstList, code: i64, src: i64, fm: i64, ctx: PipelineNativeEmitCtx) -> PipelineNativeEmitCtx {
  match insts {
    IrInstNil -> ctx
    IrInstCons(inst, rest) -> {
      let next_ctx = pipeline_ir_native_emit_inst(inst, code, src, fm, ctx)
      pipeline_ir_native_emit_inst_list(rest, code, src, fm, next_ctx)
    }
  }
}

fn pipeline_ir_native_pop_handlers(code: i64, ctx: PipelineNativeHandlerCtx) -> i64 {
  match ctx {
    PipelineNativeHandlerCtxNil -> 0
    PipelineNativeHandlerCtxCons(clauses, infos, nclauses, ops_ctr, frame_ctr, rest) -> {
      let fp = emit_load_reg(code, frame_ctr)
      bu32(code, cg_ldr(27, fp, handler_frame_prev_offset()))
      pipeline_ir_native_pop_handlers(code, rest)
    }
  }
}

fn pipeline_ir_native_emit_term(term: IrTerminator, code: i64) -> i64 {
  match term {
    IrTermReturn(value) -> {
      let result_phys = emit_load_reg(code, value)
      bu32(code, encode_add_imm(0, result_phys, 0))
    }
    _ -> emit_mov_imm(code, 0, 0)
  }
}

fn pipeline_ir_native_emit_block(block: IrBlock, code: i64, scope: i64, src: i64, fm: i64) -> i64 {
  match block {
    IrBlock(id, params, insts, term) -> {
      let ctx = pipeline_ir_native_emit_inst_list(insts, code, src, fm, PipelineNativeEmitCtx(scope, PipelineNativeHandlerCtxNil))
      pipeline_ir_native_pop_handlers(code, pipeline_ir_native_emit_ctx_handlers(ctx))
      pipeline_ir_native_emit_term(term, code)
    }
  }
}

fn pipeline_cg_fn_from_ir(fn_wrap: i64, irf: IrFunction, code: i64, fm: i64, src: i64, owner_hash: i64) -> i64 {
  let fn_node = unwrap_fn(fn_wrap)
  let ns = node_f1(fn_node)
  let nl = node_f2(fn_node)
  let params = node_f3(fn_node)
  let old_ret_ty = fmap_get_current_ret_ty(fm)
  let ret_ty = fn_ret_type(fn_wrap)
  fmap_set_current_ret_ty(fm, ret_ty)
  cg_cleanup_restore(fm, 0)
  let fn_off = buf_len(code)
  fmap_update_offset_qualified(fm, src, ns, nl, owner_hash, fn_off)
  emit_prologue(code)
  let nparams = nlist_len(params)
  let scope = cg_fn_params(params, nparams, src, scope_new(), code, fm)
  match irf {
    IrFunction(hash, param_count, blocks) -> {
      match blocks {
        IrBlockListCons(block, rest) -> pipeline_ir_native_emit_block(block, code, scope, src, fm)
        IrBlockListNil -> emit_mov_imm(code, 0, 0)
      }
    }
  }
  emit_epilogue(code)
  fmap_set_current_ret_ty(fm, old_ret_ty)
  0
}

fn pipeline_cg_module_with_ir(fns: i64, ir_functions: IrFunctionList, code: i64, fm: i64) -> i64 {
  let n = nlist_len(fns)
  let mm = __mem_load64(fm + 72)
  let tm = __mem_load64(fm + 80)
  let btm = fmap_borrow_tmap(fm)
  for i in 0..n {
    let pair = nlist_get(fns, i)
    let fn_wrap = node_f1(pair)
    let fn_node = unwrap_fn(fn_wrap)
    let fn_src = node_f2(pair)
    let type_hash = node_f3(pair)
    fmap_add_qualified(fm, fn_src, node_f1(fn_node), node_f2(fn_node), type_hash, 0)
    if type_hash == 0 {
      cg_ftypes_add(fmap_get_cg_ftypes(fm), fn_src, node_f1(fn_node), node_f2(fn_node), fn_ret_type(fn_wrap), node_f3(fn_node), fn_effects(fn_wrap))
    } else { 0 }
    if type_hash != 0 {
      let method_hash = str_hash(fn_src, node_f1(fn_node), node_f2(fn_node))
      mmap_add(mm, type_hash, method_hash, 0, node_f3(fn_node))
    } else { 0 }
    let tparams = fn_tparams(fn_wrap)
    if tparams != 0 {
      let name_hash = str_hash(fn_src, node_f1(fn_node), node_f2(fn_node))
      mono_tmap_add(tm, name_hash, fn_wrap, fn_src)
    } else {
      if type_hash == 0 {
        let name_hash = str_hash(fn_src, node_f1(fn_node), node_f2(fn_node))
        borrow_tmap_add(btm, name_hash, fn_wrap, fn_src, type_hash)
        if cg_fn_borrowable_param_mask(fn_wrap, fn_src) != 0 { fmap_inc_rc_borrowable_param_fact_count(fm) } else { 0 }
      } else { 0 }
    }
  }
  let mut emitted = 0
  for j in 0..n {
    let pair = nlist_get(fns, j)
    let fn_wrap = node_f1(pair)
    let fn_node = unwrap_fn(fn_wrap)
    let fn_src = node_f2(pair)
    let type_hash = node_f3(pair)
    let name_hash = str_hash(fn_src, node_f1(fn_node), node_f2(fn_node))
    let found = pipeline_ir_function_list_find_hash(ir_functions, name_hash)
    let mut used_ir = 0
    match found {
      IrFunctionNil -> 0
      IrFunctionCons(irf, rest) -> {
        if pipeline_ir_native_function_supported(fn_wrap, irf, fn_src) == 1 {
          pipeline_cg_fn_from_ir(fn_wrap, irf, code, fm, fn_src, type_hash)
          emitted = emitted + 1
          used_ir = 1
        } else { 0 }
      }
    }
    if used_ir == 0 {
      cg_fn(fn_wrap, code, fm, fn_src, type_hash)
    } else { 0 }
    if type_hash != 0 {
      let method_hash = str_hash(fn_src, node_f1(fn_node), node_f2(fn_node))
      let off = fmap_lookup_qualified(fm, fn_src, node_f1(fn_node), node_f2(fn_node), type_hash)
      mmap_update(mm, type_hash, method_hash, off)
    } else { 0 }
  }
  __mem_store64(fm + 176, emitted)
  code
}

fn pipeline_lower_native_module(typed: TypedModule, ir: IrModule) -> NativeModule {
  match typed {
    TypedModule(fns, src, tt) -> {
      let functions = pipeline_ir_functions(ir)
      let code = buf_new(1048576)
      let fm = fmap_new()
      emit_heap_init(code)
      let bl_main_pos = buf_len(code)
      bu32(code, 0)
      bu32(code, encode_ldp_post(29, 30, 31, 16))
      bu32(code, encode_ret())
      fmap_set_tt(fm, tt)
      fmap_set_rc_elision_enabled(fm, cg_rc_elision_enabled_for_fns(fns, src))
      if pipeline_ir_is_optimised(ir) == 1 {
        pipeline_cg_module_with_ir(fns, functions, code, fm)
      } else {
        cg_module(fns, code, fm)
      }
      patch_forward_refs(fm, code)
      let main_off = find_main_in_fmap(fm)
      bytes_set_u32(code, bl_main_pos, encode_bl(main_off - bl_main_pos))
      NativeModule(code, fm, functions)
    }
  }
}

fn pipeline_lower_native_ir(typed: TypedModule) -> NativeModule {
  let ir = pipeline_lower_ir(typed)
  pipeline_lower_native_module(typed, ir)
}

fn pipeline_empty_binary_for_format(format: BinaryFormat) -> BinaryObject {
  BinaryObject(buf_new(0), binary_format_kind(format))
}

fn pipeline_emit_native_macho_object(format: BinaryFormat, code: i64, fm: i64, src: i64) -> BinaryObject {
  let ngot = __mem_load64(fm + 128)
  let o = compile_object(code, fm, src, ngot)
  BinaryObject(o, binary_format_kind(format))
}

fn pipeline_emit_native_macho_executable(format: BinaryFormat, code: i64) -> BinaryObject {
  let o = emit_macho(code, 0)
  BinaryObject(o, binary_format_kind(format))
}

fn pipeline_emit_native_binary_as(format: BinaryFormat, native: NativeModule, src: i64) -> BinaryObject {
  match native {
    NativeModule(code, fm, functions) -> {
      let backend = binary_format_backend(format)
      match backend {
        BinaryFormatBackendMachOObject -> pipeline_emit_native_macho_object(format, code, fm, src)
        BinaryFormatBackendMachOExecutable -> pipeline_emit_native_macho_executable(format, code)
        BinaryFormatBackendUnsupported -> pipeline_empty_binary_for_format(format)
      }
    }
  }
}

fn pipeline_emit_native_binary(native: NativeModule, src: i64) -> BinaryObject {
  pipeline_emit_native_binary_as(pipeline_native_binary_format(native), native, src)
}

fn pipeline_ir_const_env_empty() -> PipelineIrConstEnv {
  PipelineIrConstEnvNil
}

fn pipeline_ir_const_env_bind(env: PipelineIrConstEnv, value_id: i64, const_value: i64) -> PipelineIrConstEnv {
  PipelineIrConstEnvCons(value_id, 1, const_value, env)
}

fn pipeline_ir_const_lookup(valid: i64, value: i64) -> PipelineIrConstLookup {
  PipelineIrConstLookup(valid, value)
}

fn pipeline_ir_const_lookup_valid(found: PipelineIrConstLookup) -> i64 {
  match found {
    PipelineIrConstLookup(valid, value) -> valid
  }
}

fn pipeline_ir_const_lookup_value(found: PipelineIrConstLookup) -> i64 {
  match found {
    PipelineIrConstLookup(valid, value) -> value
  }
}

fn pipeline_ir_const_env_lookup(env: PipelineIrConstEnv, value_id: i64) -> PipelineIrConstLookup {
  match env {
    PipelineIrConstEnvNil -> pipeline_ir_const_lookup(0, 0)
    PipelineIrConstEnvCons(id, known, value, rest) -> {
      if id == value_id { pipeline_ir_const_lookup(known, value) }
      else { pipeline_ir_const_env_lookup(rest, value_id) }
    }
  }
}

fn pipeline_ir_alias_env_empty() -> PipelineIrAliasEnv {
  PipelineIrAliasEnvNil
}

fn pipeline_ir_alias_env_bind(env: PipelineIrAliasEnv, value_id: i64, source_id: i64) -> PipelineIrAliasEnv {
  if value_id == source_id { env }
  else { PipelineIrAliasEnvCons(value_id, source_id, env) }
}

fn pipeline_ir_alias_env_lookup_or(env: PipelineIrAliasEnv, value_id: i64) -> i64 {
  match env {
    PipelineIrAliasEnvNil -> value_id
    PipelineIrAliasEnvCons(id, source, rest) -> {
      if id == value_id { pipeline_ir_alias_env_lookup_or(rest, source) }
      else { pipeline_ir_alias_env_lookup_or(rest, value_id) }
    }
  }
}

fn pipeline_ir_const_env_lookup_alias(env: PipelineIrConstEnv, aliases: PipelineIrAliasEnv, value_id: i64) -> PipelineIrConstLookup {
  pipeline_ir_const_env_lookup(env, pipeline_ir_alias_env_lookup_or(aliases, value_id))
}

fn pipeline_ir_call_cse_env_empty() -> PipelineIrCallCseEnv {
  PipelineIrCallCseEnvNil
}

fn pipeline_ir_call_cse_env_bind(env: PipelineIrCallCseEnv, callee_hash: i64, args: IrValueList, result: i64) -> PipelineIrCallCseEnv {
  PipelineIrCallCseEnvCons(callee_hash, args, result, env)
}

fn pipeline_ir_value_list_equal(left: IrValueList, right: IrValueList) -> i64 {
  match left {
    IrValueNil -> {
      match right {
        IrValueNil -> 1
        IrValueCons(value, rest) -> 0
      }
    }
    IrValueCons(left_value, left_rest) -> {
      match right {
        IrValueNil -> 0
        IrValueCons(right_value, right_rest) -> {
          if left_value == right_value { pipeline_ir_value_list_equal(left_rest, right_rest) }
          else { 0 }
        }
      }
    }
  }
}

fn pipeline_ir_call_cse_env_lookup(env: PipelineIrCallCseEnv, callee_hash: i64, args: IrValueList) -> PipelineIrConstLookup {
  match env {
    PipelineIrCallCseEnvNil -> pipeline_ir_const_lookup(0, 0)
    PipelineIrCallCseEnvCons(entry_hash, entry_args, result, rest) -> {
      if entry_hash == callee_hash and pipeline_ir_value_list_equal(entry_args, args) == 1 {
        pipeline_ir_const_lookup(1, result)
      } else {
        pipeline_ir_call_cse_env_lookup(rest, callee_hash, args)
      }
    }
  }
}

fn pipeline_ir_value_list_get_or(values: IrValueList, index: i64, default: i64) -> i64 {
  match values {
    IrValueNil -> default
    IrValueCons(value, rest) -> {
      if index == 0 { value }
      else { pipeline_ir_value_list_get_or(rest, index - 1, default) }
    }
  }
}

fn pipeline_ir_rewrite_value_list(values: IrValueList, aliases: PipelineIrAliasEnv) -> IrValueList {
  match values {
    IrValueNil -> IrValueNil
    IrValueCons(value, rest) -> {
      ir_value_list_prepend(pipeline_ir_alias_env_lookup_or(aliases, value), pipeline_ir_rewrite_value_list(rest, aliases))
    }
  }
}

fn pipeline_ir_rewrite_record_fields(fields: IrRecordFieldList, aliases: PipelineIrAliasEnv) -> IrRecordFieldList {
  match fields {
    IrRecordFieldNil -> IrRecordFieldNil
    IrRecordFieldCons(field_hash, value, rest) -> {
      IrRecordFieldCons(field_hash, pipeline_ir_alias_env_lookup_or(aliases, value), pipeline_ir_rewrite_record_fields(rest, aliases))
    }
  }
}

fn pipeline_ir_rewrite_inst_uses(inst: IrInst, aliases: PipelineIrAliasEnv) -> IrInst {
  match inst {
    IrConstI64(dst, value) -> inst
    IrStringLit(dst, start, len) -> inst
    IrStringConcatI64(dst, left, right) -> IrStringConcatI64(dst, pipeline_ir_alias_env_lookup_or(aliases, left), pipeline_ir_alias_env_lookup_or(aliases, right))
    IrBinaryI64(dst, op, lhs, rhs) -> IrBinaryI64(dst, op, pipeline_ir_alias_env_lookup_or(aliases, lhs), pipeline_ir_alias_env_lookup_or(aliases, rhs))
    IrUnaryI64(dst, op, value) -> IrUnaryI64(dst, op, pipeline_ir_alias_env_lookup_or(aliases, value))
    IrLambdaI64(dst, params, body, nparams) -> inst
    IrPerformI64(dst, effect_hash, op_hash, args) -> IrPerformI64(dst, effect_hash, op_hash, pipeline_ir_rewrite_value_list(args, aliases))
    IrHandlerDirectI64(dst, effect_hash, op_hash, handler_depth, clause_index, args) -> IrHandlerDirectI64(dst, effect_hash, op_hash, handler_depth, clause_index, pipeline_ir_rewrite_value_list(args, aliases))
    IrHandlerPopI64(frame) -> IrHandlerPopI64(pipeline_ir_alias_env_lookup_or(aliases, frame))
    IrBindI64(ns, nl, value) -> IrBindI64(ns, nl, pipeline_ir_alias_env_lookup_or(aliases, value))
    IrHandleI64(dst, body, clauses, nclauses) -> inst
    IrResumeI64(dst, value) -> IrResumeI64(dst, pipeline_ir_alias_env_lookup_or(aliases, value))
    IrTryI64(dst, value) -> IrTryI64(dst, pipeline_ir_alias_env_lookup_or(aliases, value))
    IrOptChainI64(dst, base, field_hash, field_index) -> IrOptChainI64(dst, pipeline_ir_alias_env_lookup_or(aliases, base), field_hash, field_index)
    IrCallI64(dst, callee_hash, args) -> IrCallI64(dst, callee_hash, pipeline_ir_rewrite_value_list(args, aliases))
    IrIndirectCallI64(dst, callee, args) -> IrIndirectCallI64(dst, pipeline_ir_alias_env_lookup_or(aliases, callee), pipeline_ir_rewrite_value_list(args, aliases))
    IrGenericCallI64(dst, callee_hash, type_args, args) -> IrGenericCallI64(dst, callee_hash, type_args, pipeline_ir_rewrite_value_list(args, aliases))
    IrMethodCallI64(dst, type_hash, method_hash, receiver, args) -> IrMethodCallI64(dst, type_hash, method_hash, pipeline_ir_alias_env_lookup_or(aliases, receiver), pipeline_ir_rewrite_value_list(args, aliases))
    IrVariantInitI64(dst, tag_hash, payloads) -> IrVariantInitI64(dst, tag_hash, pipeline_ir_rewrite_value_list(payloads, aliases))
    IrVariantTagI64(dst, base) -> IrVariantTagI64(dst, pipeline_ir_alias_env_lookup_or(aliases, base))
    IrVariantPayloadI64(dst, base, index) -> IrVariantPayloadI64(dst, pipeline_ir_alias_env_lookup_or(aliases, base), index)
    IrRecordInitI64(dst, type_hash, fields) -> IrRecordInitI64(dst, type_hash, pipeline_ir_rewrite_record_fields(fields, aliases))
    IrFieldLoadI64(dst, base, field_hash, field_index) -> IrFieldLoadI64(dst, pipeline_ir_alias_env_lookup_or(aliases, base), field_hash, field_index)
    IrSlotI64(slot) -> inst
    IrLoadI64(dst, slot) -> IrLoadI64(dst, pipeline_ir_alias_env_lookup_or(aliases, slot))
    IrStoreI64(slot, value) -> IrStoreI64(pipeline_ir_alias_env_lookup_or(aliases, slot), pipeline_ir_alias_env_lookup_or(aliases, value))
  }
}

fn pipeline_ir_rewrite_term(term: IrTerminator, aliases: PipelineIrAliasEnv) -> IrTerminator {
  match term {
    IrTermNone -> IrTermNone
    IrTermReturn(value) -> IrTermReturn(pipeline_ir_alias_env_lookup_or(aliases, value))
    IrTermJump(target, args) -> IrTermJump(target, pipeline_ir_rewrite_value_list(args, aliases))
    IrTermBranch(cond, then_block, else_block) -> IrTermBranch(pipeline_ir_alias_env_lookup_or(aliases, cond), then_block, else_block)
  }
}

fn pipeline_ir_max_i64(a: i64, b: i64) -> i64 {
  if a > b { a } else { b }
}

fn pipeline_ir_max_value_list(values: IrValueList, current: i64) -> i64 {
  match values {
    IrValueNil -> current
    IrValueCons(value, rest) -> pipeline_ir_max_value_list(rest, pipeline_ir_max_i64(current, value))
  }
}

fn pipeline_ir_max_record_fields(fields: IrRecordFieldList, current: i64) -> i64 {
  match fields {
    IrRecordFieldNil -> current
    IrRecordFieldCons(field_hash, value, rest) -> pipeline_ir_max_record_fields(rest, pipeline_ir_max_i64(current, value))
  }
}

fn pipeline_ir_max_inst_value(inst: IrInst, current: i64) -> i64 {
  match inst {
    IrConstI64(dst, value) -> pipeline_ir_max_i64(current, dst)
    IrStringLit(dst, start, len) -> pipeline_ir_max_i64(current, dst)
    IrStringConcatI64(dst, left, right) -> pipeline_ir_max_i64(pipeline_ir_max_i64(pipeline_ir_max_i64(current, dst), left), right)
    IrBinaryI64(dst, op, lhs, rhs) -> pipeline_ir_max_i64(pipeline_ir_max_i64(pipeline_ir_max_i64(current, dst), lhs), rhs)
    IrUnaryI64(dst, op, value) -> pipeline_ir_max_i64(pipeline_ir_max_i64(current, dst), value)
    IrLambdaI64(dst, params, body, nparams) -> pipeline_ir_max_i64(current, dst)
    IrPerformI64(dst, effect_hash, op_hash, args) -> pipeline_ir_max_value_list(args, pipeline_ir_max_i64(current, dst))
    IrHandlerDirectI64(dst, effect_hash, op_hash, handler_depth, clause_index, args) -> pipeline_ir_max_value_list(args, pipeline_ir_max_i64(current, dst))
    IrHandlerPopI64(frame) -> pipeline_ir_max_i64(current, frame)
    IrBindI64(ns, nl, value) -> pipeline_ir_max_i64(current, value)
    IrHandleI64(dst, body, clauses, nclauses) -> pipeline_ir_max_i64(current, dst)
    IrResumeI64(dst, value) -> pipeline_ir_max_i64(pipeline_ir_max_i64(current, dst), value)
    IrTryI64(dst, value) -> pipeline_ir_max_i64(pipeline_ir_max_i64(current, dst), value)
    IrOptChainI64(dst, base, field_hash, field_index) -> pipeline_ir_max_i64(pipeline_ir_max_i64(current, dst), base)
    IrCallI64(dst, callee_hash, args) -> pipeline_ir_max_value_list(args, pipeline_ir_max_i64(current, dst))
    IrIndirectCallI64(dst, callee, args) -> pipeline_ir_max_value_list(args, pipeline_ir_max_i64(pipeline_ir_max_i64(current, dst), callee))
    IrGenericCallI64(dst, callee_hash, type_args, args) -> pipeline_ir_max_value_list(args, pipeline_ir_max_i64(current, dst))
    IrMethodCallI64(dst, type_hash, method_hash, receiver, args) -> pipeline_ir_max_value_list(args, pipeline_ir_max_i64(pipeline_ir_max_i64(current, dst), receiver))
    IrVariantInitI64(dst, tag_hash, payloads) -> pipeline_ir_max_value_list(payloads, pipeline_ir_max_i64(current, dst))
    IrVariantTagI64(dst, base) -> pipeline_ir_max_i64(pipeline_ir_max_i64(current, dst), base)
    IrVariantPayloadI64(dst, base, index) -> pipeline_ir_max_i64(pipeline_ir_max_i64(current, dst), base)
    IrRecordInitI64(dst, type_hash, fields) -> pipeline_ir_max_record_fields(fields, pipeline_ir_max_i64(current, dst))
    IrFieldLoadI64(dst, base, field_hash, field_index) -> pipeline_ir_max_i64(pipeline_ir_max_i64(current, dst), base)
    IrSlotI64(slot) -> pipeline_ir_max_i64(current, slot)
    IrLoadI64(dst, slot) -> pipeline_ir_max_i64(pipeline_ir_max_i64(current, dst), slot)
    IrStoreI64(slot, value) -> pipeline_ir_max_i64(pipeline_ir_max_i64(current, slot), value)
  }
}

fn pipeline_ir_max_inst_list_value(insts: IrInstList, current: i64) -> i64 {
  match insts {
    IrInstNil -> current
    IrInstCons(inst, rest) -> pipeline_ir_max_inst_list_value(rest, pipeline_ir_max_inst_value(inst, current))
  }
}

fn pipeline_ir_max_term_value(term: IrTerminator, current: i64) -> i64 {
  match term {
    IrTermNone -> current
    IrTermReturn(value) -> pipeline_ir_max_i64(current, value)
    IrTermJump(target, args) -> pipeline_ir_max_value_list(args, current)
    IrTermBranch(cond, then_block, else_block) -> pipeline_ir_max_i64(current, cond)
  }
}

fn pipeline_ir_max_block_value(block: IrBlock, current: i64) -> i64 {
  match block {
    IrBlock(id, params, insts, term) -> {
      let with_params = pipeline_ir_max_value_list(params, current)
      let with_insts = pipeline_ir_max_inst_list_value(insts, with_params)
      pipeline_ir_max_term_value(term, with_insts)
    }
  }
}

fn pipeline_ir_max_block_list_value(blocks: IrBlockList, current: i64) -> i64 {
  match blocks {
    IrBlockListNil -> current
    IrBlockListCons(block, rest) -> pipeline_ir_max_block_list_value(rest, pipeline_ir_max_block_value(block, current))
  }
}

fn pipeline_ir_function_next_value(param_count: i64, blocks: IrBlockList) -> i64 {
  pipeline_ir_max_block_list_value(blocks, param_count - 1) + 1
}

fn pipeline_ir_const_eval(op: IrBinaryOp, lhs: i64, rhs: i64) -> PipelineIrConstLookup {
  match op {
    IrAdd -> pipeline_ir_const_lookup(1, lhs + rhs)
    IrSub -> pipeline_ir_const_lookup(1, lhs - rhs)
    IrMul -> pipeline_ir_const_lookup(1, lhs * rhs)
    IrDiv -> if rhs == 0 { pipeline_ir_const_lookup(0, 0) } else { pipeline_ir_const_lookup(1, lhs / rhs) }
    IrEq -> pipeline_ir_const_lookup(1, if lhs == rhs { 1 } else { 0 })
    IrNe -> pipeline_ir_const_lookup(1, if lhs != rhs { 1 } else { 0 })
    IrLt -> pipeline_ir_const_lookup(1, if lhs < rhs { 1 } else { 0 })
    IrGt -> pipeline_ir_const_lookup(1, if lhs > rhs { 1 } else { 0 })
    IrLe -> pipeline_ir_const_lookup(1, if lhs <= rhs { 1 } else { 0 })
    IrGe -> pipeline_ir_const_lookup(1, if lhs >= rhs { 1 } else { 0 })
    IrMod -> if rhs == 0 { pipeline_ir_const_lookup(0, 0) } else { pipeline_ir_const_lookup(1, lhs % rhs) }
    IrAnd -> pipeline_ir_const_lookup(1, lhs band rhs)
    IrOr -> pipeline_ir_const_lookup(1, lhs bor rhs)
    IrBand -> pipeline_ir_const_lookup(1, lhs band rhs)
    IrBor -> pipeline_ir_const_lookup(1, lhs bor rhs)
    IrBxor -> pipeline_ir_const_lookup(1, lhs bxor rhs)
    IrBshl -> if rhs >= 0 and rhs < 64 { pipeline_ir_const_lookup(1, lhs bshl rhs) } else { pipeline_ir_const_lookup(0, 0) }
    IrBshr -> if rhs >= 0 and rhs < 64 { pipeline_ir_const_lookup(1, lhs bshr rhs) } else { pipeline_ir_const_lookup(0, 0) }
    _ -> pipeline_ir_const_lookup(0, 0)
  }
}

fn pipeline_ir_const_lookup_is(found: PipelineIrConstLookup, expected: i64) -> i64 {
  if pipeline_ir_const_lookup_valid(found) == 1 {
    if pipeline_ir_const_lookup_value(found) == expected { 1 } else { 0 }
  } else { 0 }
}

fn pipeline_ir_rewrite_unchanged() -> PipelineIrRewrite {
  PipelineIrRewriteUnchanged
}

fn pipeline_ir_rewrite_const(value: i64) -> PipelineIrRewrite {
  PipelineIrRewriteConst(value)
}

fn pipeline_ir_rewrite_copy(value: i64) -> PipelineIrRewrite {
  PipelineIrRewriteCopy(value)
}

fn pipeline_ir_rewrite_insts(insts: IrInstList, next_value: i64) -> PipelineIrRewrite {
  PipelineIrRewriteInsts(insts, next_value)
}

fn pipeline_ir_power_of_two_shift(value: i64) -> PipelineIrConstLookup {
  if value <= 1 {
    pipeline_ir_const_lookup(0, 0)
  } else {
    let mut n = value
    let mut shift = 0
    let mut ok = 1
    while n > 1 and ok == 1 {
      if n % 2 == 0 {
        n = n / 2
        shift = shift + 1
      } else {
        ok = 0
      }
    }
    if ok == 1 and n == 1 { pipeline_ir_const_lookup(1, shift) }
    else { pipeline_ir_const_lookup(0, 0) }
  }
}

fn pipeline_ir_rewrite_mul_power_two(dst: i64, source: i64, multiplier: i64, next_value: i64) -> PipelineIrRewrite {
  let shift = pipeline_ir_power_of_two_shift(multiplier)
  if pipeline_ir_const_lookup_valid(shift) == 1 {
    let shift_value = pipeline_ir_const_lookup_value(shift)
    let shift_id = next_value
    let insts = ir_inst_list_prepend(
      ir_inst_const_i64(shift_id, shift_value),
      ir_inst_list_prepend(ir_inst_binary_i64(dst, IrBshl, source, shift_id), ir_inst_list_empty())
    )
    pipeline_ir_rewrite_insts(insts, next_value + 1)
  } else {
    pipeline_ir_rewrite_unchanged()
  }
}

fn pipeline_ir_algebraic_rewrite(dst: i64, op: IrBinaryOp, lhs: i64, rhs: i64, left: PipelineIrConstLookup, right: PipelineIrConstLookup, next_value: i64) -> PipelineIrRewrite {
  match op {
    IrAdd -> {
      if pipeline_ir_const_lookup_is(left, 0) == 1 { pipeline_ir_rewrite_copy(rhs) }
      else { if pipeline_ir_const_lookup_is(right, 0) == 1 { pipeline_ir_rewrite_copy(lhs) }
      else { pipeline_ir_rewrite_unchanged() } }
    }
    IrSub -> {
      if lhs == rhs { pipeline_ir_rewrite_const(0) }
      else { if pipeline_ir_const_lookup_is(right, 0) == 1 { pipeline_ir_rewrite_copy(lhs) }
      else { pipeline_ir_rewrite_unchanged() } }
    }
    IrMul -> {
      if pipeline_ir_const_lookup_is(left, 0) == 1 { pipeline_ir_rewrite_const(0) }
      else { if pipeline_ir_const_lookup_is(right, 0) == 1 { pipeline_ir_rewrite_const(0) }
      else { if pipeline_ir_const_lookup_is(left, 1) == 1 { pipeline_ir_rewrite_copy(rhs) }
      else { if pipeline_ir_const_lookup_is(right, 1) == 1 { pipeline_ir_rewrite_copy(lhs) }
      else { if pipeline_ir_const_lookup_valid(left) == 1 { pipeline_ir_rewrite_mul_power_two(dst, rhs, pipeline_ir_const_lookup_value(left), next_value) }
      else { if pipeline_ir_const_lookup_valid(right) == 1 { pipeline_ir_rewrite_mul_power_two(dst, lhs, pipeline_ir_const_lookup_value(right), next_value) }
      else { pipeline_ir_rewrite_unchanged() } } } } } }
    }
    IrDiv -> if pipeline_ir_const_lookup_is(right, 1) == 1 { pipeline_ir_rewrite_copy(lhs) } else { pipeline_ir_rewrite_unchanged() }
    IrEq -> if lhs == rhs { pipeline_ir_rewrite_const(1) } else { pipeline_ir_rewrite_unchanged() }
    IrNe -> if lhs == rhs { pipeline_ir_rewrite_const(0) } else { pipeline_ir_rewrite_unchanged() }
    IrLt -> if lhs == rhs { pipeline_ir_rewrite_const(0) } else { pipeline_ir_rewrite_unchanged() }
    IrGt -> if lhs == rhs { pipeline_ir_rewrite_const(0) } else { pipeline_ir_rewrite_unchanged() }
    IrLe -> if lhs == rhs { pipeline_ir_rewrite_const(1) } else { pipeline_ir_rewrite_unchanged() }
    IrGe -> if lhs == rhs { pipeline_ir_rewrite_const(1) } else { pipeline_ir_rewrite_unchanged() }
    IrMod -> if pipeline_ir_const_lookup_is(right, 1) == 1 { pipeline_ir_rewrite_const(0) } else { pipeline_ir_rewrite_unchanged() }
    IrAnd -> {
      if pipeline_ir_const_lookup_is(left, 0) == 1 { pipeline_ir_rewrite_const(0) }
      else { if pipeline_ir_const_lookup_is(right, 0) == 1 { pipeline_ir_rewrite_const(0) }
      else { if pipeline_ir_const_lookup_is(left, 1) == 1 { pipeline_ir_rewrite_copy(rhs) }
      else { if pipeline_ir_const_lookup_is(right, 1) == 1 { pipeline_ir_rewrite_copy(lhs) }
      else { pipeline_ir_rewrite_unchanged() } } } }
    }
    IrOr -> {
      if pipeline_ir_const_lookup_is(left, 0) == 1 { pipeline_ir_rewrite_copy(rhs) }
      else { if pipeline_ir_const_lookup_is(right, 0) == 1 { pipeline_ir_rewrite_copy(lhs) }
      else { pipeline_ir_rewrite_unchanged() } }
    }
    IrBand -> {
      if pipeline_ir_const_lookup_is(left, 0) == 1 { pipeline_ir_rewrite_const(0) }
      else { if pipeline_ir_const_lookup_is(right, 0) == 1 { pipeline_ir_rewrite_const(0) }
      else { if pipeline_ir_const_lookup_is(left, 0 - 1) == 1 { pipeline_ir_rewrite_copy(rhs) }
      else { if pipeline_ir_const_lookup_is(right, 0 - 1) == 1 { pipeline_ir_rewrite_copy(lhs) }
      else { if lhs == rhs { pipeline_ir_rewrite_copy(lhs) }
      else { pipeline_ir_rewrite_unchanged() } } } } }
    }
    IrBor -> {
      if pipeline_ir_const_lookup_is(left, 0) == 1 { pipeline_ir_rewrite_copy(rhs) }
      else { if pipeline_ir_const_lookup_is(right, 0) == 1 { pipeline_ir_rewrite_copy(lhs) }
      else { if lhs == rhs { pipeline_ir_rewrite_copy(lhs) }
      else { pipeline_ir_rewrite_unchanged() } } }
    }
    IrBxor -> {
      if lhs == rhs { pipeline_ir_rewrite_const(0) }
      else { if pipeline_ir_const_lookup_is(left, 0) == 1 { pipeline_ir_rewrite_copy(rhs) }
      else { if pipeline_ir_const_lookup_is(right, 0) == 1 { pipeline_ir_rewrite_copy(lhs) }
      else { pipeline_ir_rewrite_unchanged() } } }
    }
    IrBshl -> if pipeline_ir_const_lookup_is(right, 0) == 1 { pipeline_ir_rewrite_copy(lhs) } else { pipeline_ir_rewrite_unchanged() }
    IrBshr -> if pipeline_ir_const_lookup_is(right, 0) == 1 { pipeline_ir_rewrite_copy(lhs) } else { pipeline_ir_rewrite_unchanged() }
    _ -> pipeline_ir_rewrite_unchanged()
  }
}

fn pipeline_ir_semantic_facts_empty() -> PipelineIrSemanticFactList {
  PipelineIrSemanticFactNil
}

fn pipeline_ir_semantic_facts_prepend(hash: i64, fact: i64, rest: PipelineIrSemanticFactList) -> PipelineIrSemanticFactList {
  PipelineIrSemanticFactCons(hash, fact, rest)
}

fn pipeline_ir_semantic_fact_lookup_pure(facts: PipelineIrSemanticFactList, hash: i64) -> i64 {
  match facts {
    PipelineIrSemanticFactNil -> 0
    PipelineIrSemanticFactCons(fact_hash, fact, rest) -> {
      if fact_hash == hash { cg_semantic_fact_pure(fact) }
      else { pipeline_ir_semantic_fact_lookup_pure(rest, hash) }
    }
  }
}

fn pipeline_ir_semantic_fact_lookup_pure_scalar_result(facts: PipelineIrSemanticFactList, hash: i64) -> i64 {
  match facts {
    PipelineIrSemanticFactNil -> 0
    PipelineIrSemanticFactCons(fact_hash, fact, rest) -> {
      if fact_hash == hash {
        if cg_semantic_fact_pure(fact) == 1 and cg_semantic_fact_managed_return(fact) == 0 { 1 } else { 0 }
      } else {
        pipeline_ir_semantic_fact_lookup_pure_scalar_result(rest, hash)
      }
    }
  }
}

fn pipeline_ir_effect_flags_merge(a: i64, b: i64) -> i64 {
  let alloc = if cg_mask_has(a, 0) == 1 or cg_mask_has(b, 0) == 1 { 1 } else { 0 }
  let unsafe = if cg_mask_has(a, 1) == 1 or cg_mask_has(b, 1) == 1 { 1 } else { 0 }
  alloc + unsafe * 2
}

fn pipeline_ir_effect_flag_map_lookup(flags: i64, hash: i64) -> i64 {
  let mut cur = flags
  let mut result = 0
  while cur != 0 and result == 0 {
    if node_f1(cur) == hash {
      result = node_f2(cur)
    } else {
      cur = node_f3(cur)
    }
  }
  result
}

fn pipeline_ir_effect_flag_map_prepend(hash: i64, flags: i64, rest: i64) -> i64 {
  node_new(0, hash, flags, rest, 0)
}

fn pipeline_ir_raw_effect_expr_list_flags(list: i64, n: i64, src: i64, fn_flags: i64) -> i64 {
  let mut result = 0
  let mut i = 0
  while i < n {
    result = pipeline_ir_effect_flags_merge(result, pipeline_ir_raw_effect_expr_flags(nlist_get(list, i), src, fn_flags))
    i = i + 1
  }
  result
}

fn pipeline_ir_raw_effect_record_fields_flags(fields: i64, nfields: i64, src: i64, fn_flags: i64) -> i64 {
  let mut result = 0
  let mut i = 0
  while i < nfields {
    result = pipeline_ir_effect_flags_merge(result, pipeline_ir_raw_effect_expr_flags(node_f3(nlist_get(fields, i)), src, fn_flags))
    i = i + 1
  }
  result
}

fn pipeline_ir_raw_effect_match_arms_flags(arms: i64, narms: i64, src: i64, fn_flags: i64) -> i64 {
  let mut result = 0
  let mut i = 0
  while i < narms {
    let arm = nlist_get(arms, i)
    result = pipeline_ir_effect_flags_merge(result, pipeline_ir_raw_effect_expr_flags(node_f2(arm), src, fn_flags))
    if node_f3(arm) != 0 {
      result = pipeline_ir_effect_flags_merge(result, pipeline_ir_raw_effect_expr_flags(node_f3(arm), src, fn_flags))
    } else { 0 }
    i = i + 1
  }
  result
}

fn pipeline_ir_raw_effect_handler_clause_flags(clauses: i64, nclauses: i64, src: i64, fn_flags: i64) -> i64 {
  let mut result = 0
  let mut i = 0
  while i < nclauses {
    result = pipeline_ir_effect_flags_merge(result, pipeline_ir_raw_effect_expr_flags(node_f3(nlist_get(clauses, i)), src, fn_flags))
    i = i + 1
  }
  result
}

fn pipeline_ir_raw_effect_call_flags(node: i64, src: i64, fn_flags: i64) -> i64 {
  let ns = node_f1(node)
  let nl = node_f2(node)
  let direct_flags = intrinsic_semantic_effect_flags(src, ns, nl)
  let callee_flags = if direct_flags != 0 { 0 } else { pipeline_ir_effect_flag_map_lookup(fn_flags, str_hash(src, ns, nl)) }
  let arg_flags = pipeline_ir_raw_effect_expr_list_flags(node_f3(node), node_f4(node), src, fn_flags)
  pipeline_ir_effect_flags_merge(pipeline_ir_effect_flags_merge(direct_flags, callee_flags), arg_flags)
}

fn pipeline_ir_raw_effect_expr_flags(node: i64, src: i64, fn_flags: i64) -> i64 {
  if node == 0 { 0 }
  else {
    match node_tag(node) {
      1 -> 0
      2 -> 0
      3 -> pipeline_ir_effect_flags_merge(pipeline_ir_raw_effect_expr_flags(node_f2(node), src, fn_flags), pipeline_ir_raw_effect_expr_flags(node_f3(node), src, fn_flags))
      4 -> pipeline_ir_raw_effect_call_flags(node, src, fn_flags)
      5 -> pipeline_ir_effect_flags_merge(pipeline_ir_effect_flags_merge(pipeline_ir_raw_effect_expr_flags(node_f1(node), src, fn_flags), pipeline_ir_raw_effect_expr_flags(node_f2(node), src, fn_flags)), pipeline_ir_raw_effect_expr_flags(node_f3(node), src, fn_flags))
      6 -> pipeline_ir_effect_flags_merge(pipeline_ir_raw_effect_expr_flags(node_f3(node), src, fn_flags), pipeline_ir_raw_effect_expr_flags(node_f4(node), src, fn_flags))
      7 -> pipeline_ir_effect_flags_merge(pipeline_ir_raw_effect_expr_flags(node_f1(node), src, fn_flags), pipeline_ir_raw_effect_expr_flags(node_f2(node), src, fn_flags))
      9 -> 0
      10 -> pipeline_ir_effect_flags_merge(pipeline_ir_raw_effect_expr_flags(node_f1(node), src, fn_flags), pipeline_ir_raw_effect_expr_flags(node_f2(node), src, fn_flags))
      11 -> pipeline_ir_effect_flags_merge(pipeline_ir_raw_effect_expr_flags(node_f3(node), src, fn_flags), pipeline_ir_raw_effect_expr_flags(node_f4(node), src, fn_flags))
      12 -> pipeline_ir_raw_effect_expr_flags(node_f3(node), src, fn_flags)
      13 -> pipeline_ir_raw_effect_expr_flags(node_f1(node), src, fn_flags)
      14 -> pipeline_ir_raw_effect_record_fields_flags(node_f3(node), node_f4(node), src, fn_flags)
      15 -> pipeline_ir_effect_flags_merge(pipeline_ir_raw_effect_expr_flags(node_f1(node), src, fn_flags), pipeline_ir_raw_effect_match_arms_flags(node_f2(node), node_f3(node), src, fn_flags))
      22 -> pipeline_ir_raw_effect_expr_flags(node_f1(node), src, fn_flags)
      24 -> 0
      25 -> pipeline_ir_raw_effect_expr_flags(node_f1(node), src, fn_flags)
      26 -> pipeline_ir_raw_effect_expr_flags(node_f1(node), src, fn_flags)
      27 -> 0
      29 -> pipeline_ir_raw_effect_expr_flags(node_f2(node), src, fn_flags)
      32 -> pipeline_ir_effect_flags_merge(pipeline_ir_raw_effect_expr_flags(node_f1(node), src, fn_flags), pipeline_ir_raw_effect_expr_list_flags(node_f4(node), nlist_len(node_f4(node)), src, fn_flags))
      33 -> pipeline_ir_effect_flags_merge(pipeline_ir_raw_effect_expr_flags(node_f1(node), src, fn_flags), pipeline_ir_raw_effect_handler_clause_flags(node_f2(node), node_f3(node), src, fn_flags))
      35 -> pipeline_ir_raw_effect_expr_flags(node_f1(node), src, fn_flags)
      36 -> pipeline_ir_raw_effect_call_flags(node_f2(node), src, fn_flags)
      37 -> pipeline_ir_raw_effect_expr_flags(node_f1(node), src, fn_flags)
      41 -> pipeline_ir_effect_flags_merge(2, pipeline_ir_effect_flags_merge(pipeline_ir_raw_effect_expr_flags(node_f1(node), src, fn_flags), pipeline_ir_raw_effect_expr_list_flags(node_f3(node), nlist_len(node_f3(node)), src, fn_flags)))
      45 -> pipeline_ir_raw_effect_expr_flags(node_f1(node), src, fn_flags)
      46 -> pipeline_ir_effect_flags_merge(pipeline_ir_raw_effect_expr_flags(node_f1(node), src, fn_flags), pipeline_ir_raw_effect_expr_flags(node_f2(node), src, fn_flags))
      47 -> pipeline_ir_effect_flags_merge(pipeline_ir_raw_effect_expr_flags(node_f3(node), src, fn_flags), pipeline_ir_raw_effect_expr_flags(node_f4(node), src, fn_flags))
      48 -> pipeline_ir_raw_effect_expr_flags(node_f1(node), src, fn_flags)
      49 -> pipeline_ir_raw_effect_expr_flags(node_f1(node), src, fn_flags)
      51 -> 0
      52 -> pipeline_ir_effect_flags_merge(pipeline_ir_raw_effect_expr_flags(node_f1(node), src, fn_flags), pipeline_ir_raw_effect_expr_flags(node_f2(node), src, fn_flags))
      54 -> 0
      55 -> pipeline_ir_effect_flags_merge(2, pipeline_ir_raw_effect_expr_flags(node_f2(node), src, fn_flags))
      56 -> pipeline_ir_effect_flags_merge(2, pipeline_ir_raw_effect_expr_flags(node_f1(node), src, fn_flags))
      57 -> pipeline_ir_effect_flags_merge(2, pipeline_ir_effect_flags_merge(pipeline_ir_raw_effect_expr_flags(node_f1(node), src, fn_flags), pipeline_ir_raw_effect_expr_flags(node_f2(node), src, fn_flags)))
      _ -> 2
    }
  }
}

fn pipeline_ir_raw_effect_function_flags(fn_wrap: i64, fn_src: i64, fn_flags: i64) -> i64 {
  let inner = pipeline_fn_inner(fn_wrap)
  pipeline_ir_raw_effect_expr_flags(node_f4(inner), fn_src, fn_flags)
}

fn pipeline_ir_raw_effect_flags_once(fns: i64, user_src: i64, old_flags: i64) -> i64 {
  let mut next_flags = 0
  let mut changed = 0
  let n = nlist_len(fns)
  for i in 0..n {
    let pair = nlist_get(fns, i)
    if node_f2(pair) == user_src {
      let fn_wrap = node_f1(pair)
      let fn_src = node_f2(pair)
      let inner = pipeline_fn_inner(fn_wrap)
      let hash = str_hash(fn_src, node_f1(inner), node_f2(inner))
      let old = pipeline_ir_effect_flag_map_lookup(old_flags, hash)
      let body_flags = pipeline_ir_raw_effect_function_flags(fn_wrap, fn_src, old_flags)
      let flags = pipeline_ir_effect_flags_merge(old, body_flags)
      if flags != old { changed = 1 } else { 0 }
      if flags != 0 {
        next_flags = pipeline_ir_effect_flag_map_prepend(hash, flags, next_flags)
      } else { 0 }
    } else { 0 }
  }
  node_new(0, next_flags, changed, 0, 0)
}

fn pipeline_ir_raw_effect_flags_fixpoint(fns: i64, user_src: i64, old_flags: i64) -> i64 {
  let step = pipeline_ir_raw_effect_flags_once(fns, user_src, old_flags)
  let next_flags = node_f1(step)
  if node_f2(step) == 0 { next_flags }
  else { pipeline_ir_raw_effect_flags_fixpoint(fns, user_src, next_flags) }
}

fn pipeline_ir_semantic_facts_from_fns(fns: i64, user_src: i64) -> PipelineIrSemanticFactList {
  let mut result = pipeline_ir_semantic_facts_empty()
  let raw_effect_flags = pipeline_ir_raw_effect_flags_fixpoint(fns, user_src, 0)
  let n = nlist_len(fns)
  for i in 0..n {
    let pair = nlist_get(fns, i)
    if node_f2(pair) == user_src {
      let fn_wrap = node_f1(pair)
      let fn_src = node_f2(pair)
      let inner = pipeline_fn_inner(fn_wrap)
      let params = node_f3(inner)
      let hash = str_hash(fn_src, node_f1(inner), node_f2(inner))
      let fact = cg_semantic_fact_new_for_fn_with_effect_flags(0, fn_wrap, params, fn_ret_type(fn_wrap), 0, pipeline_ir_effect_flag_map_lookup(raw_effect_flags, hash))
      result = pipeline_ir_semantic_facts_prepend(hash, fact, result)
    } else { 0 }
  }
  result
}

fn pipeline_ir_match_final_arm_elision_candidate(arms: i64, n_arms: i64, src: i64, tt: i64) -> i64 {
  if n_arms <= 0 {
    0
  } else {
    let arm = nlist_get(arms, n_arms - 1)
    let pat = node_f1(arm)
    if node_tag(pat) == 20 and node_f3(arm) == 0 {
      pipeline_match_ctor_arms_exhaustive(tt, src, arms, n_arms, node_f1(pat), node_f2(pat))
    } else {
      0
    }
  }
}

fn pipeline_ir_match_final_arm_elision_sites_list(nodes: i64, count: i64, src: i64, tt: i64) -> i64 {
  let mut total = 0
  for i in 0..count {
    total = total + pipeline_ir_match_final_arm_elision_sites_expr(nlist_get(nodes, i), src, tt)
  }
  total
}

fn pipeline_ir_match_final_arm_elision_sites_record_fields(fields: i64, nfields: i64, src: i64, tt: i64) -> i64 {
  let mut total = 0
  for i in 0..nfields {
    let field = nlist_get(fields, i)
    total = total + pipeline_ir_match_final_arm_elision_sites_expr(node_f3(field), src, tt)
  }
  total
}

fn pipeline_ir_match_final_arm_elision_sites_clause_bodies(clauses: i64, nclauses: i64, src: i64, tt: i64) -> i64 {
  let mut total = 0
  for i in 0..nclauses {
    let clause = nlist_get(clauses, i)
    total = total + pipeline_ir_match_final_arm_elision_sites_expr(node_f3(clause), src, tt)
  }
  total
}

fn pipeline_ir_match_final_arm_elision_sites_match_arms(arms: i64, narms: i64, src: i64, tt: i64) -> i64 {
  let mut total = 0
  for i in 0..narms {
    let arm = nlist_get(arms, i)
    total = total + pipeline_ir_match_final_arm_elision_sites_expr(node_f2(arm), src, tt)
    total = total + pipeline_ir_match_final_arm_elision_sites_expr(node_f3(arm), src, tt)
  }
  total
}

fn pipeline_ir_match_final_arm_elision_sites_block(first: i64, rest: i64, src: i64, tt: i64) -> i64 {
  let first_sites = pipeline_ir_match_final_arm_elision_sites_expr(first, src, tt)
  if rest == 0 {
    first_sites
  } else {
    first_sites + pipeline_ir_match_final_arm_elision_sites_expr(rest, src, tt)
  }
}

fn pipeline_ir_match_final_arm_elision_sites_handle(expr: i64, src: i64, tt: i64) -> i64 {
  let body = node_f1(expr)
  let clauses = node_f2(expr)
  let nclauses = node_f3(expr)
  pipeline_ir_match_final_arm_elision_sites_expr(body, src, tt) +
    pipeline_ir_match_final_arm_elision_sites_clause_bodies(clauses, nclauses, src, tt)
}

fn pipeline_ir_match_final_arm_elision_sites_generic_call(expr: i64, src: i64, tt: i64) -> i64 {
  let call_node = node_f2(expr)
  pipeline_ir_match_final_arm_elision_sites_list(node_f3(call_node), node_f4(call_node), src, tt)
}

fn pipeline_ir_match_final_arm_elision_sites_expr(expr: i64, src: i64, tt: i64) -> i64 {
  if expr == 0 {
    0
  } else {
    let tag = node_tag(expr)
    match tag {
      3 -> pipeline_ir_match_final_arm_elision_sites_expr(node_f2(expr), src, tt) + pipeline_ir_match_final_arm_elision_sites_expr(node_f3(expr), src, tt)
      4 -> pipeline_ir_match_final_arm_elision_sites_list(node_f3(expr), node_f4(expr), src, tt)
      5 -> pipeline_ir_match_final_arm_elision_sites_expr(node_f1(expr), src, tt) + pipeline_ir_match_final_arm_elision_sites_expr(node_f2(expr), src, tt) + pipeline_ir_match_final_arm_elision_sites_expr(node_f3(expr), src, tt)
      6 -> pipeline_ir_match_final_arm_elision_sites_expr(node_f3(expr), src, tt) + pipeline_ir_match_final_arm_elision_sites_expr(node_f4(expr), src, tt)
      7 -> pipeline_ir_match_final_arm_elision_sites_block(node_f1(expr), node_f2(expr), src, tt)
      10 -> pipeline_ir_match_final_arm_elision_sites_expr(node_f1(expr), src, tt) + pipeline_ir_match_final_arm_elision_sites_expr(node_f2(expr), src, tt)
      11 -> pipeline_ir_match_final_arm_elision_sites_expr(node_f3(expr), src, tt) + pipeline_ir_match_final_arm_elision_sites_expr(node_f4(expr), src, tt)
      12 -> pipeline_ir_match_final_arm_elision_sites_expr(node_f3(expr), src, tt)
      13 -> pipeline_ir_match_final_arm_elision_sites_expr(node_f1(expr), src, tt)
      14 -> pipeline_ir_match_final_arm_elision_sites_record_fields(node_f3(expr), node_f4(expr), src, tt)
      15 -> {
        let arms = node_f2(expr)
        let narms = node_f3(expr)
        pipeline_ir_match_final_arm_elision_candidate(arms, narms, src, tt) +
          pipeline_ir_match_final_arm_elision_sites_expr(node_f1(expr), src, tt) +
          pipeline_ir_match_final_arm_elision_sites_match_arms(arms, narms, src, tt)
      }
      22 -> pipeline_ir_match_final_arm_elision_sites_expr(node_f1(expr), src, tt)
      25 -> pipeline_ir_match_final_arm_elision_sites_expr(node_f1(expr), src, tt)
      26 -> pipeline_ir_match_final_arm_elision_sites_expr(node_f1(expr), src, tt)
      29 -> pipeline_ir_match_final_arm_elision_sites_expr(node_f2(expr), src, tt)
      32 -> pipeline_ir_match_final_arm_elision_sites_list(node_f4(expr), nlist_len(node_f4(expr)), src, tt)
      33 -> pipeline_ir_match_final_arm_elision_sites_handle(expr, src, tt)
      35 -> pipeline_ir_match_final_arm_elision_sites_expr(node_f1(expr), src, tt)
      36 -> pipeline_ir_match_final_arm_elision_sites_generic_call(expr, src, tt)
      37 -> pipeline_ir_match_final_arm_elision_sites_expr(node_f1(expr), src, tt)
      41 -> pipeline_ir_match_final_arm_elision_sites_expr(node_f1(expr), src, tt) + pipeline_ir_match_final_arm_elision_sites_list(node_f3(expr), nlist_len(node_f3(expr)), src, tt)
      45 -> pipeline_ir_match_final_arm_elision_sites_expr(node_f1(expr), src, tt)
      46 -> pipeline_ir_match_final_arm_elision_sites_expr(node_f1(expr), src, tt) + pipeline_ir_match_final_arm_elision_sites_expr(node_f2(expr), src, tt)
      47 -> pipeline_ir_match_final_arm_elision_sites_expr(node_f3(expr), src, tt) + pipeline_ir_match_final_arm_elision_sites_expr(node_f4(expr), src, tt)
      48 -> pipeline_ir_match_final_arm_elision_sites_expr(node_f1(expr), src, tt)
      49 -> pipeline_ir_match_final_arm_elision_sites_expr(node_f1(expr), src, tt)
      52 -> pipeline_ir_match_final_arm_elision_sites_expr(node_f1(expr), src, tt) + pipeline_ir_match_final_arm_elision_sites_expr(node_f2(expr), src, tt)
      _ -> 0
    }
  }
}

fn pipeline_ir_match_final_arm_elision_sites_from_fns(fns: i64, user_src: i64, tt: i64) -> i64 {
  let mut total = 0
  let n = nlist_len(fns)
  for i in 0..n {
    let pair = nlist_get(fns, i)
    if node_f2(pair) == user_src {
      let fn_wrap = node_f1(pair)
      let inner = pipeline_fn_inner(fn_wrap)
      total = total + pipeline_ir_match_final_arm_elision_sites_expr(node_f4(inner), user_src, tt)
    } else { 0 }
  }
  total
}

fn pipeline_optimised_insts(insts: IrInstList, env: PipelineIrConstEnv, aliases: PipelineIrAliasEnv, call_cse: PipelineIrCallCseEnv, next_value: i64, const_fold_sites: i64, algebraic_fold_sites: i64) -> PipelineOptimisedInsts {
  PipelineOptimisedInsts(insts, env, aliases, call_cse, next_value, const_fold_sites, algebraic_fold_sites)
}

fn pipeline_optimised_insts_insts(opt: PipelineOptimisedInsts) -> IrInstList {
  match opt {
    PipelineOptimisedInsts(insts, env, aliases, call_cse, next_value, const_fold_sites, algebraic_fold_sites) -> insts
  }
}

fn pipeline_optimised_insts_env(opt: PipelineOptimisedInsts) -> PipelineIrConstEnv {
  match opt {
    PipelineOptimisedInsts(insts, env, aliases, call_cse, next_value, const_fold_sites, algebraic_fold_sites) -> env
  }
}

fn pipeline_optimised_insts_aliases(opt: PipelineOptimisedInsts) -> PipelineIrAliasEnv {
  match opt {
    PipelineOptimisedInsts(insts, env, aliases, call_cse, next_value, const_fold_sites, algebraic_fold_sites) -> aliases
  }
}

fn pipeline_optimised_insts_call_cse(opt: PipelineOptimisedInsts) -> PipelineIrCallCseEnv {
  match opt {
    PipelineOptimisedInsts(insts, env, aliases, call_cse, next_value, const_fold_sites, algebraic_fold_sites) -> call_cse
  }
}

fn pipeline_optimised_insts_next_value(opt: PipelineOptimisedInsts) -> i64 {
  match opt {
    PipelineOptimisedInsts(insts, env, aliases, call_cse, next_value, const_fold_sites, algebraic_fold_sites) -> next_value
  }
}

fn pipeline_optimised_insts_const_fold_sites(opt: PipelineOptimisedInsts) -> i64 {
  match opt {
    PipelineOptimisedInsts(insts, env, aliases, call_cse, next_value, const_fold_sites, algebraic_fold_sites) -> const_fold_sites
  }
}

fn pipeline_optimised_insts_algebraic_fold_sites(opt: PipelineOptimisedInsts) -> i64 {
  match opt {
    PipelineOptimisedInsts(insts, env, aliases, call_cse, next_value, const_fold_sites, algebraic_fold_sites) -> algebraic_fold_sites
  }
}

fn pipeline_optimise_ir_copy_result(dst: i64, source: i64, env: PipelineIrConstEnv, aliases: PipelineIrAliasEnv, call_cse: PipelineIrCallCseEnv, next_value: i64) -> PipelineOptimisedInsts {
  let canonical = pipeline_ir_alias_env_lookup_or(aliases, source)
  let next_aliases = pipeline_ir_alias_env_bind(aliases, dst, canonical)
  let source_const = pipeline_ir_const_env_lookup(env, canonical)
  let next_env = if pipeline_ir_const_lookup_valid(source_const) == 1 {
    pipeline_ir_const_env_bind(env, dst, pipeline_ir_const_lookup_value(source_const))
  } else {
    env
  }
  pipeline_optimised_insts(ir_inst_list_empty(), next_env, next_aliases, call_cse, next_value, 0, 1)
}

fn pipeline_optimise_ir_rewrite_result(dst: i64, rewrite: PipelineIrRewrite, env: PipelineIrConstEnv, aliases: PipelineIrAliasEnv, call_cse: PipelineIrCallCseEnv, next_value: i64) -> PipelineOptimisedInsts {
  match rewrite {
    PipelineIrRewriteUnchanged -> pipeline_optimised_insts(ir_inst_list_empty(), env, aliases, call_cse, next_value, 0, 0)
    PipelineIrRewriteConst(value) -> {
      let folded_inst = ir_inst_const_i64(dst, value)
      let next_env = pipeline_ir_const_env_bind(env, dst, value)
      pipeline_optimised_insts(ir_inst_list_prepend(folded_inst, ir_inst_list_empty()), next_env, aliases, call_cse, next_value, 0, 1)
    }
    PipelineIrRewriteCopy(source) -> pipeline_optimise_ir_copy_result(dst, source, env, aliases, call_cse, next_value)
    PipelineIrRewriteInsts(insts, rewrite_next) -> {
      let next_env = pipeline_ir_const_env_from_inst_list(insts, env)
      pipeline_optimised_insts(insts, next_env, aliases, call_cse, rewrite_next, 0, 1)
    }
  }
}

fn pipeline_ir_inst_preserves_pure_call_cse(inst: IrInst, facts: PipelineIrSemanticFactList) -> i64 {
  match inst {
    IrConstI64(dst, value) -> 1
    IrBinaryI64(dst, op, lhs, rhs) -> 1
    IrUnaryI64(dst, op, value) -> 1
    IrCallI64(dst, callee_hash, args) -> pipeline_ir_semantic_fact_lookup_pure_scalar_result(facts, callee_hash)
    _ -> 0
  }
}

fn pipeline_optimise_ir_inst(inst: IrInst, env: PipelineIrConstEnv, aliases: PipelineIrAliasEnv, call_cse: PipelineIrCallCseEnv, facts: PipelineIrSemanticFactList, next_value: i64) -> PipelineOptimisedInsts {
  let rewritten = pipeline_ir_rewrite_inst_uses(inst, aliases)
  match rewritten {
    IrConstI64(dst, value) -> {
      let next_env = pipeline_ir_const_env_bind(env, dst, value)
      pipeline_optimised_insts(ir_inst_list_prepend(rewritten, ir_inst_list_empty()), next_env, aliases, call_cse, next_value, 0, 0)
    }
    IrBinaryI64(dst, op, lhs, rhs) -> {
      let left = pipeline_ir_const_env_lookup(env, lhs)
      let right = pipeline_ir_const_env_lookup(env, rhs)
      if pipeline_ir_const_lookup_valid(left) == 1 and pipeline_ir_const_lookup_valid(right) == 1 {
        let folded = pipeline_ir_const_eval(op, pipeline_ir_const_lookup_value(left), pipeline_ir_const_lookup_value(right))
        if pipeline_ir_const_lookup_valid(folded) == 1 {
          let value = pipeline_ir_const_lookup_value(folded)
          let folded_inst = ir_inst_const_i64(dst, value)
          let next_env = pipeline_ir_const_env_bind(env, dst, value)
          pipeline_optimised_insts(ir_inst_list_prepend(folded_inst, ir_inst_list_empty()), next_env, aliases, call_cse, next_value, 1, 0)
        } else {
          let rewrite = pipeline_ir_algebraic_rewrite(dst, op, lhs, rhs, left, right, next_value)
          match rewrite {
            PipelineIrRewriteUnchanged -> pipeline_optimised_insts(ir_inst_list_prepend(rewritten, ir_inst_list_empty()), env, aliases, call_cse, next_value, 0, 0)
            _ -> pipeline_optimise_ir_rewrite_result(dst, rewrite, env, aliases, call_cse, next_value)
          }
        }
      } else {
        let rewrite = pipeline_ir_algebraic_rewrite(dst, op, lhs, rhs, left, right, next_value)
        match rewrite {
          PipelineIrRewriteUnchanged -> pipeline_optimised_insts(ir_inst_list_prepend(rewritten, ir_inst_list_empty()), env, aliases, call_cse, next_value, 0, 0)
          _ -> pipeline_optimise_ir_rewrite_result(dst, rewrite, env, aliases, call_cse, next_value)
        }
      }
    }
    IrCallI64(dst, callee_hash, args) -> {
      if pipeline_ir_semantic_fact_lookup_pure_scalar_result(facts, callee_hash) == 1 {
        let found = pipeline_ir_call_cse_env_lookup(call_cse, callee_hash, args)
        if pipeline_ir_const_lookup_valid(found) == 1 {
          let next_aliases = pipeline_ir_alias_env_bind(aliases, dst, pipeline_ir_const_lookup_value(found))
          pipeline_optimised_insts(ir_inst_list_empty(), env, next_aliases, call_cse, next_value, 0, 0)
        } else {
          let next_cse = pipeline_ir_call_cse_env_bind(call_cse, callee_hash, args, dst)
          pipeline_optimised_insts(ir_inst_list_prepend(rewritten, ir_inst_list_empty()), env, aliases, next_cse, next_value, 0, 0)
        }
      } else {
        pipeline_optimised_insts(ir_inst_list_prepend(rewritten, ir_inst_list_empty()), env, aliases, pipeline_ir_call_cse_env_empty(), next_value, 0, 0)
      }
    }
    _ -> {
      let next_cse = if pipeline_ir_inst_preserves_pure_call_cse(rewritten, facts) == 1 { call_cse } else { pipeline_ir_call_cse_env_empty() }
      pipeline_optimised_insts(ir_inst_list_prepend(rewritten, ir_inst_list_empty()), env, aliases, next_cse, next_value, 0, 0)
    }
  }
}

fn pipeline_optimise_ir_inst_list(insts: IrInstList, env: PipelineIrConstEnv, aliases: PipelineIrAliasEnv, call_cse: PipelineIrCallCseEnv, facts: PipelineIrSemanticFactList, next_value: i64) -> PipelineOptimisedInsts {
  match insts {
    IrInstNil -> pipeline_optimised_insts(ir_inst_list_empty(), env, aliases, call_cse, next_value, 0, 0)
    IrInstCons(inst, rest) -> {
      let head = pipeline_optimise_ir_inst(inst, env, aliases, call_cse, facts, next_value)
      let tail = pipeline_optimise_ir_inst_list(
        rest,
        pipeline_optimised_insts_env(head),
        pipeline_optimised_insts_aliases(head),
        pipeline_optimised_insts_call_cse(head),
        facts,
        pipeline_optimised_insts_next_value(head)
      )
      pipeline_optimised_insts(
        ir_inst_list_append(pipeline_optimised_insts_insts(head), pipeline_optimised_insts_insts(tail)),
        pipeline_optimised_insts_env(tail),
        pipeline_optimised_insts_aliases(tail),
        pipeline_optimised_insts_call_cse(tail),
        pipeline_optimised_insts_next_value(tail),
        pipeline_optimised_insts_const_fold_sites(head) + pipeline_optimised_insts_const_fold_sites(tail),
        pipeline_optimised_insts_algebraic_fold_sites(head) + pipeline_optimised_insts_algebraic_fold_sites(tail)
      )
    }
  }
}

fn pipeline_ir_const_env_from_inst(inst: IrInst, env: PipelineIrConstEnv) -> PipelineIrConstEnv {
  match inst {
    IrConstI64(dst, value) -> pipeline_ir_const_env_bind(env, dst, value)
    _ -> env
  }
}

fn pipeline_ir_const_env_from_inst_list(insts: IrInstList, env: PipelineIrConstEnv) -> PipelineIrConstEnv {
  match insts {
    IrInstNil -> env
    IrInstCons(inst, rest) -> pipeline_ir_const_env_from_inst_list(rest, pipeline_ir_const_env_from_inst(inst, env))
  }
}

fn pipeline_ir_const_env_from_block(block: IrBlock, env: PipelineIrConstEnv) -> PipelineIrConstEnv {
  match block {
    IrBlock(id, params, insts, term) -> pipeline_ir_const_env_from_inst_list(insts, env)
  }
}

fn pipeline_ir_const_env_from_block_list(blocks: IrBlockList, env: PipelineIrConstEnv) -> PipelineIrConstEnv {
  match blocks {
    IrBlockListNil -> env
    IrBlockListCons(block, rest) -> pipeline_ir_const_env_from_block_list(rest, pipeline_ir_const_env_from_block(block, env))
  }
}

fn pipeline_ir_block_list_has_branch_to(blocks: IrBlockList, target: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          match term {
            IrTermBranch(cond, then_block, else_block) -> {
              if then_block == target or else_block == target { 1 }
              else { pipeline_ir_block_list_has_branch_to(rest, target) }
            }
            _ -> pipeline_ir_block_list_has_branch_to(rest, target)
          }
        }
      }
    }
  }
}

fn pipeline_ir_block_param_const_merge(blocks: IrBlockList, target: i64, index: i64, consts: PipelineIrConstEnv, seen: i64, valid: i64, value: i64) -> PipelineIrConstLookup {
  match blocks {
    IrBlockListNil -> {
      if seen == 1 and valid == 1 { pipeline_ir_const_lookup(1, value) }
      else { pipeline_ir_const_lookup(0, 0) }
    }
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          match term {
            IrTermJump(jump_target, args) -> {
              if jump_target == target {
                if seen == 1 and valid == 0 {
                  pipeline_ir_block_param_const_merge(rest, target, index, consts, seen, valid, value)
                } else {
                  let arg = pipeline_ir_value_list_get_or(args, index, 0 - 1)
                  let found = pipeline_ir_const_env_lookup(consts, arg)
                  if pipeline_ir_const_lookup_valid(found) == 1 {
                    let found_value = pipeline_ir_const_lookup_value(found)
                    if seen == 0 {
                      pipeline_ir_block_param_const_merge(rest, target, index, consts, 1, 1, found_value)
                    } else {
                      if found_value == value {
                        pipeline_ir_block_param_const_merge(rest, target, index, consts, seen, valid, value)
                      } else {
                        pipeline_ir_block_param_const_merge(rest, target, index, consts, 1, 0, value)
                      }
                    }
                  } else {
                    pipeline_ir_block_param_const_merge(rest, target, index, consts, 1, 0, value)
                  }
                }
              } else {
                pipeline_ir_block_param_const_merge(rest, target, index, consts, seen, valid, value)
              }
            }
            _ -> pipeline_ir_block_param_const_merge(rest, target, index, consts, seen, valid, value)
          }
        }
      }
    }
  }
}

fn pipeline_ir_block_param_const_lookup(blocks: IrBlockList, target: i64, index: i64, consts: PipelineIrConstEnv) -> PipelineIrConstLookup {
  if pipeline_ir_block_list_has_branch_to(blocks, target) == 1 {
    pipeline_ir_const_lookup(0, 0)
  } else {
    pipeline_ir_block_param_const_merge(blocks, target, index, consts, 0, 1, 0)
  }
}

fn pipeline_ir_block_param_const_env_params(params: IrValueList, index: i64, target: i64, blocks: IrBlockList, consts: PipelineIrConstEnv, env: PipelineIrConstEnv) -> PipelineIrConstEnv {
  match params {
    IrValueNil -> env
    IrValueCons(param, rest) -> {
      let found = pipeline_ir_block_param_const_lookup(blocks, target, index, consts)
      let next_env = if pipeline_ir_const_lookup_valid(found) == 1 {
        pipeline_ir_const_env_bind(env, param, pipeline_ir_const_lookup_value(found))
      } else {
        env
      }
      pipeline_ir_block_param_const_env_params(rest, index + 1, target, blocks, consts, next_env)
    }
  }
}

fn pipeline_ir_block_param_const_env(block: IrBlock, blocks: IrBlockList, consts: PipelineIrConstEnv) -> PipelineIrConstEnv {
  match block {
    IrBlock(id, params, insts, term) -> pipeline_ir_block_param_const_env_params(params, 0, id, blocks, consts, consts)
  }
}

fn pipeline_ir_live_set_empty() -> PipelineIrLiveSet {
  PipelineIrLiveSetNil
}

fn pipeline_ir_live_set_contains(live: PipelineIrLiveSet, value: i64) -> i64 {
  match live {
    PipelineIrLiveSetNil -> 0
    PipelineIrLiveSetCons(v, rest) -> {
      if v == value { 1 } else { pipeline_ir_live_set_contains(rest, value) }
    }
  }
}

fn pipeline_ir_live_set_len(live: PipelineIrLiveSet) -> i64 {
  match live {
    PipelineIrLiveSetNil -> 0
    PipelineIrLiveSetCons(v, rest) -> 1 + pipeline_ir_live_set_len(rest)
  }
}

fn pipeline_ir_live_set_add(live: PipelineIrLiveSet, value: i64) -> PipelineIrLiveSet {
  if value < 0 { live }
  else {
    if pipeline_ir_live_set_contains(live, value) == 1 { live }
    else { PipelineIrLiveSetCons(value, live) }
  }
}

fn pipeline_ir_live_set_remove(live: PipelineIrLiveSet, value: i64) -> PipelineIrLiveSet {
  match live {
    PipelineIrLiveSetNil -> PipelineIrLiveSetNil
    PipelineIrLiveSetCons(v, rest) -> {
      let filtered = pipeline_ir_live_set_remove(rest, value)
      if v == value { filtered } else { PipelineIrLiveSetCons(v, filtered) }
    }
  }
}

fn pipeline_ir_live_set_add_values(live: PipelineIrLiveSet, values: IrValueList) -> PipelineIrLiveSet {
  match values {
    IrValueNil -> live
    IrValueCons(value, rest) -> pipeline_ir_live_set_add_values(pipeline_ir_live_set_add(live, value), rest)
  }
}

fn pipeline_ir_live_set_add_record_fields(live: PipelineIrLiveSet, fields: IrRecordFieldList) -> PipelineIrLiveSet {
  match fields {
    IrRecordFieldNil -> live
    IrRecordFieldCons(field_hash, value, rest) -> pipeline_ir_live_set_add_record_fields(pipeline_ir_live_set_add(live, value), rest)
  }
}

fn pipeline_ir_branch_target_paramless(blocks: IrBlockList, target: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          if id == target {
            if ir_value_list_len(params) == 0 { 1 } else { 0 }
          } else {
            pipeline_ir_branch_target_paramless(rest, target)
          }
        }
      }
    }
  }
}

fn pipeline_ir_live_set_add_jump_args_for_live_params(args: IrValueList, params: IrValueList, live: PipelineIrLiveSet) -> PipelineIrLiveSet {
  match args {
    IrValueNil -> live
    IrValueCons(arg, arg_rest) -> {
      match params {
        IrValueNil -> pipeline_ir_live_set_add_values(live, args)
        IrValueCons(param, param_rest) -> {
          let next = if pipeline_ir_live_set_contains(live, param) == 1 {
            pipeline_ir_live_set_add(live, arg)
          } else {
            live
          }
          pipeline_ir_live_set_add_jump_args_for_live_params(arg_rest, param_rest, next)
        }
      }
    }
  }
}

fn pipeline_ir_live_set_add_jump_args_for_target_params(blocks: IrBlockList, target: i64, args: IrValueList, live: PipelineIrLiveSet) -> PipelineIrLiveSet {
  match blocks {
    IrBlockListNil -> pipeline_ir_live_set_add_values(live, args)
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          if id == target {
            pipeline_ir_live_set_add_jump_args_for_live_params(args, params, live)
          } else {
            pipeline_ir_live_set_add_jump_args_for_target_params(rest, target, args, live)
          }
        }
      }
    }
  }
}

fn pipeline_ir_live_set_add_term_with_blocks(term: IrTerminator, live: PipelineIrLiveSet, blocks: IrBlockList) -> PipelineIrLiveSet {
  match term {
    IrTermNone -> live
    IrTermReturn(value) -> pipeline_ir_live_set_add(live, value)
    IrTermJump(target, args) -> {
      if ir_value_list_len(args) == 0 {
        live
      } else {
        pipeline_ir_live_set_add_jump_args_for_target_params(blocks, target, args, live)
      }
    }
    IrTermBranch(cond, then_block, else_block) -> pipeline_ir_live_set_add(live, cond)
  }
}

fn pipeline_ir_fold_branch_term(term: IrTerminator, env: PipelineIrConstEnv, blocks: IrBlockList) -> IrTerminator {
  match term {
    IrTermBranch(cond, then_block, else_block) -> {
      let found = pipeline_ir_const_env_lookup(env, cond)
      if pipeline_ir_const_lookup_valid(found) == 1 {
        let target = if pipeline_ir_const_lookup_value(found) != 0 { then_block } else { else_block }
        if pipeline_ir_branch_target_paramless(blocks, target) == 1 {
          ir_term_jump(target)
        } else {
          term
        }
      } else {
        term
      }
    }
    _ -> term
  }
}

fn pipeline_ir_reachable_seed(blocks: IrBlockList) -> PipelineIrLiveSet {
  match blocks {
    IrBlockListNil -> pipeline_ir_live_set_empty()
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> pipeline_ir_live_set_add(pipeline_ir_live_set_empty(), id)
      }
    }
  }
}

fn pipeline_ir_reachable_add_term(term: IrTerminator, reachable: PipelineIrLiveSet) -> PipelineIrLiveSet {
  match term {
    IrTermNone -> reachable
    IrTermReturn(value) -> reachable
    IrTermJump(target, args) -> pipeline_ir_live_set_add(reachable, target)
    IrTermBranch(cond, then_block, else_block) -> pipeline_ir_live_set_add(pipeline_ir_live_set_add(reachable, then_block), else_block)
  }
}

fn pipeline_ir_reachable_add_block_successors(block: IrBlock, reachable: PipelineIrLiveSet) -> PipelineIrLiveSet {
  match block {
    IrBlock(id, params, insts, term) -> {
      if pipeline_ir_live_set_contains(reachable, id) == 1 {
        pipeline_ir_reachable_add_term(term, reachable)
      } else {
        reachable
      }
    }
  }
}

fn pipeline_ir_reachable_add_successors(blocks: IrBlockList, reachable: PipelineIrLiveSet) -> PipelineIrLiveSet {
  match blocks {
    IrBlockListNil -> reachable
    IrBlockListCons(block, rest) -> {
      let next = pipeline_ir_reachable_add_block_successors(block, reachable)
      pipeline_ir_reachable_add_successors(rest, next)
    }
  }
}

fn pipeline_ir_reachable_fixpoint(blocks: IrBlockList, reachable: PipelineIrLiveSet) -> PipelineIrLiveSet {
  let next = pipeline_ir_reachable_add_successors(blocks, reachable)
  if pipeline_ir_live_set_len(next) == pipeline_ir_live_set_len(reachable) {
    next
  } else {
    pipeline_ir_reachable_fixpoint(blocks, next)
  }
}

fn pipeline_ir_filter_reachable_blocks_with(blocks: IrBlockList, reachable: PipelineIrLiveSet) -> IrBlockList {
  match blocks {
    IrBlockListNil -> ir_block_list_empty()
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          let tail = pipeline_ir_filter_reachable_blocks_with(rest, reachable)
          if pipeline_ir_live_set_contains(reachable, id) == 1 {
            ir_block_list_prepend(block, tail)
          } else {
            tail
          }
        }
      }
    }
  }
}

fn pipeline_ir_filter_reachable_blocks(blocks: IrBlockList) -> IrBlockList {
  let reachable = pipeline_ir_reachable_fixpoint(blocks, pipeline_ir_reachable_seed(blocks))
  pipeline_ir_filter_reachable_blocks_with(blocks, reachable)
}

fn pipeline_ir_inst_def_or(inst: IrInst, default: i64) -> i64 {
  match inst {
    IrConstI64(dst, value) -> dst
    IrStringLit(dst, start, len) -> dst
    IrStringConcatI64(dst, left, right) -> dst
    IrBinaryI64(dst, op, lhs, rhs) -> dst
    IrUnaryI64(dst, op, value) -> dst
    IrLambdaI64(dst, params, body, nparams) -> dst
    IrPerformI64(dst, effect_hash, op_hash, args) -> dst
    IrHandlerDirectI64(dst, effect_hash, op_hash, handler_depth, clause_index, args) -> dst
    IrHandlerPopI64(frame) -> default
    IrBindI64(ns, nl, value) -> default
    IrHandleI64(dst, body, clauses, nclauses) -> dst
    IrResumeI64(dst, value) -> dst
    IrTryI64(dst, value) -> dst
    IrOptChainI64(dst, base, field_hash, field_index) -> dst
    IrCallI64(dst, callee_hash, args) -> dst
    IrIndirectCallI64(dst, callee, args) -> dst
    IrGenericCallI64(dst, callee_hash, type_args, args) -> dst
    IrMethodCallI64(dst, type_hash, method_hash, receiver, args) -> dst
    IrVariantInitI64(dst, tag_hash, payloads) -> dst
    IrVariantTagI64(dst, base) -> dst
    IrVariantPayloadI64(dst, base, index) -> dst
    IrRecordInitI64(dst, type_hash, fields) -> dst
    IrFieldLoadI64(dst, base, field_hash, field_index) -> dst
    IrSlotI64(slot) -> default
    IrLoadI64(dst, slot) -> dst
    IrStoreI64(slot, value) -> default
  }
}

fn pipeline_ir_inst_is_dead_pure_candidate(inst: IrInst, facts: PipelineIrSemanticFactList) -> i64 {
  match inst {
    IrConstI64(dst, value) -> 1
    IrBinaryI64(dst, op, lhs, rhs) -> 1
    IrUnaryI64(dst, op, value) -> 1
    IrCallI64(dst, callee_hash, args) -> pipeline_ir_semantic_fact_lookup_pure(facts, callee_hash)
    _ -> 0
  }
}

fn pipeline_ir_inst_is_semantic_pure_call_candidate(inst: IrInst, facts: PipelineIrSemanticFactList) -> i64 {
  match inst {
    IrCallI64(dst, callee_hash, args) -> pipeline_ir_semantic_fact_lookup_pure(facts, callee_hash)
    _ -> 0
  }
}

fn pipeline_ir_live_set_add_inst_uses(inst: IrInst, live: PipelineIrLiveSet) -> PipelineIrLiveSet {
  match inst {
    IrConstI64(dst, value) -> live
    IrStringLit(dst, start, len) -> live
    IrStringConcatI64(dst, left, right) -> pipeline_ir_live_set_add(pipeline_ir_live_set_add(live, left), right)
    IrBinaryI64(dst, op, lhs, rhs) -> pipeline_ir_live_set_add(pipeline_ir_live_set_add(live, lhs), rhs)
    IrUnaryI64(dst, op, value) -> pipeline_ir_live_set_add(live, value)
    IrLambdaI64(dst, params, body, nparams) -> live
    IrPerformI64(dst, effect_hash, op_hash, args) -> pipeline_ir_live_set_add_values(live, args)
    IrHandlerDirectI64(dst, effect_hash, op_hash, handler_depth, clause_index, args) -> pipeline_ir_live_set_add_values(live, args)
    IrHandlerPopI64(frame) -> pipeline_ir_live_set_add(live, frame)
    IrBindI64(ns, nl, value) -> pipeline_ir_live_set_add(live, value)
    IrHandleI64(dst, body, clauses, nclauses) -> live
    IrResumeI64(dst, value) -> pipeline_ir_live_set_add(live, value)
    IrTryI64(dst, value) -> pipeline_ir_live_set_add(live, value)
    IrOptChainI64(dst, base, field_hash, field_index) -> pipeline_ir_live_set_add(live, base)
    IrCallI64(dst, callee_hash, args) -> pipeline_ir_live_set_add_values(live, args)
    IrIndirectCallI64(dst, callee, args) -> pipeline_ir_live_set_add_values(pipeline_ir_live_set_add(live, callee), args)
    IrGenericCallI64(dst, callee_hash, type_args, args) -> pipeline_ir_live_set_add_values(live, args)
    IrMethodCallI64(dst, type_hash, method_hash, receiver, args) -> pipeline_ir_live_set_add_values(pipeline_ir_live_set_add(live, receiver), args)
    IrVariantInitI64(dst, tag_hash, payloads) -> pipeline_ir_live_set_add_values(live, payloads)
    IrVariantTagI64(dst, base) -> pipeline_ir_live_set_add(live, base)
    IrVariantPayloadI64(dst, base, index) -> pipeline_ir_live_set_add(live, base)
    IrRecordInitI64(dst, type_hash, fields) -> pipeline_ir_live_set_add_record_fields(live, fields)
    IrFieldLoadI64(dst, base, field_hash, field_index) -> pipeline_ir_live_set_add(live, base)
    IrSlotI64(slot) -> live
    IrLoadI64(dst, slot) -> pipeline_ir_live_set_add(live, slot)
    IrStoreI64(slot, value) -> pipeline_ir_live_set_add(pipeline_ir_live_set_add(live, slot), value)
  }
}

fn pipeline_ir_mark_inst_live(inst: IrInst, live: PipelineIrLiveSet, facts: PipelineIrSemanticFactList) -> PipelineIrLiveSet {
  let dst = pipeline_ir_inst_def_or(inst, 0 - 1)
  let candidate = pipeline_ir_inst_is_dead_pure_candidate(inst, facts)
  if candidate == 1 {
    if dst >= 0 and pipeline_ir_live_set_contains(live, dst) == 1 {
      pipeline_ir_live_set_add_inst_uses(inst, live)
    } else {
      live
    }
  } else {
    pipeline_ir_live_set_add_inst_uses(inst, live)
  }
}

fn pipeline_ir_mark_inst_list_live(insts: IrInstList, live: PipelineIrLiveSet, facts: PipelineIrSemanticFactList) -> PipelineIrLiveSet {
  match insts {
    IrInstNil -> live
    IrInstCons(inst, rest) -> {
      let live_after = pipeline_ir_mark_inst_list_live(rest, live, facts)
      pipeline_ir_mark_inst_live(inst, live_after, facts)
    }
  }
}

fn pipeline_ir_mark_block_live(block: IrBlock, live: PipelineIrLiveSet, facts: PipelineIrSemanticFactList, all_blocks: IrBlockList) -> PipelineIrLiveSet {
  match block {
    IrBlock(id, params, insts, term) -> {
      let live_after_term = pipeline_ir_live_set_add_term_with_blocks(term, live, all_blocks)
      pipeline_ir_mark_inst_list_live(insts, live_after_term, facts)
    }
  }
}

fn pipeline_ir_mark_block_list_live(blocks: IrBlockList, live: PipelineIrLiveSet, facts: PipelineIrSemanticFactList, all_blocks: IrBlockList) -> PipelineIrLiveSet {
  match blocks {
    IrBlockListNil -> live
    IrBlockListCons(block, rest) -> {
      let tail_live = pipeline_ir_mark_block_list_live(rest, live, facts, all_blocks)
      pipeline_ir_mark_block_live(block, tail_live, facts, all_blocks)
    }
  }
}

fn pipeline_ir_function_live_fixpoint(blocks: IrBlockList, live: PipelineIrLiveSet, facts: PipelineIrSemanticFactList) -> PipelineIrLiveSet {
  let next = pipeline_ir_mark_block_list_live(blocks, live, facts, blocks)
  -- Length convergence is sound because live marking is monotone: live-set
  -- updates only add values and never replace or remove existing entries.
  if pipeline_ir_live_set_len(next) == pipeline_ir_live_set_len(live) {
    next
  } else {
    pipeline_ir_function_live_fixpoint(blocks, next, facts)
  }
}

fn pipeline_ir_value_list_filter_live(values: IrValueList, live: PipelineIrLiveSet) -> IrValueList {
  match values {
    IrValueNil -> ir_value_list_empty()
    IrValueCons(value, rest) -> {
      let tail = pipeline_ir_value_list_filter_live(rest, live)
      if pipeline_ir_live_set_contains(live, value) == 1 {
        ir_value_list_prepend(value, tail)
      } else {
        tail
      }
    }
  }
}

fn pipeline_ir_trim_jump_args_for_live_params(args: IrValueList, params: IrValueList, live: PipelineIrLiveSet) -> IrValueList {
  match args {
    IrValueNil -> ir_value_list_empty()
    IrValueCons(arg, arg_rest) -> {
      match params {
        IrValueNil -> args
        IrValueCons(param, param_rest) -> {
          let tail = pipeline_ir_trim_jump_args_for_live_params(arg_rest, param_rest, live)
          if pipeline_ir_live_set_contains(live, param) == 1 {
            ir_value_list_prepend(arg, tail)
          } else {
            tail
          }
        }
      }
    }
  }
}

fn pipeline_ir_trim_jump_args_for_target_params(blocks: IrBlockList, target: i64, args: IrValueList, live: PipelineIrLiveSet) -> IrValueList {
  match blocks {
    IrBlockListNil -> args
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          if id == target {
            pipeline_ir_trim_jump_args_for_live_params(args, params, live)
          } else {
            pipeline_ir_trim_jump_args_for_target_params(rest, target, args, live)
          }
        }
      }
    }
  }
}

fn pipeline_ir_trim_term_jump_args(term: IrTerminator, blocks: IrBlockList, live: PipelineIrLiveSet) -> IrTerminator {
  match term {
    IrTermJump(target, args) -> {
      if ir_value_list_len(args) == 0 {
        term
      } else {
        ir_term_jump_args(target, pipeline_ir_trim_jump_args_for_target_params(blocks, target, args, live))
      }
    }
    _ -> term
  }
}

fn pipeline_ir_trim_block_params(block: IrBlock, all_blocks: IrBlockList, live: PipelineIrLiveSet) -> IrBlock {
  match block {
    IrBlock(id, params, insts, term) -> {
      ir_block_new_params(id, pipeline_ir_value_list_filter_live(params, live), insts, pipeline_ir_trim_term_jump_args(term, all_blocks, live))
    }
  }
}

fn pipeline_ir_trim_block_param_list(blocks: IrBlockList, all_blocks: IrBlockList, live: PipelineIrLiveSet) -> IrBlockList {
  match blocks {
    IrBlockListNil -> ir_block_list_empty()
    IrBlockListCons(block, rest) -> {
      ir_block_list_prepend(
        pipeline_ir_trim_block_params(block, all_blocks, live),
        pipeline_ir_trim_block_param_list(rest, all_blocks, live)
      )
    }
  }
}

fn pipeline_dce_insts(insts: IrInstList, live: PipelineIrLiveSet, dead_inst_sites: i64, pure_call_dce_sites: i64) -> PipelineDceInsts {
  PipelineDceInsts(insts, live, dead_inst_sites, pure_call_dce_sites)
}

fn pipeline_dce_insts_insts(dce: PipelineDceInsts) -> IrInstList {
  match dce {
    PipelineDceInsts(insts, live, dead_inst_sites, pure_call_dce_sites) -> insts
  }
}

fn pipeline_dce_insts_live(dce: PipelineDceInsts) -> PipelineIrLiveSet {
  match dce {
    PipelineDceInsts(insts, live, dead_inst_sites, pure_call_dce_sites) -> live
  }
}

fn pipeline_dce_insts_dead_inst_sites(dce: PipelineDceInsts) -> i64 {
  match dce {
    PipelineDceInsts(insts, live, dead_inst_sites, pure_call_dce_sites) -> dead_inst_sites
  }
}

fn pipeline_dce_insts_pure_call_dce_sites(dce: PipelineDceInsts) -> i64 {
  match dce {
    PipelineDceInsts(insts, live, dead_inst_sites, pure_call_dce_sites) -> pure_call_dce_sites
  }
}

fn pipeline_dce_sweep_ir_inst(inst: IrInst, live: PipelineIrLiveSet, facts: PipelineIrSemanticFactList) -> PipelineDceInsts {
  let dst = pipeline_ir_inst_def_or(inst, 0 - 1)
  let candidate = pipeline_ir_inst_is_dead_pure_candidate(inst, facts)
  if candidate == 1 and dst >= 0 and pipeline_ir_live_set_contains(live, dst) == 0 {
    let pure_call_dce = pipeline_ir_inst_is_semantic_pure_call_candidate(inst, facts)
    pipeline_dce_insts(ir_inst_list_empty(), live, 1, pure_call_dce)
  } else {
    pipeline_dce_insts(ir_inst_list_prepend(inst, ir_inst_list_empty()), live, 0, 0)
  }
}

fn pipeline_dce_sweep_ir_inst_list(insts: IrInstList, live: PipelineIrLiveSet, facts: PipelineIrSemanticFactList) -> PipelineDceInsts {
  match insts {
    IrInstNil -> pipeline_dce_insts(ir_inst_list_empty(), live, 0, 0)
    IrInstCons(inst, rest) -> {
      let head = pipeline_dce_sweep_ir_inst(inst, live, facts)
      let tail = pipeline_dce_sweep_ir_inst_list(rest, live, facts)
      pipeline_dce_insts(
        ir_inst_list_append(pipeline_dce_insts_insts(head), pipeline_dce_insts_insts(tail)),
        live,
        pipeline_dce_insts_dead_inst_sites(head) + pipeline_dce_insts_dead_inst_sites(tail),
        pipeline_dce_insts_pure_call_dce_sites(head) + pipeline_dce_insts_pure_call_dce_sites(tail)
      )
    }
  }
}

fn pipeline_dce_sweep_ir_block(block: IrBlock, live: PipelineIrLiveSet, facts: PipelineIrSemanticFactList) -> PipelineOptimisedBlocks {
  match block {
    IrBlock(id, params, insts, term) -> {
      let dce = pipeline_dce_sweep_ir_inst_list(insts, live, facts)
      pipeline_optimised_blocks(
        ir_block_list_prepend(ir_block_new_params(id, params, pipeline_dce_insts_insts(dce), term), ir_block_list_empty()),
        0,
        0,
        0,
        pipeline_dce_insts_dead_inst_sites(dce),
        pipeline_dce_insts_pure_call_dce_sites(dce)
      )
    }
  }
}

fn pipeline_dce_sweep_ir_block_list(blocks: IrBlockList, live: PipelineIrLiveSet, facts: PipelineIrSemanticFactList) -> PipelineOptimisedBlocks {
  match blocks {
    IrBlockListNil -> pipeline_optimised_blocks(ir_block_list_empty(), 0, 0, 0, 0, 0)
    IrBlockListCons(block, rest) -> {
      let head = pipeline_dce_sweep_ir_block(block, live, facts)
      let tail = pipeline_dce_sweep_ir_block_list(rest, live, facts)
      pipeline_optimised_blocks(
        ir_block_list_append(pipeline_optimised_blocks_blocks(head), pipeline_optimised_blocks_blocks(tail)),
        0,
        0,
        0,
        pipeline_optimised_blocks_dead_inst_sites(head) + pipeline_optimised_blocks_dead_inst_sites(tail),
        pipeline_optimised_blocks_pure_call_dce_sites(head) + pipeline_optimised_blocks_pure_call_dce_sites(tail)
      )
    }
  }
}

fn pipeline_optimised_blocks(blocks: IrBlockList, next_value: i64, const_fold_sites: i64, algebraic_fold_sites: i64, dead_inst_sites: i64, pure_call_dce_sites: i64) -> PipelineOptimisedBlocks {
  PipelineOptimisedBlocks(blocks, next_value, const_fold_sites, algebraic_fold_sites, dead_inst_sites, pure_call_dce_sites)
}

fn pipeline_optimised_blocks_blocks(opt: PipelineOptimisedBlocks) -> IrBlockList {
  match opt {
    PipelineOptimisedBlocks(blocks, next_value, const_fold_sites, algebraic_fold_sites, dead_inst_sites, pure_call_dce_sites) -> blocks
  }
}

fn pipeline_optimised_blocks_next_value(opt: PipelineOptimisedBlocks) -> i64 {
  match opt {
    PipelineOptimisedBlocks(blocks, next_value, const_fold_sites, algebraic_fold_sites, dead_inst_sites, pure_call_dce_sites) -> next_value
  }
}

fn pipeline_optimised_blocks_const_fold_sites(opt: PipelineOptimisedBlocks) -> i64 {
  match opt {
    PipelineOptimisedBlocks(blocks, next_value, const_fold_sites, algebraic_fold_sites, dead_inst_sites, pure_call_dce_sites) -> const_fold_sites
  }
}

fn pipeline_optimised_blocks_algebraic_fold_sites(opt: PipelineOptimisedBlocks) -> i64 {
  match opt {
    PipelineOptimisedBlocks(blocks, next_value, const_fold_sites, algebraic_fold_sites, dead_inst_sites, pure_call_dce_sites) -> algebraic_fold_sites
  }
}

fn pipeline_optimised_blocks_dead_inst_sites(opt: PipelineOptimisedBlocks) -> i64 {
  match opt {
    PipelineOptimisedBlocks(blocks, next_value, const_fold_sites, algebraic_fold_sites, dead_inst_sites, pure_call_dce_sites) -> dead_inst_sites
  }
}

fn pipeline_optimised_blocks_pure_call_dce_sites(opt: PipelineOptimisedBlocks) -> i64 {
  match opt {
    PipelineOptimisedBlocks(blocks, next_value, const_fold_sites, algebraic_fold_sites, dead_inst_sites, pure_call_dce_sites) -> pure_call_dce_sites
  }
}

fn pipeline_optimise_ir_block(block: IrBlock, env: PipelineIrConstEnv, facts: PipelineIrSemanticFactList, next_value: i64, all_blocks: IrBlockList) -> PipelineOptimisedBlocks {
  match block {
    IrBlock(id, params, insts, term) -> {
      let opt = pipeline_optimise_ir_inst_list(insts, env, pipeline_ir_alias_env_empty(), pipeline_ir_call_cse_env_empty(), facts, next_value)
      let rewritten_term = pipeline_ir_rewrite_term(term, pipeline_optimised_insts_aliases(opt))
      let folded_term = pipeline_ir_fold_branch_term(rewritten_term, pipeline_optimised_insts_env(opt), all_blocks)
      pipeline_optimised_blocks(
        ir_block_list_prepend(ir_block_new_params(id, params, pipeline_optimised_insts_insts(opt), folded_term), ir_block_list_empty()),
        pipeline_optimised_insts_next_value(opt),
        pipeline_optimised_insts_const_fold_sites(opt),
        pipeline_optimised_insts_algebraic_fold_sites(opt),
        0,
        0
      )
    }
  }
}

fn pipeline_optimise_ir_block_list_with_param_consts(blocks: IrBlockList, all_blocks: IrBlockList, consts: PipelineIrConstEnv, facts: PipelineIrSemanticFactList, next_value: i64) -> PipelineOptimisedBlocks {
  match blocks {
    IrBlockListNil -> pipeline_optimised_blocks(ir_block_list_empty(), next_value, 0, 0, 0, 0)
    IrBlockListCons(block, rest) -> {
      let env = pipeline_ir_block_param_const_env(block, all_blocks, consts)
      let head = pipeline_optimise_ir_block(block, env, facts, next_value, all_blocks)
      let tail = pipeline_optimise_ir_block_list_with_param_consts(rest, all_blocks, consts, facts, pipeline_optimised_blocks_next_value(head))
      pipeline_optimised_blocks(
        ir_block_list_append(pipeline_optimised_blocks_blocks(head), pipeline_optimised_blocks_blocks(tail)),
        pipeline_optimised_blocks_next_value(tail),
        pipeline_optimised_blocks_const_fold_sites(head) + pipeline_optimised_blocks_const_fold_sites(tail),
        pipeline_optimised_blocks_algebraic_fold_sites(head) + pipeline_optimised_blocks_algebraic_fold_sites(tail),
        pipeline_optimised_blocks_dead_inst_sites(head) + pipeline_optimised_blocks_dead_inst_sites(tail),
        pipeline_optimised_blocks_pure_call_dce_sites(head) + pipeline_optimised_blocks_pure_call_dce_sites(tail)
      )
    }
  }
}

fn pipeline_ir_cfg_fold_once(blocks: IrBlockList, facts: PipelineIrSemanticFactList, next_value: i64) -> PipelineOptimisedBlocks {
  let consts = pipeline_ir_const_env_from_block_list(blocks, pipeline_ir_const_env_empty())
  let folded = pipeline_optimise_ir_block_list_with_param_consts(blocks, blocks, consts, facts, next_value)
  pipeline_optimised_blocks(
    pipeline_ir_filter_reachable_blocks(pipeline_optimised_blocks_blocks(folded)),
    pipeline_optimised_blocks_next_value(folded),
    pipeline_optimised_blocks_const_fold_sites(folded),
    pipeline_optimised_blocks_algebraic_fold_sites(folded),
    0,
    0
  )
}

fn pipeline_ir_cfg_fold_fixpoint(
  blocks: IrBlockList,
  facts: PipelineIrSemanticFactList,
  next_value: i64,
  remaining: i64,
  prev_block_count: i64,
  prev_inst_count: i64,
  prev_binary_count: i64,
  prev_branch_count: i64
) -> PipelineOptimisedBlocks {
  let step = pipeline_ir_cfg_fold_once(blocks, facts, next_value)
  let step_blocks = pipeline_optimised_blocks_blocks(step)
  let step_block_count = ir_block_list_len(step_blocks)
  let step_inst_count = ir_block_list_inst_count(step_blocks)
  let step_binary_count = ir_block_list_count_tag(step_blocks, 2)
  let step_branch_count = ir_block_list_count_term_tag(step_blocks, 3)
  let stable = step_block_count == prev_block_count and step_inst_count == prev_inst_count and step_binary_count == prev_binary_count and step_branch_count == prev_branch_count
  if remaining <= 1 or stable {
    step
  } else {
    let tail = pipeline_ir_cfg_fold_fixpoint(
      step_blocks,
      facts,
      pipeline_optimised_blocks_next_value(step),
      remaining - 1,
      step_block_count,
      step_inst_count,
      step_binary_count,
      step_branch_count
    )
    pipeline_optimised_blocks(
      pipeline_optimised_blocks_blocks(tail),
      pipeline_optimised_blocks_next_value(tail),
      pipeline_optimised_blocks_const_fold_sites(step) + pipeline_optimised_blocks_const_fold_sites(tail),
      pipeline_optimised_blocks_algebraic_fold_sites(step) + pipeline_optimised_blocks_algebraic_fold_sites(tail),
      0,
      0
    )
  }
}

fn pipeline_optimised_functions(functions: IrFunctionList, const_fold_sites: i64, algebraic_fold_sites: i64, dead_inst_sites: i64, pure_call_dce_sites: i64) -> PipelineOptimisedFunctions {
  PipelineOptimisedFunctions(functions, const_fold_sites, algebraic_fold_sites, dead_inst_sites, pure_call_dce_sites)
}

fn pipeline_optimised_functions_functions(opt: PipelineOptimisedFunctions) -> IrFunctionList {
  match opt {
    PipelineOptimisedFunctions(functions, const_fold_sites, algebraic_fold_sites, dead_inst_sites, pure_call_dce_sites) -> functions
  }
}

fn pipeline_optimised_functions_const_fold_sites(opt: PipelineOptimisedFunctions) -> i64 {
  match opt {
    PipelineOptimisedFunctions(functions, const_fold_sites, algebraic_fold_sites, dead_inst_sites, pure_call_dce_sites) -> const_fold_sites
  }
}

fn pipeline_optimised_functions_algebraic_fold_sites(opt: PipelineOptimisedFunctions) -> i64 {
  match opt {
    PipelineOptimisedFunctions(functions, const_fold_sites, algebraic_fold_sites, dead_inst_sites, pure_call_dce_sites) -> algebraic_fold_sites
  }
}

fn pipeline_optimised_functions_dead_inst_sites(opt: PipelineOptimisedFunctions) -> i64 {
  match opt {
    PipelineOptimisedFunctions(functions, const_fold_sites, algebraic_fold_sites, dead_inst_sites, pure_call_dce_sites) -> dead_inst_sites
  }
}

fn pipeline_optimised_functions_pure_call_dce_sites(opt: PipelineOptimisedFunctions) -> i64 {
  match opt {
    PipelineOptimisedFunctions(functions, const_fold_sites, algebraic_fold_sites, dead_inst_sites, pure_call_dce_sites) -> pure_call_dce_sites
  }
}

fn pipeline_optimise_ir_function(f: IrFunction, facts: PipelineIrSemanticFactList) -> PipelineOptimisedFunctions {
  match f {
    IrFunction(hash, params, blocks) -> {
      let first_next_value = pipeline_ir_function_next_value(params, blocks)
      let fold_bound = ir_block_list_len(blocks) + 2
      let folded = pipeline_ir_cfg_fold_fixpoint(
        blocks,
        facts,
        first_next_value,
        fold_bound,
        ir_block_list_len(blocks),
        ir_block_list_inst_count(blocks),
        ir_block_list_count_tag(blocks, 2),
        ir_block_list_count_term_tag(blocks, 3)
      )
      let folded_blocks = pipeline_optimised_blocks_blocks(folded)
      let live = pipeline_ir_function_live_fixpoint(folded_blocks, pipeline_ir_live_set_empty(), facts)
      let trimmed_blocks = pipeline_ir_trim_block_param_list(folded_blocks, folded_blocks, live)
      let dce = pipeline_dce_sweep_ir_block_list(trimmed_blocks, live, facts)
      pipeline_optimised_functions(
        ir_function_list_prepend(ir_function_new_blocks(hash, params, pipeline_optimised_blocks_blocks(dce)), ir_function_list_empty()),
        pipeline_optimised_blocks_const_fold_sites(folded),
        pipeline_optimised_blocks_algebraic_fold_sites(folded),
        pipeline_optimised_blocks_dead_inst_sites(dce),
        pipeline_optimised_blocks_pure_call_dce_sites(dce)
      )
    }
  }
}

fn pipeline_optimise_ir_function_list(functions: IrFunctionList, facts: PipelineIrSemanticFactList) -> PipelineOptimisedFunctions {
  match functions {
    IrFunctionNil -> pipeline_optimised_functions(ir_function_list_empty(), 0, 0, 0, 0)
    IrFunctionCons(f, rest) -> {
      let head = pipeline_optimise_ir_function(f, facts)
      let tail = pipeline_optimise_ir_function_list(rest, facts)
      pipeline_optimised_functions(
        pipeline_ir_function_list_append(pipeline_optimised_functions_functions(head), pipeline_optimised_functions_functions(tail)),
        pipeline_optimised_functions_const_fold_sites(head) + pipeline_optimised_functions_const_fold_sites(tail),
        pipeline_optimised_functions_algebraic_fold_sites(head) + pipeline_optimised_functions_algebraic_fold_sites(tail),
        pipeline_optimised_functions_dead_inst_sites(head) + pipeline_optimised_functions_dead_inst_sites(tail),
        pipeline_optimised_functions_pure_call_dce_sites(head) + pipeline_optimised_functions_pure_call_dce_sites(tail)
      )
    }
  }
}

fn pipeline_optimise_ir(ir: IrModule) -> IrModule {
  match ir {
    IrModule(functions) -> {
      let facts = pipeline_ir_semantic_facts_empty()
      let opt = pipeline_optimise_ir_function_list(functions, facts)
      OptimisedIrModule(
        pipeline_optimised_functions_functions(opt),
        0,
        0,
        0,
        pipeline_optimised_functions_const_fold_sites(opt),
        pipeline_optimised_functions_algebraic_fold_sites(opt),
        pipeline_optimised_functions_dead_inst_sites(opt),
        facts,
        pipeline_optimised_functions_pure_call_dce_sites(opt),
        0
      )
    }
    OptimisedIrModule(functions, inline_sites, residual_sites, evidence_candidate_sites, const_fold_sites, algebraic_fold_sites, dead_inst_sites, semantic_facts, pure_call_dce_sites, match_final_arm_elision_sites) -> ir
  }
}

fn pipeline_optimise_typed_ir(typed: TypedModule, ir: IrModule) -> IrModule {
  match typed {
    TypedModule(fns, src, tt) -> {
      let base_functions = pipeline_lower_fns_handler_optimised(fns, tt, src)
      let generic_specs = pipeline_collect_generic_specs_fns(fns, tt, src)
      let functions = pipeline_ir_function_list_append(base_functions, generic_specs)
      let semantic_facts = pipeline_ir_semantic_facts_from_fns(fns, src)
      let match_final_arm_elision_sites = pipeline_ir_match_final_arm_elision_sites_from_fns(fns, src, tt)
      let opt = pipeline_optimise_ir_function_list(functions, semantic_facts)
      let optimised_functions = pipeline_optimised_functions_functions(opt)
      let stats = pipeline_handler_inline_stats_from_ir_functions(optimised_functions)
      let evidence_candidate_sites = pipeline_handler_evidence_candidate_sites_from_ir_functions(optimised_functions)
      OptimisedIrModule(
        optimised_functions,
        pipeline_handler_inline_stats_inline_sites(stats),
        pipeline_handler_inline_stats_residual_sites(stats),
        evidence_candidate_sites,
        pipeline_optimised_functions_const_fold_sites(opt),
        pipeline_optimised_functions_algebraic_fold_sites(opt),
        pipeline_optimised_functions_dead_inst_sites(opt),
        semantic_facts,
        pipeline_optimised_functions_pure_call_dce_sites(opt),
        match_final_arm_elision_sites
      )
    }
  }
}

fn pipeline_emit_native(typed: TypedModule) -> BinaryObject {
  match typed {
    TypedModule(fns, src, tt) -> {
      let ir = pipeline_lower_ir(typed)
      let optimised = pipeline_optimise_typed_ir(typed, ir)
      let native = pipeline_lower_native_module(typed, optimised)
      pipeline_emit_native_binary(native, src)
    }
  }
}

fn pipeline_write_binary(binary: BinaryObject) -> i64 {
  match binary {
    BinaryObject(o, kind) -> {
      sys_write(1, buf_ptr(o), buf_len(o))
      0
    }
  }
}

fn pipeline_compile_native_source(src: i64, n: i64) -> i64 {
  pipeline_compile_native_source_with_origin(src, n, 0, 1)
}

fn pipeline_compile_native_source_with_trust(src: i64, n: i64, trusted: i64) -> i64 {
  pipeline_compile_native_source_with_origin(src, n, trusted, pipeline_strict_for_trust(trusted))
}

fn pipeline_compile_native_source_with_origin(src: i64, n: i64, trusted: i64, strict: i64) -> i64 {
  let typed = pipeline_check_source_with_origin(src, n, trusted, strict)
  let binary = pipeline_emit_native(typed)
  pipeline_write_binary(binary)
}
