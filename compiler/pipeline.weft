-- One declaration-ordered physical layout for a nominal record. Compact
-- records retain the historical word layout; a direct array field selects a
-- described layout whose facts are shared by construction and projection.
type PipelineRecordStorageFieldFactList {
  PipelineRecordStorageFieldFactNil,
  -- field hash, logical word offset, visible byte offset, field type, lanes.
  PipelineRecordStorageFieldFactWord(i64, i64, i64, i64, i64, PipelineRecordStorageFieldFactList),
  -- field hash, logical word offset, visible byte offset, field type, byte
  -- size/alignment, flattened managed-leaf count/stride/kind.
  PipelineRecordStorageFieldFactArray(i64, i64, i64, i64, i64, i64, i64, i64, i64, PipelineRecordStorageFieldFactList)
}

type PipelineRecordStorageLayout {
  PipelineRecordStorageLayoutCompact,
  PipelineRecordStorageLayoutDescribed(i64, i64, PipelineRecordStorageFieldFactList),
  PipelineRecordStorageLayoutInvalid
}

