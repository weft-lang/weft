  match facts {
    PipelineIrBlockEntryFactNil -> pipeline_ir_const_lookup(0, 0)
    PipelineIrBlockEntryCtorFact(fact_block, fact_value, ctor_hash, rest) -> pipeline_ir_block_entry_vector_len_fact_lookup_chain(rest, block_id, len_value)
    PipelineIrBlockEntryNotCtorFact(fact_block, fact_value, ctor_hash, rest) -> pipeline_ir_block_entry_vector_len_fact_lookup_chain(rest, block_id, len_value)
    PipelineIrBlockEntryScalarFact(fact_block, fact_value, kind, value, rest) -> pipeline_ir_block_entry_vector_len_fact_lookup_chain(rest, block_id, len_value)
    PipelineIrBlockEntrySlotScalarFact(fact_block, slot_id, kind, value, rest) -> pipeline_ir_block_entry_vector_len_fact_lookup_chain(rest, block_id, len_value)
    PipelineIrBlockEntryVectorLenFact(fact_block, fact_len, vec_value, rest) -> {
      if fact_block == block_id and fact_len == len_value {
        pipeline_ir_const_lookup(1, vec_value)
      } else {
        pipeline_ir_block_entry_vector_len_fact_lookup_chain(rest, block_id, len_value)
      }
    }
    PipelineIrBlockEntryVectorUpperFact(fact_block, vec_value, index_value, rest) -> pipeline_ir_block_entry_vector_len_fact_lookup_chain(rest, block_id, len_value)
    PipelineIrBlockEntryVectorSlotUpperFact(fact_block, vec_value, slot_id, rest) -> pipeline_ir_block_entry_vector_len_fact_lookup_chain(rest, block_id, len_value)
    PipelineIrBlockEntryVectorSlotRowUpperFact(fact_block, vec_value, row_width, slot_id, rest) -> pipeline_ir_block_entry_vector_len_fact_lookup_chain(rest, block_id, len_value)
    PipelineIrBlockEntryVectorRowUpperFact(fact_block, vec_value, row_width, slot_id, rest) -> pipeline_ir_block_entry_vector_len_fact_lookup_chain(rest, block_id, len_value)
    PipelineIrBlockEntryVariantOriginFact(fact_block, fact_value, ctor_hash, payloads, rest) -> pipeline_ir_block_entry_vector_len_fact_lookup_chain(rest, block_id, len_value)
  }
}

