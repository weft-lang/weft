  PipelineLoweredBlocks(next_block, next_value, blocks, valid, falls_through)
}

fn pipeline_lowered_blocks_invalid(next_block: i64, next_value: i64) -> PipelineLoweredBlocks {
  PipelineLoweredBlocks(next_block, next_value, ir_block_list_empty(), 0, 0)
}

fn pipeline_lowered_blocks_next_block(lowered: PipelineLoweredBlocks) -> i64 {
  match lowered {
    PipelineLoweredBlocks(next_block, next_value, blocks, valid, falls_through) -> next_block
  }
}

fn pipeline_lowered_blocks_next_value(lowered: PipelineLoweredBlocks) -> i64 {
  match lowered {
    PipelineLoweredBlocks(next_block, next_value, blocks, valid, falls_through) -> next_value
