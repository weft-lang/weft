  else { if pipeline_ir_native_intrinsic_unsigned_int_to_f32_hash(callee_hash) == 1 { 28 }
  else { if callee_hash == pipeline_ir_native_intrinsic_f64_to_i64_trunc_hash() { 29 }
  else { if callee_hash == pipeline_ir_native_intrinsic_f32_to_f64_hash() { 30 }
  else { if callee_hash == pipeline_ir_native_intrinsic_f64_to_f32_hash() { 31 }
  else { if callee_hash == pipeline_ir_native_intrinsic_f64_sqrt_hash() { 32 }
  else { if callee_hash == pipeline_ir_native_intrinsic_f32_sqrt_hash() { 33 }
  else { if callee_hash == pipeline_ir_native_intrinsic_syscall_hash() { 34 }
  else { if callee_hash == pipeline_ir_native_intrinsic_bump_alloc_hash() { 1 }
  else { if callee_hash == pipeline_ir_native_intrinsic_mem_store64_hash() { 2 }
  else { if callee_hash == pipeline_ir_native_intrinsic_mem_store8_hash() { 3 }
  else { if callee_hash == pipeline_ir_native_intrinsic_mem_load64_hash() { 4 }
