  }
}

-- Residency metrics (2l): pure post-scans over the emitted code buffer.
-- These measure sp-based memory traffic in the artifact itself rather than
-- relying on emission-site counters, so every emitter path is covered.

fn pipeline_native_code_word(code: i64, pos: i64) -> i64 {
  let p = buf_ptr(code)
  let b0 = mem_load8_at(p, pos)
  let b1 = mem_load8_at(p, pos + 1)
  let b2 = mem_load8_at(p, pos + 2)
  let b3 = mem_load8_at(p, pos + 3)
  b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
}

-- kind 0: ldr Xt, [sp, #imm]      (spill reloads)
-- kind 1: str Xt, [sp, #imm]      (spill stores)
-- kind 2: ldp Xt, Xt2, [sp], #16  (GPR epilogue pair loads)
-- kind 3: stp Xt, Xt2, [sp, -16]! (GPR prologue pair stores)
-- kind 4: ldp Dt, Dt2, [sp], #16  (FP epilogue pair loads)
-- kind 5: stp Dt, Dt2, [sp, -16]! (FP prologue pair stores)
fn pipeline_native_sp_traffic_count(native: NativeModule, kind: i64) -> i64 {
  match native {
    NativeModule(code, fm, functions) -> {
      let words = buf_len(code) / 4
      let mut count = 0
      for i in 0..words {
        let word = pipeline_native_code_word(code, i * 4)
        let rn = word / 32 - word / 1024 * 32
        if rn == 31 {
          let op22 = word / 4194304
          let want = if kind == 0 { 997 }
            else { if kind == 1 { 996 }
            else { if kind == 2 { 675 }
            else { if kind == 3 { 678 }
            else { if kind == 4 { 435 } else { 438 } } } } }
          if op22 == want { count = count + 1 } else { 0 }
        } else { 0 }
      }
      count
    }
  }
}

fn pipeline_native_sp_load_count(native: NativeModule) -> i64 {
  pipeline_native_sp_traffic_count(native, 0)
}

fn pipeline_native_sp_store_count(native: NativeModule) -> i64 {
  pipeline_native_sp_traffic_count(native, 1)
}

fn pipeline_native_sp_pair_load_count(native: NativeModule) -> i64 {
  pipeline_native_sp_traffic_count(native, 2)
}

fn pipeline_native_sp_pair_store_count(native: NativeModule) -> i64 {
  pipeline_native_sp_traffic_count(native, 3)
}

fn pipeline_native_sp_fp_pair_load_count(native: NativeModule) -> i64 {
  pipeline_native_sp_traffic_count(native, 4)
}

fn pipeline_native_sp_fp_pair_store_count(native: NativeModule) -> i64 {
  pipeline_native_sp_traffic_count(native, 5)
}

-- Count exact instruction words in the emitted buffer. Lets tests assert
-- structural facts such as "no stp x8, x9 pair save remains anywhere".
fn pipeline_native_code_word_count(native: NativeModule, target: i64) -> i64 {
  match native {
    NativeModule(code, fm, functions) -> {
      let words = buf_len(code) / 4
      let mut count = 0
      for i in 0..words {
        if pipeline_native_code_word(code, i * 4) == target { count = count + 1 } else { 0 }
      }
      count
    }
  }
}

