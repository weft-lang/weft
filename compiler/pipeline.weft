-- Resolve a branch operand to its slot through the value-definition
-- table (any dominating block) and prove the loaded value is still the
-- slot's current value at the branch: the slot is never address-taken
-- and no store to it intervenes on the (single-pred, bounded) path
-- from the load to the branch.
fn pipeline_ir_slot_for_branch_operand(cfg: i64, all_blocks: IrBlockList, branch_block: i64, value_id: i64) -> i64 {
  let def = pipeline_ir_value_def_lookup(pipeline_ir_cfg_bundle_def_table(cfg), value_id)
  if def != 0 and node_f1(def) == 6 {
    let slot = node_f2(def)
    if pipeline_ir_cfg_bundle_slot_addr_taken(cfg, slot) == 0 and pipeline_ir_slot_path_store_free(all_blocks, node_f1(cfg), node_f3(def), node_f4(def), branch_block, slot) == 1 {
      slot
    } else { 0 - 1 }
  } else { 0 - 1 }
}

fn pipeline_ir_block_entry_facts_add_slot_scalar_for_load(cfg: i64, all_blocks: IrBlockList, branch_block: i64, facts: PipelineIrBlockEntryFactList, block_id: i64, value_id: i64, kind: i64, value: i64) -> PipelineIrBlockEntryFactAddResult {
  let slot = pipeline_ir_slot_for_branch_operand(cfg, all_blocks, branch_block, value_id)
  if slot >= 0 {
    pipeline_ir_block_entry_facts_add_slot_scalar(facts, block_id, slot, kind, value)
  } else {
    pipeline_ir_block_entry_fact_add_result(facts, 0)
  }
}

fn pipeline_ir_block_entry_facts_add_vector_slot_upper_for_load(cfg: i64, all_blocks: IrBlockList, branch_block: i64, facts: PipelineIrBlockEntryFactList, block_id: i64, vec_value: i64, index_value: i64) -> PipelineIrBlockEntryFactAddResult {
  let slot = pipeline_ir_slot_for_branch_operand(cfg, all_blocks, branch_block, index_value)
  if slot >= 0 {
    pipeline_ir_block_entry_facts_add_vector_slot_upper(facts, block_id, vec_value, slot)
  } else {
    pipeline_ir_block_entry_fact_add_result(facts, 0)
  }
}

fn pipeline_ir_block_entry_facts_prepend_vector_slot_row_upper(block_id: i64, vec_value: i64, width: i64, slot_id: i64, rest: PipelineIrBlockEntryFactList) -> PipelineIrBlockEntryFactList {
  pipeline_ir_block_entry_facts_with_block_chain(rest, block_id, PipelineIrBlockEntryVectorSlotRowUpperFact(block_id, vec_value, width, slot_id, pipeline_ir_block_entry_facts_block_chain(rest, block_id)))
}

fn pipeline_ir_block_entry_facts_add_vector_slot_row_upper(facts: PipelineIrBlockEntryFactList, block_id: i64, vec_value: i64, width: i64, slot_id: i64) -> PipelineIrBlockEntryFactAddResult {
  if pipeline_ir_block_entry_vector_slot_row_upper_fact_lookup(facts, block_id, vec_value, width, slot_id) == 1 {
    pipeline_ir_block_entry_fact_add_result(facts, 0)
  } else {
    pipeline_ir_block_entry_fact_add_result(pipeline_ir_block_entry_facts_prepend_vector_slot_row_upper(block_id, vec_value, width, slot_id, facts), 1)
  }
}

fn pipeline_ir_block_entry_facts_prepend_vector_row_upper(block_id: i64, vec_value: i64, width: i64, value_id: i64, rest: PipelineIrBlockEntryFactList) -> PipelineIrBlockEntryFactList {
  pipeline_ir_block_entry_facts_with_block_chain(rest, block_id, PipelineIrBlockEntryVectorRowUpperFact(block_id, vec_value, width, value_id, pipeline_ir_block_entry_facts_block_chain(rest, block_id)))
}

fn pipeline_ir_block_entry_vector_row_upper_exact_chain(facts: PipelineIrBlockEntryFactChain, block_id: i64, vec_value: i64, width: i64, value_id: i64) -> i64 {
  match facts {
    PipelineIrBlockEntryFactNil -> 0
    PipelineIrBlockEntryCtorFact(fact_block, fact_value, ctor_hash, rest) -> pipeline_ir_block_entry_vector_row_upper_exact_chain(rest, block_id, vec_value, width, value_id)
    PipelineIrBlockEntryNotCtorFact(fact_block, fact_value, ctor_hash, rest) -> pipeline_ir_block_entry_vector_row_upper_exact_chain(rest, block_id, vec_value, width, value_id)
    PipelineIrBlockEntryScalarFact(fact_block, fact_value, kind, value, rest) -> pipeline_ir_block_entry_vector_row_upper_exact_chain(rest, block_id, vec_value, width, value_id)
    PipelineIrBlockEntrySlotScalarFact(fact_block, fact_slot, kind, value, rest) -> pipeline_ir_block_entry_vector_row_upper_exact_chain(rest, block_id, vec_value, width, value_id)
    PipelineIrBlockEntryVectorLenFact(fact_block, len_value, fact_vec, rest) -> pipeline_ir_block_entry_vector_row_upper_exact_chain(rest, block_id, vec_value, width, value_id)
    PipelineIrBlockEntryVectorUpperFact(fact_block, fact_vec, fact_index, rest) -> pipeline_ir_block_entry_vector_row_upper_exact_chain(rest, block_id, vec_value, width, value_id)
    PipelineIrBlockEntryVectorSlotUpperFact(fact_block, fact_vec, fact_slot, rest) -> pipeline_ir_block_entry_vector_row_upper_exact_chain(rest, block_id, vec_value, width, value_id)
    PipelineIrBlockEntryVectorSlotRowUpperFact(fact_block, fact_vec, row_width, fact_slot, rest) -> pipeline_ir_block_entry_vector_row_upper_exact_chain(rest, block_id, vec_value, width, value_id)
    PipelineIrBlockEntryVectorRowUpperFact(fact_block, fact_vec, row_width, fact_value, rest) -> {
      if fact_block == block_id and fact_vec == vec_value and row_width == width and fact_value == value_id { 1 }
      else { pipeline_ir_block_entry_vector_row_upper_exact_chain(rest, block_id, vec_value, width, value_id) }
    }
    PipelineIrBlockEntryVariantOriginFact(fact_block, fact_value, ctor_hash, payloads, rest) -> pipeline_ir_block_entry_vector_row_upper_exact_chain(rest, block_id, vec_value, width, value_id)
  }
}

fn pipeline_ir_block_entry_facts_add_vector_row_upper(facts: PipelineIrBlockEntryFactList, block_id: i64, vec_value: i64, width: i64, value_id: i64) -> PipelineIrBlockEntryFactAddResult {
  if pipeline_ir_block_entry_vector_row_upper_exact_chain(pipeline_ir_block_entry_facts_block_chain(facts, block_id), block_id, vec_value, width, value_id) == 1 {
    pipeline_ir_block_entry_fact_add_result(facts, 0)
  } else {
    pipeline_ir_block_entry_fact_add_result(pipeline_ir_block_entry_facts_prepend_vector_row_upper(block_id, vec_value, width, value_id, facts), 1)
  }
}

fn pipeline_ir_block_entry_facts_add_vector_slot_row_upper_for_load(cfg: i64, all_blocks: IrBlockList, branch_block: i64, facts: PipelineIrBlockEntryFactList, block_id: i64, vec_value: i64, width: i64, index_value: i64) -> PipelineIrBlockEntryFactAddResult {
  let slot = pipeline_ir_slot_for_branch_operand(cfg, all_blocks, branch_block, index_value)
  if slot >= 0 {
    pipeline_ir_block_entry_facts_add_vector_slot_row_upper(facts, block_id, vec_value, width, slot)
  } else {
    pipeline_ir_block_entry_fact_add_result(facts, 0)
  }
}

fn pipeline_ir_block_entry_facts_add_variant_origin(facts: PipelineIrBlockEntryFactList, block_id: i64, value_id: i64, ctor_hash: i64, payloads: IrValueList) -> PipelineIrBlockEntryFactAddResult {
  if pipeline_ir_block_entry_variant_origin_exists(facts, block_id, value_id) == 1 {
    pipeline_ir_block_entry_fact_add_result(facts, 0)
  } else {
    pipeline_ir_block_entry_fact_add_result(pipeline_ir_block_entry_facts_prepend_variant_origin(block_id, value_id, ctor_hash, payloads, facts), 1)
  }
}

fn pipeline_ir_edge_value_lookup_or(params: IrValueList, args: IrValueList, value: i64, default: i64) -> i64 {
  match params {
    IrValueNil -> default
    IrValueCons(param, param_rest) -> {
      match args {
        IrValueNil -> default
        IrValueCons(arg, arg_rest) -> {
          if arg == value { param }
          else { pipeline_ir_edge_value_lookup_or(param_rest, arg_rest, value, default) }
        }
      }
    }
  }
}

fn pipeline_ir_edge_translate_value(params: IrValueList, args: IrValueList, value: i64) -> i64 {
  pipeline_ir_edge_value_lookup_or(params, args, value, value)
}

fn pipeline_ir_edge_translate_values(values: IrValueList, params: IrValueList, args: IrValueList) -> IrValueList {
  match values {
    IrValueNil -> ir_value_list_empty()
    IrValueCons(value, rest) -> {
      ir_value_list_prepend(pipeline_ir_edge_translate_value(params, args, value), pipeline_ir_edge_translate_values(rest, params, args))
    }
  }
}

fn pipeline_ir_block_entry_facts_add_ctor_for_matching_params(params: IrValueList, args: IrValueList, facts: PipelineIrBlockEntryFactList, target_block: i64, source_value: i64, ctor_hash: i64) -> PipelineIrBlockEntryFactAddResult {
  match params {
    IrValueNil -> pipeline_ir_block_entry_fact_add_result(facts, 0)
    IrValueCons(param, param_rest) -> {
      match args {
        IrValueNil -> pipeline_ir_block_entry_fact_add_result(facts, 0)
        IrValueCons(arg, arg_rest) -> {
          let head = if arg == source_value {
            pipeline_ir_block_entry_facts_add_ctor(facts, target_block, param, ctor_hash)
          } else {
            pipeline_ir_block_entry_fact_add_result(facts, 0)
          }
          let tail = pipeline_ir_block_entry_facts_add_ctor_for_matching_params(param_rest, arg_rest, pipeline_ir_block_entry_fact_add_result_facts(head), target_block, source_value, ctor_hash)
          let changed = if pipeline_ir_block_entry_fact_add_result_changed(head) == 1 or pipeline_ir_block_entry_fact_add_result_changed(tail) == 1 { 1 } else { 0 }
          pipeline_ir_block_entry_fact_add_result(pipeline_ir_block_entry_fact_add_result_facts(tail), changed)
        }
      }
    }
  }
}

fn pipeline_ir_block_entry_facts_add_not_ctor_for_matching_params(params: IrValueList, args: IrValueList, facts: PipelineIrBlockEntryFactList, target_block: i64, source_value: i64, ctor_hash: i64) -> PipelineIrBlockEntryFactAddResult {
  match params {
    IrValueNil -> pipeline_ir_block_entry_fact_add_result(facts, 0)
    IrValueCons(param, param_rest) -> {
      match args {
        IrValueNil -> pipeline_ir_block_entry_fact_add_result(facts, 0)
        IrValueCons(arg, arg_rest) -> {
          let head = if arg == source_value {
            pipeline_ir_block_entry_facts_add_not_ctor(facts, target_block, param, ctor_hash)
          } else {
            pipeline_ir_block_entry_fact_add_result(facts, 0)
          }
          let tail = pipeline_ir_block_entry_facts_add_not_ctor_for_matching_params(param_rest, arg_rest, pipeline_ir_block_entry_fact_add_result_facts(head), target_block, source_value, ctor_hash)
          let changed = if pipeline_ir_block_entry_fact_add_result_changed(head) == 1 or pipeline_ir_block_entry_fact_add_result_changed(tail) == 1 { 1 } else { 0 }
          pipeline_ir_block_entry_fact_add_result(pipeline_ir_block_entry_fact_add_result_facts(tail), changed)
        }
      }
    }
  }
}

fn pipeline_ir_block_entry_facts_add_scalar_for_matching_params(params: IrValueList, args: IrValueList, facts: PipelineIrBlockEntryFactList, target_block: i64, source_value: i64, kind: i64, value: i64) -> PipelineIrBlockEntryFactAddResult {
  match params {
    IrValueNil -> pipeline_ir_block_entry_fact_add_result(facts, 0)
    IrValueCons(param, param_rest) -> {
      match args {
        IrValueNil -> pipeline_ir_block_entry_fact_add_result(facts, 0)
        IrValueCons(arg, arg_rest) -> {
          let head = if arg == source_value {
            pipeline_ir_block_entry_facts_add_scalar(facts, target_block, param, kind, value)
          } else {
            pipeline_ir_block_entry_fact_add_result(facts, 0)
          }
          let tail = pipeline_ir_block_entry_facts_add_scalar_for_matching_params(param_rest, arg_rest, pipeline_ir_block_entry_fact_add_result_facts(head), target_block, source_value, kind, value)
          let changed = if pipeline_ir_block_entry_fact_add_result_changed(head) == 1 or pipeline_ir_block_entry_fact_add_result_changed(tail) == 1 { 1 } else { 0 }
          pipeline_ir_block_entry_fact_add_result(pipeline_ir_block_entry_fact_add_result_facts(tail), changed)
        }
      }
    }
  }
}

fn pipeline_ir_block_entry_facts_add_variant_origin_for_matching_params(params: IrValueList, args: IrValueList, facts: PipelineIrBlockEntryFactList, target_block: i64, source_value: i64, ctor_hash: i64, payloads: IrValueList) -> PipelineIrBlockEntryFactAddResult {
  match params {
    IrValueNil -> pipeline_ir_block_entry_fact_add_result(facts, 0)
    IrValueCons(param, param_rest) -> {
      match args {
        IrValueNil -> pipeline_ir_block_entry_fact_add_result(facts, 0)
        IrValueCons(arg, arg_rest) -> {
          let translated_payloads = pipeline_ir_edge_translate_values(payloads, params, args)
          let head = if arg == source_value {
            pipeline_ir_block_entry_facts_add_variant_origin(facts, target_block, param, ctor_hash, translated_payloads)
          } else {
            pipeline_ir_block_entry_fact_add_result(facts, 0)
          }
          let tail = pipeline_ir_block_entry_facts_add_variant_origin_for_matching_params(param_rest, arg_rest, pipeline_ir_block_entry_fact_add_result_facts(head), target_block, source_value, ctor_hash, payloads)
          let changed = if pipeline_ir_block_entry_fact_add_result_changed(head) == 1 or pipeline_ir_block_entry_fact_add_result_changed(tail) == 1 { 1 } else { 0 }
          pipeline_ir_block_entry_fact_add_result(pipeline_ir_block_entry_fact_add_result_facts(tail), changed)
        }
      }
    }
  }
}

fn pipeline_ir_vector_len_hash() -> i64 {
  str_hash(__str_ptr("vector_len"), 0, __str_len("vector_len"))
}

fn pipeline_ir_f64_table_get_hash() -> i64 {
  str_hash(__str_ptr("f64_table_get"), 0, __str_len("f64_table_get"))
}

fn pipeline_ir_f64_table_set_hash() -> i64 {
  str_hash(__str_ptr("f64_table_set"), 0, __str_len("f64_table_set"))
}

fn pipeline_ir_f64_table_call_hash(callee_hash: i64) -> i64 {
  if callee_hash == pipeline_ir_f64_table_get_hash() { 1 }
  else { if callee_hash == pipeline_ir_f64_table_set_hash() { 1 } else { 0 } }
}

fn pipeline_ir_f64_table_row_count_hash() -> i64 {
  str_hash(__str_ptr("f64_table_row_count"), 0, __str_len("f64_table_row_count"))
}

-- f64_table_row_count(table, w) with a positive constant width is
-- vector_len(table) / w by definition (the stdlib body's width guard
-- folds under the constant). Rewriting the call exposes the quotient
-- structure to the value-definition table, which the scaled-index
-- bounds rules consume.
fn pipeline_ir_f64_table_row_count_rewrite(dst: i64, args: IrValueList, env: PipelineIrConstEnv, next_value: i64) -> PipelineIrRewrite {
  if ir_value_list_len(args) != 2 {
    pipeline_ir_rewrite_unchanged()
  } else {
    let width_found = pipeline_ir_f64_table_const_arg(args, 1, env)
    if pipeline_ir_const_lookup_valid(width_found) == 1 and pipeline_ir_const_lookup_value(width_found) > 0 {
      let width = pipeline_ir_const_lookup_value(width_found)
      let table = pipeline_ir_value_list_get_or(args, 0, 0 - 1)
      let len_value = next_value
      let width_value = next_value + 1
      let insts = ir_inst_list_prepend(
        IrCallI64(len_value, pipeline_ir_vector_len_hash(), ir_value_list_prepend(table, ir_value_list_empty())),
        ir_inst_list_prepend(
          ir_inst_const_i64(width_value, width),
          ir_inst_list_prepend(
            ir_inst_binary_i64(dst, IrDiv, len_value, width_value),
            ir_inst_list_empty()
          )
        )
      )
      pipeline_ir_rewrite_insts(insts, next_value + 2)
    } else {
      pipeline_ir_rewrite_unchanged()
    }
  }
}

fn pipeline_ir_f64_table_const_arg(args: IrValueList, index: i64, env: PipelineIrConstEnv) -> PipelineIrConstLookup {
  pipeline_ir_const_env_lookup(env, pipeline_ir_value_list_get_or(args, index, 0 - 1))
}

fn pipeline_ir_f64_table_shape_valid(width: i64, field: i64) -> i64 {
  if width <= 0 { 0 }
  else { if field < 0 { 0 }
  else { if field >= width { 0 } else { 1 } } }
}

fn pipeline_ir_f64_table_slot_insts(row: i64, width: i64, field: i64, next_value: i64) -> PipelineIrRewrite {
  let width_value = next_value
  let mul_value = next_value + 1
  let field_value = next_value + 2
  let index_value = next_value + 3
  let insts = ir_inst_list_prepend(
    ir_inst_const_i64(width_value, width),
    ir_inst_list_prepend(
      ir_inst_binary_i64(mul_value, IrMul, row, width_value),
      ir_inst_list_prepend(
        ir_inst_const_i64(field_value, field),
        ir_inst_list_prepend(
          ir_inst_binary_i64(index_value, IrAdd, mul_value, field_value),
          ir_inst_list_empty()
        )
      )
    )
  )
  pipeline_ir_rewrite_insts(insts, next_value + 4)
}

fn pipeline_ir_f64_table_rewrite_call(dst: i64, callee_hash: i64, args: IrValueList, env: PipelineIrConstEnv, next_value: i64) -> PipelineIrRewrite {
  if callee_hash == pipeline_ir_f64_table_row_count_hash() {
    pipeline_ir_f64_table_row_count_rewrite(dst, args, env, next_value)
  } else { if pipeline_ir_f64_table_call_hash(callee_hash) != 1 {
    pipeline_ir_rewrite_unchanged()
  } else { if ir_value_list_len(args) != 5 {
    pipeline_ir_rewrite_unchanged()
  } else {
    let width_found = pipeline_ir_f64_table_const_arg(args, 2, env)
    let field_found = pipeline_ir_f64_table_const_arg(args, 3, env)
    if pipeline_ir_const_lookup_valid(width_found) == 1 and pipeline_ir_const_lookup_valid(field_found) == 1 {
      let width = pipeline_ir_const_lookup_value(width_found)
      let field = pipeline_ir_const_lookup_value(field_found)
      if pipeline_ir_f64_table_shape_valid(width, field) == 1 {
        let table = pipeline_ir_value_list_get_or(args, 0, 0 - 1)
        let row = pipeline_ir_value_list_get_or(args, 1, 0 - 1)
        let slot = pipeline_ir_f64_table_slot_insts(row, width, field, next_value)
        match slot {
          PipelineIrRewriteInsts(slot_insts, slot_next) -> {
            let index_value = slot_next - 1
            let tail = if callee_hash == pipeline_ir_f64_table_get_hash() {
              let fallback = pipeline_ir_value_list_get_or(args, 4, 0 - 1)
              ir_inst_list_prepend(IrVectorGetI64(dst, table, index_value, fallback, 0), ir_inst_list_empty())
            } else {
              if callee_hash == pipeline_ir_f64_table_set_hash() {
                let value = pipeline_ir_value_list_get_or(args, 4, 0 - 1)
                ir_inst_list_prepend(IrVectorSetI64(dst, table, index_value, value, 0), ir_inst_list_empty())
              } else {
                ir_inst_list_empty()
              }
            }
            if ir_inst_list_len(tail) == 0 {
              pipeline_ir_rewrite_unchanged()
            } else {
              pipeline_ir_rewrite_insts(ir_inst_list_append(slot_insts, tail), slot_next)
            }
          }
          _ -> pipeline_ir_rewrite_unchanged()
        }
      } else {
        pipeline_ir_rewrite_unchanged()
      }
    } else {
      pipeline_ir_rewrite_unchanged()
    }
  } } }
}

-- Compiler-inserted managed bookkeeping mutates ownership counts, but
-- cannot change a live vector's length. Keep this classification narrower
-- than semantic purity: these calls remain observable to ownership and DCE.
fn pipeline_ir_len_facts_stable_managed_call_hash(callee_hash: i64) -> i64 {
  if callee_hash == pipeline_rc_default_retain_hash() or callee_hash == pipeline_rc_default_release_hash() { 1 }
  else { if callee_hash == pipeline_rc_default_weak_retain_hash() or callee_hash == pipeline_rc_default_weak_release_hash() or callee_hash == pipeline_rc_default_weak_load_hash() { 1 }
  else { if callee_hash == pipeline_closure_default_retain_hash() or callee_hash == pipeline_closure_default_release_hash() { 1 }
  else { 0 } } }
}

-- Length-derived facts (vector-len origins, upper bounds) established
-- at a block's entry only survive to a successor if nothing in the
-- block could have shrunk a vector: any call other than vector_len,
-- sealed managed bookkeeping, or a known-pure callee, a raw pointer
-- store, a perform, or an indirect/generic/method call invalidates them.
-- pure_callees is the module-level pure-callee hash tree.
fn pipeline_ir_inst_list_len_facts_stable_with(insts: IrInstList, pure_callees: i64) -> i64 {
  match insts {
    IrInstNil -> 1
    IrInstCons(inst, rest) -> {
      match inst {
        IrCallI64(dst, callee_hash, args) -> {
          if callee_hash == pipeline_ir_vector_len_hash() or pipeline_ir_len_facts_stable_managed_call_hash(callee_hash) == 1 or pipeline_ir_hash_tree_contains(pure_callees, callee_hash) == 1 or pipeline_ir_pure_intrinsic_inline_call_hash(callee_hash) == 1 {
            pipeline_ir_inst_list_len_facts_stable_with(rest, pure_callees)
          } else { 0 }
        }
        IrPtrStoreI64(dst, ptr, value) -> 0
        IrPerformI64(dst, effect_hash, op_hash, args) -> 0
        IrHandlerDirectI64(dst, effect_hash, op_hash, handler_depth, clause_index, args) -> 0
        IrIndirectCallI64(dst, callee, args) -> 0
        IrGenericCallI64(dst, callee_hash, type_args, args) -> 0
        IrMethodCallI64(dst, type_hash, method_hash, receiver, args) -> 0
        _ -> pipeline_ir_inst_list_len_facts_stable_with(rest, pure_callees)
      }
    }
  }
}

fn pipeline_ir_inst_list_len_facts_stable(insts: IrInstList) -> i64 {
  pipeline_ir_inst_list_len_facts_stable_with(insts, 0)
}

fn pipeline_ir_block_entry_facts_copy_block_to_target(src_facts: PipelineIrBlockEntryFactList, source_block: i64, src_insts: IrInstList, target_block: i64, len_ok: i64, out_facts: PipelineIrBlockEntryFactList) -> PipelineIrBlockEntryFactAddResult {
  let mut cur = pipeline_ir_block_entry_facts_block_chain(src_facts, source_block)
  let mut facts = out_facts
  let mut changed = 0
  let mut done = 0
  while done == 0 {
    match cur {
      PipelineIrBlockEntryFactNil -> { done = 1 }
      PipelineIrBlockEntryCtorFact(block_id, value_id, ctor_hash, rest) -> {
        let added = if block_id == source_block { pipeline_ir_block_entry_facts_add_ctor(facts, target_block, value_id, ctor_hash) } else { pipeline_ir_block_entry_fact_add_result(facts, 0) }
        facts = pipeline_ir_block_entry_fact_add_result_facts(added)
        if pipeline_ir_block_entry_fact_add_result_changed(added) == 1 { changed = 1 } else { 0 }
        cur = rest
      }
      PipelineIrBlockEntryNotCtorFact(block_id, value_id, ctor_hash, rest) -> {
        let added = if block_id == source_block { pipeline_ir_block_entry_facts_add_not_ctor(facts, target_block, value_id, ctor_hash) } else { pipeline_ir_block_entry_fact_add_result(facts, 0) }
        facts = pipeline_ir_block_entry_fact_add_result_facts(added)
        if pipeline_ir_block_entry_fact_add_result_changed(added) == 1 { changed = 1 } else { 0 }
        cur = rest
      }
      PipelineIrBlockEntryScalarFact(block_id, value_id, kind, value, rest) -> {
        let added = if block_id == source_block { pipeline_ir_block_entry_facts_add_scalar(facts, target_block, value_id, kind, value) } else { pipeline_ir_block_entry_fact_add_result(facts, 0) }
        facts = pipeline_ir_block_entry_fact_add_result_facts(added)
        if pipeline_ir_block_entry_fact_add_result_changed(added) == 1 { changed = 1 } else { 0 }
        cur = rest
      }
      PipelineIrBlockEntrySlotScalarFact(block_id, slot_id, kind, value, rest) -> {
        -- A store to the slot inside the source block invalidates its
        -- entry fact for successors.
        let added = if block_id == source_block and pipeline_ir_insts_store_slot_after(src_insts, slot_id, 0 - 1, 0) == 0 { pipeline_ir_block_entry_facts_add_slot_scalar(facts, target_block, slot_id, kind, value) } else { pipeline_ir_block_entry_fact_add_result(facts, 0) }
        facts = pipeline_ir_block_entry_fact_add_result_facts(added)
        if pipeline_ir_block_entry_fact_add_result_changed(added) == 1 { changed = 1 } else { 0 }
        cur = rest
      }
      PipelineIrBlockEntryVectorLenFact(block_id, len_value, vec_value, rest) -> {
        let added = if block_id == source_block and len_ok == 1 { pipeline_ir_block_entry_facts_add_vector_len(facts, target_block, len_value, vec_value) } else { pipeline_ir_block_entry_fact_add_result(facts, 0) }
        facts = pipeline_ir_block_entry_fact_add_result_facts(added)
        if pipeline_ir_block_entry_fact_add_result_changed(added) == 1 { changed = 1 } else { 0 }
        cur = rest
      }
      PipelineIrBlockEntryVectorUpperFact(block_id, vec_value, index_value, rest) -> {
        let added = if block_id == source_block and len_ok == 1 { pipeline_ir_block_entry_facts_add_vector_upper(facts, target_block, vec_value, index_value) } else { pipeline_ir_block_entry_fact_add_result(facts, 0) }
        facts = pipeline_ir_block_entry_fact_add_result_facts(added)
        if pipeline_ir_block_entry_fact_add_result_changed(added) == 1 { changed = 1 } else { 0 }
        cur = rest
      }
      PipelineIrBlockEntryVectorSlotUpperFact(block_id, vec_value, slot_id, rest) -> {
        let added = if block_id == source_block and len_ok == 1 and pipeline_ir_insts_store_slot_after(src_insts, slot_id, 0 - 1, 0) == 0 { pipeline_ir_block_entry_facts_add_vector_slot_upper(facts, target_block, vec_value, slot_id) } else { pipeline_ir_block_entry_fact_add_result(facts, 0) }
        facts = pipeline_ir_block_entry_fact_add_result_facts(added)
        if pipeline_ir_block_entry_fact_add_result_changed(added) == 1 { changed = 1 } else { 0 }
        cur = rest
      }
      PipelineIrBlockEntryVectorSlotRowUpperFact(block_id, vec_value, row_width, slot_id, rest) -> {
        let added = if block_id == source_block and len_ok == 1 and pipeline_ir_insts_store_slot_after(src_insts, slot_id, 0 - 1, 0) == 0 { pipeline_ir_block_entry_facts_add_vector_slot_row_upper(facts, target_block, vec_value, row_width, slot_id) } else { pipeline_ir_block_entry_fact_add_result(facts, 0) }
        facts = pipeline_ir_block_entry_fact_add_result_facts(added)
        if pipeline_ir_block_entry_fact_add_result_changed(added) == 1 { changed = 1 } else { 0 }
        cur = rest
      }
      PipelineIrBlockEntryVectorRowUpperFact(block_id, vec_value, row_width, value_id, rest) -> {
        let added = if block_id == source_block and len_ok == 1 { pipeline_ir_block_entry_facts_add_vector_row_upper(facts, target_block, vec_value, row_width, value_id) } else { pipeline_ir_block_entry_fact_add_result(facts, 0) }
        facts = pipeline_ir_block_entry_fact_add_result_facts(added)
        if pipeline_ir_block_entry_fact_add_result_changed(added) == 1 { changed = 1 } else { 0 }
        cur = rest
      }
      PipelineIrBlockEntryVariantOriginFact(block_id, value_id, ctor_hash, payloads, rest) -> {
        let added = if block_id == source_block { pipeline_ir_block_entry_facts_add_variant_origin(facts, target_block, value_id, ctor_hash, payloads) } else { pipeline_ir_block_entry_fact_add_result(facts, 0) }
        facts = pipeline_ir_block_entry_fact_add_result_facts(added)
        if pipeline_ir_block_entry_fact_add_result_changed(added) == 1 { changed = 1 } else { 0 }
        cur = rest
      }
    }
  }
  pipeline_ir_block_entry_fact_add_result(facts, changed)
}

fn pipeline_ir_block_entry_facts_translate_block_to_target(src_facts: PipelineIrBlockEntryFactList, source_block: i64, target_block: i64, params: IrValueList, args: IrValueList, len_ok: i64, out_facts: PipelineIrBlockEntryFactList) -> PipelineIrBlockEntryFactAddResult {
  let mut cur = pipeline_ir_block_entry_facts_block_chain(src_facts, source_block)
  let mut facts = out_facts
  let mut changed = 0
  let mut done = 0
  while done == 0 {
    match cur {
      PipelineIrBlockEntryFactNil -> { done = 1 }
      PipelineIrBlockEntryCtorFact(block_id, value_id, ctor_hash, rest) -> {
        let added = if block_id == source_block { pipeline_ir_block_entry_facts_add_ctor_for_matching_params(params, args, facts, target_block, value_id, ctor_hash) } else { pipeline_ir_block_entry_fact_add_result(facts, 0) }
        facts = pipeline_ir_block_entry_fact_add_result_facts(added)
        if pipeline_ir_block_entry_fact_add_result_changed(added) == 1 { changed = 1 } else { 0 }
        cur = rest
      }
      PipelineIrBlockEntryNotCtorFact(block_id, value_id, ctor_hash, rest) -> {
        let added = if block_id == source_block { pipeline_ir_block_entry_facts_add_not_ctor_for_matching_params(params, args, facts, target_block, value_id, ctor_hash) } else { pipeline_ir_block_entry_fact_add_result(facts, 0) }
        facts = pipeline_ir_block_entry_fact_add_result_facts(added)
        if pipeline_ir_block_entry_fact_add_result_changed(added) == 1 { changed = 1 } else { 0 }
        cur = rest
      }
      PipelineIrBlockEntryScalarFact(block_id, value_id, kind, value, rest) -> {
        let added = if block_id == source_block { pipeline_ir_block_entry_facts_add_scalar_for_matching_params(params, args, facts, target_block, value_id, kind, value) } else { pipeline_ir_block_entry_fact_add_result(facts, 0) }
        facts = pipeline_ir_block_entry_fact_add_result_facts(added)
        if pipeline_ir_block_entry_fact_add_result_changed(added) == 1 { changed = 1 } else { 0 }
        cur = rest
      }
      PipelineIrBlockEntrySlotScalarFact(block_id, slot_id, kind, value, rest) -> {
        cur = rest
      }
      PipelineIrBlockEntryVectorLenFact(block_id, len_value, vec_value, rest) -> {
        let added = if block_id == source_block and len_ok == 1 {
          let translated_len = pipeline_ir_edge_translate_value(params, args, len_value)
          let translated_vec = pipeline_ir_edge_translate_value(params, args, vec_value)
          pipeline_ir_block_entry_facts_add_vector_len(facts, target_block, translated_len, translated_vec)
        } else {
          pipeline_ir_block_entry_fact_add_result(facts, 0)
        }
        facts = pipeline_ir_block_entry_fact_add_result_facts(added)
        if pipeline_ir_block_entry_fact_add_result_changed(added) == 1 { changed = 1 } else { 0 }
        cur = rest
      }
      PipelineIrBlockEntryVectorUpperFact(block_id, vec_value, index_value, rest) -> {
        let added = if block_id == source_block and len_ok == 1 {
          let translated_vec = pipeline_ir_edge_translate_value(params, args, vec_value)
          let translated_index = pipeline_ir_edge_translate_value(params, args, index_value)
          pipeline_ir_block_entry_facts_add_vector_upper(facts, target_block, translated_vec, translated_index)
        } else {
          pipeline_ir_block_entry_fact_add_result(facts, 0)
        }
        facts = pipeline_ir_block_entry_fact_add_result_facts(added)
        if pipeline_ir_block_entry_fact_add_result_changed(added) == 1 { changed = 1 } else { 0 }
        cur = rest
      }
      PipelineIrBlockEntryVectorSlotUpperFact(block_id, vec_value, slot_id, rest) -> {
        cur = rest
      }
      PipelineIrBlockEntryVectorSlotRowUpperFact(block_id, vec_value, row_width, slot_id, rest) -> {
        cur = rest
      }
      PipelineIrBlockEntryVectorRowUpperFact(block_id, vec_value, row_width, value_id, rest) -> {
        cur = rest
      }
      PipelineIrBlockEntryVariantOriginFact(block_id, value_id, ctor_hash, payloads, rest) -> {
        let added = if block_id == source_block { pipeline_ir_block_entry_facts_add_variant_origin_for_matching_params(params, args, facts, target_block, value_id, ctor_hash, payloads) } else { pipeline_ir_block_entry_fact_add_result(facts, 0) }
        facts = pipeline_ir_block_entry_fact_add_result_facts(added)
        if pipeline_ir_block_entry_fact_add_result_changed(added) == 1 { changed = 1 } else { 0 }
        cur = rest
      }
    }
  }
  pipeline_ir_block_entry_fact_add_result(facts, changed)
}

fn pipeline_ir_block_entry_facts_add_inst_origins_to_target(insts: IrInstList, target_block: i64, len_ok: i64, out_facts: PipelineIrBlockEntryFactList) -> PipelineIrBlockEntryFactAddResult {
  match insts {
    IrInstNil -> pipeline_ir_block_entry_fact_add_result(out_facts, 0)
    IrInstCons(inst, rest) -> {
      let head = match inst {
        IrVariantInitI64(dst, tag_hash, payloads, field_mask) -> pipeline_ir_block_entry_facts_add_variant_origin(out_facts, target_block, dst, tag_hash, payloads)
        IrCallI64(dst, callee_hash, args) -> {
          if len_ok == 1 and callee_hash == pipeline_ir_vector_len_hash() and ir_value_list_len(args) == 1 {
            let vec = pipeline_ir_value_list_get_or(args, 0, 0 - 1)
            if vec >= 0 { pipeline_ir_block_entry_facts_add_vector_len(out_facts, target_block, dst, vec) }
            else { pipeline_ir_block_entry_fact_add_result(out_facts, 0) }
          } else {
            pipeline_ir_block_entry_fact_add_result(out_facts, 0)
          }
        }
        _ -> pipeline_ir_block_entry_fact_add_result(out_facts, 0)
      }
      let tail = pipeline_ir_block_entry_facts_add_inst_origins_to_target(rest, target_block, len_ok, pipeline_ir_block_entry_fact_add_result_facts(head))
      let changed = if pipeline_ir_block_entry_fact_add_result_changed(head) == 1 or pipeline_ir_block_entry_fact_add_result_changed(tail) == 1 { 1 } else { 0 }
      pipeline_ir_block_entry_fact_add_result(pipeline_ir_block_entry_fact_add_result_facts(tail), changed)
    }
  }
}

fn pipeline_ir_block_entry_facts_add_translated_inst_origins_to_target(insts: IrInstList, params: IrValueList, args: IrValueList, target_block: i64, len_ok: i64, out_facts: PipelineIrBlockEntryFactList) -> PipelineIrBlockEntryFactAddResult {
  match insts {
    IrInstNil -> pipeline_ir_block_entry_fact_add_result(out_facts, 0)
    IrInstCons(inst, rest) -> {
      let head = match inst {
        IrVariantInitI64(dst, tag_hash, payloads, field_mask) -> pipeline_ir_block_entry_facts_add_variant_origin_for_matching_params(params, args, out_facts, target_block, dst, tag_hash, payloads)
        IrCallI64(dst, callee_hash, call_args) -> {
          if len_ok == 1 and callee_hash == pipeline_ir_vector_len_hash() and ir_value_list_len(call_args) == 1 {
            let vec = pipeline_ir_value_list_get_or(call_args, 0, 0 - 1)
            let translated_dst = pipeline_ir_edge_translate_value(params, args, dst)
            let translated_vec = pipeline_ir_edge_translate_value(params, args, vec)
            if translated_dst >= 0 and translated_vec >= 0 { pipeline_ir_block_entry_facts_add_vector_len(out_facts, target_block, translated_dst, translated_vec) }
            else { pipeline_ir_block_entry_fact_add_result(out_facts, 0) }
          } else {
            pipeline_ir_block_entry_fact_add_result(out_facts, 0)
          }
        }
        _ -> pipeline_ir_block_entry_fact_add_result(out_facts, 0)
      }
      let tail = pipeline_ir_block_entry_facts_add_translated_inst_origins_to_target(rest, params, args, target_block, len_ok, pipeline_ir_block_entry_fact_add_result_facts(head))
      let changed = if pipeline_ir_block_entry_fact_add_result_changed(head) == 1 or pipeline_ir_block_entry_fact_add_result_changed(tail) == 1 { 1 } else { 0 }
      pipeline_ir_block_entry_fact_add_result(pipeline_ir_block_entry_fact_add_result_facts(tail), changed)
    }
  }
}

fn pipeline_ir_inst_list_const_def_lookup(insts: IrInstList, value: i64) -> PipelineIrConstLookup {
  match insts {
    IrInstNil -> pipeline_ir_const_lookup(0, 0)
    IrInstCons(inst, rest) -> {
      match inst {
        IrConstI64(dst, const_value) -> {
          if dst == value { pipeline_ir_const_lookup(1, const_value) }
          else { pipeline_ir_inst_list_const_def_lookup(rest, value) }
        }
        IrNilI64(dst) -> {
          if dst == value { pipeline_ir_const_lookup(1, 0) }
          else { pipeline_ir_inst_list_const_def_lookup(rest, value) }
        }
        _ -> pipeline_ir_inst_list_const_def_lookup(rest, value)
      }
    }
  }
}

fn pipeline_ir_inst_list_nil_def_lookup(insts: IrInstList, value: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      match inst {
        IrNilI64(dst) -> {
          if dst == value { 1 }
          else { pipeline_ir_inst_list_nil_def_lookup(rest, value) }
        }
        _ -> pipeline_ir_inst_list_nil_def_lookup(rest, value)
      }
    }
  }
}

fn pipeline_ir_inst_list_variant_tag_base_lookup(insts: IrInstList, value: i64) -> PipelineIrConstLookup {
  match insts {
    IrInstNil -> pipeline_ir_const_lookup(0, 0)
    IrInstCons(inst, rest) -> {
      match inst {
        IrVariantTagI64(dst, base) -> {
          if dst == value { pipeline_ir_const_lookup(1, base) }
          else { pipeline_ir_inst_list_variant_tag_base_lookup(rest, value) }
        }
        _ -> pipeline_ir_inst_list_variant_tag_base_lookup(rest, value)
      }
    }
  }
}

fn pipeline_ir_inst_list_variant_init_tag_lookup(insts: IrInstList, value: i64) -> PipelineIrConstLookup {
  match insts {
    IrInstNil -> pipeline_ir_const_lookup(0, 0)
    IrInstCons(inst, rest) -> {
      match inst {
        IrVariantInitI64(dst, tag_hash, payloads, field_mask) -> {
          if dst == value { pipeline_ir_const_lookup(1, tag_hash) }
          else { pipeline_ir_inst_list_variant_init_tag_lookup(rest, value) }
        }
        _ -> pipeline_ir_inst_list_variant_init_tag_lookup(rest, value)
      }
    }
  }
}

fn pipeline_ir_inst_list_vector_len_base_lookup(insts: IrInstList, value: i64) -> PipelineIrConstLookup {
  match insts {
    IrInstNil -> pipeline_ir_const_lookup(0, 0)
    IrInstCons(inst, rest) -> {
      match inst {
        IrCallI64(dst, callee_hash, args) -> {
          if dst == value and callee_hash == pipeline_ir_vector_len_hash() and ir_value_list_len(args) == 1 {
            let vec = pipeline_ir_value_list_get_or(args, 0, 0 - 1)
            if vec >= 0 { pipeline_ir_const_lookup(1, vec) } else { pipeline_ir_const_lookup(0, 0) }
          } else {
            pipeline_ir_inst_list_vector_len_base_lookup(rest, value)
          }
        }
        _ -> pipeline_ir_inst_list_vector_len_base_lookup(rest, value)
      }
    }
  }
}

fn pipeline_ir_inst_list_load_slot_lookup(insts: IrInstList, value: i64) -> PipelineIrConstLookup {
  match insts {
    IrInstNil -> pipeline_ir_const_lookup(0, 0)
    IrInstCons(inst, rest) -> {
      match inst {
        IrLoadI64(dst, slot_id) -> {
          if dst == value { pipeline_ir_const_lookup(1, slot_id) }
          else { pipeline_ir_inst_list_load_slot_lookup(rest, value) }
        }
        _ -> pipeline_ir_inst_list_load_slot_lookup(rest, value)
      }
    }
  }
}

fn pipeline_ir_vector_len_base_lookup(insts: IrInstList, facts: PipelineIrBlockEntryFactList, block_id: i64, value: i64) -> PipelineIrConstLookup {
  let local = pipeline_ir_inst_list_vector_len_base_lookup(insts, value)
  if pipeline_ir_const_lookup_valid(local) == 1 {
    local
  } else {
    pipeline_ir_block_entry_vector_len_fact_lookup(facts, block_id, value)
  }
}

fn pipeline_ir_ctor_fact_lookup(valid: i64, value_id: i64, ctor_hash: i64) -> i64 {
  node_new(0, valid, value_id, ctor_hash, 0)
}

fn pipeline_ir_ctor_fact_lookup_valid(found: i64) -> i64 {
  node_f1(found)
}

fn pipeline_ir_ctor_fact_lookup_value(found: i64) -> i64 {
  node_f2(found)
}

fn pipeline_ir_ctor_fact_lookup_hash(found: i64) -> i64 {
  node_f3(found)
}

fn pipeline_ir_zero_fact_lookup(valid: i64, value_id: i64, is_zero: i64) -> i64 {
  node_new(0, valid, value_id, is_zero, 0)
}

fn pipeline_ir_zero_fact_lookup_valid(found: i64) -> i64 {
  node_f1(found)
}

fn pipeline_ir_zero_fact_lookup_value(found: i64) -> i64 {
  node_f2(found)
}

fn pipeline_ir_zero_fact_lookup_is_zero(found: i64) -> i64 {
  node_f3(found)
}

fn pipeline_ir_nil_fact_lookup(valid: i64, value_id: i64, is_nil: i64) -> i64 {
  node_new(0, valid, value_id, is_nil, 0)
}

fn pipeline_ir_nil_fact_lookup_valid(found: i64) -> i64 {
  node_f1(found)
}

fn pipeline_ir_nil_fact_lookup_value(found: i64) -> i64 {
  node_f2(found)
}

fn pipeline_ir_nil_fact_lookup_is_nil(found: i64) -> i64 {
  node_f3(found)
}

fn pipeline_ir_nonnegative_fact_lookup(valid: i64, value_id: i64, is_nonnegative: i64) -> i64 {
  node_new(0, valid, value_id, is_nonnegative, 0)
}

fn pipeline_ir_nonnegative_fact_lookup_valid(found: i64) -> i64 {
  node_f1(found)
}

fn pipeline_ir_nonnegative_fact_lookup_value(found: i64) -> i64 {
  node_f2(found)
}

fn pipeline_ir_nonnegative_fact_lookup_is_nonnegative(found: i64) -> i64 {
  node_f3(found)
}

fn pipeline_ir_vector_upper_fact_lookup(valid: i64, vec_value: i64, index_value: i64) -> i64 {
  node_new(0, valid, vec_value, index_value, 0)
}

fn pipeline_ir_vector_upper_fact_lookup_valid(found: i64) -> bool {
  node_f1(found) == 1
}

fn pipeline_ir_vector_upper_fact_lookup_vec(found: i64) -> i64 {
  node_f2(found)
}

fn pipeline_ir_vector_upper_fact_lookup_index(found: i64) -> i64 {
  node_f3(found)
}

fn pipeline_ir_inst_list_ctor_eq_fact_from_operands(insts: IrInstList, lhs: i64, rhs: i64) -> i64 {
  let left_tag = pipeline_ir_inst_list_variant_tag_base_lookup(insts, lhs)
  let right_const = pipeline_ir_inst_list_const_def_lookup(insts, rhs)
  if pipeline_ir_const_lookup_valid(left_tag) == 1 and pipeline_ir_const_lookup_valid(right_const) == 1 {
    pipeline_ir_ctor_fact_lookup(1, pipeline_ir_const_lookup_value(left_tag), pipeline_ir_const_lookup_value(right_const))
  } else {
    let right_tag = pipeline_ir_inst_list_variant_tag_base_lookup(insts, rhs)
    let left_const = pipeline_ir_inst_list_const_def_lookup(insts, lhs)
    if pipeline_ir_const_lookup_valid(right_tag) == 1 and pipeline_ir_const_lookup_valid(left_const) == 1 {
      pipeline_ir_ctor_fact_lookup(1, pipeline_ir_const_lookup_value(right_tag), pipeline_ir_const_lookup_value(left_const))
    } else {
      pipeline_ir_ctor_fact_lookup(0, 0, 0)
    }
  }
}


-- Table-first operand lookups: consult the value-definition table
-- (any dominating block), then fall back to the branch block's insts.
fn pipeline_ir_table_const_lookup(table: i64, insts: IrInstList, value: i64) -> PipelineIrConstLookup {
  let def = pipeline_ir_value_def_lookup(table, value)
  if def != 0 and node_f1(def) == 1 {
    pipeline_ir_const_lookup(1, node_f2(def))
  } else {
    pipeline_ir_inst_list_const_def_lookup(insts, value)
  }
}

-- Fixed-array lengths may be materialised independently in a guard and an
-- access block. Canonical negative keys make equal constants meet while all
-- dynamic lengths retain their exact SSA identity. -1 remains available as a
-- general sentinel, so constant zero begins at -2.
fn pipeline_ir_indexed_length_key(value: i64, known: PipelineIrConstLookup) -> i64 {
  if pipeline_ir_const_lookup_valid(known) == 1 and pipeline_ir_const_lookup_value(known) >= 0 and pipeline_ir_const_lookup_value(known) <= 9223372036854775805 {
    0 - pipeline_ir_const_lookup_value(known) - 2
  } else {
    value
  }
}

fn pipeline_ir_table_indexed_length_key(table: i64, insts: IrInstList, value: i64) -> i64 {
  pipeline_ir_indexed_length_key(value, pipeline_ir_table_const_lookup(table, insts, value))
}

fn pipeline_ir_table_nil_lookup(table: i64, insts: IrInstList, value: i64) -> i64 {
  let def = pipeline_ir_value_def_lookup(table, value)
  if def != 0 and node_f1(def) == 2 { 1 }
  else { pipeline_ir_inst_list_nil_def_lookup(insts, value) }
}

fn pipeline_ir_table_zero_cmp_fact(table: i64, insts: IrInstList, lhs: i64, rhs: i64, is_zero: i64) -> i64 {
  let left_const = pipeline_ir_table_const_lookup(table, insts, lhs)
  if pipeline_ir_const_lookup_valid(left_const) == 1 and pipeline_ir_const_lookup_value(left_const) == 0 {
    pipeline_ir_zero_fact_lookup(1, rhs, is_zero)
  } else {
    let right_const = pipeline_ir_table_const_lookup(table, insts, rhs)
    if pipeline_ir_const_lookup_valid(right_const) == 1 and pipeline_ir_const_lookup_value(right_const) == 0 {
      pipeline_ir_zero_fact_lookup(1, lhs, is_zero)
    } else {
      pipeline_ir_zero_fact_lookup(0, 0, 0)
    }
  }
}

fn pipeline_ir_table_nil_cmp_fact(table: i64, insts: IrInstList, lhs: i64, rhs: i64, is_nil: i64) -> i64 {
  if pipeline_ir_table_nil_lookup(table, insts, lhs) == 1 {
    pipeline_ir_nil_fact_lookup(1, rhs, is_nil)
  } else {
    if pipeline_ir_table_nil_lookup(table, insts, rhs) == 1 {
      pipeline_ir_nil_fact_lookup(1, lhs, is_nil)
    } else {
      pipeline_ir_nil_fact_lookup(0, 0, 0)
    }
  }
}

fn pipeline_ir_table_nonnegative_cmp_fact(table: i64, insts: IrInstList, code: i64, lhs: i64, rhs: i64, branch_truth: i64) -> i64 {
  let right_const = pipeline_ir_table_const_lookup(table, insts, rhs)
  if pipeline_ir_const_lookup_valid(right_const) == 1 and pipeline_ir_const_lookup_value(right_const) == 0 {
    if code == 6 { pipeline_ir_nonnegative_fact_lookup(1, lhs, branch_truth) }
    else { if code == 3 { pipeline_ir_nonnegative_fact_lookup(1, lhs, if branch_truth == 1 { 0 } else { 1 }) }
    else { pipeline_ir_nonnegative_fact_lookup(0, 0, 0) } }
  } else {
    let left_const = pipeline_ir_table_const_lookup(table, insts, lhs)
    if pipeline_ir_const_lookup_valid(left_const) == 1 and pipeline_ir_const_lookup_value(left_const) == 0 {
      if code == 5 { pipeline_ir_nonnegative_fact_lookup(1, rhs, branch_truth) }
      else { if code == 4 { pipeline_ir_nonnegative_fact_lookup(1, rhs, if branch_truth == 1 { 0 } else { 1 }) }
      else { pipeline_ir_nonnegative_fact_lookup(0, 0, 0) } }
    } else {
      pipeline_ir_nonnegative_fact_lookup(0, 0, 0)
    }
  }
}

fn pipeline_ir_table_len_lookup(cfg: i64, insts: IrInstList, facts: PipelineIrBlockEntryFactList, block_id: i64, value: i64) -> PipelineIrConstLookup {
  let def = pipeline_ir_value_def_lookup(pipeline_ir_cfg_bundle_def_table(cfg), value)
  if pipeline_ir_cfg_bundle_len_stable(cfg) == 1 and def != 0 and node_f1(def) == 4 {
    pipeline_ir_const_lookup(1, node_f2(def))
  } else {
    pipeline_ir_vector_len_base_lookup(insts, facts, block_id, value)
  }
}

-- Resolve a value to a quotient of a vector length: def(q) = div(L, W)
-- with W a const width >= 1 and L a length of some vector. Returns
-- node(0, valid, vec, width, 0).
fn pipeline_ir_table_row_len_lookup(cfg: i64, insts: IrInstList, facts: PipelineIrBlockEntryFactList, block_id: i64, value: i64) -> i64 {
  let def = pipeline_ir_value_def_lookup(pipeline_ir_cfg_bundle_def_table(cfg), value)
  if def != 0 and node_f1(def) == 9 {
    let w_def = pipeline_ir_value_def_lookup(pipeline_ir_cfg_bundle_def_table(cfg), node_f4(def))
    if w_def != 0 and node_f1(w_def) == 1 and node_f2(w_def) >= 1 and node_f2(w_def) <= 4095 {
      let len_found = pipeline_ir_table_len_lookup(cfg, insts, facts, block_id, node_f3(def))
      if pipeline_ir_const_lookup_valid(len_found) == 1 {
        node_new(0, 1, pipeline_ir_const_lookup_value(len_found), node_f2(w_def), 0)
      } else { node_new(0, 0, 0, 0, 0) }
    } else { node_new(0, 0, 0, 0, 0) }
  } else { node_new(0, 0, 0, 0, 0) }
}

-- Strict row-bound compare: x < len(vec)/w on the appropriate edge.
-- Only the four strict polarities are admitted — a non-strict bound
-- (x <= len/w) does NOT imply x*w + f < len. Returns
-- node(0, valid, vec, width, index_value).
fn pipeline_ir_table_vector_row_upper_cmp_fact(cfg: i64, insts: IrInstList, facts: PipelineIrBlockEntryFactList, block_id: i64, code: i64, lhs: i64, rhs: i64, branch_truth: i64) -> i64 {
  let right_row = pipeline_ir_table_row_len_lookup(cfg, insts, facts, block_id, rhs)
  if node_f1(right_row) == 1 {
    if (code == 3 and branch_truth == 1) or (code == 6 and branch_truth == 0) {
      node_new(0, 1, node_f2(right_row), node_f3(right_row), lhs)
    } else { node_new(0, 0, 0, 0, 0) }
  } else {
    let left_row = pipeline_ir_table_row_len_lookup(cfg, insts, facts, block_id, lhs)
    if node_f1(left_row) == 1 {
      if (code == 4 and branch_truth == 1) or (code == 5 and branch_truth == 0) {
        node_new(0, 1, node_f2(left_row), node_f3(left_row), rhs)
      } else { node_new(0, 0, 0, 0, 0) }
    } else { node_new(0, 0, 0, 0, 0) }
  }
}

fn pipeline_ir_inst_list_branch_vector_row_upper_fact(insts: IrInstList, cfg: i64, facts: PipelineIrBlockEntryFactList, block_id: i64, cond: i64, branch_truth: i64) -> i64 {
  let def = pipeline_ir_value_def_lookup(pipeline_ir_cfg_bundle_def_table(cfg), cond)
  if def != 0 and node_f1(def) == 3 {
    pipeline_ir_table_vector_row_upper_cmp_fact(cfg, insts, facts, block_id, node_f2(def), node_f3(def), node_f4(def), branch_truth)
  } else {
    node_new(0, 0, 0, 0, 0)
  }
}

fn pipeline_ir_table_vector_upper_cmp_fact(cfg: i64, insts: IrInstList, facts: PipelineIrBlockEntryFactList, block_id: i64, code: i64, lhs: i64, rhs: i64, branch_truth: i64) -> i64 {
  let right_len = pipeline_ir_table_len_lookup(cfg, insts, facts, block_id, rhs)
  if pipeline_ir_const_lookup_valid(right_len) == 1 {
    if code == 3 and branch_truth == 1 { pipeline_ir_vector_upper_fact_lookup(1, pipeline_ir_const_lookup_value(right_len), lhs) }
    else { if code == 6 and branch_truth == 0 { pipeline_ir_vector_upper_fact_lookup(1, pipeline_ir_const_lookup_value(right_len), lhs) }
    else { pipeline_ir_vector_upper_fact_lookup(0, 0, 0) } }
  } else {
    let left_len = pipeline_ir_table_len_lookup(cfg, insts, facts, block_id, lhs)
    if pipeline_ir_const_lookup_valid(left_len) == 1 {
      if code == 4 and branch_truth == 1 { pipeline_ir_vector_upper_fact_lookup(1, pipeline_ir_const_lookup_value(left_len), rhs) }
      else { if code == 5 and branch_truth == 0 { pipeline_ir_vector_upper_fact_lookup(1, pipeline_ir_const_lookup_value(left_len), rhs) }
      else { pipeline_ir_vector_upper_fact_lookup(0, 0, 0) } }
    } else {
      pipeline_ir_vector_upper_fact_lookup(0, 0, 0)
    }
  }
}

fn pipeline_ir_inst_list_branch_ctor_fact_inner(scan: IrInstList, all_insts: IrInstList, cond: i64) -> i64 {
  match scan {
    IrInstNil -> pipeline_ir_ctor_fact_lookup(0, 0, 0)
    IrInstCons(inst, rest) -> {
      match inst {
        IrBinaryI64(dst, op, lhs, rhs) -> {
          if dst == cond {
            match op {
              IrEq -> pipeline_ir_inst_list_ctor_eq_fact_from_operands(all_insts, lhs, rhs)
              _ -> pipeline_ir_ctor_fact_lookup(0, 0, 0)
            }
          } else {
            pipeline_ir_inst_list_branch_ctor_fact_inner(rest, all_insts, cond)
          }
        }
        _ -> pipeline_ir_inst_list_branch_ctor_fact_inner(rest, all_insts, cond)
      }
    }
  }
}

fn pipeline_ir_inst_list_branch_ctor_fact(insts: IrInstList, cfg: i64, cond: i64) -> i64 {
  let def = pipeline_ir_value_def_lookup(pipeline_ir_cfg_bundle_def_table(cfg), cond)
  if def != 0 and node_f1(def) == 3 and node_f2(def) == 1 {
    pipeline_ir_inst_list_ctor_eq_fact_from_operands(insts, node_f3(def), node_f4(def))
  } else {
    pipeline_ir_inst_list_branch_ctor_fact_inner(insts, insts, cond)
  }
}

fn pipeline_ir_inst_list_zero_cmp_fact_from_operands(insts: IrInstList, lhs: i64, rhs: i64, is_zero: i64) -> i64 {
  let left_const = pipeline_ir_inst_list_const_def_lookup(insts, lhs)
  if pipeline_ir_const_lookup_valid(left_const) == 1 and pipeline_ir_const_lookup_value(left_const) == 0 {
    pipeline_ir_zero_fact_lookup(1, rhs, is_zero)
  } else {
    let right_const = pipeline_ir_inst_list_const_def_lookup(insts, rhs)
    if pipeline_ir_const_lookup_valid(right_const) == 1 and pipeline_ir_const_lookup_value(right_const) == 0 {
      pipeline_ir_zero_fact_lookup(1, lhs, is_zero)
    } else {
      pipeline_ir_zero_fact_lookup(0, 0, 0)
    }
  }
}

fn pipeline_ir_inst_list_nil_cmp_fact_from_operands(insts: IrInstList, lhs: i64, rhs: i64, is_nil: i64) -> i64 {
  if pipeline_ir_inst_list_nil_def_lookup(insts, lhs) == 1 {
    pipeline_ir_nil_fact_lookup(1, rhs, is_nil)
  } else {
    if pipeline_ir_inst_list_nil_def_lookup(insts, rhs) == 1 {
      pipeline_ir_nil_fact_lookup(1, lhs, is_nil)
    } else {
      pipeline_ir_nil_fact_lookup(0, 0, 0)
    }
  }
}

fn pipeline_ir_inst_list_branch_zero_fact_inner(scan: IrInstList, all_insts: IrInstList, cond: i64, branch_truth: i64) -> i64 {
  match scan {
    IrInstNil -> pipeline_ir_zero_fact_lookup(0, 0, 0)
    IrInstCons(inst, rest) -> {
      match inst {
        IrBinaryI64(dst, op, lhs, rhs) -> {
          if dst == cond {
            match op {
              IrEq -> pipeline_ir_inst_list_zero_cmp_fact_from_operands(all_insts, lhs, rhs, branch_truth)
              IrNe -> pipeline_ir_inst_list_zero_cmp_fact_from_operands(all_insts, lhs, rhs, if branch_truth == 1 { 0 } else { 1 })
              _ -> pipeline_ir_zero_fact_lookup(0, 0, 0)
            }
          } else {
            pipeline_ir_inst_list_branch_zero_fact_inner(rest, all_insts, cond, branch_truth)
          }
        }
        _ -> pipeline_ir_inst_list_branch_zero_fact_inner(rest, all_insts, cond, branch_truth)
      }
    }
  }
}

fn pipeline_ir_inst_list_branch_zero_fact(insts: IrInstList, cfg: i64, cond: i64, branch_truth: i64) -> i64 {
  let def = pipeline_ir_value_def_lookup(pipeline_ir_cfg_bundle_def_table(cfg), cond)
  if def != 0 and node_f1(def) == 3 and (node_f2(def) == 1 or node_f2(def) == 2) {
    let truth = if node_f2(def) == 1 { branch_truth } else { if branch_truth == 1 { 0 } else { 1 } }
    pipeline_ir_table_zero_cmp_fact(pipeline_ir_cfg_bundle_def_table(cfg), insts, node_f3(def), node_f4(def), truth)
  } else {
    pipeline_ir_inst_list_branch_zero_fact_inner(insts, insts, cond, branch_truth)
  }
}

fn pipeline_ir_inst_list_branch_nil_fact_inner(scan: IrInstList, all_insts: IrInstList, cond: i64, branch_truth: i64) -> i64 {
  match scan {
    IrInstNil -> pipeline_ir_nil_fact_lookup(0, 0, 0)
    IrInstCons(inst, rest) -> {
      match inst {
        IrBinaryI64(dst, op, lhs, rhs) -> {
          if dst == cond {
            match op {
              IrEq -> pipeline_ir_inst_list_nil_cmp_fact_from_operands(all_insts, lhs, rhs, branch_truth)
              IrNe -> pipeline_ir_inst_list_nil_cmp_fact_from_operands(all_insts, lhs, rhs, if branch_truth == 1 { 0 } else { 1 })
              _ -> pipeline_ir_nil_fact_lookup(0, 0, 0)
            }
          } else {
            pipeline_ir_inst_list_branch_nil_fact_inner(rest, all_insts, cond, branch_truth)
          }
        }
        _ -> pipeline_ir_inst_list_branch_nil_fact_inner(rest, all_insts, cond, branch_truth)
      }
    }
  }
}

fn pipeline_ir_inst_list_branch_nil_fact(insts: IrInstList, cfg: i64, cond: i64, branch_truth: i64) -> i64 {
  let def = pipeline_ir_value_def_lookup(pipeline_ir_cfg_bundle_def_table(cfg), cond)
  if def != 0 and node_f1(def) == 3 and (node_f2(def) == 1 or node_f2(def) == 2) {
    let truth = if node_f2(def) == 1 { branch_truth } else { if branch_truth == 1 { 0 } else { 1 } }
    pipeline_ir_table_nil_cmp_fact(pipeline_ir_cfg_bundle_def_table(cfg), insts, node_f3(def), node_f4(def), truth)
  } else {
    pipeline_ir_inst_list_branch_nil_fact_inner(insts, insts, cond, branch_truth)
  }
}

fn pipeline_ir_inst_list_nonnegative_cmp_fact_from_operands(insts: IrInstList, op: IrBinaryOp, lhs: i64, rhs: i64, branch_truth: i64) -> i64 {
  let right_const = pipeline_ir_inst_list_const_def_lookup(insts, rhs)
  if pipeline_ir_const_lookup_valid(right_const) == 1 and pipeline_ir_const_lookup_value(right_const) == 0 {
    match op {
      IrGe -> pipeline_ir_nonnegative_fact_lookup(1, lhs, branch_truth)
      IrLt -> pipeline_ir_nonnegative_fact_lookup(1, lhs, if branch_truth == 1 { 0 } else { 1 })
      _ -> pipeline_ir_nonnegative_fact_lookup(0, 0, 0)
    }
  } else {
    let left_const = pipeline_ir_inst_list_const_def_lookup(insts, lhs)
    if pipeline_ir_const_lookup_valid(left_const) == 1 and pipeline_ir_const_lookup_value(left_const) == 0 {
      match op {
        IrLe -> pipeline_ir_nonnegative_fact_lookup(1, rhs, branch_truth)
        IrGt -> pipeline_ir_nonnegative_fact_lookup(1, rhs, if branch_truth == 1 { 0 } else { 1 })
        _ -> pipeline_ir_nonnegative_fact_lookup(0, 0, 0)
      }
    } else {
      pipeline_ir_nonnegative_fact_lookup(0, 0, 0)
    }
  }
}

fn pipeline_ir_inst_list_branch_nonnegative_fact_inner(scan: IrInstList, all_insts: IrInstList, cond: i64, branch_truth: i64) -> i64 {
  match scan {
    IrInstNil -> pipeline_ir_nonnegative_fact_lookup(0, 0, 0)
    IrInstCons(inst, rest) -> {
      match inst {
        IrBinaryI64(dst, op, lhs, rhs) -> {
          if dst == cond {
            pipeline_ir_inst_list_nonnegative_cmp_fact_from_operands(all_insts, op, lhs, rhs, branch_truth)
          } else {
            pipeline_ir_inst_list_branch_nonnegative_fact_inner(rest, all_insts, cond, branch_truth)
          }
        }
        _ -> pipeline_ir_inst_list_branch_nonnegative_fact_inner(rest, all_insts, cond, branch_truth)
      }
    }
  }
}

fn pipeline_ir_inst_list_branch_nonnegative_fact(insts: IrInstList, cfg: i64, cond: i64, branch_truth: i64) -> i64 {
  let def = pipeline_ir_value_def_lookup(pipeline_ir_cfg_bundle_def_table(cfg), cond)
  if def != 0 and node_f1(def) == 3 {
    pipeline_ir_table_nonnegative_cmp_fact(pipeline_ir_cfg_bundle_def_table(cfg), insts, node_f2(def), node_f3(def), node_f4(def), branch_truth)
  } else {
    pipeline_ir_inst_list_branch_nonnegative_fact_inner(insts, insts, cond, branch_truth)
  }
}

-- node(0, valid, index SSA, indexed-length key, 0). Strict comparisons are
-- sufficient on the selected edge: i < len, !(i >= len), len > i, and
-- !(len <= i). Typed integer comparisons enter the same definition table as
-- legacy i64 comparisons, so this producer is storage-generic.
fn pipeline_ir_table_indexed_upper_cmp_fact(table: i64, insts: IrInstList, code: i64, lhs: i64, rhs: i64, branch_truth: i64) -> i64 {
  let index_value = if code == 3 and branch_truth == 1 { lhs }
    else { if code == 6 and branch_truth == 0 { lhs }
    else { if code == 4 and branch_truth == 1 { rhs }
    else { if code == 5 and branch_truth == 0 { rhs } else { 0 - 1 } } } }
  let length_value = if code == 3 and branch_truth == 1 { rhs }
    else { if code == 6 and branch_truth == 0 { rhs }
    else { if code == 4 and branch_truth == 1 { lhs }
    else { if code == 5 and branch_truth == 0 { lhs } else { 0 - 1 } } } }
  if index_value < 0 or length_value < 0 {
    node_new(0, 0, 0, 0, 0)
  } else {
    node_new(0, 1, index_value, pipeline_ir_table_indexed_length_key(table, insts, length_value), 0)
  }
}

fn pipeline_ir_inst_list_branch_indexed_upper_fact(insts: IrInstList, cfg: i64, cond: i64, branch_truth: i64) -> i64 {
  let table = pipeline_ir_cfg_bundle_def_table(cfg)
  let def = pipeline_ir_value_def_lookup(table, cond)
  if def != 0 and node_f1(def) == 3 {
    pipeline_ir_table_indexed_upper_cmp_fact(table, insts, node_f2(def), node_f3(def), node_f4(def), branch_truth)
  } else {
    node_new(0, 0, 0, 0, 0)
  }
}

-- node(0, valid, lower SSA, keyed upper, 0). This is the complementary
-- half of the relational edges above: lhs <= rhs and rhs <= lhs. Keeping the
-- relation non-strict lets slicing prove start <= end and end <= len without
-- making equality sufficient for an ordinary indexed access.
fn pipeline_ir_table_indexed_upper_or_equal_cmp_fact(table: i64, insts: IrInstList, code: i64, lhs: i64, rhs: i64, branch_truth: i64) -> i64 {
  let lower_value = if code == 5 and branch_truth == 1 { lhs }
    else { if code == 4 and branch_truth == 0 { lhs }
    else { if code == 6 and branch_truth == 1 { rhs }
    else { if code == 3 and branch_truth == 0 { rhs } else { 0 - 1 } } } }
  let upper_value = if code == 5 and branch_truth == 1 { rhs }
    else { if code == 4 and branch_truth == 0 { rhs }
    else { if code == 6 and branch_truth == 1 { lhs }
    else { if code == 3 and branch_truth == 0 { lhs } else { 0 - 1 } } } }
  if lower_value < 0 or upper_value < 0 {
    node_new(0, 0, 0, 0, 0)
  } else {
    node_new(0, 1, lower_value, pipeline_ir_table_indexed_length_key(table, insts, upper_value), 0)
  }
}

fn pipeline_ir_inst_list_branch_indexed_upper_or_equal_fact(insts: IrInstList, cfg: i64, cond: i64, branch_truth: i64) -> i64 {
  let table = pipeline_ir_cfg_bundle_def_table(cfg)
  let def = pipeline_ir_value_def_lookup(table, cond)
  if def != 0 and node_f1(def) == 3 {
    pipeline_ir_table_indexed_upper_or_equal_cmp_fact(table, insts, node_f2(def), node_f3(def), node_f4(def), branch_truth)
  } else {
    node_new(0, 0, 0, 0, 0)
  }
}

fn pipeline_ir_inst_list_vector_upper_cmp_fact_from_operands(insts: IrInstList, facts: PipelineIrBlockEntryFactList, block_id: i64, op: IrBinaryOp, lhs: i64, rhs: i64, branch_truth: i64) -> i64 {
  let right_len = pipeline_ir_vector_len_base_lookup(insts, facts, block_id, rhs)
  if pipeline_ir_const_lookup_valid(right_len) == 1 {
    match op {
      IrLt -> if branch_truth == 1 { pipeline_ir_vector_upper_fact_lookup(1, pipeline_ir_const_lookup_value(right_len), lhs) } else { pipeline_ir_vector_upper_fact_lookup(0, 0, 0) }
      IrGe -> if branch_truth == 0 { pipeline_ir_vector_upper_fact_lookup(1, pipeline_ir_const_lookup_value(right_len), lhs) } else { pipeline_ir_vector_upper_fact_lookup(0, 0, 0) }
      _ -> pipeline_ir_vector_upper_fact_lookup(0, 0, 0)
    }
  } else {
    let left_len = pipeline_ir_vector_len_base_lookup(insts, facts, block_id, lhs)
    if pipeline_ir_const_lookup_valid(left_len) == 1 {
      match op {
        IrGt -> if branch_truth == 1 { pipeline_ir_vector_upper_fact_lookup(1, pipeline_ir_const_lookup_value(left_len), rhs) } else { pipeline_ir_vector_upper_fact_lookup(0, 0, 0) }
        IrLe -> if branch_truth == 0 { pipeline_ir_vector_upper_fact_lookup(1, pipeline_ir_const_lookup_value(left_len), rhs) } else { pipeline_ir_vector_upper_fact_lookup(0, 0, 0) }
        _ -> pipeline_ir_vector_upper_fact_lookup(0, 0, 0)
      }
    } else {
      pipeline_ir_vector_upper_fact_lookup(0, 0, 0)
    }
  }
}

fn pipeline_ir_inst_list_branch_vector_upper_fact_inner(scan: IrInstList, all_insts: IrInstList, facts: PipelineIrBlockEntryFactList, block_id: i64, cond: i64, branch_truth: i64) -> i64 {
  match scan {
    IrInstNil -> pipeline_ir_vector_upper_fact_lookup(0, 0, 0)
    IrInstCons(inst, rest) -> {
      match inst {
        IrBinaryI64(dst, op, lhs, rhs) -> {
          if dst == cond {
            pipeline_ir_inst_list_vector_upper_cmp_fact_from_operands(all_insts, facts, block_id, op, lhs, rhs, branch_truth)
          } else {
            pipeline_ir_inst_list_branch_vector_upper_fact_inner(rest, all_insts, facts, block_id, cond, branch_truth)
          }
        }
        _ -> pipeline_ir_inst_list_branch_vector_upper_fact_inner(rest, all_insts, facts, block_id, cond, branch_truth)
      }
    }
  }
}

fn pipeline_ir_inst_list_branch_vector_upper_fact(insts: IrInstList, cfg: i64, facts: PipelineIrBlockEntryFactList, block_id: i64, cond: i64, branch_truth: i64) -> i64 {
  let def = pipeline_ir_value_def_lookup(pipeline_ir_cfg_bundle_def_table(cfg), cond)
  if def != 0 and node_f1(def) == 3 {
    pipeline_ir_table_vector_upper_cmp_fact(cfg, insts, facts, block_id, node_f2(def), node_f3(def), node_f4(def), branch_truth)
  } else {
    pipeline_ir_inst_list_branch_vector_upper_fact_inner(insts, insts, facts, block_id, cond, branch_truth)
  }
}

fn pipeline_ir_term_predecessor_count(term: IrTerminator, target: i64) -> i64 {
  match term {
    IrTermNone -> 0
    IrTermReturn(value) -> 0
    IrTermJump(jump_target, args) -> if jump_target == target { 1 } else { 0 }
    IrTermBranch(cond, then_block, else_block) -> {
      let then_count = if then_block == target { 1 } else { 0 }
      let else_count = if else_block == target { 1 } else { 0 }
      then_count + else_count
    }
  }
}

fn pipeline_ir_inst_list_abort_predecessor_count(insts: IrInstList, target: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let add = match inst {
        IrHandleI64(dst, handle_src, effect_hash, clauses, nclauses, abort_block) -> if abort_block == target { 1 } else { 0 }
        _ -> 0
      }
      add + pipeline_ir_inst_list_abort_predecessor_count(rest, target)
    }
  }
}

fn pipeline_ir_block_predecessor_count(blocks: IrBlockList, target: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> pipeline_ir_term_predecessor_count(term, target) + pipeline_ir_inst_list_abort_predecessor_count(insts, target) + pipeline_ir_block_predecessor_count(rest, target)
      }
    }
  }
}

-- Dense predecessor-count fact: one pass over the terminators, O(1)
-- probes. Built once per fact pass instead of rescanning the whole
-- block list per query.
fn pipeline_ir_block_pred_count_bump(pc: i64, target: i64) -> i64 {
  let limit = mem_load64_at(pc, 0)
  if target >= 0 and target < limit {
    mem_store64_at(pc + 8 + target * 8, 0, mem_load64_at(pc + 8 + target * 8, 0) + 1)
  } else { 0 }
}

fn pipeline_ir_block_abort_pred_counts_accumulate(pc: i64, insts: IrInstList) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      match inst {
        IrHandleI64(dst, handle_src, effect_hash, clauses, nclauses, abort_block) -> pipeline_ir_block_pred_count_bump(pc, abort_block)
        _ -> 0
      }
      pipeline_ir_block_abort_pred_counts_accumulate(pc, rest)
    }
  }
}

fn pipeline_ir_block_pred_counts_accumulate(pc: i64, blocks: IrBlockList) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          pipeline_ir_block_abort_pred_counts_accumulate(pc, insts)
          match term {
            IrTermJump(target, args) -> pipeline_ir_block_pred_count_bump(pc, target)
            IrTermBranch(cond, then_block, else_block) -> {
              pipeline_ir_block_pred_count_bump(pc, then_block)
              pipeline_ir_block_pred_count_bump(pc, else_block)
            }
            _ -> 0
          }
        }
      }
      pipeline_ir_block_pred_counts_accumulate(pc, rest)
    }
  }
}

fn pipeline_ir_block_pred_counts(blocks: IrBlockList) -> i64 {
  let limit = pipeline_ir_max_block_id_list(blocks, 0) + 1
  let pc = alloc_words(limit + 1)
  mem_store64_at(pc, 0, limit)
  let mut i = 0
  while i < limit {
    mem_store64_at(pc + 8 + i * 8, 0, 0)
    i = i + 1
  }
  pipeline_ir_block_pred_counts_accumulate(pc, blocks)
  pc
}

fn pipeline_ir_block_pred_count_get(pc: i64, target: i64) -> i64 {
  let limit = mem_load64_at(pc, 0)
  if target >= 0 and target < limit {
    mem_load64_at(pc + 8 + target * 8, 0)
  } else { 0 }
}

-- Value-definition fact table: SSA defs are location-independent, so
-- branch-fact recognizers can resolve a condition or length defined in
-- any dominating block instead of scanning only the branch block.
-- Records per value: kind 1 = const(value), 2 = nil,
-- 3 = compare(code, lhs, rhs), 4 = vector_len(vec).
fn pipeline_ir_binary_cmp_code(op: IrBinaryOp) -> i64 {
  match op {
    IrEq -> 1
    IrNe -> 2
    IrLt -> 3
    IrGt -> 4
    IrLe -> 5
    IrGe -> 6
    _ -> 0
  }
}

fn pipeline_ir_binary_is_add(op: IrBinaryOp) -> i64 {
  match op {
    IrAdd -> 1
    _ -> 0
  }
}

fn pipeline_ir_binary_is_sub(op: IrBinaryOp) -> i64 {
  match op {
    IrSub -> 1
    _ -> 0
  }
}

fn pipeline_ir_value_def_table_record(table: i64, dst: i64, def: i64) -> i64 {
  let limit = mem_load64_at(table, 0)
  if dst >= 0 and dst < limit {
    mem_store64_at(table + 8 + dst * 8, 0, def)
  } else { 0 }
}

fn pipeline_ir_value_def_table_scan_insts(table: i64, insts: IrInstList, block_id: i64, idx: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      match inst {
        IrConstI64(dst, value) -> pipeline_ir_value_def_table_record(table, dst, node_new(0, 1, value, 0, 0))
        IrNilI64(dst) -> pipeline_ir_value_def_table_record(table, dst, node_new(0, 2, 0, 0, 0))
        IrBinaryI64(dst, op, lhs, rhs) -> {
          let code = pipeline_ir_binary_cmp_code(op)
          if code != 0 {
            pipeline_ir_value_def_table_record(table, dst, node_new(0, 3, code, lhs, rhs))
          } else {
            if pipeline_ir_binary_is_add(op) == 1 {
              pipeline_ir_value_def_table_record(table, dst, node_new(0, 5, 0, lhs, rhs))
            } else {
              if pipeline_ir_binary_is_sub(op) == 1 {
                pipeline_ir_value_def_table_record(table, dst, node_new(0, 7, 0, lhs, rhs))
              } else {
                if ir_binary_op_tag(op) == 3 {
                  pipeline_ir_value_def_table_record(table, dst, node_new(0, 8, 0, lhs, rhs))
                } else {
                  if ir_binary_op_tag(op) == 4 {
                    pipeline_ir_value_def_table_record(table, dst, node_new(0, 9, 0, lhs, rhs))
                  } else { 0 }
                }
              }
            }
          }
        }
        IrFloatBinaryI64(dst, prim, op, lhs, rhs) -> {
          let code = pipeline_ir_binary_cmp_code(op)
          if prim_is_integer(prim) == 1 and code != 0 {
            pipeline_ir_value_def_table_record(table, dst, node_new(0, 3, code, lhs, rhs))
          } else { 0 }
        }
        IrCallI64(dst, callee_hash, args) -> {
          if callee_hash == pipeline_ir_vector_len_hash() and ir_value_list_len(args) == 1 {
            let vec = pipeline_ir_value_list_get_or(args, 0, 0 - 1)
            if vec >= 0 {
              pipeline_ir_value_def_table_record(table, dst, node_new(0, 4, vec, 0, 0))
            } else { 0 }
          } else { 0 }
        }
        IrLoadI64(dst, slot) -> pipeline_ir_value_def_table_record(table, dst, node_new(0, 6, slot, block_id, idx))
        _ -> 0
      }
      pipeline_ir_value_def_table_scan_insts(table, rest, block_id, idx + 1)
    }
  }
}

fn pipeline_ir_value_def_table_scan_blocks(table: i64, blocks: IrBlockList) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> pipeline_ir_value_def_table_scan_insts(table, insts, id, 0)
      }
      pipeline_ir_value_def_table_scan_blocks(table, rest)
    }
  }
}

fn pipeline_ir_value_def_table(blocks: IrBlockList, param_count: i64) -> i64 {
  let limit = pipeline_ir_function_next_value(0, blocks)
  -- The final word carries the function parameter count. Optimiser contexts
  -- encode this scratch table as a negative handle in their existing scalar
  -- slot, preserving the four-field context ABI and its reclaimed-size
  -- contract while making function-wide definitions available to consumers.
  let table = alloc_words(limit + 2)
  mem_store64_at(table, 0, limit)
  let mut i = 0
  while i < limit {
    mem_store64_at(table + 8 + i * 8, 0, 0)
    i = i + 1
  }
  mem_store64_at(table + 8 + limit * 8, 0, param_count)
  pipeline_ir_value_def_table_scan_blocks(table, blocks)
  table
}

fn pipeline_ir_value_def_lookup(table: i64, value: i64) -> i64 {
  if table == 0 { 0 }
  else {
    let limit = mem_load64_at(table, 0)
    if value >= 0 and value < limit {
      mem_load64_at(table + 8 + value * 8, 0)
    } else { 0 }
  }
}

fn pipeline_ir_blocks_len_facts_stable_with(blocks: IrBlockList, pure_callees: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 1
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          if pipeline_ir_inst_list_len_facts_stable_with(insts, pure_callees) == 1 {
            pipeline_ir_blocks_len_facts_stable_with(rest, pure_callees)
          } else { 0 }
        }
      }
    }
  }
}

fn pipeline_ir_blocks_len_facts_stable(blocks: IrBlockList) -> i64 {
  pipeline_ir_blocks_len_facts_stable_with(blocks, 0)
}

-- Single-predecessor merge params are aliases of their unique jump
-- argument (the short-circuit and/or lowering routes its compare value
-- through one), so copy the argument's definition onto the parameter.
-- Runs a few passes to resolve param-to-param chains.
fn pipeline_ir_value_def_table_alias_block_params(table: i64, pc: i64, all_blocks: IrBlockList, blocks: IrBlockList) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          match term {
            IrTermJump(target, args) -> {
              if pipeline_ir_block_pred_count_get(pc, target) == 1 {
                pipeline_ir_value_def_table_alias_edge(table, pipeline_ir_block_params_or(all_blocks, target, ir_value_list_empty()), args)
              } else { 0 }
            }
            _ -> 0
          }
        }
      }
      pipeline_ir_value_def_table_alias_block_params(table, pc, all_blocks, rest)
    }
  }
}

fn pipeline_ir_value_def_table_alias_edge(table: i64, params: IrValueList, args: IrValueList) -> i64 {
  match params {
    IrValueNil -> 0
    IrValueCons(param, param_rest) -> {
      match args {
        IrValueNil -> 0
        IrValueCons(arg, arg_rest) -> {
          let arg_def = pipeline_ir_value_def_lookup(table, arg)
          if arg_def != 0 and pipeline_ir_value_def_lookup(table, param) == 0 {
            pipeline_ir_value_def_table_record(table, param, arg_def)
          } else { 0 }
          pipeline_ir_value_def_table_alias_edge(table, param_rest, arg_rest)
        }
      }
    }
  }
}

fn pipeline_ir_hash_tree_contains(root: i64, hash: i64) -> i64 {
  let mut cur = root
  let mut found = 0
  while cur != 0 and found == 0 {
    let cur_hash = node_f1(cur)
    if hash == cur_hash { found = 1 }
    else {
      cur = if hash < cur_hash { mem_load64_at(cur, 24) } else { mem_load64_at(cur, 32) }
    }
  }
  found
}

fn pipeline_ir_collect_addr_taken_slots_insts(insts: IrInstList, holder: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      match inst {
        IrAddressOfSlotI64(dst, slot_id) -> pipeline_ir_hash_tree_add_unique(holder, slot_id)
        _ -> 0
      }
      pipeline_ir_collect_addr_taken_slots_insts(rest, holder)
    }
  }
}

fn pipeline_ir_collect_addr_taken_slots(blocks: IrBlockList, holder: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> pipeline_ir_collect_addr_taken_slots_insts(insts, holder)
      }
      pipeline_ir_collect_addr_taken_slots(rest, holder)
    }
  }
}

-- Any store to the slot at instruction index > after_idx?
fn pipeline_ir_insts_store_slot_after(insts: IrInstList, slot: i64, after_idx: i64, idx: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      match inst {
        IrStoreI64(slot_id, value) -> {
          if slot_id == slot and idx > after_idx { 1 }
          else { pipeline_ir_insts_store_slot_after(rest, slot, after_idx, idx + 1) }
        }
        _ -> pipeline_ir_insts_store_slot_after(rest, slot, after_idx, idx + 1)
      }
    }
  }
}

fn pipeline_ir_block_insts_or_nil(blocks: IrBlockList, target: i64) -> IrInstList {
  match blocks {
    IrBlockListNil -> ir_inst_list_empty()
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          if id == target { insts } else { pipeline_ir_block_insts_or_nil(rest, target) }
        }
      }
    }
  }
}

fn pipeline_ir_unique_pred_or(blocks: IrBlockList, target: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0 - 1
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          if pipeline_ir_term_predecessor_count(term, target) + pipeline_ir_inst_list_abort_predecessor_count(insts, target) > 0 { id }
          else { pipeline_ir_unique_pred_or(rest, target) }
        }
      }
    }
  }
}

-- Walk backward from the branch block to the load's block through
-- single-predecessor edges (bounded), requiring every block on the
-- path to be store-free for the slot (the load's own block only after
-- the load's index). Proves the loaded value is still the slot's
-- current value at the branch.
fn pipeline_ir_slot_path_store_free(all_blocks: IrBlockList, pc: i64, load_block: i64, load_idx: i64, branch_block: i64, slot: i64) -> i64 {
  let mut cur = branch_block
  let mut hops = 0
  let mut result = 0 - 1
  while result < 0 {
    if cur == load_block {
      result = if pipeline_ir_insts_store_slot_after(pipeline_ir_block_insts_or_nil(all_blocks, cur), slot, load_idx, 0) == 1 { 0 } else { 1 }
    } else {
      if hops >= 4 or pipeline_ir_insts_store_slot_after(pipeline_ir_block_insts_or_nil(all_blocks, cur), slot, 0 - 1, 0) == 1 {
        result = 0
      } else {
        if pipeline_ir_block_pred_count_get(pc, cur) == 1 {
          let pred = pipeline_ir_unique_pred_or(all_blocks, cur)
          if pred < 0 { result = 0 } else { cur = pred }
          hops = hops + 1
        } else {
          result = 0
        }
      }
    }
  }
  result
}

-- CFG fact bundle threaded through the fact plane: f1 = predecessor
-- counts, f2 = value-definition table, f3 = whole-function length
-- stability (gates cross-block length facts).
-- Per-block len-stability, computed once per bundle: dense 0/1 map
-- indexed by block id. The propagation fixpoint and seeders consult
-- this instead of re-walking instruction lists (and re-probing the
-- pure-callee tree) every round.
fn pipeline_ir_cfg_block_len_stable_map(blocks: IrBlockList, pure_callees: i64) -> i64 {
  let max_id = pipeline_ir_native_resident_max_block_id(blocks)
  let map = pipeline_ir_native_resident_dense_new(max_id + 2, 1)
  let mut cur = blocks
  let mut walking = 1
  while walking == 1 {
    match cur {
      IrBlockListNil -> { walking = 0 }
      IrBlockListCons(block, rest) -> {
        match block {
          IrBlock(id, params, insts, term) -> {
            if id >= 0 and id <= max_id and pipeline_ir_inst_list_len_facts_stable_with(insts, pure_callees) == 0 {
              pipeline_ir_native_resident_dense_set(map, id, 0)
            } else { 0 }
          }
        }
        cur = rest
      }
    }
  }
  map
}

fn pipeline_ir_cfg_block_map_all_stable(map: i64) -> i64 {
  let n = nlist_len(map)
  let mut i = 0
  let mut all = 1
  while i < n {
    if nlist_get(map, i) == 0 { all = 0 } else { 0 }
    i = i + 1
  }
  all
}

fn pipeline_ir_cfg_fact_bundle_with_pure(blocks: IrBlockList, pure_callees: i64) -> i64 {
  let pc = pipeline_ir_block_pred_counts(blocks)
  let table = pipeline_ir_value_def_table(blocks, 0)
  pipeline_ir_value_def_table_alias_block_params(table, pc, blocks, blocks)
  pipeline_ir_value_def_table_alias_block_params(table, pc, blocks, blocks)
  let addr_taken = alloc_words(1)
  mem_store64_at(addr_taken, 0, 0)
  pipeline_ir_collect_addr_taken_slots(blocks, addr_taken)
  let stable_map = pipeline_ir_cfg_block_len_stable_map(blocks, pure_callees)
  let meta = node_new(0, pipeline_ir_cfg_block_map_all_stable(stable_map), pure_callees, stable_map, 0)
  node_new(0, pc, table, meta, mem_load64_at(addr_taken, 0))
}

fn pipeline_ir_cfg_fact_bundle(blocks: IrBlockList) -> i64 {
  pipeline_ir_cfg_fact_bundle_with_pure(blocks, 0)
}

fn pipeline_ir_cfg_bundle_pred_count(bundle: i64, target: i64) -> i64 {
  pipeline_ir_block_pred_count_get(node_f1(bundle), target)
}

fn pipeline_ir_cfg_bundle_def_table(bundle: i64) -> i64 {
  node_f2(bundle)
}

fn pipeline_ir_cfg_bundle_len_stable(bundle: i64) -> i64 {
  node_f1(node_f3(bundle))
}

fn pipeline_ir_cfg_bundle_pure_callees(bundle: i64) -> i64 {
  node_f2(node_f3(bundle))
}

fn pipeline_ir_cfg_bundle_block_len_stable(bundle: i64, block_id: i64) -> i64 {
  let map = node_f3(node_f3(bundle))
  if map == 0 { 0 }
  else {
    if block_id >= 0 and block_id < nlist_len(map) { nlist_get(map, block_id) } else { 0 }
  }
}

fn pipeline_ir_cfg_bundle_slot_addr_taken(bundle: i64, slot: i64) -> i64 {
  pipeline_ir_hash_tree_contains(node_f4(bundle), slot)
}

-- Find the binary instruction defining a value in this block:
-- node(0, op_tag, lhs, rhs, 0), or 0 when the value is not a same-block
-- binary result.
fn pipeline_ir_branch_find_binary(insts: IrInstList, value: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      match inst {
        IrBinaryI64(dst, op, lhs, rhs) -> {
          if dst == value { node_new(0, ir_binary_op_tag(op), lhs, rhs, 0) }
          else { pipeline_ir_branch_find_binary(rest, value) }
        }
        _ -> pipeline_ir_branch_find_binary(rest, value)
      }
    }
  }
}

-- A decomposition operand must be a same-block comparison or a nested
-- and/or: those produce 0/1, so "edge truth implies operand truth" is
-- sound for every downstream fact family (including bool facts).
fn pipeline_ir_branch_operand_is_boolish(insts: IrInstList, value: i64) -> i64 {
  let def = pipeline_ir_branch_find_binary(insts, value)
  if def == 0 { 0 }
  else {
    let tag = node_f1(def)
    if tag >= 5 and tag <= 10 { 1 } else { if tag == 12 or tag == 13 { 1 } else { 0 } }
  }
}

-- Seed every branch-fact family for one (condition, edge) pair. want = 1
-- seeds the edge where the condition is true, want = 0 the false edge.
fn pipeline_ir_branch_seed_edge(facts: PipelineIrBlockEntryFactList, insts: IrInstList, all_blocks: IrBlockList, pred_counts: i64, id: i64, cond: i64, target: i64, want: i64) -> PipelineIrBlockEntryFactList {
  let with_bool = pipeline_ir_block_entry_facts_prepend_bool(target, cond, want, facts)
  let found = pipeline_ir_inst_list_branch_ctor_fact(insts, pred_counts, cond)
  let with_ctor = if pipeline_ir_ctor_fact_lookup_valid(found) == 1 {
    let value_id = pipeline_ir_ctor_fact_lookup_value(found)
    let ctor_hash = pipeline_ir_ctor_fact_lookup_hash(found)
    if want == 1 {
      pipeline_ir_block_entry_facts_prepend_ctor(target, value_id, ctor_hash, with_bool)
    } else {
      pipeline_ir_block_entry_facts_prepend_not_ctor(target, value_id, ctor_hash, with_bool)
    }
  } else { with_bool }
  let zero = pipeline_ir_inst_list_branch_zero_fact(insts, pred_counts, cond, want)
  let with_zero = if pipeline_ir_zero_fact_lookup_valid(zero) == 1 {
    pipeline_ir_block_entry_facts_prepend_zero(target, pipeline_ir_zero_fact_lookup_value(zero), pipeline_ir_zero_fact_lookup_is_zero(zero), with_ctor)
  } else { with_ctor }
  let nil_fact = pipeline_ir_inst_list_branch_nil_fact(insts, pred_counts, cond, want)
  let with_nil = if pipeline_ir_nil_fact_lookup_valid(nil_fact) == 1 {
    pipeline_ir_block_entry_facts_prepend_nil(target, pipeline_ir_nil_fact_lookup_value(nil_fact), pipeline_ir_nil_fact_lookup_is_nil(nil_fact), with_zero)
  } else { with_zero }
  let nonnegative = pipeline_ir_inst_list_branch_nonnegative_fact(insts, pred_counts, cond, want)
  let with_nonnegative = if pipeline_ir_nonnegative_fact_lookup_valid(nonnegative) == 1 {
    let value_id = pipeline_ir_nonnegative_fact_lookup_value(nonnegative)
    let is_nonnegative = pipeline_ir_nonnegative_fact_lookup_is_nonnegative(nonnegative)
    let with_value = pipeline_ir_block_entry_facts_prepend_nonnegative(target, value_id, is_nonnegative, with_nil)
    let with_slot = pipeline_ir_block_entry_facts_add_slot_scalar_for_load(pred_counts, all_blocks, id, with_value, target, value_id, pipeline_ir_scalar_fact_kind_nonnegative(), is_nonnegative)
    pipeline_ir_block_entry_fact_add_result_facts(with_slot)
  } else { with_nil }
  let indexed_upper = pipeline_ir_inst_list_branch_indexed_upper_fact(insts, pred_counts, cond, want)
  let with_indexed_upper = if node_f1(indexed_upper) == 1 {
    pipeline_ir_block_entry_facts_prepend_indexed_upper(target, node_f2(indexed_upper), node_f3(indexed_upper), with_nonnegative)
  } else { with_nonnegative }
  let indexed_upper_or_equal = pipeline_ir_inst_list_branch_indexed_upper_or_equal_fact(insts, pred_counts, cond, want)
  let with_indexed_upper_or_equal = if node_f1(indexed_upper_or_equal) == 1 {
    pipeline_ir_block_entry_facts_prepend_indexed_upper_or_equal(target, node_f2(indexed_upper_or_equal), node_f3(indexed_upper_or_equal), with_indexed_upper)
  } else { with_indexed_upper }
  let len_ok = pipeline_ir_cfg_bundle_block_len_stable(pred_counts, id)
  let upper = pipeline_ir_inst_list_branch_vector_upper_fact(insts, pred_counts, with_indexed_upper_or_equal, id, cond, want)
  let with_upper = if len_ok == 1 and pipeline_ir_vector_upper_fact_lookup_valid(upper) == 1 {
    let vec_value = pipeline_ir_vector_upper_fact_lookup_vec(upper)
    let index_value = pipeline_ir_vector_upper_fact_lookup_index(upper)
    let with_value = pipeline_ir_block_entry_facts_prepend_vector_upper(target, vec_value, index_value, with_indexed_upper_or_equal)
    let with_slot = pipeline_ir_block_entry_facts_add_vector_slot_upper_for_load(pred_counts, all_blocks, id, with_value, target, vec_value, index_value)
    pipeline_ir_block_entry_fact_add_result_facts(with_slot)
  } else { with_indexed_upper_or_equal }
  let row = pipeline_ir_inst_list_branch_vector_row_upper_fact(insts, pred_counts, with_upper, id, cond, want)
  if len_ok == 1 and node_f1(row) == 1 {
    let with_row_slot = pipeline_ir_block_entry_facts_add_vector_slot_row_upper_for_load(pred_counts, all_blocks, id, with_upper, target, node_f2(row), node_f3(row), node_f4(row))
    pipeline_ir_block_entry_fact_add_result_facts(with_row_slot)
  } else { with_upper }
}

-- Branch-fact decomposition: the true edge of and(a, b) implies a AND b;
-- the false edge of or(a, b) implies (not a) AND (not b). Operands are
-- gated to same-block boolish definitions and recursion is bounded for
-- nested conjunction chains.
fn pipeline_ir_branch_seed_decomposed(facts: PipelineIrBlockEntryFactList, insts: IrInstList, all_blocks: IrBlockList, pred_counts: i64, id: i64, cond: i64, target: i64, want: i64, depth: i64) -> PipelineIrBlockEntryFactList {
  if depth <= 0 { facts }
  else {
    let def = pipeline_ir_branch_find_binary(insts, cond)
    if def == 0 { facts }
    else {
      let tag = node_f1(def)
      let decompose = if want == 1 and tag == 12 { 1 } else { if want == 0 and tag == 13 { 1 } else { 0 } }
      if decompose == 0 { facts }
      else {
        let lhs = node_f2(def)
        let rhs = node_f3(def)
        let with_lhs = if pipeline_ir_branch_operand_is_boolish(insts, lhs) == 1 {
          let seeded = pipeline_ir_branch_seed_edge(facts, insts, all_blocks, pred_counts, id, lhs, target, want)
          pipeline_ir_branch_seed_decomposed(seeded, insts, all_blocks, pred_counts, id, lhs, target, want, depth - 1)
        } else { facts }
        if pipeline_ir_branch_operand_is_boolish(insts, rhs) == 1 {
          let seeded = pipeline_ir_branch_seed_edge(with_lhs, insts, all_blocks, pred_counts, id, rhs, target, want)
          pipeline_ir_branch_seed_decomposed(seeded, insts, all_blocks, pred_counts, id, rhs, target, want, depth - 1)
        } else { with_lhs }
      }
    }
  }
}

fn pipeline_ir_block_entry_facts_from_block(block: IrBlock, all_blocks: IrBlockList, pred_counts: i64, rest_facts: PipelineIrBlockEntryFactList) -> PipelineIrBlockEntryFactList {
  match block {
    IrBlock(id, params, insts, term) -> {
      match term {
        IrTermBranch(cond, then_block, else_block) -> {
          if then_block != else_block {
            let then_single_pred = pipeline_ir_cfg_bundle_pred_count(pred_counts, then_block) == 1
            let else_single_pred = pipeline_ir_cfg_bundle_pred_count(pred_counts, else_block) == 1
            if then_single_pred == 0 and else_single_pred == 0 {
              rest_facts
            } else {
              let with_then = if then_single_pred {
                let seeded = pipeline_ir_branch_seed_edge(rest_facts, insts, all_blocks, pred_counts, id, cond, then_block, 1)
                pipeline_ir_branch_seed_decomposed(seeded, insts, all_blocks, pred_counts, id, cond, then_block, 1, 4)
              } else { rest_facts }
              if else_single_pred {
                let seeded = pipeline_ir_branch_seed_edge(with_then, insts, all_blocks, pred_counts, id, cond, else_block, 0)
                pipeline_ir_branch_seed_decomposed(seeded, insts, all_blocks, pred_counts, id, cond, else_block, 0, 4)
              } else { with_then }
            }
          } else {
            rest_facts
          }
        }
        _ -> rest_facts
      }
    }
  }
}

fn pipeline_ir_block_entry_facts_from_blocks_inner(blocks: IrBlockList, all_blocks: IrBlockList, pred_counts: i64, facts: PipelineIrBlockEntryFactList) -> PipelineIrBlockEntryFactList {
  match blocks {
    IrBlockListNil -> facts
    IrBlockListCons(block, rest) -> pipeline_ir_block_entry_facts_from_blocks_inner(rest, all_blocks, pred_counts, pipeline_ir_block_entry_facts_from_block(block, all_blocks, pred_counts, facts))
  }
}

fn pipeline_ir_block_params_or(blocks: IrBlockList, target_block: i64, default: IrValueList) -> IrValueList {
  match blocks {
    IrBlockListNil -> default
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          if id == target_block { params }
          else { pipeline_ir_block_params_or(rest, target_block, default) }
        }
      }
    }
  }
}

fn pipeline_ir_normalised_branch_target_target(result: PipelineIrNormalisedBranchTarget) -> i64 {
  match result {
    PipelineIrNormalisedBranchTarget(target, next_block, blocks, sites) -> target
  }
}

fn pipeline_ir_normalised_branch_target_next_block(result: PipelineIrNormalisedBranchTarget) -> i64 {
  match result {
    PipelineIrNormalisedBranchTarget(target, next_block, blocks, sites) -> next_block
  }
}

fn pipeline_ir_normalised_branch_target_blocks(result: PipelineIrNormalisedBranchTarget) -> IrBlockList {
  match result {
    PipelineIrNormalisedBranchTarget(target, next_block, blocks, sites) -> blocks
  }
}

fn pipeline_ir_normalised_branch_target_sites(result: PipelineIrNormalisedBranchTarget) -> i64 {
  match result {
    PipelineIrNormalisedBranchTarget(target, next_block, blocks, sites) -> sites
  }
}

fn pipeline_ir_normalised_term_term(result: PipelineIrNormalisedTerm) -> IrTerminator {
  match result {
    PipelineIrNormalisedTerm(term, next_block, blocks, sites) -> term
  }
}

fn pipeline_ir_normalised_term_next_block(result: PipelineIrNormalisedTerm) -> i64 {
  match result {
    PipelineIrNormalisedTerm(term, next_block, blocks, sites) -> next_block
  }
}

fn pipeline_ir_normalised_term_blocks(result: PipelineIrNormalisedTerm) -> IrBlockList {
  match result {
    PipelineIrNormalisedTerm(term, next_block, blocks, sites) -> blocks
  }
}

fn pipeline_ir_normalised_term_sites(result: PipelineIrNormalisedTerm) -> i64 {
  match result {
    PipelineIrNormalisedTerm(term, next_block, blocks, sites) -> sites
  }
}

fn pipeline_ir_normalised_blocks_blocks(result: PipelineIrNormalisedBlocks) -> IrBlockList {
  match result {
    PipelineIrNormalisedBlocks(blocks, next_block, sites) -> blocks
  }
}

fn pipeline_ir_normalised_blocks_next_block(result: PipelineIrNormalisedBlocks) -> i64 {
  match result {
    PipelineIrNormalisedBlocks(blocks, next_block, sites) -> next_block
  }
}

fn pipeline_ir_normalised_blocks_sites(result: PipelineIrNormalisedBlocks) -> i64 {
  match result {
    PipelineIrNormalisedBlocks(blocks, next_block, sites) -> sites
  }
}

fn pipeline_ir_max_block_id_block(block: IrBlock, current: i64) -> i64 {
  match block {
    IrBlock(id, params, insts, term) -> pipeline_ir_max_i64(current, id)
  }
}

fn pipeline_ir_max_block_id_list(blocks: IrBlockList, current: i64) -> i64 {
  match blocks {
    IrBlockListNil -> current
    IrBlockListCons(block, rest) -> pipeline_ir_max_block_id_list(rest, pipeline_ir_max_block_id_block(block, current))
  }
}

fn pipeline_ir_normalise_branch_target(blocks: IrBlockList, target: i64, next_block: i64) -> PipelineIrNormalisedBranchTarget {
  let params = pipeline_ir_block_params_or(blocks, target, ir_value_list_empty())
  if ir_value_list_len(params) == 0 {
    PipelineIrNormalisedBranchTarget(target, next_block, ir_block_list_empty(), 0)
  } else {
    let first_fresh = pipeline_ir_max_block_id_list(blocks, 0) + 1
    let edge_id = pipeline_ir_max_i64(first_fresh, next_block)
    let edge_block = ir_block_new_term(edge_id, ir_inst_list_empty(), ir_term_jump_args(target, params))
    PipelineIrNormalisedBranchTarget(edge_id, edge_id + 1, ir_block_list_prepend(edge_block, ir_block_list_empty()), 1)
  }
}

fn pipeline_ir_normalise_branch_term(term: IrTerminator, blocks: IrBlockList, next_block: i64) -> PipelineIrNormalisedTerm {
  match term {
    IrTermBranch(cond, then_block, else_block) -> {
      let then_target = pipeline_ir_normalise_branch_target(blocks, then_block, next_block)
      let else_target = pipeline_ir_normalise_branch_target(blocks, else_block, pipeline_ir_normalised_branch_target_next_block(then_target))
      let next_term = IrTermBranch(
        cond,
        pipeline_ir_normalised_branch_target_target(then_target),
        pipeline_ir_normalised_branch_target_target(else_target)
      )
      let edge_blocks = ir_block_list_append(
        pipeline_ir_normalised_branch_target_blocks(then_target),
        pipeline_ir_normalised_branch_target_blocks(else_target)
      )
      PipelineIrNormalisedTerm(
        next_term,
        pipeline_ir_normalised_branch_target_next_block(else_target),
        edge_blocks,
        pipeline_ir_normalised_branch_target_sites(then_target) + pipeline_ir_normalised_branch_target_sites(else_target)
      )
    }
    _ -> PipelineIrNormalisedTerm(term, next_block, ir_block_list_empty(), 0)
  }
}

fn pipeline_ir_normalise_branch_targets_inner(blocks: IrBlockList, all_blocks: IrBlockList, next_block: i64) -> PipelineIrNormalisedBlocks {
  match blocks {
    IrBlockListNil -> PipelineIrNormalisedBlocks(ir_block_list_empty(), next_block, 0)
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          let normalised_term = pipeline_ir_normalise_branch_term(term, all_blocks, next_block)
          let current_block = ir_block_new_params(id, params, insts, pipeline_ir_normalised_term_term(normalised_term))
          let current_blocks = ir_block_list_prepend(current_block, pipeline_ir_normalised_term_blocks(normalised_term))
          let tail = pipeline_ir_normalise_branch_targets_inner(rest, all_blocks, pipeline_ir_normalised_term_next_block(normalised_term))
          PipelineIrNormalisedBlocks(
            ir_block_list_append(current_blocks, pipeline_ir_normalised_blocks_blocks(tail)),
            pipeline_ir_normalised_blocks_next_block(tail),
            pipeline_ir_normalised_term_sites(normalised_term) + pipeline_ir_normalised_blocks_sites(tail)
          )
        }
      }
    }
  }
}

fn pipeline_ir_normalise_branch_targets(blocks: IrBlockList) -> PipelineIrNormalisedBlocks {
  pipeline_ir_normalise_branch_targets_inner(blocks, blocks, pipeline_ir_max_block_id_list(blocks, 0) + 1)
}

fn pipeline_ir_block_edge_arg_ctor_lookup(block: IrBlock, target_block: i64, index: i64, facts: PipelineIrBlockEntryFactList) -> PipelineIrConstLookup {
  match block {
    IrBlock(id, params, insts, term) -> {
      match term {
        IrTermJump(jump_target, args) -> {
          if jump_target == target_block {
            let arg = pipeline_ir_value_list_get_or(args, index, 0 - 1)
            if arg >= 0 {
              let local = pipeline_ir_inst_list_variant_init_tag_lookup(insts, arg)
              if pipeline_ir_const_lookup_valid(local) == 1 {
                local
              } else {
                pipeline_ir_block_entry_ctor_fact_lookup(facts, id, arg)
              }
            } else {
              pipeline_ir_const_lookup(0, 0)
            }
          } else {
            pipeline_ir_const_lookup(0, 0)
          }
        }
        _ -> pipeline_ir_const_lookup(0, 0)
      }
    }
  }
}

fn pipeline_ir_bool_lookup_from_const(found: PipelineIrConstLookup) -> PipelineIrConstLookup {
  if pipeline_ir_const_lookup_valid(found) == 1 {
    let value = pipeline_ir_const_lookup_value(found)
    if value == 0 or value == 1 { pipeline_ir_const_lookup(1, value) }
    else { pipeline_ir_const_lookup(0, 0) }
  } else {
    pipeline_ir_const_lookup(0, 0)
  }
}

fn pipeline_ir_block_edge_arg_bool_lookup(block: IrBlock, target_block: i64, index: i64, facts: PipelineIrBlockEntryFactList) -> PipelineIrConstLookup {
  match block {
    IrBlock(id, params, insts, term) -> {
      match term {
        IrTermJump(jump_target, args) -> {
          if jump_target == target_block {
            let arg = pipeline_ir_value_list_get_or(args, index, 0 - 1)
            if arg >= 0 {
              let local = pipeline_ir_bool_lookup_from_const(pipeline_ir_inst_list_const_def_lookup(insts, arg))
              if pipeline_ir_const_lookup_valid(local) == 1 {
                local
              } else {
                pipeline_ir_block_entry_bool_fact_lookup(facts, id, arg)
              }
            } else {
              pipeline_ir_const_lookup(0, 0)
            }
          } else {
            pipeline_ir_const_lookup(0, 0)
          }
        }
        _ -> pipeline_ir_const_lookup(0, 0)
      }
    }
  }
}

fn pipeline_ir_zero_lookup_from_const(found: PipelineIrConstLookup) -> PipelineIrConstLookup {
  if pipeline_ir_const_lookup_valid(found) == 1 {
    if pipeline_ir_const_lookup_value(found) == 0 {
      pipeline_ir_const_lookup(1, 1)
    } else {
      pipeline_ir_const_lookup(1, 0)
    }
  } else {
    pipeline_ir_const_lookup(0, 0)
  }
}

fn pipeline_ir_nonnegative_lookup_from_const(found: PipelineIrConstLookup) -> PipelineIrConstLookup {
  if pipeline_ir_const_lookup_valid(found) == 1 {
    if pipeline_ir_const_lookup_value(found) >= 0 {
      pipeline_ir_const_lookup(1, 1)
    } else {
      pipeline_ir_const_lookup(1, 0)
    }
  } else {
    pipeline_ir_const_lookup(0, 0)
  }
}

fn pipeline_ir_block_edge_arg_zero_lookup(block: IrBlock, target_block: i64, index: i64, facts: PipelineIrBlockEntryFactList) -> PipelineIrConstLookup {
  match block {
    IrBlock(id, params, insts, term) -> {
      match term {
        IrTermJump(jump_target, args) -> {
          if jump_target == target_block {
            let arg = pipeline_ir_value_list_get_or(args, index, 0 - 1)
            if arg >= 0 {
              let local = pipeline_ir_zero_lookup_from_const(pipeline_ir_inst_list_const_def_lookup(insts, arg))
              if pipeline_ir_const_lookup_valid(local) == 1 {
                local
              } else {
                pipeline_ir_block_entry_zero_fact_lookup(facts, id, arg)
              }
            } else {
              pipeline_ir_const_lookup(0, 0)
            }
          } else {
            pipeline_ir_const_lookup(0, 0)
          }
        }
        _ -> pipeline_ir_const_lookup(0, 0)
      }
    }
  }
}

fn pipeline_ir_block_edge_arg_nonnegative_lookup(block: IrBlock, target_block: i64, index: i64, facts: PipelineIrBlockEntryFactList, cfg: i64, param: i64) -> PipelineIrConstLookup {
  match block {
    IrBlock(id, params, insts, term) -> {
      match term {
        IrTermJump(jump_target, args) -> {
          if jump_target == target_block {
            let arg = pipeline_ir_value_list_get_or(args, index, 0 - 1)
            if arg >= 0 {
              let local = pipeline_ir_nonnegative_lookup_from_const(pipeline_ir_table_const_lookup(pipeline_ir_cfg_bundle_def_table(cfg), insts, arg))
              if pipeline_ir_const_lookup_valid(local) == 1 {
                local
              } else {
                let entry_fact = pipeline_ir_block_entry_nonnegative_fact_lookup(facts, id, arg)
                if pipeline_ir_const_lookup_valid(entry_fact) == 1 {
                  entry_fact
                } else {
                  if pipeline_ir_edge_arg_nonnegative_induction(cfg, facts, id, param, arg) == 1 {
                    pipeline_ir_const_lookup(1, 1)
                  } else {
                    pipeline_ir_const_lookup(0, 0)
                  }
                }
              }
            } else {
              pipeline_ir_const_lookup(0, 0)
            }
          } else {
            pipeline_ir_const_lookup(0, 0)
          }
        }
        _ -> pipeline_ir_const_lookup(0, 0)
      }
    }
  }
}

fn pipeline_ir_block_edge_arg_nil_lookup(block: IrBlock, target_block: i64, index: i64, facts: PipelineIrBlockEntryFactList) -> PipelineIrConstLookup {
  match block {
    IrBlock(id, params, insts, term) -> {
      match term {
        IrTermJump(jump_target, args) -> {
          if jump_target == target_block {
            let arg = pipeline_ir_value_list_get_or(args, index, 0 - 1)
            if arg >= 0 {
              if pipeline_ir_inst_list_nil_def_lookup(insts, arg) == 1 {
                pipeline_ir_const_lookup(1, 1)
              } else {
                pipeline_ir_block_entry_nil_fact_lookup(facts, id, arg)
              }
            } else {
              pipeline_ir_const_lookup(0, 0)
            }
          } else {
            pipeline_ir_const_lookup(0, 0)
          }
        }
        _ -> pipeline_ir_const_lookup(0, 0)
      }
    }
  }
}

-- True bool fact at this block whose compare strictly bounds `param`
-- above (param < X or X > param). Used by the induction rule: with a
-- strict upper bound, param + 1 cannot wrap, so nonnegativity is
-- preserved along the backedge.
fn pipeline_ir_block_chain_bounds_above(chain: PipelineIrBlockEntryFactChain, table: i64, param: i64) -> i64 {
  match chain {
    PipelineIrBlockEntryFactNil -> 0
    PipelineIrBlockEntryCtorFact(fact_block, value_id, ctor_hash, rest) -> pipeline_ir_block_chain_bounds_above(rest, table, param)
    PipelineIrBlockEntryNotCtorFact(fact_block, value_id, ctor_hash, rest) -> pipeline_ir_block_chain_bounds_above(rest, table, param)
    PipelineIrBlockEntryScalarFact(fact_block, value_id, kind, value, rest) -> {
      if kind == pipeline_ir_scalar_fact_kind_bool() and value == 1 {
        let def = pipeline_ir_value_def_lookup(table, value_id)
        if def != 0 and node_f1(def) == 3 and ((node_f2(def) == 3 and node_f3(def) == param) or (node_f2(def) == 4 and node_f4(def) == param)) {
          1
        } else {
          pipeline_ir_block_chain_bounds_above(rest, table, param)
        }
      } else {
        pipeline_ir_block_chain_bounds_above(rest, table, param)
      }
    }
    PipelineIrBlockEntrySlotScalarFact(fact_block, slot_id, kind, value, rest) -> pipeline_ir_block_chain_bounds_above(rest, table, param)
    PipelineIrBlockEntryVectorLenFact(fact_block, len_value, vec_value, rest) -> pipeline_ir_block_chain_bounds_above(rest, table, param)
    PipelineIrBlockEntryVectorUpperFact(fact_block, vec_value, index_value, rest) -> pipeline_ir_block_chain_bounds_above(rest, table, param)
    PipelineIrBlockEntryVectorSlotUpperFact(fact_block, vec_value, slot_id, rest) -> pipeline_ir_block_chain_bounds_above(rest, table, param)
    PipelineIrBlockEntryVectorSlotRowUpperFact(fact_block, vec_value, row_width, slot_id, rest) -> pipeline_ir_block_chain_bounds_above(rest, table, param)
    PipelineIrBlockEntryVectorRowUpperFact(fact_block, vec_value, row_width, slot_id, rest) -> pipeline_ir_block_chain_bounds_above(rest, table, param)
    PipelineIrBlockEntryVariantOriginFact(fact_block, value_id, ctor_hash, payloads, rest) -> pipeline_ir_block_chain_bounds_above(rest, table, param)
  }
}

fn pipeline_ir_block_facts_bound_above(facts: PipelineIrBlockEntryFactList, block_id: i64, table: i64, param: i64) -> i64 {
  pipeline_ir_block_chain_bounds_above(pipeline_ir_block_entry_facts_block_chain(facts, block_id), table, param)
}

-- Induction step for loop-carried nonnegativity: the backedge argument
-- is param + 1 (either operand order, the other a constant one) and the
-- source block carries a strict upper bound on param, so the increment
-- cannot wrap and stays nonnegative.
fn pipeline_ir_edge_arg_nonnegative_induction(cfg: i64, facts: PipelineIrBlockEntryFactList, source_block: i64, param: i64, arg: i64) -> i64 {
  let table = pipeline_ir_cfg_bundle_def_table(cfg)
  let def = pipeline_ir_value_def_lookup(table, arg)
  if def != 0 and node_f1(def) == 5 {
    let lhs = node_f3(def)
    let rhs = node_f4(def)
    let lhs_const = pipeline_ir_value_def_lookup(table, lhs)
    let rhs_const = pipeline_ir_value_def_lookup(table, rhs)
    let is_param_plus_one = if lhs == param and rhs_const != 0 and node_f1(rhs_const) == 1 and node_f2(rhs_const) == 1 { 1 }
      else { if rhs == param and lhs_const != 0 and node_f1(lhs_const) == 1 and node_f2(lhs_const) == 1 { 1 } else { 0 } }
    if is_param_plus_one == 1 {
      pipeline_ir_block_facts_bound_above(facts, source_block, table, param)
    } else { 0 }
  } else { 0 }
}

fn pipeline_ir_block_edge_arg_scalar_lookup(block: IrBlock, target_block: i64, index: i64, facts: PipelineIrBlockEntryFactList, kind: i64, cfg: i64, param: i64) -> PipelineIrConstLookup {
  if kind == pipeline_ir_scalar_fact_kind_bool() {
    pipeline_ir_block_edge_arg_bool_lookup(block, target_block, index, facts)
  } else {
    if kind == pipeline_ir_scalar_fact_kind_zero() {
      pipeline_ir_block_edge_arg_zero_lookup(block, target_block, index, facts)
    } else {
      if kind == pipeline_ir_scalar_fact_kind_nil() {
        pipeline_ir_block_edge_arg_nil_lookup(block, target_block, index, facts)
      } else {
        if kind == pipeline_ir_scalar_fact_kind_nonnegative() {
          pipeline_ir_block_edge_arg_nonnegative_lookup(block, target_block, index, facts, cfg, param)
        } else {
          pipeline_ir_const_lookup(0, 0)
        }
      }
    }
  }
}

fn pipeline_ir_block_entry_param_ctor_join_scan(blocks: IrBlockList, target_block: i64, index: i64, facts: PipelineIrBlockEntryFactList, seen: i64, valid: i64, ctor_hash: i64) -> PipelineIrConstLookup {
  match blocks {
    IrBlockListNil -> {
      if seen == 1 and valid == 1 { pipeline_ir_const_lookup(1, ctor_hash) }
      else { pipeline_ir_const_lookup(0, 0) }
    }
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          let edge_count = pipeline_ir_term_predecessor_count(term, target_block)
          if edge_count == 0 {
            pipeline_ir_block_entry_param_ctor_join_scan(rest, target_block, index, facts, seen, valid, ctor_hash)
          } else {
            let found = if edge_count == 1 {
              pipeline_ir_block_edge_arg_ctor_lookup(block, target_block, index, facts)
            } else {
              pipeline_ir_const_lookup(0, 0)
            }
            let found_valid = pipeline_ir_const_lookup_valid(found)
            let found_hash = pipeline_ir_const_lookup_value(found)
            let next_valid = if valid == 1 and found_valid == 1 {
              if seen == 0 or found_hash == ctor_hash { 1 } else { 0 }
            } else {
              0
            }
            let next_hash = if seen == 0 and found_valid == 1 { found_hash } else { ctor_hash }
            pipeline_ir_block_entry_param_ctor_join_scan(rest, target_block, index, facts, 1, next_valid, next_hash)
          }
        }
      }
    }
  }
}

fn pipeline_ir_block_entry_param_scalar_join_scan(blocks: IrBlockList, target_block: i64, index: i64, facts: PipelineIrBlockEntryFactList, kind: i64, cfg: i64, param: i64, seen: i64, valid: i64, value: i64) -> PipelineIrConstLookup {
  match blocks {
    IrBlockListNil -> {
      if seen == 1 and valid == 1 { pipeline_ir_const_lookup(1, value) }
      else { pipeline_ir_const_lookup(0, 0) }
    }
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          let edge_count = pipeline_ir_term_predecessor_count(term, target_block)
          if edge_count == 0 {
            pipeline_ir_block_entry_param_scalar_join_scan(rest, target_block, index, facts, kind, cfg, param, seen, valid, value)
          } else {
            let found = if edge_count == 1 {
              pipeline_ir_block_edge_arg_scalar_lookup(block, target_block, index, facts, kind, cfg, param)
            } else {
              pipeline_ir_const_lookup(0, 0)
            }
            let found_valid = pipeline_ir_const_lookup_valid(found)
            let found_value = pipeline_ir_const_lookup_value(found)
            let next_valid = if valid == 1 and found_valid == 1 {
              if seen == 0 or found_value == value { 1 } else { 0 }
            } else {
              0
            }
            let next_value = if seen == 0 and found_valid == 1 { found_value } else { value }
            pipeline_ir_block_entry_param_scalar_join_scan(rest, target_block, index, facts, kind, cfg, param, 1, next_valid, next_value)
          }
        }
      }
    }
  }
}

fn pipeline_ir_block_entry_facts_join_ctor_param(target_block: i64, param: i64, index: i64, all_blocks: IrBlockList, source_facts: PipelineIrBlockEntryFactList, out_facts: PipelineIrBlockEntryFactList) -> PipelineIrBlockEntryFactAddResult {
  let joined = pipeline_ir_block_entry_param_ctor_join_scan(all_blocks, target_block, index, source_facts, 0, 1, 0)
  if pipeline_ir_const_lookup_valid(joined) == 1 {
    pipeline_ir_block_entry_facts_add_ctor(out_facts, target_block, param, pipeline_ir_const_lookup_value(joined))
  } else {
    pipeline_ir_block_entry_fact_add_result(out_facts, 0)
  }
}

fn pipeline_ir_block_entry_facts_join_scalar_param(target_block: i64, param: i64, index: i64, all_blocks: IrBlockList, cfg: i64, source_facts: PipelineIrBlockEntryFactList, out_facts: PipelineIrBlockEntryFactList, kind: i64) -> PipelineIrBlockEntryFactAddResult {
  let joined = pipeline_ir_block_entry_param_scalar_join_scan(all_blocks, target_block, index, source_facts, kind, cfg, param, 0, 1, 0)
  if pipeline_ir_const_lookup_valid(joined) == 1 {
    pipeline_ir_block_entry_facts_add_scalar(out_facts, target_block, param, kind, pipeline_ir_const_lookup_value(joined))
  } else {
    pipeline_ir_block_entry_fact_add_result(out_facts, 0)
  }
}

fn pipeline_ir_block_entry_facts_join_ctor_params(params: IrValueList, index: i64, target_block: i64, all_blocks: IrBlockList, source_facts: PipelineIrBlockEntryFactList, out_facts: PipelineIrBlockEntryFactList) -> PipelineIrBlockEntryFactAddResult {
  match params {
    IrValueNil -> pipeline_ir_block_entry_fact_add_result(out_facts, 0)
    IrValueCons(param, rest) -> {
      let head = pipeline_ir_block_entry_facts_join_ctor_param(target_block, param, index, all_blocks, source_facts, out_facts)
      let tail = pipeline_ir_block_entry_facts_join_ctor_params(rest, index + 1, target_block, all_blocks, source_facts, pipeline_ir_block_entry_fact_add_result_facts(head))
      let changed = if pipeline_ir_block_entry_fact_add_result_changed(head) == 1 or pipeline_ir_block_entry_fact_add_result_changed(tail) == 1 { 1 } else { 0 }
      pipeline_ir_block_entry_fact_add_result(pipeline_ir_block_entry_fact_add_result_facts(tail), changed)
    }
  }
}

fn pipeline_ir_block_entry_facts_join_scalar_params(params: IrValueList, index: i64, target_block: i64, all_blocks: IrBlockList, cfg: i64, source_facts: PipelineIrBlockEntryFactList, out_facts: PipelineIrBlockEntryFactList, kind: i64) -> PipelineIrBlockEntryFactAddResult {
  match params {
    IrValueNil -> pipeline_ir_block_entry_fact_add_result(out_facts, 0)
    IrValueCons(param, rest) -> {
      let head = pipeline_ir_block_entry_facts_join_scalar_param(target_block, param, index, all_blocks, cfg, source_facts, out_facts, kind)
      let tail = pipeline_ir_block_entry_facts_join_scalar_params(rest, index + 1, target_block, all_blocks, cfg, source_facts, pipeline_ir_block_entry_fact_add_result_facts(head), kind)
      let changed = if pipeline_ir_block_entry_fact_add_result_changed(head) == 1 or pipeline_ir_block_entry_fact_add_result_changed(tail) == 1 { 1 } else { 0 }
      pipeline_ir_block_entry_fact_add_result(pipeline_ir_block_entry_fact_add_result_facts(tail), changed)
    }
  }
}

-- Indexed upper facts often cross compiler-inlined storage helpers. Those
-- helpers may split and rejoin control flow without changing either the index
-- SSA value or the immutable length key. Preserve an exact fact at a join only
-- when every predecessor carries the identical triple; this is intersection,
-- never widening.
fn pipeline_ir_block_entry_indexed_relation_all_predecessors(blocks: IrBlockList, target_block: i64, facts: PipelineIrBlockEntryFactList, index_value: i64, length_key: i64, kind: i64, seen: i64) -> i64 {
  match blocks {
    IrBlockListNil -> seen
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          if pipeline_ir_term_predecessor_count(term, target_block) == 0 {
            pipeline_ir_block_entry_indexed_relation_all_predecessors(rest, target_block, facts, index_value, length_key, kind, seen)
          } else {
            let chain = pipeline_ir_block_entry_facts_block_chain(facts, id)
            let found = pipeline_ir_block_entry_scalar_fact_lookup_chain(chain, id, index_value, kind)
            if pipeline_ir_const_lookup_valid(found) == 1 and pipeline_ir_const_lookup_value(found) == length_key {
              pipeline_ir_block_entry_indexed_relation_all_predecessors(rest, target_block, facts, index_value, length_key, kind, 1)
            } else { 0 }
          }
        }
      }
    }
  }
}

fn pipeline_ir_block_entry_first_predecessor(blocks: IrBlockList, target_block: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0 - 1
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          if pipeline_ir_term_predecessor_count(term, target_block) > 0 { id }
          else { pipeline_ir_block_entry_first_predecessor(rest, target_block) }
        }
      }
    }
  }
}

fn pipeline_ir_block_entry_facts_join_common_indexed_chain(chain: PipelineIrBlockEntryFactChain, target_block: i64, all_blocks: IrBlockList, source_facts: PipelineIrBlockEntryFactList, out_facts: PipelineIrBlockEntryFactList) -> PipelineIrBlockEntryFactAddResult {
  match chain {
    PipelineIrBlockEntryFactNil -> pipeline_ir_block_entry_fact_add_result(out_facts, 0)
    PipelineIrBlockEntryScalarFact(block_id, value_id, kind, value, rest) -> {
      let is_indexed_relation = if kind == pipeline_ir_scalar_fact_kind_indexed_upper() or kind == pipeline_ir_scalar_fact_kind_indexed_upper_or_equal() { 1 } else { 0 }
      let head = if is_indexed_relation == 1 and pipeline_ir_block_entry_indexed_relation_all_predecessors(all_blocks, target_block, source_facts, value_id, value, kind, 0) == 1 {
        pipeline_ir_block_entry_facts_add_scalar(out_facts, target_block, value_id, kind, value)
      } else { pipeline_ir_block_entry_fact_add_result(out_facts, 0) }
      let tail = pipeline_ir_block_entry_facts_join_common_indexed_chain(rest, target_block, all_blocks, source_facts, pipeline_ir_block_entry_fact_add_result_facts(head))
      let changed = if pipeline_ir_block_entry_fact_add_result_changed(head) == 1 or pipeline_ir_block_entry_fact_add_result_changed(tail) == 1 { 1 } else { 0 }
      pipeline_ir_block_entry_fact_add_result(pipeline_ir_block_entry_fact_add_result_facts(tail), changed)
    }
    PipelineIrBlockEntryCtorFact(block_id, value_id, ctor_hash, rest) -> pipeline_ir_block_entry_facts_join_common_indexed_chain(rest, target_block, all_blocks, source_facts, out_facts)
    PipelineIrBlockEntryNotCtorFact(block_id, value_id, ctor_hash, rest) -> pipeline_ir_block_entry_facts_join_common_indexed_chain(rest, target_block, all_blocks, source_facts, out_facts)
    PipelineIrBlockEntrySlotScalarFact(block_id, slot_id, kind, value, rest) -> pipeline_ir_block_entry_facts_join_common_indexed_chain(rest, target_block, all_blocks, source_facts, out_facts)
    PipelineIrBlockEntryVectorLenFact(block_id, len_value, vec_value, rest) -> pipeline_ir_block_entry_facts_join_common_indexed_chain(rest, target_block, all_blocks, source_facts, out_facts)
    PipelineIrBlockEntryVectorUpperFact(block_id, vec_value, index_value, rest) -> pipeline_ir_block_entry_facts_join_common_indexed_chain(rest, target_block, all_blocks, source_facts, out_facts)
    PipelineIrBlockEntryVectorSlotUpperFact(block_id, vec_value, slot_id, rest) -> pipeline_ir_block_entry_facts_join_common_indexed_chain(rest, target_block, all_blocks, source_facts, out_facts)
    PipelineIrBlockEntryVectorSlotRowUpperFact(block_id, vec_value, row_width, slot_id, rest) -> pipeline_ir_block_entry_facts_join_common_indexed_chain(rest, target_block, all_blocks, source_facts, out_facts)
    PipelineIrBlockEntryVectorRowUpperFact(block_id, vec_value, row_width, slot_id, rest) -> pipeline_ir_block_entry_facts_join_common_indexed_chain(rest, target_block, all_blocks, source_facts, out_facts)
    PipelineIrBlockEntryVariantOriginFact(block_id, value_id, ctor_hash, payloads, rest) -> pipeline_ir_block_entry_facts_join_common_indexed_chain(rest, target_block, all_blocks, source_facts, out_facts)
  }
}

fn pipeline_ir_block_entry_facts_join_common_indexed(target_block: i64, all_blocks: IrBlockList, source_facts: PipelineIrBlockEntryFactList, out_facts: PipelineIrBlockEntryFactList) -> PipelineIrBlockEntryFactAddResult {
  let first = pipeline_ir_block_entry_first_predecessor(all_blocks, target_block)
  if first < 0 { pipeline_ir_block_entry_fact_add_result(out_facts, 0) }
  else {
    pipeline_ir_block_entry_facts_join_common_indexed_chain(pipeline_ir_block_entry_facts_block_chain(source_facts, first), target_block, all_blocks, source_facts, out_facts)
  }
}

fn pipeline_ir_block_entry_facts_join_block_params(block: IrBlock, all_blocks: IrBlockList, pred_counts: i64, facts: PipelineIrBlockEntryFactList) -> PipelineIrBlockEntryFactAddResult {
  match block {
    IrBlock(id, params, insts, term) -> {
      if pipeline_ir_cfg_bundle_pred_count(pred_counts, id) > 1 {
        let ctor_joined = pipeline_ir_block_entry_facts_join_ctor_params(params, 0, id, all_blocks, facts, facts)
        let bool_joined = pipeline_ir_block_entry_facts_join_scalar_params(params, 0, id, all_blocks, pred_counts, facts, pipeline_ir_block_entry_fact_add_result_facts(ctor_joined), pipeline_ir_scalar_fact_kind_bool())
        let zero_joined = pipeline_ir_block_entry_facts_join_scalar_params(params, 0, id, all_blocks, pred_counts, facts, pipeline_ir_block_entry_fact_add_result_facts(bool_joined), pipeline_ir_scalar_fact_kind_zero())
        let nil_joined = pipeline_ir_block_entry_facts_join_scalar_params(params, 0, id, all_blocks, pred_counts, facts, pipeline_ir_block_entry_fact_add_result_facts(zero_joined), pipeline_ir_scalar_fact_kind_nil())
        let nonnegative_joined = pipeline_ir_block_entry_facts_join_scalar_params(params, 0, id, all_blocks, pred_counts, facts, pipeline_ir_block_entry_fact_add_result_facts(nil_joined), pipeline_ir_scalar_fact_kind_nonnegative())
        let indexed_joined = pipeline_ir_block_entry_facts_join_common_indexed(id, all_blocks, facts, pipeline_ir_block_entry_fact_add_result_facts(nonnegative_joined))
        let changed = if pipeline_ir_block_entry_fact_add_result_changed(ctor_joined) == 1 or pipeline_ir_block_entry_fact_add_result_changed(bool_joined) == 1 or pipeline_ir_block_entry_fact_add_result_changed(zero_joined) == 1 or pipeline_ir_block_entry_fact_add_result_changed(nil_joined) == 1 or pipeline_ir_block_entry_fact_add_result_changed(nonnegative_joined) == 1 or pipeline_ir_block_entry_fact_add_result_changed(indexed_joined) == 1 { 1 } else { 0 }
        pipeline_ir_block_entry_fact_add_result(pipeline_ir_block_entry_fact_add_result_facts(indexed_joined), changed)
      } else {
        pipeline_ir_block_entry_fact_add_result(facts, 0)
      }
    }
  }
}

fn pipeline_ir_block_entry_facts_propagate_target(source_block: i64, insts: IrInstList, target_block: i64, args: IrValueList, all_blocks: IrBlockList, pred_counts: i64, facts: PipelineIrBlockEntryFactList) -> PipelineIrBlockEntryFactAddResult {
  pipeline_ir_block_entry_facts_propagate_target_known(source_block, insts, target_block, args, all_blocks, pred_counts, facts, pipeline_ir_cfg_bundle_pred_count(pred_counts, target_block) == 1)
}

fn pipeline_ir_block_entry_facts_propagate_target_known(source_block: i64, insts: IrInstList, target_block: i64, args: IrValueList, all_blocks: IrBlockList, pred_counts: i64, facts: PipelineIrBlockEntryFactList, target_single_pred: bool) -> PipelineIrBlockEntryFactAddResult {
  if target_single_pred {
    let params = pipeline_ir_block_params_or(all_blocks, target_block, ir_value_list_empty())
    let len_ok = pipeline_ir_cfg_bundle_block_len_stable(pred_counts, source_block)
    let copied = pipeline_ir_block_entry_facts_copy_block_to_target(facts, source_block, insts, target_block, len_ok, facts)
    let translated = pipeline_ir_block_entry_facts_translate_block_to_target(facts, source_block, target_block, params, args, len_ok, pipeline_ir_block_entry_fact_add_result_facts(copied))
    let with_origins = pipeline_ir_block_entry_facts_add_inst_origins_to_target(insts, target_block, len_ok, pipeline_ir_block_entry_fact_add_result_facts(translated))
    let with_translated_origins = pipeline_ir_block_entry_facts_add_translated_inst_origins_to_target(insts, params, args, target_block, len_ok, pipeline_ir_block_entry_fact_add_result_facts(with_origins))
    let changed = if pipeline_ir_block_entry_fact_add_result_changed(copied) == 1 or pipeline_ir_block_entry_fact_add_result_changed(translated) == 1 or pipeline_ir_block_entry_fact_add_result_changed(with_origins) == 1 or pipeline_ir_block_entry_fact_add_result_changed(with_translated_origins) == 1 { 1 } else { 0 }
    pipeline_ir_block_entry_fact_add_result(pipeline_ir_block_entry_fact_add_result_facts(with_translated_origins), changed)
  } else {
    pipeline_ir_block_entry_fact_add_result(facts, 0)
  }
}

fn pipeline_ir_block_entry_facts_add_vector_upper_branch(source_block: i64, insts: IrInstList, cfg: i64, all_blocks: IrBlockList, cond: i64, then_block: i64, else_block: i64, facts: PipelineIrBlockEntryFactList, then_single_pred: bool, else_single_pred: bool) -> PipelineIrBlockEntryFactAddResult {
  if then_block == else_block {
    pipeline_ir_block_entry_fact_add_result(facts, 0)
  } else {
    let then_upper = pipeline_ir_inst_list_branch_vector_upper_fact(insts, cfg, facts, source_block, cond, 1)
    let with_then = if pipeline_ir_vector_upper_fact_lookup_valid(then_upper) == 1 and then_single_pred {
      let vec_value = pipeline_ir_vector_upper_fact_lookup_vec(then_upper)
      let index_value = pipeline_ir_vector_upper_fact_lookup_index(then_upper)
      let with_value = pipeline_ir_block_entry_facts_add_vector_upper(facts, then_block, vec_value, index_value)
      let with_slot = pipeline_ir_block_entry_facts_add_vector_slot_upper_for_load(cfg, all_blocks, source_block, pipeline_ir_block_entry_fact_add_result_facts(with_value), then_block, vec_value, index_value)
      let changed = if pipeline_ir_block_entry_fact_add_result_changed(with_value) == 1 or pipeline_ir_block_entry_fact_add_result_changed(with_slot) == 1 { 1 } else { 0 }
      pipeline_ir_block_entry_fact_add_result(pipeline_ir_block_entry_fact_add_result_facts(with_slot), changed)
    } else {
      pipeline_ir_block_entry_fact_add_result(facts, 0)
    }
    let then_facts = pipeline_ir_block_entry_fact_add_result_facts(with_then)
    let else_upper = pipeline_ir_inst_list_branch_vector_upper_fact(insts, cfg, then_facts, source_block, cond, 0)
    let with_else = if pipeline_ir_vector_upper_fact_lookup_valid(else_upper) == 1 and else_single_pred {
      let vec_value = pipeline_ir_vector_upper_fact_lookup_vec(else_upper)
      let index_value = pipeline_ir_vector_upper_fact_lookup_index(else_upper)
      let with_value = pipeline_ir_block_entry_facts_add_vector_upper(then_facts, else_block, vec_value, index_value)
      let with_slot = pipeline_ir_block_entry_facts_add_vector_slot_upper_for_load(cfg, all_blocks, source_block, pipeline_ir_block_entry_fact_add_result_facts(with_value), else_block, vec_value, index_value)
      let changed = if pipeline_ir_block_entry_fact_add_result_changed(with_value) == 1 or pipeline_ir_block_entry_fact_add_result_changed(with_slot) == 1 { 1 } else { 0 }
      pipeline_ir_block_entry_fact_add_result(pipeline_ir_block_entry_fact_add_result_facts(with_slot), changed)
    } else {
      pipeline_ir_block_entry_fact_add_result(then_facts, 0)
    }
    let else_done_facts = pipeline_ir_block_entry_fact_add_result_facts(with_else)
    let then_row = pipeline_ir_inst_list_branch_vector_row_upper_fact(insts, cfg, else_done_facts, source_block, cond, 1)
    let with_then_row = if node_f1(then_row) == 1 and then_single_pred {
      pipeline_ir_block_entry_facts_add_vector_slot_row_upper_for_load(cfg, all_blocks, source_block, else_done_facts, then_block, node_f2(then_row), node_f3(then_row), node_f4(then_row))
    } else {
      pipeline_ir_block_entry_fact_add_result(else_done_facts, 0)
    }
    let then_row_facts = pipeline_ir_block_entry_fact_add_result_facts(with_then_row)
    let else_row = pipeline_ir_inst_list_branch_vector_row_upper_fact(insts, cfg, then_row_facts, source_block, cond, 0)
    let with_else_row = if node_f1(else_row) == 1 and else_single_pred {
      pipeline_ir_block_entry_facts_add_vector_slot_row_upper_for_load(cfg, all_blocks, source_block, then_row_facts, else_block, node_f2(else_row), node_f3(else_row), node_f4(else_row))
    } else {
      pipeline_ir_block_entry_fact_add_result(then_row_facts, 0)
    }
    let changed = if pipeline_ir_block_entry_fact_add_result_changed(with_then) == 1 or pipeline_ir_block_entry_fact_add_result_changed(with_else) == 1 or pipeline_ir_block_entry_fact_add_result_changed(with_then_row) == 1 or pipeline_ir_block_entry_fact_add_result_changed(with_else_row) == 1 { 1 } else { 0 }
    pipeline_ir_block_entry_fact_add_result(pipeline_ir_block_entry_fact_add_result_facts(with_else_row), changed)
  }
}

fn pipeline_ir_block_entry_facts_propagate_block(block: IrBlock, all_blocks: IrBlockList, pred_counts: i64, facts: PipelineIrBlockEntryFactList) -> PipelineIrBlockEntryFactAddResult {
  match block {
    IrBlock(id, params, insts, term) -> {
      let joined = pipeline_ir_block_entry_facts_join_block_params(block, all_blocks, pred_counts, facts)
      let joined_facts = pipeline_ir_block_entry_fact_add_result_facts(joined)
      match term {
        IrTermJump(target, args) -> {
          let propagated = pipeline_ir_block_entry_facts_propagate_target(id, insts, target, args, all_blocks, pred_counts, joined_facts)
          let changed = if pipeline_ir_block_entry_fact_add_result_changed(joined) == 1 or pipeline_ir_block_entry_fact_add_result_changed(propagated) == 1 { 1 } else { 0 }
          pipeline_ir_block_entry_fact_add_result(pipeline_ir_block_entry_fact_add_result_facts(propagated), changed)
        }
        IrTermBranch(cond, then_block, else_block) -> {
          let then_single_pred = pipeline_ir_cfg_bundle_pred_count(pred_counts, then_block) == 1
          let else_single_pred = pipeline_ir_cfg_bundle_pred_count(pred_counts, else_block) == 1
          let branch_facts = if pipeline_ir_cfg_bundle_block_len_stable(pred_counts, id) == 1 {
            pipeline_ir_block_entry_facts_add_vector_upper_branch(id, insts, pred_counts, all_blocks, cond, then_block, else_block, joined_facts, then_single_pred, else_single_pred)
          } else {
            pipeline_ir_block_entry_fact_add_result(joined_facts, 0)
          }
          let then_result = pipeline_ir_block_entry_facts_propagate_target_known(id, insts, then_block, ir_value_list_empty(), all_blocks, pred_counts, pipeline_ir_block_entry_fact_add_result_facts(branch_facts), then_single_pred)
          let else_result = pipeline_ir_block_entry_facts_propagate_target_known(id, insts, else_block, ir_value_list_empty(), all_blocks, pred_counts, pipeline_ir_block_entry_fact_add_result_facts(then_result), else_single_pred)
          let changed = if pipeline_ir_block_entry_fact_add_result_changed(joined) == 1 or pipeline_ir_block_entry_fact_add_result_changed(branch_facts) == 1 or pipeline_ir_block_entry_fact_add_result_changed(then_result) == 1 or pipeline_ir_block_entry_fact_add_result_changed(else_result) == 1 { 1 } else { 0 }
          pipeline_ir_block_entry_fact_add_result(pipeline_ir_block_entry_fact_add_result_facts(else_result), changed)
        }
        _ -> pipeline_ir_block_entry_fact_add_result(joined_facts, pipeline_ir_block_entry_fact_add_result_changed(joined))
      }
    }
  }
}

fn pipeline_ir_block_entry_facts_propagate_once(blocks: IrBlockList, all_blocks: IrBlockList, pred_counts: i64, facts: PipelineIrBlockEntryFactList) -> PipelineIrBlockEntryFactAddResult {
  match blocks {
    IrBlockListNil -> pipeline_ir_block_entry_fact_add_result(facts, 0)
    IrBlockListCons(block, rest) -> {
      let head = pipeline_ir_block_entry_facts_propagate_block(block, all_blocks, pred_counts, facts)
      let tail = pipeline_ir_block_entry_facts_propagate_once(rest, all_blocks, pred_counts, pipeline_ir_block_entry_fact_add_result_facts(head))
      let changed = if pipeline_ir_block_entry_fact_add_result_changed(head) == 1 or pipeline_ir_block_entry_fact_add_result_changed(tail) == 1 { 1 } else { 0 }
      pipeline_ir_block_entry_fact_add_result(pipeline_ir_block_entry_fact_add_result_facts(tail), changed)
    }
  }
}

fn pipeline_ir_block_entry_facts_propagate_fixpoint(blocks: IrBlockList, pred_counts: i64, facts: PipelineIrBlockEntryFactList, remaining: i64) -> PipelineIrBlockEntryFactList {
  if remaining <= 0 {
    facts
  } else {
    let step = pipeline_ir_block_entry_facts_propagate_once(blocks, blocks, pred_counts, facts)
    let next = pipeline_ir_block_entry_fact_add_result_facts(step)
    if pipeline_ir_block_entry_fact_add_result_changed(step) == 0 {
      next
    } else {
      pipeline_ir_block_entry_facts_propagate_fixpoint(blocks, pred_counts, next, remaining - 1)
    }
  }
}

fn pipeline_ir_inst_list_has_entry_origin_candidate(insts: IrInstList) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      match inst {
        IrVariantInitI64(dst, tag_hash, payloads, field_mask) -> 1
        IrCallI64(dst, callee_hash, args) -> {
          if callee_hash == pipeline_ir_vector_len_hash() and ir_value_list_len(args) == 1 { 1 }
          else { pipeline_ir_inst_list_has_entry_origin_candidate(rest) }
        }
        _ -> pipeline_ir_inst_list_has_entry_origin_candidate(rest)
      }
    }
  }
}

fn pipeline_ir_block_has_entry_origin_candidate(block: IrBlock, all_blocks: IrBlockList) -> i64 {
  match block {
    IrBlock(id, params, insts, term) -> {
      match term {
        IrTermJump(target, args) -> {
          if pipeline_ir_block_predecessor_count(all_blocks, target) == 1 {
            pipeline_ir_inst_list_has_entry_origin_candidate(insts)
          } else {
            0
          }
        }
        _ -> 0
      }
    }
  }
}

fn pipeline_ir_block_list_has_entry_origin_candidate(blocks: IrBlockList, all_blocks: IrBlockList) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      if pipeline_ir_block_has_entry_origin_candidate(block, all_blocks) == 1 {
        1
      } else {
        pipeline_ir_block_list_has_entry_origin_candidate(rest, all_blocks)
      }
    }
  }
}

fn pipeline_ir_block_entry_fact_full_block_limit() -> i64 {
  32
}

-- Functions containing the scaled-index shape (a division, a multiply,
-- and a vector access — the row-bound consumers) get the extended
-- fact plane up to the dominator bitset's 64-block capacity; everything
-- else keeps the 32-block plane, so the quadratic fact-pass cost is
-- only paid where the row rules can fire. nbody_advance is 40 blocks.
fn pipeline_ir_blocks_row_shape_candidate(blocks: IrBlockList) -> i64 {
  let mut cur = blocks
  let mut has_div = 0
  let mut has_mul = 0
  let mut has_vec = 0
  let mut walking = 1
  while walking == 1 {
    match cur {
      IrBlockListNil -> { walking = 0 }
      IrBlockListCons(block, rest) -> {
        match block {
          IrBlock(id, params, insts, term) -> {
            let mut icur = insts
            let mut iwalk = 1
            while iwalk == 1 {
              match icur {
                IrInstNil -> { iwalk = 0 }
                IrInstCons(inst, irest) -> {
                  match inst {
                    IrBinaryI64(dst, op, lhs, rhs) -> {
                      if ir_binary_op_tag(op) == 4 { has_div = 1 }
                      else { if ir_binary_op_tag(op) == 3 { has_mul = 1 } else { 0 } }
                    }
                    IrVectorGetI64(dst, vec, index, fallback, check_mode) -> { has_vec = 1 }
                    IrVectorSetI64(dst, vec, index, value, check_mode) -> { has_vec = 1 }
                    _ -> 0
                  }
                  icur = irest
                }
              }
            }
          }
        }
        if has_div == 1 and has_mul == 1 and has_vec == 1 { walking = 0 } else { 0 }
        cur = rest
      }
    }
  }
  if has_div == 1 and has_mul == 1 and has_vec == 1 { 1 } else { 0 }
}

fn pipeline_ir_block_entry_fact_effective_block_limit(blocks: IrBlockList) -> i64 {
  if ir_block_list_len(blocks) <= pipeline_ir_block_entry_fact_full_block_limit() {
    pipeline_ir_block_entry_fact_full_block_limit()
  } else {
    if pipeline_ir_blocks_row_shape_candidate(blocks) == 1 { 64 } else { pipeline_ir_block_entry_fact_full_block_limit() }
  }
}

-- ══════════════════════════════════════════════════════════════
-- Block dominators (iterative bitset dataflow). dom(entry) = {entry};
-- dom(B) = {B} ∪ ⋂ dom(pred). Bitsets are word arrays indexed by block
-- id; blocks with ids above the cap fall back to "no information"
-- (callers must treat a missing set as non-dominating).
-- ══════════════════════════════════════════════════════════════

fn pipeline_ir_dominators_words(max_id: i64) -> i64 {
  (max_id + 64) / 64
}

fn pipeline_ir_dominators_bit_get(sets: i64, words: i64, block: i64, other: i64) -> i64 {
  let word = pipeline_word_array_get(sets, block * words + other / 64)
  if (word band (1 bshl (other % 64))) != 0 { 1 } else { 0 }
}

fn pipeline_ir_dominators_collect_abort_edges(insts: IrInstList, block_id: i64, edges: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      match inst {
        IrHandleI64(dst, handle_src, effect_hash, clauses, nclauses, abort_block) -> {
          if abort_block >= 0 { nlist_add(edges, node_new(0, block_id, abort_block, 0, 0)) 0 } else { 0 }
        }
        _ -> 0
      }
      pipeline_ir_dominators_collect_abort_edges(rest, block_id, edges)
    }
  }
}

fn pipeline_ir_dominators_collect_edges(blocks: IrBlockList, edges: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          pipeline_ir_dominators_collect_abort_edges(insts, id, edges)
          match term {
            IrTermJump(target, args) -> {
              nlist_add(edges, node_new(0, id, target, 0, 0))
              0
            }
            IrTermBranch(cond, then_block, else_block) -> {
              nlist_add(edges, node_new(0, id, then_block, 0, 0))
              nlist_add(edges, node_new(0, id, else_block, 0, 0))
              0
            }
            _ -> 0
          }
          pipeline_ir_dominators_collect_edges(rest, edges)
        }
      }
    }
  }
}

-- Compute dominator bitsets for every block id in [0, max_id]. The first
-- block in layout order is the entry. Unreachable blocks keep the full
-- set (standard init) which is harmless for our consumers: their facts
-- never fire because execution never reaches them.
fn pipeline_ir_dominators(blocks: IrBlockList, max_id: i64) -> i64 {
  let words = pipeline_ir_dominators_words(max_id)
  let n = max_id + 1
  let sets = pipeline_word_array_new(n * words)
  let mut i = 0
  while i < n * words {
    pipeline_word_array_set(sets, i, 0 - 1)
    i = i + 1
  }
  let entry = match blocks {
    IrBlockListNil -> 0 - 1
    IrBlockListCons(block, rest) -> match block { IrBlock(id, params, insts, term) -> id }
  }
  if entry < 0 or entry > max_id { sets }
  else {
    let mut w = 0
    while w < words {
      pipeline_word_array_set(sets, entry * words + w, 0)
      w = w + 1
    }
    pipeline_word_array_set(sets, entry * words + entry / 64, 1 bshl (entry % 64))
    let edges = nlist_new()
    pipeline_ir_dominators_collect_edges(blocks, edges)
    let ne = nlist_len(edges)
    let mut changed = 1
    let mut rounds = 0
    while changed == 1 and rounds <= max_id + 2 {
      changed = 0
      let mut e = 0
      while e < ne {
        let edge = nlist_get(edges, e)
        let src = node_f1(edge)
        let dst = node_f2(edge)
        if dst >= 0 and dst <= max_id and src >= 0 and src <= max_id and dst != entry {
          let mut w2 = 0
          while w2 < words {
            let cur = pipeline_word_array_get(sets, dst * words + w2)
            let self_bit = if dst / 64 == w2 { 1 bshl (dst % 64) } else { 0 }
            let next = (cur band (pipeline_word_array_get(sets, src * words + w2) bor self_bit)) bor self_bit
            if next != cur {
              pipeline_word_array_set(sets, dst * words + w2, next)
              changed = 1
            } else { 0 }
            w2 = w2 + 1
          }
        } else { 0 }
        e = e + 1
      }
      rounds = rounds + 1
    }
    sets
  }
}

-- A10 shared dominator handle: [built, sets, max_id, words]. Lazy —
-- the first consumer that needs dominator sets builds them via
-- pipeline_ir_dominators; later consumers over the SAME blocks value
-- reuse the sets. The handle is tied to one immutable blocks value:
-- a pass that produces a new blocks list must construct a fresh
-- handle, so invalidation holds by construction. Consumer-side gates
-- (the 63-id bitset cap, fact-plane block limits) stay with the
-- consumers — the handle builds for whatever CFG it is asked about,
-- which lets capped (fact seeders) and uncapped (param induction)
-- consumers share one build when both are in range.
fn pipeline_ir_dom_handle_new() -> i64 {
  let h = alloc_words(4)
  mem_store64_at(h, 0, 0)
  mem_store64_at(h, 8, 0)
  mem_store64_at(h, 16, 0 - 1)
  mem_store64_at(h, 24, 0)
  h
}

fn pipeline_ir_dom_handle_ensure(h: i64, blocks: IrBlockList, max_id: i64) -> i64 {
  if mem_load64_at(h, 0) == 1 and mem_load64_at(h, 16) == max_id {
    mem_load64_at(h, 8)
  } else {
    let sets = pipeline_ir_dominators(blocks, max_id)
    mem_store64_at(h, 0, 1)
    mem_store64_at(h, 8, sets)
    mem_store64_at(h, 16, max_id)
    mem_store64_at(h, 24, pipeline_ir_dominators_words(max_id))
    sets
  }
}

fn pipeline_ir_dom_handle_words(h: i64) -> i64 {
  mem_load64_at(h, 24)
}

-- Every cycle through block target passes block gate: with gate removed,
-- target cannot reach itself. DFS over the edge list.
fn pipeline_ir_all_cycles_pass(blocks: IrBlockList, max_id: i64, target: i64, gate: i64) -> i64 {
  let edges = nlist_new()
  pipeline_ir_dominators_collect_edges(blocks, edges)
  let ne = nlist_len(edges)
  let visited = pipeline_ir_native_resident_dense_new(max_id + 1, 0)
  let stack = nlist_new()
  -- seed with target's successors (skipping the gate)
  let mut e = 0
  while e < ne {
    let edge = nlist_get(edges, e)
    if node_f1(edge) == target and node_f2(edge) != gate and node_f2(edge) >= 0 and node_f2(edge) <= max_id {
      if nlist_get(visited, node_f2(edge)) == 0 {
        pipeline_ir_native_resident_dense_set(visited, node_f2(edge), 1)
        nlist_add(stack, node_f2(edge))
        0
      } else { 0 }
    } else { 0 }
    e = e + 1
  }
  let mut reached = 0
  let mut top = nlist_len(stack)
  while top > 0 and reached == 0 {
    let cur = nlist_get(stack, top - 1)
    nlist_set_len(stack, top - 1)
    if cur == target { reached = 1 }
    else {
      let mut e2 = 0
      while e2 < ne {
        let edge2 = nlist_get(edges, e2)
        if node_f1(edge2) == cur and node_f2(edge2) != gate and node_f2(edge2) >= 0 and node_f2(edge2) <= max_id {
          if node_f2(edge2) == target { reached = 1 }
          else { if nlist_get(visited, node_f2(edge2)) == 0 {
            pipeline_ir_native_resident_dense_set(visited, node_f2(edge2), 1)
            nlist_add(stack, node_f2(edge2))
            0
          } else { 0 } }
        } else { 0 }
        e2 = e2 + 1
      }
    }
    top = nlist_len(stack)
  }
  if reached == 1 { 0 } else { 1 }
}

-- Is `to` reachable from `from`'s successors without ever entering
-- `gate`? DFS over the edge list (mirror of the all-cycles gate check).
fn pipeline_ir_block_reaches_avoiding(blocks: IrBlockList, max_id: i64, from: i64, to: i64, gate: i64) -> i64 {
  let edges = nlist_new()
  pipeline_ir_dominators_collect_edges(blocks, edges)
  let ne = nlist_len(edges)
  let visited = pipeline_ir_native_resident_dense_new(max_id + 1, 0)
  let stack = nlist_new()
  let mut e = 0
  while e < ne {
    let edge = nlist_get(edges, e)
    if node_f1(edge) == from and node_f2(edge) != gate and node_f2(edge) >= 0 and node_f2(edge) <= max_id {
      if nlist_get(visited, node_f2(edge)) == 0 {
        pipeline_ir_native_resident_dense_set(visited, node_f2(edge), 1)
        nlist_add(stack, node_f2(edge))
        0
      } else { 0 }
    } else { 0 }
    e = e + 1
  }
  let mut reached = 0
  let mut top = nlist_len(stack)
  while top > 0 and reached == 0 {
    let cur = nlist_get(stack, top - 1)
    nlist_set_len(stack, top - 1)
    if cur == to { reached = 1 }
    else {
      let mut e2 = 0
      while e2 < ne {
        let edge2 = nlist_get(edges, e2)
        if node_f1(edge2) == cur and node_f2(edge2) != gate and node_f2(edge2) >= 0 and node_f2(edge2) <= max_id {
          if node_f2(edge2) == to { reached = 1 }
          else { if nlist_get(visited, node_f2(edge2)) == 0 {
            pipeline_ir_native_resident_dense_set(visited, node_f2(edge2), 1)
            nlist_add(stack, node_f2(edge2))
            0
          } else { 0 } }
        } else { 0 }
        e2 = e2 + 1
      }
    }
    top = nlist_len(stack)
  }
  reached
}

-- Slot nonnegativity invariant (loop induction over stack slots):
-- a slot k always holds a nonnegative value if it is never
-- address-taken, every constant store to it is in [0, i64::MAX), and
-- its single non-constant store writes load(k) + 1 in a block that
-- carries a true strict upper bound on a load of k (the strict bound
-- makes the increment overflow-free: the stored value is <= the bound,
-- and any constant interleaving stays below MAX).
fn pipeline_ir_block_chain_slot_bound_above(chain: PipelineIrBlockEntryFactChain, table: i64, slot: i64) -> i64 {
  match chain {
    PipelineIrBlockEntryFactNil -> 0
    PipelineIrBlockEntryCtorFact(fact_block, value_id, ctor_hash, rest) -> pipeline_ir_block_chain_slot_bound_above(rest, table, slot)
    PipelineIrBlockEntryNotCtorFact(fact_block, value_id, ctor_hash, rest) -> pipeline_ir_block_chain_slot_bound_above(rest, table, slot)
    PipelineIrBlockEntryScalarFact(fact_block, value_id, kind, value, rest) -> {
      if kind == pipeline_ir_scalar_fact_kind_bool() and value == 1 {
        let def = pipeline_ir_value_def_lookup(table, value_id)
        if def != 0 and node_f1(def) == 3 {
          let bound_operand = if node_f2(def) == 3 { node_f3(def) } else { if node_f2(def) == 4 { node_f4(def) } else { 0 - 1 } }
          if bound_operand >= 0 {
            let operand_def = pipeline_ir_value_def_lookup(table, bound_operand)
            if operand_def != 0 and node_f1(operand_def) == 6 and node_f2(operand_def) == slot {
              1
            } else {
              pipeline_ir_block_chain_slot_bound_above(rest, table, slot)
            }
          } else {
            pipeline_ir_block_chain_slot_bound_above(rest, table, slot)
          }
        } else {
          pipeline_ir_block_chain_slot_bound_above(rest, table, slot)
        }
      } else {
        pipeline_ir_block_chain_slot_bound_above(rest, table, slot)
      }
    }
    PipelineIrBlockEntrySlotScalarFact(fact_block, slot_id, kind, value, rest) -> pipeline_ir_block_chain_slot_bound_above(rest, table, slot)
    PipelineIrBlockEntryVectorLenFact(fact_block, len_value, vec_value, rest) -> pipeline_ir_block_chain_slot_bound_above(rest, table, slot)
    PipelineIrBlockEntryVectorUpperFact(fact_block, vec_value, index_value, rest) -> pipeline_ir_block_chain_slot_bound_above(rest, table, slot)
    PipelineIrBlockEntryVectorSlotUpperFact(fact_block, vec_value, slot_id, rest) -> pipeline_ir_block_chain_slot_bound_above(rest, table, slot)
    PipelineIrBlockEntryVectorSlotRowUpperFact(fact_block, vec_value, row_width, slot_id, rest) -> pipeline_ir_block_chain_slot_bound_above(rest, table, slot)
    PipelineIrBlockEntryVectorRowUpperFact(fact_block, vec_value, row_width, slot_id, rest) -> pipeline_ir_block_chain_slot_bound_above(rest, table, slot)
    PipelineIrBlockEntryVariantOriginFact(fact_block, value_id, ctor_hash, payloads, rest) -> pipeline_ir_block_chain_slot_bound_above(rest, table, slot)
  }
}

-- Accept a strict-bound fact from any block D that dominates the
-- increment's block AND lies on every cycle through it: the value fact
-- (load(k) < bound) is eternally true once computed, dominance puts a
-- fresh check before every arrival at the increment, and the cycle
-- condition forbids re-executing the increment without re-checking —
-- together the incremented value never exceeds the bound, so +1 cannot
-- wrap.
fn pipeline_ir_slot_bound_above_dominating(blocks: IrBlockList, all_blocks: IrBlockList, table: i64, facts: PipelineIrBlockEntryFactList, slot: i64, inc_block: i64, dom_sets: i64, dom_max: i64, dom_words: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          let hit = if id != inc_block and id >= 0 and id <= dom_max and inc_block >= 0 and inc_block <= dom_max {
            if pipeline_ir_block_chain_slot_bound_above(pipeline_ir_block_entry_facts_block_chain(facts, id), table, slot) == 1 {
              if pipeline_ir_dominators_bit_get(dom_sets, dom_words, inc_block, id) == 1 {
                pipeline_ir_all_cycles_pass(all_blocks, dom_max, inc_block, id)
              } else { 0 }
            } else { 0 }
          } else { 0 }
          if hit == 1 { 1 } else { pipeline_ir_slot_bound_above_dominating(rest, all_blocks, table, facts, slot, inc_block, dom_sets, dom_max, dom_words) }
        }
      }
    }
  }
}

fn pipeline_ir_slot_store_is_own_increment(table: i64, slot: i64, value: i64) -> i64 {
  let def = pipeline_ir_value_def_lookup(table, value)
  if def != 0 and node_f1(def) == 5 {
    let lhs = node_f3(def)
    let rhs = node_f4(def)
    let lhs_def = pipeline_ir_value_def_lookup(table, lhs)
    let rhs_def = pipeline_ir_value_def_lookup(table, rhs)
    if lhs_def != 0 and node_f1(lhs_def) == 6 and node_f2(lhs_def) == slot and rhs_def != 0 and node_f1(rhs_def) == 1 and node_f2(rhs_def) == 1 { 1 }
    else { if rhs_def != 0 and node_f1(rhs_def) == 6 and node_f2(rhs_def) == slot and lhs_def != 0 and node_f1(lhs_def) == 1 and node_f2(lhs_def) == 1 { 1 } else { 0 } }
  } else { 0 }
}

-- Store of load(m) + 1 for a DIFFERENT slot m: returns m or -1.
fn pipeline_ir_slot_store_offset_source(table: i64, slot: i64, value: i64) -> i64 {
  let def = pipeline_ir_value_def_lookup(table, value)
  if def != 0 and node_f1(def) == 5 {
    let lhs = node_f3(def)
    let rhs = node_f4(def)
    let lhs_def = pipeline_ir_value_def_lookup(table, lhs)
    let rhs_def = pipeline_ir_value_def_lookup(table, rhs)
    if lhs_def != 0 and node_f1(lhs_def) == 6 and node_f2(lhs_def) != slot and rhs_def != 0 and node_f1(rhs_def) == 1 and node_f2(rhs_def) == 1 { node_f2(lhs_def) }
    else { if rhs_def != 0 and node_f1(rhs_def) == 6 and node_f2(rhs_def) != slot and lhs_def != 0 and node_f1(lhs_def) == 1 and node_f2(lhs_def) == 1 { node_f2(rhs_def) } else { 0 - 1 } }
  } else { 0 - 1 }
}

-- Verdict per slot: -1 reject, otherwise bit 1 = saw a store,
-- bit 2 = saw the (single) increment store. depth bounds the recursion
-- of the offset-init leg (store of load(m) + 1 with m itself
-- invariant-nonnegative).
fn pipeline_ir_slot_nonneg_scan_insts(insts: IrInstList, block_insts: IrInstList, block_id: i64, table: i64, facts: PipelineIrBlockEntryFactList, slot: i64, state: i64, all_blocks: IrBlockList, dom_sets: i64, dom_max: i64, dom_words: i64, depth: i64) -> i64 {
  match insts {
    IrInstNil -> state
    IrInstCons(inst, rest) -> {
      if state < 0 { state }
      else {
        let next = match inst {
          IrAddressOfSlotI64(dst, slot_id) -> if slot_id == slot { 0 - 1 } else { state }
          IrStoreI64(slot_id, value) -> {
            if slot_id == slot {
              let const_def = pipeline_ir_value_def_lookup(table, value)
              if const_def != 0 and node_f1(const_def) == 1 and node_f2(const_def) >= 0 and node_f2(const_def) < 9223372036854775807 {
                state bor 1
              } else {
                if (state band 2) == 0 and pipeline_ir_slot_store_is_own_increment(table, slot, value) == 1 {
                  let own = pipeline_ir_block_chain_slot_bound_above(pipeline_ir_block_entry_facts_block_chain(facts, block_id), table, slot)
                  let bounded = if own == 1 { 1 } else {
                    if dom_sets != 0 {
                      pipeline_ir_slot_bound_above_dominating(all_blocks, all_blocks, table, facts, slot, block_id, dom_sets, dom_max, dom_words)
                    } else { 0 }
                  }
                  if bounded == 1 { state bor 3 } else { 0 - 1 }
                } else {
                  -- Offset init: load(m) + 1 with m invariant-nonnegative
                  -- and strictly bounded at this block's entry (the bound
                  -- makes +1 wrap-free, exactly the own-increment
                  -- argument), the whole block free of stores to m (so
                  -- the entry bound still describes m at this store), and
                  -- m never address-taken.
                  let m = if depth >= 1 { pipeline_ir_slot_store_offset_source(table, slot, value) } else { 0 - 1 }
                  let offset_ok = if m >= 0 {
                    if pipeline_ir_insts_store_slot_after(block_insts, m, 0 - 1, 0) == 0 and pipeline_ir_blocks_slot_addr_taken(all_blocks, m) == 0 {
                      if pipeline_ir_block_chain_slot_bound_above(pipeline_ir_block_entry_facts_block_chain(facts, block_id), table, m) == 1 {
                        pipeline_ir_slot_nonneg_invariant_depth(all_blocks, table, facts, m, dom_sets, dom_max, dom_words, depth - 1)
                      } else { 0 }
                    } else { 0 }
                  } else { 0 }
                  if offset_ok == 1 { state bor 1 } else { 0 - 1 }
                }
              }
            } else { state }
          }
          _ -> state
        }
        pipeline_ir_slot_nonneg_scan_insts(rest, block_insts, block_id, table, facts, slot, next, all_blocks, dom_sets, dom_max, dom_words, depth)
      }
    }
  }
}

fn pipeline_ir_blocks_slot_addr_taken(blocks: IrBlockList, slot: i64) -> i64 {
  let holder = alloc_words(1)
  mem_store64_at(holder, 0, 0)
  pipeline_ir_collect_addr_taken_slots(blocks, holder)
  pipeline_ir_hash_tree_contains(mem_load64_at(holder, 0), slot)
}

fn pipeline_ir_slot_nonneg_scan_blocks(blocks: IrBlockList, table: i64, facts: PipelineIrBlockEntryFactList, slot: i64, state: i64, all_blocks: IrBlockList, dom_sets: i64, dom_max: i64, dom_words: i64, depth: i64) -> i64 {
  match blocks {
    IrBlockListNil -> state
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          pipeline_ir_slot_nonneg_scan_blocks(rest, table, facts, slot, pipeline_ir_slot_nonneg_scan_insts(insts, insts, id, table, facts, slot, state, all_blocks, dom_sets, dom_max, dom_words, depth), all_blocks, dom_sets, dom_max, dom_words, depth)
        }
      }
    }
  }
}

fn pipeline_ir_slot_nonneg_invariant_depth(blocks: IrBlockList, table: i64, facts: PipelineIrBlockEntryFactList, slot: i64, dom_sets: i64, dom_max: i64, dom_words: i64, depth: i64) -> i64 {
  let state = pipeline_ir_slot_nonneg_scan_blocks(blocks, table, facts, slot, 0, blocks, dom_sets, dom_max, dom_words, depth)
  if state >= 1 { 1 } else { 0 }
}

fn pipeline_ir_slot_nonneg_invariant_with_dom(blocks: IrBlockList, table: i64, facts: PipelineIrBlockEntryFactList, slot: i64, dom_sets: i64, dom_max: i64, dom_words: i64) -> i64 {
  pipeline_ir_slot_nonneg_invariant_depth(blocks, table, facts, slot, dom_sets, dom_max, dom_words, 1)
}

fn pipeline_ir_slot_nonneg_invariant(blocks: IrBlockList, table: i64, facts: PipelineIrBlockEntryFactList, slot: i64) -> i64 {
  -- The dominating-fact path is available on the same small CFGs the
  -- propagated fact plane covers; larger functions keep the own-block
  -- gate only.
  let max_id = pipeline_ir_native_resident_max_block_id(blocks)
  let use_dom = if max_id >= 0 and max_id <= 63 and ir_block_list_len(blocks) <= pipeline_ir_block_entry_fact_effective_block_limit(blocks) { 1 } else { 0 }
  let dom_sets = if use_dom == 1 { pipeline_ir_dominators(blocks, max_id) } else { 0 }
  let dom_words = if use_dom == 1 { pipeline_ir_dominators_words(max_id) } else { 0 }
  pipeline_ir_slot_nonneg_invariant_with_dom(blocks, table, facts, slot, dom_sets, max_id, dom_words)
}

fn pipeline_ir_collect_store_slots(blocks: IrBlockList, seen: i64) -> i64 {
  match blocks {
    IrBlockListNil -> seen
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          pipeline_ir_collect_store_slots_insts(insts, seen)
        }
      }
      pipeline_ir_collect_store_slots(rest, seen)
    }
  }
}

fn pipeline_ir_collect_store_slots_insts(insts: IrInstList, seen: i64) -> i64 {
  match insts {
    IrInstNil -> seen
    IrInstCons(inst, rest) -> {
      match inst {
        IrStoreI64(slot_id, value) -> pipeline_ir_hash_nlist_add_unique(seen, slot_id)
        _ -> 0
      }
      pipeline_ir_collect_store_slots_insts(rest, seen)
    }
  }
}

fn pipeline_ir_seed_slot_nonneg_facts(blocks: IrBlockList, cfg: i64, facts: PipelineIrBlockEntryFactList, dom: i64) -> PipelineIrBlockEntryFactList {
  let table = pipeline_ir_cfg_bundle_def_table(cfg)
  let slots = nlist_new()
  pipeline_ir_collect_store_slots(blocks, slots)
  let n = nlist_len(slots)
  let max_id = pipeline_ir_native_resident_max_block_id(blocks)
  let use_dom = if n > 0 and max_id >= 0 and max_id <= 63 and ir_block_list_len(blocks) <= pipeline_ir_block_entry_fact_effective_block_limit(blocks) { 1 } else { 0 }
  let dom_sets = if use_dom == 1 { pipeline_ir_dom_handle_ensure(dom, blocks, max_id) } else { 0 }
  let dom_words = if use_dom == 1 { pipeline_ir_dom_handle_words(dom) } else { 0 }
  let mut result = facts
  let mut i = 0
  while i < n {
    let slot = nlist_get(slots, i)
    if pipeline_ir_slot_nonneg_invariant_with_dom(blocks, table, result, slot, dom_sets, max_id, dom_words) == 1 {
      result = pipeline_ir_seed_slot_nonneg_fact_blocks(blocks, slot, result)
    } else { 0 }
    i = i + 1
  }
  result
}

fn pipeline_ir_seed_slot_nonneg_fact_blocks(blocks: IrBlockList, slot: i64, facts: PipelineIrBlockEntryFactList) -> PipelineIrBlockEntryFactList {
  match blocks {
    IrBlockListNil -> facts
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          pipeline_ir_seed_slot_nonneg_fact_blocks(rest, slot, pipeline_ir_block_entry_fact_add_result_facts(pipeline_ir_block_entry_facts_add_slot_scalar(facts, id, slot, pipeline_ir_scalar_fact_kind_nonnegative(), 1)))
        }
      }
    }
  }
}

-- ══════════════════════════════════════════════════════════════
-- Slot upper-bound induction (decrement mirror of the nonneg rule):
-- slot k always holds a value < len(v) when every store is either
--   (a) load(m) - c with c a const in [0, 4095], where slot m carries a
--       vector-slot-upper fact for v AND a nonneg fact at the store's
--       block (m < len and m >= 0, so m - c < len and cannot wrap), or
--   (b) the single own-decrement load(k) - c, guarded by a k-lower-bound
--       comparison in a block that dominates the store and lies on every
--       cycle through it (so chained decrements cannot underflow-wrap:
--       each pass re-checks, and an intervening init leaves at least
--       -c, far above the integer minimum),
-- k is never address-taken, no store is a raw const (a const cannot be
-- compared to a runtime length), and every block in the function is
-- len-stable (lengths never shrink, so the seeded facts stay true).
-- ══════════════════════════════════════════════════════════════

fn pipeline_ir_chain_slot_bound_below(chain: PipelineIrBlockEntryFactChain, table: i64, slot: i64) -> i64 {
  match chain {
    PipelineIrBlockEntryFactNil -> 0
    PipelineIrBlockEntryCtorFact(fact_block, value_id, ctor_hash, rest) -> pipeline_ir_chain_slot_bound_below(rest, table, slot)
    PipelineIrBlockEntryNotCtorFact(fact_block, value_id, ctor_hash, rest) -> pipeline_ir_chain_slot_bound_below(rest, table, slot)
    PipelineIrBlockEntryScalarFact(fact_block, value_id, kind, value, rest) -> {
      let hit = if kind == pipeline_ir_scalar_fact_kind_bool() and value == 1 {
        let def = pipeline_ir_value_def_lookup(table, value_id)
        if def != 0 and node_f1(def) == 3 {
          -- ge(load, low): code 6, load on lhs; le(low, load): code 5,
          -- load on rhs. The low side must be a const >= 0.
          let load_operand = if node_f2(def) == 6 { node_f3(def) } else { if node_f2(def) == 5 { node_f4(def) } else { 0 - 1 } }
          let low_operand = if node_f2(def) == 6 { node_f4(def) } else { if node_f2(def) == 5 { node_f3(def) } else { 0 - 1 } }
          if load_operand >= 0 {
            let load_def = pipeline_ir_value_def_lookup(table, load_operand)
            let low_def = pipeline_ir_value_def_lookup(table, low_operand)
            if load_def != 0 and node_f1(load_def) == 6 and node_f2(load_def) == slot and low_def != 0 and node_f1(low_def) == 1 and node_f2(low_def) >= 0 { 1 } else { 0 }
          } else { 0 }
        } else { 0 }
      } else { 0 }
      if hit == 1 { 1 } else { pipeline_ir_chain_slot_bound_below(rest, table, slot) }
    }
    PipelineIrBlockEntrySlotScalarFact(fact_block, slot_id, kind, value, rest) -> pipeline_ir_chain_slot_bound_below(rest, table, slot)
    PipelineIrBlockEntryVectorLenFact(fact_block, len_value, vec_value, rest) -> pipeline_ir_chain_slot_bound_below(rest, table, slot)
    PipelineIrBlockEntryVectorUpperFact(fact_block, vec_value, index_value, rest) -> pipeline_ir_chain_slot_bound_below(rest, table, slot)
    PipelineIrBlockEntryVectorSlotUpperFact(fact_block, vec_value, slot_id, rest) -> pipeline_ir_chain_slot_bound_below(rest, table, slot)
    PipelineIrBlockEntryVectorSlotRowUpperFact(fact_block, vec_value, row_width, slot_id, rest) -> pipeline_ir_chain_slot_bound_below(rest, table, slot)
    PipelineIrBlockEntryVectorRowUpperFact(fact_block, vec_value, row_width, slot_id, rest) -> pipeline_ir_chain_slot_bound_below(rest, table, slot)
    PipelineIrBlockEntryVariantOriginFact(fact_block, value_id, ctor_hash, payloads, rest) -> pipeline_ir_chain_slot_bound_below(rest, table, slot)
  }
}

fn pipeline_ir_slot_bound_below_dominating(scan_blocks: IrBlockList, all_blocks: IrBlockList, table: i64, facts: PipelineIrBlockEntryFactList, slot: i64, store_block: i64, dom_sets: i64, dom_max: i64, dom_words: i64) -> i64 {
  match scan_blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          let own = if id == store_block { pipeline_ir_chain_slot_bound_below(pipeline_ir_block_entry_facts_block_chain(facts, id), table, slot) } else { 0 }
          let hit = if own == 1 { 1 } else {
            if id != store_block and dom_sets != 0 and id >= 0 and id <= dom_max and store_block >= 0 and store_block <= dom_max {
              if pipeline_ir_chain_slot_bound_below(pipeline_ir_block_entry_facts_block_chain(facts, id), table, slot) == 1 {
                if pipeline_ir_dominators_bit_get(dom_sets, dom_words, store_block, id) == 1 {
                  pipeline_ir_all_cycles_pass(all_blocks, dom_max, store_block, id)
                } else { 0 }
              } else { 0 }
            } else { 0 }
          }
          if hit == 1 { 1 } else { pipeline_ir_slot_bound_below_dominating(rest, all_blocks, table, facts, slot, store_block, dom_sets, dom_max, dom_words) }
        }
      }
    }
  }
}

-- First vector with a slot-upper fact for this slot at this block, or -1.
fn pipeline_ir_chain_slot_upper_vec(chain: PipelineIrBlockEntryFactChain, slot: i64) -> i64 {
  match chain {
    PipelineIrBlockEntryFactNil -> 0 - 1
    PipelineIrBlockEntryCtorFact(fact_block, value_id, ctor_hash, rest) -> pipeline_ir_chain_slot_upper_vec(rest, slot)
    PipelineIrBlockEntryNotCtorFact(fact_block, value_id, ctor_hash, rest) -> pipeline_ir_chain_slot_upper_vec(rest, slot)
    PipelineIrBlockEntryScalarFact(fact_block, value_id, kind, value, rest) -> pipeline_ir_chain_slot_upper_vec(rest, slot)
    PipelineIrBlockEntrySlotScalarFact(fact_block, slot_id, kind, value, rest) -> pipeline_ir_chain_slot_upper_vec(rest, slot)
    PipelineIrBlockEntryVectorLenFact(fact_block, len_value, vec_value, rest) -> pipeline_ir_chain_slot_upper_vec(rest, slot)
    PipelineIrBlockEntryVectorUpperFact(fact_block, vec_value, index_value, rest) -> pipeline_ir_chain_slot_upper_vec(rest, slot)
    PipelineIrBlockEntryVectorSlotUpperFact(fact_block, vec_value, fact_slot, rest) -> {
      if fact_slot == slot { vec_value } else { pipeline_ir_chain_slot_upper_vec(rest, slot) }
    }
    PipelineIrBlockEntryVectorSlotRowUpperFact(fact_block, vec_value, row_width, fact_slot, rest) -> pipeline_ir_chain_slot_upper_vec(rest, slot)
    PipelineIrBlockEntryVectorRowUpperFact(fact_block, vec_value, row_width, fact_slot, rest) -> pipeline_ir_chain_slot_upper_vec(rest, slot)
    PipelineIrBlockEntryVariantOriginFact(fact_block, value_id, ctor_hash, payloads, rest) -> pipeline_ir_chain_slot_upper_vec(rest, slot)
  }
}

-- Verdict node(0, ok, vec, saw_init, 0): ok = 0 reject; saw_init needed
-- because a decrement-only slot never acquires a bound.
fn pipeline_ir_slot_upper_scan_insts(insts: IrInstList, block_id: i64, table: i64, facts: PipelineIrBlockEntryFactList, slot: i64, state: i64, all_blocks: IrBlockList, dom_sets: i64, dom_max: i64, dom_words: i64) -> i64 {
  match insts {
    IrInstNil -> state
    IrInstCons(inst, rest) -> {
      if node_f1(state) == 0 { state }
      else {
        let next = match inst {
          IrAddressOfSlotI64(dst, slot_id) -> if slot_id == slot { node_new(0, 0, 0, 0, 0) } else { state }
          IrStoreI64(slot_id, value) -> {
            if slot_id == slot {
              let def = pipeline_ir_value_def_lookup(table, value)
              if def != 0 and node_f1(def) == 7 {
                let lhs_def = pipeline_ir_value_def_lookup(table, node_f3(def))
                let rhs_def = pipeline_ir_value_def_lookup(table, node_f4(def))
                let c_ok = if rhs_def != 0 and node_f1(rhs_def) == 1 and node_f2(rhs_def) >= 0 and node_f2(rhs_def) <= 4095 { 1 } else { 0 }
                if c_ok == 1 and lhs_def != 0 and node_f1(lhs_def) == 6 {
                  let m = node_f2(lhs_def)
                  if m == slot {
                    -- own decrement: needs the dominating lower-bound guard
                    if pipeline_ir_slot_bound_below_dominating(all_blocks, all_blocks, table, facts, slot, block_id, dom_sets, dom_max, dom_words) == 1 {
                      state
                    } else { node_new(0, 0, 0, 0, 0) }
                  } else {
                    -- init from a bounded, nonnegative slot
                    let chain = pipeline_ir_block_entry_facts_block_chain(facts, block_id)
                    let vec = pipeline_ir_chain_slot_upper_vec(chain, m)
                    let m_nonneg = pipeline_ir_block_entry_slot_scalar_fact_lookup(facts, block_id, m, pipeline_ir_scalar_fact_kind_nonnegative())
                    let nonneg_ok = if pipeline_ir_const_lookup_valid(m_nonneg) == 1 and pipeline_ir_const_lookup_value(m_nonneg) == 1 { 1 } else { 0 }
                    if vec >= 0 and nonneg_ok == 1 {
                      if node_f2(state) < 0 or node_f2(state) == vec {
                        node_new(0, 1, vec, 1, 0)
                      } else { node_new(0, 0, 0, 0, 0) }
                    } else { node_new(0, 0, 0, 0, 0) }
                  }
                } else { node_new(0, 0, 0, 0, 0) }
              } else { node_new(0, 0, 0, 0, 0) }
            } else { state }
          }
          _ -> state
        }
        pipeline_ir_slot_upper_scan_insts(rest, block_id, table, facts, slot, next, all_blocks, dom_sets, dom_max, dom_words)
      }
    }
  }
}

fn pipeline_ir_slot_upper_scan_blocks(blocks: IrBlockList, table: i64, facts: PipelineIrBlockEntryFactList, slot: i64, state: i64, all_blocks: IrBlockList, dom_sets: i64, dom_max: i64, dom_words: i64) -> i64 {
  match blocks {
    IrBlockListNil -> state
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          pipeline_ir_slot_upper_scan_blocks(rest, table, facts, slot, pipeline_ir_slot_upper_scan_insts(insts, id, table, facts, slot, state, all_blocks, dom_sets, dom_max, dom_words), all_blocks, dom_sets, dom_max, dom_words)
        }
      }
    }
  }
}

fn pipeline_ir_seed_slot_upper_fact_blocks(blocks: IrBlockList, vec: i64, slot: i64, facts: PipelineIrBlockEntryFactList) -> PipelineIrBlockEntryFactList {
  match blocks {
    IrBlockListNil -> facts
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          pipeline_ir_seed_slot_upper_fact_blocks(rest, vec, slot, pipeline_ir_block_entry_fact_add_result_facts(pipeline_ir_block_entry_facts_add_vector_slot_upper(facts, id, vec, slot)))
        }
      }
    }
  }
}

fn pipeline_ir_seed_slot_upper_facts(blocks: IrBlockList, cfg: i64, facts: PipelineIrBlockEntryFactList, dom: i64) -> PipelineIrBlockEntryFactList {
  if pipeline_ir_cfg_bundle_len_stable(cfg) == 0 { facts }
  else {
    let table = pipeline_ir_cfg_bundle_def_table(cfg)
    let slots = nlist_new()
    pipeline_ir_collect_store_slots(blocks, slots)
    let n = nlist_len(slots)
    let max_id = pipeline_ir_native_resident_max_block_id(blocks)
    let use_dom = if n > 0 and max_id >= 0 and max_id <= 63 and ir_block_list_len(blocks) <= pipeline_ir_block_entry_fact_effective_block_limit(blocks) { 1 } else { 0 }
    if use_dom == 0 { facts }
    else {
      let dom_sets = pipeline_ir_dom_handle_ensure(dom, blocks, max_id)
      let dom_words = pipeline_ir_dom_handle_words(dom)
      let mut result = facts
      let mut i = 0
      while i < n {
        let slot = nlist_get(slots, i)
        let verdict = pipeline_ir_slot_upper_scan_blocks(blocks, table, result, slot, node_new(0, 1, 0 - 1, 0, 0), blocks, dom_sets, max_id, dom_words)
        if node_f1(verdict) == 1 and node_f3(verdict) == 1 and node_f2(verdict) >= 0 {
          result = pipeline_ir_seed_slot_upper_fact_blocks(blocks, node_f2(verdict), slot, result)
        } else { 0 }
        i = i + 1
      }
      result
    }
  }
}

fn pipeline_ir_chain_collect_row_upper(chain: PipelineIrBlockEntryFactChain, block_id: i64, out: i64) -> i64 {
  match chain {
    PipelineIrBlockEntryFactNil -> 0
    PipelineIrBlockEntryCtorFact(fact_block, value_id, ctor_hash, rest) -> pipeline_ir_chain_collect_row_upper(rest, block_id, out)
    PipelineIrBlockEntryNotCtorFact(fact_block, value_id, ctor_hash, rest) -> pipeline_ir_chain_collect_row_upper(rest, block_id, out)
    PipelineIrBlockEntryScalarFact(fact_block, value_id, kind, value, rest) -> pipeline_ir_chain_collect_row_upper(rest, block_id, out)
    PipelineIrBlockEntrySlotScalarFact(fact_block, slot_id, kind, value, rest) -> pipeline_ir_chain_collect_row_upper(rest, block_id, out)
    PipelineIrBlockEntryVectorLenFact(fact_block, len_value, vec_value, rest) -> pipeline_ir_chain_collect_row_upper(rest, block_id, out)
    PipelineIrBlockEntryVectorUpperFact(fact_block, vec_value, index_value, rest) -> pipeline_ir_chain_collect_row_upper(rest, block_id, out)
    PipelineIrBlockEntryVectorSlotUpperFact(fact_block, vec_value, slot_id, rest) -> pipeline_ir_chain_collect_row_upper(rest, block_id, out)
    PipelineIrBlockEntryVectorSlotRowUpperFact(fact_block, vec_value, row_width, slot_id, rest) -> {
      if fact_block == block_id { nlist_add(out, node_new(0, block_id, vec_value, row_width, slot_id)) } else { 0 }
      pipeline_ir_chain_collect_row_upper(rest, block_id, out)
    }
    PipelineIrBlockEntryVectorRowUpperFact(fact_block, vec_value, row_width, value_id, rest) -> pipeline_ir_chain_collect_row_upper(rest, block_id, out)
    PipelineIrBlockEntryVariantOriginFact(fact_block, value_id, ctor_hash, payloads, rest) -> pipeline_ir_chain_collect_row_upper(rest, block_id, out)
  }
}

fn pipeline_ir_flood_collect_store_pairs_insts(insts: IrInstList, block_id: i64, out: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      match inst {
        IrStoreI64(slot_id, value) -> nlist_add(out, node_new(0, block_id, slot_id, 0, 0))
        _ -> 0
      }
      pipeline_ir_flood_collect_store_pairs_insts(rest, block_id, out)
    }
  }
}

-- Loads of row-bounded, invariant-nonnegative slots become value-keyed
-- row facts (0 <= v < len(vec)/w): the loaded value is immutable, so
-- the fact survives every block len-stability allows. `stored` tracks
-- slots already stored earlier in this block (their entry facts no
-- longer describe a later load).
fn pipeline_ir_flood_collect_value_tuples_insts(insts: IrInstList, block_id: i64, facts: PipelineIrBlockEntryFactList, tuples: i64, nt: i64, stored: i64, out: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      match inst {
        IrStoreI64(slot_id, value) -> nlist_add(stored, slot_id)
        IrLoadI64(dst, slot_id) -> {
          let mut seen = 0
          let mut k = 0
          let nk = nlist_len(stored)
          while k < nk {
            if nlist_get(stored, k) == slot_id { seen = 1 } else { 0 }
            k = k + 1
          }
          if seen == 0 {
            let mut t = 0
            while t < nt {
              let tuple = nlist_get(tuples, t)
              if node_f1(tuple) == block_id and node_f4(tuple) == slot_id {
                let nonneg = pipeline_ir_block_entry_slot_scalar_fact_lookup(facts, block_id, slot_id, pipeline_ir_scalar_fact_kind_nonnegative())
                if pipeline_ir_const_lookup_valid(nonneg) == 1 and pipeline_ir_const_lookup_value(nonneg) == 1 {
                  nlist_add(out, node_new(0, block_id, node_f2(tuple), node_f3(tuple), dst))
                } else { 0 }
              } else { 0 }
              t = t + 1
            }
            0
          } else { 0 }
        }
        _ -> 0
      }
      pipeline_ir_flood_collect_value_tuples_insts(rest, block_id, facts, tuples, nt, stored, out)
    }
  }
}

-- Dominator-flooding for row-upper slot facts: a fact established at a
-- block D's entry also holds at every block B dominated by D, provided
-- no path from D to B (taking the LAST visit of D on any entry->B path,
-- which exists by dominance) can pass a store to the slot or a
-- len-unstable block without re-entering D, and D itself is store-free
-- and len-stable. Edge propagation cannot carry facts into multi-pred
-- loop headers; this pass reads them across those joins soundly.
fn pipeline_ir_flood_slot_row_upper_facts(blocks: IrBlockList, cfg: i64, facts: PipelineIrBlockEntryFactList, dom: i64) -> PipelineIrBlockEntryFactList {
  let n = ir_block_list_len(blocks)
  let max_id = pipeline_ir_native_resident_max_block_id(blocks)
  if n > pipeline_ir_block_entry_fact_effective_block_limit(blocks) or max_id < 0 or max_id > 63 { facts }
  else {
    -- one walk: row tuples per block, per-block stability, store pairs
    let tuples = nlist_new()
    let block_ids = nlist_new()
    let unstable_ids = nlist_new()
    let store_pairs = nlist_new()
    let mut cur = blocks
    let mut walking = 1
    while walking == 1 {
      match cur {
        IrBlockListNil -> { walking = 0 }
        IrBlockListCons(block, rest) -> {
          match block {
            IrBlock(id, params, insts, term) -> {
              pipeline_ir_chain_collect_row_upper(pipeline_ir_block_entry_facts_block_chain(facts, id), id, tuples)
              nlist_add(block_ids, id)
              if pipeline_ir_cfg_bundle_block_len_stable(cfg, id) == 0 { nlist_add(unstable_ids, id) } else { 0 }
              pipeline_ir_flood_collect_store_pairs_insts(insts, id, store_pairs)
            }
          }
          cur = rest
        }
      }
    }
    let nt = nlist_len(tuples)
    if nt == 0 { facts }
    else {
      let dom_sets = pipeline_ir_dom_handle_ensure(dom, blocks, max_id)
      let dom_words = pipeline_ir_dom_handle_words(dom)
      let nb = nlist_len(block_ids)
      let nu = nlist_len(unstable_ids)
      let ns = nlist_len(store_pairs)
      -- second walk: value-keyed tuples from loads of row-bounded slots
      let value_tuples = nlist_new()
      let mut vcur = blocks
      let mut vwalking = 1
      while vwalking == 1 {
        match vcur {
          IrBlockListNil -> { vwalking = 0 }
          IrBlockListCons(vblock, vrest) -> {
            match vblock {
              IrBlock(vid, vparams, vinsts, vterm) -> {
                let stored = nlist_new()
                pipeline_ir_flood_collect_value_tuples_insts(vinsts, vid, facts, tuples, nt, stored, value_tuples)
              }
            }
            vcur = vrest
          }
        }
      }
      let mut result = facts
      -- spread value tuples: immutable values, so only len stability
      -- and dominance gate the spread; the defining block D also gets
      -- the fact for same-block consumption.
      let nvt = nlist_len(value_tuples)
      let mut vt = 0
      while vt < nvt {
        let vtuple = nlist_get(value_tuples, vt)
        let vd = node_f1(vtuple)
        let vvec = node_f2(vtuple)
        let vwidth = node_f3(vtuple)
        let vval = node_f4(vtuple)
        let mut vd_ok = 1
        let mut vu = 0
        while vu < nu {
          if nlist_get(unstable_ids, vu) == vd { vd_ok = 0 } else { 0 }
          vu = vu + 1
        }
        if vd_ok == 1 {
          result = pipeline_ir_block_entry_fact_add_result_facts(pipeline_ir_block_entry_facts_add_vector_row_upper(result, vd, vvec, vwidth, vval))
          let mut vb = 0
          while vb < nb {
            let vtarget = nlist_get(block_ids, vb)
            if vtarget != vd and vtarget >= 0 and vtarget <= max_id and vd >= 0 and vd <= max_id and pipeline_ir_dominators_bit_get(dom_sets, dom_words, vtarget, vd) == 1 {
              let mut vok = 1
              let mut vu2 = 0
              while vu2 < nu and vok == 1 {
                let vx = nlist_get(unstable_ids, vu2)
                if vx != vd and pipeline_ir_block_reaches_avoiding(blocks, max_id, vx, vtarget, vd) == 1 { vok = 0 } else { 0 }
                vu2 = vu2 + 1
              }
              if vok == 1 {
                result = pipeline_ir_block_entry_fact_add_result_facts(pipeline_ir_block_entry_facts_add_vector_row_upper(result, vtarget, vvec, vwidth, vval))
              } else { 0 }
            } else { 0 }
            vb = vb + 1
          }
        } else { 0 }
        vt = vt + 1
      }
      let mut t = 0
      while t < nt {
        let tuple = nlist_get(tuples, t)
        let d = node_f1(tuple)
        let vec = node_f2(tuple)
        let width = node_f3(tuple)
        let slot = node_f4(tuple)
        -- D itself must be store-free for the slot, len-stable, and the
        -- slot never address-taken (hidden writes).
        let mut d_ok = if pipeline_ir_cfg_bundle_slot_addr_taken(cfg, slot) == 1 { 0 } else { 1 }
        let mut u = 0
        while u < nu {
          if nlist_get(unstable_ids, u) == d { d_ok = 0 } else { 0 }
          u = u + 1
        }
        let mut s = 0
        while s < ns {
          let pair = nlist_get(store_pairs, s)
          if node_f1(pair) == d and node_f2(pair) == slot { d_ok = 0 } else { 0 }
          s = s + 1
        }
        if d_ok == 1 {
          let mut b = 0
          while b < nb {
            let target = nlist_get(block_ids, b)
            if target != d and target >= 0 and target <= max_id and d >= 0 and d <= max_id and pipeline_ir_dominators_bit_get(dom_sets, dom_words, target, d) == 1 {
              let mut ok = 1
              let mut u2 = 0
              while u2 < nu and ok == 1 {
                let x = nlist_get(unstable_ids, u2)
                if x != d and pipeline_ir_block_reaches_avoiding(blocks, max_id, x, target, d) == 1 { ok = 0 } else { 0 }
                u2 = u2 + 1
              }
              let mut s2 = 0
              while s2 < ns and ok == 1 {
                let pair2 = nlist_get(store_pairs, s2)
                if node_f2(pair2) == slot and node_f1(pair2) != d {
                  if pipeline_ir_block_reaches_avoiding(blocks, max_id, node_f1(pair2), target, d) == 1 { ok = 0 } else { 0 }
                } else { 0 }
                s2 = s2 + 1
              }
              if ok == 1 {
                result = pipeline_ir_block_entry_fact_add_result_facts(pipeline_ir_block_entry_facts_add_vector_slot_row_upper(result, target, vec, width, slot))
              } else { 0 }
            } else { 0 }
            b = b + 1
          }
        } else { 0 }
        t = t + 1
      }
      result
    }
  }
}




fn pipeline_ir_block_entry_facts_from_blocks_with_pure(blocks: IrBlockList, pure_callees: i64) -> PipelineIrBlockEntryFactList {
  let pred_counts = pipeline_ir_cfg_fact_bundle_with_pure(blocks, pure_callees)
  let seed = pipeline_ir_block_entry_facts_from_blocks_inner(blocks, blocks, pred_counts, pipeline_ir_block_entry_facts_empty())
  let block_count = ir_block_list_len(blocks)
  let propagated = if block_count <= pipeline_ir_block_entry_fact_effective_block_limit(blocks) {
    pipeline_ir_block_entry_facts_propagate_fixpoint(blocks, pred_counts, seed, block_count + 1)
  } else {
    seed
  }
  -- Slot induction runs against the propagated plane so the increment
  -- store's block already carries the loop guard's bound fact; the upper
  -- induction runs after nonneg because its init leg consumes the seeded
  -- nonneg facts. Row-upper flooding runs last: it carries guard-seeded
  -- row bounds into dominated blocks that edge propagation cannot reach.
  -- One shared dominator handle serves all three seeders (A10).
  let dom = pipeline_ir_dom_handle_new()
  let with_nonneg = pipeline_ir_seed_slot_nonneg_facts(blocks, pred_counts, propagated, dom)
  let with_upper = pipeline_ir_seed_slot_upper_facts(blocks, pred_counts, with_nonneg, dom)
  pipeline_ir_flood_slot_row_upper_facts(blocks, pred_counts, with_upper, dom)
}

fn pipeline_ir_block_entry_facts_from_blocks(blocks: IrBlockList) -> PipelineIrBlockEntryFactList {
  pipeline_ir_block_entry_facts_from_blocks_with_pure(blocks, 0)
}

fn pipeline_ir_block_entry_fact_count_blocks(blocks: IrBlockList) -> i64 {
  pipeline_ir_block_entry_facts_count(pipeline_ir_block_entry_facts_from_blocks(blocks))
}

fn pipeline_ir_block_entry_fact_count_functions(functions: IrFunctionList) -> i64 {
  match functions {
    IrFunctionNil -> 0
    IrFunctionCons(f, rest) -> {
      match f {
        IrFunction(hash, params, blocks, src) -> pipeline_ir_block_entry_fact_count_blocks(blocks) + pipeline_ir_block_entry_fact_count_functions(rest)
      }
    }
  }
}

fn pipeline_ir_effect_flags_merge(a: i64, b: i64) -> i64 {
  let alloc = if cg_mask_has(a, 0) == 1 or cg_mask_has(b, 0) == 1 { 1 } else { 0 }
  let unsafe = if cg_mask_has(a, 1) == 1 or cg_mask_has(b, 1) == 1 { 1 } else { 0 }
  let has_perform = if cg_mask_has(a, 2) == 1 or cg_mask_has(b, 2) == 1 { 1 } else { 0 }
  let memory = if cg_mask_has(a, 3) == 1 or cg_mask_has(b, 3) == 1 { 1 } else { 0 }
  alloc + unsafe * 2 + has_perform * 4 + memory * 8
}

fn pipeline_ir_effect_scan(flags: i64, callees: i64) -> i64 {
  node_new(0, flags, callees, 0, 0)
}

fn pipeline_ir_effect_scan_flags(scan: i64) -> i64 {
  if scan == 0 { 0 } else { node_f1(scan) }
}

fn pipeline_ir_effect_scan_callees(scan: i64) -> i64 {
  if scan == 0 { 0 } else { node_f2(scan) }
}

fn pipeline_ir_effect_hash_cons(hash: i64, rest: i64) -> i64 {
  node_new(0, hash, rest, 0, 0)
}

fn pipeline_ir_effect_hash_list_merge(a: i64, b: i64) -> i64 {
  if a == 0 { b }
  else { if b == 0 { a }
  else { node_new(0, 0 - 1, a, b, 0) } }
}

fn pipeline_ir_effect_hash_list_contains(list: i64, hash: i64) -> i64 {
  if list == 0 { 0 }
  else { if node_f1(list) == hash { 1 }
  else { pipeline_ir_effect_hash_list_contains(node_f2(list), hash) } }
}

fn pipeline_ir_effect_hash_tree_unique_into(tree: i64, acc: i64) -> i64 {
  if tree == 0 { acc }
  else { if node_f1(tree) == 0 - 1 {
    pipeline_ir_effect_hash_tree_unique_into(node_f3(tree), pipeline_ir_effect_hash_tree_unique_into(node_f2(tree), acc))
  }
  else {
    let with_head = if pipeline_ir_effect_hash_list_contains(acc, node_f1(tree)) == 1 { acc } else { pipeline_ir_effect_hash_cons(node_f1(tree), acc) }
    pipeline_ir_effect_hash_tree_unique_into(node_f2(tree), with_head)
  } }
}

fn pipeline_ir_effect_hash_tree_unique(tree: i64) -> i64 {
  pipeline_ir_effect_hash_tree_unique_into(tree, 0)
}

fn pipeline_ir_effect_scan_merge(a: i64, b: i64) -> i64 {
  pipeline_ir_effect_scan(
    pipeline_ir_effect_flags_merge(pipeline_ir_effect_scan_flags(a), pipeline_ir_effect_scan_flags(b)),
    pipeline_ir_effect_hash_list_merge(pipeline_ir_effect_scan_callees(a), pipeline_ir_effect_scan_callees(b))
  )
}

fn pipeline_ir_effect_scan_flag(flags: i64) -> i64 {
  pipeline_ir_effect_scan(flags, 0)
}

fn pipeline_ir_effect_scan_callee(hash: i64) -> i64 {
  pipeline_ir_effect_scan(0, pipeline_ir_effect_hash_cons(hash, 0))
}

fn pipeline_ir_effect_summary_prepend(hash: i64, direct_flags: i64, callees: i64, rest: i64) -> i64 {
  node_new(0, hash, direct_flags, callees, rest)
}

fn pipeline_ir_hash_nlist_add_unique(list: i64, hash: i64) -> i64 {
  let mut found = 0
  let n = nlist_len(list)
  for i in 0..n {
    if nlist_get(list, i) == hash { found = 1 } else { 0 }
  }
  if found == 0 {
    nlist_add(list, hash)
    1
  } else {
    0
  }
}

fn pipeline_ir_hash_tree_add_unique(holder: i64, hash: i64) -> i64 {
  let root = mem_load64_at(holder, 0)
  if root == 0 {
    mem_store64_at(holder, 0, node_new(0, hash, 0, 0, 0))
    1
  } else {
    let mut cur = root
    let mut result = 0 - 1
    while result < 0 {
      let cur_hash = node_f1(cur)
      if hash == cur_hash {
        result = 0
      } else {
        let side = if hash < cur_hash { 24 } else { 32 }
        let child = mem_load64_at(cur + side, 0)
        if child == 0 {
          mem_store64_at(cur + side, 0, node_new(0, hash, 0, 0, 0))
          result = 1
        } else {
          cur = child
        }
      }
    }
    result
  }
}

fn pipeline_ir_effect_callee_list_copy_unique_into(from: i64, into: i64) -> i64 {
  let n = nlist_len(from)
  for i in 0..n {
    pipeline_ir_hash_nlist_add_unique(into, nlist_get(from, i))
  }
  into
}

fn pipeline_ir_effect_summary_merge_into(hash: i64, direct_flags: i64, callees: i64, summaries: i64) -> i64 {
  let mut cur = summaries
  let mut merged = 0
  while cur != 0 and merged == 0 {
    if node_f1(cur) == hash {
      mem_store64_at(cur, 16, pipeline_ir_effect_flags_merge(node_f2(cur), direct_flags))
      pipeline_ir_effect_callee_list_copy_unique_into(callees, node_f3(cur))
      merged = 1
    } else {
      cur = node_f4(cur)
    }
  }
  merged
}

fn pipeline_ir_effect_flag_map_lookup_or(flags: i64, hash: i64, default: i64) -> i64 {
  let mut cur = flags
  let mut result = default
  while cur != 0 {
    let cur_hash = node_f1(cur)
    if cur_hash == hash {
      result = node_f2(cur)
      cur = 0
    } else {
      cur = if hash < cur_hash { node_f3(cur) } else { node_f4(cur) }
    }
  }
  result
}

fn pipeline_ir_effect_summary_callee_flags(callees: i64, flags: i64) -> i64 {
  let mut result = 0
  if callees == 0 {
    result
  } else {
    let n = nlist_len(callees)
    for i in 0..n {
      let callee = nlist_get(callees, i)
      result = pipeline_ir_effect_flags_merge(result, pipeline_ir_effect_flag_map_lookup_or(flags, callee, 4))
    }
    result
  }
}

fn pipeline_ir_effect_summary_flags_seed(summaries: i64, flags: i64) -> i64 {
  let mut cur = summaries
  let mut map = flags
  while cur != 0 {
    map = pipeline_ir_effect_flag_map_prepend(node_f1(cur), node_f2(cur), map)
    cur = node_f4(cur)
  }
  map
}

fn pipeline_ir_effect_summary_flags_step(summaries: i64, map: i64) -> i64 {
  -- In-place monotone update pass: flags only grow under merge, so
  -- seeing earlier updates from the same sweep only speeds convergence
  -- to the same least fixpoint.
  let mut cur = summaries
  let mut changed = 0
  while cur != 0 {
    let hash = node_f1(cur)
    let old = pipeline_ir_effect_flag_map_lookup(map, hash)
    let flags = pipeline_ir_effect_flags_merge(node_f2(cur), pipeline_ir_effect_summary_callee_flags(node_f3(cur), map))
    if flags != old {
      pipeline_ir_effect_flag_map_prepend(hash, flags, map)
      changed = 1
    } else { 0 }
    cur = node_f4(cur)
  }
  changed
}

fn pipeline_ir_effect_summary_flags_fixpoint(summaries: i64, old_flags: i64) -> i64 {
  let map = pipeline_ir_effect_summary_flags_seed(summaries, old_flags)
  let mut done = 0
  while done == 0 {
    if pipeline_ir_effect_summary_flags_step(summaries, map) == 0 { done = 1 } else { 0 }
  }
  map
}

fn pipeline_ir_effect_flag_map_lookup(flags: i64, hash: i64) -> i64 {
  let mut cur = flags
  let mut result = 0
  while cur != 0 {
    let cur_hash = node_f1(cur)
    if cur_hash == hash {
      result = node_f2(cur)
      cur = 0
    } else {
      cur = if hash < cur_hash { node_f3(cur) } else { node_f4(cur) }
    }
  }
  result
}

-- BST keyed by hash; an insert on an existing hash merges the flags,
-- preserving the old multi-entry merge-on-read semantics.
fn pipeline_ir_effect_flag_map_prepend(hash: i64, flags: i64, rest: i64) -> i64 {
  let leaf = node_new(0, hash, flags, 0, 0)
  if rest == 0 { leaf }
  else {
    let mut cur = rest
    let mut done = 0
    while done == 0 {
      let cur_hash = node_f1(cur)
      if hash == cur_hash {
        mem_store64_at(cur, 16, pipeline_ir_effect_flags_merge(node_f2(cur), flags))
        done = 1
      } else { if hash < cur_hash {
        if node_f3(cur) == 0 {
          mem_store64_at(cur, 24, leaf)
          done = 1
        } else { cur = node_f3(cur) }
      } else {
        if node_f4(cur) == 0 {
          mem_store64_at(cur, 32, leaf)
          done = 1
        } else { cur = node_f4(cur) }
      } }
    }
    rest
  }
}

fn pipeline_ir_typed_effect_expr_list_flags(exprs: ExprList, src: i64, fn_flags: i64) -> i64 {
  match exprs {
    ExprListNil -> 0
    ExprListCons(expr, rest) -> pipeline_ir_effect_flags_merge(pipeline_ir_typed_effect_expr_flags(expr, src, fn_flags), pipeline_ir_typed_effect_expr_list_flags(rest, src, fn_flags))
  }
}

fn pipeline_ir_typed_effect_record_field_flags(field: RecordField, src: i64, fn_flags: i64) -> i64 {
  match field {
    RecordField(ns, nl, value, fact) -> pipeline_ir_typed_effect_expr_flags(value, src, fn_flags)
    UnknownRecordField(tag) -> 2
  }
}

fn pipeline_ir_typed_effect_record_fields_flags(fields: RecordFieldList, src: i64, fn_flags: i64) -> i64 {
  match fields {
    RecordFieldListNil -> 0
    RecordFieldListCons(field, rest) -> pipeline_ir_effect_flags_merge(pipeline_ir_typed_effect_record_field_flags(field, src, fn_flags), pipeline_ir_typed_effect_record_fields_flags(rest, src, fn_flags))
  }
}

fn pipeline_ir_typed_effect_match_arm_flags(arm: MatchArm, src: i64, fn_flags: i64) -> i64 {
  match arm {
    Arm(pattern, body, guard, has_guard) -> {
      let guard_flags = if has_guard == 0 { 0 } else { pipeline_ir_typed_effect_expr_flags(guard, src, fn_flags) }
      pipeline_ir_effect_flags_merge(pipeline_ir_typed_effect_expr_flags(body, src, fn_flags), guard_flags)
    }
    UnknownArm(tag) -> 2
  }
}

fn pipeline_ir_typed_effect_match_arms_flags(arms: MatchArmList, src: i64, fn_flags: i64) -> i64 {
  match arms {
    MatchArmListNil -> 0
    MatchArmListCons(arm, rest) -> pipeline_ir_effect_flags_merge(pipeline_ir_typed_effect_match_arm_flags(arm, src, fn_flags), pipeline_ir_typed_effect_match_arms_flags(rest, src, fn_flags))
  }
}

fn pipeline_ir_typed_effect_handler_clause_flags(clause: HandlerClause, src: i64, fn_flags: i64) -> i64 {
  match clause {
    HandlerClause(name_info, params, body, continuation) -> pipeline_ir_typed_effect_expr_flags(body, src, fn_flags)
    UnknownHandlerClause(tag) -> 2
  }
}

fn pipeline_ir_typed_effect_handler_clauses_flags(clauses: HandlerClauseList, src: i64, fn_flags: i64) -> i64 {
  match clauses {
    HandlerClauseListNil -> 0
    HandlerClauseListCons(clause, rest) -> pipeline_ir_effect_flags_merge(pipeline_ir_typed_effect_handler_clause_flags(clause, src, fn_flags), pipeline_ir_typed_effect_handler_clauses_flags(rest, src, fn_flags))
  }
}

fn pipeline_ir_typed_effect_named_call_flags(ns: i64, nl: i64, args: ExprList, src: i64, fn_flags: i64) -> i64 {
  let pure_intrinsic = intrinsic_pure_effect_call_name(src, ns, nl)
  let direct_flags = intrinsic_semantic_effect_flags(src, ns, nl)
  let callee_flags = if pure_intrinsic == 1 {
    0
  } else {
    if direct_flags != 0 { 0 } else { pipeline_ir_effect_flag_map_lookup(fn_flags, str_hash(src, ns, nl)) }
  }
  let arg_flags = pipeline_ir_typed_effect_expr_list_flags(args, src, fn_flags)
  pipeline_ir_effect_flags_merge(pipeline_ir_effect_flags_merge(direct_flags, callee_flags), arg_flags)
}

fn pipeline_ir_typed_effect_call_flags(expr: Expr, src: i64, fn_flags: i64) -> i64 {
  match expr {
    Call(ns, nl, args) -> pipeline_ir_typed_effect_named_call_flags(ns, nl, args, src, fn_flags)
    GenericCall(type_args, inner_call) -> pipeline_ir_typed_effect_call_flags(inner_call, src, fn_flags)
    _ -> pipeline_ir_typed_effect_expr_flags(expr, src, fn_flags)
  }
}

fn pipeline_ir_typed_effect_expr_flags(expr: Expr, src: i64, fn_flags: i64) -> i64 {
  match expr {
    IntLit(value, start, len) -> 0
    StringLit(start, len) -> 0
    BoolLit(value) -> 0
    FloatLit(start, len) -> 0
    Ident(ns, nl) -> 0
    BinOp(op, lhs, rhs) -> pipeline_ir_effect_flags_merge(pipeline_ir_typed_effect_expr_flags(lhs, src, fn_flags), pipeline_ir_typed_effect_expr_flags(rhs, src, fn_flags))
    Call(ns, nl, args) -> pipeline_ir_typed_effect_named_call_flags(ns, nl, args, src, fn_flags)
    GenericCall(type_args, inner_call) -> pipeline_ir_typed_effect_call_flags(inner_call, src, fn_flags)
    If(cond, then_expr, else_expr) -> pipeline_ir_effect_flags_merge(pipeline_ir_effect_flags_merge(pipeline_ir_typed_effect_expr_flags(cond, src, fn_flags), pipeline_ir_typed_effect_expr_flags(then_expr, src, fn_flags)), pipeline_ir_typed_effect_expr_flags(else_expr, src, fn_flags))
    While(cond, body) -> pipeline_ir_effect_flags_merge(pipeline_ir_typed_effect_expr_flags(cond, src, fn_flags), pipeline_ir_typed_effect_expr_flags(body, src, fn_flags))
    Loop(body) -> pipeline_ir_typed_effect_expr_flags(body, src, fn_flags)
    Break(value) -> pipeline_ir_typed_effect_expr_flags(value, src, fn_flags)
    BreakNoValue -> 0
    Continue -> 0
    Return(value) -> pipeline_ir_typed_effect_expr_flags(value, src, fn_flags)
    ReturnNoValue -> 0
    Defer(cleanup, body) -> pipeline_ir_effect_flags_merge(pipeline_ir_typed_effect_expr_flags(cleanup, src, fn_flags), pipeline_ir_typed_effect_expr_flags(body, src, fn_flags))
    Let(ns, nl, value, body) -> pipeline_ir_effect_flags_merge(pipeline_ir_typed_effect_expr_flags(value, src, fn_flags), pipeline_ir_typed_effect_expr_flags(body, src, fn_flags))
    LetMut(ns, nl, value, body) -> pipeline_ir_effect_flags_merge(pipeline_ir_typed_effect_expr_flags(value, src, fn_flags), pipeline_ir_typed_effect_expr_flags(body, src, fn_flags))
    Assign(ns, nl, value) -> pipeline_ir_typed_effect_expr_flags(value, src, fn_flags)
    AddressOf(mutable, target) -> pipeline_ir_effect_flags_merge(2, pipeline_ir_typed_effect_expr_flags(target, src, fn_flags))
    Deref(ptr) -> pipeline_ir_effect_flags_merge(2, pipeline_ir_typed_effect_expr_flags(ptr, src, fn_flags))
    PtrAssign(ptr, value) -> pipeline_ir_effect_flags_merge(2, pipeline_ir_effect_flags_merge(pipeline_ir_typed_effect_expr_flags(ptr, src, fn_flags), pipeline_ir_typed_effect_expr_flags(value, src, fn_flags)))
    Block(first, rest) -> pipeline_ir_effect_flags_merge(pipeline_ir_typed_effect_expr_flags(first, src, fn_flags), pipeline_ir_typed_effect_expr_flags(rest, src, fn_flags))
    FieldAccess(base, field_ns, field_nl, fact) -> pipeline_ir_typed_effect_expr_flags(base, src, fn_flags)
    IndexedLen(base, fixed_len) -> pipeline_ir_typed_effect_expr_flags(base, src, fn_flags)
    IndexedGet(base, index, element_ty, fixed_len) -> pipeline_ir_effect_flags_merge(pipeline_ir_typed_effect_expr_flags(base, src, fn_flags), pipeline_ir_typed_effect_expr_flags(index, src, fn_flags))
    IndexedSet(base, index, value, fact) -> pipeline_ir_effect_flags_merge(pipeline_ir_typed_effect_expr_flags(base, src, fn_flags), pipeline_ir_effect_flags_merge(pipeline_ir_typed_effect_expr_flags(index, src, fn_flags), pipeline_ir_typed_effect_expr_flags(value, src, fn_flags)))
    IndexedSlice(base, start, end, fact) -> pipeline_ir_effect_flags_merge(pipeline_ir_typed_effect_expr_flags(base, src, fn_flags), pipeline_ir_effect_flags_merge(pipeline_ir_typed_effect_expr_flags(start, src, fn_flags), pipeline_ir_typed_effect_expr_flags(end, src, fn_flags)))
    RecordInit(type_ns, type_nl, fields) -> pipeline_ir_typed_effect_record_fields_flags(fields, src, fn_flags)
    ArrayLiteral(elements, resolved_ty, span) -> pipeline_ir_typed_effect_expr_list_flags(elements, src, fn_flags)
    Match(scrutinee, arms) -> pipeline_ir_effect_flags_merge(pipeline_ir_typed_effect_expr_flags(scrutinee, src, fn_flags), pipeline_ir_typed_effect_match_arms_flags(arms, src, fn_flags))
    Not(operand) -> pipeline_ir_typed_effect_expr_flags(operand, src, fn_flags)
    Lambda(params, body) -> pipeline_ir_typed_effect_expr_flags(body, src, fn_flags)
    Perform(lhs, op_ns, op_nl, args) -> pipeline_ir_effect_flags_merge(4, pipeline_ir_effect_flags_merge(pipeline_ir_typed_effect_expr_flags(lhs, src, fn_flags), pipeline_ir_typed_effect_expr_list_flags(args, src, fn_flags)))
    Handle(body, clauses, hret) -> pipeline_ir_effect_flags_merge(pipeline_ir_typed_effect_expr_flags(body, src, fn_flags), pipeline_ir_effect_flags_merge(pipeline_ir_typed_effect_handler_clauses_flags(clauses, src, fn_flags), match hret { NoHandleReturn -> 0 HandleReturnClause(rns, rnl, rb) -> pipeline_ir_typed_effect_expr_flags(rb, src, fn_flags) }))
    Resume(value) -> pipeline_ir_typed_effect_expr_flags(value, src, fn_flags)
    MethodCall(recv, method_hash, args, type_hash) -> pipeline_ir_effect_flags_merge(2, pipeline_ir_effect_flags_merge(pipeline_ir_typed_effect_expr_flags(recv, src, fn_flags), pipeline_ir_typed_effect_expr_list_flags(args, src, fn_flags)))
    Try(inner, effect_atom) -> pipeline_ir_effect_flags_merge(4, pipeline_ir_typed_effect_expr_flags(inner, src, fn_flags))
    InterpConcat(left, right) -> pipeline_ir_effect_flags_merge(pipeline_ir_typed_effect_expr_flags(left, src, fn_flags), pipeline_ir_typed_effect_expr_flags(right, src, fn_flags))
    ForIter(var_ns, var_nl, collection, body) -> pipeline_ir_effect_flags_merge(pipeline_ir_typed_effect_expr_flags(collection, src, fn_flags), pipeline_ir_typed_effect_expr_flags(body, src, fn_flags))
    OptChain(base, field_ns, field_nl, effect_atom) -> pipeline_ir_effect_flags_merge(4, pipeline_ir_typed_effect_expr_flags(base, src, fn_flags))
    LetTyped(inner, ann_type) -> pipeline_ir_typed_effect_expr_flags(inner, src, fn_flags)
    NilExpr -> 0
    UnknownExpr(tag) -> 2
  }
}

