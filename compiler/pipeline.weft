        RecordField(ns, nl, value, fact) -> pipeline_expr_has_non_native_scalar_typed(value)
        UnknownRecordField(tag) -> true
      }
      if found == 1 { true } else { pipeline_record_fields_have_non_native_scalar_typed(rest) }
    }
