pub(package) fn pipeline_par_work_sequential_submit_hash() -> i64 { str_hash(__str_ptr("par_work_sequential_submit"), 0, __str_len("par_work_sequential_submit")) }
pub(package) fn pipeline_par_work_pthread_submit_hash() -> i64 { str_hash(__str_ptr("par_work_pthread_submit"), 0, __str_len("par_work_pthread_submit")) }
pub(package) fn pipeline_runtime_par_work_scope_new_hash() -> i64 { str_hash(__str_ptr("runtime_par_work_scope_new"), 0, __str_len("runtime_par_work_scope_new")) }
pub(package) fn pipeline_runtime_par_work_scope_track_hash() -> i64 { str_hash(__str_ptr("runtime_par_work_scope_track"), 0, __str_len("runtime_par_work_scope_track")) }
pub(package) fn pipeline_runtime_par_work_scope_cleanup_hash() -> i64 { str_hash(__str_ptr("runtime_par_work_scope_cleanup"), 0, __str_len("runtime_par_work_scope_cleanup")) }
pub(package) fn pipeline_runtime_par_work_join_hash() -> i64 { str_hash(__str_ptr("runtime_par_work_join"), 0, __str_len("runtime_par_work_join")) }
pub(package) fn pipeline_par_pthread_pool_start_hash() -> i64 { str_hash(__str_ptr("par_pthread_pool_start"), 0, __str_len("par_pthread_pool_start")) }
pub(package) fn pipeline_par_pthread_pool_stop_and_join_hash() -> i64 { str_hash(__str_ptr("par_pthread_pool_stop_and_join"), 0, __str_len("par_pthread_pool_stop_and_join")) }
pub(package) fn pipeline_par_pthread_pool_destroy_hash() -> i64 { str_hash(__str_ptr("par_pthread_pool_destroy"), 0, __str_len("par_pthread_pool_destroy")) }
pub(package) fn pipeline_par_pthread_pool_shutdown_hash() -> i64 { str_hash(__str_ptr("par_pthread_pool_shutdown"), 0, __str_len("par_pthread_pool_shutdown")) }
pub(package) fn pipeline_par_sequential_map_hash() -> i64 { str_hash(__str_ptr("par_sequential_map"), 0, __str_len("par_sequential_map")) }
pub(package) fn pipeline_par_pthread_pool_map_scoped_hash() -> i64 { str_hash(__str_ptr("par_pthread_pool_map_scoped"), 0, __str_len("par_pthread_pool_map_scoped")) }

pub(package) fn pipeline_bridge_mem_load64_at_hash() -> i64 { 6169231631054115263 }
pub(package) fn pipeline_bridge_mem_store64_at_hash() -> i64 { 670126484967890450 }
pub(package) fn pipeline_bridge_mem_load8_at_hash() -> i64 { 2981907636351453137 }
pub(package) fn pipeline_bridge_mem_store8_at_hash() -> i64 { 6169221554417243588 }
pub(package) fn pipeline_bridge_mem_load64_hash() -> i64 { str_hash(__str_ptr("mem_load64"), 0, __str_len("mem_load64")) }
pub(package) fn pipeline_bridge_mem_store64_hash() -> i64 { str_hash(__str_ptr("mem_store64"), 0, __str_len("mem_store64")) }
pub(package) fn pipeline_bridge_mem_load8_hash() -> i64 { str_hash(__str_ptr("mem_load8"), 0, __str_len("mem_load8")) }
pub(package) fn pipeline_bridge_mem_store8_hash() -> i64 { str_hash(__str_ptr("mem_store8"), 0, __str_len("mem_store8")) }

pub(package) fn pipeline_bridge_mem_kind_by_hash(callee_hash: i64, arity: i64) -> i64 {
  if arity == 2 and callee_hash == pipeline_bridge_mem_load64_at_hash() { 1 }
  else { if arity == 3 and callee_hash == pipeline_bridge_mem_store64_at_hash() { 2 }
  else { if arity == 2 and callee_hash == pipeline_bridge_mem_load8_at_hash() { 3 }
  else { if arity == 3 and callee_hash == pipeline_bridge_mem_store8_at_hash() { 4 }
  else { if arity == 1 and callee_hash == pipeline_bridge_mem_load64_hash() { 5 }
  else { if arity == 2 and callee_hash == pipeline_bridge_mem_store64_hash() { 6 }
  else { if arity == 1 and callee_hash == pipeline_bridge_mem_load8_hash() { 7 }
  else { if arity == 2 and callee_hash == pipeline_bridge_mem_store8_hash() { 8 } else { 0 } } } } } } } }
}

pub(package) fn pipeline_bridge_mem_kind(src: i64, ns: i64, nl: i64, arity: i64) -> i64 {
  pipeline_bridge_mem_kind_by_hash(str_hash(src, ns, nl), arity)
}

pub(package) fn pipeline_ir_bridge_mem_pseudo_hash(kind: i64) -> i64 {
  if kind == 1 or kind == 5 { pipeline_ir_pseudo_bridge_load64_hash() }
  else { if kind == 2 or kind == 6 { pipeline_ir_pseudo_bridge_store64_hash() }
  else { if kind == 3 or kind == 7 { pipeline_ir_pseudo_bridge_load8_hash() }
  else { if kind == 4 or kind == 8 { pipeline_ir_pseudo_bridge_store8_hash() } else { 0 } } } }
}

pub(package) fn pipeline_bridge_mem_kind_is_load(kind: i64) -> i64 {
  kind == 1 or kind == 3 or kind == 5 or kind == 7
}

pub(package) fn pipeline_bridge_mem_kind_is_indexed(kind: i64) -> i64 {
  kind >= 1 and kind <= 4
}

pub(package) fn pipeline_ir_bridge_mem_call_args(kind: i64, addr: i64, values: IrValueList) -> IrValueList {
  if pipeline_bridge_mem_kind_is_load(kind) == 1 {
    ir_value_list_prepend(addr, ir_value_list_empty())
  } else {
    let value_index = if pipeline_bridge_mem_kind_is_indexed(kind) == 1 { 2 } else { 1 }
    ir_value_list_prepend(addr, ir_value_list_prepend(pipeline_ir_value_list_get_or(values, value_index, 0 - 1), ir_value_list_empty()))
  }
}

pub(package) fn pipeline_lower_bridge_mem_from_values(kind: i64, lowered_args: PipelineLoweredArgs) -> IrLoweredExpr {
  if pipeline_lowered_args_is_valid(lowered_args) == 1 and kind != 0 {
    let values = pipeline_lowered_args_values(lowered_args)
    let base = pipeline_ir_value_list_get_or(values, 0, 0 - 1)
    let index = pipeline_ir_value_list_get_or(values, 1, 0 - 1)
    let indexed = pipeline_bridge_mem_kind_is_indexed(kind)
    let addr = if indexed == 1 { pipeline_lowered_args_next_value(lowered_args) } else { base }
    let call_dst = if indexed == 1 { addr + 1 } else { pipeline_lowered_args_next_value(lowered_args) }
    let pseudo_hash = pipeline_ir_bridge_mem_pseudo_hash(kind)
    let addr_inst = ir_inst_list_prepend(ir_inst_binary_i64(addr, ir_binary_op_add(), base, index), ir_inst_list_empty())
    let call_values = pipeline_ir_bridge_mem_call_args(kind, addr, values)
    let call_inst = ir_inst_list_prepend(ir_inst_call_i64(call_dst, pseudo_hash, call_values), ir_inst_list_empty())
    let bridge_insts = if indexed == 1 { ir_inst_list_append(addr_inst, call_inst) } else { call_inst }
    if pipeline_bridge_mem_kind_is_load(kind) == 1 {
      ir_lowered_expr(call_dst, call_dst + 1, ir_inst_list_append(pipeline_lowered_args_insts(lowered_args), bridge_insts))
    } else {
      let result = call_dst + 1
      let result_inst = ir_inst_list_prepend(ir_inst_const_i64(result, 0), ir_inst_list_empty())
      ir_lowered_expr(result, result + 1, ir_inst_list_append(pipeline_lowered_args_insts(lowered_args), ir_inst_list_append(bridge_insts, result_inst)))
    }
  } else {
    ir_lowered_expr_invalid(pipeline_lowered_args_next_value(lowered_args))
  }
}

pub(package) fn pipeline_lower_scaled_raw_first_second(first: Expr, second: Expr, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> PipelineLoweredArgs {
  let first_lowered = pipeline_lower_expr_typed_sidecar_handler_ctx(first, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(first_lowered) == 1 {
    let second_lowered = pipeline_lower_expr_typed_sidecar_handler_ctx(second, ir_lowered_expr_next_value(first_lowered), lower_ctx)
    if ir_lowered_expr_is_valid(second_lowered) == 1 {
      pipeline_lowered_args(
        ir_value_list_prepend(ir_lowered_expr_value(first_lowered), ir_value_list_prepend(ir_lowered_expr_value(second_lowered), ir_value_list_empty())),
        ir_lowered_expr_next_value(second_lowered),
        ir_inst_list_append(ir_lowered_expr_insts(first_lowered), ir_lowered_expr_insts(second_lowered)),
        1
      )
    } else {
      pipeline_lowered_args_invalid(next_value)
    }
  } else {
    pipeline_lowered_args_invalid(next_value)
  }
}

pub(package) fn pipeline_lower_scaled_raw_call_typed(callee_hash: i64, args_expr: ExprList, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let kind = pipeline_ir_native_intrinsic_kind(callee_hash)
  if kind == 4 and expr_list_len(args_expr) == 1 {
    let addr_mode = pipeline_scaled_raw_address_from_expr(pipeline_expr_list_nth_or(args_expr, 0, NilExpr))
    if pipeline_scaled_raw_address_valid(addr_mode) == 1 {
      let lowered = pipeline_lower_scaled_raw_first_second(pipeline_scaled_raw_address_first(addr_mode), pipeline_scaled_raw_address_second(addr_mode), next_value, lower_ctx)
      if pipeline_lowered_args_is_valid(lowered) == 1 {
        let first_value = pipeline_ir_value_list_get_or(pipeline_lowered_args_values(lowered), 0, 0 - 1)
        let second_value = pipeline_ir_value_list_get_or(pipeline_lowered_args_values(lowered), 1, 0 - 1)
        let base = if pipeline_scaled_raw_address_first_is_base(addr_mode) == 1 { first_value } else { second_value }
        let index = if pipeline_scaled_raw_address_first_is_base(addr_mode) == 1 { second_value } else { first_value }
        let dst = pipeline_lowered_args_next_value(lowered)
        let call_args = ir_value_list_prepend(base, ir_value_list_prepend(index, ir_value_list_empty()))
        let call = ir_inst_list_prepend(ir_inst_call_i64(dst, pipeline_ir_pseudo_scaled_load64_hash(), call_args), ir_inst_list_empty())
        ir_lowered_expr(dst, dst + 1, ir_inst_list_append(pipeline_lowered_args_insts(lowered), call))
      } else {
        ir_lowered_expr_invalid(next_value)
      }
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    if kind == 2 and expr_list_len(args_expr) == 2 {
      let addr_mode = pipeline_scaled_raw_address_from_expr(pipeline_expr_list_nth_or(args_expr, 0, NilExpr))
      if pipeline_scaled_raw_address_valid(addr_mode) == 1 {
        let lowered_addr = pipeline_lower_scaled_raw_first_second(pipeline_scaled_raw_address_first(addr_mode), pipeline_scaled_raw_address_second(addr_mode), next_value, lower_ctx)
        if pipeline_lowered_args_is_valid(lowered_addr) == 1 {
          let value_expr = pipeline_expr_list_nth_or(args_expr, 1, NilExpr)
          let lowered_value = pipeline_lower_expr_typed_sidecar_handler_ctx(value_expr, pipeline_lowered_args_next_value(lowered_addr), lower_ctx)
          if ir_lowered_expr_is_valid(lowered_value) == 1 {
            let first_value = pipeline_ir_value_list_get_or(pipeline_lowered_args_values(lowered_addr), 0, 0 - 1)
            let second_value = pipeline_ir_value_list_get_or(pipeline_lowered_args_values(lowered_addr), 1, 0 - 1)
            let base = if pipeline_scaled_raw_address_first_is_base(addr_mode) == 1 { first_value } else { second_value }
            let index = if pipeline_scaled_raw_address_first_is_base(addr_mode) == 1 { second_value } else { first_value }
            let dst = ir_lowered_expr_next_value(lowered_value)
            let call_args = ir_value_list_prepend(base, ir_value_list_prepend(index, ir_value_list_prepend(ir_lowered_expr_value(lowered_value), ir_value_list_empty())))
            let call = ir_inst_list_prepend(ir_inst_call_i64(dst, pipeline_ir_pseudo_scaled_store64_hash(), call_args), ir_inst_list_empty())
            ir_lowered_expr(dst, dst + 1, ir_inst_list_append(pipeline_lowered_args_insts(lowered_addr), ir_inst_list_append(ir_lowered_expr_insts(lowered_value), call)))
          } else {
            ir_lowered_expr_invalid(next_value)
          }
        } else {
          ir_lowered_expr_invalid(next_value)
        }
      } else {
        ir_lowered_expr_invalid(next_value)
      }
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  }
}

pub(package) fn pipeline_lower_bridge_mem_call_typed(src: i64, ns: i64, nl: i64, args_expr: ExprList, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let kind = pipeline_bridge_mem_kind(src, ns, nl, expr_list_len(args_expr))
  if kind == 0 {
    ir_lowered_expr_invalid(next_value)
  } else {
    let args = pipeline_lower_typed_handler_opt_args(args_expr, next_value, lower_ctx)
    pipeline_lower_bridge_mem_from_values(kind, args)
  }
}

pub(package) fn pipeline_lower_native_intrinsic_call_typed(callee_hash: i64, args_expr: ExprList, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let kind = pipeline_ir_native_intrinsic_kind(callee_hash)
  let arity = pipeline_ir_native_intrinsic_arity(kind)
  let arg_count = expr_list_len(args_expr)
  if kind == 0 or arity != arg_count {
    ir_lowered_expr_invalid(next_value)
  } else {
    if kind == 4 {
      let ptr_expr = pipeline_expr_list_nth_or(args_expr, 0, NilExpr)
      let ptr = pipeline_lower_expr_typed_sidecar_handler_ctx(ptr_expr, next_value, lower_ctx)
      if ir_lowered_expr_is_valid(ptr) == 1 {
        let dst = ir_lowered_expr_next_value(ptr)
        let inst = ir_inst_list_prepend(ir_inst_ptr_load_i64(dst, ir_lowered_expr_value(ptr)), ir_inst_list_empty())
        ir_lowered_expr(dst, dst + 1, ir_inst_list_append(ir_lowered_expr_insts(ptr), inst))
      } else {
        ir_lowered_expr_invalid(next_value)
      }
    } else {
      if kind == 2 {
        let ptr_expr = pipeline_expr_list_nth_or(args_expr, 0, NilExpr)
        let value_expr = pipeline_expr_list_nth_or(args_expr, 1, NilExpr)
        let ptr = pipeline_lower_expr_typed_sidecar_handler_ctx(ptr_expr, next_value, lower_ctx)
        if ir_lowered_expr_is_valid(ptr) == 1 {
          let value = pipeline_lower_expr_typed_sidecar_handler_ctx(value_expr, ir_lowered_expr_next_value(ptr), lower_ctx)
          if ir_lowered_expr_is_valid(value) == 1 {
            let store_dst = ir_lowered_expr_next_value(value)
            let store = ir_inst_list_prepend(ir_inst_ptr_store_i64(store_dst, ir_lowered_expr_value(ptr), ir_lowered_expr_value(value)), ir_inst_list_empty())
            let insts = ir_inst_list_append(ir_lowered_expr_insts(ptr), ir_inst_list_append(ir_lowered_expr_insts(value), store))
            ir_lowered_expr(ir_lowered_expr_value(value), store_dst + 1, insts)
          } else {
            ir_lowered_expr_invalid(next_value)
          }
        } else {
          ir_lowered_expr_invalid(next_value)
        }
      } else {
        let args = pipeline_lower_typed_handler_opt_args(args_expr, next_value, lower_ctx)
        if pipeline_lowered_args_is_valid(args) == 1 {
          let dst = pipeline_lowered_args_next_value(args)
          let call = ir_inst_list_prepend(ir_inst_call_i64(dst, callee_hash, pipeline_lowered_args_values(args)), ir_inst_list_empty())
          ir_lowered_expr(dst, dst + 1, ir_inst_list_append(pipeline_lowered_args_insts(args), call))
        } else {
          ir_lowered_expr_invalid(next_value)
        }
      }
    }
  }
}

pub(package) fn pipeline_scaled_raw_arg_nodes_for_call(callee_hash: i64, expr: i64) -> i64 {
  let kind = pipeline_ir_native_intrinsic_kind(callee_hash)
  if kind == 4 and node_f4(expr) == 1 {
    let addr_mode = pipeline_scaled_raw_address_from_expr(expr_from_node(nlist_get(node_f3(expr), 0)))
    if pipeline_scaled_raw_address_valid(addr_mode) == 1 {
      let args = nlist_new()
      nlist_add(args, expr_to_node(pipeline_scaled_raw_address_first(addr_mode)))
      nlist_add(args, expr_to_node(pipeline_scaled_raw_address_second(addr_mode)))
      args
    } else { 0 }
  } else {
    if kind == 2 and node_f4(expr) == 2 {
      let addr_mode = pipeline_scaled_raw_address_from_expr(expr_from_node(nlist_get(node_f3(expr), 0)))
      if pipeline_scaled_raw_address_valid(addr_mode) == 1 {
        let args = nlist_new()
        nlist_add(args, expr_to_node(pipeline_scaled_raw_address_first(addr_mode)))
        nlist_add(args, expr_to_node(pipeline_scaled_raw_address_second(addr_mode)))
        nlist_add(args, nlist_get(node_f3(expr), 1))
        args
      } else { 0 }
    } else { 0 }
  }
}

pub(package) fn pipeline_lower_scaled_raw_call_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let callee_hash = str_hash(src, node_f1(expr), node_f2(expr))
  let kind = pipeline_ir_native_intrinsic_kind(callee_hash)
  let raw_args = pipeline_scaled_raw_arg_nodes_for_call(callee_hash, expr)
  if raw_args == 0 {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  } else {
    let call_block = next_block
    let arg_count = nlist_len(raw_args)
    let first_arg_block = pipeline_lower_operation_child_start_block(call_block, arg_count)
    let ctx = pipeline_call_arg_ctx_with_fns(raw_args, arg_count, params, locals, src, tt, call_block, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module))
    let lowered_args = pipeline_lower_call_arg_blocks(ctx, 0, next_value, first_arg_block, ir_value_list_empty())
    if pipeline_lowered_call_blocks_is_valid(lowered_args) == 1 {
      let entry = ir_block_new_term(start_block, ir_inst_list_empty(), ir_term_jump(first_arg_block))
      if pipeline_lowered_call_blocks_falls_through(lowered_args) == 0 {
        let blocks = ir_block_list_prepend(entry, pipeline_lowered_call_blocks_blocks(lowered_args))
        pipeline_lowered_blocks_control(
          pipeline_lowered_call_blocks_next_block(lowered_args),
          pipeline_lowered_call_blocks_next_value(lowered_args),
          blocks,
          1,
          0
        )
      } else {
        let call_dst = pipeline_lowered_call_blocks_next_value(lowered_args)
        let addr_mode = pipeline_scaled_raw_address_from_expr(expr_from_node(nlist_get(node_f3(expr), 0)))
        let first_value = pipeline_ir_value_list_get_or(pipeline_lowered_call_blocks_values(lowered_args), 0, 0 - 1)
        let second_value = pipeline_ir_value_list_get_or(pipeline_lowered_call_blocks_values(lowered_args), 1, 0 - 1)
        let base = if pipeline_scaled_raw_address_first_is_base(addr_mode) == 1 { first_value } else { second_value }
        let index = if pipeline_scaled_raw_address_first_is_base(addr_mode) == 1 { second_value } else { first_value }
        let pseudo_hash = if kind == 4 { pipeline_ir_pseudo_scaled_load64_hash() } else { pipeline_ir_pseudo_scaled_store64_hash() }
        let call_values = if kind == 4 {
          ir_value_list_prepend(base, ir_value_list_prepend(index, ir_value_list_empty()))
        } else {
          ir_value_list_prepend(base, ir_value_list_prepend(index, ir_value_list_prepend(pipeline_ir_value_list_get_or(pipeline_lowered_call_blocks_values(lowered_args), 2, 0 - 1), ir_value_list_empty())))
        }
        let call_inst = ir_inst_list_prepend(ir_inst_call_i64(call_dst, pseudo_hash, call_values), ir_inst_list_empty())
        let call_args = ir_value_list_prepend(call_dst, ir_value_list_empty())
        let call = ir_block_new_term(call_block, call_inst, ir_term_jump_args(target_block, call_args))
        let blocks = ir_block_list_prepend(
          entry,
          ir_block_list_append(pipeline_lowered_call_blocks_blocks(lowered_args), ir_block_list_prepend(call, ir_block_list_empty()))
        )
        pipeline_lowered_blocks(pipeline_lowered_call_blocks_next_block(lowered_args), call_dst + 1, blocks, 1)
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  }
}

pub(package) fn pipeline_lower_bridge_mem_call_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let direct = pipeline_call_callee_is_direct(params, locals, src, node_f1(expr), node_f2(expr))
  let kind = if direct == 1 { pipeline_bridge_mem_kind_by_hash(str_hash(src, node_f1(expr), node_f2(expr)), node_f4(expr)) } else { 0 }
  if kind == 0 {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  } else {
    let call_block = next_block
    let arg_count = node_f4(expr)
    let first_arg_block = pipeline_lower_operation_child_start_block(call_block, arg_count)
    let ctx = pipeline_call_arg_ctx_with_fns(node_f3(expr), arg_count, params, locals, src, tt, call_block, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module))
    let lowered_args = pipeline_lower_call_arg_blocks(ctx, 0, next_value, first_arg_block, ir_value_list_empty())
    if pipeline_lowered_call_blocks_is_valid(lowered_args) == 1 {
      let entry = ir_block_new_term(start_block, ir_inst_list_empty(), ir_term_jump(first_arg_block))
      if pipeline_lowered_call_blocks_falls_through(lowered_args) == 0 {
        let blocks = ir_block_list_prepend(entry, pipeline_lowered_call_blocks_blocks(lowered_args))
        pipeline_lowered_blocks_control(
          pipeline_lowered_call_blocks_next_block(lowered_args),
          pipeline_lowered_call_blocks_next_value(lowered_args),
          blocks,
          1,
          0
        )
      } else {
        let values = pipeline_lowered_call_blocks_values(lowered_args)
        let base = pipeline_ir_value_list_get_or(values, 0, 0 - 1)
        let index = pipeline_ir_value_list_get_or(values, 1, 0 - 1)
        let addr = pipeline_lowered_call_blocks_next_value(lowered_args)
        let call_dst = addr + 1
        let pseudo_hash = pipeline_ir_bridge_mem_pseudo_hash(kind)
        let addr_inst = ir_inst_list_prepend(ir_inst_binary_i64(addr, ir_binary_op_add(), base, index), ir_inst_list_empty())
        let call_values = pipeline_ir_bridge_mem_call_args(kind, addr, values)
        let call_inst = ir_inst_list_prepend(ir_inst_call_i64(call_dst, pseudo_hash, call_values), ir_inst_list_empty())
        let call_insts = if kind == 1 or kind == 3 {
          ir_inst_list_append(addr_inst, call_inst)
        } else {
          let result = call_dst + 1
          ir_inst_list_append(addr_inst, ir_inst_list_append(call_inst, ir_inst_list_prepend(ir_inst_const_i64(result, 0), ir_inst_list_empty())))
        }
        let result_value = if kind == 1 or kind == 3 { call_dst } else { call_dst + 1 }
        let call_args = ir_value_list_prepend(result_value, ir_value_list_empty())
        let call = ir_block_new_term(call_block, call_insts, ir_term_jump_args(target_block, call_args))
        let blocks = ir_block_list_prepend(
          entry,
          ir_block_list_append(pipeline_lowered_call_blocks_blocks(lowered_args), ir_block_list_prepend(call, ir_block_list_empty()))
        )
        pipeline_lowered_blocks(pipeline_lowered_call_blocks_next_block(lowered_args), result_value + 1, blocks, 1)
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  }
}

pub(package) fn pipeline_lower_weak_call_expr_typed_sidecar_handler_opt(src: i64, ns: i64, nl: i64, args_expr: ExprList, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let arg_count = expr_list_len(args_expr)
  if arg_count != 1 {
    ir_lowered_expr_invalid(next_value)
  } else {
    if src_eq(src, ns, nl, "weak_ref") == 1 or src_eq(src, ns, nl, "weak_load") == 1 {
      let value_expr = pipeline_expr_list_nth_or(args_expr, 0, NilExpr)
      let value = pipeline_lower_expr_typed_sidecar_handler_ctx(value_expr, next_value, lower_ctx)
      if ir_lowered_expr_is_valid(value) == 1 {
        let dst = ir_lowered_expr_next_value(value)
        let runtime_hash = if src_eq(src, ns, nl, "weak_ref") == 1 { pipeline_rc_default_weak_retain_hash() } else { pipeline_rc_default_weak_load_hash() }
        let runtime_args = ir_value_list_prepend(ir_lowered_expr_value(value), ir_value_list_empty())
        let call = ir_inst_list_prepend(ir_inst_call_i64(dst, runtime_hash, runtime_args), ir_inst_list_empty())
        let result_value = if src_eq(src, ns, nl, "weak_ref") == 1 { ir_lowered_expr_value(value) } else { dst }
        let insts = ir_inst_list_append(ir_lowered_expr_insts(value), call)
        ir_lowered_expr(result_value, dst + 1, insts)
      } else {
        ir_lowered_expr_invalid(next_value)
      }
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  }
}

pub(package) fn pipeline_lower_opaque_wrap_expr_typed(declaration: i64, type_args: i64, args_expr: ExprList, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  if declaration == 0 or expr_list_len(args_expr) != 1 { ir_lowered_expr_invalid(next_value) }
  else {
    let expected_types = pipeline_opaque_representation_types(pipeline_handler_lower_ctx_tt(lower_ctx), declaration, type_args)
    let args = pipeline_lower_typed_handler_opt_args_expected_borrow_mask_origin(args_expr, 0, next_value, lower_ctx, 0, expected_types, 0, 0, ir_managed_stake_origin_aggregate())
    if pipeline_lowered_args_is_valid(args) == 0 { ir_lowered_expr_invalid(next_value) }
    else {
      let result_values = pipeline_call_abi_args(pipeline_lowered_args_values(args), 0, expected_types, 0, 0, 0)
      let result = pipeline_ir_value_list_get_or(result_values, 0, 0 - 1)
      let target_ty = typeck_named_type_from_declaration(
        pipeline_handler_lower_ctx_tt(lower_ctx), declaration, type_args
      )
      let source_expr = pipeline_expr_list_nth_or(args_expr, 0, NilExpr)
      let actual_source_ty = pipeline_return_expr_type_node_typed(
        source_expr,
        pipeline_handler_lower_ctx_params(lower_ctx),
        pipeline_handler_lower_ctx_locals(lower_ctx),
        pipeline_handler_lower_ctx_module(lower_ctx)
      )
      let source_ty = if actual_source_ty == 0 {
        nlist_get(expected_types, 0)
      } else { actual_source_ty }
      let rewrap = pipeline_linear_rewrap_insts(
        result,
        source_ty,
        target_ty,
        pipeline_handler_lower_ctx_tt(lower_ctx)
      )
      ir_lowered_expr(
        result,
        pipeline_lowered_args_next_value(args),
        ir_inst_list_append(pipeline_lowered_args_insts(args), rewrap)
      )
    }
  }
}

pub(package) fn pipeline_lower_call_expr_typed_sidecar_handler_opt(ns: i64, nl: i64, args_expr: ExprList, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let fns = pipeline_handler_lower_ctx_fns(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  let direct = pipeline_call_callee_is_direct(params, locals, src, ns, nl)
  let callee_value = pipeline_call_callee_value(params, locals, src, ns, nl)
  let callee_slot = pipeline_call_callee_slot(locals, src, ns, nl)
  let callee_type_node = pipeline_call_callee_type_node(params, locals, src, ns, nl, subst)
  let indirect_expected_types = pipeline_call_indirect_expected_types(direct, callee_type_node)
  let opaque = pipeline_lower_opaque_wrap_expr_typed(pipeline_local_opaque_type_declaration(tt, src, ns, nl), 0, args_expr, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(opaque) == 1 { opaque }
  else {
  let weak = pipeline_lower_weak_call_expr_typed_sidecar_handler_opt(src, ns, nl, args_expr, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(weak) == 1 {
    weak
  } else {
  let pure_inline = if direct == 1 and subst == 0 { pipeline_lower_pure_call_inline_sidecar(ns, nl, args_expr, next_value, lower_ctx) } else { ir_lowered_expr_invalid(next_value) }
  if ir_lowered_expr_is_valid(pure_inline) == 1 {
    pure_inline
  } else {
    let scaled_raw = pipeline_lower_scaled_raw_call_typed(str_hash(src, ns, nl), args_expr, next_value, lower_ctx)
    if ir_lowered_expr_is_valid(scaled_raw) == 1 {
      scaled_raw
    } else {
    let intrinsic = pipeline_lower_native_intrinsic_call_typed(str_hash(src, ns, nl), args_expr, next_value, lower_ctx)
    if ir_lowered_expr_is_valid(intrinsic) == 1 {
      intrinsic
    } else {
    let bridge_mem = if direct == 1 { pipeline_lower_bridge_mem_call_typed(src, ns, nl, args_expr, next_value, lower_ctx) } else { ir_lowered_expr_invalid(next_value) }
    if ir_lowered_expr_is_valid(bridge_mem) == 1 {
      bridge_mem
    } else {
    let inferred_type_args = if direct == 1 {
      pipeline_inferred_generic_type_args_typed(
        src,
        tt,
        fns,
        ns,
        nl,
        args_expr,
        params,
        locals,
        pipeline_handler_lower_ctx_module(lower_ctx)
      )
    } else { type_expr_list_empty() }
    let inferred_generic = if type_expr_list_len(inferred_type_args) > 0 {
      pipeline_lower_generic_call_expr_typed_sidecar_handler_opt(
        inferred_type_args,
        Call(ns, nl, args_expr),
        next_value,
        lower_ctx
      )
    } else { ir_lowered_expr_invalid(next_value) }
    if ir_lowered_expr_is_valid(inferred_generic) == 1 {
      inferred_generic
    } else { if direct == 1 or callee_value >= 0 or callee_slot >= 0 {
    let arg_start_value = if callee_slot >= 0 { next_value + 1 } else { next_value }
    let variant_payloads = if direct == 1 { pipeline_variant_payload_types(tt, src, ns, nl) } else { 0 }
    let variant_tparams = if variant_payloads == 0 { 0 } else { ttable_variant_tparams(tt, src, ns, nl) }
    let variant_subst = if variant_payloads == 0 { subst } else {
      pipeline_constructor_instance_subst_typed(variant_tparams, variant_payloads, args_expr, params, locals, pipeline_handler_lower_ctx_module(lower_ctx), subst)
    }
    let expected_params = if variant_payloads == 0 and direct == 1 { pipeline_fns_lookup_params_resolved(fns, tt, src, ns, nl) } else { 0 }
    let expected_types = if variant_payloads != 0 { variant_payloads } else { indirect_expected_types }
    let direct_fn = if direct == 1 { pipeline_fns_lookup_pair_resolved(fns, tt, src, ns, nl) } else { 0 }
    let result_ty = pipeline_call_result_type_node(params, locals, src, tt, fns, subst, ns, nl)
    let borrowed_mask = if variant_payloads == 0 and direct == 1 {
      pipeline_call_borrowable_param_mask(fns, tt, src, ns, nl, expected_params, subst)
    } else { 0 }
    let args = pipeline_lower_typed_handler_opt_args_expected_borrow_mask_origin(args_expr, 0, arg_start_value, lower_ctx, expected_params, expected_types, variant_subst, borrowed_mask, if variant_payloads != 0 { ir_managed_stake_origin_aggregate() } else { ir_managed_stake_origin_call_transport() })
    if pipeline_lowered_args_is_valid(args) == 1 {
      let dst = pipeline_lowered_args_next_value(args)
      let indirect_callee = if callee_slot >= 0 { next_value } else { callee_value }
      let callee_insts = if callee_slot >= 0 {
        ir_inst_list_prepend(ir_inst_load_i64(next_value, callee_slot), ir_inst_list_empty())
      } else { ir_inst_list_empty() }
      let logical_args = pipeline_lowered_args_values(args)
      let abi_args = if variant_payloads != 0 {
        pipeline_call_abi_args(logical_args, 0, variant_payloads, variant_subst, 0, 0)
      } else { if expected_params != 0 or expected_types != 0 {
        pipeline_call_abi_args(logical_args, expected_params, expected_types, subst, 0, 0)
      } else { logical_args } }
      let resolved_call = pipeline_call_inst_resolved(dst, direct, indirect_callee, src, tt, fns, ns, nl, variant_subst, abi_args, result_ty)
      let call_head = ir_inst_list_prepend(resolved_call, ir_inst_list_empty())
      let call = if result_ty != 0 {
        ir_inst_list_append(call_head, pipeline_ir_call_result_lane_insts(dst, result_ty))
      } else { call_head }
      let linear_transfers = if variant_payloads != 0 {
        pipeline_aggregate_linear_transfer_insts_typed(
          args_expr, variant_payloads, variant_subst, 0, 0, abi_args,
          params, locals, pipeline_handler_lower_ctx_module(lower_ctx)
        )
      } else { if expected_params != 0 {
        pipeline_effect_linear_transfer_insts_typed(
          args_expr, expected_params, 0, 0, abi_args,
          params, locals, pipeline_handler_lower_ctx_module(lower_ctx)
        )
      } else { if expected_types != 0 {
        pipeline_indirect_linear_transfer_insts_typed(
          args_expr, expected_types, subst, abi_args,
          params, locals, pipeline_handler_lower_ctx_module(lower_ctx)
        )
      } else { ir_inst_list_empty() } } }
      let managed_transfers = match resolved_call {
        IrIndirectCallI64(actual_dst, callee, actual_args, indirect_result_ty) -> pipeline_indirect_managed_transfer_insts(
          expected_types, if variant_payloads != 0 { variant_subst } else { subst },
          0, 0, actual_args, actual_dst
        )
        _ -> pipeline_direct_managed_transfer_insts(
          expected_params, subst, borrowed_mask, resolved_call,
          pipeline_handler_lower_ctx_tt(lower_ctx)
        )
      }
      let result_lanes = if result_ty != 0 { pipeline_type_value_lane_count_or_one(result_ty) } else { 1 }
      let cleanup = pipeline_managed_lambda_temp_release_args_masked_typed(args_expr, logical_args, 0, dst + result_lanes, borrowed_mask, 0, expected_params, expected_types, variant_subst, pipeline_handler_lower_ctx_src(lower_ctx), pipeline_handler_lower_ctx_tt(lower_ctx))
      let insts = ir_inst_list_append(
        callee_insts,
        ir_inst_list_append(
          pipeline_lowered_args_insts(args),
          ir_inst_list_append(
            linear_transfers,
            ir_inst_list_append(managed_transfers, ir_inst_list_append(call, pipeline_lowered_args_insts(cleanup)))
          )
        )
      )
      ir_lowered_expr(dst, pipeline_lowered_args_next_value(cleanup), insts)
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  } } } } }
  }
  }
  }
}

pub(package) fn pipeline_expr_float_prim_typed(expr: Expr, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, fns: i64, subst: i64) -> i64 {
  match expr {
    IntLit(value, start, len) -> 0
    StringLit(start, len) -> 0
    BoolLit(value) -> 0
    FloatLit(start, len) -> PRIM_F64()
    Ident(ns, nl) -> {
      let local_prim = pipeline_value_env_lookup_float_prim(locals, src, ns, nl)
      if local_prim != 0 { local_prim } else { pipeline_param_float_prim_by_name(params, src, ns, nl, subst) }
    }
    BorrowIdent(ns, nl, owner, mutable) -> {
      let local_prim = pipeline_value_env_lookup_float_prim(locals, src, ns, nl)
      if local_prim != 0 { local_prim } else { pipeline_param_float_prim_by_name(params, src, ns, nl, subst) }
    }
    BinOp(op, lhs, rhs) -> pipeline_binop_float_prim_typed(op, lhs, rhs, params, locals, src, tt, fns, subst)
    LetTyped(inner, ann_type) -> {
      let ann_prim = type_expr_prim_id_or(ann_type, 0)
      if ann_prim == PRIM_F32() or ann_prim == PRIM_F64() { ann_prim }
      else { 0 }
    }
    Call(ns, nl, args) -> {
      let direct = pipeline_call_callee_is_direct(params, locals, src, ns, nl)
      if direct == 1 {
        pipeline_fns_lookup_ret_float_prim(fns, src, ns, nl, subst)
      } else {
        let result_ty = pipeline_call_result_type_node(params, locals, src, 0, fns, subst, ns, nl)
        let prim = pipeline_type_node_prim_id_or(result_ty, 0)
        if prim == PRIM_F32() or prim == PRIM_F64() { prim } else { 0 }
      }
    }
    GenericCall(type_args, inner_call) -> {
      match inner_call {
        Call(ns, nl, args) -> {
          let concrete_type_args = pipeline_type_expr_list_subst(type_args, subst)
          let pair = pipeline_generic_template_find(fns, src, str_hash(src, ns, nl))
          if pair == 0 { 0 }
          else {
            let fn_wrap = node_f1(pair)
            let s = cg_build_subst(fn_tparams(fn_wrap), type_expr_list_to_nodes(concrete_type_args))
            pipeline_fn_return_float_prim(fn_wrap, s)
          }
        }
        _ -> 0
      }
    }
    If(cond, then_expr, else_expr) -> 0
    While(cond, body) -> 0
    Loop(body) -> 0
    Break(value) -> 0
    BreakNoValue -> 0
    Continue -> 0
    Return(value) -> 0
    ReturnNoValue -> 0
    Defer(cleanup, body, source_site) -> 0
    Let(ns, nl, value, body) -> 0
    LetMut(ns, nl, value, body) -> 0
    Assign(ns, nl, value) -> 0
    AddressOf(mutable, target) -> 0
    Deref(ptr) -> 0
    PtrAssign(ptr, value) -> 0
    Block(first, rest) -> 0
    FieldAccess(base, field_ns, field_nl, fact) -> 0
    IndexedLen(base, fixed_len) -> 0
    IndexedGet(base, index, element_ty, fixed_len) -> {
      let prim = pipeline_type_node_prim_id_or(element_ty, 0)
      if prim == PRIM_F32() or prim == PRIM_F64() { prim } else { 0 }
    }
    IndexedSet(base, index, value, fact) -> 0
    IndexedSlice(base, start, end, fact) -> 0
    RecordInit(type_ns, type_nl, fields) -> 0
    RecordUpdate(base, fields, fact) -> 0
    ArrayLiteral(elements, resolved_ty, span) -> 0
    Match(scrutinee, arms) -> 0
    Not(operand) -> 0
    Lambda(params, body, source_site) -> 0
    Perform(lhs, op_ns, op_nl, args) -> 0
    Handle(body, clauses, hret) -> 0
    WithHandler(config, body, fact, source_site) -> 0
    Resume(value) -> 0
    MethodCall(recv, method_hash, args, method_ref) -> {
      let result_ty = pipeline_method_ref_result_type(tt, method_ref, method_hash, subst)
      let prim = pipeline_type_node_prim_id_or(result_ty, 0)
      if prim == PRIM_F32() or prim == PRIM_F64() { prim } else { 0 }
    }
    Try(inner, effect_atom) -> 0
    InterpConcat(left, right) -> 0
    ForIter(var_ns, var_nl, collection, body) -> 0
    OptChain(base, field_ns, field_nl, effect_atom) -> 0
    NilExpr -> 0
    UnknownExpr(tag) -> 0
  }
}

pub(package) fn pipeline_expr_type_hash_typed(expr: Expr, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, fns: i64, subst: i64) -> i64 {
  match expr {
    Ident(ns, nl) -> {
      let local_hash = pipeline_value_env_lookup_type_hash(locals, src, ns, nl)
      if local_hash != 0 { local_hash } else { pipeline_param_type_hash_by_name(params, src, ns, nl, subst) }
    }
    BinOp(op, lhs, rhs) -> {
      if op >= 5 and op <= 10 {
        type_hash_of(ty_bool())
      } else {
        let float_prim = pipeline_binop_float_prim_typed(op, lhs, rhs, params, locals, src, tt, fns, subst)
        if float_prim == PRIM_F32() or float_prim == PRIM_F64() {
          pipeline_type_hash_of_prim_id(float_prim)
        } else {
          let int_prim = pipeline_binop_int_result_prim_typed(op, lhs, rhs, params, locals, src, fns, subst)
          if int_prim >= 0 { pipeline_type_hash_of_prim_id(int_prim) } else { 0 }
        }
      }
    }
    Call(ns, nl, args) -> {
      if pipeline_call_callee_is_direct(params, locals, src, ns, nl) == 1 {
        pipeline_fns_lookup_ret_type_hash(fns, src, ns, nl, subst)
      } else {
        let result_ty = pipeline_call_result_type_node(params, locals, src, tt, fns, subst, ns, nl)
        if result_ty == 0 { 0 } else { type_hash_of(result_ty) }
      }
    }
    GenericCall(type_args, inner_call) -> {
      match inner_call {
        Call(ns, nl, args) -> {
          let pair = pipeline_generic_template_find(fns, src, str_hash(src, ns, nl))
          if pair == 0 { 0 }
          else {
            let fn_wrap = node_f1(pair)
            let concrete = type_expr_list_to_nodes(type_args)
            let s = cg_build_subst(fn_tparams(fn_wrap), concrete)
            type_hash_of(pipeline_function_return_type_with_subst(fn_wrap, s, tt))
          }
        }
        _ -> 0
      }
    }
    MethodCall(recv, method_hash, args, method_ref) -> {
      let concrete_ref = pipeline_concretize_method_ref(tt, method_ref, method_hash, subst)
      let resolution = ttable_resolve_method(tt, method_ref_receiver_ty(concrete_ref), method_ref_owner_hash(concrete_ref), method_hash)
      if resolution == 0 { 0 } else { type_hash_of(method_resolution_ret(resolution)) }
    }
    RecordInit(type_ns, type_nl, fields) -> type_name_hash(src, type_ns, type_nl)
    RecordUpdate(base, fields, fact) -> type_hash_of(ty_subst(record_update_fact_result_type_node(fact), subst))
    ArrayLiteral(elements, resolved_ty, span) -> type_hash_of(ty_subst(resolved_ty, subst))
    IndexedLen(base, fixed_len) -> type_hash_of(ty_usize())
    IndexedGet(base, index, element_ty, fixed_len) -> type_hash_of(ty_subst(element_ty, subst))
    IndexedSet(base, index, value, fact) -> type_hash_of(ty_nil())
    IndexedSlice(base, start, end, fact) -> if fact == 0 { 0 } else { type_hash_of(ty_slice_with_mut(ty_subst(node_f1(fact), subst), node_f4(fact))) }
    LetTyped(inner, ann_type) -> type_hash_of(type_expr_to_node(ann_type))
    _ -> 0
  }
}

pub(package) fn pipeline_expr_matches_f32_contextual_typed(expr: Expr, prim: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, fns: i64, subst: i64) -> i64 {
  if prim == PRIM_F32() { 1 }
  else {
    match expr {
      FloatLit(start, len) -> 1
      BinOp(op, lhs, rhs) -> {
        if op >= 1 and op <= 4 {
          let lp = pipeline_expr_float_prim_typed(lhs, params, locals, src, tt, fns, subst)
          let rp = pipeline_expr_float_prim_typed(rhs, params, locals, src, tt, fns, subst)
          pipeline_expr_matches_f32_contextual_typed(lhs, lp, params, locals, src, tt, fns, subst) == 1 and
            pipeline_expr_matches_f32_contextual_typed(rhs, rp, params, locals, src, tt, fns, subst) == 1
        } else { 0 }
      }
      LetTyped(inner, ann_type) -> {
        let ann_prim = type_expr_prim_id_or(ann_type, 0)
        if ann_prim == PRIM_F32() { 1 } else { 0 }
      }
      _ -> 0
    }
  }
}

pub(package) fn pipeline_binop_float_prim_typed(op_id: i64, lhs_expr: Expr, rhs_expr: Expr, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, fns: i64, subst: i64) -> i64 {
  if op_id >= 1 and op_id <= 10 {
    let lp = pipeline_expr_float_prim_typed(lhs_expr, params, locals, src, tt, fns, subst)
    let rp = pipeline_expr_float_prim_typed(rhs_expr, params, locals, src, tt, fns, subst)
    if lp == PRIM_F32() or rp == PRIM_F32() {
      if pipeline_expr_matches_f32_contextual_typed(lhs_expr, lp, params, locals, src, tt, fns, subst) == 1 and
        pipeline_expr_matches_f32_contextual_typed(rhs_expr, rp, params, locals, src, tt, fns, subst) == 1 {
        PRIM_F32()
      } else { 0 }
    } else {
      if lp == PRIM_F64() or rp == PRIM_F64() { PRIM_F64() } else { 0 }
    }
  } else { 0 }
}

pub(package) fn pipeline_expr_int_prim_typed(expr: Expr, params: i64, locals: PipelineValueEnv, src: i64, fns: i64, subst: i64) -> i64 {
  match expr {
    IntLit(value, start, len) -> PRIM_I64()
    Ident(ns, nl) -> {
      let local_prim = pipeline_type_hash_int_prim_or(pipeline_value_env_lookup_type_hash(locals, src, ns, nl), 0 - 1)
      if local_prim >= 0 { local_prim } else { pipeline_param_int_prim_by_name(params, src, ns, nl, subst) }
    }
    BinOp(op, lhs, rhs) -> pipeline_binop_int_prim_typed(op, lhs, rhs, params, locals, src, fns, subst)
    LetTyped(inner, ann_type) -> {
      let ann_prim = type_expr_prim_id_or(ann_type, 0 - 1)
      if prim_is_integer(ann_prim) == 1 { ann_prim } else { 0 - 1 }
    }
    Call(ns, nl, args) -> {
      let direct = pipeline_call_callee_is_direct(params, locals, src, ns, nl)
      if direct == 1 {
        pipeline_fns_lookup_ret_int_prim(fns, src, ns, nl, subst)
      } else {
        let result_ty = pipeline_call_result_type_node(params, locals, src, 0, fns, subst, ns, nl)
        let prim = pipeline_type_node_prim_id_or(result_ty, 0 - 1)
        if prim_is_integer(prim) == 1 { prim } else { 0 - 1 }
      }
    }
    GenericCall(type_args, inner_call) -> {
      match inner_call {
        Call(ns, nl, args) -> {
          let concrete_type_args = pipeline_type_expr_list_subst(type_args, subst)
          let pair = pipeline_generic_template_find(fns, src, str_hash(src, ns, nl))
          if pair == 0 { 0 - 1 }
          else {
            let fn_wrap = node_f1(pair)
            let s = cg_build_subst(fn_tparams(fn_wrap), type_expr_list_to_nodes(concrete_type_args))
            pipeline_fn_return_int_prim(fn_wrap, s)
          }
        }
        _ -> 0 - 1
      }
    }
    MethodCall(recv, method_hash, args, method_ref) -> {
      let tt = pipeline_fns_context_ttable(fns)
      let result_ty = pipeline_method_ref_result_type(tt, method_ref, method_hash, subst)
      let prim = pipeline_type_node_prim_id_or(result_ty, 0 - 1)
      if prim_is_integer(prim) == 1 { prim } else { 0 - 1 }
    }
    _ -> 0 - 1
  }
}

pub(package) fn pipeline_binop_int_op_tracks_prim(op_id: i64) -> i64 {
  if op_id >= 1 and op_id <= 11 { 1 }
  else { if op_id >= 14 and op_id <= 18 { 1 } else { 0 } }
}

pub(package) fn pipeline_binop_int_candidate_prim(lp: i64, rp: i64) -> i64 {
  if lp >= 0 and lp != PRIM_I64() { lp }
  else { if rp >= 0 and rp != PRIM_I64() { rp }
  else { PRIM_I64() } }
}

pub(package) fn pipeline_binop_int_result_prim_typed(op_id: i64, lhs_expr: Expr, rhs_expr: Expr, params: i64, locals: PipelineValueEnv, src: i64, fns: i64, subst: i64) -> i64 {
  if pipeline_binop_int_op_tracks_prim(op_id) == 1 {
    let lp = pipeline_expr_int_prim_typed(lhs_expr, params, locals, src, fns, subst)
    let rp = pipeline_expr_int_prim_typed(rhs_expr, params, locals, src, fns, subst)
    pipeline_binop_int_candidate_prim(lp, rp)
  } else { 0 - 1 }
}

pub(package) fn pipeline_binop_int_prim_typed(op_id: i64, lhs_expr: Expr, rhs_expr: Expr, params: i64, locals: PipelineValueEnv, src: i64, fns: i64, subst: i64) -> i64 {
  let prim = pipeline_binop_int_result_prim_typed(op_id, lhs_expr, rhs_expr, params, locals, src, fns, subst)
  if pipeline_prim_is_non_native_int(prim) == 1 { prim } else { 0 - 1 }
}

pub(package) fn pipeline_expr_float_prim_node(expr: i64, params: i64, locals: PipelineValueEnv, src: i64, fns: i64, subst: i64) -> i64 {
  let stripped = pipeline_expr_node_strip_typed(expr)
  if stripped == 0 { 0 }
  else {
    let tag = node_tag(stripped)
    if tag == 54 {
      PRIM_F64()
    } else { if tag == 2 {
      let local_prim = pipeline_value_env_lookup_float_prim(locals, src, node_f1(stripped), node_f2(stripped))
      if local_prim != 0 { local_prim } else { pipeline_param_float_prim_by_name(params, src, node_f1(stripped), node_f2(stripped), subst) }
    } else { if tag == 3 {
      pipeline_binop_float_prim_node(node_f1(stripped), node_f2(stripped), node_f3(stripped), params, locals, src, fns, subst)
    } else { if tag == 37 {
      let ann_prim = pipeline_type_node_prim_id_or(node_f2(stripped), 0)
      if ann_prim == PRIM_F32() or ann_prim == PRIM_F64() { ann_prim } else { 0 }
    } else { if tag == 4 {
      let ns = node_f1(stripped)
      let nl = node_f2(stripped)
      let direct = pipeline_call_callee_is_direct(params, locals, src, ns, nl)
      if direct == 1 {
        pipeline_fns_lookup_ret_float_prim(fns, src, ns, nl, subst)
      } else {
        let result_ty = pipeline_call_result_type_node(params, locals, src, 0, fns, subst, ns, nl)
        let prim = pipeline_type_node_prim_id_or(result_ty, 0)
        if prim == PRIM_F32() or prim == PRIM_F64() { prim } else { 0 }
      }
    } else { if tag == 36 {
      let inner_call = node_f2(stripped)
      if inner_call != 0 and node_tag(inner_call) == 4 {
        let concrete_type_args = if subst == 0 { node_f1(stripped) } else { type_list_subst(node_f1(stripped), subst) }
        let pair = pipeline_generic_template_find(fns, src, str_hash(src, node_f1(inner_call), node_f2(inner_call)))
        if pair == 0 { 0 }
        else {
          let fn_wrap = node_f1(pair)
          let s = cg_build_subst(fn_tparams(fn_wrap), concrete_type_args)
          pipeline_fn_return_float_prim(fn_wrap, s)
        }
      } else { 0 }
    } else { if tag == 41 {
      let tt = pipeline_fns_context_ttable(fns)
      let result_ty = pipeline_method_ref_result_type(tt, node_f4(stripped), node_f2(stripped), subst)
      let prim = pipeline_type_node_prim_id_or(result_ty, 0)
      if prim == PRIM_F32() or prim == PRIM_F64() { prim } else { 0 }
    } else {
      0
    } } } } } } }
  }
}

pub(package) fn pipeline_expr_type_hash_node(expr: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, fns: i64, subst: i64) -> i64 {
  let stripped = pipeline_expr_node_strip_typed(expr)
  if stripped == 0 { 0 }
  else {
    let tag = node_tag(stripped)
    if tag == 2 {
      let local_hash = pipeline_value_env_lookup_type_hash(locals, src, node_f1(stripped), node_f2(stripped))
      if local_hash != 0 { local_hash } else { pipeline_param_type_hash_by_name(params, src, node_f1(stripped), node_f2(stripped), subst) }
    } else { if tag == 3 {
      let op = node_f1(stripped)
      if op >= 5 and op <= 10 {
        type_hash_of(ty_bool())
      } else {
        let float_prim = pipeline_binop_float_prim_node(op, node_f2(stripped), node_f3(stripped), params, locals, src, fns, subst)
        if float_prim == PRIM_F32() or float_prim == PRIM_F64() {
          pipeline_type_hash_of_prim_id(float_prim)
        } else {
          let int_prim = pipeline_binop_int_result_prim_node(op, node_f2(stripped), node_f3(stripped), params, locals, src, tt, fns, subst)
          if int_prim >= 0 { pipeline_type_hash_of_prim_id(int_prim) } else { 0 }
        }
      }
    } else { if tag == 4 {
      let ns = node_f1(stripped)
      let nl = node_f2(stripped)
      if pipeline_call_callee_is_direct(params, locals, src, ns, nl) == 1 {
        pipeline_fns_lookup_ret_type_hash(fns, src, ns, nl, subst)
      } else {
        let result_ty = pipeline_call_result_type_node(params, locals, src, tt, fns, subst, ns, nl)
        if result_ty == 0 { 0 } else { type_hash_of(result_ty) }
      }
    } else { if tag == 36 {
      let inner_call = node_f2(stripped)
      if inner_call != 0 and node_tag(inner_call) == 4 {
        let pair = pipeline_generic_template_find(fns, src, str_hash(src, node_f1(inner_call), node_f2(inner_call)))
        if pair == 0 { 0 }
        else {
          let concrete = if subst == 0 { node_f1(stripped) } else { type_list_subst(node_f1(stripped), subst) }
          let fn_wrap = node_f1(pair)
          let s = cg_build_subst(fn_tparams(fn_wrap), concrete)
          type_hash_of(pipeline_function_return_type_with_subst(fn_wrap, s, tt))
        }
      } else { 0 }
    } else { if tag == 41 {
      let method_ref = pipeline_concretize_method_ref(tt, node_f4(stripped), node_f2(stripped), subst)
      let resolution = ttable_resolve_method(tt, method_ref_receiver_ty(method_ref), method_ref_owner_hash(method_ref), node_f2(stripped))
      if resolution == 0 { 0 } else { type_hash_of(method_resolution_ret(resolution)) }
    } else { if tag == 14 {
      type_name_hash(src, node_f1(stripped), node_f2(stripped))
    } else { if tag == 63 {
      let fact = node_f4(stripped)
      if fact == 0 { 0 } else { type_hash_of(ty_subst(node_f1(fact), subst)) }
    } else { if tag == 58 {
      type_hash_of(ty_subst(node_f3(stripped), subst))
    } else { if tag == 59 {
      type_hash_of(ty_usize())
    } else { if tag == 60 {
      type_hash_of(ty_subst(node_f3(stripped), subst))
    } else { if tag == 61 {
      type_hash_of(ty_nil())
    } else { if tag == 62 {
      let fact = node_f4(stripped)
      if fact == 0 { 0 } else { type_hash_of(ty_slice_with_mut(ty_subst(node_f1(fact), subst), node_f4(fact))) }
    } else { if tag == 37 {
      type_hash_of(node_f2(stripped))
    } else {
      0
    } } } } } } } } } } } } }
  }
}

pub(package) fn pipeline_expr_matches_f32_contextual_node(expr: i64, prim: i64, params: i64, locals: PipelineValueEnv, src: i64, fns: i64, subst: i64) -> i64 {
  if prim == PRIM_F32() { 1 }
  else {
    let stripped = pipeline_expr_node_strip_typed(expr)
    if stripped != 0 and node_tag(stripped) == 54 {
      1
    } else { if stripped != 0 and node_tag(stripped) == 3 {
      let op = node_f1(stripped)
      if op >= 1 and op <= 4 {
        let lp = pipeline_expr_float_prim_node(node_f2(stripped), params, locals, src, fns, subst)
        let rp = pipeline_expr_float_prim_node(node_f3(stripped), params, locals, src, fns, subst)
        pipeline_expr_matches_f32_contextual_node(node_f2(stripped), lp, params, locals, src, fns, subst) == 1 and
          pipeline_expr_matches_f32_contextual_node(node_f3(stripped), rp, params, locals, src, fns, subst) == 1
      } else { 0 }
    } else { if stripped != 0 and node_tag(stripped) == 37 {
      let ann_prim = pipeline_type_node_prim_id_or(node_f2(stripped), 0)
      if ann_prim == PRIM_F32() { 1 } else { 0 }
    } else {
      0
    } } }
  }
}

pub(package) fn pipeline_binop_float_prim_node(op_id: i64, lhs_node: i64, rhs_node: i64, params: i64, locals: PipelineValueEnv, src: i64, fns: i64, subst: i64) -> i64 {
  if op_id >= 1 and op_id <= 10 {
    let lp = pipeline_expr_float_prim_node(lhs_node, params, locals, src, fns, subst)
    let rp = pipeline_expr_float_prim_node(rhs_node, params, locals, src, fns, subst)
    if lp == PRIM_F32() or rp == PRIM_F32() {
      if pipeline_expr_matches_f32_contextual_node(lhs_node, lp, params, locals, src, fns, subst) == 1 and
        pipeline_expr_matches_f32_contextual_node(rhs_node, rp, params, locals, src, fns, subst) == 1 {
        PRIM_F32()
      } else { 0 }
    } else {
      if lp == PRIM_F64() or rp == PRIM_F64() { PRIM_F64() } else { 0 }
    }
  } else { 0 }
}

pub(package) fn pipeline_expr_int_prim_node(expr: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, fns: i64, subst: i64) -> i64 {
  let stripped = pipeline_expr_node_strip_typed(expr)
  if stripped == 0 { 0 - 1 }
  else {
    let tag = node_tag(stripped)
    if tag == 1 {
      PRIM_I64()
    } else { if tag == 2 {
      let local_prim = pipeline_type_hash_int_prim_or(pipeline_value_env_lookup_type_hash(locals, src, node_f1(stripped), node_f2(stripped)), 0 - 1)
      if local_prim >= 0 { local_prim } else { pipeline_param_int_prim_by_name(params, src, node_f1(stripped), node_f2(stripped), subst) }
    } else { if tag == 3 {
      pipeline_binop_int_prim_node(node_f1(stripped), node_f2(stripped), node_f3(stripped), params, locals, src, tt, fns, subst)
    } else { if tag == 37 {
      let ann_prim = pipeline_type_node_prim_id_or(node_f2(stripped), 0 - 1)
      if prim_is_integer(ann_prim) == 1 { ann_prim } else { 0 - 1 }
    } else { if tag == 4 {
      let ns = node_f1(stripped)
      let nl = node_f2(stripped)
      let direct = pipeline_call_callee_is_direct(params, locals, src, ns, nl)
      if direct == 1 {
        pipeline_fns_lookup_ret_int_prim(fns, src, ns, nl, subst)
      } else {
        let result_ty = pipeline_call_result_type_node(params, locals, src, tt, fns, subst, ns, nl)
        let prim = pipeline_type_node_prim_id_or(result_ty, 0 - 1)
        if prim_is_integer(prim) == 1 { prim } else { 0 - 1 }
      }
    } else { if tag == 36 {
      let inner_call = node_f2(stripped)
      if inner_call != 0 and node_tag(inner_call) == 4 {
        let concrete_type_args = if subst == 0 { node_f1(stripped) } else { type_list_subst(node_f1(stripped), subst) }
        let pair = pipeline_generic_template_find(fns, src, str_hash(src, node_f1(inner_call), node_f2(inner_call)))
        if pair == 0 { 0 - 1 }
        else {
          let fn_wrap = node_f1(pair)
          let s = cg_build_subst(fn_tparams(fn_wrap), concrete_type_args)
          pipeline_fn_return_int_prim(fn_wrap, s)
        }
      } else { 0 - 1 }
    } else {
      0 - 1
    } } } } } }
  }
}

pub(package) fn pipeline_binop_int_prim_node(op_id: i64, lhs_node: i64, rhs_node: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, fns: i64, subst: i64) -> i64 {
  let prim = pipeline_binop_int_result_prim_node(op_id, lhs_node, rhs_node, params, locals, src, tt, fns, subst)
  if pipeline_prim_is_non_native_int(prim) == 1 { prim } else { 0 - 1 }
}

pub(package) fn pipeline_binop_int_result_prim_node(op_id: i64, lhs_node: i64, rhs_node: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, fns: i64, subst: i64) -> i64 {
  if pipeline_binop_int_op_tracks_prim(op_id) == 1 {
    let lp = pipeline_expr_int_prim_node(lhs_node, params, locals, src, tt, fns, subst)
    let rp = pipeline_expr_int_prim_node(rhs_node, params, locals, src, tt, fns, subst)
    pipeline_binop_int_candidate_prim(lp, rp)
  } else { 0 - 1 }
}

pub(package) fn pipeline_lower_float_lit_typed(src: i64, start: i64, len: i64, next_value: i64, prim: i64) -> IrLoweredExpr {
  let bits_result = if prim == PRIM_F32() { cg_decimal_f32_bits(src, start, len) } else { cg_decimal_f64_bits(src, start, len) }
  if node_f2(bits_result) == 1 {
    ir_lowered_expr(
      next_value,
      next_value + 1,
      ir_inst_list_prepend(ir_inst_const_i64(next_value, node_f1(bits_result)), ir_inst_list_empty())
    )
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

pub(package) fn pipeline_lower_binop_expr_typed_sidecar_handler_opt_with_float_prim(op_id: i64, lhs_expr: Expr, rhs_expr: Expr, next_value: i64, lower_ctx: PipelineHandlerLowerCtx, prim: i64) -> IrLoweredExpr {
  let lhs = pipeline_lower_expr_typed_sidecar_handler_opt_with_float_prim(lhs_expr, next_value, lower_ctx, prim)
  if ir_lowered_expr_is_valid(lhs) == 1 {
    let rhs = pipeline_lower_expr_typed_sidecar_handler_opt_with_float_prim(rhs_expr, ir_lowered_expr_next_value(lhs), lower_ctx, prim)
    if ir_lowered_expr_is_valid(rhs) == 1 {
      let op = ir_binary_op_from_parser(op_id)
      if ir_binary_op_is_supported(op) == 1 {
        let dst = ir_lowered_expr_next_value(rhs)
        let inst = ir_inst_list_prepend(
          ir_inst_float_binary_i64(dst, prim, op, ir_lowered_expr_value(lhs), ir_lowered_expr_value(rhs)),
          ir_inst_list_empty()
        )
        let insts = ir_inst_list_append(ir_lowered_expr_insts(lhs), ir_inst_list_append(ir_lowered_expr_insts(rhs), inst))
        ir_lowered_expr(dst, dst + 1, insts)
      } else {
        ir_lowered_expr_invalid(next_value)
      }
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

pub(package) fn pipeline_lower_expr_typed_sidecar_handler_opt_with_float_prim(expr: Expr, next_value: i64, lower_ctx: PipelineHandlerLowerCtx, prim: i64) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let ctx = pipeline_handler_lower_ctx_handlers(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  match expr {
    FloatLit(start, len) -> pipeline_lower_float_lit_typed(src, start, len, next_value, prim)
    BinOp(op, lhs, rhs) -> {
      if pipeline_prim_is_forced_numeric_context(prim) == 1 {
        pipeline_lower_binop_expr_typed_sidecar_handler_opt_with_float_prim(op, lhs, rhs, next_value, lower_ctx, prim)
      } else {
        pipeline_lower_expr_typed_sidecar_handler_ctx(expr, next_value, lower_ctx)
      }
    }
    _ -> pipeline_lower_expr_typed_sidecar_handler_ctx(expr, next_value, lower_ctx)
  }
}

pub(package) fn pipeline_lower_binop_expr_typed_sidecar_handler_opt(op_id: i64, lhs_expr: Expr, rhs_expr: Expr, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let ctx = pipeline_handler_lower_ctx_handlers(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  let float_prim = pipeline_binop_float_prim_typed_temp(op_id, lhs_expr, rhs_expr, params, locals, src, tt, pipeline_handler_lower_ctx_fns(lower_ctx), subst)
  let int_prim = if float_prim == 0 {
    pipeline_binop_int_prim_typed(op_id, lhs_expr, rhs_expr, params, locals, src, pipeline_handler_lower_ctx_fns(lower_ctx), subst)
  } else { 0 - 1 }
  let numeric_prim = if float_prim != 0 { float_prim } else { int_prim }
  let lhs = if float_prim != 0 or int_prim >= 0 {
    pipeline_lower_expr_typed_sidecar_handler_opt_with_float_prim(lhs_expr, next_value, lower_ctx, numeric_prim)
  } else {
    pipeline_lower_expr_typed_sidecar_handler_ctx(lhs_expr, next_value, lower_ctx)
  }
  if ir_lowered_expr_is_valid(lhs) == 1 {
    let rhs = if float_prim != 0 or int_prim >= 0 {
      pipeline_lower_expr_typed_sidecar_handler_opt_with_float_prim(rhs_expr, ir_lowered_expr_next_value(lhs), lower_ctx, numeric_prim)
    } else {
      pipeline_lower_expr_typed_sidecar_handler_ctx(rhs_expr, ir_lowered_expr_next_value(lhs), lower_ctx)
    }
    if ir_lowered_expr_is_valid(rhs) == 1 {
      let op = ir_binary_op_from_parser(op_id)
      if ir_binary_op_is_supported(op) == 1 {
        let dst = ir_lowered_expr_next_value(rhs)
        if float_prim == 0 and int_prim < 0 and pipeline_binop_is_str_content_eq(op_id, lhs_expr, rhs_expr, params, locals, src, tt, pipeline_handler_lower_ctx_fns(lower_ctx), subst) == 1 {
          let result = pipeline_str_content_eq_result(op_id, dst)
          let insts = ir_inst_list_append(
            ir_lowered_expr_insts(lhs),
            ir_inst_list_append(ir_lowered_expr_insts(rhs), pipeline_str_content_eq_insts(op_id, dst, ir_lowered_expr_value(lhs), ir_lowered_expr_value(rhs)))
          )
          ir_lowered_expr(result, result + 1, insts)
        } else {
        let inst = if float_prim != 0 {
          ir_inst_float_binary_i64(dst, float_prim, op, ir_lowered_expr_value(lhs), ir_lowered_expr_value(rhs))
        } else { if int_prim >= 0 {
          ir_inst_float_binary_i64(dst, int_prim, op, ir_lowered_expr_value(lhs), ir_lowered_expr_value(rhs))
        } else {
          ir_inst_binary_i64(dst, op, ir_lowered_expr_value(lhs), ir_lowered_expr_value(rhs))
        } }
        let binary = ir_inst_list_prepend(
          inst,
          ir_inst_list_empty()
        )
        let insts = ir_inst_list_append(
          ir_lowered_expr_insts(lhs),
          ir_inst_list_append(ir_lowered_expr_insts(rhs), binary)
        )
        ir_lowered_expr(dst, dst + 1, insts)
        }
      } else {
        ir_lowered_expr_invalid(next_value)
      }
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

pub(package) fn pipeline_lower_not_expr_typed_sidecar_handler_opt(operand: Expr, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let ctx = pipeline_handler_lower_ctx_handlers(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  let value = pipeline_lower_expr_typed_sidecar_handler_ctx(operand, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(value) == 1 {
    let dst = ir_lowered_expr_next_value(value)
    let unary = ir_inst_list_prepend(
      ir_inst_unary_i64(dst, ir_unary_op_not(), ir_lowered_expr_value(value)),
      ir_inst_list_empty()
    )
    let insts = ir_inst_list_append(ir_lowered_expr_insts(value), unary)
    ir_lowered_expr(dst, dst + 1, insts)
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

pub(package) fn pipeline_lower_block_expr_typed_sidecar_handler_opt(first_expr: Expr, rest_expr: Expr, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let ctx = pipeline_handler_lower_ctx_handlers(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  let first = pipeline_lower_expr_typed_sidecar_handler_ctx(first_expr, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(first) == 1 {
    let discard_insts = pipeline_discard_cleanup_inst_list(first_expr, params, locals, pipeline_handler_lower_ctx_module(lower_ctx), ir_lowered_expr_value(first), ir_lowered_expr_next_value(first))
    let after_discard = ir_lowered_expr_next_value(first) + ir_inst_list_len(discard_insts)
    match rest_expr {
      UnknownExpr(tag) -> {
        if tag == 0 {
          first
        } else {
          let rest = pipeline_lower_expr_typed_sidecar_handler_ctx(rest_expr, after_discard, lower_ctx)
          if ir_lowered_expr_is_valid(rest) == 1 {
            ir_lowered_expr(
              ir_lowered_expr_value(rest),
              ir_lowered_expr_next_value(rest),
              ir_inst_list_append(ir_lowered_expr_insts(first), ir_inst_list_append(discard_insts, ir_lowered_expr_insts(rest)))
            )
          } else {
            ir_lowered_expr_invalid(next_value)
          }
        }
      }
      _ -> {
        let rest = pipeline_lower_expr_typed_sidecar_handler_ctx(rest_expr, after_discard, lower_ctx)
        if ir_lowered_expr_is_valid(rest) == 1 {
          ir_lowered_expr(
            ir_lowered_expr_value(rest),
            ir_lowered_expr_next_value(rest),
            ir_inst_list_append(ir_lowered_expr_insts(first), ir_inst_list_append(discard_insts, ir_lowered_expr_insts(rest)))
          )
        } else {
          ir_lowered_expr_invalid(next_value)
        }
      }
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

pub(package) fn pipeline_name_matches(src: i64, a_ns: i64, a_nl: i64, b_ns: i64, b_nl: i64) -> bool {
  if a_nl != b_nl { false } else { src_eq_at(src, a_ns, src + b_ns, 0, a_nl) }
}

pub(package) fn pipeline_param_list_contains_name(params: ParamList, src: i64, ns: i64, nl: i64) -> i64 {
  match params {
    ParamListNil -> 0
    ParamListCons(param, rest) -> {
      let found = match param {
        Param(p_ns, p_nl, ty, label) -> pipeline_name_matches(src, ns, nl, p_ns, p_nl)
        UnknownParam(tag) -> 0
      }
      if found == 1 { 1 } else { pipeline_param_list_contains_name(rest, src, ns, nl) }
    }
  }
}

pub(package) fn pipeline_expr_node_list_address_of_binding(args: i64, count: i64, src: i64, ns: i64, nl: i64) -> bool {
  let mut found = false
  let mut i = 0
  while i < count and found == 0 {
    if pipeline_expr_node_address_of_binding(nlist_get(args, i), src, ns, nl) == 1 { found = true } else { i = i + 1 }
  }
  found
}

pub(package) fn pipeline_record_field_nodes_address_of_binding(fields: i64, count: i64, src: i64, ns: i64, nl: i64) -> bool {
  let mut found = false
  let mut i = 0
  while i < count and found == false {
    let field = nlist_get(fields, i)
    if pipeline_expr_node_address_of_binding(node_f3(field), src, ns, nl) == 1 { found = 1 } else { i = i + 1 }
  }
  found
}

pub(package) fn pipeline_handler_clause_nodes_address_of_binding(clauses: i64, count: i64, src: i64, ns: i64, nl: i64) -> bool {
  let mut found = false
  let mut i = 0
  while i < count and found == 0 {
    let clause = nlist_get(clauses, i)
    if pipeline_param_list_refs_name(node_f2(clause), src, ns, nl) == 1 { i = i + 1 }
    else { if pipeline_expr_node_address_of_binding(node_f3(clause), src, ns, nl) == 1 { found = true } else { i = i + 1 } }
  }
  found
}

pub(package) fn pipeline_match_arm_nodes_address_of_binding(arms: i64, count: i64, src: i64, ns: i64, nl: i64) -> bool {
  let mut found = false
  let mut i = 0
  while i < count and found == 0 {
    let arm = nlist_get(arms, i)
    let guard_hit = if node_f3(arm) == 0 { 0 } else { pipeline_expr_node_address_of_binding(node_f3(arm), src, ns, nl) }
    if guard_hit == 1 { found = true }
    else { if pipeline_expr_node_address_of_binding(node_f2(arm), src, ns, nl) == 1 { found = true } else { i = i + 1 } }
  }
  found
}

pub(package) fn pipeline_expr_node_address_of_binding(node: i64, src: i64, ns: i64, nl: i64) -> bool {
  let mut result = false
  if node != 0 {
    let tag = node_tag(node)
    let mut handled = false
    if tag == 3 {
      result = pipeline_expr_node_address_of_binding(node_f2(node), src, ns, nl) or pipeline_expr_node_address_of_binding(node_f3(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 4 {
      result = pipeline_expr_node_list_address_of_binding(node_f3(node), node_f4(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 5 {
      result = pipeline_expr_node_address_of_binding(node_f1(node), src, ns, nl) or pipeline_expr_node_address_of_binding(node_f2(node), src, ns, nl) or pipeline_expr_node_address_of_binding(node_f3(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 6 {
      if pipeline_expr_node_address_of_binding(node_f3(node), src, ns, nl) == 1 { result = 1 }
      else { if pipeline_name_matches(src, ns, nl, node_f1(node), node_f2(node)) == 1 { result = 0 } else { result = pipeline_expr_node_address_of_binding(node_f4(node), src, ns, nl) } }
      handled = 1
    } else { false }
    if handled == 0 and tag == 7 {
      result = pipeline_expr_node_address_of_binding(node_f1(node), src, ns, nl) or pipeline_expr_node_address_of_binding(node_f2(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 10 {
      result = pipeline_expr_node_address_of_binding(node_f1(node), src, ns, nl) or pipeline_expr_node_address_of_binding(node_f2(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 11 {
      if pipeline_expr_node_address_of_binding(node_f3(node), src, ns, nl) == 1 { result = 1 }
      else { if pipeline_name_matches(src, ns, nl, node_f1(node), node_f2(node)) == 1 { result = 0 } else { result = pipeline_expr_node_address_of_binding(node_f4(node), src, ns, nl) } }
      handled = 1
    } else { false }
    if handled == 0 and tag == 12 {
      result = pipeline_expr_node_address_of_binding(node_f3(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 13 {
      result = pipeline_expr_node_address_of_binding(node_f1(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 59 {
      result = pipeline_expr_node_address_of_binding(node_f1(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 60 {
      result = pipeline_expr_node_address_of_binding(node_f1(node), src, ns, nl) or pipeline_expr_node_address_of_binding(node_f2(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 61 {
      result = pipeline_expr_node_address_of_binding(node_f1(node), src, ns, nl) or pipeline_expr_node_address_of_binding(node_f2(node), src, ns, nl) or pipeline_expr_node_address_of_binding(node_f3(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 62 {
      result = pipeline_expr_node_address_of_binding(node_f1(node), src, ns, nl) or pipeline_expr_node_address_of_binding(node_f2(node), src, ns, nl) or pipeline_expr_node_address_of_binding(node_f3(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 14 {
      result = pipeline_record_field_nodes_address_of_binding(node_f3(node), node_f4(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 63 {
      result = pipeline_expr_node_address_of_binding(node_f1(node), src, ns, nl) or pipeline_record_field_nodes_address_of_binding(node_f2(node), node_f3(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 58 {
      result = pipeline_expr_node_list_address_of_binding(node_f1(node), node_f2(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 15 {
      result = pipeline_expr_node_address_of_binding(node_f1(node), src, ns, nl) or pipeline_match_arm_nodes_address_of_binding(node_f2(node), node_f3(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 22 {
      result = pipeline_expr_node_address_of_binding(node_f1(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 25 {
      result = pipeline_expr_node_address_of_binding(node_f1(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 26 {
      result = pipeline_expr_node_address_of_binding(node_f1(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 29 {
      if pipeline_param_list_refs_name(node_f1(node), src, ns, nl) == 1 { result = 0 } else { result = pipeline_expr_node_address_of_binding(node_f2(node), src, ns, nl) }
      handled = 1
    } else { false }
    if handled == 0 and tag == 32 {
      result = pipeline_expr_node_address_of_binding(node_f1(node), src, ns, nl) or pipeline_expr_node_list_address_of_binding(node_f4(node), nlist_len(node_f4(node)), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 33 {
      result = pipeline_expr_node_address_of_binding(node_f1(node), src, ns, nl) or pipeline_handler_clause_nodes_address_of_binding(node_f2(node), node_f3(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 35 {
      result = pipeline_expr_node_address_of_binding(node_f1(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 36 {
      result = pipeline_expr_node_address_of_binding(node_f2(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 37 {
      result = pipeline_expr_node_address_of_binding(node_f1(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 41 {
      result = pipeline_expr_node_address_of_binding(node_f1(node), src, ns, nl) or pipeline_expr_node_list_address_of_binding(node_f3(node), nlist_len(node_f3(node)), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 45 {
      result = pipeline_expr_node_address_of_binding(node_f1(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 46 {
      result = pipeline_expr_node_address_of_binding(node_f1(node), src, ns, nl) or pipeline_expr_node_address_of_binding(node_f2(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 47 {
      if pipeline_expr_node_address_of_binding(node_f3(node), src, ns, nl) == 1 { result = 1 }
      else { if pipeline_name_matches(src, ns, nl, node_f1(node), node_f2(node)) == 1 { result = 0 } else { result = pipeline_expr_node_address_of_binding(node_f4(node), src, ns, nl) } }
      handled = 1
    } else { false }
    if handled == 0 and tag == 48 {
      result = pipeline_expr_node_address_of_binding(node_f1(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 49 {
      result = pipeline_expr_node_address_of_binding(node_f1(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 52 {
      result = pipeline_expr_node_address_of_binding(node_f1(node), src, ns, nl) or pipeline_expr_node_address_of_binding(node_f2(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 55 {
      let target = node_f2(node)
      if node_tag(target) == 2 {
        result = pipeline_name_matches(src, ns, nl, node_f1(target), node_f2(target))
      } else {
        result = pipeline_expr_node_address_of_binding(target, src, ns, nl)
      }
      handled = 1
    } else { false }
    if handled == 0 and tag == 56 {
      result = pipeline_expr_node_address_of_binding(node_f1(node), src, ns, nl)
      handled = 1
    } else { false }
    if handled == 0 and tag == 57 {
      result = pipeline_expr_node_address_of_binding(node_f1(node), src, ns, nl) or pipeline_expr_node_address_of_binding(node_f2(node), src, ns, nl)
      handled = 1
    } else { false }
  } else { false }
  result
}

pub(package) fn pipeline_expr_address_of_binding(expr: Expr, src: i64, ns: i64, nl: i64) -> i64 {
  pipeline_expr_typed_address_of_binding(expr, src, ns, nl)
}

pub(package) fn pipeline_param_list_refs_name_typed(params: ParamList, src: i64, ns: i64, nl: i64) -> i64 {
  match params {
    ParamListNil -> 0
    ParamListCons(param, rest) -> {
      match param {
        Param(pns, pnl, ty, label) -> {
          if pipeline_name_matches(src, pns, pnl, ns, nl) == 1 { 1 } else { pipeline_param_list_refs_name_typed(rest, src, ns, nl) }
        }
        UnknownParam(tag) -> pipeline_param_list_refs_name_typed(rest, src, ns, nl)
      }
    }
  }
}

pub(package) fn pipeline_expr_list_refs_name_typed(exprs: ExprList, src: i64, ns: i64, nl: i64) -> bool {
  match exprs {
    ExprListNil -> false
    ExprListCons(expr, rest) -> {
      if pipeline_expr_refs_name_typed(expr, src, ns, nl) == 1 { true } else { pipeline_expr_list_refs_name_typed(rest, src, ns, nl) }
    }
  }
}

pub(package) fn pipeline_record_fields_refs_name_typed(fields: RecordFieldList, src: i64, ns: i64, nl: i64) -> bool {
  match fields {
    RecordFieldListNil -> false
    RecordFieldListCons(field, rest) -> {
      match field {
        RecordField(fns, fnl, value, fact) -> {
          if pipeline_expr_refs_name_typed(value, src, ns, nl) == 1 { true } else { pipeline_record_fields_refs_name_typed(rest, src, ns, nl) }
        }
        UnknownRecordField(tag) -> pipeline_record_fields_refs_name_typed(rest, src, ns, nl)
      }
    }
  }
}

pub(package) fn pipeline_handler_clauses_refs_name_typed(clauses: HandlerClauseList, src: i64, ns: i64, nl: i64) -> bool {
  match clauses {
    HandlerClauseListNil -> false
    HandlerClauseListCons(clause, rest) -> {
      match clause {
        HandlerClause(name_info, params, body, continuation) -> {
          if pipeline_param_list_refs_name_typed(params, src, ns, nl) == 1 { pipeline_handler_clauses_refs_name_typed(rest, src, ns, nl) }
          else { if pipeline_expr_refs_name_typed(body, src, ns, nl) == 1 { true } else { pipeline_handler_clauses_refs_name_typed(rest, src, ns, nl) } }
        }
        UnknownHandlerClause(tag) -> pipeline_handler_clauses_refs_name_typed(rest, src, ns, nl)
      }
    }
  }
}

pub(package) fn pipeline_match_arms_refs_name_typed(arms: MatchArmList, src: i64, ns: i64, nl: i64) -> bool {
  match arms {
    MatchArmListNil -> false
    MatchArmListCons(arm, rest) -> {
      match arm {
        Arm(pattern, body, guard, has_guard) -> {
          let guard_hit = if has_guard == 0 { false } else { pipeline_expr_refs_name_typed(guard, src, ns, nl) }
          if guard_hit == 1 { true }
          else { if pipeline_expr_refs_name_typed(body, src, ns, nl) == 1 { true } else { pipeline_match_arms_refs_name_typed(rest, src, ns, nl) } }
        }
        UnknownArm(tag) -> pipeline_match_arms_refs_name_typed(rest, src, ns, nl)
      }
    }
  }
}

pub(package) fn pipeline_expr_refs_name_typed(expr: Expr, src: i64, ns: i64, nl: i64) -> bool {
  match expr {
    NilExpr -> false
    Ident(ens, enl) -> pipeline_name_matches(src, ens, enl, ns, nl)
    BorrowIdent(ens, enl, owner, mutable) -> false
    BinOp(op, lhs, rhs) -> pipeline_expr_refs_name_typed(lhs, src, ns, nl) or pipeline_expr_refs_name_typed(rhs, src, ns, nl)
    Call(cns, cnl, args) -> pipeline_expr_list_refs_name_typed(args, src, ns, nl)
    GenericCall(type_args, inner_call) -> pipeline_expr_refs_name_typed(inner_call, src, ns, nl)
    If(cond, then_expr, else_expr) -> pipeline_expr_refs_name_typed(cond, src, ns, nl) or pipeline_expr_refs_name_typed(then_expr, src, ns, nl) or pipeline_expr_refs_name_typed(else_expr, src, ns, nl)
    While(cond, body) -> pipeline_expr_refs_name_typed(cond, src, ns, nl) or pipeline_expr_refs_name_typed(body, src, ns, nl)
    Loop(body) -> pipeline_expr_refs_name_typed(body, src, ns, nl)
    Break(value) -> pipeline_expr_refs_name_typed(value, src, ns, nl)
    Return(value) -> pipeline_expr_refs_name_typed(value, src, ns, nl)
    Defer(cleanup, body, source_site) -> pipeline_expr_refs_name_typed(cleanup, src, ns, nl) or pipeline_expr_refs_name_typed(body, src, ns, nl)
    Let(bns, bnl, value, body) -> {
      if pipeline_expr_refs_name_typed(value, src, ns, nl) == 1 { true }
      else { if pipeline_name_matches(src, ns, nl, bns, bnl) == 1 { false } else { pipeline_expr_refs_name_typed(body, src, ns, nl) } }
    }
    LetMut(bns, bnl, value, body) -> {
      if pipeline_expr_refs_name_typed(value, src, ns, nl) == 1 { true }
      else { if pipeline_name_matches(src, ns, nl, bns, bnl) == 1 { false } else { pipeline_expr_refs_name_typed(body, src, ns, nl) } }
    }
    Assign(ans, anl, value) -> pipeline_expr_refs_name_typed(value, src, ns, nl)
    AddressOf(mutable, target) -> pipeline_expr_refs_name_typed(target, src, ns, nl)
    Deref(ptr) -> pipeline_expr_refs_name_typed(ptr, src, ns, nl)
    PtrAssign(ptr, value) -> pipeline_expr_refs_name_typed(ptr, src, ns, nl) or pipeline_expr_refs_name_typed(value, src, ns, nl)
    Block(first, rest) -> pipeline_expr_refs_name_typed(first, src, ns, nl) or pipeline_expr_refs_name_typed(rest, src, ns, nl)
    FieldAccess(base, field_ns, field_nl, fact) -> pipeline_expr_refs_name_typed(base, src, ns, nl)
    IndexedLen(base, fixed_len) -> pipeline_expr_refs_name_typed(base, src, ns, nl)
    IndexedGet(base, index, element_ty, fixed_len) -> pipeline_expr_refs_name_typed(base, src, ns, nl) or pipeline_expr_refs_name_typed(index, src, ns, nl)
    IndexedSet(base, index, value, fact) -> pipeline_expr_refs_name_typed(base, src, ns, nl) or pipeline_expr_refs_name_typed(index, src, ns, nl) or pipeline_expr_refs_name_typed(value, src, ns, nl)
    IndexedSlice(base, start, end, fact) -> pipeline_expr_refs_name_typed(base, src, ns, nl) or pipeline_expr_refs_name_typed(start, src, ns, nl) or pipeline_expr_refs_name_typed(end, src, ns, nl)
    RecordInit(type_ns, type_nl, fields) -> pipeline_record_fields_refs_name_typed(fields, src, ns, nl)
    RecordUpdate(base, fields, fact) -> pipeline_expr_refs_name_typed(base, src, ns, nl) or pipeline_record_fields_refs_name_typed(fields, src, ns, nl)
    ArrayLiteral(elements, resolved_ty, span) -> pipeline_expr_list_refs_name_typed(elements, src, ns, nl)
    Match(scrutinee, arms) -> pipeline_expr_refs_name_typed(scrutinee, src, ns, nl) or pipeline_match_arms_refs_name_typed(arms, src, ns, nl)
    Not(operand) -> pipeline_expr_refs_name_typed(operand, src, ns, nl)
    Lambda(params, body, source_site) -> {
      if pipeline_param_list_refs_name_typed(params, src, ns, nl) == 1 { false } else { pipeline_expr_refs_name_typed(body, src, ns, nl) }
    }
    Perform(lhs, op_ns, op_nl, args) -> pipeline_expr_refs_name_typed(lhs, src, ns, nl) or pipeline_expr_list_refs_name_typed(args, src, ns, nl)
    Handle(body, clauses, hret) -> pipeline_expr_refs_name_typed(body, src, ns, nl) or pipeline_handler_clauses_refs_name_typed(clauses, src, ns, nl) or (match hret { NoHandleReturn -> false HandleReturnClause(rns, rnl, rb) -> pipeline_expr_refs_name_typed(rb, src, ns, nl) })
    WithHandler(config, body, fact, source_site) -> pipeline_expr_list_refs_name_typed(handler_configuration_args(config), src, ns, nl) or pipeline_expr_refs_name_typed(body, src, ns, nl)
    Resume(value) -> pipeline_expr_refs_name_typed(value, src, ns, nl)
    MethodCall(recv, method_hash, args, type_hash) -> pipeline_expr_refs_name_typed(recv, src, ns, nl) or pipeline_expr_list_refs_name_typed(args, src, ns, nl)
    Try(inner, effect_atom) -> pipeline_expr_refs_name_typed(inner, src, ns, nl)
    InterpConcat(left, right) -> pipeline_expr_refs_name_typed(left, src, ns, nl) or pipeline_expr_refs_name_typed(right, src, ns, nl)
    ForIter(var_ns, var_nl, collection, body) -> {
      if pipeline_expr_refs_name_typed(collection, src, ns, nl) == 1 { true }
      else { if pipeline_name_matches(src, ns, nl, var_ns, var_nl) == 1 { false } else { pipeline_expr_refs_name_typed(body, src, ns, nl) } }
    }
    OptChain(base, field_ns, field_nl, effect_atom) -> pipeline_expr_refs_name_typed(base, src, ns, nl)
    LetTyped(inner, ann_type) -> pipeline_expr_refs_name_typed(inner, src, ns, nl)
    _ -> false
  }
}

-- Whether ANY final path of the expr can return the binding. Scope
-- release is skipped when this reports 1 — a borrowed merge that
-- aliases the binding must not be freed under the consumer (leak on
-- the other arms is the accepted trade; the mixed borrowed/owned case
-- is handled by per-arm retains, but an all-borrowed merge carries no
-- count of its own).
pub(package) fn pipeline_expr_final_returns_binding_typed(expr: Expr, src: i64, ns: i64, nl: i64) -> i64 {
  match expr {
    Ident(ens, enl) -> pipeline_name_matches(src, ns, nl, ens, enl)
    Block(first, rest) -> pipeline_expr_final_returns_binding_typed(rest, src, ns, nl)
    Let(bns, bnl, value, body) -> {
      if pipeline_name_matches(src, ns, nl, bns, bnl) == 1 { 0 }
      else { pipeline_expr_final_returns_binding_typed(body, src, ns, nl) }
    }
    LetMut(bns, bnl, value, body) -> {
      if pipeline_name_matches(src, ns, nl, bns, bnl) == 1 { 0 }
      else { pipeline_expr_final_returns_binding_typed(body, src, ns, nl) }
    }
    LetTyped(inner, ann_type) -> pipeline_expr_final_returns_binding_typed(inner, src, ns, nl)
    -- `resume(value)` transfers the value back to the suspended perform site
    -- just as an ordinary final expression transfers it to its caller. A
    -- managed let binding returned through resume must therefore keep its
    -- stake; treating Resume as an unrelated expression releases the binding
    -- immediately before dispatch and leaves the perform site with freed
    -- storage.
    Resume(value) -> pipeline_expr_final_returns_binding_typed(value, src, ns, nl)
    If(cond, then_expr, else_expr) -> {
      if pipeline_expr_final_returns_binding_typed(then_expr, src, ns, nl) == 1 { 1 }
      else { pipeline_expr_final_returns_binding_typed(else_expr, src, ns, nl) }
    }
    Match(scrutinee, arms) -> pipeline_match_arms_final_return_binding_typed(arms, src, ns, nl)
    Defer(cleanup, body, source_site) -> pipeline_expr_final_returns_binding_typed(body, src, ns, nl)
    _ -> 0
  }
}

pub(package) fn pipeline_expr_exact_result_param_index_typed(expr: Expr, params: i64, src: i64) -> i64 {
  match expr {
    Ident(ns, nl) -> pipeline_param_index(params, src, ns, nl)
    Resume(value) -> pipeline_expr_exact_result_param_index_typed(value, params, src)
    Block(first, rest) -> pipeline_expr_exact_result_param_index_typed(rest, params, src)
    Let(ns, nl, value, body) -> {
      let index = pipeline_expr_exact_result_param_index_typed(body, params, src)
      if index >= 0 {
        let param = nlist_get(params, index)
        if pipeline_name_matches(src, node_f1(param), node_f2(param), ns, nl) == 1 { 0 - 1 } else { index }
      } else { 0 - 1 }
    }
    LetMut(ns, nl, value, body) -> {
      let index = pipeline_expr_exact_result_param_index_typed(body, params, src)
      if index >= 0 {
        let param = nlist_get(params, index)
        if pipeline_name_matches(src, node_f1(param), node_f2(param), ns, nl) == 1 { 0 - 1 } else { index }
      } else { 0 - 1 }
    }
    LetTyped(inner, ann_type) -> pipeline_expr_exact_result_param_index_typed(inner, params, src)
    If(cond, then_expr, else_expr) -> {
      let left = pipeline_expr_exact_result_param_index_typed(then_expr, params, src)
      let right = pipeline_expr_exact_result_param_index_typed(else_expr, params, src)
      if left >= 0 and left == right { left } else { 0 - 1 }
    }
    Defer(cleanup, body, source_site) -> pipeline_expr_exact_result_param_index_typed(body, params, src)
    _ -> 0 - 1
  }
}

pub(package) fn pipeline_match_arms_final_return_binding_typed(arms: MatchArmList, src: i64, ns: i64, nl: i64) -> i64 {
  match arms {
    MatchArmListNil -> 0
    MatchArmListCons(arm, rest) -> {
      let found = match arm {
        Arm(pattern, body, guard, has_guard) -> pipeline_expr_final_returns_binding_typed(body, src, ns, nl)
        UnknownArm(tag) -> 0
      }
      if found == 1 { 1 } else { pipeline_match_arms_final_return_binding_typed(rest, src, ns, nl) }
    }
  }
}

pub(package) fn pipeline_expr_final_returns_non_param_ident_typed(expr: Expr, params: i64, src: i64) -> i64 {
  match expr {
    Ident(ns, nl) -> if pipeline_param_index(params, src, ns, nl) >= 0 { 0 } else { 1 }
    Block(first, rest) -> pipeline_expr_final_returns_non_param_ident_typed(rest, params, src)
    Let(ns, nl, value, body) -> pipeline_expr_final_returns_non_param_ident_typed(body, params, src)
    LetMut(ns, nl, value, body) -> pipeline_expr_final_returns_non_param_ident_typed(body, params, src)
    LetTyped(inner, ann_type) -> pipeline_expr_final_returns_non_param_ident_typed(inner, params, src)
    Defer(cleanup, body, source_site) -> pipeline_expr_final_returns_non_param_ident_typed(body, params, src)
    _ -> 0
  }
}

pub(package) fn pipeline_expr_result_is_borrowed_with_ctx_typed(expr: Expr, src: i64, fns: i64, subst: i64, tt: i64) -> i64 {
  match expr {
    Ident(ns, nl) -> if pipeline_ident_is_payloadless_ctor(tt, src, ns, nl) == 1 { 0 } else { 1 }
    BorrowIdent(ns, nl, owner, mutable) -> 1
    FieldAccess(base, field_ns, field_nl, fact) -> 1
    IndexedLen(base, fixed_len) -> 0
    IndexedGet(base, index, element_ty, fixed_len) -> 0
    IndexedSet(base, index, value, fact) -> 0
    IndexedSlice(base, start, end, fact) -> 0
    OptChain(base, field_ns, field_nl, effect_atom) -> 1
    Call(ns, nl, args) -> 0
    GenericCall(type_args, inner_call) -> {
      match inner_call {
        Call(ns, nl, args) -> 0
        _ -> pipeline_expr_result_is_borrowed_with_ctx_typed(inner_call, src, fns, subst, tt)
      }
    }
    Block(first, rest) -> pipeline_expr_result_is_borrowed_with_ctx_typed(rest, src, fns, subst, tt)
    -- An immutable binding of an OWNED init transfers that count when
    -- the binding itself is the final result (scope lowering skips its
    -- release). Classifying that case as borrowed made an enclosing
    -- mixed if/match add another arm-normalisation retain. Keep
    -- borrowed inits and let-mut conservative: their binding retain or
    -- later slot contents are not proven here.
    Let(ns, nl, value, body) -> {
      if pipeline_expr_final_returns_binding_typed(body, src, ns, nl) == 1 and pipeline_expr_result_is_borrowed_with_ctx_typed(value, src, fns, subst, tt) == 0 { 0 }
      else { pipeline_expr_result_is_borrowed_with_ctx_typed(body, src, fns, subst, tt) }
    }
    LetMut(ns, nl, value, body) -> pipeline_expr_result_is_borrowed_with_ctx_typed(body, src, fns, subst, tt)
    LetTyped(inner, ann_type) -> pipeline_expr_result_is_borrowed_with_ctx_typed(inner, src, fns, subst, tt)
    If(cond, then_expr, else_expr) -> {
      if pipeline_expr_result_is_borrowed_with_ctx_typed(then_expr, src, fns, subst, tt) == 1 {
        pipeline_expr_result_is_borrowed_with_ctx_typed(else_expr, src, fns, subst, tt)
      } else { 0 }
    }
    Match(scrutinee, arms) -> {
      if pipeline_expr_owned_rvalue_temp_typed(scrutinee, src, tt) == 1 { 0 }
      else { pipeline_match_arms_result_is_borrowed_with_ctx_typed(arms, src, fns, subst, tt) }
    }
    Defer(cleanup, body, source_site) -> pipeline_expr_result_is_borrowed_with_ctx_typed(body, src, fns, subst, tt)
    Resume(value) -> pipeline_expr_result_is_borrowed_with_ctx_typed(value, src, fns, subst, tt)
    Handle(body, clauses, hret) -> {
      match hret {
        NoHandleReturn -> pipeline_expr_result_is_borrowed_with_ctx_typed(body, src, fns, subst, tt)
        HandleReturnClause(rns, rnl, rb) -> pipeline_expr_result_is_borrowed_with_ctx_typed(rb, src, fns, subst, tt)
      }
    }
    WithHandler(config, body, fact, source_site) -> pipeline_expr_result_is_borrowed_with_ctx_typed(body, src, fns, subst, tt)
    _ -> 0
  }
}

-- Fixed-array values use one managed storage handle at typed-IR boundaries.
-- A field projection creates a fresh backing copy and is therefore owned;
-- identifiers remain borrowed aliases, while calls retain their established
-- owned-result convention. This is a semantic placement fact shared by every
-- ownership consumer rather than a codegen-side field recognizer.
pub(package) fn pipeline_array_expr_result_is_borrowed_typed(expr: Expr, src: i64, fns: i64, subst: i64, tt: i64) -> i64 {
  match expr {
    Ident(ns, nl) -> if pipeline_ident_is_payloadless_ctor(tt, src, ns, nl) == 1 { 0 } else { 1 }
    BorrowIdent(ns, nl, owner, mutable) -> 1
    FieldAccess(base, field_ns, field_nl, fact) -> 0
    IndexedGet(base, index, element_ty, fixed_len) -> 0
    IndexedSet(base, index, value, fact) -> 0
    IndexedSlice(base, start, end, fact) -> 0
    Call(ns, nl, args) -> 0
    GenericCall(type_args, inner_call) -> {
      match inner_call {
        Call(ns, nl, args) -> 0
        _ -> pipeline_array_expr_result_is_borrowed_typed(inner_call, src, fns, subst, tt)
      }
    }
    MethodCall(recv, method_hash, args, type_hash) -> 0
    Block(first, rest) -> pipeline_array_expr_result_is_borrowed_typed(rest, src, fns, subst, tt)
    Let(ns, nl, value, body) -> {
      if pipeline_expr_final_returns_binding_typed(body, src, ns, nl) == 1 and pipeline_array_expr_result_is_borrowed_typed(value, src, fns, subst, tt) == 0 { 0 }
      else { pipeline_array_expr_result_is_borrowed_typed(body, src, fns, subst, tt) }
    }
    LetMut(ns, nl, value, body) -> pipeline_array_expr_result_is_borrowed_typed(body, src, fns, subst, tt)
    LetTyped(inner, ann_type) -> pipeline_array_expr_result_is_borrowed_typed(inner, src, fns, subst, tt)
    If(cond, then_expr, else_expr) -> {
      if pipeline_array_expr_result_is_borrowed_typed(then_expr, src, fns, subst, tt) == 1 {
        pipeline_array_expr_result_is_borrowed_typed(else_expr, src, fns, subst, tt)
      } else { 0 }
    }
    Match(scrutinee, arms) -> pipeline_array_match_arms_result_is_borrowed_typed(arms, src, fns, subst, tt)
    Defer(cleanup, body, source_site) -> pipeline_array_expr_result_is_borrowed_typed(body, src, fns, subst, tt)
    Resume(value) -> pipeline_array_expr_result_is_borrowed_typed(value, src, fns, subst, tt)
    Handle(body, clauses, hret) -> {
      match hret {
        NoHandleReturn -> pipeline_array_expr_result_is_borrowed_typed(body, src, fns, subst, tt)
        HandleReturnClause(rns, rnl, rb) -> pipeline_array_expr_result_is_borrowed_typed(rb, src, fns, subst, tt)
      }
    }
    WithHandler(config, body, fact, source_site) -> pipeline_array_expr_result_is_borrowed_typed(body, src, fns, subst, tt)
    _ -> 0
  }
}

pub(package) fn pipeline_array_match_arms_result_is_borrowed_typed(arms: MatchArmList, src: i64, fns: i64, subst: i64, tt: i64) -> i64 {
  match arms {
    MatchArmListNil -> 1
    MatchArmListCons(arm, rest) -> {
      match arm {
        Arm(pattern, body, guard, has_guard) -> {
          if pipeline_array_expr_result_is_borrowed_typed(body, src, fns, subst, tt) == 1 {
            pipeline_array_match_arms_result_is_borrowed_typed(rest, src, fns, subst, tt)
          } else { 0 }
        }
        UnknownArm(tag) -> 0
      }
    }
  }
}

pub(package) fn pipeline_expr_result_is_borrowed_for_ty_typed(expr: Expr, ty: i64, src: i64, fns: i64, subst: i64, tt: i64) -> i64 {
  if ty_is_array(ty) { pipeline_array_expr_result_is_borrowed_typed(expr, src, fns, subst, tt) }
  else { pipeline_expr_result_is_borrowed_with_ctx_typed(expr, src, fns, subst, tt) }
}

pub(package) fn pipeline_match_arms_result_is_borrowed_with_ctx_typed(arms: MatchArmList, src: i64, fns: i64, subst: i64, tt: i64) -> i64 {
  match arms {
    MatchArmListNil -> 1
    MatchArmListCons(arm, rest) -> {
      match arm {
        Arm(pattern, body, guard, has_guard) -> {
          if pipeline_expr_result_is_borrowed_with_ctx_typed(body, src, fns, subst, tt) == 1 {
            pipeline_match_arms_result_is_borrowed_with_ctx_typed(rest, src, fns, subst, tt)
          } else { 0 }
        }
        UnknownArm(tag) -> 0
      }
    }
  }
}

pub(package) fn pipeline_expr_node_result_is_borrowed_with_ctx_typed(expr: i64, src: i64, fns: i64, subst: i64, tt: i64) -> i64 {
  let stripped = pipeline_expr_node_strip_typed(expr)
  if stripped == 0 { 0 } else { pipeline_expr_result_is_borrowed_with_ctx_typed(expr_from_node(stripped), src, fns, subst, tt) }
}

pub(package) fn pipeline_expr_node_result_is_borrowed_for_ty_typed(expr: i64, ty: i64, src: i64, fns: i64, subst: i64, tt: i64) -> i64 {
  let stripped = pipeline_expr_node_strip_typed(expr)
  if stripped == 0 { 0 } else { pipeline_expr_result_is_borrowed_for_ty_typed(expr_from_node(stripped), ty, src, fns, subst, tt) }
}

pub(package) fn pipeline_expr_result_is_any_param_borrow_typed(expr: Expr, params: i64, src: i64) -> i64 {
  match expr {
    Ident(ns, nl) -> if pipeline_param_index(params, src, ns, nl) >= 0 { 1 } else { 0 }
    FieldAccess(base, field_ns, field_nl, fact) -> pipeline_expr_result_is_any_param_borrow_typed(base, params, src)
    IndexedLen(base, fixed_len) -> 0
    IndexedGet(base, index, element_ty, fixed_len) -> 0
    IndexedSet(base, index, value, fact) -> 0
    IndexedSlice(base, start, end, fact) -> 0
    OptChain(base, field_ns, field_nl, effect_atom) -> pipeline_expr_result_is_any_param_borrow_typed(base, params, src)
    Block(first, rest) -> pipeline_expr_result_is_any_param_borrow_typed(rest, params, src)
    Let(ns, nl, value, body) -> pipeline_expr_result_is_any_param_borrow_typed(body, params, src)
    LetMut(ns, nl, value, body) -> pipeline_expr_result_is_any_param_borrow_typed(body, params, src)
    LetTyped(inner, ann_type) -> pipeline_expr_result_is_any_param_borrow_typed(inner, params, src)
    If(cond, then_expr, else_expr) -> {
      if pipeline_expr_result_is_any_param_borrow_typed(then_expr, params, src) == 1 {
        pipeline_expr_result_is_any_param_borrow_typed(else_expr, params, src)
      } else { 0 }
    }
    Match(scrutinee, arms) -> pipeline_match_arms_result_is_any_param_borrow_typed(arms, params, src)
    Defer(cleanup, body, source_site) -> pipeline_expr_result_is_any_param_borrow_typed(body, params, src)
    Resume(value) -> pipeline_expr_result_is_any_param_borrow_typed(value, params, src)
    Handle(body, clauses, hret) -> {
      match hret {
        NoHandleReturn -> pipeline_expr_result_is_any_param_borrow_typed(body, params, src)
        HandleReturnClause(rns, rnl, rb) -> pipeline_expr_result_is_any_param_borrow_typed(rb, params, src)
      }
    }
    WithHandler(config, body, fact, source_site) -> pipeline_expr_result_is_any_param_borrow_typed(body, params, src)
    _ -> 0
  }
}

pub(package) fn pipeline_match_arms_result_is_any_param_borrow_typed(arms: MatchArmList, params: i64, src: i64) -> i64 {
  match arms {
    MatchArmListNil -> 1
    MatchArmListCons(arm, rest) -> {
      match arm {
        Arm(pattern, body, guard, has_guard) -> {
          if pipeline_expr_result_is_any_param_borrow_typed(body, params, src) == 1 {
            pipeline_match_arms_result_is_any_param_borrow_typed(rest, params, src)
          } else { 0 }
        }
        UnknownArm(tag) -> 0
      }
    }
  }
}

pub(package) fn pipeline_fns_lookup_returns_param_borrow_by_hash(fns: i64, target_hash: i64) -> i64 {
  let pair = pipeline_fns_lookup_pair_by_hash(fns, target_hash)
  if pair == 0 { 0 }
  else {
    let inner = pipeline_fn_inner(node_f1(pair))
    pipeline_expr_result_is_any_param_borrow_typed(expr_from_node(node_f4(inner)), node_f3(inner), node_f2(pair))
  }
}

pub(package) fn pipeline_fns_lookup_returns_param_borrow(fns: i64, src: i64, ns: i64, nl: i64) -> i64 {
  if pipeline_fns_fact_list_valid(fns) == 0 { 0 }
  else {
    let n = nlist_len(fns)
    let mut i = 0
    let mut result = 0
    while i < n {
      let pair = nlist_get(fns, i)
      let fn_src = node_f2(pair)
      let fn_wrap = node_f1(pair)
      if pipeline_decl_node_is_function(fn_wrap) == 1 {
        let inner = pipeline_fn_inner(fn_wrap)
        if node_f2(inner) == nl {
          if src_eq_at(src, ns, fn_src + node_f1(inner), 0, nl) == 1 {
            result = pipeline_expr_result_is_any_param_borrow_typed(expr_from_node(node_f4(inner)), node_f3(inner), fn_src)
            i = n
          } else {
            i = i + 1
          }
        } else {
          i = i + 1
        }
      } else {
        i = i + 1
      }
    }
    if result != 0 { result } else { pipeline_fns_lookup_returns_param_borrow_by_hash(fns, str_hash(src, ns, nl)) }
  }
}

pub(package) fn pipeline_expr_node_final_returns_binding(node: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let stripped = pipeline_expr_node_strip_typed(node)
  if stripped == 0 { 0 }
  else {
    match node_tag(stripped) {
      2 -> pipeline_name_matches(src, ns, nl, node_f1(stripped), node_f2(stripped))
      5 -> {
        if pipeline_expr_node_final_returns_binding(node_f2(stripped), src, ns, nl) == 1 {
          pipeline_expr_node_final_returns_binding(node_f3(stripped), src, ns, nl)
        } else { 0 }
      }
      6 -> {
        if pipeline_name_matches(src, ns, nl, node_f1(stripped), node_f2(stripped)) == 1 { 0 }
        else { pipeline_expr_node_final_returns_binding(node_f4(stripped), src, ns, nl) }
      }
      7 -> pipeline_expr_node_final_returns_binding(node_f2(stripped), src, ns, nl)
      11 -> {
        if pipeline_name_matches(src, ns, nl, node_f1(stripped), node_f2(stripped)) == 1 { 0 }
        else { pipeline_expr_node_final_returns_binding(node_f4(stripped), src, ns, nl) }
      }
      37 -> pipeline_expr_node_final_returns_binding(node_f1(stripped), src, ns, nl)
      52 -> pipeline_expr_node_final_returns_binding(node_f2(stripped), src, ns, nl)
      64 -> pipeline_expr_node_final_returns_binding(node_f2(stripped), src, ns, nl)
      _ -> 0
    }
  }
}

pub(package) fn pipeline_expr_node_final_returns_non_param_ident(node: i64, params: i64, src: i64) -> i64 {
  let stripped = pipeline_expr_node_strip_typed(node)
  if stripped == 0 { 0 }
  else { pipeline_expr_final_returns_non_param_ident_typed(expr_from_node(stripped), params, src) }
}

pub(package) fn pipeline_expr_list_address_of_binding_typed(exprs: ExprList, src: i64, ns: i64, nl: i64) -> bool {
  match exprs {
    ExprListNil -> false
    ExprListCons(expr, rest) -> {
      if pipeline_expr_typed_address_of_binding(expr, src, ns, nl) == 1 { true } else { pipeline_expr_list_address_of_binding_typed(rest, src, ns, nl) }
    }
  }
}

pub(package) fn pipeline_record_fields_address_of_binding_typed(fields: RecordFieldList, src: i64, ns: i64, nl: i64) -> bool {
  match fields {
    RecordFieldListNil -> false
    RecordFieldListCons(field, rest) -> {
      match field {
        RecordField(fns, fnl, value, fact) -> {
          if pipeline_expr_typed_address_of_binding(value, src, ns, nl) == 1 { true } else { pipeline_record_fields_address_of_binding_typed(rest, src, ns, nl) }
        }
        UnknownRecordField(tag) -> pipeline_record_fields_address_of_binding_typed(rest, src, ns, nl)
      }
    }
  }
}

pub(package) fn pipeline_handler_clauses_address_of_binding_typed(clauses: HandlerClauseList, src: i64, ns: i64, nl: i64) -> bool {
  match clauses {
    HandlerClauseListNil -> false
    HandlerClauseListCons(clause, rest) -> {
      match clause {
        HandlerClause(name_info, params, body, continuation) -> {
          if pipeline_param_list_refs_name_typed(params, src, ns, nl) == 1 { pipeline_handler_clauses_address_of_binding_typed(rest, src, ns, nl) }
          else { if pipeline_expr_typed_address_of_binding(body, src, ns, nl) == 1 { true } else { pipeline_handler_clauses_address_of_binding_typed(rest, src, ns, nl) } }
        }
        UnknownHandlerClause(tag) -> pipeline_handler_clauses_address_of_binding_typed(rest, src, ns, nl)
      }
    }
  }
}

pub(package) fn pipeline_match_arms_address_of_binding_typed(arms: MatchArmList, src: i64, ns: i64, nl: i64) -> bool {
  match arms {
    MatchArmListNil -> false
    MatchArmListCons(arm, rest) -> {
      match arm {
        Arm(pattern, body, guard, has_guard) -> {
          let guard_hit = if has_guard == 0 { false } else { pipeline_expr_typed_address_of_binding(guard, src, ns, nl) }
          if guard_hit == 1 { true }
          else { if pipeline_expr_typed_address_of_binding(body, src, ns, nl) == 1 { true } else { pipeline_match_arms_address_of_binding_typed(rest, src, ns, nl) } }
        }
        UnknownArm(tag) -> pipeline_match_arms_address_of_binding_typed(rest, src, ns, nl)
      }
    }
  }
}

pub(package) fn pipeline_expr_typed_address_of_binding(expr: Expr, src: i64, ns: i64, nl: i64) -> bool {
  match expr {
    NilExpr -> false
    BinOp(op, lhs, rhs) -> pipeline_expr_typed_address_of_binding(lhs, src, ns, nl) or pipeline_expr_typed_address_of_binding(rhs, src, ns, nl)
    Call(cns, cnl, args) -> pipeline_expr_list_address_of_binding_typed(args, src, ns, nl)
    GenericCall(type_args, inner_call) -> pipeline_expr_typed_address_of_binding(inner_call, src, ns, nl)
    If(cond, then_expr, else_expr) -> pipeline_expr_typed_address_of_binding(cond, src, ns, nl) or pipeline_expr_typed_address_of_binding(then_expr, src, ns, nl) or pipeline_expr_typed_address_of_binding(else_expr, src, ns, nl)
    While(cond, body) -> pipeline_expr_typed_address_of_binding(cond, src, ns, nl) or pipeline_expr_typed_address_of_binding(body, src, ns, nl)
    Loop(body) -> pipeline_expr_typed_address_of_binding(body, src, ns, nl)
    Break(value) -> pipeline_expr_typed_address_of_binding(value, src, ns, nl)
    Return(value) -> pipeline_expr_typed_address_of_binding(value, src, ns, nl)
    Defer(cleanup, body, source_site) -> pipeline_expr_typed_address_of_binding(cleanup, src, ns, nl) or pipeline_expr_typed_address_of_binding(body, src, ns, nl)
    Let(bns, bnl, value, body) -> {
      if pipeline_expr_typed_address_of_binding(value, src, ns, nl) == 1 { true }
      else { if pipeline_name_matches(src, ns, nl, bns, bnl) == 1 { false } else { pipeline_expr_typed_address_of_binding(body, src, ns, nl) } }
    }
    LetMut(bns, bnl, value, body) -> {
      if pipeline_expr_typed_address_of_binding(value, src, ns, nl) == 1 { true }
      else { if pipeline_name_matches(src, ns, nl, bns, bnl) == 1 { false } else { pipeline_expr_typed_address_of_binding(body, src, ns, nl) } }
    }
    Assign(ans, anl, value) -> pipeline_expr_typed_address_of_binding(value, src, ns, nl)
    AddressOf(mutable, target) -> {
      match target {
        Ident(tns, tnl) -> pipeline_name_matches(src, ns, nl, tns, tnl)
        _ -> pipeline_expr_typed_address_of_binding(target, src, ns, nl)
      }
    }
    Deref(ptr) -> pipeline_expr_typed_address_of_binding(ptr, src, ns, nl)
    PtrAssign(ptr, value) -> pipeline_expr_typed_address_of_binding(ptr, src, ns, nl) or pipeline_expr_typed_address_of_binding(value, src, ns, nl)
    Block(first, rest) -> pipeline_expr_typed_address_of_binding(first, src, ns, nl) or pipeline_expr_typed_address_of_binding(rest, src, ns, nl)
    FieldAccess(base, field_ns, field_nl, fact) -> pipeline_expr_typed_address_of_binding(base, src, ns, nl)
    IndexedLen(base, fixed_len) -> pipeline_expr_typed_address_of_binding(base, src, ns, nl)
    IndexedGet(base, index, element_ty, fixed_len) -> pipeline_expr_typed_address_of_binding(base, src, ns, nl) or pipeline_expr_typed_address_of_binding(index, src, ns, nl)
    IndexedSet(base, index, value, fact) -> pipeline_expr_typed_address_of_binding(base, src, ns, nl) or pipeline_expr_typed_address_of_binding(index, src, ns, nl) or pipeline_expr_typed_address_of_binding(value, src, ns, nl)
    IndexedSlice(base, start, end, fact) -> pipeline_expr_typed_address_of_binding(base, src, ns, nl) or pipeline_expr_typed_address_of_binding(start, src, ns, nl) or pipeline_expr_typed_address_of_binding(end, src, ns, nl)
    RecordInit(type_ns, type_nl, fields) -> pipeline_record_fields_address_of_binding_typed(fields, src, ns, nl)
    RecordUpdate(base, fields, fact) -> pipeline_expr_typed_address_of_binding(base, src, ns, nl) or pipeline_record_fields_address_of_binding_typed(fields, src, ns, nl)
    ArrayLiteral(elements, resolved_ty, span) -> pipeline_expr_list_address_of_binding_typed(elements, src, ns, nl)
    Match(scrutinee, arms) -> pipeline_expr_typed_address_of_binding(scrutinee, src, ns, nl) or pipeline_match_arms_address_of_binding_typed(arms, src, ns, nl)
    Not(operand) -> pipeline_expr_typed_address_of_binding(operand, src, ns, nl)
    Lambda(params, body, source_site) -> {
      if pipeline_param_list_refs_name_typed(params, src, ns, nl) == 1 { false } else { pipeline_expr_typed_address_of_binding(body, src, ns, nl) }
    }
    Perform(lhs, op_ns, op_nl, args) -> pipeline_expr_typed_address_of_binding(lhs, src, ns, nl) or pipeline_expr_list_address_of_binding_typed(args, src, ns, nl)
    Handle(body, clauses, hret) -> pipeline_expr_typed_address_of_binding(body, src, ns, nl) or pipeline_handler_clauses_address_of_binding_typed(clauses, src, ns, nl) or (match hret { NoHandleReturn -> false HandleReturnClause(rns, rnl, rb) -> pipeline_expr_typed_address_of_binding(rb, src, ns, nl) })
    WithHandler(config, body, fact, source_site) -> pipeline_expr_list_address_of_binding_typed(handler_configuration_args(config), src, ns, nl) or pipeline_expr_typed_address_of_binding(body, src, ns, nl)
    Resume(value) -> pipeline_expr_typed_address_of_binding(value, src, ns, nl)
    MethodCall(recv, method_hash, args, type_hash) -> pipeline_expr_typed_address_of_binding(recv, src, ns, nl) or pipeline_expr_list_address_of_binding_typed(args, src, ns, nl)
    Try(inner, effect_atom) -> pipeline_expr_typed_address_of_binding(inner, src, ns, nl)
    InterpConcat(left, right) -> pipeline_expr_typed_address_of_binding(left, src, ns, nl) or pipeline_expr_typed_address_of_binding(right, src, ns, nl)
    ForIter(var_ns, var_nl, collection, body) -> {
      if pipeline_expr_typed_address_of_binding(collection, src, ns, nl) == 1 { true }
      else { if pipeline_name_matches(src, ns, nl, var_ns, var_nl) == 1 { false } else { pipeline_expr_typed_address_of_binding(body, src, ns, nl) } }
    }
    OptChain(base, field_ns, field_nl, effect_atom) -> pipeline_expr_typed_address_of_binding(base, src, ns, nl)
    LetTyped(inner, ann_type) -> pipeline_expr_typed_address_of_binding(inner, src, ns, nl)
    _ -> false
  }
}

pub(package) fn pipeline_ir_addressable_slot_id(next_value: i64) -> i64 {
  if next_value < 8 { 8 } else { next_value }
}

pub(package) fn pipeline_lower_let_expr_typed_sidecar_handler_opt_with_float_prim(ns: i64, nl: i64, value_expr: Expr, body_expr: Expr, next_value: i64, lower_ctx: PipelineHandlerLowerCtx, local_float: i64, local_type_node: i64) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let ctx = pipeline_handler_lower_ctx_handlers(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  let value = if pipeline_prim_is_forced_numeric_context(local_float) == 1 {
    pipeline_lower_expr_typed_sidecar_handler_opt_with_float_prim(value_expr, next_value, lower_ctx, local_float)
  } else {
    pipeline_lower_expr_typed_sidecar_handler_ctx(value_expr, next_value, lower_ctx)
  }
  if ir_lowered_expr_is_valid(value) == 1 {
    let inferred_float_prim = pipeline_expr_float_prim_typed_temp(value_expr, params, locals, src, tt, pipeline_handler_lower_ctx_fns(lower_ctx), subst)
    let float_prim = if local_float == PRIM_F32() or local_float == PRIM_F64() { local_float } else { inferred_float_prim }
    let inferred_type_hash = pipeline_expr_type_hash_typed_temp(value_expr, params, locals, src, tt, pipeline_handler_lower_ctx_fns(lower_ctx), subst)
    let inferred_type_node = pipeline_init_type_node_typed(value_expr, params, locals, pipeline_handler_lower_ctx_module(lower_ctx))
    let effective_type_node = if local_type_node != 0 { ty_subst(local_type_node, subst) } else { inferred_type_node }
    let local_lanes = pipeline_type_value_lane_count_or_one(effective_type_node)
    let annotated_type_hash = if local_type_node != 0 and effective_type_node != 0 { type_hash_of(effective_type_node) } else { 0 }
    let inferred_node_type_hash = if effective_type_node != 0 { type_hash_of(effective_type_node) } else { 0 }
    let local_type_hash = if annotated_type_hash != 0 { annotated_type_hash } else { if inferred_node_type_hash != 0 { inferred_node_type_hash } else { if local_float != 0 and pipeline_prim_is_numeric_context(local_float) == 1 { pipeline_type_hash_of_prim_id(local_float) } else { pipeline_expr_type_hash_sharpen_int_typed(value_expr, inferred_type_hash, params, locals, src, pipeline_handler_lower_ctx_fns(lower_ctx), subst) } } }
    let address_taken = pipeline_expr_address_of_binding(body_expr, src, ns, nl)
    let slot = pipeline_ir_addressable_slot_id(ir_lowered_expr_next_value(value))
    let bind_value_for_retain = if address_taken == 1 { slot } else { ir_lowered_expr_value(value) }
    let retain_insts = if address_taken == 1 or pipeline_expr_result_is_borrowed_for_ty_typed(value_expr, effective_type_node, src, pipeline_handler_lower_ctx_fns(lower_ctx), subst, pipeline_handler_lower_ctx_tt(lower_ctx)) == 0 {
      ir_inst_list_empty()
    } else {
      pipeline_managed_retain_inst_list_with_origin(bind_value_for_retain, effective_type_node, ir_lowered_expr_next_value(value), ir_managed_stake_origin_binding())
    }
    let body_next = if address_taken == 1 {
      slot + local_lanes
    } else {
      ir_lowered_expr_next_value(value) + ir_inst_list_len(retain_insts)
    }
    let next_locals = if address_taken == 1 {
      pipeline_value_env_push_slot_float_typed_node(locals, ns, nl, slot, float_prim, local_type_hash, effective_type_node)
    } else {
      pipeline_value_env_push_float_typed_node(locals, ns, nl, ir_lowered_expr_value(value), float_prim, local_type_hash, effective_type_node)
    }
    let body_ctx = pipeline_handler_lower_ctx_from_module(params, next_locals, pipeline_handler_lower_ctx_module(lower_ctx))
    let body = pipeline_lower_expr_typed_sidecar_handler_ctx(body_expr, body_next, body_ctx)
    if ir_lowered_expr_is_valid(body) == 1 {
      let bind_value = if address_taken == 1 { slot } else { ir_lowered_expr_value(value) }
      let bind = ir_inst_list_prepend(ir_inst_bind_typed_i64(ns, nl, bind_value, effective_type_node), ir_inst_list_empty())
      let slot_insts = if address_taken == 1 {
        pipeline_ir_slot_lane_init_insts(slot, ir_lowered_expr_value(value), 0, local_lanes)
      } else { ir_inst_list_empty() }
      let release_dst = ir_lowered_expr_next_value(body)
      let body_returns_binding = pipeline_expr_final_returns_binding_typed(body_expr, src, ns, nl)
      let linear_plan = if effective_type_node != 0 { pipeline_linear_cleanup_plan(tt, effective_type_node) } else { 0 }
      let release_insts = if address_taken == 1 or body_returns_binding == 1 or linear_plan != 0 { ir_inst_list_empty() } else { pipeline_managed_release_inst_list_with_origin(bind_value, effective_type_node, release_dst, ir_managed_stake_origin_binding()) }
      -- Owned bindings drop at scope exit. A body that references the binding
      -- may move ownership (return or owned-param call), so only the
      -- never-referenced case drops here, matching the defer-owned rule.
      let owned_drop_insts = if linear_plan != 0 and address_taken == 0 and pipeline_expr_refs_name_typed(body_expr, src, ns, nl) == 0 {
        pipeline_linear_cleanup_inst_list(bind_value, linear_plan)
      } else { ir_inst_list_empty() }
      let next_after_release = release_dst + ir_inst_list_len(release_insts)
      ir_lowered_expr(
        ir_lowered_expr_value(body),
        next_after_release,
        ir_inst_list_append(ir_lowered_expr_insts(value), ir_inst_list_append(slot_insts, ir_inst_list_append(retain_insts, ir_inst_list_append(bind, ir_inst_list_append(ir_lowered_expr_insts(body), ir_inst_list_append(owned_drop_insts, release_insts))))))
      )
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

pub(package) fn pipeline_lower_let_expr_typed_sidecar_handler_opt(ns: i64, nl: i64, value_expr: Expr, body_expr: Expr, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  pipeline_lower_let_expr_typed_sidecar_handler_opt_with_float_prim(ns, nl, value_expr, body_expr, next_value, lower_ctx, 0, 0)
}

pub(package) fn pipeline_lower_perform_expr_typed_sidecar_handler_opt(lhs_expr: Expr, op_ns: i64, op_nl: i64, args_exprs: ExprList, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let dispatch_key = pipeline_effect_ref_dispatch_key_typed(pipeline_handler_lower_ctx_src(lower_ctx), lhs_expr, pipeline_handler_lower_ctx_subst(lower_ctx))
  pipeline_lower_perform_expr_typed_sidecar_handler_opt_keyed(lhs_expr, lhs_expr, op_ns, op_nl, args_exprs, next_value, lower_ctx, dispatch_key)
}

pub(package) fn pipeline_lower_resolved_effect_perform_expr_typed_sidecar(signature_ref: Expr, op_ns: i64, op_nl: i64, args_exprs: ExprList, next_value: i64, lower_ctx: PipelineHandlerLowerCtx, dispatch_key: i64) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  let expected_params = pipeline_effect_op_params_nodes_typed(tt, src, signature_ref, op_ns, op_nl, subst)
  let return_ty = pipeline_effect_op_return_type_typed(tt, src, signature_ref, op_ns, op_nl, subst)
  let result_lanes = pipeline_type_value_lane_count_or_one(return_ty)
  let args = pipeline_lower_typed_handler_opt_args_expected(args_exprs, 0, next_value, lower_ctx, expected_params, 0, 0)
  if pipeline_lowered_args_is_valid(args) == 0 {
    ir_lowered_expr_invalid(next_value)
  } else {
    let dst = pipeline_lowered_args_next_value(args)
    let logical_args = pipeline_lowered_args_values(args)
    let abi_args = pipeline_call_abi_args(logical_args, expected_params, 0, 0, 0, 0)
    let op_hash = effect_name_hash(src, op_ns, op_nl)
    let found = pipeline_handler_inline_ctx_find_match(pipeline_handler_lower_ctx_handlers(lower_ctx), src, dispatch_key, op_hash)
    let tail_inline = pipeline_handler_inline_try_tail_resume(pipeline_handler_lower_ctx_handlers(lower_ctx), found, logical_args, tt, pipeline_handler_lower_ctx_fns(lower_ctx), dst)
    if ir_lowered_expr_is_valid(tail_inline) == 1 {
      ir_lowered_expr(
        ir_lowered_expr_value(tail_inline),
        ir_lowered_expr_next_value(tail_inline),
        ir_inst_list_append(pipeline_lowered_args_insts(args), ir_lowered_expr_insts(tail_inline))
      )
    } else {
      let op_inst = if pipeline_handler_inline_match_found(found) == 1 {
        ir_inst_handler_direct_i64(
          dst,
          dispatch_key,
          op_hash,
          pipeline_handler_inline_match_depth_or(found, 0 - 1),
          pipeline_handler_inline_match_clause_index_or(found, 0 - 1),
          abi_args
        )
      } else {
        ir_inst_perform_i64(dst, dispatch_key, op_hash, abi_args)
      }
      let transfers = pipeline_effect_linear_transfer_insts_typed(
        args_exprs, expected_params, 0, 0, abi_args,
        params, locals, pipeline_handler_lower_ctx_module(lower_ctx)
      )
      let managed_transfers = pipeline_effect_managed_transfer_insts(
        expected_params, 0, 0, abi_args, dst
      )
      let perform = ir_inst_list_append(
        transfers,
        ir_inst_list_append(managed_transfers, ir_inst_list_append(ir_inst_list_prepend(op_inst, ir_inst_list_empty()), pipeline_ir_call_result_lane_insts(dst, return_ty)))
      )
      ir_lowered_expr(dst, dst + result_lanes, ir_inst_list_append(pipeline_lowered_args_insts(args), perform))
    }
  }
}

pub(package) fn pipeline_lower_perform_expr_typed_sidecar_handler_opt_keyed(lhs_expr: Expr, signature_ref: Expr, op_ns: i64, op_nl: i64, args_exprs: ExprList, next_value: i64, lower_ctx: PipelineHandlerLowerCtx, dispatch_key: i64) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let ctx = pipeline_handler_lower_ctx_handlers(lower_ctx)
  match lhs_expr {
    FieldAccess(base, field_ns, field_nl, fact) -> {
      match fact {
        ResolvedEffectAccessFact(decl, type_args) -> pipeline_lower_resolved_effect_perform_expr_typed_sidecar(signature_ref, op_ns, op_nl, args_exprs, next_value, lower_ctx, dispatch_key)
        ResolvedDeclarationAccessFact(decl) -> {
          if decl != 0 and module_decl_fact_namespace(decl) == module_decl_namespace_effect() {
            pipeline_lower_resolved_effect_perform_expr_typed_sidecar(signature_ref, op_ns, op_nl, args_exprs, next_value, lower_ctx, dispatch_key)
          } else {
            if decl == 0 { ir_lowered_expr_invalid(next_value) }
            else { pipeline_lower_decl_call_typed(decl, args_exprs, next_value, lower_ctx) }
          }
        }
        _ -> {
          let declaration = field_access_fact_declaration(fact)
          if declaration == 0 { ir_lowered_expr_invalid(next_value) }
          else { pipeline_lower_decl_call_typed(declaration, args_exprs, next_value, lower_ctx) }
        }
      }
    }
    Ident(eff_ns, eff_nl) -> {
      let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
      let local_recv_ty = pipeline_value_env_lookup_type_node(locals, src, eff_ns, eff_nl)
      let recv_ty = if local_recv_ty != 0 {
        ty_subst(local_recv_ty, subst)
      } else {
        pipeline_param_type_node_by_name(params, src, eff_ns, eff_nl, subst)
      }
      let method_hash = effect_name_hash(src, op_ns, op_nl)
      let method_ref = pipeline_resolve_method_ref(tt, recv_ty, method_hash)
      if method_ref != 0 {
        pipeline_lower_method_call_expr_typed_sidecar_handler_opt(lhs_expr, method_hash, args_exprs, method_ref, next_value, lower_ctx)
      } else { if pipeline_ident_is_declared_effect(tt, src, eff_ns, eff_nl) == 0 {
        ir_lowered_expr_invalid(next_value)
      } else {
        let expected_params = pipeline_effect_op_params_nodes_typed(tt, src, signature_ref, op_ns, op_nl, subst)
        let return_ty = pipeline_effect_op_return_type_typed(tt, src, signature_ref, op_ns, op_nl, subst)
        let result_lanes = pipeline_type_value_lane_count_or_one(return_ty)
        let args = pipeline_lower_typed_handler_opt_args_expected(args_exprs, 0, next_value, lower_ctx, expected_params, 0, 0)
        if pipeline_lowered_args_is_valid(args) == 1 {
          let dst = pipeline_lowered_args_next_value(args)
          let logical_args = pipeline_lowered_args_values(args)
          let abi_args = pipeline_call_abi_args(logical_args, expected_params, 0, 0, 0, 0)
          let eff_hash = if dispatch_key != 0 { dispatch_key } else { effect_name_hash(src, eff_ns, eff_nl) }
          let op_hash = effect_name_hash(src, op_ns, op_nl)
          let found = pipeline_handler_inline_ctx_find_match(ctx, src, eff_hash, op_hash)
            let tail_inline = pipeline_handler_inline_try_tail_resume(ctx, found, logical_args, tt, pipeline_handler_lower_ctx_fns(lower_ctx), dst)
            if ir_lowered_expr_is_valid(tail_inline) == 1 {
              ir_lowered_expr(
                ir_lowered_expr_value(tail_inline),
                ir_lowered_expr_next_value(tail_inline),
                ir_inst_list_append(pipeline_lowered_args_insts(args), ir_lowered_expr_insts(tail_inline))
              )
            } else {
            let op_inst = if pipeline_handler_inline_match_found(found) == 1 {
              ir_inst_handler_direct_i64(
                dst,
                eff_hash,
                op_hash,
                pipeline_handler_inline_match_depth_or(found, 0 - 1),
                pipeline_handler_inline_match_clause_index_or(found, 0 - 1),
                abi_args
              )
            } else {
              ir_inst_perform_i64(dst, eff_hash, op_hash, abi_args)
            }
            let transfers = pipeline_effect_linear_transfer_insts_typed(
              args_exprs, expected_params, 0, 0, abi_args,
              params, locals, pipeline_handler_lower_ctx_module(lower_ctx)
            )
            let perform = ir_inst_list_append(
              transfers,
              ir_inst_list_append(
                ir_inst_list_prepend(op_inst, ir_inst_list_empty()),
                pipeline_ir_call_result_lane_insts(dst, return_ty)
              )
            )
            let insts = ir_inst_list_append(pipeline_lowered_args_insts(args), perform)
            ir_lowered_expr(dst, dst + result_lanes, insts)
            }
        } else {
          ir_lowered_expr_invalid(next_value)
        }
      } }
    }
    GenericCall(type_args, inner) -> {
      match inner {
        Ident(eff_ns, eff_nl) -> pipeline_lower_perform_expr_typed_sidecar_handler_opt_keyed(Ident(eff_ns, eff_nl), signature_ref, op_ns, op_nl, args_exprs, next_value, lower_ctx, dispatch_key)
        _ -> ir_lowered_expr_invalid(next_value)
      }
    }
    _ -> ir_lowered_expr_invalid(next_value)
  }
}

pub(package) fn pipeline_expr_ident_matches_param(expr: Expr, param: Param, src: i64) -> bool {
  match pipeline_expr_strip_typed(expr) {
    Ident(ns, nl) -> {
      match param {
        Param(p_ns, p_nl, ty, label) -> pipeline_name_matches(src, ns, nl, p_ns, p_nl)
        UnknownParam(tag) -> false
      }
    }
    _ -> false
  }
}

pub(package) fn pipeline_vector_fold_i64_sum_body(src: i64, body: Expr, first: Param, second: Param) -> i64 {
  match pipeline_expr_strip_typed(body) {
    BinOp(op, lhs, rhs) -> {
      if op == 1 {
        let forward = pipeline_expr_ident_matches_param(lhs, first, src) and pipeline_expr_ident_matches_param(rhs, second, src)
        let reverse = pipeline_expr_ident_matches_param(lhs, second, src) and pipeline_expr_ident_matches_param(rhs, first, src)
        forward or reverse
      } else {
        0
      }
    }
    _ -> 0
  }
}

pub(package) fn pipeline_vector_fold_i64_sum_lambda(src: i64, callback: Expr) -> i64 {
  match pipeline_expr_strip_typed(callback) {
    Lambda(params, body, source_site) -> {
      match params {
        ParamListCons(first, rest) -> {
          match rest {
            ParamListCons(second, tail) -> {
              match tail {
                ParamListNil -> pipeline_vector_fold_i64_sum_body(src, body, first, second)
                _ -> 0
              }
            }
            _ -> 0
          }
        }
        _ -> 0
      }
    }
    _ -> 0
  }
}

pub(package) fn pipeline_vector_fold_i64_sum_type_args(type_args: TypeExprList) -> i64 {
  if type_expr_list_len(type_args) == 2 and type_expr_list_nth_prim_id_or(type_args, 0, 0 - 1) == PRIM_I64() and type_expr_list_nth_prim_id_or(type_args, 1, 0 - 1) == PRIM_I64() { 1 } else { 0 }
}

pub(package) fn pipeline_lower_vector_fold_sum_i64_typed(src: i64, ns: i64, nl: i64, args_exprs: ExprList, type_args: TypeExprList, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  if src_eq(src, ns, nl, "vector_fold") == 1 and expr_list_len(args_exprs) == 3 and pipeline_vector_fold_i64_sum_type_args(type_args) == 1 and pipeline_fns_contains_hash(pipeline_handler_lower_ctx_fns(lower_ctx), pipeline_ir_native_vector_sum_i64_hash()) == 1 {
    let callback = pipeline_expr_list_nth_or(args_exprs, 2, NilExpr)
    if pipeline_vector_fold_i64_sum_lambda(src, callback) == 1 {
      let vec_expr = pipeline_expr_list_nth_or(args_exprs, 0, NilExpr)
      let init_expr = pipeline_expr_list_nth_or(args_exprs, 1, NilExpr)
      let vec = pipeline_lower_expr_typed_sidecar_handler_ctx(vec_expr, next_value, lower_ctx)
      if ir_lowered_expr_is_valid(vec) == 1 {
        let init = pipeline_lower_expr_typed_sidecar_handler_ctx(init_expr, ir_lowered_expr_next_value(vec), lower_ctx)
        if ir_lowered_expr_is_valid(init) == 1 {
          let dst = ir_lowered_expr_next_value(init)
          let call_args = ir_value_list_prepend(ir_lowered_expr_value(vec), ir_value_list_prepend(ir_lowered_expr_value(init), ir_value_list_empty()))
          let call = ir_inst_list_prepend(ir_inst_call_i64(dst, pipeline_ir_native_vector_sum_i64_hash(), call_args), ir_inst_list_empty())
          ir_lowered_expr(dst, dst + 1, ir_inst_list_append(ir_lowered_expr_insts(vec), ir_inst_list_append(ir_lowered_expr_insts(init), call)))
        } else {
          ir_lowered_expr_invalid(next_value)
        }
      } else {
        ir_lowered_expr_invalid(next_value)
      }
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

pub(package) fn pipeline_lower_par_fork_generic_expr_typed(type_args: TypeExprList, inner_call: Expr, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let module = pipeline_handler_lower_ctx_module(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let par_ctx = pipeline_lower_module_par_ctx(module)
  let work_scope_slot = pipeline_par_lower_ctx_work_scope_slot(par_ctx)
  let args_exprs = pipeline_par_call_args_typed(inner_call)
  if pipeline_par_lower_ctx_is_active(par_ctx) == 0 or work_scope_slot < 0 or
    pipeline_par_call_role_is_fork(pipeline_par_call_role_typed(inner_call, src)) == 0 or type_expr_list_len(type_args) != 1 or expr_list_len(args_exprs) != 1 {
    ir_lowered_expr_invalid(next_value)
  } else {
    let fns = pipeline_handler_lower_ctx_fns(lower_ctx)
    let template_pair = pipeline_par_call_pair_typed(inner_call, src, pipeline_handler_lower_ctx_tt(lower_ctx), fns)
    let expected_params = if template_pair == 0 { 0 } else {
      cg_params_shape_specialise(node_f3(pipeline_fn_inner(node_f1(template_pair))), fn_tparams(node_f1(template_pair)), type_expr_list_to_nodes(type_args))
    }
    let expected_subst = if template_pair == 0 { 0 } else { cg_build_subst(fn_tparams(node_f1(template_pair)), type_expr_list_to_nodes(type_args)) }
    let borrowed_mask = if template_pair == 0 { 0 }
      else { pipeline_fn_effective_borrowable_param_mask_from_pair(fns, template_pair, expected_params, expected_subst) }
    let args = pipeline_lower_typed_handler_opt_args_expected_borrow_mask(args_exprs, 0, next_value, lower_ctx, expected_params, 0, expected_subst, borrowed_mask)
    if pipeline_lowered_args_is_valid(args) == 0 {
      ir_lowered_expr_invalid(next_value)
    } else {
      let logical_args = pipeline_lowered_args_values(args)
      let closure_value = pipeline_ir_value_list_get_or(logical_args, 0, 0 - 1)
      let pack_value = pipeline_lowered_args_next_value(args)
      let pthread_policy = match par_ctx {
        PipelineParLowerPthread(pool_slot, work_slot) -> 1
        _ -> 0
      }
      let pool_value = pack_value + 1
      let submit_value = if pthread_policy == 1 { pool_value + 1 } else { pack_value + 1 }
      let scope_value = submit_value + 1
      let task_value = scope_value + 1
      let pack = ir_inst_list_prepend(IrGenericCallI64(pack_value, pipeline_ir_native_par_work_pack_hash(), type_args, ir_value_list_prepend(closure_value, ir_value_list_empty())), ir_inst_list_empty())
      let submit = match par_ctx {
        PipelineParLowerPthread(pool_slot, work_slot) -> ir_inst_list_prepend(
          ir_inst_load_i64(pool_value, pool_slot),
          ir_inst_list_prepend(
            ir_inst_call_i64(submit_value, pipeline_par_work_pthread_submit_hash(), ir_value_list_prepend(pool_value, ir_value_list_prepend(pack_value, ir_value_list_empty()))),
            ir_inst_list_empty()
          )
        )
        _ -> ir_inst_list_prepend(ir_inst_call_i64(submit_value, pipeline_par_work_sequential_submit_hash(), ir_value_list_prepend(pack_value, ir_value_list_empty())), ir_inst_list_empty())
      }
      let scope_load = ir_inst_list_prepend(ir_inst_load_i64(scope_value, work_scope_slot), ir_inst_list_empty())
      let track = ir_inst_list_prepend(ir_inst_call_i64(task_value, pipeline_runtime_par_work_scope_track_hash(), ir_value_list_prepend(scope_value, ir_value_list_prepend(submit_value, ir_value_list_empty()))), ir_inst_list_empty())
      -- runtime_par_work_pack clones the closure environment; the intercepted
      -- par.fork<T> call therefore owns the same temporary-release obligation
      -- as the CFG lowering above.
      let cleanup = pipeline_managed_owned_temp_release_args_typed(args_exprs, logical_args, 0, task_value + 1, expected_params, 0, expected_subst, 0)
      let insts = ir_inst_list_append(pipeline_lowered_args_insts(args), ir_inst_list_append(pack, ir_inst_list_append(submit, ir_inst_list_append(scope_load, ir_inst_list_append(track, pipeline_lowered_args_insts(cleanup))))))
      ir_lowered_expr(task_value, pipeline_lowered_args_next_value(cleanup), insts)
    }
  }
}

pub(package) fn pipeline_lower_decl_generic_call_typed(decl: i64, type_args: TypeExprList, args_exprs: ExprList, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let pair = module_decl_fact_function_pair(decl)
  if module_decl_fact_namespace(decl) == module_decl_namespace_constructor() {
    pipeline_lower_constructor_decl_call_node(decl, type_expr_list_to_nodes(type_args), expr_list_to_nodes(args_exprs), expr_list_len(args_exprs), next_value, lower_ctx)
  } else { if pair == 0 { ir_lowered_expr_invalid(next_value) }
  else {
    let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
    let concrete_type_args = pipeline_type_expr_list_subst(type_args, subst)
    let call_type_args = pipeline_shape_call_type_args_typed(pair, concrete_type_args, args_exprs, pipeline_handler_lower_ctx_params(lower_ctx), pipeline_handler_lower_ctx_locals(lower_ctx), pipeline_handler_lower_ctx_module(lower_ctx))
    let expected_subst = cg_build_subst_with_associated(fn_tparams(node_f1(pair)), type_expr_list_to_nodes(call_type_args), pipeline_handler_lower_ctx_tt(lower_ctx))
    let expected_params = cg_params_shape_specialise_with_subst(node_f3(pipeline_fn_inner(node_f1(pair))), fn_tparams(node_f1(pair)), type_expr_list_to_nodes(call_type_args), expected_subst)
    let borrowed_mask = pipeline_fn_effective_borrowable_param_mask_from_pair(pipeline_handler_lower_ctx_fns(lower_ctx), pair, expected_params, expected_subst)
    let lowered_args = pipeline_lower_typed_handler_opt_args_expected_borrow_mask(args_exprs, 0, next_value, lower_ctx, expected_params, 0, expected_subst, borrowed_mask)
    if pipeline_lowered_args_is_valid(lowered_args) == 0 { ir_lowered_expr_invalid(next_value) }
    else {
      let dst = pipeline_lowered_args_next_value(lowered_args)
      let logical_args = pipeline_lowered_args_values(lowered_args)
      let abi_args = pipeline_call_abi_args(logical_args, expected_params, 0, expected_subst, 0, 0)
      let call_inst = IrGenericCallI64(dst, pipeline_fn_pair_key(pair), call_type_args, abi_args)
      let call_head = ir_inst_list_prepend(call_inst, ir_inst_list_empty())
      let result_ty = pipeline_function_return_type_with_subst(node_f1(pair), expected_subst, pipeline_handler_lower_ctx_tt(lower_ctx))
      let call = ir_inst_list_append(call_head, pipeline_ir_call_result_lane_insts(dst, result_ty))
      let result_lanes = pipeline_type_value_lane_count_or_one(result_ty)
      let linear_transfers = pipeline_effect_linear_transfer_insts_typed(
        args_exprs,
        expected_params,
        0,
        0,
        abi_args,
        pipeline_handler_lower_ctx_params(lower_ctx),
        pipeline_handler_lower_ctx_locals(lower_ctx),
        pipeline_handler_lower_ctx_module(lower_ctx)
      )
      let managed_transfers = pipeline_direct_managed_transfer_insts(
        expected_params, expected_subst, borrowed_mask, call_inst,
        pipeline_handler_lower_ctx_tt(lower_ctx)
      )
      let cleanup = pipeline_managed_lambda_temp_release_args_masked_typed(args_exprs, logical_args, 0, dst + result_lanes, borrowed_mask, 0, expected_params, 0, expected_subst, pipeline_handler_lower_ctx_src(lower_ctx), pipeline_handler_lower_ctx_tt(lower_ctx))
      ir_lowered_expr(dst, pipeline_lowered_args_next_value(cleanup), ir_inst_list_append(pipeline_lowered_args_insts(lowered_args), ir_inst_list_append(linear_transfers, ir_inst_list_append(managed_transfers, ir_inst_list_append(call, pipeline_lowered_args_insts(cleanup))))))
    }
  } }
}

pub(package) fn pipeline_lower_generic_call_expr_typed_sidecar_handler_opt(type_args: TypeExprList, inner_call: Expr, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let fns = pipeline_handler_lower_ctx_fns(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  let concrete_type_args = pipeline_type_expr_list_subst(type_args, subst)
  match inner_call {
    Call(ns, nl, args_exprs) -> {
      let declaration = pipeline_local_opaque_type_declaration(tt, src, ns, nl)
      if declaration != 0 {
        return pipeline_lower_opaque_wrap_expr_typed(declaration, type_expr_list_to_nodes(concrete_type_args), args_exprs, next_value, lower_ctx)
      } else { 0 }
    }
    _ -> 0
  }
  let par_task = pipeline_lower_par_fork_generic_expr_typed(concrete_type_args, inner_call, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(par_task) == 1 { par_task }
  else { match inner_call {
    Perform(FieldAccess(base, field_ns, field_nl, fact), op_ns, op_nl, args_exprs) -> {
      let declaration = field_access_fact_declaration(fact)
      if declaration == 0 { ir_lowered_expr_invalid(next_value) }
      else { pipeline_lower_decl_generic_call_typed(declaration, type_args, args_exprs, next_value, lower_ctx) }
    }
    Ident(ns, nl) -> {
      let template_pair = pipeline_generic_template_find_resolved(fns, tt, src, ns, nl)
      let base_hash = if template_pair == 0 { str_hash(src, ns, nl) } else { pipeline_fn_pair_key(template_pair) }
      if template_pair == 0 {
        ir_lowered_expr_invalid(next_value)
      } else {
        ir_lowered_expr(
          next_value,
          next_value + 1,
          ir_inst_list_prepend(ir_inst_generic_function_ref_i64(next_value, base_hash, concrete_type_args), ir_inst_list_empty())
        )
      }
    }
    Call(ns, nl, args_exprs) -> {
      if pipeline_variant_payload_count(tt, src, ns, nl) >= 0 or pipeline_call_callee_is_direct(params, locals, src, ns, nl) == 1 {
        let fold_sum = pipeline_lower_vector_fold_sum_i64_typed(src, ns, nl, args_exprs, concrete_type_args, next_value, lower_ctx)
        if ir_lowered_expr_is_valid(fold_sum) == 1 {
          fold_sum
        } else {
          let variant_payloads = pipeline_variant_payload_types(tt, src, ns, nl)
          let variant_tparams = if variant_payloads == 0 { 0 } else { ttable_variant_tparams(tt, src, ns, nl) }
          let template_pair = if variant_payloads == 0 { pipeline_generic_template_find_resolved(fns, tt, src, ns, nl) } else { 0 }
          let call_type_args = pipeline_shape_call_type_args_typed(template_pair, concrete_type_args, args_exprs, params, locals, pipeline_handler_lower_ctx_module(lower_ctx))
          let expected_params = if template_pair == 0 { 0 } else {
            cg_params_shape_specialise(
              node_f3(pipeline_fn_inner(node_f1(template_pair))),
              fn_tparams(node_f1(template_pair)),
              type_expr_list_to_nodes(call_type_args)
            )
          }
          let expected_subst = if variant_payloads != 0 {
            if variant_tparams == 0 { subst } else { cg_build_subst(variant_tparams, type_expr_list_to_nodes(call_type_args)) }
          } else {
            if template_pair == 0 { 0 } else { cg_build_subst(fn_tparams(node_f1(template_pair)), type_expr_list_to_nodes(call_type_args)) }
          }
          let stable_handle_word = pipeline_collection_handle_word_stable_call(src, ns, nl, args_exprs)
          let borrowed_mask = if stable_handle_word == 1 { 1 }
          else { if variant_payloads == 0 and template_pair != 0 {
            pipeline_fn_effective_borrowable_param_mask_from_pair(fns, template_pair, expected_params, expected_subst)
          } else { 0 } }
          let args = pipeline_lower_typed_handler_opt_args_expected_borrow_mask_origin(args_exprs, 0, next_value, lower_ctx, expected_params, variant_payloads, expected_subst, borrowed_mask, if variant_payloads != 0 { ir_managed_stake_origin_aggregate() } else { ir_managed_stake_origin_call_transport() })
          if pipeline_lowered_args_is_valid(args) == 1 {
            let dst = pipeline_lowered_args_next_value(args)
            let logical_args = pipeline_lowered_args_values(args)
            let storage_ty = if type_expr_list_len(call_type_args) == 1 { type_expr_to_node(type_expr_list_nth(call_type_args, 0)) } else { 0 }
            let structural_storage = pipeline_lower_structural_vector_storage_call(str_hash(src, ns, nl), storage_ty, logical_args, dst, tt)
            let abi_args = if variant_payloads != 0 {
              pipeline_call_abi_args(logical_args, 0, variant_payloads, expected_subst, 0, 0)
            } else { if template_pair != 0 and stable_handle_word == 0 {
              pipeline_call_abi_args(logical_args, expected_params, 0, expected_subst, 0, 0)
            } else { logical_args } }
            let call_head = ir_inst_list_prepend(
              if stable_handle_word == 1 {
                pipeline_collection_handle_word_inst(dst, logical_args)
              } else {
                pipeline_generic_call_inst_typed(dst, src, tt, fns, ns, nl, call_type_args, abi_args)
              },
              ir_inst_list_empty()
            )
            let result_ty = if template_pair == 0 { 0 } else {
              pipeline_function_return_type_with_subst(node_f1(template_pair), expected_subst, tt)
            }
            let call = if ir_lowered_expr_is_valid(structural_storage) == 1 {
              ir_lowered_expr_insts(structural_storage)
            } else { if template_pair != 0 and stable_handle_word == 0 {
              ir_inst_list_append(call_head, pipeline_ir_call_result_lane_insts(dst, result_ty))
            } else { call_head } }
            let result_value = if ir_lowered_expr_is_valid(structural_storage) == 1 { ir_lowered_expr_value(structural_storage) } else { dst }
            let result_lanes = if template_pair != 0 and stable_handle_word == 0 { pipeline_type_value_lane_count_or_one(result_ty) } else { 1 }
            let cleanup_start = if ir_lowered_expr_is_valid(structural_storage) == 1 { ir_lowered_expr_next_value(structural_storage) } else { dst + result_lanes }
            let linear_transfers = if variant_payloads != 0 {
              pipeline_aggregate_linear_transfer_insts_typed(
                args_exprs, variant_payloads, expected_subst, 0, 0, abi_args,
                params, locals, pipeline_handler_lower_ctx_module(lower_ctx)
              )
            } else { if expected_params != 0 {
              pipeline_effect_linear_transfer_insts_typed(
                args_exprs, expected_params, 0, 0, abi_args,
                params, locals, pipeline_handler_lower_ctx_module(lower_ctx)
              )
            } else { ir_inst_list_empty() } }
            let cleanup = pipeline_managed_lambda_temp_release_args_masked_typed(args_exprs, logical_args, 0, cleanup_start, borrowed_mask, 0, expected_params, variant_payloads, expected_subst, pipeline_handler_lower_ctx_src(lower_ctx), pipeline_handler_lower_ctx_tt(lower_ctx))
            let insts = ir_inst_list_append(pipeline_lowered_args_insts(args), ir_inst_list_append(linear_transfers, ir_inst_list_append(call, pipeline_lowered_args_insts(cleanup))))
            ir_lowered_expr(result_value, pipeline_lowered_args_next_value(cleanup), insts)
          } else {
            ir_lowered_expr_invalid(next_value)
          }
        }
      } else {
        ir_lowered_expr_invalid(next_value)
      }
    }
    _ -> ir_lowered_expr_invalid(next_value)
  } }
}

pub(package) fn pipeline_lower_method_call_expr_typed_sidecar_handler_opt(recv_expr: Expr, method_hash: i64, args_exprs: ExprList, method_ref: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let handlers = pipeline_handler_lower_ctx_handlers(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  let receiver = pipeline_lower_expr_typed_sidecar_handler_ctx(recv_expr, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(receiver) == 1 {
    let associated = method_ref_is_associated(method_ref)
    let param_offset = if associated { 0 } else { 1 }
    let method_params = pipeline_method_ref_params(tt, method_ref, method_hash, subst)
    let receiver_ty = pipeline_method_ref_receiver_type(tt, method_ref, method_hash, subst)
    let result_ty = pipeline_method_ref_result_type(tt, method_ref, method_hash, subst)
    let result_lanes = pipeline_type_value_lane_count_or_one(result_ty)
    let borrowed_mask = pipeline_method_ref_borrowable_param_mask(pipeline_handler_lower_ctx_fns(lower_ctx), tt, method_ref, method_hash, subst)
    let receiver_retain = if associated { pipeline_lowered_args(ir_value_list_empty(), ir_lowered_expr_next_value(receiver), ir_inst_list_empty(), 1) }
      else { pipeline_managed_method_receiver_transport_retain_typed(recv_expr, ir_lowered_expr_value(receiver), receiver_ty, ir_lowered_expr_next_value(receiver), borrowed_mask, src, pipeline_handler_lower_ctx_fns(lower_ctx), subst, tt) }
    let args = pipeline_lower_typed_method_handler_opt_args_expected(args_exprs, 0, pipeline_lowered_args_next_value(receiver_retain), lower_ctx, method_params, 0, borrowed_mask, param_offset)
    if pipeline_lowered_args_is_valid(args) == 1 {
      let dst = pipeline_lowered_args_next_value(args)
      let method_call = pipeline_method_call_inst(dst, method_ref, method_hash, ir_lowered_expr_value(receiver), pipeline_lowered_args_values(args), subst, tt)
      let call_head = ir_inst_list_prepend(method_call, ir_inst_list_empty())
      let receiver_transfer = if associated { ir_inst_list_empty() }
        else { pipeline_method_receiver_linear_transfer_insts_typed(recv_expr, ir_lowered_expr_value(receiver), method_params, params, locals, pipeline_handler_lower_ctx_module(lower_ctx)) }
      let managed_transfers = pipeline_direct_managed_transfer_insts(
        method_params, 0, borrowed_mask, method_call, tt
      )
      let call = ir_inst_list_append(receiver_transfer, ir_inst_list_append(managed_transfers, ir_inst_list_append(call_head, pipeline_ir_call_result_lane_insts(dst, result_ty))))
      let receiver_cleanup = if associated { pipeline_lowered_args(ir_value_list_empty(), dst + result_lanes, ir_inst_list_empty(), 1) }
        else { pipeline_managed_method_receiver_temp_release_typed(recv_expr, ir_lowered_expr_value(receiver), receiver_ty, result_ty, dst + result_lanes, borrowed_mask, src, pipeline_handler_lower_ctx_fns(lower_ctx), subst, tt) }
      let cleanup = pipeline_managed_lambda_temp_release_args_masked_typed(args_exprs, pipeline_lowered_args_values(args), 0, pipeline_lowered_args_next_value(receiver_cleanup), borrowed_mask, param_offset, method_params, 0, 0, src, tt)
      let insts = ir_inst_list_append(ir_lowered_expr_insts(receiver), ir_inst_list_append(pipeline_lowered_args_insts(receiver_retain), ir_inst_list_append(pipeline_lowered_args_insts(args), ir_inst_list_append(call, ir_inst_list_append(pipeline_lowered_args_insts(receiver_cleanup), pipeline_lowered_args_insts(cleanup))))))
      ir_lowered_expr(dst, pipeline_lowered_args_next_value(cleanup), insts)
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

pub(package) fn pipeline_lower_array_literal_elements_straight_typed(elements: ExprList, index: i64, storage: i64, data: i64, array_ty: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  match elements {
    ExprListNil -> ir_lowered_expr(storage, next_value, ir_inst_list_empty())
    ExprListCons(element, rest) -> {
      let prim = pipeline_array_literal_element_prim(array_ty)
      let lowered = if pipeline_prim_is_forced_numeric_context(prim) == 1 {
        pipeline_lower_expr_typed_sidecar_handler_opt_with_float_prim(element, next_value, lower_ctx, prim)
      } else {
        pipeline_lower_expr_typed_sidecar_handler_ctx(element, next_value, lower_ctx)
      }
      if ir_lowered_expr_is_valid(lowered) == 0 {
        ir_lowered_expr_invalid(next_value)
      } else {
        let stored = pipeline_lower_array_literal_store_value_typed(element, ir_lowered_expr_value(lowered), data, index, array_ty, ir_lowered_expr_next_value(lowered), lower_ctx)
        if pipeline_lowered_args_is_valid(stored) == 0 {
          ir_lowered_expr_invalid(next_value)
        } else {
          let tail = pipeline_lower_array_literal_elements_straight_typed(rest, index + 1, storage, data, array_ty, pipeline_lowered_args_next_value(stored), lower_ctx)
          if ir_lowered_expr_is_valid(tail) == 0 {
            ir_lowered_expr_invalid(next_value)
          } else {
            ir_lowered_expr(
              storage,
              ir_lowered_expr_next_value(tail),
              ir_inst_list_append(ir_lowered_expr_insts(lowered), ir_inst_list_append(pipeline_lowered_args_insts(stored), ir_lowered_expr_insts(tail)))
            )
          }
        }
      }
    }
  }
}

pub(package) fn pipeline_lower_array_literal_expr_typed_sidecar_handler_opt(elements: ExprList, resolved_ty: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let array_ty = ty_subst(resolved_ty, pipeline_handler_lower_ctx_subst(lower_ctx))
  let count = expr_list_len(elements)
  let storage = pipeline_lower_array_literal_storage(array_ty, count, next_value, pipeline_handler_lower_ctx_tt(lower_ctx))
  if ir_lowered_expr_is_valid(storage) == 0 {
    ir_lowered_expr_invalid(next_value)
  } else {
    let data = ir_lowered_expr_value(storage) + 6
    let values = pipeline_lower_array_literal_elements_straight_typed(elements, 0, ir_lowered_expr_value(storage), data, array_ty, ir_lowered_expr_next_value(storage), lower_ctx)
    if ir_lowered_expr_is_valid(values) == 0 {
      ir_lowered_expr_invalid(next_value)
    } else {
      ir_lowered_expr(ir_lowered_expr_value(storage), ir_lowered_expr_next_value(values), ir_inst_list_append(ir_lowered_expr_insts(storage), ir_lowered_expr_insts(values)))
    }
  }
}

pub(package) fn pipeline_lower_record_fields_typed_sidecar_handler_opt(fields: RecordFieldList, type_ns: i64, type_nl: i64, structural_ty: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> PipelineLoweredRecordFields {
  match fields {
    RecordFieldListNil -> pipeline_lowered_record_fields(ir_record_field_list_empty(), next_value, ir_inst_list_empty(), 1)
    RecordFieldListCons(field, rest_fields) -> {
      match field {
        RecordField(ns, nl, value_expr, fact) -> {
          let params = pipeline_handler_lower_ctx_params(lower_ctx)
          let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
          let src = pipeline_handler_lower_ctx_src(lower_ctx)
          let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
          let handlers = pipeline_handler_lower_ctx_handlers(lower_ctx)
          let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
          let structural = if type_ns == 0 and type_nl <= 0 { 1 } else { 0 }
          let field_hash = if structural == 1 { record_field_hash_or(field, 0) } else { str_hash(src, ns, nl) }
          let resolved_field_ty = ty_subst(record_field_resolved_type_node(field), subst)
          let field_ty = if structural == 1 { resolved_field_ty }
            else { pipeline_record_field_expected_type(tt, src, type_ns, type_nl, ns, nl, subst) }
          let word_offset = if structural == 1 and structural_ty != 0 { ty_record_field_word_offset(structural_ty, field_hash) }
            else { if structural == 1 { record_field_word_offset_or(field, 0 - 1) }
            else { pipeline_record_field_word_offset(tt, src, type_ns, type_nl, ns, nl, subst) }
            }
          let value = pipeline_lower_expr_typed_sidecar_handler_ctx(value_expr, next_value, lower_ctx)
          if ir_lowered_expr_is_valid(value) == 1 {
            let retain = pipeline_managed_borrow_retain_arg_typed_with_origin(value_expr, ir_lowered_expr_value(value), field_ty, ir_lowered_expr_next_value(value), src, pipeline_handler_lower_ctx_fns(lower_ctx), subst, tt, ir_managed_stake_origin_aggregate())
            let rest = pipeline_lower_record_fields_typed_sidecar_handler_opt(rest_fields, type_ns, type_nl, structural_ty, pipeline_lowered_args_next_value(retain), lower_ctx)
            if pipeline_lowered_record_fields_is_valid(rest) == 1 {
              let values = ir_record_field_list_append(pipeline_ir_record_field_lane_entries(field_hash, word_offset, ir_lowered_expr_value(value), field_ty), pipeline_lowered_record_fields_values(rest))
              let insts = ir_inst_list_append(ir_lowered_expr_insts(value), ir_inst_list_append(pipeline_lowered_args_insts(retain), pipeline_lowered_record_fields_insts(rest)))
              pipeline_lowered_record_fields(values, pipeline_lowered_record_fields_next_value(rest), insts, 1)
            } else {
              pipeline_lowered_record_fields_invalid(next_value)
            }
          } else {
            pipeline_lowered_record_fields_invalid(next_value)
          }
        }
        UnknownRecordField(tag) -> pipeline_lowered_record_fields_invalid(next_value)
      }
    }
  }
}

pub(package) fn pipeline_lower_record_init_expr_typed_sidecar_handler_opt(type_ns: i64, type_nl: i64, fields_exprs: RecordFieldList, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let structural_ty = if type_ns == 0 and type_nl <= 0 {
    ty_subst(
      pipeline_structural_record_value_type(fields_exprs, if type_nl < 0 { 1 } else { 0 }),
      pipeline_handler_lower_ctx_subst(lower_ctx)
    )
  } else { 0 }
  let fields = pipeline_lower_record_fields_typed_sidecar_handler_opt(fields_exprs, type_ns, type_nl, structural_ty, next_value, lower_ctx)
  if pipeline_lowered_record_fields_is_valid(fields) == 1 {
    if type_ns == 0 and type_nl <= 0 {
      let lanes = pipeline_type_value_lane_count_or_one(structural_ty)
      if record_field_list_len(fields_exprs) == 0 {
        let dst = pipeline_lowered_record_fields_next_value(fields)
        ir_lowered_expr(dst, dst + 1, ir_inst_list_append(pipeline_lowered_record_fields_insts(fields), ir_inst_list_prepend(ir_inst_const_i64(dst, 0), ir_inst_list_empty())))
      } else { if pipeline_ir_record_values_have_canonical_lanes(pipeline_lowered_record_fields_values(fields), 0, lanes) == 0 {
        ir_lowered_expr_invalid(next_value)
      } else {
        let slot = pipeline_lowered_record_fields_next_value(fields)
        let dst = slot + lanes
        let materialize = ir_inst_list_append(
          pipeline_ir_record_values_canonical_slot_init_insts(pipeline_lowered_record_fields_values(fields), slot, 0, lanes),
          pipeline_ir_slot_load_lane_insts(dst, slot, 0, lanes)
        )
        ir_lowered_expr(dst, dst + lanes, ir_inst_list_append(pipeline_lowered_record_fields_insts(fields), materialize))
      } }
    } else {
      let dst = pipeline_lowered_record_fields_next_value(fields)
      let record_entry = ttable_lookup(pipeline_handler_lower_ctx_tt(lower_ctx), src, type_ns, type_nl)
      let record = ir_inst_list_prepend(
        pipeline_record_init_inst_for_storage_layout(
          pipeline_handler_lower_ctx_tt(lower_ctx),
          record_entry,
          pipeline_handler_lower_ctx_subst(lower_ctx),
          dst,
          str_hash(src, type_ns, type_nl),
          pipeline_lowered_record_fields_values(fields)
        ),
        ir_inst_list_empty()
      )
      let cleanup = pipeline_record_array_source_releases_for_storage_layout(
        pipeline_handler_lower_ctx_tt(lower_ctx),
        record_entry,
        pipeline_handler_lower_ctx_subst(lower_ctx),
        pipeline_lowered_record_fields_values(fields),
        dst + 1
      )
      if pipeline_lowered_args_is_valid(cleanup) == 1 {
        ir_lowered_expr(dst, pipeline_lowered_args_next_value(cleanup), ir_inst_list_append(pipeline_lowered_record_fields_insts(fields), ir_inst_list_append(record, pipeline_lowered_args_insts(cleanup))))
      } else {
        ir_lowered_expr_invalid(next_value)
      }
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

pub(package) fn pipeline_typed_field_index(tt: i64, src: i64, field_ns: i64, field_nl: i64) -> i64 {
  if tt == 0 { 0 - 1 } else { pipeline_type_find_any_field_index(tt, src, field_ns, field_nl) }
}

pub(package) fn pipeline_type_field_index_for_type_hash_entries(entries: TypeEntryList, type_hash: i64, src: i64, field_ns: i64, field_nl: i64) -> i64 {
  match entries {
    TypeEntryListNil -> 0 - 1
    TypeEntryListCons(entry, rest) -> {
      match entry {
        TypeRecordEntry(name, tparams, fields) -> {
          let entry_src = type_entry_source_or(entry, 0)
          let entry_ns = type_entry_name_start_or(entry, 0)
          let entry_nl = type_entry_name_len_or(entry, 0)
          if str_hash(entry_src, entry_ns, entry_nl) == type_hash or type_name_hash(entry_src, entry_ns, entry_nl) == type_hash {
            pipeline_type_record_field_index(fields, src, field_ns, field_nl, entry_src, 0)
          } else {
            pipeline_type_field_index_for_type_hash_entries(rest, type_hash, src, field_ns, field_nl)
          }
        }
        _ -> pipeline_type_field_index_for_type_hash_entries(rest, type_hash, src, field_ns, field_nl)
      }
    }
  }
}

-- Field indices must come from the receiver's record type. The name-only
-- any-field search is only a last resort when no type fact is available;
-- with colliding field names across records it picks the wrong layout.
pub(package) fn pipeline_typed_field_index_for_type_hash(tt: i64, src: i64, field_ns: i64, field_nl: i64, type_hash: i64) -> i64 {
  let typed_idx = if tt == 0 or type_hash == 0 {
    0 - 1
  } else {
    pipeline_type_field_index_for_type_hash_entries(type_entries_from_table(tt), type_hash, src, field_ns, field_nl)
  }
  if typed_idx >= 0 { typed_idx } else { pipeline_typed_field_index(tt, src, field_ns, field_nl) }
}

pub(package) fn pipeline_field_base_type_hash_direct(base_expr: Expr, src: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> i64 {
  match base_expr {
    Ident(ns, nl) -> {
      let env_hash = pipeline_value_env_lookup_type_hash(locals, src, ns, nl)
      if env_hash != 0 { env_hash } else { pipeline_param_type_hash_by_name(params, src, ns, nl, pipeline_lower_module_subst(module)) }
    }
    RecordInit(type_ns, type_nl, fields) -> type_name_hash(src, type_ns, type_nl)
    RecordUpdate(base, fields, fact) -> type_hash_of(ty_subst(record_update_fact_result_type_node(fact), pipeline_lower_module_subst(module)))
    _ -> 0
  }
}

pub(package) fn pipeline_field_base_type_node_typed(base_expr: Expr, src: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> i64 {
  let inferred = pipeline_return_expr_type_node_typed(base_expr, params, locals, module)
  if inferred != 0 { inferred }
  else {
    let type_hash = pipeline_field_base_type_hash_direct(base_expr, src, params, locals, module)
    if type_hash == 0 { 0 } else { ty_named(type_hash, ty_i64()) }
  }
}

pub(package) fn pipeline_record_instance_subst(entry: i64, base_ty: i64, fallback_subst: i64) -> i64 {
  if entry == 0 or base_ty == 0 or ty_tag(base_ty) != 9 or ty_f3(base_ty) == 0 {
    fallback_subst
  } else {
    let tparams = mem_load64_at(entry, 40)
    if tparams == 0 { fallback_subst } else { build_subst(tparams, ty_f3(base_ty)) }
  }
}

pub(package) fn pipeline_typed_field_entry_for_base(tt: i64, base_ty: i64) -> i64 {
  if tt == 0 or base_ty == 0 or ty_tag(base_ty) != 9 { 0 }
  else { ttable_lookup_named_type(tt, base_ty) }
}

pub(package) fn pipeline_record_storage_layout_for_base(tt: i64, src: i64, base_expr: Expr, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> PipelineRecordStorageLayout {
  let base_ty = pipeline_field_base_type_node_typed(base_expr, src, params, locals, module)
  let entry = pipeline_typed_field_entry_for_base(tt, base_ty)
  if entry == 0 {
    -- An unresolved/generic receiver has no concrete aggregate layout to
    -- describe here. Preserve the historical compact/name-indexed lowering;
    -- monomorphisation supplies concrete specialisations where available.
    PipelineRecordStorageLayoutCompact
  } else {
    let subst = pipeline_record_instance_subst(entry, base_ty, pipeline_lower_module_subst(module))
    pipeline_record_storage_layout_for_entry(tt, entry, subst)
  }
}

pub(package) fn pipeline_record_storage_layout_for_base_node(tt: i64, src: i64, base_node: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> PipelineRecordStorageLayout {
  let stripped = pipeline_expr_node_strip_typed(base_node)
  if stripped == 0 { PipelineRecordStorageLayoutCompact }
  else { pipeline_record_storage_layout_for_base(tt, src, expr_from_node(stripped), params, locals, module) }
}

pub(package) fn pipeline_typed_field_type_for_base(tt: i64, src: i64, field_ns: i64, field_nl: i64, base_expr: Expr, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> i64 {
  let base_ty = pipeline_field_base_type_node_typed(base_expr, src, params, locals, module)
  if ty_is_record(base_ty) {
    let field = ty_record_field_by_hash(ty_record_fields(base_ty), field_access_key(src, field_ns, field_nl))
    if field == 0 { 0 } else { ty_record_field_type(field) }
  } else {
    let entry = pipeline_typed_field_entry_for_base(tt, base_ty)
    let subst = pipeline_record_instance_subst(entry, base_ty, pipeline_lower_module_subst(module))
    pipeline_record_field_type_in_entry(entry, src, field_ns, field_nl, subst)
  }
}

pub(package) fn pipeline_typed_field_index_for_base(tt: i64, src: i64, field_ns: i64, field_nl: i64, base_expr: Expr, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> i64 {
  let base_ty = pipeline_field_base_type_node_typed(base_expr, src, params, locals, module)
  if ty_is_record(base_ty) {
    ty_record_field_word_offset(base_ty, field_access_key(src, field_ns, field_nl))
  } else {
    let entry = pipeline_typed_field_entry_for_base(tt, base_ty)
    let subst = pipeline_record_instance_subst(entry, base_ty, pipeline_lower_module_subst(module))
    let word_offset = pipeline_record_field_word_offset_in_entry(entry, src, field_ns, field_nl, subst)
    if word_offset >= 0 { word_offset }
    else {
      let node_hash = if base_ty == 0 { 0 } else { type_hash_of(base_ty) }
      pipeline_typed_field_index_for_type_hash(tt, src, field_ns, field_nl, node_hash)
    }
  }
}

pub(package) fn pipeline_typed_field_index_for_base_node(tt: i64, src: i64, field_ns: i64, field_nl: i64, base_node: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> i64 {
  let stripped = pipeline_expr_node_strip_typed(base_node)
  if stripped == 0 {
    pipeline_typed_field_index(tt, src, field_ns, field_nl)
  } else {
    pipeline_typed_field_index_for_base(tt, src, field_ns, field_nl, expr_from_node(stripped), params, locals, module)
  }
}

pub(package) fn pipeline_typed_field_type_for_base_node(tt: i64, src: i64, field_ns: i64, field_nl: i64, base_node: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> i64 {
  let stripped = pipeline_expr_node_strip_typed(base_node)
  if stripped == 0 { 0 }
  else { pipeline_typed_field_type_for_base(tt, src, field_ns, field_nl, expr_from_node(stripped), params, locals, module) }
}

-- A field fact produced while checking a shape-polymorphic template names the
-- structural predicate, not a concrete representation.  Once specialization
-- replaces that parameter with an exact nominal/closed shape, the specialised
-- parameter fact is authoritative for layout.  This comparison is semantic
-- plumbing, not a syntax rescan: both inputs are checker/monomorphiser types.
pub(package) fn pipeline_field_access_use_specialised_base(inferred_base_ty: i64, fact_base_ty: i64, subst: i64) -> i64 {
  if inferred_base_ty == 0 or fact_base_ty == 0 { 0 }
  else {
    let resolved_fact = ty_subst(fact_base_ty, subst)
    if ty_eq(inferred_base_ty, resolved_fact) { 0 }
    else { if ty_value_storage_word_count(inferred_base_ty) > 0 { 1 } else { 0 } }
  }
}

pub(package) fn pipeline_lower_field_access_expr_typed_sidecar_handler_opt(base_expr: Expr, field_ns: i64, field_nl: i64, access_fact: FieldAccessFact, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let declaration = field_access_fact_declaration(access_fact)
  if declaration != 0 { pipeline_lower_decl_function_ref(declaration, next_value) }
  else {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let handlers = pipeline_handler_lower_ctx_handlers(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  let base = pipeline_lower_expr_typed_sidecar_handler_ctx(base_expr, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(base) == 1 {
    let inferred_base_ty = pipeline_field_base_type_node_typed(base_expr, src, params, locals, pipeline_handler_lower_ctx_module(lower_ctx))
    let fact_base_ty = field_access_fact_base_type_node(access_fact)
    let specialised_base = pipeline_field_access_use_specialised_base(inferred_base_ty, fact_base_ty, subst)
    let base_ty = if specialised_base == 1 or fact_base_ty == 0 { inferred_base_ty } else { ty_subst(fact_base_ty, subst) }
    let structural = if specialised_base == 1 { if ty_is_record(base_ty) { 1 } else { 0 } }
      else { if field_access_fact_is_structural(access_fact) == 1 or ty_is_record(base_ty) { 1 } else { 0 } }
    let dst = ir_lowered_expr_next_value(base)
    let fact_field_ty = field_access_fact_field_type_node(access_fact)
    let inferred_field_ty = pipeline_typed_field_type_for_base(tt, src, field_ns, field_nl, base_expr, params, locals, pipeline_handler_lower_ctx_module(lower_ctx))
    let field_ty = if specialised_base == 1 and inferred_field_ty != 0 { inferred_field_ty }
      else { if fact_field_ty != 0 { ty_subst(fact_field_ty, subst) } else { inferred_field_ty } }
    let inferred_offset = pipeline_typed_field_index_for_base(tt, src, field_ns, field_nl, base_expr, params, locals, pipeline_handler_lower_ctx_module(lower_ctx))
    let field_offset = if specialised_base == 1 { inferred_offset } else { field_access_fact_word_offset_or(access_fact, inferred_offset) }
    if structural == 1 {
      ir_lowered_expr(ir_lowered_expr_value(base) + field_offset, ir_lowered_expr_next_value(base), ir_lowered_expr_insts(base))
    } else {
      let storage_layout = pipeline_record_storage_layout_for_base(tt, src, base_expr, params, locals, pipeline_handler_lower_ctx_module(lower_ctx))
      let field = pipeline_lower_field_load_for_storage_layout(dst, ir_lowered_expr_value(base), str_hash(src, field_ns, field_nl), field_offset, field_ty, storage_layout)
      ir_lowered_expr(ir_lowered_expr_value(field), ir_lowered_expr_next_value(field), ir_inst_list_append(ir_lowered_expr_insts(base), ir_lowered_expr_insts(field)))
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
  }
}

-- Consume the checker-produced indexed-length fact. A fixed array's length is
-- constant, but its base expression still evaluates; an owned temporary
-- backing is released afterward. A slice is non-owning and its length is the
-- secondary ABI lane already produced by lowering its base.
pub(package) fn pipeline_lower_indexed_len_after_base_typed(base_expr: Expr, fixed_len: i64, base_value: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  if fixed_len < 0 {
    ir_lowered_expr(base_value + 1, next_value, ir_inst_list_empty())
  } else {
    let result = next_value
    let borrowed = pipeline_array_expr_result_is_borrowed_typed(
      base_expr,
      pipeline_handler_lower_ctx_src(lower_ctx),
      pipeline_handler_lower_ctx_fns(lower_ctx),
      pipeline_handler_lower_ctx_subst(lower_ctx),
      pipeline_handler_lower_ctx_tt(lower_ctx)
    )
    let release = if borrowed == 0 {
      ir_inst_list_prepend(pipeline_managed_release_inst_with_origin(result + 1, base_value, continuation_cleanup_kind_rc(), ir_managed_stake_origin_aggregate()), ir_inst_list_empty())
    } else { ir_inst_list_empty() }
    let next = if borrowed == 0 { result + 2 } else { result + 1 }
    ir_lowered_expr(result, next, ir_inst_list_prepend(ir_inst_const_i64(result, fixed_len), release))
  }
}

pub(package) fn pipeline_lower_indexed_len_expr_typed_sidecar_handler_opt(base_expr: Expr, fixed_len: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let base = pipeline_lower_expr_typed_sidecar_handler_ctx(base_expr, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(base) == 1 {
    let result = pipeline_lower_indexed_len_after_base_typed(base_expr, fixed_len, ir_lowered_expr_value(base), ir_lowered_expr_next_value(base), lower_ctx)
    ir_lowered_expr(ir_lowered_expr_value(result), ir_lowered_expr_next_value(result), ir_inst_list_append(ir_lowered_expr_insts(base), ir_lowered_expr_insts(result)))
  } else { ir_lowered_expr_invalid(next_value) }
}

pub(package) fn pipeline_lower_indexed_len_typed_to_target_blocks(base_expr: Expr, fixed_len: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  if pipeline_expr_needs_cfg_typed(base_expr) == 0 {
    pipeline_lower_straight_expr_typed_to_target_blocks(IndexedLen(base_expr, fixed_len), params, locals, module, next_value, start_block, next_block, target_block)
  } else {
    let base_merge_block = next_block
    let base_blocks = pipeline_lower_expr_typed_to_target_blocks_reserved(base_expr, params, locals, module, next_value, start_block, next_block + 1, base_merge_block)
    if pipeline_lowered_blocks_is_valid(base_blocks) == 1 {
      if pipeline_lowered_blocks_falls_through(base_blocks) == 0 { base_blocks }
      else {
        let base_value = pipeline_lowered_blocks_next_value(base_blocks)
        let base_lanes = if fixed_len < 0 { 2 } else { 1 }
        let result = pipeline_lower_indexed_len_after_base_typed(base_expr, fixed_len, base_value, base_value + base_lanes, pipeline_handler_lower_ctx_from_module(params, locals, module))
        let merge = ir_block_new_params(
          base_merge_block,
          pipeline_ir_value_lane_ids(base_value, 0, base_lanes),
          ir_lowered_expr_insts(result),
          ir_term_jump_args(target_block, ir_value_list_prepend(ir_lowered_expr_value(result), ir_value_list_empty()))
        )
        pipeline_lowered_blocks(
          pipeline_lowered_blocks_next_block(base_blocks),
          ir_lowered_expr_next_value(result),
          ir_block_list_append(pipeline_lowered_blocks_blocks(base_blocks), ir_block_list_prepend(merge, ir_block_list_empty())),
          1
        )
      }
    } else { pipeline_lowered_blocks_invalid(start_block, next_value) }
  }
}

pub(package) fn pipeline_indexed_element_stride(tt: i64, element_ty: i64) -> i64 {
  let size = cg_layout_indexed_element_size(tt, element_ty)
  let align = cg_layout_indexed_element_align(tt, element_ty)
  if size <= 0 or align <= 0 { 0 - 1 } else { cg_layout_align_up(size, align) }
}

pub(package) fn pipeline_index_address_args(data: i64, len: i64, index: i64, stride: i64) -> IrValueList {
  ir_value_list_prepend(data, ir_value_list_prepend(len, ir_value_list_prepend(index, ir_value_list_prepend(stride, ir_value_list_empty()))))
}

pub(package) fn pipeline_slice_address_args(owner: i64, data: i64, len: i64, start: i64, end: i64, stride: i64) -> IrValueList {
  ir_value_list_prepend(owner, ir_value_list_prepend(data, ir_value_list_prepend(len, ir_value_list_prepend(start, ir_value_list_prepend(end, ir_value_list_prepend(stride, ir_value_list_empty()))))))
}

pub(package) fn pipeline_indexed_slice_fact_element_ty(fact: i64) -> i64 {
  if fact == 0 { 0 } else { node_f1(fact) }
}

pub(package) fn pipeline_indexed_slice_fact_fixed_len(fact: i64) -> i64 {
  if fact == 0 { 0 - 2 } else { node_f2(fact) }
}

pub(package) fn pipeline_indexed_slice_fact_base_ty(fact: i64) -> i64 {
  if fact == 0 { 0 } else { node_f3(fact) }
}

pub(package) fn pipeline_indexed_slice_fact_mutable(fact: i64) -> i64 {
  if fact == 0 { 0 } else { node_f4(fact) }
}

pub(package) fn pipeline_type_is_vector(ty: i64) -> i64 {
  if ty == 0 or ty_tag(ty) != 9 { 0 }
  else { if ty_f1(ty) == str_hash(__str_ptr("Vector"), 0, __str_len("Vector")) { 1 } else { 0 } }
}

pub(package) fn pipeline_vector_data_hash() -> i64 {
  str_hash(__str_ptr("vector_data"), 0, __str_len("vector_data"))
}

pub(package) fn pipeline_indexed_slice_base_lane_count(fact: i64, subst: i64) -> i64 {
  let base_ty = ty_subst(pipeline_indexed_slice_fact_base_ty(fact), subst)
  if ty_is_slice(base_ty) { 2 } else { 1 }
}

-- Construct a non-owning (data, len) pair from checker-produced storage and
-- mutability facts. The runtime call remains an explicit semantic seam so the
-- borrow pass can rebase provenance after optimisation.
pub(package) fn pipeline_lower_indexed_slice_after_values_typed(base_expr: Expr, start_expr: Expr, end_expr: Expr, fact: i64, base_value: i64, start_value: i64, end_value: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  let element_ty = ty_subst(pipeline_indexed_slice_fact_element_ty(fact), subst)
  let base_ty = ty_subst(pipeline_indexed_slice_fact_base_ty(fact), subst)
  let fixed_len = pipeline_indexed_slice_fact_fixed_len(fact)
  let mutable = pipeline_indexed_slice_fact_mutable(fact)
  let stride = pipeline_indexed_element_stride(tt, element_ty)
  if fact == 0 or stride <= 0 { ir_lowered_expr_invalid(next_value) }
  else {
    let mut insts = ir_inst_list_empty()
    let mut cursor = next_value
    let mut owner = base_value
    let mut data = base_value
    let mut len = base_value + 1
    if pipeline_type_is_vector(base_ty) == 1 {
      let type_args = ty_f3(base_ty)
      data = cursor
      len = cursor + 1
      insts = ir_inst_list_prepend(
        ir_inst_generic_call_i64(data, pipeline_vector_data_hash(), type_args, ir_value_list_prepend(base_value, ir_value_list_empty())),
        ir_inst_list_prepend(
          ir_inst_generic_call_i64(len, pipeline_ir_vector_len_hash(), type_args, ir_value_list_prepend(base_value, ir_value_list_empty())),
          ir_inst_list_empty()
        )
      )
      cursor = cursor + 2
    } else { if fixed_len >= 0 {
      if mutable == 1 {
        let storage = pipeline_lower_array_literal_storage(base_ty, fixed_len, cursor, tt)
        if ir_lowered_expr_is_valid(storage) == 0 { return ir_lowered_expr_invalid(next_value) }
        owner = ir_lowered_expr_value(storage)
        data = ir_lowered_expr_next_value(storage) - 1
        cursor = ir_lowered_expr_next_value(storage)
        let old_data = cursor
        cursor = cursor + 1
        let total_size = cg_layout_storage_size(tt, base_ty)
        let leaf_count = cg_layout_array_leaf_count(base_ty)
        let leaf_stride = pipeline_array_literal_leaf_stride(tt, base_ty)
        let leaf_kind = pipeline_array_literal_leaf_kind(tt, base_ty)
        if pipeline_array_copy_plan_is_valid(total_size, leaf_count, leaf_stride, leaf_kind) == 0 { return ir_lowered_expr_invalid(next_value) }
        match base_expr {
          Ident(ns, nl) -> {
            let slot = pipeline_value_env_lookup(pipeline_handler_lower_ctx_locals(lower_ctx), pipeline_handler_lower_ctx_src(lower_ctx), ns, nl)
            if slot < 0 { return ir_lowered_expr_invalid(next_value) }
            insts = ir_inst_list_append(
              ir_lowered_expr_insts(storage),
              ir_inst_list_prepend(
                ir_inst_call_i64(old_data, pipeline_rc_array_storage_data_hash(), ir_value_list_prepend(base_value, ir_value_list_empty())),
                ir_inst_list_prepend(
                  ir_inst_array_copy_i64(data, old_data, total_size, leaf_count, leaf_stride, leaf_kind),
                  ir_inst_list_prepend(
                    ir_inst_store_i64(slot, owner),
                    ir_inst_list_prepend(pipeline_managed_release_inst_with_origin(cursor, base_value, continuation_cleanup_kind_rc(), ir_managed_stake_origin_aggregate()), ir_inst_list_empty())
                  )
                )
              )
            )
            cursor = cursor + 1
          }
          _ -> return ir_lowered_expr_invalid(next_value)
        }
      } else {
        data = cursor
        insts = ir_inst_list_prepend(ir_inst_call_i64(data, pipeline_rc_array_storage_data_hash(), ir_value_list_prepend(base_value, ir_value_list_empty())), ir_inst_list_empty())
        cursor = cursor + 1
      }
      len = cursor
      insts = ir_inst_list_append(insts, ir_inst_list_prepend(ir_inst_const_i64(len, fixed_len), ir_inst_list_empty()))
      cursor = cursor + 1
    } else { 0 } }
    let actual_start = start_value
    let actual_end = if pipeline_expr_is_nil_lit(end_expr) == 1 { len } else { end_value }
    let stride_value = cursor
    let result = stride_value + 1
    let result_len = result + 1
    let call_hash = if mutable == 1 { pipeline_runtime_mut_slice_address_hash() } else { pipeline_runtime_slice_address_hash() }
    let finish = ir_inst_list_prepend(
      ir_inst_const_i64(stride_value, stride),
      ir_inst_list_prepend(
        ir_inst_call_i64(result, call_hash, pipeline_slice_address_args(owner, data, len, actual_start, actual_end, stride_value)),
        ir_inst_list_prepend(ir_inst_float_binary_i64(result_len, PRIM_USIZE(), IrSub, actual_end, actual_start), ir_inst_list_empty())
      )
    )
    ir_lowered_expr(result, result + 2, ir_inst_list_append(insts, finish))
  }
}

pub(package) fn pipeline_lower_indexed_slice_expr_typed_sidecar_handler_opt(base_expr: Expr, start_expr: Expr, end_expr: Expr, fact: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let base = pipeline_lower_expr_typed_sidecar_handler_ctx(base_expr, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(base) == 0 { ir_lowered_expr_invalid(next_value) }
  else {
    let start = pipeline_lower_expr_typed_sidecar_handler_opt_with_float_prim(start_expr, ir_lowered_expr_next_value(base), lower_ctx, PRIM_USIZE())
    if ir_lowered_expr_is_valid(start) == 0 { ir_lowered_expr_invalid(next_value) }
    else {
      let end = pipeline_lower_expr_typed_sidecar_handler_opt_with_float_prim(end_expr, ir_lowered_expr_next_value(start), lower_ctx, PRIM_USIZE())
      if ir_lowered_expr_is_valid(end) == 0 { ir_lowered_expr_invalid(next_value) }
      else {
        let sliced = pipeline_lower_indexed_slice_after_values_typed(base_expr, start_expr, end_expr, fact, ir_lowered_expr_value(base), ir_lowered_expr_value(start), ir_lowered_expr_value(end), ir_lowered_expr_next_value(end), lower_ctx)
        ir_lowered_expr(ir_lowered_expr_value(sliced), ir_lowered_expr_next_value(sliced), ir_inst_list_append(ir_lowered_expr_insts(base), ir_inst_list_append(ir_lowered_expr_insts(start), ir_inst_list_append(ir_lowered_expr_insts(end), ir_lowered_expr_insts(sliced)))))
      }
    }
  }
}

pub(package) fn pipeline_lower_indexed_slice_typed_to_target_blocks(base_expr: Expr, start_expr: Expr, end_expr: Expr, fact: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  if pipeline_expr_needs_lowering_cfg_typed(base_expr, src) == 0 and pipeline_expr_needs_lowering_cfg_typed(start_expr, src) == 0 and pipeline_expr_needs_lowering_cfg_typed(end_expr, src) == 0 {
    pipeline_lower_straight_expr_typed_to_target_blocks(IndexedSlice(base_expr, start_expr, end_expr, fact), params, locals, module, next_value, start_block, next_block, target_block)
  } else {
    let fixed_len = pipeline_indexed_slice_fact_fixed_len(fact)
    let base_merge_block = next_block
    let base_blocks = pipeline_lower_expr_typed_to_target_blocks_reserved(base_expr, params, locals, module, next_value, start_block, next_block + 1, base_merge_block)
    if pipeline_lowered_blocks_is_valid(base_blocks) == 0 { pipeline_lowered_blocks_invalid(start_block, next_value) }
    else { if pipeline_lowered_blocks_falls_through(base_blocks) == 0 { base_blocks }
    else {
      let base_value = pipeline_lowered_blocks_next_value(base_blocks)
      let base_lanes = pipeline_indexed_slice_base_lane_count(fact, pipeline_lower_module_subst(module))
      let start_start = pipeline_lowered_blocks_next_block(base_blocks)
      let start_merge_block = start_start + 1
      let start_blocks = pipeline_lower_expr_typed_to_target_blocks_reserved(start_expr, params, locals, module, base_value + base_lanes, start_start, start_start + 2, start_merge_block)
      let base_merge = ir_block_new_params(base_merge_block, pipeline_ir_value_lane_ids(base_value, 0, base_lanes), ir_inst_list_empty(), ir_term_jump(start_start))
      let base_prefix = ir_block_list_append(pipeline_lowered_blocks_blocks(base_blocks), ir_block_list_prepend(base_merge, ir_block_list_empty()))
      if pipeline_lowered_blocks_is_valid(start_blocks) == 0 { pipeline_lowered_blocks_invalid(start_block, next_value) }
      else { if pipeline_lowered_blocks_falls_through(start_blocks) == 0 {
        pipeline_lowered_blocks_control(pipeline_lowered_blocks_next_block(start_blocks), pipeline_lowered_blocks_next_value(start_blocks), ir_block_list_append(base_prefix, pipeline_lowered_blocks_blocks(start_blocks)), 1, 0)
      } else {
        let start_value = pipeline_lowered_blocks_next_value(start_blocks)
        let end_start = pipeline_lowered_blocks_next_block(start_blocks)
        let end_merge_block = end_start + 1
        let end_blocks = pipeline_lower_expr_typed_to_target_blocks_reserved(end_expr, params, locals, module, start_value + 1, end_start, end_start + 2, end_merge_block)
        let start_merge = ir_block_new_params(start_merge_block, ir_value_list_prepend(start_value, ir_value_list_empty()), ir_inst_list_empty(), ir_term_jump(end_start))
        let start_prefix = ir_block_list_append(base_prefix, ir_block_list_append(pipeline_lowered_blocks_blocks(start_blocks), ir_block_list_prepend(start_merge, ir_block_list_empty())))
        if pipeline_lowered_blocks_is_valid(end_blocks) == 0 { pipeline_lowered_blocks_invalid(start_block, next_value) }
        else { if pipeline_lowered_blocks_falls_through(end_blocks) == 0 {
          pipeline_lowered_blocks_control(pipeline_lowered_blocks_next_block(end_blocks), pipeline_lowered_blocks_next_value(end_blocks), ir_block_list_append(start_prefix, pipeline_lowered_blocks_blocks(end_blocks)), 1, 0)
        } else {
          let end_value = pipeline_lowered_blocks_next_value(end_blocks)
          let sliced = pipeline_lower_indexed_slice_after_values_typed(base_expr, start_expr, end_expr, fact, base_value, start_value, end_value, end_value + 1, pipeline_handler_lower_ctx_from_module(params, locals, module))
          let end_merge = ir_block_new_params(
            end_merge_block,
            ir_value_list_prepend(end_value, ir_value_list_empty()),
            ir_lowered_expr_insts(sliced),
            ir_term_jump_args(target_block, pipeline_ir_value_lane_ids(ir_lowered_expr_value(sliced), 0, 2))
          )
          let blocks = ir_block_list_append(start_prefix, ir_block_list_append(pipeline_lowered_blocks_blocks(end_blocks), ir_block_list_prepend(end_merge, ir_block_list_empty())))
          pipeline_lowered_blocks(pipeline_lowered_blocks_next_block(end_blocks), ir_lowered_expr_next_value(sliced), blocks, 1)
        } }
      } }
    } }
  }
}

pub(package) fn pipeline_lower_indexed_slice_value(address: i64, next_value: i64) -> IrLoweredExpr {
  let lane_offset = next_value
  let second_address = lane_offset + 1
  let lane_size = second_address + 1
  let lane_mode = lane_size + 1
  let result = lane_mode + 1
  let first_args = ir_value_list_prepend(address, ir_value_list_prepend(lane_size, ir_value_list_prepend(lane_mode, ir_value_list_empty())))
  let second_args = ir_value_list_prepend(second_address, ir_value_list_prepend(lane_size, ir_value_list_prepend(lane_mode, ir_value_list_empty())))
  let insts = ir_inst_list_prepend(
    ir_inst_const_i64(lane_offset, 8),
    ir_inst_list_prepend(
      ir_inst_binary_i64(second_address, ir_binary_op_add(), address, lane_offset),
      ir_inst_list_prepend(
        ir_inst_const_i64(lane_size, 8),
        ir_inst_list_prepend(
          ir_inst_const_i64(lane_mode, 0),
          ir_inst_list_prepend(
            ir_inst_call_i64(result, pipeline_ir_native_intrinsic_mem_load_sized_hash(), first_args),
            ir_inst_list_prepend(ir_inst_call_i64(result + 1, pipeline_ir_native_intrinsic_mem_load_sized_hash(), second_args), ir_inst_list_empty())
          )
        )
      )
    )
  )
  ir_lowered_expr(result, result + 2, insts)
}

-- Structural records use contiguous semantic lanes but indexed containers use
-- their byte layout. These two recursive plans are the missing transport
-- seam: flatten/unflatten at the producer, never in a later recognizer.
pub(package) fn pipeline_lower_indexed_structural_load_lane(address: i64, dst: i64, byte_offset: i64, byte_size: i64, mode: i64, next_value: i64) -> PipelineLoweredArgs {
  if byte_offset < 0 or byte_size <= 0 or byte_size > 8 { pipeline_lowered_args_invalid(next_value) }
  else {
    let offset_value = next_value
    let lane_address = offset_value + 1
    let size_value = lane_address + 1
    let mode_value = size_value + 1
    let load_args = ir_value_list_prepend(lane_address, ir_value_list_prepend(size_value, ir_value_list_prepend(mode_value, ir_value_list_empty())))
    let insts = ir_inst_list_prepend(
      ir_inst_const_i64(offset_value, byte_offset),
      ir_inst_list_prepend(
        ir_inst_binary_i64(lane_address, ir_binary_op_add(), address, offset_value),
        ir_inst_list_prepend(
          ir_inst_const_i64(size_value, byte_size),
          ir_inst_list_prepend(
            ir_inst_const_i64(mode_value, mode),
            ir_inst_list_prepend(ir_inst_call_i64(dst, pipeline_ir_native_intrinsic_mem_load_sized_hash(), load_args), ir_inst_list_empty())
          )
        )
      )
    )
    pipeline_lowered_args(ir_value_list_empty(), mode_value + 1, insts, 1)
  }
}

pub(package) fn pipeline_lower_indexed_structural_load_value(address: i64, dst: i64, byte_offset: i64, ty: i64, next_value: i64, tt: i64) -> PipelineLoweredArgs {
  if ty_is_record(ty) {
    pipeline_lower_indexed_structural_load_fields(address, dst, byte_offset, ty, 0, next_value, tt)
  } else { if ty_is_slice(ty) {
    let first = pipeline_lower_indexed_structural_load_lane(address, dst, byte_offset, 8, 0, next_value)
    if pipeline_lowered_args_is_valid(first) == 0 { first }
    else {
      let second = pipeline_lower_indexed_structural_load_lane(address, dst + 1, byte_offset + 8, 8, 0, pipeline_lowered_args_next_value(first))
      if pipeline_lowered_args_is_valid(second) == 0 { second }
      else { pipeline_lowered_args(ir_value_list_empty(), pipeline_lowered_args_next_value(second), ir_inst_list_append(pipeline_lowered_args_insts(first), pipeline_lowered_args_insts(second)), 1) }
    }
  } else {
    let lanes = pipeline_type_value_lane_count_or_one(ty)
    let size = cg_layout_storage_size(tt, ty)
    if lanes != 1 { pipeline_lowered_args_invalid(next_value) }
    else { pipeline_lower_indexed_structural_load_lane(address, dst, byte_offset, size, cg_layout_storage_mode(tt, ty), next_value) }
  } }
}

pub(package) fn pipeline_lower_indexed_structural_load_fields(address: i64, dst: i64, byte_offset: i64, record_ty: i64, field_index: i64, next_value: i64, tt: i64) -> PipelineLoweredArgs {
  let fields = ty_record_fields(record_ty)
  let count = if fields == 0 { 0 } else { nlist_len(fields) }
  if field_index >= count { pipeline_lowered_args(ir_value_list_empty(), next_value, ir_inst_list_empty(), 1) }
  else {
    let field = ty_record_field_at_layout_index(record_ty, field_index)
    let field_hash = ty_record_field_hash(field)
    let field_ty = ty_record_field_type(field)
    let field_word_offset = ty_record_field_word_offset(record_ty, field_hash)
    let field_byte_offset = cg_layout_structural_record_field_offset(tt, record_ty, field_hash)
    let current = pipeline_lower_indexed_structural_load_value(address, dst + field_word_offset, byte_offset + field_byte_offset, field_ty, next_value, tt)
    if pipeline_lowered_args_is_valid(current) == 0 { current }
    else {
      let rest = pipeline_lower_indexed_structural_load_fields(address, dst, byte_offset, record_ty, field_index + 1, pipeline_lowered_args_next_value(current), tt)
      if pipeline_lowered_args_is_valid(rest) == 0 { rest }
      else { pipeline_lowered_args(ir_value_list_empty(), pipeline_lowered_args_next_value(rest), ir_inst_list_append(pipeline_lowered_args_insts(current), pipeline_lowered_args_insts(rest)), 1) }
    }
  }
}

pub(package) fn pipeline_lower_indexed_structural_store_lane(address: i64, value: i64, byte_offset: i64, byte_size: i64, mode: i64, next_value: i64) -> PipelineLoweredArgs {
  if byte_offset < 0 or byte_size <= 0 or byte_size > 8 { pipeline_lowered_args_invalid(next_value) }
  else {
    let offset_value = next_value
    let lane_address = offset_value + 1
    let size_value = lane_address + 1
    let mode_value = size_value + 1
    let store_dst = mode_value + 1
    let store_args = ir_value_list_prepend(lane_address, ir_value_list_prepend(size_value, ir_value_list_prepend(mode_value, ir_value_list_prepend(value, ir_value_list_empty()))))
    let insts = ir_inst_list_prepend(
      ir_inst_const_i64(offset_value, byte_offset),
      ir_inst_list_prepend(
        ir_inst_binary_i64(lane_address, ir_binary_op_add(), address, offset_value),
        ir_inst_list_prepend(
          ir_inst_const_i64(size_value, byte_size),
          ir_inst_list_prepend(
            ir_inst_const_i64(mode_value, mode),
            ir_inst_list_prepend(ir_inst_call_i64(store_dst, pipeline_ir_native_intrinsic_mem_store_sized_hash(), store_args), ir_inst_list_empty())
          )
        )
      )
    )
    pipeline_lowered_args(ir_value_list_empty(), store_dst + 1, insts, 1)
  }
}

pub(package) fn pipeline_lower_indexed_structural_store_value(address: i64, value: i64, byte_offset: i64, ty: i64, next_value: i64, tt: i64) -> PipelineLoweredArgs {
  if ty_is_record(ty) {
    pipeline_lower_indexed_structural_store_fields(address, value, byte_offset, ty, 0, next_value, tt)
  } else { if ty_is_slice(ty) {
    let first = pipeline_lower_indexed_structural_store_lane(address, value, byte_offset, 8, 0, next_value)
    if pipeline_lowered_args_is_valid(first) == 0 { first }
    else {
      let second = pipeline_lower_indexed_structural_store_lane(address, value + 1, byte_offset + 8, 8, 0, pipeline_lowered_args_next_value(first))
      if pipeline_lowered_args_is_valid(second) == 0 { second }
      else { pipeline_lowered_args(ir_value_list_empty(), pipeline_lowered_args_next_value(second), ir_inst_list_append(pipeline_lowered_args_insts(first), pipeline_lowered_args_insts(second)), 1) }
    }
  } else {
    let lanes = pipeline_type_value_lane_count_or_one(ty)
    let size = cg_layout_storage_size(tt, ty)
    if lanes != 1 { pipeline_lowered_args_invalid(next_value) }
    else { pipeline_lower_indexed_structural_store_lane(address, value, byte_offset, size, cg_layout_storage_mode(tt, ty), next_value) }
  } }
}

pub(package) fn pipeline_lower_indexed_structural_store_fields(address: i64, value: i64, byte_offset: i64, record_ty: i64, field_index: i64, next_value: i64, tt: i64) -> PipelineLoweredArgs {
  let fields = ty_record_fields(record_ty)
  let count = if fields == 0 { 0 } else { nlist_len(fields) }
  if field_index >= count { pipeline_lowered_args(ir_value_list_empty(), next_value, ir_inst_list_empty(), 1) }
  else {
    let field = ty_record_field_at_layout_index(record_ty, field_index)
    let field_hash = ty_record_field_hash(field)
    let field_ty = ty_record_field_type(field)
    let field_word_offset = ty_record_field_word_offset(record_ty, field_hash)
    let field_byte_offset = cg_layout_structural_record_field_offset(tt, record_ty, field_hash)
    let current = pipeline_lower_indexed_structural_store_value(address, value + field_word_offset, byte_offset + field_byte_offset, field_ty, next_value, tt)
    if pipeline_lowered_args_is_valid(current) == 0 { current }
    else {
      let rest = pipeline_lower_indexed_structural_store_fields(address, value, byte_offset, record_ty, field_index + 1, pipeline_lowered_args_next_value(current), tt)
      if pipeline_lowered_args_is_valid(rest) == 0 { rest }
      else { pipeline_lowered_args(ir_value_list_empty(), pipeline_lowered_args_next_value(rest), ir_inst_list_append(pipeline_lowered_args_insts(current), pipeline_lowered_args_insts(rest)), 1) }
    }
  }
}

-- Vector's raw storage shim is word-shaped source for scalar T, but closed
-- structural records are multi-lane values and fixed arrays are managed owner
-- handles whose payload lives in separate storage. Lower both through the
-- shared indexed-layout/array-copy facts before the generic shim can erase T
-- to its first word.
pub(package) fn pipeline_lower_structural_vector_storage_call(callee_hash: i64, element_ty: i64, values: IrValueList, next_value: i64, tt: i64) -> IrLoweredExpr {
  if element_ty == 0 {
    ir_lowered_expr_invalid(next_value)
  } else {
    let nargs = ir_value_list_len(values)
    let store = if (callee_hash == pipeline_ir_native_vector_storage_store_value_hash() or callee_hash == pipeline_ir_native_vector_store_value_hash()) and nargs == 4 { 1 } else { 0 }
    let load = if (callee_hash == pipeline_ir_native_vector_storage_load_value_hash() or callee_hash == pipeline_ir_native_vector_load_value_hash()) and nargs == 4 { 1 }
      else { if callee_hash == pipeline_ir_native_vector_storage_load_value_in_bounds_hash() and nargs == 3 { 1 } else { 0 } }
    let address = pipeline_ir_value_list_get_or(values, 0, 0 - 1)
    if ty_is_array(element_ty) and pipeline_array_literal_layout_is_valid(tt, element_ty, ty_array_length(element_ty)) == 1 and store == 1 {
      let value = pipeline_ir_value_list_get_or(values, 3, 0 - 1)
      let source_data = next_value
      let result = source_data + 1
      let byte_size = cg_layout_array_size(tt, element_ty)
      let leaf_count = cg_layout_array_leaf_count(element_ty)
      let leaf_stride = pipeline_array_literal_leaf_stride(tt, element_ty)
      let leaf_kind = pipeline_array_literal_leaf_kind(tt, element_ty)
      let insts = ir_inst_list_prepend(
        ir_inst_call_i64(source_data, pipeline_rc_array_storage_data_hash(), ir_value_list_prepend(value, ir_value_list_empty())),
        ir_inst_list_prepend(
          ir_inst_array_copy_i64(address, source_data, byte_size, leaf_count, leaf_stride, leaf_kind),
          ir_inst_list_prepend(ir_inst_const_i64(result, 0), ir_inst_list_empty())
        )
      )
      ir_lowered_expr(result, result + 1, insts)
    } else { if ty_is_array(element_ty) and pipeline_array_literal_layout_is_valid(tt, element_ty, ty_array_length(element_ty)) == 1 and load == 1 {
      let storage = pipeline_lower_array_literal_storage(element_ty, ty_array_length(element_ty), next_value, tt)
      if ir_lowered_expr_is_valid(storage) == 0 { ir_lowered_expr_invalid(next_value) }
      else {
        let data = ir_lowered_expr_next_value(storage) - 1
        let copy = ir_inst_list_prepend(
          ir_inst_array_copy_i64(data, address, cg_layout_array_size(tt, element_ty), cg_layout_array_leaf_count(element_ty), pipeline_array_literal_leaf_stride(tt, element_ty), pipeline_array_literal_leaf_kind(tt, element_ty)),
          ir_inst_list_empty()
        )
        ir_lowered_expr(ir_lowered_expr_value(storage), ir_lowered_expr_next_value(storage), ir_inst_list_append(ir_lowered_expr_insts(storage), copy))
      }
    } else { if not ty_is_record(element_ty) or pipeline_type_managed_release_lane_count(element_ty) > 0 {
      ir_lowered_expr_invalid(next_value)
    } else { if store == 1 {
      let value = pipeline_ir_value_list_get_or(values, 3, 0 - 1)
      let stored = pipeline_lower_indexed_structural_store_value(address, value, 0, element_ty, next_value, tt)
      if pipeline_lowered_args_is_valid(stored) == 0 { ir_lowered_expr_invalid(next_value) }
      else {
        let result = pipeline_lowered_args_next_value(stored)
        let zero_insts = ir_inst_list_prepend(ir_inst_const_i64(result, 0), ir_inst_list_empty())
        ir_lowered_expr(result, result + 1, ir_inst_list_append(pipeline_lowered_args_insts(stored), zero_insts))
      }
    } else { if load == 1 {
      pipeline_lower_indexed_structural_record_value(address, element_ty, next_value, tt)
    } else {
      ir_lowered_expr_invalid(next_value)
    } } } } }
  }
}

pub(package) fn pipeline_lower_indexed_structural_record_value(address: i64, element_ty: i64, next_value: i64, tt: i64) -> IrLoweredExpr {
  let lanes = pipeline_type_value_lane_count_or_one(element_ty)
  if not ty_is_record(element_ty) { ir_lowered_expr_invalid(next_value) }
  else {
    let plan = pipeline_lower_indexed_structural_load_value(address, next_value, 0, element_ty, next_value + lanes, tt)
    if pipeline_lowered_args_is_valid(plan) == 0 { ir_lowered_expr_invalid(next_value) }
    else {
      -- Indexed storage keeps its own deep-cleanup stakes. A structural read
      -- therefore owns a fresh stake for each managed result lane, just as a
      -- scalar indexed read does for its one lane.
      let retain = pipeline_managed_retain_inst_list_with_origin(
        next_value, element_ty, pipeline_lowered_args_next_value(plan), ir_managed_stake_origin_aggregate()
      )
      ir_lowered_expr(
        next_value,
        pipeline_lowered_args_next_value(plan) + ir_inst_list_len(retain),
        ir_inst_list_append(pipeline_lowered_args_insts(plan), retain)
      )
    }
  }
}

-- Consume only checker-produced indexed-storage facts. The runtime boundary
-- owns the unsigned bounds check and canonical panic; layout, ownership, and
-- nested-array value copying stay explicit in typed lowering.
pub(package) fn pipeline_lower_indexed_get_after_values_typed_with_release(element_ty: i64, fixed_len: i64, base_value: i64, index_value: i64, next_value: i64, release_base: i64, address_hash: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let concrete_element_ty = ty_subst(element_ty, pipeline_handler_lower_ctx_subst(lower_ctx))
  let stride = pipeline_indexed_element_stride(tt, concrete_element_ty)
  let size = cg_layout_indexed_element_size(tt, concrete_element_ty)
  if stride <= 0 or size <= 0 { ir_lowered_expr_invalid(next_value) }
  else {
    let data_value = if fixed_len < 0 { base_value } else { next_value }
    let data_insts = if fixed_len < 0 { ir_inst_list_empty() }
      else { ir_inst_list_prepend(ir_inst_call_i64(data_value, pipeline_rc_array_storage_data_hash(), ir_value_list_prepend(base_value, ir_value_list_empty())), ir_inst_list_empty()) }
    let after_data = if fixed_len < 0 { next_value } else { next_value + 1 }
    let len_value = if fixed_len < 0 { base_value + 1 } else { after_data }
    let len_insts = if fixed_len < 0 { ir_inst_list_empty() }
      else { ir_inst_list_prepend(ir_inst_const_i64(len_value, fixed_len), ir_inst_list_empty()) }
    let after_len = if fixed_len < 0 { after_data } else { after_data + 1 }
    let stride_value = after_len
    let address = stride_value + 1
    let address_insts = ir_inst_list_prepend(
      ir_inst_const_i64(stride_value, stride),
      ir_inst_list_prepend(ir_inst_call_i64(address, address_hash, pipeline_index_address_args(data_value, len_value, index_value, stride_value)), ir_inst_list_empty())
    )
    let after_address = address + 1
    let loaded = if ty_is_array(concrete_element_ty) {
      let storage = pipeline_lower_array_literal_storage(concrete_element_ty, ty_array_length(concrete_element_ty), after_address, tt)
      if ir_lowered_expr_is_valid(storage) == 0 { ir_lowered_expr_invalid(after_address) }
      else {
        let leaf_count = cg_layout_array_leaf_count(concrete_element_ty)
        let leaf_stride = pipeline_array_literal_leaf_stride(tt, concrete_element_ty)
        let leaf_kind = pipeline_array_literal_leaf_kind(tt, concrete_element_ty)
        if pipeline_array_copy_plan_is_valid(size, leaf_count, leaf_stride, leaf_kind) == 0 { ir_lowered_expr_invalid(after_address) }
        else {
          let dest_data = ir_lowered_expr_next_value(storage) - 1
          let copy = ir_inst_list_prepend(ir_inst_array_copy_i64(dest_data, address, size, leaf_count, leaf_stride, leaf_kind), ir_inst_list_empty())
          ir_lowered_expr(ir_lowered_expr_value(storage), ir_lowered_expr_next_value(storage), ir_inst_list_append(ir_lowered_expr_insts(storage), copy))
        }
      }
    } else { if ty_is_slice(concrete_element_ty) {
      pipeline_lower_indexed_slice_value(address, after_address)
    } else { if ty_is_record(concrete_element_ty) {
      pipeline_lower_indexed_structural_record_value(address, concrete_element_ty, after_address, tt)
    } else { if cg_layout_vector_record_inline_eligible(tt, concrete_element_ty) == 1 {
      let size_value = after_address
      let mode_value = size_value + 1
      let result = mode_value + 1
      let type_args = nlist_new_capacity(1)
      nlist_add(type_args, concrete_element_ty)
      let load_args = ir_value_list_prepend(address, ir_value_list_prepend(size_value, ir_value_list_prepend(mode_value, ir_value_list_empty())))
      let load = ir_inst_list_prepend(
        ir_inst_const_i64(size_value, size),
        ir_inst_list_prepend(
          ir_inst_const_i64(mode_value, cg_layout_indexed_element_mode(tt, concrete_element_ty)),
          ir_inst_list_prepend(ir_inst_generic_call_i64(result, pipeline_ir_native_vector_storage_load_value_in_bounds_hash(), type_args, load_args), ir_inst_list_empty())
        )
      )
      ir_lowered_expr(result, result + 1, load)
    } else {
      let size_value = after_address
      let mode_value = size_value + 1
      let result = mode_value + 1
      let load_args = ir_value_list_prepend(address, ir_value_list_prepend(size_value, ir_value_list_prepend(mode_value, ir_value_list_empty())))
      let load = ir_inst_list_prepend(
        ir_inst_const_i64(size_value, size),
        ir_inst_list_prepend(
          ir_inst_const_i64(mode_value, cg_layout_indexed_element_mode(tt, concrete_element_ty)),
          ir_inst_list_prepend(ir_inst_call_i64(result, pipeline_ir_native_intrinsic_mem_load_sized_hash(), load_args), ir_inst_list_empty())
        )
      )
      let retain = pipeline_managed_retain_inst_list_with_origin(result, concrete_element_ty, result + 1, ir_managed_stake_origin_aggregate())
      let after_retain = result + 1 + ir_inst_list_len(retain)
      ir_lowered_expr(result, after_retain, ir_inst_list_append(load, retain))
    } } } }
    if ir_lowered_expr_is_valid(loaded) == 0 { loaded }
    else {
      let release_dst = ir_lowered_expr_next_value(loaded)
      let release = if release_base == 1 {
        ir_inst_list_prepend(pipeline_managed_release_inst_with_origin(release_dst, base_value, continuation_cleanup_kind_rc(), ir_managed_stake_origin_aggregate()), ir_inst_list_empty())
      } else { ir_inst_list_empty() }
      let next = if release_base == 1 { release_dst + 1 } else { release_dst }
      let prefix = ir_inst_list_append(data_insts, ir_inst_list_append(len_insts, address_insts))
      ir_lowered_expr(ir_lowered_expr_value(loaded), next, ir_inst_list_append(prefix, ir_inst_list_append(ir_lowered_expr_insts(loaded), release)))
    }
  }
}

pub(package) fn pipeline_lower_indexed_get_after_values_typed(base_expr: Expr, index_expr: Expr, element_ty: i64, fixed_len: i64, base_value: i64, index_value: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let borrowed_base = if fixed_len < 0 { 1 }
    else { pipeline_array_expr_result_is_borrowed_typed(base_expr, pipeline_handler_lower_ctx_src(lower_ctx), pipeline_handler_lower_ctx_fns(lower_ctx), pipeline_handler_lower_ctx_subst(lower_ctx), pipeline_handler_lower_ctx_tt(lower_ctx)) }
  pipeline_lower_indexed_get_after_values_typed_with_release(element_ty, fixed_len, base_value, index_value, next_value, if borrowed_base == 0 { 1 } else { 0 }, pipeline_runtime_index_address_hash(), lower_ctx)
}

pub(package) fn pipeline_lower_indexed_get_expr_typed_sidecar_handler_opt(base_expr: Expr, index_expr: Expr, element_ty: i64, fixed_len: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let base = pipeline_lower_expr_typed_sidecar_handler_ctx(base_expr, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(base) == 0 { ir_lowered_expr_invalid(next_value) }
  else {
    let index = pipeline_lower_expr_typed_sidecar_handler_ctx(index_expr, ir_lowered_expr_next_value(base), lower_ctx)
    if ir_lowered_expr_is_valid(index) == 0 { ir_lowered_expr_invalid(next_value) }
    else {
      let loaded = pipeline_lower_indexed_get_after_values_typed(base_expr, index_expr, element_ty, fixed_len, ir_lowered_expr_value(base), ir_lowered_expr_value(index), ir_lowered_expr_next_value(index), lower_ctx)
      ir_lowered_expr(ir_lowered_expr_value(loaded), ir_lowered_expr_next_value(loaded), ir_inst_list_append(ir_lowered_expr_insts(base), ir_inst_list_append(ir_lowered_expr_insts(index), ir_lowered_expr_insts(loaded))))
    }
  }
}

pub(package) fn pipeline_lower_indexed_get_typed_to_target_blocks(base_expr: Expr, index_expr: Expr, element_ty: i64, fixed_len: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  if pipeline_expr_needs_lowering_cfg_typed(base_expr, pipeline_lower_module_src(module)) == 0 and pipeline_expr_needs_lowering_cfg_typed(index_expr, pipeline_lower_module_src(module)) == 0 {
    pipeline_lower_straight_expr_typed_to_target_blocks(IndexedGet(base_expr, index_expr, element_ty, fixed_len), params, locals, module, next_value, start_block, next_block, target_block)
  } else {
    let base_merge_block = next_block
    let base_blocks = pipeline_lower_expr_typed_to_target_blocks_reserved(base_expr, params, locals, module, next_value, start_block, next_block + 1, base_merge_block)
    if pipeline_lowered_blocks_is_valid(base_blocks) == 0 { pipeline_lowered_blocks_invalid(start_block, next_value) }
    else { if pipeline_lowered_blocks_falls_through(base_blocks) == 0 { base_blocks }
    else {
      let base_value = pipeline_lowered_blocks_next_value(base_blocks)
      let base_lanes = if fixed_len < 0 { 2 } else { 1 }
      let index_start = pipeline_lowered_blocks_next_block(base_blocks)
      let index_merge_block = index_start + 1
      let index_blocks = pipeline_lower_expr_typed_to_target_blocks_reserved(index_expr, params, locals, module, base_value + base_lanes, index_start, index_start + 2, index_merge_block)
      let base_merge = ir_block_new_params(base_merge_block, pipeline_ir_value_lane_ids(base_value, 0, base_lanes), ir_inst_list_empty(), ir_term_jump(index_start))
      if pipeline_lowered_blocks_is_valid(index_blocks) == 0 { pipeline_lowered_blocks_invalid(start_block, next_value) }
      else { if pipeline_lowered_blocks_falls_through(index_blocks) == 0 {
        pipeline_lowered_blocks_control(pipeline_lowered_blocks_next_block(index_blocks), pipeline_lowered_blocks_next_value(index_blocks), ir_block_list_append(pipeline_lowered_blocks_blocks(base_blocks), ir_block_list_prepend(base_merge, pipeline_lowered_blocks_blocks(index_blocks))), 1, 0)
      } else {
        let index_value = pipeline_lowered_blocks_next_value(index_blocks)
        let loaded = pipeline_lower_indexed_get_after_values_typed(base_expr, index_expr, element_ty, fixed_len, base_value, index_value, index_value + 1, pipeline_handler_lower_ctx_from_module(params, locals, module))
        let result_lanes = pipeline_type_value_lane_count_or_one(ty_subst(element_ty, pipeline_lower_module_subst(module)))
        let result_args = pipeline_ir_value_lane_ids(ir_lowered_expr_value(loaded), 0, result_lanes)
        let merge = ir_block_new_params(index_merge_block, ir_value_list_prepend(index_value, ir_value_list_empty()), ir_lowered_expr_insts(loaded), ir_term_jump_args(target_block, result_args))
        let blocks = ir_block_list_append(pipeline_lowered_blocks_blocks(base_blocks), ir_block_list_prepend(base_merge, ir_block_list_append(pipeline_lowered_blocks_blocks(index_blocks), ir_block_list_prepend(merge, ir_block_list_empty()))))
        pipeline_lowered_blocks(pipeline_lowered_blocks_next_block(index_blocks), ir_lowered_expr_next_value(loaded), blocks, 1)
      } }
    } }
  }
}

pub(package) fn pipeline_indexed_set_fact_element_ty(fact: i64) -> i64 {
  if fact == 0 { 0 } else { node_f1(fact) }
}

pub(package) fn pipeline_indexed_set_fact_fixed_len(fact: i64) -> i64 {
  if fact == 0 { 0 - 2 } else { node_f2(fact) }
}

pub(package) fn pipeline_indexed_set_fact_base_ty(fact: i64) -> i64 {
  if fact == 0 { 0 } else { node_f3(fact) }
}

pub(package) fn pipeline_lower_indexed_scalar_overwrite(value_expr: Expr, element_ty: i64, address: i64, value: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let size = cg_layout_indexed_element_size(tt, element_ty)
  if size <= 0 { ir_lowered_expr_invalid(next_value) }
  else { if cg_layout_vector_record_inline_eligible(tt, element_ty) == 1 {
    let size_value = next_value
    let mode_value = size_value + 1
    let store_dst = mode_value + 1
    let type_args = nlist_new_capacity(1)
    nlist_add(type_args, element_ty)
    let store_args = ir_value_list_prepend(address, ir_value_list_prepend(size_value, ir_value_list_prepend(mode_value, ir_value_list_prepend(value, ir_value_list_empty()))))
    let borrowed = pipeline_expr_result_is_borrowed_for_ty_typed(value_expr, element_ty, pipeline_handler_lower_ctx_src(lower_ctx), pipeline_handler_lower_ctx_fns(lower_ctx), pipeline_handler_lower_ctx_subst(lower_ctx), tt)
    let release = if borrowed == 0 {
      ir_inst_list_prepend(pipeline_managed_release_inst_with_origin(store_dst + 1, value, continuation_cleanup_kind_rc(), ir_managed_stake_origin_aggregate()), ir_inst_list_empty())
    } else { ir_inst_list_empty() }
    let nil_value = if borrowed == 0 { store_dst + 2 } else { store_dst + 1 }
    let insts = ir_inst_list_prepend(
      ir_inst_const_i64(size_value, size),
      ir_inst_list_prepend(
        ir_inst_const_i64(mode_value, cg_layout_indexed_element_mode(tt, element_ty)),
        ir_inst_list_prepend(
          ir_inst_generic_call_i64(store_dst, pipeline_ir_native_vector_storage_store_value_hash(), type_args, store_args),
          ir_inst_list_append(release, ir_inst_list_prepend(ir_inst_const_i64(nil_value, 0), ir_inst_list_empty()))
        )
      )
    )
    ir_lowered_expr(nil_value, nil_value + 1, insts)
  } else {
    let mut insts = ir_inst_list_empty()
    let mut cursor = next_value
    let size_value = cursor
    cursor = cursor + 1
    let mode_value = cursor
    cursor = cursor + 1
    insts = ir_inst_list_append(insts, ir_inst_list_prepend(ir_inst_const_i64(size_value, size), ir_inst_list_prepend(ir_inst_const_i64(mode_value, cg_layout_indexed_element_mode(tt, element_ty)), ir_inst_list_empty())))
    let drop_kind = cg_managed_drop_kind_for_ty(element_ty)
    let retain_hash = pipeline_managed_retain_hash_for_kind(drop_kind)
    let release_hash = pipeline_managed_release_hash_for_kind(drop_kind)
    if retain_hash != 0 {
      insts = ir_inst_list_append(insts, ir_inst_list_prepend(pipeline_managed_retain_inst_with_origin(cursor, value, drop_kind, ir_managed_stake_origin_aggregate()), ir_inst_list_empty()))
      cursor = cursor + 1
    } else { 0 }
    let old_value = cursor
    if release_hash != 0 {
      let load_args = ir_value_list_prepend(address, ir_value_list_prepend(size_value, ir_value_list_prepend(mode_value, ir_value_list_empty())))
      insts = ir_inst_list_append(insts, ir_inst_list_prepend(ir_inst_call_i64(old_value, pipeline_ir_native_intrinsic_mem_load_sized_hash(), load_args), ir_inst_list_empty()))
      cursor = cursor + 1
    } else { 0 }
    let store_args = ir_value_list_prepend(address, ir_value_list_prepend(size_value, ir_value_list_prepend(mode_value, ir_value_list_prepend(value, ir_value_list_empty()))))
    insts = ir_inst_list_append(insts, ir_inst_list_prepend(ir_inst_call_i64(cursor, pipeline_ir_native_intrinsic_mem_store_sized_hash(), store_args), ir_inst_list_empty()))
    cursor = cursor + 1
    if release_hash != 0 {
      insts = ir_inst_list_append(insts, ir_inst_list_prepend(pipeline_managed_release_inst_with_origin(cursor, old_value, drop_kind, ir_managed_stake_origin_aggregate()), ir_inst_list_empty()))
      cursor = cursor + 1
      let borrowed = pipeline_expr_result_is_borrowed_for_ty_typed(value_expr, element_ty, pipeline_handler_lower_ctx_src(lower_ctx), pipeline_handler_lower_ctx_fns(lower_ctx), pipeline_handler_lower_ctx_subst(lower_ctx), tt)
      if borrowed == 0 {
        insts = ir_inst_list_append(insts, ir_inst_list_prepend(pipeline_managed_release_inst_with_origin(cursor, value, drop_kind, ir_managed_stake_origin_aggregate()), ir_inst_list_empty()))
        cursor = cursor + 1
      } else { 0 }
    } else { 0 }
    let nil_value = cursor
    insts = ir_inst_list_append(insts, ir_inst_list_prepend(ir_inst_const_i64(nil_value, 0), ir_inst_list_empty()))
    ir_lowered_expr(nil_value, nil_value + 1, insts)
  } }
}

pub(package) fn pipeline_lower_indexed_slice_overwrite(address: i64, value: i64, next_value: i64) -> IrLoweredExpr {
  let lane_offset = next_value
  let second_address = lane_offset + 1
  let lane_size = second_address + 1
  let lane_mode = lane_size + 1
  let first_store = lane_mode + 1
  let second_store = first_store + 1
  let nil_value = second_store + 1
  let first_args = ir_value_list_prepend(address, ir_value_list_prepend(lane_size, ir_value_list_prepend(lane_mode, ir_value_list_prepend(value, ir_value_list_empty()))))
  let second_args = ir_value_list_prepend(second_address, ir_value_list_prepend(lane_size, ir_value_list_prepend(lane_mode, ir_value_list_prepend(value + 1, ir_value_list_empty()))))
  let insts = ir_inst_list_prepend(
    ir_inst_const_i64(lane_offset, 8),
    ir_inst_list_prepend(
      ir_inst_binary_i64(second_address, ir_binary_op_add(), address, lane_offset),
      ir_inst_list_prepend(
        ir_inst_const_i64(lane_size, 8),
        ir_inst_list_prepend(
          ir_inst_const_i64(lane_mode, 0),
          ir_inst_list_prepend(
            ir_inst_call_i64(first_store, pipeline_ir_native_intrinsic_mem_store_sized_hash(), first_args),
            ir_inst_list_prepend(
              ir_inst_call_i64(second_store, pipeline_ir_native_intrinsic_mem_store_sized_hash(), second_args),
              ir_inst_list_prepend(ir_inst_const_i64(nil_value, 0), ir_inst_list_empty())
            )
          )
        )
      )
    )
  )
  ir_lowered_expr(nil_value, nil_value + 1, insts)
}

pub(package) fn pipeline_lower_indexed_array_overwrite(value_expr: Expr, element_ty: i64, address: i64, value: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let size = cg_layout_storage_size(tt, element_ty)
  let leaf_count = cg_layout_array_leaf_count(element_ty)
  let leaf_stride = pipeline_array_literal_leaf_stride(tt, element_ty)
  let leaf_kind = pipeline_array_literal_leaf_kind(tt, element_ty)
  if pipeline_array_copy_plan_is_valid(size, leaf_count, leaf_stride, leaf_kind) == 0 { ir_lowered_expr_invalid(next_value) }
  else {
    let src_data = next_value
    let after_copy = src_data + 1
    let borrowed = pipeline_array_expr_result_is_borrowed_typed(value_expr, pipeline_handler_lower_ctx_src(lower_ctx), pipeline_handler_lower_ctx_fns(lower_ctx), pipeline_handler_lower_ctx_subst(lower_ctx), tt)
    let release = if borrowed == 0 {
      ir_inst_list_prepend(pipeline_managed_release_inst_with_origin(after_copy, value, continuation_cleanup_kind_rc(), ir_managed_stake_origin_aggregate()), ir_inst_list_empty())
    } else { ir_inst_list_empty() }
    let nil_value = if borrowed == 0 { after_copy + 1 } else { after_copy }
    let insts = ir_inst_list_prepend(
      ir_inst_call_i64(src_data, pipeline_rc_array_storage_data_hash(), ir_value_list_prepend(value, ir_value_list_empty())),
      ir_inst_list_prepend(
        ir_inst_array_drop_i64(address, leaf_count, leaf_stride, leaf_kind),
        ir_inst_list_prepend(
          ir_inst_array_copy_i64(address, src_data, size, leaf_count, leaf_stride, leaf_kind),
          ir_inst_list_append(release, ir_inst_list_prepend(ir_inst_const_i64(nil_value, 0), ir_inst_list_empty()))
        )
      )
    )
    ir_lowered_expr(nil_value, nil_value + 1, insts)
  }
}

pub(package) fn pipeline_lower_indexed_overwrite(value_expr: Expr, element_ty: i64, address: i64, value: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  if ty_is_array(element_ty) { pipeline_lower_indexed_array_overwrite(value_expr, element_ty, address, value, next_value, lower_ctx) }
  else { if ty_is_slice(element_ty) { pipeline_lower_indexed_slice_overwrite(address, value, next_value) }
  else { pipeline_lower_indexed_scalar_overwrite(value_expr, element_ty, address, value, next_value, lower_ctx) } }
}

pub(package) fn pipeline_lower_indexed_set_after_values_typed(base_expr: Expr, index_expr: Expr, value_expr: Expr, fact: i64, base_value: i64, index_value: i64, value: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  let element_ty = ty_subst(pipeline_indexed_set_fact_element_ty(fact), subst)
  let base_ty = ty_subst(pipeline_indexed_set_fact_base_ty(fact), subst)
  let fixed_len = pipeline_indexed_set_fact_fixed_len(fact)
  let stride = pipeline_indexed_element_stride(tt, element_ty)
  if fact == 0 or stride <= 0 { ir_lowered_expr_invalid(next_value) }
  else {
    let mut prefix = ir_inst_list_empty()
    let mut cursor = next_value
    let mut data = base_value
    let mut active_storage = base_value
    if fixed_len >= 0 {
      let storage = pipeline_lower_array_literal_storage(base_ty, fixed_len, cursor, tt)
      if ir_lowered_expr_is_valid(storage) == 0 { return ir_lowered_expr_invalid(next_value) }
      active_storage = ir_lowered_expr_value(storage)
      data = ir_lowered_expr_next_value(storage) - 1
      cursor = ir_lowered_expr_next_value(storage)
      let old_data = cursor
      cursor = cursor + 1
      let total_size = cg_layout_storage_size(tt, base_ty)
      let leaf_count = cg_layout_array_leaf_count(base_ty)
      let leaf_stride = pipeline_array_literal_leaf_stride(tt, base_ty)
      let leaf_kind = pipeline_array_literal_leaf_kind(tt, base_ty)
      if pipeline_array_copy_plan_is_valid(total_size, leaf_count, leaf_stride, leaf_kind) == 0 { return ir_lowered_expr_invalid(next_value) }
      let copy = ir_inst_list_prepend(
        ir_inst_call_i64(old_data, pipeline_rc_array_storage_data_hash(), ir_value_list_prepend(base_value, ir_value_list_empty())),
        ir_inst_list_prepend(ir_inst_array_copy_i64(data, old_data, total_size, leaf_count, leaf_stride, leaf_kind), ir_inst_list_empty())
      )
      prefix = ir_inst_list_append(ir_lowered_expr_insts(storage), copy)
    } else { 0 }
    let len_value = if fixed_len < 0 { base_value + 1 } else { cursor }
    if fixed_len >= 0 {
      prefix = ir_inst_list_append(prefix, ir_inst_list_prepend(ir_inst_const_i64(len_value, fixed_len), ir_inst_list_empty()))
      cursor = cursor + 1
    } else { 0 }
    let stride_value = cursor
    let address = stride_value + 1
    cursor = address + 1
    prefix = ir_inst_list_append(prefix, ir_inst_list_prepend(
      ir_inst_const_i64(stride_value, stride),
      ir_inst_list_prepend(ir_inst_call_i64(address, pipeline_runtime_index_address_hash(), pipeline_index_address_args(data, len_value, index_value, stride_value)), ir_inst_list_empty())
    ))
    let overwritten = pipeline_lower_indexed_overwrite(value_expr, element_ty, address, value, cursor, lower_ctx)
    if ir_lowered_expr_is_valid(overwritten) == 0 { overwritten }
    else {
      let mut post = ir_inst_list_empty()
      let mut after = ir_lowered_expr_next_value(overwritten)
      if fixed_len >= 0 {
        match base_expr {
          Ident(ns, nl) -> {
            let slot = pipeline_value_env_lookup(pipeline_handler_lower_ctx_locals(lower_ctx), pipeline_handler_lower_ctx_src(lower_ctx), ns, nl)
            if slot < 0 { return ir_lowered_expr_invalid(next_value) }
            post = ir_inst_list_prepend(
              ir_inst_store_i64(slot, active_storage),
              ir_inst_list_prepend(pipeline_managed_release_inst_with_origin(after, base_value, continuation_cleanup_kind_rc(), ir_managed_stake_origin_aggregate()), ir_inst_list_empty())
            )
            after = after + 1
          }
          _ -> return ir_lowered_expr_invalid(next_value)
        }
      } else { 0 }
      ir_lowered_expr(ir_lowered_expr_value(overwritten), after, ir_inst_list_append(prefix, ir_inst_list_append(ir_lowered_expr_insts(overwritten), post)))
    }
  }
}

pub(package) fn pipeline_lower_indexed_set_expr_typed_sidecar_handler_opt(base_expr: Expr, index_expr: Expr, value_expr: Expr, fact: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let base = pipeline_lower_expr_typed_sidecar_handler_ctx(base_expr, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(base) == 0 { ir_lowered_expr_invalid(next_value) }
  else {
    let index = pipeline_lower_expr_typed_sidecar_handler_ctx(index_expr, ir_lowered_expr_next_value(base), lower_ctx)
    if ir_lowered_expr_is_valid(index) == 0 { ir_lowered_expr_invalid(next_value) }
    else {
      let element_ty = ty_subst(pipeline_indexed_set_fact_element_ty(fact), pipeline_handler_lower_ctx_subst(lower_ctx))
      let prim = pipeline_type_node_prim_id_or(element_ty, 0)
      let value = if pipeline_prim_is_forced_numeric_context(prim) == 1 {
        pipeline_lower_expr_typed_sidecar_handler_opt_with_float_prim(value_expr, ir_lowered_expr_next_value(index), lower_ctx, prim)
      } else { pipeline_lower_expr_typed_sidecar_handler_ctx(value_expr, ir_lowered_expr_next_value(index), lower_ctx) }
      if ir_lowered_expr_is_valid(value) == 0 { ir_lowered_expr_invalid(next_value) }
      else {
        let set = pipeline_lower_indexed_set_after_values_typed(base_expr, index_expr, value_expr, fact, ir_lowered_expr_value(base), ir_lowered_expr_value(index), ir_lowered_expr_value(value), ir_lowered_expr_next_value(value), lower_ctx)
        ir_lowered_expr(ir_lowered_expr_value(set), ir_lowered_expr_next_value(set), ir_inst_list_append(ir_lowered_expr_insts(base), ir_inst_list_append(ir_lowered_expr_insts(index), ir_inst_list_append(ir_lowered_expr_insts(value), ir_lowered_expr_insts(set)))))
      }
    }
  }
}

pub(package) fn pipeline_lower_indexed_set_typed_to_target_blocks(base_expr: Expr, index_expr: Expr, value_expr: Expr, fact: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  if pipeline_expr_needs_lowering_cfg_typed(index_expr, pipeline_lower_module_src(module)) == 0 and pipeline_expr_needs_lowering_cfg_typed(value_expr, pipeline_lower_module_src(module)) == 0 {
    pipeline_lower_straight_expr_typed_to_target_blocks(IndexedSet(base_expr, index_expr, value_expr, fact), params, locals, module, next_value, start_block, next_block, target_block)
  } else {
    let lower_ctx = pipeline_handler_lower_ctx_from_module(params, locals, module)
    let base = pipeline_lower_expr_typed_sidecar_handler_ctx(base_expr, next_value, lower_ctx)
    if ir_lowered_expr_is_valid(base) == 0 { pipeline_lowered_blocks_invalid(start_block, next_value) }
    else {
      let index_start = next_block
      let index_merge_block = index_start + 1
      let index_blocks = pipeline_lower_expr_typed_to_target_blocks_reserved(index_expr, params, locals, module, ir_lowered_expr_next_value(base), index_start, index_start + 2, index_merge_block)
      let entry = ir_block_new_term(start_block, ir_lowered_expr_insts(base), ir_term_jump(index_start))
      if pipeline_lowered_blocks_is_valid(index_blocks) == 0 { pipeline_lowered_blocks_invalid(start_block, next_value) }
      else { if pipeline_lowered_blocks_falls_through(index_blocks) == 0 {
        pipeline_lowered_blocks_control(pipeline_lowered_blocks_next_block(index_blocks), pipeline_lowered_blocks_next_value(index_blocks), ir_block_list_prepend(entry, pipeline_lowered_blocks_blocks(index_blocks)), 1, 0)
      } else {
        let index_value = pipeline_lowered_blocks_next_value(index_blocks)
        let value_start = pipeline_lowered_blocks_next_block(index_blocks)
        let value_merge_block = value_start + 1
        let element_ty = ty_subst(pipeline_indexed_set_fact_element_ty(fact), pipeline_lower_module_subst(module))
        let prim = pipeline_type_node_prim_id_or(element_ty, 0)
        let value_blocks = pipeline_lower_expr_typed_to_target_blocks_reserved_with_float(value_expr, params, locals, module, index_value + 1, value_start, value_start + 2, value_merge_block, prim)
        let index_merge = ir_block_new_params(index_merge_block, ir_value_list_prepend(index_value, ir_value_list_empty()), ir_inst_list_empty(), ir_term_jump(value_start))
        if pipeline_lowered_blocks_is_valid(value_blocks) == 0 { pipeline_lowered_blocks_invalid(start_block, next_value) }
        else { if pipeline_lowered_blocks_falls_through(value_blocks) == 0 {
          let blocks = ir_block_list_prepend(entry, ir_block_list_append(pipeline_lowered_blocks_blocks(index_blocks), ir_block_list_prepend(index_merge, pipeline_lowered_blocks_blocks(value_blocks))))
          pipeline_lowered_blocks_control(pipeline_lowered_blocks_next_block(value_blocks), pipeline_lowered_blocks_next_value(value_blocks), blocks, 1, 0)
        } else {
          let value_head = pipeline_lowered_blocks_next_value(value_blocks)
          let value_lanes = pipeline_expr_value_lane_count(value_expr, params, locals, module)
          let set = pipeline_lower_indexed_set_after_values_typed(base_expr, index_expr, value_expr, fact, ir_lowered_expr_value(base), index_value, value_head, value_head + value_lanes, lower_ctx)
          let value_merge = ir_block_new_params(value_merge_block, pipeline_ir_value_lane_ids(value_head, 0, value_lanes), ir_lowered_expr_insts(set), ir_term_jump_args(target_block, ir_value_list_prepend(ir_lowered_expr_value(set), ir_value_list_empty())))
          let blocks = ir_block_list_prepend(entry, ir_block_list_append(pipeline_lowered_blocks_blocks(index_blocks), ir_block_list_prepend(index_merge, ir_block_list_append(pipeline_lowered_blocks_blocks(value_blocks), ir_block_list_prepend(value_merge, ir_block_list_empty())))))
          pipeline_lowered_blocks(pipeline_lowered_blocks_next_block(value_blocks), ir_lowered_expr_next_value(set), blocks, 1)
        } }
      } }
    }
  }
}

pub(package) fn pipeline_lower_opt_chain_expr_typed_sidecar_handler_opt(base_expr: Expr, field_ns: i64, field_nl: i64, effect_atom: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let handlers = pipeline_handler_lower_ctx_handlers(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  let base = pipeline_lower_expr_typed_sidecar_handler_ctx(base_expr, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(base) == 1 {
    let dst = ir_lowered_expr_next_value(base)
    let effect_key = pipeline_effect_atom_dispatch_key(effect_atom, subst, effect_maybe_head_hash())
    let storage_layout = pipeline_record_storage_layout_for_base(tt, src, base_expr, params, locals, pipeline_handler_lower_ctx_module(lower_ctx))
    let opt = pipeline_ir_opt_chain_insts_for_storage_layout(dst, ir_lowered_expr_value(base), str_hash(src, field_ns, field_nl), pipeline_typed_field_index_for_base(tt, src, field_ns, field_nl, base_expr, params, locals, pipeline_handler_lower_ctx_module(lower_ctx)), effect_key, storage_layout)
    ir_lowered_expr(dst, dst + 1, ir_inst_list_append(ir_lowered_expr_insts(base), opt))
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

pub(package) fn pipeline_lower_try_expr_typed_sidecar_handler_opt(inner_expr: Expr, effect_atom: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let handlers = pipeline_handler_lower_ctx_handlers(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  let value = pipeline_lower_expr_typed_sidecar_handler_ctx(inner_expr, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(value) == 1 {
    let dst = ir_lowered_expr_next_value(value)
    let effect_key = pipeline_effect_atom_dispatch_key(effect_atom, subst, effect_fail_head_hash())
    let inner_ty = pipeline_return_expr_type_node_typed(inner_expr, params, locals, pipeline_handler_lower_ctx_module(lower_ctx))
    let try_value_inst = pipeline_try_inst_for_type(dst, ir_lowered_expr_value(value), effect_key, inner_ty, tt)
    let result_lanes = pipeline_try_success_lane_count(inner_ty)
    let try_insts = pipeline_try_insts(
      try_value_inst, dst, ir_lowered_expr_value(value), result_lanes
    )
    let after_try = if ir_inst_tag(try_value_inst) == 54 {
      pipeline_try_inst_next_value(try_value_inst, dst)
    } else { dst + result_lanes }
    ir_lowered_expr(dst, after_try, ir_inst_list_append(ir_lowered_expr_insts(value), try_insts))
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

pub(package) fn pipeline_lower_interp_concat_expr_typed_sidecar_handler_opt(left_expr: Expr, right_expr: Expr, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let handlers = pipeline_handler_lower_ctx_handlers(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  let left = pipeline_lower_expr_typed_sidecar_handler_ctx(left_expr, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(left) == 1 {
    let right = pipeline_lower_expr_typed_sidecar_handler_ctx(right_expr, ir_lowered_expr_next_value(left), lower_ctx)
    if ir_lowered_expr_is_valid(right) == 1 {
      let dst = ir_lowered_expr_next_value(right)
      let concat = ir_inst_list_prepend(ir_inst_string_concat_i64(dst, ir_lowered_expr_value(left), ir_lowered_expr_value(right)), ir_inst_list_empty())
      let insts = ir_inst_list_append(ir_lowered_expr_insts(left), ir_inst_list_append(ir_lowered_expr_insts(right), concat))
      ir_lowered_expr(dst, dst + 1, insts)
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

pub(package) fn pipeline_lower_if_expr_typed_hclause_blocks(cond_expr: Expr, then_expr: Expr, else_expr: Expr, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> PipelineLoweredBlocks {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let handlers = pipeline_handler_lower_ctx_handlers(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  let cond = pipeline_lower_expr_typed_sidecar_handler_ctx(cond_expr, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(cond) == 1 {
    let branch_value_start = ir_lowered_expr_next_value(cond)
    let then_lowered = pipeline_lower_expr_typed_sidecar_handler_ctx(then_expr, branch_value_start, lower_ctx)
    let else_lowered = pipeline_lower_expr_typed_sidecar_handler_ctx(else_expr, branch_value_start, lower_ctx)
    if ir_lowered_expr_is_valid(then_lowered) == 1 and ir_lowered_expr_is_valid(else_lowered) == 1 {
      let result_value = pipeline_ir_max_i64(ir_lowered_expr_next_value(then_lowered), ir_lowered_expr_next_value(else_lowered))
      let entry = ir_block_new_term(0, ir_lowered_expr_insts(cond), ir_term_branch(ir_lowered_expr_value(cond), 1, 2))
      let then_args = ir_value_list_prepend(ir_lowered_expr_value(then_lowered), ir_value_list_empty())
      let then_block = ir_block_new_term(1, ir_lowered_expr_insts(then_lowered), ir_term_jump_args(3, then_args))
      let else_args = ir_value_list_prepend(ir_lowered_expr_value(else_lowered), ir_value_list_empty())
      let else_block = ir_block_new_term(2, ir_lowered_expr_insts(else_lowered), ir_term_jump_args(3, else_args))
      let merge_params = ir_value_list_prepend(result_value, ir_value_list_empty())
      let merge = ir_block_new_params(3, merge_params, ir_inst_list_empty(), ir_term_return(result_value))
      let blocks = ir_block_list_prepend(entry, ir_block_list_prepend(then_block, ir_block_list_prepend(else_block, ir_block_list_prepend(merge, ir_block_list_empty()))))
      pipeline_lowered_blocks(4, result_value + 1, blocks, 1)
    } else {
      pipeline_lowered_blocks_invalid(0, next_value)
    }
  } else {
    pipeline_lowered_blocks_invalid(0, next_value)
  }
}

pub(package) fn pipeline_lower_expr_typed_hclause_blocks(body_expr: Expr, next_value: i64, lower_ctx: PipelineHandlerLowerCtx, return_ty: i64, transfers_owned_param: i64) -> PipelineLoweredBlocks {
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let module = pipeline_handler_lower_ctx_module(lower_ctx)
  let return_block = 1
  let lowered = pipeline_lower_expr_typed_to_target_blocks_reserved(body_expr, 0, locals, module, next_value, 0, 2, return_block)
  if pipeline_lowered_blocks_is_valid(lowered) == 1 {
    if pipeline_lowered_blocks_falls_through(lowered) == 1 {
      let return_value = pipeline_lowered_blocks_next_value(lowered)
      let return_lanes = pipeline_type_value_lane_count_or_one(return_ty)
      let return_params = pipeline_ir_value_lane_ids(return_value, 0, return_lanes)
      let transfer = if transfers_owned_param == 1 {
        ir_lowered_expr(return_value, return_value + return_lanes, ir_inst_list_empty())
      } else {
        pipeline_lower_return_transfer_typed_with_ty(
          body_expr,
          return_value,
          return_value + return_lanes,
          pipeline_handler_lower_ctx_params(lower_ctx),
          locals,
          module,
          return_ty
        )
      }
      let return_insts = ir_inst_list_append(ir_lowered_expr_insts(transfer), pipeline_ir_return_lane_insts(ir_lowered_expr_value(transfer), return_ty))
      let return_node = ir_block_new_params(return_block, return_params, return_insts, ir_term_return(ir_lowered_expr_value(transfer)))
      let blocks = ir_block_list_append(
        pipeline_lowered_blocks_blocks(lowered),
        ir_block_list_prepend(return_node, ir_block_list_empty())
      )
      pipeline_lowered_blocks_control(pipeline_lowered_blocks_next_block(lowered), ir_lowered_expr_next_value(transfer), blocks, 1, 0)
    } else {
      lowered
    }
  } else {
    pipeline_lowered_blocks_invalid(0, next_value)
  }
}

pub(package) fn pipeline_lower_let_mut_expr_typed_sidecar_handler_opt_with_float_prim(ns: i64, nl: i64, value_expr: Expr, body_expr: Expr, next_value: i64, lower_ctx: PipelineHandlerLowerCtx, local_float: i64, local_type_node: i64) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let handlers = pipeline_handler_lower_ctx_handlers(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  let value = if pipeline_prim_is_forced_numeric_context(local_float) == 1 {
    pipeline_lower_expr_typed_sidecar_handler_opt_with_float_prim(value_expr, next_value, lower_ctx, local_float)
  } else {
    pipeline_lower_expr_typed_sidecar_handler_ctx(value_expr, next_value, lower_ctx)
  }
  if ir_lowered_expr_is_valid(value) == 1 {
    let address_taken = pipeline_expr_address_of_binding(body_expr, src, ns, nl)
    let slot = if address_taken == 1 {
      pipeline_ir_addressable_slot_id(ir_lowered_expr_next_value(value))
    } else {
      ir_lowered_expr_next_value(value)
    }
    let inferred_float_prim = pipeline_expr_float_prim_typed_temp(value_expr, params, locals, src, tt, pipeline_handler_lower_ctx_fns(lower_ctx), subst)
    let float_prim = if local_float == PRIM_F32() or local_float == PRIM_F64() { local_float } else { inferred_float_prim }
    let inferred_type_hash = pipeline_expr_type_hash_typed_temp(value_expr, params, locals, src, tt, pipeline_handler_lower_ctx_fns(lower_ctx), subst)
    let inferred_type_node = pipeline_init_type_node_typed(value_expr, params, locals, pipeline_handler_lower_ctx_module(lower_ctx))
    let effective_type_node = if local_type_node != 0 { ty_subst(local_type_node, subst) } else { inferred_type_node }
    let local_lanes = pipeline_type_value_lane_count_or_one(effective_type_node)
    let slot_insts = pipeline_ir_slot_lane_init_insts(slot, ir_lowered_expr_value(value), 0, local_lanes)
    let annotated_type_hash = if local_type_node != 0 and effective_type_node != 0 { type_hash_of(effective_type_node) } else { 0 }
    let inferred_node_type_hash = if effective_type_node != 0 { type_hash_of(effective_type_node) } else { 0 }
    let local_type_hash = if annotated_type_hash != 0 { annotated_type_hash } else { if inferred_node_type_hash != 0 { inferred_node_type_hash } else { if local_float != 0 and pipeline_prim_is_numeric_context(local_float) == 1 { pipeline_type_hash_of_prim_id(local_float) } else { pipeline_expr_type_hash_sharpen_int_typed(value_expr, inferred_type_hash, params, locals, src, pipeline_handler_lower_ctx_fns(lower_ctx), subst) } } }
    let retain_insts = if effective_type_node != 0 and pipeline_expr_result_is_borrowed_for_ty_typed(value_expr, effective_type_node, src, pipeline_handler_lower_ctx_fns(lower_ctx), subst, pipeline_handler_lower_ctx_tt(lower_ctx)) == 1 {
      pipeline_managed_retain_inst_list_with_origin(ir_lowered_expr_value(value), effective_type_node, slot + local_lanes, ir_managed_stake_origin_binding())
    } else {
      ir_inst_list_empty()
    }
    let body_next_value = slot + local_lanes + ir_inst_list_len(retain_insts)
    let next_locals = pipeline_value_env_push_slot_float_typed_node(locals, ns, nl, slot, float_prim, local_type_hash, effective_type_node)
    let body_ctx = pipeline_handler_lower_ctx_from_module(params, next_locals, pipeline_handler_lower_ctx_module(lower_ctx))
    let body = pipeline_lower_expr_typed_sidecar_handler_ctx(body_expr, body_next_value, body_ctx)
    if ir_lowered_expr_is_valid(body) == 1 {
      let scope_needs_release = pipeline_let_mut_scope_needs_release(body_expr, src, ns, nl, address_taken, effective_type_node, tt)
      let linear_plan = pipeline_linear_cleanup_plan(tt, effective_type_node)
      let cleanup_insts = if scope_needs_release == 1 { pipeline_slot_cleanup_inst_list_with_plan(slot, effective_type_node, linear_plan, ir_lowered_expr_next_value(body)) } else { ir_inst_list_empty() }
      let after_cleanup = ir_lowered_expr_next_value(body) + ir_inst_list_len(cleanup_insts)
      let bind = ir_inst_list_prepend(ir_inst_bind_typed_i64(ns, nl, slot, effective_type_node), ir_inst_list_empty())
      let rebind_insts = pipeline_ir_structural_slot_rebind_insts(ir_lowered_expr_value(value), slot, linear_plan)
      let insts = ir_inst_list_append(ir_lowered_expr_insts(value), ir_inst_list_append(slot_insts, ir_inst_list_append(retain_insts, ir_inst_list_append(bind, ir_inst_list_append(rebind_insts, ir_inst_list_append(ir_lowered_expr_insts(body), cleanup_insts))))))
      ir_lowered_expr(ir_lowered_expr_value(body), after_cleanup, insts)
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

pub(package) fn pipeline_lower_let_mut_expr_typed_sidecar_handler_opt(ns: i64, nl: i64, value_expr: Expr, body_expr: Expr, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  pipeline_lower_let_mut_expr_typed_sidecar_handler_opt_with_float_prim(ns, nl, value_expr, body_expr, next_value, lower_ctx, 0, 0)
}

pub(package) fn pipeline_lower_address_of_expr_typed_sidecar_handler_opt(mutable: i64, target: Expr, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  match target {
    Ident(ns, nl) -> {
      let local = pipeline_value_env_lookup(locals, src, ns, nl)
      if local >= 0 {
        if pipeline_value_env_lookup_kind(locals, src, ns, nl) == 1 {
          ir_lowered_expr(
            next_value,
            next_value + 1,
            ir_inst_list_prepend(ir_inst_address_of_slot_i64(next_value, local), ir_inst_list_empty())
          )
        } else {
          let slot = pipeline_ir_addressable_slot_id(next_value)
          let local_ty = pipeline_value_env_lookup_type_node(locals, src, ns, nl)
          let lanes = pipeline_type_value_lane_count_or_one(local_ty)
          let ptr = slot + lanes
          let insts = ir_inst_list_append(
            pipeline_ir_slot_lane_init_insts(slot, local, 0, lanes),
            ir_inst_list_prepend(ir_inst_address_of_slot_i64(ptr, slot), ir_inst_list_empty())
          )
          ir_lowered_expr(ptr, ptr + 1, insts)
        }
      } else {
        let param_id = if params == 0 { 0 - 1 } else { pipeline_param_index(params, src, ns, nl) }
        if param_id >= 0 {
          let slot = pipeline_ir_addressable_slot_id(next_value)
          let param_ty = pipeline_param_type_node_by_name(params, src, ns, nl, pipeline_handler_lower_ctx_subst(lower_ctx))
          let lanes = pipeline_type_value_lane_count_or_one(param_ty)
          let ptr = slot + lanes
          let insts = ir_inst_list_append(
            pipeline_ir_slot_lane_init_insts(slot, param_id, 0, lanes),
            ir_inst_list_prepend(ir_inst_address_of_slot_i64(ptr, slot), ir_inst_list_empty())
          )
          ir_lowered_expr(ptr, ptr + 1, insts)
        } else {
          ir_lowered_expr_invalid(next_value)
        }
      }
    }
    _ -> ir_lowered_expr_invalid(next_value)
  }
}

pub(package) fn pipeline_lower_deref_expr_typed_sidecar_handler_opt(ptr_expr: Expr, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let ptr = pipeline_lower_expr_typed_sidecar_handler_ctx(ptr_expr, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(ptr) == 1 {
    let dst = ir_lowered_expr_next_value(ptr)
    let inst = ir_inst_list_prepend(ir_inst_ptr_load_i64(dst, ir_lowered_expr_value(ptr)), ir_inst_list_empty())
    ir_lowered_expr(dst, dst + 1, ir_inst_list_append(ir_lowered_expr_insts(ptr), inst))
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

pub(package) fn pipeline_lower_ptr_assign_expr_typed_sidecar_handler_opt(ptr_expr: Expr, value_expr: Expr, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let ptr = pipeline_lower_expr_typed_sidecar_handler_ctx(ptr_expr, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(ptr) == 1 {
    let value = pipeline_lower_expr_typed_sidecar_handler_ctx(value_expr, ir_lowered_expr_next_value(ptr), lower_ctx)
    if ir_lowered_expr_is_valid(value) == 1 {
      let dst = ir_lowered_expr_next_value(value)
      let inst = ir_inst_list_prepend(ir_inst_ptr_store_i64(dst, ir_lowered_expr_value(ptr), ir_lowered_expr_value(value)), ir_inst_list_empty())
      ir_lowered_expr(dst, dst + 1, ir_inst_list_append(ir_lowered_expr_insts(ptr), ir_inst_list_append(ir_lowered_expr_insts(value), inst)))
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

pub(package) fn pipeline_lower_assign_expr_typed_sidecar_handler_opt(ns: i64, nl: i64, value_expr: Expr, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let handlers = pipeline_handler_lower_ctx_handlers(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  let slot = pipeline_value_env_lookup(locals, src, ns, nl)
  if slot >= 0 and pipeline_value_env_lookup_kind(locals, src, ns, nl) == 1 {
    let slot_float = pipeline_value_env_lookup_float_prim(locals, src, ns, nl)
    let slot_int = if slot_float == 0 { pipeline_type_hash_int_prim_or(pipeline_value_env_lookup_type_hash(locals, src, ns, nl), 0 - 1) } else { 0 - 1 }
    let slot_prim = if slot_float == PRIM_F32() or slot_float == PRIM_F64() { slot_float } else { slot_int }
    let slot_ty = pipeline_value_env_lookup_type_node(locals, src, ns, nl)
    let slot_lanes = pipeline_type_value_lane_count_or_one(slot_ty)
    let value = if pipeline_prim_is_forced_numeric_context(slot_prim) == 1 {
      pipeline_lower_expr_typed_sidecar_handler_opt_with_float_prim(value_expr, next_value, lower_ctx, slot_prim)
    } else {
      pipeline_lower_expr_typed_sidecar_handler_ctx(value_expr, next_value, lower_ctx)
    }
    if ir_lowered_expr_is_valid(value) == 1 {
      let retain_insts = if slot_ty != 0 and pipeline_expr_result_is_borrowed_for_ty_typed(value_expr, slot_ty, src, pipeline_handler_lower_ctx_fns(lower_ctx), subst, pipeline_handler_lower_ctx_tt(lower_ctx)) == 1 {
        pipeline_managed_retain_inst_list_with_origin(ir_lowered_expr_value(value), slot_ty, ir_lowered_expr_next_value(value), ir_managed_stake_origin_binding())
      } else {
        ir_inst_list_empty()
      }
      let after_retain = ir_lowered_expr_next_value(value) + ir_inst_list_len(retain_insts)
      let linear_plan = pipeline_linear_cleanup_plan(tt, slot_ty)
      let cleanup_insts = pipeline_slot_cleanup_inst_list_with_plan(slot, slot_ty, linear_plan, after_retain)
      let nil_value = after_retain + ir_inst_list_len(cleanup_insts)
      let assign_insts = ir_inst_list_append(
        pipeline_ir_slot_store_lane_insts(slot, ir_lowered_expr_value(value), 0, slot_lanes),
        ir_inst_list_append(
          pipeline_ir_structural_slot_rebind_insts(ir_lowered_expr_value(value), slot, linear_plan),
          ir_inst_list_prepend(ir_inst_const_i64(nil_value, 0), ir_inst_list_empty())
        )
      )
      let update_insts = ir_inst_list_append(retain_insts, ir_inst_list_append(cleanup_insts, assign_insts))
      ir_lowered_expr(nil_value, nil_value + 1, ir_inst_list_append(ir_lowered_expr_insts(value), update_insts))
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

pub(package) fn pipeline_handle_return_is_present(hret: HandleReturn) -> i64 {
  match hret {
    NoHandleReturn -> 0
    HandleReturnClause(rns, rnl, rb) -> 1
  }
}

pub(package) fn pipeline_lower_handle_expr_typed_sidecar_handler_opt(body_expr: Expr, clauses: HandlerClauseList, hret: HandleReturn, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  if pipeline_handle_return_is_present(hret) == 1 {
    -- parameterized effects: return-clause handles lower through the CFG path only.
    ir_lowered_expr_invalid(next_value)
  } else {
  pipeline_lower_handle_expr_typed_sidecar_inner(body_expr, clauses, next_value, lower_ctx)
  }
}

pub(package) fn pipeline_lower_handle_expr_typed_sidecar_inner(body_expr: Expr, clauses: HandlerClauseList, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let ctx = pipeline_handler_lower_ctx_handlers(lower_ctx)
  let nclauses = handler_clause_list_len(clauses)
  if nclauses <= 0 {
    ir_lowered_expr_invalid(next_value)
  } else {
    let handle_result_ty = pipeline_return_expr_type_node_typed(body_expr, params, locals, pipeline_handler_lower_ctx_module(lower_ctx))
    let lowered_clauses = pipeline_lower_handler_clauses_typed(clauses, params, locals, pipeline_handler_lower_ctx_module(lower_ctx), handle_result_ty)
    let clause_bodies = pipeline_lowered_handler_clauses_bodies(lowered_clauses)
    let eff_hash = pipeline_handler_clause_dispatch_key_typed(src, handler_clause_list_nth(clauses, 0), pipeline_handler_lower_ctx_subst(lower_ctx))
    let next_ctx = pipeline_handler_inline_ctx_push_typed_src_safe(ctx, eff_hash, clauses, nclauses, src, 1, pipeline_lowered_handler_clauses_out_of_line_safe(lowered_clauses))
    let next_lower_ctx = pipeline_handler_lower_ctx_from_module(params, locals, pipeline_lower_module_with_handlers(pipeline_handler_lower_ctx_module(lower_ctx), next_ctx))
    let call_inline = pipeline_lower_handle_body_call_inline_nodes(expr_to_node(body_expr), eff_hash, next_ctx, next_lower_ctx, next_value)
    let lowered = if ir_lowered_expr_is_valid(call_inline) == 1 { call_inline } else { pipeline_lower_expr_typed_sidecar_handler_ctx(body_expr, next_value, next_lower_ctx) }
    if ir_lowered_expr_is_valid(lowered) == 1 {
      if pipeline_ir_insts_handle_frame_free(ir_lowered_expr_insts(lowered)) == 1 {
        lowered
      } else {
        let insts = pipeline_ir_handle_inst_list_typed(src, eff_hash, clause_bodies, nclauses, ir_lowered_expr_insts(lowered))
        ir_lowered_expr(
          ir_lowered_expr_value(lowered),
          ir_lowered_expr_next_value(lowered),
          insts
        )
      }
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  }
}

pub(package) type PipelineScaledRawNodeAddress {
  PipelineScaledRawNodeAddress(i64, i64, i64, i64)
}

pub(package) type PipelineScaledRawNodeIndex {
  PipelineScaledRawNodeIndex(i64, i64)
}

pub(package) fn pipeline_expr_node_strip_typed(expr: i64) -> i64 {
  if expr != 0 and node_tag(expr) == 37 {
    pipeline_expr_node_strip_typed(node_f1(expr))
  } else {
    expr
  }
}

pub(package) fn pipeline_type_node_prim_id_or(ty: i64, default: i64) -> i64 {
  if ty == 0 { default } else { type_expr_prim_id_or(type_expr_from_node(ty), default) }
}

pub(package) fn pipeline_expr_node_is_int_lit(expr: i64, value: i64) -> i64 {
  let stripped = pipeline_expr_node_strip_typed(expr)
  if stripped != 0 and node_tag(stripped) == 1 {
    if node_f1(stripped) == value { 1 } else { 0 }
  } else {
    0
  }
}

pub(package) fn pipeline_scaled_raw_node_index(valid: i64, index: i64) -> PipelineScaledRawNodeIndex {
  PipelineScaledRawNodeIndex(valid, index)
}

pub(package) fn pipeline_scaled_raw_node_index_invalid() -> PipelineScaledRawNodeIndex {
  PipelineScaledRawNodeIndex(0, 0)
}

pub(package) fn pipeline_scaled_raw_node_index_valid(mode: PipelineScaledRawNodeIndex) -> i64 {
  match mode {
    PipelineScaledRawNodeIndex(valid, index) -> valid
  }
}

pub(package) fn pipeline_scaled_raw_node_index_expr(mode: PipelineScaledRawNodeIndex) -> i64 {
  match mode {
    PipelineScaledRawNodeIndex(valid, index) -> index
  }
}

pub(package) fn pipeline_scaled_raw_node_address(valid: i64, first: i64, second: i64, first_is_base: i64) -> PipelineScaledRawNodeAddress {
  PipelineScaledRawNodeAddress(valid, first, second, first_is_base)
}

pub(package) fn pipeline_scaled_raw_node_address_invalid() -> PipelineScaledRawNodeAddress {
  PipelineScaledRawNodeAddress(0, 0, 0, 0)
}

pub(package) fn pipeline_scaled_raw_node_address_valid(mode: PipelineScaledRawNodeAddress) -> i64 {
  match mode {
    PipelineScaledRawNodeAddress(valid, first, second, first_is_base) -> valid
  }
}

pub(package) fn pipeline_scaled_raw_node_address_first(mode: PipelineScaledRawNodeAddress) -> i64 {
  match mode {
    PipelineScaledRawNodeAddress(valid, first, second, first_is_base) -> first
  }
}

pub(package) fn pipeline_scaled_raw_node_address_second(mode: PipelineScaledRawNodeAddress) -> i64 {
  match mode {
    PipelineScaledRawNodeAddress(valid, first, second, first_is_base) -> second
  }
}

pub(package) fn pipeline_scaled_raw_node_address_first_is_base(mode: PipelineScaledRawNodeAddress) -> i64 {
  match mode {
    PipelineScaledRawNodeAddress(valid, first, second, first_is_base) -> first_is_base
  }
}

pub(package) fn pipeline_scaled_raw_index_from_node(expr: i64) -> PipelineScaledRawNodeIndex {
  let stripped = pipeline_expr_node_strip_typed(expr)
  if stripped != 0 and node_tag(stripped) == 3 {
    if node_f1(stripped) == 3 and pipeline_expr_node_is_int_lit(node_f3(stripped), 8) == 1 {
      pipeline_scaled_raw_node_index(1, node_f2(stripped))
    } else {
      if node_f1(stripped) == 3 and pipeline_expr_node_is_int_lit(node_f2(stripped), 8) == 1 {
        pipeline_scaled_raw_node_index(1, node_f3(stripped))
      } else {
        pipeline_scaled_raw_node_index_invalid()
      }
    }
  } else {
    pipeline_scaled_raw_node_index_invalid()
  }
}

pub(package) fn pipeline_scaled_raw_address_from_node(expr: i64) -> PipelineScaledRawNodeAddress {
  let stripped = pipeline_expr_node_strip_typed(expr)
  if stripped != 0 and node_tag(stripped) == 3 and node_f1(stripped) == 1 {
    let left_index = pipeline_scaled_raw_index_from_node(node_f2(stripped))
    if pipeline_scaled_raw_node_index_valid(left_index) == 1 {
      pipeline_scaled_raw_node_address(1, pipeline_scaled_raw_node_index_expr(left_index), node_f3(stripped), 0)
    } else {
      let right_index = pipeline_scaled_raw_index_from_node(node_f3(stripped))
      if pipeline_scaled_raw_node_index_valid(right_index) == 1 {
        pipeline_scaled_raw_node_address(1, node_f2(stripped), pipeline_scaled_raw_node_index_expr(right_index), 1)
      } else {
        pipeline_scaled_raw_node_address_invalid()
      }
    }
  } else {
    pipeline_scaled_raw_node_address_invalid()
  }
}

pub(package) fn pipeline_lower_node_handler_opt_args(args: i64, arg_count: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> PipelineLoweredArgs {
  pipeline_lower_node_handler_opt_args_expected_offset(args, arg_count, 0, next_value, lower_ctx, 0, 0, 0, 0)
}

pub(package) fn pipeline_lower_node_handler_opt_args_expected(args: i64, arg_count: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx, expected_params: i64, expected_subst: i64) -> PipelineLoweredArgs {
  pipeline_lower_node_handler_opt_args_expected_offset(args, arg_count, 0, next_value, lower_ctx, expected_params, 0, expected_subst, 0)
}

pub(package) fn pipeline_lower_node_handler_opt_args_expected_types(args: i64, arg_count: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx, expected_types: i64, expected_subst: i64) -> PipelineLoweredArgs {
  pipeline_lower_node_handler_opt_args_expected_offset(args, arg_count, 0, next_value, lower_ctx, 0, expected_types, expected_subst, 0)
}

pub(package) fn pipeline_lower_node_handler_opt_args_expected_offset(args: i64, arg_count: i64, index: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx, expected_params: i64, expected_types: i64, expected_subst: i64, expected_offset: i64) -> PipelineLoweredArgs {
  pipeline_lower_node_handler_opt_args_expected_offset_borrow_mask(args, arg_count, index, next_value, lower_ctx, expected_params, expected_types, expected_subst, expected_offset, 0)
}

pub(package) fn pipeline_lower_node_handler_opt_args_expected_offset_borrow_mask(args: i64, arg_count: i64, index: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx, expected_params: i64, expected_types: i64, expected_subst: i64, expected_offset: i64, borrowed_mask: i64) -> PipelineLoweredArgs {
  pipeline_lower_node_handler_opt_args_expected_offset_borrow_mask_origin(args, arg_count, index, next_value, lower_ctx, expected_params, expected_types, expected_subst, expected_offset, borrowed_mask, ir_managed_stake_origin_call_transport())
}

pub(package) fn pipeline_lower_node_handler_opt_args_expected_offset_borrow_mask_origin(args: i64, arg_count: i64, index: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx, expected_params: i64, expected_types: i64, expected_subst: i64, expected_offset: i64, borrowed_mask: i64, origin: i64) -> PipelineLoweredArgs {
  if index >= arg_count {
    pipeline_lowered_args(ir_value_list_empty(), next_value, ir_inst_list_empty(), 1)
  } else {
    let arg_node = nlist_get(args, index)
    let expected_float = pipeline_expected_arg_float_prim(expected_params, expected_types, index, expected_offset, expected_subst)
    let expected_int = if expected_float == 0 { pipeline_expected_arg_int_prim(expected_params, expected_types, index, expected_offset, expected_subst) } else { 0 - 1 }
    let expected_prim = if expected_float == PRIM_F32() or expected_float == PRIM_F64() { expected_float } else { expected_int }
    let expected_ty = pipeline_expected_arg_type_node(expected_params, expected_types, index, expected_offset, expected_subst)
    let actual_ty = pipeline_return_expr_type_node_from_node(
      arg_node,
      pipeline_handler_lower_ctx_params(lower_ctx),
      pipeline_handler_lower_ctx_locals(lower_ctx),
      pipeline_handler_lower_ctx_module(lower_ctx)
    )
    let retain_ty = pipeline_call_transport_retain_type(
      pipeline_handler_lower_ctx_tt(lower_ctx),
      expected_ty,
      actual_ty,
      cg_mask_has(borrowed_mask, index + expected_offset)
    )
    let arg = if pipeline_prim_is_forced_numeric_context(expected_prim) == 1 {
      pipeline_lower_expr_node_typed_sidecar_handler_opt_with_float_prim(arg_node, next_value, lower_ctx, expected_prim)
    } else {
      pipeline_lower_expr_node_typed_sidecar_handler_ctx(arg_node, next_value, lower_ctx)
    }
    if ir_lowered_expr_is_valid(arg) == 1 {
      let retain = pipeline_managed_borrow_retain_arg_node_with_origin(arg_node, ir_lowered_expr_value(arg), retain_ty, ir_lowered_expr_next_value(arg), pipeline_handler_lower_ctx_src(lower_ctx), pipeline_handler_lower_ctx_fns(lower_ctx), expected_subst, pipeline_handler_lower_ctx_tt(lower_ctx), origin)
      let rest = pipeline_lower_node_handler_opt_args_expected_offset_borrow_mask_origin(args, arg_count, index + 1, pipeline_lowered_args_next_value(retain), lower_ctx, expected_params, expected_types, expected_subst, expected_offset, borrowed_mask, origin)
      if pipeline_lowered_args_is_valid(rest) == 1 {
        let values = ir_value_list_prepend(ir_lowered_expr_value(arg), pipeline_lowered_args_values(rest))
        let insts = ir_inst_list_append(ir_lowered_expr_insts(arg), ir_inst_list_append(pipeline_lowered_args_insts(retain), pipeline_lowered_args_insts(rest)))
        pipeline_lowered_args(values, pipeline_lowered_args_next_value(rest), insts, 1)
      } else {
        pipeline_lowered_args_invalid(next_value)
      }
    } else {
      pipeline_lowered_args_invalid(next_value)
    }
  }
}

pub(package) fn pipeline_lower_record_field_nodes_handler_opt(fields: i64, field_count: i64, index: i64, type_ns: i64, type_nl: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> PipelineLoweredRecordFields {
  if index >= field_count {
    pipeline_lowered_record_fields(ir_record_field_list_empty(), next_value, ir_inst_list_empty(), 1)
  } else {
    let field = nlist_get(fields, index)
    if field != 0 and node_tag(field) == 2 {
      let src = pipeline_handler_lower_ctx_src(lower_ctx)
      let value_expr = node_f3(field)
      let value = pipeline_lower_expr_node_typed_sidecar_handler_ctx(value_expr, next_value, lower_ctx)
      if ir_lowered_expr_is_valid(value) == 1 {
        let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
        let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
        let field_ty = pipeline_record_field_expected_type(tt, src, type_ns, type_nl, node_f1(field), node_f2(field), subst)
        let retain = pipeline_managed_borrow_retain_arg_node_with_origin(value_expr, ir_lowered_expr_value(value), field_ty, ir_lowered_expr_next_value(value), src, pipeline_handler_lower_ctx_fns(lower_ctx), subst, tt, ir_managed_stake_origin_aggregate())
        let rest = pipeline_lower_record_field_nodes_handler_opt(fields, field_count, index + 1, type_ns, type_nl, pipeline_lowered_args_next_value(retain), lower_ctx)
        if pipeline_lowered_record_fields_is_valid(rest) == 1 {
          let field_hash = str_hash(src, node_f1(field), node_f2(field))
          let word_offset = pipeline_record_field_word_offset(tt, src, type_ns, type_nl, node_f1(field), node_f2(field), subst)
          let values = ir_record_field_list_append(pipeline_ir_record_field_lane_entries(field_hash, word_offset, ir_lowered_expr_value(value), field_ty), pipeline_lowered_record_fields_values(rest))
          let insts = ir_inst_list_append(ir_lowered_expr_insts(value), ir_inst_list_append(pipeline_lowered_args_insts(retain), pipeline_lowered_record_fields_insts(rest)))
          pipeline_lowered_record_fields(values, pipeline_lowered_record_fields_next_value(rest), insts, 1)
        } else {
          pipeline_lowered_record_fields_invalid(next_value)
        }
      } else {
        pipeline_lowered_record_fields_invalid(next_value)
      }
    } else {
      pipeline_lowered_record_fields_invalid(next_value)
    }
  }
}

pub(package) fn pipeline_lower_scaled_raw_first_second_nodes(first: i64, second: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> PipelineLoweredArgs {
  let first_lowered = pipeline_lower_expr_node_typed_sidecar_handler_ctx(first, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(first_lowered) == 1 {
    let second_lowered = pipeline_lower_expr_node_typed_sidecar_handler_ctx(second, ir_lowered_expr_next_value(first_lowered), lower_ctx)
    if ir_lowered_expr_is_valid(second_lowered) == 1 {
      pipeline_lowered_args(
        ir_value_list_prepend(ir_lowered_expr_value(first_lowered), ir_value_list_prepend(ir_lowered_expr_value(second_lowered), ir_value_list_empty())),
        ir_lowered_expr_next_value(second_lowered),
        ir_inst_list_append(ir_lowered_expr_insts(first_lowered), ir_lowered_expr_insts(second_lowered)),
        1
      )
    } else {
      pipeline_lowered_args_invalid(next_value)
    }
  } else {
    pipeline_lowered_args_invalid(next_value)
  }
}

pub(package) fn pipeline_lower_scaled_raw_call_node(callee_hash: i64, args: i64, arg_count: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let kind = pipeline_ir_native_intrinsic_kind(callee_hash)
  if kind == 4 and arg_count == 1 {
    let addr_mode = pipeline_scaled_raw_address_from_node(nlist_get(args, 0))
    if pipeline_scaled_raw_node_address_valid(addr_mode) == 1 {
      let lowered = pipeline_lower_scaled_raw_first_second_nodes(pipeline_scaled_raw_node_address_first(addr_mode), pipeline_scaled_raw_node_address_second(addr_mode), next_value, lower_ctx)
      if pipeline_lowered_args_is_valid(lowered) == 1 {
        let first_value = pipeline_ir_value_list_get_or(pipeline_lowered_args_values(lowered), 0, 0 - 1)
        let second_value = pipeline_ir_value_list_get_or(pipeline_lowered_args_values(lowered), 1, 0 - 1)
        let base = if pipeline_scaled_raw_node_address_first_is_base(addr_mode) == 1 { first_value } else { second_value }
        let index = if pipeline_scaled_raw_node_address_first_is_base(addr_mode) == 1 { second_value } else { first_value }
        let dst = pipeline_lowered_args_next_value(lowered)
        let call_args = ir_value_list_prepend(base, ir_value_list_prepend(index, ir_value_list_empty()))
        let call = ir_inst_list_prepend(ir_inst_call_i64(dst, pipeline_ir_pseudo_scaled_load64_hash(), call_args), ir_inst_list_empty())
        ir_lowered_expr(dst, dst + 1, ir_inst_list_append(pipeline_lowered_args_insts(lowered), call))
      } else {
        ir_lowered_expr_invalid(next_value)
      }
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    if kind == 2 and arg_count == 2 {
      let addr_mode = pipeline_scaled_raw_address_from_node(nlist_get(args, 0))
      if pipeline_scaled_raw_node_address_valid(addr_mode) == 1 {
        let lowered_addr = pipeline_lower_scaled_raw_first_second_nodes(pipeline_scaled_raw_node_address_first(addr_mode), pipeline_scaled_raw_node_address_second(addr_mode), next_value, lower_ctx)
        if pipeline_lowered_args_is_valid(lowered_addr) == 1 {
          let lowered_value = pipeline_lower_expr_node_typed_sidecar_handler_ctx(nlist_get(args, 1), pipeline_lowered_args_next_value(lowered_addr), lower_ctx)
          if ir_lowered_expr_is_valid(lowered_value) == 1 {
            let first_value = pipeline_ir_value_list_get_or(pipeline_lowered_args_values(lowered_addr), 0, 0 - 1)
            let second_value = pipeline_ir_value_list_get_or(pipeline_lowered_args_values(lowered_addr), 1, 0 - 1)
            let base = if pipeline_scaled_raw_node_address_first_is_base(addr_mode) == 1 { first_value } else { second_value }
            let index = if pipeline_scaled_raw_node_address_first_is_base(addr_mode) == 1 { second_value } else { first_value }
            let dst = ir_lowered_expr_next_value(lowered_value)
            let call_args = ir_value_list_prepend(base, ir_value_list_prepend(index, ir_value_list_prepend(ir_lowered_expr_value(lowered_value), ir_value_list_empty())))
            let call = ir_inst_list_prepend(ir_inst_call_i64(dst, pipeline_ir_pseudo_scaled_store64_hash(), call_args), ir_inst_list_empty())
            ir_lowered_expr(dst, dst + 1, ir_inst_list_append(pipeline_lowered_args_insts(lowered_addr), ir_inst_list_append(ir_lowered_expr_insts(lowered_value), call)))
          } else {
            ir_lowered_expr_invalid(next_value)
          }
        } else {
          ir_lowered_expr_invalid(next_value)
        }
      } else {
        ir_lowered_expr_invalid(next_value)
      }
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  }
}

pub(package) fn pipeline_lower_bridge_mem_call_node(src: i64, ns: i64, nl: i64, args: i64, arg_count: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let kind = pipeline_bridge_mem_kind(src, ns, nl, arg_count)
  if kind == 0 {
    ir_lowered_expr_invalid(next_value)
  } else {
    pipeline_lower_bridge_mem_from_values(kind, pipeline_lower_node_handler_opt_args(args, arg_count, next_value, lower_ctx))
  }
}

pub(package) fn pipeline_lower_native_intrinsic_call_node(callee_hash: i64, args: i64, arg_count: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let kind = pipeline_ir_native_intrinsic_kind(callee_hash)
  let arity = pipeline_ir_native_intrinsic_arity(kind)
  if kind == 0 or arity != arg_count {
    ir_lowered_expr_invalid(next_value)
  } else {
    if kind == 4 {
      let ptr = pipeline_lower_expr_node_typed_sidecar_handler_ctx(nlist_get(args, 0), next_value, lower_ctx)
      if ir_lowered_expr_is_valid(ptr) == 1 {
        let dst = ir_lowered_expr_next_value(ptr)
        let inst = ir_inst_list_prepend(ir_inst_ptr_load_i64(dst, ir_lowered_expr_value(ptr)), ir_inst_list_empty())
        ir_lowered_expr(dst, dst + 1, ir_inst_list_append(ir_lowered_expr_insts(ptr), inst))
      } else {
        ir_lowered_expr_invalid(next_value)
      }
    } else {
      if kind == 2 {
        let ptr = pipeline_lower_expr_node_typed_sidecar_handler_ctx(nlist_get(args, 0), next_value, lower_ctx)
        if ir_lowered_expr_is_valid(ptr) == 1 {
          let value = pipeline_lower_expr_node_typed_sidecar_handler_ctx(nlist_get(args, 1), ir_lowered_expr_next_value(ptr), lower_ctx)
          if ir_lowered_expr_is_valid(value) == 1 {
            let store_dst = ir_lowered_expr_next_value(value)
            let store = ir_inst_list_prepend(ir_inst_ptr_store_i64(store_dst, ir_lowered_expr_value(ptr), ir_lowered_expr_value(value)), ir_inst_list_empty())
            let insts = ir_inst_list_append(ir_lowered_expr_insts(ptr), ir_inst_list_append(ir_lowered_expr_insts(value), store))
            ir_lowered_expr(ir_lowered_expr_value(value), store_dst + 1, insts)
          } else {
            ir_lowered_expr_invalid(next_value)
          }
        } else {
          ir_lowered_expr_invalid(next_value)
        }
      } else {
        let lowered_args = pipeline_lower_node_handler_opt_args(args, arg_count, next_value, lower_ctx)
        if pipeline_lowered_args_is_valid(lowered_args) == 1 {
          let dst = pipeline_lowered_args_next_value(lowered_args)
          let call = ir_inst_list_prepend(ir_inst_call_i64(dst, callee_hash, pipeline_lowered_args_values(lowered_args)), ir_inst_list_empty())
          ir_lowered_expr(dst, dst + 1, ir_inst_list_append(pipeline_lowered_args_insts(lowered_args), call))
        } else {
          ir_lowered_expr_invalid(next_value)
        }
      }
    }
  }
}

pub(package) fn pipeline_lower_weak_call_node_typed_sidecar_handler_opt(src: i64, ns: i64, nl: i64, args: i64, arg_count: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  if arg_count != 1 {
    ir_lowered_expr_invalid(next_value)
  } else {
    if src_eq(src, ns, nl, "weak_ref") == 1 or src_eq(src, ns, nl, "weak_load") == 1 {
      let value = pipeline_lower_expr_node_typed_sidecar_handler_ctx(nlist_get(args, 0), next_value, lower_ctx)
      if ir_lowered_expr_is_valid(value) == 1 {
        let dst = ir_lowered_expr_next_value(value)
        let runtime_hash = if src_eq(src, ns, nl, "weak_ref") == 1 { pipeline_rc_default_weak_retain_hash() } else { pipeline_rc_default_weak_load_hash() }
        let runtime_args = ir_value_list_prepend(ir_lowered_expr_value(value), ir_value_list_empty())
        let call = ir_inst_list_prepend(ir_inst_call_i64(dst, runtime_hash, runtime_args), ir_inst_list_empty())
        let result_value = if src_eq(src, ns, nl, "weak_ref") == 1 { ir_lowered_expr_value(value) } else { dst }
        let insts = ir_inst_list_append(ir_lowered_expr_insts(value), call)
        ir_lowered_expr(result_value, dst + 1, insts)
      } else {
        ir_lowered_expr_invalid(next_value)
      }
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  }
}

pub(package) fn pipeline_generic_infer_subst_add(s: i64, var_id: i64, actual_ty: i64) -> i64 {
  if actual_ty == 0 { s }
  else {
    let old = subst_lookup(s, var_id)
    if old == 0 { subst_add(s, var_id, actual_ty) } else { s }
  }
}

pub(package) fn pipeline_generic_infer_subst_type_list(expected: i64, actual: i64, s: i64) -> i64 {
  if expected == 0 or actual == 0 { s }
  else {
    let n = nlist_len(expected)
    let mut i = 0
    let mut result = s
    while i < n {
      if i < nlist_len(actual) {
        result = pipeline_generic_infer_subst_ty(nlist_get(expected, i), nlist_get(actual, i), result)
      } else { 0 }
      i = i + 1
    }
    result
  }
}

pub(package) fn pipeline_generic_infer_subst_ty(expected_ty: i64, actual_ty: i64, s: i64) -> i64 {
  if expected_ty == 0 or actual_ty == 0 { s }
  else {
    let tag = ty_tag(expected_ty)
    match tag {
      12 -> pipeline_generic_infer_subst_add(s, ty_f1(expected_ty), actual_ty)
      3 -> pipeline_generic_infer_subst_ty(ty_f2(expected_ty), actual_ty, pipeline_generic_infer_subst_ty(ty_f1(expected_ty), actual_ty, s))
      4 -> pipeline_generic_infer_subst_ty(ty_f2(expected_ty), actual_ty, pipeline_generic_infer_subst_ty(ty_f1(expected_ty), actual_ty, s))
      5 -> pipeline_generic_infer_subst_ty(ty_f1(expected_ty), actual_ty, s)
      6 -> {
        if ty_tag(actual_ty) == 6 {
          let with_params = pipeline_generic_infer_subst_type_list(ty_f1(expected_ty), ty_f1(actual_ty), s)
          pipeline_generic_infer_subst_ty(ty_f2(expected_ty), ty_f2(actual_ty), with_params)
        } else { s }
      }
      9 -> {
        if ty_tag(actual_ty) == 9 and ty_f1(expected_ty) == ty_f1(actual_ty) {
          let with_inner = pipeline_generic_infer_subst_ty(ty_f2(expected_ty), ty_f2(actual_ty), s)
          pipeline_generic_infer_subst_type_list(ty_f3(expected_ty), ty_f3(actual_ty), with_inner)
        } else { s }
      }
      14 -> {
        if ty_tag(actual_ty) == 14 {
          let with_input = pipeline_generic_infer_subst_ty(ty_f1(expected_ty), ty_f1(actual_ty), s)
          pipeline_generic_infer_subst_ty(ty_f2(expected_ty), ty_f2(actual_ty), with_input)
        } else { s }
      }
      15 -> if ty_tag(actual_ty) == 15 { pipeline_generic_infer_subst_ty(ty_f1(expected_ty), ty_f1(actual_ty), s) } else { s }
      16 -> if ty_tag(actual_ty) == 16 { pipeline_generic_infer_subst_ty(ty_f1(expected_ty), ty_f1(actual_ty), s) } else { s }
      17 -> if ty_tag(actual_ty) == 17 { pipeline_generic_infer_subst_ty(ty_f1(expected_ty), ty_f1(actual_ty), s) } else { s }
      18 -> pipeline_generic_infer_subst_ty(
        ty_f1(expected_ty),
        if ty_tag(actual_ty) == 18 { ty_f1(actual_ty) } else { actual_ty },
        s
      )
      19 -> pipeline_generic_infer_subst_ty(
        ty_f1(expected_ty),
        if ty_tag(actual_ty) == 19 { ty_f1(actual_ty) } else { actual_ty },
        s
      )
      29 -> {
        let actual_inner = if ty_tag(actual_ty) == 29 or ty_tag(actual_ty) == 18 or ty_tag(actual_ty) == 19 {
          ty_f1(actual_ty)
        } else { actual_ty }
        pipeline_generic_infer_subst_ty(ty_f1(expected_ty), actual_inner, s)
      }
      22 -> if ty_tag(actual_ty) == 22 and ty_array_length(expected_ty) == ty_array_length(actual_ty) {
        pipeline_generic_infer_subst_ty(ty_array_inner(expected_ty), ty_array_inner(actual_ty), s)
      } else { s }
      _ -> s
    }
  }
}

-- Constructor type parameters belong to the owning variant declaration, not
-- to the enclosing generic function.  An inferred constructor call therefore
-- needs its own substitution: applying the enclosing function's substitution
-- directly only works when two unrelated declarations happen to reuse the
-- same type-variable ids.  Derive the constructor instance from the checked
-- argument types so ABI flattening, cleanup and deep-release masks consume one
-- concrete semantic shape.
pub(package) fn pipeline_constructor_infer_subst_exprs_typed(payloads: i64, args: ExprList, index: i64, inferred: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> i64 {
  match args {
    ExprListNil -> inferred
    ExprListCons(arg, rest) -> {
      let next = if payloads != 0 and index < nlist_len(payloads) {
        let actual = pipeline_type_node_subst_or_same(
          pipeline_return_expr_type_node_typed(arg, params, locals, module),
          pipeline_lower_module_subst(module)
        )
        pipeline_generic_infer_subst_ty(nlist_get(payloads, index), actual, inferred)
      } else { inferred }
      pipeline_constructor_infer_subst_exprs_typed(payloads, rest, index + 1, next, params, locals, module)
    }
  }
}

pub(package) fn pipeline_constructor_subst_is_complete(tparams: i64, inferred: i64) -> i64 {
  if tparams == 0 { 1 }
  else {
    let mut complete = 1
    let mut i = 0
    while i < nlist_len(tparams) and complete == 1 {
      if subst_lookup(inferred, node_f3(nlist_get(tparams, i))) == 0 { complete = 0 }
      else { i = i + 1 }
    }
    complete
  }
}

pub(package) fn pipeline_constructor_instance_subst_typed(tparams: i64, payloads: i64, args: ExprList, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, fallback: i64) -> i64 {
  if tparams == 0 { fallback }
  else {
    let inferred = pipeline_constructor_infer_subst_exprs_typed(payloads, args, 0, subst_new(), params, locals, module)
    if pipeline_constructor_subst_is_complete(tparams, inferred) == 1 { inferred } else { fallback }
  }
}

pub(package) fn pipeline_constructor_instance_subst_node(tparams: i64, payloads: i64, args: i64, arg_count: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, fallback: i64) -> i64 {
  if tparams == 0 { fallback }
  else {
    let inferred = subst_new()
    let mut i = 0
    while i < arg_count {
      if payloads != 0 and i < nlist_len(payloads) {
        let actual = pipeline_type_node_subst_or_same(
          pipeline_expr_node_default_type_node(nlist_get(args, i), params, locals, module),
          pipeline_lower_module_subst(module)
        )
        pipeline_generic_infer_subst_ty(nlist_get(payloads, i), actual, inferred)
      } else { 0 }
      i = i + 1
    }
    if pipeline_constructor_subst_is_complete(tparams, inferred) == 1 { inferred } else { fallback }
  }
}

pub(package) fn pipeline_expr_node_default_type_node(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> i64 {
  let inferred = pipeline_return_expr_type_node_from_node(expr, params, locals, module)
  if inferred != 0 { inferred }
  else {
    let stripped = pipeline_expr_node_strip_typed(expr)
    if stripped == 0 { 0 }
    else {
      let tag = node_tag(stripped)
      if tag == 1 or tag == 24 { ty_i64() }
      else { if tag == 9 { ty_str() }
      else { if tag == 54 { ty_f64() }
      else { if tag == 51 { ty_nil() }
      else { 0 } } } }
    }
  }
}

pub(package) fn pipeline_infer_generic_type_args_node(tparams: i64, expected_params: i64, args: i64, arg_count: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> i64 {
  if tparams == 0 { 0 }
  else {
    let subst = subst_new()
    let mut i = 0
    while i < arg_count {
      if expected_params != 0 and i < nlist_len(expected_params) {
        let expected_ty = node_f3(nlist_get(expected_params, i))
        let actual_ty = pipeline_expr_node_default_type_node(nlist_get(args, i), params, locals, module)
        pipeline_generic_infer_subst_ty(expected_ty, actual_ty, subst)
      } else { 0 }
      i = i + 1
    }
    let result = nlist_new()
    let mut j = 0
    let mut valid = 1
    while j < nlist_len(tparams) {
      let tp = nlist_get(tparams, j)
      let concrete = subst_lookup(subst, node_f3(tp))
      if concrete == 0 {
        valid = 0
        j = nlist_len(tparams)
      } else {
        nlist_add(result, concrete)
        j = j + 1
      }
    }
    if valid == 1 { result } else { 0 }
  }
}

pub(package) fn pipeline_lower_inferred_generic_call_node_typed_sidecar_handler_opt(ns: i64, nl: i64, args: i64, arg_count: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let fns = pipeline_handler_lower_ctx_fns(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  let template_pair = pipeline_generic_template_find_resolved(fns, tt, src, ns, nl)
  if template_pair == 0 {
    ir_lowered_expr_invalid(next_value)
  } else {
    let fn_wrap = node_f1(template_pair)
    let tparams = fn_tparams(fn_wrap)
    if tparams == 0 {
      ir_lowered_expr_invalid(next_value)
    } else {
      let expected_params = node_f3(pipeline_fn_inner(fn_wrap))
      let inferred_type_args = pipeline_infer_generic_type_args_node(tparams, expected_params, args, arg_count, params, locals, pipeline_handler_lower_ctx_module(lower_ctx))
      if inferred_type_args == 0 {
        ir_lowered_expr_invalid(next_value)
      } else {
        let concrete_type_args = if subst == 0 { inferred_type_args } else { type_list_subst(inferred_type_args, subst) }
        let expected_subst = cg_build_subst_with_associated(tparams, concrete_type_args, tt)
        let borrowed_mask = pipeline_fn_effective_borrowable_param_mask_from_pair(fns, template_pair, expected_params, expected_subst)
        let lowered_args = pipeline_lower_node_handler_opt_args_expected_offset_borrow_mask(args, arg_count, 0, next_value, lower_ctx, expected_params, 0, expected_subst, 0, borrowed_mask)
        if pipeline_lowered_args_is_valid(lowered_args) == 1 {
          let dst = pipeline_lowered_args_next_value(lowered_args)
          let logical_args = pipeline_lowered_args_values(lowered_args)
          let abi_args = pipeline_call_abi_args(logical_args, expected_params, 0, expected_subst, 0, 0)
          let result_ty = pipeline_function_return_type_with_subst(fn_wrap, expected_subst, tt)
          let call_head = ir_inst_list_prepend(
            pipeline_generic_call_inst(dst, src, tt, fns, ns, nl, concrete_type_args, abi_args),
            ir_inst_list_empty()
          )
          let call = ir_inst_list_append(call_head, pipeline_ir_call_result_lane_insts(dst, result_ty))
          let result_lanes = pipeline_type_value_lane_count_or_one(result_ty)
          let linear_transfers = pipeline_effect_linear_transfer_insts_node(
            args, arg_count, expected_params, 0, 0, abi_args, lower_ctx
          )
          let cleanup = pipeline_managed_lambda_temp_release_arg_nodes_masked(args, arg_count, logical_args, 0, dst + result_lanes, borrowed_mask, 0, expected_params, 0, expected_subst, pipeline_handler_lower_ctx_src(lower_ctx), pipeline_handler_lower_ctx_tt(lower_ctx))
          ir_lowered_expr(dst, pipeline_lowered_args_next_value(cleanup), ir_inst_list_append(pipeline_lowered_args_insts(lowered_args), ir_inst_list_append(linear_transfers, ir_inst_list_append(call, pipeline_lowered_args_insts(cleanup)))))
        } else {
          ir_lowered_expr_invalid(next_value)
        }
      }
    }
  }
}

pub(package) fn pipeline_lower_opaque_wrap_node(declaration: i64, type_args: i64, args: i64, arg_count: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  if declaration == 0 or arg_count != 1 { ir_lowered_expr_invalid(next_value) }
  else {
    let expected_types = pipeline_opaque_representation_types(pipeline_handler_lower_ctx_tt(lower_ctx), declaration, type_args)
    let lowered = pipeline_lower_node_handler_opt_args_expected_offset_borrow_mask_origin(args, arg_count, 0, next_value, lower_ctx, 0, expected_types, 0, 0, 0, ir_managed_stake_origin_aggregate())
    if pipeline_lowered_args_is_valid(lowered) == 0 { ir_lowered_expr_invalid(next_value) }
    else {
      let result_values = pipeline_call_abi_args(pipeline_lowered_args_values(lowered), 0, expected_types, 0, 0, 0)
      let result = pipeline_ir_value_list_get_or(result_values, 0, 0 - 1)
      let target_ty = typeck_named_type_from_declaration(
        pipeline_handler_lower_ctx_tt(lower_ctx), declaration, type_args
      )
      let actual_source_ty = pipeline_return_expr_type_node_from_node(
        nlist_get(args, 0),
        pipeline_handler_lower_ctx_params(lower_ctx),
        pipeline_handler_lower_ctx_locals(lower_ctx),
        pipeline_handler_lower_ctx_module(lower_ctx)
      )
      let source_ty = if actual_source_ty == 0 {
        nlist_get(expected_types, 0)
      } else { actual_source_ty }
      let rewrap = pipeline_linear_rewrap_insts(
        result,
        source_ty,
        target_ty,
        pipeline_handler_lower_ctx_tt(lower_ctx)
      )
      ir_lowered_expr(
        result,
        pipeline_lowered_args_next_value(lowered),
        ir_inst_list_append(pipeline_lowered_args_insts(lowered), rewrap)
      )
    }
  }
}

pub(package) fn pipeline_lower_call_node_typed_sidecar_handler_opt(ns: i64, nl: i64, args: i64, arg_count: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let fns = pipeline_handler_lower_ctx_fns(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  let callee_hash = str_hash(src, ns, nl)
  let direct = pipeline_call_callee_is_direct(params, locals, src, ns, nl)
  let callee_value = pipeline_call_callee_value(params, locals, src, ns, nl)
  let callee_slot = pipeline_call_callee_slot(locals, src, ns, nl)
  let callee_type_node = pipeline_call_callee_type_node(params, locals, src, ns, nl, subst)
  let indirect_expected_types = pipeline_call_indirect_expected_types(direct, callee_type_node)
  let opaque = pipeline_lower_opaque_wrap_node(pipeline_local_opaque_type_declaration(tt, src, ns, nl), 0, args, arg_count, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(opaque) == 1 { opaque }
  else {
  let weak = pipeline_lower_weak_call_node_typed_sidecar_handler_opt(src, ns, nl, args, arg_count, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(weak) == 1 {
    weak
  } else {
    let scaled_raw = pipeline_lower_scaled_raw_call_node(callee_hash, args, arg_count, next_value, lower_ctx)
    if ir_lowered_expr_is_valid(scaled_raw) == 1 {
      scaled_raw
    } else {
    let intrinsic = pipeline_lower_native_intrinsic_call_node(callee_hash, args, arg_count, next_value, lower_ctx)
    if ir_lowered_expr_is_valid(intrinsic) == 1 {
      intrinsic
    } else {
    let bridge_mem = if direct == 1 { pipeline_lower_bridge_mem_call_node(src, ns, nl, args, arg_count, next_value, lower_ctx) } else { ir_lowered_expr_invalid(next_value) }
    if ir_lowered_expr_is_valid(bridge_mem) == 1 {
      bridge_mem
    } else {
    let inferred_generic = if direct == 1 { pipeline_lower_inferred_generic_call_node_typed_sidecar_handler_opt(ns, nl, args, arg_count, next_value, lower_ctx) } else { ir_lowered_expr_invalid(next_value) }
    if ir_lowered_expr_is_valid(inferred_generic) == 1 {
      inferred_generic
    } else { if direct == 1 or callee_value >= 0 or callee_slot >= 0 {
    let arg_start_value = if callee_slot >= 0 { next_value + 1 } else { next_value }
    let variant_payloads = if direct == 1 { pipeline_variant_payload_types(tt, src, ns, nl) } else { 0 }
    let variant_tparams = if variant_payloads == 0 { 0 } else { ttable_variant_tparams(tt, src, ns, nl) }
    let variant_subst = if variant_payloads == 0 { subst } else {
      pipeline_constructor_instance_subst_node(variant_tparams, variant_payloads, args, arg_count, params, locals, pipeline_handler_lower_ctx_module(lower_ctx), subst)
    }
    let expected_params = if variant_payloads == 0 and direct == 1 { pipeline_fns_lookup_params_resolved(fns, tt, src, ns, nl) } else { 0 }
    let expected_types = if variant_payloads != 0 { variant_payloads } else { indirect_expected_types }
    let direct_fn = if direct == 1 { pipeline_fns_lookup_pair_resolved(fns, tt, src, ns, nl) } else { 0 }
    let result_ty = pipeline_call_result_type_node(params, locals, src, tt, fns, subst, ns, nl)
    let borrowed_mask = if variant_payloads == 0 and direct == 1 {
      pipeline_call_borrowable_param_mask(fns, tt, src, ns, nl, expected_params, subst)
    } else { 0 }
    let lowered_args = if expected_types != 0 {
      pipeline_lower_node_handler_opt_args_expected_offset_borrow_mask_origin(args, arg_count, 0, arg_start_value, lower_ctx, 0, expected_types, variant_subst, 0, 0, if variant_payloads != 0 { ir_managed_stake_origin_aggregate() } else { ir_managed_stake_origin_call_transport() })
    } else {
      pipeline_lower_node_handler_opt_args_expected_offset_borrow_mask(args, arg_count, 0, arg_start_value, lower_ctx, expected_params, 0, subst, 0, borrowed_mask)
    }
    if pipeline_lowered_args_is_valid(lowered_args) == 1 {
      let dst = pipeline_lowered_args_next_value(lowered_args)
      let indirect_callee = if callee_slot >= 0 { next_value } else { callee_value }
      let callee_insts = if callee_slot >= 0 {
        ir_inst_list_prepend(ir_inst_load_i64(next_value, callee_slot), ir_inst_list_empty())
      } else { ir_inst_list_empty() }
      let logical_args = pipeline_lowered_args_values(lowered_args)
      let abi_args = if variant_payloads != 0 {
        pipeline_call_abi_args(logical_args, 0, variant_payloads, variant_subst, 0, 0)
      } else { if expected_params != 0 or expected_types != 0 {
        pipeline_call_abi_args(logical_args, expected_params, expected_types, subst, 0, 0)
      } else { logical_args } }
      let resolved_call = pipeline_call_inst_resolved(dst, direct, indirect_callee, src, tt, fns, ns, nl, variant_subst, abi_args, result_ty)
      let call_head = ir_inst_list_prepend(resolved_call, ir_inst_list_empty())
      let call = if result_ty != 0 {
        ir_inst_list_append(call_head, pipeline_ir_call_result_lane_insts(dst, result_ty))
      } else { call_head }
      let linear_transfers = if variant_payloads != 0 {
        pipeline_aggregate_linear_transfer_insts_node(
          args, arg_count, variant_payloads, variant_subst, 0, 0, abi_args, lower_ctx
        )
      } else { if expected_params != 0 {
        pipeline_effect_linear_transfer_insts_node(
          args, arg_count, expected_params, 0, 0, abi_args, lower_ctx
        )
      } else { if expected_types != 0 {
        pipeline_indirect_linear_transfer_insts_node(
          args, arg_count, expected_types, subst, abi_args, lower_ctx
        )
      } else { ir_inst_list_empty() } } }
      let managed_transfers = match resolved_call {
        IrIndirectCallI64(actual_dst, callee, actual_args, indirect_result_ty) -> pipeline_indirect_managed_transfer_insts(
          expected_types, if variant_payloads != 0 { variant_subst } else { subst },
          0, 0, actual_args, actual_dst
        )
        _ -> pipeline_direct_managed_transfer_insts(
          expected_params, subst, borrowed_mask, resolved_call,
          pipeline_handler_lower_ctx_tt(lower_ctx)
        )
      }
      let result_lanes = if result_ty != 0 { pipeline_type_value_lane_count_or_one(result_ty) } else { 1 }
      let cleanup = pipeline_managed_lambda_temp_release_arg_nodes_masked(args, arg_count, logical_args, 0, dst + result_lanes, borrowed_mask, 0, expected_params, expected_types, variant_subst, pipeline_handler_lower_ctx_src(lower_ctx), pipeline_handler_lower_ctx_tt(lower_ctx))
      let insts = ir_inst_list_append(
        callee_insts,
        ir_inst_list_append(
          pipeline_lowered_args_insts(lowered_args),
          ir_inst_list_append(
            linear_transfers,
            ir_inst_list_append(managed_transfers, ir_inst_list_append(call, pipeline_lowered_args_insts(cleanup)))
          )
        )
      )
      ir_lowered_expr(dst, pipeline_lowered_args_next_value(cleanup), insts)
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  } } } } }
  }
  }
}

pub(package) fn pipeline_node_declaration_access(node: i64) -> i64 {
  if node == 0 or node_tag(node) != 13 { 0 }
  else {
    let fact = node_f4(node)
    if fact != 0 and node_tag(fact) == 2 { node_f1(fact) } else { 0 }
  }
}

pub(package) fn pipeline_lower_decl_function_ref(decl: i64, next_value: i64) -> IrLoweredExpr {
  let pair = module_decl_fact_function_pair(decl)
  if module_decl_fact_namespace(decl) == module_decl_namespace_constructor() {
    ir_lowered_expr(
      next_value,
      next_value + 1,
      ir_inst_list_prepend(pipeline_variant_value_init_inst(next_value, str_hash(module_decl_fact_name_ptr(decl), 0, module_decl_fact_name_len(decl)), ir_value_list_empty(), 0), ir_inst_list_empty())
    )
  } else { if pair != 0 and fn_tparams(node_f1(pair)) == 0 {
    ir_lowered_expr(
      next_value,
      next_value + 1,
      ir_inst_list_prepend(ir_inst_function_ref_i64(next_value, pipeline_fn_pair_key(pair)), ir_inst_list_empty())
    )
  } else { ir_lowered_expr_invalid(next_value) } }
}

pub(package) fn pipeline_lower_constructor_decl_call_node(decl: i64, type_args: i64, args: i64, arg_count: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let origin_src = module_decl_fact_source(decl)
  let name_ptr = module_decl_fact_name_ptr(decl)
  let name_len = module_decl_fact_name_len(decl)
  let name_start = name_ptr - origin_src
  let payloads = pipeline_variant_payload_types(tt, origin_src, name_start, name_len)
  let tparams = ttable_variant_tparams(tt, origin_src, name_start, name_len)
  let outer_subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  let concrete_type_args = if outer_subst == 0 or type_args == 0 { type_args } else { type_list_subst(type_args, outer_subst) }
  let inst_subst = if tparams == 0 { outer_subst }
    else { if concrete_type_args == 0 {
      pipeline_constructor_instance_subst_node(
        tparams,
        payloads,
        args,
        arg_count,
        pipeline_handler_lower_ctx_params(lower_ctx),
        pipeline_handler_lower_ctx_locals(lower_ctx),
        pipeline_handler_lower_ctx_module(lower_ctx),
        outer_subst
      )
    } else { cg_build_subst(tparams, concrete_type_args) } }
  let lowered_args = pipeline_lower_node_handler_opt_args_expected_offset_borrow_mask_origin(args, arg_count, 0, next_value, lower_ctx, 0, payloads, inst_subst, 0, 0, ir_managed_stake_origin_aggregate())
  if pipeline_lowered_args_is_valid(lowered_args) == 0 { ir_lowered_expr_invalid(next_value) }
  else {
    let dst = pipeline_lowered_args_next_value(lowered_args)
    let logical_args = pipeline_lowered_args_values(lowered_args)
    let abi_args = pipeline_call_abi_args(logical_args, 0, payloads, inst_subst, 0, 0)
    let tag_hash = pipeline_variant_tag_hash(tt, origin_src, name_start, name_len)
    let init = ir_inst_list_prepend(pipeline_variant_value_init_inst(dst, tag_hash, abi_args, pipeline_variant_field_mask_for_payload_types(payloads, inst_subst)), ir_inst_list_empty())
    let linear_transfers = pipeline_aggregate_linear_transfer_insts_node(
      args, arg_count, payloads, inst_subst, 0, 0, abi_args, lower_ctx
    )
    let cleanup = pipeline_managed_lambda_temp_release_arg_nodes_masked(args, arg_count, logical_args, 0, dst + 1, 0, 0, 0, payloads, inst_subst, pipeline_handler_lower_ctx_src(lower_ctx), tt)
    ir_lowered_expr(dst, pipeline_lowered_args_next_value(cleanup), ir_inst_list_append(pipeline_lowered_args_insts(lowered_args), ir_inst_list_append(linear_transfers, ir_inst_list_append(init, pipeline_lowered_args_insts(cleanup)))))
  }
}

pub(package) fn pipeline_lower_decl_call_node(decl: i64, args: i64, arg_count: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let pair = module_decl_fact_function_pair(decl)
  if module_decl_fact_namespace(decl) == module_decl_namespace_constructor() {
    pipeline_lower_constructor_decl_call_node(decl, 0, args, arg_count, next_value, lower_ctx)
  } else { if pair == 0 or fn_tparams(node_f1(pair)) != 0 { ir_lowered_expr_invalid(next_value) }
  else {
    let fn_wrap = node_f1(pair)
    let expected_params = node_f3(pipeline_fn_inner(fn_wrap))
    let result_ty = fn_ret_type(fn_wrap)
    let borrowed_mask = pipeline_fn_effective_borrowable_param_mask_from_pair(pipeline_handler_lower_ctx_fns(lower_ctx), pair, expected_params, 0)
    let lowered_args = pipeline_lower_node_handler_opt_args_expected_offset_borrow_mask(args, arg_count, 0, next_value, lower_ctx, expected_params, 0, 0, 0, borrowed_mask)
    if pipeline_lowered_args_is_valid(lowered_args) == 0 { ir_lowered_expr_invalid(next_value) }
    else {
      let dst = pipeline_lowered_args_next_value(lowered_args)
      let logical_args = pipeline_lowered_args_values(lowered_args)
      let abi_args = pipeline_call_abi_args(logical_args, expected_params, 0, 0, 0, 0)
      let call_head = ir_inst_list_prepend(ir_inst_call_i64(dst, pipeline_fn_pair_key(pair), abi_args), ir_inst_list_empty())
      let call = ir_inst_list_append(call_head, pipeline_ir_call_result_lane_insts(dst, result_ty))
      let result_lanes = pipeline_type_value_lane_count_or_one(result_ty)
      let linear_transfers = pipeline_effect_linear_transfer_insts_node(
        args, arg_count, expected_params, 0, 0, abi_args, lower_ctx
      )
      let cleanup = pipeline_managed_lambda_temp_release_arg_nodes_masked(args, arg_count, logical_args, 0, dst + result_lanes, borrowed_mask, 0, expected_params, 0, 0, pipeline_handler_lower_ctx_src(lower_ctx), pipeline_handler_lower_ctx_tt(lower_ctx))
      ir_lowered_expr(dst, pipeline_lowered_args_next_value(cleanup), ir_inst_list_append(pipeline_lowered_args_insts(lowered_args), ir_inst_list_append(linear_transfers, ir_inst_list_append(call, pipeline_lowered_args_insts(cleanup)))))
    }
  } }
}

pub(package) fn pipeline_lower_decl_call_typed(decl: i64, args: ExprList, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let nodes = expr_list_to_nodes(args)
  pipeline_lower_decl_call_node(decl, nodes, expr_list_len(args), next_value, lower_ctx)
}

pub(package) fn pipeline_lower_generic_call_node_typed_sidecar_handler_opt(type_args: i64, inner_call: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let fns = pipeline_handler_lower_ctx_fns(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  if inner_call != 0 and node_tag(inner_call) == 4 {
    let declaration = pipeline_local_opaque_type_declaration(tt, src, node_f1(inner_call), node_f2(inner_call))
    if declaration != 0 {
      let concrete_type_args = if subst == 0 { type_args } else { type_list_subst(type_args, subst) }
      return pipeline_lower_opaque_wrap_node(declaration, concrete_type_args, node_f3(inner_call), node_f4(inner_call), next_value, lower_ctx)
    } else { 0 }
  } else { 0 }
  if inner_call != 0 and node_tag(inner_call) == 32 and pipeline_node_declaration_access(node_f1(inner_call)) != 0 {
    pipeline_lower_decl_generic_call_typed(
      pipeline_node_declaration_access(node_f1(inner_call)),
      type_expr_list_from_type_nodes(type_args),
      expr_list_from_nodes(node_f4(inner_call), 0, nlist_len(node_f4(inner_call))),
      next_value,
      lower_ctx
    )
  } else { if inner_call != 0 and node_tag(inner_call) == 2 {
    let ns = node_f1(inner_call)
    let nl = node_f2(inner_call)
    let template_pair = pipeline_generic_template_find_resolved(fns, tt, src, ns, nl)
    let base_hash = if template_pair == 0 { str_hash(src, ns, nl) } else { pipeline_fn_pair_key(template_pair) }
    if template_pair == 0 {
      ir_lowered_expr_invalid(next_value)
    } else {
      let concrete_type_args = if subst == 0 { type_args } else { type_list_subst(type_args, subst) }
      ir_lowered_expr(
        next_value,
        next_value + 1,
        ir_inst_list_prepend(
          ir_inst_generic_function_ref_i64(next_value, base_hash, type_expr_list_from_type_nodes(concrete_type_args)),
          ir_inst_list_empty()
        )
      )
    }
  } else { if inner_call != 0 and node_tag(inner_call) == 4 {
    let ns = node_f1(inner_call)
    let nl = node_f2(inner_call)
    let args = node_f3(inner_call)
    let arg_count = node_f4(inner_call)
    if pipeline_variant_payload_count(tt, src, ns, nl) >= 0 or pipeline_call_callee_is_direct(params, locals, src, ns, nl) == 1 {
      let concrete_type_args = if subst == 0 { type_args } else { type_list_subst(type_args, subst) }
      let variant_payloads = pipeline_variant_payload_types(tt, src, ns, nl)
      let variant_tparams = if variant_payloads == 0 { 0 } else { ttable_variant_tparams(tt, src, ns, nl) }
      let template_pair = if variant_payloads == 0 { pipeline_generic_template_find_resolved(fns, tt, src, ns, nl) } else { 0 }
      let call_type_args = pipeline_shape_call_type_args_node(template_pair, concrete_type_args, args, arg_count, params, locals, pipeline_handler_lower_ctx_module(lower_ctx))
      let expected_params = if template_pair == 0 { 0 } else {
        cg_params_shape_specialise(
          node_f3(pipeline_fn_inner(node_f1(template_pair))),
          fn_tparams(node_f1(template_pair)),
          call_type_args
        )
      }
      let expected_subst = if variant_payloads != 0 {
        if variant_tparams == 0 { subst } else { cg_build_subst(variant_tparams, call_type_args) }
      } else {
        if template_pair == 0 { 0 } else { cg_build_subst(fn_tparams(node_f1(template_pair)), call_type_args) }
      }
      let stable_handle_word = pipeline_collection_handle_word_stable_call(src, ns, nl, expr_list_from_nodes(args, 0, arg_count))
      let borrowed_mask = if stable_handle_word == 1 { 1 }
      else { if variant_payloads == 0 and template_pair != 0 {
        pipeline_fn_effective_borrowable_param_mask_from_pair(fns, template_pair, expected_params, expected_subst)
      } else { 0 } }
      let lowered_args = if variant_payloads != 0 {
        pipeline_lower_node_handler_opt_args_expected_offset_borrow_mask_origin(args, arg_count, 0, next_value, lower_ctx, 0, variant_payloads, expected_subst, 0, 0, ir_managed_stake_origin_aggregate())
      } else {
        pipeline_lower_node_handler_opt_args_expected_offset_borrow_mask(args, arg_count, 0, next_value, lower_ctx, expected_params, 0, expected_subst, 0, borrowed_mask)
      }
      if pipeline_lowered_args_is_valid(lowered_args) == 1 {
        let dst = pipeline_lowered_args_next_value(lowered_args)
        let logical_args = pipeline_lowered_args_values(lowered_args)
        let storage_ty = if nlist_len(call_type_args) == 1 { nlist_get(call_type_args, 0) } else { 0 }
        let structural_storage = pipeline_lower_structural_vector_storage_call(str_hash(src, ns, nl), storage_ty, logical_args, dst, tt)
        let abi_args = if variant_payloads != 0 {
          pipeline_call_abi_args(logical_args, 0, variant_payloads, expected_subst, 0, 0)
        } else { if template_pair != 0 and stable_handle_word == 0 {
          pipeline_call_abi_args(logical_args, expected_params, 0, expected_subst, 0, 0)
        } else { logical_args } }
        let call_head = ir_inst_list_prepend(
          if stable_handle_word == 1 {
            pipeline_collection_handle_word_inst(dst, logical_args)
          } else {
            pipeline_generic_call_inst(dst, src, tt, fns, ns, nl, call_type_args, abi_args)
          },
          ir_inst_list_empty()
        )
        let result_ty = if template_pair == 0 { 0 } else { pipeline_function_return_type_with_subst(node_f1(template_pair), expected_subst, tt) }
        let call = if ir_lowered_expr_is_valid(structural_storage) == 1 {
          ir_lowered_expr_insts(structural_storage)
        } else { if template_pair != 0 and stable_handle_word == 0 {
          ir_inst_list_append(call_head, pipeline_ir_call_result_lane_insts(dst, result_ty))
        } else { call_head } }
        let result_value = if ir_lowered_expr_is_valid(structural_storage) == 1 { ir_lowered_expr_value(structural_storage) } else { dst }
        let result_lanes = if ir_lowered_expr_is_valid(structural_storage) == 1 { pipeline_type_value_lane_count_or_one(result_ty) }
          else { if template_pair != 0 and stable_handle_word == 0 { pipeline_type_value_lane_count_or_one(result_ty) } else { 1 } }
        let cleanup_start = if ir_lowered_expr_is_valid(structural_storage) == 1 { ir_lowered_expr_next_value(structural_storage) } else { dst + result_lanes }
        let linear_transfers = if variant_payloads != 0 {
          pipeline_aggregate_linear_transfer_insts_node(
            args, arg_count, variant_payloads, expected_subst, 0, 0, abi_args, lower_ctx
          )
        } else { if expected_params != 0 {
          pipeline_effect_linear_transfer_insts_node(
            args, arg_count, expected_params, 0, 0, abi_args, lower_ctx
          )
        } else { ir_inst_list_empty() } }
        let cleanup = pipeline_managed_lambda_temp_release_arg_nodes_masked(args, arg_count, logical_args, 0, cleanup_start, borrowed_mask, 0, expected_params, variant_payloads, expected_subst, pipeline_handler_lower_ctx_src(lower_ctx), pipeline_handler_lower_ctx_tt(lower_ctx))
        ir_lowered_expr(result_value, pipeline_lowered_args_next_value(cleanup), ir_inst_list_append(pipeline_lowered_args_insts(lowered_args), ir_inst_list_append(linear_transfers, ir_inst_list_append(call, pipeline_lowered_args_insts(cleanup)))))
      } else {
        ir_lowered_expr_invalid(next_value)
      }
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  } } }
}

pub(package) fn pipeline_lower_method_call_node_typed_sidecar_handler_opt(recv_node: i64, method_hash: i64, args: i64, arg_count: i64, method_ref: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  let receiver = pipeline_lower_expr_node_typed_sidecar_handler_ctx(recv_node, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(receiver) == 1 {
    let associated = method_ref_is_associated(method_ref)
    let param_offset = if associated { 0 } else { 1 }
    let method_params = pipeline_method_ref_params(tt, method_ref, method_hash, subst)
    let receiver_ty = pipeline_method_ref_receiver_type(tt, method_ref, method_hash, subst)
    let result_ty = pipeline_method_ref_result_type(tt, method_ref, method_hash, subst)
    let result_lanes = pipeline_type_value_lane_count_or_one(result_ty)
    let borrowed_mask = pipeline_method_ref_borrowable_param_mask(pipeline_handler_lower_ctx_fns(lower_ctx), tt, method_ref, method_hash, subst)
    let receiver_retain = if associated { pipeline_lowered_args(ir_value_list_empty(), ir_lowered_expr_next_value(receiver), ir_inst_list_empty(), 1) }
      else { pipeline_managed_method_receiver_transport_retain_node(recv_node, ir_lowered_expr_value(receiver), receiver_ty, ir_lowered_expr_next_value(receiver), borrowed_mask, pipeline_handler_lower_ctx_src(lower_ctx), pipeline_handler_lower_ctx_fns(lower_ctx), subst, tt) }
    let lowered_args = pipeline_lower_node_handler_opt_args_expected_offset_borrow_mask(args, arg_count, 0, pipeline_lowered_args_next_value(receiver_retain), lower_ctx, method_params, 0, 0, param_offset, borrowed_mask)
    if pipeline_lowered_args_is_valid(lowered_args) == 1 {
      let dst = pipeline_lowered_args_next_value(lowered_args)
      let method_call = pipeline_method_call_inst(dst, method_ref, method_hash, ir_lowered_expr_value(receiver), pipeline_lowered_args_values(lowered_args), subst, tt)
      let call_head = ir_inst_list_prepend(method_call, ir_inst_list_empty())
      let receiver_transfer = if associated { ir_inst_list_empty() }
        else { pipeline_method_receiver_linear_transfer_insts_node(recv_node, ir_lowered_expr_value(receiver), method_params, lower_ctx) }
      let managed_transfers = pipeline_direct_managed_transfer_insts(
        method_params, 0, borrowed_mask, method_call, tt
      )
      let call = ir_inst_list_append(receiver_transfer, ir_inst_list_append(managed_transfers, ir_inst_list_append(call_head, pipeline_ir_call_result_lane_insts(dst, result_ty))))
      let receiver_cleanup = if associated { pipeline_lowered_args(ir_value_list_empty(), dst + result_lanes, ir_inst_list_empty(), 1) }
        else { pipeline_managed_method_receiver_temp_release_node(recv_node, ir_lowered_expr_value(receiver), receiver_ty, result_ty, dst + result_lanes, borrowed_mask, pipeline_handler_lower_ctx_src(lower_ctx), pipeline_handler_lower_ctx_fns(lower_ctx), subst, tt) }
      let cleanup = pipeline_managed_lambda_temp_release_arg_nodes_masked(args, arg_count, pipeline_lowered_args_values(lowered_args), 0, pipeline_lowered_args_next_value(receiver_cleanup), borrowed_mask, param_offset, method_params, 0, 0, pipeline_handler_lower_ctx_src(lower_ctx), tt)
      ir_lowered_expr(dst, pipeline_lowered_args_next_value(cleanup), ir_inst_list_append(ir_lowered_expr_insts(receiver), ir_inst_list_append(pipeline_lowered_args_insts(receiver_retain), ir_inst_list_append(pipeline_lowered_args_insts(lowered_args), ir_inst_list_append(call, ir_inst_list_append(pipeline_lowered_args_insts(receiver_cleanup), pipeline_lowered_args_insts(cleanup)))))))
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

pub(package) fn pipeline_lower_binop_node_typed_sidecar_handler_opt_with_float_prim(op_id: i64, lhs_node: i64, rhs_node: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx, prim: i64) -> IrLoweredExpr {
  let lhs = pipeline_lower_expr_node_typed_sidecar_handler_opt_with_float_prim(lhs_node, next_value, lower_ctx, prim)
  if ir_lowered_expr_is_valid(lhs) == 1 {
    let rhs = pipeline_lower_expr_node_typed_sidecar_handler_opt_with_float_prim(rhs_node, ir_lowered_expr_next_value(lhs), lower_ctx, prim)
    if ir_lowered_expr_is_valid(rhs) == 1 {
      let op = ir_binary_op_from_parser(op_id)
      if ir_binary_op_is_supported(op) == 1 {
        let dst = ir_lowered_expr_next_value(rhs)
        let inst = ir_inst_list_prepend(
          ir_inst_float_binary_i64(dst, prim, op, ir_lowered_expr_value(lhs), ir_lowered_expr_value(rhs)),
          ir_inst_list_empty()
        )
        ir_lowered_expr(dst, dst + 1, ir_inst_list_append(ir_lowered_expr_insts(lhs), ir_inst_list_append(ir_lowered_expr_insts(rhs), inst)))
      } else {
        ir_lowered_expr_invalid(next_value)
      }
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

pub(package) fn pipeline_lower_expr_node_typed_sidecar_handler_opt_with_float_prim(expr: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx, prim: i64) -> IrLoweredExpr {
  let stripped = pipeline_expr_node_strip_typed(expr)
  if stripped != 0 and node_tag(stripped) == 54 {
    pipeline_lower_float_lit_typed(pipeline_handler_lower_ctx_src(lower_ctx), node_f1(stripped), node_f2(stripped), next_value, prim)
  } else {
    if stripped != 0 and node_tag(stripped) == 3 and pipeline_prim_is_forced_numeric_context(prim) == 1 {
      pipeline_lower_binop_node_typed_sidecar_handler_opt_with_float_prim(node_f1(stripped), node_f2(stripped), node_f3(stripped), next_value, lower_ctx, prim)
    } else {
      pipeline_lower_expr_node_typed_sidecar_handler_ctx(stripped, next_value, lower_ctx)
    }
  }
}

pub(package) fn pipeline_lower_binop_node_typed_sidecar_handler_opt(op_id: i64, lhs_node: i64, rhs_node: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  let float_prim = pipeline_binop_float_prim_node_temp(op_id, lhs_node, rhs_node, params, locals, src, pipeline_handler_lower_ctx_fns(lower_ctx), subst)
  let int_prim = if float_prim == 0 {
    pipeline_binop_int_prim_node(op_id, lhs_node, rhs_node, params, locals, src, tt, pipeline_handler_lower_ctx_fns(lower_ctx), subst)
  } else { 0 - 1 }
  let numeric_prim = if float_prim != 0 { float_prim } else { int_prim }
  let lhs = if float_prim != 0 or int_prim >= 0 {
    pipeline_lower_expr_node_typed_sidecar_handler_opt_with_float_prim(lhs_node, next_value, lower_ctx, numeric_prim)
  } else {
    pipeline_lower_expr_node_typed_sidecar_handler_ctx(lhs_node, next_value, lower_ctx)
  }
  if ir_lowered_expr_is_valid(lhs) == 1 {
    let rhs = if float_prim != 0 or int_prim >= 0 {
      pipeline_lower_expr_node_typed_sidecar_handler_opt_with_float_prim(rhs_node, ir_lowered_expr_next_value(lhs), lower_ctx, numeric_prim)
    } else {
      pipeline_lower_expr_node_typed_sidecar_handler_ctx(rhs_node, ir_lowered_expr_next_value(lhs), lower_ctx)
    }
    if ir_lowered_expr_is_valid(rhs) == 1 {
      let op = ir_binary_op_from_parser(op_id)
      if ir_binary_op_is_supported(op) == 1 {
        let dst = ir_lowered_expr_next_value(rhs)
        -- Same content-eq selection as the straight-line paths (see
        -- pipeline_lower_binop_lhs_cfg_to_target_blocks).
        let str_eq = if float_prim == 0 and int_prim < 0 { pipeline_binop_is_str_content_eq(op_id, expr_from_node(lhs_node), expr_from_node(rhs_node), params, locals, src, tt, pipeline_handler_lower_ctx_fns(lower_ctx), subst) } else { 0 }
        let binary = if str_eq == 1 {
          pipeline_str_content_eq_insts(op_id, dst, ir_lowered_expr_value(lhs), ir_lowered_expr_value(rhs))
        } else {
          let inst = if float_prim != 0 {
            ir_inst_float_binary_i64(dst, float_prim, op, ir_lowered_expr_value(lhs), ir_lowered_expr_value(rhs))
          } else { if int_prim >= 0 {
            ir_inst_float_binary_i64(dst, int_prim, op, ir_lowered_expr_value(lhs), ir_lowered_expr_value(rhs))
          } else {
            ir_inst_binary_i64(dst, op, ir_lowered_expr_value(lhs), ir_lowered_expr_value(rhs))
          } }
          ir_inst_list_prepend(inst, ir_inst_list_empty())
        }
        let result = if str_eq == 1 { pipeline_str_content_eq_result(op_id, dst) } else { dst }
        ir_lowered_expr(result, result + 1, ir_inst_list_append(ir_lowered_expr_insts(lhs), ir_inst_list_append(ir_lowered_expr_insts(rhs), binary)))
      } else {
        ir_lowered_expr_invalid(next_value)
      }
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

pub(package) fn pipeline_lower_not_node_typed_sidecar_handler_opt(operand_node: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let value = pipeline_lower_expr_node_typed_sidecar_handler_ctx(operand_node, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(value) == 1 {
    let dst = ir_lowered_expr_next_value(value)
    let unary = ir_inst_list_prepend(ir_inst_unary_i64(dst, ir_unary_op_not(), ir_lowered_expr_value(value)), ir_inst_list_empty())
    ir_lowered_expr(dst, dst + 1, ir_inst_list_append(ir_lowered_expr_insts(value), unary))
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

pub(package) fn pipeline_lower_block_node_typed_sidecar_handler_opt(first_node: i64, rest_node: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let first = pipeline_lower_expr_node_typed_sidecar_handler_ctx(first_node, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(first) == 1 {
    if rest_node == 0 {
      first
    } else {
      let rest = pipeline_lower_expr_node_typed_sidecar_handler_ctx(rest_node, ir_lowered_expr_next_value(first), lower_ctx)
      if ir_lowered_expr_is_valid(rest) == 1 {
        ir_lowered_expr(ir_lowered_expr_value(rest), ir_lowered_expr_next_value(rest), ir_inst_list_append(ir_lowered_expr_insts(first), ir_lowered_expr_insts(rest)))
      } else {
        ir_lowered_expr_invalid(next_value)
      }
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

pub(package) fn pipeline_lower_let_node_typed_sidecar_handler_opt_with_float_prim(ns: i64, nl: i64, value_node: i64, body_node: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx, local_float: i64, local_type_node: i64) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let handlers = pipeline_handler_lower_ctx_handlers(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  let value = if pipeline_prim_is_forced_numeric_context(local_float) == 1 {
    pipeline_lower_expr_node_typed_sidecar_handler_opt_with_float_prim(value_node, next_value, lower_ctx, local_float)
  } else {
    pipeline_lower_expr_node_typed_sidecar_handler_ctx(value_node, next_value, lower_ctx)
  }
  if ir_lowered_expr_is_valid(value) == 1 {
    let inferred_float_prim = pipeline_expr_float_prim_node_temp(value_node, params, locals, src, pipeline_handler_lower_ctx_fns(lower_ctx), subst)
    let float_prim = if local_float == PRIM_F32() or local_float == PRIM_F64() { local_float } else { inferred_float_prim }
    let inferred_type_hash = pipeline_expr_type_hash_node_temp(value_node, params, locals, src, tt, pipeline_handler_lower_ctx_fns(lower_ctx), subst)
    let inferred_type_node = pipeline_init_type_node_from_node(value_node, params, locals, pipeline_handler_lower_ctx_module(lower_ctx))
    let effective_type_node = if local_type_node != 0 { ty_subst(local_type_node, subst) } else { inferred_type_node }
    let local_lanes = pipeline_type_value_lane_count_or_one(effective_type_node)
    let annotated_type_hash = if local_type_node != 0 and effective_type_node != 0 { type_hash_of(effective_type_node) } else { 0 }
    let inferred_node_type_hash = if effective_type_node != 0 { type_hash_of(effective_type_node) } else { 0 }
    let local_type_hash = if annotated_type_hash != 0 { annotated_type_hash } else { if inferred_node_type_hash != 0 { inferred_node_type_hash } else { if local_float != 0 and pipeline_prim_is_numeric_context(local_float) == 1 { pipeline_type_hash_of_prim_id(local_float) } else { pipeline_expr_type_hash_sharpen_int_node(value_node, inferred_type_hash, params, locals, src, tt, pipeline_handler_lower_ctx_fns(lower_ctx), subst) } } }
    let address_taken = pipeline_expr_node_address_of_binding(body_node, src, ns, nl)
    let slot = pipeline_ir_addressable_slot_id(ir_lowered_expr_next_value(value))
    let bind_value_for_retain = if address_taken == 1 { slot } else { ir_lowered_expr_value(value) }
    let retain_insts = if address_taken == 1 or pipeline_expr_node_result_is_borrowed_for_ty_typed(value_node, effective_type_node, src, pipeline_handler_lower_ctx_fns(lower_ctx), subst, pipeline_handler_lower_ctx_tt(lower_ctx)) == 0 {
      ir_inst_list_empty()
    } else {
      pipeline_managed_retain_inst_list_with_origin(bind_value_for_retain, effective_type_node, ir_lowered_expr_next_value(value), ir_managed_stake_origin_binding())
    }
    let body_next = if address_taken == 1 {
      slot + local_lanes
    } else {
      ir_lowered_expr_next_value(value) + ir_inst_list_len(retain_insts)
    }
    let next_locals = if address_taken == 1 {
      pipeline_value_env_push_slot_float_typed_node(locals, ns, nl, slot, float_prim, local_type_hash, effective_type_node)
    } else {
      pipeline_value_env_push_float_typed_node(locals, ns, nl, ir_lowered_expr_value(value), float_prim, local_type_hash, effective_type_node)
    }
    let body_ctx = pipeline_handler_lower_ctx_from_module(params, next_locals, pipeline_handler_lower_ctx_module(lower_ctx))
    let body = pipeline_lower_expr_node_typed_sidecar_handler_ctx(body_node, body_next, body_ctx)
    if ir_lowered_expr_is_valid(body) == 1 {
      let bind_value = if address_taken == 1 { slot } else { ir_lowered_expr_value(value) }
      let bind = ir_inst_list_prepend(ir_inst_bind_typed_i64(ns, nl, bind_value, effective_type_node), ir_inst_list_empty())
      let slot_insts = if address_taken == 1 {
        pipeline_ir_slot_lane_init_insts(slot, ir_lowered_expr_value(value), 0, local_lanes)
      } else { ir_inst_list_empty() }
      let release_dst = ir_lowered_expr_next_value(body)
      let body_returns_binding = pipeline_expr_node_final_returns_binding(body_node, src, ns, nl)
      let linear_plan = if effective_type_node != 0 { pipeline_linear_cleanup_plan(tt, effective_type_node) } else { 0 }
      let release_insts = if address_taken == 1 or body_returns_binding == 1 or linear_plan != 0 { ir_inst_list_empty() } else { pipeline_managed_release_inst_list_with_origin(bind_value, effective_type_node, release_dst, ir_managed_stake_origin_binding()) }
      -- Owned bindings drop at scope exit; see the expr variant for the
      -- never-referenced rule shared with defer-owned lowering.
      let owned_drop_insts = if linear_plan != 0 and address_taken == 0 and pipeline_expr_refs_name(body_node, src, ns, nl) == 0 {
        pipeline_linear_cleanup_inst_list(bind_value, linear_plan)
      } else { ir_inst_list_empty() }
      let next_after_release = release_dst + ir_inst_list_len(release_insts)
      ir_lowered_expr(
        ir_lowered_expr_value(body),
        next_after_release,
        ir_inst_list_append(ir_lowered_expr_insts(value), ir_inst_list_append(slot_insts, ir_inst_list_append(retain_insts, ir_inst_list_append(bind, ir_inst_list_append(ir_lowered_expr_insts(body), ir_inst_list_append(owned_drop_insts, release_insts))))))
      )
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

pub(package) fn pipeline_lower_let_mut_node_typed_sidecar_handler_opt_with_float_prim(ns: i64, nl: i64, value_node: i64, body_node: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx, local_float: i64, local_type_node: i64) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let handlers = pipeline_handler_lower_ctx_handlers(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  let value = if pipeline_prim_is_forced_numeric_context(local_float) == 1 {
    pipeline_lower_expr_node_typed_sidecar_handler_opt_with_float_prim(value_node, next_value, lower_ctx, local_float)
  } else {
    pipeline_lower_expr_node_typed_sidecar_handler_ctx(value_node, next_value, lower_ctx)
  }
  if ir_lowered_expr_is_valid(value) == 1 {
    let address_taken = pipeline_expr_node_address_of_binding(body_node, src, ns, nl)
    let slot = if address_taken == 1 {
      pipeline_ir_addressable_slot_id(ir_lowered_expr_next_value(value))
    } else {
      ir_lowered_expr_next_value(value)
    }
    let inferred_float_prim = pipeline_expr_float_prim_node_temp(value_node, params, locals, src, pipeline_handler_lower_ctx_fns(lower_ctx), subst)
    let float_prim = if local_float == PRIM_F32() or local_float == PRIM_F64() { local_float } else { inferred_float_prim }
    let inferred_type_hash = pipeline_expr_type_hash_node_temp(value_node, params, locals, src, tt, pipeline_handler_lower_ctx_fns(lower_ctx), subst)
    let inferred_type_node = pipeline_init_type_node_from_node(value_node, params, locals, pipeline_handler_lower_ctx_module(lower_ctx))
    let effective_type_node = if local_type_node != 0 { ty_subst(local_type_node, subst) } else { inferred_type_node }
    let local_lanes = pipeline_type_value_lane_count_or_one(effective_type_node)
    let slot_insts = pipeline_ir_slot_lane_init_insts(slot, ir_lowered_expr_value(value), 0, local_lanes)
    let annotated_type_hash = if local_type_node != 0 and effective_type_node != 0 { type_hash_of(effective_type_node) } else { 0 }
    let inferred_node_type_hash = if effective_type_node != 0 { type_hash_of(effective_type_node) } else { 0 }
    let local_type_hash = if annotated_type_hash != 0 { annotated_type_hash } else { if inferred_node_type_hash != 0 { inferred_node_type_hash } else { if local_float != 0 and pipeline_prim_is_numeric_context(local_float) == 1 { pipeline_type_hash_of_prim_id(local_float) } else { pipeline_expr_type_hash_sharpen_int_node(value_node, inferred_type_hash, params, locals, src, tt, pipeline_handler_lower_ctx_fns(lower_ctx), subst) } } }
    let retain_insts = if effective_type_node != 0 and pipeline_expr_node_result_is_borrowed_for_ty_typed(value_node, effective_type_node, src, pipeline_handler_lower_ctx_fns(lower_ctx), subst, pipeline_handler_lower_ctx_tt(lower_ctx)) == 1 {
      pipeline_managed_retain_inst_list_with_origin(ir_lowered_expr_value(value), effective_type_node, slot + local_lanes, ir_managed_stake_origin_binding())
    } else {
      ir_inst_list_empty()
    }
    let body_next_value = slot + local_lanes + ir_inst_list_len(retain_insts)
    let next_locals = pipeline_value_env_push_slot_float_typed_node(locals, ns, nl, slot, float_prim, local_type_hash, effective_type_node)
    let body_ctx = pipeline_handler_lower_ctx_from_module(params, next_locals, pipeline_handler_lower_ctx_module(lower_ctx))
    let body = pipeline_lower_expr_node_typed_sidecar_handler_ctx(body_node, body_next_value, body_ctx)
    if ir_lowered_expr_is_valid(body) == 1 {
      let bind = ir_inst_list_prepend(ir_inst_bind_typed_i64(ns, nl, slot, effective_type_node), ir_inst_list_empty())
      -- Straight node-side lowering is the normal path for non-CFG
      -- functions. Keep its mutable-slot lifetime contract identical to the
      -- typed path: the final slot value, not merely the initializer, owns
      -- the scope stake. Indexed COW mutation depends on this load-after-
      -- store cleanup to release the replacement backing.
      let linear_plan = pipeline_linear_cleanup_plan(tt, effective_type_node)
      let scope_needs_release = if address_taken == 1 or effective_type_node == 0 { 0 }
        else { if linear_plan != 0 {
          if pipeline_expr_refs_name(body_node, src, ns, nl) == 0 { 1 } else { 0 }
        } else {
          if pipeline_expr_node_final_returns_binding(body_node, src, ns, nl) == 1 { 0 }
          else { ty_value_has_release_lane(effective_type_node) }
        } }
      let cleanup_insts = if scope_needs_release == 1 { pipeline_slot_cleanup_inst_list_with_plan(slot, effective_type_node, linear_plan, ir_lowered_expr_next_value(body)) } else { ir_inst_list_empty() }
      let after_cleanup = ir_lowered_expr_next_value(body) + ir_inst_list_len(cleanup_insts)
      let rebind_insts = pipeline_ir_structural_slot_rebind_insts(ir_lowered_expr_value(value), slot, linear_plan)
      ir_lowered_expr(ir_lowered_expr_value(body), after_cleanup, ir_inst_list_append(ir_lowered_expr_insts(value), ir_inst_list_append(slot_insts, ir_inst_list_append(retain_insts, ir_inst_list_append(bind, ir_inst_list_append(rebind_insts, ir_inst_list_append(ir_lowered_expr_insts(body), cleanup_insts)))))))
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

pub(package) fn pipeline_lower_assign_node_typed_sidecar_handler_opt(ns: i64, nl: i64, value_node: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  let slot = pipeline_value_env_lookup(locals, src, ns, nl)
  if slot >= 0 and pipeline_value_env_lookup_kind(locals, src, ns, nl) == 1 {
    let slot_float = pipeline_value_env_lookup_float_prim(locals, src, ns, nl)
    let slot_int = if slot_float == 0 { pipeline_type_hash_int_prim_or(pipeline_value_env_lookup_type_hash(locals, src, ns, nl), 0 - 1) } else { 0 - 1 }
    let slot_prim = if slot_float == PRIM_F32() or slot_float == PRIM_F64() { slot_float } else { slot_int }
    let slot_ty = pipeline_value_env_lookup_type_node(locals, src, ns, nl)
    let slot_lanes = pipeline_type_value_lane_count_or_one(slot_ty)
    let value = if pipeline_prim_is_forced_numeric_context(slot_prim) == 1 {
      pipeline_lower_expr_node_typed_sidecar_handler_opt_with_float_prim(value_node, next_value, lower_ctx, slot_prim)
    } else {
      pipeline_lower_expr_node_typed_sidecar_handler_ctx(value_node, next_value, lower_ctx)
    }
    if ir_lowered_expr_is_valid(value) == 1 {
      let retain_insts = if slot_ty != 0 and pipeline_expr_node_result_is_borrowed_for_ty_typed(value_node, slot_ty, src, pipeline_handler_lower_ctx_fns(lower_ctx), subst, pipeline_handler_lower_ctx_tt(lower_ctx)) == 1 {
        pipeline_managed_retain_inst_list_with_origin(ir_lowered_expr_value(value), slot_ty, ir_lowered_expr_next_value(value), ir_managed_stake_origin_binding())
      } else {
        ir_inst_list_empty()
      }
      let after_retain = ir_lowered_expr_next_value(value) + ir_inst_list_len(retain_insts)
      let linear_plan = pipeline_linear_cleanup_plan(tt, slot_ty)
      let cleanup_insts = pipeline_slot_cleanup_inst_list_with_plan(slot, slot_ty, linear_plan, after_retain)
      let nil_value = after_retain + ir_inst_list_len(cleanup_insts)
      let assign_insts = ir_inst_list_append(
        pipeline_ir_slot_store_lane_insts(slot, ir_lowered_expr_value(value), 0, slot_lanes),
        ir_inst_list_append(
          pipeline_ir_structural_slot_rebind_insts(ir_lowered_expr_value(value), slot, linear_plan),
          ir_inst_list_prepend(ir_inst_const_i64(nil_value, 0), ir_inst_list_empty())
        )
      )
      let update_insts = ir_inst_list_append(retain_insts, ir_inst_list_append(cleanup_insts, assign_insts))
      ir_lowered_expr(nil_value, nil_value + 1, ir_inst_list_append(ir_lowered_expr_insts(value), update_insts))
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

pub(package) fn pipeline_lower_address_of_node_typed_sidecar_handler_opt(mutable: i64, target: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  if target != 0 and node_tag(target) == 2 {
    let ns = node_f1(target)
    let nl = node_f2(target)
    let local = pipeline_value_env_lookup(locals, src, ns, nl)
    if local >= 0 {
      if pipeline_value_env_lookup_kind(locals, src, ns, nl) == 1 {
        ir_lowered_expr(next_value, next_value + 1, ir_inst_list_prepend(ir_inst_address_of_slot_i64(next_value, local), ir_inst_list_empty()))
      } else {
        let slot = pipeline_ir_addressable_slot_id(next_value)
        let local_ty = pipeline_value_env_lookup_type_node(locals, src, ns, nl)
        let lanes = pipeline_type_value_lane_count_or_one(local_ty)
        let ptr = slot + lanes
        let insts = ir_inst_list_append(
          pipeline_ir_slot_lane_init_insts(slot, local, 0, lanes),
          ir_inst_list_prepend(ir_inst_address_of_slot_i64(ptr, slot), ir_inst_list_empty())
        )
        ir_lowered_expr(ptr, ptr + 1, insts)
      }
    } else {
      let param_id = if params == 0 { 0 - 1 } else { pipeline_param_index(params, src, ns, nl) }
      if param_id >= 0 {
        let slot = pipeline_ir_addressable_slot_id(next_value)
        let param_ty = pipeline_param_type_node_by_name(params, src, ns, nl, pipeline_handler_lower_ctx_subst(lower_ctx))
        let lanes = pipeline_type_value_lane_count_or_one(param_ty)
        let ptr = slot + lanes
        let insts = ir_inst_list_append(
          pipeline_ir_slot_lane_init_insts(slot, param_id, 0, lanes),
          ir_inst_list_prepend(ir_inst_address_of_slot_i64(ptr, slot), ir_inst_list_empty())
        )
        ir_lowered_expr(ptr, ptr + 1, insts)
      } else {
        ir_lowered_expr_invalid(next_value)
      }
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

pub(package) fn pipeline_lower_deref_node_typed_sidecar_handler_opt(ptr_node: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let ptr = pipeline_lower_expr_node_typed_sidecar_handler_ctx(ptr_node, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(ptr) == 1 {
    let dst = ir_lowered_expr_next_value(ptr)
    let inst = ir_inst_list_prepend(ir_inst_ptr_load_i64(dst, ir_lowered_expr_value(ptr)), ir_inst_list_empty())
    ir_lowered_expr(dst, dst + 1, ir_inst_list_append(ir_lowered_expr_insts(ptr), inst))
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

pub(package) fn pipeline_lower_ptr_assign_node_typed_sidecar_handler_opt(ptr_node: i64, value_node: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let ptr = pipeline_lower_expr_node_typed_sidecar_handler_ctx(ptr_node, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(ptr) == 1 {
    let value = pipeline_lower_expr_node_typed_sidecar_handler_ctx(value_node, ir_lowered_expr_next_value(ptr), lower_ctx)
    if ir_lowered_expr_is_valid(value) == 1 {
      let dst = ir_lowered_expr_next_value(value)
      let inst = ir_inst_list_prepend(ir_inst_ptr_store_i64(dst, ir_lowered_expr_value(ptr), ir_lowered_expr_value(value)), ir_inst_list_empty())
      ir_lowered_expr(dst, dst + 1, ir_inst_list_append(ir_lowered_expr_insts(ptr), ir_inst_list_append(ir_lowered_expr_insts(value), inst)))
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

pub(package) fn pipeline_lower_field_access_node_typed_sidecar_handler_opt(base_node: i64, field_ns: i64, field_nl: i64, access_fact_node: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  pipeline_lower_field_access_expr_typed_sidecar_handler_opt(
    expr_from_node(base_node),
    field_ns,
    field_nl,
    field_access_fact_from_node(access_fact_node),
    next_value,
    lower_ctx
  )
}

pub(package) fn pipeline_lower_indexed_len_node_typed_sidecar_handler_opt(base_node: i64, fixed_len: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let base = pipeline_lower_expr_node_typed_sidecar_handler_ctx(base_node, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(base) == 1 {
    let base_expr = expr_from_node(base_node)
    let result = pipeline_lower_indexed_len_after_base_typed(base_expr, fixed_len, ir_lowered_expr_value(base), ir_lowered_expr_next_value(base), lower_ctx)
    ir_lowered_expr(ir_lowered_expr_value(result), ir_lowered_expr_next_value(result), ir_inst_list_append(ir_lowered_expr_insts(base), ir_lowered_expr_insts(result)))
  } else { ir_lowered_expr_invalid(next_value) }
}

pub(package) fn pipeline_lower_indexed_get_node_typed_sidecar_handler_opt(base_node: i64, index_node: i64, element_ty: i64, fixed_len: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let base = pipeline_lower_expr_node_typed_sidecar_handler_ctx(base_node, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(base) == 0 { ir_lowered_expr_invalid(next_value) }
  else {
    let index = pipeline_lower_expr_node_typed_sidecar_handler_ctx(index_node, ir_lowered_expr_next_value(base), lower_ctx)
    if ir_lowered_expr_is_valid(index) == 0 { ir_lowered_expr_invalid(next_value) }
    else {
      let loaded = pipeline_lower_indexed_get_after_values_typed(expr_from_node(base_node), expr_from_node(index_node), element_ty, fixed_len, ir_lowered_expr_value(base), ir_lowered_expr_value(index), ir_lowered_expr_next_value(index), lower_ctx)
      ir_lowered_expr(ir_lowered_expr_value(loaded), ir_lowered_expr_next_value(loaded), ir_inst_list_append(ir_lowered_expr_insts(base), ir_inst_list_append(ir_lowered_expr_insts(index), ir_lowered_expr_insts(loaded))))
    }
  }
}

pub(package) fn pipeline_lower_indexed_set_node_typed_sidecar_handler_opt(base_node: i64, index_node: i64, value_node: i64, fact: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  pipeline_lower_indexed_set_expr_typed_sidecar_handler_opt(expr_from_node(base_node), expr_from_node(index_node), expr_from_node(value_node), fact, next_value, lower_ctx)
}

pub(package) fn pipeline_lower_indexed_slice_node_typed_sidecar_handler_opt(base_node: i64, start_node: i64, end_node: i64, fact: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  pipeline_lower_indexed_slice_expr_typed_sidecar_handler_opt(expr_from_node(base_node), expr_from_node(start_node), expr_from_node(end_node), fact, next_value, lower_ctx)
}

pub(package) fn pipeline_lower_opt_chain_node_typed_sidecar_handler_opt(base_node: i64, field_ns: i64, field_nl: i64, effect_atom: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let base = pipeline_lower_expr_node_typed_sidecar_handler_ctx(base_node, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(base) == 1 {
    let dst = ir_lowered_expr_next_value(base)
    let effect_key = pipeline_effect_atom_dispatch_key(effect_atom, pipeline_handler_lower_ctx_subst(lower_ctx), effect_maybe_head_hash())
    let storage_layout = pipeline_record_storage_layout_for_base_node(tt, src, base_node, pipeline_handler_lower_ctx_params(lower_ctx), pipeline_handler_lower_ctx_locals(lower_ctx), pipeline_handler_lower_ctx_module(lower_ctx))
    let opt = pipeline_ir_opt_chain_insts_for_storage_layout(dst, ir_lowered_expr_value(base), str_hash(src, field_ns, field_nl), pipeline_typed_field_index_for_base_node(tt, src, field_ns, field_nl, base_node, pipeline_handler_lower_ctx_params(lower_ctx), pipeline_handler_lower_ctx_locals(lower_ctx), pipeline_handler_lower_ctx_module(lower_ctx)), effect_key, storage_layout)
    ir_lowered_expr(dst, dst + 1, ir_inst_list_append(ir_lowered_expr_insts(base), opt))
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

pub(package) fn pipeline_lower_record_init_node_typed_sidecar_handler_opt(type_ns: i64, type_nl: i64, fields: i64, field_count: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let lowered_fields = pipeline_lower_record_field_nodes_handler_opt(fields, field_count, 0, type_ns, type_nl, next_value, lower_ctx)
  if pipeline_lowered_record_fields_is_valid(lowered_fields) == 1 {
    let dst = pipeline_lowered_record_fields_next_value(lowered_fields)
    let record_entry = ttable_lookup(pipeline_handler_lower_ctx_tt(lower_ctx), src, type_ns, type_nl)
    let record = ir_inst_list_prepend(
      pipeline_record_init_inst_for_storage_layout(
        pipeline_handler_lower_ctx_tt(lower_ctx),
        record_entry,
        pipeline_handler_lower_ctx_subst(lower_ctx),
        dst,
        str_hash(src, type_ns, type_nl),
        pipeline_lowered_record_fields_values(lowered_fields)
      ),
      ir_inst_list_empty()
    )
    let cleanup = pipeline_record_array_source_releases_for_storage_layout(
      pipeline_handler_lower_ctx_tt(lower_ctx),
      record_entry,
      pipeline_handler_lower_ctx_subst(lower_ctx),
      pipeline_lowered_record_fields_values(lowered_fields),
      dst + 1
    )
    if pipeline_lowered_args_is_valid(cleanup) == 1 {
      ir_lowered_expr(dst, pipeline_lowered_args_next_value(cleanup), ir_inst_list_append(pipeline_lowered_record_fields_insts(lowered_fields), ir_inst_list_append(record, pipeline_lowered_args_insts(cleanup))))
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

pub(package) fn pipeline_lower_try_node_typed_sidecar_handler_opt(inner_node: i64, effect_atom: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let value = pipeline_lower_expr_node_typed_sidecar_handler_ctx(inner_node, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(value) == 1 {
    let dst = ir_lowered_expr_next_value(value)
    let effect_key = pipeline_effect_atom_dispatch_key(effect_atom, pipeline_handler_lower_ctx_subst(lower_ctx), effect_fail_head_hash())
    let inner_ty = pipeline_return_expr_type_node_from_node(inner_node, pipeline_handler_lower_ctx_params(lower_ctx), pipeline_handler_lower_ctx_locals(lower_ctx), pipeline_handler_lower_ctx_module(lower_ctx))
    let try_value_inst = pipeline_try_inst_for_type(dst, ir_lowered_expr_value(value), effect_key, inner_ty, pipeline_handler_lower_ctx_tt(lower_ctx))
    let result_lanes = pipeline_try_success_lane_count(inner_ty)
    let try_insts = pipeline_try_insts(
      try_value_inst, dst, ir_lowered_expr_value(value), result_lanes
    )
    let after_try = if ir_inst_tag(try_value_inst) == 54 {
      pipeline_try_inst_next_value(try_value_inst, dst)
    } else { dst + result_lanes }
    ir_lowered_expr(dst, after_try, ir_inst_list_append(ir_lowered_expr_insts(value), try_insts))
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

pub(package) fn pipeline_lower_interp_concat_node_typed_sidecar_handler_opt(left_node: i64, right_node: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let left = pipeline_lower_expr_node_typed_sidecar_handler_ctx(left_node, next_value, lower_ctx)
  if ir_lowered_expr_is_valid(left) == 1 {
    let right = pipeline_lower_expr_node_typed_sidecar_handler_ctx(right_node, ir_lowered_expr_next_value(left), lower_ctx)
    if ir_lowered_expr_is_valid(right) == 1 {
      let dst = ir_lowered_expr_next_value(right)
      let concat = ir_inst_list_prepend(ir_inst_string_concat_i64(dst, ir_lowered_expr_value(left), ir_lowered_expr_value(right)), ir_inst_list_empty())
      ir_lowered_expr(dst, dst + 1, ir_inst_list_append(ir_lowered_expr_insts(left), ir_inst_list_append(ir_lowered_expr_insts(right), concat)))
    } else {
      ir_lowered_expr_invalid(next_value)
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
}

pub(package) fn pipeline_lower_perform_node_typed_sidecar_handler_opt(lhs_node: i64, op_ns: i64, op_nl: i64, args: i64, arg_count: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let ctx = pipeline_handler_lower_ctx_handlers(lower_ctx)
  let declaration = pipeline_node_declaration_access(lhs_node)
  if declaration != 0 and (module_decl_fact_namespace(declaration) == module_decl_namespace_value() or module_decl_fact_namespace(declaration) == module_decl_namespace_constructor()) {
    pipeline_lower_decl_call_node(declaration, args, arg_count, next_value, lower_ctx)
  } else {
  let effect_ident = effect_ref_ident_node(lhs_node)
  let effect_field = effect_ref_field_node(lhs_node)
  if effect_ident != 0 or effect_field != 0 {
    let eff_ns = typeck_effect_ref_name_start(lhs_node)
    let eff_nl = if effect_ident != 0 { node_f2(effect_ident) } else { node_f3(effect_field) }
    let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
    let local_recv_ty = if effect_ident == 0 { 0 } else { pipeline_value_env_lookup_type_node(locals, src, eff_ns, eff_nl) }
    let recv_ty = if effect_ident == 0 { 0 } else { if local_recv_ty != 0 {
      ty_subst(local_recv_ty, subst)
    } else {
      pipeline_param_type_node_by_name(params, src, eff_ns, eff_nl, subst)
    } }
    let method_hash = effect_name_hash(src, op_ns, op_nl)
    let method_ref = pipeline_resolve_method_ref(pipeline_handler_lower_ctx_tt(lower_ctx), recv_ty, method_hash)
    if method_ref != 0 {
      pipeline_lower_method_call_node_typed_sidecar_handler_opt(lhs_node, method_hash, args, arg_count, method_ref, next_value, lower_ctx)
    } else {
      let effect_ref = expr_from_node(lhs_node)
      let expected_params = pipeline_effect_op_params_nodes_typed(pipeline_handler_lower_ctx_tt(lower_ctx), src, effect_ref, op_ns, op_nl, subst)
      let return_ty = pipeline_effect_op_return_type_typed(pipeline_handler_lower_ctx_tt(lower_ctx), src, effect_ref, op_ns, op_nl, subst)
      let result_lanes = pipeline_type_value_lane_count_or_one(return_ty)
      let lowered_args = pipeline_lower_node_handler_opt_args_expected(args, arg_count, next_value, lower_ctx, expected_params, 0)
      if pipeline_lowered_args_is_valid(lowered_args) == 1 {
        let dst = pipeline_lowered_args_next_value(lowered_args)
        let logical_args = pipeline_lowered_args_values(lowered_args)
        let abi_args = pipeline_call_abi_args(logical_args, expected_params, 0, 0, 0, 0)
        let eff_hash = pipeline_effect_ref_dispatch_key_node(src, lhs_node, subst)
        let op_hash = effect_name_hash(src, op_ns, op_nl)
        let found = pipeline_handler_inline_ctx_find_match(ctx, src, eff_hash, op_hash)
        let tail_inline = pipeline_handler_inline_try_tail_resume(ctx, found, logical_args, pipeline_handler_lower_ctx_tt(lower_ctx), pipeline_handler_lower_ctx_fns(lower_ctx), dst)
        if ir_lowered_expr_is_valid(tail_inline) == 1 {
          ir_lowered_expr(
            ir_lowered_expr_value(tail_inline),
            ir_lowered_expr_next_value(tail_inline),
            ir_inst_list_append(pipeline_lowered_args_insts(lowered_args), ir_lowered_expr_insts(tail_inline))
          )
        } else {
        let op_inst = if pipeline_handler_inline_match_found(found) == 1 {
          ir_inst_handler_direct_i64(dst, eff_hash, op_hash, pipeline_handler_inline_match_depth_or(found, 0 - 1), pipeline_handler_inline_match_clause_index_or(found, 0 - 1), abi_args)
        } else {
          ir_inst_perform_i64(dst, eff_hash, op_hash, abi_args)
        }
        let transfers = pipeline_effect_linear_transfer_insts_node(
          args, arg_count, expected_params, 0, 0, abi_args, lower_ctx
        )
        let managed_transfers = pipeline_effect_managed_transfer_insts(
          expected_params, 0, 0, abi_args, dst
        )
        let perform = ir_inst_list_append(
          transfers,
          ir_inst_list_append(managed_transfers, ir_inst_list_append(ir_inst_list_prepend(op_inst, ir_inst_list_empty()), pipeline_ir_call_result_lane_insts(dst, return_ty)))
        )
        let insts = ir_inst_list_append(pipeline_lowered_args_insts(lowered_args), perform)
        ir_lowered_expr(dst, dst + result_lanes, insts)
        }
      } else {
        ir_lowered_expr_invalid(next_value)
      }
    }
  } else {
    ir_lowered_expr_invalid(next_value)
  }
  }
}

pub(package) fn pipeline_lower_handle_node_typed_sidecar_handler_opt(body_node: i64, clauses_node: i64, nclauses: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  if nclauses <= 0 {
    ir_lowered_expr_invalid(next_value)
  } else {
    let params = pipeline_handler_lower_ctx_params(lower_ctx)
    let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
    let src = pipeline_handler_lower_ctx_src(lower_ctx)
    let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
    let ctx = pipeline_handler_lower_ctx_handlers(lower_ctx)
    let clauses = handler_clause_list_from_nodes(clauses_node, 0, nclauses)
    let handle_result_ty = pipeline_return_expr_type_node_from_node(body_node, params, locals, pipeline_handler_lower_ctx_module(lower_ctx))
    let lowered_clauses = pipeline_lower_handler_clauses_typed(clauses, params, locals, pipeline_handler_lower_ctx_module(lower_ctx), handle_result_ty)
    let clause_bodies = pipeline_lowered_handler_clauses_bodies(lowered_clauses)
    if pipeline_handler_clause_list_has_continuation_handler_typed(clauses) == 1 {
      let result_lanes = pipeline_type_value_lane_count_or_one(handle_result_ty)
      let scratch_base = next_value + result_lanes
      let lowered_body = pipeline_lower_deferred_handler_body_typed(expr_from_node(body_node), clauses, NoHandleReturn, lowered_clauses, params, locals, pipeline_handler_lower_ctx_module(lower_ctx))
      let eff_hash = pipeline_handler_clause_dispatch_key_typed(src, handler_clause_list_nth(clauses, 0), pipeline_handler_lower_ctx_subst(lower_ctx))
      let inst = ir_inst_deferred_handle_i64(next_value, src, lowered_body, clause_bodies, nclauses, eff_hash, scratch_base)
      let insts = ir_inst_list_append(ir_inst_list_prepend(inst, ir_inst_list_empty()), pipeline_ir_call_result_lane_insts(next_value, handle_result_ty))
      ir_lowered_expr(next_value, scratch_base + pipeline_ir_native_deferred_handle_scratch_count(), insts)
    } else {
    let eff_hash = pipeline_handler_clause_dispatch_key_typed(src, handler_clause_list_nth(clauses, 0), pipeline_handler_lower_ctx_subst(lower_ctx))
    let next_ctx = pipeline_handler_inline_ctx_push_typed_src_safe(ctx, eff_hash, clauses, nclauses, src, 1, pipeline_lowered_handler_clauses_out_of_line_safe(lowered_clauses))
    let next_lower_ctx = pipeline_handler_lower_ctx_from_module(params, locals, pipeline_lower_module_with_handlers(pipeline_handler_lower_ctx_module(lower_ctx), next_ctx))
    let call_inline = pipeline_lower_handle_body_call_inline_nodes(body_node, eff_hash, next_ctx, next_lower_ctx, next_value)
    let lowered = if ir_lowered_expr_is_valid(call_inline) == 1 { call_inline } else { pipeline_lower_expr_node_typed_sidecar_handler_ctx(body_node, next_value, next_lower_ctx) }
    if ir_lowered_expr_is_valid(lowered) == 1 {
      if pipeline_ir_insts_handle_frame_free(ir_lowered_expr_insts(lowered)) == 1 {
        lowered
      } else {
        let insts = pipeline_ir_handle_inst_list_nodes(src, eff_hash, clause_bodies, nclauses, ir_lowered_expr_insts(lowered))
        ir_lowered_expr(ir_lowered_expr_value(lowered), ir_lowered_expr_next_value(lowered), insts)
      }
    } else {
      ir_lowered_expr_invalid(next_value)
    }
    }
  }
}

pub(package) fn pipeline_lower_expr_node_typed_sidecar_handler_raw(expr: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  if expr == 0 {
    ir_lowered_expr_invalid(next_value)
  } else {
    if node_tag(expr) == 37 {
      let inner = node_f1(expr)
      let inner_stripped = pipeline_expr_node_strip_typed(inner)
      let ann_prim = pipeline_type_node_prim_id_or(node_f2(expr), 0 - 1)
      if inner_stripped == 0 {
        ir_lowered_expr_invalid(next_value)
      } else {
        let inner_tag = node_tag(inner_stripped)
        if inner_tag == 6 {
          pipeline_lower_let_node_typed_sidecar_handler_opt_with_float_prim(node_f1(inner_stripped), node_f2(inner_stripped), node_f3(inner_stripped), node_f4(inner_stripped), next_value, lower_ctx, ann_prim, node_f2(expr))
        } else { if inner_tag == 11 {
          pipeline_lower_let_mut_node_typed_sidecar_handler_opt_with_float_prim(node_f1(inner_stripped), node_f2(inner_stripped), node_f3(inner_stripped), node_f4(inner_stripped), next_value, lower_ctx, ann_prim, node_f2(expr))
        } else {
          if pipeline_prim_is_forced_numeric_context(ann_prim) == 1 {
            pipeline_lower_expr_node_typed_sidecar_handler_opt_with_float_prim(inner, next_value, lower_ctx, ann_prim)
          } else {
            pipeline_lower_expr_node_typed_sidecar_handler_ctx(inner, next_value, lower_ctx)
          }
        } }
      }
    } else {
    let stripped = pipeline_expr_node_strip_typed(expr)
    let tag = node_tag(stripped)
    if tag == 1 {
      ir_lowered_expr(next_value, next_value + 1, ir_inst_list_prepend(ir_inst_const_i64(next_value, node_f1(stripped)), ir_inst_list_empty()))
    } else { if tag == 24 {
      ir_lowered_expr(next_value, next_value + 1, ir_inst_list_prepend(ir_inst_const_i64(next_value, node_f1(stripped)), ir_inst_list_empty()))
    } else { if tag == 51 {
      ir_lowered_expr(next_value, next_value + 1, ir_inst_list_prepend(ir_inst_nil_i64(next_value), ir_inst_list_empty()))
    } else { if tag == 9 {
      ir_lowered_expr(next_value, next_value + 1, ir_inst_list_prepend(ir_inst_string_lit(next_value, node_f1(stripped), node_f2(stripped)), ir_inst_list_empty()))
    } else { if tag == 54 {
      pipeline_lower_float_lit_typed(pipeline_handler_lower_ctx_src(lower_ctx), node_f1(stripped), node_f2(stripped), next_value, PRIM_F64())
    } else { if tag == 2 {
      pipeline_lower_ident_expr_typed_sidecar_handler_opt(node_f1(stripped), node_f2(stripped), pipeline_handler_lower_ctx_params(lower_ctx), pipeline_handler_lower_ctx_locals(lower_ctx), pipeline_handler_lower_ctx_src(lower_ctx), pipeline_handler_lower_ctx_tt(lower_ctx), pipeline_handler_lower_ctx_fns(lower_ctx), next_value)
    } else { if tag == 3 {
      pipeline_lower_binop_node_typed_sidecar_handler_opt(node_f1(stripped), node_f2(stripped), node_f3(stripped), next_value, lower_ctx)
    } else { if tag == 4 {
      pipeline_lower_call_node_typed_sidecar_handler_opt(node_f1(stripped), node_f2(stripped), node_f3(stripped), node_f4(stripped), next_value, lower_ctx)
    } else { if tag == 6 {
      pipeline_lower_let_node_typed_sidecar_handler_opt_with_float_prim(node_f1(stripped), node_f2(stripped), node_f3(stripped), node_f4(stripped), next_value, lower_ctx, 0, 0)
    } else { if tag == 7 {
      pipeline_lower_block_node_typed_sidecar_handler_opt(node_f1(stripped), node_f2(stripped), next_value, lower_ctx)
    } else { if tag == 11 {
      pipeline_lower_let_mut_node_typed_sidecar_handler_opt_with_float_prim(node_f1(stripped), node_f2(stripped), node_f3(stripped), node_f4(stripped), next_value, lower_ctx, 0, 0)
    } else { if tag == 12 {
      pipeline_lower_assign_node_typed_sidecar_handler_opt(node_f1(stripped), node_f2(stripped), node_f3(stripped), next_value, lower_ctx)
    } else { if tag == 13 {
      pipeline_lower_field_access_node_typed_sidecar_handler_opt(node_f1(stripped), node_f2(stripped), node_f3(stripped), node_f4(stripped), next_value, lower_ctx)
    } else { if tag == 59 {
      pipeline_lower_indexed_len_node_typed_sidecar_handler_opt(node_f1(stripped), node_f2(stripped), next_value, lower_ctx)
    } else { if tag == 60 {
      pipeline_lower_indexed_get_node_typed_sidecar_handler_opt(node_f1(stripped), node_f2(stripped), node_f3(stripped), node_f4(stripped), next_value, lower_ctx)
    } else { if tag == 61 {
      pipeline_lower_indexed_set_node_typed_sidecar_handler_opt(node_f1(stripped), node_f2(stripped), node_f3(stripped), node_f4(stripped), next_value, lower_ctx)
    } else { if tag == 62 {
      pipeline_lower_indexed_slice_node_typed_sidecar_handler_opt(node_f1(stripped), node_f2(stripped), node_f3(stripped), node_f4(stripped), next_value, lower_ctx)
    } else { if tag == 14 {
      pipeline_lower_record_init_node_typed_sidecar_handler_opt(node_f1(stripped), node_f2(stripped), node_f3(stripped), node_f4(stripped), next_value, lower_ctx)
    } else { if tag == 63 {
      ir_lowered_expr_invalid(next_value)
    } else { if tag == 58 {
      pipeline_lower_array_literal_expr_typed_sidecar_handler_opt(expr_list_from_nodes(node_f1(stripped), 0, node_f2(stripped)), node_f3(stripped), next_value, lower_ctx)
    } else { if tag == 22 {
      pipeline_lower_not_node_typed_sidecar_handler_opt(node_f1(stripped), next_value, lower_ctx)
    } else { if tag == 29 {
      let lambda_subst = pipeline_handler_lower_ctx_subst(lower_ctx)
      let lambda_param_nodes = if lambda_subst == 0 { node_f1(stripped) } else { cg_params_subst(node_f1(stripped), lambda_subst) }
      let lambda_params = param_list_from_param_nodes(lambda_param_nodes)
      let lambda_body = expr_from_node(pipeline_expr_node_subst_types(node_f2(stripped), lambda_subst))
      let lambda_captures = pipeline_lambda_captures_for(lambda_params, lambda_body, lower_ctx)
      -- Reserves TWO ids: closure emission stores the capture env at
      -- dst + 1. A single-id reservation let later values (e.g.
      -- loop-hoisted constants) share the env's spill slot and be
      -- clobbered by the env store at runtime.
      let lambda_insts = pipeline_lower_lambda_hoisted(lambda_params, lambda_body, lambda_ast_source_site(node_f4(stripped)), lambda_captures, lower_ctx, next_value)
      ir_lowered_expr(next_value, next_value + 2, lambda_insts)
    } else { if tag == 32 {
      pipeline_lower_perform_node_typed_sidecar_handler_opt(node_f1(stripped), node_f2(stripped), node_f3(stripped), node_f4(stripped), nlist_len(node_f4(stripped)), next_value, lower_ctx)
    } else { if tag == 33 {
      pipeline_lower_handle_node_typed_sidecar_handler_opt(node_f1(stripped), node_f2(stripped), node_f3(stripped), next_value, lower_ctx)
    } else { if tag == 64 {
      pipeline_lower_named_handler_expr_typed_sidecar(
        handler_configuration_from_node(node_f1(stripped)),
        expr_from_node(node_f2(stripped)),
        handler_install_fact_from_node(node_f3(stripped)),
        next_value,
        lower_ctx
      )
    } else { if tag == 35 {
      pipeline_lower_expr_node_typed_sidecar_handler_ctx(node_f1(stripped), next_value, lower_ctx)
    } else { if tag == 36 {
      pipeline_lower_generic_call_node_typed_sidecar_handler_opt(node_f1(stripped), node_f2(stripped), next_value, lower_ctx)
    } else { if tag == 41 {
      pipeline_lower_method_call_node_typed_sidecar_handler_opt(node_f1(stripped), node_f2(stripped), node_f3(stripped), nlist_len(node_f3(stripped)), node_f4(stripped), next_value, lower_ctx)
    } else { if tag == 45 {
      pipeline_lower_try_node_typed_sidecar_handler_opt(node_f1(stripped), node_f2(stripped), next_value, lower_ctx)
    } else { if tag == 46 {
      pipeline_lower_interp_concat_node_typed_sidecar_handler_opt(node_f1(stripped), node_f2(stripped), next_value, lower_ctx)
    } else { if tag == 48 {
      pipeline_lower_opt_chain_node_typed_sidecar_handler_opt(node_f1(stripped), node_f2(stripped), node_f3(stripped), node_f4(stripped), next_value, lower_ctx)
    } else { if tag == 55 {
      pipeline_lower_address_of_node_typed_sidecar_handler_opt(node_f1(stripped), node_f2(stripped), next_value, lower_ctx)
    } else { if tag == 56 {
      pipeline_lower_deref_node_typed_sidecar_handler_opt(node_f1(stripped), next_value, lower_ctx)
    } else { if tag == 57 {
      pipeline_lower_ptr_assign_node_typed_sidecar_handler_opt(node_f1(stripped), node_f2(stripped), next_value, lower_ctx)
    } else {
      ir_lowered_expr_invalid(next_value)
    } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } }
    }
  }
}

pub(package) fn pipeline_lower_expr_typed_sidecar_handler_ctx(expr: Expr, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  let params = pipeline_handler_lower_ctx_params(lower_ctx)
  let locals = pipeline_handler_lower_ctx_locals(lower_ctx)
  let src = pipeline_handler_lower_ctx_src(lower_ctx)
  let tt = pipeline_handler_lower_ctx_tt(lower_ctx)
  let ctx = pipeline_handler_lower_ctx_handlers(lower_ctx)
  let subst = pipeline_handler_lower_ctx_subst(lower_ctx)
  match expr {
    IntLit(value, start, len) -> ir_lowered_expr(
      next_value,
      next_value + 1,
      ir_inst_list_prepend(ir_inst_const_i64(next_value, value), ir_inst_list_empty())
    )
    BoolLit(value) -> ir_lowered_expr(
      next_value,
      next_value + 1,
      ir_inst_list_prepend(ir_inst_const_i64(next_value, value), ir_inst_list_empty())
    )
    NilExpr -> ir_lowered_expr(
      next_value,
      next_value + 1,
      ir_inst_list_prepend(ir_inst_nil_i64(next_value), ir_inst_list_empty())
    )
    Lambda(params, body, source_site) -> {
      let lambda_subst = pipeline_handler_lower_ctx_subst(lower_ctx)
      let lambda_params = pipeline_lambda_ir_params_subst(params, lambda_subst)
      let lambda_body = pipeline_lambda_ir_body_subst(body, lambda_subst)
      let lambda_captures = pipeline_lambda_captures_for(lambda_params, lambda_body, lower_ctx)
      -- next_value + 2: the native emission stores the capture env at
      -- dst + 1 (see the node-path arm for the collision this reserves
      -- against).
      let lambda_insts = pipeline_lower_lambda_hoisted(lambda_params, lambda_body, source_site, lambda_captures, lower_ctx, next_value)
      ir_lowered_expr(next_value, next_value + 2, lambda_insts)
    }
    StringLit(start, len) -> ir_lowered_expr(
      next_value,
      next_value + 1,
      ir_inst_list_prepend(ir_inst_string_lit(next_value, start, len), ir_inst_list_empty())
    )
    FloatLit(start, len) -> pipeline_lower_float_lit_typed(src, start, len, next_value, PRIM_F64())
    Ident(ns, nl) -> pipeline_lower_ident_expr_typed_sidecar_handler_opt(ns, nl, params, locals, src, tt, pipeline_handler_lower_ctx_fns(lower_ctx), next_value)
    BorrowIdent(ns, nl, owner, mutable) -> pipeline_lower_ident_expr_typed_sidecar_handler_opt(ns, nl, params, locals, src, tt, pipeline_handler_lower_ctx_fns(lower_ctx), next_value)
    Call(ns, nl, args) -> pipeline_lower_call_expr_typed_sidecar_handler_opt(ns, nl, args, next_value, lower_ctx)
    BinOp(op, lhs, rhs) -> pipeline_lower_binop_expr_typed_sidecar_handler_opt(op, lhs, rhs, next_value, lower_ctx)
    Let(ns, nl, value, body) -> pipeline_lower_let_expr_typed_sidecar_handler_opt(ns, nl, value, body, next_value, lower_ctx)
    LetMut(ns, nl, value, body) -> pipeline_lower_let_mut_expr_typed_sidecar_handler_opt(ns, nl, value, body, next_value, lower_ctx)
    Assign(ns, nl, value) -> pipeline_lower_assign_expr_typed_sidecar_handler_opt(ns, nl, value, next_value, lower_ctx)
    AddressOf(mutable, target) -> pipeline_lower_address_of_expr_typed_sidecar_handler_opt(mutable, target, next_value, lower_ctx)
    Deref(ptr) -> pipeline_lower_deref_expr_typed_sidecar_handler_opt(ptr, next_value, lower_ctx)
    PtrAssign(ptr, value) -> pipeline_lower_ptr_assign_expr_typed_sidecar_handler_opt(ptr, value, next_value, lower_ctx)
    Block(first, rest) -> pipeline_lower_block_expr_typed_sidecar_handler_opt(first, rest, next_value, lower_ctx)
    Not(operand) -> pipeline_lower_not_expr_typed_sidecar_handler_opt(operand, next_value, lower_ctx)
    FieldAccess(base, field_ns, field_nl, fact) -> pipeline_lower_field_access_expr_typed_sidecar_handler_opt(base, field_ns, field_nl, fact, next_value, lower_ctx)
    IndexedLen(base, fixed_len) -> pipeline_lower_indexed_len_expr_typed_sidecar_handler_opt(base, fixed_len, next_value, lower_ctx)
    IndexedGet(base, index, element_ty, fixed_len) -> pipeline_lower_indexed_get_expr_typed_sidecar_handler_opt(base, index, element_ty, fixed_len, next_value, lower_ctx)
    IndexedSet(base, index, value, fact) -> pipeline_lower_indexed_set_expr_typed_sidecar_handler_opt(base, index, value, fact, next_value, lower_ctx)
    IndexedSlice(base, start, end, fact) -> pipeline_lower_indexed_slice_expr_typed_sidecar_handler_opt(base, start, end, fact, next_value, lower_ctx)
    RecordInit(type_ns, type_nl, fields) -> pipeline_lower_record_init_expr_typed_sidecar_handler_opt(type_ns, type_nl, fields, next_value, lower_ctx)
    RecordUpdate(base, fields, fact) -> ir_lowered_expr_invalid(next_value)
    ArrayLiteral(elements, resolved_ty, span) -> pipeline_lower_array_literal_expr_typed_sidecar_handler_opt(elements, resolved_ty, next_value, lower_ctx)
    Perform(lhs, op_ns, op_nl, args) -> pipeline_lower_perform_expr_typed_sidecar_handler_opt(lhs, op_ns, op_nl, args, next_value, lower_ctx)
    Handle(body, clauses, hret) -> pipeline_lower_handle_expr_typed_sidecar_handler_opt(body, clauses, hret, next_value, lower_ctx)
    WithHandler(config, body, fact, source_site) -> pipeline_lower_named_handler_expr_typed_sidecar(config, body, fact, next_value, lower_ctx)
    Resume(value) -> pipeline_lower_expr_typed_sidecar_handler_ctx(value, next_value, lower_ctx)
    GenericCall(type_args, inner_call) -> pipeline_lower_generic_call_expr_typed_sidecar_handler_opt(type_args, inner_call, next_value, lower_ctx)
    MethodCall(recv, method_hash, args, type_hash) -> pipeline_lower_method_call_expr_typed_sidecar_handler_opt(recv, method_hash, args, type_hash, next_value, lower_ctx)
    Try(inner, effect_atom) -> pipeline_lower_try_expr_typed_sidecar_handler_opt(inner, effect_atom, next_value, lower_ctx)
    InterpConcat(left, right) -> pipeline_lower_interp_concat_expr_typed_sidecar_handler_opt(left, right, next_value, lower_ctx)
    OptChain(base, field_ns, field_nl, effect_atom) -> pipeline_lower_opt_chain_expr_typed_sidecar_handler_opt(base, field_ns, field_nl, effect_atom, next_value, lower_ctx)
    LetTyped(inner, ann_type) -> {
      let ann_prim = type_expr_prim_id_or(ann_type, 0)
      let ann_node = type_expr_to_node(ann_type)
      match inner {
        Let(ns, nl, value, body) -> pipeline_lower_let_expr_typed_sidecar_handler_opt_with_float_prim(ns, nl, value, body, next_value, lower_ctx, ann_prim, ann_node)
        LetMut(ns, nl, value, body) -> pipeline_lower_let_mut_expr_typed_sidecar_handler_opt_with_float_prim(ns, nl, value, body, next_value, lower_ctx, ann_prim, ann_node)
        _ -> {
          if pipeline_prim_is_forced_numeric_context(ann_prim) == 1 {
            pipeline_lower_expr_typed_sidecar_handler_opt_with_float_prim(inner, next_value, lower_ctx, ann_prim)
          } else {
            pipeline_lower_expr_typed_sidecar_handler_ctx(inner, next_value, lower_ctx)
          }
        }
      }
    }
    _ -> ir_lowered_expr_invalid(next_value)
  }
}

pub(package) fn pipeline_lower_expr_typed_sidecar_handler_opt_with_subst(expr: Expr, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, next_value: i64, ctx: PipelineHandlerInlineCtx, subst: i64) -> IrLoweredExpr {
  pipeline_lower_expr_typed_sidecar_handler_ctx(expr, next_value, pipeline_handler_lower_ctx_with_subst(params, locals, src, tt, ctx, subst))
}

pub(package) fn pipeline_lower_expr_typed_sidecar_handler_opt_with_fns(expr: Expr, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, next_value: i64, ctx: PipelineHandlerInlineCtx, fns: i64) -> IrLoweredExpr {
  pipeline_lower_expr_typed_sidecar_handler_ctx(expr, next_value, pipeline_handler_lower_ctx_with_fns_subst(params, locals, src, tt, ctx, fns, 0))
}

pub(package) fn pipeline_lower_expr_typed_sidecar_handler_opt(expr: Expr, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, next_value: i64, ctx: PipelineHandlerInlineCtx) -> IrLoweredExpr {
  pipeline_lower_expr_typed_sidecar_handler_opt_with_subst(expr, params, locals, src, tt, next_value, ctx, 0)
}

pub(package) fn pipeline_lower_expr_node_typed_sidecar_handler_ctx(expr: i64, next_value: i64, lower_ctx: PipelineHandlerLowerCtx) -> IrLoweredExpr {
  pipeline_lower_expr_node_typed_sidecar_handler_raw(expr, next_value, lower_ctx)
}

pub(package) fn pipeline_lower_expr_node_typed_sidecar_handler_opt_with_subst(expr: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, next_value: i64, ctx: PipelineHandlerInlineCtx, subst: i64) -> IrLoweredExpr {
  pipeline_lower_expr_node_typed_sidecar_handler_ctx(expr, next_value, pipeline_handler_lower_ctx_with_subst(params, locals, src, tt, ctx, subst))
}

pub(package) fn pipeline_lower_expr_node_typed_sidecar_handler_opt_with_fns(expr: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, next_value: i64, ctx: PipelineHandlerInlineCtx, fns: i64) -> IrLoweredExpr {
  pipeline_lower_expr_node_typed_sidecar_handler_ctx(expr, next_value, pipeline_handler_lower_ctx_with_fns_subst(params, locals, src, tt, ctx, fns, 0))
}

pub(package) fn pipeline_lower_expr_node_typed_sidecar_handler_opt(expr: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, next_value: i64, ctx: PipelineHandlerInlineCtx) -> IrLoweredExpr {
  pipeline_lower_expr_node_typed_sidecar_handler_opt_with_subst(expr, params, locals, src, tt, next_value, ctx, 0)
}

pub(package) fn pipeline_lowering_failure_function(fn_key: i64, nparams: i64, src: i64, reason: i64) -> IrFunction {
  let insts = ir_inst_list_prepend(ir_inst_lowering_failure_i64(reason), ir_inst_list_empty())
  let block = ir_block_new_term(0, insts, ir_term_return(0))
  ir_function_new_src(fn_key, nparams, block, src)
}

pub(package) fn pipeline_lowering_failure_function_list(fn_key: i64, nparams: i64, src: i64, reason: i64) -> IrFunctionList {
  ir_function_list_prepend(pipeline_lowering_failure_function(fn_key, nparams, src, reason), ir_function_list_empty())
}

pub(package) fn pipeline_lower_straight_fn_handler_optimised(inner: i64, params: i64, src: i64, tt: i64, nparams: i64, param_lanes: i64, fn_key: i64, fns: i64, return_ty: i64, return_float: i64, borrowed_mask: i64) -> IrFunctionList {
  let body = node_f4(inner)
  let lower_ctx = pipeline_handler_lower_ctx_with_fns_subst(params, pipeline_value_env_empty(), src, tt, pipeline_handler_inline_ctx_empty(), fns, 0)
  let lowered = if return_float == PRIM_F32() or return_float == PRIM_F64() {
    pipeline_lower_expr_node_typed_sidecar_handler_opt_with_float_prim(body, param_lanes, lower_ctx, return_float)
  } else {
    pipeline_lower_expr_node_typed_sidecar_handler_ctx(body, param_lanes, lower_ctx)
  }
  if ir_lowered_expr_is_valid(lowered) == 1 {
    let param_binds = pipeline_lower_param_bind_insts_with_borrow_mask(params, 0, nparams, borrowed_mask)
    let module = pipeline_lower_module_with_fns_subst(src, tt, fns, 0)
    let transfer = pipeline_lower_return_transfer_from_node_with_fallback_ty(body, ir_lowered_expr_value(lowered), ir_lowered_expr_next_value(lowered), params, pipeline_value_env_empty(), module, return_ty)
    let managed_param_drops = pipeline_managed_param_release_insts_with_borrow_mask(params, 0, nparams, ir_lowered_expr_next_value(transfer), borrowed_mask, tt)
    let owned_param_drops = pipeline_linear_param_drop_insts(params, 0, nparams, body, src, tt)
    let param_drops = ir_inst_list_append(managed_param_drops, owned_param_drops)
    let insts = ir_inst_list_append(param_binds, ir_inst_list_append(ir_lowered_expr_insts(lowered), ir_inst_list_append(ir_lowered_expr_insts(transfer), param_drops)))
    let return_insts = ir_inst_list_append(insts, pipeline_ir_return_lane_insts(ir_lowered_expr_value(transfer), return_ty))
    let block = ir_block_new_term(0, return_insts, ir_term_return(ir_lowered_expr_value(transfer)))
    let f = ir_function_new_src(fn_key, param_lanes, block, src)
    ir_function_list_prepend(f, ir_function_list_empty())
  } else {
    pipeline_lowering_failure_function_list(fn_key, param_lanes, src, 1)
  }
}

pub(package) fn pipeline_lower_cfg_fn_typed_handler_optimised_with_ctx(inner: i64, params: i64, src: i64, tt: i64, nparams: i64, param_lanes: i64, fn_key: i64, return_ty: i64, handlers: PipelineHandlerInlineCtx, subst: i64, fns: i64, borrowed_mask: i64) -> IrFunctionList {
  let body = node_f4(inner)
  let final_merge_block = 1
  let locals = pipeline_value_env_empty()
  let module = pipeline_lower_module_with_handlers(
    pipeline_lower_module_with_fns_subst(src, tt, fns, subst),
    handlers
  )
  let lowered = pipeline_lower_expr_typed_to_target_blocks_reserved(expr_from_node(body), params, locals, module, param_lanes, 0, 2, final_merge_block)
  if pipeline_lowered_blocks_is_valid(lowered) == 1 {
    if pipeline_lowered_blocks_falls_through(lowered) == 1 {
      let final_value = pipeline_lowered_blocks_next_value(lowered)
      let return_lanes = pipeline_type_value_lane_count_or_one(return_ty)
      let final_params = pipeline_ir_value_lane_ids(final_value, 0, return_lanes)
      let transfer = pipeline_lower_return_transfer_from_node_with_fallback_ty(body, final_value, final_value + return_lanes, params, locals, module, return_ty)
      let final_merge = ir_block_new_params(final_merge_block, final_params, ir_lowered_expr_insts(transfer), ir_term_return(ir_lowered_expr_value(transfer)))
      let blocks = ir_block_list_append(
        pipeline_lowered_blocks_blocks(lowered),
          ir_block_list_prepend(final_merge, ir_block_list_empty())
      )
      let with_binds = pipeline_ir_block_list_prepend_entry_insts(blocks, 0, pipeline_lower_param_bind_insts_with_borrow_mask(params, 0, nparams, borrowed_mask))
      let managed_param_drops = pipeline_managed_param_release_insts_with_borrow_mask(params, 0, nparams, pipeline_ir_function_next_value(param_lanes, with_binds), borrowed_mask, tt)
      let owned_param_drops = pipeline_linear_param_drop_insts(params, 0, nparams, body, src, tt)
      let param_drops = ir_inst_list_append(managed_param_drops, owned_param_drops)
      let with_drops = pipeline_ir_block_list_append_return_drops(with_binds, param_drops)
      let with_return_lanes = pipeline_ir_block_list_append_return_lanes(with_drops, return_ty)
      let f = ir_function_new_blocks_src(fn_key, param_lanes, with_return_lanes, src)
      ir_function_list_prepend(f, ir_function_list_empty())
    } else {
      let with_binds = pipeline_ir_block_list_prepend_entry_insts(pipeline_lowered_blocks_blocks(lowered), 0, pipeline_lower_param_bind_insts_with_borrow_mask(params, 0, nparams, borrowed_mask))
      let managed_param_drops = pipeline_managed_param_release_insts_with_borrow_mask(params, 0, nparams, pipeline_ir_function_next_value(param_lanes, with_binds), borrowed_mask, tt)
      let owned_param_drops = pipeline_linear_param_drop_insts(params, 0, nparams, body, src, tt)
      let param_drops = ir_inst_list_append(managed_param_drops, owned_param_drops)
      let with_drops = pipeline_ir_block_list_append_return_drops(with_binds, param_drops)
      let with_return_lanes = pipeline_ir_block_list_append_return_lanes(with_drops, return_ty)
      let f = ir_function_new_blocks_src(fn_key, param_lanes, with_return_lanes, src)
      ir_function_list_prepend(f, ir_function_list_empty())
    }
  } else {
    pipeline_lowering_failure_function_list(fn_key, param_lanes, src, 2)
  }
}

pub(package) fn pipeline_lower_cfg_fn_typed_handler_optimised(inner: i64, params: i64, src: i64, tt: i64, nparams: i64, fn_key: i64) -> IrFunctionList {
  pipeline_lower_cfg_fn_typed_handler_optimised_with_ctx(inner, params, src, tt, nparams, pipeline_params_value_lane_count(params), fn_key, 0, pipeline_handler_inline_ctx_empty(), 0, 0, 0)
}

pub(package) fn pipeline_lower_simple_fn_handler_optimised(pair: i64, tt: i64, fns: i64) -> IrFunctionList {
  let fn_wrap = node_f1(pair)
  let fn_src = node_f2(pair)
  let inner = pipeline_fn_inner(fn_wrap)
  let params = node_f3(inner)
  let body = node_f4(inner)
  let nparams = nlist_len(params)
  let param_lanes = pipeline_params_value_lane_count(params)
  let fn_key = pipeline_fn_pair_key(pair)
  let return_ty = fn_ret_type(fn_wrap)
  let return_float = pipeline_fn_return_float_prim(fn_wrap, 0)
  let borrowed_mask = pipeline_fn_effective_borrowable_param_mask_with_params(fns, fn_wrap, fn_src, params, 0)
  let typed_body_needs_cfg = pipeline_expr_needs_par_scope_cfg_typed(expr_from_node(body), fn_src)
  if pipeline_expr_needs_cfg(body) == 1 or typed_body_needs_cfg == 1 {
    pipeline_lower_cfg_fn_typed_handler_optimised_with_ctx(inner, params, fn_src, tt, nparams, param_lanes, fn_key, return_ty, pipeline_handler_inline_ctx_empty(), 0, fns, borrowed_mask)
  } else {
    pipeline_lower_straight_fn_handler_optimised(inner, params, fn_src, tt, nparams, param_lanes, fn_key, fns, return_ty, return_float, borrowed_mask)
  }
}

pub(package) fn pipeline_lower_fns_handler_optimised(fns: i64, tt: i64, user_src: i64) -> IrFunctionList {
  pipeline_fns_bind_ttable(fns, tt)
  pipeline_fns_index_bundle(fns)
  let mut result = ir_function_list_empty()
  let n = nlist_len(fns)
  for i in 0..n {
    let pair = nlist_get(fns, i)
    let fn_wrap = node_f1(pair)
    if pipeline_decl_node_is_function(fn_wrap) == 1 and fn_tparams(fn_wrap) == 0 and pipeline_params_have_open_structural_shape(node_f3(pipeline_fn_inner(fn_wrap))) == 0 {
      let one = pipeline_lower_simple_fn_handler_optimised(pair, tt, fns)
      match one {
        IrFunctionNil -> 0
        IrFunctionCons(f, rest) -> {
          result = ir_function_list_prepend(f, result)
          0
        }
      }
    } else { 0 }
  }
  result
}

pub(package) fn pipeline_ir_function_list_append(left: IrFunctionList, right: IrFunctionList) -> IrFunctionList {
  match left {
    IrFunctionNil -> right
    IrFunctionCons(f, rest) -> ir_function_list_prepend(f, pipeline_ir_function_list_append(rest, right))
  }
}

pub(package) fn pipeline_ir_function_list_reverse_append(functions: IrFunctionList, acc: IrFunctionList) -> IrFunctionList {
  match functions {
    IrFunctionNil -> acc
    IrFunctionCons(f, rest) -> pipeline_ir_function_list_reverse_append(rest, ir_function_list_prepend(f, acc))
  }
}

pub(package) fn pipeline_ir_function_list_reverse(functions: IrFunctionList) -> IrFunctionList {
  pipeline_ir_function_list_reverse_append(functions, ir_function_list_empty())
}

pub(package) fn pipeline_ir_function_list_dedup_seen(functions: IrFunctionList, seen: i64) -> IrFunctionList {
  match functions {
    IrFunctionNil -> ir_function_list_empty()
    IrFunctionCons(f, rest) -> {
      match f {
        IrFunction(hash, params, blocks, src) -> {
          if pipeline_hash_nlist_contains(seen, hash) == 1 {
            pipeline_ir_function_list_dedup_seen(rest, seen)
          } else {
            nlist_add(seen, hash)
            ir_function_list_prepend(f, pipeline_ir_function_list_dedup_seen(rest, seen))
          }
        }
      }
    }
  }
}

pub(package) fn pipeline_ir_function_list_dedup(functions: IrFunctionList) -> IrFunctionList {
  pipeline_ir_function_list_dedup_seen(functions, nlist_new())
}

pub(package) fn pipeline_generic_template_find(fns: i64, user_src: i64, name_hash: i64) -> i64 {
  if pipeline_fns_fact_list_valid(fns) == 0 { 0 }
  else {
    let bundle = pipeline_fns_index_bundle(fns)
    let generic = pipeline_fns_index_probe(node_f3(bundle), name_hash)
    if generic != 0 { generic }
    else {
      let method = pipeline_fns_index_probe(node_f2(bundle), name_hash)
      if method != 0 and (fn_tparams(node_f1(method)) != 0 or pipeline_params_have_structural_shape(node_f3(pipeline_fn_inner(node_f1(method)))) == 1) { method } else { 0 }
    }
  }
}

pub(package) fn pipeline_generic_template_find_resolved(fns: i64, tt: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let pair = pipeline_fns_lookup_pair_resolved(fns, tt, src, ns, nl)
  if pair != 0 and (fn_tparams(node_f1(pair)) != 0 or pipeline_params_have_structural_shape(node_f3(pipeline_fn_inner(node_f1(pair)))) == 1) {
    pair
  } else { 0 }
}

pub(package) fn pipeline_generic_template_pairs(fns: i64) -> i64 {
  let result = nlist_new()
  if pipeline_fns_fact_list_valid(fns) == 0 { 0 }
  else {
    let n = nlist_len(fns)
    for i in 0..n {
      let pair = nlist_get(fns, i)
      let fn_wrap = node_f1(pair)
      if pipeline_decl_node_is_function(fn_wrap) == 1 and (fn_tparams(fn_wrap) != 0 or pipeline_params_have_structural_shape(node_f3(pipeline_fn_inner(fn_wrap))) == 1) {
        nlist_add(result, pair)
      } else { 0 }
    }
  }
  result
}

pub(package) fn pipeline_lower_generic_specialisation_handler_optimised(pair: i64, type_args: i64, tt: i64, handlers: PipelineHandlerInlineCtx, fns: i64) -> IrFunctionList {
  if pair == 0 {
    ir_function_list_empty()
  } else {
    let fn_wrap = node_f1(pair)
    let fn_src = node_f2(pair)
    let inner = pipeline_fn_inner(fn_wrap)
    let body = node_f4(inner)
    let fn_key = mono_spec_hash(pipeline_fn_pair_key(pair), type_args)
    let subst = cg_build_subst_with_associated(fn_tparams(fn_wrap), type_args, tt)
    let params = cg_params_shape_specialise_with_subst(node_f3(inner), fn_tparams(fn_wrap), type_args, subst)
    let nparams = nlist_len(params)
    let param_lanes = pipeline_params_value_lane_count(params)
    let return_ty = pipeline_function_return_type_with_subst(fn_wrap, subst, tt)
    let return_float = pipeline_fn_return_float_prim(fn_wrap, subst)
    let borrowed_mask = pipeline_fn_effective_borrowable_param_mask_with_params(fns, fn_wrap, fn_src, params, subst)
    -- Generic specialisations are emitted as standalone functions. They must
    -- not capture a caller's lexical handler depth; performs across this
    -- boundary are handled by the runtime/evidence path until hidden evidence
    -- is threaded into the generic ABI.
    let out_of_line_handlers = pipeline_handler_inline_ctx_empty()
    let typed_body_needs_cfg = pipeline_expr_needs_par_scope_cfg_typed(expr_from_node(body), fn_src)
    if pipeline_expr_needs_cfg(body) == 1 or typed_body_needs_cfg == 1 {
      pipeline_lower_cfg_fn_typed_handler_optimised_with_ctx(inner, params, fn_src, tt, nparams, param_lanes, fn_key, return_ty, out_of_line_handlers, subst, fns, borrowed_mask)
    } else {
      let lower_ctx = pipeline_handler_lower_ctx_with_fns_subst(params, pipeline_value_env_empty(), fn_src, tt, out_of_line_handlers, fns, subst)
      let lowered = if return_float == PRIM_F32() or return_float == PRIM_F64() {
        pipeline_lower_expr_node_typed_sidecar_handler_opt_with_float_prim(body, param_lanes, lower_ctx, return_float)
      } else {
        pipeline_lower_expr_node_typed_sidecar_handler_ctx(body, param_lanes, lower_ctx)
      }
      if ir_lowered_expr_is_valid(lowered) == 1 {
        let param_binds = pipeline_lower_param_bind_insts_with_borrow_mask(params, 0, nparams, borrowed_mask)
        let module = pipeline_lower_module_with_fns_subst(fn_src, tt, fns, subst)
        let transfer = pipeline_lower_return_transfer_from_node_with_fallback_ty(body, ir_lowered_expr_value(lowered), ir_lowered_expr_next_value(lowered), params, pipeline_value_env_empty(), module, return_ty)
        let managed_param_drops = pipeline_managed_param_release_insts_with_borrow_mask(params, 0, nparams, ir_lowered_expr_next_value(transfer), borrowed_mask, tt)
        let owned_param_drops = pipeline_linear_param_drop_insts(params, 0, nparams, body, fn_src, tt)
        let param_drops = ir_inst_list_append(managed_param_drops, owned_param_drops)
        let insts = ir_inst_list_append(param_binds, ir_inst_list_append(ir_lowered_expr_insts(lowered), ir_inst_list_append(ir_lowered_expr_insts(transfer), param_drops)))
        let return_insts = ir_inst_list_append(insts, pipeline_ir_return_lane_insts(ir_lowered_expr_value(transfer), return_ty))
        let block = ir_block_new_term(0, return_insts, ir_term_return(ir_lowered_expr_value(transfer)))
        let f = ir_function_new_src(fn_key, param_lanes, block, fn_src)
        ir_function_list_prepend(f, ir_function_list_empty())
      } else {
        pipeline_lowering_failure_function_list(fn_key, param_lanes, fn_src, 3)
      }
    }
  }
}

pub(package) fn pipeline_collect_generic_specs_list(nodes: i64, count: i64, fns: i64, user_src: i64, tt: i64, handlers: PipelineHandlerInlineCtx) -> IrFunctionList {
  let mut result = ir_function_list_empty()
  for i in 0..count {
    let one = pipeline_collect_generic_specs_expr(nlist_get(nodes, i), fns, user_src, tt, handlers)
    result = pipeline_ir_function_list_reverse_append(one, result)
  }
  pipeline_ir_function_list_reverse(result)
}

pub(package) fn pipeline_collect_generic_specs_record_fields(fields: i64, nfields: i64, fns: i64, user_src: i64, tt: i64, handlers: PipelineHandlerInlineCtx) -> IrFunctionList {
  let mut result = ir_function_list_empty()
  for i in 0..nfields {
    let field = nlist_get(fields, i)
    let one = pipeline_collect_generic_specs_expr(node_f3(field), fns, user_src, tt, handlers)
    result = pipeline_ir_function_list_reverse_append(one, result)
  }
  pipeline_ir_function_list_reverse(result)
}

pub(package) fn pipeline_collect_generic_specs_clause_bodies(clauses: i64, nclauses: i64, fns: i64, user_src: i64, tt: i64, handlers: PipelineHandlerInlineCtx) -> IrFunctionList {
  let mut result = ir_function_list_empty()
  for i in 0..nclauses {
    let clause = nlist_get(clauses, i)
    let one = pipeline_collect_generic_specs_expr(node_f3(clause), fns, user_src, tt, handlers)
    result = pipeline_ir_function_list_reverse_append(one, result)
  }
  pipeline_ir_function_list_reverse(result)
}

pub(package) fn pipeline_collect_generic_specs_match_arms(arms: i64, narms: i64, fns: i64, user_src: i64, tt: i64, handlers: PipelineHandlerInlineCtx) -> IrFunctionList {
  let mut result = ir_function_list_empty()
  for i in 0..narms {
    let arm = nlist_get(arms, i)
    let body_specs = pipeline_collect_generic_specs_expr(node_f2(arm), fns, user_src, tt, handlers)
    let guard_node = node_f3(arm)
    let guard_specs = if guard_node == 0 { ir_function_list_empty() } else { pipeline_collect_generic_specs_expr(guard_node, fns, user_src, tt, handlers) }
    result = pipeline_ir_function_list_reverse_append(guard_specs, pipeline_ir_function_list_reverse_append(body_specs, result))
  }
  pipeline_ir_function_list_reverse(result)
}

pub(package) fn pipeline_collect_generic_specs_block(first: i64, rest: i64, fns: i64, user_src: i64, tt: i64, handlers: PipelineHandlerInlineCtx) -> IrFunctionList {
  let first_specs = pipeline_collect_generic_specs_expr(first, fns, user_src, tt, handlers)
  if rest == 0 {
    first_specs
  } else {
    pipeline_ir_function_list_append(first_specs, pipeline_collect_generic_specs_expr(rest, fns, user_src, tt, handlers))
  }
}

pub(package) fn pipeline_collect_generic_specs_handle(expr: i64, fns: i64, user_src: i64, tt: i64, handlers: PipelineHandlerInlineCtx) -> IrFunctionList {
  let body = node_f1(expr)
  let clauses = node_f2(expr)
  let nclauses = node_f3(expr)
  let clause_specs = pipeline_collect_generic_specs_clause_bodies(clauses, nclauses, fns, user_src, tt, handlers)
  if nclauses <= 0 {
    pipeline_ir_function_list_append(clause_specs, pipeline_collect_generic_specs_expr(body, fns, user_src, tt, handlers))
  } else {
    let eff_hash = pipeline_handler_clause_effect_hash(user_src, nlist_get(clauses, 0))
    let next_handlers = pipeline_handler_inline_ctx_push_typed_src(handlers, eff_hash, handler_clause_list_from_nodes(clauses, 0, nclauses), nclauses, user_src)
    pipeline_ir_function_list_append(clause_specs, pipeline_collect_generic_specs_expr(body, fns, user_src, tt, next_handlers))
  }
}

pub(package) fn pipeline_collect_generic_specs_generic_call(expr: i64, fns: i64, user_src: i64, tt: i64, handlers: PipelineHandlerInlineCtx) -> IrFunctionList {
  let call_node = node_f2(expr)
  let qualified_decl = if node_tag(call_node) == 32 { pipeline_node_declaration_access(node_f1(call_node)) } else { 0 }
  let call_args = if node_tag(call_node) == 32 { node_f4(call_node) } else { node_f3(call_node) }
  let call_arg_count = if node_tag(call_node) == 32 { nlist_len(call_args) } else { node_f4(call_node) }
  let arg_specs = pipeline_collect_generic_specs_list(call_args, call_arg_count, fns, user_src, tt, handlers)
  if qualified_decl == 0 and src_eq(user_src, node_f1(call_node), node_f2(call_node), "to_array") == 1 and nlist_len(node_f1(expr)) == 2 {
    -- The checker-produced second argument is the exact `[T; N]` layout;
    -- typed lowering replaces this call and the post-IR collector discovers
    -- the generated Option constructor specialisations.
    arg_specs
  } else {
    let pair = if qualified_decl != 0 { module_decl_fact_function_pair(qualified_decl) }
      else { pipeline_generic_template_find_resolved(fns, tt, user_src, node_f1(call_node), node_f2(call_node)) }
    let specialised = pipeline_lower_generic_specialisation_handler_optimised(pair, node_f1(expr), tt, handlers, fns)
    pipeline_ir_function_list_append(arg_specs, specialised)
  }
}

pub(package) fn pipeline_collect_generic_specs_method_call(expr: i64, fns: i64, user_src: i64, tt: i64, handlers: PipelineHandlerInlineCtx) -> IrFunctionList {
  let receiver_specs = pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers)
  let arg_specs = pipeline_collect_generic_specs_list(node_f3(expr), nlist_len(node_f3(expr)), fns, user_src, tt, handlers)
  let children = pipeline_ir_function_list_append(receiver_specs, arg_specs)
  let method_ref = node_f4(expr)
  if method_ref_is_generic(method_ref) {
    let resolution = ttable_resolve_method(tt, method_ref_receiver_ty(method_ref), method_ref_owner_hash(method_ref), node_f2(expr))
    let dispatch_ty = if resolution == 0 { method_ref_receiver_ty(method_ref) } else { method_resolution_target_ty(resolution) }
    let native_owner = pipeline_native_dispatch_type_hash(dispatch_ty, method_ref_owner_hash(method_ref))
    let base_hash = pipeline_ir_method_patch_key(native_owner, node_f2(expr))
    let pair = pipeline_generic_template_find(fns, user_src, base_hash)
    pipeline_ir_function_list_append(children, pipeline_lower_generic_specialisation_handler_optimised(pair, method_ref_type_args(method_ref), tt, handlers, fns))
  } else { children }
}

pub(package) fn pipeline_collect_generic_specs_expr(expr: i64, fns: i64, user_src: i64, tt: i64, handlers: PipelineHandlerInlineCtx) -> IrFunctionList {
  if expr == 0 {
    ir_function_list_empty()
  } else {
    let tag = node_tag(expr)
    match tag {
      3 -> pipeline_ir_function_list_append(
        pipeline_collect_generic_specs_expr(node_f2(expr), fns, user_src, tt, handlers),
        pipeline_collect_generic_specs_expr(node_f3(expr), fns, user_src, tt, handlers)
      )
      4 -> pipeline_collect_generic_specs_list(node_f3(expr), node_f4(expr), fns, user_src, tt, handlers)
      5 -> pipeline_ir_function_list_append(
        pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers),
        pipeline_ir_function_list_append(
          pipeline_collect_generic_specs_expr(node_f2(expr), fns, user_src, tt, handlers),
          pipeline_collect_generic_specs_expr(node_f3(expr), fns, user_src, tt, handlers)
        )
      )
      6 -> pipeline_ir_function_list_append(
        pipeline_collect_generic_specs_expr(node_f3(expr), fns, user_src, tt, handlers),
        pipeline_collect_generic_specs_expr(node_f4(expr), fns, user_src, tt, handlers)
      )
      7 -> pipeline_collect_generic_specs_block(node_f1(expr), node_f2(expr), fns, user_src, tt, handlers)
      10 -> pipeline_ir_function_list_append(
        pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers),
        pipeline_collect_generic_specs_expr(node_f2(expr), fns, user_src, tt, handlers)
      )
      11 -> pipeline_ir_function_list_append(
        pipeline_collect_generic_specs_expr(node_f3(expr), fns, user_src, tt, handlers),
        pipeline_collect_generic_specs_expr(node_f4(expr), fns, user_src, tt, handlers)
      )
      12 -> pipeline_collect_generic_specs_expr(node_f3(expr), fns, user_src, tt, handlers)
      13 -> pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers)
      59 -> pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers)
      60 -> { pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers) pipeline_collect_generic_specs_expr(node_f2(expr), fns, user_src, tt, handlers) }
      61 -> { pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers) pipeline_collect_generic_specs_expr(node_f2(expr), fns, user_src, tt, handlers) pipeline_collect_generic_specs_expr(node_f3(expr), fns, user_src, tt, handlers) }
      62 -> { pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers) pipeline_collect_generic_specs_expr(node_f2(expr), fns, user_src, tt, handlers) pipeline_collect_generic_specs_expr(node_f3(expr), fns, user_src, tt, handlers) }
      14 -> pipeline_collect_generic_specs_record_fields(node_f3(expr), node_f4(expr), fns, user_src, tt, handlers)
      63 -> pipeline_ir_function_list_append(
        pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers),
        pipeline_collect_generic_specs_record_fields(node_f2(expr), node_f3(expr), fns, user_src, tt, handlers)
      )
      58 -> pipeline_collect_generic_specs_list(node_f1(expr), node_f2(expr), fns, user_src, tt, handlers)
      15 -> pipeline_ir_function_list_append(
        pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers),
        pipeline_collect_generic_specs_match_arms(node_f2(expr), node_f3(expr), fns, user_src, tt, handlers)
      )
      22 -> pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers)
      25 -> pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers)
      26 -> pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers)
      29 -> pipeline_collect_generic_specs_expr(node_f2(expr), fns, user_src, tt, handlers)
      32 -> pipeline_collect_generic_specs_list(node_f4(expr), nlist_len(node_f4(expr)), fns, user_src, tt, handlers)
      33 -> pipeline_collect_generic_specs_handle(expr, fns, user_src, tt, handlers)
      35 -> pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers)
      36 -> pipeline_collect_generic_specs_generic_call(expr, fns, user_src, tt, handlers)
      37 -> pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers)
      41 -> pipeline_collect_generic_specs_method_call(expr, fns, user_src, tt, handlers)
      45 -> pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers)
      46 -> pipeline_ir_function_list_append(
        pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers),
        pipeline_collect_generic_specs_expr(node_f2(expr), fns, user_src, tt, handlers)
      )
      47 -> pipeline_ir_function_list_append(
        pipeline_collect_generic_specs_expr(node_f3(expr), fns, user_src, tt, handlers),
        pipeline_collect_generic_specs_expr(node_f4(expr), fns, user_src, tt, handlers)
      )
      48 -> pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers)
      49 -> pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers)
      52 -> pipeline_ir_function_list_append(
        pipeline_collect_generic_specs_expr(node_f1(expr), fns, user_src, tt, handlers),
        pipeline_collect_generic_specs_expr(node_f2(expr), fns, user_src, tt, handlers)
      )
      _ -> ir_function_list_empty()
    }
  }
}

pub(package) fn pipeline_collect_generic_specs_fns(fns: i64, tt: i64, user_src: i64) -> IrFunctionList {
  let mut result = ir_function_list_empty()
  let n = nlist_len(fns)
  for i in 0..n {
    let pair = nlist_get(fns, i)
    let fn_wrap = node_f1(pair)
    if pipeline_decl_node_is_function(fn_wrap) == 1 and fn_tparams(fn_wrap) == 0 and pipeline_params_have_open_structural_shape(node_f3(pipeline_fn_inner(fn_wrap))) == 0 {
      let fn_src = node_f2(pair)
      let inner = pipeline_fn_inner(fn_wrap)
      let specs = pipeline_collect_generic_specs_expr(node_f4(inner), fns, fn_src, tt, pipeline_handler_inline_ctx_empty())
      result = pipeline_ir_function_list_reverse_append(specs, result)
    } else { 0 }
  }
  pipeline_ir_function_list_reverse(result)
}

-- Handler clause and deferred-body CFGs are nested IR programs, just like
-- hoisted closure bodies. Generic calls inside a specialised handler are only
-- concrete after that handler has been lowered, so the post-IR closure must
-- descend into them or native emission sees a valid concrete call with no
-- matching specialisation (BRK #8).
pub(package) fn pipeline_collect_generic_specs_ir_handler_clauses(clauses: IrHandlerClauseBodyList, templates: i64, all_fns: i64, tt: i64, src: i64) -> IrFunctionList {
  match clauses {
    IrHandlerClauseBodyNil -> ir_function_list_empty()
    IrHandlerClauseBodyCons(body, rest) -> {
      let body_specs = match body {
        IrHandlerClauseBody(op_hash, nparams, captures, has_continuation, is_abortive, result_cleanup_kind, transferred_param_value_fact, resume_lanes, result_lanes, first_value, blocks) -> {
          pipeline_collect_generic_specs_ir_blocks(blocks, templates, all_fns, tt, src)
        }
        IrHandlerClauseBodyInvalid(reason) -> ir_function_list_empty()
      }
      pipeline_ir_function_list_append(
        body_specs,
        pipeline_collect_generic_specs_ir_handler_clauses(rest, templates, all_fns, tt, src)
      )
    }
  }
}

pub(package) fn pipeline_collect_generic_specs_ir_deferred_body(body: IrDeferredHandlerBody, templates: i64, all_fns: i64, tt: i64, src: i64) -> IrFunctionList {
  match body {
    IrDeferredHandlerBody(body_src, captures, ops_value, result_lanes, first_value, blocks, completion) -> {
      let body_specs = pipeline_collect_generic_specs_ir_blocks(blocks, templates, all_fns, tt, body_src)
      let completion_specs = match completion {
        IrDeferredCompletionBodyNone -> ir_function_list_empty()
        IrDeferredCompletionBody(input_lanes, output_lanes, completion_first_value, completion_blocks) -> pipeline_collect_generic_specs_ir_blocks(completion_blocks, templates, all_fns, tt, body_src)
        IrDeferredCompletionBodyInvalid(reason) -> ir_function_list_empty()
      }
      pipeline_ir_function_list_append(body_specs, completion_specs)
    }
    IrDeferredHandlerBodyInvalid(reason) -> ir_function_list_empty()
  }
}

-- Linear-layout plans are semantic type facts, so implicit Drop sites can
-- retain generic arguments without adding a second syntax recognizer. Walk
-- every owned leaf and materialise the same method specialisation that an
-- explicit generic method call would request.
pub(package) fn pipeline_collect_generic_drop_plan_components(components: i64, templates: i64, all_fns: i64, tt: i64, src: i64) -> IrFunctionList {
  let mut result = ir_function_list_empty()
  if components != 0 {
    for i in 0..nlist_len(components) {
      result = pipeline_ir_function_list_append(
        result,
        pipeline_collect_generic_drop_plan_specs(
          typeck_linear_layout_component_plan(nlist_get(components, i)),
          templates,
          all_fns,
          tt,
          src
        )
      )
    }
  } else { 0 }
  result
}

pub(package) fn pipeline_collect_generic_drop_plan_alternatives(alternatives: i64, templates: i64, all_fns: i64, tt: i64, src: i64) -> IrFunctionList {
  let mut result = ir_function_list_empty()
  if alternatives != 0 {
    for i in 0..nlist_len(alternatives) {
      result = pipeline_ir_function_list_append(
        result,
        pipeline_collect_generic_drop_plan_components(
          typeck_linear_layout_variant_payloads(nlist_get(alternatives, i)),
          templates,
          all_fns,
          tt,
          src
        )
      )
    }
  } else { 0 }
  result
}

pub(package) fn pipeline_collect_generic_drop_plan_specs(plan: i64, templates: i64, all_fns: i64, tt: i64, src: i64) -> IrFunctionList {
  if plan == 0 { ir_function_list_empty() }
  else {
    let kind = typeck_linear_layout_plan_kind(plan)
    if kind == 1 {
      let owned_ty = typeck_linear_layout_plan_type(plan)
      let inner_ty = if ty_is_owned(owned_ty) { ty_owned_inner(owned_ty) } else { 0 }
      let type_args = if inner_ty != 0 and ty_tag(inner_ty) == 9 { ty_f3(inner_ty) } else { 0 }
      if type_args == 0 or nlist_len(type_args) == 0 {
        ir_function_list_empty()
      } else {
        let base_hash = pipeline_ir_method_patch_key(cg_owned_drop_type_hash(owned_ty), cg_drop_method_hash())
        let pair = pipeline_generic_template_find(templates, src, base_hash)
        if pair == 0 or fn_tparams(node_f1(pair)) == 0 {
          ir_function_list_empty()
        } else {
          pipeline_lower_generic_specialisation_handler_optimised(
            pair,
            type_args,
            tt,
            pipeline_handler_inline_ctx_empty(),
            all_fns
          )
        }
      }
    } else { if kind == 2 or kind == 3 or kind == 4 {
      pipeline_collect_generic_drop_plan_components(typeck_linear_layout_plan_children(plan), templates, all_fns, tt, src)
    } else { if kind == 5 {
      pipeline_collect_generic_drop_plan_alternatives(typeck_linear_layout_plan_children(plan), templates, all_fns, tt, src)
    } else { if kind == 6 {
      pipeline_collect_generic_drop_plan_specs(typeck_linear_layout_plan_children(plan), templates, all_fns, tt, src)
    } else {
      ir_function_list_empty()
    } } } }
  }
}

-- Only records, named representations, and explicit owned values can produce
-- a linear cleanup plan. Avoid populating the persistent layout cache for the
-- overwhelmingly common primitive/copyable binds and returns merely to prove
-- that they cannot name a generic Drop specialisation.
pub(package) fn pipeline_collect_generic_drop_type_specs(ty: i64, templates: i64, all_fns: i64, tt: i64, src: i64) -> IrFunctionList {
  if ty == 0 or (ty_tag(ty) != 7 and ty_tag(ty) != 9 and ty_tag(ty) != 19) {
    ir_function_list_empty()
  } else {
    pipeline_collect_generic_drop_plan_specs(
      pipeline_linear_cleanup_plan(tt, ty), templates, all_fns, tt, src
    )
  }
}

pub(package) fn pipeline_collect_generic_specs_ir_inst(inst: IrInst, templates: i64, all_fns: i64, tt: i64, src: i64) -> IrFunctionList {
  match inst {
    IrGenericCallI64(dst, callee_hash, type_args, args) -> {
      let call_specs = if pipeline_ir_native_generic_call_emission_intercepted(callee_hash, type_args, args, tt) == 1 {
        ir_function_list_empty()
      } else {
        let pair = pipeline_generic_template_find(templates, 0, callee_hash)
        pipeline_lower_generic_specialisation_handler_optimised(pair, type_expr_list_to_nodes(type_args), tt, pipeline_handler_inline_ctx_empty(), all_fns)
      }
      pipeline_ir_function_list_append(
        call_specs,
        pipeline_collect_generic_drop_type_specs(
          pipeline_ir_abort_cleanup_generic_ret_type(callee_hash, type_args, all_fns),
          templates,
          all_fns,
          tt,
          src
        )
      )
    }
    IrGenericFunctionRefI64(dst, callee_hash, type_args) -> {
      if type_expr_list_len(type_args) == 0 { ir_function_list_empty() }
      else {
        let pair = pipeline_generic_template_find(templates, 0, callee_hash)
        pipeline_lower_generic_specialisation_handler_optimised(pair, type_expr_list_to_nodes(type_args), tt, pipeline_handler_inline_ctx_empty(), all_fns)
      }
    }
    IrBindI64(ns, nl, value, ty) -> {
      pipeline_collect_generic_drop_type_specs(ty, templates, all_fns, tt, src)
    }
    IrCallI64(dst, callee_hash, args) -> {
      pipeline_collect_generic_drop_type_specs(
        pipeline_fns_lookup_ret_type_node_by_hash(all_fns, callee_hash, 0),
        templates,
        all_fns,
        tt,
        src
      )
    }
    IrStructuralDropI64(value, plan) -> pipeline_collect_generic_drop_plan_specs(plan, templates, all_fns, tt, src)
    IrStructuralSlotI64(value, slot, plan, mode) -> pipeline_collect_generic_drop_plan_specs(plan, templates, all_fns, tt, src)
    IrStructuralSplitI64(value, parent_plan, residual_plan, release_backing) -> {
      pipeline_ir_function_list_append(
        pipeline_collect_generic_drop_plan_specs(parent_plan, templates, all_fns, tt, src),
        pipeline_collect_generic_drop_plan_specs(residual_plan, templates, all_fns, tt, src)
      )
    }
    IrTryLinearI64(dst, value, effect_key, parent_plan, ok_plan, error_plan) -> {
      pipeline_ir_function_list_append(
        pipeline_collect_generic_drop_plan_specs(parent_plan, templates, all_fns, tt, src),
        pipeline_ir_function_list_append(
          pipeline_collect_generic_drop_plan_specs(ok_plan, templates, all_fns, tt, src),
          pipeline_collect_generic_drop_plan_specs(error_plan, templates, all_fns, tt, src)
        )
      )
    }
    IrReuseInitI64(token, constructor) -> {
      pipeline_collect_generic_specs_ir_inst(constructor, templates, all_fns, tt, src)
    }
    -- Hoisted lambda: the carried function's blocks hold the generic
    -- call sites the body Expr used to hold.
    IrClosureI64(dst, f, captures, eff) -> {
      match f {
        IrFunction(chash, cparams, cblocks, csrc) -> pipeline_collect_generic_specs_ir_blocks(cblocks, templates, all_fns, tt, src)
      }
    }
    IrHandleI64(dst, handle_src, effect_hash, clauses, nclauses, reserved) -> {
      pipeline_collect_generic_specs_ir_handler_clauses(clauses, templates, all_fns, tt, src)
    }
    IrDeferredHandleI64(dst, handle_src, body, clauses, nclauses, effect_hash, scratch_base) -> {
      pipeline_ir_function_list_append(
        pipeline_collect_generic_specs_ir_deferred_body(body, templates, all_fns, tt, src),
        pipeline_collect_generic_specs_ir_handler_clauses(clauses, templates, all_fns, tt, src)
      )
    }
    _ -> ir_function_list_empty()
  }
}

pub(package) fn pipeline_collect_generic_specs_ir_insts(insts: IrInstList, templates: i64, all_fns: i64, tt: i64, src: i64) -> IrFunctionList {
  match insts {
    IrInstNil -> ir_function_list_empty()
    IrInstCons(inst, rest) -> {
      pipeline_ir_function_list_append(
        pipeline_collect_generic_specs_ir_inst(inst, templates, all_fns, tt, src),
        pipeline_collect_generic_specs_ir_insts(rest, templates, all_fns, tt, src)
      )
    }
  }
}

pub(package) fn pipeline_collect_generic_specs_ir_blocks(blocks: IrBlockList, templates: i64, all_fns: i64, tt: i64, src: i64) -> IrFunctionList {
  match blocks {
    IrBlockListNil -> ir_function_list_empty()
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          pipeline_ir_function_list_append(
            pipeline_collect_generic_specs_ir_insts(insts, templates, all_fns, tt, src),
            pipeline_collect_generic_specs_ir_blocks(rest, templates, all_fns, tt, src)
          )
        }
      }
    }
  }
}

pub(package) fn pipeline_collect_generic_specs_ir_functions(functions: IrFunctionList, templates: i64, all_fns: i64, tt: i64) -> IrFunctionList {
  match functions {
    IrFunctionNil -> ir_function_list_empty()
    IrFunctionCons(f, rest) -> {
      pipeline_ir_function_list_append(
        pipeline_collect_generic_specs_ir_function(f, templates, all_fns, tt),
        pipeline_collect_generic_specs_ir_functions(rest, templates, all_fns, tt)
      )
    }
  }
}

pub(package) fn pipeline_collect_generic_specs_ir_function(f: IrFunction, templates: i64, all_fns: i64, tt: i64) -> IrFunctionList {
  match f {
    IrFunction(hash, param_count, blocks, src) -> pipeline_collect_generic_specs_ir_blocks(blocks, templates, all_fns, tt, src)
  }
}

pub(package) fn pipeline_generic_spec_closure_state_result(state: PipelineGenericSpecClosureState) -> IrFunctionList {
  match state {
    PipelineGenericSpecClosureState(result, work) -> result
  }
}

pub(package) fn pipeline_generic_spec_closure_state_work(state: PipelineGenericSpecClosureState) -> IrFunctionList {
  match state {
    PipelineGenericSpecClosureState(result, work) -> work
  }
}

pub(package) fn pipeline_collect_generic_specs_add_unseen(candidates: IrFunctionList, seen: i64, result: IrFunctionList, work: IrFunctionList) -> PipelineGenericSpecClosureState {
  match candidates {
    IrFunctionNil -> PipelineGenericSpecClosureState(result, work)
    IrFunctionCons(f, rest) -> {
      match f {
        IrFunction(hash, param_count, blocks, src) -> {
          if pipeline_hash_nlist_contains(seen, hash) == 1 {
            pipeline_collect_generic_specs_add_unseen(rest, seen, result, work)
          } else {
            nlist_add(seen, hash)
            pipeline_collect_generic_specs_add_unseen(rest, seen, ir_function_list_prepend(f, result), ir_function_list_prepend(f, work))
          }
        }
      }
    }
  }
}

pub(package) fn pipeline_collect_generic_specs_closure_work(result: IrFunctionList, work: IrFunctionList, seen: i64, templates: i64, all_fns: i64, tt: i64) -> IrFunctionList {
  match work {
    IrFunctionNil -> pipeline_ir_function_list_reverse(result)
    IrFunctionCons(f, rest) -> {
      let nested = pipeline_collect_generic_specs_ir_function(f, templates, all_fns, tt)
      let next = pipeline_collect_generic_specs_add_unseen(nested, seen, result, rest)
      pipeline_collect_generic_specs_closure_work(
        pipeline_generic_spec_closure_state_result(next),
        pipeline_generic_spec_closure_state_work(next),
        seen,
        templates,
        all_fns,
        tt
      )
    }
  }
}

pub(package) fn pipeline_collect_generic_specs_closure(specs: IrFunctionList, templates: i64, all_fns: i64, tt: i64) -> IrFunctionList {
  let seen = nlist_new()
  let seed = pipeline_collect_generic_specs_add_unseen(specs, seen, ir_function_list_empty(), ir_function_list_empty())
  pipeline_collect_generic_specs_closure_work(
    pipeline_generic_spec_closure_state_result(seed),
    pipeline_generic_spec_closure_state_work(seed),
    seen,
    templates,
    all_fns,
    tt
  )
}

pub(package) fn pipeline_lower_ir(typed: TypedModule) -> IrModule {
  match typed {
    TypedModule(fns, src, tt) -> {
      let sidecar = pipeline_lower_typed_functions_internal(typed)
      IrModule(sidecar)
    }
  }
}

pub(package) fn pipeline_ir_function_list_find_hash(functions: IrFunctionList, name_hash: i64) -> IrFunctionList {
  let mut cur = functions
  let mut found = ir_function_list_empty()
  let mut done = 0
  while done == 0 {
    match cur {
      IrFunctionNil -> { done = 1 0 }
      IrFunctionCons(f, rest) -> {
        match f {
          IrFunction(hash, params, blocks, src) -> {
            if hash == name_hash {
              found = ir_function_list_prepend(f, ir_function_list_empty())
              done = 1
            } else {
              cur = rest
            }
          }
        }
        0
      }
    }
  }
  found
}

-- ======================================================================
-- Static callback identity specialisation (banked devirtualisation)
--
-- A named function value is an immutable static closure pair and
-- IrFunctionRefI64 is its semantic identity producer. Generic
-- specialisations that receive such a value are cloned per call-site
-- recipe (parameter index -> named function hash). Inside the clone,
-- recipe-bound indirect calls become ordinary direct calls. A recipe is
-- forwarded through nested generic calls, so helper chains specialise
-- transitively without assuming that every call site in the program has
-- the same callback.
--
-- IrFunctionRefI64 names an env-free direct target. IrClosureI64 names
-- an ordinary hoisted fn whose per-instance environment is recovered
-- from the pair and passed explicitly as arg 0. Values produced by
-- calls, loads, merges, or mutable slots remain dynamic.
-- ======================================================================

pub(package) fn pipeline_ir_function_ref_target_hash(callee_hash: i64, type_args: TypeExprList) -> i64 {
  if type_expr_list_len(type_args) == 0 { callee_hash }
  else { mono_spec_hash(callee_hash, type_expr_list_to_nodes(type_args)) }
}

pub(package) fn pipeline_ir_identity_specialisations_functions(result: PipelineIrIdentitySpecialisations) -> IrFunctionList {
  match result {
    PipelineIrIdentitySpecialisations(functions, requests) -> functions
  }
}

pub(package) fn pipeline_ir_identity_specialisations_requests(result: PipelineIrIdentitySpecialisations) -> i64 {
  match result {
    PipelineIrIdentitySpecialisations(functions, requests) -> requests
  }
}

pub(package) fn pipeline_ir_identity_value_defs_insts(insts: IrInstList, defs: i64) -> i64 {
  match insts {
    IrInstNil -> defs
    IrInstCons(inst, rest) -> {
      match inst {
        -- Descriptor layout: [SSA value, target hash, kind, 0].
        -- kind 1 is a static named-function pair; kind 2 is a closure
        -- pair whose environment must be loaded and passed as arg 0.
        IrFunctionRefI64(dst, callee_hash) -> nlist_add(defs, node_new(0, dst, callee_hash, 1, 0))
        IrGenericFunctionRefI64(dst, callee_hash, type_args) -> nlist_add(defs, node_new(0, dst, pipeline_ir_function_ref_target_hash(callee_hash, type_args), 1, 0))
        IrClosureI64(dst, f, captures, evidence) -> nlist_add(defs, node_new(0, dst, pipeline_ir_function_hash(f), 2, 0))
        _ -> 0
      }
      pipeline_ir_identity_value_defs_insts(rest, defs)
    }
  }
}

pub(package) fn pipeline_ir_identity_value_defs_blocks(blocks: IrBlockList, defs: i64) -> i64 {
  match blocks {
    IrBlockListNil -> defs
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> pipeline_ir_identity_value_defs_insts(insts, defs)
      }
      pipeline_ir_identity_value_defs_blocks(rest, defs)
    }
  }
}

pub(package) fn pipeline_ir_identity_value_defs(blocks: IrBlockList) -> i64 {
  pipeline_ir_identity_value_defs_blocks(blocks, nlist_new())
}

pub(package) fn pipeline_ir_identity_has_value_defs_insts(insts: IrInstList) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let hit = match inst {
        IrFunctionRefI64(dst, callee_hash) -> 1
        IrGenericFunctionRefI64(dst, callee_hash, type_args) -> 1
        IrClosureI64(dst, f, captures, evidence) -> 1
        _ -> 0
      }
      if hit == 1 { 1 } else { pipeline_ir_identity_has_value_defs_insts(rest) }
    }
  }
}

pub(package) fn pipeline_ir_identity_has_value_defs_blocks(blocks: IrBlockList) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      let hit = match block {
        IrBlock(id, params, insts, term) -> pipeline_ir_identity_has_value_defs_insts(insts)
      }
      if hit == 1 { 1 } else { pipeline_ir_identity_has_value_defs_blocks(rest) }
    }
  }
}

pub(package) fn pipeline_ir_identity_value_def_lookup(defs: i64, value: i64) -> i64 {
  let mut identity = 0
  let mut i = 0
  let n = nlist_len(defs)
  while i < n and identity == 0 {
    let entry = nlist_get(defs, i)
    if node_f1(entry) == value { identity = entry } else { i = i + 1 }
  }
  identity
}

-- Recipe entries are raw scratch nodes [parameter index, callee hash].
-- They never enter the IR and are reclaimed with the surrounding
-- compile arena.
pub(package) fn pipeline_ir_identity_recipe_lookup(recipe: i64, param_index: i64) -> i64 {
  let mut identity = 0
  let mut i = 0
  let n = nlist_len(recipe)
  while i < n and identity == 0 {
    let entry = nlist_get(recipe, i)
    if node_f1(entry) == param_index { identity = entry } else { i = i + 1 }
  }
  identity
}

pub(package) fn pipeline_ir_identity_value(value: i64, defs: i64, recipe: i64, param_count: i64) -> i64 {
  let local = pipeline_ir_identity_value_def_lookup(defs, value)
  if local != 0 { local }
  else { if value >= 0 and value < param_count {
    pipeline_ir_identity_recipe_lookup(recipe, value)
  } else { 0 } }
}

pub(package) fn pipeline_ir_identity_values_contains(values: IrValueList, value: i64) -> i64 {
  match values {
    IrValueNil -> 0
    IrValueCons(head, rest) -> {
      if head == value { 1 } else { pipeline_ir_identity_values_contains(rest, value) }
    }
  }
}

-- A binding is useful only when the corresponding parameter is called
-- indirectly here or forwarded into another generic call. This keeps
-- function values that are merely returned/stored on the canonical
-- body and avoids emitting no-op clones.
pub(package) fn pipeline_ir_identity_param_relevant_insts(insts: IrInstList, param_index: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let hit = match inst {
        IrIndirectCallI64(dst, callee, args, result_ty) -> if callee == param_index { 1 } else { 0 }
        IrGenericCallI64(dst, callee_hash, type_args, args) -> pipeline_ir_identity_values_contains(args, param_index)
        _ -> 0
      }
      if hit == 1 { 1 } else { pipeline_ir_identity_param_relevant_insts(rest, param_index) }
    }
  }
}

pub(package) fn pipeline_ir_identity_param_relevant_blocks(blocks: IrBlockList, param_index: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      let hit = match block {
        IrBlock(id, params, insts, term) -> pipeline_ir_identity_param_relevant_insts(insts, param_index)
      }
      if hit == 1 { 1 } else { pipeline_ir_identity_param_relevant_blocks(rest, param_index) }
    }
  }
}

pub(package) fn pipeline_ir_identity_recipe_from_args_inner(args: IrValueList, index: i64, defs: i64, caller_recipe: i64, caller_param_count: i64, base_blocks: IrBlockList, result: i64) -> i64 {
  match args {
    IrValueNil -> result
    IrValueCons(value, rest) -> {
      let identity = pipeline_ir_identity_value(value, defs, caller_recipe, caller_param_count)
      if identity != 0 and pipeline_ir_identity_param_relevant_blocks(base_blocks, index) == 1 {
        nlist_add(result, node_new(0, index, node_f2(identity), node_f3(identity), 0))
      } else { 0 }
      pipeline_ir_identity_recipe_from_args_inner(rest, index + 1, defs, caller_recipe, caller_param_count, base_blocks, result)
    }
  }
}

pub(package) fn pipeline_ir_identity_recipe_from_args(args: IrValueList, defs: i64, caller_recipe: i64, caller_param_count: i64, base: IrFunction) -> i64 {
  match base {
    IrFunction(hash, param_count, blocks, src) -> {
      pipeline_ir_identity_recipe_from_args_inner(args, 0, defs, caller_recipe, caller_param_count, blocks, nlist_new())
    }
  }
}

pub(package) fn pipeline_ir_identity_recipe_equal(left: i64, right: i64) -> i64 {
  let n = nlist_len(left)
  if n != nlist_len(right) { 0 }
  else {
    let mut same = 1
    let mut i = 0
    while i < n and same == 1 {
      let a = nlist_get(left, i)
      let b = nlist_get(right, i)
      if node_f1(a) == node_f1(b) and node_f2(a) == node_f2(b) and node_f3(a) == node_f3(b) {
        i = i + 1
      } else {
        same = 0
      }
    }
    same
  }
}

pub(package) fn pipeline_ir_identity_request_lookup(requests: i64, base_hash: i64, recipe: i64) -> i64 {
  let mut clone_hash = 0
  let mut i = 0
  let n = nlist_len(requests)
  while i < n and clone_hash == 0 {
    let entry = nlist_get(requests, i)
    if node_f1(entry) == base_hash and pipeline_ir_identity_recipe_equal(node_f3(entry), recipe) == 1 {
      clone_hash = node_f2(entry)
    } else {
      i = i + 1
    }
  }
  clone_hash
}

pub(package) fn pipeline_ir_identity_function_hash_exists(functions: IrFunctionList, target_hash: i64) -> i64 {
  match functions {
    IrFunctionNil -> 0
    IrFunctionCons(f, rest) -> {
      match f {
        IrFunction(hash, params, blocks, src) -> {
          if hash == target_hash { 1 } else { pipeline_ir_identity_function_hash_exists(rest, target_hash) }
        }
      }
    }
  }
}

pub(package) fn pipeline_ir_identity_request_hash_exists(requests: i64, target_hash: i64) -> i64 {
  let mut found = 0
  let mut i = 0
  let n = nlist_len(requests)
  while i < n and found == 0 {
    if node_f2(nlist_get(requests, i)) == target_hash { found = 1 } else { i = i + 1 }
  }
  found
}

pub(package) fn pipeline_ir_identity_recipe_hash(base_hash: i64, recipe: i64) -> i64 {
  let mut h = base_hash * 1000003 + 32452843
  let n = nlist_len(recipe)
  for i in 0..n {
    let entry = nlist_get(recipe, i)
    h = h * 31 + node_f1(entry) * 131 + node_f2(entry) + node_f3(entry) * 8191
  }
  if h == 0 { 49979687 } else { h }
}

pub(package) fn pipeline_ir_identity_request_ensure(requests: i64, all_functions: IrFunctionList, base_hash: i64, recipe: i64) -> i64 {
  let existing = pipeline_ir_identity_request_lookup(requests, base_hash, recipe)
  if existing != 0 { existing }
  else {
    let mut clone_hash = pipeline_ir_identity_recipe_hash(base_hash, recipe)
    while pipeline_ir_identity_function_hash_exists(all_functions, clone_hash) == 1 or pipeline_ir_identity_request_hash_exists(requests, clone_hash) == 1 {
      clone_hash = clone_hash + 104729
      if clone_hash == 0 { clone_hash = 49979687 } else { 0 }
    }
    nlist_add(requests, node_new(0, base_hash, clone_hash, recipe, 0))
    clone_hash
  }
}

pub(package) fn pipeline_ir_identity_inst_rewrite_insts(result: PipelineIrIdentityInstRewrite) -> IrInstList {
  match result {
    PipelineIrIdentityInstRewrite(insts, next_value) -> insts
  }
}

pub(package) fn pipeline_ir_identity_inst_rewrite_next_value(result: PipelineIrIdentityInstRewrite) -> i64 {
  match result {
    PipelineIrIdentityInstRewrite(insts, next_value) -> next_value
  }
}

pub(package) fn pipeline_ir_identity_block_rewrite_blocks(result: PipelineIrIdentityBlockRewrite) -> IrBlockList {
  match result {
    PipelineIrIdentityBlockRewrite(blocks, next_value) -> blocks
  }
}

pub(package) fn pipeline_ir_identity_block_rewrite_next_value(result: PipelineIrIdentityBlockRewrite) -> i64 {
  match result {
    PipelineIrIdentityBlockRewrite(blocks, next_value) -> next_value
  }
}

pub(package) fn pipeline_ir_identity_direct_call_rewrite(dst: i64, callee: i64, args: IrValueList, identity: i64, next_value: i64) -> PipelineIrIdentityInstRewrite {
  let target = node_f2(identity)
  let kind = node_f3(identity)
  if kind == 1 {
    PipelineIrIdentityInstRewrite(
      ir_inst_list_prepend(IrCallI64(dst, target, args), ir_inst_list_empty()),
      next_value
    )
  } else {
    -- A hoisted lambda is an ordinary fn(env, args...). Recover env
    -- from the closure pair and feed it as direct arg 0. Three fresh
    -- SSA ids stay above the function's existing value range.
    let offset = next_value
    let address = next_value + 1
    let env = next_value + 2
    let insts = ir_inst_list_prepend(
      IrConstI64(offset, 8),
      ir_inst_list_prepend(
        IrBinaryI64(address, IrAdd, callee, offset),
        ir_inst_list_prepend(
          IrPtrLoadI64(env, address),
          ir_inst_list_prepend(IrCallI64(dst, target, ir_value_list_prepend(env, args)), ir_inst_list_empty())
        )
      )
    )
    PipelineIrIdentityInstRewrite(insts, next_value + 3)
  }
}

pub(package) fn pipeline_ir_identity_rewrite_inst(inst: IrInst, defs: i64, recipe: i64, param_count: i64, all_functions: IrFunctionList, requests: i64, next_value: i64) -> PipelineIrIdentityInstRewrite {
  match inst {
    IrIndirectCallI64(dst, callee, args, result_ty) -> {
      let identity = pipeline_ir_identity_value(callee, defs, recipe, param_count)
      if identity == 0 {
        PipelineIrIdentityInstRewrite(ir_inst_list_prepend(inst, ir_inst_list_empty()), next_value)
      } else {
        pipeline_ir_identity_direct_call_rewrite(dst, callee, args, identity, next_value)
      }
    }
    IrGenericCallI64(dst, callee_hash, type_args, args) -> {
      let base_hash = mono_spec_hash(callee_hash, type_expr_list_to_nodes(type_args))
      match pipeline_ir_function_list_find_hash(all_functions, base_hash) {
        IrFunctionNil -> PipelineIrIdentityInstRewrite(ir_inst_list_prepend(inst, ir_inst_list_empty()), next_value)
        IrFunctionCons(base, rest) -> {
          let call_recipe = pipeline_ir_identity_recipe_from_args(args, defs, recipe, param_count, base)
          if nlist_len(call_recipe) == 0 {
            PipelineIrIdentityInstRewrite(ir_inst_list_prepend(inst, ir_inst_list_empty()), next_value)
          } else {
            let clone_hash = pipeline_ir_identity_request_ensure(requests, all_functions, base_hash, call_recipe)
            PipelineIrIdentityInstRewrite(
              ir_inst_list_prepend(IrCallI64(dst, clone_hash, args), ir_inst_list_empty()),
              next_value
            )
          }
        }
      }
    }
    _ -> PipelineIrIdentityInstRewrite(ir_inst_list_prepend(inst, ir_inst_list_empty()), next_value)
  }
}

-- Indirect-call ownership markers are semantic companions of the following
-- call, not independent operations. When callback identity turns that call
-- into a direct target, preserve the checked lane transfer under the stable
-- direct-call sentinel. The rewrite changes dispatch mechanics; it does not
-- gain authority to delete the ownership fact produced during lowering.
pub(package) fn pipeline_ir_identity_indirect_transfer_specialises(insts: IrInstList, defs: i64, recipe: i64, param_count: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> match inst {
      IrManagedTransferI64(call_dst, callee_hash, value, arg_lane, cleanup_kind) -> {
        if call_dst >= 0 and callee_hash == 0 and arg_lane >= 0 {
          pipeline_ir_identity_indirect_transfer_specialises(rest, defs, recipe, param_count)
        } else { 0 }
      }
      IrIndirectCallI64(dst, callee, args, result_ty) -> {
        if pipeline_ir_identity_value(callee, defs, recipe, param_count) != 0 { 1 } else { 0 }
      }
      _ -> 0
    }
  }
}

pub(package) fn pipeline_ir_identity_rewrite_insts(insts: IrInstList, defs: i64, recipe: i64, param_count: i64, all_functions: IrFunctionList, requests: i64, next_value: i64) -> PipelineIrIdentityInstRewrite {
  match insts {
    IrInstNil -> PipelineIrIdentityInstRewrite(IrInstNil, next_value)
    IrInstCons(inst, rest) -> {
      let specialise_transfer = match inst {
        IrManagedTransferI64(call_dst, callee_hash, value, arg_lane, cleanup_kind) -> {
          if call_dst >= 0 and callee_hash == 0 and arg_lane >= 0 {
            pipeline_ir_identity_indirect_transfer_specialises(insts, defs, recipe, param_count)
          } else { 0 }
        }
        _ -> 0
      }
      let rewritten_inst = if specialise_transfer == 1 {
        match inst {
          IrManagedTransferI64(call_dst, callee_hash, value, arg_lane, cleanup_kind) ->
            IrManagedTransferI64(call_dst, pipeline_direct_managed_transfer_hash(), value, arg_lane, cleanup_kind)
          _ -> inst
        }
      } else { inst }
      {
        let head = pipeline_ir_identity_rewrite_inst(rewritten_inst, defs, recipe, param_count, all_functions, requests, next_value)
        let tail = pipeline_ir_identity_rewrite_insts(
          rest,
          defs,
          recipe,
          param_count,
          all_functions,
          requests,
          pipeline_ir_identity_inst_rewrite_next_value(head)
        )
        PipelineIrIdentityInstRewrite(
          ir_inst_list_append(pipeline_ir_identity_inst_rewrite_insts(head), pipeline_ir_identity_inst_rewrite_insts(tail)),
          pipeline_ir_identity_inst_rewrite_next_value(tail)
        )
      }
    }
  }
}

pub(package) fn pipeline_ir_identity_rewrite_blocks(blocks: IrBlockList, defs: i64, recipe: i64, param_count: i64, all_functions: IrFunctionList, requests: i64, next_value: i64) -> PipelineIrIdentityBlockRewrite {
  match blocks {
    IrBlockListNil -> PipelineIrIdentityBlockRewrite(IrBlockListNil, next_value)
    IrBlockListCons(block, rest) -> {
      let rewritten_insts = match block {
        IrBlock(id, params, insts, term) -> {
          pipeline_ir_identity_rewrite_insts(insts, defs, recipe, param_count, all_functions, requests, next_value)
        }
      }
      let rewritten_block = match block {
        IrBlock(id, params, insts, term) -> {
          IrBlock(id, params, pipeline_ir_identity_inst_rewrite_insts(rewritten_insts), term)
        }
      }
      let rewritten_rest = pipeline_ir_identity_rewrite_blocks(
        rest,
        defs,
        recipe,
        param_count,
        all_functions,
        requests,
        pipeline_ir_identity_inst_rewrite_next_value(rewritten_insts)
      )
      PipelineIrIdentityBlockRewrite(
        ir_block_list_prepend(rewritten_block, pipeline_ir_identity_block_rewrite_blocks(rewritten_rest)),
        pipeline_ir_identity_block_rewrite_next_value(rewritten_rest)
      )
    }
  }
}

pub(package) fn pipeline_ir_identity_rewrite_function(f: IrFunction, output_hash: i64, recipe: i64, all_functions: IrFunctionList, requests: i64) -> IrFunction {
  match f {
    IrFunction(hash, param_count, blocks, src) -> {
      if nlist_len(recipe) == 0 and pipeline_ir_identity_has_value_defs_blocks(blocks) == 0 {
        f
      } else {
        let defs = pipeline_ir_identity_value_defs(blocks)
        let rewritten = pipeline_ir_identity_rewrite_blocks(
          blocks,
          defs,
          recipe,
          param_count,
          all_functions,
          requests,
          pipeline_ir_function_next_value(param_count, blocks)
        )
        ir_function_new_blocks_src(output_hash, param_count, pipeline_ir_identity_block_rewrite_blocks(rewritten), src)
      }
    }
  }
}

pub(package) fn pipeline_ir_identity_rewrite_originals(functions: IrFunctionList, all_functions: IrFunctionList, requests: i64, empty_recipe: i64) -> IrFunctionList {
  match functions {
    IrFunctionNil -> IrFunctionNil
    IrFunctionCons(f, rest) -> {
      let hash = pipeline_ir_function_hash(f)
      ir_function_list_prepend(
        pipeline_ir_identity_rewrite_function(f, hash, empty_recipe, all_functions, requests),
        pipeline_ir_identity_rewrite_originals(rest, all_functions, requests, empty_recipe)
      )
    }
  }
}

pub(package) fn pipeline_ir_identity_specialise(functions: IrFunctionList) -> PipelineIrIdentitySpecialisations {
  let requests = nlist_new()
  let empty_recipe = nlist_new()
  let rewritten = pipeline_ir_identity_rewrite_originals(functions, functions, requests, empty_recipe)
  let mut clones = ir_function_list_empty()
  let mut i = 0
  -- requests may grow while a clone is rewritten: this is the
  -- recipe-aware transitive closure over nested generic calls.
  while i < nlist_len(requests) {
    let request = nlist_get(requests, i)
    let base_hash = node_f1(request)
    let clone_hash = node_f2(request)
    let recipe = node_f3(request)
    match pipeline_ir_function_list_find_hash(functions, base_hash) {
      IrFunctionNil -> 0
      IrFunctionCons(base, rest) -> {
        clones = ir_function_list_prepend(
          pipeline_ir_identity_rewrite_function(base, clone_hash, recipe, functions, requests),
          clones
        )
        0
      }
    }
    i = i + 1
  }
  PipelineIrIdentitySpecialisations(
    pipeline_ir_function_list_append(rewritten, pipeline_ir_function_list_reverse(clones)),
    requests
  )
}

pub(package) fn pipeline_ir_identity_facts_extend(requests: i64, base_facts: PipelineIrSemanticFactList) -> PipelineIrSemanticFactList {
  let mut facts = base_facts
  let n = nlist_len(requests)
  for i in 0..n {
    let request = nlist_get(requests, i)
    let base_hash = node_f1(request)
    let fact = pipeline_ir_semantic_fact_find(base_facts, base_hash)
    if fact != 0 {
      let borrow = pipeline_ir_semantic_borrow_fact_find(base_facts, base_hash)
      facts = pipeline_ir_semantic_facts_prepend_with_borrow(node_f2(request), fact, borrow, facts)
    } else { 0 }
  }
  facts
}

pub(package) fn pipeline_ir_native_params_unmanaged(params: i64, nparams: i64) -> i64 {
  let mut ok = 1
  for i in 0..nparams {
    let p = nlist_get(params, i)
    if cg_ty_is_managed(node_f3(p)) == 1 { ok = 0 } else { 0 }
  }
  ok
}

pub(package) fn pipeline_ir_native_ty_supported_word_scalar(ty: i64) -> i64 {
  1
}

pub(package) fn pipeline_ir_native_params_supported_word_scalar(params: i64, nparams: i64) -> i64 {
  let mut ok = 1
  for i in 0..nparams {
    let p = nlist_get(params, i)
    if pipeline_ir_native_ty_supported_word_scalar(node_f3(p)) == 0 { ok = 0 } else { 0 }
  }
  ok
}

pub(package) fn pipeline_ir_native_ty_is_fp_scalar(ty: i64) -> i64 {
  if ty == 0 { 0 }
  else {
    if ty_eq(ty, ty_f64()) == 1 { 1 }
    else { if ty_eq(ty, ty_f32()) == 1 { 1 } else { 0 } }
  }
}

pub(package) fn pipeline_ir_native_params_no_fp(params: i64, nparams: i64) -> i64 {
  let mut ok = 1
  for i in 0..nparams {
    let p = nlist_get(params, i)
    if pipeline_ir_native_ty_is_fp_scalar(node_f3(p)) == 1 { ok = 0 } else { 0 }
  }
  ok
}

