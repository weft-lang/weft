-- Derived scaled-index headroom: value v satisfies v <= len(vec) - headroom
-- (headroom >= 1 implies v < len(vec)) as of the derivation point. Stable
-- SSA value facts; the len-kill flag gates consumption, not storage.
pub(package) type PipelineIrRowUpperEnv {
  PipelineIrRowUpperEnvNil,
  PipelineIrRowUpperEnvCons(i64, i64, i64, PipelineIrRowUpperEnv)
}

