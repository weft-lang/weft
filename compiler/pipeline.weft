  PipelineIrNativeFpEnvCons(i64, i64, i64, PipelineIrNativeFpEnv)
}

pub(package) type PipelineIrNativeF64SlotHomeList {
  PipelineIrNativeF64SlotHomeNil,
  -- Slot SSA, assigned d-register, rest.
  PipelineIrNativeF64SlotHomeCons(i64, i64, PipelineIrNativeF64SlotHomeList)
}

pub(package) type PipelineIrNativeF64Facts {
  -- F64 values, slot candidates, GPR-required values, assigned slot homes.
  PipelineIrNativeF64Facts(i64, i64, i64, PipelineIrNativeF64SlotHomeList)
}

pub(package) type PipelineIrNativeVectorDataFactList {
  PipelineIrNativeVectorDataFactNil,
  -- Access result SSA, vector SSA, reload-required bit, rest.
  PipelineIrNativeVectorDataFactCons(i64, i64, i64, PipelineIrNativeVectorDataFactList)
}

pub(package) type PipelineIrNativeVectorDataFacts {
  -- Allocated physical home (zero until assigned), per-access facts.
  PipelineIrNativeVectorDataFacts(i64, PipelineIrNativeVectorDataFactList)
}

pub(package) type PipelineIrNativeValueHomeFacts {
  -- Dense value-indexed homes, allocator assignment ledger, first handler
  -- scratch value, forwarding cell. Handler scratch is function-local and
  -- must sit above every real/contextual value rather than at a fixed id.
  PipelineIrNativeValueHomeFacts(i64, i64, i64, i64),
  -- Explicit canonical-home view after allocator residents were snapshotted.
  PipelineIrNativeIdentityHomeFacts(i64, i64, i64)
}

pub(package) type PipelineNativeEmitCtx {
  -- The final fields are the mutable handle-abort ADR patch list and the
  -- destination of an immediately pending typed direct managed transfer.
  -- Nested clause functions get their own patch list and pending state.
  PipelineNativeEmitCtx(i64, PipelineNativeHandlerCtx, PipelineIrNativeValueHomeFacts, PipelineIrNativeF64Facts, i64, PipelineIrNativeFpEnv, PipelineIrNativeVectorDataFacts, i64, i64)
}

pub(package) type PipelineIrNativeTermEmitInfo {
  PipelineIrNativeTermEmitInfo(i64, i64, PipelineIrNativeValueHomeFacts, i64)
}

pub(package) type PipelineIrNativeCfgState {
  PipelineIrNativeCfgState(i64, i64, PipelineIrNativeValueHomeFacts, i64)
}

pub(package) type PipelineIrNativeHandlerHomeScan {
  PipelineIrNativeHandlerHomeScan(i64, i64)
}

pub(package) type PipelineCgExprCtx {
  PipelineCgExprCtx(i64, i64, i64, i64, i64)
}

impl TypedGrammar for WeftGrammar {
  fn check(self: i64, fns: i64, src: i64, tt: i64) -[Diagnose]> i64 {
    -- Grammar checking consumes an already assembled module graph. Source
    -- acquisition belongs to the loader-aware pipeline, not this pure grammar
    -- interpretation boundary.
    pipeline_check_loaded(fns, src, tt)
  }
}

-- Loader-aware pipelines bind every source before entering this shared core.
-- Keeping that boundary explicit prevents a failed observed prelude load from
-- silently retrying through the default filesystem path during checking.
pub(package) fn pipeline_check_loaded(fns: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  -- Module-owned scope facts are audited once before checker consumers run:
  -- unused bad selections, illegal widening, and collisions are errors in
  -- the import graph itself rather than only when a spelling is referenced.
  module_scope_build_all(tt)
  let module_scope_errors = module_diagnose_scope_issues(tt)
  let package_export_errors = package_export_audit_loaded(tt)
  let trait_identity_errors = typeck_resolve_qualified_impl_traits(tt)
  typeck_prepare_impl_target_representations(tt)
  let ct = build_ctable(tt, src)
  ttable_set_ct(tt, ct)
  module_scope_errors + package_export_errors + trait_identity_errors + handle check_user_fns(fns, src, tt) {
    Conformance.conforms(ty, trh) -> resume(ctable_conforms_type_atom(ct, ty, trh))
  }
}

pub(package) fn pipeline_check_loaded_extending_checked(fns: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  module_scope_build_all(tt)
  let module_scope_errors = module_diagnose_scope_issues(tt)
  let package_export_errors = package_export_audit_loaded(tt)
  let trait_identity_errors = typeck_resolve_qualified_impl_traits(tt)
  typeck_prepare_impl_target_representations(tt)
  let ct = build_ctable(tt, src)
  ttable_set_ct(tt, ct)
  module_scope_errors + package_export_errors + trait_identity_errors + handle check_user_fns_extending_checked(fns, src, tt) {
    Conformance.conforms(ty, trh) -> resume(ctable_conforms_type_atom(ct, ty, trh))
  }
}

-- Render a diagnostic whose span may point into any loaded source buffer.
-- Absolute spans resolve through the ttable source registry (file path +
-- line/col in the owning buffer); anything else falls back to root-relative
-- rendering.
pub(package) fn pipeline_diagnose_render(tt: i64, src: i64, msg: str, span: i64) -> i64 {
  let entry = ttable_find_source_entry(tt, span)
  if entry == 0 { diagnose_render(src, msg, span) }
  else {
    let buf = mem_load64_at(entry, 0)
    let path_ptr = mem_load64_at(entry + 16, 0)
    let path_len = mem_load64_at(entry + 24, 0)
    if path_len > 0 {
      sys_write(2, path_ptr, path_len)
      eprint(": ")
    } else { 0 }
    eprint_span(buf, span - buf)
    eprint(msg)
    eprint("\n")
  }
}

pub(package) fn pipeline_diagnose_render_report(tt: i64, diagnostic: Diagnostic) -> i64 {
  diagnose_render_report_in_registry(tt, diagnostic)
}

pub(package) fn pipeline_parse_with_error_count(grammar: WeftGrammar, src: i64, n: i64, tt: i64) -[SourceAcquire]> PipelineParseResult {
  let errors = alloc_words(1)
  mem_store64_at(errors, 0, 0)
  let fns = handle parse_module(grammar.lex(src, n), src, tt) {
    Diagnose.report(diagnostic) -> {
      if diagnose_report_severity_tag(diagnostic) == 1 { mem_store64_at(errors, 0, mem_load64_at(errors, 0) + 1) } else { 0 }
      pipeline_diagnose_render_report(tt, diagnostic)
      resume(0)
    }
    Diagnose.error(msg, span) -> {
      mem_store64_at(errors, 0, mem_load64_at(errors, 0) + 1)
      pipeline_diagnose_render(tt, src, msg, span)
      resume(0)
    }
    Diagnose.warn(msg, span) -> { pipeline_diagnose_render(tt, src, msg, span) resume(0) }
    Diagnose.note(msg, span) -> { pipeline_diagnose_render(tt, src, msg, span) resume(0) }
  }
  PipelineParseResult(fns, mem_load64_at(errors, 0))
}

-- Root-only parse with the same diagnostic contract as the complete grammar
-- path. Imports are syntax-checked but not loaded; callers that proceed must
-- still request a complete parse before checking or lowering.
pub(package) fn pipeline_parse_local_with_error_count(grammar: WeftGrammar, src: i64, n: i64, tt: i64) -> PipelineParseResult {
  let errors = alloc_words(1)
  mem_store64_at(errors, 0, 0)
  let fns = handle parse_module_local(grammar.lex(src, n), src, tt) {
    Diagnose.report(diagnostic) -> {
      if diagnose_report_severity_tag(diagnostic) == 1 { mem_store64_at(errors, 0, mem_load64_at(errors, 0) + 1) } else { 0 }
      pipeline_diagnose_render_report(tt, diagnostic)
      resume(0)
    }
    Diagnose.error(msg, span) -> {
      mem_store64_at(errors, 0, mem_load64_at(errors, 0) + 1)
      pipeline_diagnose_render(tt, src, msg, span)
      resume(0)
    }
    Diagnose.warn(msg, span) -> { pipeline_diagnose_render(tt, src, msg, span) resume(0) }
    Diagnose.note(msg, span) -> { pipeline_diagnose_render(tt, src, msg, span) resume(0) }
  }
  PipelineParseResult(fns, mem_load64_at(errors, 0))
}

-- Safe provenance setup for general project tools. This entry cannot grant
-- trust: callers get an ordinary strict root regardless of their own origin.
-- Trusted compiler/runtime compilation requires the sealed policy path.
pub(package) fn pipeline_mark_untrusted_root_origin(tt: i64, src: i64) -> i64 {
  pipeline_mark_root_origin(tt, src, 0, 1)
}

pub(package) fn pipeline_parse(grammar: WeftGrammar, src: i64, n: i64, tt: i64) -[SourceAcquire]> i64 {
  match pipeline_parse_with_error_count(grammar, src, n, tt) {
    PipelineParseResult(fns, errors) -> fns
  }
}

pub(package) fn pipeline_check(grammar: WeftGrammar, fns: i64, src: i64, tt: i64) -[Diagnose, SourceAcquire]> i64 {
  pipeline_check_with_loader(grammar, fns, src, tt, parse_default_source_loader)
}

pub(package) fn pipeline_check_with_loader<E>(grammar: WeftGrammar, fns: i64, src: i64, tt: i64, loader: (i64, i64, i64, i64, i64) -[E]> i64) -[Diagnose, E]> i64 {
  -- Language surface first, compiler-owned lowering support second. This is
  -- separate from parse-only tooling and lets runtime selection observe any
  -- implementation needs introduced by the real prelude module graph.
  parse_bind_implicit_prelude_with_loader<E>(fns, src, tt, loader)
  pipeline_bind_runtime_preludes_inner_with_loader<E>(fns, src, tt, loader)
  pipeline_check_loaded(fns, src, tt)
}

pub(package) fn pipeline_check_extending_checked(grammar: WeftGrammar, fns: i64, src: i64, tt: i64) -[Diagnose, SourceAcquire]> i64 {
  pipeline_check_extending_checked_with_loader(grammar, fns, src, tt, parse_default_source_loader)
}

pub(package) fn pipeline_check_extending_checked_with_loader<E>(grammar: WeftGrammar, fns: i64, src: i64, tt: i64, loader: (i64, i64, i64, i64, i64) -[E]> i64) -[Diagnose, E]> i64 {
  -- The checked base already owns typed bodies and a resolved signature
  -- catalog. A root can still demand additional implicit/runtime modules, so
  -- bind those first; every newly appended pair is then checked exactly once.
  parse_bind_implicit_prelude_with_loader<E>(fns, src, tt, loader)
  pipeline_bind_runtime_preludes_inner_with_loader<E>(fns, src, tt, loader)
  pipeline_check_loaded_extending_checked(fns, src, tt)
}

pub(package) fn pipeline_parse_module(grammar: WeftGrammar, src: i64, n: i64, tt: i64) -[SourceAcquire]> AstModule {
  let fns = pipeline_parse(grammar, src, n, tt)
  AstModule(fns, src, tt)
}

pub(package) fn pipeline_check_fns_with_diagnostics(fns: i64, src: i64, tt: i64) -[Diagnose, SourceAcquire]> TypedModule {
  let grammar = weft_grammar()
  pipeline_check(grammar, fns, src, tt)
  TypedModule(fns, src, tt)
}

pub(package) fn pipeline_check_fns(fns: i64, src: i64, tt: i64) -[SourceAcquire]> TypedModule {
  handle pipeline_check_fns_with_diagnostics(fns, src, tt) {
    Diagnose.report(diagnostic) -> { pipeline_diagnose_render_report(tt, diagnostic) resume(0) }
    Diagnose.error(msg, span) -> { pipeline_diagnose_render(tt, src, msg, span) resume(0) }
    Diagnose.warn(msg, span) -> { pipeline_diagnose_render(tt, src, msg, span) resume(0) }
    Diagnose.note(msg, span) -> { pipeline_diagnose_render(tt, src, msg, span) resume(0) }
  }
}

pub(package) fn pipeline_check_fns_error_count(fns: i64, src: i64, tt: i64) -[SourceAcquire]> i64 {
  let grammar = weft_grammar()
  handle pipeline_check(grammar, fns, src, tt) {
    Diagnose.report(diagnostic) -> { pipeline_diagnose_render_report(tt, diagnostic) resume(0) }
    Diagnose.error(msg, span) -> { pipeline_diagnose_render(tt, src, msg, span) resume(0) }
    Diagnose.warn(msg, span) -> { pipeline_diagnose_render(tt, src, msg, span) resume(0) }
    Diagnose.note(msg, span) -> { pipeline_diagnose_render(tt, src, msg, span) resume(0) }
  }
}

pub(package) fn pipeline_check_module(ast: AstModule) -[SourceAcquire]> TypedModule {
  match ast {
    AstModule(fns, src, tt) -> pipeline_check_fns(fns, src, tt)
  }
}

pub(package) fn pipeline_check_module_standalone(ast: AstModule) -> TypedModule {
  source_acquire_with_standalone(() => pipeline_check_module(ast))
}

pub(package) fn pipeline_ast_fns(ast: AstModule) -> i64 {
  match ast {
    AstModule(fns, src, tt) -> fns
  }
}

pub(package) fn pipeline_typed_fns(typed: TypedModule) -> i64 {
  match typed {
    TypedModule(fns, src, tt) -> fns
  }
}

