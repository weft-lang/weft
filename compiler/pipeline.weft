  let rd = pipeline_ir_native_result_reg(dst, pinned)
  bu32(code, cg_ldr(rd, base_phys, idx * 8))
  if rd == 17 { pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17) } else { pipeline_ir_native_ck_def(code, pinned, rd, dst) }
}

fn pipeline_ir_native_emit_try(code: i64, dst: i64, value: i64, effect_key: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  -- The result value must be re-loaded at EVERY use: a spilled result
  -- reloads into x16, which the tag-constant materialization below also
  -- uses (three chained ? spilled the third result and the payload load
  -- dereferenced the constant — 2u minimal repro), and the error path
  -- reads the payload after a BL that clobbers every caller-saved
  -- scratch. load_reg is free for register-resident homes and re-emits
  -- the spill load otherwise.
  let tag_phys = pipeline_ir_native_load_reg(code, pinned, value)
  bu32(code, cg_ldr(17, tag_phys, 0))
  emit_mov_imm_safe(code, 16, 5862623)
  bu32(code, encode_cmp(17, 16))
  let bne_pos = buf_len(code)
  bu32(code, 0)
  let ok_phys = pipeline_ir_native_load_reg(code, pinned, value)
  bu32(code, cg_ldr(17, ok_phys, 8))
  pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17)
  let b_over_pos = buf_len(code)
  bu32(code, 0)
  let err_start = buf_len(code)
  cg_perform_lookup(code, fm, effect_key, effect_fail_op_hash())
  bu32(code, cg_ldr(9, 13, 8))
  bu32(code, cg_ldr(0, 13, 16))
  let err_phys = pipeline_ir_native_load_reg(code, pinned, value)
  bu32(code, cg_ldr(17, err_phys, 8))
  bu32(code, encode_add_imm(1, 17, 0))
  pipeline_ir_native_emit_masked_clause_call(code)
  pipeline_ir_native_store_reg_pinned(code, pinned, dst, 0)
  let after = buf_len(code)
  bytes_set_u32(code, bne_pos, encode_b_cond(err_start - bne_pos, 1))
  bytes_set_u32(code, b_over_pos, encode_b(after - b_over_pos))
}

fn pipeline_ir_native_emit_opt_chain(code: i64, dst: i64, base: i64, field_index: i64, effect_key: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let base_phys = pipeline_ir_native_load_reg(code, pinned, base)
  let cbz_pos = buf_len(code)
  bu32(code, 0)
  let idx = if field_index >= 0 { field_index } else { 0 }
  bu32(code, cg_ldr(17, base_phys, idx * 8))
  pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17)
  let b_over_pos = buf_len(code)
  bu32(code, 0)
  let nil_start = buf_len(code)
  cg_perform_lookup(code, fm, effect_key, effect_maybe_op_hash())
  bu32(code, cg_ldr(9, 13, 8))
  bu32(code, cg_ldr(0, 13, 16))
  pipeline_ir_native_emit_masked_clause_call(code)
  pipeline_ir_native_store_reg_pinned(code, pinned, dst, 0)
  let after = buf_len(code)
  cg_patch_cbz(code, cbz_pos, base_phys, nil_start)
  bytes_set_u32(code, b_over_pos, encode_b(after - b_over_pos))
}

fn pipeline_ir_vector_check_non_null_bit() -> i64 { 1 }

fn pipeline_ir_vector_check_lower_bound_bit() -> i64 { 2 }

fn pipeline_ir_vector_check_upper_bound_bit() -> i64 { 4 }

fn pipeline_ir_vector_check_has(check_mode: i64, bit: i64) -> i64 {
  if (check_mode band bit) != 0 { 1 } else { 0 }
}

fn pipeline_ir_native_emit_vector_index_valid_mode(code: i64, vec_reg: i64, index_reg: i64, check_mode: i64) -> i64 {
  let patches = nlist_new()
  if pipeline_ir_vector_check_has(check_mode, pipeline_ir_vector_check_non_null_bit()) == 1 {
    0
  } else {
    let null_pos = buf_len(code)
    bu32(code, 0)
    nlist_add(patches, null_pos)
  }
  if pipeline_ir_vector_check_has(check_mode, pipeline_ir_vector_check_lower_bound_bit()) == 1 {
    0
  } else {
    emit_mov_imm_safe(code, 16, 0)
    cg_cmp_emit(code, 10, 13, index_reg, 16)
    let nonneg_pos = buf_len(code)
    bu32(code, 0)
    nlist_add(patches, nonneg_pos)
  }
  if pipeline_ir_vector_check_has(check_mode, pipeline_ir_vector_check_upper_bound_bit()) == 1 {
    0
  } else {
    bu32(code, cg_ldr(16, vec_reg, 8))
    cg_cmp_emit(code, 7, 13, index_reg, 16)
    let in_bounds_pos = buf_len(code)
    bu32(code, 0)
    nlist_add(patches, in_bounds_pos)
  }
  patches
}

fn pipeline_ir_native_patch_vector_index_valid_mode(code: i64, patches: i64, vec_reg: i64, cond_reg: i64, check_mode: i64, done: i64) -> i64 {
  let has_null = if pipeline_ir_vector_check_has(check_mode, pipeline_ir_vector_check_non_null_bit()) == 1 { 0 } else { 1 }
  let has_lower = if pipeline_ir_vector_check_has(check_mode, pipeline_ir_vector_check_lower_bound_bit()) == 1 { 0 } else { 1 }
  let has_upper = if pipeline_ir_vector_check_has(check_mode, pipeline_ir_vector_check_upper_bound_bit()) == 1 { 0 } else { 1 }
  if has_null == 1 { cg_patch_cbz(code, nlist_get(patches, 0), vec_reg, done) } else { 0 }
  if has_lower == 1 { cg_patch_cbz(code, nlist_get(patches, has_null), cond_reg, done) } else { 0 }
  if has_upper == 1 { cg_patch_cbz(code, nlist_get(patches, has_null + has_lower), cond_reg, done) } else { 0 }
}

fn pipeline_ir_native_record_vector_check_elision(fm: i64, check_mode: i64) -> i64 {
  let lower = pipeline_ir_vector_check_has(check_mode, pipeline_ir_vector_check_lower_bound_bit())
  let upper = pipeline_ir_vector_check_has(check_mode, pipeline_ir_vector_check_upper_bound_bit())
  if lower == 1 or upper == 1 { fmap_inc_vector_bounds_elision_count(fm) } else { 0 }
  if lower == 1 and upper == 1 { fmap_inc_vector_full_bounds_elision_count(fm) } else { 0 }
  if lower == 1 or upper == 1 { fmap_inc_indexed_bounds_elision_count(fm) } else { 0 }
  if lower == 1 and upper == 1 { fmap_inc_indexed_full_bounds_elision_count(fm) } else { 0 }
}

fn pipeline_ir_native_record_indexed_call_elision(fm: i64, callee_hash: i64) -> i64 {
  let indexed_mode = pipeline_runtime_index_address_check_mode(callee_hash)
  let check_mode = if indexed_mode >= 0 { indexed_mode } else { pipeline_runtime_slice_address_check_mode(callee_hash) }
  if check_mode >= 0 {
    let lower = pipeline_ir_vector_check_has(check_mode, pipeline_ir_vector_check_lower_bound_bit())
    let upper = pipeline_ir_vector_check_has(check_mode, pipeline_ir_vector_check_upper_bound_bit())
    if lower == 1 or upper == 1 { fmap_inc_indexed_bounds_elision_count(fm) } else { 0 }
    if lower == 1 and upper == 1 { fmap_inc_indexed_full_bounds_elision_count(fm) } else { 0 }
  } else { 0 }
}

fn pipeline_ir_native_emit_vector_data_for_access(code: i64, dst: i64, vec: i64, vec_phys: i64, facts: PipelineIrNativeVectorDataFacts, fm: i64) -> i64 {
  let home = pipeline_ir_native_vector_data_facts_home(facts)
  let reload = pipeline_ir_native_vector_data_fact_reload_for(pipeline_ir_native_vector_data_facts_entries(facts), dst, vec)
  if home == 0 or reload < 0 {
    -- A vector access without its typed fact is a producer/consumer contract
    -- violation. Trap the emitted path instead of silently reviving a local
    -- emission-time recognizer.
    bu32(code, encode_brk(62))
    home
  } else { if reload == 0 {
    fmap_inc_vector_data_hoist_use_count(fm)
    home
  } else {
    bu32(code, cg_ldr(home, vec_phys, 0))
    fmap_inc_vector_data_hoist_count(fm)
    home
  } }
}

fn pipeline_ir_native_emit_vector_get_i64(code: i64, dst: i64, vec: i64, index: i64, fallback: i64, check_mode: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts, vector_data_facts: PipelineIrNativeVectorDataFacts) -> i64 {
  -- The fallback path is cold: check failures branch to a stub after the
  -- lane load that seeds the destination and rejoins, so the happy path
  -- never stages the fallback. With every check elided the fallback is
  -- not materialised at all. An FP-resident destination carries the
  -- result in its pool register on both paths with no GPR round-trip.
  let dst_fd = pipeline_ir_native_fp_resident_fd(pinned, dst)
  let vec_phys = pipeline_ir_native_load_reg(code, pinned, vec)
  if vec_phys == 14 { 0 } else { bu32(code, encode_add_imm(14, vec_phys, 0)) }
  let index_phys = pipeline_ir_native_load_reg(code, pinned, index)
  if index_phys == 15 { 0 } else { bu32(code, encode_add_imm(15, index_phys, 0)) }
  let patches = pipeline_ir_native_emit_vector_index_valid_mode(code, 14, 15, check_mode)
  let vector_data_home = pipeline_ir_native_emit_vector_data_for_access(code, dst, vec, 14, vector_data_facts, fm)
  if dst_fd != 0 {
    bu32(code, encode_ldr_d_reg_lsl3(dst_fd, vector_data_home, 15))
  } else {
    bu32(code, encode_ldr_reg_lsl3(17, vector_data_home, 15))
  }
  if nlist_len(patches) > 0 {
    let skip_pos = buf_len(code)
    bu32(code, 0)
    let stub = buf_len(code)
    let fallback_phys = pipeline_ir_native_load_reg(code, pinned, fallback)
    if dst_fd != 0 { bu32(code, encode_fmov_d_from_x(dst_fd, fallback_phys)) } else { bu32(code, encode_add_imm(17, fallback_phys, 0)) }
    let done = buf_len(code)
    pipeline_ir_native_patch_vector_index_valid_mode(code, patches, 14, 13, check_mode, stub)
    cg_patch_b(code, skip_pos, done)
  } else { 0 }
  if dst_fd == 0 { pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17) } else { 0 }
  fmap_inc_vector_lowering_count(fm)
  fmap_inc_vector_scaled_addr_count(fm)
  pipeline_ir_native_record_vector_check_elision(fm, check_mode)
  0
}

fn pipeline_ir_native_emit_vector_set_i64(code: i64, dst: i64, vec: i64, index: i64, value: i64, check_mode: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts, vector_data_facts: PipelineIrNativeVectorDataFacts) -> i64 {
  let value_fd = pipeline_ir_native_fp_resident_fd(pinned, value)
  if value_fd == 0 {
    let value_phys = pipeline_ir_native_load_reg(code, pinned, value)
    if value_phys == 12 { 0 } else { bu32(code, encode_add_imm(12, value_phys, 0)) }
  } else { 0 }
  let vec_phys = pipeline_ir_native_load_reg(code, pinned, vec)
  if vec_phys == 14 { 0 } else { bu32(code, encode_add_imm(14, vec_phys, 0)) }
  let index_phys = pipeline_ir_native_load_reg(code, pinned, index)
  if index_phys == 15 { 0 } else { bu32(code, encode_add_imm(15, index_phys, 0)) }
  emit_mov_imm_safe(code, 17, 0)
  let patches = pipeline_ir_native_emit_vector_index_valid_mode(code, 14, 15, check_mode)
  let vector_data_home = pipeline_ir_native_emit_vector_data_for_access(code, dst, vec, 14, vector_data_facts, fm)
  if value_fd != 0 {
    bu32(code, encode_str_d_reg_lsl3(value_fd, vector_data_home, 15))
  } else {
    bu32(code, encode_str_reg_lsl3(12, vector_data_home, 15))
  }
  emit_mov_imm_safe(code, 17, 1)
  let done = buf_len(code)
  pipeline_ir_native_patch_vector_index_valid_mode(code, patches, 14, 13, check_mode, done)
  pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17)
  fmap_inc_vector_lowering_count(fm)
  fmap_inc_vector_scaled_addr_count(fm)
  pipeline_ir_native_record_vector_check_elision(fm, check_mode)
  0
}

fn pipeline_ir_native_pop_one(code: i64, facts: PipelineIrNativeValueHomeFacts, ctx: PipelineNativeHandlerCtx) -> PipelineNativeHandlerCtx {
  match ctx {
    PipelineNativeHandlerCtxNil -> PipelineNativeHandlerCtxNil
    PipelineNativeHandlerCtxCons(eff_hash, infos, nclauses, ops_ctr, frame_ctr, is_abortive, rest) -> {
      let fp = pipeline_ir_native_load_reg_raw(code, facts, frame_ctr)
      if is_abortive == 1 {
        bu32(code, cg_ldr(9, fp, handler_frame_abort_cleanup_boundary_offset()))
        bu32(code, cg_str(9, 28, runtime_state_abort_cleanup_top_offset()))
        bu32(code, cg_ldr(9, fp, handler_frame_abort_prev_active_offset()))
        bu32(code, cg_str(9, 28, runtime_state_abort_cleanup_active_offset()))
      } else { 0 }
      bu32(code, cg_ldr(27, fp, handler_frame_prev_offset()))
      rest
    }
  }
}

fn pipeline_ir_native_emit_ctx_scope(ctx: PipelineNativeEmitCtx) -> i64 {
  match ctx {
    PipelineNativeEmitCtx(scope, handlers, pinned, f64_facts, fns, fp_env, vector_data_facts, adr_patches) -> scope
  }
}

fn pipeline_ir_native_emit_ctx_handlers(ctx: PipelineNativeEmitCtx) -> PipelineNativeHandlerCtx {
  match ctx {
    PipelineNativeEmitCtx(scope, handlers, pinned, f64_facts, fns, fp_env, vector_data_facts, adr_patches) -> handlers
  }
}

fn pipeline_ir_native_emit_ctx_pinned(ctx: PipelineNativeEmitCtx) -> PipelineIrNativeValueHomeFacts {
  match ctx {
    PipelineNativeEmitCtx(scope, handlers, pinned, f64_facts, fns, fp_env, vector_data_facts, adr_patches) -> pinned
  }
}

fn pipeline_ir_native_emit_ctx_f64_facts(ctx: PipelineNativeEmitCtx) -> PipelineIrNativeF64Facts {
  match ctx {
    PipelineNativeEmitCtx(scope, handlers, pinned, f64_facts, fns, fp_env, vector_data_facts, adr_patches) -> f64_facts
  }
}

fn pipeline_ir_native_emit_ctx_fns(ctx: PipelineNativeEmitCtx) -> i64 {
  match ctx {
    PipelineNativeEmitCtx(scope, handlers, pinned, f64_facts, fns, fp_env, vector_data_facts, adr_patches) -> fns
  }
}

fn pipeline_ir_native_emit_ctx_fp_env(ctx: PipelineNativeEmitCtx) -> PipelineIrNativeFpEnv {
  match ctx {
    PipelineNativeEmitCtx(scope, handlers, pinned, f64_facts, fns, fp_env, vector_data_facts, adr_patches) -> fp_env
  }
}

fn pipeline_ir_native_emit_ctx_with_fp_env(ctx: PipelineNativeEmitCtx, fp_env: PipelineIrNativeFpEnv) -> PipelineNativeEmitCtx {
  match ctx {
    PipelineNativeEmitCtx(scope, handlers, pinned, f64_facts, fns, old_fp_env, vector_data_facts, adr_patches) -> PipelineNativeEmitCtx(scope, handlers, pinned, f64_facts, fns, fp_env, vector_data_facts, adr_patches)
  }
}

fn pipeline_ir_native_emit_ctx_clear_fp(ctx: PipelineNativeEmitCtx) -> PipelineNativeEmitCtx {
  pipeline_ir_native_emit_ctx_with_fp_env(ctx, pipeline_ir_native_fp_env_empty())
}

fn pipeline_ir_native_emit_ctx_vector_data_facts(ctx: PipelineNativeEmitCtx) -> PipelineIrNativeVectorDataFacts {
  match ctx {
    PipelineNativeEmitCtx(scope, handlers, pinned, f64_facts, fns, fp_env, vector_data_facts, adr_patches) -> vector_data_facts
  }
}

fn pipeline_ir_native_emit_ctx_adr_patches(ctx: PipelineNativeEmitCtx) -> i64 {
  match ctx {
    PipelineNativeEmitCtx(scope, handlers, pinned, f64_facts, fns, fp_env, vector_data_facts, adr_patches) -> adr_patches
  }
}

-- Def-segment split tenancy (2v Stage 4): a still-spilled value with
-- uses both inside and beyond its def's barrier-free segment starts
-- REGISTER-homed (the pinned map carries the pool reg). Right after
-- its def, the walker persists the register to the canonical slot;
-- at the first barrier (and at block boundaries) the value's home
-- FLIPS back to the slot. Segment reads hit the register for free,
-- post-barrier reads hit the slot the walker wrote — the split
-- deletes exactly the segment reloads.
fn pipeline_ir_native_value_home_flip(facts: PipelineIrNativeValueHomeFacts, value: i64, phys: i64) -> i64 {
  match facts {
    PipelineIrNativeValueHomeFacts(homes, assignments, forward) -> {
      if value >= 0 and value < nlist_len(homes) {
        pipeline_ir_native_resident_dense_set(homes, value, phys)
      } else { 0 }
    }
    PipelineIrNativeIdentityHomeFacts(next_value, forward) -> 0
  }
}

fn pipeline_ir_native_split_flip_actives(fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let actives = fmap_current_split_actives(fm)
  if actives == 0 { 0 }
  else {
    let n = nlist_len(actives)
    if n == 0 { 0 }
    else {
      let mut i = 0
      while i < n {
        let v = nlist_get(actives, i)
        pipeline_ir_native_value_home_flip(pinned, v, pipeline_ir_native_identity_home(v))
        i = i + 1
      }
      fmap_set_current_split_actives(fm, nlist_new())
      0
    }
  }
}

fn pipeline_ir_native_split_activate(code: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts, d: i64) -> i64 {
  if d < 8 { 0 }
  else {
    let sm = fmap_current_split_map(fm)
    if sm == 0 { 0 }
    else {
      if d >= nlist_len(sm) { 0 }
      else {
        let reg = nlist_get(sm, d)
        if reg == 0 { 0 }
        else {
          -- The def just wrote the split register (its pinned home);
          -- persist it so post-flip readers find the value in the
          -- canonical slot.
          let slot_home = pipeline_ir_native_identity_home(d)
          emit_store_spill_offset(code, reg, (0 - slot_home - 1) * 8)
          pipeline_ir_native_ck_def(code, pinned, slot_home, d)
          nlist_add(fmap_current_split_actives(fm), d)
          0
        }
      }
    }
  }
}

fn pipeline_ir_native_emit_inst(inst: IrInst, code: i64, src: i64, fm: i64, ctx: PipelineNativeEmitCtx) -> PipelineNativeEmitCtx {
  -- Split hooks bracket the dispatch: a barrier ends every active
  -- segment BEFORE its own emission (its operand reads then hit the
  -- slots, conservatively), and a split value's def persists to its
  -- slot right AFTER the defining instruction.
  if pipeline_ir_native_resident_inst_simple(inst) == 0 {
    pipeline_ir_native_split_flip_actives(fm, pipeline_ir_native_emit_ctx_pinned(ctx))
  } else { 0 }
  pipeline_ir_abort_cleanup_emit_prepare_site(code, pipeline_ir_inst_def_or(inst, 0 - 1), fm, pipeline_ir_native_emit_ctx_pinned(ctx))
  let out_ctx = pipeline_ir_native_emit_inst_dispatch(inst, code, src, fm, ctx)
  pipeline_ir_native_split_activate(code, fm, pipeline_ir_native_emit_ctx_pinned(out_ctx), pipeline_ir_inst_def_or(inst, 0 - 1))
  pipeline_ir_abort_cleanup_emit_register_site(code, pipeline_ir_inst_def_or(inst, 0 - 1), fm, pipeline_ir_native_emit_ctx_pinned(out_ctx))
  out_ctx
}

fn pipeline_ir_native_emit_inst_dispatch(inst: IrInst, code: i64, src: i64, fm: i64, ctx: PipelineNativeEmitCtx) -> PipelineNativeEmitCtx {
  let scope = pipeline_ir_native_emit_ctx_scope(ctx)
  let handlers = pipeline_ir_native_emit_ctx_handlers(ctx)
  let pinned = pipeline_ir_native_emit_ctx_pinned(ctx)
  let fns = pipeline_ir_native_emit_ctx_fns(ctx)
  match inst {
    IrConstI64(dst, value) -> { pipeline_ir_native_emit_const(code, dst, value, pinned) ctx }
    IrNilI64(dst) -> { pipeline_ir_native_emit_const(code, dst, 0, pinned) ctx }
    IrStringLit(dst, start, len) -> { pipeline_ir_native_emit_string_lit(code, dst, start, len, src, pinned) ctx }
    IrStringConcatI64(dst, left, right) -> { pipeline_ir_native_emit_string_concat(code, dst, left, right, fm, pinned) ctx }
    IrBinaryI64(dst, op, lhs, rhs) -> { pipeline_ir_native_emit_binary(code, dst, op, lhs, rhs, pinned) ctx }
    IrFloatBinaryI64(dst, prim, op, lhs, rhs) -> {
      let next_fp = pipeline_ir_native_emit_float_binary(code, dst, prim, op, lhs, rhs, pinned, pipeline_ir_native_emit_ctx_fp_env(ctx))
      pipeline_ir_native_emit_ctx_with_fp_env(ctx, next_fp)
    }
    IrUnaryI64(dst, op, value) -> { pipeline_ir_native_emit_unary(code, dst, op, value, pinned) ctx }
    IrSlotI64(slot) -> ctx
    IrLoadI64(dst, slot) -> {
      let f64_fd = pipeline_ir_native_f64_slot_home_lookup(pipeline_ir_native_emit_ctx_f64_facts(ctx), slot)
      if f64_fd >= 0 {
        let dst_fd = pipeline_ir_native_fp_resident_fd(pinned, dst)
        if dst_fd != 0 {
          -- FP-resident destination copies the slot register at load time;
          -- later stores to the slot cannot affect the copied value.
          bu32(code, encode_fmov_d_from_d(dst_fd, f64_fd))
          ctx
        } else {
          bu32(code, encode_fmov_x_from_d(17, f64_fd))
          pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17)
          pipeline_ir_native_emit_ctx_with_fp_env(ctx, pipeline_ir_native_fp_env_prepend(pipeline_ir_native_emit_ctx_fp_env(ctx), dst, PRIM_F64(), f64_fd))
        }
      } else {
        let rd = pipeline_ir_native_result_reg(dst, pinned)
        if rd != 17 and slot >= 8 and pipeline_ir_native_value_home_lookup(pinned, slot) == pipeline_ir_native_identity_home(slot) {
          pipeline_ir_native_ck_read(code, pinned, pipeline_ir_native_identity_home(slot), slot)
          emit_load_spill_offset(code, rd, (slot - 8) * 8)
          pipeline_ir_native_ck_def(code, pinned, rd, dst)
          ctx
        } else {
          let phys = pipeline_ir_native_load_reg(code, pinned, slot)
          pipeline_ir_native_store_reg_pinned(code, pinned, dst, phys)
          ctx
        }
      }
    }
    IrStoreI64(slot, value) -> {
      let f64_fd = pipeline_ir_native_f64_slot_home_lookup(pipeline_ir_native_emit_ctx_f64_facts(ctx), slot)
      if f64_fd >= 0 {
        pipeline_ir_native_emit_f64_to(code, f64_fd, pinned, pipeline_ir_native_emit_ctx_fp_env(ctx), value)
        -- The store rewrote the slot's d register: any env entry aliasing
        -- that register (a previous load of this slot) is now stale.
        pipeline_ir_native_emit_ctx_with_fp_env(ctx, pipeline_ir_native_fp_env_drop_fd(pipeline_ir_native_emit_ctx_fp_env(ctx), f64_fd))
      } else {
        let phys = pipeline_ir_native_load_reg(code, pinned, value)
        pipeline_ir_native_store_reg_pinned(code, pinned, slot, phys)
        ctx
      }
    }
    IrCallI64(dst, callee_hash, args) -> {
      pipeline_ir_abort_cleanup_emit_disarm_managed(code, pipeline_ir_value_list_get_or(args, 0, 0 - 1), callee_hash, fm, pinned)
      pipeline_ir_native_emit_call(code, dst, callee_hash, args, fm, pinned)
      pipeline_ir_native_record_indexed_call_elision(fm, callee_hash)
      ctx
    }
    IrCallResultLaneI64(dst, lane) -> {
      pipeline_ir_native_emit_call_result_lane(code, dst, lane, pinned)
      ctx
    }
    IrReturnLaneI64(lane, value) -> {
      pipeline_ir_native_emit_return_lane(code, lane, value, pinned)
      ctx
    }
    IrIndirectCallI64(dst, callee, args) -> {
      pipeline_ir_native_emit_indirect_call(code, dst, callee, args, pinned)
      ctx
    }
    IrGenericCallI64(dst, callee_hash, type_args, args) -> {
      pipeline_ir_native_emit_generic_call(code, dst, callee_hash, type_args, args, fm, pinned)
      ctx
    }
    IrVectorGetI64(dst, vec, index, fallback, check_mode) -> {
      pipeline_ir_native_emit_vector_get_i64(code, dst, vec, index, fallback, check_mode, fm, pinned, pipeline_ir_native_emit_ctx_vector_data_facts(ctx))
      ctx
    }
    IrVectorSetI64(dst, vec, index, value, check_mode) -> {
      pipeline_ir_native_emit_vector_set_i64(code, dst, vec, index, value, check_mode, fm, pinned, pipeline_ir_native_emit_ctx_vector_data_facts(ctx))
      ctx
    }
    IrMethodCallI64(dst, type_hash, method_hash, receiver, args) -> {
      pipeline_ir_native_emit_method_call(code, dst, type_hash, method_hash, receiver, args, fm, pinned)
      ctx
    }
    IrOwnedDropI64(value, type_hash) -> {
      pipeline_ir_abort_cleanup_emit_disarm_owned(code, value, type_hash, fm, pinned)
      pipeline_ir_native_emit_owned_drop(code, value, type_hash, fm, pinned)
      ctx
    }
    IrArrayStorageI64(dst, byte_size, align) -> {
      pipeline_ir_native_emit_array_storage(code, dst, byte_size, align, fm, pinned)
      ctx
    }
    IrArrayCopyI64(dst_data, src_data, byte_size, leaf_count, leaf_stride, leaf_kind) -> {
      pipeline_ir_native_emit_array_copy(code, dst_data, src_data, byte_size, leaf_count, leaf_stride, leaf_kind, fm, pinned)
      ctx
    }
    IrArrayDropI64(data, leaf_count, leaf_stride, leaf_kind) -> {
      pipeline_ir_abort_cleanup_emit_disarm_array(code, data, leaf_count, leaf_stride, leaf_kind, fm, pinned)
      pipeline_ir_native_emit_array_drop(code, data, leaf_count, leaf_stride, leaf_kind, fm, pinned)
      ctx
    }
    IrVariantInitI64(dst, tag_hash, args, field_mask) -> {
      pipeline_ir_native_emit_variant_init(code, dst, tag_hash, args, field_mask, fm, pinned)
      ctx
    }
    IrVariantTagI64(dst, value) -> {
      pipeline_ir_native_emit_variant_tag(code, dst, value, pinned)
      ctx
    }
    IrVariantPayloadI64(dst, value, index) -> {
      pipeline_ir_native_emit_variant_payload(code, dst, value, index, pinned)
      ctx
    }
    IrRecordInitI64(dst, type_hash, fields) -> {
      pipeline_ir_native_emit_record_init(code, dst, type_hash, fields, fm, pinned)
      ctx
    }
    IrRecordLayoutInitI64(dst, type_hash, data_size, align, fields) -> {
      pipeline_ir_native_emit_record_layout_init(code, dst, type_hash, data_size, align, fields, fm, pinned)
      ctx
    }
    IrRecordLayoutArrayLoadI64(dst_data, base, record_data_size, byte_offset, byte_size, leaf_count, leaf_stride, leaf_kind) -> {
      pipeline_ir_native_emit_record_layout_array_load(code, dst_data, base, record_data_size, byte_offset, byte_size, leaf_count, leaf_stride, leaf_kind, fm, pinned)
      ctx
    }
    IrRecordLayoutWordLoadI64(dst, base, record_data_size, field_hash, byte_offset) -> {
      pipeline_ir_native_emit_record_layout_word_load(code, dst, base, record_data_size, byte_offset, fm, pinned)
      ctx
    }
    IrFieldLoadI64(dst, base, field_hash, field_index) -> {
      pipeline_ir_native_emit_field_load(code, dst, base, field_index, pinned)
      ctx
    }
    IrResumeI64(dst, value) -> {
      let phys = pipeline_ir_native_load_reg(code, pinned, value)
      pipeline_ir_native_store_reg_pinned(code, pinned, dst, phys)
      ctx
    }
    IrTryI64(dst, value, effect_key) -> {
      pipeline_ir_native_emit_try(code, dst, value, effect_key, fm, pinned)
      ctx
    }
    IrOptChainI64(dst, base, field_hash, field_index, effect_key) -> {
      pipeline_ir_native_emit_opt_chain(code, dst, base, field_index, effect_key, fm, pinned)
      ctx
    }
    IrClosureI64(dst, f, captures, eff) -> {
      pipeline_ir_native_emit_closure(code, dst, f, captures, ir_lambda_semantic_facts_evidence(eff), fm, ctx)
      ctx
    }
    IrFunctionRefI64(dst, callee_hash) -> {
      pipeline_ir_native_emit_function_ref(code, dst, callee_hash, fm, pinned)
      ctx
    }
    IrGenericFunctionRefI64(dst, callee_hash, type_args) -> {
      pipeline_ir_native_emit_function_ref(code, dst, pipeline_ir_function_ref_target_hash(callee_hash, type_args), fm, pinned)
      ctx
    }
    IrAddressOfSlotI64(dst, slot) -> {
      pipeline_ir_native_emit_address_of_slot(code, dst, slot, fm, pinned)
      ctx
    }
    IrPtrLoadI64(dst, ptr) -> {
      pipeline_ir_native_emit_ptr_load(code, dst, ptr, fm, pinned)
      ctx
    }
    IrPtrStoreI64(dst, ptr, value) -> {
      pipeline_ir_native_emit_ptr_store(code, dst, ptr, value, fm, pinned)
      ctx
    }
    IrLoweringFailureI64(reason) -> {
      -- Reason 12 is the match exhaustiveness trap: a deliberate, normally
      -- dead runtime guard, not a typed-lowering failure. Only genuine
      -- lowering-failure stubs count against the trap gate metric.
      if reason == 12 { 0 } else { fmap_inc_typed_lowering_failure_count(fm) }
      bu32(code, encode_brk(20 + reason))
      ctx
    }
    IrBindI64(ns, nl, value, ty) -> {
      PipelineNativeEmitCtx(scope_push_typed(scope, ns, nl, pipeline_ir_native_value_home_lookup(pinned, value), ty), handlers, pinned, pipeline_ir_native_emit_ctx_f64_facts(ctx), fns, pipeline_ir_native_emit_ctx_fp_env(ctx), pipeline_ir_native_emit_ctx_vector_data_facts(ctx), pipeline_ir_native_emit_ctx_adr_patches(ctx))
    }
    IrHandleI64(dst, handle_src, effect_hash, clauses, nclauses, abort_block) -> {
      let next_handlers = pipeline_ir_native_emit_handle(code, handle_src, fm, effect_hash, clauses, nclauses, abort_block, ctx)
      PipelineNativeEmitCtx(scope, next_handlers, pinned, pipeline_ir_native_emit_ctx_f64_facts(ctx), fns, pipeline_ir_native_fp_env_empty(), pipeline_ir_native_emit_ctx_vector_data_facts(ctx), pipeline_ir_native_emit_ctx_adr_patches(ctx))
    }
    IrDeferredHandleI64(dst, handle_src, body, clauses, nclauses, effect_hash, scratch_base) -> {
      pipeline_ir_native_emit_deferred_handle(code, dst, handle_src, body, clauses, nclauses, effect_hash, scratch_base, fm, ctx)
      ctx
    }
    IrHandlerPopI64(frame) -> PipelineNativeEmitCtx(scope, pipeline_ir_native_pop_one(code, pinned, handlers), pinned, pipeline_ir_native_emit_ctx_f64_facts(ctx), fns, pipeline_ir_native_fp_env_empty(), pipeline_ir_native_emit_ctx_vector_data_facts(ctx), pipeline_ir_native_emit_ctx_adr_patches(ctx))
    IrAbortLandingI64(dst) -> {
      pipeline_ir_native_store_reg_pinned(code, pinned, dst, 0)
      ctx
    }
    IrHandlerDirectI64(dst, effect_hash, op_hash, handler_depth, clause_index, args) -> {
      pipeline_ir_native_emit_direct(code, dst, handler_depth, clause_index, args, handlers, fm, pinned)
      ctx
    }
    IrPerformI64(dst, effect_hash, op_hash, args) -> {
      pipeline_ir_native_emit_perform(code, dst, effect_hash, op_hash, args, fm, pinned)
      ctx
    }
  }
}

fn pipeline_ir_native_emit_inst_list(insts: IrInstList, code: i64, src: i64, fm: i64, ctx: PipelineNativeEmitCtx) -> PipelineNativeEmitCtx {
  match insts {
    IrInstNil -> ctx
    IrInstCons(inst, rest) -> {
      let emitted_ctx = pipeline_ir_native_emit_inst(inst, code, src, fm, ctx)
      let next_ctx = if pipeline_ir_native_inst_preserves_fp_env(inst) == 1 { emitted_ctx } else { pipeline_ir_native_emit_ctx_clear_fp(emitted_ctx) }
      pipeline_ir_native_emit_inst_list(rest, code, src, fm, next_ctx)
    }
  }
}

fn pipeline_ir_native_inst_preserves_fp_env(inst: IrInst) -> i64 {
  match inst {
    IrCallI64(dst, callee_hash, args) -> 0
    IrIndirectCallI64(dst, callee, args) -> 0
    IrGenericCallI64(dst, callee_hash, type_args, args) -> 0
    IrMethodCallI64(dst, type_hash, method_hash, receiver, args) -> 0
    IrOwnedDropI64(value, type_hash) -> 0
    IrArrayCopyI64(dst_data, src_data, byte_size, leaf_count, leaf_stride, leaf_kind) -> 0
    IrRecordLayoutArrayLoadI64(dst_data, base, record_data_size, byte_offset, byte_size, leaf_count, leaf_stride, leaf_kind) -> 0
    IrArrayDropI64(data, leaf_count, leaf_stride, leaf_kind) -> 0
    IrStringConcatI64(dst, left, right) -> 0
    IrPerformI64(dst, effect_hash, op_hash, args) -> 0
    IrHandlerDirectI64(dst, effect_hash, op_hash, handler_depth, clause_index, args) -> 0
    IrHandleI64(dst, handle_src, body, clauses, nclauses, captures) -> 0
    IrDeferredHandleI64(dst, handle_src, body_expr, clauses, nclauses, captures, scratch_base) -> 0
    IrHandlerPopI64(frame) -> 0
    IrClosureI64(dst, f, captures, eff) -> 0
    IrTryI64(dst, value, effect_key) -> 0
    -- Variant/record construction emits a BL to rc_default_alloc
    -- (2q slice 2): the cached FP env does not survive the call.
    IrVariantInitI64(dst, tag_hash, args, field_mask) -> 0
    IrRecordInitI64(dst, type_hash, fields) -> 0
    IrRecordLayoutInitI64(dst, type_hash, data_size, align, fields) -> 0
    _ -> 1
  }
}

fn pipeline_ir_native_direct_branch_cmp_info_inst(inst: IrInst, cond: i64) -> i64 {
  match inst {
    IrBinaryI64(dst, op, lhs, rhs) -> {
      let op_tag = ir_binary_op_tag(op)
      if dst == cond and cg_direct_branch_false_cond_for_op(op_tag) >= 0 {
        node_new(0, cond, op_tag, lhs, rhs)
      } else {
        0
      }
    }
    _ -> 0
  }
}

fn pipeline_ir_native_direct_branch_cmp_info_last(insts: IrInstList, cond: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      match rest {
        IrInstNil -> pipeline_ir_native_direct_branch_cmp_info_inst(inst, cond)
        _ -> pipeline_ir_native_direct_branch_cmp_info_last(rest, cond)
      }
    }
  }
}

fn pipeline_ir_native_direct_branch_cmp_info_for_term(insts: IrInstList, term: IrTerminator) -> i64 {
  match term {
    IrTermBranch(cond, then_block, else_block) -> pipeline_ir_native_direct_branch_cmp_info_last(insts, cond)
    _ -> 0
  }
}

fn pipeline_ir_native_emit_inst_list_for_term(insts: IrInstList, code: i64, src: i64, fm: i64, ctx: PipelineNativeEmitCtx, branch_cmp_info: i64) -> PipelineNativeEmitCtx {
  match insts {
    IrInstNil -> ctx
    IrInstCons(inst, rest) -> {
      -- Residency audit: one start-offset entry per instruction, in the
      -- same order the resident scan numbers them (a fused branch cmp still
      -- gets its entry — its window is simply empty).
      let audit_offsets = fmap_audit_offsets(fm)
      if audit_offsets != 0 { nlist_add(audit_offsets, buf_len(code)) 0 } else { 0 }
      match rest {
        IrInstNil -> {
          if branch_cmp_info != 0 {
            ctx
          } else {
            pipeline_ir_native_emit_inst(inst, code, src, fm, ctx)
          }
        }
        _ -> {
          let emitted_ctx = pipeline_ir_native_emit_inst(inst, code, src, fm, ctx)
          let next_ctx = if pipeline_ir_native_inst_preserves_fp_env(inst) == 1 { emitted_ctx } else { pipeline_ir_native_emit_ctx_clear_fp(emitted_ctx) }
          pipeline_ir_native_emit_inst_list_for_term(rest, code, src, fm, next_ctx, branch_cmp_info)
        }
      }
    }
  }
}

fn pipeline_ir_native_epilogue_label() -> i64 { 0 - 1 }

fn pipeline_ir_native_label_map_empty() -> i64 { 0 }

fn pipeline_ir_native_label_map_add(labels: i64, block_id: i64, offset: i64) -> i64 {
  node_new(0, block_id, offset, labels, 0)
}

fn pipeline_ir_native_label_map_lookup(labels: i64, block_id: i64) -> i64 {
  let mut cur = labels
  let mut result = 0 - 1
  while cur != 0 and result < 0 {
    if node_f1(cur) == block_id {
      result = node_f2(cur)
    } else {
      cur = node_f3(cur)
    }
  }
  result
}

fn pipeline_ir_native_patch_uncond() -> i64 { 0 - 1 }

fn pipeline_ir_native_patch_prepend(pos: i64, cond: i64, target_block: i64, rest: i64) -> i64 {
  node_new(0, pos, cond, target_block, rest)
}

fn pipeline_ir_native_patch_branch(code: i64, pos: i64, cond: i64, target: i64) -> i64 {
  if cond < 0 {
    cg_patch_b(code, pos, target)
  } else {
    cg_patch_b_cond(code, pos, cond, target)
  }
}

fn pipeline_ir_native_emit_branch_or_patch(code: i64, labels: i64, patches: i64, target_block: i64, cond: i64) -> i64 {
  let pos = buf_len(code)
  bu32(code, 0)
  let target = pipeline_ir_native_label_map_lookup(labels, target_block)
  if target >= 0 {
    pipeline_ir_native_patch_branch(code, pos, cond, target)
    patches
  } else {
    pipeline_ir_native_patch_prepend(pos, cond, target_block, patches)
  }
}

fn pipeline_ir_native_patch_all(code: i64, labels: i64, patches: i64) -> i64 {
  let mut cur = patches
  while cur != 0 {
    let target = pipeline_ir_native_label_map_lookup(labels, node_f3(cur))
    if target >= 0 {
      pipeline_ir_native_patch_branch(code, node_f1(cur), node_f2(cur), target)
    } else {
      0
    }
    cur = node_f4(cur)
  }
  0
}

-- 4j handle-abort continuations are forward ADRs materialised while an
-- IrHandle instruction is emitted. Instruction emission does not own the CFG
-- label map, so it records (position, target block) pairs in the current
-- emission context and this pass resolves them once every block has a label.
fn pipeline_ir_native_patch_abort_adrs(code: i64, labels: i64, patches: i64) -> i64 {
  let n = if patches == 0 { 0 } else { nlist_len(patches) }
  for i in 0..n {
    let patch = nlist_get(patches, i)
    let pos = node_f1(patch)
    let target = pipeline_ir_native_label_map_lookup(labels, node_f2(patch))
    if target >= 0 {
      bytes_set_u32(code, pos, encode_adr(17, target - pos))
    } else {
      -- Missing landing labels must fail loudly if malformed IR escapes.
      bytes_set_u32(code, pos, encode_brk(24))
    }
  }
  0
}

fn pipeline_ir_native_emit_jump_arg_saves(args: IrValueList, params: IrValueList, code: i64, pinned: PipelineIrNativeValueHomeFacts, temp_base: i64, index: i64) -> i64 {
  match args {
    IrValueNil -> 0
    IrValueCons(arg, rest_args) -> {
      match params {
        IrValueNil -> 0
        IrValueCons(param, rest_params) -> {
          -- Identity pairs move nothing: no temp needed, no restore.
          if arg == param { 0 } else {
            let phys = pipeline_ir_native_load_reg(code, pinned, arg)
            pipeline_ir_native_store_reg_pinned(code, pinned, temp_base + index, phys)
            0
          }
          pipeline_ir_native_emit_jump_arg_saves(rest_args, rest_params, code, pinned, temp_base, index + 1)
        }
      }
    }
  }
}

fn pipeline_ir_native_emit_jump_arg_restores(params: IrValueList, args: IrValueList, code: i64, pinned: PipelineIrNativeValueHomeFacts, temp_base: i64, index: i64) -> i64 {
  match params {
    IrValueNil -> 0
    IrValueCons(param, rest_params) -> {
      match args {
        IrValueNil -> 0
        IrValueCons(arg, rest_args) -> {
          if arg == param { 0 } else {
            let phys = pipeline_ir_native_load_reg(code, pinned, temp_base + index)
            pipeline_ir_native_store_reg_pinned(code, pinned, param, phys)
            0
          }
          pipeline_ir_native_emit_jump_arg_restores(rest_params, rest_args, code, pinned, temp_base, index + 1)
        }
      }
    }
  }
}

fn pipeline_ir_native_jump_value_list_contains(values: IrValueList, target: i64) -> i64 {
  match values {
    IrValueNil -> 0
    IrValueCons(value, rest) -> if value == target { 1 } else { pipeline_ir_native_jump_value_list_contains(rest, target) }
  }
}

fn pipeline_ir_native_jump_args_disjoint(args: IrValueList, params: IrValueList) -> i64 {
  match args {
    IrValueNil -> 1
    IrValueCons(arg, rest) -> {
      if pipeline_ir_native_jump_value_list_contains(params, arg) == 1 { 0 }
      else { pipeline_ir_native_jump_args_disjoint(rest, params) }
    }
  }
}

-- A param is written on this edge only when its arg differs (identity
-- pairs move nothing). True when `target` is among the written params.
fn pipeline_ir_native_jump_written_params_contain(args: IrValueList, params: IrValueList, target: i64) -> i64 {
  match args {
    IrValueNil -> 0
    IrValueCons(arg, rest_args) -> {
      match params {
        IrValueNil -> 0
        IrValueCons(param, rest_params) -> {
          if param == target and arg != param { 1 }
          else { pipeline_ir_native_jump_written_params_contain(rest_args, rest_params, target) }
        }
      }
    }
  }
}

-- Parallel-move hazard with identity pairs excluded: only a non-identity
-- arg that reads a param some other non-identity pair writes forces the
-- shuffle. A loop edge that changes one variable and passes the rest
-- through untouched is hazard-free even though its args mention params.
fn pipeline_ir_native_jump_args_hazard(args: IrValueList, params: IrValueList, all_args: IrValueList, all_params: IrValueList) -> i64 {
  match args {
    IrValueNil -> 0
    IrValueCons(arg, rest_args) -> {
      match params {
        IrValueNil -> 0
        IrValueCons(param, rest_params) -> {
          if arg != param and pipeline_ir_native_jump_written_params_contain(all_args, all_params, arg) == 1 { 1 }
          else { pipeline_ir_native_jump_args_hazard(rest_args, rest_params, all_args, all_params) }
        }
      }
    }
  }
}

fn pipeline_ir_native_emit_jump_arg_direct(args: IrValueList, params: IrValueList, code: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  match args {
    IrValueNil -> 0
    IrValueCons(arg, rest_args) -> {
      match params {
        IrValueNil -> 0
        IrValueCons(param, rest_params) -> {
          -- An identity edge (arg is the param itself: the variable was
          -- not changed on this path) moves nothing.
          if arg == param { 0 } else {
            let phys = pipeline_ir_native_load_reg(code, pinned, arg)
            pipeline_ir_native_store_reg_pinned(code, pinned, param, phys)
            0
          }
          pipeline_ir_native_emit_jump_arg_direct(rest_args, rest_params, code, pinned)
        }
      }
    }
  }
}

fn pipeline_ir_native_emit_jump_arg_moves(args: IrValueList, params: IrValueList, code: i64, pinned: PipelineIrNativeValueHomeFacts, temp_base: i64) -> i64 {
  -- The shuffle temps exist for parallel-move hazards: only a
  -- non-identity arg that reads a param another non-identity pair
  -- writes needs them. Identity pairs (loop variables passed through
  -- unchanged) move nothing and are excluded from the hazard analysis,
  -- so mutating one variable of several on a backedge stays on the
  -- direct path.
  if pipeline_ir_native_jump_args_hazard(args, params, args, params) == 0 {
    pipeline_ir_native_emit_jump_arg_direct(args, params, code, pinned)
  } else {
    pipeline_ir_native_emit_jump_arg_saves(args, params, code, pinned, temp_base, 0)
    pipeline_ir_native_emit_jump_arg_restores(params, args, code, pinned, temp_base, 0)
  }
}

fn pipeline_ir_native_term_emit_info(branch_return: i64, branch_cmp_info: i64, pinned: PipelineIrNativeValueHomeFacts, temp_base: i64) -> PipelineIrNativeTermEmitInfo {
  PipelineIrNativeTermEmitInfo(branch_return, branch_cmp_info, pinned, temp_base)
}

fn pipeline_ir_native_term_emit_info_branch_return(info: PipelineIrNativeTermEmitInfo) -> i64 {
  match info {
    PipelineIrNativeTermEmitInfo(branch_return, branch_cmp_info, pinned, temp_base) -> branch_return
  }
}

fn pipeline_ir_native_term_emit_info_branch_cmp(info: PipelineIrNativeTermEmitInfo) -> i64 {
  match info {
    PipelineIrNativeTermEmitInfo(branch_return, branch_cmp_info, pinned, temp_base) -> branch_cmp_info
  }
}

fn pipeline_ir_native_term_emit_info_pinned(info: PipelineIrNativeTermEmitInfo) -> PipelineIrNativeValueHomeFacts {
  match info {
    PipelineIrNativeTermEmitInfo(branch_return, branch_cmp_info, pinned, temp_base) -> pinned
  }
}

fn pipeline_ir_native_term_emit_info_temp_base(info: PipelineIrNativeTermEmitInfo) -> i64 {
  match info {
    PipelineIrNativeTermEmitInfo(branch_return, branch_cmp_info, pinned, temp_base) -> temp_base
  }
}

fn pipeline_ir_native_emit_term_cfg(term: IrTerminator, all_blocks: IrBlockList, code: i64, labels: i64, patches: i64, fm: i64, info: PipelineIrNativeTermEmitInfo) -> i64 {
  let branch_return = pipeline_ir_native_term_emit_info_branch_return(info)
  let branch_cmp_info = pipeline_ir_native_term_emit_info_branch_cmp(info)
  let pinned = pipeline_ir_native_term_emit_info_pinned(info)
  let temp_base = pipeline_ir_native_term_emit_info_temp_base(info)
  match term {
    IrTermReturn(value) -> {
      let result_phys = pipeline_ir_native_load_reg(code, pinned, value)
      bu32(code, encode_add_imm(0, result_phys, 0))
      if branch_return == 1 {
        pipeline_ir_native_emit_branch_or_patch(code, labels, patches, pipeline_ir_native_epilogue_label(), pipeline_ir_native_patch_uncond())
      } else {
        patches
      }
    }
    IrTermJump(target, args) -> {
      let params = pipeline_ir_native_block_params_or(all_blocks, target, ir_value_list_empty())
      pipeline_ir_native_emit_jump_arg_moves(args, params, code, pinned, temp_base)
      pipeline_ir_native_emit_branch_or_patch(code, labels, patches, target, pipeline_ir_native_patch_uncond())
    }
    IrTermBranch(cond, then_block, else_block) -> {
      if branch_cmp_info != 0 {
        let lhs_phys = pipeline_ir_native_load_reg(code, pinned, node_f3(branch_cmp_info))
        let rhs_phys = pipeline_ir_native_load_rhs(code, pinned, node_f4(branch_cmp_info))
        bu32(code, encode_cmp(lhs_phys, rhs_phys))
        fmap_inc_direct_branch_lowering_count(fm)
        let with_else = pipeline_ir_native_emit_branch_or_patch(code, labels, patches, else_block, cg_direct_branch_false_cond_for_op(node_f2(branch_cmp_info)))
        pipeline_ir_native_emit_branch_or_patch(code, labels, with_else, then_block, pipeline_ir_native_patch_uncond())
      } else {
        let cond_phys = pipeline_ir_native_load_reg(code, pinned, cond)
        bu32(code, encode_cmp(cond_phys, 31))
        let with_else = pipeline_ir_native_emit_branch_or_patch(code, labels, patches, else_block, 0)
        pipeline_ir_native_emit_branch_or_patch(code, labels, with_else, then_block, pipeline_ir_native_patch_uncond())
      }
    }
    IrTermNone -> {
      bu32(code, encode_brk(2))
      patches
    }
  }
}

fn pipeline_ir_native_cfg_state(labels: i64, patches: i64, pinned: PipelineIrNativeValueHomeFacts, temp_base: i64) -> PipelineIrNativeCfgState {
  PipelineIrNativeCfgState(labels, patches, pinned, temp_base)
}

fn pipeline_ir_native_cfg_state_labels(state: PipelineIrNativeCfgState) -> i64 {
  match state {
    PipelineIrNativeCfgState(labels, patches, pinned, temp_base) -> labels
  }
}

fn pipeline_ir_native_cfg_state_patches(state: PipelineIrNativeCfgState) -> i64 {
  match state {
    PipelineIrNativeCfgState(labels, patches, pinned, temp_base) -> patches
  }
}

fn pipeline_ir_native_cfg_state_pinned(state: PipelineIrNativeCfgState) -> PipelineIrNativeValueHomeFacts {
  match state {
    PipelineIrNativeCfgState(labels, patches, pinned, temp_base) -> pinned
  }
}

fn pipeline_ir_native_cfg_state_temp_base(state: PipelineIrNativeCfgState) -> i64 {
  match state {
    PipelineIrNativeCfgState(labels, patches, pinned, temp_base) -> temp_base
  }
}

fn pipeline_ir_native_emit_blocks(blocks: IrBlockList, all_blocks: IrBlockList, code: i64, scope: i64, src: i64, fm: i64, handlers: PipelineNativeHandlerCtx, fns: i64, f64_facts: PipelineIrNativeF64Facts, vector_data_facts: PipelineIrNativeVectorDataFacts, adr_patches: i64, state: PipelineIrNativeCfgState) -> PipelineIrNativeCfgState {
  let labels = pipeline_ir_native_cfg_state_labels(state)
  let patches = pipeline_ir_native_cfg_state_patches(state)
  let pinned = pipeline_ir_native_cfg_state_pinned(state)
  let temp_base = pipeline_ir_native_cfg_state_temp_base(state)
  match blocks {
    IrBlockListNil -> state
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          fmap_set_current_abort_cleanup_block(fm, id)
          let next_labels = pipeline_ir_native_label_map_add(labels, id, buf_len(code))
          -- A split segment never survives its block: any active from
          -- the previous block flips home before this block's reads.
          pipeline_ir_native_split_flip_actives(fm, pinned)
          let branch_cmp_info = pipeline_ir_native_direct_branch_cmp_info_for_term(insts, term)
          let ctx = pipeline_ir_native_emit_inst_list_for_term(insts, code, src, fm, PipelineNativeEmitCtx(scope, handlers, pinned, f64_facts, fns, pipeline_ir_native_fp_env_empty(), vector_data_facts, adr_patches), branch_cmp_info)
          let next_handlers_ctx = pipeline_ir_native_emit_ctx_handlers(ctx)
          let branch_return = match rest {
            IrBlockListNil -> 0
            _ -> 1
          }
          let info = pipeline_ir_native_term_emit_info(branch_return, branch_cmp_info, pinned, temp_base)
          -- Residency audit: the terminator gets one offset entry, matching
          -- the resident scan's per-block trailing gpos increment.
          let audit_offsets = fmap_audit_offsets(fm)
          if audit_offsets != 0 { nlist_add(audit_offsets, buf_len(code)) 0 } else { 0 }
          let next_patches = pipeline_ir_native_emit_term_cfg(term, all_blocks, code, next_labels, patches, fm, info)
          pipeline_ir_native_emit_blocks(rest, all_blocks, code, scope, src, fm, next_handlers_ctx, fns, f64_facts, vector_data_facts, adr_patches, pipeline_ir_native_cfg_state(next_labels, next_patches, pinned, temp_base))
        }
      }
    }
  }
}

fn pipeline_ir_native_emit_block(block: IrBlock, code: i64, scope: i64, src: i64, fm: i64) -> i64 {
  match block {
    IrBlock(id, params, insts, term) -> {
      fmap_set_current_abort_cleanup_block(fm, id)
      let branch_cmp_info = pipeline_ir_native_direct_branch_cmp_info_for_term(insts, term)
      let single = ir_block_list_prepend(block, ir_block_list_empty())
      let home_count = pipeline_ir_native_value_home_count_include_evidence(pipeline_ir_native_value_home_count_for_blocks(0, single), fm)
      let pinned = pipeline_ir_native_identity_home_facts(pipeline_ir_native_value_home_count_include_handler_scratch(home_count, single, 0))
      let f64_facts = pipeline_ir_native_f64_facts_assign_slot_homes(single, pipeline_ir_native_f64_facts_for_blocks(single))
      let vector_data_facts = pipeline_ir_native_vector_data_facts_assign_home(pipeline_ir_native_vector_data_facts_for_blocks(single))
      let adr_patches = nlist_new()
      let ctx = pipeline_ir_native_emit_inst_list_for_term(insts, code, src, fm, PipelineNativeEmitCtx(scope, PipelineNativeHandlerCtxNil, pinned, f64_facts, 0, pipeline_ir_native_fp_env_empty(), vector_data_facts, adr_patches), branch_cmp_info)
      pipeline_ir_native_emit_term_cfg(
        term,
        single,
        code,
        pipeline_ir_native_label_map_add(pipeline_ir_native_label_map_empty(), id, 0),
        0,
        fm,
        pipeline_ir_native_term_emit_info(0, branch_cmp_info, pinned, 240)
      )
      pipeline_ir_native_patch_abort_adrs(code, pipeline_ir_native_label_map_add(pipeline_ir_native_label_map_empty(), id, 0), adr_patches)
      0
    }
  }
}

fn pipeline_ir_native_inst_list_loads_slot(insts: IrInstList, slot: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      match inst {
        IrLoadI64(dst, load_slot) -> if load_slot == slot { 1 } else { pipeline_ir_native_inst_list_loads_slot(rest, slot) }
        _ -> pipeline_ir_native_inst_list_loads_slot(rest, slot)
      }
    }
  }
}

fn pipeline_ir_native_inst_list_stores_slot(insts: IrInstList, slot: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      match inst {
        IrStoreI64(store_slot, value) -> if store_slot == slot { 1 } else { pipeline_ir_native_inst_list_stores_slot(rest, slot) }
        _ -> pipeline_ir_native_inst_list_stores_slot(rest, slot)
      }
    }
  }
}

fn pipeline_ir_native_inst_list_takes_slot_address(insts: IrInstList, slot: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      match inst {
        IrAddressOfSlotI64(dst, addr_slot) -> if addr_slot == slot { 1 } else { pipeline_ir_native_inst_list_takes_slot_address(rest, slot) }
        _ -> pipeline_ir_native_inst_list_takes_slot_address(rest, slot)
      }
    }
  }
}

fn pipeline_ir_native_blocks_load_slot(blocks: IrBlockList, slot: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          if pipeline_ir_native_inst_list_loads_slot(insts, slot) == 1 { 1 } else { pipeline_ir_native_blocks_load_slot(rest, slot) }
        }
      }
    }
  }
}

fn pipeline_ir_native_blocks_store_slot(blocks: IrBlockList, slot: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          if pipeline_ir_native_inst_list_stores_slot(insts, slot) == 1 { 1 } else { pipeline_ir_native_blocks_store_slot(rest, slot) }
        }
      }
    }
  }
}

fn pipeline_ir_native_blocks_take_slot_address(blocks: IrBlockList, slot: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          if pipeline_ir_native_inst_list_takes_slot_address(insts, slot) == 1 { 1 } else { pipeline_ir_native_blocks_take_slot_address(rest, slot) }
        }
      }
    }
  }
}

fn pipeline_ir_native_block_in_region(id: i64, first_block: i64, last_block: i64) -> i64 {
  if id >= first_block and id <= last_block { 1 } else { 0 }
}

fn pipeline_ir_native_blocks_store_slot_in_region(blocks: IrBlockList, slot: i64, first_block: i64, last_block: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          if pipeline_ir_native_block_in_region(id, first_block, last_block) == 1 and pipeline_ir_native_inst_list_stores_slot(insts, slot) == 1 {
            1
          } else {
            pipeline_ir_native_blocks_store_slot_in_region(rest, slot, first_block, last_block)
          }
        }
      }
    }
  }
}

fn pipeline_ir_native_inst_list_defines_value(insts: IrInstList, value: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let dst = pipeline_ir_inst_def_or(inst, 0 - 1)
      if dst == value { 1 } else { pipeline_ir_native_inst_list_defines_value(rest, value) }
    }
  }
}

fn pipeline_ir_native_blocks_define_value_in_region(blocks: IrBlockList, value: i64, first_block: i64, last_block: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          if pipeline_ir_native_block_in_region(id, first_block, last_block) == 1 and pipeline_ir_native_inst_list_defines_value(insts, value) == 1 {
            1
          } else {
            pipeline_ir_native_blocks_define_value_in_region(rest, value, first_block, last_block)
          }
        }
      }
    }
  }
}

fn pipeline_ir_native_blocks_load_slot_lookup_in_region(blocks: IrBlockList, value: i64, first_block: i64, last_block: i64) -> PipelineIrConstLookup {
  match blocks {
    IrBlockListNil -> pipeline_ir_const_lookup(0, 0)
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          if pipeline_ir_native_block_in_region(id, first_block, last_block) == 1 {
            let found = pipeline_ir_inst_list_load_slot_lookup(insts, value)
            if pipeline_ir_const_lookup_valid(found) == 1 {
              found
            } else {
              pipeline_ir_native_blocks_load_slot_lookup_in_region(rest, value, first_block, last_block)
            }
          } else {
            pipeline_ir_native_blocks_load_slot_lookup_in_region(rest, value, first_block, last_block)
          }
        }
      }
    }
  }
}

fn pipeline_ir_native_loop_slot_key(slot: i64) -> i64 {
  0 - 1000000000 - slot
}

fn pipeline_ir_native_loop_canonical_base(blocks: IrBlockList, first_block: i64, last_block: i64, value: i64) -> PipelineIrConstLookup {
  let slot = pipeline_ir_native_blocks_load_slot_lookup_in_region(blocks, value, first_block, last_block)
  if pipeline_ir_const_lookup_valid(slot) == 1 {
    let slot_id = pipeline_ir_const_lookup_value(slot)
    if pipeline_ir_native_blocks_store_slot_in_region(blocks, slot_id, first_block, last_block) == 1 {
      pipeline_ir_const_lookup(0, 0)
    } else {
      pipeline_ir_const_lookup(1, pipeline_ir_native_loop_slot_key(slot_id))
    }
  } else {
    if pipeline_ir_native_blocks_define_value_in_region(blocks, value, first_block, last_block) == 1 {
      pipeline_ir_const_lookup(0, 0)
    } else {
      pipeline_ir_const_lookup(1, value)
    }
  }
}

fn pipeline_ir_native_loop_canonical_index(blocks: IrBlockList, first_block: i64, last_block: i64, value: i64) -> PipelineIrConstLookup {
  let slot = pipeline_ir_native_blocks_load_slot_lookup_in_region(blocks, value, first_block, last_block)
  if pipeline_ir_const_lookup_valid(slot) == 1 {
    pipeline_ir_const_lookup(1, pipeline_ir_native_loop_slot_key(pipeline_ir_const_lookup_value(slot)))
  } else {
    pipeline_ir_const_lookup(1, value)
  }
}

fn pipeline_ir_native_scaled_recur_key_for_inst(inst: IrInst, blocks: IrBlockList, first_block: i64, last_block: i64) -> i64 {
  match inst {
    IrCallI64(dst, callee_hash, args) -> {
      let kind = pipeline_ir_native_intrinsic_kind(callee_hash)
      if (kind == 35 or kind == 36 or kind == 37) and ir_value_list_len(args) >= 2 {
        let base_value = pipeline_ir_value_list_get_or(args, 0, 0 - 1)
        let index_value = pipeline_ir_value_list_get_or(args, 1, 0 - 1)
        let base = pipeline_ir_native_loop_canonical_base(blocks, first_block, last_block, base_value)
        if pipeline_ir_const_lookup_valid(base) == 1 {
          let index = pipeline_ir_native_loop_canonical_index(blocks, first_block, last_block, index_value)
          if pipeline_ir_const_lookup_valid(index) == 1 {
            node_new(0, pipeline_ir_const_lookup_value(base), pipeline_ir_const_lookup_value(index), 0, 0)
          } else {
            0
          }
        } else {
          0
        }
      } else {
        0
      }
    }
    _ -> 0
  }
}

fn pipeline_ir_native_scaled_recur_key_equal(left: i64, right: i64) -> i64 {
  if left != 0 and right != 0 and node_f1(left) == node_f1(right) and node_f2(left) == node_f2(right) { 1 } else { 0 }
}

fn pipeline_ir_native_scaled_recur_key_seen(seen: i64, key: i64) -> i64 {
  let n = nlist_len(seen)
  let mut found = 0
  for i in 0..n {
    if pipeline_ir_native_scaled_recur_key_equal(nlist_get(seen, i), key) == 1 {
      found = 1
    } else { 0 }
  }
  found
}

fn pipeline_ir_native_scaled_recur_inst_count_for_key(insts: IrInstList, blocks: IrBlockList, first_block: i64, last_block: i64, key: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let local_key = pipeline_ir_native_scaled_recur_key_for_inst(inst, blocks, first_block, last_block)
      let add = if pipeline_ir_native_scaled_recur_key_equal(local_key, key) == 1 { 1 } else { 0 }
      add + pipeline_ir_native_scaled_recur_inst_count_for_key(rest, blocks, first_block, last_block, key)
    }
  }
}

fn pipeline_ir_native_scaled_recur_block_count_for_key(block: IrBlock, blocks: IrBlockList, first_block: i64, last_block: i64, key: i64) -> i64 {
  match block {
    IrBlock(id, params, insts, term) -> {
      if pipeline_ir_native_block_in_region(id, first_block, last_block) == 1 {
        pipeline_ir_native_scaled_recur_inst_count_for_key(insts, blocks, first_block, last_block, key)
      } else {
        0
      }
    }
  }
}

fn pipeline_ir_native_scaled_recur_blocks_count_for_key(search_blocks: IrBlockList, all_blocks: IrBlockList, first_block: i64, last_block: i64, key: i64) -> i64 {
  match search_blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      pipeline_ir_native_scaled_recur_block_count_for_key(block, all_blocks, first_block, last_block, key) +
      pipeline_ir_native_scaled_recur_blocks_count_for_key(rest, all_blocks, first_block, last_block, key)
    }
  }
}

fn pipeline_ir_native_scaled_recur_inst_sites(insts: IrInstList, all_blocks: IrBlockList, first_block: i64, last_block: i64, seen: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let key = pipeline_ir_native_scaled_recur_key_for_inst(inst, all_blocks, first_block, last_block)
      let add = if key != 0 and pipeline_ir_native_scaled_recur_key_seen(seen, key) == 0 {
        nlist_add(seen, key)
        let count = pipeline_ir_native_scaled_recur_blocks_count_for_key(all_blocks, all_blocks, first_block, last_block, key)
        if count >= 2 { count } else { 0 }
      } else {
        0
      }
      add + pipeline_ir_native_scaled_recur_inst_sites(rest, all_blocks, first_block, last_block, seen)
    }
  }
}

fn pipeline_ir_native_scaled_recur_block_sites(block: IrBlock, all_blocks: IrBlockList, first_block: i64, last_block: i64, seen: i64) -> i64 {
  match block {
    IrBlock(id, params, insts, term) -> {
      if pipeline_ir_native_block_in_region(id, first_block, last_block) == 1 {
        pipeline_ir_native_scaled_recur_inst_sites(insts, all_blocks, first_block, last_block, seen)
      } else {
        0
      }
    }
  }
}

fn pipeline_ir_native_scaled_recur_blocks_sites(search_blocks: IrBlockList, all_blocks: IrBlockList, first_block: i64, last_block: i64, seen: i64) -> i64 {
  match search_blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      pipeline_ir_native_scaled_recur_block_sites(block, all_blocks, first_block, last_block, seen) +
      pipeline_ir_native_scaled_recur_blocks_sites(rest, all_blocks, first_block, last_block, seen)
    }
  }
}

fn pipeline_ir_native_scaled_recur_region_sites(all_blocks: IrBlockList, first_block: i64, last_block: i64) -> i64 {
  pipeline_ir_native_scaled_recur_blocks_sites(all_blocks, all_blocks, first_block, last_block, nlist_new())
}

fn pipeline_ir_native_loop_region_key_seen(seen: i64, first_block: i64, last_block: i64) -> i64 {
  let n = nlist_len(seen)
  let mut found = 0
  for i in 0..n {
    let key = nlist_get(seen, i)
    if node_f1(key) == first_block and node_f2(key) == last_block { found = 1 } else { 0 }
  }
  found
}

fn pipeline_ir_native_block_is_branch_header(blocks: IrBlockList, block_id: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          if id == block_id {
            match term {
              IrTermBranch(cond, then_block, else_block) -> 1
              _ -> 0
            }
          } else {
            pipeline_ir_native_block_is_branch_header(rest, block_id)
          }
        }
      }
    }
  }
}

fn pipeline_ir_native_block_jump_target_or(blocks: IrBlockList, block_id: i64, default: i64) -> i64 {
  match blocks {
    IrBlockListNil -> default
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          if id == block_id {
            match term {
              IrTermJump(target, args) -> target
              _ -> default
            }
          } else {
            pipeline_ir_native_block_jump_target_or(rest, block_id, default)
          }
        }
      }
    }
  }
}

fn pipeline_ir_native_block_is_loop_region_start(blocks: IrBlockList, block_id: i64) -> i64 {
  if pipeline_ir_native_block_is_branch_header(blocks, block_id) == 1 {
    1
  } else {
    let jump_target = pipeline_ir_native_block_jump_target_or(blocks, block_id, 0 - 1)
    if jump_target >= 0 and pipeline_ir_native_block_is_branch_header(blocks, jump_target) == 1 { 1 } else { 0 }
  }
}

fn pipeline_ir_native_scaled_recur_count_for_region(all_blocks: IrBlockList, first_block: i64, last_block: i64, seen_regions: i64) -> i64 {
  if first_block < 0 or last_block <= first_block {
    0
  } else {
    if pipeline_ir_native_block_is_loop_region_start(all_blocks, first_block) == 0 {
      0
    } else { if pipeline_ir_native_loop_region_key_seen(seen_regions, first_block, last_block) == 1 {
      0
    } else {
      nlist_add(seen_regions, node_new(0, first_block, last_block, 0, 0))
      pipeline_ir_native_scaled_recur_region_sites(all_blocks, first_block, last_block)
    } }
  }
}

fn pipeline_ir_native_scaled_recur_term_sites(term: IrTerminator, block_id: i64, all_blocks: IrBlockList, seen_regions: i64) -> i64 {
  match term {
    IrTermJump(target, args) -> {
      if block_id > target {
        pipeline_ir_native_scaled_recur_count_for_region(all_blocks, target, block_id, seen_regions)
      } else {
        0
      }
    }
    IrTermBranch(cond, then_block, else_block) -> {
      let then_count = if block_id > then_block {
        pipeline_ir_native_scaled_recur_count_for_region(all_blocks, then_block, block_id, seen_regions)
      } else {
        0
      }
      let else_count = if block_id > else_block {
        pipeline_ir_native_scaled_recur_count_for_region(all_blocks, else_block, block_id, seen_regions)
      } else {
        0
      }
      then_count + else_count
    }
    _ -> 0
  }
}

fn pipeline_ir_native_scaled_recur_blocks_total(blocks: IrBlockList, all_blocks: IrBlockList, seen_regions: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          pipeline_ir_native_scaled_recur_term_sites(term, id, all_blocks, seen_regions) +
          pipeline_ir_native_scaled_recur_blocks_total(rest, all_blocks, seen_regions)
        }
      }
    }
  }
}

fn pipeline_ir_native_scaled_recur_count_for_blocks(blocks: IrBlockList) -> i64 {
  pipeline_ir_native_scaled_recur_blocks_total(blocks, blocks, nlist_new())
}

fn pipeline_ir_native_term_has_backedge_to(term: IrTerminator, from_block: i64, target_block: i64) -> i64 {
  if from_block <= target_block { 0 }
  else {
    match term {
      IrTermJump(target, args) -> if target == target_block { 1 } else { 0 }
      IrTermBranch(cond, then_block, else_block) -> {
        if then_block == target_block or else_block == target_block { 1 } else { 0 }
      }
      _ -> 0
    }
  }
}

fn pipeline_ir_native_blocks_have_backedge_to(blocks: IrBlockList, target_block: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          if pipeline_ir_native_term_has_backedge_to(term, id, target_block) == 1 { 1 }
          else { pipeline_ir_native_blocks_have_backedge_to(rest, target_block) }
        }
      }
    }
  }
}

fn pipeline_ir_native_loop_cmp_slot_from_value(insts: IrInstList, all_blocks: IrBlockList, value: i64) -> i64 {
  let found = pipeline_ir_inst_list_load_slot_lookup(insts, value)
  if pipeline_ir_const_lookup_valid(found) == 1 {
    let slot = pipeline_ir_const_lookup_value(found)
    if slot >= 8 and pipeline_ir_native_blocks_store_slot(all_blocks, slot) == 1 { slot } else { 0 - 1 }
  } else {
    0 - 1
  }
}

fn pipeline_ir_native_loop_cmp_slot_from_operands(insts: IrInstList, all_blocks: IrBlockList, lhs: i64, rhs: i64) -> i64 {
  let lhs_slot = pipeline_ir_native_loop_cmp_slot_from_value(insts, all_blocks, lhs)
  if lhs_slot >= 0 { lhs_slot } else { pipeline_ir_native_loop_cmp_slot_from_value(insts, all_blocks, rhs) }
}

fn pipeline_ir_native_loop_slot_from_block(block: IrBlock, all_blocks: IrBlockList) -> i64 {
  match block {
    IrBlock(id, params, insts, term) -> {
      if pipeline_ir_native_blocks_have_backedge_to(all_blocks, id) != 1 {
        0 - 1
      } else {
        let cmp_info = pipeline_ir_native_direct_branch_cmp_info_for_term(insts, term)
        if cmp_info == 0 {
          0 - 1
        } else {
          pipeline_ir_native_loop_cmp_slot_from_operands(insts, all_blocks, node_f3(cmp_info), node_f4(cmp_info))
        }
      }
    }
  }
}

fn pipeline_ir_native_blocks_loop_pinned_slots_inner(blocks: IrBlockList, all_blocks: IrBlockList, pinned: i64) -> i64 {
  match blocks {
    IrBlockListNil -> pinned
    IrBlockListCons(block, rest) -> {
      let slot = pipeline_ir_native_loop_slot_from_block(block, all_blocks)
      let next_pinned = if slot >= 0 and pipeline_ir_native_blocks_take_slot_address(all_blocks, slot) == 0 {
        pipeline_ir_native_pinned_slot_add_candidate_kind(pinned, slot, pipeline_ir_native_pinned_slot_kind_loop())
      } else {
        pinned
      }
      pipeline_ir_native_blocks_loop_pinned_slots_inner(rest, all_blocks, next_pinned)
    }
  }
}

fn pipeline_ir_native_inst_list_pinned_slots(insts: IrInstList, all_blocks: IrBlockList, pinned: i64) -> i64 {
  match insts {
    IrInstNil -> pinned
    IrInstCons(inst, rest) -> {
      match inst {
        IrSlotI64(slot) -> {
          if slot >= 8 and pipeline_ir_native_blocks_take_slot_address(all_blocks, slot) == 0 and pipeline_ir_native_blocks_load_slot(all_blocks, slot) == 1 and pipeline_ir_native_blocks_store_slot(all_blocks, slot) == 1 {
            pipeline_ir_native_inst_list_pinned_slots(rest, all_blocks, pipeline_ir_native_pinned_slot_add_candidate(pinned, slot))
          } else {
            pipeline_ir_native_inst_list_pinned_slots(rest, all_blocks, pinned)
          }
        }
        _ -> pipeline_ir_native_inst_list_pinned_slots(rest, all_blocks, pinned)
      }
    }
  }
}

fn pipeline_ir_native_blocks_pinned_slots_inner(blocks: IrBlockList, all_blocks: IrBlockList, pinned: i64) -> i64 {
  match blocks {
    IrBlockListNil -> pinned
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          let next_pinned = pipeline_ir_native_inst_list_pinned_slots(insts, all_blocks, pinned)
          pipeline_ir_native_blocks_pinned_slots_inner(rest, all_blocks, next_pinned)
        }
      }
    }
  }
}

fn pipeline_ir_native_intrinsic_clobbers_pinned(kind: i64) -> i64 {
  -- Pinned slots live in x8/x10/x11. Keep them only in functions whose
  -- instruction stream never calls helpers or intrinsics that may reuse that
  -- volatile bank directly. Atomic lock (12) left the list with the C1b
  -- re-scratch (x15/x16/x17 now); str content-eq (44) JOINED it — its
  -- byte loop ldrb's into x10/x11, and it was missing here (latent
  -- pin-bank clobber, found in the C1b audit; the clobber-mask fact is
  -- the authority: mask ∩ {x8,x10,x11} != 0 must imply membership).
  if kind == 1 { 1 }
  else { if kind == 14 { 1 }
  else { if kind == 15 { 1 }
  else { if kind == 16 { 1 }
  else { if kind == 17 { 1 }
  else { if kind == 18 { 1 }
  else { if kind == 23 { 1 }
  else { if kind == 24 { 1 }
  else { if kind == 34 { 1 }
  else { if kind == 44 { 1 } else { 0 } } } } } } } } } }
}

fn pipeline_ir_native_inst_clobbers_pinned(inst: IrInst) -> i64 {
  match inst {
    IrCallI64(dst, callee_hash, args) -> {
      let kind = pipeline_ir_native_intrinsic_kind(callee_hash)
      if kind == 0 { 1 } else { pipeline_ir_native_intrinsic_clobbers_pinned(kind) }
    }
    IrIndirectCallI64(dst, callee, args) -> 1
    -- Generic and method calls run ordinary function bodies: the
    -- pinned-slot bank (x8/x10/x11) is call-clobbered scratch, so they
    -- disqualify pinning exactly like a direct call. Historically an
    -- ordinary call was always present alongside them and masked this
    -- gap; pure-intrinsic wrapper inlining removed the masking call in
    -- generic-call-only loops and a pinned loop counter reset every
    -- iteration.
    IrGenericCallI64(dst, callee_hash, type_args, args) -> 1
    IrMethodCallI64(dst, type_hash, method_hash, receiver, args) -> 1
    IrOwnedDropI64(value, type_hash) -> 1
    IrArrayCopyI64(dst_data, src_data, byte_size, leaf_count, leaf_stride, leaf_kind) -> 1
    IrRecordLayoutArrayLoadI64(dst_data, base, record_data_size, byte_offset, byte_size, leaf_count, leaf_stride, leaf_kind) -> 1
    IrArrayDropI64(data, leaf_count, leaf_stride, leaf_kind) -> 1
    IrHandlerDirectI64(dst, effect_hash, op_hash, handler_depth, clause_index, args) -> 1
    IrPerformI64(dst, effect_hash, op_hash, args) -> 1
    IrDeferredHandleI64(dst, handle_src, body_expr, clauses, nclauses, captures, scratch_base) -> 1
    -- Variant/record construction emits a BL to rc_default_alloc
    -- (2q slice 2): call-clobbered like any helper call.
    IrVariantInitI64(dst, tag_hash, args, field_mask) -> 1
    IrRecordInitI64(dst, type_hash, fields) -> 1
    IrRecordLayoutInitI64(dst, type_hash, data_size, align, fields) -> 1
    _ -> 0
  }
}

fn pipeline_ir_native_inst_list_clobbers_pinned(insts: IrInstList) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      if pipeline_ir_native_inst_clobbers_pinned(inst) == 1 { 1 }
      else { pipeline_ir_native_inst_list_clobbers_pinned(rest) }
    }
  }
}

-- The fiber trampoline/suspend/resume intrinsic arms write x19-x22 as fixed
-- scratch inside the calling function, so any function containing them must
-- keep the full value-bank save regardless of its own value-id reach.
fn pipeline_ir_native_inst_uses_fiber_intrinsic(inst: IrInst) -> i64 {
  match inst {
    IrCallI64(dst, callee_hash, args) -> {
      let kind = pipeline_ir_native_intrinsic_kind(callee_hash)
      if kind >= 16 and kind <= 18 { 1 } else { 0 }
    }
    _ -> 0
  }
}

fn pipeline_ir_native_inst_list_uses_fiber(insts: IrInstList) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      if pipeline_ir_native_inst_uses_fiber_intrinsic(inst) == 1 { 1 }
      else { pipeline_ir_native_inst_list_uses_fiber(rest) }
    }
  }
}

fn pipeline_ir_native_blocks_use_fiber_intrinsics(blocks: IrBlockList) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          if pipeline_ir_native_inst_list_uses_fiber(insts) == 1 { 1 }
          else { pipeline_ir_native_blocks_use_fiber_intrinsics(rest) }
        }
      }
    }
  }
}

fn pipeline_ir_native_gpr_pairs_for_function(param_count: i64, blocks: IrBlockList) -> i64 {
  if pipeline_ir_native_blocks_use_fiber_intrinsics(blocks) == 1 { 4 }
  else { if pipeline_ir_native_blocks_have_handles(blocks) == 1 {
    -- Handler clause bodies are emitted inline in this function's code
    -- region with their OWN value numbering: a clause-local value 4-7
    -- writes its canonical bank home even when the parent's next_value
    -- is small. The saved prefix must cover every numbering emitted in
    -- the region, so handle-bearing functions save all four pairs (the
    -- pair census's written-unsaved canary is the regression gate).
    4
  } else {
    let next_value = pipeline_ir_function_next_value(param_count, blocks)
    let bank_used = if next_value > 8 { 8 } else { next_value }
    (bank_used + 1) / 2
  } }
}

-- Volatile-resident selection (2l stage 3 v0). An SSA value whose whole
-- def..last-use range sits in one block, is defined and used only at
-- instructions that never touch x12-x14, and is never slot-addressed lives
-- in x12/x13/x14 instead of a spill slot — deleting its store and every
-- reload. Coverage oracle for uses is pipeline_ir_live_set_add_inst_uses;
-- functions containing handle instructions bail out entirely because that
-- walker does not report their capture reads.

fn pipeline_ir_native_resident_dense_new(n: i64, fill: i64) -> i64 {
  let l = nlist_new()
  let mut i = 0
  while i < n {
    nlist_add(l, fill)
    i = i + 1
  }
  l
}

fn pipeline_ir_native_resident_dense_set(l: i64, index: i64, value: i64) -> i64 {
  mem_store64_at(mem_load64_at(l, 0), index * 8, value)
  0
}

-- Simple instructions: single GPR destination through result_reg with
-- scratch limited to x15/x16/x17. Everything else is a barrier for
-- x12-x14 live ranges.
fn pipeline_ir_native_resident_inst_simple(inst: IrInst) -> i64 {
  match inst {
    IrConstI64(dst, value) -> 1
    IrNilI64(dst) -> 1
    IrBinaryI64(dst, op, lhs, rhs) -> 1
    IrUnaryI64(dst, op, value) -> 1
    IrBindI64(ns, nl, value, ty) -> 1
    IrSlotI64(slot) -> 1
    IrLoadI64(dst, slot) -> 1
    IrStoreI64(slot, value) -> 1
    IrFieldLoadI64(dst, base, field_hash, field_index) -> 1
    IrRecordLayoutWordLoadI64(dst, base, record_data_size, field_hash, byte_offset) -> 1
    IrVariantPayloadI64(dst, base, index) -> 1
    -- 2v Stage 2 C1 simple-flip: pool-transparent intrinsics (clobber
    -- mask misses x1-x14 entirely) are plain inline instructions, not
    -- barriers. Their reads stage via move_call_args and their x17
    -- result stores via store_reg_pinned — both pinned-map-aware — so
    -- every tenancy class survives them. The barrier increment, the
    -- split flip hook, and fp_simple all key off this classification;
    -- the checker replays emission-time events either way and is the
    -- ground-truth gate. The par lowering marker has kind 0 and stays
    -- non-simple.
    IrCallI64(dst, callee_hash, args) -> {
      let kind = pipeline_ir_native_intrinsic_kind(callee_hash)
      if kind == 0 { 0 } else { pipeline_ir_native_intrinsic_pool_transparent(kind) }
    }
    _ -> 0
  }
}

fn pipeline_ir_native_inst_is_handle(inst: IrInst) -> i64 {
  match inst {
    IrHandleI64(dst, handle_src, body, clauses, nclauses, captures) -> 1
    IrDeferredHandleI64(dst, handle_src, body_expr, clauses, nclauses, captures, scratch_base) -> 1
    _ -> 0
  }
}

-- Call-shaped defs write their destination as the final emission step,
-- after the BL/BLR and every scratch clobber, so a call result may be
-- resident even though the defining instruction is a barrier: the
-- barrier-count baseline at the def already includes the call itself.
fn pipeline_ir_native_resident_inst_call_def(inst: IrInst) -> i64 {
  match inst {
    IrCallI64(dst, callee_hash, args) -> 1
    IrIndirectCallI64(dst, callee, args) -> 1
    IrGenericCallI64(dst, callee_hash, type_args, args) -> 1
    IrMethodCallI64(dst, type_hash, method_hash, receiver, args) -> 1
    IrVectorGetI64(dst, vec, index, fallback, check_mode) -> 1
    IrVectorSetI64(dst, vec, index, value, check_mode) -> 1
    _ -> 0
  }
}

-- Use sites whose every operand read routes through the pinned-aware
-- load path (move_call_args / move_args / load_reg / emit_f64_to /
-- load_value_temp_pinned, or the pre-alloc capture spill): legal reads
-- for callee-saved tenants even though the instruction is a barrier for
-- the caller-saved pools. This is a read-correctness whitelist, not a
-- clobber question — a pinned value's spill slot is never written, so a
-- hand-rolled reader would see garbage. Per-emitter audit 2026-08-02
-- admitted the effectful constructors, float binaries, ptr ops, try/
-- opt-chain (their Fail dispatch paths read nothing hand-rolled),
-- closures (capture spill precedes the identity-home env build), and
-- the vector-storage generic family (inline-record specialisations
-- read addr/value via load_reg; other element types take the default
-- generic call). Intrinsic calls admitted 2026-08-02: move_call_args
-- kinds stage through it, bespoke-read kinds (2/3/8 since C1b, 35-44)
-- read via load_reg per arm, and every arm that scratches x19+ (the
-- fiber family) saves
-- x19-x28+fp+lr into the prompt/segment first
-- (cg_fiber_prompt_save_handler_state / cg_fiber_segment_save_state)
-- and restores on every exit path. Perform admitted on the same
-- evidence: args stage via move_args; the tail-resumptive path is a
-- plain clause call, and the dynamic deferred path suspends through
-- cg_fiber_segment_save_state, which preserves the full GPR
-- callee-saved file (NOT d8-d15 — fp_cs_simple's fiber barriers
-- remain load-bearing). Still excluded: the par marker.
fn pipeline_ir_native_resident_inst_cs_use_safe(inst: IrInst) -> i64 {
  match inst {
    IrCallI64(dst, callee_hash, args) -> {
      if callee_hash == pipeline_ir_pseudo_par_lowering_marker_hash() { 0 } else { 1 }
    }
    IrPerformI64(dst, effect_hash, op_hash, args) -> 1
    IrResumeI64(dst, value) -> 1
    IrIndirectCallI64(dst, callee, args) -> 1
    IrMethodCallI64(dst, type_hash, method_hash, receiver, args) -> 1
    IrGenericCallI64(dst, callee_hash, type_args, args) -> 1
    IrVectorGetI64(dst, vec, index, fallback, check_mode) -> 1
    IrVectorSetI64(dst, vec, index, value, check_mode) -> 1
    IrPtrLoadI64(dst, ptr) -> 1
    IrPtrStoreI64(dst, ptr, value) -> 1
    IrFloatBinaryI64(dst, prim, op, lhs, rhs) -> 1
    IrStringConcatI64(dst, left, right) -> 1
    IrVariantInitI64(dst, tag_hash, payloads, field_mask) -> 1
    IrRecordInitI64(dst, type_hash, fields) -> 1
    IrRecordLayoutInitI64(dst, type_hash, data_size, align, fields) -> 1
    IrRecordLayoutArrayLoadI64(dst_data, base, record_data_size, byte_offset, byte_size, leaf_count, leaf_stride, leaf_kind) -> 1
    IrRecordLayoutWordLoadI64(dst, base, record_data_size, field_hash, byte_offset) -> 1
    IrVariantTagI64(dst, base) -> 1
    IrTryI64(dst, value, effect_key) -> 1
    IrOptChainI64(dst, base, field_hash, field_index, effect_key) -> 1
    IrClosureI64(dst, f, captures, eff) -> 1
    _ -> 0
  }
}

-- 2v Stage 1 call-clobber modeling: a value whose FINAL use is one of
-- these shapes may live in an arg-safe caller-saved register
-- (x8/x10-x14) right up to that use — every operand read completes
-- BEFORE anything in the instruction's emission can clobber the
-- caller-saved file. This is STRICTLY STRONGER than cs_use_safe
-- (which only needs pinned-aware reads, in any order, because x19-x26
-- survive internal BLs): alloc-first shapes read their operands AFTER
-- an internal allocation call and are cs-safe but never
-- call-window-safe. move_call_args writes x0..arity-1 (ascending) plus
-- x16 spill scratch — the seat-side arity guard keeps call-window
-- seats at or above the final call's staged-register count; the
-- indirect-call shape also stages the closure code pointer through x9
-- pre-BLR, which is why x9 stays out of the arg-safe segment. Vector
-- lane get/set stage operands through x12-x17 scratch before their
-- reads complete.
fn pipeline_ir_native_resident_inst_call_read_safe(inst: IrInst) -> i64 {
  match inst {
    IrVectorGetI64(dst, vec, index, fallback, check_mode) -> 0
    IrVectorSetI64(dst, vec, index, value, check_mode) -> 0
    IrVariantInitI64(dst, tag_hash, payloads, field_mask) -> 0
    IrRecordInitI64(dst, type_hash, fields) -> 0
    IrRecordLayoutInitI64(dst, type_hash, data_size, align, fields) -> 0
    IrClosureI64(dst, f, captures, eff) -> 0
    -- The Err arm reloads the Result payload after handler_find_entry.
    -- A final-use value in x10-x14 would therefore be destroyed by the
    -- lookup before that read (x13 becomes the handler entry itself).
    IrTryI64(dst, value, effect_key) -> 0
    -- Perform's deferred-frame scan scratches x10-x15 BEFORE arg
    -- staging; the content-eq arm (44) stages operands through
    -- x10-x15 mid-read (kinds 35-43 re-scratched off the pools in C1b
    -- and are simple now, so this exclusion is live only for 44).
    -- Both are cs-safe but not call-window-safe.
    IrPerformI64(dst, effect_hash, op_hash, args) -> 0
    IrCallI64(dst, callee_hash, args) -> {
      let kind = pipeline_ir_native_intrinsic_kind(callee_hash)
      if kind >= 35 and kind <= 44 { 0 } else { pipeline_ir_native_resident_inst_cs_use_safe(inst) }
    }
    _ -> pipeline_ir_native_resident_inst_cs_use_safe(inst)
  }
}

-- Def shapes whose dead result store may be deleted (2v Stage 2): the
-- call_read_safe set plus effectful constructors and the scaled-addr
-- vector set — each audited to read operands only through the
-- pinned-aware load path and to touch dst only in the single trailing
-- store_reg_pinned. Their emitted effects (the call, the store, the
-- allocation) are untouched; a dead managed constructor result keeps
-- today's leak status quo (an unused managed value either carries an
-- explicit temp-release use, which excludes it here, or already
-- leaked its node before this pass existed).
fn pipeline_ir_native_resident_inst_dead_store_safe(inst: IrInst) -> i64 {
  match inst {
    IrVectorSetI64(dst, vec, index, value, check_mode) -> 1
    IrStringConcatI64(dst, left, right) -> 1
    IrStringLit(dst, start, len) -> 1
    IrVariantInitI64(dst, tag_hash, payloads, field_mask) -> 1
    IrRecordInitI64(dst, type_hash, fields) -> 1
    IrRecordLayoutInitI64(dst, type_hash, data_size, align, fields) -> 1
    _ -> pipeline_ir_native_resident_inst_call_read_safe(inst)
  }
}

-- Lambda emission materialises its closure and env through direct
-- (identity-home) register helpers, so functions containing lambdas keep
-- identity bank homes: the swap permutation bails on them.
fn pipeline_ir_native_inst_is_lambda(inst: IrInst) -> i64 {
  match inst {
    IrClosureI64(dst, f, captures, eff) -> 1
    _ -> 0
  }
}

fn pipeline_ir_native_blocks_have_lambdas(blocks: IrBlockList) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          let mut cur = insts
          let mut found = 0
          let mut done = 0
          while done == 0 {
            match cur {
              IrInstNil -> { done = 1 }
              IrInstCons(inst, tail) -> {
                if pipeline_ir_native_inst_is_lambda(inst) == 1 {
                  found = 1
                  done = 1
                } else { cur = tail }
              }
            }
          }
          if found == 1 { 1 } else { pipeline_ir_native_blocks_have_lambdas(rest) }
        }
      }
    }
  }
}

fn pipeline_ir_native_blocks_have_handles(blocks: IrBlockList) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          let mut cur = insts
          let mut found = 0
          let mut done = 0
          while done == 0 {
            match cur {
              IrInstNil -> { done = 1 }
              IrInstCons(inst, tail) -> {
                if pipeline_ir_native_inst_is_handle(inst) == 1 {
                  found = 1
                  done = 1
                } else { cur = tail }
              }
            }
          }
          if found == 1 { 1 } else { pipeline_ir_native_blocks_have_handles(rest) }
        }
      }
    }
  }
}

fn pipeline_ir_native_resident_mark_slot_like(inst: IrInst, slot_like: i64, addr_taken: i64, next_value: i64) -> i64 {
  match inst {
    IrSlotI64(slot) -> if slot >= 0 and slot < next_value { pipeline_ir_native_resident_dense_set(slot_like, slot, 1) } else { 0 }
    IrLoadI64(dst, slot) -> if slot >= 0 and slot < next_value { pipeline_ir_native_resident_dense_set(slot_like, slot, 1) } else { 0 }
    IrStoreI64(slot, value) -> if slot >= 0 and slot < next_value { pipeline_ir_native_resident_dense_set(slot_like, slot, 1) } else { 0 }
    IrAddressOfSlotI64(dst, slot) -> if slot >= 0 and slot < next_value {
      pipeline_ir_native_resident_dense_set(slot_like, slot, 1)
      pipeline_ir_native_resident_dense_set(addr_taken, slot, 1)
    } else { 0 }
    _ -> 0
  }
}

-- Dense scan arrays, bundled to keep signatures small:
-- 0 def_pos, 1 def_block, 2 def_simple, 3 last_use, 4 use_local,
-- 5 use_gpr_ok, 6 use_fp_ok, 7 use_seen, 8 slot_like, 9 fp_def,
-- 10 weight, 11 addr_taken, 12 swap_excluded, 13 use_cs_ok,
-- 14 use_last_kind (0 simple, 1 call-read-safe, 2 other non-simple),
-- 15 use_last_pre_barrier (barrier count BEFORE the last use's inst),
-- 16 use_nonfinal_unsafe (some non-final use was non-simple),
-- 17 def_discard_safe (defining inst is a dead_store_safe shape),
-- 18 use_count (raw use-site tally),
-- 19 def_const_kind (0 none, 1 single-instruction movz const,
--    2 multi-instruction const, 3 single-instruction movn const),
-- 20 def_const_val (the constant, valid when def_const_kind != 0),
-- 21 def_segment_uses (uses inside the def's own barrier-free segment:
--    same block, no barrier between — the loads a def-segment split
--    tenancy would delete),
-- 22 def_barrier (barrier count at the def, barrier_at[def_pos] cached
--    per value so record_use can compare without the gpos list),
-- 23 def_segment_last_use (latest simple-inst segment-use gpos — the
--    split tenancy's window end),
-- 24 use_last_fwd (last use site is an IrBinaryI64 — the only forward
--    consumer, checked before it emits any code),
-- 25 def_x17_simple (def is a plain simple inst whose result stores
--    from x17 — the shape forward_record requires),
-- 26 use_seg_key (last (block, pre-barrier) window a use fell in,
--    packed block_id * 1000000 + pre_barrier; -1 none),
-- 27 use_seg_count (distinct barrier-free windows containing uses —
--    a multi-segment split pays one reload per window, so a value's
--    deletable-load upper bound is ledger_loads - use_seg_count),
-- 28 use_last_call_arity (staged-register count of the LAST use's call
--    shape: move_call_args writes x0..arity-1 — NOT just x0-x7 — so a
--    call-window seat must sit at or above the final call's arity or
--    the staging of a lower-indexed argument clobbers the seat before
--    this value's own read; 0 for non-call shapes),
-- 29 redefined (a second inst def was seen: def_pos keeps the FIRST
--    def and use_local conflates redefinition with cross-block use, so
--    the single-window volatile classes need this to tell them apart —
--    a trailing dead redefinition would write a shared seat OUTSIDE
--    the occupancy window)
fn pipeline_ir_native_resident_record_use(u: i64, gpos: i64, block_id: i64, simple: i64, fp_allowed: i64, cs_safe: i64, call_safe: i64, fwd_use: i64, pre_barrier: i64, next_value: i64, arrays: i64, w: i64, call_arity: i64) -> i64 {
  if u >= 0 and u < next_value {
    -- Call-window tenancy bookkeeping (2v Stage 1): only the FINAL use
    -- may sit at a call-shaped instruction — an earlier non-simple use
    -- would leave the register clobbered while the value is still
    -- needed. Same-gpos repeat uses (f(v, v)) are one instruction and
    -- keep the recorded kind.
    let prev_lu = nlist_get(nlist_get(arrays, 3), u)
    if prev_lu >= 0 and prev_lu != gpos and nlist_get(nlist_get(arrays, 14), u) != 0 {
      pipeline_ir_native_resident_dense_set(nlist_get(arrays, 16), u, 1)
    } else { 0 }
    if prev_lu != gpos {
      let kind = if simple == 1 { 0 } else { if call_safe == 1 { 1 } else { 2 } }
      pipeline_ir_native_resident_dense_set(nlist_get(arrays, 14), u, kind)
      pipeline_ir_native_resident_dense_set(nlist_get(arrays, 15), u, pre_barrier)
      pipeline_ir_native_resident_dense_set(nlist_get(arrays, 24), u, fwd_use)
      pipeline_ir_native_resident_dense_set(nlist_get(arrays, 28), u, call_arity)
    } else { 0 }
    pipeline_ir_native_resident_dense_set(nlist_get(arrays, 7), u, 1)
    pipeline_ir_native_resident_dense_set(nlist_get(arrays, 3), u, gpos)
    pipeline_ir_native_resident_dense_set(nlist_get(arrays, 10), u, nlist_get(nlist_get(arrays, 10), u) + w)
    pipeline_ir_native_resident_dense_set(nlist_get(arrays, 18), u, nlist_get(nlist_get(arrays, 18), u) + 1)
    let seg_key = block_id * 1000000 + pre_barrier
    if nlist_get(nlist_get(arrays, 26), u) != seg_key {
      pipeline_ir_native_resident_dense_set(nlist_get(arrays, 26), u, seg_key)
      pipeline_ir_native_resident_dense_set(nlist_get(arrays, 27), u, nlist_get(nlist_get(arrays, 27), u) + 1)
    } else { 0 }
    if simple == 1 and nlist_get(nlist_get(arrays, 0), u) >= 0 and nlist_get(nlist_get(arrays, 1), u) == block_id {
      if nlist_get(nlist_get(arrays, 22), u) == pre_barrier {
        pipeline_ir_native_resident_dense_set(nlist_get(arrays, 21), u, nlist_get(nlist_get(arrays, 21), u) + 1)
        pipeline_ir_native_resident_dense_set(nlist_get(arrays, 23), u, gpos)
      } else { 0 }
    } else { 0 }
    if simple == 0 { pipeline_ir_native_resident_dense_set(nlist_get(arrays, 5), u, 0) } else { 0 }
    if cs_safe == 0 { pipeline_ir_native_resident_dense_set(nlist_get(arrays, 13), u, 0) } else { 0 }
    if fp_allowed == 0 { pipeline_ir_native_resident_dense_set(nlist_get(arrays, 6), u, 0) } else { 0 }
    if nlist_get(nlist_get(arrays, 0), u) < 0 { pipeline_ir_native_resident_dense_set(nlist_get(arrays, 4), u, 0) }
    else { if nlist_get(nlist_get(arrays, 1), u) != block_id { pipeline_ir_native_resident_dense_set(nlist_get(arrays, 4), u, 0) } else { 0 } }
    0
  } else { 0 }
}

fn pipeline_ir_native_resident_record_use_set(uses: PipelineIrLiveSet, gpos: i64, block_id: i64, simple: i64, fp_allowed: i64, cs_safe: i64, call_safe: i64, fwd_use: i64, pre_barrier: i64, next_value: i64, arrays: i64, w: i64, call_arity: i64) -> i64 {
  match uses {
    PipelineIrLiveSetNil -> 0
    PipelineIrLiveSetCons(u, rest) -> {
      pipeline_ir_native_resident_record_use(u, gpos, block_id, simple, fp_allowed, cs_safe, call_safe, fwd_use, pre_barrier, next_value, arrays, w, call_arity)
      pipeline_ir_native_resident_record_use_set(rest, gpos, block_id, simple, fp_allowed, cs_safe, call_safe, fwd_use, pre_barrier, next_value, arrays, w, call_arity)
    }
    PipelineIrLiveSetBits(array, words, count) -> 0
  }
}

-- F64 arithmetic FloatBinary defs may join the FP pool d2-d7; any-op F64
-- FloatBinary operands and stores into fact-homed f64 slots are the only
-- allowed FP-resident reads (both flow through emit_f64_to).
fn pipeline_ir_native_resident_inst_fp_def(inst: IrInst, f64_facts: PipelineIrNativeF64Facts) -> i64 {
  match inst {
    IrFloatBinaryI64(dst, prim, op, lhs, rhs) -> {
      if prim == PRIM_F64() {
        match op {
          IrAdd -> 1
          IrSub -> 1
          IrMul -> 1
          IrDiv -> 1
          _ -> 0
        }
      } else { 0 }
    }
    IrLoadI64(dst, slot) -> if pipeline_ir_native_f64_slot_home_lookup(f64_facts, slot) >= 0 { 1 } else { 0 }
    -- Type discipline makes unconditional vector-get FP defs sound: the
    -- candidate only becomes FP-resident if every use is an F64 site, and
    -- an i64 element value cannot reach one without a conversion call.
    IrVectorGetI64(dst, vec, index, fallback, check_mode) -> 1
    _ -> 0
  }
}

fn pipeline_ir_native_resident_inst_fp_use_allowed(inst: IrInst, f64_facts: PipelineIrNativeF64Facts) -> i64 {
  match inst {
    IrFloatBinaryI64(dst, prim, op, lhs, rhs) -> if prim == PRIM_F64() { 1 } else { 0 }
    IrStoreI64(slot, value) -> if pipeline_ir_native_f64_slot_home_lookup(f64_facts, slot) >= 0 { 1 } else { 0 }
    IrBindI64(ns, nl, value, ty) -> 1
    -- The set's vec/index operands are typed i64/pointer and can never be
    -- FP defs, so allowing the whole instruction only admits the value.
    IrVectorSetI64(dst, vec, index, value, check_mode) -> 1
    _ -> 0
  }
}

fn pipeline_ir_native_resident_inst_fp_simple(inst: IrInst) -> i64 {
  if pipeline_ir_native_resident_inst_simple(inst) == 1 { 1 }
  else {
    match inst {
      IrFloatBinaryI64(dst, prim, op, lhs, rhs) -> 1
      -- Vector lane get/set touch x9/x12-x17 but never the d2-d7 pool
      -- (an FP-resident dst/value is their own assignment).
      IrVectorGetI64(dst, vec, index, fallback, check_mode) -> 1
      IrVectorSetI64(dst, vec, index, value, check_mode) -> 1
      -- Conversion and sqrt intrinsics (kinds 25-33) stage only through
      -- d0/s0/x17, so d2-d7 ranges span them (e.g. across nbody's sqrt).
      -- Normally short-circuited by the C1 pool-transparent flip above;
      -- kept as the independent FP fact so the d2-d7 span survives even
      -- if a future GPR-mask change drops these kinds from the
      -- transparent set.
      IrCallI64(dst, callee_hash, args) -> {
        let kind = pipeline_ir_native_intrinsic_kind(callee_hash)
        if kind >= 25 and kind <= 33 { 1 } else { 0 }
      }
      _ -> 0
    }
  }
}

-- Callee-saved FP transparency: d8-d15 survive every real call because
-- all internal functions either never touch them or save them under
-- preserve_fp, and external AAPCS callees preserve them too. Only
-- stack-switching or continuation-capturing shapes are barriers.
fn pipeline_ir_native_resident_inst_fp_cs_simple(inst: IrInst) -> i64 {
  if pipeline_ir_native_resident_inst_fp_simple(inst) == 1 { 1 }
  else {
    match inst {
      IrCallI64(dst, callee_hash, args) -> {
        let kind = pipeline_ir_native_intrinsic_kind(callee_hash)
        if kind >= 16 and kind <= 18 { 0 } else { if kind == 34 { 0 } else { 1 } }
      }
      IrIndirectCallI64(dst, callee, args) -> 1
      IrGenericCallI64(dst, callee_hash, type_args, args) -> 1
      IrMethodCallI64(dst, type_hash, method_hash, receiver, args) -> 1
      IrStringConcatI64(dst, left, right) -> 1
      IrOwnedDropI64(value, type_hash) -> 1
      IrArrayCopyI64(dst_data, src_data, byte_size, leaf_count, leaf_stride, leaf_kind) -> 1
      IrRecordLayoutArrayLoadI64(dst_data, base, record_data_size, byte_offset, byte_size, leaf_count, leaf_stride, leaf_kind) -> 1
      IrArrayDropI64(data, leaf_count, leaf_stride, leaf_kind) -> 1
      IrVariantInitI64(dst, tag_hash, payloads, field_mask) -> 1
      IrRecordInitI64(dst, type_hash, fields) -> 1
      IrRecordLayoutInitI64(dst, type_hash, data_size, align, fields) -> 1
      IrClosureI64(dst, f, captures, eff) -> 1
      IrFunctionRefI64(dst, callee_hash) -> 1
      IrGenericFunctionRefI64(dst, callee_hash, type_args) -> 1
      IrOptChainI64(dst, base, field_hash, field_index, effect_key) -> 1
      IrStringLit(dst, start, len) -> 1
      IrAddressOfSlotI64(dst, slot) -> 1
      IrPtrLoadI64(dst, ptr) -> 1
      IrPtrStoreI64(dst, ptr, value) -> 1
      _ -> 0
    }
  }
}

-- Straight-line regions: maximal chains of blocks linked by unconditional
-- jumps where each successor has exactly one predecessor. Within a region,
-- layout order is execution order and no other code interleaves, so the
-- def..last-use range math stays sound. CFG call lowering splits every call
-- into block chains; regions restore residency across them.
fn pipeline_ir_native_resident_max_block_id(blocks: IrBlockList) -> i64 {
  match blocks {
    IrBlockListNil -> 0 - 1
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          let rest_max = pipeline_ir_native_resident_max_block_id(rest)
          if id > rest_max { id } else { rest_max }
        }
      }
    }
  }
}

fn pipeline_ir_native_resident_count_abort_preds(insts: IrInstList, pred_count: i64, max_id: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      match inst {
        IrHandleI64(dst, handle_src, effect_hash, clauses, nclauses, abort_block) -> {
          if abort_block >= 0 and abort_block <= max_id {
            pipeline_ir_native_resident_dense_set(pred_count, abort_block, nlist_get(pred_count, abort_block) + 1)
          } else { 0 }
        }
        _ -> 0
      }
      pipeline_ir_native_resident_count_abort_preds(rest, pred_count, max_id)
    }
  }
}

fn pipeline_ir_native_resident_count_preds(blocks: IrBlockList, pred_count: i64, jump_pred: i64, max_id: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          pipeline_ir_native_resident_count_abort_preds(insts, pred_count, max_id)
          match term {
            IrTermJump(target, args) -> {
              if target >= 0 and target <= max_id {
                pipeline_ir_native_resident_dense_set(pred_count, target, nlist_get(pred_count, target) + 1)
                pipeline_ir_native_resident_dense_set(jump_pred, target, id)
              } else { 0 }
            }
            IrTermBranch(cond, then_block, else_block) -> {
              if then_block >= 0 and then_block <= max_id {
                pipeline_ir_native_resident_dense_set(pred_count, then_block, nlist_get(pred_count, then_block) + 1)
              } else { 0 }
              if else_block >= 0 and else_block <= max_id {
                pipeline_ir_native_resident_dense_set(pred_count, else_block, nlist_get(pred_count, else_block) + 1)
              } else { 0 }
            }
            _ -> 0
          }
          pipeline_ir_native_resident_count_preds(rest, pred_count, jump_pred, max_id)
        }
      }
    }
  }
}

fn pipeline_ir_native_resident_regions(blocks: IrBlockList) -> i64 {
  let max_id = pipeline_ir_native_resident_max_block_id(blocks)
  let n = max_id + 1
  let pred_count = pipeline_ir_native_resident_dense_new(n, 0)
  let jump_pred = pipeline_ir_native_resident_dense_new(n, 0 - 1)
  pipeline_ir_native_resident_count_preds(blocks, pred_count, jump_pred, max_id)
  let region_of = pipeline_ir_native_resident_dense_new(n, 0 - 1)
  let layout_pos = pipeline_ir_native_resident_dense_new(n, 0 - 1)
  let mut next_region = 0
  let mut pos = 0
  let mut cur = blocks
  let mut done = 0
  while done == 0 {
    match cur {
      IrBlockListNil -> { done = 1 }
      IrBlockListCons(block, rest) -> {
        match block {
          IrBlock(id, params, insts, term) -> {
            pipeline_ir_native_resident_dense_set(layout_pos, id, pos)
            pos = pos + 1
            let jp = nlist_get(jump_pred, id)
            let chained = if nlist_get(pred_count, id) == 1 and jp >= 0 {
              if nlist_get(region_of, jp) >= 0 { 1 } else { 0 }
            } else { 0 }
            if chained == 1 {
              pipeline_ir_native_resident_dense_set(region_of, id, nlist_get(region_of, jp))
            } else {
              pipeline_ir_native_resident_dense_set(region_of, id, next_region)
              next_region = next_region + 1
            }
            cur = rest
          }
        }
      }
    }
  }
  node_new(0, region_of, layout_pos, pos, 0)
}

-- Loop depth per layout position: a backedge is any terminator target at
-- or before its source in layout order; a block's depth is the number of
-- backedge spans covering it. Weights use 4^min(depth, 4).
fn pipeline_ir_native_resident_depths(blocks: IrBlockList, layout_pos: i64, block_count: i64) -> i64 {
  let depth_of = pipeline_ir_native_resident_dense_new(block_count, 0)
  let mut cur = blocks
  let mut done = 0
  while done == 0 {
    match cur {
      IrBlockListNil -> { done = 1 }
      IrBlockListCons(block, rest) -> {
        match block {
          IrBlock(id, params, insts, term) -> {
            let src_pos = nlist_get(layout_pos, id)
            let target = match term {
              IrTermJump(t, args) -> t
              IrTermBranch(cond, tb, eb) -> {
                -- Treat the earlier of the two targets as the loop edge.
                let tp = nlist_get(layout_pos, tb)
                let ep = nlist_get(layout_pos, eb)
                if tp >= 0 and tp <= src_pos { tb } else { if ep >= 0 and ep <= src_pos { eb } else { 0 - 1 } }
              }
              _ -> 0 - 1
            }
            if target >= 0 {
              let tpos = nlist_get(layout_pos, target)
              if tpos >= 0 and tpos <= src_pos {
                let mut p = tpos
                while p <= src_pos {
                  pipeline_ir_native_resident_dense_set(depth_of, p, nlist_get(depth_of, p) + 1)
                  p = p + 1
                }
              } else { 0 }
            } else { 0 }
            cur = rest
          }
        }
      }
    }
  }
  depth_of
}

fn pipeline_ir_native_resident_weight_for_depth(depth: i64) -> i64 {
  if depth <= 0 { 1 }
  else { if depth == 1 { 4 }
  else { if depth == 2 { 16 }
  else { if depth == 3 { 64 } else { 256 } } } }
}

fn pipeline_ir_native_resident_term_uses(term: IrTerminator) -> PipelineIrLiveSet {
  match term {
    IrTermNone -> pipeline_ir_live_set_empty()
    IrTermReturn(value) -> pipeline_ir_live_set_add(pipeline_ir_live_set_empty(), value)
    IrTermJump(target, args) -> pipeline_ir_live_set_add_values(pipeline_ir_live_set_empty(), args)
    IrTermBranch(cond, then_block, else_block) -> pipeline_ir_live_set_add(pipeline_ir_live_set_empty(), cond)
  }
}

fn pipeline_ir_native_resident_pool_reg(index: i64) -> i64 {
  if index == 0 { 12 }
  else { if index == 1 { 13 }
  else { if index == 2 { 14 } else { 0 } } }
}

fn pipeline_ir_native_pinned_slot_kind_resident() -> i64 { 2 }
fn pipeline_ir_native_pinned_slot_kind_swap() -> i64 { 3 }

fn pipeline_ir_native_pinned_has_cs_fp(pinned: i64) -> i64 {
  let mut cur = pinned
  let mut found = 0
  while cur != 0 and found == 0 {
    -- Callee-saved FP homes are exactly 1008-1015 (d8-d15); the remat
    -- pseudo-home range lies far above and must not trip preserve_fp.
    if node_f2(cur) >= 1008 and node_f2(cur) <= 1015 { found = 1 } else { cur = node_f3(cur) }
  }
  found
}

-- Emission-level residency audit (2o): note a pool tenancy with its scan
-- range (def gpos, last-use gpos) so the post-emission checker can verify
-- that no foreign write lands inside the tenant's window. No-op unless
-- pipeline_cg_ir_only_function armed the audit for this function.
-- Tuple: (phys, window lo gpos, window hi gpos, legal-writer gpos list).
-- Instruction tenants have no writer list (their def instruction owns the
-- only legal write, and the window starts after it); block-param tenants
-- carry the gpos of every predecessor jump whose edge moves feed them.
fn pipeline_ir_native_audit_note_range(fm: i64, value: i64, phys: i64, dp: i64, lu: i64) -> i64 {
  let ranges = fmap_audit_ranges(fm)
  if ranges != 0 {
    nlist_add(ranges, node_new(0, phys, dp, lu, 0))
    0
  } else { 0 }
}

fn pipeline_ir_native_audit_note_param_range(fm: i64, phys: i64, lo: i64, hi: i64, writers: i64) -> i64 {
  let ranges = fmap_audit_ranges(fm)
  if ranges != 0 {
    nlist_add(ranges, node_new(0, phys, lo, hi, writers))
    0
  } else { 0 }
}

-- Loop rounding for param windows: a layout interval [lo, hi] only
-- models a live range if it also covers every loop body that executes
-- between uses. Any terminator at gpos g targeting a block whose entry
-- gpos lies inside the window re-enters it, so the window must extend to
-- g; iterate to fixpoint for nested loops. Without this, a value used by
-- a loop condition ends its window AT the condition and the loop body is
-- free for a second same-register tenant — the check_handler_clause
-- miscompile (nbind clobbered by an op-param call result inside the
-- param-binding loop).
-- Bidirectional loop rounding for callee-saved windows: a positional
-- window only models a live range if it covers every block that can
-- execute between its endpoints. The upward arm extends hi over edges
-- that re-enter the window from beyond it; the downward arm pulls lo
-- back when an edge inside the window targets a positionally earlier
-- block, so home-sharing can never interleave with a dynamically
-- revisited prefix. Returns node(lo, hi).
fn pipeline_ir_native_cs_round_window(edges: i64, block_entry_gpos: i64, block_count: i64, lo0: i64, hi0: i64) -> i64 {
  let mut lo = lo0
  let mut hi = hi0
  let mut changed = 1
  while changed == 1 {
    changed = 0
    let n = nlist_len(edges)
    for i in 0..n {
      let e = nlist_get(edges, i)
      let t = node_f1(e)
      let g = node_f2(e)
      if t >= 0 and t < block_count {
        let te = nlist_get(block_entry_gpos, t)
        if te >= lo and te <= hi and g > hi {
          hi = g
          changed = 1
        } else { 0 }
        if g >= lo and g <= hi and te >= 0 and te < lo {
          lo = te
          changed = 1
        } else { 0 }
      } else { 0 }
    }
  }
  node_new(0, lo, hi, 0, 0)
}

-- Interval-set occupancy probe (2v Stage 2 C3): does [lo, hi] overlap
-- any tenant interval already seated in this register's set? Windows
-- are inclusive on both ends, matching the cs home-reuse pass.
fn pipeline_ir_native_pool_iv_clash(ivs: i64, lo: i64, hi: i64) -> i64 {
  let n = nlist_len(ivs)
  let mut i = 0
  let mut clash = 0
  while i < n and clash == 0 {
    let iv = nlist_get(ivs, i)
    if lo <= node_f2(iv) and node_f1(iv) <= hi { clash = 1 } else { i = i + 1 }
  }
  clash
}

fn pipeline_ir_native_param_round_hi(edges: i64, block_entry_gpos: i64, block_count: i64, lo: i64, hi0: i64) -> i64 {
  let mut hi = hi0
  let mut changed = 1
  while changed == 1 {
    changed = 0
    let n = nlist_len(edges)
    for i in 0..n {
      let e = nlist_get(edges, i)
      let t = node_f1(e)
      let g = node_f2(e)
      if t >= 0 and t < block_count {
        let te = nlist_get(block_entry_gpos, t)
        if te >= lo and te <= hi and g > hi {
          hi = g
          changed = 1
        } else { 0 }
      } else { 0 }
    }
  }
  hi
}

-- A function-parameter identity home may host a later callee-saved tenant
-- only when epilogue cleanup will not read the parameter from that home.
-- Scalar/value parameters have no cleanup descriptor; borrowed managed
-- parameters are caller-owned and likewise have none. Owned managed
-- parameters stay reserved through function exit.
fn pipeline_ir_native_reusable_param_homes_from_binds(insts: IrInstList, param_count: i64, seen: i64, borrowed_mask: i64, reusable: i64) -> i64 {
  if seen >= param_count { 0 }
  else {
    match insts {
      IrInstNil -> 0
      IrInstCons(inst, rest) -> {
        match inst {
          IrBindI64(ns, nl, value, ty) -> {
            if value >= 0 and value < param_count {
              let lanes = pipeline_type_value_lane_count_or_one(ty)
              for lane in 0..lanes {
                if value + lane < param_count and (cg_mask_has(borrowed_mask, seen) == 1 or pipeline_type_value_lane_release_kind(ty, lane) == continuation_cleanup_kind_none()) {
                  pipeline_ir_native_resident_dense_set(reusable, value + lane, 1)
                } else { 0 }
              }
              pipeline_ir_native_reusable_param_homes_from_binds(rest, param_count, seen + 1, borrowed_mask, reusable)
            } else { 0 }
          }
          _ -> 0
        }
      }
    }
  }
}

fn pipeline_ir_native_reusable_param_homes(blocks: IrBlockList, param_count: i64) -> i64 {
  let reusable = pipeline_ir_native_resident_dense_new(8, 0)
  match blocks {
    IrBlockListNil -> reusable
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          let borrowed_mask = pipeline_ir_native_borrowed_param_mask_from_inst_list(insts)
          pipeline_ir_native_reusable_param_homes_from_binds(insts, param_count, 0, borrowed_mask, reusable)
          reusable
        }
      }
    }
  }
}

-- Def-shape classes for the spill census (2v). Recorded at first-def
-- during the residents walk, consumed by the checker's ledger walk to
-- bucket slot tenancies by what defined them. Classes: 0 none (block
-- param — no inst def recorded), 1 call result, 2 small const / nil,
-- 3 large const, 4 field/ptr load, 5 variant tag/payload, 6 slot load,
-- 7 arith, 8 constructor, 9 frame address (AddressOfSlot — remat is a
-- single add off sp, no side table), 10 effect/handler op, 11 fp def,
-- 12 far address (FunctionRef / StringLit — remat needs an ADRP side
-- table; vector gets never spill in this corpus so the old class was
-- vacant), 13 zero-use variant extraction (rewritten from 5
-- post-walk), 14 other / zero-use jump block param (rewritten from 0
-- post-walk), 15 function never scanned (handler-bearing bail).
fn pipeline_ir_native_resident_def_shape(inst: IrInst, fpd: i64) -> i64 {
  match inst {
    IrVectorGetI64(vdst, vec, index, fallback, check_mode) -> 4
    _ -> {
      if fpd == 1 { 11 }
      else {
        match inst {
          IrCallI64(dst, callee_hash, args) -> 1
          IrIndirectCallI64(dst, callee, args) -> 1
          IrGenericCallI64(dst, callee_hash, tys, args) -> 1
          IrMethodCallI64(dst, recv, mhash, arity, args) -> 1
          IrConstI64(dst, cv) -> if cv >= 0 and cv <= 65535 { 2 } else { 3 }
          IrNilI64(dst) -> 2
          IrFieldLoadI64(dst, base, off, mask) -> 4
          IrRecordLayoutWordLoadI64(dst, base, record_data_size, field_hash, byte_offset) -> 4
          IrPtrLoadI64(dst, ptr) -> 4
          IrVariantTagI64(dst, src) -> 5
          IrVariantPayloadI64(dst, src, index) -> 5
          IrLoadI64(dst, slot) -> 6
          IrBinaryI64(dst, op, lhs, rhs) -> 7
          IrUnaryI64(dst, uop, src) -> 7
          IrFloatBinaryI64(dst, prim, op, lhs, rhs) -> 7
          IrVariantInitI64(dst, tag, payload, mask) -> 8
          IrRecordInitI64(dst, count, fields) -> 8
          IrRecordLayoutInitI64(dst, type_hash, data_size, align, fields) -> 8
          IrClosureI64(dst, f, captures, evidence) -> 8
          IrStringConcatI64(dst, lhs, rhs) -> 8
          IrAddressOfSlotI64(dst, slot) -> 9
          IrFunctionRefI64(dst, fhash) -> 12
          IrGenericFunctionRefI64(dst, fhash, type_args) -> 12
          -- A string literal ALLOCATES (bytes copy + (ptr,len) pair) —
          -- it is a constructor with identity, never an address remat.
          IrStringLit(dst, start, len) -> 8
          IrPerformI64(dst, eff, op_hash, args) -> 10
          IrHandlerDirectI64(dst, h1, h2, h3, h4, args) -> 10
          IrHandleI64(dst, handle_src, eff, clauses, nclauses, reserved) -> 10
          IrDeferredHandleI64(dst, handle_src, body, clauses, nclauses, eff, scratch_base) -> 10
          IrResumeI64(dst, v) -> 10
          IrAbortLandingI64(dst) -> 10
          IrBindI64(ns, nl, value, ty) -> 10
          _ -> 14
        }
      }
    }
  }
}

fn pipeline_ir_native_volatile_residents(param_count: i64, blocks: IrBlockList, raw_pinned: i64, fm: i64, f64_facts: PipelineIrNativeF64Facts, vector_data_facts: PipelineIrNativeVectorDataFacts) -> i64 {
  -- Split state is per-function; bail paths must not leak a previous
  -- function's map into this one's emission hooks. The def-shape map
  -- follows the same discipline: a bailed function leaves it 0 so the
  -- checker buckets its tenancies as class 15 (never scanned).
  fmap_set_current_split_map(fm, 0)
  fmap_set_current_split_actives(fm, 0)
  fmap_set_current_def_shapes(fm, 0)
  fmap_set_current_use_segs(fm, 0)
  fmap_set_current_naked_leaf(fm, 0)
  if pipeline_ir_native_blocks_have_handles(blocks) == 1 { raw_pinned }
  else {
    -- FP candidates can have any value id, so even bank-only functions
    -- (next_value <= 8) are scanned.
    let next_value = pipeline_ir_function_next_value(param_count, blocks)
    if next_value <= 0 { raw_pinned }
    else {
      let arrays = nlist_new()
      nlist_add(arrays, pipeline_ir_native_resident_dense_new(next_value, 0 - 1))
      nlist_add(arrays, pipeline_ir_native_resident_dense_new(next_value, 0 - 1))
      nlist_add(arrays, pipeline_ir_native_resident_dense_new(next_value, 0))
      nlist_add(arrays, pipeline_ir_native_resident_dense_new(next_value, 0 - 1))
      nlist_add(arrays, pipeline_ir_native_resident_dense_new(next_value, 1))
      nlist_add(arrays, pipeline_ir_native_resident_dense_new(next_value, 1))
      nlist_add(arrays, pipeline_ir_native_resident_dense_new(next_value, 1))
      nlist_add(arrays, pipeline_ir_native_resident_dense_new(next_value, 0))
      nlist_add(arrays, pipeline_ir_native_resident_dense_new(next_value, 0))
      nlist_add(arrays, pipeline_ir_native_resident_dense_new(next_value, 0))
      nlist_add(arrays, pipeline_ir_native_resident_dense_new(next_value, 0))
      nlist_add(arrays, pipeline_ir_native_resident_dense_new(next_value, 0))
      nlist_add(arrays, pipeline_ir_native_resident_dense_new(next_value, 0))
      nlist_add(arrays, pipeline_ir_native_resident_dense_new(next_value, 1))
      nlist_add(arrays, pipeline_ir_native_resident_dense_new(next_value, 0))
      nlist_add(arrays, pipeline_ir_native_resident_dense_new(next_value, 0))
      nlist_add(arrays, pipeline_ir_native_resident_dense_new(next_value, 0))
      nlist_add(arrays, pipeline_ir_native_resident_dense_new(next_value, 0))
      nlist_add(arrays, pipeline_ir_native_resident_dense_new(next_value, 0))
      nlist_add(arrays, pipeline_ir_native_resident_dense_new(next_value, 0))
      nlist_add(arrays, pipeline_ir_native_resident_dense_new(next_value, 0))
      nlist_add(arrays, pipeline_ir_native_resident_dense_new(next_value, 0))
      nlist_add(arrays, pipeline_ir_native_resident_dense_new(next_value, 0))
      nlist_add(arrays, pipeline_ir_native_resident_dense_new(next_value, 0 - 1))
      nlist_add(arrays, pipeline_ir_native_resident_dense_new(next_value, 0))
      nlist_add(arrays, pipeline_ir_native_resident_dense_new(next_value, 0))
      nlist_add(arrays, pipeline_ir_native_resident_dense_new(next_value, 0 - 1))
      nlist_add(arrays, pipeline_ir_native_resident_dense_new(next_value, 0))
      nlist_add(arrays, pipeline_ir_native_resident_dense_new(next_value, 0))
      nlist_add(arrays, pipeline_ir_native_resident_dense_new(next_value, 0))
      let def_pos = nlist_get(arrays, 0)
      let def_block = nlist_get(arrays, 1)
      let def_simple = nlist_get(arrays, 2)
      let last_use = nlist_get(arrays, 3)
      let use_local = nlist_get(arrays, 4)
      let use_gpr_ok = nlist_get(arrays, 5)
      let use_fp_ok = nlist_get(arrays, 6)
      let use_seen = nlist_get(arrays, 7)
      let slot_like = nlist_get(arrays, 8)
      let fp_def = nlist_get(arrays, 9)
      let weight = nlist_get(arrays, 10)
      let addr_taken = nlist_get(arrays, 11)
      let swap_excluded = nlist_get(arrays, 12)
      let use_cs_ok = nlist_get(arrays, 13)
      let use_last_kind = nlist_get(arrays, 14)
      let use_last_pre_barrier = nlist_get(arrays, 15)
      let use_nonfinal_unsafe = nlist_get(arrays, 16)
      let def_discard_safe = nlist_get(arrays, 17)
      let use_count = nlist_get(arrays, 18)
      let def_const_kind = nlist_get(arrays, 19)
      let def_const_val = nlist_get(arrays, 20)
      let def_segment_uses = nlist_get(arrays, 21)
      let def_barrier = nlist_get(arrays, 22)
      let def_segment_last_use = nlist_get(arrays, 23)
      let use_last_fwd = nlist_get(arrays, 24)
      let def_x17_simple = nlist_get(arrays, 25)
      let use_last_call_arity = nlist_get(arrays, 28)
      let redefined = nlist_get(arrays, 29)
      let def_shapes = pipeline_ir_native_resident_dense_new(next_value, 0)
      fmap_set_current_def_shapes(fm, def_shapes)
      fmap_set_current_use_segs(fm, nlist_get(arrays, 27))
      let region_bundle = pipeline_ir_native_resident_regions(blocks)
      let region_of = node_f1(region_bundle)
      let layout_pos = node_f2(region_bundle)
      let block_count = node_f3(region_bundle)
      let depth_of = pipeline_ir_native_resident_depths(blocks, layout_pos, block_count)
      -- Block-param residency (2o step 1): params are defs at block entry;
      -- their windows extend over every incoming jump edge (a loop header's
      -- effective window is the whole loop), the barrier check runs over
      -- the extended window, and selection bypasses use_local. The writer
      -- gpos lists exist only under the emission audit.
      let audit_armed = if fmap_audit_ranges(fm) != 0 { 1 } else { 0 }
      -- Backedges (target-entry gpos, terminator gpos) for loop rounding:
      -- a layout interval only models a live range if it covers every loop
      -- body that executes between uses. Block-entry gpos is recorded on
      -- the fly; backedge targets are resolved after the walk.
      let entry_gpos_size = pipeline_ir_native_resident_max_block_id(blocks) + 1
      let block_entry_gpos = pipeline_ir_native_resident_dense_new(entry_gpos_size, 0 - 1)
      let backedge_terms = nlist_new()
      let param_entry = pipeline_ir_native_resident_dense_new(next_value, 0 - 1)
      let param_lo = pipeline_ir_native_resident_dense_new(next_value, 0 - 1)
      let param_hi = pipeline_ir_native_resident_dense_new(next_value, 0 - 1)
      let param_writer_count = pipeline_ir_native_resident_dense_new(next_value, 0)
      let param_writers = pipeline_ir_native_resident_dense_new(next_value, 0)
      let barrier_at = nlist_new()
      let barrier_fp_at = nlist_new()
      let barrier_fp_cs_at = nlist_new()
      let mut gpos = 0
      let mut barrier_cum = 0
      let mut barrier_fp_cum = 0
      let mut barrier_fp_cs_cum = 0
      let mut soft_barrier_cum = 0
      let mut saw_slot_inst = 0
      let mut cur_blocks = blocks
      let mut blocks_done = 0
      while blocks_done == 0 {
        match cur_blocks {
          IrBlockListNil -> { blocks_done = 1 }
          IrBlockListCons(block, rest_blocks) -> {
            match block {
              IrBlock(raw_block_id, params, insts, term) -> {
                let block_id = nlist_get(region_of, raw_block_id)
                let block_w = pipeline_ir_native_resident_weight_for_depth(nlist_get(depth_of, nlist_get(layout_pos, raw_block_id)))
                if raw_block_id >= 0 and raw_block_id < entry_gpos_size { pipeline_ir_native_resident_dense_set(block_entry_gpos, raw_block_id, gpos) } else { 0 }
                let mut p_cur = params
                let mut p_done = 0
                while p_done == 0 {
                  match p_cur {
                    IrValueNil -> { p_done = 1 }
                    IrValueCons(p, p_rest) -> {
                      if p >= 0 and p < next_value {
                        pipeline_ir_native_resident_dense_set(param_entry, p, gpos)
                        if nlist_get(param_lo, p) < 0 { pipeline_ir_native_resident_dense_set(param_lo, p, gpos) } else { 0 }
                        if nlist_get(param_hi, p) < gpos { pipeline_ir_native_resident_dense_set(param_hi, p, gpos) } else { 0 }
                        0
                      } else { 0 }
                      p_cur = p_rest
                    }
                  }
                }
                let mut cur = insts
                let mut done = 0
                while done == 0 {
                  match cur {
                    IrInstNil -> { done = 1 }
                    IrInstCons(inst, tail) -> {
                      let simple = pipeline_ir_native_resident_inst_simple(inst)
                      match inst {
                        IrSlotI64(slot_decl) -> { saw_slot_inst = 1 0 }
                        IrLoadI64(sl_dst, sl_slot) -> { saw_slot_inst = 1 0 }
                        IrStoreI64(sl_slot2, sl_val) -> { saw_slot_inst = 1 0 }
                        _ -> 0
                      }
                      let fp_simple = pipeline_ir_native_resident_inst_fp_simple(inst)
                      let fp_cs_simple = pipeline_ir_native_resident_inst_fp_cs_simple(inst)
                      let barrier_pre = barrier_cum
                      let call_safe = if simple == 1 { 0 } else { pipeline_ir_native_resident_inst_call_read_safe(inst) }
                      let fwd_use = match inst {
                        IrBinaryI64(fdst, fop, flhs, frhs) -> 1
                        _ -> 0
                      }
                      if simple == 0 {
                        barrier_cum = barrier_cum + 1
                        -- Soft-barrier census (2v Stage 2 C0; re-scoped
                        -- by the C1 simple-flip): pool-transparent kinds
                        -- no longer reach here at all. The remaining
                        -- "soft" barriers are mask-finite but
                        -- pool-clobbering intrinsics (2/3/8/12, 35-44) —
                        -- the sizing input for the colorer's
                        -- mask-refined interference, which can keep
                        -- values in registers the mask misses.
                        let soft = match inst {
                          IrCallI64(cdst, chash, cargs) -> {
                            let ck = pipeline_ir_native_intrinsic_kind(chash)
                            if ck != 0 and pipeline_ir_native_intrinsic_clobber_mask(ck) != 0 - 1 { 1 } else { 0 }
                          }
                          _ -> 0
                        }
                        if soft == 1 {
                          fmap_add_soft_barrier_counter(fm, 0, 1)
                          soft_barrier_cum = soft_barrier_cum + 1
                          0
                        } else {
                          fmap_add_soft_barrier_counter(fm, 1, 1)
                        }
                        0
                      } else { 0 }
                      if fp_simple == 0 { barrier_fp_cum = barrier_fp_cum + 1 } else { 0 }
                      if fp_cs_simple == 0 { barrier_fp_cs_cum = barrier_fp_cs_cum + 1 } else { 0 }
                      nlist_add(barrier_at, barrier_cum)
                      nlist_add(barrier_fp_at, barrier_fp_cum)
                      nlist_add(barrier_fp_cs_at, barrier_fp_cs_cum)
                      let d = pipeline_ir_inst_def_or(inst, 0 - 1)
                      if d >= 0 and d < next_value {
                        if nlist_get(def_pos, d) >= 0 {
                          pipeline_ir_native_resident_dense_set(use_local, d, 0)
                          pipeline_ir_native_resident_dense_set(redefined, d, 1)
                        } else {
                          let def_class = if simple == 1 { 1 } else { pipeline_ir_native_resident_inst_call_def(inst) }
                          pipeline_ir_native_resident_dense_set(def_pos, d, gpos)
                          pipeline_ir_native_resident_dense_set(def_block, d, block_id)
                          pipeline_ir_native_resident_dense_set(def_simple, d, def_class)
                          pipeline_ir_native_resident_dense_set(def_discard_safe, d, pipeline_ir_native_resident_inst_dead_store_safe(inst))
                          pipeline_ir_native_resident_dense_set(def_barrier, d, barrier_cum)
                          pipeline_ir_native_resident_dense_set(def_x17_simple, d, simple)
                          match inst {
                            IrConstI64(cd, cv) -> {
                              let ckind = if cv >= 0 and cv <= 65535 { 1 } else { if cv >= 0 - 65536 and cv <= 0 - 1 { 3 } else { 2 } }
                              pipeline_ir_native_resident_dense_set(def_const_kind, d, ckind)
                              pipeline_ir_native_resident_dense_set(def_const_val, d, cv)
                            }
                            _ -> 0
                          }
                          pipeline_ir_native_resident_dense_set(fp_def, d, pipeline_ir_native_resident_inst_fp_def(inst, f64_facts))
                          pipeline_ir_native_resident_dense_set(def_shapes, d, pipeline_ir_native_resident_def_shape(inst, nlist_get(fp_def, d)))
                        }
                        pipeline_ir_native_resident_dense_set(weight, d, nlist_get(weight, d) + block_w)
                      } else { 0 }
                      pipeline_ir_native_resident_mark_slot_like(inst, slot_like, addr_taken, next_value)
                      if pipeline_ir_native_inst_is_lambda(inst) == 1 {
                        -- Lambda closure/env materialisation scratches dst
                        -- and dst+1 through identity-home helpers: both ids
                        -- keep their identity homes.
                        let ld = pipeline_ir_inst_def_or(inst, 0 - 1)
                        if ld >= 0 and ld < next_value { pipeline_ir_native_resident_dense_set(swap_excluded, ld, 1) } else { 0 }
                        if ld >= 0 and ld + 1 < next_value { pipeline_ir_native_resident_dense_set(swap_excluded, ld + 1, 1) } else { 0 }
                      } else { 0 }
                      let fp_allowed = pipeline_ir_native_resident_inst_fp_use_allowed(inst, f64_facts)
                      let cs_safe = if simple == 1 { 1 } else { pipeline_ir_native_resident_inst_cs_use_safe(inst) }
                      -- Staged-register count of a call shape:
                      -- move_call_args writes x0..arity-1 (method calls
                      -- stage the receiver first). Call-window seats
                      -- must sit at or above this for the FINAL use.
                      let call_arity = match inst {
                        IrCallI64(cad, cah, caargs) -> ir_value_list_len(caargs)
                        IrIndirectCallI64(cad, cac, caargs) -> ir_value_list_len(caargs)
                        IrMethodCallI64(cad, cath, camh, carecv, caargs) -> ir_value_list_len(caargs) + 1
                        IrGenericCallI64(cad, cah, cata, caargs) -> ir_value_list_len(caargs)
                        _ -> 0
                      }
                      let uses = pipeline_ir_live_set_add_inst_uses(inst, pipeline_ir_live_set_empty())
                      pipeline_ir_native_resident_record_use_set(uses, gpos, block_id, simple, fp_allowed, cs_safe, call_safe, fwd_use, barrier_pre, next_value, arrays, block_w, call_arity)
                      gpos = gpos + 1
                      cur = tail
                    }
                  }
                }
                nlist_add(barrier_at, barrier_cum)
                nlist_add(barrier_fp_at, barrier_fp_cum)
                nlist_add(barrier_fp_cs_at, barrier_fp_cs_cum)
                let term_uses = pipeline_ir_native_resident_term_uses(term)
                pipeline_ir_native_resident_record_use_set(term_uses, gpos, block_id, 1, 0, 1, 0, 0, barrier_cum, next_value, arrays, block_w, 0)
                match term {
                  IrTermJump(jt2, ja2) -> { nlist_add(backedge_terms, node_new(0, jt2, gpos, 0, 0)) 0 }
                  IrTermBranch(bc2, bt2, be2) -> {
                    nlist_add(backedge_terms, node_new(0, bt2, gpos, 0, 0))
                    nlist_add(backedge_terms, node_new(0, be2, gpos, 0, 0))
                    0
                  }
                  _ -> 0
                }
                match term {
                  IrTermJump(jump_target, jump_args) -> {
                    let tparams = pipeline_ir_native_block_params_or(blocks, jump_target, ir_value_list_empty())
                    let mut tp_cur = tparams
                    let mut tp_done = 0
                    while tp_done == 0 {
                      match tp_cur {
                        IrValueNil -> { tp_done = 1 }
                        IrValueCons(tp, tp_rest) -> {
                          if tp >= 0 and tp < next_value {
                            if nlist_get(param_lo, tp) < 0 { pipeline_ir_native_resident_dense_set(param_lo, tp, gpos) }
                            else { if gpos < nlist_get(param_lo, tp) { pipeline_ir_native_resident_dense_set(param_lo, tp, gpos) } else { 0 } }
                            if nlist_get(param_hi, tp) < gpos { pipeline_ir_native_resident_dense_set(param_hi, tp, gpos) } else { 0 }
                            pipeline_ir_native_resident_dense_set(param_writer_count, tp, nlist_get(param_writer_count, tp) + 1)
                            if audit_armed == 1 {
                              if nlist_get(param_writers, tp) == 0 { pipeline_ir_native_resident_dense_set(param_writers, tp, nlist_new()) } else { 0 }
                              nlist_add(nlist_get(param_writers, tp), gpos)
                              0
                            } else { 0 }
                          } else { 0 }
                          tp_cur = tp_rest
                        }
                      }
                    }
                    0
                  }
                  _ -> 0
                }
                gpos = gpos + 1
                cur_blocks = rest_blocks
              }
            }
          }
        }
      }
      if fmap_audit_ranges(fm) != 0 { fmap_set_audit_expected_gpos(fm, gpos) } else { 0 }
      -- Soft-barrier census, fn-level: every barrier in this walk was a
      -- mask-finite (pool-clobbering) intrinsic — under mask-refined
      -- interference this function is straight-line for the registers
      -- its masks miss.
      if barrier_cum > 0 and soft_barrier_cum == barrier_cum {
        fmap_add_soft_barrier_counter(fm, 2, 1)
        0
      } else { 0 }
      -- Census refinement: a variant extraction whose value has no uses
      -- anywhere is a pure dead store (class 13); class 5 keeps the
      -- extractions whose uses were all load-free at the ledger. A jump
      -- block param with writers but no uses is class 14 (its edge
      -- stores are pure dead stores). use_seen is final once the walk
      -- completes.
      for sv in 0..next_value {
        if nlist_get(def_shapes, sv) == 5 and nlist_get(use_seen, sv) == 0 {
          pipeline_ir_native_resident_dense_set(def_shapes, sv, 13)
        } else {
          if nlist_get(def_shapes, sv) == 0 and nlist_get(use_seen, sv) == 0 and nlist_get(param_writer_count, sv) > 0 {
            pipeline_ir_native_resident_dense_set(def_shapes, sv, 14)
          } else { 0 }
        }
      }
      let mut pinned = raw_pinned
      -- Volatile GPR pool membership: x8/x10/x11 join only when the
      -- slot-pin pass (whose bank is x8/x10/x11, function-wide) has not
      -- claimed them, x9 only when no vector lane access needs its data
      -- pointer cache. Every OTHER writer of x1-x14 in emission
      -- (perform, fiber intrinsics, content-eq, vector push, bump
      -- allocation, mem copies, call arg staging — the C1b re-scratch
      -- moved the other bespoke arms to x15/x16/x17) is a non-simple
      -- instruction and therefore already a window barrier; the audit's
      -- per-register write decoding is pool-agnostic and caught the
      -- original unconditional x8 grab. An assigned cache fact owns x9;
      -- an empty fact set leaves it in the scalar pool.
      let mut x8_taken = 0
      let mut x10_taken = 0
      let mut x11_taken = 0
      let mut pin_scan = raw_pinned
      while pin_scan != 0 {
        if node_f1(pin_scan) != pipeline_ir_native_forward_marker() {
          if node_f2(pin_scan) == 8 { x8_taken = 1 } else { 0 }
          if node_f2(pin_scan) == 10 { x10_taken = 1 } else { 0 }
          if node_f2(pin_scan) == 11 { x11_taken = 1 } else { 0 }
        } else { 0 }
        pin_scan = node_f3(pin_scan)
      }
      -- 2v Stage 1: full caller-saved pool, in three segments.
      --   [0, class2_lo)          x1-x7: barrier-free windows only — call
      --                           arg staging writes x0-x7 ascending, so a
      --                           call-final window may not live here.
      --   [class2_lo, class2_hi)  x12-x14 + unclaimed x8/x10/x11: hosts
      --                           both barrier-free windows and call-final
      --                           windows (a whitelisted call shape writes
      --                           only x0..arity-1 before its BL/BLR; the
      --                           per-seat arity guard keeps tenants above
      --                           that).
      --   [class2_hi, pool_n)     x9 when no vector lane access claims the
      --                           data-pointer cache: barrier-free only —
      --                           indirect calls stage the closure code
      --                           pointer through x9 before the BLR.
      -- x0 is unusable (0 is the pinned-map "unassigned" sentinel); x15,
      -- x16, x17 are emitter scratch (mod temp, spill staging, forwarding).
      let pool_regs = nlist_new()
      nlist_add(pool_regs, 1)
      nlist_add(pool_regs, 2)
      nlist_add(pool_regs, 3)
      nlist_add(pool_regs, 4)
      nlist_add(pool_regs, 5)
      nlist_add(pool_regs, 6)
      nlist_add(pool_regs, 7)
      let class2_lo = nlist_len(pool_regs)
      nlist_add(pool_regs, 12)
      nlist_add(pool_regs, 13)
      nlist_add(pool_regs, 14)
      if x8_taken == 0 { nlist_add(pool_regs, 8) } else { 0 }
      if x10_taken == 0 { nlist_add(pool_regs, 10) } else { 0 }
      if x11_taken == 0 { nlist_add(pool_regs, 11) } else { 0 }
      let class2_hi = nlist_len(pool_regs)
      if pipeline_ir_native_vector_data_facts_home(vector_data_facts) != 9 { nlist_add(pool_regs, 9) } else { 0 }
      let pool_n = nlist_len(pool_regs)
      -- 2v Stage 2 C3 — per-register occupancy as INTERVAL SETS
      -- (node(lo, hi) lists), replacing the single-expiry scalar +
      -- first-start pair: weight-ordered seating places windows in
      -- arbitrary start order, and cross-block/param windows may
      -- legally sandwich between existing tenants. A candidate seats
      -- in the first allowed register whose interval set has no
      -- overlap with its occupancy window; the split pass shares the
      -- same sets, so leftover capacity stays exact.
      let pool_ivs = nlist_new()
      let mut piv0 = 0
      while piv0 < pool_n {
        nlist_add(pool_ivs, nlist_new())
        piv0 = piv0 + 1
      }
      -- The bulk classes (barrier-free local + call-final local, ~95%
      -- of all seats) STILL seat greedily in ascending def order
      -- against the scalar expiry — a full weight-ordered interval
      -- pass over them measured +1.3% self-compile wall-clock (the
      -- selection sort plus per-candidate interval scans) for ~zero
      -- code-quality return. Each greedy seat also records its
      -- interval so the leftover classes and the split pass see exact
      -- occupancy.
      let pool_busy = pipeline_ir_native_resident_dense_new(pool_n, 0 - 1)
      let mut assigned = 0
      let mut call_window_assigned = 0
      let mut low_pool_assigned = 0
      let mut dead_store_elided = 0
      let fp_busy = pipeline_ir_native_resident_dense_new(6, 0 - 1)
      -- Free callee-saved FP capacity: assigned slot facts own
      -- d8..d8+count-1; the rest of d8-d15 is free whenever preserve_fp is
      -- already paid for those homes.
      let cs_base = 8 + pipeline_ir_native_f64_slot_home_count(f64_facts)
      let cs_pool = 16 - cs_base
      let cs_busy = pipeline_ir_native_resident_dense_new(8, 0 - 1)
      let mut fp_assigned = 0
      -- GPR candidates need v >= 8 (lower ids already live in the value
      -- bank); FP candidates take any defined value — f64 data in a bank
      -- GPR still pays the fmov round-trip on every use. Block params are
      -- selected through the param window path below, which bypasses
      -- use_local by design.
      -- 2v Stage 2 S0 — fn-param pool admission: a function parameter
      -- whose rounded window is barrier-free (or whose FINAL use is a
      -- pinned-aware call with simple earlier uses) lives in a
      -- caller-saved seat; its x19+ bank home then goes unclaimed and
      -- the tail-dead prefix shrink deletes the pair. This is the RC
      -- fast-path lever: post-C1 those bodies are pool-straight-line
      -- with one true barrier (the cold-path BL), which is exactly the
      -- call-final shape. Gated off for fns the whole-value naked path
      -- will pin (double-entry hazard), fiber fns (parity with every
      -- other placement pass), handle carriers (clause bodies renumber
      -- values under their own scratch), and entry-cleanup fns
      -- (descriptors key on identity homes). Lambda-capturing params
      -- self-exclude: closure capture reads clear use_gpr_ok and set
      -- use_nonfinal_unsafe at the closure site.
      let param_cleanup_fn = pipeline_ir_native_blocks_entry_params_need_cleanup(blocks, param_count)
      let naked_candidate = if barrier_cum == 0 and next_value <= 8 and saw_slot_inst == 0 and pipeline_ir_native_f64_slot_home_count(f64_facts) == 0 and pipeline_ir_native_max_block_param_count(blocks, 0) == 0 and param_cleanup_fn == 0 { 1 } else { 0 }
      -- Lambda-containing functions keep identity bank homes (the
      -- documented closure-emission contract: env materialisation reads
      -- low-id values through direct identity-home helpers beyond the
      -- dst/dst+1 reservation — found as a C2 miscompile specimen:
      -- weft-test harness counts corrupted in lambda fns). Both the
      -- param classes and the low-value floor honor it.
      let param_admit = if naked_candidate == 0 and param_cleanup_fn == 0 and pipeline_ir_native_blocks_use_fiber_intrinsics(blocks) == 0 and pipeline_ir_native_blocks_have_handles(blocks) == 0 and pipeline_ir_native_blocks_have_lambdas(blocks) == 0 { 1 } else { 0 }
      -- C3: the leftover-capacity classes collect into ONE candidate
      -- list and seat after the scan in descending static benefit — S0
      -- measured params-first displacement as +1.5k scalar loads (a
      -- one-use param displacing a five-load value), so no class here
      -- may pre-empt the greedy bulk, but among THEMSELVES the heavy
      -- window deserves the seat. Nodes are node(class, v, occ_lo,
      -- occ_hi): class 1 barrier-free cross-block window (occupancy
      -- rounded over enclosing-loop backedges), 3 block param, 4 fn
      -- param whole-window, 5 fn param call-final, 6 call-final
      -- cross-block window.
      let pool_cands = nlist_new()
      let mut v = 0
      while v < next_value {
        let dp = nlist_get(def_pos, v)
        let base_ok = if dp >= 0 and nlist_get(use_local, v) == 1 and nlist_get(use_seen, v) == 1 and nlist_get(slot_like, v) == 0 { 1 } else { 0 }
        -- Stage 2 C2 — low-value pool admission: non-param values below
        -- 8 default to x19-x26 bank homes, and each bank claim costs a
        -- saved pair in the prologue (the census's 21.7% pair-restore
        -- mass). Under the same safety gate as fn params (no naked
        -- candidate, no cleanup descriptors, no fiber, no handles),
        -- their ordinary defs qualify for the SAME pool classes as
        -- v >= 8 values — the def writes the seat through
        -- store_reg_pinned, reads are pinned-map loads, lambda captures
        -- self-exclude through use_gpr_ok, and the tail-dead prefix
        -- shrink deletes the freed pairs. This is what empties the RC
        -- fast paths' banks.
        let pool_floor = if param_admit == 1 { param_count } else { 8 }
        let eligible = if v >= pool_floor and base_ok == 1 and nlist_get(def_simple, v) == 1 and nlist_get(use_gpr_ok, v) == 1 and nlist_get(swap_excluded, v) == 0 {
          if nlist_get(barrier_at, nlist_get(last_use, v)) == nlist_get(barrier_at, dp) { 1 } else { 0 }
        } else { 0 }
        -- Call-window tenancy (2v Stage 1): the value's FINAL use is a
        -- pinned-aware call — its operand reads stage before the BL/BLR
        -- clobbers the caller-saved file, so the window [def, call) only
        -- needs to be barrier-free STRICTLY BEFORE the call. Every earlier
        -- use must be simple (a non-final call use would consume a
        -- clobbered register). Disjoint from `eligible`: a call-shaped
        -- last use always clears use_gpr_ok.
        let call_lu_eligible = if v >= pool_floor and base_ok == 1 and nlist_get(def_simple, v) == 1 and nlist_get(fp_def, v) == 0 and nlist_get(use_nonfinal_unsafe, v) == 0 and nlist_get(use_last_kind, v) == 1 and nlist_get(swap_excluded, v) == 0 {
          if nlist_get(use_last_pre_barrier, v) == nlist_get(barrier_at, dp) { 1 } else { 0 }
        } else { 0 }
        -- Cross-block admission (2v Stage 2 C3): every def and use of
        -- these values already routes through the pinned-aware paths
        -- (the cs home-reuse pass hosts the same shapes in x19-x26),
        -- so a caller-saved seat is sound exactly when the OCCUPANCY
        -- window — [def, last_use] rounded bidirectionally over
        -- enclosing-loop backedges — contains no barrier at all. The
        -- comparison anchors one inst BEFORE the rounded lo:
        -- barrier_at[g] includes g's own inst, and a rounded-back lo
        -- may itself sit on a barrier that executes inside the loop.
        -- Redefined values are excluded (use_local conflates them with
        -- cross-block use; a trailing dead redefinition would write a
        -- shared seat outside the occupancy window), as are values
        -- with jump-edge writers (same out-of-window write hazard).
        let cross_base = if v >= pool_floor and dp >= 0 and nlist_get(use_local, v) == 0 and nlist_get(redefined, v) == 0 and nlist_get(param_writer_count, v) == 0 and nlist_get(param_entry, v) < 0 and nlist_get(use_seen, v) == 1 and nlist_get(last_use, v) > dp and nlist_get(slot_like, v) == 0 and nlist_get(addr_taken, v) == 0 and nlist_get(fp_def, v) == 0 and nlist_get(def_simple, v) == 1 and nlist_get(swap_excluded, v) == 0 and pipeline_ir_native_pinned_slot_lookup(pinned, v) == 0 and pipeline_ir_native_f64_slot_home_lookup(f64_facts, v) < 0 { 1 } else { 0 }
        let cross_w = if cross_base == 1 and nlist_get(use_gpr_ok, v) == 1 {
          pipeline_ir_native_cs_round_window(backedge_terms, block_entry_gpos, entry_gpos_size, dp, nlist_get(last_use, v))
        } else { 0 }
        let cross_eligible = if cross_w != 0 {
          let crlo = node_f1(cross_w)
          let crpre = if crlo > 0 { nlist_get(barrier_at, crlo - 1) } else { 0 }
          if nlist_get(barrier_at, node_f2(cross_w)) == crpre { 1 } else { 0 }
        } else { 0 }
        -- Cross-block call-final: mirrors the local class — zero
        -- barriers strictly before the final call — and additionally
        -- requires rounding to leave the window exactly [def, call]:
        -- an enclosing loop would re-read the seat after the BL
        -- clobbered it, and a pulled-back lo means the window is
        -- dynamically re-entered.
        let cross_call_base = if cross_base == 1 and nlist_get(use_gpr_ok, v) == 0 and nlist_get(use_nonfinal_unsafe, v) == 0 and nlist_get(use_last_kind, v) == 1 {
          if nlist_get(use_last_pre_barrier, v) == nlist_get(barrier_at, dp) { 1 } else { 0 }
        } else { 0 }
        let cross_call_eligible = if cross_call_base == 1 {
          let ccw = pipeline_ir_native_cs_round_window(backedge_terms, block_entry_gpos, entry_gpos_size, dp, nlist_get(last_use, v))
          if node_f1(ccw) == dp and node_f2(ccw) == nlist_get(last_use, v) { 1 } else { 0 }
        } else { 0 }
        -- Block-param tenancy: window = [earliest writer/entry, latest of
        -- last use and latest writer], rounded out to enclosing loops,
        -- barrier-free across the whole span.
        let param_base_ok = if v >= 8 and dp < 0 and nlist_get(param_entry, v) >= 0 and nlist_get(param_writer_count, v) > 0 and nlist_get(use_seen, v) == 1 and nlist_get(slot_like, v) == 0 and nlist_get(addr_taken, v) == 0 and nlist_get(use_gpr_ok, v) == 1 and nlist_get(fp_def, v) == 0 { 1 } else { 0 }
        let param_hi_uses = if nlist_get(param_hi, v) > nlist_get(last_use, v) { nlist_get(param_hi, v) } else { nlist_get(last_use, v) }
        let param_hi_ext = if param_base_ok == 1 {
          pipeline_ir_native_param_round_hi(backedge_terms, block_entry_gpos, entry_gpos_size, nlist_get(param_lo, v), param_hi_uses)
        } else { 0 - 1 }
        let param_eligible = if param_base_ok == 1 {
          if nlist_get(barrier_at, param_hi_ext) == nlist_get(barrier_at, nlist_get(param_lo, v)) { 1 } else { 0 }
        } else { 0 }
        -- Fn-param admission (S0): fn params are NOT entry-block params
        -- in the IR (entry param lists are empty; values 0..pc-1 exist
        -- implicitly), so the window anchors at gpos 0 — function
        -- entry, zero barriers before it. The whole-window class needs
        -- the rounded window to contain NO barrier at all
        -- (barrier_at[hi] == 0 — barrier_at[g] INCLUDES g's own inst,
        -- so an anchored-at-entry window must compare against zero,
        -- not against barrier_at[lo]) and every use pinned-map-read
        -- (use_gpr_ok). The call-final class mirrors call_lu_eligible:
        -- call-read-safe LAST use, simple earlier uses, zero barriers
        -- strictly before the call, and rounding must leave hi AT the
        -- call — an enclosing loop would re-read the seat after the BL
        -- clobbered it.
        let fnp_base_ok = if param_admit == 1 and v < param_count and dp < 0 and nlist_get(param_writer_count, v) == 0 and nlist_get(use_seen, v) == 1 and nlist_get(slot_like, v) == 0 and nlist_get(addr_taken, v) == 0 and nlist_get(fp_def, v) == 0 and nlist_get(swap_excluded, v) == 0 { 1 } else { 0 }
        let fnp_hi_ext = if fnp_base_ok == 1 {
          pipeline_ir_native_param_round_hi(backedge_terms, block_entry_gpos, entry_gpos_size, 0, nlist_get(last_use, v))
        } else { 0 - 1 }
        let fnp_eligible = if fnp_base_ok == 1 and nlist_get(use_gpr_ok, v) == 1 {
          if nlist_get(barrier_at, fnp_hi_ext) == 0 { 1 } else { 0 }
        } else { 0 }
        let fnp_call_eligible = if fnp_eligible == 0 and fnp_base_ok == 1 and nlist_get(use_nonfinal_unsafe, v) == 0 and nlist_get(use_last_kind, v) == 1 and fnp_hi_ext == nlist_get(last_use, v) {
          if nlist_get(use_last_pre_barrier, v) == 0 { 1 } else { 0 }
        } else { 0 }
        let fp_eligible = if base_ok == 1 and nlist_get(fp_def, v) == 1 and nlist_get(use_fp_ok, v) == 1 {
          if nlist_get(barrier_fp_at, nlist_get(last_use, v)) == nlist_get(barrier_fp_at, dp) { 1 } else { 0 }
        } else { 0 }
        let fp_cs_eligible = if cs_pool > 0 and base_ok == 1 and nlist_get(fp_def, v) == 1 and nlist_get(use_fp_ok, v) == 1 {
          if nlist_get(barrier_fp_cs_at, nlist_get(last_use, v)) == nlist_get(barrier_fp_cs_at, dp) { 1 } else { 0 }
        } else { 0 }
        if eligible == 1 {
          let lu = nlist_get(last_use, v)
          let mut pr = 0
          let mut pool_placed = 0
          while pr < pool_n and pool_placed == 0 {
            if dp > nlist_get(pool_busy, pr) {
              pinned = pipeline_ir_native_pinned_slot_new(v, nlist_get(pool_regs, pr), pipeline_ir_native_pinned_slot_kind_resident(), pinned)
              pipeline_ir_native_resident_dense_set(pool_busy, pr, lu)
              nlist_add(nlist_get(pool_ivs, pr), node_new(0, dp, lu, 0, 0))
              assigned = assigned + 1
              if nlist_get(pool_regs, pr) <= 7 { low_pool_assigned = low_pool_assigned + 1 } else { 0 }
              pipeline_ir_native_audit_note_range(fm, v, nlist_get(pool_regs, pr), dp, lu)
              pool_placed = 1
            } else { pr = pr + 1 }
          }
          0
        } else {
          let lu = nlist_get(last_use, v)
          let mut placed = 0
          if fp_eligible == 1 {
            let mut r = 0
            while r < 6 and placed == 0 {
              if dp > nlist_get(fp_busy, r) {
                pinned = pipeline_ir_native_pinned_slot_new(v, 1002 + r, pipeline_ir_native_pinned_slot_kind_resident(), pinned)
                pipeline_ir_native_resident_dense_set(fp_busy, r, lu)
                fp_assigned = fp_assigned + 1
                placed = 1
                pipeline_ir_native_audit_note_range(fm, v, 1002 + r, dp, lu)
              } else { r = r + 1 }
            }
          } else { 0 }
          if placed == 0 and fp_cs_eligible == 1 {
            let mut r = 0
            while r < cs_pool and placed == 0 {
              if dp > nlist_get(cs_busy, r) {
                pinned = pipeline_ir_native_pinned_slot_new(v, 1000 + cs_base + r, pipeline_ir_native_pinned_slot_kind_resident(), pinned)
                pipeline_ir_native_resident_dense_set(cs_busy, r, lu)
                fp_assigned = fp_assigned + 1
                placed = 1
                pipeline_ir_native_audit_note_range(fm, v, 1000 + cs_base + r, dp, lu)
              } else { r = r + 1 }
            }
          } else { 0 }
          0
        }
        if call_lu_eligible == 1 {
          let clu = nlist_get(last_use, v)
          let mut cpr = class2_lo
          let mut call_placed = 0
          while cpr < class2_hi and call_placed == 0 {
            -- Arity guard (2v S0 fix of a latent Stage 1 hole):
            -- move_call_args writes x0..arity-1, not just x0-x7, so a
            -- class-2 seat below the final call's staged-register
            -- count is clobbered by a lower argument's staging before
            -- this value's own read. Neither the audit (staging bytes
            -- sit inside the call, past the [dp, lu-1] window) nor the
            -- checker (pre-S0 pool pressure never seated x8 under a
            -- 9+-arg call) had ever seen it fire.
            if nlist_get(pool_regs, cpr) >= nlist_get(use_last_call_arity, v) and dp > nlist_get(pool_busy, cpr) {
              pinned = pipeline_ir_native_pinned_slot_new(v, nlist_get(pool_regs, cpr), pipeline_ir_native_pinned_slot_kind_resident(), pinned)
              pipeline_ir_native_resident_dense_set(pool_busy, cpr, clu)
              nlist_add(nlist_get(pool_ivs, cpr), node_new(0, dp, clu, 0, 0))
              assigned = assigned + 1
              call_window_assigned = call_window_assigned + 1
              -- The audited window stops one gpos short of the call: the
              -- write-window audit treats a BL's caller-saved clobber as
              -- foreign, while the checker's exact-offset READ events
              -- verify the staging reads inside the call's byte range.
              pipeline_ir_native_audit_note_range(fm, v, nlist_get(pool_regs, cpr), dp, clu - 1)
              call_placed = 1
            } else { cpr = cpr + 1 }
          }
          0
        } else { 0 }
        if cross_eligible == 1 { nlist_add(pool_cands, node_new(1, v, node_f1(cross_w), node_f2(cross_w), 0)) } else { 0 }
        if cross_call_eligible == 1 { nlist_add(pool_cands, node_new(6, v, dp, nlist_get(last_use, v), 0)) } else { 0 }
        -- Dead spill-store deletion (2v Stage 2): an effectful
        -- call-shaped def whose result has NO uses anywhere (IR DCE
        -- already deleted the dead PURE defs) keeps its call but loses
        -- the result store. Every read path traps on the discard home,
        -- so a use-analysis miss fails loud, not silent.
        if v >= 8 and dp >= 0 and nlist_get(use_seen, v) == 0 and nlist_get(def_discard_safe, v) == 1 and nlist_get(slot_like, v) == 0 and nlist_get(addr_taken, v) == 0 and nlist_get(swap_excluded, v) == 0 and pipeline_ir_native_pinned_slot_lookup(pinned, v) == 0 and pipeline_ir_native_f64_slot_home_lookup(f64_facts, v) < 0 {
          pinned = pipeline_ir_native_pinned_slot_new(v, pipeline_ir_native_discard_home(), pipeline_ir_native_pinned_slot_kind_resident(), pinned)
          dead_store_elided = dead_store_elided + 1
        } else { 0 }
        if param_eligible == 1 { nlist_add(pool_cands, node_new(3, v, nlist_get(param_lo, v), param_hi_ext, 0)) } else { 0 }
        if fnp_eligible == 1 { nlist_add(pool_cands, node_new(4, v, 0, fnp_hi_ext, 0)) } else { 0 }
        if fnp_call_eligible == 1 { nlist_add(pool_cands, node_new(5, v, 0, nlist_get(last_use, v), 0)) } else { 0 }
        v = v + 1
      }
      -- Weight-ordered interval seating (C3): the leftover classes
      -- seat together in descending static benefit (use_count reloads
      -- + writes — one def store, or one edge store per incoming
      -- writer for block params), ties by ascending window start then
      -- value id for determinism. A candidate takes the first allowed
      -- register whose interval set has no overlap with its occupancy
      -- window — cross-block and [0, hi] param windows legally
      -- sandwich between or around greedy tenants, which the old
      -- single-expiry scalar could not express (that fit-check lost
      -- retain's long param window to packed first-starts).
      -- Register constraints per class:
      --   * call-final classes (2/5/6) take class-2 seats only, at or
      --     above the final call's staged arity — move_call_args
      --     writes x0..arity-1 (the S0 fix of a latent Stage 1 hole:
      --     staging bytes sit inside the call, past the audit window,
      --     and the checker had never seen pool pressure seat x8
      --     under a 9+-arg call). Their audited window stops one gpos
      --     short of the call: the write-window audit treats a BL's
      --     caller-saved clobber as foreign, while the checker's
      --     exact-offset READ events verify the staging reads.
      --   * fn-param classes (4/5) sit AT OR ABOVE param_count —
      --     arrivals occupy x0..x(param_count-1), NOT just x0-x7, and
      --     entry staging runs in param order, so a seat equal to a
      --     LATER param's arrival register clobbers that arrival
      --     before its own staging move. Neither verification net
      --     catches that class: the staging zone precedes every audit
      --     window, and arrival reads are not checker-evented
      --     (store_reg_pinned trusts its source register) — found by
      --     a three-generation bisect, not by the gates. Whole-window
      --     param seats audit as plain [0, hi] windows with an EMPTY
      --     (not absent) writers list so the audit starts at
      --     offsets[0] instead of skipping a def write params lack.
      --   * barrier-free classes (0/1/3/4) roam the whole pool.
      let pc_n = nlist_len(pool_cands)
      let mut pci = 0
      while pci < pc_n {
        let mut pc_best = pci
        let mut pcj = pci + 1
        while pcj < pc_n {
          let cj = nlist_get(pool_cands, pcj)
          let cb = nlist_get(pool_cands, pc_best)
          let wr_j = if node_tag(cj) == 3 { nlist_get(param_writer_count, node_f1(cj)) } else { 1 }
          let wr_b = if node_tag(cb) == 3 { nlist_get(param_writer_count, node_f1(cb)) } else { 1 }
          let uc_j = nlist_get(use_count, node_f1(cj)) + wr_j
          let uc_b = nlist_get(use_count, node_f1(cb)) + wr_b
          let take = if uc_j > uc_b { 1 }
            else { if uc_j == uc_b and node_f2(cj) < node_f2(cb) { 1 }
            else { if uc_j == uc_b and node_f2(cj) == node_f2(cb) and node_f1(cj) < node_f1(cb) { 1 } else { 0 } } }
          if take == 1 { pc_best = pcj } else { 0 }
          pcj = pcj + 1
        }
        if pc_best != pci {
          let pc_tmp = nlist_get(pool_cands, pci)
          pipeline_ir_native_resident_dense_set(pool_cands, pci, nlist_get(pool_cands, pc_best))
          pipeline_ir_native_resident_dense_set(pool_cands, pc_best, pc_tmp)
        } else { 0 }
        let cnd = nlist_get(pool_cands, pci)
        let cls = node_tag(cnd)
        let cv2 = node_f1(cnd)
        let occ_lo = node_f2(cnd)
        let occ_hi = node_f3(cnd)
        let call_cls = if cls == 2 or cls == 5 or cls == 6 { 1 } else { 0 }
        let seg_lo = if call_cls == 1 { class2_lo } else { 0 }
        let seg_hi = if call_cls == 1 { class2_hi } else { pool_n }
        let min_reg_arity = if call_cls == 1 { nlist_get(use_last_call_arity, cv2) } else { 0 }
        let min_reg_param = if cls == 4 or cls == 5 { param_count } else { 0 }
        let min_reg = if min_reg_arity > min_reg_param { min_reg_arity } else { min_reg_param }
        let mut spr2 = seg_lo
        let mut placed2 = 0
        while spr2 < seg_hi and placed2 == 0 {
          let sreg = nlist_get(pool_regs, spr2)
          if sreg >= min_reg and pipeline_ir_native_pool_iv_clash(nlist_get(pool_ivs, spr2), occ_lo, occ_hi) == 0 {
            pinned = pipeline_ir_native_pinned_slot_new(cv2, sreg, pipeline_ir_native_pinned_slot_kind_resident(), pinned)
            nlist_add(nlist_get(pool_ivs, spr2), node_new(0, occ_lo, occ_hi, 0, 0))
            assigned = assigned + 1
            if sreg <= 7 { low_pool_assigned = low_pool_assigned + 1 } else { 0 }
            if call_cls == 1 { call_window_assigned = call_window_assigned + 1 } else { 0 }
            if cls == 1 { fmap_add_crossblock_pool_counter(fm, 0, 1) } else { 0 }
            if cls == 6 { fmap_add_crossblock_pool_counter(fm, 1, 1) } else { 0 }
            if cls == 3 { fmap_inc_ir_native_param_resident_count(fm) } else { 0 }
            if cls == 4 { fmap_add_fn_param_resident_counter(fm, 0, 1) } else { 0 }
            if cls == 5 { fmap_add_fn_param_resident_counter(fm, 1, 1) } else { 0 }
            if cls == 0 or cls == 1 {
              pipeline_ir_native_audit_note_range(fm, cv2, sreg, nlist_get(def_pos, cv2), nlist_get(last_use, cv2))
            } else { if cls == 2 or cls == 6 {
              pipeline_ir_native_audit_note_range(fm, cv2, sreg, nlist_get(def_pos, cv2), nlist_get(last_use, cv2) - 1)
            } else { if cls == 3 {
              pipeline_ir_native_audit_note_param_range(fm, sreg, occ_lo, occ_hi, nlist_get(param_writers, cv2))
            } else { if cls == 4 {
              if fmap_audit_ranges(fm) != 0 { pipeline_ir_native_audit_note_param_range(fm, sreg, 0, occ_hi, nlist_new()) } else { 0 }
            } else {
              if fmap_audit_ranges(fm) != 0 { pipeline_ir_native_audit_note_param_range(fm, sreg, 0, occ_hi - 1, nlist_new()) } else { 0 }
            } } } }
            placed2 = 1
          } else { spr2 = spr2 + 1 }
        }
        pci = pci + 1
      }
      -- Callee-saved home reuse (2l stage 3 linear scan): a barrier-
      -- crossing value whose rounded window starts strictly after a
      -- non-param bank value's rounded window has ended lives in that
      -- value's x19-x26 home. The pair is already saved by the prologue,
      -- calls preserve callee-saved registers (every emitted callee
      -- saves the pairs it touches), and every def/use site — including
      -- call args, jump args, and terminators — routes through the
      -- pinned-aware load and store paths. Homes stay excluded when
      -- their owner is a param (entry cleanup descriptors key on
      -- identity homes), swap-excluded (lambda dst/dst+1 scratch),
      -- f64-resident, or already pinned/swapped. Fiber functions bail:
      -- their intrinsic arms write x19-x22 as fixed scratch. Runs after
      -- the permutation, taking only leftover homes.
      let fiber_fn = pipeline_ir_native_blocks_use_fiber_intrinsics(blocks)
      -- Bank permutation: the identity value-to-home assignment is
      -- arbitrary, so any consistent permutation is equally correct.
      -- Promote the hottest unpinned spill values into x19-x26 by swapping
      -- homes with the coldest displaceable bank values (never params —
      -- entry cleanup descriptors key on identity homes — and never
      -- f64-pinned or already-pinned values). Fiber functions bail: their
      -- intrinsic arms write x19-x22 as fixed scratch. The permutation
      -- runs BEFORE the callee-saved home-reuse scan so weight-ranked
      -- function-wide promotions keep priority over range-scoped
      -- tenants; homes a swap claims self-exclude from the reuse pool
      -- through their owner's pinned entry.
      let mut swaps = 0
      if fiber_fn == 1 { 0 }
      else {
        let mut round = 0
        while round < 8 {
          let mut best_v = 0 - 1
          let mut best_w = 0
          let mut i = 8
          while i < next_value {
            if nlist_get(weight, i) > best_w and nlist_get(swap_excluded, i) == 0 and pipeline_ir_native_pinned_slot_lookup(pinned, i) == 0 and nlist_get(addr_taken, i) == 0 and pipeline_ir_native_f64_slot_home_lookup(f64_facts, i) < 0 {
              best_v = i
              best_w = nlist_get(weight, i)
            } else { 0 }
            i = i + 1
          }
          let mut best_k = 0 - 1
          let mut best_kw = 0
          let mut kk = param_count
          while kk < 8 {
            if kk < next_value and nlist_get(swap_excluded, kk) == 0 and pipeline_ir_native_pinned_slot_lookup(pinned, kk) == 0 and pipeline_ir_native_f64_slot_home_lookup(f64_facts, kk) < 0 {
              if best_k < 0 {
                best_k = kk
                best_kw = nlist_get(weight, kk)
              } else { if nlist_get(weight, kk) < best_kw {
                best_k = kk
                best_kw = nlist_get(weight, kk)
              } else { 0 } }
            } else { 0 }
            kk = kk + 1
          }
          if best_v >= 0 and best_k >= 0 and best_w > best_kw * 2 + 8 {
            pinned = pipeline_ir_native_pinned_slot_new(best_v, 19 + best_k, pipeline_ir_native_pinned_slot_kind_swap(), pinned)
            pinned = pipeline_ir_native_pinned_slot_new(best_k, 0 - (best_v - 8) - 1, pipeline_ir_native_pinned_slot_kind_swap(), pinned)
            swaps = swaps + 1
            round = round + 1
          } else { round = 8 }
        }
      }
      fmap_add_ir_native_bank_swap_count(fm, swaps)
      let mut cs_assigned = 0
      if next_value > 8 and fiber_fn == 0 {
        -- Every fact here is scan-native: def/last-use windows in scan
        -- gpos, barrier counts, and backedge loop rounding all come from
        -- the arrays the walk above already filled, so the pass costs a
        -- dense filter plus placement — no extra IR walks. The interval
        -- producer stays the precision substrate for the post-mem2reg
        -- allocator. Candidates: spill-range values with an ordinary def
        -- (simple or call-result), every use at a pinned-aware site
        -- (use_cs_ok admits call args — move_call_args and the vector
        -- lane emitters read through the pinned map), no slot or address
        -- aliasing, GPR-typed, unplaced, and barrier-crossing (a
        -- barrier-free window belongs to the volatile pool).
        -- Block params join the pool too (2o step 2 substrate): a
        -- param whose writer-extended window crosses barriers cannot
        -- live in the volatile pool, but a callee-saved home survives
        -- the calls — this is what makes promoted loop variables in
        -- call-bearing loops register-resident. Edge moves write the
        -- param's home through the pinned-aware store path.
        let cs_pre = nlist_new()
        let mut cv = 8
        while cv < next_value {
          let base_cs_ok = if nlist_get(use_seen, cv) == 1 and nlist_get(use_cs_ok, cv) == 1 and nlist_get(slot_like, cv) == 0 and nlist_get(addr_taken, cv) == 0 and nlist_get(fp_def, cv) == 0 and nlist_get(swap_excluded, cv) == 0 and pipeline_ir_native_pinned_slot_lookup(pinned, cv) == 0 { 1 } else { 0 }
          if base_cs_ok == 1 {
            if nlist_get(def_pos, cv) >= 0 {
              -- Barrier-crossing values NEED a callee-saved home;
              -- barrier-free values that overflowed the volatile pool
              -- (or span blocks, which the pool cannot host) join as a
              -- lower tier — the sort key below gives crossers strict
              -- priority for the 8 homes.
              if nlist_get(def_simple, cv) != 0 {
                nlist_add(cs_pre, cv)
              } else { 0 }
            } else { if nlist_get(param_entry, cv) >= 0 and nlist_get(param_writer_count, cv) > 0 {
              nlist_add(cs_pre, cv)
            } else { 0 } }
          } else { 0 }
          cv = cv + 1
        }
        if nlist_len(cs_pre) > 0 {
        let reusable_param_homes = pipeline_ir_native_reusable_param_homes(blocks, param_count)
        -- Per-home occupancy as INTERVAL SETS (node(lo, hi) lists), not a
        -- single expiry scalar: weight-ordered seating below places
        -- windows in arbitrary start order, so a tenant may legally end
        -- before a late owner's window begins — the owner interval keeps
        -- its START as well as its end. home_ok[k] = 0 marks a home the
        -- pass may not touch at all. Owner windows mirror the tenancy
        -- math: plain defs use [def, last_use], block params their
        -- writer-extended window, entry params [0, last_use], all
        -- rounded over enclosing-loop backedges.
        let home_ok = pipeline_ir_native_resident_dense_new(8, 0)
        let home_ivs = nlist_new()
        let mut hk = 0
        while hk < 8 {
          nlist_add(home_ivs, nlist_new())
          let owner_reusable = if hk >= param_count { 1 } else { nlist_get(reusable_param_homes, hk) }
          -- Owner pin semantics: a swap pin means a promoted hot value
          -- LIVES in this home — home stays out. A pool seat (S0 fn
          -- params, phys 1-14) means the owner left the bank entirely:
          -- the home is untenanted, joins with an EMPTY interval set,
          -- and needs no owner window at all. Without this distinction
          -- the S0 pins evicted 740 cs tenants corpus-wide.
          let owner_pin = pipeline_ir_native_pinned_slot_lookup(pinned, hk)
          let owner_pool_seated = if owner_pin >= 1 and owner_pin <= 14 { 1 } else { 0 }
          if owner_reusable == 1 and nlist_get(swap_excluded, hk) == 0 and (owner_pin == 0 or owner_pool_seated == 1) and pipeline_ir_native_f64_slot_home_lookup(f64_facts, hk) < 0 {
            let own_dp = nlist_get(def_pos, hk)
            let own_iv = if owner_pool_seated == 1 { 0 } else { if own_dp >= 0 {
              let own_hi = if nlist_get(last_use, hk) > own_dp { nlist_get(last_use, hk) } else { own_dp }
              pipeline_ir_native_cs_round_window(backedge_terms, block_entry_gpos, entry_gpos_size, own_dp, own_hi)
            } else { if hk < param_count {
              if nlist_get(use_seen, hk) == 1 {
                pipeline_ir_native_cs_round_window(backedge_terms, block_entry_gpos, entry_gpos_size, 0, nlist_get(last_use, hk))
              } else { 0 }
            } else { if nlist_get(param_entry, hk) >= 0 or nlist_get(param_writer_count, hk) > 0 {
              let own_lo = nlist_get(param_lo, hk)
              let own_hi2 = if nlist_get(param_hi, hk) > nlist_get(last_use, hk) { nlist_get(param_hi, hk) } else { nlist_get(last_use, hk) }
              pipeline_ir_native_cs_round_window(backedge_terms, block_entry_gpos, entry_gpos_size, own_lo, own_hi2)
            } else { if nlist_get(use_seen, hk) == 1 { 0 - 1 } else { 0 } } } } }
            if own_iv == (0 - 1) {
              -- Touched in a shape the owner math cannot window: the
              -- home stays out of the pool entirely.
              0
            } else {
              pipeline_ir_native_resident_dense_set(home_ok, hk, 1)
              if own_iv != 0 { nlist_add(nlist_get(home_ivs, hk), own_iv) } else { 0 }
            }
          } else { 0 }
          hk = hk + 1
        }
        -- Weight-ordered seating (Stage 5): candidates process in
        -- descending static benefit (use_count reloads + 1 store per
        -- seat), ties broken by ascending window start then value id
        -- for determinism. A candidate seats in the first home whose
        -- interval set has no overlap with its rounded window. This
        -- replaces the start-ordered first-fit whose single-expiry
        -- greedy gave homes to whoever came first regardless of value.
        let ncand = nlist_len(cs_pre)
        let mut si = 0
        while si < ncand {
          let mut best = si
          let mut sj = si + 1
          while sj < ncand {
            let vj = nlist_get(cs_pre, sj)
            let vb = nlist_get(cs_pre, best)
            -- Static benefit of a seat: every use stops reloading, and
            -- every WRITE stops storing — one def store for ordinary
            -- values, one edge store per incoming writer for block
            -- params.
            let wr_j = if nlist_get(def_pos, vj) >= 0 { 1 } else { nlist_get(param_writer_count, vj) }
            let wr_b = if nlist_get(def_pos, vb) >= 0 { 1 } else { nlist_get(param_writer_count, vb) }
            let uc_j = nlist_get(use_count, vj) + wr_j
            let uc_b = nlist_get(use_count, vb) + wr_b
            let kj_base = if nlist_get(def_pos, vj) >= 0 { nlist_get(def_pos, vj) } else { nlist_get(param_lo, vj) }
            let kb_base = if nlist_get(def_pos, vb) >= 0 { nlist_get(def_pos, vb) } else { nlist_get(param_lo, vb) }
            let take = if uc_j > uc_b { 1 }
              else { if uc_j == uc_b and kj_base < kb_base { 1 }
              else { if uc_j == uc_b and kj_base == kb_base and vj < vb { 1 } else { 0 } } }
            if take == 1 { best = sj } else { 0 }
            sj = sj + 1
          }
          if best != si {
            let tmpv = nlist_get(cs_pre, si)
            pipeline_ir_native_resident_dense_set(cs_pre, si, nlist_get(cs_pre, best))
            pipeline_ir_native_resident_dense_set(cs_pre, best, tmpv)
          } else { 0 }
          let cvv = nlist_get(cs_pre, si)
          let cvv_dp = nlist_get(def_pos, cvv)
          let tw = if cvv_dp >= 0 {
            pipeline_ir_native_cs_round_window(backedge_terms, block_entry_gpos, entry_gpos_size, cvv_dp, nlist_get(last_use, cvv))
          } else {
            let p_hi = if nlist_get(param_hi, cvv) > nlist_get(last_use, cvv) { nlist_get(param_hi, cvv) } else { nlist_get(last_use, cvv) }
            pipeline_ir_native_cs_round_window(backedge_terms, block_entry_gpos, entry_gpos_size, nlist_get(param_lo, cvv), p_hi)
          }
          let tlo = node_f1(tw)
          let ive = node_f2(tw)
          let mut hk2 = 0
          let mut placed_cs = 0
          while hk2 < 8 and placed_cs == 0 {
            if nlist_get(home_ok, hk2) == 1 {
              let ivs = nlist_get(home_ivs, hk2)
              let niv = nlist_len(ivs)
              let mut ii = 0
              let mut clash = 0
              while ii < niv and clash == 0 {
                let iv = nlist_get(ivs, ii)
                if tlo <= node_f2(iv) and node_f1(iv) <= ive { clash = 1 } else { ii = ii + 1 }
              }
              if clash == 0 {
                pinned = pipeline_ir_native_pinned_slot_new(cvv, 19 + hk2, pipeline_ir_native_pinned_slot_kind_resident(), pinned)
                nlist_add(ivs, tw)
                cs_assigned = cs_assigned + 1
                if cvv_dp >= 0 {
                  pipeline_ir_native_audit_note_range(fm, cvv, 19 + hk2, cvv_dp, nlist_get(last_use, cvv))
                } else {
                  fmap_inc_ir_native_param_resident_count(fm)
                  pipeline_ir_native_audit_note_param_range(fm, 19 + hk2, nlist_get(param_lo, cvv), ive, nlist_get(param_writers, cvv))
                }
                placed_cs = 1
              } else { hk2 = hk2 + 1 }
            } else { hk2 = hk2 + 1 }
          }
          si = si + 1
        }
        0
        } else { 0 }
        0
      } else { 0 }
      -- Stage 3 constant remat: constants still frame-homed after every
      -- placement pass (pool, swaps, cs reuse) reload via ldr at each
      -- use. movz-range constants whose every use reads through the
      -- pinned-aware path re-materialize instead: phys carries the
      -- constant (remat_base + k), each load becomes one movz, and the
      -- def store disappears. use_cs_ok guards the bespoke-reader
      -- sites (intrinsics, perform, handler machinery, float staging);
      -- swap_excluded guards lambda identity-home scratch. The large
      -- counters keep sizing the multi-instruction residue.
      let mut pv = 8
      while pv < next_value {
        -- Residual decomposition: every still-spilled value (def'd,
        -- used, unpinned after all passes) sorted into exactly one
        -- exclusion reason. This is the map of what's left.
        if nlist_get(def_pos, pv) >= 0 and nlist_get(use_seen, pv) == 1 and pipeline_ir_native_pinned_slot_lookup(pinned, pv) == 0 {
          fmap_add_ir_native_residual_use_sum_count(fm, nlist_get(use_count, pv))
          -- Forward-only census: single use, immediately adjacent, at
          -- an IrBinaryI64 (the deterministic forward consumer), plain
          -- x17-storing def — the dead-store class the forward-only
          -- pseudo-home deletes.
          if nlist_get(use_count, pv) == 1 and nlist_get(last_use, pv) == nlist_get(def_pos, pv) + 1 and nlist_get(use_local, pv) == 1 and nlist_get(use_last_fwd, pv) == 1 and nlist_get(def_x17_simple, pv) == 1 and nlist_get(slot_like, pv) == 0 and nlist_get(addr_taken, pv) == 0 and nlist_get(fp_def, pv) == 0 and nlist_get(swap_excluded, pv) == 0 {
            fmap_add_ir_native_fwd_only_count(fm, 1)
          } else { 0 }
          -- Split sizing: a still-spilled value with SOME uses in its
          -- def's barrier-free segment and MORE beyond it — a
          -- def-segment split tenancy would delete exactly the
          -- segment loads.
          if nlist_get(def_segment_uses, pv) > 0 and nlist_get(def_segment_uses, pv) < nlist_get(use_count, pv) {
            fmap_add_ir_native_split_candidate_count(fm, 1)
            fmap_add_ir_native_split_segment_use_count(fm, nlist_get(def_segment_uses, pv))
          } else { 0 }
          if nlist_get(slot_like, pv) == 1 or nlist_get(addr_taken, pv) == 1 {
            fmap_add_ir_native_residual_slotlike_count(fm, 1)
          } else { if nlist_get(use_cs_ok, pv) == 0 {
            -- Some use reads through a bespoke (non-pinned-aware)
            -- emitter: intrinsics, perform, handler machinery, float
            -- staging, vector-storage specialisations.
            fmap_add_ir_native_residual_machinery_count(fm, 1)
          } else { if nlist_get(use_gpr_ok, pv) == 0 {
            -- All reads pinned-aware but some use is call-shaped:
            -- the call-window class missed it (non-final call use,
            -- arg-safe segment full, or crossing barriers).
            fmap_add_ir_native_residual_calluse_count(fm, 1)
          } else { if nlist_get(barrier_at, nlist_get(last_use, pv)) == nlist_get(barrier_at, nlist_get(def_pos, pv)) {
            if nlist_get(use_local, pv) == 1 {
              fmap_add_ir_native_residual_pool_full_count(fm, 1)
            } else {
              -- Cross-block barrier-free: the class-gap probe.
              fmap_add_ir_native_crossblock_def_count(fm, 1)
              fmap_add_ir_native_crossblock_use_count(fm, nlist_get(use_count, pv))
            }
          } else {
            -- Barrier-crossing, all uses simple: was a cs home-reuse
            -- candidate — homes exhausted or window conflicts.
            fmap_add_ir_native_residual_cs_exhausted_count(fm, 1)
          } } } }
        } else { 0 }
        if nlist_get(def_const_kind, pv) != 0 and nlist_get(def_pos, pv) >= 0 and nlist_get(use_seen, pv) == 1 and pipeline_ir_native_pinned_slot_lookup(pinned, pv) == 0 {
          if nlist_get(def_const_kind, pv) == 1 and nlist_get(use_cs_ok, pv) == 1 and nlist_get(slot_like, pv) == 0 and nlist_get(addr_taken, pv) == 0 and nlist_get(swap_excluded, pv) == 0 {
            pinned = pipeline_ir_native_pinned_slot_new(pv, pipeline_ir_native_remat_base() + nlist_get(def_const_val, pv), pipeline_ir_native_pinned_slot_kind_resident(), pinned)
            fmap_add_ir_native_remat_small_def_count(fm, 1)
            fmap_add_ir_native_remat_small_use_count(fm, nlist_get(use_count, pv))
          } else { if nlist_get(def_const_kind, pv) == 3 and nlist_get(use_cs_ok, pv) == 1 and nlist_get(slot_like, pv) == 0 and nlist_get(addr_taken, pv) == 0 and nlist_get(swap_excluded, pv) == 0 {
            -- movn window: phys = movn_base + k encodes ~k = -(k+1),
            -- so k = -cv - 1 for cv in [-65536, -1].
            pinned = pipeline_ir_native_pinned_slot_new(pv, pipeline_ir_native_remat_movn_base() + (0 - nlist_get(def_const_val, pv) - 1), pipeline_ir_native_pinned_slot_kind_resident(), pinned)
            fmap_add_ir_native_remat_movn_def_count(fm, 1)
            fmap_add_ir_native_remat_movn_use_count(fm, nlist_get(use_count, pv))
          } else { if nlist_get(def_const_kind, pv) == 2 or nlist_get(def_const_kind, pv) == 3 {
            fmap_add_ir_native_remat_large_def_count(fm, 1)
            fmap_add_ir_native_remat_large_use_count(fm, nlist_get(use_count, pv))
          } else { 0 } } }
        } else { 0 }
        pv = pv + 1
      }
      -- Def-segment split tenancy (Stage 4): a value with uses both
      -- inside and beyond its def's barrier-free segment takes a pool
      -- register for [def, segment-last-use] only. The walker persists
      -- the def to the canonical slot and flips the home at the first
      -- barrier or block end, so later uses read the slot. Runs after
      -- remat and every whole-range pass — splits take leftovers.
      let split_map = pipeline_ir_native_resident_dense_new(next_value, 0)
      let mut split_assigned = 0
      let mut sv = 8
      while sv < next_value {
        if nlist_get(def_pos, sv) >= 0 and nlist_get(use_seen, sv) == 1 and nlist_get(def_segment_uses, sv) > 0 and nlist_get(def_segment_uses, sv) < nlist_get(use_count, sv) and nlist_get(slot_like, sv) == 0 and nlist_get(addr_taken, sv) == 0 and nlist_get(swap_excluded, sv) == 0 and nlist_get(fp_def, sv) == 0 and pipeline_ir_native_pinned_slot_lookup(pinned, sv) == 0 and pipeline_ir_native_f64_slot_home_lookup(f64_facts, sv) < 0 {
          let sdp = nlist_get(def_pos, sv)
          let slu = nlist_get(def_segment_last_use, sv)
          if slu > sdp {
            let mut spr = 0
            let mut placed_split = 0
            while spr < pool_n and placed_split == 0 {
              if pipeline_ir_native_pool_iv_clash(nlist_get(pool_ivs, spr), sdp, slu) == 0 {
                pinned = pipeline_ir_native_pinned_slot_new(sv, nlist_get(pool_regs, spr), pipeline_ir_native_pinned_slot_kind_resident(), pinned)
                nlist_add(nlist_get(pool_ivs, spr), node_new(0, sdp, slu, 0, 0))
                pipeline_ir_native_resident_dense_set(split_map, sv, nlist_get(pool_regs, spr))
                split_assigned = split_assigned + 1
                pipeline_ir_native_audit_note_range(fm, sv, nlist_get(pool_regs, spr), sdp, slu)
                placed_split = 1
              } else { spr = spr + 1 }
            }
            0
          } else { 0 }
        } else { 0 }
        sv = sv + 1
      }
      fmap_set_current_split_map(fm, split_map)
      fmap_set_current_split_actives(fm, nlist_new())
      fmap_add_ir_native_split_resident_count(fm, split_assigned)
      -- Stage 2 sizing probe: barrier-free (leaf) functions never
      -- clobber caller-saved registers, so a caller-saved bank would
      -- shed their x19-x26 pairs, fp/lr save, and frame entirely.
      -- "small" = the whole value space fits the 8-home bank.
      if barrier_cum == 0 {
        let leaf_bank = if next_value > 8 { 8 } else { next_value }
        fmap_add_ir_native_leaf_fn_count(fm, 1)
        fmap_add_ir_native_leaf_fn_pair_count(fm, (leaf_bank + 1) / 2)
        if next_value <= 8 {
          fmap_add_ir_native_leaf_small_fn_count(fm, 1)
          fmap_add_ir_native_leaf_small_fn_pair_count(fm, (leaf_bank + 1) / 2)
          -- Naked-leaf qualification: barrier-free, bank-sized, no slot
          -- instructions (the frame would be unread), no f64 slot homes.
          -- Block params gate the shuffle-temp hazard path conservatively;
          -- entry-param cleanup releases are BLs and need x30 saved.
          if saw_slot_inst == 0 and pipeline_ir_native_f64_slot_home_count(f64_facts) == 0 {
            if pipeline_ir_native_max_block_param_count(blocks, 0) == 0 {
              if pipeline_ir_native_blocks_entry_params_need_cleanup(blocks, param_count) == 0 {
                -- Realize: every value lives in a caller-saved register
                -- (value 0 -> x8 because phys 0 is the pinned-map
                -- sentinel; 1-7 stay in their arrival registers), the
                -- prologue and epilogue vanish, and no callee-saved
                -- register is touched at all.
                fmap_set_current_naked_leaf(fm, 1)
                fmap_set_current_gpr_pairs(fm, 0)
                let mut nakedv = 0
                while nakedv < next_value {
                  pinned = pipeline_ir_native_pinned_slot_new(nakedv, if nakedv == 0 { 8 } else { nakedv }, pipeline_ir_native_pinned_slot_kind_resident(), pinned)
                  nakedv = nakedv + 1
                }
                fmap_add_naked_leaf_counter(fm, 0, 1)
                fmap_add_naked_leaf_counter(fm, 1, (leaf_bank + 1) / 2 + 1)
              } else {
                fmap_add_naked_leaf_counter(fm, 3, 1)
              }
            } else {
              fmap_add_naked_leaf_counter(fm, 2, 1)
            }
          } else { 0 }
        } else {
          -- Pool-extended naked sizing: a barrier-free function whose
          -- whole value space fits x1-x14 (value 0 -> x8, 1-7 arrival,
          -- 8+ -> x9-x14) with no slot insts / f64 homes / block params
          -- could shed its pairs, frame, AND its spill traffic.
          if next_value <= 14 and saw_slot_inst == 0 and pipeline_ir_native_f64_slot_home_count(f64_facts) == 0 and pipeline_ir_native_max_block_param_count(blocks, 0) == 0 {
            fmap_add_naked_leaf_counter(fm, 5, 1)
            fmap_add_naked_leaf_counter(fm, 6, (leaf_bank + 1) / 2 + 1)
            let mut n2v = 8
            while n2v < next_value {
              if nlist_get(def_pos, n2v) >= 0 { fmap_add_naked_leaf_counter(fm, 7, 1) } else { 0 }
              n2v = n2v + 1
            }
          } else { 0 }
        }
      } else { 0 }
      fmap_add_ir_native_cs_resident_count(fm, cs_assigned)
      fmap_add_ir_native_volatile_resident_count(fm, assigned)
      fmap_add_ir_native_fp_resident_count(fm, fp_assigned)
      fmap_add_ir_native_call_window_resident_count(fm, call_window_assigned)
      fmap_add_ir_native_low_pool_resident_count(fm, low_pool_assigned)
      fmap_add_ir_native_dead_store_elision_count(fm, dead_store_elided)
      -- Tail-dead pair shrink (2v Stage 2): the saved prefix follows the
      -- highest bank register the FINAL allocation actually claims —
      -- identity values 0-7 still unassigned in the ledger (their bank
      -- home will be written) plus any value a swap or cs-reuse seat
      -- placed into x19-x26. Fiber and handle-bearing functions never
      -- reach here (they bail the walk with their forced 4 pairs); a
      -- naked leaf already set 0. The prologue-pair census canary in the
      -- suite tripwire is the undercount gate.
      if fmap_current_naked_leaf(fm) == 0 and fiber_fn == 0 {
        let mut bank_top = 18
        let mut bv = 0
        while bv < next_value {
          if bv < 8 and pipeline_ir_native_pinned_slot_lookup(pinned, bv) == 0 {
            -- Value NUMBERING has gaps (DCE deletes without renumbering):
            -- an id claims its bank register only if something writes it —
            -- a param staging move, an inst def, a jump-edge writer, or
            -- the lambda dst/dst+1 machinery reservation (swap_excluded).
            let bank_claims = if bv < param_count { 1 }
              else { if nlist_get(def_pos, bv) >= 0 { 1 }
              else { if nlist_get(param_writer_count, bv) > 0 { 1 }
              else { if nlist_get(swap_excluded, bv) == 1 { 1 } else { 0 } } } }
            if bank_claims == 1 and 19 + bv > bank_top { bank_top = 19 + bv } else { 0 }
          } else {
            let blk = pipeline_ir_native_pinned_slot_lookup(pinned, bv)
            if blk >= 19 and blk <= 26 {
              if blk > bank_top { bank_top = blk } else { 0 }
            } else { 0 }
          }
          bv = bv + 1
        }
        let shrunk_pairs = if bank_top <= 18 { 0 } else { (bank_top - 19) / 2 + 1 }
        if shrunk_pairs < fmap_current_gpr_pairs(fm) {
          fmap_set_current_gpr_pairs(fm, shrunk_pairs)
        } else { 0 }
      } else { 0 }
      pinned
    }
  }
}

fn pipeline_ir_native_blocks_clobber_pinned(blocks: IrBlockList) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          if pipeline_ir_native_inst_list_clobbers_pinned(insts) == 1 { 1 }
          else { pipeline_ir_native_blocks_clobber_pinned(rest) }
        }
      }
    }
  }
}

fn pipeline_ir_native_pinned_slot_for_function(irf: IrFunction) -> i64 {
  match irf {
    IrFunction(hash, param_count, blocks, src) -> {
      if pipeline_ir_native_blocks_clobber_pinned(blocks) == 1 {
        pipeline_ir_native_pinned_slot_none()
      } else {
        let loop_pinned = pipeline_ir_native_blocks_loop_pinned_slots_inner(blocks, blocks, pipeline_ir_native_pinned_slot_none())
        pipeline_ir_native_blocks_pinned_slots_inner(blocks, blocks, loop_pinned)
      }
    }
  }
}

fn pipeline_ir_function_hash(irf: IrFunction) -> i64 {
  match irf {
    IrFunction(hash, param_count, blocks, src) -> hash
  }
}

fn pipeline_ir_function_blocks(irf: IrFunction) -> IrBlockList {
  match irf {
    IrFunction(hash, param_count, blocks, src) -> blocks
  }
}

fn pipeline_ir_function_src(irf: IrFunction) -> i64 {
  match irf {
    IrFunction(hash, param_count, blocks, src) -> src
  }
}

fn pipeline_cg_ir_only_params_from_regs(code: i64, param_count: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  -- Params arrive in x0..x7; their homes may be reassigned by the bank
  -- permutation, so the stores go through the pinned-aware path. A
  -- naked-leaf param whose home IS its arrival register needs no move —
  -- record the checker DEF claim without emitting anything.
  for i in 0..param_count {
    if pipeline_ir_native_value_home_lookup(pinned, i) == i {
      pipeline_ir_native_ck_def(code, pinned, i, i)
    } else {
      pipeline_ir_native_store_reg_pinned(code, pinned, i, i)
    }
  }
  0
}

fn pipeline_ir_native_scope_from_param_bind_prefix(insts: IrInstList, param_count: i64, seen: i64, scope: i64, homes: PipelineIrNativeValueHomeFacts) -> i64 {
  if seen >= param_count {
    scope
  } else {
    match insts {
      IrInstNil -> scope
      IrInstCons(inst, rest) -> {
        match inst {
          IrBindI64(ns, nl, value, ty) -> {
            if value >= 0 and value < param_count {
              pipeline_ir_native_scope_from_param_bind_prefix(rest, param_count, seen + 1, scope_push_typed(scope, ns, nl, pipeline_ir_native_value_home_lookup(homes, value), ty), homes)
            } else {
              scope
            }
          }
          _ -> scope
        }
      }
    }
  }
}

fn pipeline_ir_native_scope_from_entry_param_binds(blocks: IrBlockList, param_count: i64, homes: PipelineIrNativeValueHomeFacts) -> i64 {
  match blocks {
    IrBlockListNil -> scope_new()
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> pipeline_ir_native_scope_from_param_bind_prefix(insts, param_count, 0, scope_new(), homes)
      }
    }
  }
}

fn pipeline_ir_native_borrowed_param_mask_from_inst_list(insts: IrInstList) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      match inst {
        IrSlotI64(slot) -> {
          if pipeline_ir_borrowed_param_mask_slot_is(slot) == 1 {
            pipeline_ir_borrowed_param_mask_slot_decode(slot)
          } else {
            pipeline_ir_native_borrowed_param_mask_from_inst_list(rest)
          }
        }
        _ -> pipeline_ir_native_borrowed_param_mask_from_inst_list(rest)
      }
    }
  }
}

fn pipeline_ir_native_push_param_cleanup_from_bind_prefix(insts: IrInstList, param_count: i64, seen: i64, fm: i64, borrowed_mask: i64, homes: PipelineIrNativeValueHomeFacts) -> i64 {
  if seen >= param_count {
    0
  } else {
    match insts {
      IrInstNil -> 0
      IrInstCons(inst, rest) -> {
        match inst {
          IrBindI64(ns, nl, value, ty) -> {
            if value >= 0 and value < param_count {
              if cg_mask_has(borrowed_mask, seen) == 1 { 0 }
              else { pipeline_ir_native_push_ty_lane_cleanup(fm, ty, value, 0, homes) }
              pipeline_ir_native_push_param_cleanup_from_bind_prefix(rest, param_count, seen + 1, fm, borrowed_mask, homes)
            } else {
              0
            }
          }
          _ -> 0
        }
      }
    }
  }
}

fn pipeline_ir_native_push_ty_lane_cleanup(fm: i64, ty: i64, value: i64, lane: i64, homes: PipelineIrNativeValueHomeFacts) -> i64 {
  let lanes = pipeline_type_value_lane_count_or_one(ty)
  if lane >= lanes { 0 }
  else {
    let kind = pipeline_type_value_lane_release_kind(ty, lane)
    let rid = pipeline_ir_native_value_home_lookup(homes, value + lane)
    if kind == continuation_cleanup_kind_rc() { cg_cleanup_push_rc_sized(fm, rid, 0) }
    else { if kind == continuation_cleanup_kind_closure() { cg_cleanup_push_closure_sized(fm, rid, 16) }
    else { if kind == continuation_cleanup_kind_weak() { cg_cleanup_push_weak_sized(fm, rid, 0) }
    else { 0 } } }
    pipeline_ir_native_push_ty_lane_cleanup(fm, ty, value, lane + 1, homes)
  }
}

-- Pure twin of the cleanup push walk: does any entry param carry a
-- managed drop kind (and no borrow fact)? Naked leaves must exclude
-- these — the release at return is a BL and x30 goes unsaved.
fn pipeline_ir_native_entry_cleanup_probe(insts: IrInstList, param_count: i64, seen: i64, borrowed_mask: i64) -> i64 {
  if seen >= param_count { 0 }
  else {
    match insts {
      IrInstNil -> 0
      IrInstCons(inst, rest) -> {
        match inst {
          IrBindI64(ns, nl, value, ty) -> {
            if value >= 0 and value < param_count {
              if cg_mask_has(borrowed_mask, seen) == 0 and ty_value_has_release_lane(ty) == 1 { 1 }
              else { pipeline_ir_native_entry_cleanup_probe(rest, param_count, seen + 1, borrowed_mask) }
            } else { 0 }
          }
          _ -> 0
        }
      }
    }
  }
}

fn pipeline_ir_native_blocks_entry_params_need_cleanup(blocks: IrBlockList, param_count: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          pipeline_ir_native_entry_cleanup_probe(insts, param_count, 0, pipeline_ir_native_borrowed_param_mask_from_inst_list(insts))
        }
      }
    }
  }
}

fn pipeline_ir_native_push_entry_param_cleanup(blocks: IrBlockList, param_count: i64, fm: i64, homes: PipelineIrNativeValueHomeFacts) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          let borrowed_mask = pipeline_ir_native_borrowed_param_mask_from_inst_list(insts)
          pipeline_ir_native_push_param_cleanup_from_bind_prefix(insts, param_count, 0, fm, borrowed_mask, homes)
        }
      }
    }
  }
}

fn pipeline_cg_ir_only_update_method_map_for_hash(fns: i64, hash: i64, fn_off: i64, fm: i64) -> i64 {
  -- Previously a full decl walk per emitted function (quadratic across
  -- the module); the method tree is keyed by the same patch key, so one
  -- probe answers it. Coherence forbids duplicate (type, method) pairs.
  if pipeline_fns_fact_list_valid(fns) == 0 { 0 }
  else {
    let pair = pipeline_fns_index_probe(node_f2(pipeline_fns_index_bundle(fns)), hash)
    if pair != 0 {
      let type_hash = node_f3(pair)
      let fn_wrap = node_f1(pair)
      if type_hash != 0 and pipeline_decl_node_is_function(fn_wrap) == 1 {
        let fn_node = unwrap_fn(fn_wrap)
        let method_hash = str_hash(node_f2(pair), node_f1(fn_node), node_f2(fn_node))
        mmap_update(fmap_mmap(fm), type_hash, method_hash, fn_off)
      } else { 0 }
    } else { 0 }
    0
  }
}

-- Emission-level residency audit (2o step 1 prerequisite). The IR verifier
-- validates structure one layer up; this validates the layer the three 2o
-- experiments died in: the emitted code buffer against the pinned map. For
-- every volatile-pool tenant (x12-x14, d2-d7) and callee-saved FP tenant
-- (d8-d15), decode every instruction in the tenant's window — byte range
-- [start of def+1, start of last-use+1) — and flag any foreign write to the
-- tenant's register. Calls, syscalls, and unpatched placeholders clobber
-- the volatile pools; unknown words violate everything.

fn pipeline_ir_native_audit_write_violates(writes: i64, phys: i64) -> i64 {
  if (writes band decode_writes_unknown_bit()) != 0 { 1 }
  else { if phys < 1000 {
    if (writes band decode_writes_gpr_bit(phys)) != 0 { 1 }
    else { if phys >= 19 and phys <= 26 {
      -- Callee-saved GPR home reuse: calls preserve x19-x26 (every
      -- emitted callee saves the pairs it touches), only direct writes
      -- count.
      0
    } else {
      if (writes band decode_writes_call_clobber_bit()) != 0 { 1 } else { 0 }
    } }
  } else { if phys < 1008 {
    if (writes band decode_writes_fp_bit(phys - 1000)) != 0 or (writes band decode_writes_call_clobber_bit()) != 0 { 1 } else { 0 }
  } else {
    -- Callee-saved FP pool: calls preserve d8-d15, only direct writes count.
    if (writes band decode_writes_fp_bit(phys - 1000)) != 0 { 1 } else { 0 }
  } } }
}

fn pipeline_ir_native_audit_nested_end(nested: i64, pos: i64) -> i64 {
  let mut result = 0
  if nested != 0 {
    let n = nlist_len(nested)
    for i in 0..n {
      let r = nlist_get(nested, i)
      if pos >= node_f1(r) and pos < node_f2(r) { result = node_f2(r) } else { 0 }
    }
  } else { 0 }
  result
}

-- A byte position sits inside a legal writer's terminator window when some
-- writer gpos g satisfies offsets[g] <= pos < offsets[g+1]. Edge moves that
-- feed a block-param tenant live exactly there.
fn pipeline_ir_native_audit_in_writer_window(writers: i64, offsets: i64, pos: i64) -> i64 {
  let mut result = 0
  if writers != 0 {
    let n = nlist_len(writers)
    for i in 0..n {
      let g = nlist_get(writers, i)
      if pos >= nlist_get(offsets, g) and pos < nlist_get(offsets, g + 1) { result = 1 } else { 0 }
    }
  } else { 0 }
  result
}

fn pipeline_ir_native_residency_audit_function(code: i64, fm: i64, fn_hash: i64) -> i64 {
  let ranges = fmap_audit_ranges(fm)
  let offsets = fmap_audit_offsets(fm)
  if ranges != 0 and nlist_len(ranges) > 0 {
    if offsets == 0 or nlist_len(offsets) != fmap_audit_expected_gpos(fm) + 1 {
      -- Numbering skew between the scan and the emission ledger: an
      -- unguarded nested emission or hook drift. The audit result cannot
      -- be trusted for this function; count it loudly instead of guessing.
      fmap_inc_audit_skew_count(fm)
      fmap_audit_record_first(fm, fn_hash, 0 - 1, 0, 0)
    } else {
      let nested = fmap_audit_nested(fm)
      let n = nlist_len(ranges)
      for i in 0..n {
        let r = nlist_get(ranges, i)
        let phys = node_f1(r)
        let dp = node_f2(r)
        let lu = node_f3(r)
        let writers = node_f4(r)
        -- Instruction tenants own the only legal write (their def), so the
        -- window starts after it. Param tenants have no def instruction;
        -- their window starts at the block entry / earliest writer, and the
        -- writer terminators' own windows are exempted below.
        let mut pos = if writers != 0 { nlist_get(offsets, dp) } else { nlist_get(offsets, dp + 1) }
        let end = nlist_get(offsets, lu + 1)
        while pos < end {
          let nested_end = pipeline_ir_native_audit_nested_end(nested, pos)
          if nested_end > 0 {
            -- An inline nested function body behaves like a call: it may
            -- scratch the volatile pools but preserves callee-saved
            -- registers (FP d8-d15 and GPR x19-x26 — its own prologue
            -- saves the pairs it touches).
            if phys < 1008 and (phys < 19 or phys > 26) {
              fmap_inc_audit_violation_count(fm)
              fmap_audit_record_first(fm, fn_hash, pos, 0, phys)
            } else { 0 }
            pos = nested_end
          } else {
            if pipeline_ir_native_audit_in_writer_window(writers, offsets, pos) == 1 {
              pos = pos + 4
            } else {
              let word = pipeline_native_code_word(code, pos)
              let writes = decode_writes_aarch64(word)
              if pipeline_ir_native_audit_write_violates(writes, phys) == 1 {
                if phys >= 1008 or (phys >= 19 and phys <= 26) { fmap_inc_audit_cs_violation_count(fm) } else { fmap_inc_audit_violation_count(fm) }
                fmap_audit_record_first(fm, fn_hash, pos, word, phys)
              } else { 0 }
              pos = pos + 4
            }
          }
        }
        fmap_inc_audit_checked_count(fm)
      }
    }
  } else { 0 }
  fmap_set_audit_ranges(fm, 0)
  fmap_set_audit_offsets(fm, 0)
  fmap_set_audit_nested(fm, 0)
  0
}

-- 2v allocation checker replay core. Content encoding: 0 = BOTTOM
-- (untracked — reads are skipped, never flagged), 1 = CLOBBERED (an
-- unrecorded write landed), value + 2 = VALUE(value). Tracked locations:
-- x0-x30 at indices 0-30, frame slots at 32 + slot. d-registers are
-- untracked in Stage 0 v1 (FP homes record no events).
fn pipeline_ir_native_ck_content_index(loc: i64) -> i64 {
  if loc < 0 { 32 + (0 - loc - 1) } else { loc }
}

fn pipeline_ir_native_ck_reset_all(content: i64, ncells: i64) -> i64 {
  for i in 0..ncells {
    mem_store64_at(content, i * 8, 0)
  }
  0
}

fn pipeline_ir_native_ck_reset_slots(content: i64, ncells: i64) -> i64 {
  let mut i = 32
  while i < ncells {
    mem_store64_at(content, i * 8, 0)
    i = i + 1
  }
  0
}

fn pipeline_ir_native_ck_kill_caller_saved(content: i64) -> i64 {
  -- Calls (BL/BLR/SVC/unpatched placeholder) may scratch x0-x18 and x30;
  -- x19-x26 are preserved by every emitted callee (the audit's cs
  -- precedent), x27/x28 are runtime-global. Frame slots survive calls.
  for r in 0..19 {
    mem_store64_at(content, r * 8, 1)
  }
  mem_store64_at(content, 240, 1)
  0
}

fn pipeline_ir_native_ck_apply_writes(content: i64, ncells: i64, writes: i64) -> i64 {
  if (writes band decode_writes_unknown_bit()) != 0 {
    -- Unknown instruction word: bail to untracked instead of guessing.
    pipeline_ir_native_ck_reset_all(content, ncells)
  } else {
    for r in 0..31 {
      if (writes band decode_writes_gpr_bit(r)) != 0 {
        mem_store64_at(content, r * 8, 1)
      } else { 0 }
    }
    if (writes band decode_writes_call_clobber_bit()) != 0 {
      pipeline_ir_native_ck_kill_caller_saved(content)
    } else { 0 }
  }
  0
}

-- Any frame slot currently tracked? Distinguishes the prologue's
-- frame-establishing `sub sp` (nothing tracked yet — keep the reset)
-- from an outgoing-arg dance `sub sp` mid-block (tracked content must
-- survive via bias accounting).
fn pipeline_ir_native_ck_any_slot_tracked(content: i64, ncells: i64) -> i64 {
  let mut i = 32
  let mut found = 0
  while i < ncells {
    if mem_load64_at(content, i * 8) != 0 { found = 1 } else { 0 }
    i = i + 1
  }
  found
}

-- Transfer function for one decoded word. Recognized value-transport
-- shapes propagate contents; everything else kills what it writes.
-- bias is sp's displacement BELOW the frame base (outgoing-arg dances:
-- sub sp / str args / bl / ldr / add sp — always block-local): frame
-- slot k sits at [sp, k*8 + bias], and [sp, off] with off < bias is
-- arg-area traffic that must not touch frame-slot tracking. Returns
-- the new bias.
fn pipeline_ir_native_ck_transfer(content: i64, ncells: i64, word: i64, bias: i64) -> i64 {
  if word == 0 {
    -- Unpatched forward-call placeholder: a future BL.
    pipeline_ir_native_ck_kill_caller_saved(content)
    bias
  } else { if (word band 4290772992) == 2432696320 {
    -- add_imm dst, src, imm — imm 0 with a GPR source is the emitter's
    -- canonical register move; an sp destination restores a dance bias
    -- (or, unmatched, is an epilogue-shaped shift: reset).
    let dst = word band 31
    let src = (word bshr 5) band 31
    let imm = (word bshr 10) band 4095
    if dst == 31 {
      if src == 31 and imm <= bias {
        bias - imm
      } else {
        pipeline_ir_native_ck_reset_slots(content, ncells)
        0
      }
    } else {
      if imm == 0 and src != 31 {
        mem_store64_at(content, dst * 8, mem_load64_at(content, src * 8))
      } else {
        mem_store64_at(content, dst * 8, 1)
      }
      bias
    }
  } else { if (word band 4290772992) == 3506438144 {
    -- sub_imm
    let dst = word band 31
    if dst == 31 {
      if ((word bshr 5) band 31) == 31 and pipeline_ir_native_ck_any_slot_tracked(content, ncells) == 1 {
        bias + ((word bshr 10) band 4095)
      } else {
        pipeline_ir_native_ck_reset_slots(content, ncells)
        0
      }
    } else {
      mem_store64_at(content, dst * 8, 1)
      bias
    }
  } else { if (word band 4290772992) == 4177526784 {
    -- str rt, [rn, off]
    let rt = word band 31
    let rn = (word bshr 5) band 31
    if rn == 31 and rt != 31 {
      let off = (word bshr 10) band 4095
      if off * 8 >= bias {
        let slot = (off * 8 - bias) / 8
        if 32 + slot < ncells {
          mem_store64_at(content, (32 + slot) * 8, mem_load64_at(content, rt * 8))
        } else { 0 }
      } else { 0 }
    } else { 0 }
    bias
  } else { if (word band 4290772992) == 4181721088 {
    -- ldr rt, [rn, off]
    let rt = word band 31
    let rn = (word bshr 5) band 31
    if rt != 31 {
      if rn == 31 {
        let off = (word bshr 10) band 4095
        if off * 8 >= bias {
          let slot = (off * 8 - bias) / 8
          if 32 + slot < ncells {
            mem_store64_at(content, rt * 8, mem_load64_at(content, (32 + slot) * 8))
          } else {
            mem_store64_at(content, rt * 8, 1)
          }
        } else {
          mem_store64_at(content, rt * 8, 1)
        }
      } else {
        mem_store64_at(content, rt * 8, 1)
      }
    } else { 0 }
    bias
  } else { if (word band 4290772992) == 956301312 {
    -- strb to an sp slot poisons the tracked cell (partial write)
    let rn = (word bshr 5) band 31
    if rn == 31 {
      let boff = (word bshr 10) band 4095
      if boff >= bias {
        let slot = (boff - bias) / 8
        if 32 + slot < ncells { mem_store64_at(content, (32 + slot) * 8, 1) } else { 0 }
      } else { 0 }
    } else { 0 }
    bias
  } else { if (word band 4290772992) == 2843738112 or (word band 4290772992) == 1837105152 {
    -- stp_pre / stp_d_pre: pre-index writeback moves sp (prologue shapes)
    pipeline_ir_native_ck_reset_slots(content, ncells)
    0
  } else { if (word band 4290772992) == 2831155200 or (word band 4290772992) == 1824522240 {
    -- ldp_post / ldp_d_post: writeback + register writes (epilogue shapes)
    pipeline_ir_native_ck_reset_slots(content, ncells)
    pipeline_ir_native_ck_apply_writes(content, ncells, decode_writes_aarch64(word))
    0
  } else { if (word band 4227858432) == 335544320 {
    -- unconditional b: writes nothing. The v2 block replay routes this
    -- exit state along the TAKEN edge, so it must survive intact (the
    -- v1 linear walk reset here; block structure supersedes that).
    bias
  } else { if word == 3596551104 {
    -- ret: no successors in the block graph; writes nothing tracked
    bias
  } else { if (word band 4292870175) == 3558866944 {
    -- brk: no fallthrough; no writes
    bias
  } else {
    pipeline_ir_native_ck_apply_writes(content, ncells, decode_writes_aarch64(word))
    bias
  } }}}}}}}}}}
}

-- record = 1 counts read verdicts (the final converged pass); record = 0
-- is fixpoint mode — only DEFs mutate state, reads are pure assertions
-- and must not be judged against interim states.
fn pipeline_ir_native_ck_apply_event(content: i64, ncells: i64, ev: i64, fm: i64, fn_hash: i64, record: i64) -> i64 {
  let kind = node_tag(ev)
  let off = node_f1(ev)
  let loc = node_f2(ev)
  let value = node_f3(ev)
  let idx = pipeline_ir_native_ck_content_index(loc)
  if idx >= ncells { 0 }
  else { if kind == 1 {
    mem_store64_at(content, idx * 8, value + 2)
  } else { if record == 0 { 0 } else {
    let cur = mem_load64_at(content, idx * 8)
    if cur == 0 { 0 }
    else { if cur == value + 2 {
      fmap_inc_ck_checked_count(fm)
    } else {
      fmap_inc_ck_violation_count(fm)
      fmap_ck_record_first(fm, fn_hash, off, loc, value, cur)
    } }
  } } }
}

-- Branch-target bitmap over the function's words. In the v2 CFG replay
-- the same bitmap doubles as the block-leader set (targets ∪ function
-- start ∪ post-terminator offsets).
fn pipeline_ir_native_ck_mark_target(targets: i64, tcells: i64, fn_start: i64, end: i64, target: i64) -> i64 {
  if target >= fn_start and target < end {
    let widx = (target - fn_start) / 4
    let cell = widx / 64
    if cell < tcells {
      mem_store64_at(targets, cell * 8, mem_load64_at(targets, cell * 8) bor (1 bshl (widx - cell * 64)))
    } else { 0 }
  } else { 0 }
}

fn pipeline_ir_native_ck_is_target(targets: i64, tcells: i64, fn_start: i64, pos: i64) -> i64 {
  let widx = (pos - fn_start) / 4
  let cell = widx / 64
  if cell < tcells {
    if (mem_load64_at(targets, cell * 8) band (1 bshl (widx - cell * 64))) != 0 { 1 } else { 0 }
  } else { 0 }
}

fn pipeline_ir_native_ck_collect_targets(code: i64, fn_start: i64, end: i64, targets: i64, tcells: i64) -> i64 {
  let mut pos = fn_start
  while pos < end {
    let word = pipeline_native_code_word(code, pos)
    if (word band 4227858432) == 335544320 {
      -- b: imm26, word-scaled, sign-extended
      let imm26 = word band 67108863
      let off = if imm26 >= 33554432 { imm26 - 67108864 } else { imm26 }
      pipeline_ir_native_ck_mark_target(targets, tcells, fn_start, end, pos + off * 4)
    } else { if (word band 4278190096) == 1409286144 or (word band 4278190080) == 3019898880 or (word band 4278190080) == 3036676096 {
      -- b_cond / cbz / cbnz: imm19 at bits 5-23, word-scaled
      let imm19 = (word bshr 5) band 524287
      let off = if imm19 >= 262144 { imm19 - 524288 } else { imm19 }
      pipeline_ir_native_ck_mark_target(targets, tcells, fn_start, end, pos + off * 4)
    } else { 0 } }
    pos = pos + 4
  }
  0
}

-- v2 CFG-worklist replay -----------------------------------------------
-- Blocks are leader-delimited ranges (leaders = function start, every
-- branch target, every post-terminator offset). Entry states start at
-- TOP (-1, unvisited) and meet as must-agree-else-BOTTOM, so a join
-- keeps exactly the contents every reached predecessor agrees on and
-- unreachable blocks stay unchecked. DEF events attach to the block
-- containing the instruction that PRODUCED them (off - 4; defs are
-- recorded post-emission), so a boundary def flows through the edge
-- meet instead of leaking into the join; READ events attach to the
-- block containing their offset (reads are recorded pre-emission).
-- Ledger order at equal offsets is DEF-then-READ, which makes the
-- attributed block index non-decreasing over the ledger — events
-- partition into one contiguous range per block. Fixpoint sweeps apply
-- DEFs only; one final pass over converged entries records verdicts.

-- 1 = unconditional b, 2 = conditional (b_cond/cbz/cbnz),
-- 3 = no-fallthrough end (ret/brk), 0 = not a terminator.
fn pipeline_ir_native_ck_word_terminator_kind(word: i64) -> i64 {
  if (word band 4227858432) == 335544320 { 1 }
  else { if (word band 4278190096) == 1409286144 or (word band 4278190080) == 3019898880 or (word band 4278190080) == 3036676096 { 2 }
  else { if word == 3596551104 { 3 }
  else { if (word band 4292870175) == 3558866944 { 3 }
  else { 0 } } } }
}

fn pipeline_ir_native_ck_branch_target_of(word: i64, pos: i64) -> i64 {
  if (word band 4227858432) == 335544320 {
    let imm26 = word band 67108863
    let off = if imm26 >= 33554432 { imm26 - 67108864 } else { imm26 }
    pos + off * 4
  } else {
    let imm19 = (word bshr 5) band 524287
    let off = if imm19 >= 262144 { imm19 - 524288 } else { imm19 }
    pos + off * 4
  }
}

fn pipeline_ir_native_ck_meet_cell(a: i64, b: i64) -> i64 {
  if a == b { a } else { if a == 0 - 1 { b } else { if b == 0 - 1 { a } else { 0 } } }
}

-- Meet an exit state into a successor's entry; 1 if the entry changed.
fn pipeline_ir_native_ck_meet_into(entries: i64, sb: i64, ncells: i64, exit_state: i64) -> i64 {
  let base = sb * ncells * 8
  let mut changed = 0
  for i in 0..ncells {
    let old = mem_load64_at(entries, base + i * 8)
    let new = pipeline_ir_native_ck_meet_cell(old, mem_load64_at(exit_state, i * 8))
    if new != old {
      mem_store64_at(entries, base + i * 8, new)
      changed = 1
    } else { 0 }
  }
  changed
}

-- Replay one block: apply its event range in ledger order interleaved
-- with word transfers; content holds the exit state afterwards. Events
-- whose offset equals the block end (defs produced by the last
-- instruction) apply after the final transfer.
fn pipeline_ir_native_ck_replay_block(code: i64, fm: i64, fn_hash: i64, content: i64, ncells: i64, events: i64, e_lo: i64, e_hi: i64, bstart: i64, bend: i64, record: i64) -> i64 {
  let mut ei = e_lo
  let mut pos = bstart
  -- Outgoing-arg sp dances are block-local, so the bias starts and
  -- (for well-formed emission) ends at zero within each block; a block
  -- exiting with a nonzero bias drops slot tracking conservatively.
  let mut bias = 0
  while pos < bend {
    while ei < e_hi and node_f1(nlist_get(events, ei)) <= pos {
      pipeline_ir_native_ck_apply_event(content, ncells, nlist_get(events, ei), fm, fn_hash, record)
      ei = ei + 1
    }
    bias = pipeline_ir_native_ck_transfer(content, ncells, pipeline_native_code_word(code, pos), bias)
    pos = pos + 4
  }
  while ei < e_hi {
    pipeline_ir_native_ck_apply_event(content, ncells, nlist_get(events, ei), fm, fn_hash, record)
    ei = ei + 1
  }
  if bias != 0 { pipeline_ir_native_ck_reset_slots(content, ncells) } else { 0 }
  0
}

fn pipeline_ir_native_ck_state_copy(dst: i64, entries: i64, b: i64, ncells: i64) -> i64 {
  let base = b * ncells * 8
  for i in 0..ncells {
    mem_store64_at(dst, i * 8, mem_load64_at(entries, base + i * 8))
  }
  0
}

fn pipeline_ir_native_ck_edge(entries: i64, tb: i64, ncells: i64, content: i64, pending: i64, reached: i64) -> i64 {
  mem_store64_at(reached, tb * 8, 1)
  if pipeline_ir_native_ck_meet_into(entries, tb, ncells, content) == 1 {
    mem_store64_at(pending, tb * 8, 1)
    1
  } else { 0 }
}

fn pipeline_ir_native_alloc_checker_function(code: i64, fm: i64, fn_hash: i64, fn_start: i64, events: i64) -> i64 {
  if events != 0 and nlist_len(events) > 0 and buf_len(code) > fn_start {
    let end = buf_len(code)
    let nslots = fmap_current_frame_size(fm) / 8
    let ncells = 32 + nslots + 8
    let nwords = (end - fn_start) / 4
    -- Leader bitmap: branch targets + function start + post-terminator.
    let tcells = nwords / 64 + 1
    let leaders = alloc_words(tcells)
    for i in 0..tcells {
      mem_store64_at(leaders, i * 8, 0)
    }
    pipeline_ir_native_ck_collect_targets(code, fn_start, end, leaders, tcells)
    pipeline_ir_native_ck_mark_target(leaders, tcells, fn_start, end, fn_start)
    let mut sp = fn_start
    while sp < end {
      if pipeline_ir_native_ck_word_terminator_kind(pipeline_native_code_word(code, sp)) != 0 {
        pipeline_ir_native_ck_mark_target(leaders, tcells, fn_start, end, sp + 4)
      } else { 0 }
      sp = sp + 4
    }
    -- Block table (starts + end sentinel) and word → block index map.
    let starts = alloc_words(nwords + 1)
    let bidx = alloc_words(nwords)
    let mut nblocks = 0
    let mut wp = fn_start
    while wp < end {
      if pipeline_ir_native_ck_is_target(leaders, tcells, fn_start, wp) == 1 {
        mem_store64_at(starts, nblocks * 8, wp)
        nblocks = nblocks + 1
      } else { 0 }
      mem_store64_at(bidx, ((wp - fn_start) / 4) * 8, nblocks - 1)
      wp = wp + 4
    }
    mem_store64_at(starts, nblocks * 8, end)
    -- Partition events into per-block contiguous ranges by attribution.
    let n = nlist_len(events)
    let eb = alloc_words(nblocks + 1)
    mem_store64_at(eb, 0, 0)
    let mut cur_b = 0
    for i in 0..n {
      let ev = nlist_get(events, i)
      let off = node_f1(ev)
      let mut anchor = if node_tag(ev) == 1 { off - 4 } else { off }
      if anchor < fn_start { anchor = fn_start } else { 0 }
      if anchor >= end { anchor = end - 4 } else { 0 }
      let mut ebk = mem_load64_at(bidx, ((anchor - fn_start) / 4) * 8)
      if ebk < cur_b { ebk = cur_b } else { 0 }
      while cur_b < ebk {
        cur_b = cur_b + 1
        mem_store64_at(eb, cur_b * 8, i)
      }
    }
    while cur_b < nblocks {
      cur_b = cur_b + 1
      mem_store64_at(eb, cur_b * 8, n)
    }
    -- Entry states: TOP everywhere except the function entry (BOTTOM —
    -- nothing is known to be anywhere before the first def).
    let ncellstotal = nblocks * ncells
    let entries = alloc_words(ncellstotal)
    for i in 0..ncellstotal {
      mem_store64_at(entries, i * 8, 0 - 1)
    }
    for i in 0..ncells {
      mem_store64_at(entries, i * 8, 0)
    }
    let pending = alloc_words(nblocks)
    let reached = alloc_words(nblocks)
    for b in 0..nblocks {
      mem_store64_at(pending, b * 8, 0)
      mem_store64_at(reached, b * 8, 0)
    }
    mem_store64_at(pending, 0, 1)
    mem_store64_at(reached, 0, 1)
    let content = alloc_words(ncells)
    -- Fixpoint: replay pending blocks (defs only), meet exits into
    -- successor entries, re-sweep while anything descends.
    let mut sweep = 1
    while sweep == 1 {
      sweep = 0
      for b in 0..nblocks {
        if mem_load64_at(pending, b * 8) == 1 {
          mem_store64_at(pending, b * 8, 0)
          pipeline_ir_native_ck_state_copy(content, entries, b, ncells)
          let bend = mem_load64_at(starts, (b + 1) * 8)
          pipeline_ir_native_ck_replay_block(code, fm, fn_hash, content, ncells, events, mem_load64_at(eb, b * 8), mem_load64_at(eb, (b + 1) * 8), mem_load64_at(starts, b * 8), bend, 0)
          let lastw = pipeline_native_code_word(code, bend - 4)
          let tk = pipeline_ir_native_ck_word_terminator_kind(lastw)
          if tk == 1 or tk == 2 {
            let t = pipeline_ir_native_ck_branch_target_of(lastw, bend - 4)
            if t >= fn_start and t < end {
              if pipeline_ir_native_ck_edge(entries, mem_load64_at(bidx, ((t - fn_start) / 4) * 8), ncells, content, pending, reached) == 1 { sweep = 1 } else { 0 }
            } else { 0 }
          } else { 0 }
          if (tk == 0 or tk == 2) and bend < end {
            if pipeline_ir_native_ck_edge(entries, mem_load64_at(bidx, ((bend - fn_start) / 4) * 8), ncells, content, pending, reached) == 1 { sweep = 1 } else { 0 }
          } else { 0 }
        } else { 0 }
      }
    }
    -- Final pass: verdicts from converged entries; unreachable blocks
    -- are never replayed, so their reads stay unchecked.
    for b in 0..nblocks {
      if mem_load64_at(reached, b * 8) == 1 {
        pipeline_ir_native_ck_state_copy(content, entries, b, ncells)
        pipeline_ir_native_ck_replay_block(code, fm, fn_hash, content, ncells, events, mem_load64_at(eb, b * 8), mem_load64_at(eb, (b + 1) * 8), mem_load64_at(starts, b * 8), mem_load64_at(starts, (b + 1) * 8), 1)
      } else { 0 }
    }
    -- Stage 1 pre-measurement: loads-per-spilled-def over this
    -- function's ledger (static loads recorded between consecutive
    -- defs of each spill slot; ledger order is emission order). Each
    -- closing tenancy is also bucketed by the def shape of the value
    -- the def event carried (spv tracks the open tenancy's value id —
    -- the event's own value, so slot sharing cannot mismap it).
    let spb = alloc_words(ncells)
    let spv = alloc_words(ncells)
    for i in 0..ncells {
      mem_store64_at(spb, i * 8, 0 - 1)
      mem_store64_at(spv, i * 8, 0 - 1)
    }
    for i in 0..n {
      let spev = nlist_get(events, i)
      let sploc = node_f2(spev)
      if sploc < 0 {
        let spidx = pipeline_ir_native_ck_content_index(sploc)
        if spidx < ncells {
          if node_tag(spev) == 1 {
            let spopen = mem_load64_at(spb, spidx * 8)
            if spopen >= 0 {
              fmap_note_spill_def_loads(fm, spopen)
              fmap_note_shape_spill_loads(fm, pipeline_ir_native_ck_shape_of(fm, mem_load64_at(spv, spidx * 8)), spopen)
              if spopen >= 2 { fmap_note_split2_tenancy(fm, spopen, pipeline_ir_native_ck_segs_of(fm, mem_load64_at(spv, spidx * 8))) } else { 0 }
            } else { 0 }
            mem_store64_at(spb, spidx * 8, 0)
            mem_store64_at(spv, spidx * 8, node_f3(spev))
          } else {
            let spopen = mem_load64_at(spb, spidx * 8)
            if spopen >= 0 { mem_store64_at(spb, spidx * 8, spopen + 1) } else { 0 }
          }
        } else { 0 }
      } else { 0 }
    }
    for i in 0..ncells {
      let spopen = mem_load64_at(spb, i * 8)
      if spopen >= 0 {
        fmap_note_spill_def_loads(fm, spopen)
        fmap_note_shape_spill_loads(fm, pipeline_ir_native_ck_shape_of(fm, mem_load64_at(spv, i * 8)), spopen)
        if spopen >= 2 { fmap_note_split2_tenancy(fm, spopen, pipeline_ir_native_ck_segs_of(fm, mem_load64_at(spv, i * 8))) } else { 0 }
      } else { 0 }
    }
    0
  } else { 0 }
}

-- Prologue-pair census (2v Stage 2 pre-measurement). Runs at the same
-- audit point as the checker — the epilogue is not yet emitted, so
-- scanning [fn_start, buf_len) sees the prologue (stp writes only sp)
-- and the body, never the restore ldps. A saved pair is dead when the
-- body writes neither register: tail-dead pairs fall to a simple
-- prefix-count shrink, interior-dead need bank remapping. The
-- written-unsaved counter is the soundness canary for the ledger to
-- come: a body write to a callee-saved register beyond the saved
-- prefix would corrupt the caller (must stay 0).
fn pipeline_ir_native_pair_census_function(code: i64, fm: i64, fn_start: i64, fn_hash: i64) -> i64 {
  let gpr_pairs = fmap_current_gpr_pairs(fm)
  fmap_add_pair_census_counter(fm, 0, gpr_pairs)
  let end = buf_len(code)
  let mut written = 0
  let mut unknown = 0
  let mut p = fn_start
  while p < end {
    let writes = decode_writes_aarch64(pipeline_native_code_word(code, p))
    if (writes band decode_writes_unknown_bit()) != 0 { unknown = 1 } else { 0 }
    written = written bor writes
    p = p + 4
  }
  if unknown == 1 {
    fmap_add_pair_census_counter(fm, 5, 1)
  } else {
    let mut tail_dead = 0
    let mut interior_dead = 0
    let mut half_dead = 0
    let mut in_tail = 1
    let mut j = gpr_pairs - 1
    while j >= 0 {
      let r0 = 19 + j * 2
      let w0 = if (written band decode_writes_gpr_bit(r0)) != 0 { 1 } else { 0 }
      let w1 = if (written band decode_writes_gpr_bit(r0 + 1)) != 0 { 1 } else { 0 }
      if w0 == 0 and w1 == 0 {
        if in_tail == 1 { tail_dead = tail_dead + 1 } else { interior_dead = interior_dead + 1 }
      } else {
        in_tail = 0
        if w0 == 0 or w1 == 0 { half_dead = half_dead + 1 } else { 0 }
      }
      j = j - 1
    }
    fmap_add_pair_census_counter(fm, 1, tail_dead)
    fmap_add_pair_census_counter(fm, 2, interior_dead)
    fmap_add_pair_census_counter(fm, 3, half_dead)
    let mut r = 19 + gpr_pairs * 2
    while r <= 26 {
      if (written band decode_writes_gpr_bit(r)) != 0 {
        fmap_add_pair_census_counter(fm, 4, 1)
        -- Diagnostic specimen: first offender's hash, reg, and first
        -- offending write's delta + word — zero in the green state,
        -- self-identifying when the canary fires.
        if fmap_pair_census_counter(fm, 6) == 0 {
          fmap_add_pair_census_counter(fm, 6, fn_hash)
          fmap_add_pair_census_counter(fm, 7, r)
          let mut sp2 = fn_start
          let mut found = 0
          while sp2 < end and found == 0 {
            let w2 = pipeline_native_code_word(code, sp2)
            if (decode_writes_aarch64(w2) band decode_writes_gpr_bit(r)) != 0 {
              fmap_add_pair_census_counter(fm, 8, sp2 - fn_start)
              fmap_add_pair_census_counter(fm, 9, w2)
              found = 1
            } else { 0 }
            sp2 = sp2 + 4
          }
        } else { 0 }
      } else { 0 }
      r = r + 1
    }
  }
  0
}

-- Shape class for a ledger tenancy's value: the residents walk's map if
-- this function was scanned (0 there means no inst def — a block
-- param), class 15 if the walk bailed before building one.
fn pipeline_ir_native_ck_shape_of(fm: i64, v: i64) -> i64 {
  let shapes = fmap_current_def_shapes(fm)
  if shapes == 0 { 15 }
  else {
    if v >= 0 and v < nlist_len(shapes) { nlist_get(shapes, v) } else { 0 }
  }
}

-- Use-segment count for a ledger tenancy's value; 0 (no savings
-- claimed) when the walk bailed or the value is out of range.
fn pipeline_ir_native_ck_segs_of(fm: i64, v: i64) -> i64 {
  let segs = fmap_current_use_segs(fm)
  if segs == 0 { 0 }
  else {
    if v >= 0 and v < nlist_len(segs) { nlist_get(segs, v) } else { 0 }
  }
}

fn pipeline_ir_lambda_evidence_register_handler_clauses(clauses: IrHandlerClauseBodyList, fm: i64) -> i64 {
  match clauses {
    IrHandlerClauseBodyNil -> 0
    IrHandlerClauseBodyCons(body, rest) -> {
      match body {
        IrHandlerClauseBody(op_hash, nparams, captures, has_continuation, is_abortive, result_cleanup_kind, transferred_param_value_fact, resume_lanes, result_lanes, first_value, blocks) -> pipeline_ir_lambda_evidence_register_blocks(blocks, fm)
        IrHandlerClauseBodyInvalid(reason) -> 0
      }
      pipeline_ir_lambda_evidence_register_handler_clauses(rest, fm)
    }
  }
}

fn pipeline_ir_lambda_evidence_register_deferred_body(body: IrDeferredHandlerBody, fm: i64) -> i64 {
  match body {
    IrDeferredHandlerBody(captures, ops_value, result_lanes, first_value, blocks) -> pipeline_ir_lambda_evidence_register_blocks(blocks, fm)
    IrDeferredHandlerBodyInvalid(reason) -> 0
  }
}

fn pipeline_ir_lambda_evidence_register_insts(insts: IrInstList, fm: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      match inst {
        IrClosureI64(dst, f, captures, evidence) -> {
          pipeline_ir_lambda_evidence_registry_add(fm, pipeline_ir_function_hash(f), ir_lambda_semantic_facts_evidence(evidence))
        }
        IrHandleI64(dst, handle_src, effect_hash, clauses, nclauses, reserved) -> {
          pipeline_ir_lambda_evidence_register_handler_clauses(clauses, fm)
        }
        IrDeferredHandleI64(dst, handle_src, body, clauses, nclauses, effect_hash, scratch_base) -> {
          pipeline_ir_lambda_evidence_register_deferred_body(body, fm)
          pipeline_ir_lambda_evidence_register_handler_clauses(clauses, fm)
        }
        _ -> 0
      }
      pipeline_ir_lambda_evidence_register_insts(rest, fm)
    }
  }
}

fn pipeline_ir_lambda_evidence_register_blocks(blocks: IrBlockList, fm: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> pipeline_ir_lambda_evidence_register_insts(insts, fm)
      }
      pipeline_ir_lambda_evidence_register_blocks(rest, fm)
    }
  }
}

fn pipeline_ir_lambda_evidence_register_functions(functions: IrFunctionList, fm: i64) -> i64 {
  pipeline_ir_lambda_evidence_registry_ensure(fm)
  match functions {
    IrFunctionNil -> 0
    IrFunctionCons(irf, rest) -> {
      match irf {
        IrFunction(hash, params, blocks, src) -> pipeline_ir_lambda_evidence_register_blocks(blocks, fm)
      }
      pipeline_ir_lambda_evidence_register_functions(rest, fm)
    }
    _ -> 0
  }
}

fn pipeline_cg_ir_only_function(irf: IrFunction, code: i64, fm: i64, facts: PipelineIrSemanticFactList, fns: i64) -> i64 {
  match irf {
    IrFunction(hash, param_count, blocks, src) -> {
      if mono_cache_lookup(fmap_mono_cache(fm), hash) > 1 {
        0
      } else {
        fmap_inc_ir_native_candidate_count(fm)
        let fn_off = buf_len(code)
        mono_cache_add(fmap_mono_cache(fm), hash, fn_off)
        pipeline_cg_ir_only_update_method_map_for_hash(fns, hash, fn_off, fm)
        let old_frame = fmap_current_frame_size(fm)
        let old_preserve_fp = fmap_current_preserve_fp(fm)
        let old_gpr_pairs = fmap_current_gpr_pairs(fm)
        let old_ev_eff = fmap_lambda_evidence_eff(fm)
        let old_ev_ops = fmap_lambda_evidence_ops(fm)
        let old_ev_value = fmap_lambda_evidence_value(fm)
        let old_abort_cleanup_facts = fmap_current_abort_cleanup_facts(fm)
        let old_abort_cleanup_base = fmap_current_abort_cleanup_base(fm)
        let old_abort_cleanup_boundary = fmap_current_abort_cleanup_boundary(fm)
        let old_array_storage_facts = fmap_current_array_storage_facts(fm)
        let evidence_fact = pipeline_ir_lambda_evidence_registry_lookup(fm, hash)
        if evidence_fact == 0 {
          fmap_set_lambda_evidence(fm, 0, 0, 0)
        } else {
          fmap_set_lambda_evidence(fm, node_f2(evidence_fact), node_f3(evidence_fact), node_f4(evidence_fact))
        }
        let old_cleanup_depth = nlist_len(cg_cleanup_stack(fm))
        cg_cleanup_restore(fm, 0)
        let f64_facts = pipeline_ir_native_f64_facts_assign_slot_homes(blocks, pipeline_ir_native_f64_facts_for_blocks(blocks))
        let vector_data_facts = pipeline_ir_native_vector_data_facts_assign_home(pipeline_ir_native_vector_data_facts_for_blocks(blocks))
        let f64_slot_count = pipeline_ir_native_f64_slot_home_count(f64_facts)
        let abort_cleanup_facts = pipeline_ir_abort_cleanup_facts_for_blocks(blocks, fns)
        let abort_cleanup_instrumented = pipeline_ir_abort_cleanup_blocks_need_instrumentation(blocks, abort_cleanup_facts)
        let array_storage_base = pipeline_ir_native_scalar_frame_size_for_blocks(param_count, blocks)
        let array_storage_facts = pipeline_ir_native_array_storage_facts_for_blocks(blocks, array_storage_base)
        let abort_cleanup_base = pipeline_ir_native_array_storage_frame_size(array_storage_base, array_storage_facts)
        fmap_set_current_array_storage_facts(fm, array_storage_facts)
        fmap_set_current_abort_cleanup_facts(fm, abort_cleanup_facts)
        fmap_set_current_abort_cleanup_base(fm, abort_cleanup_base)
        fmap_set_current_abort_cleanup_boundary(fm, abort_cleanup_base)
        fmap_set_current_frame_size(fm, pipeline_ir_abort_cleanup_frame_size(abort_cleanup_base, abort_cleanup_facts, abort_cleanup_instrumented))
        if f64_slot_count > 0 {
          fmap_set_current_preserve_fp(fm, 1)
          fmap_inc_fp_preserve_function_count(fm)
          fmap_add_fp_register_preserved_count(fm, f64_slot_count)
          fmap_add_f64_local_register_count(fm, f64_slot_count)
          fmap_add_loop_accumulator_register_count(fm, f64_slot_count)
        } else { 0 }
        fmap_set_current_gpr_pairs(fm, pipeline_ir_native_gpr_pairs_for_function(param_count, blocks))
        let raw_pinned = pipeline_ir_native_pinned_slot_for_function(irf)
        fmap_add_ir_native_pinned_slot_count(fm, pipeline_ir_native_pinned_slot_count(raw_pinned))
        fmap_add_ir_native_loop_pinned_slot_count(fm, pipeline_ir_native_pinned_slot_kind_count(raw_pinned, pipeline_ir_native_pinned_slot_kind_loop()))
        if fmap_audit_mode(fm) == 1 { fmap_set_audit_ranges(fm, nlist_new()) } else { 0 }
        -- J3 bookkeeping is emitted between semantic IR instructions. It
        -- uses only allocator-reserved x15-x17 scratch and records every
        -- cleanup-value read, so ordinary x1-x14 residency remains valid.
        let resident_pinned = pipeline_ir_native_volatile_residents(param_count, blocks, raw_pinned, fm, f64_facts, vector_data_facts)
        if fmap_audit_mode(fm) == 1 {
          -- Arm the emission offset ledger only when this function has pool
          -- tenants to audit; handler-bearing functions never do.
          let audit_ranges = fmap_audit_ranges(fm)
          if audit_ranges != 0 and nlist_len(audit_ranges) > 0 {
            fmap_set_audit_offsets(fm, nlist_new())
            fmap_set_audit_nested(fm, nlist_new())
            0
          } else { 0 }
        } else { 0 }
        let next_value = pipeline_ir_function_next_value(param_count, blocks)
        let base_home_count = pipeline_ir_native_value_home_count_include_evidence(pipeline_ir_native_value_home_count_for_blocks(param_count, blocks), fm)
        let home_count = pipeline_ir_native_value_home_count_include_handler_scratch(base_home_count, blocks, 0)
        let pinned = pipeline_ir_native_value_home_facts(home_count, resident_pinned)
        if fmap_audit_mode(fm) == 1 { pipeline_ir_native_ck_arm(pinned) } else { 0 }
        -- Callee-saved FP residents require the preserve_fp prologue even
        -- when no f64 slot claimed it: a CS candidate only exists when its
        -- range crosses a call, so the pair cost is marginal there.
        if f64_slot_count == 0 and pipeline_ir_native_pinned_has_cs_fp(resident_pinned) == 1 {
          fmap_set_current_preserve_fp(fm, 1)
          fmap_inc_fp_preserve_function_count(fm)
        } else { 0 }
        emit_prologue_current(code, fm)
        pipeline_cg_ir_only_params_from_regs(code, param_count, pinned)
        -- Weft direct calls may pass parameters in x8 and above. Preserve
        -- every incoming register until the parameter-home copies consume it.
        pipeline_ir_abort_cleanup_emit_function_entry(code, fm)
        fmap_add_loop_addr_recur_count(fm, pipeline_ir_native_scaled_recur_count_for_blocks(blocks))
        let temp_base = next_value + 8
        let base_scope = pipeline_ir_native_scope_from_entry_param_binds(blocks, param_count, pinned)
        pipeline_ir_native_push_entry_param_cleanup(blocks, param_count, fm, pinned)
        let abort_adr_patches = nlist_new()
        let state = pipeline_ir_native_emit_blocks(blocks, blocks, code, base_scope, src, fm, PipelineNativeHandlerCtxNil, fns, f64_facts, vector_data_facts, abort_adr_patches, pipeline_ir_native_cfg_state(pipeline_ir_native_label_map_empty(), 0, pinned, temp_base))
        -- Residency audit: final sentinel entry marks the end of the last
        -- window (windows never reach the epilogue).
        let audit_offsets_done = fmap_audit_offsets(fm)
        if audit_offsets_done != 0 { nlist_add(audit_offsets_done, buf_len(code)) 0 } else { 0 }
        let labels = pipeline_ir_native_label_map_add(pipeline_ir_native_cfg_state_labels(state), pipeline_ir_native_epilogue_label(), buf_len(code))
        pipeline_ir_native_patch_all(code, labels, pipeline_ir_native_cfg_state_patches(state))
        pipeline_ir_native_patch_abort_adrs(code, labels, abort_adr_patches)
        if fmap_audit_mode(fm) == 1 { pipeline_ir_native_residency_audit_function(code, fm, hash) } else { 0 }
        if fmap_audit_mode(fm) == 1 {
          pipeline_ir_native_alloc_checker_function(code, fm, hash, fn_off, pipeline_ir_native_ck_events(pinned))
          pipeline_ir_native_pair_census_function(code, fm, fn_off, hash)
        } else { 0 }
        pipeline_ir_abort_cleanup_emit_function_exit(code, fm)
        emit_epilogue_current(code, fm)
        fmap_set_current_split_map(fm, 0)
        fmap_set_current_split_actives(fm, 0)
        fmap_set_current_def_shapes(fm, 0)
        fmap_set_current_use_segs(fm, 0)
        fmap_set_current_naked_leaf(fm, 0)
        cg_cleanup_restore(fm, old_cleanup_depth)
        fmap_set_current_frame_size(fm, old_frame)
        fmap_set_current_preserve_fp(fm, old_preserve_fp)
        fmap_set_current_gpr_pairs(fm, old_gpr_pairs)
        fmap_set_lambda_evidence(fm, old_ev_eff, old_ev_ops, old_ev_value)
        fmap_set_current_abort_cleanup_facts(fm, old_abort_cleanup_facts)
        fmap_set_current_abort_cleanup_base(fm, old_abort_cleanup_base)
        fmap_set_current_abort_cleanup_boundary(fm, old_abort_cleanup_boundary)
        fmap_set_current_array_storage_facts(fm, old_array_storage_facts)
        1
      }
    }
  }
}

fn pipeline_hash_nlist_contains(list: i64, hash: i64) -> i64 {
  let mut found = 0
  let n = nlist_len(list)
  for i in 0..n {
    if nlist_get(list, i) == hash {
      found = 1
    } else { 0 }
  }
  found
}

fn pipeline_cg_ir_only_functions_pass(functions: IrFunctionList, code: i64, fm: i64, facts: PipelineIrSemanticFactList, fns: i64) -> i64 {
  match functions {
    IrFunctionNil -> 0
    IrFunctionCons(irf, rest) -> {
      let hash = pipeline_ir_function_hash(irf)
      let emitted = if mono_cache_lookup(fmap_mono_cache(fm), hash) > 1 {
        0
      } else {
        pipeline_cg_ir_only_function(irf, code, fm, facts, fns)
      }
      emitted + pipeline_cg_ir_only_functions_pass(rest, code, fm, facts, fns)
    }
    _ -> 0
  }
}

fn pipeline_cg_ir_only_functions_count(functions: IrFunctionList) -> i64 {
  match functions {
    IrFunctionNil -> 0
    IrFunctionCons(irf, rest) -> 1 + pipeline_cg_ir_only_functions_count(rest)
    _ -> 0
  }
}

fn pipeline_cg_ir_only_functions_predeclare(functions: IrFunctionList, fm: i64) -> i64 {
  match functions {
    IrFunctionNil -> 0
    IrFunctionCons(irf, rest) -> {
      let hash = pipeline_ir_function_hash(irf)
      if mono_cache_lookup(fmap_mono_cache(fm), hash) == 0 {
        mono_cache_add(fmap_mono_cache(fm), hash, 1)
      } else { 0 }
      pipeline_cg_ir_only_functions_predeclare(rest, fm)
    }
    _ -> 0
  }
}

fn pipeline_cg_ir_only_functions_fixpoint(functions: IrFunctionList, code: i64, fm: i64, facts: PipelineIrSemanticFactList, fns: i64, emitted_total: i64) -> i64 {
  let emitted = pipeline_cg_ir_only_functions_pass(functions, code, fm, facts, fns)
  if emitted <= 0 {
    emitted_total
  } else {
    pipeline_cg_ir_only_functions_fixpoint(functions, code, fm, facts, fns, emitted_total + emitted)
  }
}

fn pipeline_cg_ir_only_functions(functions: IrFunctionList, code: i64, fm: i64, facts: PipelineIrSemanticFactList, fns: i64) -> i64 {
  pipeline_cg_ir_only_functions_predeclare(functions, fm)
  pipeline_cg_ir_only_functions_fixpoint(functions, code, fm, facts, fns, 0)
}

fn pipeline_cg_module_with_ir(fns: i64, ir_functions: IrFunctionList, code: i64, fm: i64, facts: PipelineIrSemanticFactList) -> i64 {
  let n = nlist_len(fns)
  let mm = fmap_mmap(fm)
  let tm = fmap_mono_tmap(fm)
  let btm = fmap_borrow_tmap(fm)
  for i in 0..n {
    let pair = nlist_get(fns, i)
    let fn_wrap = node_f1(pair)
    if pipeline_decl_node_is_function(fn_wrap) == 1 {
      let fn_node = unwrap_fn(fn_wrap)
      let fn_src = node_f2(pair)
      let type_hash = node_f3(pair)
      fmap_add_qualified(fm, fn_src, node_f1(fn_node), node_f2(fn_node), type_hash, 0)
      if type_hash == 0 {
        cg_ftypes_add(fmap_get_cg_ftypes(fm), fn_src, node_f1(fn_node), node_f2(fn_node), fn_ret_type(fn_wrap), node_f3(fn_node), fn_effects(fn_wrap))
      } else { 0 }
      if type_hash != 0 {
        let method_hash = str_hash(fn_src, node_f1(fn_node), node_f2(fn_node))
        if mmap_add(mm, type_hash, method_hash, 0, node_f3(fn_node)) == 1 {
          fmap_inc_emit_error_count(fm)
        } else { 0 }
        mono_cache_add(fmap_mono_cache(fm), pipeline_ir_method_patch_key(type_hash, method_hash), 1)
      } else { 0 }
      let tparams = fn_tparams(fn_wrap)
      if tparams != 0 {
        let name_hash = str_hash(fn_src, node_f1(fn_node), node_f2(fn_node))
        mono_tmap_add(tm, name_hash, fn_wrap, fn_src)
      } else {
        if type_hash == 0 {
          let name_hash = str_hash(fn_src, node_f1(fn_node), node_f2(fn_node))
          borrow_tmap_add(btm, name_hash, fn_wrap, fn_src, type_hash)
          if pipeline_fn_effective_borrowable_param_mask_with_params(fns, fn_wrap, fn_src, node_f3(fn_node), 0) != 0 {
            fmap_inc_rc_borrowable_param_fact_count(fm)
          } else { 0 }
        } else { 0 }
      }
    } else { 0 }
  }
  pipeline_ir_lambda_evidence_register_functions(ir_functions, fm)
  pipeline_cg_ir_only_functions(ir_functions, code, fm, facts, fns)
  -- Every closure target, including targets collected from handler/deferred
  -- descriptor CFGs, uses this ordinary typed-IR function driver.
  fmap_set_ir_native_emit_count(fm, fmap_ir_native_candidate_count(fm))
  code
}

fn pipeline_lower_native_module(typed: TypedModule, ir: IrModule) -> NativeModule {
  pipeline_lower_native_module_with_audit(typed, ir, 0)
}

-- audit = 1 arms the emission-level residency audit (2o): every pool
-- tenant's window is decoded and checked after each function's emission.
-- Test-only; the flag costs one branch per function when off.
fn pipeline_lower_native_module_with_audit(typed: TypedModule, ir: IrModule, audit: i64) -> NativeModule {
  match typed {
    TypedModule(fns, src, tt) -> {
      let functions = pipeline_ir_functions(ir)
      let code = buf_new(1048576)
      let fm = fmap_new()
      if audit == 1 {
        fmap_set_audit_mode(fm, 1)
        pipeline_ir_live_measure_module(functions, fm)
        0
      } else { 0 }
      let native_facts = if pipeline_ir_is_optimised(ir) == 1 {
        pipeline_ir_semantic_facts(ir)
      } else {
        pipeline_ir_semantic_facts_from_fns(fns, 0)
      }
      let effect_flags = pipeline_ir_semantic_facts_effect_flag_map(native_facts)
      let lambda_free_var_facts = cg_lambda_free_var_facts_from_fns(fns)
      fmap_set_semantic_effect_flags(fm, effect_flags)
      fmap_set_lambda_free_var_facts(fm, node_f1(lambda_free_var_facts))
      fmap_set_lambda_free_var_fact_count(fm, node_f2(lambda_free_var_facts))
      fmap_add_direct_call_inline_count(fm, pipeline_ir_direct_call_inline_sites(ir))
      emit_heap_init(code)
      let bl_main_pos = buf_len(code)
      bu32(code, 0)
      bu32(code, encode_ldp_post(29, 30, 31, 16))
      bu32(code, encode_ret())
      fmap_set_tt(fm, tt)
      fmap_set_rc_elision_enabled(fm, cg_rc_elision_enabled_for_fns(fns, src))
      pipeline_cg_module_with_ir(fns, functions, code, fm, native_facts)
      patch_forward_refs(fm, code)
      let main_hash = str_hash(__str_ptr("main"), 0, 4)
      let main_from_ir = mono_cache_lookup(fmap_mono_cache(fm), main_hash)
      let main_off = if main_from_ir > 1 { main_from_ir } else { find_main_in_fmap(fm) }
      if main_off > 1 {
        bytes_set_u32(code, bl_main_pos, encode_bl(main_off - bl_main_pos))
      } else {
        -- A missing native entry must never become a branch back into startup.
        -- Compile frontends should reject this earlier; the backend trap keeps
        -- poisoned internal paths from recursively allocating until OOM.
        bytes_set_u32(code, bl_main_pos, encode_brk(31))
      }
      NativeModule(code, fm, functions)
    }
  }
}

fn pipeline_lower_native_ir(typed: TypedModule) -> NativeModule {
  let ir = pipeline_lower_ir(typed)
  let optimised = pipeline_optimise_typed_ir(typed, ir)
  pipeline_lower_native_module(typed, optimised)
}

fn pipeline_empty_binary_for_format(format: BinaryFormat) -> BinaryObject {
  BinaryObject(buf_new(0), binary_format_kind(format))
}

fn pipeline_emit_native_macho_object(format: BinaryFormat, code: i64, fm: i64, src: i64) -> BinaryObject {
  let ngot = fmap_got_patch_count(fm)
  let o = compile_object(code, fm, src, ngot)
  BinaryObject(o, binary_format_kind(format))
}

-- Resolve static closure-pair ADRP sites against the executable's
-- zero-fill __DATA page at ts. Both the code section (vm 16384 + pos)
-- and the data page (vm ts) sit at 4KB-aligned bases, so the page delta
-- is exact in file-offset terms and the ADD low bits emitted at the
-- site are already final.
fn pipeline_apply_static_pair_patches(code: i64, fm: i64) -> i64 {
  let n = fmap_static_pair_patch_count(fm)
  let ts = page_round(16384 + buf_len(code))
  for i in 0..n {
    let pos = fmap_static_pair_patch_code_pos(fm, i)
    let slot_off = fmap_static_pair_patch_slot_off(fm, i)
    let delta_pages = (ts + slot_off) / 4096 - (16384 + pos) / 4096
    bytes_set_u32(code, pos, encode_adrp(17, delta_pages))
  }
  n
}

fn pipeline_static_pair_data_size(fm: i64) -> i64 {
  let need = fmap_static_pair_slot_count(fm) * 16
  if need > 16384 { page_round(need) } else { 16384 }
}

fn pipeline_emit_native_macho_executable(format: BinaryFormat, code: i64, fm: i64) -> BinaryObject {
  pipeline_apply_static_pair_patches(code, fm)
  let o = emit_macho(code, 0, pipeline_static_pair_data_size(fm))
  BinaryObject(o, binary_format_kind(format))
}

fn pipeline_emit_native_binary_as(format: BinaryFormat, native: NativeModule, src: i64) -> BinaryObject {
  match native {
    NativeModule(code, fm, functions) -> {
      let backend = binary_format_backend(format)
      match backend {
        BinaryFormatBackendMachOObject -> pipeline_emit_native_macho_object(format, code, fm, src)
        BinaryFormatBackendMachOExecutable -> pipeline_emit_native_macho_executable(format, code, fm)
        BinaryFormatBackendUnsupported -> pipeline_empty_binary_for_format(format)
      }
    }
  }
}

fn pipeline_emit_native_binary(native: NativeModule, src: i64) -> BinaryObject {
  pipeline_emit_native_binary_as(pipeline_native_binary_format(native), native, src)
}

fn pipeline_ir_dense_env_header() -> i64 {
  let header = alloc_words(3)
  mem_store64_at(header, 0, 0)
  mem_store64_at(header, 8, 0)
  mem_store64_at(header, 16, 0)
  header
}

fn pipeline_ir_dense_env_grow(header: i64, need: i64) -> i64 {
  let cap = mem_load64_at(header, 16)
  if need < cap { 0 }
  else {
    let mut new_cap = if cap == 0 { 256 } else { cap * 2 }
    while new_cap <= need { new_cap = new_cap * 2 }
    let new_known = alloc_zeroed(new_cap * 8)
    let new_value = alloc_words(new_cap)
    let old_known = mem_load64_at(header, 0)
    let old_value = mem_load64_at(header, 8)
    if cap > 0 {
      mem_copy(new_known, old_known, cap * 8)
      mem_copy(new_value, old_value, cap * 8)
    } else { 0 }
    mem_store64_at(header, 0, new_known)
    mem_store64_at(header, 8, new_value)
    mem_store64_at(header, 16, new_cap)
    0
  }
}

fn pipeline_ir_const_env_empty() -> PipelineIrConstEnv {
  PipelineIrConstEnvDense(pipeline_ir_dense_env_header())
}

fn pipeline_ir_const_env_bind(env: PipelineIrConstEnv, value_id: i64, const_value: i64) -> PipelineIrConstEnv {
  if value_id < 0 { env }
  else {
    match env {
      PipelineIrConstEnvNil -> env
      PipelineIrConstEnvDense(header) -> {
        pipeline_ir_dense_env_grow(header, value_id)
        mem_store64_at(mem_load64_at(header, 0), value_id * 8, 1)
        mem_store64_at(mem_load64_at(header, 8), value_id * 8, const_value)
        env
      }
    }
  }
}

fn pipeline_ir_const_lookup(valid: i64, value: i64) -> PipelineIrConstLookup {
  PipelineIrConstLookup(valid, value)
}

fn pipeline_ir_const_lookup_valid(found: PipelineIrConstLookup) -> i64 {
  match found {
    PipelineIrConstLookup(valid, value) -> valid
  }
}

fn pipeline_ir_const_lookup_value(found: PipelineIrConstLookup) -> i64 {
  match found {
    PipelineIrConstLookup(valid, value) -> value
  }
}

fn pipeline_ir_const_env_lookup(env: PipelineIrConstEnv, value_id: i64) -> PipelineIrConstLookup {
  match env {
    PipelineIrConstEnvNil -> pipeline_ir_const_lookup(0, 0)
    PipelineIrConstEnvDense(header) -> {
      if value_id < 0 or value_id >= mem_load64_at(header, 16) { pipeline_ir_const_lookup(0, 0) }
      else {
        if mem_load64_at(mem_load64_at(header, 0), value_id * 8) == 1 {
          pipeline_ir_const_lookup(1, mem_load64_at(mem_load64_at(header, 8), value_id * 8))
        } else { pipeline_ir_const_lookup(0, 0) }
      }
    }
  }
}

fn pipeline_ir_alias_env_empty() -> PipelineIrAliasEnv {
  PipelineIrAliasEnvDense(pipeline_ir_dense_env_header())
}

fn pipeline_ir_alias_env_bind(env: PipelineIrAliasEnv, value_id: i64, source_id: i64) -> PipelineIrAliasEnv {
  if value_id == source_id or value_id < 0 { env }
  else {
    match env {
      PipelineIrAliasEnvNil -> env
      PipelineIrAliasEnvDense(header) -> {
        pipeline_ir_dense_env_grow(header, value_id)
        mem_store64_at(mem_load64_at(header, 0), value_id * 8, 1)
        mem_store64_at(mem_load64_at(header, 8), value_id * 8, source_id)
        env
      }
    }
  }
}

-- Aliases are bound pre-resolved (dst -> canonical), so the chase is a
-- formality; the hop cap guards any accidental cycle.
fn pipeline_ir_alias_env_lookup_or(env: PipelineIrAliasEnv, value_id: i64) -> i64 {
  match env {
    PipelineIrAliasEnvNil -> value_id
    PipelineIrAliasEnvDense(header) -> {
      let known = mem_load64_at(header, 0)
      let source = mem_load64_at(header, 8)
      let cap = mem_load64_at(header, 16)
      let mut cur = value_id
      let mut hops = 0
      while hops < 64 and cur >= 0 and cur < cap and mem_load64_at(known, cur * 8) == 1 {
        cur = mem_load64_at(source, cur * 8)
        hops = hops + 1
      }
      cur
    }
  }
}

fn pipeline_ir_const_env_lookup_alias(env: PipelineIrConstEnv, aliases: PipelineIrAliasEnv, value_id: i64) -> PipelineIrConstLookup {
  pipeline_ir_const_env_lookup(env, pipeline_ir_alias_env_lookup_or(aliases, value_id))
}

fn pipeline_ir_tag_env_empty() -> PipelineIrTagEnv {
  PipelineIrTagEnvNil
}

fn pipeline_ir_tag_env_bind(env: PipelineIrTagEnv, tag_value: i64, base_value: i64) -> PipelineIrTagEnv {
  PipelineIrTagEnvCons(tag_value, base_value, env)
}

fn pipeline_ir_tag_env_lookup(env: PipelineIrTagEnv, tag_value: i64) -> PipelineIrConstLookup {
  match env {
    PipelineIrTagEnvNil -> pipeline_ir_const_lookup(0, 0)
    PipelineIrTagEnvCons(id, base, rest) -> {
      if id == tag_value { pipeline_ir_const_lookup(1, base) }
      else { pipeline_ir_tag_env_lookup(rest, tag_value) }
    }
  }
}

fn pipeline_ir_nil_env_empty() -> PipelineIrNilEnv {
  PipelineIrNilEnvNil
}

fn pipeline_ir_nil_env_bind(env: PipelineIrNilEnv, value_id: i64) -> PipelineIrNilEnv {
  PipelineIrNilEnvCons(value_id, env)
}

fn pipeline_ir_nil_env_contains(env: PipelineIrNilEnv, value_id: i64) -> i64 {
  match env {
    PipelineIrNilEnvNil -> 0
    PipelineIrNilEnvCons(id, rest) -> {
      if id == value_id { 1 }
      else { pipeline_ir_nil_env_contains(rest, value_id) }
    }
  }
}

fn pipeline_ir_call_cse_env_empty() -> PipelineIrCallCseEnv {
  PipelineIrCallCseEnvRaw(nlist_new())
}

fn pipeline_ir_call_cse_env_raw(env: PipelineIrCallCseEnv) -> i64 {
  match env {
    PipelineIrCallCseEnvRaw(raw) -> raw
  }
}

fn pipeline_ir_load_slot_env_empty() -> PipelineIrLoadSlotEnv {
  PipelineIrLoadSlotEnvNil
}

fn pipeline_ir_load_slot_env_bind(env: PipelineIrLoadSlotEnv, value_id: i64, slot_id: i64) -> PipelineIrLoadSlotEnv {
  PipelineIrLoadSlotEnvCons(value_id, slot_id, env)
}

fn pipeline_ir_load_slot_env_lookup(env: PipelineIrLoadSlotEnv, value_id: i64) -> PipelineIrConstLookup {
  match env {
    PipelineIrLoadSlotEnvNil -> pipeline_ir_const_lookup(0, 0)
    PipelineIrLoadSlotEnvCons(fact_value, slot_id, rest) -> {
      if fact_value == value_id {
        pipeline_ir_const_lookup(1, slot_id)
      } else {
        pipeline_ir_load_slot_env_lookup(rest, value_id)
      }
    }
  }
}

fn pipeline_ir_killed_slot_env_empty() -> PipelineIrKilledSlotEnv {
  PipelineIrKilledSlotEnvNil
}

fn pipeline_ir_killed_slot_env_bind(env: PipelineIrKilledSlotEnv, slot_id: i64) -> PipelineIrKilledSlotEnv {
  PipelineIrKilledSlotEnvCons(slot_id, env)
}

fn pipeline_ir_killed_slot_env_contains(env: PipelineIrKilledSlotEnv, slot_id: i64) -> i64 {
  match env {
    PipelineIrKilledSlotEnvNil -> 0
    PipelineIrKilledSlotEnvCons(killed, rest) -> {
      if killed == slot_id or killed < 0 { 1 } else { pipeline_ir_killed_slot_env_contains(rest, slot_id) }
    }
  }
}

-- The final field is the len-fact kill flag: once an instruction that
-- may shrink a vector (an impure call, a raw pointer store, a perform)
-- has run in this block, vector-length-derived facts established at
-- block entry no longer describe the current length and must not
-- tighten later bounds checks in the block.
fn pipeline_ir_local_fact_env_full(call_cse: PipelineIrCallCseEnv, tag_env: PipelineIrTagEnv, nil_env: PipelineIrNilEnv, load_slots: PipelineIrLoadSlotEnv, killed_slots: PipelineIrKilledSlotEnv, len_killed: i64) -> PipelineIrLocalFactEnv {
  PipelineIrLocalFactEnv(call_cse, tag_env, nil_env, load_slots, killed_slots, len_killed, PipelineIrNonnegEnvNil, PipelineIrRowUpperEnvNil, 0, 0)
}

-- Derived-nonnegative SSA values (e.g. x + c with x proven nonnegative
-- and bounded): stable value facts, so updaters preserve them and no
-- kill logic applies.
fn pipeline_ir_local_fact_env_full10(call_cse: PipelineIrCallCseEnv, tag_env: PipelineIrTagEnv, nil_env: PipelineIrNilEnv, load_slots: PipelineIrLoadSlotEnv, killed_slots: PipelineIrKilledSlotEnv, len_killed: i64, nonneg: PipelineIrNonnegEnv, row_upper: PipelineIrRowUpperEnv, bin_cse: i64, vget_cse: i64) -> PipelineIrLocalFactEnv {
  PipelineIrLocalFactEnv(call_cse, tag_env, nil_env, load_slots, killed_slots, len_killed, nonneg, row_upper, bin_cse, vget_cse)
}

fn pipeline_ir_local_fact_env_nonneg(facts: PipelineIrLocalFactEnv) -> PipelineIrNonnegEnv {
  match facts {
    PipelineIrLocalFactEnv(call_cse, tag_env, nil_env, load_slots, killed_slots, len_killed, nonneg, row_upper, bin_cse, vget_cse) -> nonneg
  }
}

fn pipeline_ir_local_fact_env_row_upper(facts: PipelineIrLocalFactEnv) -> PipelineIrRowUpperEnv {
  match facts {
    PipelineIrLocalFactEnv(call_cse, tag_env, nil_env, load_slots, killed_slots, len_killed, nonneg, row_upper, bin_cse, vget_cse) -> row_upper
  }
}

-- Block-local value numbering for pure i64 binaries: an nlist of
-- node(0, packed, lval, rval, dst) where packed = op_tag * 4 +
-- lkind * 2 + rkind and each operand is keyed by const VALUE when its
-- constness is known (kind 1) or by SSA id (kind 0), so distinct const
-- instructions with equal values still match. Pure ops over immutable
-- SSA values need no kill logic; the env dies with the block.
fn pipeline_ir_local_fact_env_bin_cse(facts: PipelineIrLocalFactEnv) -> i64 {
  match facts {
    PipelineIrLocalFactEnv(call_cse, tag_env, nil_env, load_slots, killed_slots, len_killed, nonneg, row_upper, bin_cse, vget_cse) -> bin_cse
  }
}

fn pipeline_ir_local_fact_env_with_bin_cse(facts: PipelineIrLocalFactEnv, bin_cse: i64) -> PipelineIrLocalFactEnv {
  pipeline_ir_local_fact_env_full10(
    pipeline_ir_local_fact_env_call_cse(facts),
    pipeline_ir_local_fact_env_tag_env(facts),
    pipeline_ir_local_fact_env_nil_env(facts),
    pipeline_ir_local_fact_env_load_slots(facts),
    pipeline_ir_local_fact_env_killed_slots(facts),
    pipeline_ir_local_fact_env_len_killed(facts),
    pipeline_ir_local_fact_env_nonneg(facts),
    pipeline_ir_local_fact_env_row_upper(facts),
    bin_cse,
    pipeline_ir_local_fact_env_vget_cse(facts)
  )
}

-- Redundant vector-get elimination: an nlist of
-- node(0, packed, idx_val, fb_val, node(0, vec, dst, 0, 0)) where packed
-- packs the idx/fallback operand kinds (const-by-value or SSA id). Two
-- gets of the same vector, index, and fallback see the same element (or
-- the same fallback), so the second aliases the first. Any event that
-- can mutate vector contents clears the table: vector sets (any vector
-- — distinct SSA handles may alias the same object), raw pointer
-- stores, performs, handler calls, and impure/indirect/generic/method
-- calls.
fn pipeline_ir_local_fact_env_vget_cse(facts: PipelineIrLocalFactEnv) -> i64 {
  match facts {
    PipelineIrLocalFactEnv(call_cse, tag_env, nil_env, load_slots, killed_slots, len_killed, nonneg, row_upper, bin_cse, vget_cse) -> vget_cse
  }
}

fn pipeline_ir_local_fact_env_with_vget_cse(facts: PipelineIrLocalFactEnv, vget_cse: i64) -> PipelineIrLocalFactEnv {
  pipeline_ir_local_fact_env_full10(
    pipeline_ir_local_fact_env_call_cse(facts),
    pipeline_ir_local_fact_env_tag_env(facts),
    pipeline_ir_local_fact_env_nil_env(facts),
    pipeline_ir_local_fact_env_load_slots(facts),
    pipeline_ir_local_fact_env_killed_slots(facts),
    pipeline_ir_local_fact_env_len_killed(facts),
    pipeline_ir_local_fact_env_nonneg(facts),
    pipeline_ir_local_fact_env_row_upper(facts),
    pipeline_ir_local_fact_env_bin_cse(facts),
    vget_cse
  )
}

fn pipeline_ir_vget_cse_lookup(table: i64, packed: i64, idx_val: i64, fb_val: i64, vec: i64) -> i64 {
  if table == 0 { 0 - 1 }
  else {
    let n = nlist_len(table)
    let mut i = 0
    let mut found = 0 - 1
    while i < n and found < 0 {
      let entry = nlist_get(table, i)
      if node_f1(entry) == packed and node_f2(entry) == idx_val and node_f3(entry) == fb_val and node_f1(node_f4(entry)) == vec {
        found = node_f2(node_f4(entry))
      } else { 0 }
      i = i + 1
    }
    found
  }
}

fn pipeline_ir_bin_cse_operand_kind(lookup: PipelineIrConstLookup, value_id: i64) -> i64 {
  if pipeline_ir_const_lookup_valid(lookup) == 1 { 1 } else { 0 }
}

fn pipeline_ir_bin_cse_operand_val(lookup: PipelineIrConstLookup, value_id: i64) -> i64 {
  if pipeline_ir_const_lookup_valid(lookup) == 1 { pipeline_ir_const_lookup_value(lookup) } else { value_id }
}

fn pipeline_ir_bin_cse_lookup(table: i64, packed: i64, lval: i64, rval: i64) -> i64 {
  if table == 0 { 0 - 1 }
  else {
    let n = nlist_len(table)
    let mut i = 0
    let mut found = 0 - 1
    while i < n and found < 0 {
      let entry = nlist_get(table, i)
      if node_f1(entry) == packed and node_f2(entry) == lval and node_f3(entry) == rval {
        found = node_f4(entry)
      } else { 0 }
      i = i + 1
    }
    found
  }
}

fn pipeline_ir_local_fact_env_bind_nonneg(facts: PipelineIrLocalFactEnv, value_id: i64) -> PipelineIrLocalFactEnv {
  pipeline_ir_local_fact_env_full10(
    pipeline_ir_local_fact_env_call_cse(facts),
    pipeline_ir_local_fact_env_tag_env(facts),
    pipeline_ir_local_fact_env_nil_env(facts),
    pipeline_ir_local_fact_env_load_slots(facts),
    pipeline_ir_local_fact_env_killed_slots(facts),
    pipeline_ir_local_fact_env_len_killed(facts),
    PipelineIrNonnegEnvCons(value_id, pipeline_ir_local_fact_env_nonneg(facts)),
    pipeline_ir_local_fact_env_row_upper(facts),
    pipeline_ir_local_fact_env_bin_cse(facts),
    pipeline_ir_local_fact_env_vget_cse(facts)
  )
}

fn pipeline_ir_local_fact_env_bind_row_upper(facts: PipelineIrLocalFactEnv, value_id: i64, vec_value: i64, headroom: i64) -> PipelineIrLocalFactEnv {
  pipeline_ir_local_fact_env_full10(
    pipeline_ir_local_fact_env_call_cse(facts),
    pipeline_ir_local_fact_env_tag_env(facts),
    pipeline_ir_local_fact_env_nil_env(facts),
    pipeline_ir_local_fact_env_load_slots(facts),
    pipeline_ir_local_fact_env_killed_slots(facts),
    pipeline_ir_local_fact_env_len_killed(facts),
    pipeline_ir_local_fact_env_nonneg(facts),
    PipelineIrRowUpperEnvCons(value_id, vec_value, headroom, pipeline_ir_local_fact_env_row_upper(facts)),
    pipeline_ir_local_fact_env_bin_cse(facts),
    pipeline_ir_local_fact_env_vget_cse(facts)
  )
}

-- Headroom for value_id against vec_value, or 0 when absent.
fn pipeline_ir_row_upper_env_headroom(env: PipelineIrRowUpperEnv, value_id: i64, vec_value: i64) -> i64 {
  match env {
    PipelineIrRowUpperEnvNil -> 0
    PipelineIrRowUpperEnvCons(v, vec, headroom, rest) -> {
      if v == value_id and vec == vec_value { headroom }
      else { pipeline_ir_row_upper_env_headroom(rest, value_id, vec_value) }
    }
  }
}

-- Headroom for value_id against any vector, or 0 when absent (wrap-gate
-- lookups only need "bounded by some real vector length").
fn pipeline_ir_row_upper_env_headroom_any(env: PipelineIrRowUpperEnv, value_id: i64) -> i64 {
  match env {
    PipelineIrRowUpperEnvNil -> 0
    PipelineIrRowUpperEnvCons(v, vec, headroom, rest) -> {
      if v == value_id { headroom }
      else { pipeline_ir_row_upper_env_headroom_any(rest, value_id) }
    }
  }
}

-- Full entry for value_id: node(0, valid, vec, headroom, 0).
fn pipeline_ir_row_upper_env_find(env: PipelineIrRowUpperEnv, value_id: i64) -> i64 {
  match env {
    PipelineIrRowUpperEnvNil -> node_new(0, 0, 0, 0, 0)
    PipelineIrRowUpperEnvCons(v, vec, headroom, rest) -> {
      if v == value_id { node_new(0, 1, vec, headroom, 0) }
      else { pipeline_ir_row_upper_env_find(rest, value_id) }
    }
  }
}

fn pipeline_ir_nonneg_env_contains(env: PipelineIrNonnegEnv, value_id: i64) -> i64 {
  match env {
    PipelineIrNonnegEnvNil -> 0
    PipelineIrNonnegEnvCons(v, rest) -> if v == value_id { 1 } else { pipeline_ir_nonneg_env_contains(rest, value_id) }
  }
}

