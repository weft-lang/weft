    HandlerClauseListCons(clause, rest) -> pipeline_ir_effect_flags_merge(pipeline_ir_typed_direct_effect_handler_clause_collect(clause, src, callees), pipeline_ir_typed_direct_effect_handler_clauses_collect(rest, src, callees))
  }
}

pub(package) fn pipeline_ir_typed_direct_effect_named_handler_collect(config: HandlerConfiguration, body: Expr, fact: HandlerInstallFact, src: i64, callees: i64) -> i64 {
  let args = pipeline_ir_typed_direct_effect_expr_list_collect(handler_configuration_args(config), src, callees)
  let body_flags = pipeline_ir_typed_direct_effect_expr_collect(body, src, callees)
  let implementation = if pipeline_handler_install_is_resolved(fact) == 1 {
    pipeline_ir_typed_direct_effect_handler_clauses_collect(
      pipeline_handler_install_clauses(fact),
      pipeline_handler_install_source_or(fact, src),
      callees
    )
  } else { 2 }
  pipeline_ir_effect_flags_merge(args, pipeline_ir_effect_flags_merge(body_flags, implementation))
}

pub(package) fn pipeline_ir_typed_direct_effect_named_call_collect(ns: i64, nl: i64, args: ExprList, src: i64, callees: i64) -> i64 {
  let pure_intrinsic = intrinsic_pure_effect_call_name(src, ns, nl)
  let direct_flags = intrinsic_semantic_effect_flags(src, ns, nl)
  if pure_intrinsic == 1 {
    0
  } else {
    if direct_flags == 0 { pipeline_ir_hash_nlist_add_unique(callees, str_hash(src, ns, nl)) } else { 0 }
  }
  pipeline_ir_effect_flags_merge(direct_flags, pipeline_ir_typed_direct_effect_expr_list_collect(args, src, callees))
}

pub(package) fn pipeline_ir_typed_direct_effect_decl_call_collect(decl: i64, args: ExprList, src: i64, callees: i64) -> i64 {
  let pair = module_decl_fact_function_pair(decl)
  if pair != 0 { pipeline_ir_hash_nlist_add_unique(callees, pipeline_fn_pair_key(pair)) } else { 0 }
  pipeline_ir_typed_direct_effect_expr_list_collect(args, src, callees)
}

pub(package) fn pipeline_ir_typed_direct_effect_call_collect(expr: Expr, src: i64, callees: i64) -> i64 {
  match expr {
    Call(ns, nl, args) -> pipeline_ir_typed_direct_effect_named_call_collect(ns, nl, args, src, callees)
    GenericCall(type_args, inner_call) -> pipeline_ir_typed_direct_effect_call_collect(inner_call, src, callees)
    Perform(FieldAccess(base, field_ns, field_nl, fact), op_ns, op_nl, args) -> {
      let declaration = field_access_fact_declaration(fact)
      if declaration == 0 { pipeline_ir_typed_direct_effect_expr_collect(expr, src, callees) }
      else { pipeline_ir_typed_direct_effect_decl_call_collect(declaration, args, src, callees) }
    }
    _ -> pipeline_ir_typed_direct_effect_expr_collect(expr, src, callees)
  }
}

pub(package) fn pipeline_ir_typed_direct_effect_expr_collect(expr: Expr, src: i64, callees: i64) -> i64 {
  match expr {
    IntLit(value, start, len) -> 0
    StringLit(start, len) -> 0
    BoolLit(value) -> 0
    FloatLit(start, len) -> 0
    Ident(ns, nl) -> 0
    BorrowIdent(ns, nl, owner, mutable) -> 0
    BinOp(op, lhs, rhs) -> pipeline_ir_effect_flags_merge(pipeline_ir_typed_direct_effect_expr_collect(lhs, src, callees), pipeline_ir_typed_direct_effect_expr_collect(rhs, src, callees))
    Call(ns, nl, args) -> pipeline_ir_typed_direct_effect_named_call_collect(ns, nl, args, src, callees)
    GenericCall(type_args, inner_call) -> pipeline_ir_typed_direct_effect_call_collect(inner_call, src, callees)
    If(cond, then_expr, else_expr) -> pipeline_ir_effect_flags_merge(pipeline_ir_effect_flags_merge(pipeline_ir_typed_direct_effect_expr_collect(cond, src, callees), pipeline_ir_typed_direct_effect_expr_collect(then_expr, src, callees)), pipeline_ir_typed_direct_effect_expr_collect(else_expr, src, callees))
    While(cond, body) -> pipeline_ir_effect_flags_merge(pipeline_ir_typed_direct_effect_expr_collect(cond, src, callees), pipeline_ir_typed_direct_effect_expr_collect(body, src, callees))
    Loop(body) -> pipeline_ir_typed_direct_effect_expr_collect(body, src, callees)
    Break(value) -> pipeline_ir_typed_direct_effect_expr_collect(value, src, callees)
    BreakNoValue -> 0
    Continue -> 0
    Return(value) -> pipeline_ir_typed_direct_effect_expr_collect(value, src, callees)
    ReturnNoValue -> 0
    Defer(cleanup, body, source_site) -> pipeline_ir_effect_flags_merge(pipeline_ir_typed_direct_effect_expr_collect(cleanup, src, callees), pipeline_ir_typed_direct_effect_expr_collect(body, src, callees))
    Let(ns, nl, value, body) -> pipeline_ir_effect_flags_merge(pipeline_ir_typed_direct_effect_expr_collect(value, src, callees), pipeline_ir_typed_direct_effect_expr_collect(body, src, callees))
    LetMut(ns, nl, value, body) -> pipeline_ir_effect_flags_merge(pipeline_ir_typed_direct_effect_expr_collect(value, src, callees), pipeline_ir_typed_direct_effect_expr_collect(body, src, callees))
    Assign(ns, nl, value) -> pipeline_ir_typed_direct_effect_expr_collect(value, src, callees)
    AddressOf(mutable, target) -> pipeline_ir_effect_flags_merge(2, pipeline_ir_typed_direct_effect_expr_collect(target, src, callees))
    Deref(ptr) -> pipeline_ir_effect_flags_merge(2, pipeline_ir_typed_direct_effect_expr_collect(ptr, src, callees))
    PtrAssign(ptr, value) -> pipeline_ir_effect_flags_merge(2, pipeline_ir_effect_flags_merge(pipeline_ir_typed_direct_effect_expr_collect(ptr, src, callees), pipeline_ir_typed_direct_effect_expr_collect(value, src, callees)))
    Block(first, rest) -> pipeline_ir_effect_flags_merge(pipeline_ir_typed_direct_effect_expr_collect(first, src, callees), pipeline_ir_typed_direct_effect_expr_collect(rest, src, callees))
    FieldAccess(base, field_ns, field_nl, fact) -> pipeline_ir_typed_direct_effect_expr_collect(base, src, callees)
    RecordUpdate(base, fields, fact) -> pipeline_ir_effect_flags_merge(pipeline_ir_typed_direct_effect_expr_collect(base, src, callees), pipeline_ir_typed_direct_effect_record_fields_collect(fields, src, callees))
    IndexedLen(base, fixed_len) -> pipeline_ir_typed_direct_effect_expr_collect(base, src, callees)
    IndexedGet(base, index, element_ty, fixed_len) -> pipeline_ir_effect_flags_merge(pipeline_ir_typed_direct_effect_expr_collect(base, src, callees), pipeline_ir_typed_direct_effect_expr_collect(index, src, callees))
    IndexedSet(base, index, value, fact) -> pipeline_ir_effect_flags_merge(pipeline_ir_typed_direct_effect_expr_collect(base, src, callees), pipeline_ir_effect_flags_merge(pipeline_ir_typed_direct_effect_expr_collect(index, src, callees), pipeline_ir_typed_direct_effect_expr_collect(value, src, callees)))
    IndexedSlice(base, start, end, fact) -> pipeline_ir_effect_flags_merge(pipeline_ir_typed_direct_effect_expr_collect(base, src, callees), pipeline_ir_effect_flags_merge(pipeline_ir_typed_direct_effect_expr_collect(start, src, callees), pipeline_ir_typed_direct_effect_expr_collect(end, src, callees)))
    RecordInit(type_ns, type_nl, fields) -> pipeline_ir_typed_direct_effect_record_fields_collect(fields, src, callees)
    ArrayLiteral(elements, resolved_ty, span) -> pipeline_ir_typed_direct_effect_expr_list_collect(elements, src, callees)
    Match(scrutinee, arms) -> pipeline_ir_effect_flags_merge(pipeline_ir_typed_direct_effect_expr_collect(scrutinee, src, callees), pipeline_ir_typed_direct_effect_match_arms_collect(arms, src, callees))
    Not(operand) -> pipeline_ir_typed_direct_effect_expr_collect(operand, src, callees)
    Lambda(params, body, source_site) -> pipeline_ir_typed_direct_effect_expr_collect(body, src, callees)
    Perform(lhs, op_ns, op_nl, args) -> match lhs {
      FieldAccess(base, field_ns, field_nl, fact) -> {
        let declaration = field_access_fact_declaration(fact)
        if declaration == 0 { pipeline_ir_effect_flags_merge(4, pipeline_ir_effect_flags_merge(pipeline_ir_typed_direct_effect_expr_collect(lhs, src, callees), pipeline_ir_typed_direct_effect_expr_list_collect(args, src, callees))) }
        else { pipeline_ir_typed_direct_effect_decl_call_collect(declaration, args, src, callees) }
      }
      _ -> pipeline_ir_effect_flags_merge(4, pipeline_ir_effect_flags_merge(pipeline_ir_typed_direct_effect_expr_collect(lhs, src, callees), pipeline_ir_typed_direct_effect_expr_list_collect(args, src, callees)))
    }
    Handle(body, clauses, hret) -> pipeline_ir_effect_flags_merge(pipeline_ir_typed_direct_effect_expr_collect(body, src, callees), pipeline_ir_effect_flags_merge(pipeline_ir_typed_direct_effect_handler_clauses_collect(clauses, src, callees), match hret { NoHandleReturn -> 0 HandleReturnClause(rns, rnl, rb) -> pipeline_ir_typed_direct_effect_expr_collect(rb, src, callees) }))
    WithHandler(config, body, fact, source_site) -> pipeline_ir_typed_direct_effect_named_handler_collect(config, body, fact, src, callees)
    Resume(value) -> pipeline_ir_typed_direct_effect_expr_collect(value, src, callees)
    MethodCall(recv, method_hash, args, type_hash) -> pipeline_ir_effect_flags_merge(2, pipeline_ir_effect_flags_merge(pipeline_ir_typed_direct_effect_expr_collect(recv, src, callees), pipeline_ir_typed_direct_effect_expr_list_collect(args, src, callees)))
    Try(inner, effect_atom) -> pipeline_ir_effect_flags_merge(4, pipeline_ir_typed_direct_effect_expr_collect(inner, src, callees))
    InterpConcat(left, right) -> pipeline_ir_effect_flags_merge(pipeline_ir_typed_direct_effect_expr_collect(left, src, callees), pipeline_ir_typed_direct_effect_expr_collect(right, src, callees))
    ForIter(var_ns, var_nl, collection, body) -> pipeline_ir_effect_flags_merge(pipeline_ir_typed_direct_effect_expr_collect(collection, src, callees), pipeline_ir_typed_direct_effect_expr_collect(body, src, callees))
    OptChain(base, field_ns, field_nl, effect_atom) -> pipeline_ir_effect_flags_merge(4, pipeline_ir_typed_direct_effect_expr_collect(base, src, callees))
    LetTyped(inner, ann_type) -> pipeline_ir_typed_direct_effect_expr_collect(inner, src, callees)
    NilExpr -> 0
    UnknownExpr(tag) -> 2
  }
}

pub(package) fn pipeline_ir_node_direct_effect_expr_list_collect(exprs: i64, index: i64, count: i64, src: i64, callees: i64) -> i64 {
  if index >= count {
    0
  } else {
    pipeline_ir_effect_flags_merge(
      pipeline_ir_node_direct_effect_expr_collect(nlist_get(exprs, index), src, callees),
      pipeline_ir_node_direct_effect_expr_list_collect(exprs, index + 1, count, src, callees)
    )
  }
}

pub(package) fn pipeline_ir_node_direct_effect_record_fields_collect(fields: i64, index: i64, count: i64, src: i64, callees: i64) -> i64 {
  if index >= count {
    0
  } else {
    let field = nlist_get(fields, index)
    let field_flags = if field != 0 and node_tag(field) == 2 {
      pipeline_ir_node_direct_effect_expr_collect(node_f3(field), src, callees)
    } else {
      2
    }
    pipeline_ir_effect_flags_merge(field_flags, pipeline_ir_node_direct_effect_record_fields_collect(fields, index + 1, count, src, callees))
  }
}

pub(package) fn pipeline_ir_node_direct_effect_match_arms_collect(arms: i64, index: i64, count: i64, src: i64, callees: i64) -> i64 {
  if index >= count {
    0
  } else {
    let arm = nlist_get(arms, index)
    let arm_flags = if arm != 0 and node_tag(arm) == 16 {
      let guard_flags = if node_f3(arm) == 0 { 0 } else { pipeline_ir_node_direct_effect_expr_collect(node_f3(arm), src, callees) }
      pipeline_ir_effect_flags_merge(pipeline_ir_node_direct_effect_expr_collect(node_f2(arm), src, callees), guard_flags)
    } else {
      2
    }
    pipeline_ir_effect_flags_merge(arm_flags, pipeline_ir_node_direct_effect_match_arms_collect(arms, index + 1, count, src, callees))
  }
}

pub(package) fn pipeline_ir_node_direct_effect_handler_clauses_collect(clauses: i64, index: i64, count: i64, src: i64, callees: i64) -> i64 {
  if index >= count {
    0
  } else {
    let clause = nlist_get(clauses, index)
    let clause_flags = if clause != 0 and node_tag(clause) == 34 {
      pipeline_ir_node_direct_effect_expr_collect(node_f3(clause), src, callees)
    } else {
      2
    }
    pipeline_ir_effect_flags_merge(clause_flags, pipeline_ir_node_direct_effect_handler_clauses_collect(clauses, index + 1, count, src, callees))
  }
}

pub(package) fn pipeline_ir_node_direct_effect_named_call_collect(ns: i64, nl: i64, args: i64, nargs: i64, src: i64, callees: i64) -> i64 {
  let pure_intrinsic = intrinsic_pure_effect_call_name(src, ns, nl)
  let direct_flags = intrinsic_semantic_effect_flags(src, ns, nl)
  if pure_intrinsic == 1 {
    0
  } else {
    if direct_flags == 0 { pipeline_ir_hash_nlist_add_unique(callees, str_hash(src, ns, nl)) } else { 0 }
  }
  pipeline_ir_effect_flags_merge(direct_flags, pipeline_ir_node_direct_effect_expr_list_collect(args, 0, nargs, src, callees))
}

pub(package) fn pipeline_ir_node_direct_effect_decl_call_collect(decl: i64, args: i64, nargs: i64, src: i64, callees: i64) -> i64 {
  let pair = module_decl_fact_function_pair(decl)
  if pair != 0 { pipeline_ir_hash_nlist_add_unique(callees, pipeline_fn_pair_key(pair)) } else { 0 }
  pipeline_ir_node_direct_effect_expr_list_collect(args, 0, nargs, src, callees)
}

pub(package) fn pipeline_ir_node_direct_effect_call_collect(expr: i64, src: i64, callees: i64) -> i64 {
  let stripped = pipeline_expr_node_strip_typed(expr)
  if stripped == 0 {
    2
  } else {
    let tag = node_tag(stripped)
    if tag == 4 {
      pipeline_ir_node_direct_effect_named_call_collect(node_f1(stripped), node_f2(stripped), node_f3(stripped), node_f4(stripped), src, callees)
    } else { if tag == 36 {
      pipeline_ir_node_direct_effect_call_collect(node_f2(stripped), src, callees)
    } else { if tag == 32 {
      let declaration = pipeline_node_declaration_access(pipeline_expr_node_strip_typed(node_f1(stripped)))
      if declaration == 0 { pipeline_ir_node_direct_effect_expr_collect(stripped, src, callees) }
      else { pipeline_ir_node_direct_effect_decl_call_collect(declaration, node_f4(stripped), nlist_len(node_f4(stripped)), src, callees) }
    } else {
      pipeline_ir_node_direct_effect_expr_collect(stripped, src, callees)
    } } }
  }
}

pub(package) fn pipeline_ir_node_direct_effect_named_handler_collect(config: i64, body: i64, install: i64, src: i64, callees: i64) -> i64 {
  let args = typeck_handler_config_args(config)
  let nargs = typeck_handler_config_arg_count(config)
  let arg_flags = if nargs < 0 { 2 }
    else { pipeline_ir_node_direct_effect_expr_list_collect(args, 0, nargs, src, callees) }
  let body_flags = pipeline_ir_node_direct_effect_expr_collect(body, src, callees)
  let implementation_flags = if install == 0 or node_tag(install) != 72 { 2 }
    else {
      let target_module = node_f1(install)
      let implementation = node_f2(install)
      let raw = typeck_handler_implementation_raw(implementation)
      if target_module == 0 or raw == 0 or node_tag(implementation) != 2 { 2 }
      else {
        pipeline_ir_node_direct_effect_handler_clauses_collect(
          typeck_handler_implementation_clauses(raw),
          0,
          typeck_handler_implementation_clause_count(raw),
          module_fact_entry_source(target_module),
          callees
        )
      }
    }
  pipeline_ir_effect_flags_merge(arg_flags, pipeline_ir_effect_flags_merge(body_flags, implementation_flags))
}

pub(package) fn pipeline_ir_node_direct_effect_expr_collect(expr: i64, src: i64, callees: i64) -> i64 {
  let stripped = pipeline_expr_node_strip_typed(expr)
  if stripped == 0 {
    2
  } else {
    let tag = node_tag(stripped)
    if tag == 1 or tag == 2 or tag == 9 or tag == 24 or tag == 51 or tag == 54 {
      0
    } else { if tag == 3 {
      pipeline_ir_effect_flags_merge(pipeline_ir_node_direct_effect_expr_collect(node_f2(stripped), src, callees), pipeline_ir_node_direct_effect_expr_collect(node_f3(stripped), src, callees))
    } else { if tag == 4 {
      pipeline_ir_node_direct_effect_named_call_collect(node_f1(stripped), node_f2(stripped), node_f3(stripped), node_f4(stripped), src, callees)
    } else { if tag == 5 {
      pipeline_ir_effect_flags_merge(pipeline_ir_effect_flags_merge(pipeline_ir_node_direct_effect_expr_collect(node_f1(stripped), src, callees), pipeline_ir_node_direct_effect_expr_collect(node_f2(stripped), src, callees)), pipeline_ir_node_direct_effect_expr_collect(node_f3(stripped), src, callees))
    } else { if tag == 6 or tag == 11 {
      pipeline_ir_effect_flags_merge(pipeline_ir_node_direct_effect_expr_collect(node_f3(stripped), src, callees), pipeline_ir_node_direct_effect_expr_collect(node_f4(stripped), src, callees))
    } else { if tag == 7 {
      pipeline_ir_effect_flags_merge(pipeline_ir_node_direct_effect_expr_collect(node_f1(stripped), src, callees), pipeline_ir_node_direct_effect_expr_collect(node_f2(stripped), src, callees))
    } else { if tag == 10 {
      pipeline_ir_effect_flags_merge(pipeline_ir_node_direct_effect_expr_collect(node_f1(stripped), src, callees), pipeline_ir_node_direct_effect_expr_collect(node_f2(stripped), src, callees))
    } else { if tag == 12 {
      pipeline_ir_node_direct_effect_expr_collect(node_f3(stripped), src, callees)
    } else { if tag == 13 or tag == 22 or tag == 35 or tag == 49 or tag == 56 or tag == 59 {
      pipeline_ir_node_direct_effect_expr_collect(node_f1(stripped), src, callees)
    } else { if tag == 60 {
      pipeline_ir_effect_flags_merge(pipeline_ir_node_direct_effect_expr_collect(node_f1(stripped), src, callees), pipeline_ir_node_direct_effect_expr_collect(node_f2(stripped), src, callees))
    } else { if tag == 61 {
      pipeline_ir_effect_flags_merge(pipeline_ir_node_direct_effect_expr_collect(node_f1(stripped), src, callees), pipeline_ir_effect_flags_merge(pipeline_ir_node_direct_effect_expr_collect(node_f2(stripped), src, callees), pipeline_ir_node_direct_effect_expr_collect(node_f3(stripped), src, callees)))
    } else { if tag == 62 {
      pipeline_ir_effect_flags_merge(pipeline_ir_node_direct_effect_expr_collect(node_f1(stripped), src, callees), pipeline_ir_effect_flags_merge(pipeline_ir_node_direct_effect_expr_collect(node_f2(stripped), src, callees), pipeline_ir_node_direct_effect_expr_collect(node_f3(stripped), src, callees)))
    } else { if tag == 45 or tag == 48 {
      pipeline_ir_effect_flags_merge(4, pipeline_ir_node_direct_effect_expr_collect(node_f1(stripped), src, callees))
    } else { if tag == 14 {
      pipeline_ir_node_direct_effect_record_fields_collect(node_f3(stripped), 0, node_f4(stripped), src, callees)
    } else { if tag == 63 {
      pipeline_ir_effect_flags_merge(pipeline_ir_node_direct_effect_expr_collect(node_f1(stripped), src, callees), pipeline_ir_node_direct_effect_record_fields_collect(node_f2(stripped), 0, node_f3(stripped), src, callees))
    } else { if tag == 58 {
      pipeline_ir_node_direct_effect_expr_list_collect(node_f1(stripped), 0, node_f2(stripped), src, callees)
    } else { if tag == 15 {
      pipeline_ir_effect_flags_merge(pipeline_ir_node_direct_effect_expr_collect(node_f1(stripped), src, callees), pipeline_ir_node_direct_effect_match_arms_collect(node_f2(stripped), 0, node_f3(stripped), src, callees))
    } else { if tag == 25 or tag == 26 {
      if node_f1(stripped) == 0 { 0 } else { pipeline_ir_node_direct_effect_expr_collect(node_f1(stripped), src, callees) }
    } else { if tag == 27 {
      0
    } else { if tag == 29 {
      pipeline_ir_node_direct_effect_expr_collect(node_f2(stripped), src, callees)
    } else { if tag == 32 {
      let declaration = pipeline_node_declaration_access(pipeline_expr_node_strip_typed(node_f1(stripped)))
      if declaration == 0 {
        pipeline_ir_effect_flags_merge(4, pipeline_ir_effect_flags_merge(pipeline_ir_node_direct_effect_expr_collect(node_f1(stripped), src, callees), pipeline_ir_node_direct_effect_expr_list_collect(node_f4(stripped), 0, nlist_len(node_f4(stripped)), src, callees)))
      } else {
        pipeline_ir_node_direct_effect_decl_call_collect(declaration, node_f4(stripped), nlist_len(node_f4(stripped)), src, callees)
      }
    } else { if tag == 33 {
      pipeline_ir_effect_flags_merge(pipeline_ir_node_direct_effect_expr_collect(node_f1(stripped), src, callees), pipeline_ir_node_direct_effect_handler_clauses_collect(node_f2(stripped), 0, node_f3(stripped), src, callees))
    } else { if tag == 36 {
      pipeline_ir_node_direct_effect_call_collect(node_f2(stripped), src, callees)
    } else { if tag == 64 {
      pipeline_ir_node_direct_effect_named_handler_collect(node_f1(stripped), node_f2(stripped), node_f3(stripped), src, callees)
    } else { if tag == 41 {
      pipeline_ir_effect_flags_merge(2, pipeline_ir_effect_flags_merge(pipeline_ir_node_direct_effect_expr_collect(node_f1(stripped), src, callees), pipeline_ir_node_direct_effect_expr_list_collect(node_f3(stripped), 0, nlist_len(node_f3(stripped)), src, callees)))
    } else { if tag == 46 {
      pipeline_ir_effect_flags_merge(pipeline_ir_node_direct_effect_expr_collect(node_f1(stripped), src, callees), pipeline_ir_node_direct_effect_expr_collect(node_f2(stripped), src, callees))
    } else { if tag == 47 {
      pipeline_ir_effect_flags_merge(pipeline_ir_node_direct_effect_expr_collect(node_f3(stripped), src, callees), pipeline_ir_node_direct_effect_expr_collect(node_f4(stripped), src, callees))
    } else { if tag == 52 {
      pipeline_ir_effect_flags_merge(pipeline_ir_node_direct_effect_expr_collect(node_f1(stripped), src, callees), pipeline_ir_node_direct_effect_expr_collect(node_f2(stripped), src, callees))
    } else { if tag == 55 {
      pipeline_ir_effect_flags_merge(2, pipeline_ir_node_direct_effect_expr_collect(node_f2(stripped), src, callees))
    } else { if tag == 57 {
      pipeline_ir_effect_flags_merge(2, pipeline_ir_effect_flags_merge(pipeline_ir_node_direct_effect_expr_collect(node_f1(stripped), src, callees), pipeline_ir_node_direct_effect_expr_collect(node_f2(stripped), src, callees)))
    } else {
      2
    } } } } } } } } } } } } } } } } } } } } } } } } } } } } } }
  }
}

pub(package) fn pipeline_ir_typed_effect_summary_list_from_fns(fns: i64, user_src: i64) -> i64 {
  let mut result = 0
  let seen = alloc_words(1)
  mem_store64_at(seen, 0, 0)
  let n = nlist_len(fns)
  for i in 0..n {
    let pair = nlist_get(fns, i)
    let fn_wrap = node_f1(pair)
    if (user_src == 0 or node_f2(pair) == user_src) and pipeline_decl_node_is_function(fn_wrap) == 1 {
      let fn_src = node_f2(pair)
      let inner = pipeline_fn_inner(fn_wrap)
      let hash = str_hash(fn_src, node_f1(inner), node_f2(inner))
      let callees = nlist_new()
      let flags = pipeline_ir_node_direct_effect_expr_collect(node_f4(inner), fn_src, callees)
      if pipeline_ir_hash_tree_add_unique(seen, hash) == 1 {
        result = pipeline_ir_effect_summary_prepend(hash, flags, callees, result)
      } else {
        pipeline_ir_effect_summary_merge_into(hash, flags, callees, result)
      }
    } else { 0 }
  }
  result
}

pub(package) fn pipeline_ir_typed_effect_flags_once(fns: i64, user_src: i64, old_flags: i64) -> i64 {
  let mut next_flags = 0
  let mut changed = 0
  let n = nlist_len(fns)
  for i in 0..n {
    let pair = nlist_get(fns, i)
    let decl = decl_from_node(node_f1(pair))
    if (user_src == 0 or node_f2(pair) == user_src) and decl_is_function(decl) == 1 {
      let fn_src = node_f2(pair)
      let hash = str_hash(fn_src, decl_name_start_or(decl, 0), decl_name_len_or(decl, 0))
      let old = pipeline_ir_effect_flag_map_lookup(old_flags, hash)
      let body_flags = pipeline_ir_typed_effect_decl_flags(decl, fn_src, old_flags)
      let flags = pipeline_ir_effect_flags_merge(old, body_flags)
      if flags != old { changed = 1 } else { 0 }
      next_flags = pipeline_ir_effect_flag_map_prepend(hash, flags, next_flags)
    } else { 0 }
  }
  node_new(0, next_flags, changed, 0, 0)
}

pub(package) fn pipeline_ir_typed_effect_flags_fixpoint(fns: i64, user_src: i64, old_flags: i64) -> i64 {
  let summaries = pipeline_ir_typed_effect_summary_list_from_fns(fns, user_src)
  pipeline_ir_effect_summary_flags_fixpoint(summaries, old_flags)
}

pub(package) fn pipeline_ir_borrow_env_lookup(env: PipelineIrBorrowEnv, src: i64, ns: i64, nl: i64) -> IrBorrowSummary {
  match env {
    PipelineIrBorrowEnvNil -> ir_borrow_summary_unknown()
    PipelineIrBorrowEnvCons(bns, bnl, summary, rest) -> {
      if pipeline_name_matches(src, ns, nl, bns, bnl) { summary }
      else { pipeline_ir_borrow_env_lookup(rest, src, ns, nl) }
    }
  }
}

pub(package) fn pipeline_ir_borrow_env_push(env: PipelineIrBorrowEnv, ns: i64, nl: i64, summary: IrBorrowSummary) -> PipelineIrBorrowEnv {
  PipelineIrBorrowEnvCons(ns, nl, summary, env)
}

pub(package) fn pipeline_ir_borrow_param_logical_index(params: i64, src: i64, ns: i64, nl: i64) -> i64 {
  if params == 0 { 0 - 1 }
  else {
    let mut result = 0 - 1
    let mut i = 0
    while i < nlist_len(params) {
      let param = nlist_get(params, i)
      if node_f2(param) == nl and src_eq_at(src, ns, src + node_f1(param), 0, nl) == 1 {
        result = i
        i = nlist_len(params)
      } else { i = i + 1 }
    }
    result
  }
}

pub(package) fn pipeline_ir_borrow_summary_map_args(indices: IrValueList, args: ExprList, params: i64, env: PipelineIrBorrowEnv, src: i64, fns: i64, tt: i64, visiting: IrValueList) -> IrBorrowSummary {
  match indices {
    IrValueNil -> ir_borrow_summary_known(ir_value_list_empty())
    IrValueCons(index, rest) -> {
      if index < 0 or index >= expr_list_len(args) { ir_borrow_summary_unknown() }
      else {
        let arg = pipeline_expr_list_nth_or(args, index, NilExpr)
        let arg_summary = pipeline_ir_borrow_expr_summary(arg, params, env, src, fns, tt, visiting)
        ir_borrow_summary_union(arg_summary, pipeline_ir_borrow_summary_map_args(rest, args, params, env, src, fns, tt, visiting))
      }
    }
  }
}

pub(package) fn pipeline_ir_borrow_pair_summary(pair: i64, fns: i64, tt: i64, visiting: IrValueList) -> IrBorrowSummary {
  if pair == 0 { ir_borrow_summary_unknown() }
  else {
    let fn_wrap = node_f1(pair)
    let fn_src = node_f2(pair)
    let inner = pipeline_fn_inner(fn_wrap)
    let hash = pipeline_fn_pair_key(pair)
    let name_hash = pipeline_fn_pair_name_hash(pair)
    let native_alias = pipeline_ir_native_exact_alias_param_or(pair, name_hash, 0 - 1, tt)
    if native_alias >= 0 { ir_borrow_summary_known(ir_value_list_prepend(native_alias, ir_value_list_empty())) }
    else { if ir_value_list_contains(visiting, hash) == 1 { ir_borrow_summary_unknown() }
    else {
      let ret_ty = fn_ret_type(fn_wrap)
      if ty_is_slice(ret_ty) or fn_tparams(fn_wrap) != 0 {
        pipeline_ir_borrow_expr_summary(expr_from_node(node_f4(inner)), node_f3(inner), PipelineIrBorrowEnvNil, fn_src, fns, tt, ir_value_list_prepend(hash, visiting))
      } else { ir_borrow_summary_known(ir_value_list_empty()) }
    } }
  }
}

-- IrBorrowSummary is also the source-level dependency engine for the more
-- general return-alias fact. Keep the dependency calculation shared, but do
-- not publish non-slice aliases as slice borrow provenance.
pub(package) fn pipeline_ir_return_alias_mask_from_summary(summary: IrBorrowSummary) -> i64 {
  match summary {
    IrBorrowSummaryUnknown -> 0
    IrBorrowSummaryKnown(indices) -> {
      let mut mask = 0
      let mut cur = indices
      while true {
        match cur {
          IrValueNil -> { return mask }
          IrValueCons(index, rest) -> {
            if index >= 0 and index < 60 { mask = mask bor cg_bit(index) } else { 0 }
            cur = rest
          }
        }
      }
      mask
    }
  }
}

pub(package) fn pipeline_ir_return_alias_params_from_mask(mask: i64, index: i64, limit: i64) -> IrValueList {
  if index >= limit or index >= 60 { ir_value_list_empty() }
  else {
    let rest = pipeline_ir_return_alias_params_from_mask(mask, index + 1, limit)
    if (mask band cg_bit(index)) != 0 { ir_value_list_prepend(index, rest) } else { rest }
  }
}

pub(package) fn pipeline_ir_borrow_call_summary(hash: i64, args: ExprList, params: i64, env: PipelineIrBorrowEnv, src: i64, fns: i64, tt: i64, visiting: IrValueList) -> IrBorrowSummary {
  let pair = pipeline_fns_lookup_pair_by_hash(fns, hash)
  let callee_summary = pipeline_ir_borrow_pair_summary(pair, fns, tt, visiting)
  match callee_summary {
    IrBorrowSummaryUnknown -> ir_borrow_summary_unknown()
    IrBorrowSummaryKnown(indices) -> pipeline_ir_borrow_summary_map_args(indices, args, params, env, src, fns, tt, visiting)
  }
}

pub(package) fn pipeline_ir_borrow_match_arms_summary(arms: MatchArmList, params: i64, env: PipelineIrBorrowEnv, src: i64, fns: i64, tt: i64, visiting: IrValueList) -> IrBorrowSummary {
  match arms {
    MatchArmListNil -> ir_borrow_summary_known(ir_value_list_empty())
    MatchArmListCons(arm, rest) -> {
      let arm_summary = match arm {
        Arm(pattern, body, guard, has_guard) -> pipeline_ir_borrow_expr_summary(body, params, env, src, fns, tt, visiting)
        UnknownArm(tag) -> ir_borrow_summary_unknown()
      }
      ir_borrow_summary_union(arm_summary, pipeline_ir_borrow_match_arms_summary(rest, params, env, src, fns, tt, visiting))
    }
  }
}

pub(package) fn pipeline_ir_borrow_expr_summary(expr: Expr, params: i64, env: PipelineIrBorrowEnv, src: i64, fns: i64, tt: i64, visiting: IrValueList) -> IrBorrowSummary {
  match expr {
    Ident(ns, nl) -> {
      let index = pipeline_ir_borrow_param_logical_index(params, src, ns, nl)
      if index >= 0 { ir_borrow_summary_known(ir_value_list_prepend(index, ir_value_list_empty())) }
      else { pipeline_ir_borrow_env_lookup(env, src, ns, nl) }
    }
    Call(ns, nl, args) -> pipeline_ir_borrow_call_summary(pipeline_fns_resolved_key(fns, tt, src, ns, nl), args, params, env, src, fns, tt, visiting)
    GenericCall(type_args, inner_call) -> pipeline_ir_borrow_expr_summary(inner_call, params, env, src, fns, tt, visiting)
    Let(ns, nl, value, body) -> {
      let value_summary = pipeline_ir_borrow_expr_summary(value, params, env, src, fns, tt, visiting)
      pipeline_ir_borrow_expr_summary(body, params, pipeline_ir_borrow_env_push(env, ns, nl, value_summary), src, fns, tt, visiting)
    }
    -- Mutation can replace the owner after the initializer; retain no stale
    -- provenance until the later borrow checker proves a single assignment.
    LetMut(ns, nl, value, body) -> pipeline_ir_borrow_expr_summary(body, params, pipeline_ir_borrow_env_push(env, ns, nl, ir_borrow_summary_unknown()), src, fns, tt, visiting)
    LetTyped(inner, ann_type) -> pipeline_ir_borrow_expr_summary(inner, params, env, src, fns, tt, visiting)
    Block(first, rest) -> pipeline_ir_borrow_expr_summary(rest, params, env, src, fns, tt, visiting)
    Defer(cleanup, body, source_site) -> pipeline_ir_borrow_expr_summary(body, params, env, src, fns, tt, visiting)
    Return(value) -> pipeline_ir_borrow_expr_summary(value, params, env, src, fns, tt, visiting)
    Resume(value) -> pipeline_ir_borrow_expr_summary(value, params, env, src, fns, tt, visiting)
    FieldAccess(base, field_ns, field_nl, fact) -> pipeline_ir_borrow_expr_summary(base, params, env, src, fns, tt, visiting)
    IndexedLen(base, fixed_len) -> ir_borrow_summary_known(ir_value_list_empty())
    -- Scalar/owned element values carry no borrow. A slice stored inside an
    -- indexed container may refer to storage unrelated to that container, so
    -- retain conservative provenance until aggregate-borrow facts describe it.
    IndexedGet(base, index, element_ty, fixed_len) -> if ty_is_slice(element_ty) { ir_borrow_summary_unknown() } else { ir_borrow_summary_known(ir_value_list_empty()) }
    IndexedSet(base, index, value, fact) -> ir_borrow_summary_known(ir_value_list_empty())
    IndexedSlice(base, start, end, fact) -> pipeline_ir_borrow_expr_summary(base, params, env, src, fns, tt, visiting)
    OptChain(base, field_ns, field_nl, effect_atom) -> pipeline_ir_borrow_expr_summary(base, params, env, src, fns, tt, visiting)
    If(cond, then_expr, else_expr) -> ir_borrow_summary_union(
      pipeline_ir_borrow_expr_summary(then_expr, params, env, src, fns, tt, visiting),
      pipeline_ir_borrow_expr_summary(else_expr, params, env, src, fns, tt, visiting)
    )
    Match(scrutinee, arms) -> pipeline_ir_borrow_match_arms_summary(arms, params, env, src, fns, tt, visiting)
    Handle(body, clauses, hret) -> {
      let body_summary = pipeline_ir_borrow_expr_summary(body, params, env, src, fns, tt, visiting)
      match hret {
        NoHandleReturn -> body_summary
        HandleReturnClause(rns, rnl, rb) -> pipeline_ir_borrow_expr_summary(rb, params, pipeline_ir_borrow_env_push(env, rns, rnl, body_summary), src, fns, tt, visiting)
      }
    }
    WithHandler(config, body, fact, source_site) -> pipeline_ir_borrow_expr_summary(body, params, env, src, fns, tt, visiting)
    _ -> ir_borrow_summary_unknown()
  }
}

-- Signature-side borrow facts are the root of the provenance graph. Logical
-- parameters retain their source indices while physical heads use the shared
-- value-shape ABI offsets, so later call-summary substitution never guesses
-- how many machine words precede a slice.
pub(package) fn pipeline_ir_borrow_facts_for_signature(params: i64, ret_ty: i64) -> IrBorrowFacts {
  let mut param_facts = ir_borrow_param_facts_empty()
  let mut value_facts = ir_borrow_value_facts_empty()
  let n = if params == 0 { 0 } else { nlist_len(params) }
  for i in 0..n {
    let ty = node_f3(nlist_get(params, i))
    if ty_is_slice(ty) {
      let head = pipeline_param_value_index_at(params, i)
      let mutable = ty_slice_mutable(ty)
      let origin = ir_borrow_origin(ir_borrow_owner_parameter(i), head, head + 1, mutable)
      let origins = ir_borrow_origin_list_prepend(origin, ir_borrow_origin_list_empty())
      param_facts = ir_borrow_param_facts_prepend(i, head, mutable, param_facts)
      value_facts = ir_borrow_value_facts_prepend(head, origins, value_facts)
    } else { 0 }
  }
  let return_mutability = if ty_is_slice(ret_ty) { ty_slice_mutable(ret_ty) } else { 0 - 1 }
  let summary = if return_mutability >= 0 { ir_borrow_summary_unknown() }
    else { ir_borrow_summary_known(ir_value_list_empty()) }
  ir_borrow_facts_new(param_facts, value_facts, return_mutability, summary)
}

pub(package) fn pipeline_ir_borrow_summary_shift_values(values: IrValueList, offset: i64) -> IrValueList {
  match values {
    IrValueNil -> ir_value_list_empty()
    IrValueCons(value, rest) -> ir_value_list_prepend(value + offset, pipeline_ir_borrow_summary_shift_values(rest, offset))
  }
}

pub(package) fn pipeline_ir_borrow_summary_shift(summary: IrBorrowSummary, offset: i64) -> IrBorrowSummary {
  match summary {
    IrBorrowSummaryUnknown -> ir_borrow_summary_unknown()
    IrBorrowSummaryKnown(values) -> ir_borrow_summary_known(pipeline_ir_borrow_summary_shift_values(values, offset))
  }
}

pub(package) fn pipeline_ir_lambda_abi_params(lambda_params: ParamList) -> i64 {
  let source_params = param_list_to_nodes(lambda_params)
  let source_count = if source_params == 0 { 0 } else { nlist_len(source_params) }
  let params = nlist_new_capacity(source_count + 1)
  -- Hidden closure environment parameter. It is an unmanaged ABI word and is
  -- logical parameter zero for direct-call summary substitution.
  nlist_add(params, node_new(0, 0, 0, ty_i64(), 0))
  for i in 0..source_count { nlist_add(params, nlist_get(source_params, i)) }
  params
}

pub(package) fn pipeline_ir_lambda_capture_borrow_values(captures: i64, base: i64, values: IrBorrowValueFactList) -> IrBorrowValueFactList {
  let mut result = values
  let mut word = 0
  let count = if captures == 0 { 0 } else { nlist_len(captures) }
  for i in 0..count {
    let capture = nlist_get(captures, i)
    let ty = node_f4(capture)
    if ty_is_slice(ty) {
      let head = base + word
      result = ir_borrow_value_facts_set(result, head, pipeline_ir_borrow_unknown_origins(head, ty_slice_mutable(ty)))
    } else { 0 }
    word = word + pipeline_capture_lane_count(capture)
  }
  result
}

pub(package) fn pipeline_ir_lambda_semantic_facts(lambda_params: ParamList, lambda_body: Expr, captures: i64, src: i64, fns: i64, tt: i64, ret_ty: i64, capture_base: i64, evidence: IrLambdaEvidence) -> IrLambdaSemanticFacts {
  let source_params = param_list_to_nodes(lambda_params)
  let abi_params = pipeline_ir_lambda_abi_params(lambda_params)
  let signature = pipeline_ir_borrow_facts_for_signature(abi_params, ret_ty)
  let summary = if ty_is_slice(ret_ty) {
    pipeline_ir_borrow_summary_shift(
      pipeline_ir_borrow_expr_summary(lambda_body, source_params, PipelineIrBorrowEnvNil, src, fns, tt, ir_value_list_empty()),
      1
    )
  } else { ir_borrow_summary_known(ir_value_list_empty()) }
  let borrow_with_summary = ir_borrow_facts_with_summary(signature, summary)
  let borrow = ir_borrow_facts_with_values(
    borrow_with_summary,
    pipeline_ir_lambda_capture_borrow_values(captures, capture_base, ir_borrow_facts_values(borrow_with_summary))
  )
  -- Lambdas do not yet carry their inferred effect set as a first-class
  -- source node. Publish an open (therefore never assumed pure) effect summary
  -- while still making parameter/return shapes and ownership exact.
  let effect_summary = cg_semantic_effect_summary_new(0, 0, 0, 0)
  let fact = cg_semantic_fact_new_with_effect_summary(0, effect_summary, abi_params, ret_ty, 0, 0)
  ir_lambda_semantic_facts(evidence, fact, borrow)
}

pub(package) fn pipeline_ir_borrow_aggregate_empty() -> PipelineIrBorrowAggregateFactList {
  PipelineIrBorrowAggregateFactNil
}

pub(package) fn pipeline_ir_borrow_aggregate_find(facts: PipelineIrBorrowAggregateFactList, base: i64, offset: i64) -> IrBorrowOriginList {
  match facts {
    PipelineIrBorrowAggregateFactNil -> ir_borrow_origin_list_empty()
    PipelineIrBorrowAggregateFactCons(fact_base, fact_offset, origins, rest) -> {
      if fact_base == base and fact_offset == offset { origins }
      else { pipeline_ir_borrow_aggregate_find(rest, base, offset) }
    }
  }
}

pub(package) fn pipeline_ir_borrow_aggregate_set(facts: PipelineIrBorrowAggregateFactList, base: i64, offset: i64, origins: IrBorrowOriginList) -> PipelineIrBorrowAggregateFactList {
  match facts {
    PipelineIrBorrowAggregateFactNil -> PipelineIrBorrowAggregateFactCons(base, offset, origins, PipelineIrBorrowAggregateFactNil)
    PipelineIrBorrowAggregateFactCons(fact_base, fact_offset, current, rest) -> {
      if fact_base == base and fact_offset == offset { PipelineIrBorrowAggregateFactCons(base, offset, origins, rest) }
      else { PipelineIrBorrowAggregateFactCons(fact_base, fact_offset, current, pipeline_ir_borrow_aggregate_set(rest, base, offset, origins)) }
    }
  }
}

pub(package) fn pipeline_ir_borrow_pass_new(values: IrBorrowValueFactList) -> PipelineIrBorrowValuePass {
  PipelineIrBorrowValuePass(values, ir_borrow_value_facts_empty(), pipeline_ir_borrow_aggregate_empty(), 0)
}

pub(package) fn pipeline_ir_borrow_pass_values(pass: PipelineIrBorrowValuePass) -> IrBorrowValueFactList {
  match pass { PipelineIrBorrowValuePass(values, slots, aggregates, changed) -> values }
}

pub(package) fn pipeline_ir_borrow_pass_slots(pass: PipelineIrBorrowValuePass) -> IrBorrowValueFactList {
  match pass { PipelineIrBorrowValuePass(values, slots, aggregates, changed) -> slots }
}

pub(package) fn pipeline_ir_borrow_pass_aggregates(pass: PipelineIrBorrowValuePass) -> PipelineIrBorrowAggregateFactList {
  match pass { PipelineIrBorrowValuePass(values, slots, aggregates, changed) -> aggregates }
}

pub(package) fn pipeline_ir_borrow_pass_changed(pass: PipelineIrBorrowValuePass) -> i64 {
  match pass { PipelineIrBorrowValuePass(values, slots, aggregates, changed) -> changed }
}

pub(package) fn pipeline_ir_borrow_pass_clear_changed(pass: PipelineIrBorrowValuePass) -> PipelineIrBorrowValuePass {
  match pass { PipelineIrBorrowValuePass(values, slots, aggregates, changed) -> PipelineIrBorrowValuePass(values, slots, aggregates, 0) }
}

pub(package) fn pipeline_ir_borrow_unknown_origins(head: i64, mutable: i64) -> IrBorrowOriginList {
  ir_borrow_origin_list_prepend(
    ir_borrow_origin(ir_borrow_owner_unknown(), head, head + 1, mutable),
    ir_borrow_origin_list_empty()
  )
}

pub(package) fn pipeline_ir_borrow_pass_merge_value(pass: PipelineIrBorrowValuePass, value: i64, incoming: IrBorrowOriginList, mutable: i64) -> PipelineIrBorrowValuePass {
  match pass {
    PipelineIrBorrowValuePass(values, slots, aggregates, changed) -> {
      let current = ir_borrow_value_facts_find(values, value)
      let next = ir_borrow_origin_list_union_rebased_mutable(incoming, current, value, mutable)
      if ir_borrow_origin_list_set_eq(current, next) == 1 { pass }
      else { PipelineIrBorrowValuePass(ir_borrow_value_facts_set(values, value, next), slots, aggregates, 1) }
    }
  }
}

pub(package) fn pipeline_ir_borrow_pass_merge_slot(pass: PipelineIrBorrowValuePass, slot: i64, incoming: IrBorrowOriginList) -> PipelineIrBorrowValuePass {
  match pass {
    PipelineIrBorrowValuePass(values, slots, aggregates, changed) -> {
      let current = ir_borrow_value_facts_find(slots, slot)
      let next = ir_borrow_origin_list_union_rebased(incoming, current, slot)
      if ir_borrow_origin_list_set_eq(current, next) == 1 { pass }
      else { PipelineIrBorrowValuePass(values, ir_borrow_value_facts_set(slots, slot, next), aggregates, 1) }
    }
  }
}

pub(package) fn pipeline_ir_borrow_pass_merge_aggregate(pass: PipelineIrBorrowValuePass, base: i64, offset: i64, incoming: IrBorrowOriginList) -> PipelineIrBorrowValuePass {
  match pass {
    PipelineIrBorrowValuePass(values, slots, aggregates, changed) -> {
      let current = pipeline_ir_borrow_aggregate_find(aggregates, base, offset)
      -- Aggregate storage does not become the owner. Preserve the source SSA
      -- pair in the fact and rebase only when a projection creates a new pair.
      let next = ir_borrow_origin_list_union(incoming, current)
      if ir_borrow_origin_list_set_eq(current, next) == 1 { pass }
      else { PipelineIrBorrowValuePass(values, slots, pipeline_ir_borrow_aggregate_set(aggregates, base, offset, next), 1) }
    }
  }
}

pub(package) fn pipeline_ir_borrow_call_map_origins(indices: IrValueList, args: IrValueList, params: i64, values: IrBorrowValueFactList, dst: i64, mutable: i64, result: IrBorrowOriginList) -> IrBorrowOriginList {
  match indices {
    IrValueNil -> result
    IrValueCons(index, rest) -> {
      let physical = if params == 0 or index < 0 or index >= nlist_len(params) { 0 - 1 } else { pipeline_param_value_index_at(params, index) }
      let arg = if physical < 0 { 0 - 1 } else { ir_value_list_nth_or(args, physical, 0 - 1) }
      let incoming = if arg < 0 { ir_borrow_origin_list_empty() } else { ir_borrow_value_facts_find(values, arg) }
      let next = match incoming {
        IrBorrowOriginNil -> ir_borrow_origin_list_add_unique(result, ir_borrow_origin(ir_borrow_owner_unknown(), dst, dst + 1, mutable))
        _ -> ir_borrow_origin_list_union_rebased_mutable(incoming, result, dst, mutable)
      }
      pipeline_ir_borrow_call_map_origins(rest, args, params, values, dst, mutable, next)
    }
  }
}

pub(package) fn pipeline_ir_borrow_call_origins(callee_hash: i64, args: IrValueList, dst: i64, facts: PipelineIrSemanticFactList, values: IrBorrowValueFactList) -> IrBorrowOriginList {
  let borrow = pipeline_ir_semantic_borrow_fact_find(facts, callee_hash)
  let mutable = ir_borrow_facts_return_mutability(borrow)
  if mutable < 0 { ir_borrow_origin_list_empty() }
  else {
    match ir_borrow_facts_summary(borrow) {
      IrBorrowSummaryUnknown -> pipeline_ir_borrow_unknown_origins(dst, mutable)
      IrBorrowSummaryKnown(indices) -> {
        let fact = pipeline_ir_semantic_fact_find(facts, callee_hash)
        let params = if fact == 0 { 0 } else { cg_semantic_fact_param_shapes(fact) }
        let mapped = pipeline_ir_borrow_call_map_origins(indices, args, params, values, dst, mutable, ir_borrow_origin_list_empty())
        match mapped {
          IrBorrowOriginNil -> pipeline_ir_borrow_unknown_origins(dst, mutable)
          _ -> mapped
        }
      }
    }
  }
}

pub(package) fn pipeline_ir_borrow_pass_direct_call(pass: PipelineIrBorrowValuePass, dst: i64, callee_hash: i64, args: IrValueList, facts: PipelineIrSemanticFactList) -> PipelineIrBorrowValuePass {
  let slice_mutable = pipeline_runtime_slice_address_mutability(callee_hash)
  if slice_mutable >= 0 {
    let owner = pipeline_ir_value_list_get_or(args, 0, 0 - 1)
    let incoming = if owner < 0 { ir_borrow_origin_list_empty() }
      else { ir_borrow_value_facts_find(pipeline_ir_borrow_pass_values(pass), owner) }
    let origins = match incoming {
      IrBorrowOriginNil -> ir_borrow_origin_list_prepend(ir_borrow_origin(ir_borrow_owner_value(owner), dst, dst + 1, slice_mutable), ir_borrow_origin_list_empty())
      _ -> ir_borrow_origin_list_union_rebased_mutable(incoming, ir_borrow_origin_list_empty(), dst, slice_mutable)
    }
    pipeline_ir_borrow_pass_merge_value(pass, dst, origins, slice_mutable)
  } else {
    let origins = pipeline_ir_borrow_call_origins(callee_hash, args, dst, facts, pipeline_ir_borrow_pass_values(pass))
    match origins {
      IrBorrowOriginNil -> pass
      _ -> pipeline_ir_borrow_pass_merge_value(pass, dst, origins, 0 - 1)
    }
  }
}

pub(package) fn pipeline_ir_borrow_pass_record_fields(pass: PipelineIrBorrowValuePass, base: i64, fields: IrRecordFieldList) -> PipelineIrBorrowValuePass {
  match fields {
    IrRecordFieldNil -> pass
    IrRecordFieldCons(field_hash, offset, value, rest) -> {
      let origins = ir_borrow_value_facts_find(pipeline_ir_borrow_pass_values(pass), value)
      let next = match origins {
        IrBorrowOriginNil -> pass
        _ -> pipeline_ir_borrow_pass_merge_aggregate(pass, base, offset, origins)
      }
      pipeline_ir_borrow_pass_record_fields(next, base, rest)
    }
  }
}

pub(package) fn pipeline_ir_borrow_pass_record_layout_fields(pass: PipelineIrBorrowValuePass, base: i64, fields: IrRecordLayoutFieldList) -> PipelineIrBorrowValuePass {
  match fields {
    IrRecordLayoutFieldNil -> pass
    IrRecordLayoutFieldWord(field_hash, byte_offset, value, managed_kind, rest) -> {
      let origins = ir_borrow_value_facts_find(pipeline_ir_borrow_pass_values(pass), value)
      let next = match origins {
        IrBorrowOriginNil -> pass
        _ -> pipeline_ir_borrow_pass_merge_aggregate(pass, base, byte_offset, origins)
      }
      pipeline_ir_borrow_pass_record_layout_fields(next, base, rest)
    }
    IrRecordLayoutFieldArray(field_hash, byte_offset, data, byte_size, leaf_count, leaf_stride, leaf_kind, rest) -> pipeline_ir_borrow_pass_record_layout_fields(pass, base, rest)
  }
}

pub(package) fn pipeline_ir_borrow_pass_variant_payloads(pass: PipelineIrBorrowValuePass, base: i64, payloads: IrValueList, offset: i64) -> PipelineIrBorrowValuePass {
  match payloads {
    IrValueNil -> pass
    IrValueCons(value, rest) -> {
      let origins = ir_borrow_value_facts_find(pipeline_ir_borrow_pass_values(pass), value)
      let next = match origins {
        IrBorrowOriginNil -> pass
        _ -> pipeline_ir_borrow_pass_merge_aggregate(pass, base, offset, origins)
      }
      pipeline_ir_borrow_pass_variant_payloads(next, base, rest, offset + 1)
    }
  }
}

pub(package) fn pipeline_ir_borrow_insts_start_field_pair(rest: IrInstList, dst: i64, base: i64, field_hash: i64, offset: i64) -> i64 {
  match rest {
    IrInstCons(next, tail) -> match next {
      IrFieldLoadI64(next_dst, next_base, next_hash, next_offset) -> if next_dst == dst + 1 and next_base == base and next_hash == field_hash and next_offset == offset + 1 { 1 } else { 0 }
      _ -> 0
    }
    _ -> 0
  }
}

pub(package) fn pipeline_ir_borrow_insts_start_record_layout_word_pair(rest: IrInstList, dst: i64, base: i64, field_hash: i64, byte_offset: i64) -> i64 {
  match rest {
    IrInstCons(next, tail) -> match next {
      IrRecordLayoutWordLoadI64(next_dst, next_base, record_data_size, next_hash, next_offset) -> if next_dst == dst + 1 and next_base == base and next_hash == field_hash and next_offset == byte_offset + 8 { 1 } else { 0 }
      _ -> 0
    }
    _ -> 0
  }
}

pub(package) fn pipeline_ir_borrow_insts_start_variant_pair(rest: IrInstList, dst: i64, base: i64, offset: i64) -> i64 {
  match rest {
    IrInstCons(next, tail) -> match next {
      IrVariantPayloadI64(next_dst, next_base, next_offset) -> if next_dst == dst + 1 and next_base == base and next_offset == offset + 1 { 1 } else { 0 }
      _ -> 0
    }
    _ -> 0
  }
}

pub(package) fn pipeline_ir_borrow_insts_start_load_pair(rest: IrInstList, dst: i64, slot: i64) -> i64 {
  match rest {
    IrInstCons(next, tail) -> match next {
      IrLoadI64(next_dst, next_slot) -> if next_dst == dst + 1 and next_slot == slot + 1 { 1 } else { 0 }
      _ -> 0
    }
    _ -> 0
  }
}

pub(package) fn pipeline_ir_borrow_pass_handler_clauses(clauses: IrHandlerClauseBodyList, pass: PipelineIrBorrowValuePass, facts: PipelineIrSemanticFactList) -> PipelineIrBorrowValuePass {
  match clauses {
    IrHandlerClauseBodyNil -> pass
    IrHandlerClauseBodyCons(body, rest) -> {
      let next = match body {
        IrHandlerClauseBody(op_hash, nparams, captures, has_continuation, is_abortive, result_cleanup_kind, transferred_param_value_fact, resume_lanes, result_lanes, first_value, blocks) -> pipeline_ir_borrow_pass_blocks_once(blocks, pass, facts)
        IrHandlerClauseBodyInvalid(reason) -> pass
      }
      pipeline_ir_borrow_pass_handler_clauses(rest, next, facts)
    }
  }
}

pub(package) fn pipeline_ir_borrow_pass_deferred_body(body: IrDeferredHandlerBody, pass: PipelineIrBorrowValuePass, facts: PipelineIrSemanticFactList) -> PipelineIrBorrowValuePass {
  match body {
    IrDeferredHandlerBody(body_src, captures, ops_value, result_lanes, first_value, blocks, completion) -> {
      let body_pass = pipeline_ir_borrow_pass_blocks_once(blocks, pass, facts)
      match completion {
        IrDeferredCompletionBodyNone -> body_pass
        IrDeferredCompletionBody(input_lanes, output_lanes, completion_first_value, completion_blocks) -> pipeline_ir_borrow_pass_blocks_once(completion_blocks, body_pass, facts)
        IrDeferredCompletionBodyInvalid(reason) -> body_pass
      }
    }
    IrDeferredHandlerBodyInvalid(reason) -> pass
  }
}

pub(package) fn pipeline_ir_borrow_pass_insts(insts: IrInstList, pass: PipelineIrBorrowValuePass, facts: PipelineIrSemanticFactList) -> PipelineIrBorrowValuePass {
  match insts {
    IrInstNil -> pass
    IrInstCons(inst, rest) -> {
      let next = match inst {
        IrCallI64(dst, callee_hash, args) -> pipeline_ir_borrow_pass_direct_call(pass, dst, callee_hash, args, facts)
        IrGenericCallI64(dst, callee_hash, type_args, args) -> {
          let spec_hash = mono_spec_hash(callee_hash, type_expr_list_to_nodes(type_args))
          pipeline_ir_borrow_pass_direct_call(pass, dst, spec_hash, args, facts)
        }
        IrMethodCallI64(dst, type_hash, method_hash, receiver, args) -> {
          let qualified = pipeline_ir_method_patch_key(type_hash, method_hash)
          let callee_hash = if pipeline_ir_semantic_fact_find(facts, qualified) != 0 { qualified } else { method_hash }
          pipeline_ir_borrow_pass_direct_call(pass, dst, callee_hash, ir_value_list_prepend(receiver, args), facts)
        }
        IrCallResultLaneI64(dst, lane) -> {
          let head = ir_call_result_lane_head(dst, lane)
          if ir_call_result_lane_physical(lane) == 1 and ir_borrow_origin_list_len(ir_borrow_value_facts_find(pipeline_ir_borrow_pass_values(pass), head)) == 0 {
            pipeline_ir_borrow_pass_merge_value(pass, head, pipeline_ir_borrow_unknown_origins(head, 0), 0 - 1)
          } else { pass }
        }
        IrStoreI64(slot, value) -> {
          let origins = ir_borrow_value_facts_find(pipeline_ir_borrow_pass_values(pass), value)
          match origins { IrBorrowOriginNil -> pass _ -> pipeline_ir_borrow_pass_merge_slot(pass, slot, origins) }
        }
        IrLoadI64(dst, slot) -> {
          let origins = ir_borrow_value_facts_find(pipeline_ir_borrow_pass_slots(pass), slot)
          match origins {
            IrBorrowOriginNil -> if pipeline_ir_borrow_insts_start_load_pair(rest, dst, slot) == 1 { pipeline_ir_borrow_pass_merge_value(pass, dst, pipeline_ir_borrow_unknown_origins(dst, 0), 0 - 1) } else { pass }
            _ -> pipeline_ir_borrow_pass_merge_value(pass, dst, origins, 0 - 1)
          }
        }
        IrRecordInitI64(dst, type_hash, fields) -> pipeline_ir_borrow_pass_record_fields(pass, dst, fields)
        IrRecordLayoutInitI64(dst, type_hash, data_size, align, fields) -> pipeline_ir_borrow_pass_record_layout_fields(pass, dst, fields)
        IrVariantInitI64(dst, tag_hash, payloads, field_mask) -> pipeline_ir_borrow_pass_variant_payloads(pass, dst, payloads, 0)
        IrRecordLayoutWordLoadI64(dst, base, record_data_size, field_hash, byte_offset) -> {
          let origins = pipeline_ir_borrow_aggregate_find(pipeline_ir_borrow_pass_aggregates(pass), base, byte_offset)
          match origins {
            IrBorrowOriginNil -> if pipeline_ir_borrow_insts_start_record_layout_word_pair(rest, dst, base, field_hash, byte_offset) == 1 { pipeline_ir_borrow_pass_merge_value(pass, dst, pipeline_ir_borrow_unknown_origins(dst, 0), 0 - 1) } else { pass }
            _ -> pipeline_ir_borrow_pass_merge_value(pass, dst, origins, 0 - 1)
          }
        }
        IrFieldLoadI64(dst, base, field_hash, offset) -> {
          let origins = pipeline_ir_borrow_aggregate_find(pipeline_ir_borrow_pass_aggregates(pass), base, offset)
          match origins {
            IrBorrowOriginNil -> if pipeline_ir_borrow_insts_start_field_pair(rest, dst, base, field_hash, offset) == 1 { pipeline_ir_borrow_pass_merge_value(pass, dst, pipeline_ir_borrow_unknown_origins(dst, 0), 0 - 1) } else { pass }
            _ -> pipeline_ir_borrow_pass_merge_value(pass, dst, origins, 0 - 1)
          }
        }
        IrVariantPayloadI64(dst, base, offset) -> {
          let origins = pipeline_ir_borrow_aggregate_find(pipeline_ir_borrow_pass_aggregates(pass), base, offset)
          match origins {
            IrBorrowOriginNil -> if pipeline_ir_borrow_insts_start_variant_pair(rest, dst, base, offset) == 1 { pipeline_ir_borrow_pass_merge_value(pass, dst, pipeline_ir_borrow_unknown_origins(dst, 0), 0 - 1) } else { pass }
            _ -> pipeline_ir_borrow_pass_merge_value(pass, dst, origins, 0 - 1)
          }
        }
        IrHandleI64(dst, handle_src, effect_hash, clauses, nclauses, abort_block) -> pipeline_ir_borrow_pass_handler_clauses(clauses, pass, facts)
        IrDeferredHandleI64(dst, handle_src, body, clauses, nclauses, effect_hash, scratch_base) -> pipeline_ir_borrow_pass_deferred_body(body, pipeline_ir_borrow_pass_handler_clauses(clauses, pass, facts), facts)
        _ -> pass
      }
      pipeline_ir_borrow_pass_insts(rest, next, facts)
    }
  }
}

pub(package) fn pipeline_ir_borrow_pass_jump_args(args: IrValueList, params: IrValueList, pass: PipelineIrBorrowValuePass) -> PipelineIrBorrowValuePass {
  match args {
    IrValueNil -> pass
    IrValueCons(arg, arg_rest) -> {
      match params {
        IrValueNil -> pass
        IrValueCons(param, param_rest) -> {
          let origins = ir_borrow_value_facts_find(pipeline_ir_borrow_pass_values(pass), arg)
          let next = match origins { IrBorrowOriginNil -> pass _ -> pipeline_ir_borrow_pass_merge_value(pass, param, origins, 0 - 1) }
          pipeline_ir_borrow_pass_jump_args(arg_rest, param_rest, next)
        }
      }
    }
  }
}

-- Block ids are stable within one function. Build their parameter lookup once
-- per borrow round instead of recursively scanning the whole block list at
-- every jump (the old O(rounds * blocks^2) self-compile wall).
pub(package) fn pipeline_ir_borrow_block_param_index_insert(index: PipelineIrBorrowBlockParamIndex, block_id: i64, params: IrValueList, bit: i64) -> PipelineIrBorrowBlockParamIndex {
  if bit >= 8 {
    match index {
      PipelineIrBorrowBlockParamIndexNil -> PipelineIrBorrowBlockParamIndexLeaf(block_id, params, PipelineIrBorrowBlockParamIndexNil)
      PipelineIrBorrowBlockParamIndexLeaf(entry_id, entry_params, rest) -> {
        if entry_id == block_id { PipelineIrBorrowBlockParamIndexLeaf(block_id, params, rest) }
        else { PipelineIrBorrowBlockParamIndexLeaf(entry_id, entry_params, pipeline_ir_borrow_block_param_index_insert(rest, block_id, params, bit)) }
      }
      _ -> index
    }
  } else {
    let high = (block_id bshr bit) band 1
    match index {
      PipelineIrBorrowBlockParamIndexNil -> {
        if high == 0 {
          PipelineIrBorrowBlockParamIndexBranch(pipeline_ir_borrow_block_param_index_insert(PipelineIrBorrowBlockParamIndexNil, block_id, params, bit + 1), PipelineIrBorrowBlockParamIndexNil)
        } else {
          PipelineIrBorrowBlockParamIndexBranch(PipelineIrBorrowBlockParamIndexNil, pipeline_ir_borrow_block_param_index_insert(PipelineIrBorrowBlockParamIndexNil, block_id, params, bit + 1))
        }
      }
      PipelineIrBorrowBlockParamIndexBranch(low, upper) -> {
        if high == 0 { PipelineIrBorrowBlockParamIndexBranch(pipeline_ir_borrow_block_param_index_insert(low, block_id, params, bit + 1), upper) }
        else { PipelineIrBorrowBlockParamIndexBranch(low, pipeline_ir_borrow_block_param_index_insert(upper, block_id, params, bit + 1)) }
      }
      _ -> index
    }
  }
}

pub(package) fn pipeline_ir_borrow_block_param_map(blocks: IrBlockList) -> PipelineIrBorrowBlockParamIndex {
  let mut map = PipelineIrBorrowBlockParamIndexNil
  let mut current = blocks
  let mut walking = 1
  while walking == 1 {
    match current {
      IrBlockListNil -> { walking = 0 }
      IrBlockListCons(block, rest) -> {
        match block {
          IrBlock(id, params, insts, term) -> { map = pipeline_ir_borrow_block_param_index_insert(map, id, params, 0) }
        }
        current = rest
      }
    }
  }
  map
}

pub(package) fn pipeline_ir_borrow_block_params_for_id(map: PipelineIrBorrowBlockParamIndex, block_id: i64) -> IrValueList {
  let mut current = map
  let mut bit = 0
  let mut result = ir_value_list_empty()
  let mut walking = 1
  while walking == 1 {
    match current {
      PipelineIrBorrowBlockParamIndexNil -> { walking = 0 }
      PipelineIrBorrowBlockParamIndexBranch(low, upper) -> {
        current = if ((block_id bshr bit) band 1) == 0 { low } else { upper }
        bit = bit + 1
      }
      PipelineIrBorrowBlockParamIndexLeaf(entry_id, params, rest) -> {
        if entry_id == block_id { result = params walking = 0 }
        else { current = rest }
      }
    }
  }
  result
}

pub(package) fn pipeline_ir_borrow_pass_blocks_once_inner(blocks: IrBlockList, param_map: PipelineIrBorrowBlockParamIndex, pass: PipelineIrBorrowValuePass, facts: PipelineIrSemanticFactList) -> PipelineIrBorrowValuePass {
  match blocks {
    IrBlockListNil -> pass
    IrBlockListCons(block, rest) -> {
      let next = match block {
        IrBlock(id, params, insts, term) -> {
          let after_insts = pipeline_ir_borrow_pass_insts(insts, pass, facts)
          match term {
            IrTermJump(target, args) -> pipeline_ir_borrow_pass_jump_args(args, pipeline_ir_borrow_block_params_for_id(param_map, target), after_insts)
            _ -> after_insts
          }
        }
      }
      pipeline_ir_borrow_pass_blocks_once_inner(rest, param_map, next, facts)
    }
  }
}

pub(package) fn pipeline_ir_borrow_pass_blocks_once(blocks: IrBlockList, pass: PipelineIrBorrowValuePass, facts: PipelineIrSemanticFactList) -> PipelineIrBorrowValuePass {
  pipeline_ir_borrow_pass_blocks_once_inner(blocks, pipeline_ir_borrow_block_param_map(blocks), pass, facts)
}

pub(package) fn pipeline_ir_borrow_values_for_function(f: IrFunction, borrow: IrBorrowFacts, facts: PipelineIrSemanticFactList) -> IrBorrowFacts {
  match f {
    IrFunction(hash, nparams, blocks, src) -> {
      let mut pass = pipeline_ir_borrow_pass_new(ir_borrow_facts_values(borrow))
      let param_map = pipeline_ir_borrow_block_param_map(blocks)
      let mut budget = (pipeline_ir_function_next_value(nparams, blocks) + 2) * (ir_borrow_param_fact_count(ir_borrow_facts_params(borrow)) + 2) + ir_block_list_len(blocks) + 1
      let mut walking = 1
      while walking == 1 and budget > 0 {
        pass = pipeline_ir_borrow_pass_blocks_once_inner(blocks, param_map, pipeline_ir_borrow_pass_clear_changed(pass), facts)
        if pipeline_ir_borrow_pass_changed(pass) == 0 { walking = 0 } else { 0 }
        budget = budget - 1
      }
      ir_borrow_facts_with_values(borrow, pipeline_ir_borrow_pass_values(pass))
    }
  }
}

pub(package) fn pipeline_ir_borrow_function_index_insert(index: PipelineIrBorrowFunctionIndex, hash: i64, f: IrFunction, bit: i64) -> PipelineIrBorrowFunctionIndex {
  if bit >= 63 {
    match index {
      PipelineIrBorrowFunctionIndexNil -> PipelineIrBorrowFunctionIndexLeaf(hash, f, PipelineIrBorrowFunctionIndexNil)
      PipelineIrBorrowFunctionIndexLeaf(entry_hash, entry, rest) -> {
        if entry_hash == hash { PipelineIrBorrowFunctionIndexLeaf(hash, f, rest) }
        else { PipelineIrBorrowFunctionIndexLeaf(entry_hash, entry, pipeline_ir_borrow_function_index_insert(rest, hash, f, bit)) }
      }
      _ -> index
    }
  } else {
    let high = (hash bshr bit) band 1
    match index {
      PipelineIrBorrowFunctionIndexNil -> {
        if high == 0 {
          PipelineIrBorrowFunctionIndexBranch(pipeline_ir_borrow_function_index_insert(PipelineIrBorrowFunctionIndexNil, hash, f, bit + 1), PipelineIrBorrowFunctionIndexNil)
        } else {
          PipelineIrBorrowFunctionIndexBranch(PipelineIrBorrowFunctionIndexNil, pipeline_ir_borrow_function_index_insert(PipelineIrBorrowFunctionIndexNil, hash, f, bit + 1))
        }
      }
      PipelineIrBorrowFunctionIndexBranch(low, upper) -> {
        if high == 0 { PipelineIrBorrowFunctionIndexBranch(pipeline_ir_borrow_function_index_insert(low, hash, f, bit + 1), upper) }
        else { PipelineIrBorrowFunctionIndexBranch(low, pipeline_ir_borrow_function_index_insert(upper, hash, f, bit + 1)) }
      }
      _ -> index
    }
  }
}

pub(package) fn pipeline_ir_borrow_function_index(functions: IrFunctionList) -> PipelineIrBorrowFunctionIndex {
  let mut index = PipelineIrBorrowFunctionIndexNil
  let mut cur = functions
  let mut walking = 1
  while walking == 1 {
    match cur {
      IrFunctionNil -> { walking = 0 }
      IrFunctionCons(f, rest) -> {
        match f { IrFunction(hash, nparams, blocks, src) -> { index = pipeline_ir_borrow_function_index_insert(index, hash, f, 0) } }
        cur = rest
      }
    }
  }
  index
}

pub(package) fn pipeline_ir_borrow_function_index_lookup(index: PipelineIrBorrowFunctionIndex, hash: i64, bit: i64) -> IrFunctionList {
  match index {
    PipelineIrBorrowFunctionIndexNil -> ir_function_list_empty()
    PipelineIrBorrowFunctionIndexBranch(low, upper) -> {
      if ((hash bshr bit) band 1) == 0 { pipeline_ir_borrow_function_index_lookup(low, hash, bit + 1) }
      else { pipeline_ir_borrow_function_index_lookup(upper, hash, bit + 1) }
    }
    PipelineIrBorrowFunctionIndexLeaf(entry_hash, f, rest) -> {
      if entry_hash == hash { ir_function_list_prepend(f, ir_function_list_empty()) }
      else { pipeline_ir_borrow_function_index_lookup(rest, hash, bit) }
    }
  }
}

pub(package) fn pipeline_ir_borrow_handler_clauses_have_values(clauses: IrHandlerClauseBodyList) -> i64 {
  match clauses {
    IrHandlerClauseBodyNil -> 0
    IrHandlerClauseBodyCons(body, rest) -> {
      let hit = match body {
        IrHandlerClauseBody(op_hash, nparams, captures, has_continuation, is_abortive, result_cleanup_kind, transferred_param_value_fact, resume_lanes, result_lanes, first_value, blocks) -> pipeline_ir_borrow_blocks_have_values(blocks)
        IrHandlerClauseBodyInvalid(reason) -> 0
      }
      if hit == 1 { 1 } else { pipeline_ir_borrow_handler_clauses_have_values(rest) }
    }
  }
}

pub(package) fn pipeline_ir_borrow_deferred_body_has_values(body: IrDeferredHandlerBody) -> i64 {
  match body {
    IrDeferredHandlerBody(body_src, captures, ops_value, result_lanes, first_value, blocks, completion) -> {
      if pipeline_ir_borrow_blocks_have_values(blocks) == 1 { 1 }
      else { match completion {
        IrDeferredCompletionBodyNone -> 0
        IrDeferredCompletionBody(input_lanes, output_lanes, completion_first_value, completion_blocks) -> pipeline_ir_borrow_blocks_have_values(completion_blocks)
        IrDeferredCompletionBodyInvalid(reason) -> 0
      } }
    }
    IrDeferredHandlerBodyInvalid(reason) -> 0
  }
}

pub(package) fn pipeline_ir_borrow_insts_have_values(insts: IrInstList) -> i64 {
  let mut cur = insts
  let mut found = 0
  let mut walking = 1
  while walking == 1 {
    match cur {
      IrInstNil -> { walking = 0 }
      IrInstCons(inst, rest) -> {
        let hit = match inst {
          IrCallResultLaneI64(dst, lane) -> if ir_call_result_lane_physical(lane) == 1 { 1 } else { 0 }
          IrLoadI64(dst, slot) -> pipeline_ir_borrow_insts_start_load_pair(rest, dst, slot)
          IrRecordLayoutWordLoadI64(dst, base, record_data_size, field_hash, byte_offset) -> pipeline_ir_borrow_insts_start_record_layout_word_pair(rest, dst, base, field_hash, byte_offset)
          IrFieldLoadI64(dst, base, field_hash, offset) -> pipeline_ir_borrow_insts_start_field_pair(rest, dst, base, field_hash, offset)
          IrVariantPayloadI64(dst, base, offset) -> pipeline_ir_borrow_insts_start_variant_pair(rest, dst, base, offset)
          IrHandleI64(dst, handle_src, effect_hash, clauses, nclauses, abort_block) -> pipeline_ir_borrow_handler_clauses_have_values(clauses)
          IrDeferredHandleI64(dst, handle_src, body, clauses, nclauses, effect_hash, scratch_base) -> {
            if pipeline_ir_borrow_handler_clauses_have_values(clauses) == 1 { 1 } else { pipeline_ir_borrow_deferred_body_has_values(body) }
          }
          _ -> 0
        }
        if hit == 1 { found = 1 walking = 0 } else { cur = rest }
      }
    }
  }
  found
}

pub(package) fn pipeline_ir_borrow_blocks_have_values(blocks: IrBlockList) -> i64 {
  let mut cur = blocks
  let mut found = 0
  let mut walking = 1
  while walking == 1 {
    match cur {
      IrBlockListNil -> { walking = 0 }
      IrBlockListCons(block, rest) -> {
        let hit = match block { IrBlock(id, params, insts, term) -> pipeline_ir_borrow_insts_have_values(insts) }
        if hit == 1 { found = 1 walking = 0 } else { cur = rest }
      }
    }
  }
  found
}

pub(package) fn pipeline_ir_borrow_function_has_values(f: IrFunction, borrow: IrBorrowFacts) -> i64 {
  if ir_borrow_param_fact_count(ir_borrow_facts_params(borrow)) > 0 or ir_borrow_facts_return_mutability(borrow) >= 0 { 1 }
  else { match f { IrFunction(hash, nparams, blocks, src) -> pipeline_ir_borrow_blocks_have_values(blocks) } }
}

pub(package) fn pipeline_type_list_contains_slice(types: i64) -> bool {
  if types == 0 { false }
  else {
    let mut found = false
    for i in 0..nlist_len(types) {
      if pipeline_type_contains_slice(nlist_get(types, i)) == 1 { found = true } else { found = found }
    }
    found
  }
}

pub(package) fn pipeline_record_fields_contain_slice(fields: i64) -> bool {
  let mut found = false
  if fields != 0 {
    for i in 0..nlist_len(fields) {
      if pipeline_type_contains_slice(ty_record_field_type(nlist_get(fields, i))) { found = true } else { 0 }
    }
  } else { 0 }
  found
}

pub(package) fn pipeline_type_contains_slice(ty: i64) -> bool {
  if ty == 0 { false }
  else {
    match ty_tag(ty) {
      3 -> pipeline_type_contains_slice(ty_f1(ty)) or pipeline_type_contains_slice(ty_f2(ty))
      4 -> pipeline_type_contains_slice(ty_f1(ty)) or pipeline_type_contains_slice(ty_f2(ty))
      5 -> pipeline_type_contains_slice(ty_f1(ty))
      6 -> pipeline_type_list_contains_slice(ty_f1(ty)) or pipeline_type_contains_slice(ty_f2(ty))
      7 -> pipeline_record_fields_contain_slice(ty_record_fields(ty))
      8 -> pipeline_type_contains_slice(ty_f2(ty))
      9 -> pipeline_type_contains_slice(ty_f2(ty)) or pipeline_type_list_contains_slice(ty_f3(ty))
      11 -> pipeline_type_list_contains_slice(ty_f2(ty))
      14 -> pipeline_type_contains_slice(ty_f1(ty)) or pipeline_type_contains_slice(ty_f2(ty))
      15 -> pipeline_type_contains_slice(ty_f1(ty))
      16 -> pipeline_type_contains_slice(ty_f1(ty))
      17 -> pipeline_type_contains_slice(ty_f1(ty))
      18 -> pipeline_type_contains_slice(ty_f1(ty))
      19 -> pipeline_type_contains_slice(ty_f1(ty))
      29 -> pipeline_type_contains_slice(ty_f1(ty))
      22 -> pipeline_type_contains_slice(ty_array_inner(ty))
      23 -> true
      _ -> false
    }
  }
}

pub(package) fn pipeline_param_nodes_contain_slice(params: i64) -> bool {
  if params == 0 { false }
  else {
    let mut found = false
    for i in 0..nlist_len(params) {
      if pipeline_type_contains_slice(node_f3(nlist_get(params, i))) == 1 { found = true } else { found = found }
    }
    found
  }
}

pub(package) fn pipeline_typed_decl_signature_contains_slice(decl: i64) -> bool {
  if decl == 0 { false }
  else {
    match node_tag(decl) {
      8 -> pipeline_param_nodes_contain_slice(node_f3(decl))
      23 -> {
        if pipeline_typed_decl_signature_contains_slice(node_f1(decl)) == 1 { true }
        else { pipeline_type_contains_slice(node_f2(decl)) }
      }
      30 -> {
        let ops = node_f3(decl)
        let mut found = false
        if ops != 0 {
          for i in 0..nlist_len(ops) {
            let op = nlist_get(ops, i)
            if pipeline_param_nodes_contain_slice(node_f3(op)) or pipeline_type_contains_slice(type_effect_op_node_ret(op)) { found = true } else { found = found }
          }
        } else { false }
        found
      }
      38 -> {
        let members = node_f3(decl)
        let mut found = false
        if members != 0 {
          for i in 0..nlist_len(members) {
            let member = nlist_get(members, i)
            if node_tag(member) == 39 {
              let ret_wrap = node_f4(member)
              let ret_ty = if ret_wrap == 0 { 0 } else { node_f1(ret_wrap) }
              if pipeline_param_nodes_contain_slice(node_f3(member)) or pipeline_type_contains_slice(ret_ty) { found = true } else { found = found }
            } else { found = found }
          }
        } else { false }
        found
      }
      40 -> {
        let members = node_f3(decl)
        let mut found = false
        if members != 0 {
          for i in 0..nlist_len(members) {
            if pipeline_typed_decl_signature_contains_slice(nlist_get(members, i)) == 1 { found = true } else { found = found }
          }
        } else { false }
        found
      }
      _ -> false
    }
  }
}

pub(package) fn pipeline_typed_signatures_contain_slice(fns: i64) -> bool {
  let mut found = false
  for i in 0..nlist_len(fns) {
    if pipeline_typed_decl_signature_contains_slice(node_f1(nlist_get(fns, i))) == 1 { found = true } else { found = found }
  }
  found
}

pub(package) fn pipeline_type_table_contains_slice(tt: i64) -> bool {
  if tt == 0 { false }
  else {
    let entries = mem_load64_at(tt, 0)
    let count = mem_load64_at(tt, 8)
    let mut found = false
    for i in 0..count {
      let entry = entries + i * 64
      let kind = types_storage_type_entry_kind(entry)
      let item_count = types_storage_type_entry_payload_count(entry)
      let payload = types_storage_type_entry_payload(entry)
      if kind == 0 {
        for j in 0..item_count {
          if pipeline_type_contains_slice(types_storage_record_field_type_node(payload, j)) == 1 { found = true } else { found = found }
        }
      } else { if kind == 1 {
        for j in 0..item_count {
          if pipeline_type_list_contains_slice(types_storage_variant_payloads(payload, j)) == 1 { found = true } else { found = found }
        }
      } else { if kind == 2 {
        for j in 0..item_count {
          let op = nlist_get(payload, j)
          if pipeline_param_nodes_contain_slice(node_f3(op)) or pipeline_type_contains_slice(type_effect_op_node_ret(op)) { found = true } else { found = found }
        }
      } else { if kind == 3 {
        for j in 0..item_count {
          let member = nlist_get(payload, j)
          if node_tag(member) == 39 {
            let ret_wrap = node_f4(member)
            let ret_ty = if ret_wrap == 0 { 0 } else { node_f1(ret_wrap) }
            if pipeline_param_nodes_contain_slice(node_f3(member)) or pipeline_type_contains_slice(ret_ty) { found = true } else { found = found }
          } else { found = found }
        }
      } else { if kind == 4 {
        for j in 0..item_count {
          if pipeline_typed_decl_signature_contains_slice(nlist_get(payload, j)) == 1 { found = true } else { found = found }
        }
      } else { found = found } } } } }
    }
    found
  }
}

pub(package) fn pipeline_ir_semantic_borrow_signatures_have_values(facts: PipelineIrSemanticFactList) -> i64 {
  match facts {
    PipelineIrSemanticFactNil -> 0
    PipelineIrSemanticFactNode(hash, fact, borrow, left, right) -> {
      if ir_borrow_param_fact_count(ir_borrow_facts_params(borrow)) > 0 or ir_borrow_facts_return_mutability(borrow) >= 0 { 1 }
      else {
        if pipeline_ir_semantic_borrow_signatures_have_values(left) == 1 { 1 }
        else { pipeline_ir_semantic_borrow_signatures_have_values(right) }
      }
    }
  }
}

pub(package) fn pipeline_ir_semantic_borrow_values_enrich(facts: PipelineIrSemanticFactList, all_facts: PipelineIrSemanticFactList, functions: PipelineIrBorrowFunctionIndex) -> PipelineIrSemanticFactList {
  match facts {
    PipelineIrSemanticFactNil -> PipelineIrSemanticFactNil
    PipelineIrSemanticFactNode(hash, fact, borrow, left, right) -> {
      let enriched = match pipeline_ir_borrow_function_index_lookup(functions, hash, 0) {
        IrFunctionNil -> borrow
        IrFunctionCons(f, rest) -> {
          if pipeline_ir_borrow_function_has_values(f, borrow) == 1 { pipeline_ir_borrow_values_for_function(f, borrow, all_facts) }
          else { borrow }
        }
      }
      PipelineIrSemanticFactNode(
        hash,
        fact,
        enriched,
        pipeline_ir_semantic_borrow_values_enrich(left, all_facts, functions),
        pipeline_ir_semantic_borrow_values_enrich(right, all_facts, functions)
      )
    }
  }
}

pub(package) fn pipeline_ir_semantic_borrow_values_enrich_functions(facts: PipelineIrSemanticFactList, functions: IrFunctionList, typed_fns: i64, tt: i64) -> PipelineIrSemanticFactList {
  -- The typed signature graph is the semantic producer for whether a module
  -- can contain slice values. Two-word ABI shapes are not sufficient evidence:
  -- other transports share them and would spuriously enable this whole pass.
  if pipeline_typed_signatures_contain_slice(typed_fns) == 0 and pipeline_type_table_contains_slice(tt) == 0 and pipeline_ir_semantic_borrow_signatures_have_values(facts) == 0 { facts }
  else { pipeline_ir_semantic_borrow_values_enrich(facts, facts, pipeline_ir_borrow_function_index(functions)) }
}

pub(package) fn pipeline_ir_borrow_values_complete_handler_clauses(clauses: IrHandlerClauseBodyList, values: IrBorrowValueFactList) -> i64 {
  match clauses {
    IrHandlerClauseBodyNil -> 1
    IrHandlerClauseBodyCons(body, rest) -> {
      let valid = match body {
        IrHandlerClauseBody(op_hash, nparams, captures, has_continuation, is_abortive, result_cleanup_kind, transferred_param_value_fact, resume_lanes, result_lanes, first_value, blocks) -> pipeline_ir_borrow_values_complete_blocks(blocks, pipeline_ir_borrow_block_param_map(blocks), values)
        IrHandlerClauseBodyInvalid(reason) -> 1
      }
      if valid != 1 { 0 } else { pipeline_ir_borrow_values_complete_handler_clauses(rest, values) }
    }
  }
}

pub(package) fn pipeline_ir_borrow_values_complete_deferred_body(body: IrDeferredHandlerBody, values: IrBorrowValueFactList) -> i64 {
  match body {
    IrDeferredHandlerBody(body_src, captures, ops_value, result_lanes, first_value, blocks, completion) -> {
      if pipeline_ir_borrow_values_complete_blocks(blocks, pipeline_ir_borrow_block_param_map(blocks), values) != 1 { 0 }
      else { match completion {
        IrDeferredCompletionBodyNone -> 1
        IrDeferredCompletionBody(input_lanes, output_lanes, completion_first_value, completion_blocks) -> pipeline_ir_borrow_values_complete_blocks(completion_blocks, pipeline_ir_borrow_block_param_map(completion_blocks), values)
        IrDeferredCompletionBodyInvalid(reason) -> 1
      } }
    }
    IrDeferredHandlerBodyInvalid(reason) -> 1
  }
}

pub(package) fn pipeline_ir_borrow_values_complete_insts(insts: IrInstList, values: IrBorrowValueFactList) -> i64 {
  match insts {
    IrInstNil -> 1
    IrInstCons(inst, rest) -> {
      let valid = match inst {
        IrCallResultLaneI64(dst, lane) -> {
          if ir_call_result_lane_physical(lane) != 1 { 1 }
          else { if ir_borrow_origin_list_len(ir_borrow_value_facts_find(values, ir_call_result_lane_head(dst, lane))) > 0 { 1 } else { 0 } }
        }
        IrLoadI64(dst, slot) -> {
          if pipeline_ir_borrow_insts_start_load_pair(rest, dst, slot) != 1 { 1 }
          else { if ir_borrow_origin_list_len(ir_borrow_value_facts_find(values, dst)) > 0 { 1 } else { 0 } }
        }
        IrRecordLayoutWordLoadI64(dst, base, record_data_size, field_hash, byte_offset) -> {
          if pipeline_ir_borrow_insts_start_record_layout_word_pair(rest, dst, base, field_hash, byte_offset) != 1 { 1 }
          else { if ir_borrow_origin_list_len(ir_borrow_value_facts_find(values, dst)) > 0 { 1 } else { 0 } }
        }
        IrFieldLoadI64(dst, base, field_hash, offset) -> {
          if pipeline_ir_borrow_insts_start_field_pair(rest, dst, base, field_hash, offset) != 1 { 1 }
          else { if ir_borrow_origin_list_len(ir_borrow_value_facts_find(values, dst)) > 0 { 1 } else { 0 } }
        }
        IrVariantPayloadI64(dst, base, offset) -> {
          if pipeline_ir_borrow_insts_start_variant_pair(rest, dst, base, offset) != 1 { 1 }
          else { if ir_borrow_origin_list_len(ir_borrow_value_facts_find(values, dst)) > 0 { 1 } else { 0 } }
        }
        IrHandleI64(dst, handle_src, effect_hash, clauses, nclauses, abort_block) -> pipeline_ir_borrow_values_complete_handler_clauses(clauses, values)
        IrDeferredHandleI64(dst, handle_src, body, clauses, nclauses, effect_hash, scratch_base) -> {
          if pipeline_ir_borrow_values_complete_handler_clauses(clauses, values) != 1 { 0 }
          else { pipeline_ir_borrow_values_complete_deferred_body(body, values) }
        }
        _ -> 1
      }
      if valid != 1 { 0 } else { pipeline_ir_borrow_values_complete_insts(rest, values) }
    }
  }
}

pub(package) fn pipeline_ir_borrow_values_complete_jump(args: IrValueList, params: IrValueList, values: IrBorrowValueFactList) -> i64 {
  match args {
    IrValueNil -> 1
    IrValueCons(arg, arg_rest) -> {
      match params {
        IrValueNil -> 1
        IrValueCons(param, param_rest) -> {
          let incoming = ir_borrow_value_facts_find(values, arg)
          let current = ir_borrow_value_facts_find(values, param)
          if ir_borrow_origin_list_rebased_contained(incoming, current, param) != 1 { 0 }
          else { pipeline_ir_borrow_values_complete_jump(arg_rest, param_rest, values) }
        }
      }
    }
  }
}

pub(package) fn pipeline_ir_borrow_values_complete_blocks(blocks: IrBlockList, param_map: PipelineIrBorrowBlockParamIndex, values: IrBorrowValueFactList) -> i64 {
  match blocks {
    IrBlockListNil -> 1
    IrBlockListCons(block, rest) -> {
      let valid = match block {
        IrBlock(id, params, insts, term) -> {
          if pipeline_ir_borrow_values_complete_insts(insts, values) != 1 { 0 }
          else {
            match term {
              IrTermJump(target, args) -> pipeline_ir_borrow_values_complete_jump(args, pipeline_ir_borrow_block_params_for_id(param_map, target), values)
              _ -> 1
            }
          }
        }
      }
      if valid != 1 { 0 } else { pipeline_ir_borrow_values_complete_blocks(rest, param_map, values) }
    }
  }
}

pub(package) fn pipeline_ir_semantic_borrow_values_first_incomplete_hash_or(functions: IrFunctionList, facts: PipelineIrSemanticFactList, default: i64) -> i64 {
  -- Production modules contain thousands of functions. Keep the module-level
  -- audit stack-constant; recursive descent here made fact validation depend
  -- on the size of an otherwise ordinary function list.
  let mut current = functions
  let mut incomplete = default
  let mut done = 0
  while done == 0 {
    match current {
      IrFunctionNil -> { done = 1 }
      IrFunctionCons(IrFunction(hash, nparams, blocks, src), rest) -> {
        let fact = pipeline_ir_semantic_fact_find(facts, hash)
        if fact != 0 {
          let borrow = pipeline_ir_semantic_borrow_fact_find(facts, hash)
          if pipeline_ir_borrow_values_complete_blocks(blocks, pipeline_ir_borrow_block_param_map(blocks), ir_borrow_facts_values(borrow)) != 1 {
            incomplete = hash
            done = 1
          } else { current = rest }
        } else { current = rest }
      }
    }
  }
  incomplete
}

pub(package) fn pipeline_ir_semantic_borrow_values_complete(ir: IrModule) -> i64 {
  let default = 0 - 1
  if pipeline_ir_semantic_borrow_values_first_incomplete_hash_or(pipeline_ir_functions(ir), pipeline_ir_semantic_facts(ir), default) == default { 1 } else { 0 }
}

pub(package) fn pipeline_ir_semantic_borrow_facts_valid_list(facts: PipelineIrSemanticFactList) -> i64 {
  match facts {
    PipelineIrSemanticFactNil -> 1
    PipelineIrSemanticFactNode(hash, fact, borrow, left, right) -> {
      let shapes = cg_semantic_fact_param_shapes(fact)
      let logical_param_count = if shapes == 0 { 0 } else { nlist_len(shapes) }
      if ir_borrow_facts_valid(borrow, logical_param_count) != 1 { 0 }
      else { if pipeline_ir_semantic_borrow_facts_valid_list(left) != 1 { 0 }
      else { pipeline_ir_semantic_borrow_facts_valid_list(right) } }
    }
  }
}

pub(package) fn pipeline_ir_semantic_borrow_facts_valid(ir: IrModule) -> i64 {
  pipeline_ir_semantic_borrow_facts_valid_list(pipeline_ir_semantic_facts(ir))
}

pub(package) fn pipeline_ir_semantic_borrow_first_invalid_hash_or(facts: PipelineIrSemanticFactList, default: i64) -> i64 {
  match facts {
    PipelineIrSemanticFactNil -> default
    PipelineIrSemanticFactNode(hash, fact, borrow, left, right) -> {
      let shapes = cg_semantic_fact_param_shapes(fact)
      let logical_param_count = if shapes == 0 { 0 } else { nlist_len(shapes) }
      let left_bad = pipeline_ir_semantic_borrow_first_invalid_hash_or(left, default)
      if left_bad != default { left_bad }
      else { if ir_borrow_facts_valid(borrow, logical_param_count) != 1 { hash }
      else { pipeline_ir_semantic_borrow_first_invalid_hash_or(right, default) } }
    }
  }
}

pub(package) fn pipeline_ir_semantic_facts_from_fns_with_flags_and_tt(fns: i64, user_src: i64, effect_flags: i64, tt: i64) -> PipelineIrSemanticFactList {
  let mut result = pipeline_ir_semantic_facts_empty()
  let n = nlist_len(fns)
  for i in 0..n {
    let pair = nlist_get(fns, i)
    let fn_wrap = node_f1(pair)
    if (user_src == 0 or node_f2(pair) == user_src) and pipeline_decl_node_is_function(fn_wrap) == 1 {
      let fn_src = node_f2(pair)
      let inner = pipeline_fn_inner(fn_wrap)
      let params = node_f3(inner)
      let ret_ty = fn_ret_type(fn_wrap)
      let eff = effect_sig_from_node(fn_effects(fn_wrap))
      let declared_alloc = effect_sig_contains_hash(eff, effect_name_hash(__str_ptr("Alloc"), 0, 5))
      let declared_unsafe = effect_sig_contains_hash(eff, effect_name_hash(__str_ptr("Unsafe"), 0, 6))
      let name_hash = str_hash(fn_src, node_f1(inner), node_f2(inner))
      let hash = pipeline_fn_pair_key(pair)
      let effect_summary = cg_semantic_effect_summary_new(effect_sig_is_closed_or(eff, 1), effect_sig_count_or(eff, 0), declared_alloc, declared_unsafe)
      let fact = cg_semantic_fact_new_with_effect_summary(0, effect_summary, params, ret_ty, 0, pipeline_ir_effect_flag_map_lookup(effect_flags, name_hash))
      cg_semantic_fact_set_traversal_code(fact, pipeline_ir_traversal_role_code(pipeline_ir_iterator_traversal_role(pair, name_hash, tt)))
      cg_semantic_fact_set_dense_table_role(fact, pipeline_ir_dense_table_role(pair, name_hash, tt))
      -- Native allocation roots keep their exact resolved ABI key in the fact
      -- tree. This survives module-name collisions without asking later body
      -- analyses to compare an unqualified spelling.
      if pipeline_ir_native_fresh_managed_alloc_decl(pair, name_hash, tt) == 1 { cg_semantic_fact_set_fresh_managed_return(fact, 1) } else { 0 }
      let signature_borrow = pipeline_ir_borrow_facts_for_signature(params, ret_ty)
      let alias_summary = if ty_is_slice(ret_ty) or fn_tparams(fn_wrap) != 0 or cg_ty_is_managed(ret_ty) == 1 {
        pipeline_ir_borrow_pair_summary(pair, fns, tt, ir_value_list_empty())
      } else { ir_borrow_facts_summary(signature_borrow) }
      cg_semantic_fact_set_return_alias_param_mask(fact, pipeline_ir_return_alias_mask_from_summary(alias_summary))
      -- Borrow summaries describe slice provenance only. A generic non-slice
      -- result may become a slice after substitution, so it remains unknown
      -- until the concrete spec fact is built; nominal/storage aliases live in
      -- the representation-neutral mask above.
      -- Build the slice summary independently. The return-alias projection is
      -- a consuming traversal of its temporary ADT; sharing that temporary
      -- here would leave the published borrow record pointing at a released
      -- value under exact ownership transfer.
      let summary = if ty_is_slice(ret_ty) { pipeline_ir_borrow_pair_summary(pair, fns, tt, ir_value_list_empty()) }
        else { if fn_tparams(fn_wrap) != 0 { ir_borrow_summary_unknown() }
        else { ir_borrow_facts_summary(signature_borrow) } }
      let borrow = ir_borrow_facts_with_summary(signature_borrow, summary)
      result = pipeline_ir_semantic_facts_prepend_with_borrow(hash, fact, borrow, result)
    } else { 0 }
  }
  result
}

pub(package) fn pipeline_ir_semantic_facts_from_fns_with_flags(fns: i64, user_src: i64, effect_flags: i64) -> PipelineIrSemanticFactList {
  pipeline_ir_semantic_facts_from_fns_with_flags_and_tt(fns, user_src, effect_flags, 0)
}

pub(package) fn pipeline_ir_semantic_facts_from_fns_with_tt(fns: i64, user_src: i64, tt: i64) -> PipelineIrSemanticFactList {
  pipeline_ir_semantic_facts_from_fns_with_flags_and_tt(fns, user_src, pipeline_ir_typed_effect_flags_fixpoint(fns, user_src, 0), tt)
}

pub(package) fn pipeline_ir_semantic_facts_from_fns(fns: i64, user_src: i64) -> PipelineIrSemanticFactList {
  pipeline_ir_semantic_facts_from_fns_with_tt(fns, user_src, 0)
}

-- Project the optimizer's declaration-keyed return-provenance summary for a
-- checker function entry. Callers never need to reproduce the native-key
-- identity rule, and absence remains unknown rather than the empty summary.
pub(package) fn pipeline_ir_semantic_borrow_summary_for_entry(fns: i64, tt: i64, entry: i64) -> IrBorrowSummary {
  if entry == 0 { ir_borrow_summary_unknown() }
  else {
    let source = ftypes_entry_source(entry)
    let name_start = ftypes_entry_name_start(entry)
    let name_len = ftypes_entry_name_len(entry)
    let key = module_decl_fact_native_key_or(ftypes_entry_decl_fact(entry), str_hash(source, name_start, name_len))
    let facts = pipeline_ir_semantic_facts_from_fns_with_tt(fns, 0, tt)
    let fact = pipeline_ir_semantic_fact_find(facts, key)
    if fact == 0 { ir_borrow_summary_unknown() }
    else {
      match ir_borrow_facts_summary(pipeline_ir_semantic_borrow_fact_find(facts, key)) {
        IrBorrowSummaryKnown(params) -> ir_borrow_summary_known(params)
        IrBorrowSummaryUnknown -> {
          let alias_mask = cg_semantic_fact_return_alias_param_mask(fact)
          let shapes = cg_semantic_fact_param_shapes(fact)
          if alias_mask == 0 or shapes == 0 { ir_borrow_summary_unknown() }
          else { ir_borrow_summary_known(pipeline_ir_return_alias_params_from_mask(alias_mask, 0, nlist_len(shapes))) }
        }
      }
    }
  }
}

-- Test/tool projection of the declaration-keyed traversal role. Optimiser
-- consumers use the fact tree directly; callers resolving a checked function
-- entry share the same exact native-key derivation here.
pub(package) fn pipeline_ir_semantic_traversal_role_for_entry(fns: i64, tt: i64, entry: i64) -> PipelineIrTraversalRole {
  if entry == 0 { PipelineIrTraversalNone }
  else {
    let source = ftypes_entry_source(entry)
    let name_start = ftypes_entry_name_start(entry)
    let name_len = ftypes_entry_name_len(entry)
    let facts = pipeline_ir_semantic_facts_from_fns_with_tt(fns, 0, tt)
    let key = module_decl_fact_native_key_or(ftypes_entry_decl_fact(entry), str_hash(source, name_start, name_len))
    pipeline_ir_semantic_fact_lookup_traversal_role(facts, key)
  }
}

pub(package) fn pipeline_ir_inline_candidate_prepend(hash: i64, f: IrFunction, rest: PipelineIrInlineCandidateList) -> PipelineIrInlineCandidateList {
  match rest {
    PipelineIrInlineCandidateNil -> PipelineIrInlineCandidateNode(hash, f, PipelineIrInlineCandidateNil, PipelineIrInlineCandidateNil)
    PipelineIrInlineCandidateNode(candidate_hash, candidate, lower, higher) -> {
      if hash == candidate_hash {
        PipelineIrInlineCandidateNode(hash, f, lower, higher)
      } else { if hash < candidate_hash {
        PipelineIrInlineCandidateNode(candidate_hash, candidate, pipeline_ir_inline_candidate_prepend(hash, f, lower), higher)
      } else {
        PipelineIrInlineCandidateNode(candidate_hash, candidate, lower, pipeline_ir_inline_candidate_prepend(hash, f, higher))
      } }
    }
  }
}


pub(package) fn pipeline_ir_inline_candidate_functions(candidates: PipelineIrInlineCandidateList, acc: IrFunctionList) -> IrFunctionList {
  match candidates {
    PipelineIrInlineCandidateNil -> acc
    PipelineIrInlineCandidateNode(hash, f, lower, higher) -> pipeline_ir_inline_candidate_functions(lower, pipeline_ir_inline_candidate_functions(higher, ir_function_list_prepend(f, acc)))
  }
}

pub(package) fn pipeline_ir_inline_candidate_lookup(candidates: PipelineIrInlineCandidateList, hash: i64) -> IrFunctionList {
  match candidates {
    PipelineIrInlineCandidateNil -> ir_function_list_empty()
    PipelineIrInlineCandidateNode(candidate_hash, f, lower, higher) -> {
      if candidate_hash == hash {
        ir_function_list_prepend(f, ir_function_list_empty())
      } else { if hash < candidate_hash {
        pipeline_ir_inline_candidate_lookup(lower, hash)
      } else {
        pipeline_ir_inline_candidate_lookup(higher, hash)
      } }
    }
  }
}

pub(package) fn pipeline_ir_raw_memory_inline_inst_count(inst: IrInst) -> i64 {
  match inst {
    IrCallI64(dst, callee_hash, args) -> pipeline_ir_raw_memory_inline_call_hash(callee_hash)
    IrPtrLoadI64(dst, ptr) -> 1
    IrPtrStoreI64(dst, ptr, value) -> 1
    _ -> 0
  }
}

pub(package) fn pipeline_ir_raw_memory_inline_inst_list_count(insts: IrInstList) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> pipeline_ir_raw_memory_inline_inst_count(inst) + pipeline_ir_raw_memory_inline_inst_list_count(rest)
  }
}

pub(package) fn pipeline_ir_raw_memory_inline_call_min_params(callee_hash: i64) -> i64 {
  if callee_hash == pipeline_ir_native_intrinsic_mem_load64_hash() { 1 }
  else { if callee_hash == pipeline_ir_native_intrinsic_mem_load8_hash() { 1 }
  else { if callee_hash == pipeline_ir_native_intrinsic_mem_store64_hash() { 2 }
  else { if callee_hash == pipeline_ir_native_intrinsic_mem_store8_hash() { 2 }
  -- Pseudo forms carry the same shape obligations as their raw
  -- counterparts; without these the bridge eligibility rejected every
  -- wrapper whose helper call had already been inlined to a pseudo.
  else { if callee_hash == pipeline_ir_pseudo_bridge_load64_hash() { 1 }
  else { if callee_hash == pipeline_ir_pseudo_bridge_load8_hash() { 1 }
  else { if callee_hash == pipeline_ir_pseudo_bridge_store64_hash() { 2 }
  else { if callee_hash == pipeline_ir_pseudo_bridge_store8_hash() { 2 }
  else { if callee_hash == pipeline_ir_pseudo_bridge_store64_discard_hash() { 2 }
  else { if callee_hash == pipeline_ir_pseudo_bridge_store8_discard_hash() { 2 }
  else { if callee_hash == pipeline_ir_pseudo_scaled_load64_hash() { 2 }
  else { if callee_hash == pipeline_ir_pseudo_scaled_store64_hash() { 3 }
  else { if callee_hash == pipeline_ir_pseudo_scaled_store64_discard_hash() { 3 } else { 1000000 } } } } } } } } } } } } }
}

pub(package) fn pipeline_ir_raw_memory_inline_inst_min_params(inst: IrInst) -> i64 {
  match inst {
    IrCallI64(dst, callee_hash, args) -> pipeline_ir_raw_memory_inline_call_min_params(callee_hash)
    IrPtrLoadI64(dst, ptr) -> 1
    IrPtrStoreI64(dst, ptr, value) -> 2
    _ -> 1000000
  }
}

pub(package) fn pipeline_ir_raw_memory_inline_inst_list_min_params(insts: IrInstList, current: i64) -> i64 {
  match insts {
    IrInstNil -> current
    IrInstCons(inst, rest) -> {
      let candidate = pipeline_ir_raw_memory_inline_inst_min_params(inst)
      let next = if candidate < current { candidate } else { current }
      pipeline_ir_raw_memory_inline_inst_list_min_params(rest, next)
    }
  }
}

pub(package) fn pipeline_ir_raw_memory_bridge_inline_eligible(param_count: i64, insts: IrInstList) -> i64 {
  let raw_count = pipeline_ir_raw_memory_inline_inst_list_count(insts)
  let min_params = pipeline_ir_raw_memory_inline_inst_list_min_params(insts, 1000000)
  if raw_count == 1 and param_count >= min_params { 1 } else { 0 }
}

-- Float-signature wrappers around pure compute intrinsics (math_sqrt_*
-- wrapping __f64_sqrt/__f32_sqrt): the body is one intrinsic call whose
-- emission is inline (fmov/fsqrt/fmov), so inlining erases a bl plus a
-- frame from the caller's critical path. The intrinsics are already in
-- the clone allowlist; this leg only admits the wrapper as a candidate.
pub(package) fn pipeline_ir_pure_intrinsic_inline_inst_count(insts: IrInstList) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let one = match inst {
        IrCallI64(dst, callee_hash, args) -> pipeline_ir_pure_intrinsic_inline_call_hash(callee_hash)
        _ -> 0
      }
      one + pipeline_ir_pure_intrinsic_inline_inst_count(rest)
    }
  }
}

pub(package) fn pipeline_ir_pure_intrinsic_bridge_inline_eligible(insts: IrInstList) -> i64 {
  if pipeline_ir_pure_intrinsic_inline_inst_count(insts) == 1 { 1 } else { 0 }
}

pub(package) fn pipeline_ir_tiny_inline_borrowed_param_mask(insts: IrInstList) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      match inst {
        IrSlotI64(slot) -> {
          if pipeline_ir_borrowed_param_mask_slot_is(slot) == 1 { pipeline_ir_borrowed_param_mask_slot_decode(slot) }
          else { pipeline_ir_tiny_inline_borrowed_param_mask(rest) }
        }
        _ -> pipeline_ir_tiny_inline_borrowed_param_mask(rest)
      }
    }
  }
}

pub(package) fn pipeline_ir_tiny_inline_managed_params_borrowed(facts: PipelineIrSemanticFactList, hash: i64, insts: IrInstList) -> i64 {
  let managed = pipeline_ir_semantic_fact_lookup_managed_param_mask(facts, hash)
  if managed == 0 { 1 }
  else {
    let borrowed = pipeline_ir_tiny_inline_borrowed_param_mask(insts)
    if (borrowed band managed) == managed { 1 } else { 0 }
  }
}

pub(package) fn pipeline_ir_function_tiny_inline_eligible(f: IrFunction, facts: PipelineIrSemanticFactList, tiny_pure: i64) -> i64 {
  match f {
    IrFunction(hash, param_count, blocks, src) -> {
      let dense_table_role = pipeline_ir_semantic_fact_lookup_dense_table_role(facts, hash)
      match blocks {
        IrBlockListCons(block, IrBlockListNil) -> {
          match block {
            IrBlock(id, params, insts, term) -> {
              let param_len = ir_value_list_len(params)
              let inst_len = ir_inst_list_len(insts)
              -- Owned managed parameters retain their cleanup boundary. A
              -- borrowed managed parameter has no callee-owned cleanup; its
              -- lowered marker proves that the linear clone may dissolve the
              -- call while leaving ownership with the surrounding caller.
              if dense_table_role == cg_semantic_dense_table_role_storage_rows() or dense_table_role == cg_semantic_dense_table_role_storage_get() or dense_table_role == cg_semantic_dense_table_role_storage_set() or param_len != 0 or inst_len > 9 or pipeline_ir_tiny_inline_inst_list_supported(insts, tiny_pure, hash) != 1 or pipeline_ir_tiny_inline_managed_params_borrowed(facts, hash, insts) != 1 {
                0
              } else {
                match term {
	                  IrTermReturn(return_value) -> {
	                    if pipeline_ir_semantic_fact_lookup_pure_scalar_result(facts, hash) == 1 {
	                      1
	                    } else {
	                      -- Float-signature wrappers keep their call boundary:
	                      -- the scalar clone path does not model FP ABI values.
	                      if pipeline_ir_raw_memory_bridge_inline_eligible(param_count, insts) == 1 { 1 }
	                      else { pipeline_ir_pure_intrinsic_bridge_inline_eligible(insts) }
	                    }
	                  }
                  _ -> 0
                }
              }
            }
          }
        }
        _ -> 0
      }
    }
  }
}

pub(package) fn pipeline_ir_inline_candidates_walk(functions: IrFunctionList, facts: PipelineIrSemanticFactList, tiny_pure: i64) -> PipelineIrInlineCandidateList {
  match functions {
    IrFunctionNil -> PipelineIrInlineCandidateNil
    IrFunctionCons(f, rest) -> {
      let tail = pipeline_ir_inline_candidates_walk(rest, facts, tiny_pure)
      match f {
        IrFunction(hash, param_count, blocks, src) -> {
          -- Candidates come from every module: imported accessor forests
          -- (node_f*/mem helpers in lib.weft) dominate self-compile call
          -- counts, and the hash-ordered candidate tree keeps lookup
          -- sublinear. Bodies may call bridge shapes or other tiny pure
          -- functions; the iterated passes collapse helper chains
          -- (u32 -> rotr32 -> bsig0 -> block) bottom-up.
          if pipeline_ir_function_tiny_inline_eligible(f, facts, tiny_pure) == 1 {
            pipeline_ir_inline_candidate_prepend(hash, f, tail)
          } else {
            tail
          }
        }
      }
    }
  }
}

pub(package) fn pipeline_ir_inline_candidates_from_functions(functions: IrFunctionList, facts: PipelineIrSemanticFactList, user_src: i64) -> PipelineIrInlineCandidateList {
  pipeline_ir_inline_candidates_walk(functions, facts, pipeline_ir_tiny_pure_hash_tree(functions, facts))
}

pub(package) fn pipeline_ir_optimise_context(facts: PipelineIrSemanticFactList, inline_candidates: PipelineIrInlineCandidateList) -> PipelineIrOptimiseContext {
  PipelineIrOptimiseContext(facts, inline_candidates, 0, 0)
}

-- pure_callees is the module-level hash tree of pure callee hashes,
-- built once per optimise pass; calls to these cannot shrink a vector,
-- so the len-fact stability walks admit them.
pub(package) fn pipeline_ir_optimise_context3(facts: PipelineIrSemanticFactList, inline_candidates: PipelineIrInlineCandidateList, pure_callees: i64) -> PipelineIrOptimiseContext {
  PipelineIrOptimiseContext(facts, inline_candidates, pure_callees, 0)
}

pub(package) fn pipeline_ir_optimise_context4(facts: PipelineIrSemanticFactList, inline_candidates: PipelineIrInlineCandidateList, pure_callees: i64, param_count: i64) -> PipelineIrOptimiseContext {
  PipelineIrOptimiseContext(facts, inline_candidates, pure_callees, param_count)
}

pub(package) fn pipeline_ir_optimise_context5(facts: PipelineIrSemanticFactList, inline_candidates: PipelineIrInlineCandidateList, pure_callees: i64, param_count: i64, value_defs: i64) -> PipelineIrOptimiseContext {
  PipelineIrOptimiseContext(facts, inline_candidates, pure_callees, 0 - value_defs)
}

pub(package) fn pipeline_ir_optimise_context_facts(ctx: PipelineIrOptimiseContext) -> PipelineIrSemanticFactList {
  match ctx {
    PipelineIrOptimiseContext(facts, inline_candidates, pure_callees, function_data) -> facts
  }
}

pub(package) fn pipeline_ir_optimise_context_inline_candidates(ctx: PipelineIrOptimiseContext) -> PipelineIrInlineCandidateList {
  match ctx {
    PipelineIrOptimiseContext(facts, inline_candidates, pure_callees, function_data) -> inline_candidates
  }
}

pub(package) fn pipeline_ir_optimise_context_pure_callees(ctx: PipelineIrOptimiseContext) -> i64 {
  match ctx {
    PipelineIrOptimiseContext(facts, inline_candidates, pure_callees, function_data) -> pure_callees
  }
}

pub(package) fn pipeline_ir_optimise_context_fn_param_count(ctx: PipelineIrOptimiseContext) -> i64 {
  match ctx {
    PipelineIrOptimiseContext(facts, inline_candidates, pure_callees, function_data) -> {
      if function_data < 0 {
        let table = 0 - function_data
        let limit = mem_load64_at(table, 0)
        mem_load64_at(table + 8 + limit * 8, 0)
      } else { function_data }
    }
  }
}

pub(package) fn pipeline_ir_optimise_context_value_defs(ctx: PipelineIrOptimiseContext) -> i64 {
  match ctx {
    PipelineIrOptimiseContext(facts, inline_candidates, pure_callees, function_data) -> if function_data < 0 { 0 - function_data } else { 0 }
  }
}

pub(package) fn pipeline_ir_pure_callee_collect(facts: PipelineIrSemanticFactList, holder: i64) -> i64 {
  match facts {
    PipelineIrSemanticFactNil -> 0
    PipelineIrSemanticFactNode(hash, fact, borrow, left, right) -> {
      if cg_semantic_fact_pure(fact) == 1 { pipeline_ir_hash_tree_add_unique(holder, hash) } else { 0 }
      pipeline_ir_pure_callee_collect(left, holder)
      pipeline_ir_pure_callee_collect(right, holder)
    }
  }
}

pub(package) fn pipeline_ir_pure_callee_tree(facts: PipelineIrSemanticFactList) -> i64 {
  let holder = alloc_words(1)
  mem_store64_at(holder, 0, 0)
  pipeline_ir_pure_callee_collect(facts, holder)
  mem_load64_at(holder, 0)
}

