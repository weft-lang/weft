  else { if callee_hash == pipeline_ir_native_intrinsic_transmute_hash() { 9 }
  else { if callee_hash == pipeline_ir_native_intrinsic_int_to_ptr_hash() { 10 }
  else { if callee_hash == pipeline_ir_native_intrinsic_atomic_lock64_hash() { 12 }
  else { if callee_hash == pipeline_ir_native_intrinsic_atomic_unlock64_hash() { 13 }
  else { if callee_hash == pipeline_ir_native_intrinsic_call_i64_hash() { 14 }
  else { if callee_hash == pipeline_ir_native_intrinsic_call_closure_i64_hash() { 15 }
