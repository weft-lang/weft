fn pipeline_ir_value_list_to_nlist_into(values: IrValueList, out: i64) -> i64 {
  match values {
    IrValueNil -> out
    IrValueCons(value, rest) -> {
      nlist_add(out, value)
      pipeline_ir_value_list_to_nlist_into(rest, out)
    }
  }
}

fn pipeline_ir_value_list_to_nlist(values: IrValueList) -> i64 {
  pipeline_ir_value_list_to_nlist_into(values, nlist_new())
}

fn pipeline_ir_nlist_value_list_equal_at(stored: i64, values: IrValueList, index: i64) -> i64 {
  match values {
    IrValueNil -> if index == nlist_len(stored) { 1 } else { 0 }
    IrValueCons(value, rest) -> {
      if index >= nlist_len(stored) { 0 }
      else {
        if nlist_get(stored, index) == value {
          pipeline_ir_nlist_value_list_equal_at(stored, rest, index + 1)
        } else {
          0
        }
      }
    }
  }
}

fn pipeline_ir_nlist_value_list_equal(stored: i64, values: IrValueList) -> i64 {
  pipeline_ir_nlist_value_list_equal_at(stored, values, 0)
}

fn pipeline_ir_call_cse_env_bind(env: PipelineIrCallCseEnv, callee_hash: i64, args: IrValueList, result: i64) -> PipelineIrCallCseEnv {
  let raw = pipeline_ir_call_cse_env_raw(env)
  nlist_add(raw, node_new(0, callee_hash, pipeline_ir_value_list_to_nlist(args), result, 0))
  env
}

fn pipeline_ir_call_cse_env_lookup(env: PipelineIrCallCseEnv, callee_hash: i64, args: IrValueList) -> PipelineIrConstLookup {
  let raw = pipeline_ir_call_cse_env_raw(env)
  let mut found = 0
  let mut result = 0
  let n = nlist_len(raw)
  for i in 0..n {
    let entry = nlist_get(raw, i)
    if found == 0 and node_f1(entry) == callee_hash and pipeline_ir_nlist_value_list_equal(node_f2(entry), args) == 1 {
      found = 1
      result = node_f3(entry)
    } else {
      0
    }
  }
  pipeline_ir_const_lookup(found, result)
}

fn pipeline_ir_value_list_get_or(values: IrValueList, index: i64, default: i64) -> i64 {
  match values {
    IrValueNil -> default
    IrValueCons(value, rest) -> {
      if index == 0 { value }
      else { pipeline_ir_value_list_get_or(rest, index - 1, default) }
    }
  }
}

fn pipeline_ir_rewrite_value_list(values: IrValueList, aliases: PipelineIrAliasEnv) -> IrValueList {
  match values {
    IrValueNil -> IrValueNil
    IrValueCons(value, rest) -> {
      ir_value_list_prepend(pipeline_ir_alias_env_lookup_or(aliases, value), pipeline_ir_rewrite_value_list(rest, aliases))
    }
  }
}

fn pipeline_ir_rewrite_record_fields(fields: IrRecordFieldList, aliases: PipelineIrAliasEnv) -> IrRecordFieldList {
  match fields {
    IrRecordFieldNil -> IrRecordFieldNil
    IrRecordFieldCons(field_hash, word_offset, value, rest) -> {
      IrRecordFieldCons(field_hash, word_offset, pipeline_ir_alias_env_lookup_or(aliases, value), pipeline_ir_rewrite_record_fields(rest, aliases))
    }
  }
}

fn pipeline_ir_rewrite_record_layout_fields(fields: IrRecordLayoutFieldList, aliases: PipelineIrAliasEnv) -> IrRecordLayoutFieldList {
  match fields {
    IrRecordLayoutFieldNil -> IrRecordLayoutFieldNil
    IrRecordLayoutFieldWord(field_hash, byte_offset, value, managed_kind, rest) -> {
      IrRecordLayoutFieldWord(field_hash, byte_offset, pipeline_ir_alias_env_lookup_or(aliases, value), managed_kind, pipeline_ir_rewrite_record_layout_fields(rest, aliases))
    }
    IrRecordLayoutFieldArray(field_hash, byte_offset, data, byte_size, leaf_count, leaf_stride, leaf_kind, rest) -> {
      IrRecordLayoutFieldArray(field_hash, byte_offset, pipeline_ir_alias_env_lookup_or(aliases, data), byte_size, leaf_count, leaf_stride, leaf_kind, pipeline_ir_rewrite_record_layout_fields(rest, aliases))
    }
  }
}

fn pipeline_ir_lambda_captures_need_alias_rewrite(captures: i64, aliases: PipelineIrAliasEnv) -> i64 {
  let mut changed = 0
  let mut i = 0
  let count = if captures == 0 { 0 } else { nlist_len(captures) }
  while i < count and changed == 0 {
    let capture = nlist_get(captures, i)
    let value = node_f3(capture)
    if pipeline_ir_alias_env_lookup_or(aliases, value) != value { changed = 1 } else { 0 }
    i = i + 1
  }
  changed
}

fn pipeline_ir_rewrite_inst_uses(inst: IrInst, aliases: PipelineIrAliasEnv) -> IrInst {
  match inst {
    IrConstI64(dst, value) -> inst
    IrNilI64(dst) -> inst
    IrStringLit(dst, start, len) -> inst
    IrStringConcatI64(dst, left, right) -> IrStringConcatI64(dst, pipeline_ir_alias_env_lookup_or(aliases, left), pipeline_ir_alias_env_lookup_or(aliases, right))
    IrBinaryI64(dst, op, lhs, rhs) -> IrBinaryI64(dst, op, pipeline_ir_alias_env_lookup_or(aliases, lhs), pipeline_ir_alias_env_lookup_or(aliases, rhs))
    IrFloatBinaryI64(dst, prim, op, lhs, rhs) -> IrFloatBinaryI64(dst, prim, op, pipeline_ir_alias_env_lookup_or(aliases, lhs), pipeline_ir_alias_env_lookup_or(aliases, rhs))
    IrUnaryI64(dst, op, value) -> IrUnaryI64(dst, op, pipeline_ir_alias_env_lookup_or(aliases, value))
    IrClosureI64(dst, f, captures, eff) -> {
      if pipeline_ir_lambda_captures_need_alias_rewrite(captures, aliases) == 0 { inst }
      else {
        let count = nlist_len(captures)
        let rewritten = nlist_new_capacity(count)
        let mut i = 0
        while i < count {
          -- Match payloads are block-local SSA values. Re-extract from the
          -- stable function parameter after each arena-allocation call so a
          -- payload pointer never has to cross the call/loop backedge.
          let source_captures = match inst {
            IrClosureI64(source_dst, source_f, source, source_eff) -> source
            _ -> 0
          }
          let capture = nlist_get(source_captures, i)
          let ns = node_f1(capture)
          let nl = node_f2(capture)
          let value = pipeline_ir_alias_env_lookup_or(aliases, node_f3(capture))
          let ty = node_f4(capture)
          nlist_add(rewritten, pipeline_lambda_capture_entry(ns, nl, value, ty))
          i = i + 1
        }
        IrClosureI64(dst, f, rewritten, eff)
      }
    }
    IrFunctionRefI64(dst, callee_hash) -> inst
    IrGenericFunctionRefI64(dst, callee_hash, type_args) -> inst
    IrAddressOfSlotI64(dst, slot) -> inst
    IrPtrLoadI64(dst, ptr) -> IrPtrLoadI64(dst, pipeline_ir_alias_env_lookup_or(aliases, ptr))
    IrPtrStoreI64(dst, ptr, value) -> IrPtrStoreI64(dst, pipeline_ir_alias_env_lookup_or(aliases, ptr), pipeline_ir_alias_env_lookup_or(aliases, value))
    IrLoweringFailureI64(reason) -> inst
    IrPerformI64(dst, effect_hash, op_hash, args) -> IrPerformI64(dst, effect_hash, op_hash, pipeline_ir_rewrite_value_list(args, aliases))
    IrHandlerDirectI64(dst, effect_hash, op_hash, handler_depth, clause_index, args) -> IrHandlerDirectI64(dst, effect_hash, op_hash, handler_depth, clause_index, pipeline_ir_rewrite_value_list(args, aliases))
    IrHandlerPopI64(frame) -> IrHandlerPopI64(pipeline_ir_alias_env_lookup_or(aliases, frame))
    IrAbortLandingI64(dst) -> inst
    IrBindI64(ns, nl, value, ty) -> IrBindI64(ns, nl, pipeline_ir_alias_env_lookup_or(aliases, value), ty)
    IrHandleI64(dst, handle_src, body, clauses, nclauses, captures) -> inst
    IrDeferredHandleI64(dst, handle_src, body_expr, clauses, nclauses, captures, scratch_base) -> inst
    IrResumeI64(dst, value) -> IrResumeI64(dst, pipeline_ir_alias_env_lookup_or(aliases, value))
    IrTryI64(dst, value, effect_key) -> IrTryI64(dst, pipeline_ir_alias_env_lookup_or(aliases, value), effect_key)
    IrOptChainI64(dst, base, field_hash, field_index, effect_key) -> IrOptChainI64(dst, pipeline_ir_alias_env_lookup_or(aliases, base), field_hash, field_index, effect_key)
    IrCallI64(dst, callee_hash, args) -> IrCallI64(dst, callee_hash, pipeline_ir_rewrite_value_list(args, aliases))
    IrCallResultLaneI64(dst, lane) -> inst
    IrReturnLaneI64(lane, value) -> IrReturnLaneI64(lane, pipeline_ir_alias_env_lookup_or(aliases, value))
    IrIndirectCallI64(dst, callee, args) -> IrIndirectCallI64(dst, pipeline_ir_alias_env_lookup_or(aliases, callee), pipeline_ir_rewrite_value_list(args, aliases))
    IrGenericCallI64(dst, callee_hash, type_args, args) -> IrGenericCallI64(dst, callee_hash, type_args, pipeline_ir_rewrite_value_list(args, aliases))
    IrVectorGetI64(dst, vec, index, fallback, check_mode) -> IrVectorGetI64(dst, pipeline_ir_alias_env_lookup_or(aliases, vec), pipeline_ir_alias_env_lookup_or(aliases, index), pipeline_ir_alias_env_lookup_or(aliases, fallback), check_mode)
    IrVectorSetI64(dst, vec, index, value, check_mode) -> IrVectorSetI64(dst, pipeline_ir_alias_env_lookup_or(aliases, vec), pipeline_ir_alias_env_lookup_or(aliases, index), pipeline_ir_alias_env_lookup_or(aliases, value), check_mode)
    IrMethodCallI64(dst, type_hash, method_hash, receiver, args) -> IrMethodCallI64(dst, type_hash, method_hash, pipeline_ir_alias_env_lookup_or(aliases, receiver), pipeline_ir_rewrite_value_list(args, aliases))
    IrOwnedDropI64(value, type_hash) -> IrOwnedDropI64(pipeline_ir_alias_env_lookup_or(aliases, value), type_hash)
    IrArrayStorageI64(dst, byte_size, align) -> inst
    IrArrayCopyI64(dst_data, src_data, byte_size, leaf_count, leaf_stride, leaf_kind) -> IrArrayCopyI64(pipeline_ir_alias_env_lookup_or(aliases, dst_data), pipeline_ir_alias_env_lookup_or(aliases, src_data), byte_size, leaf_count, leaf_stride, leaf_kind)
    IrArrayDropI64(data, leaf_count, leaf_stride, leaf_kind) -> IrArrayDropI64(pipeline_ir_alias_env_lookup_or(aliases, data), leaf_count, leaf_stride, leaf_kind)
    IrVariantInitI64(dst, tag_hash, payloads, field_mask) -> IrVariantInitI64(dst, tag_hash, pipeline_ir_rewrite_value_list(payloads, aliases), field_mask)
    IrVariantTagI64(dst, base) -> IrVariantTagI64(dst, pipeline_ir_alias_env_lookup_or(aliases, base))
    IrVariantPayloadI64(dst, base, index) -> IrVariantPayloadI64(dst, pipeline_ir_alias_env_lookup_or(aliases, base), index)
    IrRecordInitI64(dst, type_hash, fields) -> IrRecordInitI64(dst, type_hash, pipeline_ir_rewrite_record_fields(fields, aliases))
    IrRecordLayoutInitI64(dst, type_hash, data_size, align, fields) -> IrRecordLayoutInitI64(dst, type_hash, data_size, align, pipeline_ir_rewrite_record_layout_fields(fields, aliases))
    IrRecordLayoutArrayLoadI64(dst_data, base, record_data_size, byte_offset, byte_size, leaf_count, leaf_stride, leaf_kind) -> IrRecordLayoutArrayLoadI64(pipeline_ir_alias_env_lookup_or(aliases, dst_data), pipeline_ir_alias_env_lookup_or(aliases, base), record_data_size, byte_offset, byte_size, leaf_count, leaf_stride, leaf_kind)
    IrRecordLayoutWordLoadI64(dst, base, record_data_size, field_hash, byte_offset) -> IrRecordLayoutWordLoadI64(dst, pipeline_ir_alias_env_lookup_or(aliases, base), record_data_size, field_hash, byte_offset)
    IrFieldLoadI64(dst, base, field_hash, field_index) -> IrFieldLoadI64(dst, pipeline_ir_alias_env_lookup_or(aliases, base), field_hash, field_index)
    IrSlotI64(slot) -> inst
    -- Slot ids name storage cells, not SSA values. Copy/alias propagation may
    -- rewrite values stored into or loaded from a slot, but must never rewrite
    -- the slot operand itself.
    IrLoadI64(dst, slot) -> IrLoadI64(dst, slot)
    IrStoreI64(slot, value) -> IrStoreI64(slot, pipeline_ir_alias_env_lookup_or(aliases, value))
  }
}

fn pipeline_ir_rewrite_term(term: IrTerminator, aliases: PipelineIrAliasEnv) -> IrTerminator {
  match term {
    IrTermNone -> IrTermNone
    IrTermReturn(value) -> IrTermReturn(pipeline_ir_alias_env_lookup_or(aliases, value))
    IrTermJump(target, args) -> IrTermJump(target, pipeline_ir_rewrite_value_list(args, aliases))
    IrTermBranch(cond, then_block, else_block) -> IrTermBranch(pipeline_ir_alias_env_lookup_or(aliases, cond), then_block, else_block)
  }
}

fn pipeline_ir_max_i64(a: i64, b: i64) -> i64 {
  if a > b { a } else { b }
}

fn pipeline_ir_max_value_list(values: IrValueList, current: i64) -> i64 {
  match values {
    IrValueNil -> current
    IrValueCons(value, rest) -> pipeline_ir_max_value_list(rest, pipeline_ir_max_i64(current, value))
  }
}

fn pipeline_ir_max_record_fields(fields: IrRecordFieldList, current: i64) -> i64 {
  match fields {
    IrRecordFieldNil -> current
    IrRecordFieldCons(field_hash, word_offset, value, rest) -> pipeline_ir_max_record_fields(rest, pipeline_ir_max_i64(current, value))
  }
}

fn pipeline_ir_max_record_layout_fields(fields: IrRecordLayoutFieldList, current: i64) -> i64 {
  match fields {
    IrRecordLayoutFieldNil -> current
    IrRecordLayoutFieldWord(field_hash, byte_offset, value, managed_kind, rest) -> pipeline_ir_max_record_layout_fields(rest, pipeline_ir_max_i64(current, value))
    IrRecordLayoutFieldArray(field_hash, byte_offset, data, byte_size, leaf_count, leaf_stride, leaf_kind, rest) -> pipeline_ir_max_record_layout_fields(rest, pipeline_ir_max_i64(current, data))
  }
}

fn pipeline_ir_max_lambda_captures(captures: i64, current: i64) -> i64 {
  let mut result = current
  let mut i = 0
  let n = if captures == 0 { 0 } else { nlist_len(captures) }
  while i < n {
    let capture = nlist_get(captures, i)
    let last_lane = node_f3(capture) + pipeline_capture_lane_count(capture) - 1
    result = pipeline_ir_max_i64(result, last_lane)
    i = i + 1
  }
  result
}

fn pipeline_ir_max_handler_clause_captures(clauses: IrHandlerClauseBodyList, current: i64) -> i64 {
  match clauses {
    IrHandlerClauseBodyNil -> current
    IrHandlerClauseBodyCons(body, rest) -> {
      let next = match body {
        IrHandlerClauseBody(op_hash, nparams, captures, has_continuation, is_abortive, result_cleanup_kind, transferred_param_value_fact, resume_lanes, result_lanes, first_value, blocks) -> pipeline_ir_max_lambda_captures(captures, current)
        IrHandlerClauseBodyInvalid(reason) -> current
      }
      pipeline_ir_max_handler_clause_captures(rest, next)
    }
  }
}

fn pipeline_ir_max_deferred_body_captures(body: IrDeferredHandlerBody, current: i64) -> i64 {
  match body {
    IrDeferredHandlerBody(captures, ops_value, result_lanes, first_value, blocks) -> pipeline_ir_max_lambda_captures(captures, current)
    IrDeferredHandlerBodyInvalid(reason) -> current
  }
}

fn pipeline_ir_max_inst_value(inst: IrInst, current: i64) -> i64 {
  match inst {
    IrConstI64(dst, value) -> pipeline_ir_max_i64(current, dst)
    IrNilI64(dst) -> pipeline_ir_max_i64(current, dst)
    IrStringLit(dst, start, len) -> pipeline_ir_max_i64(current, dst)
    IrStringConcatI64(dst, left, right) -> pipeline_ir_max_i64(pipeline_ir_max_i64(pipeline_ir_max_i64(current, dst), left), right)
    IrBinaryI64(dst, op, lhs, rhs) -> pipeline_ir_max_i64(pipeline_ir_max_i64(pipeline_ir_max_i64(current, dst), lhs), rhs)
    IrFloatBinaryI64(dst, prim, op, lhs, rhs) -> pipeline_ir_max_i64(pipeline_ir_max_i64(pipeline_ir_max_i64(current, dst), lhs), rhs)
    IrUnaryI64(dst, op, value) -> pipeline_ir_max_i64(pipeline_ir_max_i64(current, dst), value)
    IrClosureI64(dst, f, captures, eff) -> pipeline_ir_max_lambda_captures(captures, pipeline_ir_max_i64(current, dst))
    IrFunctionRefI64(dst, callee_hash) -> pipeline_ir_max_i64(current, dst)
    IrGenericFunctionRefI64(dst, callee_hash, type_args) -> pipeline_ir_max_i64(current, dst)
    IrAddressOfSlotI64(dst, slot) -> pipeline_ir_max_i64(pipeline_ir_max_i64(current, dst), slot)
    IrPtrLoadI64(dst, ptr) -> pipeline_ir_max_i64(pipeline_ir_max_i64(current, dst), ptr)
    IrPtrStoreI64(dst, ptr, value) -> pipeline_ir_max_i64(pipeline_ir_max_i64(pipeline_ir_max_i64(current, dst), ptr), value)
    IrLoweringFailureI64(reason) -> current
    IrPerformI64(dst, effect_hash, op_hash, args) -> pipeline_ir_max_value_list(args, pipeline_ir_max_i64(current, dst))
    IrHandlerDirectI64(dst, effect_hash, op_hash, handler_depth, clause_index, args) -> pipeline_ir_max_value_list(args, pipeline_ir_max_i64(current, dst))
    IrHandlerPopI64(frame) -> pipeline_ir_max_i64(current, frame)
    IrAbortLandingI64(dst) -> pipeline_ir_max_i64(current, dst)
    IrBindI64(ns, nl, value, ty) -> pipeline_ir_max_i64(current, value)
    IrHandleI64(dst, handle_src, effect_hash, clauses, nclauses, reserved) -> pipeline_ir_max_handler_clause_captures(clauses, pipeline_ir_max_i64(current, dst))
    IrDeferredHandleI64(dst, handle_src, body, clauses, nclauses, effect_hash, scratch_base) -> {
      pipeline_ir_max_deferred_body_captures(
        body,
        pipeline_ir_max_handler_clause_captures(
          clauses,
          pipeline_ir_max_i64(pipeline_ir_max_i64(current, dst), scratch_base + pipeline_ir_native_deferred_handle_scratch_count() - 1)
        )
      )
    }
    IrResumeI64(dst, value) -> pipeline_ir_max_i64(pipeline_ir_max_i64(current, dst), value)
    IrTryI64(dst, value, effect_key) -> pipeline_ir_max_i64(pipeline_ir_max_i64(current, dst), value)
    IrOptChainI64(dst, base, field_hash, field_index, effect_key) -> pipeline_ir_max_i64(pipeline_ir_max_i64(current, dst), base)
    IrCallI64(dst, callee_hash, args) -> pipeline_ir_max_value_list(args, pipeline_ir_max_i64(current, dst))
    IrCallResultLaneI64(dst, lane) -> pipeline_ir_max_i64(current, dst)
    IrReturnLaneI64(lane, value) -> pipeline_ir_max_i64(current, value)
    IrIndirectCallI64(dst, callee, args) -> pipeline_ir_max_value_list(args, pipeline_ir_max_i64(pipeline_ir_max_i64(current, dst), callee))
    IrGenericCallI64(dst, callee_hash, type_args, args) -> pipeline_ir_max_value_list(args, pipeline_ir_max_i64(current, dst))
    IrVectorGetI64(dst, vec, index, fallback, check_mode) -> pipeline_ir_max_i64(pipeline_ir_max_i64(pipeline_ir_max_i64(pipeline_ir_max_i64(current, dst), vec), index), fallback)
    IrVectorSetI64(dst, vec, index, value, check_mode) -> pipeline_ir_max_i64(pipeline_ir_max_i64(pipeline_ir_max_i64(pipeline_ir_max_i64(current, dst), vec), index), value)
    IrMethodCallI64(dst, type_hash, method_hash, receiver, args) -> pipeline_ir_max_value_list(args, pipeline_ir_max_i64(pipeline_ir_max_i64(current, dst), receiver))
    IrOwnedDropI64(value, type_hash) -> pipeline_ir_max_i64(current, value)
    IrArrayStorageI64(dst, byte_size, align) -> pipeline_ir_max_i64(current, dst)
    IrArrayCopyI64(dst_data, src_data, byte_size, leaf_count, leaf_stride, leaf_kind) -> pipeline_ir_max_i64(pipeline_ir_max_i64(current, dst_data), src_data)
    IrArrayDropI64(data, leaf_count, leaf_stride, leaf_kind) -> pipeline_ir_max_i64(current, data)
    IrVariantInitI64(dst, tag_hash, payloads, field_mask) -> pipeline_ir_max_value_list(payloads, pipeline_ir_max_i64(current, dst))
    IrVariantTagI64(dst, base) -> pipeline_ir_max_i64(pipeline_ir_max_i64(current, dst), base)
    IrVariantPayloadI64(dst, base, index) -> pipeline_ir_max_i64(pipeline_ir_max_i64(current, dst), base)
    IrRecordInitI64(dst, type_hash, fields) -> pipeline_ir_max_record_fields(fields, pipeline_ir_max_i64(current, dst))
    IrRecordLayoutInitI64(dst, type_hash, data_size, align, fields) -> pipeline_ir_max_record_layout_fields(fields, pipeline_ir_max_i64(current, dst))
    IrRecordLayoutArrayLoadI64(dst_data, base, record_data_size, byte_offset, byte_size, leaf_count, leaf_stride, leaf_kind) -> pipeline_ir_max_i64(pipeline_ir_max_i64(current, dst_data), base)
    IrRecordLayoutWordLoadI64(dst, base, record_data_size, field_hash, byte_offset) -> pipeline_ir_max_i64(pipeline_ir_max_i64(current, dst), base)
    IrFieldLoadI64(dst, base, field_hash, field_index) -> pipeline_ir_max_i64(pipeline_ir_max_i64(current, dst), base)
    IrSlotI64(slot) -> pipeline_ir_max_i64(current, slot)
    IrLoadI64(dst, slot) -> pipeline_ir_max_i64(pipeline_ir_max_i64(current, dst), slot)
    IrStoreI64(slot, value) -> pipeline_ir_max_i64(pipeline_ir_max_i64(current, slot), value)
  }
}

fn pipeline_ir_max_inst_list_value(insts: IrInstList, current: i64) -> i64 {
  match insts {
    IrInstNil -> current
    IrInstCons(inst, rest) -> pipeline_ir_max_inst_list_value(rest, pipeline_ir_max_inst_value(inst, current))
  }
}

fn pipeline_ir_max_term_value(term: IrTerminator, current: i64) -> i64 {
  match term {
    IrTermNone -> current
    IrTermReturn(value) -> pipeline_ir_max_i64(current, value)
    IrTermJump(target, args) -> pipeline_ir_max_value_list(args, current)
    IrTermBranch(cond, then_block, else_block) -> pipeline_ir_max_i64(current, cond)
  }
}

fn pipeline_ir_max_block_value(block: IrBlock, current: i64) -> i64 {
  match block {
    IrBlock(id, params, insts, term) -> {
      let with_params = pipeline_ir_max_value_list(params, current)
      let with_insts = pipeline_ir_max_inst_list_value(insts, with_params)
      pipeline_ir_max_term_value(term, with_insts)
    }
  }
}

fn pipeline_ir_max_block_list_value(blocks: IrBlockList, current: i64) -> i64 {
  match blocks {
    IrBlockListNil -> current
    IrBlockListCons(block, rest) -> pipeline_ir_max_block_list_value(rest, pipeline_ir_max_block_value(block, current))
  }
}

fn pipeline_ir_function_next_value(param_count: i64, blocks: IrBlockList) -> i64 {
  pipeline_ir_max_block_list_value(blocks, param_count - 1) + 1
}

-- =====================================================================
-- 2v Stage 1 pre-measurement: register pressure + live-across-call
-- liveness over optimized typed IR. Pure fact producer (audit-tier):
-- backward bitset liveness with block-arg semantics — live-out(B) =
-- ∪_s (live-in(s) \ params(s)); jump edge args, branch conds, and
-- return values are uses at B's terminator. Slots are values (they can
-- be register-resident): IrStore defs its slot, IrLoad uses it,
-- address-taken slots stay live conservatively. Fixpoint sweeps to
-- convergence (liveness only grows — monotone), then one recording
-- pass notes per-function max simultaneous live values and, at every
-- call-shaped instruction, the count of values live across the call
-- (live-after minus the result). Call-shaped = anything lowering
-- through BL/BLR (calls, method/generic/indirect, performs, handler
-- installs/direct dispatch, resume, string concat, owned drop);
-- inline-fast-path allocs (variant/record init) are not counted.
-- Nested handler-clause bodies are separate emission domains and are
-- not yet measured (named gap); closure-embedded functions are
-- measured once, deduped by hash like the emission mono cache.

fn pipeline_ir_live_words(nv: i64) -> i64 { nv / 64 + 1 }

fn pipeline_ir_live_get(set: i64, v: i64) -> i64 {
  (mem_load64_at(set, (v / 64) * 8) bshr (v - v / 64 * 64)) band 1
}

fn pipeline_ir_live_add(set: i64, v: i64, count: i64) -> i64 {
  if v < 0 { count }
  else { if pipeline_ir_live_get(set, v) == 1 { count }
  else {
    mem_store64_at(set, (v / 64) * 8, mem_load64_at(set, (v / 64) * 8) bor (1 bshl (v - v / 64 * 64)))
    count + 1
  } }
}

fn pipeline_ir_live_kill(set: i64, v: i64, count: i64) -> i64 {
  if v < 0 { count }
  else { if pipeline_ir_live_get(set, v) == 0 { count }
  else {
    mem_store64_at(set, (v / 64) * 8, mem_load64_at(set, (v / 64) * 8) bxor (1 bshl (v - v / 64 * 64)))
    count - 1
  } }
}

fn pipeline_ir_live_popcount(set: i64, words: i64) -> i64 {
  let mut c = 0
  for w in 0..words {
    let x = mem_load64_at(set, w * 8)
    if x != 0 {
      for b in 0..64 {
        c = c + ((x bshr b) band 1)
      }
    } else { 0 }
  }
  c
}

fn pipeline_ir_live_add_value_list(set: i64, values: IrValueList, count: i64) -> i64 {
  match values {
    IrValueNil -> count
    IrValueCons(value, rest) -> pipeline_ir_live_add_value_list(set, rest, pipeline_ir_live_add(set, value, count))
  }
}

fn pipeline_ir_live_kill_value_list(set: i64, values: IrValueList, count: i64) -> i64 {
  match values {
    IrValueNil -> count
    IrValueCons(value, rest) -> pipeline_ir_live_kill_value_list(set, rest, pipeline_ir_live_kill(set, value, count))
  }
}

fn pipeline_ir_live_add_record_fields(set: i64, fields: IrRecordFieldList, count: i64) -> i64 {
  match fields {
    IrRecordFieldNil -> count
    IrRecordFieldCons(field_hash, word_offset, value, rest) -> pipeline_ir_live_add_record_fields(set, rest, pipeline_ir_live_add(set, value, count))
  }
}

fn pipeline_ir_live_add_record_layout_fields(set: i64, fields: IrRecordLayoutFieldList, count: i64) -> i64 {
  match fields {
    IrRecordLayoutFieldNil -> count
    IrRecordLayoutFieldWord(field_hash, byte_offset, value, managed_kind, rest) -> pipeline_ir_live_add_record_layout_fields(set, rest, pipeline_ir_live_add(set, value, count))
    IrRecordLayoutFieldArray(field_hash, byte_offset, data, byte_size, leaf_count, leaf_stride, leaf_kind, rest) -> pipeline_ir_live_add_record_layout_fields(set, rest, pipeline_ir_live_add(set, data, count))
  }
}

fn pipeline_ir_live_add_captures(set: i64, captures: i64, count: i64) -> i64 {
  let mut c = count
  let n = if captures == 0 { 0 } else { nlist_len(captures) }
  for i in 0..n {
    let capture = nlist_get(captures, i)
    let lanes = pipeline_capture_lane_count(capture)
    for lane in 0..lanes {
      c = pipeline_ir_live_add(set, node_f3(capture) + lane, c)
    }
  }
  c
}

fn pipeline_ir_live_add_clause_captures(set: i64, clauses: IrHandlerClauseBodyList, count: i64) -> i64 {
  match clauses {
    IrHandlerClauseBodyNil -> count
    IrHandlerClauseBodyCons(body, rest) -> {
      let next = match body {
        IrHandlerClauseBody(op_hash, nparams, captures, has_continuation, is_abortive, result_cleanup_kind, transferred_param_value_fact, resume_lanes, result_lanes, first_value, blocks) -> pipeline_ir_live_add_captures(set, captures, count)
        IrHandlerClauseBodyInvalid(reason) -> count
      }
      pipeline_ir_live_add_clause_captures(set, rest, next)
    }
  }
}

fn pipeline_ir_live_add_deferred_captures(set: i64, body: IrDeferredHandlerBody, count: i64) -> i64 {
  match body {
    IrDeferredHandlerBody(captures, ops_value, result_lanes, first_value, blocks) -> pipeline_ir_live_add_captures(set, captures, count)
    IrDeferredHandlerBodyInvalid(reason) -> count
  }
}

fn pipeline_ir_live_inst_def(inst: IrInst) -> i64 {
  match inst {
    IrConstI64(dst, value) -> dst
    IrNilI64(dst) -> dst
    IrStringLit(dst, start, len) -> dst
    IrStringConcatI64(dst, left, right) -> dst
    IrBinaryI64(dst, op, lhs, rhs) -> dst
    IrFloatBinaryI64(dst, prim, op, lhs, rhs) -> dst
    IrUnaryI64(dst, op, value) -> dst
    IrClosureI64(dst, f, captures, eff) -> dst
    IrFunctionRefI64(dst, callee_hash) -> dst
    IrGenericFunctionRefI64(dst, callee_hash, type_args) -> dst
    IrAddressOfSlotI64(dst, slot) -> dst
    IrPtrLoadI64(dst, ptr) -> dst
    IrPtrStoreI64(dst, ptr, value) -> dst
    IrLoweringFailureI64(reason) -> 0 - 1
    IrPerformI64(dst, effect_hash, op_hash, args) -> dst
    IrHandlerDirectI64(dst, effect_hash, op_hash, handler_depth, clause_index, args) -> dst
    IrHandlerPopI64(frame) -> 0 - 1
    IrAbortLandingI64(dst) -> dst
    IrBindI64(ns, nl, value, ty) -> 0 - 1
    IrHandleI64(dst, handle_src, effect_hash, clauses, nclauses, reserved) -> dst
    IrDeferredHandleI64(dst, handle_src, body, clauses, nclauses, effect_hash, scratch_base) -> dst
    IrResumeI64(dst, value) -> dst
    IrTryI64(dst, value, effect_key) -> dst
    IrOptChainI64(dst, base, field_hash, field_index, effect_key) -> dst
    IrCallI64(dst, callee_hash, args) -> dst
    IrCallResultLaneI64(dst, lane) -> dst
    IrReturnLaneI64(lane, value) -> 0 - 1
    IrIndirectCallI64(dst, callee, args) -> dst
    IrGenericCallI64(dst, callee_hash, type_args, args) -> dst
    IrVectorGetI64(dst, vec, index, fallback, check_mode) -> dst
    IrVectorSetI64(dst, vec, index, value, check_mode) -> dst
    IrMethodCallI64(dst, type_hash, method_hash, receiver, args) -> dst
    IrOwnedDropI64(value, type_hash) -> 0 - 1
    IrArrayStorageI64(dst, byte_size, align) -> dst
    IrArrayCopyI64(dst_data, src_data, byte_size, leaf_count, leaf_stride, leaf_kind) -> 0 - 1
    IrArrayDropI64(data, leaf_count, leaf_stride, leaf_kind) -> 0 - 1
    IrVariantInitI64(dst, tag_hash, payloads, field_mask) -> dst
    IrVariantTagI64(dst, base) -> dst
    IrVariantPayloadI64(dst, base, index) -> dst
    IrRecordInitI64(dst, type_hash, fields) -> dst
    IrRecordLayoutInitI64(dst, type_hash, data_size, align, fields) -> dst
    IrRecordLayoutArrayLoadI64(dst_data, base, record_data_size, byte_offset, byte_size, leaf_count, leaf_stride, leaf_kind) -> 0 - 1
    IrRecordLayoutWordLoadI64(dst, base, record_data_size, field_hash, byte_offset) -> dst
    IrFieldLoadI64(dst, base, field_hash, field_index) -> dst
    IrSlotI64(slot) -> slot
    IrLoadI64(dst, slot) -> dst
    IrStoreI64(slot, value) -> slot
  }
}

fn pipeline_ir_live_inst_is_call(inst: IrInst) -> i64 {
  match inst {
    IrCallI64(dst, callee_hash, args) -> 1
    IrIndirectCallI64(dst, callee, args) -> 1
    IrGenericCallI64(dst, callee_hash, type_args, args) -> 1
    IrMethodCallI64(dst, type_hash, method_hash, receiver, args) -> 1
    IrPerformI64(dst, effect_hash, op_hash, args) -> 1
    IrHandlerDirectI64(dst, effect_hash, op_hash, handler_depth, clause_index, args) -> 1
    IrHandleI64(dst, handle_src, effect_hash, clauses, nclauses, reserved) -> 1
    IrDeferredHandleI64(dst, handle_src, body, clauses, nclauses, effect_hash, scratch_base) -> 1
    IrResumeI64(dst, value) -> 1
    IrStringConcatI64(dst, left, right) -> 1
    IrOwnedDropI64(value, type_hash) -> 1
    IrArrayCopyI64(dst_data, src_data, byte_size, leaf_count, leaf_stride, leaf_kind) -> pipeline_array_drop_plan_is_active(leaf_count, leaf_stride, leaf_kind)
    IrRecordLayoutArrayLoadI64(dst_data, base, record_data_size, byte_offset, byte_size, leaf_count, leaf_stride, leaf_kind) -> pipeline_array_drop_plan_is_active(leaf_count, leaf_stride, leaf_kind)
    IrArrayDropI64(data, leaf_count, leaf_stride, leaf_kind) -> 1
    _ -> 0
  }
}

fn pipeline_ir_live_add_inst_uses(set: i64, inst: IrInst, count: i64) -> i64 {
  match inst {
    IrConstI64(dst, value) -> count
    IrNilI64(dst) -> count
    IrStringLit(dst, start, len) -> count
    IrStringConcatI64(dst, left, right) -> pipeline_ir_live_add(set, right, pipeline_ir_live_add(set, left, count))
    IrBinaryI64(dst, op, lhs, rhs) -> pipeline_ir_live_add(set, rhs, pipeline_ir_live_add(set, lhs, count))
    IrFloatBinaryI64(dst, prim, op, lhs, rhs) -> pipeline_ir_live_add(set, rhs, pipeline_ir_live_add(set, lhs, count))
    IrUnaryI64(dst, op, value) -> pipeline_ir_live_add(set, value, count)
    IrClosureI64(dst, f, captures, eff) -> pipeline_ir_live_add_captures(set, captures, count)
    IrFunctionRefI64(dst, callee_hash) -> count
    IrGenericFunctionRefI64(dst, callee_hash, type_args) -> count
    IrAddressOfSlotI64(dst, slot) -> pipeline_ir_live_add(set, slot, count)
    IrPtrLoadI64(dst, ptr) -> pipeline_ir_live_add(set, ptr, count)
    IrPtrStoreI64(dst, ptr, value) -> pipeline_ir_live_add(set, value, pipeline_ir_live_add(set, ptr, count))
    IrLoweringFailureI64(reason) -> count
    IrPerformI64(dst, effect_hash, op_hash, args) -> pipeline_ir_live_add_value_list(set, args, count)
    IrHandlerDirectI64(dst, effect_hash, op_hash, handler_depth, clause_index, args) -> pipeline_ir_live_add_value_list(set, args, count)
    IrHandlerPopI64(frame) -> pipeline_ir_live_add(set, frame, count)
    IrAbortLandingI64(dst) -> count
    IrBindI64(ns, nl, value, ty) -> pipeline_ir_live_add(set, value, count)
    IrHandleI64(dst, handle_src, effect_hash, clauses, nclauses, reserved) -> pipeline_ir_live_add_clause_captures(set, clauses, count)
    IrDeferredHandleI64(dst, handle_src, body, clauses, nclauses, effect_hash, scratch_base) -> pipeline_ir_live_add_deferred_captures(set, body, pipeline_ir_live_add_clause_captures(set, clauses, count))
    IrResumeI64(dst, value) -> pipeline_ir_live_add(set, value, count)
    IrTryI64(dst, value, effect_key) -> pipeline_ir_live_add(set, value, count)
    IrOptChainI64(dst, base, field_hash, field_index, effect_key) -> pipeline_ir_live_add(set, base, count)
    IrCallI64(dst, callee_hash, args) -> pipeline_ir_live_add_value_list(set, args, count)
    IrCallResultLaneI64(dst, lane) -> count
    IrReturnLaneI64(lane, value) -> pipeline_ir_live_add(set, value, count)
    IrIndirectCallI64(dst, callee, args) -> pipeline_ir_live_add_value_list(set, args, pipeline_ir_live_add(set, callee, count))
    IrGenericCallI64(dst, callee_hash, type_args, args) -> pipeline_ir_live_add_value_list(set, args, count)
    IrVectorGetI64(dst, vec, index, fallback, check_mode) -> pipeline_ir_live_add(set, fallback, pipeline_ir_live_add(set, index, pipeline_ir_live_add(set, vec, count)))
    IrVectorSetI64(dst, vec, index, value, check_mode) -> pipeline_ir_live_add(set, value, pipeline_ir_live_add(set, index, pipeline_ir_live_add(set, vec, count)))
    IrMethodCallI64(dst, type_hash, method_hash, receiver, args) -> pipeline_ir_live_add_value_list(set, args, pipeline_ir_live_add(set, receiver, count))
    IrOwnedDropI64(value, type_hash) -> pipeline_ir_live_add(set, value, count)
    IrArrayStorageI64(dst, byte_size, align) -> count
    IrArrayCopyI64(dst_data, src_data, byte_size, leaf_count, leaf_stride, leaf_kind) -> pipeline_ir_live_add(set, src_data, pipeline_ir_live_add(set, dst_data, count))
    IrArrayDropI64(data, leaf_count, leaf_stride, leaf_kind) -> pipeline_ir_live_add(set, data, count)
    IrVariantInitI64(dst, tag_hash, payloads, field_mask) -> pipeline_ir_live_add_value_list(set, payloads, count)
    IrVariantTagI64(dst, base) -> pipeline_ir_live_add(set, base, count)
    IrVariantPayloadI64(dst, base, index) -> pipeline_ir_live_add(set, base, count)
    IrRecordInitI64(dst, type_hash, fields) -> pipeline_ir_live_add_record_fields(set, fields, count)
    IrRecordLayoutInitI64(dst, type_hash, data_size, align, fields) -> pipeline_ir_live_add_record_layout_fields(set, fields, count)
    IrRecordLayoutArrayLoadI64(dst_data, base, record_data_size, byte_offset, byte_size, leaf_count, leaf_stride, leaf_kind) -> pipeline_ir_live_add(set, base, pipeline_ir_live_add(set, dst_data, count))
    IrRecordLayoutWordLoadI64(dst, base, record_data_size, field_hash, byte_offset) -> pipeline_ir_live_add(set, base, count)
    IrFieldLoadI64(dst, base, field_hash, field_index) -> pipeline_ir_live_add(set, base, count)
    IrSlotI64(slot) -> count
    IrLoadI64(dst, slot) -> pipeline_ir_live_add(set, slot, count)
    IrStoreI64(slot, value) -> pipeline_ir_live_add(set, value, count)
  }
}

fn pipeline_ir_live_add_term_uses(set: i64, term: IrTerminator, count: i64) -> i64 {
  match term {
    IrTermNone -> count
    IrTermReturn(value) -> pipeline_ir_live_add(set, value, count)
    IrTermJump(target, args) -> pipeline_ir_live_add_value_list(set, args, count)
    IrTermBranch(cond, then_block, else_block) -> pipeline_ir_live_add(set, cond, count)
  }
}

fn pipeline_ir_live_prepass(blocks: IrBlockList, i: i64, ids: i64, params_sets: i64, words: i64) -> i64 {
  match blocks {
    IrBlockListNil -> i
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          mem_store64_at(ids, i * 8, id)
          pipeline_ir_live_add_value_list(params_sets + i * words * 8, params, 0)
          0
        }
      }
      pipeline_ir_live_prepass(rest, i + 1, ids, params_sets, words)
    }
  }
}

fn pipeline_ir_live_block_index(ids: i64, nb: i64, id: i64) -> i64 {
  let mut found = 0 - 1
  for i in 0..nb {
    if mem_load64_at(ids, i * 8) == id { found = i } else { 0 }
  }
  found
}

fn pipeline_ir_live_merge_succ(scratch: i64, words: i64, livein_sets: i64, params_sets: i64, si: i64) -> i64 {
  if si < 0 { 0 }
  else {
    for w in 0..words {
      mem_store64_at(scratch, w * 8, mem_load64_at(scratch, w * 8) bor (mem_load64_at(livein_sets, (si * words + w) * 8) band (mem_load64_at(params_sets, (si * words + w) * 8) bxor (0 - 1))))
    }
    0
  }
}

fn pipeline_ir_live_out_build(scratch: i64, words: i64, term: IrTerminator, ids: i64, nb: i64, livein_sets: i64, params_sets: i64) -> i64 {
  for w in 0..words {
    mem_store64_at(scratch, w * 8, 0)
  }
  match term {
    IrTermNone -> 0
    IrTermReturn(value) -> 0
    IrTermJump(target, args) -> pipeline_ir_live_merge_succ(scratch, words, livein_sets, params_sets, pipeline_ir_live_block_index(ids, nb, target))
    IrTermBranch(cond, then_block, else_block) -> {
      pipeline_ir_live_merge_succ(scratch, words, livein_sets, params_sets, pipeline_ir_live_block_index(ids, nb, then_block))
      pipeline_ir_live_merge_succ(scratch, words, livein_sets, params_sets, pipeline_ir_live_block_index(ids, nb, else_block))
    }
  }
  pipeline_ir_live_popcount(scratch, words)
}

fn pipeline_ir_live_insts_backward(insts: IrInstList, set: i64, count: i64, fm: i64, stats: i64, record: i64) -> i64 {
  match insts {
    IrInstNil -> count
    IrInstCons(inst, rest) -> {
      let after = pipeline_ir_live_insts_backward(rest, set, count, fm, stats, record)
      let killed = pipeline_ir_live_kill(set, pipeline_ir_live_inst_def(inst), after)
      if record == 1 and pipeline_ir_live_inst_is_call(inst) == 1 {
        fmap_note_call_crossing(fm, killed)
      } else { 0 }
      let live = pipeline_ir_live_add_inst_uses(set, inst, killed)
      if record == 1 and live > mem_load64_at(stats, 0) {
        mem_store64_at(stats, 0, live)
      } else { 0 }
      live
    }
  }
}

fn pipeline_ir_live_block_process(block: IrBlock, i: i64, ids: i64, nb: i64, words: i64, livein_sets: i64, params_sets: i64, scratch: i64, fm: i64, stats: i64, record: i64) -> i64 {
  match block {
    IrBlock(id, params, insts, term) -> {
      let out_count = pipeline_ir_live_out_build(scratch, words, term, ids, nb, livein_sets, params_sets)
      let with_term = pipeline_ir_live_add_term_uses(scratch, term, out_count)
      if record == 1 and with_term > mem_load64_at(stats, 0) {
        mem_store64_at(stats, 0, with_term)
      } else { 0 }
      let in_count = pipeline_ir_live_insts_backward(insts, scratch, with_term, fm, stats, record)
      pipeline_ir_live_kill_value_list(scratch, params, in_count)
      let mut changed = 0
      for w in 0..words {
        let old = mem_load64_at(livein_sets, (i * words + w) * 8)
        let new = mem_load64_at(scratch, w * 8)
        if new != old {
          mem_store64_at(livein_sets, (i * words + w) * 8, new)
          changed = 1
        } else { 0 }
      }
      changed
    }
  }
}

-- Post-order recursion processes the last block first — the natural
-- direction for backward dataflow, so most functions converge in two
-- sweeps.
fn pipeline_ir_live_sweep(blocks: IrBlockList, i: i64, ids: i64, nb: i64, words: i64, livein_sets: i64, params_sets: i64, scratch: i64, fm: i64, stats: i64, record: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      let changed_rest = pipeline_ir_live_sweep(rest, i + 1, ids, nb, words, livein_sets, params_sets, scratch, fm, stats, record)
      let changed_here = pipeline_ir_live_block_process(block, i, ids, nb, words, livein_sets, params_sets, scratch, fm, stats, record)
      if changed_rest == 1 or changed_here == 1 { 1 } else { 0 }
    }
  }
}

fn pipeline_ir_live_measure_function(irf: IrFunction, fm: i64, seen: i64) -> i64 {
  match irf {
    IrFunction(hash, param_count, blocks, src) -> {
      if pipeline_hash_nlist_contains(seen, hash) == 1 { 0 }
      else {
        nlist_add(seen, hash)
        let nb = ir_block_list_len(blocks)
        if nb == 0 { 0 } else {
          let nv = pipeline_ir_function_next_value(param_count, blocks)
          let words = pipeline_ir_live_words(nv)
          let ids = alloc_words(nb)
          let params_sets = alloc_words(nb * words)
          let livein_sets = alloc_words(nb * words)
          let total = nb * words
          for i in 0..total {
            mem_store64_at(params_sets, i * 8, 0)
            mem_store64_at(livein_sets, i * 8, 0)
          }
          let scratch = alloc_words(words)
          pipeline_ir_live_prepass(blocks, 0, ids, params_sets, words)
          let mut changed = 1
          let mut rounds = 0
          while changed == 1 and rounds < 1000 {
            changed = pipeline_ir_live_sweep(blocks, 0, ids, nb, words, livein_sets, params_sets, scratch, fm, 0, 0)
            rounds = rounds + 1
          }
          let stats = alloc_words(1)
          mem_store64_at(stats, 0, 0)
          pipeline_ir_live_sweep(blocks, 0, ids, nb, words, livein_sets, params_sets, scratch, fm, stats, 1)
          fmap_note_fn_pressure(fm, mem_load64_at(stats, 0))
          pipeline_ir_live_measure_closures_blocks(blocks, fm, seen)
          0
        }
      }
    }
  }
}

fn pipeline_ir_live_measure_closures_insts(insts: IrInstList, fm: i64, seen: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      match inst {
        IrClosureI64(dst, f, captures, eff) -> pipeline_ir_live_measure_function(f, fm, seen)
        _ -> 0
      }
      pipeline_ir_live_measure_closures_insts(rest, fm, seen)
    }
  }
}

fn pipeline_ir_live_measure_closures_blocks(blocks: IrBlockList, fm: i64, seen: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> pipeline_ir_live_measure_closures_insts(insts, fm, seen)
      }
      pipeline_ir_live_measure_closures_blocks(rest, fm, seen)
    }
  }
}

fn pipeline_ir_live_measure_function_list(functions: IrFunctionList, fm: i64, seen: i64) -> i64 {
  match functions {
    IrFunctionNil -> 0
    IrFunctionCons(irf, rest) -> {
      pipeline_ir_live_measure_function(irf, fm, seen)
      pipeline_ir_live_measure_function_list(rest, fm, seen)
    }
    _ -> 0
  }
}

fn pipeline_ir_live_measure_module(functions: IrFunctionList, fm: i64) -> i64 {
  pipeline_ir_live_measure_function_list(functions, fm, nlist_new())
}

fn pipeline_ir_native_max_block_param_count(blocks: IrBlockList, current: i64) -> i64 {
  match blocks {
    IrBlockListNil -> current
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          pipeline_ir_native_max_block_param_count(rest, pipeline_ir_max_i64(current, ir_value_list_len(params)))
        }
      }
    }
  }
}

fn pipeline_ir_native_value_home_count_for_blocks(param_count: i64, blocks: IrBlockList) -> i64 {
  let next_value = pipeline_ir_function_next_value(param_count, blocks)
  let temp_count = pipeline_ir_native_max_block_param_count(blocks, 0)
  if temp_count > 0 { next_value + 8 + temp_count } else { next_value }
}

fn pipeline_ir_native_frame_size_for_next_value(next_value: i64) -> i64 {
  let raw = if next_value <= 8 { cg_stack_frame_default_size() } else { (next_value - 8) * 8 }
  let aligned = cg_align16(raw)
  if aligned < cg_stack_frame_default_size() { cg_stack_frame_default_size() } else { aligned }
}

fn pipeline_ir_native_scalar_frame_size_for_blocks(param_count: i64, blocks: IrBlockList) -> i64 {
  let next_value = pipeline_ir_function_next_value(8, blocks)
  let temp_count = pipeline_ir_native_max_block_param_count(blocks, 0)
  let with_jump_temps = if temp_count > 0 { next_value + 8 + temp_count } else { next_value }
  pipeline_ir_native_frame_size_for_next_value(with_jump_temps)
}

fn pipeline_ir_native_array_storage_alignment_is_valid(align: i64) -> i64 {
  if align == 1 or align == 2 or align == 4 or align == 8 or align == 16 { 1 } else { 0 }
}

fn pipeline_ir_native_array_storage_shape_is_valid(byte_size: i64, align: i64) -> i64 {
  if byte_size >= 0 and pipeline_ir_native_array_storage_alignment_is_valid(align) == 1 { 1 } else { 0 }
}

-- Placement is codegen-local emission machinery: semantic IR supplies the
-- exact size/alignment facts, while this scan assigns disjoint native-frame
-- offsets after every ordinary SSA/save home reserved by the caller.
fn pipeline_ir_native_array_storage_facts_for_insts(insts: IrInstList, cursor: i64, facts: i64) -> i64 {
  match insts {
    IrInstNil -> cursor
    IrInstCons(inst, rest) -> {
      match inst {
        IrArrayStorageI64(dst, byte_size, align) -> {
          if pipeline_ir_native_array_storage_shape_is_valid(byte_size, align) == 1 {
            let offset = cg_layout_align_up(cursor, align)
            nlist_add(facts, node_new(0, dst, offset, byte_size, align))
            pipeline_ir_native_array_storage_facts_for_insts(rest, offset + byte_size, facts)
          } else {
            nlist_add(facts, node_new(0, dst, 0 - 1, byte_size, align))
            pipeline_ir_native_array_storage_facts_for_insts(rest, cursor, facts)
          }
        }
        _ -> pipeline_ir_native_array_storage_facts_for_insts(rest, cursor, facts)
      }
    }
  }
}

fn pipeline_ir_native_array_storage_facts_for_blocks_from(blocks: IrBlockList, cursor: i64, facts: i64) -> i64 {
  match blocks {
    IrBlockListNil -> cursor
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          let next = pipeline_ir_native_array_storage_facts_for_insts(insts, cursor, facts)
          pipeline_ir_native_array_storage_facts_for_blocks_from(rest, next, facts)
        }
      }
    }
  }
}

fn pipeline_ir_native_array_storage_facts_for_blocks(blocks: IrBlockList, base: i64) -> i64 {
  let facts = nlist_new()
  pipeline_ir_native_array_storage_facts_for_blocks_from(blocks, base, facts)
  facts
}

fn pipeline_ir_native_array_storage_fact_lookup(facts: i64, dst: i64) -> i64 {
  let mut found = 0
  let mut i = 0
  let n = if facts == 0 { 0 } else { nlist_len(facts) }
  while i < n and found == 0 {
    let fact = nlist_get(facts, i)
    if node_f1(fact) == dst { found = fact } else { i = i + 1 }
  }
  found
}

fn pipeline_ir_native_array_storage_offset_or(facts: i64, dst: i64, default: i64) -> i64 {
  let fact = pipeline_ir_native_array_storage_fact_lookup(facts, dst)
  if fact == 0 { default } else { node_f2(fact) }
}

fn pipeline_ir_native_array_storage_frame_size(base: i64, facts: i64) -> i64 {
  let mut end = base
  let n = if facts == 0 { 0 } else { nlist_len(facts) }
  for i in 0..n {
    let fact = nlist_get(facts, i)
    if node_f2(fact) >= 0 and node_f3(fact) >= 0 {
      let fact_end = node_f2(fact) + node_f3(fact)
      if fact_end > end { end = fact_end } else { 0 }
    } else { 0 }
  }
  cg_align16(end)
}

fn pipeline_ir_native_frame_size_for_blocks(param_count: i64, blocks: IrBlockList) -> i64 {
  let base = pipeline_ir_native_scalar_frame_size_for_blocks(param_count, blocks)
  pipeline_ir_native_array_storage_frame_size(base, pipeline_ir_native_array_storage_facts_for_blocks(blocks, base))
}

fn pipeline_ir_native_frame_size_for_ir_function(irf: IrFunction) -> i64 {
  match irf {
    IrFunction(hash, param_count, blocks, src) -> pipeline_ir_native_frame_size_for_blocks(param_count, blocks)
  }
}

-- Compile-time evaluation is exact for wrapping ops: the folding
-- compiler is itself a Weft program on the same target, so `lhs + rhs`
-- here is bit-identical to the add/sub/mul instruction codegen would
-- emit. Div/Mod stay unfolded pending their own semantics audit
-- (aarch64 sdiv x/0 = 0 vs any future checked-division lowering).
fn pipeline_ir_const_eval(op: IrBinaryOp, lhs: i64, rhs: i64) -> PipelineIrConstLookup {
  match op {
    IrAdd -> pipeline_ir_const_lookup(1, lhs + rhs)
    IrSub -> pipeline_ir_const_lookup(1, lhs - rhs)
    IrMul -> pipeline_ir_const_lookup(1, lhs * rhs)
    IrDiv -> pipeline_ir_const_lookup(0, 0)
    IrEq -> pipeline_ir_const_lookup(1, if lhs == rhs { 1 } else { 0 })
    IrNe -> pipeline_ir_const_lookup(1, if lhs != rhs { 1 } else { 0 })
    IrLt -> pipeline_ir_const_lookup(1, if lhs < rhs { 1 } else { 0 })
    IrGt -> pipeline_ir_const_lookup(1, if lhs > rhs { 1 } else { 0 })
    IrLe -> pipeline_ir_const_lookup(1, if lhs <= rhs { 1 } else { 0 })
    IrGe -> pipeline_ir_const_lookup(1, if lhs >= rhs { 1 } else { 0 })
    IrMod -> pipeline_ir_const_lookup(0, 0)
    IrAnd -> pipeline_ir_const_lookup(1, lhs band rhs)
    IrOr -> pipeline_ir_const_lookup(1, lhs bor rhs)
    IrBand -> pipeline_ir_const_lookup(0, 0)
    IrBor -> pipeline_ir_const_lookup(0, 0)
    IrBxor -> pipeline_ir_const_lookup(0, 0)
    IrBshl -> pipeline_ir_const_lookup(0, 0)
    IrBshr -> pipeline_ir_const_lookup(0, 0)
    _ -> pipeline_ir_const_lookup(0, 0)
  }
}

fn pipeline_ir_const_lookup_is(found: PipelineIrConstLookup, expected: i64) -> i64 {
  if pipeline_ir_const_lookup_valid(found) == 1 {
    if pipeline_ir_const_lookup_value(found) == expected { 1 } else { 0 }
  } else { 0 }
}

fn pipeline_ir_rewrite_unchanged() -> PipelineIrRewrite {
  PipelineIrRewriteUnchanged
}

fn pipeline_ir_rewrite_const(value: i64) -> PipelineIrRewrite {
  PipelineIrRewriteConst(value)
}

fn pipeline_ir_rewrite_copy(value: i64) -> PipelineIrRewrite {
  PipelineIrRewriteCopy(value)
}

fn pipeline_ir_rewrite_insts(insts: IrInstList, next_value: i64) -> PipelineIrRewrite {
  PipelineIrRewriteInsts(insts, next_value)
}

fn pipeline_ir_power_of_two_shift(value: i64) -> PipelineIrConstLookup {
  if value <= 1 {
    pipeline_ir_const_lookup(0, 0)
  } else {
    let mut n = value
    let mut shift = 0
    let mut ok = 1
    while n > 1 and ok == 1 {
      if n % 2 == 0 {
        n = n / 2
        shift = shift + 1
      } else {
        ok = 0
      }
    }
    if ok == 1 and n == 1 { pipeline_ir_const_lookup(1, shift) }
    else { pipeline_ir_const_lookup(0, 0) }
  }
}

fn pipeline_ir_rewrite_mul_power_two(dst: i64, source: i64, multiplier: i64, next_value: i64) -> PipelineIrRewrite {
  let shift = pipeline_ir_power_of_two_shift(multiplier)
  if pipeline_ir_const_lookup_valid(shift) == 1 {
    let shift_value = pipeline_ir_const_lookup_value(shift)
    let shift_id = next_value
    let insts = ir_inst_list_prepend(
      ir_inst_const_i64(shift_id, shift_value),
      ir_inst_list_prepend(ir_inst_binary_i64(dst, IrBshl, source, shift_id), ir_inst_list_empty())
    )
    pipeline_ir_rewrite_insts(insts, next_value + 1)
  } else {
    pipeline_ir_rewrite_unchanged()
  }
}

fn pipeline_ir_algebraic_rewrite(dst: i64, op: IrBinaryOp, lhs: i64, rhs: i64, left: PipelineIrConstLookup, right: PipelineIrConstLookup, next_value: i64) -> PipelineIrRewrite {
  match op {
    IrAdd -> {
      if pipeline_ir_const_lookup_is(left, 0) == 1 { pipeline_ir_rewrite_copy(rhs) }
      else { if pipeline_ir_const_lookup_is(right, 0) == 1 { pipeline_ir_rewrite_copy(lhs) }
      else { pipeline_ir_rewrite_unchanged() } }
    }
    IrSub -> {
      if lhs == rhs { pipeline_ir_rewrite_const(0) }
      else { if pipeline_ir_const_lookup_is(right, 0) == 1 { pipeline_ir_rewrite_copy(lhs) }
      else { pipeline_ir_rewrite_unchanged() } }
    }
    IrMul -> {
      if pipeline_ir_const_lookup_is(left, 0) == 1 { pipeline_ir_rewrite_const(0) }
      else { if pipeline_ir_const_lookup_is(right, 0) == 1 { pipeline_ir_rewrite_const(0) }
      else { if pipeline_ir_const_lookup_is(left, 1) == 1 { pipeline_ir_rewrite_copy(rhs) }
      else { if pipeline_ir_const_lookup_is(right, 1) == 1 { pipeline_ir_rewrite_copy(lhs) }
      else { if pipeline_ir_const_lookup_valid(left) == 1 { pipeline_ir_rewrite_mul_power_two(dst, rhs, pipeline_ir_const_lookup_value(left), next_value) }
      else { if pipeline_ir_const_lookup_valid(right) == 1 { pipeline_ir_rewrite_mul_power_two(dst, lhs, pipeline_ir_const_lookup_value(right), next_value) }
      else { pipeline_ir_rewrite_unchanged() } } } } } }
    }
    IrDiv -> if pipeline_ir_const_lookup_is(right, 1) == 1 { pipeline_ir_rewrite_copy(lhs) } else { pipeline_ir_rewrite_unchanged() }
    IrEq -> if lhs == rhs { pipeline_ir_rewrite_const(1) } else { pipeline_ir_rewrite_unchanged() }
    IrNe -> if lhs == rhs { pipeline_ir_rewrite_const(0) } else { pipeline_ir_rewrite_unchanged() }
    IrLt -> if lhs == rhs { pipeline_ir_rewrite_const(0) } else { pipeline_ir_rewrite_unchanged() }
    IrGt -> if lhs == rhs { pipeline_ir_rewrite_const(0) } else { pipeline_ir_rewrite_unchanged() }
    IrLe -> if lhs == rhs { pipeline_ir_rewrite_const(1) } else { pipeline_ir_rewrite_unchanged() }
    IrGe -> if lhs == rhs { pipeline_ir_rewrite_const(1) } else { pipeline_ir_rewrite_unchanged() }
    IrMod -> if pipeline_ir_const_lookup_is(right, 1) == 1 { pipeline_ir_rewrite_const(0) } else { pipeline_ir_rewrite_unchanged() }
    IrAnd -> {
      if pipeline_ir_const_lookup_is(left, 0) == 1 { pipeline_ir_rewrite_const(0) }
      else { if pipeline_ir_const_lookup_is(right, 0) == 1 { pipeline_ir_rewrite_const(0) }
      else { if pipeline_ir_const_lookup_is(left, 1) == 1 { pipeline_ir_rewrite_copy(rhs) }
      else { if pipeline_ir_const_lookup_is(right, 1) == 1 { pipeline_ir_rewrite_copy(lhs) }
      else { pipeline_ir_rewrite_unchanged() } } } }
    }
    IrOr -> {
      if pipeline_ir_const_lookup_is(left, 0) == 1 { pipeline_ir_rewrite_copy(rhs) }
      else { if pipeline_ir_const_lookup_is(right, 0) == 1 { pipeline_ir_rewrite_copy(lhs) }
      else { pipeline_ir_rewrite_unchanged() } }
    }
    IrBand -> {
      if pipeline_ir_const_lookup_is(left, 0) == 1 { pipeline_ir_rewrite_const(0) }
      else { if pipeline_ir_const_lookup_is(right, 0) == 1 { pipeline_ir_rewrite_const(0) }
      else { if pipeline_ir_const_lookup_is(left, 0 - 1) == 1 { pipeline_ir_rewrite_copy(rhs) }
      else { if pipeline_ir_const_lookup_is(right, 0 - 1) == 1 { pipeline_ir_rewrite_copy(lhs) }
      else { if lhs == rhs { pipeline_ir_rewrite_copy(lhs) }
      else { pipeline_ir_rewrite_unchanged() } } } } }
    }
    IrBor -> {
      if pipeline_ir_const_lookup_is(left, 0) == 1 { pipeline_ir_rewrite_copy(rhs) }
      else { if pipeline_ir_const_lookup_is(right, 0) == 1 { pipeline_ir_rewrite_copy(lhs) }
      else { if lhs == rhs { pipeline_ir_rewrite_copy(lhs) }
      else { pipeline_ir_rewrite_unchanged() } } }
    }
    IrBxor -> {
      if lhs == rhs { pipeline_ir_rewrite_const(0) }
      else { if pipeline_ir_const_lookup_is(left, 0) == 1 { pipeline_ir_rewrite_copy(rhs) }
      else { if pipeline_ir_const_lookup_is(right, 0) == 1 { pipeline_ir_rewrite_copy(lhs) }
      else { pipeline_ir_rewrite_unchanged() } } }
    }
    IrBshl -> if pipeline_ir_const_lookup_is(right, 0) == 1 { pipeline_ir_rewrite_copy(lhs) } else { pipeline_ir_rewrite_unchanged() }
    IrBshr -> if pipeline_ir_const_lookup_is(right, 0) == 1 { pipeline_ir_rewrite_copy(lhs) } else { pipeline_ir_rewrite_unchanged() }
    _ -> pipeline_ir_rewrite_unchanged()
  }
}

fn pipeline_ir_semantic_facts_empty() -> PipelineIrSemanticFactList {
  PipelineIrSemanticFactNil
}

fn pipeline_ir_semantic_facts_prepend(hash: i64, fact: i64, rest: PipelineIrSemanticFactList) -> PipelineIrSemanticFactList {
  pipeline_ir_semantic_facts_prepend_with_borrow(hash, fact, ir_borrow_facts_empty(), rest)
}

fn pipeline_ir_semantic_facts_prepend_with_borrow(hash: i64, fact: i64, borrow: IrBorrowFacts, rest: PipelineIrSemanticFactList) -> PipelineIrSemanticFactList {
  match rest {
    PipelineIrSemanticFactNil -> PipelineIrSemanticFactNode(hash, fact, borrow, PipelineIrSemanticFactNil, PipelineIrSemanticFactNil)
    PipelineIrSemanticFactNode(node_hash, node_fact, node_borrow, left, right) -> {
      if hash == node_hash {
        PipelineIrSemanticFactNode(hash, fact, borrow, left, right)
      } else { if hash < node_hash {
        PipelineIrSemanticFactNode(node_hash, node_fact, node_borrow, pipeline_ir_semantic_facts_prepend_with_borrow(hash, fact, borrow, left), right)
      } else {
        PipelineIrSemanticFactNode(node_hash, node_fact, node_borrow, left, pipeline_ir_semantic_facts_prepend_with_borrow(hash, fact, borrow, right))
      } }
    }
  }
}

fn pipeline_ir_semantic_fact_find(facts: PipelineIrSemanticFactList, hash: i64) -> i64 {
  let mut cur = facts
  let mut result = 0
  let mut done = 0
  while done == 0 {
    match cur {
      PipelineIrSemanticFactNil -> { done = 1 }
      PipelineIrSemanticFactNode(fact_hash, fact, borrow, left, right) -> {
        if fact_hash == hash {
          result = fact
          done = 1
        } else {
          cur = if hash < fact_hash { left } else { right }
        }
      }
    }
  }
  result
}

fn pipeline_ir_semantic_borrow_fact_find(facts: PipelineIrSemanticFactList, hash: i64) -> IrBorrowFacts {
  let mut cur = facts
  let mut result = ir_borrow_facts_empty()
  let mut done = 0
  while done == 0 {
    match cur {
      PipelineIrSemanticFactNil -> { done = 1 }
      PipelineIrSemanticFactNode(fact_hash, fact, borrow, left, right) -> {
        if fact_hash == hash {
          result = borrow
          done = 1
        } else {
          cur = if hash < fact_hash { left } else { right }
        }
      }
    }
  }
  result
}

fn pipeline_ir_semantic_fact_lookup_pure(facts: PipelineIrSemanticFactList, hash: i64) -> i64 {
  let fact = pipeline_ir_semantic_fact_find(facts, hash)
  if fact == 0 { 0 } else { cg_semantic_fact_pure(fact) }
}

fn pipeline_ir_semantic_fact_lookup_pure_scalar_result(facts: PipelineIrSemanticFactList, hash: i64) -> i64 {
  let fact = pipeline_ir_semantic_fact_find(facts, hash)
  if fact == 0 { 0 } else {
    if cg_semantic_fact_pure(fact) == 1 and cg_semantic_fact_i64_return(fact) == 1 { 1 } else { 0 }
  }
}

-- Scalar-return fact WITHOUT the purity requirement. The multi-block
-- splice needs only the ABI shape: trusted raw-memory accessor bodies
-- are deliberately flagged effectful by the body-flag fixpoint (their
-- loads must not be CSE'd or reordered as pure), but SPLICING preserves
-- instruction order and count, so purity is not a soundness input —
-- the clone whitelist already rejects stores, performs, and handles.
fn pipeline_ir_semantic_fact_lookup_scalar_result(facts: PipelineIrSemanticFactList, hash: i64) -> i64 {
  let fact = pipeline_ir_semantic_fact_find(facts, hash)
  if fact == 0 { 0 } else {
    if cg_semantic_fact_i64_return(fact) == 1 { 1 } else { 0 }
  }
}

-- Word-call fact: every param and the return travel in word registers
-- (i64 scalars or managed pointers — return class 1 or 2 — and no
-- f32/f64 anywhere in the signature). This is the boundary condition
-- an IR-level splice needs; ownership is embedded in lowered bodies.
fn pipeline_ir_semantic_fact_lookup_word_call(facts: PipelineIrSemanticFactList, hash: i64) -> i64 {
  let fact = pipeline_ir_semantic_fact_find(facts, hash)
  if fact == 0 { 0 } else {
    let class = cg_semantic_fact_return_class(fact)
    if (class == 1 or class == 2) and cg_semantic_fact_word_abi(fact) == 1 { 1 } else { 0 }
  }
}

fn pipeline_ir_semantic_fact_lookup_managed_param_mask(facts: PipelineIrSemanticFactList, hash: i64) -> i64 {
  let mut cur = facts
  let mut result = 0
  let mut done = 0
  while done == 0 {
    match cur {
      PipelineIrSemanticFactNil -> { done = 1 }
      PipelineIrSemanticFactNode(fact_hash, fact, borrow, left, right) -> {
        if fact_hash == hash {
          result = cg_semantic_fact_managed_param_mask(fact)
          done = 1
        } else {
          cur = if hash < fact_hash { left } else { right }
        }
      }
    }
  }
  result
}

fn pipeline_ir_semantic_fact_lookup_raw_boundary(facts: PipelineIrSemanticFactList, hash: i64) -> i64 {
  let fact = pipeline_ir_semantic_fact_find(facts, hash)
  if fact == 0 { 1 } else {
    if cg_semantic_fact_has_alloc(fact) == 1 or cg_semantic_fact_has_unsafe(fact) == 1 { 1 } else { 0 }
  }
}

fn pipeline_ir_semantic_facts_effect_flag_map_acc(facts: PipelineIrSemanticFactList, acc: i64) -> i64 {
  match facts {
    PipelineIrSemanticFactNil -> acc
    PipelineIrSemanticFactNode(hash, fact, borrow, left, right) -> {
      pipeline_ir_semantic_facts_effect_flag_map_acc(left, pipeline_ir_effect_flag_map_prepend(hash, cg_semantic_fact_effect_flags(fact), pipeline_ir_semantic_facts_effect_flag_map_acc(right, acc)))
    }
  }
}

fn pipeline_ir_semantic_facts_effect_flag_map(facts: PipelineIrSemanticFactList) -> i64 {
  pipeline_ir_semantic_facts_effect_flag_map_acc(facts, 0)
}

fn pipeline_ir_block_entry_facts_empty() -> PipelineIrBlockEntryFactList {
  PipelineIrBlockEntryFactTreeNil
}

fn pipeline_ir_block_entry_facts_block_chain(facts: PipelineIrBlockEntryFactList, block_id: i64) -> PipelineIrBlockEntryFactChain {
  match facts {
    PipelineIrBlockEntryFactTreeNil -> PipelineIrBlockEntryFactNil
    PipelineIrBlockEntryFactBlock(node_block, chain, left, right) -> {
      if block_id == node_block { chain }
      else { if block_id < node_block {
        pipeline_ir_block_entry_facts_block_chain(left, block_id)
      } else {
        pipeline_ir_block_entry_facts_block_chain(right, block_id)
      } }
    }
  }
}

-- Path-copying insert/update: versions of the plane stay persistent,
-- which the branch-fact builder relies on (it holds several extensions
-- of the same base plane alive at once).
fn pipeline_ir_block_entry_facts_with_block_chain(facts: PipelineIrBlockEntryFactList, block_id: i64, chain: PipelineIrBlockEntryFactChain) -> PipelineIrBlockEntryFactList {
  match facts {
    PipelineIrBlockEntryFactTreeNil -> PipelineIrBlockEntryFactBlock(block_id, chain, PipelineIrBlockEntryFactTreeNil, PipelineIrBlockEntryFactTreeNil)
    PipelineIrBlockEntryFactBlock(node_block, node_chain, left, right) -> {
      if block_id == node_block {
        PipelineIrBlockEntryFactBlock(node_block, chain, left, right)
      } else { if block_id < node_block {
        PipelineIrBlockEntryFactBlock(node_block, node_chain, pipeline_ir_block_entry_facts_with_block_chain(left, block_id, chain), right)
      } else {
        PipelineIrBlockEntryFactBlock(node_block, node_chain, left, pipeline_ir_block_entry_facts_with_block_chain(right, block_id, chain))
      } }
    }
  }
}

fn pipeline_ir_scalar_fact_kind_bool() -> i64 { 1 }

fn pipeline_ir_scalar_fact_kind_zero() -> i64 { 2 }

fn pipeline_ir_scalar_fact_kind_nil() -> i64 { 3 }

fn pipeline_ir_scalar_fact_kind_nonnegative() -> i64 { 4 }

-- Shared upper-bound fact for indexed storage. The scalar fact's subject is
-- the index SSA value and its payload is a canonical indexed-length key.
fn pipeline_ir_scalar_fact_kind_indexed_upper() -> i64 { 5 }

-- Non-strict companion used by half-open slicing: subject <= keyed upper.
-- Keep it distinct from indexed_upper, because ordinary indexing still
-- requires subject < length and must never consume an equality proof.
fn pipeline_ir_scalar_fact_kind_indexed_upper_or_equal() -> i64 { 6 }

fn pipeline_ir_block_entry_facts_prepend_ctor(block_id: i64, value_id: i64, ctor_hash: i64, rest: PipelineIrBlockEntryFactList) -> PipelineIrBlockEntryFactList {
  pipeline_ir_block_entry_facts_with_block_chain(rest, block_id, PipelineIrBlockEntryCtorFact(block_id, value_id, ctor_hash, pipeline_ir_block_entry_facts_block_chain(rest, block_id)))
}

fn pipeline_ir_block_entry_facts_prepend_not_ctor(block_id: i64, value_id: i64, ctor_hash: i64, rest: PipelineIrBlockEntryFactList) -> PipelineIrBlockEntryFactList {
  pipeline_ir_block_entry_facts_with_block_chain(rest, block_id, PipelineIrBlockEntryNotCtorFact(block_id, value_id, ctor_hash, pipeline_ir_block_entry_facts_block_chain(rest, block_id)))
}

fn pipeline_ir_block_entry_facts_prepend_scalar(block_id: i64, value_id: i64, kind: i64, value: i64, rest: PipelineIrBlockEntryFactList) -> PipelineIrBlockEntryFactList {
  pipeline_ir_block_entry_facts_with_block_chain(rest, block_id, PipelineIrBlockEntryScalarFact(block_id, value_id, kind, value, pipeline_ir_block_entry_facts_block_chain(rest, block_id)))
}

fn pipeline_ir_block_entry_facts_prepend_slot_scalar(block_id: i64, slot_id: i64, kind: i64, value: i64, rest: PipelineIrBlockEntryFactList) -> PipelineIrBlockEntryFactList {
  pipeline_ir_block_entry_facts_with_block_chain(rest, block_id, PipelineIrBlockEntrySlotScalarFact(block_id, slot_id, kind, value, pipeline_ir_block_entry_facts_block_chain(rest, block_id)))
}

fn pipeline_ir_block_entry_facts_prepend_vector_len(block_id: i64, len_value: i64, vec_value: i64, rest: PipelineIrBlockEntryFactList) -> PipelineIrBlockEntryFactList {
  pipeline_ir_block_entry_facts_with_block_chain(rest, block_id, PipelineIrBlockEntryVectorLenFact(block_id, len_value, vec_value, pipeline_ir_block_entry_facts_block_chain(rest, block_id)))
}

fn pipeline_ir_block_entry_facts_prepend_vector_upper(block_id: i64, vec_value: i64, index_value: i64, rest: PipelineIrBlockEntryFactList) -> PipelineIrBlockEntryFactList {
  pipeline_ir_block_entry_facts_with_block_chain(rest, block_id, PipelineIrBlockEntryVectorUpperFact(block_id, vec_value, index_value, pipeline_ir_block_entry_facts_block_chain(rest, block_id)))
}

fn pipeline_ir_block_entry_facts_prepend_vector_slot_upper(block_id: i64, vec_value: i64, slot_id: i64, rest: PipelineIrBlockEntryFactList) -> PipelineIrBlockEntryFactList {
  pipeline_ir_block_entry_facts_with_block_chain(rest, block_id, PipelineIrBlockEntryVectorSlotUpperFact(block_id, vec_value, slot_id, pipeline_ir_block_entry_facts_block_chain(rest, block_id)))
}

fn pipeline_ir_block_entry_facts_prepend_bool(block_id: i64, value_id: i64, truth: i64, rest: PipelineIrBlockEntryFactList) -> PipelineIrBlockEntryFactList {
  pipeline_ir_block_entry_facts_prepend_scalar(block_id, value_id, pipeline_ir_scalar_fact_kind_bool(), truth, rest)
}

fn pipeline_ir_block_entry_facts_prepend_zero(block_id: i64, value_id: i64, is_zero: i64, rest: PipelineIrBlockEntryFactList) -> PipelineIrBlockEntryFactList {
  pipeline_ir_block_entry_facts_prepend_scalar(block_id, value_id, pipeline_ir_scalar_fact_kind_zero(), is_zero, rest)
}

fn pipeline_ir_block_entry_facts_prepend_nil(block_id: i64, value_id: i64, is_nil: i64, rest: PipelineIrBlockEntryFactList) -> PipelineIrBlockEntryFactList {
  pipeline_ir_block_entry_facts_prepend_scalar(block_id, value_id, pipeline_ir_scalar_fact_kind_nil(), is_nil, rest)
}

fn pipeline_ir_block_entry_facts_prepend_nonnegative(block_id: i64, value_id: i64, is_nonnegative: i64, rest: PipelineIrBlockEntryFactList) -> PipelineIrBlockEntryFactList {
  pipeline_ir_block_entry_facts_prepend_scalar(block_id, value_id, pipeline_ir_scalar_fact_kind_nonnegative(), is_nonnegative, rest)
}

fn pipeline_ir_block_entry_facts_prepend_indexed_upper(block_id: i64, index_value: i64, length_key: i64, rest: PipelineIrBlockEntryFactList) -> PipelineIrBlockEntryFactList {
  pipeline_ir_block_entry_facts_prepend_scalar(block_id, index_value, pipeline_ir_scalar_fact_kind_indexed_upper(), length_key, rest)
}

fn pipeline_ir_block_entry_facts_prepend_indexed_upper_or_equal(block_id: i64, lower_value: i64, upper_key: i64, rest: PipelineIrBlockEntryFactList) -> PipelineIrBlockEntryFactList {
  pipeline_ir_block_entry_facts_prepend_scalar(block_id, lower_value, pipeline_ir_scalar_fact_kind_indexed_upper_or_equal(), upper_key, rest)
}

fn pipeline_ir_block_entry_facts_prepend_variant_origin(block_id: i64, value_id: i64, ctor_hash: i64, payloads: IrValueList, rest: PipelineIrBlockEntryFactList) -> PipelineIrBlockEntryFactList {
  pipeline_ir_block_entry_facts_with_block_chain(rest, block_id, PipelineIrBlockEntryVariantOriginFact(block_id, value_id, ctor_hash, payloads, pipeline_ir_block_entry_facts_block_chain(rest, block_id)))
}

fn pipeline_ir_block_entry_facts_chain_count(facts: PipelineIrBlockEntryFactChain) -> i64 {
  match facts {
    PipelineIrBlockEntryFactNil -> 0
    PipelineIrBlockEntryCtorFact(block_id, value_id, ctor_hash, rest) -> 1 + pipeline_ir_block_entry_facts_chain_count(rest)
    PipelineIrBlockEntryNotCtorFact(block_id, value_id, ctor_hash, rest) -> 1 + pipeline_ir_block_entry_facts_chain_count(rest)
    PipelineIrBlockEntryScalarFact(block_id, value_id, kind, value, rest) -> 1 + pipeline_ir_block_entry_facts_chain_count(rest)
    PipelineIrBlockEntrySlotScalarFact(block_id, slot_id, kind, value, rest) -> 1 + pipeline_ir_block_entry_facts_chain_count(rest)
    PipelineIrBlockEntryVectorLenFact(block_id, len_value, vec_value, rest) -> 1 + pipeline_ir_block_entry_facts_chain_count(rest)
    PipelineIrBlockEntryVectorUpperFact(block_id, vec_value, index_value, rest) -> 1 + pipeline_ir_block_entry_facts_chain_count(rest)
    PipelineIrBlockEntryVectorSlotUpperFact(block_id, vec_value, slot_id, rest) -> 1 + pipeline_ir_block_entry_facts_chain_count(rest)
    PipelineIrBlockEntryVectorSlotRowUpperFact(block_id, vec_value, row_width, slot_id, rest) -> 1 + pipeline_ir_block_entry_facts_chain_count(rest)
    PipelineIrBlockEntryVectorRowUpperFact(block_id, vec_value, row_width, slot_id, rest) -> 1 + pipeline_ir_block_entry_facts_chain_count(rest)
    PipelineIrBlockEntryVariantOriginFact(block_id, value_id, ctor_hash, payloads, rest) -> 1 + pipeline_ir_block_entry_facts_chain_count(rest)
  }
}

fn pipeline_ir_block_entry_facts_count(facts: PipelineIrBlockEntryFactList) -> i64 {
  match facts {
    PipelineIrBlockEntryFactTreeNil -> 0
    PipelineIrBlockEntryFactBlock(block_id, chain, left, right) -> pipeline_ir_block_entry_facts_chain_count(chain) + pipeline_ir_block_entry_facts_count(left) + pipeline_ir_block_entry_facts_count(right)
  }
}

fn pipeline_ir_block_entry_ctor_fact_lookup_chain(facts: PipelineIrBlockEntryFactChain, block_id: i64, value_id: i64) -> PipelineIrConstLookup {
  match facts {
    PipelineIrBlockEntryFactNil -> pipeline_ir_const_lookup(0, 0)
    PipelineIrBlockEntryCtorFact(fact_block, fact_value, ctor_hash, rest) -> {
      if fact_block == block_id and fact_value == value_id {
        pipeline_ir_const_lookup(1, ctor_hash)
      } else {
        pipeline_ir_block_entry_ctor_fact_lookup_chain(rest, block_id, value_id)
      }
    }
    PipelineIrBlockEntryNotCtorFact(fact_block, fact_value, ctor_hash, rest) -> pipeline_ir_block_entry_ctor_fact_lookup_chain(rest, block_id, value_id)
    PipelineIrBlockEntryScalarFact(fact_block, fact_value, kind, value, rest) -> pipeline_ir_block_entry_ctor_fact_lookup_chain(rest, block_id, value_id)
    PipelineIrBlockEntrySlotScalarFact(fact_block, slot_id, kind, value, rest) -> pipeline_ir_block_entry_ctor_fact_lookup_chain(rest, block_id, value_id)
    PipelineIrBlockEntryVectorLenFact(fact_block, len_value, vec_value, rest) -> pipeline_ir_block_entry_ctor_fact_lookup_chain(rest, block_id, value_id)
    PipelineIrBlockEntryVectorUpperFact(fact_block, vec_value, index_value, rest) -> pipeline_ir_block_entry_ctor_fact_lookup_chain(rest, block_id, value_id)
    PipelineIrBlockEntryVectorSlotUpperFact(fact_block, vec_value, slot_id, rest) -> pipeline_ir_block_entry_ctor_fact_lookup_chain(rest, block_id, value_id)
    PipelineIrBlockEntryVectorSlotRowUpperFact(fact_block, vec_value, row_width, slot_id, rest) -> pipeline_ir_block_entry_ctor_fact_lookup_chain(rest, block_id, value_id)
    PipelineIrBlockEntryVectorRowUpperFact(fact_block, vec_value, row_width, slot_id, rest) -> pipeline_ir_block_entry_ctor_fact_lookup_chain(rest, block_id, value_id)
    PipelineIrBlockEntryVariantOriginFact(fact_block, fact_value, ctor_hash, payloads, rest) -> pipeline_ir_block_entry_ctor_fact_lookup_chain(rest, block_id, value_id)
  }
}

fn pipeline_ir_block_entry_ctor_fact_lookup(facts: PipelineIrBlockEntryFactList, block_id: i64, value_id: i64) -> PipelineIrConstLookup {
  pipeline_ir_block_entry_ctor_fact_lookup_chain(pipeline_ir_block_entry_facts_block_chain(facts, block_id), block_id, value_id)
}

fn pipeline_ir_block_entry_not_ctor_fact_lookup_chain(facts: PipelineIrBlockEntryFactChain, block_id: i64, value_id: i64, ctor_hash: i64) -> i64 {
  match facts {
    PipelineIrBlockEntryFactNil -> 0
    PipelineIrBlockEntryCtorFact(fact_block, fact_value, fact_hash, rest) -> pipeline_ir_block_entry_not_ctor_fact_lookup_chain(rest, block_id, value_id, ctor_hash)
    PipelineIrBlockEntryNotCtorFact(fact_block, fact_value, fact_hash, rest) -> {
      if fact_block == block_id and fact_value == value_id and fact_hash == ctor_hash {
        1
      } else {
        pipeline_ir_block_entry_not_ctor_fact_lookup_chain(rest, block_id, value_id, ctor_hash)
      }
    }
    PipelineIrBlockEntryScalarFact(fact_block, fact_value, kind, value, rest) -> pipeline_ir_block_entry_not_ctor_fact_lookup_chain(rest, block_id, value_id, ctor_hash)
    PipelineIrBlockEntrySlotScalarFact(fact_block, slot_id, kind, value, rest) -> pipeline_ir_block_entry_not_ctor_fact_lookup_chain(rest, block_id, value_id, ctor_hash)
    PipelineIrBlockEntryVectorLenFact(fact_block, len_value, vec_value, rest) -> pipeline_ir_block_entry_not_ctor_fact_lookup_chain(rest, block_id, value_id, ctor_hash)
    PipelineIrBlockEntryVectorUpperFact(fact_block, vec_value, index_value, rest) -> pipeline_ir_block_entry_not_ctor_fact_lookup_chain(rest, block_id, value_id, ctor_hash)
    PipelineIrBlockEntryVectorSlotUpperFact(fact_block, vec_value, slot_id, rest) -> pipeline_ir_block_entry_not_ctor_fact_lookup_chain(rest, block_id, value_id, ctor_hash)
    PipelineIrBlockEntryVectorSlotRowUpperFact(fact_block, vec_value, row_width, slot_id, rest) -> pipeline_ir_block_entry_not_ctor_fact_lookup_chain(rest, block_id, value_id, ctor_hash)
    PipelineIrBlockEntryVectorRowUpperFact(fact_block, vec_value, row_width, slot_id, rest) -> pipeline_ir_block_entry_not_ctor_fact_lookup_chain(rest, block_id, value_id, ctor_hash)
    PipelineIrBlockEntryVariantOriginFact(fact_block, fact_value, fact_hash, payloads, rest) -> pipeline_ir_block_entry_not_ctor_fact_lookup_chain(rest, block_id, value_id, ctor_hash)
  }
}

fn pipeline_ir_block_entry_not_ctor_fact_lookup(facts: PipelineIrBlockEntryFactList, block_id: i64, value_id: i64, ctor_hash: i64) -> i64 {
  pipeline_ir_block_entry_not_ctor_fact_lookup_chain(pipeline_ir_block_entry_facts_block_chain(facts, block_id), block_id, value_id, ctor_hash)
}

fn pipeline_ir_block_entry_scalar_fact_lookup_chain(facts: PipelineIrBlockEntryFactChain, block_id: i64, value_id: i64, kind: i64) -> PipelineIrConstLookup {
  match facts {
    PipelineIrBlockEntryFactNil -> pipeline_ir_const_lookup(0, 0)
    PipelineIrBlockEntryCtorFact(fact_block, fact_value, ctor_hash, rest) -> pipeline_ir_block_entry_scalar_fact_lookup_chain(rest, block_id, value_id, kind)
    PipelineIrBlockEntryNotCtorFact(fact_block, fact_value, ctor_hash, rest) -> pipeline_ir_block_entry_scalar_fact_lookup_chain(rest, block_id, value_id, kind)
    PipelineIrBlockEntryScalarFact(fact_block, fact_value, fact_kind, value, rest) -> {
      if fact_block == block_id and fact_value == value_id and fact_kind == kind {
        pipeline_ir_const_lookup(1, value)
      } else {
        pipeline_ir_block_entry_scalar_fact_lookup_chain(rest, block_id, value_id, kind)
      }
    }
    PipelineIrBlockEntrySlotScalarFact(fact_block, slot_id, fact_kind, value, rest) -> pipeline_ir_block_entry_scalar_fact_lookup_chain(rest, block_id, value_id, kind)
    PipelineIrBlockEntryVariantOriginFact(fact_block, fact_value, ctor_hash, payloads, rest) -> pipeline_ir_block_entry_scalar_fact_lookup_chain(rest, block_id, value_id, kind)
    PipelineIrBlockEntryVectorLenFact(fact_block, len_value, vec_value, rest) -> pipeline_ir_block_entry_scalar_fact_lookup_chain(rest, block_id, value_id, kind)
    PipelineIrBlockEntryVectorUpperFact(fact_block, vec_value, index_value, rest) -> pipeline_ir_block_entry_scalar_fact_lookup_chain(rest, block_id, value_id, kind)
    PipelineIrBlockEntryVectorSlotUpperFact(fact_block, vec_value, slot_id, rest) -> pipeline_ir_block_entry_scalar_fact_lookup_chain(rest, block_id, value_id, kind)
    PipelineIrBlockEntryVectorSlotRowUpperFact(fact_block, vec_value, row_width, slot_id, rest) -> pipeline_ir_block_entry_scalar_fact_lookup_chain(rest, block_id, value_id, kind)
    PipelineIrBlockEntryVectorRowUpperFact(fact_block, vec_value, row_width, slot_id, rest) -> pipeline_ir_block_entry_scalar_fact_lookup_chain(rest, block_id, value_id, kind)
  }
}

fn pipeline_ir_block_entry_scalar_fact_lookup(facts: PipelineIrBlockEntryFactList, block_id: i64, value_id: i64, kind: i64) -> PipelineIrConstLookup {
  pipeline_ir_block_entry_scalar_fact_lookup_chain(pipeline_ir_block_entry_facts_block_chain(facts, block_id), block_id, value_id, kind)
}

fn pipeline_ir_block_entry_slot_scalar_fact_lookup_chain(facts: PipelineIrBlockEntryFactChain, block_id: i64, slot_id: i64, kind: i64) -> PipelineIrConstLookup {
  match facts {
    PipelineIrBlockEntryFactNil -> pipeline_ir_const_lookup(0, 0)
    PipelineIrBlockEntryCtorFact(fact_block, fact_value, ctor_hash, rest) -> pipeline_ir_block_entry_slot_scalar_fact_lookup_chain(rest, block_id, slot_id, kind)
    PipelineIrBlockEntryNotCtorFact(fact_block, fact_value, ctor_hash, rest) -> pipeline_ir_block_entry_slot_scalar_fact_lookup_chain(rest, block_id, slot_id, kind)
    PipelineIrBlockEntryScalarFact(fact_block, fact_value, fact_kind, value, rest) -> pipeline_ir_block_entry_slot_scalar_fact_lookup_chain(rest, block_id, slot_id, kind)
    PipelineIrBlockEntrySlotScalarFact(fact_block, fact_slot, fact_kind, value, rest) -> {
      if fact_block == block_id and fact_slot == slot_id and fact_kind == kind {
        pipeline_ir_const_lookup(1, value)
      } else {
        pipeline_ir_block_entry_slot_scalar_fact_lookup_chain(rest, block_id, slot_id, kind)
      }
    }
    PipelineIrBlockEntryVectorLenFact(fact_block, len_value, vec_value, rest) -> pipeline_ir_block_entry_slot_scalar_fact_lookup_chain(rest, block_id, slot_id, kind)
    PipelineIrBlockEntryVectorUpperFact(fact_block, vec_value, index_value, rest) -> pipeline_ir_block_entry_slot_scalar_fact_lookup_chain(rest, block_id, slot_id, kind)
    PipelineIrBlockEntryVectorSlotUpperFact(fact_block, vec_value, fact_slot, rest) -> pipeline_ir_block_entry_slot_scalar_fact_lookup_chain(rest, block_id, slot_id, kind)
    PipelineIrBlockEntryVectorSlotRowUpperFact(fact_block, vec_value, row_width, fact_slot, rest) -> pipeline_ir_block_entry_slot_scalar_fact_lookup_chain(rest, block_id, slot_id, kind)
    PipelineIrBlockEntryVectorRowUpperFact(fact_block, vec_value, row_width, fact_slot, rest) -> pipeline_ir_block_entry_slot_scalar_fact_lookup_chain(rest, block_id, slot_id, kind)
    PipelineIrBlockEntryVariantOriginFact(fact_block, fact_value, ctor_hash, payloads, rest) -> pipeline_ir_block_entry_slot_scalar_fact_lookup_chain(rest, block_id, slot_id, kind)
  }
}

