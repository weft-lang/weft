pub(package) fn pipeline_ir_semantic_managed_return_fact_count_list(facts: PipelineIrSemanticFactList) -> i64 {
  match facts {
    PipelineIrSemanticFactNil -> 0
    PipelineIrSemanticFactNode(hash, fact, borrow, left, right) -> {
      let add = if cg_semantic_fact_managed_return(fact) == 1 { 1 } else { 0 }
      add + pipeline_ir_semantic_managed_return_fact_count_list(left) + pipeline_ir_semantic_managed_return_fact_count_list(right)
    }
  }
}

pub(package) fn pipeline_ir_semantic_managed_return_fact_count(ir: IrModule) -> i64 {
  pipeline_ir_semantic_managed_return_fact_count_list(pipeline_ir_semantic_facts(ir))
}

