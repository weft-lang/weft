fn pipeline_ir_match_final_arm_elision_sites(ir: IrModule) -> i64 {
  match ir {
    IrModule(functions) -> 0
    OptimisedIrModule(functions, inline_sites, residual_sites, evidence_candidate_sites, const_fold_sites, algebraic_fold_sites, dead_inst_sites, semantic_facts, pure_call_dce_sites, match_final_arm_elision_sites, block_entry_narrowing_sites, direct_call_inline_sites) -> match_final_arm_elision_sites
  }
}

fn pipeline_ir_block_entry_narrowing_sites(ir: IrModule) -> i64 {
  match ir {
    IrModule(functions) -> 0
    OptimisedIrModule(functions, inline_sites, residual_sites, evidence_candidate_sites, const_fold_sites, algebraic_fold_sites, dead_inst_sites, semantic_facts, pure_call_dce_sites, match_final_arm_elision_sites, block_entry_narrowing_sites, direct_call_inline_sites) -> block_entry_narrowing_sites
  }
}

