-- compiler/pipeline.weft -- Compiler pass boundaries
use "compiler/typeck.weft"
use "compiler/codegen.weft"
use "compiler/ir.weft"
use "compiler/grammar.weft"
use "compiler/macho.weft"
use "compiler/object.weft"
use "compiler/pipeline_match.weft"
use "compiler/binary_format.weft"
use "compiler/diagnose.weft"

-- Transitional compiler-as-data pass results. The payloads are still the
-- existing parser/checker/codegen handles while the public boundary moves
-- toward Ast -> TypedAst -> IrModule -> BinaryObject.
type AstModule {
  AstModule(i64, i64, i64)
}

type TypedModule {
  TypedModule(i64, i64, i64)
}

type IrModule {
  IrModule(IrFunctionList),
  OptimisedIrModule(IrFunctionList, i64, i64, i64, i64, i64, i64, PipelineIrSemanticFactList, i64, i64)
}

type NativeModule {
  NativeModule(i64, i64, IrFunctionList)
}

type BinaryObject {
  BinaryObject(i64, i64)
}

type PipelineLowerModule {
  PipelineLowerModule(i64, i64)
}

type PipelineValueEnv {
  PipelineValueEnvNil,
  PipelineValueEnvCons(i64, i64, i64, i64, PipelineValueEnv)
}

type PipelineLoweredArgs {
  PipelineLoweredArgs(IrValueList, i64, IrInstList, i64)
}

type PipelineLoweredRecordFields {
  PipelineLoweredRecordFields(IrRecordFieldList, i64, IrInstList, i64)
}

type PipelineLoweredRecordFieldBlocks {
  PipelineLoweredRecordFieldBlocks(IrRecordFieldList, i64, i64, IrBlockList, i64, i64)
}

type PipelineLoweredBlocks {
  PipelineLoweredBlocks(i64, i64, IrBlockList, i64, i64)
}

type PipelineLoweredCallBlocks {
  PipelineLoweredCallBlocks(IrValueList, i64, i64, IrBlockList, i64, i64)
}

type PipelineLoweredLoopBlocks {
  PipelineLoweredLoopBlocks(i64, i64, IrBlockList, i64, i64, i64)
}

type PipelineCallArgCtx {
  PipelineCallArgCtx(i64, i64, i64, PipelineValueEnv, i64, i64, i64)
}

type PipelineMethodArgCtx {
  PipelineMethodArgCtx(i64, i64, IrInstList, i64, PipelineValueEnv, i64, i64, i64)
}

type PipelineRecordFieldCtx {
  PipelineRecordFieldCtx(i64, i64, i64, PipelineValueEnv, i64, i64, i64)
}

type PipelineLoopCtx {
  PipelineLoopCtx(i64, PipelineValueEnv, i64, i64, i64, i64, i64, i64)
}

type PipelineForIterCtx {
  PipelineForIterCtx(i64, i64, PipelineValueEnv, PipelineLowerModule, i64)
}

type PipelineMatchCtx {
  PipelineMatchCtx(i64, i64, i64, i64, PipelineValueEnv, PipelineLowerModule, i64)
}

type PipelineHandlerInlineStats {
  PipelineHandlerInlineStats(i64, i64)
}

type PipelineIrConstEnv {
  PipelineIrConstEnvNil,
  PipelineIrConstEnvCons(i64, i64, i64, PipelineIrConstEnv)
}

type PipelineIrConstLookup {
  PipelineIrConstLookup(i64, i64)
}

type PipelineIrAliasEnv {
  PipelineIrAliasEnvNil,
  PipelineIrAliasEnvCons(i64, i64, PipelineIrAliasEnv)
}

type PipelineIrRewrite {
  PipelineIrRewriteUnchanged,
  PipelineIrRewriteConst(i64),
  PipelineIrRewriteCopy(i64),
  PipelineIrRewriteInsts(IrInstList, i64)
}

type PipelineIrSemanticFactList {
  PipelineIrSemanticFactNil,
  PipelineIrSemanticFactCons(i64, i64, PipelineIrSemanticFactList)
}

type PipelineIrCallCseEnv {
  PipelineIrCallCseEnvNil,
  PipelineIrCallCseEnvCons(i64, IrValueList, i64, PipelineIrCallCseEnv)
}

type PipelineOptimisedInsts {
  PipelineOptimisedInsts(IrInstList, PipelineIrConstEnv, PipelineIrAliasEnv, PipelineIrCallCseEnv, i64, i64, i64)
}

type PipelineIrLiveSet {
  PipelineIrLiveSetNil,
  PipelineIrLiveSetCons(i64, PipelineIrLiveSet)
}

type PipelineDceInsts {
  PipelineDceInsts(IrInstList, PipelineIrLiveSet, i64, i64)
}

type PipelineOptimisedBlocks {
  PipelineOptimisedBlocks(IrBlockList, i64, i64, i64, i64, i64)
}

type PipelineOptimisedFunctions {
  PipelineOptimisedFunctions(IrFunctionList, i64, i64, i64, i64)
}

type PipelineHandlerInlineCtx {
  PipelineHandlerInlineCtxNil,
  PipelineHandlerInlineCtxCons(i64, HandlerClauseList, i64, PipelineHandlerInlineCtx)
}

type PipelineHandlerInlineMatch {
  PipelineHandlerInlineNoMatch,
  PipelineHandlerInlineMatched(i64, i64)
}

type PipelineHandlerLowerCtx {
  PipelineHandlerLowerCtx(i64, PipelineValueEnv, i64, i64, PipelineHandlerInlineCtx)
}

type PipelineNativeHandlerCtx {
  PipelineNativeHandlerCtxNil,
  PipelineNativeHandlerCtxCons(HandlerClauseList, i64, i64, i64, i64, PipelineNativeHandlerCtx)
}

type PipelineNativeEmitCtx {
  PipelineNativeEmitCtx(i64, PipelineNativeHandlerCtx)
}

type PipelineCgExprCtx {
  PipelineCgExprCtx(i64, i64, i64, i64, i64)
}

impl TypedGrammar for WeftGrammar {
  fn check(self: i64, fns: i64, src: i64, tt: i64) -[Diagnose]> i64 {
    let ct = build_ctable(tt, src)
    ttable_set_ct(tt, ct)
    handle check_user_fns(fns, src, tt) {
      Conformance.conforms(th, trh) -> resume(ctable_conforms(ct, th, trh))
    }
  }
}

fn pipeline_parse(grammar: WeftGrammar, src: i64, n: i64, tt: i64) -> i64 {
  handle grammar.parse(src, n, tt) {
    Diagnose.error(msg, span) -> { diagnose_render(src, msg, span) resume(0) }
    Diagnose.warn(msg, span) -> { diagnose_render(src, msg, span) resume(0) }
    Diagnose.note(msg, span) -> { diagnose_render(src, msg, span) resume(0) }
  }
}

fn pipeline_check(grammar: WeftGrammar, fns: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  grammar.check(fns, src, tt)
}

fn pipeline_parse_module(grammar: WeftGrammar, src: i64, n: i64, tt: i64) -> AstModule {
  let fns = pipeline_parse(grammar, src, n, tt)
  AstModule(fns, src, tt)
}

fn pipeline_check_fns_with_diagnostics(fns: i64, src: i64, tt: i64) -[Diagnose]> TypedModule {
  let grammar = weft_grammar()
  pipeline_check(grammar, fns, src, tt)
  TypedModule(fns, src, tt)
}

fn pipeline_check_fns(fns: i64, src: i64, tt: i64) -> TypedModule {
  handle pipeline_check_fns_with_diagnostics(fns, src, tt) {
    Diagnose.error(msg, span) -> { diagnose_render(src, msg, span) resume(0) }
    Diagnose.warn(msg, span) -> { diagnose_render(src, msg, span) resume(0) }
    Diagnose.note(msg, span) -> { diagnose_render(src, msg, span) resume(0) }
  }
}

fn pipeline_check_module(ast: AstModule) -> TypedModule {
  match ast {
    AstModule(fns, src, tt) -> pipeline_check_fns(fns, src, tt)
  }
}

fn pipeline_ast_fns(ast: AstModule) -> i64 {
  match ast {
    AstModule(fns, src, tt) -> fns
  }
}

fn pipeline_typed_fns(typed: TypedModule) -> i64 {
  match typed {
    TypedModule(fns, src, tt) -> fns
  }
}

fn pipeline_ir_empty() -> IrModule {
  IrModule(ir_function_list_empty())
}

fn pipeline_ir_module(functions: IrFunctionList) -> IrModule {
  IrModule(functions)
}

fn pipeline_ir_functions(ir: IrModule) -> IrFunctionList {
  match ir {
    IrModule(functions) -> functions
    OptimisedIrModule(functions, inline_sites, residual_sites, evidence_candidate_sites, const_fold_sites, algebraic_fold_sites, dead_inst_sites, semantic_facts, pure_call_dce_sites, match_final_arm_elision_sites) -> functions
  }
}

fn pipeline_ir_is_optimised(ir: IrModule) -> i64 {
  match ir {
    IrModule(functions) -> 0
    OptimisedIrModule(functions, inline_sites, residual_sites, evidence_candidate_sites, const_fold_sites, algebraic_fold_sites, dead_inst_sites, semantic_facts, pure_call_dce_sites, match_final_arm_elision_sites) -> 1
  }
}

