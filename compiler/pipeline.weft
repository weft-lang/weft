-- public size-hint protocol or collapsing unknown bounds into sentinels.
pub(package) type PipelineIrTraversalCardinality {
  PipelineIrTraversalCardinalityUnknown,
  PipelineIrTraversalCardinalityRangeArguments(i64, i64),
  PipelineIrTraversalCardinalityExactZero,
  PipelineIrTraversalCardinalityExactOne,
  PipelineIrTraversalCardinalityPreservesInput,
  PipelineIrTraversalCardinalityAtMostInput,
  PipelineIrTraversalCardinalityFlatMapInput,
  PipelineIrTraversalCardinalityCapByArgument(i64),
  PipelineIrTraversalCardinalitySkipByArgument(i64),
  PipelineIrTraversalCardinalitySumInputs,
  PipelineIrTraversalCardinalityMinInputs,
  PipelineIrTraversalCardinalityNoIteratorResult
}

pub(package) type PipelineIrTraversalOrder {
  PipelineIrTraversalOrderUnknown,
  PipelineIrTraversalOrderSource,
  PipelineIrTraversalOrderNestedSource,
  PipelineIrTraversalOrderLeftThenRight,
  PipelineIrTraversalOrderPairByPosition,
  PipelineIrTraversalOrderStablePartition,
  PipelineIrTraversalOrderChunkedSource(i64),
  PipelineIrTraversalOrderWindowedSource(i64)
}

-- Materializing consumers expose their boundedness separately from pull and
-- cardinality. The argument index is declaration-owned provenance for later
-- allocation/fusion consumers, not a rescanned call convention.
pub(package) type PipelineIrTraversalBuffering {
  PipelineIrTraversalBufferingUnknown,
  PipelineIrTraversalBufferingGrowingOutputs(i64),
  PipelineIrTraversalBufferingBoundedByArgument(i64),
  PipelineIrTraversalBufferingRollingWindow(i64)
}

pub(package) type PipelineIrTraversalPull {
  PipelineIrTraversalPullUnknown,
  PipelineIrTraversalPullLazy,
  PipelineIrTraversalPullLazyMayExpandInput,
  PipelineIrTraversalPullLazyMayStopSource,
  PipelineIrTraversalPullConsumerExhausts,
  PipelineIrTraversalPullConsumerMayStopEarly
}

pub(package) type PipelineIrTraversalCallback {
  PipelineIrTraversalCallbackNone,
  PipelineIrTraversalCallbackPure(i64),
  PipelineIrTraversalCallbackEffectful(i64),
  PipelineIrTraversalCallbackEffectfulScopedView(i64),
  PipelineIrTraversalCallbackPure3(i64, i64, i64)
}

-- Cardinality expressions retain the SSA values that determine a traversal's
-- size. They are compiler data, not an iterator method or runtime sentinel.
-- Arithmetic remains symbolic when an exact count does not fit in an i64;
-- scalar consumers must decline evaluation rather than turn saturation into
-- a false upper bound.
pub(package) type PipelineIrTraversalExtent {
  PipelineIrTraversalCountUnknown,
  PipelineIrTraversalCountZero,
  PipelineIrTraversalCountOne,
  PipelineIrTraversalCountArgument(i64),
  PipelineIrTraversalCountRange(i64, i64),
  PipelineIrTraversalCountMin(PipelineIrTraversalExtent, PipelineIrTraversalExtent),
  PipelineIrTraversalCountSum(PipelineIrTraversalExtent, PipelineIrTraversalExtent),
  PipelineIrTraversalCountSaturatingSubtract(PipelineIrTraversalExtent, PipelineIrTraversalExtent)
}

pub(package) type PipelineIrTraversalBounds {
  PipelineIrTraversalBounds(PipelineIrTraversalExtent, PipelineIrTraversalExtent)
}

-- Collection builders consume a semantic allocation decision rather than
-- reproducing adapter names. Exact zero is retained as an exact plan: a later
-- lowering may erase the allocation altogether rather than merely reserve 0.
pub(package) type PipelineIrTraversalAllocation {
  PipelineIrTraversalAllocationNone,
  PipelineIrTraversalAllocationReserveLower(PipelineIrTraversalExtent),
  PipelineIrTraversalAllocationExact(PipelineIrTraversalExtent)
}

pub(package) type PipelineIrBorrowEnv {
  PipelineIrBorrowEnvNil,
  PipelineIrBorrowEnvCons(i64, i64, IrBorrowSummary, PipelineIrBorrowEnv)
}

-- Local aggregate provenance is keyed by the aggregate SSA value and physical
-- word offset. It lets a slice stored in a record/variant retain the original
-- owner when projected again without pretending the aggregate owns its data.
pub(package) type PipelineIrBorrowAggregateFactList {
  PipelineIrBorrowAggregateFactNil,
  PipelineIrBorrowAggregateFactCons(i64, i64, IrBorrowOriginList, PipelineIrBorrowAggregateFactList)
}

-- Monotone per-function dataflow state: SSA origins, slot origins, aggregate
-- field origins, and a changed bit for CFG/fixpoint propagation.
pub(package) type PipelineIrBorrowValuePass {
  PipelineIrBorrowValuePass(IrBorrowValueFactList, IrBorrowValueFactList, PipelineIrBorrowAggregateFactList, i64)
}

-- A fixed-depth hash trie keeps function lookup logarithmic regardless of
-- declaration/hash order. The ordinary candidate BST is optimised for its
-- small eligible subset; building it over every compiler function can become
-- a degenerate persistent chain during self-compilation.
pub(package) type PipelineIrBorrowFunctionIndex {
  PipelineIrBorrowFunctionIndexNil,
  PipelineIrBorrowFunctionIndexBranch(PipelineIrBorrowFunctionIndex, PipelineIrBorrowFunctionIndex),
  PipelineIrBorrowFunctionIndexLeaf(i64, IrFunction, PipelineIrBorrowFunctionIndex)
}

pub(package) type PipelineIrBorrowBlockParamIndex {
  PipelineIrBorrowBlockParamIndexNil,
  PipelineIrBorrowBlockParamIndexBranch(PipelineIrBorrowBlockParamIndex, PipelineIrBorrowBlockParamIndex),
  PipelineIrBorrowBlockParamIndexLeaf(i64, IrValueList, PipelineIrBorrowBlockParamIndex)
}

pub(package) type PipelineGenericSpecClosureState {
  PipelineGenericSpecClosureState(IrFunctionList, IrFunctionList)
}

-- Post-closure callback-identity specialisation result. requests is a
-- scratch nlist of [base spec hash, clone hash, recipe] entries retained
-- long enough to copy the base spec's semantic fact onto each clone.
pub(package) type PipelineIrIdentitySpecialisations {
  PipelineIrIdentitySpecialisations(IrFunctionList, i64)
}

-- Fact-selected consuming same-layout specialisations. Requests are scratch
-- nodes [base hash, clone hash, physical argument lane, cleanup kind]. Only
-- requests whose canonical body exposes one provable fresh allocation root
-- become clones; callers are rewritten against that validated function list.
pub(package) type PipelineIrConsumingSpecialisations {
  PipelineIrConsumingSpecialisations(IrFunctionList, PipelineIrSemanticFactList, i64)
}

pub(package) type PipelineIrConsumingCloneResult {
  PipelineIrConsumingCloneOk(IrInstList, i64),
  PipelineIrConsumingCloneInvalid
}

pub(package) type PipelineIrConsumingBlockResult {
  PipelineIrConsumingBlocksOk(IrBlockList, i64),
  PipelineIrConsumingBlocksInvalid
}

pub(package) type PipelineIrIdentityInstRewrite {
  PipelineIrIdentityInstRewrite(IrInstList, i64)
}

pub(package) type PipelineIrIdentityBlockRewrite {
  PipelineIrIdentityBlockRewrite(IrBlockList, i64)
}

-- Block-major fact plane: the outer list is a BST keyed by block id,
-- each node holding that block's fact chain. Lookups descend to the
-- block then walk its (short) chain instead of the whole plane.
pub(package) type PipelineIrBlockEntryFactList {
  PipelineIrBlockEntryFactTreeNil,
  PipelineIrBlockEntryFactBlock(i64, PipelineIrBlockEntryFactChain, PipelineIrBlockEntryFactList, PipelineIrBlockEntryFactList)
}

pub(package) type PipelineIrBlockEntryFactChain {
  PipelineIrBlockEntryFactNil,
  PipelineIrBlockEntryCtorFact(i64, i64, i64, PipelineIrBlockEntryFactChain),
  PipelineIrBlockEntryNotCtorFact(i64, i64, i64, PipelineIrBlockEntryFactChain),
  PipelineIrBlockEntryScalarFact(i64, i64, i64, i64, PipelineIrBlockEntryFactChain),
  PipelineIrBlockEntrySlotScalarFact(i64, i64, i64, i64, PipelineIrBlockEntryFactChain),
  PipelineIrBlockEntryVectorLenFact(i64, i64, i64, PipelineIrBlockEntryFactChain),
  PipelineIrBlockEntryVectorUpperFact(i64, i64, i64, PipelineIrBlockEntryFactChain),
  PipelineIrBlockEntryVectorSlotUpperFact(i64, i64, i64, PipelineIrBlockEntryFactChain),
  PipelineIrBlockEntryVectorSlotRowUpperFact(i64, i64, i64, i64, PipelineIrBlockEntryFactChain),
  PipelineIrBlockEntryVectorRowUpperFact(i64, i64, i64, i64, PipelineIrBlockEntryFactChain),
  PipelineIrBlockEntryVariantOriginFact(i64, i64, i64, IrValueList, PipelineIrBlockEntryFactChain)
}

pub(package) type PipelineIrBlockEntryFactAddResult {
  PipelineIrBlockEntryFactAddResult(PipelineIrBlockEntryFactList, i64)
}

