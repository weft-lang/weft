  PipelineIrTraversalFromGenerator,
  PipelineIrTraversalRangeI64,
  PipelineIrTraversalEmpty,
  PipelineIrTraversalOnce,
  PipelineIrTraversalMap,
  PipelineIrTraversalFilter,
  PipelineIrTraversalFilterMap,
  PipelineIrTraversalFlatMap,
  PipelineIrTraversalFlatten,
  PipelineIrTraversalTake,
  PipelineIrTraversalChain,
  PipelineIrTraversalSkip,
  PipelineIrTraversalTakeWhile,
  PipelineIrTraversalSkipWhile,
  PipelineIrTraversalEnumerate,
  PipelineIrTraversalZip,
  PipelineIrTraversalScan,
  PipelineIrTraversalFold,
  PipelineIrTraversalCount,
  PipelineIrTraversalFirst,
  PipelineIrTraversalLast,
  PipelineIrTraversalNth,
  PipelineIrTraversalPosition,
  PipelineIrTraversalMin,
  PipelineIrTraversalMax,
  PipelineIrTraversalFind,
  PipelineIrTraversalFindMap,
  PipelineIrTraversalAny,
  PipelineIrTraversalAll,
  PipelineIrTraversalReduce,
  PipelineIrTraversalPartition,
  PipelineIrTraversalEachChunk,
  PipelineIrTraversalEachWindow,
  PipelineIrTraversalEach,
  PipelineIrTraversalRangeMapFilterTakeFoldI64
}

