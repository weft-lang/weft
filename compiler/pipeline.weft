  else { if kind == 30 { 1 }
  else { if kind == 31 { 1 }
  else { if kind == 32 { 1 }
  else { if kind == 33 { 1 }
  else { if kind == 34 { 7 } else { 0 - 1 } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } }
}

pub(package) fn pipeline_ir_native_intrinsic_supported(callee_hash: i64, args: IrValueList) -> i64 {
  let kind = pipeline_ir_native_intrinsic_kind(callee_hash)
  if kind == 0 { 0 }
  else { if ir_value_list_len(args) == pipeline_ir_native_intrinsic_arity(kind) { 1 } else { 0 } }
}

pub(package) fn pipeline_ir_native_call_supported(callee_hash: i64, args: IrValueList, fm: i64, facts: PipelineIrSemanticFactList) -> i64 {
  if pipeline_ir_native_intrinsic_supported(callee_hash, args) == 1 {
    1
  } else {
    if fmap_contains_hash(fm, callee_hash) == 1 {
      1
    } else {
      if mono_cache_lookup(fmap_mono_cache(fm), callee_hash) > 0 { 1 } else { 0 }
    }
  }
}

pub(package) fn pipeline_ir_native_generic_call_supported(callee_hash: i64, type_args: TypeExprList, fm: i64) -> i64 {
  let spec_hash = mono_spec_hash(callee_hash, type_expr_list_to_nodes(type_args))
  if mono_cache_lookup(fmap_mono_cache(fm), spec_hash) != 0 { 1 } else { 0 }
}

pub(package) fn pipeline_ir_native_binary_op_supported(op: IrBinaryOp) -> i64 {
  ir_binary_op_is_supported(op)
}

pub(package) fn pipeline_fmap_hash_owner_count(fm: i64, target_hash: i64) -> i64 {
  let n = mem_load64_at(fm + 8, 0)
  let d = mem_load64_at(fm, 0)
  let mut i = 0
  let mut count = 0
  while i < n {
    let e_ns = mem_load64_at(d + i * 40, 0)
    let e_nl = mem_load64_at(d + i * 40 + 8, 0)
    let e_src = mem_load64_at(d + i * 40 + 24, 0)
    if str_hash(e_src, e_ns, e_nl) == target_hash {
      count = count + 1
    } else { 0 }
    i = i + 1
  }
  count
}

pub(package) fn pipeline_ir_native_block_param_count_or(blocks: IrBlockList, target: i64, default: i64) -> i64 {
  match blocks {
    IrBlockListNil -> default
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          if id == target {
            ir_value_list_len(params)
          } else {
            pipeline_ir_native_block_param_count_or(rest, target, default)
          }
        }
      }
    }
  }
}

pub(package) fn pipeline_ir_native_first_block_param_term_detail(term: IrTerminator, all_blocks: IrBlockList) -> i64 {
  match term {
    IrTermJump(target, args) -> {
      let target_params = pipeline_ir_native_block_param_count_or(all_blocks, target, 0 - 1)
      let arg_count = ir_value_list_len(args)
      if target_params < 0 or arg_count != target_params {
        node_new(0, 2, target, arg_count, target_params)
      } else {
        0
      }
    }
    IrTermBranch(cond, then_block, else_block) -> {
      let then_params = pipeline_ir_native_block_param_count_or(all_blocks, then_block, 0 - 1)
      let else_params = pipeline_ir_native_block_param_count_or(all_blocks, else_block, 0 - 1)
      if then_params < 0 or else_params < 0 or then_params != 0 or else_params != 0 {
        node_new(0, 3, then_block, then_params, else_params)
      } else {
        0
      }
    }
    _ -> 0
  }
}

pub(package) fn pipeline_ir_native_first_block_param_term_detail_blocks(blocks: IrBlockList, all_blocks: IrBlockList) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          let detail = pipeline_ir_native_first_block_param_term_detail(term, all_blocks)
          if detail != 0 {
            detail
          } else {
            pipeline_ir_native_first_block_param_term_detail_blocks(rest, all_blocks)
          }
        }
      }
    }
  }
}

pub(package) fn pipeline_ir_native_block_params_or(blocks: IrBlockList, target: i64, default: IrValueList) -> IrValueList {
  match blocks {
    IrBlockListNil -> default
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          if id == target {
            params
          } else {
            pipeline_ir_native_block_params_or(rest, target, default)
          }
        }
      }
    }
  }
}

pub(package) fn pipeline_expr_list_has_continuation_handler_typed(exprs: ExprList) -> bool {
  match exprs {
    ExprListNil -> false
    ExprListCons(expr, rest) -> {
      if pipeline_expr_has_continuation_handler_typed(expr) == 1 {
        true
      } else {
        pipeline_expr_list_has_continuation_handler_typed(rest)
      }
    }
  }
}

pub(package) fn pipeline_record_fields_have_continuation_handler_typed(fields: RecordFieldList) -> bool {
  match fields {
    RecordFieldListNil -> false
    RecordFieldListCons(field, rest) -> {
      let found = match field {
        RecordField(ns, nl, value, fact) -> pipeline_expr_has_continuation_handler_typed(value)
        UnknownRecordField(tag) -> false
      }
      if found == 1 { true } else { pipeline_record_fields_have_continuation_handler_typed(rest) }
    }
  }
}

pub(package) fn pipeline_match_arms_have_continuation_handler_typed(arms: MatchArmList) -> bool {
  match arms {
    MatchArmListNil -> false
    MatchArmListCons(arm, rest) -> {
      let found = match arm {
        Arm(pattern, body, guard, has_guard) -> {
          if has_guard == 1 {
            pipeline_expr_has_continuation_handler_typed(guard) or pipeline_expr_has_continuation_handler_typed(body)
          } else {
            pipeline_expr_has_continuation_handler_typed(body)
          }
        }
        UnknownArm(tag) -> false
      }
      if found == 1 { true } else { pipeline_match_arms_have_continuation_handler_typed(rest) }
    }
  }
}

pub(package) fn pipeline_handler_clause_list_has_continuation_handler_typed(clauses: HandlerClauseList) -> bool {
  match clauses {
    HandlerClauseListNil -> false
    HandlerClauseListCons(clause, rest) -> {
      let found = if handler_clause_has_continuation(clause) == 1 {
        1
      } else {
        pipeline_expr_has_continuation_handler_typed(handler_clause_body_expr(clause))
      }
      if found == 1 { true } else { pipeline_handler_clause_list_has_continuation_handler_typed(rest) }
    }
  }
}

pub(package) fn pipeline_expr_has_continuation_handler_typed(expr: Expr) -> bool {
  match expr {
    BinOp(op, lhs, rhs) -> pipeline_expr_has_continuation_handler_typed(lhs) or pipeline_expr_has_continuation_handler_typed(rhs)
    Call(ns, nl, args) -> pipeline_expr_list_has_continuation_handler_typed(args)
    GenericCall(type_args, inner_call) -> pipeline_expr_has_continuation_handler_typed(inner_call)
    If(cond, then_expr, else_expr) -> pipeline_expr_has_continuation_handler_typed(cond) or pipeline_expr_has_continuation_handler_typed(then_expr) or pipeline_expr_has_continuation_handler_typed(else_expr)
    While(cond, body) -> pipeline_expr_has_continuation_handler_typed(cond) or pipeline_expr_has_continuation_handler_typed(body)
    Loop(body) -> pipeline_expr_has_continuation_handler_typed(body)
    Break(value) -> pipeline_expr_has_continuation_handler_typed(value)
    Return(value) -> pipeline_expr_has_continuation_handler_typed(value)
    Defer(cleanup, body, source_site) -> pipeline_expr_has_continuation_handler_typed(cleanup) or pipeline_expr_has_continuation_handler_typed(body)
    Let(ns, nl, value, body) -> pipeline_expr_has_continuation_handler_typed(value) or pipeline_expr_has_continuation_handler_typed(body)
    LetMut(ns, nl, value, body) -> pipeline_expr_has_continuation_handler_typed(value) or pipeline_expr_has_continuation_handler_typed(body)
    Assign(ns, nl, value) -> pipeline_expr_has_continuation_handler_typed(value)
    AddressOf(mutable, target) -> pipeline_expr_has_continuation_handler_typed(target)
    Deref(ptr) -> pipeline_expr_has_continuation_handler_typed(ptr)
    PtrAssign(ptr, value) -> pipeline_expr_has_continuation_handler_typed(ptr) or pipeline_expr_has_continuation_handler_typed(value)
    Block(first, rest) -> pipeline_expr_has_continuation_handler_typed(first) or pipeline_expr_has_continuation_handler_typed(rest)
    FieldAccess(base, field_ns, field_nl, fact) -> pipeline_expr_has_continuation_handler_typed(base)
    IndexedLen(base, fixed_len) -> pipeline_expr_has_continuation_handler_typed(base)
    IndexedGet(base, index, element_ty, fixed_len) -> pipeline_expr_has_continuation_handler_typed(base) or pipeline_expr_has_continuation_handler_typed(index)
    IndexedSet(base, index, value, fact) -> pipeline_expr_has_continuation_handler_typed(base) or pipeline_expr_has_continuation_handler_typed(index) or pipeline_expr_has_continuation_handler_typed(value)
    IndexedSlice(base, start, end, fact) -> pipeline_expr_has_continuation_handler_typed(base) or pipeline_expr_has_continuation_handler_typed(start) or pipeline_expr_has_continuation_handler_typed(end)
    RecordInit(type_ns, type_nl, fields) -> pipeline_record_fields_have_continuation_handler_typed(fields)
    RecordUpdate(base, fields, fact) -> pipeline_expr_has_continuation_handler_typed(base) or pipeline_record_fields_have_continuation_handler_typed(fields)
    ArrayLiteral(elements, resolved_ty, span) -> pipeline_expr_list_has_continuation_handler_typed(elements)
    Match(scrutinee, arms) -> pipeline_expr_has_continuation_handler_typed(scrutinee) or pipeline_match_arms_have_continuation_handler_typed(arms)
    Not(operand) -> pipeline_expr_has_continuation_handler_typed(operand)
    Lambda(params, body, source_site) -> pipeline_expr_has_continuation_handler_typed(body)
    Perform(lhs, op_ns, op_nl, args) -> pipeline_expr_has_continuation_handler_typed(lhs) or pipeline_expr_list_has_continuation_handler_typed(args)
    Handle(body, clauses, hret) -> pipeline_expr_has_continuation_handler_typed(body) or pipeline_handler_clause_list_has_continuation_handler_typed(clauses) or (match hret { NoHandleReturn -> false HandleReturnClause(rns, rnl, rb) -> pipeline_expr_has_continuation_handler_typed(rb) })
    WithHandler(config, body, fact, source_site) -> pipeline_expr_list_has_continuation_handler_typed(handler_configuration_args(config)) or pipeline_expr_has_continuation_handler_typed(body) or pipeline_handler_clause_list_has_continuation_handler_typed(pipeline_handler_install_clauses(fact))
    Resume(value) -> pipeline_expr_has_continuation_handler_typed(value)
    MethodCall(recv, method_hash, args, type_hash) -> pipeline_expr_has_continuation_handler_typed(recv) or pipeline_expr_list_has_continuation_handler_typed(args)
    Try(inner, effect_atom) -> pipeline_expr_has_continuation_handler_typed(inner)
    InterpConcat(left, right) -> pipeline_expr_has_continuation_handler_typed(left) or pipeline_expr_has_continuation_handler_typed(right)
    ForIter(var_ns, var_nl, collection, body) -> pipeline_expr_has_continuation_handler_typed(collection) or pipeline_expr_has_continuation_handler_typed(body)
    OptChain(base, field_ns, field_nl, effect_atom) -> pipeline_expr_has_continuation_handler_typed(base)
    LetTyped(inner, ann_type) -> pipeline_expr_has_continuation_handler_typed(inner)
    _ -> false
  }
}

pub(package) fn pipeline_type_expr_is_non_native_scalar(ty: TypeExpr) -> i64 {
  let prim = type_expr_prim_id_or(ty, 0 - 1)
  if prim < 0 { 0 }
  else { if prim == PRIM_I64() or prim == PRIM_BOOL() or prim == PRIM_NIL() { 0 } else { 1 } }
}

pub(package) fn pipeline_expr_list_has_non_native_scalar_typed(exprs: ExprList) -> bool {
  match exprs {
    ExprListNil -> false
    ExprListCons(expr, rest) -> {
      if pipeline_expr_has_non_native_scalar_typed(expr) == 1 { true } else { pipeline_expr_list_has_non_native_scalar_typed(rest) }
    }
  }
}

pub(package) fn pipeline_record_fields_have_non_native_scalar_typed(fields: RecordFieldList) -> bool {
  match fields {
    RecordFieldListNil -> false
    RecordFieldListCons(field, rest) -> {
      let found = match field {
        RecordField(ns, nl, value, fact) -> pipeline_expr_has_non_native_scalar_typed(value)
        UnknownRecordField(tag) -> true
      }
      if found == 1 { true } else { pipeline_record_fields_have_non_native_scalar_typed(rest) }
    }
  }
}

pub(package) fn pipeline_match_arms_have_non_native_scalar_typed(arms: MatchArmList) -> bool {
  match arms {
    MatchArmListNil -> false
    MatchArmListCons(arm, rest) -> {
      let found = match arm {
        Arm(pattern, body, guard, has_guard) -> {
          if has_guard == 1 {
            pipeline_expr_has_non_native_scalar_typed(guard) or pipeline_expr_has_non_native_scalar_typed(body)
          } else {
            pipeline_expr_has_non_native_scalar_typed(body)
          }
        }
        UnknownArm(tag) -> false
      }
      if found == 1 { true } else { pipeline_match_arms_have_non_native_scalar_typed(rest) }
    }
  }
}

pub(package) fn pipeline_handler_clause_list_has_non_native_scalar_typed(clauses: HandlerClauseList) -> bool {
  match clauses {
    HandlerClauseListNil -> false
    HandlerClauseListCons(clause, rest) -> {
      if pipeline_expr_has_non_native_scalar_typed(handler_clause_body_expr(clause)) == 1 {
        true
      } else {
        pipeline_handler_clause_list_has_non_native_scalar_typed(rest)
      }
    }
  }
}

pub(package) fn pipeline_expr_has_non_native_scalar_typed(expr: Expr) -> bool {
  match expr {
    IntLit(value, start, len) -> false
    BoolLit(value) -> false
    Ident(ns, nl) -> false
    NilExpr -> false
    BreakNoValue -> false
    Continue -> false
    ReturnNoValue -> false
    StringLit(start, len) -> true
    FloatLit(start, len) -> true
    BinOp(op, lhs, rhs) -> pipeline_expr_has_non_native_scalar_typed(lhs) or pipeline_expr_has_non_native_scalar_typed(rhs)
    Call(ns, nl, args) -> pipeline_expr_list_has_non_native_scalar_typed(args)
    GenericCall(type_args, inner_call) -> pipeline_expr_has_non_native_scalar_typed(inner_call)
    If(cond, then_expr, else_expr) -> pipeline_expr_has_non_native_scalar_typed(cond) or pipeline_expr_has_non_native_scalar_typed(then_expr) or pipeline_expr_has_non_native_scalar_typed(else_expr)
    While(cond, body) -> pipeline_expr_has_non_native_scalar_typed(cond) or pipeline_expr_has_non_native_scalar_typed(body)
    Loop(body) -> pipeline_expr_has_non_native_scalar_typed(body)
    Break(value) -> pipeline_expr_has_non_native_scalar_typed(value)
    Return(value) -> pipeline_expr_has_non_native_scalar_typed(value)
    Defer(cleanup, body, source_site) -> pipeline_expr_has_non_native_scalar_typed(cleanup) or pipeline_expr_has_non_native_scalar_typed(body)
    Let(ns, nl, value, body) -> pipeline_expr_has_non_native_scalar_typed(value) or pipeline_expr_has_non_native_scalar_typed(body)
    LetMut(ns, nl, value, body) -> pipeline_expr_has_non_native_scalar_typed(value) or pipeline_expr_has_non_native_scalar_typed(body)
    Assign(ns, nl, value) -> pipeline_expr_has_non_native_scalar_typed(value)
    AddressOf(mutable, target) -> pipeline_expr_has_non_native_scalar_typed(target)
    Deref(ptr) -> pipeline_expr_has_non_native_scalar_typed(ptr)
    PtrAssign(ptr, value) -> pipeline_expr_has_non_native_scalar_typed(ptr) or pipeline_expr_has_non_native_scalar_typed(value)
    Block(first, rest) -> pipeline_expr_has_non_native_scalar_typed(first) or pipeline_expr_has_non_native_scalar_typed(rest)
    FieldAccess(base, field_ns, field_nl, fact) -> pipeline_expr_has_non_native_scalar_typed(base)
    IndexedLen(base, fixed_len) -> pipeline_expr_has_non_native_scalar_typed(base)
    IndexedGet(base, index, element_ty, fixed_len) -> pipeline_expr_has_non_native_scalar_typed(base) or pipeline_expr_has_non_native_scalar_typed(index) or pipeline_prim_is_non_native_int(pipeline_type_node_prim_id_or(element_ty, 0)) == 1
    IndexedSet(base, index, value, fact) -> pipeline_expr_has_non_native_scalar_typed(base) or pipeline_expr_has_non_native_scalar_typed(index) or pipeline_expr_has_non_native_scalar_typed(value)
    IndexedSlice(base, start, end, fact) -> pipeline_expr_has_non_native_scalar_typed(base) or pipeline_expr_has_non_native_scalar_typed(start) or pipeline_expr_has_non_native_scalar_typed(end)
    RecordInit(type_ns, type_nl, fields) -> pipeline_record_fields_have_non_native_scalar_typed(fields)
    RecordUpdate(base, fields, fact) -> pipeline_expr_has_non_native_scalar_typed(base) or pipeline_record_fields_have_non_native_scalar_typed(fields)
    ArrayLiteral(elements, resolved_ty, span) -> pipeline_expr_list_has_non_native_scalar_typed(elements)
    Match(scrutinee, arms) -> pipeline_expr_has_non_native_scalar_typed(scrutinee) or pipeline_match_arms_have_non_native_scalar_typed(arms)
    Not(operand) -> pipeline_expr_has_non_native_scalar_typed(operand)
    Lambda(params, body, source_site) -> pipeline_expr_has_non_native_scalar_typed(body)
    Perform(lhs, op_ns, op_nl, args) -> pipeline_expr_has_non_native_scalar_typed(lhs) or pipeline_expr_list_has_non_native_scalar_typed(args)
    Handle(body, clauses, hret) -> pipeline_expr_has_non_native_scalar_typed(body) or pipeline_handler_clause_list_has_non_native_scalar_typed(clauses) or (match hret { NoHandleReturn -> false HandleReturnClause(rns, rnl, rb) -> pipeline_expr_has_non_native_scalar_typed(rb) })
    WithHandler(config, body, fact, source_site) -> pipeline_expr_list_has_non_native_scalar_typed(handler_configuration_args(config)) or pipeline_expr_has_non_native_scalar_typed(body) or pipeline_handler_clause_list_has_non_native_scalar_typed(pipeline_handler_install_clauses(fact))
    Resume(value) -> pipeline_expr_has_non_native_scalar_typed(value)
    MethodCall(recv, method_hash, args, type_hash) -> pipeline_expr_has_non_native_scalar_typed(recv) or pipeline_expr_list_has_non_native_scalar_typed(args)
    Try(inner, effect_atom) -> pipeline_expr_has_non_native_scalar_typed(inner)
    InterpConcat(left, right) -> pipeline_expr_has_non_native_scalar_typed(left) or pipeline_expr_has_non_native_scalar_typed(right)
    ForIter(var_ns, var_nl, collection, body) -> pipeline_expr_has_non_native_scalar_typed(collection) or pipeline_expr_has_non_native_scalar_typed(body)
    OptChain(base, field_ns, field_nl, effect_atom) -> pipeline_expr_has_non_native_scalar_typed(base)
    LetTyped(inner, ann_type) -> {
      if pipeline_type_expr_is_non_native_scalar(ann_type) == 1 { true } else { pipeline_expr_has_non_native_scalar_typed(inner) }
    }
    UnknownExpr(tag) -> true
    _ -> true
  }
}

pub(package) fn pipeline_expr_list_has_match_typed(exprs: ExprList) -> bool {
  match exprs {
    ExprListNil -> false
    ExprListCons(expr, rest) -> if pipeline_expr_has_match_typed(expr) == 1 { true } else { pipeline_expr_list_has_match_typed(rest) }
  }
}

pub(package) fn pipeline_record_fields_have_match_typed(fields: RecordFieldList) -> bool {
  match fields {
    RecordFieldListNil -> false
    RecordFieldListCons(field, rest) -> {
      let found = match field {
        RecordField(ns, nl, value, fact) -> pipeline_expr_has_match_typed(value)
        UnknownRecordField(tag) -> false
      }
      if found == 1 { true } else { pipeline_record_fields_have_match_typed(rest) }
    }
  }
}

pub(package) fn pipeline_match_arms_have_match_typed(arms: MatchArmList) -> i64 {
  match arms {
    MatchArmListNil -> 0
    MatchArmListCons(arm, rest) -> {
      let found = match arm {
        Arm(pattern, body, guard, has_guard) -> {
          if has_guard == 1 {
            pipeline_expr_has_match_typed(guard) or pipeline_expr_has_match_typed(body)
          } else {
            pipeline_expr_has_match_typed(body)
          }
        }
        UnknownArm(tag) -> 0
      }
      if found == 1 { 1 } else { pipeline_match_arms_have_match_typed(rest) }
    }
  }
}

pub(package) fn pipeline_handler_clause_list_has_match_typed(clauses: HandlerClauseList) -> bool {
  match clauses {
    HandlerClauseListNil -> false
    HandlerClauseListCons(clause, rest) -> {
      if pipeline_expr_has_match_typed(handler_clause_body_expr(clause)) == 1 { true } else { pipeline_handler_clause_list_has_match_typed(rest) }
    }
  }
}

pub(package) fn pipeline_expr_has_match_typed(expr: Expr) -> bool {
  match expr {
    Match(scrutinee, arms) -> true
    BinOp(op, lhs, rhs) -> pipeline_expr_has_match_typed(lhs) or pipeline_expr_has_match_typed(rhs)
    Call(ns, nl, args) -> pipeline_expr_list_has_match_typed(args)
    GenericCall(type_args, inner_call) -> pipeline_expr_has_match_typed(inner_call)
    If(cond, then_expr, else_expr) -> pipeline_expr_has_match_typed(cond) or pipeline_expr_has_match_typed(then_expr) or pipeline_expr_has_match_typed(else_expr)
    While(cond, body) -> pipeline_expr_has_match_typed(cond) or pipeline_expr_has_match_typed(body)
    Loop(body) -> pipeline_expr_has_match_typed(body)
    Break(value) -> pipeline_expr_has_match_typed(value)
    Return(value) -> pipeline_expr_has_match_typed(value)
    Defer(cleanup, body, source_site) -> pipeline_expr_has_match_typed(cleanup) or pipeline_expr_has_match_typed(body)
    Let(ns, nl, value, body) -> pipeline_expr_has_match_typed(value) or pipeline_expr_has_match_typed(body)
    LetMut(ns, nl, value, body) -> pipeline_expr_has_match_typed(value) or pipeline_expr_has_match_typed(body)
    Assign(ns, nl, value) -> pipeline_expr_has_match_typed(value)
    AddressOf(mutable, target) -> pipeline_expr_has_match_typed(target)
    Deref(ptr) -> pipeline_expr_has_match_typed(ptr)
    PtrAssign(ptr, value) -> pipeline_expr_has_match_typed(ptr) or pipeline_expr_has_match_typed(value)
    Block(first, rest) -> pipeline_expr_has_match_typed(first) or pipeline_expr_has_match_typed(rest)
    FieldAccess(base, field_ns, field_nl, fact) -> pipeline_expr_has_match_typed(base)
    IndexedLen(base, fixed_len) -> pipeline_expr_has_match_typed(base)
    IndexedGet(base, index, element_ty, fixed_len) -> pipeline_expr_has_match_typed(base) or pipeline_expr_has_match_typed(index)
    IndexedSet(base, index, value, fact) -> pipeline_expr_has_match_typed(base) or pipeline_expr_has_match_typed(index) or pipeline_expr_has_match_typed(value)
    IndexedSlice(base, start, end, fact) -> pipeline_expr_has_match_typed(base) or pipeline_expr_has_match_typed(start) or pipeline_expr_has_match_typed(end)
    RecordInit(type_ns, type_nl, fields) -> pipeline_record_fields_have_match_typed(fields)
    RecordUpdate(base, fields, fact) -> pipeline_expr_has_match_typed(base) or pipeline_record_fields_have_match_typed(fields)
    ArrayLiteral(elements, resolved_ty, span) -> pipeline_expr_list_has_match_typed(elements)
    Not(operand) -> pipeline_expr_has_match_typed(operand)
    Lambda(params, body, source_site) -> pipeline_expr_has_match_typed(body)
    Perform(lhs, op_ns, op_nl, args) -> pipeline_expr_has_match_typed(lhs) or pipeline_expr_list_has_match_typed(args)
    Handle(body, clauses, hret) -> pipeline_expr_has_match_typed(body) or pipeline_handler_clause_list_has_match_typed(clauses) or (match hret { NoHandleReturn -> false HandleReturnClause(rns, rnl, rb) -> pipeline_expr_has_match_typed(rb) })
    WithHandler(config, body, fact, source_site) -> pipeline_expr_list_has_match_typed(handler_configuration_args(config)) or pipeline_expr_has_match_typed(body) or pipeline_handler_clause_list_has_match_typed(pipeline_handler_install_clauses(fact))
    Resume(value) -> pipeline_expr_has_match_typed(value)
    MethodCall(recv, method_hash, args, type_hash) -> pipeline_expr_has_match_typed(recv) or pipeline_expr_list_has_match_typed(args)
    Try(inner, effect_atom) -> pipeline_expr_has_match_typed(inner)
    InterpConcat(left, right) -> pipeline_expr_has_match_typed(left) or pipeline_expr_has_match_typed(right)
    ForIter(var_ns, var_nl, collection, body) -> pipeline_expr_has_match_typed(collection) or pipeline_expr_has_match_typed(body)
    OptChain(base, field_ns, field_nl, effect_atom) -> pipeline_expr_has_match_typed(base)
    LetTyped(inner, ann_type) -> pipeline_expr_has_match_typed(inner)
    _ -> false
  }
}

pub(package) fn pipeline_call_is_raw_intrinsic(src: i64, ns: i64, nl: i64) -> i64 {
  if src_eq(src, ns, nl, "__mem_load64") == 1 { 1 }
  else { if src_eq(src, ns, nl, "__mem_store64") == 1 { 1 }
  else { if src_eq(src, ns, nl, "__mem_load8") == 1 { 1 }
  else { if src_eq(src, ns, nl, "__mem_store8") == 1 { 1 }
  else { if src_eq(src, ns, nl, "__bump_alloc") == 1 { 1 }
  else { 0 } } } } }
}

pub(package) fn pipeline_expr_list_has_raw_intrinsic_typed(exprs: ExprList, src: i64) -> bool {
  match exprs {
    ExprListNil -> false
    ExprListCons(expr, rest) -> if pipeline_expr_has_raw_intrinsic_typed(expr, src) == 1 { true } else { pipeline_expr_list_has_raw_intrinsic_typed(rest, src) }
  }
}

pub(package) fn pipeline_record_fields_have_raw_intrinsic_typed(fields: RecordFieldList, src: i64) -> bool {
  match fields {
    RecordFieldListNil -> false
    RecordFieldListCons(field, rest) -> {
      let found = match field {
        RecordField(ns, nl, value, fact) -> pipeline_expr_has_raw_intrinsic_typed(value, src)
        UnknownRecordField(tag) -> false
      }
      if found == 1 { true } else { pipeline_record_fields_have_raw_intrinsic_typed(rest, src) }
    }
  }
}

pub(package) fn pipeline_match_arms_have_raw_intrinsic_typed(arms: MatchArmList, src: i64) -> bool {
  match arms {
    MatchArmListNil -> false
    MatchArmListCons(arm, rest) -> {
      let found = match arm {
        Arm(pattern, body, guard, has_guard) -> {
          if has_guard == 1 {
            pipeline_expr_has_raw_intrinsic_typed(guard, src) or pipeline_expr_has_raw_intrinsic_typed(body, src)
          } else {
            pipeline_expr_has_raw_intrinsic_typed(body, src)
          }
        }
        UnknownArm(tag) -> false
      }
      if found == 1 { true } else { pipeline_match_arms_have_raw_intrinsic_typed(rest, src) }
    }
  }
}

pub(package) fn pipeline_handler_clause_list_has_raw_intrinsic_typed(clauses: HandlerClauseList, src: i64) -> bool {
  match clauses {
    HandlerClauseListNil -> false
    HandlerClauseListCons(clause, rest) -> if pipeline_expr_has_raw_intrinsic_typed(handler_clause_body_expr(clause), src) == 1 { true } else { pipeline_handler_clause_list_has_raw_intrinsic_typed(rest, src) }
  }
}

pub(package) fn pipeline_expr_has_raw_intrinsic_typed(expr: Expr, src: i64) -> bool {
  match expr {
    Call(ns, nl, args) -> if pipeline_call_is_raw_intrinsic(src, ns, nl) == 1 { true } else { pipeline_expr_list_has_raw_intrinsic_typed(args, src) }
    BinOp(op, lhs, rhs) -> pipeline_expr_has_raw_intrinsic_typed(lhs, src) or pipeline_expr_has_raw_intrinsic_typed(rhs, src)
    GenericCall(type_args, inner_call) -> pipeline_expr_has_raw_intrinsic_typed(inner_call, src)
    If(cond, then_expr, else_expr) -> pipeline_expr_has_raw_intrinsic_typed(cond, src) or pipeline_expr_has_raw_intrinsic_typed(then_expr, src) or pipeline_expr_has_raw_intrinsic_typed(else_expr, src)
    While(cond, body) -> pipeline_expr_has_raw_intrinsic_typed(cond, src) or pipeline_expr_has_raw_intrinsic_typed(body, src)
    Loop(body) -> pipeline_expr_has_raw_intrinsic_typed(body, src)
    Break(value) -> pipeline_expr_has_raw_intrinsic_typed(value, src)
    Return(value) -> pipeline_expr_has_raw_intrinsic_typed(value, src)
    Defer(cleanup, body, source_site) -> pipeline_expr_has_raw_intrinsic_typed(cleanup, src) or pipeline_expr_has_raw_intrinsic_typed(body, src)
    Let(ns, nl, value, body) -> pipeline_expr_has_raw_intrinsic_typed(value, src) or pipeline_expr_has_raw_intrinsic_typed(body, src)
    LetMut(ns, nl, value, body) -> pipeline_expr_has_raw_intrinsic_typed(value, src) or pipeline_expr_has_raw_intrinsic_typed(body, src)
    Assign(ns, nl, value) -> pipeline_expr_has_raw_intrinsic_typed(value, src)
    AddressOf(mutable, target) -> pipeline_expr_has_raw_intrinsic_typed(target, src)
    Deref(ptr) -> pipeline_expr_has_raw_intrinsic_typed(ptr, src)
    PtrAssign(ptr, value) -> pipeline_expr_has_raw_intrinsic_typed(ptr, src) or pipeline_expr_has_raw_intrinsic_typed(value, src)
    Block(first, rest) -> pipeline_expr_has_raw_intrinsic_typed(first, src) or pipeline_expr_has_raw_intrinsic_typed(rest, src)
    FieldAccess(base, field_ns, field_nl, fact) -> pipeline_expr_has_raw_intrinsic_typed(base, src)
    IndexedLen(base, fixed_len) -> pipeline_expr_has_raw_intrinsic_typed(base, src)
    IndexedGet(base, index, element_ty, fixed_len) -> pipeline_expr_has_raw_intrinsic_typed(base, src) or pipeline_expr_has_raw_intrinsic_typed(index, src)
    IndexedSet(base, index, value, fact) -> pipeline_expr_has_raw_intrinsic_typed(base, src) or pipeline_expr_has_raw_intrinsic_typed(index, src) or pipeline_expr_has_raw_intrinsic_typed(value, src)
    IndexedSlice(base, start, end, fact) -> pipeline_expr_has_raw_intrinsic_typed(base, src) or pipeline_expr_has_raw_intrinsic_typed(start, src) or pipeline_expr_has_raw_intrinsic_typed(end, src)
    RecordInit(type_ns, type_nl, fields) -> pipeline_record_fields_have_raw_intrinsic_typed(fields, src)
    RecordUpdate(base, fields, fact) -> pipeline_expr_has_raw_intrinsic_typed(base, src) or pipeline_record_fields_have_raw_intrinsic_typed(fields, src)
    ArrayLiteral(elements, resolved_ty, span) -> pipeline_expr_list_has_raw_intrinsic_typed(elements, src)
    Match(scrutinee, arms) -> pipeline_expr_has_raw_intrinsic_typed(scrutinee, src) or pipeline_match_arms_have_raw_intrinsic_typed(arms, src)
    Not(operand) -> pipeline_expr_has_raw_intrinsic_typed(operand, src)
    Lambda(params, body, source_site) -> pipeline_expr_has_raw_intrinsic_typed(body, src)
    Perform(lhs, op_ns, op_nl, args) -> pipeline_expr_has_raw_intrinsic_typed(lhs, src) or pipeline_expr_list_has_raw_intrinsic_typed(args, src)
    Handle(body, clauses, hret) -> pipeline_expr_has_raw_intrinsic_typed(body, src) or pipeline_handler_clause_list_has_raw_intrinsic_typed(clauses, src) or (match hret { NoHandleReturn -> false HandleReturnClause(rns, rnl, rb) -> pipeline_expr_has_raw_intrinsic_typed(rb, src) })
    WithHandler(config, body, fact, source_site) -> pipeline_expr_list_has_raw_intrinsic_typed(handler_configuration_args(config), src) or pipeline_expr_has_raw_intrinsic_typed(body, src) or pipeline_handler_clause_list_has_raw_intrinsic_typed(pipeline_handler_install_clauses(fact), pipeline_handler_install_source_or(fact, src))
    Resume(value) -> pipeline_expr_has_raw_intrinsic_typed(value, src)
    MethodCall(recv, method_hash, args, type_hash) -> pipeline_expr_has_raw_intrinsic_typed(recv, src) or pipeline_expr_list_has_raw_intrinsic_typed(args, src)
    Try(inner, effect_atom) -> pipeline_expr_has_raw_intrinsic_typed(inner, src)
    InterpConcat(left, right) -> pipeline_expr_has_raw_intrinsic_typed(left, src) or pipeline_expr_has_raw_intrinsic_typed(right, src)
    ForIter(var_ns, var_nl, collection, body) -> pipeline_expr_has_raw_intrinsic_typed(collection, src) or pipeline_expr_has_raw_intrinsic_typed(body, src)
    OptChain(base, field_ns, field_nl, effect_atom) -> pipeline_expr_has_raw_intrinsic_typed(base, src)
    LetTyped(inner, ann_type) -> pipeline_expr_has_raw_intrinsic_typed(inner, src)
    _ -> false
  }
}

-- Identity-home store for above-home-count counter values (handler
-- scratch, closure/env counters). ck: the identity home now holds dst —
-- these stores were the un-instrumented def sites the v2 replay exposed
-- (reads of handler scratch flow through load_reg and ARE recorded, so
-- an unrecorded write here surfaces as a CLOBBERED false violation).
pub(package) fn pipeline_ir_native_store_reg(code: i64, facts: PipelineIrNativeValueHomeFacts, dst: i64, phys: i64) -> i64 {
  if dst < 0 { 0 }
  else { if dst < 8 {
    bu32(code, encode_add_imm(dst + 19, phys, 0))
    pipeline_ir_native_ck_def(code, facts, dst + 19, dst)
  } else {
    emit_store_reg(code, dst, phys)
    pipeline_ir_native_ck_def(code, facts, 0 - (dst - 7), dst)
  } }
}

pub(package) fn pipeline_ir_native_pinned_slot_none() -> i64 { 0 }
pub(package) fn pipeline_ir_native_pinned_slot_max_count() -> i64 { 3 }
pub(package) fn pipeline_ir_native_pinned_slot_kind_generic() -> i64 { 0 }
pub(package) fn pipeline_ir_native_pinned_slot_kind_loop() -> i64 { 1 }

pub(package) fn pipeline_ir_native_pinned_slot_phys_for_index(index: i64) -> i64 {
  if index == 0 { 8 }
  else { if index == 1 { 10 }
  else { if index == 2 { 11 }
  else { 0 } } }
}

pub(package) fn pipeline_ir_native_pinned_slot_new(slot: i64, phys: i64, kind: i64, rest: i64) -> i64 {
  node_new(0, slot, phys, rest, kind)
}

pub(package) fn pipeline_ir_native_pinned_slot_lookup(pinned: i64, value: i64) -> i64 {
  let mut cur = pinned
  let mut phys = 0
  while cur != 0 and phys == 0 {
    if node_f1(cur) == value {
      phys = node_f2(cur)
    } else {
      cur = node_f3(cur)
    }
  }
  phys
}

pub(package) fn pipeline_ir_native_pinned_slot_count(pinned: i64) -> i64 {
  let mut cur = pinned
  let mut count = 0
  while cur != 0 {
    count = count + 1
    cur = node_f3(cur)
  }
  count
}

pub(package) fn pipeline_ir_native_pinned_slot_contains(pinned: i64, slot: i64) -> i64 {
  if pipeline_ir_native_pinned_slot_lookup(pinned, slot) != 0 { 1 } else { 0 }
}

pub(package) fn pipeline_ir_native_pinned_slot_kind_count(pinned: i64, kind: i64) -> i64 {
  let mut cur = pinned
  let mut count = 0
  while cur != 0 {
    if node_f4(cur) == kind { count = count + 1 } else { 0 }
    cur = node_f3(cur)
  }
  count
}

pub(package) fn pipeline_ir_native_pinned_slot_add_candidate_kind(pinned: i64, slot: i64, kind: i64) -> i64 {
  if slot < 8 { pinned }
  else { if pipeline_ir_native_pinned_slot_contains(pinned, slot) == 1 { pinned }
  else {
    let count = pipeline_ir_native_pinned_slot_count(pinned)
    if count >= pipeline_ir_native_pinned_slot_max_count() {
      pinned
    } else {
      let phys = pipeline_ir_native_pinned_slot_phys_for_index(count)
      if phys == 0 { pinned } else { pipeline_ir_native_pinned_slot_new(slot, phys, kind, pinned) }
    }
  } }
}

pub(package) fn pipeline_ir_native_pinned_slot_add_candidate(pinned: i64, slot: i64) -> i64 {
  pipeline_ir_native_pinned_slot_add_candidate_kind(pinned, slot, pipeline_ir_native_pinned_slot_kind_generic())
}

pub(package) fn pipeline_ir_native_identity_home(value: i64) -> i64 {
  cg_canonical_value_home(value)
}

pub(package) fn pipeline_ir_native_value_home_apply_assignments(assignments: i64, homes: i64, next_value: i64) -> i64 {
  if assignments == 0 {
    0
  } else {
    -- The linked assignment ledger is newest-first. Apply the tail first
    -- so the same value's newest allocator decision remains authoritative.
    pipeline_ir_native_value_home_apply_assignments(node_f3(assignments), homes, next_value)
    let value = node_f1(assignments)
    if value >= 0 and value < next_value {
      pipeline_ir_native_resident_dense_set(homes, value, node_f2(assignments))
    } else { 0 }
  }
}

pub(package) fn pipeline_ir_native_value_home_facts_with_scratch_base(next_value: i64, assignments: i64, scratch_base: i64) -> PipelineIrNativeValueHomeFacts {
  let homes = nlist_new()
  for value in 0..next_value {
    nlist_add(homes, pipeline_ir_native_identity_home(value))
  }
  pipeline_ir_native_value_home_apply_assignments(assignments, homes, next_value)
  PipelineIrNativeValueHomeFacts(homes, assignments, scratch_base, node_new(0, pipeline_ir_native_forward_marker(), 0 - 1, 0, 0))
}

pub(package) fn pipeline_ir_native_value_home_facts(next_value: i64, assignments: i64) -> PipelineIrNativeValueHomeFacts {
  pipeline_ir_native_value_home_facts_with_scratch_base(next_value, assignments, next_value)
}

pub(package) fn pipeline_ir_native_identity_home_facts_with_scratch_base(next_value: i64, scratch_base: i64) -> PipelineIrNativeValueHomeFacts {
  PipelineIrNativeIdentityHomeFacts(next_value, scratch_base, node_new(0, pipeline_ir_native_forward_marker(), 0 - 1, 0, 0))
}

pub(package) fn pipeline_ir_native_identity_home_facts(next_value: i64) -> PipelineIrNativeValueHomeFacts {
  pipeline_ir_native_identity_home_facts_with_scratch_base(next_value, next_value)
}

pub(package) fn pipeline_ir_native_value_home_facts_forward(facts: PipelineIrNativeValueHomeFacts) -> i64 {
  match facts {
    PipelineIrNativeValueHomeFacts(homes, assignments, scratch_base, forward) -> forward
    PipelineIrNativeIdentityHomeFacts(next_value, scratch_base, forward) -> forward
  }
}

pub(package) fn pipeline_ir_native_value_home_lookup(facts: PipelineIrNativeValueHomeFacts, value: i64) -> i64 {
  match facts {
    PipelineIrNativeValueHomeFacts(homes, assignments, scratch_base, forward) -> {
      if value >= 0 and value < nlist_len(homes) { nlist_get(homes, value) } else { 0 }
    }
    PipelineIrNativeIdentityHomeFacts(next_value, scratch_base, forward) -> {
      if value >= 0 and value < next_value { pipeline_ir_native_identity_home(value) } else { 0 }
    }
  }
}

pub(package) fn pipeline_ir_native_value_home_fact_count(facts: PipelineIrNativeValueHomeFacts) -> i64 {
  match facts {
    PipelineIrNativeValueHomeFacts(homes, assignments, scratch_base, forward) -> nlist_len(homes)
    PipelineIrNativeIdentityHomeFacts(next_value, scratch_base, forward) -> next_value
  }
}

pub(package) fn pipeline_ir_native_handler_scratch_base(facts: PipelineIrNativeValueHomeFacts) -> i64 {
  match facts {
    PipelineIrNativeValueHomeFacts(homes, assignments, scratch_base, forward) -> scratch_base
    PipelineIrNativeIdentityHomeFacts(next_value, scratch_base, forward) -> scratch_base
  }
}

pub(package) fn pipeline_ir_native_value_home_count_include(count: i64, value: i64) -> i64 {
  if value >= count { value + 1 } else { count }
}

pub(package) fn pipeline_ir_native_value_home_count_include_evidence(count: i64, fm: i64) -> i64 {
  pipeline_ir_native_value_home_count_include(
    pipeline_ir_native_value_home_count_include(count, fmap_lambda_evidence_value(fm)),
    fmap_lambda_evidence_frame_value(fm)
  )
}

pub(package) fn pipeline_ir_native_value_home_count_include_handlers(count: i64, handlers: PipelineNativeHandlerCtx) -> i64 {
  match handlers {
    PipelineNativeHandlerCtxNil -> count
    PipelineNativeHandlerCtxCons(eff_hash, infos, nclauses, ops_ctr, frame_ctr, is_abortive, rest) -> {
      let with_ops = pipeline_ir_native_value_home_count_include(count, ops_ctr)
      let with_frame = pipeline_ir_native_value_home_count_include(with_ops, frame_ctr)
      pipeline_ir_native_value_home_count_include_handlers(with_frame, rest)
    }
  }
}

pub(package) fn pipeline_ir_native_handler_home_scan_depth(scan: PipelineIrNativeHandlerHomeScan) -> i64 {
  match scan {
    PipelineIrNativeHandlerHomeScan(depth, max_depth) -> depth
  }
}

pub(package) fn pipeline_ir_native_handler_home_scan_max_depth(scan: PipelineIrNativeHandlerHomeScan) -> i64 {
  match scan {
    PipelineIrNativeHandlerHomeScan(depth, max_depth) -> max_depth
  }
}

pub(package) fn pipeline_ir_native_handler_home_scan_insts(insts: IrInstList, scan: PipelineIrNativeHandlerHomeScan) -> PipelineIrNativeHandlerHomeScan {
  match insts {
    IrInstNil -> scan
    IrInstCons(inst, rest) -> {
      let depth = pipeline_ir_native_handler_home_scan_depth(scan)
      let max_depth = pipeline_ir_native_handler_home_scan_max_depth(scan)
      let next = match inst {
        IrHandleI64(dst, handle_src, effect_hash, clauses, nclauses, reserved) -> {
          let pushed = depth + 1
          PipelineIrNativeHandlerHomeScan(pushed, if pushed > max_depth { pushed } else { max_depth })
        }
        IrHandlerPopI64(frame) -> PipelineIrNativeHandlerHomeScan(if depth > 0 { depth - 1 } else { 0 }, max_depth)
        IrAbortLandingI64(dst) -> scan
        _ -> scan
      }
      pipeline_ir_native_handler_home_scan_insts(rest, next)
    }
  }
}

pub(package) fn pipeline_ir_native_handler_home_scan_blocks(blocks: IrBlockList, scan: PipelineIrNativeHandlerHomeScan) -> PipelineIrNativeHandlerHomeScan {
  match blocks {
    IrBlockListNil -> scan
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          pipeline_ir_native_handler_home_scan_blocks(rest, pipeline_ir_native_handler_home_scan_insts(insts, scan))
        }
      }
    }
  }
}

pub(package) fn pipeline_ir_native_value_home_count_include_handler_scratch(count: i64, blocks: IrBlockList, initial_depth: i64) -> i64 {
  let scan = pipeline_ir_native_handler_home_scan_blocks(blocks, PipelineIrNativeHandlerHomeScan(initial_depth, initial_depth))
  let max_depth = pipeline_ir_native_handler_home_scan_max_depth(scan)
  count + max_depth * 2
}

pub(package) fn pipeline_ir_native_value_home_facts_with_handler_scratch(count: i64, blocks: IrBlockList, initial_depth: i64, assignments: i64) -> PipelineIrNativeValueHomeFacts {
  pipeline_ir_native_value_home_facts_with_scratch_base(pipeline_ir_native_value_home_count_include_handler_scratch(count, blocks, initial_depth), assignments, count)
}

pub(package) fn pipeline_ir_native_identity_home_facts_with_handler_scratch(count: i64, blocks: IrBlockList, initial_depth: i64) -> PipelineIrNativeValueHomeFacts {
  pipeline_ir_native_identity_home_facts_with_scratch_base(pipeline_ir_native_value_home_count_include_handler_scratch(count, blocks, initial_depth), count)
}

pub(package) fn pipeline_ir_native_identity_home_facts_like(facts: PipelineIrNativeValueHomeFacts) -> PipelineIrNativeValueHomeFacts {
  match facts {
    PipelineIrNativeValueHomeFacts(homes, assignments, scratch_base, forward) -> pipeline_ir_native_identity_home_facts_with_scratch_base(nlist_len(homes), scratch_base)
    PipelineIrNativeIdentityHomeFacts(next_value, scratch_base, forward) -> facts
  }
}

-- Adjacent def-use load forwarding. A mutable cell beside the immutable
-- dense home facts records the last spilled value together with the register
-- it was stored FROM and the code position after the store. A later operand
-- load may reuse that register only if the code buffer has not grown since
-- (the register is provably untouched). Only the last-loaded operand path
-- (load_rhs) consumes forwards, so an earlier operand's forwarded register
-- cannot be clobbered by a subsequent operand load in the same instruction.
pub(package) fn pipeline_ir_native_forward_marker() -> i64 { 0 - 987654321 }

-- volatile-pool allocation dead spill-store deletion: a call-shaped def whose result
-- is never used (no inst use, no term use, not a block param) gets this
-- pseudo-home in the pinned map. store_reg_pinned emits NOTHING for it
-- (the call executes; only the dead result store is deleted); every
-- read path traps loudly — a read of a discard-homed value means the
-- use analysis lied. IR-level DCE already deletes dead PURE defs, so
-- this catches exactly the effectful remainder (statement-position
-- calls). Restricted to inst_call_read_safe def shapes so machinery
-- with bespoke, uninstrumented canonical-home reads (intrinsics,
-- perform, handler frames, closures, vector lanes) can never carry it.
pub(package) fn pipeline_ir_native_discard_home() -> i64 { 999 }

-- Constant rematerialization: a frame-homed IrConstI64 in
-- [0, 65535] whose every use reads through the pinned-aware load path
-- re-materializes with a single movz at each use instead of reloading
-- from its slot — and its canonical store disappears with the loads.
-- The constant is carried IN the pinned-map phys encoding:
-- phys = remat_base + k. Runs after every placement pass, so it only
-- takes constants no register class wanted (a pool/bank home is
-- strictly better: uses read the register for free).
pub(package) fn pipeline_ir_native_remat_base() -> i64 { 1000000 }
-- Second remat window: movn-range negatives. phys = movn_base + k
-- encodes constant ~k = -(k+1), covering [-65536, -1] in one movn.
-- The window sits ABOVE movz's [1000000, 1065535]; every reader's
-- `>= remat_base` branch must test `>= remat_movn_base` FIRST or a
-- movn phys decodes as a garbage movz constant.
pub(package) fn pipeline_ir_native_remat_movn_base() -> i64 { 1200000 }

pub(package) fn pipeline_ir_native_forward_record(facts: PipelineIrNativeValueHomeFacts, code: i64, value: i64, phys: i64) -> i64 {
  let cell = pipeline_ir_native_value_home_facts_forward(facts)
  if cell == 0 { 0 }
  else {
    mem_store64_at(cell, 16, value)
    mem_store64_at(cell, 32, buf_len(code) * 64 + phys)
    0
  }
}

pub(package) fn pipeline_ir_native_forward_hit(facts: PipelineIrNativeValueHomeFacts, code: i64, value: i64) -> i64 {
  let cell = pipeline_ir_native_value_home_facts_forward(facts)
  if cell == 0 { 0 }
  else {
    if node_f2(cell) == value {
      let packed = node_f4(cell)
      let pos = packed / 64
      if pos == buf_len(code) {
        let phys = packed - pos * 64
        pipeline_ir_native_ck_read(code, facts, phys, value)
        phys
      } else { 0 }
    } else { 0 }
  }
}

-- emission allocation checker (Stage 0): emission-time read/def event ledger.
-- The ledger handle lives in the forwarding cell's free f3 field (0 =
-- disarmed) so the load/store choke points need no signature change; it is
-- armed per function under audit mode only. Event nodes are
-- node(kind, byte_off, loc, value) with kind 0 = READ (loc must hold
-- value when execution reaches byte_off) and 1 = DEF (loc holds value
-- from byte_off on). Locations: 0-30 GPRs, negative -(slot+1) frame
-- slots. FP homes are not evented in Stage 0 v1.
pub(package) fn pipeline_ir_native_ck_events(facts: PipelineIrNativeValueHomeFacts) -> i64 {
  let cell = pipeline_ir_native_value_home_facts_forward(facts)
  if cell == 0 { 0 } else { node_f3(cell) }
}

pub(package) fn pipeline_ir_native_ck_arm(facts: PipelineIrNativeValueHomeFacts) -> i64 {
  let cell = pipeline_ir_native_value_home_facts_forward(facts)
  if cell == 0 { 0 } else {
    mem_store64_at(cell, 24, nlist_new())
    0
  }
}

pub(package) fn pipeline_ir_native_ck_read(code: i64, facts: PipelineIrNativeValueHomeFacts, loc: i64, value: i64) -> i64 {
  let events = pipeline_ir_native_ck_events(facts)
  if events == 0 { 0 } else {
    nlist_add(events, node_new(0, buf_len(code), loc, value, 0))
    0
  }
}

pub(package) fn pipeline_ir_native_ck_def(code: i64, facts: PipelineIrNativeValueHomeFacts, loc: i64, value: i64) -> i64 {
  let events = pipeline_ir_native_ck_events(facts)
  if events == 0 { 0 } else {
    nlist_add(events, node_new(1, buf_len(code), loc, value, 0))
    0
  }
}

-- FP residents are encoded in the pinned map as 1000 + fd (the
-- cg_f64_fp_regid convention). They are only ever read at the f64
-- materialisation/operand sites; a GPR-path read is a selection bug, so
-- the GPR helpers trap loudly instead of emitting a garbage register.
pub(package) fn pipeline_ir_native_fp_resident_fd(facts: PipelineIrNativeValueHomeFacts, value: i64) -> i64 {
  let phys = pipeline_ir_native_value_home_lookup(facts, value)
  -- FP homes occupy exactly 1000+d0 .. 1000+d15; discard and remat
  -- pseudo-homes live outside this window and are not FP residents.
  if phys >= 1000 and phys <= 1015 { phys - 1000 } else { 0 }
}

pub(package) fn pipeline_ir_native_load_reg(code: i64, facts: PipelineIrNativeValueHomeFacts, value: i64) -> i64 {
  let phys = pipeline_ir_native_value_home_lookup(facts, value)
  if phys >= pipeline_ir_native_remat_movn_base() {
    bu32(code, encode_movn(16, phys - pipeline_ir_native_remat_movn_base()))
    16
  } else { if phys >= pipeline_ir_native_remat_base() {
    bu32(code, encode_movz(16, phys - pipeline_ir_native_remat_base(), 0))
    16
  } else { if phys >= 1000 or phys == pipeline_ir_native_discard_home() {
    bu32(code, encode_brk(20))
    17
  } else { if phys < 0 {
    pipeline_ir_native_ck_read(code, facts, phys, value)
    emit_load_spill_offset(code, 16, (0 - phys - 1) * 8)
    16
  } else { if phys != 0 {
    pipeline_ir_native_ck_read(code, facts, phys, value)
    phys
  } else {
    bu32(code, encode_brk(20))
    17
  } } } } }
}

pub(package) fn pipeline_ir_native_load_rhs(code: i64, facts: PipelineIrNativeValueHomeFacts, value: i64) -> i64 {
  let phys = pipeline_ir_native_value_home_lookup(facts, value)
  if phys >= pipeline_ir_native_remat_movn_base() {
    bu32(code, encode_movn(17, phys - pipeline_ir_native_remat_movn_base()))
    17
  } else { if phys >= pipeline_ir_native_remat_base() {
    bu32(code, encode_movz(17, phys - pipeline_ir_native_remat_base(), 0))
    17
  } else { if phys >= 1000 or phys == pipeline_ir_native_discard_home() {
    bu32(code, encode_brk(20))
    17
  } else { if phys < 0 {
    pipeline_ir_native_ck_read(code, facts, phys, value)
    emit_load_spill_offset(code, 17, (0 - phys - 1) * 8)
    17
  } else { if phys != 0 {
    pipeline_ir_native_ck_read(code, facts, phys, value)
    phys
  } else {
    bu32(code, encode_brk(20))
    17
  } } } } }
}

pub(package) fn pipeline_ir_native_store_reg_pinned(code: i64, facts: PipelineIrNativeValueHomeFacts, dst: i64, phys: i64) -> i64 {
  if dst < 0 { 0 }
  else {
    let pinned_phys = pipeline_ir_native_value_home_lookup(facts, dst)
    if pinned_phys == pipeline_ir_native_discard_home() or pinned_phys >= pipeline_ir_native_remat_base() {
      -- Discard: dead result, store deleted. Remat: every use
      -- re-materializes the constant, so the home is never read and
      -- the store is equally dead.
      0
    } else {
    if pinned_phys >= 1000 {
      bu32(code, encode_brk(20))
    } else { if pinned_phys < 0 {
      emit_store_spill_offset(code, phys, (0 - pinned_phys - 1) * 8)
    } else { if pinned_phys != 0 {
      bu32(code, encode_add_imm(pinned_phys, phys, 0))
    } else {
      bu32(code, encode_brk(20))
    } } }
    -- ck: the home now holds dst. The x17 staging register is also
    -- rebound to dst — forward_hit is the only consumer of a
    -- source-register binding and forwarding only ever reads x17. A
    -- non-x17 source keeps its OLD binding: the move leaves the source
    -- register's previous tenant intact (the copied value equals it),
    -- and rebinding it under the copy's id erased claims the replay
    -- still needs (the Stage 0 bring-up false-positive class).
    if pinned_phys < 0 or (pinned_phys != 0 and pinned_phys < 1000) {
      pipeline_ir_native_ck_def(code, facts, pinned_phys, dst)
      if phys == 17 {
        pipeline_ir_native_ck_def(code, facts, phys, dst)
      } else { 0 }
    } else { 0 }
    -- Only x17-resident results are forwardable: the spill-load and
    -- multi-instruction op scratch paths clobber x15/x16 but never x17
    -- before operands are read.
    if pinned_phys < 0 and pinned_phys == pipeline_ir_native_identity_home(dst) and phys == 17 {
      pipeline_ir_native_forward_record(facts, code, dst, phys)
    } else { 0 }
    }
  }
}

pub(package) fn pipeline_ir_native_fp_env_empty() -> PipelineIrNativeFpEnv {
  PipelineIrNativeFpEnvNil
}

pub(package) fn pipeline_ir_native_fp_env_single(value: i64, prim: i64, fd: i64) -> PipelineIrNativeFpEnv {
  PipelineIrNativeFpEnvCons(value, prim, fd, PipelineIrNativeFpEnvNil)
}

pub(package) fn pipeline_ir_native_fp_env_prepend(env: PipelineIrNativeFpEnv, value: i64, prim: i64, fd: i64) -> PipelineIrNativeFpEnv {
  PipelineIrNativeFpEnvCons(value, prim, fd, env)
}

pub(package) fn pipeline_ir_native_fp_env_drop_fd(env: PipelineIrNativeFpEnv, fd: i64) -> PipelineIrNativeFpEnv {
  match env {
    PipelineIrNativeFpEnvNil -> PipelineIrNativeFpEnvNil
    PipelineIrNativeFpEnvCons(value, prim, entry_fd, rest) -> {
      let filtered = pipeline_ir_native_fp_env_drop_fd(rest, fd)
      if entry_fd == fd { filtered } else { PipelineIrNativeFpEnvCons(value, prim, entry_fd, filtered) }
    }
  }
}

pub(package) fn pipeline_ir_native_vector_data_reg() -> i64 { 9 }

pub(package) fn pipeline_ir_native_vector_data_fact_list_empty() -> PipelineIrNativeVectorDataFactList {
  PipelineIrNativeVectorDataFactNil
}

pub(package) fn pipeline_ir_native_vector_data_facts_unassigned(entries: PipelineIrNativeVectorDataFactList) -> PipelineIrNativeVectorDataFacts {
  PipelineIrNativeVectorDataFacts(0, entries)
}

pub(package) fn pipeline_ir_native_vector_data_facts_home(facts: PipelineIrNativeVectorDataFacts) -> i64 {
  match facts {
    PipelineIrNativeVectorDataFacts(home, entries) -> home
  }
}

pub(package) fn pipeline_ir_native_vector_data_facts_entries(facts: PipelineIrNativeVectorDataFacts) -> PipelineIrNativeVectorDataFactList {
  match facts {
    PipelineIrNativeVectorDataFacts(home, entries) -> entries
  }
}

pub(package) fn pipeline_ir_native_vector_data_facts_have_access(facts: PipelineIrNativeVectorDataFacts) -> i64 {
  match pipeline_ir_native_vector_data_facts_entries(facts) {
    PipelineIrNativeVectorDataFactNil -> 0
    PipelineIrNativeVectorDataFactCons(dst, vec, reload, rest) -> 1
  }
}

pub(package) fn pipeline_ir_native_vector_data_facts_assign_home(facts: PipelineIrNativeVectorDataFacts) -> PipelineIrNativeVectorDataFacts {
  if pipeline_ir_native_vector_data_facts_have_access(facts) == 1 {
    -- x9 is the first allocator-owned cache-class home. Unlike the scalar
    -- pool, lane emission never uses it as an operand/result scratch.
    PipelineIrNativeVectorDataFacts(pipeline_ir_native_vector_data_reg(), pipeline_ir_native_vector_data_facts_entries(facts))
  } else {
    facts
  }
}

pub(package) fn pipeline_ir_native_vector_data_fact_reload_for(entries: PipelineIrNativeVectorDataFactList, dst: i64, vec: i64) -> i64 {
  match entries {
    PipelineIrNativeVectorDataFactNil -> 0 - 1
    PipelineIrNativeVectorDataFactCons(fact_dst, fact_vec, reload, rest) -> {
      if fact_dst == dst {
        if fact_vec == vec { reload } else { 0 - 1 }
      } else {
        pipeline_ir_native_vector_data_fact_reload_for(rest, dst, vec)
      }
    }
  }
}

-- This is the cache-segment fact producer's clobber contract. Keep the
-- whitelist synchronized with actual instruction emission: every omitted
-- instruction begins a new segment, so facts fail closed.
pub(package) fn pipeline_ir_native_inst_preserves_vector_data_fact(inst: IrInst) -> i64 {
  match inst {
    IrConstI64(dst, value) -> 1
    IrNilI64(dst) -> 1
    IrBinaryI64(dst, op, lhs, rhs) -> 1
    IrFloatBinaryI64(dst, prim, op, lhs, rhs) -> 1
    IrUnaryI64(dst, op, value) -> 1
    IrSlotI64(slot) -> 1
    IrLoadI64(dst, slot) -> 1
    IrStoreI64(slot, value) -> 1
    IrVectorGetI64(dst, vec, index, fallback, check_mode) -> 1
    IrVectorSetI64(dst, vec, index, value, check_mode) -> 1
    IrBindI64(ns, nl, value, ty) -> 1
    IrVariantTagI64(dst, value) -> 1
    IrVariantPayloadI64(dst, value, index) -> 1
    IrFieldLoadI64(dst, base, field_hash, field_index) -> 1
    IrRecordLayoutWordLoadI64(dst, base, record_data_size, field_hash, byte_offset) -> 1
    IrResumeI64(dst, value) -> 1
    IrAbortLandingI64(dst) -> 1
    _ -> 0
  }
}

pub(package) fn pipeline_ir_native_vector_data_facts_for_insts(insts: IrInstList, cached_vec: i64, entries: PipelineIrNativeVectorDataFactList) -> PipelineIrNativeVectorDataFactList {
  match insts {
    IrInstNil -> entries
    IrInstCons(inst, rest) -> {
      match inst {
        IrVectorGetI64(dst, vec, index, fallback, check_mode) -> {
          let reload = if cached_vec == vec { 0 } else { 1 }
          pipeline_ir_native_vector_data_facts_for_insts(rest, vec, PipelineIrNativeVectorDataFactCons(dst, vec, reload, entries))
        }
        IrVectorSetI64(dst, vec, index, value, check_mode) -> {
          let reload = if cached_vec == vec { 0 } else { 1 }
          pipeline_ir_native_vector_data_facts_for_insts(rest, vec, PipelineIrNativeVectorDataFactCons(dst, vec, reload, entries))
        }
        _ -> {
          let next_cached = if pipeline_ir_native_inst_preserves_vector_data_fact(inst) == 1 { cached_vec } else { 0 - 1 }
          pipeline_ir_native_vector_data_facts_for_insts(rest, next_cached, entries)
        }
      }
    }
  }
}

pub(package) fn pipeline_ir_native_vector_data_facts_for_blocks_from(blocks: IrBlockList, entries: PipelineIrNativeVectorDataFactList) -> PipelineIrNativeVectorDataFactList {
  match blocks {
    IrBlockListNil -> entries
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          -- Cache contents are not a CFG fact: each emitted block begins a
          -- fresh segment exactly as the former emission-time env did.
          let next = pipeline_ir_native_vector_data_facts_for_insts(insts, 0 - 1, entries)
          pipeline_ir_native_vector_data_facts_for_blocks_from(rest, next)
        }
      }
    }
  }
}

pub(package) fn pipeline_ir_native_vector_data_facts_for_blocks(blocks: IrBlockList) -> PipelineIrNativeVectorDataFacts {
  let entries = pipeline_ir_native_vector_data_facts_for_blocks_from(blocks, pipeline_ir_native_vector_data_fact_list_empty())
  pipeline_ir_native_vector_data_facts_unassigned(entries)
}

pub(package) fn pipeline_ir_native_int_list_contains(list: i64, value: i64) -> i64 {
  let mut found = 0
  let n = nlist_len(list)
  let mut i = 0
  while i < n and found == 0 {
    if nlist_get(list, i) == value { found = 1 } else { i = i + 1 }
  }
  found
}

pub(package) fn pipeline_ir_native_int_list_add_unique(list: i64, value: i64) -> i64 {
  if value < 0 { 0 }
  else { if pipeline_ir_native_int_list_contains(list, value) == 1 { 0 }
  else { nlist_add(list, value) 1 } }
}

pub(package) fn pipeline_ir_native_mark_value_list(values: IrValueList, out: i64) -> i64 {
  match values {
    IrValueNil -> 0
    IrValueCons(value, rest) -> {
      pipeline_ir_native_int_list_add_unique(out, value) +
        pipeline_ir_native_mark_value_list(rest, out)
    }
  }
}

pub(package) fn pipeline_ir_native_mark_record_field_values(fields: IrRecordFieldList, out: i64) -> i64 {
  match fields {
    IrRecordFieldNil -> 0
    IrRecordFieldCons(field_hash, word_offset, value, rest) -> {
      pipeline_ir_native_int_list_add_unique(out, value) +
        pipeline_ir_native_mark_record_field_values(rest, out)
    }
  }
}

pub(package) fn pipeline_ir_native_mark_record_layout_field_values(fields: IrRecordLayoutFieldList, out: i64) -> i64 {
  match fields {
    IrRecordLayoutFieldNil -> 0
    IrRecordLayoutFieldWord(field_hash, byte_offset, value, managed_kind, rest) -> {
      pipeline_ir_native_int_list_add_unique(out, value) + pipeline_ir_native_mark_record_layout_field_values(rest, out)
    }
    IrRecordLayoutFieldArray(field_hash, byte_offset, data, byte_size, leaf_count, leaf_stride, leaf_kind, rest) -> {
      pipeline_ir_native_int_list_add_unique(out, data) + pipeline_ir_native_mark_record_layout_field_values(rest, out)
    }
  }
}

pub(package) fn pipeline_ir_native_mark_lambda_captures(captures: i64, out: i64) -> i64 {
  let mut i = 0
  let n = if captures == 0 { 0 } else { nlist_len(captures) }
  while i < n {
    let capture = nlist_get(captures, i)
    let lanes = pipeline_capture_lane_count(capture)
    for lane in 0..lanes {
      pipeline_ir_native_int_list_add_unique(out, node_f3(capture) + lane)
    }
    i = i + 1
  }
  0
}

pub(package) fn pipeline_ir_native_f64_facts(values: i64, slot_candidates: i64, gpr_values: i64, slot_homes: PipelineIrNativeF64SlotHomeList) -> PipelineIrNativeF64Facts {
  PipelineIrNativeF64Facts(values, slot_candidates, gpr_values, slot_homes)
}

pub(package) fn pipeline_ir_native_f64_facts_values(facts: PipelineIrNativeF64Facts) -> i64 {
  match facts {
    PipelineIrNativeF64Facts(values, slot_candidates, gpr_values, slot_homes) -> values
  }
}

pub(package) fn pipeline_ir_native_f64_facts_slot_candidates(facts: PipelineIrNativeF64Facts) -> i64 {
  match facts {
    PipelineIrNativeF64Facts(values, slot_candidates, gpr_values, slot_homes) -> slot_candidates
  }
}

pub(package) fn pipeline_ir_native_f64_facts_gpr_values(facts: PipelineIrNativeF64Facts) -> i64 {
  match facts {
    PipelineIrNativeF64Facts(values, slot_candidates, gpr_values, slot_homes) -> gpr_values
  }
}

pub(package) fn pipeline_ir_native_f64_facts_slot_homes(facts: PipelineIrNativeF64Facts) -> PipelineIrNativeF64SlotHomeList {
  match facts {
    PipelineIrNativeF64Facts(values, slot_candidates, gpr_values, slot_homes) -> slot_homes
  }
}

-- Constants are flavor-neutral: a const takes its flavor from each
-- consumer (an f64 use pays the fmov staging either way), and with
-- same-value const dedup one const inst can seed both an f64
-- accumulator and an integer loop variable — letting it carry or
-- receive f64-ness through stores would infect integer slots with FP
-- staging. Genuine f64 slots still infer through their non-const
-- stores (accumulator updates are float-binary results).
pub(package) fn pipeline_ir_native_f64_value_pass_inst(inst: IrInst, f64_values: i64, f64_slots: i64, const_dsts: i64) -> i64 {
  match inst {
    IrFloatBinaryI64(dst, prim, op, lhs, rhs) -> {
      if prim == PRIM_F64() {
        pipeline_ir_native_int_list_add_unique(f64_values, dst) +
          pipeline_ir_native_int_list_add_unique(f64_values, lhs) +
          pipeline_ir_native_int_list_add_unique(f64_values, rhs)
      } else { 0 }
    }
    IrCallI64(dst, callee_hash, args) -> {
      let kind = pipeline_ir_native_intrinsic_kind(callee_hash)
      if kind == 25 or kind == 26 or kind == 30 {
        pipeline_ir_native_int_list_add_unique(f64_values, dst)
      } else { if kind == 29 or kind == 31 {
        pipeline_ir_native_int_list_add_unique(f64_values, pipeline_ir_value_list_get_or(args, 0, 0 - 1))
      } else { if kind == 32 {
        pipeline_ir_native_int_list_add_unique(f64_values, dst) +
          pipeline_ir_native_int_list_add_unique(f64_values, pipeline_ir_value_list_get_or(args, 0, 0 - 1))
      } else { 0 } } }
    }
    IrStoreI64(slot, value) -> {
      if pipeline_ir_native_int_list_contains(const_dsts, value) == 1 { 0 }
      else {
        if pipeline_ir_native_int_list_contains(f64_values, value) == 1 {
          pipeline_ir_native_int_list_add_unique(f64_slots, slot)
        } else { if pipeline_ir_native_int_list_contains(f64_slots, slot) == 1 {
          pipeline_ir_native_int_list_add_unique(f64_values, value)
        } else { 0 } }
      }
    }
    IrLoadI64(dst, slot) -> {
      if pipeline_ir_native_int_list_contains(f64_slots, slot) == 1 {
        pipeline_ir_native_int_list_add_unique(f64_values, dst)
      } else { 0 }
    }
    _ -> 0
  }
}

pub(package) fn pipeline_ir_native_f64_collect_const_dsts(blocks: IrBlockList, const_dsts: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          let mut cur = insts
          let mut done = 0
          while done == 0 {
            match cur {
              IrInstNil -> { done = 1 }
              IrInstCons(inst, irest) -> {
                match inst {
                  IrConstI64(dst, value) -> pipeline_ir_native_int_list_add_unique(const_dsts, dst)
                  IrNilI64(dst) -> pipeline_ir_native_int_list_add_unique(const_dsts, dst)
                  _ -> 0
                }
                cur = irest
              }
            }
          }
        }
      }
      pipeline_ir_native_f64_collect_const_dsts(rest, const_dsts)
    }
  }
}

pub(package) fn pipeline_ir_native_f64_value_pass_insts(insts: IrInstList, f64_values: i64, f64_slots: i64, const_dsts: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      pipeline_ir_native_f64_value_pass_inst(inst, f64_values, f64_slots, const_dsts) +
        pipeline_ir_native_f64_value_pass_insts(rest, f64_values, f64_slots, const_dsts)
    }
  }
}

pub(package) fn pipeline_ir_native_f64_value_pass_blocks(blocks: IrBlockList, f64_values: i64, f64_slots: i64, const_dsts: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          pipeline_ir_native_f64_value_pass_insts(insts, f64_values, f64_slots, const_dsts) +
            pipeline_ir_native_f64_value_pass_blocks(rest, f64_values, f64_slots, const_dsts)
        }
      }
    }
  }
}

pub(package) fn pipeline_ir_native_f64_value_fixpoint(blocks: IrBlockList, f64_values: i64, f64_slots: i64, const_dsts: i64) -> i64 {
  let before = nlist_len(f64_values) + nlist_len(f64_slots)
  pipeline_ir_native_f64_value_pass_blocks(blocks, f64_values, f64_slots, const_dsts)
  let after = nlist_len(f64_values) + nlist_len(f64_slots)
  if after == before { after } else { pipeline_ir_native_f64_value_fixpoint(blocks, f64_values, f64_slots, const_dsts) }
}

pub(package) fn pipeline_ir_native_mark_structural_drop_values(value: i64, plan: i64, gpr_values: i64) -> i64 {
  let words = pipeline_structural_drop_plan_use_words(plan)
  let mut added = 0
  for lane in 0..words {
    added = added + pipeline_ir_native_int_list_add_unique(gpr_values, value + lane)
  }
  added
}

pub(package) fn pipeline_ir_native_f64_gpr_pass_inst(inst: IrInst, f64_slots: i64, gpr_values: i64) -> i64 {
  match inst {
    IrStringConcatI64(dst, left, right) -> pipeline_ir_native_int_list_add_unique(gpr_values, left) + pipeline_ir_native_int_list_add_unique(gpr_values, right)
    IrBinaryI64(dst, op, lhs, rhs) -> pipeline_ir_native_int_list_add_unique(gpr_values, lhs) + pipeline_ir_native_int_list_add_unique(gpr_values, rhs)
    IrUnaryI64(dst, op, value) -> pipeline_ir_native_int_list_add_unique(gpr_values, value)
    IrAddressOfSlotI64(dst, slot) -> 0
    IrPtrLoadI64(dst, ptr) -> pipeline_ir_native_int_list_add_unique(gpr_values, ptr)
    IrPtrStoreI64(dst, ptr, value) -> pipeline_ir_native_int_list_add_unique(gpr_values, ptr) + pipeline_ir_native_int_list_add_unique(gpr_values, value)
    IrCallI64(dst, callee_hash, args) -> pipeline_ir_native_mark_value_list(args, gpr_values)
    IrManagedStakeI64(dst, value, cleanup_kind, delta, origin) -> pipeline_ir_native_int_list_add_unique(gpr_values, value)
    IrManagedTransferI64(call_dst, callee_hash, value, arg_lane, cleanup_kind) -> pipeline_ir_native_int_list_add_unique(gpr_values, value)
    IrIndirectCallI64(dst, callee, args, result_ty) -> pipeline_ir_native_int_list_add_unique(gpr_values, callee) + pipeline_ir_native_mark_value_list(args, gpr_values)
    IrGenericCallI64(dst, callee_hash, type_args, args) -> pipeline_ir_native_mark_value_list(args, gpr_values)
    IrVectorGetI64(dst, vec, index, fallback, check_mode) -> pipeline_ir_native_int_list_add_unique(gpr_values, vec) + pipeline_ir_native_int_list_add_unique(gpr_values, index) + pipeline_ir_native_int_list_add_unique(gpr_values, fallback)
    IrVectorSetI64(dst, vec, index, value, check_mode) -> pipeline_ir_native_int_list_add_unique(gpr_values, vec) + pipeline_ir_native_int_list_add_unique(gpr_values, index) + pipeline_ir_native_int_list_add_unique(gpr_values, value)
    IrMethodCallI64(dst, type_hash, method_hash, receiver, args) -> pipeline_ir_native_int_list_add_unique(gpr_values, receiver) + pipeline_ir_native_mark_value_list(args, gpr_values)
    IrOwnedDropI64(value, type_hash) -> pipeline_ir_native_int_list_add_unique(gpr_values, value)
    IrStructuralDropI64(value, plan) -> pipeline_ir_native_mark_structural_drop_values(value, plan, gpr_values)
    IrStructuralSlotI64(value, slot, plan, mode) -> {
      if mode == 2 {
        pipeline_ir_native_mark_structural_drop_values(value, plan, gpr_values) +
          pipeline_ir_native_mark_structural_drop_values(slot, plan, gpr_values)
      } else { if mode == 4 or mode == 5 {
        -- Slot Drop and opaque-rewrap acquisition both materialise the
        -- flattened value through native cleanup emission. The marker has no
        -- explicit IR operand list, so preserve those hidden lane reads here.
        pipeline_ir_native_mark_structural_drop_values(value, plan, gpr_values)
      } else { 0 } }
    }
    IrStructuralSplitI64(value, parent_plan, residual_plan, release_backing) -> pipeline_ir_native_mark_structural_drop_values(value, parent_plan, gpr_values)
    IrArrayCopyI64(dst_data, src_data, byte_size, leaf_count, leaf_stride, leaf_kind) -> pipeline_ir_native_int_list_add_unique(gpr_values, dst_data) + pipeline_ir_native_int_list_add_unique(gpr_values, src_data)
    IrArrayDropI64(data, leaf_count, leaf_stride, leaf_kind) -> pipeline_ir_native_int_list_add_unique(gpr_values, data)
    IrVariantInitI64(dst, tag_hash, args, field_mask) -> pipeline_ir_native_mark_value_list(args, gpr_values)
    IrVariantTagI64(dst, value) -> pipeline_ir_native_int_list_add_unique(gpr_values, value)
    IrVariantPayloadI64(dst, value, index) -> pipeline_ir_native_int_list_add_unique(gpr_values, value)
    IrRecordInitI64(dst, type_hash, fields) -> pipeline_ir_native_mark_record_field_values(fields, gpr_values)
    IrRecordLayoutInitI64(dst, type_hash, data_size, align, fields) -> pipeline_ir_native_mark_record_layout_field_values(fields, gpr_values)
    IrReuseInitI64(token, constructor) -> pipeline_ir_native_int_list_add_unique(gpr_values, token) + pipeline_ir_native_f64_gpr_pass_inst(constructor, f64_slots, gpr_values)
    IrRecordLayoutArrayLoadI64(dst_data, base, record_data_size, byte_offset, byte_size, leaf_count, leaf_stride, leaf_kind) -> pipeline_ir_native_int_list_add_unique(gpr_values, dst_data) + pipeline_ir_native_int_list_add_unique(gpr_values, base)
    IrRecordLayoutWordLoadI64(dst, base, record_data_size, field_hash, byte_offset) -> pipeline_ir_native_int_list_add_unique(gpr_values, base)
    IrFieldLoadI64(dst, base, field_hash, field_index) -> pipeline_ir_native_int_list_add_unique(gpr_values, base)
    IrResumeI64(dst, value) -> pipeline_ir_native_int_list_add_unique(gpr_values, value)
    IrTryI64(dst, value, effect_key, error_lanes) -> pipeline_ir_native_int_list_add_unique(gpr_values, value)
    IrTryLinearI64(dst, value, effect_key, parent_plan, ok_plan, error_plan) -> pipeline_ir_native_int_list_add_unique(gpr_values, value)
    IrOptChainI64(dst, base, field_hash, field_index, effect_key) -> pipeline_ir_native_int_list_add_unique(gpr_values, base)
    IrClosureI64(dst, f, captures, eff) -> pipeline_ir_native_mark_lambda_captures(captures, gpr_values)
    IrFunctionRefI64(dst, callee_hash) -> 0
    IrGenericFunctionRefI64(dst, callee_hash, type_args) -> 0
    IrStoreI64(slot, value) -> {
      if pipeline_ir_native_int_list_contains(f64_slots, slot) == 1 { 0 }
      else { pipeline_ir_native_int_list_add_unique(gpr_values, value) }
    }
    _ -> 0
  }
}

pub(package) fn pipeline_ir_native_f64_gpr_pass_insts(insts: IrInstList, f64_slots: i64, gpr_values: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      pipeline_ir_native_f64_gpr_pass_inst(inst, f64_slots, gpr_values) +
        pipeline_ir_native_f64_gpr_pass_insts(rest, f64_slots, gpr_values)
    }
  }
}

pub(package) fn pipeline_ir_native_f64_gpr_pass_term(term: IrTerminator, gpr_values: i64) -> i64 {
  match term {
    IrTermReturn(value) -> pipeline_ir_native_int_list_add_unique(gpr_values, value)
    IrTermJump(target, args) -> pipeline_ir_native_mark_value_list(args, gpr_values)
    IrTermBranch(cond, then_block, else_block) -> pipeline_ir_native_int_list_add_unique(gpr_values, cond)
    _ -> 0
  }
}

pub(package) fn pipeline_ir_native_f64_gpr_pass_blocks(blocks: IrBlockList, f64_slots: i64, gpr_values: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          pipeline_ir_native_f64_gpr_pass_insts(insts, f64_slots, gpr_values) +
            pipeline_ir_native_f64_gpr_pass_term(term, gpr_values) +
            pipeline_ir_native_f64_gpr_pass_blocks(rest, f64_slots, gpr_values)
        }
      }
    }
  }
}

pub(package) fn pipeline_ir_native_f64_facts_for_blocks(blocks: IrBlockList) -> PipelineIrNativeF64Facts {
  let values = nlist_new()
  let slots = nlist_new()
  let const_dsts = nlist_new()
  pipeline_ir_native_f64_collect_const_dsts(blocks, const_dsts)
  pipeline_ir_native_f64_value_fixpoint(blocks, values, slots, const_dsts)
  let gpr_values = nlist_new()
  pipeline_ir_native_f64_gpr_pass_blocks(blocks, slots, gpr_values)
  pipeline_ir_native_f64_facts(values, slots, gpr_values, PipelineIrNativeF64SlotHomeNil)
}

pub(package) fn pipeline_ir_native_f64_slot_max_count() -> i64 { 8 }

pub(package) fn pipeline_ir_native_f64_slot_phys_for_index(index: i64) -> i64 {
  let phys = cg_preserved_f64_fp_min() + index
  if phys <= cg_preserved_f64_fp_max() { phys } else { 0 - 1 }
}

pub(package) fn pipeline_ir_native_f64_slot_home_lookup_list(homes: PipelineIrNativeF64SlotHomeList, slot: i64) -> i64 {
  match homes {
    PipelineIrNativeF64SlotHomeNil -> 0 - 1
    PipelineIrNativeF64SlotHomeCons(fact_slot, fd, rest) -> {
      if fact_slot == slot { fd } else { pipeline_ir_native_f64_slot_home_lookup_list(rest, slot) }
    }
  }
}

pub(package) fn pipeline_ir_native_f64_slot_home_lookup(facts: PipelineIrNativeF64Facts, slot: i64) -> i64 {
  pipeline_ir_native_f64_slot_home_lookup_list(pipeline_ir_native_f64_facts_slot_homes(facts), slot)
}

pub(package) fn pipeline_ir_native_f64_slot_home_count_list(homes: PipelineIrNativeF64SlotHomeList) -> i64 {
  match homes {
    PipelineIrNativeF64SlotHomeNil -> 0
    PipelineIrNativeF64SlotHomeCons(slot, fd, rest) -> 1 + pipeline_ir_native_f64_slot_home_count_list(rest)
  }
}

pub(package) fn pipeline_ir_native_f64_slot_home_count(facts: PipelineIrNativeF64Facts) -> i64 {
  pipeline_ir_native_f64_slot_home_count_list(pipeline_ir_native_f64_facts_slot_homes(facts))
}

pub(package) fn pipeline_ir_native_f64_slot_home_add(homes: PipelineIrNativeF64SlotHomeList, slot: i64) -> PipelineIrNativeF64SlotHomeList {
  if pipeline_ir_native_f64_slot_home_lookup_list(homes, slot) >= 0 { homes }
  else {
    let count = pipeline_ir_native_f64_slot_home_count_list(homes)
    if count >= pipeline_ir_native_f64_slot_max_count() { homes }
    else {
      let fd = pipeline_ir_native_f64_slot_phys_for_index(count)
      if fd < 0 { homes } else { PipelineIrNativeF64SlotHomeCons(slot, fd, homes) }
    }
  }
}

pub(package) fn pipeline_ir_native_f64_assign_slot_homes_inner(blocks: IrBlockList, candidates: i64, index: i64, homes: PipelineIrNativeF64SlotHomeList) -> PipelineIrNativeF64SlotHomeList {
  let n = nlist_len(candidates)
  if index >= n { homes }
  else {
    let slot = nlist_get(candidates, index)
    let next_homes = if pipeline_ir_native_blocks_take_slot_address(blocks, slot) == 0 and
      pipeline_ir_native_blocks_load_slot(blocks, slot) == 1 and
      pipeline_ir_native_blocks_store_slot(blocks, slot) == 1 {
      pipeline_ir_native_f64_slot_home_add(homes, slot)
    } else { homes }
    pipeline_ir_native_f64_assign_slot_homes_inner(blocks, candidates, index + 1, next_homes)
  }
}

pub(package) fn pipeline_ir_native_f64_facts_assign_slot_homes(blocks: IrBlockList, facts: PipelineIrNativeF64Facts) -> PipelineIrNativeF64Facts {
  let candidates = pipeline_ir_native_f64_facts_slot_candidates(facts)
  let homes = pipeline_ir_native_f64_assign_slot_homes_inner(blocks, candidates, 0, PipelineIrNativeF64SlotHomeNil)
  pipeline_ir_native_f64_facts(pipeline_ir_native_f64_facts_values(facts), candidates, pipeline_ir_native_f64_facts_gpr_values(facts), homes)
}

pub(package) fn pipeline_ir_native_fp_env_lookup(env: PipelineIrNativeFpEnv, value: i64, prim: i64) -> i64 {
  match env {
    PipelineIrNativeFpEnvNil -> 0 - 1
    PipelineIrNativeFpEnvCons(entry_value, entry_prim, entry_fd, rest) -> {
      if entry_value == value and entry_prim == prim { entry_fd }
      else { pipeline_ir_native_fp_env_lookup(rest, value, prim) }
    }
  }
}

pub(package) fn pipeline_ir_native_float_result_env(dst: i64, prim: i64, op: IrBinaryOp) -> PipelineIrNativeFpEnv {
  match op {
    IrAdd -> pipeline_ir_native_fp_env_single(dst, prim, 0)
    IrSub -> pipeline_ir_native_fp_env_single(dst, prim, 0)
    IrMul -> pipeline_ir_native_fp_env_single(dst, prim, 0)
    IrDiv -> pipeline_ir_native_fp_env_single(dst, prim, 0)
    _ -> pipeline_ir_native_fp_env_empty()
  }
}

pub(package) fn pipeline_ir_native_emit_f64_to(code: i64, dst_fd: i64, pinned: PipelineIrNativeValueHomeFacts, fp_env: PipelineIrNativeFpEnv, value: i64) -> i64 {
  let res_fd = pipeline_ir_native_fp_resident_fd(pinned, value)
  if res_fd != 0 {
    if res_fd == dst_fd { 0 } else { bu32(code, encode_fmov_d_from_d(dst_fd, res_fd)) }
  } else {
    let found = pipeline_ir_native_fp_env_lookup(fp_env, value, PRIM_F64())
    if found >= 0 {
      if found == dst_fd { 0 } else { bu32(code, encode_fmov_d_from_d(dst_fd, found)) }
    } else {
      let lp = pipeline_ir_native_load_reg(code, pinned, value)
      bu32(code, encode_fmov_d_from_x(dst_fd, lp))
    }
  }
}

pub(package) fn pipeline_ir_native_emit_f32_to(code: i64, dst_fd: i64, pinned: PipelineIrNativeValueHomeFacts, fp_env: PipelineIrNativeFpEnv, value: i64) -> i64 {
  let found = pipeline_ir_native_fp_env_lookup(fp_env, value, PRIM_F32())
  if found >= 0 {
    if found == dst_fd { 0 } else { bu32(code, encode_fmov_s_from_s(dst_fd, found)) }
  } else {
    let lp = pipeline_ir_native_load_reg(code, pinned, value)
    bu32(code, encode_fmov_s_from_w(dst_fd, lp))
  }
}

pub(package) fn pipeline_ir_native_record_float_result(code: i64, dst: i64, prim: i64, op: IrBinaryOp, fp_env: PipelineIrNativeFpEnv) -> PipelineIrNativeFpEnv {
  pipeline_ir_native_float_result_env(dst, prim, op)
}

pub(package) fn pipeline_ir_native_emit_stack_slot_addr(code: i64, dst_phys: i64, slot: i64) -> i64 {
  if slot < 8 {
    bu32(code, encode_brk(19))
  } else {
    let byte_off = (slot - 8) * 8
    if byte_off <= 4095 {
      bu32(code, encode_add_imm(dst_phys, 31, byte_off))
    } else {
      emit_mov_imm_safe(code, dst_phys, byte_off)
      bu32(code, encode_add_reg(dst_phys, 31, dst_phys))
    }
  }
}

pub(package) fn pipeline_ir_native_emit_address_of_slot(code: i64, dst: i64, slot: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  pipeline_ir_native_emit_stack_slot_addr(code, 17, slot)
  pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17)
  fmap_inc_typed_address_of_emit_count(fm)
}

pub(package) fn pipeline_ir_native_emit_ptr_load(code: i64, dst: i64, ptr: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let ptr_phys = pipeline_ir_native_load_reg(code, pinned, ptr)
  bu32(code, cg_ldr(17, ptr_phys, 0))
  pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17)
  fmap_inc_typed_deref_emit_count(fm)
}

pub(package) fn pipeline_ir_native_emit_ptr_store(code: i64, dst: i64, ptr: i64, value: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let value_phys = pipeline_ir_native_load_reg(code, pinned, value)
  if value_phys == 17 { 0 } else { bu32(code, encode_add_imm(17, value_phys, 0)) }
  let ptr_phys = pipeline_ir_native_load_reg(code, pinned, ptr)
  bu32(code, cg_str(17, ptr_phys, 0))
  emit_mov_imm_safe(code, 17, 0)
  pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17)
  fmap_inc_typed_ptr_assign_emit_count(fm)
}

-- Direct destination register for a result: the assigned physical home or
-- x17 for spill/discard homes (which then go through the store/forward
-- path). Result-producing single-destination
-- sequences may write their home directly and skip the x17 bounce; the
-- destination never aliases an operand source because SSA destinations are
-- fresh and operand loads use x16/x17/pinned regs, not unwritten bank homes.
pub(package) fn pipeline_ir_native_result_reg(dst: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let pinned_phys = pipeline_ir_native_value_home_lookup(pinned, dst)
  if pinned_phys >= 1000 { 17 }
  else { if pinned_phys < 0 { 17 }
  else { if pinned_phys == pipeline_ir_native_discard_home() { 17 }
  else { if pinned_phys != 0 { pinned_phys } else { 17 } } } }
}

pub(package) fn pipeline_ir_native_emit_const(code: i64, dst: i64, value: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  -- A remat-homed constant emits nothing at its def: every use
  -- re-materializes it and the home is never read.
  if dst >= 0 and pipeline_ir_native_value_home_lookup(pinned, dst) >= pipeline_ir_native_remat_base() { 0 }
  else {
    let rd = pipeline_ir_native_result_reg(dst, pinned)
    emit_mov_imm_safe(code, rd, value)
    if rd == 17 {
      if dst >= 0 { pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17) } else { 0 }
    } else { pipeline_ir_native_ck_def(code, pinned, rd, dst) }
  }
}

pub(package) fn pipeline_ir_native_emit_binary(code: i64, dst: i64, op: IrBinaryOp, lhs: i64, rhs: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  -- Capture the forward before any operand load emits code. The spill loads
  -- use x16 for lhs, so a value forwarded in x17 survives the other
  -- operand's load regardless of which side it feeds.
  let fwd_l = pipeline_ir_native_forward_hit(pinned, code, lhs)
  let fwd_r = if fwd_l != 0 { 0 } else { pipeline_ir_native_forward_hit(pinned, code, rhs) }
  let lp = if fwd_l != 0 { fwd_l } else { pipeline_ir_native_load_reg(code, pinned, lhs) }
  let rp = if fwd_r != 0 { fwd_r } else { if fwd_l != 0 and rhs == lhs { fwd_l } else { if fwd_l != 0 { pipeline_ir_native_load_reg(code, pinned, rhs) } else { pipeline_ir_native_load_rhs(code, pinned, rhs) } } }
  let rd = pipeline_ir_native_result_reg(dst, pinned)
  cg_binop_emit(code, ir_binary_op_tag(op), rd, lp, rp)
  if rd == 17 { pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17) } else { pipeline_ir_native_ck_def(code, pinned, rd, dst) }
}

pub(package) fn pipeline_ir_binary_op_result_is_operand_width(op: IrBinaryOp) -> i64 {
  match op {
    IrAdd -> 1
    IrSub -> 1
    IrMul -> 1
    IrDiv -> 1
    IrMod -> 1
    IrBand -> 1
    IrBor -> 1
    IrBxor -> 1
    IrBshl -> 1
    IrBshr -> 1
    _ -> 0
  }
}

pub(package) fn pipeline_ir_native_emit_int_binary(code: i64, dst: i64, prim: i64, op: IrBinaryOp, lhs: i64, rhs: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let lp = pipeline_ir_native_load_reg(code, pinned, lhs)
  let rp = pipeline_ir_native_load_rhs(code, pinned, rhs)
  let unsigned = prim_is_unsigned_integer(prim)
  let rd = pipeline_ir_native_result_reg(dst, pinned)
  cg_binop_emit_typed(code, ir_binary_op_tag(op), rd, lp, rp, unsigned)
  if pipeline_ir_binary_op_result_is_operand_width(op) == 1 {
    cg_emit_int_normalize(code, prim, rd)
  } else {
    0
  }
  if rd == 17 { pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17) } else { pipeline_ir_native_ck_def(code, pinned, rd, dst) }
}

pub(package) fn pipeline_ir_native_emit_float_binary(code: i64, dst: i64, prim: i64, op: IrBinaryOp, lhs: i64, rhs: i64, pinned: PipelineIrNativeValueHomeFacts, fp_env: PipelineIrNativeFpEnv) -> PipelineIrNativeFpEnv {
  let op_tag = ir_binary_op_tag(op)
  if prim_is_integer(prim) == 1 {
    pipeline_ir_native_emit_int_binary(code, dst, prim, op, lhs, rhs, pinned)
    fp_env
  } else { if prim == PRIM_F32() {
    pipeline_ir_native_emit_f32_to(code, 1, pinned, fp_env, rhs)
    pipeline_ir_native_emit_f32_to(code, 0, pinned, fp_env, lhs)
    match op {
      IrAdd -> {
        bu32(code, encode_fadd_s(0, 0, 1))
        bu32(code, encode_fmov_w_from_s(17, 0))
        pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17)
        pipeline_ir_native_record_float_result(code, dst, prim, op, fp_env)
      }
      IrSub -> {
        bu32(code, encode_fsub_s(0, 0, 1))
        bu32(code, encode_fmov_w_from_s(17, 0))
        pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17)
        pipeline_ir_native_record_float_result(code, dst, prim, op, fp_env)
      }
      IrMul -> {
        bu32(code, encode_fmul_s(0, 0, 1))
        bu32(code, encode_fmov_w_from_s(17, 0))
        pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17)
        pipeline_ir_native_record_float_result(code, dst, prim, op, fp_env)
      }
      IrDiv -> {
        bu32(code, encode_fdiv_s(0, 0, 1))
        bu32(code, encode_fmov_w_from_s(17, 0))
        pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17)
        pipeline_ir_native_record_float_result(code, dst, prim, op, fp_env)
      }
      _ -> {
        bu32(code, encode_fcmp_s(0, 1))
        bu32(code, encode_cset(17, cg_cmp_cond_for_op(op_tag, 0)))
        pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17)
        pipeline_ir_native_record_float_result(code, dst, prim, op, fp_env)
      }
    }
  } else {
    -- FP-resident operands are read from their pool register directly;
    -- non-resident operands stage through d0/d1 as before. An FP-resident
    -- destination takes the arithmetic result in its pool register with no
    -- fmov/store tail, and the d0 reuse env is dropped because operand
    -- staging may have clobbered d0.
    let lhs_fd = pipeline_ir_native_fp_resident_fd(pinned, lhs)
    let rhs_fd = pipeline_ir_native_fp_resident_fd(pinned, rhs)
    if rhs_fd == 0 { pipeline_ir_native_emit_f64_to(code, 1, pinned, fp_env, rhs) } else { 0 }
    if lhs_fd == 0 { pipeline_ir_native_emit_f64_to(code, 0, pinned, fp_env, lhs) } else { 0 }
    let rn = if lhs_fd != 0 { lhs_fd } else { 0 }
    let rm = if rhs_fd != 0 { rhs_fd } else { 1 }
    let dst_fd = pipeline_ir_native_fp_resident_fd(pinned, dst)
    match op {
      IrAdd -> {
        if dst_fd != 0 {
          bu32(code, encode_fadd_d(dst_fd, rn, rm))
          pipeline_ir_native_fp_env_empty()
        } else {
          bu32(code, encode_fadd_d(0, rn, rm))
          bu32(code, encode_fmov_x_from_d(17, 0))
          pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17)
          pipeline_ir_native_record_float_result(code, dst, prim, op, fp_env)
        }
      }
      IrSub -> {
        if dst_fd != 0 {
          bu32(code, encode_fsub_d(dst_fd, rn, rm))
          pipeline_ir_native_fp_env_empty()
        } else {
          bu32(code, encode_fsub_d(0, rn, rm))
          bu32(code, encode_fmov_x_from_d(17, 0))
          pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17)
          pipeline_ir_native_record_float_result(code, dst, prim, op, fp_env)
        }
      }
      IrMul -> {
        if dst_fd != 0 {
          bu32(code, encode_fmul_d(dst_fd, rn, rm))
          pipeline_ir_native_fp_env_empty()
        } else {
          bu32(code, encode_fmul_d(0, rn, rm))
          bu32(code, encode_fmov_x_from_d(17, 0))
          pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17)
          pipeline_ir_native_record_float_result(code, dst, prim, op, fp_env)
        }
      }
      IrDiv -> {
        if dst_fd != 0 {
          bu32(code, encode_fdiv_d(dst_fd, rn, rm))
          pipeline_ir_native_fp_env_empty()
        } else {
          bu32(code, encode_fdiv_d(0, rn, rm))
          bu32(code, encode_fmov_x_from_d(17, 0))
          pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17)
          pipeline_ir_native_record_float_result(code, dst, prim, op, fp_env)
        }
      }
      _ -> {
        bu32(code, encode_fcmp_d(rn, rm))
        bu32(code, encode_cset(17, cg_cmp_cond_for_op(op_tag, 0)))
        pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17)
        pipeline_ir_native_record_float_result(code, dst, prim, op, fp_env)
      }
    }
  } }
}

pub(package) fn pipeline_ir_native_emit_unary(code: i64, dst: i64, op: IrUnaryOp, value: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let vp = pipeline_ir_native_load_reg(code, pinned, value)
  match op {
    IrNot -> {
      let rd = pipeline_ir_native_result_reg(dst, pinned)
      bu32(code, encode_cmp(vp, 31))
      bu32(code, encode_cset(rd, 0))
      if rd == 17 { pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17) } else { pipeline_ir_native_ck_def(code, pinned, rd, dst) }
    }
    _ -> 0
  }
}

pub(package) fn pipeline_ir_native_handler_ctx_len(ctx: PipelineNativeHandlerCtx) -> i64 {
  match ctx {
    PipelineNativeHandlerCtxNil -> 0
    PipelineNativeHandlerCtxCons(eff_hash, infos, nclauses, ops_ctr, frame_ctr, is_abortive, rest) -> 1 + pipeline_ir_native_handler_ctx_len(rest)
  }
}

pub(package) fn pipeline_ir_native_handler_ctx_at(ctx: PipelineNativeHandlerCtx, depth: i64) -> PipelineNativeHandlerCtx {
  match ctx {
    PipelineNativeHandlerCtxNil -> PipelineNativeHandlerCtxNil
    PipelineNativeHandlerCtxCons(eff_hash, infos, nclauses, ops_ctr, frame_ctr, is_abortive, rest) -> {
      if depth <= 0 { ctx } else { pipeline_ir_native_handler_ctx_at(rest, depth - 1) }
    }
  }
}

pub(package) fn pipeline_ir_native_hclause_infos_uncaptured(infos: i64, nclauses: i64) -> i64 {
  let mut ok = 1
  let mut i = 0
  while i < nclauses {
    let info = pipeline_word_array_get(infos, i)
    if pipeline_hclause_info_nfree(info) != 0 {
      ok = 0
      i = nclauses
    } else {
      i = i + 1
    }
  }
  ok
}

pub(package) fn pipeline_ir_native_handler_ctx_out_of_line() -> PipelineNativeHandlerCtx {
  -- Handler clauses and deferred bodies are independent native functions.
  -- Even a capture-free enclosing handler keeps its ops/frame identities in
  -- the caller's SSA homes, which have no meaning in the synthetic callee.
  -- Its dynamic handler/deferred chain is the only valid cross-function
  -- representation; an effect in out-of-line code must dispatch through it.
  PipelineNativeHandlerCtxNil
}

-- ======================================================================
-- abort-cleanup descriptors: abort-cleanup descriptor facts and stack-resident shadow chain
-- ======================================================================
--
-- The managed continuation descriptor vocabulary establishes the cleanup kinds,
-- but one captured segment cannot describe an ordinary dynamic call chain.
-- Tier-2 abort therefore uses a dedicated walk structure: one 24-byte record
-- per IR binding that owns an eventual release/Drop, stored in that native
-- function's stack frame. Records link only while an abortive handler is
-- active. Ordinary cleanup disarms the exact record; abort pops records and
-- calls their stored cleanup pointers until the handle-entry boundary.
--
-- Fact node fields: acquisition-site SSA, owned value SSA, action (release
-- hash or owned type hash), kind (1 direct cleanup call / 2 owned Drop /
-- 3 array drop glue / 4 structural-plan glue), record index. Flat structural
-- facts additionally own a frame-resident word shadow derived from their
-- exact registered plan. The site is the unique result SSA of the instruction
-- that acquires the obligation; this keeps two retains of the same pointer as
-- two records.
pub(package) fn pipeline_ir_abort_cleanup_direct_kind() -> i64 { 1 }
pub(package) fn pipeline_ir_abort_cleanup_owned_kind() -> i64 { 2 }
pub(package) fn pipeline_ir_abort_cleanup_array_kind() -> i64 { 3 }
pub(package) fn pipeline_ir_abort_cleanup_structural_kind() -> i64 { 4 }
-- Alias facts do not own records. They map an SSA loaded from a mutable
-- linear slot back to that slot's canonical cleanup-record index.
pub(package) fn pipeline_ir_abort_cleanup_slot_alias_kind() -> i64 { 5 }
-- A control-flow alias maps a merge SSA to every exact acquisition record
-- that can reach it. Only one predecessor is live at runtime; emission tries
-- the finite typed alternatives by record address and never matches resource
-- representation bits.
pub(package) fn pipeline_ir_abort_cleanup_flow_alias_kind() -> i64 { 6 }

pub(package) fn pipeline_ir_abort_cleanup_plan_owning_kind(plan: i64) -> i64 {
  if pipeline_linear_cleanup_plan_uses_structural_glue(plan) == 0 {
    pipeline_ir_abort_cleanup_owned_kind()
  } else { pipeline_ir_abort_cleanup_structural_kind() }
}

pub(package) fn pipeline_ir_abort_cleanup_plan_action(plan: i64) -> i64 {
  if pipeline_linear_cleanup_plan_uses_structural_glue(plan) == 0 {
    cg_owned_drop_type_hash(typeck_linear_layout_plan_type(plan))
  } else { pipeline_structural_drop_glue_hash(plan) }
}

pub(package) fn pipeline_ir_structural_drop_register_plan(plan: i64, fm: i64) -> i64 {
  if plan != 0 and pipeline_linear_cleanup_plan_uses_structural_glue(plan) == 1 {
    let registered = fmap_structural_drop_plan_register(fm, pipeline_structural_drop_glue_hash(plan), plan)
    if registered < 0 { fmap_inc_emit_error_count(fm) } else { 0 }
  } else { 0 }
}

pub(package) fn pipeline_ir_structural_drop_register_inst(inst: IrInst, fm: i64, fns: i64) -> i64 {
  match inst {
    IrStructuralDropI64(value, plan) -> pipeline_ir_structural_drop_register_plan(plan, fm)
    IrStructuralSlotI64(value, slot, plan, mode) -> pipeline_ir_structural_drop_register_plan(plan, fm)
    IrStructuralSplitI64(value, parent_plan, residual_plan, release_backing) -> {
      pipeline_ir_structural_drop_register_plan(parent_plan, fm)
      pipeline_ir_structural_drop_register_plan(residual_plan, fm)
    }
    IrTryLinearI64(dst, value, effect_key, parent_plan, ok_plan, error_plan) -> {
      pipeline_ir_structural_drop_register_plan(parent_plan, fm)
      pipeline_ir_structural_drop_register_plan(ok_plan, fm)
      pipeline_ir_structural_drop_register_plan(error_plan, fm)
    }
    IrBindI64(ns, nl, value, ty) -> {
      -- A referenced linear binding may transfer its whole value and therefore
      -- has no eventual IrStructuralDropI64. Its typed bind is still the
      -- authoritative substituted layout fact for abort protection.
      pipeline_ir_structural_drop_register_plan(pipeline_linear_cleanup_plan(fmap_get_tt(fm), ty), fm)
    }
    IrCallI64(dst, callee_hash, args) -> {
      pipeline_ir_structural_drop_register_plan(
        pipeline_linear_cleanup_plan(fmap_get_tt(fm), pipeline_fns_lookup_ret_type_node_by_hash(fns, callee_hash, 0)), fm
      )
    }
    IrGenericCallI64(dst, callee_hash, type_args, args) -> {
      pipeline_ir_structural_drop_register_plan(
        pipeline_linear_cleanup_plan(fmap_get_tt(fm), pipeline_ir_abort_cleanup_generic_ret_type(callee_hash, type_args, fns)), fm
      )
    }
    IrIndirectCallI64(dst, callee, args, result_ty) -> {
      pipeline_ir_structural_drop_register_plan(
        pipeline_linear_cleanup_plan(fmap_get_tt(fm), type_expr_to_node(result_ty)), fm
      )
    }
    IrReuseInitI64(token, constructor) -> pipeline_ir_structural_drop_register_inst(constructor, fm, fns)
    _ -> 0
  }
}

pub(package) fn pipeline_ir_structural_drop_register_inst_list(insts: IrInstList, fm: i64, fns: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      pipeline_ir_structural_drop_register_inst(inst, fm, fns)
      pipeline_ir_structural_drop_register_inst_list(rest, fm, fns)
    }
  }
}

pub(package) fn pipeline_ir_structural_drop_register_blocks(blocks: IrBlockList, fm: i64, fns: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> pipeline_ir_structural_drop_register_inst_list(insts, fm, fns)
      }
      pipeline_ir_structural_drop_register_blocks(rest, fm, fns)
    }
  }
}

-- A typed owned bind is itself an ownership-acquisition event. Most values
-- also have an SSA-defining instruction, but zero-cost nominal wrappers and
-- parameter moves deliberately do not. The lexical name offset distinguishes
-- nested zero-cost wrappers which intentionally share one SSA base: each bind
-- must arm only its own record so the outer aggregate can consume the inner
-- child before taking ownership. Source offsets and SSA ids are both bounded
-- below 2^32 by the frontend/native ABI; the disjoint negative range cannot
-- collide with ordinary SSA or mutable-slot acquisition sites.
pub(package) fn pipeline_ir_abort_cleanup_owned_bind_site(value: i64, ns: i64) -> i64 {
  0 - 3000000001 - (ns + 1) * 4294967296 - value
}

-- Rewrap acquisition is a compiler-owned pseudo-site, disjoint from ordinary
-- SSA definitions, mutable slots, and source-keyed lexical binds. Nested
-- wrappers may share the site and value; their typed actions remain distinct.
pub(package) fn pipeline_ir_abort_cleanup_rewrap_site(value: i64) -> i64 {
  0 - 900000000000000001 - value
}

pub(package) fn pipeline_ir_abort_cleanup_inst_has_action(inst: IrInst, value: i64, action: i64, kind: i64) -> i64 {
  match inst {
    IrCallI64(dst, callee_hash, args) -> {
      if kind == pipeline_ir_abort_cleanup_direct_kind() and callee_hash == action and pipeline_ir_value_list_get_or(args, 0, 0 - 1) == value { 1 } else { 0 }
    }
    IrManagedStakeI64(dst, stake_value, cleanup_kind, delta, origin) -> {
      if kind == pipeline_ir_abort_cleanup_direct_kind() and delta == 0 - 1 and stake_value == value and pipeline_managed_release_hash_for_kind(cleanup_kind) == action { 1 } else { 0 }
    }
    IrManagedTransferI64(call_dst, callee_hash, transfer_value, arg_lane, cleanup_kind) -> {
      if kind == pipeline_ir_abort_cleanup_direct_kind() and transfer_value == value and pipeline_managed_release_hash_for_kind(cleanup_kind) == action { 1 } else { 0 }
    }
    IrOwnedDropI64(drop_value, type_hash) -> {
      if kind == pipeline_ir_abort_cleanup_owned_kind() and drop_value == value and type_hash == action { 1 } else { 0 }
    }
    IrStructuralDropI64(drop_value, plan) -> {
      if kind == pipeline_ir_abort_cleanup_plan_owning_kind(plan) and drop_value == value and
        pipeline_ir_abort_cleanup_plan_action(plan) == action { 1 } else { 0 }
    }
    IrStructuralSplitI64(split_value, parent_plan, residual_plan, release_backing) -> {
      if kind == pipeline_ir_abort_cleanup_plan_owning_kind(parent_plan) and split_value == value and
        pipeline_ir_abort_cleanup_plan_action(parent_plan) == action { 1 } else { 0 }
    }
    IrTryLinearI64(dst, try_value, effect_key, parent_plan, ok_plan, error_plan) -> {
      if kind == pipeline_ir_abort_cleanup_plan_owning_kind(parent_plan) and try_value == value and
        pipeline_ir_abort_cleanup_plan_action(parent_plan) == action { 1 } else { 0 }
    }
    IrArrayDropI64(data, leaf_count, leaf_stride, leaf_kind) -> {
      if kind == pipeline_ir_abort_cleanup_array_kind() and data == value and
        pipeline_array_drop_glue_hash(leaf_count, leaf_stride, leaf_kind) == action { 1 } else { 0 }
    }
    _ -> 0
  }
}

pub(package) fn pipeline_ir_abort_cleanup_inst_list_has_action(insts: IrInstList, value: i64, action: i64, kind: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      if pipeline_ir_abort_cleanup_inst_has_action(inst, value, action, kind) == 1 { 1 }
      else { pipeline_ir_abort_cleanup_inst_list_has_action(rest, value, action, kind) }
    }
  }
}

pub(package) fn pipeline_ir_abort_cleanup_blocks_have_action(blocks: IrBlockList, value: i64, action: i64, kind: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> {
          if pipeline_ir_abort_cleanup_inst_list_has_action(insts, value, action, kind) == 1 { 1 }
          else { pipeline_ir_abort_cleanup_blocks_have_action(rest, value, action, kind) }
        }
      }
    }
  }
}

pub(package) fn pipeline_ir_abort_cleanup_inst_list_has_owned_bind(insts: IrInstList, value: i64, action: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let found = match inst {
        IrBindI64(ns, nl, bind_value, ty) -> {
          if bind_value == value and cg_owned_drop_type_hash(ty) == action { 1 } else { 0 }
        }
        _ -> 0
      }
      if found == 1 { 1 } else { pipeline_ir_abort_cleanup_inst_list_has_owned_bind(rest, value, action) }
    }
  }
}

pub(package) fn pipeline_ir_abort_cleanup_blocks_have_owned_bind(blocks: IrBlockList, value: i64, action: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      let found = match block {
        IrBlock(id, params, insts, term) -> pipeline_ir_abort_cleanup_inst_list_has_owned_bind(insts, value, action)
      }
      if found == 1 { 1 } else { pipeline_ir_abort_cleanup_blocks_have_owned_bind(rest, value, action) }
    }
  }
}

pub(package) fn pipeline_ir_abort_cleanup_inst_list_rebinds_structural_slot(insts: IrInstList, slot: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let found = match inst {
        IrStructuralSlotI64(value, fact_slot, plan, mode) -> if mode == 2 and fact_slot == slot { 1 } else { 0 }
        _ -> 0
      }
      if found == 1 { 1 } else { pipeline_ir_abort_cleanup_inst_list_rebinds_structural_slot(rest, slot) }
    }
  }
}

pub(package) fn pipeline_ir_abort_cleanup_blocks_rebind_structural_slot(blocks: IrBlockList, slot: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      let found = match block {
        IrBlock(id, params, insts, term) -> pipeline_ir_abort_cleanup_inst_list_rebinds_structural_slot(insts, slot)
      }
      if found == 1 { 1 } else { pipeline_ir_abort_cleanup_blocks_rebind_structural_slot(rest, slot) }
    }
  }
}

pub(package) fn pipeline_ir_abort_cleanup_inst_list_has_linear_slot_alias_value(insts: IrInstList, value: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let found = match inst {
        IrStructuralSlotI64(alias_value, slot, plan, mode) -> if mode == 1 and alias_value == value { 1 } else { 0 }
        _ -> 0
      }
      if found == 1 { 1 } else { pipeline_ir_abort_cleanup_inst_list_has_linear_slot_alias_value(rest, value) }
    }
  }
}

pub(package) fn pipeline_ir_abort_cleanup_blocks_have_linear_slot_alias_value(blocks: IrBlockList, value: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      let found = match block {
        IrBlock(id, params, insts, term) -> pipeline_ir_abort_cleanup_inst_list_has_linear_slot_alias_value(insts, value)
      }
      if found == 1 { 1 } else { pipeline_ir_abort_cleanup_blocks_have_linear_slot_alias_value(rest, value) }
    }
  }
}

pub(package) fn pipeline_ir_abort_cleanup_fact_exists(facts: i64, value: i64, action: i64, kind: i64) -> i64 {
  let mut found = 0
  let n = nlist_len(facts)
  let mut i = 0
  while i < n and found == 0 {
    let fact = nlist_get(facts, i)
    if node_f1(fact) == value and node_f2(fact) == action and node_f3(fact) == kind { found = 1 }
    else { i = i + 1 }
  }
  found
}

pub(package) fn pipeline_ir_abort_cleanup_is_direct_action_hash(hash: i64) -> i64 {
  if hash == pipeline_rc_default_release_hash() or hash == pipeline_closure_default_release_hash() or hash == pipeline_rc_default_weak_release_hash() or hash == pipeline_runtime_defer_abort_cleanup_hash() or hash == pipeline_runtime_par_task_scope_cleanup_hash() or hash == pipeline_runtime_par_work_scope_cleanup_hash() { 1 } else { 0 }
}

pub(package) fn pipeline_ir_abort_cleanup_inst_is_closure(inst: IrInst) -> i64 {
  match inst {
    IrClosureI64(dst, fn_value, captures, evidence) -> 1
    _ -> 0
  }
}

pub(package) fn pipeline_ir_abort_cleanup_is_managed_retain_hash(hash: i64) -> i64 {
  if hash == pipeline_rc_default_retain_hash() or hash == pipeline_closure_default_retain_hash() or hash == pipeline_rc_default_weak_retain_hash() { 1 } else { 0 }
}

pub(package) fn pipeline_ir_abort_cleanup_release_for_retain(hash: i64) -> i64 {
  if hash == pipeline_rc_default_retain_hash() { pipeline_rc_default_release_hash() }
  else { if hash == pipeline_closure_default_retain_hash() { pipeline_closure_default_release_hash() }
  else { if hash == pipeline_rc_default_weak_retain_hash() { pipeline_rc_default_weak_release_hash() }
  else { 0 } } }
}

pub(package) fn pipeline_ir_abort_cleanup_inst_list_defines_closure(insts: IrInstList, value: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let found = match inst {
        IrClosureI64(dst, fn_value, captures, evidence) -> if dst == value { 1 } else { 0 }
        _ -> 0
      }
      if found == 1 { 1 } else { pipeline_ir_abort_cleanup_inst_list_defines_closure(rest, value) }
    }
  }
}

pub(package) fn pipeline_ir_abort_cleanup_blocks_define_closure(blocks: IrBlockList, value: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      let found = match block {
        IrBlock(id, params, insts, term) -> pipeline_ir_abort_cleanup_inst_list_defines_closure(insts, value)
      }
      if found == 1 { 1 } else { pipeline_ir_abort_cleanup_blocks_define_closure(rest, value) }
    }
  }
}

pub(package) fn pipeline_ir_abort_cleanup_rc_alloc_hash() -> i64 {
  str_hash(__str_ptr("rc_default_alloc"), 0, __str_len("rc_default_alloc"))
}

pub(package) fn pipeline_ir_abort_cleanup_add_action_fact(facts: i64, value: i64, action: i64, kind: i64) -> i64 {
  if value < 0 or action == 0 or pipeline_ir_abort_cleanup_fact_exists(facts, value, action, kind) == 1 { 0 }
  else { nlist_add(facts, node_new(0, value, action, kind, nlist_len(facts))) }
}

pub(package) fn pipeline_ir_abort_cleanup_add_structural_action_fact(facts: i64, value: i64, plan: i64) -> i64 {
  let action = pipeline_structural_drop_glue_hash(plan)
  if value < 0 or action == 0 or pipeline_ir_abort_cleanup_fact_exists(facts, value, action, pipeline_ir_abort_cleanup_structural_kind()) == 1 { 0 }
  else { nlist_add(facts, node_new(0, value, action, pipeline_ir_abort_cleanup_structural_kind(), plan)) }
}

pub(package) fn pipeline_ir_abort_cleanup_add_linear_action_fact(facts: i64, value: i64, plan: i64) -> i64 {
  if pipeline_linear_cleanup_plan_uses_structural_glue(plan) == 0 {
    pipeline_ir_abort_cleanup_add_action_fact(
      facts,
      value,
      cg_owned_drop_type_hash(typeck_linear_layout_plan_type(plan)),
      pipeline_ir_abort_cleanup_owned_kind()
    )
  } else { pipeline_ir_abort_cleanup_add_structural_action_fact(facts, value, plan) }
}

pub(package) fn pipeline_ir_abort_cleanup_collect_inst_list(insts: IrInstList, all_blocks: IrBlockList, facts: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      match inst {
        IrCallI64(dst, callee_hash, args) -> {
          if pipeline_ir_abort_cleanup_is_direct_action_hash(callee_hash) == 1 {
            pipeline_ir_abort_cleanup_add_action_fact(facts, pipeline_ir_value_list_get_or(args, 0, 0 - 1), callee_hash, pipeline_ir_abort_cleanup_direct_kind())
          } else { 0 }
        }
        IrManagedStakeI64(dst, value, cleanup_kind, delta, origin) -> {
          if delta == 0 - 1 {
            pipeline_ir_abort_cleanup_add_action_fact(facts, value, pipeline_managed_release_hash_for_kind(cleanup_kind), pipeline_ir_abort_cleanup_direct_kind())
          } else { 0 }
        }
        IrManagedTransferI64(call_dst, callee_hash, value, arg_lane, cleanup_kind) -> {
          pipeline_ir_abort_cleanup_add_action_fact(facts, value, pipeline_managed_release_hash_for_kind(cleanup_kind), pipeline_ir_abort_cleanup_direct_kind())
        }
        IrOwnedDropI64(value, type_hash) -> pipeline_ir_abort_cleanup_add_action_fact(facts, value, type_hash, pipeline_ir_abort_cleanup_owned_kind())
        IrStructuralDropI64(value, plan) -> pipeline_ir_abort_cleanup_add_linear_action_fact(facts, value, plan)
        IrStructuralSplitI64(value, parent_plan, residual_plan, release_backing) -> pipeline_ir_abort_cleanup_add_linear_action_fact(facts, value, parent_plan)
        IrTryLinearI64(dst, value, effect_key, parent_plan, ok_plan, error_plan) -> pipeline_ir_abort_cleanup_add_linear_action_fact(facts, value, parent_plan)
        IrArrayDropI64(data, leaf_count, leaf_stride, leaf_kind) -> {
          if pipeline_array_drop_plan_is_active(leaf_count, leaf_stride, leaf_kind) == 1 {
            pipeline_ir_abort_cleanup_add_action_fact(facts, data, pipeline_array_drop_glue_hash(leaf_count, leaf_stride, leaf_kind), pipeline_ir_abort_cleanup_array_kind())
          } else { 0 }
        }
        _ -> 0
      }
      pipeline_ir_abort_cleanup_collect_inst_list(rest, all_blocks, facts)
    }
  }
}

pub(package) fn pipeline_ir_abort_cleanup_collect_blocks(blocks: IrBlockList, all_blocks: IrBlockList, facts: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> pipeline_ir_abort_cleanup_collect_inst_list(insts, all_blocks, facts)
      }
      pipeline_ir_abort_cleanup_collect_blocks(rest, all_blocks, facts)
    }
  }
}

pub(package) fn pipeline_ir_abort_cleanup_acquisition_fact_exists(facts: i64, site: i64, value: i64, action: i64, kind: i64) -> i64 {
  let mut found = 0
  let n = nlist_len(facts)
  let mut i = 0
  while i < n and found == 0 {
    let fact = nlist_get(facts, i)
    if node_tag(fact) == site and node_f1(fact) == value and node_f2(fact) == action and node_f3(fact) == kind { found = 1 }
    else { i = i + 1 }
  }
  found
}

-- Acquisition facts keep their physical shadow-record index and the semantic
-- origin of the stake in one compiler-private scalar. Flow aliases copy this
-- word unchanged, preserving exact record identity and provenance together.
pub(package) fn pipeline_ir_abort_cleanup_fact_metadata(record_index: i64, origin: i64) -> i64 {
  record_index * ir_managed_stake_origin_count() + origin
}

pub(package) fn pipeline_ir_abort_cleanup_fact_record_index(fact: i64) -> i64 {
  if fact == 0 { 0 } else { node_f4(fact) / ir_managed_stake_origin_count() }
}

pub(package) fn pipeline_ir_abort_cleanup_fact_origin(fact: i64) -> i64 {
  if fact == 0 { ir_managed_stake_origin_unknown() } else { node_f4(fact) % ir_managed_stake_origin_count() }
}

-- Transient runtime-only provenance for an elided retain whose indirect call
-- has started but not yet returned. It is deliberately outside the stable IR
-- origin set: no semantic stake producer may persist this state.
pub(package) fn pipeline_ir_abort_cleanup_origin_indirect_transfer_pending() -> i64 {
  ir_managed_stake_origin_count()
}

-- A direct call's pending state is keyed by its SSA destination. Keeping this
-- outside the stable nonnegative origin domain lets the post-call commit retire
-- exactly this call's transports without reloading caller-clobbered arguments
-- or touching an obligation prepared for another boundary.
pub(package) fn pipeline_ir_abort_cleanup_origin_direct_transfer_pending(call_dst: i64) -> i64 {
  0 - 2 - call_dst
}

pub(package) fn pipeline_ir_abort_cleanup_origin_is_direct_transfer_pending(origin: i64) -> i64 {
  if origin <= 0 - 2 { 1 } else { 0 }
}

pub(package) fn pipeline_ir_abort_cleanup_add_acquisition_fact_with_origin(facts: i64, site: i64, value: i64, action: i64, kind: i64, origin: i64) -> i64 {
  if site == 0 - 1 or value < 0 or action == 0 or pipeline_ir_abort_cleanup_acquisition_fact_exists(facts, site, value, action, kind) == 1 { 0 }
  else {
    let exact_origin = if ir_managed_stake_origin_is_valid(origin) == 1 { origin } else { ir_managed_stake_origin_unknown() }
    nlist_add(facts, node_new(site, value, action, kind, pipeline_ir_abort_cleanup_fact_metadata(nlist_len(facts), exact_origin)))
  }
}

pub(package) fn pipeline_ir_abort_cleanup_add_acquisition_fact(facts: i64, site: i64, value: i64, action: i64, kind: i64) -> i64 {
  pipeline_ir_abort_cleanup_add_acquisition_fact_with_origin(facts, site, value, action, kind, ir_managed_stake_origin_unknown())
}

pub(package) fn pipeline_ir_abort_cleanup_find_action_kind(actions: i64, value: i64, kind: i64) -> i64 {
  let mut found = 0
  let n = nlist_len(actions)
  let mut i = 0
  while i < n and found == 0 {
    let fact = nlist_get(actions, i)
    if node_f1(fact) == value and node_f3(fact) == kind { found = fact }
    else { i = i + 1 }
  }
  found
}

pub(package) fn pipeline_ir_abort_cleanup_find_acquisition_site_kind(facts: i64, site: i64, kind: i64) -> i64 {
  let mut found = 0
  let n = if facts == 0 { 0 } else { nlist_len(facts) }
  let mut i = 0
  while i < n and found == 0 {
    let fact = nlist_get(facts, i)
    if node_tag(fact) == site and node_f3(fact) == kind { found = fact }
    else { i = i + 1 }
  }
  found
}

pub(package) fn pipeline_ir_abort_cleanup_find_linear_acquisition_site(facts: i64, site: i64) -> i64 {
  let mut found = 0
  let n = if facts == 0 { 0 } else { nlist_len(facts) }
  let mut i = 0
  while i < n and found == 0 {
    let fact = nlist_get(facts, i)
    let kind = node_f3(fact)
    if node_tag(fact) == site and
      (kind == pipeline_ir_abort_cleanup_owned_kind() or kind == pipeline_ir_abort_cleanup_structural_kind()) {
      found = fact
    } else { i = i + 1 }
  }
  found
}

pub(package) fn pipeline_ir_abort_cleanup_find_acquisition_value_action_kind(facts: i64, value: i64, action: i64, kind: i64) -> i64 {
  let mut found = 0
  let mut slot_alias = 0
  let n = if facts == 0 { 0 } else { nlist_len(facts) }
  let mut i = 0
  while i < n {
    let fact = nlist_get(facts, i)
    if node_f1(fact) == value and node_f2(fact) == action {
      if node_f3(fact) == pipeline_ir_abort_cleanup_slot_alias_kind() { slot_alias = fact }
      else { if node_f3(fact) == kind and found == 0 { found = fact } else { 0 } }
    } else { 0 }
    i = i + 1
  }
  if slot_alias != 0 { slot_alias } else { found }
}

pub(package) fn pipeline_ir_abort_cleanup_find_slot_alias_value(facts: i64, value: i64) -> i64 {
  let mut found = 0
  let n = if facts == 0 { 0 } else { nlist_len(facts) }
  let mut i = 0
  while i < n and found == 0 {
    let fact = nlist_get(facts, i)
    if node_f1(fact) == value and node_f3(fact) == pipeline_ir_abort_cleanup_slot_alias_kind() { found = fact }
    else { i = i + 1 }
  }
  found
}

pub(package) fn pipeline_ir_abort_cleanup_find_linear_transfer_fact(facts: i64, value: i64, action: i64, kind: i64) -> i64 {
  let slot_alias = pipeline_ir_abort_cleanup_find_slot_alias_value(facts, value)
  if slot_alias != 0 { slot_alias }
  else { pipeline_ir_abort_cleanup_find_acquisition_value_action_kind(facts, value, action, kind) }
}

pub(package) fn pipeline_ir_abort_cleanup_structural_slot_site(slot: i64) -> i64 {
  0 - slot - 1000000001
}

pub(package) fn pipeline_ir_abort_cleanup_is_structural_slot_site(site: i64) -> i64 {
  if site <= 0 - 1000000001 and site > 0 - 3000000001 { 1 } else { 0 }
}

-- Alias and flow facts reuse their exact source record index. Resolve that
-- canonical record before consulting the mutable-slot initialized state;
-- runtime resource bits are never used as ownership identity.
pub(package) fn pipeline_ir_abort_cleanup_fact_uses_structural_slot_record(fact: i64, facts: i64) -> i64 {
  let record_index = pipeline_ir_abort_cleanup_fact_record_index(fact)
  if fact == 0 or facts == 0 or record_index < 0 or record_index >= nlist_len(facts) { 0 }
  else {
    pipeline_ir_abort_cleanup_is_structural_slot_site(node_tag(nlist_get(facts, record_index)))
  }
}

-- Construction consumes the exact checker-owned plan already attached to the
-- aggregate's abort obligation. This is deliberately a fact lookup, not a
-- constructor/type-table recognizer: generic substitution and representation
-- decisions have happened before native emission reaches this seam.
pub(package) fn pipeline_ir_abort_cleanup_structural_plan_for_site(fm: i64, site: i64) -> i64 {
  let exact = pipeline_ir_abort_cleanup_find_acquisition_site_kind(
    fmap_current_abort_cleanup_facts(fm), site, pipeline_ir_abort_cleanup_structural_kind()
  )
  -- A referenced local acquires at its following typed bind rather than at
  -- the constructor instruction. The bind fact still names the constructor's
  -- exact result SSA, allowing construction to commit child stakes to the
  -- aggregate before the bind arms its parent record.
  let fact = if exact != 0 { exact }
    else { pipeline_ir_abort_cleanup_find_action_kind(fmap_current_abort_cleanup_facts(fm), site, pipeline_ir_abort_cleanup_structural_kind()) }
  if fact == 0 { 0 } else { fmap_structural_drop_plan_lookup(fm, node_f2(fact)) }
}

pub(package) fn pipeline_ir_abort_cleanup_call_result_lane_release_hash(callee_hash: i64, fns: i64, lane: i64) -> i64 {
  if lane == 0 and (callee_hash == pipeline_ir_abort_cleanup_rc_alloc_hash() or callee_hash == pipeline_rc_array_storage_new_hash() or callee_hash == pipeline_rc_default_weak_load_hash()) {
    pipeline_rc_default_release_hash()
  } else {
    pipeline_managed_release_hash_for_kind(
      cg_managed_drop_kind_for_ty_lane(pipeline_fns_lookup_ret_type_node_by_hash(fns, callee_hash, 0), lane)
    )
  }
}

pub(package) fn pipeline_ir_abort_cleanup_generic_ret_type(callee_hash: i64, type_args: TypeExprList, fns: i64) -> i64 {
  let pair = pipeline_fns_lookup_callable_pair_by_hash(fns, callee_hash)
  if pair == 0 { 0 }
  else { cg_generic_subst_ret(node_f1(pair), type_expr_list_to_nodes(type_args)) }
}

pub(package) fn pipeline_ir_abort_cleanup_inst_list_has_retain_for_value(insts: IrInstList, value: i64, release: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let hit = match inst {
        IrCallI64(dst, callee_hash, args) -> {
          if pipeline_ir_abort_cleanup_is_managed_retain_hash(callee_hash) == 1 and
            pipeline_ir_abort_cleanup_release_for_retain(callee_hash) == release and
            pipeline_ir_value_list_get_or(args, 0, 0 - 1) == value { 1 } else { 0 }
        }
        IrManagedStakeI64(dst, stake_value, cleanup_kind, delta, origin) -> {
          if delta == 1 and stake_value == value and pipeline_managed_release_hash_for_kind(cleanup_kind) == release { 1 } else { 0 }
        }
        _ -> 0
      }
      if hit == 1 { 1 } else { pipeline_ir_abort_cleanup_inst_list_has_retain_for_value(rest, value, release) }
    }
  }
}

pub(package) fn pipeline_ir_abort_cleanup_blocks_have_retain_for_value(blocks: IrBlockList, value: i64, release: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      let hit = match block {
        IrBlock(id, params, insts, term) -> pipeline_ir_abort_cleanup_inst_list_has_retain_for_value(insts, value, release)
      }
      if hit == 1 { 1 } else { pipeline_ir_abort_cleanup_blocks_have_retain_for_value(rest, value, release) }
    }
  }
}

pub(package) fn pipeline_ir_abort_cleanup_ret_type_lane_release_hash(ret_ty: i64, lane: i64) -> i64 {
  pipeline_managed_release_hash_for_kind(cg_managed_drop_kind_for_ty_lane(ret_ty, lane))
}

pub(package) fn pipeline_ir_abort_cleanup_inst_acquires_structural(inst: IrInst) -> i64 {
  match inst {
    IrCallI64(dst, callee_hash, args) -> 1
    IrGenericCallI64(dst, callee_hash, type_args, args) -> 1
    IrIndirectCallI64(dst, callee, args, result_ty) -> 1
    IrVariantInitI64(dst, tag_hash, payloads, field_mask) -> 1
    IrRecordInitI64(dst, type_hash, fields) -> 1
    IrRecordLayoutInitI64(dst, type_hash, data_size, align, fields) -> 1
    IrReuseInitI64(token, constructor) -> pipeline_ir_abort_cleanup_inst_acquires_structural(constructor)
    IrTryLinearI64(dst, value, effect_key, parent_plan, ok_plan, error_plan) -> pipeline_linear_cleanup_plan_uses_structural_glue(ok_plan)
    _ -> 0
  }
}

-- A representation-preserving call may return an already-owned argument
-- without acquiring another stake. The typed return-alias and managed-param
-- facts distinguish that contract from an ordinary managed identity function,
-- whose return transfer does acquire a new count. Suppress a duplicate abort
-- record only when the aliased parameter itself is unmanaged and the source
-- SSA already has the exact release obligation.
-- The native index is a compact projection of the typed semantic fact tree:
-- tag/hash, return-alias mask, managed-param mask, and parameter shapes.
pub(package) fn pipeline_ir_native_return_alias_facts_add(semantic_facts: PipelineIrSemanticFactList, out: i64) -> i64 {
  match semantic_facts {
    PipelineIrSemanticFactNil -> 0
    PipelineIrSemanticFactNode(hash, semantic, borrow, left, right) -> {
      pipeline_ir_native_return_alias_facts_add(left, out)
      let alias_mask = cg_semantic_fact_return_alias_param_mask(semantic)
      if alias_mask != 0 {
        nlist_add(out, node_new(hash, alias_mask, cg_semantic_fact_managed_param_mask(semantic), cg_semantic_fact_param_shapes(semantic), 0))
      } else { 0 }
      pipeline_ir_native_return_alias_facts_add(right, out)
    }
  }
}

pub(package) fn pipeline_ir_native_return_alias_facts(semantic_facts: PipelineIrSemanticFactList) -> i64 {
  let out = nlist_new()
  -- Sealed-Unsafe inlining exposes the storage-preserving intrinsic after the
  -- source wrapper's typed alias fact has done its job. Preserve the same
  -- semantic contract at that lower boundary: parameter zero is an unmanaged
  -- representation word and the result reuses its exact storage identity.
  let transmute_params = nlist_new_capacity(1)
  nlist_add(transmute_params, ir_value_shape_gpr_words(1))
  nlist_add(out, node_new(pipeline_ir_native_intrinsic_transmute_hash(), 1, 0, transmute_params, 0))
  pipeline_ir_native_return_alias_facts_add(semantic_facts, out)
  out
}

pub(package) fn pipeline_ir_native_return_alias_fact_find(facts: i64, callee_hash: i64) -> i64 {
  let mut found = 0
  let count = if facts == 0 { 0 } else { nlist_len(facts) }
  let mut index = 0
  while index < count and found == 0 {
    let fact = nlist_get(facts, index)
    if node_tag(fact) == callee_hash { found = fact } else { index = index + 1 }
  }
  found
}

pub(package) fn pipeline_ir_abort_cleanup_call_reuses_owned_alias(callee_hash: i64, args: IrValueList, action: i64, facts: i64, return_alias_facts: i64) -> i64 {
  let semantic = pipeline_ir_native_return_alias_fact_find(return_alias_facts, callee_hash)
  if semantic == 0 or action == 0 { 0 }
  else {
    let alias_mask = node_f1(semantic)
    let managed_mask = node_f2(semantic)
    let shapes = node_f3(semantic)
    let mut logical = 0
    let mut head = 0
    let mut found = 0
    let count = if shapes == 0 { 0 } else { nlist_len(shapes) }
    while logical < count and logical < 60 and found == 0 {
      let lanes = ir_value_shape_lane_count(nlist_get(shapes, logical))
      if lanes <= 0 { logical = count }
      else {
        if (alias_mask band cg_bit(logical)) != 0 and (managed_mask band cg_bit(logical)) == 0 {
          let source = ir_value_list_nth_or(args, head, 0 - 1)
          if source >= 0 and pipeline_ir_abort_cleanup_find_acquisition_value_action_kind(facts, source, action, pipeline_ir_abort_cleanup_direct_kind()) != 0 {
            found = 1
          } else { 0 }
        } else { 0 }
        head = head + lanes
        logical = logical + 1
      }
    }
    found
  }
}

pub(package) fn pipeline_ir_abort_cleanup_collect_acquisition_inst(inst: IrInst, all_blocks: IrBlockList, actions: i64, facts: i64, fns: i64, tt: i64, return_alias_facts: i64) -> i64 {
  let site = pipeline_ir_inst_def_or(inst, 0 - 1)
  let structural = if site >= 0 { pipeline_ir_abort_cleanup_find_action_kind(actions, site, pipeline_ir_abort_cleanup_structural_kind()) } else { 0 }
  let owned = if site >= 0 { pipeline_ir_abort_cleanup_find_action_kind(actions, site, pipeline_ir_abort_cleanup_owned_kind()) } else { 0 }
  let direct_action = if site >= 0 { pipeline_ir_abort_cleanup_find_action_kind(actions, site, pipeline_ir_abort_cleanup_direct_kind()) } else { 0 }
  let array = if site >= 0 { pipeline_ir_abort_cleanup_find_action_kind(actions, site, pipeline_ir_abort_cleanup_array_kind()) } else { 0 }
  let derived_plan = match inst {
    IrCallI64(dst, callee_hash, args) -> pipeline_linear_cleanup_plan(tt, pipeline_fns_lookup_ret_type_node_by_hash(fns, callee_hash, 0))
    IrGenericCallI64(dst, callee_hash, type_args, args) -> pipeline_linear_cleanup_plan(tt, pipeline_ir_abort_cleanup_generic_ret_type(callee_hash, type_args, fns))
    IrIndirectCallI64(dst, callee, args, result_ty) -> pipeline_linear_cleanup_plan(tt, type_expr_to_node(result_ty))
    IrTryLinearI64(dst, value, effect_key, parent_plan, ok_plan, error_plan) -> ok_plan
    _ -> 0
  }
  let structural_plan = if structural != 0 { node_f4(structural) }
    else { if pipeline_linear_cleanup_plan_uses_structural_glue(derived_plan) == 1 { derived_plan } else { 0 } }
  let structural_action = if structural != 0 { node_f2(structural) }
    else { if structural_plan != 0 { pipeline_structural_drop_glue_hash(structural_plan) } else { 0 } }
  let alias_hash = match inst {
    IrCallI64(dst, callee_hash, args) -> callee_hash
    IrGenericCallI64(dst, callee_hash, type_args, args) -> pipeline_ir_function_ref_target_hash(callee_hash, type_args)
    _ -> 0
  }
  let alias_args = match inst {
    IrCallI64(dst, callee_hash, args) -> args
    IrGenericCallI64(dst, callee_hash, type_args, args) -> args
    _ -> ir_value_list_empty()
  }
  let alias_action = if direct_action == 0 { 0 } else { node_f2(direct_action) }
  let reuses_owned_alias = if alias_hash == 0 { 0 }
    else { pipeline_ir_abort_cleanup_call_reuses_owned_alias(alias_hash, alias_args, alias_action, facts, return_alias_facts) }
  if structural_plan != 0 and pipeline_ir_abort_cleanup_inst_acquires_structural(inst) == 1 and
    pipeline_ir_abort_cleanup_blocks_have_linear_slot_alias_value(all_blocks, site) == 0 {
    -- A wide call is not an acquisition until its final ABI lane has been
    -- materialised. The call-list walker below arms that delayed site.
    if (match inst { IrCallI64(dst, callee_hash, args) -> 1 IrGenericCallI64(dst, callee_hash, type_args, args) -> 1 IrIndirectCallI64(dst, callee, args, result_ty) -> 1 _ -> 0 }) == 1 and
      pipeline_structural_drop_plan_storage_mode(structural_plan) == 2 and typeck_linear_layout_plan_words(structural_plan) > 1 { 0 }
    else { pipeline_ir_abort_cleanup_add_acquisition_fact(facts, site, site, structural_action, pipeline_ir_abort_cleanup_structural_kind()) }
  } else { if owned != 0 {
    if (pipeline_ir_abort_cleanup_blocks_have_owned_bind(all_blocks, site, node_f2(owned)) == 0 or
      pipeline_ir_abort_cleanup_blocks_rebind_structural_slot(all_blocks, site) == 1) and
      pipeline_ir_abort_cleanup_blocks_have_linear_slot_alias_value(all_blocks, site) == 0 {
      pipeline_ir_abort_cleanup_add_acquisition_fact(facts, site, site, node_f2(owned), pipeline_ir_abort_cleanup_owned_kind())
    } else { 0 }
  } else {
    if array != 0 {
      pipeline_ir_abort_cleanup_add_acquisition_fact(facts, site, site, node_f2(array), pipeline_ir_abort_cleanup_array_kind())
    } else {
      if direct_action != 0 and reuses_owned_alias == 0 and pipeline_ir_abort_cleanup_inst_is_closure(inst) == 0 and pipeline_ir_abort_cleanup_blocks_have_retain_for_value(all_blocks, site, node_f2(direct_action)) == 0 {
        pipeline_ir_abort_cleanup_add_acquisition_fact(facts, site, site, node_f2(direct_action), pipeline_ir_abort_cleanup_direct_kind())
      } else { 0 }
    }
  } }
  -- A later managed release proves an obligation exists, but it does not
  -- prove that the value's defining instruction acquired it. In particular,
  -- PtrLoad/Load/field projections may be borrowed aliases whose ownership is
  -- established by a following explicit retain. When that exact retain fact
  -- exists it is the acquisition; registering the alias definition as well
  -- would make the abort walk release one stake twice. Otherwise a matched
  -- managed release is the residual ownership proof for lowering forms whose
  -- result type is not carried directly by the IR instruction.
  match inst {
    IrManagedStakeI64(dst, retained, cleanup_kind, delta, origin) -> {
      if delta == 1 {
        let release = if cleanup_kind == continuation_cleanup_kind_rc() and pipeline_ir_abort_cleanup_blocks_define_closure(all_blocks, retained) == 1 {
          -- Generic RC transport of a closure still owns closure teardown:
          -- freeing the pair without walking its environment leaks captures.
          pipeline_closure_default_release_hash()
        } else { pipeline_managed_release_hash_for_kind(cleanup_kind) }
        pipeline_ir_abort_cleanup_add_acquisition_fact_with_origin(
          facts,
          dst,
          retained,
          release,
          pipeline_ir_abort_cleanup_direct_kind(),
          origin
        )
      } else { 0 }
    }
    IrCallI64(dst, callee_hash, args) -> {
      if structural_plan != 0 { 0 }
      else { if pipeline_ir_abort_cleanup_is_managed_retain_hash(callee_hash) == 1 {
        let retained = pipeline_ir_value_list_get_or(args, 0, 0 - 1)
        let release = if callee_hash == pipeline_rc_default_retain_hash() and pipeline_ir_abort_cleanup_blocks_define_closure(all_blocks, retained) == 1 {
          -- A closure pair is RC-backed, so generic capture transport may
          -- retain it through rc_default_retain. Its final release must still
          -- run closure teardown; a plain RC release at count one would free
          -- the pair without walking the closure environment.
          pipeline_closure_default_release_hash()
        } else { pipeline_ir_abort_cleanup_release_for_retain(callee_hash) }
        pipeline_ir_abort_cleanup_add_acquisition_fact(
          facts,
          dst,
          retained,
          release,
          pipeline_ir_abort_cleanup_direct_kind()
        )
      } else {
        let ret_ty = pipeline_fns_lookup_ret_type_node_by_hash(fns, callee_hash, 0)
        let owned_action = cg_owned_drop_type_hash(ret_ty)
        if owned_action != 0 {
          if pipeline_ir_abort_cleanup_blocks_have_owned_bind(all_blocks, dst, owned_action) == 0 or
            pipeline_ir_abort_cleanup_blocks_rebind_structural_slot(all_blocks, dst) == 1 {
            pipeline_ir_abort_cleanup_add_acquisition_fact(facts, dst, dst, owned_action, pipeline_ir_abort_cleanup_owned_kind())
          } else { 0 }
        } else {
          let release = pipeline_ir_abort_cleanup_call_result_lane_release_hash(callee_hash, fns, 0)
          if release != 0 and reuses_owned_alias == 0 {
            pipeline_ir_abort_cleanup_add_acquisition_fact(facts, dst, dst, release, pipeline_ir_abort_cleanup_direct_kind())
          } else { 0 }
        }
      } }
    }
    IrGenericCallI64(dst, callee_hash, type_args, args) -> {
      if structural_plan != 0 { 0 }
      else {
        let ret_ty = pipeline_ir_abort_cleanup_generic_ret_type(callee_hash, type_args, fns)
        let owned_action = cg_owned_drop_type_hash(ret_ty)
        if owned_action != 0 {
          if pipeline_ir_abort_cleanup_blocks_have_owned_bind(all_blocks, dst, owned_action) == 0 or
            pipeline_ir_abort_cleanup_blocks_rebind_structural_slot(all_blocks, dst) == 1 {
            pipeline_ir_abort_cleanup_add_acquisition_fact(facts, dst, dst, owned_action, pipeline_ir_abort_cleanup_owned_kind())
          } else { 0 }
        } else {
          let release = pipeline_ir_abort_cleanup_ret_type_lane_release_hash(ret_ty, 0)
          if release != 0 and reuses_owned_alias == 0 {
            pipeline_ir_abort_cleanup_add_acquisition_fact(facts, dst, dst, release, pipeline_ir_abort_cleanup_direct_kind())
          } else { 0 }
        }
      }
    }
    IrIndirectCallI64(dst, callee, args, result_ty) -> {
      if structural_plan != 0 { 0 }
      else {
        let raw_result_ty = type_expr_to_node(result_ty)
        let owned_action = cg_owned_drop_type_hash(raw_result_ty)
        if owned_action != 0 {
          if pipeline_ir_abort_cleanup_blocks_have_owned_bind(all_blocks, dst, owned_action) == 0 or
            pipeline_ir_abort_cleanup_blocks_rebind_structural_slot(all_blocks, dst) == 1 {
            pipeline_ir_abort_cleanup_add_acquisition_fact(facts, dst, dst, owned_action, pipeline_ir_abort_cleanup_owned_kind())
          } else { 0 }
        } else {
          let release = pipeline_ir_abort_cleanup_ret_type_lane_release_hash(raw_result_ty, 0)
          if release != 0 {
            pipeline_ir_abort_cleanup_add_acquisition_fact(facts, dst, dst, release, pipeline_ir_abort_cleanup_direct_kind())
          } else { 0 }
        }
      }
    }
    IrTryLinearI64(dst, value, effect_key, parent_plan, ok_plan, error_plan) -> {
      if ok_plan != 0 and pipeline_linear_cleanup_plan_uses_structural_glue(ok_plan) == 0 {
        pipeline_ir_abort_cleanup_add_acquisition_fact(
          facts, dst, dst, cg_owned_drop_type_hash(typeck_linear_layout_plan_type(ok_plan)), pipeline_ir_abort_cleanup_owned_kind()
        )
      } else { 0 }
    }
    -- Literal descriptors and bytes live in static program-image storage.
    IrStringLit(dst, start, len) -> 0
    IrStringConcatI64(dst, left, right) -> pipeline_ir_abort_cleanup_add_acquisition_fact(facts, dst, dst, pipeline_rc_default_release_hash(), pipeline_ir_abort_cleanup_direct_kind())
    IrClosureI64(dst, fn_value, captures, evidence) -> {
      -- The closure backing environment is released after any scheduled
      -- defer action which uses it. Facts register in list order, so add the
      -- release first and the action second: the latter becomes chain-top.
      pipeline_ir_abort_cleanup_add_acquisition_fact(facts, dst, dst, pipeline_closure_default_release_hash(), pipeline_ir_abort_cleanup_direct_kind())
      if direct_action != 0 and node_f2(direct_action) != pipeline_closure_default_release_hash() {
        pipeline_ir_abort_cleanup_add_acquisition_fact(facts, dst, dst, node_f2(direct_action), pipeline_ir_abort_cleanup_direct_kind())
      } else { 0 }
    }
    IrVariantInitI64(dst, tag_hash, payloads, field_mask) -> {
      if owned == 0 and structural_plan == 0 { pipeline_ir_abort_cleanup_add_acquisition_fact(facts, dst, dst, pipeline_rc_default_release_hash(), pipeline_ir_abort_cleanup_direct_kind()) } else { 0 }
    }
    IrRecordInitI64(dst, type_hash, fields) -> {
      if owned == 0 and structural_plan == 0 { pipeline_ir_abort_cleanup_add_acquisition_fact(facts, dst, dst, pipeline_rc_default_release_hash(), pipeline_ir_abort_cleanup_direct_kind()) } else { 0 }
    }
    IrRecordLayoutInitI64(dst, type_hash, data_size, align, fields) -> {
      if owned == 0 and structural_plan == 0 { pipeline_ir_abort_cleanup_add_acquisition_fact(facts, dst, dst, pipeline_rc_default_release_hash(), pipeline_ir_abort_cleanup_direct_kind()) } else { 0 }
    }
    IrReuseInitI64(token, constructor) -> pipeline_ir_abort_cleanup_collect_acquisition_inst(constructor, all_blocks, actions, facts, fns, tt, return_alias_facts)
    IrBindI64(ns, nl, value, ty) -> {
      let action = cg_owned_drop_type_hash(ty)
      let plan = pipeline_linear_cleanup_plan(tt, ty)
      let structural_action = if pipeline_linear_cleanup_plan_uses_structural_glue(plan) == 1 { pipeline_structural_drop_glue_hash(plan) } else { 0 }
      -- The caller transfers its exact record immediately before entering a
      -- by-value call; the callee's typed parameter bind therefore acquires
      -- the replacement record before any language-level operation can abort.
      -- Locals use the same fact, and exact identity prevents a producer plus
      -- its following bind from arming twice.
      if (structural_action != 0 or action != 0) and pipeline_ir_abort_cleanup_blocks_rebind_structural_slot(all_blocks, value) == 1 {
        -- Mutable linear slots acquire through IrStructuralSlotI64 after every
        -- lane store, not at the lexical bind. That stable record is reused by
        -- replacement and carries exact provenance for later loads.
        0
      } else { if structural_action != 0 {
        if pipeline_ir_abort_cleanup_blocks_have_linear_slot_alias_value(all_blocks, value) == 0 and
          pipeline_ir_abort_cleanup_fact_exists(facts, value, structural_action, pipeline_ir_abort_cleanup_structural_kind()) == 0 {
          pipeline_ir_abort_cleanup_add_acquisition_fact(
            facts,
            pipeline_ir_abort_cleanup_owned_bind_site(value, ns),
            value,
            structural_action,
            pipeline_ir_abort_cleanup_structural_kind()
          )
        } else { 0 }
      } else { if action != 0 and
        pipeline_ir_abort_cleanup_blocks_have_linear_slot_alias_value(all_blocks, value) == 0 and
        pipeline_ir_abort_cleanup_fact_exists(facts, value, action, pipeline_ir_abort_cleanup_owned_kind()) == 0 {
        pipeline_ir_abort_cleanup_add_acquisition_fact(
          facts,
          pipeline_ir_abort_cleanup_owned_bind_site(value, ns),
          value,
          action,
          pipeline_ir_abort_cleanup_owned_kind()
        )
      } else { 0 } } }
    }
    IrStructuralSlotI64(value, slot, plan, mode) -> {
      if mode == 2 and plan != 0 and pipeline_linear_cleanup_plan_uses_structural_glue(plan) == 0 {
        pipeline_ir_abort_cleanup_add_acquisition_fact(
          facts,
          pipeline_ir_abort_cleanup_structural_slot_site(slot),
          slot,
          cg_owned_drop_type_hash(typeck_linear_layout_plan_type(plan)),
          pipeline_ir_abort_cleanup_owned_kind()
        )
      } else { if mode == 2 and plan != 0 {
        pipeline_ir_abort_cleanup_add_acquisition_fact(
          facts,
          pipeline_ir_abort_cleanup_structural_slot_site(slot),
          slot,
          pipeline_structural_drop_glue_hash(plan),
          pipeline_ir_abort_cleanup_structural_kind()
        )
      } else { if mode == 5 and plan != 0 {
        pipeline_ir_abort_cleanup_add_acquisition_fact(
          facts,
          pipeline_ir_abort_cleanup_rewrap_site(value),
          value,
          pipeline_ir_abort_cleanup_plan_action(plan),
          pipeline_ir_abort_cleanup_plan_owning_kind(plan)
        )
      } else { 0 } } }
    }
    _ -> 0
  }
}

pub(package) fn pipeline_ir_abort_cleanup_collect_acquisition_inst_list_with_call_alias_facts(insts: IrInstList, all_blocks: IrBlockList, actions: i64, facts: i64, fns: i64, tt: i64, call_ret_ty: i64, call_dst: i64, return_alias_facts: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      pipeline_ir_abort_cleanup_collect_acquisition_inst(inst, all_blocks, actions, facts, fns, tt, return_alias_facts)
      match inst {
        IrCallI64(dst, callee_hash, args) -> pipeline_ir_abort_cleanup_collect_acquisition_inst_list_with_call_alias_facts(rest, all_blocks, actions, facts, fns, tt, pipeline_fns_lookup_ret_type_node_by_hash(fns, callee_hash, 0), dst, return_alias_facts)
        IrGenericCallI64(dst, callee_hash, type_args, args) -> pipeline_ir_abort_cleanup_collect_acquisition_inst_list_with_call_alias_facts(rest, all_blocks, actions, facts, fns, tt, pipeline_ir_abort_cleanup_generic_ret_type(callee_hash, type_args, fns), dst, return_alias_facts)
        IrIndirectCallI64(dst, callee, args, result_ty) -> pipeline_ir_abort_cleanup_collect_acquisition_inst_list_with_call_alias_facts(rest, all_blocks, actions, facts, fns, tt, type_expr_to_node(result_ty), dst, return_alias_facts)
        IrCallResultLaneI64(dst, lane) -> {
          let physical_lane = ir_call_result_lane_physical(lane)
          if call_ret_ty != 0 and physical_lane > 0 and ir_call_result_lane_head(dst, lane) == call_dst {
            let structural = pipeline_ir_abort_cleanup_find_action_kind(actions, call_dst, pipeline_ir_abort_cleanup_structural_kind())
            let derived_plan = pipeline_linear_cleanup_plan(tt, call_ret_ty)
            let structural_plan = if structural != 0 { node_f4(structural) }
              else { if pipeline_linear_cleanup_plan_uses_structural_glue(derived_plan) == 1 { derived_plan } else { 0 } }
            let structural_action = if structural != 0 { node_f2(structural) }
              else { if structural_plan != 0 { pipeline_structural_drop_glue_hash(structural_plan) } else { 0 } }
            if structural_plan != 0 and pipeline_structural_drop_plan_storage_mode(structural_plan) == 2 and
              physical_lane == typeck_linear_layout_plan_words(structural_plan) - 1 {
              pipeline_ir_abort_cleanup_add_acquisition_fact(
                facts, dst, call_dst, structural_action, pipeline_ir_abort_cleanup_structural_kind()
              )
            } else { 0 }
            let release = pipeline_ir_abort_cleanup_ret_type_lane_release_hash(call_ret_ty, physical_lane)
            if release != 0 {
              pipeline_ir_abort_cleanup_add_acquisition_fact(facts, dst, dst, release, pipeline_ir_abort_cleanup_direct_kind())
            } else { 0 }
            pipeline_ir_abort_cleanup_collect_acquisition_inst_list_with_call_alias_facts(rest, all_blocks, actions, facts, fns, tt, call_ret_ty, call_dst, return_alias_facts)
          } else {
            pipeline_ir_abort_cleanup_collect_acquisition_inst_list_with_call_alias_facts(rest, all_blocks, actions, facts, fns, tt, 0, 0 - 1, return_alias_facts)
          }
        }
        _ -> pipeline_ir_abort_cleanup_collect_acquisition_inst_list_with_call_alias_facts(rest, all_blocks, actions, facts, fns, tt, 0, 0 - 1, return_alias_facts)
      }
    }
  }
}

pub(package) fn pipeline_ir_abort_cleanup_collect_acquisition_inst_list_with_call(insts: IrInstList, all_blocks: IrBlockList, actions: i64, facts: i64, fns: i64, tt: i64, call_ret_ty: i64, call_dst: i64) -> i64 {
  pipeline_ir_abort_cleanup_collect_acquisition_inst_list_with_call_alias_facts(insts, all_blocks, actions, facts, fns, tt, call_ret_ty, call_dst, 0)
}

pub(package) fn pipeline_ir_abort_cleanup_collect_acquisition_blocks(blocks: IrBlockList, all_blocks: IrBlockList, actions: i64, facts: i64, fns: i64, tt: i64, return_alias_facts: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> pipeline_ir_abort_cleanup_collect_acquisition_inst_list_with_call_alias_facts(insts, all_blocks, actions, facts, fns, tt, 0, 0 - 1, return_alias_facts)
      }
      pipeline_ir_abort_cleanup_collect_acquisition_blocks(rest, all_blocks, actions, facts, fns, tt, return_alias_facts)
    }
  }
}

pub(package) fn pipeline_ir_abort_cleanup_add_slot_alias_fact(facts: i64, value: i64, slot: i64, plan: i64) -> i64 {
  let owning_kind = pipeline_ir_abort_cleanup_plan_owning_kind(plan)
  let action = pipeline_ir_abort_cleanup_plan_action(plan)
  let canonical = pipeline_ir_abort_cleanup_find_acquisition_value_action_kind(
    facts, slot, action, owning_kind
  )
  if canonical == 0 or pipeline_ir_abort_cleanup_fact_exists(facts, value, action, pipeline_ir_abort_cleanup_slot_alias_kind()) == 1 { 0 }
  else {
    -- Alias facts are appended after every owning fact. Their record index is
    -- the canonical slot record's index, so exact disarm and shadow-address
    -- lookup reach that record without allocating or arming another one.
    nlist_add(facts, node_new(0 - 1, value, action, pipeline_ir_abort_cleanup_slot_alias_kind(), node_f4(canonical)))
  }
}

pub(package) fn pipeline_ir_abort_cleanup_collect_slot_alias_inst_list(insts: IrInstList, facts: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      match inst {
        IrStructuralSlotI64(value, slot, plan, mode) -> {
          if mode == 1 { pipeline_ir_abort_cleanup_add_slot_alias_fact(facts, value, slot, plan) } else { 0 }
        }
        _ -> 0
      }
      pipeline_ir_abort_cleanup_collect_slot_alias_inst_list(rest, facts)
    }
  }
}

pub(package) fn pipeline_ir_abort_cleanup_collect_slot_alias_blocks(blocks: IrBlockList, facts: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> pipeline_ir_abort_cleanup_collect_slot_alias_inst_list(insts, facts)
      }
      pipeline_ir_abort_cleanup_collect_slot_alias_blocks(rest, facts)
    }
  }
}

pub(package) fn pipeline_ir_abort_cleanup_value_list_index(values: IrValueList, wanted: i64, index: i64) -> i64 {
  match values {
    IrValueNil -> 0 - 1
    IrValueCons(value, rest) -> {
      if value == wanted { index }
      else { pipeline_ir_abort_cleanup_value_list_index(rest, wanted, index + 1) }
    }
  }
}

-- Return a private pair [block id, parameter index] for one SSA block
-- parameter. SSA ids are unique within a function, so at most one block can
-- own the requested parameter.
pub(package) fn pipeline_ir_abort_cleanup_block_param_location(blocks: IrBlockList, wanted: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> match block {
      IrBlock(id, params, insts, term) -> {
        let index = pipeline_ir_abort_cleanup_value_list_index(params, wanted, 0)
        if index >= 0 { node_new(0, id, index, 0, 0) }
        else { pipeline_ir_abort_cleanup_block_param_location(rest, wanted) }
      }
    }
  }
}

pub(package) fn pipeline_ir_abort_cleanup_flow_alias_exists(facts: i64, value: i64, action: i64, source_index: i64) -> i64 {
  let mut found = 0
  let mut i = 0
  while i < nlist_len(facts) and found == 0 {
    let fact = nlist_get(facts, i)
    if node_f1(fact) == value and node_f2(fact) == action and
      node_f3(fact) == pipeline_ir_abort_cleanup_flow_alias_kind() and
      node_f4(fact) == source_index { found = 1 }
    else { i = i + 1 }
  }
  found
}

pub(package) fn pipeline_ir_abort_cleanup_add_flow_alias(facts: i64, value: i64, action: i64, source_index: i64) -> i64 {
  if source_index < 0 or pipeline_ir_abort_cleanup_flow_alias_exists(facts, value, action, source_index) == 1 { 0 }
  else {
    nlist_add(facts, node_new(0 - 1, value, action, pipeline_ir_abort_cleanup_flow_alias_kind(), source_index))
  }
}

pub(package) fn pipeline_ir_abort_cleanup_collect_value_sources_from_facts(facts: i64, value: i64, action: i64, kind: i64, alias_value: i64, index: i64) -> i64 {
  if index >= nlist_len(facts) { 0 }
  else {
    let fact = nlist_get(facts, index)
    if node_f1(fact) == value and node_f2(fact) == action and
      (node_f3(fact) == kind or node_f3(fact) == pipeline_ir_abort_cleanup_slot_alias_kind()) {
      pipeline_ir_abort_cleanup_add_flow_alias(facts, alias_value, action, node_f4(fact))
    } else { 0 }
    pipeline_ir_abort_cleanup_collect_value_sources_from_facts(facts, value, action, kind, alias_value, index + 1)
  }
}

pub(package) fn pipeline_ir_abort_cleanup_collect_value_sources_from_predecessors(blocks: IrBlockList, all_blocks: IrBlockList, facts: i64, target_block: i64, param_index: i64, action: i64, kind: i64, alias_value: i64, visited: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> match term {
          IrTermJump(target, args) -> {
            if target == target_block {
              let incoming = pipeline_ir_value_list_get_or(args, param_index, 0 - 1)
              if incoming >= 0 {
                pipeline_ir_abort_cleanup_collect_value_sources(all_blocks, facts, incoming, action, kind, alias_value, visited)
              } else { 0 }
            } else { 0 }
          }
          _ -> 0
        }
      }
      pipeline_ir_abort_cleanup_collect_value_sources_from_predecessors(rest, all_blocks, facts, target_block, param_index, action, kind, alias_value, visited)
    }
  }
}

pub(package) fn pipeline_ir_abort_cleanup_collect_value_sources_from_insts(insts: IrInstList, blocks: IrBlockList, facts: i64, value: i64, action: i64, kind: i64, alias_value: i64, visited: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      match inst {
        -- Resume is the only scalar identity definition that can transport a
        -- linear result without acquiring a new obligation of its own.
        IrResumeI64(dst, source) -> {
          if dst == value {
            pipeline_ir_abort_cleanup_collect_value_sources(blocks, facts, source, action, kind, alias_value, visited)
          } else { 0 }
        }
        _ -> 0
      }
      pipeline_ir_abort_cleanup_collect_value_sources_from_insts(rest, blocks, facts, value, action, kind, alias_value, visited)
    }
  }
}

pub(package) fn pipeline_ir_abort_cleanup_collect_value_sources_from_blocks(current: IrBlockList, blocks: IrBlockList, facts: i64, value: i64, action: i64, kind: i64, alias_value: i64, visited: i64) -> i64 {
  match current {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> pipeline_ir_abort_cleanup_collect_value_sources_from_insts(insts, blocks, facts, value, action, kind, alias_value, visited)
      }
      pipeline_ir_abort_cleanup_collect_value_sources_from_blocks(rest, blocks, facts, value, action, kind, alias_value, visited)
    }
  }
}

pub(package) fn pipeline_ir_abort_cleanup_collect_value_sources(blocks: IrBlockList, facts: i64, value: i64, action: i64, kind: i64, alias_value: i64, visited: i64) -> i64 {
  if value < 0 or pipeline_hash_nlist_contains(visited, value) == 1 { 0 }
  else {
    nlist_add(visited, value)
    pipeline_ir_abort_cleanup_collect_value_sources_from_facts(facts, value, action, kind, alias_value, 0)
    pipeline_ir_abort_cleanup_collect_value_sources_from_blocks(blocks, blocks, facts, value, action, kind, alias_value, visited)
    let location = pipeline_ir_abort_cleanup_block_param_location(blocks, value)
    if location == 0 { 0 }
    else {
      pipeline_ir_abort_cleanup_collect_value_sources_from_predecessors(
        blocks, blocks, facts, node_f1(location), node_f2(location), action, kind, alias_value, visited
      )
    }
  }
}

-- A typed bind at a merge owns the replacement record for its block-parameter
-- SSA, so predecessor discovery must not treat that not-yet-armed record as
-- its own source. Start from identity definitions and incoming edges while
-- pre-marking the destination; recursive predecessor walks can then use the
-- ordinary source collector without cycling back through the merge.
pub(package) fn pipeline_ir_abort_cleanup_collect_prebind_value_sources(blocks: IrBlockList, facts: i64, value: i64, action: i64, kind: i64) -> i64 {
  let visited = nlist_new()
  nlist_add(visited, value)
  pipeline_ir_abort_cleanup_collect_value_sources_from_blocks(blocks, blocks, facts, value, action, kind, value, visited)
  let location = pipeline_ir_abort_cleanup_block_param_location(blocks, value)
  if location == 0 { 0 }
  else {
    pipeline_ir_abort_cleanup_collect_value_sources_from_predecessors(
      blocks, blocks, facts, node_f1(location), node_f2(location), action, kind, value, visited
    )
  }
}

-- A zero-cost aggregate may reach a transfer marker through a block-parameter
-- base while its independently acquired linear leaves still name predecessor
-- SSA values. Mirror the native flat-plan walk here and record every exact
-- predecessor record as an alias of the marker lane. Emission can then splice
-- the old owners before arming the enclosing opaque value.
pub(package) fn pipeline_ir_abort_cleanup_collect_flat_transfer_sources(
  blocks: IrBlockList,
  facts: i64,
  value: i64,
  plan: i64
) -> i64 {
  let kind = typeck_linear_layout_plan_kind(plan)
  if kind == 6 {
    pipeline_ir_abort_cleanup_collect_flat_transfer_sources(
      blocks, facts, value, typeck_linear_layout_plan_children(plan)
    )
  } else { if kind == 2 or kind == 3 {
    let children = typeck_linear_layout_plan_children(plan)
    let mut collected = 0
    let mut i = 0
    while i < nlist_len(children) {
      let component = nlist_get(children, i)
      collected = collected + pipeline_ir_abort_cleanup_collect_flat_transfer_sources(
        blocks,
        facts,
        value + typeck_linear_layout_component_offset(component),
        typeck_linear_layout_component_plan(component)
      )
      i = i + 1
    }
    collected
  } else { if plan == 0 { 0 }
  else {
    let action = pipeline_ir_abort_cleanup_plan_action(plan)
    let owning_kind = pipeline_ir_abort_cleanup_plan_owning_kind(plan)
    let direct = pipeline_ir_abort_cleanup_find_acquisition_value_action_kind(
      facts, value, action, owning_kind
    )
    if direct != 0 { 0 }
    else {
      pipeline_ir_abort_cleanup_collect_value_sources(
        blocks, facts, value, action, owning_kind, value, nlist_new()
      )
    }
  } } }
}

pub(package) fn pipeline_ir_abort_cleanup_collect_rebind_flow_alias(inst: IrInst, blocks: IrBlockList, facts: i64) -> i64 {
  match inst {
    IrStructuralSlotI64(value, slot, plan, mode) -> {
      if (mode == 2 or mode == 3) and plan != 0 {
        let kind = pipeline_ir_abort_cleanup_plan_owning_kind(plan)
        let action = pipeline_ir_abort_cleanup_plan_action(plan)
        let direct = pipeline_ir_abort_cleanup_find_acquisition_value_action_kind(facts, value, action, kind)
        if direct == 0 {
          pipeline_ir_abort_cleanup_collect_value_sources(blocks, facts, value, action, kind, value, nlist_new())
        } else { 0 }
        if mode == 3 and typeck_linear_layout_plan_kind(plan) != 1 {
          pipeline_ir_abort_cleanup_collect_flat_transfer_sources(blocks, facts, value, plan)
        } else { 0 }
      } else { 0 }
    }
    IrBindI64(ns, nl, value, ty) -> {
      let bind = pipeline_ir_abort_cleanup_find_linear_acquisition_site(
        facts, pipeline_ir_abort_cleanup_owned_bind_site(value, ns)
      )
      if bind == 0 { 0 }
      else {
        pipeline_ir_abort_cleanup_collect_prebind_value_sources(
          blocks, facts, value, node_f2(bind), node_f3(bind)
        )
      }
    }
    IrStructuralSplitI64(value, parent_plan, residual_plan, release_backing) -> {
      if parent_plan != 0 {
        let kind = pipeline_ir_abort_cleanup_plan_owning_kind(parent_plan)
        let action = pipeline_ir_abort_cleanup_plan_action(parent_plan)
        let direct = pipeline_ir_abort_cleanup_find_linear_transfer_fact(facts, value, action, kind)
        if direct == 0 {
          pipeline_ir_abort_cleanup_collect_value_sources(blocks, facts, value, action, kind, value, nlist_new())
        } else { 0 }
      } else { 0 }
    }
    IrTryLinearI64(dst, value, effect_key, parent_plan, ok_plan, error_plan) -> {
      if parent_plan != 0 {
        let kind = pipeline_ir_abort_cleanup_plan_owning_kind(parent_plan)
        let action = pipeline_ir_abort_cleanup_plan_action(parent_plan)
        let direct = pipeline_ir_abort_cleanup_find_linear_transfer_fact(facts, value, action, kind)
        if direct == 0 {
          pipeline_ir_abort_cleanup_collect_value_sources(blocks, facts, value, action, kind, value, nlist_new())
        } else { 0 }
      } else { 0 }
    }
    _ -> 0
  }
}

pub(package) fn pipeline_ir_abort_cleanup_collect_rebind_flow_alias_insts(insts: IrInstList, blocks: IrBlockList, facts: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      pipeline_ir_abort_cleanup_collect_rebind_flow_alias(inst, blocks, facts)
      pipeline_ir_abort_cleanup_collect_rebind_flow_alias_insts(rest, blocks, facts)
    }
  }
}

pub(package) fn pipeline_ir_abort_cleanup_collect_rebind_flow_alias_blocks(blocks: IrBlockList, all_blocks: IrBlockList, facts: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> pipeline_ir_abort_cleanup_collect_rebind_flow_alias_insts(insts, all_blocks, facts)
      }
      pipeline_ir_abort_cleanup_collect_rebind_flow_alias_blocks(rest, all_blocks, facts)
    }
  }
}

pub(package) fn pipeline_ir_abort_cleanup_facts_for_blocks_with_alias_facts(blocks: IrBlockList, fns: i64, tt: i64, return_alias_facts: i64) -> i64 {
  let actions = nlist_new()
  pipeline_ir_abort_cleanup_collect_blocks(blocks, blocks, actions)
  let facts = nlist_new()
  pipeline_ir_abort_cleanup_collect_acquisition_blocks(blocks, blocks, actions, facts, fns, tt, return_alias_facts)
  pipeline_ir_abort_cleanup_collect_slot_alias_blocks(blocks, facts)
  pipeline_ir_abort_cleanup_collect_rebind_flow_alias_blocks(blocks, blocks, facts)
  facts
}

pub(package) fn pipeline_ir_abort_cleanup_facts_for_blocks(blocks: IrBlockList, fns: i64, tt: i64) -> i64 {
  pipeline_ir_abort_cleanup_facts_for_blocks_with_alias_facts(blocks, fns, tt, 0)
}

pub(package) fn pipeline_ir_abort_cleanup_blocks_need_instrumentation(blocks: IrBlockList, facts: i64) -> i64 {
  if facts != 0 and nlist_len(facts) > 0 { 1 }
  else {
    let actions = nlist_new()
    pipeline_ir_abort_cleanup_collect_blocks(blocks, blocks, actions)
    if nlist_len(actions) > 0 { 1 } else { 0 }
  }
}

pub(package) fn pipeline_ir_abort_cleanup_fact_structural_plan(fact: i64, fm: i64) -> i64 {
  if fact == 0 or node_f3(fact) != pipeline_ir_abort_cleanup_structural_kind() { 0 }
  else { fmap_structural_drop_plan_lookup(fm, node_f2(fact)) }
}

pub(package) fn pipeline_ir_abort_cleanup_fact_shadow_words(fact: i64, fm: i64) -> i64 {
  let plan = pipeline_ir_abort_cleanup_fact_structural_plan(fact, fm)
  if pipeline_structural_drop_plan_storage_mode(plan) == 2 { typeck_linear_layout_plan_words(plan) } else { 0 }
}

pub(package) fn pipeline_ir_abort_cleanup_shadow_words_before(facts: i64, fact: i64, fm: i64) -> i64 {
  let mut words = 0
  let stop = pipeline_ir_abort_cleanup_fact_record_index(fact)
  let mut i = 0
  while facts != 0 and i < nlist_len(facts) and i < stop {
    words = words + pipeline_ir_abort_cleanup_fact_shadow_words(nlist_get(facts, i), fm)
    i = i + 1
  }
  words
}

pub(package) fn pipeline_ir_abort_cleanup_shadow_base(base: i64, facts: i64) -> i64 {
  base + 32 + (if facts == 0 { 0 } else { nlist_len(facts) }) * handler_abort_cleanup_record_size()
}

pub(package) fn pipeline_ir_abort_cleanup_shadow_offset(base: i64, facts: i64, fact: i64, fm: i64) -> i64 {
  pipeline_ir_abort_cleanup_shadow_base(base, facts) + pipeline_ir_abort_cleanup_shadow_words_before(facts, fact, fm) * 8
}

pub(package) fn pipeline_ir_abort_cleanup_total_shadow_words(facts: i64, fm: i64) -> i64 {
  let mut words = 0
  let n = if facts == 0 { 0 } else { nlist_len(facts) }
  for i in 0..n { words = words + pipeline_ir_abort_cleanup_fact_shadow_words(nlist_get(facts, i), fm) }
  words
}

pub(package) fn pipeline_ir_abort_cleanup_frame_size(base_frame: i64, facts: i64, instrumented: i64, fm: i64) -> i64 {
  let n = if facts == 0 { 0 } else { nlist_len(facts) }
  if instrumented == 0 { base_frame }
  else { cg_align16(base_frame + 32 + n * handler_abort_cleanup_record_size() + pipeline_ir_abort_cleanup_total_shadow_words(facts, fm) * 8) }
}

pub(package) fn pipeline_ir_abort_cleanup_record_offset(base: i64, fact: i64) -> i64 {
  base + 32 + pipeline_ir_abort_cleanup_fact_record_index(fact) * handler_abort_cleanup_record_size()
}

pub(package) fn pipeline_ir_abort_cleanup_expected_value_offset(base: i64) -> i64 { base + 8 }
pub(package) fn pipeline_ir_abort_cleanup_expected_action_offset(base: i64) -> i64 { base + 16 }
pub(package) fn pipeline_ir_abort_cleanup_link_address_offset(base: i64) -> i64 { base + 24 }

pub(package) fn pipeline_ir_abort_cleanup_emit_sp_address(code: i64, dst: i64, byte_off: i64) -> i64 {
  emit_stack_address_offset(code, dst, byte_off)
}

-- Mutable linear slots need an initialized/uninitialized ownership fact even
-- when no abortive handler is installed. The canonical cleanup record's
-- semantic-action word is otherwise dead while unlinked, so it also carries
-- that exact slot state: the plan action means initialized, zero means moved.
pub(package) fn pipeline_ir_abort_cleanup_emit_set_structural_slot_state(code: i64, fact: i64, action: i64, fm: i64) -> i64 {
  let facts = fmap_current_abort_cleanup_facts(fm)
  if pipeline_ir_abort_cleanup_fact_uses_structural_slot_record(fact, facts) == 0 { 0 }
  else {
    pipeline_ir_abort_cleanup_emit_sp_address(
      code, 15, pipeline_ir_abort_cleanup_record_offset(fmap_current_abort_cleanup_base(fm), fact)
    )
    emit_mov_imm_safe(code, 17, action)
    bu32(code, cg_str(17, 15, handler_abort_cleanup_record_action_offset()))
  }
}

pub(package) fn pipeline_ir_abort_cleanup_emit_function_address(code: i64, target: i64, patch_key: i64, available: i64, fm: i64) -> i64 {
  let direct_off = target - buf_len(code)
  if target > 1 and pipeline_ir_native_adr_offset_fits(direct_off) == 1 {
    let adr_pos = buf_len(code)
    bu32(code, encode_adr(17, target - adr_pos))
  } else {
    -- Adjacent B thunk gives ADR a fixed in-range target and lets the shared
    -- hash patcher resolve forward or distant cleanup functions.
    bu32(code, encode_b(8))
    let thunk = buf_len(code)
    if target > 1 {
      bu32(code, encode_b(target - thunk))
    } else {
      if available == 1 {
        fmap_add_branch_patch_by_hash(fm, thunk, patch_key)
        bu32(code, encode_b(0))
      } else {
        bu32(code, encode_brk(27))
      }
    }
    let adr_pos = buf_len(code)
    bu32(code, encode_adr(17, thunk - adr_pos))
  }
}

pub(package) fn pipeline_ir_abort_cleanup_emit_action_address(code: i64, fact: i64, fm: i64) -> i64 {
  let action = node_f2(fact)
  let kind = node_f3(fact)
  if kind == pipeline_ir_abort_cleanup_direct_kind() {
    let mono_target = mono_cache_lookup(fmap_mono_cache(fm), action)
    let target = if mono_target > 1 { mono_target } else { fmap_lookup_by_hash(fm, action) }
    let available = if mono_target != 0 or fmap_contains_hash(fm, action) == 1 { 1 } else { 0 }
    pipeline_ir_abort_cleanup_emit_function_address(code, target, action, available, fm)
  } else {
    if kind == pipeline_ir_abort_cleanup_array_kind() {
      -- The plan-specific glue may be emitted later in this function. Its
      -- synthetic mono-cache key deliberately permits this forward ADR.
      let target = mono_cache_lookup(fmap_mono_cache(fm), action)
      pipeline_ir_abort_cleanup_emit_function_address(code, if target > 1 { target } else { 0 }, action, 1, fm)
    } else { if kind == pipeline_ir_abort_cleanup_structural_kind() {
      let plan = fmap_structural_drop_plan_lookup(fm, action)
      let storage_mode = pipeline_structural_drop_plan_storage_mode(plan)
      if plan != 0 and pipeline_structural_drop_plan_is_valid(plan) == 1 and storage_mode >= 1 and storage_mode <= 3 {
        let target = pipeline_ir_native_ensure_structural_drop_glue(code, plan, fm)
        pipeline_ir_abort_cleanup_emit_function_address(code, target, action, 1, fm)
      } else {
        fmap_inc_emit_error_count(fm)
        pipeline_ir_abort_cleanup_emit_function_address(code, 0, 0, 0, fm)
      }
    } else {
      let method_hash = cg_drop_method_hash()
      let mm = fmap_mmap(fm)
      let target = mmap_lookup(mm, action, method_hash)
      let patch_key = pipeline_ir_native_method_forward_key(mm, action, method_hash, 0)
      let available = if target > 0 or (patch_key != 0 and mono_cache_lookup(fmap_mono_cache(fm), patch_key) != 0) { 1 } else { 0 }
      pipeline_ir_abort_cleanup_emit_function_address(code, target, patch_key, available, fm)
    } }
  }
}

pub(package) fn pipeline_ir_abort_cleanup_emit_function_entry(code: i64, fm: i64) -> i64 {
  if fmap_current_abort_cleanup_instrumented(fm) == 0 { 0 }
  else {
    bu32(code, cg_ldr(15, 28, runtime_state_abort_cleanup_active_offset()))
    let inactive = buf_len(code)
    bu32(code, 0)
    bu32(code, cg_ldr(16, 28, runtime_state_abort_cleanup_top_offset()))
    emit_store_spill_offset(code, 16, fmap_current_abort_cleanup_boundary(fm))
    cg_patch_cbz(code, inactive, 15, buf_len(code))
  }
}

pub(package) fn pipeline_ir_abort_cleanup_emit_function_exit(code: i64, fm: i64) -> i64 {
  if fmap_current_abort_cleanup_instrumented(fm) == 0 { 0 }
  else {
    bu32(code, cg_ldr(15, 28, runtime_state_abort_cleanup_active_offset()))
    let inactive = buf_len(code)
    bu32(code, 0)
    emit_load_spill_offset(code, 16, fmap_current_abort_cleanup_boundary(fm))
    bu32(code, cg_str(16, 28, runtime_state_abort_cleanup_top_offset()))
    cg_patch_cbz(code, inactive, 15, buf_len(code))
  }
}

pub(package) fn pipeline_ir_abort_cleanup_emit_pack_shadow(code: i64, fact: i64, plan: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let words = typeck_linear_layout_plan_words(plan)
  let value = node_f1(fact)
  let facts = fmap_current_abort_cleanup_facts(fm)
  let shadow = pipeline_ir_abort_cleanup_shadow_offset(fmap_current_abort_cleanup_base(fm), facts, fact, fm)
  if value < 0 or words <= 0 or pipeline_structural_drop_plan_storage_mode(plan) != 2 {
    fmap_inc_emit_error_count(fm)
    bu32(code, encode_brk(67))
  } else {
    for lane in 0..words {
      let value_phys = pipeline_ir_native_load_reg(code, pinned, value + lane)
      pipeline_ir_abort_cleanup_emit_sp_address(code, 15, shadow + lane * 8)
      bu32(code, cg_str(value_phys, 15, 0))
    }
    0
  }
}

pub(package) fn pipeline_ir_abort_cleanup_emit_register_fact(code: i64, fact: i64, value: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  -- x1-x14 are allocator residents. Bookkeeping only reads a value's home
  -- and otherwise stays in the reserved x15-x17 scratch set.
  pipeline_ir_abort_cleanup_emit_disarm_fact(code, fact, fm)
  pipeline_ir_abort_cleanup_emit_set_structural_slot_state(code, fact, node_f2(fact), fm)
  bu32(code, cg_ldr(15, 28, runtime_state_abort_cleanup_active_offset()))
  let inactive = buf_len(code)
  bu32(code, 0)
  pipeline_ir_abort_cleanup_emit_sp_address(code, 17, pipeline_ir_abort_cleanup_record_offset(fmap_current_abort_cleanup_base(fm), fact))
  bu32(code, cg_ldr(15, 28, runtime_state_abort_cleanup_top_offset()))
  bu32(code, cg_str(15, 17, handler_abort_cleanup_record_prev_offset()))
  let structural_plan = pipeline_ir_abort_cleanup_fact_structural_plan(fact, fm)
  let structural_mode = pipeline_structural_drop_plan_storage_mode(structural_plan)
  if structural_mode == 2 {
    pipeline_ir_abort_cleanup_emit_pack_shadow(code, fact, structural_plan, fm, pinned)
    pipeline_ir_abort_cleanup_emit_sp_address(code, 17, pipeline_ir_abort_cleanup_record_offset(fmap_current_abort_cleanup_base(fm), fact))
    pipeline_ir_abort_cleanup_emit_sp_address(
      code, 16,
      pipeline_ir_abort_cleanup_shadow_offset(fmap_current_abort_cleanup_base(fm), fmap_current_abort_cleanup_facts(fm), fact, fm)
    )
    bu32(code, cg_str(16, 17, handler_abort_cleanup_record_value_offset()))
  } else { if node_f3(fact) == pipeline_ir_abort_cleanup_structural_kind() or
    node_f3(fact) == pipeline_ir_abort_cleanup_owned_kind() or node_tag(fact) == value {
    let value_phys = pipeline_ir_native_load_reg(code, pinned, value)
    bu32(code, cg_str(value_phys, 17, handler_abort_cleanup_record_value_offset()))
  } else { 0 } }
  pipeline_ir_abort_cleanup_emit_sp_address(code, 15, pipeline_ir_abort_cleanup_record_offset(fmap_current_abort_cleanup_base(fm), fact))
  pipeline_ir_abort_cleanup_emit_action_address(code, fact, fm)
  bu32(code, cg_str(17, 15, handler_abort_cleanup_record_fn_offset()))
  emit_mov_imm_safe(code, 17, node_f2(fact))
  bu32(code, cg_str(17, 15, handler_abort_cleanup_record_action_offset()))
  bu32(code, cg_str(27, 15, handler_abort_cleanup_record_handler_offset()))
  emit_mov_imm_safe(code, 17, pipeline_ir_abort_cleanup_fact_origin(fact))
  bu32(code, cg_str(17, 15, handler_abort_cleanup_record_origin_offset()))
  bu32(code, cg_str(15, 28, runtime_state_abort_cleanup_top_offset()))
  cg_patch_cbz(code, inactive, 15, buf_len(code))
}

pub(package) fn pipeline_ir_abort_cleanup_emit_register_site_from(code: i64, facts: i64, site: i64, index: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  if facts == 0 or index >= nlist_len(facts) { 0 }
  else {
    let fact = nlist_get(facts, index)
    if node_tag(fact) == site { pipeline_ir_abort_cleanup_emit_register_fact(code, fact, node_f1(fact), fm, pinned) } else { 0 }
    pipeline_ir_abort_cleanup_emit_register_site_from(code, facts, site, index + 1, fm, pinned)
  }
}

pub(package) fn pipeline_ir_abort_cleanup_emit_register_site(code: i64, site: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  if site == 0 - 1 { 0 }
  else { pipeline_ir_abort_cleanup_emit_register_site_from(code, fmap_current_abort_cleanup_facts(fm), site, 0, fm, pinned) }
}

-- A retain's cleanup value is an INPUT while the acquisition site is the
-- call's result SSA. Stage that input before the call, while the allocator's
-- ordinary argument liveness still guarantees its home; link the prepared
-- record only after the call returns successfully.
pub(package) fn pipeline_ir_abort_cleanup_emit_prepare_site_from(code: i64, facts: i64, site: i64, index: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  if facts == 0 or index >= nlist_len(facts) { 0 }
  else {
    let fact = nlist_get(facts, index)
    if node_tag(fact) == site and node_f1(fact) != site and node_f3(fact) != pipeline_ir_abort_cleanup_structural_kind() {
      pipeline_ir_abort_cleanup_emit_sp_address(code, 17, pipeline_ir_abort_cleanup_record_offset(fmap_current_abort_cleanup_base(fm), fact))
      let value_phys = pipeline_ir_native_load_reg(code, pinned, node_f1(fact))
      bu32(code, cg_str(value_phys, 17, handler_abort_cleanup_record_value_offset()))
    } else { 0 }
    pipeline_ir_abort_cleanup_emit_prepare_site_from(code, facts, site, index + 1, fm, pinned)
  }
}

pub(package) fn pipeline_ir_abort_cleanup_emit_prepare_site(code: i64, site: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  if site == 0 - 1 { 0 }
  else { pipeline_ir_abort_cleanup_emit_prepare_site_from(code, fmap_current_abort_cleanup_facts(fm), site, 0, fm, pinned) }
}

pub(package) fn pipeline_ir_abort_cleanup_emit_advance_active_boundaries(code: i64, target_reg: i64, prev_reg: i64) -> i64 {
  -- Handler frames remember the cleanup-chain head at entry. Splicing that
  -- exact record must advance every active saved boundary as well, or a later
  -- abort walk searches for a detached node and reaches null. Deferred
  -- prompts use 1 as a recording-only sentinel when no abortive handler frame
  -- exists; it is a guard, not a dereferenceable frame-chain link.
  bu32(code, cg_ldr(16, 28, runtime_state_abort_cleanup_active_offset()))
  let scan = buf_len(code)
  bu32(code, encode_cmp(16, 31))
  let done_null = buf_len(code)
  bu32(code, 0)
  emit_mov_imm_safe(code, 10, 1)
  bu32(code, encode_cmp(16, 10))
  let done_sentinel = buf_len(code)
  bu32(code, 0)
  bu32(code, cg_ldr(10, 16, handler_frame_abort_cleanup_boundary_offset()))
  bu32(code, encode_cmp(10, target_reg))
  let keep = buf_len(code)
  bu32(code, 0)
  bu32(code, cg_str(prev_reg, 16, handler_frame_abort_cleanup_boundary_offset()))
  cg_patch_b_cond(code, keep, 1, buf_len(code))
  bu32(code, cg_ldr(16, 16, handler_frame_abort_prev_active_offset()))
  let back = buf_len(code)
  bu32(code, encode_b(scan - back))
  let done = buf_len(code)
  cg_patch_b_cond(code, done_null, 0, done)
  cg_patch_b_cond(code, done_sentinel, 0, done)
}

pub(package) fn pipeline_ir_abort_cleanup_emit_disarm_fact_with_boundary_advance(code: i64, fact: i64, fm: i64, advance_active: i64) -> i64 {
  if fact == 0 { 0 }
  else {
    bu32(code, cg_ldr(15, 28, runtime_state_abort_cleanup_active_offset()))
    let inactive = buf_len(code)
    bu32(code, 0)
    bu32(code, encode_add_imm(15, 28, runtime_state_abort_cleanup_top_offset()))
    emit_store_spill_offset(code, 15, pipeline_ir_abort_cleanup_link_address_offset(fmap_current_abort_cleanup_base(fm)))
    pipeline_ir_abort_cleanup_emit_sp_address(code, 16, pipeline_ir_abort_cleanup_record_offset(fmap_current_abort_cleanup_base(fm), fact))
    emit_store_spill_offset(code, 16, pipeline_ir_abort_cleanup_expected_value_offset(fmap_current_abort_cleanup_base(fm)))
    bu32(code, encode_add_imm(15, 28, runtime_state_abort_cleanup_top_offset()))
    bu32(code, cg_ldr(15, 15, 0))
    let scan = buf_len(code)
    bu32(code, encode_cmp(15, 31))
    let done_empty = buf_len(code)
    bu32(code, 0)
    emit_load_spill_offset(code, 16, fmap_current_abort_cleanup_boundary(fm))
    bu32(code, encode_cmp(15, 16))
    let done_boundary = buf_len(code)
    bu32(code, 0)
    emit_load_spill_offset(code, 16, pipeline_ir_abort_cleanup_expected_value_offset(fmap_current_abort_cleanup_base(fm)))
    bu32(code, encode_cmp(15, 16))
    let found = buf_len(code)
    bu32(code, 0)
    bu32(code, encode_add_imm(17, 15, handler_abort_cleanup_record_prev_offset()))
    emit_store_spill_offset(code, 17, pipeline_ir_abort_cleanup_link_address_offset(fmap_current_abort_cleanup_base(fm)))
    bu32(code, cg_ldr(15, 15, handler_abort_cleanup_record_prev_offset()))
    let scan_back = buf_len(code)
    bu32(code, encode_b(scan - scan_back))
    let splice = buf_len(code)
    cg_patch_b_cond(code, found, 0, splice)
    emit_load_spill_offset(code, 16, pipeline_ir_abort_cleanup_link_address_offset(fmap_current_abort_cleanup_base(fm)))
    bu32(code, cg_ldr(17, 15, handler_abort_cleanup_record_prev_offset()))
    bu32(code, cg_str(17, 16, 0))
    if advance_active == 1 { pipeline_ir_abort_cleanup_emit_advance_active_boundaries(code, 15, 17) } else { 0 }
    let done = buf_len(code)
    cg_patch_b_cond(code, done_empty, 0, done)
    cg_patch_b_cond(code, done_boundary, 0, done)
    cg_patch_cbz(code, inactive, 15, done)
    pipeline_ir_abort_cleanup_emit_set_structural_slot_state(code, fact, 0, fm)
  }
}

pub(package) fn pipeline_ir_abort_cleanup_emit_disarm_fact(code: i64, fact: i64, fm: i64) -> i64 {
  pipeline_ir_abort_cleanup_emit_disarm_fact_with_boundary_advance(code, fact, fm, 0)
}

pub(package) fn pipeline_ir_abort_cleanup_emit_disarm_transferred_fact(code: i64, fact: i64, fm: i64) -> i64 {
  pipeline_ir_abort_cleanup_emit_disarm_fact_with_boundary_advance(code, fact, fm, 1)
}

-- Remove one dynamic obligation matching (value, cleanup function). This is
-- deliberately a one-record operation: two retains of the same pointer are
-- two counts and two records, and one ordinary release consumes only one.
pub(package) fn pipeline_ir_abort_cleanup_emit_disarm_action_phys(code: i64, value_phys: i64, action: i64, fm: i64) -> i64 {
  if action == 0 { 0 }
  else {
    emit_store_spill_offset(code, value_phys, pipeline_ir_abort_cleanup_expected_value_offset(fmap_current_abort_cleanup_base(fm)))
    emit_mov_imm_safe(code, 17, action)
    emit_store_spill_offset(code, 17, pipeline_ir_abort_cleanup_expected_action_offset(fmap_current_abort_cleanup_base(fm)))
    bu32(code, cg_ldr(15, 28, runtime_state_abort_cleanup_active_offset()))
    let inactive = buf_len(code)
    bu32(code, 0)
    bu32(code, encode_add_imm(15, 28, runtime_state_abort_cleanup_top_offset()))
    emit_store_spill_offset(code, 15, pipeline_ir_abort_cleanup_link_address_offset(fmap_current_abort_cleanup_base(fm)))
    bu32(code, cg_ldr(15, 15, 0))
    let scan = buf_len(code)
    bu32(code, encode_cmp(15, 31))
    let done_empty = buf_len(code)
    bu32(code, 0)
    emit_load_spill_offset(code, 16, fmap_current_abort_cleanup_boundary(fm))
    bu32(code, encode_cmp(15, 16))
    let done_boundary = buf_len(code)
    bu32(code, 0)
    emit_load_spill_offset(code, 16, pipeline_ir_abort_cleanup_expected_value_offset(fmap_current_abort_cleanup_base(fm)))
    bu32(code, cg_ldr(17, 15, handler_abort_cleanup_record_value_offset()))
    bu32(code, encode_cmp(17, 16))
    let advance_value = buf_len(code)
    bu32(code, 0)
    emit_load_spill_offset(code, 16, pipeline_ir_abort_cleanup_expected_action_offset(fmap_current_abort_cleanup_base(fm)))
    bu32(code, cg_ldr(17, 15, handler_abort_cleanup_record_action_offset()))
    bu32(code, encode_cmp(17, 16))
    let found = buf_len(code)
    bu32(code, 0)
    let advance = buf_len(code)
    cg_patch_b_cond(code, advance_value, 1, advance)
    bu32(code, encode_add_imm(17, 15, handler_abort_cleanup_record_prev_offset()))
    emit_store_spill_offset(code, 17, pipeline_ir_abort_cleanup_link_address_offset(fmap_current_abort_cleanup_base(fm)))
    bu32(code, cg_ldr(15, 15, handler_abort_cleanup_record_prev_offset()))
    let scan_back = buf_len(code)
    bu32(code, encode_b(scan - scan_back))
    let splice = buf_len(code)
    cg_patch_b_cond(code, found, 0, splice)
    emit_load_spill_offset(code, 16, pipeline_ir_abort_cleanup_link_address_offset(fmap_current_abort_cleanup_base(fm)))
    bu32(code, cg_ldr(17, 15, handler_abort_cleanup_record_prev_offset()))
    bu32(code, cg_str(17, 16, 0))
    let done = buf_len(code)
    cg_patch_b_cond(code, done_empty, 0, done)
    cg_patch_b_cond(code, done_boundary, 0, done)
    cg_patch_cbz(code, inactive, 15, done)
  }
}

pub(package) fn pipeline_ir_abort_cleanup_emit_disarm_action(code: i64, value: i64, action: i64, kind: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  if value < 0 or action == 0 { 0 }
  else {
    let value_phys = pipeline_ir_native_load_reg(code, pinned, value)
    pipeline_ir_abort_cleanup_emit_disarm_action_phys(code, value_phys, action, fm)
    let fact = pipeline_ir_abort_cleanup_find_acquisition_value_action_kind(
      fmap_current_abort_cleanup_facts(fm), value, action, kind
    )
    pipeline_ir_abort_cleanup_emit_set_structural_slot_state(code, fact, 0, fm)
  }
}

-- Retag the nearest live current-frame obligation before an indirect by-value
-- call. The dynamic chain is authoritative at this point: branch aliases may
-- name one static shadow slot while another predecessor's exact slot is
-- linked. Parameters forwarded from an outer frame are already transport
-- records and therefore need no retag when the local scan reaches its entry
-- boundary.
pub(package) fn pipeline_ir_abort_cleanup_emit_mark_action_origin(code: i64, value: i64, action: i64, origin: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  if value < 0 or action == 0 or
    (ir_managed_stake_origin_is_valid(origin) == 0 and
      origin != pipeline_ir_abort_cleanup_origin_indirect_transfer_pending() and
      pipeline_ir_abort_cleanup_origin_is_direct_transfer_pending(origin) == 0) { 0 }
  else {
    let value_phys = pipeline_ir_native_load_reg(code, pinned, value)
    emit_store_spill_offset(code, value_phys, pipeline_ir_abort_cleanup_expected_value_offset(fmap_current_abort_cleanup_base(fm)))
    emit_mov_imm_safe(code, 17, action)
    emit_store_spill_offset(code, 17, pipeline_ir_abort_cleanup_expected_action_offset(fmap_current_abort_cleanup_base(fm)))
    bu32(code, cg_ldr(15, 28, runtime_state_abort_cleanup_active_offset()))
    let inactive = buf_len(code)
    bu32(code, 0)
    bu32(code, cg_ldr(15, 28, runtime_state_abort_cleanup_top_offset()))
    let scan = buf_len(code)
    bu32(code, encode_cmp(15, 31))
    let done_empty = buf_len(code)
    bu32(code, 0)
    emit_load_spill_offset(code, 16, fmap_current_abort_cleanup_boundary(fm))
    bu32(code, encode_cmp(15, 16))
    let done_boundary = buf_len(code)
    bu32(code, 0)
    emit_load_spill_offset(code, 16, pipeline_ir_abort_cleanup_expected_value_offset(fmap_current_abort_cleanup_base(fm)))
    bu32(code, cg_ldr(17, 15, handler_abort_cleanup_record_value_offset()))
    bu32(code, encode_cmp(17, 16))
    let advance_value = buf_len(code)
    bu32(code, 0)
    emit_load_spill_offset(code, 16, pipeline_ir_abort_cleanup_expected_action_offset(fmap_current_abort_cleanup_base(fm)))
    bu32(code, cg_ldr(17, 15, handler_abort_cleanup_record_action_offset()))
    bu32(code, encode_cmp(17, 16))
    let advance_action = buf_len(code)
    bu32(code, 0)
    bu32(code, cg_ldr(17, 15, handler_abort_cleanup_record_origin_offset()))
    emit_mov_imm_safe(code, 16, origin)
    bu32(code, encode_cmp(17, 16))
    let advance_origin = buf_len(code)
    bu32(code, 0)
    let found = buf_len(code)
    bu32(code, 0)
    let advance = buf_len(code)
    cg_patch_b_cond(code, advance_value, 1, advance)
    cg_patch_b_cond(code, advance_action, 1, advance)
    cg_patch_b_cond(code, advance_origin, 0, advance)
    bu32(code, cg_ldr(15, 15, handler_abort_cleanup_record_prev_offset()))
    let scan_back = buf_len(code)
    bu32(code, encode_b(scan - scan_back))
    let mark = buf_len(code)
    cg_patch_b(code, found, mark)
    emit_mov_imm_safe(code, 17, origin)
    bu32(code, cg_str(17, 15, handler_abort_cleanup_record_origin_offset()))
    let done = buf_len(code)
    cg_patch_b_cond(code, done_empty, 0, done)
    cg_patch_b_cond(code, done_boundary, 0, done)
    cg_patch_cbz(code, inactive, 15, done)
  }
}

-- A returned call commits every transfer carrying its exact pending origin.
-- Splicing happens only after successful return; suspension or abort before
-- that point leaves each original obligation armed.
pub(package) fn pipeline_ir_abort_cleanup_emit_commit_pending_transfers(code: i64, origin: i64, fm: i64) -> i64 {
  bu32(code, cg_ldr(15, 28, runtime_state_abort_cleanup_active_offset()))
  let inactive = buf_len(code)
  bu32(code, 0)
  bu32(code, encode_add_imm(15, 28, runtime_state_abort_cleanup_top_offset()))
  emit_store_spill_offset(code, 15, pipeline_ir_abort_cleanup_link_address_offset(fmap_current_abort_cleanup_base(fm)))
  bu32(code, cg_ldr(15, 15, 0))
  let scan = buf_len(code)
  bu32(code, encode_cmp(15, 31))
  let done_empty = buf_len(code)
  bu32(code, 0)
  emit_load_spill_offset(code, 16, fmap_current_abort_cleanup_boundary(fm))
  bu32(code, encode_cmp(15, 16))
  let done_boundary = buf_len(code)
  bu32(code, 0)
  bu32(code, cg_ldr(17, 15, handler_abort_cleanup_record_origin_offset()))
  emit_mov_imm_safe(code, 16, origin)
  bu32(code, encode_cmp(17, 16))
  let advance_origin = buf_len(code)
  bu32(code, 0)
  emit_load_spill_offset(code, 16, pipeline_ir_abort_cleanup_link_address_offset(fmap_current_abort_cleanup_base(fm)))
  bu32(code, cg_ldr(17, 15, handler_abort_cleanup_record_prev_offset()))
  bu32(code, cg_str(17, 16, 0))
  bu32(code, cg_ldr(15, 16, 0))
  let splice_back = buf_len(code)
  bu32(code, encode_b(scan - splice_back))
  let advance = buf_len(code)
  cg_patch_b_cond(code, advance_origin, 1, advance)
  bu32(code, encode_add_imm(17, 15, handler_abort_cleanup_record_prev_offset()))
  emit_store_spill_offset(code, 17, pipeline_ir_abort_cleanup_link_address_offset(fmap_current_abort_cleanup_base(fm)))
  bu32(code, cg_ldr(15, 15, handler_abort_cleanup_record_prev_offset()))
  let advance_back = buf_len(code)
  bu32(code, encode_b(scan - advance_back))
  let done = buf_len(code)
  cg_patch_b_cond(code, done_empty, 0, done)
  cg_patch_b_cond(code, done_boundary, 0, done)
  cg_patch_cbz(code, inactive, 15, done)
}

pub(package) fn pipeline_ir_abort_cleanup_emit_commit_pending_indirect_transfers(code: i64, fm: i64) -> i64 {
  pipeline_ir_abort_cleanup_emit_commit_pending_transfers(
    code, pipeline_ir_abort_cleanup_origin_indirect_transfer_pending(), fm
  )
}

-- Retains which could not be elided are already labelled call-transport by
-- lowering. Immediately before an indirect call, move those current-frame
-- obligations into the same pending state as retain-elided transfers. The
-- caller can then commit one uniform set after return, while abort keeps the
-- whole set armed.
pub(package) fn pipeline_ir_abort_cleanup_emit_prepare_indirect_transports(code: i64, fm: i64) -> i64 {
  bu32(code, cg_ldr(15, 28, runtime_state_abort_cleanup_active_offset()))
  let inactive = buf_len(code)
  bu32(code, 0)
  bu32(code, cg_ldr(15, 28, runtime_state_abort_cleanup_top_offset()))
  let scan = buf_len(code)
  bu32(code, encode_cmp(15, 31))
  let done_empty = buf_len(code)
  bu32(code, 0)
  emit_load_spill_offset(code, 16, fmap_current_abort_cleanup_boundary(fm))
  bu32(code, encode_cmp(15, 16))
  let done_boundary = buf_len(code)
  bu32(code, 0)
  bu32(code, cg_ldr(17, 15, handler_abort_cleanup_record_origin_offset()))
  emit_mov_imm_safe(code, 16, ir_managed_stake_origin_call_transport())
  bu32(code, encode_cmp(17, 16))
  let advance_origin = buf_len(code)
  bu32(code, 0)
  emit_mov_imm_safe(code, 17, pipeline_ir_abort_cleanup_origin_indirect_transfer_pending())
  bu32(code, cg_str(17, 15, handler_abort_cleanup_record_origin_offset()))
  let advance = buf_len(code)
  cg_patch_b_cond(code, advance_origin, 1, advance)
  bu32(code, cg_ldr(15, 15, handler_abort_cleanup_record_prev_offset()))
  let scan_back = buf_len(code)
  bu32(code, encode_b(scan - scan_back))
  let done = buf_len(code)
  cg_patch_b_cond(code, done_empty, 0, done)
  cg_patch_b_cond(code, done_boundary, 0, done)
  cg_patch_cbz(code, inactive, 15, done)
}

pub(package) fn pipeline_ir_abort_cleanup_emit_disarm_direct(code: i64, value: i64, callee_hash: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  if pipeline_ir_abort_cleanup_is_direct_action_hash(callee_hash) == 1 {
    pipeline_ir_abort_cleanup_emit_disarm_action(code, value, callee_hash, pipeline_ir_abort_cleanup_direct_kind(), fm, pinned)
  } else { 0 }
}

pub(package) fn pipeline_ir_abort_cleanup_emit_disarm_owned(code: i64, value: i64, type_hash: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  pipeline_ir_abort_cleanup_emit_disarm_action(code, value, type_hash, pipeline_ir_abort_cleanup_owned_kind(), fm, pinned)
}

pub(package) fn pipeline_ir_abort_cleanup_emit_disarm_structural(code: i64, value: i64, plan: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let action = pipeline_structural_drop_glue_hash(plan)
  if pipeline_structural_drop_plan_storage_mode(plan) == 2 {
    let fact = pipeline_ir_abort_cleanup_find_acquisition_value_action_kind(
      fmap_current_abort_cleanup_facts(fm), value, action, pipeline_ir_abort_cleanup_structural_kind()
    )
    if fact == 0 { 0 }
    else {
      pipeline_ir_abort_cleanup_emit_sp_address(
        code, 16,
        pipeline_ir_abort_cleanup_shadow_offset(fmap_current_abort_cleanup_base(fm), fmap_current_abort_cleanup_facts(fm), fact, fm)
      )
      pipeline_ir_abort_cleanup_emit_disarm_action_phys(code, 16, action, fm)
      pipeline_ir_abort_cleanup_emit_set_structural_slot_state(code, fact, 0, fm)
    }
  } else {
    pipeline_ir_abort_cleanup_emit_disarm_action(code, value, action, pipeline_ir_abort_cleanup_structural_kind(), fm, pinned)
  }
}

-- A successful by-value linear transfer consumes a statically identified
-- obligation after the call has returned. Its argument SSA is dead at that
-- point and may occupy a caller-clobbered register, so splice the exact shadow
-- record rather than trying to reload and dynamically match the old value.
pub(package) fn pipeline_ir_abort_cleanup_emit_disarm_linear_fact(code: i64, value: i64, action: i64, kind: i64, fm: i64) -> i64 {
  let fact = pipeline_ir_abort_cleanup_find_linear_transfer_fact(
    fmap_current_abort_cleanup_facts(fm), value, action, kind
  )
  if fact == 0 { 0 } else { pipeline_ir_abort_cleanup_emit_disarm_transferred_fact(code, fact, fm) }
}

pub(package) fn pipeline_ir_abort_cleanup_emit_disarm_array(code: i64, data: i64, leaf_count: i64, leaf_stride: i64, leaf_kind: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  if pipeline_array_drop_plan_is_active(leaf_count, leaf_stride, leaf_kind) == 1 {
    pipeline_ir_abort_cleanup_emit_disarm_action(code, data, pipeline_array_drop_glue_hash(leaf_count, leaf_stride, leaf_kind), pipeline_ir_abort_cleanup_array_kind(), fm, pinned)
  } else { 0 }
}

-- Aggregate construction commits each transported field stake to the freshly
-- created aggregate. Before this point an abort must clean the standalone
-- stake; afterwards the aggregate's deep release owns that obligation. Splice
-- the standalone record only after every field store has completed, while the
-- constructor's own result record is registered by the ordinary post-inst
-- hook immediately afterwards.
pub(package) fn pipeline_ir_abort_cleanup_mask_cleanup_kind(mask: i64, word: i64) -> i64 {
  let encoded = if word < 0 or word >= 16 { 0 } else { (mask bshr (word * 2)) band 3 }
  if encoded == 1 { continuation_cleanup_kind_rc() }
  else { if encoded == 2 { continuation_cleanup_kind_closure() }
  else { if encoded == 3 { continuation_cleanup_kind_weak() }
  else { continuation_cleanup_kind_none() } } }
}

pub(package) fn pipeline_ir_abort_cleanup_emit_commit_managed_value(code: i64, value: i64, cleanup_kind: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let release_hash = pipeline_managed_release_hash_for_kind(cleanup_kind)
  if release_hash == 0 { 0 }
  else { pipeline_ir_abort_cleanup_emit_disarm_direct(code, value, release_hash, fm, pinned) }
}

pub(package) fn pipeline_ir_abort_cleanup_emit_commit_variant_payloads(code: i64, payloads: IrValueList, field_mask: i64, index: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  match payloads {
    IrValueNil -> 0
    IrValueCons(value, rest) -> {
      -- Variant word zero is the tag; payload lane zero occupies word one.
      pipeline_ir_abort_cleanup_emit_commit_managed_value(code, value, pipeline_ir_abort_cleanup_mask_cleanup_kind(field_mask, index + 1), fm, pinned)
      pipeline_ir_abort_cleanup_emit_commit_variant_payloads(code, rest, field_mask, index + 1, fm, pinned)
    }
  }
}

pub(package) fn pipeline_ir_abort_cleanup_emit_commit_record_fields(code: i64, fields: IrRecordFieldList, field_mask: i64, index: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  match fields {
    IrRecordFieldNil -> 0
    IrRecordFieldCons(field_hash, word_offset, value, rest) -> {
      let word = if word_offset >= 0 { word_offset } else { index }
      pipeline_ir_abort_cleanup_emit_commit_managed_value(code, value, pipeline_ir_abort_cleanup_mask_cleanup_kind(field_mask, word), fm, pinned)
      pipeline_ir_abort_cleanup_emit_commit_record_fields(code, rest, field_mask, index + 1, fm, pinned)
    }
  }
}

pub(package) fn pipeline_ir_abort_cleanup_emit_commit_record_layout_fields(code: i64, fields: IrRecordLayoutFieldList, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  match fields {
    IrRecordLayoutFieldNil -> 0
    IrRecordLayoutFieldWord(field_hash, byte_offset, value, managed_kind, rest) -> {
      pipeline_ir_abort_cleanup_emit_commit_managed_value(code, value, managed_kind, fm, pinned)
      pipeline_ir_abort_cleanup_emit_commit_record_layout_fields(code, rest, fm, pinned)
    }
    IrRecordLayoutFieldArray(field_hash, byte_offset, storage, byte_size, leaf_count, leaf_stride, leaf_kind, rest) -> {
      -- Described records copy array bytes and retain their leaves. The source
      -- storage handle remains a standalone temporary consumed by the explicit
      -- aggregate-origin release which follows the constructor.
      pipeline_ir_abort_cleanup_emit_commit_record_layout_fields(code, rest, fm, pinned)
    }
  }
}

pub(package) fn pipeline_ir_abort_cleanup_emit_structural_commit_failure(code: i64, fm: i64) -> i64 {
  fmap_inc_emit_error_count(fm)
  bu32(code, encode_brk(67))
}

pub(package) fn pipeline_ir_abort_cleanup_emit_commit_structural_leaf(code: i64, value: i64, plan: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let kind = typeck_linear_layout_plan_kind(plan)
  if value < 0 or pipeline_structural_drop_plan_is_valid(plan) == 0 {
    pipeline_ir_abort_cleanup_emit_structural_commit_failure(code, fm)
  } else { if kind == 1 {
    if pipeline_linear_cleanup_plan_uses_structural_glue(plan) == 1 {
      pipeline_ir_abort_cleanup_emit_disarm_structural(code, value, plan, fm, pinned)
    } else {
      pipeline_ir_abort_cleanup_emit_disarm_owned(code, value, cg_owned_drop_type_hash(typeck_linear_layout_plan_type(plan)), fm, pinned)
    }
  } else { if kind == 4 or kind == 5 {
    pipeline_ir_abort_cleanup_emit_disarm_structural(code, value, plan, fm, pinned)
  } else { if kind == 6 {
    pipeline_ir_abort_cleanup_emit_commit_structural_leaf(code, value, typeck_linear_layout_plan_children(plan), fm, pinned)
  } else {
    pipeline_ir_abort_cleanup_emit_structural_commit_failure(code, fm)
  } } } }
}

pub(package) fn pipeline_ir_abort_cleanup_emit_commit_flat_value(code: i64, value: i64, plan: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let kind = typeck_linear_layout_plan_kind(plan)
  if kind == 6 and pipeline_structural_drop_plan_storage_mode(plan) == 2 {
    pipeline_ir_abort_cleanup_emit_commit_flat_value(code, value, typeck_linear_layout_plan_children(plan), fm, pinned)
  } else { if kind == 2 or kind == 3 {
    let children = typeck_linear_layout_plan_children(plan)
    let mut i = 0
    while i < nlist_len(children) {
      let component = nlist_get(children, i)
      pipeline_ir_abort_cleanup_emit_commit_flat_value(
        code,
        value + typeck_linear_layout_component_offset(component),
        typeck_linear_layout_component_plan(component),
        fm,
        pinned
      )
      i = i + 1
    }
    0
  } else {
    pipeline_ir_abort_cleanup_emit_commit_structural_leaf(code, value, plan, fm, pinned)
  } }
}

-- Consume every whole-value record which may supply a typed linear transfer.
-- A direct or mutable-slot fact identifies one exact record; CFG aliases name
-- the finite predecessor records behind a merge SSA. Exactly one alias is
-- armed at runtime, so it is safe to emit every statically known splice.
pub(package) fn pipeline_ir_abort_cleanup_emit_linear_transfer_facts(code: i64, value: i64, plan: i64, fm: i64) -> i64 {
  let kind = pipeline_ir_abort_cleanup_plan_owning_kind(plan)
  let action = pipeline_ir_abort_cleanup_plan_action(plan)
  let facts = fmap_current_abort_cleanup_facts(fm)
  let source = pipeline_ir_abort_cleanup_find_linear_transfer_fact(facts, value, action, kind)
  if source != 0 {
    pipeline_ir_abort_cleanup_emit_disarm_transferred_fact(code, source, fm)
  } else { 0 }
  let aliases = pipeline_ir_abort_cleanup_emit_rebind_flow_aliases_from(code, facts, value, action, 0, fm)
  (if source != 0 { 1 } else { 0 }) + aliases
}

pub(package) fn pipeline_ir_abort_cleanup_emit_transfer_flat_value(code: i64, value: i64, plan: i64, fm: i64) -> i64 {
  let kind = typeck_linear_layout_plan_kind(plan)
  if kind == 6 {
    pipeline_ir_abort_cleanup_emit_transfer_flat_value(
      code, value, typeck_linear_layout_plan_children(plan), fm
    )
  } else { if kind == 2 or kind == 3 {
    let children = typeck_linear_layout_plan_children(plan)
    let mut transferred = 0
    let mut i = 0
    while i < nlist_len(children) {
      let component = nlist_get(children, i)
      transferred = transferred + pipeline_ir_abort_cleanup_emit_transfer_flat_value(
        code,
        value + typeck_linear_layout_component_offset(component),
        typeck_linear_layout_component_plan(component),
        fm
      )
      i = i + 1
    }
    transferred
  } else {
    pipeline_ir_abort_cleanup_emit_linear_transfer_facts(code, value, plan, fm)
  } }
}

-- Transfer one typed linear value into an effect clause. Like an ordinary
-- call, this consumes the exact caller-side abort record before dispatch; the
-- clause's typed parameter bind arms the replacement. Zero-cost flattened
-- aggregates have no whole-value record, so consume their owned leaf records
-- after every whole-value and CFG alternative has been ruled out.
pub(package) fn pipeline_ir_abort_cleanup_emit_effect_transfer(code: i64, value: i64, plan: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  pipeline_ir_abort_cleanup_emit_linear_transfer_facts(code, value, plan, fm)
  if typeck_linear_layout_plan_kind(plan) != 1 {
    -- A zero-cost wrapper may have both its whole-value record and an older
    -- child record over the same SSA lanes. Moving the wrapper consumes both
    -- layers: the destination clause arms exactly one replacement owner.
    pipeline_ir_abort_cleanup_emit_transfer_flat_value(code, value, plan, fm)
  } else { 0 }
}

pub(package) fn pipeline_ir_abort_cleanup_emit_rewrap_acquire(code: i64, value: i64, plan: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  -- A zero-cost opaque constructor can wrap a representation whose surface
  -- type carries no linear plan even though its defining runtime call
  -- acquired a tracked resource (for example an RC-backed runtime state
  -- returned as i64). Transfer that exact producer record before arming the
  -- wrapper. Matching the acquisition site, rather than runtime value bits,
  -- preserves distinct stakes whose pointers happen to compare equal.
  pipeline_ir_abort_cleanup_emit_source_site_acquisitions_from(
    code, fmap_current_abort_cleanup_facts(fm), value, 0, fm
  )
  let fact = pipeline_ir_abort_cleanup_find_acquisition_value_action_kind(
    fmap_current_abort_cleanup_facts(fm),
    value,
    pipeline_ir_abort_cleanup_plan_action(plan),
    pipeline_ir_abort_cleanup_plan_owning_kind(plan)
  )
  if fact == 0 {
    fmap_inc_emit_error_count(fm)
    bu32(code, encode_brk(67))
  } else {
    pipeline_ir_abort_cleanup_emit_register_fact(code, fact, value, fm, pinned)
  }
}

pub(package) fn pipeline_ir_abort_cleanup_emit_source_site_acquisitions_from(
  code: i64,
  facts: i64,
  value: i64,
  index: i64,
  fm: i64
) -> i64 {
  if facts == 0 or index >= nlist_len(facts) { 0 }
  else {
    let fact = nlist_get(facts, index)
    let kind = node_f3(fact)
    let source = if node_tag(fact) == value and node_f1(fact) == value and
      (kind == pipeline_ir_abort_cleanup_direct_kind() or
        kind == pipeline_ir_abort_cleanup_owned_kind() or
        kind == pipeline_ir_abort_cleanup_structural_kind() or
        kind == pipeline_ir_abort_cleanup_array_kind()) {
      pipeline_ir_abort_cleanup_emit_disarm_transferred_fact(code, fact, fm)
      1
    } else { 0 }
    source + pipeline_ir_abort_cleanup_emit_source_site_acquisitions_from(
      code, facts, value, index + 1, fm
    )
  }
}

pub(package) fn pipeline_ir_abort_cleanup_emit_rebind_flow_aliases_from(code: i64, facts: i64, value: i64, action: i64, index: i64, fm: i64) -> i64 {
  if facts == 0 or index >= nlist_len(facts) { 0 }
  else {
    let fact = nlist_get(facts, index)
    let matched = if node_f1(fact) == value and node_f2(fact) == action and
      node_f3(fact) == pipeline_ir_abort_cleanup_flow_alias_kind() {
      pipeline_ir_abort_cleanup_emit_disarm_transferred_fact(code, fact, fm)
      1
    } else { 0 }
    matched + pipeline_ir_abort_cleanup_emit_rebind_flow_aliases_from(code, facts, value, action, index + 1, fm)
  }
}

pub(package) fn pipeline_ir_abort_cleanup_emit_disarm_rewrap_site_from(
  code: i64,
  facts: i64,
  site: i64,
  index: i64,
  fm: i64
) -> i64 {
  if facts == 0 or index >= nlist_len(facts) { 0 }
  else {
    let fact = nlist_get(facts, index)
    let kind = node_f3(fact)
    let matched = if node_tag(fact) == site and
      (kind == pipeline_ir_abort_cleanup_owned_kind() or
        kind == pipeline_ir_abort_cleanup_structural_kind()) {
      pipeline_ir_abort_cleanup_emit_disarm_transferred_fact(code, fact, fm)
      1
    } else { 0 }
    matched + pipeline_ir_abort_cleanup_emit_disarm_rewrap_site_from(
      code, facts, site, index + 1, fm
    )
  }
}

-- A merge bind installs a fresh canonical obligation for its result SSA.
-- Detach whichever predecessor record supplied that value immediately before
-- the bind registers its replacement. A zero-cost flat aggregate instead
-- arrives as independently armed child values; consume those leaf records
-- before arming the aggregate record so abort never observes both owners.
pub(package) fn pipeline_ir_abort_cleanup_emit_bind_transfer(
  code: i64,
  value: i64,
  ns: i64,
  ty: i64,
  fm: i64,
  pinned: PipelineIrNativeValueHomeFacts
) -> i64 {
  let facts = fmap_current_abort_cleanup_facts(fm)
  let bind = pipeline_ir_abort_cleanup_find_linear_acquisition_site(
    facts, pipeline_ir_abort_cleanup_owned_bind_site(value, ns)
  )
  if bind == 0 { 0 }
  else {
    -- A constructor result may be a bare zero-cost opaque value while the
    -- lexical binding gives that same representation an `owned` type. The
    -- two plans intentionally have distinct cleanup identities. Consume the
    -- compiler-owned rewrap record by its acquisition site before arming the
    -- binding's final owner; matching only the destination action would leave
    -- both records live.
    let rewrapped = pipeline_ir_abort_cleanup_emit_disarm_rewrap_site_from(
      code, facts, pipeline_ir_abort_cleanup_rewrap_site(value), 0, fm
    )
    let aliases = pipeline_ir_abort_cleanup_emit_rebind_flow_aliases_from(
      code, facts, value, node_f2(bind), 0, fm
    )
    let plan = pipeline_linear_cleanup_plan(fmap_get_tt(fm), ty)
    if rewrapped == 0 and aliases == 0 and plan != 0 {
      pipeline_ir_abort_cleanup_emit_commit_flat_value(code, value, plan, fm, pinned)
    } else { 0 }
  }
}

pub(package) fn pipeline_ir_abort_cleanup_emit_rebind_structural_slot(code: i64, value: i64, slot: i64, plan: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let plan_kind = typeck_linear_layout_plan_kind(plan)
  let owning_kind = pipeline_ir_abort_cleanup_plan_owning_kind(plan)
  let action = pipeline_ir_abort_cleanup_plan_action(plan)
  let facts = fmap_current_abort_cleanup_facts(fm)
  let source_fact = pipeline_ir_abort_cleanup_find_acquisition_value_action_kind(
    facts, value, action, owning_kind
  )
  -- A call result, parameter, or prior slot load already owns one linear
  -- record. Flattened tuple/anonymous-record literals instead own independent
  -- child records. Consume exactly the representation the producer supplied.
  if source_fact != 0 {
    pipeline_ir_abort_cleanup_emit_disarm_transferred_fact(code, source_fact, fm)
  } else { 0 }
  let representation_source = if source_fact == 0 and plan_kind == 1 {
    -- Mutable initialization stores a zero-cost opaque wrapper in its slot
    -- before this marker. When inlining exposes the raw producer, `value`
    -- still names that producer's acquisition site even though its i64
    -- representation has no linear type plan. Consume the exact fact before
    -- the slot becomes the canonical owned identity.
    pipeline_ir_abort_cleanup_emit_source_site_acquisitions_from(
      code, facts, value, 0, fm
    )
  } else { 0 }
  let flow_aliases = pipeline_ir_abort_cleanup_emit_rebind_flow_aliases_from(code, facts, value, action, 0, fm)
  if source_fact == 0 and representation_source == 0 and flow_aliases == 0 {
    if plan_kind != 1 {
    -- Optimisation may independently alias flattened lanes, so `value + n`
    -- is not a reliable identity after the store sequence. The slot lanes are
    -- stable homes containing the exact new runtime words. At this point the
    -- old slot record is already disarmed and no effect can interleave, making
    -- one dynamic child-record splice per owned lane both exact in count and
    -- safe even when distinct resources have identical representations.
    pipeline_ir_abort_cleanup_emit_commit_flat_value(code, slot, plan, fm, pinned)
    } else {
      -- Zero-cost opaque construction and inlined owned identities can reach
      -- the slot without an earlier acquisition record. The typed rebind is
      -- then the acquisition point itself. A real producer record, including
      -- any CFG alternative, is always consumed by the branches above; no
      -- runtime value-equality fallback is permitted.
      0
    }
  } else { 0 }
  -- The stores precede this fact in IR. Reusing one canonical slot record
  -- gives replacement, normal Drop, call transfer, and abort the same exact
  -- ownership identity even when two resources have identical runtime bits.
  pipeline_ir_abort_cleanup_emit_register_site(
    code, pipeline_ir_abort_cleanup_structural_slot_site(slot), fm, pinned
  )
}

pub(package) fn pipeline_ir_abort_cleanup_emit_commit_variant_plan(code: i64, payloads: IrValueList, base_index: i64, plan: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let kind = typeck_linear_layout_plan_kind(plan)
  if kind == 6 and pipeline_structural_drop_plan_storage_mode(plan) == 2 {
    pipeline_ir_abort_cleanup_emit_commit_variant_plan(code, payloads, base_index, typeck_linear_layout_plan_children(plan), fm, pinned)
  } else { if kind == 2 or kind == 3 {
    let children = typeck_linear_layout_plan_children(plan)
    let mut i = 0
    while i < nlist_len(children) {
      let component = nlist_get(children, i)
      pipeline_ir_abort_cleanup_emit_commit_variant_plan(
        code, payloads, base_index + typeck_linear_layout_component_offset(component),
        typeck_linear_layout_component_plan(component), fm, pinned
      )
      i = i + 1
    }
    0
  } else {
    pipeline_ir_abort_cleanup_emit_commit_structural_leaf(
      code, pipeline_ir_value_list_get_or(payloads, base_index, 0 - 1), plan, fm, pinned
    )
  } }
}

pub(package) fn pipeline_ir_abort_cleanup_variant_alternative_for_tag(alternatives: i64, tag_hash: i64) -> i64 {
  let mut found = 0
  let n = if alternatives == 0 { 0 } else { nlist_len(alternatives) }
  let mut i = 0
  while i < n and found == 0 {
    let alternative = nlist_get(alternatives, i)
    if typeck_linear_layout_variant_hash(alternative) == tag_hash { found = alternative }
    else { i = i + 1 }
  }
  found
}

pub(package) fn pipeline_ir_abort_cleanup_variant_plan_in_components(components: i64, tag_hash: i64, index: i64) -> i64 {
  if components == 0 or index >= nlist_len(components) { 0 }
  else {
    let component = nlist_get(components, index)
    -- A flattened enclosing aggregate and its first field share one SSA base.
    -- Later fields have their own `base + offset` sites and cannot describe
    -- the constructor currently being committed.
    let found = if typeck_linear_layout_component_offset(component) == 0 {
      pipeline_ir_abort_cleanup_variant_plan_for_tag(
        typeck_linear_layout_component_plan(component), tag_hash
      )
    } else { 0 }
    if found != 0 { found }
    else { pipeline_ir_abort_cleanup_variant_plan_in_components(components, tag_hash, index + 1) }
  }
}

pub(package) fn pipeline_ir_abort_cleanup_variant_plan_for_tag(plan: i64, tag_hash: i64) -> i64 {
  if plan == 0 { 0 }
  else {
    let kind = typeck_linear_layout_plan_kind(plan)
    if kind == 5 {
      if pipeline_ir_abort_cleanup_variant_alternative_for_tag(
        typeck_linear_layout_plan_children(plan), tag_hash
      ) != 0 { plan } else { 0 }
    } else { if kind == 6 {
      -- Kind 6 is a zero-cost opaque wrapper around its representation.
      pipeline_ir_abort_cleanup_variant_plan_for_tag(
        typeck_linear_layout_plan_children(plan), tag_hash
      )
    } else { if kind == 2 or kind == 3 {
      pipeline_ir_abort_cleanup_variant_plan_in_components(
        typeck_linear_layout_plan_children(plan), tag_hash, 0
      )
    } else { 0 } } }
  }
}

pub(package) fn pipeline_ir_abort_cleanup_emit_commit_variant_structural(code: i64, dst: i64, tag_hash: i64, payloads: IrValueList, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let root_plan = pipeline_ir_abort_cleanup_structural_plan_for_site(fm, dst)
  let plan = pipeline_ir_abort_cleanup_variant_plan_for_tag(
    root_plan, tag_hash
  )
  -- A direct variant obligation must recognize every constructor. A plan for
  -- an enclosing flat aggregate can legitimately have no matching component:
  -- the constructor may be a copyable first lane sharing that aggregate's SSA
  -- base, and therefore has no ownership to commit.
  if plan == 0 and typeck_linear_layout_plan_kind(pipeline_try_variant_plan(root_plan)) == 5 {
    pipeline_ir_abort_cleanup_emit_structural_commit_failure(code, fm)
  } else { if plan == 0 { 0 }
  else { if pipeline_structural_drop_plan_is_valid(plan) == 0 or typeck_linear_layout_plan_kind(plan) != 5 {
    pipeline_ir_abort_cleanup_emit_structural_commit_failure(code, fm)
  } else {
    let alternative = pipeline_ir_abort_cleanup_variant_alternative_for_tag(typeck_linear_layout_plan_children(plan), tag_hash)
    if alternative == 0 {
      pipeline_ir_abort_cleanup_emit_structural_commit_failure(code, fm)
    } else {
      let components = typeck_linear_layout_variant_payloads(alternative)
      let mut i = 0
      while components != 0 and i < nlist_len(components) {
        let component = nlist_get(components, i)
        -- Plan offsets include the tag word; IrValueList begins at payload 0.
        pipeline_ir_abort_cleanup_emit_commit_variant_plan(
          code, payloads, typeck_linear_layout_component_offset(component) - 1,
          typeck_linear_layout_component_plan(component), fm, pinned
        )
        i = i + 1
      }
      0
    }
  } } }
}

pub(package) fn pipeline_ir_abort_cleanup_record_plan_in_components(components: i64, index: i64) -> i64 {
  if components == 0 or index >= nlist_len(components) { 0 }
  else {
    let component = nlist_get(components, index)
    let found = if typeck_linear_layout_component_offset(component) == 0 {
      pipeline_ir_abort_cleanup_record_plan(typeck_linear_layout_component_plan(component))
    } else { 0 }
    if found != 0 { found }
    else { pipeline_ir_abort_cleanup_record_plan_in_components(components, index + 1) }
  }
}

pub(package) fn pipeline_ir_abort_cleanup_record_plan(plan: i64) -> i64 {
  if plan == 0 { 0 }
  else {
    let kind = typeck_linear_layout_plan_kind(plan)
    if kind == 4 { plan }
    else { if kind == 6 {
      pipeline_ir_abort_cleanup_record_plan(typeck_linear_layout_plan_children(plan))
    } else { if kind == 2 or kind == 3 {
      pipeline_ir_abort_cleanup_record_plan_in_components(
        typeck_linear_layout_plan_children(plan), 0
      )
    } else { 0 } } }
  }
}

pub(package) fn pipeline_ir_abort_cleanup_emit_commit_record_plan(code: i64, fields: IrRecordFieldList, base_word: i64, plan: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let kind = typeck_linear_layout_plan_kind(plan)
  if kind == 6 and pipeline_structural_drop_plan_storage_mode(plan) == 2 {
    pipeline_ir_abort_cleanup_emit_commit_record_plan(code, fields, base_word, typeck_linear_layout_plan_children(plan), fm, pinned)
  } else { if kind == 2 or kind == 3 {
    let children = typeck_linear_layout_plan_children(plan)
    let mut i = 0
    while i < nlist_len(children) {
      let component = nlist_get(children, i)
      pipeline_ir_abort_cleanup_emit_commit_record_plan(
        code, fields, base_word + typeck_linear_layout_component_offset(component),
        typeck_linear_layout_component_plan(component), fm, pinned
      )
      i = i + 1
    }
    0
  } else {
    pipeline_ir_abort_cleanup_emit_commit_structural_leaf(
      code, pipeline_ir_record_field_value_at_word_offset(fields, base_word), plan, fm, pinned
    )
  } }
}

pub(package) fn pipeline_ir_abort_cleanup_emit_commit_record_structural(code: i64, dst: i64, fields: IrRecordFieldList, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let plan = pipeline_ir_abort_cleanup_record_plan(
    pipeline_ir_abort_cleanup_structural_plan_for_site(fm, dst)
  )
  if plan == 0 { 0 }
  else { if pipeline_structural_drop_plan_is_valid(plan) == 0 or typeck_linear_layout_plan_kind(plan) != 4 {
    pipeline_ir_abort_cleanup_emit_structural_commit_failure(code, fm)
  } else {
    let children = typeck_linear_layout_plan_children(plan)
    let mut i = 0
    while i < nlist_len(children) {
      let component = nlist_get(children, i)
      pipeline_ir_abort_cleanup_emit_commit_record_plan(
        code, fields, typeck_linear_layout_component_offset(component),
        typeck_linear_layout_component_plan(component), fm, pinned
      )
      i = i + 1
    }
    0
  } }
}

pub(package) fn pipeline_ir_record_layout_word_value_at_byte_offset(fields: IrRecordLayoutFieldList, byte_offset: i64) -> i64 {
  match fields {
    IrRecordLayoutFieldNil -> 0 - 1
    IrRecordLayoutFieldWord(field_hash, fact_byte_offset, value, managed_kind, rest) -> {
      if fact_byte_offset == byte_offset { value }
      else { pipeline_ir_record_layout_word_value_at_byte_offset(rest, byte_offset) }
    }
    IrRecordLayoutFieldArray(field_hash, fact_byte_offset, storage, byte_size, leaf_count, leaf_stride, leaf_kind, rest) -> {
      pipeline_ir_record_layout_word_value_at_byte_offset(rest, byte_offset)
    }
  }
}

pub(package) fn pipeline_ir_abort_cleanup_emit_commit_record_layout_plan(code: i64, fields: IrRecordLayoutFieldList, base_word: i64, plan: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let kind = typeck_linear_layout_plan_kind(plan)
  if kind == 6 and pipeline_structural_drop_plan_storage_mode(plan) == 2 {
    pipeline_ir_abort_cleanup_emit_commit_record_layout_plan(code, fields, base_word, typeck_linear_layout_plan_children(plan), fm, pinned)
  } else { if kind == 2 or kind == 3 {
    let children = typeck_linear_layout_plan_children(plan)
    let mut i = 0
    while i < nlist_len(children) {
      let component = nlist_get(children, i)
      pipeline_ir_abort_cleanup_emit_commit_record_layout_plan(
        code, fields, base_word + typeck_linear_layout_component_offset(component),
        typeck_linear_layout_component_plan(component), fm, pinned
      )
      i = i + 1
    }
    0
  } else {
    pipeline_ir_abort_cleanup_emit_commit_structural_leaf(
      code, pipeline_ir_record_layout_word_value_at_byte_offset(fields, base_word * 8), plan, fm, pinned
    )
  } }
}

pub(package) fn pipeline_ir_abort_cleanup_emit_commit_record_layout_structural(code: i64, dst: i64, fields: IrRecordLayoutFieldList, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let plan = pipeline_ir_abort_cleanup_record_plan(
    pipeline_ir_abort_cleanup_structural_plan_for_site(fm, dst)
  )
  if plan == 0 { 0 }
  else { if pipeline_structural_drop_plan_is_valid(plan) == 0 or typeck_linear_layout_plan_kind(plan) != 4 {
    pipeline_ir_abort_cleanup_emit_structural_commit_failure(code, fm)
  } else {
    let children = typeck_linear_layout_plan_children(plan)
    let mut i = 0
    while i < nlist_len(children) {
      let component = nlist_get(children, i)
      pipeline_ir_abort_cleanup_emit_commit_record_layout_plan(
        code, fields, typeck_linear_layout_component_offset(component),
        typeck_linear_layout_component_plan(component), fm, pinned
      )
      i = i + 1
    }
    0
  } }
}

-- A by-value call transfers every linear argument at the ABI entry. Argument
-- evaluation is already complete, and the callee's typed entry binds run
-- before any language-level operation can abort. Splice the caller's exact
-- record immediately before the native call; the bind then arms its replacement.
-- Parameter types are the typed semantic contract; generic calls supply the
-- same monomorphisation substitution used for their ABI.
pub(package) fn pipeline_ir_abort_cleanup_emit_commit_call_params(code: i64, params: i64, index: i64, arg_word: i64, args: IrValueList, subst: i64, tt: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  if params == 0 or index >= nlist_len(params) { 0 }
  else {
    let raw_ty = node_f3(nlist_get(params, index))
    let param_ty = if subst == 0 { raw_ty } else { ty_subst(raw_ty, subst) }
    let lanes = pipeline_type_value_lane_count_or_one(param_ty)
    let plan = pipeline_linear_cleanup_plan(tt, param_ty)
    if plan != 0 {
      let value = pipeline_ir_value_list_get_or(args, arg_word, 0 - 1)
      if pipeline_linear_cleanup_plan_uses_structural_glue(plan) == 0 {
        pipeline_ir_abort_cleanup_emit_disarm_linear_fact(
          code, value, cg_owned_drop_type_hash(typeck_linear_layout_plan_type(plan)), pipeline_ir_abort_cleanup_owned_kind(), fm
        )
      } else {
        pipeline_ir_abort_cleanup_emit_disarm_linear_fact(
          code, value, pipeline_structural_drop_glue_hash(plan), pipeline_ir_abort_cleanup_structural_kind(), fm
        )
      }
    } else { 0 }
    pipeline_ir_abort_cleanup_emit_commit_call_params(code, params, index + 1, arg_word + lanes, args, subst, tt, fm, pinned)
  }
}

pub(package) fn pipeline_ir_abort_cleanup_emit_commit_callable_pair(code: i64, pair: i64, type_args: i64, args: IrValueList, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  if pair == 0 { 0 }
  else {
    let fn_wrap = node_f1(pair)
    let params = node_f3(pipeline_fn_inner(fn_wrap))
    let tparams = fn_tparams(fn_wrap)
    let subst = if tparams != 0 and type_args != 0 { cg_build_subst(tparams, type_args) } else { 0 }
    -- A method's implicit `self` is represented as its bare target type in
    -- the declaration, while linearity lives on the call-site owner. Recover
    -- that exact target from the indexed impl pair; a borrowed self remains
    -- non-consuming, and a by-value self transfers the caller's obligation.
    if node_f3(pair) != 0 and params != 0 and nlist_len(params) > 0 {
      let raw_self_ty = node_f3(nlist_get(params, 0))
      let self_ty = if subst == 0 { raw_self_ty } else { ty_subst(raw_self_ty, subst) }
      if ty_is_borrow(self_ty) { 0 }
      else {
        let raw_target = node_f4(pair)
        let target = if subst == 0 { raw_target } else { ty_subst(raw_target, subst) }
        let plan = pipeline_linear_cleanup_plan(fmap_get_tt(fm), ty_owned(target))
        if plan == 0 { 0 }
        else { if pipeline_linear_cleanup_plan_uses_structural_glue(plan) == 0 {
          pipeline_ir_abort_cleanup_emit_disarm_linear_fact(
            code,
            pipeline_ir_value_list_get_or(args, 0, 0 - 1),
            cg_owned_drop_type_hash(typeck_linear_layout_plan_type(plan)),
            pipeline_ir_abort_cleanup_owned_kind(),
            fm
          )
        } else {
          pipeline_ir_abort_cleanup_emit_disarm_linear_fact(
            code,
            pipeline_ir_value_list_get_or(args, 0, 0 - 1),
            pipeline_structural_drop_glue_hash(plan),
            pipeline_ir_abort_cleanup_structural_kind(),
            fm
          )
        } }
      }
    } else { 0 }
    pipeline_ir_abort_cleanup_emit_commit_call_params(code, params, 0, 0, args, subst, fmap_get_tt(fm), fm, pinned)
  }
}

pub(package) fn pipeline_ir_abort_cleanup_emit_commit_call(code: i64, callee_hash: i64, type_args: i64, args: IrValueList, fns: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  pipeline_ir_abort_cleanup_emit_commit_callable_pair(
    code, pipeline_fns_lookup_callable_pair_by_hash(fns, callee_hash), type_args, args, fm, pinned
  )
}

pub(package) fn pipeline_ir_abort_cleanup_emit_commit_method_call(code: i64, type_hash: i64, method_hash: i64, receiver: i64, args: IrValueList, fns: i64, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  pipeline_ir_abort_cleanup_emit_commit_callable_pair(
    code,
    pipeline_fns_lookup_method_pair(fns, type_hash, method_hash),
    0,
    ir_value_list_prepend(receiver, args),
    fm,
    pinned
  )
}

pub(package) fn pipeline_ir_abort_cleanup_emit_commit_pending_direct_call(code: i64, call_dst: i64, fm: i64) -> i64 {
  pipeline_ir_abort_cleanup_emit_commit_pending_transfers(
    code, pipeline_ir_abort_cleanup_origin_direct_transfer_pending(call_dst), fm
  )
}

pub(package) fn pipeline_ir_native_move_args(code: i64, args: IrValueList, index: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  match args {
    IrValueNil -> 0
    IrValueCons(value, rest) -> {
      let phys = pipeline_ir_native_load_reg(code, pinned, value)
      bu32(code, encode_add_imm(index + 1, phys, 0))
      pipeline_ir_native_move_args(code, rest, index + 1, pinned)
    }
  }
}

pub(package) fn pipeline_ir_native_move_call_args(code: i64, args: IrValueList, index: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  match args {
    IrValueNil -> 0
    IrValueCons(value, rest) -> {
      let phys = pipeline_ir_native_load_reg(code, pinned, value)
      bu32(code, encode_add_imm(index, phys, 0))
      pipeline_ir_native_move_call_args(code, rest, index + 1, pinned)
    }
  }
}

pub(package) fn pipeline_handler_clause_lowering_params(params: ParamList, expected_params: i64, index: i64, value_base: i64, locals: PipelineValueEnv) -> PipelineValueEnv {
  match params {
    ParamListNil -> locals
    ParamListCons(param, rest) -> {
      match param {
        Param(ns, nl, ty, label) -> {
          -- Clause bindings are syntactically aliases, so their parser
          -- nodes carry no useful annotation. The effect declaration is
          -- the semantic producer for their lowering type.
          let declared_type_node = type_expr_to_node(ty)
          let expected_type_node = if expected_params != 0 and index < nlist_len(expected_params) {
            node_f3(nlist_get(expected_params, index))
          } else { 0 }
          let type_node = if expected_type_node != 0 { expected_type_node } else { declared_type_node }
          let type_hash = if type_node == 0 { 0 } else { type_hash_of(type_node) }
          let float_prim = pipeline_type_node_prim_id_or(type_node, 0)
          let lanes = pipeline_type_value_lane_count_or_one(type_node)
          pipeline_handler_clause_lowering_params(rest, expected_params, index + 1, value_base + lanes, pipeline_value_env_push_float_typed_node(locals, ns, nl, value_base, float_prim, type_hash, type_node))
        }
        UnknownParam(tag) -> pipeline_handler_clause_lowering_params(rest, expected_params, index + 1, value_base + 1, locals)
      }
    }
  }
}

pub(package) fn pipeline_lambda_hoist_params(params: ParamList, index: i64, value_base: i64, locals: PipelineValueEnv) -> PipelineValueEnv {
  match params {
    ParamListNil -> locals
    ParamListCons(param, rest) -> {
      match param {
        Param(ns, nl, ty, label) -> {
          let type_node = pipeline_param_type_node_default_i64(param)
          let type_hash = if type_node == 0 { 0 } else { type_hash_of(type_node) }
          let float_prim = type_expr_prim_id_or(ty, 0)
          let next_value_base = value_base + pipeline_type_value_lane_count_or_one(type_node)
          pipeline_lambda_hoist_params(rest, index + 1, next_value_base, pipeline_value_env_push_float_typed_node(locals, ns, nl, value_base, float_prim, type_hash, type_node))
        }
        UnknownParam(tag) -> pipeline_lambda_hoist_params(rest, index + 1, value_base + 1, locals)
      }
    }
  }
}

pub(package) fn pipeline_ir_native_emit_hclause_loads(code: i64, nparams: i64, free_vars: i64, nfree: i64) -> i64 {
  let mut bi = 0
  while bi < nfree {
    let value_id = nparams + bi
    let dst = reg_phys(value_id)
    bu32(code, cg_ldr(dst, 0, bi * 8))
    if value_id >= 8 {
      emit_store_reg(code, value_id, dst)
    } else { 0 }
    bi = bi + 1
  }
  let mut pi = 0
  while pi < nparams {
    let value_id = nparams + nfree + pi
    emit_store_counter_from_phys(code, value_id, pi + 1)
    pi = pi + 1
  }
  0
}

pub(package) fn pipeline_ir_native_emit_completion_loads(code: i64, nparams: i64, nfree: i64) -> i64 {
  let mut bi = 0
  while bi < nfree {
    let value_id = nparams + bi
    let dst = reg_phys(value_id)
    bu32(code, cg_ldr(dst, 0, 8 + bi * 16))
    if value_id >= 8 { emit_store_reg(code, value_id, dst) } else { 0 }
    bi = bi + 1
  }
  let mut pi = 0
  while pi < nparams {
    let value_id = nparams + nfree + pi
    emit_store_counter_from_phys(code, value_id, pi + 1)
    pi = pi + 1
  }
  0
}

pub(package) fn pipeline_ir_native_emit_lambda_loads(code: i64, nparams: i64, nfree: i64) -> i64 {
  let mut bi = 0
  while bi < nfree {
    let value_id = bi
    let dst = reg_phys(value_id)
    bu32(code, cg_ldr(dst, 0, 8 + bi * 16))
    if value_id >= 8 {
      emit_store_reg(code, value_id, dst)
    } else { 0 }
    bi = bi + 1
  }
  let mut pi = 0
  while pi < nparams {
    emit_store_counter_from_phys(code, nfree + pi, pi + 1)
    pi = pi + 1
  }
  0
}

-- Tracked raw-counter read: emit_load_reg semantics (bank register or
-- canonical slot by counter id) with a ledger READ event, so handler
-- and lambda machinery consumption is verified against the store_reg
-- DEF events. Reads of cells the replay never saw defined stay BOTTOM
-- and are skipped, so instrumenting is always sound.
pub(package) fn pipeline_ir_native_load_reg_raw(code: i64, facts: PipelineIrNativeValueHomeFacts, counter: i64) -> i64 {
  if counter < 8 {
    pipeline_ir_native_ck_read(code, facts, counter + 19, counter)
  } else {
    pipeline_ir_native_ck_read(code, facts, pipeline_ir_native_identity_home(counter), counter)
  }
  emit_load_reg(code, counter)
}

-- Identity-home read for above-home-count counter values. ck: records
-- the READ so scratch-counter consumption is verified against the
-- store_reg defs (this was the unrecorded-read side of the handler
-- machinery; unrecorded reads are sound but unchecked).
pub(package) fn pipeline_ir_native_load_reg_temp(code: i64, facts: PipelineIrNativeValueHomeFacts, counter: i64, temp: i64) -> i64 {
  if counter < 8 {
    pipeline_ir_native_ck_read(code, facts, counter + 19, counter)
    counter + 19
  } else {
    pipeline_ir_native_ck_read(code, facts, 0 - (counter - 7), counter)
    let slot = (counter - 8) * 8
    emit_load_spill_offset(code, temp, slot)
    temp
  }
}

pub(package) fn pipeline_handler_clause_local_scope_params(params: ParamList, index: i64, lambda_scope: i64) -> i64 {
  match params {
    ParamListNil -> lambda_scope
    ParamListCons(param, rest) -> {
      match param {
        Param(ns, nl, ty, label) -> pipeline_handler_clause_local_scope_params(rest, index + 1, scope_push(lambda_scope, ns, nl, index + 1))
        UnknownParam(tag) -> pipeline_handler_clause_local_scope_params(rest, index + 1, lambda_scope)
      }
    }
  }
}

pub(package) fn pipeline_handler_clause_local_scope(params: ParamList, continuation: HandlerClauseContinuation) -> i64 {
  let param_scope = pipeline_handler_clause_local_scope_params(params, 0, scope_new())
  match continuation {
    HandlerClauseContinuation(ns, nl) -> scope_push(param_scope, ns, nl, cg_continuation_reg())
    _ -> param_scope
  }
}

pub(package) fn pipeline_ir_native_deferred_packet_max_args() -> i64 { 7 }
pub(package) fn pipeline_ir_native_deferred_packet_arg_offset() -> i64 { 32 }
pub(package) fn pipeline_ir_native_deferred_packet_size() -> i64 { pipeline_ir_native_deferred_packet_arg_offset() + 7 * 8 }
-- Four fixed temporaries plus the complete x0-x7 result bank.
pub(package) fn pipeline_ir_native_deferred_handle_scratch_count() -> i64 { 12 }

-- The final reserved prompt word carries an optional compiler-owned typed
-- normal-completion entry. It is not part of the runtime's public protocol.
pub(package) fn pipeline_ir_native_deferred_prompt_completion_offset() -> i64 { 232 }

pub(package) fn pipeline_ir_native_emit_deferred_packet_zero_args(code: i64, packet_phys: i64, index: i64) -> i64 {
  if index >= pipeline_ir_native_deferred_packet_max_args() { 0 }
  else {
    emit_mov_imm(code, 9, 0)
    bu32(code, cg_str(9, packet_phys, pipeline_ir_native_deferred_packet_arg_offset() + index * 8))
    pipeline_ir_native_emit_deferred_packet_zero_args(code, packet_phys, index + 1)
  }
}

pub(package) fn pipeline_ir_native_emit_deferred_packet_args(code: i64, packet_phys: i64, args: IrValueList, index: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  if index >= pipeline_ir_native_deferred_packet_max_args() { 0 }
  else {
    match args {
      IrValueNil -> pipeline_ir_native_emit_deferred_packet_zero_args(code, packet_phys, index)
      IrValueCons(value, rest) -> {
        let phys = pipeline_ir_native_load_reg(code, pinned, value)
        bu32(code, cg_str(phys, packet_phys, pipeline_ir_native_deferred_packet_arg_offset() + index * 8))
        pipeline_ir_native_emit_deferred_packet_args(code, packet_phys, rest, index + 1, pinned)
      }
    }
  }
}

pub(package) fn pipeline_ir_native_emit_deferred_capture_owner_load(code: i64, owner_reg: i64, prompt_reg: i64) -> i64 {
  emit_mov_imm(code, owner_reg, 0)
  bu32(code, cg_ldr(prompt_reg, 28, runtime_state_deferred_prompt_offset()))
  let no_prompt_pos = buf_len(code)
  bu32(code, 0)
  bu32(code, cg_ldr(owner_reg, prompt_reg, fiber_prompt_capture_owner_offset()))
  cg_patch_cbz(code, no_prompt_pos, prompt_reg, buf_len(code))
  owner_reg
}

pub(package) fn pipeline_ir_native_emit_deferred_capture_owner_cleanup_entry(code: i64, desc_reg: i64, segment_reg: i64, index: i64, owner_reg: i64) -> i64 {
  bu32(code, cg_str(owner_reg, segment_reg, index * 8))
  emit_mov_imm(code, 9, continuation_cleanup_kind_closure_drop_only())
  bu32(code, cg_str(9, desc_reg, continuation_cleanup_desc_header_size() + index * continuation_cleanup_entry_size() + continuation_cleanup_entry_kind_offset()))
  emit_mov_imm(code, 9, index * 8)
  bu32(code, cg_str(9, desc_reg, continuation_cleanup_desc_header_size() + index * continuation_cleanup_entry_size() + continuation_cleanup_entry_slot_offset()))
  emit_mov_imm(code, 9, 1)
  bu32(code, cg_str(9, desc_reg, continuation_cleanup_desc_header_size() + index * continuation_cleanup_entry_size() + continuation_cleanup_entry_live_offset()))
  0
}

pub(package) fn pipeline_ir_native_emit_deferred_prompt_cleanup_entry(code: i64, desc_reg: i64, segment_reg: i64, index: i64, prompt_reg: i64) -> i64 {
  bu32(code, cg_str(prompt_reg, segment_reg, index * 8))
  emit_mov_imm(code, 9, continuation_cleanup_kind_prompt_drop_only())
  bu32(code, cg_str(9, desc_reg, continuation_cleanup_desc_header_size() + index * continuation_cleanup_entry_size() + continuation_cleanup_entry_kind_offset()))
  emit_mov_imm(code, 9, index * 8)
  bu32(code, cg_str(9, desc_reg, continuation_cleanup_desc_header_size() + index * continuation_cleanup_entry_size() + continuation_cleanup_entry_slot_offset()))
  emit_mov_imm(code, 9, 1)
  bu32(code, cg_str(9, desc_reg, continuation_cleanup_desc_header_size() + index * continuation_cleanup_entry_size() + continuation_cleanup_entry_live_offset()))
  0
}

pub(package) fn pipeline_ir_native_emit_deferred_packet_cleanup(code: i64, packet_phys: i64, fm: i64) -> i64 {
  -- The prompt's detached dynamic-wind cleanup chain is the single typed source of cleanup
  -- truth for suspended fiber locals, including managed captures, owned
  -- resources, and structural values. Copying cg_cleanup_stack as well would
  -- duplicate its managed obligations. The enclosing capture owner remains a
  -- separate final entry because it lives outside the prompt stack.
  cg_bump_alloc_imm(code, fm, 10, continuation_cleanup_desc_size(2))
  emit_mov_imm(code, 9, 2)
  bu32(code, cg_str(9, 10, 0))
  cg_bump_alloc_imm(code, fm, 12, 16)
  bu32(code, cg_ldr(13, 28, runtime_state_deferred_prompt_offset()))
  pipeline_ir_native_emit_deferred_prompt_cleanup_entry(code, 10, 12, 0, 13)
  pipeline_ir_native_emit_deferred_capture_owner_load(code, 14, 13)
  pipeline_ir_native_emit_deferred_capture_owner_cleanup_entry(code, 10, 12, 1, 14)
  bu32(code, cg_str(10, packet_phys, 16))
  bu32(code, cg_str(12, packet_phys, 24))
}

pub(package) fn pipeline_ir_native_emit_deferred_suspend_direct(code: i64, dst: i64, entry_phys: i64, args: IrValueList, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let argc = ir_value_list_len(args)
  if argc > pipeline_ir_native_deferred_packet_max_args() {
    bu32(code, encode_brk(18))
  } else {
    -- Packet allocation is a real call barrier. The located handler entry
    -- may occupy any caller-saved register, so preserve it in the result
    -- SSA home before allocating just as the dynamic-entry path does.
    -- Otherwise a larger ownership/cleanup shape can color the entry into
    -- allocator scratch and leave the packet carrying a small clobber value
    -- instead of its ops entry.
    pipeline_ir_native_store_reg_pinned(code, pinned, dst, entry_phys)
    cg_bump_alloc_imm(code, fm, 15, pipeline_ir_native_deferred_packet_size())
    let saved_entry_phys = pipeline_ir_native_load_reg(code, pinned, dst)
    bu32(code, cg_str(saved_entry_phys, 15, 0))
    emit_mov_imm(code, 9, argc)
    bu32(code, cg_str(9, 15, 8))
    pipeline_ir_native_emit_deferred_packet_cleanup(code, 15, fm)
    pipeline_ir_native_emit_deferred_packet_args(code, 15, args, 0, pinned)
    bu32(code, encode_add_imm(0, 15, 0))
    cg_emit_call_lit(code, fm, "fiber_suspend")
    pipeline_ir_native_store_reg_pinned(code, pinned, dst, 0)
  }
}

pub(package) fn pipeline_ir_native_emit_deferred_suspend_dynamic(code: i64, dst: i64, entry_phys: i64, args: IrValueList, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let argc = ir_value_list_len(args)
  if argc > pipeline_ir_native_deferred_packet_max_args() {
    bu32(code, encode_brk(18))
  } else {
    pipeline_ir_native_store_reg_pinned(code, pinned, dst, entry_phys)
    cg_bump_alloc_imm(code, fm, 15, pipeline_ir_native_deferred_packet_size())
    let saved_entry_phys = pipeline_ir_native_load_reg(code, pinned, dst)
    bu32(code, cg_str(saved_entry_phys, 15, 0))
    emit_mov_imm(code, 9, argc)
    bu32(code, cg_str(9, 15, 8))
    pipeline_ir_native_emit_deferred_packet_cleanup(code, 15, fm)
    pipeline_ir_native_emit_deferred_packet_args(code, 15, args, 0, pinned)
    bu32(code, encode_add_imm(0, 15, 0))
    cg_emit_call_lit(code, fm, "fiber_suspend")
    pipeline_ir_native_store_reg_pinned(code, pinned, dst, 0)
  }
}

pub(package) fn pipeline_ir_native_emit_deferred_call_packet_regs(code: i64, packet_reg: i64, ops_reg: i64) -> i64 {
  bu32(code, cg_ldr(12, packet_reg, 0))
  bu32(code, cg_ldr(9, 12, handler_ops_fn_ptr_offset()))
  bu32(code, cg_ldr(0, 12, handler_ops_env_ptr_offset()))
  bu32(code, cg_ldr(1, packet_reg, 16))
  bu32(code, cg_str(1, 28, runtime_state_deferred_cleanup_desc_offset()))
  bu32(code, cg_ldr(1, packet_reg, 24))
  bu32(code, cg_str(1, 28, runtime_state_deferred_cleanup_segment_offset()))
  bu32(code, cg_ldr(1, packet_reg, 32))
  bu32(code, cg_ldr(2, packet_reg, 40))
  bu32(code, cg_ldr(3, packet_reg, 48))
  bu32(code, cg_ldr(4, packet_reg, 56))
  bu32(code, cg_ldr(5, packet_reg, 64))
  bu32(code, cg_ldr(6, packet_reg, 72))
  bu32(code, cg_ldr(7, packet_reg, 80))
  bu32(code, encode_blr(9))
  emit_mov_imm(code, 9, 0)
  bu32(code, cg_str(9, 28, runtime_state_deferred_cleanup_desc_offset()))
  bu32(code, cg_str(9, 28, runtime_state_deferred_cleanup_segment_offset()))
}

pub(package) fn pipeline_ir_native_deferred_resume_context_size() -> i64 { 56 }
pub(package) fn pipeline_ir_native_deferred_resume_context_cleanup_desc_offset() -> i64 { 40 }
pub(package) fn pipeline_ir_native_deferred_resume_context_cleanup_segment_offset() -> i64 { 48 }

pub(package) fn pipeline_ir_native_save_deferred_runtime_state_to_reg(code: i64, fm: i64, ctx_reg: i64) -> i64 {
  cg_bump_alloc_imm(code, fm, ctx_reg, pipeline_ir_native_deferred_resume_context_size())
  bu32(code, cg_ldr(9, 28, runtime_state_deferred_ops_offset()))
  bu32(code, cg_str(9, ctx_reg, deferred_runtime_context_ops_offset()))
  bu32(code, cg_ldr(9, 28, runtime_state_deferred_prompt_offset()))
  bu32(code, cg_str(9, ctx_reg, deferred_runtime_context_prompt_offset()))
  bu32(code, cg_ldr(9, 28, runtime_state_deferred_effect_hash_offset()))
  bu32(code, cg_str(9, ctx_reg, deferred_runtime_context_effect_hash_offset()))
  bu32(code, cg_ldr(9, 28, runtime_state_deferred_op_count_offset()))
  bu32(code, cg_str(9, ctx_reg, deferred_runtime_context_op_count_offset()))
  bu32(code, cg_ldr(9, 28, runtime_state_deferred_prev_offset()))
  bu32(code, cg_str(9, ctx_reg, deferred_runtime_context_prev_offset()))
  bu32(code, cg_ldr(9, 28, runtime_state_deferred_cleanup_desc_offset()))
  bu32(code, cg_str(9, ctx_reg, pipeline_ir_native_deferred_resume_context_cleanup_desc_offset()))
  bu32(code, cg_ldr(9, 28, runtime_state_deferred_cleanup_segment_offset()))
  bu32(code, cg_str(9, ctx_reg, pipeline_ir_native_deferred_resume_context_cleanup_segment_offset()))
}

pub(package) fn pipeline_ir_native_restore_deferred_runtime_state_from_reg(code: i64, ctx_reg: i64) -> i64 {
  bu32(code, cg_ldr(9, ctx_reg, deferred_runtime_context_ops_offset()))
  bu32(code, cg_str(9, 28, runtime_state_deferred_ops_offset()))
  bu32(code, cg_ldr(9, ctx_reg, deferred_runtime_context_prompt_offset()))
  bu32(code, cg_str(9, 28, runtime_state_deferred_prompt_offset()))
  bu32(code, cg_ldr(9, ctx_reg, deferred_runtime_context_effect_hash_offset()))
  bu32(code, cg_str(9, 28, runtime_state_deferred_effect_hash_offset()))
  bu32(code, cg_ldr(9, ctx_reg, deferred_runtime_context_op_count_offset()))
  bu32(code, cg_str(9, 28, runtime_state_deferred_op_count_offset()))
  bu32(code, cg_ldr(9, ctx_reg, deferred_runtime_context_prev_offset()))
  bu32(code, cg_str(9, 28, runtime_state_deferred_prev_offset()))
  bu32(code, cg_ldr(9, ctx_reg, pipeline_ir_native_deferred_resume_context_cleanup_desc_offset()))
  bu32(code, cg_str(9, 28, runtime_state_deferred_cleanup_desc_offset()))
  bu32(code, cg_ldr(9, ctx_reg, pipeline_ir_native_deferred_resume_context_cleanup_segment_offset()))
  bu32(code, cg_str(9, 28, runtime_state_deferred_cleanup_segment_offset()))
}

pub(package) fn pipeline_ir_native_install_captured_deferred_runtime_state(code: i64, prompt_reg: i64, ops_reg: i64, effect_hash_reg: i64, op_count_reg: i64, prev_reg: i64) -> i64 {
  bu32(code, cg_str(prompt_reg, 28, runtime_state_deferred_prompt_offset()))
  bu32(code, cg_str(ops_reg, 28, runtime_state_deferred_ops_offset()))
  bu32(code, cg_str(effect_hash_reg, 28, runtime_state_deferred_effect_hash_offset()))
  bu32(code, cg_str(op_count_reg, 28, runtime_state_deferred_op_count_offset()))
  bu32(code, cg_str(prev_reg, 28, runtime_state_deferred_prev_offset()))
  emit_mov_imm(code, 9, 0)
  bu32(code, cg_str(9, 28, runtime_state_deferred_cleanup_desc_offset()))
  bu32(code, cg_str(9, 28, runtime_state_deferred_cleanup_segment_offset()))
}

pub(package) fn pipeline_ir_native_store_phys_lanes(code: i64, base_reg: i64, offset: i64, value_base_reg: i64, lanes: i64) -> i64 {
  for lane in 0..lanes {
    bu32(code, cg_str(value_base_reg + lane, base_reg, offset + lane * 8))
  }
  0
}

pub(package) fn pipeline_ir_native_load_phys_lanes(code: i64, base_reg: i64, offset: i64, value_base_reg: i64, lanes: i64) -> i64 {
  for lane in 0..lanes {
    bu32(code, cg_ldr(value_base_reg + lane, base_reg, offset + lane * 8))
  }
  0
}

pub(package) fn pipeline_ir_native_load_resume_as_result_lanes(code: i64, env_reg: i64, resume_lanes: i64, result_lanes: i64) -> i64 {
  for lane in 0..result_lanes {
    if lane < resume_lanes {
      bu32(code, cg_ldr(lane, env_reg, 104 + lane * 8))
    } else {
      emit_mov_imm(code, lane, 0)
    }
  }
  0
}

pub(package) fn pipeline_ir_native_hclause_continuation_closure_entry(code: i64, fm: i64, resume_lanes: i64, result_lanes: i64) -> i64 {
  let skip_pos = buf_len(code)
  bu32(code, 0)
  let entry = buf_len(code)
  -- This synthesized entry writes x19-x26 directly, so it must keep the
  -- full value-bank save regardless of the enclosing function's mask.
  let old_gpr_pairs = fmap_current_gpr_pairs(fm)
  fmap_set_current_gpr_pairs(fm, 4)
  emit_prologue_current(code, fm)
  bu32(code, encode_add_imm(19, 0, 0))
  pipeline_ir_native_store_phys_lanes(code, 19, 104, 1, resume_lanes)
  bu32(code, cg_ldr(20, 19, 8))
  bu32(code, cg_ldr(21, 19, 24))
  bu32(code, cg_ldr(22, 19, 40))
  bu32(code, cg_ldr(23, 19, 56))
  bu32(code, cg_ldr(24, 19, 72))
  bu32(code, cg_ldr(25, 19, 88))
  bu32(code, encode_add_imm(0, 20, 0))
  cg_emit_call_lit(code, fm, "continuation_resume_managed")
  bu32(code, encode_cmp(21, 31))
  let has_prompt_pos = buf_len(code)
  bu32(code, 0)
  pipeline_ir_native_load_resume_as_result_lanes(code, 19, resume_lanes, result_lanes)
  let done_without_restore_pos = buf_len(code)
  bu32(code, 0)
  let has_prompt = buf_len(code)
  cg_patch_b_cond(code, has_prompt_pos, 1, has_prompt)
  pipeline_ir_native_save_deferred_runtime_state_to_reg(code, fm, 26)
  pipeline_ir_native_install_captured_deferred_runtime_state(code, 21, 22, 23, 24, 25)
  bu32(code, encode_add_imm(0, 21, 0))
  pipeline_ir_native_load_phys_lanes(code, 19, 104, 1, resume_lanes)
  cg_emit_call_lit(code, fm, "fiber_resume")
  -- Preserve the complete native result bank until the prompt tells us
  -- whether these are raw body-completion lanes or another suspension packet.
  pipeline_ir_native_store_phys_lanes(code, 19, 104, 0, 8)
  bu32(code, encode_add_imm(23, 0, 0))
  cg_emit_call_lit(code, fm, "fiber_is_done")
  bu32(code, encode_cmp(0, 31))
  let suspended_pos = buf_len(code)
  bu32(code, 0)
  bu32(code, cg_ldr(17, 21, pipeline_ir_native_deferred_prompt_completion_offset()))
  let no_completion_pos = buf_len(code)
  bu32(code, 0)
  -- The raw fiber is complete. Run its transform on this resumer stack with
  -- the completed prompt masked, so an effect in the transform reaches the
  -- enclosing dynamic handler rather than suspending the finished fiber.
  pipeline_ir_native_emit_deferred_pop_runtime_state(code)
  bu32(code, cg_ldr(16, 21, fiber_prompt_capture_owner_offset()))
  bu32(code, cg_ldr(0, 16, 8))
  pipeline_ir_native_load_phys_lanes(code, 19, 104, 1, 8)
  bu32(code, cg_ldr(17, 21, pipeline_ir_native_deferred_prompt_completion_offset()))
  bu32(code, encode_blr(17))
  pipeline_ir_native_store_phys_lanes(code, 19, 104, 0, result_lanes)
  pipeline_ir_native_emit_deferred_capture_owner_release_from_prompt(code, fm, 21)
  let done_from_fiber_pos = buf_len(code)
  bu32(code, 0)
  let no_completion = buf_len(code)
  cg_patch_cbz(code, no_completion_pos, 17, no_completion)
  let done_without_completion_pos = buf_len(code)
  bu32(code, 0)
  let suspended = buf_len(code)
  cg_patch_b_cond(code, suspended_pos, 0, suspended)
  pipeline_ir_native_emit_deferred_call_packet_regs(code, 23, 22)
  pipeline_ir_native_store_phys_lanes(code, 19, 104, 0, result_lanes)
  let restore = buf_len(code)
  cg_patch_b(code, done_from_fiber_pos, restore)
  cg_patch_b(code, done_without_completion_pos, restore)
  pipeline_ir_native_restore_deferred_runtime_state_from_reg(code, 26)
  pipeline_ir_native_load_phys_lanes(code, 19, 104, 0, result_lanes)
  let finish = buf_len(code)
  cg_patch_b(code, done_without_restore_pos, finish)
  emit_epilogue_current(code, fm)
  fmap_set_current_gpr_pairs(fm, old_gpr_pairs)
  cg_patch_b(code, skip_pos, buf_len(code))
  entry
}

pub(package) fn pipeline_ir_native_hclause_continuation_env_size(resume_lanes: i64, result_lanes: i64) -> i64 {
  -- The driver preserves the full x0-x7 raw fiber-result bank before it can
  -- distinguish normal completion from another suspension packet. A return
  -- transform may then narrow or widen that bank independently of the final
  -- handler result shape.
  104 + pipeline_ir_max_i64(8, pipeline_ir_max_i64(resume_lanes, result_lanes)) * 8
}

pub(package) fn pipeline_ir_native_emit_hclause_continuation_closure(code: i64, fm: i64, token_ctr: i64, closure_ctr: i64, env_ctr: i64, has_continuation: i64, resume_lanes: i64, result_lanes: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  if has_continuation == 1 {
      let entry = pipeline_ir_native_hclause_continuation_closure_entry(code, fm, resume_lanes, result_lanes)
      cg_emit_rc_default_alloc_nozero_lit(code, fm, continuation_cleanup_kind_closure(), 16, 8)
      pipeline_ir_native_store_reg(code, pinned, closure_ctr, 0)
      cg_emit_rc_default_alloc_nozero_raw(code, fm, pipeline_ir_native_hclause_continuation_env_size(resume_lanes, result_lanes), 8)
      pipeline_ir_native_store_reg(code, pinned, env_ctr, 0)
      let env_phys = pipeline_ir_native_load_reg_temp(code, pinned, env_ctr, 16)
      emit_mov_imm(code, 9, 6)
      bu32(code, cg_str(9, env_phys, 0))
      let token_phys = pipeline_ir_native_load_reg_temp(code, pinned, token_ctr, 17)
      bu32(code, cg_str(token_phys, env_phys, 8))
      emit_mov_imm(code, 9, continuation_cleanup_kind_continuation())
      bu32(code, cg_str(9, env_phys, 16))
      bu32(code, cg_ldr(9, 28, runtime_state_deferred_prompt_offset()))
      bu32(code, cg_str(9, env_phys, 24))
      emit_mov_imm(code, 9, continuation_cleanup_kind_none())
      bu32(code, cg_str(9, env_phys, 32))
      bu32(code, cg_ldr(9, 28, runtime_state_deferred_ops_offset()))
      bu32(code, cg_str(9, env_phys, 40))
      emit_mov_imm(code, 9, continuation_cleanup_kind_none())
      bu32(code, cg_str(9, env_phys, 48))
      bu32(code, cg_ldr(9, 28, runtime_state_deferred_effect_hash_offset()))
      bu32(code, cg_str(9, env_phys, 56))
      emit_mov_imm(code, 9, continuation_cleanup_kind_none())
      bu32(code, cg_str(9, env_phys, 64))
      bu32(code, cg_ldr(9, 28, runtime_state_deferred_op_count_offset()))
      bu32(code, cg_str(9, env_phys, 72))
      emit_mov_imm(code, 9, continuation_cleanup_kind_none())
      bu32(code, cg_str(9, env_phys, 80))
      bu32(code, cg_ldr(9, 28, runtime_state_deferred_prev_offset()))
      bu32(code, cg_str(9, env_phys, 88))
      emit_mov_imm(code, 9, continuation_cleanup_kind_none())
      bu32(code, cg_str(9, env_phys, 96))
      let closure_phys = pipeline_ir_native_load_reg_temp(code, pinned, closure_ctr, 16)
      let adr_pos = buf_len(code)
      bu32(code, encode_adr(17, entry - adr_pos))
      bu32(code, cg_str(17, closure_phys, 0))
      let env_phys2 = pipeline_ir_native_load_reg_temp(code, pinned, env_ctr, 17)
      bu32(code, cg_str(env_phys2, closure_phys, 8))
      env_ctr + 1
  } else { token_ctr }
}

pub(package) fn pipeline_handler_clause_locals_with_continuation(locals: PipelineValueEnv, continuation: HandlerClauseContinuation, continuation_value: i64, input_ty: i64, result_ty: i64) -> PipelineValueEnv {
  match continuation {
    HandlerClauseContinuation(ns, nl) -> {
      let input_types = nlist_new()
      nlist_add(input_types, input_ty)
      let fn_ty = ty_fn(input_types, result_ty, ty_effect_pure())
      pipeline_value_env_push_float_typed_node(locals, ns, nl, continuation_value, 0, type_hash_of(fn_ty), fn_ty)
    }
    _ -> locals
  }
}

pub(package) fn pipeline_ir_native_release_hclause_continuation_closure(code: i64, fm: i64, has_continuation: i64, closure_value: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  if has_continuation == 1 {
      let closure_phys = pipeline_ir_native_load_reg(code, pinned, closure_value)
      bu32(code, encode_add_imm(0, closure_phys, 0))
      cg_emit_call_lit(code, fm, "closure_default_release")
  } else { 0 }
}

pub(package) fn pipeline_typed_ffv_bind_pattern_list(patterns: PatternList, scope: i64, src: i64) -> i64 {
  match patterns {
    PatternListNil -> scope
    PatternListCons(pattern, rest) -> pipeline_typed_ffv_bind_pattern_list(rest, pipeline_typed_ffv_bind_pattern(pattern, scope, src), src)
  }
}

pub(package) fn pipeline_typed_ffv_bind_pattern_fields(fields: PatternFieldList, scope: i64, src: i64) -> i64 {
  match fields {
    PatternFieldListNil -> scope
    PatternFieldListCons(field, rest) -> {
      let next = match field {
        PatternField(ns, nl, pattern, fact) -> pipeline_typed_ffv_bind_pattern(pattern, scope, src)
        UnknownPatternField(tag) -> scope
      }
      pipeline_typed_ffv_bind_pattern_fields(rest, next, src)
    }
  }
}

pub(package) fn pipeline_typed_ffv_bind_pattern(pattern: Pattern, scope: i64, src: i64) -> i64 {
  match pattern {
    Binding(ns, nl) -> scope_push(scope, ns, nl, 0)
    CtorPattern(tag_ns, tag_nl, bindings, declaration) -> pipeline_typed_ffv_bind_pattern_list(bindings, scope, src)
    -- Typed binding introduces a name exactly like Binding — the free
    -- variable scan must see it or lambda capture analysis treats the
    -- name as captured from the enclosing scope.
    TypedBinding(ns, nl, ann) -> scope_push(scope, ns, nl, 0)
    RecordPattern(fields) -> pipeline_typed_ffv_bind_pattern_fields(fields, scope, src)
    TuplePattern(items) -> pipeline_typed_ffv_bind_pattern_list(items, scope, src)
    _ -> scope
  }
}

pub(package) fn pipeline_typed_ffv_bind_params(params: ParamList, scope: i64) -> i64 {
  match params {
    ParamListNil -> scope
    ParamListCons(param, rest) -> {
      match param {
        Param(ns, nl, ty, label) -> pipeline_typed_ffv_bind_params(rest, scope_push(scope, ns, nl, 0))
        UnknownParam(tag) -> pipeline_typed_ffv_bind_params(rest, scope)
      }
    }
  }
}

pub(package) fn pipeline_typed_find_free_vars_expr_list(exprs: ExprList, local_scope: i64, enclosing_scope: i64, src: i64, free_vars: i64) -> i64 {
  match exprs {
    ExprListNil -> 0
    ExprListCons(expr, rest) -> {
      pipeline_typed_find_free_vars_expr(expr, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_expr_list(rest, local_scope, enclosing_scope, src, free_vars)
    }
  }
}

pub(package) fn pipeline_typed_find_free_vars_record_fields(fields: RecordFieldList, local_scope: i64, enclosing_scope: i64, src: i64, free_vars: i64) -> i64 {
  match fields {
    RecordFieldListNil -> 0
    RecordFieldListCons(field, rest) -> {
      pipeline_typed_find_free_vars_expr(record_field_value_expr(field), local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_record_fields(rest, local_scope, enclosing_scope, src, free_vars)
    }
  }
}

pub(package) fn pipeline_typed_find_free_vars_match_arms(arms: MatchArmList, local_scope: i64, enclosing_scope: i64, src: i64, free_vars: i64) -> i64 {
  match arms {
    MatchArmListNil -> 0
    MatchArmListCons(arm, rest) -> {
      let arm_scope = pipeline_typed_ffv_bind_pattern(match_arm_pattern(arm), local_scope, src)
      if match_arm_has_guard(arm) == 1 {
        pipeline_typed_find_free_vars_expr(match_arm_guard_expr(arm), arm_scope, enclosing_scope, src, free_vars)
      } else { 0 }
      pipeline_typed_find_free_vars_expr(match_arm_body_expr(arm), arm_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_match_arms(rest, local_scope, enclosing_scope, src, free_vars)
    }
  }
}

pub(package) fn pipeline_typed_find_free_vars_handler_clauses(clauses: HandlerClauseList, local_scope: i64, enclosing_scope: i64, src: i64, free_vars: i64) -> i64 {
  match clauses {
    HandlerClauseListNil -> 0
    HandlerClauseListCons(clause, rest) -> {
      let clause_scope = pipeline_typed_ffv_bind_params(handler_clause_params(clause), local_scope)
      let clause_scope2 = match handler_clause_continuation(clause) {
        HandlerClauseContinuation(ns, nl) -> scope_push(clause_scope, ns, nl, 0)
        _ -> clause_scope
      }
      pipeline_typed_find_free_vars_expr(handler_clause_body_expr(clause), clause_scope2, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_handler_clauses(rest, local_scope, enclosing_scope, src, free_vars)
    }
  }
}

pub(package) fn pipeline_typed_find_free_vars_expr(expr: Expr, local_scope: i64, enclosing_scope: i64, src: i64, free_vars: i64) -> i64 {
  match expr {
    Ident(ns, nl) -> ffv_add_name(ns, nl, local_scope, enclosing_scope, src, free_vars)
    BinOp(op, lhs, rhs) -> {
      pipeline_typed_find_free_vars_expr(lhs, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_expr(rhs, local_scope, enclosing_scope, src, free_vars)
    }
    Call(ns, nl, args) -> {
      ffv_add_name(ns, nl, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_expr_list(args, local_scope, enclosing_scope, src, free_vars)
    }
    GenericCall(type_args, inner_call) -> pipeline_typed_find_free_vars_expr(inner_call, local_scope, enclosing_scope, src, free_vars)
    If(cond, then_expr, else_expr) -> {
      pipeline_typed_find_free_vars_expr(cond, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_expr(then_expr, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_expr(else_expr, local_scope, enclosing_scope, src, free_vars)
    }
    While(cond, body) -> {
      pipeline_typed_find_free_vars_expr(cond, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_expr(body, local_scope, enclosing_scope, src, free_vars)
    }
    Loop(body) -> pipeline_typed_find_free_vars_expr(body, local_scope, enclosing_scope, src, free_vars)
    Break(value) -> pipeline_typed_find_free_vars_expr(value, local_scope, enclosing_scope, src, free_vars)
    Return(value) -> pipeline_typed_find_free_vars_expr(value, local_scope, enclosing_scope, src, free_vars)
    Defer(cleanup, body, source_site) -> {
      pipeline_typed_find_free_vars_expr(cleanup, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_expr(body, local_scope, enclosing_scope, src, free_vars)
    }
    Let(ns, nl, value, body) -> {
      pipeline_typed_find_free_vars_expr(value, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_expr(body, scope_push(local_scope, ns, nl, 0), enclosing_scope, src, free_vars)
    }
    LetMut(ns, nl, value, body) -> {
      pipeline_typed_find_free_vars_expr(value, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_expr(body, scope_push(local_scope, ns, nl, 0), enclosing_scope, src, free_vars)
    }
    Assign(ns, nl, value) -> {
      ffv_add_name(ns, nl, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_expr(value, local_scope, enclosing_scope, src, free_vars)
    }
    AddressOf(mutable, target) -> pipeline_typed_find_free_vars_expr(target, local_scope, enclosing_scope, src, free_vars)
    Deref(ptr) -> pipeline_typed_find_free_vars_expr(ptr, local_scope, enclosing_scope, src, free_vars)
    PtrAssign(ptr, value) -> {
      pipeline_typed_find_free_vars_expr(ptr, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_expr(value, local_scope, enclosing_scope, src, free_vars)
    }
    Block(first, rest) -> {
      pipeline_typed_find_free_vars_expr(first, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_expr(rest, local_scope, enclosing_scope, src, free_vars)
    }
    FieldAccess(base, field_ns, field_nl, fact) -> pipeline_typed_find_free_vars_expr(base, local_scope, enclosing_scope, src, free_vars)
    IndexedLen(base, fixed_len) -> pipeline_typed_find_free_vars_expr(base, local_scope, enclosing_scope, src, free_vars)
    IndexedGet(base, index, element_ty, fixed_len) -> { pipeline_typed_find_free_vars_expr(base, local_scope, enclosing_scope, src, free_vars) pipeline_typed_find_free_vars_expr(index, local_scope, enclosing_scope, src, free_vars) }
    IndexedSet(base, index, value, fact) -> { pipeline_typed_find_free_vars_expr(base, local_scope, enclosing_scope, src, free_vars) pipeline_typed_find_free_vars_expr(index, local_scope, enclosing_scope, src, free_vars) pipeline_typed_find_free_vars_expr(value, local_scope, enclosing_scope, src, free_vars) }
    IndexedSlice(base, start, end, fact) -> { pipeline_typed_find_free_vars_expr(base, local_scope, enclosing_scope, src, free_vars) pipeline_typed_find_free_vars_expr(start, local_scope, enclosing_scope, src, free_vars) pipeline_typed_find_free_vars_expr(end, local_scope, enclosing_scope, src, free_vars) }
    RecordInit(type_ns, type_nl, fields) -> pipeline_typed_find_free_vars_record_fields(fields, local_scope, enclosing_scope, src, free_vars)
    RecordUpdate(base, fields, fact) -> {
      pipeline_typed_find_free_vars_expr(base, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_record_fields(fields, local_scope, enclosing_scope, src, free_vars)
    }
    ArrayLiteral(elements, resolved_ty, span) -> pipeline_typed_find_free_vars_expr_list(elements, local_scope, enclosing_scope, src, free_vars)
    Match(scrutinee, arms) -> {
      pipeline_typed_find_free_vars_expr(scrutinee, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_match_arms(arms, local_scope, enclosing_scope, src, free_vars)
    }
    Not(operand) -> pipeline_typed_find_free_vars_expr(operand, local_scope, enclosing_scope, src, free_vars)
    Lambda(params, body, source_site) -> pipeline_typed_find_free_vars_expr(body, pipeline_typed_ffv_bind_params(params, local_scope), enclosing_scope, src, free_vars)
    Perform(lhs, op_ns, op_nl, args) -> {
      pipeline_typed_find_free_vars_expr(lhs, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_expr_list(args, local_scope, enclosing_scope, src, free_vars)
    }
    Handle(body, clauses, hret) -> {
      pipeline_typed_find_free_vars_expr(body, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_handler_clauses(clauses, local_scope, enclosing_scope, src, free_vars)
      match hret {
        NoHandleReturn -> 0
        HandleReturnClause(rns, rnl, rb) -> pipeline_typed_find_free_vars_expr(rb, local_scope, enclosing_scope, src, free_vars)
      }
    }
    WithHandler(config, body, fact, source_site) -> {
      pipeline_typed_find_free_vars_expr_list(handler_configuration_args(config), local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_expr(body, local_scope, enclosing_scope, src, free_vars)
    }
    Resume(value) -> pipeline_typed_find_free_vars_expr(value, local_scope, enclosing_scope, src, free_vars)
    MethodCall(recv, method_hash, args, type_hash) -> {
      pipeline_typed_find_free_vars_expr(recv, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_expr_list(args, local_scope, enclosing_scope, src, free_vars)
    }
    Try(inner, effect_atom) -> pipeline_typed_find_free_vars_expr(inner, local_scope, enclosing_scope, src, free_vars)
    InterpConcat(left, right) -> {
      pipeline_typed_find_free_vars_expr(left, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_expr(right, local_scope, enclosing_scope, src, free_vars)
    }
    ForIter(var_ns, var_nl, collection, body) -> {
      pipeline_typed_find_free_vars_expr(collection, local_scope, enclosing_scope, src, free_vars)
      pipeline_typed_find_free_vars_expr(body, scope_push(local_scope, var_ns, var_nl, 0), enclosing_scope, src, free_vars)
    }
    OptChain(base, field_ns, field_nl, effect_atom) -> pipeline_typed_find_free_vars_expr(base, local_scope, enclosing_scope, src, free_vars)
    LetTyped(inner, ann_type) -> pipeline_typed_find_free_vars_expr(inner, local_scope, enclosing_scope, src, free_vars)
    _ -> 0
  }
}

pub(package) fn pipeline_ir_native_emit_hclause_body_trap(code: i64, fm: i64) -> i64 {
  let skip_pos = buf_len(code)
  bu32(code, 0)
  let clause_start = buf_len(code)
  emit_prologue_current(code, fm)
  bu32(code, encode_brk(18))
  emit_epilogue_current(code, fm)
  cg_patch_b(code, skip_pos, buf_len(code))
  pipeline_hclause_info_new(clause_start, nlist_new(), 0)
}

pub(package) fn pipeline_ir_handler_cleanup_frame_insts(insts: IrInstList) -> i64 {
  match insts {
    IrInstNil -> 0 - 1
    IrInstCons(inst, rest) -> {
      let frame = match inst {
        IrCallI64(dst, callee_hash, args) -> {
          if callee_hash == pipeline_ir_pseudo_handler_cleanup_reactivate_hash() {
            pipeline_ir_value_list_get_or(args, 0, 0 - 1)
          } else { 0 - 1 }
        }
        _ -> 0 - 1
      }
      if frame >= 0 { frame } else { pipeline_ir_handler_cleanup_frame_insts(rest) }
    }
  }
}

pub(package) fn pipeline_ir_handler_cleanup_frame_blocks(blocks: IrBlockList) -> i64 {
  match blocks {
    IrBlockListNil -> 0 - 1
    IrBlockListCons(block, rest) -> {
      let frame = match block {
        IrBlock(id, params, insts, term) -> pipeline_ir_handler_cleanup_frame_insts(insts)
      }
      if frame >= 0 { frame } else { pipeline_ir_handler_cleanup_frame_blocks(rest) }
    }
  }
}

pub(package) fn pipeline_ir_native_hclause_capture_cleanup_kind(fm: i64, capture: i64) -> i64 {
  cg_cleanup_kind_for_rid(fm, pipeline_ir_native_identity_home(node_f3(capture)))
}

pub(package) fn pipeline_ir_native_hclause_managed_capture_count(fm: i64, captures: i64) -> i64 {
  let mut count = 0
  let n = if captures == 0 { 0 } else { nlist_len(captures) }
  for i in 0..n {
    if pipeline_ir_native_hclause_capture_cleanup_kind(fm, nlist_get(captures, i)) != continuation_cleanup_kind_none() {
      count = count + 1
    } else { 0 }
  }
  count
}

pub(package) fn pipeline_ir_native_emit_hclause_continuation_segment_lowered(code: i64, fm: i64, nparams: i64, captures: i64, desc_ctr: i64, segment_ctr: i64) -> i64 {
  let count = pipeline_ir_native_hclause_managed_capture_count(fm, captures)
  emit_mov_imm_safe(code, 0, count)
  cg_emit_call_lit(code, fm, "continuation_cleanup_desc_new")
  cg_hclause_store_x0(code, desc_ctr)
  emit_mov_imm_safe(code, 0, count * 8)
  cg_emit_call_lit(code, fm, "alloc_zeroed")
  cg_hclause_store_x0(code, segment_ctr)
  let mut out = 0
  let nfree = if captures == 0 { 0 } else { nlist_len(captures) }
  for i in 0..nfree {
    let capture = nlist_get(captures, i)
    let kind = pipeline_ir_native_hclause_capture_cleanup_kind(fm, capture)
    if kind != continuation_cleanup_kind_none() {
      let value_rid = pipeline_ir_native_identity_home(nparams + pipeline_capture_value_lane_offset(captures, i))
      let segment_phys = emit_load_reg(code, segment_ctr)
      let value_phys = emit_load_home(code, value_rid, 17)
      let slot = out * 8
      bu32(code, cg_str(value_phys, segment_phys, slot))
      cg_emit_managed_retain_kind_regid(code, fm, kind, value_rid)
      let desc_phys = emit_load_reg(code, desc_ctr)
      bu32(code, encode_add_imm(0, desc_phys, 0))
      emit_mov_imm_safe(code, 1, out)
      emit_mov_imm_safe(code, 2, kind)
      emit_mov_imm_safe(code, 3, slot)
      emit_mov_imm_safe(code, 4, 1)
      cg_emit_call_lit(code, fm, "continuation_cleanup_desc_set")
      out = out + 1
    } else { 0 }
  }
  out
}

pub(package) fn pipeline_ir_native_emit_hclause_continuation_lowered(code: i64, fm: i64, nparams: i64, captures: i64, token_ctr: i64, segment_ctr: i64, has_continuation: i64) -> i64 {
  if has_continuation == 0 { token_ctr }
  else {
    bu32(code, cg_ldr(9, 28, runtime_state_deferred_cleanup_desc_offset()))
    bu32(code, encode_cmp(9, 31))
    let no_packet_cleanup_pos = buf_len(code)
    bu32(code, 0)
    bu32(code, encode_add_imm(0, 9, 0))
    cg_emit_call_lit(code, fm, "continuation_new_with_cleanup_desc")
    cg_hclause_store_x0(code, token_ctr)
    let packet_token_phys = emit_load_reg(code, token_ctr)
    bu32(code, encode_add_imm(0, packet_token_phys, 0))
    bu32(code, cg_ldr(9, 28, runtime_state_deferred_cleanup_segment_offset()))
    bu32(code, encode_add_imm(1, 9, 0))
    emit_mov_imm(code, 2, 0)
    emit_mov_imm(code, 3, 0)
    cg_emit_call_lit(code, fm, "continuation_set_segment")
    let done_packet_cleanup_pos = buf_len(code)
    bu32(code, 0)
    let no_packet_cleanup = buf_len(code)
    cg_patch_b_cond(code, no_packet_cleanup_pos, 0, no_packet_cleanup)
    let desc_count = pipeline_ir_native_hclause_managed_capture_count(fm, captures)
    if desc_count > 0 {
      pipeline_ir_native_emit_hclause_continuation_segment_lowered(code, fm, nparams, captures, token_ctr, segment_ctr)
      let desc_phys = emit_load_reg(code, token_ctr)
      bu32(code, encode_add_imm(0, desc_phys, 0))
      cg_emit_call_lit(code, fm, "continuation_new_with_cleanup_desc")
      cg_hclause_store_x0(code, token_ctr)
      let token_phys = emit_load_reg(code, token_ctr)
      bu32(code, encode_add_imm(0, token_phys, 0))
      let segment_phys = emit_load_reg(code, segment_ctr)
      bu32(code, encode_add_imm(1, segment_phys, 0))
      emit_mov_imm(code, 2, 0)
      emit_mov_imm(code, 3, 0)
      cg_emit_call_lit(code, fm, "continuation_set_segment")
    } else {
      cg_emit_call_lit(code, fm, "continuation_new_noop")
      cg_hclause_store_x0(code, token_ctr)
    }
    cg_patch_b(code, done_packet_cleanup_pos, buf_len(code))
    emit_mov_imm(code, 9, 0)
    bu32(code, cg_str(9, 28, runtime_state_deferred_cleanup_desc_offset()))
    bu32(code, cg_str(9, 28, runtime_state_deferred_cleanup_segment_offset()))
    token_ctr
  }
}

pub(package) fn pipeline_ir_native_emit_hclause_body_ir(body: IrHandlerClauseBody, code: i64, src: i64, fm: i64, active_handlers: PipelineNativeHandlerCtx, fns: i64, completion_env: i64) -> i64 {
  match body {
    IrHandlerClauseBodyInvalid(reason) -> pipeline_ir_native_emit_hclause_body_trap(code, fm)
    IrHandlerClauseBody(op_hash, nparams, captures, has_continuation, is_abortive, result_cleanup_kind, transferred_param_value_fact, resume_lanes, result_lanes, first_value, blocks) -> {
      let nfree = pipeline_capture_value_lane_count(captures)
      let skip_pos = buf_len(code)
      bu32(code, 0)
      let clause_start = buf_len(code)
      let old_frame = fmap_current_frame_size(fm)
      let old_preserve_fp = fmap_current_preserve_fp(fm)
      let old_gpr_pairs = fmap_current_gpr_pairs(fm)
      let old_abort_cleanup_facts = fmap_current_abort_cleanup_facts(fm)
      let old_abort_cleanup_base = fmap_current_abort_cleanup_base(fm)
      let old_abort_cleanup_boundary = fmap_current_abort_cleanup_boundary(fm)
      let old_abort_cleanup_block = fmap_current_abort_cleanup_block(fm)
      let old_abort_cleanup_instrumented = fmap_current_abort_cleanup_instrumented(fm)
      let old_array_storage_facts = fmap_current_array_storage_facts(fm)
      let old_cleanup_depth = nlist_len(cg_cleanup_stack(fm))
      -- A handler clause is an out-of-line synthetic function. SSA ids in
      -- its parameter/capture ABI start again at zero and must not alias
      -- cleanup entries owned by the function whose handle emitted it.
      cg_cleanup_restore(fm, 0)
      let f64_facts = pipeline_ir_native_f64_facts_assign_slot_homes(blocks, pipeline_ir_native_f64_facts_for_blocks(blocks))
      let vector_data_facts = pipeline_ir_native_vector_data_facts_assign_home(pipeline_ir_native_vector_data_facts_for_blocks(blocks))
      let f64_slot_count = pipeline_ir_native_f64_slot_home_count(f64_facts)
      let body_max_next = pipeline_ir_function_next_value(first_value, blocks)
      let return_save = if has_continuation == 1 { body_max_next + 8 } else { body_max_next }
      let abort_frame_value = return_save + result_lanes
      let block_frame = pipeline_ir_native_scalar_frame_size_for_blocks(first_value, blocks)
      let continuation_frame = if has_continuation == 1 { pipeline_ir_native_frame_size_for_next_value(return_save + result_lanes) } else { block_frame }
      let save_frame = if is_abortive == 1 { pipeline_ir_native_frame_size_for_next_value(abort_frame_value + 1) } else { continuation_frame }
      pipeline_ir_structural_drop_register_blocks(blocks, fm, fns)
      let abort_cleanup_facts = pipeline_ir_abort_cleanup_facts_for_blocks_with_alias_facts(blocks, fns, fmap_get_tt(fm), fmap_native_return_alias_facts(fm))
      let abort_cleanup_instrumented = pipeline_ir_abort_cleanup_blocks_need_instrumentation(blocks, abort_cleanup_facts)
      let array_storage_base = pipeline_ir_max_i64(block_frame, save_frame)
      let array_storage_facts = pipeline_ir_native_array_storage_facts_for_blocks(blocks, array_storage_base)
      let abort_cleanup_base = pipeline_ir_native_array_storage_frame_size(array_storage_base, array_storage_facts)
      fmap_set_current_array_storage_facts(fm, array_storage_facts)
      fmap_set_current_abort_cleanup_facts(fm, abort_cleanup_facts)
      fmap_set_current_abort_cleanup_base(fm, abort_cleanup_base)
      fmap_set_current_abort_cleanup_boundary(fm, abort_cleanup_base)
      fmap_set_current_abort_cleanup_instrumented(fm, abort_cleanup_instrumented)
      fmap_set_current_frame_size(fm, pipeline_ir_abort_cleanup_frame_size(abort_cleanup_base, abort_cleanup_facts, abort_cleanup_instrumented, fm))
      if f64_slot_count > 0 { fmap_set_current_preserve_fp(fm, 1) } else { 0 }
      fmap_set_current_gpr_pairs(fm, 4)
      emit_prologue_current(code, fm)
      let continuation_token_value = nparams + nfree + nparams
      let continuation_segment_value = continuation_token_value + 1
      let continuation_closure_value = continuation_token_value + 2
      let continuation_env_value = continuation_token_value + 3
      let safe_handlers = pipeline_ir_native_handler_ctx_out_of_line()
      let base_home_count = pipeline_ir_native_value_home_count_include_evidence(pipeline_ir_native_value_home_count_for_blocks(first_value, blocks), fm)
      let body_home_count = if is_abortive == 1 { pipeline_ir_native_value_home_count_include(base_home_count, abort_frame_value) } else { base_home_count }
      let contextual_home_count = pipeline_ir_native_value_home_count_include_handlers(body_home_count, safe_handlers)
      let pinned = pipeline_ir_native_identity_home_facts_with_handler_scratch(contextual_home_count, blocks, pipeline_ir_native_handler_ctx_len(safe_handlers))
      -- Capture before any clause-body work can perform another effect and
      -- overwrite the shared dispatcher slot.
      let cleanup_frame_value = pipeline_ir_handler_cleanup_frame_blocks(blocks)
      if is_abortive == 1 or cleanup_frame_value >= 0 {
        bu32(code, cg_ldr(9, 28, runtime_state_dispatch_frame_offset()))
        if is_abortive == 1 { pipeline_ir_native_store_reg(code, pinned, abort_frame_value, 9) } else { 0 }
        if cleanup_frame_value >= 0 { pipeline_ir_native_store_reg(code, pinned, cleanup_frame_value, 9) } else { 0 }
      } else { 0 }
      if completion_env == 1 {
        pipeline_ir_native_emit_completion_loads(code, nparams, nfree)
      } else {
        pipeline_ir_native_emit_hclause_loads(code, nparams, captures, nfree)
      }
      -- Boundary capture uses scratch registers, so it must follow incoming
      -- clause-parameter/capture materialisation under Weft's wide register
      -- ABI.
      pipeline_ir_abort_cleanup_emit_function_entry(code, fm)
      if has_continuation == 1 {
        pipeline_ir_native_emit_hclause_continuation_lowered(code, fm, nparams, captures, continuation_token_value, continuation_segment_value, has_continuation)
        pipeline_ir_native_emit_hclause_continuation_closure(code, fm, continuation_token_value, continuation_closure_value, continuation_env_value, has_continuation, resume_lanes, result_lanes, pinned)
      } else { 0 }
      let temp_base = body_max_next + 8
      let abort_adr_patches = nlist_new()
      let state = pipeline_ir_native_emit_blocks(blocks, blocks, code, scope_new(), src, fm, safe_handlers, fns, f64_facts, vector_data_facts, abort_adr_patches, pipeline_ir_native_cfg_state(pipeline_ir_native_label_map_empty(), 0, pinned, temp_base))
      let labels = pipeline_ir_native_label_map_add(pipeline_ir_native_cfg_state_labels(state), pipeline_ir_native_epilogue_label(), buf_len(code))
      pipeline_ir_native_patch_all(code, labels, pipeline_ir_native_cfg_state_patches(state))
      pipeline_ir_native_patch_abort_adrs(code, labels, abort_adr_patches)
      if is_abortive == 1 and result_cleanup_kind != continuation_cleanup_kind_none() {
        -- The abort walk consumes every tracked stake acquired after the
        -- handle boundary, including each result lane's original transport
        -- stake. Save the complete ABI result bank before the first retain
        -- call, create one untracked crossing stake for every managed lane,
        -- then restore every lane. These native epilogue calls sit outside
        -- the clause IR fact set, so the walk cannot consume them as well.
        for lane in 0..result_lanes {
          pipeline_ir_native_store_reg(code, pinned, return_save + lane, lane)
        }
        for lane in 0..result_lanes {
          let lane_kind = pipeline_value_lane_cleanup_mask_kind(result_cleanup_kind, lane)
          if lane_kind != continuation_cleanup_kind_none() {
            cg_emit_managed_retain_kind_regid(code, fm, lane_kind, pipeline_ir_native_identity_home(return_save + lane))
          } else { 0 }
        }
        for lane in 0..result_lanes {
          let retained_result = emit_load_reg(code, return_save + lane)
          bu32(code, encode_add_imm(lane, retained_result, 0))
        }
      } else { 0 }
      if has_continuation == 1 {
        for lane in 0..result_lanes {
          pipeline_ir_native_store_reg(code, pinned, return_save + lane, lane)
        }
        pipeline_ir_native_release_hclause_continuation_closure(code, fm, has_continuation, continuation_closure_value, pinned)
        for lane in 0..result_lanes {
          let saved_result = emit_load_reg(code, return_save + lane)
          bu32(code, encode_add_imm(lane, saved_result, 0))
        }
      } else { 0 }
      if is_abortive == 1 {
        let abort_frame_phys = pipeline_ir_native_load_reg(code, pinned, abort_frame_value)
        cg_habort_restore_and_ret(code, abort_frame_phys, 0, result_lanes, fm)
      } else {
        pipeline_ir_abort_cleanup_emit_function_exit(code, fm)
        emit_epilogue_current(code, fm)
      }
      fmap_set_current_frame_size(fm, old_frame)
      fmap_set_current_preserve_fp(fm, old_preserve_fp)
      fmap_set_current_gpr_pairs(fm, old_gpr_pairs)
      fmap_set_current_abort_cleanup_facts(fm, old_abort_cleanup_facts)
      fmap_set_current_abort_cleanup_base(fm, old_abort_cleanup_base)
      fmap_set_current_abort_cleanup_boundary(fm, old_abort_cleanup_boundary)
      fmap_set_current_abort_cleanup_block(fm, old_abort_cleanup_block)
      fmap_set_current_abort_cleanup_instrumented(fm, old_abort_cleanup_instrumented)
      fmap_set_current_array_storage_facts(fm, old_array_storage_facts)
      cg_cleanup_restore(fm, old_cleanup_depth)
      cg_patch_b(code, skip_pos, buf_len(code))
      pipeline_hclause_info_new(clause_start, captures, nfree)
    }
  }
}

pub(package) fn pipeline_type_record_field_name_matches(field: TypeRecordField, src: i64, field_ns: i64, field_nl: i64, entry_src: i64) -> i64 {
  match field {
    TypeRecordField(ns, nl, ty) -> {
      if nl == field_nl {
        src_eq_at(src, field_ns, entry_src + ns, 0, field_nl)
      } else {
        0
      }
    }
    MissingTypeRecordField -> 0
  }
}

pub(package) fn pipeline_type_record_field_index(fields: TypeRecordFieldList, src: i64, field_ns: i64, field_nl: i64, entry_src: i64, index: i64) -> i64 {
  match fields {
    TypeRecordFieldListNil -> 0 - 1
    TypeRecordFieldListCons(field, rest) -> {
      if pipeline_type_record_field_name_matches(field, src, field_ns, field_nl, entry_src) == 1 {
        index
      } else {
        pipeline_type_record_field_index(rest, src, field_ns, field_nl, entry_src, index + 1)
      }
    }
  }
}

pub(package) fn pipeline_type_find_any_field_index_entries(entries: TypeEntryList, src: i64, field_ns: i64, field_nl: i64) -> i64 {
  match entries {
    TypeEntryListNil -> 0
    TypeEntryListCons(entry, rest) -> {
      match entry {
        TypeRecordEntry(name, tparams, fields) -> {
          let entry_src = type_entry_source_or(entry, 0)
          let idx = pipeline_type_record_field_index(fields, src, field_ns, field_nl, entry_src, 0)
          if idx >= 0 { idx } else { pipeline_type_find_any_field_index_entries(rest, src, field_ns, field_nl) }
        }
        _ -> pipeline_type_find_any_field_index_entries(rest, src, field_ns, field_nl)
      }
    }
  }
}

pub(package) fn pipeline_type_find_any_field_index(tt: i64, src: i64, field_ns: i64, field_nl: i64) -> i64 {
  pipeline_type_find_any_field_index_entries(type_entries_from_table(tt), src, field_ns, field_nl)
}

pub(package) fn pipeline_ir_native_emit_hclause_body(body: IrHandlerClauseBody, code: i64, src: i64, fm: i64, active_handlers: PipelineNativeHandlerCtx, fns: i64) -> i64 {
  pipeline_ir_native_emit_hclause_body_ir(body, code, src, fm, active_handlers, fns, 0)
}

pub(package) fn pipeline_ir_native_hclause_env_from_captures(code: i64, fm: i64, ops_ctr: i64, ci: i64, captures: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let capture_lanes = pipeline_capture_value_lane_count(captures)
  let env_size = capture_lanes * 8
  emit_mov_imm(code, 0, env_size)
  cg_bump_alloc_reg(code, fm, 17, 0)
  let nfree = if captures == 0 { 0 } else { nlist_len(captures) }
  for ei in 0..nfree {
    let capture = nlist_get(captures, ei)
    let offset = pipeline_capture_value_lane_offset(captures, ei)
    let lanes = pipeline_capture_lane_count(capture)
    for lane in 0..lanes {
      let ep = pipeline_ir_native_load_value_temp_pinned(code, pinned, node_f3(capture) + lane, 9)
      bu32(code, cg_str(ep, 17, (offset + lane) * 8))
    }
  }
  let ops_phys = pipeline_ir_native_load_reg_raw(code, pinned, ops_ctr)
  bu32(code, cg_str(17, ops_phys, ci * handler_ops_entry_size() + handler_ops_env_ptr_offset()))
}

pub(package) fn pipeline_ir_native_hfill_ops(clauses: IrHandlerClauseBodyList, n: i64, infos: i64, code: i64, fm: i64, ops_ctr: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  for ci in 0..n {
    let clause = ir_handler_clause_body_list_nth(clauses, ci)
    let op_hash = match clause {
      IrHandlerClauseBody(body_op_hash, nparams, captures, has_continuation, is_abortive, result_cleanup_kind, transferred_param_value_fact, resume_lanes, result_lanes, first_value, blocks) -> body_op_hash
      IrHandlerClauseBodyInvalid(reason) -> 0
    }
    let info = pipeline_word_array_get(infos, ci)
    let cs = pipeline_hclause_info_clause_start(info)
    let fvs = pipeline_hclause_info_free_vars(info)
    let nfree = pipeline_hclause_info_nfree(info)
    let ops_phys = pipeline_ir_native_load_reg_raw(code, pinned, ops_ctr)
    emit_mov_imm_safe(code, 17, op_hash)
    bu32(code, cg_str(17, ops_phys, ci * handler_ops_entry_size() + handler_ops_op_hash_offset()))
    let adr_pos = buf_len(code)
    bu32(code, encode_adr(17, cs - adr_pos))
    let ops_p2 = pipeline_ir_native_load_reg_raw(code, pinned, ops_ctr)
    bu32(code, cg_str(17, ops_p2, ci * handler_ops_entry_size() + handler_ops_fn_ptr_offset()))
    if nfree > 0 {
      pipeline_ir_native_hclause_env_from_captures(code, fm, ops_ctr, ci, fvs, pinned)
    } else {
      emit_mov_imm(code, 17, 0)
      let ops_p3 = pipeline_ir_native_load_reg_raw(code, pinned, ops_ctr)
      bu32(code, cg_str(17, ops_p3, ci * handler_ops_entry_size() + handler_ops_env_ptr_offset()))
    }
  }
  0
}

pub(package) fn pipeline_ir_native_deferred_managed_capture_count(captures: i64) -> i64 {
  let n = if captures == 0 { 0 } else { nlist_len(captures) }
  let mut count = 0
  for i in 0..n {
    let capture = nlist_get(captures, i)
    if ty_value_has_release_lane(node_f4(capture)) == 1 { count = count + 1 } else { 0 }
  }
  count
}

pub(package) fn pipeline_ir_native_emit_deferred_capture_owner_release(code: i64, fm: i64) -> i64 {
  bu32(code, cg_ldr(16, 28, runtime_state_deferred_prompt_offset()))
  let no_prompt_pos = buf_len(code)
  bu32(code, 0)
  bu32(code, cg_ldr(0, 16, fiber_prompt_capture_owner_offset()))
  bu32(code, cg_str(31, 16, fiber_prompt_capture_owner_offset()))
  let no_owner_pos = buf_len(code)
  bu32(code, 0)
  cg_emit_call_lit(code, fm, "closure_default_release")
  let done = buf_len(code)
  cg_patch_cbz(code, no_prompt_pos, 16, done)
  cg_patch_cbz(code, no_owner_pos, 0, done)
  0
}

pub(package) fn pipeline_ir_native_emit_deferred_capture_owner_release_from_prompt(code: i64, fm: i64, prompt_reg: i64) -> i64 {
  let no_prompt_pos = buf_len(code)
  bu32(code, 0)
  bu32(code, cg_ldr(0, prompt_reg, fiber_prompt_capture_owner_offset()))
  bu32(code, cg_str(31, prompt_reg, fiber_prompt_capture_owner_offset()))
  let no_owner_pos = buf_len(code)
  bu32(code, 0)
  cg_emit_call_lit(code, fm, "closure_default_release")
  let done = buf_len(code)
  cg_patch_cbz(code, no_prompt_pos, prompt_reg, done)
  cg_patch_cbz(code, no_owner_pos, 0, done)
  0
}

pub(package) fn pipeline_ir_native_emit_deferred_capture_owner_new(code: i64, fm: i64, prompt_ctr: i64, env_ctr: i64, captures: i64, force_owner: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  if force_owner == 1 or pipeline_ir_native_deferred_managed_capture_count(captures) > 0 {
    cg_emit_rc_default_alloc_nozero_lit(code, fm, continuation_cleanup_kind_closure(), 16, 8)
    emit_mov_imm(code, 9, 0)
    bu32(code, cg_str(9, 0, 0))
    let env_phys = pipeline_ir_native_load_reg_temp(code, pinned, env_ctr, 17)
    bu32(code, cg_str(env_phys, 0, 8))
    let prompt_phys = pipeline_ir_native_load_reg_temp(code, pinned, prompt_ctr, 16)
    bu32(code, cg_str(0, prompt_phys, fiber_prompt_capture_owner_offset()))
  } else { 0 }
  0
}

pub(package) fn pipeline_ir_native_emit_deferred_capture_env_release_if_unowned(code: i64, fm: i64, captures: i64, nfree: i64) -> i64 {
  if nfree > 0 and pipeline_ir_native_deferred_managed_capture_count(captures) == 0 {
    cg_emit_call_lit(code, fm, "rc_default_release")
  } else { 0 }
  0
}

pub(package) fn pipeline_ir_native_emit_deferred_capture_owner_release_if_owned(code: i64, fm: i64, captures: i64) -> i64 {
  if pipeline_ir_native_deferred_managed_capture_count(captures) > 0 {
    pipeline_ir_native_emit_deferred_capture_owner_release(code, fm)
  } else {
    0
  }
  0
}

pub(package) fn pipeline_ir_deferred_completion_is_present(completion: IrDeferredCompletionBody) -> i64 {
  match completion {
    IrDeferredCompletionBodyNone -> 0
    IrDeferredCompletionBody(input_lanes, output_lanes, first_value, blocks) -> 1
    IrDeferredCompletionBodyInvalid(reason) -> 0
  }
}

pub(package) fn pipeline_ir_deferred_completion_result_lanes(completion: IrDeferredCompletionBody, body_lanes: i64) -> i64 {
  match completion {
    IrDeferredCompletionBodyNone -> body_lanes
    IrDeferredCompletionBody(input_lanes, output_lanes, first_value, blocks) -> output_lanes
    IrDeferredCompletionBodyInvalid(reason) -> body_lanes
  }
}

pub(package) fn pipeline_ir_native_emit_deferred_completion_function(completion: IrDeferredCompletionBody, captures: i64, code: i64, src: i64, fm: i64, active_handlers: PipelineNativeHandlerCtx, fns: i64) -> i64 {
  match completion {
    IrDeferredCompletionBodyNone -> pipeline_hclause_info_new(0, captures, pipeline_capture_value_lane_count(captures))
    IrDeferredCompletionBodyInvalid(reason) -> pipeline_ir_native_emit_hclause_body_trap(code, fm)
    IrDeferredCompletionBody(input_lanes, output_lanes, first_value, blocks) -> {
      let synthetic = IrHandlerClauseBody(
        0,
        input_lanes,
        captures,
        0,
        0,
        continuation_cleanup_kind_none(),
        0,
        0,
        output_lanes,
        first_value,
        blocks
      )
      pipeline_ir_native_emit_hclause_body_ir(synthetic, code, src, fm, active_handlers, fns, 1)
    }
  }
}

pub(package) fn pipeline_ir_native_emit_deferred_body_function(body: IrDeferredHandlerBody, eff_hash: i64, nclauses: i64, clause_infos: i64, code: i64, src: i64, fm: i64, active_handlers: PipelineNativeHandlerCtx, fns: i64) -> i64 {
  match body {
    IrDeferredHandlerBodyInvalid(reason) -> pipeline_ir_native_emit_hclause_body_trap(code, fm)
    IrDeferredHandlerBody(body_src, captures, ops_value, result_lanes, first_value, blocks, completion) -> {
      let nfree = pipeline_capture_value_lane_count(captures)
      let skip_pos = buf_len(code)
      bu32(code, 0)
      let body_start = buf_len(code)
      let old_frame = fmap_current_frame_size(fm)
      let old_preserve_fp = fmap_current_preserve_fp(fm)
      let old_gpr_pairs = fmap_current_gpr_pairs(fm)
      let old_abort_cleanup_facts = fmap_current_abort_cleanup_facts(fm)
      let old_abort_cleanup_base = fmap_current_abort_cleanup_base(fm)
      let old_abort_cleanup_boundary = fmap_current_abort_cleanup_boundary(fm)
      let old_abort_cleanup_block = fmap_current_abort_cleanup_block(fm)
      let old_abort_cleanup_instrumented = fmap_current_abort_cleanup_instrumented(fm)
      let old_array_storage_facts = fmap_current_array_storage_facts(fm)
      let old_cleanup_depth = nlist_len(cg_cleanup_stack(fm))
      -- The deferred body is a synthetic fiber function. Its capture
      -- environment borrows from the enclosing handle frame, so inheriting
      -- that frame's parameter cleanup entries makes dropping k release a
      -- borrowed capture before the outer epilogue releases its real stake.
      -- Callees running inside the fiber establish their own parameter
      -- cleanup scopes when emitted as ordinary functions.
      cg_cleanup_restore(fm, 0)
      let f64_facts = pipeline_ir_native_f64_facts_assign_slot_homes(blocks, pipeline_ir_native_f64_facts_for_blocks(blocks))
      let vector_data_facts = pipeline_ir_native_vector_data_facts_assign_home(pipeline_ir_native_vector_data_facts_for_blocks(blocks))
      let f64_slot_count = pipeline_ir_native_f64_slot_home_count(f64_facts)
      let body_next_value = pipeline_ir_function_next_value(first_value, blocks)
      let return_save = body_next_value + 8
      let block_frame = pipeline_ir_native_scalar_frame_size_for_blocks(first_value, blocks)
      let return_frame = pipeline_ir_native_frame_size_for_next_value(return_save + result_lanes)
      pipeline_ir_structural_drop_register_blocks(blocks, fm, fns)
      let abort_cleanup_facts = pipeline_ir_abort_cleanup_facts_for_blocks_with_alias_facts(blocks, fns, fmap_get_tt(fm), fmap_native_return_alias_facts(fm))
      let abort_cleanup_instrumented = pipeline_ir_abort_cleanup_blocks_need_instrumentation(blocks, abort_cleanup_facts)
      let array_storage_base = pipeline_ir_max_i64(block_frame, return_frame)
      let array_storage_facts = pipeline_ir_native_array_storage_facts_for_blocks(blocks, array_storage_base)
      let abort_cleanup_base = pipeline_ir_native_array_storage_frame_size(array_storage_base, array_storage_facts)
      fmap_set_current_array_storage_facts(fm, array_storage_facts)
      fmap_set_current_abort_cleanup_facts(fm, abort_cleanup_facts)
      fmap_set_current_abort_cleanup_base(fm, abort_cleanup_base)
      fmap_set_current_abort_cleanup_boundary(fm, abort_cleanup_base)
      fmap_set_current_abort_cleanup_instrumented(fm, abort_cleanup_instrumented)
      fmap_set_current_frame_size(fm, pipeline_ir_abort_cleanup_frame_size(abort_cleanup_base, abort_cleanup_facts, abort_cleanup_instrumented, fm))
      if f64_slot_count > 0 { fmap_set_current_preserve_fp(fm, 1) } else { 0 }
      fmap_set_current_gpr_pairs(fm, 4)
      emit_prologue_current(code, fm)
      pipeline_ir_abort_cleanup_emit_function_entry(code, fm)
      pipeline_ir_native_emit_lambda_loads(code, 0, nfree)
      -- An all-unmanaged environment dies after the prologue loads. A managed
      -- environment belongs to the prompt's closure-shaped capture owner and
      -- survives until normal fiber completion or continuation drop.
      if pipeline_ir_deferred_completion_is_present(completion) == 0 {
        pipeline_ir_native_emit_deferred_capture_env_release_if_unowned(code, fm, captures, nfree)
      } else { 0 }
      let safe_handlers = pipeline_ir_native_handler_ctx_out_of_line()
      let fiber_handlers = PipelineNativeHandlerCtxCons(eff_hash, clause_infos, nclauses, ops_value, 0 - 1, 0, safe_handlers)
      let body_home_count = pipeline_ir_native_value_home_count_include_evidence(pipeline_ir_native_value_home_count_for_blocks(first_value, blocks), fm)
      let saved_home_count = pipeline_ir_native_value_home_count_include(body_home_count, return_save + result_lanes - 1)
      let contextual_home_count = pipeline_ir_native_value_home_count_include_handlers(saved_home_count, fiber_handlers)
      let pinned = pipeline_ir_native_identity_home_facts_with_handler_scratch(contextual_home_count, blocks, pipeline_ir_native_handler_ctx_len(fiber_handlers))
      bu32(code, cg_ldr(17, 28, runtime_state_deferred_ops_offset()))
      pipeline_ir_native_store_reg(code, pinned, ops_value, 17)
      let temp_base = return_save + result_lanes
      let abort_adr_patches = nlist_new()
      let state = pipeline_ir_native_emit_blocks(blocks, blocks, code, scope_new(), body_src, fm, fiber_handlers, fns, f64_facts, vector_data_facts, abort_adr_patches, pipeline_ir_native_cfg_state(pipeline_ir_native_label_map_empty(), 0, pinned, temp_base))
      let labels = pipeline_ir_native_label_map_add(pipeline_ir_native_cfg_state_labels(state), pipeline_ir_native_epilogue_label(), buf_len(code))
      pipeline_ir_native_patch_all(code, labels, pipeline_ir_native_cfg_state_patches(state))
      pipeline_ir_native_patch_abort_adrs(code, labels, abort_adr_patches)
      for lane in 0..result_lanes {
        pipeline_ir_native_store_reg(code, pinned, return_save + lane, lane)
      }
      if pipeline_ir_deferred_completion_is_present(completion) == 0 {
        pipeline_ir_native_emit_deferred_capture_owner_release_if_owned(code, fm, captures)
      } else { 0 }
      for lane in 0..result_lanes {
        let saved_result = emit_load_reg(code, return_save + lane)
        bu32(code, encode_add_imm(lane, saved_result, 0))
      }
      pipeline_ir_abort_cleanup_emit_function_exit(code, fm)
      emit_epilogue_current(code, fm)
      fmap_set_current_frame_size(fm, old_frame)
      fmap_set_current_preserve_fp(fm, old_preserve_fp)
      fmap_set_current_gpr_pairs(fm, old_gpr_pairs)
      fmap_set_current_abort_cleanup_facts(fm, old_abort_cleanup_facts)
      fmap_set_current_abort_cleanup_base(fm, old_abort_cleanup_base)
      fmap_set_current_abort_cleanup_boundary(fm, old_abort_cleanup_boundary)
      fmap_set_current_abort_cleanup_block(fm, old_abort_cleanup_block)
      fmap_set_current_abort_cleanup_instrumented(fm, old_abort_cleanup_instrumented)
      fmap_set_current_array_storage_facts(fm, old_array_storage_facts)
      cg_cleanup_restore(fm, old_cleanup_depth)
      cg_patch_b(code, skip_pos, buf_len(code))
      pipeline_hclause_info_new(body_start, captures, nfree)
    }
  }
}

pub(package) fn pipeline_ir_native_emit_deferred_push_runtime_state(code: i64, fm: i64) -> i64 {
  cg_bump_alloc_imm(code, fm, 17, deferred_runtime_context_size())
  bu32(code, cg_ldr(9, 28, runtime_state_deferred_ops_offset()))
  bu32(code, cg_str(9, 17, deferred_runtime_context_ops_offset()))
  bu32(code, cg_ldr(9, 28, runtime_state_deferred_prompt_offset()))
  bu32(code, cg_str(9, 17, deferred_runtime_context_prompt_offset()))
  bu32(code, cg_ldr(9, 28, runtime_state_deferred_effect_hash_offset()))
  bu32(code, cg_str(9, 17, deferred_runtime_context_effect_hash_offset()))
  bu32(code, cg_ldr(9, 28, runtime_state_deferred_op_count_offset()))
  bu32(code, cg_str(9, 17, deferred_runtime_context_op_count_offset()))
  bu32(code, cg_ldr(9, 28, runtime_state_deferred_prev_offset()))
  bu32(code, cg_str(9, 17, deferred_runtime_context_prev_offset()))
  bu32(code, cg_str(17, 28, runtime_state_deferred_prev_offset()))
}

pub(package) fn pipeline_ir_native_emit_deferred_pop_runtime_state(code: i64) -> i64 {
  bu32(code, cg_ldr(17, 28, runtime_state_deferred_prev_offset()))
  bu32(code, cg_ldr(9, 17, deferred_runtime_context_ops_offset()))
  bu32(code, cg_str(9, 28, runtime_state_deferred_ops_offset()))
  bu32(code, cg_ldr(9, 17, deferred_runtime_context_prompt_offset()))
  bu32(code, cg_str(9, 28, runtime_state_deferred_prompt_offset()))
  bu32(code, cg_ldr(9, 17, deferred_runtime_context_effect_hash_offset()))
  bu32(code, cg_str(9, 28, runtime_state_deferred_effect_hash_offset()))
  bu32(code, cg_ldr(9, 17, deferred_runtime_context_op_count_offset()))
  bu32(code, cg_str(9, 28, runtime_state_deferred_op_count_offset()))
  bu32(code, cg_ldr(9, 17, deferred_runtime_context_prev_offset()))
  bu32(code, cg_str(9, 28, runtime_state_deferred_prev_offset()))
}

pub(package) fn pipeline_ir_native_emit_capture_env_entries(code: i64, fm: i64, env_ctr: i64, captures: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let capture_lanes = pipeline_capture_value_lane_count(captures)
  if capture_lanes <= 0 {
    emit_mov_imm(code, 17, 0)
    pipeline_ir_native_store_reg(code, pinned, env_ctr, 17)
  } else {
    let env_size = 8 + capture_lanes * 16
    cg_emit_rc_default_alloc_nozero_raw(code, fm, env_size, 8)
    pipeline_ir_native_store_reg(code, pinned, env_ctr, 0)
    let env_phys = pipeline_ir_native_load_reg_raw(code, pinned, env_ctr)
    emit_mov_imm(code, 9, capture_lanes)
    bu32(code, cg_str(9, env_phys, 0))
    -- The environment is closure-shaped. Every managed lane receives one
    -- fiber stake and publishes its exact release kind; when any exist, a
    -- prompt-owned closure pair releases the complete bundle on normal fiber
    -- completion or continuation drop.
    let nfree = if captures == 0 { 0 } else { nlist_len(captures) }
    for i in 0..nfree {
      let capture = nlist_get(captures, i)
      let offset = pipeline_capture_value_lane_offset(captures, i)
      let lanes = pipeline_capture_lane_count(capture)
      for lane in 0..lanes {
        let word = offset + lane
        let value_phys = pipeline_ir_native_load_value_temp_pinned(code, pinned, node_f3(capture) + lane, 9)
        let current_env = pipeline_ir_native_load_reg_temp(code, pinned, env_ctr, 16)
        bu32(code, cg_str(value_phys, current_env, 8 + word * 16))
        let kind = cg_managed_drop_kind_for_ty_lane(node_f4(capture), lane)
        if kind == continuation_cleanup_kind_rc() { cg_emit_rc_retain_phys(code, fm, value_phys) }
        else { if kind == continuation_cleanup_kind_closure() { cg_emit_closure_retain_phys(code, fm, value_phys) }
        else { if kind == continuation_cleanup_kind_weak() { cg_emit_weak_retain_phys(code, fm, value_phys) } else { 0 } } }
        emit_mov_imm(code, 9, kind)
        let current_env2 = pipeline_ir_native_load_reg_temp(code, pinned, env_ctr, 16)
        bu32(code, cg_str(9, current_env2, 16 + word * 16))
      }
    }
  }
  0
}

pub(package) fn pipeline_ir_native_emit_deferred_handle(code: i64, dst: i64, src: i64, body: IrDeferredHandlerBody, clauses: IrHandlerClauseBodyList, nclauses: i64, eff_hash: i64, scratch_base: i64, fm: i64, ctx: PipelineNativeEmitCtx) -> i64 {
  let handlers = pipeline_ir_native_emit_ctx_handlers(ctx)
  let fns = pipeline_ir_native_emit_ctx_fns(ctx)
  let pinned = pipeline_ir_native_emit_ctx_pinned(ctx)
  let clause_infos = pipeline_word_array_new(nclauses)
  for ci in 0..nclauses {
    let info = pipeline_ir_native_emit_hclause_body(ir_handler_clause_body_list_nth(clauses, ci), code, src, fm, handlers, fns)
    pipeline_word_array_set(clause_infos, ci, info)
  }
  let completion_info = match body {
    IrDeferredHandlerBody(body_src, captures, ops_value, body_lanes, first_value, blocks, completion) -> pipeline_ir_native_emit_deferred_completion_function(completion, captures, code, body_src, fm, handlers, fns)
    IrDeferredHandlerBodyInvalid(reason) -> pipeline_hclause_info_new(0, 0, 0)
  }
  let body_info = pipeline_ir_native_emit_deferred_body_function(body, eff_hash, nclauses, clause_infos, code, src, fm, handlers, fns)
  let ops_ctr = scratch_base
  let env_ctr = ops_ctr + 1
  let segment_ctr = ops_ctr + 2
  let prompt_ctr = ops_ctr + 3
  let result_ctr = ops_ctr + 4
  let body_result_lanes = match body {
    IrDeferredHandlerBody(body_src, captures, ops_value, lanes, first_value, blocks, completion) -> lanes
    IrDeferredHandlerBodyInvalid(reason) -> 1
  }
  let completion = match body {
    IrDeferredHandlerBody(body_src, captures, ops_value, lanes, first_value, blocks, body_completion) -> body_completion
    IrDeferredHandlerBodyInvalid(reason) -> IrDeferredCompletionBodyNone
  }
  let has_completion = pipeline_ir_deferred_completion_is_present(completion)
  let result_lanes = pipeline_ir_deferred_completion_result_lanes(completion, body_result_lanes)
  -- Once trampoline returns done, the segment home is dead; reuse it for the
  -- saved dynamic scope so handlers without a transform retain their exact
  -- established frame layout.
  let scope_ctr = segment_ctr
  pipeline_ir_native_emit_deferred_push_runtime_state(code, fm)
  cg_bump_alloc_imm(code, fm, 16, nclauses * handler_ops_entry_size())
  pipeline_ir_native_store_reg(code, pinned, ops_ctr, 16)
  pipeline_ir_native_hfill_ops(clauses, nclauses, clause_infos, code, fm, ops_ctr, pinned)
  pipeline_ir_native_emit_capture_env_entries(code, fm, env_ctr, pipeline_hclause_info_free_vars(body_info), pinned)
  -- Match runtime/effects.weft fiber_default_stack_size(). The native
  -- backend reserves a conservative 2 KiB home area per recursive frame;
  -- abort-cleanup records pushed the 64 KiB segment past its safe depth.
  emit_mov_imm(code, 0, 131072)
  cg_emit_call_lit(code, fm, "fiber_segment_new")
  pipeline_ir_native_store_reg(code, pinned, segment_ctr, 0)
  let segment_phys = pipeline_ir_native_load_reg_temp(code, pinned, segment_ctr, 16)
  bu32(code, encode_add_imm(0, segment_phys, 0))
  cg_emit_call_lit(code, fm, "fiber_prompt_new")
  pipeline_ir_native_store_reg(code, pinned, prompt_ctr, 0)
  let cleanup_prompt_phys = pipeline_ir_native_load_reg_temp(code, pinned, prompt_ctr, 16)
  bu32(code, encode_add_imm(0, cleanup_prompt_phys, 0))
  cg_emit_call_lit(code, fm, "fiber_prompt_enable_cleanup")
  pipeline_ir_native_emit_deferred_capture_owner_new(code, fm, prompt_ctr, env_ctr, pipeline_hclause_info_free_vars(body_info), has_completion, pinned)
  if has_completion == 1 {
    let completion_adr = buf_len(code)
    bu32(code, encode_adr(17, pipeline_hclause_info_clause_start(completion_info) - completion_adr))
    let completion_prompt_phys = pipeline_ir_native_load_reg_temp(code, pinned, prompt_ctr, 16)
    bu32(code, cg_str(17, completion_prompt_phys, pipeline_ir_native_deferred_prompt_completion_offset()))
  } else { 0 }
  let prompt_phys = pipeline_ir_native_load_reg_temp(code, pinned, prompt_ctr, 16)
  bu32(code, cg_str(prompt_phys, 28, runtime_state_deferred_prompt_offset()))
  let ops_phys = pipeline_ir_native_load_reg_temp(code, pinned, ops_ctr, 17)
  bu32(code, cg_str(ops_phys, 28, runtime_state_deferred_ops_offset()))
  emit_mov_imm_safe(code, 9, eff_hash)
  bu32(code, cg_str(9, 28, runtime_state_deferred_effect_hash_offset()))
  emit_mov_imm(code, 9, nclauses)
  bu32(code, cg_str(9, 28, runtime_state_deferred_op_count_offset()))
  bu32(code, encode_add_imm(0, prompt_phys, 0))
  let adr_pos = buf_len(code)
  bu32(code, encode_adr(1, pipeline_hclause_info_clause_start(body_info) - adr_pos))
  let env_phys = pipeline_ir_native_load_reg_temp(code, pinned, env_ctr, 17)
  bu32(code, encode_add_imm(2, env_phys, 0))
  cg_emit_call_lit(code, fm, "fiber_trampoline")
  for lane in 0..body_result_lanes {
    pipeline_ir_native_store_reg(code, pinned, result_ctr + lane, lane)
  }
  cg_emit_call_lit(code, fm, "fiber_is_done")
  bu32(code, encode_cmp(0, 31))
  let suspended_pos = buf_len(code)
  bu32(code, 0)
  if has_completion == 1 {
    pipeline_ir_native_save_deferred_runtime_state_to_reg(code, fm, 17)
    pipeline_ir_native_store_reg(code, pinned, scope_ctr, 17)
    pipeline_ir_native_emit_deferred_pop_runtime_state(code)
    let completion_env = pipeline_ir_native_load_reg_temp(code, pinned, env_ctr, 16)
    bu32(code, encode_add_imm(0, completion_env, 0))
    for lane in 0..body_result_lanes {
      let input_phys = pipeline_ir_native_load_reg(code, pinned, result_ctr + lane)
      if input_phys != lane + 1 { bu32(code, encode_add_imm(lane + 1, input_phys, 0)) } else { 0 }
    }
    let completion_adr = buf_len(code)
    bu32(code, encode_adr(17, pipeline_hclause_info_clause_start(completion_info) - completion_adr))
    bu32(code, encode_blr(17))
    for lane in 0..result_lanes {
      pipeline_ir_native_store_reg_pinned(code, pinned, dst + lane, lane)
    }
    let saved_scope_phys = pipeline_ir_native_load_reg_temp(code, pinned, scope_ctr, 17)
    pipeline_ir_native_restore_deferred_runtime_state_from_reg(code, saved_scope_phys)
    pipeline_ir_native_emit_deferred_capture_owner_release_from_prompt(code, fm, pipeline_ir_native_load_reg_temp(code, pinned, prompt_ctr, 16))
  } else {
    for lane in 0..result_lanes {
      let done_result_phys = pipeline_ir_native_load_reg(code, pinned, result_ctr + lane)
      pipeline_ir_native_store_reg_pinned(code, pinned, dst + lane, done_result_phys)
    }
  }
  let done_jump_pos = buf_len(code)
  bu32(code, 0)
  let suspended = buf_len(code)
  cg_patch_b_cond(code, suspended_pos, 0, suspended)
  let packet_phys = pipeline_ir_native_load_reg_temp(code, pinned, result_ctr, 16)
  pipeline_ir_native_emit_deferred_call_packet_regs(code, packet_phys, 0)
  for lane in 0..result_lanes {
    pipeline_ir_native_store_reg_pinned(code, pinned, dst + lane, lane)
  }
  let finish = buf_len(code)
  cg_patch_b(code, done_jump_pos, finish)
  pipeline_ir_native_emit_deferred_pop_runtime_state(code)
  -- Match the ordinary call ABI: lane zero is defined by the deferred
  -- handle instruction and the following IrCallResultLane nodes read the
  -- remaining physical result registers.
  for lane in 0..result_lanes {
    let result_phys = pipeline_ir_native_load_reg(code, pinned, dst + lane)
    if result_phys != lane { bu32(code, encode_add_imm(lane, result_phys, 0)) } else { 0 }
  }
  0
}

pub(package) fn pipeline_ir_native_emit_handle(code: i64, src: i64, fm: i64, eff_hash: i64, clauses: IrHandlerClauseBodyList, nclauses: i64, abort_block: i64, emit_ctx: PipelineNativeEmitCtx) -> PipelineNativeHandlerCtx {
  let ctx = pipeline_ir_native_emit_ctx_handlers(emit_ctx)
  let fns = pipeline_ir_native_emit_ctx_fns(emit_ctx)
  let pinned = pipeline_ir_native_emit_ctx_pinned(emit_ctx)
  if nclauses <= 0 { ctx }
  else {
    let clause_infos = pipeline_word_array_new(nclauses)
    for ci in 0..nclauses {
      let info = pipeline_ir_native_emit_hclause_body(ir_handler_clause_body_list_nth(clauses, ci), code, src, fm, ctx, fns)
      pipeline_word_array_set(clause_infos, ci, info)
    }
    let depth = pipeline_ir_native_handler_ctx_len(ctx)
    let ops_ctr = pipeline_ir_native_handler_scratch_base(pinned) + depth * 2
    let frame_ctr = ops_ctr + 1
    cg_bump_alloc_imm(code, fm, 16, nclauses * handler_ops_entry_size())
    pipeline_ir_native_store_reg(code, pinned, ops_ctr, 16)
    pipeline_ir_native_hfill_ops(clauses, nclauses, clause_infos, code, fm, ops_ctr, pinned)
    let adr_pos = cg_hbuild_frame_maybe_abort(code, fm, eff_hash, nclauses, ops_ctr, if abort_block >= 0 { 1 } else { 0 })
    if adr_pos > 0 {
      nlist_add(pipeline_ir_native_emit_ctx_adr_patches(emit_ctx), node_new(0, adr_pos, abort_block, 0, 0))
    } else { 0 }
    pipeline_ir_native_store_reg(code, pinned, frame_ctr, 27)
    PipelineNativeHandlerCtxCons(eff_hash, clause_infos, nclauses, ops_ctr, frame_ctr, if abort_block >= 0 { 1 } else { 0 }, ctx)
  }
}

pub(package) fn pipeline_ir_native_emit_direct(code: i64, dst: i64, handler_depth: i64, clause_index: i64, args: IrValueList, ctx: PipelineNativeHandlerCtx, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let found = pipeline_ir_native_handler_ctx_at(ctx, handler_depth)
  match found {
    PipelineNativeHandlerCtxNil -> 0
    PipelineNativeHandlerCtxCons(eff_hash, infos, nclauses, ops_ctr, frame_ctr, is_abortive, rest) -> {
      if frame_ctr < 0 {
        let ops_phys = pipeline_ir_native_load_reg(code, pinned, ops_ctr)
        bu32(code, encode_add_imm(13, ops_phys, clause_index * handler_ops_entry_size()))
        pipeline_ir_native_emit_deferred_suspend_direct(code, dst, 13, args, fm, pinned)
      } else {
        let info = pipeline_word_array_get(infos, clause_index)
        let clause_start = pipeline_hclause_info_clause_start(info)
        pipeline_ir_native_move_args(code, args, 0, pinned)
        let nfree = pipeline_hclause_info_nfree(info)
        if nfree == 0 {
          emit_mov_imm(code, 0, 0)
        } else {
          let ops_phys = pipeline_ir_native_load_reg(code, pinned, ops_ctr)
          bu32(code, cg_ldr(0, ops_phys, clause_index * handler_ops_entry_size() + handler_ops_env_ptr_offset()))
        }
        -- Mask the handler's own frame during the clause call (same
        -- contract as pipeline_ir_native_emit_masked_clause_call): a
        -- dynamic perform inside the clause must not find this frame,
        -- or a clause performing its own label re-enters itself. The
        -- statically known frame register gives prev without the
        -- runtime-state slot.
        let frame_phys = pipeline_ir_native_load_reg(code, pinned, frame_ctr)
        -- The clause cannot read x27: it is masked for sound dispatch.
        -- Hand the actual frame over through runtime state, matching the
        -- dynamic handler_find_entry path. Its prologue snapshots the slot.
        bu32(code, cg_str(frame_phys, 28, runtime_state_dispatch_frame_offset()))
        bu32(code, cg_ldr(15, frame_phys, handler_frame_prev_offset()))
        bu32(code, encode_sub_imm(31, 31, 16))
        bu32(code, encode_str(27, 31, 0))
        bu32(code, encode_add_imm(27, 15, 0))
        let cur = buf_len(code)
        bu32(code, encode_bl(clause_start - cur))
        bu32(code, encode_ldr(27, 31, 0))
        bu32(code, encode_add_imm(31, 31, 16))
        pipeline_ir_native_store_reg_pinned(code, pinned, dst, 0)
      }
    }
  }
}

pub(package) fn pipeline_ir_native_emit_perform_via_evidence(code: i64, dst: i64, clause_index: i64, args: IrValueList, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let ev_phys = pipeline_ir_native_load_reg(code, pinned, fmap_lambda_evidence_value(fm))
  bu32(code, encode_add_imm(13, ev_phys, clause_index * handler_ops_entry_size()))
  -- x1-x14 are effect payload lanes. Keep the indirect target in reserved
  -- scratch x17 so a wide operation cannot overwrite it while staging args.
  bu32(code, cg_ldr(17, 13, handler_ops_fn_ptr_offset()))
  bu32(code, cg_ldr(0, 13, handler_ops_env_ptr_offset()))
  pipeline_ir_native_move_args(code, args, 0, pinned)
  -- Evidence carries the lexical frame as well as the ops table. Give the
  -- clause the same masking contract as ordinary direct/dynamic dispatch,
  -- and publish the actual frame for abort or compiler-inserted Drop.
  let frame_phys = pipeline_ir_native_load_reg(code, pinned, fmap_lambda_evidence_frame_value(fm))
  bu32(code, cg_str(frame_phys, 28, runtime_state_dispatch_frame_offset()))
  bu32(code, cg_ldr(15, frame_phys, handler_frame_prev_offset()))
  bu32(code, encode_sub_imm(31, 31, 16))
  bu32(code, encode_str(27, 31, 0))
  bu32(code, encode_add_imm(27, 15, 0))
  bu32(code, encode_blr(17))
  bu32(code, encode_ldr(27, 31, 0))
  bu32(code, encode_add_imm(31, 31, 16))
  pipeline_ir_native_store_reg_pinned(code, pinned, dst, 0)
  fmap_inc_effect_evidence_count(fm)
}

pub(package) fn pipeline_ir_native_emit_perform(code: i64, dst: i64, effect_hash: i64, op_hash: i64, args: IrValueList, fm: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  let evidence_index = if fmap_lambda_evidence_eff(fm) == effect_hash { pipeline_nlist_index_of(fmap_lambda_evidence_ops(fm), op_hash) } else { 0 - 1 }
  if evidence_index >= 0 {
    pipeline_ir_native_emit_perform_via_evidence(code, dst, evidence_index, args, fm, pinned)
    0
  } else {
  bu32(code, cg_ldr(14, 28, runtime_state_deferred_ops_offset()))
  bu32(code, cg_ldr(10, 28, runtime_state_deferred_prev_offset()))
  bu32(code, cg_ldr(15, 28, runtime_state_deferred_effect_hash_offset()))
  bu32(code, cg_ldr(12, 28, runtime_state_deferred_op_count_offset()))
  emit_mov_imm_safe(code, 16, effect_hash)
  emit_mov_imm_safe(code, 17, op_hash)
  let frame_loop = buf_len(code)
  let no_deferred_pos = buf_len(code)
  bu32(code, 0)
  bu32(code, encode_cmp(15, 16))
  let effect_miss_pos = buf_len(code)
  bu32(code, 0)
  emit_mov_imm(code, 11, 0)
  bu32(code, encode_add_imm(13, 14, 0))
  let scan_loop = buf_len(code)
  bu32(code, encode_cmp(11, 12))
  let scan_done_pos = buf_len(code)
  bu32(code, 0)
  bu32(code, cg_ldr(15, 13, handler_ops_op_hash_offset()))
  bu32(code, encode_cmp(15, 17))
  let found_pos = buf_len(code)
  bu32(code, 0)
  bu32(code, encode_add_imm(13, 13, handler_ops_entry_size()))
  bu32(code, encode_add_imm(11, 11, 1))
  let loop_back_pos = buf_len(code)
  bu32(code, 0)
  let found = buf_len(code)
  cg_patch_b(code, loop_back_pos, scan_loop)
  cg_patch_b_cond(code, found_pos, 0, found)
  pipeline_ir_native_emit_deferred_suspend_dynamic(code, dst, 13, args, fm, pinned)
  let deferred_done_pos = buf_len(code)
  bu32(code, 0)
  let next_frame = buf_len(code)
  cg_patch_b_cond(code, effect_miss_pos, 1, next_frame)
  cg_patch_b_cond(code, scan_done_pos, 10, next_frame)
  let no_prev_pos = buf_len(code)
  bu32(code, 0)
  bu32(code, cg_ldr(14, 10, deferred_runtime_context_ops_offset()))
  bu32(code, cg_ldr(15, 10, deferred_runtime_context_effect_hash_offset()))
  bu32(code, cg_ldr(12, 10, deferred_runtime_context_op_count_offset()))
  bu32(code, cg_ldr(10, 10, deferred_runtime_context_prev_offset()))
  let next_loop_pos = buf_len(code)
  bu32(code, 0)
  let normal_lookup = buf_len(code)
  cg_patch_cbz(code, no_deferred_pos, 14, normal_lookup)
  cg_patch_cbz(code, no_prev_pos, 10, normal_lookup)
  cg_patch_b(code, next_loop_pos, frame_loop)
  cg_perform_lookup(code, fm, effect_hash, op_hash)
  bu32(code, cg_ldr(17, 13, handler_ops_fn_ptr_offset()))
  bu32(code, cg_ldr(0, 13, handler_ops_env_ptr_offset()))
  pipeline_ir_native_move_args(code, args, 0, pinned)
  pipeline_ir_native_emit_masked_clause_call(code)
  pipeline_ir_native_store_reg_pinned(code, pinned, dst, 0)
  cg_patch_b(code, deferred_done_pos, buf_len(code))
  }
}

-- Call the clause (fn ptr in reserved scratch x17, args staged) with the found handler's
-- own frame masked out of the dispatch context: handler_find_entry
-- stashed the found frame's prev in runtime state, and the clause runs
-- with x27 = that prev so a clause performing an effect of its OWN
-- label dispatches to the enclosing handler instead of re-entering
-- itself (unbounded self-recursion otherwise). x27 is saved across the
-- call on the stack; sp is adjusted only around the BLR, after all arg
-- staging, so spill-slot offsets are unaffected.
pub(package) fn pipeline_ir_native_emit_masked_clause_call(code: i64) -> i64 {
  bu32(code, cg_ldr(15, 28, runtime_state_dispatch_prev_offset()))
  bu32(code, encode_sub_imm(31, 31, 16))
  bu32(code, encode_str(27, 31, 0))
  bu32(code, encode_add_imm(27, 15, 0))
  bu32(code, encode_blr(17))
  bu32(code, encode_ldr(27, 31, 0))
  bu32(code, encode_add_imm(31, 31, 16))
}

pub(package) fn pipeline_ir_native_emit_mem_load_sized_result(code: i64, fm: i64) -> i64 {
  emit_mov_imm_safe(code, 13, cg_layout_vector_record_mode())
  bu32(code, encode_cmp(2, 13))
  let not_record_pos = buf_len(code)
  bu32(code, 0)
  cg_bump_alloc_reg(code, fm, 17, 1)
  cg_emit_mem_copy_regs(code, 17, 0, 1)
  let done_from_record = buf_len(code)
  bu32(code, 0)

  let scalar_start = buf_len(code)
  cg_patch_b_cond(code, not_record_pos, 1, scalar_start)
  emit_mov_imm_safe(code, 17, 0)
  emit_mov_imm_safe(code, 13, 0)
  bu32(code, encode_cmp(1, 13))
  let size_zero_pos = buf_len(code)
  bu32(code, 0)

  emit_mov_imm_safe(code, 13, 8)
  bu32(code, encode_cmp(1, 13))
  let not_8_pos = buf_len(code)
  bu32(code, 0)
  bu32(code, cg_ldr(17, 0, 0))
  let done_from_8 = buf_len(code)
  bu32(code, 0)

  let check_4 = buf_len(code)
  cg_patch_b_cond(code, not_8_pos, 1, check_4)
  emit_mov_imm_safe(code, 13, 4)
  bu32(code, encode_cmp(1, 13))
  let not_4_pos = buf_len(code)
  bu32(code, 0)
  emit_mov_imm_safe(code, 17, 0)
  cg_i_sized_load_or_byte(code, 0, 0)
  cg_i_sized_load_or_byte(code, 1, 8)
  cg_i_sized_load_or_byte(code, 2, 16)
  cg_i_sized_load_or_byte(code, 3, 24)
  emit_mov_imm_safe(code, 13, 6)
  bu32(code, encode_cmp(2, 13))
  let load4_unsigned_pos = buf_len(code)
  bu32(code, 0)
  bu32(code, encode_sxtw(17, 17))
  let done_from_4 = buf_len(code)
  bu32(code, 0)
  let load4_unsigned = buf_len(code)
  cg_patch_b_cond(code, load4_unsigned_pos, 1, load4_unsigned)
  let done_from_4_unsigned = buf_len(code)
  bu32(code, 0)

  let check_2 = buf_len(code)
  cg_patch_b_cond(code, not_4_pos, 1, check_2)
  emit_mov_imm_safe(code, 13, 2)
  bu32(code, encode_cmp(1, 13))
  let not_2_pos = buf_len(code)
  bu32(code, 0)
  emit_mov_imm_safe(code, 17, 0)
  cg_i_sized_load_or_byte(code, 0, 0)
  cg_i_sized_load_or_byte(code, 1, 8)
  emit_mov_imm_safe(code, 13, 4)
  bu32(code, encode_cmp(2, 13))
  let load2_unsigned_pos = buf_len(code)
  bu32(code, 0)
  bu32(code, encode_sxth(17, 17))
  let done_from_2 = buf_len(code)
  bu32(code, 0)
  let load2_unsigned = buf_len(code)
  cg_patch_b_cond(code, load2_unsigned_pos, 1, load2_unsigned)
  let done_from_2_unsigned = buf_len(code)
  bu32(code, 0)

  let load_1 = buf_len(code)
  cg_patch_b_cond(code, not_2_pos, 1, load_1)
  emit_mov_imm_safe(code, 17, 0)
  bu32(code, cg_ldrb(17, 0, 0))
  emit_mov_imm_safe(code, 13, 2)
  bu32(code, encode_cmp(2, 13))
  let load1_unsigned_pos = buf_len(code)
  bu32(code, 0)
  bu32(code, encode_sxtb(17, 17))

  let done = buf_len(code)
  cg_patch_b_cond(code, size_zero_pos, 0, done)
  cg_patch_b(code, done_from_8, done)
  cg_patch_b(code, done_from_4, done)
  cg_patch_b(code, done_from_4_unsigned, done)
  cg_patch_b(code, done_from_2, done)
  cg_patch_b(code, done_from_2_unsigned, done)
  cg_patch_b_cond(code, load1_unsigned_pos, 1, done)
  cg_patch_b(code, done_from_record, done)
}

pub(package) fn pipeline_ir_native_emit_mem_store_sized_result(code: i64) -> i64 {
  emit_mov_imm_safe(code, 13, cg_layout_vector_record_mode())
  bu32(code, encode_cmp(2, 13))
  let not_record_pos = buf_len(code)
  bu32(code, 0)
  cg_emit_mem_copy_regs(code, 0, 3, 1)
  let done_from_record = buf_len(code)
  bu32(code, 0)

  let scalar_start = buf_len(code)
  cg_patch_b_cond(code, not_record_pos, 1, scalar_start)
  emit_mov_imm_safe(code, 13, 0)
  bu32(code, encode_cmp(1, 13))
  let size_zero_pos = buf_len(code)
  bu32(code, 0)

  emit_mov_imm_safe(code, 13, 8)
  bu32(code, encode_cmp(1, 13))
  let not_8_pos = buf_len(code)
  bu32(code, 0)
  bu32(code, cg_str(3, 0, 0))
  let done_from_8 = buf_len(code)
  bu32(code, 0)

  let check_4 = buf_len(code)
  cg_patch_b_cond(code, not_8_pos, 1, check_4)
  emit_mov_imm_safe(code, 13, 4)
  bu32(code, encode_cmp(1, 13))
  let not_4_pos = buf_len(code)
  bu32(code, 0)
  cg_i_sized_store_byte(code, 0, 0)
  cg_i_sized_store_byte(code, 1, 8)
  cg_i_sized_store_byte(code, 2, 16)
  cg_i_sized_store_byte(code, 3, 24)
  let done_from_4 = buf_len(code)
  bu32(code, 0)

  let check_2 = buf_len(code)
  cg_patch_b_cond(code, not_4_pos, 1, check_2)
  emit_mov_imm_safe(code, 13, 2)
  bu32(code, encode_cmp(1, 13))
  let not_2_pos = buf_len(code)
  bu32(code, 0)
  cg_i_sized_store_byte(code, 0, 0)
  cg_i_sized_store_byte(code, 1, 8)
  let done_from_2 = buf_len(code)
  bu32(code, 0)

  let store_1 = buf_len(code)
  cg_patch_b_cond(code, not_2_pos, 1, store_1)
  bu32(code, cg_strb(3, 0, 0))

  let done = buf_len(code)
  cg_patch_b_cond(code, size_zero_pos, 0, done)
  cg_patch_b(code, done_from_8, done)
  cg_patch_b(code, done_from_4, done)
  cg_patch_b(code, done_from_2, done)
  cg_patch_b(code, done_from_record, done)
  bu32(code, encode_add_imm(17, 3, 0))
}

pub(package) fn pipeline_ir_native_store_syscall_result(code: i64, dst: i64, pinned: PipelineIrNativeValueHomeFacts) -> i64 {
  bu32(code, encode_add_imm(17, 0, 0))
  let result_phys = pipeline_ir_native_value_home_lookup(pinned, dst)
  if result_phys == 0 {
    -- Values outside the ordinary home table are compiler-authored
    -- scratch ids and keep their canonical identity home.
    pipeline_ir_native_store_reg(code, pinned, dst, 17)
  } else {
    -- Ordinary results must use the allocator's one store authority:
    -- this preserves discard/rematerialisation decisions and emits the
    -- allocation-checker definition event for the selected home.
    pipeline_ir_native_store_reg_pinned(code, pinned, dst, 17)
  }
}

pub(package) fn pipeline_ir_native_emit_intrinsic_call(code: i64, dst: i64, callee_hash: i64, kind: i64, args: IrValueList, pinned: PipelineIrNativeValueHomeFacts, fm: i64) -> i64 {
