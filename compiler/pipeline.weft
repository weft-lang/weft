  match ctx {
    PipelineTargetCtx(params, locals, module, next_value, start_block, next_block, target_block, local_float, local_type_node) -> start_block
  }
}

fn pipeline_target_ctx_next_block(ctx: PipelineTargetCtx) -> i64 {
  match ctx {
    PipelineTargetCtx(params, locals, module, next_value, start_block, next_block, target_block, local_float, local_type_node) -> next_block
  }
}

fn pipeline_target_ctx_target_block(ctx: PipelineTargetCtx) -> i64 {
  match ctx {
    PipelineTargetCtx(params, locals, module, next_value, start_block, next_block, target_block, local_float, local_type_node) -> target_block
  }
}

fn pipeline_target_ctx_local_float(ctx: PipelineTargetCtx) -> i64 {
  match ctx {
    PipelineTargetCtx(params, locals, module, next_value, start_block, next_block, target_block, local_float, local_type_node) -> local_float
  }
