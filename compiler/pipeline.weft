-- Generic-call sites the backend lowers as per-spec constants (see
-- pipeline_ir_native_emit_generic_call): the collected spec's IR body
-- is a `const 0` placeholder — the real value exists only at emission.
-- Any pass that resolves a generic call site to its spec BODY (the
-- multi-inliner's splice site resolution) must treat these sites as
-- opaque, or it hard-wires the placeholder.
fn pipeline_ir_native_generic_call_constant_intrinsic(callee_hash: i64, args: IrValueList) -> i64 {
  if ir_value_list_len(args) != 0 { 0 }
  else { if callee_hash == pipeline_ir_native_vector_element_size_of_hash() or callee_hash == pipeline_ir_native_vector_element_mode_of_hash() or callee_hash == pipeline_ir_native_map_storage_cleanup_kind_of_hash() { 1 } else { 0 } }
}

fn pipeline_ir_native_vector_storage_store_value_hash() -> i64 {
  str_hash(__str_ptr("vector_storage_store_value"), 0, __str_len("vector_storage_store_value"))
}

fn pipeline_ir_native_vector_store_value_hash() -> i64 {
