-- compiler/tree_sitter.weft -- Tree-sitter interpretation of SyntaxGrammar
--
-- This module owns no Weft productions.  It renders the typed graph exposed
-- by compiler/grammar.weft into Tree-sitter's JavaScript grammar DSL.

use compiler/grammar.{weft_syntax_grammar}
use compiler/syntax_grammar.{*}
use runtime/buffer.{*}
use runtime/memory.{mem_load8_at}
use runtime/string.{runtime_int_to_str, runtime_str_from_bytes_copy}

fn tree_sitter_append_js_string(out: i64, value: str) -> i64 {
  bstr(out, "'")
  let ptr = __str_ptr(value)
  let n = __str_len(value)
  let mut i = 0
  while i < n {
    let byte = mem_load8_at(ptr, i)
    if byte == 39 { bstr(out, "\\'") }
    else { if byte == 92 { bstr(out, "\\\\") }
    else { if byte == 10 { bstr(out, "\\n") }
    else { if byte == 13 { bstr(out, "\\r") }
    else { if byte == 9 { bstr(out, "\\t") }
    else { bu8(out, byte) } } } } }
    i = i + 1
  }
  bstr(out, "'")
}

fn tree_sitter_append_expr(out: i64, expr: SyntaxExpr) -> i64 {
  match expr {
    SyntaxLiteral(value) -> tree_sitter_append_js_string(out, value)
    SyntaxPattern(value) -> { bstr(out, "/") bstr(out, value) bstr(out, "/") }
    SyntaxRustPattern(value) -> {
      bstr(out, "new RustRegex(") tree_sitter_append_js_string(out, value) bstr(out, ")")
    }
    SyntaxReference(name) -> { bstr(out, "$.") bstr(out, name) }
    SyntaxSequence(items) -> {
      bstr(out, "seq(") tree_sitter_append_exprs(out, items) bstr(out, ")")
    }
    SyntaxChoice(items) -> {
      bstr(out, "choice(") tree_sitter_append_exprs(out, items) bstr(out, ")")
    }
    SyntaxRepeat(value) -> {
      bstr(out, "repeat(") tree_sitter_append_expr(out, value) bstr(out, ")")
    }
    SyntaxRepeatOne(value) -> {
      bstr(out, "repeat1(") tree_sitter_append_expr(out, value) bstr(out, ")")
    }
    SyntaxOptional(value) -> {
      bstr(out, "optional(") tree_sitter_append_expr(out, value) bstr(out, ")")
    }
    SyntaxField(name, value) -> {
      bstr(out, "field(") tree_sitter_append_js_string(out, name) bstr(out, ", ")
      tree_sitter_append_expr(out, value) bstr(out, ")")
    }
    SyntaxPrecedence(level, value) -> {
      bstr(out, "prec(") bstr(out, runtime_int_to_str(level)) bstr(out, ", ")
      tree_sitter_append_expr(out, value) bstr(out, ")")
    }
    SyntaxPrecedenceLeft(level, value) -> {
      bstr(out, "prec.left(") bstr(out, runtime_int_to_str(level)) bstr(out, ", ")
      tree_sitter_append_expr(out, value) bstr(out, ")")
    }
    SyntaxPrecedenceRight(value) -> {
      bstr(out, "prec.right(") tree_sitter_append_expr(out, value) bstr(out, ")")
    }
    SyntaxPrecedenceRightAt(level, value) -> {
      bstr(out, "prec.right(") bstr(out, runtime_int_to_str(level)) bstr(out, ", ")
      tree_sitter_append_expr(out, value) bstr(out, ")")
    }
    SyntaxToken(value) -> {
      bstr(out, "token(") tree_sitter_append_expr(out, value) bstr(out, ")")
    }
    SyntaxTokenImmediate(value) -> {
      bstr(out, "token.immediate(") tree_sitter_append_expr(out, value) bstr(out, ")")
    }
    SyntaxCommaSeparated(value) -> {
      bstr(out, "commaSep(") tree_sitter_append_expr(out, value) bstr(out, ")")
    }
    SyntaxCommaSeparatedOne(value) -> {
      bstr(out, "commaSep1(") tree_sitter_append_expr(out, value) bstr(out, ")")
    }
  }
}

fn tree_sitter_append_exprs(out: i64, items: SyntaxExprList) -> i64 {
  let mut current = items
  let mut first = true
  let mut done = false
  while not done {
    match current {
      SyntaxExprNil -> { done = true }
      SyntaxExprCons(expr, rest) -> {
        if not first { bstr(out, ", ") } else { first = false }
        tree_sitter_append_expr(out, expr)
        current = rest
      }
    }
  }
  0
}

fn tree_sitter_append_conflicts(out: i64, conflicts: SyntaxConflictList) -> i64 {
  let mut current = conflicts
  let mut done = false
  while not done {
    match current {
      SyntaxConflictNil -> { done = true }
      SyntaxConflictCons(items, rest) -> {
        bstr(out, "    [") tree_sitter_append_exprs(out, items) bstr(out, "],\n")
        current = rest
      }
    }
  }
  0
}

fn tree_sitter_append_rules(out: i64, rules: SyntaxRuleList) -> i64 {
  let mut current = rules
  let mut done = false
  while not done {
    match current {
      SyntaxRuleNil -> { done = true }
      SyntaxRuleCons(SyntaxRule(name, body), rest) -> {
        bstr(out, "    ") bstr(out, name) bstr(out, ": $ => ")
        tree_sitter_append_expr(out, body)
        bstr(out, ",\n")
        current = rest
      }
    }
  }
  0
}

pub(package) fn tree_sitter_weft_grammar_source() -> str {
  let out = buf_new(65536)
  match weft_syntax_grammar() {
    SyntaxGrammar(name, extras, word, supertypes, conflicts, rules) -> {
      bstr(out, "/// <reference types=\"tree-sitter-cli/dsl\" />\n")
      bstr(out, "// @generated by `weft tree-sitter-grammar`; do not edit.\n\n")
      bstr(out, "module.exports = grammar({\n  name: ")
      tree_sitter_append_js_string(out, name)
      bstr(out, ",\n  extras: $ => [") tree_sitter_append_exprs(out, extras) bstr(out, "],\n")
      bstr(out, "  word: $ => ") tree_sitter_append_expr(out, word) bstr(out, ",\n")
      bstr(out, "  supertypes: $ => [") tree_sitter_append_exprs(out, supertypes) bstr(out, "],\n")
      bstr(out, "  conflicts: $ => [\n") tree_sitter_append_conflicts(out, conflicts) bstr(out, "  ],\n")
      bstr(out, "  rules: {\n") tree_sitter_append_rules(out, rules) bstr(out, "  },\n});\n\n")
      bstr(out, "function commaSep(rule) { return optional(commaSep1(rule)); }\n")
      bstr(out, "function commaSep1(rule) { return seq(rule, repeat(seq(',', rule)), optional(',')); }\n")
    }
  }
  runtime_str_from_bytes_copy(buf_ptr(out), buf_len(out))
}
