-- Host source acquisition and runtime selection precede checked Grammar.

use compiler/weft/check as weft_check
use compiler/weft/check.{CheckProgram}
use compiler/weft/imports.{parse_bind_implicit_prelude_with_loader}
use compiler/weft/products.{AstModule, TypedModule}
use compiler/source/loading.{SourceLoader}
use compiler/pipeline.{pipeline_check_with_loader, pipeline_bind_runtime_preludes_inner_with_loader, pipeline_bind_native_runtime_preludes_inner_with_loader, pipeline_bind_rc_census_prelude_with_loader}
use stdlib/diagnostic.{Diagnose}
use stdlib/grammar.{CheckResult}

pub(package) type NativeRuntimeSupport { NativeRuntime, NativeRuntimeWithRcCensus }

pub(package) fn check_weft_program_with_loader<E>(syntax: AstModule, loader: SourceLoader<E>) -[Diagnose, E]> CheckResult<TypedModule> {
  pipeline_check_with_loader(syntax, CheckProgram, loader)
}

pub(package) fn check_weft_native_program_with_loader<E>(syntax: AstModule, loader: SourceLoader<E>) -[Diagnose, E]> CheckResult<TypedModule> {
  check_weft_native_program_with_support_and_loader(syntax, NativeRuntime, loader)
}

pub(package) fn check_weft_native_program_with_support_and_loader<E>(syntax: AstModule, support: NativeRuntimeSupport, loader: SourceLoader<E>) -[Diagnose, E]> CheckResult<TypedModule> {
  match syntax {
    AstModule(functions, source, table, _) -> {
      let load: () -[Diagnose, E]> i64 = () => {
        pipeline_bind_native_runtime_preludes_inner_with_loader<E>(functions, source, table, loader)
        match support {
          NativeRuntime -> 0
          NativeRuntimeWithRcCensus -> pipeline_bind_rc_census_prelude_with_loader<E>(functions, table, loader)
        }
        parse_bind_implicit_prelude_with_loader<E>(functions, source, table, loader)
        pipeline_bind_runtime_preludes_inner_with_loader<E>(functions, source, table, loader)
      }
      weft_check.after_loading(CheckProgram, syntax, loader, load)
    }
  }
}
