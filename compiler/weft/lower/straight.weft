pub(package) type CheckedStraightLowerIssue {
  CheckedStraightUnsupportedExpression(CheckedExprKind),
  CheckedStraightUnsupportedPattern(CheckedPatternKind),
  CheckedStraightFunctionSymbolMissing(FunctionIdentity),
  CheckedStraightBindingMissing(CheckedBindingId),
  CheckedStraightBindingNotMutable(CheckedBindingId),
  CheckedStraightControlOutsideLoop(CheckedExprKind),
  CheckedStraightResumeOutsideHandler,
  CheckedStraightValueShapeUnavailable,
  CheckedStraightWideValueUnsupported(usize),
  CheckedStraightManagedMutableUnsupported(SemanticTypeId)
}

pub(package) type CheckedStraightFunctionResult {
  CheckedStraightFunctionLowered(IrFunction),
  CheckedStraightFunctionRejected(CheckedStraightLowerIssue)
}

type CheckedStraightValueEnv {
  CheckedStraightValueEnvNil,
  CheckedStraightValueEnvResume(CheckedStraightValueEnv),
  CheckedStraightValueEnvCons(
    CheckedBindingId,
    CheckedStraightBindingHome,
    CheckedStraightValueEnv
  )
}

type CheckedStraightBindingHome {
  CheckedStraightValueHome(CheckedFlowValue),
  CheckedStraightSlotHome(i64, SemanticTypeId)
}

type CheckedStraightCleanupStack {
  CheckedStraightCleanupNil,
  CheckedStraightCleanupCons(
    i64,
    SemanticTypeId,
    CheckedStraightCleanupStack
  )
}

type CheckedFlowValue {
  head: i64,
  lanes: IrValueList
}

type CheckedStraightFlowState {
  current_block: i64,
  current_params: IrValueList,
  current_insts: IrInstList,
  completed_blocks: IrBlockList,
  next_block: i64,
  next_value: i64,
  loop_targets: CheckedStraightLoopTargets,
  cleanups: CheckedStraightCleanupStack,
  cleanup_depth: usize,
  function_exit: bool,
  catalog: SemanticTypeCatalog,
  declarations: SemanticTypeDeclarationCatalog,
  patterns: CheckedPatternGraph,
  closures: CheckedClosureGraph,
  effects: CheckedEffectGraph,
  substitution: SemanticTypeSubstitution
}

type CheckedStraightLoopTargets {
  CheckedStraightOutsideLoop,
  CheckedStraightInsideLoop(
    i64,
    i64,
    i64,
    usize,
    CheckedStraightLoopTargets
  )
}

type CheckedFlowValueResult {
  CheckedFlowValueLowered(CheckedFlowValue, CheckedStraightFlowState),
  CheckedFlowValueTerminated(CheckedStraightFlowState),
  CheckedFlowValueRejected(CheckedStraightLowerIssue)
}

type CheckedFlowArgumentsResult {
  CheckedFlowArgumentsLowered(IrValueList, CheckedStraightFlowState),
  CheckedFlowArgumentsTerminated(CheckedStraightFlowState),
  CheckedFlowArgumentsRejected(CheckedStraightLowerIssue)
}

type CheckedFlowPatternResult {
  CheckedFlowPatternMatched(
    CheckedStraightFlowState,
    CheckedStraightValueEnv
  ),
  CheckedFlowPatternRejected(CheckedStraightLowerIssue)
}

type CheckedFlowCapturesResult {
  CheckedFlowCapturesLowered(
    IrValueList,
    IrSemanticCaptureList,
    usize,
    CheckedStraightFlowState
  ),
  CheckedFlowCapturesTerminated(CheckedStraightFlowState),
  CheckedFlowCapturesRejected(CheckedStraightLowerIssue)
}

type CheckedFlowNestedFunctionResult {
  CheckedFlowNestedFunctionLowered(IrFunction),
  CheckedFlowNestedFunctionRejected(CheckedStraightLowerIssue)
}

type CheckedFlowHandlerBindingsResult {
  CheckedFlowHandlerBindingsLowered(
    CheckedStraightValueEnv,
    IrSemanticCaptureList,
    usize,
    i64
  ),
  CheckedFlowHandlerBindingsRejected(CheckedStraightLowerIssue)
}

type CheckedFlowHandlerClausesResult {
  CheckedFlowHandlerClausesLowered(
    IrSemanticHandlerClauseList,
    CheckedStraightFlowState
  ),
  CheckedFlowHandlerClausesTerminated(CheckedStraightFlowState),
  CheckedFlowHandlerClausesRejected(CheckedStraightLowerIssue)
}

type CheckedFlowHandlerClauseResult {
  CheckedFlowHandlerClauseLowered(
    IrSemanticHandlerClause,
    CheckedStraightFlowState
  ),
  CheckedFlowHandlerClauseTerminated(CheckedStraightFlowState),
  CheckedFlowHandlerClauseRejected(CheckedStraightLowerIssue)
}

type CheckedFlowHandlerReturnResult {
  CheckedFlowHandlerReturnLowered(IrSemanticHandleReturn),
  CheckedFlowHandlerReturnRejected(CheckedStraightLowerIssue)
}

type CheckedFlowConstructorShape {
  CheckedFlowOpaqueConstructor,
  CheckedFlowVariantConstructor(usize, usize, usize),
  CheckedFlowConstructorShapeUnavailable
}

type CheckedStraightParametersResult {
  CheckedStraightParametersLowered(CheckedStraightValueEnv, i64),
  CheckedStraightParametersRejected(CheckedStraightLowerIssue)
}

fn checked_flow_usize_to_i64(value: usize) -> i64 {
  __u64_to_i64(__usize_to_u64(value))
}

fn checked_flow_value_lanes_from(
  head: i64,
  offset: usize,
  count: usize
) -> IrValueList {
  if offset >= count { ir_value_list_empty() }
  else {
    ir_value_list_prepend(
      head + checked_flow_usize_to_i64(offset),
      checked_flow_value_lanes_from(head, offset + 1, count)
    )
  }
}

fn checked_flow_value(head: i64, count: usize) -> CheckedFlowValue {
  CheckedFlowValue {
    head: head,
    lanes: checked_flow_value_lanes_from(head, 0, count)
  }
}

fn checked_flow_scalar(value: i64) -> CheckedFlowValue {
  checked_flow_value(value, 1)
}

pub(package) fn checked_straight_kind_supported(kind: CheckedExprKind) -> bool {
  match kind {
    CheckedIntegerKind -> true
    CheckedBooleanKind -> true
    CheckedNilKind -> true
    CheckedStringKind -> true
    CheckedLocalReferenceKind -> true
    CheckedSharedBorrowKind -> true
    CheckedExclusiveBorrowKind -> true
    CheckedDeclarationReferenceKind -> true
    CheckedConstructorCallKind -> true
    CheckedNotKind -> true
    CheckedNegateKind -> true
    CheckedBinaryKind -> true
    CheckedIfKind -> true
    CheckedBlockKind -> true
    CheckedLetKind -> true
    CheckedLetMutKind -> true
    CheckedAssignKind -> true
    CheckedWhileKind -> true
    CheckedLoopKind -> true
    CheckedBreakKind -> true
    CheckedBreakNoValueKind -> true
    CheckedContinueKind -> true
    CheckedReturnKind -> true
    CheckedGenericCallKind -> true
    CheckedDirectCallKind -> true
    CheckedApplyKind -> true
    CheckedMethodCallKind -> true
    CheckedAssociatedCallKind -> true
    CheckedInterpolationConcatKind -> true
    CheckedDeclaredFieldAccessKind -> true
    CheckedStructuralFieldAccessKind -> true
    CheckedIndexedLengthKind -> true
    CheckedIndexedGetKind -> true
    CheckedRecordInitKind -> true
    CheckedArrayLiteralKind -> true
    CheckedExplicitMatchKind -> true
    CheckedPerformKind -> true
    CheckedLambdaKind -> true
    CheckedHandleKind -> true
    CheckedResumeKind -> true
    _ -> false
  }
}

fn checked_straight_env_find(
  env: CheckedStraightValueEnv,
  binding: CheckedBindingId
) -> Option<CheckedStraightBindingHome> {
  match env {
    CheckedStraightValueEnvNil -> None<CheckedStraightBindingHome>()
    CheckedStraightValueEnvResume(remaining) -> checked_straight_env_find(
      remaining,
      binding
    )
    CheckedStraightValueEnvCons(candidate, home, remaining) -> if checked_binding_id_eq(
      candidate,
      binding
    ) {
      Some<CheckedStraightBindingHome>(home)
    } else { checked_straight_env_find(remaining, binding) }
  }
}

fn checked_straight_env_allows_resume(env: CheckedStraightValueEnv) -> bool {
  match env {
    CheckedStraightValueEnvNil -> false
    CheckedStraightValueEnvResume(_) -> true
    CheckedStraightValueEnvCons(_, _, remaining) -> checked_straight_env_allows_resume(
      remaining
    )
  }
}

fn checked_flow_lower_binding_home(
  env: CheckedStraightValueEnv,
  binding: CheckedBindingId,
  state: CheckedStraightFlowState
) -> CheckedFlowValueResult {
  match checked_straight_env_find(env, binding) {
    Some(home) -> match home {
      CheckedStraightValueHome(value) -> CheckedFlowValueLowered(value, state)
      CheckedStraightSlotHome(slot, value_type) -> {
        let catalog = state.catalog
        let substitution = state.substitution
        let result = state.next_value
        let loaded = checked_flow_emit(state, ir_inst_load_i64(result, slot), 1)
        let observed = if checked_straight_mutable_needs_cleanup(
          catalog,
          substitution,
          value_type
        ) {
          checked_flow_emit_semantic_slot_transition(
            loaded,
            slot,
            value_type,
            IrSemanticMutableSlotObserve,
            ir_value_list_prepend(result, ir_value_list_empty())
          )
        } else { loaded }
        CheckedFlowValueLowered(
          checked_flow_scalar(result),
          observed
        )
      }
    }
    None -> CheckedFlowValueRejected(CheckedStraightBindingMissing(binding))
  }
}

fn checked_straight_mutable_binding_issue(
  graph: borrow CheckedExprGraph,
  binding: CheckedBindingId,
  catalog: borrow SemanticTypeCatalog,
  substitution: SemanticTypeSubstitution
) -> Option<CheckedStraightLowerIssue> {
  let ty = graph.binding(binding).value_type
  match semantic_value_word_count_with_substitution(catalog, substitution, ty) {
    None -> Some<CheckedStraightLowerIssue>(CheckedStraightValueShapeUnavailable)
    Some(words) -> if words != 1 {
      Some<CheckedStraightLowerIssue>(CheckedStraightWideValueUnsupported(words))
    } else {
      match semantic_value_lane_release_kind_with_substitution(
        catalog,
        substitution,
        ty,
        0
      ) {
        SemanticNoRelease -> if semantic_field_may_require_release_with_substitution(
          catalog,
          substitution,
          ty
        ) {
          Some<CheckedStraightLowerIssue>(CheckedStraightManagedMutableUnsupported(ty))
        } else { None<CheckedStraightLowerIssue>() }
        _ -> None<CheckedStraightLowerIssue>()
      }
    }
  }
}

fn checked_straight_mutable_needs_cleanup(
  catalog: borrow SemanticTypeCatalog,
  substitution: SemanticTypeSubstitution,
  value_type: SemanticTypeId
) -> bool {
  match semantic_value_lane_release_kind_with_substitution(
    catalog,
    substitution,
    value_type,
    0
  ) {
    SemanticNoRelease -> false
    _ -> true
  }
}

fn checked_flow_value_word_count(
  catalog: borrow SemanticTypeCatalog,
  substitution: SemanticTypeSubstitution,
  value_type: SemanticTypeId
) -> Option<usize> {
  match semantic_value_word_count_with_substitution(catalog, substitution, value_type) {
    Some(words) -> Some<usize>(words)
    None -> match catalog.graph_for(value_type) {
      Some(graph) -> match semantic_type_graph_kind(graph, value_type) {
        SemanticBottomKind -> Some<usize>(0)
        _ -> None<usize>()
      }
      None -> None<usize>()
    }
  }
}

fn checked_straight_binary_operator(operator: CheckedBinaryOperator) -> IrBinaryOp {
  match operator {
    CheckedAdd -> IrAdd
    CheckedSubtract -> IrSub
    CheckedMultiply -> IrMul
    CheckedDivide -> IrDiv
    CheckedEqual -> IrEq
    CheckedNotEqual -> IrNe
    CheckedLessThan -> IrLt
    CheckedGreaterThan -> IrGt
    CheckedLessOrEqual -> IrLe
    CheckedGreaterOrEqual -> IrGe
    CheckedModulo -> IrMod
    CheckedLogicalAnd -> IrAnd
    CheckedLogicalOr -> IrOr
    CheckedBitAnd -> IrBand
    CheckedBitOr -> IrBor
    CheckedBitXor -> IrBxor
    CheckedShiftLeft -> IrBshl
    CheckedShiftRight -> IrBshr
  }
}

fn checked_flow_emit(
  state: CheckedStraightFlowState,
  instruction: IrInst,
  consumed_values: i64
) -> CheckedStraightFlowState {
  CheckedStraightFlowState {
    current_block: state.current_block,
    current_params: state.current_params,
    current_insts: ir_inst_list_append(
      state.current_insts,
      ir_inst_list_prepend(instruction, ir_inst_list_empty())
    ),
    completed_blocks: state.completed_blocks,
    next_block: state.next_block,
    next_value: state.next_value + consumed_values,
    loop_targets: state.loop_targets,
    cleanups: state.cleanups,
    cleanup_depth: state.cleanup_depth,
    function_exit: state.function_exit,
    catalog: state.catalog,
    declarations: state.declarations,
    patterns: state.patterns,
    closures: state.closures,
    effects: state.effects,
    substitution: state.substitution
  }
}

fn checked_flow_with_cleanups(
  state: CheckedStraightFlowState,
  cleanups: CheckedStraightCleanupStack,
  depth: usize
) -> CheckedStraightFlowState {
  CheckedStraightFlowState {
    current_block: state.current_block,
    current_params: state.current_params,
    current_insts: state.current_insts,
    completed_blocks: state.completed_blocks,
    next_block: state.next_block,
    next_value: state.next_value,
    loop_targets: state.loop_targets,
    cleanups: cleanups,
    cleanup_depth: depth,
    function_exit: state.function_exit,
    catalog: state.catalog,
    declarations: state.declarations,
    patterns: state.patterns,
    closures: state.closures,
    effects: state.effects,
    substitution: state.substitution
  }
}

fn checked_flow_with_function_exit(
  state: CheckedStraightFlowState,
  function_exit: bool
) -> CheckedStraightFlowState {
  CheckedStraightFlowState {
    current_block: state.current_block,
    current_params: state.current_params,
    current_insts: state.current_insts,
    completed_blocks: state.completed_blocks,
    next_block: state.next_block,
    next_value: state.next_value,
    loop_targets: state.loop_targets,
    cleanups: state.cleanups,
    cleanup_depth: state.cleanup_depth,
    function_exit: function_exit,
    catalog: state.catalog,
    declarations: state.declarations,
    patterns: state.patterns,
    closures: state.closures,
    effects: state.effects,
    substitution: state.substitution
  }
}

fn checked_flow_emit_semantic_slot_transition(
  state: CheckedStraightFlowState,
  slot: i64,
  value_type: SemanticTypeId,
  action: IrSemanticMutableSlotAction,
  values: IrValueList
) -> CheckedStraightFlowState {
  checked_flow_emit(
    state,
    ir_inst_semantic_mutable_slot_i64(value_type, slot, action, values),
    0
  )
}

fn checked_flow_emit_semantic_slot_release(
  state: CheckedStraightFlowState,
  slot: i64,
  value_type: SemanticTypeId
) -> CheckedStraightFlowState {
  let value = state.next_value
  let loaded = checked_flow_emit(state, ir_inst_load_i64(value, slot), 1)
  checked_flow_emit_semantic_slot_transition(
    loaded,
    slot,
    value_type,
    IrSemanticMutableSlotRelease,
    ir_value_list_prepend(value, ir_value_list_empty())
  )
}

fn checked_flow_emit_cleanups_to_depth(
  state: CheckedStraightFlowState,
  cleanups: CheckedStraightCleanupStack,
  depth: usize,
  target: usize
) -> CheckedStraightFlowState {
  if depth <= target { state }
  else {
    match cleanups {
      CheckedStraightCleanupNil -> state
      CheckedStraightCleanupCons(slot, value_type, remaining) ->
        checked_flow_emit_cleanups_to_depth(
          checked_flow_emit_semantic_slot_release(state, slot, value_type),
          remaining,
          depth - 1,
          target
        )
    }
  }
}

fn checked_flow_cleanup_to_depth(
  state: CheckedStraightFlowState,
  target: usize
) -> CheckedStraightFlowState {
  checked_flow_emit_cleanups_to_depth(
    state,
    state.cleanups,
    state.cleanup_depth,
    target
  )
}

fn checked_flow_close(
  state: CheckedStraightFlowState,
  terminator: IrTerminator
) -> CheckedStraightFlowState {
  CheckedStraightFlowState {
    current_block: 0 - 1,
    current_params: ir_value_list_empty(),
    current_insts: ir_inst_list_empty(),
    completed_blocks: ir_block_list_append(
      state.completed_blocks,
      ir_block_list_prepend(
        ir_block_new_params(
          state.current_block,
          state.current_params,
          state.current_insts,
          terminator
        ),
        ir_block_list_empty()
      )
    ),
    next_block: state.next_block,
    next_value: state.next_value,
    loop_targets: state.loop_targets,
    cleanups: state.cleanups,
    cleanup_depth: state.cleanup_depth,
    function_exit: state.function_exit,
    catalog: state.catalog,
    declarations: state.declarations,
    patterns: state.patterns,
    closures: state.closures,
    effects: state.effects,
    substitution: state.substitution
  }
}

fn checked_flow_open(
  state: CheckedStraightFlowState,
  block: i64,
  parameters: IrValueList
) -> CheckedStraightFlowState {
  CheckedStraightFlowState {
    current_block: block,
    current_params: parameters,
    current_insts: ir_inst_list_empty(),
    completed_blocks: state.completed_blocks,
    next_block: state.next_block,
    next_value: state.next_value,
    loop_targets: state.loop_targets,
    cleanups: state.cleanups,
    cleanup_depth: state.cleanup_depth,
    function_exit: false,
    catalog: state.catalog,
    declarations: state.declarations,
    patterns: state.patterns,
    closures: state.closures,
    effects: state.effects,
    substitution: state.substitution
  }
}

fn checked_flow_with_loop_targets(
  state: CheckedStraightFlowState,
  targets: CheckedStraightLoopTargets
) -> CheckedStraightFlowState {
  CheckedStraightFlowState {
    current_block: state.current_block,
    current_params: state.current_params,
    current_insts: state.current_insts,
    completed_blocks: state.completed_blocks,
    next_block: state.next_block,
    next_value: state.next_value,
    loop_targets: targets,
    cleanups: state.cleanups,
    cleanup_depth: state.cleanup_depth,
    function_exit: state.function_exit,
    catalog: state.catalog,
    declarations: state.declarations,
    patterns: state.patterns,
    closures: state.closures,
    effects: state.effects,
    substitution: state.substitution
  }
}

fn checked_flow_reserve(
  state: CheckedStraightFlowState,
  blocks: i64,
  values: i64
) -> CheckedStraightFlowState {
  CheckedStraightFlowState {
    current_block: state.current_block,
    current_params: state.current_params,
    current_insts: state.current_insts,
    completed_blocks: state.completed_blocks,
    next_block: state.next_block + blocks,
    next_value: state.next_value + values,
    loop_targets: state.loop_targets,
    cleanups: state.cleanups,
    cleanup_depth: state.cleanup_depth,
    function_exit: state.function_exit,
    catalog: state.catalog,
    declarations: state.declarations,
    patterns: state.patterns,
    closures: state.closures,
    effects: state.effects,
    substitution: state.substitution
  }
}

fn checked_flow_emit_return_lanes_from(
  state: CheckedStraightFlowState,
  lanes: IrValueList,
  lane: i64
) -> CheckedStraightFlowState {
  match lanes {
    IrValueNil -> state
    IrValueCons(value, rest) -> if lane == 0 {
      checked_flow_emit_return_lanes_from(state, rest, 1)
    } else {
      checked_flow_emit_return_lanes_from(
        checked_flow_emit(state, ir_inst_return_lane_i64(lane, value), 0),
        rest,
        lane + 1
      )
    }
  }
}

fn checked_flow_return(
  state: CheckedStraightFlowState,
  value: CheckedFlowValue
) -> CheckedStraightFlowState {
  checked_flow_with_function_exit(
    checked_flow_close(
      checked_flow_emit_return_lanes_from(state, value.lanes, 0),
      ir_term_return(value.head)
    ),
    true
  )
}

fn checked_flow_emit_call_result_lanes(
  state: CheckedStraightFlowState,
  head: i64,
  lane: usize,
  words: usize
) -> CheckedStraightFlowState {
  if lane >= words { state }
  else {
    checked_flow_emit_call_result_lanes(
      checked_flow_emit(
        state,
        ir_inst_call_result_lane_i64(
          head + checked_flow_usize_to_i64(lane),
          checked_flow_usize_to_i64(lane)
        ),
        1
      ),
      head,
      lane + 1,
      words
    )
  }
}

fn checked_flow_emit_call_value(
  graph: borrow CheckedExprGraph,
  expression: CheckedExprId,
  state: CheckedStraightFlowState,
  instruction: IrInst
) -> CheckedFlowValueResult {
  let catalog = state.catalog
  match checked_flow_value_word_count(
    catalog,
    state.substitution,
    graph.result_type(expression)
  ) {
    None -> CheckedFlowValueRejected(CheckedStraightValueShapeUnavailable)
    Some(0) -> CheckedFlowValueTerminated(
      checked_flow_with_function_exit(
        checked_flow_close(
          checked_flow_emit(state, instruction, 1),
          ir_term_unreachable()
        ),
        true
      )
    )
    Some(words) -> {
      let result = state.next_value
      CheckedFlowValueLowered(
        checked_flow_value(result, words),
        checked_flow_emit_call_result_lanes(
          checked_flow_emit(state, instruction, 1),
          result,
          1,
          words
        )
      )
    }
  }
}

fn checked_flow_emit_semantic_result_lanes(
  state: CheckedStraightFlowState,
  head: i64,
  lane: usize,
  words: usize
) -> CheckedStraightFlowState {
  if lane >= words { state }
  else {
    checked_flow_emit_semantic_result_lanes(
      checked_flow_emit(
        state,
        ir_inst_semantic_result_lane_i64(
          head + checked_flow_usize_to_i64(lane),
          head,
          checked_flow_usize_to_i64(lane)
        ),
        1
      ),
      head,
      lane + 1,
      words
    )
  }
}

fn checked_flow_emit_semantic_data_value(
  graph: borrow CheckedExprGraph,
  expression: CheckedExprId,
  state: CheckedStraightFlowState,
  operation: IrSemanticDataOp,
  arguments: IrValueList
) -> CheckedFlowValueResult {
  checked_flow_emit_semantic_data_type_value(
    graph.result_type(expression),
    state,
    operation,
    arguments
  )
}

fn checked_flow_emit_semantic_data_type_value(
  result_type: SemanticTypeId,
  state: CheckedStraightFlowState,
  operation: IrSemanticDataOp,
  arguments: IrValueList
) -> CheckedFlowValueResult {
  let catalog = state.catalog
  match checked_flow_value_word_count(catalog, state.substitution, result_type) {
    None -> CheckedFlowValueRejected(CheckedStraightValueShapeUnavailable)
    Some(0) -> CheckedFlowValueTerminated(
      checked_flow_with_function_exit(
        checked_flow_close(
          checked_flow_emit(
            state,
            ir_inst_semantic_data_i64(state.next_value, operation, result_type, arguments),
            1
          ),
          ir_term_unreachable()
        ),
        true
      )
    )
    Some(words) -> {
      let result = state.next_value
      CheckedFlowValueLowered(
        checked_flow_value(result, words),
        checked_flow_emit_semantic_result_lanes(
          checked_flow_emit(
            state,
            ir_inst_semantic_data_i64(result, operation, result_type, arguments),
            1
          ),
          result,
          1,
          words
        )
      )
    }
  }
}

fn checked_semantic_record_construction(
  construction: CheckedRecordConstruction
) -> IrSemanticRecordConstruction {
  match construction {
    CheckedDeclaredRecordConstruction(declaration) -> IrSemanticDeclaredRecord(declaration)
    CheckedStructuralRecordConstruction -> IrSemanticStructuralRecord
    CheckedTupleRecordConstruction -> IrSemanticTupleRecord
  }
}

fn checked_semantic_record_field_kind(
  kind: CheckedRecordFieldKind
) -> IrSemanticRecordFieldKind {
  match kind {
    CheckedDeclaredRecordField -> IrSemanticDeclaredRecordField
    CheckedStructuralRecordField -> IrSemanticStructuralRecordField
    CheckedPositionalRecordField -> IrSemanticPositionalRecordField
  }
}

fn checked_semantic_record_field_position(
  position: CheckedRecordFieldPosition
) -> IrSemanticRecordFieldPosition {
  match position {
    CheckedRecordFieldOrdinal(ordinal) -> IrSemanticRecordFieldOrdinal(ordinal)
    CheckedRecordFieldWordOffset(offset) -> IrSemanticRecordFieldWordOffset(offset)
  }
}

fn checked_semantic_structural_field_position(
  position: CheckedStructuralFieldPosition
) -> IrSemanticStructuralFieldPosition {
  match position {
    CheckedStructuralFieldWordOffset(offset) -> IrSemanticStructuralFieldWordOffset(offset)
    CheckedStructuralFieldUnplaced(name) -> IrSemanticStructuralFieldUnplaced(name)
  }
}

fn checked_semantic_record_field(field: CheckedRecordField) -> IrSemanticRecordField {
  IrSemanticRecordField {
    kind: checked_semantic_record_field_kind(field.kind),
    declaration: field.declaration,
    stable_key: field.stable_key,
    position: checked_semantic_record_field_position(field.position),
    value_type: field.value_type
  }
}

fn checked_semantic_record_fields_from(
  graph: borrow CheckedExprGraph,
  fields: CheckedRecordFieldListId,
  position: usize
) -> IrSemanticRecordFieldList {
  if position >= graph.record_field_list_len(fields) { IrSemanticRecordFieldNil }
  else {
    IrSemanticRecordFieldCons(
      checked_semantic_record_field(graph.record_field_list_at(fields, position)),
      checked_semantic_record_fields_from(graph, fields, position + 1)
    )
  }
}

fn checked_flow_lower_arguments_from(
  graph: borrow CheckedExprGraph,
  symbols: borrow CheckedNativeFunctionSymbols,
  arguments: CheckedExprListId,
  position: usize,
  state: CheckedStraightFlowState,
  env: CheckedStraightValueEnv
) -> CheckedFlowArgumentsResult {
  if position >= graph.expression_list_len(arguments) {
    CheckedFlowArgumentsLowered(ir_value_list_empty(), state)
  } else {
    match checked_flow_lower_expression(
      graph,
      symbols,
      graph.expression_list_at(arguments, position),
      state,
      env
    ) {
      CheckedFlowValueRejected(issue) -> CheckedFlowArgumentsRejected(issue)
      CheckedFlowValueTerminated(after_value) -> CheckedFlowArgumentsTerminated(after_value)
      CheckedFlowValueLowered(value, after_value) ->
        match checked_flow_lower_arguments_from(
          graph,
          symbols,
          arguments,
          position + 1,
          after_value,
          env
        ) {
          CheckedFlowArgumentsRejected(issue) -> CheckedFlowArgumentsRejected(issue)
          CheckedFlowArgumentsTerminated(after_arguments) ->
            CheckedFlowArgumentsTerminated(after_arguments)
          CheckedFlowArgumentsLowered(values, after_arguments) ->
            CheckedFlowArgumentsLowered(
              ir_value_list_append(value.lanes, values),
              after_arguments
            )
        }
    }
  }
}

fn checked_flow_lower_record_fields_from(
  graph: borrow CheckedExprGraph,
  symbols: borrow CheckedNativeFunctionSymbols,
  fields: CheckedRecordFieldListId,
  position: usize,
  state: CheckedStraightFlowState,
  env: CheckedStraightValueEnv
) -> CheckedFlowArgumentsResult {
  if position >= graph.record_field_list_len(fields) {
    CheckedFlowArgumentsLowered(ir_value_list_empty(), state)
  } else {
    let field = graph.record_field_list_at(fields, position)
    match checked_flow_lower_expression(graph, symbols, field.value, state, env) {
      CheckedFlowValueRejected(issue) -> CheckedFlowArgumentsRejected(issue)
      CheckedFlowValueTerminated(after_value) -> CheckedFlowArgumentsTerminated(after_value)
      CheckedFlowValueLowered(value, after_value) ->
        match checked_flow_lower_record_fields_from(
          graph,
          symbols,
          fields,
          position + 1,
          after_value,
          env
        ) {
          CheckedFlowArgumentsRejected(issue) -> CheckedFlowArgumentsRejected(issue)
          CheckedFlowArgumentsTerminated(after_fields) ->
            CheckedFlowArgumentsTerminated(after_fields)
          CheckedFlowArgumentsLowered(values, after_fields) -> CheckedFlowArgumentsLowered(
            ir_value_list_append(value.lanes, values),
            after_fields
          )
        }
    }
  }
}

fn checked_semantic_type_arguments_from(
  graph: borrow CheckedExprGraph,
  arguments: CheckedTypeListId,
  position: usize
) -> List<SemanticTypeId> {
  if position >= graph.type_list_len(arguments) { Nil<SemanticTypeId>() }
  else {
    let remaining = checked_semantic_type_arguments_from(
      graph,
      arguments,
      position + 1
    )
    remaining.prepend(graph.type_list_at(arguments, position))
  }
}

fn checked_flow_close_value_to_join(
  state: CheckedStraightFlowState,
  join_block: i64,
  value: CheckedFlowValue
) -> CheckedStraightFlowState {
  checked_flow_close(
    state,
    ir_term_jump_args(join_block, value.lanes)
  )
}

fn checked_flow_open_value_join(
  state: CheckedStraightFlowState,
  join_block: i64,
  words: usize
) -> CheckedFlowValueResult {
  let result = state.next_value
  CheckedFlowValueLowered(
    checked_flow_value(result, words),
    checked_flow_open(
      CheckedStraightFlowState {
        current_block: state.current_block,
        current_params: state.current_params,
        current_insts: state.current_insts,
        completed_blocks: state.completed_blocks,
        next_block: state.next_block,
        next_value: result + checked_flow_usize_to_i64(words),
        loop_targets: state.loop_targets,
        cleanups: state.cleanups,
        cleanup_depth: state.cleanup_depth,
        function_exit: state.function_exit,
        catalog: state.catalog,
        declarations: state.declarations,
        patterns: state.patterns,
        closures: state.closures,
        effects: state.effects,
        substitution: state.substitution
      },
      join_block,
      checked_flow_value_lanes_from(result, 0, words)
    )
  )
}

fn checked_flow_lower_if_else_after_terminated_then(
  graph: borrow CheckedExprGraph,
  symbols: borrow CheckedNativeFunctionSymbols,
  expression: CheckedExprId,
  state: CheckedStraightFlowState,
  env: CheckedStraightValueEnv,
  else_block: i64,
  join_block: i64,
  words: usize
) -> CheckedFlowValueResult {
  match checked_flow_lower_expression(
    graph,
    symbols,
    graph.if_else(expression),
    checked_flow_open(state, else_block, ir_value_list_empty()),
    env
  ) {
    CheckedFlowValueRejected(issue) -> CheckedFlowValueRejected(issue)
    CheckedFlowValueTerminated(after_else) -> CheckedFlowValueTerminated(after_else)
    CheckedFlowValueLowered(else_value, after_else) -> checked_flow_open_value_join(
      checked_flow_close_value_to_join(after_else, join_block, else_value),
      join_block,
      words
    )
  }
}

fn checked_flow_lower_if_else_after_value_then(
  graph: borrow CheckedExprGraph,
  symbols: borrow CheckedNativeFunctionSymbols,
  expression: CheckedExprId,
  state: CheckedStraightFlowState,
  env: CheckedStraightValueEnv,
  else_block: i64,
  join_block: i64,
  words: usize
) -> CheckedFlowValueResult {
  match checked_flow_lower_expression(
    graph,
    symbols,
    graph.if_else(expression),
    checked_flow_open(state, else_block, ir_value_list_empty()),
    env
  ) {
    CheckedFlowValueRejected(issue) -> CheckedFlowValueRejected(issue)
    CheckedFlowValueTerminated(after_else) -> checked_flow_open_value_join(
      after_else,
      join_block,
      words
    )
    CheckedFlowValueLowered(else_value, after_else) -> checked_flow_open_value_join(
      checked_flow_close_value_to_join(after_else, join_block, else_value),
      join_block,
      words
    )
  }
}

fn checked_flow_lower_if(
  graph: borrow CheckedExprGraph,
  symbols: borrow CheckedNativeFunctionSymbols,
  expression: CheckedExprId,
  state: CheckedStraightFlowState,
  env: CheckedStraightValueEnv
) -> CheckedFlowValueResult {
  let catalog = state.catalog
  match checked_flow_value_word_count(
    catalog,
    state.substitution,
    graph.result_type(expression)
  ) {
    None -> CheckedFlowValueRejected(CheckedStraightValueShapeUnavailable)
    Some(words) -> {
      match checked_flow_lower_expression(
        graph,
        symbols,
        graph.if_condition(expression),
        state,
        env
      ) {
        CheckedFlowValueRejected(issue) -> CheckedFlowValueRejected(issue)
        CheckedFlowValueTerminated(after_condition) ->
          CheckedFlowValueTerminated(after_condition)
        CheckedFlowValueLowered(condition, after_condition) -> {
          let then_block = after_condition.next_block
          let else_block = then_block + 1
          let join_block = then_block + 2
          let branched = checked_flow_close(
            CheckedStraightFlowState {
              current_block: after_condition.current_block,
              current_params: after_condition.current_params,
              current_insts: after_condition.current_insts,
              completed_blocks: after_condition.completed_blocks,
              next_block: join_block + 1,
              next_value: after_condition.next_value,
              loop_targets: after_condition.loop_targets,
              cleanups: after_condition.cleanups,
              cleanup_depth: after_condition.cleanup_depth,
              function_exit: after_condition.function_exit,
              catalog: after_condition.catalog,
              declarations: after_condition.declarations,
              patterns: after_condition.patterns,
              closures: after_condition.closures,
              effects: after_condition.effects,
              substitution: after_condition.substitution
            },
            ir_term_branch(condition.head, then_block, else_block)
          )
          match checked_flow_lower_expression(
            graph,
            symbols,
            graph.if_then(expression),
            checked_flow_open(branched, then_block, ir_value_list_empty()),
            env
          ) {
            CheckedFlowValueRejected(issue) -> CheckedFlowValueRejected(issue)
            CheckedFlowValueTerminated(after_then) ->
              checked_flow_lower_if_else_after_terminated_then(
                graph,
                symbols,
                expression,
                after_then,
                env,
                else_block,
                join_block,
                words
              )
            CheckedFlowValueLowered(then_value, after_then) ->
              checked_flow_lower_if_else_after_value_then(
                graph,
                symbols,
                expression,
                checked_flow_close_value_to_join(after_then, join_block, then_value),
                env,
                else_block,
                join_block,
                words
              )
          }
        }
      }
    }
  }
}

fn checked_flow_lower_while(
  graph: borrow CheckedExprGraph,
  symbols: borrow CheckedNativeFunctionSymbols,
  expression: CheckedExprId,
  state: CheckedStraightFlowState,
  env: CheckedStraightValueEnv
) -> CheckedFlowValueResult {
  let header_block = state.next_block
  let body_block = header_block + 1
  let exit_block = header_block + 2
  let entered = checked_flow_open(
    checked_flow_close(
      CheckedStraightFlowState {
        current_block: state.current_block,
        current_params: state.current_params,
        current_insts: state.current_insts,
        completed_blocks: state.completed_blocks,
        next_block: exit_block + 1,
        next_value: state.next_value,
        loop_targets: state.loop_targets,
        cleanups: state.cleanups,
        cleanup_depth: state.cleanup_depth,
        function_exit: state.function_exit,
        catalog: state.catalog,
        declarations: state.declarations,
        patterns: state.patterns,
        closures: state.closures,
        effects: state.effects,
        substitution: state.substitution
      },
      ir_term_jump(header_block)
    ),
    header_block,
    ir_value_list_empty()
  )
  match checked_flow_lower_expression(
    graph,
    symbols,
    graph.while_condition(expression),
    entered,
    env
  ) {
    CheckedFlowValueRejected(issue) -> CheckedFlowValueRejected(issue)
    CheckedFlowValueTerminated(after_condition) ->
      CheckedFlowValueTerminated(after_condition)
    CheckedFlowValueLowered(condition, after_condition) -> {
      let outer_targets = after_condition.loop_targets
      let branched = checked_flow_close(
        after_condition,
        ir_term_branch(condition.head, body_block, exit_block)
      )
      match checked_flow_lower_expression(
        graph,
        symbols,
        graph.while_body(expression),
        checked_flow_with_loop_targets(
          checked_flow_open(branched, body_block, ir_value_list_empty()),
          CheckedStraightInsideLoop(
            header_block,
            exit_block,
            0,
            state.cleanup_depth,
            outer_targets
          )
        ),
        env
      ) {
        CheckedFlowValueRejected(issue) -> CheckedFlowValueRejected(issue)
        CheckedFlowValueTerminated(after_body) -> {
          let exited = checked_flow_open(
            checked_flow_with_loop_targets(after_body, outer_targets),
            exit_block,
            ir_value_list_empty()
          )
          let result = exited.next_value
          CheckedFlowValueLowered(
            checked_flow_scalar(result),
            checked_flow_emit(exited, ir_inst_nil_i64(result), 1)
          )
        }
        CheckedFlowValueLowered(_, after_body) -> {
          let repeated = checked_flow_close(after_body, ir_term_jump(header_block))
          let exited = checked_flow_open(
            checked_flow_with_loop_targets(repeated, outer_targets),
            exit_block,
            ir_value_list_empty()
          )
          let result = exited.next_value
          CheckedFlowValueLowered(
            checked_flow_scalar(result),
            checked_flow_emit(exited, ir_inst_nil_i64(result), 1)
          )
        }
      }
    }
  }
}

fn checked_flow_lower_loop_with_value(
  graph: borrow CheckedExprGraph,
  symbols: borrow CheckedNativeFunctionSymbols,
  expression: CheckedExprId,
  state: CheckedStraightFlowState,
  env: CheckedStraightValueEnv,
  words: usize
) -> CheckedFlowValueResult {
  let header_block = state.next_block
  let exit_block = header_block + 1
  let result = state.next_value
  let outer_targets = state.loop_targets
  let entered = checked_flow_with_loop_targets(
    checked_flow_open(
      checked_flow_close(
        CheckedStraightFlowState {
          current_block: state.current_block,
          current_params: state.current_params,
          current_insts: state.current_insts,
          completed_blocks: state.completed_blocks,
          next_block: exit_block + 1,
          next_value: result + checked_flow_usize_to_i64(words),
          loop_targets: outer_targets,
          cleanups: state.cleanups,
          cleanup_depth: state.cleanup_depth,
          function_exit: state.function_exit,
          catalog: state.catalog,
          declarations: state.declarations,
          patterns: state.patterns,
          closures: state.closures,
          effects: state.effects,
          substitution: state.substitution
        },
        ir_term_jump(header_block)
      ),
      header_block,
      ir_value_list_empty()
    ),
    CheckedStraightInsideLoop(
      header_block,
      exit_block,
      checked_flow_usize_to_i64(words),
      state.cleanup_depth,
      outer_targets
    )
  )
  match checked_flow_lower_expression(
    graph,
    symbols,
    graph.loop_body(expression),
    entered,
    env
  ) {
    CheckedFlowValueRejected(issue) -> CheckedFlowValueRejected(issue)
    CheckedFlowValueTerminated(after_body) -> if after_body.function_exit {
      CheckedFlowValueTerminated(
        checked_flow_with_loop_targets(after_body, outer_targets)
      )
    } else {
      CheckedFlowValueLowered(
        checked_flow_value(result, words),
        checked_flow_open(
          checked_flow_with_loop_targets(after_body, outer_targets),
          exit_block,
          checked_flow_value_lanes_from(result, 0, words)
        )
      )
    }
    CheckedFlowValueLowered(_, after_body) -> CheckedFlowValueLowered(
      checked_flow_value(result, words),
      checked_flow_open(
        checked_flow_with_loop_targets(
          checked_flow_close(after_body, ir_term_jump(header_block)),
          outer_targets
        ),
        exit_block,
        checked_flow_value_lanes_from(result, 0, words)
      )
    )
  }
}

fn checked_flow_lower_loop_without_value(
  graph: borrow CheckedExprGraph,
  symbols: borrow CheckedNativeFunctionSymbols,
  expression: CheckedExprId,
  state: CheckedStraightFlowState,
  env: CheckedStraightValueEnv
) -> CheckedFlowValueResult {
  let header_block = state.next_block
  let exit_block = header_block + 1
  let outer_targets = state.loop_targets
  let entered = checked_flow_with_loop_targets(
    checked_flow_open(
      checked_flow_close(
        CheckedStraightFlowState {
          current_block: state.current_block,
          current_params: state.current_params,
          current_insts: state.current_insts,
          completed_blocks: state.completed_blocks,
          next_block: exit_block + 1,
          next_value: state.next_value,
          loop_targets: outer_targets,
          cleanups: state.cleanups,
          cleanup_depth: state.cleanup_depth,
          function_exit: state.function_exit,
          catalog: state.catalog,
          declarations: state.declarations,
          patterns: state.patterns,
          closures: state.closures,
          effects: state.effects,
          substitution: state.substitution
        },
        ir_term_jump(header_block)
      ),
      header_block,
      ir_value_list_empty()
    ),
    CheckedStraightInsideLoop(
      header_block,
      exit_block,
      0,
      state.cleanup_depth,
      outer_targets
    )
  )
  match checked_flow_lower_expression(
    graph,
    symbols,
    graph.loop_body(expression),
    entered,
    env
  ) {
    CheckedFlowValueRejected(issue) -> CheckedFlowValueRejected(issue)
    CheckedFlowValueTerminated(after_body) -> CheckedFlowValueTerminated(
      checked_flow_with_loop_targets(after_body, outer_targets)
    )
    CheckedFlowValueLowered(_, after_body) -> CheckedFlowValueTerminated(
      checked_flow_with_loop_targets(
        checked_flow_close(after_body, ir_term_jump(header_block)),
        outer_targets
      )
    )
  }
}

fn checked_flow_lower_loop(
  graph: borrow CheckedExprGraph,
  symbols: borrow CheckedNativeFunctionSymbols,
  expression: CheckedExprId,
  state: CheckedStraightFlowState,
  env: CheckedStraightValueEnv
) -> CheckedFlowValueResult {
  let catalog = state.catalog
  match checked_flow_value_word_count(
    catalog,
    state.substitution,
    graph.result_type(expression)
  ) {
    None -> CheckedFlowValueRejected(CheckedStraightValueShapeUnavailable)
    Some(0) -> checked_flow_lower_loop_without_value(
      graph,
      symbols,
      expression,
      state,
      env
    )
    Some(words) -> checked_flow_lower_loop_with_value(
      graph,
      symbols,
      expression,
      state,
      env,
      words
    )
  }
}

fn checked_flow_break_to(
  state: CheckedStraightFlowState,
  target: i64,
  argument_count: i64,
  value: CheckedFlowValue
) -> CheckedFlowValueResult {
  let terminator = if argument_count == 0 { ir_term_jump(target) }
  else { ir_term_jump_args(target, value.lanes) }
  CheckedFlowValueTerminated(checked_flow_close(state, terminator))
}

fn checked_flow_lower_break_no_value(
  kind: CheckedExprKind,
  state: CheckedStraightFlowState
) -> CheckedFlowValueResult {
  match state.loop_targets {
    CheckedStraightOutsideLoop -> CheckedFlowValueRejected(
      CheckedStraightControlOutsideLoop(kind)
    )
    CheckedStraightInsideLoop(_, target, argument_count, cleanup_depth, _) ->
      if argument_count == 0 {
        checked_flow_break_to(
          checked_flow_cleanup_to_depth(state, cleanup_depth),
          target,
          0,
          checked_flow_value(0, 0)
        )
      } else {
        let value = state.next_value
        checked_flow_break_to(
          checked_flow_cleanup_to_depth(
            checked_flow_emit(state, ir_inst_nil_i64(value), 1),
            cleanup_depth
          ),
          target,
          argument_count,
          checked_flow_scalar(value)
        )
      }
  }
}

fn checked_flow_pattern_constant(
  state: CheckedStraightFlowState,
  value: i64
) -> (i64, CheckedStraightFlowState) {
  let result = state.next_value
  (
    result,
    checked_flow_emit(state, ir_inst_const_i64(result, value), 1)
  )
}

fn checked_flow_pattern_equal(
  state: CheckedStraightFlowState,
  scrutinee: i64,
  expected: i64
) -> (i64, CheckedStraightFlowState) {
  let comparison = state.next_value
  (
    comparison,
    checked_flow_emit(
      state,
      ir_inst_binary_i64(comparison, IrEq, scrutinee, expected),
      1
    )
  )
}

fn checked_flow_pattern_branch(
  condition: i64,
  state: CheckedStraightFlowState,
  failure_block: i64
) -> CheckedStraightFlowState {
  let success_block = state.next_block
  checked_flow_open(
    checked_flow_close(
      checked_flow_reserve(state, 1, 0),
      ir_term_branch(condition, success_block, failure_block)
    ),
    success_block,
    ir_value_list_empty()
  )
}

fn checked_flow_pattern_shape_from(
  catalog: borrow SemanticTypeCatalog,
  substitution: borrow SemanticTypeSubstitution,
  value_type: SemanticTypeId,
  remaining: usize
) -> SemanticTypeId {
  if remaining == 0 { value_type }
  else {
    match catalog.graph_for(value_type) {
      None -> value_type
      Some(graph) -> match semantic_type_graph_node(graph, value_type) {
        SemanticVariableNode(variable) -> match semantic_type_substitution_get(
          substitution,
          variable
        ) {
          Some(resolved) -> if semantic_type_id_eq(resolved, value_type) {
            value_type
          } else {
            checked_flow_pattern_shape_from(
              catalog,
              substitution,
              resolved,
              remaining - 1
            )
          }
          None -> value_type
        }
        SemanticOwnedNode(inner) -> checked_flow_pattern_shape_from(
          catalog,
          substitution,
          inner,
          remaining - 1
        )
        SemanticUniqueNode(inner) -> checked_flow_pattern_shape_from(
          catalog,
          substitution,
          inner,
          remaining - 1
        )
        SemanticBorrowNode(inner, _) -> checked_flow_pattern_shape_from(
          catalog,
          substitution,
          inner,
          remaining - 1
        )
        _ -> value_type
      }
    }
  }
}

fn checked_flow_pattern_shape(
  catalog: borrow SemanticTypeCatalog,
  substitution: borrow SemanticTypeSubstitution,
  value_type: SemanticTypeId
) -> SemanticTypeId {
  checked_flow_pattern_shape_from(
    catalog,
    substitution,
    value_type,
    semantic_type_substitution_len(substitution) + 4
  )
}

fn checked_flow_variant_case(
  declarations: borrow SemanticTypeDeclarationCatalog,
  layout: usize,
  wanted: DeclarationIdentity,
  position: usize,
  count: usize
) -> Option<(usize, usize)> {
  if position >= count { None<(usize, usize)>() }
  else {
    match semantic_type_declared_variant_case_declaration(
      declarations,
      layout,
      position
    ) {
      Some(candidate) -> if declaration_identity_eq(candidate, wanted) {
        match semantic_type_declared_variant_payload_count(
          declarations,
          layout,
          position
        ) {
          Some(payloads) -> Some((position, payloads))
          None -> None<(usize, usize)>()
        }
      } else {
        checked_flow_variant_case(
          declarations,
          layout,
          wanted,
          position + 1,
          count
        )
      }
      None -> None<(usize, usize)>()
    }
  }
}

fn checked_flow_constructor_shape(
  declaration: DeclarationIdentity,
  input_type: SemanticTypeId,
  state: borrow CheckedStraightFlowState
) -> CheckedFlowConstructorShape {
  let catalog = state.catalog
  let substitution = state.substitution
  let declarations = state.declarations
  let shape = checked_flow_pattern_shape(
    catalog,
    substitution,
    input_type
  )
  match catalog.graph_for(shape) {
    Some(graph) -> match semantic_type_graph_node(graph, shape) {
      SemanticNamedNode(found, SemanticOpaqueType, _, _) -> if declaration_identity_eq(
        found,
        declaration
      ) { return CheckedFlowOpaqueConstructor }
      else { nil }
      _ -> nil
    }
    None -> nil
  }
  match semantic_type_declaration_catalog_resolve(
    catalog,
    declarations,
    shape,
    substitution
  ) {
    SemanticVariantDeclarationLayoutMatched(layout, _) ->
      match semantic_type_declared_variant_case_count(declarations, layout) {
        Some(count) -> match checked_flow_variant_case(
          declarations,
          layout,
          declaration,
          0,
          count
        ) {
          Some((position, payloads)) -> CheckedFlowVariantConstructor(
            layout,
            position,
            payloads
          )
          None -> CheckedFlowConstructorShapeUnavailable
        }
        None -> CheckedFlowConstructorShapeUnavailable
      }
    SemanticRecordDeclarationLayoutMatched(_, _) ->
      CheckedFlowConstructorShapeUnavailable
    SemanticTypeDeclarationLayoutMissing -> CheckedFlowConstructorShapeUnavailable
  }
}

fn checked_flow_constructor_tag(
  declaration: DeclarationIdentity
) -> Option<i64> {
  match declaration_identity_name(declaration).text() {
    Some(name) -> Some(name.hash())
    None -> None<i64>()
  }
}

fn checked_flow_emit_variant_payload_from(
  state: CheckedStraightFlowState,
  base: i64,
  word_offset: usize,
  lane: usize,
  words: usize,
  head: i64
) -> CheckedStraightFlowState {
  if lane >= words { state }
  else {
    checked_flow_emit_variant_payload_from(
      checked_flow_emit(
        state,
        ir_inst_variant_payload_i64(
          head + checked_flow_usize_to_i64(lane),
          base,
          checked_flow_usize_to_i64(word_offset + lane)
        ),
        1
      ),
      base,
      word_offset,
      lane + 1,
      words,
      head
    )
  }
}

fn checked_flow_emit_variant_payload(
  state: CheckedStraightFlowState,
  base: i64,
  word_offset: usize,
  words: usize
) -> (CheckedFlowValue, CheckedStraightFlowState) {
  let head = state.next_value
  (
    checked_flow_value(head, words),
    checked_flow_emit_variant_payload_from(
      state,
      base,
      word_offset,
      0,
      words,
      head
    )
  )
}

fn checked_flow_value_drop_lanes(
  lanes: IrValueList,
  count: usize
) -> IrValueList {
  if count == 0 { lanes }
  else {
    match lanes {
      IrValueNil -> IrValueNil
      IrValueCons(_, remaining) -> checked_flow_value_drop_lanes(remaining, count - 1)
    }
  }
}

fn checked_flow_value_take_lanes(
  lanes: IrValueList,
  count: usize
) -> IrValueList {
  if count == 0 { ir_value_list_empty() }
  else {
    match lanes {
      IrValueNil -> IrValueNil
      IrValueCons(value, remaining) -> ir_value_list_prepend(
        value,
        checked_flow_value_take_lanes(remaining, count - 1)
      )
    }
  }
}

fn checked_flow_value_slice(
  value: CheckedFlowValue,
  offset: usize,
  words: usize
) -> Option<CheckedFlowValue> {
  let selected = checked_flow_value_take_lanes(
    checked_flow_value_drop_lanes(value.lanes, offset),
    words
  )
  if ir_value_list_len(selected) != checked_flow_usize_to_i64(words) {
    None<CheckedFlowValue>()
  }
  else {
    match selected {
      IrValueNil -> None<CheckedFlowValue>()
      IrValueCons(head, _) -> Some(
        CheckedFlowValue { head: head, lanes: selected }
      )
    }
  }
}

fn checked_flow_lower_pattern_list(
  patterns: borrow CheckedPatternGraph,
  items: CheckedPatternListId,
  position: usize,
  value: CheckedFlowValue,
  word_offset: usize,
  variant_payload: bool,
  state: CheckedStraightFlowState,
  env: CheckedStraightValueEnv,
  failure_block: i64
) -> CheckedFlowPatternResult {
  if position >= patterns.pattern_list_len(items) {
    CheckedFlowPatternMatched(state, env)
  } else {
    let child = patterns.pattern_list_at(items, position)
    let catalog = state.catalog
    let substitution = state.substitution
    match checked_flow_value_word_count(
      catalog,
      substitution,
      patterns.input_type(child)
    ) {
      None -> CheckedFlowPatternRejected(CheckedStraightValueShapeUnavailable)
      Some(0) -> CheckedFlowPatternRejected(CheckedStraightWideValueUnsupported(0))
      Some(words) -> {
        let selected = if variant_payload {
          match checked_flow_emit_variant_payload(
            state,
            value.head,
            word_offset,
            words
          ) {
            (child_value, after_load) -> Some((child_value, after_load))
          }
        } else {
          match checked_flow_value_slice(value, word_offset, words) {
            Some(child_value) -> Some((child_value, state))
            None -> None<(CheckedFlowValue, CheckedStraightFlowState)>()
          }
        }
        match selected {
          None -> CheckedFlowPatternRejected(CheckedStraightValueShapeUnavailable)
          Some((child_value, after_load)) -> match checked_flow_lower_pattern(
            child,
            child_value,
            after_load,
            env,
            failure_block
          ) {
            CheckedFlowPatternRejected(issue) -> CheckedFlowPatternRejected(issue)
            CheckedFlowPatternMatched(after_child, child_env) ->
              checked_flow_lower_pattern_list(
                patterns,
                items,
                position + 1,
                value,
                word_offset + words,
                variant_payload,
                after_child,
                child_env,
                failure_block
              )
          }
        }
      }
    }
  }
}

fn checked_flow_lower_pattern_fields(
  patterns: borrow CheckedPatternGraph,
  fields: CheckedPatternFieldListId,
  position: usize,
  value: CheckedFlowValue,
  state: CheckedStraightFlowState,
  env: CheckedStraightValueEnv,
  failure_block: i64
) -> CheckedFlowPatternResult {
  if position >= patterns.pattern_field_list_len(fields) {
    CheckedFlowPatternMatched(state, env)
  } else {
    let field = patterns.pattern_field_list_at(fields, position)
    let selected = match field.kind {
      CheckedDeclaredPatternField -> match field.declaration {
        declaration: DeclarationIdentity -> match field.position {
          CheckedPatternFieldOrdinal(ordinal) ->
            checked_flow_emit_semantic_data_type_value(
              field.value_type,
              state,
              IrSemanticDeclaredFieldAccess(declaration, ordinal),
              value.lanes
            )
          _ -> CheckedFlowValueRejected(CheckedStraightValueShapeUnavailable)
        }
        nil -> CheckedFlowValueRejected(CheckedStraightValueShapeUnavailable)
      }
      CheckedStructuralPatternField -> match field.position {
        CheckedPatternFieldWordOffset(offset) -> {
          let catalog = state.catalog
          let substitution = state.substitution
          match checked_flow_value_word_count(
            catalog,
            substitution,
            field.value_type
          ) {
            None -> CheckedFlowValueRejected(CheckedStraightValueShapeUnavailable)
            Some(0) -> CheckedFlowValueRejected(CheckedStraightWideValueUnsupported(0))
            Some(words) -> match checked_flow_value_slice(value, offset, words) {
              Some(child) -> CheckedFlowValueLowered(child, state)
              None -> CheckedFlowValueRejected(CheckedStraightValueShapeUnavailable)
            }
          }
        }
        CheckedPatternFieldUnplaced(_) -> CheckedFlowValueRejected(
          CheckedStraightValueShapeUnavailable
        )
        CheckedPatternFieldOrdinal(_) -> CheckedFlowValueRejected(
          CheckedStraightValueShapeUnavailable
        )
      }
    }
    match selected {
      CheckedFlowValueRejected(issue) -> CheckedFlowPatternRejected(issue)
      CheckedFlowValueTerminated(_) -> CheckedFlowPatternRejected(
        CheckedStraightValueShapeUnavailable
      )
      CheckedFlowValueLowered(child, after_field) -> match checked_flow_lower_pattern(
        field.pattern,
        child,
        after_field,
        env,
        failure_block
      ) {
        CheckedFlowPatternRejected(issue) -> CheckedFlowPatternRejected(issue)
        CheckedFlowPatternMatched(after_child, child_env) ->
          checked_flow_lower_pattern_fields(
            patterns,
            fields,
            position + 1,
            value,
            after_child,
            child_env,
            failure_block
          )
      }
    }
  }
}

fn checked_flow_lower_pattern(
  pattern: CheckedPatternId,
  value: CheckedFlowValue,
  state: CheckedStraightFlowState,
  env: CheckedStraightValueEnv,
  failure_block: i64
) -> CheckedFlowPatternResult {
  let patterns = state.patterns
  match patterns.kind(pattern) {
    CheckedWildcardPatternKind -> CheckedFlowPatternMatched(state, env)
    CheckedBindingPatternKind -> CheckedFlowPatternMatched(
      state,
      CheckedStraightValueEnvCons(
        patterns.binding(pattern),
        CheckedStraightValueHome(value),
        env
      )
    )
    CheckedTypedBindingPatternKind -> match patterns.typed_binding_parts(pattern) {
      (binding, _) -> CheckedFlowPatternMatched(
        state,
        CheckedStraightValueEnvCons(
          binding,
          CheckedStraightValueHome(value),
          env
        )
      )
    }
    CheckedIntegerPatternKind -> match patterns.integer_parts(pattern) {
      (expected, _) -> match checked_flow_pattern_constant(state, expected) {
        (constant, after_constant) -> match checked_flow_pattern_equal(
          after_constant,
          value.head,
          constant
        ) {
          (condition, after) -> CheckedFlowPatternMatched(
            checked_flow_pattern_branch(condition, after, failure_block),
            env
          )
        }
      }
    }
    CheckedNilPatternKind -> {
      let expected = state.next_value
      let after_nil = checked_flow_emit(state, ir_inst_nil_i64(expected), 1)
      match checked_flow_pattern_equal(after_nil, value.head, expected) {
        (condition, after) -> CheckedFlowPatternMatched(
          checked_flow_pattern_branch(condition, after, failure_block),
          env
        )
      }
    }
    CheckedConstructorPatternKind -> match patterns.constructor_parts(pattern) {
      (declaration, children, _) -> match checked_flow_constructor_shape(
        declaration,
        patterns.input_type(pattern),
        state
      ) {
        CheckedFlowConstructorShapeUnavailable -> CheckedFlowPatternRejected(
          CheckedStraightValueShapeUnavailable
        )
        CheckedFlowOpaqueConstructor -> checked_flow_lower_pattern_list(
          patterns,
          children,
          0,
          value,
          0,
          false,
          state,
          env,
          failure_block
        )
        CheckedFlowVariantConstructor(_, _, payloads) -> {
          if patterns.pattern_list_len(children) != payloads {
            CheckedFlowPatternRejected(CheckedStraightValueShapeUnavailable)
          } else {
            match checked_flow_constructor_tag(declaration) {
              None -> CheckedFlowPatternRejected(CheckedStraightValueShapeUnavailable)
              Some(expected_tag) -> {
                let tag = state.next_value
                let after_tag = checked_flow_emit(
                  state,
                  ir_inst_variant_tag_i64(tag, value.head),
                  1
                )
                match checked_flow_pattern_constant(after_tag, expected_tag) {
                  (expected, after_expected) -> match checked_flow_pattern_equal(
                    after_expected,
                    tag,
                    expected
                  ) {
                    (condition, after_test) -> checked_flow_lower_pattern_list(
                      patterns,
                      children,
                      0,
                      value,
                      0,
                      true,
                      checked_flow_pattern_branch(
                        condition,
                        after_test,
                        failure_block
                      ),
                      env,
                      failure_block
                    )
                  }
                }
              }
            }
          }
        }
      }
    }
    CheckedTuplePatternKind -> checked_flow_lower_pattern_list(
      patterns,
      patterns.tuple_items(pattern),
      0,
      value,
      0,
      false,
      state,
      env,
      failure_block
    )
    CheckedRecordPatternKind -> checked_flow_lower_pattern_fields(
      patterns,
      patterns.record_fields(pattern),
      0,
      value,
      state,
      env,
      failure_block
    )
    unsupported -> CheckedFlowPatternRejected(
      CheckedStraightUnsupportedPattern(unsupported)
    )
  }
}

fn checked_flow_match_continue(
  graph: borrow CheckedExprGraph,
  symbols: borrow CheckedNativeFunctionSymbols,
  arms: CheckedMatchArmListId,
  position: usize,
  scrutinee: CheckedFlowValue,
  state: CheckedStraightFlowState,
  env: CheckedStraightValueEnv,
  join_block: i64,
  result_head: i64,
  result_words: usize,
  reached_join: bool
) -> CheckedFlowValueResult {
  let patterns = state.patterns
  if position >= patterns.match_arm_list_len(arms) {
    let exhausted = checked_flow_with_function_exit(
      checked_flow_close(state, ir_term_unreachable()),
      true
    )
    if reached_join {
      CheckedFlowValueLowered(
        checked_flow_value(result_head, result_words),
        checked_flow_open(
          exhausted,
          join_block,
          checked_flow_value_lanes_from(result_head, 0, result_words)
        )
      )
    } else { CheckedFlowValueTerminated(exhausted) }
  } else {
    let arm = patterns.match_arm_list_at(arms, position)
    let next_arm_block = state.next_block
    match checked_flow_lower_pattern(
      arm.pattern,
      scrutinee,
      checked_flow_reserve(state, 1, 0),
      env,
      next_arm_block
    ) {
      CheckedFlowPatternRejected(issue) -> CheckedFlowValueRejected(issue)
      CheckedFlowPatternMatched(after_pattern, arm_env) -> checked_flow_match_guard(
        graph,
        symbols,
        arms,
        position,
        scrutinee,
        after_pattern,
        arm_env,
        env,
        next_arm_block,
        join_block,
        result_head,
        result_words,
        reached_join
      )
    }
  }
}

fn checked_flow_match_after_body(
  graph: borrow CheckedExprGraph,
  symbols: borrow CheckedNativeFunctionSymbols,
  arms: CheckedMatchArmListId,
  position: usize,
  scrutinee: CheckedFlowValue,
  body: CheckedFlowValueResult,
  outer_env: CheckedStraightValueEnv,
  next_arm_block: i64,
  join_block: i64,
  result_head: i64,
  result_words: usize,
  reached_join: bool
) -> CheckedFlowValueResult {
  match body {
    CheckedFlowValueRejected(issue) -> CheckedFlowValueRejected(issue)
    CheckedFlowValueTerminated(after_body) -> checked_flow_match_continue(
      graph,
      symbols,
      arms,
      position + 1,
      scrutinee,
      checked_flow_open(after_body, next_arm_block, ir_value_list_empty()),
      outer_env,
      join_block,
      result_head,
      result_words,
      reached_join
    )
    CheckedFlowValueLowered(value, after_body) -> checked_flow_match_continue(
      graph,
      symbols,
      arms,
      position + 1,
      scrutinee,
      checked_flow_open(
        checked_flow_close_value_to_join(after_body, join_block, value),
        next_arm_block,
        ir_value_list_empty()
      ),
      outer_env,
      join_block,
      result_head,
      result_words,
      true
    )
  }
}

fn checked_flow_match_guard(
  graph: borrow CheckedExprGraph,
  symbols: borrow CheckedNativeFunctionSymbols,
  arms: CheckedMatchArmListId,
  position: usize,
  scrutinee: CheckedFlowValue,
  state: CheckedStraightFlowState,
  arm_env: CheckedStraightValueEnv,
  outer_env: CheckedStraightValueEnv,
  next_arm_block: i64,
  join_block: i64,
  result_head: i64,
  result_words: usize,
  reached_join: bool
) -> CheckedFlowValueResult {
  let patterns = state.patterns
  let arm = patterns.match_arm_list_at(arms, position)
  match arm.guard {
    CheckedUnguarded -> checked_flow_match_after_body(
      graph,
      symbols,
      arms,
      position,
      scrutinee,
      checked_flow_lower_expression(graph, symbols, arm.body, state, arm_env),
      outer_env,
      next_arm_block,
      join_block,
      result_head,
      result_words,
      reached_join
    )
    CheckedGuarded(guard) -> match checked_flow_lower_expression(
      graph,
      symbols,
      guard,
      state,
      arm_env
    ) {
      CheckedFlowValueRejected(issue) -> CheckedFlowValueRejected(issue)
      CheckedFlowValueTerminated(after_guard) -> checked_flow_match_continue(
        graph,
        symbols,
        arms,
        position + 1,
        scrutinee,
        checked_flow_open(after_guard, next_arm_block, ir_value_list_empty()),
        outer_env,
        join_block,
        result_head,
        result_words,
        reached_join
      )
      CheckedFlowValueLowered(guard_value, after_guard) -> {
        let body_block = after_guard.next_block
        let guarded = checked_flow_close(
          checked_flow_reserve(after_guard, 1, 0),
          ir_term_branch(guard_value.head, body_block, next_arm_block)
        )
        checked_flow_match_after_body(
          graph,
          symbols,
          arms,
          position,
          scrutinee,
          checked_flow_lower_expression(
            graph,
            symbols,
            arm.body,
            checked_flow_open(guarded, body_block, ir_value_list_empty()),
            arm_env
          ),
          outer_env,
          next_arm_block,
          join_block,
          result_head,
          result_words,
          reached_join
        )
      }
    }
  }
}

fn checked_flow_lower_match(
  graph: borrow CheckedExprGraph,
  symbols: borrow CheckedNativeFunctionSymbols,
  expression: CheckedExprId,
  state: CheckedStraightFlowState,
  env: CheckedStraightValueEnv
) -> CheckedFlowValueResult {
  match graph.match_parts(expression) {
    (_, scrutinee_expression, arms) -> match checked_flow_lower_expression(
      graph,
      symbols,
      scrutinee_expression,
      state,
      env
    ) {
      CheckedFlowValueRejected(issue) -> CheckedFlowValueRejected(issue)
      CheckedFlowValueTerminated(after_scrutinee) ->
        CheckedFlowValueTerminated(after_scrutinee)
      CheckedFlowValueLowered(scrutinee, after_scrutinee) -> {
        let catalog = after_scrutinee.catalog
        match checked_flow_value_word_count(
          catalog,
          after_scrutinee.substitution,
          graph.result_type(expression)
        ) {
          None -> CheckedFlowValueRejected(CheckedStraightValueShapeUnavailable)
          Some(words) -> {
            let join_block = after_scrutinee.next_block
            let result_head = after_scrutinee.next_value
            checked_flow_match_continue(
              graph,
              symbols,
              arms,
              0,
              scrutinee,
              checked_flow_reserve(
                after_scrutinee,
                1,
                checked_flow_usize_to_i64(words)
              ),
              env,
              join_block,
              result_head,
              words,
              false
            )
          }
        }
      }
    }
  }
}

fn checked_flow_lambda_role(role: CheckedLambdaRole) -> IrSemanticClosureRole {
  match role {
    CheckedOrdinaryLambda -> IrSemanticOrdinaryClosure
    CheckedParallelScopeLambda -> IrSemanticParallelScopeClosure
    CheckedParallelWorkerLambda -> IrSemanticParallelWorkerClosure
    CheckedTaskWorkerLambda -> IrSemanticTaskWorkerClosure
  }
}

fn checked_flow_lower_captures_from(
  graph: borrow CheckedExprGraph,
  closures: borrow CheckedClosureGraph,
  captures: CheckedBindingListId,
  position: usize,
  state: CheckedStraightFlowState,
  env: CheckedStraightValueEnv
) -> CheckedFlowCapturesResult {
  if position >= closures.binding_list_len(captures) {
    CheckedFlowCapturesLowered(
      ir_value_list_empty(),
      IrSemanticCaptureNil,
      0,
      state
    )
  } else {
    let binding = closures.binding_list_at(captures, position)
    let value_type = graph.binding(binding).value_type
    match checked_flow_lower_binding_home(env, binding, state) {
      CheckedFlowValueRejected(issue) -> CheckedFlowCapturesRejected(issue)
      CheckedFlowValueTerminated(after_capture) ->
        CheckedFlowCapturesTerminated(after_capture)
      CheckedFlowValueLowered(value, after_capture) -> {
        let catalog = after_capture.catalog
        match checked_flow_value_word_count(
          catalog,
          after_capture.substitution,
          value_type
        ) {
          None -> CheckedFlowCapturesRejected(CheckedStraightValueShapeUnavailable)
          Some(words) -> if words == 0 or ir_value_list_len(value.lanes) !=
            checked_flow_usize_to_i64(words) {
              CheckedFlowCapturesRejected(CheckedStraightWideValueUnsupported(words))
            } else {
              match checked_flow_lower_captures_from(
                graph,
                closures,
                captures,
                position + 1,
                after_capture,
                env
              ) {
                CheckedFlowCapturesRejected(issue) -> CheckedFlowCapturesRejected(issue)
                CheckedFlowCapturesTerminated(after_rest) ->
                  CheckedFlowCapturesTerminated(after_rest)
                CheckedFlowCapturesLowered(values, descriptions, rest_words, after_rest) ->
                  CheckedFlowCapturesLowered(
                    ir_value_list_append(value.lanes, values),
                    IrSemanticCaptureCons(
                      IrSemanticCapture { value_type: value_type, words: words },
                      descriptions
                    ),
                    words + rest_words,
                    after_rest
                  )
              }
            }
        }
      }
    }
  }
}

fn checked_flow_bind_lambda_list_from(
  graph: borrow CheckedExprGraph,
  closures: borrow CheckedClosureGraph,
  bindings: CheckedBindingListId,
  position: usize,
  next_value: i64,
  env: CheckedStraightValueEnv,
  catalog: borrow SemanticTypeCatalog,
  substitution: SemanticTypeSubstitution
) -> CheckedStraightParametersResult {
  if position >= closures.binding_list_len(bindings) {
    CheckedStraightParametersLowered(env, next_value)
  } else {
    let binding = closures.binding_list_at(bindings, position)
    let value_type = graph.binding(binding).value_type
    match checked_flow_value_word_count(catalog, substitution, value_type) {
      None -> CheckedStraightParametersRejected(CheckedStraightValueShapeUnavailable)
      Some(0) -> CheckedStraightParametersRejected(CheckedStraightWideValueUnsupported(0))
      Some(words) -> checked_flow_bind_lambda_list_from(
        graph,
        closures,
        bindings,
        position + 1,
        next_value + checked_flow_usize_to_i64(words),
        CheckedStraightValueEnvCons(
          binding,
          CheckedStraightValueHome(checked_flow_value(next_value, words)),
          env
        ),
        catalog,
        substitution
      )
    }
  }
}

fn checked_flow_lambda_preamble_from(
  word: usize,
  words: usize,
  capture_base: i64,
  scratch_base: i64
) -> IrInstList {
  if word >= words { ir_inst_list_empty() }
  else {
    let offset = checked_flow_usize_to_i64(word)
    let constant = scratch_base + offset * 2
    let address = constant + 1
    ir_inst_list_prepend(
      ir_inst_const_i64(constant, 8 + offset * 16),
      ir_inst_list_prepend(
        ir_inst_binary_i64(address, IrAdd, 0, constant),
        ir_inst_list_prepend(
          ir_inst_ptr_load_i64(capture_base + offset, address),
          checked_flow_lambda_preamble_from(
            word + 1,
            words,
            capture_base,
            scratch_base
          )
        )
      )
    )
  }
}

fn checked_flow_lower_lambda_function(
  graph: borrow CheckedExprGraph,
  symbols: borrow CheckedNativeFunctionSymbols,
  lambda: CheckedLambda,
  capture_words: usize,
  state: borrow CheckedStraightFlowState
) -> CheckedFlowNestedFunctionResult {
  let closures = state.closures
  let catalog = state.catalog
  let substitution = state.substitution
  match checked_flow_bind_lambda_list_from(
    graph,
    closures,
    lambda.parameters,
    0,
    1,
    CheckedStraightValueEnvNil,
    catalog,
    substitution
  ) {
    CheckedStraightParametersRejected(issue) ->
      CheckedFlowNestedFunctionRejected(issue)
    CheckedStraightParametersLowered(parameter_env, capture_base) ->
      match checked_flow_bind_lambda_list_from(
        graph,
        closures,
        lambda.captures,
        0,
        capture_base,
        parameter_env,
        catalog,
        substitution
      ) {
        CheckedStraightParametersRejected(issue) ->
          CheckedFlowNestedFunctionRejected(issue)
        CheckedStraightParametersLowered(env, after_captures) -> {
          let expected = capture_base + checked_flow_usize_to_i64(capture_words)
          if after_captures != expected {
            CheckedFlowNestedFunctionRejected(CheckedStraightValueShapeUnavailable)
          } else {
            let scratch_base = after_captures
            let initial = CheckedStraightFlowState {
              current_block: 0,
              current_params: ir_value_list_empty(),
              current_insts: checked_flow_lambda_preamble_from(
                0,
                capture_words,
                capture_base,
                scratch_base
              ),
              completed_blocks: ir_block_list_empty(),
              next_block: 1,
              next_value: scratch_base + checked_flow_usize_to_i64(capture_words) * 2,
              loop_targets: CheckedStraightOutsideLoop,
              cleanups: CheckedStraightCleanupNil,
              cleanup_depth: 0,
              function_exit: false,
              catalog: state.catalog,
              declarations: state.declarations,
              patterns: state.patterns,
              closures: state.closures,
              effects: state.effects,
              substitution: state.substitution
            }
            match checked_flow_lower_expression(
              graph,
              symbols,
              lambda.body,
              initial,
              env
            ) {
              CheckedFlowValueRejected(issue) ->
                CheckedFlowNestedFunctionRejected(issue)
              CheckedFlowValueTerminated(lowered) ->
                CheckedFlowNestedFunctionLowered(
                  ir_function_new_blocks_src(
                    0,
                    capture_base,
                    lowered.completed_blocks,
                    __str_ptr(graph.source().text)
                  )
                )
              CheckedFlowValueLowered(value, lowered) -> {
                let completed = checked_flow_return(lowered, value)
                CheckedFlowNestedFunctionLowered(
                  ir_function_new_blocks_src(
                    0,
                    capture_base,
                    completed.completed_blocks,
                    __str_ptr(graph.source().text)
                  )
                )
              }
            }
          }
        }
      }
  }
}

fn checked_flow_lower_lambda(
  graph: borrow CheckedExprGraph,
  symbols: borrow CheckedNativeFunctionSymbols,
  expression: CheckedExprId,
  state: CheckedStraightFlowState,
  env: CheckedStraightValueEnv
) -> CheckedFlowValueResult {
  let closures = state.closures
  let lambda = closures.inspect(graph.lambda_detail(expression))
  match checked_flow_lower_captures_from(
    graph,
    closures,
    lambda.captures,
    0,
    state,
    env
  ) {
    CheckedFlowCapturesRejected(issue) -> CheckedFlowValueRejected(issue)
    CheckedFlowCapturesTerminated(after_captures) ->
      CheckedFlowValueTerminated(after_captures)
    CheckedFlowCapturesLowered(arguments, captures, capture_words, after_captures) ->
      match checked_flow_lower_lambda_function(
        graph,
        symbols,
        lambda,
        capture_words,
        after_captures
      ) {
        CheckedFlowNestedFunctionRejected(issue) -> CheckedFlowValueRejected(issue)
        CheckedFlowNestedFunctionLowered(function) ->
          checked_flow_emit_semantic_data_value(
            graph,
            expression,
            after_captures,
            IrSemanticClosure(
              function,
              captures,
              lambda.source_site,
              checked_flow_lambda_role(lambda.role),
              lambda.generator_producer
            ),
            arguments
          )
      }
  }
}

fn checked_flow_handler_bindings_from(
  graph: borrow CheckedExprGraph,
  effects: borrow CheckedEffectGraph,
  bindings: CheckedHandlerParameterListId,
  position: usize,
  next_value: i64,
  env: CheckedStraightValueEnv,
  catalog: borrow SemanticTypeCatalog,
  substitution: SemanticTypeSubstitution
) -> CheckedFlowHandlerBindingsResult {
  if position >= effects.parameter_list_len(bindings) {
    CheckedFlowHandlerBindingsLowered(
      env,
      IrSemanticCaptureNil,
      0,
      next_value
    )
  } else {
    let binding = effects.parameter_list_at(bindings, position)
    let value_type = graph.binding(binding).value_type
    match checked_flow_value_word_count(catalog, substitution, value_type) {
      None -> CheckedFlowHandlerBindingsRejected(
        CheckedStraightValueShapeUnavailable
      )
      Some(words) -> match checked_flow_handler_bindings_from(
        graph,
        effects,
        bindings,
        position + 1,
        next_value + checked_flow_usize_to_i64(words),
        CheckedStraightValueEnvCons(
          binding,
          CheckedStraightValueHome(checked_flow_value(next_value, words)),
          env
        ),
        catalog,
        substitution
      ) {
        CheckedFlowHandlerBindingsRejected(issue) ->
          CheckedFlowHandlerBindingsRejected(issue)
        CheckedFlowHandlerBindingsLowered(
          final_env,
          remaining,
          remaining_words,
          final_value,
        ) -> CheckedFlowHandlerBindingsLowered(
          final_env,
          IrSemanticCaptureCons(
            IrSemanticCapture { value_type: value_type, words: words },
            remaining
          ),
          words + remaining_words,
          final_value
        )
      }
    }
  }
}

fn checked_flow_lower_handler_captures_from(
  graph: borrow CheckedExprGraph,
  effects: borrow CheckedEffectGraph,
  captures: CheckedHandlerParameterListId,
  position: usize,
  state: CheckedStraightFlowState,
  env: CheckedStraightValueEnv
) -> CheckedFlowCapturesResult {
  if position >= effects.parameter_list_len(captures) {
    CheckedFlowCapturesLowered(
      ir_value_list_empty(),
      IrSemanticCaptureNil,
      0,
      state
    )
  } else {
    let binding = effects.parameter_list_at(captures, position)
    let value_type = graph.binding(binding).value_type
    match checked_flow_lower_binding_home(env, binding, state) {
      CheckedFlowValueRejected(issue) -> CheckedFlowCapturesRejected(issue)
      CheckedFlowValueTerminated(after_capture) ->
        CheckedFlowCapturesTerminated(after_capture)
      CheckedFlowValueLowered(value, after_capture) -> {
        let catalog = after_capture.catalog
        match checked_flow_value_word_count(
          catalog,
          after_capture.substitution,
          value_type
        ) {
          None -> CheckedFlowCapturesRejected(CheckedStraightValueShapeUnavailable)
          Some(words) -> if ir_value_list_len(value.lanes) != checked_flow_usize_to_i64(words) {
            CheckedFlowCapturesRejected(CheckedStraightWideValueUnsupported(words))
          } else {
            match checked_flow_lower_handler_captures_from(
              graph,
              effects,
              captures,
              position + 1,
              after_capture,
              env
            ) {
              CheckedFlowCapturesRejected(issue) -> CheckedFlowCapturesRejected(issue)
              CheckedFlowCapturesTerminated(after_rest) ->
                CheckedFlowCapturesTerminated(after_rest)
              CheckedFlowCapturesLowered(values, descriptions, rest_words, after_rest) ->
                CheckedFlowCapturesLowered(
                  ir_value_list_append(value.lanes, values),
                  IrSemanticCaptureCons(
                    IrSemanticCapture { value_type: value_type, words: words },
                    descriptions
                  ),
                  words + rest_words,
                  after_rest
                )
            }
          }
        }
      }
    }
  }
}

fn checked_flow_lower_nested_function(
  graph: borrow CheckedExprGraph,
  symbols: borrow CheckedNativeFunctionSymbols,
  expression: CheckedExprId,
  state: borrow CheckedStraightFlowState,
  env: CheckedStraightValueEnv,
  parameter_lanes: i64
) -> CheckedFlowNestedFunctionResult {
  let initial = CheckedStraightFlowState {
    current_block: 0,
    current_params: ir_value_list_empty(),
    current_insts: ir_inst_list_empty(),
    completed_blocks: ir_block_list_empty(),
    next_block: 1,
    next_value: parameter_lanes,
    loop_targets: CheckedStraightOutsideLoop,
    cleanups: CheckedStraightCleanupNil,
    cleanup_depth: 0,
    function_exit: false,
    catalog: state.catalog,
    declarations: state.declarations,
    patterns: state.patterns,
    closures: state.closures,
    effects: state.effects,
    substitution: state.substitution
  }
  match checked_flow_lower_expression(graph, symbols, expression, initial, env) {
    CheckedFlowValueRejected(issue) -> CheckedFlowNestedFunctionRejected(issue)
    CheckedFlowValueTerminated(lowered) -> CheckedFlowNestedFunctionLowered(
      ir_function_new_blocks_src(
        0,
        parameter_lanes,
        lowered.completed_blocks,
        __str_ptr(graph.source().text)
      )
    )
    CheckedFlowValueLowered(value, lowered) -> {
      let completed = checked_flow_return(lowered, value)
      CheckedFlowNestedFunctionLowered(
        ir_function_new_blocks_src(
          0,
          parameter_lanes,
          completed.completed_blocks,
          __str_ptr(graph.source().text)
        )
      )
    }
  }
}

fn checked_flow_handler_completion(
  completion: CheckedHandlerCompletion
) -> HandlerClauseCompletion {
  match completion {
    CheckedHandlerAborts -> HandlerClauseAborts
    CheckedHandlerResumes -> HandlerClauseResumes
    CheckedHandlerMixed -> HandlerClauseMixed
    CheckedHandlerDeferred -> HandlerClauseDeferred
  }
}

fn checked_flow_lower_handler_clause(
  graph: borrow CheckedExprGraph,
  symbols: borrow CheckedNativeFunctionSymbols,
  clause: CheckedHandlerClause,
  state: CheckedStraightFlowState,
  outer_env: CheckedStraightValueEnv
) -> CheckedFlowHandlerClauseResult {
  let effects = state.effects
  match checked_flow_lower_handler_captures_from(
    graph,
    effects,
    clause.captures,
    0,
    state,
    outer_env
  ) {
    CheckedFlowCapturesRejected(issue) -> CheckedFlowHandlerClauseRejected(issue)
    CheckedFlowCapturesTerminated(after_captures) ->
      CheckedFlowHandlerClauseTerminated(after_captures)
    CheckedFlowCapturesLowered(
      capture_values,
      capture_descriptions,
      capture_words,
      after_captures,
    ) -> {
      let catalog = after_captures.catalog
      let substitution = after_captures.substitution
      match checked_flow_handler_bindings_from(
        graph,
        effects,
        clause.parameters,
        0,
        0,
        CheckedStraightValueEnvNil,
        catalog,
        substitution
      ) {
        CheckedFlowHandlerBindingsRejected(issue) ->
          CheckedFlowHandlerClauseRejected(issue)
        CheckedFlowHandlerBindingsLowered(
          parameter_env,
          parameters,
          parameter_words,
          capture_base,
        ) -> match checked_flow_handler_bindings_from(
          graph,
          effects,
          clause.captures,
          0,
          capture_base,
          parameter_env,
          catalog,
          substitution
        ) {
          CheckedFlowHandlerBindingsRejected(issue) ->
            CheckedFlowHandlerClauseRejected(issue)
          CheckedFlowHandlerBindingsLowered(
            captured_env,
            nested_captures,
            nested_capture_words,
            continuation_base,
          ) -> if nested_capture_words != capture_words {
            CheckedFlowHandlerClauseRejected(CheckedStraightValueShapeUnavailable)
          } else {
            let (body_env, continuation, parameter_lanes) = match clause.continuation {
              CheckedImmediateHandlerClause -> (
                CheckedStraightValueEnvResume(captured_env),
                IrSemanticImmediateHandlerClause,
                continuation_base
              )
              CheckedDeferredHandlerClause(binding) -> {
                let continuation_type = graph.binding(binding).value_type
                match checked_flow_value_word_count(
                  catalog,
                  substitution,
                  continuation_type
                ) {
                  None -> return CheckedFlowHandlerClauseRejected(
                    CheckedStraightValueShapeUnavailable
                  )
                  Some(0) -> return CheckedFlowHandlerClauseRejected(
                    CheckedStraightWideValueUnsupported(0)
                  )
                  Some(words) -> (
                    CheckedStraightValueEnvCons(
                      binding,
                      CheckedStraightValueHome(
                        checked_flow_value(continuation_base, words)
                      ),
                      captured_env
                    ),
                    IrSemanticDeferredHandlerClause(continuation_type, words),
                    continuation_base + checked_flow_usize_to_i64(words)
                  )
                }
              }
            }
            match checked_flow_lower_nested_function(
              graph,
              symbols,
              clause.body,
              after_captures,
              body_env,
              parameter_lanes
            ) {
              CheckedFlowNestedFunctionRejected(issue) ->
                CheckedFlowHandlerClauseRejected(issue)
              CheckedFlowNestedFunctionLowered(body) ->
                CheckedFlowHandlerClauseLowered(
                  IrSemanticHandlerClause {
                    effect_declaration: clause.effect_declaration,
                    operation: clause.operation,
                    atom: clause.atom,
                    parameters: parameters,
                    parameter_words: parameter_words,
                    captures: nested_captures,
                    capture_values: capture_values,
                    capture_words: capture_words,
                    continuation: continuation,
                    completion: checked_flow_handler_completion(clause.completion),
                    result_type: graph.result_type(clause.body),
                    body: body
                  },
                  after_captures
                )
            }
          }
        }
      }
    }
  }
}

fn checked_flow_lower_handler_clauses_from(
  graph: borrow CheckedExprGraph,
  symbols: borrow CheckedNativeFunctionSymbols,
  effects: borrow CheckedEffectGraph,
  clauses: CheckedHandlerClauseListId,
  position: usize,
  state: CheckedStraightFlowState,
  env: CheckedStraightValueEnv
) -> CheckedFlowHandlerClausesResult {
  if position >= effects.clause_list_len(clauses) {
    CheckedFlowHandlerClausesLowered(IrSemanticHandlerClauseNil, state)
  } else {
    match checked_flow_lower_handler_clause(
      graph,
      symbols,
      effects.clause_list_at(clauses, position),
      state,
      env
    ) {
      CheckedFlowHandlerClauseRejected(issue) ->
        CheckedFlowHandlerClausesRejected(issue)
      CheckedFlowHandlerClauseTerminated(after_clause) ->
        CheckedFlowHandlerClausesTerminated(after_clause)
      CheckedFlowHandlerClauseLowered(clause, after_clause) ->
        match checked_flow_lower_handler_clauses_from(
          graph,
          symbols,
          effects,
          clauses,
          position + 1,
          after_clause,
          env
        ) {
          CheckedFlowHandlerClausesRejected(issue) ->
            CheckedFlowHandlerClausesRejected(issue)
          CheckedFlowHandlerClausesTerminated(after_clauses) ->
            CheckedFlowHandlerClausesTerminated(after_clauses)
          CheckedFlowHandlerClausesLowered(remaining, after_clauses) ->
            CheckedFlowHandlerClausesLowered(
              IrSemanticHandlerClauseCons(clause, remaining),
              after_clauses
            )
        }
    }
  }
}

fn checked_flow_lower_handle_return(
  graph: borrow CheckedExprGraph,
  symbols: borrow CheckedNativeFunctionSymbols,
  handled: CheckedHandle,
  state: borrow CheckedStraightFlowState,
  capture_words: usize
) -> CheckedFlowHandlerReturnResult {
  let catalog = state.catalog
  let effects = state.effects
  let substitution = state.substitution
  match handled.return_clause {
    CheckedNoHandleReturn -> CheckedFlowHandlerReturnLowered(
      IrSemanticNoHandleReturn
    )
    CheckedHandleReturnClause(binding, body) -> {
      let body_type = graph.result_type(handled.body)
      match checked_flow_value_word_count(
        catalog,
        substitution,
        body_type
      ) {
        None -> CheckedFlowHandlerReturnRejected(CheckedStraightValueShapeUnavailable)
        Some(0) -> CheckedFlowHandlerReturnLowered(IrSemanticNoHandleReturn)
        Some(body_words) -> match checked_flow_handler_bindings_from(
          graph,
          effects,
          handled.captures,
          0,
          checked_flow_usize_to_i64(body_words),
          CheckedStraightValueEnvCons(
            binding,
            CheckedStraightValueHome(checked_flow_value(0, body_words)),
            CheckedStraightValueEnvNil
          ),
          catalog,
          substitution
        ) {
          CheckedFlowHandlerBindingsRejected(issue) ->
            CheckedFlowHandlerReturnRejected(issue)
          CheckedFlowHandlerBindingsLowered(env, _, words, parameter_lanes) ->
            if words != capture_words {
              CheckedFlowHandlerReturnRejected(CheckedStraightValueShapeUnavailable)
            } else {
              match checked_flow_lower_nested_function(
                graph,
                symbols,
                body,
                state,
                env,
                parameter_lanes
              ) {
                CheckedFlowNestedFunctionRejected(issue) ->
                  CheckedFlowHandlerReturnRejected(issue)
                CheckedFlowNestedFunctionLowered(function) ->
                  CheckedFlowHandlerReturnLowered(
                    IrSemanticHandleReturnTransform(body_type, function)
                  )
              }
            }
        }
      }
    }
  }
}

fn checked_flow_lower_handle(
  graph: borrow CheckedExprGraph,
  symbols: borrow CheckedNativeFunctionSymbols,
  expression: CheckedExprId,
  state: CheckedStraightFlowState,
  env: CheckedStraightValueEnv
) -> CheckedFlowValueResult {
  let effects = state.effects
  match effects.inspect(graph.handle_detail(expression)) {
    CheckedHandleDetail(handled) -> match checked_flow_lower_handler_captures_from(
      graph,
      effects,
      handled.captures,
      0,
      state,
      env
    ) {
      CheckedFlowCapturesRejected(issue) -> CheckedFlowValueRejected(issue)
      CheckedFlowCapturesTerminated(after_captures) ->
        CheckedFlowValueTerminated(after_captures)
      CheckedFlowCapturesLowered(
        capture_values,
        captures,
        capture_words,
        after_captures,
      ) -> {
        let catalog = after_captures.catalog
        match checked_flow_handler_bindings_from(
          graph,
          effects,
          handled.captures,
          0,
          0,
          CheckedStraightValueEnvNil,
          catalog,
          after_captures.substitution
        ) {
          CheckedFlowHandlerBindingsRejected(issue) -> CheckedFlowValueRejected(issue)
          CheckedFlowHandlerBindingsLowered(body_env, _, body_capture_words, body_lanes) ->
            if body_capture_words != capture_words {
              CheckedFlowValueRejected(CheckedStraightValueShapeUnavailable)
            } else {
              match checked_flow_lower_nested_function(
                graph,
                symbols,
                handled.body,
                after_captures,
                body_env,
                body_lanes
              ) {
                CheckedFlowNestedFunctionRejected(issue) -> CheckedFlowValueRejected(issue)
                CheckedFlowNestedFunctionLowered(body) -> match checked_flow_lower_handle_return(
                  graph,
                  symbols,
                  handled,
                  after_captures,
                  capture_words
                ) {
                  CheckedFlowHandlerReturnRejected(issue) -> CheckedFlowValueRejected(issue)
                  CheckedFlowHandlerReturnLowered(return_clause) ->
                    match checked_flow_lower_handler_clauses_from(
                      graph,
                      symbols,
                      effects,
                      handled.clauses,
                      0,
                      after_captures,
                      env
                    ) {
                      CheckedFlowHandlerClausesRejected(issue) ->
                        CheckedFlowValueRejected(issue)
                      CheckedFlowHandlerClausesTerminated(after_clauses) ->
                        CheckedFlowValueTerminated(after_clauses)
                      CheckedFlowHandlerClausesLowered(clauses, after_clauses) -> {
                        let result = after_clauses.next_value
                        checked_flow_emit_call_value(
                          graph,
                          expression,
                          after_clauses,
                          ir_inst_semantic_handle_i64(
                            result,
                            IrSemanticHandler {
                              body: body,
                              body_type: graph.result_type(handled.body),
                              captures: captures,
                              capture_words: capture_words,
                              clauses: clauses,
                              return_clause: return_clause
                            },
                            graph.result_type(expression),
                            capture_values
                          )
                        )
                      }
                    }
                }
              }
            }
        }
      }
    }
    _ -> CheckedFlowValueRejected(
      CheckedStraightUnsupportedExpression(CheckedHandleKind)
    )
  }
}

fn checked_flow_lower_resume(
  graph: borrow CheckedExprGraph,
  symbols: borrow CheckedNativeFunctionSymbols,
  expression: CheckedExprId,
  state: CheckedStraightFlowState,
  env: CheckedStraightValueEnv
) -> CheckedFlowValueResult {
  if not checked_straight_env_allows_resume(env) {
    CheckedFlowValueRejected(CheckedStraightResumeOutsideHandler)
  } else {
    let input = graph.resume_value(expression)
    match checked_flow_lower_expression(graph, symbols, input, state, env) {
      CheckedFlowValueRejected(issue) -> CheckedFlowValueRejected(issue)
      CheckedFlowValueTerminated(after_input) -> CheckedFlowValueTerminated(after_input)
      CheckedFlowValueLowered(value, after_input) -> {
        let result = after_input.next_value
        checked_flow_emit_call_value(
          graph,
          expression,
          after_input,
          ir_inst_semantic_resume_i64(
            result,
            graph.result_type(input),
            graph.result_type(expression),
            value.lanes
          )
        )
      }
    }
  }
}

fn checked_flow_lower_perform(
  graph: borrow CheckedExprGraph,
  symbols: borrow CheckedNativeFunctionSymbols,
  expression: CheckedExprId,
  state: CheckedStraightFlowState,
  env: CheckedStraightValueEnv
) -> CheckedFlowValueResult {
  let effects = state.effects
  match effects.inspect(graph.perform_detail(expression)) {
    CheckedPerformDetail(perform) -> match checked_flow_lower_arguments_from(
      graph,
      symbols,
      perform.arguments,
      0,
      state,
      env
    ) {
      CheckedFlowArgumentsRejected(issue) -> CheckedFlowValueRejected(issue)
      CheckedFlowArgumentsTerminated(after_arguments) ->
        CheckedFlowValueTerminated(after_arguments)
      CheckedFlowArgumentsLowered(arguments, after_arguments) -> {
        let result = after_arguments.next_value
        checked_flow_emit_call_value(
          graph,
          expression,
          after_arguments,
          ir_inst_semantic_perform_i64(
            result,
            perform.effect_declaration,
            perform.operation,
            perform.atom,
            graph.result_type(expression),
            arguments
          )
        )
      }
    }
    _ -> CheckedFlowValueRejected(
      CheckedStraightUnsupportedExpression(CheckedPerformKind)
    )
  }
}

fn checked_flow_lower_expression(
  graph: borrow CheckedExprGraph,
  symbols: borrow CheckedNativeFunctionSymbols,
  expression: CheckedExprId,
  state: CheckedStraightFlowState,
  env: CheckedStraightValueEnv
) -> CheckedFlowValueResult {
  let kind = graph.kind(expression)
  match kind {
    CheckedIntegerKind -> {
      let result = state.next_value
      CheckedFlowValueLowered(
        checked_flow_scalar(result),
        checked_flow_emit(
          state,
          ir_inst_const_i64(result, graph.integer_value(expression)),
          1
        )
      )
    }
    CheckedBooleanKind -> {
      let result = state.next_value
      CheckedFlowValueLowered(
        checked_flow_scalar(result),
        checked_flow_emit(
          state,
          ir_inst_const_i64(result, graph.boolean_value(expression)),
          1
        )
      )
    }
    CheckedNilKind -> {
      let result = state.next_value
      CheckedFlowValueLowered(
        checked_flow_scalar(result),
        checked_flow_emit(state, ir_inst_nil_i64(result), 1)
      )
    }
    CheckedStringKind -> {
      let result = state.next_value
      let value = graph.string_value(expression)
      CheckedFlowValueLowered(
        checked_flow_scalar(result),
        checked_flow_emit(
          state,
          ir_inst_string_lit(result, __str_ptr(value), 0, __str_len(value)),
          1
        )
      )
    }
    CheckedLocalReferenceKind -> checked_flow_lower_binding_home(
      env,
      graph.local_binding(expression),
      state
    )
    CheckedSharedBorrowKind -> checked_flow_lower_binding_home(
      env,
      graph.borrow_parts(expression).0,
      state
    )
    CheckedExclusiveBorrowKind -> checked_flow_lower_binding_home(
      env,
      graph.borrow_parts(expression).0,
      state
    )
    CheckedDeclarationReferenceKind -> match checked_native_function_symbols_resolve(
      symbols,
      DeclaredFunctionIdentity(graph.declaration(expression))
    ) {
      None -> CheckedFlowValueRejected(
        CheckedStraightFunctionSymbolMissing(
          DeclaredFunctionIdentity(graph.declaration(expression))
        )
      )
      Some(key) -> {
        let result = state.next_value
        CheckedFlowValueLowered(
          checked_flow_scalar(result),
          checked_flow_emit(state, ir_inst_function_ref_i64(result, key), 1)
        )
      }
    }
    CheckedNotKind -> match checked_flow_lower_expression(
      graph,
      symbols,
      graph.not_operand(expression),
      state,
      env
    ) {
      CheckedFlowValueRejected(issue) -> CheckedFlowValueRejected(issue)
      CheckedFlowValueTerminated(after_value) -> CheckedFlowValueTerminated(after_value)
      CheckedFlowValueLowered(value, after_value) -> {
        let result = after_value.next_value
        CheckedFlowValueLowered(
          checked_flow_scalar(result),
          checked_flow_emit(
            after_value,
            ir_inst_unary_i64(result, ir_unary_op_not(), value.head),
            1
          )
        )
      }
    }
    CheckedNegateKind -> match checked_flow_lower_expression(
      graph,
      symbols,
      graph.negate_operand(expression),
      state,
      env
    ) {
      CheckedFlowValueRejected(issue) -> CheckedFlowValueRejected(issue)
      CheckedFlowValueTerminated(after_value) -> CheckedFlowValueTerminated(after_value)
      CheckedFlowValueLowered(value, after_value) -> {
        let zero = after_value.next_value
        let result = zero + 1
        let with_zero = checked_flow_emit(
          after_value,
          ir_inst_const_i64(zero, 0),
          1
        )
        CheckedFlowValueLowered(
          checked_flow_scalar(result),
          checked_flow_emit(
            with_zero,
            ir_inst_binary_i64(result, IrSub, zero, value.head),
            1
          )
        )
      }
    }
    CheckedBinaryKind -> match checked_flow_lower_expression(
      graph,
      symbols,
      graph.binary_left(expression),
      state,
      env
    ) {
      CheckedFlowValueRejected(issue) -> CheckedFlowValueRejected(issue)
      CheckedFlowValueTerminated(after_left) -> CheckedFlowValueTerminated(after_left)
      CheckedFlowValueLowered(left, after_left) -> match checked_flow_lower_expression(
        graph,
        symbols,
        graph.binary_right(expression),
        after_left,
        env
      ) {
        CheckedFlowValueRejected(issue) -> CheckedFlowValueRejected(issue)
        CheckedFlowValueTerminated(after_right) -> CheckedFlowValueTerminated(after_right)
        CheckedFlowValueLowered(right, after_right) -> {
          let result = after_right.next_value
          CheckedFlowValueLowered(
            checked_flow_scalar(result),
            checked_flow_emit(
              after_right,
              ir_inst_binary_i64(
                result,
                checked_straight_binary_operator(graph.binary_operator(expression)),
                left.head,
                right.head
              ),
              1
            )
          )
        }
      }
    }
    CheckedIfKind -> checked_flow_lower_if(graph, symbols, expression, state, env)
    CheckedExplicitMatchKind -> checked_flow_lower_match(
      graph,
      symbols,
      expression,
      state,
      env
    )
    CheckedWhileKind -> checked_flow_lower_while(graph, symbols, expression, state, env)
    CheckedLoopKind -> checked_flow_lower_loop(graph, symbols, expression, state, env)
    CheckedBreakKind -> match checked_flow_lower_expression(
      graph,
      symbols,
      graph.break_value(expression),
      state,
      env
    ) {
      CheckedFlowValueRejected(issue) -> CheckedFlowValueRejected(issue)
      CheckedFlowValueTerminated(after_value) -> CheckedFlowValueTerminated(after_value)
      CheckedFlowValueLowered(value, after_value) -> match after_value.loop_targets {
        CheckedStraightOutsideLoop -> CheckedFlowValueRejected(
          CheckedStraightControlOutsideLoop(CheckedBreakKind)
        )
        CheckedStraightInsideLoop(_, target, argument_count, cleanup_depth, _) ->
          checked_flow_break_to(
            checked_flow_cleanup_to_depth(after_value, cleanup_depth),
            target,
            argument_count,
            value
          )
      }
    }
    CheckedBreakNoValueKind -> checked_flow_lower_break_no_value(
      CheckedBreakNoValueKind,
      state
    )
    CheckedContinueKind -> match state.loop_targets {
      CheckedStraightOutsideLoop -> CheckedFlowValueRejected(
        CheckedStraightControlOutsideLoop(CheckedContinueKind)
      )
      CheckedStraightInsideLoop(target, _, _, cleanup_depth, _) -> CheckedFlowValueTerminated(
        checked_flow_close(
          checked_flow_cleanup_to_depth(state, cleanup_depth),
          ir_term_jump(target)
        )
      )
    }
    CheckedReturnKind -> match checked_flow_lower_expression(
      graph,
      symbols,
      graph.return_value(expression),
      state,
      env
    ) {
      CheckedFlowValueRejected(issue) -> CheckedFlowValueRejected(issue)
      CheckedFlowValueTerminated(after_value) -> CheckedFlowValueTerminated(after_value)
      CheckedFlowValueLowered(value, after_value) -> CheckedFlowValueTerminated(
        checked_flow_return(checked_flow_cleanup_to_depth(after_value, 0), value)
      )
    }
    CheckedBlockKind -> match checked_flow_lower_expression(
      graph,
      symbols,
      graph.block_first(expression),
      state,
      env
    ) {
      CheckedFlowValueRejected(issue) -> CheckedFlowValueRejected(issue)
      CheckedFlowValueTerminated(after_first) -> CheckedFlowValueTerminated(after_first)
      CheckedFlowValueLowered(_, after_first) -> checked_flow_lower_expression(
        graph,
        symbols,
        graph.block_rest(expression),
        after_first,
        env
      )
    }
    CheckedLetKind -> match graph.let_parts(expression) {
      (binding, value_expression, body) -> match checked_flow_lower_expression(
        graph,
        symbols,
        value_expression,
        state,
        env
      ) {
        CheckedFlowValueRejected(issue) -> CheckedFlowValueRejected(issue)
        CheckedFlowValueTerminated(after_value) -> CheckedFlowValueTerminated(after_value)
        CheckedFlowValueLowered(value, after_value) -> checked_flow_lower_expression(
          graph,
          symbols,
          body,
          after_value,
          CheckedStraightValueEnvCons(
            binding,
            CheckedStraightValueHome(value),
            env
          )
        )
      }
    }
    CheckedLetMutKind -> match graph.let_mut_parts(expression) {
      (binding, value_expression, body) -> {
        let catalog = state.catalog
        let substitution = state.substitution
        let value_type = graph.binding(binding).value_type
        let outer_cleanups = state.cleanups
        let outer_cleanup_depth = state.cleanup_depth
        match checked_straight_mutable_binding_issue(
          graph,
          binding,
          catalog,
          substitution
        ) {
          Some(issue) -> CheckedFlowValueRejected(issue)
          None -> match checked_flow_lower_expression(
            graph,
            symbols,
            value_expression,
            state,
            env
          ) {
            CheckedFlowValueRejected(issue) -> CheckedFlowValueRejected(issue)
            CheckedFlowValueTerminated(after_value) -> CheckedFlowValueTerminated(after_value)
            CheckedFlowValueLowered(value, after_value) -> {
              let slot = after_value.next_value
              let allocated = checked_flow_emit(
                after_value,
                ir_inst_slot_i64(slot),
                1
              )
              let initialized = checked_flow_emit(
                allocated,
                ir_inst_store_i64(slot, value.head),
                0
              )
              let managed = checked_straight_mutable_needs_cleanup(
                catalog,
                substitution,
                value_type
              )
              let acquired = if managed {
                checked_flow_emit_semantic_slot_transition(
                  initialized,
                  slot,
                  value_type,
                  IrSemanticMutableSlotAcquire,
                  value.lanes
                )
              } else { initialized }
              let entered = if managed {
                checked_flow_with_cleanups(
                  acquired,
                  CheckedStraightCleanupCons(
                    slot,
                    value_type,
                    outer_cleanups
                  ),
                  outer_cleanup_depth + 1
                )
              } else { acquired }
              match checked_flow_lower_expression(
                graph,
                symbols,
                body,
                entered,
                CheckedStraightValueEnvCons(
                  binding,
                  CheckedStraightSlotHome(slot, value_type),
                  env
                )
              ) {
                CheckedFlowValueRejected(issue) -> CheckedFlowValueRejected(issue)
                CheckedFlowValueTerminated(after_body) -> CheckedFlowValueTerminated(
                  checked_flow_with_cleanups(
                    after_body,
                    outer_cleanups,
                    outer_cleanup_depth
                  )
                )
                CheckedFlowValueLowered(result, after_body) -> {
                  let cleaned = if managed {
                    checked_flow_emit_semantic_slot_release(
                      after_body,
                      slot,
                      value_type
                    )
                  } else { after_body }
                  CheckedFlowValueLowered(
                    result,
                    checked_flow_with_cleanups(
                      cleaned,
                      outer_cleanups,
                      outer_cleanup_depth
                    )
                  )
                }
              }
            }
          }
        }
      }
    }
    CheckedAssignKind -> match graph.assign_parts(expression) {
      (binding, value_expression) -> match checked_straight_env_find(env, binding) {
        None -> CheckedFlowValueRejected(CheckedStraightBindingMissing(binding))
        Some(home) -> match home {
          CheckedStraightValueHome(_) -> CheckedFlowValueRejected(
            CheckedStraightBindingNotMutable(binding)
          )
          CheckedStraightSlotHome(slot, value_type) -> match checked_flow_lower_expression(
            graph,
            symbols,
            value_expression,
            state,
            env
          ) {
            CheckedFlowValueRejected(issue) -> CheckedFlowValueRejected(issue)
            CheckedFlowValueTerminated(after_value) ->
              CheckedFlowValueTerminated(after_value)
            CheckedFlowValueLowered(value, after_value) -> {
              let catalog = after_value.catalog
              let substitution = after_value.substitution
              let managed = checked_straight_mutable_needs_cleanup(
                catalog,
                substitution,
                value_type
              )
              let stored = if managed {
                let previous = after_value.next_value
                let loaded = checked_flow_emit(
                  after_value,
                  ir_inst_load_i64(previous, slot),
                  1
                )
                let committed = checked_flow_emit(
                  loaded,
                  ir_inst_store_i64(slot, value.head),
                  0
                )
                checked_flow_emit_semantic_slot_transition(
                  committed,
                  slot,
                  value_type,
                  IrSemanticMutableSlotReplace(previous),
                  ir_value_list_prepend(
                    value.head,
                    ir_value_list_prepend(previous, ir_value_list_empty())
                  )
                )
              } else {
                checked_flow_emit(
                  after_value,
                  ir_inst_store_i64(slot, value.head),
                  0
                )
              }
              let result = stored.next_value
              CheckedFlowValueLowered(
                checked_flow_scalar(result),
                checked_flow_emit(stored, ir_inst_nil_i64(result), 1)
              )
            }
          }
        }
      }
    }
    CheckedConstructorCallKind -> match graph.constructor_call_parts(expression) {
      (declaration, arguments) -> match checked_flow_lower_arguments_from(
        graph,
        symbols,
        arguments,
        0,
        state,
        env
      ) {
        CheckedFlowArgumentsRejected(issue) -> CheckedFlowValueRejected(issue)
        CheckedFlowArgumentsTerminated(after_arguments) ->
          CheckedFlowValueTerminated(after_arguments)
        CheckedFlowArgumentsLowered(values, after_arguments) ->
          match checked_flow_constructor_shape(
            declaration,
            graph.result_type(expression),
            after_arguments
          ) {
            CheckedFlowConstructorShapeUnavailable -> CheckedFlowValueRejected(
              CheckedStraightValueShapeUnavailable
            )
            CheckedFlowOpaqueConstructor -> if ir_value_list_len(values) > 0 {
              CheckedFlowValueLowered(
                CheckedFlowValue {
                  head: ir_value_list_nth_or(values, 0, 0 - 1),
                  lanes: values
                },
                after_arguments
              )
            } else {
              CheckedFlowValueRejected(CheckedStraightValueShapeUnavailable)
            }
            CheckedFlowVariantConstructor(_, _, _) -> {
              let result = after_arguments.next_value
              CheckedFlowValueLowered(
                checked_flow_scalar(result),
                checked_flow_emit(
                  after_arguments,
                  ir_inst_semantic_constructor_i64(
                    result,
                    declaration,
                    graph.result_type(expression),
                    values
                  ),
                  1
                )
              )
            }
          }
      }
    }
    CheckedDirectCallKind -> match graph.direct_call_parts(expression) {
      (function, arguments) -> match checked_native_function_symbols_resolve(
        symbols,
        function
      ) {
        None -> CheckedFlowValueRejected(CheckedStraightFunctionSymbolMissing(function))
        Some(key) -> match checked_flow_lower_arguments_from(
          graph,
          symbols,
          arguments,
          0,
          state,
          env
        ) {
          CheckedFlowArgumentsRejected(issue) -> CheckedFlowValueRejected(issue)
          CheckedFlowArgumentsTerminated(after_arguments) ->
            CheckedFlowValueTerminated(after_arguments)
          CheckedFlowArgumentsLowered(values, after_arguments) -> {
            let result = after_arguments.next_value
            checked_flow_emit_call_value(
              graph,
              expression,
              after_arguments,
              ir_inst_call_i64(result, key, values)
            )
          }
        }
      }
    }
    CheckedGenericCallKind -> match graph.generic_call_parts(expression) {
      (callee, type_arguments) -> match graph.kind(callee) {
        CheckedDeclarationReferenceKind -> checked_flow_emit_semantic_data_value(
          graph,
          expression,
          state,
          IrSemanticFunctionReference(
            DeclaredFunctionIdentity(graph.declaration(callee)),
            checked_semantic_type_arguments_from(graph, type_arguments, 0)
          ),
          ir_value_list_empty()
        )
        CheckedDirectCallKind -> match graph.direct_call_parts(callee) {
          (function, arguments) -> match checked_flow_lower_arguments_from(
            graph,
            symbols,
            arguments,
            0,
            state,
            env
          ) {
            CheckedFlowArgumentsRejected(issue) -> CheckedFlowValueRejected(issue)
            CheckedFlowArgumentsTerminated(after_arguments) ->
              CheckedFlowValueTerminated(after_arguments)
            CheckedFlowArgumentsLowered(values, after_arguments) -> {
              let result = after_arguments.next_value
              checked_flow_emit_call_value(
                graph,
                expression,
                after_arguments,
                ir_inst_semantic_generic_call_i64(
                  result,
                  function,
                  checked_semantic_type_arguments_from(
                    graph,
                    type_arguments,
                    0
                  ),
                  graph.result_type(expression),
                  values
                )
              )
            }
          }
        }
        _ -> CheckedFlowValueRejected(
          CheckedStraightUnsupportedExpression(CheckedGenericCallKind)
        )
      }
    }
    CheckedApplyKind -> match graph.apply_parts(expression) {
      (callee_expression, arguments, signature, source_site) ->
        match checked_flow_lower_expression(
          graph,
          symbols,
          callee_expression,
          state,
          env
        ) {
          CheckedFlowValueRejected(issue) -> CheckedFlowValueRejected(issue)
          CheckedFlowValueTerminated(after_callee) -> CheckedFlowValueTerminated(after_callee)
          CheckedFlowValueLowered(callee, after_callee) ->
            match checked_flow_lower_arguments_from(
              graph,
              symbols,
              arguments,
              0,
              after_callee,
              env
            ) {
              CheckedFlowArgumentsRejected(issue) -> CheckedFlowValueRejected(issue)
              CheckedFlowArgumentsTerminated(after_arguments) ->
                CheckedFlowValueTerminated(after_arguments)
              CheckedFlowArgumentsLowered(values, after_arguments) -> {
                let result = after_arguments.next_value
                checked_flow_emit_call_value(
                  graph,
                  expression,
                  after_arguments,
                  ir_inst_semantic_apply_i64(
                    result,
                    callee.head,
                    signature,
                    source_site,
                    graph.result_type(expression),
                    values
                  )
                )
              }
            }
        }
    }
    CheckedMethodCallKind -> match graph.method_call_parts(expression) {
      (declaration, receiver_expression, arguments, signature) ->
        match checked_flow_lower_expression(
          graph,
          symbols,
          receiver_expression,
          state,
          env
        ) {
          CheckedFlowValueRejected(issue) -> CheckedFlowValueRejected(issue)
          CheckedFlowValueTerminated(after_receiver) ->
            CheckedFlowValueTerminated(after_receiver)
          CheckedFlowValueLowered(receiver, after_receiver) ->
            match checked_flow_lower_arguments_from(
              graph,
              symbols,
              arguments,
              0,
              after_receiver,
              env
            ) {
              CheckedFlowArgumentsRejected(issue) -> CheckedFlowValueRejected(issue)
              CheckedFlowArgumentsTerminated(after_arguments) ->
                CheckedFlowValueTerminated(after_arguments)
              CheckedFlowArgumentsLowered(values, after_arguments) -> {
                let result = after_arguments.next_value
                checked_flow_emit_call_value(
                  graph,
                  expression,
                  after_arguments,
                  ir_inst_semantic_method_call_i64(
                    result,
                    declaration,
                    receiver.head,
                    signature,
                    graph.result_type(expression),
                    values
                  )
                )
              }
            }
        }
    }
    CheckedAssociatedCallKind -> match graph.associated_call_parts(expression) {
      (declaration, target, arguments, signature) -> match checked_flow_lower_arguments_from(
        graph,
        symbols,
        arguments,
        0,
        state,
        env
      ) {
        CheckedFlowArgumentsRejected(issue) -> CheckedFlowValueRejected(issue)
        CheckedFlowArgumentsTerminated(after_arguments) ->
          CheckedFlowValueTerminated(after_arguments)
        CheckedFlowArgumentsLowered(values, after_arguments) -> {
          let result = after_arguments.next_value
          checked_flow_emit_call_value(
            graph,
            expression,
            after_arguments,
            ir_inst_semantic_associated_call_i64(
              result,
              declaration,
              target,
              signature,
              graph.result_type(expression),
              values
            )
          )
        }
      }
    }
    CheckedLambdaKind -> checked_flow_lower_lambda(
      graph,
      symbols,
      expression,
      state,
      env
    )
    CheckedPerformKind -> checked_flow_lower_perform(
      graph,
      symbols,
      expression,
      state,
      env
    )
    CheckedHandleKind -> checked_flow_lower_handle(
      graph,
      symbols,
      expression,
      state,
      env
    )
    CheckedResumeKind -> checked_flow_lower_resume(
      graph,
      symbols,
      expression,
      state,
      env
    )
    CheckedDeclaredFieldAccessKind -> match graph.declared_field_access_parts(expression) {
      (base_expression, declaration, offset) -> match checked_flow_lower_expression(
        graph,
        symbols,
        base_expression,
        state,
        env
      ) {
        CheckedFlowValueRejected(issue) -> CheckedFlowValueRejected(issue)
        CheckedFlowValueTerminated(after_base) -> CheckedFlowValueTerminated(after_base)
        CheckedFlowValueLowered(base, after_base) -> checked_flow_emit_semantic_data_value(
          graph,
          expression,
          after_base,
          IrSemanticDeclaredFieldAccess(declaration, offset),
          base.lanes
        )
      }
    }
    CheckedStructuralFieldAccessKind -> match graph.structural_field_access_parts(expression) {
      (base_expression, stable_key, position) -> match checked_flow_lower_expression(
        graph,
        symbols,
        base_expression,
        state,
        env
      ) {
        CheckedFlowValueRejected(issue) -> CheckedFlowValueRejected(issue)
        CheckedFlowValueTerminated(after_base) -> CheckedFlowValueTerminated(after_base)
        CheckedFlowValueLowered(base, after_base) -> checked_flow_emit_semantic_data_value(
          graph,
          expression,
          after_base,
          IrSemanticStructuralFieldAccess(
            stable_key,
            checked_semantic_structural_field_position(position)
          ),
          base.lanes
        )
      }
    }
    CheckedIndexedLengthKind -> match graph.indexed_length_parts(expression) {
      (base_expression, element_type, length) -> match checked_flow_lower_expression(
        graph,
        symbols,
        base_expression,
        state,
        env
      ) {
        CheckedFlowValueRejected(issue) -> CheckedFlowValueRejected(issue)
        CheckedFlowValueTerminated(after_base) -> CheckedFlowValueTerminated(after_base)
        CheckedFlowValueLowered(base, after_base) -> checked_flow_emit_semantic_data_value(
          graph,
          expression,
          after_base,
          IrSemanticIndexedLength(element_type, length),
          base.lanes
        )
      }
    }
    CheckedIndexedGetKind -> match graph.indexed_get_parts(expression) {
      CheckedIndexedGet(base_expression, index_expression, element_type, length) ->
        match checked_flow_lower_expression(
          graph,
          symbols,
          base_expression,
          state,
          env
        ) {
          CheckedFlowValueRejected(issue) -> CheckedFlowValueRejected(issue)
          CheckedFlowValueTerminated(after_base) -> CheckedFlowValueTerminated(after_base)
          CheckedFlowValueLowered(base, after_base) -> match checked_flow_lower_expression(
            graph,
            symbols,
            index_expression,
            after_base,
            env
          ) {
            CheckedFlowValueRejected(issue) -> CheckedFlowValueRejected(issue)
            CheckedFlowValueTerminated(after_index) -> CheckedFlowValueTerminated(after_index)
            CheckedFlowValueLowered(index, after_index) ->
              checked_flow_emit_semantic_data_value(
                graph,
                expression,
                after_index,
                IrSemanticIndexedGet(element_type, length),
                ir_value_list_append(base.lanes, index.lanes)
              )
          }
        }
    }
    CheckedRecordInitKind -> match graph.record_init_parts(expression) {
      (construction, fields) -> match checked_flow_lower_record_fields_from(
        graph,
        symbols,
        fields,
        0,
        state,
        env
      ) {
        CheckedFlowArgumentsRejected(issue) -> CheckedFlowValueRejected(issue)
        CheckedFlowArgumentsTerminated(after_fields) ->
          CheckedFlowValueTerminated(after_fields)
        CheckedFlowArgumentsLowered(values, after_fields) ->
          checked_flow_emit_semantic_data_value(
            graph,
            expression,
            after_fields,
            IrSemanticRecordInit(
              checked_semantic_record_construction(construction),
              checked_semantic_record_fields_from(graph, fields, 0)
            ),
            values
          )
      }
    }
    CheckedArrayLiteralKind -> match graph.array_literal_parts(expression) {
      (elements, element_type) -> match checked_flow_lower_arguments_from(
        graph,
        symbols,
        elements,
        0,
        state,
        env
      ) {
        CheckedFlowArgumentsRejected(issue) -> CheckedFlowValueRejected(issue)
        CheckedFlowArgumentsTerminated(after_elements) ->
          CheckedFlowValueTerminated(after_elements)
        CheckedFlowArgumentsLowered(values, after_elements) ->
          checked_flow_emit_semantic_data_value(
            graph,
            expression,
            after_elements,
            IrSemanticArrayLiteral(element_type),
            values
          )
      }
    }
    CheckedInterpolationConcatKind -> match graph.interpolation_concat_parts(expression) {
      (left_expression, right_expression) -> match checked_flow_lower_expression(
        graph,
        symbols,
        left_expression,
        state,
        env
      ) {
        CheckedFlowValueRejected(issue) -> CheckedFlowValueRejected(issue)
        CheckedFlowValueTerminated(after_left) -> CheckedFlowValueTerminated(after_left)
        CheckedFlowValueLowered(left, after_left) -> match checked_flow_lower_expression(
          graph,
          symbols,
          right_expression,
          after_left,
          env
        ) {
          CheckedFlowValueRejected(issue) -> CheckedFlowValueRejected(issue)
          CheckedFlowValueTerminated(after_right) -> CheckedFlowValueTerminated(after_right)
          CheckedFlowValueLowered(right, after_right) -> {
            let result = after_right.next_value
            CheckedFlowValueLowered(
              checked_flow_scalar(result),
              checked_flow_emit(
                after_right,
                ir_inst_string_concat_i64(result, left.head, right.head),
                1
              )
            )
          }
        }
      }
    }
    _ -> CheckedFlowValueRejected(CheckedStraightUnsupportedExpression(kind))
  }
}

fn checked_straight_parameters_from(
  product: borrow CheckedBodyProduct,
  function_index: usize,
  position: usize,
  env: CheckedStraightValueEnv,
  next_value: i64,
  catalog: borrow SemanticTypeCatalog,
  substitution: SemanticTypeSubstitution
) -> CheckedStraightParametersResult {
  let graph = product.expressions()
  let function = product.function(function_index)
  if position >= graph.function_parameter_count(function.parameters) {
    CheckedStraightParametersLowered(env, next_value)
  } else {
    let binding = graph.function_parameter(function.parameters, position)
    let parameter = graph.binding(binding)
    match checked_flow_value_word_count(catalog, substitution, parameter.value_type) {
      None -> CheckedStraightParametersRejected(CheckedStraightValueShapeUnavailable)
      Some(0) -> CheckedStraightParametersRejected(CheckedStraightWideValueUnsupported(0))
      Some(words) -> {
        checked_straight_parameters_from(
          product,
          function_index,
          position + 1,
          CheckedStraightValueEnvCons(
            binding,
            CheckedStraightValueHome(checked_flow_value(next_value, words)),
            env
          ),
          next_value + checked_flow_usize_to_i64(words),
          catalog,
          substitution
        )
      }
    }
  }
}

fn lower_checked_straight_function_at_key(
  product: borrow CheckedBodyProduct,
  symbols: borrow CheckedNativeFunctionSymbols,
  function_index: usize,
  key: i64,
  catalog: SemanticTypeCatalog,
  substitution: SemanticTypeSubstitution
) -> CheckedStraightFunctionResult {
  match checked_straight_parameters_from(
    product,
    function_index,
    0,
    CheckedStraightValueEnvNil,
    0,
    catalog,
    substitution
  ) {
    CheckedStraightParametersRejected(issue) -> CheckedStraightFunctionRejected(issue)
    CheckedStraightParametersLowered(env, parameter_lanes) -> {
      let graph = product.expressions()
      let function = product.function(function_index)
      match checked_flow_lower_expression(
        graph,
        symbols,
        function.body,
        CheckedStraightFlowState {
          current_block: 0,
          current_params: ir_value_list_empty(),
          current_insts: ir_inst_list_empty(),
          completed_blocks: ir_block_list_empty(),
          next_block: 1,
          next_value: parameter_lanes,
          loop_targets: CheckedStraightOutsideLoop,
          cleanups: CheckedStraightCleanupNil,
          cleanup_depth: 0,
          function_exit: false,
          catalog: catalog,
          declarations: product.declarations(),
          patterns: product.patterns(),
          closures: product.closures(),
          effects: product.effects(),
          substitution: substitution
        },
        env
      ) {
        CheckedFlowValueRejected(issue) -> CheckedStraightFunctionRejected(issue)
        CheckedFlowValueTerminated(state) -> {
          let source = graph.source()
          CheckedStraightFunctionLowered(
            ir_function_new_blocks_src(
              key,
              parameter_lanes,
              state.completed_blocks,
              __str_ptr(source.text)
            )
          )
        }
        CheckedFlowValueLowered(value, state) -> {
          let source = graph.source()
          let completed = checked_flow_return(
            checked_flow_cleanup_to_depth(state, 0),
            value
          )
          CheckedStraightFunctionLowered(
            ir_function_new_blocks_src(
              key,
              parameter_lanes,
              completed.completed_blocks,
              __str_ptr(source.text)
            )
          )
        }
      }
    }
  }
}

pub(package) fn lower_checked_straight_function_specialization(
  product: borrow CheckedBodyProduct,
  symbols: borrow CheckedNativeFunctionSymbols,
  function_index: usize,
  catalog: SemanticTypeCatalog,
  specialization: CheckedFunctionSpecialization,
  substitution: SemanticTypeSubstitution
) -> CheckedStraightFunctionResult {
  match checked_native_function_symbols_resolve_specialization(
    symbols,
    catalog,
    specialization
  ) {
    None -> CheckedStraightFunctionRejected(
      CheckedStraightFunctionSymbolMissing(specialization.identity)
    )
    Some(key) -> lower_checked_straight_function_at_key(
      product,
      symbols,
      function_index,
      key,
      catalog,
      substitution
    )
  }
}

pub(package) fn lower_checked_straight_function_with_substitution(
  product: borrow CheckedBodyProduct,
  symbols: borrow CheckedNativeFunctionSymbols,
  function_index: usize,
  substitution: SemanticTypeSubstitution
) -> CheckedStraightFunctionResult {
  let function = product.function(function_index)
  let graph = product.expressions()
  let catalog = graph.types()
  match checked_native_function_symbols_resolve(symbols, function.signature.identity) {
    None -> CheckedStraightFunctionRejected(
      CheckedStraightFunctionSymbolMissing(function.signature.identity)
    )
    Some(key) -> lower_checked_straight_function_at_key(
      product,
      symbols,
      function_index,
      key,
      catalog,
      substitution
    )
  }
}

pub(package) fn lower_checked_straight_function(
  product: borrow CheckedBodyProduct,
  symbols: borrow CheckedNativeFunctionSymbols,
  function_index: usize
) -> CheckedStraightFunctionResult {
  lower_checked_straight_function_with_substitution(
    product,
    symbols,
    function_index,
    semantic_type_substitution_empty()
  )
}
