-- Pure straight-line lowering over immutable checked bodies.
--
-- This is the first production-shaped lowering entry that receives no parser
-- node, checker table or source-name lookup. Control flow, aggregate values,
-- effects and ownership cleanup extend this same typed context rather than
-- falling back to the legacy lowering route.

use compiler/ir/data.{*}
use compiler/project/identity.{
  DeclaredFunctionIdentity,
  FunctionIdentity
}
use compiler/types/graph/layout.{semantic_value_word_count}
use compiler/weft/lower/symbols.{
  CheckedNativeFunctionSymbols,
  checked_native_function_symbols_resolve
}
use compiler/weft/check/body/graph.{
  CheckedAdd,
  CheckedBinaryOperator,
  CheckedBindingId,
  CheckedBitAnd,
  CheckedBitOr,
  CheckedBitXor,
  CheckedBlockKind,
  CheckedBooleanKind,
  CheckedDeclarationReferenceKind,
  CheckedDirectCallKind,
  CheckedDivide,
  CheckedEqual,
  CheckedExprGraph,
  CheckedExprId,
  CheckedExprKind,
  CheckedExprListId,
  CheckedGreaterOrEqual,
  CheckedGreaterThan,
  CheckedIfKind,
  CheckedIntegerKind,
  CheckedInterpolationConcatKind,
  CheckedLetKind,
  CheckedLessOrEqual,
  CheckedLessThan,
  CheckedLocalReferenceKind,
  CheckedLogicalAnd,
  CheckedLogicalOr,
  CheckedModulo,
  CheckedMultiply,
  CheckedNegateKind,
  CheckedNilKind,
  CheckedNotEqual,
  CheckedNotKind,
  CheckedShiftLeft,
  CheckedShiftRight,
  CheckedStringKind,
  CheckedSubtract,
  checked_binding_id_eq
}
use compiler/weft/check/body/product.{CheckedBodyProduct}
use stdlib/option.{None, Option, Some}

pub(package) type CheckedStraightLowerIssue {
  CheckedStraightUnsupportedExpression(CheckedExprKind),
  CheckedStraightFunctionSymbolMissing(FunctionIdentity),
  CheckedStraightBindingMissing(CheckedBindingId),
  CheckedStraightValueShapeUnavailable,
  CheckedStraightWideValueUnsupported(usize)
}

pub(package) type CheckedStraightFunctionResult {
  CheckedStraightFunctionLowered(IrFunction),
  CheckedStraightFunctionRejected(CheckedStraightLowerIssue)
}

type CheckedStraightValueEnv {
  CheckedStraightValueEnvNil,
  CheckedStraightValueEnvCons(CheckedBindingId, i64, CheckedStraightValueEnv)
}

type CheckedStraightFlowState {
  current_block: i64,
  current_params: IrValueList,
  current_insts: IrInstList,
  completed_blocks: IrBlockList,
  next_block: i64,
  next_value: i64
}

type CheckedStraightValueResult {
  CheckedStraightValueLowered(i64, i64, IrInstList),
  CheckedStraightValueRejected(CheckedStraightLowerIssue)
}

type CheckedStraightArgumentsResult {
  CheckedStraightArgumentsLowered(IrValueList, i64, IrInstList),
  CheckedStraightArgumentsRejected(CheckedStraightLowerIssue)
}

type CheckedFlowValueResult {
  CheckedFlowValueLowered(i64, CheckedStraightFlowState),
  CheckedFlowValueRejected(CheckedStraightLowerIssue)
}

type CheckedFlowArgumentsResult {
  CheckedFlowArgumentsLowered(IrValueList, CheckedStraightFlowState),
  CheckedFlowArgumentsRejected(CheckedStraightLowerIssue)
}

type CheckedStraightParametersResult {
  CheckedStraightParametersLowered(CheckedStraightValueEnv, i64),
  CheckedStraightParametersRejected(CheckedStraightLowerIssue)
}

pub(package) fn checked_straight_kind_supported(kind: CheckedExprKind) -> bool {
  match kind {
    CheckedIntegerKind -> true
    CheckedBooleanKind -> true
    CheckedNilKind -> true
    CheckedStringKind -> true
    CheckedLocalReferenceKind -> true
    CheckedDeclarationReferenceKind -> true
    CheckedNotKind -> true
    CheckedNegateKind -> true
    CheckedBinaryKind -> true
    CheckedIfKind -> true
    CheckedBlockKind -> true
    CheckedLetKind -> true
    CheckedDirectCallKind -> true
    CheckedInterpolationConcatKind -> true
    _ -> false
  }
}

fn checked_straight_env_find(
  env: CheckedStraightValueEnv,
  binding: CheckedBindingId
) -> Option<i64> {
  match env {
    CheckedStraightValueEnvNil -> None<i64>()
    CheckedStraightValueEnvCons(candidate, value, remaining) -> if checked_binding_id_eq(
      candidate,
      binding
    ) {
      Some<i64>(value)
    } else { checked_straight_env_find(remaining, binding) }
  }
}

fn checked_straight_binary_operator(operator: CheckedBinaryOperator) -> IrBinaryOp {
  match operator {
    CheckedAdd -> IrAdd
    CheckedSubtract -> IrSub
    CheckedMultiply -> IrMul
    CheckedDivide -> IrDiv
    CheckedEqual -> IrEq
    CheckedNotEqual -> IrNe
    CheckedLessThan -> IrLt
    CheckedGreaterThan -> IrGt
    CheckedLessOrEqual -> IrLe
    CheckedGreaterOrEqual -> IrGe
    CheckedModulo -> IrMod
    CheckedLogicalAnd -> IrAnd
    CheckedLogicalOr -> IrOr
    CheckedBitAnd -> IrBand
    CheckedBitOr -> IrBor
    CheckedBitXor -> IrBxor
    CheckedShiftLeft -> IrBshl
    CheckedShiftRight -> IrBshr
  }
}

fn checked_straight_lower_arguments_from(
  graph: borrow CheckedExprGraph,
  symbols: borrow CheckedNativeFunctionSymbols,
  arguments: CheckedExprListId,
  position: usize,
  next_value: i64,
  env: CheckedStraightValueEnv
) -> CheckedStraightArgumentsResult {
  if position >= graph.expression_list_len(arguments) {
    CheckedStraightArgumentsLowered(ir_value_list_empty(), next_value, ir_inst_list_empty())
  } else {
    match checked_straight_lower_expression(
      graph,
      symbols,
      graph.expression_list_at(arguments, position),
      next_value,
      env
    ) {
      CheckedStraightValueRejected(issue) -> CheckedStraightArgumentsRejected(issue)
      CheckedStraightValueLowered(value, after_value, value_insts) ->
        match
        checked_straight_lower_arguments_from(
          graph,
          symbols,
          arguments,
          position + 1,
          after_value,
          env
        ) {
          CheckedStraightArgumentsRejected(issue) -> CheckedStraightArgumentsRejected(issue)
          CheckedStraightArgumentsLowered(values, after_arguments, argument_insts) ->
            CheckedStraightArgumentsLowered(
              ir_value_list_prepend(value, values),
              after_arguments,
              ir_inst_list_append(value_insts, argument_insts)
            )
        }
    }
  }
}

fn checked_straight_lower_expression(
  graph: borrow CheckedExprGraph,
  symbols: borrow CheckedNativeFunctionSymbols,
  expression: CheckedExprId,
  next_value: i64,
  env: CheckedStraightValueEnv
) -> CheckedStraightValueResult {
  let kind = graph.kind(expression)
  match kind {
    CheckedIntegerKind -> CheckedStraightValueLowered(
      next_value,
      next_value + 1,
      ir_inst_list_prepend(
        ir_inst_const_i64(next_value, graph.integer_value(expression)),
        ir_inst_list_empty()
      )
    )
    CheckedBooleanKind -> CheckedStraightValueLowered(
      next_value,
      next_value + 1,
      ir_inst_list_prepend(
        ir_inst_const_i64(next_value, graph.boolean_value(expression)),
        ir_inst_list_empty()
      )
    )
    CheckedNilKind -> CheckedStraightValueLowered(
      next_value,
      next_value + 1,
      ir_inst_list_prepend(ir_inst_nil_i64(next_value), ir_inst_list_empty())
    )
    CheckedStringKind -> {
      let value = graph.string_value(expression)
      CheckedStraightValueLowered(
        next_value,
        next_value + 1,
        ir_inst_list_prepend(
          ir_inst_string_lit(next_value, __str_ptr(value), 0, __str_len(value)),
          ir_inst_list_empty()
        )
      )
    }
    CheckedLocalReferenceKind -> match checked_straight_env_find(
      env,
      graph.local_binding(expression)
    ) {
      Some(value) -> CheckedStraightValueLowered(value, next_value, ir_inst_list_empty())
      None -> CheckedStraightValueRejected(
        CheckedStraightBindingMissing(graph.local_binding(expression))
      )
    }
    CheckedDeclarationReferenceKind -> match checked_native_function_symbols_resolve(
      symbols,
      DeclaredFunctionIdentity(graph.declaration(expression))
    ) {
      Some(key) -> CheckedStraightValueLowered(
        next_value,
        next_value + 1,
        ir_inst_list_prepend(
          ir_inst_function_ref_i64(next_value, key),
          ir_inst_list_empty()
        )
      )
      None -> CheckedStraightValueRejected(
        CheckedStraightFunctionSymbolMissing(
          DeclaredFunctionIdentity(graph.declaration(expression))
        )
      )
    }
    CheckedNotKind -> match checked_straight_lower_expression(
      graph,
      symbols,
      graph.not_operand(expression),
      next_value,
      env
    ) {
      CheckedStraightValueRejected(issue) -> CheckedStraightValueRejected(issue)
      CheckedStraightValueLowered(value, after_value, insts) -> CheckedStraightValueLowered(
        after_value,
        after_value + 1,
        ir_inst_list_append(
          insts,
          ir_inst_list_prepend(
            ir_inst_unary_i64(after_value, ir_unary_op_not(), value),
            ir_inst_list_empty()
          )
        )
      )
    }
    CheckedNegateKind -> match checked_straight_lower_expression(
      graph,
      symbols,
      graph.negate_operand(expression),
      next_value,
      env
    ) {
      CheckedStraightValueRejected(issue) -> CheckedStraightValueRejected(issue)
      CheckedStraightValueLowered(value, after_value, insts) -> CheckedStraightValueLowered(
        after_value + 1,
        after_value + 2,
        ir_inst_list_append(
          insts,
          ir_inst_list_prepend(
            ir_inst_const_i64(after_value, 0),
            ir_inst_list_prepend(
              ir_inst_binary_i64(after_value + 1, IrSub, after_value, value),
              ir_inst_list_empty()
            )
          )
        )
      )
    }
    CheckedBinaryKind -> match checked_straight_lower_expression(
      graph,
      symbols,
      graph.binary_left(expression),
      next_value,
      env
    ) {
      CheckedStraightValueRejected(issue) -> CheckedStraightValueRejected(issue)
      CheckedStraightValueLowered(left, after_left, left_insts) ->
        match
        checked_straight_lower_expression(
          graph,
          symbols,
          graph.binary_right(expression),
          after_left,
          env
        ) {
          CheckedStraightValueRejected(issue) -> CheckedStraightValueRejected(issue)
          CheckedStraightValueLowered(right, after_right, right_insts) ->
            CheckedStraightValueLowered(
              after_right,
              after_right + 1,
              ir_inst_list_append(
                left_insts,
                ir_inst_list_append(
                  right_insts,
                  ir_inst_list_prepend(
                    ir_inst_binary_i64(
                      after_right,
                      checked_straight_binary_operator(graph.binary_operator(expression)),
                      left,
                      right
                    ),
                    ir_inst_list_empty()
                  )
                )
              )
            )
        }
    }
    CheckedBlockKind -> match checked_straight_lower_expression(
      graph,
      symbols,
      graph.block_first(expression),
      next_value,
      env
    ) {
      CheckedStraightValueRejected(issue) -> CheckedStraightValueRejected(issue)
      CheckedStraightValueLowered(_, after_first, first_insts) ->
        match
        checked_straight_lower_expression(
          graph,
          symbols,
          graph.block_rest(expression),
          after_first,
          env
        ) {
          CheckedStraightValueRejected(issue) -> CheckedStraightValueRejected(issue)
          CheckedStraightValueLowered(value, after_rest, rest_insts) ->
            CheckedStraightValueLowered(
              value,
              after_rest,
              ir_inst_list_append(first_insts, rest_insts)
            )
        }
    }
    CheckedLetKind -> match graph.let_parts(expression) {
      (binding, value_expression, body) -> match checked_straight_lower_expression(
        graph,
        symbols,
        value_expression,
        next_value,
        env
      ) {
        CheckedStraightValueRejected(issue) -> CheckedStraightValueRejected(issue)
        CheckedStraightValueLowered(value, after_value, value_insts) ->
          match
          checked_straight_lower_expression(
            graph,
            symbols,
            body,
            after_value,
            CheckedStraightValueEnvCons(binding, value, env)
          ) {
            CheckedStraightValueRejected(issue) -> CheckedStraightValueRejected(issue)
            CheckedStraightValueLowered(result, after_body, body_insts) ->
              CheckedStraightValueLowered(
                result,
                after_body,
                ir_inst_list_append(value_insts, body_insts)
              )
          }
      }
    }
    CheckedDirectCallKind -> match graph.direct_call_parts(expression) {
      (function, arguments) -> match checked_native_function_symbols_resolve(
        symbols,
        function
      ) {
        None -> CheckedStraightValueRejected(
          CheckedStraightFunctionSymbolMissing(function)
        )
        Some(key) -> match checked_straight_lower_arguments_from(
          graph,
          symbols,
          arguments,
          0,
          next_value,
          env
        ) {
          CheckedStraightArgumentsRejected(issue) -> CheckedStraightValueRejected(issue)
          CheckedStraightArgumentsLowered(values, after_arguments, insts) ->
            CheckedStraightValueLowered(
              after_arguments,
              after_arguments + 1,
              ir_inst_list_append(
                insts,
                ir_inst_list_prepend(
                  ir_inst_call_i64(after_arguments, key, values),
                  ir_inst_list_empty()
                )
              )
            )
        }
      }
    }
    CheckedInterpolationConcatKind -> match graph.interpolation_concat_parts(expression) {
      (left_expression, right_expression) -> match checked_straight_lower_expression(
        graph,
        symbols,
        left_expression,
        next_value,
        env
      ) {
        CheckedStraightValueRejected(issue) -> CheckedStraightValueRejected(issue)
        CheckedStraightValueLowered(left, after_left, left_insts) ->
          match
          checked_straight_lower_expression(
            graph,
            symbols,
            right_expression,
            after_left,
            env
          ) {
            CheckedStraightValueRejected(issue) -> CheckedStraightValueRejected(issue)
            CheckedStraightValueLowered(right, after_right, right_insts) ->
              CheckedStraightValueLowered(
                after_right,
                after_right + 1,
                ir_inst_list_append(
                  left_insts,
                  ir_inst_list_append(
                    right_insts,
                    ir_inst_list_prepend(
                      ir_inst_string_concat_i64(after_right, left, right),
                      ir_inst_list_empty()
                    )
                  )
                )
              )
          }
      }
    }
    _ -> CheckedStraightValueRejected(CheckedStraightUnsupportedExpression(kind))
  }
}

fn checked_flow_emit(
  state: CheckedStraightFlowState,
  instruction: IrInst,
  consumed_values: i64
) -> CheckedStraightFlowState {
  CheckedStraightFlowState {
    current_block: state.current_block,
    current_params: state.current_params,
    current_insts: ir_inst_list_append(
      state.current_insts,
      ir_inst_list_prepend(instruction, ir_inst_list_empty())
    ),
    completed_blocks: state.completed_blocks,
    next_block: state.next_block,
    next_value: state.next_value + consumed_values
  }
}

fn checked_flow_close(
  state: CheckedStraightFlowState,
  terminator: IrTerminator
) -> CheckedStraightFlowState {
  CheckedStraightFlowState {
    current_block: 0 - 1,
    current_params: ir_value_list_empty(),
    current_insts: ir_inst_list_empty(),
    completed_blocks: ir_block_list_append(
      state.completed_blocks,
      ir_block_list_prepend(
        ir_block_new_params(
          state.current_block,
          state.current_params,
          state.current_insts,
          terminator
        ),
        ir_block_list_empty()
      )
    ),
    next_block: state.next_block,
    next_value: state.next_value
  }
}

fn checked_flow_open(
  state: CheckedStraightFlowState,
  block: i64,
  parameters: IrValueList
) -> CheckedStraightFlowState {
  CheckedStraightFlowState {
    current_block: block,
    current_params: parameters,
    current_insts: ir_inst_list_empty(),
    completed_blocks: state.completed_blocks,
    next_block: state.next_block,
    next_value: state.next_value
  }
}

fn checked_flow_lower_arguments_from(
  graph: borrow CheckedExprGraph,
  symbols: borrow CheckedNativeFunctionSymbols,
  arguments: CheckedExprListId,
  position: usize,
  state: CheckedStraightFlowState,
  env: CheckedStraightValueEnv
) -> CheckedFlowArgumentsResult {
  if position >= graph.expression_list_len(arguments) {
    CheckedFlowArgumentsLowered(ir_value_list_empty(), state)
  } else {
    match checked_flow_lower_expression(
      graph,
      symbols,
      graph.expression_list_at(arguments, position),
      state,
      env
    ) {
      CheckedFlowValueRejected(issue) -> CheckedFlowArgumentsRejected(issue)
      CheckedFlowValueLowered(value, after_value) ->
        match checked_flow_lower_arguments_from(
          graph,
          symbols,
          arguments,
          position + 1,
          after_value,
          env
        ) {
          CheckedFlowArgumentsRejected(issue) -> CheckedFlowArgumentsRejected(issue)
          CheckedFlowArgumentsLowered(values, after_arguments) ->
            CheckedFlowArgumentsLowered(
              ir_value_list_prepend(value, values),
              after_arguments
            )
        }
    }
  }
}

fn checked_flow_lower_if(
  graph: borrow CheckedExprGraph,
  symbols: borrow CheckedNativeFunctionSymbols,
  expression: CheckedExprId,
  state: CheckedStraightFlowState,
  env: CheckedStraightValueEnv
) -> CheckedFlowValueResult {
  let catalog = graph.types()
  match semantic_value_word_count(catalog, graph.result_type(expression)) {
    None -> CheckedFlowValueRejected(CheckedStraightValueShapeUnavailable)
    Some(words) -> if words != 1 {
      CheckedFlowValueRejected(CheckedStraightWideValueUnsupported(words))
    } else {
      match checked_flow_lower_expression(
        graph,
        symbols,
        graph.if_condition(expression),
        state,
        env
      ) {
        CheckedFlowValueRejected(issue) -> CheckedFlowValueRejected(issue)
        CheckedFlowValueLowered(condition, after_condition) -> {
          let then_block = after_condition.next_block
          let else_block = then_block + 1
          let join_block = then_block + 2
          let branched = checked_flow_close(
            CheckedStraightFlowState {
              current_block: after_condition.current_block,
              current_params: after_condition.current_params,
              current_insts: after_condition.current_insts,
              completed_blocks: after_condition.completed_blocks,
              next_block: join_block + 1,
              next_value: after_condition.next_value
            },
            ir_term_branch(condition, then_block, else_block)
          )
          match checked_flow_lower_expression(
            graph,
            symbols,
            graph.if_then(expression),
            checked_flow_open(branched, then_block, ir_value_list_empty()),
            env
          ) {
            CheckedFlowValueRejected(issue) -> CheckedFlowValueRejected(issue)
            CheckedFlowValueLowered(then_value, after_then) -> {
              let closed_then = checked_flow_close(
                after_then,
                ir_term_jump_args(
                  join_block,
                  ir_value_list_prepend(then_value, ir_value_list_empty())
                )
              )
              match checked_flow_lower_expression(
                graph,
                symbols,
                graph.if_else(expression),
                checked_flow_open(closed_then, else_block, ir_value_list_empty()),
                env
              ) {
                CheckedFlowValueRejected(issue) -> CheckedFlowValueRejected(issue)
                CheckedFlowValueLowered(else_value, after_else) -> {
                  let closed_else = checked_flow_close(
                    after_else,
                    ir_term_jump_args(
                      join_block,
                      ir_value_list_prepend(else_value, ir_value_list_empty())
                    )
                  )
                  let result = closed_else.next_value
                  CheckedFlowValueLowered(
                    result,
                    checked_flow_open(
                      CheckedStraightFlowState {
                        current_block: closed_else.current_block,
                        current_params: closed_else.current_params,
                        current_insts: closed_else.current_insts,
                        completed_blocks: closed_else.completed_blocks,
                        next_block: closed_else.next_block,
                        next_value: result + 1
                      },
                      join_block,
                      ir_value_list_prepend(result, ir_value_list_empty())
                    )
                  )
                }
              }
            }
          }
        }
      }
    }
  }
}

fn checked_flow_lower_expression(
  graph: borrow CheckedExprGraph,
  symbols: borrow CheckedNativeFunctionSymbols,
  expression: CheckedExprId,
  state: CheckedStraightFlowState,
  env: CheckedStraightValueEnv
) -> CheckedFlowValueResult {
  let kind = graph.kind(expression)
  match kind {
    CheckedIntegerKind -> {
      let result = state.next_value
      CheckedFlowValueLowered(
        result,
        checked_flow_emit(
          state,
          ir_inst_const_i64(result, graph.integer_value(expression)),
          1
        )
      )
    }
    CheckedBooleanKind -> {
      let result = state.next_value
      CheckedFlowValueLowered(
        result,
        checked_flow_emit(
          state,
          ir_inst_const_i64(result, graph.boolean_value(expression)),
          1
        )
      )
    }
    CheckedNilKind -> {
      let result = state.next_value
      CheckedFlowValueLowered(
        result,
        checked_flow_emit(state, ir_inst_nil_i64(result), 1)
      )
    }
    CheckedStringKind -> {
      let result = state.next_value
      let value = graph.string_value(expression)
      CheckedFlowValueLowered(
        result,
        checked_flow_emit(
          state,
          ir_inst_string_lit(result, __str_ptr(value), 0, __str_len(value)),
          1
        )
      )
    }
    CheckedLocalReferenceKind -> match checked_straight_env_find(
      env,
      graph.local_binding(expression)
    ) {
      Some(value) -> CheckedFlowValueLowered(value, state)
      None -> CheckedFlowValueRejected(
        CheckedStraightBindingMissing(graph.local_binding(expression))
      )
    }
    CheckedDeclarationReferenceKind -> match checked_native_function_symbols_resolve(
      symbols,
      DeclaredFunctionIdentity(graph.declaration(expression))
    ) {
      None -> CheckedFlowValueRejected(
        CheckedStraightFunctionSymbolMissing(
          DeclaredFunctionIdentity(graph.declaration(expression))
        )
      )
      Some(key) -> {
        let result = state.next_value
        CheckedFlowValueLowered(
          result,
          checked_flow_emit(state, ir_inst_function_ref_i64(result, key), 1)
        )
      }
    }
    CheckedNotKind -> match checked_flow_lower_expression(
      graph,
      symbols,
      graph.not_operand(expression),
      state,
      env
    ) {
      CheckedFlowValueRejected(issue) -> CheckedFlowValueRejected(issue)
      CheckedFlowValueLowered(value, after_value) -> {
        let result = after_value.next_value
        CheckedFlowValueLowered(
          result,
          checked_flow_emit(
            after_value,
            ir_inst_unary_i64(result, ir_unary_op_not(), value),
            1
          )
        )
      }
    }
    CheckedNegateKind -> match checked_flow_lower_expression(
      graph,
      symbols,
      graph.negate_operand(expression),
      state,
      env
    ) {
      CheckedFlowValueRejected(issue) -> CheckedFlowValueRejected(issue)
      CheckedFlowValueLowered(value, after_value) -> {
        let zero = after_value.next_value
        let result = zero + 1
        let with_zero = checked_flow_emit(
          after_value,
          ir_inst_const_i64(zero, 0),
          1
        )
        CheckedFlowValueLowered(
          result,
          checked_flow_emit(
            with_zero,
            ir_inst_binary_i64(result, IrSub, zero, value),
            1
          )
        )
      }
    }
    CheckedBinaryKind -> match checked_flow_lower_expression(
      graph,
      symbols,
      graph.binary_left(expression),
      state,
      env
    ) {
      CheckedFlowValueRejected(issue) -> CheckedFlowValueRejected(issue)
      CheckedFlowValueLowered(left, after_left) -> match checked_flow_lower_expression(
        graph,
        symbols,
        graph.binary_right(expression),
        after_left,
        env
      ) {
        CheckedFlowValueRejected(issue) -> CheckedFlowValueRejected(issue)
        CheckedFlowValueLowered(right, after_right) -> {
          let result = after_right.next_value
          CheckedFlowValueLowered(
            result,
            checked_flow_emit(
              after_right,
              ir_inst_binary_i64(
                result,
                checked_straight_binary_operator(graph.binary_operator(expression)),
                left,
                right
              ),
              1
            )
          )
        }
      }
    }
    CheckedIfKind -> checked_flow_lower_if(graph, symbols, expression, state, env)
    CheckedBlockKind -> match checked_flow_lower_expression(
      graph,
      symbols,
      graph.block_first(expression),
      state,
      env
    ) {
      CheckedFlowValueRejected(issue) -> CheckedFlowValueRejected(issue)
      CheckedFlowValueLowered(_, after_first) -> checked_flow_lower_expression(
        graph,
        symbols,
        graph.block_rest(expression),
        after_first,
        env
      )
    }
    CheckedLetKind -> match graph.let_parts(expression) {
      (binding, value_expression, body) -> match checked_flow_lower_expression(
        graph,
        symbols,
        value_expression,
        state,
        env
      ) {
        CheckedFlowValueRejected(issue) -> CheckedFlowValueRejected(issue)
        CheckedFlowValueLowered(value, after_value) -> checked_flow_lower_expression(
          graph,
          symbols,
          body,
          after_value,
          CheckedStraightValueEnvCons(binding, value, env)
        )
      }
    }
    CheckedDirectCallKind -> match graph.direct_call_parts(expression) {
      (function, arguments) -> match checked_native_function_symbols_resolve(
        symbols,
        function
      ) {
        None -> CheckedFlowValueRejected(CheckedStraightFunctionSymbolMissing(function))
        Some(key) -> match checked_flow_lower_arguments_from(
          graph,
          symbols,
          arguments,
          0,
          state,
          env
        ) {
          CheckedFlowArgumentsRejected(issue) -> CheckedFlowValueRejected(issue)
          CheckedFlowArgumentsLowered(values, after_arguments) -> {
            let result = after_arguments.next_value
            CheckedFlowValueLowered(
              result,
              checked_flow_emit(
                after_arguments,
                ir_inst_call_i64(result, key, values),
                1
              )
            )
          }
        }
      }
    }
    CheckedInterpolationConcatKind -> match graph.interpolation_concat_parts(expression) {
      (left_expression, right_expression) -> match checked_flow_lower_expression(
        graph,
        symbols,
        left_expression,
        state,
        env
      ) {
        CheckedFlowValueRejected(issue) -> CheckedFlowValueRejected(issue)
        CheckedFlowValueLowered(left, after_left) -> match checked_flow_lower_expression(
          graph,
          symbols,
          right_expression,
          after_left,
          env
        ) {
          CheckedFlowValueRejected(issue) -> CheckedFlowValueRejected(issue)
          CheckedFlowValueLowered(right, after_right) -> {
            let result = after_right.next_value
            CheckedFlowValueLowered(
              result,
              checked_flow_emit(
                after_right,
                ir_inst_string_concat_i64(result, left, right),
                1
              )
            )
          }
        }
      }
    }
    _ -> CheckedFlowValueRejected(CheckedStraightUnsupportedExpression(kind))
  }
}

fn checked_straight_parameters_from(
  product: borrow CheckedBodyProduct,
  function_index: usize,
  position: usize,
  env: CheckedStraightValueEnv,
  next_value: i64
) -> CheckedStraightParametersResult {
  let graph = product.expressions()
  let function = product.function(function_index)
  if position >= graph.function_parameter_count(function.parameters) {
    CheckedStraightParametersLowered(env, next_value)
  } else {
    let binding = graph.function_parameter(function.parameters, position)
    let parameter = graph.binding(binding)
    let types = graph.types()
    match semantic_value_word_count(types, parameter.value_type) {
      None -> CheckedStraightParametersRejected(CheckedStraightValueShapeUnavailable)
      Some(words) -> if words != 1 {
        CheckedStraightParametersRejected(CheckedStraightWideValueUnsupported(words))
      } else {
        checked_straight_parameters_from(
          product,
          function_index,
          position + 1,
          CheckedStraightValueEnvCons(binding, next_value, env),
          next_value + 1
        )
      }
    }
  }
}

pub(package) fn lower_checked_straight_function(
  product: borrow CheckedBodyProduct,
  symbols: borrow CheckedNativeFunctionSymbols,
  function_index: usize
) -> CheckedStraightFunctionResult {
  let function = product.function(function_index)
  match checked_native_function_symbols_resolve(symbols, function.signature.identity) {
    None -> CheckedStraightFunctionRejected(
      CheckedStraightFunctionSymbolMissing(function.signature.identity)
    )
    Some(key) -> match checked_straight_parameters_from(
      product,
      function_index,
      0,
      CheckedStraightValueEnvNil,
      0
    ) {
      CheckedStraightParametersRejected(issue) -> CheckedStraightFunctionRejected(issue)
      CheckedStraightParametersLowered(env, parameter_lanes) -> {
        let graph = product.expressions()
        match checked_flow_lower_expression(
          graph,
          symbols,
          function.body,
          CheckedStraightFlowState {
            current_block: 0,
            current_params: ir_value_list_empty(),
            current_insts: ir_inst_list_empty(),
            completed_blocks: ir_block_list_empty(),
            next_block: 1,
            next_value: parameter_lanes
          },
          env
        ) {
          CheckedFlowValueRejected(issue) -> CheckedStraightFunctionRejected(issue)
          CheckedFlowValueLowered(value, state) -> {
            let source = graph.source()
            let completed = checked_flow_close(state, ir_term_return(value))
            CheckedStraightFunctionLowered(
              ir_function_new_blocks_src(
                key,
                parameter_lanes,
                completed.completed_blocks,
                __str_ptr(source.text)
              )
            )
          }
        }
      }
    }
  }
}
