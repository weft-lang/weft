type CheckedSpecializationRequest {
  identity: FunctionIdentity,
  type_arguments: List<SemanticTypeId>,
  call_signature: Option<SemanticTypeId>,
  method_declaration: Option<DeclarationIdentity>,
  dispatch_target: Option<SemanticTypeId>
}

type CheckedSpecializationRecordProjection {
  base: i64,
  record_words: usize,
  field_key: i64,
  field_word: usize,
  field_words: usize,
  remaining: IrInstList
}

type CheckedSpecializationPending {
  specialization: CheckedFunctionSpecialization,
  product: CheckedBodyProduct,
  function_index: usize,
  substitution: SemanticTypeSubstitution
}

type CheckedSpecializationFunction {
  product: CheckedBodyProduct,
  function_index: usize
}

type CheckedSpecializationUniverse {
  catalog: SemanticTypeCatalog,
  conformances: SemanticConformanceCatalog,
  methods: SemanticMethodCatalog,
  bodies: List<CheckedBodyProduct>
}

type CheckedSpecializationPlanner {
  types: SemanticTypeProductBuilder,
  symbols: CheckedNativeFunctionSymbols,
  pending: List<CheckedSpecializationPending>,
  instances: List<CheckedFunctionSpecialization>,
  functions: List<IrFunction>,
  next_key: i64
}

pub(package) type CheckedSpecializationPlan {
  catalog: SemanticTypeCatalog,
  symbols: CheckedNativeFunctionSymbols,
  instances: List<CheckedFunctionSpecialization>,
  functions: List<IrFunction>
}

pub(package) type CheckedSpecializationIssue {
  CheckedSpecializationFunctionMissing(FunctionIdentity),
  CheckedSpecializationTypeArgumentCount(FunctionIdentity, usize, usize),
  CheckedSpecializationLoweringRejected(
    CheckedFunctionSpecialization,
    CheckedStraightLowerIssue
  ),
  CheckedSpecializationCallSignatureMismatch(FunctionIdentity),
  CheckedSpecializationLayoutUnavailable(SemanticTypeId),
  CheckedSpecializationRewriteMismatch
}

pub(package) type CheckedSpecializationResult {
  CheckedSpecializationAccepted(CheckedSpecializationPlan),
  CheckedSpecializationRejected(CheckedSpecializationIssue)
}

type CheckedSpecializationRequestsResult {
  CheckedSpecializationRequestsAccepted(CheckedSpecializationPlanner, List<i64>),
  CheckedSpecializationRequestsRejected(CheckedSpecializationIssue)
}

type CheckedSpecializationArguments {
  types: SemanticTypeProductBuilder,
  values: List<SemanticTypeId>
}

type CheckedSpecializationPreparedRequest {
  types: SemanticTypeProductBuilder,
  identity: FunctionIdentity,
  arguments: List<SemanticTypeId>,
  concrete_signature: Option<SemanticTypeId>,
  method_substitution: Option<SemanticTypeSubstitution>
}

type CheckedSpecializationBoundSubstitution {
  types: SemanticTypeProductBuilder,
  substitution: SemanticTypeSubstitution
}

type CheckedSpecializationRewrite {
  CheckedSpecializationRewritten(IrFunction, List<i64>),
  CheckedSpecializationRewriteRejected
}

type CheckedSpecializationLegalize {
  CheckedSpecializationLegalized(IrFunction),
  CheckedSpecializationLegalizeRejected(SemanticTypeId)
}

type CheckedSpecializationConstructor {
  CheckedSpecializationConstructorConcrete(IrInst),
  CheckedSpecializationConstructorResidual
}

type CheckedSpecializationVariantMask {
  CheckedSpecializationVariantMaskValue(i64, usize),
  CheckedSpecializationVariantMaskRejected
}

fn checked_specialization_function_parameter_count(
  catalog: borrow SemanticTypeCatalog,
  function_type: SemanticTypeId
) -> usize {
  match catalog.graph_for(function_type) {
    Some(graph) -> match semantic_type_graph_node(graph, function_type) {
      SemanticFunctionNode(parameters, _, _) -> {
        let lists = semantic_type_graph_type_lists_local(graph)
        semantic_type_list_len(lists, parameters)
      }
      SemanticContinuationNode(_, _) -> {
        let one: usize = 1
        one
      }
      _ -> {
        let zero: usize = 0
        zero
      }
    }
    None -> {
      let zero: usize = 0
      zero
    }
  }
}

fn checked_specialization_function_parameter(
  catalog: borrow SemanticTypeCatalog,
  function_type: SemanticTypeId,
  index: usize
) -> Option<SemanticTypeId> {
  match catalog.graph_for(function_type) {
    Some(graph) -> match semantic_type_graph_node(graph, function_type) {
      SemanticFunctionNode(parameters, _, _) -> {
        let lists = semantic_type_graph_type_lists_local(graph)
        if index >= semantic_type_list_len(lists, parameters) {
          None<SemanticTypeId>()
        } else {
          Some<SemanticTypeId>(
            semantic_type_graph_list_type_id(
              graph,
              semantic_type_list_edge(
                lists,
                parameters,
                index
              )
            )
          )
        }
      }
      SemanticContinuationNode(input, _) -> if index == 0 {
        Some<SemanticTypeId>(input)
      } else { None<SemanticTypeId>() }
      _ -> None<SemanticTypeId>()
    }
    None -> None<SemanticTypeId>()
  }
}

fn checked_specialization_requests_in_insts(
  instructions: IrInstList
) -> List<CheckedSpecializationRequest> {
  match instructions {
    IrInstNil -> Nil<CheckedSpecializationRequest>()
    IrInstCons(instruction, remaining) -> {
      let rest = checked_specialization_requests_in_insts(remaining)
      match instruction {
        IrSemanticCallI64(_, IrSemanticGenericTarget(identity, arguments), _, _) ->
          rest.prepend(
            CheckedSpecializationRequest {
              identity: identity,
              type_arguments: arguments,
              call_signature: None<SemanticTypeId>(),
              method_declaration: None<DeclarationIdentity>(),
              dispatch_target: None<SemanticTypeId>()
            }
          )
        IrSemanticCallI64(
          _,
          IrSemanticMethodTarget(declaration, _, signature),
          _,
          _,
        ) -> rest.prepend(
          CheckedSpecializationRequest {
            identity: DeclaredFunctionIdentity(declaration),
            type_arguments: Nil<SemanticTypeId>(),
            call_signature: Some<SemanticTypeId>(signature),
            method_declaration: Some<DeclarationIdentity>(declaration),
            dispatch_target: None<SemanticTypeId>()
          }
        )
        IrSemanticCallI64(
          _,
          IrSemanticAssociatedTarget(declaration, target, signature),
          _,
          _,
        ) -> rest.prepend(
          CheckedSpecializationRequest {
            identity: DeclaredFunctionIdentity(declaration),
            type_arguments: Nil<SemanticTypeId>(),
            call_signature: Some<SemanticTypeId>(signature),
            method_declaration: Some<DeclarationIdentity>(declaration),
            dispatch_target: Some<SemanticTypeId>(target)
          }
        )
        IrSemanticCallI64(_, IrSemanticHandleTarget(handler), _, _) ->
          checked_specialization_requests_in_handler(handler).concat(rest)
        IrSemanticDataI64(
          _,
          IrSemanticFunctionReference(identity, arguments),
          _,
          _,
        ) -> rest.prepend(
          CheckedSpecializationRequest {
            identity: identity,
            type_arguments: arguments,
            call_signature: None<SemanticTypeId>(),
            method_declaration: None<DeclarationIdentity>(),
            dispatch_target: None<SemanticTypeId>()
          }
        )
        IrSemanticDataI64(
          _,
          IrSemanticClosure(function, _, _, _, _),
          _,
          _,
        ) -> checked_specialization_requests(function).concat(rest)
        IrSemanticDataI64(
          _,
          IrSemanticSpecializedClosure(function, _, _, _, _, _),
          _,
          _,
        ) -> checked_specialization_requests(function).concat(rest)
        _ -> rest
      }
    }
  }
}

fn checked_specialization_requests_in_handler_clauses(
  clauses: IrSemanticHandlerClauseList
) -> List<CheckedSpecializationRequest> {
  match clauses {
    IrSemanticHandlerClauseNil -> Nil<CheckedSpecializationRequest>()
    IrSemanticHandlerClauseCons(clause, remaining) ->
      checked_specialization_requests(clause.body).concat(
        checked_specialization_requests_in_handler_clauses(remaining)
      )
  }
}

fn checked_specialization_requests_in_handler_return(
  returned: IrSemanticHandleReturn
) -> List<CheckedSpecializationRequest> {
  match returned {
    IrSemanticNoHandleReturn -> Nil<CheckedSpecializationRequest>()
    IrSemanticHandleReturnTransform(_, function) ->
      checked_specialization_requests(function)
  }
}

fn checked_specialization_requests_in_handler(
  handler: IrSemanticHandler
) -> List<CheckedSpecializationRequest> {
  let body = checked_specialization_requests(handler.body)
  let clauses = checked_specialization_requests_in_handler_clauses(handler.clauses)
  let returned = checked_specialization_requests_in_handler_return(handler.return_clause)
  body.concat(clauses).concat(returned)
}

fn checked_specialization_requests_in_blocks(
  blocks: IrBlockList
) -> List<CheckedSpecializationRequest> {
  match blocks {
    IrBlockListNil -> Nil<CheckedSpecializationRequest>()
    IrBlockListCons(IrBlock(_, _, instructions, _), remaining) -> {
      let current = checked_specialization_requests_in_insts(instructions)
      current.concat(checked_specialization_requests_in_blocks(remaining))
    }
  }
}

fn checked_specialization_requests(
  function: IrFunction
) -> List<CheckedSpecializationRequest> {
  match function {
    IrFunction(_, _, blocks, _) -> checked_specialization_requests_in_blocks(blocks)
  }
}

fn checked_specialization_rewrite_function_with_keys(
  function: IrFunction,
  keys: List<i64>
) -> (IrFunction, List<i64>, bool) {
  match function {
    IrFunction(key, parameters, blocks, source) ->
      match checked_specialization_rewrite_blocks(blocks, keys) {
        (rewritten, remaining, valid) -> (
          IrFunction(key, parameters, rewritten, source),
          remaining,
          valid
        )
      }
  }
}

fn checked_specialization_rewrite_handler_clauses(
  clauses: IrSemanticHandlerClauseList,
  keys: List<i64>
) -> (IrSemanticHandlerClauseList, List<i64>, bool) {
  match clauses {
    IrSemanticHandlerClauseNil -> (IrSemanticHandlerClauseNil, keys, true)
    IrSemanticHandlerClauseCons(clause, remaining) ->
      match checked_specialization_rewrite_function_with_keys(clause.body, keys) {
        (body, after_body, body_valid) ->
          match checked_specialization_rewrite_handler_clauses(
            remaining,
            after_body
          ) {
            (rest, final_keys, rest_valid) -> (
              IrSemanticHandlerClauseCons(
                IrSemanticHandlerClause {
                  effect_declaration: clause.effect_declaration,
                  operation: clause.operation,
                  atom: clause.atom,
                  parameters: clause.parameters,
                  parameter_words: clause.parameter_words,
                  captures: clause.captures,
                  capture_values: clause.capture_values,
                  capture_words: clause.capture_words,
                  continuation: clause.continuation,
                  completion: clause.completion,
                  result_type: clause.result_type,
                  body: body
                },
                rest
              ),
              final_keys,
              body_valid and rest_valid
            )
          }
      }
  }
}

fn checked_specialization_rewrite_handler_return(
  returned: IrSemanticHandleReturn,
  keys: List<i64>
) -> (IrSemanticHandleReturn, List<i64>, bool) {
  match returned {
    IrSemanticNoHandleReturn -> (IrSemanticNoHandleReturn, keys, true)
    IrSemanticHandleReturnTransform(input, function) ->
      match checked_specialization_rewrite_function_with_keys(function, keys) {
        (rewritten, remaining, valid) -> (
          IrSemanticHandleReturnTransform(input, rewritten),
          remaining,
          valid
        )
      }
  }
}

fn checked_specialization_rewrite_handler(
  handler: IrSemanticHandler,
  keys: List<i64>
) -> (IrSemanticHandler, List<i64>, bool) {
  match checked_specialization_rewrite_function_with_keys(handler.body, keys) {
    (body, after_body, body_valid) -> match checked_specialization_rewrite_handler_clauses(
      handler.clauses,
      after_body
    ) {
      (clauses, after_clauses, clauses_valid) ->
        match checked_specialization_rewrite_handler_return(
          handler.return_clause,
          after_clauses
        ) {
          (return_clause, final_keys, return_valid) -> (
            IrSemanticHandler {
              body: body,
              body_type: handler.body_type,
              captures: handler.captures,
              capture_words: handler.capture_words,
              clauses: clauses,
              return_clause: return_clause
            },
            final_keys,
            body_valid and clauses_valid and return_valid
          )
        }
    }
  }
}

fn checked_specialization_rewrite_insts(
  instructions: IrInstList,
  keys: List<i64>
) -> (IrInstList, List<i64>, bool) {
  match instructions {
    IrInstNil -> (IrInstNil, keys, true)
    IrInstCons(instruction, remaining) -> match instruction {
      IrSemanticCallI64(dst, IrSemanticGenericTarget(_, _), _, arguments) -> match keys {
        Nil -> (instructions, keys, false)
        Cons(key, remaining_keys) -> match checked_specialization_rewrite_insts(
          remaining,
          remaining_keys
        ) {
          (rewritten, final_keys, valid) -> (
            IrInstCons(IrCallI64(dst, key, arguments), rewritten),
            final_keys,
            valid
          )
        }
      }
      IrSemanticCallI64(
        dst,
        IrSemanticMethodTarget(_, receiver, _),
        _,
        arguments,
      ) -> match keys {
        Nil -> (instructions, keys, false)
        Cons(key, remaining_keys) -> match checked_specialization_rewrite_insts(
          remaining,
          remaining_keys
        ) {
          (rewritten, final_keys, valid) -> (
            IrInstCons(
              IrCallI64(dst, key, ir_value_list_prepend(receiver, arguments)),
              rewritten
            ),
            final_keys,
            valid
          )
        }
      }
      IrSemanticCallI64(
        dst,
        IrSemanticAssociatedTarget(_, _, _),
        _,
        arguments,
      ) -> match keys {
        Nil -> (instructions, keys, false)
        Cons(key, remaining_keys) -> match checked_specialization_rewrite_insts(
          remaining,
          remaining_keys
        ) {
          (rewritten, final_keys, valid) -> (
            IrInstCons(IrCallI64(dst, key, arguments), rewritten),
            final_keys,
            valid
          )
        }
      }
      IrSemanticCallI64(dst, IrSemanticHandleTarget(handler), result, arguments) ->
        match checked_specialization_rewrite_handler(handler, keys) {
          (rewritten_handler, after_handler, handler_valid) ->
            match checked_specialization_rewrite_insts(remaining, after_handler) {
              (rewritten, final_keys, rest_valid) -> (
                IrInstCons(
                  IrSemanticCallI64(
                    dst,
                    IrSemanticHandleTarget(rewritten_handler),
                    result,
                    arguments
                  ),
                  rewritten
                ),
                final_keys,
                handler_valid and rest_valid
              )
            }
        }
      IrSemanticDataI64(
        dst,
        IrSemanticFunctionReference(_, _),
        _,
        _,
      ) -> match keys {
        Nil -> (instructions, keys, false)
        Cons(key, remaining_keys) -> match checked_specialization_rewrite_insts(
          remaining,
          remaining_keys
        ) {
          (rewritten, final_keys, valid) -> (
            IrInstCons(IrFunctionRefI64(dst, key), rewritten),
            final_keys,
            valid
          )
        }
      }
      IrSemanticDataI64(
        dst,
        IrSemanticClosure(function, captures, source_site, role, generator),
        result,
        arguments,
      ) -> match checked_specialization_rewrite_function_with_keys(function, keys) {
        (rewritten_function, after_function, function_valid) ->
          match checked_specialization_rewrite_insts(remaining, after_function) {
            (rewritten, final_keys, rest_valid) -> (
              IrInstCons(
                IrSemanticDataI64(
                  dst,
                  IrSemanticClosure(
                    rewritten_function,
                    captures,
                    source_site,
                    role,
                    generator
                  ),
                  result,
                  arguments
                ),
                rewritten
              ),
              final_keys,
              function_valid and rest_valid
            )
          }
      }
      IrSemanticDataI64(
        dst,
        IrSemanticSpecializedClosure(function, captures, source_site, role, generator, effects),
        result,
        arguments,
      ) -> match checked_specialization_rewrite_function_with_keys(function, keys) {
        (rewritten_function, after_function, function_valid) ->
          match checked_specialization_rewrite_insts(remaining, after_function) {
            (rewritten, final_keys, rest_valid) -> (
              IrInstCons(
                IrSemanticDataI64(
                  dst,
                  IrSemanticSpecializedClosure(
                    rewritten_function,
                    captures,
                    source_site,
                    role,
                    generator,
                    effects
                  ),
                  result,
                  arguments
                ),
                rewritten
              ),
              final_keys,
              function_valid and rest_valid
            )
          }
      }
      other -> match checked_specialization_rewrite_insts(remaining, keys) {
        (rewritten, final_keys, valid) -> (
          IrInstCons(other, rewritten),
          final_keys,
          valid
        )
      }
    }
  }
}

fn checked_specialization_rewrite_blocks(
  blocks: IrBlockList,
  keys: List<i64>
) -> (IrBlockList, List<i64>, bool) {
  match blocks {
    IrBlockListNil -> (IrBlockListNil, keys, true)
    IrBlockListCons(IrBlock(id, parameters, instructions, terminator), remaining) ->
      match checked_specialization_rewrite_insts(instructions, keys) {
        (rewritten_instructions, after_instructions, valid_instructions) ->
          match checked_specialization_rewrite_blocks(remaining, after_instructions) {
            (rewritten_blocks, final_keys, valid_blocks) -> (
              IrBlockListCons(
                IrBlock(id, parameters, rewritten_instructions, terminator),
                rewritten_blocks
              ),
              final_keys,
              valid_instructions and valid_blocks
            )
          }
      }
  }
}

fn checked_specialization_rewrite(
  function: IrFunction,
  keys: List<i64>
) -> CheckedSpecializationRewrite {
  match function {
    IrFunction(key, parameters, blocks, source) ->
      match checked_specialization_rewrite_blocks(blocks, keys) {
        (rewritten, remaining, valid) -> if valid and remaining.len() == 0 {
          CheckedSpecializationRewritten(
            IrFunction(key, parameters, rewritten, source),
            remaining
          )
        } else { CheckedSpecializationRewriteRejected }
      }
  }
}

fn checked_specialization_cleanup_kind_at(
  catalog: borrow SemanticTypeCatalog,
  substitution: borrow SemanticTypeSubstitution,
  value_type: SemanticTypeId,
  lane: usize
) -> i64 {
  match semantic_value_lane_release_kind_with_substitution(
    catalog,
    substitution,
    value_type,
    lane
  ) {
    SemanticNoRelease -> continuation_cleanup_kind_none()
    SemanticManagedRelease -> continuation_cleanup_kind_rc()
    SemanticClosureRelease -> continuation_cleanup_kind_closure()
    SemanticWeakRelease -> continuation_cleanup_kind_weak()
  }
}

fn checked_specialization_cleanup_kind(
  catalog: borrow SemanticTypeCatalog,
  substitution: borrow SemanticTypeSubstitution,
  value_type: SemanticTypeId
) -> i64 {
  checked_specialization_cleanup_kind_at(catalog, substitution, value_type, 0)
}

fn checked_specialization_variant_case(
  declarations: borrow SemanticTypeDeclarationCatalog,
  layout: usize,
  wanted: DeclarationIdentity,
  index: usize,
  count: usize
) -> Option<usize> {
  if index >= count { None<usize>() }
  else {
    match semantic_type_declared_variant_case_declaration(declarations, layout, index) {
      Some(candidate) -> if declaration_identity_eq(candidate, wanted) { Some(index) }
      else {
        checked_specialization_variant_case(
          declarations,
          layout,
          wanted,
          index + 1,
          count
        )
      }
      None -> None<usize>()
    }
  }
}

fn checked_specialization_mask_kind(
  catalog: borrow SemanticTypeCatalog,
  substitution: borrow SemanticTypeSubstitution,
  value_type: SemanticTypeId,
  lane: usize
) -> i64 {
  match semantic_value_lane_release_kind_with_substitution(
    catalog,
    substitution,
    value_type,
    lane
  ) {
    SemanticNoRelease -> 0
    SemanticManagedRelease -> 1
    SemanticClosureRelease -> 2
    SemanticWeakRelease -> 3
  }
}

fn checked_specialization_variant_mask_lanes(
  catalog: borrow SemanticTypeCatalog,
  substitution: borrow SemanticTypeSubstitution,
  value_type: SemanticTypeId,
  lane: usize,
  words: usize,
  word: usize,
  mask: i64
) -> i64 {
  if lane >= words or word + lane >= 16 { mask }
  else {
    let shift = __u64_to_i64(__usize_to_u64((word + lane) * 2))
    checked_specialization_variant_mask_lanes(
      catalog,
      substitution,
      value_type,
      lane + 1,
      words,
      word,
      mask bor (
        checked_specialization_mask_kind(catalog, substitution, value_type, lane) bshl shift
      )
    )
  }
}

fn checked_specialization_variant_mask(
  catalog: borrow SemanticTypeCatalog,
  declarations: borrow SemanticTypeDeclarationCatalog,
  substitution: borrow SemanticTypeSubstitution,
  layout: usize,
  case_index: usize,
  payload_index: usize,
  payload_count: usize,
  word: usize,
  mask: i64
) -> CheckedSpecializationVariantMask {
  if payload_index >= payload_count {
    CheckedSpecializationVariantMaskValue(mask, word)
  } else {
    match semantic_type_declared_variant_payload_type(
      declarations,
      layout,
      case_index,
      payload_index
    ) {
      None -> CheckedSpecializationVariantMaskRejected
      Some(payload_type) -> match semantic_value_word_count_with_substitution(
        catalog,
        substitution,
        payload_type
      ) {
        None -> CheckedSpecializationVariantMaskRejected
        Some(words) -> checked_specialization_variant_mask(
          catalog,
          declarations,
          substitution,
          layout,
          case_index,
          payload_index + 1,
          payload_count,
          word + words,
          checked_specialization_variant_mask_lanes(
            catalog,
            substitution,
            payload_type,
            0,
            words,
            word,
            mask
          )
        )
      }
    }
  }
}

fn checked_specialization_constructor(
  dst: i64,
  declaration: DeclarationIdentity,
  result: SemanticTypeId,
  arguments: IrValueList,
  catalog: borrow SemanticTypeCatalog,
  declarations: borrow SemanticTypeDeclarationCatalog,
  substitution: borrow SemanticTypeSubstitution
) -> CheckedSpecializationConstructor {
  match semantic_type_declaration_catalog_resolve(
    catalog,
    declarations,
    result,
    substitution
  ) {
    SemanticVariantDeclarationLayoutMatched(layout, resolved) ->
      match semantic_type_declared_variant_case_count(declarations, layout) {
        None -> CheckedSpecializationConstructorResidual
        Some(count) -> match checked_specialization_variant_case(
          declarations,
          layout,
          declaration,
          0,
          count
        ) {
          None -> CheckedSpecializationConstructorResidual
          Some(case_index) -> match semantic_type_declared_variant_payload_count(
            declarations,
            layout,
            case_index
          ) {
            None -> CheckedSpecializationConstructorResidual
            Some(payload_count) -> match checked_specialization_variant_mask(
              catalog,
              declarations,
              resolved,
              layout,
              case_index,
              0,
              payload_count,
              1,
              0
            ) {
              CheckedSpecializationVariantMaskRejected ->
                CheckedSpecializationConstructorResidual
              CheckedSpecializationVariantMaskValue(mask, words) ->
                if __u64_to_i64(__usize_to_u64(words - 1)) != ir_value_list_len(arguments) {
                  CheckedSpecializationConstructorResidual
                } else {
                  let name_span = declaration_identity_name(declaration)
                  match name_span.text() {
                    None -> CheckedSpecializationConstructorResidual
                    Some(name) -> CheckedSpecializationConstructorConcrete(
                      IrVariantInitI64(dst, name.hash(), arguments, mask)
                    )
                  }
                }
            }
          }
        }
      }
    SemanticTypeDeclarationLayoutMissing -> CheckedSpecializationConstructorResidual
    _ -> CheckedSpecializationConstructorResidual
  }
}

fn checked_specialization_legalize_function(
  function: IrFunction,
  catalog: borrow SemanticTypeCatalog,
  declarations: borrow SemanticTypeDeclarationCatalog,
  substitution: borrow SemanticTypeSubstitution
) -> CheckedSpecializationLegalize {
  match function {
    IrFunction(key, parameters, blocks, source) ->
      match checked_specialization_legalize_blocks(
        blocks,
        catalog,
        declarations,
        substitution
      ) {
        (rewritten, None) -> CheckedSpecializationLegalized(
          IrFunction(key, parameters, rewritten, source)
        )
        (_, Some(value_type)) -> CheckedSpecializationLegalizeRejected(value_type)
      }
  }
}

fn checked_specialization_legalize_handler_clauses(
  clauses: IrSemanticHandlerClauseList,
  catalog: borrow SemanticTypeCatalog,
  declarations: borrow SemanticTypeDeclarationCatalog,
  substitution: borrow SemanticTypeSubstitution
) -> (IrSemanticHandlerClauseList, Option<SemanticTypeId>) {
  match clauses {
    IrSemanticHandlerClauseNil -> (IrSemanticHandlerClauseNil, None<SemanticTypeId>())
    IrSemanticHandlerClauseCons(clause, remaining) ->
      match checked_specialization_legalize_function(
        clause.body,
        catalog,
        declarations,
        substitution
      ) {
        CheckedSpecializationLegalizeRejected(value_type) -> (clauses, Some(value_type))
        CheckedSpecializationLegalized(body) ->
          match checked_specialization_legalize_handler_clauses(
            remaining,
            catalog,
            declarations,
            substitution
          ) {
            (_, Some(value_type)) -> (clauses, Some(value_type))
            (rest, None) -> (
              IrSemanticHandlerClauseCons(
                IrSemanticHandlerClause {
                  effect_declaration: clause.effect_declaration,
                  operation: clause.operation,
                  atom: clause.atom,
                  parameters: clause.parameters,
                  parameter_words: clause.parameter_words,
                  captures: clause.captures,
                  capture_values: clause.capture_values,
                  capture_words: clause.capture_words,
                  continuation: clause.continuation,
                  completion: clause.completion,
                  result_type: clause.result_type,
                  body: body
                },
                rest
              ),
              None<SemanticTypeId>()
            )
          }
      }
  }
}

fn checked_specialization_legalize_handler_return(
  returned: IrSemanticHandleReturn,
  catalog: borrow SemanticTypeCatalog,
  declarations: borrow SemanticTypeDeclarationCatalog,
  substitution: borrow SemanticTypeSubstitution
) -> (IrSemanticHandleReturn, Option<SemanticTypeId>) {
  match returned {
    IrSemanticNoHandleReturn -> (IrSemanticNoHandleReturn, None<SemanticTypeId>())
    IrSemanticHandleReturnTransform(input, function) ->
      match checked_specialization_legalize_function(
        function,
        catalog,
        declarations,
        substitution
      ) {
        CheckedSpecializationLegalizeRejected(value_type) -> (returned, Some(value_type))
        CheckedSpecializationLegalized(rewritten) -> (
          IrSemanticHandleReturnTransform(input, rewritten),
          None<SemanticTypeId>()
        )
      }
  }
}

fn checked_specialization_legalize_handler(
  handler: IrSemanticHandler,
  catalog: borrow SemanticTypeCatalog,
  declarations: borrow SemanticTypeDeclarationCatalog,
  substitution: borrow SemanticTypeSubstitution
) -> (IrSemanticHandler, Option<SemanticTypeId>) {
  match checked_specialization_legalize_function(
    handler.body,
    catalog,
    declarations,
    substitution
  ) {
    CheckedSpecializationLegalizeRejected(value_type) -> (handler, Some(value_type))
    CheckedSpecializationLegalized(body) ->
      match checked_specialization_legalize_handler_clauses(
        handler.clauses,
        catalog,
        declarations,
        substitution
      ) {
        (_, Some(value_type)) -> (handler, Some(value_type))
        (clauses, None) -> match checked_specialization_legalize_handler_return(
          handler.return_clause,
          catalog,
          declarations,
          substitution
        ) {
          (_, Some(value_type)) -> (handler, Some(value_type))
          (return_clause, None) -> (
            IrSemanticHandler {
              body: body,
              body_type: handler.body_type,
              captures: handler.captures,
              capture_words: handler.capture_words,
              clauses: clauses,
              return_clause: return_clause
            },
            None<SemanticTypeId>()
          )
        }
      }
  }
}

fn checked_specialization_legalize_mutable_slot(
  value_type: SemanticTypeId,
  slot: i64,
  action: IrSemanticMutableSlotAction,
  arguments: IrValueList,
  catalog: borrow SemanticTypeCatalog,
  substitution: borrow SemanticTypeSubstitution
) -> (IrInst, bool) {
  let kind = checked_specialization_cleanup_kind(catalog, substitution, value_type)
  let value = ir_value_list_nth_or(arguments, 0, 0 - 1)
  let count = ir_value_list_len(arguments)
  if kind == continuation_cleanup_kind_none() or value < 0 {
    (
      IrSemanticDataI64(
        0 - 1,
        IrSemanticMutableSlot(value_type, slot, action),
        value_type,
        arguments
      ),
      false
    )
  } else {
    match action {
      IrSemanticMutableSlotAcquire -> (
        IrManagedSlotI64(0 - 1, value, slot, kind, IrManagedSlotAcquire),
        count == 1
      )
      IrSemanticMutableSlotObserve -> (
        IrManagedSlotI64(0 - 1, value, slot, kind, IrManagedSlotObserve),
        count == 1
      )
      IrSemanticMutableSlotReplace(previous) -> (
        IrManagedSlotI64(
          0 - 1,
          value,
          slot,
          kind,
          IrManagedSlotReplace(previous)
        ),
        count == 2 and ir_value_list_nth_or(arguments, 1, 0 - 1) == previous
      )
      IrSemanticMutableSlotRelease -> (
        IrManagedSlotI64(0 - 1, value, slot, kind, IrManagedSlotRelease),
        count == 1
      )
    }
  }
}

fn checked_specialization_usize_i64(value: usize) -> i64 {
  __u64_to_i64(__usize_to_u64(value))
}

fn checked_specialization_declared_record_words_from(
  catalog: borrow SemanticTypeCatalog,
  declarations: borrow SemanticTypeDeclarationCatalog,
  substitution: borrow SemanticTypeSubstitution,
  layout: usize,
  index: usize,
  count: usize,
  words: usize
) -> Option<usize> {
  if index >= count { Some<usize>(words) }
  else {
    match semantic_type_declared_record_field_type(declarations, layout, index) {
      None -> None<usize>()
      Some(field_type) -> match semantic_value_word_count_with_substitution(
        catalog,
        substitution,
        field_type
      ) {
        None -> None<usize>()
        Some(field_words) -> checked_specialization_declared_record_words_from(
          catalog,
          declarations,
          substitution,
          layout,
          index + 1,
          count,
          words + field_words
        )
      }
    }
  }
}

fn checked_specialization_declared_record_words_before(
  catalog: borrow SemanticTypeCatalog,
  declarations: borrow SemanticTypeDeclarationCatalog,
  substitution: borrow SemanticTypeSubstitution,
  layout: usize,
  target: usize,
  index: usize,
  words: usize
) -> Option<usize> {
  if index >= target { Some<usize>(words) }
  else {
    match semantic_type_declared_record_field_type(declarations, layout, index) {
      None -> None<usize>()
      Some(field_type) -> match semantic_value_word_count_with_substitution(
        catalog,
        substitution,
        field_type
      ) {
        None -> None<usize>()
        Some(field_words) -> checked_specialization_declared_record_words_before(
          catalog,
          declarations,
          substitution,
          layout,
          target,
          index + 1,
          words + field_words
        )
      }
    }
  }
}

fn checked_specialization_record_field_count(fields: IrSemanticRecordFieldList) -> usize {
  match fields {
    IrSemanticRecordFieldNil -> {
      let zero: usize = 0
      zero
    }
    IrSemanticRecordFieldCons(_, remaining) ->
      1 + checked_specialization_record_field_count(remaining)
  }
}

fn checked_specialization_record_field_at(
  fields: IrSemanticRecordFieldList,
  ordinal: usize,
  argument_word: usize,
  catalog: borrow SemanticTypeCatalog,
  substitution: borrow SemanticTypeSubstitution
) -> Option<(IrSemanticRecordField, usize, usize)> {
  match fields {
    IrSemanticRecordFieldNil -> None<(IrSemanticRecordField, usize, usize)>()
    IrSemanticRecordFieldCons(field, remaining) -> {
      match semantic_value_word_count_with_substitution(
        catalog,
        substitution,
        field.value_type
      ) {
        None -> None<(IrSemanticRecordField, usize, usize)>()
        Some(words) -> match field.position {
          IrSemanticRecordFieldOrdinal(index) -> if index == ordinal {
            Some<(IrSemanticRecordField, usize, usize)>((field, argument_word, words))
          } else {
            checked_specialization_record_field_at(
              remaining,
              ordinal,
              argument_word + words,
              catalog,
              substitution
            )
          }
          IrSemanticRecordFieldWordOffset(_) ->
            None<(IrSemanticRecordField, usize, usize)>()
        }
      }
    }
  }
}

fn checked_specialization_record_field_lanes(
  stable_key: i64,
  field_word: usize,
  argument_word: usize,
  field_type: SemanticTypeId,
  lane: usize,
  words: usize,
  arguments: IrValueList,
  catalog: borrow SemanticTypeCatalog,
  substitution: borrow SemanticTypeSubstitution,
  rest: IrRecordLayoutFieldList
) -> IrRecordLayoutFieldList {
  if lane >= words { rest }
  else {
    ir_record_layout_field_list_prepend_word(
      stable_key,
      checked_specialization_usize_i64((field_word + lane) * 8),
      ir_value_list_nth_or(
        arguments,
        checked_specialization_usize_i64(argument_word + lane),
        0 - 1
      ),
      checked_specialization_cleanup_kind_at(
        catalog,
        substitution,
        field_type,
        lane
      ),
      checked_specialization_record_field_lanes(
        stable_key,
        field_word,
        argument_word,
        field_type,
        lane + 1,
        words,
        arguments,
        catalog,
        substitution,
        rest
      )
    )
  }
}

fn checked_specialization_record_layout_fields_from(
  fields: IrSemanticRecordFieldList,
  arguments: IrValueList,
  catalog: borrow SemanticTypeCatalog,
  declarations: borrow SemanticTypeDeclarationCatalog,
  caller: borrow SemanticTypeSubstitution,
  resolved: borrow SemanticTypeSubstitution,
  layout: usize,
  ordinal: usize,
  count: usize,
  field_word: usize
) -> Option<IrRecordLayoutFieldList> {
  if ordinal >= count { Some<IrRecordLayoutFieldList>(ir_record_layout_field_list_empty()) }
  else {
    match (
      checked_specialization_record_field_at(fields, ordinal, 0, catalog, caller),
      semantic_type_declared_record_field_declaration(declarations, layout, ordinal),
      semantic_type_declared_record_field_type(declarations, layout, ordinal),
    ) {
      (
        Some((field, argument_word, words)),
        Some(expected_declaration),
        Some(expected_type),
      ) -> match field.kind {
        IrSemanticDeclaredRecordField -> match field.declaration {
          actual_declaration: DeclarationIdentity ->
            match semantic_value_word_count_with_substitution(
              catalog,
              resolved,
              expected_type
            ) {
              Some(expected_words) if expected_words == words and declaration_identity_eq(
                actual_declaration,
                expected_declaration
              ) -> match checked_specialization_record_layout_fields_from(
                fields,
                arguments,
                catalog,
                declarations,
                caller,
                resolved,
                layout,
                ordinal + 1,
                count,
                field_word + words
              ) {
                None -> None<IrRecordLayoutFieldList>()
                Some(rest) -> match declaration_identity_name(expected_declaration).text() {
                  None -> None<IrRecordLayoutFieldList>()
                  Some(name) -> Some<IrRecordLayoutFieldList>(
                    checked_specialization_record_field_lanes(
                      name.hash(),
                      field_word,
                      argument_word,
                      field.value_type,
                      0,
                      words,
                      arguments,
                      catalog,
                      caller,
                      rest
                    )
                  )
                }
              }
              _ -> None<IrRecordLayoutFieldList>()
            }
          nil -> None<IrRecordLayoutFieldList>()
        }
        _ -> None<IrRecordLayoutFieldList>()
      }
      _ -> None<IrRecordLayoutFieldList>()
    }
  }
}

fn checked_specialization_record_init(
  dst: i64,
  declaration: DeclarationIdentity,
  fields: IrSemanticRecordFieldList,
  result: SemanticTypeId,
  arguments: IrValueList,
  catalog: borrow SemanticTypeCatalog,
  declarations: borrow SemanticTypeDeclarationCatalog,
  substitution: borrow SemanticTypeSubstitution
) -> Option<IrInst> {
  match (
    semantic_type_declaration_catalog_resolve(catalog, declarations, result, substitution),
    semantic_type_declared_record_template(catalog, declarations, declaration),
  ) {
    (
      SemanticRecordDeclarationLayoutMatched(layout, resolved),
      SemanticRecordDeclarationTemplateSelected(_, declared_layout, _),
    ) if layout == declared_layout ->
      match semantic_type_declared_record_field_count(declarations, layout) {
        None -> None<IrInst>()
        Some(count) -> if checked_specialization_record_field_count(fields) != count {
          None<IrInst>()
        } else {
          match checked_specialization_declared_record_words_from(
            catalog,
            declarations,
            resolved,
            layout,
            0,
            count,
            0
          ) {
            None -> None<IrInst>()
            Some(words) -> if checked_specialization_usize_i64(words) !=
              ir_value_list_len(arguments) {
                None<IrInst>()
              } else {
                match checked_specialization_record_layout_fields_from(
                  fields,
                  arguments,
                  catalog,
                  declarations,
                  substitution,
                  resolved,
                  layout,
                  0,
                  count,
                  0
                ) {
                  None -> None<IrInst>()
                  Some(concrete) -> match declaration_identity_name(declaration).text() {
                    None -> None<IrInst>()
                    Some(name) -> Some<IrInst>(
                      ir_inst_record_layout_init_i64(
                        dst,
                        name.hash(),
                        checked_specialization_usize_i64(words * 8),
                        8,
                        concrete
                      )
                    )
                  }
                }
              }
          }
        }
      }
    _ -> None<IrInst>()
  }
}

fn checked_specialization_consume_result_lanes(
  instructions: IrInstList,
  head: i64,
  lane: usize,
  words: usize
) -> Option<IrInstList> {
  if lane >= words { Some<IrInstList>(instructions) }
  else {
    match instructions {
      IrInstCons(IrSemanticResultLaneI64(dst, source, actual_lane), remaining) ->
        if dst == head + checked_specialization_usize_i64(lane) and source == head and
        actual_lane == checked_specialization_usize_i64(lane) {
          checked_specialization_consume_result_lanes(
            remaining,
            head,
            lane + 1,
            words
          )
        } else { None<IrInstList>() }
      _ -> None<IrInstList>()
    }
  }
}

fn checked_specialization_record_loads(
  dst: i64,
  base: i64,
  record_words: usize,
  field_key: i64,
  field_word: usize,
  lane: usize,
  words: usize,
  rest: IrInstList
) -> IrInstList {
  if lane >= words { rest }
  else {
    IrInstCons(
      ir_inst_record_layout_word_load_i64(
        dst + checked_specialization_usize_i64(lane),
        base,
        checked_specialization_usize_i64(record_words * 8),
        field_key,
        checked_specialization_usize_i64((field_word + lane) * 8)
      ),
      checked_specialization_record_loads(
        dst,
        base,
        record_words,
        field_key,
        field_word,
        lane + 1,
        words,
        rest
      )
    )
  }
}

fn checked_specialization_record_projection(
  dst: i64,
  declaration: DeclarationIdentity,
  ordinal: usize,
  base_type: SemanticTypeId,
  result_type: SemanticTypeId,
  arguments: IrValueList,
  remaining: IrInstList,
  catalog: borrow SemanticTypeCatalog,
  declarations: borrow SemanticTypeDeclarationCatalog,
  substitution: borrow SemanticTypeSubstitution
) -> Option<CheckedSpecializationRecordProjection> {
  match semantic_type_declaration_catalog_resolve(
    catalog,
    declarations,
    base_type,
    substitution
  ) {
    SemanticRecordDeclarationLayoutMatched(layout, resolved) ->
      match semantic_type_declared_record_field_count(declarations, layout) {
        Some(count) if ordinal < count -> match (
          semantic_type_declared_record_field_declaration(declarations, layout, ordinal),
          semantic_type_declared_record_field_type(declarations, layout, ordinal),
          checked_specialization_declared_record_words_from(
            catalog,
            declarations,
            resolved,
            layout,
            0,
            count,
            0
          ),
          checked_specialization_declared_record_words_before(
            catalog,
            declarations,
            resolved,
            layout,
            ordinal,
            0,
            0
          ),
        ) {
          (
          Some(expected_declaration),
          Some(expected_type),
          Some(record_words),
          Some(field_word),
        ) -> match (
          semantic_value_word_count_with_substitution(
            catalog,
            resolved,
            expected_type
          ),
          semantic_value_word_count_with_substitution(
            catalog,
            substitution,
            result_type
          ),
          declaration_identity_name(expected_declaration).text(),
        ) {
          (Some(field_words), Some(result_words), Some(name)) if field_words ==
            result_words and declaration_identity_eq(declaration, expected_declaration) and
            ir_value_list_len(arguments) == 1 ->
            match checked_specialization_consume_result_lanes(
              remaining,
              dst,
              1,
              field_words
            ) {
              None -> None<CheckedSpecializationRecordProjection>()
              Some(after_lanes) -> Some<CheckedSpecializationRecordProjection>(
                CheckedSpecializationRecordProjection {
                  base: ir_value_list_nth_or(arguments, 0, 0 - 1),
                  record_words: record_words,
                  field_key: name.hash(),
                  field_word: field_word,
                  field_words: field_words,
                  remaining: after_lanes
                }
              )
            }
          _ -> None<CheckedSpecializationRecordProjection>()
        }
          _ -> None<CheckedSpecializationRecordProjection>()
        }
        _ -> None<CheckedSpecializationRecordProjection>()
      }
    _ -> None<CheckedSpecializationRecordProjection>()
  }
}

type CheckedConcreteCaptureWords {
  words: IrConcreteCaptureWordList,
  remaining: IrValueList
}

fn checked_specialization_capture_lanes(
  catalog: borrow SemanticTypeCatalog,
  substitution: borrow SemanticTypeSubstitution,
  value_type: SemanticTypeId,
  lane: usize,
  count: usize,
  values: IrValueList
) -> Option<CheckedConcreteCaptureWords> {
  if lane == count {
    Some<CheckedConcreteCaptureWords>(
      CheckedConcreteCaptureWords {
        words: IrConcreteCaptureWordNil,
        remaining: values
      }
    )
  } else {
    match semantic_value_lane_class_with_substitution(
      catalog,
      substitution,
      value_type,
      lane
    ) {
      SemanticLaneUnavailable -> None<CheckedConcreteCaptureWords>()
      lane_class -> match values {
        IrValueNil -> None<CheckedConcreteCaptureWords>()
        IrValueCons(value, rest) -> match checked_specialization_capture_lanes(
          catalog,
          substitution,
          value_type,
          lane + 1,
          count,
          rest
        ) {
          None -> None<CheckedConcreteCaptureWords>()
          Some(after) -> Some<CheckedConcreteCaptureWords>(
            CheckedConcreteCaptureWords {
              words: IrConcreteCaptureWordCons(
                IrConcreteCaptureWord {
                  value: value,
                  cleanup_kind: checked_specialization_cleanup_kind_at(
                    catalog,
                    substitution,
                    value_type,
                    lane
                  ),
                  lane_class: lane_class
                },
                after.words
              ),
              remaining: after.remaining
            }
          )
        }
      }
    }
  }
}

fn checked_specialization_append_capture_words(
  first: IrConcreteCaptureWordList,
  rest: IrConcreteCaptureWordList
) -> IrConcreteCaptureWordList {
  match first {
    IrConcreteCaptureWordNil -> rest
    IrConcreteCaptureWordCons(word, remaining) -> IrConcreteCaptureWordCons(
      word,
      checked_specialization_append_capture_words(remaining, rest)
    )
  }
}

fn checked_specialization_capture_words(
  captures: IrSemanticCaptureList,
  values: IrValueList,
  catalog: borrow SemanticTypeCatalog,
  substitution: borrow SemanticTypeSubstitution
) -> Option<IrConcreteCaptureWordList> {
  match captures {
    IrSemanticCaptureNil -> match values {
      IrValueNil -> Some<IrConcreteCaptureWordList>(IrConcreteCaptureWordNil)
      _ -> None<IrConcreteCaptureWordList>()
    }
    IrSemanticCaptureCons(capture, remaining) ->
      match semantic_value_word_count_with_substitution(
        catalog,
        substitution,
        capture.value_type
      ) {
        Some(words) if words == capture.words ->
          match checked_specialization_capture_lanes(
            catalog,
            substitution,
            capture.value_type,
            0,
            words,
            values
          ) {
            None -> None<IrConcreteCaptureWordList>()
            Some(first) -> match checked_specialization_capture_words(
              remaining,
              first.remaining,
              catalog,
              substitution
            ) {
              None -> None<IrConcreteCaptureWordList>()
              Some(rest) -> Some<IrConcreteCaptureWordList>(
                checked_specialization_append_capture_words(first.words, rest)
              )
            }
          }
        _ -> None<IrConcreteCaptureWordList>()
      }
  }
}

fn checked_specialization_legalize_insts(
  instructions: IrInstList,
  catalog: borrow SemanticTypeCatalog,
  declarations: borrow SemanticTypeDeclarationCatalog,
  substitution: borrow SemanticTypeSubstitution
) -> (IrInstList, Option<SemanticTypeId>) {
  match instructions {
    IrInstNil -> (IrInstNil, None<SemanticTypeId>())
    IrInstCons(instruction, remaining) -> match instruction {
      IrSemanticCallI64(dst, IrSemanticHandleTarget(handler), result, arguments) ->
        match checked_specialization_legalize_handler(
          handler,
          catalog,
          declarations,
          substitution
        ) {
          (_, Some(value_type)) -> (instructions, Some(value_type))
          (rewritten_handler, None) -> match checked_specialization_legalize_insts(
            remaining,
            catalog,
            declarations,
            substitution
          ) {
            (_, Some(value_type)) -> (instructions, Some(value_type))
            (rewritten, None) -> (
              IrInstCons(
                IrSemanticCallI64(
                  dst,
                  IrSemanticHandleTarget(rewritten_handler),
                  result,
                  arguments
                ),
                rewritten
              ),
              None<SemanticTypeId>()
            )
          }
        }
      IrSemanticConstructorI64(dst, declaration, result, arguments) ->
        match checked_specialization_constructor(
          dst,
          declaration,
          result,
          arguments,
          catalog,
          declarations,
          substitution
        ) {
          CheckedSpecializationConstructorResidual ->
            match checked_specialization_legalize_insts(
              remaining,
              catalog,
              declarations,
              substitution
            ) {
              (_, Some(value_type)) -> (instructions, Some(value_type))
              (rewritten, None) -> (
                IrInstCons(instruction, rewritten),
                None<SemanticTypeId>()
              )
            }
          CheckedSpecializationConstructorConcrete(concrete) ->
            match checked_specialization_legalize_insts(
              remaining,
              catalog,
              declarations,
              substitution
            ) {
              (_, Some(value_type)) -> (instructions, Some(value_type))
              (rewritten, None) -> (
                IrInstCons(concrete, rewritten),
                None<SemanticTypeId>()
              )
            }
        }
      IrSemanticDataI64(
        dst,
        IrSemanticRecordInit(IrSemanticDeclaredRecord(declaration), fields),
        result,
        arguments,
      ) -> match checked_specialization_record_init(
        dst,
        declaration,
        fields,
        result,
        arguments,
        catalog,
        declarations,
        substitution
      ) {
        None -> (instructions, Some(result))
        Some(concrete) -> match checked_specialization_legalize_insts(
          remaining,
          catalog,
          declarations,
          substitution
        ) {
          (_, Some(value_type)) -> (instructions, Some(value_type))
          (rewritten, None) -> (
            IrInstCons(concrete, rewritten),
            None<SemanticTypeId>()
          )
        }
      }
      IrSemanticDataI64(
        dst,
        IrSemanticDeclaredFieldAccess(declaration, ordinal, base_type),
        result,
        arguments,
      ) -> match checked_specialization_record_projection(
        dst,
        declaration,
        ordinal,
        base_type,
        result,
        arguments,
        remaining,
        catalog,
        declarations,
        substitution
      ) {
        None -> (instructions, Some(result))
        Some(projection) -> match checked_specialization_legalize_insts(
          projection.remaining,
          catalog,
          declarations,
          substitution
        ) {
          (_, Some(value_type)) -> (instructions, Some(value_type))
          (rewritten, None) -> (
            checked_specialization_record_loads(
              dst,
              projection.base,
              projection.record_words,
              projection.field_key,
              projection.field_word,
              0,
              projection.field_words,
              rewritten
            ),
            None<SemanticTypeId>()
          )
        }
      }
      IrSemanticDataI64(
        _,
        IrSemanticMutableSlot(value_type, slot, action),
        _,
        arguments,
      ) -> match checked_specialization_legalize_mutable_slot(
        value_type,
        slot,
        action,
        arguments,
        catalog,
        substitution
      ) {
        (_, false) -> (instructions, Some(value_type))
        (concrete, true) -> match checked_specialization_legalize_insts(
          remaining,
          catalog,
          declarations,
          substitution
        ) {
          (_, Some(failed_type)) -> (instructions, Some(failed_type))
          (rewritten, None) -> (
            IrInstCons(concrete, rewritten),
            None<SemanticTypeId>()
          )
        }
      }
      IrSemanticDataI64(
        dst,
        IrSemanticClosure(function, captures, source_site, role, generator),
        result,
        arguments,
      ) -> match checked_specialization_capture_words(
        captures,
        arguments,
        catalog,
        substitution
      ) {
        None -> (instructions, Some(result))
        Some(words) -> {
          let effects = match semantic_function_purity(catalog, result) {
            SemanticPureFunction -> IrConcretePureClosure
            SemanticEffectfulFunction(effects) -> IrConcreteEffectfulClosure(effects)
            SemanticFunctionShapeUnavailable -> return (instructions, Some(result))
          }
          match checked_specialization_legalize_function(
            function,
            catalog,
            declarations,
            substitution
          ) {
            CheckedSpecializationLegalizeRejected(value_type) -> (instructions, Some(value_type))
            CheckedSpecializationLegalized(rewritten_function) ->
              match checked_specialization_legalize_insts(
                remaining,
                catalog,
                declarations,
                substitution
              ) {
                (_, Some(value_type)) -> (instructions, Some(value_type))
                (rewritten, None) -> (
                  IrInstCons(
                    IrSemanticDataI64(
                      dst,
                      IrSemanticSpecializedClosure(
                        rewritten_function,
                        words,
                        source_site,
                        role,
                        generator,
                        effects
                      ),
                      result,
                      arguments
                    ),
                    rewritten
                  ),
                  None<SemanticTypeId>()
                )
              }
          }
        }
      }
      other -> match checked_specialization_legalize_insts(
        remaining,
        catalog,
        declarations,
        substitution
      ) {
        (_, Some(value_type)) -> (instructions, Some(value_type))
        (rewritten, None) -> (IrInstCons(other, rewritten), None<SemanticTypeId>())
      }
    }
  }
}

fn checked_specialization_legalize_blocks(
  blocks: IrBlockList,
  catalog: borrow SemanticTypeCatalog,
  declarations: borrow SemanticTypeDeclarationCatalog,
  substitution: borrow SemanticTypeSubstitution
) -> (IrBlockList, Option<SemanticTypeId>) {
  match blocks {
    IrBlockListNil -> (IrBlockListNil, None<SemanticTypeId>())
    IrBlockListCons(IrBlock(id, parameters, instructions, terminator), remaining) ->
      match checked_specialization_legalize_insts(
        instructions,
        catalog,
        declarations,
        substitution
      ) {
        (_, Some(value_type)) -> (blocks, Some(value_type))
        (rewritten_instructions, None) -> match checked_specialization_legalize_blocks(
          remaining,
          catalog,
          declarations,
          substitution
        ) {
          (_, Some(value_type)) -> (blocks, Some(value_type))
          (rewritten_blocks, None) -> (
            IrBlockListCons(
              IrBlock(id, parameters, rewritten_instructions, terminator),
              rewritten_blocks
            ),
            None<SemanticTypeId>()
          )
        }
      }
  }
}

fn checked_specialization_materialize_arguments(
  types: SemanticTypeProductBuilder,
  substitution: borrow SemanticTypeSubstitution,
  arguments: List<SemanticTypeId>
) -> CheckedSpecializationArguments {
  match arguments {
    Nil -> CheckedSpecializationArguments {
      types: types,
      values: Nil<SemanticTypeId>()
    }
    Cons(argument, remaining) -> {
      let (next_types, concrete) = semantic_type_product_substitute(
        types,
        substitution,
        argument
      )
      let rest = checked_specialization_materialize_arguments(
        next_types,
        substitution,
        remaining
      )
      CheckedSpecializationArguments {
        types: rest.types,
        values: rest.values.prepend(concrete)
      }
    }
  }
}

fn checked_specialization_arguments_from_substitution(
  product: borrow CheckedBodyProduct,
  function_index: usize,
  substitution: borrow SemanticTypeSubstitution,
  position: usize,
  values: List<SemanticTypeId>
) -> Option<List<SemanticTypeId>> {
  let signatures = product.signatures()
  let signature = product.function(function_index).signature
  if position >= signatures.type_parameter_count(signature) {
    Some<List<SemanticTypeId>>(values)
  } else {
    match semantic_type_substitution_get(
      substitution,
      signatures.type_parameter_at(signature, position)
    ) {
      None -> None<List<SemanticTypeId>>()
      Some(argument) -> checked_specialization_arguments_from_substitution(
        product,
        function_index,
        substitution,
        position + 1,
        values.append(argument)
      )
    }
  }
}

fn checked_specialization_resolve_method(
  methods: borrow SemanticMethodCatalog,
  catalog: borrow SemanticTypeCatalog,
  conformances: borrow SemanticConformanceCatalog,
  target: SemanticTypeId,
  declaration: DeclarationIdentity
) -> SemanticImplementationMethodSelection {
  let direct = semantic_implementation_method_resolve(
    methods,
    catalog,
    conformances,
    target,
    declaration
  )
  match direct {
    SemanticImplementationMethodSelectionMissing -> match catalog.graph_for(target) {
      None -> direct
      Some(graph) -> match semantic_type_graph_node(graph, target) {
        SemanticOwnedNode(inner) -> checked_specialization_resolve_method(
          methods,
          catalog,
          conformances,
          inner,
          declaration
        )
        SemanticUniqueNode(inner) -> checked_specialization_resolve_method(
          methods,
          catalog,
          conformances,
          inner,
          declaration
        )
        SemanticBorrowNode(inner, _) -> checked_specialization_resolve_method(
          methods,
          catalog,
          conformances,
          inner,
          declaration
        )
        _ -> direct
      }
    }
    _ -> direct
  }
}

fn checked_specialization_prepare_request(
  universe: borrow CheckedSpecializationUniverse,
  request: CheckedSpecializationRequest,
  types: SemanticTypeProductBuilder,
  caller: borrow SemanticTypeSubstitution
) -> Option<CheckedSpecializationPreparedRequest> {
  match request.call_signature {
    None -> {
      let concrete = checked_specialization_materialize_arguments(
        types,
        caller,
        request.type_arguments
      )
      Some<CheckedSpecializationPreparedRequest>(
        CheckedSpecializationPreparedRequest {
          types: concrete.types,
          identity: request.identity,
          arguments: concrete.values,
          concrete_signature: None<SemanticTypeId>(),
          method_substitution: None<SemanticTypeSubstitution>()
        }
      )
    }
    Some(signature) -> {
      let (signature_types, concrete_signature) = semantic_type_product_substitute(
        types,
        caller,
        signature
      )
      let signature_catalog = semantic_type_product_catalog(signature_types)
      let target_result = match request.dispatch_target {
        None -> if checked_specialization_function_parameter_count(
          signature_catalog,
          concrete_signature
        ) == 0 {
          None<(SemanticTypeProductBuilder, SemanticTypeId)>()
        } else {
          match checked_specialization_function_parameter(
            signature_catalog,
            concrete_signature,
            0
          ) {
            None -> None<(SemanticTypeProductBuilder, SemanticTypeId)>()
            Some(parameter) -> Some<(SemanticTypeProductBuilder, SemanticTypeId)>(
              (signature_types, parameter)
            )
          }
        }
        Some(target) -> {
          let (target_types, concrete_target) = semantic_type_product_substitute(
            signature_types,
            caller,
            target
          )
          Some<(SemanticTypeProductBuilder, SemanticTypeId)>(
            (target_types, concrete_target)
          )
        }
      }
      match (request.method_declaration, target_result) {
        (Some(declaration), Some((next_types, target))) -> {
          let methods = universe.methods
          let conformances = universe.conformances
          let next_catalog = semantic_type_product_catalog(next_types)
          match checked_specialization_resolve_method(
            methods,
            next_catalog,
            conformances,
            target,
            declaration
          ) {
            SemanticImplementationMethodSelected(_, function, _, substitution) ->
              Some<CheckedSpecializationPreparedRequest>(
                CheckedSpecializationPreparedRequest {
                  types: next_types,
                  identity: function,
                  arguments: Nil<SemanticTypeId>(),
                  concrete_signature: Some<SemanticTypeId>(concrete_signature),
                  method_substitution: Some<SemanticTypeSubstitution>(substitution)
                }
              )
            _ -> match checked_specialization_function(
              universe.bodies,
              request.identity
            ) {
              Some(_) -> Some<CheckedSpecializationPreparedRequest>(
                CheckedSpecializationPreparedRequest {
                  types: next_types,
                  identity: request.identity,
                  arguments: Nil<SemanticTypeId>(),
                  concrete_signature: Some<SemanticTypeId>(concrete_signature),
                  method_substitution: None<SemanticTypeSubstitution>()
                }
              )
              None -> None<CheckedSpecializationPreparedRequest>()
            }
          }
        }
        _ -> None<CheckedSpecializationPreparedRequest>()
      }
    }
  }
}

fn checked_specialization_materialize_request(
  product: borrow CheckedBodyProduct,
  function_index: usize,
  request: CheckedSpecializationPreparedRequest
) -> Option<CheckedSpecializationArguments> {
  match request.method_substitution {
    Some(substitution) -> match checked_specialization_arguments_from_substitution(
      product,
      function_index,
      substitution,
      0,
      Nil<SemanticTypeId>()
    ) {
      None -> None<CheckedSpecializationArguments>()
      Some(arguments) -> Some<CheckedSpecializationArguments>(
        CheckedSpecializationArguments {
          types: request.types,
          values: arguments
        }
      )
    }
    None -> match request.concrete_signature {
      None -> Some<CheckedSpecializationArguments>(
        CheckedSpecializationArguments {
          types: request.types,
          values: request.arguments
        }
      )
      Some(concrete_signature) -> if {
        let signatures = product.signatures()
        let function = product.function(function_index)
        signatures.type_parameter_count(function.signature)
      } == 0 {
        Some<CheckedSpecializationArguments>(
          CheckedSpecializationArguments {
            types: request.types,
            values: Nil<SemanticTypeId>()
          }
        )
      } else {
        let request_types = request.types
        let catalog = semantic_type_product_catalog(request_types)
        let template = product.function(function_index).signature.type_id
        let empty = semantic_type_substitution_empty()
        match semantic_type_pattern_match_substituted(
          catalog,
          template,
          empty,
          concrete_signature,
          empty
        ) {
          SemanticTypePatternRejected -> None<CheckedSpecializationArguments>()
          SemanticTypePatternMatched(substitution) ->
            match checked_specialization_arguments_from_substitution(
              product,
              function_index,
              substitution,
              0,
              Nil<SemanticTypeId>()
            ) {
              None -> None<CheckedSpecializationArguments>()
              Some(arguments) -> Some<CheckedSpecializationArguments>(
                CheckedSpecializationArguments {
                  types: request_types,
                  values: arguments
                }
              )
            }
        }
      }
    }
  }
}

fn checked_specialization_function_in_body(
  product: CheckedBodyProduct,
  wanted: FunctionIdentity
) -> Option<CheckedSpecializationFunction> {
  let mut index: usize = 0
  while index < product.function_count() {
    if function_identity_eq(product.function(index).signature.identity, wanted) {
      return Some<CheckedSpecializationFunction>(
        CheckedSpecializationFunction {
          product: product,
          function_index: index
        }
      )
    }
    index = index + 1
  }
  None<CheckedSpecializationFunction>()
}

fn checked_specialization_function(
  bodies: List<CheckedBodyProduct>,
  wanted: FunctionIdentity
) -> Option<CheckedSpecializationFunction> {
  match bodies {
    Nil -> None<CheckedSpecializationFunction>()
    Cons(product, remaining) -> match checked_specialization_function_in_body(
      product,
      wanted
    ) {
      Some(found) -> Some<CheckedSpecializationFunction>(found)
      None -> checked_specialization_function(remaining, wanted)
    }
  }
}

fn checked_specialization_substitution_from(
  product: borrow CheckedBodyProduct,
  function_index: usize,
  arguments: List<SemanticTypeId>,
  position: usize,
  substitution: SemanticTypeSubstitution
) -> SemanticTypeSubstitution {
  match arguments {
    Nil -> substitution
    Cons(argument, remaining) -> {
      let signatures = product.signatures()
      let signature = product.function(function_index).signature
      checked_specialization_substitution_from(
        product,
        function_index,
        remaining,
        position + 1,
        semantic_type_substitution_bind(
          substitution,
          signatures.type_parameter_at(signature, position),
          argument
        )
      )
    }
  }
}

fn checked_specialization_bind_associated_from(
  types: SemanticTypeProductBuilder,
  substitution: SemanticTypeSubstitution,
  variable: SemanticTypeVariable,
  offered: SemanticTypeId,
  witness: borrow SemanticTypeSubstitution,
  offset: usize
) -> CheckedSpecializationBoundSubstitution {
  let catalog = semantic_type_product_catalog(types)
  let graph = catalog.graph_for(offered).unwrap()
  match semantic_type_graph_node(graph, offered) {
    SemanticTraitNode(_, bindings) -> {
      let traits = semantic_type_graph_traits_local(graph)
      if offset >= semantic_type_trait_binding_count(traits, bindings) {
        CheckedSpecializationBoundSubstitution {
          types: types,
          substitution: substitution
        }
      } else {
        let edge = semantic_type_trait_binding_edge(traits, bindings, offset)
        let declaration = semantic_type_graph_trait_binding_declaration(graph, edge)
        let value = semantic_type_graph_trait_binding_type_id(graph, edge)
        let (next_types, concrete) = semantic_type_product_substitute(
          types,
          witness,
          value
        )
        checked_specialization_bind_associated_from(
          next_types,
          semantic_type_substitution_bind_resolved_associated(
            substitution,
            variable,
            declaration,
            concrete
          ),
          variable,
          offered,
          witness,
          offset + 1
        )
      }
    }
    _ -> CheckedSpecializationBoundSubstitution {
      types: types,
      substitution: substitution
    }
  }
}

fn checked_specialization_bound_substitution_from(
  product: borrow CheckedBodyProduct,
  function_index: usize,
  conformances: borrow SemanticConformanceCatalog,
  position: usize,
  types: SemanticTypeProductBuilder,
  substitution: SemanticTypeSubstitution
) -> CheckedSpecializationBoundSubstitution {
  let signatures = product.signatures()
  let signature = product.function(function_index).signature
  if position >= signatures.bound_count(signature) {
    CheckedSpecializationBoundSubstitution {
      types: types,
      substitution: substitution
    }
  } else {
    let bound = signatures.bound_at(signature, position)
    match semantic_type_substitution_get(substitution, bound.variable) {
      None -> checked_specialization_bound_substitution_from(
        product,
        function_index,
        conformances,
        position + 1,
        types,
        substitution
      )
      Some(concrete) -> {
        let (next_types, requested) = semantic_type_product_substitute(
          types,
          substitution,
          bound.trait_atom
        )
        let catalog = semantic_type_product_catalog(next_types)
        match semantic_conformance_catalog_witness(
          catalog,
          conformances,
          concrete,
          requested
        ) {
          SemanticConformanceWitnessMissing ->
            checked_specialization_bound_substitution_from(
              product,
              function_index,
              conformances,
              position + 1,
              next_types,
              substitution
            )
          SemanticConformanceWitnessSelected(offered, witness) -> {
            let resolved = checked_specialization_bind_associated_from(
              next_types,
              substitution,
              bound.variable,
              offered,
              witness,
              0
            )
            checked_specialization_bound_substitution_from(
              product,
              function_index,
              conformances,
              position + 1,
              resolved.types,
              resolved.substitution
            )
          }
        }
      }
    }
  }
}

fn checked_specialization_process_requests(
  universe: borrow CheckedSpecializationUniverse,
  caller: borrow SemanticTypeSubstitution,
  requests: List<CheckedSpecializationRequest>,
  planner: CheckedSpecializationPlanner,
  keys: List<i64>
) -> CheckedSpecializationRequestsResult {
  match requests {
    Nil -> CheckedSpecializationRequestsAccepted(planner, keys)
    Cons(request, remaining) -> {
      let {
        types,
          symbols,
          pending,
          instances,
          functions,
          next_key,
      } = planner
      match checked_specialization_prepare_request(universe, request, types, caller) {
        None -> CheckedSpecializationRequestsRejected(
          CheckedSpecializationCallSignatureMismatch(request.identity)
        )
        Some(prepared) -> match checked_specialization_function(
          universe.bodies,
          prepared.identity
        ) {
          None -> CheckedSpecializationRequestsRejected(
            CheckedSpecializationFunctionMissing(prepared.identity)
          )
          Some(location) -> {
            let product = location.product
            let function_index = location.function_index
            match checked_specialization_materialize_request(
              product,
              function_index,
              prepared
            ) {
              None -> CheckedSpecializationRequestsRejected(
                CheckedSpecializationCallSignatureMismatch(prepared.identity)
              )
              Some(concrete) -> {
                let { types: concrete_types, values } = concrete
                let signature = product.function(function_index).signature
                let signatures = product.signatures()
                let expected = signatures.type_parameter_count(signature)
                let actual = values.len()
                if expected != actual {
                  CheckedSpecializationRequestsRejected(
                    CheckedSpecializationTypeArgumentCount(
                      prepared.identity,
                      expected,
                      actual
                    )
                  )
                } else {
                  let specialization = CheckedFunctionSpecialization {
                    identity: prepared.identity,
                    type_arguments: values
                  }
                  let catalog = semantic_type_product_catalog(concrete_types)
                  match checked_native_function_symbols_resolve_specialization(
                    symbols,
                    catalog,
                    specialization
                  ) {
                    Some(key) -> checked_specialization_process_requests(
                      universe,
                      caller,
                      remaining,
                      CheckedSpecializationPlanner {
                        types: concrete_types,
                        symbols: symbols,
                        pending: pending,
                        instances: instances,
                        functions: functions,
                        next_key: next_key
                      },
                      keys.append(key)
                    )
                    None -> {
                      let conformances = universe.conformances
                      let base_substitution = checked_specialization_substitution_from(
                        product,
                        function_index,
                        values,
                        0,
                        semantic_type_substitution_empty()
                      )
                      let resolved = checked_specialization_bound_substitution_from(
                        product,
                        function_index,
                        conformances,
                        0,
                        concrete_types,
                        base_substitution
                      )
                      checked_specialization_process_requests(
                        universe,
                        caller,
                        remaining,
                        CheckedSpecializationPlanner {
                          types: resolved.types,
                          symbols: checked_native_function_symbols_bind_specialization(
                            symbols,
                            specialization,
                            next_key
                          ),
                          pending: pending.prepend(
                            CheckedSpecializationPending {
                              specialization: specialization,
                              product: product,
                              function_index: function_index,
                              substitution: resolved.substitution
                            }
                          ),
                          instances: instances,
                          functions: functions,
                          next_key: next_key + 1
                        },
                        keys.append(next_key)
                      )
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

fn checked_specialization_plan_pending(
  universe: borrow CheckedSpecializationUniverse,
  planner: CheckedSpecializationPlanner
) -> CheckedSpecializationResult {
  let {
    types,
      symbols,
      pending: pending_instances,
      instances,
      functions,
      next_key,
  } = planner
  match pending_instances {
    Nil -> CheckedSpecializationAccepted(
      CheckedSpecializationPlan {
        catalog: semantic_type_product_catalog(types),
        symbols: symbols,
        instances: instances,
        functions: functions
      }
    )
    Cons(pending, remaining) -> {
      let product = pending.product
      let catalog = semantic_type_product_catalog(types)
      let caller = pending.substitution
      match lower_checked_straight_function_specialization(
        product,
        symbols,
        pending.function_index,
        catalog,
        pending.specialization,
        caller
      ) {
        CheckedStraightFunctionRejected(issue) -> CheckedSpecializationRejected(
          CheckedSpecializationLoweringRejected(pending.specialization, issue)
        )
        CheckedStraightFunctionLowered(function) ->
          match checked_specialization_process_requests(
            universe,
            caller,
            checked_specialization_requests(function),
            CheckedSpecializationPlanner {
              types: types,
              symbols: symbols,
              pending: remaining,
              instances: instances,
              functions: functions,
              next_key: next_key
            },
            Nil<i64>()
          ) {
            CheckedSpecializationRequestsRejected(issue) ->
              CheckedSpecializationRejected(issue)
            CheckedSpecializationRequestsAccepted(after_requests, keys) -> {
              let {
              types: after_types,
                symbols: after_symbols,
                pending: after_pending,
                instances: after_instances,
                functions: after_functions,
                next_key: after_key,
            } = after_requests
              match checked_specialization_rewrite(function, keys) {
                CheckedSpecializationRewriteRejected -> CheckedSpecializationRejected(
                  CheckedSpecializationRewriteMismatch
                )
                CheckedSpecializationRewritten(rewritten, _) -> {
                  let after_catalog = semantic_type_product_catalog(after_types)
                  let declaration_catalog = product.declarations()
                  match checked_specialization_legalize_function(
                    rewritten,
                    after_catalog,
                    declaration_catalog,
                    caller
                  ) {
                    CheckedSpecializationLegalizeRejected(value_type) ->
                      CheckedSpecializationRejected(
                        CheckedSpecializationLayoutUnavailable(value_type)
                      )
                    CheckedSpecializationLegalized(concrete) ->
                      checked_specialization_plan_pending(
                        universe,
                        CheckedSpecializationPlanner {
                          types: after_types,
                          symbols: after_symbols,
                          pending: after_pending,
                          instances: after_instances.append(pending.specialization),
                          functions: after_functions.append(concrete),
                          next_key: after_key
                        }
                      )
                  }
                }
              }
            }
          }
      }
    }
  }
}

fn checked_specialization_seed_from(
  product: CheckedBodyProduct,
  index: usize,
  planner: CheckedSpecializationPlanner
) -> CheckedSpecializationPlanner {
  if index >= product.function_count() { planner }
  else {
    let signature = product.function(index).signature
    let signatures = product.signatures()
    if signatures.type_parameter_count(signature) == 0 {
      let {
        types,
          symbols,
          pending,
          instances,
          functions,
          next_key,
      } = planner
      let specialization = CheckedFunctionSpecialization {
        identity: signature.identity,
        type_arguments: Nil<SemanticTypeId>()
      }
      checked_specialization_seed_from(
        product,
        index + 1,
        CheckedSpecializationPlanner {
          types: types,
          symbols: checked_native_function_symbols_bind_specialization(
            symbols,
            specialization,
            next_key
          ),
          pending: pending.append(
            CheckedSpecializationPending {
              specialization: specialization,
              product: product,
              function_index: index,
              substitution: semantic_type_substitution_empty()
            }
          ),
          instances: instances,
          functions: functions,
          next_key: next_key + 1
        }
      )
    } else { checked_specialization_seed_from(product, index + 1, planner) }
  }
}

fn checked_specialization_seed_bodies(
  bodies: List<CheckedBodyProduct>,
  planner: CheckedSpecializationPlanner
) -> CheckedSpecializationPlanner {
  match bodies {
    Nil -> planner
    Cons(product, remaining) -> checked_specialization_seed_bodies(
      remaining,
      checked_specialization_seed_from(product, 0, planner)
    )
  }
}

fn checked_specialization_plan_universe(
  universe: CheckedSpecializationUniverse,
  owner: ModuleIdentity,
  floor: usize
) -> CheckedSpecializationResult {
  let catalog = universe.catalog
  let types = semantic_type_product_continue(
    owner,
    catalog,
    catalog.next_derived_segment(owner, floor)
  )
  let bodies = universe.bodies
  checked_specialization_plan_pending(
    universe,
    checked_specialization_seed_bodies(
      bodies,
      CheckedSpecializationPlanner {
        types: types,
        symbols: checked_native_function_symbols(),
        pending: Nil<CheckedSpecializationPending>(),
        instances: Nil<CheckedFunctionSpecialization>(),
        functions: Nil<IrFunction>(),
        next_key: 1
      }
    )
  )
}

pub(package) fn plan_checked_body_specializations(
  product: CheckedBodyProduct
) -> CheckedSpecializationResult {
  let signatures = product.signatures()
  let expressions = product.expressions()
  let catalog = expressions.types()
  let bodies = [product]
  checked_specialization_plan_universe(
    CheckedSpecializationUniverse {
      catalog: catalog,
      conformances: semantic_conformance_catalog_empty(),
      methods: semantic_method_catalog_empty(),
      bodies: list.from_slice<CheckedBodyProduct>(bodies[..])
    },
    signatures.module(),
    signatures.next_type_segment()
  )
}

fn checked_specialization_program_universe_from(
  program: borrow CheckedProgram,
  index: usize,
  universe: CheckedSpecializationUniverse
) -> CheckedSpecializationUniverse {
  if index >= program.module_count() { universe }
  else {
    let module = program.module_at(index).unwrap()
    let module_body = module.body()
    let product = module_body.ordinary()
    let expressions = product.expressions()
    let catalog = expressions.types()
    let existing = universe.catalog
    let combined = semantic_type_catalog_union(existing, catalog)
    checked_specialization_program_universe_from(
      program,
      index + 1,
      CheckedSpecializationUniverse {
        catalog: combined,
        conformances: universe.conformances,
        methods: universe.methods,
        bodies: universe.bodies.append(product)
      }
    )
  }
}

pub(package) fn plan_checked_program_specializations(
  program: borrow CheckedProgram
) -> CheckedSpecializationResult {
  let root = program.module(program.root()).unwrap()
  let resolution = root.resolution()
  let conformances = resolution.conformances()
  let methods = resolution.methods()
  let universe = checked_specialization_program_universe_from(
    program,
    0,
    CheckedSpecializationUniverse {
      catalog: semantic_type_catalog_empty(program.module_count()),
      conformances: conformances,
      methods: methods,
      bodies: Nil<CheckedBodyProduct>()
    }
  )
  checked_specialization_plan_universe(universe, program.root(), 0)
}

fn checked_specialization_count_handler_clauses(
  clauses: IrSemanticHandlerClauseList,
  tag: i64
) -> i64 {
  match clauses {
    IrSemanticHandlerClauseNil -> 0
    IrSemanticHandlerClauseCons(clause, remaining) ->
      checked_specialization_count_function(clause.body, tag) +
      checked_specialization_count_handler_clauses(remaining, tag)
  }
}

fn checked_specialization_count_handler_return(
  returned: IrSemanticHandleReturn,
  tag: i64
) -> i64 {
  match returned {
    IrSemanticNoHandleReturn -> 0
    IrSemanticHandleReturnTransform(_, function) ->
      checked_specialization_count_function(function, tag)
  }
}

fn checked_specialization_count_handler(
  handler: IrSemanticHandler,
  tag: i64
) -> i64 {
  checked_specialization_count_function(handler.body, tag) +
    checked_specialization_count_handler_clauses(handler.clauses, tag) +
    checked_specialization_count_handler_return(handler.return_clause, tag)
}

fn checked_specialization_count_instructions(
  instructions: IrInstList,
  tag: i64
) -> i64 {
  match instructions {
    IrInstNil -> 0
    IrInstCons(instruction, remaining) -> {
      let nested = match instruction {
        IrSemanticCallI64(_, IrSemanticHandleTarget(handler), _, _) ->
          checked_specialization_count_handler(handler, tag)
        IrSemanticDataI64(_, IrSemanticClosure(function, _, _, _, _), _, _) ->
          checked_specialization_count_function(function, tag)
        IrSemanticDataI64(_, IrSemanticSpecializedClosure(function, _, _, _, _, _), _, _) ->
          checked_specialization_count_function(function, tag)
        _ -> 0
      }
      let current = if ir_inst_tag(instruction) == tag { 1 } else { 0 }
      current + nested + checked_specialization_count_instructions(remaining, tag)
    }
  }
}

fn checked_specialization_count_blocks(blocks: IrBlockList, tag: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(IrBlock(_, _, instructions, _), remaining) ->
      checked_specialization_count_instructions(instructions, tag) +
      checked_specialization_count_blocks(remaining, tag)
  }
}

fn checked_specialization_count_function(function: IrFunction, tag: i64) -> i64 {
  match function {
    IrFunction(_, _, blocks, _) -> checked_specialization_count_blocks(blocks, tag)
  }
}

fn checked_specialization_call_target_kind(target: IrSemanticCallTarget) -> i64 {
  match target {
    IrSemanticGenericTarget(_, _) -> 1
    IrSemanticApplyTarget(_, _, _) -> 2
    IrSemanticMethodTarget(_, _, _) -> 3
    IrSemanticAssociatedTarget(_, _, _) -> 4
    IrSemanticPerformTarget(_, _, _) -> 5
    IrSemanticHandleTarget(_) -> 6
    IrSemanticResumeTarget(_) -> 7
  }
}

fn checked_specialization_count_call_handler_clauses(
  clauses: IrSemanticHandlerClauseList,
  kind: i64
) -> i64 {
  match clauses {
    IrSemanticHandlerClauseNil -> 0
    IrSemanticHandlerClauseCons(clause, remaining) ->
      checked_specialization_count_calls(clause.body, kind) +
      checked_specialization_count_call_handler_clauses(remaining, kind)
  }
}

fn checked_specialization_count_call_handler_return(
  returned: IrSemanticHandleReturn,
  kind: i64
) -> i64 {
  match returned {
    IrSemanticNoHandleReturn -> 0
    IrSemanticHandleReturnTransform(_, function) ->
      checked_specialization_count_calls(function, kind)
  }
}

fn checked_specialization_count_call_handler(
  handler: IrSemanticHandler,
  kind: i64
) -> i64 {
  checked_specialization_count_calls(handler.body, kind) +
    checked_specialization_count_call_handler_clauses(handler.clauses, kind) +
    checked_specialization_count_call_handler_return(handler.return_clause, kind)
}

fn checked_specialization_count_call_instructions(
  instructions: IrInstList,
  kind: i64
) -> i64 {
  match instructions {
    IrInstNil -> 0
    IrInstCons(instruction, remaining) -> {
      let current = match instruction {
        IrSemanticCallI64(_, target, _, _) -> {
          let nested = match target {
            IrSemanticHandleTarget(handler) ->
              checked_specialization_count_call_handler(handler, kind)
            _ -> 0
          }
          (if checked_specialization_call_target_kind(target) == kind { 1 } else { 0 }) +
            nested
        }
        IrSemanticDataI64(_, IrSemanticClosure(function, _, _, _, _), _, _) ->
          checked_specialization_count_calls(function, kind)
        IrSemanticDataI64(_, IrSemanticSpecializedClosure(function, _, _, _, _, _), _, _) ->
          checked_specialization_count_calls(function, kind)
        _ -> 0
      }
      current + checked_specialization_count_call_instructions(remaining, kind)
    }
  }
}

fn checked_specialization_count_call_blocks(blocks: IrBlockList, kind: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(IrBlock(_, _, instructions, _), remaining) ->
      checked_specialization_count_call_instructions(instructions, kind) +
      checked_specialization_count_call_blocks(remaining, kind)
  }
}

fn checked_specialization_count_calls(function: IrFunction, kind: i64) -> i64 {
  match function {
    IrFunction(_, _, blocks, _) -> checked_specialization_count_call_blocks(blocks, kind)
  }
}

fn checked_specialization_data_kind(operation: IrSemanticDataOp) -> i64 {
  match operation {
    IrSemanticFunctionReference(_, _) -> 1
    IrSemanticDeclaredFieldAccess(_, _, _) -> 2
    IrSemanticStructuralFieldAccess(_, _) -> 3
    IrSemanticIndexedLength(_, _) -> 4
    IrSemanticIndexedGet(_, _) -> 5
    IrSemanticRecordInit(_, _) -> 6
    IrSemanticArrayLiteral(_) -> 7
    IrSemanticMutableSlot(_, _, _) -> 8
    IrSemanticClosure(_, _, _, _, _) -> 9
    IrSemanticSpecializedClosure(_, _, _, _, _, _) -> 9
  }
}

fn checked_specialization_count_data_handler_clauses(
  clauses: IrSemanticHandlerClauseList,
  kind: i64
) -> i64 {
  match clauses {
    IrSemanticHandlerClauseNil -> 0
    IrSemanticHandlerClauseCons(clause, remaining) ->
      checked_specialization_count_data(clause.body, kind) +
      checked_specialization_count_data_handler_clauses(remaining, kind)
  }
}

fn checked_specialization_count_data_handler_return(
  returned: IrSemanticHandleReturn,
  kind: i64
) -> i64 {
  match returned {
    IrSemanticNoHandleReturn -> 0
    IrSemanticHandleReturnTransform(_, function) ->
      checked_specialization_count_data(function, kind)
  }
}

fn checked_specialization_count_data_handler(
  handler: IrSemanticHandler,
  kind: i64
) -> i64 {
  checked_specialization_count_data(handler.body, kind) +
    checked_specialization_count_data_handler_clauses(handler.clauses, kind) +
    checked_specialization_count_data_handler_return(handler.return_clause, kind)
}

fn checked_specialization_count_data_instructions(
  instructions: IrInstList,
  kind: i64
) -> i64 {
  match instructions {
    IrInstNil -> 0
    IrInstCons(instruction, remaining) -> {
      let current = match instruction {
        IrSemanticCallI64(_, IrSemanticHandleTarget(handler), _, _) ->
          checked_specialization_count_data_handler(handler, kind)
        IrSemanticDataI64(_, operation, _, _) -> {
          let nested = match operation {
            IrSemanticClosure(function, _, _, _, _) ->
              checked_specialization_count_data(function, kind)
            IrSemanticSpecializedClosure(function, _, _, _, _, _) ->
              checked_specialization_count_data(function, kind)
            _ -> 0
          }
          (if checked_specialization_data_kind(operation) == kind { 1 } else { 0 }) +
            nested
        }
        _ -> 0
      }
      current + checked_specialization_count_data_instructions(remaining, kind)
    }
  }
}

fn checked_specialization_count_data_blocks(blocks: IrBlockList, kind: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(IrBlock(_, _, instructions, _), remaining) ->
      checked_specialization_count_data_instructions(instructions, kind) +
      checked_specialization_count_data_blocks(remaining, kind)
  }
}

fn checked_specialization_count_data(function: IrFunction, kind: i64) -> i64 {
  match function {
    IrFunction(_, _, blocks, _) -> checked_specialization_count_data_blocks(blocks, kind)
  }
}

impl CheckedSpecializationPlan {
  pub(package) fn instance_count(self: borrow Self) -> usize {
    let { catalog: _, symbols: _, instances, functions: _ } = self
    instances.len()
  }

  pub(package) fn function_count(self: borrow Self) -> usize {
    let { catalog: _, symbols: _, instances: _, functions } = self
    functions.len()
  }

  pub(package) fn instruction_count(self: borrow Self, tag: i64) -> i64 {
    let { catalog: _, symbols: _, instances: _, functions } = self
    let mut count: i64 = 0
    let mut remaining = functions
    loop {
      match remaining {
        Nil -> return count
        Cons(function, rest) -> {
          count = count + checked_specialization_count_function(function, tag)
          remaining = rest
        }
      }
    }
    count
  }

  pub(package) fn semantic_call_count(self: borrow Self, kind: i64) -> i64 {
    let { catalog: _, symbols: _, instances: _, functions } = self
    let mut count: i64 = 0
    let mut remaining = functions
    loop {
      match remaining {
        Nil -> return count
        Cons(function, rest) -> {
          count = count + checked_specialization_count_calls(function, kind)
          remaining = rest
        }
      }
    }
    count
  }

  pub(package) fn semantic_data_count(self: borrow Self, kind: i64) -> i64 {
    let { catalog: _, symbols: _, instances: _, functions } = self
    let mut count: i64 = 0
    let mut remaining = functions
    loop {
      match remaining {
        Nil -> return count
        Cons(function, rest) -> {
          count = count + checked_specialization_count_data(function, kind)
          remaining = rest
        }
      }
    }
    count
  }
}
