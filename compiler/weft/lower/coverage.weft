-- Deterministic coverage census for the typed lowering cutover.
--
-- The migration gate scans immutable checked products rather than syntax or
-- legacy nodes. Every unsupported expression remains named and counted until
-- its typed lowering interpretation lands.

use compiler/weft/check/body/graph.{*}
use compiler/weft/check/body/handler_product.{CheckedHandlerBodyProduct}
use compiler/weft/check/body/product.{CheckedBodyProduct}
use compiler/weft/check/body/pattern.{
  CheckedBindingPatternKind,
  CheckedConstructorPatternKind,
  CheckedIntegerPatternKind,
  CheckedNilPatternKind,
  CheckedPatternKind,
  CheckedRecordPatternKind,
  CheckedTuplePatternKind,
  CheckedTypedBindingPatternKind,
  CheckedWildcardPatternKind
}
use compiler/weft/check/checked_program.{CheckedProgram}
use compiler/ir/data.{
  ir_function_block_count,
  ir_function_block_param_count,
  ir_function_count_tag,
  ir_function_count_term_tag,
  ir_function_first_generic_type_arg_count_or,
  ir_function_edges_match_block_params
}
use compiler/weft/lower/straight.{
  CheckedStraightBindingMissing,
  CheckedStraightBindingNotMutable,
  CheckedStraightControlOutsideLoop,
  CheckedStraightFunctionLowered,
  CheckedStraightFunctionRejected,
  CheckedStraightFunctionSymbolMissing,
  CheckedStraightManagedMutableUnsupported,
  CheckedStraightResumeOutsideHandler,
  CheckedStraightUnsupportedPattern,
  CheckedStraightUnsupportedExpression,
  CheckedStraightValueShapeUnavailable,
  CheckedStraightWideValueUnsupported,
  checked_straight_kind_supported,
  lower_checked_straight_function
}
use compiler/weft/lower/symbols.{
  CheckedNativeFunctionSymbols,
  checked_native_function_symbols,
  checked_native_function_symbols_bind
}
use compiler/project/identity.{
  DeclaredFunctionIdentity,
  FunctionIdentity,
  IntrinsicFunctionIdentity,
  ModuleFunctionIdentity
}
use stdlib/list.{Cons, List, Nil}
use stdlib/num/scalar.{num_scalar_usize_to_i64}
use stdlib/option.{None, Option, Some}
use stdlib/string.{int_to_str, str_concat}

pub(package) type CheckedLoweringGap {
  kind: CheckedExprKind,
  count: usize
}

pub(package) type CheckedLoweringCoverage {
  modules: usize,
  functions: usize,
  handler_bodies: usize,
  expressions: usize,
  kind_supported: usize,
  gaps: List<CheckedLoweringGap>
}

pub(package) type CheckedLoweringAttemptCoverage {
  functions: usize,
  lowered: usize,
  unsupported_kinds: List<CheckedLoweringGap>,
  unsupported_patterns: List<CheckedLoweringPatternGap>,
  missing_symbols: CheckedLoweringMissingSymbols,
  missing_bindings: usize,
  unavailable_shapes: usize,
  wide_values: usize,
  managed_mutables: usize
}

pub(package) type CheckedLoweringPatternGap {
  kind: CheckedPatternKind,
  count: usize
}

pub(package) type CheckedLoweringMissingSymbols {
  declared: usize,
  module: usize,
  intrinsic: usize
}

pub(package) type CheckedLoweringFunctionShape {
  blocks: usize,
  block_parameters: usize,
  branches: usize,
  jumps: usize,
  returns: usize,
  slots: usize,
  loads: usize,
  stores: usize,
  semantic_generic_calls: usize,
  first_generic_type_arguments: usize,
  edges_match: bool
}

pub(package) fn checked_expr_kind_code(kind: CheckedExprKind) -> usize {
  match kind {
    CheckedIntegerKind -> 1
    CheckedBooleanKind -> 2
    CheckedNilKind -> 3
    CheckedStringKind -> 4
    CheckedFloatKind -> 5
    CheckedLocalReferenceKind -> 6
    CheckedSharedBorrowKind -> 7
    CheckedExclusiveBorrowKind -> 8
    CheckedDeclarationReferenceKind -> 9
    CheckedNotKind -> 10
    CheckedNegateKind -> 11
    CheckedBinaryKind -> 12
    CheckedIfKind -> 13
    CheckedBlockKind -> 14
    CheckedLetKind -> 15
    CheckedLetMutKind -> 16
    CheckedAssignKind -> 17
    CheckedWhileKind -> 18
    CheckedLoopKind -> 19
    CheckedBreakKind -> 20
    CheckedBreakNoValueKind -> 21
    CheckedContinueKind -> 22
    CheckedReturnKind -> 23
    CheckedDeferKind -> 24
    CheckedDirectCallKind -> 25
    CheckedConstructorCallKind -> 26
    CheckedApplyKind -> 27
    CheckedGenericCallKind -> 28
    CheckedMethodCallKind -> 29
    CheckedAssociatedCallKind -> 30
    CheckedAddressOfKind -> 31
    CheckedDerefKind -> 32
    CheckedPointerAssignKind -> 33
    CheckedInterpolationConcatKind -> 34
    CheckedDeclaredFieldAccessKind -> 35
    CheckedStructuralFieldAccessKind -> 36
    CheckedIndexedLengthKind -> 37
    CheckedIndexedGetKind -> 38
    CheckedIndexedSetKind -> 39
    CheckedIndexedSliceKind -> 40
    CheckedRecordInitKind -> 41
    CheckedRecordUpdateKind -> 42
    CheckedArrayLiteralKind -> 43
    CheckedLambdaKind -> 44
    CheckedPerformKind -> 45
    CheckedHandleKind -> 46
    CheckedResumeKind -> 47
    CheckedHandlerInstallKind -> 48
    CheckedFailurePropagationKind -> 49
    CheckedDeclaredOptionalProjectionKind -> 50
    CheckedStructuralOptionalProjectionKind -> 51
    CheckedExplicitMatchKind -> 52
    CheckedLetDestructuringKind -> 53
    CheckedForDestructuringKind -> 54
  }
}

pub(package) fn checked_expr_kind_name(kind: CheckedExprKind) -> str {
  match kind {
    CheckedIntegerKind -> "integer"
    CheckedBooleanKind -> "boolean"
    CheckedNilKind -> "nil"
    CheckedStringKind -> "string"
    CheckedFloatKind -> "float"
    CheckedLocalReferenceKind -> "local_reference"
    CheckedSharedBorrowKind -> "shared_borrow"
    CheckedExclusiveBorrowKind -> "exclusive_borrow"
    CheckedDeclarationReferenceKind -> "declaration_reference"
    CheckedNotKind -> "not"
    CheckedNegateKind -> "negate"
    CheckedBinaryKind -> "binary"
    CheckedIfKind -> "if"
    CheckedBlockKind -> "block"
    CheckedLetKind -> "let"
    CheckedLetMutKind -> "let_mut"
    CheckedAssignKind -> "assign"
    CheckedWhileKind -> "while"
    CheckedLoopKind -> "loop"
    CheckedBreakKind -> "break"
    CheckedBreakNoValueKind -> "break_no_value"
    CheckedContinueKind -> "continue"
    CheckedReturnKind -> "return"
    CheckedDeferKind -> "defer"
    CheckedDirectCallKind -> "direct_call"
    CheckedConstructorCallKind -> "constructor_call"
    CheckedApplyKind -> "apply"
    CheckedGenericCallKind -> "generic_call"
    CheckedMethodCallKind -> "method_call"
    CheckedAssociatedCallKind -> "associated_call"
    CheckedAddressOfKind -> "address_of"
    CheckedDerefKind -> "deref"
    CheckedPointerAssignKind -> "pointer_assign"
    CheckedInterpolationConcatKind -> "interpolation_concat"
    CheckedDeclaredFieldAccessKind -> "declared_field_access"
    CheckedStructuralFieldAccessKind -> "structural_field_access"
    CheckedIndexedLengthKind -> "indexed_length"
    CheckedIndexedGetKind -> "indexed_get"
    CheckedIndexedSetKind -> "indexed_set"
    CheckedIndexedSliceKind -> "indexed_slice"
    CheckedRecordInitKind -> "record_init"
    CheckedRecordUpdateKind -> "record_update"
    CheckedArrayLiteralKind -> "array_literal"
    CheckedLambdaKind -> "lambda"
    CheckedPerformKind -> "perform"
    CheckedHandleKind -> "handle"
    CheckedResumeKind -> "resume"
    CheckedHandlerInstallKind -> "handler_install"
    CheckedFailurePropagationKind -> "failure_propagation"
    CheckedDeclaredOptionalProjectionKind -> "declared_optional_projection"
    CheckedStructuralOptionalProjectionKind -> "structural_optional_projection"
    CheckedExplicitMatchKind -> "explicit_match"
    CheckedLetDestructuringKind -> "let_destructuring"
    CheckedForDestructuringKind -> "for_destructuring"
  }
}

fn checked_lowering_gap_increment(
  gaps: List<CheckedLoweringGap>,
  kind: CheckedExprKind
) -> List<CheckedLoweringGap> {
  let wanted = checked_expr_kind_code(kind)
  match gaps {
    Nil -> gaps.prepend(CheckedLoweringGap { kind: kind, count: 1 })
    Cons(gap, remaining) -> {
      let present = checked_expr_kind_code(gap.kind)
      if wanted == present {
        remaining.prepend(CheckedLoweringGap { kind: gap.kind, count: gap.count + 1 })
      } else {
        if wanted < present {
          gaps.prepend(CheckedLoweringGap { kind: kind, count: 1 })
        } else {
          checked_lowering_gap_increment(remaining, kind).prepend(gap)
        }
      }
    }
  }
}

fn checked_pattern_kind_code(kind: CheckedPatternKind) -> usize {
  match kind {
    CheckedWildcardPatternKind -> 1
    CheckedBindingPatternKind -> 2
    CheckedIntegerPatternKind -> 3
    CheckedConstructorPatternKind -> 4
    CheckedTypedBindingPatternKind -> 5
    CheckedNilPatternKind -> 6
    CheckedRecordPatternKind -> 7
    CheckedTuplePatternKind -> 8
  }
}

fn checked_pattern_kind_name(kind: CheckedPatternKind) -> str {
  match kind {
    CheckedWildcardPatternKind -> "wildcard"
    CheckedBindingPatternKind -> "binding"
    CheckedIntegerPatternKind -> "integer"
    CheckedConstructorPatternKind -> "constructor"
    CheckedTypedBindingPatternKind -> "typed_binding"
    CheckedNilPatternKind -> "nil"
    CheckedRecordPatternKind -> "record"
    CheckedTuplePatternKind -> "tuple"
  }
}

fn checked_lowering_pattern_gap_increment(
  gaps: List<CheckedLoweringPatternGap>,
  kind: CheckedPatternKind
) -> List<CheckedLoweringPatternGap> {
  let wanted = checked_pattern_kind_code(kind)
  match gaps {
    Nil -> gaps.prepend(CheckedLoweringPatternGap { kind: kind, count: 1 })
    Cons(gap, remaining) -> {
      let present = checked_pattern_kind_code(gap.kind)
      if wanted == present {
        remaining.prepend(
          CheckedLoweringPatternGap {
            kind: gap.kind,
            count: gap.count + 1
          }
        )
      } else if wanted < present {
        gaps.prepend(CheckedLoweringPatternGap { kind: kind, count: 1 })
      } else { checked_lowering_pattern_gap_increment(remaining, kind).prepend(gap) }
    }
  }
}

fn checked_lowering_coverage_graph(
  coverage: CheckedLoweringCoverage,
  graph: borrow CheckedExprGraph
) -> CheckedLoweringCoverage {
  let mut kind_supported = coverage.kind_supported
  let mut gaps = coverage.gaps
  let segment = graph.segment()
  let mut ordinal: usize = 0
  while ordinal < graph.len() {
    let kind = graph.kind(checked_expr_id_from_ordinal(segment, ordinal))
    if checked_straight_kind_supported(kind) { kind_supported = kind_supported + 1 }
    else { gaps = checked_lowering_gap_increment(gaps, kind) }
    ordinal = ordinal + 1
  }
  CheckedLoweringCoverage {
    modules: coverage.modules,
    functions: coverage.functions,
    handler_bodies: coverage.handler_bodies,
    expressions: coverage.expressions + graph.len(),
    kind_supported: kind_supported,
    gaps: gaps
  }
}

fn checked_lowering_coverage_body(
  coverage: CheckedLoweringCoverage,
  body: borrow CheckedBodyProduct
) -> CheckedLoweringCoverage {
  let expressions = body.expressions()
  let counted = checked_lowering_coverage_graph(coverage, expressions)
  CheckedLoweringCoverage {
    modules: counted.modules,
    functions: counted.functions + expressions.function_len(),
    handler_bodies: counted.handler_bodies,
    expressions: counted.expressions,
    kind_supported: counted.kind_supported,
    gaps: counted.gaps
  }
}

fn checked_lowering_coverage_handlers(
  coverage: CheckedLoweringCoverage,
  handlers: List<CheckedHandlerBodyProduct>
) -> CheckedLoweringCoverage {
  match handlers {
    Nil -> coverage
    Cons(handler, remaining) -> {
      let expressions = handler.expressions()
      let counted = checked_lowering_coverage_graph(coverage, expressions)
      checked_lowering_coverage_handlers(
        CheckedLoweringCoverage {
          modules: counted.modules,
          functions: counted.functions,
          handler_bodies: counted.handler_bodies + 1,
          expressions: counted.expressions,
          kind_supported: counted.kind_supported,
          gaps: counted.gaps
        },
        remaining
      )
    }
  }
}

pub(package) fn checked_program_lowering_coverage(
  program: borrow CheckedProgram
) -> CheckedLoweringCoverage {
  let mut coverage = CheckedLoweringCoverage {
    modules: program.module_count(),
    functions: 0,
    handler_bodies: 0,
    expressions: 0,
    kind_supported: 0,
    gaps: Nil<CheckedLoweringGap>()
  }
  let mut index: usize = 0
  while index < program.module_count() {
    let module = program.module_at(index).unwrap()
    let body = module.body()
    let ordinary = body.ordinary()
    coverage = checked_lowering_coverage_body(coverage, ordinary)
    coverage = checked_lowering_coverage_handlers(coverage, body.handlers())
    index = index + 1
  }
  coverage
}

fn checked_program_lowering_symbols(
  program: borrow CheckedProgram
) -> CheckedNativeFunctionSymbols {
  let mut symbols = checked_native_function_symbols()
  let mut key: i64 = 1
  let mut module_index: usize = 0
  while module_index < program.module_count() {
    let module = program.module_at(module_index).unwrap()
    let module_body = module.body()
    let body = module_body.ordinary()
    let mut function_index: usize = 0
    while function_index < body.function_count() {
      symbols = checked_native_function_symbols_bind(
        symbols,
        body.function(function_index).signature.identity,
        key
      )
      key = key + 1
      function_index = function_index + 1
    }
    module_index = module_index + 1
  }
  symbols
}

fn checked_lowering_missing_symbol_add(
  missing: CheckedLoweringMissingSymbols,
  identity: FunctionIdentity
) -> CheckedLoweringMissingSymbols {
  match identity {
    DeclaredFunctionIdentity(_) -> CheckedLoweringMissingSymbols {
      declared: missing.declared + 1,
      module: missing.module,
      intrinsic: missing.intrinsic
    }
    ModuleFunctionIdentity(_, _) -> CheckedLoweringMissingSymbols {
      declared: missing.declared,
      module: missing.module + 1,
      intrinsic: missing.intrinsic
    }
    IntrinsicFunctionIdentity(_, _) -> CheckedLoweringMissingSymbols {
      declared: missing.declared,
      module: missing.module,
      intrinsic: missing.intrinsic + 1
    }
  }
}

pub(package) fn checked_program_lowering_attempt_coverage(
  program: borrow CheckedProgram
) -> CheckedLoweringAttemptCoverage {
  let symbols = checked_program_lowering_symbols(program)
  let mut coverage = CheckedLoweringAttemptCoverage {
    functions: 0,
    lowered: 0,
    unsupported_kinds: Nil<CheckedLoweringGap>(),
    unsupported_patterns: Nil<CheckedLoweringPatternGap>(),
    missing_symbols: CheckedLoweringMissingSymbols { declared: 0, module: 0, intrinsic: 0 },
    missing_bindings: 0,
    unavailable_shapes: 0,
    wide_values: 0,
    managed_mutables: 0
  }
  let mut module_index: usize = 0
  while module_index < program.module_count() {
    let module = program.module_at(module_index).unwrap()
    let module_body = module.body()
    let body = module_body.ordinary()
    let mut function_index: usize = 0
    while function_index < body.function_count() {
      coverage = match lower_checked_straight_function(body, symbols, function_index) {
        CheckedStraightFunctionLowered(_) -> CheckedLoweringAttemptCoverage {
          functions: coverage.functions + 1,
          lowered: coverage.lowered + 1,
          unsupported_kinds: coverage.unsupported_kinds,
          unsupported_patterns: coverage.unsupported_patterns,
          missing_symbols: coverage.missing_symbols,
          missing_bindings: coverage.missing_bindings,
          unavailable_shapes: coverage.unavailable_shapes,
          wide_values: coverage.wide_values,
          managed_mutables: coverage.managed_mutables
        }
        CheckedStraightFunctionRejected(issue) -> match issue {
          CheckedStraightResumeOutsideHandler -> CheckedLoweringAttemptCoverage {
            functions: coverage.functions + 1,
            lowered: coverage.lowered,
            unsupported_kinds: checked_lowering_gap_increment(
              coverage.unsupported_kinds,
              CheckedResumeKind
            ),
            unsupported_patterns: coverage.unsupported_patterns,
            missing_symbols: coverage.missing_symbols,
            missing_bindings: coverage.missing_bindings,
            unavailable_shapes: coverage.unavailable_shapes,
            wide_values: coverage.wide_values,
            managed_mutables: coverage.managed_mutables
          }
          CheckedStraightControlOutsideLoop(kind) -> CheckedLoweringAttemptCoverage {
            functions: coverage.functions + 1,
            lowered: coverage.lowered,
            unsupported_kinds: checked_lowering_gap_increment(
              coverage.unsupported_kinds,
              kind
            ),
            unsupported_patterns: coverage.unsupported_patterns,
            missing_symbols: coverage.missing_symbols,
            missing_bindings: coverage.missing_bindings,
            unavailable_shapes: coverage.unavailable_shapes,
            wide_values: coverage.wide_values,
            managed_mutables: coverage.managed_mutables
          }
          CheckedStraightUnsupportedExpression(kind) -> CheckedLoweringAttemptCoverage {
            functions: coverage.functions + 1,
            lowered: coverage.lowered,
            unsupported_kinds: checked_lowering_gap_increment(
              coverage.unsupported_kinds,
              kind
            ),
            unsupported_patterns: coverage.unsupported_patterns,
            missing_symbols: coverage.missing_symbols,
            missing_bindings: coverage.missing_bindings,
            unavailable_shapes: coverage.unavailable_shapes,
            wide_values: coverage.wide_values,
            managed_mutables: coverage.managed_mutables
          }
          CheckedStraightUnsupportedPattern(kind) -> CheckedLoweringAttemptCoverage {
            functions: coverage.functions + 1,
            lowered: coverage.lowered,
            unsupported_kinds: checked_lowering_gap_increment(
              coverage.unsupported_kinds,
              CheckedExplicitMatchKind
            ),
            unsupported_patterns: checked_lowering_pattern_gap_increment(
              coverage.unsupported_patterns,
              kind
            ),
            missing_symbols: coverage.missing_symbols,
            missing_bindings: coverage.missing_bindings,
            unavailable_shapes: coverage.unavailable_shapes,
            wide_values: coverage.wide_values,
            managed_mutables: coverage.managed_mutables
          }
          CheckedStraightFunctionSymbolMissing(identity) -> CheckedLoweringAttemptCoverage {
            functions: coverage.functions + 1,
            lowered: coverage.lowered,
            unsupported_kinds: coverage.unsupported_kinds,
            unsupported_patterns: coverage.unsupported_patterns,
            missing_symbols: checked_lowering_missing_symbol_add(
              coverage.missing_symbols,
              identity
            ),
            missing_bindings: coverage.missing_bindings,
            unavailable_shapes: coverage.unavailable_shapes,
            wide_values: coverage.wide_values,
            managed_mutables: coverage.managed_mutables
          }
          CheckedStraightBindingMissing(_) -> CheckedLoweringAttemptCoverage {
            functions: coverage.functions + 1,
            lowered: coverage.lowered,
            unsupported_kinds: coverage.unsupported_kinds,
            unsupported_patterns: coverage.unsupported_patterns,
            missing_symbols: coverage.missing_symbols,
            missing_bindings: coverage.missing_bindings + 1,
            unavailable_shapes: coverage.unavailable_shapes,
            wide_values: coverage.wide_values,
            managed_mutables: coverage.managed_mutables
          }
          CheckedStraightBindingNotMutable(_) -> CheckedLoweringAttemptCoverage {
            functions: coverage.functions + 1,
            lowered: coverage.lowered,
            unsupported_kinds: coverage.unsupported_kinds,
            unsupported_patterns: coverage.unsupported_patterns,
            missing_symbols: coverage.missing_symbols,
            missing_bindings: coverage.missing_bindings + 1,
            unavailable_shapes: coverage.unavailable_shapes,
            wide_values: coverage.wide_values,
            managed_mutables: coverage.managed_mutables
          }
          CheckedStraightValueShapeUnavailable -> CheckedLoweringAttemptCoverage {
            functions: coverage.functions + 1,
            lowered: coverage.lowered,
            unsupported_kinds: coverage.unsupported_kinds,
            unsupported_patterns: coverage.unsupported_patterns,
            missing_symbols: coverage.missing_symbols,
            missing_bindings: coverage.missing_bindings,
            unavailable_shapes: coverage.unavailable_shapes + 1,
            wide_values: coverage.wide_values,
            managed_mutables: coverage.managed_mutables
          }
          CheckedStraightWideValueUnsupported(_) -> CheckedLoweringAttemptCoverage {
            functions: coverage.functions + 1,
            lowered: coverage.lowered,
            unsupported_kinds: coverage.unsupported_kinds,
            unsupported_patterns: coverage.unsupported_patterns,
            missing_symbols: coverage.missing_symbols,
            missing_bindings: coverage.missing_bindings,
            unavailable_shapes: coverage.unavailable_shapes,
            wide_values: coverage.wide_values + 1,
            managed_mutables: coverage.managed_mutables
          }
          CheckedStraightManagedMutableUnsupported(_) -> CheckedLoweringAttemptCoverage {
            functions: coverage.functions + 1,
            lowered: coverage.lowered,
            unsupported_kinds: coverage.unsupported_kinds,
            unsupported_patterns: coverage.unsupported_patterns,
            missing_symbols: coverage.missing_symbols,
            missing_bindings: coverage.missing_bindings,
            unavailable_shapes: coverage.unavailable_shapes,
            wide_values: coverage.wide_values,
            managed_mutables: coverage.managed_mutables + 1
          }
        }
      }
      function_index = function_index + 1
    }
    module_index = module_index + 1
  }
  coverage
}

pub(package) fn checked_program_root_function_lowering_shape(
  program: borrow CheckedProgram,
  function_index: usize
) -> Option<CheckedLoweringFunctionShape> {
  let root_identity = program.root()
  match program.module(root_identity) {
    None -> None<CheckedLoweringFunctionShape>()
    Some(root) -> {
      let module_body = root.body()
      let body = module_body.ordinary()
      if function_index >= body.function_count() {
        None<CheckedLoweringFunctionShape>()
      } else {
        let symbols = checked_program_lowering_symbols(program)
        match lower_checked_straight_function(body, symbols, function_index) {
          CheckedStraightFunctionRejected(_) -> None<CheckedLoweringFunctionShape>()
          CheckedStraightFunctionLowered(function) -> Some(
            CheckedLoweringFunctionShape {
              blocks: __i64_to_usize(ir_function_block_count(function)),
              block_parameters: __i64_to_usize(
                ir_function_block_param_count(function)
              ),
              branches: __i64_to_usize(ir_function_count_term_tag(function, 3)),
              jumps: __i64_to_usize(ir_function_count_term_tag(function, 2)),
              returns: __i64_to_usize(ir_function_count_term_tag(function, 1)),
              slots: __i64_to_usize(ir_function_count_tag(function, 5)),
              loads: __i64_to_usize(ir_function_count_tag(function, 6)),
              stores: __i64_to_usize(ir_function_count_tag(function, 7)),
              semantic_generic_calls: __i64_to_usize(
                ir_function_count_tag(function, 62)
              ),
              first_generic_type_arguments: __i64_to_usize(
                ir_function_first_generic_type_arg_count_or(function, 0)
              ),
              edges_match: ir_function_edges_match_block_params(function) == 1
            }
          )
        }
      }
    }
  }
}

pub(package) fn checked_program_root_function_rejects_managed_mutable(
  program: borrow CheckedProgram,
  function_index: usize
) -> bool {
  match program.module(program.root()) {
    None -> false
    Some(root) -> {
      let module_body = root.body()
      let body = module_body.ordinary()
      if function_index >= body.function_count() { false }
      else {
        let symbols = checked_program_lowering_symbols(program)
        match lower_checked_straight_function(body, symbols, function_index) {
          CheckedStraightFunctionRejected(CheckedStraightManagedMutableUnsupported(_)) -> true
          _ -> false
        }
      }
    }
  }
}

impl CheckedLoweringCoverage {
  pub(package) fn kind_unsupported(self: borrow Self) -> usize {
    self.expressions - self.kind_supported
  }
}

impl CheckedLoweringAttemptCoverage {
  pub(package) fn rejected(self: borrow Self) -> usize {
    self.functions - self.lowered
  }
}

impl CheckedLoweringMissingSymbols {
  pub(package) fn count(self: borrow Self) -> usize {
    self.declared + self.module + self.intrinsic
  }
}

fn checked_lowering_usize_text(value: usize) -> str {
  int_to_str(num_scalar_usize_to_i64(value).unwrap())
}

fn checked_lowering_gap_report(gaps: List<CheckedLoweringGap>) -> str {
  match gaps {
    Nil -> ""
    Cons(gap, remaining) -> {
      let line = str_concat(
        str_concat(checked_expr_kind_name(gap.kind), "="),
        checked_lowering_usize_text(gap.count)
      )
      let rest = checked_lowering_gap_report(remaining)
      if rest == "" { line } else { str_concat(line, str_concat("\n", rest)) }
    }
  }
}

fn checked_lowering_pattern_gap_report(
  gaps: List<CheckedLoweringPatternGap>
) -> str {
  match gaps {
    Nil -> ""
    Cons(gap, remaining) -> {
      let line = str_concat(
        str_concat(
          str_concat("pattern_", checked_pattern_kind_name(gap.kind)),
          "="
        ),
        checked_lowering_usize_text(gap.count)
      )
      let rest = checked_lowering_pattern_gap_report(remaining)
      if rest == "" { line } else { str_concat(line, str_concat("\n", rest)) }
    }
  }
}

pub(package) fn checked_lowering_coverage_report(
  coverage: CheckedLoweringCoverage
) -> str {
  let summary = str_concat(
    str_concat("modules=", checked_lowering_usize_text(coverage.modules)),
    str_concat(
      str_concat(" functions=", checked_lowering_usize_text(coverage.functions)),
      str_concat(
        str_concat(
          " handler_bodies=",
          checked_lowering_usize_text(coverage.handler_bodies)
        ),
        str_concat(
          str_concat(" expressions=", checked_lowering_usize_text(coverage.expressions)),
          str_concat(
            str_concat(
              " kind_supported=",
              checked_lowering_usize_text(coverage.kind_supported)
            ),
            str_concat(
              " kind_unsupported=",
              checked_lowering_usize_text(coverage.kind_unsupported())
            )
          )
        )
      )
    )
  )
  let gaps = checked_lowering_gap_report(coverage.gaps)
  if gaps == "" { summary } else { str_concat(summary, str_concat("\n", gaps)) }
}

pub(package) fn checked_lowering_attempt_coverage_report(
  coverage: CheckedLoweringAttemptCoverage
) -> str {
  let missing_symbols = coverage.missing_symbols
  let summary = str_concat(
    str_concat("functions=", checked_lowering_usize_text(coverage.functions)),
    str_concat(
      str_concat(" lowered=", checked_lowering_usize_text(coverage.lowered)),
      str_concat(
        str_concat(" rejected=", checked_lowering_usize_text(coverage.rejected())),
        str_concat(
          str_concat(
            " missing_symbols=",
            str_concat(
              checked_lowering_usize_text(missing_symbols.count()),
              str_concat(
                "(",
                str_concat(
                  str_concat(
                    "declared=",
                    checked_lowering_usize_text(missing_symbols.declared)
                  ),
                  str_concat(
                    str_concat(
                      " module=",
                      checked_lowering_usize_text(missing_symbols.module)
                    ),
                    str_concat(
                      str_concat(
                        " intrinsic=",
                        checked_lowering_usize_text(missing_symbols.intrinsic)
                      ),
                      ")"
                    )
                  )
                )
              )
            )
          ),
          str_concat(
            str_concat(
              " missing_bindings=",
              checked_lowering_usize_text(coverage.missing_bindings)
            ),
            str_concat(
              str_concat(
                " unavailable_shapes=",
                checked_lowering_usize_text(coverage.unavailable_shapes)
              ),
              str_concat(
                " wide_values=",
                str_concat(
                  checked_lowering_usize_text(coverage.wide_values),
                  str_concat(
                    " managed_mutables=",
                    checked_lowering_usize_text(coverage.managed_mutables)
                  )
                )
              )
            )
          )
        )
      )
    )
  )
  let expression_gaps = checked_lowering_gap_report(coverage.unsupported_kinds)
  let pattern_gaps = checked_lowering_pattern_gap_report(coverage.unsupported_patterns)
  let with_expressions = if expression_gaps == "" {
    summary
  } else { str_concat(summary, str_concat("\n", expression_gaps)) }
  if pattern_gaps == "" {
    with_expressions
  } else { str_concat(with_expressions, str_concat("\n", pattern_gaps)) }
}
