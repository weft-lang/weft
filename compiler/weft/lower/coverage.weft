-- Deterministic coverage census for the typed lowering cutover.
--
-- The migration gate scans immutable checked products rather than syntax or
-- legacy nodes. Every unsupported expression remains named and counted until
-- its typed lowering interpretation lands.

use compiler/weft/check/body/graph.{*}
use compiler/weft/check/body/handler_product.{CheckedHandlerBodyProduct}
use compiler/weft/check/body/product.{CheckedBodyProduct}
use compiler/weft/check/checked_program.{CheckedProgram}
use compiler/weft/lower/straight.{checked_straight_kind_supported}
use stdlib/list.{Cons, List, Nil}
use stdlib/num/scalar.{num_scalar_usize_to_i64}
use stdlib/option.{Option}
use stdlib/string.{int_to_str, str_concat}

pub(package) type CheckedLoweringGap {
  kind: CheckedExprKind,
  count: usize
}

pub(package) type CheckedLoweringCoverage {
  modules: usize,
  functions: usize,
  handler_bodies: usize,
  expressions: usize,
  kind_supported: usize,
  gaps: List<CheckedLoweringGap>
}

pub(package) fn checked_expr_kind_code(kind: CheckedExprKind) -> usize {
  match kind {
    CheckedIntegerKind -> 1
    CheckedBooleanKind -> 2
    CheckedNilKind -> 3
    CheckedStringKind -> 4
    CheckedFloatKind -> 5
    CheckedLocalReferenceKind -> 6
    CheckedSharedBorrowKind -> 7
    CheckedExclusiveBorrowKind -> 8
    CheckedDeclarationReferenceKind -> 9
    CheckedNotKind -> 10
    CheckedNegateKind -> 11
    CheckedBinaryKind -> 12
    CheckedIfKind -> 13
    CheckedBlockKind -> 14
    CheckedLetKind -> 15
    CheckedLetMutKind -> 16
    CheckedAssignKind -> 17
    CheckedWhileKind -> 18
    CheckedLoopKind -> 19
    CheckedBreakKind -> 20
    CheckedBreakNoValueKind -> 21
    CheckedContinueKind -> 22
    CheckedReturnKind -> 23
    CheckedDeferKind -> 24
    CheckedDirectCallKind -> 25
    CheckedConstructorCallKind -> 26
    CheckedApplyKind -> 27
    CheckedGenericCallKind -> 28
    CheckedMethodCallKind -> 29
    CheckedAssociatedCallKind -> 30
    CheckedAddressOfKind -> 31
    CheckedDerefKind -> 32
    CheckedPointerAssignKind -> 33
    CheckedInterpolationConcatKind -> 34
    CheckedDeclaredFieldAccessKind -> 35
    CheckedStructuralFieldAccessKind -> 36
    CheckedIndexedLengthKind -> 37
    CheckedIndexedGetKind -> 38
    CheckedIndexedSetKind -> 39
    CheckedIndexedSliceKind -> 40
    CheckedRecordInitKind -> 41
    CheckedRecordUpdateKind -> 42
    CheckedArrayLiteralKind -> 43
    CheckedLambdaKind -> 44
    CheckedPerformKind -> 45
    CheckedHandleKind -> 46
    CheckedResumeKind -> 47
    CheckedHandlerInstallKind -> 48
    CheckedFailurePropagationKind -> 49
    CheckedDeclaredOptionalProjectionKind -> 50
    CheckedStructuralOptionalProjectionKind -> 51
    CheckedExplicitMatchKind -> 52
    CheckedLetDestructuringKind -> 53
    CheckedForDestructuringKind -> 54
  }
}

pub(package) fn checked_expr_kind_name(kind: CheckedExprKind) -> str {
  match kind {
    CheckedIntegerKind -> "integer"
    CheckedBooleanKind -> "boolean"
    CheckedNilKind -> "nil"
    CheckedStringKind -> "string"
    CheckedFloatKind -> "float"
    CheckedLocalReferenceKind -> "local_reference"
    CheckedSharedBorrowKind -> "shared_borrow"
    CheckedExclusiveBorrowKind -> "exclusive_borrow"
    CheckedDeclarationReferenceKind -> "declaration_reference"
    CheckedNotKind -> "not"
    CheckedNegateKind -> "negate"
    CheckedBinaryKind -> "binary"
    CheckedIfKind -> "if"
    CheckedBlockKind -> "block"
    CheckedLetKind -> "let"
    CheckedLetMutKind -> "let_mut"
    CheckedAssignKind -> "assign"
    CheckedWhileKind -> "while"
    CheckedLoopKind -> "loop"
    CheckedBreakKind -> "break"
    CheckedBreakNoValueKind -> "break_no_value"
    CheckedContinueKind -> "continue"
    CheckedReturnKind -> "return"
    CheckedDeferKind -> "defer"
    CheckedDirectCallKind -> "direct_call"
    CheckedConstructorCallKind -> "constructor_call"
    CheckedApplyKind -> "apply"
    CheckedGenericCallKind -> "generic_call"
    CheckedMethodCallKind -> "method_call"
    CheckedAssociatedCallKind -> "associated_call"
    CheckedAddressOfKind -> "address_of"
    CheckedDerefKind -> "deref"
    CheckedPointerAssignKind -> "pointer_assign"
    CheckedInterpolationConcatKind -> "interpolation_concat"
    CheckedDeclaredFieldAccessKind -> "declared_field_access"
    CheckedStructuralFieldAccessKind -> "structural_field_access"
    CheckedIndexedLengthKind -> "indexed_length"
    CheckedIndexedGetKind -> "indexed_get"
    CheckedIndexedSetKind -> "indexed_set"
    CheckedIndexedSliceKind -> "indexed_slice"
    CheckedRecordInitKind -> "record_init"
    CheckedRecordUpdateKind -> "record_update"
    CheckedArrayLiteralKind -> "array_literal"
    CheckedLambdaKind -> "lambda"
    CheckedPerformKind -> "perform"
    CheckedHandleKind -> "handle"
    CheckedResumeKind -> "resume"
    CheckedHandlerInstallKind -> "handler_install"
    CheckedFailurePropagationKind -> "failure_propagation"
    CheckedDeclaredOptionalProjectionKind -> "declared_optional_projection"
    CheckedStructuralOptionalProjectionKind -> "structural_optional_projection"
    CheckedExplicitMatchKind -> "explicit_match"
    CheckedLetDestructuringKind -> "let_destructuring"
    CheckedForDestructuringKind -> "for_destructuring"
  }
}

fn checked_lowering_gap_increment(
  gaps: List<CheckedLoweringGap>,
  kind: CheckedExprKind
) -> List<CheckedLoweringGap> {
  let wanted = checked_expr_kind_code(kind)
  match gaps {
    Nil -> gaps.prepend(CheckedLoweringGap { kind: kind, count: 1 })
    Cons(gap, remaining) -> {
      let present = checked_expr_kind_code(gap.kind)
      if wanted == present {
        remaining.prepend(CheckedLoweringGap { kind: gap.kind, count: gap.count + 1 })
      } else {
        if wanted < present {
          gaps.prepend(CheckedLoweringGap { kind: kind, count: 1 })
        } else {
          checked_lowering_gap_increment(remaining, kind).prepend(gap)
        }
      }
    }
  }
}

fn checked_lowering_coverage_graph(
  coverage: CheckedLoweringCoverage,
  graph: borrow CheckedExprGraph
) -> CheckedLoweringCoverage {
  let mut kind_supported = coverage.kind_supported
  let mut gaps = coverage.gaps
  let segment = graph.segment()
  let mut ordinal: usize = 0
  while ordinal < graph.len() {
    let kind = graph.kind(checked_expr_id_from_ordinal(segment, ordinal))
    if checked_straight_kind_supported(kind) { kind_supported = kind_supported + 1 }
    else { gaps = checked_lowering_gap_increment(gaps, kind) }
    ordinal = ordinal + 1
  }
  CheckedLoweringCoverage {
    modules: coverage.modules,
    functions: coverage.functions,
    handler_bodies: coverage.handler_bodies,
    expressions: coverage.expressions + graph.len(),
    kind_supported: kind_supported,
    gaps: gaps
  }
}

fn checked_lowering_coverage_body(
  coverage: CheckedLoweringCoverage,
  body: borrow CheckedBodyProduct
) -> CheckedLoweringCoverage {
  let expressions = body.expressions()
  let counted = checked_lowering_coverage_graph(coverage, expressions)
  CheckedLoweringCoverage {
    modules: counted.modules,
    functions: counted.functions + expressions.function_len(),
    handler_bodies: counted.handler_bodies,
    expressions: counted.expressions,
    kind_supported: counted.kind_supported,
    gaps: counted.gaps
  }
}

fn checked_lowering_coverage_handlers(
  coverage: CheckedLoweringCoverage,
  handlers: List<CheckedHandlerBodyProduct>
) -> CheckedLoweringCoverage {
  match handlers {
    Nil -> coverage
    Cons(handler, remaining) -> {
      let expressions = handler.expressions()
      let counted = checked_lowering_coverage_graph(coverage, expressions)
      checked_lowering_coverage_handlers(
        CheckedLoweringCoverage {
          modules: counted.modules,
          functions: counted.functions,
          handler_bodies: counted.handler_bodies + 1,
          expressions: counted.expressions,
          kind_supported: counted.kind_supported,
          gaps: counted.gaps
        },
        remaining
      )
    }
  }
}

pub(package) fn checked_program_lowering_coverage(
  program: borrow CheckedProgram
) -> CheckedLoweringCoverage {
  let mut coverage = CheckedLoweringCoverage {
    modules: program.module_count(),
    functions: 0,
    handler_bodies: 0,
    expressions: 0,
    kind_supported: 0,
    gaps: Nil<CheckedLoweringGap>()
  }
  let mut index: usize = 0
  while index < program.module_count() {
    let module = program.module_at(index).unwrap()
    let body = module.body()
    let ordinary = body.ordinary()
    coverage = checked_lowering_coverage_body(coverage, ordinary)
    coverage = checked_lowering_coverage_handlers(coverage, body.handlers())
    index = index + 1
  }
  coverage
}

impl CheckedLoweringCoverage {
  pub(package) fn kind_unsupported(self: borrow Self) -> usize {
    self.expressions - self.kind_supported
  }
}

fn checked_lowering_usize_text(value: usize) -> str {
  int_to_str(num_scalar_usize_to_i64(value).unwrap())
}

fn checked_lowering_gap_report(gaps: List<CheckedLoweringGap>) -> str {
  match gaps {
    Nil -> ""
    Cons(gap, remaining) -> {
      let line = str_concat(
        str_concat(checked_expr_kind_name(gap.kind), "="),
        checked_lowering_usize_text(gap.count)
      )
      let rest = checked_lowering_gap_report(remaining)
      if rest == "" { line } else { str_concat(line, str_concat("\n", rest)) }
    }
  }
}

pub(package) fn checked_lowering_coverage_report(
  coverage: CheckedLoweringCoverage
) -> str {
  let summary = str_concat(
    str_concat("modules=", checked_lowering_usize_text(coverage.modules)),
    str_concat(
      str_concat(" functions=", checked_lowering_usize_text(coverage.functions)),
      str_concat(
        str_concat(
          " handler_bodies=",
          checked_lowering_usize_text(coverage.handler_bodies)
        ),
        str_concat(
          str_concat(" expressions=", checked_lowering_usize_text(coverage.expressions)),
          str_concat(
            str_concat(
              " kind_supported=",
              checked_lowering_usize_text(coverage.kind_supported)
            ),
            str_concat(
              " kind_unsupported=",
              checked_lowering_usize_text(coverage.kind_unsupported())
            )
          )
        )
      )
    )
  )
  let gaps = checked_lowering_gap_report(coverage.gaps)
  if gaps == "" { summary } else { str_concat(summary, str_concat("\n", gaps)) }
}
