-- Exact semantic-function to native-key assignment for typed lowering.
--
-- Hashes may accelerate planning, but they never establish identity. Lowering
-- consumes this completed plan so two same-spelled declarations cannot become
-- the same native function by accident.

use compiler/project/identity.{
  FunctionIdentity,
  IntrinsicFunctionIdentity,
  intrinsic_identity_native_key
}
use compiler/project/identity/equality.{function_identity_eq}
use compiler/types/graph.{SemanticTypeId}
use compiler/types/graph/catalog.{SemanticTypeCatalog}
use compiler/types/graph/equality.{semantic_type_catalog_equal}
use stdlib/list.{Cons, List, Nil}
use stdlib/option.{None, Option, Some}

pub(package) type CheckedFunctionSpecialization {
  identity: FunctionIdentity,
  type_arguments: List<SemanticTypeId>
}

pub(package) type CheckedNativeFunctionSymbol {
  specialization: CheckedFunctionSpecialization,
  key: i64
}

pub(package) type CheckedNativeFunctionSymbols = opaque List<CheckedNativeFunctionSymbol>

pub(package) fn checked_native_function_symbols() -> CheckedNativeFunctionSymbols {
  CheckedNativeFunctionSymbols(Nil<CheckedNativeFunctionSymbol>())
}

pub(package) fn checked_native_function_symbols_bind(
  symbols: CheckedNativeFunctionSymbols,
  identity: FunctionIdentity,
  key: i64
) -> CheckedNativeFunctionSymbols {
  checked_native_function_symbols_bind_specialization(
    symbols,
    CheckedFunctionSpecialization {
      identity: identity,
      type_arguments: Nil<SemanticTypeId>()
    },
    key
  )
}

pub(package) fn checked_native_function_symbols_bind_specialization(
  symbols: CheckedNativeFunctionSymbols,
  specialization: CheckedFunctionSpecialization,
  key: i64
) -> CheckedNativeFunctionSymbols {
  match symbols {
    CheckedNativeFunctionSymbols(entries) -> CheckedNativeFunctionSymbols(
      entries.prepend(
        CheckedNativeFunctionSymbol {
          specialization: specialization,
          key: key
        }
      )
    )
  }
}

fn checked_semantic_type_arguments_eq(
  catalog: borrow SemanticTypeCatalog,
  left: List<SemanticTypeId>,
  right: List<SemanticTypeId>
) -> bool {
  match (left, right) {
    (Nil, Nil) -> true
    (Cons(left_type, left_rest), Cons(right_type, right_rest)) ->
      semantic_type_catalog_equal(catalog, left_type, right_type) and
      checked_semantic_type_arguments_eq(catalog, left_rest, right_rest)
    _ -> false
  }
}

pub(package) fn checked_function_specialization_eq(
  catalog: borrow SemanticTypeCatalog,
  left: CheckedFunctionSpecialization,
  right: CheckedFunctionSpecialization
) -> bool {
  function_identity_eq(left.identity, right.identity) and
    checked_semantic_type_arguments_eq(
      catalog,
      left.type_arguments,
      right.type_arguments
    )
}

pub(package) fn checked_native_function_symbols_resolve_specialization(
  symbols: borrow CheckedNativeFunctionSymbols,
  catalog: borrow SemanticTypeCatalog,
  wanted: CheckedFunctionSpecialization
) -> Option<i64> {
  match symbols {
    CheckedNativeFunctionSymbols(entries) -> {
      let mut remaining = entries
      loop {
        match remaining {
          Nil -> return None<i64>()
          Cons(symbol, rest) -> {
            if checked_function_specialization_eq(
              catalog,
              symbol.specialization,
              wanted
            ) { return Some<i64>(symbol.key) }
            remaining = rest
          }
        }
      }
      None<i64>()
    }
  }
}

pub(package) fn checked_native_function_symbols_resolve(
  symbols: borrow CheckedNativeFunctionSymbols,
  identity: FunctionIdentity
) -> Option<i64> {
  match identity {
    IntrinsicFunctionIdentity(_, intrinsic) -> {
      let native_key = intrinsic_identity_native_key(intrinsic)
      if native_key == 0 { None<i64>() } else { Some<i64>(native_key) }
    }
    ordinary -> match symbols {
      CheckedNativeFunctionSymbols(entries) -> {
        let mut remaining = entries
        loop {
          match remaining {
            Nil -> return None<i64>()
            Cons(symbol, rest) -> {
              if function_identity_eq(symbol.specialization.identity, ordinary) and
                symbol.specialization.type_arguments.len() == 0 {
                  return Some<i64>(symbol.key)
                }
              remaining = rest
            }
          }
        }
        None<i64>()
      }
    }
  }
}
