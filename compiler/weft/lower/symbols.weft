-- Exact semantic-function to native-key assignment for typed lowering.
--
-- Hashes may accelerate planning, but they never establish identity. Lowering
-- consumes this completed plan so two same-spelled declarations cannot become
-- the same native function by accident.

use compiler/project/identity.{
  FunctionIdentity,
  IntrinsicFunctionIdentity,
  intrinsic_identity_native_key
}
use compiler/project/identity/equality.{function_identity_eq}
use stdlib/list.{Cons, List, Nil}
use stdlib/option.{None, Option, Some}

pub(package) type CheckedNativeFunctionSymbol {
  identity: FunctionIdentity,
  key: i64
}

pub(package) type CheckedNativeFunctionSymbols = opaque List<CheckedNativeFunctionSymbol>

pub(package) fn checked_native_function_symbols() -> CheckedNativeFunctionSymbols {
  CheckedNativeFunctionSymbols(Nil<CheckedNativeFunctionSymbol>())
}

pub(package) fn checked_native_function_symbols_bind(
  symbols: CheckedNativeFunctionSymbols,
  identity: FunctionIdentity,
  key: i64
) -> CheckedNativeFunctionSymbols {
  match symbols {
    CheckedNativeFunctionSymbols(entries) -> CheckedNativeFunctionSymbols(
      entries.prepend(CheckedNativeFunctionSymbol { identity: identity, key: key })
    )
  }
}

pub(package) fn checked_native_function_symbols_resolve(
  symbols: borrow CheckedNativeFunctionSymbols,
  identity: FunctionIdentity
) -> Option<i64> {
  match identity {
    IntrinsicFunctionIdentity(_, intrinsic) -> {
      let native_key = intrinsic_identity_native_key(intrinsic)
      if native_key == 0 { None<i64>() } else { Some<i64>(native_key) }
    }
    ordinary -> match symbols {
      CheckedNativeFunctionSymbols(entries) -> {
        let mut remaining = entries
        loop {
          match remaining {
            Nil -> return None<i64>()
            Cons(symbol, rest) -> {
              if function_identity_eq(symbol.identity, ordinary) {
                return Some<i64>(symbol.key)
              }
              remaining = rest
            }
          }
        }
        None<i64>()
      }
    }
  }
}
