-- Weft's semantic grammar interpretation over an assembled module graph.
-- The grammar has no source-acquisition or native-emission authority.

use compiler/weft/check/host_types as host_types
use compiler/weft/check/host_types.{HostTypeIdentity}
use compiler/diagnostic/observe.{observe_errors}
use compiler/weft/products.{AstModule, TypedModule}
use compiler/source/loading.{SourceLoader, source_loader_owners}
use compiler/source/owners as source_owners
use compiler/source/owners.{SourceOwners}
use compiler/project/module.{module_scope_build_all}
use compiler/project/diagnostics.{module_diagnose_scope_issues}
use compiler/package/exports.{package_export_audit_loaded}
use compiler/weft/check/table.{ttable_program_entry_source_or, ttable_set_ct}
use compiler/weft/check/body.{prepare_root_entrypoint_effects, check_root_entrypoint_effects, typeck_resolve_qualified_impl_traits, typeck_prepare_impl_target_representations, build_ctable, ctable_conforms_type_atom, check_user_fns, check_user_fns_extending_checked}
use compiler/types/algebra.{Conformance}
use stdlib/diagnostic.{Diagnose}
use stdlib/grammar.{CheckedGrammar, CheckResult, Checked, CheckRejected}
use stdlib/typecheck.{TypeCheck}

pub(package) type WeftCheckPurpose {
  CheckProgram,
  CheckDeclarations,
  ExtendCheckedProgram
}

pub(package) type WeftChecker { WeftChecker(WeftCheckPurpose) }

-- Error totals are diagnostic metadata, never a substitute for the result.
-- Failed checks retain acquired sources for diagnostic/fact inspection.
pub(package) type WeftCheckReport {
  result: CheckResult<TypedModule>,
  errors: i64,
  owners: SourceOwners
}

impl CheckedGrammar for WeftChecker {
  type Syntax = AstModule
  type Checked = TypedModule
  type Identity = HostTypeIdentity

  fn check(self, syntax: AstModule) -[TypeCheck<HostTypeIdentity>, Diagnose]> CheckResult<TypedModule> {
    let purpose = match self { WeftChecker(purpose) -> purpose }
    match syntax {
      AstModule(functions, source, table, owners) -> {
        let entry_source = ttable_program_entry_source_or(table, source)
        match purpose {
          CheckDeclarations -> nil
          _ -> prepare_root_entrypoint_effects(functions, entry_source)
        }
        module_scope_build_all(table)
        let scope_errors = module_diagnose_scope_issues(table)
        let export_errors = package_export_audit_loaded(table)
        let trait_errors = typeck_resolve_qualified_impl_traits(table)
        let representation_errors = typeck_prepare_impl_target_representations(table)
        let conformance = build_ctable(table, source)
        ttable_set_ct(table, conformance)
        let body_errors = handle match purpose {
          ExtendCheckedProgram -> check_user_fns_extending_checked(functions, source, table)
          _ -> check_user_fns(functions, source, table)
        } {
          Conformance.conforms(ty, tr) -> resume(ctable_conforms_type_atom(conformance, ty, tr))
        }
        let errors = scope_errors + export_errors + trait_errors + representation_errors + body_errors
        let entry_errors = if errors != 0 { 0 } else { match purpose {
            CheckDeclarations -> 0
            _ -> check_root_entrypoint_effects(functions, entry_source, table)
          } }
        if errors + entry_errors == 0 { Checked(TypedModule(functions, source, table, owners)) }
        else { CheckRejected<TypedModule>() }
      }
    }
  }
}

pub(package) fn with_purpose(purpose: WeftCheckPurpose, syntax: AstModule) -[Diagnose]> CheckResult<TypedModule> {
  match syntax {
    AstModule(_, source, table, _) ->
      host_types.run(table, source, () => WeftChecker(purpose).check(syntax))
  }
}

pub(package) fn program(syntax: AstModule) -[Diagnose]> CheckResult<TypedModule> {
  with_purpose(CheckProgram, syntax)
}

pub(package) fn report_value(result: CheckResult<TypedModule>, errors: i64, owners: SourceOwners) -> WeftCheckReport {
  let count = match result {
    Checked(_) -> errors
    CheckRejected -> if errors == 0 { 1 } else { errors }
  }
  WeftCheckReport { result: result, errors: count, owners: owners }
}

pub(package) fn report(purpose: WeftCheckPurpose, syntax: AstModule) -[Diagnose]> WeftCheckReport {
  let (result, errors) = observe_errors(() => with_purpose(purpose, syntax))
  match syntax { AstModule(_, _, _, owners) -> report_value(result, errors, owners) }
}

-- Host orchestration supplies the acquisition action. Loading diagnostics
-- remain outside the capability-limited grammar and prevent publication of a
-- checked product, even when recovery left semantically valid declarations.
pub(package) fn after_loading<E>(purpose: WeftCheckPurpose, syntax: AstModule, loader: SourceLoader<E>, load: () -[Diagnose, E]> i64) -[Diagnose, E]> CheckResult<TypedModule> {
  let (_, errors) = observe_errors(load)
  if errors != 0 { CheckRejected<TypedModule>() }
  else { match syntax {
      AstModule(functions, source, table, owners) ->
        with_purpose(purpose, AstModule(functions, source, table, source_owners.combined(owners, source_loader_owners(loader))))
    } }
}
