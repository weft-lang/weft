-- compiler/weft/format.weft -- shared, lossless parse-only formatting engine
--
-- The formatter parses retained source and renders its lossless tokens. It
-- verifies token equivalence before returning replacement text; invalid or
-- recovered syntax never produces replacement text.

use compiler/diagnostic/render.{diagnose_report_severity_tag}
use compiler/weft/grammar.{WeftParser}
use compiler/weft/format/config as format_config
use stdlib/grammar.{Grammar, Parsed, Recovered, Rejected}
use stdlib/source.{Source}
use compiler/weft/lex.{*}
use compiler/storage.{src_eq_at}
use compiler/weft/check/table.{ttable_register_source}
use runtime/buffer.{*}
use runtime/memory.{mem_load8_at}
use runtime/string.{runtime_str_from_bytes_copy}
use stdlib/diagnostic/schema.{*}
use stdlib/vector as vector
use stdlib/vector.{*}

pub(package) type FormatterResult {
  FormatterSuccess(str),
  FormatterFailure(i64)
}

type FormatterErrorCount {
  FormatterErrorCount(i64)
}

fn formatter_error_slot_new() -> Vector<FormatterErrorCount> {
  let slot: Vector<FormatterErrorCount> = vector.with_capacity<FormatterErrorCount>(1)
  vector_push<FormatterErrorCount>(slot, FormatterErrorCount(0))
  slot
}

fn formatter_error_slot_get(slot: Vector<FormatterErrorCount>) -> i64 {
  match vector_get_in_bounds<FormatterErrorCount>(slot, 0) {
    FormatterErrorCount(count) -> count
  }
}

fn formatter_error_slot_add(slot: Vector<FormatterErrorCount>) -> nil {
  let count = formatter_error_slot_get(slot)
  vector_set<FormatterErrorCount>(slot, 0, FormatterErrorCount(count + 1))
  nil
}

fn formatter_token_ranges_are_lossless(tokens: i64, source_len: i64) -> bool {
  let count = tok_count(tokens)
  let mut previous_end = 0
  let mut valid = true
  let mut i = 0
  while i < count and valid {
    let start = tok_span(tokens, i)
    let end = tok_end(tokens, i)
    if start < previous_end or end < start or end > source_len {
      valid = false
    } else {
      -- Zero-width ranges are reserved for the EOF sentinel and synthetic
      -- auto-semicolons. Every source token must retain at least one byte.
      if end == start and not (
        tok_tag(tokens, i) == 7 or (tok_tag(tokens, i) == 5 and tok_v1(tokens, i) == 13)
      ) {
        valid = false
      } else { 0 }
      if end > previous_end { previous_end = end } else { 0 }
      i = i + 1
    }
  }
  valid
}

fn formatter_gap_is_attached_trivia(src: i64, start: i64, end: i64) -> bool {
  let mut i = start
  let mut attached = false
  while i < end and not attached {
    -- Line terminators are compared as bytes: a source-literal escape would
    -- make this predicate depend on the very lexer stage it inspects.
    let byte = mem_load8_at(src, i)
    if byte == 10 or byte == 13 {
      attached = true
    } else {
      if i + 1 < end and src_eq_at(src, i, __str_ptr("--"), 0, 2) == 1 {
        attached = true
      } else {
        i = i + 1
      }
    }
  }
  attached
}

fn formatter_next_source_token(tokens: i64, current: i64) -> i64 {
  let count = tok_count(tokens)
  let mut i = current
  while i < count and tok_end(tokens, i) == tok_span(tokens, i) and tok_tag(tokens, i) != 7 {
    i = i + 1
  }
  i
}

fn formatter_gap_indent_depth(tokens: i64, previous: i64, current: i64, depth: i64) -> i64 {
  let next = formatter_next_source_token(tokens, current)
  let closing_curly = next < tok_count(tokens) and tok_tag(tokens, next) == 5 and tok_v1(
    tokens,
    next
  ) == 4
  let base = if closing_curly and depth > 0 { depth - 1 } else { depth }
  if next >= tok_count(tokens) or tok_tag(tokens, next) == 7 { return base } else { 0 }
  -- A zero-width auto-semicolon proves the newline separates statements.
  if next != current { return base } else { 0 }
  let next_tag = tok_tag(tokens, next)
  let next_value = tok_v1(tokens, next)
  if next_tag == 5 and (next_value == 2 or next_value == 4 or next_value == 14) { return base } else {
    0
  }
  if next_tag == 3 and next_value == 4 { return base } else { 0 } -- else
  if previous < 0 { return base } else { 0 }
  if tok_has_layout(tokens, next, LayoutMember) { return base } else { 0 }
  if tok_tag(tokens, previous) == 5 and tok_v1(tokens, previous) == 3 { return base } else { 0 } -- {
  -- No separator and no block boundary means the source newline continues an
  -- expression/signature. Give every continuation one stable extra level.
  base + 1
}

fn formatter_append_indent(out: i64, depth: i64) -> i64 {
  let mut i = 0
  while i < depth * 2 {
    bu8(out, 32)
    i = i + 1
  }
  out
}

fn formatter_gap_is_hspace(src: i64, index: i64) -> bool {
  let byte = mem_load8_at(src, index)
  byte == 32 or byte == 9
}

fn formatter_gap_is_newline(src: i64, index: i64) -> bool {
  let byte = mem_load8_at(src, index)
  byte == 10 or byte == 13
}

fn formatter_comment_end(src: i64, start: i64, end: i64) -> i64 {
  let mut i = start
  while i < end and not formatter_gap_is_newline(src, i) { i = i + 1 }
  i
}

fn formatter_gap_has_comment(src: i64, start: i64, end: i64) -> bool {
  let mut i = start
  let mut found = false
  while i < end and not found {
    if formatter_gap_is_hspace(src, i) or formatter_gap_is_newline(src, i) {
      i = i + 1
    } else {
      found = true
    }
  }
  found
}

fn formatter_top_level_role(tokens: i64, current: i64) -> i64 {
  let next = formatter_next_source_token(tokens, current)
  if next >= tok_count(tokens) { 0 }
  else {
    let role = tok_syntax_role(tokens, next)
    if role == tok_syntax_role_top_level_import() or role == tok_syntax_role_top_level_decl() {
      role
    } else { 0 }
  }
}

fn formatter_gap_follows_synthetic_semicolon(tokens: i64, previous: i64, current: i64) -> bool {
  previous >= 0 and current == formatter_next_source_token(tokens, current) and
    tok_tag(tokens, previous) == 5 and tok_v1(tokens, previous) == 13 and
    tok_span(tokens, previous) == tok_span(tokens, current)
}

fn formatter_append_source_newline(out: i64, src: i64, start: i64, end: i64) -> i64 {
  let mut i = start
  while i < end and not formatter_gap_is_newline(src, i) { i = i + 1 }
  if i >= end {
    bstr(out, "\n")
  } else {
    if mem_load8_at(src, i) == 13 {
      bscopy(out, src + i, 1, 0)
      if i + 1 < end and mem_load8_at(src, i + 1) == 10 { bscopy(out, src + i + 1, 1, 0) } else {
        out
      }
    } else {
      bscopy(out, src + i, 1, 0)
    }
  }
}

fn formatter_top_level_newline_count(current_role: i64, previous_role: i64) -> i64 {
  if current_role == tok_syntax_role_top_level_import() and previous_role ==
    tok_syntax_role_top_level_import() { 1 } else { 2 }
}

fn formatter_append_newlines(out: i64, src: i64, start: i64, end: i64, count: i64) -> i64 {
  let mut i = 0
  while i < count {
    formatter_append_source_newline(out, src, start, end)
    i = i + 1
  }
  out
}

fn formatter_append_top_level_gap(
  out: i64,
  src: i64,
  start: i64,
  end: i64,
  current_role: i64,
  previous_role: i64
) -> i64 {
  if previous_role == 0 { return out } else { 0 }
  formatter_append_newlines(
    out,
    src,
    start,
    end,
    formatter_top_level_newline_count(current_role, previous_role)
  )
}

fn formatter_comment_is_doc(src: i64, start: i64, end: i64) -> bool {
  start + 2 < end and mem_load8_at(src, start) == 45 and mem_load8_at(src, start + 1) == 45 and
    mem_load8_at(src, start + 2) == 45
}

fn formatter_append_top_level_comment_gap(
  out: i64,
  src: i64,
  start: i64,
  end: i64,
  current_role: i64,
  previous_role: i64
) -> i64 {
  let separation = formatter_top_level_newline_count(current_role, previous_role)
  let mut i = start
  let mut saw_source_newline = false
  let mut saw_comment = false
  let mut first_inline = false
  let mut all_leading_docs = true
  while i < end {
    if formatter_gap_is_hspace(src, i) {
      i = i + 1
    } else {
      if formatter_gap_is_newline(src, i) {
        if mem_load8_at(src, i) == 13 and i + 1 < end and mem_load8_at(src, i + 1) == 10 {
          i = i + 2
        } else { i = i + 1 }
        saw_source_newline = true
      } else {
        if not saw_comment {
          first_inline = previous_role != 0 and not saw_source_newline
          if first_inline {
            bstr(out, " ")
          } else {
            if previous_role != 0 {
              formatter_append_newlines(out, src, start, end, separation)
            } else { 0 }
          }
        } else { 0 }
        if previous_role == 0 and not formatter_comment_is_doc(src, i, end) {
          all_leading_docs = false
        } else { 0 }
        let comment_end = formatter_comment_end(src, i, end)
        bscopy(out, src + i, comment_end - i, 0)
        formatter_append_source_newline(out, src, start, end)
        i = comment_end
        if not saw_comment and first_inline and separation > 1 {
          formatter_append_newlines(out, src, start, end, separation - 1)
        } else { 0 }
        saw_comment = true
        saw_source_newline = true
      }
    }
  }
  -- Ordinary leading comments form a module header; doc comments attach
  -- directly to the first declaration/import.
  if previous_role == 0 and not all_leading_docs {
    formatter_append_source_newline(out, src, start, end)
  } else { out }
}

fn formatter_append_trivia_gap(
  out: i64,
  src: i64,
  start: i64,
  end: i64,
  tokens: i64,
  previous: i64,
  current: i64,
  depth: i64,
  target_depth: i64
) -> i64 {
  let next = formatter_next_source_token(tokens, current)
  let comment_depth = if next < tok_count(tokens) and tok_tag(tokens, next) == 5 and tok_v1(
    tokens,
    next
  ) == 4 { depth } else { target_depth }
  let mut i = start
  let mut line_start = previous < 0
  while i < end {
    if formatter_gap_is_hspace(src, i) {
      -- Horizontal trivia is reconstructed at the next comment/token edge.
      i = i + 1
    } else {
      if not formatter_gap_is_newline(src, i) {
        -- The lexer has already proved this gap is trivia. Treat every
        -- non-whitespace run as opaque comment text so future trivia forms and
        -- arbitrary comment bytes can never be rewritten destructively.
        if line_start { formatter_append_indent(out, comment_depth) } else { bstr(out, " ") }
        let comment_end = formatter_comment_end(src, i, end)
        bscopy(out, src + i, comment_end - i, 0)
        i = comment_end
        line_start = false
      } else {
        if mem_load8_at(src, i) == 13 {
          bscopy(out, src + i, 1, 0)
          i = i + 1
          if i < end and mem_load8_at(src, i) == 10 {
            bscopy(out, src + i, 1, 0)
            i = i + 1
          } else { 0 }
          line_start = true
        } else {
          if mem_load8_at(src, i) == 10 {
            bscopy(out, src + i, 1, 0)
            i = i + 1
            line_start = true
          } else { 0 }
        }
      }
    }
  }
  if line_start { formatter_append_indent(out, target_depth) } else { out }
}

fn formatter_punct_attaches_left(value: i64) -> bool {
  value == 2 or value == 5 or value == 6 or value == 8 or
    value == 12 or value == 13 or value == 14 or value == 15
}

fn formatter_punct_attaches_right(value: i64) -> bool {
  value == 1 or value == 8 or value == 11 or value == 15 or
    value == 16 or value == 17
}

fn formatter_token_can_precede_postfix(tokens: i64, index: i64) -> bool {
  let tag = tok_tag(tokens, index)
  if tag == 1 or tag == 2 or tag == 8 or tag == 9 or tag == 13 or tag == 15 { true }
  else {
    if tag == 5 {
      let value = tok_v1(tokens, index)
      value == 2 or value == 4 or value == 12 or value == 14
    } else {
      (
        tag == 4 and tok_v1(tokens, index) == 8 and tok_syntax_role(tokens, index) ==
          tok_syntax_role_generic_angle()
      ) or
        (tag == 3 and tok_v1(tokens, index) == 25)
    }
  }
}

fn formatter_gap_wants_space(tokens: i64, previous: i64, current: i64) -> bool {
  if previous < 0 or tok_tag(tokens, current) == 7 { return false } else { 0 }
  let prev_tag = tok_tag(tokens, previous)
  let prev_value = tok_v1(tokens, previous)
  let current_tag = tok_tag(tokens, current)
  let current_value = tok_v1(tokens, current)
  let current_role = tok_syntax_role(tokens, current)
  let prev_role = tok_syntax_role(tokens, previous)
  if current_role == tok_syntax_role_visibility_qualifier() { return false } else { 0 }
  if current_tag == 4 and current_role == tok_syntax_role_generic_angle() and (
    current_value == 7 or current_value == 8
  ) { return false } else { 0 }
  if prev_tag == 4 and prev_role == tok_syntax_role_generic_angle() and prev_value == 7 {
    return false
  } else { 0 }
  if current_role == tok_syntax_role_module_path() or prev_role == tok_syntax_role_module_path() {
    return false
  } else { 0 }
  if current_role == tok_syntax_role_effect_close() or prev_tag == 11 { return false } else { 0 }
  if current_role == tok_syntax_role_import_selection() or prev_role ==
    tok_syntax_role_import_selection() { return false } else { 0 }
  if (current_tag == 4 and current_value == 20) or (prev_tag == 4 and prev_value == 20) {
    return false
  } else { 0 }
  if current_tag == 5 and formatter_punct_attaches_left(current_value) { return false } else { 0 }
  if prev_tag == 5 and formatter_punct_attaches_right(prev_value) { return false } else { 0 }
  -- Calls/indexing attach to the preceding value, but a keyword followed by
  -- explicit grouping remains visually separated (`if (cond)`).
  if current_tag == 5 and (current_value == 1 or current_value == 17) {
    not formatter_token_can_precede_postfix(tokens, previous)
  } else { true }
}

fn formatter_append_gap(
  out: i64,
  src: i64,
  start: i64,
  end: i64,
  tokens: i64,
  previous: i64,
  current: i64,
  depth: i64,
  previous_top_level_role: i64,
  target_depth: i64,
  line_break: bool,
  newline: str
) -> i64 {
  let top_level_role = if depth == 0 { formatter_top_level_role(tokens, current) } else { 0 }
  if top_level_role != 0 and not formatter_gap_follows_synthetic_semicolon(
    tokens,
    previous,
    current
  ) {
    if formatter_gap_has_comment(src, start, end) {
      return formatter_append_top_level_comment_gap(
        out,
        src,
        start,
        end,
        top_level_role,
        previous_top_level_role
      )
    } else {
      return formatter_append_top_level_gap(
        out,
        src,
        start,
        end,
        top_level_role,
        previous_top_level_role
      )
    }
  } else { 0 }
  if formatter_gap_follows_synthetic_semicolon(tokens, previous, current) { return out } else {
    0
  }
  if line_break and not formatter_gap_is_attached_trivia(src, start, end) {
    bstr(out, newline)
    return formatter_append_indent(out, target_depth)
  } else { 0 }
  -- Adjacent source tokens still need the canonical gap selected by their
  -- grammar roles. Returning early here preserved missing whitespace
  -- (`name:Type=value`, `fn main()->T`) and made formatting depend on whether
  -- the author had already inserted a byte for us to replace.
  if end <= start {
    if formatter_gap_wants_space(tokens, previous, current) { bstr(out, " ") } else { out }
    return out
  } else { 0 }
  if formatter_gap_is_attached_trivia(src, start, end) {
    -- Rebuild only whitespace around comments; comment bytes and newline
    -- spelling/count retain exact source order.
    return formatter_append_trivia_gap(
      out,
      src,
      start,
      end,
      tokens,
      previous,
      current,
      depth,
      target_depth
    )
  } else { 0 }
  if formatter_gap_wants_space(tokens, previous, current) {
    bstr(out, " ")
  } else { out }
}

type FormatterLayout {
  group_ends: owned Vector<i64>,
  signature_ends: owned Vector<i64>,
  prefix: owned Vector<i64>,
  lines: owned Vector<i64>,
  next_break: owned Vector<i64>,
  newline: str
}

type FormatterFrame {
  close: i64,
  indent: i64,
  broken: bool
}

fn formatter_newline(src: i64, length: i64) -> str {
  let mut i = 0
  while i < length {
    let byte = mem_load8_at(src, i)
    if byte == 10 { return "\n" }
    else if byte == 13 {
      if i + 1 < length and mem_load8_at(src, i + 1) == 10 { return "\r\n" }
      else { return "\r" }
    } else { i = i + 1 }
  }
  "\n"
}

-- Width counts Unicode scalars, not UTF-8 bytes. Literal/comment payloads
-- remain indivisible; a newline inside such a token resets the actual column.
fn formatter_column_after(src: i64, start: i64, end: i64, initial: i64) -> i64 {
  let mut column = initial
  for i in start..end {
    let byte = mem_load8_at(src, i)
    if byte == 10 or byte == 13 { column = 0 }
    else if byte < 128 or byte >= 192 { column = column + 1 }
    else { 0 }
  }
  column
}

fn formatter_scalar_width(src: i64, start: i64, end: i64) -> i64 {
  let mut width = 0
  for i in start..end {
    let byte = mem_load8_at(src, i)
    if byte < 128 or byte >= 192 { width = width + 1 } else { 0 }
  }
  width
}

-- Match only parser-published groups. Prefix widths and next-break indices
-- make every rendering decision constant-time, including deeply nested heads.
fn formatter_layout(src: i64, source_len: i64, tokens: i64) -> FormatterLayout {
  let count = tok_count(tokens)
  let capacity = __i64_to_usize(count)
  let group_ends = vector.with_capacity<i64>(capacity)
  let signature_ends = vector.with_capacity<i64>(capacity)
  let prefix = vector.with_capacity<i64>(capacity + 1)
  let lines = vector.with_capacity<i64>(capacity)
  let next_break = vector.with_capacity<i64>(capacity)
  let opens = vector.new<i64>()
  for i in 0..count {
    vector_push(group_ends, - 1)
    vector_push(signature_ends, - 1)
    vector_push(next_break, count)
  }
  vector_push(prefix, 0)
  let mut width = 0
  let mut line = 0
  let mut offset = 0
  let mut previous = - 1
  let mut signature = - 1
  for i in 0..count {
    let start = tok_span(tokens, i)
    let end = tok_end(tokens, i)
    while offset < start {
      let byte = mem_load8_at(src, offset)
      if byte == 10 or byte == 13 { line = line + 1 } else { 0 }
      offset = offset + 1
    }
    vector_push(lines, line)
    if end > start {
      if formatter_gap_wants_space(tokens, previous, i) { width = width + 1 } else { 0 }
      width = width + formatter_scalar_width(src, start, end)
      previous = i
    } else { 0 }
    vector_push(prefix, width)
    if tok_has_layout(tokens, i, LayoutSignatureEnd) and signature >= 0 {
      vector_set(signature_ends, signature, i)
      signature = - 1
    } else { 0 }
    if tok_has_layout(tokens, i, LayoutSignatureStart) { signature = i } else { 0 }
    if tok_has_layout(tokens, i, LayoutGroupClose) and vector_len(opens) > 0 {
      let open = vector_get_in_bounds(opens, vector_len(opens) - 1)
      vector_pop(opens)
      vector_set(group_ends, open, i)
    } else { 0 }
    if tok_has_layout(tokens, i, LayoutGroupOpen) { vector_push(opens, i) } else { 0 }
  }
  let mut following = count
  let mut i = count
  while i > 0 {
    i = i - 1
    vector_set(next_break, i, following)
    if tok_has_layout(tokens, i, LayoutBreak) or tok_has_layout(tokens, i, LayoutGroupClose) {
      following = i
    } else { 0 }
  }
  FormatterLayout {
    group_ends: group_ends,
    signature_ends: signature_ends,
    prefix: prefix,
    lines: lines,
    next_break: next_break,
    newline: formatter_newline(src, source_len)
  }
}

pub(package) fn formatter_render_tokens(src: i64, source_len: i64, tokens: i64) -> str {
  formatter_render_tokens_with_config(src, source_len, tokens, format_config.defaults())
}

pub(package) fn formatter_render_tokens_with_config(
  src: i64,
  source_len: i64,
  tokens: i64,
  config: format_config.Config
) -> str {
  let out = buf_new(source_len + 32)
  let count = tok_count(tokens)
  let { group_ends, signature_ends, prefix, lines, next_break, newline } = formatter_layout(
    src,
    source_len,
    tokens
  )
  let frames = vector.new<FormatterFrame>()
  let mut previous = 0 - 1
  let mut previous_end = 0
  let mut depth = 0
  let mut top_level_role = 0
  let mut column = 0
  let mut line_indent = 0
  let mut signature_end = - 1
  for i in 0..count {
    let start = tok_span(tokens, i)
    let end = tok_end(tokens, i)
    let next = formatter_next_source_token(tokens, i)
    let layout_depth = if vector_len(frames) > 0 {
      let frame = vector_get_in_bounds(frames, vector_len(frames) - 1)
      if frame.broken { frame.indent + 1 } else { depth }
    } else { depth }
    let mut target_depth = formatter_gap_indent_depth(tokens, previous, i, depth)
    if tok_has_layout(tokens, next, LayoutBreak) and not tok_has_layout(
      tokens,
      next,
      LayoutMember
    ) and
      not tok_has_layout(tokens, next, LayoutItem) and not tok_has_layout(
        tokens,
        next,
        LayoutDeclarationBody
      ) {
        target_depth = layout_depth + 1
      } else { nil }
    let mut line_break = false
    if vector_len(frames) > 0 {
      let frame = vector_get_in_bounds(frames, vector_len(frames) - 1)
      if next == frame.close {
        target_depth = frame.indent
        line_break = frame.broken
      } else if frame.broken and (
        tok_has_layout(tokens, next, LayoutMember) or tok_has_layout(tokens, next, LayoutItem)
      ) {
        target_depth = frame.indent + 1
        line_break = true
      } else { 0 }
    } else { 0 }
    if i == next and tok_has_layout(tokens, i, LayoutBreak) and not line_break {
      let boundary = vector_get_in_bounds(next_break, i)
      let segment = vector_get_in_bounds(prefix, boundary) - vector_get_in_bounds(prefix, i)
      if column + segment > config.max_line_length() {
        line_break = true
        target_depth = if tok_has_layout(tokens, i, LayoutDeclarationBody) { depth }
        else if tok_has_layout(tokens, i, LayoutMember) { layout_depth }
        else { layout_depth + 1 }
      } else { 0 }
    } else { 0 }
    let before_gap = buf_len(out)
    formatter_append_gap(
      out,
      src,
      previous_end,
      start,
      tokens,
      previous,
      i,
      depth,
      top_level_role,
      target_depth,
      line_break,
      newline
    )
    if formatter_gap_is_attached_trivia(buf_ptr(out), before_gap, buf_len(out)) {
      line_indent = target_depth
    } else { 0 }
    if end > start {
      bscopy(out, src + start, end - start, 0)
    } else { 0 }
    column = formatter_column_after(buf_ptr(out), before_gap, buf_len(out), column)
    if vector_len(frames) > 0 and vector_get_in_bounds(frames, vector_len(frames) - 1).close ==
      i {
        vector_pop(frames)
      } else { 0 }
    if tok_has_layout(tokens, i, LayoutSignatureEnd) { signature_end = - 1 } else { 0 }
    if tok_has_layout(tokens, i, LayoutSignatureStart) {
      signature_end = vector_get_in_bounds(signature_ends, i)
    } else { 0 }
    let close = vector_get_in_bounds(group_ends, i)
    if close > i {
      let extent = if tok_has_layout(tokens, i, LayoutParameters) and signature_end > close {
        signature_end
      } else { close + 1 }
      let flat_end = vector_get_in_bounds(prefix, extent)
      let remaining = flat_end - vector_get_in_bounds(prefix, i + 1)
      let multiline = vector_get_in_bounds(lines, close) > vector_get_in_bounds(lines, i)
      let nonempty = formatter_next_source_token(tokens, i + 1) != close
      vector_push(
        frames,
        FormatterFrame {
          close: close,
          indent: if tok_has_layout(tokens, i, LayoutDeclarationBody) { depth } else {
            line_indent
          },
          broken: nonempty and (multiline or column + remaining > config.max_line_length())
        }
      )
    } else { 0 }
    if end > previous_end { previous_end = end } else { 0 }
    if end > start and tok_tag(tokens, i) == 5 {
      let value = tok_v1(tokens, i)
      if value == 3 { depth = depth + 1 }
      else { if value == 4 and depth > 0 { depth = depth - 1 } else { 0 } }
    } else { 0 }
    let role = tok_syntax_role(tokens, i)
    if role == tok_syntax_role_top_level_import() or role == tok_syntax_role_top_level_decl() {
      top_level_role = role
    } else { 0 }
    previous = i
  }
  runtime_str_from_bytes_copy(buf_ptr(out), buf_len(out))
}

fn formatter_token_text_equal(
  left_src: i64,
  left_tokens: i64,
  left_index: i64,
  right_src: i64,
  right_tokens: i64,
  right_index: i64
) -> bool {
  let left_start = tok_span(left_tokens, left_index)
  let left_len = tok_end(left_tokens, left_index) - left_start
  let right_start = tok_span(right_tokens, right_index)
  let right_len = tok_end(right_tokens, right_index) - right_start
  left_len == right_len and (
    left_len == 0 or src_eq_at(left_src, left_start, right_src + right_start, 0, left_len) == 1
  )
}

fn formatter_token_payload_equal(
  left_tokens: i64,
  left_index: i64,
  right_tokens: i64,
  right_index: i64
) -> bool {
  let tag = tok_tag(left_tokens, left_index)
  -- Identifiers and literal payloads contain source-relative pointers; exact
  -- lexeme comparison below is their stable equality. Keyword/operator/
  -- punctuation/bool payloads are semantic ids and must match directly.
  if tag == 3 or tag == 4 or tag == 5 or tag == 9 {
    tok_v1(left_tokens, left_index) == tok_v1(right_tokens, right_index)
  } else { true }
}

pub(package) fn formatter_tokens_equivalent(
  left_src: i64,
  left_tokens: i64,
  right_src: i64,
  right_tokens: i64
) -> bool {
  let left_count = tok_count(left_tokens)
  let right_count = tok_count(right_tokens)
  let mut same = true
  let mut left_i = 0
  let mut right_i = 0
  while same and (left_i < left_count or right_i < right_count) {
    -- A top-level declaration/import is already structurally delimited by the
    -- module grammar. Its zero-width automatic semicolon is a lexical no-op,
    -- so formatting may add/remove the preceding newline. Block-local and
    -- explicit semicolons remain exact.
    if left_i < left_count and tok_tag(left_tokens, left_i) == 5 and tok_v1(left_tokens, left_i) ==
      13 and
      tok_end(left_tokens, left_i) == tok_span(left_tokens, left_i) and formatter_top_level_role(
        left_tokens,
        left_i
      ) != 0 {
        left_i = left_i + 1
      } else { 0 }
    if right_i < right_count and tok_tag(right_tokens, right_i) == 5 and tok_v1(
      right_tokens,
      right_i
    ) == 13 and
      tok_end(right_tokens, right_i) == tok_span(right_tokens, right_i) and left_i <
      left_count and
      tok_end(left_tokens, left_i) > tok_span(left_tokens, left_i) and
      (
        tok_syntax_role(left_tokens, left_i) == tok_syntax_role_top_level_import() or
          tok_syntax_role(left_tokens, left_i) == tok_syntax_role_top_level_decl() or
          tok_has_layout(left_tokens, left_i, LayoutOptionalSeparator)
      ) {
        right_i = right_i + 1
      } else { 0 }
    if left_i >= left_count or right_i >= right_count {
      if left_i != left_count or right_i != right_count { same = false } else { 0 }
    } else {
      if tok_tag(left_tokens, left_i) != tok_tag(right_tokens, right_i) or
        not formatter_token_payload_equal(left_tokens, left_i, right_tokens, right_i) {
          same = false
        } else {
          if not formatter_token_text_equal(
            left_src,
            left_tokens,
            left_i,
            right_src,
            right_tokens,
            right_i
          ) {
            same = false
          } else {
            left_i = left_i + 1
            right_i = right_i + 1
          }
        }
    }
  }
  same
}

-- Parse under an audit handler that forwards every structured diagnostic to
-- the caller while retaining only the fatal count needed for fail-closed
-- emission.  Warnings and notes do not suppress otherwise valid output.
pub(package) fn formatter_format_source(src: i64, n: i64, tt: i64) -[Diagnose]> FormatterResult {
  formatter_format_source_with_config(src, n, tt, format_config.defaults())
}

pub(package) fn formatter_format_source_with_config(
  src: i64,
  n: i64,
  tt: i64,
  config: format_config.Config
) -[Diagnose]> FormatterResult {
  ttable_register_source(tt, src, n, 0, 0)
  let source = Source {
    text: runtime_str_from_bytes_copy(src, n),
    identity: DiagnosticSourceBuffer(src)
  }
  formatter_format_text_with_config(source, config)
}

-- Parsing retains source without a checker context. Formatting preserves
-- that source identity when it reports diagnostics.
pub(package) fn formatter_format_text(source: Source) -[Diagnose]> FormatterResult {
  formatter_format_text_with_config(source, format_config.defaults())
}

pub(package) fn formatter_format_text_with_config(
  source: Source,
  config: format_config.Config
) -[Diagnose]> FormatterResult {
  let parser = WeftParser()
  let errors = formatter_error_slot_new()
  let parsed = handle parser.parse(source.all()) {
    Diagnose.report(diagnostic) -> {
      if diagnose_report_severity_tag(diagnostic) == 1 { formatter_error_slot_add(errors) } else {
        nil
      }
      Diagnose.report(diagnostic)
      resume(0)
    }
    Diagnose.error(msg, span) -> {
      formatter_error_slot_add(errors)
      Diagnose.error(msg, span)
      resume(0)
    }
    Diagnose.warn(msg, span) -> {
      Diagnose.warn(msg, span)
      resume(0)
    }
    Diagnose.note(msg, span) -> {
      Diagnose.note(msg, span)
      resume(0)
    }
  }
  let count = formatter_error_slot_get(errors)
  match parsed {
    Recovered(_) -> FormatterFailure(if count > 0 { count } else { 1 })
    Rejected -> FormatterFailure(if count > 0 { count } else { 1 })
    Parsed(syntax) -> {
      let src = __str_ptr(source.text)
      let n = __str_len(source.text)
      let tokens = syntax.tokens
      if count > 0 {
        FormatterFailure(count)
      } else {
        if not formatter_token_ranges_are_lossless(tokens, n) {
          Diagnose.error("formatter: invalid lossless token range", src)
          FormatterFailure(1)
        } else {
          let formatted = formatter_render_tokens_with_config(src, n, tokens, config)
          let formatted_src = __str_ptr(formatted)
          let formatted_len = __str_len(formatted)
          let formatted_tokens = lex(formatted_src, formatted_len)
          if formatter_tokens_equivalent(src, tokens, formatted_src, formatted_tokens) {
            FormatterSuccess(formatted)
          } else {
            Diagnose.error("formatter: token-preservation check failed", src)
            FormatterFailure(1)
          }
        }
      }
    }
  }
}
