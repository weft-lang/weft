-- Validated layout policy shared by every formatting transport.

use stdlib/option.{Option, Some, None}
use stdlib/num as num
use stdlib/result.{Ok, Err}

pub(package) type Config = opaque i64

pub(package) fn defaults() -> Config { Config(98) }

pub(package) fn from_max_line_length(length: i64) -> Option<Config> {
  if length > 0 { Some(Config(length)) } else { None<Config>() }
}

pub(package) fn from_text(text: str) -> Option<Config> {
  match num.parse_i64(text) {
    Ok(length) -> from_max_line_length(length)
    Err(_) -> None<Config>()
  }
}

impl Config {
  pub fn max_line_length(self) -> i64 {
    match self { Config(length) -> length }
  }
}
