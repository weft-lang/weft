  result
}

fn parse_pattern_list_reverse(items: PatternList) -> PatternList {
  let mut remaining = items
  let mut result = PatternListNil
  loop {
    match remaining {
      PatternListNil -> break
      PatternListCons(item, rest) -> {
        result = PatternListCons(item, result)
        remaining = rest
      }
    }
  }
  result
}

fn parse_pattern_field_list_reverse(items: PatternFieldList) -> PatternFieldList {
  let mut remaining = items
