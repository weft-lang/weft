fn parse_type_range(toks: i64, start_pos: i64, end_pos: i64) -> TypeNameRange {
  let start = tok_span(toks, start_pos)
  let last_pos = if end_pos > start_pos { end_pos - 1 } else { start_pos }
  let end = tok_end(toks, last_pos)
  TypeNameRange { start: start, length: if end > start { end - start } else { 1 } }
}

fn parse_type_list_reverse(items: TypeExprList) -> TypeExprList {
  let mut remaining = items
  let mut result = TypeExprListNil
  loop {
    match remaining {
      TypeExprListNil -> break
      TypeExprListCons(item, rest, location) -> {
        result = TypeExprListCons(item, result, location)
        remaining = rest
      }
    }
  }
  result
}

pub(package) fn parse_type_args(
  toks: i64,
  src: i64,
  pos: i64,
  tctx: TypeParamList
) -> SyntaxParse<TypeExprList> {
  let mut reversed = TypeExprListNil
  let mut p = pos
  let mut done = 0
  while done == 0 {
    tok_split_type_close_assignment(toks, p)
    let tag = tok_tag(toks, p)
    if tag == 4 {
      if tok_v1(toks, p) == 8 { done = 1 }
      else {
        let start_pos = p
        tok_note_layout_item(toks, p)
        let parsed = parse_type(toks, src, p, tctx)
        reversed = TypeExprListCons(
          parsed.syntax,
          reversed,
          parse_type_range(toks, start_pos, parsed.next)
        )
        p = skip_comma(toks, parsed.next)
      }
    } else {
      if tag == 7 { done = 1 }
      else {
        let start_pos = p
        tok_note_layout_item(toks, p)
        let parsed = parse_type(toks, src, p, tctx)
        reversed = TypeExprListCons(
          parsed.syntax,
          reversed,
          parse_type_range(toks, start_pos, parsed.next)
        )
        p = skip_comma(toks, parsed.next)
      }
    }
  }
  let end = if tok_tag(toks, p) == 4 {
    if tok_v1(toks, p) == 8 {
      tok_set_syntax_role(toks, pos - 1, tok_syntax_role_generic_angle())
      tok_set_syntax_role(toks, p, tok_syntax_role_generic_angle())
      tok_note_layout_group(toks, pos - 1, p)
      p + 1
    } else { p }
  } else { p }
  syntax_parse(parse_type_list_reverse(reversed), end)
}

-- Effect arrows spell their close as two ordinary punctuation tokens. Accept
-- the historical fused token as well so parser fixtures built from raw token
-- buffers remain valid during the transition.
pub(package) fn parse_effect_close_end(toks: i64, pos: i64) -> i64 {
  if tok_tag(toks, pos) == 12 { pos + 1 }
  else {
    if tok_tag(toks, pos) == 5 and tok_v1(toks, pos) == 14 {
      if tok_tag(toks, pos + 1) == 4 and tok_v1(toks, pos + 1) == 8 {
        tok_set_syntax_role(toks, pos, tok_syntax_role_effect_close())
        tok_set_syntax_role(toks, pos + 1, tok_syntax_role_effect_close())
        pos + 2
      } else { pos }
    } else { pos }
  }
}

-- Parse generic call: name<type_args>(value_args)
pub(package) fn parse_generic_call(
  toks: i64,
  src: i64,
  pos: i64,
  ns: i64,
  nl: i64
) -[Diagnose, TypeParameterScope]> SyntaxParse<Expr> {
  -- pos is at identifier, pos+1 is <
  let types = parse_type_args(toks, src, pos + 2, TypeParameterScope.current())
  -- A dot after the type arguments is an instantiated effect reference;
  -- retain the same GenericCall wrapper around an Ident so the exact atom
  -- survives into checking and monomorphisation. Otherwise parse the normal
  -- generic value call.
  if tok_tag(toks, types.next) == 5 and tok_v1(toks, types.next) == 3 {
    let fields = parse_record_lit_fields(toks, src, types.next + 1, types.next)
    let constructor = NamedTypeExpr(
      effect_name_hash(src, ns, nl),
      HasTypeRepresentation(PrimitiveTypeExpr(PRIM_I64())),
      types.syntax,
      SourceTypeOrigin(TypeNameRange { start: ns, length: nl })
    )
    syntax_parse(
      RecordInit(ns, nl, fields.syntax, ExplicitRecordType(constructor)),
      fields.next
    )
  } else if tok_tag(toks, types.next) == 5 and tok_v1(toks, types.next) == 8 {
    syntax_parse(GenericCall(types.syntax, Ident(ns, nl)), types.next)
  } else {
    let args = parse_call_args(toks, src, types.next + 1)
    syntax_parse(GenericCall(types.syntax, Call(ns, nl, args.syntax)), args.next)
  }
}

pub(package) fn parse_ident_or_call(
  toks: i64,
  src: i64,
  pos: i64
) -[Diagnose, TypeParameterScope]> SyntaxParse<Expr> {
  let v1 = tok_v1(toks, pos)
  let v2 = tok_v2(toks, pos)
  if src_eq(src, v1, v2, "nil") == 1 {
    syntax_parse(NilExpr, pos + 1)
  } else {
    -- Check for generic call: name<type_args>(value_args)
    let next_tag = tok_tag(toks, pos + 1)
    let next_v1 = tok_v1(toks, pos + 1)
    if next_tag == 4 {
      if next_v1 == 7 {
        if is_type_arg_start(toks, pos + 1) == 1 {
          parse_generic_call(toks, src, pos, v1, v2)
        } else { syntax_parse(Ident(v1, v2), pos + 1) }
      } else { syntax_parse(Ident(v1, v2), pos + 1) }
    } else {
      if next_tag == 5 {
        if next_v1 == 1 {
          -- Function call: ident(args)
          parse_call(toks, src, pos, v1, v2)
        } else {
          if next_v1 == 3 {
            -- Check for record constructor: UpperCase { field: value, ... }
            -- Disambiguate from match arms / bare block: peek for ident followed by :
            let first_ch = mem_load8_at(src, v1)
            if first_ch >= 65 {
              if first_ch <= 90 {
                -- Uppercase + { — record literal only if second-inside token is :
                let inside_tag = tok_tag(toks, pos + 3)
                let inside_v1 = tok_v1(toks, pos + 3)
                if inside_tag == 5 {
                  if inside_v1 == 6 {
                    parse_record_lit(toks, src, pos)
                  } else { syntax_parse(Ident(v1, v2), pos + 1) }
                } else { syntax_parse(Ident(v1, v2), pos + 1) }
              } else { syntax_parse(Ident(v1, v2), pos + 1) }
            } else { syntax_parse(Ident(v1, v2), pos + 1) }
          } else {
            syntax_parse(Ident(v1, v2), pos + 1)
          }
        }
      } else {
        syntax_parse(Ident(v1, v2), pos + 1)
      }
    }
  }
}

-- A handler configuration is deliberately not an expression. Its call-shaped
-- syntax is admitted only by `with` and `default handler`, which makes module
-- handler capabilities second-class by construction.
pub(package) fn parse_handler_configuration(
  toks: i64,
  src: i64,
  pos: i64
) -[Diagnose, TypeParameterScope]> SyntaxParse<HandlerConfiguration> {
  if tok_tag(toks, pos) != 2 {
    parse_syntax_error(
      toks,
      src,
      pos,
      "error: expected handler module name",
      "handler configuration",
      "stop_expression"
    )
    syntax_parse(UnknownHandlerConfiguration, pos)
  } else {
    let parsed = parse_ident_or_call(toks, src, pos)
    match parsed.syntax {
      Call(ns, nl, args) ->
        syntax_parse(HandlerConfiguration(ns, nl, TypeExprListNil, args), parsed.next)
      GenericCall(type_args, Call(ns, nl, args)) ->
        syntax_parse(HandlerConfiguration(ns, nl, type_args, args), parsed.next)
      _ -> {
        parse_syntax_error(
          toks,
          src,
          parsed.next,
          "error: handler configuration requires '(...)'",
          "handler configuration",
          "stop_expression"
        )
        syntax_parse(UnknownHandlerConfiguration, parsed.next)
      }
    }
  }
}

-- `with module<types>(args) { body }` remains a typed installation node until
-- checking resolves the exact module/effect/operation facts. AST tag 64 is an
-- expression-only tag (pattern tags use a separate context).
pub(package) fn parse_with_handler_expr(
  toks: i64,
  src: i64,
  pos: i64
) -[Diagnose, TypeParameterScope]> SyntaxParse<Expr> {
  let config = parse_handler_configuration(toks, src, pos + 1)
  let has_body = tok_tag(toks, config.next) == 5 and tok_v1(toks, config.next) == 3
  if has_body == 0 {
    parse_syntax_error(
      toks,
      src,
      config.next,
      "error: expected '{' after handler configuration",
      "with handler",
      "stop_expression"
    )
  } else { 0 }
  let body = if has_body == 1 {
    parse_block(toks, src, config.next + 1)
  } else { syntax_parse(NilExpr, config.next) }
  syntax_parse(
    WithHandler(config.syntax, body.syntax, UnknownHandlerInstallFact, tok_span(toks, pos)),
    body.next
  )
}

pub(package) fn parse_call(
  toks: i64,
  src: i64,
  pos: i64,
  name_start: i64,
  name_len: i64
) -[Diagnose, TypeParameterScope]> SyntaxParse<Expr> {
  -- pos is at ident, pos+1 is (, parse args until )
  let args = parse_call_args(toks, src, pos + 2)
  syntax_parse(Call(name_start, name_len, args.syntax), args.next)
}

pub(package) fn parse_call_args(
  toks: i64,
  src: i64,
  pos: i64
) -[Diagnose, TypeParameterScope]> SyntaxParse<ExprList> {
  let mut p = pos
  let mut reversed = ExprListNil
  let mut done = 0
  let open_pos = pos - 1
  while done == 0 {
    let tag = tok_tag(toks, p)
    let v1 = tok_v1(toks, p)
    -- Check for )
    if tag == 5 {
      if v1 == 2 { done = 1 p = p + 1 }
      else {
        if v1 == 4 {
          parse_missing_delimiter(
            toks,
            src,
            p,
            open_pos,
            "error: expected ')' before '}'",
            ")",
            "argument list",
            "resume_at_block_close"
          )
          done = 1
        }
        else {
          let argument = parse_one_call_arg(toks, src, p)
          reversed = ExprListCons(argument.syntax, reversed)
          p = argument.next
        }
      }
    } else {
      if tag == 7 or is_decl_start(toks, p) == 1 {
        parse_missing_delimiter(
          toks,
          src,
          p,
          open_pos,
          "error: expected ')' after call arguments",
          ")",
          "argument list",
          if tag == 7 { "resume_at_end_of_file" } else { "resume_at_declaration" }
        )
        done = 1
      } else {
        let argument = parse_one_call_arg(toks, src, p)
        reversed = ExprListCons(argument.syntax, reversed)
        p = argument.next
      }
    }
    if done == 0 {
      if tok_tag(toks, p) == 5 and (
        tok_v1(toks, p) == 5 or (tok_v1(toks, p) == 13 and tok_span(toks, p) == tok_end(toks, p))
      ) { p = p + 1 }
      else {
        if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 2 { done = 1 p = p + 1 }
        else {
          if tok_tag(toks, p) == 7 or is_decl_start(toks, p) == 1 or (
            tok_tag(toks, p) == 5 and tok_v1(toks, p) == 4
          ) {
            parse_missing_delimiter(
              toks,
              src,
              p,
              open_pos,
              "error: expected ')' after call arguments",
              ")",
              "argument list",
              if tok_tag(toks, p) == 7 { "resume_at_end_of_file" } else {
                if is_decl_start(toks, p) == 1 { "resume_at_declaration" } else {
                  "resume_at_block_close"
                }
              }
            )
            done = 1
          } else {
            parse_syntax_error(
              toks,
              src,
              p,
              "error: expected ',' or ')' after call argument",
              "argument list",
              "continue_arguments"
            )
            if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 13 { p = p + 1 } else { 0 }
          }
        }
      }
    } else { 0 }
  }
  if tok_tag(toks, p - 1) == 5 and tok_v1(toks, p - 1) == 2 {
    tok_note_layout_group(toks, open_pos, p - 1)
  } else { nil }
  syntax_parse(parse_expr_list_reverse(reversed), p)
}

-- Parse one call argument. Handles named args: `label: expr`
-- Named args are detected when: ident followed by : followed by expr
-- (not a keyword, not at end of args)
pub(package) fn parse_one_call_arg(
  toks: i64,
  src: i64,
  pos: i64
) -[Diagnose, TypeParameterScope]> SyntaxParse<Expr> {
  tok_note_layout_item(toks, pos)
  -- Check for named arg: ident : expr
  -- ident is tag 2, colon is tag 5 val 6
  let is_named = if tok_tag(toks, pos) == 2 {
    if tok_tag(toks, pos + 1) == 5 {
      if tok_v1(toks, pos + 1) == 6 {
        -- Could be named arg. But also could be `x: i64` in a lambda param.
        -- In call context, ident: is always a named arg label.
        1
      } else { 0 }
    } else { 0 }
  } else { 0 }
  if is_named == 1 {
    -- set-theoretic surface: call-site argument labels were parsed and silently DISCARDED —
    -- never validated against the declaration, never reordered. Until
    -- named-argument semantics land (kernel §4.1/Appendix D, deferred per
    -- done/syntax-refinement.md), a label the user writes is a loud error,
    -- not a no-op.
    parse_unsupported_syntax(
      toks,
      src,
      pos,
      "error: call-site argument labels are not supported yet",
      "call argument",
      "continue_after_argument"
    )
    parse_expr(toks, src, pos + 2, 0)
  } else {
    parse_expr(toks, src, pos, 0)
  }
}

pub(package) fn skip_comma(toks: i64, pos: i64) -> i64 {
  if tok_tag(toks, pos) == 5 {
    match tok_v1(toks, pos) {
      5 -> pos + 1
      13 -> pos + 1
      _ -> pos
    }
  } else { pos }
}

-- Array literals use commas like call arguments and also accept the lexer's
-- automatic newline separator. A source `;` is deliberately distinct: the
-- kernel does not have Rust-style `[value; N]` repetition syntax.
pub(package) fn parse_array_skip_newlines(toks: i64, src: i64, pos: i64) -> i64 {
  let mut p = pos
  let mut done = 0
  while done == 0 and tok_tag(toks, p) == 5 and tok_v1(toks, p) == 13 {
    let span = tok_span(toks, p)
    if mem_load8_at(src, span) == 59 { done = 1 } else { p = p + 1 }
  }
  p
}

pub(package) fn parse_array_literal(
  toks: i64,
  src: i64,
  pos: i64
) -[Diagnose, TypeParameterScope]> SyntaxParse<Expr> {
  let mut reversed = ExprListNil
  let open_span = tok_span(toks, pos)
  let mut p = parse_array_skip_newlines(toks, src, pos + 1)
  let mut done = 0
  if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 14 { done = 1 p = p + 1 } else { 0 }
  while done == 0 {
    tok_note_layout_item(toks, p)
    let element = parse_expr(toks, src, p, 0)
    reversed = ExprListCons(element.syntax, reversed)
    p = element.next
    if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 14 {
      done = 1
      p = p + 1
    } else {
      if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 5 {
        p = parse_array_skip_newlines(toks, src, p + 1)
        if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 14 { done = 1 p = p + 1 } else { 0 }
      } else {
        if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 13 {
          let sep_span = tok_span(toks, p)
          if mem_load8_at(src, sep_span) == 59 {
            parse_unsupported_syntax(
              toks,
              src,
              p,
              "error: array repetition syntax is not supported; write every element",
              "array literal",
              "skip_array_literal"
            )
            done = 1
            p = parse_skip_balanced(toks, pos, 17, 14)
          } else {
            p = parse_array_skip_newlines(toks, src, p + 1)
            if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 14 { done = 1 p = p + 1 } else { 0 }
          }
        } else {
          parse_syntax_error(
            toks,
            src,
            p,
            "error: expected ',' or ']' in array literal",
            "array literal",
            "skip_array_literal"
          )
          done = 1
          p = parse_skip_balanced(toks, pos, 17, 14)
        }
      }
    }
  }
  if tok_tag(toks, p - 1) == 5 and tok_v1(toks, p - 1) == 14 {
    tok_note_layout_group(toks, pos, p - 1)
  } else { nil }
  syntax_parse(ArrayLiteral(parse_expr_list_reverse(reversed), 0, open_span), p)
}

-- Destructuring binders reuse the match pipeline. The marker survives through
-- checking so refutable patterns receive a binding-specific diagnostic, then
-- typed IR/lowering sees the ordinary one-arm match it already knows how to
-- transport and clean up.
pub(package) fn parse_destructuring_bind(
  pattern: Pattern,
  value: Expr,
  body: Expr,
  origin: MatchOrigin
) -> Expr {
  Match(
    value,
    MatchArmListCons(Arm(pattern, body, UnknownExpr(0), 0), MatchArmListNil),
    origin
  )
}

-- Parse for loop: for pattern in start..end { body } or in a collection.
-- Range form keeps a private counter and binds an immutable item per iteration.
-- Iterator form: desugars to handle { let mut it = collection while true { let item = it.next() body } } { Fail.fail(_) -> resume(nil) }
pub(package) fn parse_for(
  toks: i64,
  src: i64,
  pos: i64
) -[Diagnose, TypeParameterScope]> SyntaxParse<Expr> {
  -- pos is after "for" keyword
  let has_pattern = parse_pattern_starts_at(toks, pos) == 1
  if not has_pattern {
    parse_syntax_error(
      toks,
      src,
      pos,
      "error: expected binding pattern after 'for'",
      "for loop",
      "continue_for"
    )
  } else { 0 }
  let parsed_pattern = if has_pattern {
    parse_pattern(toks, src, pos)
  } else { syntax_parse(Wildcard, pos) }
  let pattern = parsed_pattern.syntax
  let pattern_end = parsed_pattern.next
  -- A plain binding keeps the historical representation. Other patterns bind
  -- each item to the unspellable keyword `for`, then destructure that value in
  -- a marked one-arm match. Keyword tokens cannot collide with user names.
  let simple_binding = match pattern { Binding(_, _) -> 1, _ -> 0 }
  let hidden_ns = tok_span(toks, pos - 1)
  let hidden_nl = tok_end(toks, pos - 1) - hidden_ns
  let var_ns = match pattern { Binding(ns, _) -> ns, _ -> hidden_ns }
  let var_nl = match pattern { Binding(_, nl) -> nl, _ -> hidden_nl }
  -- Expect "in" (keyword 30)
  let p1 = pattern_end
  let has_in = tok_tag(toks, p1) == 3 and tok_v1(toks, p1) == 30
  if has_pattern and not has_in {
    parse_syntax_error(
      toks,
      src,
      p1,
      "error: expected 'in' after for-loop pattern",
      "for loop",
      "continue_for"
    )
  } else { 0 }
  let p2 = if has_in { p1 + 1 } else { p1 }
  -- Parse the iterable expression (range or collection)
  let has_iter = has_in and parse_expr_starts_at(toks, p2) == 1
  if has_in and not has_iter {
    parse_syntax_error(
      toks,
      src,
      p2,
      "error: expected iterable expression after 'in'",
      "for loop",
      "continue_for"
    )
  } else { 0 }
  let iterable = if has_iter {
    parse_expr(toks, src, p2, 0)
  } else { syntax_parse(NilExpr, p2) }
  let p3 = iterable.next
  let has_body = has_iter and tok_tag(toks, p3) == 5 and tok_v1(toks, p3) == 3
  if has_iter and not has_body {
    parse_syntax_error(
      toks,
      src,
      p3,
      "error: expected '{' after for-loop iterable",
      "for loop",
      "continue_expression"
    )
  } else { 0 }
  let body = if has_body {
    parse_block(toks, src, p3 + 1)
  } else { syntax_parse(NilExpr, p3) }
  let body_node = if simple_binding == 1 { body.syntax }
  else {
    parse_destructuring_bind(
      pattern,
      Ident(hidden_ns, hidden_nl),
      body.syntax,
      ForDestructuring
    )
  }
  match iterable.syntax {
    BinOp(20, range_start, range_end) -> {
      let counter_ns = tok_span(toks, p1)
      let counter_nl = tok_end(toks, p1) - counter_ns
      parse_for_range(
        var_ns,
        var_nl,
        counter_ns,
        counter_nl,
        range_start,
        range_end,
        body_node,
        body.next
      )
    }
    collection -> parse_for_iter(var_ns, var_nl, collection, body_node, body.next)
  }
}

-- Range-based for: for i in start..end { body }
pub(package) fn parse_for_range(
  var_ns: i64,
  var_nl: i64,
  counter_ns: i64,
  counter_nl: i64,
  range_start: Expr,
  range_end: Expr,
  body: Expr,
  next: i64
) -> SyntaxParse<Expr> {
  -- The unspellable `in` keyword names the counter. Capture the current item,
  -- then advance before entering user code, so continue cannot skip the step.
  -- Nested loops shadow this private name; their immutable item bindings do not.
  let counter = Ident(counter_ns, counter_nl)
  let increment = Assign(
    counter_ns,
    counter_nl,
    BinOp(1, counter, IntLit(1, 0, 0))
  )
  let body_index = Let(var_ns, var_nl, counter, Block(increment, body))
  let condition = BinOp(7, counter, range_end)
  syntax_parse(
    LetMut(counter_ns, counter_nl, range_start, While(condition, body_index)),
    next
  )
}

-- Iterator-based for: for item in collection { body }
-- Currently supports List iteration (Cons/Nil walk).
-- Desugars to:
--   let mut __cur = collection
--   let mut __done = 0
--   while __done == 0 {
--     let __tag = list_tag(__cur)
--     if __tag == Nil { __done = 1 }
--     else { let item = list_head(__cur)  body  __cur = list_tail(__cur) }
--   }
-- Uses AST tag 47 = ForIter(var_ns, var_nl, collection, body) for codegen.
pub(package) fn parse_for_iter(
  var_ns: i64,
  var_nl: i64,
  collection: Expr,
  body: Expr,
  next: i64
) -> SyntaxParse<Expr> {
  syntax_parse(ForIter(var_ns, var_nl, collection, body), next)
}

pub(package) fn parse_while(
  toks: i64,
  src: i64,
  pos: i64
) -[Diagnose, TypeParameterScope]> SyntaxParse<Expr> {
  -- pos is after "while" keyword
  let has_cond = parse_expr_starts_at(toks, pos) == 1
  if not has_cond {
    parse_syntax_error(
      toks,
      src,
      pos,
      "error: expected condition after 'while'",
      "while loop",
      "continue_while"
    )
  } else { 0 }
  let condition = if has_cond {
    parse_expr(toks, src, pos, 0)
  } else { syntax_parse(BoolLit(0, tok_span(toks, pos), 0), pos) }
  let p1 = condition.next
  let has_body = has_cond and tok_tag(toks, p1) == 5 and tok_v1(toks, p1) == 3
  if has_cond and not has_body {
    parse_syntax_error(
      toks,
      src,
      p1,
      "error: expected '{' after while condition",
      "while loop",
      "continue_expression"
    )
  } else { 0 }
  let body = if has_body {
    parse_block(toks, src, p1 + 1)
  } else { syntax_parse(NilExpr, p1) }
  syntax_parse(While(condition.syntax, body.syntax), body.next)
}

pub(package) fn parse_loop_expr(
  toks: i64,
  src: i64,
  pos: i64
) -[Diagnose, TypeParameterScope]> SyntaxParse<Expr> {
  let has_body = tok_tag(toks, pos) == 5 and tok_v1(toks, pos) == 3
  if not has_body {
    parse_syntax_error(
      toks,
      src,
      pos,
      "error: expected '{' after 'loop'",
      "loop expression",
      "continue_expression"
    )
  } else { 0 }
  let body = if has_body {
    parse_block(toks, src, pos + 1)
  } else { syntax_parse(NilExpr, pos) }
  syntax_parse(Loop(body.syntax), body.next)
}

-- Parse match expression: match expr { Pattern -> expr, ... }.
-- Patterns and arms remain typed values from this boundary onward.
pub(package) fn parse_pattern(
  toks: i64,
  src: i64,
  pos: i64
) -[Diagnose, TypeParameterScope]> SyntaxParse<Pattern> {
  let tag = tok_tag(toks, pos)
  let v1 = tok_v1(toks, pos)
  if tag == 2 {
    parse_pat_ident(toks, src, pos, v1)
  } else {
    if tag == 1 {
      let lit_start = v1
      let lit_len = tok_v2(toks, pos)
      syntax_parse(
        IntPattern(
          integer_span_value_wrapping(src, lit_start, lit_len),
          lit_start,
          lit_len,
          NumericPatternOrigin
        ),
        pos + 1
      )
    } else {
      if tag == 9 {
        let lit_start = tok_span(toks, pos)
        syntax_parse(
          IntPattern(v1, lit_start, tok_end(toks, pos) - lit_start, BooleanPatternOrigin),
          pos + 1
        )
      } else {
        if tag == 5 and v1 == 3 {
          parse_pat_record(toks, src, pos)
        } else {
          if tag == 5 and v1 == 1 {
            parse_pat_group_or_tuple(toks, src, pos)
          } else {
            parse_syntax_error(
              toks,
              src,
              pos,
              "error: unsupported pattern syntax",
              "pattern",
              "skip_pattern_token"
            )
            -- Recovery only: the reported error prevents checking or emitting this tree.
            syntax_parse(Wildcard, pos + 1)
          }
        }
      }
    }
  }
}

-- Ident in pattern: wildcard (_), uppercase -> constructor, `nil` ->
-- nil test (tag 61), lowercase -> binding — or typed binding (tag 60,
-- kernel §6.1) when a colon follows: `x: str -> ...`. The annotation
-- parses through parse_type, so it is a ty value like every other
-- annotation.
pub(package) fn parse_pat_ident(
  toks: i64,
  src: i64,
  pos: i64,
  v1: i64
) -[Diagnose, TypeParameterScope]> SyntaxParse<Pattern> {
  let v2 = tok_v2(toks, pos)
  let first_ch = mem_load8_at(src, v1)
  let qualified_ctor = tok_tag(toks, pos + 1) == 5 and tok_v1(toks, pos + 1) == 8 and tok_tag(
    toks,
    pos + 2
  ) == 2
  if qualified_ctor {
    let ctor = parse_pat_ctor(toks, src, pos + 2, tok_v1(toks, pos + 2), tok_v2(toks, pos + 2))
    let syntax = match ctor.syntax {
      CtorPattern(name_start, name_length, payloads, declaration, _) -> CtorPattern(
        name_start,
        name_length,
        payloads,
        declaration,
        TypeNameRange { start: v1, length: v2 }
      )
      other -> other
    }
    syntax_parse(syntax, ctor.next)
  } else {
    if first_ch == 95 {
      syntax_parse(Wildcard, pos + 1)
    } else {
      if first_ch >= 65 {
        if first_ch <= 90 {
          parse_pat_ctor(toks, src, pos, v1, v2)
        } else {
          parse_pat_lower_ident(toks, src, pos, v1, v2)
        }
      } else {
        parse_pat_lower_ident(toks, src, pos, v1, v2)
      }
    }
  }
}

pub(package) fn parse_pat_lower_ident(
  toks: i64,
  src: i64,
  pos: i64,
  v1: i64,
  v2: i64
) -[Diagnose, TypeParameterScope]> SyntaxParse<Pattern> {
  if src_eq(src, v1, v2, "nil") == 1 {
    syntax_parse(NilPattern(v1, v2), pos + 1)
  } else {
    let has_colon = if tok_tag(toks, pos + 1) == 5 {
      if tok_v1(toks, pos + 1) == 6 { 1 } else { 0 }
    } else { 0 }
    if has_colon == 1 {
      let annotation = parse_type(toks, src, pos + 2, TypeParameterScope.current())
      syntax_parse(TypedBinding(v1, v2, annotation.syntax), annotation.next)
    } else {
      syntax_parse(Binding(v1, v2), pos + 1)
    }
  }
}

-- Constructor pattern: Name or Name(pattern) or Name(p1, p2, ...).
-- Payload patterns stay in their authored order as typed values.
pub(package) fn parse_pat_ctor(
  toks: i64,
  src: i64,
  pos: i64,
  v1: i64,
  v2: i64
) -[Diagnose, TypeParameterScope]> SyntaxParse<Pattern> {
  if tok_tag(toks, pos + 1) == 5 {
    if tok_v1(toks, pos + 1) == 1 {
      -- Has ( — parse recursive payload patterns until ).
      let mut reversed = PatternListNil
      let mut p = pos + 2
      let mut done = 0
      while done == 0 {
        if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 2 {
          done = 1
        } else {
          if tok_tag(toks, p) == 7 or (
            tok_tag(toks, p) == 5 and tok_v1(toks, p) == 13 and tok_tag(toks, p + 1) == 7
          ) {
            parse_syntax_error(
              toks,
              src,
              p,
              "error: expected ')' after constructor pattern",
              "constructor pattern",
              "stop_pattern"
            )
            done = 1
          } else {
            let child = parse_pattern(toks, src, p)
            reversed = PatternListCons(child.syntax, reversed)
            p = child.next
            if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 5 {
              p = p + 1
            } else {
              if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 2 {
                done = 1
              } else {
                if tok_tag(toks, p) == 7 or (
                  tok_tag(toks, p) == 5 and tok_v1(toks, p) == 13 and tok_tag(toks, p + 1) == 7
                ) {
                  parse_syntax_error(
                    toks,
                    src,
                    p,
                    "error: expected ')' after constructor pattern",
                    "constructor pattern",
                    "stop_pattern"
                  )
                  done = 1
                } else {
                  parse_syntax_error(
                    toks,
                    src,
                    p,
                    "error: expected ',' or ')' after constructor pattern payload",
                    "constructor pattern",
                    "stop_pattern"
                  )
                  done = 1
                }
              }
            }
          }
        }
      }
      -- Skip past )
      if tok_tag(toks, p) == 5 {
        if tok_v1(toks, p) == 2 { p = p + 1 } else { p = p }
      } else { p = p }
      syntax_parse(CtorPattern(v1, v2, parse_pattern_list_reverse(reversed), 0, nil), p)
    } else {
      syntax_parse(CtorPattern(v1, v2, PatternListNil, 0, nil), pos + 1)
    }
  } else {
    syntax_parse(CtorPattern(v1, v2, PatternListNil, 0, nil), pos + 1)
  }
}

-- Record patterns select named fields. `{x}` is shorthand for `{x: x}`;
-- each field carries a slot for the checker's resolved type/layout fact.
pub(package) fn parse_pat_record(
  toks: i64,
  src: i64,
  pos: i64
) -[Diagnose, TypeParameterScope]> SyntaxParse<Pattern> {
  let mut reversed = PatternFieldListNil
  let mut p = pos + 1
  let mut done = 0
  while done == 0 {
    if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 4 {
      done = 1
      p = p + 1
    } else {
      if tok_tag(toks, p) == 7 or (
        tok_tag(toks, p) == 5 and tok_v1(toks, p) == 13 and tok_tag(toks, p + 1) == 7
      ) {
        parse_syntax_error(
          toks,
          src,
          p,
          "error: expected '}' after record pattern",
          "record pattern",
          "stop_pattern"
        )
        done = 1
      } else {
        if tok_tag(toks, p) == 2 {
          let field_ns = tok_v1(toks, p)
          let field_nl = tok_v2(toks, p)
          let child = if tok_tag(toks, p + 1) == 5 and tok_v1(toks, p + 1) == 6 {
            parse_pattern(toks, src, p + 2)
          } else { syntax_parse(Binding(field_ns, field_nl), p + 1) }
          reversed = PatternFieldListCons(
            PatternField(field_ns, field_nl, child.syntax, UnknownFieldAccessFact),
            reversed
          )
          p = child.next
          if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 5 {
            p = p + 1
          } else {
            if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 4 {
              done = 1
              p = p + 1
            } else {
              parse_syntax_error(
                toks,
                src,
                p,
                "error: expected ',' or '}' after record pattern field",
                "record pattern",
                "stop_pattern"
              )
              done = 1
            }
          }
        } else {
          parse_syntax_error(
            toks,
            src,
            p,
            "error: expected field name in record pattern",
            "record pattern",
            "stop_pattern"
          )
          done = 1
        }
      }
    }
  }
  syntax_parse(RecordPattern(parse_pattern_field_list_reverse(reversed)), p)
}

pub(package) fn parse_pat_group_or_tuple(
  toks: i64,
  src: i64,
  pos: i64
) -[Diagnose, TypeParameterScope]> SyntaxParse<Pattern> {
  let mut reversed = PatternListNil
  let mut p = pos + 1
  if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 2 {
    syntax_parse(TuplePattern(PatternListNil), p + 1)
  } else {
    let first = parse_pattern(toks, src, p)
    p = first.next
    if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 2 {
      syntax_parse(first.syntax, p + 1)
    } else {
      if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 5 {
        reversed = PatternListCons(first.syntax, reversed)
        p = p + 1
        let mut done = 0
        while done == 0 {
          if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 2 {
            done = 1
            p = p + 1
          } else {
            if tok_tag(toks, p) == 7 or (
              tok_tag(toks, p) == 5 and tok_v1(toks, p) == 13 and tok_tag(toks, p + 1) == 7
            ) {
              parse_syntax_error(
                toks,
                src,
                p,
                "error: expected ')' after tuple pattern",
                "tuple pattern",
                "stop_pattern"
              )
              done = 1
            } else {
              let item = parse_pattern(toks, src, p)
              reversed = PatternListCons(item.syntax, reversed)
              p = item.next
              if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 5 {
                p = p + 1
              } else {
                if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 2 {
                  done = 1
                  p = p + 1
                } else {
                  parse_syntax_error(
                    toks,
                    src,
                    p,
                    "error: expected ',' or ')' after tuple pattern item",
                    "tuple pattern",
                    "stop_pattern"
                  )
                  done = 1
                }
              }
            }
          }
        }
        syntax_parse(TuplePattern(parse_pattern_list_reverse(reversed)), p)
      } else {
        parse_syntax_error(
          toks,
          src,
          p,
          "error: expected ')' after grouped pattern",
          "grouped pattern",
          "stop_pattern"
        )
        syntax_parse(first.syntax, p)
      }
    }
  }
}

pub(package) fn parse_match(
  toks: i64,
  src: i64,
  pos: i64
) -[Diagnose, TypeParameterScope]> SyntaxParse<Expr> {
  -- pos is after "match" keyword
  let scrutinee = parse_expr(toks, src, pos, 0)
  let has_body = tok_tag(toks, scrutinee.next) == 5 and
    tok_v1(toks, scrutinee.next) == 3
  if not has_body {
    parse_syntax_error(
      toks,
      src,
      scrutinee.next,
      "error: expected '{' after match expression",
      "match expression",
      "continue_expression"
    )
  } else { 0 }
  let recovery = if has_body {
    scrutinee.next
  } else { parse_item_sync(toks, scrutinee.next, 4) }
  let arms = if has_body {
    parse_match_arms(toks, src, scrutinee.next + 1, scrutinee.next)
  } else {
    syntax_parse(
      MatchArmListNil,
      if tok_tag(toks, recovery) == 5 and tok_v1(toks, recovery) == 4 {
        recovery + 1
      } else { recovery }
    )
  }
  syntax_parse(Match(scrutinee.syntax, arms.syntax, ExplicitMatch), arms.next)
}

pub(package) fn parse_match_arms(
  toks: i64,
  src: i64,
  pos: i64,
  open_pos: i64
) -[Diagnose, TypeParameterScope]> SyntaxParse<MatchArmList> {
  let mut p = pos
  let mut reversed = MatchArmListNil
  let errors_before = tok_parse_error_count(toks)
  let mut done = 0
  while done == 0 {
    p = skip_semicolons(toks, p)
    let tag = tok_tag(toks, p)
    if tag == 5 and tok_v1(toks, p) == 4 {
      tok_note_layout_group(toks, open_pos, p)
      done = 1
      p = p + 1
    }
    else {
      if tag == 7 or is_decl_start(toks, p) == 1 {
        if tok_parse_error_count(toks) == errors_before {
          parse_missing_delimiter(
            toks,
            src,
            p,
            open_pos,
            "error: expected '}' after match arms",
            "}",
            "match expression",
            if tag == 7 { "resume_at_end_of_file" } else { "resume_at_declaration" }
          )
        } else { 0 }
        done = 1
      } else {
        if parse_pattern_starts_at(toks, p) == 0 {
          parse_syntax_error(
            toks,
            src,
            p,
            "error: expected pattern or '}' in match expression",
            "match arm",
            "skip_match_arm"
          )
          p = parse_item_sync(toks, p + 1, 4)
          if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 5 { p = p + 1 } else { 0 }
        } else {
          let parsed_pattern = parse_pattern(toks, src, p)
          tok_note_layout_member(toks, p)
          let pattern = parsed_pattern.syntax
          let mut arm_p = parsed_pattern.next
          let mut guard = UnknownExpr(0)
          let mut has_guard = 0
          if tok_tag(toks, arm_p) == 3 and tok_v1(toks, arm_p) == 3 {
            if parse_expr_starts_at(toks, arm_p + 1) == 0 {
              parse_syntax_error(
                toks,
                src,
                arm_p + 1,
                "error: expected condition after match-arm 'if'",
                "match guard",
                "skip_match_arm"
              )
            } else {
              let parsed_guard = parse_expr(toks, src, arm_p + 1, 0)
              guard = parsed_guard.syntax
              has_guard = 1
              arm_p = parsed_guard.next
            }
          } else { 0 }
          if tok_tag(toks, arm_p) != 6 {
            parse_syntax_error(
              toks,
              src,
              arm_p,
              "error: expected '->' after match pattern",
              "match arm",
              "skip_match_arm"
            )
            p = parse_item_sync(toks, arm_p, 4)
          } else {
            if parse_expr_starts_at(toks, arm_p + 1) == 0 {
              parse_syntax_error(
                toks,
                src,
                arm_p + 1,
                "error: expected expression after match-arm '->'",
                "match arm",
                "skip_match_arm"
              )
              p = parse_item_sync(toks, arm_p + 1, 4)
            } else {
              tok_note_layout(toks, arm_p + 1, LayoutBreak)
              let body = parse_expr(toks, src, arm_p + 1, 0)
              reversed = MatchArmListCons(Arm(pattern, body.syntax, guard, has_guard), reversed)
              p = body.next
              if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 5 { p = p + 1 }
              else { if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 13 { p = p + 1 } else { 0 } }
            }
          }
        }
      }
    }
  }
  syntax_parse(parse_match_arm_list_reverse(reversed), p)
}

-- A missing final alternative makes the entire conditional a statement.
-- Keep that syntax fact while parsing a chain, before constructing the AST.
type ParsedConditional {
  ValueConditional(Expr, i64),
  StatementConditional(Expr, i64),
}

pub(package) fn parse_if(
  toks: i64,
  src: i64,
  pos: i64
) -[Diagnose, TypeParameterScope]> SyntaxParse<Expr> {
  match parse_if_branch(toks, src, pos) {
    ValueConditional(expr, next) -> syntax_parse(expr, next)
    StatementConditional(expr, next) -> syntax_parse(expr, next)
  }
}

fn parse_if_branch(
  toks: i64,
  src: i64,
  pos: i64
) -[Diagnose, TypeParameterScope]> ParsedConditional {
  -- pos is after the if keyword; if-let uses the same alternative grammar.
  if tok_tag(toks, pos) == 3 and tok_v1(toks, pos) == 2 {
    parse_if_let(toks, src, pos + 1)
  } else { parse_if_cond(toks, src, pos) }
}

fn parse_else_alternative(
  toks: i64,
  src: i64,
  pos: i64
) -[Diagnose, TypeParameterScope]> ParsedConditional {
  if tok_tag(toks, pos) == 3 and tok_v1(toks, pos) == 4 {
    let next = pos + 1
    if tok_tag(toks, next) == 5 and tok_v1(toks, next) == 3 {
      let parsed = parse_block(toks, src, next + 1)
      ValueConditional(parsed.syntax, parsed.next)
    } else {
      if tok_tag(toks, next) == 3 and tok_v1(toks, next) == 3 {
        parse_if_branch(toks, src, next + 1)
      } else {
        parse_syntax_error(
          toks,
          src,
          next,
          "error: expected '{' or 'if' after 'else'",
          "else clause",
          "continue_expression"
        )
        ValueConditional(NilExpr, next)
      }
    }
  } else { StatementConditional(NilExpr, pos) }
}

pub(package) fn parse_nil_expr() -> Expr {
  NilExpr
}

pub(package) fn parse_discard_to_nil(expr: Expr) -> Expr {
  Block(expr, NilExpr)
}

-- Parse defer cleanup; rest-of-scope. AST tag 52 = Defer(cleanup, body).
-- The parser nests multiple defers so codegen's body-then-cleanup order is LIFO.
pub(package) fn parse_defer(
  toks: i64,
  src: i64,
  pos: i64
) -[Diagnose, TypeParameterScope]> SyntaxParse<Expr> {
  -- pos is after "defer" keyword
  let source_site = tok_span(toks, pos - 1)
  let cleanup = parse_expr(toks, src, pos, 0)
  let p1 = skip_semicolons(toks, cleanup.next)
  let next_tag = tok_tag(toks, p1)
  let body_r = if next_tag == 5 {
    if tok_v1(toks, p1) == 4 { syntax_parse(NilExpr, p1) }
    else { parse_block_stmts(toks, src, p1) }
  } else {
    if next_tag == 7 {
      syntax_parse(NilExpr, p1)
    } else {
      parse_block_stmts(toks, src, p1)
    }
  }
  syntax_parse(Defer(cleanup.syntax, body_r.syntax, source_site), body_r.next)
}

-- Parse if-let, including a shared block or conditional alternative.
-- Desugars to: match scrutinee { Pattern -> body, _ -> else_body }
fn parse_if_let(toks: i64, src: i64, pos: i64) -[Diagnose, TypeParameterScope]> ParsedConditional
{
  -- pos is after "let"
  -- Parse pattern
  let has_pattern = parse_pattern_starts_at(toks, pos) == 1
  if not has_pattern {
    parse_syntax_error(
      toks,
      src,
      pos,
      "error: expected pattern after 'if let'",
      "if-let expression",
      "continue_if"
    )
  } else { 0 }
  let pat_r = if has_pattern { parse_pattern(toks, src, pos) } else {
    syntax_parse(Wildcard, pos)
  }
  let pat = pat_r.syntax
  let p1 = pat_r.next
  -- Expect = (punct tag 5, val 7)
  let has_equals = tok_tag(toks, p1) == 5 and tok_v1(toks, p1) == 7
  if has_pattern and not has_equals {
    parse_syntax_error(
      toks,
      src,
      p1,
      "error: expected '=' after if-let pattern",
      "if-let expression",
      "continue_if"
    )
  } else { 0 }
  let p2 = if has_equals { p1 + 1 } else { p1 }
  -- Parse scrutinee expression
  -- Recover a missing pattern by consuming the valid scrutinee and body.
  -- Otherwise their tokens cause unrelated expression/else cascades.
  let has_scrutinee = parse_expr_starts_at(toks, p2) == 1
  if has_equals and not has_scrutinee {
    parse_syntax_error(
      toks,
      src,
      p2,
      "error: expected expression after if-let '='",
      "if-let expression",
      "continue_if"
    )
  } else { 0 }
  let scrutinee = if has_scrutinee {
    parse_expr(toks, src, p2, 0)
  } else { syntax_parse(NilExpr, p2) }
  let p3 = scrutinee.next
  let has_then = has_scrutinee and tok_tag(toks, p3) == 5 and tok_v1(toks, p3) == 3
  if has_scrutinee and not has_then {
    parse_syntax_error(
      toks,
      src,
      p3,
      "error: expected '{' after if-let expression",
      "if-let expression",
      "continue_expression"
    )
  } else { 0 }
  let then_body = if has_then {
    parse_block(toks, src, p3 + 1)
  } else { syntax_parse(NilExpr, p3) }
  match parse_else_alternative(toks, src, then_body.next) {
    ValueConditional(else_body, next) -> {
      let arms = MatchArmListCons(
        Arm(pat, then_body.syntax, UnknownExpr(0), 0),
        MatchArmListCons(Arm(Wildcard, else_body, UnknownExpr(0), 0), MatchArmListNil)
      )
      ValueConditional(Match(scrutinee.syntax, arms, ExplicitMatch), next)
    }
    StatementConditional(else_body, next) -> {
      let arms = MatchArmListCons(
        Arm(
          pat,
          parse_discard_to_nil(then_body.syntax),
          UnknownExpr(0),
          0
        ),
        MatchArmListCons(Arm(Wildcard, else_body, UnknownExpr(0), 0), MatchArmListNil)
      )
      StatementConditional(Match(scrutinee.syntax, arms, ExplicitMatch), next)
    }
  }
}

fn parse_if_cond(toks: i64, src: i64, pos: i64) -[Diagnose, TypeParameterScope]> ParsedConditional
{
  -- Regular if: condition { body } else { body }
  let has_cond = parse_expr_starts_at(toks, pos) == 1
  if not has_cond {
    parse_syntax_error(
      toks,
      src,
      pos,
      "error: expected condition after 'if'",
      "if expression",
      "continue_if"
    )
  } else { 0 }
  let condition = if has_cond {
    parse_expr(toks, src, pos, 0)
  } else { syntax_parse(BoolLit(0, tok_span(toks, pos), 0), pos) }
  let p1 = condition.next
  let has_then = has_cond and tok_tag(toks, p1) == 5 and tok_v1(toks, p1) == 3
  if has_cond and not has_then {
    parse_syntax_error(
      toks,
      src,
      p1,
      "error: expected '{' after if condition",
      "if expression",
      "continue_expression"
    )
  } else { 0 }
  let then_body = if has_then {
    parse_block(toks, src, p1 + 1)
  } else { syntax_parse(NilExpr, p1) }
  match parse_else_alternative(toks, src, then_body.next) {
    ValueConditional(else_body, next) ->
      ValueConditional(If(condition.syntax, then_body.syntax, else_body), next)
    StatementConditional(else_body, next) ->
      StatementConditional(
        If(condition.syntax, parse_discard_to_nil(then_body.syntax), else_body),
        next
      )
  }
}

pub(package) fn parse_let(
  toks: i64,
  src: i64,
  pos: i64
) -[Diagnose, TypeParameterScope]> SyntaxParse<Expr> {
  -- pos is after "let" keyword
  let hidden_ns = tok_span(toks, pos - 1)
  let hidden_nl = tok_end(toks, pos - 1) - hidden_ns
  -- check for "mut"
  let is_mut = if tok_tag(toks, pos) == 3 {
    if tok_v1(toks, pos) == 5 { 1 } else { 0 }
  } else { 0 }
  let p = if is_mut == 1 { pos + 1 } else { pos }
  let starts_pattern = if tok_tag(toks, p) == 1 { 1 }
  else {
    if tok_tag(toks, p) == 5 {
      if tok_v1(toks, p) == 1 or tok_v1(toks, p) == 3 { 1 } else { 0 }
    } else {
      if tok_tag(toks, p) == 2 {
        let name_start = tok_v1(toks, p)
        let name_len = tok_v2(toks, p)
        let first_ch = mem_load8_at(src, name_start)
        if first_ch == 95 or (first_ch >= 65 and first_ch <= 90) or src_eq(
          src,
          name_start,
          name_len,
          "nil"
        ) == 1 { 1 } else { 0 }
      } else { 0 }
    }
  }
  if starts_pattern == 1 {
    parse_let_pattern(toks, src, p, is_mut, hidden_ns, hidden_nl)
  } else {
    -- expect ident [: type] = expr
    let has_name = tok_tag(toks, p) == 2
    if not has_name {
      parse_syntax_error(
        toks,
        src,
        p,
        "error: expected binding name after 'let'",
        "let binding",
        "continue_binding"
      )
    } else { 0 }
    let name_start = tok_v1(toks, p)
    let name_len = tok_v2(toks, p)
    -- check for : (type annotation) after ident
    let has_ann = if has_name and tok_tag(toks, p + 1) == 5 {
      if tok_v1(toks, p + 1) == 6 { 1 } else { 0 }
    } else { 0 }
    let has_ann_type = has_ann == 1 and parse_type_starts_at(toks, p + 2) == 1
    if has_ann == 1 and not has_ann_type {
      parse_syntax_error(
        toks,
        src,
        p + 2,
        "error: expected type after binding ':'",
        "let binding",
        "continue_binding"
      )
    } else { 0 }
    let annotation = if has_ann_type {
      parse_type(toks, src, p + 2, TypeParameterScope.current())
    } else {
      syntax_parse(
        MissingTypeExpr,
        if has_ann == 1 { p + 2 } else { if has_name { p + 1 } else { p } }
      )
    }
    let p_eq = annotation.next
    let has_equals = has_name and tok_tag(toks, p_eq) == 5 and tok_v1(toks, p_eq) == 7
    if has_name and not has_equals and not (has_ann == 1 and not has_ann_type) {
      parse_syntax_error(
        toks,
        src,
        p_eq,
        "error: expected '=' after binding name",
        "let binding",
        "continue_binding"
      )
    } else { 0 }
    let value_pos = if has_equals { p_eq + 1 } else { p_eq }
    let has_value = has_name and parse_expr_starts_at(toks, value_pos) == 1
    if has_equals and not has_value {
      parse_syntax_error(
        toks,
        src,
        value_pos,
        "error: expected expression after binding '='",
        "let binding",
        "continue_binding"
      )
    } else { 0 }
    let value = if has_value {
      parse_expr(toks, src, value_pos, 0)
    } else { syntax_parse(NilExpr, if has_name { value_pos } else { p + 1 }) }
    -- the rest of the block is the body
    let body = parse_block_stmts(toks, src, value.next)
    let inner = if is_mut == 1 {
      LetMut(name_start, name_len, value.syntax, body.syntax)
    } else { Let(name_start, name_len, value.syntax, body.syntax) }
    match annotation.syntax {
      MissingTypeExpr -> syntax_parse(inner, body.next)
      ty -> syntax_parse(LetTyped(inner, ty), body.next)
    }
  }
}

pub(package) fn parse_let_pattern(
  toks: i64,
  src: i64,
  pos: i64,
  is_mut: i64,
  hidden_ns: i64,
  hidden_nl: i64
) -[Diagnose, TypeParameterScope]> SyntaxParse<Expr> {
  let pattern_r = parse_pattern(toks, src, pos)
  let pattern = pattern_r.syntax
  let after_pattern = pattern_r.next
  let has_ann = if tok_tag(toks, after_pattern) == 5 and tok_v1(toks, after_pattern) == 6 { 1 } else {
    0
  }
  let annotation = if has_ann == 1 {
    parse_type(toks, src, after_pattern + 1, TypeParameterScope.current())
  } else { syntax_parse(MissingTypeExpr, after_pattern) }
  let p_eq = annotation.next
  if is_mut == 1 {
    parse_unsupported_syntax(
      toks,
      src,
      pos,
      "error: mutable destructuring bindings are not supported; bind names then mutate them",
      "destructuring binding",
      "continue_binding"
    )
  } else { 0 }
  if not (tok_tag(toks, p_eq) == 5 and tok_v1(toks, p_eq) == 7) {
    parse_syntax_error(
      toks,
      src,
      p_eq,
      "error: expected '=' after destructuring pattern",
      "destructuring binding",
      "continue_binding"
    )
  } else { 0 }
  let value_pos = if tok_tag(toks, p_eq) == 5 and tok_v1(toks, p_eq) == 7 { p_eq + 1 } else {
    p_eq
  }
  let value = parse_expr(toks, src, value_pos, 0)
  let body = parse_block_stmts(toks, src, value.next)
  let destructured_body = parse_destructuring_bind(
    pattern,
    Ident(hidden_ns, hidden_nl),
    body.syntax,
    LetDestructuring
  )
  let inner = Let(hidden_ns, hidden_nl, value.syntax, destructured_body)
  match annotation.syntax {
    MissingTypeExpr -> syntax_parse(inner, body.next)
    ty -> syntax_parse(LetTyped(inner, ty), body.next)
  }
}

pub(package) fn parse_block(
  toks: i64,
  src: i64,
  pos: i64
) -[Diagnose, TypeParameterScope]> SyntaxParse<Expr> {
  -- pos is after {, parse stmts until }
  -- Handle EOF or unexpected token gracefully
  let errors_before = tok_parse_error_count(toks)
  if tok_tag(toks, pos) == 7 {
    parse_missing_delimiter(
      toks,
      src,
      pos,
      pos - 1,
      "error: expected '}' before end of file",
      "}",
      "block",
      "resume_at_end_of_file"
    )
    syntax_parse(IntLit(0, 0, 0), pos)
  }
  else {
    let r = parse_block_stmts(toks, src, pos)
    let p = r.next
    if tok_tag(toks, p) == 7 {
      if tok_parse_error_count(toks) == errors_before {
        parse_missing_delimiter(
          toks,
          src,
          p,
          pos - 1,
          "error: expected '}' before end of file",
          "}",
          "block",
          "resume_at_end_of_file"
        )
      } else { 0 }
      syntax_parse(r.syntax, p)
    }
    else {
      if is_decl_start(toks, p) == 1 {
        -- If an inner construct already failed and recovered to this same
        -- declaration boundary, another missing-block-close verdict is causal
        -- fallout. The inner parser owns the root error; retain the recovered
        -- declaration without manufacturing a second fix.
        if tok_parse_error_count(toks) == errors_before {
          parse_missing_delimiter(
            toks,
            src,
            p,
            pos - 1,
            "error: expected '}' before declaration",
            "}",
            "block",
            "resume_at_declaration"
          )
        } else { 0 }
        syntax_parse(r.syntax, p)
      } else {
        tok_note_layout_group(toks, pos - 1, p)
        syntax_parse(r.syntax, p + 1)
      }
    }
  }
}

pub(package) fn parse_block_stmts(
  toks: i64,
  src: i64,
  pos: i64
) -[Diagnose, TypeParameterScope]> SyntaxParse<Expr> {
  -- Skip leading semicolons (from newlines)
  let p0 = skip_semicolons(toks, pos)
  -- Parse expressions until } or EOF. Returns position AT } (not past it).
  let tag = tok_tag(toks, p0)
  let v1 = tok_v1(toks, p0)
  if is_decl_start(toks, p0) == 1 {
    syntax_parse(IntLit(0, 0, 0), p0)
  } else {
    if tag == 5 {
      if v1 == 4 {
        syntax_parse(IntLit(0, 0, 0), p0)
      } else {
        parse_block_one(toks, src, p0)
      }
    } else {
      if tag == 7 {
        syntax_parse(IntLit(0, 0, 0), p0)
      } else {
        parse_block_one(toks, src, p0)
      }
    }
  }
}

pub(package) fn parse_maybe_ptr_assign_from_lhs(
  toks: i64,
  src: i64,
  lhs: SyntaxParse<Expr>
) -[Diagnose, TypeParameterScope]> SyntaxParse<Expr> {
  let assignable = match lhs.syntax {
    Deref(_) -> true,
    IndexedGet(_, _, _, _) -> true,
    _ -> false
  }
  if assignable and tok_tag(toks, lhs.next) == 5 and tok_v1(toks, lhs.next) == 7 {
    let value = parse_expr(toks, src, lhs.next + 1, 0)
    let assigned = match lhs.syntax {
      Deref(pointer) -> PtrAssign(pointer, value.syntax)
      IndexedGet(base, index, _, _) -> IndexedSet(base, index, value.syntax, 0)
      other -> other
    }
    syntax_parse(assigned, value.next)
  } else { lhs }
}

-- Check for assignment before parsing as a plain expression.
pub(package) fn parse_maybe_assign(
  toks: i64,
  src: i64,
  pos: i64
) -[Diagnose, TypeParameterScope]> SyntaxParse<Expr> {
  -- Assignment: Ident followed by = (Punct 7)
  if tok_tag(toks, pos) == 2 {
    if tok_tag(toks, pos + 1) == 5 {
      if tok_v1(toks, pos + 1) == 7 {
        let a_ns = tok_v1(toks, pos)
        let a_nl = tok_v2(toks, pos)
        let value = parse_expr(toks, src, pos + 2, 0)
        syntax_parse(Assign(a_ns, a_nl, value.syntax), value.next)
      } else { parse_maybe_ptr_assign_from_lhs(toks, src, parse_expr(toks, src, pos, 0)) }
    } else { parse_maybe_ptr_assign_from_lhs(toks, src, parse_expr(toks, src, pos, 0)) }
  } else {
    parse_maybe_ptr_assign_from_lhs(toks, src, parse_expr(toks, src, pos, 0))
  }
}

pub(package) fn parse_block_one(
  toks: i64,
  src: i64,
  pos: i64
) -[Diagnose, TypeParameterScope]> SyntaxParse<Expr> {
  tok_note_layout_member(toks, pos)
  let r = parse_maybe_assign(toks, src, pos)
  let p = r.next
  -- Skip optional ; separator
  let p2 = skip_semicolons(toks, p)
  -- Check if next is } or eof — return AT } (don't consume)
  let next_tag = tok_tag(toks, p2)
  if is_decl_start(toks, p2) == 1 {
    syntax_parse(r.syntax, p2)
  } else {
    if next_tag == 5 {
      if tok_v1(toks, p2) == 4 { syntax_parse(r.syntax, p2) }
      else {
        let rest_r = parse_block_stmts(toks, src, p2)
        syntax_parse(Block(r.syntax, rest_r.syntax), rest_r.next)
      }
    } else {
      if next_tag == 7 {
        syntax_parse(r.syntax, p2)
      } else {
        -- More statements: wrap in Block(first, rest)
        let rest_r = parse_block_stmts(toks, src, p2)
        syntax_parse(Block(r.syntax, rest_r.syntax), rest_r.next)
      }
    }
  }
}

pub(package) fn skip_semicolons(toks: i64, pos: i64) -> i64 {
  let mut p = pos
  let mut done = 0
  while done == 0 {
    if tok_tag(toks, p) == 5 {
      if tok_v1(toks, p) == 13 { p = p + 1 }
      else { done = 1 }
    } else { done = 1 }
  }
  p
}

-- Parse record literal: Name { field: value, ... }
pub(package) fn parse_record_lit(
  toks: i64,
  src: i64,
  pos: i64
) -[Diagnose, TypeParameterScope]> SyntaxParse<Expr> {
  let type_ns = tok_v1(toks, pos)
  let type_nl = tok_v2(toks, pos)
  let fields = parse_record_lit_fields(toks, src, pos + 2, pos + 1)
  syntax_parse(
    RecordInit(type_ns, type_nl, fields.syntax, InferredRecordType(MissingTypeExpr)),
    fields.next
  )
}

pub(package) fn parse_qualified_record_lit(
  toks: i64,
  src: i64,
  qualifier: Expr,
  ns: i64,
  nl: i64,
  type_args: TypeExprList,
  explicit_type_args: bool,
  open_pos: i64
) -[Diagnose, TypeParameterScope]> SyntaxParse<Expr> {
  let fields = parse_record_lit_fields(toks, src, open_pos + 1, open_pos)
  let construction = match qualifier {
    Ident(start, length) -> {
      let base = NamedTypeExpr(
        effect_name_hash(src, start, length),
        HasTypeRepresentation(PrimitiveTypeExpr(PRIM_I64())),
        type_args,
        SourceTypeOrigin(TypeNameRange { start: start, length: length })
      )
      let constructor = SourceAssociatedTypeExpr(
        base,
        effect_name_hash(src, ns, nl),
        TypeNameRange { start: start, length: ns + nl - start }
      )
      if explicit_type_args { ExplicitRecordType(constructor) }
      else { InferredRecordType(constructor) }
    }
    _ -> {
      parse_syntax_error(
        toks,
        src,
        open_pos,
        "error: record constructor requires a module qualifier",
        "record constructor",
        "continue_expression"
      )
      InferredRecordType(MissingTypeExpr)
    }
  }
  syntax_parse(RecordInit(ns, nl, fields.syntax, construction), fields.next)
}

pub(package) fn parse_record_lit_fields(
  toks: i64,
  src: i64,
  pos: i64,
  open_pos: i64
) -[Diagnose, TypeParameterScope]> SyntaxParse<RecordFieldList> {
  let mut p = pos
  let mut reversed = RecordFieldListNil
  let errors_before = tok_parse_error_count(toks)
  let mut done = 0
  while done == 0 {
    let tag = tok_tag(toks, p)
    if tag == 5 and tok_v1(toks, p) == 4 { done = 1 p = p + 1 }
    else {
      if tag == 7 or is_decl_start(toks, p) == 1 {
        if tok_parse_error_count(toks) == errors_before {
          parse_missing_delimiter(
            toks,
            src,
            p,
            open_pos,
            "error: expected '}' after record literal",
            "}",
            "record literal",
            if tag == 7 { "resume_at_end_of_file" } else { "resume_at_declaration" }
          )
        } else { 0 }
        done = 1
      } else {
        if tok_tag(toks, p) != 2 {
          parse_syntax_error(
            toks,
            src,
            p,
            "error: expected field name or '}' in record literal",
            "record literal",
            "stop_record"
          )
          p = parse_item_sync(toks, p + 1, 4)
          done = 1
        } else {
          tok_note_layout_member(toks, p)
          let f_ns = tok_v1(toks, p)
          let f_nl = tok_v2(toks, p)
          if not (tok_tag(toks, p + 1) == 5 and tok_v1(toks, p + 1) == 6) {
            parse_syntax_error(
              toks,
              src,
              p + 1,
              "error: expected ':' after record literal field name",
              "record literal field",
              "stop_record"
            )
            p = parse_item_sync(toks, p + 1, 4)
            done = 1
          } else {
            if parse_expr_starts_at(toks, p + 2) == 0 {
              parse_syntax_error(
                toks,
                src,
                p + 2,
                "error: expected value after record literal field ':'",
                "record literal field",
                "stop_record"
              )
              p = parse_item_sync(toks, p + 2, 4)
              done = 1
            } else {
              let value = parse_expr(toks, src, p + 2, 0)
              reversed = RecordFieldListCons(
                RecordField(f_ns, f_nl, value.syntax, UnknownRecordFieldFact),
                reversed
              )
              p = value.next
              if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 4 { done = 1 p = p + 1 }
              else {
                if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 5 { p = p + 1 }
                else {
                  if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 13 and tok_span(toks, p) ==
                    tok_end(toks, p) { p = p + 1 }
                  else {
                    if tok_tag(toks, p) == 7 or is_decl_start(toks, p) == 1 {
                      if tok_parse_error_count(toks) == errors_before {
                        parse_missing_delimiter(
                          toks,
                          src,
                          p,
                          open_pos,
                          "error: expected '}' after record literal",
                          "}",
                          "record literal",
                          if tok_tag(toks, p) == 7 { "resume_at_end_of_file" } else {
                            "resume_at_declaration"
                          }
                        )
                      } else { 0 }
                      done = 1
                    }
                    else {
                      parse_syntax_error(
                        toks,
                        src,
                        p,
                        "error: expected ',' or '}' after record literal field",
                        "record literal",
                        "stop_record"
                      )
                      p = parse_item_sync(toks, p, 4)
                      done = 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  if tok_tag(toks, p - 1) == 5 and tok_v1(toks, p - 1) == 4 {
    tok_note_layout_group(toks, open_pos, p - 1)
  } else { nil }
  syntax_parse(parse_record_field_list_reverse(reversed), p)
}

-- ══════════════════════════════════════════════════════════════
-- Handle expression: handle body { Effect.op(params) -> expr ... }
-- ══════════════════════════════════════════════════════════════
pub(package) fn parse_is_deferred_marker(toks: i64, src: i64, pos: i64) -> i64 {
  if tok_tag(toks, pos) == 5 {
    if tok_v1(toks, pos) == 16 {
      if tok_tag(toks, pos + 1) == 2 {
        if src_eq(src, tok_v1(toks, pos + 1), tok_v2(toks, pos + 1), "deferred") == 1 { 1 } else {
          0
        }
      } else { 0 }
    } else { 0 }
  } else { 0 }
}

pub(package) fn parse_handle_clause_continuation(
  toks: i64,
  src: i64,
  pos: i64
) -> SyntaxParse<HandlerClauseContinuation> {
  if tok_tag(toks, pos) == 2 {
    if src_eq(src, tok_v1(toks, pos), tok_v2(toks, pos), "with") == 1 {
      if tok_tag(toks, pos + 1) == 2 {
        syntax_parse(
          HandlerClauseContinuation(tok_v1(toks, pos + 1), tok_v2(toks, pos + 1)),
          pos + 2
        )
      } else { syntax_parse(UnknownHandlerClauseContinuation, pos + 1) }
    } else { syntax_parse(HandlerClauseNoContinuation, pos) }
  } else { syntax_parse(HandlerClauseNoContinuation, pos) }
}

type HandlerClauseParse {
  clause: HandlerClause,
  include: bool,
  next: i64
}

type HandlerClausesParse {
  clauses: HandlerClauseList,
  completion: HandleReturn,
  return_count: i64,
  next: i64
}

pub(package) fn parse_handle_expr(
  toks: i64,
  src: i64,
  pos: i64
) -[Diagnose, TypeParameterScope]> SyntaxParse<Expr> {
  -- pos is after "handle" keyword
  -- Parse body expression (the handled computation)
  let body = parse_expr(toks, src, pos, 0)
  let has_body = tok_tag(toks, body.next) == 5 and tok_v1(toks, body.next) == 3
  if not has_body {
    parse_syntax_error(
      toks,
      src,
      body.next,
      "error: expected '{' after handled expression",
      "handler",
      "continue_expression"
    )
  } else { 0 }
  let recovery = if has_body {
    body.next
  } else { parse_item_sync(toks, body.next, 4) }
  let parsed = if has_body {
    parse_handle_clauses(
      toks,
      src,
      body.next + 1,
      body.next,
      tok_parse_error_count(toks)
    )
  } else {
    HandlerClausesParse {
      clauses: HandlerClauseListNil,
      completion: NoHandleReturn,
      return_count: 0,
      next: if tok_tag(toks, recovery) == 5 and tok_v1(toks, recovery) == 4 {
        recovery + 1
      } else { recovery }
    }
  }
  syntax_parse(Handle(body.syntax, parsed.clauses, parsed.completion), parsed.next)
}

-- parameterized effects (kernel §7.3): `return v -> expr` — transforms the handled
-- expression's NORMAL completion; abortive clause values bypass it.
-- Node shape: node(0, binder_ns, binder_nl, body, 0) in handle f4.
pub(package) fn parse_handle_return_clause(
  toks: i64,
  src: i64,
  pos: i64
) -[Diagnose, TypeParameterScope]> SyntaxParse<HandleReturn> {
  let has_binder = if tok_tag(toks, pos + 1) == 2 { 1 } else { 0 }
  if has_binder == 0 {
    parse_syntax_error(
      toks,
      src,
      pos + 1,
      "error: expected value binder after 'return' in handler",
      "handler return clause",
      "stop_clause"
    )
  } else { 0 }
  let v_ns = tok_v1(toks, pos + 1)
  let v_nl = tok_v2(toks, pos + 1)
  let p = if has_binder == 1 { pos + 2 } else { pos + 1 }
  let has_arrow = tok_tag(toks, p) == 6
  if has_binder == 1 and not has_arrow {
    parse_syntax_error(
      toks,
      src,
      p,
      "error: expected '->' after handler return binder",
      "handler return clause",
      "stop_clause"
    )
  } else { 0 }
  let p2 = if has_arrow { p + 1 } else { p }
  let has_body = has_binder == 1 and has_arrow and parse_expr_starts_at(toks, p2) == 1
  if has_binder == 1 and has_arrow and not has_body {
    parse_syntax_error(
      toks,
      src,
      p2,
      "error: expected expression after handler return '->'",
      "handler return clause",
      "stop_clause"
    )
  } else { 0 }
  let body = if has_body {
    parse_expr(toks, src, p2, 0)
  } else { syntax_parse(NilExpr, parse_item_sync(toks, p2, 4)) }
  syntax_parse(
    HandleReturnClause(v_ns, v_nl, body.syntax),
    skip_comma(toks, body.next)
  )
}

pub(package) fn parse_handle_clauses(
  toks: i64,
  src: i64,
  pos: i64,
  open_pos: i64,
  errors_before: i64
) -[Diagnose, TypeParameterScope]> HandlerClausesParse {
  let mut p = pos
  let mut reversed = HandlerClauseListNil
  let mut completion = NoHandleReturn
  let mut return_count = 0
  let mut done = 0
  while done == 0 {
    p = skip_semicolons(toks, p)
    let tag = tok_tag(toks, p)
    if tag == 5 and tok_v1(toks, p) == 4 {
      tok_note_layout_group(toks, open_pos, p)
      done = 1
      p = p + 1
    }
    else {
      if tag == 7 or is_decl_start(toks, p) == 1 {
        if tok_parse_error_count(toks) == errors_before {
          parse_missing_delimiter(
            toks,
            src,
            p,
            open_pos,
            "error: expected '}' after handler clauses",
            "}",
            "handler",
            if tag == 7 { "resume_at_end_of_file" } else { "resume_at_declaration" }
          )
        } else { 0 }
        done = 1
      } else {
        tok_note_layout_member(toks, p)
        let next = if tag == 3 and tok_v1(toks, p) == 20 {
          let parsed_return = parse_handle_return_clause(toks, src, p)
          if return_count > 0 {
            parse_syntax_error(
              toks,
              src,
              p,
              "error: at most one return clause per handler",
              "handler return clause",
              "continue_handler"
            )
          } else { completion = parsed_return.syntax }
          return_count = return_count + 1
          parsed_return.next
        } else {
          let parsed_clause = parse_one_handle_clause(toks, src, p)
          if parsed_clause.include {
            reversed = HandlerClauseListCons(parsed_clause.clause, reversed)
          } else { nil }
          parsed_clause.next
        }
        if next <= p {
          p = parse_item_sync(toks, p + 1, 4)
        } else { p = next }
        if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 5 { p = p + 1 } else { 0 }
      }
    }
  }
  HandlerClausesParse {
    clauses: parse_handler_clause_list_reverse(reversed),
    completion: completion,
    return_count: return_count,
    next: p
  }
}

-- Parse: Effect[<type_args>].op(params) or module.Effect[<type_args>].op(...)
pub(package) fn parse_one_handle_clause(
  toks: i64,
  src: i64,
  pos: i64
) -[Diagnose, TypeParameterScope]> HandlerClauseParse {
  if tok_tag(toks, pos) != 2 {
    parse_syntax_error(
      toks,
      src,
      pos,
      "error: expected effect operation or 'return' in handler",
      "handler clause",
      "skip_handler_clause"
    )
    HandlerClauseParse {
      clause: UnknownHandlerClause(0),
      include: false,
      next: parse_item_sync(toks, pos + 1, 4)
    }
  } else {
    let module_member_tail = (tok_tag(toks, pos + 3) == 5 and tok_v1(toks, pos + 3) == 8) or (
      tok_tag(toks, pos + 3) == 4 and tok_v1(toks, pos + 3) == 7
    )
    let module_shaped = tok_tag(toks, pos + 1) == 5 and tok_v1(toks, pos + 1) == 8 and tok_tag(
      toks,
      pos + 2
    ) == 2 and module_member_tail
    let eff_pos = if module_shaped { pos + 2 } else { pos }
    let eff_ns = tok_v1(toks, eff_pos)
    let eff_nl = tok_v2(toks, eff_pos)
    let bare_ref = if module_shaped {
      FieldAccess(
        Ident(tok_v1(toks, pos), tok_v2(toks, pos)),
        eff_ns,
        eff_nl,
        UnknownFieldAccessFact
      )
    } else { Ident(eff_ns, eff_nl) }
    let effect_ref = if tok_tag(toks, eff_pos + 1) == 4 and tok_v1(toks, eff_pos + 1) == 7 {
      let types = parse_type_args(toks, src, eff_pos + 2, TypeParameterScope.current())
      if module_shaped {
        syntax_parse(
          FieldAccess(
            Ident(tok_v1(toks, pos), tok_v2(toks, pos)),
            eff_ns,
            eff_nl,
            ResolvedEffectAccessFact(0, types.syntax)
          ),
          types.next
        )
      } else { syntax_parse(GenericCall(types.syntax, bare_ref), types.next) }
    } else {
      syntax_parse(bare_ref, eff_pos + 1)
    }
    let after_effect = effect_ref.next
    let has_dot = tok_tag(toks, after_effect) == 5 and tok_v1(toks, after_effect) == 8
    if not has_dot {
      parse_syntax_error(
        toks,
        src,
        after_effect,
        "error: expected '.' after effect name in handler clause",
        "handler clause",
        "skip_handler_clause"
      )
    } else { 0 }
    let p = if has_dot { after_effect + 1 } else { after_effect }
    -- Parse op name
    let op_ns = tok_v1(toks, p)
    let op_nl = tok_v2(toks, p)
    let has_op = has_dot and tok_tag(toks, p) == 2
    if has_dot and not has_op {
      parse_syntax_error(
        toks,
        src,
        p,
        "error: expected operation name after '.' in handler clause",
        "handler clause",
        "skip_handler_clause"
      )
    } else { 0 }
    let has_params = has_op and tok_tag(toks, p + 1) == 5 and tok_v1(toks, p + 1) == 1
    if has_op and not has_params {
      parse_syntax_error(
        toks,
        src,
        p + 1,
        "error: expected '(' after handler operation name",
        "handler clause",
        "skip_handler_clause"
      )
    } else { 0 }
    let params = if has_params {
      parse_fn_params(toks, src, p + 2, TypeParameterScope.current())
    } else { syntax_parse(ParamListNil, p + 1) }
    let p2 = params.next
    -- Optional deferred-continuation binder: with k
    let continuation = parse_handle_clause_continuation(toks, src, p2)
    let p_cont = continuation.next
    let has_with = tok_tag(toks, p2) == 2 and src_eq(
      src,
      tok_v1(toks, p2),
      tok_v2(toks, p2),
      "with"
    ) == 1
    let has_continuation = match continuation.syntax {
      HandlerClauseContinuation(_, _) -> true
      _ -> false
    }
    if has_params and has_with and not has_continuation {
      parse_syntax_error(
        toks,
        src,
        p2 + 1,
        "error: expected continuation name after 'with'",
        "handler clause",
        "skip_handler_clause"
      )
    } else { 0 }
    let has_arrow = has_params and (not has_with or has_continuation) and tok_tag(toks, p_cont) ==
      6
    if has_params and (not has_with or has_continuation) and not has_arrow {
      parse_syntax_error(
        toks,
        src,
        p_cont,
        "error: expected '->' after handler operation pattern",
        "handler clause",
        "skip_handler_clause"
      )
    } else { 0 }
    let p3 = if has_arrow { p_cont + 1 } else { p_cont }
    if has_arrow { tok_note_layout(toks, p3, LayoutBreak) } else { nil }
    let has_body = has_arrow and parse_expr_starts_at(toks, p3) == 1
    if has_arrow and not has_body {
      parse_syntax_error(
        toks,
        src,
        p3,
        "error: expected expression after handler-clause '->'",
        "handler clause",
        "skip_handler_clause"
      )
    } else { 0 }
    let body = if has_body {
      parse_expr(toks, src, p3, 0)
    } else { syntax_parse(NilExpr, parse_item_sync(toks, p3, 4)) }
    -- Store the effect reference plus op span. The nested effect reference is
    -- the single syntax fact consumed by checking, lowering, and formatting.
    HandlerClauseParse {
      clause: HandlerClause(
        HandlerClauseName(effect_ref.syntax, op_ns, op_nl),
        params.syntax,
        body.syntax,
        continuation.syntax
      ),
      include: has_body,
      next: skip_comma(toks, body.next)
    }
  }
}

-- Parse effect declaration: effect Name { [pub(package)] fn op(...) -> T ... }
-- Effect declarations retain operation signatures and authored visibility.
pub(package) fn parse_effect_member_sync(toks: i64, src: i64, pos: i64) -> i64 {
  let mut p = pos
  let mut done = 0
  while done == 0 {
    let tag = tok_tag(toks, p)
    if tag == 7 { done = 1 }
    else {
      if tag == 5 and tok_v1(toks, p) == 4 { done = 1 }
      else {
        if tag == 3 and tok_v1(toks, p) == 1 { done = 1 }
        else {
          if parse_is_deferred_marker(toks, src, p) == 1 { done = 1 }
          else {
            if tag == 3 and tok_v1(toks, p) != 34 { done = 1 }
            else { p = p + 1 }
          }
        }
      }
    }
  }
  p
}

pub(package) fn parse_effect_decl(
  toks: i64,
  src: i64,
  pos: i64,
  effect_visibility: DeclVisibility
) -[Diagnose]> DeclarationParse {
  -- pos is after "effect" keyword
  let name_ns = tok_v1(toks, pos)
  let name_nl = tok_v2(toks, pos)
  -- parameterized effects: optional <T, U> effect type parameters after the name (kernel §7.1).
  -- Op signatures parse with these as tctx so E in op types becomes a TypeVar.
  let tparams_r = if tok_tag(toks, pos + 1) == 4 {
    if tok_v1(toks, pos + 1) == 7 {
      parse_type_params(toks, src, pos + 2)
    } else { syntax_parse(TypeParamListNil, pos + 1) }
  } else { syntax_parse(TypeParamListNil, pos + 1) }
  let etparams = tparams_r.syntax
  let p_tp = tparams_r.next
  let has_body = tok_tag(toks, p_tp) == 5 and tok_v1(toks, p_tp) == 3
  if not has_body {
    parse_syntax_error(
      toks,
      src,
      p_tp,
      "error: expected '{' after effect declaration name",
      "effect declaration",
      if is_decl_start(toks, p_tp) == 1 { "resume_at_declaration" } else { "continue_effect" }
    )
  } else { 0 }
  let mut p = if has_body { p_tp + 1 } else { p_tp }
  -- Parse operation declarations until }
  let mut ops: List<EffectOperationSyntax> = Nil
  let errors_before_body = tok_parse_error_count(toks)
  let mut done = if has_body { 0 } else { 1 }
  while done == 0 {
    let tag = tok_tag(toks, p)
    if tag == 5 and tok_v1(toks, p) == 4 { done = 1 }
    else {
      if tag == 7 or (tag == 3 and tok_v1(toks, p) != 1 and tok_v1(toks, p) != 34) {
        if tok_parse_error_count(toks) == errors_before_body {
          parse_missing_delimiter(
            toks,
            src,
            p,
            p_tp,
            "error: expected '}' after effect declaration",
            "}",
            "effect declaration",
            if tag == 7 { "resume_at_end_of_file" } else { "resume_at_declaration" }
          )
        } else { 0 }
        done = 1
      }
      else {
        if tag == 5 and (tok_v1(toks, p) == 5 or tok_v1(toks, p) == 13) { p = p + 1 }
        else {
          let declared = parse_decl_visibility(toks, src, p)
          let member_p = declared.next
          let visibility_too_wide = declared.explicit and decl_visibility_wider_than(
            declared.visibility,
            effect_visibility
          )
          if visibility_too_wide {
            parse_syntax_error(
              toks,
              src,
              p,
              "error: effect operation visibility cannot exceed effect visibility",
              "effect declaration",
              "continue_effect"
            )
          } else { 0 }
          let operation_visibility = if not declared.explicit or visibility_too_wide {
            effect_visibility
          } else { declared.visibility }
          let is_deferred = parse_is_deferred_marker(toks, src, member_p)
          let fn_pos = if is_deferred == 1 { member_p + 2 } else { member_p }
          if tok_tag(toks, fn_pos) == 3 and tok_v1(toks, fn_pos) == 1 {
            if tok_tag(toks, fn_pos + 1) != 2 {
              parse_syntax_error(
                toks,
                src,
                fn_pos + 1,
                "error: expected effect operation name after 'fn'",
                "effect operation declaration",
                "continue_effect"
              )
              p = parse_effect_member_sync(toks, src, fn_pos + 2)
            } else {
              if not (tok_tag(toks, fn_pos + 2) == 5 and tok_v1(toks, fn_pos + 2) == 1) {
                parse_syntax_error(
                  toks,
                  src,
                  fn_pos + 2,
                  "error: expected '(' after effect operation name",
                  "effect operation declaration",
                  "continue_effect"
                )
                p = parse_effect_member_sync(toks, src, fn_pos + 2)
              } else {
                -- [@deferred] fn op(...) -> T
                tok_note_layout(toks, fn_pos, LayoutSignatureStart)
                let op_ns = tok_v1(toks, fn_pos + 1)
                let op_nl = tok_v2(toks, fn_pos + 1)
                let errors_before_op = tok_parse_error_count(toks)
                let params = parse_fn_params(toks, src, fn_pos + 3, etparams)
                let ret_r = parse_ret_type(toks, src, params.next, etparams)
                let ret_type = match ret_r.syntax.result {
                  MissingTypeExpr -> {
                    if tok_parse_error_count(toks) == errors_before_op {
                      parse_syntax_error(
                        toks,
                        src,
                        params.next,
                        "error: expected return type after effect operation parameters",
                        "effect operation declaration",
                        "continue_effect"
                      )
                    } else { 0 }
                    AnyTypeExpr
                  }
                  result -> result
                }
                let operation = if is_deferred == 1 {
                  DeferredTypeEffectOp(
                    op_ns,
                    op_nl,
                    params.syntax,
                    ret_type
                  )
                } else {
                  TypeEffectOp(
                    op_ns,
                    op_nl,
                    params.syntax,
                    ret_type
                  )
                }
                ops = Cons(
                  EffectOperationSyntax {
                    operation: operation,
                    visibility: operation_visibility
                  },
                  ops
                )
                p = ret_r.next
                tok_note_layout(toks, p, LayoutSignatureEnd)
              }
            }
          } else {
            parse_syntax_error(
              toks,
              src,
              member_p,
              "error: expected effect operation declaration or '}'",
              "effect declaration",
              "continue_effect"
            )
            p = parse_effect_member_sync(toks, src, member_p + 1)
          }
        }
      }
    }
  }
  if has_body and tok_tag(toks, p) == 5 and tok_v1(toks, p) == 4 {
    tok_note_layout_group(toks, p_tp, p)
  } else { nil }
  DeclarationParse {
    syntax: EffectDefinition(
      EffectSyntax {
        name: TypeNameRange { start: name_ns, length: name_nl },
        type_params: etparams,
        operations: ops.reverse()
      }
    ),
    next: if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 4 { p + 1 } else { p }
  }
}

-- Lookahead: check if tokens starting at pos (inside parens) form a lambda param list
-- followed by ) and =>. Scans without consuming. Returns 1 if lambda, 0 if grouped expr.
pub(package) fn is_lambda_start(toks: i64, pos: i64) -> bool {
  -- Parameter types use the full type grammar, including nested function
  -- types and [T]/[T; N]. Look through the balanced outer parens and let
  -- parse_fn_params validate the contents once a following => proves this
  -- is a lambda rather than a grouped expression.
  let mut p = pos
  let mut depth = 1
  let mut done = false
  let mut ok = false
  while done == 0 {
    let tag = tok_tag(toks, p)
    if tag == 7 { done = 1 }
    else {
      if tag == 5 {
        let v = tok_v1(toks, p)
        if v == 1 { depth = depth + 1 p = p + 1 }
        else {
          if v == 2 {
            depth = depth - 1
            if depth == 0 {
              done = 1
              if tok_tag(toks, p + 1) == 10 { ok = true } else { 0 }
            } else { p = p + 1 }
          } else { p = p + 1 }
        }
      } else { p = p + 1 }
    }
  }
  ok
}

-- Parse multi-param lambda: (x, y) => body or (x: i64, y: str) => body
-- pos is after the opening (
pub(package) fn parse_multi_lambda(
  toks: i64,
  src: i64,
  pos: i64
) -[Diagnose, TypeParameterScope]> SyntaxParse<Expr> {
  let params = parse_fn_params(toks, src, pos, TypeParameterScope.current())
  -- after_params should be past ). Next should be => (tag 10).
  let source_site = tok_span(toks, params.next)
  let p = if tok_tag(toks, params.next) == 10 { params.next + 1 } else { params.next }
  let body = parse_expr(toks, src, p, 0)
  syntax_parse(Lambda(params.syntax, body.syntax, source_site), body.next)
}

-- Anonymous records reuse RecordInit with an absent nominal name. Tuple
-- expressions use the same node with f2=-1 and reserved negative field keys;
-- the checker turns both spellings into closed structural-record facts.
pub(package) fn parse_anonymous_record_expr(
  toks: i64,
  src: i64,
  pos: i64
) -[Diagnose, TypeParameterScope]> SyntaxParse<Expr> {
  let mut reversed = RecordFieldListNil
  let mut p = pos + 1
  let mut done = 0
  while done == 0 {
    if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 4 {
      done = 1
      p = p + 1
    } else {
      if tok_tag(toks, p) == 2 and tok_tag(toks, p + 1) == 5 and tok_v1(toks, p + 1) == 6 {
        tok_note_layout_member(toks, p)
        let field_ns = tok_v1(toks, p)
        let field_nl = tok_v2(toks, p)
        let value = parse_expr(toks, src, p + 2, 0)
        reversed = RecordFieldListCons(
          RecordField(field_ns, field_nl, value.syntax, UnknownRecordFieldFact),
          reversed
        )
        p = parse_skip_synthetic_before_close(toks, value.next, 4)
        if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 5 {
          p = p + 1
        } else {
          if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 4 {
            done = 1
            p = p + 1
          } else {
            parse_syntax_error(
              toks,
              src,
              p,
              "error: expected ',' or '}' after structural record field",
              "record expression",
              "stop_record"
            )
            done = 1
          }
        }
      } else {
        parse_syntax_error(
          toks,
          src,
          p,
          "error: expected structural record field",
          "record expression",
          "stop_record"
        )
        done = 1
      }
    }
  }
  if tok_tag(toks, p - 1) == 5 and tok_v1(toks, p - 1) == 4 {
    tok_note_layout_group(toks, pos, p - 1)
  } else { nil }
  syntax_parse(
    RecordInit(
      0,
      0,
      parse_record_field_list_reverse(reversed),
      InferredRecordType(MissingTypeExpr)
    ),
    p
  )
}

pub(package) fn parse_record_update_expr(
  toks: i64,
  src: i64,
  base: Expr,
  open_pos: i64
) -[Diagnose, TypeParameterScope]> SyntaxParse<Expr> {
  let mut reversed = RecordFieldListNil
  let mut p = open_pos + 1
  let mut done = 0
  while done == 0 {
    if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 4 {
      done = 1
      p = p + 1
    } else {
      if tok_tag(toks, p) == 2 and tok_tag(toks, p + 1) == 5 and tok_v1(toks, p + 1) == 6 {
        tok_note_layout_member(toks, p)
        let field_ns = tok_v1(toks, p)
        let field_nl = tok_v2(toks, p)
        let value = parse_expr(toks, src, p + 2, 0)
        reversed = RecordFieldListCons(
          RecordField(field_ns, field_nl, value.syntax, UnknownRecordFieldFact),
          reversed
        )
        p = parse_skip_synthetic_before_close(toks, value.next, 4)
        if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 5 {
          p = p + 1
        } else {
          if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 4 {
            done = 1
            p = p + 1
          } else {
            parse_syntax_error(
              toks,
              src,
              p,
              "error: expected ',' or '}' after record update field",
              "record update",
              "stop_record"
            )
            done = 1
          }
        }
      } else {
        parse_syntax_error(
          toks,
          src,
          p,
          "error: expected record update field",
          "record update",
          "stop_record"
        )
        done = 1
      }
    }
  }
  if tok_tag(toks, p - 1) == 5 and tok_v1(toks, p - 1) == 4 {
    tok_note_layout_group(toks, open_pos, p - 1)
  } else { nil }
  syntax_parse(
    RecordUpdate(base, parse_record_field_list_reverse(reversed), UnknownRecordUpdateFact),
    p
  )
}

pub(package) fn parse_tuple_expr_field(index: i64, value: Expr) -> RecordField {
  -- A negative name length is the internal positional-key marker. The key is
  -- exactly the one used by ty_tuple: -1, -2, ...
  RecordField(0 - index - 1, 0 - 1, value, UnknownRecordFieldFact)
}

pub(package) fn parse_group_or_tuple_expr(
  toks: i64,
  src: i64,
  pos: i64
) -[Diagnose, TypeParameterScope]> SyntaxParse<Expr> {
  let mut reversed = RecordFieldListNil
  let mut p = pos + 1
  if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 2 {
    tok_note_layout_group(toks, pos, p)
    syntax_parse(
      RecordInit(0, 0 - 1, RecordFieldListNil, InferredRecordType(MissingTypeExpr)),
      p + 1
    )
  } else {
    tok_note_layout_item(toks, p)
    let first = parse_expr(toks, src, p, 0)
    p = parse_skip_synthetic_before_close(toks, first.next, 2)
    if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 2 {
      tok_note_layout_group(toks, pos, p)
      syntax_parse(first.syntax, p + 1)
    } else {
      if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 5 {
        reversed = RecordFieldListCons(parse_tuple_expr_field(0, first.syntax), reversed)
        p = p + 1
        let mut done = 0
        while done == 0 {
          if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 2 {
            done = 1
            p = p + 1
          } else {
            tok_note_layout_item(toks, p)
            let item = parse_expr(toks, src, p, 0)
            reversed = RecordFieldListCons(
              parse_tuple_expr_field(record_field_list_len(reversed), item.syntax),
              reversed
            )
            p = parse_skip_synthetic_before_close(toks, item.next, 2)
            if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 5 {
              p = p + 1
            } else {
              if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 2 {
                done = 1
                p = p + 1
              } else {
                parse_syntax_error(
                  toks,
                  src,
                  p,
                  "error: expected ',' or ')' after tuple item",
                  "tuple expression",
                  "stop_tuple"
                )
                done = 1
              }
            }
          }
        }
        if tok_tag(toks, p - 1) == 5 and tok_v1(toks, p - 1) == 2 {
          tok_note_layout_group(toks, pos, p - 1)
        } else { nil }
        syntax_parse(
          RecordInit(
            0,
            0 - 1,
            parse_record_field_list_reverse(reversed),
            InferredRecordType(MissingTypeExpr)
          ),
          p
        )
      } else {
        parse_syntax_error(
          toks,
          src,
          p,
          "error: expected ')' after grouped expression",
          "grouped expression",
          "stop_expression"
        )
        syntax_parse(first.syntax, p)
      }
    }
  }
}

-- parse_expr: combined primary + infix. No mutual recursion.
-- All sub-helpers (parse_if, parse_let, etc.) are defined BEFORE this.
pub(package) fn parse_expr(
  toks: i64,
  src: i64,
  pos: i64,
  min_prec: i64
) -[Diagnose, TypeParameterScope]> SyntaxParse<Expr> {
  -- Parse primary
  let tag = tok_tag(toks, pos)
  let v1 = tok_v1(toks, pos)
  let lhs_r = if tag == 1 {
    -- IntLit
    let lit_start = v1
    let lit_len = tok_v2(toks, pos)
    syntax_parse(
      IntLit(integer_span_value_wrapping(src, lit_start, lit_len), lit_start, lit_len),
      pos + 1
    )
  } else {
    if tag == 13 {
      -- FloatLit: preserve source span for exact codegen-side decimal lowering.
      syntax_parse(FloatLit(v1, tok_v2(toks, pos), MissingTypeExpr), pos + 1)
    } else {
      if tag == 2 {
        -- `with` is contextual so the existing `with k` handler-clause binder
        -- remains unchanged. Everywhere else this path parses an ordinary name.
        if src_eq(src, v1, tok_v2(toks, pos), "with") == 1 {
          parse_with_handler_expr(toks, src, pos)
        } else {
          -- Ident or call (record constructor handled in parse_ident_or_call)
          parse_ident_or_call(toks, src, pos)
        }
      } else {
        if tag == 3 {
          if v1 == 3 { parse_if(toks, src, pos + 1) }
          else {
            if v1 == 2 { parse_let(toks, src, pos + 1) }
            else {
              if v1 == 8 { parse_while(toks, src, pos + 1) }
              else {
                if v1 == 29 { parse_for(toks, src, pos + 1) }
                else {
                  if v1 == 10 { parse_match(toks, src, pos + 1) }
                  else {
                    if v1 == 11 {
                      -- not expr: boolean negation (AST tag 22)
                      let operand = parse_expr(toks, src, pos + 1, 13)
                      syntax_parse(Not(operand.syntax), operand.next)
                    }
                    else {
                      if v1 == 20 {
                        -- return expr (AST tag 25)
                        let returned = parse_expr(toks, src, pos + 1, 0)
                        syntax_parse(Return(returned.syntax), returned.next)
                      }
                      else {
                        if v1 == 21 {
                          -- break or break(expr) (AST tag 26, f1 = value or 0)
                          if tok_tag(toks, pos + 1) == 5 {
                            if tok_v1(toks, pos + 1) == 1 {
                              -- break(expr)
                              let value = parse_expr(toks, src, pos + 2, 0)
                              let p_after = value.next
                              let has_close = tok_tag(toks, p_after) == 5 and tok_v1(
                                toks,
                                p_after
                              ) == 2
                              if not has_close {
                                parse_missing_delimiter(
                                  toks,
                                  src,
                                  p_after,
                                  pos + 1,
                                  "error: expected ')' after break value",
                                  ")",
                                  "break expression",
                                  "continue_expression"
                                )
                              } else { 0 }
                              let p_close = if has_close { p_after + 1 } else { p_after }
                              syntax_parse(Break(value.syntax), p_close)
                            } else { syntax_parse(BreakNoValue, pos + 1) }
                          } else { syntax_parse(BreakNoValue, pos + 1) }
                        }
                        else {
                          if v1 == 22 {
                            -- continue (AST tag 27)
                            syntax_parse(Continue, pos + 1)
                          }
                          else {
                            if v1 == 31 {
                              -- loop { body } — infinite loop, value determined by break(expr)
                              -- Desugars to while true { body } but with break-value support (tag 49)
                              parse_loop_expr(toks, src, pos + 1)
                            }
                            else {
                              if v1 == 33 {
                                parse_defer(toks, src, pos + 1)
                              }
                              else {
                                if v1 == 24 {
                                  -- handle expr { clauses }
                                  parse_handle_expr(toks, src, pos + 1)
                                }
                                else {
                                  if v1 == 25 {
                                    -- resume(val) — AST tag 35
                                    let value = parse_expr(toks, src, pos + 1, 0)
                                    syntax_parse(Resume(value.syntax), value.next)
                                  }
                                  else {
                                    parse_syntax_error(
                                      toks,
                                      src,
                                      pos,
                                      "error: expected expression",
                                      "expression",
                                      "skip_token"
                                    )
                                    syntax_parse(IntLit(0, 0, 0), pos + 1)
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        } else {
          if tag == 5 {
            if v1 == 10 {
              -- &expr / &mut expr: trusted raw address-of (AST tag 55).
              let is_mut = if tok_tag(toks, pos + 1) == 3 {
                if tok_v1(toks, pos + 1) == 5 { 1 } else { 0 }
              } else { 0 }
              let operand_pos = if is_mut == 1 { pos + 2 } else { pos + 1 }
              let operand = parse_expr(toks, src, operand_pos, 13)
              syntax_parse(AddressOf(is_mut, operand.syntax), operand.next)
            } else {
              if v1 == 1 {
                -- ( — could be grouped expr or multi-param lambda
                if is_lambda_start(toks, pos + 1) {
                  parse_multi_lambda(toks, src, pos + 1)
                } else {
                  parse_group_or_tuple_expr(toks, src, pos)
                }
              } else {
                if v1 == 3 {
                  let empty_record = tok_tag(toks, pos + 1) == 5 and tok_v1(toks, pos + 1) == 4
                  let named_field = tok_tag(toks, pos + 1) == 2 and tok_tag(toks, pos + 2) ==
                    5 and tok_v1(toks, pos + 2) == 6
                  if empty_record or named_field { parse_anonymous_record_expr(toks, src, pos) }
                  else { parse_block(toks, src, pos + 1) }
                } else {
                  if v1 == 17 {
                    parse_array_literal(toks, src, pos)
                  } else {
                    parse_syntax_error(
                      toks,
                      src,
                      pos,
                      "error: expected expression",
                      "expression",
                      "skip_token"
                    )
                    syntax_parse(IntLit(0, 0, 0), pos + 1)
                  }
                }
              }
            }
          } else {
            if tag == 4 {
              if v1 == 2 {
                -- Keep the signed integer literal representation used by range checks.
                -- Other numeric negation retains its own operation: IEEE sign reversal
                -- is observably different from subtraction from positive zero.
                let operand = parse_expr(toks, src, pos + 1, 12)
                let negated = match operand.syntax {
                  IntLit(value, start, length) ->
                    BinOp(2, IntLit(0, 0, 0), IntLit(value, start, length))
                  other -> Negate(other, MissingTypeExpr)
                }
                syntax_parse(negated, operand.next)
              } else {
                parse_syntax_error(
                  toks,
                  src,
                  pos,
                  "error: expected expression before operator",
                  "expression",
                  "skip_token"
                )
                syntax_parse(IntLit(0, 0, 0), pos + 1)
              }
            } else {
              if tag == 9 {
                -- The authored token range travels with the literal through typed syntax.
                syntax_parse(
                  BoolLit(v1, tok_span(toks, pos), tok_end(toks, pos) - tok_span(toks, pos)),
                  pos + 1
                )
              } else {
                if tag == 8 {
                  -- Plain strings are always literal. f1/f2 retain decoded bytes; f3/f4
                  -- retain the authored token range for checker facts and diagnostics.
                  syntax_parse(
                    StringLit(
                      v1,
                      tok_v2(toks, pos),
                      tok_span(toks, pos),
                      tok_end(toks, pos) - tok_span(toks, pos)
                    ),
                    pos + 1
                  )
                } else {
                  if tag == 15 {
                    syntax_parse(
                      parse_explicit_interp_string(src, v1, tok_v2(toks, pos)),
                      pos + 1
                    )
                  } else {
                    parse_syntax_error(
                      toks,
                      src,
                      pos,
                      "error: expected expression",
                      "expression",
                      "skip_token"
                    )
                    syntax_parse(IntLit(0, 0, 0), pos + 1)
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  -- Check for lambda: ident => body
  let lhs_node = lhs_r.syntax
  let lhs_pos = lhs_r.next
  if tok_tag(toks, lhs_pos) == 10 {
    -- Fat arrow => : this is a lambda
    match lhs_node {
      Ident(ns, nl) -> {
        let params = ParamListCons(
          Param(ns, nl, MissingTypeExpr, ImplicitParamLabel),
          ParamListNil
        )
        let body = parse_expr(toks, src, lhs_pos + 1, 0)
        syntax_parse(Lambda(params, body.syntax, tok_span(toks, lhs_pos)), body.next)
      }
      _ -> {
        -- Parenthesized params: already parsed as expr, but we treat as error for now
        -- TODO: multi-param lambda support
        pe_infix(toks, src, lhs_node, lhs_pos, min_prec)
      }
    }
  } else {
    pe_infix(toks, src, lhs_node, lhs_pos, min_prec)
  }
}

pub(package) fn parse_apply(callee: Expr, args: ExprList, site: i64) -> Expr {
  match callee {
    Ident(ns, nl) -> Call(ns, nl, args)
    GenericCall(type_args, Ident(ns, nl)) ->
      GenericCall(type_args, Call(ns, nl, args))
    other -> Apply(other, args, MissingTypeExpr, site)
  }
}

fn parse_pipe_apply(lhs: Expr, rhs: Expr, op: i64) -> Expr {
  match rhs {
    Apply(callee, args, checked_type, site) ->
      Apply(callee, ExprListCons(lhs, args), checked_type, site)
    Call(ns, nl, args) -> Call(ns, nl, ExprListCons(lhs, args))
    Perform(base, op_ns, op_nl, args) ->
      Perform(base, op_ns, op_nl, ExprListCons(lhs, args))
    GenericCall(type_args, inner) -> match inner {
      Call(ns, nl, args) ->
        GenericCall(type_args, Call(ns, nl, ExprListCons(lhs, args)))
      Perform(base, op_ns, op_nl, args) ->
        GenericCall(type_args, Perform(base, op_ns, op_nl, ExprListCons(lhs, args)))
      _ -> BinOp(op, lhs, GenericCall(type_args, inner))
    }
    Ident(ns, nl) -> Call(ns, nl, ExprListCons(lhs, ExprListNil))
    other -> BinOp(op, lhs, other)
  }
}

pub(package) fn pe_infix(
  toks: i64,
  src: i64,
  lhs: Expr,
  pos: i64,
  min_prec: i64
) -[Diagnose, TypeParameterScope]> SyntaxParse<Expr> {
  let tag = tok_tag(toks, pos)
  if tag == 5 and tok_v1(toks, pos) == 1 {
    let arguments = parse_call_args(toks, src, pos + 1)
    let application = parse_apply(lhs, arguments.syntax, tok_span(toks, pos))
    return pe_infix(toks, src, application, arguments.next, min_prec)
  } else { 0 }
  if tag == 4 {
    let op_id = tok_v1(toks, pos)
    let prec = op_prec(op_id)
    if prec > min_prec {
      tok_note_layout(toks, pos + 1, LayoutBreak)
      if op_id == 19 {
        -- Pipe: lhs |> f(args) → f(lhs, args)  or  lhs |> f → f(lhs)
        let rhs = parse_expr(toks, src, pos + 1, prec)
        pe_infix(toks, src, parse_pipe_apply(lhs, rhs.syntax, op_id), rhs.next, min_prec)
      } else {
        let rhs = parse_expr(toks, src, pos + 1, prec)
        pe_infix(toks, src, BinOp(op_id, lhs, rhs.syntax), rhs.next, min_prec)
      }
    } else { syntax_parse(lhs, pos) }
  } else {
    if tag == 5 {
      if tok_v1(toks, pos) == 8 {
        if tok_tag(toks, pos + 1) == 4 and tok_v1(toks, pos + 1) == 3 {
          -- Dot-star: pointer dereference read (AST tag 56).
          pe_infix(toks, src, Deref(lhs), pos + 2, min_prec)
        } else {
          if tok_tag(toks, pos + 1) == 5 and tok_v1(toks, pos + 1) == 3 {
            let update = parse_record_update_expr(toks, src, lhs, pos + 1)
            pe_infix(toks, src, update.syntax, update.next, min_prec)
          } else {
            -- Dot: field access or method/effect call
            let field_ns = tok_v1(toks, pos + 1)
            -- Tuple positions retain their decimal source span while a negative
            -- length distinguishes the compiler-reserved positional key from an
            -- identifier that merely happens to contain digits elsewhere. The
            -- checker resolves the marked span to the same -1, -2, ... keys used
            -- by tuple types and literals.
            let field_nl = if tok_tag(toks, pos + 1) == 1 { 0 - tok_v2(toks, pos + 1) }
            else { tok_v2(toks, pos + 1) }
            if tok_tag(toks, pos + 1) == 1 and integer_span_le_decimal_max(
              src,
              field_ns,
              tok_v2(toks, pos + 1),
              "9223372036854775807"
            ) == 0 {
              parse_syntax_error(
                toks,
                src,
                pos + 1,
                "error: tuple position exceeds the supported range",
                "tuple position",
                "continue_expression"
              )
            }

            -- `Vector<T>.to_array<N>()` carries a compile-time length rather than a
            -- type argument. Preserve it as a marked literal argument; the checker
            -- replaces this surface-only shape with the ordinary typed generic-call
            -- fact consumed by lowering. No other method gains const parameters.
            let is_to_array_const = if src_eq(src, field_ns, field_nl, "to_array") == 1 and
              tok_tag(toks, pos + 2) == 4 {
                if tok_v1(toks, pos + 2) == 7 { 1 } else { 0 }
              } else { 0 }
            let is_to_array_missing_const = if src_eq(src, field_ns, field_nl, "to_array") ==
              1 and tok_tag(toks, pos + 2) == 5 {
                if tok_v1(toks, pos + 2) == 1 and tok_tag(toks, pos + 3) == 5 {
                  if tok_v1(toks, pos + 3) == 2 { 1 } else { 0 }
                } else { 0 }
              } else { 0 }
            -- Check if field is followed by ( → method/effect perform call
            if is_to_array_const == 1 {
              let length_ok = if tok_tag(toks, pos + 3) == 1 and tok_tag(toks, pos + 4) == 4 {
                if tok_v1(toks, pos + 4) == 8 { 1 } else { 0 }
              } else { 0 }
              let call_ok = if tok_tag(toks, pos + 5) == 5 and tok_v1(toks, pos + 5) == 1 and
                tok_tag(toks, pos + 6) == 5 {
                  if tok_v1(toks, pos + 6) == 2 { 1 } else { 0 }
                } else { 0 }
              let one_bad_atom_call = if tok_tag(toks, pos + 4) == 4 and tok_v1(toks, pos + 4) ==
                8 and tok_tag(toks, pos + 5) == 5 and tok_v1(toks, pos + 5) == 1 and tok_tag(
                  toks,
                  pos + 6
                ) == 5 {
                  if tok_v1(toks, pos + 6) == 2 { 1 } else { 0 }
                } else { 0 }
              let negative_call = if tok_tag(toks, pos + 3) == 4 and tok_v1(toks, pos + 3) ==
                2 and tok_tag(toks, pos + 4) == 1 and tok_tag(toks, pos + 5) == 4 and tok_v1(
                  toks,
                  pos + 5
                ) == 8 and tok_tag(toks, pos + 6) == 5 and tok_v1(toks, pos + 6) == 1 and tok_tag(
                  toks,
                  pos + 7
                ) == 5 {
                  if tok_v1(toks, pos + 7) == 2 { 1 } else { 0 }
                } else { 0 }
              let argument = if length_ok == 1 and call_ok == 1 {
                let length_start = tok_v1(toks, pos + 3)
                let length_len = tok_v2(toks, pos + 3)
                if integer_span_le_decimal_max(
                  src,
                  length_start,
                  length_len,
                  "9223372036854775807"
                ) == 0 {
                  parse_syntax_error(
                    toks,
                    src,
                    pos + 3,
                    "error: to_array length exceeds the supported range",
                    "array conversion",
                    "continue_expression"
                  )
                }
                -- A negative span length is the internal const-argument marker.
                IntLit(
                  integer_span_value_wrapping(src, length_start, length_len),
                  length_start,
                  0 - length_len
                )
              } else {
                parse_syntax_error(
                  toks,
                  src,
                  pos + 2,
                  "error: to_array length must be a non-negative integer literal",
                  "array conversion",
                  "continue_expression"
                )
                IntLit(0 - 1, tok_span(toks, pos + 2), 0 - 1)
              }
              let perform = Perform(lhs, field_ns, field_nl, ExprListCons(argument, ExprListNil))
              let next_pos = if length_ok == 1 and call_ok == 1 { pos + 7 }
              else {
                if negative_call == 1 { pos + 8 }
                else { if one_bad_atom_call == 1 { pos + 7 } else { pos + 3 } }
              }
              pe_infix(toks, src, perform, next_pos, min_prec)
            } else {
              if is_to_array_missing_const == 1 {
                parse_syntax_error(
                  toks,
                  src,
                  pos + 1,
                  "error: to_array length must be a non-negative integer literal",
                  "array conversion",
                  "continue_expression"
                )
                let args = ExprListCons(IntLit(0 - 1, field_ns, 0 - field_nl), ExprListNil)
                pe_infix(toks, src, Perform(lhs, field_ns, field_nl, args), pos + 4, min_prec)
              } else {
                if tok_tag(toks, pos + 2) == 4 and tok_v1(toks, pos + 2) == 7 and
                  is_type_arg_start(toks, pos + 2) == 1 {
                    -- Qualified generic value call: `module.member<T>(args)`.  Keep the
                    -- dot node neutral; module/type/effect resolution belongs to the
                    -- checker and records an exact declaration/effect fact there.
                    let types = parse_type_args(toks, src, pos + 3, TypeParameterScope.current())
                    let after_types = types.next
                    if tok_tag(toks, after_types) == 5 and tok_v1(toks, after_types) == 3 {
                      let record = parse_qualified_record_lit(
                        toks,
                        src,
                        lhs,
                        field_ns,
                        field_nl,
                        types.syntax,
                        true,
                        after_types
                      )
                      pe_infix(toks, src, record.syntax, record.next, min_prec)
                    } else if tok_tag(toks, after_types) == 5 and tok_v1(toks, after_types) == 1 {
                      let arguments = parse_call_args(toks, src, after_types + 1)
                      let inner = Perform(lhs, field_ns, field_nl, arguments.syntax)
                      pe_infix(
                        toks,
                        src,
                        GenericCall(types.syntax, inner),
                        arguments.next,
                        min_prec
                      )
                    } else {
                      if tok_tag(toks, after_types) == 5 and tok_v1(toks, after_types) == 8 {
                        -- `module.Effect<T>.op()`: the generic arguments instantiate the
                        -- neutral module member, and the following dot remains available
                        -- for ordinary postfix parsing into the perform node.
                        let member = FieldAccess(
                          lhs,
                          field_ns,
                          field_nl,
                          ResolvedEffectAccessFact(0, types.syntax)
                        )
                        pe_infix(toks, src, member, after_types, min_prec)
                      } else {
                        parse_syntax_error(
                          toks,
                          src,
                          after_types,
                          "error: expected '(' after qualified type arguments",
                          "qualified call",
                          "continue_expression"
                        )
                        pe_infix(
                          toks,
                          src,
                          FieldAccess(lhs, field_ns, field_nl, UnknownFieldAccessFact),
                          after_types,
                          min_prec
                        )
                      }
                    }
                  } else {
                    if tok_tag(toks, pos + 2) == 5 {
                      if tok_v1(toks, pos + 2) == 3 and tok_tag(toks, pos + 4) == 5 and tok_v1(
                        toks,
                        pos + 4
                      ) == 6 and mem_load8_at(src, field_ns) >= 65 and mem_load8_at(src, field_ns) <=
                        90 {
                          let record = parse_qualified_record_lit(
                            toks,
                            src,
                            lhs,
                            field_ns,
                            field_nl,
                            TypeExprListNil,
                            false,
                            pos + 2
                          )
                          pe_infix(toks, src, record.syntax, record.next, min_prec)
                        } else if tok_v1(toks, pos + 2) == 1 {
                          -- .name( → method call / effect perform
                          -- AST tag 32 = Perform(base, op_ns, op_nl, args)
                          let arguments = parse_call_args(toks, src, pos + 3)
                          let perform = Perform(lhs, field_ns, field_nl, arguments.syntax)
                          pe_infix(toks, src, perform, arguments.next, min_prec)
                        } else {
                          pe_infix(
                            toks,
                            src,
                            FieldAccess(lhs, field_ns, field_nl, UnknownFieldAccessFact),
                            pos + 2,
                            min_prec
                          )
                        }
                    } else {
                      pe_infix(
                        toks,
                        src,
                        FieldAccess(lhs, field_ns, field_nl, UnknownFieldAccessFact),
                        pos + 2,
                        min_prec
                      )
                    }
                  }
              }
            }
          }
        }
      } else {
        if tok_v1(toks, pos) == 17 {
          -- Postfix checked indexing and half-open slicing. Range precedence is
          -- the delimiter here, so endpoint parsing deliberately stops at `..`.
          let first_pos = pos + 1
          if tok_tag(toks, first_pos) == 4 and tok_v1(toks, first_pos) == 20 {
            let end_pos = first_pos + 1
            let end_is_omitted = tok_tag(toks, end_pos) == 5 and tok_v1(toks, end_pos) == 14
            let end_r = if end_is_omitted { syntax_parse(NilExpr, end_pos) }
            else { parse_expr(toks, src, end_pos, 2) }
            let close_pos = end_r.next
            if tok_tag(toks, close_pos) == 5 and tok_v1(toks, close_pos) == 14 {
              let sliced = IndexedSlice(lhs, NilExpr, end_r.syntax, 0)
              pe_infix(toks, src, sliced, close_pos + 1, min_prec)
            } else {
              parse_syntax_error(
                toks,
                src,
                close_pos,
                "error: expected ']' after slice",
                "slice expression",
                "stop_expression"
              )
              syntax_parse(IndexedSlice(lhs, NilExpr, end_r.syntax, 0), close_pos)
            }
          } else {
            if tok_tag(toks, first_pos) == 5 and tok_v1(toks, first_pos) == 14 {
              parse_syntax_error(
                toks,
                src,
                first_pos,
                "error: expected index or '..' after '['",
                "index expression",
                "stop_expression"
              )
              syntax_parse(IndexedGet(lhs, NilExpr, 0, 0), first_pos + 1)
            } else {
              let first_r = parse_expr(toks, src, first_pos, 2)
              let after_first = first_r.next
              if tok_tag(toks, after_first) == 4 and tok_v1(toks, after_first) == 20 {
                let end_pos = after_first + 1
                let end_is_omitted = tok_tag(toks, end_pos) == 5 and tok_v1(toks, end_pos) == 14
                let end_r = if end_is_omitted { syntax_parse(NilExpr, end_pos) }
                else { parse_expr(toks, src, end_pos, 2) }
                let close_pos = end_r.next
                if tok_tag(toks, close_pos) == 5 and tok_v1(toks, close_pos) == 14 {
                  let sliced = IndexedSlice(lhs, first_r.syntax, end_r.syntax, 0)
                  pe_infix(toks, src, sliced, close_pos + 1, min_prec)
                } else {
                  parse_syntax_error(
                    toks,
                    src,
                    close_pos,
                    "error: expected ']' after slice",
                    "slice expression",
                    "stop_expression"
                  )
                  syntax_parse(IndexedSlice(lhs, first_r.syntax, end_r.syntax, 0), close_pos)
                }
              } else {
                if tok_tag(toks, after_first) == 5 and tok_v1(toks, after_first) == 14 {
                  let indexed = IndexedGet(lhs, first_r.syntax, 0, 0)
                  pe_infix(toks, src, indexed, after_first + 1, min_prec)
                } else {
                  parse_syntax_error(
                    toks,
                    src,
                    after_first,
                    "error: expected ']' after index",
                    "index expression",
                    "stop_expression"
                  )
                  syntax_parse(IndexedGet(lhs, first_r.syntax, 0, 0), after_first)
                }
              }
            }
          }
        } else {
          if tok_v1(toks, pos) == 12 {
            -- ? postfix operator: desugar expr? to
            -- match expr { Ok(v) -> v, Err(e) -> Fail.fail(e) }
            let desugar = parse_question_mark(
              lhs,
              tok_span(toks, pos),
              tok_end(toks, pos) - tok_span(toks, pos)
            )
            pe_infix(toks, src, desugar, pos + 1, min_prec)
          } else {
            if tok_v1(toks, pos) == 15 {
              -- ?. optional chaining: expr?.field desugars to
              -- AST tag 48 = OptChain(base, field_ns, field_nl)
              -- Codegen: if base is nil, perform Maybe.none(); else access field
              let field_ns = tok_v1(toks, pos + 1)
              let field_nl = tok_v2(toks, pos + 1)
              let chain = OptChain(lhs, field_ns, field_nl, 0)
              pe_infix(toks, src, chain, pos + 2, min_prec)
            } else { syntax_parse(lhs, pos) }
          }
        }
      }
    } else { syntax_parse(lhs, pos) }
  }
}

-- Retain the operator range alongside its operand. Checking publishes the
-- exact Fail atom after proving the standard Result contract.
pub(package) fn parse_question_mark(expr: Expr, start: i64, length: i64) -> Expr {
  Try(expr, 0, TypeNameRange { start: start, length: length })
}

-- ══════════════════════════════════════════════════════════════
-- Type expression parser
-- ══════════════════════════════════════════════════════════════
-- Precedence: ~ (tightest) > & > | (loosest), ? is postfix
pub(package) fn parse_type(
  toks: i64,
  src: i64,
  pos: i64,
  tctx: TypeParamList
) -> SyntaxParse<TypeExpr> {
  parse_type_union(toks, src, pos, tctx)
}

pub(package) fn parse_type_union(
  toks: i64,
  src: i64,
  pos: i64,
  tctx: TypeParamList
) -> SyntaxParse<TypeExpr> {
  let left = parse_type_inter(toks, src, pos, tctx)
  let mut result = left.syntax
  let mut p = left.next
  let mut done = 0
  while done == 0 {
    if tok_tag(toks, p) == 5 {
      if tok_v1(toks, p) == 9 {
        let rhs_pos = parse_skip_synthetic_semicolons(toks, p + 1)
        tok_note_layout(toks, rhs_pos, LayoutBreak)
        tok_note_layout(toks, rhs_pos, LayoutOptionalSeparator)
        let right = parse_type_inter(toks, src, rhs_pos, tctx)
        result = UnionTypeExpr(result, right.syntax)
        p = right.next
      } else { done = 1 }
    } else { done = 1 }
  }
  syntax_parse(result, p)
}

pub(package) fn parse_type_inter(
  toks: i64,
  src: i64,
  pos: i64,
  tctx: TypeParamList
) -> SyntaxParse<TypeExpr> {
  let left = parse_type_prefix(toks, src, pos, tctx)
  let mut result = left.syntax
  let mut p = left.next
  let mut done = 0
  while done == 0 {
    if tok_tag(toks, p) == 5 {
      if tok_v1(toks, p) == 10 {
        let rhs_pos = parse_skip_synthetic_semicolons(toks, p + 1)
        tok_note_layout(toks, rhs_pos, LayoutBreak)
        tok_note_layout(toks, rhs_pos, LayoutOptionalSeparator)
        let right = parse_type_prefix(toks, src, rhs_pos, tctx)
        result = IntersectionTypeExpr(result, right.syntax)
        p = right.next
      } else { done = 1 }
    } else { done = 1 }
  }
  syntax_parse(result, p)
}

pub(package) fn parse_type_prefix(
  toks: i64,
  src: i64,
  pos: i64,
  tctx: TypeParamList
) -> SyntaxParse<TypeExpr> {
  if tok_tag(toks, pos) == 4 {
    if tok_v1(toks, pos) == 3 {
      let is_mut = if tok_tag(toks, pos + 1) == 3 {
        if tok_v1(toks, pos + 1) == 5 { 1 } else { 0 }
      } else { 0 }
      let inner_pos = if is_mut == 1 { pos + 2 } else { pos + 1 }
      let inner = parse_type_prefix(toks, src, inner_pos, tctx)
      syntax_parse(
        PointerTypeExpr(
          inner.syntax,
          if is_mut == 1 { MutableTypeAccess } else { ReadOnlyTypeAccess }
        ),
        inner.next
      )
    } else { parse_type_postfix(toks, src, pos, tctx) }
  } else {
    if tok_tag(toks, pos) == 5 {
      if tok_v1(toks, pos) == 11 {
        let inner = parse_type_prefix(toks, src, pos + 1, tctx)
        syntax_parse(ComplementTypeExpr(inner.syntax), inner.next)
      } else { parse_type_postfix(toks, src, pos, tctx) }
    } else { parse_type_postfix(toks, src, pos, tctx) }
  }
}

fn parse_named_type_application(base: TypeExpr, args: TypeExprList) -> TypeExpr {
  match base {
    NamedTypeExpr(name, representation, _, origin) ->
      NamedTypeExpr(name, representation, args, origin)
    _ -> base
  }
}

fn parse_type_is_named(ty: TypeExpr) -> bool {
  match ty { NamedTypeExpr(_, _, _, _) -> true, _ -> false }
}

pub(package) fn parse_type_postfix(
  toks: i64,
  src: i64,
  pos: i64,
  tctx: TypeParamList
) -> SyntaxParse<TypeExpr> {
  let parsed = parse_type_atom(toks, src, pos, tctx)
  let mut base = parsed.syntax
  let mut p = parsed.next
  let mut done = 0
  while done == 0 {
    if tok_tag(toks, p) == 5 {
      if tok_v1(toks, p) == 8 and tok_tag(toks, p + 1) == 2 {
        -- Associated-type projection: Self.Item (or T.Item in a generic
        -- signature), or a module-qualified nominal type. Keep the base and
        -- complete span structurally so checking can distinguish a lexical
        -- type parameter from an exact module binding.
        let assoc_start = tok_v1(toks, pos)
        let assoc_end = tok_v1(toks, p + 1) + tok_v2(toks, p + 1)
        let member_hash = effect_name_hash(src, tok_v1(toks, p + 1), tok_v2(toks, p + 1))
        p = p + 2
        if tok_tag(toks, p) == 4 and tok_v1(toks, p) == 7 and parse_type_is_named(base) {
          let args = parse_type_args(toks, src, p + 1, tctx)
          base = SourceAssociatedTypeExpr(
            parse_named_type_application(base, args.syntax),
            member_hash,
            TypeNameRange { start: assoc_start, length: assoc_end - assoc_start }
          )
          p = args.next
        } else {
          base = SourceAssociatedTypeExpr(
            base,
            member_hash,
            TypeNameRange { start: assoc_start, length: assoc_end - assoc_start }
          )
        }
      } else {
        if tok_v1(toks, p) == 12 {
          base = UnionTypeExpr(base, PrimitiveTypeExpr(PRIM_NIL()))
          p = p + 1
        } else { done = 1 }
      }
    } else { done = 1 }
  }
  syntax_parse(base, p)
}

-- set-theoretic surface: skip a balanced punct-delimited region starting at pos (which must be
-- at the opening token). Returns the position after the matching closer, or
-- after EOF. Used by the unsupported-surface fences to recover cleanly.
pub(package) fn parse_skip_balanced(toks: i64, pos: i64, open_v1: i64, close_v1: i64) -> i64 {
  let mut depth = 0
  let mut p = pos
  let mut done = 0
  while done == 0 {
    let tag = tok_tag(toks, p)
    if tag == 7 { done = 1 }
    else {
      if tag == 5 {
        if tok_v1(toks, p) == open_v1 { depth = depth + 1 p = p + 1 }
        else {
          if tok_v1(toks, p) == close_v1 {
            depth = depth - 1
            p = p + 1
            if depth == 0 { done = 1 } else { 0 }
          } else { p = p + 1 }
        }
      } else { p = p + 1 }
    }
  }
  p
}

-- Parse the complete array/slice bracket type surface:
--   [T; N]  fixed array, [T] immutable slice, [mut T] mutable slice.
-- Invalid shapes remain marker atoms so this pure parser family does not
-- acquire Diagnose; the annotation surface walker emits the precise error.
pub(package) fn parse_array_slice_type(
  toks: i64,
  src: i64,
  pos: i64,
  tctx: TypeParamList
) -> SyntaxParse<TypeExpr> {
  let first = pos + 1
  let first_is_close = tok_tag(toks, first) == 5 and tok_v1(toks, first) == 14
  if first_is_close {
    syntax_parse(UnsupportedTypeExpr(5), first + 1)
  } else {
    let is_mut = if tok_tag(toks, first) == 3 {
      if tok_v1(toks, first) == 5 { 1 } else { 0 }
    } else { 0 }
    let inner_pos = if is_mut == 1 { first + 1 } else { first }
    let missing_inner = tok_tag(toks, inner_pos) == 5 and tok_v1(toks, inner_pos) == 14
    if missing_inner {
      syntax_parse(UnsupportedTypeExpr(5), inner_pos + 1)
    } else {
      let parsed = parse_type(toks, src, inner_pos, tctx)
      let inner = parsed.syntax
      let p = parsed.next
      if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 14 {
        syntax_parse(
          SliceTypeExpr(
            inner,
            if is_mut == 1 { MutableTypeAccess } else { ReadOnlyTypeAccess }
          ),
          p + 1
        )
      } else {
        if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 13 {
          if is_mut == 1 {
            syntax_parse(UnsupportedTypeExpr(8), parse_skip_balanced(toks, pos, 17, 14))
          } else {
            let length_pos = p + 1
            if tok_tag(toks, length_pos) != 1 {
              syntax_parse(UnsupportedTypeExpr(6), parse_skip_balanced(toks, pos, 17, 14))
            } else {
              let after_length = length_pos + 1
              if tok_tag(toks, after_length) != 5 or tok_v1(toks, after_length) != 14 {
                syntax_parse(UnsupportedTypeExpr(5), parse_skip_balanced(toks, pos, 17, 14))
              } else {
                let length_start = tok_v1(toks, length_pos)
                let length_len = tok_v2(toks, length_pos)
                if integer_span_le_decimal_max(
                  src,
                  length_start,
                  length_len,
                  "9223372036854775807"
                ) == 0 {
                  syntax_parse(UnsupportedTypeExpr(7), after_length + 1)
                } else {
                  syntax_parse(
                    ArrayTypeExpr(
                      inner,
                      integer_span_value_wrapping(src, length_start, length_len)
                    ),
                    after_length + 1
                  )
                }
              }
            }
          }
        } else {
          syntax_parse(UnsupportedTypeExpr(5), parse_skip_balanced(toks, pos, 17, 14))
        }
      }
    }
  }
}

-- Parse structural record type atoms:
--   {name: str, age: i64}  closed exact shape
--   {name: str, ..}        open required-field predicate
--   {..} / {}              all-record predicate / empty-record singleton
-- The parser stays pure like the rest of the type family. Malformed shapes
-- become a marker atom; duplicate-field and nested surface diagnostics are
-- emitted by the annotation checker from the preserved field spans.
pub(package) fn parse_structural_record_type(
  toks: i64,
  src: i64,
  pos: i64,
  tctx: TypeParamList
) -> SyntaxParse<TypeExpr> {
  let mut fields = TypeExprListNil
  let mut p = pos + 1
  let mut open = 0
  let mut malformed = 0
  let mut done = 0
  while done == 0 {
    if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 4 {
      done = 1
      p = p + 1
    } else {
      if tok_tag(toks, p) == 4 and tok_v1(toks, p) == 20 {
        tok_note_layout_member(toks, p)
        open = 1
        p = p + 1
        if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 5 { p = p + 1 } else { 0 }
        if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 4 { done = 1 p = p + 1 }
        else { malformed = 1 done = 1 p = parse_skip_balanced(toks, pos, 3, 4) }
      } else {
        if tok_tag(toks, p) == 2 {
          tok_note_layout_member(toks, p)
          let name_start = tok_v1(toks, p)
          let name_len = tok_v2(toks, p)
          if tok_tag(toks, p + 1) != 5 or tok_v1(toks, p + 1) != 6 {
            malformed = 1
            done = 1
            p = parse_skip_balanced(toks, pos, 3, 4)
          } else {
            let field = parse_type(toks, src, p + 2, tctx)
            fields = TypeExprListCons(
              RecordFieldTypeExpr(
                effect_name_hash(src, name_start, name_len),
                field.syntax,
                TypeNameRange { start: name_start, length: name_len }
              ),
              fields,
              nil
            )
            p = parse_skip_synthetic_before_close(toks, field.next, 4)
            if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 5 { p = p + 1 }
            else {
              if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 4 { done = 1 p = p + 1 }
              else { malformed = 1 done = 1 p = parse_skip_balanced(toks, pos, 3, 4) }
            }
          }
        } else {
          malformed = 1
          done = 1
          p = parse_skip_balanced(toks, pos, 3, 4)
        }
      }
    }
  }
  if malformed == 1 { syntax_parse(UnsupportedTypeExpr(9), p) }
  else {
    tok_note_layout_group(toks, pos, p - 1)
    syntax_parse(
      RecordTypeExpr(
        parse_type_list_reverse(fields),
        if open == 1 { AdditionalTypeFields } else { ExactTypeFields },
        NamedTypeFields
      ),
      p
    )
  }
}

pub(package) fn parse_type_atom(
  toks: i64,
  src: i64,
  pos: i64,
  tctx: TypeParamList
) -> SyntaxParse<TypeExpr> {
  let tag = tok_tag(toks, pos)
  if tag == 2 {
    let ns = tok_v1(toks, pos)
    let nl = tok_v2(toks, pos)
    if src_eq(src, ns, nl, "rc") == 1 {
      let inner = parse_type_prefix(toks, src, pos + 1, tctx)
      syntax_parse(
        NamedTypeExpr(
          ty_rc_hash(),
          HasTypeRepresentation(inner.syntax),
          TypeExprListNil,
          UnresolvedTypeOrigin
        ),
        inner.next
      )
    } else {
      if src_eq(src, ns, nl, "weak") == 1 {
        let inner = parse_type_prefix(toks, src, pos + 1, tctx)
        syntax_parse(WeakTypeExpr(inner.syntax), inner.next)
      } else {
        if src_eq(src, ns, nl, "arc") == 1 {
          let inner = parse_type_prefix(toks, src, pos + 1, tctx)
          syntax_parse(AtomicTypeExpr(inner.syntax), inner.next)
        } else {
          if src_eq(src, ns, nl, "unique") == 1 {
            let inner = parse_type_prefix(toks, src, pos + 1, tctx)
            syntax_parse(UniqueTypeExpr(inner.syntax), inner.next)
          } else {
            if src_eq(src, ns, nl, "owned") == 1 {
              let inner = parse_type_prefix(toks, src, pos + 1, tctx)
              syntax_parse(OwnedTypeExpr(inner.syntax), inner.next)
            } else {
              if src_eq(src, ns, nl, "borrow") == 1 {
                let mutable = if tok_tag(toks, pos + 1) == 3 and tok_v1(toks, pos + 1) == 5 { 1 } else {
                  0
                }
                let inner_pos = if mutable == 1 { pos + 2 } else { pos + 1 }
                let inner = parse_type_prefix(toks, src, inner_pos, tctx)
                syntax_parse(
                  BorrowTypeExpr(
                    inner.syntax,
                    if mutable == 1 { MutableTypeAccess } else { ReadOnlyTypeAccess }
                  ),
                  inner.next
                )
              } else {
                let base = resolve_type_name(src, ns, nl, tctx)
                -- Check for <type_args> (generic type application)
                if tok_tag(toks, pos + 1) == 4 {
                  if tok_v1(toks, pos + 1) == 7 {
                    let args = parse_type_args(toks, src, pos + 2, tctx)
                    let applied = if src_eq(src, ns, nl, "Continuation") == 1 {
                      if type_expr_list_len(args.syntax) == 2 {
                        ContinuationTypeExpr(
                          type_expr_list_nth(args.syntax, 0),
                          type_expr_list_nth(args.syntax, 1)
                        )
                      } else { AnyTypeExpr }
                    } else {
                      if parse_type_is_named(base) {
                        parse_named_type_application(base, args.syntax)
                      } else { base }
                    }
                    syntax_parse(applied, args.next)
                  } else { syntax_parse(base, pos + 1) }
                } else { syntax_parse(base, pos + 1) }
              }
            }
          }
        }
      }
    }
  } else {
    if tag == 5 {
      if tok_v1(toks, pos) == 1 {
        -- ( ... ) — grouped type or function type params
        parse_type_paren(toks, src, pos, tctx)
      } else {
        if tok_v1(toks, pos) == 3 {
          parse_structural_record_type(toks, src, pos, tctx)
        } else {
          if tok_v1(toks, pos) == 17 {
            parse_array_slice_type(toks, src, pos, tctx)
          } else { syntax_parse(AnyTypeExpr, pos + 1) }
        }
      }
    } else { syntax_parse(AnyTypeExpr, pos + 1) }
  }
}

fn parse_tuple_fields(types: TypeExprList, index: i64) -> TypeExprList {
  match types {
    TypeExprListNil -> TypeExprListNil
    TypeExprListCons(ty, rest, _) -> TypeExprListCons(
      RecordFieldTypeExpr(
        0 - index - 1,
        ty,
        TypeNameRange { start: 0, length: 0 }
      ),
      parse_tuple_fields(rest, index + 1),
      nil
    )
  }
}

-- Parse (type, ...) and check if -> or -[ follows for function type
pub(package) fn parse_type_paren(
  toks: i64,
  src: i64,
  pos: i64,
  tctx: TypeParamList
) -> SyntaxParse<TypeExpr> {
  -- pos is at (. Collect param types.
  let mut reversed = TypeExprListNil
  let mut p = parse_skip_synthetic_semicolons(toks, pos + 1)
  let mut done = 0
  let mut tuple_syntax = 0
  -- Handle empty parens ()
  if tok_tag(toks, p) == 5 {
    if tok_v1(toks, p) == 2 { done = 1 p = p + 1 } else { 0 }
  } else { 0 }
  while done == 0 {
    tok_note_layout_item(toks, p)
    let parameter = parse_type(toks, src, p, tctx)
    reversed = TypeExprListCons(parameter.syntax, reversed, nil)
    p = parse_skip_synthetic_semicolons(toks, parameter.next)
    -- Check for , or )
    if tok_tag(toks, p) == 5 {
      if tok_v1(toks, p) == 2 { done = 1 p = p + 1 }
      else {
        if tok_v1(toks, p) == 5 {
          tuple_syntax = 1
          p = parse_skip_synthetic_semicolons(toks, p + 1)
          if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 2 { done = 1 p = p + 1 } else { 0 }
        }
        else { done = 1 p = p + 1 }
      }
    } else { done = 1 }
  }
  -- p is after ). Check for -> (tag 6) or -[ (tag 11)
  if tok_tag(toks, p - 1) == 5 and tok_v1(toks, p - 1) == 2 {
    tok_note_layout_group(toks, pos, p - 1)
  } else { nil }
  let params = parse_type_list_reverse(reversed)
  if tok_tag(toks, p) == 6 {
    -- Pure function type: (params) -> ret
    tok_note_layout(toks, p + 1, LayoutBreak)
    let result = parse_type(toks, src, p + 1, tctx)
    syntax_parse(
      FunctionTypeExpr(params, result.syntax, EffectSetTypeExpr(TypeExprListNil, 0)),
      result.next
    )
  } else {
    if tok_tag(toks, p) == 11 {
      -- Effectful function type: (params) -[E]> ret
      let effects = parse_effect_list(toks, src, p + 1, tctx)
      let p2 = effects.next
      let p3 = parse_skip_synthetic_semicolons(toks, parse_effect_close_end(toks, p2))
      tok_note_layout(toks, p3, LayoutBreak)
      tok_note_layout(toks, p3, LayoutOptionalSeparator)
      let result = parse_type(toks, src, p3, tctx)
      let effect_type = match effects.syntax {
        EffectSig(atoms, tail) -> EffectSetTypeExpr(atoms, tail)
        MissingEffectSig -> EffectSetTypeExpr(TypeExprListNil, 0)
      }
      syntax_parse(FunctionTypeExpr(params, result.syntax, effect_type), result.next)
    } else {
      -- Not a function type — one item groups; every other arity is a tuple,
      -- represented by the same closed structural-record algebra.
      if type_expr_list_len(params) == 1 and tuple_syntax == 0 {
        syntax_parse(type_expr_list_nth(params, 0), p)
      } else {
        syntax_parse(
          RecordTypeExpr(parse_tuple_fields(params, 0), ExactTypeFields, PositionalTypeFields),
          p
        )
      }
    }
  }
}

fn resolve_primitive_type_expr(src: i64, ns: i64, nl: i64) -> TypeExpr {
  if src_eq(src, ns, nl, "i64") == 1 { PrimitiveTypeExpr(PRIM_I64()) }
  else {
    if src_eq(src, ns, nl, "Int") == 1 { PrimitiveTypeExpr(PRIM_I64()) }
    else {
      if src_eq(src, ns, nl, "i32") == 1 { PrimitiveTypeExpr(PRIM_I32()) }
      else {
        if src_eq(src, ns, nl, "i8") == 1 { PrimitiveTypeExpr(PRIM_I8()) }
        else {
          if src_eq(src, ns, nl, "i16") == 1 { PrimitiveTypeExpr(PRIM_I16()) }
          else {
            if src_eq(src, ns, nl, "u8") == 1 { PrimitiveTypeExpr(PRIM_U8()) }
            else {
              if src_eq(src, ns, nl, "u16") == 1 { PrimitiveTypeExpr(PRIM_U16()) }
              else {
                if src_eq(src, ns, nl, "u32") == 1 { PrimitiveTypeExpr(PRIM_U32()) }
                else {
                  if src_eq(src, ns, nl, "u64") == 1 { PrimitiveTypeExpr(PRIM_U64()) }
                  else {
                    if src_eq(src, ns, nl, "isize") == 1 { PrimitiveTypeExpr(PRIM_ISIZE()) }
                    else {
                      if src_eq(src, ns, nl, "usize") == 1 { PrimitiveTypeExpr(PRIM_USIZE()) }
                      else {
                        if src_eq(src, ns, nl, "f64") == 1 { PrimitiveTypeExpr(PRIM_F64()) }
                        else {
                          if src_eq(src, ns, nl, "f32") == 1 { PrimitiveTypeExpr(PRIM_F32()) }
                          else {
                            if src_eq(src, ns, nl, "Float") == 1 { PrimitiveTypeExpr(PRIM_F64()) }
                            else {
                              if src_eq(src, ns, nl, "str") == 1 { PrimitiveTypeExpr(PRIM_STR()) }
                              else {
                                if src_eq(src, ns, nl, "String") == 1 {
                                  PrimitiveTypeExpr(PRIM_STR())
                                }
                                else {
                                  if src_eq(src, ns, nl, "bool") == 1 {
                                    PrimitiveTypeExpr(PRIM_BOOL())
                                  }
                                  else {
                                    if src_eq(src, ns, nl, "Bool") == 1 {
                                      PrimitiveTypeExpr(PRIM_BOOL())
                                    }
                                    else {
                                      if src_eq(src, ns, nl, "nil") == 1 {
                                        PrimitiveTypeExpr(PRIM_NIL())
                                      }
                                      else {
                                        if src_eq(src, ns, nl, "Nil") == 1 {
                                          PrimitiveTypeExpr(PRIM_NIL())
                                        }
                                        else {
                                          if src_eq(src, ns, nl, "never") == 1 { NeverTypeExpr }
                                          else {
                                            if src_eq(src, ns, nl, "any") == 1 { AnyTypeExpr }
                                            else { MissingTypeExpr }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

pub(package) fn resolve_primitive_type_name(src: i64, ns: i64, nl: i64) -> i64 {
  type_expr_to_node(resolve_primitive_type_expr(src, ns, nl))
}

fn resolve_type_name(src: i64, ns: i64, nl: i64, tctx: TypeParamList) -> TypeExpr {
  let primitive = resolve_primitive_type_expr(src, ns, nl)
  match primitive {
    MissingTypeExpr -> if src_eq(src, ns, nl, "Self") == 1 { VariableTypeExpr(0 - 1) }
    else {
      match resolve_type_var(src, ns, nl, tctx) {
        MissingTypeExpr -> NamedTypeExpr(
          type_name_hash(src, ns, nl),
          HasTypeRepresentation(PrimitiveTypeExpr(PRIM_I64())),
          TypeExprListNil,
          SourceTypeOrigin(TypeNameRange { start: ns, length: nl })
        )
        variable -> variable
      }
    }
    _ -> primitive
  }
}

-- Look up a type variable name in the type parameter scope.
fn resolve_type_var(src: i64, ns: i64, nl: i64, tctx: TypeParamList) -> TypeExpr {
  let identity = find_tparam_id(tctx, src, ns, nl)
  if identity < 0 { MissingTypeExpr } else { VariableTypeExpr(identity) }
}

-- Parse a function declaration
pub(package) fn parse_fn_params(
  toks: i64,
  src: i64,
  pos: i64,
  tctx: TypeParamList
) -[Diagnose]> SyntaxParse<ParamList> {
  parse_fn_params_with_self(toks, src, pos, tctx, MissingTypeExpr)
}

pub(package) fn parse_fn_param_sync(toks: i64, pos: i64) -> i64 {
  let mut p = pos
  let mut done = 0
  while done == 0 {
    let tag = tok_tag(toks, p)
    if tag == 7 or is_decl_start(toks, p) == 1 { done = 1 }
    else {
      if tag == 5 and (tok_v1(toks, p) == 2 or tok_v1(toks, p) == 3) { done = 1 }
      else { p = p + 1 }
    }
  }
  p
}

-- Return the token that must begin a written parameter type, or -1 when the
-- parameter form has no colon. This is parser-owned occurrence evidence: a
-- missing type is diagnosed before the pure type parser can consume `)` or
-- `{` as an `any` placeholder and derail recovery.
pub(package) fn parse_fn_param_written_type_pos(toks: i64, src: i64, pos: i64) -> i64 {
  let positional = tok_tag(toks, pos) == 2 and tok_v2(toks, pos) == 1 and mem_load8_at(
    src,
    tok_v1(toks, pos)
  ) == 95
  if positional and tok_tag(toks, pos + 1) == 2 and tok_tag(toks, pos + 2) == 5 and tok_v1(
    toks,
    pos + 2
  ) == 6 { pos + 3 }
  else {
    if tok_tag(toks, pos) == 2 and tok_tag(toks, pos + 1) == 2 and tok_tag(toks, pos + 2) == 5 and
      tok_v1(toks, pos + 2) == 6 { pos + 3 }
    else {
      if tok_tag(toks, pos) == 2 and tok_tag(toks, pos + 1) == 5 and tok_v1(toks, pos + 1) == 6 {
        pos + 2
      }
      else { 0 - 1 }
    }
  }
}

-- Trait and impl methods give a bare first `self` parameter its contextual
-- receiver type. Other unannotated parameters retain the existing `any`
-- fallback; `self` is the only annotation elision defined by the kernel.
pub(package) fn parse_fn_params_with_self(
  toks: i64,
  src: i64,
  pos: i64,
  tctx: TypeParamList,
  self_ty: TypeExpr
) -[Diagnose]> SyntaxParse<ParamList> {
  -- pos is after (, parse params until ) or EOF or declaration keyword
  let mut reversed = ParamListNil
  let mut count = 0
  let mut p = pos
  let mut done = 0
  let errors_before = tok_parse_error_count(toks)
  while done == 0 {
    let tag = tok_tag(toks, p)
    if tag == 7 { done = 1 }
    else {
      if tag == 5 {
        if tok_v1(toks, p) == 2 { done = 1 }
        else {
          if tok_v1(toks, p) == 3 { done = 1 }
          else {
            parse_syntax_error(
              toks,
              src,
              p,
              "error: expected parameter name or ')'",
              "function parameters",
              "resume_at_parameter_close"
            )
            p = parse_fn_param_sync(toks, p + 1)
            done = 1
          }
        }
      } else {
        if tag == 3 {
          let kw = tok_v1(toks, p)
          -- Stop if we hit a declaration boundary.
          if kw == 1 { done = 1 }
          else {
            if kw == 9 { done = 1 }
            else {
              if kw == 19 { done = 1 }
              else {
                if kw == 26 { done = 1 }
                else {
                  if kw == 27 { done = 1 }
                  else {
                    if kw == 37 { done = 1 }
                    else {
                      -- A keyword in parameter-name position (handle/match/test/...)
                      -- silently derails the parse into an end-of-file mismatch; say
                      -- what actually happened instead.
                      parse_syntax_error(
                        toks,
                        src,
                        p,
                        "error: keyword used as parameter name",
                        "function parameter",
                        "continue_parameters"
                      )
                      p = parse_fn_param_sync(toks, p + 1)
                      done = 1
                    }
                  }
                }
              }
            }
          }
        } else {
          if tag == 2 {
            let type_pos = parse_fn_param_written_type_pos(toks, src, p)
            if type_pos >= 0 and parse_type_starts_at(toks, type_pos) == 0 {
              parse_syntax_error(
                toks,
                src,
                type_pos,
                "error: expected parameter type after ':'",
                "function parameter",
                "resume_at_parameter_close"
              )
              p = parse_fn_param_sync(toks, type_pos)
              done = 1
            } else {
              let param = parse_one_param_with_self(toks, src, p, tctx, self_ty, count)
              reversed = ParamListCons(param.syntax, reversed)
              count = count + 1
              p = param.next
            }
          } else {
            parse_syntax_error(
              toks,
              src,
              p,
              "error: expected parameter name or ')'",
              "function parameters",
              "resume_at_parameter_close"
            )
            p = parse_fn_param_sync(toks, p + 1)
            done = 1
          }
        }
      }
    }
  }
  if tok_tag(toks, p) == 5 {
    if tok_v1(toks, p) == 2 {
      tok_note_layout_group(toks, pos - 1, p)
      tok_note_layout(toks, pos - 1, LayoutParameters)
      syntax_parse(parse_param_list_reverse(reversed), p + 1)
    }
    else {
      if tok_parse_error_count(toks) == errors_before {
        parse_syntax_error(
          toks,
          src,
          p,
          "error: expected ')' after function parameters",
          "function parameters",
          "continue_function"
        )
      } else { 0 }
      syntax_parse(parse_param_list_reverse(reversed), p)
    }
  } else {
    if tok_parse_error_count(toks) == errors_before {
      parse_syntax_error(
        toks,
        src,
        p,
        "error: expected ')' after function parameters",
        "function parameters",
        "resume_at_declaration"
      )
    } else { 0 }
    syntax_parse(parse_param_list_reverse(reversed), p)
  }
}

-- Skip a type annotation without allocating type nodes
pub(package) fn skip_type_annotation(toks: i64, pos: i64) -> i64 {
  -- Skip one type atom (with optional prefix ~ and postfix ?)
  let p = skip_type_atom(toks, pos)
  -- Handle infix | or & by skipping the next type
  if tok_tag(toks, p) == 5 {
    if tok_v1(toks, p) == 9 { skip_type_annotation(toks, p + 1) }
    else {
      if tok_v1(toks, p) == 10 { skip_type_annotation(toks, p + 1) }
      else { p }
    }
  } else { p }
}

pub(package) fn skip_type_atom(toks: i64, pos: i64) -> i64 {
  -- Handle prefix ~
  let p = if tok_tag(toks, pos) == 5 {
    if tok_v1(toks, pos) == 11 { pos + 1 } else { pos }
  } else { pos }
  -- Handle atom: ident or (grouped)
  let p2 = if tok_tag(toks, p) == 5 {
    if tok_v1(toks, p) == 1 { skip_type_parens(toks, p + 1) }
    else { p }
  } else { p + 1 }
  -- Handle postfix ?
  if tok_tag(toks, p2) == 5 {
    if tok_v1(toks, p2) == 12 { p2 + 1 } else { p2 }
  } else { p2 }
}

pub(package) fn skip_type_parens(toks: i64, pos: i64) -> i64 {
  let mut p = pos
  let mut depth = 1
  while depth > 0 {
    if tok_tag(toks, p) == 5 {
      if tok_v1(toks, p) == 1 { depth = depth + 1 p = p + 1 }
      else {
        if tok_v1(toks, p) == 2 { depth = depth - 1 p = p + 1 }
        else { p = p + 1 }
      }
    } else { p = p + 1 }
  }
  p
}

-- Parse one function parameter. Its call-label policy remains a typed part of
-- the syntax rather than leaking the legacy checker encoding into parsing.
pub(package) fn parse_one_param(
  toks: i64,
  src: i64,
  pos: i64,
  tctx: TypeParamList
) -> SyntaxParse<Param> {
  parse_one_param_with_self(toks, src, pos, tctx, MissingTypeExpr, 0)
}

pub(package) fn parse_one_param_with_self(
  toks: i64,
  src: i64,
  pos: i64,
  tctx: TypeParamList,
  self_ty: TypeExpr,
  param_index: i64
) -> SyntaxParse<Param> {
  tok_note_layout_item(toks, pos)
  let t0 = tok_tag(toks, pos)
  let v0 = tok_v1(toks, pos)
  -- Check for _ prefix (positional parameter)
  let is_positional = if t0 == 2 {
    if tok_v2(toks, pos) == 1 {
      if mem_load8_at(src, v0) == 95 { 1 } else { 0 }
    } else { 0 }
  } else { 0 }
  if is_positional == 1 {
    -- _ name: Type — positional parameter
    let name_ns = tok_v1(toks, pos + 1)
    let name_nl = tok_v2(toks, pos + 1)
    if tok_tag(toks, pos + 2) == 5 {
      if tok_v1(toks, pos + 2) == 6 {
        tok_note_layout(toks, pos + 3, LayoutBreak)
        let ty_r = parse_type(toks, src, pos + 3, tctx)
        syntax_parse(
          Param(name_ns, name_nl, ty_r.syntax, PositionalParamLabel),
          skip_comma(toks, ty_r.next)
        )
      } else {
        syntax_parse(
          Param(name_ns, name_nl, MissingTypeExpr, PositionalParamLabel),
          skip_comma(toks, pos + 2)
        )
      }
    } else {
      syntax_parse(
        Param(name_ns, name_nl, MissingTypeExpr, PositionalParamLabel),
        skip_comma(toks, pos + 2)
      )
    }
  } else {
    -- Check for label name: Type pattern (two idents before colon)
    -- Look ahead: is pos+1 also an ident, and pos+2 is colon?
    let has_label = if t0 == 2 {
      if tok_tag(toks, pos + 1) == 2 {
        if tok_tag(toks, pos + 2) == 5 {
          if tok_v1(toks, pos + 2) == 6 { 1 } else { 0 }
        } else { 0 }
      } else { 0 }
    } else { 0 }
    if has_label == 1 {
      -- label name: Type
      let label_ns = tok_v1(toks, pos)
      let label_nl = tok_v2(toks, pos)
      let name_ns = tok_v1(toks, pos + 1)
      let name_nl = tok_v2(toks, pos + 1)
      tok_note_layout(toks, pos + 3, LayoutBreak)
      let ty_r = parse_type(toks, src, pos + 3, tctx)
      syntax_parse(
        Param(name_ns, name_nl, ty_r.syntax, ExplicitParamLabel(label_ns, label_nl)),
        skip_comma(toks, ty_r.next)
      )
    } else {
      -- name: Type — named, label == name (default)
      let ns = tok_v1(toks, pos)
      let nl = tok_v2(toks, pos)
      if tok_tag(toks, pos + 1) == 5 {
        if tok_v1(toks, pos + 1) == 6 {
          tok_note_layout(toks, pos + 2, LayoutBreak)
          let ty_r = parse_type(toks, src, pos + 2, tctx)
          syntax_parse(
            Param(ns, nl, ty_r.syntax, ImplicitParamLabel),
            skip_comma(toks, ty_r.next)
          )
        } else {
          -- A bare receiver is normally followed by a comma. This branch
          -- used to bypass contextual Self and leave `fn f(self, x: Self)`
          -- with an `any` receiver; trait and impl signatures could agree on
          -- the same mistake, hiding it until the body passed self onward.
          let inferred_self = if param_index == 0 and src_eq(src, ns, nl, "self") == 1 {
            self_ty
          } else { MissingTypeExpr }
          syntax_parse(
            Param(ns, nl, inferred_self, ImplicitParamLabel),
            skip_comma(toks, pos + 1)
          )
        }
      } else {
        let inferred_self = if param_index == 0 and src_eq(src, ns, nl, "self") == 1 {
          self_ty
        } else { MissingTypeExpr }
        syntax_parse(
          Param(ns, nl, inferred_self, ImplicitParamLabel),
          skip_comma(toks, pos + 1)
        )
      }
    }
  }
}

-- Parse type parameters: <T, U, V> or <T: Bound, U: Bound & Bound2>
-- Each parameter carries its name, its sequential variable identity and its
-- typed bound list; the result position follows the closing '>'.
pub(package) fn parse_type_params(
  toks: i64,
  src: i64,
  pos: i64
) -[Diagnose]> SyntaxParse<TypeParamList> {
  parse_type_params_from_id(toks, src, pos, 0, TypeParamListNil)
}

pub(package) fn parse_type_params_from_id(
  toks: i64,
  src: i64,
  pos: i64,
  first_var_id: i64,
  outer_tparams: TypeParamList
) -[Diagnose]> SyntaxParse<TypeParamList> {
  let mut reversed = TypeParamListNil
  let mut p = pos
  let mut done = 0
  let mut var_id = first_var_id
  while done == 0 {
    tok_split_type_close_assignment(toks, p)
    let tag = tok_tag(toks, p)
    if tag == 4 and tok_v1(toks, p) == 8 {
      done = 1
      p = p + 1
    } else {
      if tag == 7 or is_decl_start(toks, p) == 1 or (
        tag == 5 and (tok_v1(toks, p) == 1 or tok_v1(toks, p) == 3)
      ) {
        parse_missing_delimiter(
          toks,
          src,
          p,
          pos - 1,
          "error: expected '>' after type parameters",
          ">",
          "type parameter list",
          if tag == 7 { "resume_at_end_of_file" } else {
            if is_decl_start(toks, p) == 1 { "resume_at_declaration" } else {
              "continue_declaration"
            }
          }
        )
        done = 1
      } else {
        if tag == 2 {
          tok_note_layout_item(toks, p)
          let ns = tok_v1(toks, p)
          let nl = tok_v2(toks, p)
          -- Check for : after type param name (bound syntax)
          let has_bound = tok_tag(toks, p + 1) == 5 and tok_v1(toks, p + 1) == 6
          if has_bound and tok_tag(toks, p + 2) != 2 {
            parse_syntax_error(
              toks,
              src,
              p + 2,
              "error: expected trait name after type-parameter ':'",
              "type parameter bound",
              "continue_type_parameters"
            )
          } else { 0 }
          -- Bounds may name the outer parameters and the earlier ones here.
          let bound_context = type_param_list_concat(
            outer_tparams,
            type_param_list_reverse(reversed)
          )
          let bound_r = parse_type_param_bound_with_context(toks, src, p + 1, bound_context)
          reversed = TypeParamListCons(TypeParam(ns, nl, var_id, bound_r.syntax), reversed)
          var_id = var_id + 1
          p = bound_r.next
          tok_split_type_close_assignment(toks, p)
          let dangling_intersection = p > pos and tok_tag(toks, p - 1) == 5 and tok_v1(
            toks,
            p - 1
          ) == 10
          if dangling_intersection {
            parse_syntax_error(
              toks,
              src,
              p,
              "error: expected trait name after '&'",
              "type parameter bound",
              "continue_type_parameters"
            )
          } else { 0 }
          if tok_tag(toks, p) == 5 and (
            tok_v1(toks, p) == 5 or (
              tok_v1(toks, p) == 13 and tok_span(toks, p) == tok_end(toks, p)
            )
          ) {
            p = p + 1
          } else {
            if tok_tag(toks, p) == 4 and tok_v1(toks, p) == 8 { 0 }
            else {
              if tok_tag(toks, p) == 7 or is_decl_start(toks, p) == 1 or (
                tok_tag(toks, p) == 5 and (tok_v1(toks, p) == 1 or tok_v1(toks, p) == 3)
              ) { 0 }
              else {
                parse_syntax_error(
                  toks,
                  src,
                  p,
                  "error: expected ',' or '>' after type parameter",
                  "type parameter list",
                  "continue_type_parameters"
                )
                if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 13 { p = p + 1 } else { 0 }
              }
            }
          }
        } else {
          parse_syntax_error(
            toks,
            src,
            p,
            "error: expected type parameter name or '>'",
            "type parameter list",
            "continue_type_parameters"
          )
          p = p + 1
        }
      }
    }
  }
  let close_pos = p - 1
  if close_pos >= pos and tok_tag(toks, close_pos) == 4 and tok_v1(toks, close_pos) == 8 {
    tok_set_syntax_role(toks, pos - 1, tok_syntax_role_generic_angle())
    tok_set_syntax_role(toks, close_pos, tok_syntax_role_generic_angle())
    tok_note_layout_group(toks, pos - 1, close_pos)
  } else { 0 }
  syntax_parse(type_param_list_reverse(reversed), p)
}

-- Parse one trait bound atom: `Trait` or `module.Trait`. A missing name
-- yields a missing type at the same position; the caller reports it.
pub(package) fn parse_trait_bound_atom(toks: i64, src: i64, pos: i64) -> SyntaxParse<TypeExpr> {
  if tok_tag(toks, pos) != 2 { syntax_parse(MissingTypeExpr, pos) }
  else {
    let ns = tok_v1(toks, pos)
    let nl = tok_v2(toks, pos)
    let qualified = tok_tag(toks, pos + 1) == 5 and tok_v1(toks, pos + 1) == 8 and tok_tag(
      toks,
      pos + 2
    ) == 2
    if qualified {
      syntax_parse(
        QualifiedTraitTypeExpr(
          TypeNameRange { start: ns, length: nl },
          TypeNameRange { start: tok_v1(toks, pos + 2), length: tok_v2(toks, pos + 2) }
        ),
        pos + 3
      )
    } else {
      syntax_parse(
        UnqualifiedTraitTypeExpr(
          effect_name_hash(src, ns, nl),
          TypeNameRange { start: ns, length: nl }
        ),
        pos + 1
      )
    }
  }
}

-- Parse optional bound after type param: `: TraitName` or `: Trait1 & Trait2`
-- Every bound retains its occurrence range. An absent bound is the empty
-- list; a single bound still uses a list.
pub(package) fn parse_type_param_bound(
  toks: i64,
  src: i64,
  pos: i64
) -[Diagnose]> SyntaxParse<TypeParamBoundList> {
  parse_type_param_bound_with_context(toks, src, pos, TypeParamListNil)
}

pub(package) fn parse_type_param_bound_with_context(
  toks: i64,
  src: i64,
  pos: i64,
  tctx: TypeParamList
) -[Diagnose]> SyntaxParse<TypeParamBoundList> {
  -- Check for : (punct tag 5, val 6)
  if tok_tag(toks, pos) == 5 and tok_v1(toks, pos) == 6 {
    tok_note_layout(toks, pos + 1, LayoutBreak)
    let first = parse_trait_bound_atom(toks, src, pos + 1)
    let bounds = TypeParamBoundListCons(
      first.syntax,
      parse_type_range(toks, pos + 1, first.next),
      TypeParamBoundListNil
    )
    let p = first.next
    -- Check for & (multiple bounds)
    let complete = if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 10 {
      parse_more_bounds(toks, src, p + 1, bounds, tctx)
    } else { syntax_parse(bounds, p) }
    syntax_parse(type_param_bound_list_reverse(complete.syntax), complete.next)
  } else { syntax_parse(TypeParamBoundListNil, pos) }
}

-- Parse an associated-type constraint block `{type Item = T, ...}` after a
-- trait bound. Each binding retains its authored name range beside the type.
pub(package) fn parse_trait_assoc_constraints(
  toks: i64,
  src: i64,
  pos: i64,
  tctx: TypeParamList
) -[Diagnose]> SyntaxParse<TypeExprList> {
  let mut reversed = TypeExprListNil
  let mut p = pos + 1
  let mut done = false
  while not done {
    if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 4 {
      done = true
      p = p + 1
    } else {
      if tok_tag(toks, p) != 3 or tok_v1(toks, p) != 9 {
        parse_syntax_error(
          toks,
          src,
          p,
          "error: expected 'type' in associated-type constraint",
          "associated type constraint",
          "continue_type_parameters"
        )
        done = true
        p = parse_skip_balanced(toks, pos, 3, 4)
      } else {
        if tok_tag(toks, p + 1) != 2 {
          parse_syntax_error(
            toks,
            src,
            p + 1,
            "error: expected associated type name after 'type'",
            "associated type constraint",
            "continue_type_parameters"
          )
          done = true
          p = parse_skip_balanced(toks, pos, 3, 4)
        } else {
          if tok_tag(toks, p + 2) != 5 or tok_v1(toks, p + 2) != 7 {
            parse_syntax_error(
              toks,
              src,
              p + 2,
              "error: expected '=' after associated type name",
              "associated type constraint",
              "continue_type_parameters"
            )
            done = true
            p = parse_skip_balanced(toks, pos, 3, 4)
          } else {
            if parse_type_starts_at(toks, p + 3) == 0 {
              parse_syntax_error(
                toks,
                src,
                p + 3,
                "error: expected type after associated-type '='",
                "associated type constraint",
                "continue_type_parameters"
              )
              done = true
              p = parse_skip_balanced(toks, pos, 3, 4)
            } else {
              let binding_r = parse_type(toks, src, p + 3, tctx)
              reversed = TypeExprListCons(
                AssociatedBindingTypeExpr(
                  effect_name_hash(src, tok_v1(toks, p + 1), tok_v2(toks, p + 1)),
                  binding_r.syntax,
                  TypeNameRange { start: tok_v1(toks, p + 1), length: tok_v2(toks, p + 1) }
                ),
                reversed,
                nil
              )
              p = binding_r.next
              if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 5 { p = p + 1 }
              else {
                if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 4 {
                  done = true
                  p = p + 1
                } else {
                  parse_syntax_error(
                    toks,
                    src,
                    p,
                    "error: expected ',' or '}' after associated-type constraint",
                    "associated type constraint",
                    "continue_type_parameters"
                  )
                  done = true
                  p = parse_skip_balanced(toks, pos, 3, 4)
                }
              }
            }
          }
        }
      }
    }
  }
  syntax_parse(parse_type_list_reverse(reversed), p)
}

-- Parse additional trait bounds after '&': Trait2 [& Trait3 ...]. `reversed`
-- holds the bounds parsed so far, most recent first, so an associated-type
-- constraint block attaches to its head.
pub(package) fn parse_more_bounds(
  toks: i64,
  src: i64,
  initial_pos: i64,
  reversed: TypeParamBoundList,
  tctx: TypeParamList
) -[Diagnose]> SyntaxParse<TypeParamBoundList> {
  let pos = parse_skip_synthetic_semicolons(toks, initial_pos)
  tok_note_layout(toks, pos, LayoutBreak)
  tok_note_layout(toks, pos, LayoutOptionalSeparator)
  if tok_tag(toks, pos) == 2 {
    let parsed = parse_trait_bound_atom(toks, src, pos)
    let extended = TypeParamBoundListCons(
      parsed.syntax,
      parse_type_range(toks, pos, parsed.next),
      reversed
    )
    let p = parsed.next
    -- Check for another &
    if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 10 {
      parse_more_bounds(toks, src, p + 1, extended, tctx)
    } else { syntax_parse(extended, p) }
  } else {
    match reversed {
      TypeParamBoundListCons(last, location, rest) -> {
        if tok_tag(toks, pos) == 5 and tok_v1(toks, pos) == 3 {
          let constraint_r = parse_trait_assoc_constraints(toks, src, pos, tctx)
          let constrained = match last {
            ConstraintTypeExpr(_, _) -> {
              parse_syntax_error(
                toks,
                src,
                pos,
                "error: duplicate associated-type constraint block",
                "associated type constraint",
                "continue_type_parameters"
              )
              reversed
            }
            _ -> TypeParamBoundListCons(
              ConstraintTypeExpr(last, constraint_r.syntax),
              location,
              rest
            )
          }
          let p = constraint_r.next
          if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 10 {
            parse_more_bounds(toks, src, p + 1, constrained, tctx)
          } else { syntax_parse(constrained, p) }
        } else { syntax_parse(reversed, pos) }
      }
      TypeParamBoundListNil -> syntax_parse(reversed, pos)
    }
  }
}

fn parse_fn(toks: i64, src: i64, pos: i64) -[Diagnose]> FunctionParse {
  parse_fn_with_context(toks, src, pos, MissingTypeExpr, TypeParamListNil)
}

fn parse_fn_with_context(
  toks: i64,
  src: i64,
  pos: i64,
  self_ty: TypeExpr,
  outer_tparams: TypeParamList
) -[Diagnose]> FunctionParse {
  tok_note_layout(toks, pos - 1, LayoutSignatureStart)
  -- pos is after "fn" keyword
  let name_start = tok_v1(toks, pos)
  let name_len = tok_v2(toks, pos)
  -- Check for <T, U> type parameters after name
  let tparams_r = if tok_tag(toks, pos + 1) == 4 {
    if tok_v1(toks, pos + 1) == 7 {
      parse_type_params_from_id(
        toks,
        src,
        pos + 2,
        type_param_list_len(outer_tparams),
        outer_tparams
      )
    } else { syntax_parse(TypeParamListNil, pos + 1) }
  } else { syntax_parse(TypeParamListNil, pos + 1) }
  let tparams = type_param_list_concat(outer_tparams, tparams_r.syntax)
  let p_tp = tparams_r.next
  -- Check: is next an opening paren?
  let has_paren = if tok_tag(toks, p_tp) == 5 {
    if tok_v1(toks, p_tp) == 1 { 1 } else { 0 }
  } else { 0 }
  if has_paren == 0 {
    -- Malformed: no ( after name. Report error and sync.
    parse_syntax_error(
      toks,
      src,
      p_tp,
      "error: expected '(' after function name",
      "function declaration",
      "resume_at_declaration"
    )
    let sync_p = sync_to_decl(toks, src, p_tp)
    FunctionParse {
      syntax: FunctionSyntax {
        name: TypeNameRange { start: name_start, length: name_len },
        params: ParamListNil,
        result: MissingTypeExpr,
        effects: MissingEffectSig,
        type_params: tparams,
        body: IntLit(0, 0, 0)
      },
      next: sync_p
    }
  } else {
    parse_fn_body_with_self(toks, src, name_start, name_len, p_tp, tparams, self_ty)
  }
}

fn parse_fn_body_with_self(
  toks: i64,
  src: i64,
  ns: i64,
  nl: i64,
  p_tp: i64,
  tparams: TypeParamList,
  self_ty: TypeExpr
) -[Diagnose]> FunctionParse {
  -- The signature's type parameters scope the whole body, so nested
  -- annotations resolve the same type variables.
  handle parse_fn_body_inner_with_self(toks, src, ns, nl, p_tp, tparams, self_ty) {
    TypeParameterScope.current() -> resume(tparams)
  }
}

fn parse_fn_body_inner_with_self(
  toks: i64,
  src: i64,
  ns: i64,
  nl: i64,
  p_tp: i64,
  tparams: TypeParamList,
  self_ty: TypeExpr
) -[Diagnose, TypeParameterScope]> FunctionParse {
  let params = parse_fn_params_with_self(toks, src, p_tp + 1, tparams, self_ty)
  let returns = parse_ret_type(toks, src, params.next, tparams)
  let mut p = returns.next
  let mut signature_tparams = tparams
  -- Check for where clause: `where A: Trait, B: Trait`
  let after_newline = parse_skip_synthetic_semicolons(toks, p)
  if tok_tag(toks, after_newline) == 2 and src_eq(
    src,
    tok_v1(toks, after_newline),
    tok_v2(toks, after_newline),
    "where"
  ) == 1 {
    p = after_newline
    tok_note_layout(toks, p, LayoutBreak)
    tok_note_layout(toks, p, LayoutOptionalSeparator)
  } else { nil }
  if tok_tag(toks, p) == 2 {
    if src_eq(src, tok_v1(toks, p), tok_v2(toks, p), "where") == 1 {
      let where_r = parse_where_clause(toks, src, p + 1, tparams)
      signature_tparams = where_r.syntax
      p = where_r.next
    } else { p = p }
  } else { p = p }
  p = parse_skip_synthetic_before_close(toks, p, 3)
  if tok_tag(toks, p) == 5 {
    if tok_v1(toks, p) == 3 {
      tok_note_layout(toks, p, LayoutSignatureEnd)
      tok_note_layout(toks, p, LayoutDeclarationBody)
      tok_note_layout(toks, p, LayoutBreak)
      tok_note_layout(toks, p, LayoutOptionalSeparator)
      let body_r = parse_block(toks, src, p + 1)
      FunctionParse {
        syntax: FunctionSyntax {
          name: TypeNameRange { start: ns, length: nl },
          params: params.syntax,
          result: returns.syntax.result,
          effects: returns.syntax.effects,
          type_params: signature_tparams,
          body: body_r.syntax
        },
        next: body_r.next
      }
    } else {
      parse_syntax_error(
        toks,
        src,
        p,
        "error: expected '{' in function body",
        "function declaration",
        "resume_at_declaration"
      )
      let sync_p = sync_to_decl(toks, src, p)
      parse_recovered_function(ns, nl, params.syntax, returns.syntax, signature_tparams, sync_p)
    }
  } else {
    parse_syntax_error(
      toks,
      src,
      p,
      "error: expected '{' in function body",
      "function declaration",
      "resume_at_declaration"
    )
    let sync_p = sync_to_decl(toks, src, p)
    parse_recovered_function(ns, nl, params.syntax, returns.syntax, signature_tparams, sync_p)
  }
}

fn parse_recovered_function(
  ns: i64,
  nl: i64,
  params: ParamList,
  returns: FunctionReturnSyntax,
  tparams: TypeParamList,
  next: i64
) -> FunctionParse {
  FunctionParse {
    syntax: FunctionSyntax {
      name: TypeNameRange { start: ns, length: nl },
      params: params,
      result: returns.result,
      effects: returns.effects,
      type_params: tparams,
      body: IntLit(0, 0, 0)
    },
    next: next
  }
}

-- Parse where clause: `where A: Trait1, B: Trait2 & Trait3`
-- Replaces the bounds of each named type parameter. Bound types resolve
-- against the complete signature parameter list.
pub(package) fn parse_where_clause(
  toks: i64,
  src: i64,
  pos: i64,
  tparams: TypeParamList
) -[Diagnose]> SyntaxParse<TypeParamList> {
  match tparams {
    TypeParamListNil -> syntax_parse(tparams, pos)
    _ -> {
      let mut params = tparams
      let mut p = parse_skip_synthetic_semicolons(toks, pos)
      let mut done = 0
      while done == 0 {
        -- Expect: ParamName : Trait [& Trait2] [, ...]
        if tok_tag(toks, p) == 2 {
          tok_note_layout(toks, p, LayoutBreak)
          tok_note_layout(toks, p, LayoutOptionalSeparator)
          let param_ns = tok_v1(toks, p)
          let param_nl = tok_v2(toks, p)
          -- Check for : after param name
          if tok_tag(toks, p + 1) == 5 and tok_v1(toks, p + 1) == 6 {
            let bounds_r = parse_type_param_bound_with_context(toks, src, p + 1, tparams)
            params = type_param_list_with_bounds(params, src, param_ns, param_nl, bounds_r.syntax)
            p = skip_comma(toks, bounds_r.next)
          } else { done = 1 }
        } else { done = 1 }
      }
      syntax_parse(params, p)
    }
  }
}

-- Replace the bounds of the first type parameter with the given name.
fn type_param_list_with_bounds(
  params: TypeParamList,
  src: i64,
  ns: i64,
  nl: i64,
  bounds: TypeParamBoundList
) -> TypeParamList {
  match params {
    TypeParamListNil -> TypeParamListNil
    TypeParamListCons(param, rest) -> match param {
      TypeParam(param_ns, param_nl, var_id, existing) -> {
        if param_nl == nl and src_eq_at(src, ns, src + param_ns, 0, nl) == 1 {
          TypeParamListCons(TypeParam(param_ns, param_nl, var_id, bounds), rest)
        } else {
          TypeParamListCons(param, type_param_list_with_bounds(rest, src, ns, nl, bounds))
        }
      }
      MissingTypeParam -> TypeParamListCons(
        param,
        type_param_list_with_bounds(rest, src, ns, nl, bounds)
      )
    }
  }
}

-- ══════════════════════════════════════════════════════════════
-- String interpolation: literal segments and Display-rendered expressions
-- combine into a concatenation chain.
-- ══════════════════════════════════════════════════════════════
-- Decode one authored literal segment. Backslash escapes keep ordinary string
-- semantics; doubled braces are the explicit interpolation literal escapes.
fn interp_literal_expr(src: i64, start: i64, end: i64) -> Expr {
  let raw_len = end - start
  let buf = alloc_zeroed(raw_len + 1)
  let mut source_index = start
  let mut output_index = 0
  while source_index < end {
    let byte = mem_load8_at(src, source_index)
    if byte == 92 and source_index + 1 < end {
      mem_store8_at(buf, output_index, lex_escape_byte(mem_load8_at(src, source_index + 1)))
      source_index = source_index + 2
      output_index = output_index + 1
    } else if (byte == 123 or byte == 125) and
      source_index + 1 < end and mem_load8_at(src, source_index + 1) == byte {
        mem_store8_at(buf, output_index, byte)
        source_index = source_index + 2
        output_index = output_index + 1
      } else {
        mem_store8_at(buf, output_index, byte)
        source_index = source_index + 1
        output_index = output_index + 1
      }
  }
  StringLit(buf - src, output_index, 0, 0)
}

-- Parse explicit i"..." syntax from its authored content range. The lexer has
-- already proved every single opening brace has a balanced expression and
-- every literal brace is doubled, so parsing consumes the same boundaries.
pub(package) fn parse_explicit_interp_string(
  src: i64,
  start: i64,
  len: i64
) -[Diagnose, TypeParameterScope]> Expr {
  let end = start + len
  let mut result = UnknownExpr(0)
  let mut has_result = false
  let mut segment_start = start
  let mut current = start
  while current < end {
    let byte = mem_load8_at(src, current)
    if byte == 92 {
      current = if current + 1 < end { current + 2 } else { end }
    } else if byte == 123 {
      if current + 1 < end and mem_load8_at(src, current + 1) == 123 {
        current = current + 2
      } else {
        let expression_end = match lex_interpolation_expression_boundary(src, end, current) {
          InterpolationBoundaryClosed(close) -> close
          _ -> end
        }
        let literal = interp_literal_expr(src, segment_start, current)
        let expression = parse_interp_expr(src, current + 1, expression_end - current - 1)
        let pair = InterpConcat(literal, expression)
        result = if has_result { InterpConcat(result, pair) } else { pair }
        has_result = true
        current = expression_end + 1
        segment_start = current
      }
    } else if byte == 125 and current + 1 < end and mem_load8_at(src, current + 1) == 125 {
      current = current + 2
    } else { current = current + 1 }
  }
  let trailing = interp_literal_expr(src, segment_start, end)
  if not has_result { trailing }
  else if segment_start < end { InterpConcat(result, trailing) }
  else { result }
}

pub(package) fn parse_interp_expr(
  src: i64,
  start: i64,
  len: i64
) -[Diagnose, TypeParameterScope]> Expr {
  let inner_toks = lex_range(src, start, len)
  let expression = parse_expr(inner_toks, src, 0, 0)
  let after_expression = expression.next
  let after_separator = if tok_tag(inner_toks, after_expression) == 5 and
    tok_v1(inner_toks, after_expression) == 13 { after_expression + 1 } else { after_expression }
  if tok_tag(inner_toks, after_separator) != 7 {
    parse_syntax_error(
      inner_toks,
      src,
      after_separator,
      "error: interpolation must contain exactly one expression",
      "interpolated string",
      "resume_after_interpolation"
    )
  } else { 0 }
  InterpDisplay(expression.syntax)
}

-- Parse a function's result type and optional effect annotation as one typed
-- signature value. An absent arrow is distinct from an explicitly pure one.
-- A `{` after an arrow is ambiguous with the function body. It starts a
-- structural-record return type only when the next token proves a record
-- shape; otherwise the arrow has no type and the brace remains the body
-- recovery point.
pub(package) fn parse_return_type_starts_at(toks: i64, pos: i64) -> i64 {
  if tok_tag(toks, pos) == 5 and tok_v1(toks, pos) == 3 {
    let next_tag = tok_tag(toks, pos + 1)
    let next_value = tok_v1(toks, pos + 1)
    if next_tag == 5 and next_value == 4 { 1 }
    else {
      if next_tag == 4 and next_value == 20 { 1 }
      else {
        if next_tag == 2 and tok_tag(toks, pos + 2) == 5 and tok_v1(toks, pos + 2) == 6 { 1 }
        else { 0 }
      }
    }
  } else { parse_type_starts_at(toks, pos) }
}

pub(package) fn parse_ret_type(
  toks: i64,
  src: i64,
  pos: i64,
  tctx: TypeParamList
) -[Diagnose]> SyntaxParse<FunctionReturnSyntax> {
  let tag = tok_tag(toks, pos)
  if tag == 6 {
    -- Pure arrow: -> type (explicitly pure = empty effect set)
    tok_note_layout(toks, pos + 1, LayoutBreak)
    if parse_return_type_starts_at(toks, pos + 1) == 0 {
      parse_syntax_error(
        toks,
        src,
        pos + 1,
        "error: expected return type after '->'",
        "function return type",
        "continue_function"
      )
      syntax_parse(
        FunctionReturnSyntax { result: AnyTypeExpr, effects: EffectSig(TypeExprListNil, 0) },
        pos + 1
      )
    } else {
      let ty_r = parse_type(toks, src, pos + 1, tctx)
      syntax_parse(
        FunctionReturnSyntax {
          result: ty_r.syntax,
          effects: EffectSig(TypeExprListNil, 0)
        },
        ty_r.next
      )
    }
  } else {
    if tag == 11 {
      -- Effect arrow: -[effects]> type
      let eff_r = parse_effect_list(toks, src, pos + 1, tctx)
      let p = eff_r.next
      let has_close = tok_tag(toks, p) == 12 or (
        tok_tag(toks, p) == 5 and tok_v1(toks, p) == 14 and tok_tag(toks, p + 1) == 4 and tok_v1(
          toks,
          p + 1
        ) == 8
      )
      if not has_close {
        if tok_tag(toks, p) == 4 and tok_v1(toks, p) == 8 {
          parse_missing_delimiter(
            toks,
            src,
            p,
            pos,
            "error: expected ']' before '>' in effect set",
            "]",
            "effect set",
            "continue_function"
          )
        } else {
          parse_missing_delimiter(
            toks,
            src,
            p,
            pos,
            "error: expected ']>' after effect set",
            "]>",
            "effect set",
            "continue_function"
          )
        }
      } else { 0 }
      let after_close = if has_close { parse_effect_close_end(toks, p) }
      else { if tok_tag(toks, p) == 4 and tok_v1(toks, p) == 8 { p + 1 } else { p } }
      let p2 = if has_close { parse_skip_synthetic_semicolons(toks, after_close) } else {
        after_close
      }
      if has_close {
        tok_note_layout(toks, p2, LayoutBreak)
        tok_note_layout(toks, p2, LayoutOptionalSeparator)
      } else { nil }
      if parse_return_type_starts_at(toks, p2) == 0 {
        if has_close {
          parse_syntax_error(
            toks,
            src,
            p2,
            "error: expected return type after effect set",
            "function return type",
            "continue_function"
          )
        } else { 0 }
        syntax_parse(
          FunctionReturnSyntax { result: AnyTypeExpr, effects: eff_r.syntax },
          p2
        )
      } else {
        let ty_r = parse_type(toks, src, p2, tctx)
        syntax_parse(
          FunctionReturnSyntax { result: ty_r.syntax, effects: eff_r.syntax },
          ty_r.next
        )
      }
    } else {
      syntax_parse(
        FunctionReturnSyntax { result: MissingTypeExpr, effects: MissingEffectSig },
        pos
      )
    }
  }
}

-- Parse comma-separated effect names between -[ and ]>
-- Returns pack(EffectSig_node, pos_at_]>)
-- Parse comma-separated effects between -[ and ]>
-- Supports effect variables: if an identifier matches a type param, it's a tail variable.
-- Returns pack(EffectSig_node, pos_at_]>)
-- Unsupported set-theoretic residue: type arguments on an effect variable (a
-- tparam used as an open tail, e.g. E<T>) remain undesigned and fenced.
-- Concrete effect names now parse their args for real (see
-- parse_effect_list below).
pub(package) fn parse_effect_args_fence(toks: i64, pos: i64) -> SyntaxParse<bool> {
  if tok_tag(toks, pos) == 4 {
    if tok_v1(toks, pos) == 7 {
      let mut p = pos + 1
      let mut done = 0
      while done == 0 {
        let tag = tok_tag(toks, p)
        if tag == 7 { done = 1 }
        else {
          if tag == 12 or (tag == 5 and tok_v1(toks, p) == 14) { done = 1 }
          else {
            if tag == 4 {
              if tok_v1(toks, p) == 8 { p = p + 1 done = 1 } else { p = p + 1 }
            } else { p = p + 1 }
          }
        }
      }
      syntax_parse(true, p)
    } else { syntax_parse(false, pos) }
  } else { syntax_parse(false, pos) }
}

pub(package) fn parse_effect_list(
  toks: i64,
  src: i64,
  pos: i64,
  tctx: TypeParamList
) -> SyntaxParse<EffectSig> {
  let mut reversed = TypeExprListNil
  let mut tail_var = 0
  let mut p = pos
  let mut done = 0
  while done == 0 {
    let tag = tok_tag(toks, p)
    if tag == 12 or (tag == 5 and tok_v1(toks, p) == 14) { done = 1 }
    else {
      if tag == 7 or is_decl_start(toks, p) == 1 or (tag == 5 and tok_v1(toks, p) == 3) or (
        tag == 4 and tok_v1(toks, p) == 8
      ) { done = 1 }
      else {
        if tag == 2 {
          tok_note_layout_item(toks, p)
          let ns = tok_v1(toks, p)
          let nl = tok_v2(toks, p)
          -- Check if this identifier is a type parameter (effect variable)
          let var_id = find_tparam_id(tctx, src, ns, nl)
          if var_id >= 0 {
            -- Effect variable: set as tail
            tail_var = var_id + 1
            let fenced = parse_effect_args_fence(toks, p + 1)
            if fenced.syntax {
              reversed = TypeExprListCons(UnsupportedTypeExpr(4), reversed, nil)
            } else { nil }
            p = skip_comma(toks, fenced.next)
          } else {
            -- Concrete effect name, optionally parameterized (parameterized effects):
            -- State<SymTab> builds an atom carrying its type args.
            let module_qualified = tok_tag(toks, p + 1) == 5 and tok_v1(toks, p + 1) == 8 and
              tok_tag(toks, p + 2) == 2
            let effect_pos = if module_qualified { p + 2 } else { p }
            let effect_ns = tok_v1(toks, effect_pos)
            let effect_nl = tok_v2(toks, effect_pos)
            let hash = effect_name_hash(src, effect_ns, effect_nl)
            let has_args = if tok_tag(toks, effect_pos + 1) == 4 {
              if tok_v1(toks, effect_pos + 1) == 7 { 1 } else { 0 }
            } else { 0 }
            if has_args == 1 {
              let args = parse_type_args(toks, src, effect_pos + 2, tctx)
              reversed = TypeExprListCons(
                if module_qualified {
                  QualifiedEffectTypeExpr(
                    TypeNameRange { start: ns, length: nl },
                    TypeNameRange { start: effect_ns, length: effect_nl },
                    args.syntax
                  )
                } else {
                  UnqualifiedEffectTypeExpr(
                    hash,
                    args.syntax,
                    TypeNameRange { start: effect_ns, length: effect_nl }
                  )
                },
                reversed,
                nil
              )
              p = skip_comma(toks, args.next)
            } else {
              reversed = TypeExprListCons(
                if module_qualified {
                  QualifiedEffectTypeExpr(
                    TypeNameRange { start: ns, length: nl },
                    TypeNameRange { start: effect_ns, length: effect_nl },
                    TypeExprListNil
                  )
                } else {
                  UnqualifiedEffectTypeExpr(
                    hash,
                    TypeExprListNil,
                    TypeNameRange { start: effect_ns, length: effect_nl }
                  )
                },
                reversed,
                nil
              )
              p = skip_comma(toks, effect_pos + 1)
            }
          }
        } else {
          p = p + 1
        }
      }
    }
  }
  if tok_tag(toks, p) == 12 or (tok_tag(toks, p) == 5 and tok_v1(toks, p) == 14) {
    tok_note_layout_group(toks, pos - 1, p)
  } else { nil }
  syntax_parse(EffectSig(parse_type_list_reverse(reversed), tail_var), p)
}

-- Find a type parameter by name: its variable identity, or -1 when absent.
-- Outer parameters precede inner ones, so the first match wins.
pub(package) fn find_tparam_id(tctx: TypeParamList, src: i64, ns: i64, nl: i64) -> i64 {
  match tctx {
    TypeParamListNil -> 0 - 1
    TypeParamListCons(param, rest) -> match param {
      TypeParam(param_ns, param_nl, var_id, bounds) -> {
        if param_nl == nl and src_eq_at(src, ns, src + param_ns, 0, nl) == 1 { var_id } else {
          find_tparam_id(rest, src, ns, nl)
        }
      }
      MissingTypeParam -> find_tparam_id(rest, src, ns, nl)
    }
  }
}

-- Parse trait declaration: trait Name { fn method(self) -> T ... }
-- Associated type references remain authored syntax until host registration.
pub(package) fn parse_trait_member_sync(toks: i64, pos: i64) -> i64 {
  let mut p = pos
  let mut braces = 0
  let mut done = false
  while not done {
    let tag = tok_tag(toks, p)
    let value = tok_v1(toks, p)
    if tag == 7 { done = true }
    else if braces == 0 and (tag == 3 or (tag == 5 and value == 4)) { done = true }
    else {
      if tag == 5 and value == 3 { braces = braces + 1 }
      else if tag == 5 and value == 4 { braces = braces - 1 }
      p = p + 1
    }
  }
  p
}

pub(package) fn parse_trait_decl(toks: i64, src: i64, pos: i64) -[Diagnose]> DeclarationParse {
  -- pos is after "trait" keyword
  let name_ns = tok_v1(toks, pos)
  let name_nl = tok_v2(toks, pos)
  let open_pos = pos + 1
  let has_body = tok_tag(toks, open_pos) == 5 and tok_v1(toks, open_pos) == 3
  if not has_body {
    parse_syntax_error(
      toks,
      src,
      open_pos,
      "error: expected '{' after trait declaration name",
      "trait declaration",
      if is_decl_start(toks, open_pos) == 1 { "resume_at_declaration" } else { "continue_trait" }
    )
  } else { 0 }
  let mut p = if has_body { open_pos + 1 } else { open_pos }
  -- Parse method signatures until }
  let mut methods = TypeTraitMemberListNil
  let errors_before_body = tok_parse_error_count(toks)
  let mut done = if has_body { 0 } else { 1 }
  while done == 0 {
    let tag = tok_tag(toks, p)
    if tag == 5 and tok_v1(toks, p) == 4 { done = 1 }
    else {
      if tag == 7 or (
        tag == 3 and tok_v1(toks, p) != 1 and tok_v1(toks, p) != 9 and tok_v1(toks, p) != 34
      ) {
        if tok_parse_error_count(toks) == errors_before_body {
          parse_missing_delimiter(
            toks,
            src,
            p,
            open_pos,
            "error: expected '}' after trait declaration",
            "}",
            "trait declaration",
            if tag == 7 { "resume_at_end_of_file" } else { "resume_at_declaration" }
          )
        } else { 0 }
        done = 1
      }
      else {
        if tag == 5 and (tok_v1(toks, p) == 5 or tok_v1(toks, p) == 13) { p = p + 1 }
        else {
          let declared = parse_decl_visibility(toks, src, p)
          let member_p = declared.next
          let has_visibility = declared.explicit
          if has_visibility {
            parse_syntax_error(
              toks,
              src,
              p,
              "error: trait members inherit trait visibility",
              "trait declaration",
              "continue_trait"
            )
          } else { 0 }
          if tok_tag(toks, member_p) == 3 and tok_v1(toks, member_p) == 1 {
            if tok_tag(toks, member_p + 1) != 2 {
              parse_syntax_error(
                toks,
                src,
                member_p + 1,
                "error: expected trait method name after 'fn'",
                "trait method declaration",
                "continue_trait"
              )
              p = parse_trait_member_sync(toks, member_p + 2)
            } else {
              if not (tok_tag(toks, member_p + 2) == 5 and tok_v1(toks, member_p + 2) == 1) {
                parse_syntax_error(
                  toks,
                  src,
                  member_p + 2,
                  "error: expected '(' after trait method name",
                  "trait method declaration",
                  "continue_trait"
                )
                p = parse_trait_member_sync(toks, member_p + 2)
              } else {
                -- fn method(self, params...) -> RetType (no body)
                tok_note_layout(toks, member_p, LayoutSignatureStart)
                let m_ns = tok_v1(toks, member_p + 1)
                let m_nl = tok_v2(toks, member_p + 1)
                let errors_before_method = tok_parse_error_count(toks)
                let params = parse_fn_params_with_self(
                  toks,
                  src,
                  member_p + 3,
                  TypeParamListNil,
                  VariableTypeExpr(0 - 1)
                )
                let returns = parse_ret_type(toks, src, params.next, TypeParamListNil)
                let result = match returns.syntax.result {
                  MissingTypeExpr -> {
                    if tok_parse_error_count(toks) == errors_before_method {
                      parse_syntax_error(
                        toks,
                        src,
                        params.next,
                        "error: expected return type after trait method parameters",
                        "trait method declaration",
                        "continue_trait"
                      )
                    } else { 0 }
                    AnyTypeExpr
                  }
                  result -> result
                }
                methods = TypeTraitMemberListCons(
                  TypeTraitMethod(
                    m_ns,
                    m_nl,
                    params.syntax,
                    result,
                    returns.syntax.effects
                  ),
                  methods
                )
                p = returns.next
                tok_note_layout(toks, p, LayoutSignatureEnd)
              }
            }
          } else {
            if tok_tag(toks, member_p) == 3 and tok_v1(toks, member_p) == 9 {
              if tok_tag(toks, member_p + 1) != 2 {
                parse_syntax_error(
                  toks,
                  src,
                  member_p + 1,
                  "error: expected associated type name after 'type'",
                  "associated type declaration",
                  "continue_trait"
                )
                p = parse_trait_member_sync(toks, member_p + 2)
              } else {
                -- type Item[: Bound & ...] — associated type declaration (tag 42)
                let at_ns = tok_v1(toks, member_p + 1)
                let at_nl = tok_v2(toks, member_p + 1)
                let has_bound = tok_tag(toks, member_p + 2) == 5 and tok_v1(toks, member_p + 2) ==
                  6
                if has_bound and tok_tag(toks, member_p + 3) != 2 {
                  parse_syntax_error(
                    toks,
                    src,
                    member_p + 3,
                    "error: expected trait name after associated-type ':'",
                    "associated type bound",
                    "continue_trait"
                  )
                } else { 0 }
                let bounds_r = parse_type_param_bound(toks, src, member_p + 2)
                methods = TypeTraitMemberListCons(
                  TypeTraitAssocType(
                    at_ns,
                    at_nl,
                    bounds_r.syntax
                  ),
                  methods
                )
                p = bounds_r.next
                if p > member_p + 2 and tok_tag(toks, p - 1) == 5 and tok_v1(toks, p - 1) == 10 {
                  parse_syntax_error(
                    toks,
                    src,
                    p,
                    "error: expected trait name after '&'",
                    "associated type bound",
                    "continue_trait"
                  )
                } else { 0 }
              }
            } else {
              parse_syntax_error(
                toks,
                src,
                member_p,
                "error: expected trait member declaration or '}'",
                "trait declaration",
                "continue_trait"
              )
              p = parse_trait_member_sync(toks, member_p + 1)
            }
          }
        }
      }
    }
  }
  if has_body and tok_tag(toks, p) == 5 and tok_v1(toks, p) == 4 {
    tok_note_layout_group(toks, open_pos, p)
  } else { nil }
  DeclarationParse {
    syntax: TraitDefinition(
      TraitSyntax {
        name: TypeNameRange { start: name_ns, length: name_nl },
        members: parse_type_trait_member_list_reverse(methods)
      }
    ),
    next: if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 4 { p + 1 } else { p }
  }
}

-- Parse impl block: impl [TraitName for] TypeName { fn method(self) ... }
-- Retain the target, method syntax, and associated type bindings in source order.
pub(package) fn parse_impl_member_sync(toks: i64, pos: i64) -> i64 {
  parse_trait_member_sync(toks, pos)
}

pub(package) fn parse_impl_decl(toks: i64, src: i64, pos: i64) -[Diagnose]> DeclarationParse {
  -- pos is after "impl" keyword
  -- Check for <T, U> type parameters: impl<T: Bound> ...
  let mut p0 = pos
  let impl_tparams = if tok_tag(toks, p0) == 4 {
    if tok_v1(toks, p0) == 7 {
      let tp_r = parse_type_params(toks, src, p0 + 1)
      p0 = tp_r.next
      tp_r.syntax
    } else { TypeParamListNil }
  } else { TypeParamListNil }
  -- Determine: trait impl or inherent impl. Keep a qualified trait neutral
  -- until the whole module graph exists; module resolution resolves the stored surface fact
  -- to its exact declaration before any conformance consumer runs.
  let qualified_trait = tok_tag(toks, p0) == 2 and tok_tag(toks, p0 + 1) == 5 and tok_v1(
    toks,
    p0 + 1
  ) == 8 and tok_tag(toks, p0 + 2) == 2
  let trait_pos = if qualified_trait { p0 + 2 } else { p0 }
  let first_ns = tok_v1(toks, trait_pos)
  let first_nl = tok_v2(toks, trait_pos)
  let for_pos = trait_pos + 1
  -- Check for "for": either identifier "for" (tag 2) or keyword for (tag 3, kw 29)
  let is_trait_impl = if tok_tag(toks, for_pos) == 2 {
    if src_eq(src, tok_v1(toks, for_pos), tok_v2(toks, for_pos), "for") == 1 { 1 } else { 0 }
  } else {
    if tok_tag(toks, for_pos) == 3 {
      if tok_v1(toks, for_pos) == 29 { 1 } else { 0 }
    } else { 0 }
  }
  let trait_name = TypeNameRange { start: first_ns, length: first_nl }
  let protocol = if is_trait_impl == 1 {
    let trait_hash = effect_name_hash(src, first_ns, first_nl)
    if qualified_trait {
      QualifiedTypeImpl(
        trait_hash,
        TypeNameRange { start: tok_v1(toks, p0), length: tok_v2(toks, p0) },
        trait_name
      )
    } else { UnqualifiedTypeImpl(trait_hash, trait_name) }
  } else { InherentTypeImpl }
  let target_pos = if is_trait_impl == 1 { for_pos + 1 } else { p0 }
  let target_r = parse_type(toks, src, target_pos, impl_tparams)
  -- An ownership-qualified protocol target is catalogued under its inner
  -- nominal head while retaining the complete qualified type in the target.
  -- This keeps package/orphan lookup name-based without erasing conformance.
  let ownership_qualified = match target_r.syntax {
    UniqueTypeExpr(_) -> true
    OwnedTypeExpr(_) -> true
    _ -> false
  }
  let target_name_pos = if ownership_qualified { target_pos + 1 } else { target_pos }
  let type_ns = tok_v1(toks, target_name_pos)
  let type_nl = tok_v2(toks, target_name_pos)
  -- Continue at the opening brace after the complete target type.
  let mut p = target_r.next
  let open_pos = p
  let has_body = tok_tag(toks, open_pos) == 5 and tok_v1(toks, open_pos) == 3
  if not has_body {
    parse_syntax_error(
      toks,
      src,
      open_pos,
      "error: expected '{' after impl target type",
      "impl declaration",
      if is_decl_start(toks, open_pos) == 1 { "resume_at_declaration" } else { "continue_impl" }
    )
  } else { 0 }
  if has_body { p = p + 1 } else { p = p }
  -- Parse method implementations until }
  let mut methods: List<ImplMemberSyntax> = Nil
  let errors_before_body = tok_parse_error_count(toks)
  let mut done = if has_body { 0 } else { 1 }
  while done == 0 {
    let tag = tok_tag(toks, p)
    if tag == 5 and tok_v1(toks, p) == 4 { done = 1 }
    else {
      if tag == 7 or (
        tag == 3 and tok_v1(toks, p) != 1 and tok_v1(toks, p) != 9 and tok_v1(toks, p) != 34
      ) {
        if tok_parse_error_count(toks) == errors_before_body {
          parse_missing_delimiter(
            toks,
            src,
            p,
            open_pos,
            "error: expected '}' after impl declaration",
            "}",
            "impl declaration",
            if tag == 7 { "resume_at_end_of_file" } else { "resume_at_declaration" }
          )
        } else { 0 }
        done = 1
      } else {
        if tag == 5 and (tok_v1(toks, p) == 5 or tok_v1(toks, p) == 13) { p = p + 1 }
        else {
          let declared = parse_decl_visibility(toks, src, p)
          let member_p = declared.next
          let has_visibility = declared.explicit
          if tok_tag(toks, member_p) == 3 and tok_v1(toks, member_p) == 9 {
            -- type Item = ConcreteType — associated type binding (tag 43)
            if has_visibility {
              parse_syntax_error(
                toks,
                src,
                p,
                "error: associated type bindings cannot have visibility",
                "impl declaration",
                "continue_impl"
              )
            } else { 0 }
            if tok_tag(toks, member_p + 1) != 2 {
              parse_syntax_error(
                toks,
                src,
                member_p + 1,
                "error: expected associated type name after 'type'",
                "associated type binding",
                "continue_impl"
              )
              p = parse_impl_member_sync(toks, member_p + 2)
            } else {
              if not (tok_tag(toks, member_p + 2) == 5 and tok_v1(toks, member_p + 2) == 7) {
                parse_syntax_error(
                  toks,
                  src,
                  member_p + 2,
                  "error: expected '=' after associated type name",
                  "associated type binding",
                  "continue_impl"
                )
                p = parse_impl_member_sync(toks, member_p + 2)
              } else {
                if parse_type_starts_at(toks, member_p + 3) == 0 {
                  parse_syntax_error(
                    toks,
                    src,
                    member_p + 3,
                    "error: expected type after associated-type '='",
                    "associated type binding",
                    "continue_impl"
                  )
                  p = parse_impl_member_sync(toks, member_p + 3)
                } else {
                  let at_ns = tok_v1(toks, member_p + 1)
                  let at_nl = tok_v2(toks, member_p + 1)
                  let at_p = member_p + 3
                  let at_ty_r = parse_type(toks, src, at_p, impl_tparams)
                  let location = parse_type_range(toks, at_p, at_ty_r.next)
                  methods = Cons(
                    ImplTypeBinding(
                      TypeNameRange { start: at_ns, length: at_nl },
                      at_ty_r.syntax,
                      location
                    ),
                    methods
                  )
                  p = at_ty_r.next
                }
              }
            }
          } else {
            if tok_tag(toks, member_p) == 3 and tok_v1(toks, member_p) == 1 {
              -- fn method(self, ...) -> T { body }
              if is_trait_impl == 1 and has_visibility {
                parse_syntax_error(
                  toks,
                  src,
                  p,
                  "error: trait impl methods inherit trait visibility",
                  "impl declaration",
                  "continue_impl"
                )
              } else { 0 }
              if tok_tag(toks, member_p + 1) != 2 {
                parse_syntax_error(
                  toks,
                  src,
                  member_p + 1,
                  "error: expected method name after 'fn'",
                  "impl method declaration",
                  "continue_impl"
                )
                p = parse_impl_member_sync(toks, member_p + 2)
              } else {
                let parsed = parse_fn_with_context(
                  toks,
                  src,
                  member_p + 1,
                  VariableTypeExpr(0 - 1),
                  impl_tparams
                )
                methods = Cons(
                  ImplMethod(parsed.syntax, declared.visibility),
                  methods
                )
                p = parsed.next
              }
            } else {
              parse_syntax_error(
                toks,
                src,
                member_p,
                "error: expected method, associated type, or '}' in impl",
                "impl declaration",
                "continue_impl"
              )
              p = parse_impl_member_sync(toks, member_p + 1)
            }
          }
        }
      }
    }
  }
  if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 4 {
    tok_note_layout_group(toks, open_pos, p)
  } else { nil }
  DeclarationParse {
    syntax: ImplDefinition(
      ImplSyntax {
        name: TypeNameRange { start: type_ns, length: type_nl },
        type_params: impl_tparams,
        target: TypeImplTarget { target: target_r.syntax, protocol: protocol },
        members: methods.reverse()
      }
    ),
    next: if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 4 { p + 1 } else { p }
  }
}

-- Parse: test "name" { body }
-- Tests are source declarations, not callable checker nodes. Only the test
-- preparation interpretation turns their bodies into wrapper functions.
fn parse_test_syntax(
  toks: i64,
  src: i64,
  pos: i64
) -[Diagnose, TypeParameterScope]> DeclarationParse {
  -- pos is after "test" keyword, expect string literal
  if tok_tag(toks, pos) != 8 {
    parse_syntax_error(
      toks,
      src,
      pos,
      "error: expected string name after 'test'",
      "test declaration",
      "resume_at_declaration"
    )
    DeclarationParse { syntax: InvalidDefinition, next: sync_to_decl(toks, src, pos + 1) }
  } else {
    let name_ns = tok_v1(toks, pos)
    let name_nl = tok_v2(toks, pos)
    -- skip name string, expect {
    let p = pos + 1
    if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 3 {
      let body_r = parse_block(toks, src, p + 1)
      DeclarationParse {
        syntax: TestDefinition(
          TestSyntax {
            name: runtime_str_from_bytes_copy(src + name_ns, name_nl),
            name_range: TypeNameRange {
              start: tok_span(toks, pos),
              length: tok_end(toks, pos) - tok_span(toks, pos)
            },
            body: body_r.syntax
          }
        ),
        next: body_r.next
      }
    } else {
      parse_syntax_error(
        toks,
        src,
        p,
        "error: expected '{' after test name",
        "test declaration",
        "resume_at_declaration"
      )
      DeclarationParse { syntax: InvalidDefinition, next: sync_to_decl(toks, src, p) }
    }
  }
}

-- An optional declaration visibility prefix: the visibility it names, the
-- token position where the declaration itself begins, and whether a prefix
-- was authored. A malformed prefix still counts as authored.
type VisibilityParse {
  visibility: DeclVisibility,
  next: i64,
  explicit: bool
}

fn parse_decl_visibility(toks: i64, src: i64, pos: i64) -[Diagnose]> VisibilityParse {
  tok_note_layout_member(toks, pos)
  if tok_tag(toks, pos) == 3 and tok_v1(toks, pos) == 34 {
    if tok_tag(toks, pos + 1) == 5 and tok_v1(toks, pos + 1) == 1 {
      if tok_tag(toks, pos + 2) == 3 and tok_v1(toks, pos + 2) == 36 and tok_tag(toks, pos + 3) ==
        5 and tok_v1(toks, pos + 3) == 2 {
          tok_set_syntax_role(toks, pos + 1, tok_syntax_role_visibility_qualifier())
          VisibilityParse { visibility: PackageVisibility, next: pos + 4, explicit: true }
        } else {
          parse_syntax_error(
            toks,
            src,
            pos,
            "error: expected 'pub(package)'",
            "declaration visibility",
            "continue_declaration"
          )
          VisibilityParse {
            visibility: PublicVisibility,
            next: sync_to_decl(toks, src, pos + 1),
            explicit: true
          }
        }
    } else {
      VisibilityParse { visibility: PublicVisibility, next: pos + 1, explicit: true }
    }
  } else {
    VisibilityParse { visibility: PrivateVisibility, next: pos, explicit: false }
  }
}

-- Parse an immutable module constant:
--   const NAME: Type = compile_time_expression
-- The declaration fact owns the annotation and initializer. Constants never
-- enter the function-pair list and therefore cannot acquire runtime storage
-- or module-initialization order through this parser path.
pub(package) fn parse_const_decl(
  toks: i64,
  src: i64,
  pos: i64
) -[Diagnose, TypeParameterScope]> DeclarationParse {
  let colon_pos = pos + 1
  if tok_tag(toks, colon_pos) != 5 or tok_v1(toks, colon_pos) != 6 {
    parse_syntax_error(
      toks,
      src,
      colon_pos,
      "error: expected ':' and an explicit type after constant name",
      "constant declaration",
      "resume_at_declaration"
    )
    DeclarationParse { syntax: InvalidDefinition, next: sync_to_decl(toks, src, colon_pos) }
  } else {
    if parse_type_starts_at(toks, colon_pos + 1) == 0 {
      parse_syntax_error(
        toks,
        src,
        colon_pos + 1,
        "error: expected constant type after ':'",
        "constant declaration",
        "resume_at_declaration"
      )
      DeclarationParse { syntax: InvalidDefinition, next: sync_to_decl(toks, src, colon_pos + 1) }
    } else {
      let ty_r = parse_type(toks, src, colon_pos + 1, TypeParamListNil)
      let declared_ty = ty_r.syntax
      let equals_pos = ty_r.next
      if tok_tag(toks, equals_pos) != 5 or tok_v1(toks, equals_pos) != 7 {
        parse_syntax_error(
          toks,
          src,
          equals_pos,
          "error: expected '=' after constant type",
          "constant declaration",
          "resume_at_declaration"
        )
        DeclarationParse { syntax: InvalidDefinition, next: sync_to_decl(toks, src, equals_pos) }
      } else {
        if parse_expr_starts_at(toks, equals_pos + 1) == 0 {
          parse_syntax_error(
            toks,
            src,
            equals_pos + 1,
            "error: expected compile-time expression after '='",
            "constant declaration",
            "resume_at_declaration"
          )
          DeclarationParse {
            syntax: InvalidDefinition,
            next: sync_to_decl(toks, src, equals_pos + 1)
          }
        } else {
          let expr_r = parse_expr(toks, src, equals_pos + 1, 0)
          DeclarationParse {
            syntax: ConstantDefinition(
              ConstantSyntax {
                name: TypeNameRange { start: tok_v1(toks, pos), length: tok_v2(toks, pos) },
                declared_type: declared_ty,
                initializer: expr_r.syntax
              }
            ),
            next: expr_r.next
          }
        }
      }
    }
  }
}

pub(package) fn parse_first_source_error(toks: i64) -> i64 {
  let mut i = 0
  let mut found = 0 - 1
  while i < tok_count(toks) and found < 0 {
    if tok_tag(toks, i) == 14 { found = i } else { i = i + 1 }
  }
  found
}

fn parse_numeric_source_error(toks: i64, src: i64, pos: i64) -[Diagnose]> i64 {
  let start = tok_span(toks, pos)
  let len = tok_v2(toks, pos)
  let position = if tok_v1(toks, pos) == 8 { TuplePositionNumber } else { ExpressionNumber }
  match numeric_scan(compiler_source_fragment(src, start, len), 0, position) {
    InvalidNumericSpelling(_, issue) -> {
      let (offset, message, reason) = match issue {
        MissingNumericDigits(at) -> (
          at,
          "numeric literal requires digits",
          "numeric_missing_digits"
        )
        InvalidNumericDigit(at) -> (
          at,
          "digit is not valid in this numeric literal",
          "numeric_invalid_digit"
        )
        InvalidNumericSeparator(at) -> (
          at,
          "digit separators must occur singly between digits",
          "numeric_invalid_separator"
        )
      }
      let local = compiler_signed_count(offset)
      parse_report_error(
        src,
        start + local,
        start + local + if local < len { 1 } else { 0 },
        message,
        registry.syntax_error(),
        reason,
        "numeric literal",
        parse_token_text(toks, src, pos),
        "stop_invalid_source"
      )
    }
    _ -> parse_syntax_error(
      toks,
      src,
      pos,
      "error: invalid numeric literal",
      "numeric literal",
      "stop_invalid_source"
    )
  }
}

pub(package) fn parse_source_error(toks: i64, src: i64, pos: i64) -[Diagnose]> i64 {
  let kind = tok_v1(toks, pos)
  if kind == 7 or kind == 8 { parse_numeric_source_error(toks, src, pos) }
  else {
    let message = if kind == 1 { "source is not valid UTF-8" }
    else if kind == 2 { "identifier must use NFC normalization" }
    else if kind == 3 { "default-ignorable code point is not permitted in an identifier" }
    else if kind == 4 { "Unicode scalar is not permitted at this identifier position" }
    else if kind == 5 { "character is not valid Weft syntax" }
    else if kind == 9 { "interpolation expression is not terminated before end of string" }
    else if kind == 10 {
      "single '}' is not valid in an interpolated string; write '}}' for a literal brace"
    }
    else if kind == 11 {
      "backslash does not escape interpolation braces; write doubled braces instead"
    }
    else { "string literal is not terminated before end of file" }
    let start = tok_span(toks, pos)
    Diagnose.report(
      Diagnostic(
        DiagnosticSeverityError,
        DiagnosticClassParse,
        registry.invalid_source(),
        message,
        diagnostic_location_from_offsets(
          DiagnosticSourceBuffer(src),
          start,
          start + tok_v2(toks, pos)
        ),
        DiagnosticRelatedLocationNil,
        DiagnosticFieldCons(
          DiagnosticFieldText(
            "reason",
            if kind == 1 { "invalid_utf8" }
    else if kind == 2 { "identifier_not_nfc" }
    else if kind == 3 { "identifier_default_ignorable" }
    else if kind == 4 { "identifier_scalar_profile" }
    else if kind == 5 { "invalid_character" }
    else if kind == 9 { "unterminated_interpolation" }
    else if kind == 10 { "unmatched_interpolation_close" }
    else if kind == 11 { "invalid_interpolation_brace_escape" }
    else { "unterminated_string" }
          ),
          DiagnosticFieldCons(
            DiagnosticFieldI64("invalid_byte_length", tok_v2(toks, pos)),
            DiagnosticFieldNil
          )
        )
      )
    )
  }
}

pub(package) fn parse_identifier_spelling_eq(toks: i64, src: i64, a: i64, b: i64) -> i64 {
  let a_len = tok_v2(toks, a)
  let b_len = tok_v2(toks, b)
  if a_len != b_len { 0 }
  else { src_eq_at(src, tok_v1(toks, a), src + tok_v1(toks, b), 0, a_len) }
}

-- Security warnings are spelling facts, so repeated uses of one identifier do
-- not produce repeated diagnostics. Identity remains the exact NFC bytes.
pub(package) fn parse_identifier_spelling_seen(toks: i64, src: i64, pos: i64) -> i64 {
  let mut i = 0
  let mut seen = 0
  while i < pos and seen == 0 {
    if tok_tag(toks, i) == 2 and parse_identifier_spelling_eq(toks, src, i, pos) == 1 { seen = 1 }
    else { i = i + 1 }
  }
  seen
}

pub(package) fn parse_identifier_confusable_peer(toks: i64, src: i64, pos: i64) -> i64 {
  let skeleton = unicode_security_skeleton_bytes(src, tok_v1(toks, pos), tok_v2(toks, pos))
  let mut i = 0
  let mut peer = 0 - 1
  while i < tok_count(toks) and peer < 0 {
    if tok_tag(toks, i) == 2 and parse_identifier_spelling_eq(toks, src, i, pos) == 0 {
      let candidate = unicode_security_skeleton_bytes(src, tok_v1(toks, i), tok_v2(toks, i))
      if runtime_str_eq(skeleton, candidate) == 1 { peer = i } else { i = i + 1 }
    } else { i = i + 1 }
  }
  peer
}

pub(package) fn parse_warn_identifier_mixed_script(toks: i64, src: i64, pos: i64) -[Diagnose]> i64
{
  let start = tok_span(toks, pos)
  Diagnose.report(
    Diagnostic(
      DiagnosticSeverityWarning,
      DiagnosticClassParse,
      registry.identifier_mixed_script(),
      "identifier contains mixed scripts",
      diagnostic_location_from_offsets(DiagnosticSourceBuffer(src), start, tok_end(toks, pos)),
      DiagnosticRelatedLocationNil,
      DiagnosticFieldNil
    )
  )
}

pub(package) fn parse_warn_identifier_confusable(
  toks: i64,
  src: i64,
  pos: i64,
  peer: i64
) -[Diagnose]> i64 {
  let start = tok_span(toks, pos)
  let peer_start = tok_span(toks, peer)
  Diagnose.report(
    Diagnostic(
      DiagnosticSeverityWarning,
      DiagnosticClassParse,
      registry.identifier_confusable(),
      "identifier is confusable with another spelling in this source",
      diagnostic_location_from_offsets(DiagnosticSourceBuffer(src), start, tok_end(toks, pos)),
      DiagnosticRelatedLocationCons(
        DiagnosticRelatedLocation(
          "confusable spelling appears here",
          diagnostic_location_from_offsets(
            DiagnosticSourceBuffer(src),
            peer_start,
            tok_end(toks, peer)
          )
        ),
        DiagnosticRelatedLocationNil
      ),
      DiagnosticFieldCons(
        DiagnosticFieldLocation(
          "confusable_with",
          diagnostic_location_from_offsets(
            DiagnosticSourceBuffer(src),
            peer_start,
            tok_end(toks, peer)
          )
        ),
        DiagnosticFieldNil
      )
    )
  )
}

pub(package) fn parse_diagnose_identifier_security(toks: i64, src: i64) -[Diagnose]> i64 {
  let mut i = 0
  while i < tok_count(toks) {
    if tok_tag(toks, i) == 2 and lex_span_has_non_ascii(src, tok_v1(toks, i), tok_v2(toks, i)) ==
      1 and parse_identifier_spelling_seen(toks, src, i) == 0 {
        if unicode_security_is_mixed_script_bytes(src, tok_v1(toks, i), tok_v2(toks, i)) == 1 {
          parse_warn_identifier_mixed_script(toks, src, i)
        } else { 0 }
        let peer = parse_identifier_confusable_peer(toks, src, i)
        if peer >= 0 { parse_warn_identifier_confusable(toks, src, i, peer) } else { 0 }
      } else { 0 }
    i = i + 1
  }
  0
}

pub(package) fn parse_warn_bidi_formatting(
  src: i64,
  start: i64,
  end: i64,
  context: str
) -[Diagnose]> i64 {
  Diagnose.report(
    Diagnostic(
      DiagnosticSeverityWarning,
      DiagnosticClassParse,
      registry.source_bidi_formatting(),
      "source text contains an invisible bidi formatting control",
      diagnostic_location_from_offsets(DiagnosticSourceBuffer(src), start, end),
      DiagnosticRelatedLocationNil,
      DiagnosticFieldCons(DiagnosticFieldText("context", context), DiagnosticFieldNil)
    )
  )
}

pub(package) fn parse_diagnose_bidi_range(
  src: i64,
  start: i64,
  end: i64,
  context: str
) -[Diagnose]> i64 {
  let mut pos = start
  while pos < end {
    let width = source_position_utf8_width(src + pos, end - pos, 0)
    let scalar = source_position_utf8_scalar(src + pos, end - pos, 0)
    if width > 0 {
      if unicode_security_is_directional_formatting(scalar) == 1 {
        parse_warn_bidi_formatting(src, pos, pos + width, context)
      } else { 0 }
      pos = pos + width
    } else { pos = end }
  }
  0
}

pub(package) fn parse_diagnose_bidi_comments(src: i64, start: i64, end: i64) -[Diagnose]> i64 {
  let mut pos = start
  while pos + 1 < end {
    if mem_load8_at(src, pos) == 45 and mem_load8_at(src, pos + 1) == 45 {
      let mut comment_end = pos + 2
      while comment_end < end and mem_load8_at(src, comment_end) != 10 and mem_load8_at(
        src,
        comment_end
      ) != 13 {
        comment_end = comment_end + 1
      }
      parse_diagnose_bidi_range(src, pos + 2, comment_end, "comment")
      pos = comment_end
    } else { pos = pos + 1 }
  }
  0
}

pub(package) fn parse_diagnose_bidi_source(toks: i64, src: i64) -[Diagnose]> i64 {
  let mut previous_end = tok_source_start(toks)
  let mut i = 0
  while i < tok_count(toks) {
    let start = tok_span(toks, i)
    let end = tok_end(toks, i)
    if start > previous_end { parse_diagnose_bidi_comments(src, previous_end, start) } else { 0 }
    if tok_tag(toks, i) == 8 and end > start + 1 {
      parse_diagnose_bidi_range(src, start + 1, end - 1, "string")
    } else if tok_tag(toks, i) == 15 and end > start + 2 {
      parse_diagnose_bidi_range(src, start + 2, end - 1, "string")
    } else { 0 }
    if end > previous_end { previous_end = end } else { 0 }
    i = i + 1
  }
  0
}

-- Parse only declarations owned by this source. Imports are parsed as syntax
-- (and therefore retain exact recovery diagnostics) but their module graphs
-- are not resolved or loaded. Test preparation uses this boundary to inspect
-- the original root without recursively ingesting every dependency twice.
pub(package) fn parse_module_syntax_local(toks: i64, src: i64) -[Diagnose]> ParsedModuleSyntax {
  let invalid = parse_first_source_error(toks)
  if invalid >= 0 {
    parse_source_error(toks, src, invalid)
    ParsedModuleSyntax {
      imports: Nil<ImportDeclaration>(),
      declarations: Nil<SourceDeclaration>()
    }
  } else {
    handle parse_module_contents(toks, src) {
      TypeParameterScope.current() -> resume(TypeParamListNil)
    }
  }
}

-- Parse the exact effect reference in an `implements` header. The shape is
-- identical to the effect reference stored by an explicit handler clause, so
-- checking and lowering consume one semantic representation.
pub(package) fn parse_handler_implementation_effect_ref(
  toks: i64,
  src: i64,
  pos: i64,
  tctx: TypeParamList
) -[Diagnose]> SyntaxParse<Expr> {
  if tok_tag(toks, pos) != 2 {
    parse_syntax_error(
      toks,
      src,
      pos,
      "error: expected effect after 'implements'",
      "handler implementation",
      "resume_at_declaration"
    )
    syntax_parse(Ident(tok_span(toks, pos), 0), pos)
  } else {
    let module_shaped = tok_tag(toks, pos + 1) == 5 and tok_v1(toks, pos + 1) == 8 and tok_tag(
      toks,
      pos + 2
    ) == 2
    let eff_pos = if module_shaped { pos + 2 } else { pos }
    let bare = if module_shaped {
      FieldAccess(
        Ident(tok_v1(toks, pos), tok_v2(toks, pos)),
        tok_v1(toks, eff_pos),
        tok_v2(toks, eff_pos),
        UnknownFieldAccessFact
      )
    } else {
      Ident(tok_v1(toks, eff_pos), tok_v2(toks, eff_pos))
    }
    let after_name = eff_pos + 1
    if tok_tag(toks, after_name) == 4 and tok_v1(toks, after_name) == 7 {
      let types = parse_type_args(toks, src, after_name + 1, tctx)
      if module_shaped {
        syntax_parse(
          FieldAccess(
            Ident(tok_v1(toks, pos), tok_v2(toks, pos)),
            tok_v1(toks, eff_pos),
            tok_v2(toks, eff_pos),
            ResolvedEffectAccessFact(0, types.syntax)
          ),
          types.next
        )
      } else {
        syntax_parse(GenericCall(types.syntax, bare), types.next)
      }
    } else {
      syntax_parse(bare, after_name)
    }
  }
}

-- Module handlers retain their authored effect reference, constructor
-- parameters, and clauses as typed syntax. Registration derives the legacy
-- checker fact without mutating the shared parse product.
fn parse_handler_implementation_syntax(
  toks: i64,
  src: i64,
  pos: i64
) -[Diagnose]> DeclarationParse {
  let tparams_r = if tok_tag(toks, pos) == 4 and tok_v1(toks, pos) == 7 {
    parse_type_params(toks, src, pos + 1)
  } else { syntax_parse(TypeParamListNil, pos) }
  let tparams = tparams_r.syntax
  let effect_ref = parse_handler_implementation_effect_ref(toks, src, tparams_r.next, tparams)
  let p_open = effect_ref.next
  let has_params = tok_tag(toks, p_open) == 5 and tok_v1(toks, p_open) == 1
  if has_params == 0 {
    parse_syntax_error(
      toks,
      src,
      p_open,
      "error: expected constructor parameter list after implemented effect",
      "handler implementation",
      "resume_at_declaration"
    )
  } else { 0 }
  let params = if has_params == 1 {
    parse_fn_params(toks, src, p_open + 1, tparams)
  } else { syntax_parse(ParamListNil, p_open) }
  let after_params = params.next
  let has_body = tok_tag(toks, after_params) == 5 and tok_v1(toks, after_params) == 3
  if has_body == 0 {
    parse_syntax_error(
      toks,
      src,
      after_params,
      "error: expected '{' after handler implementation header",
      "handler implementation",
      "resume_at_declaration"
    )
  } else { 0 }
  let parsed_clauses = if has_body == 1 {
    handle parse_handle_clauses(
      toks,
      src,
      after_params + 1,
      after_params,
      tok_parse_error_count(toks)
    ) {
      TypeParameterScope.current() -> resume(tparams)
    }
  } else {
    HandlerClausesParse {
      clauses: HandlerClauseListNil,
      completion: NoHandleReturn,
      return_count: 0,
      next: sync_to_decl(toks, src, after_params)
    }
  }
  if parsed_clauses.return_count != 0 {
    parse_syntax_error(
      toks,
      src,
      after_params,
      "error: module handler implementations cannot transform normal return",
      "handler implementation",
      "continue_declaration"
    )
  } else { 0 }
  let keyword_pos = if pos > 0 { pos - 1 } else { pos }
  DeclarationParse {
    syntax: HandlerDefinition(
      ModuleHandlerSyntax {
        effect_reference: effect_ref.syntax,
        params: params.syntax,
        clauses: parsed_clauses.clauses,
        type_params: tparams,
        keyword: TypeNameRange {
          start: tok_span(toks, keyword_pos),
          length: tok_end(toks, keyword_pos) - tok_span(toks, keyword_pos)
        }
      }
    ),
    next: parsed_clauses.next
  }
}

pub(package) fn parse_handler_config_arg_count(config: HandlerConfiguration) -> i64 {
  match config {
    HandlerConfiguration(ns, nl, type_args, args) -> expr_list_len(args)
    UnknownHandlerConfiguration -> 0 - 1
  }
}

pub(package) fn parse_default_handler_decl(
  toks: i64,
  src: i64,
  pos: i64,
  has_visibility: bool
) -[Diagnose, TypeParameterScope]> DeclarationParse {
  let has_handler = tok_tag(toks, pos) == 2 and src_eq(
    src,
    tok_v1(toks, pos),
    tok_v2(toks, pos),
    "handler"
  ) == 1
  if has_handler == 0 {
    parse_syntax_error(
      toks,
      src,
      pos,
      "error: expected 'handler' after 'default'",
      "default handler",
      "resume_at_declaration"
    )
  } else { 0 }
  if has_visibility {
    parse_syntax_error(
      toks,
      src,
      if pos > 0 { pos - 1 } else { pos },
      "error: default handler declarations cannot have visibility",
      "default handler",
      "continue_declaration"
    )
  } else { 0 }
  let config_r = parse_handler_configuration(
    toks,
    src,
    if has_handler == 1 { pos + 1 } else { pos }
  )
  if parse_handler_config_arg_count(config_r.syntax) != 0 {
    parse_syntax_error(
      toks,
      src,
      tok_span(toks, if has_handler == 1 { pos + 1 } else { pos }),
      "error: module default handlers require a zero-argument constructor",
      "default handler",
      "continue_declaration"
    )
  } else { 0 }
  let keyword_pos = if pos > 0 { pos - 1 } else { pos }
  DeclarationParse {
    syntax: DefaultHandlerDefinition(
      DefaultHandlerSyntax {
        configuration: config_r.syntax,
        keyword: TypeNameRange {
          start: tok_span(toks, keyword_pos),
          length: tok_end(toks, keyword_pos) - tok_span(toks, keyword_pos)
        }
      }
    ),
    next: config_r.next
  }
}

fn parse_source_declaration(
  toks: i64,
  start_pos: i64,
  next_pos: i64,
  visibility: DeclVisibility,
  errors_before: i64,
  syntax: DeclarationSyntax
) -> SourceDeclaration {
  let start = tok_span(toks, start_pos)
  let last_pos = if next_pos > start_pos { next_pos - 1 } else { start_pos }
  let safe_last = if last_pos < tok_count(toks) { last_pos } else { tok_count(toks) - 1 }
  let end = tok_end(toks, safe_last)
  let invalid = match syntax { InvalidDefinition -> true, _ -> false }
  SourceDeclaration {
    syntax: syntax,
    visibility: visibility,
    range: TypeNameRange { start: start, length: if end > start { end - start } else { 0 } },
    validity: if invalid or tok_parse_error_count(toks) > errors_before { RecoveredDeclaration } else {
      ParsedDeclaration
    }
  }
}

fn parse_module_contents(toks: i64, src: i64) -[Diagnose, TypeParameterScope]> ParsedModuleSyntax
{
  parse_diagnose_identifier_security(toks, src)
  parse_diagnose_bidi_source(toks, src)
  let mut imports: List<ImportDeclaration> = Nil
  let mut declarations: List<SourceDeclaration> = Nil
  let mut has_handler = false
  let mut p = 0
  -- Recovery may reach EOF; never read beyond this source's token buffer.
  while p < tok_count(toks) and tok_tag(toks, p) != 7 {
    let tag = tok_tag(toks, p)
    if tag == 5 and tok_v1(toks, p) == 13 {
      p = p + 1
    } else {
      let start = p
      let errors_before = tok_parse_error_count(toks)
      let declared = parse_decl_visibility(toks, src, p)
      let visibility = declared.visibility
      let decl_p = declared.next
      let has_visibility = declared.explicit
      let kw = if tok_tag(toks, decl_p) == 3 { tok_v1(toks, decl_p) }
      else if tok_tag(toks, decl_p) == 2 and src_eq(
        src,
        tok_v1(toks, decl_p),
        tok_v2(toks, decl_p),
        "default"
      ) == 1 { 39 }
      else { 0 }
      tok_set_syntax_role(
        toks,
        start,
        if kw == 19 { tok_syntax_role_top_level_import() } else {
          tok_syntax_role_top_level_decl()
        }
      )
      let requires_name = kw == 1 or kw == 9 or kw == 23 or kw == 26 or kw == 37
      let parsed = if requires_name and tok_tag(toks, decl_p + 1) != 2 {
        parse_syntax_error(
          toks,
          src,
          decl_p + 1,
          "error: expected declaration name after keyword",
          "module declaration",
          "resume_at_declaration"
        )
        DeclarationParse { syntax: InvalidDefinition, next: sync_to_decl(toks, src, decl_p + 1) }
      } else {
        match kw {
          1 -> {
            let function = parse_fn(toks, src, decl_p + 1)
            if function.next <= decl_p {
              parse_syntax_error(
                toks,
                src,
                decl_p + 1,
                "error: malformed function declaration",
                "module",
                "resume_at_declaration"
              )
              DeclarationParse {
                syntax: InvalidDefinition,
                next: sync_to_decl(toks, src, decl_p + 1)
              }
            } else {
              DeclarationParse {
                syntax: FunctionDefinition(function.syntax),
                next: function.next
              }
            }
          }
          9 -> parse_type_decl(toks, src, decl_p + 1)
          23 -> parse_effect_decl(toks, src, decl_p + 1, visibility)
          26 -> parse_trait_decl(toks, src, decl_p + 1)
          27 -> {
            if has_visibility {
              parse_syntax_error(
                toks,
                src,
                start,
                "error: visibility belongs on inherent methods, not an impl block",
                "impl declaration",
                "continue_impl"
              )
            } else { 0 }
            parse_impl_decl(toks, src, decl_p + 1)
          }
          19 -> match parse_use_surface(toks, src, decl_p + 1) {
            ImportInvalid(next) -> DeclarationParse { syntax: InvalidDefinition, next: next }
            ImportParsed(syntax, next) -> {
              imports = Cons(
                ImportDeclaration {
                  syntax: syntax,
                  module_start: __i64_to_usize(tok_span(toks, decl_p + 1)),
                  visibility: visibility,
                  start: __i64_to_usize(tok_span(toks, start)),
                  end: __i64_to_usize(tok_end(toks, next - 1))
                },
                imports
              )
              DeclarationParse { syntax: ImportDefinition(syntax), next: next }
            }
          }
          32 -> {
            if has_visibility {
              parse_syntax_error(
                toks,
                src,
                start,
                "error: test declarations cannot have visibility",
                "test declaration",
                "continue_test"
              )
            } else { 0 }
            parse_test_syntax(toks, src, decl_p + 1)
          }
          37 -> parse_const_decl(toks, src, decl_p + 1)
          38 -> {
            let handler = parse_handler_implementation_syntax(toks, src, decl_p + 1)
            if has_handler {
              parse_syntax_error(
                toks,
                src,
                decl_p + 1,
                "error: a module may declare only one handler implementation",
                "handler implementation",
                "continue_declaration"
              )
            } else { 0 }
            has_handler = true
            handler
          }
          39 -> parse_default_handler_decl(toks, src, decl_p + 1, has_visibility)
          _ -> {
            if tok_last_parse_error_pos(toks) != decl_p {
              parse_syntax_error(
                toks,
                src,
                decl_p,
                "error: expected a module declaration",
                "module",
                "resume_at_declaration"
              )
            } else { 0 }
            DeclarationParse {
              syntax: InvalidDefinition,
              next: sync_to_decl(toks, src, if tag == 3 { decl_p + 1 } else { decl_p })
            }
          }
        }
      }
      p = parsed.next
      declarations = Cons(
        parse_source_declaration(toks, start, p, visibility, errors_before, parsed.syntax),
        declarations
      )
    }
  }
  ParsedModuleSyntax { imports: imports.reverse(), declarations: declarations.reverse() }
}

-- Source-relative name ranges remain syntax until the host resolves them.
pub(package) fn parse_import_name(toks: i64, pos: i64) -> ImportName {
  ImportName {
    start: __i64_to_usize(tok_span(toks, pos)),
    length: __i64_to_usize(tok_identifier_spelling_len(toks, pos))
  }
}

pub(package) fn parse_use_selections(
  toks: i64,
  src: i64,
  pos: i64
) -[Diagnose]> ImportSelectionsParse {
  if tok_tag(toks, pos) == 5 and tok_v1(toks, pos) == 8 and tok_tag(toks, pos + 1) == 5 and
    tok_v1(toks, pos + 1) == 3 {
      tok_set_syntax_role(toks, pos + 1, tok_syntax_role_import_selection())
      let mut selections: List<ImportSelection> = Nil
      let mut p = pos + 2
      let mut done = false
      while not done {
        if tok_tag(toks, p) == 7 or is_decl_start(toks, p) == 1 {
          parse_syntax_error(
            toks,
            src,
            p,
            "error: expected '}' after import selection",
            "import selection",
            "resume_at_declaration"
          )
          done = true
        } else {
          if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 4 {
            tok_set_syntax_role(toks, p, tok_syntax_role_import_selection())
            tok_note_layout_group(toks, pos + 1, p)
            p = p + 1
            done = true
          } else {
            if tok_tag(toks, p) == 4 and tok_v1(toks, p) == 3 {
              tok_note_layout_item(toks, p)
              tok_set_syntax_role(toks, p, tok_syntax_role_import_selection())
              selections = Cons(ImportWildcard, selections)
              p = p + 1
            } else {
              if tok_tag(toks, p) == 2 {
                tok_note_layout_item(toks, p)
                let name = parse_import_name(toks, p)
                let mut selection = ImportSymbol(name)
                p = p + 1
                if tok_tag(toks, p) == 3 and tok_v1(toks, p) == 35 {
                  if tok_tag(toks, p + 1) == 2 {
                    selection = ImportRenamedSymbol(name, parse_import_name(toks, p + 1))
                    p = p + 2
                  } else {
                    parse_syntax_error(
                      toks,
                      src,
                      p,
                      "error: expected import alias after 'as'",
                      "import selection",
                      "continue_selection"
                    )
                    p = p + 1
                  }
                } else { 0 }
                selections = Cons(selection, selections)
              } else {
                parse_syntax_error(
                  toks,
                  src,
                  p,
                  "error: expected imported name or '*' in selection",
                  "import selection",
                  "continue_selection"
                )
                p = p + 1
              }
            }
          }
        }
        if not done {
          -- A newline before the selection close has no grammar meaning. Do
          -- not accept it as a substitute for a required comma between names.
          let after_newline = parse_skip_synthetic_semicolons(toks, p)
          if tok_tag(toks, after_newline) == 5 and tok_v1(toks, after_newline) == 4 {
            p = after_newline
          } else { 0 }
          if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 5 { p = p + 1 }
        else {
          if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 4 { 0 }
          else {
            parse_syntax_error(
              toks,
              src,
              p,
              "error: expected ',' or '}' in import selection",
              "import selection",
              "stop_selection"
            )
            done = true
          }
        }
        } else { 0 }
      }
      ParsedImportSelections(selections.reverse(), p)
    } else {
      if tok_tag(toks, pos) == 5 and tok_v1(toks, pos) == 8 {
        parse_syntax_error(
          toks,
          src,
          pos + 1,
          "error: expected '{' after '.' in import selection",
          "import selection",
          "stop_selection"
        )
        NoImportSelections(pos + 1)
      } else {
        NoImportSelections(pos)
      }
    }
}

pub(package) fn parse_use_path_segment_len(toks: i64, src: i64, pos: i64) -> i64 {
  tok_identifier_spelling_len(toks, pos)
}

-- A declaration on the next line is a recovery boundary for a missing
-- import path. Keyword spellings remain valid within ordinary module paths.
pub(package) fn parse_use_starts_following_declaration(toks: i64, src: i64, pos: i64) -> bool {
  if pos <= 0 or is_decl_start(toks, pos) == 0 { false }
  else {
    let mut offset = tok_end(toks, pos - 1)
    let end = tok_span(toks, pos)
    let mut newline = false
    while offset < end and not newline {
      let byte = mem_load8_at(src, offset)
      newline = byte == 10 or byte == 13
      offset = offset + 1
    }
    newline
  }
}

pub(package) fn parse_use_surface(toks: i64, src: i64, pos: i64) -[Diagnose]> ImportParse {
  if parse_use_path_segment_len(toks, src, pos) > 0 and
    not parse_use_starts_following_declaration(toks, src, pos) {
      let path = buf_new(64)
      let mut p = pos
      let mut final_name = parse_import_name(toks, pos)
      let mut path_done = false
      while not path_done {
        let seg_len = parse_use_path_segment_len(toks, src, p)
        if seg_len == 0 {
          parse_syntax_error(
            toks,
            src,
            p,
            "error: expected module path segment",
            "import path",
            "stop_import"
          )
          path_done = true
        } else {
          let seg_start = tok_span(toks, p)
          bscopy(path, src + seg_start, seg_len, 0)
          final_name = parse_import_name(toks, p)
          p = p + 1
          if tok_tag(toks, p) == 4 and tok_v1(toks, p) == 4 {
            tok_set_syntax_role(toks, p, tok_syntax_role_module_path())
            bu8(path, 47)
            p = p + 1
            if parse_use_path_segment_len(toks, src, p) == 0 or
              parse_use_starts_following_declaration(toks, src, p) {
                parse_syntax_error(
                  toks,
                  src,
                  p,
                  "error: expected module path segment after '/'",
                  "import path",
                  "stop_import"
                )
                path_done = true
              } else { 0 }
          } else { path_done = true }
        }
      }
      let module_path = runtime_str_from_bytes_copy(buf_ptr(path), buf_len(path))
      match parse_use_selections(toks, src, p) {
        ParsedImportSelections(selections, next) -> ImportParsed(
          ImportSyntax {
            module_path: module_path,
            binding: ImportSymbols(selections)
          },
          next
        )
        NoImportSelections(next) -> {
          p = next
          let mut alias = final_name
          if tok_tag(toks, p) == 3 and tok_v1(toks, p) == 35 {
            if tok_tag(toks, p + 1) == 2 {
              alias = parse_import_name(toks, p + 1)
              p = p + 2
            } else {
              parse_syntax_error(
                toks,
                src,
                p,
                "error: expected module alias after 'as'",
                "import alias",
                "continue_import"
              )
              p = p + 1
            }
          } else { 0 }
          ImportParsed(ImportSyntax { module_path: module_path, binding: ImportModule(alias) }, p)
        }
      }
    } else {
      parse_syntax_error(
        toks,
        src,
        pos,
        "error: expected path-form module after 'use'",
        "import path",
        "stop_import"
      )
      ImportInvalid(if is_decl_start(toks, pos) == 1 { pos } else { pos + 1 })
    }
}

-- Parse a structural/variant declaration or an opaque value declaration:
--   type Name<T, U> { fields_or_variants }
--   type Name<T, U> = opaque Representation
pub(package) fn parse_type_decl(toks: i64, src: i64, pos: i64) -[Diagnose]> DeclarationParse {
  -- pos is after "type" keyword
  let type_ns = tok_v1(toks, pos)
  let type_nl = tok_v2(toks, pos)
  -- Check for <T, U> type parameters after name
  let tparams_r = if tok_tag(toks, pos + 1) == 4 {
    if tok_v1(toks, pos + 1) == 7 {
      parse_type_params(toks, src, pos + 2)
    } else { syntax_parse(TypeParamListNil, pos + 1) }
  } else { syntax_parse(TypeParamListNil, pos + 1) }
  let tparams = tparams_r.syntax
  let p_after = tparams_r.next
  let is_equals = tok_tag(toks, p_after) == 5 and tok_v1(toks, p_after) == 7
  let result = if is_equals {
    let marker_pos = p_after + 1
    if tok_tag(toks, marker_pos) == 2 and src_eq(
      src,
      tok_v1(toks, marker_pos),
      tok_v2(toks, marker_pos),
      "opaque"
    ) == 1 {
      let representation_pos = marker_pos + 1
      if tok_tag(toks, representation_pos) == 7 {
        parse_syntax_error(
          toks,
          src,
          representation_pos,
          "error: expected representation type after 'opaque'",
          "opaque type declaration",
          "resume_at_declaration"
        )
        DeclarationParse {
          syntax: InvalidDefinition,
          next: sync_to_decl(toks, src, representation_pos)
        }
      } else {
        let representation_r = parse_type(toks, src, representation_pos, tparams)
        DeclarationParse {
          syntax: TypeDefinition(
            OpaqueSyntax(
              TypeNameRange { start: type_ns, length: type_nl },
              tparams,
              representation_r.syntax
            )
          ),
          next: representation_r.next
        }
      }
    } else {
      if parse_type_starts_at(toks, marker_pos) == 0 {
        parse_syntax_error(
          toks,
          src,
          marker_pos,
          "error: expected target type after '='",
          "type alias declaration",
          "resume_at_declaration"
        )
        DeclarationParse { syntax: InvalidDefinition, next: sync_to_decl(toks, src, marker_pos) }
      } else {
        let target = parse_type(toks, src, marker_pos, tparams)
        DeclarationParse {
          syntax: TypeDefinition(
            AliasSyntax(
              TypeNameRange { start: type_ns, length: type_nl },
              tparams,
              target.syntax
            )
          ),
          next: target.next
        }
      }
    }
  } else {
    if tok_tag(toks, p_after) == 5 and tok_v1(toks, p_after) == 3 {
      -- Structural and variant declarations begin after `{`.
      parse_type_decl_body(toks, src, p_after + 1, type_ns, type_nl, tparams)
    } else {
      parse_syntax_error(
        toks,
        src,
        p_after,
        "error: expected '{' or '=' in type declaration",
        "type declaration",
        "resume_at_declaration"
      )
      DeclarationParse { syntax: InvalidDefinition, next: sync_to_decl(toks, src, p_after) }
    }
  }
  result
}

fn parse_type_decl_body(
  toks: i64,
  src: i64,
  p: i64,
  type_ns: i64,
  type_nl: i64,
  tparams: TypeParamList
) -[Diagnose]> DeclarationParse {
  let mut first = p
  while tok_tag(toks, first) == 5 and (tok_v1(toks, first) == 5 or tok_v1(toks, first) == 13) {
    first = first + 1
  }
  let name = TypeNameRange { start: type_ns, length: type_nl }
  if tok_tag(toks, first + 1) == 5 and tok_v1(toks, first + 1) == 6 {
    let (fields, end) = parse_record_fields(toks, src, p, tparams)
    DeclarationParse {
      syntax: TypeDefinition(RecordSyntax(name, tparams, fields)),
      next: end
    }
  } else {
    let (variants, end) = parse_variant_fields(toks, src, p, tparams)
    DeclarationParse {
      syntax: TypeDefinition(VariantSyntax(name, tparams, variants)),
      next: end
    }
  }
}

pub(package) fn parse_type_starts_at(toks: i64, pos: i64) -> i64 {
  let tag = tok_tag(toks, pos)
  let value = tok_v1(toks, pos)
  if tag == 2 { 1 }
  else if tag == 5 {
    if value == 1 or value == 3 or value == 11 or value == 17 { 1 } else { 0 }
  } else if tag == 4 and value == 3 { 1 } else { 0 }
}

fn parse_type_member_sync(toks: i64, pos: i64) -> i64 {
  let mut p = pos
  loop {
    let tag = tok_tag(toks, p)
    if tag == 7 or is_decl_start(toks, p) == 1 { break }
    if tag == 5 and (tok_v1(toks, p) == 4 or tok_v1(toks, p) == 5 or tok_v1(toks, p) == 13) {
      break
    }
    p = p + 1
  }
  p
}

fn parse_record_fields(
  toks: i64,
  src: i64,
  pos: i64,
  tctx: TypeParamList
) -[Diagnose]> (List<RecordFieldSyntax>, i64) {
  let mut p = pos
  let mut fields: List<RecordFieldSyntax> = Nil
  loop {
    let tag = tok_tag(toks, p)
    if tag == 7 or is_decl_start(toks, p) == 1 {
      parse_syntax_error(
        toks,
        src,
        p,
        "error: expected '}' after record fields",
        "record type declaration",
        "resume_at_declaration"
      )
      break
    } else if tag == 5 and tok_v1(toks, p) == 4 {
      tok_note_layout_group(toks, pos - 1, p)
      p = p + 1
      break
    } else if tag == 5 and (tok_v1(toks, p) == 5 or tok_v1(toks, p) == 13) {
      -- Consume an unexpected separator once, preserving its exact diagnostic.
      parse_syntax_error(
        toks,
        src,
        p,
        "error: expected record field after separator",
        "record type declaration",
        "continue_fields"
      )
      p = p + 1
    } else if tag == 2 or tag == 3 {
      tok_note_layout_member(toks, p)
      let name = TypeNameRange { start: tok_v1(toks, p), length: tok_v2(toks, p) }
      let colon_pos = p + 1
      let has_colon = tok_tag(toks, colon_pos) == 5 and tok_v1(toks, colon_pos) == 6
      let type_pos = if has_colon { colon_pos + 1 } else { colon_pos }
      let has_type = has_colon and parse_type_starts_at(toks, type_pos) == 1
      if not has_colon {
        parse_syntax_error(
          toks,
          src,
          colon_pos,
          "error: expected ':' after record field name",
          "record type declaration",
          "continue_fields"
        )
      } else if not has_type {
        parse_syntax_error(
          toks,
          src,
          type_pos,
          "error: expected type after record field ':'",
          "record type declaration",
          "continue_fields"
        )
      }
      let (annotation, after_type) = if has_type {
        let parsed = parse_type(toks, src, type_pos, tctx)
        (parsed.syntax, parsed.next)
      } else { (AnyTypeExpr, type_pos) }
      fields = Cons(RecordFieldSyntax { name: name, annotation: annotation }, fields)
      if has_type {
        p = after_type
        if tok_tag(toks, p) == 5 and (tok_v1(toks, p) == 5 or tok_v1(toks, p) == 13) {
          p = p + 1
        } else if not (tok_tag(toks, p) == 5 and tok_v1(toks, p) == 4) and
          tok_tag(toks, p) != 7 and is_decl_start(toks, p) == 0 {
            parse_syntax_error(
              toks,
              src,
              p,
              "error: expected ',' or '}' after record field",
              "record type declaration",
              "continue_fields"
            )
            p = parse_type_member_sync(toks, p)
            if tok_tag(toks, p) == 5 and (tok_v1(toks, p) == 5 or tok_v1(toks, p) == 13) {
              p = p + 1
            }
          }
      } else {
        p = parse_type_member_sync(toks, type_pos)
        if tok_tag(toks, p) == 5 and (tok_v1(toks, p) == 5 or tok_v1(toks, p) == 13) { p = p + 1 }
      }
    } else {
      parse_syntax_error(
        toks,
        src,
        p,
        "error: expected record field name or '}'",
        "record type declaration",
        "continue_fields"
      )
      p = parse_type_member_sync(toks, p + 1)
      if tok_tag(toks, p) == 5 and (tok_v1(toks, p) == 5 or tok_v1(toks, p) == 13) { p = p + 1 }
    }
  }
  (fields.reverse(), p)
}

-- A newline before a closer cannot replace a required comma between items.
-- Explicit semicolons are never discarded by this delimiter-specific rule.
fn parse_skip_synthetic_before_close(toks: i64, pos: i64, close: i64) -> i64 {
  let next = parse_skip_synthetic_semicolons(toks, pos)
  if tok_tag(toks, next) == 5 and tok_v1(toks, next) == close { next }
  else { pos }
}

pub(package) fn parse_skip_synthetic_semicolons(toks: i64, pos: i64) -> i64 {
  let mut p = pos
  while tok_tag(toks, p) == 5 and tok_v1(toks, p) == 13 and tok_span(toks, p) == tok_end(toks, p) {
    p = p + 1
  }
  p
}

fn parse_variant_fields(
  toks: i64,
  src: i64,
  pos: i64,
  tctx: TypeParamList
) -[Diagnose]> (List<VariantMemberSyntax>, i64) {
  let mut p = pos
  let mut variants: List<VariantMemberSyntax> = Nil
  loop {
    let tag = tok_tag(toks, p)
    if tag == 7 or is_decl_start(toks, p) == 1 {
      parse_syntax_error(
        toks,
        src,
        p,
        "error: expected '}' after type variants",
        "variant type declaration",
        "resume_at_declaration"
      )
      break
    } else if tag == 5 and tok_v1(toks, p) == 4 {
      tok_note_layout_group(toks, pos - 1, p)
      p = p + 1
      break
    } else if tag == 5 and (tok_v1(toks, p) == 5 or tok_v1(toks, p) == 13) {
      parse_syntax_error(
        toks,
        src,
        p,
        "error: expected variant after separator",
        "variant type declaration",
        "continue_variants"
      )
      p = p + 1
    } else if tag == 2 {
      tok_note_layout_member(toks, p)
      let name = TypeNameRange { start: tok_v1(toks, p), length: tok_v2(toks, p) }
      let (payloads, end) = if tok_tag(toks, p + 1) == 5 and tok_v1(toks, p + 1) == 1 {
        parse_variant_payload_types(toks, src, p + 2, tctx)
      } else { (Nil<TypeExpr>(), p + 1) }
      variants = Cons(VariantMemberSyntax { name: name, payloads: payloads }, variants)
      p = end
      if tok_tag(toks, p) == 5 and (tok_v1(toks, p) == 5 or tok_v1(toks, p) == 13) {
        p = p + 1
      } else if not (tok_tag(toks, p) == 5 and tok_v1(toks, p) == 4) and
        tok_tag(toks, p) != 7 and is_decl_start(toks, p) == 0 {
          parse_syntax_error(
            toks,
            src,
            p,
            "error: expected ',' or '}' after variant",
            "variant type declaration",
            "continue_variants"
          )
          p = parse_type_member_sync(toks, p)
          if tok_tag(toks, p) == 5 and (tok_v1(toks, p) == 5 or tok_v1(toks, p) == 13) {
            p = p + 1
          }
        }
    } else {
      parse_syntax_error(
        toks,
        src,
        p,
        "error: expected variant name or '}'",
        "variant type declaration",
        "continue_variants"
      )
      p = parse_type_member_sync(toks, p + 1)
      if tok_tag(toks, p) == 5 and (tok_v1(toks, p) == 5 or tok_v1(toks, p) == 13) { p = p + 1 }
    }
  }
  (variants.reverse(), p)
}

fn parse_variant_payload_types(
  toks: i64,
  src: i64,
  pos: i64,
  tctx: TypeParamList
) -[Diagnose]> (List<TypeExpr>, i64) {
  let mut payloads: List<TypeExpr> = Nil
  let mut p = parse_skip_synthetic_semicolons(toks, pos)
  if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 2 {
    tok_note_layout_group(toks, pos - 1, p)
    return (payloads, p + 1)
  }
  loop {
    if tok_tag(toks, p) == 7 or is_decl_start(toks, p) == 1 or (
      tok_tag(toks, p) == 5 and tok_v1(toks, p) == 4
    ) {
      parse_syntax_error(
        toks,
        src,
        p,
        "error: expected ')' after variant payload types",
        "variant payload",
        "stop_variant"
      )
      break
    } else if parse_type_starts_at(toks, p) == 0 {
      parse_syntax_error(
        toks,
        src,
        p,
        "error: expected variant payload type",
        "variant payload",
        "stop_variant"
      )
      p = parse_type_member_sync(toks, p)
      break
    } else {
      tok_note_layout_item(toks, p)
      let parsed = parse_type(toks, src, p, tctx)
      payloads = Cons(parsed.syntax, payloads)
      p = parse_skip_synthetic_semicolons(toks, parsed.next)
      if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 5 {
        p = p + 1
        if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 2 { p = p + 1; break }
      } else if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 2 {
        p = p + 1
        break
      } else {
        parse_syntax_error(
          toks,
          src,
          p,
          "error: expected ',' or ')' after variant payload type",
          "variant payload",
          "stop_variant"
        )
        p = parse_type_member_sync(toks, p)
        break
      }
    }
  }
  if tok_tag(toks, p - 1) == 5 and tok_v1(toks, p - 1) == 2 {
    tok_note_layout_group(toks, pos - 1, p - 1)
  }
  (payloads.reverse(), p)
}
