-- parse.weft — recursive descent parser with Pratt precedence
-- Parser functions return a two-word {node, pos} result cell.

use compiler/diagnostic/location.{diagnostic_location_from_offsets}
use compiler/weft/syntax/numeric.{*}
use compiler/weft/lex.{*}
use compiler/weft/syntax/imports.{*}
use compiler/weft/syntax/declarations.{*}
use compiler/ir/data.{*}
use stdlib/list.{Cons, List, Nil}
use compiler/storage.{*}
use compiler/types/algebra.{*}
use compiler/types/names.{effect_name_hash, type_name_hash, str_hash}
use compiler/diagnostic/render.{*}
use compiler/project/module.{*}
use compiler/source/position.{source_position_utf8_scalar, source_position_utf8_width}
use runtime/alloc.{*}
use runtime/buffer.{*}
use runtime/memory.{*}
use runtime/string.{runtime_str_eq, runtime_str_from_bytes_copy}
use stdlib/diagnostic/registry
use stdlib/diagnostic/schema.{*}
use stdlib/unicode/security.{
  unicode_security_is_directional_formatting,
  unicode_security_is_mixed_script_bytes,
  unicode_security_skeleton_bytes
}

-- span is an offset into src; the diagnostic carries the absolute address so
-- the renderer can resolve which loaded source buffer it belongs to.
pub(package) fn parse_message_body(msg: str) -> str {
  let len = __str_len(msg)
  if len >= 7 and src_eq(__str_ptr(msg), 0, 7, "error: ") == 1 {
    runtime_str_from_bytes_copy(__str_ptr(msg) + 7, len - 7)
  } else { msg }
}

pub(package) fn parse_diagnostic_fields(
  reason: str,
  context: str,
  expectation: str,
  found: str,
  recovery: str
) -> DiagnosticFieldList {
  DiagnosticFieldCons(
    DiagnosticFieldText("reason", reason),
    DiagnosticFieldCons(
      DiagnosticFieldText("context", context),
      DiagnosticFieldCons(
        DiagnosticFieldText("expectation", expectation),
        DiagnosticFieldCons(
          DiagnosticFieldText("found", found),
          DiagnosticFieldCons(
            DiagnosticFieldText("recovery", recovery),
            DiagnosticFieldNil
          )
        )
      )
    )
  )
}

pub(package) fn parse_report_error(
  src: i64,
  start: i64,
  end: i64,
  msg: str,
  code: DiagnosticCode,
  reason: str,
  context: str,
  found: str,
  recovery: str
) -[Diagnose]> i64 {
  let body = parse_message_body(msg)
  Diagnose.report(
    Diagnostic(
      DiagnosticSeverityError,
      DiagnosticClassParse,
      code,
      body,
      diagnostic_location_from_offsets(
        DiagnosticSourceBuffer(src),
        start,
        if end < start { start } else { end }
      ),
      DiagnosticRelatedLocationNil,
      parse_diagnostic_fields(reason, context, body, found, recovery)
    )
  )
}

pub(package) fn parse_token_text(toks: i64, src: i64, pos: i64) -> str {
  let tag = tok_tag(toks, pos)
  let start = tok_span(toks, pos)
  let end = tok_end(toks, pos)
  if tag == 7 { "end of file" }
  else {
    if end > start { runtime_str_from_bytes_copy(src + start, end - start) }
    else { if tag == 5 and tok_v1(toks, pos) == 13 { "newline" } else { "token" } }
  }
}

pub(package) fn parse_syntax_error(
  toks: i64,
  src: i64,
  pos: i64,
  msg: str,
  context: str,
  recovery: str
) -[Diagnose]> i64 {
  tok_note_parse_error(toks, pos)
  parse_report_error(
    src,
    tok_span(toks, pos),
    tok_end(toks, pos),
    msg,
    registry.syntax_error(),
    "syntax_error",
    context,
    parse_token_text(toks, src, pos),
    recovery
  )
}

pub(package) fn parse_unsupported_syntax(
  toks: i64,
  src: i64,
  pos: i64,
  msg: str,
  context: str,
  recovery: str
) -[Diagnose]> i64 {
  tok_note_parse_error(toks, pos)
  parse_report_error(
    src,
    tok_span(toks, pos),
    tok_end(toks, pos),
    msg,
    registry.unsupported_syntax(),
    "unsupported_syntax",
    context,
    parse_token_text(toks, src, pos),
    recovery
  )
}

pub(package) fn parse_missing_delimiter(
  toks: i64,
  src: i64,
  pos: i64,
  open_pos: i64,
  msg: str,
  expected: str,
  context: str,
  recovery: str
) -[Diagnose]> i64 {
  tok_note_parse_error(toks, pos)
  let insertion = tok_span(toks, pos)
  Diagnose.report(
    Diagnostic(
      DiagnosticSeverityError,
      DiagnosticClassParse,
      registry.syntax_error(),
      parse_message_body(msg),
      diagnostic_location_from_offsets(DiagnosticSourceBuffer(src), insertion, tok_end(toks, pos)),
      DiagnosticRelatedLocationCons(
        DiagnosticRelatedLocation(
          "construct opened here",
          diagnostic_location_from_offsets(
            DiagnosticSourceBuffer(src),
            tok_span(toks, open_pos),
            tok_end(toks, open_pos)
          )
        ),
        DiagnosticRelatedLocationNil
      ),
      DiagnosticFieldCons(
        DiagnosticFieldText("reason", "missing_delimiter"),
        DiagnosticFieldCons(
          DiagnosticFieldText("context", context),
          DiagnosticFieldCons(
            DiagnosticFieldText("expectation", expected),
            DiagnosticFieldCons(
              DiagnosticFieldText("found", parse_token_text(toks, src, pos)),
              DiagnosticFieldCons(
                DiagnosticFieldText("recovery", recovery),
                DiagnosticFieldCons(
                  DiagnosticFieldSuggestion(
                    DiagnosticSuggestion(
                      "insert the missing closing delimiter",
                      DiagnosticSuggestionMachineApplicable,
                      DiagnosticTextEditCons(
                        DiagnosticTextEdit(
                          diagnostic_location_from_offsets(
                            DiagnosticSourceBuffer(src),
                            insertion,
                            insertion
                          ),
                          expected
                        ),
                        DiagnosticTextEditNil
                      )
                    )
                  ),
                  DiagnosticFieldNil
                )
              )
            )
          )
        )
      )
    )
  )
}

pub(package) fn is_decl_keyword(kw: i64) -> bool {
  match kw {
    1 -> true -- fn
    9 -> true -- type
    19 -> true -- use
    23 -> true -- effect
    26 -> true -- trait
    27 -> true -- impl
    32 -> true -- test
    34 -> true -- pub modifier
    37 -> true -- const
    38 -> true -- implements
    _ -> false
  }
}

pub(package) fn is_decl_start(toks: i64, pos: i64) -> i64 {
  if tok_tag(toks, pos) == 3 { is_decl_keyword(tok_v1(toks, pos)) } else { 0 }
}

pub(package) fn parse_expr_starts_at(toks: i64, pos: i64) -> i64 {
  let tag = tok_tag(toks, pos)
  let value = tok_v1(toks, pos)
  if tag == 1 or tag == 2 or tag == 8 or tag == 9 or tag == 13 or tag == 15 { 1 }
  else {
    if tag == 4 and value == 2 { 1 }
    else {
      if tag == 5 and (value == 1 or value == 3 or value == 10 or value == 17) { 1 }
      else {
        if tag == 3 {
          if value == 2 or value == 3 or value == 8 or value == 10 or value == 11 or value ==
            20 or value == 21 or value == 22 or value == 24 or value == 25 or value == 29 or
            value == 31 or value == 33 { 1 } else { 0 }
        } else { 0 }
      }
    }
  }
}

pub(package) fn parse_pattern_starts_at(toks: i64, pos: i64) -> i64 {
  let tag = tok_tag(toks, pos)
  if tag == 1 or tag == 2 or tag == 9 { 1 }
  else { if tag == 5 and (tok_v1(toks, pos) == 1 or tok_v1(toks, pos) == 3) { 1 } else { 0 } }
}

-- Synchronize one comma-separated construct without confusing nested
-- delimiters with the boundary owned by its caller.
pub(package) fn parse_item_sync(toks: i64, pos: i64, close_value: i64) -> i64 {
  let mut p = pos
  let mut parens = 0
  let mut braces = 0
  let mut brackets = 0
  let mut done = 0
  while done == 0 {
    let tag = tok_tag(toks, p)
    let value = tok_v1(toks, p)
    if tag == 7 or (parens == 0 and braces == 0 and brackets == 0 and is_decl_start(toks, p) == 1) {
      done = 1
    }
    else {
      if tag == 5 and parens == 0 and braces == 0 and brackets == 0 and (
        value == 5 or value == close_value
      ) { done = 1 }
      else {
        if tag == 5 {
          if value == 1 { parens = parens + 1 }
          else {
            if value == 2 and parens > 0 { parens = parens - 1 }
            else {
              if value == 3 { braces = braces + 1 }
              else {
                if value == 4 and braces > 0 { braces = braces - 1 }
                else {
                  if value == 17 { brackets = brackets + 1 }
                  else { if value == 14 and brackets > 0 { brackets = brackets - 1 } else { 0 } }
                }
              }
            }
          }
        } else { 0 }
        p = p + 1
      }
    }
  }
  p
}

-- Error recovery: skip to the next declaration keyword at the current module
-- depth or EOF. A keyword inside the malformed declaration's own body is not a
-- recovery boundary; treating it as one turns one bad header into a cascade of
-- bogus top-level declarations.
pub(package) fn sync_to_decl(toks: i64, src: i64, pos: i64) -> i64 {
  let mut p = pos
  let mut done = 0
  let mut parens = 0
  let mut braces = 0
  let mut brackets = 0
  while done == 0 {
    let tag = tok_tag(toks, p)
    if tag == 7 { done = 1 }
    else {
      if parens == 0 and braces == 0 and brackets == 0 and (
        is_decl_start(toks, p) == 1 or (
          tag == 2 and src_eq(src, tok_v1(toks, p), tok_v2(toks, p), "default") == 1
        )
      ) { done = 1 }
      else {
        if tag == 5 {
          let value = tok_v1(toks, p)
          if value == 1 { parens = parens + 1 }
          else {
            if value == 2 and parens > 0 { parens = parens - 1 }
            else {
              if value == 3 { braces = braces + 1 }
              else {
                if value == 4 and braces > 0 { braces = braces - 1 }
                else {
                  if value == 17 { brackets = brackets + 1 }
                  else { if value == 14 and brackets > 0 { brackets = brackets - 1 } else { 0 } }
                }
              }
            }
          }
        } else { 0 }
        p = p + 1
      }
    }
  }
  p
}

-- Lookahead: check if < at pos is a type arg delimiter (balanced > followed by ()
-- Tokens that can appear inside a type-argument list: identifiers,
-- comma, nested angles, the type operators | & ~ ?, parens and arrows
-- for function types, and effect-row/fixed-array brackets. Anything else proves the
-- `<` was a comparison. Without this guard the speculative scan below
-- ran to the next unrelated `>` in the file (or EOF): every `a < b`
-- comparison cost O(distance) — quadratic checking on comparison-heavy
-- files — and a later `> (` (e.g. `3 > (2 - 2)`) misparsed the
-- comparison as a generic call, rejecting valid programs.
pub(package) fn is_type_arg_token(tag: i64, v1: i64) -> i64 {
  if tag == 1 { 1 } -- integer length in [T; N]
  else {
    if tag == 2 { 1 }
    else {
      if tag == 6 { 1 }
      else {
        if tag == 11 { 1 }
        else {
          if tag == 12 { 1 }
          else {
            if tag == 3 {
              -- keyword `mut` for pointer types: *mut T
              if v1 == 5 { 1 } else { 0 }
            }
            else {
              if tag == 4 {
                -- < > nest; * heads pointer types (*mut i64); .. opens a record shape.
                if v1 == 7 { 1 } else {
                  if v1 == 8 { 1 } else { if v1 == 3 { 1 } else { if v1 == 20 { 1 } else { 0 } } }
                }
              }
              else {
                if tag == 5 {
                  if v1 == 1 { 1 }
                  else {
                    if v1 == 2 { 1 }
                    else {
                      if v1 == 3 { 1 } -- { in structural record types
                      else {
                        if v1 == 4 { 1 } -- }
                        else {
                          if v1 == 5 { 1 }
                          else {
                            if v1 == 6 or v1 == 8 { 1 } -- record field separator or T.Item projection
                            else {
                              if v1 == 9 { 1 }
                              else {
                                if v1 == 10 { 1 }
                                else {
                                  if v1 == 11 { 1 }
                                  else {
                                    if v1 == 12 { 1 }
                                    else {
                                      if v1 == 13 { 1 } -- ; in [T; N]
                                      else {
                                        if v1 == 14 { 1 } -- ]
                                        else { if v1 == 17 { 1 } else { 0 } }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                } else { 0 }
              }
            }
          }
        }
      }
    }
  }
}

pub(package) fn is_type_arg_start(toks: i64, pos: i64) -> i64 {
  let mut p = pos + 1
  let mut depth = 1
  let mut ok = 0
  let mut done = 0
  while done == 0 {
    let tag = tok_tag(toks, p)
    let v1 = tok_v1(toks, p)
    if tag == 7 { done = 1 }
    else {
      if is_type_arg_token(tag, v1) == 0 { done = 1 }
      else {
        if tag == 4 {
          if v1 == 7 { depth = depth + 1 p = p + 1 }
          else {
            if v1 == 8 {
              depth = depth - 1
              if depth == 0 {
                done = 1
                ok = if tok_tag(toks, p + 1) == 5 {
                  -- Generic value calls use `(`; qualified effect references use
                  -- `.` (`State<S>.get()`). Both make the angle list unambiguous.
                  let next = tok_v1(toks, p + 1)
                  if next == 1 or next == 8 or next == 3 { 1 } else { 0 }
                } else { 0 }
              } else { p = p + 1 }
            } else { p = p + 1 }
          }
        } else { p = p + 1 }
      }
    }
  }
  ok
}

pub(package) type SyntaxParse<T> {
  syntax: T,
  next: i64
}

type FunctionReturnSyntax {
  result: TypeExpr,
  effects: EffectSig
}

fn syntax_parse<T>(syntax: T, next: i64) -> SyntaxParse<T> {
  SyntaxParse { syntax: syntax, next: next }
}

-- Type parameters visible while a declaration body is parsed. Nested
-- annotations, generic call arguments, lambda parameters, handler clause
-- parameters and interpolated expressions resolve type-variable names against
-- this scope, so resolution never depends on which token buffer is read.
pub(package) effect TypeParameterScope {
  fn current() -> TypeParamList
}

fn parse_expr_list_reverse(items: ExprList) -> ExprList {
  let mut remaining = items
  let mut result = ExprListNil
  loop {
    match remaining {
      ExprListNil -> break
      ExprListCons(item, rest) -> {
        result = ExprListCons(item, result)
        remaining = rest
      }
    }
  }
  result
}

fn parse_record_field_list_reverse(items: RecordFieldList) -> RecordFieldList {
  let mut remaining = items
  let mut result = RecordFieldListNil
  loop {
    match remaining {
      RecordFieldListNil -> break
      RecordFieldListCons(item, rest) -> {
        result = RecordFieldListCons(item, result)
        remaining = rest
      }
    }
  }
  result
}

fn parse_match_arm_list_reverse(items: MatchArmList) -> MatchArmList {
  let mut remaining = items
  let mut result = MatchArmListNil
