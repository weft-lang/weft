-- Stable source-vocabulary projection from the segmented semantic type graph.
--
-- Exact retained declarations decide identity. RegistrationScope contributes
-- only the spelling visible from the consuming module; no raw checker table,
-- source pointer, name hash or DNF storage crosses the fact boundary.

use compiler/project/identity.{
  AnonymousModuleIdentity,
  DeclarationIdentity,
  MemberDeclarationIdentity,
  ModuleDeclarationIdentity,
  ModuleIdentity,
  NamedModuleIdentity,
  declaration_identity_name
}
use compiler/project/identity/equality.{module_identity_eq}
use compiler/types/graph.{*}
use compiler/types/graph/catalog.{SemanticTypeCatalog}
use compiler/weft/check/registration/scope.{
  RegistrationScope,
  registration_scope_declaration_spelling_is_unique,
  registration_scope_module_alias,
  registration_scope_visible_declaration_spelling
}
use stdlib/list.{Cons, List, Nil}
use stdlib/num/scalar.{num_scalar_usize_to_i64}
use stdlib/option.{None, Option, Some}
use stdlib/semantic_type as semantic_fact
use stdlib/semantic_type.{
  SemanticEffectAtom,
  SemanticEffectAtomFact,
  SemanticEffectAtomFactList,
  SemanticEffectAtomFactListCons,
  SemanticEffectAtomFactListNil,
  SemanticEffectAtomOther,
  SemanticEffectSetFact,
  SemanticEffectsClosed,
  SemanticEffectsOpen,
  SemanticEffectsOther,
  SemanticQualifiedEffectAtom,
  SemanticRecordField,
  SemanticRecordFieldFactList,
  SemanticRecordFieldFactListCons,
  SemanticRecordFieldFactListNil,
  SemanticRecordFieldOther,
  SemanticTypeArray,
  SemanticTypeAssociated,
  SemanticTypeBorrow,
  SemanticTypeBottom,
  SemanticTypeComplement,
  SemanticTypeContinuation,
  SemanticTypeFact,
  SemanticTypeFactList,
  SemanticTypeFactListCons,
  SemanticTypeFactListNil,
  SemanticTypeFunction,
  SemanticTypeIntersection,
  SemanticTypeNamed,
  SemanticTypeOther,
  SemanticTypeOwned,
  SemanticTypePointer,
  SemanticTypePrimitive,
  SemanticTypeQualifiedNamed,
  SemanticTypeQualifiedTrait,
  SemanticTypeRecord,
  SemanticTypeSlice,
  SemanticTypeTop,
  SemanticTypeTrait,
  SemanticTypeUnion,
  SemanticTypeUnique,
  SemanticTypeWeak
}

pub(package) type SemanticTypeProjectionContext = opaque(
  ModuleIdentity,
  RegistrationScope,
  List<str>
)

pub(package) fn semantic_type_projection_context(
  caller: ModuleIdentity,
  registrations: RegistrationScope,
  parameter_names: List<str>
) -> SemanticTypeProjectionContext {
  SemanticTypeProjectionContext((caller, registrations, parameter_names))
}

fn semantic_projection_caller(
  context: borrow SemanticTypeProjectionContext
) -> ModuleIdentity {
  match context {
    SemanticTypeProjectionContext((caller, registrations, parameter_names)) -> caller
  }
}

fn semantic_projection_registrations(
  context: borrow SemanticTypeProjectionContext
) -> RegistrationScope {
  match context {
    SemanticTypeProjectionContext((caller, registrations, parameter_names)) -> registrations
  }
}

fn semantic_projection_parameter_names(
  context: borrow SemanticTypeProjectionContext
) -> List<str> {
  match context {
    SemanticTypeProjectionContext((caller, registrations, parameter_names)) -> parameter_names
  }
}

fn semantic_projection_declaration_name(declaration: DeclarationIdentity) -> str {
  match declaration_identity_name(declaration).text() {
    Some(name) -> name
    None -> "unknown"
  }
}

fn semantic_projection_declaration_module(
  declaration: DeclarationIdentity
) -> Option<ModuleIdentity> {
  match declaration {
    ModuleDeclarationIdentity(module, _, _) -> Some<ModuleIdentity>(module)
    MemberDeclarationIdentity(owner, _, _) ->
      semantic_projection_declaration_module(owner)
  }
}

fn semantic_projection_module_path(module: ModuleIdentity) -> Option<str> {
  match module {
    NamedModuleIdentity(path, _) -> Some<str>(path)
    AnonymousModuleIdentity(_, _) -> None<str>()
  }
}

fn semantic_projection_visible_name(
  context: borrow SemanticTypeProjectionContext,
  declaration: DeclarationIdentity
) -> Option<str> {
  registration_scope_visible_declaration_spelling(
    semantic_projection_registrations(context),
    semantic_projection_caller(context),
    declaration
  )
}

fn semantic_projection_module_alias(
  context: borrow SemanticTypeProjectionContext,
  declaration: DeclarationIdentity
) -> Option<str> {
  match semantic_projection_declaration_module(declaration) {
    Some(module) -> registration_scope_module_alias(
      semantic_projection_registrations(context),
      semantic_projection_caller(context),
      module
    )
    None -> None<str>()
  }
}

fn semantic_projection_declaration_is_local(
  context: borrow SemanticTypeProjectionContext,
  declaration: DeclarationIdentity
) -> bool {
  match semantic_projection_declaration_module(declaration) {
    Some(module) -> module_identity_eq(module, semantic_projection_caller(context))
    None -> false
  }
}

fn semantic_projection_parameter_name_from(
  names: List<str>,
  wanted: usize,
  offset: usize
) -> str {
  match names {
    Nil -> "unknown"
    Cons(name, rest) -> if offset == wanted { name }
    else { semantic_projection_parameter_name_from(rest, wanted, offset + 1) }
  }
}

fn semantic_projection_parameter_name(
  context: borrow SemanticTypeProjectionContext,
  variable: SemanticTypeVariable
) -> str {
  match variable {
    SemanticSelfVariable -> "Self"
    SemanticParameterVariable(id) -> semantic_projection_parameter_name_from(
      semantic_projection_parameter_names(context),
      id,
      0
    )
  }
}

fn semantic_projection_primitive_name(primitive: SemanticPrimitive) -> str {
  match primitive {
    SemanticI64 -> "i64"
    SemanticStr -> "str"
    SemanticBool -> "bool"
    SemanticNil -> "nil"
    SemanticF64 -> "f64"
    SemanticI32 -> "i32"
    SemanticI8 -> "i8"
    SemanticI16 -> "i16"
    SemanticU8 -> "u8"
    SemanticU16 -> "u16"
    SemanticU32 -> "u32"
    SemanticU64 -> "u64"
    SemanticIsize -> "isize"
    SemanticUsize -> "usize"
    SemanticF32 -> "f32"
  }
}

fn semantic_projection_mutable(mutability: SemanticMutability) -> bool {
  match mutability {
    SemanticImmutable -> false
    SemanticMutable -> true
  }
}

fn semantic_projection_named(
  context: borrow SemanticTypeProjectionContext,
  declaration: DeclarationIdentity,
  arguments: SemanticTypeFactList
) -> SemanticTypeFact {
  match semantic_projection_visible_name(context, declaration) {
    Some(name) -> SemanticTypeNamed(name, arguments)
    None -> if semantic_projection_declaration_is_local(context, declaration) {
      SemanticTypeNamed(semantic_projection_declaration_name(declaration), arguments)
    } else {
      match semantic_projection_module_alias(context, declaration) {
        Some(alias) -> SemanticTypeQualifiedNamed(
          alias,
          semantic_projection_declaration_name(declaration),
          arguments
        )
        None -> SemanticTypeNamed(
          semantic_projection_declaration_name(declaration),
          arguments
        )
      }
    }
  }
}

fn semantic_projection_trait(
  context: borrow SemanticTypeProjectionContext,
  declaration: DeclarationIdentity
) -> SemanticTypeFact {
  match semantic_projection_visible_name(context, declaration) {
    Some(name) -> SemanticTypeTrait(name)
    None -> if semantic_projection_declaration_is_local(context, declaration) {
      SemanticTypeTrait(semantic_projection_declaration_name(declaration))
    } else {
      match semantic_projection_module_alias(context, declaration) {
        Some(alias) -> SemanticTypeQualifiedTrait(
          alias,
          semantic_projection_declaration_name(declaration)
        )
        None -> match semantic_projection_declaration_module(declaration) {
          Some(module) -> match semantic_projection_module_path(module) {
            Some(path) -> SemanticTypeQualifiedTrait(
              path,
              semantic_projection_declaration_name(declaration)
            )
            None -> SemanticTypeTrait(semantic_projection_declaration_name(declaration))
          }
          None -> SemanticTypeTrait(semantic_projection_declaration_name(declaration))
        }
      }
    }
  }
}

fn semantic_projection_effect_name(
  context: borrow SemanticTypeProjectionContext,
  declaration: DeclarationIdentity,
  arguments: SemanticTypeFactList
) -> SemanticEffectAtomFact {
  match semantic_projection_visible_name(context, declaration) {
    Some(name) -> SemanticEffectAtom(name, arguments)
    None -> if semantic_projection_declaration_is_local(context, declaration) or
      registration_scope_declaration_spelling_is_unique(
        semantic_projection_registrations(context),
        declaration
      ) {
        SemanticEffectAtom(
          semantic_projection_declaration_name(declaration),
          arguments
        )
      } else {
        match semantic_projection_declaration_module(declaration) {
          Some(module) -> match semantic_projection_module_path(module) {
            Some(path) -> SemanticQualifiedEffectAtom(
              path,
              semantic_projection_declaration_name(declaration),
              arguments
            )
            None -> SemanticEffectAtom(
              semantic_projection_declaration_name(declaration),
              arguments
            )
          }
          None -> SemanticEffectAtom(
            semantic_projection_declaration_name(declaration),
            arguments
          )
        }
      }
  }
}

fn semantic_projection_graph(
  catalog: borrow SemanticTypeCatalog,
  id: SemanticTypeId
) -> Option<SemanticTypeGraph> {
  match catalog.graph_for(id) {
    Some(graph) -> if semantic_type_graph_contains(graph, id) {
      Some<SemanticTypeGraph>(graph)
    } else { None<SemanticTypeGraph>() }
    None -> None<SemanticTypeGraph>()
  }
}

fn semantic_projection_type_list_from(
  catalog: borrow SemanticTypeCatalog,
  context: borrow SemanticTypeProjectionContext,
  graph: borrow SemanticTypeGraph,
  list: SemanticTypeListId,
  offset: usize
) -> SemanticTypeFactList {
  let lists = semantic_type_graph_type_lists_local(graph)
  if offset >= semantic_type_list_len(lists, list) {
    SemanticTypeFactListNil
  } else {
    SemanticTypeFactListCons(
      semantic_type_fact_from_graph(
        catalog,
        context,
        semantic_type_graph_list_type_id(
          graph,
          semantic_type_list_edge(lists, list, offset)
        )
      ),
      semantic_projection_type_list_from(
        catalog,
        context,
        graph,
        list,
        offset + 1
      )
    )
  }
}

fn semantic_projection_type_list(
  catalog: borrow SemanticTypeCatalog,
  context: borrow SemanticTypeProjectionContext,
  graph: borrow SemanticTypeGraph,
  list: SemanticTypeListId
) -> SemanticTypeFactList {
  semantic_projection_type_list_from(catalog, context, graph, list, 0)
}

fn semantic_projection_effect_atom(
  catalog: borrow SemanticTypeCatalog,
  context: borrow SemanticTypeProjectionContext,
  id: SemanticTypeId
) -> SemanticEffectAtomFact {
  match semantic_projection_graph(catalog, id) {
    Some(graph) -> match semantic_type_graph_node(graph, id) {
      SemanticEffectAtomNode(declaration, arguments) ->
        semantic_projection_effect_name(
          context,
          declaration,
          semantic_projection_type_list(catalog, context, graph, arguments)
        )
      _ -> SemanticEffectAtomOther("invalid_effect_atom")
    }
    None -> SemanticEffectAtomOther("missing")
  }
}

fn semantic_projection_effect_atoms_from(
  catalog: borrow SemanticTypeCatalog,
  context: borrow SemanticTypeProjectionContext,
  graph: borrow SemanticTypeGraph,
  list: SemanticTypeListId,
  offset: usize
) -> SemanticEffectAtomFactList {
  let lists = semantic_type_graph_type_lists_local(graph)
  if offset >= semantic_type_list_len(lists, list) {
    SemanticEffectAtomFactListNil
  } else {
    SemanticEffectAtomFactListCons(
      semantic_projection_effect_atom(
        catalog,
        context,
        semantic_type_graph_list_type_id(
          graph,
          semantic_type_list_edge(lists, list, offset)
        )
      ),
      semantic_projection_effect_atoms_from(
        catalog,
        context,
        graph,
        list,
        offset + 1
      )
    )
  }
}

fn semantic_projection_effects(
  catalog: borrow SemanticTypeCatalog,
  context: borrow SemanticTypeProjectionContext,
  effects: SemanticTypeId
) -> SemanticEffectSetFact {
  match semantic_projection_graph(catalog, effects) {
    Some(graph) -> match semantic_type_graph_node(graph, effects) {
      SemanticEffectSignatureNode(atoms, tail) -> {
        let facts = semantic_projection_effect_atoms_from(
          catalog,
          context,
          graph,
          atoms,
          0
        )
        match tail {
          SemanticClosedEffects -> SemanticEffectsClosed(facts)
          SemanticOpenEffects(variable) -> SemanticEffectsOpen(
            facts,
            semantic_projection_parameter_name(
              context,
              SemanticParameterVariable(variable)
            )
          )
        }
      }
      _ -> SemanticEffectsOther("invalid_effect_set")
    }
    None -> SemanticEffectsOther("invalid_effect_set")
  }
}

fn semantic_projection_record_fields_from(
  catalog: borrow SemanticTypeCatalog,
  context: borrow SemanticTypeProjectionContext,
  graph: borrow SemanticTypeGraph,
  fields: SemanticRecordFieldListId,
  offset: usize
) -> SemanticRecordFieldFactList {
  let records = semantic_type_graph_records_local(graph)
  if offset >= semantic_type_record_field_count(records, fields) {
    SemanticRecordFieldFactListNil
  } else {
    let edge = semantic_type_record_field_edge(records, fields, offset)
    let name = match semantic_type_graph_record_field_name(graph, edge) {
      SemanticNamedRecordField(value) -> value
      SemanticTupleRecordField(_) -> ""
    }
    let fact = match num_scalar_usize_to_i64(offset) {
      Some(position) -> SemanticRecordField(
        name,
        position,
        semantic_type_fact_from_graph(
          catalog,
          context,
          semantic_type_graph_record_field_type_id(graph, edge)
        )
      )
      None -> SemanticRecordFieldOther("index_out_of_range")
    }
    SemanticRecordFieldFactListCons(
      fact,
      semantic_projection_record_fields_from(
        catalog,
        context,
        graph,
        fields,
        offset + 1
      )
    )
  }
}

fn semantic_projection_record_open(openness: SemanticRecordOpenness) -> bool {
  match openness {
    SemanticClosedRecord -> false
    SemanticOpenRecord -> true
  }
}

fn semantic_projection_record_tuple(shape: SemanticRecordShape) -> bool {
  match shape {
    SemanticStructuralRecord -> false
    SemanticTupleRecord -> true
  }
}

pub(package) fn semantic_type_fact_from_graph(
  catalog: borrow SemanticTypeCatalog,
  context: borrow SemanticTypeProjectionContext,
  id: SemanticTypeId
) -> SemanticTypeFact {
  match semantic_projection_graph(catalog, id) {
    None -> SemanticTypeOther("missing")
    Some(graph) -> match semantic_type_graph_node(graph, id) {
      SemanticBottomNode -> SemanticTypeBottom
      SemanticTopNode -> SemanticTypeTop
      SemanticPrimitiveNode(primitive) -> SemanticTypePrimitive(
        semantic_projection_primitive_name(primitive)
      )
      SemanticUnionNode(left, right) -> SemanticTypeUnion(
        semantic_type_fact_from_graph(catalog, context, left),
        semantic_type_fact_from_graph(catalog, context, right)
      )
      SemanticIntersectionNode(left, right) -> SemanticTypeIntersection(
        semantic_type_fact_from_graph(catalog, context, left),
        semantic_type_fact_from_graph(catalog, context, right)
      )
      SemanticComplementNode(inner) -> SemanticTypeComplement(
        semantic_type_fact_from_graph(catalog, context, inner)
      )
      SemanticContinuationNode(input, result) -> SemanticTypeContinuation(
        semantic_type_fact_from_graph(catalog, context, input),
        semantic_type_fact_from_graph(catalog, context, result)
      )
      SemanticWeakNode(inner) -> SemanticTypeWeak(
        semantic_type_fact_from_graph(catalog, context, inner)
      )
      SemanticAtomicNode(_) -> SemanticTypeOther("promoted_atomic_managed")
      SemanticUniqueNode(inner) -> SemanticTypeUnique(
        semantic_type_fact_from_graph(catalog, context, inner)
      )
      SemanticOwnedNode(inner) -> SemanticTypeOwned(
        semantic_type_fact_from_graph(catalog, context, inner)
      )
      SemanticPointerNode(inner, mutability) -> SemanticTypePointer(
        semantic_type_fact_from_graph(catalog, context, inner),
        semantic_projection_mutable(mutability)
      )
      SemanticBorrowNode(inner, mutability) -> SemanticTypeBorrow(
        semantic_type_fact_from_graph(catalog, context, inner),
        semantic_projection_mutable(mutability)
      )
      SemanticSliceNode(inner, mutability) -> SemanticTypeSlice(
        semantic_type_fact_from_graph(catalog, context, inner),
        semantic_projection_mutable(mutability)
      )
      SemanticArrayNode(inner, length) -> match num_scalar_usize_to_i64(length) {
        Some(value) -> SemanticTypeArray(
          semantic_type_fact_from_graph(catalog, context, inner),
          value
        )
        None -> SemanticTypeOther("array_length_out_of_range")
      }
      SemanticFunctionNode(parameters, result, effects) -> SemanticTypeFunction(
        semantic_projection_type_list(catalog, context, graph, parameters),
        semantic_type_fact_from_graph(catalog, context, result),
        semantic_projection_effects(catalog, context, effects)
      )
      SemanticEffectAtomNode(_, _) -> SemanticTypeOther("unsupported")
      SemanticEffectSignatureNode(_, _) -> SemanticTypeOther(
        "effect_set_is_not_a_value_type"
      )
      SemanticNamedNode(declaration, _, _, arguments) -> semantic_projection_named(
        context,
        declaration,
        semantic_projection_type_list(catalog, context, graph, arguments)
      )
      SemanticRecordNode(fields, shape, openness) -> SemanticTypeRecord(
        semantic_projection_record_fields_from(
          catalog,
          context,
          graph,
          fields,
          0
        ),
        semantic_projection_record_open(openness),
        semantic_projection_record_tuple(shape)
      )
      SemanticVariantNode(_, _) -> SemanticTypeOther("unsupported")
      SemanticVariableNode(variable) -> semantic_fact.SemanticTypeVariable(
        semantic_projection_parameter_name(context, variable)
      )
      SemanticTraitNode(declaration) -> semantic_projection_trait(
        context,
        declaration
      )
      SemanticAssociatedNode(base, declaration) -> SemanticTypeAssociated(
        semantic_type_fact_from_graph(catalog, context, base),
        semantic_projection_declaration_name(declaration)
      )
    }
  }
}
