-- compiler/weft/facts/staging.weft -- staging sites as stable semantic facts
--
-- The checker records each call to the blessed staging primitive on its
-- table (see check/staging). This producer projects those records into the
-- Stable-tier fact `weft build`, artifact facts and tools consume: the call
-- and literal locations, the staged text, and the manifest export the type
-- argument resolved to, with the capability its manifest grants.

use compiler/package/manifest.{*}
use compiler/storage.{nlist_get, nlist_len}
use compiler/weft/check/staging.{*}
use compiler/diagnostic/location.{diagnostic_location_from_offsets}
use runtime/memory.{mem_load64_at}
use runtime/string.{runtime_str_from_bytes_copy}
use stdlib/diagnostic/schema.{DiagnosticLocation, DiagnosticSourceBuffer}
use stdlib/grammar/tooling/protocol.{ToolGrammar}
use stdlib/grammar/tooling/staging.{StagingCapability}
use stdlib/list.{List, Cons, Nil}

--- One staging site of a checked program.
pub type StagingSiteFact {
  --- The call to `embed<G>`.
  site: DiagnosticLocation,
  --- The staged literal, delimiters included.
  source: DiagnosticLocation,
  --- The staged text: exactly the literal's content bytes.
  text: str,
  --- The manifest export `G` resolved to: the canonical export when the
  --- declaration is exported under several names.
  export: ToolGrammar,
  --- The export's package version.
  version: str,
  --- The execution the export's manifest declares: `validate_only`,
  --- `typed_plan` or `runtime`.
  execution: str,
  --- What a build can stage for the site today, refined from `execution`.
  capability: StagingCapability
}

--- The compiler-internal lowering material of a verified staging site.
--- This is distinct from the Stable-tier site fact above: raw declaration
--- identities and byte views never cross the compiler boundary.
pub(package) type StagingLoweringMaterial {
  StagingLoweringUnavailable,
  StagingLoweringValidated(i64, i64, i64),
  StagingLoweringArtifact(i64, i64, i64, i64, i64, i64, i64)
}

fn text_view(ptr: i64, len: i64) -> str {
  if len <= 0 { "" } else { runtime_str_from_bytes_copy(ptr, len) }
}

fn site_fact(site: i64) -> StagingSiteFact {
  let src = staging_site_source(site)
  let export = staging_site_export(site)
  let identity = staging_site_identity(site)
  let manifest = pkg_identity_manifest(identity)
  StagingSiteFact {
    site: diagnostic_location_from_offsets(
      DiagnosticSourceBuffer(src),
      staging_site_call_start(site),
      staging_site_call_start(site) + staging_site_call_len(site)
    ),
    source: diagnostic_location_from_offsets(
      DiagnosticSourceBuffer(src),
      staging_site_token_start(site),
      staging_site_token_start(site) + staging_site_token_len(site)
    ),
    text: text_view(src + staging_site_content_start(site), staging_site_content_len(site)),
    -- The package is named as its manifest names it, exactly as the tool
    -- resolver names it; the checker's identity table has its own spelling.
    export: ToolGrammar {
      package_name: text_view(
        pkg_manifest_package_start(manifest),
        pkg_manifest_package_len(manifest)
      ),
      export: text_view(pkg_export_name_ptr(export), pkg_export_name_len(export)),
      module: text_view(pkg_export_module_ptr(export), pkg_export_module_len(export)),
      declaration: text_view(
        pkg_export_declaration_ptr(export),
        pkg_export_declaration_len(export)
      )
    },
    version: text_view(pkg_manifest_version_ptr(manifest), pkg_manifest_version_len(manifest)),
    execution: pkg_export_execution_name(pkg_export_execution(export)),
    capability: pkg_export_capability(export)
  }
}

--- The staging sites of a checked program, in check order.
pub(package) fn staging_site_facts(tt: i64) -> List<StagingSiteFact> {
  let sites = ttable_staging_sites(tt)
  if sites == 0 { Nil<StagingSiteFact>() } else {
    let mut facts = Nil<StagingSiteFact>()
    let mut index = nlist_len(sites)
    while index > 0 {
      index = index - 1
      facts = Cons(site_fact(nlist_get(sites, index)), facts)
    }
    facts
  }
}

pub(package) fn staging_site_record_count(tt: i64) -> i64 {
  let sites = ttable_staging_sites(tt)
  if sites == 0 { 0 } else { nlist_len(sites) }
}

--- Attach one verified result to the exact checker-produced site at `index`.
--- The source identity and call offset prevent an ordered response from being
--- applied to another module's coincidentally equal byte range.
pub(package) fn staging_site_materialize(
  tt: i64,
  index: i64,
  source: i64,
  call_start: i64,
  kind: i64,
  source_name: str,
  digest: str,
  hex: str
) -> bool {
  let sites = ttable_staging_sites(tt)
  if sites == 0 or index < 0 or index >= nlist_len(sites) { false } else {
    let site = nlist_get(sites, index)
    if staging_site_source(site) != source or staging_site_call_start(site) != call_start {
      false
    } else {
      staging_site_set_material(site, kind, source_name, digest, hex)
      staging_site_material_decl(tt, site) != 0
    }
  }
}

--- Resolve the lowering material for a generic call from its semantic site
--- fact. The pipeline consumes this typed view and never reads checker
--- storage fields itself.
pub(package) fn staging_lowering_material_find(
  tt: i64,
  source: i64,
  call_start: i64
) -> StagingLoweringMaterial {
  let site = ttable_staging_site_find(tt, source, call_start)
  let declaration = if site == 0 { 0 } else { staging_site_material_decl(tt, site) }
  if declaration == 0 { StagingLoweringUnavailable } else {
    if staging_site_material_kind(site) == 1 {
      StagingLoweringValidated(
        declaration,
        staging_site_material_source_ptr(site),
        staging_site_material_source_len(site)
      )
    } else {
      if staging_site_material_kind(site) == 2 {
        StagingLoweringArtifact(
          declaration,
          staging_site_material_source_ptr(site),
          staging_site_material_source_len(site),
          staging_site_material_digest_ptr(site),
          staging_site_material_digest_len(site),
          staging_site_material_hex_ptr(site),
          staging_site_material_hex_len(site)
        )
      } else { StagingLoweringUnavailable }
    }
  }
}
