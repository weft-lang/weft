-- Canonical answers to compiler-owned storage-layout queries. Declaration
-- identity grants query semantics; ordinary same-spelled functions do not.
use compiler/backend/aarch64/codegen.{*}
use compiler/ir/data.{*}
use compiler/storage.{*}
use compiler/project/module.{*}
use compiler/weft/check/body.{typeck_decl_identity_is}
use compiler/weft/check/table.{str_hash}
use compiler/types/algebra.{*}
use stdlib/map as map
use stdlib/map.{Map}
use stdlib/option.{Option, Some, None}

pub(package) type LayoutQuery {
  VectorElementSize, VectorElementMode, VectorLeafCount,
  VectorLeafStride, VectorLeafKind, MapCleanupKind
}

pub(package) type LayoutQueryFact {
  LayoutQueryResolved(LayoutQuery, TypeExpr, i64),
  LayoutQueryUnavailable
}

pub(package) fn layout_query_name(query: LayoutQuery) -> str {
  match query {
    VectorElementSize -> "vector_element_size_of"
    VectorElementMode -> "vector_element_mode_of"
    VectorLeafCount -> "vector_element_leaf_count_of"
    VectorLeafStride -> "vector_element_leaf_stride_of"
    VectorLeafKind -> "vector_element_leaf_kind_of"
    MapCleanupKind -> "map_storage_cleanup_kind_of"
  }
}

pub(package) fn layout_query_module(query: LayoutQuery) -> str {
  match query {
    MapCleanupKind -> "runtime/map_storage"
    VectorElementSize -> "stdlib/vector"
    VectorElementMode -> "stdlib/vector"
    VectorLeafCount -> "stdlib/vector"
    VectorLeafStride -> "stdlib/vector"
    VectorLeafKind -> "stdlib/vector"
  }
}

pub(package) fn layout_query_name_hash(query: LayoutQuery) -> i64 {
  let name = layout_query_name(query)
  str_hash(__str_ptr(name), 0, __str_len(name))
}

pub(package) fn layout_query_native_key(query: LayoutQuery) -> i64 {
  let name = match query {
    VectorElementSize -> "stdlib/vector::vector_element_size_of#native"
    VectorElementMode -> "stdlib/vector::vector_element_mode_of#native"
    VectorLeafCount -> "stdlib/vector::vector_element_leaf_count_of#native"
    VectorLeafStride -> "stdlib/vector::vector_element_leaf_stride_of#native"
    VectorLeafKind -> "stdlib/vector::vector_element_leaf_kind_of#native"
    MapCleanupKind -> "runtime/map_storage::map_storage_cleanup_kind_of#native"
  }
  str_hash(__str_ptr(name), 0, __str_len(name))
}

pub(package) fn layout_query_from_declaration(declaration: i64, name_hash: i64) -> Option<LayoutQuery> {
  -- Most declarations cannot be a query. The spelling gate avoids inspecting
  -- module identity until a query name is present; spelling alone proves
  -- nothing and never reaches the lowering consumer.
  let query = match name_hash {
    hash if hash == layout_query_name_hash(VectorElementSize) -> Some(VectorElementSize)
    hash if hash == layout_query_name_hash(VectorElementMode) -> Some(VectorElementMode)
    hash if hash == layout_query_name_hash(VectorLeafCount) -> Some(VectorLeafCount)
    hash if hash == layout_query_name_hash(VectorLeafStride) -> Some(VectorLeafStride)
    hash if hash == layout_query_name_hash(VectorLeafKind) -> Some(VectorLeafKind)
    hash if hash == layout_query_name_hash(MapCleanupKind) -> Some(MapCleanupKind)
    _ -> None<LayoutQuery>()
  }
  match query {
    Some(kind) if typeck_decl_identity_is(declaration, layout_query_module(kind), layout_query_name(kind)) == 1 -> query
    _ -> None<LayoutQuery>()
  }
}

pub(package) fn layout_query_from_native_key(hash: i64) -> Option<LayoutQuery> {
  match hash {
    key if key == layout_query_native_key(VectorElementSize) -> Some(VectorElementSize)
    key if key == layout_query_native_key(VectorElementMode) -> Some(VectorElementMode)
    key if key == layout_query_native_key(VectorLeafCount) -> Some(VectorLeafCount)
    key if key == layout_query_native_key(VectorLeafStride) -> Some(VectorLeafStride)
    key if key == layout_query_native_key(VectorLeafKind) -> Some(VectorLeafKind)
    key if key == layout_query_native_key(MapCleanupKind) -> Some(MapCleanupKind)
    _ -> None<LayoutQuery>()
  }
}

pub(package) fn layout_query_native_keys() -> Map<i64, LayoutQuery> {
  let mut keys = map.new<i64, LayoutQuery>()
  for query in [VectorElementSize, VectorElementMode, VectorLeafCount, VectorLeafStride, VectorLeafKind, MapCleanupKind] {
    keys = keys.insert(layout_query_native_key(query), query)
  }
  keys
}

pub(package) fn layout_query_type_resolved(ty: TypeExpr) -> bool {
  match ty {
    MissingTypeExpr -> false
    VariableTypeExpr(_) -> false
    UnsupportedTypeExpr(_) -> false
    AssociatedTypeExpr(_, _) -> false
    SourceAssociatedTypeExpr(_, _, _) -> false
    QualifiedEffectTypeExpr(_, _, _) -> false
    ResolvedTraitTypeExpr(_) -> false
    QualifiedTraitTypeExpr(_, _) -> false
    UnqualifiedTraitTypeExpr(_, _) -> false
    ConstraintTypeExpr(_, _) -> false
    AssociatedBindingTypeExpr(_, _, _) -> false
    UnknownTypeExpr(_) -> false
    _ -> layout_query_types_resolved(type_expr_children(ty))
  }
}

pub(package) fn layout_query_types_resolved(types: TypeExprList) -> bool {
  match types {
    TypeExprListNil -> true
    TypeExprListCons(ty, rest) -> layout_query_type_resolved(ty) and layout_query_types_resolved(rest)
  }
}

-- These are the existing trusted storage-ABI answers, including its explicit
-- fallback conventions. Both early facts and final emission use this oracle.
-- A fallback at emission does not license an early fact for unresolved types.
pub(package) fn layout_query_value(query: LayoutQuery, ty: i64, tt: i64) -> i64 {
  match query {
    VectorElementSize -> {
      let size = cg_layout_vector_element_size(tt, ty)
      if size < 0 { 8 } else { size }
    }
    VectorElementMode -> cg_layout_vector_element_mode(tt, ty)
    VectorLeafCount -> if ty != 0 and ty_is_array(ty) { cg_layout_array_leaf_count(ty) } else { 0 - 1 }
    VectorLeafStride -> {
      let count = if ty != 0 and ty_is_array(ty) { cg_layout_array_leaf_count(ty) } else { 0 }
      let stride = if count > 0 { cg_layout_array_leaf_stride(tt, ty) } else { 0 }
      if stride < 0 { 0 } else { stride }
    }
    VectorLeafKind -> {
      let count = if ty != 0 and ty_is_array(ty) { cg_layout_array_leaf_count(ty) } else { 0 }
      let kind = if count > 0 { cg_layout_array_leaf_drop_kind(tt, ty) } else { 0 }
      if kind < 0 { 0 } else { kind }
    }
    MapCleanupKind -> cg_managed_drop_kind_for_ty(ty)
  }
}

pub(package) fn layout_query_resolve(query: LayoutQuery, type_args: TypeExprList, value_args: IrValueList, tt: i64) -> LayoutQueryFact {
  if tt == 0 or ir_value_list_len(value_args) != 0 or type_expr_list_len(type_args) != 1 or
    not layout_query_types_resolved(type_args) { LayoutQueryUnavailable } else {
    let ty = type_expr_list_nth(type_args, 0)
    let node = type_expr_to_node(ty)
    if node == 0 or cg_layout_vector_element_size(tt, node) < 0 { LayoutQueryUnavailable }
    else { LayoutQueryResolved(query, ty, layout_query_value(query, node, tt)) }
  }
}
