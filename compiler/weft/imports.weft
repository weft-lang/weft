-- Project source orchestration over grammar-owned local syntax.
-- The project session retains source contents and all loaded dependencies.

use compiler/weft/grammar.{WeftParser, ParsedWeftSource, grammar_source_location}
use compiler/weft/check/declarations as declarations
use compiler/weft/check/registration/native.{retain_native_declarations}
use compiler/weft/check/registration/scope.{
  RegistrationBuilder,
  registration_builder,
  registration_builder_add,
  registration_builder_add_import,
  registration_builder_freeze,
  registration_builder_resolve_import,
  resolved_implicit_wildcard_import
}
use compiler/source/input.{
  SourceRequest,
  SourceLoadResult,
  SourceLoaded,
  SourceUnavailable,
  source_load_result,
  source_module_logical_path
}
use compiler/source/loading.{
  SourceLoader,
  SourceLoadScope,
  source_loader,
  source_loader_load,
  source_loader_owners,
  source_loader_retain
}
use compiler/weft/products.{LoadedModuleSyntax}
use compiler/source/owners as source_owners
use compiler/source/owners.{SourceOwners}
use compiler/weft/parse.{*}
use compiler/weft/syntax/imports.{*}
use compiler/weft/syntax/declarations.{ParsedModuleSyntax, SourceDeclaration}
use compiler/package/manifest.{*}
use compiler/sdk/source.{sdk_source_load_module}
use compiler/package/diagnostics.{
  package_diagnose_binding_trust_failure,
  package_diagnose_native_target_missing,
  package_diagnose_resolve_failure
}
use compiler/weft/check/table.{*}
use compiler/diagnostic/location.{diagnostic_location_from_offsets}
use compiler/diagnostic/observe.{observe_errors}
use runtime/alloc.{*}
use runtime/memory.{*}
use runtime/buffer.{*}
