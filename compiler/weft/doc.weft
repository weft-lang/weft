use stdlib/bytes.{bytes_storage}
use stdlib/option.{Option}
use stdlib/string/builder as builder
use stdlib/string/builder.{Builder}
use stdlib/vector as vector
use stdlib/semantic_type.{*}
use stdlib/string.{str_eq}
use stdlib/semantic_type/render.{semantic_type_effects_arrow, semantic_type_list_render}
use stdlib/option.{None, Some}

pub(package) fn docgen_append_trait_bounds(
  out: borrow mut Builder,
  bounds: SemanticTraitBoundFactList,
  first: bool
) -> nil {
  match bounds {
    SemanticTraitBoundFactListNil -> nil
    SemanticTraitBoundFactListCons(bound, rest) -> {
      if not first { out.append(" & ") } else { nil }
      match bound {
        SemanticTraitBound(name) -> out.append(name)
        SemanticTraitBoundWithAssociated(name, constraints) -> {
          out.append(name)
          out.append(" & {")
          docgen_append_assoc_constraints(out, constraints, true)
          out.append("}")
        }
        SemanticTraitBoundOther(name) -> out.append(name)
      }
      docgen_append_trait_bounds(out, rest, false)
    }
    SemanticTraitBoundFactListOther(name) -> {
      if not first { out.append(" & ") } else { nil }
      out.append(name)
    }
  }
  nil
}

pub(package) fn docgen_append_assoc_constraints(
  out: borrow mut Builder,
  constraints: SemanticAssociatedTypeConstraintFactList,
  first: bool
) -> nil {
  match constraints {
    SemanticAssociatedTypeConstraintFactListNil -> nil
    SemanticAssociatedTypeConstraintFactListCons(constraint, rest) -> {
      if not first { out.append(", ") } else { nil }
      match constraint {
        SemanticAssociatedTypeConstraint(name, ty) -> {
          out.append("type ")
          out.append(name)
          out.append(" = ")
          out.append(ty.render())
        }
        SemanticAssociatedTypeConstraintOther(name) -> out.append(name)
      }
      docgen_append_assoc_constraints(out, rest, false)
    }
    SemanticAssociatedTypeConstraintFactListOther(name) -> {
      if not first { out.append(", ") } else { nil }
      out.append(name)
    }
  }
  nil
}

pub(package) fn docgen_append_type_parameter(
  out: borrow mut Builder,
  parameter: SemanticTypeParameterFact
) -> nil {
  match parameter {
    SemanticTypeParameter(name, bounds) -> {
      out.append(name)
      match bounds {
        SemanticBoundsTraits(SemanticTraitBoundFactListNil) -> nil
        SemanticBoundsTraits(traits) -> {
          out.append(": ")
          docgen_append_trait_bounds(out, traits, true)
        }
        SemanticBoundsUnknown -> nil
        SemanticBoundsTypeParameters(params) -> nil
        SemanticBoundsOther(name) -> { out.append(": ") out.append(name) }
      }
    }
    SemanticTypeParameterOther(name) -> out.append(name)
  }
  nil
}

pub(package) fn docgen_append_type_parameters_inner(
  out: borrow mut Builder,
  parameters: SemanticTypeParameterFactList,
  first: bool
) -> nil {
  match parameters {
    SemanticTypeParameterFactListNil -> nil
    SemanticTypeParameterFactListCons(parameter, rest) -> {
      if not first { out.append(", ") } else { nil }
      docgen_append_type_parameter(out, parameter)
      docgen_append_type_parameters_inner(out, rest, false)
    }
    SemanticTypeParameterFactListOther(name) -> {
      if not first { out.append(", ") } else { nil }
      out.append(name)
    }
  }
  nil
}

pub(package) fn docgen_append_type_parameters(
  out: borrow mut Builder,
  parameters: SemanticTypeParameterFactList
) -> nil {
  match parameters {
    SemanticTypeParameterFactListNil -> nil
    _ -> {
      out.append("<")
      docgen_append_type_parameters_inner(out, parameters, true)
      out.append(">")
    }
  }
  nil
}

pub(package) fn docgen_append_parameter(
  out: borrow mut Builder,
  parameter: SemanticParameterFact
) -> nil {
  match parameter {
    SemanticParameter(name, ty) -> { out.append(name) out.append(": ") out.append(ty.render()) }
    SemanticParameterOther(name) -> out.append(name)
  }
  nil
}

pub(package) fn docgen_append_parameters(
  out: borrow mut Builder,
  parameters: SemanticParameterFactList,
  first: bool
) -> nil {
  match parameters {
    SemanticParameterFactListNil -> nil
    SemanticParameterFactListCons(parameter, rest) -> {
      if not first { out.append(", ") } else { nil }
      docgen_append_parameter(out, parameter)
      docgen_append_parameters(out, rest, false)
    }
    SemanticParameterFactListOther(name) -> {
      if not first { out.append(", ") } else { nil }
      out.append(name)
    }
  }
  nil
}

pub(package) fn docgen_function_type_parameters(
  bounds: SemanticBoundsFact
) -> SemanticTypeParameterFactList {
  match bounds {
    SemanticBoundsTypeParameters(parameters) -> parameters
    _ -> SemanticTypeParameterFactListNil
  }
}

pub(package) fn docgen_append_function_fact_with_prefix(
  out: borrow mut Builder,
  fact: SemanticFunctionFact,
  prefix: str
) -> nil {
  match fact {
    SemanticFunction(name, parameters, result, effects, purity, ownership, shape, bounds) -> {
      out.append(prefix)
      out.append(name)
      docgen_append_type_parameters(out, docgen_function_type_parameters(bounds))
      out.append("(")
      docgen_append_parameters(out, parameters, true)
      out.append(")")
      out.append(semantic_type_effects_arrow(effects))
      out.append(result.render())
    }
    SemanticFunctionOther(name) -> { out.append(prefix) out.append(name) }
  }
  nil
}

pub(package) fn docgen_append_function_fact(
  out: borrow mut Builder,
  fact: SemanticFunctionFact
) -> nil {
  docgen_append_function_fact_with_prefix(out, fact, "pub fn ")
}

pub(package) fn docgen_append_function_fact_named(
  out: borrow mut Builder,
  fact: SemanticFunctionFact,
  name: str
) -> nil {
  match fact {
    SemanticFunction(name, parameters, result, effects, purity, ownership, shape, bounds) -> {
      out.append("pub fn ")
      out.append(name)
      docgen_append_type_parameters(out, docgen_function_type_parameters(bounds))
      out.append("(")
      docgen_append_parameters(out, parameters, true)
      out.append(")")
      out.append(semantic_type_effects_arrow(effects))
      out.append(result.render())
    }
    SemanticFunctionOther(name) -> { out.append("pub fn ") out.append(name) }
  }
  nil
}

pub(package) fn docgen_append_function_signature(
  out: borrow mut Builder,
  tt: i64,
  declaration: i64,
  storage: borrow RegistrationStorage
) -> nil {
  let functions = ttable_get_checked_functions(tt)
  let entry = if functions == 0 { 0 } else { ftypes_find_decl(functions, declaration) }
  match semantic_fact_function_entry(tt, entry, storage) {
    SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactFunction(fact))) -> {
      docgen_append_function_fact(out, fact)
      nil
    }
    _ -> nil
  }
}

pub(package) fn docgen_append_function_signature_named(
  out: borrow mut Builder,
  tt: i64,
  declaration: i64,
  name: str,
  storage: borrow RegistrationStorage
) -> nil {
  let functions = ttable_get_checked_functions(tt)
  let entry = if functions == 0 { 0 } else { ftypes_find_decl(functions, declaration) }
  match semantic_fact_function_entry(tt, entry, storage) {
    SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactFunction(fact))) -> {
      docgen_append_function_fact_named(out, fact, name)
      nil
    }
    _ -> nil
  }
}

pub(package) fn docgen_append_constant_signature(
  out: borrow mut Builder,
  tt: i64,
  declaration: i64,
  storage: borrow RegistrationStorage
) -> nil {
  let constant = module_decl_fact_constant_fact(declaration)
  if constant == 0 { nil }
  else {
    out.append("pub const ")
    out.append(module_decl_fact_name(declaration))
    out.append(": ")
    out.append(
      semantic_fact_type(
        module_constant_fact_declared_type(constant),
        tt,
        module_decl_fact_source(declaration),
        0,
        storage
      ).render()
    )
    nil
  }
}

pub(package) fn docgen_append_constant_signature_named(
  out: borrow mut Builder,
  tt: i64,
  declaration: i64,
  name: str,
  storage: borrow RegistrationStorage
) -> nil {
  let constant = module_decl_fact_constant_fact(declaration)
  if constant == 0 { nil }
  else {
    out.append("pub const ")
    out.append(name)
    out.append(": ")
    out.append(
      semantic_fact_type(
        module_constant_fact_declared_type(constant),
        tt,
        module_decl_fact_source(declaration),
        0,
        storage
      ).render()
    )
    nil
  }
}

pub(package) fn docgen_append_type_declaration_fact(
  out: borrow mut Builder,
  fact: SemanticTypeDeclarationFact
) -> nil {
  match fact {
    SemanticTypeDeclaration(name, kind, parameters, member_count) -> {
      match kind {
        SemanticTypeDeclarationTrait -> out.append("pub trait ")
        _ -> out.append("pub type ")
      }
      out.append(name)
      docgen_append_type_parameters(out, parameters)
      match kind {
        SemanticTypeDeclarationOpaque -> out.append(" = opaque")
        SemanticTypeDeclarationAlias(target) -> { out.append(" = ") out.append(target.render()) }
        _ -> nil
      }
    }
    SemanticTypeDeclarationOther(name) -> { out.append("pub type ") out.append(name) }
  }
  nil
}

pub(package) fn docgen_append_type_declaration_fact_named(
  out: borrow mut Builder,
  fact: SemanticTypeDeclarationFact,
  name: str
) -> nil {
  match fact {
    SemanticTypeDeclaration(name, kind, parameters, member_count) -> {
      match kind {
        SemanticTypeDeclarationTrait -> out.append("pub trait ")
        _ -> out.append("pub type ")
      }
      out.append(name)
      docgen_append_type_parameters(out, parameters)
      match kind {
        SemanticTypeDeclarationOpaque -> out.append(" = opaque")
        SemanticTypeDeclarationAlias(target) -> { out.append(" = ") out.append(target.render()) }
        _ -> nil
      }
    }
    SemanticTypeDeclarationOther(name) -> {
      out.append("pub type ")
      out.append(name)
    }
  }
  nil
}

pub(package) fn docgen_append_record_declaration_fields(
  out: borrow mut Builder,
  fields: SemanticRecordFieldFactList
) -> nil {
  match fields {
    SemanticRecordFieldFactListNil -> nil
    SemanticRecordFieldFactListCons(field, rest) -> {
      out.append("  ")
      match field {
        SemanticRecordField(name, index, ty) -> {
          out.append(name)
          out.append(": ")
          out.append(ty.render())
        }
        SemanticRecordFieldOther(name) -> out.append(name)
      }
      match rest { SemanticRecordFieldFactListNil -> out.append("\n") _ -> out.append(",\n") }
      docgen_append_record_declaration_fields(out, rest)
    }
    SemanticRecordFieldFactListOther(name) -> {
      out.append("  ")
      out.append(name)
      out.append("\n")
    }
  }
  nil
}

pub(package) fn docgen_append_variant_declaration_items(
  out: borrow mut Builder,
  variants: SemanticVariantDeclarationFactList
) -> nil {
  match variants {
    SemanticVariantDeclarationFactListNil -> nil
    SemanticVariantDeclarationFactListCons(variant, rest) -> {
      out.append("  ")
      match variant {
        SemanticVariantDeclaration(name, payloads) -> {
          out.append(name)
          match payloads {
            SemanticTypeFactListNil -> nil
            _ -> {
              out.append("(")
              out.append(semantic_type_list_render(payloads))
              out.append(")")
            }
          }
        }
        SemanticVariantDeclarationOther(name) -> out.append(name)
      }
      match rest {
        SemanticVariantDeclarationFactListNil -> out.append("\n")
        _ -> out.append(",\n")
      }
      docgen_append_variant_declaration_items(out, rest)
    }
    SemanticVariantDeclarationFactListOther(name) -> {
      out.append("  ")
      out.append(name)
      out.append("\n")
    }
  }
  nil
}

pub(package) fn docgen_append_trait_member(
  out: borrow mut Builder,
  member: SemanticTraitMemberFact
) -> nil {
  out.append("  ")
  match member {
    SemanticTraitMethod(fact) -> docgen_append_function_fact_with_prefix(out, fact, "fn ")
    SemanticTraitAssociatedType(name, bounds) -> {
      out.append("type ")
      out.append(name)
      match bounds {
        SemanticTraitBoundFactListNil -> nil
        _ -> { out.append(": ") docgen_append_trait_bounds(out, bounds, true) }
      }
    }
    SemanticTraitMemberOther(name) -> out.append(name)
  }
  out.append("\n")
  nil
}

pub(package) fn docgen_append_trait_members(
  out: borrow mut Builder,
  members: SemanticTraitMemberFactList
) -> nil {
  match members {
    SemanticTraitMemberFactListNil -> nil
    SemanticTraitMemberFactListCons(member, rest) -> {
      docgen_append_trait_member(out, member)
      docgen_append_trait_members(out, rest)
    }
    SemanticTraitMemberFactListOther(name) -> {
      out.append("  ")
      out.append(name)
      out.append("\n")
    }
  }
  nil
}

pub(package) fn docgen_append_type_signature(
  out: borrow mut Builder,
  tt: i64,
  declaration: i64,
  storage: borrow RegistrationStorage
) -> nil {
  let entry = ttable_lookup_decl_fact(tt, declaration)
  match semantic_fact_type_declaration_entry(entry, tt, storage) {
    SemanticFactEnvelope(
      SemanticFactSchemaV1,
      SemanticFactFound(SemanticFactTypeDeclaration(fact))
    ) ->
      {
        docgen_append_type_declaration_fact(out, fact)
        match fact {
          SemanticTypeDeclaration(name, SemanticTypeDeclarationRecord, parameters, member_count) ->
            {
              out.append(" {\n")
              docgen_append_record_declaration_fields(
                out,
                semantic_fact_record_declaration_fields(entry, tt, storage)
              )
              out.append("}")
            }
          SemanticTypeDeclaration(name, SemanticTypeDeclarationVariant, parameters, member_count) ->
            {
              out.append(" {\n")
              docgen_append_variant_declaration_items(
                out,
                semantic_fact_variant_declaration_items(entry, tt, storage)
              )
              out.append("}")
            }
          SemanticTypeDeclaration(name, SemanticTypeDeclarationTrait, parameters, member_count) ->
            {
              out.append(" {\n")
              docgen_append_trait_members(out, semantic_fact_trait_members(entry, tt, storage))
              out.append("}")
            }
          _ -> nil
        }
        nil
      }
    _ -> nil
  }
}

pub(package) fn docgen_append_type_signature_named(
  out: borrow mut Builder,
  tt: i64,
  declaration: i64,
  name: str,
  storage: borrow RegistrationStorage
) -> nil {
  let entry = ttable_lookup_decl_fact(tt, declaration)
  match semantic_fact_type_declaration_entry(entry, tt, storage) {
    SemanticFactEnvelope(
      SemanticFactSchemaV1,
      SemanticFactFound(SemanticFactTypeDeclaration(fact))
    ) ->
      {
        docgen_append_type_declaration_fact_named(out, fact, name)
        match fact {
          SemanticTypeDeclaration(name, SemanticTypeDeclarationRecord, parameters, member_count) ->
            {
              out.append(" {\n")
              docgen_append_record_declaration_fields(
                out,
                semantic_fact_record_declaration_fields(entry, tt, storage)
              )
              out.append("}")
            }
          SemanticTypeDeclaration(name, SemanticTypeDeclarationVariant, parameters, member_count) ->
            {
              out.append(" {\n")
              docgen_append_variant_declaration_items(
                out,
                semantic_fact_variant_declaration_items(entry, tt, storage)
              )
              out.append("}")
            }
          SemanticTypeDeclaration(name, SemanticTypeDeclarationTrait, parameters, member_count) ->
            {
              out.append(" {\n")
              docgen_append_trait_members(out, semantic_fact_trait_members(entry, tt, storage))
              out.append("}")
            }
          _ -> nil
        }
        nil
      }
    _ -> nil
  }
}

pub(package) fn docgen_append_effect_operation(
  out: borrow mut Builder,
  operation: SemanticEffectOperationFact
) -> nil {
  match operation {
    SemanticEffectOperation(name, parameters, result, deferred) -> {
      out.append("  ")
      if deferred { out.append("@deferred ") } else { nil }
      out.append("fn ")
      out.append(name)
      out.append("(")
      docgen_append_parameters(out, parameters, true)
      out.append(") -> ")
      out.append(result.render())
    }
    SemanticEffectOperationOther(name) -> { out.append("  fn ") out.append(name) }
  }
  nil
}

pub(package) fn docgen_append_effect_operations(
  out: borrow mut Builder,
  operations: SemanticEffectOperationFactList
) -> nil {
  match operations {
    SemanticEffectOperationFactListNil -> nil
    SemanticEffectOperationFactListCons(operation, rest) -> {
      docgen_append_effect_operation(out, operation)
      out.append("\n")
      docgen_append_effect_operations(out, rest)
    }
    SemanticEffectOperationFactListOther(name) -> {
      out.append("  ")
      out.append(name)
      out.append("\n")
    }
  }
  nil
}

pub(package) fn docgen_append_effect_fact(
  out: borrow mut Builder,
  fact: SemanticEffectDeclarationFact
) -> nil {
  match fact {
    SemanticEffectDeclaration(name, parameters, operations) -> {
      out.append("pub effect ")
      out.append(name)
      docgen_append_type_parameters(out, parameters)
      out.append(" ")
      out.append("{")
      out.append("\n")
      docgen_append_effect_operations(out, operations)
      out.append("}")
    }
    SemanticEffectDeclarationOther(name) -> { out.append("pub effect ") out.append(name) }
  }
  nil
}

pub(package) fn docgen_append_effect_fact_named(
  out: borrow mut Builder,
  fact: SemanticEffectDeclarationFact,
  name: str
