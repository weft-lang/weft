-- Doc comments are the `---` lines directly above a declaration. The legacy
-- tables keep only the declaration's position in its source, so the scan
-- reads a view of the source that ends at the declaration's name; every read
-- lies before it.
fn docgen_comment_view(declaration: i64) -> RawSourceView {
  let src = module_decl_fact_source(declaration)
  raw_source_view(src, module_decl_fact_name_ptr(declaration) - src)
}

fn docgen_line_break(byte: i64) -> bool { byte == 10 or byte == 13 }

-- The start of the line that holds `position`.
fn docgen_line_start(view: RawSourceView, position: i64) -> i64 {
  let mut start = position
  while start > 0 and not docgen_line_break(view.byte(start - 1)) { start = start - 1 }
  start
}

-- The line before the one starting at `line_start`, without its line break.
fn docgen_previous_line(view: RawSourceView, line_start: i64) -> (i64, i64) {
  let mut end = line_start
  if end > 0 and view.byte(end - 1) == 10 { end = end - 1 }
  if end > 0 and view.byte(end - 1) == 13 { end = end - 1 }
  (docgen_line_start(view, end), end)
}

-- Where a `---` line's text begins, after the marker and one space, or -1
-- when the line is not a doc comment.
fn docgen_doc_content_start(view: RawSourceView, start: i64, end: i64) -> i64 {
  let mut content = start
  while content < end and (view.byte(content) == 32 or view.byte(content) == 9) {
    content = content + 1
  }
  if content + 3 > end { return -1 }
  if view.byte(content) != 45 or view.byte(content + 1) != 45 or view.byte(content + 2) != 45 {
    return -1
  }
  content = content + 3
  if content < end and view.byte(content) == 32 { content + 1 } else { content }
}

-- The first line of the doc comment block above the declaration's line.
fn docgen_comment_first_line(view: RawSourceView) -> i64 {
  let mut line = docgen_line_start(view, view.byte_count())
  let mut first = line
  while line > 0 {
    let (start, end) = docgen_previous_line(view, line)
    if docgen_doc_content_start(view, start, end) < 0 { return first }
    first = start
    line = start
  }
  first
}

-- A preceding-line doc comment belongs to the declaration containing this
-- name, not merely to every semantic member whose name happens to share that
-- declaration's line. Delimiters before a member prove that another source
-- item has already begun on the line (for example `type T { Field }`).
fn docgen_comment_can_attach(view: RawSourceView) -> bool {
  let name_start = view.byte_count()
  for cursor in docgen_line_start(view, name_start)..name_start {
    let ch = view.byte(cursor)
    if ch == 44 or ch == 59 or ch == 123 or ch == 125 { return false }
  }
  true
}

fn docgen_has_comment(view: RawSourceView) -> bool {
  docgen_comment_can_attach(view) and
    docgen_comment_first_line(view) < docgen_line_start(view, view.byte_count())
}

-- Append the declaration's doc comment, a line per `---` line, and say
-- whether it had one.
fn docgen_append_comment(out: borrow mut Builder, view: RawSourceView) -> bool {
  let declaration_line = docgen_line_start(view, view.byte_count())
  let first = docgen_comment_first_line(view)
  if not docgen_comment_can_attach(view) or first >= declaration_line { return false }
  let mut line = first
  while line < declaration_line {
    let mut end = line
    while end < declaration_line and not docgen_line_break(view.byte(end)) { end = end + 1 }
    let content = docgen_doc_content_start(view, line, end)
    if content >= 0 {
      out.append(raw_source_view_text(view, content, end - content))
      out.append("\n")
    }
    while end < declaration_line and docgen_line_break(view.byte(end)) { end = end + 1 }
    line = end
  }
  true
}

pub(package) fn docgen_decl_is_public_root(declaration: i64, src: i64) -> bool {
  if declaration == 0 or module_decl_fact_source(declaration) != src or module_decl_fact_owner(
    declaration
  ) != 0 { false }
  else {
    if module_decl_fact_visibility_code(declaration) != module_visibility_public() { false }
    else {
      let namespace = module_decl_fact_namespace(declaration)
      namespace == module_decl_namespace_value() or namespace == module_decl_namespace_type() or
        namespace == module_decl_namespace_effect() or namespace == module_decl_namespace_trait()
    }
  }
}

pub(package) fn docgen_decl_is_documented_member_namespace(namespace: i64) -> bool {
  namespace == module_decl_namespace_record_field() or namespace ==
    module_decl_namespace_constructor() or namespace == module_decl_namespace_trait_method() or
    namespace == module_decl_namespace_associated_type() or namespace ==
    module_decl_namespace_effect_operation() or namespace ==
    module_decl_namespace_inherent_method()
}

pub(package) fn docgen_decl_is_public_api_item(declaration: i64, src: i64) -> bool {
  if docgen_decl_is_public_root(declaration, src) { true }
  else {
    if declaration == 0 or module_decl_fact_source(declaration) != src { false }
    else {
      let owner = module_decl_fact_owner(declaration)
      if owner == 0 {
        module_decl_fact_namespace(declaration) == module_decl_namespace_inherent_method() and
          module_decl_fact_visibility_code(declaration) == module_visibility_public()
      }
      else {
        if not docgen_decl_is_public_root(owner, src) or
          not docgen_decl_is_documented_member_namespace(module_decl_fact_namespace(declaration)) {
            false
          }
        else {
          if module_decl_fact_namespace(declaration) == module_decl_namespace_inherent_method() or
            module_decl_fact_namespace(declaration) == module_decl_namespace_effect_operation() {
              module_decl_fact_visibility_code(declaration) == module_visibility_public()
            } else { true }
        }
      }
    }
  }
}

pub(package) fn docgen_decl_is_public_primitive_method(declaration: i64, src: i64) -> bool {
  declaration != 0 and module_decl_fact_source(declaration) == src and
    module_decl_fact_owner(declaration) == 0 and
    module_decl_fact_namespace(declaration) == module_decl_namespace_inherent_method() and
    module_decl_fact_visibility_code(declaration) == module_visibility_public()
}

pub(package) fn docgen_decl_is_root_namespace(declaration: i64) -> bool {
  if declaration == 0 or module_decl_fact_owner(declaration) != 0 { false }
  else {
    let namespace = module_decl_fact_namespace(declaration)
    namespace == module_decl_namespace_value() or namespace == module_decl_namespace_type() or
      namespace == module_decl_namespace_effect() or namespace == module_decl_namespace_trait()
  }
}

pub(package) fn docgen_decl_is_nested_documentation_member(declaration: i64, owner: i64) -> bool {
  declaration != 0 and module_decl_fact_same_identity(module_decl_fact_owner(declaration), owner) ==
    1 and docgen_decl_is_documented_member_namespace(module_decl_fact_namespace(declaration)) and
    module_decl_fact_namespace(declaration) != module_decl_namespace_inherent_method() and (
      module_decl_fact_namespace(declaration) != module_decl_namespace_effect_operation() or
        module_decl_fact_visibility_code(declaration) == module_visibility_public()
    )
}

pub(package) fn docgen_decl_kind(declaration: i64) -> str {
  let namespace = module_decl_fact_namespace(declaration)
  if namespace == module_decl_namespace_value() {
    if module_decl_fact_constant_fact(declaration) != 0 { "Constant" } else { "Function" }
  }
  else {
    if namespace == module_decl_namespace_effect() { "Effect" }
    else {
      if namespace == module_decl_namespace_trait() { "Trait" }
      else { "Type" }
    }
  }
}

pub(package) fn docgen_append_decl_signature(
  out: borrow mut Builder,
  tt: i64,
  declaration: i64,
  storage: borrow RegistrationStorage
) -> nil {
  let namespace = module_decl_fact_namespace(declaration)
  if namespace == module_decl_namespace_value() {
    if module_decl_fact_constant_fact(declaration) != 0 {
      docgen_append_constant_signature(out, tt, declaration, storage)
    }
    else { docgen_append_function_signature(out, tt, declaration, storage) }
  }
  else {
    if namespace == module_decl_namespace_effect() {
      docgen_append_effect_signature(out, tt, declaration, storage)
    }
    else { docgen_append_type_signature(out, tt, declaration, storage) }
  }
}

pub(package) fn docgen_append_decl_signature_named(
  out: borrow mut Builder,
  tt: i64,
  declaration: i64,
  name: str,
  storage: borrow RegistrationStorage
) -> nil {
  let namespace = module_decl_fact_namespace(declaration)
  if namespace == module_decl_namespace_value() {
    if module_decl_fact_constant_fact(declaration) != 0 {
      docgen_append_constant_signature_named(out, tt, declaration, name, storage)
    }
    else {
      docgen_append_function_signature_named(out, tt, declaration, name, storage)
    }
  }
  else {
    if namespace == module_decl_namespace_effect() {
      docgen_append_effect_signature_named(out, tt, declaration, name, storage)
    }
    else { docgen_append_type_signature_named(out, tt, declaration, name, storage) }
  }
}

pub(package) fn docgen_declaration_has_comment(declaration: i64) -> bool {
  docgen_has_comment(docgen_comment_view(declaration))
}

pub(package) fn docgen_public_owned_item_count(tt: i64, owner: i64) -> i64 {
  1 + docgen_public_nested_member_count(tt, owner) +
    if module_decl_fact_namespace(owner) == module_decl_namespace_type() {
      docgen_public_inherent_method_count(tt, owner)
    } else { 0 }
}

pub(package) fn docgen_public_owned_documented_count(tt: i64, owner: i64) -> i64 {
  let mut count = if docgen_declaration_has_comment(owner) { 1 } else { 0 }
  for i in 0..module_fact_decl_count(tt) {
    let declaration = module_fact_decl_at(tt, i)
    let nested = docgen_decl_is_nested_documentation_member(declaration, owner)
    let method = module_decl_fact_same_identity(module_decl_fact_owner(declaration), owner) ==
      1 and
      module_decl_fact_namespace(declaration) == module_decl_namespace_inherent_method() and
      module_decl_fact_visibility_code(declaration) == module_visibility_public()
    if (nested or method) and docgen_declaration_has_comment(declaration) { count = count + 1 } else {
      0
    }
  }
  count
}

pub(package) fn docgen_reexported_public_count(
  tt: i64,
  src: i64,
  storage: borrow RegistrationStorage
) -> i64 {
  let mut count = 0
  let length = __u64_to_i64(
    __usize_to_u64(registration_storage_public_reexport_count(storage, src))
  )
  for i in 0..length {
    match registration_storage_public_reexport_at(storage, src, i) {
      Some(RegistrationReexport(_, identity)) -> {
        count = count +
          docgen_public_owned_item_count(tt, registration_storage_declaration(storage, identity))
      }
      None -> nil
    }
  }
  count
}

pub(package) fn docgen_reexported_documented_count(
  tt: i64,
  src: i64,
  storage: borrow RegistrationStorage
) -> i64 {
  let mut count = 0
  let length = __u64_to_i64(
    __usize_to_u64(registration_storage_public_reexport_count(storage, src))
  )
  for i in 0..length {
    match registration_storage_public_reexport_at(storage, src, i) {
      Some(RegistrationReexport(_, identity)) -> {
        count = count + docgen_public_owned_documented_count(
          tt,
          registration_storage_declaration(storage, identity)
        )
      }
      None -> nil
    }
  }
  count
}

pub(package) fn docgen_public_count(
  tt: i64,
  src: i64,
  storage: borrow RegistrationStorage
) -> i64 {
  let mut count = 0
  for i in 0..module_fact_decl_count(tt) {
    let declaration = module_fact_decl_at(tt, i)
    if docgen_decl_is_public_root(declaration, src) {
      count = count + docgen_public_owned_item_count(tt, declaration)
    } else {
      if docgen_decl_is_public_primitive_method(declaration, src) {
        count = count + 1
      } else { 0 }
    }
  }
  count + docgen_reexported_public_count(tt, src, storage)
}

pub(package) fn docgen_documented_count(
  tt: i64,
  src: i64,
  storage: borrow RegistrationStorage
) -> i64 {
  let mut count = 0
  for i in 0..module_fact_decl_count(tt) {
    let declaration = module_fact_decl_at(tt, i)
    if docgen_decl_is_public_root(declaration, src) {
      count = count + docgen_public_owned_documented_count(tt, declaration)
    } else {
      if docgen_decl_is_public_primitive_method(declaration, src) and
        docgen_declaration_has_comment(declaration) {
          count = count + 1
        } else { 0 }
    }
  }
  count + docgen_reexported_documented_count(tt, src, storage)
}

pub(package) fn docgen_public_nested_member_count(tt: i64, owner: i64) -> i64 {
  let mut count = 0
  for i in 0..module_fact_decl_count(tt) {
    if docgen_decl_is_nested_documentation_member(module_fact_decl_at(tt, i), owner) {
      count = count + 1
    } else { 0 }
  }
  count
}

pub(package) fn docgen_append_nested_member(
  out: borrow mut Builder,
  src: i64,
  declaration: i64
) -> nil {
  out.append("#### `")
  out.append(module_decl_fact_name(declaration))
  out.append("`\n\n")
  if not docgen_append_comment(out, docgen_comment_view(declaration)) {
    out.append("_Undocumented._\n")
  }
  out.append("\n")
  nil
}

pub(package) fn docgen_append_nested_members(
  out: borrow mut Builder,
  tt: i64,
  src: i64,
  owner: i64
) -> nil {
  if docgen_public_nested_member_count(tt, owner) == 0 { nil }
  else {
    out.append("### Members\n\n")
    for i in 0..module_fact_decl_count(tt) {
      let declaration = module_fact_decl_at(tt, i)
      if docgen_decl_is_nested_documentation_member(declaration, owner) {
        docgen_append_nested_member(out, src, declaration)
      } else { nil }
    }
    nil
  }
}

pub(package) fn docgen_append_declaration_named(
  out: borrow mut Builder,
  tt: i64,
  declaration: i64,
  name: str,
  storage: borrow RegistrationStorage
) -> nil {
  let declaration_src = module_decl_fact_source(declaration)
  out.append("## ")
  out.append(docgen_decl_kind(declaration))
  out.append(" `")
  out.append(name)
  out.append("`\n\n")
  if not docgen_append_comment(out, docgen_comment_view(declaration)) {
    out.append("_Undocumented._\n")
  }
  out.append("\n```weft\n")
  docgen_append_decl_signature_named(
    out,
    tt,
    declaration,
    name,
    storage
  )
  out.append("\n```\n\n")
  docgen_append_nested_members(out, tt, declaration_src, declaration)
  if module_decl_fact_namespace(declaration) == module_decl_namespace_type() {
    docgen_append_inherent_methods(out, tt, declaration_src, declaration, storage)
  } else { nil }
}

pub(package) fn docgen_append_declaration(
  out: borrow mut Builder,
  tt: i64,
  src: i64,
  declaration: i64,
  storage: borrow RegistrationStorage
) -> nil {
  docgen_append_declaration_named(
    out,
    tt,
    declaration,
    module_decl_fact_name(declaration),
    storage
  )
}

pub(package) fn docgen_public_inherent_method_count(tt: i64, owner: i64) -> i64 {
  let mut count = 0
  for i in 0..module_fact_decl_count(tt) {
    let declaration = module_fact_decl_at(tt, i)
    if module_decl_fact_same_identity(module_decl_fact_owner(declaration), owner) == 1 and
      module_decl_fact_namespace(declaration) == module_decl_namespace_inherent_method() and
      module_decl_fact_visibility_code(declaration) == module_visibility_public() {
        count = count + 1
      } else { 0 }
  }
  count
}

pub(package) fn docgen_append_inherent_method(
  out: borrow mut Builder,
  tt: i64,
  src: i64,
  declaration: i64,
  storage: borrow RegistrationStorage
) -> nil {
  out.append("#### `")
  out.append(module_decl_fact_name(declaration))
  out.append("`\n\n")
  if not docgen_append_comment(out, docgen_comment_view(declaration)) {
    out.append("_Undocumented._\n")
  }
  out.append("\n```weft\n")
  docgen_append_function_signature(out, tt, declaration, storage)
  out.append("\n```\n\n")
  nil
}

pub(package) fn docgen_append_inherent_methods(
  out: borrow mut Builder,
  tt: i64,
  src: i64,
  owner: i64,
  storage: borrow RegistrationStorage
) -> nil {
  if docgen_public_inherent_method_count(tt, owner) == 0 { nil }
  else {
    out.append("### Inherent methods\n\n")
    for i in 0..module_fact_decl_count(tt) {
      let declaration = module_fact_decl_at(tt, i)
      if module_decl_fact_same_identity(module_decl_fact_owner(declaration), owner) == 1 and
        module_decl_fact_namespace(declaration) == module_decl_namespace_inherent_method() and
        module_decl_fact_visibility_code(declaration) == module_visibility_public() {
          docgen_append_inherent_method(out, tt, src, declaration, storage)
        } else { nil }
    }
    nil
  }
}

pub(package) fn docgen_public_primitive_method_count(tt: i64, src: i64) -> i64 {
  let mut count = 0
  for i in 0..module_fact_decl_count(tt) {
    if docgen_decl_is_public_primitive_method(module_fact_decl_at(tt, i), src) {
      count = count + 1
    } else { 0 }
  }
  count
}

pub(package) fn docgen_append_primitive_method(
  out: borrow mut Builder,
  tt: i64,
  declaration: i64,
  storage: borrow RegistrationStorage
) -> nil {
  out.append("### `")
  out.append(module_decl_fact_name(declaration))
  out.append("`\n\n")
  if not docgen_append_comment(out, docgen_comment_view(declaration)) {
    out.append("_Undocumented._\n")
  }
  out.append("\n```weft\n")
  docgen_append_function_signature(out, tt, declaration, storage)
  out.append("\n```\n\n")
  nil
}

pub(package) fn docgen_append_primitive_methods(
  out: borrow mut Builder,
  tt: i64,
  src: i64,
  storage: borrow RegistrationStorage
) -> nil {
  if docgen_public_primitive_method_count(tt, src) == 0 { nil }
  else {
    out.append("## Primitive inherent methods\n\n")
    for i in 0..module_fact_decl_count(tt) {
      let declaration = module_fact_decl_at(tt, i)
      if docgen_decl_is_public_primitive_method(declaration, src) {
        docgen_append_primitive_method(out, tt, declaration, storage)
      } else { nil }
    }
    nil
  }
}

pub(package) fn docgen_append_reexported_declarations(
  out: borrow mut Builder,
  tt: i64,
  src: i64,
  storage: borrow RegistrationStorage
) -> nil {
  let length = __u64_to_i64(
    __usize_to_u64(registration_storage_public_reexport_count(storage, src))
  )
  for i in 0..length {
    match registration_storage_public_reexport_at(storage, src, i) {
      Some(RegistrationReexport(name, identity)) -> docgen_append_declaration_named(
        out,
        tt,
        registration_storage_declaration(storage, identity),
        name,
        storage
      )
      None -> nil
    }
  }
  nil
}

pub(package) fn docgen_has_public_root_name(
  tt: i64,
  src: i64,
  namespace: i64,
  name: str,
  storage: borrow RegistrationStorage
) -> bool {
  let mut found = false
  let mut i = 0
  while i < module_fact_decl_count(tt) and not found {
    let declaration = module_fact_decl_at(tt, i)
    if docgen_decl_is_public_root(declaration, src) and module_decl_fact_namespace(declaration) ==
      namespace and str_eq(module_decl_fact_name(declaration), name) == 1 {
        found = true
      } else { i = i + 1 }
  }
  if not found {
    let length = __u64_to_i64(
      __usize_to_u64(registration_storage_public_reexport_count(storage, src))
    )
    i = 0
    while i < length and not found {
      match registration_storage_public_reexport_at(storage, src, i) {
        Some(RegistrationReexport(spelling, identity)) -> {
          let declaration = registration_storage_declaration(storage, identity)
          if module_decl_fact_namespace(declaration) == namespace and str_eq(
            spelling,
            name
          ) == 1 { found = true }
          else { i = i + 1 }
        }
        None -> { i = i + 1 }
      }
    }
  } else { 0 }
  found
}

-- An anchor is the name with ASCII capitals lowered.
pub(package) fn docgen_append_anchor_name(out: borrow mut Builder, name: str) -> nil {
  let mut lowered = vector.new<u8>()
  let count: usize = name.len()
  let origin: usize = 0
  for index in origin..count {
    let byte = name.byte_at(index).unwrap_or(0)
    lowered.push(if byte >= 65 and byte <= 90 { byte + 32 } else { byte })
  }
  out.append(bytes_storage(bytes.from_vector(lowered)))
}

pub(package) fn docgen_append_local_reference(
  out: borrow mut Builder,
  kind: str,
  name: str
) -> nil {
  out.append("[`")
  out.append(name)
  out.append("`](#")
  out.append(kind)
  out.append("-")
  docgen_append_anchor_name(out, name)
  out.append(")")
  nil
}

pub(package) fn docgen_append_implementation_reference(
  out: borrow mut Builder,
  tt: i64,
  src: i64,
  ty: SemanticTypeFact,
  trait_reference: bool,
  storage: borrow RegistrationStorage
) -> nil {
  match ty {
    SemanticTypeTrait(name) -> {
      if trait_reference and docgen_has_public_root_name(
        tt,
        src,
        module_decl_namespace_trait(),
        name,
        storage
      ) {
        docgen_append_local_reference(out, "trait", name)
      } else { out.append("`") out.append(ty.render()) out.append("`") }
    }
    SemanticTypeNamed(name, args) -> {
      if not trait_reference and docgen_has_public_root_name(
        tt,
        src,
        module_decl_namespace_type(),
        name,
        storage
      ) {
        docgen_append_local_reference(out, "type", name)
      } else { out.append("`") out.append(ty.render()) out.append("`") }
    }
    _ -> { out.append("`") out.append(ty.render()) out.append("`") }
  }
  nil
}

pub(package) fn docgen_append_implementation(
  out: borrow mut Builder,
  tt: i64,
  src: i64,
  implementation: SemanticImplementationFact,
  storage: borrow RegistrationStorage
) -> nil {
  match implementation {
    SemanticTraitImplementation(parameters, trait_type, target_type) -> {
      out.append("- `impl")
      docgen_append_type_parameters(out, parameters)
      out.append(" ")
      out.append(trait_type.render())
      out.append(" for ")
      out.append(target_type.render())
      out.append("` — trait ")
      docgen_append_implementation_reference(out, tt, src, trait_type, true, storage)
      out.append(", target ")
      docgen_append_implementation_reference(out, tt, src, target_type, false, storage)
      out.append("\n")
    }
    SemanticImplementationOther(name) -> { out.append("- ") out.append(name) out.append("\n") }
  }
  nil
}

pub(package) fn docgen_append_implementations(
  out: borrow mut Builder,
  tt: i64,
  src: i64,
  implementations: SemanticImplementationFactList,
  storage: borrow RegistrationStorage
) -> nil {
  match implementations {
    SemanticImplementationFactListNil -> nil
    _ -> {
      out.append("## Trait implementations\n\n")
      let mut current = implementations
      let mut done = false
      while not done {
        match current {
          SemanticImplementationFactListNil -> { done = true }
          SemanticImplementationFactListCons(implementation, rest) -> {
            docgen_append_implementation(out, tt, src, implementation, storage)
            current = rest
          }
          SemanticImplementationFactListOther(name) -> {
            out.append("- ")
            out.append(name)
            out.append("\n")
            done = true
          }
        }
      }
      out.append("\n")
    }
  }
  nil
}

pub(package) fn docgen_render_module(typed: TypedModule, path: str) -> str {
  match typed {
    TypedModule(fns, src, tt, owners, registrations) -> {
      let storage = registration_storage(tt, registrations)
      let mut out = builder.new()
      out.append("# API: `")
      out.append(path)
      out.append("`\n\n_Generated from checked semantic facts. Do not edit._\n\n")
      out.append("Public API items: ")
      out.append(i"{docgen_public_count(tt, src, storage)}")
      out.append(". Documented: ")
      out.append(i"{docgen_documented_count(tt, src, storage)}")
      out.append(".\n\n")
      docgen_append_reexported_declarations(out, tt, src, storage)
      for i in 0..module_fact_decl_count(tt) {
        let declaration = module_fact_decl_at(tt, i)
        if docgen_decl_is_public_root(declaration, src) {
          docgen_append_declaration(out, tt, src, declaration, storage)
        } else { 0 }
      }
      docgen_append_primitive_methods(out, tt, src, storage)
      docgen_append_implementations(
        out,
        tt,
        src,
        semantic_fact_public_implementations_in_source(tt, src, storage),
        storage
      )
      out.finish()
    }
  }
}
