-- A root and its checked module closure share one typed registration scope.
-- Module segments retain their own semantic products without cloning imported
-- syntax or storing a second scope per module.

use compiler/project/identity.{
  DeclaredFunctionIdentity,
  FunctionIdentity,
  ModuleIdentity,
  declaration_identity_name
}
use compiler/project/identity/equality.{module_identity_eq}
use compiler/types/graph.{SemanticTypeId}
use compiler/types/graph/effects.{
  SemanticEffectfulFunction,
  SemanticFunctionShapeUnavailable,
  SemanticPureFunction,
  semantic_function_purity
}
use compiler/weft/check/body/installer.{CheckedModuleInstallerIssue}
use compiler/weft/check/checked_module.{
  CheckedModule,
  CheckedModuleAccepted,
  CheckedModuleBodyRejected,
  CheckedModuleResolutionRejected,
  CheckedModuleSegmentMismatch,
  check_registered_module_with_resolution
}
use compiler/weft/check/registration/scope.{
  RegistrationScope,
  ResolvedImport,
  ScopeIssue,
  registration_scope_at,
  registration_scope_find,
  registration_scope_import_at,
  registration_scope_import_count,
  registration_scope_issue_at,
  registration_scope_issue_count,
  registration_scope_len
}
use compiler/weft/check/registration/catalog.{RegisteredFunctionDeclaration}
use compiler/weft/check/storage.{dense_index}
use compiler/weft/check/resolution.{
  SemanticResolutionAccepted,
  SemanticResolutionIssue,
  SemanticResolutionRejected,
  resolve_module_semantics,
  resolve_module_semantics_with_shared
}
use stdlib/list.{Cons, List, Nil}
use stdlib/option.{None, Option, Some}

type CheckedProgramStorage {
  root: ModuleIdentity,
  scope: RegistrationScope,
  modules: List<CheckedModule>
}

pub(package) type CheckedProgram = opaque CheckedProgramStorage

pub(package) type CheckedProgramResult {
  CheckedProgramAccepted(CheckedProgram),
  CheckedProgramRootMissing,
  CheckedProgramImportTargetMissing(ResolvedImport),
  CheckedProgramScopeRejected(List<ScopeIssue>),
  CheckedProgramDuplicateModule(ModuleIdentity),
  CheckedProgramModuleResolutionRejected(ModuleIdentity, SemanticResolutionIssue),
  CheckedProgramModuleBodyRejected(ModuleIdentity, CheckedModuleInstallerIssue),
  CheckedProgramModuleSegmentMismatch(ModuleIdentity),
  CheckedProgramEntrypointRejected(CheckedModule, CheckedProgramEntrypointIssue)
}

pub(package) type CheckedProgramEntrypointIssue {
  CheckedProgramMainSignatureMissing(FunctionIdentity),
  CheckedProgramMainSignatureInvalid(FunctionIdentity),
  CheckedProgramMainEffectful(FunctionIdentity, SemanticTypeId)
}

fn checked_program_main_issue(module: CheckedModule) -> Option<CheckedProgramEntrypointIssue> {
  let registered = module.registered()
  let resolution = module.resolution()
  let signatures = resolution.signatures()
  let catalog = signatures.catalog()
  let declarations = registered.declarations
  let mut index: usize = 0
  while index < declarations.len() {
    let declaration = declarations.at(dense_index(index))
    match declaration.kind {
      RegisteredFunctionDeclaration(function) -> match function.identity {
        DeclaredFunctionIdentity(identity) -> match declaration_identity_name(identity).text() {
          Some(name) -> if name == "main" {
            match signatures.find(function.identity) {
              None -> return Some(
                CheckedProgramMainSignatureMissing(function.identity)
              )
              Some(signature) -> match semantic_function_purity(catalog, signature.type_id) {
                SemanticPureFunction -> nil
                SemanticEffectfulFunction(effects) -> return Some(
                  CheckedProgramMainEffectful(function.identity, effects)
                )
                SemanticFunctionShapeUnavailable -> return Some(
                  CheckedProgramMainSignatureInvalid(function.identity)
                )
              }
            }
          } else { nil }
          None -> return Some(CheckedProgramMainSignatureInvalid(function.identity))
        }
        _ -> nil
      }
      _ -> nil
    }
    index = index + 1
  }
  None<CheckedProgramEntrypointIssue>()
}

fn checked_program_contains_identity(
  identities: List<ModuleIdentity>,
  wanted: ModuleIdentity
) -> bool {
  match identities {
    Nil -> false
    Cons(identity, remaining) -> if module_identity_eq(identity, wanted) { true }
    else { checked_program_contains_identity(remaining, wanted) }
  }
}

fn checked_program_duplicate_module(scope: RegistrationScope) -> Option<ModuleIdentity> {
  let mut index: usize = 0
  let mut identities: List<ModuleIdentity> = Nil<ModuleIdentity>()
  while index < registration_scope_len(scope) {
    let module = registration_scope_at(scope, __u64_to_i64(__usize_to_u64(index)))
    if checked_program_contains_identity(identities, module.identity) {
      return Some(module.identity)
    }
    identities = identities.prepend(module.identity)
    index = index + 1
  }
  None<ModuleIdentity>()
}

fn checked_program_scope_issues(scope: RegistrationScope) -> List<ScopeIssue> {
  let mut index: usize = 0
  let mut issues: List<ScopeIssue> = Nil<ScopeIssue>()
  while index < registration_scope_issue_count(scope) {
    issues = issues.prepend(
      registration_scope_issue_at(scope, __u64_to_i64(__usize_to_u64(index)))
    )
    index = index + 1
  }
  issues.reverse()
}

pub(package) fn check_registered_program(
  root: ModuleIdentity,
  scope: RegistrationScope,
  sdk_package_id: i64
) -> CheckedProgramResult {
  match registration_scope_find(scope, root) {
    None -> CheckedProgramRootMissing
    Some(_) -> {
      let mut import_index: usize = 0
      while import_index < registration_scope_import_count(scope) {
        let edge = registration_scope_import_at(
          scope,
          __u64_to_i64(__usize_to_u64(import_index))
        )
        match registration_scope_find(scope, edge.target) {
          None -> return CheckedProgramImportTargetMissing(edge)
          Some(_) -> nil
        }
        import_index = import_index + 1
      }
      if registration_scope_issue_count(scope) != 0 {
        return CheckedProgramScopeRejected(checked_program_scope_issues(scope))
      }
      match checked_program_duplicate_module(scope) {
        Some(identity) -> return CheckedProgramDuplicateModule(identity)
        None -> nil
      }
      let root_module = registration_scope_find(scope, root).unwrap()
      let shared = match resolve_module_semantics(root_module, scope) {
        SemanticResolutionRejected(issue) -> return CheckedProgramModuleResolutionRejected(
          root,
          issue
        )
        SemanticResolutionAccepted(resolution) -> resolution
      }
      let mut index: usize = 0
      let mut modules: List<CheckedModule> = Nil<CheckedModule>()
      while index < registration_scope_len(scope) {
        let module = registration_scope_at(scope, __u64_to_i64(__usize_to_u64(index)))
        let resolved = if module_identity_eq(module.identity, root) {
          SemanticResolutionAccepted(shared)
        } else {
          resolve_module_semantics_with_shared(module, scope, shared)
        }
        match resolved {
          SemanticResolutionRejected(issue) -> return CheckedProgramModuleResolutionRejected(
            module.identity,
            issue
          )
          SemanticResolutionAccepted(resolution) -> match check_registered_module_with_resolution(
            module,
            scope,
            resolution,
            sdk_package_id
          ) {
            CheckedModuleResolutionRejected(issue) ->
              return
              CheckedProgramModuleResolutionRejected(module.identity, issue)
            CheckedModuleBodyRejected(issue) -> return
              CheckedProgramModuleBodyRejected(module.identity, issue)
            CheckedModuleSegmentMismatch -> return
              CheckedProgramModuleSegmentMismatch(module.identity)
            CheckedModuleAccepted(checked) -> { modules = modules.prepend(checked) }
          }
        }
        index = index + 1
      }
      let modules = modules.reverse()
      match checked_program_find_module(modules, root) {
        None -> CheckedProgramRootMissing
        Some(root_module) -> match checked_program_main_issue(root_module) {
          -- Retain the segment that owns the effect type named by the issue.
          Some(issue) -> CheckedProgramEntrypointRejected(root_module, issue)
          None -> CheckedProgramAccepted(
            CheckedProgram(CheckedProgramStorage { root: root, scope: scope, modules: modules })
          )
        }
      }
    }
  }
}

fn checked_program_find_module(
  modules: List<CheckedModule>,
  identity: ModuleIdentity
) -> Option<CheckedModule> {
  match modules {
    Nil -> None<CheckedModule>()
    Cons(module, remaining) -> if module_identity_eq(module.registered().identity, identity) {
      Some(module)
    } else { checked_program_find_module(remaining, identity) }
  }
}

impl CheckedProgram {
  pub(package) fn root(self: borrow Self) -> ModuleIdentity {
    match self { CheckedProgram(storage) -> storage.root }
  }

  pub(package) fn scope(self: borrow Self) -> RegistrationScope {
    match self { CheckedProgram(storage) -> storage.scope }
  }

  pub(package) fn module_count(self: borrow Self) -> usize {
    match self { CheckedProgram(storage) -> storage.modules.len() }
  }

  pub(package) fn module_at(self: borrow Self, index: usize) -> Option<CheckedModule> {
    match self { CheckedProgram(storage) -> storage.modules.get(index) }
  }

  pub(package) fn module(self: borrow Self, identity: ModuleIdentity) -> Option<CheckedModule> {
    match self {
      CheckedProgram(storage) -> checked_program_find_module(storage.modules, identity)
    }
  }
}
