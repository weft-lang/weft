-- One retained semantic result for a registered Weft module. Resolution and
-- body production share typed identities; conformance queries receive the
-- catalog that owns their concrete types, including body-derived segments.

use compiler/project/identity/equality.{module_identity_eq}
use compiler/types/graph/conformance.{SemanticConformance}
use compiler/types/graph/conformance/catalog.{semantic_conformance_catalog_conforms}
use compiler/weft/check/body/graph.{checked_expr_segment_module}
use compiler/weft/check/body/installer.{
  CheckedModuleInstalled,
  CheckedModuleInstallRejected,
  CheckedModuleInstallerIssue,
  check_registered_module_bodies
}
use compiler/weft/check/body/program.{CheckedModuleBodyProduct}
use compiler/weft/check/registration/catalog.{RegisteredModule}
use compiler/weft/check/registration/scope.{RegistrationScope}
use compiler/weft/check/resolution.{
  SemanticResolutionAccepted,
  SemanticResolutionIssue,
  SemanticResolutionProduct,
  SemanticResolutionRejected,
  resolve_module_semantics
}

type CheckedModuleStorage {
  registered: RegisteredModule,
  scope: RegistrationScope,
  resolution: SemanticResolutionProduct,
  body: CheckedModuleBodyProduct
}

pub(package) type CheckedModule = opaque CheckedModuleStorage

pub(package) type CheckedModuleResult {
  CheckedModuleAccepted(CheckedModule),
  CheckedModuleResolutionRejected(SemanticResolutionIssue),
  CheckedModuleBodyRejected(CheckedModuleInstallerIssue),
  CheckedModuleSegmentMismatch
}

pub(package) fn check_registered_module(
  module: RegisteredModule,
  scope: RegistrationScope,
  sdk_package_id: i64
) -> CheckedModuleResult {
  match resolve_module_semantics(module, scope) {
    SemanticResolutionRejected(issue) -> CheckedModuleResolutionRejected(issue)
    SemanticResolutionAccepted(resolution) -> {
      let conformances = resolution.conformances()
      match handle check_registered_module_bodies(module, scope, resolution, sdk_package_id) {
        SemanticConformance.conforms(types, concrete, trait_atom) -> resume(
          semantic_conformance_catalog_conforms(types, conformances, concrete, trait_atom)
        )
      } {
        CheckedModuleInstallRejected(issue) -> CheckedModuleBodyRejected(issue)
        CheckedModuleInstalled(body) -> {
          let ordinary = body.ordinary()
          let expressions = ordinary.expressions()
          if not module_identity_eq(
            checked_expr_segment_module(expressions.segment()),
            module.identity
          ) { CheckedModuleSegmentMismatch }
          else {
            CheckedModuleAccepted(
              CheckedModule(
                CheckedModuleStorage {
                  registered: module,
                  scope: scope,
                  resolution: resolution,
                  body: body
                }
              )
            )
          }
        }
      }
    }
  }
}

impl CheckedModule {
  pub(package) fn registered(self: borrow Self) -> RegisteredModule {
    match self { CheckedModule(storage) -> storage.registered }
  }

  pub(package) fn scope(self: borrow Self) -> RegistrationScope {
    match self { CheckedModule(storage) -> storage.scope }
  }

  pub(package) fn resolution(self: borrow Self) -> SemanticResolutionProduct {
    match self { CheckedModule(storage) -> storage.resolution }
  }

  pub(package) fn body(self: borrow Self) -> CheckedModuleBodyProduct {
    match self { CheckedModule(storage) -> storage.body }
  }
}
