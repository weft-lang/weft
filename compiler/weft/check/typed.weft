-- Public checked-grammar interpretation over one retained Weft module closure.
-- The input and result carry no parser node, checker table or raw function list.

use compiler/project/identity.{module_identity_package}
use compiler/weft/check/checked_program.{
  CheckedProgram,
  CheckedProgramAccepted,
  check_registered_program
}
use compiler/weft/check/host_types.{HostTypeIdentity}
use compiler/weft/products.{AssembledWeftProgram}
use stdlib/diagnostic.{Diagnose}
use stdlib/grammar.{Checked, CheckedGrammar, CheckRejected, CheckResult}
use stdlib/typecheck.{TypeCheck}

pub(package) type TypedWeftChecker { TypedWeftChecker }

pub(package) fn check_assembled_weft_program(
  syntax: AssembledWeftProgram
) -> CheckResult<CheckedProgram> {
  match check_registered_program(
    syntax.root,
    syntax.registrations,
    module_identity_package(syntax.root)
  ) {
    CheckedProgramAccepted(program) -> Checked(program)
    _ -> CheckRejected<CheckedProgram>()
  }
}

impl CheckedGrammar for TypedWeftChecker {
  type Syntax = AssembledWeftProgram
  type Checked = CheckedProgram
  type Identity = HostTypeIdentity

  fn check(
    self,
    syntax: AssembledWeftProgram
  ) -[TypeCheck<HostTypeIdentity>, Diagnose]> CheckResult<CheckedProgram> {
    check_assembled_weft_program(syntax)
  }
}
