-- A named handler's checked clauses retain their defining source and a
-- context-specialized expression segment, distinct from the caller's body.

use compiler/project/identity.{
  EffectOperationDeclaration,
  HandlerImplementationIdentity,
  MemberDeclarationIdentity,
  ModuleFunctionIdentity,
  ModuleIdentity,
  handler_implementation_module
}
use compiler/project/identity/equality.{
  declaration_identity_eq,
  function_identity_eq,
  handler_implementation_identity_eq,
  module_identity_eq
}
use compiler/types/graph.{SemanticEffectAtomNode, SemanticTypeId, semantic_type_graph_node}
use compiler/types/graph/equality.{semantic_type_catalog_equal}
use compiler/weft/check/body/borrow/facts.{CheckedBorrowFacts}
use compiler/weft/check/body/ownership.{CheckedOwnershipFacts}
use compiler/weft/check/body/closure.{CheckedClosureGraph}
use compiler/weft/check/body/continuation.{
  CheckedContinuationIssue,
  checked_deferred_continuation_issue,
  checked_immediate_continuation_issue
}
use compiler/weft/check/body/effects.{
  CheckedDeferredHandlerClause,
  CheckedEffectGraph,
  CheckedHandlerInstall,
  CheckedHandlerClauseListId,
  CheckedImmediateHandlerClause
}
use compiler/weft/check/body/graph.{
  CheckedExprGraph,
  checked_binding_id_eq,
  checked_expr_id_eq,
  checked_expr_id_ordinal,
  checked_expr_list_id_segment,
  checked_expr_segment_id_eq,
  checked_expr_segment_module,
  checked_expr_segment_ordinal
}
use compiler/weft/check/body/pattern.{CheckedPatternGraph}
use compiler/weft/check/body/product.{
  CheckedBodyOwnershipCountMismatch,
  CheckedBodyOwnershipSegmentMismatch,
  CheckedBodyProductIssue,
  checked_body_borrow_issue,
  checked_body_companion_issue,
  checked_body_continuation_issue,
  checked_body_segments_agree
}
use compiler/weft/check/body/propagation.{CheckedPropagationGraph}
use compiler/weft/check/resolution/handler_contract.{SemanticHandlerClauseRequirement}
use stdlib/list.{List}
use stdlib/diagnostic/schema.{
  DiagnosticSource,
  DiagnosticSourceBuffer,
  DiagnosticSourceNamed,
  DiagnosticSourceUnknown
}
use stdlib/option.{Option}
use stdlib/source.{Source}

pub(package) type CheckedHandlerBodyIssue {
  CheckedHandlerBodyOrdinarySegment,
  CheckedHandlerBodyModuleMismatch,
  CheckedHandlerBodySourceMismatch,
  CheckedHandlerBodyAtomRequired,
  CheckedHandlerBodyResultTypeMissing,
  CheckedHandlerBodyCompanionSegmentMismatch,
  CheckedHandlerBodyClauseListMissing,
  CheckedHandlerBodyClauseCountMismatch(usize, usize),
  CheckedHandlerBodyRequirementCountMismatch(usize, usize),
  CheckedHandlerBodyClauseEffectMismatch(usize),
  CheckedHandlerBodyClauseOperationMismatch(usize),
  CheckedHandlerBodyClauseAtomMismatch(usize),
  CheckedHandlerBodyClauseParameterCountMismatch(usize, usize, usize),
  CheckedHandlerBodyClauseDeferredMismatch(usize),
  CheckedHandlerBodyClauseFormalCountMismatch(usize, usize, usize),
  CheckedHandlerBodyConstructorFormalTypeMismatch(usize, usize),
  CheckedHandlerBodyClauseFormalMismatch(usize, usize),
  CheckedHandlerBodyContinuationFormalMismatch(usize),
  CheckedHandlerBodyClauseOwnerMismatch(usize),
  CheckedHandlerBodyClauseRootMismatch(usize),
  CheckedHandlerBodyClauseParameterOwnerMismatch(usize, usize),
  CheckedHandlerBodyClauseContinuationOwnerMismatch(usize),
  CheckedHandlerBodyUnownedExpression(usize),
  CheckedHandlerBodyCompanionRejected(CheckedBodyProductIssue),
  CheckedHandlerBodyNestedContinuationRejected(CheckedBodyProductIssue),
  CheckedHandlerBodyOwnershipRejected(CheckedBodyProductIssue),
  CheckedHandlerBodyContinuationRejected(usize, CheckedContinuationIssue),
  CheckedHandlerBodyBorrowRejected(CheckedBodyProductIssue)
}

pub(package) type CheckedHandlerBodyOrigin {
  implementation: HandlerImplementationIdentity,
  caller: ModuleIdentity,
  source_site: usize,
  source: Source
}

pub(package) type CheckedHandlerBodyContract {
  atom: SemanticTypeId,
  constructor_types: List<SemanticTypeId>,
  result_type: SemanticTypeId,
  clauses: CheckedHandlerClauseListId
}

pub(package) type CheckedHandlerBodyGraphs {
  expressions: CheckedExprGraph,
  patterns: CheckedPatternGraph,
  closures: CheckedClosureGraph,
  effects: CheckedEffectGraph,
  propagation: CheckedPropagationGraph,
  borrows: CheckedBorrowFacts,
  ownership: CheckedOwnershipFacts
}

type CheckedHandlerBodyStorage {
  implementation: HandlerImplementationIdentity,
  caller: ModuleIdentity,
  source_site: usize,
  atom: SemanticTypeId,
  result_type: SemanticTypeId,
  source: Source,
  clauses: CheckedHandlerClauseListId,
  graphs: CheckedHandlerBodyGraphs,
  constructor_types: List<SemanticTypeId>
}

pub(package) type CheckedHandlerBodyProduct = opaque CheckedHandlerBodyStorage

pub(package) type CheckedHandlerBodyResult {
  CheckedHandlerBodyAccepted(CheckedHandlerBodyProduct),
  CheckedHandlerBodyRejected(CheckedHandlerBodyIssue)
}

pub(package) type CheckedHandlerBodyLinkIssue {
  CheckedHandlerBodyLinkImplementationMismatch,
  CheckedHandlerBodyLinkCallerMismatch,
  CheckedHandlerBodyLinkSegmentMismatch,
  CheckedHandlerBodyLinkSiteMismatch,
  CheckedHandlerBodyLinkAtomMismatch,
  CheckedHandlerBodyLinkConstructorCountMismatch(usize, usize),
  CheckedHandlerBodyLinkBodyMissing
}

-- The caller owns the installation expression, but the checked clauses stay
-- in the implementation's separately frozen specialization segment.
pub(package) fn checked_handler_body_link_issue(
  product: borrow CheckedHandlerBodyProduct,
  caller: borrow CheckedExprGraph,
  install: CheckedHandlerInstall
) -> CheckedHandlerBodyLinkIssue? {
  if not handler_implementation_identity_eq(
    product.implementation(),
    install.implementation
  ) { return CheckedHandlerBodyLinkImplementationMismatch }
  if not module_identity_eq(checked_expr_segment_module(caller.segment()), product.caller()) {
    return CheckedHandlerBodyLinkCallerMismatch
  }
  let clauses = product.expressions()
  if not checked_expr_segment_id_eq(clauses.segment(), install.clause_segment) {
    return CheckedHandlerBodyLinkSegmentMismatch
  }
  if product.source_site() != install.source_site { return CheckedHandlerBodyLinkSiteMismatch }
  -- Contextual checking extends the caller's catalog with implementation
  -- specialization segments. The implementation catalog sees both atoms;
  -- the caller's frozen catalog need not contain the new specialization ID.
  let linked_types = clauses.types()
  if not semantic_type_catalog_equal(linked_types, product.atom(), install.atom) {
    return CheckedHandlerBodyLinkAtomMismatch
  }
  if not checked_expr_segment_id_eq(
    checked_expr_list_id_segment(install.arguments),
    caller.segment()
  ) { return CheckedHandlerBodyLinkCallerMismatch }
  let expected_arguments = product.constructor_types().len()
  let actual_arguments = caller.expression_list_len(install.arguments)
  if actual_arguments != expected_arguments {
    return CheckedHandlerBodyLinkConstructorCountMismatch(
      expected_arguments,
      actual_arguments
    )
  }
  if not caller.contains(install.body) { CheckedHandlerBodyLinkBodyMissing }
  else { nil }
}

fn checked_handler_source_identity_eq(left: DiagnosticSource, right: DiagnosticSource) -> bool {
  match (left, right) {
    (DiagnosticSourceUnknown, DiagnosticSourceUnknown) -> true
    (DiagnosticSourceBuffer(a), DiagnosticSourceBuffer(b)) -> a == b
    (DiagnosticSourceNamed(a), DiagnosticSourceNamed(b)) -> a == b
    _ -> false
  }
}

fn checked_handler_clause_formals_issue(
  expressions: borrow CheckedExprGraph,
  effects: borrow CheckedEffectGraph,
  clauses: CheckedHandlerClauseListId,
  index: usize,
  constructor_types: List<SemanticTypeId>
) -> CheckedHandlerBodyIssue? {
  let clause = effects.clause_list_at(clauses, index)
  let function = expressions.function(index)
  let parameter_count = effects.parameter_list_len(clause.parameters)
  let constructor_count = constructor_types.len()
  let deferred_count: usize = match clause.continuation {
    CheckedDeferredHandlerClause(_) -> 1
    _ -> 0
  }
  let formal_count = expressions.function_parameter_count(function.parameters)
  let expected_formals = constructor_count + parameter_count + deferred_count
  if formal_count != expected_formals {
    return CheckedHandlerBodyClauseFormalCountMismatch(index, expected_formals, formal_count)
  }
  let catalog = expressions.types()
  let mut capture_index: usize = 0
  while capture_index < constructor_count {
    let binding = expressions.function_parameter(function.parameters, capture_index)
    let expected = constructor_types.get(capture_index).unwrap()
    let actual = expressions.binding(binding)
    if not function_identity_eq(actual.owner, function.identity) or
      not semantic_type_catalog_equal(catalog, actual.value_type, expected) {
        return CheckedHandlerBodyConstructorFormalTypeMismatch(index, capture_index)
      }
    capture_index = capture_index + 1
  }
  let mut formal_index: usize = 0
  while formal_index < parameter_count {
    let expected = effects.parameter_list_at(clause.parameters, formal_index)
    let actual = expressions.function_parameter(
      function.parameters,
      constructor_count + formal_index
    )
    if not checked_binding_id_eq(actual, expected) {
      return CheckedHandlerBodyClauseFormalMismatch(index, formal_index)
    }
    formal_index = formal_index + 1
  }
  match clause.continuation {
    CheckedDeferredHandlerClause(binding) -> if not checked_binding_id_eq(
      expressions.function_parameter(function.parameters, expected_formals - 1),
      binding
    ) { CheckedHandlerBodyContinuationFormalMismatch(index) } else { nil }
    _ -> nil
  }
}

fn checked_handler_clause_roots_issue(
  implementation: HandlerImplementationIdentity,
  expressions: borrow CheckedExprGraph,
  effects: borrow CheckedEffectGraph,
  atom: SemanticTypeId,
  constructor_types: List<SemanticTypeId>,
  clauses: CheckedHandlerClauseListId,
  requirements: List<SemanticHandlerClauseRequirement>
) -> CheckedHandlerBodyIssue? {
  let count = effects.clause_list_len(clauses)
  if count != expressions.function_len() {
    return CheckedHandlerBodyClauseCountMismatch(count, expressions.function_len())
  }
  if count != requirements.len() {
    return CheckedHandlerBodyRequirementCountMismatch(count, requirements.len())
  }
  let catalog = expressions.types()
  let module = handler_implementation_module(implementation)
  let mut index: usize = 0
  let mut next_expression: usize = 0
  while index < count {
    let clause = effects.clause_list_at(clauses, index)
    let requirement = requirements.get(index).unwrap()
    let effect_declaration = match requirement.operation {
      MemberDeclarationIdentity(owner, EffectOperationDeclaration, _) -> owner
      _ -> return CheckedHandlerBodyClauseOperationMismatch(index)
    }
    if not declaration_identity_eq(clause.effect_declaration, effect_declaration) {
      return CheckedHandlerBodyClauseEffectMismatch(index)
    }
    if not declaration_identity_eq(clause.operation, requirement.operation) {
      return CheckedHandlerBodyClauseOperationMismatch(index)
    }
    if not semantic_type_catalog_equal(catalog, requirement.atom, atom) or
      not
      semantic_type_catalog_equal(catalog, clause.atom, requirement.atom) {
        return CheckedHandlerBodyClauseAtomMismatch(index)
      }
    let parameter_count = effects.parameter_list_len(clause.parameters)
    if parameter_count != requirement.parameter_count {
      return CheckedHandlerBodyClauseParameterCountMismatch(
        index,
        requirement.parameter_count,
        parameter_count
      )
    }
    if match clause.continuation {
      CheckedDeferredHandlerClause(_) -> not requirement.allows_deferred
      _ -> false
    } { return CheckedHandlerBodyClauseDeferredMismatch(index) }
    let function = expressions.function(index)
    if not function_identity_eq(function.identity, ModuleFunctionIdentity(module, index)) {
      return CheckedHandlerBodyClauseOwnerMismatch(index)
    }
    match checked_handler_clause_formals_issue(
      expressions,
      effects,
      clauses,
      index,
      constructor_types
    ) {
      issue: CheckedHandlerBodyIssue -> return issue
      nil -> nil
    }
    if not checked_expr_id_eq(function.root, clause.body) {
      return CheckedHandlerBodyClauseRootMismatch(index)
    }
    let root_ordinal = checked_expr_id_ordinal(function.root)
    if root_ordinal < next_expression {
      return CheckedHandlerBodyClauseRootMismatch(index)
    }
    let mut parameter: usize = 0
    while parameter < effects.parameter_list_len(clause.parameters) {
      let binding = effects.parameter_list_at(clause.parameters, parameter)
      if not function_identity_eq(expressions.binding(binding).owner, function.identity) {
        return CheckedHandlerBodyClauseParameterOwnerMismatch(index, parameter)
      }
      parameter = parameter + 1
    }
    match clause.continuation {
      CheckedImmediateHandlerClause -> nil
      CheckedDeferredHandlerClause(binding) -> if not function_identity_eq(
        expressions.binding(binding).owner,
        function.identity
      ) { return CheckedHandlerBodyClauseContinuationOwnerMismatch(index) }
    }
    next_expression = root_ordinal + 1
    index = index + 1
  }
  if next_expression != expressions.len() { CheckedHandlerBodyUnownedExpression(next_expression) }
  else { nil }
}

fn checked_handler_continuation_issue(
  expressions: borrow CheckedExprGraph,
  patterns: borrow CheckedPatternGraph,
  closures: borrow CheckedClosureGraph,
  effects: borrow CheckedEffectGraph,
  propagation: borrow CheckedPropagationGraph,
  clauses: CheckedHandlerClauseListId
) -> CheckedHandlerBodyIssue? {
  let mut index: usize = 0
  while index < effects.clause_list_len(clauses) {
    let clause = effects.clause_list_at(clauses, index)
    let issue = match clause.continuation {
      CheckedImmediateHandlerClause -> checked_immediate_continuation_issue(
        expressions,
        patterns,
        closures,
        effects,
        propagation,
        clause.body
      )
      CheckedDeferredHandlerClause(binding) -> checked_deferred_continuation_issue(
        expressions,
        patterns,
        closures,
        effects,
        propagation,
        clause.body,
        binding
      )
    }
    match issue {
      value: CheckedContinuationIssue -> return CheckedHandlerBodyContinuationRejected(
        index,
        value
      )
      nil -> nil
    }
    index = index + 1
  }
  nil
}

pub(package) fn checked_handler_body_product(
  origin: CheckedHandlerBodyOrigin,
  contract: CheckedHandlerBodyContract,
  requirements: List<SemanticHandlerClauseRequirement>,
  graphs: CheckedHandlerBodyGraphs
) -> CheckedHandlerBodyResult {
  let implementation = origin.implementation
  let caller = origin.caller
  let source_site = origin.source_site
  let source = origin.source
  let atom = contract.atom
  let constructor_types = contract.constructor_types
  let result_type = contract.result_type
  let clauses = contract.clauses
  let expressions = graphs.expressions
  let patterns = graphs.patterns
  let closures = graphs.closures
  let effects = graphs.effects
  let propagation = graphs.propagation
  let borrows = graphs.borrows
  let ownership = graphs.ownership
  let segment = expressions.segment()
  if checked_expr_segment_ordinal(segment) == 0 {
    return CheckedHandlerBodyRejected(CheckedHandlerBodyOrdinarySegment)
  }
  if not module_identity_eq(
    checked_expr_segment_module(segment),
    handler_implementation_module(implementation)
  ) { return CheckedHandlerBodyRejected(CheckedHandlerBodyModuleMismatch) }
  let actual_source = expressions.source()
  if actual_source.text != source.text or not checked_handler_source_identity_eq(
    actual_source.identity,
    source.identity
  ) { return CheckedHandlerBodyRejected(CheckedHandlerBodySourceMismatch) }
  let catalog = expressions.types()
  if match catalog.graph_for(atom) {
    None -> true
    Some(graph) -> match semantic_type_graph_node(graph, atom) {
      SemanticEffectAtomNode(_, _) -> false
      _ -> true
    }
  } { return CheckedHandlerBodyRejected(CheckedHandlerBodyAtomRequired) }
  if match catalog.graph_for(result_type) { None -> true, _ -> false } {
    return CheckedHandlerBodyRejected(CheckedHandlerBodyResultTypeMissing)
  }
  if not checked_body_segments_agree(expressions, patterns, closures, effects, propagation) {
    return CheckedHandlerBodyRejected(CheckedHandlerBodyCompanionSegmentMismatch)
  }
  if not effects.contains_clause_list(clauses) {
    return CheckedHandlerBodyRejected(CheckedHandlerBodyClauseListMissing)
  }
  match checked_handler_clause_roots_issue(
    implementation,
    expressions,
    effects,
    atom,
    constructor_types,
    clauses,
    requirements
  ) {
    issue: CheckedHandlerBodyIssue -> return CheckedHandlerBodyRejected(issue)
    nil -> nil
  }
  match checked_body_companion_issue(expressions, patterns, closures, effects, propagation) {
    issue: CheckedBodyProductIssue -> return CheckedHandlerBodyRejected(
      CheckedHandlerBodyCompanionRejected(issue)
    )
    nil -> nil
  }
  match checked_handler_continuation_issue(
    expressions,
    patterns,
    closures,
    effects,
    propagation,
    clauses
  ) {
    issue: CheckedHandlerBodyIssue -> return CheckedHandlerBodyRejected(issue)
    nil -> nil
  }
  match checked_body_continuation_issue(
    expressions,
    patterns,
    closures,
    effects,
    propagation
  ) {
    issue: CheckedBodyProductIssue -> return CheckedHandlerBodyRejected(
      CheckedHandlerBodyNestedContinuationRejected(issue)
    )
    nil -> nil
  }
  match checked_body_borrow_issue(expressions, borrows) {
    issue: CheckedBodyProductIssue -> CheckedHandlerBodyRejected(
      CheckedHandlerBodyBorrowRejected(issue)
    )
    nil -> if not checked_expr_segment_id_eq(expressions.segment(), ownership.segment()) {
      CheckedHandlerBodyRejected(
        CheckedHandlerBodyOwnershipRejected(CheckedBodyOwnershipSegmentMismatch)
      )
    } else {
      if ownership.len() != expressions.len() {
        CheckedHandlerBodyRejected(
          CheckedHandlerBodyOwnershipRejected(
            CheckedBodyOwnershipCountMismatch(expressions.len(), ownership.len())
          )
        )
      } else {
        CheckedHandlerBodyAccepted(
          CheckedHandlerBodyProduct(
            CheckedHandlerBodyStorage {
              implementation: implementation,
              caller: caller,
              source_site: source_site,
              atom: atom,
              result_type: result_type,
              source: source,
              clauses: clauses,
              graphs: CheckedHandlerBodyGraphs {
                expressions: expressions,
                patterns: patterns,
                closures: closures,
                effects: effects,
                propagation: propagation,
                borrows: borrows,
                ownership: ownership
              },
              constructor_types: constructor_types
            }
          )
        )
      }
    }
  }
}

impl CheckedHandlerBodyProduct {
  pub(package) fn implementation(self: borrow Self) -> HandlerImplementationIdentity {
    match self { CheckedHandlerBodyProduct(storage) -> storage.implementation }
  }

  pub(package) fn caller(self: borrow Self) -> ModuleIdentity {
    match self { CheckedHandlerBodyProduct(storage) -> storage.caller }
  }

  pub(package) fn source_site(self: borrow Self) -> usize {
    match self { CheckedHandlerBodyProduct(storage) -> storage.source_site }
  }

  pub(package) fn result_type(self: borrow Self) -> SemanticTypeId {
    match self { CheckedHandlerBodyProduct(storage) -> storage.result_type }
  }

  pub(package) fn atom(self: borrow Self) -> SemanticTypeId {
    match self { CheckedHandlerBodyProduct(storage) -> storage.atom }
  }

  pub(package) fn constructor_types(self: borrow Self) -> List<SemanticTypeId> {
    match self { CheckedHandlerBodyProduct(storage) -> storage.constructor_types }
  }

  pub(package) fn source(self: borrow Self) -> Source {
    match self { CheckedHandlerBodyProduct(storage) -> storage.source }
  }

  pub(package) fn expressions(self: borrow Self) -> CheckedExprGraph {
    match self { CheckedHandlerBodyProduct(storage) -> storage.graphs.expressions }
  }

  pub(package) fn effects(self: borrow Self) -> CheckedEffectGraph {
    match self { CheckedHandlerBodyProduct(storage) -> storage.graphs.effects }
  }

  pub(package) fn ownership(self: borrow Self) -> CheckedOwnershipFacts {
    match self { CheckedHandlerBodyProduct(storage) -> storage.graphs.ownership }
  }

  pub(package) fn clauses(self: borrow Self) -> CheckedHandlerClauseListId {
    match self { CheckedHandlerBodyProduct(storage) -> storage.clauses }
  }
}
