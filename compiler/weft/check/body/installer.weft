-- Materialize separately checked named-handler clauses from installation facts.
-- The ordinary graph already fixed the implementation, type arguments,
-- constructor values and caller context; this phase never walks caller syntax.

use compiler/project/identity.{HandlerImplementationIdentity}
use compiler/weft/check/body/effects.{
  CheckedEffectGraph,
  CheckedHandlerInstall,
  CheckedHandlerInstallDetail
}
use compiler/weft/check/body/graph.{
  CheckedExprGraph,
  CheckedHandlerInstallKind,
  CheckedTypeListId,
  checked_expr_id_from_ordinal,
  checked_expr_segment_ordinal
}
use compiler/weft/check/body/handler_product.{
  CheckedHandlerBodyIssue,
  CheckedHandlerBodyProduct
}
use compiler/weft/check/body/producer.{
  CheckedBodiesAccepted,
  CheckedBodiesRejected,
  CheckedBodyProducerIssue,
  CheckedContextualHandlerAccepted,
  CheckedContextualHandlerInvalid,
  CheckedContextualHandlerRejected,
  CheckedContextualHandlerRequest,
  check_contextual_handler_body,
  check_registered_bodies
}
use compiler/weft/check/body/program.{
  CheckedModuleBodyAccepted,
  CheckedModuleBodyIssue,
  CheckedModuleBodyProduct,
  CheckedModuleBodyRejected,
  checked_module_body_product
}
use compiler/weft/check/registration/catalog.{RegisteredModule}
use compiler/weft/check/registration/handler.{
  RegisteredHandlerSelected,
  registration_scope_select_handler_identity
}
use compiler/weft/check/registration/scope.{RegistrationScope}
use compiler/weft/check/resolution.{SemanticResolutionProduct}
use compiler/weft/check/resolution/handlers.{
  SemanticHandlerContractIssue,
  SemanticHandlerContractRejected,
  SemanticHandlerContractResolved,
  SemanticHandlerSpecializationIssue,
  SemanticHandlerSpecializationRejected,
  SemanticHandlerSpecialized,
  SemanticHandlerTemplateIssue,
  SemanticHandlerTemplateRejected,
  SemanticHandlerTemplateResolved,
  resolve_semantic_handler_contract,
  resolve_semantic_handler_template,
  specialize_semantic_handler_template
}
use compiler/weft/check/semantic_types.{
  semantic_type_product_continue
}
use compiler/types/graph.{SemanticTypeId}
use compiler/types/graph/conformance.{SemanticConformance}
use stdlib/list.{Cons, List, Nil}

pub(package) type CheckedModuleInstallerIssue {
  CheckedModuleOrdinaryRejected(CheckedBodyProducerIssue),
  CheckedModuleInstallDetailMissing(usize),
  CheckedModuleInstallSelectionRejected(HandlerImplementationIdentity),
  CheckedModuleInstallTemplateRejected(usize, SemanticHandlerTemplateIssue),
  CheckedModuleInstallContractRejected(usize, SemanticHandlerContractIssue),
  CheckedModuleInstallSpecializationRejected(usize, SemanticHandlerSpecializationIssue),
  CheckedModuleInstallBodyRejected(usize, CheckedBodyProducerIssue),
  CheckedModuleInstallBodyInvalid(usize, CheckedHandlerBodyIssue),
  CheckedModuleInstallCompositionRejected(CheckedModuleBodyIssue)
}

pub(package) type CheckedModuleInstallerResult {
  CheckedModuleInstalled(CheckedModuleBodyProduct),
  CheckedModuleInstallRejected(CheckedModuleInstallerIssue)
}

type CheckedInstallProductsResult {
  CheckedInstallProductsBuilt(List<CheckedHandlerBodyProduct>),
  CheckedInstallProductsRejected(CheckedModuleInstallerIssue)
}

type CheckedInstallProductResult {
  CheckedInstallProductBuilt(CheckedHandlerBodyProduct),
  CheckedInstallProductRejected(CheckedModuleInstallerIssue)
}

fn install_type_arguments(
  expressions: borrow CheckedExprGraph,
  values: CheckedTypeListId,
  index: usize,
  count: usize,
  collected: List<SemanticTypeId>
) -> List<SemanticTypeId> {
  if index == count { collected.reverse() }
  else {
    install_type_arguments(
      expressions,
      values,
      index + 1,
      count,
      collected.prepend(expressions.type_list_at(values, index))
    )
  }
}

fn checked_install_product(
  caller: RegisteredModule,
  scope: RegistrationScope,
  resolution: SemanticResolutionProduct,
  expressions: borrow CheckedExprGraph,
  install: CheckedHandlerInstall,
  expression: usize,
  sdk_package_id: i64
) -[SemanticConformance]> CheckedInstallProductResult {
  match registration_scope_select_handler_identity(scope, caller.identity, install.implementation) {
    RegisteredHandlerSelected(module, handler) -> {
      let catalog = expressions.types()
      let product = semantic_type_product_continue(
        caller.identity,
        catalog,
        catalog.next_derived_segment(
          caller.identity,
          resolution.next_type_segment() + install.source_site + 1
        )
      )
      match resolve_semantic_handler_template(product, scope, module, handler) {
        SemanticHandlerTemplateRejected(_, issue) -> CheckedInstallProductRejected(
          CheckedModuleInstallTemplateRejected(expression, issue)
        )
        SemanticHandlerTemplateResolved(product, template) ->
          match resolve_semantic_handler_contract(
            product,
            scope,
            template
          ) {
            SemanticHandlerContractRejected(_, issue) -> CheckedInstallProductRejected(
              CheckedModuleInstallContractRejected(expression, issue)
            )
            SemanticHandlerContractResolved(product, template, clauses) -> {
              let arguments = install_type_arguments(
                expressions,
                install.type_arguments,
                0,
                expressions.type_list_len(install.type_arguments),
                Nil<SemanticTypeId>()
              )
              match specialize_semantic_handler_template(product, scope, template, arguments) {
                SemanticHandlerSpecializationRejected(_, issue) -> CheckedInstallProductRejected(
                  CheckedModuleInstallSpecializationRejected(expression, issue)
                )
                SemanticHandlerSpecialized(product, specialization) -> {
                  let installed = checked_expr_id_from_ordinal(expressions.segment(), expression)
                  let request = CheckedContextualHandlerRequest {
                    template: template,
                    specialization: specialization,
                    clauses: clauses,
                    caller: caller.identity,
                    source_site: install.source_site,
                    segment_ordinal: checked_expr_segment_ordinal(install.clause_segment),
                    caller_function_type: install.caller_function_type,
                    caller_result_type: install.caller_result_type,
                    handle_result_type: expressions.result_type(installed)
                  }
                  match check_contextual_handler_body(
                    request,
                    scope,
                    resolution,
                    product,
                    sdk_package_id
                  ) {
                    CheckedContextualHandlerAccepted(checked) -> CheckedInstallProductBuilt(
                      checked
                    )
                    CheckedContextualHandlerRejected(issue) -> CheckedInstallProductRejected(
                      CheckedModuleInstallBodyRejected(expression, issue)
                    )
                    CheckedContextualHandlerInvalid(issue) -> CheckedInstallProductRejected(
                      CheckedModuleInstallBodyInvalid(expression, issue)
                    )
                  }
                }
              }
            }
          }
      }
    }
    _ -> CheckedInstallProductRejected(
      CheckedModuleInstallSelectionRejected(install.implementation)
    )
  }
}

fn checked_install_products(
  caller: RegisteredModule,
  scope: RegistrationScope,
  resolution: SemanticResolutionProduct,
  expressions: borrow CheckedExprGraph,
  effects: borrow CheckedEffectGraph,
  index: usize,
  sdk_package_id: i64,
  collected: List<CheckedHandlerBodyProduct>
) -[SemanticConformance]> CheckedInstallProductsResult {
  let mut position = index
  let mut products = collected
  while position < expressions.len() {
    let expression = checked_expr_id_from_ordinal(expressions.segment(), position)
    match expressions.kind(expression) {
      CheckedHandlerInstallKind -> match effects.inspect(
        expressions.handler_install_detail(expression)
      ) {
        CheckedHandlerInstallDetail(install) -> match checked_install_product(
          caller,
          scope,
          resolution,
          expressions,
          install,
          position,
          sdk_package_id
        ) {
          CheckedInstallProductRejected(issue) -> return CheckedInstallProductsRejected(issue)
          CheckedInstallProductBuilt(product) -> { products = products.prepend(product) }
        }
        _ -> return CheckedInstallProductsRejected(
          CheckedModuleInstallDetailMissing(position)
        )
      }
      _ -> nil
    }
    position = position + 1
  }
  CheckedInstallProductsBuilt(products.reverse())
}

pub(package) fn check_registered_module_bodies(
  module: RegisteredModule,
  scope: RegistrationScope,
  resolution: SemanticResolutionProduct,
  sdk_package_id: i64
) -[SemanticConformance]> CheckedModuleInstallerResult {
  match check_registered_bodies(module, scope, resolution, sdk_package_id) {
    CheckedBodiesRejected(issue) -> CheckedModuleInstallRejected(
      CheckedModuleOrdinaryRejected(issue)
    )
    CheckedBodiesAccepted(ordinary) -> {
      let expressions = ordinary.expressions()
      let effects = ordinary.effects()
      match checked_install_products(
        module,
        scope,
        resolution,
        expressions,
        effects,
        0,
        sdk_package_id,
        Nil<CheckedHandlerBodyProduct>()
      ) {
        CheckedInstallProductsRejected(issue) -> CheckedModuleInstallRejected(issue)
        CheckedInstallProductsBuilt(handlers) -> match checked_module_body_product(
          ordinary,
          handlers
        ) {
          CheckedModuleBodyAccepted(program) -> CheckedModuleInstalled(program)
          CheckedModuleBodyRejected(issue) -> CheckedModuleInstallRejected(
            CheckedModuleInstallCompositionRejected(issue)
          )
        }
      }
    }
  }
}
