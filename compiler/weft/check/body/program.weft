-- Compose an ordinary checked module body with its contextual handler bodies.
-- Installation facts, rather than a second walk over authored syntax, name
-- each separately frozen implementation segment.

use compiler/types/graph/equality.{semantic_type_catalog_equal}
use compiler/weft/check/body/effects.{
  CheckedEffectGraph,
  CheckedHandlerInstall,
  CheckedHandlerInstallDetail
}
use compiler/weft/check/body/graph.{
  CheckedExprGraph,
  CheckedHandlerInstallKind,
  checked_expr_id_from_ordinal,
  checked_expr_segment_id_eq
}
use compiler/weft/check/body/handler_product.{
  CheckedHandlerBodyLinkIssue,
  CheckedHandlerBodyProduct,
  checked_handler_body_link_issue
}
use compiler/weft/check/body/product.{CheckedBodyProduct}
use stdlib/list.{Cons, List, Nil}

pub(package) type CheckedModuleBodyIssue {
  CheckedModuleCompanionSegmentMismatch,
  CheckedModuleHandlerMissing(usize),
  CheckedModuleHandlerDuplicate(usize),
  CheckedModuleHandlerDetailMismatch(usize),
  CheckedModuleHandlerResultMismatch(usize),
  CheckedModuleHandlerLinkRejected(usize, CheckedHandlerBodyLinkIssue),
  CheckedModuleHandlerCountMismatch(usize, usize)
}

type CheckedModuleBodyStorage {
  ordinary: CheckedBodyProduct,
  handlers: List<CheckedHandlerBodyProduct>
}

pub(package) type CheckedModuleBodyProduct = opaque CheckedModuleBodyStorage

pub(package) type CheckedModuleBodyResult {
  CheckedModuleBodyAccepted(CheckedModuleBodyProduct),
  CheckedModuleBodyRejected(CheckedModuleBodyIssue)
}

fn checked_module_install_issue(
  expressions: borrow CheckedExprGraph,
  install: CheckedHandlerInstall,
  handlers: List<CheckedHandlerBodyProduct>,
  expression: usize,
  seen: bool
) -> CheckedModuleBodyIssue? {
  match handlers {
    Nil -> if seen { nil } else { CheckedModuleHandlerMissing(expression) }
    Cons(product, remaining) -> {
      let graph = product.expressions()
      let segment = graph.segment()
      if checked_expr_segment_id_eq(segment, install.clause_segment) {
        if seen { return CheckedModuleHandlerDuplicate(expression) }
        let installed = checked_expr_id_from_ordinal(expressions.segment(), expression)
        let catalog = expressions.types()
        if not semantic_type_catalog_equal(
          catalog,
          expressions.result_type(installed),
          product.result_type()
        ) { return CheckedModuleHandlerResultMismatch(expression) }
        match checked_handler_body_link_issue(product, expressions, install) {
          issue: CheckedHandlerBodyLinkIssue -> return CheckedModuleHandlerLinkRejected(
            expression,
            issue
          )
          nil -> checked_module_install_issue(
            expressions,
            install,
            remaining,
            expression,
            true
          )
        }
      } else {
        checked_module_install_issue(expressions, install, remaining, expression, seen)
      }
    }
  }
}

pub(package) fn checked_module_handler_links_issue(
  expressions: borrow CheckedExprGraph,
  effects: borrow CheckedEffectGraph,
  handlers: List<CheckedHandlerBodyProduct>
) -> CheckedModuleBodyIssue? {
  if not checked_expr_segment_id_eq(expressions.segment(), effects.segment()) {
    return CheckedModuleCompanionSegmentMismatch
  }
  let mut ordinal: usize = 0
  let mut installs: usize = 0
  while ordinal < expressions.len() {
    let expression = checked_expr_id_from_ordinal(expressions.segment(), ordinal)
    match expressions.kind(expression) {
      CheckedHandlerInstallKind -> {
        let detail = expressions.handler_install_detail(expression)
        match effects.inspect(detail) {
          CheckedHandlerInstallDetail(install) -> match checked_module_install_issue(
            expressions,
            install,
            handlers,
            ordinal,
            false
          ) {
            issue: CheckedModuleBodyIssue -> return issue
            nil -> nil
          }
          _ -> return CheckedModuleHandlerDetailMismatch(ordinal)
        }
        installs = installs + 1
      }
      _ -> nil
    }
    ordinal = ordinal + 1
  }
  if installs != handlers.len() {
    CheckedModuleHandlerCountMismatch(installs, handlers.len())
  } else { nil }
}

pub(package) fn checked_module_body_product(
  ordinary: CheckedBodyProduct,
  handlers: List<CheckedHandlerBodyProduct>
) -> CheckedModuleBodyResult {
  let expressions = ordinary.expressions()
  let effects = ordinary.effects()
  match checked_module_handler_links_issue(expressions, effects, handlers) {
    issue: CheckedModuleBodyIssue -> CheckedModuleBodyRejected(issue)
    nil -> CheckedModuleBodyAccepted(
      CheckedModuleBodyProduct(
        CheckedModuleBodyStorage {
          ordinary: ordinary,
          handlers: handlers
        }
      )
    )
  }
}

impl CheckedModuleBodyProduct {
  pub(package) fn ordinary(self: borrow Self) -> CheckedBodyProduct {
    match self { CheckedModuleBodyProduct(storage) -> storage.ordinary }
  }

  pub(package) fn handler_count(self: borrow Self) -> usize {
    match self { CheckedModuleBodyProduct(storage) -> storage.handlers.len() }
  }
}
