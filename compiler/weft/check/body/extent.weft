-- Authored extents of expressions the checker did not build.
--
-- A checked expression carries its own range, but a check that fails before
-- building anything has only the authored syntax. Its extent runs from the
-- first positioned token beneath it to the last: names, literals, keyword
-- sites and operator ranges. Keywords and braces without positions of their
-- own lie outside it, and an expression with no positioned descendant has
-- no extent.

use compiler/ir/data.{
  Apply,
  ArrayLiteral,
  Arm,
  Assign,
  AddressOf,
  BinOp,
  Block,
  BoolLit,
  BorrowIdent,
  Break,
  BreakNoValue,
  Call,
  Continue,
  Defer,
  Deref,
  Expr,
  ExprList,
  ExprListCons,
  ExprListNil,
  FieldAccess,
  FloatLit,
  ForIter,
  GenericCall,
  Handle,
  HandlerClause,
  HandlerClauseList,
  HandlerClauseListCons,
  HandlerClauseListNil,
  Ident,
  If,
  IndexedGet,
  IndexedLen,
  IndexedSet,
  IndexedSlice,
  IntLit,
  InterpConcat,
  InterpDisplay,
  Lambda,
  Let,
  LetMut,
  LetTyped,
  Loop,
  Match,
  MatchArmList,
  MatchArmListCons,
  MatchArmListNil,
  MethodCall,
  Negate,
  NilExpr,
  Not,
  OptChain,
  Perform,
  PtrAssign,
  RecordField,
  RecordFieldList,
  RecordFieldListCons,
  RecordFieldListNil,
  RecordInit,
  RecordUpdate,
  ResolvedEffectIdent,
  Resume,
  Return,
  StringLit,
  Try,
  UnknownArm,
  UnknownExpr,
  UnknownHandlerClause,
  UnknownRecordField,
  While,
  WithHandler
}
use compiler/weft/check/body/graph.{CheckedSourceRange}
use stdlib/source.{Source}

fn extent_span(source: Source, start: i64, length: i64) -> CheckedSourceRange? {
  if start < 0 or length < 0 { nil }
  else {
    let first = __i64_to_usize(start)
    let count = __i64_to_usize(length)
    if first > source.text.len() or count > source.text.len() - first { nil }
    else { CheckedSourceRange { start: first, end: first + count } }
  }
}

-- A keyword site is known only by where it starts.
fn extent_site(source: Source, site: i64) -> CheckedSourceRange? { extent_span(source, site, 1) }

fn extent_join(left: CheckedSourceRange?, right: CheckedSourceRange?) -> CheckedSourceRange? {
  match left {
    nil -> right
    first: CheckedSourceRange -> match right {
      nil -> first
      second: CheckedSourceRange -> CheckedSourceRange {
        start: if first.start < second.start { first.start } else { second.start },
        end: if first.end > second.end { first.end } else { second.end }
      }
    }
  }
}

fn extent_expressions(source: Source, values: ExprList) -> CheckedSourceRange? {
  match values {
    ExprListNil -> nil
    ExprListCons(value, rest) -> extent_join(
      checked_authored_extent(source, value),
      extent_expressions(source, rest)
    )
  }
}

fn extent_arms(source: Source, arms: MatchArmList) -> CheckedSourceRange? {
  match arms {
    MatchArmListNil -> nil
    MatchArmListCons(arm, rest) -> {
      let own = match arm {
        Arm(_, body, guard, _) -> extent_join(
          checked_authored_extent(source, body),
          checked_authored_extent(source, guard)
        )
        UnknownArm(_) -> nil
      }
      extent_join(own, extent_arms(source, rest))
    }
  }
}

fn extent_clauses(source: Source, clauses: HandlerClauseList) -> CheckedSourceRange? {
  match clauses {
    HandlerClauseListNil -> nil
    HandlerClauseListCons(clause, rest) -> {
      let own = match clause {
        HandlerClause(_, _, body, _) -> checked_authored_extent(source, body)
        UnknownHandlerClause(_) -> nil
      }
      extent_join(own, extent_clauses(source, rest))
    }
  }
}

fn extent_fields(source: Source, fields: RecordFieldList) -> CheckedSourceRange? {
  match fields {
    RecordFieldListNil -> nil
    RecordFieldListCons(field, rest) -> {
      let own = match field {
        RecordField(_, _, value, _) -> checked_authored_extent(source, value)
        UnknownRecordField(_) -> nil
      }
      extent_join(own, extent_fields(source, rest))
    }
  }
}

fn extent_pair(source: Source, left: Expr, right: Expr) -> CheckedSourceRange? {
  extent_join(checked_authored_extent(source, left), checked_authored_extent(source, right))
}

pub(package) fn checked_authored_extent(source: Source, value: Expr) -> CheckedSourceRange? {
  match value {
    IntLit(_, start, length) -> extent_span(source, start, length)
    StringLit(_, _, start, length) -> extent_span(source, start, length)
    BoolLit(_, start, length) -> extent_span(source, start, length)
    FloatLit(start, length, _) -> extent_span(source, start, length)
    ResolvedEffectIdent(start, length, _) -> extent_span(source, start, length)
    Ident(start, length) -> extent_span(source, start, length)
    BorrowIdent(start, length, _, _) -> extent_span(source, start, length)
    BinOp(_, left, right) -> extent_pair(source, left, right)
    Call(start, length, arguments) -> extent_join(
      extent_span(source, start, length),
      extent_expressions(source, arguments)
    )
    Apply(callee, arguments, _, site) -> extent_join(
      extent_join(extent_site(source, site), checked_authored_extent(source, callee)),
      extent_expressions(source, arguments)
    )
    GenericCall(_, inner) -> checked_authored_extent(source, inner)
    If(condition, then_branch, else_branch) -> extent_join(
      extent_pair(source, condition, then_branch),
      checked_authored_extent(source, else_branch)
    )
    While(condition, body) -> extent_pair(source, condition, body)
    Loop(body) -> checked_authored_extent(source, body)
    Break(inner) -> checked_authored_extent(source, inner)
    BreakNoValue(start, length) -> extent_span(source, start, length)
    Continue(start, length) -> extent_span(source, start, length)
    Return(inner) -> checked_authored_extent(source, inner)
    Defer(cleanup, body, site) -> extent_join(
      extent_site(source, site),
      extent_pair(source, cleanup, body)
    )
    Let(start, length, bound, body) -> extent_join(
      extent_span(source, start, length),
      extent_pair(source, bound, body)
    )
    LetMut(start, length, bound, body) -> extent_join(
      extent_span(source, start, length),
      extent_pair(source, bound, body)
    )
    Assign(start, length, assigned) -> extent_join(
      extent_span(source, start, length),
      checked_authored_extent(source, assigned)
    )
    AddressOf(_, target) -> checked_authored_extent(source, target)
    Deref(pointer) -> checked_authored_extent(source, pointer)
    PtrAssign(pointer, assigned) -> extent_pair(source, pointer, assigned)
    Block(first, rest) -> extent_pair(source, first, rest)
    FieldAccess(base, start, length, _) -> extent_join(
      checked_authored_extent(source, base),
      extent_span(source, start, length)
    )
    IndexedLen(base, _) -> checked_authored_extent(source, base)
    IndexedGet(base, index, _, _) -> extent_pair(source, base, index)
    IndexedSet(base, index, assigned, _) -> extent_join(
      extent_pair(source, base, index),
      checked_authored_extent(source, assigned)
    )
    IndexedSlice(base, start, end, _) -> extent_join(
      extent_pair(source, base, start),
      checked_authored_extent(source, end)
    )
    RecordInit(start, length, fields, _) -> extent_join(
      extent_span(source, start, length),
      extent_fields(source, fields)
    )
    RecordUpdate(base, fields, _) -> extent_join(
      checked_authored_extent(source, base),
      extent_fields(source, fields)
    )
    ArrayLiteral(elements, _, site) -> extent_join(
      extent_site(source, site),
      extent_expressions(source, elements)
    )
    Match(scrutinee, arms, _) -> extent_join(
      checked_authored_extent(source, scrutinee),
      extent_arms(source, arms)
    )
    Not(operand) -> checked_authored_extent(source, operand)
    Negate(operand, _) -> checked_authored_extent(source, operand)
    Lambda(_, body, site) -> extent_join(
      extent_site(source, site),
      checked_authored_extent(source, body)
    )
    Perform(target, start, length, arguments) -> extent_join(
      extent_join(checked_authored_extent(source, target), extent_span(source, start, length)),
      extent_expressions(source, arguments)
    )
    Handle(body, clauses, _) -> extent_join(
      checked_authored_extent(source, body),
      extent_clauses(source, clauses)
    )
    Resume(inner) -> checked_authored_extent(source, inner)
    WithHandler(_, body, _, site) -> extent_join(
      extent_site(source, site),
      checked_authored_extent(source, body)
    )
    MethodCall(receiver, _, arguments, _) -> extent_join(
      checked_authored_extent(source, receiver),
      extent_expressions(source, arguments)
    )
    Try(operand, _, operator) -> extent_join(
      checked_authored_extent(source, operand),
      extent_span(source, operator.start, operator.length)
    )
    InterpConcat(left, right) -> extent_pair(source, left, right)
    InterpDisplay(operand) -> checked_authored_extent(source, operand)
    ForIter(start, length, collection, body) -> extent_join(
      extent_span(source, start, length),
      extent_pair(source, collection, body)
    )
    OptChain(base, start, length, _) -> extent_join(
      checked_authored_extent(source, base),
      extent_span(source, start, length)
    )
    LetTyped(inner, _) -> checked_authored_extent(source, inner)
    NilExpr -> nil
    UnknownExpr(_) -> nil
  }
}
