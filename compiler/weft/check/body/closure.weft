-- Immutable closure details for one checked-expression segment.
--
-- Lambda expressions keep one opaque id in the expression graph. This
-- companion product owns the semantic detail needed by lowering and analyses:
-- exact parameter and capture bindings, the checked body, stable source site,
-- scoped-concurrency role and generator-producer fact. Lists contain only
-- scalar binding ordinals and cannot be interleaved while they are built.

use compiler/weft/check/body/graph.{
  CheckedBindingId,
  CheckedExprGraphBuilder,
  CheckedExprId,
  CheckedExprSegmentId,
  CheckedLambdaId,
  checked_binding_id_from_ordinal,
  checked_binding_id_ordinal,
  checked_binding_id_segment,
  checked_expr_id_from_ordinal,
  checked_expr_id_ordinal,
  checked_expr_id_segment,
  checked_expr_segment_id_eq,
  checked_lambda_id,
  checked_lambda_id_ordinal,
  checked_lambda_id_segment
}
use compiler/weft/check/storage.{
  DenseBuilder,
  DenseIndex,
  DenseSegment,
  dense_builder,
  dense_builder_with_capacity,
  dense_index,
  dense_index_value
}
use stdlib/drop.{Drop}
use stdlib/panic.{panic}

pub(package) type CheckedBindingListId = opaque(CheckedExprSegmentId, DenseIndex)

pub(package) type CheckedBindingListBuilder = opaque(CheckedExprSegmentId, usize, usize)

pub(package) type CheckedLambdaRole {
  CheckedOrdinaryLambda,
  CheckedParallelScopeLambda,
  CheckedParallelWorkerLambda,
  CheckedTaskWorkerLambda
}

pub(package) type CheckedLambda {
  parameters: CheckedBindingListId,
  captures: CheckedBindingListId,
  body: CheckedExprId,
  source_site: usize,
  role: CheckedLambdaRole,
  generator_producer: bool
}

type CheckedClosureBuilderStorage {
  segment: CheckedExprSegmentId,
  binding_values: owned DenseBuilder<usize>,
  binding_starts: owned DenseBuilder<usize>,
  binding_counts: owned DenseBuilder<usize>,
  parameter_lists: owned DenseBuilder<usize>,
  capture_lists: owned DenseBuilder<usize>,
  bodies: owned DenseBuilder<usize>,
  source_sites: owned DenseBuilder<usize>,
  roles: owned DenseBuilder<CheckedLambdaRole>,
  generator_producers: owned DenseBuilder<bool>
}

pub(package) type CheckedClosureBuilder = opaque CheckedClosureBuilderStorage

type CheckedClosureGraphStorage {
  segment: CheckedExprSegmentId,
  binding_values: DenseSegment<usize>,
  binding_starts: DenseSegment<usize>,
  binding_counts: DenseSegment<usize>,
  parameter_lists: DenseSegment<usize>,
  capture_lists: DenseSegment<usize>,
  bodies: DenseSegment<usize>,
  source_sites: DenseSegment<usize>,
  roles: DenseSegment<CheckedLambdaRole>,
  generator_producers: DenseSegment<bool>
}

pub(package) type CheckedClosureGraph = opaque CheckedClosureGraphStorage

fn binding_list_id_segment(id: CheckedBindingListId) -> CheckedExprSegmentId {
  match id { CheckedBindingListId((segment, _)) -> segment }
}

fn binding_list_id_ordinal(id: CheckedBindingListId) -> usize {
  match id { CheckedBindingListId((_, index)) -> dense_index_value(index) }
}

fn same_segment(expected: CheckedExprSegmentId, found: CheckedExprSegmentId) -> nil {
  if checked_expr_segment_id_eq(expected, found) { nil }
  else { panic("Checked closure value belongs to another module segment") }
}

pub(package) fn checked_closure_builder(
  expressions: borrow CheckedExprGraphBuilder,
  capacity: usize
) -> owned CheckedClosureBuilder {
  CheckedClosureBuilder(
    CheckedClosureBuilderStorage {
      segment: expressions.segment(),
      binding_values: dense_builder<usize>(),
      binding_starts: dense_builder<usize>(),
      binding_counts: dense_builder<usize>(),
      parameter_lists: dense_builder_with_capacity<usize>(capacity),
      capture_lists: dense_builder_with_capacity<usize>(capacity),
      bodies: dense_builder_with_capacity<usize>(capacity),
      source_sites: dense_builder_with_capacity<usize>(capacity),
      roles: dense_builder_with_capacity<CheckedLambdaRole>(capacity),
      generator_producers: dense_builder_with_capacity<bool>(capacity)
    }
  )
}

impl CheckedClosureBuilder {
  pub(package) fn segment(self: borrow Self) -> CheckedExprSegmentId {
    match self { CheckedClosureBuilder(storage) -> storage.segment }
  }

  pub(package) fn len(self: borrow Self) -> usize {
    match self {
      CheckedClosureBuilder(storage) -> {
        let { segment: _, binding_values: _, binding_starts: _, binding_counts: _, parameter_lists, capture_lists: _, bodies: _, source_sites: _, roles: _, generator_producers: _ } = storage
        parameter_lists.len()
      }
    }
  }

  pub(package) fn binding_list(
    self: owned Self
  ) -> (owned CheckedClosureBuilder, CheckedBindingListBuilder) {
    match self {
      CheckedClosureBuilder(storage) -> {
        let { segment, binding_values, binding_starts, binding_counts, parameter_lists, capture_lists, bodies, source_sites, roles, generator_producers } = storage
        let start = binding_values.len()
        (
          CheckedClosureBuilder(
            CheckedClosureBuilderStorage {
              segment: segment,
              binding_values: binding_values,
              binding_starts: binding_starts,
              binding_counts: binding_counts,
              parameter_lists: parameter_lists,
              capture_lists: capture_lists,
              bodies: bodies,
              source_sites: source_sites,
              roles: roles,
              generator_producers: generator_producers
            }
          ),
          CheckedBindingListBuilder((segment, start, 0))
        )
      }
    }
  }

  pub(package) fn binding_list_push(
    self: owned Self,
    expressions: borrow CheckedExprGraphBuilder,
    list: CheckedBindingListBuilder,
    binding: CheckedBindingId
  ) -> (owned CheckedClosureBuilder, CheckedBindingListBuilder) {
    match list {
      CheckedBindingListBuilder((owner, start, count)) -> match self {
        CheckedClosureBuilder(storage) -> {
          let { segment, binding_values, binding_starts, binding_counts, parameter_lists, capture_lists, bodies, source_sites, roles, generator_producers } = storage
          same_segment(segment, owner)
          same_segment(segment, expressions.segment())
          same_segment(segment, checked_binding_id_segment(binding))
          let ordinal = checked_binding_id_ordinal(binding)
          if ordinal >= expressions.binding_len() {
            panic("Checked closure binding is not published")
          } else { nil }
          let mut values = binding_values
          if values.len() != start + count {
            panic("Checked closure binding lists cannot be interleaved")
          } else { nil }
          values.push(ordinal)
          (
            CheckedClosureBuilder(
              CheckedClosureBuilderStorage {
                segment: segment,
                binding_values: values,
                binding_starts: binding_starts,
                binding_counts: binding_counts,
                parameter_lists: parameter_lists,
                capture_lists: capture_lists,
                bodies: bodies,
                source_sites: source_sites,
                roles: roles,
                generator_producers: generator_producers
              }
            ),
            CheckedBindingListBuilder((segment, start, count + 1))
          )
        }
      }
    }
  }

  pub(package) fn finish_binding_list(
    self: owned Self,
    list: CheckedBindingListBuilder
  ) -> (owned CheckedClosureBuilder, CheckedBindingListId) {
    match list {
      CheckedBindingListBuilder((owner, start, count)) -> match self {
        CheckedClosureBuilder(storage) -> {
          let { segment, binding_values, binding_starts, binding_counts, parameter_lists, capture_lists, bodies, source_sites, roles, generator_producers } = storage
          same_segment(segment, owner)
          if binding_values.len() != start + count {
            panic("Checked closure binding list was not completed contiguously")
          } else { nil }
          let mut starts = binding_starts
          let mut counts = binding_counts
          let index = starts.push(start)
          if dense_index_value(counts.push(count)) != dense_index_value(index) {
            panic("Checked closure binding-list columns diverged")
          } else {
            (
              CheckedClosureBuilder(
                CheckedClosureBuilderStorage {
                  segment: segment,
                  binding_values: binding_values,
                  binding_starts: starts,
                  binding_counts: counts,
                  parameter_lists: parameter_lists,
                  capture_lists: capture_lists,
                  bodies: bodies,
                  source_sites: source_sites,
                  roles: roles,
                  generator_producers: generator_producers
                }
              ),
              CheckedBindingListId((segment, index))
            )
          }
        }
      }
    }
  }

  pub(package) fn lambda(
    self: owned Self,
    expressions: borrow CheckedExprGraphBuilder,
    parameters: CheckedBindingListId,
    captures: CheckedBindingListId,
    body: CheckedExprId,
    source_site: usize,
    role: CheckedLambdaRole,
    generator_producer: bool
  ) -> (owned CheckedClosureBuilder, CheckedLambdaId) {
    match self {
      CheckedClosureBuilder(storage) -> {
        let { segment, binding_values, binding_starts, binding_counts, parameter_lists, capture_lists, bodies, source_sites, roles, generator_producers } = storage
        same_segment(segment, expressions.segment())
        same_segment(segment, binding_list_id_segment(parameters))
        same_segment(segment, binding_list_id_segment(captures))
        same_segment(segment, checked_expr_id_segment(body))
        let parameter_ordinal = binding_list_id_ordinal(parameters)
        let capture_ordinal = binding_list_id_ordinal(captures)
        let body_ordinal = checked_expr_id_ordinal(body)
        if parameter_ordinal >= binding_starts.len() or capture_ordinal >= binding_starts.len() {
          panic("Checked closure binding list is not published")
        } else { nil }
        if body_ordinal >= expressions.len() {
          panic("Checked closure body is not published")
        } else { nil }
        let mut next_parameters = parameter_lists
        let mut next_captures = capture_lists
        let mut next_bodies = bodies
        let mut next_sites = source_sites
        let mut next_roles = roles
        let mut next_generators = generator_producers
        let index = next_parameters.push(parameter_ordinal)
        let ordinal = dense_index_value(index)
        if dense_index_value(next_captures.push(capture_ordinal)) != ordinal or
          dense_index_value(next_bodies.push(body_ordinal)) != ordinal or
          dense_index_value(next_sites.push(source_site)) != ordinal or
          dense_index_value(next_roles.push(role)) != ordinal or
          dense_index_value(next_generators.push(generator_producer)) != ordinal {
            panic("Checked closure columns diverged")
          } else {
            (
              CheckedClosureBuilder(
                CheckedClosureBuilderStorage {
                  segment: segment,
                  binding_values: binding_values,
                  binding_starts: binding_starts,
                  binding_counts: binding_counts,
                  parameter_lists: next_parameters,
                  capture_lists: next_captures,
                  bodies: next_bodies,
                  source_sites: next_sites,
                  roles: next_roles,
                  generator_producers: next_generators
                }
              ),
              checked_lambda_id(segment, ordinal)
            )
          }
      }
    }
  }

  pub(package) fn freeze(self: owned Self) -> CheckedClosureGraph {
    match self {
      CheckedClosureBuilder(storage) -> {
        let { segment, binding_values, binding_starts, binding_counts, parameter_lists, capture_lists, bodies, source_sites, roles, generator_producers } = storage
        CheckedClosureGraph(
          CheckedClosureGraphStorage {
            segment: segment,
            binding_values: binding_values.freeze(),
            binding_starts: binding_starts.freeze(),
            binding_counts: binding_counts.freeze(),
            parameter_lists: parameter_lists.freeze(),
            capture_lists: capture_lists.freeze(),
            bodies: bodies.freeze(),
            source_sites: source_sites.freeze(),
            roles: roles.freeze(),
            generator_producers: generator_producers.freeze()
          }
        )
      }
    }
  }
}

impl CheckedClosureGraph {
  pub(package) fn segment(self: borrow Self) -> CheckedExprSegmentId {
    match self { CheckedClosureGraph(storage) -> storage.segment }
  }

  pub(package) fn len(self: borrow Self) -> usize {
    match self {
      CheckedClosureGraph(storage) -> {
        let { segment: _, binding_values: _, binding_starts: _, binding_counts: _, parameter_lists, capture_lists: _, bodies: _, source_sites: _, roles: _, generator_producers: _ } = storage
        parameter_lists.len()
      }
    }
  }

  pub(package) fn contains(self: borrow Self, id: CheckedLambdaId) -> bool {
    checked_expr_segment_id_eq(self.segment(), checked_lambda_id_segment(id)) and
      checked_lambda_id_ordinal(id) < self.len()
  }

  fn index(self: borrow Self, id: CheckedLambdaId) -> DenseIndex {
    same_segment(self.segment(), checked_lambda_id_segment(id))
    let ordinal = checked_lambda_id_ordinal(id)
    if ordinal >= self.len() { panic("Checked lambda identity is out of bounds") }
    else { dense_index(ordinal) }
  }

  pub(package) fn binding_list_len(
    self: borrow Self,
    id: CheckedBindingListId
  ) -> usize {
    same_segment(self.segment(), binding_list_id_segment(id))
    match self {
      CheckedClosureGraph(storage) -> {
        let { segment: _, binding_values: _, binding_starts: _, binding_counts, parameter_lists: _, capture_lists: _, bodies: _, source_sites: _, roles: _, generator_producers: _ } = storage
        binding_counts.at(dense_index(binding_list_id_ordinal(id)))
      }
    }
  }

  pub(package) fn binding_list_at(
    self: borrow Self,
    id: CheckedBindingListId,
    position: usize
  ) -> CheckedBindingId {
    same_segment(self.segment(), binding_list_id_segment(id))
    match self {
      CheckedClosureGraph(storage) -> {
        let { segment, binding_values, binding_starts, binding_counts, parameter_lists: _, capture_lists: _, bodies: _, source_sites: _, roles: _, generator_producers: _ } = storage
        let list = dense_index(binding_list_id_ordinal(id))
        let count = binding_counts.at(list)
        if position >= count { panic("Checked closure binding-list position is out of bounds") }
        else {
          checked_binding_id_from_ordinal(
            segment,
            binding_values.at(dense_index(binding_starts.at(list) + position))
          )
        }
      }
    }
  }

  pub(package) fn inspect(self: borrow Self, id: CheckedLambdaId) -> CheckedLambda {
    let index = self.index(id)
    match self {
      CheckedClosureGraph(storage) -> {
        let { segment, binding_values: _, binding_starts: _, binding_counts: _, parameter_lists, capture_lists, bodies, source_sites, roles, generator_producers } = storage
        CheckedLambda {
          parameters: CheckedBindingListId((segment, dense_index(parameter_lists.at(index)))),
          captures: CheckedBindingListId((segment, dense_index(capture_lists.at(index)))),
          body: checked_expr_id_from_ordinal(segment, bodies.at(index)),
          source_site: source_sites.at(index),
          role: roles.at(index),
          generator_producer: generator_producers.at(index)
        }
      }
    }
  }
}

impl Drop for CheckedClosureBuilder {
  fn drop(self) -> nil {
    match self {
      CheckedClosureBuilder(storage) -> {
        let { segment: _, binding_values, binding_starts, binding_counts, parameter_lists, capture_lists, bodies, source_sites, roles, generator_producers } = storage
        binding_values.drop()
        binding_starts.drop()
        binding_counts.drop()
        parameter_lists.drop()
        capture_lists.drop()
        bodies.drop()
        source_sites.drop()
        roles.drop()
        generator_producers.drop()
      }
    }
  }
}
