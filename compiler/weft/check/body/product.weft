-- One immutable checked-body product for a registered Weft module.
--
-- Companion graphs may be built independently, but only this freeze boundary
-- can publish them together. It validates stable function order, module
-- ownership and every cross-graph detail edge before the product can become a
-- checked-module component.

use compiler/project/identity/equality.{function_identity_eq, module_identity_eq}
use compiler/weft/check/body/closure.{CheckedClosureGraph}
use compiler/weft/check/body/effects.{
  CheckedEffectGraph,
  CheckedHandleDetailKind,
  CheckedHandlerInstallDetailKind,
  CheckedPerformDetailKind
}
use compiler/weft/check/body/graph.{
  CheckedDeclaredOptionalProjectionKind,
  CheckedEffectExprId,
  CheckedExplicitMatchKind,
  CheckedExprGraph,
  CheckedExprId,
  CheckedFailurePropagationKind,
  CheckedForDestructuringKind,
  CheckedHandleKind,
  CheckedHandlerInstallKind,
  CheckedLambdaKind,
  CheckedLetDestructuringKind,
  CheckedPerformKind,
  CheckedStructuralOptionalProjectionKind,
  checked_expr_id_from_ordinal,
  checked_expr_segment_id_eq,
  checked_expr_segment_module
}
use compiler/weft/check/body/pattern.{CheckedPatternGraph}
use compiler/weft/check/body/propagation.{
  CheckedDeclaredOptionalProjectionDetailKind,
  CheckedFailurePropagationDetailKind,
  CheckedPropagationGraph,
  CheckedStructuralOptionalProjectionDetailKind
}
use compiler/weft/check/signatures.{SemanticFunctionSignature, SemanticSignatureProduct}

pub(package) type CheckedBodyFunction {
  signature: SemanticFunctionSignature,
  body: CheckedExprId
}

pub(package) type CheckedBodyProductIssue {
  CheckedBodyModuleMismatch,
  CheckedBodyCompanionSegmentMismatch,
  CheckedBodyFunctionCountMismatch(usize, usize),
  CheckedBodyFunctionIdentityMismatch(usize),
  CheckedBodyFunctionRootMissing(usize),
  CheckedBodyCompanionReferenceMissing(usize),
  CheckedBodyCompanionKindMismatch(usize),
  CheckedBodyMatchArmListMissing(usize)
}

type CheckedBodyProductStorage {
  signatures: SemanticSignatureProduct,
  expressions: CheckedExprGraph,
  patterns: CheckedPatternGraph,
  closures: CheckedClosureGraph,
  effects: CheckedEffectGraph,
  propagation: CheckedPropagationGraph
}

pub(package) type CheckedBodyProduct = opaque CheckedBodyProductStorage

pub(package) type CheckedBodyProductResult {
  CheckedBodyProductAccepted(CheckedBodyProduct),
  CheckedBodyProductRejected(CheckedBodyProductIssue)
}

type CheckedExpectedEffectDetail {
  CheckedExpectedPerform,
  CheckedExpectedHandle,
  CheckedExpectedHandlerInstall
}

fn checked_body_segments_agree(
  expressions: borrow CheckedExprGraph,
  patterns: borrow CheckedPatternGraph,
  closures: borrow CheckedClosureGraph,
  effects: borrow CheckedEffectGraph,
  propagation: borrow CheckedPropagationGraph
) -> bool {
  checked_expr_segment_id_eq(expressions.segment(), patterns.segment()) and
    checked_expr_segment_id_eq(expressions.segment(), closures.segment()) and
    checked_expr_segment_id_eq(expressions.segment(), effects.segment()) and
    checked_expr_segment_id_eq(expressions.segment(), propagation.segment())
}

fn checked_body_functions_issue(
  signatures: borrow SemanticSignatureProduct,
  expressions: borrow CheckedExprGraph
) -> CheckedBodyProductIssue? {
  if signatures.len() != expressions.function_len() {
    CheckedBodyFunctionCountMismatch(signatures.len(), expressions.function_len())
  } else {
    let mut index: usize = 0
    while index < signatures.len() {
      let signature = signatures.at(index)
      let function = expressions.function(index)
      if not function_identity_eq(signature.identity, function.identity) {
        return CheckedBodyFunctionIdentityMismatch(index)
      } else {
        if not expressions.contains(function.root) {
          return CheckedBodyFunctionRootMissing(index)
        } else { nil }
      }
      index = index + 1
    }
    nil
  }
}

fn effect_detail_agrees(
  effects: borrow CheckedEffectGraph,
  detail: CheckedEffectExprId,
  expected: CheckedExpectedEffectDetail
) -> bool {
  if not effects.contains(detail) { false }
  else {
    match (effects.kind(detail), expected) {
      (CheckedPerformDetailKind, CheckedExpectedPerform) -> true
      (CheckedHandleDetailKind, CheckedExpectedHandle) -> true
      (CheckedHandlerInstallDetailKind, CheckedExpectedHandlerInstall) -> true
      _ -> false
    }
  }
}

fn checked_body_companion_issue(
  expressions: borrow CheckedExprGraph,
  patterns: borrow CheckedPatternGraph,
  closures: borrow CheckedClosureGraph,
  effects: borrow CheckedEffectGraph,
  propagation: borrow CheckedPropagationGraph
) -> CheckedBodyProductIssue? {
  let mut index: usize = 0
  while index < expressions.len() {
    let expression = checked_expr_id_from_ordinal(
      expressions.segment(),
      index
    )
    match expressions.kind(expression) {
      CheckedLambdaKind -> if not closures.contains(expressions.lambda_detail(expression)) {
        return CheckedBodyCompanionReferenceMissing(index)
      } else { nil }
      CheckedPerformKind -> if not effect_detail_agrees(
        effects,
        expressions.perform_detail(expression),
        CheckedExpectedPerform
      ) { return CheckedBodyCompanionKindMismatch(index) } else { nil }
      CheckedHandleKind -> if not effect_detail_agrees(
        effects,
        expressions.handle_detail(expression),
        CheckedExpectedHandle
      ) { return CheckedBodyCompanionKindMismatch(index) } else { nil }
      CheckedHandlerInstallKind -> if not effect_detail_agrees(
        effects,
        expressions.handler_install_detail(expression),
        CheckedExpectedHandlerInstall
      ) { return CheckedBodyCompanionKindMismatch(index) } else { nil }
      CheckedFailurePropagationKind -> {
        let detail = expressions.failure_propagation_detail(expression)
        if not propagation.contains(detail) {
          return CheckedBodyCompanionReferenceMissing(index)
        } else {
          match propagation.kind(detail) {
            CheckedFailurePropagationDetailKind -> nil
            _ -> return CheckedBodyCompanionKindMismatch(index)
          }
        }
      }
      CheckedDeclaredOptionalProjectionKind -> {
        let detail = expressions.declared_optional_projection_detail(expression)
        if not propagation.contains(detail) {
          return CheckedBodyCompanionReferenceMissing(index)
        } else {
          match propagation.kind(detail) {
            CheckedDeclaredOptionalProjectionDetailKind -> nil
            _ -> return CheckedBodyCompanionKindMismatch(index)
          }
        }
      }
      CheckedStructuralOptionalProjectionKind -> {
        let detail = expressions.structural_optional_projection_detail(expression)
        if not propagation.contains(detail) {
          return CheckedBodyCompanionReferenceMissing(index)
        } else {
          match propagation.kind(detail) {
            CheckedStructuralOptionalProjectionDetailKind -> nil
            _ -> return CheckedBodyCompanionKindMismatch(index)
          }
        }
      }
      CheckedExplicitMatchKind -> match expressions.match_parts(expression) {
        (_, _, arms) -> if not patterns.contains_match_arm_list(arms) {
          return CheckedBodyMatchArmListMissing(index)
        } else { nil }
      }
      CheckedLetDestructuringKind -> match expressions.match_parts(expression) {
        (_, _, arms) -> if not patterns.contains_match_arm_list(arms) {
          return CheckedBodyMatchArmListMissing(index)
        } else { nil }
      }
      CheckedForDestructuringKind -> match expressions.match_parts(expression) {
        (_, _, arms) -> if not patterns.contains_match_arm_list(arms) {
          return CheckedBodyMatchArmListMissing(index)
        } else { nil }
      }
      _ -> nil
    }
    index = index + 1
  }
  nil
}

pub(package) fn checked_body_product(
  signatures: SemanticSignatureProduct,
  expressions: CheckedExprGraph,
  patterns: CheckedPatternGraph,
  closures: CheckedClosureGraph,
  effects: CheckedEffectGraph,
  propagation: CheckedPropagationGraph
) -> CheckedBodyProductResult {
  if not module_identity_eq(
    signatures.module(),
    checked_expr_segment_module(expressions.segment())
  ) { CheckedBodyProductRejected(CheckedBodyModuleMismatch) }
  else {
    if not checked_body_segments_agree(
      expressions,
      patterns,
      closures,
      effects,
      propagation
    ) { CheckedBodyProductRejected(CheckedBodyCompanionSegmentMismatch) }
    else {
      match checked_body_functions_issue(signatures, expressions) {
        issue: CheckedBodyProductIssue -> CheckedBodyProductRejected(issue)
        nil -> match checked_body_companion_issue(
          expressions,
          patterns,
          closures,
          effects,
          propagation
        ) {
          issue: CheckedBodyProductIssue -> CheckedBodyProductRejected(issue)
          nil -> CheckedBodyProductAccepted(
            CheckedBodyProduct(
              CheckedBodyProductStorage {
                signatures: signatures,
                expressions: expressions,
                patterns: patterns,
                closures: closures,
                effects: effects,
                propagation: propagation
              }
            )
          )
        }
      }
    }
  }
}

impl CheckedBodyProduct {
  pub(package) fn signatures(self: borrow Self) -> SemanticSignatureProduct {
    match self { CheckedBodyProduct(storage) -> storage.signatures }
  }

  pub(package) fn expressions(self: borrow Self) -> CheckedExprGraph {
    match self { CheckedBodyProduct(storage) -> storage.expressions }
  }

  pub(package) fn patterns(self: borrow Self) -> CheckedPatternGraph {
    match self { CheckedBodyProduct(storage) -> storage.patterns }
  }

  pub(package) fn closures(self: borrow Self) -> CheckedClosureGraph {
    match self { CheckedBodyProduct(storage) -> storage.closures }
  }

  pub(package) fn effects(self: borrow Self) -> CheckedEffectGraph {
    match self { CheckedBodyProduct(storage) -> storage.effects }
  }

  pub(package) fn propagation(self: borrow Self) -> CheckedPropagationGraph {
    match self { CheckedBodyProduct(storage) -> storage.propagation }
  }

  pub(package) fn function_count(self: borrow Self) -> usize {
    let expressions = self.expressions()
    expressions.function_len()
  }

  pub(package) fn function(self: borrow Self, index: usize) -> CheckedBodyFunction {
    let signatures = self.signatures()
    let expressions = self.expressions()
    CheckedBodyFunction {
      signature: signatures.at(index),
      body: expressions.function(index).root
    }
  }
}
