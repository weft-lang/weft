-- Immutable effect-operation and handler details for one checked module.
--
-- Perform, handle and named-handler expressions keep only an opaque id in the
-- expression graph. This companion product owns the exact declarations,
-- semantic effect atoms, clause bindings/completion and module-handler
-- identity required after checking. No operation is recovered from spelling.

use compiler/project/identity.{DeclarationIdentity, HandlerImplementationIdentity}
use compiler/types/graph.{
  SemanticTypeId,
  SemanticTypeSegmentId,
  semantic_type_graph_contains,
  semantic_type_id_from_ordinal,
  semantic_type_id_ordinal,
  semantic_type_id_segment,
  semantic_type_segment_id,
  semantic_type_segment_id_eq
}
use compiler/types/graph/catalog.{SemanticTypeCatalog}
use compiler/weft/check/body/graph.{
  CheckedBindingId,
  CheckedEffectExprId,
  CheckedExprGraphBuilder,
  CheckedExprId,
  CheckedExprListId,
  CheckedExprSegmentId,
  CheckedSourceRange,
  CheckedTypeListId,
  checked_binding_id_from_ordinal,
  checked_binding_id_ordinal,
  checked_binding_id_segment,
  checked_effect_expr_id,
  checked_effect_expr_id_ordinal,
  checked_effect_expr_id_segment,
  checked_expr_id_from_ordinal,
  checked_expr_id_ordinal,
  checked_expr_id_segment,
  checked_expr_list_id_from_ordinal,
  checked_expr_list_id_ordinal,
  checked_expr_list_id_segment,
  checked_expr_segment_id_eq,
  checked_expr_segment_module,
  checked_type_list_id_from_ordinal,
  checked_type_list_id_ordinal,
  checked_type_list_id_segment
}
use compiler/weft/check/storage.{
  DenseBuilder,
  DenseIndex,
  DenseSegment,
  dense_builder,
  dense_builder_with_capacity,
  dense_index,
  dense_index_value
}
use stdlib/drop.{Drop}
use stdlib/map as map
use stdlib/map.{Map}
use stdlib/num/scalar.{num_scalar_usize_to_i64}
use stdlib/option.{None, Some}
use stdlib/panic.{panic}

pub(package) type CheckedHandlerParameterListId = opaque(
  CheckedExprSegmentId,
  DenseIndex
)

pub(package) type CheckedHandlerParameterListBuilder = opaque(
  CheckedExprSegmentId,
  usize,
  usize
)

pub(package) type CheckedHandlerClauseListId = opaque(CheckedExprSegmentId, DenseIndex)

pub(package) type CheckedHandlerClauseListBuilder = opaque(
  CheckedExprSegmentId,
  usize,
  usize
)

pub(package) type CheckedHandlerContinuation {
  CheckedImmediateHandlerClause,
  CheckedDeferredHandlerClause(CheckedBindingId)
}

pub(package) type CheckedHandlerCompletion {
  CheckedHandlerAborts,
  CheckedHandlerResumes,
  CheckedHandlerMixed,
  CheckedHandlerDeferred
}

pub(package) type CheckedHandleReturn {
  CheckedNoHandleReturn,
  CheckedHandleReturnClause(CheckedBindingId, CheckedExprId)
}

pub(package) type CheckedHandlerClause {
  effect_declaration: DeclarationIdentity,
  operation: DeclarationIdentity,
  atom: SemanticTypeId,
  parameters: CheckedHandlerParameterListId,
  continuation: CheckedHandlerContinuation,
  body: CheckedExprId,
  completion: CheckedHandlerCompletion,
  range: CheckedSourceRange
}

pub(package) type CheckedPerform {
  effect_declaration: DeclarationIdentity,
  operation: DeclarationIdentity,
  atom: SemanticTypeId,
  arguments: CheckedExprListId
}

pub(package) type CheckedHandle {
  body: CheckedExprId,
  clauses: CheckedHandlerClauseListId,
  return_clause: CheckedHandleReturn
}

pub(package) type CheckedHandlerInstall {
  implementation: HandlerImplementationIdentity,
  type_arguments: CheckedTypeListId,
  arguments: CheckedExprListId,
  atom: SemanticTypeId,
  body: CheckedExprId,
  source_site: usize
}

pub(package) type CheckedEffectExprNode {
  CheckedPerformDetail(CheckedPerform),
  CheckedHandleDetail(CheckedHandle),
  CheckedHandlerInstallDetail(CheckedHandlerInstall)
}

pub(package) type CheckedEffectExprKind {
  CheckedPerformDetailKind,
  CheckedHandleDetailKind,
  CheckedHandlerInstallDetailKind
}

type CheckedEffectTypeBuilderStorage {
  ordinals: owned DenseBuilder<usize>,
  imported: owned DenseBuilder<bool>,
  segments: Map<i64, SemanticTypeSegmentId>
}

type CheckedEffectTypeBuilder = opaque CheckedEffectTypeBuilderStorage

type CheckedEffectTypeReferences {
  ordinals: DenseSegment<usize>,
  imported: DenseSegment<bool>,
  segments: Map<i64, SemanticTypeSegmentId>
}

type CheckedEffectHeaderBuilderStorage {
  kinds: owned DenseBuilder<CheckedEffectExprKind>,
  payloads: owned DenseBuilder<usize>
}

type CheckedEffectHeaderBuilder = opaque CheckedEffectHeaderBuilderStorage

type CheckedEffectHeaders {
  kinds: DenseSegment<CheckedEffectExprKind>,
  payloads: DenseSegment<usize>
}

type CheckedHandlerListBuilderStorage {
  parameter_values: owned DenseBuilder<usize>,
  parameter_starts: owned DenseBuilder<usize>,
  parameter_counts: owned DenseBuilder<usize>,
  clause_effects: owned DenseBuilder<DeclarationIdentity>,
  clause_operations: owned DenseBuilder<DeclarationIdentity>,
  clause_atoms: owned CheckedEffectTypeBuilder,
  clause_parameters: owned DenseBuilder<usize>,
  clause_deferred: owned DenseBuilder<bool>,
  clause_continuations: owned DenseBuilder<usize>,
  clause_bodies: owned DenseBuilder<usize>,
  clause_completions: owned DenseBuilder<CheckedHandlerCompletion>,
  clause_starts: owned DenseBuilder<usize>,
  clause_ends: owned DenseBuilder<usize>,
  clause_list_starts: owned DenseBuilder<usize>,
  clause_list_counts: owned DenseBuilder<usize>
}

type CheckedHandlerListBuilder = opaque CheckedHandlerListBuilderStorage

type CheckedHandlerLists {
  parameter_values: DenseSegment<usize>,
  parameter_starts: DenseSegment<usize>,
  parameter_counts: DenseSegment<usize>,
  clause_effects: DenseSegment<DeclarationIdentity>,
  clause_operations: DenseSegment<DeclarationIdentity>,
  clause_atoms: CheckedEffectTypeReferences,
  clause_parameters: DenseSegment<usize>,
  clause_deferred: DenseSegment<bool>,
  clause_continuations: DenseSegment<usize>,
  clause_bodies: DenseSegment<usize>,
  clause_completions: DenseSegment<CheckedHandlerCompletion>,
  clause_starts: DenseSegment<usize>,
  clause_ends: DenseSegment<usize>,
  clause_list_starts: DenseSegment<usize>,
  clause_list_counts: DenseSegment<usize>
}

type CheckedPerformBuilderStorage {
  effects: owned DenseBuilder<DeclarationIdentity>,
  operations: owned DenseBuilder<DeclarationIdentity>,
  atoms: owned CheckedEffectTypeBuilder,
  arguments: owned DenseBuilder<usize>
}

type CheckedPerformBuilder = opaque CheckedPerformBuilderStorage

type CheckedPerforms {
  effects: DenseSegment<DeclarationIdentity>,
  operations: DenseSegment<DeclarationIdentity>,
  atoms: CheckedEffectTypeReferences,
  arguments: DenseSegment<usize>
}

type CheckedHandleBuilderStorage {
  bodies: owned DenseBuilder<usize>,
  clauses: owned DenseBuilder<usize>,
  has_return: owned DenseBuilder<bool>,
  return_bindings: owned DenseBuilder<usize>,
  return_bodies: owned DenseBuilder<usize>
}

type CheckedHandleBuilder = opaque CheckedHandleBuilderStorage

type CheckedHandles {
  bodies: DenseSegment<usize>,
  clauses: DenseSegment<usize>,
  has_return: DenseSegment<bool>,
  return_bindings: DenseSegment<usize>,
  return_bodies: DenseSegment<usize>
}

type CheckedInstallBuilderStorage {
  implementations: owned DenseBuilder<HandlerImplementationIdentity>,
  type_arguments: owned DenseBuilder<usize>,
  arguments: owned DenseBuilder<usize>,
  atoms: owned CheckedEffectTypeBuilder,
  bodies: owned DenseBuilder<usize>,
  source_sites: owned DenseBuilder<usize>
}

type CheckedInstallBuilder = opaque CheckedInstallBuilderStorage

type CheckedInstalls {
  implementations: DenseSegment<HandlerImplementationIdentity>,
  type_arguments: DenseSegment<usize>,
  arguments: DenseSegment<usize>,
  atoms: CheckedEffectTypeReferences,
  bodies: DenseSegment<usize>,
  source_sites: DenseSegment<usize>
}

type CheckedEffectBuilderStorage {
  segment: CheckedExprSegmentId,
  types: SemanticTypeCatalog,
  headers: owned CheckedEffectHeaderBuilder,
  lists: owned CheckedHandlerListBuilder,
  performs: owned CheckedPerformBuilder,
  handles: owned CheckedHandleBuilder,
  installs: owned CheckedInstallBuilder
}

pub(package) type CheckedEffectBuilder = opaque CheckedEffectBuilderStorage

type CheckedEffectGraphStorage {
  segment: CheckedExprSegmentId,
  headers: CheckedEffectHeaders,
  lists: CheckedHandlerLists,
  performs: CheckedPerforms,
  handles: CheckedHandles,
  installs: CheckedInstalls
}

pub(package) type CheckedEffectGraph = opaque CheckedEffectGraphStorage

fn same_segment(expected: CheckedExprSegmentId, found: CheckedExprSegmentId) -> nil {
  if checked_expr_segment_id_eq(expected, found) { nil }
  else { panic("Checked effect value belongs to another module segment") }
}

fn effect_type_key(index: DenseIndex) -> i64 {
  match num_scalar_usize_to_i64(dense_index_value(index)) {
    Some(value) -> value
    None -> panic("Checked effect type index is not representable")
  }
}

fn effect_type_builder() -> owned CheckedEffectTypeBuilder {
  CheckedEffectTypeBuilder(
    CheckedEffectTypeBuilderStorage {
      ordinals: dense_builder<usize>(),
      imported: dense_builder<bool>(),
      segments: map.new<i64, SemanticTypeSegmentId>()
    }
  )
}

impl CheckedEffectTypeBuilder {
  fn push(
    self: owned Self,
    local: SemanticTypeSegmentId,
    reference: SemanticTypeId
  ) -> (owned CheckedEffectTypeBuilder, DenseIndex) {
    match self {
      CheckedEffectTypeBuilder(storage) -> {
        let { ordinals, imported, segments } = storage
        let mut next_ordinals = ordinals
        let mut next_imported = imported
        let index = next_ordinals.push(semantic_type_id_ordinal(reference))
        let foreign = not semantic_type_segment_id_eq(
          local,
          semantic_type_id_segment(reference)
        )
        if dense_index_value(next_imported.push(foreign)) != dense_index_value(index) {
          panic("Checked effect type columns diverged")
        } else { nil }
        let next_segments = if foreign {
          segments.insert(effect_type_key(index), semantic_type_id_segment(reference))
        } else { segments }
        (
          CheckedEffectTypeBuilder(
            CheckedEffectTypeBuilderStorage {
              ordinals: next_ordinals,
              imported: next_imported,
              segments: next_segments
            }
          ),
          index
        )
      }
    }
  }

  fn freeze(self: owned Self) -> CheckedEffectTypeReferences {
    match self {
      CheckedEffectTypeBuilder(storage) -> {
        let { ordinals, imported, segments } = storage
        CheckedEffectTypeReferences {
          ordinals: ordinals.freeze(),
          imported: imported.freeze(),
          segments: segments
        }
      }
    }
  }
}

impl Drop for CheckedEffectTypeBuilder {
  fn drop(self) -> nil {
    match self {
      CheckedEffectTypeBuilder(storage) -> {
        let { ordinals, imported, segments: _ } = storage
        ordinals.drop()
        imported.drop()
      }
    }
  }
}

fn effect_type_at(
  references: borrow CheckedEffectTypeReferences,
  local: SemanticTypeSegmentId,
  index: DenseIndex
) -> SemanticTypeId {
  let { ordinals, imported, segments } = references
  let segment = if imported.at(index) {
    match segments.get(effect_type_key(index)) {
      Some(value) -> value
      None -> panic("Checked effect type is missing its imported segment")
    }
  } else { local }
  semantic_type_id_from_ordinal(segment, ordinals.at(index))
}

fn checked_effect_type(types: borrow SemanticTypeCatalog, value: SemanticTypeId) -> nil {
  match types.graph_for(value) {
    Some(graph) -> if semantic_type_graph_contains(graph, value) { nil }
    else { panic("Checked effect type is outside its semantic graph") }
    None -> panic("Checked effect type is outside its semantic catalog")
  }
}

fn effect_header_builder(capacity: usize) -> owned CheckedEffectHeaderBuilder {
  CheckedEffectHeaderBuilder(
    CheckedEffectHeaderBuilderStorage {
      kinds: dense_builder_with_capacity<CheckedEffectExprKind>(capacity),
      payloads: dense_builder_with_capacity<usize>(capacity)
    }
  )
}

impl CheckedEffectHeaderBuilder {
  fn len(self: borrow Self) -> usize {
    match self {
      CheckedEffectHeaderBuilder(storage) -> {
        let { kinds, payloads: _ } = storage
        kinds.len()
      }
    }
  }

  fn push(
    self: owned Self,
    segment: CheckedExprSegmentId,
    kind: CheckedEffectExprKind,
    payload: usize
  ) -> (owned CheckedEffectHeaderBuilder, CheckedEffectExprId) {
    match self {
      CheckedEffectHeaderBuilder(storage) -> {
        let { kinds, payloads } = storage
        let mut next_kinds = kinds
        let mut next_payloads = payloads
        let index = next_kinds.push(kind)
        if dense_index_value(next_payloads.push(payload)) != dense_index_value(index) {
          panic("Checked effect header columns diverged")
        } else {
          (
            CheckedEffectHeaderBuilder(
              CheckedEffectHeaderBuilderStorage {
                kinds: next_kinds,
                payloads: next_payloads
              }
            ),
            checked_effect_expr_id(segment, dense_index_value(index))
          )
        }
      }
    }
  }

  fn freeze(self: owned Self) -> CheckedEffectHeaders {
    match self {
      CheckedEffectHeaderBuilder(storage) -> {
        let { kinds, payloads } = storage
        CheckedEffectHeaders { kinds: kinds.freeze(), payloads: payloads.freeze() }
      }
    }
  }
}

impl Drop for CheckedEffectHeaderBuilder {
  fn drop(self) -> nil {
    match self {
      CheckedEffectHeaderBuilder(storage) -> {
        let { kinds, payloads } = storage
        kinds.drop()
        payloads.drop()
      }
    }
  }
}

fn handler_list_builder() -> owned CheckedHandlerListBuilder {
  CheckedHandlerListBuilder(
    CheckedHandlerListBuilderStorage {
      parameter_values: dense_builder<usize>(),
      parameter_starts: dense_builder<usize>(),
      parameter_counts: dense_builder<usize>(),
      clause_effects: dense_builder<DeclarationIdentity>(),
      clause_operations: dense_builder<DeclarationIdentity>(),
      clause_atoms: effect_type_builder(),
      clause_parameters: dense_builder<usize>(),
      clause_deferred: dense_builder<bool>(),
      clause_continuations: dense_builder<usize>(),
      clause_bodies: dense_builder<usize>(),
      clause_completions: dense_builder<CheckedHandlerCompletion>(),
      clause_starts: dense_builder<usize>(),
      clause_ends: dense_builder<usize>(),
      clause_list_starts: dense_builder<usize>(),
      clause_list_counts: dense_builder<usize>()
    }
  )
}

fn parameter_list_segment(id: CheckedHandlerParameterListId) -> CheckedExprSegmentId {
  match id { CheckedHandlerParameterListId((segment, _)) -> segment }
}

fn parameter_list_ordinal(id: CheckedHandlerParameterListId) -> usize {
  match id { CheckedHandlerParameterListId((_, index)) -> dense_index_value(index) }
}

fn clause_list_segment(id: CheckedHandlerClauseListId) -> CheckedExprSegmentId {
  match id { CheckedHandlerClauseListId((segment, _)) -> segment }
}

fn clause_list_ordinal(id: CheckedHandlerClauseListId) -> usize {
  match id { CheckedHandlerClauseListId((_, index)) -> dense_index_value(index) }
}

impl CheckedHandlerListBuilder {
  fn parameter_begin(
    self: owned Self,
    segment: CheckedExprSegmentId
  ) -> (owned CheckedHandlerListBuilder, CheckedHandlerParameterListBuilder) {
    match self {
      CheckedHandlerListBuilder(storage) -> {
        let { parameter_values, parameter_starts, parameter_counts, clause_effects, clause_operations, clause_atoms, clause_parameters, clause_deferred, clause_continuations, clause_bodies, clause_completions, clause_starts, clause_ends, clause_list_starts, clause_list_counts } = storage
        let start = parameter_values.len()
        (
          CheckedHandlerListBuilder(
            CheckedHandlerListBuilderStorage {
              parameter_values: parameter_values,
              parameter_starts: parameter_starts,
              parameter_counts: parameter_counts,
              clause_effects: clause_effects,
              clause_operations: clause_operations,
              clause_atoms: clause_atoms,
              clause_parameters: clause_parameters,
              clause_deferred: clause_deferred,
              clause_continuations: clause_continuations,
              clause_bodies: clause_bodies,
              clause_completions: clause_completions,
              clause_starts: clause_starts,
              clause_ends: clause_ends,
              clause_list_starts: clause_list_starts,
              clause_list_counts: clause_list_counts
            }
          ),
          CheckedHandlerParameterListBuilder((segment, start, 0))
        )
      }
    }
  }

  fn parameter_push(
    self: owned Self,
    list: CheckedHandlerParameterListBuilder,
    binding: usize
  ) -> (owned CheckedHandlerListBuilder, CheckedHandlerParameterListBuilder) {
    match list {
      CheckedHandlerParameterListBuilder((segment, start, count)) -> match self {
        CheckedHandlerListBuilder(storage) -> {
          let { parameter_values, parameter_starts, parameter_counts, clause_effects, clause_operations, clause_atoms, clause_parameters, clause_deferred, clause_continuations, clause_bodies, clause_completions, clause_starts, clause_ends, clause_list_starts, clause_list_counts } = storage
          let mut values = parameter_values
          if values.len() != start + count {
            panic("Checked handler parameter lists cannot be interleaved")
          } else { nil }
          values.push(binding)
          (
            CheckedHandlerListBuilder(
              CheckedHandlerListBuilderStorage {
                parameter_values: values,
                parameter_starts: parameter_starts,
                parameter_counts: parameter_counts,
                clause_effects: clause_effects,
                clause_operations: clause_operations,
                clause_atoms: clause_atoms,
                clause_parameters: clause_parameters,
                clause_deferred: clause_deferred,
                clause_continuations: clause_continuations,
                clause_bodies: clause_bodies,
                clause_completions: clause_completions,
                clause_starts: clause_starts,
                clause_ends: clause_ends,
                clause_list_starts: clause_list_starts,
                clause_list_counts: clause_list_counts
              }
            ),
            CheckedHandlerParameterListBuilder((segment, start, count + 1))
          )
        }
      }
    }
  }

  fn parameter_finish(
    self: owned Self,
    list: CheckedHandlerParameterListBuilder
  ) -> (owned CheckedHandlerListBuilder, CheckedHandlerParameterListId) {
    match list {
      CheckedHandlerParameterListBuilder((segment, start, count)) -> match self {
        CheckedHandlerListBuilder(storage) -> {
          let { parameter_values, parameter_starts, parameter_counts, clause_effects, clause_operations, clause_atoms, clause_parameters, clause_deferred, clause_continuations, clause_bodies, clause_completions, clause_starts, clause_ends, clause_list_starts, clause_list_counts } = storage
          if parameter_values.len() != start + count {
            panic("Checked handler parameter list was not completed contiguously")
          } else { nil }
          let mut starts = parameter_starts
          let mut counts = parameter_counts
          let index = starts.push(start)
          if dense_index_value(counts.push(count)) != dense_index_value(index) {
            panic("Checked handler parameter-list columns diverged")
          } else {
            (
              CheckedHandlerListBuilder(
                CheckedHandlerListBuilderStorage {
                  parameter_values: parameter_values,
                  parameter_starts: starts,
                  parameter_counts: counts,
                  clause_effects: clause_effects,
                  clause_operations: clause_operations,
                  clause_atoms: clause_atoms,
                  clause_parameters: clause_parameters,
                  clause_deferred: clause_deferred,
                  clause_continuations: clause_continuations,
                  clause_bodies: clause_bodies,
                  clause_completions: clause_completions,
                  clause_starts: clause_starts,
                  clause_ends: clause_ends,
                  clause_list_starts: clause_list_starts,
                  clause_list_counts: clause_list_counts
                }
              ),
              CheckedHandlerParameterListId((segment, index))
            )
          }
        }
      }
    }
  }

  fn clause_begin(
    self: owned Self,
    segment: CheckedExprSegmentId
  ) -> (owned CheckedHandlerListBuilder, CheckedHandlerClauseListBuilder) {
    match self {
      CheckedHandlerListBuilder(storage) -> {
        let { parameter_values, parameter_starts, parameter_counts, clause_effects, clause_operations, clause_atoms, clause_parameters, clause_deferred, clause_continuations, clause_bodies, clause_completions, clause_starts, clause_ends, clause_list_starts, clause_list_counts } = storage
        let start = clause_effects.len()
        (
          CheckedHandlerListBuilder(
            CheckedHandlerListBuilderStorage {
              parameter_values: parameter_values,
              parameter_starts: parameter_starts,
              parameter_counts: parameter_counts,
              clause_effects: clause_effects,
              clause_operations: clause_operations,
              clause_atoms: clause_atoms,
              clause_parameters: clause_parameters,
              clause_deferred: clause_deferred,
              clause_continuations: clause_continuations,
              clause_bodies: clause_bodies,
              clause_completions: clause_completions,
              clause_starts: clause_starts,
              clause_ends: clause_ends,
              clause_list_starts: clause_list_starts,
              clause_list_counts: clause_list_counts
            }
          ),
          CheckedHandlerClauseListBuilder((segment, start, 0))
        )
      }
    }
  }

  fn clause_push(
    self: owned Self,
    local: SemanticTypeSegmentId,
    list: CheckedHandlerClauseListBuilder,
    clause: CheckedHandlerClause,
    deferred: bool,
    continuation: usize
  ) -> (owned CheckedHandlerListBuilder, CheckedHandlerClauseListBuilder) {
    match list {
      CheckedHandlerClauseListBuilder((segment, start, count)) -> match self {
        CheckedHandlerListBuilder(storage) -> {
          let { parameter_values, parameter_starts, parameter_counts, clause_effects, clause_operations, clause_atoms, clause_parameters, clause_deferred, clause_continuations, clause_bodies, clause_completions, clause_starts, clause_ends, clause_list_starts, clause_list_counts } = storage
          let mut effects = clause_effects
          let mut operations = clause_operations
          let mut parameters = clause_parameters
          let mut deferred_values = clause_deferred
          let mut continuations = clause_continuations
          let mut bodies = clause_bodies
          let mut completions = clause_completions
          let mut starts = clause_starts
          let mut ends = clause_ends
          if effects.len() != start + count {
            panic("Checked handler clause lists cannot be interleaved")
          } else { nil }
          let index = effects.push(clause.effect_declaration)
          let ordinal = dense_index_value(index)
          let (atoms, atom_index) = clause_atoms.push(local, clause.atom)
          if dense_index_value(operations.push(clause.operation)) != ordinal or
            dense_index_value(atom_index) != ordinal or
            dense_index_value(parameters.push(parameter_list_ordinal(clause.parameters))) !=
            ordinal or
            dense_index_value(deferred_values.push(deferred)) != ordinal or
            dense_index_value(continuations.push(continuation)) != ordinal or
            dense_index_value(bodies.push(checked_expr_id_ordinal(clause.body))) != ordinal or
            dense_index_value(completions.push(clause.completion)) != ordinal or
            dense_index_value(starts.push(clause.range.start)) != ordinal or
            dense_index_value(ends.push(clause.range.end)) != ordinal {
              panic("Checked handler clause columns diverged")
            } else {
              (
                CheckedHandlerListBuilder(
                  CheckedHandlerListBuilderStorage {
                    parameter_values: parameter_values,
                    parameter_starts: parameter_starts,
                    parameter_counts: parameter_counts,
                    clause_effects: effects,
                    clause_operations: operations,
                    clause_atoms: atoms,
                    clause_parameters: parameters,
                    clause_deferred: deferred_values,
                    clause_continuations: continuations,
                    clause_bodies: bodies,
                    clause_completions: completions,
                    clause_starts: starts,
                    clause_ends: ends,
                    clause_list_starts: clause_list_starts,
                    clause_list_counts: clause_list_counts
                  }
                ),
                CheckedHandlerClauseListBuilder((segment, start, count + 1))
              )
            }
        }
      }
    }
  }

  fn clause_finish(
    self: owned Self,
    list: CheckedHandlerClauseListBuilder
  ) -> (owned CheckedHandlerListBuilder, CheckedHandlerClauseListId) {
    match list {
      CheckedHandlerClauseListBuilder((segment, start, count)) -> match self {
        CheckedHandlerListBuilder(storage) -> {
          let { parameter_values, parameter_starts, parameter_counts, clause_effects, clause_operations, clause_atoms, clause_parameters, clause_deferred, clause_continuations, clause_bodies, clause_completions, clause_starts, clause_ends, clause_list_starts, clause_list_counts } = storage
          if clause_effects.len() != start + count {
            panic("Checked handler clause list was not completed contiguously")
          } else { nil }
          let mut starts = clause_list_starts
          let mut counts = clause_list_counts
          let index = starts.push(start)
          if dense_index_value(counts.push(count)) != dense_index_value(index) {
            panic("Checked handler clause-list columns diverged")
          } else {
            (
              CheckedHandlerListBuilder(
                CheckedHandlerListBuilderStorage {
                  parameter_values: parameter_values,
                  parameter_starts: parameter_starts,
                  parameter_counts: parameter_counts,
                  clause_effects: clause_effects,
                  clause_operations: clause_operations,
                  clause_atoms: clause_atoms,
                  clause_parameters: clause_parameters,
                  clause_deferred: clause_deferred,
                  clause_continuations: clause_continuations,
                  clause_bodies: clause_bodies,
                  clause_completions: clause_completions,
                  clause_starts: clause_starts,
                  clause_ends: clause_ends,
                  clause_list_starts: starts,
                  clause_list_counts: counts
                }
              ),
              CheckedHandlerClauseListId((segment, index))
            )
          }
        }
      }
    }
  }

  fn freeze(self: owned Self) -> CheckedHandlerLists {
    match self {
      CheckedHandlerListBuilder(storage) -> {
        let { parameter_values, parameter_starts, parameter_counts, clause_effects, clause_operations, clause_atoms, clause_parameters, clause_deferred, clause_continuations, clause_bodies, clause_completions, clause_starts, clause_ends, clause_list_starts, clause_list_counts } = storage
        CheckedHandlerLists {
          parameter_values: parameter_values.freeze(),
          parameter_starts: parameter_starts.freeze(),
          parameter_counts: parameter_counts.freeze(),
          clause_effects: clause_effects.freeze(),
          clause_operations: clause_operations.freeze(),
          clause_atoms: clause_atoms.freeze(),
          clause_parameters: clause_parameters.freeze(),
          clause_deferred: clause_deferred.freeze(),
          clause_continuations: clause_continuations.freeze(),
          clause_bodies: clause_bodies.freeze(),
          clause_completions: clause_completions.freeze(),
          clause_starts: clause_starts.freeze(),
          clause_ends: clause_ends.freeze(),
          clause_list_starts: clause_list_starts.freeze(),
          clause_list_counts: clause_list_counts.freeze()
        }
      }
    }
  }
}

impl Drop for CheckedHandlerListBuilder {
  fn drop(self) -> nil {
    match self {
      CheckedHandlerListBuilder(storage) -> {
        let { parameter_values, parameter_starts, parameter_counts, clause_effects, clause_operations, clause_atoms, clause_parameters, clause_deferred, clause_continuations, clause_bodies, clause_completions, clause_starts, clause_ends, clause_list_starts, clause_list_counts } = storage
        parameter_values.drop()
        parameter_starts.drop()
        parameter_counts.drop()
        clause_effects.drop()
        clause_operations.drop()
        clause_atoms.drop()
        clause_parameters.drop()
        clause_deferred.drop()
        clause_continuations.drop()
        clause_bodies.drop()
        clause_completions.drop()
        clause_starts.drop()
        clause_ends.drop()
        clause_list_starts.drop()
        clause_list_counts.drop()
      }
    }
  }
}

fn perform_builder() -> owned CheckedPerformBuilder {
  CheckedPerformBuilder(
    CheckedPerformBuilderStorage {
      effects: dense_builder<DeclarationIdentity>(),
      operations: dense_builder<DeclarationIdentity>(),
      atoms: effect_type_builder(),
      arguments: dense_builder<usize>()
    }
  )
}

impl CheckedPerformBuilder {
  fn push(
    self: owned Self,
    local: SemanticTypeSegmentId,
    value: CheckedPerform
  ) -> (owned CheckedPerformBuilder, usize) {
    match self {
      CheckedPerformBuilder(storage) -> {
        let { effects, operations, atoms, arguments } = storage
        let mut next_effects = effects
        let mut next_operations = operations
        let mut next_arguments = arguments
        let index = next_effects.push(value.effect_declaration)
        let ordinal = dense_index_value(index)
        let (next_atoms, atom_index) = atoms.push(local, value.atom)
        if dense_index_value(next_operations.push(value.operation)) != ordinal or
          dense_index_value(atom_index) != ordinal or
          dense_index_value(next_arguments.push(checked_expr_list_id_ordinal(value.arguments))) !=
          ordinal {
            panic("Checked perform columns diverged")
          } else {
            (
              CheckedPerformBuilder(
                CheckedPerformBuilderStorage {
                  effects: next_effects,
                  operations: next_operations,
                  atoms: next_atoms,
                  arguments: next_arguments
                }
              ),
              ordinal
            )
          }
      }
    }
  }

  fn freeze(self: owned Self) -> CheckedPerforms {
    match self {
      CheckedPerformBuilder(storage) -> {
        let { effects, operations, atoms, arguments } = storage
        CheckedPerforms {
          effects: effects.freeze(),
          operations: operations.freeze(),
          atoms: atoms.freeze(),
          arguments: arguments.freeze()
        }
      }
    }
  }
}

impl Drop for CheckedPerformBuilder {
  fn drop(self) -> nil {
    match self {
      CheckedPerformBuilder(storage) -> {
        let { effects, operations, atoms, arguments } = storage
        effects.drop()
        operations.drop()
        atoms.drop()
        arguments.drop()
      }
    }
  }
}

fn handle_builder() -> owned CheckedHandleBuilder {
  CheckedHandleBuilder(
    CheckedHandleBuilderStorage {
      bodies: dense_builder<usize>(),
      clauses: dense_builder<usize>(),
      has_return: dense_builder<bool>(),
      return_bindings: dense_builder<usize>(),
      return_bodies: dense_builder<usize>()
    }
  )
}

impl CheckedHandleBuilder {
  fn push(
    self: owned Self,
    value: CheckedHandle,
    has_return: bool,
    return_binding: usize,
    return_body: usize
  ) -> (owned CheckedHandleBuilder, usize) {
    match self {
      CheckedHandleBuilder(storage) -> {
        let { bodies, clauses, has_return: has_returns, return_bindings, return_bodies } = storage
        let mut next_bodies = bodies
        let mut next_clauses = clauses
        let mut next_has_returns = has_returns
        let mut next_return_bindings = return_bindings
        let mut next_return_bodies = return_bodies
        let index = next_bodies.push(checked_expr_id_ordinal(value.body))
        let ordinal = dense_index_value(index)
        if dense_index_value(next_clauses.push(clause_list_ordinal(value.clauses))) != ordinal or
          dense_index_value(next_has_returns.push(has_return)) != ordinal or
          dense_index_value(next_return_bindings.push(return_binding)) != ordinal or
          dense_index_value(next_return_bodies.push(return_body)) != ordinal {
            panic("Checked handle columns diverged")
          } else {
            (
              CheckedHandleBuilder(
                CheckedHandleBuilderStorage {
                  bodies: next_bodies,
                  clauses: next_clauses,
                  has_return: next_has_returns,
                  return_bindings: next_return_bindings,
                  return_bodies: next_return_bodies
                }
              ),
              ordinal
            )
          }
      }
    }
  }

  fn freeze(self: owned Self) -> CheckedHandles {
    match self {
      CheckedHandleBuilder(storage) -> {
        let { bodies, clauses, has_return, return_bindings, return_bodies } = storage
        CheckedHandles {
          bodies: bodies.freeze(),
          clauses: clauses.freeze(),
          has_return: has_return.freeze(),
          return_bindings: return_bindings.freeze(),
          return_bodies: return_bodies.freeze()
        }
      }
    }
  }
}

impl Drop for CheckedHandleBuilder {
  fn drop(self) -> nil {
    match self {
      CheckedHandleBuilder(storage) -> {
        let { bodies, clauses, has_return, return_bindings, return_bodies } = storage
        bodies.drop()
        clauses.drop()
        has_return.drop()
        return_bindings.drop()
        return_bodies.drop()
      }
    }
  }
}

fn install_builder() -> owned CheckedInstallBuilder {
  CheckedInstallBuilder(
    CheckedInstallBuilderStorage {
      implementations: dense_builder<HandlerImplementationIdentity>(),
      type_arguments: dense_builder<usize>(),
      arguments: dense_builder<usize>(),
      atoms: effect_type_builder(),
      bodies: dense_builder<usize>(),
      source_sites: dense_builder<usize>()
    }
  )
}

impl CheckedInstallBuilder {
  fn push(
    self: owned Self,
    local: SemanticTypeSegmentId,
    value: CheckedHandlerInstall
  ) -> (owned CheckedInstallBuilder, usize) {
    match self {
      CheckedInstallBuilder(storage) -> {
        let { implementations, type_arguments, arguments, atoms, bodies, source_sites } = storage
        let mut next_implementations = implementations
        let mut next_type_arguments = type_arguments
        let mut next_arguments = arguments
        let mut next_bodies = bodies
        let mut next_source_sites = source_sites
        let index = next_implementations.push(value.implementation)
        let ordinal = dense_index_value(index)
        let (next_atoms, atom_index) = atoms.push(local, value.atom)
        if dense_index_value(
          next_type_arguments.push(checked_type_list_id_ordinal(value.type_arguments))
        ) != ordinal or
          dense_index_value(next_arguments.push(checked_expr_list_id_ordinal(value.arguments))) !=
          ordinal or
          dense_index_value(atom_index) != ordinal or
          dense_index_value(next_bodies.push(checked_expr_id_ordinal(value.body))) != ordinal or
          dense_index_value(next_source_sites.push(value.source_site)) != ordinal {
            panic("Checked handler-install columns diverged")
          } else {
            (
              CheckedInstallBuilder(
                CheckedInstallBuilderStorage {
                  implementations: next_implementations,
                  type_arguments: next_type_arguments,
                  arguments: next_arguments,
                  atoms: next_atoms,
                  bodies: next_bodies,
                  source_sites: next_source_sites
                }
              ),
              ordinal
            )
          }
      }
    }
  }

  fn freeze(self: owned Self) -> CheckedInstalls {
    match self {
      CheckedInstallBuilder(storage) -> {
        let { implementations, type_arguments, arguments, atoms, bodies, source_sites } = storage
        CheckedInstalls {
          implementations: implementations.freeze(),
          type_arguments: type_arguments.freeze(),
          arguments: arguments.freeze(),
          atoms: atoms.freeze(),
          bodies: bodies.freeze(),
          source_sites: source_sites.freeze()
        }
      }
    }
  }
}

impl Drop for CheckedInstallBuilder {
  fn drop(self) -> nil {
    match self {
      CheckedInstallBuilder(storage) -> {
        let { implementations, type_arguments, arguments, atoms, bodies, source_sites } = storage
        implementations.drop()
        type_arguments.drop()
        arguments.drop()
        atoms.drop()
        bodies.drop()
        source_sites.drop()
      }
    }
  }
}

pub(package) fn checked_effect_builder(
  expressions: borrow CheckedExprGraphBuilder,
  capacity: usize
) -> owned CheckedEffectBuilder {
  CheckedEffectBuilder(
    CheckedEffectBuilderStorage {
      segment: expressions.segment(),
      types: expressions.types(),
      headers: effect_header_builder(capacity),
      lists: handler_list_builder(),
      performs: perform_builder(),
      handles: handle_builder(),
      installs: install_builder()
    }
  )
}

impl CheckedEffectBuilder {
  pub(package) fn segment(self: borrow Self) -> CheckedExprSegmentId {
    match self { CheckedEffectBuilder(storage) -> storage.segment }
  }

  pub(package) fn len(self: borrow Self) -> usize {
    match self {
      CheckedEffectBuilder(storage) -> {
        let { segment: _, types: _, headers, lists: _, performs: _, handles: _, installs: _ } = storage
        headers.len()
      }
    }
  }

  pub(package) fn parameter_list(
    self: owned Self
  ) -> (owned CheckedEffectBuilder, CheckedHandlerParameterListBuilder) {
    match self {
      CheckedEffectBuilder(storage) -> {
        let { segment, types, headers, lists, performs, handles, installs } = storage
        match lists.parameter_begin(segment) {
          (next_lists, list) -> (
            CheckedEffectBuilder(
              CheckedEffectBuilderStorage {
                segment: segment,
                types: types,
                headers: headers,
                lists: next_lists,
                performs: performs,
                handles: handles,
                installs: installs
              }
            ),
            list
          )
        }
      }
    }
  }

  pub(package) fn parameter_list_push(
    self: owned Self,
    expressions: borrow CheckedExprGraphBuilder,
    list: CheckedHandlerParameterListBuilder,
    binding: CheckedBindingId
  ) -> (owned CheckedEffectBuilder, CheckedHandlerParameterListBuilder) {
    match self {
      CheckedEffectBuilder(storage) -> {
        let { segment, types, headers, lists, performs, handles, installs } = storage
        same_segment(segment, expressions.segment())
        same_segment(segment, checked_binding_id_segment(binding))
        let ordinal = checked_binding_id_ordinal(binding)
        if ordinal >= expressions.binding_len() {
          panic("Checked handler parameter is not published")
        } else { nil }
        match lists.parameter_push(list, ordinal) {
          (next_lists, next_list) -> (
            CheckedEffectBuilder(
              CheckedEffectBuilderStorage {
                segment: segment,
                types: types,
                headers: headers,
                lists: next_lists,
                performs: performs,
                handles: handles,
                installs: installs
              }
            ),
            next_list
          )
        }
      }
    }
  }

  pub(package) fn finish_parameter_list(
    self: owned Self,
    list: CheckedHandlerParameterListBuilder
  ) -> (owned CheckedEffectBuilder, CheckedHandlerParameterListId) {
    match self {
      CheckedEffectBuilder(storage) -> {
        let { segment, types, headers, lists, performs, handles, installs } = storage
        same_segment(
          segment,
          parameter_list_segment(
            match list {
              CheckedHandlerParameterListBuilder((owner, _, _)) ->
                CheckedHandlerParameterListId((owner, dense_index(0)))
            }
          )
        )
        match lists.parameter_finish(list) {
          (next_lists, id) -> (
            CheckedEffectBuilder(
              CheckedEffectBuilderStorage {
                segment: segment,
                types: types,
                headers: headers,
                lists: next_lists,
                performs: performs,
                handles: handles,
                installs: installs
              }
            ),
            id
          )
        }
      }
    }
  }

  pub(package) fn clause_list(
    self: owned Self
  ) -> (owned CheckedEffectBuilder, CheckedHandlerClauseListBuilder) {
    match self {
      CheckedEffectBuilder(storage) -> {
        let { segment, types, headers, lists, performs, handles, installs } = storage
        match lists.clause_begin(segment) {
          (next_lists, list) -> (
            CheckedEffectBuilder(
              CheckedEffectBuilderStorage {
                segment: segment,
                types: types,
                headers: headers,
                lists: next_lists,
                performs: performs,
                handles: handles,
                installs: installs
              }
            ),
            list
          )
        }
      }
    }
  }

  pub(package) fn clause_list_push(
    self: owned Self,
    expressions: borrow CheckedExprGraphBuilder,
    list: CheckedHandlerClauseListBuilder,
    clause: CheckedHandlerClause
  ) -> (owned CheckedEffectBuilder, CheckedHandlerClauseListBuilder) {
    match self {
      CheckedEffectBuilder(storage) -> {
        let { segment, types, headers, lists, performs, handles, installs } = storage
        same_segment(segment, expressions.segment())
        same_segment(segment, parameter_list_segment(clause.parameters))
        same_segment(segment, checked_expr_id_segment(clause.body))
        checked_effect_type(types, clause.atom)
        let empty: usize = 0
        let (deferred, continuation) = match clause.continuation {
          CheckedImmediateHandlerClause -> (false, empty)
          CheckedDeferredHandlerClause(binding) -> {
            same_segment(segment, checked_binding_id_segment(binding))
            let ordinal = checked_binding_id_ordinal(binding)
            if ordinal >= expressions.binding_len() {
              panic("Checked handler continuation is not published")
            } else { (true, ordinal) }
          }
        }
        if checked_expr_id_ordinal(clause.body) >= expressions.len() {
          panic("Checked handler clause body is not published")
        } else { nil }
        match lists.clause_push(
          semantic_type_segment_id(checked_expr_segment_module(segment)),
          list,
          clause,
          deferred,
          continuation
        ) {
          (next_lists, next_list) -> (
            CheckedEffectBuilder(
              CheckedEffectBuilderStorage {
                segment: segment,
                types: types,
                headers: headers,
                lists: next_lists,
                performs: performs,
                handles: handles,
                installs: installs
              }
            ),
            next_list
          )
        }
      }
    }
  }

  pub(package) fn finish_clause_list(
    self: owned Self,
    list: CheckedHandlerClauseListBuilder
  ) -> (owned CheckedEffectBuilder, CheckedHandlerClauseListId) {
    match self {
      CheckedEffectBuilder(storage) -> {
        let { segment, types, headers, lists, performs, handles, installs } = storage
        match list {
          CheckedHandlerClauseListBuilder((owner, _, _)) -> same_segment(segment, owner)
        }
        match lists.clause_finish(list) {
          (next_lists, id) -> (
            CheckedEffectBuilder(
              CheckedEffectBuilderStorage {
                segment: segment,
                types: types,
                headers: headers,
                lists: next_lists,
                performs: performs,
                handles: handles,
                installs: installs
              }
            ),
            id
          )
        }
      }
    }
  }

  pub(package) fn perform(
    self: owned Self,
    expressions: borrow CheckedExprGraphBuilder,
    value: CheckedPerform
  ) -> (owned CheckedEffectBuilder, CheckedEffectExprId) {
    match self {
      CheckedEffectBuilder(storage) -> {
        let { segment, types, headers, lists, performs, handles, installs } = storage
        same_segment(segment, expressions.segment())
        same_segment(segment, checked_expr_list_id_segment(value.arguments))
        checked_effect_type(types, value.atom)
        match performs.push(
          semantic_type_segment_id(checked_expr_segment_module(segment)),
          value
        ) {
          (next_performs, payload) -> match headers.push(
            segment,
            CheckedPerformDetailKind,
            payload
          ) {
            (next_headers, id) -> (
              CheckedEffectBuilder(
                CheckedEffectBuilderStorage {
                  segment: segment,
                  types: types,
                  headers: next_headers,
                  lists: lists,
                  performs: next_performs,
                  handles: handles,
                  installs: installs
                }
              ),
              id
            )
          }
        }
      }
    }
  }

  pub(package) fn handle_expr(
    self: owned Self,
    expressions: borrow CheckedExprGraphBuilder,
    value: CheckedHandle
  ) -> (owned CheckedEffectBuilder, CheckedEffectExprId) {
    match self {
      CheckedEffectBuilder(storage) -> {
        let { segment, types, headers, lists, performs, handles, installs } = storage
        same_segment(segment, expressions.segment())
        same_segment(segment, checked_expr_id_segment(value.body))
        same_segment(segment, clause_list_segment(value.clauses))
        let empty: usize = 0
        let (has_return, return_binding, return_body) = match value.return_clause {
          CheckedNoHandleReturn -> (false, empty, empty)
          CheckedHandleReturnClause(binding, body) -> {
            same_segment(segment, checked_binding_id_segment(binding))
            same_segment(segment, checked_expr_id_segment(body))
            let binding_ordinal = checked_binding_id_ordinal(binding)
            let body_ordinal = checked_expr_id_ordinal(body)
            if binding_ordinal >= expressions.binding_len() or body_ordinal >= expressions.len() {
              panic("Checked handler return clause is not published")
            } else { (true, binding_ordinal, body_ordinal) }
          }
        }
        match handles.push(value, has_return, return_binding, return_body) {
          (next_handles, payload) -> match headers.push(
            segment,
            CheckedHandleDetailKind,
            payload
          ) {
            (next_headers, id) -> (
              CheckedEffectBuilder(
                CheckedEffectBuilderStorage {
                  segment: segment,
                  types: types,
                  headers: next_headers,
                  lists: lists,
                  performs: performs,
                  handles: next_handles,
                  installs: installs
                }
              ),
              id
            )
          }
        }
      }
    }
  }

  pub(package) fn handler_install(
    self: owned Self,
    expressions: borrow CheckedExprGraphBuilder,
    value: CheckedHandlerInstall
  ) -> (owned CheckedEffectBuilder, CheckedEffectExprId) {
    match self {
      CheckedEffectBuilder(storage) -> {
        let { segment, types, headers, lists, performs, handles, installs } = storage
        same_segment(segment, expressions.segment())
        same_segment(segment, checked_type_list_id_segment(value.type_arguments))
        same_segment(segment, checked_expr_list_id_segment(value.arguments))
        same_segment(segment, checked_expr_id_segment(value.body))
        checked_effect_type(types, value.atom)
        match installs.push(
          semantic_type_segment_id(checked_expr_segment_module(segment)),
          value
        ) {
          (next_installs, payload) -> match headers.push(
            segment,
            CheckedHandlerInstallDetailKind,
            payload
          ) {
            (next_headers, id) -> (
              CheckedEffectBuilder(
                CheckedEffectBuilderStorage {
                  segment: segment,
                  types: types,
                  headers: next_headers,
                  lists: lists,
                  performs: performs,
                  handles: handles,
                  installs: next_installs
                }
              ),
              id
            )
          }
        }
      }
    }
  }

  pub(package) fn freeze(self: owned Self) -> CheckedEffectGraph {
    match self {
      CheckedEffectBuilder(storage) -> {
        let { segment, types: _, headers, lists, performs, handles, installs } = storage
        CheckedEffectGraph(
          CheckedEffectGraphStorage {
            segment: segment,
            headers: headers.freeze(),
            lists: lists.freeze(),
            performs: performs.freeze(),
            handles: handles.freeze(),
            installs: installs.freeze()
          }
        )
      }
    }
  }
}

impl CheckedEffectGraph {
  pub(package) fn segment(self: borrow Self) -> CheckedExprSegmentId {
    match self { CheckedEffectGraph(storage) -> storage.segment }
  }

  pub(package) fn len(self: borrow Self) -> usize {
    match self {
      CheckedEffectGraph(storage) -> {
        let { segment: _, headers, lists: _, performs: _, handles: _, installs: _ } = storage
        let { kinds, payloads: _ } = headers
        kinds.len()
      }
    }
  }

  pub(package) fn contains(self: borrow Self, id: CheckedEffectExprId) -> bool {
    checked_expr_segment_id_eq(self.segment(), checked_effect_expr_id_segment(id)) and
      checked_effect_expr_id_ordinal(id) < self.len()
  }

  fn index(self: borrow Self, id: CheckedEffectExprId) -> DenseIndex {
    same_segment(self.segment(), checked_effect_expr_id_segment(id))
    let ordinal = checked_effect_expr_id_ordinal(id)
    if ordinal >= self.len() { panic("Checked effect identity is out of bounds") }
    else { dense_index(ordinal) }
  }

  pub(package) fn kind(self: borrow Self, id: CheckedEffectExprId) -> CheckedEffectExprKind {
    let index = self.index(id)
    match self {
      CheckedEffectGraph(storage) -> {
        let { segment: _, headers, lists: _, performs: _, handles: _, installs: _ } = storage
        let { kinds, payloads: _ } = headers
        kinds.at(index)
      }
    }
  }

  pub(package) fn parameter_list_len(
    self: borrow Self,
    id: CheckedHandlerParameterListId
  ) -> usize {
    same_segment(self.segment(), parameter_list_segment(id))
    match self {
      CheckedEffectGraph(storage) -> {
        let { segment: _, headers: _, lists, performs: _, handles: _, installs: _ } = storage
        let { parameter_values: _, parameter_starts: _, parameter_counts, clause_effects: _, clause_operations: _, clause_atoms: _, clause_parameters: _, clause_deferred: _, clause_continuations: _, clause_bodies: _, clause_completions: _, clause_starts: _, clause_ends: _, clause_list_starts: _, clause_list_counts: _ } = lists
        parameter_counts.at(dense_index(parameter_list_ordinal(id)))
      }
    }
  }

  pub(package) fn parameter_list_at(
    self: borrow Self,
    id: CheckedHandlerParameterListId,
    position: usize
  ) -> CheckedBindingId {
    same_segment(self.segment(), parameter_list_segment(id))
    match self {
      CheckedEffectGraph(storage) -> {
        let { segment, headers: _, lists, performs: _, handles: _, installs: _ } = storage
        let { parameter_values, parameter_starts, parameter_counts, clause_effects: _, clause_operations: _, clause_atoms: _, clause_parameters: _, clause_deferred: _, clause_continuations: _, clause_bodies: _, clause_completions: _, clause_starts: _, clause_ends: _, clause_list_starts: _, clause_list_counts: _ } = lists
        let index = dense_index(parameter_list_ordinal(id))
        let count = parameter_counts.at(index)
        if position >= count { panic("Checked handler parameter position is out of bounds") }
        else {
          checked_binding_id_from_ordinal(
            segment,
            parameter_values.at(
              dense_index(parameter_starts.at(index) + position)
            )
          )
        }
      }
    }
  }

  pub(package) fn clause_list_len(
    self: borrow Self,
    id: CheckedHandlerClauseListId
  ) -> usize {
    same_segment(self.segment(), clause_list_segment(id))
    match self {
      CheckedEffectGraph(storage) -> {
        let { segment: _, headers: _, lists, performs: _, handles: _, installs: _ } = storage
        let { parameter_values: _, parameter_starts: _, parameter_counts: _, clause_effects: _, clause_operations: _, clause_atoms: _, clause_parameters: _, clause_deferred: _, clause_continuations: _, clause_bodies: _, clause_completions: _, clause_starts: _, clause_ends: _, clause_list_starts: _, clause_list_counts } = lists
        clause_list_counts.at(dense_index(clause_list_ordinal(id)))
      }
    }
  }

  pub(package) fn clause_list_at(
    self: borrow Self,
    id: CheckedHandlerClauseListId,
    position: usize
  ) -> CheckedHandlerClause {
    same_segment(self.segment(), clause_list_segment(id))
    match self {
      CheckedEffectGraph(storage) -> {
        let { segment, headers: _, lists, performs: _, handles: _, installs: _ } = storage
        let { parameter_values: _, parameter_starts: _, parameter_counts: _, clause_effects, clause_operations, clause_atoms, clause_parameters, clause_deferred, clause_continuations, clause_bodies, clause_completions, clause_starts, clause_ends, clause_list_starts, clause_list_counts } = lists
        let list = dense_index(clause_list_ordinal(id))
        let count = clause_list_counts.at(list)
        if position >= count { panic("Checked handler clause position is out of bounds") }
        else {
          let index = dense_index(clause_list_starts.at(list) + position)
          let continuation = if clause_deferred.at(index) {
            CheckedDeferredHandlerClause(
              checked_binding_id_from_ordinal(
                segment,
                clause_continuations.at(index)
              )
            )
          } else { CheckedImmediateHandlerClause }
          CheckedHandlerClause {
            effect_declaration: clause_effects.at(index),
            operation: clause_operations.at(index),
            atom: effect_type_at(
              clause_atoms,
              semantic_type_segment_id(checked_expr_segment_module(segment)),
              index
            ),
            parameters: CheckedHandlerParameterListId(
              (segment, dense_index(clause_parameters.at(index)))
            ),
            continuation: continuation,
            body: checked_expr_id_from_ordinal(
              segment,
              clause_bodies.at(index)
            ),
            completion: clause_completions.at(index),
            range: CheckedSourceRange {
              start: clause_starts.at(index),
              end: clause_ends.at(index)
            }
          }
        }
      }
    }
  }

  pub(package) fn inspect(self: borrow Self, id: CheckedEffectExprId) -> CheckedEffectExprNode {
    let index = self.index(id)
    match self {
      CheckedEffectGraph(storage) -> {
        let { segment, headers, lists: _, performs, handles, installs } = storage
        let { kinds, payloads } = headers
        let { effects: perform_effects, operations: perform_operations, atoms: perform_atoms, arguments: perform_arguments } = performs
        let { bodies: handle_bodies, clauses: handle_clauses, has_return, return_bindings, return_bodies } = handles
        let { implementations, type_arguments, arguments: install_arguments, atoms: install_atoms, bodies: install_bodies, source_sites } = installs
        let payload = dense_index(payloads.at(index))
        let local = semantic_type_segment_id(checked_expr_segment_module(segment))
        match kinds.at(index) {
          CheckedPerformDetailKind -> CheckedPerformDetail(
            CheckedPerform {
              effect_declaration: perform_effects.at(payload),
              operation: perform_operations.at(payload),
              atom: effect_type_at(perform_atoms, local, payload),
              arguments: checked_expr_list_id_from_ordinal(
                segment,
                perform_arguments.at(payload)
              )
            }
          )
          CheckedHandleDetailKind -> {
            let return_clause = if has_return.at(payload) {
              CheckedHandleReturnClause(
                checked_binding_id_from_ordinal(
                  segment,
                  return_bindings.at(payload)
                ),
                checked_expr_id_from_ordinal(
                  segment,
                  return_bodies.at(payload)
                )
              )
            } else { CheckedNoHandleReturn }
            CheckedHandleDetail(
              CheckedHandle {
                body: checked_expr_id_from_ordinal(
                  segment,
                  handle_bodies.at(payload)
                ),
                clauses: CheckedHandlerClauseListId(
                  (segment, dense_index(handle_clauses.at(payload)))
                ),
                return_clause: return_clause
              }
            )
          }
          CheckedHandlerInstallDetailKind -> CheckedHandlerInstallDetail(
            CheckedHandlerInstall {
              implementation: implementations.at(payload),
              type_arguments: checked_type_list_id_from_ordinal(
                segment,
                type_arguments.at(payload)
              ),
              arguments: checked_expr_list_id_from_ordinal(
                segment,
                install_arguments.at(payload)
              ),
              atom: effect_type_at(install_atoms, local, payload),
              body: checked_expr_id_from_ordinal(
                segment,
                install_bodies.at(payload)
              ),
              source_site: source_sites.at(payload)
            }
          )
        }
      }
    }
  }
}

impl Drop for CheckedEffectBuilder {
  fn drop(self) -> nil {
    match self {
      CheckedEffectBuilder(storage) -> {
        let { segment: _, types: _, headers, lists, performs, handles, installs } = storage
        headers.drop()
        lists.drop()
        performs.drop()
        handles.drop()
        installs.drop()
      }
    }
  }
}
