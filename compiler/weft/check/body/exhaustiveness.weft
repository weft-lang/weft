-- Exhaustiveness of a match over structured pattern spaces.
--
-- Each arm's pattern is summarised as the values it covers: every value, one
-- case of a variant family with the spaces of its payloads, a product of item
-- spaces, one boolean, or one half of a nil-sentinel union. A match is
-- exhaustive when no value escapes every unguarded arm, decided by asking
-- whether a wildcard row is still useful against the arms (the classic
-- pattern-matrix usefulness check). A pattern this summary cannot describe
-- precisely covers nothing, so an imprecise arm can never make an
-- inexhaustive match look exhaustive.
--
-- A column's constructors follow from the heads its rows name. Constructor
-- patterns require a scrutinee that is exactly the variant family, so case
-- columns are never nullable; nil and non-nil heads are the two halves of a
-- nil-sentinel union; booleans have two values; a product has one
-- constructor. Integer and string literals never complete a column.

use compiler/project/identity.{DeclarationIdentity}
use compiler/project/identity/equality.{declaration_identity_eq}
use stdlib/list.{Cons, List, Nil}
use stdlib/option.{None, Option, Some}

pub(package) type CheckedPatternSpace {
  -- Every value: a wildcard, a binding, or an irrefutable pattern.
  CheckedSpaceAll,
  -- No value the summary can vouch for: a literal of an unbounded domain, or
  -- a pattern described only imprecisely.
  CheckedSpaceNothing,
  -- One case of a family of `total` cases. `None` covers the whole case;
  -- otherwise the spaces of its payloads, in order.
  CheckedSpaceCase(DeclarationIdentity, usize, Option<List<CheckedPatternSpace>>),
  -- A tuple's items, in order.
  CheckedSpaceProduct(List<CheckedPatternSpace>),
  CheckedSpaceBoolean(bool),
  -- The nil half of a nil-sentinel union.
  CheckedSpaceNil,
  -- The non-nil half, with the space of the value it narrows to.
  CheckedSpaceNonNil(CheckedPatternSpace),
  -- Any of several spaces, as a typed arm naming several cases covers.
  CheckedSpaceUnion(List<CheckedPatternSpace>)
}

-- A constructor of one column, with the number of columns it expands to.
type CheckedSpaceConstructor {
  CheckedSpaceCaseConstructor(DeclarationIdentity, usize),
  CheckedSpaceProductConstructor(usize),
  CheckedSpaceBooleanConstructor(bool),
  CheckedSpaceNilConstructor,
  CheckedSpaceNonNilConstructor
}

-- Whether the rows' first column names every constructor of its domain.
type CheckedSpaceSignature {
  CheckedSpaceComplete(List<CheckedSpaceConstructor>),
  CheckedSpaceIncomplete
}

type CheckedSpaceRow = List<CheckedPatternSpace>

--- Whether the unguarded arms' spaces cover every value of the scrutinee.
pub(package) fn checked_pattern_spaces_exhaustive(arms: List<CheckedPatternSpace>) -> bool {
  not checked_spaces_uncovered(checked_space_rows(arms), 1)
}

fn checked_space_rows(arms: List<CheckedPatternSpace>) -> List<CheckedSpaceRow> {
  match arms {
    Nil -> Nil<CheckedSpaceRow>()
    Cons(space, rest) -> checked_space_rows(rest).prepend(
      Nil<CheckedPatternSpace>().prepend(space)
    )
  }
}

-- Whether some value vector of `width` columns escapes every row.
fn checked_spaces_uncovered(rows: List<CheckedSpaceRow>, width: usize) -> bool {
  if width == 0 { rows.is_empty() }
  else {
    let rows = checked_space_expand_unions(rows)
    match checked_space_signature(rows) {
      CheckedSpaceIncomplete -> checked_spaces_uncovered(checked_space_default(rows), width - 1)
      CheckedSpaceComplete(constructors) -> checked_spaces_uncovered_by_any(
        rows,
        width,
        constructors
      )
    }
  }
}

fn checked_spaces_uncovered_by_any(
  rows: List<CheckedSpaceRow>,
  width: usize,
  constructors: List<CheckedSpaceConstructor>
) -> bool {
  match constructors {
    Nil -> false
    Cons(constructor, rest) -> checked_spaces_uncovered(
      checked_space_specialize(rows, constructor),
      width - 1 + checked_space_constructor_arity(constructor)
    ) or checked_spaces_uncovered_by_any(rows, width, rest)
  }
}

fn checked_space_constructor_arity(constructor: CheckedSpaceConstructor) -> usize {
  let none: usize = 0
  let one: usize = 1
  match constructor {
    CheckedSpaceCaseConstructor(_, arity) -> arity
    CheckedSpaceProductConstructor(arity) -> arity
    CheckedSpaceBooleanConstructor(_) -> none
    CheckedSpaceNilConstructor -> none
    CheckedSpaceNonNilConstructor -> one
  }
}

-- The first column's constructors, when its heads name the whole domain.
fn checked_space_signature(rows: List<CheckedSpaceRow>) -> CheckedSpaceSignature {
  let heads = checked_space_heads(rows)
  match checked_space_case_constructors(heads, Nil<CheckedSpaceConstructor>(), 0) {
    Some(cases) -> CheckedSpaceComplete(cases)
    None -> match checked_space_product_arity(heads) {
      Some(arity) -> CheckedSpaceComplete(
        Nil<CheckedSpaceConstructor>().prepend(CheckedSpaceProductConstructor(arity))
      )
      None -> if checked_space_heads_have_boolean(heads, true) and
        checked_space_heads_have_boolean(heads, false) {
          CheckedSpaceComplete(
            Nil<CheckedSpaceConstructor>().prepend(CheckedSpaceBooleanConstructor(false)).prepend(
              CheckedSpaceBooleanConstructor(true)
            )
          )
        } else if checked_space_heads_have_nil(heads) and checked_space_heads_have_non_nil(heads) {
          CheckedSpaceComplete(
            Nil<CheckedSpaceConstructor>().prepend(CheckedSpaceNonNilConstructor).prepend(
              CheckedSpaceNilConstructor
            )
          )
        } else { CheckedSpaceIncomplete }
    }
  }
}

fn checked_space_heads(rows: List<CheckedSpaceRow>) -> List<CheckedPatternSpace> {
  match rows {
    Nil -> Nil<CheckedPatternSpace>()
    Cons(row, rest) -> match row {
      Nil -> checked_space_heads(rest)
      Cons(head, _) -> checked_space_heads(rest).prepend(head)
    }
  }
}

-- The case constructors the heads name, when they name all `total` cases of
-- one family; `None` otherwise.
fn checked_space_case_constructors(
  heads: List<CheckedPatternSpace>,
  found: List<CheckedSpaceConstructor>,
  total: usize
) -> Option<List<CheckedSpaceConstructor>> {
  match heads {
    Nil -> if total > 0 and found.len() == total { Some(found) } else {
      None<List<CheckedSpaceConstructor>>()
    }
    Cons(head, rest) -> match head {
      CheckedSpaceCase(declaration, family, payloads) -> if total != 0 and total != family {
        None<List<CheckedSpaceConstructor>>()
      } else if checked_space_case_listed(found, declaration) {
        checked_space_case_constructors(rest, found, family)
      } else {
        checked_space_case_constructors(
          rest,
          found.append(
            CheckedSpaceCaseConstructor(
              declaration,
              checked_space_case_arity(heads, declaration, payloads)
            )
          ),
          family
        )
      }
      _ -> checked_space_case_constructors(rest, found, total)
    }
  }
}

fn checked_space_case_listed(
  found: List<CheckedSpaceConstructor>,
  declaration: DeclarationIdentity
) -> bool {
  match found {
    Nil -> false
    Cons(constructor, rest) -> match constructor {
      CheckedSpaceCaseConstructor(existing, _) -> declaration_identity_eq(existing, declaration) or
        checked_space_case_listed(rest, declaration)
      _ -> checked_space_case_listed(rest, declaration)
    }
  }
}

-- A case's payload count, from the first head that spells its payloads.
fn checked_space_case_arity(
  heads: List<CheckedPatternSpace>,
  declaration: DeclarationIdentity,
  payloads: Option<List<CheckedPatternSpace>>
) -> usize {
  let none: usize = 0
  match payloads {
    Some(items) -> items.len()
    None -> match heads {
      Nil -> none
      Cons(head, rest) -> match head {
        CheckedSpaceCase(other, _, Some(items)) -> if declaration_identity_eq(other, declaration) {
          items.len()
        } else { checked_space_case_arity(rest, declaration, payloads) }
        _ -> checked_space_case_arity(rest, declaration, payloads)
      }
    }
  }
}

fn checked_space_product_arity(heads: List<CheckedPatternSpace>) -> Option<usize> {
  match heads {
    Nil -> None<usize>()
    Cons(head, rest) -> match head {
      CheckedSpaceProduct(items) -> Some(items.len())
      _ -> checked_space_product_arity(rest)
    }
  }
}

fn checked_space_heads_have_boolean(heads: List<CheckedPatternSpace>, wanted: bool) -> bool {
  match heads {
    Nil -> false
    Cons(head, rest) -> match head {
      CheckedSpaceBoolean(value) -> value == wanted or checked_space_heads_have_boolean(
        rest,
        wanted
      )
      _ -> checked_space_heads_have_boolean(rest, wanted)
    }
  }
}

fn checked_space_heads_have_nil(heads: List<CheckedPatternSpace>) -> bool {
  match heads {
    Nil -> false
    Cons(head, rest) -> match head {
      CheckedSpaceNil -> true
      _ -> checked_space_heads_have_nil(rest)
    }
  }
}

fn checked_space_heads_have_non_nil(heads: List<CheckedPatternSpace>) -> bool {
  match heads {
    Nil -> false
    Cons(head, rest) -> match head {
      CheckedSpaceNonNil(_) -> true
      _ -> checked_space_heads_have_non_nil(rest)
    }
  }
}

fn checked_space_wildcards(count: usize, rest: CheckedSpaceRow) -> CheckedSpaceRow {
  if count == 0 { rest } else {
    checked_space_wildcards(count - 1, rest.prepend(CheckedSpaceAll))
  }
}

-- The rows that match `constructor` in the first column, with its fields in
-- place of that column.
fn checked_space_specialize(
  rows: List<CheckedSpaceRow>,
  constructor: CheckedSpaceConstructor
) -> List<CheckedSpaceRow> {
  match rows {
    Nil -> Nil<CheckedSpaceRow>()
    Cons(row, rest) -> {
      let specialized = checked_space_specialize(rest, constructor)
      match row {
        Nil -> specialized
        Cons(head, tail) -> match checked_space_specialize_head(head, constructor, tail) {
          Some(next) -> specialized.prepend(next)
          None -> specialized
        }
      }
    }
  }
}

fn checked_space_specialize_head(
  head: CheckedPatternSpace,
  constructor: CheckedSpaceConstructor,
  tail: CheckedSpaceRow
) -> Option<CheckedSpaceRow> {
  match head {
    CheckedSpaceAll -> Some(
      checked_space_wildcards(checked_space_constructor_arity(constructor), tail)
    )
    CheckedSpaceNothing -> None<CheckedSpaceRow>()
    CheckedSpaceCase(declaration, _, payloads) -> match constructor {
      CheckedSpaceCaseConstructor(wanted, arity) -> if declaration_identity_eq(
        declaration,
        wanted
      ) {
        match payloads {
          None -> Some(checked_space_wildcards(arity, tail))
          Some(items) -> if items.len() == arity { Some(items.concat(tail)) }
          else { None<CheckedSpaceRow>() }
        }
      } else { None<CheckedSpaceRow>() }
      _ -> None<CheckedSpaceRow>()
    }
    CheckedSpaceProduct(items) -> match constructor {
      CheckedSpaceProductConstructor(arity) -> if items.len() == arity {
        Some(items.concat(tail))
      } else { None<CheckedSpaceRow>() }
      _ -> None<CheckedSpaceRow>()
    }
    CheckedSpaceBoolean(value) -> match constructor {
      CheckedSpaceBooleanConstructor(wanted) -> if value == wanted { Some(tail) }
      else { None<CheckedSpaceRow>() }
      _ -> None<CheckedSpaceRow>()
    }
    CheckedSpaceNil -> match constructor {
      CheckedSpaceNilConstructor -> Some(tail)
      _ -> None<CheckedSpaceRow>()
    }
    CheckedSpaceNonNil(inner) -> match constructor {
      CheckedSpaceNonNilConstructor -> Some(tail.prepend(inner))
      _ -> None<CheckedSpaceRow>()
    }
    -- Unions are expanded before a column is specialized.
    CheckedSpaceUnion(_) -> None<CheckedSpaceRow>()
  }
}

-- A row whose first column is a union stands for one row per alternative.
fn checked_space_expand_unions(rows: List<CheckedSpaceRow>) -> List<CheckedSpaceRow> {
  match rows {
    Nil -> Nil<CheckedSpaceRow>()
    Cons(row, rest) -> {
      let expanded = checked_space_expand_unions(rest)
      match row {
        Cons(CheckedSpaceUnion(alternatives), tail) -> checked_space_expand_unions(
          checked_space_alternative_rows(alternatives, tail)
        ).concat(expanded)
        _ -> expanded.prepend(row)
      }
    }
  }
}

fn checked_space_alternative_rows(
  alternatives: List<CheckedPatternSpace>,
  tail: CheckedSpaceRow
) -> List<CheckedSpaceRow> {
  match alternatives {
    Nil -> Nil<CheckedSpaceRow>()
    Cons(alternative, rest) -> checked_space_alternative_rows(rest, tail).prepend(
      tail.prepend(alternative)
    )
  }
}

-- The rows whose first column is a wildcard, without that column.
fn checked_space_default(rows: List<CheckedSpaceRow>) -> List<CheckedSpaceRow> {
  match rows {
    Nil -> Nil<CheckedSpaceRow>()
    Cons(row, rest) -> {
      let remaining = checked_space_default(rest)
      match row {
        Cons(CheckedSpaceAll, tail) -> remaining.prepend(tail)
        _ -> remaining
      }
    }
  }
}
