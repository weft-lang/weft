  fn record_pattern(
    self: owned Self,
    input_type: SemanticTypeId,
    shape: CheckedBodyRecordPatternShape,
    applications: SemanticRecordApplicationCatalog,
    names: List<str>,
    ordinals: List<usize>,
    range: CheckedSourceRange
  ) -> (owned CheckedBodyBuild, CheckedPatternId) {
    match self {
      CheckedBodyBuild(storage) -> {
        let { signatures, expressions, patterns, closures, effects, propagation } = storage
        let catalog = expressions.types()
        let segment = expressions.segment()
        let (patterns, list) = patterns.pattern_field_list()
        let (patterns, list) = checked_body_record_fields_into(
          patterns,
          segment,
          catalog,
          applications,
          input_type,
          shape,
          names,
          ordinals,
          list
        )
        let (patterns, fields) = patterns.pattern_field_list_finish(list)
        match patterns.record(fields, input_type, range) {
          (patterns, id) -> (
            CheckedBodyBuild(
              CheckedBodyBuildStorage {
                signatures: signatures,
                expressions: expressions,
                patterns: patterns,
                closures: closures,
                effects: effects,
                propagation: propagation
              }
            ),
            id
          )
        }
      }
    }
  }

