pub(package) type CheckedBodyProducerIssue {
  CheckedBodyProducerTypeRejected(SemanticTypeResolutionIssue),
  CheckedBodyProducerInvalidRange,
  CheckedBodyProducerUnknownIdentifier(CheckedSourceRange),
  CheckedBodyProducerUnknownField(CheckedSourceRange),
  CheckedBodyProducerImmutableAssignment(CheckedSourceRange),
  CheckedBodyProducerInferredBranchMismatch(SemanticTypeId, SemanticTypeId),
  CheckedBodyProducerLoopContextRequired,
  CheckedBodyProducerBreakOutsideLoop,
  CheckedBodyProducerContinueOutsideLoop,
  CheckedBodyProducerArityMismatch(usize, usize),
  CheckedBodyProducerGenericBoundRejected(SemanticTypeId, SemanticTypeId),
  CheckedBodyProducerGenericInferenceIncomplete(CheckedSourceRange),
  CheckedBodyProducerLambdaContextRequired(CheckedSourceRange),
  CheckedBodyProducerLambdaCaptureUnsupported(CheckedSourceRange),
  CheckedBodyProducerGenericDeclarationRequired(CheckedSourceRange),
  CheckedBodyProducerCallableRequired(SemanticTypeId),
  CheckedBodyProducerContinuationConsumerRequired(CheckedSourceRange),
  CheckedBodyProducerContinuationResultRequired(CheckedSourceRange),
  CheckedBodyProducerContinuationBranchEscape(CheckedSourceRange),
  CheckedBodyProducerContinuationMutableBinding(CheckedSourceRange),
  CheckedBodyProducerBinaryOperandMismatch(SemanticTypeId, SemanticTypeId),
  CheckedBodyProducerIntegerOperandRequired(SemanticTypeId),
  CheckedBodyProducerInvalidFloatLiteral(CheckedSourceRange),
  CheckedBodyProducerNumericOperandRequired(SemanticTypeId),
  CheckedBodyProducerNonExhaustiveMatch,
  CheckedBodyProducerCanonicalEqUnavailable,
  CheckedBodyProducerCanonicalEqInvalid(DeclarationIdentity),
  CheckedBodyProducerEqImplementationRequired(SemanticTypeId),
  CheckedBodyProducerCanonicalOrdUnavailable,
  CheckedBodyProducerCanonicalOrdInvalid(DeclarationIdentity),
  CheckedBodyProducerOrdImplementationRequired(SemanticTypeId),
  CheckedBodyProducerOrderingCaseUnavailable(str),
  CheckedBodyProducerCanonicalDisplayUnavailable,
  CheckedBodyProducerCanonicalDisplayInvalid(DeclarationIdentity),
  CheckedBodyProducerDisplayImplementationRequired(SemanticTypeId),
  CheckedBodyProducerCanonicalResultUnavailable,
  CheckedBodyProducerCanonicalFailUnavailable,
  CheckedBodyProducerResultOperandRequired(SemanticTypeId),
  CheckedBodyProducerTryEffectUnavailable(SemanticTypeId),
  CheckedBodyProducerOptionalBaseRequired(SemanticTypeId),
  CheckedBodyProducerMaybeEffectUnavailable,
  CheckedBodyProducerSignatureUnavailable(CheckedSourceRange),
  CheckedBodyProducerFieldProjectionUnavailable(SemanticTypeId),
  CheckedBodyProducerIndexedBaseRequired(SemanticTypeId),
  CheckedBodyProducerIterableRequired(SemanticTypeId),
  CheckedBodyProducerIteratorResultRequired(SemanticTypeId),
  CheckedBodyProducerIteratorItemInvalid(SemanticTypeId),
  CheckedBodyProducerIteratorItemUnresolved(SemanticTypeId),
  CheckedBodyProducerIteratorNextRequired(SemanticTypeId),
  CheckedBodyProducerIteratorOptionRequired(SemanticTypeId),
  CheckedBodyProducerIteratorOptionCaseRequired(SemanticTypeId),
  CheckedBodyProducerIteratorOptionItemMismatch(SemanticTypeId),
  CheckedBodyProducerIteratorOptionPayloadMismatch(SemanticTypeId),
  CheckedBodyProducerIndexedNamedBindingRequired(CheckedSourceRange),
  CheckedBodyProducerEffectReferenceRequired,
  CheckedBodyProducerEffectUnavailable(SemanticTypeId),
  CheckedBodyProducerEffectTailUnavailable(usize),
  CheckedBodyProducerEffectApplicationUnavailable,
  CheckedBodyProducerUnknownEffectOperation(CheckedSourceRange),
  CheckedBodyProducerAmbiguousEffectApplication(DeclarationIdentity),
  CheckedBodyProducerUnknownMethod(CheckedSourceRange),
  CheckedBodyProducerAmbiguousMethod(CheckedSourceRange),
  CheckedBodyProducerHandlerClauseRequired,
  CheckedBodyProducerHandlerEffectMismatch(SemanticTypeId, SemanticTypeId),
  CheckedBodyProducerHandlerContinuationRequiresDeferred,
  CheckedBodyProducerResumeOutsideHandler,
  CheckedBodyProducerBodyLocalTypeUnavailable(SemanticTypeId),
  CheckedBodyProducerUnsupportedBinaryOperator(i64),
  CheckedBodyProducerUnsupportedMatchArm,
  CheckedBodyProducerUnsupportedPattern,
  CheckedBodyProducerTuplePatternRequired(SemanticTypeId),
  CheckedBodyProducerTuplePatternArityMismatch(usize, usize),
  CheckedBodyProducerRecordPatternRequired(SemanticTypeId),
  CheckedBodyProducerDuplicateRecordPatternField(CheckedSourceRange),
  CheckedBodyProducerDuplicateRecordField(CheckedSourceRange),
  CheckedBodyProducerUnknownRecordType(CheckedSourceRange),
  CheckedBodyProducerNotRecordType(DeclarationIdentity),
  CheckedBodyProducerRecordTemplateUnavailable(DeclarationIdentity),
  CheckedBodyProducerRecordTemplateAmbiguous(DeclarationIdentity),
  CheckedBodyProducerRecordArgumentsUnresolved(DeclarationIdentity),
  CheckedBodyProducerMissingRecordField(DeclarationIdentity),
  CheckedBodyProducerRecordUpdateRequired(SemanticTypeId),
  CheckedBodyProducerVariantPatternRequired(SemanticTypeId),
  CheckedBodyProducerUnknownConstructor(CheckedSourceRange),
  CheckedBodyProducerConstructorResultRequired(CheckedSourceRange),
  CheckedBodyProducerConstructorResultAmbiguous(CheckedSourceRange),
  CheckedBodyProducerConstructorArityMismatch(usize, usize),
  CheckedBodyProducerConstructorPatternArityMismatch(usize, usize),
  CheckedBodyProducerUnsupportedParameter,
  CheckedBodyProducerTypeMismatch(SemanticTypeId, SemanticTypeId),
  CheckedBodyProducerUnsupportedExpression,
  CheckedBodyProducerFreezeRejected(CheckedBodyProductIssue)
}

pub(package) type CheckedBodyCheckResult {
  CheckedBodiesAccepted(CheckedBodyProduct),
  CheckedBodiesRejected(CheckedBodyProducerIssue)
}

type CheckedBodyPrimitiveTypes {
  module: RegisteredModule,
  sdk_package_id: i64,
  catalog: SemanticTypeCatalog,
  applications: SemanticRecordApplicationCatalog,
  variant_applications: SemanticVariantApplicationCatalog,
  effect_applications: SemanticEffectApplicationCatalog,
  resolution: SemanticResolutionProduct,
  never_type: SemanticTypeId,
  integer: SemanticTypeId,
  usize_type: SemanticTypeId,
  string: SemanticTypeId,
  boolean: SemanticTypeId,
  nil_type: SemanticTypeId,
  float64: SemanticTypeId,
  float32: SemanticTypeId
}

type CheckedBodyPrimitiveResolution {
  CheckedBodyPrimitivesResolved(CheckedBodyPrimitiveTypes),
  CheckedBodyPrimitivesRejected(SemanticTypeResolutionIssue)
}

fn checked_body_types_with_catalog(
  types: CheckedBodyPrimitiveTypes,
  catalog: SemanticTypeCatalog
) -> CheckedBodyPrimitiveTypes {
  CheckedBodyPrimitiveTypes {
    module: types.module,
    sdk_package_id: types.sdk_package_id,
    catalog: catalog,
    applications: types.applications,
    variant_applications: types.variant_applications,
    effect_applications: types.effect_applications,
    resolution: types.resolution,
    never_type: types.never_type,
    integer: types.integer,
    usize_type: types.usize_type,
    string: types.string,
    boolean: types.boolean,
    nil_type: types.nil_type,
    float64: types.float64,
    float32: types.float32
  }
}

fn checked_body_types_with_applications(
  types: CheckedBodyPrimitiveTypes,
  catalog: SemanticTypeCatalog,
  applications: SemanticRecordApplicationCatalog,
  variant_applications: SemanticVariantApplicationCatalog,
  effect_applications: SemanticEffectApplicationCatalog
) -> CheckedBodyPrimitiveTypes {
  CheckedBodyPrimitiveTypes {
    module: types.module,
    sdk_package_id: types.sdk_package_id,
    catalog: catalog,
    applications: applications,
    variant_applications: variant_applications,
    effect_applications: effect_applications,
    resolution: types.resolution,
    never_type: types.never_type,
    integer: types.integer,
    usize_type: types.usize_type,
    string: types.string,
    boolean: types.boolean,
    nil_type: types.nil_type,
    float64: types.float64,
    float32: types.float32
  }
}

type CheckedLexicalEnvironment {
  CheckedLexicalRoot(
    RegistrationScope,
    ModuleIdentity,
    TypeParamList,
    SemanticTypeId
  ),
  CheckedLexicalBinding(
    i64,
    i64,
    CheckedBindingId,
    SemanticTypeId,
    bool,
    CheckedLexicalEnvironment
  ),
  CheckedLexicalHandledEffect(SemanticTypeId, CheckedLexicalEnvironment),
  CheckedLexicalResume(
    SemanticTypeId,
    SemanticTypeId,
    CheckedLexicalEnvironment
  )
}

type CheckedLexicalLookup {
  CheckedLexicalFound(CheckedBindingId, SemanticTypeId, bool),
  CheckedLexicalMissing
}

type CheckedLexicalResumeLookup {
  CheckedLexicalResumeFound(SemanticTypeId, SemanticTypeId),
  CheckedLexicalResumeMissing
}

type CheckedBodyBuildStorage {
  signatures: SemanticSignatureProduct,
  expressions: owned CheckedExprGraphBuilder,
  patterns: owned CheckedPatternGraphBuilder,
  closures: owned CheckedClosureBuilder,
  effects: owned CheckedEffectBuilder,
  propagation: owned CheckedPropagationBuilder
}

type CheckedBodyBuild = opaque CheckedBodyBuildStorage

type CheckedBodyExprBuild {
  CheckedBodyExprBuilt(owned CheckedBodyBuild, CheckedExprId),
  CheckedBodyExprRejected(owned CheckedBodyBuild, CheckedBodyProducerIssue)
}

type CheckedBodyExpectation {
  CheckedInferResult,
  CheckedRequireResult(SemanticTypeId)
}

type CheckedLoopContext {
  CheckedOutsideLoop,
  CheckedInsideLoop(SemanticTypeId)
}

type CheckedBranchResult {
  CheckedBranchResolved(SemanticTypeId),
  CheckedBranchMismatch
}

type CheckedBodyFunctionsBuild {
  CheckedBodyFunctionsBuilt(owned CheckedBodyBuild),
  CheckedBodyFunctionsRejected(owned CheckedBodyBuild, CheckedBodyProducerIssue)
}

type CheckedBodyParametersBuild {
  CheckedBodyParametersBuilt(owned CheckedBodyBuild, CheckedLexicalEnvironment),
  CheckedBodyParametersRejected(owned CheckedBodyBuild, CheckedBodyProducerIssue)
}

type CheckedLambdaParametersBuild {
  CheckedLambdaParametersBuilt(
    owned CheckedBodyBuild,
    CheckedLexicalEnvironment,
    List<CheckedBindingId>
  ),
  CheckedLambdaParametersRejected(owned CheckedBodyBuild, CheckedBodyProducerIssue)
}

type CheckedLambdaAnnotationsBuild {
  CheckedLambdaAnnotationsResolved(owned CheckedBodyBuild, List<SemanticTypeId>),
  CheckedLambdaAnnotationsRejected(owned CheckedBodyBuild, CheckedBodyProducerIssue)
}

type CheckedBodyArgumentsBuild {
  CheckedBodyArgumentsBuilt(owned CheckedBodyBuild, CheckedExprListId, CheckedSourceRange),
  CheckedBodyArgumentsRejected(owned CheckedBodyBuild, CheckedBodyProducerIssue)
}

type CheckedConstructorPayloadSource {
  CheckedAppliedConstructor(usize),
  CheckedDeclaredConstructor(usize, usize)
}

type CheckedBodyArrayElementsBuild {
  CheckedBodyArrayElementsBuilt(
    owned CheckedBodyBuild,
    List<CheckedExprId>,
    List<SemanticTypeId>,
    CheckedSourceRange
  ),
  CheckedBodyArrayElementsRejected(owned CheckedBodyBuild, CheckedBodyProducerIssue)
}

-- Parallel source-order lists avoid placing an aggregate record inside a
-- cons cell while the aggregate transport issue remains open.
type CheckedBodyRecordValuesBuild {
  CheckedBodyRecordValuesBuilt(
    owned CheckedBodyBuild,
    List<str>,
    List<CheckedExprId>,
    List<SemanticTypeId>
  ),
  CheckedBodyRecordValuesRejected(owned CheckedBodyBuild, CheckedBodyProducerIssue)
}

type CheckedBodyRecordShape {
  CheckedStructuralRecordShape,
  CheckedTupleRecordShape,
  CheckedNominalRecordShape(Option<SemanticTypeId>)
}

type CheckedBodyRecordPatternShape {
  CheckedStructuralRecordPatternShape,
  CheckedDeclaredRecordPatternShape
}

type CheckedBodyRecordPatternFieldType {
  CheckedRecordPatternFieldSelected(SemanticTypeId),
  CheckedRecordPatternFieldMissing,
  CheckedRecordPatternFieldUnavailable
}

type CheckedNominalRecordTypeResolution {
  CheckedNominalRecordTypeResolved(
    SemanticTypeProductBuilder,
    Option<SemanticTypeId>
  ),
  CheckedNominalRecordTypeRejected(CheckedBodyProducerIssue)
}

type CheckedNominalRecordInference {
  CheckedNominalRecordInferred(SemanticTypeSubstitution),
  CheckedNominalRecordInferenceRejected(CheckedBodyProducerIssue)
}

type CheckedNominalRecordPreparation {
  CheckedNominalRecordPrepared(
    CheckedSourceRange,
    DeclarationIdentity,
    SemanticTypeId,
    usize,
    usize,
    Option<SemanticTypeId>,
    CheckedBodyPrimitiveTypes
  ),
  CheckedNominalRecordPreparationRejected(CheckedBodyProducerIssue)
}

type CheckedNominalRecordResolution {
  CheckedNominalRecordResolved(SemanticTypeId, CheckedBodyPrimitiveTypes),
  CheckedNominalRecordResolutionRejected(CheckedBodyProducerIssue)
}

type CheckedBodyIndexedShape {
  CheckedFixedIndexed(SemanticTypeId, usize),
  CheckedDynamicIndexed(SemanticTypeId),
  CheckedNotIndexed
}

type CheckedBodyIndexUse {
  CheckedElementRead,
  CheckedLengthRead
}

type CheckedBodyWritableShape {
  CheckedWritableArray(SemanticTypeId, isize),
  CheckedWritableSlice(SemanticTypeId),
  CheckedImmutableSlice,
  CheckedNotWritableIndexed
}

type CheckedBodySliceShape {
  CheckedSliceArray(SemanticTypeId),
  CheckedSliceVector(SemanticTypeId),
  CheckedSliceView(SemanticTypeId, SemanticMutability),
  CheckedNotSliceable
}

type CheckedBodyEffectArgumentsPreparation {
  CheckedBodyEffectArgumentsPrepared(
    owned CheckedBodyBuild,
    List<usize>,
    CheckedSourceRange
  ),
  CheckedBodyEffectArgumentsPreparationRejected(
    owned CheckedBodyBuild,
    CheckedBodyProducerIssue
  )
}

type CheckedBodyHandlerParametersBuild {
  CheckedBodyHandlerParametersBuilt(
    owned CheckedBodyBuild,
    CheckedHandlerParameterListBuilder,
    CheckedLexicalEnvironment
  ),
  CheckedBodyHandlerParametersRejected(
    owned CheckedBodyBuild,
    CheckedBodyProducerIssue
  )
}

