  fn freeze(
    self: owned Self,
    declarations: SemanticTypeDeclarationCatalog
  ) -> CheckedBodyCheckResult {
    match self {
      CheckedBodyBuild(storage) -> {
        let { signatures, expressions, patterns, closures, effects, propagation } = storage
        let expressions = expressions.freeze()
        let borrows = checked_borrow_facts_conservative(expressions, declarations)
        match checked_body_product(
          signatures,
          declarations,
          expressions,
          patterns.freeze(),
          closures.freeze(),
          effects.freeze(),
          propagation.freeze(),
          borrows
        ) {
          CheckedBodyProductAccepted(product) -> CheckedBodiesAccepted(product)
          CheckedBodyProductRejected(issue) -> CheckedBodiesRejected(
            CheckedBodyProducerFreezeRejected(issue)
          )
        }
      }
    }
  }
}

impl Drop for CheckedBodyBuild {
  fn drop(self) -> nil {
    match self {
      CheckedBodyBuild(storage) -> {
        let { signatures: _, expressions, patterns, closures, effects, propagation } = storage
        expressions.drop()
        patterns.drop()
        closures.drop()
        effects.drop()
        propagation.drop()
      }
    }
  }
}

fn checked_body_parameters(
  state: owned CheckedBodyBuild,
  source: Source,
  catalog: SemanticTypeCatalog,
  signature: SemanticFunctionSignature,
  parameters: ParamList,
  index: usize,
  environment: CheckedLexicalEnvironment
) -> CheckedBodyParametersBuild {
  match parameters {
    ParamListNil -> if index == semantic_function_parameter_count(catalog, signature.type_id) {
      CheckedBodyParametersBuilt(state, environment)
    } else {
      CheckedBodyParametersRejected(state, CheckedBodyProducerUnsupportedParameter)
    }
    ParamListCons(parameter, rest) -> match parameter {
      Param(start, length, _, _) -> match source_range(source, start, length) {
        range: CheckedSourceRange -> {
          let value_type = semantic_function_parameter(catalog, signature.type_id, index)
          match state.binding(
            signature.identity,
            value_type,
            range,
            CheckedImmutableBinding
          ) {
            (state, binding) -> checked_body_parameters(
              state.function_parameter(binding),
              source,
              catalog,
              signature,
              rest,
              index + 1,
              CheckedLexicalBinding(
                start,
                length,
                binding,
                value_type,
                false,
                environment
              )
            )
          }
        }
        nil -> CheckedBodyParametersRejected(state, CheckedBodyProducerInvalidRange)
      }
      _ -> CheckedBodyParametersRejected(
        state,
        CheckedBodyProducerUnsupportedParameter
      )
    }
  }
}

fn checked_body_lambda_parameters(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_type: SemanticTypeId,
  parameters: ParamList,
  index: usize,
  environment: CheckedLexicalEnvironment,
  bindings: List<CheckedBindingId>
) -[SemanticConformance]> CheckedLambdaParametersBuild {
  let catalog = state.types()
  match parameters {
    ParamListNil -> if index == semantic_function_parameter_count(catalog, function_type) {
      CheckedLambdaParametersBuilt(state, environment, bindings)
    } else {
      CheckedLambdaParametersRejected(
        state,
        CheckedBodyProducerArityMismatch(
          semantic_function_parameter_count(catalog, function_type),
          index
        )
      )
    }
    ParamListCons(parameter, rest) -> if index >= semantic_function_parameter_count(
      catalog,
      function_type
    ) {
      CheckedLambdaParametersRejected(
        state,
        CheckedBodyProducerArityMismatch(
          semantic_function_parameter_count(catalog, function_type),
          index + __i64_to_usize(param_list_len(parameters))
        )
      )
    } else {
      match parameter {
        Param(start, length, annotation, _) -> match source_range(source, start, length) {
          range: CheckedSourceRange -> {
            let expected = semantic_function_parameter(catalog, function_type, index)
            match annotation {
              MissingTypeExpr -> match state.binding(
                owner,
                expected,
                range,
                CheckedImmutableBinding
              ) {
                (state, binding) -> checked_body_lambda_parameters(
                  state,
                  source,
                  types,
                  owner,
                  function_type,
                  rest,
                  index + 1,
                  CheckedLexicalBinding(
                    start,
                    length,
                    binding,
                    expected,
                    false,
                    environment
                  ),
                  bindings.append(binding)
                )
              }
              _ -> {
                let resolution = types.resolution
                let segment = catalog.next_derived_segment(
                  types.module.identity,
                  resolution.next_type_segment()
                )
                match resolve_type_product_in_scope(
                  semantic_type_product_continue(types.module.identity, catalog, segment),
                  types.module,
                  lexical_scope(environment),
                  lexical_type_parameters(environment),
                  annotation
                ) {
                  (_, SemanticTypeRejected(issue)) -> CheckedLambdaParametersRejected(
                    state,
                    CheckedBodyProducerTypeRejected(issue)
                  )
                  (product, SemanticTypeResolved(declared)) -> {
                    let next_catalog = semantic_type_product_catalog(product)
                    if not semantic_type_is_subtype(next_catalog, expected, declared) {
                      CheckedLambdaParametersRejected(
                        state,
                        CheckedBodyProducerTypeMismatch(expected, declared)
                      )
                    } else {
                      match state.with_types(next_catalog).binding(
                        owner,
                        declared,
                        range,
                        CheckedImmutableBinding
                      ) {
                        (state, binding) -> checked_body_lambda_parameters(
                          state,
                          source,
                          types,
                          owner,
                          function_type,
                          rest,
                          index + 1,
                          CheckedLexicalBinding(
                            start,
                            length,
                            binding,
                            declared,
                            false,
                            environment
                          ),
                          bindings.append(binding)
                        )
                      }
                    }
                  }
                }
              }
            }
          }
          nil -> CheckedLambdaParametersRejected(state, CheckedBodyProducerInvalidRange)
        }
        _ -> CheckedLambdaParametersRejected(
          state,
          CheckedBodyProducerUnsupportedParameter
        )
      }
    }
  }
}

fn checked_body_lambda_annotations(
  state: owned CheckedBodyBuild,
  types: CheckedBodyPrimitiveTypes,
  environment: CheckedLexicalEnvironment,
  parameters: ParamList,
  site: CheckedSourceRange,
  values: List<SemanticTypeId>
) -> CheckedLambdaAnnotationsBuild {
  match parameters {
    ParamListNil -> CheckedLambdaAnnotationsResolved(state, values)
    ParamListCons(parameter, rest) -> match parameter {
      Param(_, _, annotation, _) -> match annotation {
        MissingTypeExpr -> CheckedLambdaAnnotationsRejected(
          state,
          CheckedBodyProducerLambdaContextRequired(site)
        )
        _ -> {
          let catalog = state.types()
          let module = types.module
          let resolution = types.resolution
          let segment = catalog.next_derived_segment(
            module.identity,
            resolution.next_type_segment()
          )
          match resolve_type_product_in_scope(
            semantic_type_product_continue(module.identity, catalog, segment),
            module,
            lexical_scope(environment),
            lexical_type_parameters(environment),
            annotation
          ) {
            (_, SemanticTypeRejected(issue)) -> CheckedLambdaAnnotationsRejected(
              state,
              CheckedBodyProducerTypeRejected(issue)
            )
            (product, SemanticTypeResolved(resolved)) -> checked_body_lambda_annotations(
              state.with_types(semantic_type_product_catalog(product)),
              types,
              environment,
              rest,
              site,
              values.append(resolved)
            )
          }
        }
      }
      _ -> CheckedLambdaAnnotationsRejected(
        state,
        CheckedBodyProducerUnsupportedParameter
      )
    }
  }
}

fn checked_body_standalone_lambda(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  environment: CheckedLexicalEnvironment,
  parameters: ParamList,
  body: Expr,
  source_site: i64,
  site: CheckedSourceRange
) -[SemanticConformance]> CheckedBodyExprBuild {
  match checked_body_lambda_annotations(
    state,
    types,
    environment,
    parameters,
    site,
    Nil<SemanticTypeId>()
  ) {
    CheckedLambdaAnnotationsRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
    CheckedLambdaAnnotationsResolved(state, annotations) -> {
      let catalog = state.types()
      let module = types.module
      let resolution = types.resolution
      let segment = semantic_type_derived_segment_id(
        module.identity,
        catalog.next_derived_segment(module.identity, resolution.next_type_segment())
      )
      let builder = semantic_type_graph_builder(segment)
      let (builder, result_ceiling) = builder.top()
      let (builder, parameter_list) = builder.type_list(annotations)
      let (builder, no_effects) = builder.type_list(Nil<SemanticTypeId>())
      let (builder, effects) = builder.effect_signature(no_effects, SemanticClosedEffects)
      let (builder, function_type) = builder.function(parameter_list, result_ceiling, effects)
      let next_catalog = semantic_type_catalog_with_graph(catalog, builder.freeze())
      checked_body_lambda(
        state.with_types(next_catalog),
        source,
        checked_body_types_with_catalog(types, next_catalog),
        owner,
        environment,
        parameters,
        body,
        source_site,
        CheckedRequireResult(function_type),
        true
      )
    }
  }
}

-- Primitive values can be copied into an immutable closure environment.
-- Aggregate, borrowed, unique and resource captures need ownership proofs
-- that this producer does not yet publish, so they remain structural refusals.
fn checked_body_lambda_captures_safe(
  state: borrow CheckedBodyBuild,
  captures: List<CheckedBindingId>
) -> bool {
  match captures {
    Nil -> true
    Cons(binding, remaining) -> {
      let detail = state.binding_info(binding)
      match detail.mutability {
        CheckedMutableBinding -> false
        CheckedImmutableBinding -> {
          let catalog = state.types()
          match catalog.graph_for(detail.value_type) {
            Some(graph) -> match semantic_type_graph_node(graph, detail.value_type) {
              SemanticPrimitiveNode(_) -> checked_body_lambda_captures_safe(state, remaining)
              _ -> false
            }
            None -> false
          }
        }
      }
    }
  }
}

fn checked_body_lambda_inferred_type(
  catalog: SemanticTypeCatalog,
  types: CheckedBodyPrimitiveTypes,
  function_type: SemanticTypeId,
  body_result: SemanticTypeId
) -> (SemanticTypeCatalog, SemanticTypeId) {
  let effects = match catalog.graph_for(function_type) {
    Some(graph) -> match semantic_type_graph_node(graph, function_type) {
      SemanticFunctionNode(_, _, effects) -> effects
      _ -> panic("Inferred lambda context must be a function")
    }
    None -> panic("Inferred lambda context is outside its type catalog")
  }
  let parameters = semantic_function_parameters_into(
    catalog,
    function_type,
    0,
    Nil<SemanticTypeId>()
  )
  let module = types.module
  let resolution = types.resolution
  let segment = semantic_type_derived_segment_id(
    module.identity,
    catalog.next_derived_segment(module.identity, resolution.next_type_segment())
  )
  let builder = semantic_type_graph_builder(segment)
  let (builder, parameter_list) = builder.type_list(parameters)
  let (builder, inferred) = builder.function(parameter_list, body_result, effects)
  (semantic_type_catalog_with_graph(catalog, builder.freeze()), inferred)
}

fn checked_body_lambda(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  environment: CheckedLexicalEnvironment,
  parameters: ParamList,
  body: Expr,
  source_site: i64,
  expectation: CheckedBodyExpectation,
  infer_body_result: bool
) -[SemanticConformance]> CheckedBodyExprBuild {
  match source_range(source, source_site, 2) {
    nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
    site: CheckedSourceRange -> match expectation {
      CheckedInferResult -> checked_body_standalone_lambda(
        state,
        source,
        types,
        owner,
        environment,
        parameters,
        body,
        source_site,
        site
      )
      CheckedRequireResult(function_type) -> {
        let catalog = state.types()
        match catalog.graph_for(function_type) {
          Some(graph) -> match semantic_type_graph_node(graph, function_type) {
            SemanticFunctionNode(_, result, _) -> {
              let first_expression = state.expression_count()
              let first_binding = state.binding_count()
              match checked_body_lambda_parameters(
                state,
                source,
                types,
                owner,
                function_type,
                parameters,
                0,
                lexical_lambda_environment(environment, function_type),
                Nil<CheckedBindingId>()
              ) {
                CheckedLambdaParametersRejected(state, issue) ->
                  CheckedBodyExprRejected(state, issue)
                CheckedLambdaParametersBuilt(state, lambda_environment, bindings) -> {
                  let body_expectation = if infer_body_result { CheckedInferResult }
                  else { CheckedRequireResult(result) }
                  match checked_body_expr(
                    state,
                    source,
                    types,
                    owner,
                    result,
                    CheckedOutsideLoop,
                    lambda_environment,
                    body,
                    body_expectation
                  ) {
                    CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
                    CheckedBodyExprBuilt(state, checked_body) -> {
                      let captures = state.outer_references_since(
                        first_expression,
                        first_binding
                      )
                      if not checked_body_lambda_captures_safe(state, captures) {
                        CheckedBodyExprRejected(
                          state,
                          CheckedBodyProducerLambdaCaptureUnsupported(site)
                        )
                      } else {
                        match covering_range(site, state.range(checked_body)) {
                          nil -> CheckedBodyExprRejected(
                            state,
                            CheckedBodyProducerInvalidRange
                          )
                          range: CheckedSourceRange -> if infer_body_result {
                            let actual_result = state.result_type(checked_body)
                            let current_catalog = state.types()
                            if semantic_type_catalog_equal(
                              current_catalog,
                              actual_result,
                              types.never_type
                            ) {
                              CheckedBodyExprRejected(
                                state,
                                CheckedBodyProducerGenericInferenceIncomplete(site)
                              )
                            } else {
                              let (next_catalog, inferred_type) = checked_body_lambda_inferred_type(
                                current_catalog,
                                types,
                                function_type,
                                actual_result
                              )
                              match state.with_types(next_catalog).lambda(
                                bindings,
                                captures,
                                checked_body,
                                __i64_to_usize(source_site),
                                inferred_type,
                                range
                              ) {
                                (state, expression) -> CheckedBodyExprBuilt(state, expression)
                              }
                            }
                          } else {
                            match state.lambda(
                              bindings,
                              captures,
                              checked_body,
                              __i64_to_usize(source_site),
                              function_type,
                              range
                            ) {
                              (state, expression) -> CheckedBodyExprBuilt(state, expression)
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
            _ -> CheckedBodyExprRejected(
              state,
              CheckedBodyProducerCallableRequired(function_type)
            )
          }
          _ -> CheckedBodyExprRejected(
            state,
            CheckedBodyProducerCallableRequired(function_type)
          )
        }
      }
    }
  }
}

fn expectation_allows(
  catalog: borrow SemanticTypeCatalog,
  actual: SemanticTypeId,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> bool {
  match expectation {
    CheckedInferResult -> true
    CheckedRequireResult(expected) -> semantic_type_is_subtype(catalog, actual, expected)
  }
}

fn expectation_mismatch(
  actual: SemanticTypeId,
  expectation: CheckedBodyExpectation
) -> CheckedBodyProducerIssue {
  match expectation {
    CheckedRequireResult(expected) -> CheckedBodyProducerTypeMismatch(actual, expected)
    CheckedInferResult -> panic("Inferred checked expression cannot mismatch its context")
  }
}

fn contextual_integer_type(
  catalog: borrow SemanticTypeCatalog,
  fallback: SemanticTypeId,
  expectation: CheckedBodyExpectation
) -> SemanticTypeId {
  match expectation {
    CheckedRequireResult(expected) -> if semantic_integer_type(catalog, expected) {
      expected
    } else { fallback }
    CheckedInferResult -> fallback
  }
}

fn contextual_float_type(
  catalog: borrow SemanticTypeCatalog,
  types: CheckedBodyPrimitiveTypes,
  expectation: CheckedBodyExpectation
) -> SemanticTypeId {
  match expectation {
    CheckedRequireResult(expected) -> if semantic_type_catalog_equal(
      catalog,
      expected,
      types.float32
    ) or semantic_type_catalog_equal(catalog, expected, types.float64) {
      expected
    } else { types.float64 }
    CheckedInferResult -> types.float64
  }
}

fn checked_float_literal_value(
  source: Source,
  start: i64,
  length: i64,
  float32: bool
) -> Option<f64> {
  let result = if float32 {
    runtime_float_decimal_f32_bits(
      __str_ptr(source.text),
      start,
      length
    )
  } else {
    runtime_float_decimal_f64_bits(
      __str_ptr(source.text),
      start,
      length
    )
  }
  if runtime_float_bits_result_ok(result) == 0 { None<f64>() }
  else {
    let bits = runtime_float_bits_result_bits(result)
    if float32 {
      Some<f64>(__f32_to_f64(runtime_f32_from_bits(__i64_to_u32(bits))))
    } else {
      Some<f64>(runtime_f64_from_bits(__i64_to_u64(bits)))
    }
  }
}

fn branch_expectations(
  expectation: CheckedBodyExpectation
) -> (CheckedBodyExpectation, CheckedBodyExpectation, CheckedBodyExpectation) {
  match expectation {
    CheckedInferResult -> (
      CheckedInferResult,
      CheckedInferResult,
      CheckedInferResult
    )
    CheckedRequireResult(expected) -> (
      CheckedRequireResult(expected),
      CheckedRequireResult(expected),
      CheckedRequireResult(expected)
    )
  }
}

fn negation_expectations(
  catalog: borrow SemanticTypeCatalog,
  expectation: CheckedBodyExpectation
) -> (CheckedBodyExpectation, CheckedBodyExpectation) {
  match expectation {
    CheckedInferResult -> (CheckedInferResult, CheckedInferResult)
    CheckedRequireResult(expected) -> if semantic_numeric_type(catalog, expected) {
      (CheckedRequireResult(expected), CheckedRequireResult(expected))
    } else { (CheckedInferResult, CheckedRequireResult(expected)) }
  }
}

fn checked_branch_result(
  expectation: CheckedBodyExpectation,
  then_type: SemanticTypeId,
  else_type: SemanticTypeId
) -> CheckedBranchResult {
  match expectation {
    CheckedRequireResult(expected) -> CheckedBranchResolved(expected)
    CheckedInferResult -> if semantic_type_id_eq(then_type, else_type) {
      CheckedBranchResolved(then_type)
    } else { CheckedBranchMismatch }
  }
}

fn checked_body_block(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  first: Expr,
  rest: Expr,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  match checked_body_expr(
    state,
    source,
    types,
    owner,
    function_result,
    loop_context,
    environment,
    first,
    CheckedInferResult
  ) {
    CheckedBodyExprBuilt(state, checked_first) -> match checked_body_expr(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      rest,
      expectation
    ) {
      CheckedBodyExprBuilt(state, checked_rest) -> {
        let result = state.result_type(checked_rest)
        let first_range = state.range(checked_first)
        let rest_range = state.range(checked_rest)
        match covering_range(first_range, rest_range) {
          range: CheckedSourceRange ->
            match state.block(
              checked_first,
              checked_rest,
              result,
              range
            ) {
              (state, expression) -> CheckedBodyExprBuilt(state, expression)
            }
          nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
        }
      }
      CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
    }
    CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
  }
}

fn checked_body_if(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  condition: Expr,
  then_branch: Expr,
  else_branch: Expr,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  let (then_expectation, else_expectation, result_expectation) = branch_expectations(
    expectation
  )
  match checked_body_expr(
    state,
    source,
    types,
    owner,
    function_result,
    loop_context,
    environment,
    condition,
    CheckedRequireResult(types.boolean)
  ) {
    CheckedBodyExprBuilt(state, checked_condition) -> match checked_body_expr(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      then_branch,
      then_expectation
    ) {
      CheckedBodyExprBuilt(state, checked_then) -> match checked_body_expr(
        state,
        source,
        types,
        owner,
        function_result,
        loop_context,
        environment,
        else_branch,
        else_expectation
      ) {
        CheckedBodyExprBuilt(state, checked_else) -> {
          let then_type = state.result_type(checked_then)
          let else_type = state.result_type(checked_else)
          match checked_branch_result(result_expectation, then_type, else_type) {
            CheckedBranchResolved(result) -> {
              let current_catalog = state.types()
              let then_continuation = semantic_continuation_type(current_catalog, then_type)
              let else_continuation = semantic_continuation_type(current_catalog, else_type)
              if then_continuation or else_continuation {
                let escaping_range = if then_continuation {
                  state.range(checked_then)
                } else { state.range(checked_else) }
                CheckedBodyExprRejected(
                  state,
                  CheckedBodyProducerContinuationBranchEscape(escaping_range)
                )
              } else {
                let condition_range = state.range(checked_condition)
                let else_range = state.range(checked_else)
                match covering_range(condition_range, else_range) {
                  range: CheckedSourceRange ->
                    match state.if_expr(
                      checked_condition,
                      checked_then,
                      checked_else,
                      result,
                      range
                    ) {
                      (state, expression) -> CheckedBodyExprBuilt(state, expression)
                    }
                  nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
                }
              }
            }
            CheckedBranchMismatch -> CheckedBodyExprRejected(
              state,
              CheckedBodyProducerInferredBranchMismatch(then_type, else_type)
            )
          }
        }
        CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
      }
      CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
    }
    CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
  }
}

fn checked_body_while(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  condition: Expr,
  body: Expr,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  let catalog = types.catalog
  if not expectation_allows(catalog, types.nil_type, expectation) {
    CheckedBodyExprRejected(
      state,
      expectation_mismatch(types.nil_type, expectation)
    )
  } else {
    match checked_body_expr(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      condition,
      CheckedRequireResult(types.boolean)
    ) {
      CheckedBodyExprBuilt(state, checked_condition) -> match checked_body_expr(
        state,
        source,
        types,
        owner,
        function_result,
        CheckedInsideLoop(types.nil_type),
        environment,
        body,
        CheckedInferResult
      ) {
        CheckedBodyExprBuilt(state, checked_body) -> {
          let condition_range = state.range(checked_condition)
          let body_range = state.range(checked_body)
          match covering_range(condition_range, body_range) {
            range: CheckedSourceRange ->
              match state.while_expr(
                checked_condition,
                checked_body,
                types.nil_type,
                range
              ) {
                (state, expression) -> CheckedBodyExprBuilt(state, expression)
              }
            nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
          }
        }
        CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
      }
      CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
    }
  }
}

-- Indexed iteration is elaborated once into ordinary checked bindings and
-- control flow. Advancing before the authored body makes `continue` visit the
-- next item without a second, hidden control-flow edge.
fn checked_body_for_indexed(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  environment: CheckedLexicalEnvironment,
  name_start: i64,
  name_length: i64,
  checked_collection: CheckedExprId,
  item_type: SemanticTypeId,
  fixed_length: isize,
  body: Expr
) -[SemanticConformance]> CheckedBodyExprBuild {
  match source_range(source, name_start, name_length) {
    nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
    name_range: CheckedSourceRange -> {
      let collection_type = state.result_type(checked_collection)
      let collection_range = state.range(checked_collection)
      let generated_range = CheckedSourceRange {
        start: name_range.start,
        end: name_range.start
      }
      let (state, collection_binding) = state.binding(
        owner,
        collection_type,
        generated_range,
        CheckedImmutableBinding
      )
      let (state, index_binding) = state.binding(
        owner,
        types.usize_type,
        generated_range,
        CheckedMutableBinding
      )
      let (state, item_binding) = state.binding(
        owner,
        item_type,
        name_range,
        CheckedImmutableBinding
      )
      let (state, zero) = state.integer(0, types.usize_type, generated_range)
      let (state, condition_index) = state.local_reference(
        index_binding,
        types.usize_type,
        generated_range
      )
      let (state, condition_collection) = state.local_reference(
        collection_binding,
        collection_type,
        generated_range
      )
      let (state, length) = state.indexed_length(
        condition_collection,
        item_type,
        fixed_length,
        types.usize_type,
        generated_range
      )
      let (state, condition) = state.binary(
        CheckedLessThan,
        condition_index,
        length,
        types.boolean,
        generated_range
      )
      let (state, item_collection) = state.local_reference(
        collection_binding,
        collection_type,
        generated_range
      )
      let (state, item_index) = state.local_reference(
        index_binding,
        types.usize_type,
        generated_range
      )
      let (state, item) = state.indexed_get(
        item_collection,
        item_index,
        item_type,
        fixed_length,
        item_type,
        generated_range
      )
      let (state, next_index) = state.local_reference(
        index_binding,
        types.usize_type,
        generated_range
      )
      let (state, one) = state.integer(1, types.usize_type, generated_range)
      let (state, incremented) = state.binary(
        CheckedAdd,
        next_index,
        one,
        types.usize_type,
        generated_range
      )
      let (state, advance) = state.assign(
        index_binding,
        incremented,
        types.nil_type,
        generated_range
      )
      match checked_body_expr(
        state,
        source,
        types,
        owner,
        function_result,
        CheckedInsideLoop(types.nil_type),
        CheckedLexicalBinding(
          name_start,
          name_length,
          item_binding,
          item_type,
          false,
          environment
        ),
        body,
        CheckedInferResult
      ) {
        CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
        CheckedBodyExprBuilt(state, checked_body) -> {
          let body_range = state.range(checked_body)
          let body_type = state.result_type(checked_body)
          match covering_range(collection_range, body_range) {
            nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
            range: CheckedSourceRange -> {
              let (state, advanced_body) = state.block(
                advance,
                checked_body,
                body_type,
                range
              )
              let (state, bound_body) = state.let_binding(
                item_binding,
                item,
                advanced_body,
                false,
                body_type,
                range
              )
              let (state, iteration) = state.while_expr(
                condition,
                bound_body,
                types.nil_type,
                range
              )
              let (state, indexed) = state.let_binding(
                index_binding,
                zero,
                iteration,
                true,
                types.nil_type,
                range
              )
              match state.let_binding(
                collection_binding,
                checked_collection,
                indexed,
                false,
                types.nil_type,
                range
              ) {
                (state, expression) -> CheckedBodyExprBuilt(state, expression)
              }
            }
          }
        }
      }
    }
  }
}

fn checked_body_zero_arg_method(
  state: owned CheckedBodyBuild,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  environment: CheckedLexicalEnvironment,
  receiver: CheckedExprId,
  spelling: str,
  required_trait: DeclarationIdentity?,
  missing_issue: CheckedBodyProducerIssue
) -[SemanticConformance]> CheckedBodyExprBuild {
  let catalog = state.types()
  let receiver_type = state.result_type(receiver)
  let range = state.range(receiver)
  let current_types = checked_body_types_with_catalog(types, catalog)
  let selection = match required_trait {
    nil -> checked_body_method_selection(current_types, owner, receiver_type, spelling)
    trait_declaration: DeclarationIdentity -> checked_body_method_selection_for_trait(
      current_types,
      owner,
      receiver_type,
      trait_declaration,
      spelling
    )
  }
  match selection {
    CheckedBodyMethodSelectionMissing -> CheckedBodyExprRejected(state, missing_issue)
    CheckedBodyMethodSelectionAmbiguous -> CheckedBodyExprRejected(
      state,
      CheckedBodyProducerAmbiguousMethod(range)
    )
    CheckedBodyMethodSelected(declaration, template, substitution) -> {
      let resolution = types.resolution
      let segment = catalog.next_derived_segment(
        types.module.identity,
        resolution.next_type_segment()
      )
      let product = semantic_type_product_continue(types.module.identity, catalog, segment)
      let (product, signature) = semantic_type_product_substitute(
        product,
        substitution,
        template
      )
      let next_catalog = semantic_type_product_catalog(product)
      let state = state.with_types(next_catalog)
      if semantic_function_parameter_count(next_catalog, signature) != 1 {
        CheckedBodyExprRejected(state, CheckedBodyProducerArityMismatch(1, 0))
      } else {
        let self_type = semantic_function_parameter(next_catalog, signature, 0)
        let (state, receiver) = checked_body_auto_borrow_receiver(state, receiver, self_type)
        if not semantic_type_is_subtype(
          next_catalog,
          state.result_type(receiver),
          self_type
        ) {
          CheckedBodyExprRejected(
            state,
            CheckedBodyProducerTypeMismatch(receiver_type, self_type)
          )
        } else {
          match checked_body_function_effect_requirement(next_catalog, environment, signature) {
            CheckedBodyEffectAtomUnavailable(atom) -> CheckedBodyExprRejected(
              state,
              CheckedBodyProducerEffectUnavailable(atom)
            )
            CheckedBodyEffectTailUnavailable(variable) -> CheckedBodyExprRejected(
              state,
              CheckedBodyProducerEffectTailUnavailable(variable)
            )
            CheckedBodyEffectsAvailable -> {
              let result = semantic_function_result(next_catalog, signature)
              let (state, arguments) = state.expression_list()
              let (state, arguments) = state.finish_expression_list(arguments)
              match state.method_call(declaration, receiver, arguments, result, range) {
                (state, call) -> CheckedBodyExprBuilt(state, call)
              }
            }
          }
        }
      }
    }
  }
}

fn checked_body_named_item(
  catalog: borrow SemanticTypeCatalog,
  named_declaration: DeclarationIdentity?,
  named_type: SemanticTypeId
) -> Option<SemanticTypeId> {
  match named_declaration {
    nil -> None<SemanticTypeId>()
    declared: DeclarationIdentity -> match catalog.graph_for(named_type) {
      None -> None<SemanticTypeId>()
      Some(graph) -> match semantic_type_graph_node(graph, named_type) {
        SemanticNamedNode(found, _, _, arguments) ->
          if not declaration_identity_eq(found, declared) {
            None<SemanticTypeId>()
          } else {
            let lists = semantic_type_graph_type_lists_local(graph)
            if semantic_type_list_len(lists, arguments) == 1 {
              Some<SemanticTypeId>(
                semantic_type_graph_list_type_id(
                  graph,
                  semantic_type_list_edge(lists, arguments, 0)
                )
              )
            } else { None<SemanticTypeId>() }
          }
        _ -> None<SemanticTypeId>()
      }
    }
  }
}

fn checked_body_for_list(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  environment: CheckedLexicalEnvironment,
  name_start: i64,
  name_length: i64,
  checked_collection: CheckedExprId,
  item_type: SemanticTypeId,
  body: Expr
) -[SemanticConformance]> CheckedBodyExprBuild {
  let catalog = state.types()
  let collection_type = state.result_type(checked_collection)
  let applications = types.variant_applications
  match (
    semantic_variant_case_count(applications, catalog, collection_type),
    semantic_variant_case_projection(applications, catalog, collection_type, "Cons"),
    semantic_variant_case_projection(applications, catalog, collection_type, "Nil"),
  ) {
    (
      Some(case_count),
      SemanticVariantCaseProjected(cons, cons_case, cons_arity),
      SemanticVariantCaseProjected(nil_case, _, nil_arity),
    ) -> match (
      semantic_variant_payload_type(applications, catalog, collection_type, cons_case, 0),
      semantic_variant_payload_type(applications, catalog, collection_type, cons_case, 1),
      source_range(source, name_start, name_length),
    ) {
      (Some(head_type), Some(tail_type), name_range: CheckedSourceRange) ->
        if case_count != 2 or cons_arity != 2 or nil_arity != 0 or
        not semantic_type_is_subtype(catalog, head_type, item_type) or
        not semantic_type_is_subtype(catalog, tail_type, collection_type) {
          CheckedBodyExprRejected(state, CheckedBodyProducerIterableRequired(collection_type))
        } else {
          let collection_range = state.range(checked_collection)
          let generated_range = CheckedSourceRange {
            start: name_range.start,
            end: name_range.start
          }
          let (state, current_binding) = state.binding(
            owner,
            collection_type,
            generated_range,
            CheckedMutableBinding
          )
          let (state, item_binding) = state.binding(
            owner,
            item_type,
            name_range,
            CheckedImmutableBinding
          )
          let (state, tail_binding) = state.binding(
            owner,
            tail_type,
            generated_range,
            CheckedImmutableBinding
          )
          let (state, current) = state.local_reference(
            current_binding,
            collection_type,
            generated_range
          )
          let (state, head_pattern) = state.binding_pattern(
            item_binding,
            head_type,
            name_range
          )
          let (state, tail_pattern) = state.binding_pattern(
            tail_binding,
            tail_type,
            generated_range
          )
          let (state, cons_items) = state.pattern_list()
          let (state, cons_items) = state.pattern_list_push(cons_items, head_pattern)
          let (state, cons_items) = state.pattern_list_push(cons_items, tail_pattern)
          let (state, cons_children) = state.pattern_list_finish(cons_items)
          let (state, cons_pattern) = state.constructor_pattern(
            cons,
            cons_children,
            nil,
            collection_type,
            generated_range
          )
          let (state, tail) = state.local_reference(
            tail_binding,
            tail_type,
            generated_range
          )
          let (state, advance) = state.assign(
            current_binding,
            tail,
            types.nil_type,
            generated_range
          )
          match checked_body_expr(
            state,
            source,
            types,
            owner,
            function_result,
            CheckedInsideLoop(types.nil_type),
            CheckedLexicalBinding(
              name_start,
              name_length,
              item_binding,
              item_type,
              false,
              environment
            ),
            body,
            CheckedInferResult
          ) {
            CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
            CheckedBodyExprBuilt(state, checked_body) -> {
              let body_range = state.range(checked_body)
              match covering_range(collection_range, body_range) {
                nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
                range: CheckedSourceRange -> {
                  let (state, empty) = state.nil(types.nil_type, generated_range)
                  let (state, after_body) = state.block(
                    checked_body,
                    empty,
                    types.nil_type,
                    range
                  )
                  let (state, cons_body) = state.block(
                    advance,
                    after_body,
                    types.nil_type,
                    range
                  )
                  let (state, nil_items) = state.pattern_list()
                  let (state, nil_children) = state.pattern_list_finish(nil_items)
                  let (state, nil_pattern) = state.constructor_pattern(
                    nil_case,
                    nil_children,
                    nil,
                    collection_type,
                    generated_range
                  )
                  let (state, done) = state.break_no_value(
                    types.never_type,
                    generated_range
                  )
                  let (state, arms) = state.match_arm_list()
                  let (state, arms) = state.match_arm_list_push(
                    arms,
                    cons_pattern,
                    CheckedUnguarded,
                    cons_body,
                    range
                  )
                  let (state, arms) = state.match_arm_list_push(
                    arms,
                    nil_pattern,
                    CheckedUnguarded,
                    done,
                    range
                  )
                  let (state, arms) = state.finish_match_arm_list(arms)
                  let (state, matched) = state.match_expr(
                    CheckedExplicitMatch,
                    current,
                    arms,
                    types.nil_type,
                    range
                  )
                  let (state, iteration) = state.loop_expr(
                    matched,
                    types.nil_type,
                    range
                  )
                  match state.let_binding(
                    current_binding,
                    checked_collection,
                    iteration,
                    true,
                    types.nil_type,
                    range
                  ) {
                    (state, expression) -> CheckedBodyExprBuilt(state, expression)
                  }
                }
              }
            }
          }
        }
      _ -> CheckedBodyExprRejected(state, CheckedBodyProducerIterableRequired(collection_type))
    }
    _ -> CheckedBodyExprRejected(state, CheckedBodyProducerIterableRequired(collection_type))
  }
}

fn checked_body_owned_named_item(
  catalog: borrow SemanticTypeCatalog,
  declaration: DeclarationIdentity?,
  result_type: SemanticTypeId
) -> Option<SemanticTypeId> {
  match catalog.graph_for(result_type) {
    None -> None<SemanticTypeId>()
    Some(graph) -> match semantic_type_graph_node(graph, result_type) {
      SemanticOwnedNode(value_type) -> checked_body_named_item(
        catalog,
        declaration,
        value_type
      )
      _ -> None<SemanticTypeId>()
    }
  }
}

fn checked_body_for_protocol_result(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  environment: CheckedLexicalEnvironment,
  name_start: i64,
  name_length: i64,
  iterator_call: CheckedExprId,
  iterator_binding: CheckedBindingId,
  next_call: CheckedExprId,
  body: Expr
) -[SemanticConformance]> CheckedBodyExprBuild {
  let result_type = state.result_type(next_call)
  let catalog = state.types()
  let iterator_type = state.result_type(iterator_call)
  -- The checked iterator result is the sole source of its item type.
  let recovered_item = checked_body_owned_named_item(
    catalog,
    checked_body_standard_declaration(
      types,
      lexical_scope(environment),
      "stdlib/iter/protocol",
      TypeDeclaration,
      "Iterator"
    ),
    iterator_type
  )
  let item_type = recovered_item.unwrap()
  let resolution = types.resolution
  let segment = catalog.next_derived_segment(
    types.module.identity,
    resolution.next_type_segment()
  )
  let product = semantic_type_product_continue(types.module.identity, catalog, segment)
  let declarations = resolution.declarations()
  let effect_declarations = resolution.effects()
  let (product, applications, variant_applications, effect_applications) = semantic_applications_materialize_type(
    product,
    types.applications,
    types.variant_applications,
    types.effect_applications,
    declarations,
    effect_declarations,
    result_type
  )
  let catalog = semantic_type_product_catalog(product)
  let state = state.with_types(catalog)
  let types = checked_body_types_with_applications(
    types,
    catalog,
    applications,
    variant_applications,
    effect_applications
  )
  let applications = types.variant_applications
  match (
    checked_body_named_item(
      catalog,
      checked_body_standard_declaration(
        types,
        lexical_scope(environment),
        "stdlib/option",
        TypeDeclaration,
        "Option"
      ),
      result_type
    ),
    semantic_variant_case_count(applications, catalog, result_type),
    semantic_variant_case_projection(applications, catalog, result_type, "Some"),
    semantic_variant_case_projection(applications, catalog, result_type, "None"),
    source_range(source, name_start, name_length),
  ) {
    (
      Some(option_item),
      Some(case_count),
      SemanticVariantCaseProjected(some, some_case, some_arity),
      SemanticVariantCaseProjected(none, _, none_arity),
      name_range: CheckedSourceRange,
    ) -> if case_count != 2 or some_arity != 1 or none_arity != 0 {
      CheckedBodyExprRejected(state, CheckedBodyProducerIteratorOptionCaseRequired(result_type))
    } else if not semantic_type_catalog_equal(catalog, option_item, item_type) {
      CheckedBodyExprRejected(
        state,
        CheckedBodyProducerIteratorOptionItemMismatch(result_type)
      )
    } else {
      match semantic_variant_payload_type(applications, catalog, result_type, some_case, 0) {
        None -> CheckedBodyExprRejected(
          state,
          CheckedBodyProducerIteratorOptionRequired(result_type)
        )
        Some(payload_type) -> if not semantic_type_is_subtype(catalog, payload_type, item_type) {
          CheckedBodyExprRejected(
            state,
            CheckedBodyProducerIteratorOptionPayloadMismatch(result_type)
          )
        } else {
          let iterator_range = state.range(iterator_call)
          let generated_range = CheckedSourceRange {
            start: name_range.start,
            end: name_range.start
          }
          let (state, item_binding) = state.binding(
            owner,
            item_type,
            name_range,
            CheckedImmutableBinding
          )
          let (state, item_pattern) = state.binding_pattern(
            item_binding,
            payload_type,
            name_range
          )
          let (state, some_items) = state.pattern_list()
          let (state, some_items) = state.pattern_list_push(some_items, item_pattern)
          let (state, some_children) = state.pattern_list_finish(some_items)
          let (state, some_pattern) = state.constructor_pattern(
            some,
            some_children,
            nil,
            result_type,
            generated_range
          )
          match checked_body_expr(
            state,
            source,
            types,
            owner,
            function_result,
            CheckedInsideLoop(types.nil_type),
            CheckedLexicalBinding(
              name_start,
              name_length,
              item_binding,
              item_type,
              false,
              environment
            ),
            body,
            CheckedInferResult
          ) {
            CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
            CheckedBodyExprBuilt(state, checked_body) -> match covering_range(
              iterator_range,
              state.range(checked_body)
            ) {
              nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
              range: CheckedSourceRange -> {
                let (state, empty) = state.nil(types.nil_type, generated_range)
                let (state, some_body) = state.block(
                  checked_body,
                  empty,
                  types.nil_type,
                  range
                )
                let (state, none_items) = state.pattern_list()
                let (state, none_children) = state.pattern_list_finish(none_items)
                let (state, none_pattern) = state.constructor_pattern(
                  none,
                  none_children,
                  nil,
                  result_type,
                  generated_range
                )
                let (state, done) = state.break_no_value(
                  types.never_type,
                  generated_range
                )
                let (state, arms) = state.match_arm_list()
                let (state, arms) = state.match_arm_list_push(
                  arms,
                  some_pattern,
                  CheckedUnguarded,
                  some_body,
                  range
                )
                let (state, arms) = state.match_arm_list_push(
                  arms,
                  none_pattern,
                  CheckedUnguarded,
                  done,
                  range
                )
                let (state, arms) = state.finish_match_arm_list(arms)
                let (state, matched) = state.match_expr(
                  CheckedExplicitMatch,
                  next_call,
                  arms,
                  types.nil_type,
                  range
                )
                let (state, iteration) = state.loop_expr(
                  matched,
                  types.nil_type,
                  range
                )
                match state.let_binding(
                  iterator_binding,
                  iterator_call,
                  iteration,
                  true,
                  types.nil_type,
                  range
                ) {
                  (state, expression) -> CheckedBodyExprBuilt(state, expression)
                }
              }
            }
          }
        }
      }
    }
    _ -> CheckedBodyExprRejected(state, CheckedBodyProducerIteratorOptionRequired(result_type))
  }
}

fn checked_body_for_protocol_iterator(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  environment: CheckedLexicalEnvironment,
  name_start: i64,
  name_length: i64,
  iterator_call: CheckedExprId,
  body: Expr
) -[SemanticConformance]> CheckedBodyExprBuild {
  let catalog = state.types()
  let iterator_type = state.result_type(iterator_call)
  match checked_body_owned_named_item(
    catalog,
    checked_body_standard_declaration(
      types,
      lexical_scope(environment),
      "stdlib/iter/protocol",
      TypeDeclaration,
      "Iterator"
    ),
    iterator_type
  ) {
    None -> CheckedBodyExprRejected(
      state,
      CheckedBodyProducerIteratorResultRequired(iterator_type)
    )
    Some(item_type) -> if not match catalog.graph_for(item_type) {
      None -> false
      Some(item_graph) -> semantic_type_graph_contains(item_graph, item_type)
    } {
      CheckedBodyExprRejected(state, CheckedBodyProducerIteratorItemInvalid(item_type))
    } else if match catalog.graph_for(item_type) {
      None -> false
      Some(item_graph) -> match semantic_type_graph_node(item_graph, item_type) {
        SemanticVariableNode(_) -> true
        SemanticAssociatedNode(_, _) -> true
        _ -> false
      }
    } {
      CheckedBodyExprRejected(state, CheckedBodyProducerIteratorItemUnresolved(item_type))
    } else {
      let collection_range = state.range(iterator_call)
      let generated_range = CheckedSourceRange {
        start: collection_range.start,
        end: collection_range.start
      }
      let (state, iterator_binding) = state.binding(
        owner,
        iterator_type,
        generated_range,
        CheckedMutableBinding
      )
      let (state, iterator_ref) = state.local_reference(
        iterator_binding,
        iterator_type,
        generated_range
      )
      match checked_body_zero_arg_method(
        state,
        types,
        owner,
        environment,
        iterator_ref,
        "next",
        nil,
        CheckedBodyProducerIteratorNextRequired(iterator_type)
      ) {
        CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
        CheckedBodyExprBuilt(state, next_call) -> checked_body_for_protocol_result(
          state,
          source,
          types,
          owner,
          function_result,
          environment,
          name_start,
          name_length,
          iterator_call,
          iterator_binding,
          next_call,
          body
        )
      }
    }
  }
}

fn checked_body_for_protocol(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  environment: CheckedLexicalEnvironment,
  name_start: i64,
  name_length: i64,
  checked_collection: CheckedExprId,
  body: Expr
) -[SemanticConformance]> CheckedBodyExprBuild {
  let catalog = state.types()
  let collection_type = state.result_type(checked_collection)
  match checked_body_standard_declaration(
    types,
    lexical_scope(environment),
    "stdlib/iter/protocol",
    TraitDeclaration,
    "IntoIterator"
  ) {
    nil -> CheckedBodyExprRejected(state, CheckedBodyProducerIterableRequired(collection_type))
    trait_declaration: DeclarationIdentity -> match checked_body_zero_arg_method(
      state,
      types,
      owner,
      environment,
      checked_collection,
      "into_iter",
      trait_declaration,
      CheckedBodyProducerIterableRequired(collection_type)
    ) {
      CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
      CheckedBodyExprBuilt(state, iterator_call) -> checked_body_for_protocol_iterator(
        state,
        source,
        types,
        owner,
        function_result,
        environment,
        name_start,
        name_length,
        iterator_call,
        body
      )
    }
  }
}

fn checked_body_for_iter(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  name_start: i64,
  name_length: i64,
  collection: Expr,
  body: Expr,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  let catalog = types.catalog
  if not expectation_allows(catalog, types.nil_type, expectation) {
    CheckedBodyExprRejected(state, expectation_mismatch(types.nil_type, expectation))
  } else {
    match checked_body_expr(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      collection,
      CheckedInferResult
    ) {
      CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
      CheckedBodyExprBuilt(state, checked_collection) -> {
        let collection_type = state.result_type(checked_collection)
        let catalog = state.types()
        match checked_body_indexed_shape(catalog, collection_type, CheckedLengthRead) {
          CheckedFixedIndexed(item_type, length) -> checked_body_for_indexed(
            state,
            source,
            types,
            owner,
            function_result,
            environment,
            name_start,
            name_length,
            checked_collection,
            item_type,
            __u64_to_isize(__usize_to_u64(length)),
            body
          )
          CheckedDynamicIndexed(item_type) -> checked_body_for_indexed(
            state,
            source,
            types,
            owner,
            function_result,
            environment,
            name_start,
            name_length,
            checked_collection,
            item_type,
            - 1,
            body
          )
          CheckedNotIndexed -> match checked_body_named_item(
            catalog,
            checked_body_standard_declaration(
              types,
              lexical_scope(environment),
              "stdlib/list",
              TypeDeclaration,
              "List"
            ),
            collection_type
          ) {
            Some(item_type) -> checked_body_for_list(
              state,
              source,
              types,
              owner,
              function_result,
              environment,
              name_start,
              name_length,
              checked_collection,
              item_type,
              body
            )
            None -> checked_body_for_protocol(
              state,
              source,
              types,
              owner,
              function_result,
              environment,
              name_start,
              name_length,
              checked_collection,
              body
            )
          }
        }
      }
    }
  }
}

fn checked_body_loop(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  environment: CheckedLexicalEnvironment,
  body: Expr,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  match expectation {
    CheckedInferResult -> CheckedBodyExprRejected(
      state,
      CheckedBodyProducerLoopContextRequired
    )
    CheckedRequireResult(result) -> match checked_body_expr(
      state,
      source,
      types,
      owner,
      function_result,
      CheckedInsideLoop(result),
      environment,
      body,
      CheckedInferResult
    ) {
      CheckedBodyExprBuilt(state, checked_body) -> {
        let range = state.range(checked_body)
        match state.loop_expr(checked_body, result, range) {
          (state, expression) -> CheckedBodyExprBuilt(state, expression)
        }
      }
      CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
    }
  }
}

fn checked_body_let(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  start: i64,
  length: i64,
  value: Expr,
  body: Expr,
  mutable: bool,
  annotation: Option<SemanticTypeId>,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  let value_expectation = match annotation {
    Some(expected) -> CheckedRequireResult(expected)
    None -> CheckedInferResult
  }
  match source_range(source, start, length) {
    binding_range: CheckedSourceRange -> match checked_body_expr(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      value,
      value_expectation
    ) {
      CheckedBodyExprBuilt(state, checked_value) -> {
        let value_type = state.result_type(checked_value)
        let binding_type = match annotation {
          Some(declared) -> declared
          None -> value_type
        }
        let catalog = state.types()
        if semantic_continuation_type(catalog, value_type) and
          not semantic_continuation_type(catalog, binding_type) {
            CheckedBodyExprRejected(
              state,
              CheckedBodyProducerContinuationConsumerRequired(binding_range)
            )
          } else if mutable and semantic_continuation_type(catalog, value_type) {
            CheckedBodyExprRejected(
              state,
              CheckedBodyProducerContinuationMutableBinding(binding_range)
            )
          } else {
            let mutability = if mutable {
              CheckedMutableBinding
            } else { CheckedImmutableBinding }
            match state.binding(owner, binding_type, binding_range, mutability) {
              (state, binding) -> match checked_body_expr(
                state,
                source,
                types,
                owner,
                function_result,
                loop_context,
                CheckedLexicalBinding(
                  start,
                  length,
                  binding,
                  binding_type,
                  mutable,
                  environment
                ),
                body,
                expectation
              ) {
                CheckedBodyExprBuilt(state, checked_body) -> {
                  let result = state.result_type(checked_body)
                  let body_range = state.range(checked_body)
                  match covering_range(binding_range, body_range) {
                    range: CheckedSourceRange ->
                      match state.let_binding(
                        binding,
                        checked_value,
                        checked_body,
                        mutable,
                        result,
                        range
                      ) {
                        (state, expression) -> CheckedBodyExprBuilt(state, expression)
                      }
                    nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
                  }
                }
                CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
              }
            }
          }
      }
      CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
    }
    nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
  }
}

fn checked_body_typed_let(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  inner: Expr,
  annotation: TypeExpr,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  let module = types.module
  let resolution = types.resolution
  let catalog = state.types()
  let next_segment = catalog.next_derived_segment(
    module.identity,
    resolution.next_type_segment()
  )
  match resolve_type_product_in_scope(
    semantic_type_product_continue(module.identity, catalog, next_segment),
    module,
    lexical_scope(environment),
    lexical_type_parameters(environment),
    annotation
  ) {
    (_, SemanticTypeRejected(issue)) -> CheckedBodyExprRejected(
      state,
      CheckedBodyProducerTypeRejected(issue)
    )
    (product, SemanticTypeResolved(declared)) -> {
      let next_catalog = semantic_type_product_catalog(product)
      let next_types = checked_body_types_with_catalog(types, next_catalog)
      let state = state.with_types(next_catalog)
      match inner {
        Let(start, length, value, body) -> checked_body_let(
          state,
          source,
          next_types,
          owner,
          function_result,
          loop_context,
          environment,
          start,
          length,
          value,
          body,
          false,
          Some(declared),
          expectation
        )
        LetMut(start, length, value, body) -> checked_body_let(
          state,
          source,
          next_types,
          owner,
          function_result,
          loop_context,
          environment,
          start,
          length,
          value,
          body,
          true,
          Some(declared),
          expectation
        )
        _ -> CheckedBodyExprRejected(state, CheckedBodyProducerUnsupportedExpression)
      }
    }
  }
}

fn checked_body_assign(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  start: i64,
  length: i64,
  value: Expr,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  let catalog = types.catalog
  match source_range(source, start, length) {
    name_range: CheckedSourceRange -> match lexical_lookup(
      environment,
      source,
      start,
      length
    ) {
      CheckedLexicalFound(binding, value_type, true) -> if expectation_allows(
        catalog,
        types.nil_type,
        expectation
      ) {
        match checked_body_expr(
          state,
          source,
          types,
          owner,
          function_result,
          loop_context,
          environment,
          value,
          CheckedRequireResult(value_type)
        ) {
          CheckedBodyExprBuilt(state, checked_value) -> {
            let value_range = state.range(checked_value)
            match covering_range(name_range, value_range) {
              range: CheckedSourceRange ->
                match state.assign(
                  binding,
                  checked_value,
                  types.nil_type,
                  range
                ) {
                  (state, expression) -> CheckedBodyExprBuilt(state, expression)
                }
              nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
            }
          }
          CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
        }
      } else {
        CheckedBodyExprRejected(
          state,
          expectation_mismatch(types.nil_type, expectation)
        )
      }
      CheckedLexicalFound(_, _, false) -> CheckedBodyExprRejected(
        state,
        CheckedBodyProducerImmutableAssignment(name_range)
      )
      CheckedLexicalMissing -> CheckedBodyExprRejected(
        state,
        CheckedBodyProducerUnknownIdentifier(name_range)
      )
    }
    nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
  }
}

fn checked_body_not(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  operand: Expr,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  let catalog = types.catalog
  match checked_body_expr(
    state,
    source,
    types,
    owner,
    function_result,
    loop_context,
    environment,
    operand,
    CheckedRequireResult(types.boolean)
  ) {
    CheckedBodyExprBuilt(state, checked_operand) -> if expectation_allows(
      catalog,
      types.boolean,
      expectation
    ) {
      let range = state.range(checked_operand)
      match state.not_expr(checked_operand, types.boolean, range) {
        (state, expression) -> CheckedBodyExprBuilt(state, expression)
      }
    } else {
      CheckedBodyExprRejected(
        state,
        expectation_mismatch(types.boolean, expectation)
      )
    }
    CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
  }
}

fn checked_body_negate(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  operand: Expr,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  let catalog = types.catalog
  let (operand_expectation, result_expectation) = negation_expectations(
    catalog,
    expectation
  )
  match checked_body_expr(
    state,
    source,
    types,
    owner,
    function_result,
    loop_context,
    environment,
    operand,
    operand_expectation
  ) {
    CheckedBodyExprBuilt(state, checked_operand) -> {
      let actual = state.result_type(checked_operand)
      if not semantic_numeric_type(catalog, actual) {
        CheckedBodyExprRejected(
          state,
          CheckedBodyProducerNumericOperandRequired(actual)
        )
      } else {
        if expectation_allows(catalog, actual, result_expectation) {
          let range = state.range(checked_operand)
          match state.negate(checked_operand, actual, range) {
            (state, expression) -> CheckedBodyExprBuilt(state, expression)
          }
        } else {
          CheckedBodyExprRejected(
            state,
            expectation_mismatch(actual, result_expectation)
          )
        }
      }
    }
    CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
  }
}

fn checked_body_defer(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  cleanup: Expr,
  body: Expr,
  source_site: i64,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  match source_range(source, source_site, 5) {
    keyword_range: CheckedSourceRange -> match checked_body_expr(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      cleanup,
      CheckedInferResult
    ) {
      CheckedBodyExprBuilt(state, checked_cleanup) -> match checked_body_expr(
        state,
        source,
        types,
        owner,
        function_result,
        loop_context,
        environment,
        body,
        expectation
      ) {
        CheckedBodyExprBuilt(state, checked_body) -> {
          let result = state.result_type(checked_body)
          let cleanup_range = state.range(checked_cleanup)
          let body_range = state.range(checked_body)
          match covering_range(keyword_range, cleanup_range) {
            cleanup_site_range: CheckedSourceRange -> match covering_range(
              cleanup_site_range,
              body_range
            ) {
              range: CheckedSourceRange -> match state.defer_expr(
                checked_cleanup,
                checked_body,
                __i64_to_usize(source_site),
                result,
                range
              ) {
                (state, expression) -> CheckedBodyExprBuilt(state, expression)
              }
              nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
            }
            nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
          }
        }
        CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
      }
      CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
    }
    nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
  }
}

fn checked_body_binary_seed_expectation(
  catalog: borrow SemanticTypeCatalog,
  types: CheckedBodyPrimitiveTypes,
  class: CheckedBinaryOperandClass,
  result_rule: CheckedBinaryResultRule,
  expectation: CheckedBodyExpectation
) -> CheckedBodyExpectation {
  match class {
    CheckedBooleanOperands -> CheckedRequireResult(types.boolean)
    _ -> match result_rule {
      CheckedBooleanResult -> CheckedInferResult
      CheckedOperandResult -> match expectation {
        CheckedRequireResult(expected) -> if binary_operand_class_accepts(
          catalog,
          types.boolean,
          expected,
          class
        ) {
          CheckedRequireResult(expected)
        } else { CheckedInferResult }
        CheckedInferResult -> CheckedInferResult
      }
    }
  }
}

fn checked_body_homogeneous_binary_in_order(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  first: Expr,
  second: Expr,
  left_first: bool,
  class: CheckedBinaryOperandClass,
  result_rule: CheckedBinaryResultRule,
  seed_expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyBinaryBuild {
  let catalog = types.catalog
  match checked_body_expr(
    state,
    source,
    types,
    owner,
    function_result,
    loop_context,
    environment,
    first,
    seed_expectation
  ) {
    CheckedBodyExprBuilt(state, checked_first) -> {
      let first_type = state.result_type(checked_first)
      if not binary_operand_class_accepts(
        catalog,
        types.boolean,
        first_type,
        class
      ) {
        CheckedBodyBinaryRejected(
          state,
          binary_operand_issue(types.boolean, first_type, class)
        )
      } else {
        match checked_body_expr(
          state,
          source,
          types,
          owner,
          function_result,
          loop_context,
          environment,
          second,
          CheckedRequireResult(first_type)
        ) {
          CheckedBodyExprBuilt(state, checked_second) -> {
            let second_type = state.result_type(checked_second)
            if not binary_operand_class_accepts(
              catalog,
              types.boolean,
              second_type,
              class
            ) {
              CheckedBodyBinaryRejected(
                state,
                binary_operand_issue(types.boolean, second_type, class)
              )
            } else {
              if not semantic_type_catalog_equal(catalog, first_type, second_type) {
                CheckedBodyBinaryRejected(
                  state,
                  CheckedBodyProducerBinaryOperandMismatch(first_type, second_type)
                )
              } else {
                let left = if left_first { checked_first } else { checked_second }
                let right = if left_first { checked_second } else { checked_first }
                match covering_range(state.range(left), state.range(right)) {
                  range: CheckedSourceRange -> CheckedBodyBinaryBuilt(
                    state,
                    left,
                    right,
                    match result_rule {
                      CheckedOperandResult -> first_type
                      CheckedBooleanResult -> types.boolean
                    },
                    range
                  )
                  nil -> CheckedBodyBinaryRejected(
                    state,
                    CheckedBodyProducerInvalidRange
                  )
                }
              }
            }
          }
          CheckedBodyExprRejected(state, issue) -> CheckedBodyBinaryRejected(state, issue)
        }
      }
    }
    CheckedBodyExprRejected(state, issue) -> CheckedBodyBinaryRejected(state, issue)
  }
}

fn checked_body_homogeneous_binary(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  left: Expr,
  right: Expr,
  class: CheckedBinaryOperandClass,
  result_rule: CheckedBinaryResultRule,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyBinaryBuild {
  let catalog = types.catalog
  let seed = checked_body_binary_seed_expectation(
    catalog,
    types,
    class,
    result_rule,
    expectation
  )
  if contextual_integer_literal(left) and not contextual_integer_literal(right) {
    checked_body_homogeneous_binary_in_order(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      right,
      left,
      false,
      class,
      result_rule,
      seed
    )
  } else {
    checked_body_homogeneous_binary_in_order(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      left,
      right,
      true,
      class,
      result_rule,
      seed
    )
  }
}

fn checked_body_standard_declaration(
  types: CheckedBodyPrimitiveTypes,
  scope: RegistrationScope,
  module_path: str,
  namespace: DeclarationNamespace,
  name: str
) -> DeclarationIdentity? {
  let mut selected: DeclarationIdentity? = nil
  if types.sdk_package_id <= 0 { return nil }
  let mut index: usize = 0
  while index < registration_scope_len(scope) {
    let module = registration_scope_at(scope, __u64_to_i64(__usize_to_u64(index)))
    match module.identity {
      NamedModuleIdentity(path, _) -> if path == module_path and
        module_identity_package(module.identity) == types.sdk_package_id {
          match registration_scope_find_declaration(
            scope,
            module.identity,
            namespace,
            name
          ) {
            Some(name) -> match selected {
              nil -> { selected = name.identity }
              other: DeclarationIdentity -> return nil
            }
            None -> nil
          }
        } else { nil }
      _ -> nil
    }
    index = index + 1
  }
  selected
}

fn checked_body_result_arguments(
  catalog: borrow SemanticTypeCatalog,
  value: SemanticTypeId,
  declaration: DeclarationIdentity
) -> Option<(SemanticTypeId, SemanticTypeId)> {
  match catalog.graph_for(value) {
    None -> None<(SemanticTypeId, SemanticTypeId)>()
    Some(graph) -> match semantic_type_graph_node(graph, value) {
      SemanticNamedNode(candidate, SemanticNominalType, _, arguments) -> {
        let lists = semantic_type_graph_type_lists_local(graph)
        if not declaration_identity_eq(candidate, declaration) or
          semantic_type_list_len(lists, arguments) != 2 {
            None<(SemanticTypeId, SemanticTypeId)>()
          }
        else {
          Some<(SemanticTypeId, SemanticTypeId)>(
            (
              semantic_type_graph_list_type_id(
                graph,
                semantic_type_list_edge(lists, arguments, 0)
              ),
              semantic_type_graph_list_type_id(
                graph,
                semantic_type_list_edge(lists, arguments, 1)
              )
            )
          )
        }
      }
      _ -> None<(SemanticTypeId, SemanticTypeId)>()
    }
  }
}

fn checked_body_fail_atom_matches(
  catalog: borrow SemanticTypeCatalog,
  atom: SemanticTypeId,
  declaration: DeclarationIdentity,
  error_type: SemanticTypeId
) -> bool {
  match catalog.graph_for(atom) {
    None -> false
    Some(graph) -> match semantic_type_graph_node(graph, atom) {
      SemanticEffectAtomNode(candidate, arguments) -> {
        let lists = semantic_type_graph_type_lists_local(graph)
        declaration_identity_eq(candidate, declaration) and
          semantic_type_list_len(lists, arguments) == 1 and
          semantic_type_catalog_equal(
            catalog,
            semantic_type_graph_list_type_id(
              graph,
              semantic_type_list_edge(lists, arguments, 0)
            ),
            error_type
          )
      }
      _ -> false
    }
  }
}

fn checked_body_fail_atom_in_function(
  catalog: borrow SemanticTypeCatalog,
  function_type: SemanticTypeId,
  declaration: DeclarationIdentity,
  error_type: SemanticTypeId
) -> Option<SemanticTypeId> {
  match catalog.graph_for(function_type) {
    None -> None<SemanticTypeId>()
    Some(graph) -> match semantic_type_graph_node(graph, function_type) {
      SemanticFunctionNode(_, _, effects) -> match catalog.graph_for(effects) {
        None -> None<SemanticTypeId>()
        Some(effect_graph) -> match semantic_type_graph_node(effect_graph, effects) {
          SemanticEffectSignatureNode(atoms, _) -> {
            let lists = semantic_type_graph_type_lists_local(effect_graph)
            let mut index: usize = 0
            while index < semantic_type_list_len(lists, atoms) {
              let atom = semantic_type_graph_list_type_id(
                effect_graph,
                semantic_type_list_edge(lists, atoms, index)
              )
              if checked_body_fail_atom_matches(catalog, atom, declaration, error_type) {
                return Some<SemanticTypeId>(atom)
              }
              index = index + 1
            }
            None<SemanticTypeId>()
          }
          _ -> None<SemanticTypeId>()
        }
      }
      _ -> None<SemanticTypeId>()
    }
  }
}

fn checked_body_fail_atom(
  catalog: borrow SemanticTypeCatalog,
  environment: CheckedLexicalEnvironment,
  declaration: DeclarationIdentity,
  error_type: SemanticTypeId
) -> Option<SemanticTypeId> {
  match environment {
    CheckedLexicalRoot(_, _, _, function_type) -> checked_body_fail_atom_in_function(
      catalog,
      function_type,
      declaration,
      error_type
    )
    CheckedLexicalBinding(_, _, _, _, _, parent) -> checked_body_fail_atom(
      catalog,
      parent,
      declaration,
      error_type
    )
    CheckedLexicalHandledEffect(atom, parent) -> if checked_body_fail_atom_matches(
      catalog,
      atom,
      declaration,
      error_type
    ) { Some<SemanticTypeId>(atom) }
    else { checked_body_fail_atom(catalog, parent, declaration, error_type) }
    CheckedLexicalResume(_, _, parent) -> checked_body_fail_atom(
      catalog,
      parent,
      declaration,
      error_type
    )
  }
}

fn checked_body_self_parameter(
  catalog: borrow SemanticTypeCatalog,
  value: SemanticTypeId
) -> bool {
  match catalog.graph_for(value) {
    None -> false
    Some(graph) -> match semantic_type_graph_node(graph, value) {
      SemanticVariableNode(SemanticSelfVariable) -> true
      _ -> false
    }
  }
}

fn checked_body_pure_function(
  catalog: borrow SemanticTypeCatalog,
  function_type: SemanticTypeId
) -> bool {
  match catalog.graph_for(function_type) {
    None -> false
    Some(graph) -> match semantic_type_graph_node(graph, function_type) {
      SemanticFunctionNode(_, _, effects) -> match catalog.graph_for(effects) {
        None -> false
        Some(effect_graph) -> match semantic_type_graph_node(effect_graph, effects) {
          SemanticEffectSignatureNode(atoms, SemanticClosedEffects) -> {
            let lists = semantic_type_graph_type_lists_local(effect_graph)
            semantic_type_list_len(lists, atoms) == 0
          }
          _ -> false
        }
      }
      _ -> false
    }
  }
}

fn checked_body_eq_contract(
  types: CheckedBodyPrimitiveTypes,
  trait_declaration: DeclarationIdentity
) -> bool {
  let resolution = types.resolution
  let methods = resolution.methods()
  let catalog = types.catalog
  match semantic_trait_method_select(methods, trait_declaration, "eq") {
    SemanticTraitMethodSelected(_, signature) ->
      semantic_function_parameter_count(catalog, signature) == 2 and
      checked_body_self_parameter(catalog, semantic_function_parameter(catalog, signature, 0)) and
      checked_body_self_parameter(catalog, semantic_function_parameter(catalog, signature, 1)) and
      semantic_type_catalog_equal(
        catalog,
        semantic_function_result(catalog, signature),
        types.boolean
      ) and
      checked_body_pure_function(catalog, signature)
    _ -> false
  }
}

fn checked_body_ord_contract(
  types: CheckedBodyPrimitiveTypes,
  trait_declaration: DeclarationIdentity,
  ordering_declaration: DeclarationIdentity
) -> Option<SemanticTypeId> {
  let resolution = types.resolution
  let methods = resolution.methods()
  let catalog = types.catalog
  match semantic_trait_method_select(methods, trait_declaration, "compare") {
    SemanticTraitMethodSelected(_, signature) -> if
      semantic_function_parameter_count(catalog, signature) == 2 and
      checked_body_self_parameter(catalog, semantic_function_parameter(catalog, signature, 0)) and
      checked_body_self_parameter(catalog, semantic_function_parameter(catalog, signature, 1)) and
      checked_body_pure_function(catalog, signature) {
        let result = semantic_function_result(catalog, signature)
        match catalog.graph_for(result) {
          None -> None<SemanticTypeId>()
          Some(graph) -> match semantic_type_graph_node(graph, result) {
            SemanticNamedNode(declaration, _, _, arguments) -> {
              let lists = semantic_type_graph_type_lists_local(graph)
              if declaration_identity_eq(declaration, ordering_declaration) and
                semantic_type_list_len(lists, arguments) == 0 { Some(result) }
            else { None<SemanticTypeId>() }
            }
            _ -> None<SemanticTypeId>()
          }
        }
      } else { None<SemanticTypeId>() }
    _ -> None<SemanticTypeId>()
  }
}

fn checked_body_display_contract(
  types: CheckedBodyPrimitiveTypes,
  trait_declaration: DeclarationIdentity
) -> bool {
  let resolution = types.resolution
  let methods = resolution.methods()
  let catalog = types.catalog
  match semantic_trait_method_select(methods, trait_declaration, "display") {
    SemanticTraitMethodSelected(_, signature) ->
      semantic_function_parameter_count(catalog, signature) == 1 and
      checked_body_self_parameter(catalog, semantic_function_parameter(catalog, signature, 0)) and
      semantic_type_catalog_equal(
        catalog,
        semantic_function_result(catalog, signature),
        types.string
      ) and checked_body_pure_function(catalog, signature)
    _ -> false
  }
}

fn checked_body_equality_in_order(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  first: Expr,
  second: Expr,
  left_first: bool
) -[SemanticConformance]> CheckedBodyBinaryBuild {
  let catalog = types.catalog
  match checked_body_expr(
    state,
    source,
    types,
    owner,
    function_result,
    loop_context,
    environment,
    first,
    CheckedInferResult
  ) {
    CheckedBodyExprBuilt(state, checked_first) -> {
      let first_type = state.result_type(checked_first)
      let second_expectation = if contextual_integer_literal(second) and
        semantic_integer_type(catalog, first_type) {
          CheckedRequireResult(first_type)
        } else { CheckedInferResult }
      match checked_body_expr(
        state,
        source,
        types,
        owner,
        function_result,
        loop_context,
        environment,
        second,
        second_expectation
      ) {
        CheckedBodyExprBuilt(state, checked_second) -> {
          let second_type = state.result_type(checked_second)
          let left = if left_first { checked_first } else { checked_second }
          let right = if left_first { checked_second } else { checked_first }
          let left_type = if left_first { first_type } else { second_type }
          let right_type = if left_first { second_type } else { first_type }
          if not primitive_equality_compatible(
            catalog,
            types.integer,
            left_type,
            right_type
          ) and not semantic_type_catalog_equal(catalog, left_type, right_type) {
            CheckedBodyBinaryRejected(
              state,
              CheckedBodyProducerBinaryOperandMismatch(left_type, right_type)
            )
          } else {
            match covering_range(state.range(left), state.range(right)) {
              range: CheckedSourceRange -> CheckedBodyBinaryBuilt(
                state,
                left,
                right,
                types.boolean,
                range
              )
              nil -> CheckedBodyBinaryRejected(state, CheckedBodyProducerInvalidRange)
            }
          }
        }
        CheckedBodyExprRejected(state, issue) -> CheckedBodyBinaryRejected(state, issue)
      }
    }
    CheckedBodyExprRejected(state, issue) -> CheckedBodyBinaryRejected(state, issue)
  }
}

fn checked_body_equality(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  left: Expr,
  right: Expr
) -[SemanticConformance]> CheckedBodyBinaryBuild {
  if contextual_integer_literal(left) and not contextual_integer_literal(right) {
    checked_body_equality_in_order(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      right,
      left,
      false
    )
  } else {
    checked_body_equality_in_order(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      left,
      right,
      true
    )
  }
}

fn checked_body_canonical_binary_call(
  state: owned CheckedBodyBuild,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  left: CheckedExprId,
  right: CheckedExprId,
  range: CheckedSourceRange,
  trait_declaration: DeclarationIdentity,
  method_name: str,
  return_type: SemanticTypeId,
  missing_issue: CheckedBodyProducerIssue,
  invalid_issue: CheckedBodyProducerIssue
) -[SemanticConformance]> CheckedBodyExprBuild {
  let catalog = state.types()
  let resolution = types.resolution
  let receiver_type = state.result_type(left)
  let current_types = checked_body_types_with_catalog(types, catalog)
  match checked_body_method_selection_for_trait(
    current_types,
    owner,
    receiver_type,
    trait_declaration,
    method_name
  ) {
    CheckedBodyMethodSelectionMissing -> CheckedBodyExprRejected(state, missing_issue)
    CheckedBodyMethodSelectionAmbiguous -> CheckedBodyExprRejected(
      state,
      CheckedBodyProducerAmbiguousMethod(range)
    )
    CheckedBodyMethodSelected(declaration, template, substitution) -> {
      let segment = catalog.next_derived_segment(
        types.module.identity,
        resolution.next_type_segment()
      )
      let product = semantic_type_product_continue(types.module.identity, catalog, segment)
      let (product, signature) = semantic_type_product_substitute(
        product,
        substitution,
        template
      )
      let next_catalog = semantic_type_product_catalog(product)
      let next_state = state.with_types(next_catalog)
      if semantic_function_parameter_count(next_catalog, signature) != 2 or
        not checked_body_pure_function(next_catalog, signature) or
        not semantic_type_catalog_equal(
          next_catalog,
          semantic_function_result(next_catalog, signature),
          return_type
        ) {
          CheckedBodyExprRejected(next_state, invalid_issue)
        } else {
          let self_type = semantic_function_parameter(next_catalog, signature, 0)
          let other_type = semantic_function_parameter(next_catalog, signature, 1)
          let right_type = next_state.result_type(right)
          if not semantic_type_is_subtype(next_catalog, receiver_type, self_type) or
            not semantic_type_is_subtype(next_catalog, right_type, other_type) {
              CheckedBodyExprRejected(
                next_state,
                CheckedBodyProducerBinaryOperandMismatch(receiver_type, right_type)
              )
            } else {
              let (next_state, list) = next_state.expression_list()
              let (next_state, list) = next_state.expression_list_push(list, right)
              let (next_state, arguments) = next_state.finish_expression_list(list)
              match next_state.method_call(declaration, left, arguments, return_type, range) {
                (next_state, call) -> CheckedBodyExprBuilt(next_state, call)
              }
            }
        }
    }
  }
}

fn checked_body_eq_dispatch(
  state: owned CheckedBodyBuild,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  environment: CheckedLexicalEnvironment,
  left: CheckedExprId,
  right: CheckedExprId,
  range: CheckedSourceRange,
  inverted: bool,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  let catalog = state.types()
  if not expectation_allows(catalog, types.boolean, expectation) {
    CheckedBodyExprRejected(state, expectation_mismatch(types.boolean, expectation))
  } else {
    match checked_body_standard_declaration(
      types,
      lexical_scope(environment),
      "stdlib/eq",
      TraitDeclaration,
      "Eq"
    ) {
      nil -> CheckedBodyExprRejected(state, CheckedBodyProducerCanonicalEqUnavailable)
      trait_declaration: DeclarationIdentity -> if not checked_body_eq_contract(
        types,
        trait_declaration
      ) {
        CheckedBodyExprRejected(
          state,
          CheckedBodyProducerCanonicalEqInvalid(trait_declaration)
        )
      } else {
        let receiver_type = state.result_type(left)
        match checked_body_canonical_binary_call(
          state,
          types,
          owner,
          left,
          right,
          range,
          trait_declaration,
          "eq",
          types.boolean,
          CheckedBodyProducerEqImplementationRequired(receiver_type),
          CheckedBodyProducerCanonicalEqInvalid(trait_declaration)
        ) {
          CheckedBodyExprRejected(next_state, issue) -> CheckedBodyExprRejected(next_state, issue)
          CheckedBodyExprBuilt(next_state, call) -> if inverted {
            match next_state.not_expr(call, types.boolean, range) {
              (next_state, expression) -> CheckedBodyExprBuilt(next_state, expression)
            }
          } else { CheckedBodyExprBuilt(next_state, call) }
        }
      }
    }
  }
}

fn checked_body_publish_equality(
  build: CheckedBodyBinaryBuild,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  environment: CheckedLexicalEnvironment,
  operator: CheckedBinaryOperator,
  operator_id: i64,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  match build {
    CheckedBodyBinaryRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
    CheckedBodyBinaryBuilt(state, left, right, _, range) -> {
      let catalog = state.types()
      let left_type = state.result_type(left)
      let right_type = state.result_type(right)
      if semantic_primitive_type(catalog, left_type) and
        semantic_primitive_type(catalog, right_type) {
          checked_body_publish_binary(
            CheckedBodyBinaryBuilt(state, left, right, types.boolean, range),
            catalog,
            operator,
            expectation
          )
        } else {
          checked_body_eq_dispatch(
            state,
            types,
            owner,
            environment,
            left,
            right,
            range,
            operator_id == 6,
            expectation
          )
        }
    }
  }
}

fn checked_body_ordering_match(
  state: owned CheckedBodyBuild,
  types: CheckedBodyPrimitiveTypes,
  call: CheckedExprId,
  ordering_type: SemanticTypeId,
  operator_id: i64,
  range: CheckedSourceRange
) -> CheckedBodyExprBuild {
  let wanted = if operator_id == 7 or operator_id == 10 { "Less" } else { "Greater" }
  let catalog = state.types()
  let applications = types.variant_applications
  match semantic_variant_case_projection(applications, catalog, ordering_type, wanted) {
    SemanticVariantCaseProjected(declaration, _, payload_count) -> if payload_count != 0 {
      CheckedBodyExprRejected(
        state,
        CheckedBodyProducerOrderingCaseUnavailable(wanted)
      )
    } else {
      let (state, empty_builder) = state.pattern_list()
      let (state, empty_children) = state.pattern_list_finish(empty_builder)
      let (state, selected) = state.constructor_pattern(
        declaration,
        empty_children,
        nil,
        ordering_type,
        range
      )
      let (state, fallback) = state.wildcard_pattern(ordering_type, range)
      let selected_value = operator_id == 7 or operator_id == 8
      let (state, selected_body) = state.boolean(selected_value, types.boolean, range)
      let (state, fallback_body) = state.boolean(not selected_value, types.boolean, range)
      let (state, arms_builder) = state.match_arm_list()
      let (state, arms_builder) = state.match_arm_list_push(
        arms_builder,
        selected,
        CheckedUnguarded,
        selected_body,
        range
      )
      let (state, arms_builder) = state.match_arm_list_push(
        arms_builder,
        fallback,
        CheckedUnguarded,
        fallback_body,
        range
      )
      let (state, arms) = state.finish_match_arm_list(arms_builder)
      match state.match_expr(CheckedExplicitMatch, call, arms, types.boolean, range) {
        (state, expression) -> CheckedBodyExprBuilt(state, expression)
      }
    }
    _ -> CheckedBodyExprRejected(
      state,
      CheckedBodyProducerOrderingCaseUnavailable(wanted)
    )
  }
}

fn checked_body_ord_dispatch(
  state: owned CheckedBodyBuild,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  environment: CheckedLexicalEnvironment,
  left: CheckedExprId,
  right: CheckedExprId,
  range: CheckedSourceRange,
  operator_id: i64,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  let catalog = state.types()
  if not expectation_allows(catalog, types.boolean, expectation) {
    CheckedBodyExprRejected(state, expectation_mismatch(types.boolean, expectation))
  } else {
    let scope = lexical_scope(environment)
    match (
      checked_body_standard_declaration(types, scope, "stdlib/ord", TraitDeclaration, "Ord"),
      checked_body_standard_declaration(types, scope, "stdlib/ord", TypeDeclaration, "Ordering")
    ) {
      (trait_declaration: DeclarationIdentity, ordering_declaration: DeclarationIdentity) -> {
        match checked_body_ord_contract(types, trait_declaration, ordering_declaration) {
          None -> CheckedBodyExprRejected(
            state,
            CheckedBodyProducerCanonicalOrdInvalid(trait_declaration)
          )
          Some(ordering_type) -> {
            let receiver_type = state.result_type(left)
            match checked_body_canonical_binary_call(
              state,
              types,
              owner,
              left,
              right,
              range,
              trait_declaration,
              "compare",
              ordering_type,
              CheckedBodyProducerOrdImplementationRequired(receiver_type),
              CheckedBodyProducerCanonicalOrdInvalid(trait_declaration)
            ) {
              CheckedBodyExprRejected(next_state, issue) -> CheckedBodyExprRejected(
                next_state,
                issue
              )
              CheckedBodyExprBuilt(next_state, call) -> checked_body_ordering_match(
                next_state,
                types,
                call,
                ordering_type,
                operator_id,
                range
              )
            }
          }
        }
      }
      _ -> CheckedBodyExprRejected(state, CheckedBodyProducerCanonicalOrdUnavailable)
    }
  }
}

fn checked_body_publish_ordering(
  build: CheckedBodyBinaryBuild,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  environment: CheckedLexicalEnvironment,
  operator: CheckedBinaryOperator,
  operator_id: i64,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  match build {
    CheckedBodyBinaryRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
    CheckedBodyBinaryBuilt(state, left, right, _, range) -> {
      let catalog = state.types()
      let left_type = state.result_type(left)
      let right_type = state.result_type(right)
      if semantic_numeric_type(catalog, left_type) and
        semantic_numeric_type(catalog, right_type) {
          checked_body_publish_binary(
            CheckedBodyBinaryBuilt(state, left, right, types.boolean, range),
            catalog,
            operator,
            expectation
          )
        } else if semantic_numeric_type(catalog, left_type) or
        semantic_numeric_type(catalog, right_type) {
          CheckedBodyExprRejected(
            state,
            CheckedBodyProducerBinaryOperandMismatch(left_type, right_type)
          )
        } else {
          checked_body_ord_dispatch(
            state,
            types,
            owner,
            environment,
            left,
            right,
            range,
            operator_id,
            expectation
          )
        }
    }
  }
}

fn checked_body_publish_binary(
  build: CheckedBodyBinaryBuild,
  catalog: borrow SemanticTypeCatalog,
  operator: CheckedBinaryOperator,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  match build {
    CheckedBodyBinaryBuilt(state, left, right, result, range) -> if expectation_allows(
      catalog,
      result,
      expectation
    ) {
      match state.binary(operator, left, right, result, range) {
        (state, expression) -> CheckedBodyExprBuilt(state, expression)
      }
    } else {
      CheckedBodyExprRejected(state, expectation_mismatch(result, expectation))
    }
    CheckedBodyBinaryRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
  }
}

fn checked_body_binary(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  operator_id: i64,
  left: Expr,
  right: Expr,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  let catalog = types.catalog
  match checked_binary_resolution(operator_id) {
    CheckedNumericBinary(operator) -> checked_body_publish_binary(
      checked_body_homogeneous_binary(
        state,
        source,
        types,
        owner,
        function_result,
        loop_context,
        environment,
        left,
        right,
        CheckedNumericOperands,
        CheckedOperandResult,
        expectation
      ),
      catalog,
      operator,
      expectation
    )
    CheckedIntegerBinary(operator) -> checked_body_publish_binary(
      checked_body_homogeneous_binary(
        state,
        source,
        types,
        owner,
        function_result,
        loop_context,
        environment,
        left,
        right,
        CheckedIntegerOperands,
        CheckedOperandResult,
        expectation
      ),
      catalog,
      operator,
      expectation
    )
    CheckedBooleanBinary(operator) -> checked_body_publish_binary(
      checked_body_homogeneous_binary(
        state,
        source,
        types,
        owner,
        function_result,
        loop_context,
        environment,
        left,
        right,
        CheckedBooleanOperands,
        CheckedBooleanResult,
        expectation
      ),
      catalog,
      operator,
      expectation
    )
    CheckedEqualityBinary(operator) -> checked_body_publish_equality(
      checked_body_equality(
        state,
        source,
        types,
        owner,
        function_result,
        loop_context,
        environment,
        left,
        right
      ),
      types,
      owner,
      environment,
      operator,
      operator_id,
      expectation
    )
    CheckedOrderingBinary(operator) -> checked_body_publish_ordering(
      checked_body_equality(
        state,
        source,
        types,
        owner,
        function_result,
        loop_context,
        environment,
        left,
        right
      ),
      types,
      owner,
      environment,
      operator,
      operator_id,
      expectation
    )
    CheckedBinaryUnsupported(value) -> CheckedBodyExprRejected(
      state,
      CheckedBodyProducerUnsupportedBinaryOperator(value)
    )
  }
}

fn checked_variant_case_seen(
  cases: List<DeclarationIdentity>,
  wanted: DeclarationIdentity
) -> bool {
  match cases {
    Nil -> false
    Cons(declaration, rest) -> declaration_identity_eq(declaration, wanted) or
      checked_variant_case_seen(rest, wanted)
  }
}

fn checked_variant_cases_union(
  cases: List<DeclarationIdentity>,
  result: List<DeclarationIdentity>
) -> List<DeclarationIdentity> {
  match cases {
    Nil -> result
    Cons(declaration, rest) -> checked_variant_cases_union(
      rest,
      if checked_variant_case_seen(result, declaration) { result }
    else { result.prepend(declaration) }
    )
  }
}

fn checked_pattern_coverage_add(
  accumulated: CheckedPatternCoverage,
  next: CheckedPatternCoverage
) -> CheckedPatternCoverage {
  match (accumulated, next) {
    (CheckedPatternComplete, _) -> CheckedPatternComplete
    (_, CheckedPatternComplete) -> CheckedPatternComplete
    (CheckedPatternBooleanComplete, _) -> CheckedPatternBooleanComplete
    (_, CheckedPatternBooleanComplete) -> CheckedPatternBooleanComplete
    (CheckedPatternBooleanTrue, CheckedPatternBooleanFalse) ->
      CheckedPatternBooleanComplete
    (CheckedPatternBooleanFalse, CheckedPatternBooleanTrue) ->
      CheckedPatternBooleanComplete
    (CheckedPatternBooleanTrue, _) -> CheckedPatternBooleanTrue
    (_, CheckedPatternBooleanTrue) -> CheckedPatternBooleanTrue
    (CheckedPatternBooleanFalse, _) -> CheckedPatternBooleanFalse
    (_, CheckedPatternBooleanFalse) -> CheckedPatternBooleanFalse
    (CheckedPatternVariantCases(left, total), CheckedPatternVariantCases(right, other_total)) ->
      if total == other_total {
        CheckedPatternVariantCases(checked_variant_cases_union(right, left), total)
      } else { CheckedPatternOpen }
    (CheckedPatternVariantCases(cases, total), _) -> CheckedPatternVariantCases(cases, total)
    (_, CheckedPatternVariantCases(cases, total)) -> CheckedPatternVariantCases(cases, total)
    _ -> CheckedPatternOpen
  }
}

fn checked_pattern_coverage_complete(coverage: CheckedPatternCoverage) -> bool {
  match coverage {
    CheckedPatternComplete -> true
    CheckedPatternBooleanComplete -> true
    CheckedPatternVariantCases(cases, total) -> cases.len() == total
    _ -> false
  }
}

fn checked_match_origin(origin: MatchOrigin) -> CheckedMatchOrigin {
  match origin {
    ExplicitMatch -> CheckedExplicitMatch
    LetDestructuring -> CheckedLetDestructuring
    ForDestructuring -> CheckedForDestructuring
  }
}

fn checked_body_constructor_reference(
  source: Source,
  environment: CheckedLexicalEnvironment,
  declaration: DeclarationIdentity,
  name_range: CheckedSourceRange,
  authored_qualifier: TypeNameRange?
) -> CheckedConstructorReference {
  match source.span(name_range.start, name_range.end) {
    None -> CheckedConstructorInvalidRange
    Some(name) -> match authored_qualifier {
      nil -> match registration_scope_lookup_declaration_span(
        lexical_scope(environment),
        lexical_module(environment),
        ConstructorDeclaration,
        name
      ) {
        Some(registered) -> if declaration_identity_eq(registered.identity, declaration) {
          CheckedConstructorResolved(nil)
        } else { CheckedConstructorMissing }
        None -> CheckedConstructorMissing
      }
      qualifier: TypeNameRange -> match source_range(
        source,
        qualifier.start,
        qualifier.length
      ) {
        nil -> CheckedConstructorInvalidRange
        qualifier_range: CheckedSourceRange -> match source.span(
          qualifier_range.start,
          qualifier_range.end
        ) {
          None -> CheckedConstructorInvalidRange
          Some(qualifier_span) -> match registration_scope_lookup_qualified_declaration_span(
            lexical_scope(environment),
            lexical_module(environment),
            qualifier_span,
            ConstructorDeclaration,
            name
          ) {
            Some(registered) -> if declaration_identity_eq(
              registered.identity,
              declaration
            ) { CheckedConstructorResolved(qualifier_range) }
            else { CheckedConstructorMissing }
            None -> CheckedConstructorMissing
          }
        }
      }
    }
  }
}

fn checked_body_constructor_pattern_items(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  environment: CheckedLexicalEnvironment,
  input_type: SemanticTypeId,
  case_index: usize,
  authored: PatternList,
  index: usize,
  ordinals: List<usize>,
  complete: bool,
  range: CheckedSourceRange
) -[SemanticConformance]> CheckedConstructorPatternItemsBuild {
  match authored {
    PatternListNil -> CheckedConstructorPatternItemsBuilt(
      state,
      ordinals,
      environment,
      complete,
      range
    )
    PatternListCons(item, rest) -> {
      let applications = types.variant_applications
      let catalog = state.types()
      match semantic_variant_payload_type(
        applications,
        catalog,
        input_type,
        case_index,
        index
      ) {
        None -> CheckedConstructorPatternItemsRejected(
          state,
          CheckedBodyProducerVariantPatternRequired(input_type)
        )
        Some(payload_type) -> match checked_body_pattern(
          state,
          source,
          types,
          owner,
          environment,
          payload_type,
          item
        ) {
          CheckedBodyPatternRejected(state, issue) -> CheckedConstructorPatternItemsRejected(
            state,
            issue
          )
          CheckedBodyPatternBuilt(state, child, next_environment, coverage, child_range) -> {
            let next_types = checked_body_types_with_catalog(types, state.types())
            match covering_range(range, child_range) {
              nil -> CheckedConstructorPatternItemsRejected(
                state,
                CheckedBodyProducerInvalidRange
              )
              next_range: CheckedSourceRange -> checked_body_constructor_pattern_items(
                state,
                source,
                next_types,
                owner,
                next_environment,
                input_type,
                case_index,
                rest,
                index + 1,
                ordinals.append(checked_pattern_id_ordinal(child)),
                complete and checked_pattern_coverage_complete(coverage),
                next_range
              )
            }
          }
        }
      }
    }
  }
}

fn checked_body_constructor_pattern(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  environment: CheckedLexicalEnvironment,
  input_type: SemanticTypeId,
  name_start: i64,
  name_length: i64,
  authored: PatternList,
  authored_qualifier: TypeNameRange?
) -[SemanticConformance]> CheckedBodyPatternBuild {
  match source_range(source, name_start, name_length) {
    nil -> CheckedBodyPatternRejected(state, CheckedBodyProducerInvalidRange)
    name_range: CheckedSourceRange -> match source.span(name_range.start, name_range.end) {
      None -> CheckedBodyPatternRejected(state, CheckedBodyProducerInvalidRange)
      Some(name) -> match name.text() {
        None -> CheckedBodyPatternRejected(state, CheckedBodyProducerInvalidRange)
        Some(spelling) -> {
          let applications = types.variant_applications
          let catalog = state.types()
          match semantic_variant_case_projection(
            applications,
            catalog,
            input_type,
            spelling
          ) {
            SemanticVariantApplicationUnavailable -> CheckedBodyPatternRejected(
              state,
              CheckedBodyProducerVariantPatternRequired(input_type)
            )
            SemanticVariantCaseMissing -> CheckedBodyPatternRejected(
              state,
              CheckedBodyProducerUnknownConstructor(name_range)
            )
            SemanticVariantCaseProjected(declaration, case_index, payload_count) -> {
              let provided = __i64_to_usize(pattern_list_len(authored))
              if provided != payload_count {
                CheckedBodyPatternRejected(
                  state,
                  CheckedBodyProducerConstructorPatternArityMismatch(payload_count, provided)
                )
              } else {
                match checked_body_constructor_reference(
                  source,
                  environment,
                  declaration,
                  name_range,
                  authored_qualifier
                ) {
                  CheckedConstructorInvalidRange -> CheckedBodyPatternRejected(
                    state,
                    CheckedBodyProducerInvalidRange
                  )
                  CheckedConstructorMissing -> CheckedBodyPatternRejected(
                    state,
                    CheckedBodyProducerUnknownConstructor(name_range)
                  )
                  CheckedConstructorResolved(qualifier) ->
                    match checked_body_constructor_pattern_items(
                      state,
                      source,
                      types,
                      owner,
                      environment,
                      input_type,
                      case_index,
                      authored,
                      0,
                      Nil<usize>(),
                      true,
                      name_range
                    ) {
                      CheckedConstructorPatternItemsRejected(state, issue) ->
                        CheckedBodyPatternRejected(state, issue)
                      CheckedConstructorPatternItemsBuilt(
                      state,
                      ordinals,
                      next_environment,
                      complete,
                      child_range,
                    ) -> {
                      let selected_range: CheckedSourceRange? = match qualifier {
                        nil -> child_range
                        qualifier_range: CheckedSourceRange -> covering_range(
                          qualifier_range,
                          child_range
                        )
                      }
                      match selected_range {
                        nil -> CheckedBodyPatternRejected(
                          state,
                          CheckedBodyProducerInvalidRange
                        )
                        range: CheckedSourceRange -> {
                          let (state, list) = state.pattern_list()
                          let (state, list) = checked_body_tuple_pattern_list_into(
                            state,
                            list,
                            ordinals
                          )
                          let (state, children) = state.pattern_list_finish(list)
                          let applications = types.variant_applications
                          let catalog = state.types()
                          let case_count = match semantic_variant_case_count(
                            applications,
                            catalog,
                            input_type
                          ) {
                            Some(count) -> count
                            None -> panic("Projected variant has no case count")
                          }
                          match state.constructor_pattern(
                            declaration,
                            children,
                            qualifier,
                            input_type,
                            range
                          ) {
                            (state, pattern) -> CheckedBodyPatternBuilt(
                              state,
                              pattern,
                              next_environment,
                              if complete {
                                CheckedPatternVariantCases(
                                  Nil<DeclarationIdentity>().prepend(declaration),
                                  case_count
                                )
                              } else { CheckedPatternOpen },
                              range
                            )
                          }
                        }
                      }
                    }
                    }
                }
              }
            }
          }
        }
      }
    }
  }
}

fn checked_body_tuple_pattern_items(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  environment: CheckedLexicalEnvironment,
  input_type: SemanticTypeId,
  authored: PatternList,
  index: usize,
  ordinals: List<usize>,
  complete: bool,
  range: CheckedSourceRange
) -[SemanticConformance]> CheckedTuplePatternItemsBuild {
  match authored {
    PatternListNil -> CheckedTuplePatternItemsBuilt(
      state,
      ordinals,
      environment,
      complete,
      range
    )
    PatternListCons(item, rest) -> {
      let catalog = state.types()
      match semantic_tuple_pattern_element(catalog, input_type, index) {
        Some(element_type) -> match checked_body_pattern(
          state,
          source,
          types,
          owner,
          environment,
          element_type,
          item
        ) {
          CheckedBodyPatternBuilt(state, child, next_environment, coverage, child_range) -> {
            let next_catalog = state.types()
            let next_types = checked_body_types_with_catalog(types, next_catalog)
            match covering_range(range, child_range) {
              next_range: CheckedSourceRange -> checked_body_tuple_pattern_items(
                state,
                source,
                next_types,
                owner,
                next_environment,
                input_type,
                rest,
                index + 1,
                ordinals.append(checked_pattern_id_ordinal(child)),
                complete and checked_pattern_coverage_complete(coverage),
                next_range
              )
              nil -> CheckedTuplePatternItemsRejected(
                state,
                CheckedBodyProducerInvalidRange
              )
            }
          }
          CheckedBodyPatternRejected(state, issue) -> CheckedTuplePatternItemsRejected(
            state,
            issue
          )
        }
        None -> CheckedTuplePatternItemsRejected(
          state,
          CheckedBodyProducerTuplePatternRequired(input_type)
        )
      }
    }
  }
}

fn checked_body_tuple_pattern_list_into(
  state: owned CheckedBodyBuild,
  list: CheckedPatternListBuilder,
  ordinals: List<usize>
) -> (owned CheckedBodyBuild, CheckedPatternListBuilder) {
  match ordinals {
    Nil -> (state, list)
    Cons(ordinal, rest) -> {
      let child = checked_pattern_id_from_ordinal(state.segment(), ordinal)
      match state.pattern_list_push(list, child) {
        (state, list) -> checked_body_tuple_pattern_list_into(state, list, rest)
      }
    }
  }
}

fn checked_body_tuple_pattern(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  environment: CheckedLexicalEnvironment,
  input_type: SemanticTypeId,
  authored: PatternList
) -[SemanticConformance]> CheckedBodyPatternBuild {
  let catalog = state.types()
  match semantic_tuple_pattern_arity(catalog, input_type) {
    Some(expected) -> {
      let provided = __i64_to_usize(pattern_list_len(authored))
      if provided != expected {
        CheckedBodyPatternRejected(
          state,
          CheckedBodyProducerTuplePatternArityMismatch(expected, provided)
        )
      } else {
        match checked_body_tuple_pattern_items(
          state,
          source,
          types,
          owner,
          environment,
          input_type,
          authored,
          0,
          Nil<usize>(),
          true,
          CheckedSourceRange { start: 0, end: 0 }
        ) {
          CheckedTuplePatternItemsRejected(state, issue) -> CheckedBodyPatternRejected(
            state,
            issue
          )
          CheckedTuplePatternItemsBuilt(state, ordinals, next_environment, complete, range) -> {
            let (state, list) = state.pattern_list()
            let (state, list) = checked_body_tuple_pattern_list_into(state, list, ordinals)
            let (state, items) = state.pattern_list_finish(list)
            match state.tuple_pattern(items, input_type, range) {
              (state, pattern) -> CheckedBodyPatternBuilt(
                state,
                pattern,
                next_environment,
                if complete { CheckedPatternComplete } else { CheckedPatternOpen },
                range
              )
            }
          }
        }
      }
    }
    None -> CheckedBodyPatternRejected(
      state,
      CheckedBodyProducerTuplePatternRequired(input_type)
    )
  }
}

fn checked_body_record_name_seen(names: List<str>, wanted: str) -> bool {
  match names {
    Nil -> false
    Cons(name, rest) -> if name == wanted { true } else {
      checked_body_record_name_seen(rest, wanted)
    }
  }
}

fn checked_body_record_pattern_field_type(
  catalog: borrow SemanticTypeCatalog,
  applications: borrow SemanticRecordApplicationCatalog,
  input_type: SemanticTypeId,
  shape: CheckedBodyRecordPatternShape,
  name: str
) -> CheckedBodyRecordPatternFieldType {
  match shape {
    CheckedStructuralRecordPatternShape -> match semantic_record_field_projection(
      catalog,
      input_type,
      name
    ) {
      SemanticRecordFieldProjected(_, _, field_type) -> CheckedRecordPatternFieldSelected(
        field_type
      )
      SemanticRecordFieldUnplaced(_, _, field_type) -> CheckedRecordPatternFieldSelected(
        field_type
      )
      SemanticRecordFieldMissing -> CheckedRecordPatternFieldMissing
      SemanticRecordFieldProjectionUnavailable -> CheckedRecordPatternFieldUnavailable
    }
    CheckedDeclaredRecordPatternShape -> match semantic_declared_field_projection(
      applications,
      catalog,
      input_type,
      name
    ) {
      SemanticDeclaredFieldProjected(_, _, field_type) -> CheckedRecordPatternFieldSelected(
        field_type
      )
      SemanticDeclaredFieldMissing -> CheckedRecordPatternFieldMissing
      SemanticDeclaredFieldProjectionUnavailable -> CheckedRecordPatternFieldUnavailable
    }
  }
}

fn checked_body_record_pattern_items(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  environment: CheckedLexicalEnvironment,
  input_type: SemanticTypeId,
  shape: CheckedBodyRecordPatternShape,
  authored: PatternFieldList,
  names: List<str>,
  ordinals: List<usize>,
  complete: bool,
  range: CheckedSourceRange
) -[SemanticConformance]> CheckedRecordPatternItemsBuild {
  match authored {
    PatternFieldListNil -> CheckedRecordPatternItemsBuilt(
      state,
      names,
      ordinals,
      environment,
      complete,
      range
    )
    PatternFieldListCons(field, rest) -> match field {
      PatternField(start, length, child, _) -> match source_range(source, start, length) {
        field_range: CheckedSourceRange -> match source.span(
          field_range.start,
          field_range.end
        ) {
          Some(field_span) -> match field_span.text() {
            Some(name) -> if checked_body_record_name_seen(names, name) {
              CheckedRecordPatternItemsRejected(
                state,
                CheckedBodyProducerDuplicateRecordPatternField(field_range)
              )
            } else {
              let catalog = state.types()
              let applications = types.applications
              match checked_body_record_pattern_field_type(
                catalog,
                applications,
                input_type,
                shape,
                name
              ) {
                CheckedRecordPatternFieldSelected(element_type) -> match checked_body_pattern(
                  state,
                  source,
                  types,
                  owner,
                  environment,
                  element_type,
                  child
                ) {
                  CheckedBodyPatternBuilt(
                    state,
                    checked_child,
                    next_environment,
                    coverage,
                    child_range,
                  ) -> {
                    let next_catalog = state.types()
                    let next_types = checked_body_types_with_catalog(types, next_catalog)
                    match covering_range(field_range, child_range) {
                      selected_range: CheckedSourceRange -> match covering_range(
                        range,
                        selected_range
                      ) {
                        next_range: CheckedSourceRange -> checked_body_record_pattern_items(
                          state,
                          source,
                          next_types,
                          owner,
                          next_environment,
                          input_type,
                          shape,
                          rest,
                          names.append(name),
                          ordinals.append(checked_pattern_id_ordinal(checked_child)),
                          complete and checked_pattern_coverage_complete(coverage),
                          next_range
                        )
                        nil -> CheckedRecordPatternItemsRejected(
                          state,
                          CheckedBodyProducerInvalidRange
                        )
                      }
                      nil -> CheckedRecordPatternItemsRejected(
                        state,
                        CheckedBodyProducerInvalidRange
                      )
                    }
                  }
                  CheckedBodyPatternRejected(state, issue) -> CheckedRecordPatternItemsRejected(
                    state,
                    issue
                  )
                }
                CheckedRecordPatternFieldMissing -> CheckedRecordPatternItemsRejected(
                  state,
                  CheckedBodyProducerUnknownField(field_range)
                )
                CheckedRecordPatternFieldUnavailable -> CheckedRecordPatternItemsRejected(
                  state,
                  CheckedBodyProducerRecordPatternRequired(input_type)
                )
              }
            }
            None -> CheckedRecordPatternItemsRejected(
              state,
              CheckedBodyProducerInvalidRange
            )
          }
          None -> CheckedRecordPatternItemsRejected(
            state,
            CheckedBodyProducerInvalidRange
          )
        }
        nil -> CheckedRecordPatternItemsRejected(
          state,
          CheckedBodyProducerInvalidRange
        )
      }
      UnknownPatternField(_) -> CheckedRecordPatternItemsRejected(
        state,
        CheckedBodyProducerUnsupportedPattern
      )
    }
  }
}

fn checked_body_record_pattern_with_shape(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  environment: CheckedLexicalEnvironment,
  input_type: SemanticTypeId,
  authored: PatternFieldList,
  shape: CheckedBodyRecordPatternShape
) -[SemanticConformance]> CheckedBodyPatternBuild {
  match checked_body_record_pattern_items(
    state,
    source,
    types,
    owner,
    environment,
    input_type,
    shape,
    authored,
    Nil<str>(),
    Nil<usize>(),
    true,
    CheckedSourceRange { start: 0, end: 0 }
  ) {
    CheckedRecordPatternItemsRejected(state, issue) -> CheckedBodyPatternRejected(
      state,
      issue
    )
    CheckedRecordPatternItemsBuilt(state, names, ordinals, next_environment, complete, range) ->
      match state.record_pattern(input_type, shape, types.applications, names, ordinals, range) {
        (state, pattern) -> CheckedBodyPatternBuilt(
          state,
          pattern,
          next_environment,
          if complete { CheckedPatternComplete } else { CheckedPatternOpen },
          range
        )
      }
  }
}

fn checked_body_record_pattern(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  environment: CheckedLexicalEnvironment,
  input_type: SemanticTypeId,
  authored: PatternFieldList
) -[SemanticConformance]> CheckedBodyPatternBuild {
  let catalog = state.types()
  if semantic_structural_record(catalog, input_type) {
    checked_body_record_pattern_with_shape(
      state,
      source,
      types,
      owner,
      environment,
      input_type,
      authored,
      CheckedStructuralRecordPatternShape
    )
  } else {
    let declaration = match catalog.graph_for(input_type) {
      None -> None<DeclarationIdentity>()
      Some(graph) -> match semantic_type_graph_node(graph, input_type) {
        SemanticNamedNode(found, _, _, _) -> Some<DeclarationIdentity>(found)
        _ -> None<DeclarationIdentity>()
      }
    }
    let resolution = types.resolution
    let declarations = resolution.declarations()
    match declaration {
      Some(found) -> match semantic_type_declared_record_template(
        catalog,
        declarations,
        found
      ) {
        SemanticRecordDeclarationTemplateSelected(_, _, _) -> {
          let product = semantic_type_product_continue(
            types.module.identity,
            catalog,
            catalog.next_derived_segment(types.module.identity, resolution.next_type_segment())
          )
          let ready_types = checked_body_nominal_record_materialize(
            checked_body_types_with_catalog(types, catalog),
            product,
            input_type
          )
          checked_body_record_pattern_with_shape(
            state.with_types(ready_types.catalog),
            source,
            ready_types,
            owner,
            environment,
            input_type,
            authored,
            CheckedDeclaredRecordPatternShape
          )
        }
        _ -> CheckedBodyPatternRejected(
          state,
          CheckedBodyProducerRecordPatternRequired(input_type)
        )
      }
      None -> CheckedBodyPatternRejected(
        state,
        CheckedBodyProducerRecordPatternRequired(input_type)
      )
    }
  }
}

fn checked_body_pattern(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  environment: CheckedLexicalEnvironment,
  input_type: SemanticTypeId,
  authored: Pattern
) -[SemanticConformance]> CheckedBodyPatternBuild {
  let catalog = types.catalog
  match authored {
    Wildcard -> match state.wildcard_pattern(
      input_type,
      CheckedSourceRange { start: 0, end: 0 }
    ) {
      (state, pattern) -> CheckedBodyPatternBuilt(
        state,
        pattern,
        environment,
        CheckedPatternComplete,
        CheckedSourceRange { start: 0, end: 0 }
      )
    }
    Binding(start, length) -> match source_range(source, start, length) {
      range: CheckedSourceRange -> match state.binding(
        owner,
        input_type,
        range,
        CheckedImmutableBinding
      ) {
        (state, binding) -> match state.binding_pattern(
          binding,
          input_type,
          range
        ) {
          (state, pattern) -> CheckedBodyPatternBuilt(
            state,
            pattern,
            CheckedLexicalBinding(
              start,
              length,
              binding,
              input_type,
              false,
              environment
            ),
            CheckedPatternComplete,
            range
          )
        }
      }
      nil -> CheckedBodyPatternRejected(state, CheckedBodyProducerInvalidRange)
    }
    IntPattern(value, start, length, origin) -> match source_range(
      source,
      start,
      length
    ) {
      range: CheckedSourceRange -> match origin {
        NumericPatternOrigin -> if semantic_integer_type(catalog, input_type) {
          match state.integer_pattern(
            value,
            CheckedNumericPattern,
            input_type,
            range
          ) {
            (state, pattern) -> CheckedBodyPatternBuilt(
              state,
              pattern,
              environment,
              CheckedPatternOpen,
              range
            )
          }
        } else {
          CheckedBodyPatternRejected(
            state,
            CheckedBodyProducerIntegerOperandRequired(input_type)
          )
        }
        BooleanPatternOrigin -> if semantic_type_catalog_equal(
          catalog,
          input_type,
          types.boolean
        ) {
          match state.integer_pattern(
            value,
            CheckedBooleanPattern,
            input_type,
            range
          ) {
            (state, pattern) -> CheckedBodyPatternBuilt(
              state,
              pattern,
              environment,
              if value == 0 {
                CheckedPatternBooleanFalse
              } else { CheckedPatternBooleanTrue },
              range
            )
          }
        } else {
          CheckedBodyPatternRejected(
            state,
            CheckedBodyProducerTypeMismatch(input_type, types.boolean)
          )
        }
      }
      nil -> CheckedBodyPatternRejected(state, CheckedBodyProducerInvalidRange)
    }
    NilPattern(start, length) -> match source_range(source, start, length) {
      range: CheckedSourceRange -> if semantic_type_is_subtype(
        catalog,
        types.nil_type,
        input_type
      ) {
        match state.nil_pattern(input_type, range) {
          (state, pattern) -> CheckedBodyPatternBuilt(
            state,
            pattern,
            environment,
            if semantic_type_catalog_equal(catalog, input_type, types.nil_type) {
              CheckedPatternComplete
            } else { CheckedPatternOpen },
            range
          )
        }
      } else {
        CheckedBodyPatternRejected(
          state,
          CheckedBodyProducerTypeMismatch(types.nil_type, input_type)
        )
      }
      nil -> CheckedBodyPatternRejected(state, CheckedBodyProducerInvalidRange)
    }
    CtorPattern(start, length, children, _, qualifier) -> checked_body_constructor_pattern(
      state,
      source,
      types,
      owner,
      environment,
      input_type,
      start,
      length,
      children,
      qualifier
    )
    TuplePattern(items) -> checked_body_tuple_pattern(
      state,
      source,
      types,
      owner,
      environment,
      input_type,
      items
    )
    RecordPattern(fields) -> checked_body_record_pattern(
      state,
      source,
      types,
      owner,
      environment,
      input_type,
      fields
    )
    _ -> CheckedBodyPatternRejected(state, CheckedBodyProducerUnsupportedPattern)
  }
}

fn checked_match_arm_expectation(
  expectation: CheckedBodyExpectation
) -> CheckedBodyExpectation {
  match expectation {
    CheckedRequireResult(expected) -> CheckedRequireResult(expected)
    CheckedInferResult -> CheckedInferResult
  }
}

fn checked_match_arm_result(
  expectation: CheckedBodyExpectation,
  previous: CheckedMatchResult,
  body_type: SemanticTypeId
) -> CheckedMatchResult {
  if previous.resolved { previous }
  else {
    CheckedMatchResult {
      resolved: true,
      value: match expectation {
        CheckedRequireResult(expected) -> expected
        CheckedInferResult -> body_type
      }
    }
  }
}

fn checked_match_arm_coverage(
  accumulated: CheckedPatternCoverage,
  pattern: CheckedPatternCoverage,
  guarded: bool
) -> CheckedPatternCoverage {
  if guarded { accumulated }
  else { checked_pattern_coverage_add(accumulated, pattern) }
}

fn checked_match_arm_result_accepts(
  catalog: borrow SemanticTypeCatalog,
  expectation: CheckedBodyExpectation,
  previous: CheckedMatchResult,
  body_type: SemanticTypeId
) -> bool {
  match expectation {
    CheckedRequireResult(_) -> true
    CheckedInferResult -> if previous.resolved {
      semantic_type_catalog_equal(
        catalog,
        previous.value,
        body_type
      )
    } else { true }
  }
}

fn checked_body_match_arm_body(
  state: owned CheckedBodyBuild,
  context: CheckedMatchContext,
  environment: CheckedLexicalEnvironment,
  arm: CheckedPreparedMatchArm,
  progress: CheckedMatchProgress
) -[SemanticConformance]> CheckedBodyArmsBuild {
  let catalog = context.types.catalog
  match checked_body_expr(
    state,
    context.source,
    context.types,
    context.owner,
    context.function_result,
    context.loop_context,
    environment,
    arm.body,
    checked_match_arm_expectation(context.expectation)
  ) {
    CheckedBodyExprBuilt(state, checked_body) -> {
      let body_type = state.result_type(checked_body)
      let body_range = state.range(checked_body)
      let selected_result = checked_match_arm_result(
        context.expectation,
        progress.result,
        body_type
      )
      if semantic_continuation_type(catalog, body_type) {
        CheckedBodyArmsRejected(
          state,
          CheckedBodyProducerContinuationBranchEscape(body_range)
        )
      } else if not checked_match_arm_result_accepts(
        catalog,
        context.expectation,
        progress.result,
        body_type
      ) {
        CheckedBodyArmsRejected(
          state,
          CheckedBodyProducerInferredBranchMismatch(progress.result.value, body_type)
        )
      } else {
        match covering_range(arm.pattern_range, arm.guard_range) {
          guarded_range: CheckedSourceRange -> match covering_range(
            guarded_range,
            body_range
          ) {
            arm_range: CheckedSourceRange -> match state.match_arm_list_push(
              progress.list,
              arm.pattern,
              arm.guard,
              checked_body,
              arm_range
            ) {
              (state, list) -> match covering_range(progress.range, arm_range) {
                next_range: CheckedSourceRange -> checked_body_match_arms(
                  state,
                  context,
                  arm.rest,
                  CheckedMatchProgress {
                    list: list,
                    result: selected_result,
                    coverage: checked_match_arm_coverage(
                      progress.coverage,
                      arm.coverage,
                      match arm.guard {
                        CheckedUnguarded -> false
                        CheckedGuarded(_) -> true
                      }
                    ),
                    range: next_range
                  }
                )
                nil -> CheckedBodyArmsRejected(
                  state,
                  CheckedBodyProducerInvalidRange
                )
              }
            }
            nil -> CheckedBodyArmsRejected(state, CheckedBodyProducerInvalidRange)
          }
          nil -> CheckedBodyArmsRejected(state, CheckedBodyProducerInvalidRange)
        }
      }
    }
    CheckedBodyExprRejected(state, issue) -> CheckedBodyArmsRejected(state, issue)
  }
}

fn checked_body_match_arm(
  state: owned CheckedBodyBuild,
  context: CheckedMatchContext,
  arm: MatchArm,
  rest: MatchArmList,
  progress: CheckedMatchProgress
) -[SemanticConformance]> CheckedBodyArmsBuild {
  match arm {
    Arm(pattern, body, guard, has_guard) -> match checked_body_pattern(
      state,
      context.source,
      context.types,
      context.owner,
      context.environment,
      context.input_type,
      pattern
    ) {
      CheckedBodyPatternBuilt(
        state,
        checked_pattern,
        arm_environment,
        pattern_coverage,
        pattern_range,
      ) -> if has_guard == 0 {
        checked_body_match_arm_body(
          state,
          context,
          arm_environment,
          CheckedPreparedMatchArm {
            pattern: checked_pattern,
            coverage: pattern_coverage,
            pattern_range: pattern_range,
            guard: CheckedUnguarded,
            guard_range: pattern_range,
            body: body,
            rest: rest
          },
          progress
        )
      } else {
        match checked_body_expr(
          state,
          context.source,
          context.types,
          context.owner,
          context.function_result,
          context.loop_context,
          arm_environment,
          guard,
          CheckedRequireResult(context.types.boolean)
        ) {
          CheckedBodyExprBuilt(state, checked_guard) -> {
            let guard_range = state.range(checked_guard)
            checked_body_match_arm_body(
              state,
              context,
              arm_environment,
              CheckedPreparedMatchArm {
                pattern: checked_pattern,
                coverage: pattern_coverage,
                pattern_range: pattern_range,
                guard: CheckedGuarded(checked_guard),
                guard_range: guard_range,
                body: body,
                rest: rest
              },
              progress
            )
          }
          CheckedBodyExprRejected(state, issue) -> CheckedBodyArmsRejected(state, issue)
        }
      }
      CheckedBodyPatternRejected(state, issue) -> CheckedBodyArmsRejected(state, issue)
    }
    UnknownArm(_) -> CheckedBodyArmsRejected(
      state,
      CheckedBodyProducerUnsupportedMatchArm
    )
  }
}

fn checked_body_match_arms(
  state: owned CheckedBodyBuild,
  context: CheckedMatchContext,
  authored: MatchArmList,
  progress: CheckedMatchProgress
) -[SemanticConformance]> CheckedBodyArmsBuild {
  match authored {
    MatchArmListNil -> if not progress.result.resolved {
      CheckedBodyArmsRejected(
        state,
        CheckedBodyProducerNonExhaustiveMatch
      )
    } else {
      if checked_pattern_coverage_complete(progress.coverage) {
        match state.finish_match_arm_list(progress.list) {
          (state, arms) -> CheckedBodyArmsBuilt(
            state,
            arms,
            progress.result.value,
            progress.coverage,
            progress.range
          )
        }
      } else {
        CheckedBodyArmsRejected(state, CheckedBodyProducerNonExhaustiveMatch)
      }
    }
    MatchArmListCons(arm, rest) -> checked_body_match_arm(
      state,
      context,
      arm,
      rest,
      progress
    )
  }
}

fn checked_body_match(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  scrutinee: Expr,
  arms: MatchArmList,
  origin: MatchOrigin,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  match checked_body_expr(
    state,
    source,
    types,
    owner,
    function_result,
    loop_context,
    environment,
    scrutinee,
    CheckedInferResult
  ) {
    CheckedBodyExprBuilt(state, checked_scrutinee) -> {
      let input_type = state.result_type(checked_scrutinee)
      let scrutinee_range = state.range(checked_scrutinee)
      match state.match_arm_list() {
        (state, list) -> match checked_body_match_arms(
          state,
          CheckedMatchContext {
            source: source,
            types: types,
            owner: owner,
            function_result: function_result,
            loop_context: loop_context,
            environment: environment,
            input_type: input_type,
            expectation: expectation
          },
          arms,
          CheckedMatchProgress {
            list: list,
            result: CheckedMatchResult {
              resolved: false,
              value: types.never_type
            },
            coverage: CheckedPatternOpen,
            range: scrutinee_range
          }
        ) {
          CheckedBodyArmsBuilt(state, checked_arms, result, _, range) ->
            match state.match_expr(
              checked_match_origin(origin),
              checked_scrutinee,
              checked_arms,
              result,
              range
            ) {
              (state, expression) -> CheckedBodyExprBuilt(state, expression)
            }
          CheckedBodyArmsRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
        }
      }
    }
    CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
  }
}

fn checked_body_prepare_effect_arguments(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  atom: SemanticTypeId,
  operation: str,
  parameter_count: usize,
  arguments: ExprList,
  index: usize,
  total: usize,
  values: List<usize>,
  range: CheckedSourceRange
) -[SemanticConformance]> CheckedBodyEffectArgumentsPreparation {
  let applications = types.effect_applications
  let catalog = types.catalog
  match arguments {
    ExprListNil -> if index == parameter_count {
      CheckedBodyEffectArgumentsPrepared(state, values.reverse(), range)
    } else {
      CheckedBodyEffectArgumentsPreparationRejected(
        state,
        CheckedBodyProducerArityMismatch(parameter_count, total)
      )
    }
    ExprListCons(argument, rest) -> if index >= parameter_count {
      CheckedBodyEffectArgumentsPreparationRejected(
        state,
        CheckedBodyProducerArityMismatch(parameter_count, total)
      )
    } else {
      match semantic_effect_application_parameter_type(
        applications,
        catalog,
        atom,
        operation,
        index
      ) {
        None -> CheckedBodyEffectArgumentsPreparationRejected(
          state,
          CheckedBodyProducerEffectApplicationUnavailable
        )
        Some(parameter) -> match checked_body_expr(
          state,
          source,
          types,
          owner,
          function_result,
          loop_context,
          environment,
          argument,
          CheckedRequireResult(parameter)
        ) {
          CheckedBodyExprBuilt(state, checked_argument) -> {
            let argument_range = state.range(checked_argument)
            match covering_range(range, argument_range) {
              next_range: CheckedSourceRange -> checked_body_prepare_effect_arguments(
                state,
                source,
                types,
                owner,
                function_result,
                loop_context,
                environment,
                atom,
                operation,
                parameter_count,
                rest,
                index + 1,
                total,
                values.prepend(checked_expr_id_ordinal(checked_argument)),
                next_range
              )
              nil -> CheckedBodyEffectArgumentsPreparationRejected(
                state,
                CheckedBodyProducerInvalidRange
              )
            }
          }
          CheckedBodyExprRejected(state, issue) ->
            CheckedBodyEffectArgumentsPreparationRejected(state, issue)
        }
      }
    }
  }
}

fn checked_body_materialize_effect_arguments(
  state: owned CheckedBodyBuild,
  values: List<usize>,
  list: CheckedExprListBuilder
) -> (owned CheckedBodyBuild, CheckedExprListId) {
  match values {
    Nil -> state.finish_expression_list(list)
    Cons(ordinal, remaining) -> {
      let expression = checked_expr_id_from_ordinal(state.segment(), ordinal)
      match state.expression_list_push(list, expression) {
        (state, list) -> checked_body_materialize_effect_arguments(
          state,
          remaining,
          list
        )
      }
    }
  }
}

fn checked_body_explicit_effect(
  module: RegisteredModule,
  types: CheckedBodyPrimitiveTypes,
  environment: CheckedLexicalEnvironment,
  effect_ref: TypeExpr,
  operation: str
) -> (CheckedBodyEffectSelection, SemanticTypeResolutionIssue?) {
  let resolution = types.resolution
  let applications = types.effect_applications
  let catalog = types.catalog
  let next_segment = catalog.next_derived_segment(module.identity, resolution.next_type_segment())
  let product = semantic_type_product_continue(
    module.identity,
    catalog,
    next_segment
  )
  match resolve_type_product_in_scope(
    product,
    module,
    lexical_scope(environment),
    lexical_type_parameters(environment),
    effect_ref
  ) {
    (_, SemanticTypeRejected(issue)) -> (
      CheckedBodyEffectSelectionMissing,
      issue
    )
    (product, SemanticTypeResolved(atom)) -> {
      let catalog = semantic_type_product_catalog(product)
      let selection = match semantic_effect_operation_projection(
        applications,
        catalog,
        atom,
        operation
      ) {
        SemanticEffectOperationProjected(
          canonical,
          declaration,
          operation_declaration,
          deferred,
          parameter_count,
          result,
        ) -> CheckedBodyEffectSelected(
          CheckedBodyEffectSite {
            atom: canonical,
            effect_declaration: declaration,
            operation_declaration: operation_declaration,
            deferred: deferred,
            parameter_count: parameter_count,
            result: result
          }
        )
        SemanticEffectOperationMissing -> CheckedBodyEffectOperationMissing
        SemanticEffectApplicationUnavailable -> CheckedBodyEffectApplicationMissing
      }
      (selection, nil)
    }
  }
}

fn checked_body_materialized_handler_effect(
  product: SemanticTypeProductBuilder,
  types: CheckedBodyPrimitiveTypes,
  declarations: borrow SemanticTypeDeclarationCatalog,
  effect_declarations: borrow SemanticEffectDeclarationCatalog,
  atom: SemanticTypeId,
  operation: str
) -> (
  CheckedBodyPrimitiveTypes,
  CheckedBodyEffectSelection,
  SemanticTypeResolutionIssue?
) {
  let (product, applications, variant_applications, effect_applications) = semantic_applications_materialize_type(
    product,
    types.applications,
    types.variant_applications,
    types.effect_applications,
    declarations,
    effect_declarations,
    atom
  )
  let catalog = semantic_type_product_catalog(product)
  let next_types = checked_body_types_with_applications(
    types,
    catalog,
    applications,
    variant_applications,
    effect_applications
  )
  let selection = match semantic_effect_operation_projection(
    effect_applications,
    catalog,
    atom,
    operation
  ) {
    SemanticEffectOperationProjected(
      canonical,
      declaration,
      operation_declaration,
      deferred,
      parameter_count,
      result,
    ) -> CheckedBodyEffectSelected(
      CheckedBodyEffectSite {
        atom: canonical,
        effect_declaration: declaration,
        operation_declaration: operation_declaration,
        deferred: deferred,
        parameter_count: parameter_count,
        result: result
      }
    )
    SemanticEffectOperationMissing -> CheckedBodyEffectOperationMissing
    SemanticEffectApplicationUnavailable -> CheckedBodyEffectApplicationMissing
  }
  (next_types, selection, nil)
}

fn checked_body_materialize_effect_atom(
  product: SemanticTypeProductBuilder,
  types: CheckedBodyPrimitiveTypes,
  environment: CheckedLexicalEnvironment,
  atom: SemanticTypeId,
  operation: str
) -> (
  CheckedBodyPrimitiveTypes,
  CheckedBodyEffectSelection,
  SemanticTypeResolutionIssue?
) {
  let resolution = types.resolution
  let declarations = resolution.declarations()
  let effect_declarations = resolution.effects()
  let scope = lexical_scope(environment)
  let module = types.module
  let resolved_catalog = semantic_type_product_catalog(product)
  match resolved_catalog.graph_for(atom) {
    None -> (types, CheckedBodyEffectApplicationMissing, nil)
    Some(graph) -> match semantic_type_graph_node(graph, atom) {
      SemanticEffectAtomNode(declaration, _) -> {
        let owner = declaration_identity_module(declaration)
        if module_identity_eq(owner, module.identity) {
          checked_body_materialized_handler_effect(
            product,
            types,
            declarations,
            effect_declarations,
            atom,
            operation
          )
        } else {
          match registration_scope_find(scope, owner) {
            None -> (types, CheckedBodyEffectApplicationMissing, nil)
            Some(owner_module) -> match semantic_effect_declaration_extend(
              product,
              owner_module,
              scope,
              effect_declarations,
              declaration
            ) {
              Some(SemanticEffectsResolved(product, imported_declarations)) ->
                checked_body_materialized_handler_effect(
                  product,
                  types,
                  declarations,
                  imported_declarations,
                  atom,
                  operation
                )
              _ -> (types, CheckedBodyEffectApplicationMissing, nil)
            }
          }
        }
      }
      _ -> (types, CheckedBodyEffectApplicationMissing, nil)
    }
  }
}

fn checked_body_explicit_handler_effect(
  module: RegisteredModule,
  types: CheckedBodyPrimitiveTypes,
  environment: CheckedLexicalEnvironment,
  effect_ref: TypeExpr,
  operation: str
) -> (
  CheckedBodyPrimitiveTypes,
  CheckedBodyEffectSelection,
  SemanticTypeResolutionIssue?
) {
  let resolution = types.resolution
  let catalog = types.catalog
  let next_segment = catalog.next_derived_segment(module.identity, resolution.next_type_segment())
  let product = semantic_type_product_continue(module.identity, catalog, next_segment)
  match resolve_type_product_in_scope(
    product,
    module,
    lexical_scope(environment),
    lexical_type_parameters(environment),
    effect_ref
  ) {
    (_, SemanticTypeRejected(issue)) -> (types, CheckedBodyEffectSelectionMissing, issue)
    (product, SemanticTypeResolved(atom)) -> checked_body_materialize_effect_atom(
      product,
      types,
      environment,
      atom,
      operation
    )
  }
}

fn checked_body_method_variable_eq(
  left: SemanticTypeVariable,
  right: SemanticTypeVariable
) -> bool {
  match (left, right) {
    (SemanticSelfVariable, SemanticSelfVariable) -> true
    (SemanticParameterVariable(a), SemanticParameterVariable(b)) -> a == b
    _ -> false
  }
}

fn checked_body_bound_method_selection(
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  receiver: SemanticTypeId,
  variable: SemanticTypeVariable,
  spelling: str,
  required_trait: DeclarationIdentity?
) -> CheckedBodyMethodSelection {
  let resolution = types.resolution
  let signatures = resolution.signatures()
  match signatures.find(owner) {
    None -> CheckedBodyMethodSelectionMissing
    Some(signature) -> {
      let methods = resolution.methods()
      let catalog = types.catalog
      let mut selected = CheckedBodyMethodSelectionMissing
      let mut index: usize = 0
      while index < signatures.bound_count(signature) {
        let bound = signatures.bound_at(signature, index)
        if checked_body_method_variable_eq(bound.variable, variable) {
          match catalog.graph_for(bound.trait_atom) {
            None -> nil
            Some(graph) -> match semantic_type_graph_node(graph, bound.trait_atom) {
              SemanticTraitNode(declaration, _) -> if match required_trait {
                nil -> true
                required: DeclarationIdentity -> declaration_identity_eq(declaration, required)
              } {
                match semantic_trait_method_select(methods, declaration, spelling) {
                  SemanticTraitMethodSelected(method, method_signature) -> {
                    let candidate = CheckedBodyMethodSelected(
                      method,
                      method_signature,
                      semantic_trait_method_substitution(
                        catalog,
                        bound.trait_atom,
                        receiver
                      )
                    )
                    selected = match selected {
                      CheckedBodyMethodSelectionMissing -> candidate
                      _ -> CheckedBodyMethodSelectionAmbiguous
                    }
                  }
                  _ -> nil
                }
              } else { nil }
              _ -> nil
            }
          }
        } else { nil }
        index = index + 1
      }
      selected
    }
  }
}

fn checked_body_method_selection(
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  receiver: SemanticTypeId,
  spelling: str
) -> CheckedBodyMethodSelection {
  let catalog = types.catalog
  let resolution = types.resolution
  let methods = resolution.methods()
  let conformances = resolution.conformances()
  match catalog.graph_for(receiver) {
    None -> CheckedBodyMethodSelectionMissing
    Some(graph) -> match semantic_type_graph_node(graph, receiver) {
      SemanticVariableNode(variable) -> checked_body_bound_method_selection(
        types,
        owner,
        receiver,
        variable,
        spelling,
        nil
      )
      _ -> {
        let direct = semantic_implementation_method_select(
          methods,
          catalog,
          conformances,
          receiver,
          spelling
        )
        let selected = match direct {
          SemanticImplementationMethodSelectionMissing ->
            match semantic_type_graph_node(graph, receiver) {
              SemanticOwnedNode(inner) -> semantic_implementation_method_select(
                methods,
                catalog,
                conformances,
                inner,
                spelling
              )
              _ -> direct
            }
          _ -> direct
        }
        match selected {
          SemanticImplementationMethodSelected(declaration, _, signature, substitution) ->
            CheckedBodyMethodSelected(declaration, signature, substitution)
          SemanticImplementationMethodSelectionMissing -> CheckedBodyMethodSelectionMissing
          SemanticImplementationMethodSelectionAmbiguous -> CheckedBodyMethodSelectionAmbiguous
        }
      }
    }
  }
}

fn checked_body_method_selection_for_trait(
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  receiver: SemanticTypeId,
  trait_declaration: DeclarationIdentity,
  spelling: str
) -> CheckedBodyMethodSelection {
  let catalog = types.catalog
  let resolution = types.resolution
  match catalog.graph_for(receiver) {
    None -> CheckedBodyMethodSelectionMissing
    Some(graph) -> match semantic_type_graph_node(graph, receiver) {
      SemanticVariableNode(variable) -> checked_body_bound_method_selection(
        types,
        owner,
        receiver,
        variable,
        spelling,
        trait_declaration
      )
      _ -> {
        let methods = resolution.methods()
        let conformances = resolution.conformances()
        match semantic_trait_implementation_method_select(
          methods,
          catalog,
          conformances,
          receiver,
          trait_declaration,
          spelling
        ) {
          SemanticImplementationMethodSelected(declaration, _, signature, substitution) ->
            CheckedBodyMethodSelected(declaration, signature, substitution)
          SemanticImplementationMethodSelectionMissing -> CheckedBodyMethodSelectionMissing
          SemanticImplementationMethodSelectionAmbiguous -> CheckedBodyMethodSelectionAmbiguous
        }
      }
    }
  }
}

fn checked_body_perform_selection(
  module: RegisteredModule,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  environment: CheckedLexicalEnvironment,
  effect_ref: Expr,
  operation: str
) -> (
  CheckedBodyPrimitiveTypes,
  CheckedBodyEffectSelection,
  SemanticTypeResolutionIssue?
) {
  match checked_body_effect_reference(source, environment, effect_ref) {
    CheckedBodyExplicitEffect(authored) -> checked_body_explicit_handler_effect(
      module,
      types,
      environment,
      authored,
      operation
    )
    CheckedBodyBareEffect(declaration) -> match checked_body_select_lexical_effect(
      types,
      environment,
      declaration,
      operation
    ) {
      CheckedBodyEffectApplicationNeedsMaterialization(atom) -> {
        let catalog = types.catalog
        let resolution = types.resolution
        let segment = catalog.next_derived_segment(
          module.identity,
          resolution.next_type_segment()
        )
        checked_body_materialize_effect_atom(
          semantic_type_product_continue(module.identity, catalog, segment),
          types,
          environment,
          atom,
          operation
        )
      }
      CheckedBodyEffectSelectionMissing -> match checked_body_nullary_effect_type(effect_ref) {
        Some(authored) -> checked_body_explicit_handler_effect(
          module,
          types,
          environment,
          authored,
          operation
        )
        None -> (types, CheckedBodyEffectSelectionMissing, nil)
      }
      selection -> (types, selection, nil)
    }
    CheckedBodyInvalidEffectReference -> (
      types,
      CheckedBodyEffectSelectionMissing,
      nil
    )
  }
}

fn checked_body_handler_selection(
  module: RegisteredModule,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  environment: CheckedLexicalEnvironment,
  effect_ref: Expr,
  operation: str
) -> (CheckedBodyEffectSelection, SemanticTypeResolutionIssue?) {
  match checked_body_effect_reference(source, environment, effect_ref) {
    CheckedBodyExplicitEffect(authored) -> checked_body_explicit_effect(
      module,
      types,
      environment,
      authored,
      operation
    )
    CheckedBodyBareEffect(declaration) -> (
      checked_body_select_registered_effect(types, declaration, operation),
      nil
    )
    CheckedBodyInvalidEffectReference -> (
      CheckedBodyEffectSelectionMissing,
      nil
    )
  }
}

fn checked_body_handler_parameter_type(
  types: CheckedBodyPrimitiveTypes,
  environment: CheckedLexicalEnvironment,
  annotation: TypeExpr,
  operation_type: SemanticTypeId
) -[SemanticConformance]> CheckedBodyHandlerParameterType {
  let resolution = types.resolution
  let module = types.module
  let catalog = types.catalog
  match annotation {
    MissingTypeExpr -> CheckedBodyHandlerParameterTypeResolved(operation_type)
    _ -> match resolve_type_product_in_scope(
      resolution.continue_types(),
      module,
      lexical_scope(environment),
      lexical_type_parameters(environment),
      annotation
    ) {
      (_, SemanticTypeRejected(issue)) -> CheckedBodyHandlerParameterTypeRejected(
        CheckedBodyProducerTypeRejected(issue)
      )
      (product, SemanticTypeResolved(annotation_type)) -> {
        let resolved_catalog = semantic_type_product_catalog(product)
        if not semantic_type_is_subtype(
          resolved_catalog,
          operation_type,
          annotation_type
        ) {
          CheckedBodyHandlerParameterTypeRejected(
            CheckedBodyProducerTypeMismatch(operation_type, annotation_type)
          )
        } else {
          match catalog.graph_for(annotation_type) {
            Some(_) -> CheckedBodyHandlerParameterTypeResolved(annotation_type)
            None -> CheckedBodyHandlerParameterTypeRejected(
              CheckedBodyProducerBodyLocalTypeUnavailable(annotation_type)
            )
          }
        }
      }
    }
  }
}

fn checked_body_continuation_type(
  state: owned CheckedBodyBuild,
  types: CheckedBodyPrimitiveTypes,
  input: SemanticTypeId,
  result: SemanticTypeId
) -> (owned CheckedBodyBuild, CheckedBodyPrimitiveTypes, SemanticTypeId) {
  let catalog = state.types()
  let module = types.module
  let resolution = types.resolution
  let segment = semantic_type_derived_segment_id(
    module.identity,
    catalog.next_derived_segment(module.identity, resolution.next_type_segment())
  )
  let builder = semantic_type_graph_builder(segment)
  let (builder, continuation) = builder.continuation(input, result)
  let next_catalog = semantic_type_catalog_with_graph(catalog, builder.freeze())
  (
    state.with_types(next_catalog),
    checked_body_types_with_catalog(types, next_catalog),
    continuation
  )
}

fn checked_body_handler_parameters(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  environment: CheckedLexicalEnvironment,
  atom: SemanticTypeId,
  operation: str,
  parameters: ParamList,
  index: usize,
  expected_count: usize,
  list: CheckedHandlerParameterListBuilder
) -[SemanticConformance]> CheckedBodyHandlerParametersBuild {
  let applications = types.effect_applications
  let catalog = types.catalog
  match parameters {
    ParamListNil -> if index == expected_count {
      CheckedBodyHandlerParametersBuilt(state, list, environment)
    } else {
      CheckedBodyHandlerParametersRejected(
        state,
        CheckedBodyProducerArityMismatch(expected_count, index)
      )
    }
    ParamListCons(parameter, rest) -> if index >= expected_count {
      CheckedBodyHandlerParametersRejected(
        state,
        CheckedBodyProducerArityMismatch(expected_count, index + 1)
      )
    } else {
      match parameter {
        Param(start, length, annotation, _) -> match (
          source_range(source, start, length),
          semantic_effect_application_parameter_type(
            applications,
            catalog,
            atom,
            operation,
            index
          ),
        ) {
          (range: CheckedSourceRange, Some(operation_type)) ->
            match checked_body_handler_parameter_type(
              types,
              environment,
              annotation,
              operation_type
            ) {
              CheckedBodyHandlerParameterTypeResolved(binding_type) -> match state.binding(
                owner,
                binding_type,
                range,
                CheckedImmutableBinding
              ) {
                (state, binding) -> match state.handler_parameter_list_push(
                  list,
                  binding
                ) {
                  (state, list) -> checked_body_handler_parameters(
                    state,
                    source,
                    types,
                    owner,
                    CheckedLexicalBinding(
                      start,
                      length,
                      binding,
                      binding_type,
                      false,
                      environment
                    ),
                    atom,
                    operation,
                    rest,
                    index + 1,
                    expected_count,
                    list
                  )
                }
              }
              CheckedBodyHandlerParameterTypeRejected(issue) ->
                CheckedBodyHandlerParametersRejected(state, issue)
            }
          _ -> CheckedBodyHandlerParametersRejected(
            state,
            CheckedBodyProducerUnsupportedParameter
          )
        }
        _ -> CheckedBodyHandlerParametersRejected(
          state,
          CheckedBodyProducerUnsupportedParameter
        )
      }
    }
  }
}

fn checked_body_handler_completion(
  authored: HandlerClause
) -> Option<CheckedHandlerCompletion> {
  match handler_clause_completion(authored) {
    HandlerClauseAborts -> Some<CheckedHandlerCompletion>(CheckedHandlerAborts)
    HandlerClauseResumes -> Some<CheckedHandlerCompletion>(CheckedHandlerResumes)
    HandlerClauseMixed -> Some<CheckedHandlerCompletion>(CheckedHandlerMixed)
    HandlerClauseDeferred -> None<CheckedHandlerCompletion>()
    HandlerClauseUnknown -> None<CheckedHandlerCompletion>()
  }
}

fn checked_body_handler_clauses(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  handled_atom: SemanticTypeId,
  handle_result: SemanticTypeId,
  clauses: HandlerClauseList,
  values: List<usize>,
  range: CheckedSourceRange
) -[SemanticConformance]> CheckedBodyHandlerClausesBuild {
  let catalog = types.catalog
  match clauses {
    HandlerClauseListNil -> CheckedBodyHandlerClausesBuilt(
      state,
      values.reverse(),
      range
    )
    HandlerClauseListCons(authored, rest) -> match authored {
      UnknownHandlerClause(_) -> CheckedBodyHandlerClausesRejected(
        state,
        CheckedBodyProducerHandlerClauseRequired
      )
      HandlerClause(name, parameters, body, continuation) -> match name {
        UnknownHandlerClauseName -> CheckedBodyHandlerClausesRejected(
          state,
          CheckedBodyProducerEffectReferenceRequired
        )
        HandlerClauseName(effect_ref, operation_start, operation_length) -> match (
          checked_body_effect_reference_range(source, effect_ref),
          source_range(source, operation_start, operation_length),
        ) {
          (effect_range: CheckedSourceRange, operation_range: CheckedSourceRange) ->
            match source.span(operation_range.start, operation_range.end) {
              None -> CheckedBodyHandlerClausesRejected(
                state,
                CheckedBodyProducerInvalidRange
              )
              Some(operation_span) -> match operation_span.text() {
                None -> CheckedBodyHandlerClausesRejected(
                  state,
                  CheckedBodyProducerInvalidRange
                )
                Some(operation_name) -> {
                  let (selection, resolution_issue) = checked_body_handler_selection(
                    types.module,
                    source,
                    types,
                    environment,
                    effect_ref,
                    operation_name
                  )
                  match resolution_issue {
                    issue: SemanticTypeResolutionIssue -> CheckedBodyHandlerClausesRejected(
                      state,
                      CheckedBodyProducerTypeRejected(issue)
                    )
                    nil -> match selection {
                      CheckedBodyEffectSelected(site) -> if not semantic_type_catalog_equal(
                        catalog,
                        site.atom,
                        handled_atom
                      ) {
                        CheckedBodyHandlerClausesRejected(
                          state,
                          CheckedBodyProducerHandlerEffectMismatch(
                            handled_atom,
                            site.atom
                          )
                        )
                      } else {
                        match continuation {
                          HandlerClauseNoContinuation ->
                            match checked_body_handler_completion(authored) {
                              None -> CheckedBodyHandlerClausesRejected(
                                state,
                                CheckedBodyProducerHandlerClauseRequired
                              )
                              Some(completion) ->
                                match state.handler_parameter_list() {
                                  (state, parameters_list) ->
                                    match checked_body_handler_parameters(
                                      state,
                                      source,
                                      types,
                                      owner,
                                      environment,
                                      site.atom,
                                      operation_name,
                                      parameters,
                                      0,
                                      site.parameter_count,
                                      parameters_list
                                    ) {
                                      CheckedBodyHandlerParametersRejected(state, issue) ->
                                        CheckedBodyHandlerClausesRejected(state, issue)
                                      CheckedBodyHandlerParametersBuilt(
                                state,
                                parameters_list,
                                clause_environment,
                              ) -> match state.finish_handler_parameter_list(
                                parameters_list
                              ) {
                                (state, checked_parameters) -> match checked_body_expr(
                                  state,
                                  source,
                                  types,
                                  owner,
                                  function_result,
                                  loop_context,
                                  CheckedLexicalResume(
                                    site.result,
                                    handle_result,
                                    clause_environment
                                  ),
                                  body,
                                  CheckedRequireResult(handle_result)
                                ) {
                                  CheckedBodyExprRejected(state, issue) ->
                                    CheckedBodyHandlerClausesRejected(state, issue)
                                  CheckedBodyExprBuilt(state, checked_body) -> {
                                    let clause_range = match covering_range(
                                      effect_range,
                                      state.range(checked_body)
                                    ) {
                                      value: CheckedSourceRange -> value
                                      nil -> operation_range
                                    }
                                    match state.handler_clause(
                                      CheckedHandlerClause {
                                        effect_declaration: site.effect_declaration,
                                        operation: site.operation_declaration,
                                        atom: site.atom,
                                        parameters: checked_parameters,
                                        continuation: CheckedImmediateHandlerClause,
                                        body: checked_body,
                                        completion: completion,
                                        range: clause_range
                                      }
                                    ) {
                                      (state, ordinal) -> checked_body_handler_clauses(
                                        state,
                                        source,
                                        types,
                                        owner,
                                        function_result,
                                        loop_context,
                                        environment,
                                        handled_atom,
                                        handle_result,
                                        rest,
                                        values.prepend(ordinal),
                                        match covering_range(range, clause_range) {
                                          value: CheckedSourceRange -> value
                                          nil -> range
                                        }
                                      )
                                    }
                                  }
                                }
                              }
                                    }
                                }
                            }
                          HandlerClauseContinuation(continuation_start, continuation_length) ->
                            if not site.deferred {
                              CheckedBodyHandlerClausesRejected(
                                state,
                                CheckedBodyProducerHandlerContinuationRequiresDeferred
                              )
                            } else {
                              match source_range(
                                source,
                                continuation_start,
                                continuation_length
                              ) {
                                nil -> CheckedBodyHandlerClausesRejected(
                                  state,
                                  CheckedBodyProducerInvalidRange
                                )
                                continuation_range: CheckedSourceRange ->
                                  match state.handler_parameter_list() {
                                    (state, parameters_list) ->
                                      match checked_body_handler_parameters(
                                        state,
                                        source,
                                        types,
                                        owner,
                                        environment,
                                        site.atom,
                                        operation_name,
                                        parameters,
                                        0,
                                        site.parameter_count,
                                        parameters_list
                                      ) {
                                        CheckedBodyHandlerParametersRejected(state, issue) ->
                                          CheckedBodyHandlerClausesRejected(state, issue)
                                        CheckedBodyHandlerParametersBuilt(
                                  state,
                                  parameters_list,
                                  clause_environment,
                                ) -> match state.finish_handler_parameter_list(
                                  parameters_list
                                ) {
                                  (state, checked_parameters) -> {
                                    let (
                                      state,
                                      clause_types,
                                      continuation_type,
                                    ) = checked_body_continuation_type(
                                      state,
                                      types,
                                      site.result,
                                      handle_result
                                    )
                                    match state.binding(
                                      owner,
                                      continuation_type,
                                      continuation_range,
                                      CheckedImmutableBinding
                                    ) {
                                      (state, continuation_binding) ->
                                        match checked_body_expr(
                                          state,
                                          source,
                                          clause_types,
                                          owner,
                                          function_result,
                                          loop_context,
                                          CheckedLexicalBinding(
                                            continuation_start,
                                            continuation_length,
                                            continuation_binding,
                                            continuation_type,
                                            false,
                                            clause_environment
                                          ),
                                          body,
                                          CheckedRequireResult(handle_result)
                                        ) {
                                          CheckedBodyExprRejected(state, issue) ->
                                            CheckedBodyHandlerClausesRejected(
                                              state,
                                              issue
                                            )
                                          CheckedBodyExprBuilt(
                                          state,
                                          checked_body,
                                        ) -> {
                                          let clause_range = match covering_range(
                                            effect_range,
                                            state.range(checked_body)
                                          ) {
                                            value: CheckedSourceRange -> value
                                            nil -> operation_range
                                          }
                                          match state.handler_clause(
                                            CheckedHandlerClause {
                                              effect_declaration:
                                              site.effect_declaration,
                                              operation: site.operation_declaration,
                                              atom: site.atom,
                                              parameters: checked_parameters,
                                              continuation: CheckedDeferredHandlerClause(
                                                continuation_binding
                                              ),
                                              body: checked_body,
                                              completion: CheckedHandlerDeferred,
                                              range: clause_range
                                            }
                                          ) {
                                            (state, ordinal) ->
                                              checked_body_handler_clauses(
                                                state,
                                                source,
                                                clause_types,
                                                owner,
                                                function_result,
                                                loop_context,
                                                environment,
                                                handled_atom,
                                                handle_result,
                                                rest,
                                                values.prepend(ordinal),
                                                match covering_range(
                                                  range,
                                                  clause_range
                                                ) {
                                                  value: CheckedSourceRange -> value
                                                  nil -> range
                                                }
                                              )
                                          }
                                        }
                                        }
                                    }
                                  }
                                }
                                      }
                                  }
                              }
                            }
                          UnknownHandlerClauseContinuation ->
                            CheckedBodyHandlerClausesRejected(
                              state,
                              CheckedBodyProducerHandlerClauseRequired
                            )
                        }
                      }
                      CheckedBodyEffectSelectionMissing -> CheckedBodyHandlerClausesRejected(
                        state,
                        CheckedBodyProducerEffectReferenceRequired
                      )
                      CheckedBodyEffectOperationMissing -> CheckedBodyHandlerClausesRejected(
                        state,
                        CheckedBodyProducerUnknownEffectOperation(operation_range)
                      )
                      CheckedBodyEffectApplicationMissing -> CheckedBodyHandlerClausesRejected(
                        state,
                        CheckedBodyProducerEffectApplicationUnavailable
                      )
                      CheckedBodyEffectApplicationNeedsMaterialization(_) ->
                        CheckedBodyHandlerClausesRejected(
                          state,
                          CheckedBodyProducerEffectApplicationUnavailable
                        )
                      CheckedBodyEffectSelectionAmbiguous(declaration) ->
                        CheckedBodyHandlerClausesRejected(
                          state,
                          CheckedBodyProducerAmbiguousEffectApplication(declaration)
                        )
                    }
                  }
                }
              }
            }
          _ -> CheckedBodyHandlerClausesRejected(
            state,
            CheckedBodyProducerInvalidRange
          )
        }
      }
    }
  }
}

fn checked_body_handler_first_site(
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  environment: CheckedLexicalEnvironment,
  clauses: HandlerClauseList
) -> (
  CheckedBodyPrimitiveTypes,
  CheckedBodyEffectSelection,
  SemanticTypeResolutionIssue?
) {
  match clauses {
    HandlerClauseListNil -> (types, CheckedBodyEffectSelectionMissing, nil)
    HandlerClauseListCons(clause, _) -> match clause {
      HandlerClause(HandlerClauseName(effect_ref, start, length), _, _, _) -> match source_range(
        source,
        start,
        length
      ) {
        nil -> (types, CheckedBodyEffectSelectionMissing, nil)
        range: CheckedSourceRange -> match source.span(range.start, range.end) {
          None -> (types, CheckedBodyEffectSelectionMissing, nil)
          Some(span) -> match span.text() {
            None -> (types, CheckedBodyEffectSelectionMissing, nil)
            Some(operation) -> match checked_body_effect_reference(
              source,
              environment,
              effect_ref
            ) {
              CheckedBodyExplicitEffect(authored) -> checked_body_explicit_handler_effect(
                types.module,
                types,
                environment,
                authored,
                operation
              )
              CheckedBodyBareEffect(declaration) -> match checked_body_select_registered_effect(
                types,
                declaration,
                operation
              ) {
                CheckedBodyEffectApplicationMissing -> match checked_body_nullary_effect_type(
                  effect_ref
                ) {
                  Some(authored) -> checked_body_explicit_handler_effect(
                    types.module,
                    types,
                    environment,
                    authored,
                    operation
                  )
                  None -> (types, CheckedBodyEffectApplicationMissing, nil)
                }
                selection -> (types, selection, nil)
              }
              _ -> match checked_body_handler_selection(
                types.module,
                source,
                types,
                environment,
                effect_ref,
                operation
              ) {
                (selection, issue) -> (types, selection, issue)
              }
            }
          }
        }
      }
      _ -> (types, CheckedBodyEffectSelectionMissing, nil)
    }
  }
}

fn checked_body_materialize_handler_clauses(
  state: owned CheckedBodyBuild,
  values: List<usize>,
  list: CheckedHandlerClauseListBuilder
) -> (owned CheckedBodyBuild, CheckedHandlerClauseListId) {
  match values {
    Nil -> state.finish_handler_clause_list(list)
    Cons(ordinal, remaining) -> match state.handler_clause_list_push(
      list,
      ordinal
    ) {
      (state, list) -> checked_body_materialize_handler_clauses(
        state,
        remaining,
        list
      )
    }
  }
}

fn checked_body_handle_return(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  body_type: SemanticTypeId,
  body_range: CheckedSourceRange,
  authored: HandleReturn
) -[SemanticConformance]> CheckedBodyHandleReturnBuild {
  match authored {
    NoHandleReturn -> CheckedBodyHandleReturnBuilt(
      state,
      CheckedNoHandleReturn,
      body_type,
      body_range
    )
    HandleReturnClause(start, length, return_body) -> match source_range(
      source,
      start,
      length
    ) {
      nil -> CheckedBodyHandleReturnRejected(state, CheckedBodyProducerInvalidRange)
      binding_range: CheckedSourceRange -> match state.binding(
        owner,
        body_type,
        binding_range,
        CheckedImmutableBinding
      ) {
        (state, binding) -> match checked_body_expr(
          state,
          source,
          types,
          owner,
          function_result,
          loop_context,
          CheckedLexicalBinding(
            start,
            length,
            binding,
            body_type,
            false,
            environment
          ),
          return_body,
          CheckedInferResult
        ) {
          CheckedBodyExprRejected(state, issue) -> CheckedBodyHandleReturnRejected(
            state,
            issue
          )
          CheckedBodyExprBuilt(state, checked_return) -> {
            let result = state.result_type(checked_return)
            let range = match covering_range(body_range, state.range(checked_return)) {
              value: CheckedSourceRange -> value
              nil -> body_range
            }
            CheckedBodyHandleReturnBuilt(
              state,
              CheckedHandleReturnClause(binding, checked_return),
              result,
              range
            )
          }
        }
      }
    }
  }
}

fn checked_body_handle(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  body: Expr,
  clauses: HandlerClauseList,
  return_clause: HandleReturn,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  let catalog = state.types()
  let types = checked_body_types_with_catalog(types, catalog)
  let (types, selection, resolution_issue) = checked_body_handler_first_site(
    source,
    types,
    environment,
    clauses
  )
  let state = state.with_types(types.catalog)
  let catalog = types.catalog
  match resolution_issue {
    issue: SemanticTypeResolutionIssue -> CheckedBodyExprRejected(
      state,
      CheckedBodyProducerTypeRejected(issue)
    )
    nil -> match selection {
      CheckedBodyEffectSelected(first_site) -> match checked_body_expr(
        state,
        source,
        types,
        owner,
        function_result,
        loop_context,
        CheckedLexicalHandledEffect(first_site.atom, environment),
        body,
        CheckedInferResult
      ) {
        CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
        CheckedBodyExprBuilt(state, checked_body) -> {
          let body_type = state.result_type(checked_body)
          let body_range = state.range(checked_body)
          match checked_body_handle_return(
            state,
            source,
            types,
            owner,
            function_result,
            loop_context,
            environment,
            body_type,
            body_range,
            return_clause
          ) {
            CheckedBodyHandleReturnRejected(state, issue) -> CheckedBodyExprRejected(
              state,
              issue
            )
            CheckedBodyHandleReturnBuilt(
              state,
              checked_return,
              handle_result,
              handle_range,
            ) -> if not expectation_allows(
              catalog,
              handle_result,
              expectation
            ) {
              CheckedBodyExprRejected(
                state,
                expectation_mismatch(handle_result, expectation)
              )
            } else {
              match checked_body_handler_clauses(
                state,
                source,
                types,
                owner,
                function_result,
                loop_context,
                environment,
                first_site.atom,
                handle_result,
                clauses,
                Nil<usize>(),
                handle_range
              ) {
                CheckedBodyHandlerClausesRejected(state, issue) ->
                  CheckedBodyExprRejected(state, issue)
                CheckedBodyHandlerClausesBuilt(state, values, range) ->
                  match state.handler_clause_list() {
                    (state, list) -> match checked_body_materialize_handler_clauses(
                      state,
                      values,
                      list
                    ) {
                      (state, checked_clauses) -> match state.handle_expr(
                        checked_body,
                        checked_clauses,
                        checked_return,
                        handle_result,
                        range
                      ) {
                        (state, expression) -> CheckedBodyExprBuilt(state, expression)
                      }
                    }
                  }
              }
            }
          }
        }
      }
      CheckedBodyEffectSelectionMissing -> CheckedBodyExprRejected(
        state,
        CheckedBodyProducerHandlerClauseRequired
      )
      CheckedBodyEffectOperationMissing -> CheckedBodyExprRejected(
        state,
        CheckedBodyProducerEffectReferenceRequired
      )
      CheckedBodyEffectApplicationMissing -> CheckedBodyExprRejected(
        state,
        CheckedBodyProducerEffectApplicationUnavailable
      )
      CheckedBodyEffectApplicationNeedsMaterialization(_) -> CheckedBodyExprRejected(
        state,
        CheckedBodyProducerEffectApplicationUnavailable
      )
      CheckedBodyEffectSelectionAmbiguous(declaration) -> CheckedBodyExprRejected(
        state,
        CheckedBodyProducerAmbiguousEffectApplication(declaration)
      )
    }
  }
}

fn checked_body_resume(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  value: Expr,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  let catalog = types.catalog
  match lexical_resume_types(environment) {
    CheckedLexicalResumeMissing -> CheckedBodyExprRejected(
      state,
      CheckedBodyProducerResumeOutsideHandler
    )
    CheckedLexicalResumeFound(resume_input, _) -> if not expectation_allows(
      catalog,
      types.never_type,
      expectation
    ) {
      CheckedBodyExprRejected(
        state,
        expectation_mismatch(types.never_type, expectation)
      )
    } else {
      match checked_body_expr(
        state,
        source,
        types,
        owner,
        function_result,
        loop_context,
        environment,
        value,
        CheckedRequireResult(resume_input)
      ) {
        CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
        CheckedBodyExprBuilt(state, checked_value) -> {
          let range = state.range(checked_value)
          match state.resume_expr(
            checked_value,
            types.never_type,
            range
          ) {
            (state, expression) -> CheckedBodyExprBuilt(state, expression)
          }
        }
      }
    }
  }
}

fn checked_body_auto_borrow_receiver(
  state: owned CheckedBodyBuild,
  receiver: CheckedExprId,
  expected: SemanticTypeId
) -[SemanticConformance]> (owned CheckedBodyBuild, CheckedExprId) {
  let catalog = state.types()
  let actual = state.result_type(receiver)
  if semantic_type_is_subtype(catalog, actual, expected) { (state, receiver) }
  else {
    match catalog.graph_for(expected) {
      None -> (state, receiver)
      Some(graph) -> match semantic_type_graph_node(graph, expected) {
        SemanticBorrowNode(inner, access) -> match state.local_reference_binding(receiver) {
          None -> (state, receiver)
          Some(binding) -> {
            let info = state.binding_info(binding)
            let allowed = match access {
              SemanticImmutable -> true
              SemanticMutable -> match info.mutability {
                CheckedMutableBinding -> true
                _ -> false
              }
            }
            let value_type = match catalog.graph_for(actual) {
              None -> actual
              Some(actual_graph) -> match semantic_type_graph_node(actual_graph, actual) {
                SemanticOwnedNode(value) -> value
                _ -> actual
              }
            }
            if allowed and semantic_type_is_subtype(catalog, value_type, inner) {
              let range = state.range(receiver)
              state.borrow_reference(
                binding,
                match access { SemanticMutable -> true, _ -> false },
                expected,
                range
              )
            } else { (state, receiver) }
          }
        }
        _ -> (state, receiver)
      }
    }
  }
}

fn checked_body_method_call(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  receiver: Expr,
  method_range: CheckedSourceRange,
  method_name: str,
  arguments: ExprList,
  required_trait: DeclarationIdentity?,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  match checked_body_expr(
    state,
    source,
    types,
    owner,
    function_result,
    loop_context,
    environment,
    receiver,
    CheckedInferResult
  ) {
    CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
    CheckedBodyExprBuilt(state, checked_receiver) -> {
      let receiver_type = state.result_type(checked_receiver)
      let catalog = state.types()
      let current_types = checked_body_types_with_catalog(types, catalog)
      let call_site = match required_trait {
        nil -> method_range
        _ -> state.range(checked_receiver)
      }
      let selection = match required_trait {
        nil -> checked_body_method_selection(current_types, owner, receiver_type, method_name)
        trait_declaration: DeclarationIdentity -> checked_body_method_selection_for_trait(
          current_types,
          owner,
          receiver_type,
          trait_declaration,
          method_name
        )
      }
      match selection {
        CheckedBodyMethodSelectionMissing -> match required_trait {
          nil -> CheckedBodyExprRejected(state, CheckedBodyProducerUnknownMethod(call_site))
          _ -> CheckedBodyExprRejected(
            state,
            CheckedBodyProducerDisplayImplementationRequired(receiver_type)
          )
        }
        CheckedBodyMethodSelectionAmbiguous -> CheckedBodyExprRejected(
          state,
          CheckedBodyProducerAmbiguousMethod(call_site)
        )
        CheckedBodyMethodSelected(declaration, template, substitution) -> {
          let resolution = current_types.resolution
          let next_segment = catalog.next_derived_segment(
            current_types.module.identity,
            resolution.next_type_segment()
          )
          let product = semantic_type_product_continue(
            current_types.module.identity,
            catalog,
            next_segment
          )
          let (product, signature) = semantic_type_product_substitute(
            product,
            substitution,
            template
          )
          let next_catalog = semantic_type_product_catalog(product)
          let next_state = state.with_types(next_catalog)
          let next_types = checked_body_types_with_catalog(current_types, next_catalog)
          let parameter_count = semantic_function_parameter_count(
            next_catalog,
            signature
          )
          if parameter_count == 0 {
            CheckedBodyExprRejected(
              next_state,
              CheckedBodyProducerArityMismatch(1, 0)
            )
          } else {
            let self_type = semantic_function_parameter(next_catalog, signature, 0)
            let (next_state, checked_receiver) = checked_body_auto_borrow_receiver(
              next_state,
              checked_receiver,
              self_type
            )
            if not semantic_type_is_subtype(
              next_catalog,
              next_state.result_type(checked_receiver),
              self_type
            ) {
              CheckedBodyExprRejected(
                next_state,
                CheckedBodyProducerTypeMismatch(receiver_type, self_type)
              )
            } else {
              match checked_body_function_effect_requirement(
                next_catalog,
                environment,
                signature
              ) {
                CheckedBodyEffectAtomUnavailable(atom) -> CheckedBodyExprRejected(
                  next_state,
                  CheckedBodyProducerEffectUnavailable(atom)
                )
                CheckedBodyEffectTailUnavailable(variable) -> CheckedBodyExprRejected(
                  next_state,
                  CheckedBodyProducerEffectTailUnavailable(variable)
                )
                CheckedBodyEffectsAvailable -> {
                  let result = semantic_function_result(next_catalog, signature)
                  if not expectation_allows(next_catalog, result, expectation) {
                    CheckedBodyExprRejected(
                      next_state,
                      expectation_mismatch(result, expectation)
                    )
                  } else {
                    match covering_range(next_state.range(checked_receiver), call_site) {
                      nil -> CheckedBodyExprRejected(
                        next_state,
                        CheckedBodyProducerInvalidRange
                      )
                      range: CheckedSourceRange -> match checked_body_method_arguments(
                        next_state,
                        source,
                        next_types,
                        owner,
                        function_result,
                        loop_context,
                        environment,
                        signature,
                        template,
                        arguments,
                        0,
                        __i64_to_usize(expr_list_len(arguments)),
                        Nil<CheckedExprId>(),
                        range
                      ) {
                        CheckedBodyArgumentsRejected(next_state, issue) ->
                          CheckedBodyExprRejected(next_state, issue)
                        CheckedBodyArgumentsBuilt(next_state, checked_arguments, range) ->
                          match next_state.method_call(
                            declaration,
                            checked_receiver,
                            checked_arguments,
                            result,
                            range
                          ) {
                            (next_state, expression) -> CheckedBodyExprBuilt(
                              next_state,
                              expression
                            )
                          }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

fn checked_body_interpolation_display(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  operand: Expr,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  match checked_body_standard_declaration(
    types,
    lexical_scope(environment),
    "stdlib/display",
    TraitDeclaration,
    "Display"
  ) {
    nil -> CheckedBodyExprRejected(state, CheckedBodyProducerCanonicalDisplayUnavailable)
    trait_declaration: DeclarationIdentity -> if checked_body_display_contract(
      types,
      trait_declaration
    ) {
      checked_body_method_call(
        state,
        source,
        types,
        owner,
        function_result,
        loop_context,
        environment,
        operand,
        CheckedSourceRange { start: 0, end: 0 },
        "display",
        ExprListNil,
        trait_declaration,
        expectation
      )
    } else {
      CheckedBodyExprRejected(
        state,
        CheckedBodyProducerCanonicalDisplayInvalid(trait_declaration)
      )
    }
  }
}

fn checked_body_perform(
  state: owned CheckedBodyBuild,
  module: RegisteredModule,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  effect_ref: Expr,
  operation_start: i64,
  operation_length: i64,
  arguments: ExprList,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  match source_range(source, operation_start, operation_length) {
    nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
    operation_range: CheckedSourceRange -> match source.span(
      operation_range.start,
      operation_range.end
    ) {
      None -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
      Some(operation_span) -> match checked_body_qualified_constructor(
        source,
        environment,
        effect_ref,
        operation_span,
        operation_range
      ) {
        Some((declaration, range)) -> checked_body_constructor_invoke(
          state,
          source,
          types,
          owner,
          function_result,
          loop_context,
          environment,
          declaration,
          operation_span,
          range,
          arguments,
          expectation
        )
        None -> checked_body_perform_other(
          state,
          module,
          source,
          types,
          owner,
          function_result,
          loop_context,
          environment,
          effect_ref,
          operation_start,
          operation_length,
          arguments,
          expectation
        )
      }
    }
  }
}

fn checked_body_perform_other(
  state: owned CheckedBodyBuild,
  module: RegisteredModule,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  effect_ref: Expr,
  operation_start: i64,
  operation_length: i64,
  arguments: ExprList,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  let catalog = state.types()
  let types = checked_body_types_with_catalog(types, catalog)
  match source_range(source, operation_start, operation_length) {
    operation_range: CheckedSourceRange ->
      match source.span(operation_range.start, operation_range.end) {
        None -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
        Some(operation_span) -> match operation_span.text() {
          None -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
          Some(operation_name) -> {
            let (types, selection, resolution_issue) = checked_body_perform_selection(
              module,
              source,
              types,
              environment,
              effect_ref,
              operation_name
            )
            let catalog = types.catalog
            let state = state.with_types(catalog)
            match resolution_issue {
              issue: SemanticTypeResolutionIssue -> CheckedBodyExprRejected(
                state,
                CheckedBodyProducerTypeRejected(issue)
              )
              nil -> match selection {
                CheckedBodyEffectSelected(site) ->
                  match checked_body_effect_reference_range(source, effect_ref) {
                    nil -> CheckedBodyExprRejected(
                      state,
                      CheckedBodyProducerInvalidRange
                    )
                    effect_range: CheckedSourceRange -> if not lexical_allows_effect(
                      catalog,
                      environment,
                      site.atom
                    ) {
                      CheckedBodyExprRejected(
                        state,
                        CheckedBodyProducerEffectUnavailable(site.atom)
                      )
                    } else if not expectation_allows(catalog, site.result, expectation) {
                      CheckedBodyExprRejected(
                        state,
                        expectation_mismatch(site.result, expectation)
                      )
                    } else {
                      match covering_range(effect_range, operation_range) {
                        nil -> CheckedBodyExprRejected(
                          state,
                          CheckedBodyProducerInvalidRange
                        )
                        range: CheckedSourceRange -> {
                          let total = __i64_to_usize(expr_list_len(arguments))
                          match checked_body_prepare_effect_arguments(
                            state,
                            source,
                            types,
                            owner,
                            function_result,
                            loop_context,
                            environment,
                            site.atom,
                            operation_name,
                            site.parameter_count,
                            arguments,
                            0,
                            total,
                            Nil<usize>(),
                            range
                          ) {
                            CheckedBodyEffectArgumentsPrepared(state, values, range) ->
                              match state.expression_list() {
                                (state, list) -> match checked_body_materialize_effect_arguments(
                                  state,
                                  values,
                                  list
                                ) {
                                  (state, checked_arguments) -> match state.perform(
                                    site.effect_declaration,
                                    site.operation_declaration,
                                    site.atom,
                                    checked_arguments,
                                    site.result,
                                    range
                                  ) {
                                    (state, expression) -> CheckedBodyExprBuilt(state, expression)
                                  }
                                }
                              }
                            CheckedBodyEffectArgumentsPreparationRejected(state, issue) ->
                              CheckedBodyExprRejected(state, issue)
                          }
                        }
                      }
                    }
                  }
                CheckedBodyEffectOperationMissing -> CheckedBodyExprRejected(
                  state,
                  CheckedBodyProducerUnknownEffectOperation(operation_range)
                )
                CheckedBodyEffectApplicationMissing -> CheckedBodyExprRejected(
                  state,
                  CheckedBodyProducerEffectApplicationUnavailable
                )
                CheckedBodyEffectApplicationNeedsMaterialization(_) ->
                  CheckedBodyExprRejected(
                    state,
                    CheckedBodyProducerEffectApplicationUnavailable
                  )
                CheckedBodyEffectSelectionAmbiguous(declaration) -> CheckedBodyExprRejected(
                  state,
                  CheckedBodyProducerAmbiguousEffectApplication(declaration)
                )
                CheckedBodyEffectSelectionMissing -> checked_body_method_call(
                  state,
                  source,
                  types,
                  owner,
                  function_result,
                  loop_context,
                  environment,
                  effect_ref,
                  operation_range,
                  operation_name,
                  arguments,
                  nil,
                  expectation
                )
              }
            }
          }
        }
      }
    _ -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
  }
}

fn checked_body_publish_arguments_from_list(
  state: owned CheckedBodyBuild,
  list: CheckedExprListBuilder,
  values: List<CheckedExprId>
) -> (owned CheckedBodyBuild, CheckedExprListId) {
  match values {
    Nil -> state.finish_expression_list(list)
    Cons(value, rest) -> match state.expression_list_push(list, value) {
      (state, list) -> checked_body_publish_arguments_from_list(state, list, rest)
    }
  }
}

fn checked_body_publish_arguments(
  state: owned CheckedBodyBuild,
  values: List<CheckedExprId>
) -> (owned CheckedBodyBuild, CheckedExprListId) {
  match state.expression_list() {
    (state, list) -> checked_body_publish_arguments_from_list(state, list, values.reverse())
  }
}

fn checked_body_method_arguments(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  function_type: SemanticTypeId,
  contract_type: SemanticTypeId,
  arguments: ExprList,
  index: usize,
  total: usize,
  values: List<CheckedExprId>,
  range: CheckedSourceRange
) -[SemanticConformance]> CheckedBodyArgumentsBuild {
  let catalog = types.catalog
  let parameter_count = semantic_function_parameter_count(catalog, function_type)
  let parameter_index = index + 1
  let zero: usize = 0
  let expected_count = if parameter_count >= 1 {
    parameter_count - 1
  } else { zero }
  match arguments {
    ExprListNil -> if parameter_index == parameter_count {
      match checked_body_publish_arguments(state, values) {
        (state, arguments) -> CheckedBodyArgumentsBuilt(state, arguments, range)
      }
    } else {
      CheckedBodyArgumentsRejected(
        state,
        CheckedBodyProducerArityMismatch(expected_count, total)
      )
    }
    ExprListCons(argument, rest) -> if parameter_index >= parameter_count {
      CheckedBodyArgumentsRejected(
        state,
        CheckedBodyProducerArityMismatch(expected_count, total)
      )
    } else {
      let parameter = semantic_function_parameter(catalog, function_type, parameter_index)
      match checked_body_expr(
        state,
        source,
        types,
        owner,
        function_result,
        loop_context,
        environment,
        argument,
        CheckedRequireResult(parameter)
      ) {
        CheckedBodyExprBuilt(state, checked_argument) -> {
          let argument_type = state.result_type(checked_argument)
          let argument_range = state.range(checked_argument)
          if semantic_continuation_type(catalog, argument_type) and
            not
            semantic_continuation_type(
              catalog,
              semantic_function_parameter(catalog, contract_type, parameter_index)
            ) {
              CheckedBodyArgumentsRejected(
                state,
                CheckedBodyProducerContinuationConsumerRequired(argument_range)
              )
            } else {
              match covering_range(range, argument_range) {
                next_range: CheckedSourceRange -> checked_body_method_arguments(
                  state,
                  source,
                  types,
                  owner,
                  function_result,
                  loop_context,
                  environment,
                  function_type,
                  contract_type,
                  rest,
                  index + 1,
                  total,
                  values.prepend(checked_argument),
                  next_range
                )
                nil -> CheckedBodyArgumentsRejected(
                  state,
                  CheckedBodyProducerInvalidRange
                )
              }
            }
        }
        CheckedBodyExprRejected(state, issue) -> CheckedBodyArgumentsRejected(state, issue)
      }
    }
  }
}

fn checked_body_arguments(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  function_type: SemanticTypeId,
  arguments: ExprList,
  index: usize,
  total: usize,
  values: List<CheckedExprId>,
  range: CheckedSourceRange
) -[SemanticConformance]> CheckedBodyArgumentsBuild {
  let catalog = types.catalog
  let parameter_count = semantic_function_parameter_count(catalog, function_type)
  match arguments {
    ExprListNil -> if index == parameter_count {
      match checked_body_publish_arguments(state, values) {
        (state, arguments) -> CheckedBodyArgumentsBuilt(state, arguments, range)
      }
    } else {
      CheckedBodyArgumentsRejected(
        state,
        CheckedBodyProducerArityMismatch(parameter_count, total)
      )
    }
    ExprListCons(argument, rest) -> if index >= parameter_count {
      CheckedBodyArgumentsRejected(
        state,
        CheckedBodyProducerArityMismatch(parameter_count, total)
      )
    } else {
      let parameter = semantic_function_parameter(catalog, function_type, index)
      match checked_body_expr(
        state,
        source,
        types,
        owner,
        function_result,
        loop_context,
        environment,
        argument,
        CheckedRequireResult(parameter)
      ) {
        CheckedBodyExprBuilt(state, checked_argument) -> {
          let argument_type = state.result_type(checked_argument)
          let argument_range = state.range(checked_argument)
          if semantic_continuation_type(catalog, argument_type) and
            not
            semantic_continuation_type(catalog, parameter) {
              CheckedBodyArgumentsRejected(
                state,
                CheckedBodyProducerContinuationConsumerRequired(argument_range)
              )
            } else {
              match covering_range(range, argument_range) {
                next_range: CheckedSourceRange -> checked_body_arguments(
                  state,
                  source,
                  types,
                  owner,
                  function_result,
                  loop_context,
                  environment,
                  function_type,
                  rest,
                  index + 1,
                  total,
                  values.prepend(checked_argument),
                  next_range
                )
                nil -> CheckedBodyArgumentsRejected(
                  state,
                  CheckedBodyProducerInvalidRange
                )
              }
            }
        }
        CheckedBodyExprRejected(state, issue) -> CheckedBodyArgumentsRejected(state, issue)
      }
    }
  }
}

fn checked_body_call_with_signature(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  name_range: CheckedSourceRange,
  call_site: usize,
  arguments: ExprList,
  signature: SemanticTypeId,
  callee: CheckedCallCallee,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  let catalog = types.catalog
  match checked_body_function_effect_requirement(catalog, environment, signature) {
    CheckedBodyEffectAtomUnavailable(atom) -> CheckedBodyExprRejected(
      state,
      CheckedBodyProducerEffectUnavailable(atom)
    )
    CheckedBodyEffectTailUnavailable(variable) -> CheckedBodyExprRejected(
      state,
      CheckedBodyProducerEffectTailUnavailable(variable)
    )
    CheckedBodyEffectsAvailable -> {
      let result = semantic_function_result(catalog, signature)
      if not expectation_allows(catalog, result, expectation) {
        CheckedBodyExprRejected(state, expectation_mismatch(result, expectation))
      } else {
        let total = __i64_to_usize(expr_list_len(arguments))
        match checked_body_arguments(
          state,
          source,
          types,
          owner,
          function_result,
          loop_context,
          environment,
          signature,
          arguments,
          0,
          total,
          Nil<CheckedExprId>(),
          name_range
        ) {
          CheckedBodyArgumentsBuilt(state, checked_arguments, range) -> match callee {
            CheckedDirectCallee(function) -> match state.direct_call(
              function,
              checked_arguments,
              result,
              range
            ) {
              (state, expression) -> CheckedBodyExprBuilt(state, expression)
            }
            CheckedAppliedCallee(expression) -> match state.apply(
              expression,
              checked_arguments,
              signature,
              call_site,
              result,
              range
            ) {
              (state, applied) -> CheckedBodyExprBuilt(state, applied)
            }
          }
          CheckedBodyArgumentsRejected(state, issue) -> CheckedBodyExprRejected(
            state,
            issue
          )
        }
      }
    }
  }
}

fn checked_body_match_generic_argument(
  state: owned CheckedBodyBuild,
  types: CheckedBodyPrimitiveTypes,
  parameter: SemanticTypeId,
  substitution: SemanticTypeSubstitution,
  actual: SemanticTypeId
) -[SemanticConformance]> CheckedInferredGenericMatch {
  let catalog = state.types()
  let empty = semantic_type_substitution_empty()
  match semantic_type_pattern_match_substituted(
    catalog,
    parameter,
    substitution,
    actual,
    empty
  ) {
    SemanticTypePatternMatched(inferred) -> CheckedInferredGenericMatched(state, inferred)
    SemanticTypePatternRejected -> if semantic_type_is_subtype(catalog, actual, parameter) {
      CheckedInferredGenericMatched(state, substitution)
    } else {
      let resolution = types.resolution
      let segment = catalog.next_derived_segment(
        types.module.identity,
        resolution.next_type_segment()
      )
      let product = semantic_type_product_continue(
        types.module.identity,
        catalog,
        segment
      )
      let (product, expected) = semantic_type_product_substitute(
        product,
        substitution,
        parameter
      )
      let specialized_catalog = semantic_type_product_catalog(product)
      let state = state.with_types(specialized_catalog)
      if semantic_type_is_subtype(specialized_catalog, actual, expected) {
        CheckedInferredGenericMatched(state, substitution)
      } else {
        CheckedInferredGenericMatchRejected(
          state,
          CheckedBodyProducerTypeMismatch(actual, expected)
        )
      }
    }
  }
}

fn checked_body_infer_generic_arguments(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  signature: SemanticTypeId,
  arguments: ExprList,
  index: usize,
  total: usize,
  substitution: SemanticTypeSubstitution,
  values: List<CheckedExprId>,
  range: CheckedSourceRange
) -[SemanticConformance]> CheckedInferredGenericArgumentsBuild {
  let catalog = state.types()
  let parameter_count = semantic_function_parameter_count(catalog, signature)
  match arguments {
    ExprListNil -> if index == parameter_count {
      CheckedInferredGenericArgumentsResolved(state, substitution, values, range)
    } else {
      CheckedInferredGenericArgumentsRejected(
        state,
        CheckedBodyProducerArityMismatch(parameter_count, total)
      )
    }
    ExprListCons(argument, rest) -> if index >= parameter_count {
      CheckedInferredGenericArgumentsRejected(
        state,
        CheckedBodyProducerArityMismatch(parameter_count, total)
      )
    } else {
      let parameter = semantic_function_parameter(catalog, signature, index)
      let checked_argument = match argument {
        Lambda(lambda_parameters, lambda_body, lambda_site) -> {
          let resolution = types.resolution
          let segment = catalog.next_derived_segment(
            types.module.identity,
            resolution.next_type_segment()
          )
          let product = semantic_type_product_continue(types.module.identity, catalog, segment)
          let (product, specialized) = semantic_type_product_substitute(
            product,
            substitution,
            parameter
          )
          let next_catalog = semantic_type_product_catalog(product)
          let next_types = checked_body_types_with_catalog(types, next_catalog)
          let next_state = state.with_types(next_catalog)
          if semantic_function_result_is_variable(next_catalog, specialized) {
            checked_body_lambda(
              next_state,
              source,
              next_types,
              owner,
              environment,
              lambda_parameters,
              lambda_body,
              lambda_site,
              CheckedRequireResult(specialized),
              true
            )
          } else {
            checked_body_expr(
              next_state,
              source,
              next_types,
              owner,
              function_result,
              loop_context,
              environment,
              argument,
              CheckedRequireResult(specialized)
            )
          }
        }
        _ -> checked_body_expr(
          state,
          source,
          checked_body_types_with_catalog(types, catalog),
          owner,
          function_result,
          loop_context,
          environment,
          argument,
          CheckedInferResult
        )
      }
      match checked_argument {
        CheckedBodyExprRejected(state, issue) -> CheckedInferredGenericArgumentsRejected(
          state,
          issue
        )
        CheckedBodyExprBuilt(state, checked_argument) -> {
          let actual = state.result_type(checked_argument)
          let argument_range = state.range(checked_argument)
          match checked_body_match_generic_argument(
            state,
            types,
            parameter,
            substitution,
            actual
          ) {
            CheckedInferredGenericMatchRejected(state, issue) ->
              CheckedInferredGenericArgumentsRejected(state, issue)
            CheckedInferredGenericMatched(state, next_substitution) -> match covering_range(
              range,
              argument_range
            ) {
              nil -> CheckedInferredGenericArgumentsRejected(
                state,
                CheckedBodyProducerInvalidRange
              )
              next_range: CheckedSourceRange -> checked_body_infer_generic_arguments(
                state,
                source,
                types,
                owner,
                function_result,
                loop_context,
                environment,
                signature,
                rest,
                index + 1,
                total,
                next_substitution,
                values.prepend(checked_argument),
                next_range
              )
            }
          }
        }
      }
    }
  }
}

fn checked_body_inferred_type_arguments(
  state: borrow CheckedBodyBuild,
  signature: SemanticFunctionSignature,
  substitution: borrow SemanticTypeSubstitution,
  index: usize,
  resolved: List<SemanticTypeId>
) -> Option<List<SemanticTypeId>> {
  if index >= state.type_parameter_count(signature) {
    Some(resolved)
  } else {
    match semantic_type_substitution_get(
      substitution,
      state.type_parameter_at(signature, index)
    ) {
      None -> None<List<SemanticTypeId>>()
      Some(argument) -> checked_body_inferred_type_arguments(
        state,
        signature,
        substitution,
        index + 1,
        resolved.append(argument)
      )
    }
  }
}

fn checked_body_validate_inferred_arguments(
  state: borrow CheckedBodyBuild,
  signature: SemanticTypeId,
  values: List<CheckedExprId>,
  index: usize
) -[SemanticConformance]> CheckedInferredGenericValidation {
  match values {
    Nil -> CheckedInferredGenericValid
    Cons(argument, rest) -> {
      let catalog = state.types()
      let actual = state.result_type(argument)
      let parameter = semantic_function_parameter(catalog, signature, index)
      if not semantic_type_is_subtype(catalog, actual, parameter) {
        CheckedInferredGenericInvalid(CheckedBodyProducerTypeMismatch(actual, parameter))
      } else if semantic_continuation_type(catalog, actual) and
        not semantic_continuation_type(catalog, parameter) {
          CheckedInferredGenericInvalid(
            CheckedBodyProducerContinuationConsumerRequired(state.range(argument))
          )
        } else {
          checked_body_validate_inferred_arguments(state, signature, rest, index + 1)
        }
    }
  }
}

fn checked_body_generic_arguments(
  state: borrow CheckedBodyBuild,
  module: RegisteredModule,
  environment: CheckedLexicalEnvironment,
  signature: SemanticFunctionSignature,
  authored: TypeExprList,
  index: usize,
  product: SemanticTypeProductBuilder,
  substitution: SemanticTypeSubstitution,
  values: List<SemanticTypeId>
) -> CheckedGenericArgumentsBuild {
  match authored {
    TypeExprListNil -> CheckedGenericArgumentsResolved(product, substitution, values)
    TypeExprListCons(argument, rest, _) -> match resolve_type_product_in_scope(
      product,
      module,
      lexical_scope(environment),
      lexical_type_parameters(environment),
      argument
    ) {
      (product, SemanticTypeResolved(resolved)) -> checked_body_generic_arguments(
        state,
        module,
        environment,
        signature,
        rest,
        index + 1,
        product,
        semantic_type_substitution_bind(
          substitution,
          state.type_parameter_at(signature, index),
          resolved
        ),
        values.append(resolved)
      )
      (_, SemanticTypeRejected(issue)) -> CheckedGenericArgumentsRejected(issue)
    }
  }
}

fn checked_body_generic_bounds(
  state: borrow CheckedBodyBuild,
  signature: SemanticFunctionSignature,
  substitution: borrow SemanticTypeSubstitution,
  index: usize,
  product: SemanticTypeProductBuilder
) -[SemanticConformance]> CheckedGenericBoundsBuild {
  if index >= state.bound_count(signature) {
    CheckedGenericBoundsAccepted(product)
  } else {
    let bound = state.bound_at(signature, index)
    match semantic_type_substitution_get(substitution, bound.variable) {
      Some(concrete) -> {
        let (product, trait_atom) = semantic_type_product_substitute(
          product,
          substitution,
          bound.trait_atom
        )
        let catalog = semantic_type_product_catalog(product)
        if semantic_type_is_subtype(catalog, concrete, trait_atom) {
          checked_body_generic_bounds(state, signature, substitution, index + 1, product)
        } else {
          CheckedGenericBoundsRejected(product, concrete, trait_atom)
        }
      }
      None -> panic("Generic bound has no resolved type argument")
    }
  }
}

fn checked_body_inferred_generic_call(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  name_range: CheckedSourceRange,
  arguments: ExprList,
  signature: SemanticFunctionSignature,
  function: FunctionIdentity,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  let total = __i64_to_usize(expr_list_len(arguments))
  match checked_body_infer_generic_arguments(
    state,
    source,
    types,
    owner,
    function_result,
    loop_context,
    environment,
    signature.type_id,
    arguments,
    0,
    total,
    semantic_type_substitution_empty(),
    Nil<CheckedExprId>(),
    name_range
  ) {
    CheckedInferredGenericArgumentsRejected(state, issue) -> CheckedBodyExprRejected(
      state,
      issue
    )
    CheckedInferredGenericArgumentsResolved(state, substitution, values, range) ->
      match
      checked_body_inferred_type_arguments(
        state,
        signature,
        substitution,
        0,
        Nil<SemanticTypeId>()
      ) {
        None -> CheckedBodyExprRejected(
          state,
          CheckedBodyProducerGenericInferenceIncomplete(name_range)
        )
        Some(resolved) -> {
          let catalog = state.types()
          let resolution = types.resolution
          let segment = catalog.next_derived_segment(
            types.module.identity,
            resolution.next_type_segment()
          )
          let product = semantic_type_product_continue(
            types.module.identity,
            catalog,
            segment
          )
          match checked_body_generic_bounds(state, signature, substitution, 0, product) {
            CheckedGenericBoundsRejected(product, concrete, trait_atom) ->
              CheckedBodyExprRejected(
                state.with_types(semantic_type_product_catalog(product)),
                CheckedBodyProducerGenericBoundRejected(concrete, trait_atom)
              )
            CheckedGenericBoundsAccepted(product) -> {
              let (product, specialized) = semantic_type_product_substitute(
                product,
                substitution,
                signature.type_id
              )
              let next_catalog = semantic_type_product_catalog(product)
              let state = state.with_types(next_catalog)
              match checked_body_validate_inferred_arguments(
                state,
                specialized,
                values.reverse(),
                0
              ) {
                CheckedInferredGenericInvalid(issue) -> CheckedBodyExprRejected(state, issue)
                CheckedInferredGenericValid -> match checked_body_function_effect_requirement(
                  next_catalog,
                  environment,
                  specialized
                ) {
                  CheckedBodyEffectAtomUnavailable(atom) -> CheckedBodyExprRejected(
                    state,
                    CheckedBodyProducerEffectUnavailable(atom)
                  )
                  CheckedBodyEffectTailUnavailable(variable) -> CheckedBodyExprRejected(
                    state,
                    CheckedBodyProducerEffectTailUnavailable(variable)
                  )
                  CheckedBodyEffectsAvailable -> {
                    let result = semantic_function_result(next_catalog, specialized)
                    if not expectation_allows(next_catalog, result, expectation) {
                      CheckedBodyExprRejected(
                        state,
                        expectation_mismatch(result, expectation)
                      )
                    } else {
                      match checked_body_publish_arguments(state, values) {
                        (state, checked_arguments) -> match state.direct_call(
                          function,
                          checked_arguments,
                          result,
                          range
                        ) {
                          (state, call) -> match state.generic_call(
                            call,
                            resolved,
                            result,
                            range
                          ) {
                            (state, generic) -> CheckedBodyExprBuilt(state, generic)
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
  }
}

fn checked_body_generic_call(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  type_arguments: TypeExprList,
  inner: Expr,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  match inner {
    Call(start, length, arguments) -> match source_range(source, start, length) {
      name_range: CheckedSourceRange -> match lexical_lookup(
        environment,
        source,
        start,
        length
      ) {
        CheckedLexicalFound(_, _, _) -> CheckedBodyExprRejected(
          state,
          CheckedBodyProducerGenericDeclarationRequired(name_range)
        )
        CheckedLexicalMissing -> match source.span(name_range.start, name_range.end) {
          Some(name) -> match registration_scope_lookup_declaration_span(
            lexical_scope(environment),
            lexical_module(environment),
            ValueDeclaration,
            name
          ) {
            Some(declaration) -> {
              let function = DeclaredFunctionIdentity(declaration.identity)
              match state.find_signature(function) {
                Some(signature) -> {
                  let provided = __i64_to_usize(type_expr_list_len(type_arguments))
                  let required = state.type_parameter_count(signature)
                  if provided != required {
                    CheckedBodyExprRejected(
                      state,
                      CheckedBodyProducerArityMismatch(required, provided)
                    )
                  } else {
                    let catalog = state.types()
                    let resolution = types.resolution
                    let segment = catalog.next_derived_segment(
                      types.module.identity,
                      resolution.next_type_segment()
                    )
                    let product = semantic_type_product_continue(
                      types.module.identity,
                      catalog,
                      segment
                    )
                    match checked_body_generic_arguments(
                      state,
                      types.module,
                      environment,
                      signature,
                      type_arguments,
                      0,
                      product,
                      semantic_type_substitution_empty(),
                      Nil<SemanticTypeId>()
                    ) {
                      CheckedGenericArgumentsRejected(issue) -> CheckedBodyExprRejected(
                        state,
                        CheckedBodyProducerTypeRejected(issue)
                      )
                      CheckedGenericArgumentsResolved(product, substitution, resolved) ->
                        match checked_body_generic_bounds(
                          state,
                          signature,
                          substitution,
                          0,
                          product
                        ) {
                          CheckedGenericBoundsRejected(product, concrete, trait_atom) ->
                            CheckedBodyExprRejected(
                              state.with_types(semantic_type_product_catalog(product)),
                              CheckedBodyProducerGenericBoundRejected(concrete, trait_atom)
                            )
                          CheckedGenericBoundsAccepted(product) -> {
                            let (product, specialized) = semantic_type_product_substitute(
                              product,
                              substitution,
                              signature.type_id
                            )
                            let next_catalog = semantic_type_product_catalog(product)
                            let next_state = state.with_types(next_catalog)
                            let next_types = checked_body_types_with_catalog(types, next_catalog)
                            match checked_body_call_with_signature(
                              next_state,
                              source,
                              next_types,
                              owner,
                              function_result,
                              loop_context,
                              environment,
                              name_range,
                              name_range.start,
                              arguments,
                              specialized,
                              CheckedDirectCallee(function),
                              expectation
                            ) {
                              CheckedBodyExprBuilt(state, call) -> {
                                let result = state.result_type(call)
                                let range = state.range(call)
                                match state.generic_call(call, resolved, result, range) {
                                  (state, generic) -> CheckedBodyExprBuilt(state, generic)
                                }
                              }
                              CheckedBodyExprRejected(state, issue) ->
                                CheckedBodyExprRejected(state, issue)
                            }
                          }
                        }
                    }
                  }
                }
                None -> CheckedBodyExprRejected(
                  state,
                  CheckedBodyProducerSignatureUnavailable(name_range)
                )
              }
            }
            None -> CheckedBodyExprRejected(
              state,
              CheckedBodyProducerUnknownIdentifier(name_range)
            )
          }
          None -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
        }
      }
      nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
    }
    _ -> CheckedBodyExprRejected(state, CheckedBodyProducerUnsupportedExpression)
  }
}

fn checked_body_constructor_arguments(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  result_type: SemanticTypeId,
  payload_source: CheckedConstructorPayloadSource,
  arguments: ExprList,
  index: usize,
  values: List<CheckedExprId>,
  range: CheckedSourceRange
) -[SemanticConformance]> CheckedBodyArgumentsBuild {
  match arguments {
    ExprListNil -> match checked_body_publish_arguments(state, values) {
      (state, list) -> CheckedBodyArgumentsBuilt(state, list, range)
    }
    ExprListCons(argument, rest) -> {
      let catalog = state.types()
      let applications = types.variant_applications
      let payload_type = match payload_source {
        CheckedAppliedConstructor(case_index) -> semantic_variant_payload_type(
          applications,
          catalog,
          result_type,
          case_index,
          index
        )
        CheckedDeclaredConstructor(layout_index, case_index) -> {
          let resolution = types.resolution
          let declarations = resolution.declarations()
          semantic_type_declared_variant_payload_type(
            declarations,
            layout_index,
            case_index,
            index
          )
        }
      }
      match payload_type {
        None -> CheckedBodyArgumentsRejected(
          state,
          CheckedBodyProducerVariantPatternRequired(result_type)
        )
        Some(payload_type) -> match checked_body_expr(
          state,
          source,
          checked_body_types_with_catalog(types, catalog),
          owner,
          function_result,
          loop_context,
          environment,
          argument,
          CheckedRequireResult(payload_type)
        ) {
          CheckedBodyExprRejected(state, issue) -> CheckedBodyArgumentsRejected(state, issue)
          CheckedBodyExprBuilt(state, value) -> match covering_range(range, state.range(value)) {
            nil -> CheckedBodyArgumentsRejected(state, CheckedBodyProducerInvalidRange)
            next_range: CheckedSourceRange -> checked_body_constructor_arguments(
              state,
              source,
              types,
              owner,
              function_result,
              loop_context,
              environment,
              result_type,
              payload_source,
              rest,
              index + 1,
              values.prepend(value),
              next_range
            )
          }
        }
      }
    }
  }
}

fn checked_body_constructor_finish(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  declaration: DeclarationIdentity,
  result_type: SemanticTypeId,
  payload_count: usize,
  payload_source: CheckedConstructorPayloadSource,
  name_range: CheckedSourceRange,
  arguments: ExprList
) -[SemanticConformance]> CheckedBodyExprBuild {
  let provided = __i64_to_usize(expr_list_len(arguments))
  if provided != payload_count {
    CheckedBodyExprRejected(
      state,
      CheckedBodyProducerConstructorArityMismatch(payload_count, provided)
    )
  } else {
    match checked_body_constructor_arguments(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      result_type,
      payload_source,
      arguments,
      0,
      Nil<CheckedExprId>(),
      name_range
    ) {
      CheckedBodyArgumentsRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
      CheckedBodyArgumentsBuilt(state, checked_arguments, range) -> match state.constructor_call(
        declaration,
        checked_arguments,
        result_type,
        range
      ) {
        (state, expression) -> CheckedBodyExprBuilt(state, expression)
      }
    }
  }
}

fn checked_body_constructor_reference_parameters(
  types: CheckedBodyPrimitiveTypes,
  expected: SemanticTypeId,
  result_type: SemanticTypeId,
  payload_count: usize,
  payload_source: CheckedConstructorPayloadSource,
  index: usize
) -[SemanticConformance]> bool {
  if index == payload_count { true }
  else {
    let catalog = types.catalog
    let payload = match payload_source {
      CheckedAppliedConstructor(case_index) -> {
        let applications = types.variant_applications
        semantic_variant_payload_type(applications, catalog, result_type, case_index, index)
      }
      CheckedDeclaredConstructor(layout_index, case_index) -> {
        let resolution = types.resolution
        let declarations = resolution.declarations()
        semantic_type_declared_variant_payload_type(
          declarations,
          layout_index,
          case_index,
          index
        )
      }
    }
    match payload {
      None -> false
      Some(payload_type) -> semantic_type_is_subtype(
        catalog,
        semantic_function_parameter(catalog, expected, index),
        payload_type
      ) and checked_body_constructor_reference_parameters(
        types,
        expected,
        result_type,
        payload_count,
        payload_source,
        index + 1
      )
    }
  }
}

fn checked_body_constructor_reference_finish(
  state: owned CheckedBodyBuild,
  types: CheckedBodyPrimitiveTypes,
  visible: DeclarationIdentity,
  result_type: SemanticTypeId,
  payload_count: usize,
  payload_source: CheckedConstructorPayloadSource,
  range: CheckedSourceRange,
  expected: SemanticTypeId
) -[SemanticConformance]> CheckedBodyExprBuild {
  let catalog = state.types()
  if payload_count == 0 {
    CheckedBodyExprRejected(state, CheckedBodyProducerCallableRequired(expected))
  } else if not semantic_type_is_subtype(
    catalog,
    result_type,
    semantic_function_result(catalog, expected)
  ) {
    CheckedBodyExprRejected(
      state,
      expectation_mismatch(
        result_type,
        CheckedRequireResult(semantic_function_result(catalog, expected))
      )
    )
  } else if semantic_function_parameter_count(catalog, expected) != payload_count {
    CheckedBodyExprRejected(
      state,
      CheckedBodyProducerConstructorArityMismatch(
        payload_count,
        semantic_function_parameter_count(catalog, expected)
      )
    )
  } else if not checked_body_constructor_reference_parameters(
    checked_body_types_with_catalog(types, catalog),
    expected,
    result_type,
    payload_count,
    payload_source,
    0
  ) {
    CheckedBodyExprRejected(state, CheckedBodyProducerCallableRequired(expected))
  } else {
    match state.declaration_reference(visible, expected, range) {
      (state, expression) -> CheckedBodyExprBuilt(state, expression)
    }
  }
}

fn checked_body_constructor_function_value(
  state: owned CheckedBodyBuild,
  types: CheckedBodyPrimitiveTypes,
  visible: DeclarationIdentity,
  name: Span,
  range: CheckedSourceRange,
  expected: SemanticTypeId
) -[SemanticConformance]> CheckedBodyExprBuild {
  let catalog = state.types()
  let applications = types.variant_applications
  match name.text() {
    None -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
    Some(spelling) -> match semantic_variant_case_projection(
      applications,
      catalog,
      semantic_function_result(catalog, expected),
      spelling
    ) {
      SemanticVariantCaseProjected(declaration, case_index, payload_count) ->
        if
        declaration_identity_eq(visible, declaration) {
          checked_body_constructor_reference_finish(
            state,
            types,
            visible,
            semantic_function_result(catalog, expected),
            payload_count,
            CheckedAppliedConstructor(case_index),
            range,
            expected
          )
        } else { CheckedBodyExprRejected(state, CheckedBodyProducerUnknownConstructor(range)) }
      _ -> {
        let resolution = types.resolution
        let declarations = resolution.declarations()
        match semantic_type_declared_unparameterized_variant_constructor(
          catalog,
          declarations,
          visible
        ) {
          SemanticUnparameterizedVariantSelected(
            result_type,
            layout_index,
            case_index,
            payload_count,
          ) -> checked_body_constructor_reference_finish(
            state,
            types,
            visible,
            result_type,
            payload_count,
            CheckedDeclaredConstructor(layout_index, case_index),
            range,
            expected
          )
          _ -> CheckedBodyExprRejected(state, CheckedBodyProducerUnknownConstructor(range))
        }
      }
    }
  }
}

fn checked_body_constructor_payload_types(
  types: CheckedBodyPrimitiveTypes,
  result_type: SemanticTypeId,
  source: CheckedConstructorPayloadSource,
  index: usize,
  count: usize,
  values: List<SemanticTypeId>
) -> Option<List<SemanticTypeId>> {
  if index == count { Some(values.reverse()) }
  else {
    let payload = match source {
      CheckedAppliedConstructor(case_index) -> {
        let applications = types.variant_applications
        let catalog = types.catalog
        semantic_variant_payload_type(
          applications,
          catalog,
          result_type,
          case_index,
          index
        )
      }
      CheckedDeclaredConstructor(layout_index, case_index) -> {
        let resolution = types.resolution
        let declarations = resolution.declarations()
        semantic_type_declared_variant_payload_type(
          declarations,
          layout_index,
          case_index,
          index
        )
      }
    }
    match payload {
      None -> None<List<SemanticTypeId>>()
      Some(payload_type) -> checked_body_constructor_payload_types(
        types,
        result_type,
        source,
        index + 1,
        count,
        values.prepend(payload_type)
      )
    }
  }
}

fn checked_body_constructor_inferred_selected(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  visible: DeclarationIdentity,
  name: Span,
  range: CheckedSourceRange,
  result_type: SemanticTypeId,
  payload_count: usize,
  payload_source: CheckedConstructorPayloadSource
) -[SemanticConformance]> CheckedBodyExprBuild {
  if payload_count == 0 {
    checked_body_constructor_invoke(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      visible,
      name,
      range,
      ExprListNil,
      CheckedRequireResult(result_type)
    )
  } else {
    let catalog = state.types()
    match checked_body_constructor_payload_types(
      checked_body_types_with_catalog(types, catalog),
      result_type,
      payload_source,
      0,
      payload_count,
      Nil<SemanticTypeId>()
    ) {
      None -> CheckedBodyExprRejected(
        state,
        CheckedBodyProducerConstructorResultRequired(range)
      )
      Some(payloads) -> {
        let module = types.module
        let resolution = types.resolution
        let segment = semantic_type_derived_segment_id(
          module.identity,
          catalog.next_derived_segment(module.identity, resolution.next_type_segment())
        )
        let builder = semantic_type_graph_builder(segment)
        let (builder, parameters) = builder.type_list(payloads)
        let (builder, effect_atoms) = builder.type_list(Nil<SemanticTypeId>())
        let (builder, effects) = builder.effect_signature(effect_atoms, SemanticClosedEffects)
        let (builder, function_type) = builder.function(parameters, result_type, effects)
        let next_catalog = semantic_type_catalog_with_graph(catalog, builder.freeze())
        let state = state.with_types(next_catalog)
        match state.declaration_reference(visible, function_type, range) {
          (state, expression) -> CheckedBodyExprBuilt(state, expression)
        }
      }
    }
  }
}

fn checked_body_constructor_inferred_value(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  visible: DeclarationIdentity,
  name: Span,
  range: CheckedSourceRange
) -[SemanticConformance]> CheckedBodyExprBuild {
  let catalog = state.types()
  let applications = types.variant_applications
  match semantic_variant_constructor_result(applications, visible) {
    SemanticVariantConstructorResultSelected(result_type) -> match name.text() {
      None -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
      Some(spelling) -> match semantic_variant_case_projection(
        applications,
        catalog,
        result_type,
        spelling
      ) {
        SemanticVariantCaseProjected(declaration, case_index, payload_count) ->
          if
          declaration_identity_eq(visible, declaration) {
            checked_body_constructor_inferred_selected(
              state,
              source,
              types,
              owner,
              function_result,
              loop_context,
              environment,
              visible,
              name,
              range,
              result_type,
              payload_count,
              CheckedAppliedConstructor(case_index)
            )
          } else { CheckedBodyExprRejected(state, CheckedBodyProducerUnknownConstructor(range)) }
        _ -> CheckedBodyExprRejected(state, CheckedBodyProducerUnknownConstructor(range))
      }
    }
    SemanticVariantConstructorResultAmbiguous -> CheckedBodyExprRejected(
      state,
      CheckedBodyProducerConstructorResultAmbiguous(range)
    )
    SemanticVariantConstructorResultMissing -> {
      let resolution = types.resolution
      let declarations = resolution.declarations()
      match semantic_type_declared_unparameterized_variant_constructor(
        catalog,
        declarations,
        visible
      ) {
        SemanticUnparameterizedVariantSelected(
          result_type,
          layout_index,
          case_index,
          payload_count,
        ) -> checked_body_constructor_inferred_selected(
          state,
          source,
          types,
          owner,
          function_result,
          loop_context,
          environment,
          visible,
          name,
          range,
          result_type,
          payload_count,
          CheckedDeclaredConstructor(layout_index, case_index)
        )
        SemanticUnparameterizedVariantAmbiguous -> CheckedBodyExprRejected(
          state,
          CheckedBodyProducerConstructorResultAmbiguous(range)
        )
        _ -> CheckedBodyExprRejected(
          state,
          CheckedBodyProducerConstructorResultRequired(range)
        )
      }
    }
  }
}

fn checked_body_constructor_value(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  visible: DeclarationIdentity,
  name: Span,
  name_range: CheckedSourceRange,
  arguments: ExprList,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  match (arguments, expectation) {
    (ExprListNil, CheckedInferResult) -> checked_body_constructor_inferred_value(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      visible,
      name,
      name_range
    )
    (ExprListNil, CheckedRequireResult(expected)) -> {
      let catalog = state.types()
      match catalog.graph_for(expected) {
        Some(graph) -> match semantic_type_graph_node(graph, expected) {
          SemanticFunctionNode(_, _, _) -> checked_body_constructor_function_value(
            state,
            types,
            visible,
            name,
            name_range,
            expected
          )
          _ -> checked_body_constructor_invoke(
            state,
            source,
            types,
            owner,
            function_result,
            loop_context,
            environment,
            visible,
            name,
            name_range,
            arguments,
            expectation
          )
        }
        None -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
      }
    }
    _ -> checked_body_constructor_invoke(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      visible,
      name,
      name_range,
      arguments,
      expectation
    )
  }
}

fn checked_body_constructor_invoke(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  visible: DeclarationIdentity,
  name: Span,
  name_range: CheckedSourceRange,
  arguments: ExprList,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  match expectation {
    CheckedInferResult -> {
      let applications = types.variant_applications
      match semantic_variant_constructor_result(applications, visible) {
        SemanticVariantConstructorResultMissing -> {
          let catalog = state.types()
          let resolution = types.resolution
          let declarations = resolution.declarations()
          match semantic_type_declared_unparameterized_variant_constructor(
            catalog,
            declarations,
            visible
          ) {
            SemanticUnparameterizedVariantMissing -> CheckedBodyExprRejected(
              state,
              CheckedBodyProducerConstructorResultRequired(name_range)
            )
            SemanticUnparameterizedVariantAmbiguous -> CheckedBodyExprRejected(
              state,
              CheckedBodyProducerConstructorResultAmbiguous(name_range)
            )
            SemanticUnparameterizedVariantSelected(result_type, _, _, _) ->
              checked_body_constructor_invoke(
                state,
                source,
                types,
                owner,
                function_result,
                loop_context,
                environment,
                visible,
                name,
                name_range,
                arguments,
                CheckedRequireResult(result_type)
              )
          }
        }
        SemanticVariantConstructorResultAmbiguous -> CheckedBodyExprRejected(
          state,
          CheckedBodyProducerConstructorResultAmbiguous(name_range)
        )
        SemanticVariantConstructorResultSelected(result_type) ->
          checked_body_constructor_invoke(
            state,
            source,
            types,
            owner,
            function_result,
            loop_context,
            environment,
            visible,
            name,
            name_range,
            arguments,
            CheckedRequireResult(result_type)
          )
      }
    }
    CheckedRequireResult(result_type) -> match name.text() {
      None -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
      Some(spelling) -> {
        let catalog = state.types()
        let applications = types.variant_applications
        match semantic_variant_case_projection(
          applications,
          catalog,
          result_type,
          spelling
        ) {
          SemanticVariantCaseProjected(declaration, case_index, payload_count) ->
            if
            declaration_identity_eq(visible, declaration) {
              checked_body_constructor_finish(
                state,
                source,
                types,
                owner,
                function_result,
                loop_context,
                environment,
                declaration,
                result_type,
                payload_count,
                CheckedAppliedConstructor(case_index),
                name_range,
                arguments
              )
            } else {
              CheckedBodyExprRejected(state, CheckedBodyProducerUnknownConstructor(name_range))
            }
          _ -> {
            let resolution = types.resolution
            let declarations = resolution.declarations()
            match semantic_type_declared_unparameterized_variant_constructor(
              catalog,
              declarations,
              visible
            ) {
              SemanticUnparameterizedVariantSelected(
                target,
                layout_index,
                case_index,
                payload_count,
              ) -> if semantic_type_catalog_equal(catalog, target, result_type) {
                checked_body_constructor_finish(
                  state,
                  source,
                  types,
                  owner,
                  function_result,
                  loop_context,
                  environment,
                  visible,
                  result_type,
                  payload_count,
                  CheckedDeclaredConstructor(layout_index, case_index),
                  name_range,
                  arguments
                )
              } else {
                CheckedBodyExprRejected(
                  state,
                  CheckedBodyProducerUnknownConstructor(name_range)
                )
              }
              _ -> CheckedBodyExprRejected(
                state,
                CheckedBodyProducerUnknownConstructor(name_range)
              )
            }
          }
        }
      }
    }
  }
}

fn checked_body_qualified_constructor(
  source: Source,
  environment: CheckedLexicalEnvironment,
  qualifier: Expr,
  member: Span,
  member_range: CheckedSourceRange
) -> Option<(DeclarationIdentity, CheckedSourceRange)> {
  match qualifier {
    Ident(start, length) -> match lexical_lookup(environment, source, start, length) {
      CheckedLexicalFound(_, _, _) -> None<(DeclarationIdentity, CheckedSourceRange)>()
      CheckedLexicalMissing -> match source_range(source, start, length) {
        nil -> None<(DeclarationIdentity, CheckedSourceRange)>()
        qualifier_range: CheckedSourceRange -> match source.span(
          qualifier_range.start,
          qualifier_range.end
        ) {
          None -> None<(DeclarationIdentity, CheckedSourceRange)>()
          Some(qualifier_span) -> match registration_scope_lookup_qualified_declaration_span(
            lexical_scope(environment),
            lexical_module(environment),
            qualifier_span,
            ConstructorDeclaration,
            member
          ) {
            None -> None<(DeclarationIdentity, CheckedSourceRange)>()
            Some(declaration) -> match covering_range(qualifier_range, member_range) {
              nil -> None<(DeclarationIdentity, CheckedSourceRange)>()
              range: CheckedSourceRange -> Some((declaration.identity, range))
            }
          }
        }
      }
    }
    _ -> None<(DeclarationIdentity, CheckedSourceRange)>()
  }
}

fn checked_body_call(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  start: i64,
  length: i64,
  arguments: ExprList,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  let catalog = types.catalog
  match source_range(source, start, length) {
    name_range: CheckedSourceRange -> match lexical_lookup(
      environment,
      source,
      start,
      length
    ) {
      CheckedLexicalFound(binding, callee_type, _) -> if semantic_function_type(
        catalog,
        callee_type
      ) {
        match state.local_reference(binding, callee_type, name_range) {
          (state, callee) -> checked_body_call_with_signature(
            state,
            source,
            types,
            owner,
            function_result,
            loop_context,
            environment,
            name_range,
            name_range.start,
            arguments,
            callee_type,
            CheckedAppliedCallee(callee),
            expectation
          )
        }
      } else {
        CheckedBodyExprRejected(
          state,
          CheckedBodyProducerCallableRequired(callee_type)
        )
      }
      CheckedLexicalMissing -> match source.span(name_range.start, name_range.end) {
        Some(name) -> match registration_scope_lookup_declaration_span(
          lexical_scope(environment),
          lexical_module(environment),
          ValueDeclaration,
          name
        ) {
          Some(declaration) -> {
            let function = DeclaredFunctionIdentity(declaration.identity)
            match state.find_signature(function) {
              Some(signature) -> if state.type_parameter_count(signature) > 0 {
                checked_body_inferred_generic_call(
                  state,
                  source,
                  types,
                  owner,
                  function_result,
                  loop_context,
                  environment,
                  name_range,
                  arguments,
                  signature,
                  function,
                  expectation
                )
              } else {
                checked_body_call_with_signature(
                  state,
                  source,
                  types,
                  owner,
                  function_result,
                  loop_context,
                  environment,
                  name_range,
                  name_range.start,
                  arguments,
                  signature.type_id,
                  CheckedDirectCallee(function),
                  expectation
                )
              }
              None -> CheckedBodyExprRejected(
                state,
                CheckedBodyProducerSignatureUnavailable(name_range)
              )
            }
          }
          None -> match registration_scope_lookup_declaration_span(
            lexical_scope(environment),
            lexical_module(environment),
            ConstructorDeclaration,
            name
          ) {
            Some(declaration) -> checked_body_constructor_invoke(
              state,
              source,
              types,
              owner,
              function_result,
              loop_context,
              environment,
              declaration.identity,
              name,
              name_range,
              arguments,
              expectation
            )
            None -> CheckedBodyExprRejected(
              state,
              CheckedBodyProducerUnknownIdentifier(name_range)
            )
          }
        }
        None -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
      }
    }
    nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
  }
}

fn checked_body_apply(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  callee: Expr,
  arguments: ExprList,
  site: i64,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  match checked_body_expr(
    state,
    source,
    types,
    owner,
    function_result,
    loop_context,
    environment,
    callee,
    CheckedInferResult
  ) {
    CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
    CheckedBodyExprBuilt(state, checked_callee) -> {
      let callee_type = state.result_type(checked_callee)
      let catalog = state.types()
      if not semantic_function_type(catalog, callee_type) {
        CheckedBodyExprRejected(
          state,
          CheckedBodyProducerCallableRequired(callee_type)
        )
      } else {
        let callee_range = state.range(checked_callee)
        match source_range(source, site, 0) {
          call_range: CheckedSourceRange -> checked_body_call_with_signature(
            state,
            source,
            types,
            owner,
            function_result,
            loop_context,
            environment,
            callee_range,
            call_range.start,
            arguments,
            callee_type,
            CheckedAppliedCallee(checked_callee),
            expectation
          )
          nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
        }
      }
    }
  }
}

fn checked_body_indexed_shape(
  catalog: borrow SemanticTypeCatalog,
  value_type: SemanticTypeId,
  purpose: CheckedBodyIndexUse
) -> CheckedBodyIndexedShape {
  match catalog.graph_for(value_type) {
    None -> CheckedNotIndexed
    Some(graph) -> match semantic_type_graph_node(graph, value_type) {
      SemanticArrayNode(element, length) -> CheckedFixedIndexed(element, length)
      SemanticSliceNode(element, _) -> CheckedDynamicIndexed(element)
      SemanticBorrowNode(inner, _) -> checked_body_indexed_shape(catalog, inner, purpose)
      SemanticOwnedNode(inner) -> match purpose {
        CheckedLengthRead -> checked_body_indexed_shape(catalog, inner, purpose)
        CheckedElementRead -> CheckedNotIndexed
      }
      SemanticUniqueNode(inner) -> match purpose {
        CheckedLengthRead -> checked_body_indexed_shape(catalog, inner, purpose)
        CheckedElementRead -> CheckedNotIndexed
      }
      _ -> CheckedNotIndexed
    }
  }
}

fn checked_body_writable_shape(
  catalog: borrow SemanticTypeCatalog,
  value_type: SemanticTypeId
) -> CheckedBodyWritableShape {
  match catalog.graph_for(value_type) {
    None -> CheckedNotWritableIndexed
    Some(graph) -> match semantic_type_graph_node(graph, value_type) {
      SemanticArrayNode(element, length) -> CheckedWritableArray(
        element,
        __u64_to_isize(__usize_to_u64(length))
      )
      SemanticSliceNode(element, SemanticMutable) -> CheckedWritableSlice(element)
      SemanticSliceNode(_, SemanticImmutable) -> CheckedImmutableSlice
      _ -> CheckedNotWritableIndexed
    }
  }
}

fn checked_body_slice_shape(
  catalog: borrow SemanticTypeCatalog,
  value_type: SemanticTypeId,
  vector_declaration: DeclarationIdentity?
) -> CheckedBodySliceShape {
  match catalog.graph_for(value_type) {
    None -> CheckedNotSliceable
    Some(graph) -> match semantic_type_graph_node(graph, value_type) {
      SemanticArrayNode(element, _) -> CheckedSliceArray(element)
      SemanticSliceNode(element, mutability) -> CheckedSliceView(element, mutability)
      SemanticBorrowNode(inner, _) -> checked_body_slice_shape(catalog, inner, vector_declaration)
      SemanticOwnedNode(inner) -> checked_body_slice_shape(catalog, inner, vector_declaration)
      SemanticUniqueNode(inner) -> checked_body_slice_shape(catalog, inner, vector_declaration)
      SemanticNamedNode(found, SemanticNominalType, _, arguments) ->
        match vector_declaration {
          nil -> CheckedNotSliceable
          declared: DeclarationIdentity -> if not declaration_identity_eq(found, declared) {
            CheckedNotSliceable
          } else {
            let lists = semantic_type_graph_type_lists_local(graph)
            if semantic_type_list_len(lists, arguments) != 1 { CheckedNotSliceable }
          else {
            CheckedSliceVector(
              semantic_type_graph_list_type_id(
                graph,
                semantic_type_list_edge(lists, arguments, 0)
              )
            )
          }
          }
        }
      _ -> CheckedNotSliceable
    }
  }
}

fn checked_body_slice_permission(
  source: Source,
  environment: CheckedLexicalEnvironment,
  base: Expr,
  shape: CheckedBodySliceShape,
  mutable: bool,
  range: CheckedSourceRange
) -> Option<CheckedBodyProducerIssue> {
  let named = match base {
    Ident(start, length) -> lexical_lookup(environment, source, start, length)
    _ -> CheckedLexicalMissing
  }
  match shape {
    CheckedNotSliceable -> None<CheckedBodyProducerIssue>()
    CheckedSliceArray(_) -> match named {
      CheckedLexicalFound(_, _, writable) -> if mutable and not writable {
        Some<CheckedBodyProducerIssue>(CheckedBodyProducerImmutableAssignment(range))
      } else { None<CheckedBodyProducerIssue>() }
      CheckedLexicalMissing -> Some<CheckedBodyProducerIssue>(
        CheckedBodyProducerIndexedNamedBindingRequired(range)
      )
    }
    CheckedSliceVector(_) -> match named {
      CheckedLexicalFound(_, _, _) -> None<CheckedBodyProducerIssue>()
      CheckedLexicalMissing -> Some<CheckedBodyProducerIssue>(
        CheckedBodyProducerIndexedNamedBindingRequired(range)
      )
    }
    CheckedSliceView(_, mutability) -> if not mutable { None<CheckedBodyProducerIssue>() }
    else {
      match mutability {
        SemanticImmutable -> Some<CheckedBodyProducerIssue>(
          CheckedBodyProducerImmutableAssignment(range)
        )
        SemanticMutable -> match named {
          CheckedLexicalFound(_, _, _) -> None<CheckedBodyProducerIssue>()
          CheckedLexicalMissing -> Some<CheckedBodyProducerIssue>(
            CheckedBodyProducerIndexedNamedBindingRequired(range)
          )
        }
      }
    }
  }
}

fn checked_body_slice_bound(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  bound: Expr
) -[SemanticConformance]> CheckedBodyExprBuild {
  match bound {
    NilExpr -> checked_body_expr(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      bound,
      CheckedInferResult
    )
    _ -> checked_body_expr(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      bound,
      CheckedRequireResult(types.usize_type)
    )
  }
}

fn checked_body_indexed_slice(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  base: Expr,
  start: Expr,
  end: Expr,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  match checked_body_expr(
    state,
    source,
    types,
    owner,
    function_result,
    loop_context,
    environment,
    base,
    CheckedInferResult
  ) {
    CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
    CheckedBodyExprBuilt(state, checked_base) -> {
      let base_type = state.result_type(checked_base)
      let catalog = state.types()
      let vector = checked_body_standard_declaration(
        types,
        lexical_scope(environment),
        "stdlib/vector/handles",
        TypeDeclaration,
        "Vector"
      )
      let shape = checked_body_slice_shape(catalog, base_type, vector)
      let element = match shape {
        CheckedSliceArray(inner) -> Some<SemanticTypeId>(inner)
        CheckedSliceVector(inner) -> Some<SemanticTypeId>(inner)
        CheckedSliceView(inner, _) -> Some<SemanticTypeId>(inner)
        CheckedNotSliceable -> None<SemanticTypeId>()
      }
      match element {
        None -> CheckedBodyExprRejected(
          state,
          CheckedBodyProducerIndexedBaseRequired(base_type)
        )
        Some(inner) -> {
          let mutable = match expectation {
            CheckedInferResult -> false
            CheckedRequireResult(expected) -> match catalog.graph_for(expected) {
              None -> false
              Some(graph) -> match semantic_type_graph_node(graph, expected) {
                SemanticSliceNode(_, SemanticMutable) -> true
                _ -> false
              }
            }
          }
          match checked_body_slice_permission(
            source,
            environment,
            base,
            shape,
            mutable,
            state.range(checked_base)
          ) {
            Some(issue) -> CheckedBodyExprRejected(state, issue)
            None -> match checked_body_slice_bound(
              state,
              source,
              types,
              owner,
              function_result,
              loop_context,
              environment,
              start
            ) {
              CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
              CheckedBodyExprBuilt(state, checked_start) -> match checked_body_slice_bound(
                state,
                source,
                types,
                owner,
                function_result,
                loop_context,
                environment,
                end
              ) {
                CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
                CheckedBodyExprBuilt(state, checked_end) -> {
                  let catalog = state.types()
                  let resolution = types.resolution
                  let segment = semantic_type_derived_segment_id(
                    types.module.identity,
                    catalog.next_derived_segment(
                      types.module.identity,
                      resolution.next_type_segment()
                    )
                  )
                  let builder = semantic_type_graph_builder(segment)
                  let mutability = if mutable { SemanticMutable } else { SemanticImmutable }
                  match builder.slice(inner, mutability) {
                    (builder, result) -> {
                      let next_catalog = semantic_type_catalog_with_graph(
                        catalog,
                        builder.freeze()
                      )
                      if not expectation_allows(next_catalog, result, expectation) {
                        CheckedBodyExprRejected(state, expectation_mismatch(result, expectation))
                      } else {
                        let state = state.with_types(next_catalog)
                        match covering_range(
                          state.range(checked_base),
                          state.range(checked_start)
                        ) {
                          nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
                          first: CheckedSourceRange -> match covering_range(
                            first,
                            state.range(checked_end)
                          ) {
                            nil -> CheckedBodyExprRejected(
                              state,
                              CheckedBodyProducerInvalidRange
                            )
                            range: CheckedSourceRange -> match state.indexed_slice(
                              checked_base,
                              checked_start,
                              checked_end,
                              inner,
                              result,
                              range
                            ) {
                              (state, expression) -> CheckedBodyExprBuilt(state, expression)
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

fn checked_body_indexed_length(
  state: owned CheckedBodyBuild,
  types: CheckedBodyPrimitiveTypes,
  checked_base: CheckedExprId,
  shape: CheckedBodyIndexedShape,
  field_range: CheckedSourceRange,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  let catalog = state.types()
  if not expectation_allows(catalog, types.usize_type, expectation) {
    CheckedBodyExprRejected(
      state,
      expectation_mismatch(types.usize_type, expectation)
    )
  } else {
    match shape {
      CheckedFixedIndexed(element, length) -> match covering_range(
        state.range(checked_base),
        field_range
      ) {
        range: CheckedSourceRange -> match state.indexed_length(
          checked_base,
          element,
          __u64_to_isize(__usize_to_u64(length)),
          types.usize_type,
          range
        ) {
          (state, expression) -> CheckedBodyExprBuilt(state, expression)
        }
        nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
      }
      CheckedDynamicIndexed(element) -> match covering_range(
        state.range(checked_base),
        field_range
      ) {
        range: CheckedSourceRange -> match state.indexed_length(
          checked_base,
          element,
          0 - 1,
          types.usize_type,
          range
        ) {
          (state, expression) -> CheckedBodyExprBuilt(state, expression)
        }
        nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
      }
      CheckedNotIndexed -> {
        let base_type = state.result_type(checked_base)
        CheckedBodyExprRejected(state, CheckedBodyProducerIndexedBaseRequired(base_type))
      }
    }
  }
}

fn checked_body_indexed_get(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  base: Expr,
  index: Expr,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  match checked_body_expr(
    state,
    source,
    types,
    owner,
    function_result,
    loop_context,
    environment,
    base,
    CheckedInferResult
  ) {
    CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
    CheckedBodyExprBuilt(state, checked_base) -> {
      let catalog = state.types()
      let base_type = state.result_type(checked_base)
      let shape = checked_body_indexed_shape(catalog, base_type, CheckedElementRead)
      let parts: Option<(SemanticTypeId, isize)> = match shape {
        CheckedNotIndexed -> None<(SemanticTypeId, isize)>()
        CheckedFixedIndexed(element, length) -> Some(
          (
            element,
            __u64_to_isize(__usize_to_u64(length))
          )
        )
        CheckedDynamicIndexed(element) -> {
          let dynamic_length: isize = - 1
          Some((element, dynamic_length))
        }
      }
      match parts {
        None -> CheckedBodyExprRejected(
          state,
          CheckedBodyProducerIndexedBaseRequired(base_type)
        )
        Some((element, length)) -> match checked_body_expr(
          state,
          source,
          types,
          owner,
          function_result,
          loop_context,
          environment,
          index,
          CheckedRequireResult(types.usize_type)
        ) {
          CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
          CheckedBodyExprBuilt(state, checked_index) -> {
            let catalog = state.types()
            if semantic_continuation_type(catalog, element) {
              let range = state.range(checked_base)
              CheckedBodyExprRejected(
                state,
                CheckedBodyProducerContinuationConsumerRequired(range)
              )
            } else if not expectation_allows(catalog, element, expectation) {
              CheckedBodyExprRejected(state, expectation_mismatch(element, expectation))
            } else {
              match covering_range(state.range(checked_base), state.range(checked_index)) {
                range: CheckedSourceRange -> match state.indexed_get(
                  checked_base,
                  checked_index,
                  element,
                  length,
                  element,
                  range
                ) {
                  (state, expression) -> CheckedBodyExprBuilt(state, expression)
                }
                nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
              }
            }
          }
        }
      }
    }
  }
}

fn checked_body_indexed_set_value(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  checked_base: CheckedExprId,
  index: Expr,
  value: Expr,
  element: SemanticTypeId,
  length: isize,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  let catalog = state.types()
  if semantic_continuation_type(catalog, element) {
    let range = state.range(checked_base)
    CheckedBodyExprRejected(state, CheckedBodyProducerContinuationConsumerRequired(range))
  } else if not expectation_allows(catalog, types.nil_type, expectation) {
    CheckedBodyExprRejected(state, expectation_mismatch(types.nil_type, expectation))
  } else {
    match checked_body_expr(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      index,
      CheckedRequireResult(types.usize_type)
    ) {
      CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
      CheckedBodyExprBuilt(state, checked_index) -> match checked_body_expr(
        state,
        source,
        types,
        owner,
        function_result,
        loop_context,
        environment,
        value,
        CheckedRequireResult(element)
      ) {
        CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
        CheckedBodyExprBuilt(state, checked_value) -> match covering_range(
          state.range(checked_base),
          state.range(checked_value)
        ) {
          range: CheckedSourceRange -> match state.indexed_set(
            checked_base,
            checked_index,
            checked_value,
            element,
            length,
            types.nil_type,
            range
          ) {
            (state, expression) -> CheckedBodyExprBuilt(state, expression)
          }
          nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
        }
      }
    }
  }
}

fn checked_body_indexed_set(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  base: Expr,
  index: Expr,
  value: Expr,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  match checked_body_expr(
    state,
    source,
    types,
    owner,
    function_result,
    loop_context,
    environment,
    base,
    CheckedInferResult
  ) {
    CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
    CheckedBodyExprBuilt(state, checked_base) -> {
      let base_type = state.result_type(checked_base)
      let catalog = state.types()
      let shape = checked_body_writable_shape(catalog, base_type)
      match shape {
        CheckedNotWritableIndexed -> CheckedBodyExprRejected(
          state,
          CheckedBodyProducerIndexedBaseRequired(base_type)
        )
        CheckedImmutableSlice -> {
          let range = state.range(checked_base)
          CheckedBodyExprRejected(state, CheckedBodyProducerImmutableAssignment(range))
        }
        _ -> match base {
          Ident(start, length) -> match lexical_lookup(environment, source, start, length) {
            CheckedLexicalFound(_, _, mutable) -> match shape {
              CheckedWritableArray(element, size) -> if mutable {
                checked_body_indexed_set_value(
                  state,
                  source,
                  types,
                  owner,
                  function_result,
                  loop_context,
                  environment,
                  checked_base,
                  index,
                  value,
                  element,
                  size,
                  expectation
                )
              } else {
                let range = state.range(checked_base)
                CheckedBodyExprRejected(state, CheckedBodyProducerImmutableAssignment(range))
              }
              CheckedWritableSlice(element) -> {
                let dynamic_length: isize = - 1
                checked_body_indexed_set_value(
                  state,
                  source,
                  types,
                  owner,
                  function_result,
                  loop_context,
                  environment,
                  checked_base,
                  index,
                  value,
                  element,
                  dynamic_length,
                  expectation
                )
              }
              _ -> {
                let range = state.range(checked_base)
                CheckedBodyExprRejected(
                  state,
                  CheckedBodyProducerIndexedNamedBindingRequired(range)
                )
              }
            }
            CheckedLexicalMissing -> {
              let range = state.range(checked_base)
              CheckedBodyExprRejected(
                state,
                CheckedBodyProducerIndexedNamedBindingRequired(range)
              )
            }
          }
          _ -> {
            let range = state.range(checked_base)
            CheckedBodyExprRejected(
              state,
              CheckedBodyProducerIndexedNamedBindingRequired(range)
            )
          }
        }
      }
    }
  }
}

fn checked_body_field_access(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  base: Expr,
  field_start: i64,
  field_length: i64,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  match source_range(source, field_start, field_length) {
    nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
    field_range: CheckedSourceRange -> match source.span(field_range.start, field_range.end) {
      None -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
      Some(field_span) -> match checked_body_qualified_constructor(
        source,
        environment,
        base,
        field_span,
        field_range
      ) {
        Some((declaration, range)) -> checked_body_constructor_value(
          state,
          source,
          types,
          owner,
          function_result,
          loop_context,
          environment,
          declaration,
          field_span,
          range,
          ExprListNil,
          expectation
        )
        None -> checked_body_field_access_value(
          state,
          source,
          types,
          owner,
          function_result,
          loop_context,
          environment,
          base,
          field_start,
          field_length,
          expectation
        )
      }
    }
  }
}

fn checked_body_field_access_value(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  base: Expr,
  field_start: i64,
  field_length: i64,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  match checked_body_expr(
    state,
    source,
    types,
    owner,
    function_result,
    loop_context,
    environment,
    base,
    CheckedInferResult
  ) {
    CheckedBodyExprBuilt(state, checked_base) -> {
      let base_type = state.result_type(checked_base)
      let catalog = state.types()
      match source_range(source, field_start, field_length) {
        field_range: CheckedSourceRange -> match source.span(
          field_range.start,
          field_range.end
        ) {
          Some(field_span) -> match field_span.text() {
            Some(field_name) -> {
              let indexed = if field_name == "len" {
                checked_body_indexed_shape(catalog, base_type, CheckedLengthRead)
              } else { CheckedNotIndexed }
              match indexed {
                CheckedNotIndexed -> checked_body_project_field(
                  state,
                  types,
                  checked_base,
                  base_type,
                  field_name,
                  field_range,
                  expectation
                )
                shape -> checked_body_indexed_length(
                  state,
                  types,
                  checked_base,
                  shape,
                  field_range,
                  expectation
                )
              }
            }
            None -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
          }
          None -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
        }
        nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
      }
    }
    CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
  }
}

fn checked_body_project_field(
  state: owned CheckedBodyBuild,
  types: CheckedBodyPrimitiveTypes,
  checked_base: CheckedExprId,
  base_type: SemanticTypeId,
  field_name: str,
  field_range: CheckedSourceRange,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  let catalog = state.types()
  match semantic_record_field_projection(
    catalog,
    base_type,
    field_name
  ) {
    SemanticRecordFieldProjected(stable_key, word_offset, result) ->
      if expectation_allows(catalog, result, expectation) {
        match covering_range(state.range(checked_base), field_range) {
          range: CheckedSourceRange -> match state.structural_field_access(
            checked_base,
            stable_key,
            CheckedStructuralFieldWordOffset(word_offset),
            result,
            range
          ) {
            (state, expression) -> CheckedBodyExprBuilt(state, expression)
          }
          nil -> CheckedBodyExprRejected(
            state,
            CheckedBodyProducerInvalidRange
          )
        }
      } else {
        CheckedBodyExprRejected(
          state,
          expectation_mismatch(result, expectation)
        )
      }
    SemanticRecordFieldUnplaced(stable_key, exact_name, result) ->
      if expectation_allows(catalog, result, expectation) {
        match covering_range(state.range(checked_base), field_range) {
          range: CheckedSourceRange -> match state.structural_field_access(
            checked_base,
            stable_key,
            CheckedStructuralFieldUnplaced(exact_name),
            result,
            range
          ) {
            (state, expression) -> CheckedBodyExprBuilt(state, expression)
          }
          nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
        }
      } else {
        CheckedBodyExprRejected(state, expectation_mismatch(result, expectation))
      }
    SemanticRecordFieldMissing -> CheckedBodyExprRejected(
      state,
      CheckedBodyProducerUnknownField(field_range)
    )
    SemanticRecordFieldProjectionUnavailable -> {
      let applications = types.applications
      match semantic_declared_field_projection(
        applications,
        catalog,
        base_type,
        field_name
      ) {
        SemanticDeclaredFieldProjected(declaration, field_index, result) ->
          if expectation_allows(catalog, result, expectation) {
            match covering_range(state.range(checked_base), field_range) {
              range: CheckedSourceRange -> match state.declared_field_access(
                checked_base,
                declaration,
                field_index,
                result,
                range
              ) {
                (state, expression) -> CheckedBodyExprBuilt(state, expression)
              }
              nil -> CheckedBodyExprRejected(
                state,
                CheckedBodyProducerInvalidRange
              )
            }
          } else {
            CheckedBodyExprRejected(
              state,
              expectation_mismatch(result, expectation)
            )
          }
        SemanticDeclaredFieldMissing -> CheckedBodyExprRejected(
          state,
          CheckedBodyProducerUnknownField(field_range)
        )
        SemanticDeclaredFieldProjectionUnavailable -> CheckedBodyExprRejected(
          state,
          CheckedBodyProducerFieldProjectionUnavailable(base_type)
        )
      }
    }
  }
}

fn checked_body_record_declaration(
  source: Source,
  environment: CheckedLexicalEnvironment,
  type_start: i64,
  type_length: i64,
  construction: RecordConstruction
) -> Option<DeclarationIdentity> {
  match source_range(source, type_start, type_length) {
    nil -> None<DeclarationIdentity>()
    name_range: CheckedSourceRange -> match source.span(name_range.start, name_range.end) {
      None -> None<DeclarationIdentity>()
      Some(name) -> match record_construction_type(construction) {
        SourceAssociatedTypeExpr(
          NamedTypeExpr(_, _, _, SourceTypeOrigin(qualifier)),
          _,
          _,
        ) -> match source_range(source, qualifier.start, qualifier.length) {
          nil -> None<DeclarationIdentity>()
          qualifier_range: CheckedSourceRange -> match source.span(
            qualifier_range.start,
            qualifier_range.end
          ) {
            None -> None<DeclarationIdentity>()
            Some(prefix) -> match registration_scope_lookup_qualified_declaration_span(
              lexical_scope(environment),
              lexical_module(environment),
              prefix,
              TypeDeclaration,
              name
            ) {
              None -> None<DeclarationIdentity>()
              Some(declaration) -> Some<DeclarationIdentity>(declaration.identity)
            }
          }
        }
        _ -> match registration_scope_lookup_declaration_span(
          lexical_scope(environment),
          lexical_module(environment),
          TypeDeclaration,
          name
        ) {
          None -> None<DeclarationIdentity>()
          Some(declaration) -> Some<DeclarationIdentity>(declaration.identity)
        }
      }
    }
  }
}

fn checked_body_nominal_record_type(
  product: SemanticTypeProductBuilder,
  module: RegisteredModule,
  environment: CheckedLexicalEnvironment,
  template: SemanticTypeId,
  declaration: DeclarationIdentity,
  construction: RecordConstruction,
  expectation: CheckedBodyExpectation,
  name_range: CheckedSourceRange
) -> CheckedNominalRecordTypeResolution {
  match construction {
    ExplicitRecordType(authored_type, _) -> match resolve_type_product_in_scope(
      product,
      module,
      lexical_scope(environment),
      lexical_type_parameters(environment),
      authored_type
    ) {
      (product, SemanticTypeRejected(issue)) -> CheckedNominalRecordTypeRejected(
        CheckedBodyProducerTypeRejected(issue)
      )
      (product, SemanticTypeResolved(concrete)) -> {
        let catalog = semantic_type_product_catalog(product)
        match catalog.graph_for(concrete) {
          None -> CheckedNominalRecordTypeRejected(
            CheckedBodyProducerRecordTemplateUnavailable(declaration)
          )
          Some(graph) -> match semantic_type_graph_node(graph, concrete) {
            SemanticNamedNode(found, _, _, _) -> if declaration_identity_eq(
              found,
              declaration
            ) {
              CheckedNominalRecordTypeResolved(product, Some<SemanticTypeId>(concrete))
            } else {
              CheckedNominalRecordTypeRejected(
                CheckedBodyProducerUnknownRecordType(name_range)
              )
            }
            _ -> CheckedNominalRecordTypeRejected(
              CheckedBodyProducerUnknownRecordType(name_range)
            )
          }
        }
      }
    }
    InferredRecordType(_, _) -> {
      let catalog = semantic_type_product_catalog(product)
      let contextual = match expectation {
        CheckedInferResult -> None<SemanticTypeId>()
        CheckedRequireResult(expected) -> match catalog.graph_for(expected) {
          None -> None<SemanticTypeId>()
          Some(graph) -> match semantic_type_graph_node(graph, expected) {
            SemanticNamedNode(found, _, _, _) -> if declaration_identity_eq(found, declaration) {
              Some<SemanticTypeId>(expected)
            } else { None<SemanticTypeId>() }
            _ -> None<SemanticTypeId>()
          }
        }
      }
      match contextual {
        Some(_) -> CheckedNominalRecordTypeResolved(product, contextual)
        None -> match catalog.graph_for(template) {
          None -> CheckedNominalRecordTypeRejected(
            CheckedBodyProducerRecordTemplateUnavailable(declaration)
          )
          Some(graph) -> match semantic_type_graph_node(graph, template) {
            SemanticNamedNode(_, _, _, arguments) -> {
              let lists = semantic_type_graph_type_lists_local(graph)
              let concrete = if semantic_type_list_len(lists, arguments) == 0 {
                Some<SemanticTypeId>(template)
              } else { None<SemanticTypeId>() }
              CheckedNominalRecordTypeResolved(product, concrete)
            }
            _ -> CheckedNominalRecordTypeRejected(
              CheckedBodyProducerRecordTemplateUnavailable(declaration)
            )
          }
        }
      }
    }
  }
}

fn checked_body_nominal_record_materialize(
  types: CheckedBodyPrimitiveTypes,
  product: SemanticTypeProductBuilder,
  concrete: SemanticTypeId
) -> CheckedBodyPrimitiveTypes {
  let resolution = types.resolution
  let declarations = resolution.declarations()
  let effect_declarations = resolution.effects()
  let (product, applications, variants, effects) = semantic_applications_materialize_type(
    product,
    types.applications,
    types.variant_applications,
    types.effect_applications,
    declarations,
    effect_declarations,
    concrete
  )
  checked_body_types_with_applications(
    types,
    semantic_type_product_catalog(product),
    applications,
    variants,
    effects
  )
}

fn checked_body_nominal_record_infer(
  catalog: borrow SemanticTypeCatalog,
  declarations: borrow SemanticTypeDeclarationCatalog,
  layout: usize,
  names: List<str>,
  field_types: List<SemanticTypeId>,
  substitution: SemanticTypeSubstitution,
  range: CheckedSourceRange
) -> CheckedNominalRecordInference {
  match (names, field_types) {
    (Nil, Nil) -> CheckedNominalRecordInferred(substitution)
    (Cons(name, remaining_names), Cons(actual, remaining_types)) ->
      match semantic_type_declared_record_template_field(declarations, layout, name) {
        SemanticRecordTemplateFieldMissing -> CheckedNominalRecordInferenceRejected(
          CheckedBodyProducerUnknownField(range)
        )
        SemanticRecordTemplateFieldUnavailable -> CheckedNominalRecordInferenceRejected(
          CheckedBodyProducerFieldProjectionUnavailable(actual)
        )
        SemanticRecordTemplateFieldProjected(_, _, pattern) -> {
          let concrete_substitution = semantic_type_substitution_empty()
          let next = match semantic_type_pattern_match_substituted(
            catalog,
            pattern,
            substitution,
            actual,
            concrete_substitution
          ) {
            SemanticTypePatternMatched(matched) -> matched
            SemanticTypePatternRejected -> substitution
          }
          checked_body_nominal_record_infer(
            catalog,
            declarations,
            layout,
            remaining_names,
            remaining_types,
            next,
            range
          )
        }
      }
    _ -> CheckedNominalRecordInferenceRejected(CheckedBodyProducerInvalidRange)
  }
}

fn checked_body_nominal_record_arguments_bound(
  catalog: borrow SemanticTypeCatalog,
  template: SemanticTypeId,
  substitution: borrow SemanticTypeSubstitution
) -> bool {
  match catalog.graph_for(template) {
    None -> false
    Some(graph) -> match semantic_type_graph_node(graph, template) {
      SemanticNamedNode(_, _, _, arguments) -> {
        let lists = semantic_type_graph_type_lists_local(graph)
        let mut complete = true
        let mut index = __i64_to_usize(0)
        while index < semantic_type_list_len(lists, arguments) {
          let argument = semantic_type_graph_list_type_id(
            graph,
            semantic_type_list_edge(lists, arguments, index)
          )
          let argument_graph = match catalog.graph_for(argument) {
            Some(value) -> value
            None -> panic("Record template argument has no graph")
          }
          match semantic_type_graph_node(argument_graph, argument) {
            SemanticVariableNode(variable) -> match semantic_type_substitution_get(
              substitution,
              variable
            ) {
              Some(_) -> nil
              None -> { complete = false }
            }
            _ -> nil
          }
          index = index + 1
        }
        complete
      }
      _ -> false
    }
  }
}

fn checked_body_nominal_record_validate(
  applications: borrow SemanticRecordApplicationCatalog,
  catalog: borrow SemanticTypeCatalog,
  declarations: borrow SemanticTypeDeclarationCatalog,
  declaration: DeclarationIdentity,
  layout: usize,
  count: usize,
  concrete: SemanticTypeId,
  names: List<str>,
  values: List<SemanticTypeId>,
  range: CheckedSourceRange
) -[SemanticConformance]> Option<CheckedBodyProducerIssue> {
  match (names, values) {
    (Nil, Nil) -> if count == 0 { None<CheckedBodyProducerIssue>() }
    else {
      Some<CheckedBodyProducerIssue>(CheckedBodyProducerMissingRecordField(declaration))
    }
    (Cons(name, remaining_names), Cons(actual, remaining_values)) ->
      match semantic_type_declared_record_template_field(declarations, layout, name) {
        SemanticRecordTemplateFieldMissing -> Some<CheckedBodyProducerIssue>(
          CheckedBodyProducerUnknownField(range)
        )
        SemanticRecordTemplateFieldUnavailable -> Some<CheckedBodyProducerIssue>(
          CheckedBodyProducerRecordTemplateUnavailable(declaration)
        )
        SemanticRecordTemplateFieldProjected(_, _, _) ->
          match semantic_declared_field_projection(applications, catalog, concrete, name) {
            SemanticDeclaredFieldProjected(_, _, expected) -> if semantic_type_is_subtype(
              catalog,
              actual,
              expected
            ) {
              checked_body_nominal_record_validate(
                applications,
                catalog,
                declarations,
                declaration,
                layout,
                count - 1,
                concrete,
                remaining_names,
                remaining_values,
                range
              )
            } else {
              Some<CheckedBodyProducerIssue>(CheckedBodyProducerTypeMismatch(actual, expected))
            }
            SemanticDeclaredFieldMissing -> Some<CheckedBodyProducerIssue>(
              CheckedBodyProducerUnknownField(range)
            )
            SemanticDeclaredFieldProjectionUnavailable -> Some<CheckedBodyProducerIssue>(
              CheckedBodyProducerFieldProjectionUnavailable(concrete)
            )
          }
      }
    _ -> Some<CheckedBodyProducerIssue>(CheckedBodyProducerInvalidRange)
  }
}

fn checked_body_publish_nominal_fields(
  expressions: owned CheckedExprGraphBuilder,
  list: CheckedRecordFieldListBuilder,
  applications: borrow SemanticRecordApplicationCatalog,
  catalog: borrow SemanticTypeCatalog,
  concrete: SemanticTypeId,
  names: List<str>,
  values: List<CheckedExprId>
) -> (owned CheckedExprGraphBuilder, CheckedRecordFieldListId) {
  match (names, values) {
    (Nil, Nil) -> expressions.finish_record_field_list(list)
    (Cons(name, remaining_names), Cons(value, remaining_values)) ->
      match semantic_declared_field_projection(applications, catalog, concrete, name) {
        SemanticDeclaredFieldProjected(declaration, ordinal, value_type) -> {
          let (expressions, list) = expressions.declared_record_field(
            list,
            declaration,
            value,
            ordinal,
            value_type
          )
          checked_body_publish_nominal_fields(
            expressions,
            list,
            applications,
            catalog,
            concrete,
            remaining_names,
            remaining_values
          )
        }
        _ -> panic("Validated nominal record field disappeared before freeze")
      }
    _ -> panic("Nominal record field names and values diverged")
  }
}

fn checked_body_record_field_expectation(
  catalog: SemanticTypeCatalog,
  applications: SemanticRecordApplicationCatalog,
  expectation: CheckedBodyExpectation,
  shape: CheckedBodyRecordShape,
  index: usize,
  name: str
) -> CheckedBodyExpectation {
  match expectation {
    CheckedInferResult -> CheckedInferResult
    CheckedRequireResult(expected) -> match shape {
      CheckedTupleRecordShape -> match semantic_tuple_pattern_element(catalog, expected, index) {
        Some(field_type) -> CheckedRequireResult(field_type)
        None -> CheckedInferResult
      }
      CheckedStructuralRecordShape -> match semantic_record_field_projection(
        catalog,
        expected,
        name
      ) {
        SemanticRecordFieldProjected(_, _, field_type) -> CheckedRequireResult(field_type)
        SemanticRecordFieldUnplaced(_, _, field_type) -> CheckedRequireResult(field_type)
        _ -> CheckedInferResult
      }
      CheckedNominalRecordShape(candidate) -> match candidate {
        None -> CheckedInferResult
        Some(concrete) -> match semantic_declared_field_projection(
          applications,
          catalog,
          concrete,
          name
        ) {
          SemanticDeclaredFieldProjected(_, _, field_type) -> CheckedRequireResult(field_type)
          _ -> CheckedInferResult
        }
      }
    }
  }
}

fn checked_body_record_values(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  fields: RecordFieldList,
  shape: CheckedBodyRecordShape,
  index: usize,
  names: List<str>,
  values: List<CheckedExprId>,
  field_types: List<SemanticTypeId>,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyRecordValuesBuild {
  match fields {
    RecordFieldListNil -> CheckedBodyRecordValuesBuilt(
      state,
      names.reverse(),
      values.reverse(),
      field_types.reverse()
    )
    RecordFieldListCons(field, rest) -> match field {
      UnknownRecordField(_) -> CheckedBodyRecordValuesRejected(
        state,
        CheckedBodyProducerUnsupportedExpression
      )
      RecordField(name_start, name_length, authored_value, _) -> {
        let name_range: CheckedSourceRange? = match shape {
          CheckedTupleRecordShape -> CheckedSourceRange { start: 0, end: 0 }
          CheckedStructuralRecordShape -> source_range(source, name_start, name_length)
          CheckedNominalRecordShape(_) -> source_range(source, name_start, name_length)
        }
        match name_range {
          nil -> CheckedBodyRecordValuesRejected(state, CheckedBodyProducerInvalidRange)
          range: CheckedSourceRange -> {
            let name = match shape {
              CheckedTupleRecordShape -> Some<str>("")
              CheckedStructuralRecordShape -> match source.span(range.start, range.end) {
                Some(span) -> span.text()
                None -> None<str>()
              }
              CheckedNominalRecordShape(_) -> match source.span(range.start, range.end) {
                Some(span) -> span.text()
                None -> None<str>()
              }
            }
            match name {
              None -> CheckedBodyRecordValuesRejected(state, CheckedBodyProducerInvalidRange)
              Some(field_name) -> if match shape {
                CheckedTupleRecordShape -> false
                CheckedStructuralRecordShape -> checked_body_record_name_seen(names, field_name)
                CheckedNominalRecordShape(_) -> checked_body_record_name_seen(names, field_name)
              } {
                CheckedBodyRecordValuesRejected(
                  state,
                  CheckedBodyProducerDuplicateRecordField(range)
                )
              } else {
                let catalog = state.types()
                let field_expectation = checked_body_record_field_expectation(
                  catalog,
                  types.applications,
                  expectation,
                  shape,
                  index,
                  field_name
                )
                match checked_body_expr(
                  state,
                  source,
                  checked_body_types_with_catalog(types, catalog),
                  owner,
                  function_result,
                  loop_context,
                  environment,
                  authored_value,
                  field_expectation
                ) {
                  CheckedBodyExprRejected(state, issue) -> CheckedBodyRecordValuesRejected(
                    state,
                    issue
                  )
                  CheckedBodyExprBuilt(state, value) -> {
                    let value_type = state.result_type(value)
                    checked_body_record_values(
                      state,
                      source,
                      types,
                      owner,
                      function_result,
                      loop_context,
                      environment,
                      rest,
                      shape,
                      index + 1,
                      match shape {
                        CheckedTupleRecordShape -> names
                        CheckedStructuralRecordShape -> names.prepend(field_name)
                        CheckedNominalRecordShape(_) -> names.prepend(field_name)
                      },
                      values.prepend(value),
                      field_types.prepend(value_type),
                      expectation
                    )
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

fn checked_body_record_layout_key(
  layout: List<SemanticRecordLayoutField>,
  index: usize
) -> i64 {
  match layout {
    Nil -> panic("Closed record layout lost an authored field")
    Cons(field, rest) -> match field {
      SemanticRecordLayoutField(key, source_index, _) -> if source_index == index { key }
      else { checked_body_record_layout_key(rest, index) }
    }
  }
}

fn checked_body_publish_record_fields(
  expressions: owned CheckedExprGraphBuilder,
  list: CheckedRecordFieldListBuilder,
  layout: List<SemanticRecordLayoutField>,
  values: List<CheckedExprId>,
  types: List<SemanticTypeId>,
  index: usize,
  shape: CheckedBodyRecordShape
) -> (owned CheckedExprGraphBuilder, CheckedRecordFieldListId) {
  match (values, types) {
    (Nil, Nil) -> expressions.finish_record_field_list(list)
    (Cons(value, remaining_values), Cons(value_type, remaining_types)) -> {
      let (expressions, list) = match shape {
        CheckedTupleRecordShape -> expressions.positional_record_field(
          list,
          index,
          value,
          value_type
        )
        CheckedStructuralRecordShape -> expressions.structural_record_field(
          list,
          checked_body_record_layout_key(layout, index),
          value,
          CheckedRecordFieldOrdinal(index),
          value_type
        )
        CheckedNominalRecordShape(_) -> panic("Nominal field used structural publisher")
      }
      checked_body_publish_record_fields(
        expressions,
        list,
        layout,
        remaining_values,
        remaining_types,
        index + 1,
        shape
      )
    }
    _ -> panic("Checked record values and types diverged")
  }
}

fn checked_body_record_literal(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  fields: RecordFieldList,
  shape: CheckedBodyRecordShape,
  authored_range: RecordSourceRange,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  if authored_range.end <= authored_range.start {
    CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
  } else {
    match source_range(source, authored_range.start, authored_range.end - authored_range.start) {
      nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
      range: CheckedSourceRange -> match checked_body_record_values(
        state,
        source,
        types,
        owner,
        function_result,
        loop_context,
        environment,
        fields,
        shape,
        0,
        Nil<str>(),
        Nil<CheckedExprId>(),
        Nil<SemanticTypeId>(),
        expectation
      ) {
        CheckedBodyRecordValuesRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
        CheckedBodyRecordValuesBuilt(state, names, values, field_types) -> {
          let catalog = state.types()
          let module = types.module
          let resolution = types.resolution
          let segment = semantic_type_derived_segment_id(
            module.identity,
            catalog.next_derived_segment(module.identity, resolution.next_type_segment())
          )
          let builder = semantic_type_graph_builder(segment)
          let (builder, result) = match shape {
            CheckedTupleRecordShape -> builder.tuple(field_types)
            CheckedStructuralRecordShape -> builder.record(
              names,
              field_types,
              SemanticClosedRecord
            )
            CheckedNominalRecordShape(_) -> panic("Nominal record used structural constructor")
          }
          let catalog = semantic_type_catalog_with_graph(catalog, builder.freeze())
          if not expectation_allows(catalog, result, expectation) {
            CheckedBodyExprRejected(state, expectation_mismatch(result, expectation))
          } else {
            let layout = match shape {
              CheckedTupleRecordShape -> Nil<SemanticRecordLayoutField>()
              CheckedStructuralRecordShape -> match semantic_record_layout_fields(catalog, result) {
                Some(fields) -> fields
                None -> panic("Closed structural record has no semantic layout")
              }
              CheckedNominalRecordShape(_) -> panic("Nominal record used structural layout")
            }
            let construction = match shape {
              CheckedTupleRecordShape -> CheckedTupleRecordConstruction
              CheckedStructuralRecordShape -> CheckedStructuralRecordConstruction
              CheckedNominalRecordShape(_) -> panic("Nominal record used structural construction")
            }
            match state.with_types(catalog) {
              CheckedBodyBuild(storage) -> {
                let { signatures, expressions, patterns, closures, effects, propagation } = storage
                let (expressions, list) = expressions.record_field_list()
                let (expressions, checked_fields) = checked_body_publish_record_fields(
                  expressions,
                  list,
                  layout,
                  values,
                  field_types,
                  0,
                  shape
                )
                match expressions.record_init(construction, checked_fields, result, range) {
                  (expressions, expression) -> CheckedBodyExprBuilt(
                    CheckedBodyBuild(
                      CheckedBodyBuildStorage {
                        signatures: signatures,
                        expressions: expressions,
                        patterns: patterns,
                        closures: closures,
                        effects: effects,
                        propagation: propagation
                      }
                    ),
                    expression
                  )
                }
              }
            }
          }
        }
      }
    }
  }
}

fn checked_body_update_field_type(
  names: List<str>,
  types: List<SemanticTypeId>,
  wanted: str,
  fallback: SemanticTypeId
) -> SemanticTypeId {
  match (names, types) {
    (Nil, Nil) -> fallback
    (Cons(name, remaining_names), Cons(field_type, remaining_types)) -> if name == wanted {
      field_type
    } else {
      checked_body_update_field_type(remaining_names, remaining_types, wanted, fallback)
    }
    _ -> panic("Record update names and types diverged")
  }
}

fn checked_body_update_extension_fields(
  base_names: List<str>,
  names: List<str>,
  types: List<SemanticTypeId>
) -> (List<str>, List<SemanticTypeId>) {
  match (names, types) {
    (Nil, Nil) -> (Nil<str>(), Nil<SemanticTypeId>())
    (Cons(name, remaining_names), Cons(field_type, remaining_types)) -> {
      let (suffix_names, suffix_types) = checked_body_update_extension_fields(
        base_names,
        remaining_names,
        remaining_types
      )
      if checked_body_record_name_seen(base_names, name) {
        (suffix_names, suffix_types)
      } else {
        (Cons<str>(name, suffix_names), Cons<SemanticTypeId>(field_type, suffix_types))
      }
    }
    _ -> panic("Record update names and types diverged")
  }
}

fn checked_body_update_base_fields(
  base_names: List<str>,
  base_types: List<SemanticTypeId>,
  update_names: List<str>,
  update_types: List<SemanticTypeId>,
  extension_names: List<str>,
  extension_types: List<SemanticTypeId>
) -> (List<str>, List<SemanticTypeId>) {
  match (base_names, base_types) {
    (Nil, Nil) -> (extension_names, extension_types)
    (Cons(name, remaining_names), Cons(field_type, remaining_types)) -> {
      let replacement = checked_body_update_field_type(
        update_names,
        update_types,
        name,
        field_type
      )
      let (suffix_names, suffix_types) = checked_body_update_base_fields(
        remaining_names,
        remaining_types,
        update_names,
        update_types,
        extension_names,
        extension_types
      )
      (Cons<str>(name, suffix_names), Cons<SemanticTypeId>(replacement, suffix_types))
    }
    _ -> panic("Structural record names and types diverged")
  }
}

fn checked_body_updated_record_fields(
  base_names: List<str>,
  base_types: List<SemanticTypeId>,
  update_names: List<str>,
  update_types: List<SemanticTypeId>
) -> (List<str>, List<SemanticTypeId>) {
  let (extension_names, extension_types) = checked_body_update_extension_fields(
    base_names,
    update_names,
    update_types
  )
  checked_body_update_base_fields(
    base_names,
    base_types,
    update_names,
    update_types,
    extension_names,
    extension_types
  )
}

fn checked_body_record_source_index(
  names: List<str>,
  wanted: str,
  index: usize
) -> usize {
  match names {
    Nil -> panic("Validated update field is absent from the result record")
    Cons(name, remaining) -> if name == wanted { index }
    else { checked_body_record_source_index(remaining, wanted, index + 1) }
  }
}

fn checked_body_publish_structural_update_fields(
  expressions: owned CheckedExprGraphBuilder,
  list: CheckedRecordFieldListBuilder,
  layout: List<SemanticRecordLayoutField>,
  result_names: List<str>,
  names: List<str>,
  values: List<CheckedExprId>,
  types: List<SemanticTypeId>
) -> (owned CheckedExprGraphBuilder, CheckedRecordFieldListId) {
  match (names, values, types) {
    (Nil, Nil, Nil) -> expressions.finish_record_field_list(list)
    (
      Cons(name, remaining_names),
      Cons(value, remaining_values),
      Cons(value_type, remaining_types),
    ) -> {
      let index = checked_body_record_source_index(result_names, name, 0)
      let (expressions, list) = expressions.structural_record_field(
        list,
        checked_body_record_layout_key(layout, index),
        value,
        CheckedRecordFieldOrdinal(index),
        value_type
      )
      checked_body_publish_structural_update_fields(
        expressions,
        list,
        layout,
        result_names,
        remaining_names,
        remaining_values,
        remaining_types
      )
    }
    _ -> panic("Structural record update fields diverged")
  }
}

fn checked_body_nominal_update_validate(
  applications: borrow SemanticRecordApplicationCatalog,
  catalog: borrow SemanticTypeCatalog,
  base: SemanticTypeId,
  names: List<str>,
  types: List<SemanticTypeId>,
  range: CheckedSourceRange
) -[SemanticConformance]> Option<CheckedBodyProducerIssue> {
  match (names, types) {
    (Nil, Nil) -> None<CheckedBodyProducerIssue>()
    (Cons(name, remaining_names), Cons(actual, remaining_types)) ->
      match semantic_declared_field_projection(applications, catalog, base, name) {
        SemanticDeclaredFieldProjected(_, _, expected) -> if semantic_type_is_subtype(
          catalog,
          actual,
          expected
        ) {
          checked_body_nominal_update_validate(
            applications,
            catalog,
            base,
            remaining_names,
            remaining_types,
            range
          )
        } else {
          Some<CheckedBodyProducerIssue>(CheckedBodyProducerTypeMismatch(actual, expected))
        }
        SemanticDeclaredFieldMissing -> Some<CheckedBodyProducerIssue>(
          CheckedBodyProducerUnknownField(range)
        )
        SemanticDeclaredFieldProjectionUnavailable -> Some<CheckedBodyProducerIssue>(
          CheckedBodyProducerFieldProjectionUnavailable(base)
        )
      }
    _ -> Some<CheckedBodyProducerIssue>(CheckedBodyProducerInvalidRange)
  }
}

fn checked_body_nominal_record_update(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  base: CheckedExprId,
  base_type: SemanticTypeId,
  fields: RecordFieldList,
  range: CheckedSourceRange,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  let catalog = state.types()
  if not expectation_allows(catalog, base_type, expectation) {
    CheckedBodyExprRejected(state, expectation_mismatch(base_type, expectation))
  } else {
    let resolution = types.resolution
    let product = semantic_type_product_continue(
      types.module.identity,
      catalog,
      catalog.next_derived_segment(types.module.identity, resolution.next_type_segment())
    )
    let ready_types = checked_body_nominal_record_materialize(
      checked_body_types_with_catalog(types, catalog),
      product,
      base_type
    )
    let state = state.with_types(ready_types.catalog)
    match checked_body_record_values(
      state,
      source,
      ready_types,
      owner,
      function_result,
      loop_context,
      environment,
      fields,
      CheckedNominalRecordShape(Some<SemanticTypeId>(base_type)),
      0,
      Nil<str>(),
      Nil<CheckedExprId>(),
      Nil<SemanticTypeId>(),
      CheckedRequireResult(base_type)
    ) {
      CheckedBodyRecordValuesRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
      CheckedBodyRecordValuesBuilt(state, names, values, field_types) -> {
        let catalog = state.types()
        let applications = ready_types.applications
        match checked_body_nominal_update_validate(
          applications,
          catalog,
          base_type,
          names,
          field_types,
          range
        ) {
          Some(issue) -> CheckedBodyExprRejected(state, issue)
          None -> match state {
            CheckedBodyBuild(storage) -> {
              let { signatures, expressions, patterns, closures, effects, propagation } = storage
              let (expressions, list) = expressions.record_field_list()
              let (expressions, checked_fields) = checked_body_publish_nominal_fields(
                expressions,
                list,
                applications,
                catalog,
                base_type,
                names,
                values
              )
              match expressions.record_update(base, checked_fields, base_type, range) {
                (expressions, expression) -> CheckedBodyExprBuilt(
                  CheckedBodyBuild(
                    CheckedBodyBuildStorage {
                      signatures: signatures,
                      expressions: expressions,
                      patterns: patterns,
                      closures: closures,
                      effects: effects,
                      propagation: propagation
                    }
                  ),
                  expression
                )
              }
            }
          }
        }
      }
    }
  }
}

fn checked_body_structural_record_update(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  base: CheckedExprId,
  fields: RecordFieldList,
  base_fields: SemanticStructuralRecordFields,
  range: CheckedSourceRange,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  match checked_body_record_values(
    state,
    source,
    types,
    owner,
    function_result,
    loop_context,
    environment,
    fields,
    CheckedStructuralRecordShape,
    0,
    Nil<str>(),
    Nil<CheckedExprId>(),
    Nil<SemanticTypeId>(),
    CheckedInferResult
  ) {
    CheckedBodyRecordValuesRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
    CheckedBodyRecordValuesBuilt(state, names, values, field_types) -> {
      let (result_names, result_types) = match base_fields {
        SemanticStructuralRecordFields(base_names, base_types) ->
          checked_body_updated_record_fields(
            base_names,
            base_types,
            names,
            field_types
          )
      }
      let catalog = state.types()
      let resolution = types.resolution
      let segment = semantic_type_derived_segment_id(
        types.module.identity,
        catalog.next_derived_segment(types.module.identity, resolution.next_type_segment())
      )
      let builder = semantic_type_graph_builder(segment)
      let (builder, result) = builder.record(result_names, result_types, SemanticClosedRecord)
      let catalog = semantic_type_catalog_with_graph(catalog, builder.freeze())
      if not expectation_allows(catalog, result, expectation) {
        CheckedBodyExprRejected(state, expectation_mismatch(result, expectation))
      } else {
        let layout = match semantic_record_layout_fields(catalog, result) {
          Some(value) -> value
          None -> panic("Closed structural update has no semantic layout")
        }
        match state.with_types(catalog) {
          CheckedBodyBuild(storage) -> {
            let { signatures, expressions, patterns, closures, effects, propagation } = storage
            let (expressions, list) = expressions.record_field_list()
            let (expressions, checked_fields) = checked_body_publish_structural_update_fields(
              expressions,
              list,
              layout,
              result_names,
              names,
              values,
              field_types
            )
            match expressions.record_update(base, checked_fields, result, range) {
              (expressions, expression) -> CheckedBodyExprBuilt(
                CheckedBodyBuild(
                  CheckedBodyBuildStorage {
                    signatures: signatures,
                    expressions: expressions,
                    patterns: patterns,
                    closures: closures,
                    effects: effects,
                    propagation: propagation
                  }
                ),
                expression
              )
            }
          }
        }
      }
    }
  }
}

fn checked_body_record_update(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  base: Expr,
  fields: RecordFieldList,
  authored_range: RecordSourceRange,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  if authored_range.end <= authored_range.start {
    CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
  } else {
    match source_range(source, authored_range.start, authored_range.end - authored_range.start) {
      nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
      suffix_range: CheckedSourceRange -> match checked_body_expr(
        state,
        source,
        types,
        owner,
        function_result,
        loop_context,
        environment,
        base,
        CheckedInferResult
      ) {
        CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
        CheckedBodyExprBuilt(state, checked_base) -> match covering_range(
          state.range(checked_base),
          suffix_range
        ) {
          nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
          range: CheckedSourceRange -> {
            let base_type = state.result_type(checked_base)
            let catalog = state.types()
            let resolution = types.resolution
            let declarations = resolution.declarations()
            let declaration = match catalog.graph_for(base_type) {
              None -> None<DeclarationIdentity>()
              Some(graph) -> match semantic_type_graph_node(graph, base_type) {
                SemanticNamedNode(found, _, _, _) -> Some<DeclarationIdentity>(found)
                _ -> None<DeclarationIdentity>()
              }
            }
            match declaration {
              Some(found) -> match semantic_type_declared_record_template(
                catalog,
                declarations,
                found
              ) {
                SemanticRecordDeclarationTemplateSelected(_, _, _) ->
                  checked_body_nominal_record_update(
                    state,
                    source,
                    types,
                    owner,
                    function_result,
                    loop_context,
                    environment,
                    checked_base,
                    base_type,
                    fields,
                    range,
                    expectation
                  )
                _ -> CheckedBodyExprRejected(
                  state,
                  CheckedBodyProducerRecordUpdateRequired(base_type)
                )
              }
              None -> match semantic_structural_record_source_fields(catalog, base_type) {
                Some(base_fields) -> checked_body_structural_record_update(
                  state,
                  source,
                  types,
                  owner,
                  function_result,
                  loop_context,
                  environment,
                  checked_base,
                  fields,
                  base_fields,
                  range,
                  expectation
                )
                None -> CheckedBodyExprRejected(
                  state,
                  CheckedBodyProducerRecordUpdateRequired(base_type)
                )
              }
            }
          }
        }
      }
    }
  }
}

fn checked_body_nominal_record_prepare(
  state: borrow CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  environment: CheckedLexicalEnvironment,
  type_start: i64,
  type_length: i64,
  construction: RecordConstruction,
  expectation: CheckedBodyExpectation
) -> CheckedNominalRecordPreparation {
  match source_range(source, type_start, type_length) {
    nil -> CheckedNominalRecordPreparationRejected(CheckedBodyProducerInvalidRange)
    name_range: CheckedSourceRange -> {
      let authored_range = record_construction_range(construction)
      match source_range(
        source,
        authored_range.start,
        authored_range.end - authored_range.start
      ) {
        nil -> CheckedNominalRecordPreparationRejected(CheckedBodyProducerInvalidRange)
        range: CheckedSourceRange -> match checked_body_record_declaration(
          source,
          environment,
          type_start,
          type_length,
          construction
        ) {
          None -> CheckedNominalRecordPreparationRejected(
            CheckedBodyProducerUnknownRecordType(name_range)
          )
          Some(declaration) -> {
            let resolution = types.resolution
            let declarations = resolution.declarations()
            let initial_catalog = state.types()
            match semantic_type_declared_record_template(
              initial_catalog,
              declarations,
              declaration
            ) {
              SemanticRecordDeclarationTemplateMissing ->
                CheckedNominalRecordPreparationRejected(
                  CheckedBodyProducerNotRecordType(declaration)
                )
              SemanticRecordDeclarationTemplateAmbiguous ->
                CheckedNominalRecordPreparationRejected(
                  CheckedBodyProducerRecordTemplateAmbiguous(declaration)
                )
              SemanticRecordDeclarationTemplateSelected(template, layout, field_count) -> {
                let product = semantic_type_product_continue(
                  types.module.identity,
                  initial_catalog,
                  initial_catalog.next_derived_segment(
                    types.module.identity,
                    resolution.next_type_segment()
                  )
                )
                match checked_body_nominal_record_type(
                  product,
                  types.module,
                  environment,
                  template,
                  declaration,
                  construction,
                  expectation,
                  name_range
                ) {
                  CheckedNominalRecordTypeRejected(issue) ->
                    CheckedNominalRecordPreparationRejected(issue)
                  CheckedNominalRecordTypeResolved(product, candidate) -> {
                    let ready_types = match candidate {
                      None -> checked_body_types_with_catalog(
                        types,
                        semantic_type_product_catalog(product)
                      )
                      Some(concrete) -> checked_body_nominal_record_materialize(
                        types,
                        product,
                        concrete
                      )
                    }
                    CheckedNominalRecordPrepared(
                      range,
                      declaration,
                      template,
                      layout,
                      field_count,
                      candidate,
                      ready_types
                    )
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

fn checked_body_nominal_record_bound_at(
  product: SemanticTypeProductBuilder,
  types: CheckedBodyPrimitiveTypes,
  declarations: borrow SemanticTypeDeclarationCatalog,
  declaration: DeclarationIdentity,
  concrete: SemanticTypeId,
  layout: usize,
  substitution: borrow SemanticTypeSubstitution,
  index: usize,
  count: usize
) -[SemanticConformance]> CheckedNominalRecordResolution {
  if index >= count {
    CheckedNominalRecordResolved(
      concrete,
      checked_body_types_with_catalog(types, semantic_type_product_catalog(product))
    )
  } else {
    match (
      semantic_type_declared_record_bound_variable(declarations, layout, index),
      semantic_type_declared_record_bound_type(declarations, layout, index),
    ) {
      (Some(variable), Some(trait_template)) -> match semantic_type_substitution_get(
        substitution,
        variable
      ) {
        None -> CheckedNominalRecordResolutionRejected(
          CheckedBodyProducerRecordArgumentsUnresolved(declaration)
        )
        Some(argument) -> {
          let (product, trait_atom) = semantic_type_product_substitute(
            product,
            substitution,
            trait_template
          )
          let catalog = semantic_type_product_catalog(product)
          if semantic_type_is_subtype(catalog, argument, trait_atom) {
            checked_body_nominal_record_bound_at(
              product,
              types,
              declarations,
              declaration,
              concrete,
              layout,
              substitution,
              index + 1,
              count
            )
          } else {
            CheckedNominalRecordResolutionRejected(
              CheckedBodyProducerGenericBoundRejected(argument, trait_atom)
            )
          }
        }
      }
      _ -> CheckedNominalRecordResolutionRejected(
        CheckedBodyProducerRecordTemplateUnavailable(declaration)
      )
    }
  }
}

fn checked_body_nominal_record_bounds(
  types: CheckedBodyPrimitiveTypes,
  declaration: DeclarationIdentity,
  template: SemanticTypeId,
  layout: usize,
  concrete: SemanticTypeId
) -[SemanticConformance]> CheckedNominalRecordResolution {
  let resolution = types.resolution
  let declarations = resolution.declarations()
  let catalog = types.catalog
  match semantic_type_declared_record_bound_count(declarations, layout) {
    None -> CheckedNominalRecordResolutionRejected(
      CheckedBodyProducerRecordTemplateUnavailable(declaration)
    )
    Some(count) -> if count == 0 { CheckedNominalRecordResolved(concrete, types) }
    else {
      let pattern_substitution = semantic_type_substitution_empty()
      let concrete_substitution = semantic_type_substitution_empty()
      match semantic_type_pattern_match_substituted(
        catalog,
        template,
        pattern_substitution,
        concrete,
        concrete_substitution
      ) {
        SemanticTypePatternRejected -> CheckedNominalRecordResolutionRejected(
          CheckedBodyProducerRecordTemplateUnavailable(declaration)
        )
        SemanticTypePatternMatched(substitution) -> {
          let product = semantic_type_product_continue(
            types.module.identity,
            catalog,
            catalog.next_derived_segment(types.module.identity, resolution.next_type_segment())
          )
          checked_body_nominal_record_bound_at(
            product,
            types,
            declarations,
            declaration,
            concrete,
            layout,
            substitution,
            0,
            count
          )
        }
      }
    }
  }
}

fn checked_body_nominal_record_resolve(
  catalog: SemanticTypeCatalog,
  types: CheckedBodyPrimitiveTypes,
  declaration: DeclarationIdentity,
  template: SemanticTypeId,
  layout: usize,
  candidate: Option<SemanticTypeId>,
  names: List<str>,
  field_types: List<SemanticTypeId>,
  range: CheckedSourceRange
) -[SemanticConformance]> CheckedNominalRecordResolution {
  match candidate {
    Some(concrete) -> checked_body_nominal_record_bounds(
      checked_body_types_with_catalog(types, catalog),
      declaration,
      template,
      layout,
      concrete,
    )
    None -> {
      let resolution = types.resolution
      let declarations = resolution.declarations()
      match checked_body_nominal_record_infer(
        catalog,
        declarations,
        layout,
        names,
        field_types,
        semantic_type_substitution_empty(),
        range
      ) {
        CheckedNominalRecordInferenceRejected(issue) ->
          CheckedNominalRecordResolutionRejected(issue)
        CheckedNominalRecordInferred(substitution) ->
          if not
          checked_body_nominal_record_arguments_bound(catalog, template, substitution) {
            CheckedNominalRecordResolutionRejected(
              CheckedBodyProducerRecordArgumentsUnresolved(declaration)
            )
          } else {
            let product = semantic_type_product_continue(
              types.module.identity,
              catalog,
              catalog.next_derived_segment(types.module.identity, resolution.next_type_segment())
            )
            let (product, concrete) = semantic_type_product_substitute(
              product,
              substitution,
              template
            )
            checked_body_nominal_record_bounds(
              checked_body_nominal_record_materialize(types, product, concrete),
              declaration,
              template,
              layout,
              concrete
            )
          }
      }
    }
  }
}

fn checked_body_nominal_record_literal(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  type_start: i64,
  type_length: i64,
  fields: RecordFieldList,
  construction: RecordConstruction,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  match checked_body_nominal_record_prepare(
    state,
    source,
    types,
    environment,
    type_start,
    type_length,
    construction,
    expectation
  ) {
    CheckedNominalRecordPreparationRejected(issue) -> CheckedBodyExprRejected(state, issue)
    CheckedNominalRecordPrepared(
      range,
      declaration,
      template,
      layout,
      field_count,
      candidate,
      ready_types,
    ) -> {
      let state = state.with_types(ready_types.catalog)
      match checked_body_record_values(
        state,
        source,
        ready_types,
        owner,
        function_result,
        loop_context,
        environment,
        fields,
        CheckedNominalRecordShape(candidate),
        0,
        Nil<str>(),
        Nil<CheckedExprId>(),
        Nil<SemanticTypeId>(),
        expectation
      ) {
        CheckedBodyRecordValuesRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
        CheckedBodyRecordValuesBuilt(state, names, values, field_types) -> if names.len() !=
          field_count {
            CheckedBodyExprRejected(state, CheckedBodyProducerMissingRecordField(declaration))
          } else {
            match checked_body_nominal_record_resolve(
              state.types(),
              ready_types,
              declaration,
              template,
              layout,
              candidate,
              names,
              field_types,
              range
            ) {
              CheckedNominalRecordResolutionRejected(issue) -> CheckedBodyExprRejected(
                state,
                issue
              )
              CheckedNominalRecordResolved(concrete, final_types) -> {
                let catalog = final_types.catalog
                let applications = final_types.applications
                if not expectation_allows(catalog, concrete, expectation) {
                  CheckedBodyExprRejected(state, expectation_mismatch(concrete, expectation))
                } else {
                  let resolution = types.resolution
                  let declarations = resolution.declarations()
                  match checked_body_nominal_record_validate(
                    applications,
                    catalog,
                    declarations,
                    declaration,
                    layout,
                    field_count,
                    concrete,
                    names,
                    field_types,
                    range
                  ) {
                    Some(issue) -> CheckedBodyExprRejected(state, issue)
                    None -> match state.with_types(catalog) {
                      CheckedBodyBuild(storage) -> {
                        let { signatures, expressions, patterns, closures, effects, propagation } = storage
                        let (expressions, list) = expressions.record_field_list()
                        let (expressions, checked_fields) = checked_body_publish_nominal_fields(
                          expressions,
                          list,
                          applications,
                          catalog,
                          concrete,
                          names,
                          values
                        )
                        match expressions.record_init(
                          CheckedDeclaredRecordConstruction(declaration),
                          checked_fields,
                          concrete,
                          range
                        ) {
                          (expressions, expression) -> CheckedBodyExprBuilt(
                            CheckedBodyBuild(
                              CheckedBodyBuildStorage {
                                signatures: signatures,
                                expressions: expressions,
                                patterns: patterns,
                                closures: closures,
                                effects: effects,
                                propagation: propagation
                              }
                            ),
                            expression
                          )
                        }
                      }
                    }
                  }
                }
              }
            }
          }
      }
    }
  }
}

fn checked_body_array_elements(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  authored: ExprList,
  element_type: Option<SemanticTypeId>,
  values: List<CheckedExprId>,
  element_types: List<SemanticTypeId>,
  range: CheckedSourceRange
) -[SemanticConformance]> CheckedBodyArrayElementsBuild {
  match authored {
    ExprListNil -> CheckedBodyArrayElementsBuilt(state, values, element_types, range)
    ExprListCons(element, rest) -> {
      let expectation = match element_type {
        Some(expected) -> CheckedRequireResult(expected)
        None -> CheckedInferResult
      }
      let catalog = state.types()
      match checked_body_expr(
        state,
        source,
        checked_body_types_with_catalog(types, catalog),
        owner,
        function_result,
        loop_context,
        environment,
        element,
        expectation
      ) {
        CheckedBodyExprBuilt(state, checked_element) -> {
          let actual = state.result_type(checked_element)
          let element_range = state.range(checked_element)
          let catalog = state.types()
          if semantic_continuation_type(catalog, actual) {
            CheckedBodyArrayElementsRejected(
              state,
              CheckedBodyProducerContinuationConsumerRequired(element_range)
            )
          } else {
            match covering_range(range, element_range) {
              next_range: CheckedSourceRange -> checked_body_array_elements(
                state,
                source,
                types,
                owner,
                function_result,
                loop_context,
                environment,
                rest,
                element_type,
                values.prepend(checked_element),
                element_types.prepend(actual),
                next_range
              )
              nil -> CheckedBodyArrayElementsRejected(
                state,
                CheckedBodyProducerInvalidRange
              )
            }
          }
        }
        CheckedBodyExprRejected(state, issue) -> CheckedBodyArrayElementsRejected(state, issue)
      }
    }
  }
}

fn checked_body_array_union(
  builder: owned SemanticTypeGraphBuilder,
  current: SemanticTypeId,
  remaining: List<SemanticTypeId>
) -> (owned SemanticTypeGraphBuilder, SemanticTypeId) {
  match remaining {
    Nil -> (builder, current)
    Cons(next, rest) -> match builder.union(current, next) {
      (builder, joined) -> checked_body_array_union(builder, joined, rest)
    }
  }
}

fn checked_body_finish_array(
  state: owned CheckedBodyBuild,
  values: List<CheckedExprId>,
  element_type: SemanticTypeId,
  result: SemanticTypeId,
  range: CheckedSourceRange
) -> CheckedBodyExprBuild {
  match checked_body_publish_arguments(state, values) {
    (state, elements) -> match state.array_literal(elements, element_type, result, range) {
      (state, expression) -> CheckedBodyExprBuilt(state, expression)
    }
  }
}

fn checked_body_array_literal(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  authored: ExprList,
  source_site: i64,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  let catalog = types.catalog
  let length = __i64_to_usize(expr_list_len(authored))
  let contextual_element: Option<SemanticTypeId> = match expectation {
    CheckedInferResult -> None
    CheckedRequireResult(expected) -> match catalog.graph_for(expected) {
      None -> None
      Some(graph) -> match semantic_type_graph_node(graph, expected) {
        SemanticArrayNode(element, expected_length) -> if expected_length == length {
          Some(element)
        } else { None }
        _ -> None
      }
    }
  }
  match source_range(source, source_site, 1) {
    nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
    opening: CheckedSourceRange -> match checked_body_array_elements(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      authored,
      contextual_element,
      Nil<CheckedExprId>(),
      Nil<SemanticTypeId>(),
      opening
    ) {
      CheckedBodyArrayElementsRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
      CheckedBodyArrayElementsBuilt(state, values, element_types, range) ->
        match (contextual_element, expectation) {
          (Some(inner), CheckedRequireResult(result)) -> checked_body_finish_array(
            state,
            values,
            inner,
            result,
            range
          )
          _ -> {
            let catalog = state.types()
            let module = types.module
            let resolution = types.resolution
            let segment = semantic_type_derived_segment_id(
              module.identity,
              catalog.next_derived_segment(
                module.identity,
                resolution.next_type_segment()
              )
            )
            let builder = semantic_type_graph_builder(segment)
            let (builder, inner) = match element_types.reverse() {
              Nil -> (builder, types.never_type)
              Cons(first, rest) -> checked_body_array_union(builder, first, rest)
            }
            match builder.array(inner, length) {
              (builder, result) -> {
                let next_catalog = semantic_type_catalog_with_graph(catalog, builder.freeze())
                if not expectation_allows(next_catalog, result, expectation) {
                  CheckedBodyExprRejected(
                    state,
                    expectation_mismatch(result, expectation)
                  )
                } else {
                  checked_body_finish_array(
                    state.with_types(next_catalog),
                    values,
                    inner,
                    result,
                    range
                  )
                }
              }
            }
          }
        }
    }
  }
}

fn checked_body_interpolation_concat(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  left: Expr,
  right: Expr,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  let catalog = state.types()
  if not expectation_allows(catalog, types.string, expectation) {
    CheckedBodyExprRejected(state, expectation_mismatch(types.string, expectation))
  } else {
    match checked_body_expr(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      left,
      CheckedRequireResult(types.string)
    ) {
      CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
      CheckedBodyExprBuilt(state, checked_left) -> match checked_body_expr(
        state,
        source,
        types,
        owner,
        function_result,
        loop_context,
        environment,
        right,
        CheckedRequireResult(types.string)
      ) {
        CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
        CheckedBodyExprBuilt(state, checked_right) -> match covering_range(
          state.range(checked_left),
          state.range(checked_right)
        ) {
          nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
          range: CheckedSourceRange -> match state.interpolation_concat(
            checked_left,
            checked_right,
            types.string,
            range
          ) {
            (state, expression) -> CheckedBodyExprBuilt(state, expression)
          }
        }
      }
    }
  }
}

fn checked_body_try(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  operand: Expr,
  operator: TypeNameRange,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  let scope = lexical_scope(environment)
  match checked_body_standard_declaration(
    types,
    scope,
    "stdlib/result",
    TypeDeclaration,
    "Result"
  ) {
    nil -> CheckedBodyExprRejected(state, CheckedBodyProducerCanonicalResultUnavailable)
    result_declaration: DeclarationIdentity -> match checked_body_standard_declaration(
      types,
      scope,
      "stdlib/fail",
      EffectDeclaration,
      "Fail"
    ) {
      nil -> CheckedBodyExprRejected(state, CheckedBodyProducerCanonicalFailUnavailable)
      fail_declaration: DeclarationIdentity -> match checked_body_expr(
        state,
        source,
        types,
        owner,
        function_result,
        loop_context,
        environment,
        operand,
        CheckedInferResult
      ) {
        CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
        CheckedBodyExprBuilt(state, checked_operand) -> {
          let catalog = state.types()
          let operand_type = state.result_type(checked_operand)
          match checked_body_result_arguments(catalog, operand_type, result_declaration) {
            None -> CheckedBodyExprRejected(
              state,
              CheckedBodyProducerResultOperandRequired(operand_type)
            )
            Some((success_type, error_type)) -> if not expectation_allows(
              catalog,
              success_type,
              expectation
            ) {
              CheckedBodyExprRejected(
                state,
                expectation_mismatch(success_type, expectation)
              )
            } else {
              match checked_body_fail_atom(catalog, environment, fail_declaration, error_type) {
                None -> CheckedBodyExprRejected(
                  state,
                  CheckedBodyProducerTryEffectUnavailable(error_type)
                )
                Some(atom) -> match source_range(
                  source,
                  operator.start,
                  operator.length
                ) {
                  nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
                  operator_range: CheckedSourceRange -> match covering_range(
                    state.range(checked_operand),
                    operator_range
                  ) {
                    nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
                    range: CheckedSourceRange -> match state.failure_propagation(
                      checked_operand,
                      atom,
                      operator_range,
                      success_type,
                      range
                    ) {
                      (state, expression) -> CheckedBodyExprBuilt(state, expression)
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

fn checked_body_nullable_payload(
  catalog: borrow SemanticTypeCatalog,
  value: SemanticTypeId,
  nil_type: SemanticTypeId
) -> Option<SemanticTypeId> {
  match catalog.graph_for(value) {
    None -> None<SemanticTypeId>()
    Some(graph) -> match semantic_type_graph_node(graph, value) {
      SemanticUnionNode(left, right) -> if semantic_type_catalog_equal(catalog, left, nil_type) {
        Some<SemanticTypeId>(right)
      } else {
        if semantic_type_catalog_equal(catalog, right, nil_type) {
          Some<SemanticTypeId>(left)
        } else { None<SemanticTypeId>() }
      }
      _ -> None<SemanticTypeId>()
    }
  }
}

fn checked_body_maybe_atom_matches(
  catalog: borrow SemanticTypeCatalog,
  atom: SemanticTypeId,
  declaration: DeclarationIdentity
) -> bool {
  match catalog.graph_for(atom) {
    None -> false
    Some(graph) -> match semantic_type_graph_node(graph, atom) {
      SemanticEffectAtomNode(candidate, arguments) -> {
        let lists = semantic_type_graph_type_lists_local(graph)
        declaration_identity_eq(candidate, declaration) and
          semantic_type_list_len(lists, arguments) == 0
      }
      _ -> false
    }
  }
}

fn checked_body_maybe_atom_in_function(
  catalog: borrow SemanticTypeCatalog,
  function_type: SemanticTypeId,
  declaration: DeclarationIdentity
) -> Option<SemanticTypeId> {
  match catalog.graph_for(function_type) {
    None -> None<SemanticTypeId>()
    Some(graph) -> match semantic_type_graph_node(graph, function_type) {
      SemanticFunctionNode(_, _, effects) -> match catalog.graph_for(effects) {
        None -> None<SemanticTypeId>()
        Some(effect_graph) -> match semantic_type_graph_node(effect_graph, effects) {
          SemanticEffectSignatureNode(atoms, _) -> {
            let lists = semantic_type_graph_type_lists_local(effect_graph)
            let mut index: usize = 0
            while index < semantic_type_list_len(lists, atoms) {
              let atom = semantic_type_graph_list_type_id(
                effect_graph,
                semantic_type_list_edge(lists, atoms, index)
              )
              if checked_body_maybe_atom_matches(catalog, atom, declaration) {
                return Some<SemanticTypeId>(atom)
              }
              index = index + 1
            }
            None<SemanticTypeId>()
          }
          _ -> None<SemanticTypeId>()
        }
      }
      _ -> None<SemanticTypeId>()
    }
  }
}

fn checked_body_maybe_atom(
  catalog: borrow SemanticTypeCatalog,
  environment: CheckedLexicalEnvironment,
  declaration: DeclarationIdentity
) -> Option<SemanticTypeId> {
  match environment {
    CheckedLexicalRoot(_, _, _, function_type) -> checked_body_maybe_atom_in_function(
      catalog,
      function_type,
      declaration
    )
    CheckedLexicalBinding(_, _, _, _, _, parent) -> checked_body_maybe_atom(
      catalog,
      parent,
      declaration
    )
    CheckedLexicalHandledEffect(atom, parent) -> if checked_body_maybe_atom_matches(
      catalog,
      atom,
      declaration
    ) { Some<SemanticTypeId>(atom) }
    else { checked_body_maybe_atom(catalog, parent, declaration) }
    CheckedLexicalResume(_, _, parent) -> checked_body_maybe_atom(
      catalog,
      parent,
      declaration
    )
  }
}

fn checked_body_optional_structural_field(
  state: owned CheckedBodyBuild,
  base: CheckedExprId,
  key: i64,
  position: CheckedStructuralFieldPosition,
  result: SemanticTypeId,
  field_range: CheckedSourceRange,
  atom: SemanticTypeId,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  let catalog = state.types()
  if expectation_allows(catalog, result, expectation) {
    match covering_range(state.range(base), field_range) {
      nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
      range: CheckedSourceRange -> match state.optional_projection(
        base,
        CheckedStructuralProjection(key, position),
        atom,
        field_range,
        result,
        range
      ) {
        (state, expression) -> CheckedBodyExprBuilt(state, expression)
      }
    }
  } else {
    CheckedBodyExprRejected(state, expectation_mismatch(result, expectation))
  }
}

fn checked_body_optional_field(
  state: owned CheckedBodyBuild,
  types: CheckedBodyPrimitiveTypes,
  base: CheckedExprId,
  payload_type: SemanticTypeId,
  field_name: str,
  field_range: CheckedSourceRange,
  atom: SemanticTypeId,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  let catalog = state.types()
  match semantic_record_field_projection(catalog, payload_type, field_name) {
    SemanticRecordFieldProjected(key, offset, result) -> checked_body_optional_structural_field(
      state,
      base,
      key,
      CheckedStructuralFieldWordOffset(offset),
      result,
      field_range,
      atom,
      expectation
    )
    SemanticRecordFieldUnplaced(key, exact_name, result) ->
      checked_body_optional_structural_field(
        state,
        base,
        key,
        CheckedStructuralFieldUnplaced(exact_name),
        result,
        field_range,
        atom,
        expectation
      )
    SemanticRecordFieldMissing -> CheckedBodyExprRejected(
      state,
      CheckedBodyProducerUnknownField(field_range)
    )
    SemanticRecordFieldProjectionUnavailable -> {
      let applications = types.applications
      match semantic_declared_field_projection(
        applications,
        catalog,
        payload_type,
        field_name
      ) {
        SemanticDeclaredFieldProjected(declaration, offset, result) -> if expectation_allows(
          catalog,
          result,
          expectation
        ) {
          match covering_range(state.range(base), field_range) {
            nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
            range: CheckedSourceRange -> match state.optional_projection(
              base,
              CheckedDeclaredProjection(declaration, offset),
              atom,
              field_range,
              result,
              range
            ) {
              (state, expression) -> CheckedBodyExprBuilt(state, expression)
            }
          }
        } else {
          CheckedBodyExprRejected(state, expectation_mismatch(result, expectation))
        }
        SemanticDeclaredFieldMissing -> CheckedBodyExprRejected(
          state,
          CheckedBodyProducerUnknownField(field_range)
        )
        SemanticDeclaredFieldProjectionUnavailable -> CheckedBodyExprRejected(
          state,
          CheckedBodyProducerFieldProjectionUnavailable(payload_type)
        )
      }
    }
  }
}

fn checked_body_optional_chain(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  base: Expr,
  field_start: i64,
  field_length: i64,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  match checked_body_standard_declaration(
    types,
    lexical_scope(environment),
    "stdlib/maybe",
    EffectDeclaration,
    "Maybe"
  ) {
    nil -> CheckedBodyExprRejected(state, CheckedBodyProducerMaybeEffectUnavailable)
    maybe_declaration: DeclarationIdentity -> {
      let catalog = state.types()
      match checked_body_maybe_atom(catalog, environment, maybe_declaration) {
        Some(atom) -> match checked_body_expr(
          state,
          source,
          types,
          owner,
          function_result,
          loop_context,
          environment,
          base,
          CheckedInferResult
        ) {
          CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
          CheckedBodyExprBuilt(state, checked_base) -> {
            let catalog = state.types()
            let base_type = state.result_type(checked_base)
            match checked_body_nullable_payload(catalog, base_type, types.nil_type) {
              None -> CheckedBodyExprRejected(
                state,
                CheckedBodyProducerOptionalBaseRequired(base_type)
              )
              Some(payload_type) -> match source_range(source, field_start, field_length) {
                nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
                field_range: CheckedSourceRange -> match source.span(
                  field_range.start,
                  field_range.end
                ) {
                  None -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
                  Some(field_span) -> match field_span.text() {
                    None -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
                    Some(field_name) -> checked_body_optional_field(
                      state,
                      types,
                      checked_base,
                      payload_type,
                      field_name,
                      field_range,
                      atom,
                      expectation
                    )
                  }
                }
              }
            }
          }
        }
        _ -> CheckedBodyExprRejected(state, CheckedBodyProducerMaybeEffectUnavailable)
      }
    }
  }
}

fn checked_body_expr(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  authored: Expr,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  let current_catalog = state.types()
  let types = checked_body_types_with_catalog(types, current_catalog)
  let catalog = types.catalog
  match authored {
    Block(first, rest) -> checked_body_block(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      first,
      rest,
      expectation
    )
    If(condition, then_branch, else_branch) -> checked_body_if(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      condition,
      then_branch,
      else_branch,
      expectation
    )
    Match(scrutinee, arms, origin) -> checked_body_match(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      scrutinee,
      arms,
      origin,
      expectation
    )
    While(condition, body) -> checked_body_while(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      condition,
      body,
      expectation
    )
    ForIter(name_start, name_length, collection, body) -> checked_body_for_iter(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      name_start,
      name_length,
      collection,
      body,
      expectation
    )
    Let(start, length, value, body) -> checked_body_let(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      start,
      length,
      value,
      body,
      false,
      None,
      expectation
    )
    LetMut(start, length, value, body) -> checked_body_let(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      start,
      length,
      value,
      body,
      true,
      None,
      expectation
    )
    LetTyped(inner, annotation) -> checked_body_typed_let(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      inner,
      annotation,
      expectation
    )
    Assign(start, length, value) -> checked_body_assign(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      start,
      length,
      value,
      expectation
    )
    Loop(body) -> checked_body_loop(
      state,
      source,
      types,
      owner,
      function_result,
      environment,
      body,
      expectation
    )
    Break(value) -> match loop_context {
      CheckedOutsideLoop -> CheckedBodyExprRejected(
        state,
        CheckedBodyProducerBreakOutsideLoop
      )
      CheckedInsideLoop(result) -> match checked_body_expr(
        state,
        source,
        types,
        owner,
        function_result,
        CheckedInsideLoop(result),
        environment,
        value,
        CheckedRequireResult(result)
      ) {
        CheckedBodyExprBuilt(state, checked_value) -> {
          let range = state.range(checked_value)
          if expectation_allows(catalog, types.never_type, expectation) {
            match state.break_expr(checked_value, types.never_type, range) {
              (state, expression) -> CheckedBodyExprBuilt(state, expression)
            }
          } else {
            CheckedBodyExprRejected(
              state,
              expectation_mismatch(types.never_type, expectation)
            )
          }
        }
        CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
      }
    }
    BreakNoValue(start, length) -> match loop_context {
      CheckedOutsideLoop -> CheckedBodyExprRejected(
        state,
        CheckedBodyProducerBreakOutsideLoop
      )
      CheckedInsideLoop(result) -> if semantic_type_is_subtype(
        catalog,
        types.nil_type,
        result
      ) and expectation_allows(catalog, types.never_type, expectation) {
        match source_range(source, start, length) {
          range: CheckedSourceRange -> match state.break_no_value(types.never_type, range) {
            (state, expression) -> CheckedBodyExprBuilt(state, expression)
          }
          nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
        }
      } else {
        CheckedBodyExprRejected(
          state,
          CheckedBodyProducerTypeMismatch(types.nil_type, result)
        )
      }
    }
    Continue(start, length) -> match loop_context {
      CheckedOutsideLoop -> CheckedBodyExprRejected(
        state,
        CheckedBodyProducerContinueOutsideLoop
      )
      CheckedInsideLoop(_) -> if expectation_allows(
        catalog,
        types.never_type,
        expectation
      ) {
        match source_range(source, start, length) {
          range: CheckedSourceRange -> match state.continue_expr(types.never_type, range) {
            (state, expression) -> CheckedBodyExprBuilt(state, expression)
          }
          nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
        }
      } else {
        CheckedBodyExprRejected(
          state,
          expectation_mismatch(types.never_type, expectation)
        )
      }
    }
    Return(value) -> match checked_body_expr(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      value,
      CheckedRequireResult(function_result)
    ) {
      CheckedBodyExprBuilt(state, checked_value) -> {
        let range = state.range(checked_value)
        if semantic_continuation_type(catalog, state.result_type(checked_value)) and
          not
          semantic_continuation_type(catalog, function_result) {
            CheckedBodyExprRejected(
              state,
              CheckedBodyProducerContinuationResultRequired(range)
            )
          } else if expectation_allows(catalog, types.never_type, expectation) {
            match state.return_expr(checked_value, types.never_type, range) {
              (state, expression) -> CheckedBodyExprBuilt(state, expression)
            }
          } else {
            CheckedBodyExprRejected(
              state,
              expectation_mismatch(types.never_type, expectation)
            )
          }
      }
      CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
    }
    Not(operand) -> checked_body_not(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      operand,
      expectation
    )
    Negate(operand, _) -> checked_body_negate(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      operand,
      expectation
    )
    Defer(cleanup, body, source_site) -> checked_body_defer(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      cleanup,
      body,
      source_site,
      expectation
    )
    BinOp(operator, left, right) -> checked_body_binary(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      operator,
      left,
      right,
      expectation
    )
    Call(start, length, arguments) -> checked_body_call(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      start,
      length,
      arguments,
      expectation
    )
    GenericCall(type_arguments, inner) -> checked_body_generic_call(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      type_arguments,
      inner,
      expectation
    )
    Lambda(parameters, body, source_site) -> checked_body_lambda(
      state,
      source,
      types,
      owner,
      environment,
      parameters,
      body,
      source_site,
      expectation,
      false
    )
    Apply(callee, arguments, _, site) -> checked_body_apply(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      callee,
      arguments,
      site,
      expectation
    )
    FieldAccess(base, field_start, field_length, _) -> checked_body_field_access(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      base,
      field_start,
      field_length,
      expectation
    )
    IndexedGet(base, index, _, _) -> checked_body_indexed_get(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      base,
      index,
      expectation
    )
    IndexedSet(base, index, value, _) -> checked_body_indexed_set(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      base,
      index,
      value,
      expectation
    )
    IndexedSlice(base, start, end, _) -> checked_body_indexed_slice(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      base,
      start,
      end,
      expectation
    )
    Perform(effect_ref, operation_start, operation_length, arguments) -> checked_body_perform(
      state,
      types.module,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      effect_ref,
      operation_start,
      operation_length,
      arguments,
      expectation
    )
    Handle(body, clauses, return_clause) -> checked_body_handle(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      body,
      clauses,
      return_clause,
      expectation
    )
    Resume(value) -> checked_body_resume(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      value,
      expectation
    )
    RecordInit(type_start, type_length, fields, construction) ->
      if type_start == 0 and type_length <= 0 {
        checked_body_record_literal(
          state,
          source,
          types,
          owner,
          function_result,
          loop_context,
          environment,
          fields,
          if type_length < 0 { CheckedTupleRecordShape } else { CheckedStructuralRecordShape },
          record_construction_range(construction),
          expectation
        )
      } else {
        checked_body_nominal_record_literal(
          state,
          source,
          types,
          owner,
          function_result,
          loop_context,
          environment,
          type_start,
          type_length,
          fields,
          construction,
          expectation
        )
      }
    RecordUpdate(base, fields, fact) -> checked_body_record_update(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      base,
      fields,
      record_update_fact_range(fact),
      expectation
    )
    ArrayLiteral(elements, _, source_site) -> checked_body_array_literal(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      elements,
      source_site,
      expectation
    )
    InterpConcat(left, right) -> checked_body_interpolation_concat(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      left,
      right,
      expectation
    )
    InterpDisplay(operand) -> checked_body_interpolation_display(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      operand,
      expectation
    )
    Try(operand, _, operator) -> checked_body_try(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      operand,
      operator,
      expectation
    )
    OptChain(base, field_start, field_length, _) -> checked_body_optional_chain(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      base,
      field_start,
      field_length,
      expectation
    )
    IntLit(value, start, length) -> match source_range(source, start, length) {
      range: CheckedSourceRange -> {
        let actual = contextual_integer_type(catalog, types.integer, expectation)
        if expectation_allows(catalog, actual, expectation) {
          match state.integer(value, actual, range) {
            (state, expression) -> CheckedBodyExprBuilt(state, expression)
          }
        } else {
          CheckedBodyExprRejected(
            state,
            expectation_mismatch(actual, expectation)
          )
        }
      }
      nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
    }
    StringLit(decoded_start, decoded_length, token_start, token_length) -> match source_range(
      source,
      token_start,
      token_length
    ) {
      range: CheckedSourceRange -> if decoded_length < 0 {
        CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
      } else {
        if expectation_allows(catalog, types.string, expectation) {
          let value = if decoded_length == 0 { "" } else {
            runtime_str_from_bytes_copy(
              __str_ptr(source.text) + decoded_start,
              decoded_length
            )
          }
          match state.string(value, types.string, range) {
            (state, expression) -> CheckedBodyExprBuilt(state, expression)
          }
        } else {
          CheckedBodyExprRejected(
            state,
            expectation_mismatch(types.string, expectation)
          )
        }
      }
      nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
    }
    FloatLit(start, length, _) -> match source_range(source, start, length) {
      range: CheckedSourceRange -> {
        let actual = contextual_float_type(catalog, types, expectation)
        if not expectation_allows(catalog, actual, expectation) {
          CheckedBodyExprRejected(state, expectation_mismatch(actual, expectation))
        } else {
          match checked_float_literal_value(
            source,
            start,
            length,
            semantic_type_catalog_equal(catalog, actual, types.float32)
          ) {
            Some(value) -> match state.float(value, actual, range) {
              (state, expression) -> CheckedBodyExprBuilt(state, expression)
            }
            None -> CheckedBodyExprRejected(
              state,
              CheckedBodyProducerInvalidFloatLiteral(range)
            )
          }
        }
      }
      nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
    }
    BoolLit(value, start, length) -> match source_range(source, start, length) {
      range: CheckedSourceRange -> if expectation_allows(
        catalog,
        types.boolean,
        expectation
      ) {
        match state.boolean(value != 0, types.boolean, range) {
          (state, expression) -> CheckedBodyExprBuilt(state, expression)
        }
      } else {
        CheckedBodyExprRejected(
          state,
          expectation_mismatch(types.boolean, expectation)
        )
      }
      nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
    }
    NilExpr -> if expectation_allows(catalog, types.nil_type, expectation) {
      match state.nil(
        types.nil_type,
        CheckedSourceRange { start: 0, end: 0 }
      ) {
        (state, expression) -> CheckedBodyExprBuilt(state, expression)
      }
    } else {
      CheckedBodyExprRejected(
        state,
        expectation_mismatch(types.nil_type, expectation)
      )
    }
    Ident(start, length) -> match source_range(source, start, length) {
      range: CheckedSourceRange -> match lexical_lookup(
        environment,
        source,
        start,
        length
      ) {
        CheckedLexicalFound(binding, actual, _) -> if expectation_allows(
          catalog,
          actual,
          expectation
        ) {
          match state.local_reference(binding, actual, range) {
            (state, expression) -> CheckedBodyExprBuilt(state, expression)
          }
        } else {
          CheckedBodyExprRejected(
            state,
            expectation_mismatch(actual, expectation)
          )
        }
        CheckedLexicalMissing -> match source.span(range.start, range.end) {
          Some(name) -> match registration_scope_lookup_declaration_span(
            lexical_scope(environment),
            lexical_module(environment),
            ValueDeclaration,
            name
          ) {
            Some(declaration) -> match state.find_signature(
              DeclaredFunctionIdentity(declaration.identity)
            ) {
              Some(signature) -> if expectation_allows(
                catalog,
                signature.type_id,
                expectation
              ) {
                match state.declaration_reference(
                  declaration.identity,
                  signature.type_id,
                  range
                ) {
                  (state, expression) -> CheckedBodyExprBuilt(state, expression)
                }
              } else {
                CheckedBodyExprRejected(
                  state,
                  expectation_mismatch(signature.type_id, expectation)
                )
              }
              None -> CheckedBodyExprRejected(
                state,
                CheckedBodyProducerSignatureUnavailable(range)
              )
            }
            None -> match registration_scope_lookup_declaration_span(
              lexical_scope(environment),
              lexical_module(environment),
              ConstructorDeclaration,
              name
            ) {
              Some(declaration) -> checked_body_constructor_value(
                state,
                source,
                types,
                owner,
                function_result,
                loop_context,
                environment,
                declaration.identity,
                name,
                range,
                ExprListNil,
                expectation
              )
              None -> CheckedBodyExprRejected(
                state,
                CheckedBodyProducerUnknownIdentifier(range)
              )
            }
          }
          None -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
        }
      }
      nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
    }
    _ -> CheckedBodyExprRejected(state, CheckedBodyProducerUnsupportedExpression)
  }
}

fn checked_body_owner_signature(
  state: owned CheckedBodyBuild,
  types: CheckedBodyPrimitiveTypes,
  signature: SemanticFunctionSignature
) -> (
  owned CheckedBodyBuild,
  CheckedBodyPrimitiveTypes,
  SemanticFunctionSignature
) {
  let catalog = state.types()
  let resolution = types.resolution
  let methods = resolution.methods()
  match semantic_method_function_substitution(
    methods,
    catalog,
    signature.identity
  ) {
    None -> (
      state,
      checked_body_types_with_catalog(types, catalog),
      signature
    )
    Some(substitution) -> {
      let next_segment = catalog.next_derived_segment(
        types.module.identity,
        resolution.next_type_segment()
      )
      let product = semantic_type_product_continue(
        types.module.identity,
        catalog,
        next_segment
      )
      let (product, type_id) = semantic_type_product_substitute(
        product,
        substitution,
        signature.type_id
      )
      let next_catalog = semantic_type_product_catalog(product)
      (
        state.with_types(next_catalog),
        checked_body_types_with_catalog(types, next_catalog),
        SemanticFunctionSignature {
          identity: signature.identity,
          type_id: type_id,
          type_parameters_start: signature.type_parameters_start,
          type_parameters_count: signature.type_parameters_count,
          bounds_start: signature.bounds_start,
          bounds_count: signature.bounds_count
        }
      )
    }
  }
}

fn checked_body_functions(
  module: RegisteredModule,
  scope: RegistrationScope,
  types: CheckedBodyPrimitiveTypes,
  index: usize,
  state: owned CheckedBodyBuild
) -[SemanticConformance]> CheckedBodyFunctionsBuild {
  let functions = module.functions
  if index >= functions.len() { CheckedBodyFunctionsBuilt(state) }
  else {
    let function = functions.at(dense_index(index))
    let signature = state.signature(index)
    match checked_body_owner_signature(state, types, signature) {
      (state, types, signature) -> {
        let catalog = types.catalog
        let expected = semantic_function_result(catalog, signature.type_id)
        match checked_body_parameters(
          state,
          module.source,
          catalog,
          signature,
          function.syntax.params,
          0,
          CheckedLexicalRoot(
            scope,
            module.identity,
            function.syntax.type_params,
            signature.type_id
          )
        ) {
          CheckedBodyParametersBuilt(state, environment) -> match checked_body_expr(
            state,
            module.source,
            types,
            signature.identity,
            expected,
            CheckedOutsideLoop,
            environment,
            function.syntax.body,
            CheckedRequireResult(expected)
          ) {
            CheckedBodyExprBuilt(state, root) -> {
              let root_range = state.range(root)
              if semantic_continuation_type(catalog, state.result_type(root)) and
                not
                semantic_continuation_type(catalog, expected) {
                  CheckedBodyFunctionsRejected(
                    state,
                    CheckedBodyProducerContinuationResultRequired(root_range)
                  )
                } else {
                  checked_body_functions(
                    module,
                    scope,
                    types,
                    index + 1,
                    state.function(signature, root)
                  )
                }
            }
            CheckedBodyExprRejected(state, issue) -> CheckedBodyFunctionsRejected(
              state,
              issue
            )
          }
          CheckedBodyParametersRejected(state, issue) -> CheckedBodyFunctionsRejected(
            state,
            issue
          )
        }
      }
    }
  }
}

pub(package) fn check_registered_bodies(
  module: RegisteredModule,
  scope: RegistrationScope,
  resolution: SemanticResolutionProduct,
  sdk_package_id: i64
) -[SemanticConformance]> CheckedBodyCheckResult {
  let signatures = resolution.signatures()
  match checked_body_primitive_types(module, scope, resolution, sdk_package_id) {
    CheckedBodyPrimitivesResolved(types) -> match checked_body_functions(
      module,
      scope,
      types,
      0,
      checked_body_build(module, signatures, types)
    ) {
      CheckedBodyFunctionsBuilt(state) -> state.freeze(resolution.declarations())
      CheckedBodyFunctionsRejected(state, issue) -> {
        state.drop()
        CheckedBodiesRejected(issue)
      }
    }
    CheckedBodyPrimitivesRejected(issue) -> CheckedBodiesRejected(
      CheckedBodyProducerTypeRejected(issue)
    )
  }
}
