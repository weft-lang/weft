use stdlib/option.{Some}
use stdlib/panic.{panic}
use stdlib/source.{Source}

pub(package) type CheckedBodyProducerIssue {
  CheckedBodyProducerTypeRejected(SemanticTypeResolutionIssue),
  CheckedBodyProducerInvalidRange,
  CheckedBodyProducerUnknownIdentifier(CheckedSourceRange),
  CheckedBodyProducerImmutableAssignment(CheckedSourceRange),
  CheckedBodyProducerInferredBranchMismatch(SemanticTypeId, SemanticTypeId),
  CheckedBodyProducerUnsupportedParameter,
  CheckedBodyProducerTypeMismatch(SemanticTypeId, SemanticTypeId),
  CheckedBodyProducerUnsupportedExpression,
  CheckedBodyProducerFreezeRejected(CheckedBodyProductIssue)
}

pub(package) type CheckedBodyCheckResult {
  CheckedBodiesAccepted(CheckedBodyProduct),
  CheckedBodiesRejected(CheckedBodyProducerIssue)
}

type CheckedBodyPrimitiveTypes {
  catalog: SemanticTypeCatalog,
  never_type: SemanticTypeId,
  integer: SemanticTypeId,
  boolean: SemanticTypeId,
  nil_type: SemanticTypeId
}

type CheckedBodyPrimitiveResolution {
  CheckedBodyPrimitivesResolved(CheckedBodyPrimitiveTypes),
  CheckedBodyPrimitivesRejected(SemanticTypeResolutionIssue)
}

type CheckedLexicalEnvironment {
  CheckedLexicalEmpty,
  CheckedLexicalBinding(
    i64,
    i64,
    CheckedBindingId,
    SemanticTypeId,
    bool,
    CheckedLexicalEnvironment
  )
}

type CheckedLexicalLookup {
  CheckedLexicalFound(CheckedBindingId, SemanticTypeId, bool),
  CheckedLexicalMissing
}

type CheckedBodyBuildStorage {
  signatures: SemanticSignatureProduct,
  expressions: owned CheckedExprGraphBuilder,
  patterns: owned CheckedPatternGraphBuilder,
  closures: owned CheckedClosureBuilder,
  effects: owned CheckedEffectBuilder,
  propagation: owned CheckedPropagationBuilder
}

type CheckedBodyBuild = opaque CheckedBodyBuildStorage

type CheckedBodyExprBuild {
  CheckedBodyExprBuilt(owned CheckedBodyBuild, CheckedExprId),
  CheckedBodyExprRejected(owned CheckedBodyBuild, CheckedBodyProducerIssue)
}

type CheckedBodyExpectation {
  CheckedInferResult,
  CheckedRequireResult(SemanticTypeId)
}

type CheckedBranchResult {
  CheckedBranchResolved(SemanticTypeId),
  CheckedBranchMismatch
}

type CheckedBodyFunctionsBuild {
  CheckedBodyFunctionsBuilt(owned CheckedBodyBuild),
  CheckedBodyFunctionsRejected(owned CheckedBodyBuild, CheckedBodyProducerIssue)
}

type CheckedBodyParametersBuild {
  CheckedBodyParametersBuilt(owned CheckedBodyBuild, CheckedLexicalEnvironment),
  CheckedBodyParametersRejected(owned CheckedBodyBuild, CheckedBodyProducerIssue)
}

fn checked_body_primitive_types(
  module: RegisteredModule,
  scope: RegistrationScope,
  signatures: borrow SemanticSignatureProduct
) -> CheckedBodyPrimitiveResolution {
  let product = signatures.continue_types()
  match resolve_type_product_in_scope(
    product,
    module,
    scope,
    TypeParamListNil,
    NeverTypeExpr
  ) {
    (product, SemanticTypeResolved(never_type)) -> match resolve_type_product_in_scope(
      product,
      module,
      scope,
      TypeParamListNil,
      PrimitiveTypeExpr(0)
    ) {
      (product, SemanticTypeResolved(integer)) -> match resolve_type_product_in_scope(
        product,
        module,
        scope,
        TypeParamListNil,
        PrimitiveTypeExpr(2)
      ) {
        (product, SemanticTypeResolved(boolean)) -> match resolve_type_product_in_scope(
          product,
          module,
          scope,
          TypeParamListNil,
          PrimitiveTypeExpr(3)
        ) {
          (product, SemanticTypeResolved(nil_type)) -> CheckedBodyPrimitivesResolved(
            CheckedBodyPrimitiveTypes {
              catalog: semantic_type_product_catalog(product),
              never_type: never_type,
              integer: integer,
              boolean: boolean,
              nil_type: nil_type
            }
          )
          (_, SemanticTypeRejected(issue)) -> CheckedBodyPrimitivesRejected(issue)
        }
        (_, SemanticTypeRejected(issue)) -> CheckedBodyPrimitivesRejected(issue)
      }
      (_, SemanticTypeRejected(issue)) -> CheckedBodyPrimitivesRejected(issue)
    }
    (_, SemanticTypeRejected(issue)) -> CheckedBodyPrimitivesRejected(issue)
  }
}

fn checked_body_build(
  module: RegisteredModule,
  signatures: SemanticSignatureProduct,
  types: CheckedBodyPrimitiveTypes
) -> owned CheckedBodyBuild {
  let functions = module.functions
  let expressions = checked_expr_graph_builder(
    module.identity,
    module.source,
    types.catalog,
    functions.len()
  )
  let patterns = checked_pattern_graph_builder(
    expressions.segment(),
    module.source,
    types.catalog
  )
  let closures = checked_closure_builder(expressions, 0)
  let effects = checked_effect_builder(expressions, 0)
  let propagation = checked_propagation_builder(expressions, 0)
  CheckedBodyBuild(
    CheckedBodyBuildStorage {
      signatures: signatures,
      expressions: expressions,
      patterns: patterns,
      closures: closures,
      effects: effects,
      propagation: propagation
    }
  )
}

fn source_range(
  source: Source,
  start: i64,
  length: i64
) -> CheckedSourceRange? {
  if start < 0 or length < 0 { nil }
  else {
    let first = __i64_to_usize(start)
    let count = __i64_to_usize(length)
    if first > source.text.len() or count > source.text.len() - first { nil }
    else { CheckedSourceRange { start: first, end: first + count } }
  }
}

fn same_source_name(
  source: Source,
  left_start: i64,
  left_length: i64,
  right_start: i64,
  right_length: i64
) -> bool {
  if left_length != right_length or left_start < 0 or right_start < 0 or
    left_length < 0 { false }
  else {
    let left_first = __i64_to_usize(left_start)
    let right_first = __i64_to_usize(right_start)
    let count = __i64_to_usize(left_length)
    match (
      source.text.slice(left_first, left_first + count),
      source.text.slice(right_first, right_first + count)
    ) {
      (Some(left), Some(right)) -> left == right
      _ -> false
    }
  }
}

fn lexical_lookup(
  environment: CheckedLexicalEnvironment,
  source: Source,
  start: i64,
  length: i64
) -> CheckedLexicalLookup {
  match environment {
    CheckedLexicalEmpty -> CheckedLexicalMissing
    CheckedLexicalBinding(binding_start, binding_length, binding, value_type, mutable, parent) ->
      if same_source_name(
        source,
        start,
        length,
        binding_start,
        binding_length
      ) {
        CheckedLexicalFound(binding, value_type, mutable)
      } else { lexical_lookup(parent, source, start, length) }
  }
}

fn semantic_function_result(
  catalog: borrow SemanticTypeCatalog,
  signature: SemanticFunctionSignature
) -> SemanticTypeId {
  match catalog.graph_for(signature.type_id) {
    Some(graph) -> match semantic_type_graph_node(graph, signature.type_id) {
      SemanticFunctionNode(_, result, _) -> result
      _ -> panic("Checked body signature is not a function type")
    }
    _ -> panic("Checked body signature is outside its type catalog")
  }
}

fn semantic_function_parameter_count(
  catalog: borrow SemanticTypeCatalog,
  signature: SemanticFunctionSignature
) -> usize {
  match catalog.graph_for(signature.type_id) {
    Some(graph) -> match semantic_type_graph_node(graph, signature.type_id) {
      SemanticFunctionNode(parameters, _, _) -> {
        let lists = semantic_type_graph_type_lists_local(graph)
        semantic_type_list_len(lists, parameters)
      }
      _ -> panic("Checked body signature is not a function type")
    }
    _ -> panic("Checked body signature is outside its type catalog")
  }
}

fn semantic_function_parameter(
  catalog: borrow SemanticTypeCatalog,
  signature: SemanticFunctionSignature,
  index: usize
) -> SemanticTypeId {
  match catalog.graph_for(signature.type_id) {
    Some(graph) -> match semantic_type_graph_node(graph, signature.type_id) {
      SemanticFunctionNode(parameters, _, _) -> {
        let lists = semantic_type_graph_type_lists_local(graph)
        semantic_type_graph_list_type_id(
          graph,
          semantic_type_list_edge(lists, parameters, index)
        )
      }
      _ -> panic("Checked body signature is not a function type")
    }
    _ -> panic("Checked body signature is outside its type catalog")
  }
}

fn semantic_integer_type(
  catalog: borrow SemanticTypeCatalog,
  value: SemanticTypeId
) -> bool {
  match catalog.graph_for(value) {
    Some(graph) -> match semantic_type_graph_node(graph, value) {
      SemanticPrimitiveNode(primitive) -> match primitive {
        SemanticI64 -> true
        SemanticI32 -> true
        SemanticI8 -> true
        SemanticI16 -> true
        SemanticU8 -> true
        SemanticU16 -> true
        SemanticU32 -> true
        SemanticU64 -> true
        SemanticIsize -> true
        SemanticUsize -> true
        SemanticF32 -> false
        SemanticF64 -> false
        _ -> false
      }
      _ -> false
    }
    _ -> false
  }
}

impl CheckedBodyBuild {
  fn signature(self: borrow Self, index: usize) -> SemanticFunctionSignature {
    match self {
      CheckedBodyBuild(storage) -> {
        let { signatures, expressions: _, patterns: _, closures: _, effects: _, propagation: _ } = storage
        signatures.at(index)
      }
    }
  }

  fn binding(
    self: owned Self,
    owner: FunctionIdentity,
    value_type: SemanticTypeId,
    range: CheckedSourceRange,
    mutability: CheckedBindingMutability
  ) -> (owned CheckedBodyBuild, CheckedBindingId) {
    match self {
      CheckedBodyBuild(storage) -> {
        let { signatures, expressions, patterns, closures, effects, propagation } = storage
        match expressions.binding(
          owner,
          value_type,
          range,
          mutability
        ) {
          (expressions, binding) -> (
            CheckedBodyBuild(
              CheckedBodyBuildStorage {
                signatures: signatures,
                expressions: expressions,
                patterns: patterns,
                closures: closures,
                effects: effects,
                propagation: propagation
              }
            ),
            binding
          )
        }
      }
    }
  }

  fn function_parameter(
    self: owned Self,
    binding: CheckedBindingId
  ) -> owned CheckedBodyBuild {
    match self {
      CheckedBodyBuild(storage) -> {
        let { signatures, expressions, patterns, closures, effects, propagation } = storage
        CheckedBodyBuild(
          CheckedBodyBuildStorage {
            signatures: signatures,
            expressions: expressions.function_parameter(binding),
            patterns: patterns,
            closures: closures,
            effects: effects,
            propagation: propagation
          }
        )
      }
    }
  }

  fn local_reference(
    self: owned Self,
    binding: CheckedBindingId,
    result: SemanticTypeId,
    range: CheckedSourceRange
  ) -> (owned CheckedBodyBuild, CheckedExprId) {
    match self {
      CheckedBodyBuild(storage) -> {
        let { signatures, expressions, patterns, closures, effects, propagation } = storage
        match expressions.local_reference(binding, result, range) {
          (expressions, expression) -> (
            CheckedBodyBuild(
              CheckedBodyBuildStorage {
                signatures: signatures,
                expressions: expressions,
                patterns: patterns,
                closures: closures,
                effects: effects,
                propagation: propagation
              }
            ),
            expression
          )
        }
      }
    }
  }

  fn result_type(
    self: borrow Self,
    expression: CheckedExprId
  ) -> SemanticTypeId {
    match self {
      CheckedBodyBuild(storage) -> {
        let { signatures: _, expressions, patterns: _, closures: _, effects: _, propagation: _ } = storage
        expressions.result_type(expression)
      }
    }
  }

  fn range(
    self: borrow Self,
    expression: CheckedExprId
  ) -> CheckedSourceRange {
    match self {
      CheckedBodyBuild(storage) -> {
        let { signatures: _, expressions, patterns: _, closures: _, effects: _, propagation: _ } = storage
        expressions.range(expression)
      }
    }
  }

  fn block(
    self: owned Self,
    first: CheckedExprId,
    rest: CheckedExprId,
    result: SemanticTypeId,
    range: CheckedSourceRange
  ) -> (owned CheckedBodyBuild, CheckedExprId) {
    match self {
      CheckedBodyBuild(storage) -> {
        let { signatures, expressions, patterns, closures, effects, propagation } = storage
        match expressions.block(first, rest, result, range) {
          (expressions, expression) -> (
            CheckedBodyBuild(
              CheckedBodyBuildStorage {
                signatures: signatures,
                expressions: expressions,
                patterns: patterns,
                closures: closures,
                effects: effects,
                propagation: propagation
              }
            ),
            expression
          )
        }
      }
    }
  }

  fn if_expr(
    self: owned Self,
    condition: CheckedExprId,
    then_branch: CheckedExprId,
    else_branch: CheckedExprId,
    result: SemanticTypeId,
    range: CheckedSourceRange
  ) -> (owned CheckedBodyBuild, CheckedExprId) {
    match self {
      CheckedBodyBuild(storage) -> {
        let { signatures, expressions, patterns, closures, effects, propagation } = storage
        match expressions.if_expr(
          condition,
          then_branch,
          else_branch,
          result,
          range
        ) {
          (expressions, expression) -> (
            CheckedBodyBuild(
              CheckedBodyBuildStorage {
                signatures: signatures,
                expressions: expressions,
                patterns: patterns,
                closures: closures,
                effects: effects,
                propagation: propagation
              }
            ),
            expression
          )
        }
      }
    }
  }

  fn while_expr(
    self: owned Self,
    condition: CheckedExprId,
    body: CheckedExprId,
    result: SemanticTypeId,
    range: CheckedSourceRange
  ) -> (owned CheckedBodyBuild, CheckedExprId) {
    match self {
      CheckedBodyBuild(storage) -> {
        let { signatures, expressions, patterns, closures, effects, propagation } = storage
        match expressions.while_expr(condition, body, result, range) {
          (expressions, expression) -> (
            CheckedBodyBuild(
              CheckedBodyBuildStorage {
                signatures: signatures,
                expressions: expressions,
                patterns: patterns,
                closures: closures,
                effects: effects,
                propagation: propagation
              }
            ),
            expression
          )
        }
      }
    }
  }

  fn return_expr(
    self: owned Self,
    value: CheckedExprId,
    result: SemanticTypeId,
    range: CheckedSourceRange
  ) -> (owned CheckedBodyBuild, CheckedExprId) {
    match self {
      CheckedBodyBuild(storage) -> {
        let { signatures, expressions, patterns, closures, effects, propagation } = storage
        match expressions.return_expr(value, result, range) {
          (expressions, expression) -> (
            CheckedBodyBuild(
              CheckedBodyBuildStorage {
                signatures: signatures,
                expressions: expressions,
                patterns: patterns,
                closures: closures,
                effects: effects,
                propagation: propagation
              }
            ),
            expression
          )
        }
      }
    }
  }

  fn return_no_value(
    self: owned Self,
    result: SemanticTypeId,
    range: CheckedSourceRange
  ) -> (owned CheckedBodyBuild, CheckedExprId) {
    match self {
      CheckedBodyBuild(storage) -> {
        let { signatures, expressions, patterns, closures, effects, propagation } = storage
        match expressions.return_no_value(result, range) {
          (expressions, expression) -> (
            CheckedBodyBuild(
              CheckedBodyBuildStorage {
                signatures: signatures,
                expressions: expressions,
                patterns: patterns,
                closures: closures,
                effects: effects,
                propagation: propagation
              }
            ),
            expression
          )
        }
      }
    }
  }

  fn let_binding(
    self: owned Self,
    binding: CheckedBindingId,
    value: CheckedExprId,
    body: CheckedExprId,
    mutable: bool,
    result: SemanticTypeId,
    range: CheckedSourceRange
  ) -> (owned CheckedBodyBuild, CheckedExprId) {
    match self {
      CheckedBodyBuild(storage) -> {
        let { signatures, expressions, patterns, closures, effects, propagation } = storage
        let built = if mutable {
          expressions.let_mut_expr(binding, value, body, result, range)
        } else { expressions.let_expr(binding, value, body, result, range) }
        match built {
          (expressions, expression) -> (
            CheckedBodyBuild(
              CheckedBodyBuildStorage {
                signatures: signatures,
                expressions: expressions,
                patterns: patterns,
                closures: closures,
                effects: effects,
                propagation: propagation
              }
            ),
            expression
          )
        }
      }
    }
  }

  fn assign(
    self: owned Self,
    binding: CheckedBindingId,
    value: CheckedExprId,
    result: SemanticTypeId,
    range: CheckedSourceRange
  ) -> (owned CheckedBodyBuild, CheckedExprId) {
    match self {
      CheckedBodyBuild(storage) -> {
        let { signatures, expressions, patterns, closures, effects, propagation } = storage
        match expressions.assign(binding, value, result, range) {
          (expressions, expression) -> (
            CheckedBodyBuild(
              CheckedBodyBuildStorage {
                signatures: signatures,
                expressions: expressions,
                patterns: patterns,
                closures: closures,
                effects: effects,
                propagation: propagation
              }
            ),
            expression
          )
        }
      }
    }
  }

  fn integer(
    self: owned Self,
    value: i64,
    result: SemanticTypeId,
    range: CheckedSourceRange
  ) -> (owned CheckedBodyBuild, CheckedExprId) {
    match self {
      CheckedBodyBuild(storage) -> {
        let { signatures, expressions, patterns, closures, effects, propagation } = storage
        match expressions.integer(value, result, range) {
          (expressions, expression) -> (
            CheckedBodyBuild(
              CheckedBodyBuildStorage {
                signatures: signatures,
                expressions: expressions,
                patterns: patterns,
                closures: closures,
                effects: effects,
                propagation: propagation
              }
            ),
            expression
          )
        }
      }
    }
  }

  fn boolean(
    self: owned Self,
    value: bool,
    result: SemanticTypeId,
    range: CheckedSourceRange
  ) -> (owned CheckedBodyBuild, CheckedExprId) {
    match self {
      CheckedBodyBuild(storage) -> {
        let { signatures, expressions, patterns, closures, effects, propagation } = storage
        match expressions.boolean(value, result, range) {
          (expressions, expression) -> (
            CheckedBodyBuild(
              CheckedBodyBuildStorage {
                signatures: signatures,
                expressions: expressions,
                patterns: patterns,
                closures: closures,
                effects: effects,
                propagation: propagation
              }
            ),
            expression
          )
        }
      }
    }
  }

  fn nil(
    self: owned Self,
    result: SemanticTypeId,
    range: CheckedSourceRange
  ) -> (owned CheckedBodyBuild, CheckedExprId) {
    match self {
      CheckedBodyBuild(storage) -> {
        let { signatures, expressions, patterns, closures, effects, propagation } = storage
        match expressions.nil(result, range) {
          (expressions, expression) -> (
            CheckedBodyBuild(
              CheckedBodyBuildStorage {
                signatures: signatures,
                expressions: expressions,
                patterns: patterns,
                closures: closures,
                effects: effects,
                propagation: propagation
              }
            ),
            expression
          )
        }
      }
    }
  }

  fn function(
    self: owned Self,
    signature: SemanticFunctionSignature,
    root: CheckedExprId
  ) -> owned CheckedBodyBuild {
    match self {
      CheckedBodyBuild(storage) -> {
        let { signatures, expressions, patterns, closures, effects, propagation } = storage
        CheckedBodyBuild(
          CheckedBodyBuildStorage {
            signatures: signatures,
            expressions: expressions.function(signature.identity, root),
            patterns: patterns,
            closures: closures,
            effects: effects,
            propagation: propagation
          }
        )
      }
    }
  }

  fn freeze(self: owned Self) -> CheckedBodyCheckResult {
    match self {
      CheckedBodyBuild(storage) -> {
        let { signatures, expressions, patterns, closures, effects, propagation } = storage
        match checked_body_product(
          signatures,
          expressions.freeze(),
          patterns.freeze(),
          closures.freeze(),
          effects.freeze(),
          propagation.freeze()
        ) {
          CheckedBodyProductAccepted(product) -> CheckedBodiesAccepted(product)
          CheckedBodyProductRejected(issue) -> CheckedBodiesRejected(
            CheckedBodyProducerFreezeRejected(issue)
          )
        }
      }
    }
  }
}

impl Drop for CheckedBodyBuild {
  fn drop(self) -> nil {
    match self {
      CheckedBodyBuild(storage) -> {
        let { signatures: _, expressions, patterns, closures, effects, propagation } = storage
        expressions.drop()
        patterns.drop()
        closures.drop()
        effects.drop()
        propagation.drop()
      }
    }
  }
}

fn checked_body_parameters(
  state: owned CheckedBodyBuild,
  source: Source,
  catalog: SemanticTypeCatalog,
  signature: SemanticFunctionSignature,
  parameters: ParamList,
  index: usize,
  environment: CheckedLexicalEnvironment
) -> CheckedBodyParametersBuild {
  match parameters {
    ParamListNil -> if index == semantic_function_parameter_count(catalog, signature) {
      CheckedBodyParametersBuilt(state, environment)
    } else {
      CheckedBodyParametersRejected(state, CheckedBodyProducerUnsupportedParameter)
    }
    ParamListCons(parameter, rest) -> match parameter {
      Param(start, length, _, _) -> match source_range(source, start, length) {
        range: CheckedSourceRange -> {
          let value_type = semantic_function_parameter(catalog, signature, index)
          match state.binding(
            signature.identity,
            value_type,
            range,
            CheckedImmutableBinding
          ) {
            (state, binding) -> checked_body_parameters(
              state.function_parameter(binding),
              source,
              catalog,
              signature,
              rest,
              index + 1,
              CheckedLexicalBinding(
                start,
                length,
                binding,
                value_type,
                false,
                environment
              )
            )
          }
        }
        nil -> CheckedBodyParametersRejected(state, CheckedBodyProducerInvalidRange)
      }
      _ -> CheckedBodyParametersRejected(
        state,
        CheckedBodyProducerUnsupportedParameter
      )
    }
  }
}

fn expectation_allows(
  catalog: borrow SemanticTypeCatalog,
  actual: SemanticTypeId,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> bool {
  match expectation {
    CheckedInferResult -> true
    CheckedRequireResult(expected) -> semantic_type_is_subtype(catalog, actual, expected)
  }
}

fn expectation_mismatch(
  actual: SemanticTypeId,
  expectation: CheckedBodyExpectation
) -> CheckedBodyProducerIssue {
  match expectation {
    CheckedRequireResult(expected) -> CheckedBodyProducerTypeMismatch(actual, expected)
    CheckedInferResult -> panic("Inferred checked expression cannot mismatch its context")
  }
}

fn contextual_integer_type(
  catalog: borrow SemanticTypeCatalog,
  fallback: SemanticTypeId,
  expectation: CheckedBodyExpectation
) -> SemanticTypeId {
  match expectation {
    CheckedRequireResult(expected) -> if semantic_integer_type(catalog, expected) {
      expected
    } else { fallback }
    CheckedInferResult -> fallback
  }
}

fn branch_expectations(
  expectation: CheckedBodyExpectation
) -> (CheckedBodyExpectation, CheckedBodyExpectation, CheckedBodyExpectation) {
  match expectation {
    CheckedInferResult -> (
      CheckedInferResult,
      CheckedInferResult,
      CheckedInferResult
    )
    CheckedRequireResult(expected) -> (
      CheckedRequireResult(expected),
      CheckedRequireResult(expected),
      CheckedRequireResult(expected)
    )
  }
}

fn checked_branch_result(
  expectation: CheckedBodyExpectation,
  then_type: SemanticTypeId,
  else_type: SemanticTypeId
) -> CheckedBranchResult {
  match expectation {
    CheckedRequireResult(expected) -> CheckedBranchResolved(expected)
    CheckedInferResult -> if semantic_type_id_eq(then_type, else_type) {
      CheckedBranchResolved(then_type)
    } else { CheckedBranchMismatch }
  }
}

fn checked_body_block(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  environment: CheckedLexicalEnvironment,
  first: Expr,
  rest: Expr,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  match checked_body_expr(
    state,
    source,
    types,
    owner,
    function_result,
    environment,
    first,
    CheckedInferResult
  ) {
    CheckedBodyExprBuilt(state, checked_first) -> match checked_body_expr(
      state,
      source,
      types,
      owner,
      function_result,
      environment,
      rest,
      expectation
    ) {
      CheckedBodyExprBuilt(state, checked_rest) -> {
        let result = state.result_type(checked_rest)
        let first_range = state.range(checked_first)
        let rest_range = state.range(checked_rest)
        if rest_range.end < first_range.start {
          CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
        } else {
          match state.block(
            checked_first,
            checked_rest,
            result,
            CheckedSourceRange { start: first_range.start, end: rest_range.end }
          ) {
            (state, expression) -> CheckedBodyExprBuilt(state, expression)
          }
        }
      }
      CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
    }
    CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
  }
}

fn checked_body_if(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  environment: CheckedLexicalEnvironment,
  condition: Expr,
  then_branch: Expr,
  else_branch: Expr,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  let (then_expectation, else_expectation, result_expectation) = branch_expectations(
    expectation
  )
  match checked_body_expr(
    state,
    source,
    types,
    owner,
    function_result,
    environment,
    condition,
    CheckedRequireResult(types.boolean)
  ) {
    CheckedBodyExprBuilt(state, checked_condition) -> match checked_body_expr(
      state,
      source,
      types,
      owner,
      function_result,
      environment,
      then_branch,
      then_expectation
    ) {
      CheckedBodyExprBuilt(state, checked_then) -> match checked_body_expr(
        state,
        source,
        types,
        owner,
        function_result,
        environment,
        else_branch,
        else_expectation
      ) {
        CheckedBodyExprBuilt(state, checked_else) -> {
          let then_type = state.result_type(checked_then)
          let else_type = state.result_type(checked_else)
          match checked_branch_result(result_expectation, then_type, else_type) {
            CheckedBranchResolved(result) -> {
              let condition_range = state.range(checked_condition)
              let else_range = state.range(checked_else)
              if else_range.end < condition_range.start {
                CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
              } else {
                match state.if_expr(
                  checked_condition,
                  checked_then,
                  checked_else,
                  result,
                  CheckedSourceRange {
                    start: condition_range.start,
                    end: else_range.end
                  }
                ) {
                  (state, expression) -> CheckedBodyExprBuilt(state, expression)
                }
              }
            }
            CheckedBranchMismatch -> CheckedBodyExprRejected(
              state,
              CheckedBodyProducerInferredBranchMismatch(then_type, else_type)
            )
          }
        }
        CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
      }
      CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
    }
    CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
  }
}

fn checked_body_while(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  environment: CheckedLexicalEnvironment,
  condition: Expr,
  body: Expr,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  let catalog = types.catalog
  if not expectation_allows(catalog, types.nil_type, expectation) {
    CheckedBodyExprRejected(
      state,
      expectation_mismatch(types.nil_type, expectation)
    )
  } else {
    match checked_body_expr(
      state,
      source,
      types,
      owner,
      function_result,
      environment,
      condition,
      CheckedRequireResult(types.boolean)
    ) {
      CheckedBodyExprBuilt(state, checked_condition) -> match checked_body_expr(
        state,
        source,
        types,
        owner,
        function_result,
        environment,
        body,
        CheckedInferResult
      ) {
        CheckedBodyExprBuilt(state, checked_body) -> {
          let condition_range = state.range(checked_condition)
          let body_range = state.range(checked_body)
          if body_range.end < condition_range.start {
            CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
          } else {
            match state.while_expr(
              checked_condition,
              checked_body,
              types.nil_type,
              CheckedSourceRange {
                start: condition_range.start,
                end: body_range.end
              }
            ) {
              (state, expression) -> CheckedBodyExprBuilt(state, expression)
            }
          }
        }
        CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
      }
      CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
    }
  }
}

fn checked_body_let(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  environment: CheckedLexicalEnvironment,
  start: i64,
  length: i64,
  value: Expr,
  body: Expr,
  mutable: bool,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  match source_range(source, start, length) {
    binding_range: CheckedSourceRange -> match checked_body_expr(
      state,
      source,
      types,
      owner,
      function_result,
      environment,
      value,
      CheckedInferResult
    ) {
      CheckedBodyExprBuilt(state, checked_value) -> {
        let value_type = state.result_type(checked_value)
        let mutability = if mutable {
          CheckedMutableBinding
        } else { CheckedImmutableBinding }
        match state.binding(owner, value_type, binding_range, mutability) {
          (state, binding) -> match checked_body_expr(
            state,
            source,
            types,
            owner,
            function_result,
            CheckedLexicalBinding(
              start,
              length,
              binding,
              value_type,
              mutable,
              environment
            ),
            body,
            expectation
          ) {
            CheckedBodyExprBuilt(state, checked_body) -> {
              let result = state.result_type(checked_body)
              let body_range = state.range(checked_body)
              if body_range.end < binding_range.start {
                CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
              } else {
                match state.let_binding(
                  binding,
                  checked_value,
                  checked_body,
                  mutable,
                  result,
                  CheckedSourceRange {
                    start: binding_range.start,
                    end: body_range.end
                  }
                ) {
                  (state, expression) -> CheckedBodyExprBuilt(state, expression)
                }
              }
            }
            CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
          }
        }
      }
      CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
    }
    nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
  }
}

fn checked_body_assign(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  environment: CheckedLexicalEnvironment,
  start: i64,
  length: i64,
  value: Expr,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  let catalog = types.catalog
  match source_range(source, start, length) {
    name_range: CheckedSourceRange -> match lexical_lookup(
      environment,
      source,
      start,
      length
    ) {
      CheckedLexicalFound(binding, value_type, true) -> if expectation_allows(
        catalog,
        types.nil_type,
        expectation
      ) {
        match checked_body_expr(
          state,
          source,
          types,
          owner,
          function_result,
          environment,
          value,
          CheckedRequireResult(value_type)
        ) {
          CheckedBodyExprBuilt(state, checked_value) -> {
            let value_range = state.range(checked_value)
            if value_range.end < name_range.start {
              CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
            } else {
              match state.assign(
                binding,
                checked_value,
                types.nil_type,
                CheckedSourceRange { start: name_range.start, end: value_range.end }
              ) {
                (state, expression) -> CheckedBodyExprBuilt(state, expression)
              }
            }
          }
          CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
        }
      } else {
        CheckedBodyExprRejected(
          state,
          expectation_mismatch(types.nil_type, expectation)
        )
      }
      CheckedLexicalFound(_, _, false) -> CheckedBodyExprRejected(
        state,
        CheckedBodyProducerImmutableAssignment(name_range)
      )
      CheckedLexicalMissing -> CheckedBodyExprRejected(
        state,
        CheckedBodyProducerUnknownIdentifier(name_range)
      )
    }
    nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
  }
}

fn checked_body_expr(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  environment: CheckedLexicalEnvironment,
  authored: Expr,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  let catalog = types.catalog
  match authored {
    Block(first, rest) -> checked_body_block(
      state,
      source,
      types,
      owner,
      function_result,
      environment,
      first,
      rest,
      expectation
    )
    If(condition, then_branch, else_branch) -> checked_body_if(
      state,
      source,
      types,
      owner,
      function_result,
      environment,
      condition,
      then_branch,
      else_branch,
      expectation
    )
    While(condition, body) -> checked_body_while(
      state,
      source,
      types,
      owner,
      function_result,
      environment,
      condition,
      body,
      expectation
    )
    Let(start, length, value, body) -> checked_body_let(
      state,
      source,
      types,
      owner,
      function_result,
      environment,
      start,
      length,
      value,
      body,
      false,
      expectation
    )
    LetMut(start, length, value, body) -> checked_body_let(
      state,
      source,
      types,
      owner,
      function_result,
      environment,
      start,
      length,
      value,
      body,
      true,
      expectation
    )
    Assign(start, length, value) -> checked_body_assign(
      state,
      source,
      types,
      owner,
      function_result,
      environment,
      start,
      length,
      value,
      expectation
    )
    Return(value) -> match checked_body_expr(
      state,
      source,
      types,
      owner,
      function_result,
      environment,
      value,
      CheckedRequireResult(function_result)
    ) {
      CheckedBodyExprBuilt(state, checked_value) -> {
        let range = state.range(checked_value)
        if expectation_allows(catalog, types.never_type, expectation) {
          match state.return_expr(checked_value, types.never_type, range) {
            (state, expression) -> CheckedBodyExprBuilt(state, expression)
          }
        } else {
          CheckedBodyExprRejected(
            state,
            expectation_mismatch(types.never_type, expectation)
          )
        }
      }
      CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
    }
    ReturnNoValue -> if semantic_type_is_subtype(
      catalog,
      types.nil_type,
      function_result
    ) and expectation_allows(catalog, types.never_type, expectation) {
      match state.return_no_value(
        types.never_type,
        CheckedSourceRange { start: 0, end: 0 }
      ) {
        (state, expression) -> CheckedBodyExprBuilt(state, expression)
      }
    } else {
      CheckedBodyExprRejected(
        state,
        CheckedBodyProducerTypeMismatch(types.nil_type, function_result)
      )
    }
    IntLit(value, start, length) -> match source_range(source, start, length) {
      range: CheckedSourceRange -> {
        let actual = contextual_integer_type(catalog, types.integer, expectation)
        if expectation_allows(catalog, actual, expectation) {
          match state.integer(value, actual, range) {
            (state, expression) -> CheckedBodyExprBuilt(state, expression)
          }
        } else {
          CheckedBodyExprRejected(
            state,
            expectation_mismatch(actual, expectation)
          )
        }
      }
      nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
    }
    BoolLit(value, start, length) -> match source_range(source, start, length) {
      range: CheckedSourceRange -> if expectation_allows(
        catalog,
        types.boolean,
        expectation
      ) {
        match state.boolean(value != 0, types.boolean, range) {
          (state, expression) -> CheckedBodyExprBuilt(state, expression)
        }
      } else {
        CheckedBodyExprRejected(
          state,
          expectation_mismatch(types.boolean, expectation)
        )
      }
      nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
    }
    NilExpr -> if expectation_allows(catalog, types.nil_type, expectation) {
      match state.nil(
        types.nil_type,
        CheckedSourceRange { start: 0, end: 0 }
      ) {
        (state, expression) -> CheckedBodyExprBuilt(state, expression)
      }
    } else {
      CheckedBodyExprRejected(
        state,
        expectation_mismatch(types.nil_type, expectation)
      )
    }
    Ident(start, length) -> match source_range(source, start, length) {
      range: CheckedSourceRange -> match lexical_lookup(
        environment,
        source,
        start,
        length
      ) {
        CheckedLexicalFound(binding, actual, _) -> if expectation_allows(
          catalog,
          actual,
          expectation
        ) {
          match state.local_reference(binding, actual, range) {
            (state, expression) -> CheckedBodyExprBuilt(state, expression)
          }
        } else {
          CheckedBodyExprRejected(
            state,
            expectation_mismatch(actual, expectation)
          )
        }
        CheckedLexicalMissing -> CheckedBodyExprRejected(
          state,
          CheckedBodyProducerUnknownIdentifier(range)
        )
      }
      nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
    }
    _ -> CheckedBodyExprRejected(state, CheckedBodyProducerUnsupportedExpression)
  }
}

fn checked_body_functions(
  module: RegisteredModule,
  types: CheckedBodyPrimitiveTypes,
  index: usize,
  state: owned CheckedBodyBuild
) -[SemanticConformance]> CheckedBodyFunctionsBuild {
  let functions = module.functions
  let catalog = types.catalog
  if index >= functions.len() { CheckedBodyFunctionsBuilt(state) }
  else {
    let function = functions.at(dense_index(index))
    let signature = state.signature(index)
    let expected = semantic_function_result(catalog, signature)
    match checked_body_parameters(
      state,
      module.source,
      catalog,
      signature,
      function.syntax.params,
      0,
      CheckedLexicalEmpty
    ) {
      CheckedBodyParametersBuilt(state, environment) -> match checked_body_expr(
        state,
        module.source,
        types,
        signature.identity,
        expected,
        environment,
        function.syntax.body,
        CheckedRequireResult(expected)
      ) {
        CheckedBodyExprBuilt(state, root) -> checked_body_functions(
          module,
          types,
          index + 1,
          state.function(signature, root)
        )
        CheckedBodyExprRejected(state, issue) -> CheckedBodyFunctionsRejected(state, issue)
      }
      CheckedBodyParametersRejected(state, issue) -> CheckedBodyFunctionsRejected(
        state,
        issue
      )
    }
  }
}

pub(package) fn check_registered_bodies(
  module: RegisteredModule,
  scope: RegistrationScope,
  signatures: SemanticSignatureProduct
) -[SemanticConformance]> CheckedBodyCheckResult {
  match checked_body_primitive_types(module, scope, signatures) {
    CheckedBodyPrimitivesResolved(types) -> match checked_body_functions(
      module,
      types,
      0,
      checked_body_build(module, signatures, types)
    ) {
      CheckedBodyFunctionsBuilt(state) -> state.freeze()
      CheckedBodyFunctionsRejected(state, issue) -> {
        state.drop()
        CheckedBodiesRejected(issue)
      }
    }
    CheckedBodyPrimitivesRejected(issue) -> CheckedBodiesRejected(
      CheckedBodyProducerTypeRejected(issue)
    )
  }
}
