      CheckedBodyBuild(storage) -> {
        let { signatures, expressions, patterns, closures, effects, propagation } = storage
        match propagation.failure(
          expressions,
          CheckedFailurePropagation {
            value: value,
            atom: atom,
            operator_range: operator_range
          }
        ) {
          (propagation, detail) -> match expressions.failure_propagation(detail, result, range) {
            (expressions, expression) -> (
              CheckedBodyBuild(
                CheckedBodyBuildStorage {
                  signatures: signatures,
                  expressions: expressions,
                  patterns: patterns,
                  closures: closures,
                  effects: effects,
                  propagation: propagation
                }
              ),
              expression
