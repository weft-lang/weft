  fn handle_expr(
    self: owned Self,
    body: CheckedExprId,
    clauses: CheckedHandlerClauseListId,
    return_clause: CheckedHandleReturn,
    result: SemanticTypeId,
    range: CheckedSourceRange
  ) -> (owned CheckedBodyBuild, CheckedExprId) {
    match self {
      CheckedBodyBuild(storage) -> {
        let { signatures, expressions, patterns, closures, effects, propagation } = storage
        match effects.handle_expr(
          expressions,
          CheckedHandle {
            body: body,
            clauses: clauses,
            return_clause: return_clause
          }
        ) {
