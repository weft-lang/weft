  }

  fn optional_projection(
    self: owned Self,
    base: CheckedExprId,
    projection: CheckedProjection,
    atom: SemanticTypeId,
    field_range: CheckedSourceRange,
    result: SemanticTypeId,
    range: CheckedSourceRange
  ) -> (owned CheckedBodyBuild, CheckedExprId) {
    match self {
      CheckedBodyBuild(storage) -> {
        let { signatures, expressions, patterns, closures, effects, propagation } = storage
        let detail = CheckedOptionalProjection {
          base: base,
          projection: projection,
          atom: atom,
          field_range: field_range
        }
        match projection {
          CheckedDeclaredProjection(_, _) -> match propagation.declared_optional_projection(
            expressions,
            detail
          ) {
            (propagation, selected) -> match expressions.declared_optional_projection(
              selected,
              result,
              range
            ) {
              (expressions, expression) -> (
                CheckedBodyBuild(
                  CheckedBodyBuildStorage {
                    signatures: signatures,
                    expressions: expressions,
                    patterns: patterns,
                    closures: closures,
                    effects: effects,
                    propagation: propagation
                  }
                ),
                expression
              )
            }
          }
          CheckedStructuralProjection(_, _) -> match propagation.structural_optional_projection(
            expressions,
            detail
          ) {
            (propagation, selected) -> match expressions.structural_optional_projection(
              selected,
              result,
              range
            ) {
              (expressions, expression) -> (
                CheckedBodyBuild(
                  CheckedBodyBuildStorage {
                    signatures: signatures,
                    expressions: expressions,
                    patterns: patterns,
                    closures: closures,
                    effects: effects,
                    propagation: propagation
                  }
                ),
                expression
              )
            }
          }
        }
      }
    }
  }

