  CheckedLexicalRoot(RegistrationScope, ModuleIdentity),
  CheckedLexicalBinding(
    i64,
    i64,
    CheckedBindingId,
    SemanticTypeId,
    bool,
    CheckedLexicalEnvironment
  )
}

type CheckedLexicalLookup {
  CheckedLexicalFound(CheckedBindingId, SemanticTypeId, bool),
  CheckedLexicalMissing
}

