    arguments: CheckedExprListId,
    result: SemanticTypeId,
    range: CheckedSourceRange
  ) -> (owned CheckedBodyBuild, CheckedExprId) {
    match self {
      CheckedBodyBuild(storage) -> {
        let { signatures, expressions, patterns, closures, effects, propagation } = storage
        match expressions.direct_call(function, arguments, result, range) {
          (expressions, expression) -> (
            CheckedBodyBuild(
              CheckedBodyBuildStorage {
                signatures: signatures,
                expressions: expressions,
                patterns: patterns,
                closures: closures,
                effects: effects,
                propagation: propagation
              }
            ),
            expression
          )
        }
      }
    }
  }

  fn generic_call(
    self: owned Self,
    callee: CheckedExprId,
    arguments: List<SemanticTypeId>,
    result: SemanticTypeId,
    range: CheckedSourceRange
  ) -> (owned CheckedBodyBuild, CheckedExprId) {
    match self {
      CheckedBodyBuild(storage) -> {
        let { signatures, expressions, patterns, closures, effects, propagation } = storage
        let (expressions, list) = expressions.type_list()
        let (expressions, list) = checked_body_type_arguments_into(
          expressions,
          list,
          arguments
        )
        let (expressions, type_arguments) = expressions.finish_type_list(list)
        match expressions.generic_call(callee, type_arguments, result, range) {
          (expressions, expression) -> (
            CheckedBodyBuild(
              CheckedBodyBuildStorage {
                signatures: signatures,
                expressions: expressions,
                patterns: patterns,
                closures: closures,
                effects: effects,
                propagation: propagation
              }
