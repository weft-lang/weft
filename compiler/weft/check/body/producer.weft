-- Authored Weft expressions to one immutable checked-body product.
--
-- This is the eventual sole body producer. While the exhaustive traversal is
-- being completed it remains outside normal compilation and rejects every
-- unimplemented authored form structurally; it never falls back to raw nodes.

use compiler/ir/data.{
  Assign,
  Block,
  BoolLit,
  Expr,
  Ident,
  If,
  IntLit,
  Let,
  LetMut,
  NeverTypeExpr,
  NilExpr,
  Param,
  ParamList,
  ParamListCons,
  ParamListNil,
  PrimitiveTypeExpr,
  Return,
  ReturnNoValue,
  TypeParamListNil,
  While
}
use compiler/project/identity.{FunctionIdentity}
use compiler/types/graph.{
  SemanticBool,
  SemanticF32,
  SemanticF64,
  SemanticFunctionNode,
  SemanticI16,
  SemanticI32,
  SemanticI64,
  SemanticI8,
  SemanticIsize,
  SemanticPrimitiveNode,
  SemanticTypeId,
  SemanticU16,
  SemanticU32,
  SemanticU64,
  SemanticU8,
  SemanticUsize,
  semantic_type_graph_list_type_id,
  semantic_type_graph_node,
  semantic_type_graph_type_lists_local,
  semantic_type_id_eq,
  semantic_type_list_edge,
  semantic_type_list_len
}
use compiler/types/graph/catalog.{SemanticTypeCatalog}
use compiler/types/graph/conformance.{SemanticConformance}
