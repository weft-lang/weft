-- Authored Weft expressions to one immutable checked-body product.
--
-- This is the eventual sole body producer. While the exhaustive traversal is
-- being completed it remains outside normal compilation and rejects every
-- unimplemented authored form structurally; it never falls back to raw nodes.

use compiler/ir/data.{
  BoolLit,
  Expr,
  IntLit,
  NilExpr,
  PrimitiveTypeExpr,
  TypeParamListNil
}
use compiler/types/graph.{
  SemanticBool,
  SemanticF32,
  SemanticF64,
  SemanticFunctionNode,
  SemanticI16,
  SemanticI32,
  SemanticI64,
  SemanticI8,
  SemanticIsize,
  SemanticPrimitiveNode,
  SemanticTypeId,
  SemanticU16,
  SemanticU32,
  SemanticU64,
  SemanticU8,
  SemanticUsize,
  semantic_type_graph_node
}
use compiler/types/graph/catalog.{SemanticTypeCatalog}
use compiler/types/graph/conformance.{SemanticConformance}
use compiler/types/graph/subtyping.{semantic_type_is_subtype}
use compiler/weft/check/body/closure.{CheckedClosureBuilder, checked_closure_builder}
use compiler/weft/check/body/effects.{CheckedEffectBuilder, checked_effect_builder}
use compiler/weft/check/body/graph.{
  CheckedExprGraphBuilder,
  CheckedExprId,
  CheckedSourceRange,
  checked_expr_graph_builder
}
use compiler/weft/check/body/pattern.{
  CheckedPatternGraphBuilder,
  checked_pattern_graph_builder
}
use compiler/weft/check/body/product.{
  CheckedBodyProduct,
  CheckedBodyProductAccepted,
  CheckedBodyProductIssue,
  CheckedBodyProductRejected,
  checked_body_product
}
use compiler/weft/check/body/propagation.{
  CheckedPropagationBuilder,
  checked_propagation_builder
}
use compiler/weft/check/registration/catalog.{RegisteredModule}
use compiler/weft/check/registration/scope.{RegistrationScope}
use compiler/weft/check/semantic_types.{
  SemanticTypeProductBuilder,
  SemanticTypeRejected,
  SemanticTypeResolutionIssue,
  SemanticTypeResolved,
  resolve_type_product_in_scope,
  semantic_type_product_catalog
}
use compiler/weft/check/signatures.{SemanticFunctionSignature, SemanticSignatureProduct}
use compiler/weft/check/storage.{dense_index}
use stdlib/drop.{Drop}
use stdlib/option.{Some}
use stdlib/panic.{panic}
use stdlib/source.{Source}

pub(package) type CheckedBodyProducerIssue {
  CheckedBodyProducerTypeRejected(SemanticTypeResolutionIssue),
  CheckedBodyProducerInvalidRange,
  CheckedBodyProducerTypeMismatch(SemanticTypeId, SemanticTypeId),
  CheckedBodyProducerUnsupportedExpression,
  CheckedBodyProducerFreezeRejected(CheckedBodyProductIssue)
}

pub(package) type CheckedBodyCheckResult {
  CheckedBodiesAccepted(CheckedBodyProduct),
  CheckedBodiesRejected(CheckedBodyProducerIssue)
}

type CheckedBodyPrimitiveTypes {
  catalog: SemanticTypeCatalog,
  integer: SemanticTypeId,
  boolean: SemanticTypeId,
  nil_type: SemanticTypeId
}

type CheckedBodyPrimitiveResolution {
  CheckedBodyPrimitivesResolved(CheckedBodyPrimitiveTypes),
  CheckedBodyPrimitivesRejected(SemanticTypeResolutionIssue)
}

type CheckedBodyBuildStorage {
  signatures: SemanticSignatureProduct,
  expressions: owned CheckedExprGraphBuilder,
  patterns: owned CheckedPatternGraphBuilder,
  closures: owned CheckedClosureBuilder,
  effects: owned CheckedEffectBuilder,
  propagation: owned CheckedPropagationBuilder
}

type CheckedBodyBuild = opaque CheckedBodyBuildStorage

type CheckedBodyExprBuild {
  CheckedBodyExprBuilt(owned CheckedBodyBuild, CheckedExprId),
  CheckedBodyExprRejected(owned CheckedBodyBuild, CheckedBodyProducerIssue)
}

type CheckedBodyFunctionsBuild {
  CheckedBodyFunctionsBuilt(owned CheckedBodyBuild),
  CheckedBodyFunctionsRejected(owned CheckedBodyBuild, CheckedBodyProducerIssue)
}

fn checked_body_primitive_types(
  module: RegisteredModule,
  scope: RegistrationScope,
  signatures: borrow SemanticSignatureProduct
) -> CheckedBodyPrimitiveResolution {
  let product = signatures.continue_types()
  match resolve_type_product_in_scope(
    product,
    module,
    scope,
    TypeParamListNil,
    PrimitiveTypeExpr(0)
  ) {
    (product, SemanticTypeResolved(integer)) -> match resolve_type_product_in_scope(
      product,
      module,
      scope,
      TypeParamListNil,
      PrimitiveTypeExpr(2)
    ) {
      (product, SemanticTypeResolved(boolean)) -> match resolve_type_product_in_scope(
        product,
        module,
        scope,
        TypeParamListNil,
        PrimitiveTypeExpr(3)
      ) {
        (product, SemanticTypeResolved(nil_type)) -> CheckedBodyPrimitivesResolved(
          CheckedBodyPrimitiveTypes {
            catalog: semantic_type_product_catalog(product),
            integer: integer,
            boolean: boolean,
            nil_type: nil_type
          }
        )
        (_, SemanticTypeRejected(issue)) -> CheckedBodyPrimitivesRejected(issue)
      }
      (_, SemanticTypeRejected(issue)) -> CheckedBodyPrimitivesRejected(issue)
    }
    (_, SemanticTypeRejected(issue)) -> CheckedBodyPrimitivesRejected(issue)
  }
}

fn checked_body_build(
  module: RegisteredModule,
  signatures: SemanticSignatureProduct,
  types: CheckedBodyPrimitiveTypes
) -> owned CheckedBodyBuild {
  let functions = module.functions
  let expressions = checked_expr_graph_builder(
    module.identity,
    module.source,
    types.catalog,
    functions.len()
  )
  let patterns = checked_pattern_graph_builder(
    expressions.segment(),
    module.source,
    types.catalog
  )
  let closures = checked_closure_builder(expressions, 0)
  let effects = checked_effect_builder(expressions, 0)
  let propagation = checked_propagation_builder(expressions, 0)
  CheckedBodyBuild(
    CheckedBodyBuildStorage {
      signatures: signatures,
      expressions: expressions,
      patterns: patterns,
      closures: closures,
      effects: effects,
      propagation: propagation
    }
  )
}

fn source_range(
  source: Source,
  start: i64,
  length: i64
) -> CheckedSourceRange? {
  if start < 0 or length < 0 { nil }
  else {
    let first = __i64_to_usize(start)
    let count = __i64_to_usize(length)
    if first > source.text.len() or count > source.text.len() - first { nil }
    else { CheckedSourceRange { start: first, end: first + count } }
  }
}

fn semantic_function_result(
  catalog: borrow SemanticTypeCatalog,
  signature: SemanticFunctionSignature
) -> SemanticTypeId {
  match catalog.graph_for(signature.type_id) {
    Some(graph) -> match semantic_type_graph_node(graph, signature.type_id) {
      SemanticFunctionNode(_, result, _) -> result
      _ -> panic("Checked body signature is not a function type")
    }
    _ -> panic("Checked body signature is outside its type catalog")
  }
}

fn semantic_integer_type(
  catalog: borrow SemanticTypeCatalog,
  value: SemanticTypeId
) -> bool {
  match catalog.graph_for(value) {
    Some(graph) -> match semantic_type_graph_node(graph, value) {
      SemanticPrimitiveNode(primitive) -> match primitive {
        SemanticI64 -> true
        SemanticI32 -> true
        SemanticI8 -> true
        SemanticI16 -> true
        SemanticU8 -> true
        SemanticU16 -> true
        SemanticU32 -> true
        SemanticU64 -> true
        SemanticIsize -> true
        SemanticUsize -> true
        SemanticF32 -> false
        SemanticF64 -> false
        _ -> false
      }
      _ -> false
    }
    _ -> false
  }
}

impl CheckedBodyBuild {
  fn signature(self: borrow Self, index: usize) -> SemanticFunctionSignature {
    match self {
      CheckedBodyBuild(storage) -> {
        let { signatures, expressions: _, patterns: _, closures: _, effects: _, propagation: _ } = storage
        signatures.at(index)
      }
    }
  }

  fn integer(
    self: owned Self,
    value: i64,
    result: SemanticTypeId,
    range: CheckedSourceRange
  ) -> (owned CheckedBodyBuild, CheckedExprId) {
    match self {
      CheckedBodyBuild(storage) -> {
        let { signatures, expressions, patterns, closures, effects, propagation } = storage
        match expressions.integer(value, result, range) {
          (expressions, expression) -> (
            CheckedBodyBuild(
              CheckedBodyBuildStorage {
                signatures: signatures,
                expressions: expressions,
                patterns: patterns,
                closures: closures,
                effects: effects,
                propagation: propagation
              }
            ),
            expression
          )
        }
      }
    }
  }

  fn boolean(
    self: owned Self,
    value: bool,
    result: SemanticTypeId,
    range: CheckedSourceRange
  ) -> (owned CheckedBodyBuild, CheckedExprId) {
    match self {
      CheckedBodyBuild(storage) -> {
        let { signatures, expressions, patterns, closures, effects, propagation } = storage
        match expressions.boolean(value, result, range) {
          (expressions, expression) -> (
            CheckedBodyBuild(
              CheckedBodyBuildStorage {
                signatures: signatures,
                expressions: expressions,
                patterns: patterns,
                closures: closures,
                effects: effects,
                propagation: propagation
              }
            ),
            expression
          )
        }
      }
    }
  }

  fn nil(
    self: owned Self,
    result: SemanticTypeId,
    range: CheckedSourceRange
  ) -> (owned CheckedBodyBuild, CheckedExprId) {
    match self {
      CheckedBodyBuild(storage) -> {
        let { signatures, expressions, patterns, closures, effects, propagation } = storage
        match expressions.nil(result, range) {
          (expressions, expression) -> (
            CheckedBodyBuild(
              CheckedBodyBuildStorage {
                signatures: signatures,
                expressions: expressions,
                patterns: patterns,
                closures: closures,
                effects: effects,
                propagation: propagation
              }
            ),
            expression
          )
        }
      }
    }
  }

  fn function(
    self: owned Self,
    signature: SemanticFunctionSignature,
    root: CheckedExprId
  ) -> owned CheckedBodyBuild {
    match self {
      CheckedBodyBuild(storage) -> {
        let { signatures, expressions, patterns, closures, effects, propagation } = storage
        CheckedBodyBuild(
          CheckedBodyBuildStorage {
            signatures: signatures,
            expressions: expressions.function(signature.identity, root),
            patterns: patterns,
            closures: closures,
            effects: effects,
            propagation: propagation
          }
        )
      }
    }
  }

  fn freeze(self: owned Self) -> CheckedBodyCheckResult {
    match self {
      CheckedBodyBuild(storage) -> {
        let { signatures, expressions, patterns, closures, effects, propagation } = storage
        match checked_body_product(
          signatures,
          expressions.freeze(),
          patterns.freeze(),
          closures.freeze(),
          effects.freeze(),
          propagation.freeze()
        ) {
          CheckedBodyProductAccepted(product) -> CheckedBodiesAccepted(product)
          CheckedBodyProductRejected(issue) -> CheckedBodiesRejected(
            CheckedBodyProducerFreezeRejected(issue)
          )
        }
      }
    }
  }
}

impl Drop for CheckedBodyBuild {
  fn drop(self) -> nil {
    match self {
      CheckedBodyBuild(storage) -> {
        let { signatures: _, expressions, patterns, closures, effects, propagation } = storage
        expressions.drop()
        patterns.drop()
        closures.drop()
        effects.drop()
        propagation.drop()
      }
    }
  }
}

fn checked_body_expr(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  authored: Expr,
  expected: SemanticTypeId
) -[SemanticConformance]> CheckedBodyExprBuild {
  let catalog = types.catalog
  match authored {
    IntLit(value, start, length) -> match source_range(source, start, length) {
      range: CheckedSourceRange -> {
        let actual = if semantic_integer_type(catalog, expected) {
          expected
        } else { types.integer }
        if semantic_type_is_subtype(catalog, actual, expected) {
          match state.integer(value, actual, range) {
            (state, expression) -> CheckedBodyExprBuilt(state, expression)
          }
        } else {
          CheckedBodyExprRejected(
            state,
            CheckedBodyProducerTypeMismatch(actual, expected)
          )
        }
      }
      nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
    }
    BoolLit(value, start, length) -> match source_range(source, start, length) {
      range: CheckedSourceRange -> if semantic_type_is_subtype(
        catalog,
        types.boolean,
        expected
      ) {
        match state.boolean(value != 0, types.boolean, range) {
          (state, expression) -> CheckedBodyExprBuilt(state, expression)
        }
      } else {
        CheckedBodyExprRejected(
          state,
          CheckedBodyProducerTypeMismatch(types.boolean, expected)
        )
      }
      nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
    }
    NilExpr -> if semantic_type_is_subtype(catalog, types.nil_type, expected) {
      match state.nil(
        types.nil_type,
        CheckedSourceRange { start: 0, end: 0 }
      ) {
        (state, expression) -> CheckedBodyExprBuilt(state, expression)
      }
    } else {
      CheckedBodyExprRejected(
        state,
        CheckedBodyProducerTypeMismatch(types.nil_type, expected)
      )
    }
    _ -> CheckedBodyExprRejected(state, CheckedBodyProducerUnsupportedExpression)
  }
}

fn checked_body_functions(
  module: RegisteredModule,
  types: CheckedBodyPrimitiveTypes,
  index: usize,
  state: owned CheckedBodyBuild
) -[SemanticConformance]> CheckedBodyFunctionsBuild {
  let functions = module.functions
  let catalog = types.catalog
  if index >= functions.len() { CheckedBodyFunctionsBuilt(state) }
  else {
    let function = functions.at(dense_index(index))
    let signature = state.signature(index)
    let expected = semantic_function_result(catalog, signature)
    match checked_body_expr(state, module.source, types, function.syntax.body, expected) {
      CheckedBodyExprBuilt(state, root) -> checked_body_functions(
        module,
        types,
        index + 1,
        state.function(signature, root)
      )
      CheckedBodyExprRejected(state, issue) -> CheckedBodyFunctionsRejected(state, issue)
    }
  }
}

pub(package) fn check_registered_bodies(
  module: RegisteredModule,
  scope: RegistrationScope,
  signatures: SemanticSignatureProduct
) -[SemanticConformance]> CheckedBodyCheckResult {
  match checked_body_primitive_types(module, scope, signatures) {
    CheckedBodyPrimitivesResolved(types) -> match checked_body_functions(
      module,
      types,
      0,
      checked_body_build(module, signatures, types)
    ) {
      CheckedBodyFunctionsBuilt(state) -> state.freeze()
      CheckedBodyFunctionsRejected(state, issue) -> {
        state.drop()
        CheckedBodiesRejected(issue)
      }
    }
    CheckedBodyPrimitivesRejected(issue) -> CheckedBodiesRejected(
      CheckedBodyProducerTypeRejected(issue)
    )
  }
}
