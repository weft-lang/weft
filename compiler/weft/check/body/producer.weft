  fn freeze(self: owned Self) -> CheckedBodyCheckResult {
    match self {
      CheckedBodyBuild(storage) -> {
        let { signatures, expressions, patterns, closures, effects, propagation } = storage
        match checked_body_product(
          signatures,
          expressions.freeze(),
          patterns.freeze(),
          closures.freeze(),
          effects.freeze(),
          propagation.freeze()
        ) {
          CheckedBodyProductAccepted(product) -> CheckedBodiesAccepted(product)
          CheckedBodyProductRejected(issue) -> CheckedBodiesRejected(
            CheckedBodyProducerFreezeRejected(issue)
          )
        }
      }
    }
  }
}

impl Drop for CheckedBodyBuild {
  fn drop(self) -> nil {
    match self {
      CheckedBodyBuild(storage) -> {
        let { signatures: _, expressions, patterns, closures, effects, propagation } = storage
        expressions.drop()
        patterns.drop()
        closures.drop()
        effects.drop()
        propagation.drop()
      }
    }
  }
}

fn checked_body_parameters(
  state: owned CheckedBodyBuild,
  source: Source,
  catalog: SemanticTypeCatalog,
  signature: SemanticFunctionSignature,
  parameters: ParamList,
  index: usize,
  environment: CheckedLexicalEnvironment
) -> CheckedBodyParametersBuild {
  match parameters {
    ParamListNil -> if index == semantic_function_parameter_count(catalog, signature.type_id) {
      CheckedBodyParametersBuilt(state, environment)
    } else {
      CheckedBodyParametersRejected(state, CheckedBodyProducerUnsupportedParameter)
    }
    ParamListCons(parameter, rest) -> match parameter {
      Param(start, length, _, _) -> match source_range(source, start, length) {
        range: CheckedSourceRange -> {
          let value_type = semantic_function_parameter(catalog, signature.type_id, index)
          match state.binding(
            signature.identity,
            value_type,
            range,
            CheckedImmutableBinding
          ) {
            (state, binding) -> checked_body_parameters(
              state.function_parameter(binding),
              source,
              catalog,
              signature,
              rest,
              index + 1,
              CheckedLexicalBinding(
                start,
                length,
                binding,
                value_type,
                false,
                environment
              )
            )
          }
        }
        nil -> CheckedBodyParametersRejected(state, CheckedBodyProducerInvalidRange)
      }
      _ -> CheckedBodyParametersRejected(
        state,
        CheckedBodyProducerUnsupportedParameter
      )
    }
  }
}

fn expectation_allows(
  catalog: borrow SemanticTypeCatalog,
  actual: SemanticTypeId,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> bool {
  match expectation {
    CheckedInferResult -> true
    CheckedRequireResult(expected) -> semantic_type_is_subtype(catalog, actual, expected)
  }
}

fn expectation_mismatch(
  actual: SemanticTypeId,
  expectation: CheckedBodyExpectation
) -> CheckedBodyProducerIssue {
  match expectation {
    CheckedRequireResult(expected) -> CheckedBodyProducerTypeMismatch(actual, expected)
    CheckedInferResult -> panic("Inferred checked expression cannot mismatch its context")
  }
}

fn contextual_integer_type(
  catalog: borrow SemanticTypeCatalog,
  fallback: SemanticTypeId,
  expectation: CheckedBodyExpectation
) -> SemanticTypeId {
  match expectation {
    CheckedRequireResult(expected) -> if semantic_integer_type(catalog, expected) {
      expected
    } else { fallback }
    CheckedInferResult -> fallback
  }
}

fn contextual_float_type(
  catalog: borrow SemanticTypeCatalog,
  types: CheckedBodyPrimitiveTypes,
  expectation: CheckedBodyExpectation
) -> SemanticTypeId {
  match expectation {
    CheckedRequireResult(expected) -> if semantic_type_catalog_equal(
      catalog,
      expected,
      types.float32
    ) or semantic_type_catalog_equal(catalog, expected, types.float64) {
      expected
    } else { types.float64 }
    CheckedInferResult -> types.float64
  }
}

fn checked_float_literal_value(
  source: Source,
  start: i64,
  length: i64,
  float32: bool
) -> Option<f64> {
  let result = if float32 {
    runtime_float_decimal_f32_bits(
      __str_ptr(source.text),
      start,
      length
    )
  } else {
    runtime_float_decimal_f64_bits(
      __str_ptr(source.text),
      start,
      length
    )
  }
  if runtime_float_bits_result_ok(result) == 0 { None<f64>() }
  else {
    let bits = runtime_float_bits_result_bits(result)
    if float32 {
      Some<f64>(__f32_to_f64(runtime_f32_from_bits(__i64_to_u32(bits))))
    } else {
      Some<f64>(runtime_f64_from_bits(__i64_to_u64(bits)))
    }
  }
}

fn branch_expectations(
  expectation: CheckedBodyExpectation
) -> (CheckedBodyExpectation, CheckedBodyExpectation, CheckedBodyExpectation) {
  match expectation {
    CheckedInferResult -> (
      CheckedInferResult,
      CheckedInferResult,
      CheckedInferResult
    )
    CheckedRequireResult(expected) -> (
      CheckedRequireResult(expected),
      CheckedRequireResult(expected),
      CheckedRequireResult(expected)
    )
  }
}

fn negation_expectations(
  catalog: borrow SemanticTypeCatalog,
  expectation: CheckedBodyExpectation
) -> (CheckedBodyExpectation, CheckedBodyExpectation) {
  match expectation {
    CheckedInferResult -> (CheckedInferResult, CheckedInferResult)
    CheckedRequireResult(expected) -> if semantic_numeric_type(catalog, expected) {
      (CheckedRequireResult(expected), CheckedRequireResult(expected))
    } else { (CheckedInferResult, CheckedRequireResult(expected)) }
  }
}

fn checked_branch_result(
  expectation: CheckedBodyExpectation,
  then_type: SemanticTypeId,
  else_type: SemanticTypeId
) -> CheckedBranchResult {
  match expectation {
    CheckedRequireResult(expected) -> CheckedBranchResolved(expected)
    CheckedInferResult -> if semantic_type_id_eq(then_type, else_type) {
      CheckedBranchResolved(then_type)
    } else { CheckedBranchMismatch }
  }
}

fn checked_body_block(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  first: Expr,
  rest: Expr,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  match checked_body_expr(
    state,
    source,
    types,
    owner,
    function_result,
    loop_context,
    environment,
    first,
    CheckedInferResult
  ) {
    CheckedBodyExprBuilt(state, checked_first) -> match checked_body_expr(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      rest,
      expectation
    ) {
      CheckedBodyExprBuilt(state, checked_rest) -> {
        let result = state.result_type(checked_rest)
        let first_range = state.range(checked_first)
        let rest_range = state.range(checked_rest)
        match covering_range(first_range, rest_range) {
          range: CheckedSourceRange ->
            match state.block(
              checked_first,
              checked_rest,
              result,
              range
            ) {
              (state, expression) -> CheckedBodyExprBuilt(state, expression)
            }
          nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
        }
      }
      CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
    }
    CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
  }
}

fn checked_body_if(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  condition: Expr,
  then_branch: Expr,
  else_branch: Expr,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  let (then_expectation, else_expectation, result_expectation) = branch_expectations(
    expectation
  )
  match checked_body_expr(
    state,
    source,
    types,
    owner,
    function_result,
    loop_context,
    environment,
    condition,
    CheckedRequireResult(types.boolean)
  ) {
    CheckedBodyExprBuilt(state, checked_condition) -> match checked_body_expr(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      then_branch,
      then_expectation
    ) {
      CheckedBodyExprBuilt(state, checked_then) -> match checked_body_expr(
        state,
        source,
        types,
        owner,
        function_result,
        loop_context,
        environment,
        else_branch,
        else_expectation
      ) {
        CheckedBodyExprBuilt(state, checked_else) -> {
          let then_type = state.result_type(checked_then)
          let else_type = state.result_type(checked_else)
          match checked_branch_result(result_expectation, then_type, else_type) {
            CheckedBranchResolved(result) -> {
              let current_catalog = state.types()
              let then_continuation = semantic_continuation_type(current_catalog, then_type)
              let else_continuation = semantic_continuation_type(current_catalog, else_type)
              if then_continuation or else_continuation {
                let escaping_range = if then_continuation {
                  state.range(checked_then)
                } else { state.range(checked_else) }
                CheckedBodyExprRejected(
                  state,
                  CheckedBodyProducerContinuationBranchEscape(escaping_range)
                )
              } else {
                let condition_range = state.range(checked_condition)
                let else_range = state.range(checked_else)
                match covering_range(condition_range, else_range) {
                  range: CheckedSourceRange ->
                    match state.if_expr(
                      checked_condition,
                      checked_then,
                      checked_else,
                      result,
                      range
                    ) {
                      (state, expression) -> CheckedBodyExprBuilt(state, expression)
                    }
                  nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
                }
              }
            }
            CheckedBranchMismatch -> CheckedBodyExprRejected(
              state,
              CheckedBodyProducerInferredBranchMismatch(then_type, else_type)
            )
          }
        }
        CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
      }
      CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
    }
    CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
  }
}

fn checked_body_while(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  condition: Expr,
  body: Expr,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  let catalog = types.catalog
  if not expectation_allows(catalog, types.nil_type, expectation) {
    CheckedBodyExprRejected(
      state,
      expectation_mismatch(types.nil_type, expectation)
    )
  } else {
    match checked_body_expr(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      condition,
      CheckedRequireResult(types.boolean)
    ) {
      CheckedBodyExprBuilt(state, checked_condition) -> match checked_body_expr(
        state,
        source,
        types,
        owner,
        function_result,
        loop_context,
        environment,
        body,
        CheckedInferResult
      ) {
        CheckedBodyExprBuilt(state, checked_body) -> {
          let condition_range = state.range(checked_condition)
          let body_range = state.range(checked_body)
          match covering_range(condition_range, body_range) {
            range: CheckedSourceRange ->
              match state.while_expr(
                checked_condition,
                checked_body,
                types.nil_type,
                range
              ) {
                (state, expression) -> CheckedBodyExprBuilt(state, expression)
              }
            nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
          }
        }
        CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
      }
      CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
    }
  }
}

fn checked_body_loop(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  environment: CheckedLexicalEnvironment,
  body: Expr,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  match expectation {
    CheckedInferResult -> CheckedBodyExprRejected(
      state,
      CheckedBodyProducerLoopContextRequired
    )
    CheckedRequireResult(result) -> match checked_body_expr(
      state,
      source,
      types,
      owner,
      function_result,
      CheckedInsideLoop(result),
      environment,
      body,
      CheckedInferResult
    ) {
      CheckedBodyExprBuilt(state, checked_body) -> {
        let range = state.range(checked_body)
        match state.loop_expr(checked_body, result, range) {
          (state, expression) -> CheckedBodyExprBuilt(state, expression)
        }
      }
      CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
    }
  }
}

fn checked_body_let(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  start: i64,
  length: i64,
  value: Expr,
  body: Expr,
  mutable: bool,
  annotation: Option<SemanticTypeId>,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  let value_expectation = match annotation {
    Some(expected) -> CheckedRequireResult(expected)
    None -> CheckedInferResult
  }
  match source_range(source, start, length) {
    binding_range: CheckedSourceRange -> match checked_body_expr(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      value,
      value_expectation
    ) {
      CheckedBodyExprBuilt(state, checked_value) -> {
        let value_type = state.result_type(checked_value)
        let binding_type = match annotation {
          Some(declared) -> declared
          None -> value_type
        }
        let catalog = state.types()
        if semantic_continuation_type(catalog, value_type) and
          not semantic_continuation_type(catalog, binding_type) {
            CheckedBodyExprRejected(
              state,
              CheckedBodyProducerContinuationConsumerRequired(binding_range)
            )
          } else if mutable and semantic_continuation_type(catalog, value_type) {
            CheckedBodyExprRejected(
              state,
              CheckedBodyProducerContinuationMutableBinding(binding_range)
            )
          } else {
            let mutability = if mutable {
              CheckedMutableBinding
            } else { CheckedImmutableBinding }
            match state.binding(owner, binding_type, binding_range, mutability) {
              (state, binding) -> match checked_body_expr(
                state,
                source,
                types,
                owner,
                function_result,
                loop_context,
                CheckedLexicalBinding(
                  start,
                  length,
                  binding,
                  binding_type,
                  mutable,
                  environment
                ),
                body,
                expectation
              ) {
                CheckedBodyExprBuilt(state, checked_body) -> {
                  let result = state.result_type(checked_body)
                  let body_range = state.range(checked_body)
                  match covering_range(binding_range, body_range) {
                    range: CheckedSourceRange ->
                      match state.let_binding(
                        binding,
                        checked_value,
                        checked_body,
                        mutable,
                        result,
                        range
                      ) {
                        (state, expression) -> CheckedBodyExprBuilt(state, expression)
                      }
                    nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
                  }
                }
                CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
              }
            }
          }
      }
      CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
    }
    nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
  }
}

fn checked_body_typed_let(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  inner: Expr,
  annotation: TypeExpr,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  let module = types.module
  let resolution = types.resolution
  let catalog = state.types()
  let next_segment = catalog.next_derived_segment(
    module.identity,
    resolution.next_type_segment()
  )
  match resolve_type_product_in_scope(
    semantic_type_product_continue(module.identity, catalog, next_segment),
    module,
    lexical_scope(environment),
    lexical_type_parameters(environment),
    annotation
  ) {
    (_, SemanticTypeRejected(issue)) -> CheckedBodyExprRejected(
      state,
      CheckedBodyProducerTypeRejected(issue)
    )
    (product, SemanticTypeResolved(declared)) -> {
      let next_catalog = semantic_type_product_catalog(product)
      let next_types = checked_body_types_with_catalog(types, next_catalog)
      let state = state.with_types(next_catalog)
      match inner {
        Let(start, length, value, body) -> checked_body_let(
          state,
          source,
          next_types,
          owner,
          function_result,
          loop_context,
          environment,
          start,
          length,
          value,
          body,
          false,
          Some(declared),
          expectation
        )
        LetMut(start, length, value, body) -> checked_body_let(
          state,
          source,
          next_types,
          owner,
          function_result,
          loop_context,
          environment,
          start,
          length,
          value,
          body,
          true,
          Some(declared),
          expectation
        )
        _ -> CheckedBodyExprRejected(state, CheckedBodyProducerUnsupportedExpression)
      }
    }
  }
}

fn checked_body_assign(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  start: i64,
  length: i64,
  value: Expr,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  let catalog = types.catalog
  match source_range(source, start, length) {
    name_range: CheckedSourceRange -> match lexical_lookup(
      environment,
      source,
      start,
      length
    ) {
      CheckedLexicalFound(binding, value_type, true) -> if expectation_allows(
        catalog,
        types.nil_type,
        expectation
      ) {
        match checked_body_expr(
          state,
          source,
          types,
          owner,
          function_result,
          loop_context,
          environment,
          value,
          CheckedRequireResult(value_type)
        ) {
          CheckedBodyExprBuilt(state, checked_value) -> {
            let value_range = state.range(checked_value)
            match covering_range(name_range, value_range) {
              range: CheckedSourceRange ->
                match state.assign(
                  binding,
                  checked_value,
                  types.nil_type,
                  range
                ) {
                  (state, expression) -> CheckedBodyExprBuilt(state, expression)
                }
              nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
            }
          }
          CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
        }
      } else {
        CheckedBodyExprRejected(
          state,
          expectation_mismatch(types.nil_type, expectation)
        )
      }
      CheckedLexicalFound(_, _, false) -> CheckedBodyExprRejected(
        state,
        CheckedBodyProducerImmutableAssignment(name_range)
      )
      CheckedLexicalMissing -> CheckedBodyExprRejected(
        state,
        CheckedBodyProducerUnknownIdentifier(name_range)
      )
    }
    nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
  }
}

fn checked_body_not(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  operand: Expr,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  let catalog = types.catalog
  match checked_body_expr(
    state,
    source,
    types,
    owner,
    function_result,
    loop_context,
    environment,
    operand,
    CheckedRequireResult(types.boolean)
  ) {
    CheckedBodyExprBuilt(state, checked_operand) -> if expectation_allows(
      catalog,
      types.boolean,
      expectation
    ) {
      let range = state.range(checked_operand)
      match state.not_expr(checked_operand, types.boolean, range) {
        (state, expression) -> CheckedBodyExprBuilt(state, expression)
      }
    } else {
      CheckedBodyExprRejected(
        state,
        expectation_mismatch(types.boolean, expectation)
      )
    }
    CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
  }
}

fn checked_body_negate(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  operand: Expr,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  let catalog = types.catalog
  let (operand_expectation, result_expectation) = negation_expectations(
    catalog,
    expectation
  )
  match checked_body_expr(
    state,
    source,
    types,
    owner,
    function_result,
    loop_context,
    environment,
    operand,
    operand_expectation
  ) {
    CheckedBodyExprBuilt(state, checked_operand) -> {
      let actual = state.result_type(checked_operand)
      if not semantic_numeric_type(catalog, actual) {
        CheckedBodyExprRejected(
          state,
          CheckedBodyProducerNumericOperandRequired(actual)
        )
      } else {
        if expectation_allows(catalog, actual, result_expectation) {
          let range = state.range(checked_operand)
          match state.negate(checked_operand, actual, range) {
            (state, expression) -> CheckedBodyExprBuilt(state, expression)
          }
        } else {
          CheckedBodyExprRejected(
            state,
            expectation_mismatch(actual, result_expectation)
          )
        }
      }
    }
    CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
  }
}

fn checked_body_defer(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  cleanup: Expr,
  body: Expr,
  source_site: i64,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  match source_range(source, source_site, 5) {
    keyword_range: CheckedSourceRange -> match checked_body_expr(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      cleanup,
      CheckedInferResult
    ) {
      CheckedBodyExprBuilt(state, checked_cleanup) -> match checked_body_expr(
        state,
        source,
        types,
        owner,
        function_result,
        loop_context,
        environment,
        body,
        expectation
      ) {
        CheckedBodyExprBuilt(state, checked_body) -> {
          let result = state.result_type(checked_body)
          let cleanup_range = state.range(checked_cleanup)
          let body_range = state.range(checked_body)
          match covering_range(keyword_range, cleanup_range) {
            cleanup_site_range: CheckedSourceRange -> match covering_range(
              cleanup_site_range,
              body_range
            ) {
              range: CheckedSourceRange -> match state.defer_expr(
                checked_cleanup,
                checked_body,
                __i64_to_usize(source_site),
                result,
                range
              ) {
                (state, expression) -> CheckedBodyExprBuilt(state, expression)
              }
              nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
            }
            nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
          }
        }
        CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
      }
      CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
    }
    nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
  }
}

fn checked_body_binary_seed_expectation(
  catalog: borrow SemanticTypeCatalog,
  types: CheckedBodyPrimitiveTypes,
  class: CheckedBinaryOperandClass,
  result_rule: CheckedBinaryResultRule,
  expectation: CheckedBodyExpectation
) -> CheckedBodyExpectation {
  match class {
    CheckedBooleanOperands -> CheckedRequireResult(types.boolean)
    _ -> match result_rule {
      CheckedBooleanResult -> CheckedInferResult
      CheckedOperandResult -> match expectation {
        CheckedRequireResult(expected) -> if binary_operand_class_accepts(
          catalog,
          types.boolean,
          expected,
          class
        ) {
          CheckedRequireResult(expected)
        } else { CheckedInferResult }
        CheckedInferResult -> CheckedInferResult
      }
    }
  }
}

fn checked_body_homogeneous_binary_in_order(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  first: Expr,
  second: Expr,
  left_first: bool,
  class: CheckedBinaryOperandClass,
  result_rule: CheckedBinaryResultRule,
  seed_expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyBinaryBuild {
  let catalog = types.catalog
  match checked_body_expr(
    state,
    source,
    types,
    owner,
    function_result,
    loop_context,
    environment,
    first,
    seed_expectation
  ) {
    CheckedBodyExprBuilt(state, checked_first) -> {
      let first_type = state.result_type(checked_first)
      if not binary_operand_class_accepts(
        catalog,
        types.boolean,
        first_type,
        class
      ) {
        CheckedBodyBinaryRejected(
          state,
          binary_operand_issue(types.boolean, first_type, class)
        )
      } else {
        match checked_body_expr(
          state,
          source,
          types,
          owner,
          function_result,
          loop_context,
          environment,
          second,
          CheckedRequireResult(first_type)
        ) {
          CheckedBodyExprBuilt(state, checked_second) -> {
            let second_type = state.result_type(checked_second)
            if not binary_operand_class_accepts(
              catalog,
              types.boolean,
              second_type,
              class
            ) {
              CheckedBodyBinaryRejected(
                state,
                binary_operand_issue(types.boolean, second_type, class)
              )
            } else {
              if not semantic_type_catalog_equal(catalog, first_type, second_type) {
                CheckedBodyBinaryRejected(
                  state,
                  CheckedBodyProducerBinaryOperandMismatch(first_type, second_type)
                )
              } else {
                let left = if left_first { checked_first } else { checked_second }
                let right = if left_first { checked_second } else { checked_first }
                match covering_range(state.range(left), state.range(right)) {
                  range: CheckedSourceRange -> CheckedBodyBinaryBuilt(
                    state,
                    left,
                    right,
                    match result_rule {
                      CheckedOperandResult -> first_type
                      CheckedBooleanResult -> types.boolean
                    },
                    range
                  )
                  nil -> CheckedBodyBinaryRejected(
                    state,
                    CheckedBodyProducerInvalidRange
                  )
                }
              }
            }
          }
          CheckedBodyExprRejected(state, issue) -> CheckedBodyBinaryRejected(state, issue)
        }
      }
    }
    CheckedBodyExprRejected(state, issue) -> CheckedBodyBinaryRejected(state, issue)
  }
}

fn checked_body_homogeneous_binary(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  left: Expr,
  right: Expr,
  class: CheckedBinaryOperandClass,
  result_rule: CheckedBinaryResultRule,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyBinaryBuild {
  let catalog = types.catalog
  let seed = checked_body_binary_seed_expectation(
    catalog,
    types,
    class,
    result_rule,
    expectation
  )
  if contextual_integer_literal(left) and not contextual_integer_literal(right) {
    checked_body_homogeneous_binary_in_order(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      right,
      left,
      false,
      class,
      result_rule,
      seed
    )
  } else {
    checked_body_homogeneous_binary_in_order(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      left,
      right,
      true,
      class,
      result_rule,
      seed
    )
  }
}

fn checked_body_equality_in_order(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  operator_id: i64,
  first: Expr,
  second: Expr,
  left_first: bool
) -[SemanticConformance]> CheckedBodyBinaryBuild {
  let catalog = types.catalog
  match checked_body_expr(
    state,
    source,
    types,
    owner,
    function_result,
    loop_context,
    environment,
    first,
    CheckedInferResult
  ) {
    CheckedBodyExprBuilt(state, checked_first) -> {
      let first_type = state.result_type(checked_first)
      let second_expectation = if contextual_integer_literal(second) and
        semantic_integer_type(catalog, first_type) {
          CheckedRequireResult(first_type)
        } else { CheckedInferResult }
      match checked_body_expr(
        state,
        source,
        types,
        owner,
        function_result,
        loop_context,
        environment,
        second,
        second_expectation
      ) {
        CheckedBodyExprBuilt(state, checked_second) -> {
          let second_type = state.result_type(checked_second)
          let left = if left_first { checked_first } else { checked_second }
          let right = if left_first { checked_second } else { checked_first }
          let left_type = if left_first { first_type } else { second_type }
          let right_type = if left_first { second_type } else { first_type }
          if not primitive_equality_compatible(
            catalog,
            types.integer,
            left_type,
            right_type
          ) {
            if semantic_type_catalog_equal(catalog, left_type, right_type) {
              CheckedBodyBinaryRejected(
                state,
                CheckedBodyProducerOperatorDispatchRequired(operator_id, left_type)
              )
            } else {
              CheckedBodyBinaryRejected(
                state,
                CheckedBodyProducerBinaryOperandMismatch(left_type, right_type)
              )
            }
          } else {
            if not semantic_primitive_type(catalog, left_type) or
              not semantic_primitive_type(catalog, right_type) {
                CheckedBodyBinaryRejected(
                  state,
                  CheckedBodyProducerOperatorDispatchRequired(operator_id, left_type)
                )
              } else {
                match covering_range(state.range(left), state.range(right)) {
                  range: CheckedSourceRange -> CheckedBodyBinaryBuilt(
                    state,
                    left,
                    right,
                    types.boolean,
                    range
                  )
                  nil -> CheckedBodyBinaryRejected(
                    state,
                    CheckedBodyProducerInvalidRange
                  )
                }
              }
          }
        }
        CheckedBodyExprRejected(state, issue) -> CheckedBodyBinaryRejected(state, issue)
      }
    }
    CheckedBodyExprRejected(state, issue) -> CheckedBodyBinaryRejected(state, issue)
  }
}

fn checked_body_equality(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  operator_id: i64,
  left: Expr,
  right: Expr
) -[SemanticConformance]> CheckedBodyBinaryBuild {
  if contextual_integer_literal(left) and not contextual_integer_literal(right) {
    checked_body_equality_in_order(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      operator_id,
      right,
      left,
      false
    )
  } else {
    checked_body_equality_in_order(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      operator_id,
      left,
      right,
      true
    )
  }
}

fn checked_body_publish_binary(
  build: CheckedBodyBinaryBuild,
  catalog: borrow SemanticTypeCatalog,
  operator: CheckedBinaryOperator,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  match build {
    CheckedBodyBinaryBuilt(state, left, right, result, range) -> if expectation_allows(
      catalog,
      result,
      expectation
    ) {
      match state.binary(operator, left, right, result, range) {
        (state, expression) -> CheckedBodyExprBuilt(state, expression)
      }
    } else {
      CheckedBodyExprRejected(state, expectation_mismatch(result, expectation))
    }
    CheckedBodyBinaryRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
  }
}

fn checked_body_binary(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  operator_id: i64,
  left: Expr,
  right: Expr,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  let catalog = types.catalog
  match checked_binary_resolution(operator_id) {
    CheckedNumericBinary(operator) -> checked_body_publish_binary(
      checked_body_homogeneous_binary(
        state,
        source,
        types,
        owner,
        function_result,
        loop_context,
        environment,
        left,
        right,
        CheckedNumericOperands,
        CheckedOperandResult,
        expectation
      ),
      catalog,
      operator,
      expectation
    )
    CheckedIntegerBinary(operator) -> checked_body_publish_binary(
      checked_body_homogeneous_binary(
        state,
        source,
        types,
        owner,
        function_result,
        loop_context,
        environment,
        left,
        right,
        CheckedIntegerOperands,
        CheckedOperandResult,
        expectation
      ),
      catalog,
      operator,
      expectation
    )
    CheckedBooleanBinary(operator) -> checked_body_publish_binary(
      checked_body_homogeneous_binary(
        state,
        source,
        types,
        owner,
        function_result,
        loop_context,
        environment,
        left,
        right,
        CheckedBooleanOperands,
        CheckedBooleanResult,
        expectation
      ),
      catalog,
      operator,
      expectation
    )
    CheckedEqualityBinary(operator) -> checked_body_publish_binary(
      checked_body_equality(
        state,
        source,
        types,
        owner,
        function_result,
        loop_context,
        environment,
        operator_id,
        left,
        right
      ),
      catalog,
      operator,
      expectation
    )
    CheckedOrderingBinary(operator) -> checked_body_publish_binary(
      checked_body_homogeneous_binary(
        state,
        source,
        types,
        owner,
        function_result,
        loop_context,
        environment,
        left,
        right,
        CheckedNumericOperands,
        CheckedBooleanResult,
        expectation
      ),
      catalog,
      operator,
      expectation
    )
    CheckedBinaryUnsupported(value) -> CheckedBodyExprRejected(
      state,
      CheckedBodyProducerUnsupportedBinaryOperator(value)
    )
  }
}

fn checked_pattern_coverage_add(
  accumulated: CheckedPatternCoverage,
  next: CheckedPatternCoverage
) -> CheckedPatternCoverage {
  match (accumulated, next) {
    (CheckedPatternComplete, _) -> CheckedPatternComplete
    (_, CheckedPatternComplete) -> CheckedPatternComplete
    (CheckedPatternBooleanComplete, _) -> CheckedPatternBooleanComplete
    (_, CheckedPatternBooleanComplete) -> CheckedPatternBooleanComplete
    (CheckedPatternBooleanTrue, CheckedPatternBooleanFalse) ->
      CheckedPatternBooleanComplete
    (CheckedPatternBooleanFalse, CheckedPatternBooleanTrue) ->
      CheckedPatternBooleanComplete
    (CheckedPatternBooleanTrue, _) -> CheckedPatternBooleanTrue
    (_, CheckedPatternBooleanTrue) -> CheckedPatternBooleanTrue
    (CheckedPatternBooleanFalse, _) -> CheckedPatternBooleanFalse
    (_, CheckedPatternBooleanFalse) -> CheckedPatternBooleanFalse
    _ -> CheckedPatternOpen
  }
}

fn checked_pattern_coverage_complete(coverage: CheckedPatternCoverage) -> bool {
  match coverage {
    CheckedPatternComplete -> true
    CheckedPatternBooleanComplete -> true
    _ -> false
  }
}

fn checked_match_origin(origin: MatchOrigin) -> CheckedMatchOrigin {
  match origin {
    ExplicitMatch -> CheckedExplicitMatch
    LetDestructuring -> CheckedLetDestructuring
    ForDestructuring -> CheckedForDestructuring
  }
}

fn checked_body_pattern(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  environment: CheckedLexicalEnvironment,
  input_type: SemanticTypeId,
  authored: Pattern
) -[SemanticConformance]> CheckedBodyPatternBuild {
  let catalog = types.catalog
  match authored {
    Wildcard -> match state.wildcard_pattern(
      input_type,
      CheckedSourceRange { start: 0, end: 0 }
    ) {
      (state, pattern) -> CheckedBodyPatternBuilt(
        state,
        pattern,
        environment,
        CheckedPatternComplete,
        CheckedSourceRange { start: 0, end: 0 }
      )
    }
    Binding(start, length) -> match source_range(source, start, length) {
      range: CheckedSourceRange -> match state.binding(
        owner,
        input_type,
        range,
        CheckedImmutableBinding
      ) {
        (state, binding) -> match state.binding_pattern(
          binding,
          input_type,
          range
        ) {
          (state, pattern) -> CheckedBodyPatternBuilt(
            state,
            pattern,
            CheckedLexicalBinding(
              start,
              length,
              binding,
              input_type,
              false,
              environment
            ),
            CheckedPatternComplete,
            range
          )
        }
      }
      nil -> CheckedBodyPatternRejected(state, CheckedBodyProducerInvalidRange)
    }
    IntPattern(value, start, length, origin) -> match source_range(
      source,
      start,
      length
    ) {
      range: CheckedSourceRange -> match origin {
        NumericPatternOrigin -> if semantic_integer_type(catalog, input_type) {
          match state.integer_pattern(
            value,
            CheckedNumericPattern,
            input_type,
            range
          ) {
            (state, pattern) -> CheckedBodyPatternBuilt(
              state,
              pattern,
              environment,
              CheckedPatternOpen,
              range
            )
          }
        } else {
          CheckedBodyPatternRejected(
            state,
            CheckedBodyProducerIntegerOperandRequired(input_type)
          )
        }
        BooleanPatternOrigin -> if semantic_type_catalog_equal(
          catalog,
          input_type,
          types.boolean
        ) {
          match state.integer_pattern(
            value,
            CheckedBooleanPattern,
            input_type,
            range
          ) {
            (state, pattern) -> CheckedBodyPatternBuilt(
              state,
              pattern,
              environment,
              if value == 0 {
                CheckedPatternBooleanFalse
              } else { CheckedPatternBooleanTrue },
              range
            )
          }
        } else {
          CheckedBodyPatternRejected(
            state,
            CheckedBodyProducerTypeMismatch(input_type, types.boolean)
          )
        }
      }
      nil -> CheckedBodyPatternRejected(state, CheckedBodyProducerInvalidRange)
    }
    NilPattern(start, length) -> match source_range(source, start, length) {
      range: CheckedSourceRange -> if semantic_type_is_subtype(
        catalog,
        types.nil_type,
        input_type
      ) {
        match state.nil_pattern(input_type, range) {
          (state, pattern) -> CheckedBodyPatternBuilt(
            state,
            pattern,
            environment,
            if semantic_type_catalog_equal(catalog, input_type, types.nil_type) {
              CheckedPatternComplete
            } else { CheckedPatternOpen },
            range
          )
        }
      } else {
        CheckedBodyPatternRejected(
          state,
          CheckedBodyProducerTypeMismatch(types.nil_type, input_type)
        )
      }
      nil -> CheckedBodyPatternRejected(state, CheckedBodyProducerInvalidRange)
    }
    _ -> CheckedBodyPatternRejected(state, CheckedBodyProducerUnsupportedPattern)
  }
}

fn checked_match_arm_expectation(
  expectation: CheckedBodyExpectation
) -> CheckedBodyExpectation {
  match expectation {
    CheckedRequireResult(expected) -> CheckedRequireResult(expected)
    CheckedInferResult -> CheckedInferResult
  }
}

fn checked_match_arm_result(
  expectation: CheckedBodyExpectation,
  previous: CheckedMatchResult,
  body_type: SemanticTypeId
) -> CheckedMatchResult {
  if previous.resolved { previous }
  else {
    CheckedMatchResult {
      resolved: true,
      value: match expectation {
        CheckedRequireResult(expected) -> expected
        CheckedInferResult -> body_type
      }
    }
  }
}

fn checked_match_arm_coverage(
  accumulated: CheckedPatternCoverage,
  pattern: CheckedPatternCoverage,
  guarded: bool
) -> CheckedPatternCoverage {
  if guarded { accumulated }
  else { checked_pattern_coverage_add(accumulated, pattern) }
}

fn checked_match_arm_result_accepts(
  catalog: borrow SemanticTypeCatalog,
  expectation: CheckedBodyExpectation,
  previous: CheckedMatchResult,
  body_type: SemanticTypeId
) -> bool {
  match expectation {
    CheckedRequireResult(_) -> true
    CheckedInferResult -> if previous.resolved {
      semantic_type_catalog_equal(
        catalog,
        previous.value,
        body_type
      )
    } else { true }
  }
}

fn checked_body_match_arm_body(
  state: owned CheckedBodyBuild,
  context: CheckedMatchContext,
  environment: CheckedLexicalEnvironment,
  arm: CheckedPreparedMatchArm,
  progress: CheckedMatchProgress
) -[SemanticConformance]> CheckedBodyArmsBuild {
  let catalog = context.types.catalog
  match checked_body_expr(
    state,
    context.source,
    context.types,
    context.owner,
    context.function_result,
    context.loop_context,
    environment,
    arm.body,
    checked_match_arm_expectation(context.expectation)
  ) {
    CheckedBodyExprBuilt(state, checked_body) -> {
      let body_type = state.result_type(checked_body)
      let body_range = state.range(checked_body)
      let selected_result = checked_match_arm_result(
        context.expectation,
        progress.result,
        body_type
      )
      if semantic_continuation_type(catalog, body_type) {
        CheckedBodyArmsRejected(
          state,
          CheckedBodyProducerContinuationBranchEscape(body_range)
        )
      } else if not checked_match_arm_result_accepts(
        catalog,
        context.expectation,
        progress.result,
        body_type
      ) {
        CheckedBodyArmsRejected(
          state,
          CheckedBodyProducerInferredBranchMismatch(progress.result.value, body_type)
        )
      } else {
        match covering_range(arm.pattern_range, arm.guard_range) {
          guarded_range: CheckedSourceRange -> match covering_range(
            guarded_range,
            body_range
          ) {
            arm_range: CheckedSourceRange -> match state.match_arm_list_push(
              progress.list,
              arm.pattern,
              arm.guard,
              checked_body,
              arm_range
            ) {
              (state, list) -> match covering_range(progress.range, arm_range) {
                next_range: CheckedSourceRange -> checked_body_match_arms(
                  state,
                  context,
                  arm.rest,
                  CheckedMatchProgress {
                    list: list,
                    result: selected_result,
                    coverage: checked_match_arm_coverage(
                      progress.coverage,
                      arm.coverage,
                      match arm.guard {
                        CheckedUnguarded -> false
                        CheckedGuarded(_) -> true
                      }
                    ),
                    range: next_range
                  }
                )
                nil -> CheckedBodyArmsRejected(
                  state,
                  CheckedBodyProducerInvalidRange
                )
              }
            }
            nil -> CheckedBodyArmsRejected(state, CheckedBodyProducerInvalidRange)
          }
          nil -> CheckedBodyArmsRejected(state, CheckedBodyProducerInvalidRange)
        }
      }
    }
    CheckedBodyExprRejected(state, issue) -> CheckedBodyArmsRejected(state, issue)
  }
}

fn checked_body_match_arm(
  state: owned CheckedBodyBuild,
  context: CheckedMatchContext,
  arm: MatchArm,
  rest: MatchArmList,
  progress: CheckedMatchProgress
) -[SemanticConformance]> CheckedBodyArmsBuild {
  match arm {
    Arm(pattern, body, guard, has_guard) -> match checked_body_pattern(
      state,
      context.source,
      context.types,
      context.owner,
      context.environment,
      context.input_type,
      pattern
    ) {
      CheckedBodyPatternBuilt(
        state,
        checked_pattern,
        arm_environment,
        pattern_coverage,
        pattern_range,
      ) -> if has_guard == 0 {
        checked_body_match_arm_body(
          state,
          context,
          arm_environment,
          CheckedPreparedMatchArm {
            pattern: checked_pattern,
            coverage: pattern_coverage,
            pattern_range: pattern_range,
            guard: CheckedUnguarded,
            guard_range: pattern_range,
            body: body,
            rest: rest
          },
          progress
        )
      } else {
        match checked_body_expr(
          state,
          context.source,
          context.types,
          context.owner,
          context.function_result,
          context.loop_context,
          arm_environment,
          guard,
          CheckedRequireResult(context.types.boolean)
        ) {
          CheckedBodyExprBuilt(state, checked_guard) -> {
            let guard_range = state.range(checked_guard)
            checked_body_match_arm_body(
              state,
              context,
              arm_environment,
              CheckedPreparedMatchArm {
                pattern: checked_pattern,
                coverage: pattern_coverage,
                pattern_range: pattern_range,
                guard: CheckedGuarded(checked_guard),
                guard_range: guard_range,
                body: body,
                rest: rest
              },
              progress
            )
          }
          CheckedBodyExprRejected(state, issue) -> CheckedBodyArmsRejected(state, issue)
        }
      }
      CheckedBodyPatternRejected(state, issue) -> CheckedBodyArmsRejected(state, issue)
    }
    UnknownArm(_) -> CheckedBodyArmsRejected(
      state,
      CheckedBodyProducerUnsupportedMatchArm
    )
  }
}

fn checked_body_match_arms(
  state: owned CheckedBodyBuild,
  context: CheckedMatchContext,
  authored: MatchArmList,
  progress: CheckedMatchProgress
) -[SemanticConformance]> CheckedBodyArmsBuild {
  match authored {
    MatchArmListNil -> if not progress.result.resolved {
      CheckedBodyArmsRejected(
        state,
        CheckedBodyProducerNonExhaustiveMatch
      )
    } else {
      if checked_pattern_coverage_complete(progress.coverage) {
        match state.finish_match_arm_list(progress.list) {
          (state, arms) -> CheckedBodyArmsBuilt(
            state,
            arms,
            progress.result.value,
            progress.coverage,
            progress.range
          )
        }
      } else {
        CheckedBodyArmsRejected(state, CheckedBodyProducerNonExhaustiveMatch)
      }
    }
    MatchArmListCons(arm, rest) -> checked_body_match_arm(
      state,
      context,
      arm,
      rest,
      progress
    )
  }
}

fn checked_body_match(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  scrutinee: Expr,
  arms: MatchArmList,
  origin: MatchOrigin,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  match checked_body_expr(
    state,
    source,
    types,
    owner,
    function_result,
    loop_context,
    environment,
    scrutinee,
    CheckedInferResult
  ) {
    CheckedBodyExprBuilt(state, checked_scrutinee) -> {
      let input_type = state.result_type(checked_scrutinee)
      let scrutinee_range = state.range(checked_scrutinee)
      match state.match_arm_list() {
        (state, list) -> match checked_body_match_arms(
          state,
          CheckedMatchContext {
            source: source,
            types: types,
            owner: owner,
            function_result: function_result,
            loop_context: loop_context,
            environment: environment,
            input_type: input_type,
            expectation: expectation
          },
          arms,
          CheckedMatchProgress {
            list: list,
            result: CheckedMatchResult {
              resolved: false,
              value: types.never_type
            },
            coverage: CheckedPatternOpen,
            range: scrutinee_range
          }
        ) {
          CheckedBodyArmsBuilt(state, checked_arms, result, _, range) ->
            match state.match_expr(
              checked_match_origin(origin),
              checked_scrutinee,
              checked_arms,
              result,
              range
            ) {
              (state, expression) -> CheckedBodyExprBuilt(state, expression)
            }
          CheckedBodyArmsRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
        }
      }
    }
    CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
  }
}

fn checked_body_prepare_effect_arguments(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  atom: SemanticTypeId,
  operation: str,
  parameter_count: usize,
  arguments: ExprList,
  index: usize,
  total: usize,
  values: List<usize>,
  range: CheckedSourceRange
) -[SemanticConformance]> CheckedBodyEffectArgumentsPreparation {
  let applications = types.effect_applications
  let catalog = types.catalog
  match arguments {
    ExprListNil -> if index == parameter_count {
      CheckedBodyEffectArgumentsPrepared(state, values.reverse(), range)
    } else {
      CheckedBodyEffectArgumentsPreparationRejected(
        state,
        CheckedBodyProducerArityMismatch(parameter_count, total)
      )
    }
    ExprListCons(argument, rest) -> if index >= parameter_count {
      CheckedBodyEffectArgumentsPreparationRejected(
        state,
        CheckedBodyProducerArityMismatch(parameter_count, total)
      )
    } else {
      match semantic_effect_application_parameter_type(
        applications,
        catalog,
        atom,
        operation,
        index
      ) {
        None -> CheckedBodyEffectArgumentsPreparationRejected(
          state,
          CheckedBodyProducerEffectApplicationUnavailable
        )
        Some(parameter) -> match checked_body_expr(
          state,
          source,
          types,
          owner,
          function_result,
          loop_context,
          environment,
          argument,
          CheckedRequireResult(parameter)
        ) {
          CheckedBodyExprBuilt(state, checked_argument) -> {
            let argument_range = state.range(checked_argument)
            match covering_range(range, argument_range) {
              next_range: CheckedSourceRange -> checked_body_prepare_effect_arguments(
                state,
                source,
                types,
                owner,
                function_result,
                loop_context,
                environment,
                atom,
                operation,
                parameter_count,
                rest,
                index + 1,
                total,
                values.prepend(checked_expr_id_ordinal(checked_argument)),
                next_range
              )
              nil -> CheckedBodyEffectArgumentsPreparationRejected(
                state,
                CheckedBodyProducerInvalidRange
              )
            }
          }
          CheckedBodyExprRejected(state, issue) ->
            CheckedBodyEffectArgumentsPreparationRejected(state, issue)
        }
      }
    }
  }
}

fn checked_body_materialize_effect_arguments(
  state: owned CheckedBodyBuild,
  values: List<usize>,
  list: CheckedExprListBuilder
) -> (owned CheckedBodyBuild, CheckedExprListId) {
  match values {
    Nil -> state.finish_expression_list(list)
    Cons(ordinal, remaining) -> {
      let expression = checked_expr_id_from_ordinal(state.segment(), ordinal)
      match state.expression_list_push(list, expression) {
        (state, list) -> checked_body_materialize_effect_arguments(
          state,
          remaining,
          list
        )
      }
    }
  }
}

fn checked_body_explicit_effect(
  module: RegisteredModule,
  types: CheckedBodyPrimitiveTypes,
  environment: CheckedLexicalEnvironment,
  effect_ref: TypeExpr,
  operation: str
) -> (CheckedBodyEffectSelection, SemanticTypeResolutionIssue?) {
  let resolution = types.resolution
  let applications = types.effect_applications
  match resolve_type_product_in_scope(
    resolution.continue_types(),
    module,
    lexical_scope(environment),
    lexical_type_parameters(environment),
    effect_ref
  ) {
    (_, SemanticTypeRejected(issue)) -> (
      CheckedBodyEffectSelectionMissing,
      issue
    )
    (product, SemanticTypeResolved(atom)) -> {
      let catalog = semantic_type_product_catalog(product)
      let selection = match semantic_effect_operation_projection(
        applications,
        catalog,
        atom,
        operation
      ) {
        SemanticEffectOperationProjected(
          canonical,
          declaration,
          operation_declaration,
          deferred,
          parameter_count,
          result,
        ) -> CheckedBodyEffectSelected(
          CheckedBodyEffectSite {
            atom: canonical,
            effect_declaration: declaration,
            operation_declaration: operation_declaration,
            deferred: deferred,
            parameter_count: parameter_count,
            result: result
          }
        )
        SemanticEffectOperationMissing -> CheckedBodyEffectOperationMissing
        SemanticEffectApplicationUnavailable -> CheckedBodyEffectApplicationMissing
      }
      (selection, nil)
    }
  }
}

fn checked_body_method_variable_eq(
  left: SemanticTypeVariable,
  right: SemanticTypeVariable
) -> bool {
  match (left, right) {
    (SemanticSelfVariable, SemanticSelfVariable) -> true
    (SemanticParameterVariable(a), SemanticParameterVariable(b)) -> a == b
    _ -> false
  }
}

fn checked_body_bound_method_selection(
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  receiver: SemanticTypeId,
  variable: SemanticTypeVariable,
  spelling: str
) -> CheckedBodyMethodSelection {
  let resolution = types.resolution
  let signatures = resolution.signatures()
  match signatures.find(owner) {
    None -> CheckedBodyMethodSelectionMissing
    Some(signature) -> {
      let methods = resolution.methods()
      let catalog = types.catalog
      let mut selected = CheckedBodyMethodSelectionMissing
      let mut index: usize = 0
      while index < signatures.bound_count(signature) {
        let bound = signatures.bound_at(signature, index)
        if checked_body_method_variable_eq(bound.variable, variable) {
          match catalog.graph_for(bound.trait_atom) {
            None -> nil
            Some(graph) -> match semantic_type_graph_node(graph, bound.trait_atom) {
              SemanticTraitNode(declaration, _) -> match semantic_trait_method_select(
                methods,
                declaration,
                spelling
              ) {
                SemanticTraitMethodSelected(method, method_signature) -> {
                  let candidate = CheckedBodyMethodSelected(
                    method,
                    method_signature,
                    semantic_trait_method_substitution(
                      catalog,
                      bound.trait_atom,
                      receiver
                    )
                  )
                  selected = match selected {
                    CheckedBodyMethodSelectionMissing -> candidate
                    _ -> CheckedBodyMethodSelectionAmbiguous
                  }
                }
                _ -> nil
              }
              _ -> nil
            }
          }
        } else { nil }
        index = index + 1
      }
      selected
    }
  }
}

fn checked_body_method_selection(
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  receiver: SemanticTypeId,
  spelling: str
) -> CheckedBodyMethodSelection {
  let catalog = types.catalog
  let resolution = types.resolution
  let methods = resolution.methods()
  let conformances = resolution.conformances()
  match catalog.graph_for(receiver) {
    None -> CheckedBodyMethodSelectionMissing
    Some(graph) -> match semantic_type_graph_node(graph, receiver) {
      SemanticVariableNode(variable) -> checked_body_bound_method_selection(
        types,
        owner,
        receiver,
        variable,
        spelling
      )
      _ -> match semantic_implementation_method_select(
        methods,
        catalog,
        conformances,
        receiver,
        spelling
      ) {
        SemanticImplementationMethodSelected(declaration, _, signature, substitution) ->
          CheckedBodyMethodSelected(declaration, signature, substitution)
        SemanticImplementationMethodSelectionMissing -> CheckedBodyMethodSelectionMissing
        SemanticImplementationMethodSelectionAmbiguous -> CheckedBodyMethodSelectionAmbiguous
      }
    }
  }
}

fn checked_body_perform_selection(
  module: RegisteredModule,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  environment: CheckedLexicalEnvironment,
  effect_ref: Expr,
  operation: str
) -> (CheckedBodyEffectSelection, SemanticTypeResolutionIssue?) {
  match checked_body_effect_reference(source, environment, effect_ref) {
    CheckedBodyExplicitEffect(authored) -> checked_body_explicit_effect(
      module,
      types,
      environment,
      authored,
      operation
    )
    CheckedBodyBareEffect(declaration) -> (
      checked_body_select_lexical_effect(
        types,
        environment,
        declaration,
        operation
      ),
      nil
    )
    CheckedBodyInvalidEffectReference -> (
      CheckedBodyEffectSelectionMissing,
      nil
    )
  }
}

fn checked_body_handler_selection(
  module: RegisteredModule,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  environment: CheckedLexicalEnvironment,
  effect_ref: Expr,
  operation: str
) -> (CheckedBodyEffectSelection, SemanticTypeResolutionIssue?) {
  match checked_body_effect_reference(source, environment, effect_ref) {
    CheckedBodyExplicitEffect(authored) -> checked_body_explicit_effect(
      module,
      types,
      environment,
      authored,
      operation
    )
    CheckedBodyBareEffect(declaration) -> (
      checked_body_select_registered_effect(types, declaration, operation),
      nil
    )
    CheckedBodyInvalidEffectReference -> (
      CheckedBodyEffectSelectionMissing,
      nil
    )
  }
}

fn checked_body_handler_parameter_type(
  types: CheckedBodyPrimitiveTypes,
  environment: CheckedLexicalEnvironment,
  annotation: TypeExpr,
  operation_type: SemanticTypeId
) -[SemanticConformance]> CheckedBodyHandlerParameterType {
  let resolution = types.resolution
  let module = types.module
  let catalog = types.catalog
  match annotation {
    MissingTypeExpr -> CheckedBodyHandlerParameterTypeResolved(operation_type)
    _ -> match resolve_type_product_in_scope(
      resolution.continue_types(),
      module,
      lexical_scope(environment),
      lexical_type_parameters(environment),
      annotation
    ) {
      (_, SemanticTypeRejected(issue)) -> CheckedBodyHandlerParameterTypeRejected(
        CheckedBodyProducerTypeRejected(issue)
      )
      (product, SemanticTypeResolved(annotation_type)) -> {
        let resolved_catalog = semantic_type_product_catalog(product)
        if not semantic_type_is_subtype(
          resolved_catalog,
          operation_type,
          annotation_type
        ) {
          CheckedBodyHandlerParameterTypeRejected(
            CheckedBodyProducerTypeMismatch(operation_type, annotation_type)
          )
        } else {
          match catalog.graph_for(annotation_type) {
            Some(_) -> CheckedBodyHandlerParameterTypeResolved(annotation_type)
            None -> CheckedBodyHandlerParameterTypeRejected(
              CheckedBodyProducerBodyLocalTypeUnavailable(annotation_type)
            )
          }
        }
      }
    }
  }
}

fn checked_body_continuation_type(
  state: owned CheckedBodyBuild,
  types: CheckedBodyPrimitiveTypes,
  input: SemanticTypeId,
  result: SemanticTypeId
) -> (owned CheckedBodyBuild, CheckedBodyPrimitiveTypes, SemanticTypeId) {
  let catalog = state.types()
  let module = types.module
  let resolution = types.resolution
  let segment = semantic_type_derived_segment_id(
    module.identity,
    catalog.next_derived_segment(module.identity, resolution.next_type_segment())
  )
  let builder = semantic_type_graph_builder(segment)
  let (builder, continuation) = builder.continuation(input, result)
  let next_catalog = semantic_type_catalog_with_graph(catalog, builder.freeze())
  (
    state.with_types(next_catalog),
    checked_body_types_with_catalog(types, next_catalog),
    continuation
  )
}

fn checked_body_handler_parameters(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  environment: CheckedLexicalEnvironment,
  atom: SemanticTypeId,
  operation: str,
  parameters: ParamList,
  index: usize,
  expected_count: usize,
  list: CheckedHandlerParameterListBuilder
) -[SemanticConformance]> CheckedBodyHandlerParametersBuild {
  let applications = types.effect_applications
  let catalog = types.catalog
  match parameters {
    ParamListNil -> if index == expected_count {
      CheckedBodyHandlerParametersBuilt(state, list, environment)
    } else {
      CheckedBodyHandlerParametersRejected(
        state,
        CheckedBodyProducerArityMismatch(expected_count, index)
      )
    }
    ParamListCons(parameter, rest) -> if index >= expected_count {
      CheckedBodyHandlerParametersRejected(
        state,
        CheckedBodyProducerArityMismatch(expected_count, index + 1)
      )
    } else {
      match parameter {
        Param(start, length, annotation, _) -> match (
          source_range(source, start, length),
          semantic_effect_application_parameter_type(
            applications,
            catalog,
            atom,
            operation,
            index
          ),
        ) {
          (range: CheckedSourceRange, Some(operation_type)) ->
            match checked_body_handler_parameter_type(
              types,
              environment,
              annotation,
              operation_type
            ) {
              CheckedBodyHandlerParameterTypeResolved(binding_type) -> match state.binding(
                owner,
                binding_type,
                range,
                CheckedImmutableBinding
              ) {
                (state, binding) -> match state.handler_parameter_list_push(
                  list,
                  binding
                ) {
                  (state, list) -> checked_body_handler_parameters(
                    state,
                    source,
                    types,
                    owner,
                    CheckedLexicalBinding(
                      start,
                      length,
                      binding,
                      binding_type,
                      false,
                      environment
                    ),
                    atom,
                    operation,
                    rest,
                    index + 1,
                    expected_count,
                    list
                  )
                }
              }
              CheckedBodyHandlerParameterTypeRejected(issue) ->
                CheckedBodyHandlerParametersRejected(state, issue)
            }
          _ -> CheckedBodyHandlerParametersRejected(
            state,
            CheckedBodyProducerUnsupportedParameter
          )
        }
        _ -> CheckedBodyHandlerParametersRejected(
          state,
          CheckedBodyProducerUnsupportedParameter
        )
      }
    }
  }
}

fn checked_body_handler_completion(
  authored: HandlerClause
) -> Option<CheckedHandlerCompletion> {
  match handler_clause_completion(authored) {
    HandlerClauseAborts -> Some<CheckedHandlerCompletion>(CheckedHandlerAborts)
    HandlerClauseResumes -> Some<CheckedHandlerCompletion>(CheckedHandlerResumes)
    HandlerClauseMixed -> Some<CheckedHandlerCompletion>(CheckedHandlerMixed)
    HandlerClauseDeferred -> None<CheckedHandlerCompletion>()
    HandlerClauseUnknown -> None<CheckedHandlerCompletion>()
  }
}

fn checked_body_handler_clauses(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  handled_atom: SemanticTypeId,
  handle_result: SemanticTypeId,
  clauses: HandlerClauseList,
  values: List<usize>,
  range: CheckedSourceRange
) -[SemanticConformance]> CheckedBodyHandlerClausesBuild {
  let catalog = types.catalog
  match clauses {
    HandlerClauseListNil -> CheckedBodyHandlerClausesBuilt(
      state,
      values.reverse(),
      range
    )
    HandlerClauseListCons(authored, rest) -> match authored {
      UnknownHandlerClause(_) -> CheckedBodyHandlerClausesRejected(
        state,
        CheckedBodyProducerHandlerClauseRequired
      )
      HandlerClause(name, parameters, body, continuation) -> match name {
        UnknownHandlerClauseName -> CheckedBodyHandlerClausesRejected(
          state,
          CheckedBodyProducerEffectReferenceRequired
        )
        HandlerClauseName(effect_ref, operation_start, operation_length) -> match (
          checked_body_effect_reference_range(source, effect_ref),
          source_range(source, operation_start, operation_length),
        ) {
          (effect_range: CheckedSourceRange, operation_range: CheckedSourceRange) ->
            match source.span(operation_range.start, operation_range.end) {
              None -> CheckedBodyHandlerClausesRejected(
                state,
                CheckedBodyProducerInvalidRange
              )
              Some(operation_span) -> match operation_span.text() {
                None -> CheckedBodyHandlerClausesRejected(
                  state,
                  CheckedBodyProducerInvalidRange
                )
                Some(operation_name) -> {
                  let (selection, resolution_issue) = checked_body_handler_selection(
                    types.module,
                    source,
                    types,
                    environment,
                    effect_ref,
                    operation_name
                  )
                  match resolution_issue {
                    issue: SemanticTypeResolutionIssue -> CheckedBodyHandlerClausesRejected(
                      state,
                      CheckedBodyProducerTypeRejected(issue)
                    )
                    nil -> match selection {
                      CheckedBodyEffectSelected(site) -> if not semantic_type_catalog_equal(
                        catalog,
                        site.atom,
                        handled_atom
                      ) {
                        CheckedBodyHandlerClausesRejected(
                          state,
                          CheckedBodyProducerHandlerEffectMismatch(
                            handled_atom,
                            site.atom
                          )
                        )
                      } else {
                        match continuation {
                          HandlerClauseNoContinuation ->
                            match checked_body_handler_completion(authored) {
                              None -> CheckedBodyHandlerClausesRejected(
                                state,
                                CheckedBodyProducerHandlerClauseRequired
                              )
                              Some(completion) ->
                                match state.handler_parameter_list() {
                                  (state, parameters_list) ->
                                    match checked_body_handler_parameters(
                                      state,
                                      source,
                                      types,
                                      owner,
                                      environment,
                                      site.atom,
                                      operation_name,
                                      parameters,
                                      0,
                                      site.parameter_count,
                                      parameters_list
                                    ) {
                                      CheckedBodyHandlerParametersRejected(state, issue) ->
                                        CheckedBodyHandlerClausesRejected(state, issue)
                                      CheckedBodyHandlerParametersBuilt(
                                state,
                                parameters_list,
                                clause_environment,
                              ) -> match state.finish_handler_parameter_list(
                                parameters_list
                              ) {
                                (state, checked_parameters) -> match checked_body_expr(
                                  state,
                                  source,
                                  types,
                                  owner,
                                  function_result,
                                  loop_context,
                                  CheckedLexicalResume(
                                    site.result,
                                    handle_result,
                                    clause_environment
                                  ),
                                  body,
                                  CheckedRequireResult(handle_result)
                                ) {
                                  CheckedBodyExprRejected(state, issue) ->
                                    CheckedBodyHandlerClausesRejected(state, issue)
                                  CheckedBodyExprBuilt(state, checked_body) -> {
                                    let clause_range = match covering_range(
                                      effect_range,
                                      state.range(checked_body)
                                    ) {
                                      value: CheckedSourceRange -> value
                                      nil -> operation_range
                                    }
                                    match state.handler_clause(
                                      CheckedHandlerClause {
                                        effect_declaration: site.effect_declaration,
                                        operation: site.operation_declaration,
                                        atom: site.atom,
                                        parameters: checked_parameters,
                                        continuation: CheckedImmediateHandlerClause,
                                        body: checked_body,
                                        completion: completion,
                                        range: clause_range
                                      }
                                    ) {
                                      (state, ordinal) -> checked_body_handler_clauses(
                                        state,
                                        source,
                                        types,
                                        owner,
                                        function_result,
                                        loop_context,
                                        environment,
                                        handled_atom,
                                        handle_result,
                                        rest,
                                        values.prepend(ordinal),
                                        match covering_range(range, clause_range) {
                                          value: CheckedSourceRange -> value
                                          nil -> range
                                        }
                                      )
                                    }
                                  }
                                }
                              }
                                    }
                                }
                            }
                          HandlerClauseContinuation(continuation_start, continuation_length) ->
                            if not site.deferred {
                              CheckedBodyHandlerClausesRejected(
                                state,
                                CheckedBodyProducerHandlerContinuationRequiresDeferred
                              )
                            } else {
                              match source_range(
                                source,
                                continuation_start,
                                continuation_length
                              ) {
                                nil -> CheckedBodyHandlerClausesRejected(
                                  state,
                                  CheckedBodyProducerInvalidRange
                                )
                                continuation_range: CheckedSourceRange ->
                                  match state.handler_parameter_list() {
                                    (state, parameters_list) ->
                                      match checked_body_handler_parameters(
                                        state,
                                        source,
                                        types,
                                        owner,
                                        environment,
                                        site.atom,
                                        operation_name,
                                        parameters,
                                        0,
                                        site.parameter_count,
                                        parameters_list
                                      ) {
                                        CheckedBodyHandlerParametersRejected(state, issue) ->
                                          CheckedBodyHandlerClausesRejected(state, issue)
                                        CheckedBodyHandlerParametersBuilt(
                                  state,
                                  parameters_list,
                                  clause_environment,
                                ) -> match state.finish_handler_parameter_list(
                                  parameters_list
                                ) {
                                  (state, checked_parameters) -> {
                                    let (
                                      state,
                                      clause_types,
                                      continuation_type,
                                    ) = checked_body_continuation_type(
                                      state,
                                      types,
                                      site.result,
                                      handle_result
                                    )
                                    match state.binding(
                                      owner,
                                      continuation_type,
                                      continuation_range,
                                      CheckedImmutableBinding
                                    ) {
                                      (state, continuation_binding) ->
                                        match checked_body_expr(
                                          state,
                                          source,
                                          clause_types,
                                          owner,
                                          function_result,
                                          loop_context,
                                          CheckedLexicalBinding(
                                            continuation_start,
                                            continuation_length,
                                            continuation_binding,
                                            continuation_type,
                                            false,
                                            clause_environment
                                          ),
                                          body,
                                          CheckedRequireResult(handle_result)
                                        ) {
                                          CheckedBodyExprRejected(state, issue) ->
                                            CheckedBodyHandlerClausesRejected(
                                              state,
                                              issue
                                            )
                                          CheckedBodyExprBuilt(
                                          state,
                                          checked_body,
                                        ) -> {
                                          let clause_range = match covering_range(
                                            effect_range,
                                            state.range(checked_body)
                                          ) {
                                            value: CheckedSourceRange -> value
                                            nil -> operation_range
                                          }
                                          match state.handler_clause(
                                            CheckedHandlerClause {
                                              effect_declaration:
                                              site.effect_declaration,
                                              operation: site.operation_declaration,
                                              atom: site.atom,
                                              parameters: checked_parameters,
                                              continuation: CheckedDeferredHandlerClause(
                                                continuation_binding
                                              ),
                                              body: checked_body,
                                              completion: CheckedHandlerDeferred,
                                              range: clause_range
                                            }
                                          ) {
                                            (state, ordinal) ->
                                              checked_body_handler_clauses(
                                                state,
                                                source,
                                                clause_types,
                                                owner,
                                                function_result,
                                                loop_context,
                                                environment,
                                                handled_atom,
                                                handle_result,
                                                rest,
                                                values.prepend(ordinal),
                                                match covering_range(
                                                  range,
                                                  clause_range
                                                ) {
                                                  value: CheckedSourceRange -> value
                                                  nil -> range
                                                }
                                              )
                                          }
                                        }
                                        }
                                    }
                                  }
                                }
                                      }
                                  }
                              }
                            }
                          UnknownHandlerClauseContinuation ->
                            CheckedBodyHandlerClausesRejected(
                              state,
                              CheckedBodyProducerHandlerClauseRequired
                            )
                        }
                      }
                      CheckedBodyEffectSelectionMissing -> CheckedBodyHandlerClausesRejected(
                        state,
                        CheckedBodyProducerEffectReferenceRequired
                      )
                      CheckedBodyEffectOperationMissing -> CheckedBodyHandlerClausesRejected(
                        state,
                        CheckedBodyProducerUnknownEffectOperation(operation_range)
                      )
                      CheckedBodyEffectApplicationMissing -> CheckedBodyHandlerClausesRejected(
                        state,
                        CheckedBodyProducerEffectApplicationUnavailable
                      )
                      CheckedBodyEffectSelectionAmbiguous(declaration) ->
                        CheckedBodyHandlerClausesRejected(
                          state,
                          CheckedBodyProducerAmbiguousEffectApplication(declaration)
                        )
                    }
                  }
                }
              }
            }
          _ -> CheckedBodyHandlerClausesRejected(
            state,
            CheckedBodyProducerInvalidRange
          )
        }
      }
    }
  }
}

fn checked_body_handler_first_site(
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  environment: CheckedLexicalEnvironment,
  clauses: HandlerClauseList
) -> (CheckedBodyEffectSelection, SemanticTypeResolutionIssue?) {
  match clauses {
    HandlerClauseListNil -> (CheckedBodyEffectSelectionMissing, nil)
    HandlerClauseListCons(clause, _) -> match clause {
      HandlerClause(HandlerClauseName(effect_ref, start, length), _, _, _) -> match source_range(
        source,
        start,
        length
      ) {
        nil -> (CheckedBodyEffectSelectionMissing, nil)
        range: CheckedSourceRange -> match source.span(range.start, range.end) {
          None -> (CheckedBodyEffectSelectionMissing, nil)
          Some(span) -> match span.text() {
            None -> (CheckedBodyEffectSelectionMissing, nil)
            Some(operation) -> checked_body_handler_selection(
              types.module,
              source,
              types,
              environment,
              effect_ref,
              operation
            )
          }
        }
      }
      _ -> (CheckedBodyEffectSelectionMissing, nil)
    }
  }
}

fn checked_body_materialize_handler_clauses(
  state: owned CheckedBodyBuild,
  values: List<usize>,
  list: CheckedHandlerClauseListBuilder
) -> (owned CheckedBodyBuild, CheckedHandlerClauseListId) {
  match values {
    Nil -> state.finish_handler_clause_list(list)
    Cons(ordinal, remaining) -> match state.handler_clause_list_push(
      list,
      ordinal
    ) {
      (state, list) -> checked_body_materialize_handler_clauses(
        state,
        remaining,
        list
      )
    }
  }
}

fn checked_body_handle_return(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  body_type: SemanticTypeId,
  body_range: CheckedSourceRange,
  authored: HandleReturn
) -[SemanticConformance]> CheckedBodyHandleReturnBuild {
  match authored {
    NoHandleReturn -> CheckedBodyHandleReturnBuilt(
      state,
      CheckedNoHandleReturn,
      body_type,
      body_range
    )
    HandleReturnClause(start, length, return_body) -> match source_range(
      source,
      start,
      length
    ) {
      nil -> CheckedBodyHandleReturnRejected(state, CheckedBodyProducerInvalidRange)
      binding_range: CheckedSourceRange -> match state.binding(
        owner,
        body_type,
        binding_range,
        CheckedImmutableBinding
      ) {
        (state, binding) -> match checked_body_expr(
          state,
          source,
          types,
          owner,
          function_result,
          loop_context,
          CheckedLexicalBinding(
            start,
            length,
            binding,
            body_type,
            false,
            environment
          ),
          return_body,
          CheckedInferResult
        ) {
          CheckedBodyExprRejected(state, issue) -> CheckedBodyHandleReturnRejected(
            state,
            issue
          )
          CheckedBodyExprBuilt(state, checked_return) -> {
            let result = state.result_type(checked_return)
            let range = match covering_range(body_range, state.range(checked_return)) {
              value: CheckedSourceRange -> value
              nil -> body_range
            }
            CheckedBodyHandleReturnBuilt(
              state,
              CheckedHandleReturnClause(binding, checked_return),
              result,
              range
            )
          }
        }
      }
    }
  }
}

fn checked_body_handle(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  body: Expr,
  clauses: HandlerClauseList,
  return_clause: HandleReturn,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  let catalog = types.catalog
  let (selection, resolution_issue) = checked_body_handler_first_site(
    source,
    types,
    environment,
    clauses
  )
  match resolution_issue {
    issue: SemanticTypeResolutionIssue -> CheckedBodyExprRejected(
      state,
      CheckedBodyProducerTypeRejected(issue)
    )
    nil -> match selection {
      CheckedBodyEffectSelected(first_site) -> match checked_body_expr(
        state,
        source,
        types,
        owner,
        function_result,
        loop_context,
        CheckedLexicalHandledEffect(first_site.atom, environment),
        body,
        CheckedInferResult
      ) {
        CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
        CheckedBodyExprBuilt(state, checked_body) -> {
          let body_type = state.result_type(checked_body)
          let body_range = state.range(checked_body)
          match checked_body_handle_return(
            state,
            source,
            types,
            owner,
            function_result,
            loop_context,
            environment,
            body_type,
            body_range,
            return_clause
          ) {
            CheckedBodyHandleReturnRejected(state, issue) -> CheckedBodyExprRejected(
              state,
              issue
            )
            CheckedBodyHandleReturnBuilt(
              state,
              checked_return,
              handle_result,
              handle_range,
            ) -> if not expectation_allows(
              catalog,
              handle_result,
              expectation
            ) {
              CheckedBodyExprRejected(
                state,
                expectation_mismatch(handle_result, expectation)
              )
            } else {
              match checked_body_handler_clauses(
                state,
                source,
                types,
                owner,
                function_result,
                loop_context,
                environment,
                first_site.atom,
                handle_result,
                clauses,
                Nil<usize>(),
                handle_range
              ) {
                CheckedBodyHandlerClausesRejected(state, issue) ->
                  CheckedBodyExprRejected(state, issue)
                CheckedBodyHandlerClausesBuilt(state, values, range) ->
                  match state.handler_clause_list() {
                    (state, list) -> match checked_body_materialize_handler_clauses(
                      state,
                      values,
                      list
                    ) {
                      (state, checked_clauses) -> match state.handle_expr(
                        checked_body,
                        checked_clauses,
                        checked_return,
                        handle_result,
                        range
                      ) {
                        (state, expression) -> CheckedBodyExprBuilt(state, expression)
                      }
                    }
                  }
              }
            }
          }
        }
      }
      CheckedBodyEffectSelectionMissing -> CheckedBodyExprRejected(
        state,
        CheckedBodyProducerHandlerClauseRequired
      )
      CheckedBodyEffectOperationMissing -> CheckedBodyExprRejected(
        state,
        CheckedBodyProducerEffectReferenceRequired
      )
      CheckedBodyEffectApplicationMissing -> CheckedBodyExprRejected(
        state,
        CheckedBodyProducerEffectApplicationUnavailable
      )
      CheckedBodyEffectSelectionAmbiguous(declaration) -> CheckedBodyExprRejected(
        state,
        CheckedBodyProducerAmbiguousEffectApplication(declaration)
      )
    }
  }
}

fn checked_body_resume(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  value: Expr,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  let catalog = types.catalog
  match lexical_resume_types(environment) {
    CheckedLexicalResumeMissing -> CheckedBodyExprRejected(
      state,
      CheckedBodyProducerResumeOutsideHandler
    )
    CheckedLexicalResumeFound(resume_input, _) -> if not expectation_allows(
      catalog,
      types.never_type,
      expectation
    ) {
      CheckedBodyExprRejected(
        state,
        expectation_mismatch(types.never_type, expectation)
      )
    } else {
      match checked_body_expr(
        state,
        source,
        types,
        owner,
        function_result,
        loop_context,
        environment,
        value,
        CheckedRequireResult(resume_input)
      ) {
        CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
        CheckedBodyExprBuilt(state, checked_value) -> {
          let range = state.range(checked_value)
          match state.resume_expr(
            checked_value,
            types.never_type,
            range
          ) {
            (state, expression) -> CheckedBodyExprBuilt(state, expression)
          }
        }
      }
    }
  }
}

fn checked_body_method_call(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  receiver: Expr,
  method_range: CheckedSourceRange,
  method_name: str,
  arguments: ExprList,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  match checked_body_expr(
    state,
    source,
    types,
    owner,
    function_result,
    loop_context,
    environment,
    receiver,
    CheckedInferResult
  ) {
    CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
    CheckedBodyExprBuilt(state, checked_receiver) -> {
      let receiver_type = state.result_type(checked_receiver)
      let catalog = state.types()
      let current_types = checked_body_types_with_catalog(types, catalog)
      match checked_body_method_selection(
        current_types,
        owner,
        receiver_type,
        method_name
      ) {
        CheckedBodyMethodSelectionMissing -> CheckedBodyExprRejected(
          state,
          CheckedBodyProducerUnknownMethod(method_range)
        )
        CheckedBodyMethodSelectionAmbiguous -> CheckedBodyExprRejected(
          state,
          CheckedBodyProducerAmbiguousMethod(method_range)
        )
        CheckedBodyMethodSelected(declaration, template, substitution) -> {
          let resolution = current_types.resolution
          let next_segment = catalog.next_derived_segment(
            current_types.module.identity,
            resolution.next_type_segment()
          )
          let product = semantic_type_product_continue(
            current_types.module.identity,
            catalog,
            next_segment
          )
          let (product, signature) = semantic_type_product_substitute(
            product,
            substitution,
            template
          )
          let next_catalog = semantic_type_product_catalog(product)
          let next_state = state.with_types(next_catalog)
          let next_types = checked_body_types_with_catalog(current_types, next_catalog)
          let parameter_count = semantic_function_parameter_count(
            next_catalog,
            signature
          )
          if parameter_count == 0 {
            CheckedBodyExprRejected(
              next_state,
              CheckedBodyProducerArityMismatch(1, 0)
            )
          } else {
            let self_type = semantic_function_parameter(next_catalog, signature, 0)
            if not semantic_type_is_subtype(next_catalog, receiver_type, self_type) {
              CheckedBodyExprRejected(
                next_state,
                CheckedBodyProducerTypeMismatch(receiver_type, self_type)
              )
            } else {
              match checked_body_function_effect_requirement(
                next_catalog,
                environment,
                signature
              ) {
                CheckedBodyEffectAtomUnavailable(atom) -> CheckedBodyExprRejected(
                  next_state,
                  CheckedBodyProducerEffectUnavailable(atom)
                )
                CheckedBodyEffectTailUnavailable(variable) -> CheckedBodyExprRejected(
                  next_state,
                  CheckedBodyProducerEffectTailUnavailable(variable)
                )
                CheckedBodyEffectsAvailable -> {
                  let result = semantic_function_result(next_catalog, signature)
                  if not expectation_allows(next_catalog, result, expectation) {
                    CheckedBodyExprRejected(
                      next_state,
                      expectation_mismatch(result, expectation)
                    )
                  } else {
                    match covering_range(next_state.range(checked_receiver), method_range) {
                      nil -> CheckedBodyExprRejected(
                        next_state,
                        CheckedBodyProducerInvalidRange
                      )
                      range: CheckedSourceRange -> match checked_body_method_arguments(
                        next_state,
                        source,
                        next_types,
                        owner,
                        function_result,
                        loop_context,
                        environment,
                        signature,
                        template,
                        arguments,
                        0,
                        __i64_to_usize(expr_list_len(arguments)),
                        Nil<CheckedExprId>(),
                        range
                      ) {
                        CheckedBodyArgumentsRejected(next_state, issue) ->
                          CheckedBodyExprRejected(next_state, issue)
                        CheckedBodyArgumentsBuilt(next_state, checked_arguments, range) ->
                          match next_state.method_call(
                            declaration,
                            checked_receiver,
                            checked_arguments,
                            result,
                            range
                          ) {
                            (next_state, expression) -> CheckedBodyExprBuilt(
                              next_state,
                              expression
                            )
                          }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

fn checked_body_perform(
  state: owned CheckedBodyBuild,
  module: RegisteredModule,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  effect_ref: Expr,
  operation_start: i64,
  operation_length: i64,
  arguments: ExprList,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  let catalog = types.catalog
  match source_range(source, operation_start, operation_length) {
    operation_range: CheckedSourceRange ->
      match source.span(operation_range.start, operation_range.end) {
        None -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
        Some(operation_span) -> match operation_span.text() {
          None -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
          Some(operation_name) -> {
            let (selection, resolution_issue) = checked_body_perform_selection(
              module,
              source,
              types,
              environment,
              effect_ref,
              operation_name
            )
            match resolution_issue {
              issue: SemanticTypeResolutionIssue -> CheckedBodyExprRejected(
                state,
                CheckedBodyProducerTypeRejected(issue)
              )
              nil -> match selection {
                CheckedBodyEffectSelected(site) ->
                  match checked_body_effect_reference_range(source, effect_ref) {
                    nil -> CheckedBodyExprRejected(
                      state,
                      CheckedBodyProducerInvalidRange
                    )
                    effect_range: CheckedSourceRange -> if not lexical_allows_effect(
                      catalog,
                      environment,
                      site.atom
                    ) {
                      CheckedBodyExprRejected(
                        state,
                        CheckedBodyProducerEffectUnavailable(site.atom)
                      )
                    } else if not expectation_allows(catalog, site.result, expectation) {
                      CheckedBodyExprRejected(
                        state,
                        expectation_mismatch(site.result, expectation)
                      )
                    } else {
                      match covering_range(effect_range, operation_range) {
                        nil -> CheckedBodyExprRejected(
                          state,
                          CheckedBodyProducerInvalidRange
                        )
                        range: CheckedSourceRange -> {
                          let total = __i64_to_usize(expr_list_len(arguments))
                          match checked_body_prepare_effect_arguments(
                            state,
                            source,
                            types,
                            owner,
                            function_result,
                            loop_context,
                            environment,
                            site.atom,
                            operation_name,
                            site.parameter_count,
                            arguments,
                            0,
                            total,
                            Nil<usize>(),
                            range
                          ) {
                            CheckedBodyEffectArgumentsPrepared(state, values, range) ->
                              match state.expression_list() {
                                (state, list) -> match checked_body_materialize_effect_arguments(
                                  state,
                                  values,
                                  list
                                ) {
                                  (state, checked_arguments) -> match state.perform(
                                    site.effect_declaration,
                                    site.operation_declaration,
                                    site.atom,
                                    checked_arguments,
                                    site.result,
                                    range
                                  ) {
                                    (state, expression) -> CheckedBodyExprBuilt(state, expression)
                                  }
                                }
                              }
                            CheckedBodyEffectArgumentsPreparationRejected(state, issue) ->
                              CheckedBodyExprRejected(state, issue)
                          }
                        }
                      }
                    }
                  }
                CheckedBodyEffectOperationMissing -> CheckedBodyExprRejected(
                  state,
                  CheckedBodyProducerUnknownEffectOperation(operation_range)
                )
                CheckedBodyEffectApplicationMissing -> CheckedBodyExprRejected(
                  state,
                  CheckedBodyProducerEffectApplicationUnavailable
                )
                CheckedBodyEffectSelectionAmbiguous(declaration) -> CheckedBodyExprRejected(
                  state,
                  CheckedBodyProducerAmbiguousEffectApplication(declaration)
                )
                CheckedBodyEffectSelectionMissing -> checked_body_method_call(
                  state,
                  source,
                  types,
                  owner,
                  function_result,
                  loop_context,
                  environment,
                  effect_ref,
                  operation_range,
                  operation_name,
                  arguments,
                  expectation
                )
              }
            }
          }
        }
      }
    _ -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
  }
}

fn checked_body_publish_arguments_from_list(
  state: owned CheckedBodyBuild,
  list: CheckedExprListBuilder,
  values: List<CheckedExprId>
) -> (owned CheckedBodyBuild, CheckedExprListId) {
  match values {
    Nil -> state.finish_expression_list(list)
    Cons(value, rest) -> match state.expression_list_push(list, value) {
      (state, list) -> checked_body_publish_arguments_from_list(state, list, rest)
    }
  }
}

fn checked_body_publish_arguments(
  state: owned CheckedBodyBuild,
  values: List<CheckedExprId>
) -> (owned CheckedBodyBuild, CheckedExprListId) {
  match state.expression_list() {
    (state, list) -> checked_body_publish_arguments_from_list(state, list, values.reverse())
  }
}

fn checked_body_method_arguments(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  function_type: SemanticTypeId,
  contract_type: SemanticTypeId,
  arguments: ExprList,
  index: usize,
  total: usize,
  values: List<CheckedExprId>,
  range: CheckedSourceRange
) -[SemanticConformance]> CheckedBodyArgumentsBuild {
  let catalog = types.catalog
  let parameter_count = semantic_function_parameter_count(catalog, function_type)
  let parameter_index = index + 1
  let zero: usize = 0
  let expected_count = if parameter_count >= 1 {
    parameter_count - 1
  } else { zero }
  match arguments {
    ExprListNil -> if parameter_index == parameter_count {
      match checked_body_publish_arguments(state, values) {
        (state, arguments) -> CheckedBodyArgumentsBuilt(state, arguments, range)
      }
    } else {
      CheckedBodyArgumentsRejected(
        state,
        CheckedBodyProducerArityMismatch(expected_count, total)
      )
    }
    ExprListCons(argument, rest) -> if parameter_index >= parameter_count {
      CheckedBodyArgumentsRejected(
        state,
        CheckedBodyProducerArityMismatch(expected_count, total)
      )
    } else {
      let parameter = semantic_function_parameter(catalog, function_type, parameter_index)
      match checked_body_expr(
        state,
        source,
        types,
        owner,
        function_result,
        loop_context,
        environment,
        argument,
        CheckedRequireResult(parameter)
      ) {
        CheckedBodyExprBuilt(state, checked_argument) -> {
          let argument_type = state.result_type(checked_argument)
          let argument_range = state.range(checked_argument)
          if semantic_continuation_type(catalog, argument_type) and
            not
            semantic_continuation_type(
              catalog,
              semantic_function_parameter(catalog, contract_type, parameter_index)
            ) {
              CheckedBodyArgumentsRejected(
                state,
                CheckedBodyProducerContinuationConsumerRequired(argument_range)
              )
            } else {
              match covering_range(range, argument_range) {
                next_range: CheckedSourceRange -> checked_body_method_arguments(
                  state,
                  source,
                  types,
                  owner,
                  function_result,
                  loop_context,
                  environment,
                  function_type,
                  contract_type,
                  rest,
                  index + 1,
                  total,
                  values.prepend(checked_argument),
                  next_range
                )
                nil -> CheckedBodyArgumentsRejected(
                  state,
                  CheckedBodyProducerInvalidRange
                )
              }
            }
        }
        CheckedBodyExprRejected(state, issue) -> CheckedBodyArgumentsRejected(state, issue)
      }
    }
  }
}

fn checked_body_arguments(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  function_type: SemanticTypeId,
  arguments: ExprList,
  index: usize,
  total: usize,
  values: List<CheckedExprId>,
  range: CheckedSourceRange
) -[SemanticConformance]> CheckedBodyArgumentsBuild {
  let catalog = types.catalog
  let parameter_count = semantic_function_parameter_count(catalog, function_type)
  match arguments {
    ExprListNil -> if index == parameter_count {
      match checked_body_publish_arguments(state, values) {
        (state, arguments) -> CheckedBodyArgumentsBuilt(state, arguments, range)
      }
    } else {
      CheckedBodyArgumentsRejected(
        state,
        CheckedBodyProducerArityMismatch(parameter_count, total)
      )
    }
    ExprListCons(argument, rest) -> if index >= parameter_count {
      CheckedBodyArgumentsRejected(
        state,
        CheckedBodyProducerArityMismatch(parameter_count, total)
      )
    } else {
      let parameter = semantic_function_parameter(catalog, function_type, index)
      match checked_body_expr(
        state,
        source,
        types,
        owner,
        function_result,
        loop_context,
        environment,
        argument,
        CheckedRequireResult(parameter)
      ) {
        CheckedBodyExprBuilt(state, checked_argument) -> {
          let argument_type = state.result_type(checked_argument)
          let argument_range = state.range(checked_argument)
          if semantic_continuation_type(catalog, argument_type) and
            not
            semantic_continuation_type(catalog, parameter) {
              CheckedBodyArgumentsRejected(
                state,
                CheckedBodyProducerContinuationConsumerRequired(argument_range)
              )
            } else {
              match covering_range(range, argument_range) {
                next_range: CheckedSourceRange -> checked_body_arguments(
                  state,
                  source,
                  types,
                  owner,
                  function_result,
                  loop_context,
                  environment,
                  function_type,
                  rest,
                  index + 1,
                  total,
                  values.prepend(checked_argument),
                  next_range
                )
                nil -> CheckedBodyArgumentsRejected(
                  state,
                  CheckedBodyProducerInvalidRange
                )
              }
            }
        }
        CheckedBodyExprRejected(state, issue) -> CheckedBodyArgumentsRejected(state, issue)
      }
    }
  }
}

fn checked_body_call_with_signature(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  name_range: CheckedSourceRange,
  call_site: usize,
  arguments: ExprList,
  signature: SemanticTypeId,
  callee: CheckedCallCallee,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  let catalog = types.catalog
  match checked_body_function_effect_requirement(catalog, environment, signature) {
    CheckedBodyEffectAtomUnavailable(atom) -> CheckedBodyExprRejected(
      state,
      CheckedBodyProducerEffectUnavailable(atom)
    )
    CheckedBodyEffectTailUnavailable(variable) -> CheckedBodyExprRejected(
      state,
      CheckedBodyProducerEffectTailUnavailable(variable)
    )
    CheckedBodyEffectsAvailable -> {
      let result = semantic_function_result(catalog, signature)
      if not expectation_allows(catalog, result, expectation) {
        CheckedBodyExprRejected(state, expectation_mismatch(result, expectation))
      } else {
        let total = __i64_to_usize(expr_list_len(arguments))
        match checked_body_arguments(
          state,
          source,
          types,
          owner,
          function_result,
          loop_context,
          environment,
          signature,
          arguments,
          0,
          total,
          Nil<CheckedExprId>(),
          name_range
        ) {
          CheckedBodyArgumentsBuilt(state, checked_arguments, range) -> match callee {
            CheckedDirectCallee(function) -> match state.direct_call(
              function,
              checked_arguments,
              result,
              range
            ) {
              (state, expression) -> CheckedBodyExprBuilt(state, expression)
            }
            CheckedAppliedCallee(expression) -> match state.apply(
              expression,
              checked_arguments,
              signature,
              call_site,
              result,
              range
            ) {
              (state, applied) -> CheckedBodyExprBuilt(state, applied)
            }
          }
          CheckedBodyArgumentsRejected(state, issue) -> CheckedBodyExprRejected(
            state,
            issue
          )
        }
      }
    }
  }
}

fn checked_body_generic_arguments(
  state: borrow CheckedBodyBuild,
  module: RegisteredModule,
  environment: CheckedLexicalEnvironment,
  signature: SemanticFunctionSignature,
  authored: TypeExprList,
  index: usize,
  product: SemanticTypeProductBuilder,
  substitution: SemanticTypeSubstitution,
  values: List<SemanticTypeId>
) -> CheckedGenericArgumentsBuild {
  match authored {
    TypeExprListNil -> CheckedGenericArgumentsResolved(product, substitution, values)
    TypeExprListCons(argument, rest, _) -> match resolve_type_product_in_scope(
      product,
      module,
      lexical_scope(environment),
      lexical_type_parameters(environment),
      argument
    ) {
      (product, SemanticTypeResolved(resolved)) -> checked_body_generic_arguments(
        state,
        module,
        environment,
        signature,
        rest,
        index + 1,
        product,
        semantic_type_substitution_bind(
          substitution,
          state.type_parameter_at(signature, index),
          resolved
        ),
        values.append(resolved)
      )
      (_, SemanticTypeRejected(issue)) -> CheckedGenericArgumentsRejected(issue)
    }
  }
}

fn checked_body_generic_bounds(
  state: borrow CheckedBodyBuild,
  signature: SemanticFunctionSignature,
  substitution: borrow SemanticTypeSubstitution,
  index: usize,
  product: SemanticTypeProductBuilder
) -[SemanticConformance]> CheckedGenericBoundsBuild {
  if index >= state.bound_count(signature) {
    CheckedGenericBoundsAccepted(product)
  } else {
    let bound = state.bound_at(signature, index)
    match semantic_type_substitution_get(substitution, bound.variable) {
      Some(concrete) -> {
        let (product, trait_atom) = semantic_type_product_substitute(
          product,
          substitution,
          bound.trait_atom
        )
        let catalog = semantic_type_product_catalog(product)
        if semantic_type_is_subtype(catalog, concrete, trait_atom) {
          checked_body_generic_bounds(state, signature, substitution, index + 1, product)
        } else {
          CheckedGenericBoundsRejected(product, concrete, trait_atom)
        }
      }
      None -> panic("Generic bound has no resolved type argument")
    }
  }
}

fn checked_body_generic_call(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  type_arguments: TypeExprList,
  inner: Expr,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  match inner {
    Call(start, length, arguments) -> match source_range(source, start, length) {
      name_range: CheckedSourceRange -> match lexical_lookup(
        environment,
        source,
        start,
        length
      ) {
        CheckedLexicalFound(_, _, _) -> CheckedBodyExprRejected(
          state,
          CheckedBodyProducerGenericDeclarationRequired(name_range)
        )
        CheckedLexicalMissing -> match source.span(name_range.start, name_range.end) {
          Some(name) -> match registration_scope_lookup_declaration_span(
            lexical_scope(environment),
            lexical_module(environment),
            ValueDeclaration,
            name
          ) {
            Some(declaration) -> {
              let function = DeclaredFunctionIdentity(declaration.identity)
              match state.find_signature(function) {
                Some(signature) -> {
                  let provided = __i64_to_usize(type_expr_list_len(type_arguments))
                  let required = state.type_parameter_count(signature)
                  if provided != required {
                    CheckedBodyExprRejected(
                      state,
                      CheckedBodyProducerArityMismatch(required, provided)
                    )
                  } else {
                    let catalog = state.types()
                    let resolution = types.resolution
                    let segment = catalog.next_derived_segment(
                      types.module.identity,
                      resolution.next_type_segment()
                    )
                    let product = semantic_type_product_continue(
                      types.module.identity,
                      catalog,
                      segment
                    )
                    match checked_body_generic_arguments(
                      state,
                      types.module,
                      environment,
                      signature,
                      type_arguments,
                      0,
                      product,
                      semantic_type_substitution_empty(),
                      Nil<SemanticTypeId>()
                    ) {
                      CheckedGenericArgumentsRejected(issue) -> CheckedBodyExprRejected(
                        state,
                        CheckedBodyProducerTypeRejected(issue)
                      )
                      CheckedGenericArgumentsResolved(product, substitution, resolved) ->
                        match checked_body_generic_bounds(
                          state,
                          signature,
                          substitution,
                          0,
                          product
                        ) {
                          CheckedGenericBoundsRejected(product, concrete, trait_atom) ->
                            CheckedBodyExprRejected(
                              state.with_types(semantic_type_product_catalog(product)),
                              CheckedBodyProducerGenericBoundRejected(concrete, trait_atom)
                            )
                          CheckedGenericBoundsAccepted(product) -> {
                            let (product, specialized) = semantic_type_product_substitute(
                              product,
                              substitution,
                              signature.type_id
                            )
                            let next_catalog = semantic_type_product_catalog(product)
                            let next_state = state.with_types(next_catalog)
                            let next_types = checked_body_types_with_catalog(types, next_catalog)
                            match checked_body_call_with_signature(
                              next_state,
                              source,
                              next_types,
                              owner,
                              function_result,
                              loop_context,
                              environment,
                              name_range,
                              name_range.start,
                              arguments,
                              specialized,
                              CheckedDirectCallee(function),
                              expectation
                            ) {
                              CheckedBodyExprBuilt(state, call) -> {
                                let result = state.result_type(call)
                                let range = state.range(call)
                                match state.generic_call(call, resolved, result, range) {
                                  (state, generic) -> CheckedBodyExprBuilt(state, generic)
                                }
                              }
                              CheckedBodyExprRejected(state, issue) ->
                                CheckedBodyExprRejected(state, issue)
                            }
                          }
                        }
                    }
                  }
                }
                None -> CheckedBodyExprRejected(
                  state,
                  CheckedBodyProducerSignatureUnavailable(name_range)
                )
              }
            }
            None -> CheckedBodyExprRejected(
              state,
              CheckedBodyProducerUnknownIdentifier(name_range)
            )
          }
          None -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
        }
      }
      nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
    }
    _ -> CheckedBodyExprRejected(state, CheckedBodyProducerUnsupportedExpression)
  }
}

fn checked_body_call(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  start: i64,
  length: i64,
  arguments: ExprList,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  let catalog = types.catalog
  match source_range(source, start, length) {
    name_range: CheckedSourceRange -> match lexical_lookup(
      environment,
      source,
      start,
      length
    ) {
      CheckedLexicalFound(binding, callee_type, _) -> if semantic_function_type(
        catalog,
        callee_type
      ) {
        match state.local_reference(binding, callee_type, name_range) {
          (state, callee) -> checked_body_call_with_signature(
            state,
            source,
            types,
            owner,
            function_result,
            loop_context,
            environment,
            name_range,
            name_range.start,
            arguments,
            callee_type,
            CheckedAppliedCallee(callee),
            expectation
          )
        }
      } else {
        CheckedBodyExprRejected(
          state,
          CheckedBodyProducerCallableRequired(callee_type)
        )
      }
      CheckedLexicalMissing -> match source.span(name_range.start, name_range.end) {
        Some(name) -> match registration_scope_lookup_declaration_span(
          lexical_scope(environment),
          lexical_module(environment),
          ValueDeclaration,
          name
        ) {
          Some(declaration) -> {
            let function = DeclaredFunctionIdentity(declaration.identity)
            match state.find_signature(function) {
              Some(signature) -> checked_body_call_with_signature(
                state,
                source,
                types,
                owner,
                function_result,
                loop_context,
                environment,
                name_range,
                name_range.start,
                arguments,
                signature.type_id,
                CheckedDirectCallee(function),
                expectation
              )
              None -> CheckedBodyExprRejected(
                state,
                CheckedBodyProducerSignatureUnavailable(name_range)
              )
            }
          }
          None -> CheckedBodyExprRejected(
            state,
            CheckedBodyProducerUnknownIdentifier(name_range)
          )
        }
        None -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
      }
    }
    nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
  }
}

fn checked_body_apply(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  callee: Expr,
  arguments: ExprList,
  site: i64,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  match checked_body_expr(
    state,
    source,
    types,
    owner,
    function_result,
    loop_context,
    environment,
    callee,
    CheckedInferResult
  ) {
    CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
    CheckedBodyExprBuilt(state, checked_callee) -> {
      let callee_type = state.result_type(checked_callee)
      let catalog = state.types()
      if not semantic_function_type(catalog, callee_type) {
        CheckedBodyExprRejected(
          state,
          CheckedBodyProducerCallableRequired(callee_type)
        )
      } else {
        let callee_range = state.range(checked_callee)
        match source_range(source, site, 0) {
          call_range: CheckedSourceRange -> checked_body_call_with_signature(
            state,
            source,
            types,
            owner,
            function_result,
            loop_context,
            environment,
            callee_range,
            call_range.start,
            arguments,
            callee_type,
            CheckedAppliedCallee(checked_callee),
            expectation
          )
          nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
        }
      }
    }
  }
}

fn checked_body_indexed_shape(
  catalog: borrow SemanticTypeCatalog,
  value_type: SemanticTypeId,
  purpose: CheckedBodyIndexUse
) -> CheckedBodyIndexedShape {
  match catalog.graph_for(value_type) {
    None -> CheckedNotIndexed
    Some(graph) -> match semantic_type_graph_node(graph, value_type) {
      SemanticArrayNode(element, length) -> CheckedFixedIndexed(element, length)
      SemanticSliceNode(element, _) -> CheckedDynamicIndexed(element)
      SemanticBorrowNode(inner, _) -> checked_body_indexed_shape(catalog, inner, purpose)
      SemanticOwnedNode(inner) -> match purpose {
        CheckedLengthRead -> checked_body_indexed_shape(catalog, inner, purpose)
        CheckedElementRead -> CheckedNotIndexed
      }
      SemanticUniqueNode(inner) -> match purpose {
        CheckedLengthRead -> checked_body_indexed_shape(catalog, inner, purpose)
        CheckedElementRead -> CheckedNotIndexed
      }
      _ -> CheckedNotIndexed
    }
  }
}

fn checked_body_writable_shape(
  catalog: borrow SemanticTypeCatalog,
  value_type: SemanticTypeId
) -> CheckedBodyWritableShape {
  match catalog.graph_for(value_type) {
    None -> CheckedNotWritableIndexed
    Some(graph) -> match semantic_type_graph_node(graph, value_type) {
      SemanticArrayNode(element, length) -> CheckedWritableArray(
        element,
        __u64_to_isize(__usize_to_u64(length))
      )
      SemanticSliceNode(element, SemanticMutable) -> CheckedWritableSlice(element)
      SemanticSliceNode(_, SemanticImmutable) -> CheckedImmutableSlice
      _ -> CheckedNotWritableIndexed
    }
  }
}

fn checked_body_indexed_length(
  state: owned CheckedBodyBuild,
  types: CheckedBodyPrimitiveTypes,
  checked_base: CheckedExprId,
  shape: CheckedBodyIndexedShape,
  field_range: CheckedSourceRange,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  let catalog = state.types()
  if not expectation_allows(catalog, types.usize_type, expectation) {
    CheckedBodyExprRejected(
      state,
      expectation_mismatch(types.usize_type, expectation)
    )
  } else {
    match shape {
      CheckedFixedIndexed(element, length) -> match covering_range(
        state.range(checked_base),
        field_range
      ) {
        range: CheckedSourceRange -> match state.indexed_length(
          checked_base,
          element,
          __u64_to_isize(__usize_to_u64(length)),
          types.usize_type,
          range
        ) {
          (state, expression) -> CheckedBodyExprBuilt(state, expression)
        }
        nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
      }
      CheckedDynamicIndexed(element) -> match covering_range(
        state.range(checked_base),
        field_range
      ) {
        range: CheckedSourceRange -> match state.indexed_length(
          checked_base,
          element,
          0 - 1,
          types.usize_type,
          range
        ) {
          (state, expression) -> CheckedBodyExprBuilt(state, expression)
        }
        nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
      }
      CheckedNotIndexed -> {
        let base_type = state.result_type(checked_base)
        CheckedBodyExprRejected(state, CheckedBodyProducerIndexedBaseRequired(base_type))
      }
    }
  }
}

fn checked_body_indexed_get(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  base: Expr,
  index: Expr,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  match checked_body_expr(
    state,
    source,
    types,
    owner,
    function_result,
    loop_context,
    environment,
    base,
    CheckedInferResult
  ) {
    CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
    CheckedBodyExprBuilt(state, checked_base) -> {
      let catalog = state.types()
      let base_type = state.result_type(checked_base)
      let shape = checked_body_indexed_shape(catalog, base_type, CheckedElementRead)
      let parts: Option<(SemanticTypeId, isize)> = match shape {
        CheckedNotIndexed -> None<(SemanticTypeId, isize)>()
        CheckedFixedIndexed(element, length) -> Some(
          (
            element,
            __u64_to_isize(__usize_to_u64(length))
          )
        )
        CheckedDynamicIndexed(element) -> {
          let dynamic_length: isize = - 1
          Some((element, dynamic_length))
        }
      }
      match parts {
        None -> CheckedBodyExprRejected(
          state,
          CheckedBodyProducerIndexedBaseRequired(base_type)
        )
        Some((element, length)) -> match checked_body_expr(
          state,
          source,
          types,
          owner,
          function_result,
          loop_context,
          environment,
          index,
          CheckedRequireResult(types.usize_type)
        ) {
          CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
          CheckedBodyExprBuilt(state, checked_index) -> {
            let catalog = state.types()
            if semantic_continuation_type(catalog, element) {
              let range = state.range(checked_base)
              CheckedBodyExprRejected(
                state,
                CheckedBodyProducerContinuationConsumerRequired(range)
              )
            } else if not expectation_allows(catalog, element, expectation) {
              CheckedBodyExprRejected(state, expectation_mismatch(element, expectation))
            } else {
              match covering_range(state.range(checked_base), state.range(checked_index)) {
                range: CheckedSourceRange -> match state.indexed_get(
                  checked_base,
                  checked_index,
                  element,
                  length,
                  element,
                  range
                ) {
                  (state, expression) -> CheckedBodyExprBuilt(state, expression)
                }
                nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
              }
            }
          }
        }
      }
    }
  }
}

fn checked_body_indexed_set_value(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  checked_base: CheckedExprId,
  index: Expr,
  value: Expr,
  element: SemanticTypeId,
  length: isize,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  let catalog = state.types()
  if semantic_continuation_type(catalog, element) {
    let range = state.range(checked_base)
    CheckedBodyExprRejected(state, CheckedBodyProducerContinuationConsumerRequired(range))
  } else if not expectation_allows(catalog, types.nil_type, expectation) {
    CheckedBodyExprRejected(state, expectation_mismatch(types.nil_type, expectation))
  } else {
    match checked_body_expr(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      index,
      CheckedRequireResult(types.usize_type)
    ) {
      CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
      CheckedBodyExprBuilt(state, checked_index) -> match checked_body_expr(
        state,
        source,
        types,
        owner,
        function_result,
        loop_context,
        environment,
        value,
        CheckedRequireResult(element)
      ) {
        CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
        CheckedBodyExprBuilt(state, checked_value) -> match covering_range(
          state.range(checked_base),
          state.range(checked_value)
        ) {
          range: CheckedSourceRange -> match state.indexed_set(
            checked_base,
            checked_index,
            checked_value,
            element,
            length,
            types.nil_type,
            range
          ) {
            (state, expression) -> CheckedBodyExprBuilt(state, expression)
          }
          nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
        }
      }
    }
  }
}

fn checked_body_indexed_set(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  base: Expr,
  index: Expr,
  value: Expr,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  match checked_body_expr(
    state,
    source,
    types,
    owner,
    function_result,
    loop_context,
    environment,
    base,
    CheckedInferResult
  ) {
    CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
    CheckedBodyExprBuilt(state, checked_base) -> {
      let base_type = state.result_type(checked_base)
      let catalog = state.types()
      let shape = checked_body_writable_shape(catalog, base_type)
      match shape {
        CheckedNotWritableIndexed -> CheckedBodyExprRejected(
          state,
          CheckedBodyProducerIndexedBaseRequired(base_type)
        )
        CheckedImmutableSlice -> {
          let range = state.range(checked_base)
          CheckedBodyExprRejected(state, CheckedBodyProducerImmutableAssignment(range))
        }
        _ -> match base {
          Ident(start, length) -> match lexical_lookup(environment, source, start, length) {
            CheckedLexicalFound(_, _, mutable) -> match shape {
              CheckedWritableArray(element, size) -> if mutable {
                checked_body_indexed_set_value(
                  state,
                  source,
                  types,
                  owner,
                  function_result,
                  loop_context,
                  environment,
                  checked_base,
                  index,
                  value,
                  element,
                  size,
                  expectation
                )
              } else {
                let range = state.range(checked_base)
                CheckedBodyExprRejected(state, CheckedBodyProducerImmutableAssignment(range))
              }
              CheckedWritableSlice(element) -> {
                let dynamic_length: isize = - 1
                checked_body_indexed_set_value(
                  state,
                  source,
                  types,
                  owner,
                  function_result,
                  loop_context,
                  environment,
                  checked_base,
                  index,
                  value,
                  element,
                  dynamic_length,
                  expectation
                )
              }
              _ -> {
                let range = state.range(checked_base)
                CheckedBodyExprRejected(
                  state,
                  CheckedBodyProducerIndexedNamedBindingRequired(range)
                )
              }
            }
            CheckedLexicalMissing -> {
              let range = state.range(checked_base)
              CheckedBodyExprRejected(
                state,
                CheckedBodyProducerIndexedNamedBindingRequired(range)
              )
            }
          }
          _ -> {
            let range = state.range(checked_base)
            CheckedBodyExprRejected(
              state,
              CheckedBodyProducerIndexedNamedBindingRequired(range)
            )
          }
        }
      }
    }
  }
}

fn checked_body_field_access(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  base: Expr,
  field_start: i64,
  field_length: i64,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  match checked_body_expr(
    state,
    source,
    types,
    owner,
    function_result,
    loop_context,
    environment,
    base,
    CheckedInferResult
  ) {
    CheckedBodyExprBuilt(state, checked_base) -> {
      let base_type = state.result_type(checked_base)
      let catalog = state.types()
      match source_range(source, field_start, field_length) {
        field_range: CheckedSourceRange -> match source.span(
          field_range.start,
          field_range.end
        ) {
          Some(field_span) -> match field_span.text() {
            Some(field_name) -> {
              let indexed = if field_name == "len" {
                checked_body_indexed_shape(catalog, base_type, CheckedLengthRead)
              } else { CheckedNotIndexed }
              match indexed {
                CheckedNotIndexed -> checked_body_project_field(
                  state,
                  types,
                  checked_base,
                  base_type,
                  field_name,
                  field_range,
                  expectation
                )
                shape -> checked_body_indexed_length(
                  state,
                  types,
                  checked_base,
                  shape,
                  field_range,
                  expectation
                )
              }
            }
            None -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
          }
          None -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
        }
        nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
      }
    }
    CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
  }
}

fn checked_body_project_field(
  state: owned CheckedBodyBuild,
  types: CheckedBodyPrimitiveTypes,
  checked_base: CheckedExprId,
  base_type: SemanticTypeId,
  field_name: str,
  field_range: CheckedSourceRange,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  let catalog = state.types()
  match semantic_record_field_projection(
    catalog,
    base_type,
    field_name
  ) {
    SemanticRecordFieldProjected(stable_key, word_offset, result) ->
      if expectation_allows(catalog, result, expectation) {
        match covering_range(state.range(checked_base), field_range) {
          range: CheckedSourceRange -> match state.structural_field_access(
            checked_base,
            stable_key,
            word_offset,
            result,
            range
          ) {
            (state, expression) -> CheckedBodyExprBuilt(state, expression)
          }
          nil -> CheckedBodyExprRejected(
            state,
            CheckedBodyProducerInvalidRange
          )
        }
      } else {
        CheckedBodyExprRejected(
          state,
          expectation_mismatch(result, expectation)
        )
      }
    SemanticRecordFieldMissing -> CheckedBodyExprRejected(
      state,
      CheckedBodyProducerUnknownField(field_range)
    )
    SemanticRecordFieldProjectionUnavailable -> {
      let applications = types.applications
      match semantic_declared_field_projection(
        applications,
        catalog,
        base_type,
        field_name
      ) {
        SemanticDeclaredFieldProjected(declaration, field_index, result) ->
          if expectation_allows(catalog, result, expectation) {
            match covering_range(state.range(checked_base), field_range) {
              range: CheckedSourceRange -> match state.declared_field_access(
                checked_base,
                declaration,
                field_index,
                result,
                range
              ) {
                (state, expression) -> CheckedBodyExprBuilt(state, expression)
              }
              nil -> CheckedBodyExprRejected(
                state,
                CheckedBodyProducerInvalidRange
              )
            }
          } else {
            CheckedBodyExprRejected(
              state,
              expectation_mismatch(result, expectation)
            )
          }
        SemanticDeclaredFieldMissing -> CheckedBodyExprRejected(
          state,
          CheckedBodyProducerUnknownField(field_range)
        )
        SemanticDeclaredFieldProjectionUnavailable -> CheckedBodyExprRejected(
          state,
          CheckedBodyProducerFieldProjectionUnavailable(base_type)
        )
      }
    }
  }
}

fn checked_body_array_elements(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  authored: ExprList,
  element_type: Option<SemanticTypeId>,
  values: List<CheckedExprId>,
  element_types: List<SemanticTypeId>,
  range: CheckedSourceRange
) -[SemanticConformance]> CheckedBodyArrayElementsBuild {
  match authored {
    ExprListNil -> CheckedBodyArrayElementsBuilt(state, values, element_types, range)
    ExprListCons(element, rest) -> {
      let expectation = match element_type {
        Some(expected) -> CheckedRequireResult(expected)
        None -> CheckedInferResult
      }
      let catalog = state.types()
      match checked_body_expr(
        state,
        source,
        checked_body_types_with_catalog(types, catalog),
        owner,
        function_result,
        loop_context,
        environment,
        element,
        expectation
      ) {
        CheckedBodyExprBuilt(state, checked_element) -> {
          let actual = state.result_type(checked_element)
          let element_range = state.range(checked_element)
          let catalog = state.types()
          if semantic_continuation_type(catalog, actual) {
            CheckedBodyArrayElementsRejected(
              state,
              CheckedBodyProducerContinuationConsumerRequired(element_range)
            )
          } else {
            match covering_range(range, element_range) {
              next_range: CheckedSourceRange -> checked_body_array_elements(
                state,
                source,
                types,
                owner,
                function_result,
                loop_context,
                environment,
                rest,
                element_type,
                values.prepend(checked_element),
                element_types.prepend(actual),
                next_range
              )
              nil -> CheckedBodyArrayElementsRejected(
                state,
                CheckedBodyProducerInvalidRange
              )
            }
          }
        }
        CheckedBodyExprRejected(state, issue) -> CheckedBodyArrayElementsRejected(state, issue)
      }
    }
  }
}

fn checked_body_array_union(
  builder: owned SemanticTypeGraphBuilder,
  current: SemanticTypeId,
  remaining: List<SemanticTypeId>
) -> (owned SemanticTypeGraphBuilder, SemanticTypeId) {
  match remaining {
    Nil -> (builder, current)
    Cons(next, rest) -> match builder.union(current, next) {
      (builder, joined) -> checked_body_array_union(builder, joined, rest)
    }
  }
}

fn checked_body_finish_array(
  state: owned CheckedBodyBuild,
  values: List<CheckedExprId>,
  element_type: SemanticTypeId,
  result: SemanticTypeId,
  range: CheckedSourceRange
) -> CheckedBodyExprBuild {
  match checked_body_publish_arguments(state, values) {
    (state, elements) -> match state.array_literal(elements, element_type, result, range) {
      (state, expression) -> CheckedBodyExprBuilt(state, expression)
    }
  }
}

fn checked_body_array_literal(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  authored: ExprList,
  source_site: i64,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  let catalog = types.catalog
  let length = __i64_to_usize(expr_list_len(authored))
  let contextual_element: Option<SemanticTypeId> = match expectation {
    CheckedInferResult -> None
    CheckedRequireResult(expected) -> match catalog.graph_for(expected) {
      None -> None
      Some(graph) -> match semantic_type_graph_node(graph, expected) {
        SemanticArrayNode(element, expected_length) -> if expected_length == length {
          Some(element)
        } else { None }
        _ -> None
      }
    }
  }
  match source_range(source, source_site, 1) {
    nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
    opening: CheckedSourceRange -> match checked_body_array_elements(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      authored,
      contextual_element,
      Nil<CheckedExprId>(),
      Nil<SemanticTypeId>(),
      opening
    ) {
      CheckedBodyArrayElementsRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
      CheckedBodyArrayElementsBuilt(state, values, element_types, range) ->
        match (contextual_element, expectation) {
          (Some(inner), CheckedRequireResult(result)) -> checked_body_finish_array(
            state,
            values,
            inner,
            result,
            range
          )
          _ -> {
            let catalog = state.types()
            let module = types.module
            let resolution = types.resolution
            let segment = semantic_type_derived_segment_id(
              module.identity,
              catalog.next_derived_segment(
                module.identity,
                resolution.next_type_segment()
              )
            )
            let builder = semantic_type_graph_builder(segment)
            let (builder, inner) = match element_types.reverse() {
              Nil -> (builder, types.never_type)
              Cons(first, rest) -> checked_body_array_union(builder, first, rest)
            }
            match builder.array(inner, length) {
              (builder, result) -> {
                let next_catalog = semantic_type_catalog_with_graph(catalog, builder.freeze())
                if not expectation_allows(next_catalog, result, expectation) {
                  CheckedBodyExprRejected(
                    state,
                    expectation_mismatch(result, expectation)
                  )
                } else {
                  checked_body_finish_array(
                    state.with_types(next_catalog),
                    values,
                    inner,
                    result,
                    range
                  )
                }
              }
            }
          }
        }
    }
  }
}

fn checked_body_expr(
  state: owned CheckedBodyBuild,
  source: Source,
  types: CheckedBodyPrimitiveTypes,
  owner: FunctionIdentity,
  function_result: SemanticTypeId,
  loop_context: CheckedLoopContext,
  environment: CheckedLexicalEnvironment,
  authored: Expr,
  expectation: CheckedBodyExpectation
) -[SemanticConformance]> CheckedBodyExprBuild {
  let current_catalog = state.types()
  let types = checked_body_types_with_catalog(types, current_catalog)
  let catalog = types.catalog
  match authored {
    Block(first, rest) -> checked_body_block(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      first,
      rest,
      expectation
    )
    If(condition, then_branch, else_branch) -> checked_body_if(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      condition,
      then_branch,
      else_branch,
      expectation
    )
    Match(scrutinee, arms, origin) -> checked_body_match(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      scrutinee,
      arms,
      origin,
      expectation
    )
    While(condition, body) -> checked_body_while(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      condition,
      body,
      expectation
    )
    Let(start, length, value, body) -> checked_body_let(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      start,
      length,
      value,
      body,
      false,
      None,
      expectation
    )
    LetMut(start, length, value, body) -> checked_body_let(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      start,
      length,
      value,
      body,
      true,
      None,
      expectation
    )
    LetTyped(inner, annotation) -> checked_body_typed_let(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      inner,
      annotation,
      expectation
    )
    Assign(start, length, value) -> checked_body_assign(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      start,
      length,
      value,
      expectation
    )
    Loop(body) -> checked_body_loop(
      state,
      source,
      types,
      owner,
      function_result,
      environment,
      body,
      expectation
    )
    Break(value) -> match loop_context {
      CheckedOutsideLoop -> CheckedBodyExprRejected(
        state,
        CheckedBodyProducerBreakOutsideLoop
      )
      CheckedInsideLoop(result) -> match checked_body_expr(
        state,
        source,
        types,
        owner,
        function_result,
        CheckedInsideLoop(result),
        environment,
        value,
        CheckedRequireResult(result)
      ) {
        CheckedBodyExprBuilt(state, checked_value) -> {
          let range = state.range(checked_value)
          if expectation_allows(catalog, types.never_type, expectation) {
            match state.break_expr(checked_value, types.never_type, range) {
              (state, expression) -> CheckedBodyExprBuilt(state, expression)
            }
          } else {
            CheckedBodyExprRejected(
              state,
              expectation_mismatch(types.never_type, expectation)
            )
          }
        }
        CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
      }
    }
    BreakNoValue -> match loop_context {
      CheckedOutsideLoop -> CheckedBodyExprRejected(
        state,
        CheckedBodyProducerBreakOutsideLoop
      )
      CheckedInsideLoop(result) -> if semantic_type_is_subtype(
        catalog,
        types.nil_type,
        result
      ) and expectation_allows(catalog, types.never_type, expectation) {
        match state.break_no_value(
          types.never_type,
          CheckedSourceRange { start: 0, end: 0 }
        ) {
          (state, expression) -> CheckedBodyExprBuilt(state, expression)
        }
      } else {
        CheckedBodyExprRejected(
          state,
          CheckedBodyProducerTypeMismatch(types.nil_type, result)
        )
      }
    }
    Continue -> match loop_context {
      CheckedOutsideLoop -> CheckedBodyExprRejected(
        state,
        CheckedBodyProducerContinueOutsideLoop
      )
      CheckedInsideLoop(_) -> if expectation_allows(
        catalog,
        types.never_type,
        expectation
      ) {
        match state.continue_expr(
          types.never_type,
          CheckedSourceRange { start: 0, end: 0 }
        ) {
          (state, expression) -> CheckedBodyExprBuilt(state, expression)
        }
      } else {
        CheckedBodyExprRejected(
          state,
          expectation_mismatch(types.never_type, expectation)
        )
      }
    }
    Return(value) -> match checked_body_expr(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      value,
      CheckedRequireResult(function_result)
    ) {
      CheckedBodyExprBuilt(state, checked_value) -> {
        let range = state.range(checked_value)
        if semantic_continuation_type(catalog, state.result_type(checked_value)) and
          not
          semantic_continuation_type(catalog, function_result) {
            CheckedBodyExprRejected(
              state,
              CheckedBodyProducerContinuationResultRequired(range)
            )
          } else if expectation_allows(catalog, types.never_type, expectation) {
            match state.return_expr(checked_value, types.never_type, range) {
              (state, expression) -> CheckedBodyExprBuilt(state, expression)
            }
          } else {
            CheckedBodyExprRejected(
              state,
              expectation_mismatch(types.never_type, expectation)
            )
          }
      }
      CheckedBodyExprRejected(state, issue) -> CheckedBodyExprRejected(state, issue)
    }
    ReturnNoValue -> if semantic_type_is_subtype(
      catalog,
      types.nil_type,
      function_result
    ) and expectation_allows(catalog, types.never_type, expectation) {
      match state.return_no_value(
        types.never_type,
        CheckedSourceRange { start: 0, end: 0 }
      ) {
        (state, expression) -> CheckedBodyExprBuilt(state, expression)
      }
    } else {
      CheckedBodyExprRejected(
        state,
        CheckedBodyProducerTypeMismatch(types.nil_type, function_result)
      )
    }
    Not(operand) -> checked_body_not(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      operand,
      expectation
    )
    Negate(operand, _) -> checked_body_negate(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      operand,
      expectation
    )
    Defer(cleanup, body, source_site) -> checked_body_defer(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      cleanup,
      body,
      source_site,
      expectation
    )
    BinOp(operator, left, right) -> checked_body_binary(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      operator,
      left,
      right,
      expectation
    )
    Call(start, length, arguments) -> checked_body_call(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      start,
      length,
      arguments,
      expectation
    )
    GenericCall(type_arguments, inner) -> checked_body_generic_call(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      type_arguments,
      inner,
      expectation
    )
    Apply(callee, arguments, _, site) -> checked_body_apply(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      callee,
      arguments,
      site,
      expectation
    )
    FieldAccess(base, field_start, field_length, _) -> checked_body_field_access(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      base,
      field_start,
      field_length,
      expectation
    )
    IndexedGet(base, index, _, _) -> checked_body_indexed_get(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      base,
      index,
      expectation
    )
    IndexedSet(base, index, value, _) -> checked_body_indexed_set(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      base,
      index,
      value,
      expectation
    )
    Perform(effect_ref, operation_start, operation_length, arguments) -> checked_body_perform(
      state,
      types.module,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      effect_ref,
      operation_start,
      operation_length,
      arguments,
      expectation
    )
    Handle(body, clauses, return_clause) -> checked_body_handle(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      body,
      clauses,
      return_clause,
      expectation
    )
    Resume(value) -> checked_body_resume(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      value,
      expectation
    )
    ArrayLiteral(elements, _, source_site) -> checked_body_array_literal(
      state,
      source,
      types,
      owner,
      function_result,
      loop_context,
      environment,
      elements,
      source_site,
      expectation
    )
    IntLit(value, start, length) -> match source_range(source, start, length) {
      range: CheckedSourceRange -> {
        let actual = contextual_integer_type(catalog, types.integer, expectation)
        if expectation_allows(catalog, actual, expectation) {
          match state.integer(value, actual, range) {
            (state, expression) -> CheckedBodyExprBuilt(state, expression)
          }
        } else {
          CheckedBodyExprRejected(
            state,
            expectation_mismatch(actual, expectation)
          )
        }
      }
      nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
    }
    StringLit(decoded_start, decoded_length, token_start, token_length) -> match source_range(
      source,
      token_start,
      token_length
    ) {
      range: CheckedSourceRange -> if decoded_length < 0 {
        CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
      } else {
        if expectation_allows(catalog, types.string, expectation) {
          let value = if decoded_length == 0 { "" } else {
            runtime_str_from_bytes_copy(
              __str_ptr(source.text) + decoded_start,
              decoded_length
            )
          }
          match state.string(value, types.string, range) {
            (state, expression) -> CheckedBodyExprBuilt(state, expression)
          }
        } else {
          CheckedBodyExprRejected(
            state,
            expectation_mismatch(types.string, expectation)
          )
        }
      }
      nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
    }
    FloatLit(start, length, _) -> match source_range(source, start, length) {
      range: CheckedSourceRange -> {
        let actual = contextual_float_type(catalog, types, expectation)
        if not expectation_allows(catalog, actual, expectation) {
          CheckedBodyExprRejected(state, expectation_mismatch(actual, expectation))
        } else {
          match checked_float_literal_value(
            source,
            start,
            length,
            semantic_type_catalog_equal(catalog, actual, types.float32)
          ) {
            Some(value) -> match state.float(value, actual, range) {
              (state, expression) -> CheckedBodyExprBuilt(state, expression)
            }
            None -> CheckedBodyExprRejected(
              state,
              CheckedBodyProducerInvalidFloatLiteral(range)
            )
          }
        }
      }
      nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
    }
    BoolLit(value, start, length) -> match source_range(source, start, length) {
      range: CheckedSourceRange -> if expectation_allows(
        catalog,
        types.boolean,
        expectation
      ) {
        match state.boolean(value != 0, types.boolean, range) {
          (state, expression) -> CheckedBodyExprBuilt(state, expression)
        }
      } else {
        CheckedBodyExprRejected(
          state,
          expectation_mismatch(types.boolean, expectation)
        )
      }
      nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
    }
    NilExpr -> if expectation_allows(catalog, types.nil_type, expectation) {
      match state.nil(
        types.nil_type,
        CheckedSourceRange { start: 0, end: 0 }
      ) {
        (state, expression) -> CheckedBodyExprBuilt(state, expression)
      }
    } else {
      CheckedBodyExprRejected(
        state,
        expectation_mismatch(types.nil_type, expectation)
      )
    }
    Ident(start, length) -> match source_range(source, start, length) {
      range: CheckedSourceRange -> match lexical_lookup(
        environment,
        source,
        start,
        length
      ) {
        CheckedLexicalFound(binding, actual, _) -> if expectation_allows(
          catalog,
          actual,
          expectation
        ) {
          match state.local_reference(binding, actual, range) {
            (state, expression) -> CheckedBodyExprBuilt(state, expression)
          }
        } else {
          CheckedBodyExprRejected(
            state,
            expectation_mismatch(actual, expectation)
          )
        }
        CheckedLexicalMissing -> match source.span(range.start, range.end) {
          Some(name) -> match registration_scope_lookup_declaration_span(
            lexical_scope(environment),
            lexical_module(environment),
            ValueDeclaration,
            name
          ) {
            Some(declaration) -> match state.find_signature(
              DeclaredFunctionIdentity(declaration.identity)
            ) {
              Some(signature) -> if expectation_allows(
                catalog,
                signature.type_id,
                expectation
              ) {
                match state.declaration_reference(
                  declaration.identity,
                  signature.type_id,
                  range
                ) {
                  (state, expression) -> CheckedBodyExprBuilt(state, expression)
                }
              } else {
                CheckedBodyExprRejected(
                  state,
                  expectation_mismatch(signature.type_id, expectation)
                )
              }
              None -> CheckedBodyExprRejected(
                state,
                CheckedBodyProducerSignatureUnavailable(range)
              )
            }
            None -> CheckedBodyExprRejected(
              state,
              CheckedBodyProducerUnknownIdentifier(range)
            )
          }
          None -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
        }
      }
      nil -> CheckedBodyExprRejected(state, CheckedBodyProducerInvalidRange)
    }
    _ -> CheckedBodyExprRejected(state, CheckedBodyProducerUnsupportedExpression)
  }
}

fn checked_body_owner_signature(
  state: owned CheckedBodyBuild,
  types: CheckedBodyPrimitiveTypes,
  signature: SemanticFunctionSignature
) -> (
  owned CheckedBodyBuild,
  CheckedBodyPrimitiveTypes,
  SemanticFunctionSignature
) {
  let catalog = state.types()
  let resolution = types.resolution
  let methods = resolution.methods()
  match semantic_method_function_substitution(
    methods,
    catalog,
    signature.identity
  ) {
    None -> (
      state,
      checked_body_types_with_catalog(types, catalog),
      signature
    )
    Some(substitution) -> {
      let next_segment = catalog.next_derived_segment(
        types.module.identity,
        resolution.next_type_segment()
      )
      let product = semantic_type_product_continue(
        types.module.identity,
        catalog,
        next_segment
      )
      let (product, type_id) = semantic_type_product_substitute(
        product,
        substitution,
        signature.type_id
      )
      let next_catalog = semantic_type_product_catalog(product)
      (
        state.with_types(next_catalog),
        checked_body_types_with_catalog(types, next_catalog),
        SemanticFunctionSignature {
          identity: signature.identity,
          type_id: type_id,
          type_parameters_start: signature.type_parameters_start,
          type_parameters_count: signature.type_parameters_count,
          bounds_start: signature.bounds_start,
          bounds_count: signature.bounds_count
        }
      )
    }
  }
}

fn checked_body_functions(
  module: RegisteredModule,
  scope: RegistrationScope,
  types: CheckedBodyPrimitiveTypes,
  index: usize,
  state: owned CheckedBodyBuild
) -[SemanticConformance]> CheckedBodyFunctionsBuild {
  let functions = module.functions
  if index >= functions.len() { CheckedBodyFunctionsBuilt(state) }
  else {
    let function = functions.at(dense_index(index))
    let signature = state.signature(index)
    match checked_body_owner_signature(state, types, signature) {
      (state, types, signature) -> {
        let catalog = types.catalog
        let expected = semantic_function_result(catalog, signature.type_id)
        match checked_body_parameters(
          state,
          module.source,
          catalog,
          signature,
          function.syntax.params,
          0,
          CheckedLexicalRoot(
            scope,
            module.identity,
            function.syntax.type_params,
            signature.type_id
          )
        ) {
          CheckedBodyParametersBuilt(state, environment) -> match checked_body_expr(
            state,
            module.source,
            types,
            signature.identity,
            expected,
            CheckedOutsideLoop,
            environment,
            function.syntax.body,
            CheckedRequireResult(expected)
          ) {
            CheckedBodyExprBuilt(state, root) -> {
              let root_range = state.range(root)
              if semantic_continuation_type(catalog, state.result_type(root)) and
                not
                semantic_continuation_type(catalog, expected) {
                  CheckedBodyFunctionsRejected(
                    state,
                    CheckedBodyProducerContinuationResultRequired(root_range)
                  )
                } else {
                  checked_body_functions(
                    module,
                    scope,
                    types,
                    index + 1,
                    state.function(signature, root)
                  )
                }
            }
            CheckedBodyExprRejected(state, issue) -> CheckedBodyFunctionsRejected(
              state,
              issue
            )
          }
          CheckedBodyParametersRejected(state, issue) -> CheckedBodyFunctionsRejected(
            state,
            issue
          )
        }
      }
    }
  }
}

pub(package) fn check_registered_bodies(
  module: RegisteredModule,
  scope: RegistrationScope,
  resolution: SemanticResolutionProduct
) -[SemanticConformance]> CheckedBodyCheckResult {
  let signatures = resolution.signatures()
  match checked_body_primitive_types(module, scope, resolution) {
    CheckedBodyPrimitivesResolved(types) -> match checked_body_functions(
      module,
      scope,
      types,
      0,
      checked_body_build(module, signatures, types)
    ) {
      CheckedBodyFunctionsBuilt(state) -> state.freeze()
      CheckedBodyFunctionsRejected(state, issue) -> {
        state.drop()
        CheckedBodiesRejected(issue)
      }
    }
    CheckedBodyPrimitivesRejected(issue) -> CheckedBodiesRejected(
      CheckedBodyProducerTypeRejected(issue)
    )
  }
}
