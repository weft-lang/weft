fn checked_body_primitive_types(
  module: RegisteredModule,
  scope: RegistrationScope,
  resolution: SemanticResolutionProduct
) -> CheckedBodyPrimitiveResolution {
  let product = resolution.continue_types()
  match resolve_type_product_in_scope(
    product,
    module,
    scope,
    TypeParamListNil,
    NeverTypeExpr
  ) {
    (product, SemanticTypeResolved(never_type)) -> match resolve_type_product_in_scope(
      product,
      module,
      scope,
      TypeParamListNil,
      PrimitiveTypeExpr(0)
    ) {
      (product, SemanticTypeResolved(integer)) -> match resolve_type_product_in_scope(
        product,
        module,
        scope,
        TypeParamListNil,
        PrimitiveTypeExpr(1)
      ) {
        (product, SemanticTypeResolved(string)) -> match resolve_type_product_in_scope(
          product,
          module,
          scope,
          TypeParamListNil,
          PrimitiveTypeExpr(2)
        ) {
          (product, SemanticTypeResolved(boolean)) -> match resolve_type_product_in_scope(
            product,
            module,
            scope,
            TypeParamListNil,
            PrimitiveTypeExpr(3)
          ) {
            (product, SemanticTypeResolved(nil_type)) -> match resolve_type_product_in_scope(
              product,
              module,
              scope,
              TypeParamListNil,
              PrimitiveTypeExpr(4)
            ) {
              (product, SemanticTypeResolved(float64)) -> match resolve_type_product_in_scope(
                product,
                module,
                scope,
                TypeParamListNil,
                PrimitiveTypeExpr(14)
              ) {
                (product, SemanticTypeResolved(float32)) -> match resolve_type_product_in_scope(
                  product,
                  module,
                  scope,
                  TypeParamListNil,
                  PrimitiveTypeExpr(13)
                ) {
                  (product, SemanticTypeResolved(usize_type)) -> CheckedBodyPrimitivesResolved(
                    CheckedBodyPrimitiveTypes {
                      module: module,
                      catalog: semantic_type_product_catalog(product),
                      applications: resolution.applications(),
                      effect_applications: resolution.effect_applications(),
                      resolution: resolution,
                      never_type: never_type,
                      integer: integer,
                      usize_type: usize_type,
                      string: string,
                      boolean: boolean,
                      nil_type: nil_type,
                      float64: float64,
                      float32: float32
                    }
                  )
                  (_, SemanticTypeRejected(issue)) -> CheckedBodyPrimitivesRejected(issue)
                }
                (_, SemanticTypeRejected(issue)) -> CheckedBodyPrimitivesRejected(issue)
              }
              (_, SemanticTypeRejected(issue)) -> CheckedBodyPrimitivesRejected(issue)
            }
            (_, SemanticTypeRejected(issue)) -> CheckedBodyPrimitivesRejected(issue)
          }
          (_, SemanticTypeRejected(issue)) -> CheckedBodyPrimitivesRejected(issue)
        }
        (_, SemanticTypeRejected(issue)) -> CheckedBodyPrimitivesRejected(issue)
      }
      (_, SemanticTypeRejected(issue)) -> CheckedBodyPrimitivesRejected(issue)
    }
    (_, SemanticTypeRejected(issue)) -> CheckedBodyPrimitivesRejected(issue)
  }
}

fn checked_body_build(
  module: RegisteredModule,
  signatures: SemanticSignatureProduct,
  types: CheckedBodyPrimitiveTypes
) -> owned CheckedBodyBuild {
  let functions = module.functions
  let expressions = checked_expr_graph_builder(
    module.identity,
    module.source,
    types.catalog,
    functions.len()
  )
  let patterns = checked_pattern_graph_builder(
    expressions.segment(),
    module.source,
    types.catalog
  )
  let closures = checked_closure_builder(expressions, 0)
  let effects = checked_effect_builder(expressions, 0)
  let propagation = checked_propagation_builder(expressions, 0)
  CheckedBodyBuild(
    CheckedBodyBuildStorage {
      signatures: signatures,
      expressions: expressions,
      patterns: patterns,
      closures: closures,
      effects: effects,
      propagation: propagation
    }
  )
}

fn source_range(
  source: Source,
  start: i64,
  length: i64
) -> CheckedSourceRange? {
  if start < 0 or length < 0 { nil }
  else {
    let first = __i64_to_usize(start)
    let count = __i64_to_usize(length)
    if first > source.text.len() or count > source.text.len() - first { nil }
    else { CheckedSourceRange { start: first, end: first + count } }
  }
}

fn covering_range(
  first: CheckedSourceRange,
  last: CheckedSourceRange
) -> CheckedSourceRange? {
  if first.start == 0 and first.end == 0 { last }
  else {
    if last.start == 0 and last.end == 0 { first }
    else {
      if last.end < first.start { nil }
      else { CheckedSourceRange { start: first.start, end: last.end } }
    }
  }
}

fn same_source_name(
  source: Source,
  left_start: i64,
  left_length: i64,
  right_start: i64,
  right_length: i64
) -> bool {
  if left_length != right_length or left_start < 0 or right_start < 0 or
    left_length < 0 { false }
  else {
    let left_first = __i64_to_usize(left_start)
    let right_first = __i64_to_usize(right_start)
    let count = __i64_to_usize(left_length)
    match (
      source.text.slice(left_first, left_first + count),
      source.text.slice(right_first, right_first + count)
    ) {
      (Some(left), Some(right)) -> left == right
      _ -> false
    }
  }
}

fn lexical_lookup(
  environment: CheckedLexicalEnvironment,
  source: Source,
  start: i64,
  length: i64
) -> CheckedLexicalLookup {
  match environment {
    CheckedLexicalRoot(_, _, _, _) -> CheckedLexicalMissing
    CheckedLexicalBinding(binding_start, binding_length, binding, value_type, mutable, parent) ->
      if same_source_name(
        source,
        start,
        length,
        binding_start,
        binding_length
      ) {
        CheckedLexicalFound(binding, value_type, mutable)
      } else { lexical_lookup(parent, source, start, length) }
    CheckedLexicalHandledEffect(_, parent) -> lexical_lookup(parent, source, start, length)
    CheckedLexicalResume(_, _, parent) -> lexical_lookup(parent, source, start, length)
  }
}

fn lexical_scope(environment: CheckedLexicalEnvironment) -> RegistrationScope {
  match environment {
    CheckedLexicalRoot(scope, _, _, _) -> scope
    CheckedLexicalBinding(_, _, _, _, _, parent) -> lexical_scope(parent)
    CheckedLexicalHandledEffect(_, parent) -> lexical_scope(parent)
    CheckedLexicalResume(_, _, parent) -> lexical_scope(parent)
  }
}

fn lexical_module(environment: CheckedLexicalEnvironment) -> ModuleIdentity {
  match environment {
    CheckedLexicalRoot(_, module, _, _) -> module
    CheckedLexicalBinding(_, _, _, _, _, parent) -> lexical_module(parent)
    CheckedLexicalHandledEffect(_, parent) -> lexical_module(parent)
    CheckedLexicalResume(_, _, parent) -> lexical_module(parent)
  }
}

fn lexical_type_parameters(environment: CheckedLexicalEnvironment) -> TypeParamList {
  match environment {
    CheckedLexicalRoot(_, _, parameters, _) -> parameters
    CheckedLexicalBinding(_, _, _, _, _, parent) -> lexical_type_parameters(parent)
    CheckedLexicalHandledEffect(_, parent) -> lexical_type_parameters(parent)
    CheckedLexicalResume(_, _, parent) -> lexical_type_parameters(parent)
  }
}

fn lexical_function_type(environment: CheckedLexicalEnvironment) -> SemanticTypeId {
  match environment {
    CheckedLexicalRoot(_, _, _, function_type) -> function_type
    CheckedLexicalBinding(_, _, _, _, _, parent) -> lexical_function_type(parent)
    CheckedLexicalHandledEffect(_, parent) -> lexical_function_type(parent)
    CheckedLexicalResume(_, _, parent) -> lexical_function_type(parent)
  }
}

fn lexical_allows_effect(
  catalog: borrow SemanticTypeCatalog,
  environment: CheckedLexicalEnvironment,
  wanted: SemanticTypeId
) -> bool {
  match environment {
    CheckedLexicalRoot(_, _, _, function_type) -> semantic_function_allows_effect(
      catalog,
      function_type,
      wanted
    )
    CheckedLexicalBinding(_, _, _, _, _, parent) -> lexical_allows_effect(
      catalog,
      parent,
      wanted
    )
    CheckedLexicalHandledEffect(atom, parent) -> semantic_type_catalog_equal(
      catalog,
      atom,
      wanted
    ) or lexical_allows_effect(catalog, parent, wanted)
    CheckedLexicalResume(_, _, parent) -> lexical_allows_effect(catalog, parent, wanted)
  }
}

fn semantic_function_allows_effect_tail(
  catalog: borrow SemanticTypeCatalog,
  function_type: SemanticTypeId,
  wanted: usize
) -> bool {
  match catalog.graph_for(function_type) {
    Some(function_graph) -> match semantic_type_graph_node(function_graph, function_type) {
      SemanticFunctionNode(_, _, effects) -> match catalog.graph_for(effects) {
        Some(effect_graph) -> match semantic_type_graph_node(effect_graph, effects) {
          SemanticEffectSignatureNode(_, SemanticOpenEffects(available)) ->
            available == wanted
          _ -> false
        }
        None -> false
      }
      _ -> false
    }
    None -> false
  }
}

fn lexical_allows_effect_tail(
  catalog: borrow SemanticTypeCatalog,
  environment: CheckedLexicalEnvironment,
  wanted: usize
) -> bool {
  match environment {
    CheckedLexicalRoot(_, _, _, function_type) -> semantic_function_allows_effect_tail(
      catalog,
      function_type,
      wanted
    )
    CheckedLexicalBinding(_, _, _, _, _, parent) -> lexical_allows_effect_tail(
      catalog,
      parent,
      wanted
    )
    CheckedLexicalHandledEffect(_, parent) -> lexical_allows_effect_tail(
      catalog,
      parent,
      wanted
    )
    CheckedLexicalResume(_, _, parent) -> lexical_allows_effect_tail(
      catalog,
      parent,
      wanted
    )
  }
}

fn lexical_resume_types(
  environment: CheckedLexicalEnvironment
) -> CheckedLexicalResumeLookup {
  match environment {
    CheckedLexicalRoot(_, _, _, _) -> CheckedLexicalResumeMissing
    CheckedLexicalBinding(_, _, _, _, _, parent) -> lexical_resume_types(parent)
    CheckedLexicalHandledEffect(_, parent) -> lexical_resume_types(parent)
    CheckedLexicalResume(input, result, _) -> CheckedLexicalResumeFound(input, result)
  }
}

fn checked_body_unqualified_effect(
  source: Source,
  environment: CheckedLexicalEnvironment,
  start: i64,
  length: i64,
  arguments: TypeExprList,
  explicit: bool
) -> CheckedBodyEffectReference {
  let range = TypeNameRange { start: start, length: length }
  if explicit {
    CheckedBodyExplicitEffect(UnqualifiedEffectTypeExpr(0, arguments, range))
  } else {
    match source_range(source, start, length) {
      name_range: CheckedSourceRange -> match source.span(name_range.start, name_range.end) {
        Some(name) -> match registration_scope_lookup_declaration_span(
          lexical_scope(environment),
          lexical_module(environment),
          EffectDeclaration,
          name
        ) {
          Some(declaration) -> CheckedBodyBareEffect(declaration.identity)
          None -> CheckedBodyInvalidEffectReference
        }
        None -> CheckedBodyInvalidEffectReference
      }
      nil -> CheckedBodyInvalidEffectReference
    }
  }
}

fn checked_body_qualified_effect(
  source: Source,
  environment: CheckedLexicalEnvironment,
  qualifier_start: i64,
  qualifier_length: i64,
  name_start: i64,
  name_length: i64,
  arguments: TypeExprList,
  explicit: bool
) -> CheckedBodyEffectReference {
  let qualifier = TypeNameRange {
    start: qualifier_start,
    length: qualifier_length
  }
  let name = TypeNameRange { start: name_start, length: name_length }
  if explicit {
    CheckedBodyExplicitEffect(QualifiedEffectTypeExpr(qualifier, name, arguments))
  } else {
    match (
      source_range(source, qualifier_start, qualifier_length),
      source_range(source, name_start, name_length),
    ) {
      (qualifier_range: CheckedSourceRange, name_range: CheckedSourceRange) -> match (
        source.span(qualifier_range.start, qualifier_range.end),
        source.span(name_range.start, name_range.end),
      ) {
        (Some(qualifier_span), Some(name_span)) ->
          match registration_scope_lookup_qualified_declaration_span(
            lexical_scope(environment),
            lexical_module(environment),
            qualifier_span,
            EffectDeclaration,
            name_span
          ) {
            Some(declaration) -> CheckedBodyBareEffect(declaration.identity)
            None -> CheckedBodyInvalidEffectReference
          }
        _ -> CheckedBodyInvalidEffectReference
      }
      _ -> CheckedBodyInvalidEffectReference
    }
  }
}

fn checked_body_effect_reference(
  source: Source,
  environment: CheckedLexicalEnvironment,
  expression: Expr
) -> CheckedBodyEffectReference {
  match expression {
    Ident(start, length) -> checked_body_unqualified_effect(
      source,
      environment,
      start,
      length,
      TypeExprListNil,
      false
    )
    GenericCall(arguments, Ident(start, length)) -> checked_body_unqualified_effect(
      source,
      environment,
      start,
      length,
      arguments,
      true
    )
    FieldAccess(Ident(qualifier_start, qualifier_length), start, length, fact) -> {
      let (arguments, explicit) = match fact {
        ResolvedEffectAccessFact(_, values) -> (values, true)
        UnknownFieldAccessFact -> (TypeExprListNil, false)
        _ -> (TypeExprListNil, false)
      }
      checked_body_qualified_effect(
        source,
        environment,
        qualifier_start,
        qualifier_length,
        start,
        length,
        arguments,
        explicit
      )
    }
    GenericCall(
      arguments,
      FieldAccess(Ident(qualifier_start, qualifier_length), start, length, _),
    ) -> checked_body_qualified_effect(
      source,
      environment,
      qualifier_start,
      qualifier_length,
      start,
      length,
      arguments,
      true
    )
    _ -> CheckedBodyInvalidEffectReference
  }
}

fn checked_body_effect_reference_range(
  source: Source,
  expression: Expr
) -> CheckedSourceRange? {
  match expression {
    Ident(start, length) -> source_range(source, start, length)
    GenericCall(_, inner) -> checked_body_effect_reference_range(source, inner)
    FieldAccess(base, start, length, _) -> match (
      checked_body_effect_reference_range(source, base),
      source_range(source, start, length),
    ) {
      (first: CheckedSourceRange, last: CheckedSourceRange) -> covering_range(first, last)
      _ -> nil
    }
    _ -> nil
  }
}

fn semantic_function_result(
  catalog: borrow SemanticTypeCatalog,
  function_type: SemanticTypeId
) -> SemanticTypeId {
  match catalog.graph_for(function_type) {
    Some(graph) -> match semantic_type_graph_node(graph, function_type) {
      SemanticFunctionNode(_, result, _) -> result
      SemanticContinuationNode(_, result) -> result
      _ -> panic("Checked body signature is not a function type")
    }
    _ -> panic("Checked body signature is outside its type catalog")
  }
}

fn semantic_function_parameter_count(
  catalog: borrow SemanticTypeCatalog,
  function_type: SemanticTypeId
) -> usize {
  match catalog.graph_for(function_type) {
    Some(graph) -> match semantic_type_graph_node(graph, function_type) {
      SemanticFunctionNode(parameters, _, _) -> {
        let lists = semantic_type_graph_type_lists_local(graph)
        semantic_type_list_len(lists, parameters)
      }
      SemanticContinuationNode(_, _) -> {
        let arity: usize = 1
        arity
      }
      _ -> panic("Checked body signature is not a function type")
    }
    _ -> panic("Checked body signature is outside its type catalog")
  }
}

fn semantic_function_parameter(
  catalog: borrow SemanticTypeCatalog,
  function_type: SemanticTypeId,
  index: usize
) -> SemanticTypeId {
  match catalog.graph_for(function_type) {
    Some(graph) -> match semantic_type_graph_node(graph, function_type) {
      SemanticFunctionNode(parameters, _, _) -> {
        let lists = semantic_type_graph_type_lists_local(graph)
        semantic_type_graph_list_type_id(
          graph,
          semantic_type_list_edge(lists, parameters, index)
        )
      }
      SemanticContinuationNode(input, _) -> if index == 0 { input }
      else { panic("Checked continuation parameter is out of range") }
      _ -> panic("Checked body signature is not a function type")
    }
    _ -> panic("Checked body signature is outside its type catalog")
  }
}

fn semantic_function_type(
  catalog: borrow SemanticTypeCatalog,
  function_type: SemanticTypeId
) -> bool {
  match catalog.graph_for(function_type) {
    Some(graph) -> match semantic_type_graph_node(graph, function_type) {
      SemanticFunctionNode(_, _, _) -> true
      SemanticContinuationNode(_, _) -> true
      _ -> false
    }
    _ -> false
  }
}

fn semantic_continuation_type(
  catalog: borrow SemanticTypeCatalog,
  value_type: SemanticTypeId
) -> bool {
  match catalog.graph_for(value_type) {
    Some(graph) -> match semantic_type_graph_node(graph, value_type) {
      SemanticContinuationNode(_, _) -> true
      _ -> false
    }
    _ -> false
  }
}

fn semantic_function_allows_effect(
  catalog: borrow SemanticTypeCatalog,
  function_type: SemanticTypeId,
  wanted: SemanticTypeId
) -> bool {
  match catalog.graph_for(function_type) {
    Some(function_graph) -> match semantic_type_graph_node(function_graph, function_type) {
      SemanticFunctionNode(_, _, effects) -> match catalog.graph_for(effects) {
        Some(effect_graph) -> match semantic_type_graph_node(effect_graph, effects) {
          SemanticEffectSignatureNode(atoms, _) -> {
            let lists = semantic_type_graph_type_lists_local(effect_graph)
            let mut index: usize = 0
            while index < semantic_type_list_len(lists, atoms) {
              let atom = semantic_type_graph_list_type_id(
                effect_graph,
                semantic_type_list_edge(lists, atoms, index)
              )
              if semantic_type_catalog_equal(catalog, atom, wanted) { return true }
              index = index + 1
            }
            false
          }
          _ -> false
        }
        None -> false
      }
      _ -> false
    }
    None -> false
  }
}

fn checked_body_function_effect_requirement(
  catalog: borrow SemanticTypeCatalog,
  environment: CheckedLexicalEnvironment,
  function_type: SemanticTypeId
) -> CheckedBodyEffectRequirement {
  match catalog.graph_for(function_type) {
    Some(function_graph) -> match semantic_type_graph_node(function_graph, function_type) {
      SemanticContinuationNode(_, _) -> CheckedBodyEffectsAvailable
      SemanticFunctionNode(_, _, effects) -> match catalog.graph_for(effects) {
        Some(effect_graph) -> match semantic_type_graph_node(effect_graph, effects) {
          SemanticEffectSignatureNode(atoms, tail) -> {
            let lists = semantic_type_graph_type_lists_local(effect_graph)
            let mut index: usize = 0
            while index < semantic_type_list_len(lists, atoms) {
              let atom = semantic_type_graph_list_type_id(
                effect_graph,
                semantic_type_list_edge(lists, atoms, index)
              )
              if not lexical_allows_effect(catalog, environment, atom) {
                return CheckedBodyEffectAtomUnavailable(atom)
              }
              index = index + 1
            }
            match tail {
              SemanticClosedEffects -> CheckedBodyEffectsAvailable
              SemanticOpenEffects(variable) -> if lexical_allows_effect_tail(
                catalog,
                environment,
                variable
              ) { CheckedBodyEffectsAvailable }
              else { CheckedBodyEffectTailUnavailable(variable) }
            }
          }
          _ -> panic("Checked function effects are not an effect signature")
        }
        None -> panic("Checked function effects are outside the type catalog")
      }
      _ -> panic("Checked call signature is not callable")
    }
    None -> panic("Checked call signature is outside the type catalog")
  }
}

fn checked_body_select_bare_effect(
  types: CheckedBodyPrimitiveTypes,
  function_type: SemanticTypeId,
  declaration: DeclarationIdentity,
  operation: str
) -> CheckedBodyEffectSelection {
  let catalog = types.catalog
  let applications = types.effect_applications
  match catalog.graph_for(function_type) {
    Some(function_graph) -> match semantic_type_graph_node(function_graph, function_type) {
      SemanticFunctionNode(_, _, effects) -> match catalog.graph_for(effects) {
        Some(effect_graph) -> match semantic_type_graph_node(effect_graph, effects) {
          SemanticEffectSignatureNode(atoms, _) -> {
            let lists = semantic_type_graph_type_lists_local(effect_graph)
            let mut index: usize = 0
            let mut selected = CheckedBodyEffectSelectionMissing
            while index < semantic_type_list_len(lists, atoms) {
              let atom = semantic_type_graph_list_type_id(
                effect_graph,
                semantic_type_list_edge(lists, atoms, index)
              )
              match semantic_type_graph_node(effect_graph, atom) {
                SemanticEffectAtomNode(candidate, _) -> if declaration_identity_eq(
                  candidate,
                  declaration
                ) {
                  match semantic_effect_operation_projection(
                    applications,
                    catalog,
                    atom,
                    operation
                  ) {
                    SemanticEffectOperationProjected(
                      canonical,
                      effect_declaration,
                      operation_declaration,
                      deferred,
                      parameter_count,
                      result,
                    ) -> match selected {
                      CheckedBodyEffectSelectionMissing -> {
                        selected = CheckedBodyEffectSelected(
                          CheckedBodyEffectSite {
                            atom: canonical,
                            effect_declaration: effect_declaration,
                            operation_declaration: operation_declaration,
                            deferred: deferred,
                            parameter_count: parameter_count,
                            result: result
                          }
                        )
                      }
                      _ -> return CheckedBodyEffectSelectionAmbiguous(declaration)
                    }
                    SemanticEffectOperationMissing -> {
                      selected = CheckedBodyEffectOperationMissing
                    }
                    SemanticEffectApplicationUnavailable -> {
                      selected = CheckedBodyEffectApplicationMissing
                    }
                  }
                }
                _ -> nil
              }
              index = index + 1
            }
            selected
          }
          _ -> CheckedBodyEffectSelectionMissing
        }
        None -> CheckedBodyEffectSelectionMissing
      }
      _ -> CheckedBodyEffectSelectionMissing
    }
    None -> CheckedBodyEffectSelectionMissing
  }
}

fn checked_body_select_registered_effect(
  types: CheckedBodyPrimitiveTypes,
  declaration: DeclarationIdentity,
  operation: str
) -> CheckedBodyEffectSelection {
  let catalog = types.catalog
  let applications = types.effect_applications
  match semantic_effect_application_for_declaration(applications, declaration) {
    SemanticEffectApplicationSelected(atom) -> match semantic_effect_operation_projection(
      applications,
      catalog,
      atom,
      operation
    ) {
      SemanticEffectOperationProjected(
        canonical,
        effect_declaration,
        operation_declaration,
        deferred,
        parameter_count,
        result,
      ) -> CheckedBodyEffectSelected(
        CheckedBodyEffectSite {
          atom: canonical,
          effect_declaration: effect_declaration,
          operation_declaration: operation_declaration,
          deferred: deferred,
          parameter_count: parameter_count,
          result: result
        }
      )
      SemanticEffectOperationMissing -> CheckedBodyEffectOperationMissing
      SemanticEffectApplicationUnavailable -> CheckedBodyEffectApplicationMissing
    }
    SemanticEffectApplicationSelectionMissing -> CheckedBodyEffectApplicationMissing
    SemanticEffectApplicationSelectionAmbiguous -> CheckedBodyEffectSelectionAmbiguous(
      declaration
    )
  }
}

fn checked_body_select_lexical_effect(
  types: CheckedBodyPrimitiveTypes,
  environment: CheckedLexicalEnvironment,
  declaration: DeclarationIdentity,
  operation: str
) -> CheckedBodyEffectSelection {
  let catalog = types.catalog
  let applications = types.effect_applications
  match environment {
    CheckedLexicalRoot(_, _, _, function_type) -> checked_body_select_bare_effect(
      types,
      function_type,
      declaration,
      operation
    )
    CheckedLexicalBinding(_, _, _, _, _, parent) -> checked_body_select_lexical_effect(
      types,
      parent,
      declaration,
      operation
    )
    CheckedLexicalHandledEffect(atom, parent) -> match catalog.graph_for(atom) {
      Some(graph) -> match semantic_type_graph_node(graph, atom) {
        SemanticEffectAtomNode(candidate, _) -> if declaration_identity_eq(
          candidate,
          declaration
        ) {
          match semantic_effect_operation_projection(
            applications,
            catalog,
            atom,
            operation
          ) {
            SemanticEffectOperationProjected(
              canonical,
              effect_declaration,
              operation_declaration,
              deferred,
              parameter_count,
              result,
            ) -> CheckedBodyEffectSelected(
              CheckedBodyEffectSite {
                atom: canonical,
                effect_declaration: effect_declaration,
                operation_declaration: operation_declaration,
                deferred: deferred,
                parameter_count: parameter_count,
                result: result
              }
            )
            SemanticEffectOperationMissing -> CheckedBodyEffectOperationMissing
            SemanticEffectApplicationUnavailable -> CheckedBodyEffectApplicationMissing
          }
        } else {
          checked_body_select_lexical_effect(types, parent, declaration, operation)
        }
        _ -> checked_body_select_lexical_effect(types, parent, declaration, operation)
      }
      None -> checked_body_select_lexical_effect(types, parent, declaration, operation)
    }
    CheckedLexicalResume(_, _, parent) -> checked_body_select_lexical_effect(
      types,
      parent,
      declaration,
      operation
    )
  }
}

fn semantic_integer_type(
  catalog: borrow SemanticTypeCatalog,
  value: SemanticTypeId
) -> bool {
  match catalog.graph_for(value) {
    Some(graph) -> match semantic_type_graph_node(graph, value) {
      SemanticPrimitiveNode(primitive) -> match primitive {
        SemanticI64 -> true
        SemanticI32 -> true
        SemanticI8 -> true
        SemanticI16 -> true
        SemanticU8 -> true
        SemanticU16 -> true
        SemanticU32 -> true
        SemanticU64 -> true
        SemanticIsize -> true
        SemanticUsize -> true
        SemanticF32 -> false
        SemanticF64 -> false
        _ -> false
      }
      _ -> false
    }
    _ -> false
  }
}

fn semantic_numeric_type(
  catalog: borrow SemanticTypeCatalog,
  value: SemanticTypeId
) -> bool {
  match catalog.graph_for(value) {
    Some(graph) -> match semantic_type_graph_node(graph, value) {
      SemanticPrimitiveNode(primitive) -> match primitive {
        SemanticI64 -> true
        SemanticF64 -> true
        SemanticI32 -> true
        SemanticI8 -> true
        SemanticI16 -> true
        SemanticU8 -> true
        SemanticU16 -> true
        SemanticU32 -> true
        SemanticU64 -> true
        SemanticIsize -> true
        SemanticUsize -> true
        SemanticF32 -> true
        _ -> false
      }
      _ -> false
    }
    _ -> false
  }
}

fn checked_binary_resolution(operator: i64) -> CheckedBinaryResolution {
  match operator {
    1 -> CheckedNumericBinary(CheckedAdd)
    2 -> CheckedNumericBinary(CheckedSubtract)
    3 -> CheckedNumericBinary(CheckedMultiply)
    4 -> CheckedNumericBinary(CheckedDivide)
    5 -> CheckedEqualityBinary(CheckedEqual)
    6 -> CheckedEqualityBinary(CheckedNotEqual)
    7 -> CheckedOrderingBinary(CheckedLessThan)
    8 -> CheckedOrderingBinary(CheckedGreaterThan)
    9 -> CheckedOrderingBinary(CheckedLessOrEqual)
    10 -> CheckedOrderingBinary(CheckedGreaterOrEqual)
    11 -> CheckedIntegerBinary(CheckedModulo)
    12 -> CheckedBooleanBinary(CheckedLogicalAnd)
    13 -> CheckedBooleanBinary(CheckedLogicalOr)
    14 -> CheckedIntegerBinary(CheckedBitAnd)
    15 -> CheckedIntegerBinary(CheckedBitOr)
    16 -> CheckedIntegerBinary(CheckedBitXor)
    17 -> CheckedIntegerBinary(CheckedShiftLeft)
    18 -> CheckedIntegerBinary(CheckedShiftRight)
    _ -> CheckedBinaryUnsupported(operator)
  }
}

fn contextual_integer_literal(authored: Expr) -> bool {
  match authored {
    IntLit(_, _, _) -> true
    _ -> false
  }
}

fn semantic_primitive_type(
  catalog: borrow SemanticTypeCatalog,
  value: SemanticTypeId
) -> bool {
  match catalog.graph_for(value) {
    Some(graph) -> match semantic_type_graph_node(graph, value) {
      SemanticPrimitiveNode(_) -> true
      _ -> false
    }
    _ -> false
  }
}

fn binary_operand_class_accepts(
  catalog: borrow SemanticTypeCatalog,
  boolean: SemanticTypeId,
  value: SemanticTypeId,
  class: CheckedBinaryOperandClass
) -> bool {
  match class {
    CheckedNumericOperands -> semantic_numeric_type(catalog, value)
    CheckedIntegerOperands -> semantic_integer_type(catalog, value)
    CheckedBooleanOperands -> semantic_type_catalog_equal(catalog, value, boolean)
  }
}

fn binary_operand_issue(
  boolean: SemanticTypeId,
  value: SemanticTypeId,
  class: CheckedBinaryOperandClass
) -> CheckedBodyProducerIssue {
  match class {
    CheckedNumericOperands -> CheckedBodyProducerNumericOperandRequired(value)
    CheckedIntegerOperands -> CheckedBodyProducerIntegerOperandRequired(value)
    CheckedBooleanOperands -> CheckedBodyProducerTypeMismatch(value, boolean)
  }
}

fn primitive_equality_compatible(
  catalog: borrow SemanticTypeCatalog,
  integer: SemanticTypeId,
  left: SemanticTypeId,
  right: SemanticTypeId
) -[SemanticConformance]> bool {
  semantic_type_catalog_equal(catalog, left, right) or (
    semantic_type_is_subtype(catalog, left, integer) and
      semantic_type_is_subtype(catalog, right, integer)
  )
}

fn checked_body_type_arguments_into(
  expressions: owned CheckedExprGraphBuilder,
  list: CheckedTypeListBuilder,
  arguments: List<SemanticTypeId>
) -> (owned CheckedExprGraphBuilder, CheckedTypeListBuilder) {
  match arguments {
    Nil -> (expressions, list)
    Cons(argument, rest) -> match expressions.type_list_push(list, argument) {
      (expressions, list) -> checked_body_type_arguments_into(expressions, list, rest)
    }
  }
}

impl CheckedBodyBuild {
  fn segment(self: borrow Self) -> CheckedExprSegmentId {
    match self {
      CheckedBodyBuild(storage) -> {
        let { signatures: _, expressions, patterns: _, closures: _, effects: _, propagation: _ } = storage
        expressions.segment()
      }
    }
  }

  fn types(self: borrow Self) -> SemanticTypeCatalog {
    match self {
      CheckedBodyBuild(storage) -> {
        let { signatures: _, expressions, patterns: _, closures: _, effects: _, propagation: _ } = storage
        expressions.types()
      }
    }
  }

  fn with_types(
    self: owned Self,
    types: SemanticTypeCatalog
  ) -> owned CheckedBodyBuild {
    match self {
      CheckedBodyBuild(storage) -> {
