pub(package) type CheckedBodyProducerIssue {
  CheckedBodyProducerTypeRejected(SemanticTypeResolutionIssue),
  CheckedBodyProducerInvalidRange,
  CheckedBodyProducerUnknownIdentifier(CheckedSourceRange),
  CheckedBodyProducerUnknownField(CheckedSourceRange),
  CheckedBodyProducerImmutableAssignment(CheckedSourceRange),
  CheckedBodyProducerInferredBranchMismatch(SemanticTypeId, SemanticTypeId),
  CheckedBodyProducerLoopContextRequired,
  CheckedBodyProducerBreakOutsideLoop,
  CheckedBodyProducerContinueOutsideLoop,
  CheckedBodyProducerArityMismatch(usize, usize),
  CheckedBodyProducerGenericBoundRejected(SemanticTypeId, SemanticTypeId),
  CheckedBodyProducerGenericDeclarationRequired(CheckedSourceRange),
  CheckedBodyProducerCallableRequired(SemanticTypeId),
  CheckedBodyProducerContinuationConsumerRequired(CheckedSourceRange),
  CheckedBodyProducerContinuationResultRequired(CheckedSourceRange),
  CheckedBodyProducerContinuationBranchEscape(CheckedSourceRange),
  CheckedBodyProducerContinuationMutableBinding(CheckedSourceRange),
  CheckedBodyProducerBinaryOperandMismatch(SemanticTypeId, SemanticTypeId),
  CheckedBodyProducerIntegerOperandRequired(SemanticTypeId),
  CheckedBodyProducerInvalidFloatLiteral(CheckedSourceRange),
  CheckedBodyProducerNumericOperandRequired(SemanticTypeId),
  CheckedBodyProducerNonExhaustiveMatch,
  CheckedBodyProducerOperatorDispatchRequired(i64, SemanticTypeId),
  CheckedBodyProducerSignatureUnavailable(CheckedSourceRange),
  CheckedBodyProducerFieldProjectionUnavailable(SemanticTypeId),
  CheckedBodyProducerIndexedBaseRequired(SemanticTypeId),
  CheckedBodyProducerIndexedNamedBindingRequired(CheckedSourceRange),
  CheckedBodyProducerEffectReferenceRequired,
  CheckedBodyProducerEffectUnavailable(SemanticTypeId),
  CheckedBodyProducerEffectTailUnavailable(usize),
  CheckedBodyProducerEffectApplicationUnavailable,
  CheckedBodyProducerUnknownEffectOperation(CheckedSourceRange),
  CheckedBodyProducerAmbiguousEffectApplication(DeclarationIdentity),
  CheckedBodyProducerUnknownMethod(CheckedSourceRange),
  CheckedBodyProducerAmbiguousMethod(CheckedSourceRange),
  CheckedBodyProducerHandlerClauseRequired,
  CheckedBodyProducerHandlerEffectMismatch(SemanticTypeId, SemanticTypeId),
  CheckedBodyProducerHandlerContinuationRequiresDeferred,
  CheckedBodyProducerResumeOutsideHandler,
  CheckedBodyProducerBodyLocalTypeUnavailable(SemanticTypeId),
  CheckedBodyProducerUnsupportedBinaryOperator(i64),
  CheckedBodyProducerUnsupportedMatchArm,
  CheckedBodyProducerUnsupportedPattern,
  CheckedBodyProducerUnsupportedParameter,
  CheckedBodyProducerTypeMismatch(SemanticTypeId, SemanticTypeId),
  CheckedBodyProducerUnsupportedExpression,
  CheckedBodyProducerFreezeRejected(CheckedBodyProductIssue)
}

