}

type CheckedPatternFieldBuilderStorage {
  declared_identities: owned DenseBuilder<DeclarationIdentity>,
  declared_patterns: owned DenseBuilder<usize>,
  declared_ordinals: owned DenseBuilder<usize>,
  declared_types: owned CheckedPatternTypeBuilder,
  structural_keys: owned DenseBuilder<i64>,
  structural_patterns: owned DenseBuilder<usize>,
  structural_offsets: owned DenseBuilder<CheckedPatternFieldPosition>,
  structural_types: owned CheckedPatternTypeBuilder
}

type CheckedPatternFieldBuilder = opaque CheckedPatternFieldBuilderStorage

type CheckedPatternFieldColumns {
  declared_identities: DenseSegment<DeclarationIdentity>,
  declared_patterns: DenseSegment<usize>,
  declared_ordinals: DenseSegment<usize>,
  declared_types: CheckedPatternTypeReferences,
  structural_keys: DenseSegment<i64>,
  structural_patterns: DenseSegment<usize>,
