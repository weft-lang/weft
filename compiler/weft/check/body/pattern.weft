          constructor_qualifier_start: _,
          constructor_qualifier_end: _,
          typed_bindings,
          typed_annotations,
          typed_nil_tests: _,
          record_fields: _,
          tuple_items: _
        } = payloads
        (
          checked_binding_id_from_ordinal(segment, typed_bindings.at(payload)),
          pattern_type_at(
            typed_annotations,
