-- Immutable checked-pattern and match-arm storage for one retained module.
--
-- Patterns share the checked-expression segment identity but own a separate
-- child-before-parent topology. Match arms retain already-published pattern,
-- guard and body ordinals; no authored pattern or raw checker node survives.

use compiler/project/identity.{DeclarationIdentity}
use compiler/types/graph.{
  SemanticTypeId,
  SemanticTypeSegmentId,
  semantic_type_graph_contains,
  semantic_type_id_from_ordinal,
  semantic_type_id_ordinal,
  semantic_type_id_segment,
  semantic_type_segment_id,
  semantic_type_segment_id_eq
}
use compiler/types/graph/catalog.{SemanticTypeCatalog}
use compiler/weft/check/body/graph.{
  CheckedBindingId,
  CheckedExprGraphBuilder,
  CheckedExprId,
  CheckedExprSegmentId,
  CheckedMatchArmListId,
  CheckedSourceRange,
  checked_binding_id_from_ordinal,
  checked_binding_id_ordinal,
  checked_binding_id_segment,
  checked_expr_id_from_ordinal,
  checked_expr_id_ordinal,
  checked_expr_id_segment,
  checked_expr_segment_id_eq,
  checked_expr_segment_module,
  checked_match_arm_list_id,
  checked_match_arm_list_id_ordinal,
  checked_match_arm_list_id_segment
}
use compiler/weft/check/storage.{
  DenseBuilder,
  DenseIndex,
  DenseSegment,
  dense_builder,
  dense_index,
  dense_index_value
}
use stdlib/drop.{Drop}
use stdlib/map as map
use stdlib/map.{Map}
use stdlib/num/scalar.{num_scalar_usize_to_i64}
use stdlib/option.{None, Some}
use stdlib/panic.{panic}
use stdlib/source.{Source}

pub(package) type CheckedPatternId = opaque(CheckedExprSegmentId, DenseIndex)

pub(package) type CheckedPatternListId = opaque(CheckedExprSegmentId, DenseIndex)

pub(package) type CheckedPatternListBuilder = opaque(CheckedExprSegmentId, usize, usize)

pub(package) type CheckedPatternFieldListId = opaque(CheckedExprSegmentId, DenseIndex)

pub(package) type CheckedPatternFieldListBuilder = opaque(CheckedExprSegmentId, usize, usize)

pub(package) type CheckedMatchArmListBuilder = opaque(CheckedExprSegmentId, usize, usize)

pub(package) type CheckedIntegerPatternOrigin {
  CheckedNumericPattern,
  CheckedBooleanPattern
}

pub(package) type CheckedPatternKind {
  CheckedWildcardPatternKind,
  CheckedBindingPatternKind,
  CheckedIntegerPatternKind,
  CheckedConstructorPatternKind,
  CheckedTypedBindingPatternKind,
  CheckedNilPatternKind,
  CheckedRecordPatternKind,
  CheckedTuplePatternKind
}

pub(package) type CheckedPatternFieldKind {
  CheckedDeclaredPatternField,
  CheckedStructuralPatternField
}

pub(package) type CheckedPatternFieldPosition {
  CheckedPatternFieldOrdinal(usize),
  CheckedPatternFieldWordOffset(usize),
  CheckedPatternFieldUnplaced(str)
}

pub(package) type CheckedPatternField {
  kind: CheckedPatternFieldKind,
  declaration: DeclarationIdentity?,
  stable_key: i64,
  position: CheckedPatternFieldPosition,
  value_type: SemanticTypeId,
  pattern: CheckedPatternId
}

pub(package) type CheckedMatchGuard {
  CheckedUnguarded,
  CheckedGuarded(CheckedExprId)
}

pub(package) type CheckedMatchArm {
  pattern: CheckedPatternId,
  guard: CheckedMatchGuard,
  body: CheckedExprId,
  range: CheckedSourceRange
}

pub(package) type CheckedPatternNode {
  CheckedWildcardPatternNode,
  CheckedBindingPatternNode(CheckedBindingId),
  CheckedIntegerPatternNode(i64, CheckedIntegerPatternOrigin),
  CheckedConstructorPatternNode(
    DeclarationIdentity,
    CheckedPatternListId,
    CheckedSourceRange?
  ),
  CheckedTypedBindingPatternNode(CheckedBindingId, SemanticTypeId),
  CheckedNilPatternNode,
  CheckedRecordPatternNode(CheckedPatternFieldListId),
  CheckedTuplePatternNode(CheckedPatternListId)
}

pub(package) type CheckedPattern {
  input_type: SemanticTypeId,
  range: CheckedSourceRange,
  node: CheckedPatternNode
}

type CheckedPatternTypeBuilderStorage {
  ordinals: owned DenseBuilder<usize>,
  imported: owned DenseBuilder<bool>,
  segments: Map<i64, SemanticTypeSegmentId>
}

type CheckedPatternTypeBuilder = opaque CheckedPatternTypeBuilderStorage

type CheckedPatternTypeReferences {
  ordinals: DenseSegment<usize>,
  imported: DenseSegment<bool>,
  segments: Map<i64, SemanticTypeSegmentId>
}

type CheckedPatternHeaderBuilderStorage {
  kinds: owned DenseBuilder<CheckedPatternKind>,
  payloads: owned DenseBuilder<usize>,
  input_types: owned CheckedPatternTypeBuilder,
  starts: owned DenseBuilder<usize>,
  ends: owned DenseBuilder<usize>
}

type CheckedPatternHeaderBuilder = opaque CheckedPatternHeaderBuilderStorage

type CheckedPatternHeaderColumns {
  kinds: DenseSegment<CheckedPatternKind>,
  payloads: DenseSegment<usize>,
  input_types: CheckedPatternTypeReferences,
  starts: DenseSegment<usize>,
  ends: DenseSegment<usize>
}

type CheckedPatternPayloadBuilderStorage {
  bindings: owned DenseBuilder<usize>,
  integers: owned DenseBuilder<i64>,
  integer_origins: owned DenseBuilder<CheckedIntegerPatternOrigin>,
  constructors: owned DenseBuilder<DeclarationIdentity>,
  constructor_children: owned DenseBuilder<usize>,
  constructor_has_qualifier: owned DenseBuilder<bool>,
  constructor_qualifier_start: owned DenseBuilder<usize>,
  constructor_qualifier_end: owned DenseBuilder<usize>,
  typed_bindings: owned DenseBuilder<usize>,
  typed_annotations: owned CheckedPatternTypeBuilder,
  -- Whether a typed arm tests the nil sentinel rather than covering its input.
  typed_nil_tests: owned DenseBuilder<bool>,
  record_fields: owned DenseBuilder<usize>,
  tuple_items: owned DenseBuilder<usize>
}

type CheckedPatternPayloadBuilder = opaque CheckedPatternPayloadBuilderStorage

type CheckedPatternPayloadColumns {
  bindings: DenseSegment<usize>,
  integers: DenseSegment<i64>,
  integer_origins: DenseSegment<CheckedIntegerPatternOrigin>,
  constructors: DenseSegment<DeclarationIdentity>,
  constructor_children: DenseSegment<usize>,
  constructor_has_qualifier: DenseSegment<bool>,
  constructor_qualifier_start: DenseSegment<usize>,
  constructor_qualifier_end: DenseSegment<usize>,
  typed_bindings: DenseSegment<usize>,
  typed_annotations: CheckedPatternTypeReferences,
  typed_nil_tests: DenseSegment<bool>,
  record_fields: DenseSegment<usize>,
  tuple_items: DenseSegment<usize>
