fn pattern_field_builder() -> owned CheckedPatternFieldBuilder {
  CheckedPatternFieldBuilder(
    CheckedPatternFieldBuilderStorage {
      declared_identities: dense_builder<DeclarationIdentity>(),
      declared_patterns: dense_builder<usize>(),
      declared_ordinals: dense_builder<usize>(),
      declared_types: pattern_type_builder(),
      structural_keys: dense_builder<i64>(),
      structural_patterns: dense_builder<usize>(),
      structural_offsets: dense_builder<CheckedPatternFieldPosition>(),
      structural_types: pattern_type_builder()
    }
  )
}

impl CheckedPatternFieldBuilder {
  fn declared(
    self: owned Self,
    local: SemanticTypeSegmentId,
    declaration: DeclarationIdentity,
    pattern: usize,
    field_ordinal: usize,
    value_type: SemanticTypeId
  ) -> (owned Self, usize) {
    match self {
      CheckedPatternFieldBuilder(storage) -> {
        let {
          declared_identities,
          declared_patterns,
          declared_ordinals,
          declared_types,
          structural_keys,
          structural_patterns,
          structural_offsets,
          structural_types
        } = storage
        let mut identities = declared_identities
        let mut patterns = declared_patterns
        let mut ordinals = declared_ordinals
        let index = identities.push(declaration)
        let ordinal = dense_index_value(index)
        match declared_types.push(local, value_type) {
          (types, type_index) -> if dense_index_value(patterns.push(pattern)) != ordinal or
            dense_index_value(ordinals.push(field_ordinal)) != ordinal or
            dense_index_value(type_index) != ordinal {
              panic("Checked declared pattern-field columns diverged")
            } else {
              (
                CheckedPatternFieldBuilder(
                  CheckedPatternFieldBuilderStorage {
                    declared_identities: identities,
                    declared_patterns: patterns,
                    declared_ordinals: ordinals,
                    declared_types: types,
                    structural_keys: structural_keys,
                    structural_patterns: structural_patterns,
                    structural_offsets: structural_offsets,
                    structural_types: structural_types
                  }
                ),
                ordinal
              )
            }
        }
      }
    }
  }

  fn structural(
    self: owned Self,
    local: SemanticTypeSegmentId,
    key: i64,
    pattern: usize,
    offset: CheckedPatternFieldPosition,
    value_type: SemanticTypeId
  ) -> (owned Self, usize) {
    match self {
      CheckedPatternFieldBuilder(storage) -> {
        let {
          declared_identities,
          declared_patterns,
          declared_ordinals,
          declared_types,
          structural_keys,
          structural_patterns,
          structural_offsets,
          structural_types
        } = storage
        let mut keys = structural_keys
        let mut patterns = structural_patterns
        let mut offsets = structural_offsets
        let index = keys.push(key)
        let ordinal = dense_index_value(index)
        match structural_types.push(local, value_type) {
          (types, type_index) -> if dense_index_value(patterns.push(pattern)) != ordinal or
            dense_index_value(offsets.push(offset)) != ordinal or
            dense_index_value(type_index) != ordinal {
              panic("Checked structural pattern-field columns diverged")
            } else {
              (
                CheckedPatternFieldBuilder(
                  CheckedPatternFieldBuilderStorage {
                    declared_identities: declared_identities,
                    declared_patterns: declared_patterns,
                    declared_ordinals: declared_ordinals,
                    declared_types: declared_types,
                    structural_keys: keys,
                    structural_patterns: patterns,
                    structural_offsets: offsets,
                    structural_types: types
                  }
                ),
                ordinal
              )
            }
        }
      }
    }
  }

  fn freeze(self: owned Self) -> CheckedPatternFieldColumns {
    match self {
      CheckedPatternFieldBuilder(storage) -> {
        let {
          declared_identities,
          declared_patterns,
          declared_ordinals,
          declared_types,
          structural_keys,
          structural_patterns,
          structural_offsets,
          structural_types
        } = storage
        CheckedPatternFieldColumns {
          declared_identities: declared_identities.freeze(),
          declared_patterns: declared_patterns.freeze(),
          declared_ordinals: declared_ordinals.freeze(),
          declared_types: declared_types.freeze(),
          structural_keys: structural_keys.freeze(),
          structural_patterns: structural_patterns.freeze(),
          structural_offsets: structural_offsets.freeze(),
          structural_types: structural_types.freeze()
        }
      }
    }
  }
}

impl Drop for CheckedPatternFieldBuilder {
  fn drop(self) -> nil {
    match self {
      CheckedPatternFieldBuilder(storage) -> {
        let {
          declared_identities,
          declared_patterns,
          declared_ordinals,
          declared_types,
          structural_keys,
          structural_patterns,
          structural_offsets,
          structural_types
        } = storage
        declared_identities.drop()
        declared_patterns.drop()
        declared_ordinals.drop()
        declared_types.drop()
        structural_keys.drop()
        structural_patterns.drop()
        structural_offsets.drop()
        structural_types.drop()
      }
    }
  }
}

pub(package) fn checked_pattern_graph_builder(
  segment: CheckedExprSegmentId,
  source: Source,
  types: SemanticTypeCatalog
) -> owned CheckedPatternGraphBuilder {
  CheckedPatternGraphBuilder(
    CheckedPatternGraphBuilderStorage {
      segment: segment,
      source: source,
      types: types,
      headers: pattern_header_builder(),
      payloads: pattern_payload_builder(),
      lists: pattern_list_builder(),
      fields: pattern_field_builder()
    }
  )
}

pub(package) fn checked_pattern_id_segment(id: CheckedPatternId) -> CheckedExprSegmentId {
  match id { CheckedPatternId((segment, _)) -> segment }
}

pub(package) fn checked_pattern_id_ordinal(id: CheckedPatternId) -> usize {
  match id { CheckedPatternId((_, index)) -> dense_index_value(index) }
}

pub(package) fn checked_pattern_id_from_ordinal(
  segment: CheckedExprSegmentId,
  ordinal: usize
) -> CheckedPatternId {
  CheckedPatternId((segment, dense_index(ordinal)))
}

pub(package) fn checked_pattern_id_eq(
  left: CheckedPatternId,
  right: CheckedPatternId
) -> bool {
  checked_expr_segment_id_eq(
    checked_pattern_id_segment(left),
    checked_pattern_id_segment(right)
  ) and checked_pattern_id_ordinal(left) == checked_pattern_id_ordinal(right)
}

fn pattern_list_id_segment(id: CheckedPatternListId) -> CheckedExprSegmentId {
  match id { CheckedPatternListId((segment, _)) -> segment }
}

fn pattern_list_id_ordinal(id: CheckedPatternListId) -> usize {
  match id { CheckedPatternListId((_, index)) -> dense_index_value(index) }
}

fn pattern_field_list_id_segment(id: CheckedPatternFieldListId) -> CheckedExprSegmentId {
  match id { CheckedPatternFieldListId((segment, _)) -> segment }
}

fn pattern_field_list_id_ordinal(id: CheckedPatternFieldListId) -> usize {
  match id { CheckedPatternFieldListId((_, index)) -> dense_index_value(index) }
}

fn pattern_same_segment(expected: CheckedExprSegmentId, found: CheckedExprSegmentId) -> nil {
  if checked_expr_segment_id_eq(expected, found) { nil }
  else { panic("Checked pattern value belongs to another module segment") }
}

fn pattern_zero_usize() -> usize { dense_index_value(dense_index(0)) }

fn pattern_range(source: Source, range: CheckedSourceRange) -> CheckedSourceRange {
  if range.start > range.end or range.end > source.text.len() {
    panic("Checked pattern range is outside its retained source")
  } else { range }
}

fn pattern_type(types: borrow SemanticTypeCatalog, value: SemanticTypeId) -> nil {
  match types.graph_for(value) {
    Some(graph) -> if semantic_type_graph_contains(graph, value) { nil }
    else { panic("Checked pattern type is outside its semantic graph") }
    None -> panic("Checked pattern type is outside its semantic catalog")
  }
}

fn pattern_child_ordinal(
  segment: CheckedExprSegmentId,
  length: usize,
  child: CheckedPatternId
) -> usize {
  pattern_same_segment(segment, checked_pattern_id_segment(child))
  let ordinal = checked_pattern_id_ordinal(child)
  if ordinal >= length { panic("Checked pattern child must precede its parent") }
  else { ordinal }
}

fn pattern_expr_ordinal(
  expressions: borrow CheckedExprGraphBuilder,
  value: CheckedExprId
) -> usize {
  pattern_same_segment(expressions.segment(), checked_expr_id_segment(value))
  let ordinal = checked_expr_id_ordinal(value)
  if ordinal >= expressions.len() { panic("Checked match expression is not published") }
  else { ordinal }
}

fn pattern_binding_ordinal(
  expressions: borrow CheckedExprGraphBuilder,
  value: CheckedBindingId
) -> usize {
  pattern_same_segment(expressions.segment(), checked_binding_id_segment(value))
  let ordinal = checked_binding_id_ordinal(value)
  if ordinal >= expressions.binding_len() { panic("Checked pattern binding is not published") }
  else { ordinal }
}

fn pattern_builder_value(
  segment: CheckedExprSegmentId,
  source: Source,
  types: SemanticTypeCatalog,
  headers: owned CheckedPatternHeaderBuilder,
  payloads: owned CheckedPatternPayloadBuilder,
  lists: owned CheckedPatternListBuilderStorageBox,
  fields: owned CheckedPatternFieldBuilder
) -> owned CheckedPatternGraphBuilder {
  CheckedPatternGraphBuilder(
    CheckedPatternGraphBuilderStorage {
      segment: segment,
      source: source,
      types: types,
      headers: headers,
      payloads: payloads,
      lists: lists,
      fields: fields
    }
  )
}

fn pattern_finish(
  segment: CheckedExprSegmentId,
  source: Source,
  types: SemanticTypeCatalog,
  headers: owned CheckedPatternHeaderBuilder,
  payloads: owned CheckedPatternPayloadBuilder,
  lists: owned CheckedPatternListBuilderStorageBox,
  fields: owned CheckedPatternFieldBuilder,
  kind: CheckedPatternKind,
  payload: usize,
  input_type: SemanticTypeId,
  range: CheckedSourceRange
) -> (owned CheckedPatternGraphBuilder, CheckedPatternId) {
  pattern_type(types, input_type)
  match pattern_header_push(
    headers,
    segment,
    semantic_type_segment_id(checked_expr_segment_module(segment)),
    kind,
    payload,
    input_type,
    pattern_range(source, range)
  ) {
    (next_headers, id) -> (
      pattern_builder_value(
        segment,
        source,
        types,
        next_headers,
        payloads,
        lists,
        fields
      ),
      id
    )
  }
}

impl CheckedPatternGraphBuilder {
  pub(package) fn with_types(
    self: owned Self,
    types: SemanticTypeCatalog
  ) -> owned CheckedPatternGraphBuilder {
    match self {
      CheckedPatternGraphBuilder(storage) -> {
        let { segment, source, types: _, headers, payloads, lists, fields } = storage
        pattern_builder_value(
          segment,
          source,
          types,
          headers,
          payloads,
          lists,
          fields
        )
      }
    }
  }

  pub(package) fn len(self: borrow Self) -> usize {
    match self {
      CheckedPatternGraphBuilder(storage) -> {
        let { segment: _, source: _, types: _, headers, payloads: _, lists: _, fields: _ } = storage
        headers.len()
      }
    }
  }

  pub(package) fn pattern_list(
    self: owned Self
  ) -> (owned CheckedPatternGraphBuilder, CheckedPatternListBuilder) {
    match self {
      CheckedPatternGraphBuilder(storage) -> {
        let { segment, source, types, headers, payloads, lists, fields } = storage
        match lists.pattern_begin(segment) {
          (next_lists, list) -> (
            pattern_builder_value(
              segment,
              source,
              types,
              headers,
              payloads,
              next_lists,
              fields
            ),
            list
          )
        }
      }
    }
  }

  pub(package) fn pattern_list_push(
    self: owned Self,
    list: CheckedPatternListBuilder,
    child: CheckedPatternId
  ) -> (owned CheckedPatternGraphBuilder, CheckedPatternListBuilder) {
    match self {
      CheckedPatternGraphBuilder(storage) -> {
        let { segment, source, types, headers, payloads, lists, fields } = storage
        match list {
          CheckedPatternListBuilder((found, _, _)) -> pattern_same_segment(segment, found)
        }
        let child_ordinal = pattern_child_ordinal(segment, headers.len(), child)
        match lists.pattern_push(list, child_ordinal) {
          (next_lists, next_list) -> (
            pattern_builder_value(
              segment,
              source,
              types,
              headers,
              payloads,
              next_lists,
              fields
            ),
            next_list
          )
        }
      }
    }
  }

  pub(package) fn pattern_list_finish(
    self: owned Self,
    list: CheckedPatternListBuilder
  ) -> (owned CheckedPatternGraphBuilder, CheckedPatternListId) {
    match self {
      CheckedPatternGraphBuilder(storage) -> {
        let { segment, source, types, headers, payloads, lists, fields } = storage
        match list {
          CheckedPatternListBuilder((found, _, _)) -> pattern_same_segment(segment, found)
        }
        match lists.pattern_finish(list) {
          (next_lists, id) -> (
            pattern_builder_value(
              segment,
              source,
              types,
              headers,
              payloads,
              next_lists,
              fields
            ),
            id
          )
        }
      }
    }
  }

  pub(package) fn pattern_field_list(
    self: owned Self
  ) -> (owned CheckedPatternGraphBuilder, CheckedPatternFieldListBuilder) {
    match self {
      CheckedPatternGraphBuilder(storage) -> {
        let { segment, source, types, headers, payloads, lists, fields } = storage
        match lists.field_begin(segment) {
          (next_lists, list) -> (
            pattern_builder_value(
              segment,
              source,
              types,
              headers,
              payloads,
              next_lists,
              fields
            ),
            list
          )
        }
      }
    }
  }

  pub(package) fn declared_pattern_field(
    self: owned Self,
    list: CheckedPatternFieldListBuilder,
    declaration: DeclarationIdentity,
    child: CheckedPatternId,
    field_ordinal: usize,
    value_type: SemanticTypeId
  ) -> (owned CheckedPatternGraphBuilder, CheckedPatternFieldListBuilder) {
    match self {
      CheckedPatternGraphBuilder(storage) -> {
        let { segment, source, types, headers, payloads, lists, fields } = storage
        match list {
          CheckedPatternFieldListBuilder((found, _, _)) -> pattern_same_segment(segment, found)
        }
        pattern_type(types, value_type)
        let child_ordinal = pattern_child_ordinal(segment, headers.len(), child)
        match fields.declared(
          semantic_type_segment_id(checked_expr_segment_module(segment)),
          declaration,
          child_ordinal,
          field_ordinal,
          value_type
        ) {
          (next_fields, payload) -> match lists.field_push(
            list,
            CheckedDeclaredPatternField,
            payload
          ) {
            (next_lists, next_list) -> (
              pattern_builder_value(
                segment,
                source,
                types,
                headers,
                payloads,
                next_lists,
                next_fields
              ),
              next_list
            )
          }
        }
      }
    }
  }

  pub(package) fn structural_pattern_field(
    self: owned Self,
    list: CheckedPatternFieldListBuilder,
    stable_key: i64,
    child: CheckedPatternId,
    word_offset: CheckedPatternFieldPosition,
    value_type: SemanticTypeId
  ) -> (owned CheckedPatternGraphBuilder, CheckedPatternFieldListBuilder) {
    match self {
      CheckedPatternGraphBuilder(storage) -> {
        let { segment, source, types, headers, payloads, lists, fields } = storage
        match list {
          CheckedPatternFieldListBuilder((found, _, _)) -> pattern_same_segment(segment, found)
        }
        pattern_type(types, value_type)
        let child_ordinal = pattern_child_ordinal(segment, headers.len(), child)
        match fields.structural(
          semantic_type_segment_id(checked_expr_segment_module(segment)),
          stable_key,
          child_ordinal,
          word_offset,
          value_type
        ) {
          (next_fields, payload) -> match lists.field_push(
            list,
            CheckedStructuralPatternField,
            payload
          ) {
            (next_lists, next_list) -> (
              pattern_builder_value(
                segment,
                source,
                types,
                headers,
                payloads,
                next_lists,
                next_fields
              ),
              next_list
            )
          }
        }
      }
    }
  }

  pub(package) fn pattern_field_list_finish(
    self: owned Self,
    list: CheckedPatternFieldListBuilder
  ) -> (owned CheckedPatternGraphBuilder, CheckedPatternFieldListId) {
    match self {
      CheckedPatternGraphBuilder(storage) -> {
        let { segment, source, types, headers, payloads, lists, fields } = storage
        match list {
          CheckedPatternFieldListBuilder((found, _, _)) -> pattern_same_segment(segment, found)
        }
        match lists.field_finish(list) {
          (next_lists, id) -> (
            pattern_builder_value(
              segment,
              source,
              types,
              headers,
              payloads,
              next_lists,
              fields
            ),
            id
          )
        }
      }
    }
  }

  pub(package) fn match_arm_list(
    self: owned Self
  ) -> (owned CheckedPatternGraphBuilder, CheckedMatchArmListBuilder) {
    match self {
      CheckedPatternGraphBuilder(storage) -> {
        let { segment, source, types, headers, payloads, lists, fields } = storage
        match lists.arm_begin(segment) {
          (next_lists, list) -> (
            pattern_builder_value(
              segment,
              source,
              types,
              headers,
              payloads,
              next_lists,
              fields
            ),
            list
          )
        }
      }
    }
  }

  pub(package) fn match_arm_list_push(
    self: owned Self,
    expressions: borrow CheckedExprGraphBuilder,
    list: CheckedMatchArmListBuilder,
    pattern: CheckedPatternId,
    guard: CheckedMatchGuard,
    body: CheckedExprId,
    range: CheckedSourceRange
  ) -> (owned CheckedPatternGraphBuilder, CheckedMatchArmListBuilder) {
    match self {
      CheckedPatternGraphBuilder(storage) -> {
        let { segment, source, types, headers, payloads, lists, fields } = storage
        pattern_same_segment(segment, expressions.segment())
        match list {
          CheckedMatchArmListBuilder((found, _, _)) -> pattern_same_segment(segment, found)
        }
        let pattern_ordinal = pattern_child_ordinal(segment, headers.len(), pattern)
        let body_ordinal = pattern_expr_ordinal(expressions, body)
        let (guarded, guard_ordinal) = match guard {
          CheckedUnguarded -> (false, pattern_zero_usize())
          CheckedGuarded(value) -> (true, pattern_expr_ordinal(expressions, value))
        }
        match lists.arm_push(
          list,
          pattern_ordinal,
          guarded,
          guard_ordinal,
          body_ordinal,
          pattern_range(source, range)
        ) {
          (next_lists, next_list) -> (
            pattern_builder_value(
              segment,
              source,
              types,
              headers,
              payloads,
              next_lists,
              fields
            ),
            next_list
          )
        }
      }
    }
  }

  pub(package) fn match_arm_list_finish(
    self: owned Self,
    list: CheckedMatchArmListBuilder
  ) -> (owned CheckedPatternGraphBuilder, CheckedMatchArmListId) {
    match self {
      CheckedPatternGraphBuilder(storage) -> {
        let { segment, source, types, headers, payloads, lists, fields } = storage
        match list {
          CheckedMatchArmListBuilder((found, _, _)) -> pattern_same_segment(segment, found)
        }
        match lists.arm_finish(list) {
          (next_lists, id) -> (
            pattern_builder_value(
              segment,
              source,
              types,
              headers,
              payloads,
              next_lists,
              fields
            ),
            id
          )
        }
      }
    }
  }

  fn nullary(
    self: owned Self,
    kind: CheckedPatternKind,
    input_type: SemanticTypeId,
    range: CheckedSourceRange
  ) -> (owned CheckedPatternGraphBuilder, CheckedPatternId) {
    match self {
      CheckedPatternGraphBuilder(storage) -> {
        let { segment, source, types, headers, payloads, lists, fields } = storage
        pattern_finish(
          segment,
          source,
          types,
          headers,
          payloads,
          lists,
          fields,
          kind,
          0,
          input_type,
          range
        )
      }
    }
  }

  pub(package) fn wildcard(
    self: owned Self,
    input_type: SemanticTypeId,
    range: CheckedSourceRange
  ) -> (owned CheckedPatternGraphBuilder, CheckedPatternId) {
    self.nullary(CheckedWildcardPatternKind, input_type, range)
  }

  pub(package) fn nil_pattern(
    self: owned Self,
    input_type: SemanticTypeId,
    range: CheckedSourceRange
  ) -> (owned CheckedPatternGraphBuilder, CheckedPatternId) {
    self.nullary(CheckedNilPatternKind, input_type, range)
  }

  pub(package) fn binding(
    self: owned Self,
    expressions: borrow CheckedExprGraphBuilder,
    binding: CheckedBindingId,
    input_type: SemanticTypeId,
    range: CheckedSourceRange
  ) -> (owned CheckedPatternGraphBuilder, CheckedPatternId) {
    match self {
      CheckedPatternGraphBuilder(storage) -> {
        let { segment, source, types, headers, payloads, lists, fields } = storage
        pattern_same_segment(segment, expressions.segment())
        match payloads.binding(pattern_binding_ordinal(expressions, binding)) {
          (next_payloads, payload) -> pattern_finish(
            segment,
            source,
            types,
            headers,
            next_payloads,
            lists,
            fields,
            CheckedBindingPatternKind,
            payload,
            input_type,
            range
          )
        }
      }
    }
  }

  pub(package) fn integer(
    self: owned Self,
    value: i64,
    origin: CheckedIntegerPatternOrigin,
    input_type: SemanticTypeId,
    range: CheckedSourceRange
  ) -> (owned CheckedPatternGraphBuilder, CheckedPatternId) {
    match self {
      CheckedPatternGraphBuilder(storage) -> {
        let { segment, source, types, headers, payloads, lists, fields } = storage
        match payloads.integer(value, origin) {
          (next_payloads, payload) -> pattern_finish(
            segment,
            source,
            types,
            headers,
            next_payloads,
            lists,
            fields,
            CheckedIntegerPatternKind,
            payload,
            input_type,
            range
          )
        }
      }
    }
  }

  pub(package) fn constructor(
    self: owned Self,
    declaration: DeclarationIdentity,
    children: CheckedPatternListId,
    qualifier: CheckedSourceRange?,
    input_type: SemanticTypeId,
    range: CheckedSourceRange
  ) -> (owned CheckedPatternGraphBuilder, CheckedPatternId) {
    match self {
      CheckedPatternGraphBuilder(storage) -> {
        let { segment, source, types, headers, payloads, lists, fields } = storage
        pattern_same_segment(segment, pattern_list_id_segment(children))
        match qualifier {
          value: CheckedSourceRange -> {
            pattern_range(source, value)
            nil
          }
          nil -> nil
        }
        match payloads.constructor(
          declaration,
          pattern_list_id_ordinal(children),
          qualifier
        ) {
          (next_payloads, payload) -> pattern_finish(
            segment,
            source,
            types,
            headers,
            next_payloads,
            lists,
            fields,
            CheckedConstructorPatternKind,
            payload,
            input_type,
            range
          )
        }
      }
    }
  }

  pub(package) fn typed_binding(
    self: owned Self,
    expressions: borrow CheckedExprGraphBuilder,
    binding: CheckedBindingId,
    annotation: SemanticTypeId,
    nil_tested: bool,
    input_type: SemanticTypeId,
    range: CheckedSourceRange
  ) -> (owned CheckedPatternGraphBuilder, CheckedPatternId) {
    match self {
      CheckedPatternGraphBuilder(storage) -> {
        let { segment, source, types, headers, payloads, lists, fields } = storage
        pattern_same_segment(segment, expressions.segment())
        pattern_type(types, annotation)
        match payloads.typed_binding(
          semantic_type_segment_id(checked_expr_segment_module(segment)),
          pattern_binding_ordinal(expressions, binding),
          annotation,
          nil_tested
        ) {
          (next_payloads, payload) -> pattern_finish(
            segment,
            source,
            types,
            headers,
            next_payloads,
            lists,
            fields,
            CheckedTypedBindingPatternKind,
            payload,
            input_type,
            range
          )
        }
      }
    }
  }

  pub(package) fn record(
    self: owned Self,
    fields: CheckedPatternFieldListId,
    input_type: SemanticTypeId,
    range: CheckedSourceRange
  ) -> (owned CheckedPatternGraphBuilder, CheckedPatternId) {
    match self {
      CheckedPatternGraphBuilder(storage) -> {
        let { segment, source, types, headers, payloads, lists, fields: field_values } = storage
        pattern_same_segment(segment, pattern_field_list_id_segment(fields))
        match payloads.record(pattern_field_list_id_ordinal(fields)) {
          (next_payloads, payload) -> pattern_finish(
            segment,
            source,
            types,
            headers,
            next_payloads,
            lists,
            field_values,
            CheckedRecordPatternKind,
            payload,
            input_type,
            range
          )
        }
      }
    }
  }

  pub(package) fn tuple(
    self: owned Self,
    items: CheckedPatternListId,
    input_type: SemanticTypeId,
    range: CheckedSourceRange
  ) -> (owned CheckedPatternGraphBuilder, CheckedPatternId) {
    match self {
      CheckedPatternGraphBuilder(storage) -> {
        let { segment, source, types, headers, payloads, lists, fields } = storage
        pattern_same_segment(segment, pattern_list_id_segment(items))
        match payloads.tuple(pattern_list_id_ordinal(items)) {
          (next_payloads, payload) -> pattern_finish(
            segment,
            source,
            types,
            headers,
            next_payloads,
            lists,
            fields,
            CheckedTuplePatternKind,
            payload,
            input_type,
            range
          )
        }
      }
    }
  }

  pub(package) fn freeze(self: owned Self) -> CheckedPatternGraph {
    match self {
      CheckedPatternGraphBuilder(storage) -> {
        let { segment, source, types, headers, payloads, lists, fields } = storage
        CheckedPatternGraph(
          CheckedPatternGraphStorage {
            segment: segment,
            source: source,
            types: types,
            headers: headers.freeze(),
            payloads: payloads.freeze(),
            lists: lists.freeze(),
            fields: fields.freeze()
          }
        )
      }
    }
  }
}

fn pattern_headers_kind(
  headers: borrow CheckedPatternHeaderColumns,
  index: DenseIndex
) -> CheckedPatternKind {
  let { kinds, payloads: _, input_types: _, starts: _, ends: _ } = headers
  kinds.at(index)
}

fn pattern_headers_payload(
  headers: borrow CheckedPatternHeaderColumns,
  index: DenseIndex
) -> usize {
  let { kinds: _, payloads, input_types: _, starts: _, ends: _ } = headers
  payloads.at(index)
}

fn pattern_headers_type(
  headers: borrow CheckedPatternHeaderColumns,
  local: SemanticTypeSegmentId,
  index: DenseIndex
) -> SemanticTypeId {
  let { kinds: _, payloads: _, input_types, starts: _, ends: _ } = headers
  pattern_type_at(input_types, local, index)
}

fn pattern_headers_range(
  headers: borrow CheckedPatternHeaderColumns,
  index: DenseIndex
) -> CheckedSourceRange {
  let { kinds: _, payloads: _, input_types: _, starts, ends } = headers
  CheckedSourceRange { start: starts.at(index), end: ends.at(index) }
}

fn pattern_kind_eq(left: CheckedPatternKind, right: CheckedPatternKind) -> bool {
  match (left, right) {
    (CheckedWildcardPatternKind, CheckedWildcardPatternKind) -> true
    (CheckedBindingPatternKind, CheckedBindingPatternKind) -> true
    (CheckedIntegerPatternKind, CheckedIntegerPatternKind) -> true
    (CheckedConstructorPatternKind, CheckedConstructorPatternKind) -> true
    (CheckedTypedBindingPatternKind, CheckedTypedBindingPatternKind) -> true
    (CheckedNilPatternKind, CheckedNilPatternKind) -> true
    (CheckedRecordPatternKind, CheckedRecordPatternKind) -> true
    (CheckedTuplePatternKind, CheckedTuplePatternKind) -> true
    _ -> false
  }
}

fn pattern_list_bounds(
  starts: borrow DenseSegment<usize>,
  counts: borrow DenseSegment<usize>,
  list: usize
) -> (usize, usize) {
  let index = dense_index(list)
  (starts.at(index), counts.at(index))
}

impl CheckedPatternGraph {
  pub(package) fn segment(self: borrow Self) -> CheckedExprSegmentId {
    match self {
      CheckedPatternGraph(storage) -> {
        let { segment, source: _, types: _, headers: _, payloads: _, lists: _, fields: _ } = storage
        segment
      }
    }
  }

  pub(package) fn len(self: borrow Self) -> usize {
    match self {
      CheckedPatternGraph(storage) -> {
        let { segment: _, source: _, types: _, headers, payloads: _, lists: _, fields: _ } = storage
        let { kinds, payloads: _, input_types: _, starts: _, ends: _ } = headers
        kinds.len()
      }
    }
  }

  pub(package) fn contains_match_arm_list(
    self: borrow Self,
    id: CheckedMatchArmListId
  ) -> bool {
    if not checked_expr_segment_id_eq(
      self.segment(),
      checked_match_arm_list_id_segment(id)
    ) { false }
    else {
      match self {
        CheckedPatternGraph(storage) -> {
          let { segment: _, source: _, types: _, headers: _, payloads: _, lists, fields: _ } = storage
          let {
            pattern_children: _,
            pattern_starts: _,
            pattern_counts: _,
            field_kinds: _,
            field_payloads: _,
            field_starts: _,
            field_counts: _,
            arm_patterns: _,
            arm_guarded: _,
            arm_guards: _,
            arm_bodies: _,
            arm_starts: _,
            arm_ends: _,
            arm_list_starts,
            arm_list_counts: _
          } = lists
          checked_match_arm_list_id_ordinal(id) < arm_list_starts.len()
        }
      }
    }
  }

  fn index(self: borrow Self, id: CheckedPatternId) -> DenseIndex {
    pattern_same_segment(self.segment(), checked_pattern_id_segment(id))
    let ordinal = checked_pattern_id_ordinal(id)
    if ordinal >= self.len() { panic("Checked pattern is outside its graph") }
    else { dense_index(ordinal) }
  }

  pub(package) fn kind(self: borrow Self, id: CheckedPatternId) -> CheckedPatternKind {
    let index = self.index(id)
    match self {
      CheckedPatternGraph(storage) -> {
        let { segment: _, source: _, types: _, headers, payloads: _, lists: _, fields: _ } = storage
        pattern_headers_kind(headers, index)
      }
    }
  }

  fn payload(self: borrow Self, id: CheckedPatternId, kind: CheckedPatternKind) -> DenseIndex {
    let index = self.index(id)
    match self {
      CheckedPatternGraph(storage) -> {
        let { segment: _, source: _, types: _, headers, payloads: _, lists: _, fields: _ } = storage
        if pattern_kind_eq(pattern_headers_kind(headers, index), kind) {
          dense_index(pattern_headers_payload(headers, index))
        } else { panic("Checked pattern accessor used with the wrong kind") }
      }
    }
  }

  pub(package) fn input_type(self: borrow Self, id: CheckedPatternId) -> SemanticTypeId {
    let index = self.index(id)
    match self {
      CheckedPatternGraph(storage) -> {
        let { segment, source: _, types: _, headers, payloads: _, lists: _, fields: _ } = storage
        pattern_headers_type(
          headers,
          semantic_type_segment_id(checked_expr_segment_module(segment)),
          index
        )
      }
    }
  }

  pub(package) fn range(self: borrow Self, id: CheckedPatternId) -> CheckedSourceRange {
