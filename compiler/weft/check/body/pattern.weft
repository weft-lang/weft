type CheckedPatternListBuilderStorageBox = opaque CheckedPatternListBuilderStorage

type CheckedPatternListColumns {
  pattern_children: DenseSegment<usize>,
  pattern_starts: DenseSegment<usize>,
  pattern_counts: DenseSegment<usize>,
  field_kinds: DenseSegment<CheckedPatternFieldKind>,
  field_payloads: DenseSegment<usize>,
  field_starts: DenseSegment<usize>,
  field_counts: DenseSegment<usize>,
  arm_patterns: DenseSegment<usize>,
  arm_guarded: DenseSegment<bool>,
  arm_guards: DenseSegment<usize>,
  arm_bodies: DenseSegment<usize>,
  arm_starts: DenseSegment<usize>,
  arm_ends: DenseSegment<usize>,
  arm_list_starts: DenseSegment<usize>,
