  pub(package) fn pattern_list_len(self: borrow Self, id: CheckedPatternListId) -> usize {
    pattern_same_segment(self.segment(), pattern_list_id_segment(id))
    match self {
      CheckedPatternGraph(storage) -> {
        let { segment: _, source: _, types: _, headers: _, payloads: _, lists, fields: _ } = storage
        let {
          pattern_children: _,
          pattern_starts,
          pattern_counts,
          field_kinds: _,
          field_payloads: _,
          field_starts: _,
          field_counts: _,
          arm_patterns: _,
          arm_guarded: _,
          arm_guards: _,
          arm_bodies: _,
          arm_starts: _,
          arm_ends: _,
          arm_list_starts: _,
          arm_list_counts: _
        } = lists
        match pattern_list_bounds(pattern_starts, pattern_counts, pattern_list_id_ordinal(id)) {
          (_, count) -> count
        }
      }
    }
  }

  pub(package) fn pattern_list_at(
    self: borrow Self,
    id: CheckedPatternListId,
    position: usize
  ) -> CheckedPatternId {
    pattern_same_segment(self.segment(), pattern_list_id_segment(id))
    match self {
      CheckedPatternGraph(storage) -> {
        let { segment, source: _, types: _, headers: _, payloads: _, lists, fields: _ } = storage
        let {
          pattern_children,
          pattern_starts,
          pattern_counts,
          field_kinds: _,
          field_payloads: _,
          field_starts: _,
          field_counts: _,
          arm_patterns: _,
          arm_guarded: _,
          arm_guards: _,
          arm_bodies: _,
          arm_starts: _,
          arm_ends: _,
          arm_list_starts: _,
          arm_list_counts: _
        } = lists
        match pattern_list_bounds(pattern_starts, pattern_counts, pattern_list_id_ordinal(id)) {
          (start, count) -> {
            if position >= count { panic("Checked pattern-list position is out of bounds") }
            else {
              CheckedPatternId(
                (segment, dense_index(pattern_children.at(dense_index(start + position))))
              )
            }
          }
        }
      }
    }
  }

  pub(package) fn pattern_field_list_len(
    self: borrow Self,
    id: CheckedPatternFieldListId
  ) -> usize {
    pattern_same_segment(self.segment(), pattern_field_list_id_segment(id))
    match self {
