  pub(package) fn binding(self: borrow Self, id: CheckedPatternId) -> CheckedBindingId {
    let payload = self.payload(id, CheckedBindingPatternKind)
    match self {
      CheckedPatternGraph(storage) -> {
        let { segment, source: _, types: _, headers: _, payloads, lists: _, fields: _ } = storage
        let {
          bindings,
          integers: _,
          integer_origins: _,
          constructors: _,
          constructor_children: _,
          constructor_has_qualifier: _,
          constructor_qualifier_start: _,
          constructor_qualifier_end: _,
          typed_bindings: _,
          typed_annotations: _,
          typed_nil_tests: _,
          record_fields: _,
          tuple_items: _
        } = payloads
        checked_binding_id_from_ordinal(segment, bindings.at(payload))
      }
    }
  }

