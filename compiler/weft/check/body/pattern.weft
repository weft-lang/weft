        }
      }
    }
  }

  pub(package) fn pattern_field_list_at(
    self: borrow Self,
    id: CheckedPatternFieldListId,
    position: usize
  ) -> CheckedPatternField {
    pattern_same_segment(self.segment(), pattern_field_list_id_segment(id))
    match self {
      CheckedPatternGraph(storage) -> {
        let { segment, source: _, types: _, headers: _, payloads: _, lists, fields } = storage
        let {
          pattern_children: _,
          pattern_starts: _,
          pattern_counts: _,
          field_kinds,
          field_payloads,
          field_starts,
          field_counts,
          arm_patterns: _,
          arm_guarded: _,
          arm_guards: _,
          arm_bodies: _,
          arm_starts: _,
          arm_ends: _,
          arm_list_starts: _,
          arm_list_counts: _
        } = lists
        match pattern_list_bounds(
          field_starts,
          field_counts,
          pattern_field_list_id_ordinal(id)
        ) {
          (start, count) -> {
            if position >= count { panic("Checked pattern-field position is out of bounds") }
            else {
              let entry = dense_index(start + position)
              let payload = dense_index(field_payloads.at(entry))
              let local = semantic_type_segment_id(checked_expr_segment_module(segment))
              match field_kinds.at(entry) {
                CheckedDeclaredPatternField -> {
                  let {
                    declared_identities,
                    declared_patterns,
                    declared_ordinals,
                    declared_types,
                    structural_keys: _,
                    structural_patterns: _,
                    structural_offsets: _,
                    structural_types: _
                  } = fields
                  CheckedPatternField {
                    kind: CheckedDeclaredPatternField,
                    declaration: declared_identities.at(payload),
                    stable_key: 0,
                    position: CheckedPatternFieldOrdinal(declared_ordinals.at(payload)),
                    value_type: pattern_type_at(declared_types, local, payload),
                    pattern: CheckedPatternId(
                      (segment, dense_index(declared_patterns.at(payload)))
                    )
                  }
                }
                CheckedStructuralPatternField -> {
                  let {
                    declared_identities: _,
                    declared_patterns: _,
                    declared_ordinals: _,
                    declared_types: _,
                    structural_keys,
                    structural_patterns,
                    structural_offsets,
                    structural_types
                  } = fields
                  CheckedPatternField {
                    kind: CheckedStructuralPatternField,
                    declaration: nil,
                    stable_key: structural_keys.at(payload),
                    position: structural_offsets.at(payload),
                    value_type: pattern_type_at(structural_types, local, payload),
                    pattern: CheckedPatternId(
                      (segment, dense_index(structural_patterns.at(payload)))
                    )
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  pub(package) fn match_arm_list_len(
    self: borrow Self,
    id: CheckedMatchArmListId
  ) -> usize {
    pattern_same_segment(self.segment(), checked_match_arm_list_id_segment(id))
    match self {
      CheckedPatternGraph(storage) -> {
        let { segment: _, source: _, types: _, headers: _, payloads: _, lists, fields: _ } = storage
        let {
          pattern_children: _,
          pattern_starts: _,
          pattern_counts: _,
          field_kinds: _,
          field_payloads: _,
          field_starts: _,
          field_counts: _,
          arm_patterns: _,
          arm_guarded: _,
          arm_guards: _,
          arm_bodies: _,
          arm_starts: _,
          arm_ends: _,
          arm_list_starts,
          arm_list_counts
        } = lists
        match pattern_list_bounds(
          arm_list_starts,
          arm_list_counts,
          checked_match_arm_list_id_ordinal(id)
        ) {
          (_, count) -> count
        }
      }
    }
  }

  pub(package) fn match_arm_list_at(
    self: borrow Self,
    id: CheckedMatchArmListId,
    position: usize
  ) -> CheckedMatchArm {
    pattern_same_segment(self.segment(), checked_match_arm_list_id_segment(id))
    match self {
      CheckedPatternGraph(storage) -> {
        let { segment, source: _, types: _, headers: _, payloads: _, lists, fields: _ } = storage
        let {
          pattern_children: _,
          pattern_starts: _,
          pattern_counts: _,
          field_kinds: _,
          field_payloads: _,
          field_starts: _,
          field_counts: _,
          arm_patterns,
          arm_guarded,
          arm_guards,
          arm_bodies,
          arm_starts,
          arm_ends,
          arm_list_starts,
          arm_list_counts
        } = lists
        match pattern_list_bounds(
          arm_list_starts,
          arm_list_counts,
          checked_match_arm_list_id_ordinal(id)
        ) {
          (start, count) -> {
            if position >= count { panic("Checked match-arm position is out of bounds") }
            else {
              let index = dense_index(start + position)
              let guard = if arm_guarded.at(index) {
                CheckedGuarded(checked_expr_id_from_ordinal(segment, arm_guards.at(index)))
              } else { CheckedUnguarded }
              CheckedMatchArm {
                pattern: CheckedPatternId((segment, dense_index(arm_patterns.at(index)))),
                guard: guard,
                body: checked_expr_id_from_ordinal(segment, arm_bodies.at(index)),
                range: CheckedSourceRange {
                  start: arm_starts.at(index),
                  end: arm_ends.at(index)
                }
              }
            }
          }
        }
      }
    }
  }

  pub(package) fn inspect(self: borrow Self, id: CheckedPatternId) -> CheckedPattern {
    let node = match self.kind(id) {
      CheckedWildcardPatternKind -> CheckedWildcardPatternNode
      CheckedBindingPatternKind -> CheckedBindingPatternNode(self.binding(id))
      CheckedIntegerPatternKind -> match self.integer_parts(id) {
        (value, origin) -> CheckedIntegerPatternNode(value, origin)
      }
      CheckedConstructorPatternKind -> match self.constructor_parts(id) {
        (declaration, children, qualifier) -> CheckedConstructorPatternNode(
          declaration,
          children,
          qualifier
        )
      }
      CheckedTypedBindingPatternKind -> match self.typed_binding_parts(id) {
        (binding, annotation) -> CheckedTypedBindingPatternNode(binding, annotation)
      }
      CheckedNilPatternKind -> CheckedNilPatternNode
      CheckedRecordPatternKind -> CheckedRecordPatternNode(self.record_fields(id))
      CheckedTuplePatternKind -> CheckedTuplePatternNode(self.tuple_items(id))
    }
    CheckedPattern { input_type: self.input_type(id), range: self.range(id), node: node }
  }
}

impl Drop for CheckedPatternGraphBuilder {
  fn drop(self) -> nil {
    match self {
      CheckedPatternGraphBuilder(storage) -> {
        let { segment: _, source: _, types: _, headers, payloads, lists, fields } = storage
        headers.drop()
        payloads.drop()
        lists.drop()
        fields.drop()
      }
    }
  }
}
