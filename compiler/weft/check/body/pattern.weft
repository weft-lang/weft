        let {
          pattern_children: _,
          pattern_starts: _,
          pattern_counts: _,
          field_kinds: _,
          field_payloads: _,
          field_starts,
          field_counts,
          arm_patterns: _,
          arm_guarded: _,
          arm_guards: _,
          arm_bodies: _,
          arm_starts: _,
          arm_ends: _,
          arm_list_starts: _,
          arm_list_counts: _
        } = lists
        match pattern_list_bounds(
