  pub(package) fn constructor_parts(
    self: borrow Self,
    id: CheckedPatternId
  ) -> (DeclarationIdentity, CheckedPatternListId, CheckedSourceRange?) {
    let payload = self.payload(id, CheckedConstructorPatternKind)
    match self {
      CheckedPatternGraph(storage) -> {
        let { segment, source: _, types: _, headers: _, payloads, lists: _, fields: _ } = storage
        let {
          bindings: _,
          integers: _,
          integer_origins: _,
          constructors,
          constructor_children,
          constructor_has_qualifier,
          constructor_qualifier_start,
          constructor_qualifier_end,
          typed_bindings: _,
          typed_annotations: _,
          typed_nil_tests: _,
          record_fields: _,
          tuple_items: _
        } = payloads
        let qualifier = if constructor_has_qualifier.at(payload) {
          CheckedSourceRange {
            start: constructor_qualifier_start.at(payload),
            end: constructor_qualifier_end.at(payload)
          }
        } else { nil }
        (
          constructors.at(payload),
          CheckedPatternListId((segment, dense_index(constructor_children.at(payload)))),
          qualifier
        )
      }
    }
  }

  --- Whether the typed arm tests the nil sentinel. An untested typed arm
  --- covers its whole input and binds unconditionally.
  pub(package) fn typed_binding_tests_nil(self: borrow Self, id: CheckedPatternId) -> bool {
    let payload = self.payload(id, CheckedTypedBindingPatternKind)
    match self {
      CheckedPatternGraph(storage) -> {
        let { segment: _, source: _, types: _, headers: _, payloads, lists: _, fields: _ } = storage
        let {
          bindings: _,
          integers: _,
          integer_origins: _,
          constructors: _,
          constructor_children: _,
          constructor_has_qualifier: _,
          constructor_qualifier_start: _,
          constructor_qualifier_end: _,
          typed_bindings: _,
          typed_annotations: _,
          typed_nil_tests,
          record_fields: _,
          tuple_items: _
        } = payloads
        typed_nil_tests.at(payload)
      }
    }
  }

