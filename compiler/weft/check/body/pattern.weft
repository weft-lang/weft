type CheckedPatternGraphBuilderStorage {
  segment: CheckedExprSegmentId,
  source: Source,
  types: SemanticTypeCatalog,
  headers: owned CheckedPatternHeaderBuilder,
  payloads: owned CheckedPatternPayloadBuilder,
  lists: owned CheckedPatternListBuilderStorageBox,
  fields: owned CheckedPatternFieldBuilder
}

pub(package) type CheckedPatternGraphBuilder = opaque CheckedPatternGraphBuilderStorage

type CheckedPatternGraphStorage {
  segment: CheckedExprSegmentId,
  source: Source,
  types: SemanticTypeCatalog,
  headers: CheckedPatternHeaderColumns,
  payloads: CheckedPatternPayloadColumns,
  lists: CheckedPatternListColumns,
  fields: CheckedPatternFieldColumns
}

pub(package) type CheckedPatternGraph = opaque CheckedPatternGraphStorage

fn pattern_type_key(index: DenseIndex) -> i64 {
  match num_scalar_usize_to_i64(dense_index_value(index)) {
    Some(value) -> value
    None -> panic("Checked pattern type index is not representable")
  }
}

fn pattern_type_builder() -> owned CheckedPatternTypeBuilder {
  CheckedPatternTypeBuilder(
    CheckedPatternTypeBuilderStorage {
      ordinals: dense_builder<usize>(),
      imported: dense_builder<bool>(),
      segments: map.new<i64, SemanticTypeSegmentId>()
    }
  )
}

impl CheckedPatternTypeBuilder {
  fn push(
    self: owned Self,
    local: SemanticTypeSegmentId,
    reference: SemanticTypeId
  ) -> (owned CheckedPatternTypeBuilder, DenseIndex) {
    match self {
      CheckedPatternTypeBuilder(storage) -> {
        let { ordinals, imported, segments } = storage
        let mut next_ordinals = ordinals
        let mut next_imported = imported
        let index = next_ordinals.push(semantic_type_id_ordinal(reference))
        let foreign = not semantic_type_segment_id_eq(
          local,
          semantic_type_id_segment(reference)
        )
        if dense_index_value(next_imported.push(foreign)) != dense_index_value(index) {
          panic("Checked pattern type columns diverged")
        } else { nil }
        let next_segments = if foreign {
          segments.insert(pattern_type_key(index), semantic_type_id_segment(reference))
        } else { segments }
        (
          CheckedPatternTypeBuilder(
            CheckedPatternTypeBuilderStorage {
              ordinals: next_ordinals,
              imported: next_imported,
              segments: next_segments
            }
          ),
          index
        )
      }
    }
  }

  fn freeze(self: owned Self) -> CheckedPatternTypeReferences {
    match self {
      CheckedPatternTypeBuilder(storage) -> {
        let { ordinals, imported, segments } = storage
        CheckedPatternTypeReferences {
          ordinals: ordinals.freeze(),
          imported: imported.freeze(),
          segments: segments
        }
      }
    }
  }
}

impl Drop for CheckedPatternTypeBuilder {
  fn drop(self) -> nil {
    match self {
      CheckedPatternTypeBuilder(storage) -> {
        let { ordinals, imported, segments: _ } = storage
        ordinals.drop()
        imported.drop()
      }
    }
  }
}

fn pattern_type_at(
  references: borrow CheckedPatternTypeReferences,
  local: SemanticTypeSegmentId,
  index: DenseIndex
) -> SemanticTypeId {
  let { ordinals, imported, segments } = references
  let segment = if imported.at(index) {
    match segments.get(pattern_type_key(index)) {
      Some(value) -> value
      None -> panic("Checked pattern type is missing its imported segment")
    }
  } else { local }
  semantic_type_id_from_ordinal(segment, ordinals.at(index))
}

fn pattern_header_builder() -> owned CheckedPatternHeaderBuilder {
  CheckedPatternHeaderBuilder(
    CheckedPatternHeaderBuilderStorage {
      kinds: dense_builder<CheckedPatternKind>(),
      payloads: dense_builder<usize>(),
      input_types: pattern_type_builder(),
      starts: dense_builder<usize>(),
      ends: dense_builder<usize>()
    }
  )
}

impl CheckedPatternHeaderBuilder {
  fn len(self: borrow Self) -> usize {
    match self {
      CheckedPatternHeaderBuilder(storage) -> {
        let { kinds, payloads: _, input_types: _, starts: _, ends: _ } = storage
        kinds.len()
      }
    }
  }

  fn freeze(self: owned Self) -> CheckedPatternHeaderColumns {
    match self {
      CheckedPatternHeaderBuilder(storage) -> {
        let { kinds, payloads, input_types, starts, ends } = storage
        CheckedPatternHeaderColumns {
          kinds: kinds.freeze(),
          payloads: payloads.freeze(),
          input_types: input_types.freeze(),
          starts: starts.freeze(),
          ends: ends.freeze()
        }
      }
    }
  }
}

impl Drop for CheckedPatternHeaderBuilder {
  fn drop(self) -> nil {
    match self {
      CheckedPatternHeaderBuilder(storage) -> {
        let { kinds, payloads, input_types, starts, ends } = storage
        kinds.drop()
        payloads.drop()
        input_types.drop()
        starts.drop()
        ends.drop()
      }
    }
  }
}

-- The semantic type segment is module-derived, so reconstructing an expression
-- segment from it would lose the package/module identity. Header publication
-- therefore supplies the checked-expression segment explicitly.
fn pattern_header_push(
  builder: owned CheckedPatternHeaderBuilder,
  segment: CheckedExprSegmentId,
  local: SemanticTypeSegmentId,
  kind: CheckedPatternKind,
  payload: usize,
  input_type: SemanticTypeId,
  range: CheckedSourceRange
) -> (owned CheckedPatternHeaderBuilder, CheckedPatternId) {
  match builder {
    CheckedPatternHeaderBuilder(storage) -> {
      let { kinds, payloads, input_types, starts, ends } = storage
      let mut next_kinds = kinds
      let mut next_payloads = payloads
      let mut next_starts = starts
      let mut next_ends = ends
      let index = next_kinds.push(kind)
      let ordinal = dense_index_value(index)
      match input_types.push(local, input_type) {
        (next_types, type_index) -> if dense_index_value(next_payloads.push(payload)) !=
          ordinal or
          dense_index_value(type_index) != ordinal or
          dense_index_value(next_starts.push(range.start)) != ordinal or
          dense_index_value(next_ends.push(range.end)) != ordinal {
            panic("Checked pattern header columns diverged")
          } else {
            (
              CheckedPatternHeaderBuilder(
                CheckedPatternHeaderBuilderStorage {
                  kinds: next_kinds,
                  payloads: next_payloads,
                  input_types: next_types,
                  starts: next_starts,
                  ends: next_ends
                }
              ),
              CheckedPatternId((segment, index))
            )
          }
      }
    }
  }
}

fn pattern_qualifier_parts(range: CheckedSourceRange?) -> (bool, usize, usize) {
  match range {
    value: CheckedSourceRange -> (true, value.start, value.end)
    nil -> (false, 0, 0)
  }
}

fn pattern_payload_builder() -> owned CheckedPatternPayloadBuilder {
  CheckedPatternPayloadBuilder(
    CheckedPatternPayloadBuilderStorage {
      bindings: dense_builder<usize>(),
      integers: dense_builder<i64>(),
      integer_origins: dense_builder<CheckedIntegerPatternOrigin>(),
      constructors: dense_builder<DeclarationIdentity>(),
      constructor_children: dense_builder<usize>(),
      constructor_has_qualifier: dense_builder<bool>(),
      constructor_qualifier_start: dense_builder<usize>(),
      constructor_qualifier_end: dense_builder<usize>(),
      typed_bindings: dense_builder<usize>(),
      typed_annotations: pattern_type_builder(),
      typed_nil_tests: dense_builder<bool>(),
      record_fields: dense_builder<usize>(),
      tuple_items: dense_builder<usize>()
    }
  )
}

impl CheckedPatternPayloadBuilder {
  fn binding(self: owned Self, binding: usize) -> (owned Self, usize) {
    match self {
      CheckedPatternPayloadBuilder(storage) -> {
        let {
          bindings,
          integers,
          integer_origins,
          constructors,
          constructor_children,
          constructor_has_qualifier,
          constructor_qualifier_start,
          constructor_qualifier_end,
          typed_bindings,
          typed_annotations,
          typed_nil_tests,
          record_fields,
          tuple_items
        } = storage
        let mut values = bindings
        let index = values.push(binding)
        (
          CheckedPatternPayloadBuilder(
            CheckedPatternPayloadBuilderStorage {
              bindings: values,
              integers: integers,
              integer_origins: integer_origins,
              constructors: constructors,
              constructor_children: constructor_children,
              constructor_has_qualifier: constructor_has_qualifier,
              constructor_qualifier_start: constructor_qualifier_start,
              constructor_qualifier_end: constructor_qualifier_end,
              typed_bindings: typed_bindings,
              typed_annotations: typed_annotations,
              typed_nil_tests: typed_nil_tests,
              record_fields: record_fields,
              tuple_items: tuple_items
            }
          ),
          dense_index_value(index)
        )
      }
    }
  }

  fn integer(
    self: owned Self,
    value: i64,
    origin: CheckedIntegerPatternOrigin
  ) -> (owned Self, usize) {
    match self {
      CheckedPatternPayloadBuilder(storage) -> {
        let {
          bindings,
          integers,
          integer_origins,
          constructors,
          constructor_children,
          constructor_has_qualifier,
          constructor_qualifier_start,
          constructor_qualifier_end,
          typed_bindings,
          typed_annotations,
          typed_nil_tests,
          record_fields,
          tuple_items
        } = storage
        let mut values = integers
        let mut origins = integer_origins
        let index = values.push(value)
        if dense_index_value(origins.push(origin)) != dense_index_value(index) {
          panic("Checked integer-pattern columns diverged")
        } else {
          (
            CheckedPatternPayloadBuilder(
              CheckedPatternPayloadBuilderStorage {
                bindings: bindings,
                integers: values,
                integer_origins: origins,
                constructors: constructors,
                constructor_children: constructor_children,
                constructor_has_qualifier: constructor_has_qualifier,
                constructor_qualifier_start: constructor_qualifier_start,
                constructor_qualifier_end: constructor_qualifier_end,
                typed_bindings: typed_bindings,
                typed_annotations: typed_annotations,
                typed_nil_tests: typed_nil_tests,
                record_fields: record_fields,
                tuple_items: tuple_items
              }
            ),
            dense_index_value(index)
          )
        }
      }
    }
  }

  fn constructor(
    self: owned Self,
    declaration: DeclarationIdentity,
    children: usize,
    qualifier: CheckedSourceRange?
  ) -> (owned Self, usize) {
    match self {
      CheckedPatternPayloadBuilder(storage) -> {
        let {
          bindings,
          integers,
          integer_origins,
          constructors,
          constructor_children,
          constructor_has_qualifier,
          constructor_qualifier_start,
          constructor_qualifier_end,
          typed_bindings,
          typed_annotations,
          typed_nil_tests,
          record_fields,
          tuple_items
        } = storage
        let mut declarations = constructors
        let mut child_lists = constructor_children
        let mut has_qualifier = constructor_has_qualifier
        let mut starts = constructor_qualifier_start
        let mut ends = constructor_qualifier_end
        let index = declarations.push(declaration)
        let ordinal = dense_index_value(index)
        let (has, start, end) = pattern_qualifier_parts(qualifier)
        if dense_index_value(child_lists.push(children)) != ordinal or
          dense_index_value(has_qualifier.push(has)) != ordinal or
          dense_index_value(starts.push(start)) != ordinal or
          dense_index_value(ends.push(end)) != ordinal {
            panic("Checked constructor-pattern columns diverged")
          } else {
            (
              CheckedPatternPayloadBuilder(
                CheckedPatternPayloadBuilderStorage {
                  bindings: bindings,
                  integers: integers,
                  integer_origins: integer_origins,
                  constructors: declarations,
                  constructor_children: child_lists,
                  constructor_has_qualifier: has_qualifier,
                  constructor_qualifier_start: starts,
                  constructor_qualifier_end: ends,
                  typed_bindings: typed_bindings,
                  typed_annotations: typed_annotations,
                  typed_nil_tests: typed_nil_tests,
                  record_fields: record_fields,
                  tuple_items: tuple_items
                }
              ),
              ordinal
            )
          }
      }
    }
  }

  fn typed_binding(
    self: owned Self,
    local: SemanticTypeSegmentId,
    binding: usize,
    annotation: SemanticTypeId,
    nil_tested: bool
  ) -> (owned Self, usize) {
    match self {
      CheckedPatternPayloadBuilder(storage) -> {
        let {
          bindings,
          integers,
          integer_origins,
          constructors,
          constructor_children,
          constructor_has_qualifier,
          constructor_qualifier_start,
          constructor_qualifier_end,
          typed_bindings,
          typed_annotations,
          typed_nil_tests,
          record_fields,
          tuple_items
        } = storage
        let mut next_bindings = typed_bindings
        let index = next_bindings.push(binding)
        let mut next_tests = typed_nil_tests
        if dense_index_value(next_tests.push(nil_tested)) != dense_index_value(index) {
          panic("Checked typed-binding columns diverged")
        } else { nil }
        match typed_annotations.push(local, annotation) {
          (next_annotations, annotation_index) -> if dense_index_value(annotation_index) !=
            dense_index_value(index) {
              panic("Checked typed-binding columns diverged")
            } else {
              (
                CheckedPatternPayloadBuilder(
                  CheckedPatternPayloadBuilderStorage {
                    bindings: bindings,
                    integers: integers,
                    integer_origins: integer_origins,
                    constructors: constructors,
                    constructor_children: constructor_children,
                    constructor_has_qualifier: constructor_has_qualifier,
                    constructor_qualifier_start: constructor_qualifier_start,
                    constructor_qualifier_end: constructor_qualifier_end,
                    typed_bindings: next_bindings,
                    typed_annotations: next_annotations,
                    typed_nil_tests: next_tests,
                    record_fields: record_fields,
                    tuple_items: tuple_items
                  }
                ),
                dense_index_value(index)
              )
            }
        }
      }
    }
  }

  fn record(self: owned Self, list: usize) -> (owned Self, usize) {
    match self {
      CheckedPatternPayloadBuilder(storage) -> {
        let {
          bindings,
          integers,
          integer_origins,
          constructors,
          constructor_children,
          constructor_has_qualifier,
          constructor_qualifier_start,
          constructor_qualifier_end,
          typed_bindings,
          typed_annotations,
          typed_nil_tests,
          record_fields,
          tuple_items
        } = storage
        let mut values = record_fields
        let index = values.push(list)
        (
          CheckedPatternPayloadBuilder(
            CheckedPatternPayloadBuilderStorage {
              bindings: bindings,
              integers: integers,
              integer_origins: integer_origins,
              constructors: constructors,
              constructor_children: constructor_children,
              constructor_has_qualifier: constructor_has_qualifier,
              constructor_qualifier_start: constructor_qualifier_start,
              constructor_qualifier_end: constructor_qualifier_end,
              typed_bindings: typed_bindings,
              typed_annotations: typed_annotations,
              typed_nil_tests: typed_nil_tests,
              record_fields: values,
              tuple_items: tuple_items
            }
          ),
          dense_index_value(index)
        )
      }
    }
  }

  fn tuple(self: owned Self, list: usize) -> (owned Self, usize) {
    match self {
      CheckedPatternPayloadBuilder(storage) -> {
        let {
          bindings,
          integers,
          integer_origins,
          constructors,
          constructor_children,
          constructor_has_qualifier,
          constructor_qualifier_start,
          constructor_qualifier_end,
          typed_bindings,
          typed_annotations,
          typed_nil_tests,
          record_fields,
          tuple_items
        } = storage
        let mut values = tuple_items
        let index = values.push(list)
        (
          CheckedPatternPayloadBuilder(
            CheckedPatternPayloadBuilderStorage {
              bindings: bindings,
              integers: integers,
              integer_origins: integer_origins,
              constructors: constructors,
              constructor_children: constructor_children,
              constructor_has_qualifier: constructor_has_qualifier,
              constructor_qualifier_start: constructor_qualifier_start,
              constructor_qualifier_end: constructor_qualifier_end,
              typed_bindings: typed_bindings,
              typed_annotations: typed_annotations,
              typed_nil_tests: typed_nil_tests,
              record_fields: record_fields,
              tuple_items: values
            }
          ),
          dense_index_value(index)
        )
      }
    }
  }

  fn freeze(self: owned Self) -> CheckedPatternPayloadColumns {
    match self {
      CheckedPatternPayloadBuilder(storage) -> {
        let {
          bindings,
          integers,
          integer_origins,
          constructors,
          constructor_children,
          constructor_has_qualifier,
          constructor_qualifier_start,
          constructor_qualifier_end,
          typed_bindings,
          typed_annotations,
