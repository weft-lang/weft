-- Typed storage provenance for checked slice views.
--
-- An origin names the checked binding that owns storage, not an authored
-- spelling or a raw syntax handle. A caller-owned parameter may leave its
-- function; local storage and an opaque origin may not. Unknown aliases every
-- other origin so an unproved call result cannot silently gain exclusivity.

use compiler/project/identity/equality.{function_identity_eq}
use compiler/weft/check/body/graph.{
  CheckedBindingId,
  CheckedExprGraph,
  checked_binding_id_eq,
  checked_binding_id_ordinal,
  checked_binding_id_segment,
  checked_expr_segment_id_eq
}
use stdlib/list.{List, Nil, Cons, from_slice}
use stdlib/option.{Option, None, Some}

pub(package) type CheckedBorrowStorage {
  CheckedCallerStorage(CheckedBindingId),
  CheckedLocalStorage(CheckedBindingId),
  CheckedUnknownStorage
}

pub(package) type CheckedBorrowAccess {
  CheckedSharedAccess,
  CheckedExclusiveAccess
}

pub(package) type CheckedBorrowOrigin {
  storage: CheckedBorrowStorage,
  access: CheckedBorrowAccess
}

pub(package) type CheckedBorrowOrigins = opaque List<CheckedBorrowOrigin>

pub(package) type CheckedBorrowEscape {
  CheckedBorrowEscapes,
  CheckedBorrowLocalCannotEscape,
  CheckedBorrowUnknownCannotEscape
}

-- Classify an owning binding from the checked function graph, not its source
-- spelling. An unregistered or foreign binding has no proved lifetime here.
pub(package) fn checked_borrow_binding_storage(
  graph: borrow CheckedExprGraph,
  binding: CheckedBindingId
) -> CheckedBorrowStorage {
  if not checked_expr_segment_id_eq(graph.segment(), checked_binding_id_segment(binding)) or
    checked_binding_id_ordinal(binding) >= graph.binding_len() {
      CheckedUnknownStorage
    } else {
      let owner = graph.binding(binding).owner
      let mut function_index: usize = 0
      while function_index < graph.function_len() {
        let function = graph.function(function_index)
        if function_identity_eq(function.identity, owner) {
          let mut parameter_index: usize = 0
          while parameter_index < graph.function_parameter_count(function.parameters) {
            if checked_binding_id_eq(
              graph.function_parameter(function.parameters, parameter_index),
              binding
            ) {
              return CheckedCallerStorage(binding)
            } else { nil }
            parameter_index = parameter_index + 1
          }
          return CheckedLocalStorage(binding)
        } else { nil }
        function_index = function_index + 1
      }
      CheckedUnknownStorage
    }
}

fn storage_eq(left: CheckedBorrowStorage, right: CheckedBorrowStorage) -> bool {
  match (left, right) {
    (CheckedCallerStorage(a), CheckedCallerStorage(b)) -> checked_binding_id_eq(a, b)
    (CheckedLocalStorage(a), CheckedLocalStorage(b)) -> checked_binding_id_eq(a, b)
    (CheckedUnknownStorage, CheckedUnknownStorage) -> true
    _ -> false
  }
}

fn access_eq(left: CheckedBorrowAccess, right: CheckedBorrowAccess) -> bool {
  match (left, right) {
    (CheckedSharedAccess, CheckedSharedAccess) -> true
    (CheckedExclusiveAccess, CheckedExclusiveAccess) -> true
    _ -> false
  }
}

fn origin_eq(left: CheckedBorrowOrigin, right: CheckedBorrowOrigin) -> bool {
  storage_eq(left.storage, right.storage) and access_eq(left.access, right.access)
}

fn contains(items: List<CheckedBorrowOrigin>, target: CheckedBorrowOrigin) -> bool {
  match items {
    Nil -> false
    Cons(head, rest) -> origin_eq(head, target) or contains(rest, target)
  }
}

fn merge(
  left: List<CheckedBorrowOrigin>,
  right: List<CheckedBorrowOrigin>
) -> List<CheckedBorrowOrigin> {
  match right {
    Nil -> left
    Cons(head, rest) -> merge(
      if contains(left, head) { left } else { left.append(head) },
      rest
    )
  }
}

pub(package) fn checked_borrow_origins_empty() -> CheckedBorrowOrigins {
  CheckedBorrowOrigins(Nil<CheckedBorrowOrigin>())
}

pub(package) fn checked_borrow_origins_single(
  origin: CheckedBorrowOrigin
) -> CheckedBorrowOrigins {
  let item = [origin]
  CheckedBorrowOrigins(from_slice<CheckedBorrowOrigin>(item[..]))
}

pub(package) fn checked_borrow_origins_union(
  left: CheckedBorrowOrigins,
  right: CheckedBorrowOrigins
) -> CheckedBorrowOrigins {
  match (left, right) {
    (CheckedBorrowOrigins(a), CheckedBorrowOrigins(b)) -> CheckedBorrowOrigins(merge(a, b))
  }
}

pub(package) fn checked_borrow_origins_count(origins: CheckedBorrowOrigins) -> usize {
  match origins { CheckedBorrowOrigins(items) -> items.len() }
}

fn storage_overlaps(left: CheckedBorrowStorage, right: CheckedBorrowStorage) -> bool {
  match (left, right) {
    (CheckedUnknownStorage, _) -> true
    (_, CheckedUnknownStorage) -> true
    (CheckedCallerStorage(a), CheckedCallerStorage(b)) -> checked_binding_id_eq(a, b)
    (CheckedLocalStorage(a), CheckedLocalStorage(b)) -> checked_binding_id_eq(a, b)
    -- A binding cannot be both classes, but treating a misclassified binding
    -- as aliasing is safer than manufacturing disjoint storage.
    (CheckedCallerStorage(a), CheckedLocalStorage(b)) -> checked_binding_id_eq(a, b)
    (CheckedLocalStorage(a), CheckedCallerStorage(b)) -> checked_binding_id_eq(a, b)
  }
}

fn overlaps_one(origin: CheckedBorrowOrigin, others: List<CheckedBorrowOrigin>) -> bool {
  match others {
    Nil -> false
    Cons(head, rest) -> storage_overlaps(origin.storage, head.storage) or
      overlaps_one(origin, rest)
  }
}

fn overlaps_any(left: List<CheckedBorrowOrigin>, right: List<CheckedBorrowOrigin>) -> bool {
  match left {
    Nil -> false
    Cons(head, rest) -> overlaps_one(head, right) or overlaps_any(rest, right)
  }
}

pub(package) fn checked_borrow_origins_overlap(
  left: CheckedBorrowOrigins,
  right: CheckedBorrowOrigins
) -> bool {
  match (left, right) {
    (CheckedBorrowOrigins(a), CheckedBorrowOrigins(b)) -> overlaps_any(a, b)
  }
}

fn escape_status(items: List<CheckedBorrowOrigin>) -> CheckedBorrowEscape {
  match items {
    Nil -> CheckedBorrowEscapes
    Cons(head, rest) -> match head.storage {
      CheckedLocalStorage(_) -> CheckedBorrowLocalCannotEscape
      CheckedCallerStorage(_) -> escape_status(rest)
      CheckedUnknownStorage -> match escape_status(rest) {
        CheckedBorrowLocalCannotEscape -> CheckedBorrowLocalCannotEscape
        _ -> CheckedBorrowUnknownCannotEscape
      }
    }
  }
}

pub(package) fn checked_borrow_origins_escape(
  origins: CheckedBorrowOrigins
) -> CheckedBorrowEscape {
  match origins {
    CheckedBorrowOrigins(Nil) -> CheckedBorrowUnknownCannotEscape
    CheckedBorrowOrigins(items) -> escape_status(items)
  }
}

fn reborrow_items(
  items: List<CheckedBorrowOrigin>,
  access: CheckedBorrowAccess
) -> Option<List<CheckedBorrowOrigin>> {
  match items {
    Nil -> Some<List<CheckedBorrowOrigin>>(Nil<CheckedBorrowOrigin>())
    Cons(head, rest) -> {
      let permitted = match (head.access, access) {
        (CheckedSharedAccess, CheckedExclusiveAccess) -> false
        _ -> true
      }
      if not permitted { None<List<CheckedBorrowOrigin>>() }
      else {
        match reborrow_items(rest, access) {
          None -> None<List<CheckedBorrowOrigin>>()
          Some(tail) -> Some<List<CheckedBorrowOrigin>>(
            tail.prepend(CheckedBorrowOrigin { storage: head.storage, access: access })
          )
        }
      }
    }
  }
}

pub(package) fn checked_borrow_origins_reborrow(
  origins: CheckedBorrowOrigins,
  access: CheckedBorrowAccess
) -> Option<CheckedBorrowOrigins> {
  match origins {
    CheckedBorrowOrigins(Nil) -> None<CheckedBorrowOrigins>()
    CheckedBorrowOrigins(items) -> match reborrow_items(items, access) {
      None -> None<CheckedBorrowOrigins>()
      Some(result) -> Some<CheckedBorrowOrigins>(CheckedBorrowOrigins(result))
    }
  }
}
