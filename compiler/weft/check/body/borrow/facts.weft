-- Immutable slice-view and borrowed-content facts for a checked module.
--
-- Storage identity is an exact checked expression id. Views and aggregates
-- occupy separate planes: owning an array does not make its borrowed elements
-- owned, and containing a view does not make the container its storage owner.

use compiler/weft/check/body/borrow.{
  CheckedBorrowOrigin,
  CheckedBorrowOrigins,
  CheckedCallerStorage,
  CheckedExclusiveAccess,
  CheckedSharedAccess,
  CheckedUnknownStorage,
  checked_borrow_binding_storage,
  checked_borrow_origins_count,
  checked_borrow_origins_single,
  checked_borrow_origins_union
}
use compiler/types/graph.{
  SemanticBorrowNode,
  SemanticMutable,
  SemanticSliceNode,
  SemanticTypeId,
  semantic_type_graph_node
}
use compiler/types/graph/catalog.{SemanticTypeCatalog}
use compiler/types/graph/borrow_shape.{
  SemanticContainsSlice,
  SemanticDoesNotContainSlice,
  SemanticSliceContainment,
  semantic_type_slice_containment
}
use compiler/types/graph/declarations.{SemanticTypeDeclarationCatalog}
use compiler/weft/check/body/graph.{
  CheckedArrayLiteralKind,
  CheckedExprId,
  CheckedExprGraph,
  CheckedExprSegmentId,
  CheckedBlockKind,
  CheckedConstructorCallKind,
  CheckedDirectCallKind,
  CheckedGenericCallKind,
  CheckedIfKind,
  CheckedExprListId,
  CheckedIndexedSliceKind,
  CheckedLetKind,
  CheckedLetMutKind,
  CheckedMethodCallKind,
  CheckedLocalReferenceKind,
  CheckedRecordInitKind,
  checked_binding_id_ordinal,
  checked_expr_id_from_ordinal,
  checked_expr_id_ordinal,
  checked_expr_id_segment,
  checked_expr_segment_id_eq
}
use stdlib/list.{List, Nil}
use stdlib/map as map
use stdlib/map.{Map}
use stdlib/option.{None, Option, Some}
use stdlib/panic.{panic}

type CheckedBorrowFactStorage {
  segment: CheckedExprSegmentId,
  views: Map<i64, CheckedBorrowOrigins>,
  view_ordinals: List<usize>,
  contained: Map<i64, CheckedBorrowOrigins>,
  contained_ordinals: List<usize>
}

pub(package) type CheckedBorrowFacts = opaque CheckedBorrowFactStorage

pub(package) type CheckedViewAccess {
  CheckedNotView,
  CheckedSharedView,
  CheckedExclusiveView
}

pub(package) fn checked_borrow_view_access(
  catalog: borrow SemanticTypeCatalog,
  value_type: SemanticTypeId
) -> CheckedViewAccess {
  match catalog.graph_for(value_type) {
    None -> CheckedNotView
    Some(graph) -> match semantic_type_graph_node(graph, value_type) {
      SemanticSliceNode(_, SemanticMutable) -> CheckedExclusiveView
      SemanticSliceNode(_, _) -> CheckedSharedView
      SemanticBorrowNode(inner, mutability) -> match checked_borrow_view_access(catalog, inner) {
        CheckedNotView -> CheckedNotView
        CheckedExclusiveView -> CheckedExclusiveView
        CheckedSharedView -> match mutability {
          SemanticMutable -> CheckedExclusiveView
          _ -> CheckedSharedView
        }
      }
      _ -> CheckedNotView
    }
  }
}

fn ordinal_key(ordinal: usize) -> i64 {
  __u64_to_i64(__usize_to_u64(ordinal))
}

pub(package) fn checked_borrow_facts_empty(
  segment: CheckedExprSegmentId
) -> CheckedBorrowFacts {
  CheckedBorrowFacts(
    CheckedBorrowFactStorage {
      segment: segment,
      views: map.new<i64, CheckedBorrowOrigins>(),
      view_ordinals: Nil<usize>(),
      contained: map.new<i64, CheckedBorrowOrigins>(),
      contained_ordinals: Nil<usize>()
    }
  )
}

impl CheckedBorrowFacts {
  pub(package) fn segment(self: borrow Self) -> CheckedExprSegmentId {
    match self { CheckedBorrowFacts(storage) -> storage.segment }
  }

  pub(package) fn view_ordinals(self: borrow Self) -> List<usize> {
    match self { CheckedBorrowFacts(storage) -> storage.view_ordinals }
  }

  pub(package) fn contained_ordinals(self: borrow Self) -> List<usize> {
    match self { CheckedBorrowFacts(storage) -> storage.contained_ordinals }
  }

  pub(package) fn view(
    self: borrow Self,
    expression: CheckedExprId
  ) -> Option<CheckedBorrowOrigins> {
    if not checked_expr_segment_id_eq(self.segment(), checked_expr_id_segment(expression)) {
      None<CheckedBorrowOrigins>()
    } else {
      match self {
        CheckedBorrowFacts(storage) -> storage.views.get(
          ordinal_key(checked_expr_id_ordinal(expression))
        )
      }
    }
  }

  pub(package) fn contained(
    self: borrow Self,
    expression: CheckedExprId
  ) -> Option<CheckedBorrowOrigins> {
    if not checked_expr_segment_id_eq(self.segment(), checked_expr_id_segment(expression)) {
      None<CheckedBorrowOrigins>()
    } else {
      match self {
        CheckedBorrowFacts(storage) -> storage.contained.get(
          ordinal_key(checked_expr_id_ordinal(expression))
        )
      }
    }
  }

  pub(package) fn with_view(
    self: Self,
    expression: CheckedExprId,
    origins: CheckedBorrowOrigins
  ) -> Option<CheckedBorrowFacts> {
    if not checked_expr_segment_id_eq(self.segment(), checked_expr_id_segment(expression)) or
      checked_borrow_origins_count(origins) == 0 { None<CheckedBorrowFacts>() }
    else {
      match self {
        CheckedBorrowFacts(storage) -> {
          let { segment, views, view_ordinals, contained, contained_ordinals } = storage
          let ordinal = checked_expr_id_ordinal(expression)
          let key = ordinal_key(ordinal)
          if views.contains_key(key) { None<CheckedBorrowFacts>() }
          else {
            Some<CheckedBorrowFacts>(
              CheckedBorrowFacts(
                CheckedBorrowFactStorage {
                  segment: segment,
                  views: views.insert(key, origins),
                  view_ordinals: view_ordinals.prepend(ordinal),
                  contained: contained,
                  contained_ordinals: contained_ordinals
                }
              )
            )
          }
        }
      }
    }
  }

  pub(package) fn with_contained(
    self: Self,
    expression: CheckedExprId,
    origins: CheckedBorrowOrigins
  ) -> Option<CheckedBorrowFacts> {
    if not checked_expr_segment_id_eq(self.segment(), checked_expr_id_segment(expression)) or
      checked_borrow_origins_count(origins) == 0 { None<CheckedBorrowFacts>() }
    else {
      match self {
        CheckedBorrowFacts(storage) -> {
          let { segment, views, view_ordinals, contained, contained_ordinals } = storage
          let ordinal = checked_expr_id_ordinal(expression)
          let key = ordinal_key(ordinal)
          if contained.contains_key(key) { None<CheckedBorrowFacts>() }
          else {
            Some<CheckedBorrowFacts>(
              CheckedBorrowFacts(
                CheckedBorrowFactStorage {
                  segment: segment,
                  views: views,
                  view_ordinals: view_ordinals,
                  contained: contained.insert(key, origins),
                  contained_ordinals: contained_ordinals.prepend(ordinal)
                }
              )
            )
          }
        }
      }
    }
  }
}

-- Until a checked summary proves a source, a slice-valued expression is an
-- explicit unknown alias. In particular a local binding containing a view is
-- not itself the owner of the view's storage. Indexed slices are deliberately
-- excluded: their owner and reborrow proof must be supplied by the producer.
fn checked_unknown_view_origins(access: CheckedViewAccess) -> CheckedBorrowOrigins {
  checked_borrow_origins_single(
    CheckedBorrowOrigin {
      storage: CheckedUnknownStorage,
      access: match access {
        CheckedExclusiveView -> CheckedExclusiveAccess
        _ -> CheckedSharedAccess
      }
    }
  )
}

fn checked_known_view_origins(
  facts: borrow CheckedBorrowFacts,
  expression: CheckedExprId,
  access: CheckedViewAccess
) -> CheckedBorrowOrigins {
  match facts.view(expression) {
    Some(origins) -> origins
    None -> checked_unknown_view_origins(access)
  }
}

fn checked_merge_content(
  left: Option<CheckedBorrowOrigins>,
  right: Option<CheckedBorrowOrigins>
) -> Option<CheckedBorrowOrigins> {
  match (left, right) {
    (None, None) -> None<CheckedBorrowOrigins>()
    (Some(origins), None) -> Some<CheckedBorrowOrigins>(origins)
    (None, Some(origins)) -> Some<CheckedBorrowOrigins>(origins)
    (Some(a), Some(b)) -> Some<CheckedBorrowOrigins>(checked_borrow_origins_union(a, b))
  }
}

fn checked_child_content(
  facts: borrow CheckedBorrowFacts,
  child: CheckedExprId
) -> Option<CheckedBorrowOrigins> {
  checked_merge_content(facts.view(child), facts.contained(child))
}

fn checked_unknown_content() -> Option<CheckedBorrowOrigins> {
  Some<CheckedBorrowOrigins>(
    checked_borrow_origins_single(
      CheckedBorrowOrigin {
        storage: CheckedUnknownStorage,
        access: CheckedSharedAccess
      }
    )
  )
}

fn checked_record_content(
  expressions: borrow CheckedExprGraph,
  facts: borrow CheckedBorrowFacts,
  expression: CheckedExprId
) -> Option<CheckedBorrowOrigins> {
  let (_, fields) = expressions.record_init_parts(expression)
  let mut found: Option<CheckedBorrowOrigins> = None<CheckedBorrowOrigins>()
  let mut field: usize = 0
  while field < expressions.record_field_list_len(fields) {
    let child = expressions.record_field_list_at(fields, field).value
    found = checked_merge_content(found, checked_child_content(facts, child))
    field = field + 1
  }
  found
}

fn checked_expression_list_content(
  expressions: borrow CheckedExprGraph,
  facts: borrow CheckedBorrowFacts,
  elements: CheckedExprListId
) -> Option<CheckedBorrowOrigins> {
  let mut found: Option<CheckedBorrowOrigins> = None<CheckedBorrowOrigins>()
  let mut index: usize = 0
  while index < expressions.expression_list_len(elements) {
    let child = expressions.expression_list_at(elements, index)
    found = checked_merge_content(found, checked_child_content(facts, child))
    index = index + 1
  }
  found
}

fn checked_array_content(
  expressions: borrow CheckedExprGraph,
  facts: borrow CheckedBorrowFacts,
  expression: CheckedExprId
) -> Option<CheckedBorrowOrigins> {
  let (elements, _) = expressions.array_literal_parts(expression)
  checked_expression_list_content(expressions, facts, elements)
}

fn checked_constructor_content(
  expressions: borrow CheckedExprGraph,
  facts: borrow CheckedBorrowFacts,
  expression: CheckedExprId
) -> Option<CheckedBorrowOrigins> {
  let (_, arguments) = expressions.constructor_call_parts(expression)
  checked_expression_list_content(expressions, facts, arguments)
}

fn checked_direct_call_content(
  expressions: borrow CheckedExprGraph,
  facts: borrow CheckedBorrowFacts,
  expression: CheckedExprId
) -> Option<CheckedBorrowOrigins> {
  let (_, arguments) = expressions.direct_call_parts(expression)
  checked_expression_list_content(expressions, facts, arguments)
}

fn checked_method_call_content(
  expressions: borrow CheckedExprGraph,
  facts: borrow CheckedBorrowFacts,
  expression: CheckedExprId
) -> Option<CheckedBorrowOrigins> {
  let (_, receiver, arguments) = expressions.method_call_parts(expression)
  checked_merge_content(
    checked_child_content(facts, receiver),
    checked_expression_list_content(expressions, facts, arguments)
  )
}

fn checked_contained_origins(
  expressions: borrow CheckedExprGraph,
  facts: borrow CheckedBorrowFacts,
  initializers: borrow Map<i64, usize>,
  expression: CheckedExprId,
  containment: SemanticSliceContainment
) -> Option<CheckedBorrowOrigins> {
  match expressions.kind(expression) {
    CheckedLocalReferenceKind -> {
      let binding = expressions.local_binding(expression)
      let key = ordinal_key(checked_binding_id_ordinal(binding))
      match initializers.get(key) {
        Some(value_ordinal) -> facts.contained(
          checked_expr_id_from_ordinal(expressions.segment(), value_ordinal)
        )
        None -> match containment {
          SemanticContainsSlice -> checked_unknown_content()
          _ -> None<CheckedBorrowOrigins>()
        }
      }
    }
    CheckedBlockKind -> facts.contained(expressions.block_rest(expression))
    CheckedLetKind -> match expressions.let_parts(expression) {
      (_, _, body) -> facts.contained(body)
    }
    CheckedLetMutKind -> match expressions.let_mut_parts(expression) {
      (_, _, body) -> facts.contained(body)
    }
    CheckedIfKind -> checked_merge_content(
      facts.contained(expressions.if_then(expression)),
      facts.contained(expressions.if_else(expression))
    )
    CheckedRecordInitKind -> checked_record_content(expressions, facts, expression)
    CheckedArrayLiteralKind -> checked_array_content(expressions, facts, expression)
    CheckedConstructorCallKind -> checked_constructor_content(expressions, facts, expression)
    _ -> match containment {
      SemanticContainsSlice -> checked_unknown_content()
      _ -> None<CheckedBorrowOrigins>()
    }
  }
}

pub(package) fn checked_borrow_facts_conservative(
  expressions: borrow CheckedExprGraph,
  declarations: borrow SemanticTypeDeclarationCatalog
) -> CheckedBorrowFacts {
  let catalog = expressions.types()
  let mut facts = checked_borrow_facts_empty(expressions.segment())
  let mut initializers = map.new<i64, usize>()
  let mut ordinal: usize = 0
  while ordinal < expressions.len() {
    let expression = checked_expr_id_from_ordinal(expressions.segment(), ordinal)
    match expressions.kind(expression) {
      CheckedLetKind -> match expressions.let_parts(expression) {
        (binding, value, _) -> {
          initializers = initializers.insert(
            ordinal_key(checked_binding_id_ordinal(binding)),
            checked_expr_id_ordinal(value)
          )
        }
      }
      CheckedLetMutKind -> match expressions.let_mut_parts(expression) {
        (binding, value, _) -> {
          initializers = initializers.insert(
            ordinal_key(checked_binding_id_ordinal(binding)),
            checked_expr_id_ordinal(value)
          )
        }
      }
      _ -> nil
    }
    ordinal = ordinal + 1
  }
  ordinal = 0
  while ordinal < expressions.len() {
    let expression = checked_expr_id_from_ordinal(expressions.segment(), ordinal)
    let access = checked_borrow_view_access(catalog, expressions.result_type(expression))
    match access {
      CheckedNotView -> nil
      _ -> if match expressions.kind(expression) {
        CheckedIndexedSliceKind -> true
        _ -> false
      } { nil }
      else {
        let origins = match expressions.kind(expression) {
          CheckedLocalReferenceKind -> {
            let binding = expressions.local_binding(expression)
            let key = ordinal_key(checked_binding_id_ordinal(binding))
            match initializers.get(key) {
              Some(value_ordinal) -> checked_known_view_origins(
                facts,
                checked_expr_id_from_ordinal(expressions.segment(), value_ordinal),
                access
              )
              None -> match checked_borrow_binding_storage(expressions, binding) {
                CheckedCallerStorage(caller) -> checked_borrow_origins_single(
                  CheckedBorrowOrigin {
                    storage: CheckedCallerStorage(caller),
                    access: match access {
                      CheckedExclusiveView -> CheckedExclusiveAccess
                      _ -> CheckedSharedAccess
                    }
                  }
                )
                _ -> checked_unknown_view_origins(access)
              }
            }
          }
          CheckedBlockKind -> checked_known_view_origins(
            facts,
            expressions.block_rest(expression),
            access
          )
          CheckedLetKind -> match expressions.let_parts(expression) {
            (_, _, body) -> checked_known_view_origins(facts, body, access)
          }
          CheckedLetMutKind -> match expressions.let_mut_parts(expression) {
            (_, _, body) -> checked_known_view_origins(facts, body, access)
          }
          CheckedIfKind -> match (
            facts.view(expressions.if_then(expression)),
            facts.view(expressions.if_else(expression))
          ) {
            (Some(then_origins), Some(else_origins)) -> checked_borrow_origins_union(
              then_origins,
              else_origins
            )
            _ -> checked_unknown_view_origins(access)
          }
          CheckedDirectCallKind -> match checked_direct_call_content(
            expressions,
            facts,
            expression
          ) {
            Some(origins) -> origins
            None -> checked_unknown_view_origins(access)
          }
          CheckedMethodCallKind -> match checked_method_call_content(
            expressions,
            facts,
            expression
          ) {
            Some(origins) -> origins
            None -> checked_unknown_view_origins(access)
          }
          CheckedGenericCallKind -> match expressions.generic_call_parts(expression) {
            (call, _) -> checked_known_view_origins(facts, call, access)
          }
          _ -> checked_unknown_view_origins(access)
        }
        facts = match facts.with_view(expression, origins) {
          Some(next) -> next
          None -> panic("Checked view fact derivation failed")
        }
      }
    }
    match semantic_type_slice_containment(
      catalog,
      declarations,
      expressions.result_type(expression)
    ) {
      SemanticDoesNotContainSlice -> nil
      containment -> match access {
        CheckedNotView -> match checked_contained_origins(
          expressions,
          facts,
          initializers,
          expression,
          containment
        ) {
          Some(origins) -> {
            facts = match facts.with_contained(expression, origins) {
              Some(next) -> next
              None -> panic("Checked contained fact derivation failed")
            }
          }
          None -> nil
        }
        _ -> nil
      }
    }
    ordinal = ordinal + 1
  }
  facts
}
