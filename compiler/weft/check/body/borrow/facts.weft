-- Immutable slice-view and borrowed-content facts for a checked module.
--
-- Storage identity is an exact checked expression id. Views and aggregates
-- occupy separate planes: owning an array does not make its borrowed elements
-- owned, and containing a view does not make the container its storage owner.

use compiler/weft/check/body/borrow.{
  CheckedBorrowOrigin,
  CheckedBorrowOrigins,
  CheckedCallerStorage,
  CheckedExclusiveAccess,
  CheckedSharedAccess,
  CheckedUnknownStorage,
  checked_borrow_binding_storage,
  checked_borrow_origins_count,
  checked_borrow_origins_single
}
use compiler/types/graph.{
  SemanticBorrowNode,
  SemanticMutable,
  SemanticSliceNode,
  SemanticTypeId,
  semantic_type_graph_node
}
use compiler/types/graph/catalog.{SemanticTypeCatalog}
use compiler/weft/check/body/graph.{
  CheckedExprId,
  CheckedExprGraph,
  CheckedExprSegmentId,
  CheckedIndexedSliceKind,
  CheckedLocalReferenceKind,
  checked_expr_id_from_ordinal,
  checked_expr_id_ordinal,
  checked_expr_id_segment,
  checked_expr_segment_id_eq
}
use stdlib/list.{List, Nil}
use stdlib/map as map
use stdlib/map.{Map}
use stdlib/option.{None, Option, Some}
use stdlib/panic.{panic}

type CheckedBorrowFactStorage {
  segment: CheckedExprSegmentId,
  views: Map<i64, CheckedBorrowOrigins>,
  view_ordinals: List<usize>,
  contained: Map<i64, CheckedBorrowOrigins>,
  contained_ordinals: List<usize>
}

pub(package) type CheckedBorrowFacts = opaque CheckedBorrowFactStorage

pub(package) type CheckedViewAccess {
  CheckedNotView,
  CheckedSharedView,
  CheckedExclusiveView
}

pub(package) fn checked_borrow_view_access(
  catalog: borrow SemanticTypeCatalog,
  value_type: SemanticTypeId
) -> CheckedViewAccess {
  match catalog.graph_for(value_type) {
    None -> CheckedNotView
    Some(graph) -> match semantic_type_graph_node(graph, value_type) {
      SemanticSliceNode(_, SemanticMutable) -> CheckedExclusiveView
      SemanticSliceNode(_, _) -> CheckedSharedView
      SemanticBorrowNode(inner, mutability) -> match checked_borrow_view_access(catalog, inner) {
        CheckedNotView -> CheckedNotView
        CheckedExclusiveView -> CheckedExclusiveView
        CheckedSharedView -> match mutability {
          SemanticMutable -> CheckedExclusiveView
          _ -> CheckedSharedView
        }
      }
      _ -> CheckedNotView
    }
  }
}

fn ordinal_key(ordinal: usize) -> i64 {
  __u64_to_i64(__usize_to_u64(ordinal))
}

pub(package) fn checked_borrow_facts_empty(
  segment: CheckedExprSegmentId
) -> CheckedBorrowFacts {
  CheckedBorrowFacts(
    CheckedBorrowFactStorage {
      segment: segment,
      views: map.new<i64, CheckedBorrowOrigins>(),
      view_ordinals: Nil<usize>(),
      contained: map.new<i64, CheckedBorrowOrigins>(),
      contained_ordinals: Nil<usize>()
    }
  )
}

impl CheckedBorrowFacts {
  pub(package) fn segment(self: borrow Self) -> CheckedExprSegmentId {
    match self { CheckedBorrowFacts(storage) -> storage.segment }
  }

  pub(package) fn view_ordinals(self: borrow Self) -> List<usize> {
    match self { CheckedBorrowFacts(storage) -> storage.view_ordinals }
  }

  pub(package) fn contained_ordinals(self: borrow Self) -> List<usize> {
    match self { CheckedBorrowFacts(storage) -> storage.contained_ordinals }
  }

  pub(package) fn view(
    self: borrow Self,
    expression: CheckedExprId
  ) -> Option<CheckedBorrowOrigins> {
    if not checked_expr_segment_id_eq(self.segment(), checked_expr_id_segment(expression)) {
      None<CheckedBorrowOrigins>()
    } else {
      match self {
        CheckedBorrowFacts(storage) -> storage.views.get(
          ordinal_key(checked_expr_id_ordinal(expression))
        )
      }
    }
  }

  pub(package) fn contained(
    self: borrow Self,
    expression: CheckedExprId
  ) -> Option<CheckedBorrowOrigins> {
    if not checked_expr_segment_id_eq(self.segment(), checked_expr_id_segment(expression)) {
      None<CheckedBorrowOrigins>()
    } else {
      match self {
        CheckedBorrowFacts(storage) -> storage.contained.get(
          ordinal_key(checked_expr_id_ordinal(expression))
        )
      }
    }
  }

  pub(package) fn with_view(
    self: Self,
    expression: CheckedExprId,
    origins: CheckedBorrowOrigins
  ) -> Option<CheckedBorrowFacts> {
    if not checked_expr_segment_id_eq(self.segment(), checked_expr_id_segment(expression)) or
      checked_borrow_origins_count(origins) == 0 { None<CheckedBorrowFacts>() }
    else {
      match self {
        CheckedBorrowFacts(storage) -> {
          let { segment, views, view_ordinals, contained, contained_ordinals } = storage
          let ordinal = checked_expr_id_ordinal(expression)
          let key = ordinal_key(ordinal)
          if views.contains_key(key) { None<CheckedBorrowFacts>() }
          else {
            Some<CheckedBorrowFacts>(
              CheckedBorrowFacts(
                CheckedBorrowFactStorage {
                  segment: segment,
                  views: views.insert(key, origins),
                  view_ordinals: view_ordinals.prepend(ordinal),
                  contained: contained,
                  contained_ordinals: contained_ordinals
                }
              )
            )
          }
        }
      }
    }
  }

  pub(package) fn with_contained(
    self: Self,
    expression: CheckedExprId,
    origins: CheckedBorrowOrigins
  ) -> Option<CheckedBorrowFacts> {
    if not checked_expr_segment_id_eq(self.segment(), checked_expr_id_segment(expression)) or
      checked_borrow_origins_count(origins) == 0 { None<CheckedBorrowFacts>() }
    else {
      match self {
        CheckedBorrowFacts(storage) -> {
          let { segment, views, view_ordinals, contained, contained_ordinals } = storage
          let ordinal = checked_expr_id_ordinal(expression)
          let key = ordinal_key(ordinal)
          if contained.contains_key(key) { None<CheckedBorrowFacts>() }
          else {
            Some<CheckedBorrowFacts>(
              CheckedBorrowFacts(
                CheckedBorrowFactStorage {
                  segment: segment,
                  views: views,
                  view_ordinals: view_ordinals,
                  contained: contained.insert(key, origins),
                  contained_ordinals: contained_ordinals.prepend(ordinal)
                }
              )
            )
          }
        }
      }
    }
  }
}

-- Until a checked summary proves a source, a slice-valued expression is an
-- explicit unknown alias. In particular a local binding containing a view is
-- not itself the owner of the view's storage. Indexed slices are deliberately
-- excluded: their owner and reborrow proof must be supplied by the producer.
pub(package) fn checked_borrow_facts_conservative(
  expressions: borrow CheckedExprGraph
) -> CheckedBorrowFacts {
  let catalog = expressions.types()
  let mut facts = checked_borrow_facts_empty(expressions.segment())
  let mut ordinal: usize = 0
  while ordinal < expressions.len() {
    let expression = checked_expr_id_from_ordinal(expressions.segment(), ordinal)
    let access = checked_borrow_view_access(catalog, expressions.result_type(expression))
    match access {
      CheckedNotView -> nil
      _ -> if match expressions.kind(expression) {
        CheckedIndexedSliceKind -> true
        _ -> false
      } { nil }
      else {
        let storage = match expressions.kind(expression) {
          CheckedLocalReferenceKind -> match checked_borrow_binding_storage(
            expressions,
            expressions.local_binding(expression)
          ) {
            CheckedCallerStorage(binding) -> CheckedCallerStorage(binding)
            _ -> CheckedUnknownStorage
          }
          _ -> CheckedUnknownStorage
        }
        let origin = CheckedBorrowOrigin {
          storage: storage,
          access: match access {
            CheckedExclusiveView -> CheckedExclusiveAccess
            _ -> CheckedSharedAccess
          }
        }
        facts = match facts.with_view(expression, checked_borrow_origins_single(origin)) {
          Some(next) -> next
          None -> panic("Checked view fact derivation failed")
        }
      }
    }
    ordinal = ordinal + 1
  }
  facts
}
