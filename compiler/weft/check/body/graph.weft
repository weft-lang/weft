  ) -> (owned CheckedExprGraphBuilder, CheckedExprId) {
    self.unary(CheckedLoopKind, body, result, range)
  }

  pub(package) fn break_expr(
    self: owned Self,
    value: CheckedExprId,
    result: SemanticTypeId,
