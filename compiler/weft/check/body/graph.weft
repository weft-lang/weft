  pub(package) fn binding(
    self: owned Self,
    owner: FunctionIdentity,
    value_type: SemanticTypeId,
    range: CheckedSourceRange,
    mutability: CheckedBindingMutability
  ) -> (owned CheckedExprGraphBuilder, CheckedBindingId) {
    match self {
      CheckedExprGraphBuilder(storage) -> {
        let { segment, source, types, headers, values, branches, binding_exprs, owners, extras } = storage
        if not module_identity_eq(
          checked_expr_segment_module(segment),
          function_identity_module(owner)
        ) { panic("Checked binding owner belongs to another module") }
        else { nil }
        checked_result_type(types, value_type)
        match owners.binding(
          segment,
          semantic_type_segment_id(checked_expr_segment_module(segment)),
          owner,
          value_type,
          checked_range(source, range),
          mutability
        ) {
          (next_owners, id) -> (
            checked_expr_builder_value(
              segment,
              source,
              types,
              headers,
              values,
              branches,
              binding_exprs,
              next_owners,
              extras
            ),
            id
          )
        }
      }
    }
  }

