-- Cold inspection materialises a complete semantic variant. Hot consumers use
-- the kind-specific scalar accessors on CheckedExprGraph.
pub(package) type CheckedExprNode {
  CheckedIntegerNode(i64),
  CheckedBooleanNode(bool),
  CheckedNilNode,
  CheckedStringNode(str),
  CheckedFloatNode(f64),
  CheckedLocalReferenceNode(CheckedBindingId),
  CheckedDeclarationReferenceNode(DeclarationIdentity),
  CheckedNotNode(CheckedExprId),
  CheckedNegateNode(CheckedExprId),
  CheckedBinaryNode(CheckedBinaryOperator, CheckedExprId, CheckedExprId),
  CheckedIfNode(CheckedExprId, CheckedExprId, CheckedExprId),
  CheckedBlockNode(CheckedExprId, CheckedExprId),
  CheckedLetNode(CheckedBindingId, CheckedExprId, CheckedExprId),
  CheckedLetMutNode(CheckedBindingId, CheckedExprId, CheckedExprId),
  CheckedAssignNode(CheckedBindingId, CheckedExprId),
  CheckedWhileNode(CheckedExprId, CheckedExprId),
  CheckedLoopNode(CheckedExprId),
  CheckedBreakNode(CheckedExprId),
  CheckedBreakNoValueNode,
  CheckedContinueNode,
  CheckedReturnNode(CheckedExprId),
  CheckedReturnNoValueNode,
  CheckedDeferNode(CheckedExprId, CheckedExprId),
  CheckedDirectCallNode(FunctionIdentity, CheckedExprListId),
  CheckedConstructorCallNode(DeclarationIdentity, CheckedExprListId),
  CheckedApplyNode(CheckedExprId, CheckedExprListId),
  CheckedGenericCallNode(CheckedExprId, CheckedTypeListId),
  CheckedMethodCallNode(DeclarationIdentity, CheckedExprId, CheckedExprListId),
  CheckedAddressOfNode(bool, CheckedExprId),
  CheckedDerefNode(CheckedExprId),
  CheckedPointerAssignNode(CheckedExprId, CheckedExprId),
  CheckedDeclaredFieldAccessNode(CheckedExprId, DeclarationIdentity, usize),
  CheckedStructuralFieldAccessNode(CheckedExprId, i64, usize),
  CheckedIndexedLengthNode(CheckedExprId, SemanticTypeId, isize),
  CheckedIndexedGetNode(CheckedExprId, CheckedExprId, SemanticTypeId, isize),
  CheckedIndexedSetNode(CheckedExprId, CheckedExprId, CheckedExprId, SemanticTypeId),
  CheckedIndexedSliceNode(CheckedExprId, CheckedExprId, CheckedExprId, SemanticTypeId),
  CheckedRecordInitNode(DeclarationIdentity, CheckedRecordFieldListId),
  CheckedRecordUpdateNode(CheckedExprId, CheckedRecordFieldListId),
  CheckedArrayLiteralNode(CheckedExprListId, SemanticTypeId),
  CheckedLambdaNode(CheckedLambdaId),
  CheckedPerformNode(CheckedEffectExprId),
  CheckedHandleNode(CheckedEffectExprId),
  CheckedResumeNode(CheckedExprId),
  CheckedHandlerInstallNode(CheckedEffectExprId),
  CheckedMatchNode(CheckedMatchOrigin, CheckedExprId, CheckedMatchArmListId)
}

