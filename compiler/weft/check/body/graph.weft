  pub(package) fn function(
    self: owned Self,
    identity: FunctionIdentity,
    root: CheckedExprId
  ) -> owned CheckedExprGraphBuilder {
    match self {
      CheckedExprGraphBuilder(storage) -> {
        let { segment, source, types, headers, values, branches, binding_exprs, owners, extras } = storage
        if not module_identity_eq(
          checked_expr_segment_module(segment),
          function_identity_module(identity)
        ) { panic("Checked function belongs to another module") }
        else { nil }
        let root_ordinal = checked_child_ordinal(segment, headers.len(), root)
        let next_owners = owners.function(identity, root_ordinal)
        checked_expr_builder_value(
          segment,
          source,
          types,
          headers,
          values,
          branches,
          binding_exprs,
          next_owners,
          extras
        )
      }
    }
  }

  pub(package) fn freeze(self: owned Self) -> CheckedExprGraph {
    match self {
      CheckedExprGraphBuilder(storage) -> {
        let { segment, source, types, headers, values, branches, binding_exprs, owners, extras } = storage
        CheckedExprGraph(
          CheckedExprGraphStorage {
            segment: segment,
            source: source,
            types: types,
            headers: headers.freeze(),
            values: values.freeze(),
            branches: branches.freeze(),
            binding_exprs: binding_exprs.freeze(),
            owners: owners.freeze(),
            extras: extras.freeze()
          }
        )
      }
    }
  }
}

impl Drop for CheckedExprGraphBuilder {
  fn drop(self) -> nil {
    match self {
      CheckedExprGraphBuilder(storage) -> {
        let { segment: _, source: _, types: _, headers, values, branches, binding_exprs, owners, extras } = storage
        headers.drop()
        values.drop()
        branches.drop()
        binding_exprs.drop()
        owners.drop()
        extras.drop()
      }
    }
  }
}

fn checked_expr_kind_eq(left: CheckedExprKind, right: CheckedExprKind) -> bool {
  match (left, right) {
    (CheckedIntegerKind, CheckedIntegerKind) -> true
    (CheckedBooleanKind, CheckedBooleanKind) -> true
    (CheckedNilKind, CheckedNilKind) -> true
    (CheckedStringKind, CheckedStringKind) -> true
    (CheckedFloatKind, CheckedFloatKind) -> true
    (CheckedLocalReferenceKind, CheckedLocalReferenceKind) -> true
    (CheckedDeclarationReferenceKind, CheckedDeclarationReferenceKind) -> true
    (CheckedNotKind, CheckedNotKind) -> true
    (CheckedNegateKind, CheckedNegateKind) -> true
    (CheckedBinaryKind, CheckedBinaryKind) -> true
    (CheckedIfKind, CheckedIfKind) -> true
    (CheckedBlockKind, CheckedBlockKind) -> true
    (CheckedLetKind, CheckedLetKind) -> true
    (CheckedLetMutKind, CheckedLetMutKind) -> true
    (CheckedAssignKind, CheckedAssignKind) -> true
    (CheckedWhileKind, CheckedWhileKind) -> true
    (CheckedLoopKind, CheckedLoopKind) -> true
    (CheckedBreakKind, CheckedBreakKind) -> true
    (CheckedBreakNoValueKind, CheckedBreakNoValueKind) -> true
    (CheckedContinueKind, CheckedContinueKind) -> true
    (CheckedReturnKind, CheckedReturnKind) -> true
    (CheckedReturnNoValueKind, CheckedReturnNoValueKind) -> true
    (CheckedDeferKind, CheckedDeferKind) -> true
    (CheckedDirectCallKind, CheckedDirectCallKind) -> true
    (CheckedConstructorCallKind, CheckedConstructorCallKind) -> true
    (CheckedApplyKind, CheckedApplyKind) -> true
    (CheckedGenericCallKind, CheckedGenericCallKind) -> true
    (CheckedMethodCallKind, CheckedMethodCallKind) -> true
    (CheckedAddressOfKind, CheckedAddressOfKind) -> true
    (CheckedDerefKind, CheckedDerefKind) -> true
    (CheckedPointerAssignKind, CheckedPointerAssignKind) -> true
    (CheckedDeclaredFieldAccessKind, CheckedDeclaredFieldAccessKind) -> true
    (CheckedStructuralFieldAccessKind, CheckedStructuralFieldAccessKind) -> true
    (CheckedIndexedLengthKind, CheckedIndexedLengthKind) -> true
    (CheckedIndexedGetKind, CheckedIndexedGetKind) -> true
    (CheckedIndexedSetKind, CheckedIndexedSetKind) -> true
    (CheckedIndexedSliceKind, CheckedIndexedSliceKind) -> true
    (CheckedRecordInitKind, CheckedRecordInitKind) -> true
    (CheckedRecordUpdateKind, CheckedRecordUpdateKind) -> true
    (CheckedArrayLiteralKind, CheckedArrayLiteralKind) -> true
    (CheckedLambdaKind, CheckedLambdaKind) -> true
    (CheckedPerformKind, CheckedPerformKind) -> true
    (CheckedHandleKind, CheckedHandleKind) -> true
    (CheckedResumeKind, CheckedResumeKind) -> true
    (CheckedHandlerInstallKind, CheckedHandlerInstallKind) -> true
    (CheckedExplicitMatchKind, CheckedExplicitMatchKind) -> true
    (CheckedLetDestructuringKind, CheckedLetDestructuringKind) -> true
    (CheckedForDestructuringKind, CheckedForDestructuringKind) -> true
    _ -> false
  }
}

pub(package) fn checked_expr_id_from_ordinal(
  segment: CheckedExprSegmentId,
  ordinal: usize
) -> CheckedExprId {
  CheckedExprId((segment, dense_index(ordinal)))
}

pub(package) fn checked_binding_id_from_ordinal(
  segment: CheckedExprSegmentId,
  ordinal: usize
) -> CheckedBindingId {
  CheckedBindingId((segment, dense_index(ordinal)))
}

fn checked_expr_from_ordinal(
  segment: CheckedExprSegmentId,
  ordinal: usize
) -> CheckedExprId {
  checked_expr_id_from_ordinal(segment, ordinal)
}

fn checked_binding_from_ordinal(
  segment: CheckedExprSegmentId,
  ordinal: usize
) -> CheckedBindingId {
  checked_binding_id_from_ordinal(segment, ordinal)
}

fn checked_headers_len(headers: borrow CheckedHeaderColumns) -> usize {
  let { kinds, payloads: _, results: _, starts: _, ends: _ } = headers
  kinds.len()
}

fn checked_headers_kind(
  headers: borrow CheckedHeaderColumns,
  index: DenseIndex
) -> CheckedExprKind {
  let { kinds, payloads: _, results: _, starts: _, ends: _ } = headers
  kinds.at(index)
}

fn checked_headers_result(
  headers: borrow CheckedHeaderColumns,
  type_segment: SemanticTypeSegmentId,
  index: DenseIndex
) -> SemanticTypeId {
  let { kinds: _, payloads: _, results, starts: _, ends: _ } = headers
  checked_type_reference_at(results, type_segment, index)
}

fn checked_headers_range(
  headers: borrow CheckedHeaderColumns,
  index: DenseIndex
) -> CheckedSourceRange {
  let { kinds: _, payloads: _, results: _, starts, ends } = headers
  CheckedSourceRange { start: starts.at(index), end: ends.at(index) }
}

fn checked_headers_payload(
  headers: borrow CheckedHeaderColumns,
  index: DenseIndex
) -> DenseIndex {
  let { kinds: _, payloads, results: _, starts: _, ends: _ } = headers
  dense_index(payloads.at(index))
}

fn checked_values_integer(values: borrow CheckedValueColumns, index: DenseIndex) -> i64 {
  let { integers, booleans: _, binding_references: _, declarations: _, unary_children: _ } = values
  integers.at(index)
}

fn checked_values_boolean(values: borrow CheckedValueColumns, index: DenseIndex) -> bool {
  let { integers: _, booleans, binding_references: _, declarations: _, unary_children: _ } = values
  booleans.at(index)
}

fn checked_values_string(values: borrow CheckedValueColumns, index: DenseIndex) -> str {
  let { integers: _, booleans: _, strings, floats: _, binding_references: _, declarations: _, unary_children: _ } = values
  strings.at(index)
}

fn checked_values_float(values: borrow CheckedValueColumns, index: DenseIndex) -> f64 {
  let { integers: _, booleans: _, strings: _, floats, binding_references: _, declarations: _, unary_children: _ } = values
  floats.at(index)
}

fn checked_values_binding(values: borrow CheckedValueColumns, index: DenseIndex) -> usize {
  let { integers: _, booleans: _, binding_references, declarations: _, unary_children: _ } = values
  binding_references.at(index)
}

fn checked_values_declaration(
  values: borrow CheckedValueColumns,
  index: DenseIndex
) -> DeclarationIdentity {
  let { integers: _, booleans: _, binding_references: _, declarations, unary_children: _ } = values
  declarations.at(index)
}

fn checked_values_unary(values: borrow CheckedValueColumns, index: DenseIndex) -> usize {
  let { integers: _, booleans: _, binding_references: _, declarations: _, unary_children } = values
  unary_children.at(index)
}

fn checked_branches_operator(
  branches: borrow CheckedBranchColumns,
  index: DenseIndex
) -> CheckedBinaryOperator {
  let { operators, left: _, right: _, first: _, second: _, third: _ } = branches
  operators.at(index)
}

fn checked_branches_pair(
  branches: borrow CheckedBranchColumns,
  index: DenseIndex,
  right_side: bool
) -> usize {
  let { operators: _, left, right, first: _, second: _, third: _ } = branches
  if right_side { right.at(index) } else { left.at(index) }
}

fn checked_branches_triple(
  branches: borrow CheckedBranchColumns,
  index: DenseIndex,
  position: usize
) -> usize {
  let { operators: _, left: _, right: _, first, second, third } = branches
  if position == 0 { first.at(index) }
  else { if position == 1 { second.at(index) } else { third.at(index) } }
}

fn checked_binding_expr_binary(
  expressions: borrow CheckedBindingExprColumns,
  index: DenseIndex
) -> (usize, usize, usize) {
  let {
    binary_bindings,
      binary_values,
      binary_bodies,
      unary_bindings: _,
      unary_values: _,
  } = expressions
  (binary_bindings.at(index), binary_values.at(index), binary_bodies.at(index))
}

fn checked_binding_expr_unary(
  expressions: borrow CheckedBindingExprColumns,
  index: DenseIndex
) -> (usize, usize) {
  let {
    binary_bindings: _,
      binary_values: _,
      binary_bodies: _,
      unary_bindings,
      unary_values,
  } = expressions
  (unary_bindings.at(index), unary_values.at(index))
}

fn checked_owners_binding_len(owners: borrow CheckedOwnerColumns) -> usize {
  let { binding_owners, binding_types: _, binding_starts: _, binding_ends: _, binding_mutability: _, function_identities: _, function_roots: _ } = owners
  binding_owners.len()
}

fn checked_owners_function_len(owners: borrow CheckedOwnerColumns) -> usize {
  let { binding_owners: _, binding_types: _, binding_starts: _, binding_ends: _, binding_mutability: _, function_identities, function_roots: _ } = owners
  function_identities.len()
}

fn checked_owners_binding(
  owners: borrow CheckedOwnerColumns,
  type_segment: SemanticTypeSegmentId,
  index: DenseIndex
) -> CheckedBinding {
  let { binding_owners, binding_types, binding_starts, binding_ends, binding_mutability, function_identities: _, function_roots: _ } = owners
  CheckedBinding {
    owner: binding_owners.at(index),
    value_type: checked_type_reference_at(binding_types, type_segment, index),
    range: CheckedSourceRange {
      start: binding_starts.at(index),
      end: binding_ends.at(index)
    },
    mutability: binding_mutability.at(index)
  }
}

fn checked_owners_function(
  owners: borrow CheckedOwnerColumns,
  segment: CheckedExprSegmentId,
  index: usize
) -> CheckedFunctionBody {
  let { binding_owners: _, binding_types: _, binding_starts: _, binding_ends: _, binding_mutability: _, function_identities, function_roots } = owners
  if index >= function_identities.len() { panic("Checked function index is out of bounds") }
  else {
    let dense = dense_index(index)
    CheckedFunctionBody {
      identity: function_identities.at(dense),
      root: checked_expr_from_ordinal(segment, function_roots.at(dense))
    }
  }
}

fn checked_list_bounds(
  starts: borrow DenseSegment<usize>,
  counts: borrow DenseSegment<usize>,
  list: usize,
  position: usize
) -> usize {
  let index = dense_index(list)
  let count = counts.at(index)
  if position >= count { panic("Checked list position is out of bounds") }
  else { starts.at(index) + position }
}

fn checked_lists_expr_len(lists: borrow CheckedListColumns, list: usize) -> usize {
  let { expr_children: _, expr_starts: _, expr_counts, type_values: _, type_starts: _, type_counts: _, field_kinds: _, field_payloads: _, field_starts: _, field_counts: _ } = lists
  expr_counts.at(dense_index(list))
}

fn checked_lists_expr_at(
  lists: borrow CheckedListColumns,
  list: usize,
  position: usize
) -> usize {
  let { expr_children, expr_starts, expr_counts, type_values: _, type_starts: _, type_counts: _, field_kinds: _, field_payloads: _, field_starts: _, field_counts: _ } = lists
  expr_children.at(dense_index(checked_list_bounds(expr_starts, expr_counts, list, position)))
}

fn checked_lists_type_len(lists: borrow CheckedListColumns, list: usize) -> usize {
  let { expr_children: _, expr_starts: _, expr_counts: _, type_values: _, type_starts: _, type_counts, field_kinds: _, field_payloads: _, field_starts: _, field_counts: _ } = lists
  type_counts.at(dense_index(list))
}

fn checked_lists_type_at(
  lists: borrow CheckedListColumns,
  local: SemanticTypeSegmentId,
  list: usize,
  position: usize
) -> SemanticTypeId {
  let { expr_children: _, expr_starts: _, expr_counts: _, type_values, type_starts, type_counts, field_kinds: _, field_payloads: _, field_starts: _, field_counts: _ } = lists
  checked_type_reference_at(
    type_values,
    local,
    dense_index(checked_list_bounds(type_starts, type_counts, list, position))
  )
}

fn checked_lists_field_len(lists: borrow CheckedListColumns, list: usize) -> usize {
  let { expr_children: _, expr_starts: _, expr_counts: _, type_values: _, type_starts: _, type_counts: _, field_kinds: _, field_payloads: _, field_starts: _, field_counts } = lists
  field_counts.at(dense_index(list))
}

fn checked_lists_field_entry(
  lists: borrow CheckedListColumns,
  list: usize,
  position: usize
) -> (CheckedRecordFieldKind, usize) {
  let { expr_children: _, expr_starts: _, expr_counts: _, type_values: _, type_starts: _, type_counts: _, field_kinds, field_payloads, field_starts, field_counts } = lists
  let index = dense_index(checked_list_bounds(field_starts, field_counts, list, position))
  (field_kinds.at(index), field_payloads.at(index))
}

fn checked_fields_declared(
  fields: borrow CheckedFieldColumns,
  local: SemanticTypeSegmentId,
  segment: CheckedExprSegmentId,
  payload: usize
) -> CheckedRecordField {
  let { declared_identities, declared_values, declared_offsets, declared_types, structural_keys: _, structural_values: _, structural_offsets: _, structural_types: _ } = fields
  let index = dense_index(payload)
  CheckedRecordField {
    kind: CheckedDeclaredRecordField,
    declaration: declared_identities.at(index),
    stable_key: 0,
    word_offset: declared_offsets.at(index),
    value_type: checked_type_reference_at(declared_types, local, index),
    value: checked_expr_from_ordinal(segment, declared_values.at(index))
  }
}

fn checked_fields_structural(
  fields: borrow CheckedFieldColumns,
  local: SemanticTypeSegmentId,
  segment: CheckedExprSegmentId,
  payload: usize
) -> CheckedRecordField {
  let { declared_identities: _, declared_values: _, declared_offsets: _, declared_types: _, structural_keys, structural_values, structural_offsets, structural_types } = fields
  let index = dense_index(payload)
  CheckedRecordField {
    kind: CheckedStructuralRecordField,
    declaration: nil,
    stable_key: structural_keys.at(index),
    word_offset: structural_offsets.at(index),
    value_type: checked_type_reference_at(structural_types, local, index),
    value: checked_expr_from_ordinal(segment, structural_values.at(index))
  }
}

fn checked_calls_pair(
  calls: borrow CheckedCallColumns,
  family: CheckedCallPairFamily,
  payload: DenseIndex
) -> (usize, usize) {
  let { direct_functions: _, direct_arguments: _, constructor_declarations: _, constructor_arguments: _, apply_callees, apply_arguments, generic_callees, generic_types, method_declarations: _, method_receivers: _, method_arguments: _ } = calls
  match family {
    CheckedApplyFamily -> (apply_callees.at(payload), apply_arguments.at(payload))
    CheckedGenericFamily -> (generic_callees.at(payload), generic_types.at(payload))
  }
}

fn checked_access_address(
  accesses: borrow CheckedAccessColumns,
  payload: DenseIndex
) -> (bool, usize) {
  let { address_mutable, address_targets, declared_bases: _, declared_fields: _, declared_offsets: _, structural_bases: _, structural_keys: _, structural_offsets: _, index_bases: _, index_first: _, index_second: _, index_types: _, index_lengths: _ } = accesses
  (address_mutable.at(payload), address_targets.at(payload))
}

fn checked_access_indexed(
  accesses: borrow CheckedAccessColumns,
  local: SemanticTypeSegmentId,
  payload: DenseIndex
) -> (usize, usize, usize, SemanticTypeId, isize) {
  let { address_mutable: _, address_targets: _, declared_bases: _, declared_fields: _, declared_offsets: _, structural_bases: _, structural_keys: _, structural_offsets: _, index_bases, index_first, index_second, index_types, index_lengths } = accesses
  (
    index_bases.at(payload),
    index_first.at(payload),
    index_second.at(payload),
    checked_type_reference_at(index_types, local, payload),
    index_lengths.at(payload)
  )
}

impl CheckedExprGraph {
  pub(package) fn segment(self: borrow Self) -> CheckedExprSegmentId {
    match self { CheckedExprGraph(storage) -> storage.segment }
  }

  pub(package) fn source(self: borrow Self) -> Source {
    match self { CheckedExprGraph(storage) -> storage.source }
  }

  pub(package) fn types(self: borrow Self) -> SemanticTypeCatalog {
    match self { CheckedExprGraph(storage) -> storage.types }
  }

  pub(package) fn len(self: borrow Self) -> usize {
    match self {
      CheckedExprGraph(storage) -> {
        let { segment, source: _, types: _, headers, values: _, branches: _, binding_exprs: _, owners: _ } = storage
        checked_headers_len(headers)
      }
    }
  }

  pub(package) fn binding_len(self: borrow Self) -> usize {
    match self {
      CheckedExprGraph(storage) -> {
        let { segment: _, source: _, types: _, headers: _, values: _, branches: _, binding_exprs: _, owners } = storage
        checked_owners_binding_len(owners)
      }
    }
  }

  pub(package) fn function_len(self: borrow Self) -> usize {
    match self {
      CheckedExprGraph(storage) -> {
        let { segment: _, source: _, types: _, headers: _, values: _, branches: _, binding_exprs: _, owners } = storage
        checked_owners_function_len(owners)
      }
    }
  }

  pub(package) fn contains(self: borrow Self, id: CheckedExprId) -> bool {
    checked_expr_segment_id_eq(self.segment(), checked_expr_id_segment(id)) and
      checked_expr_id_ordinal(id) < self.len()
  }

  fn index(self: borrow Self, id: CheckedExprId) -> DenseIndex {
    if self.contains(id) { dense_index(checked_expr_id_ordinal(id)) }
    else { panic("Checked expression id does not belong to this graph") }
  }

  fn binding_index(self: borrow Self, id: CheckedBindingId) -> DenseIndex {
    let ordinal = checked_binding_id_ordinal(id)
    if checked_expr_segment_id_eq(self.segment(), checked_binding_id_segment(id)) and
      ordinal < self.binding_len() { dense_index(ordinal) }
    else { panic("Checked binding id does not belong to this graph") }
  }

  pub(package) fn kind(self: borrow Self, id: CheckedExprId) -> CheckedExprKind {
    let index = self.index(id)
    match self {
      CheckedExprGraph(storage) -> {
        let { segment: _, source: _, types: _, headers, values: _, branches: _, binding_exprs: _, owners: _ } = storage
        checked_headers_kind(headers, index)
      }
    }
  }

  pub(package) fn result_type(self: borrow Self, id: CheckedExprId) -> SemanticTypeId {
    let index = self.index(id)
    match self {
      CheckedExprGraph(storage) -> {
        let { segment, source: _, types: _, headers, values: _, branches: _, binding_exprs: _, owners: _ } = storage
        checked_headers_result(
          headers,
          semantic_type_segment_id(checked_expr_segment_module(segment)),
          index
        )
      }
    }
  }

  pub(package) fn range(self: borrow Self, id: CheckedExprId) -> CheckedSourceRange {
    let index = self.index(id)
    match self {
      CheckedExprGraph(storage) -> {
        let { segment: _, source: _, types: _, headers, values: _, branches: _, binding_exprs: _, owners: _ } = storage
        checked_headers_range(headers, index)
      }
    }
  }

  fn payload(self: borrow Self, id: CheckedExprId, kind: CheckedExprKind) -> DenseIndex {
    if not checked_expr_kind_eq(self.kind(id), kind) {
      panic("Checked expression kind mismatch")
    } else {
      let index = self.index(id)
      match self {
        CheckedExprGraph(storage) -> {
          let { segment: _, source: _, types: _, headers, values: _, branches: _, binding_exprs: _, owners: _ } = storage
          checked_headers_payload(headers, index)
        }
      }
    }
  }

  pub(package) fn integer_value(self: borrow Self, id: CheckedExprId) -> i64 {
    let payload = self.payload(id, CheckedIntegerKind)
    match self {
      CheckedExprGraph(storage) -> {
        let { segment: _, source: _, types: _, headers: _, values, branches: _, binding_exprs: _, owners: _ } = storage
        checked_values_integer(values, payload)
      }
    }
  }

  pub(package) fn boolean_value(self: borrow Self, id: CheckedExprId) -> bool {
    let payload = self.payload(id, CheckedBooleanKind)
    match self {
      CheckedExprGraph(storage) -> {
        let { segment: _, source: _, types: _, headers: _, values, branches: _, binding_exprs: _, owners: _ } = storage
        checked_values_boolean(values, payload)
      }
    }
  }

  pub(package) fn string_value(self: borrow Self, id: CheckedExprId) -> str {
    let payload = self.payload(id, CheckedStringKind)
    match self {
      CheckedExprGraph(storage) -> {
        let { segment: _, source: _, types: _, headers: _, values, branches: _, binding_exprs: _, owners: _, extras: _ } = storage
        checked_values_string(values, payload)
      }
    }
  }

  pub(package) fn float_value(self: borrow Self, id: CheckedExprId) -> f64 {
    let payload = self.payload(id, CheckedFloatKind)
    match self {
      CheckedExprGraph(storage) -> {
        let { segment: _, source: _, types: _, headers: _, values, branches: _, binding_exprs: _, owners: _, extras: _ } = storage
        checked_values_float(values, payload)
      }
    }
  }

  pub(package) fn local_binding(self: borrow Self, id: CheckedExprId) -> CheckedBindingId {
    let payload = self.payload(id, CheckedLocalReferenceKind)
    match self {
      CheckedExprGraph(storage) -> {
        let { segment, source: _, types: _, headers: _, values, branches: _, binding_exprs: _, owners: _ } = storage
        checked_binding_from_ordinal(segment, checked_values_binding(values, payload))
      }
    }
  }

  pub(package) fn declaration(
    self: borrow Self,
    id: CheckedExprId
  ) -> DeclarationIdentity {
    let payload = self.payload(id, CheckedDeclarationReferenceKind)
    match self {
      CheckedExprGraph(storage) -> {
        let { segment: _, source: _, types: _, headers: _, values, branches: _, binding_exprs: _, owners: _ } = storage
        checked_values_declaration(values, payload)
      }
    }
  }

  fn unary_child(
    self: borrow Self,
    id: CheckedExprId,
    kind: CheckedExprKind
  ) -> CheckedExprId {
    let payload = self.payload(id, kind)
    match self {
      CheckedExprGraph(storage) -> {
        let { segment, source: _, types: _, headers: _, values, branches: _, binding_exprs: _, owners: _ } = storage
        checked_expr_from_ordinal(segment, checked_values_unary(values, payload))
      }
    }
  }

  pub(package) fn not_operand(self: borrow Self, id: CheckedExprId) -> CheckedExprId {
    self.unary_child(id, CheckedNotKind)
  }

  pub(package) fn negate_operand(self: borrow Self, id: CheckedExprId) -> CheckedExprId {
    self.unary_child(id, CheckedNegateKind)
  }

  pub(package) fn loop_body(self: borrow Self, id: CheckedExprId) -> CheckedExprId {
    self.unary_child(id, CheckedLoopKind)
  }

  pub(package) fn break_value(self: borrow Self, id: CheckedExprId) -> CheckedExprId {
    self.unary_child(id, CheckedBreakKind)
  }

  pub(package) fn return_value(self: borrow Self, id: CheckedExprId) -> CheckedExprId {
    self.unary_child(id, CheckedReturnKind)
  }

  pub(package) fn binary_operator(
    self: borrow Self,
    id: CheckedExprId
  ) -> CheckedBinaryOperator {
    let payload = self.payload(id, CheckedBinaryKind)
    match self {
      CheckedExprGraph(storage) -> {
        let { segment: _, source: _, types: _, headers: _, values: _, branches, binding_exprs: _, owners: _ } = storage
        checked_branches_operator(branches, payload)
      }
    }
  }

  fn pair_child(
    self: borrow Self,
    id: CheckedExprId,
    kind: CheckedExprKind,
    right: bool
  ) -> CheckedExprId {
    let payload = self.payload(id, kind)
    match self {
      CheckedExprGraph(storage) -> {
        let { segment, source: _, types: _, headers: _, values: _, branches, binding_exprs: _, owners: _ } = storage
        checked_expr_from_ordinal(segment, checked_branches_pair(branches, payload, right))
      }
    }
  }

  pub(package) fn binary_left(self: borrow Self, id: CheckedExprId) -> CheckedExprId {
    self.pair_child(id, CheckedBinaryKind, false)
  }

  pub(package) fn binary_right(self: borrow Self, id: CheckedExprId) -> CheckedExprId {
    self.pair_child(id, CheckedBinaryKind, true)
  }

  pub(package) fn block_first(self: borrow Self, id: CheckedExprId) -> CheckedExprId {
    self.pair_child(id, CheckedBlockKind, false)
  }

  pub(package) fn block_rest(self: borrow Self, id: CheckedExprId) -> CheckedExprId {
    self.pair_child(id, CheckedBlockKind, true)
  }

