  ) -> (owned CheckedExprGraphBuilder, CheckedExprId) {
    self.unary(CheckedBreakKind, value, result, range)
  }

  pub(package) fn return_expr(
    self: owned Self,
    value: CheckedExprId,
    result: SemanticTypeId,
