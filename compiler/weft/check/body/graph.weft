  }

  pub(package) fn if_expr(
    self: owned Self,
    condition: CheckedExprId,
    then_branch: CheckedExprId,
    else_branch: CheckedExprId,
    result: SemanticTypeId,
    range: CheckedSourceRange
  ) -> (owned CheckedExprGraphBuilder, CheckedExprId) {
    match self {
      CheckedExprGraphBuilder(storage) -> {
        let { segment, source, types, headers, values, branches, binding_exprs, owners } = storage
        let condition_ordinal = checked_child_ordinal(segment, headers.len(), condition)
        let then_ordinal = checked_child_ordinal(segment, headers.len(), then_branch)
        let else_ordinal = checked_child_ordinal(segment, headers.len(), else_branch)
        match branches.triple(condition_ordinal, then_ordinal, else_ordinal) {
          (next_branches, payload) -> checked_expr_finish_node(
            segment,
            source,
            types,
            headers,
            values,
            next_branches,
            binding_exprs,
            owners,
            CheckedIfKind,
            payload,
            result,
            range
          )
        }
      }
    }
  }

  fn binding_pair(
    self: owned Self,
    kind: CheckedExprKind,
    binding: CheckedBindingId,
    value: CheckedExprId,
    body: CheckedExprId,
    result: SemanticTypeId,
    range: CheckedSourceRange
  ) -> (owned CheckedExprGraphBuilder, CheckedExprId) {
    match self {
      CheckedExprGraphBuilder(storage) -> {
        let { segment, source, types, headers, values, branches, binding_exprs, owners } = storage
        let binding_ordinal = checked_binding_ordinal(segment, owners.binding_len(), binding)
        let value_ordinal = checked_child_ordinal(segment, headers.len(), value)
        let body_ordinal = checked_child_ordinal(segment, headers.len(), body)
        match binding_exprs.binary(binding_ordinal, value_ordinal, body_ordinal) {
          (next_binding_exprs, payload) -> checked_expr_finish_node(
            segment,
            source,
            types,
            headers,
            values,
            branches,
            next_binding_exprs,
            owners,
            kind,
            payload,
            result,
            range
          )
        }
      }
    }
  }

  pub(package) fn let_expr(
    self: owned Self,
    binding: CheckedBindingId,
    value: CheckedExprId,
    body: CheckedExprId,
    result: SemanticTypeId,
    range: CheckedSourceRange
  ) -> (owned CheckedExprGraphBuilder, CheckedExprId) {
