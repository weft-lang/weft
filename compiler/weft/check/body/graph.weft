        let { segment, source, types, headers, values, branches, binding_exprs, owners, extras } = storage
        match extras.expr_list_finish(segment, list) {
          (next_extras, id) -> (
            checked_expr_builder_value(
              segment,
              source,
              types,
              headers,
              values,
              branches,
              binding_exprs,
              owners,
              next_extras
