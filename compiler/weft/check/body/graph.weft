  pub(package) fn match_parts(
    self: borrow Self,
    id: CheckedExprId
  ) -> (CheckedMatchOrigin, CheckedExprId, CheckedMatchArmListId) {
    let kind = self.kind(id)
    let origin = checked_match_origin(kind)
    let payload = self.payload(id, kind)
    match self {
      CheckedExprGraph(storage) -> {
        let { segment, source: _, types: _, headers: _, values: _, branches, binding_exprs: _, owners: _ } = storage
        (
          origin,
          checked_expr_from_ordinal(
            segment,
            checked_branches_pair(branches, payload, false)
          ),
          checked_match_arm_list_id(
            segment,
            checked_branches_pair(branches, payload, true)
          )
        )
      }
    }
  }

