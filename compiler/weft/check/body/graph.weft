-- Immutable checked-expression storage for one retained Weft module.
--
-- Authored Expr values are never stored here. A builder accepts only complete
-- semantic nodes: every node has an exact result type, retained source range
-- and already-published children. Child and binding edges are scalar ordinals
-- within the module segment; the segment identity is reconstructed only at a
-- typed boundary. This is the storage foundation consumed by typed checking
-- and, after the producer switch, by lowering.

use compiler/project/identity.{
  DeclarationIdentity,
  FunctionIdentity,
  ModuleIdentity,
  function_identity_module
}
use compiler/project/identity/equality.{module_identity_eq}
use compiler/types/graph.{
  SemanticTypeId,
  SemanticTypeSegmentId,
  semantic_type_graph_contains,
  semantic_type_id_from_ordinal,
  semantic_type_id_ordinal,
  semantic_type_id_segment,
  semantic_type_segment_id,
  semantic_type_segment_id_eq
}
use compiler/types/graph/catalog.{SemanticTypeCatalog}
use compiler/weft/check/storage.{
  DenseBuilder,
  DenseIndex,
  DenseSegment,
  dense_builder,
  dense_builder_with_capacity,
  dense_index,
  dense_index_value
}
use stdlib/drop.{Drop}
use stdlib/map as map
use stdlib/map.{Map}
use stdlib/num/scalar.{num_scalar_usize_to_i64}
use stdlib/option.{None, Some}
use stdlib/panic.{panic}
use stdlib/source.{Source}

pub(package) type CheckedExprSegmentId = opaque ModuleIdentity

pub(package) type CheckedExprId = opaque(CheckedExprSegmentId, DenseIndex)

pub(package) type CheckedBindingId = opaque(CheckedExprSegmentId, DenseIndex)

pub(package) type CheckedSourceRange { start: usize, end: usize }

pub(package) type CheckedBindingMutability {
  CheckedImmutableBinding,
  CheckedMutableBinding
}

pub(package) type CheckedBinaryOperator {
  CheckedAdd,
  CheckedSubtract,
  CheckedMultiply,
  CheckedDivide,
  CheckedEqual,
  CheckedNotEqual,
  CheckedLessThan,
  CheckedGreaterThan,
  CheckedLessOrEqual,
  CheckedGreaterOrEqual,
  CheckedModulo,
  CheckedLogicalAnd,
  CheckedLogicalOr,
  CheckedBitAnd,
  CheckedBitOr,
  CheckedBitXor,
  CheckedShiftLeft,
  CheckedShiftRight
}

pub(package) type CheckedExprKind {
  CheckedIntegerKind,
  CheckedBooleanKind,
  CheckedNilKind,
  CheckedLocalReferenceKind,
  CheckedDeclarationReferenceKind,
  CheckedNotKind,
  CheckedNegateKind,
  CheckedBinaryKind,
  CheckedIfKind,
  CheckedBlockKind,
  CheckedLetKind,
  CheckedLetMutKind,
  CheckedAssignKind,
  CheckedWhileKind,
  CheckedLoopKind,
  CheckedBreakKind,
  CheckedBreakNoValueKind,
  CheckedContinueKind,
  CheckedReturnKind,
  CheckedReturnNoValueKind,
  CheckedDeferKind
}

-- Cold inspection materialises a complete semantic variant. Hot consumers use
-- the kind-specific scalar accessors on CheckedExprGraph.
pub(package) type CheckedExprNode {
  CheckedIntegerNode(i64),
  CheckedBooleanNode(bool),
  CheckedNilNode,
  CheckedLocalReferenceNode(CheckedBindingId),
  CheckedDeclarationReferenceNode(DeclarationIdentity),
  CheckedNotNode(CheckedExprId),
  CheckedNegateNode(CheckedExprId),
  CheckedBinaryNode(CheckedBinaryOperator, CheckedExprId, CheckedExprId),
  CheckedIfNode(CheckedExprId, CheckedExprId, CheckedExprId),
  CheckedBlockNode(CheckedExprId, CheckedExprId),
  CheckedLetNode(CheckedBindingId, CheckedExprId, CheckedExprId),
  CheckedLetMutNode(CheckedBindingId, CheckedExprId, CheckedExprId),
  CheckedAssignNode(CheckedBindingId, CheckedExprId),
  CheckedWhileNode(CheckedExprId, CheckedExprId),
  CheckedLoopNode(CheckedExprId),
  CheckedBreakNode(CheckedExprId),
  CheckedBreakNoValueNode,
  CheckedContinueNode,
  CheckedReturnNode(CheckedExprId),
  CheckedReturnNoValueNode,
  CheckedDeferNode(CheckedExprId, CheckedExprId)
}

pub(package) type CheckedExpr {
  result: SemanticTypeId,
  range: CheckedSourceRange,
  node: CheckedExprNode
}

pub(package) type CheckedBinding {
  owner: FunctionIdentity,
  value_type: SemanticTypeId,
  range: CheckedSourceRange,
  mutability: CheckedBindingMutability
}

pub(package) type CheckedFunctionBody {
  identity: FunctionIdentity,
  root: CheckedExprId
}

type CheckedTypeReferenceBuilderStorage {
  ordinals: owned DenseBuilder<usize>,
  imported: owned DenseBuilder<bool>,
  segments: Map<i64, SemanticTypeSegmentId>
}

type CheckedTypeReferenceBuilder = opaque CheckedTypeReferenceBuilderStorage

type CheckedTypeReferences {
  ordinals: DenseSegment<usize>,
  imported: DenseSegment<bool>,
  segments: Map<i64, SemanticTypeSegmentId>
}

type CheckedHeaderBuilderStorage {
  kinds: owned DenseBuilder<CheckedExprKind>,
  payloads: owned DenseBuilder<usize>,
  results: owned CheckedTypeReferenceBuilder,
  starts: owned DenseBuilder<usize>,
  ends: owned DenseBuilder<usize>
}

type CheckedHeaderBuilder = opaque CheckedHeaderBuilderStorage

type CheckedHeaderColumns {
  kinds: DenseSegment<CheckedExprKind>,
  payloads: DenseSegment<usize>,
  results: CheckedTypeReferences,
  starts: DenseSegment<usize>,
  ends: DenseSegment<usize>
}

type CheckedValueBuilderStorage {
  integers: owned DenseBuilder<i64>,
  booleans: owned DenseBuilder<bool>,
  binding_references: owned DenseBuilder<usize>,
  declarations: owned DenseBuilder<DeclarationIdentity>,
  unary_children: owned DenseBuilder<usize>
}

type CheckedValueBuilder = opaque CheckedValueBuilderStorage

type CheckedValueColumns {
  integers: DenseSegment<i64>,
  booleans: DenseSegment<bool>,
  binding_references: DenseSegment<usize>,
  declarations: DenseSegment<DeclarationIdentity>,
  unary_children: DenseSegment<usize>
}

type CheckedBranchBuilderStorage {
  operators: owned DenseBuilder<CheckedBinaryOperator>,
  left: owned DenseBuilder<usize>,
  right: owned DenseBuilder<usize>,
  first: owned DenseBuilder<usize>,
  second: owned DenseBuilder<usize>,
  third: owned DenseBuilder<usize>
}

type CheckedBranchBuilder = opaque CheckedBranchBuilderStorage

type CheckedBranchColumns {
  operators: DenseSegment<CheckedBinaryOperator>,
  left: DenseSegment<usize>,
  right: DenseSegment<usize>,
  first: DenseSegment<usize>,
  second: DenseSegment<usize>,
  third: DenseSegment<usize>
}

type CheckedBindingExprBuilderStorage {
  binary_bindings: owned DenseBuilder<usize>,
  binary_values: owned DenseBuilder<usize>,
  binary_bodies: owned DenseBuilder<usize>,
  unary_bindings: owned DenseBuilder<usize>,
  unary_values: owned DenseBuilder<usize>
}

type CheckedBindingExprBuilder = opaque CheckedBindingExprBuilderStorage

type CheckedBindingExprColumns {
  binary_bindings: DenseSegment<usize>,
  binary_values: DenseSegment<usize>,
  binary_bodies: DenseSegment<usize>,
  unary_bindings: DenseSegment<usize>,
  unary_values: DenseSegment<usize>
}

type CheckedOwnerBuilderStorage {
  binding_owners: owned DenseBuilder<FunctionIdentity>,
  binding_types: owned CheckedTypeReferenceBuilder,
  binding_starts: owned DenseBuilder<usize>,
  binding_ends: owned DenseBuilder<usize>,
  binding_mutability: owned DenseBuilder<CheckedBindingMutability>,
  function_identities: owned DenseBuilder<FunctionIdentity>,
  function_roots: owned DenseBuilder<usize>
}

type CheckedOwnerBuilder = opaque CheckedOwnerBuilderStorage

type CheckedOwnerColumns {
  binding_owners: DenseSegment<FunctionIdentity>,
  binding_types: CheckedTypeReferences,
  binding_starts: DenseSegment<usize>,
  binding_ends: DenseSegment<usize>,
  binding_mutability: DenseSegment<CheckedBindingMutability>,
  function_identities: DenseSegment<FunctionIdentity>,
  function_roots: DenseSegment<usize>
}

type CheckedExprGraphBuilderStorage {
  segment: CheckedExprSegmentId,
  source: Source,
  types: SemanticTypeCatalog,
  headers: owned CheckedHeaderBuilder,
  values: owned CheckedValueBuilder,
  branches: owned CheckedBranchBuilder,
  binding_exprs: owned CheckedBindingExprBuilder,
  owners: owned CheckedOwnerBuilder
}

pub(package) type CheckedExprGraphBuilder = opaque CheckedExprGraphBuilderStorage

type CheckedExprGraphStorage {
  segment: CheckedExprSegmentId,
  source: Source,
  types: SemanticTypeCatalog,
  headers: CheckedHeaderColumns,
  values: CheckedValueColumns,
  branches: CheckedBranchColumns,
  binding_exprs: CheckedBindingExprColumns,
  owners: CheckedOwnerColumns
}

pub(package) type CheckedExprGraph = opaque CheckedExprGraphStorage

pub(package) fn checked_expr_segment_id(module: ModuleIdentity) -> CheckedExprSegmentId {
  CheckedExprSegmentId(module)
}

pub(package) fn checked_expr_segment_module(segment: CheckedExprSegmentId) -> ModuleIdentity {
  match segment { CheckedExprSegmentId(module) -> module }
}

pub(package) fn checked_expr_segment_id_eq(
  left: CheckedExprSegmentId,
  right: CheckedExprSegmentId
) -> bool {
  module_identity_eq(checked_expr_segment_module(left), checked_expr_segment_module(right))
}

pub(package) fn checked_expr_id_segment(id: CheckedExprId) -> CheckedExprSegmentId {
  match id { CheckedExprId((segment, _)) -> segment }
}

pub(package) fn checked_expr_id_ordinal(id: CheckedExprId) -> usize {
  match id { CheckedExprId((_, index)) -> dense_index_value(index) }
}

pub(package) fn checked_expr_id_eq(left: CheckedExprId, right: CheckedExprId) -> bool {
  checked_expr_segment_id_eq(checked_expr_id_segment(left), checked_expr_id_segment(right)) and
    checked_expr_id_ordinal(left) == checked_expr_id_ordinal(right)
}

pub(package) fn checked_binding_id_segment(id: CheckedBindingId) -> CheckedExprSegmentId {
  match id { CheckedBindingId((segment, _)) -> segment }
}

pub(package) fn checked_binding_id_ordinal(id: CheckedBindingId) -> usize {
  match id { CheckedBindingId((_, index)) -> dense_index_value(index) }
}

pub(package) fn checked_binding_id_eq(
  left: CheckedBindingId,
  right: CheckedBindingId
) -> bool {
  checked_expr_segment_id_eq(
    checked_binding_id_segment(left),
    checked_binding_id_segment(right)
  ) and checked_binding_id_ordinal(left) == checked_binding_id_ordinal(right)
}

fn checked_range(source: Source, range: CheckedSourceRange) -> CheckedSourceRange {
  if range.start > range.end or range.end > source.text.len() {
    panic("Checked expression range is outside its retained source")
  } else { range }
}

fn checked_result_type(types: borrow SemanticTypeCatalog, result: SemanticTypeId) -> nil {
  match types.graph_for(result) {
    Some(graph) -> if semantic_type_graph_contains(graph, result) { nil }
    else { panic("Checked expression result type is outside its semantic graph") }
    None -> panic("Checked expression result type is outside its semantic catalog")
  }
}

fn checked_child_ordinal(
  segment: CheckedExprSegmentId,
  length: usize,
  child: CheckedExprId
) -> usize {
  let ordinal = checked_expr_id_ordinal(child)
  if not checked_expr_segment_id_eq(segment, checked_expr_id_segment(child)) {
    panic("Checked expression child belongs to another module segment")
  } else {
    if ordinal >= length { panic("Checked expression child must precede its parent") }
    else { ordinal }
  }
}

fn checked_binding_ordinal(
  segment: CheckedExprSegmentId,
  length: usize,
  binding: CheckedBindingId
) -> usize {
  let ordinal = checked_binding_id_ordinal(binding)
  if not checked_expr_segment_id_eq(segment, checked_binding_id_segment(binding)) {
    panic("Checked binding belongs to another module segment")
  } else {
    if ordinal >= length { panic("Checked binding is not published") }
    else { ordinal }
  }
}

fn checked_type_reference_key(index: DenseIndex) -> i64 {
  match num_scalar_usize_to_i64(dense_index_value(index)) {
    Some(value) -> value
    None -> panic("Checked type reference index is not representable")
  }
}

fn checked_type_reference_builder() -> owned CheckedTypeReferenceBuilder {
  CheckedTypeReferenceBuilder(
    CheckedTypeReferenceBuilderStorage {
      ordinals: dense_builder<usize>(),
      imported: dense_builder<bool>(),
      segments: map.new<i64, SemanticTypeSegmentId>()
    }
  )
}

impl CheckedTypeReferenceBuilder {
  fn push(
    self: owned Self,
    local: SemanticTypeSegmentId,
    reference: SemanticTypeId
  ) -> (owned CheckedTypeReferenceBuilder, DenseIndex) {
    match self {
      CheckedTypeReferenceBuilder(storage) -> {
        let { ordinals, imported, segments } = storage
        let mut ordinal_values = ordinals
        let mut imported_values = imported
        let index = ordinal_values.push(semantic_type_id_ordinal(reference))
        let foreign = not semantic_type_segment_id_eq(
          local,
          semantic_type_id_segment(reference)
        )
        let imported_index = imported_values.push(foreign)
        if dense_index_value(index) != dense_index_value(imported_index) {
          panic("Checked type reference columns diverged")
        } else { nil }
        let next_segments = if foreign {
          segments.insert(
            checked_type_reference_key(index),
            semantic_type_id_segment(reference)
          )
        } else { segments }
        (
          CheckedTypeReferenceBuilder(
            CheckedTypeReferenceBuilderStorage {
              ordinals: ordinal_values,
              imported: imported_values,
              segments: next_segments
            }
          ),
          index
        )
      }
    }
  }

  fn freeze(self: owned Self) -> CheckedTypeReferences {
    match self {
      CheckedTypeReferenceBuilder(storage) -> {
        let { ordinals, imported, segments } = storage
        CheckedTypeReferences {
          ordinals: ordinals.freeze(),
          imported: imported.freeze(),
          segments: segments
        }
      }
    }
  }
}

impl Drop for CheckedTypeReferenceBuilder {
  fn drop(self) -> nil {
    match self {
      CheckedTypeReferenceBuilder(storage) -> {
        let { ordinals, imported, segments: _ } = storage
        ordinals.drop()
        imported.drop()
      }
    }
  }
}

fn checked_type_reference_at(
  references: borrow CheckedTypeReferences,
  local: SemanticTypeSegmentId,
  index: DenseIndex
) -> SemanticTypeId {
  let { ordinals, imported, segments } = references
  let segment = if imported.at(index) {
    match segments.get(checked_type_reference_key(index)) {
      Some(value) -> value
      None -> panic("Checked type reference is missing its imported segment")
    }
  } else { local }
  semantic_type_id_from_ordinal(segment, ordinals.at(index))
}

fn checked_header_builder(expected: usize) -> owned CheckedHeaderBuilder {
  CheckedHeaderBuilder(
    CheckedHeaderBuilderStorage {
      kinds: dense_builder_with_capacity<CheckedExprKind>(expected),
      payloads: dense_builder_with_capacity<usize>(expected),
      results: checked_type_reference_builder(),
      starts: dense_builder_with_capacity<usize>(expected),
      ends: dense_builder_with_capacity<usize>(expected)
    }
  )
}

impl CheckedHeaderBuilder {
  fn len(self: borrow Self) -> usize {
    match self {
      CheckedHeaderBuilder(storage) -> {
        let { kinds, payloads: _, results: _, starts: _, ends: _ } = storage
        kinds.len()
      }
    }
  }

  fn push(
    self: owned Self,
    segment: CheckedExprSegmentId,
    type_segment: SemanticTypeSegmentId,
    kind: CheckedExprKind,
    payload: usize,
    result: SemanticTypeId,
    range: CheckedSourceRange
  ) -> (owned CheckedHeaderBuilder, CheckedExprId) {
    match self {
      CheckedHeaderBuilder(storage) -> {
        let { kinds, payloads, results, starts, ends } = storage
        let mut kind_values = kinds
        let mut payload_values = payloads
        let mut start_values = starts
        let mut end_values = ends
        let index = kind_values.push(kind)
        let ordinal = dense_index_value(index)
        let payload_index = payload_values.push(payload)
        let start_index = start_values.push(range.start)
        let end_index = end_values.push(range.end)
        match results.push(type_segment, result) {
          (result_values, result_index) -> if dense_index_value(payload_index) != ordinal or
            dense_index_value(result_index) != ordinal or
            dense_index_value(start_index) != ordinal or
            dense_index_value(end_index) != ordinal {
              panic("Checked expression columns diverged")
            } else {
              (
                CheckedHeaderBuilder(
                  CheckedHeaderBuilderStorage {
                    kinds: kind_values,
                    payloads: payload_values,
                    results: result_values,
                    starts: start_values,
                    ends: end_values
                  }
                ),
                CheckedExprId((segment, index))
              )
            }
        }
      }
    }
  }

  fn freeze(self: owned Self) -> CheckedHeaderColumns {
    match self {
      CheckedHeaderBuilder(storage) -> {
        let { kinds, payloads, results, starts, ends } = storage
        CheckedHeaderColumns {
          kinds: kinds.freeze(),
          payloads: payloads.freeze(),
          results: results.freeze(),
          starts: starts.freeze(),
          ends: ends.freeze()
        }
      }
    }
  }
}

impl Drop for CheckedHeaderBuilder {
  fn drop(self) -> nil {
    match self {
      CheckedHeaderBuilder(storage) -> {
        let { kinds, payloads, results, starts, ends } = storage
        kinds.drop()
        payloads.drop()
        results.drop()
        starts.drop()
        ends.drop()
      }
    }
  }
}

fn checked_value_builder() -> owned CheckedValueBuilder {
  CheckedValueBuilder(
    CheckedValueBuilderStorage {
      integers: dense_builder<i64>(),
      booleans: dense_builder<bool>(),
      binding_references: dense_builder<usize>(),
      declarations: dense_builder<DeclarationIdentity>(),
      unary_children: dense_builder<usize>()
    }
  )
}

impl CheckedValueBuilder {
  fn integer(self: owned Self, value: i64) -> (owned CheckedValueBuilder, usize) {
    match self {
      CheckedValueBuilder(storage) -> {
        let { integers, booleans, binding_references, declarations, unary_children } = storage
        let mut next = integers
        let index = dense_index_value(next.push(value))
        (
          CheckedValueBuilder(
            CheckedValueBuilderStorage {
              integers: next,
              booleans: booleans,
              binding_references: binding_references,
              declarations: declarations,
              unary_children: unary_children
            }
          ),
          index
        )
      }
    }
  }

  fn boolean(self: owned Self, value: bool) -> (owned CheckedValueBuilder, usize) {
    match self {
      CheckedValueBuilder(storage) -> {
        let { integers, booleans, binding_references, declarations, unary_children } = storage
        let mut next = booleans
        let index = dense_index_value(next.push(value))
        (
          CheckedValueBuilder(
            CheckedValueBuilderStorage {
              integers: integers,
              booleans: next,
              binding_references: binding_references,
              declarations: declarations,
              unary_children: unary_children
            }
          ),
          index
        )
      }
    }
  }

  fn binding_reference(
    self: owned Self,
    ordinal: usize
  ) -> (owned CheckedValueBuilder, usize) {
    match self {
      CheckedValueBuilder(storage) -> {
        let { integers, booleans, binding_references, declarations, unary_children } = storage
        let mut next = binding_references
        let index = dense_index_value(next.push(ordinal))
        (
          CheckedValueBuilder(
            CheckedValueBuilderStorage {
              integers: integers,
              booleans: booleans,
              binding_references: next,
              declarations: declarations,
              unary_children: unary_children
            }
          ),
          index
        )
      }
    }
  }

  fn declaration(
    self: owned Self,
    identity: DeclarationIdentity
  ) -> (owned CheckedValueBuilder, usize) {
    match self {
      CheckedValueBuilder(storage) -> {
        let { integers, booleans, binding_references, declarations, unary_children } = storage
        let mut next = declarations
        let index = dense_index_value(next.push(identity))
        (
          CheckedValueBuilder(
            CheckedValueBuilderStorage {
              integers: integers,
              booleans: booleans,
              binding_references: binding_references,
              declarations: next,
              unary_children: unary_children
            }
          ),
          index
        )
      }
    }
  }

  fn unary(self: owned Self, ordinal: usize) -> (owned CheckedValueBuilder, usize) {
    match self {
      CheckedValueBuilder(storage) -> {
        let { integers, booleans, binding_references, declarations, unary_children } = storage
        let mut next = unary_children
        let index = dense_index_value(next.push(ordinal))
        (
          CheckedValueBuilder(
            CheckedValueBuilderStorage {
              integers: integers,
              booleans: booleans,
              binding_references: binding_references,
              declarations: declarations,
              unary_children: next
            }
          ),
          index
        )
      }
    }
  }

  fn freeze(self: owned Self) -> CheckedValueColumns {
    match self {
      CheckedValueBuilder(storage) -> {
        let { integers, booleans, binding_references, declarations, unary_children } = storage
        CheckedValueColumns {
          integers: integers.freeze(),
          booleans: booleans.freeze(),
          binding_references: binding_references.freeze(),
          declarations: declarations.freeze(),
          unary_children: unary_children.freeze()
        }
      }
    }
  }
}

impl Drop for CheckedValueBuilder {
  fn drop(self) -> nil {
    match self {
      CheckedValueBuilder(storage) -> {
        let { integers, booleans, binding_references, declarations, unary_children } = storage
        integers.drop()
        booleans.drop()
        binding_references.drop()
        declarations.drop()
        unary_children.drop()
      }
    }
  }
}

fn checked_branch_builder() -> owned CheckedBranchBuilder {
  CheckedBranchBuilder(
    CheckedBranchBuilderStorage {
      operators: dense_builder<CheckedBinaryOperator>(),
      left: dense_builder<usize>(),
      right: dense_builder<usize>(),
      first: dense_builder<usize>(),
      second: dense_builder<usize>(),
      third: dense_builder<usize>()
    }
  )
}

impl CheckedBranchBuilder {
  fn binary(
    self: owned Self,
    operator: CheckedBinaryOperator,
    left_ordinal: usize,
    right_ordinal: usize
  ) -> (owned CheckedBranchBuilder, usize) {
    match self {
      CheckedBranchBuilder(storage) -> {
        let { operators, left, right, first, second, third } = storage
        let mut operator_values = operators
        let mut left_values = left
        let mut right_values = right
        let index = operator_values.push(operator)
        let ordinal = dense_index_value(index)
        if dense_index_value(left_values.push(left_ordinal)) != ordinal or
          dense_index_value(right_values.push(right_ordinal)) != ordinal {
            panic("Checked binary expression columns diverged")
          } else {
            (
              CheckedBranchBuilder(
                CheckedBranchBuilderStorage {
                  operators: operator_values,
                  left: left_values,
                  right: right_values,
                  first: first,
                  second: second,
                  third: third
                }
              ),
              ordinal
            )
          }
      }
    }
  }

  fn pair(
    self: owned Self,
    left_ordinal: usize,
    right_ordinal: usize
  ) -> (owned CheckedBranchBuilder, usize) {
    match self {
      CheckedBranchBuilder(storage) -> {
        let { operators, left, right, first, second, third } = storage
        let mut left_values = left
        let mut right_values = right
        let index = left_values.push(left_ordinal)
        let ordinal = dense_index_value(index)
        if dense_index_value(right_values.push(right_ordinal)) != ordinal {
          panic("Checked binary child columns diverged")
        } else {
          (
            CheckedBranchBuilder(
              CheckedBranchBuilderStorage {
                operators: operators,
                left: left_values,
                right: right_values,
                first: first,
                second: second,
                third: third
              }
            ),
            ordinal
          )
        }
      }
    }
  }

  fn triple(
    self: owned Self,
    first_ordinal: usize,
    second_ordinal: usize,
    third_ordinal: usize
  ) -> (owned CheckedBranchBuilder, usize) {
    match self {
      CheckedBranchBuilder(storage) -> {
        let { operators, left, right, first, second, third } = storage
        let mut first_values = first
        let mut second_values = second
        let mut third_values = third
        let index = first_values.push(first_ordinal)
        let ordinal = dense_index_value(index)
        if dense_index_value(second_values.push(second_ordinal)) != ordinal or
          dense_index_value(third_values.push(third_ordinal)) != ordinal {
            panic("Checked ternary expression columns diverged")
          } else {
            (
              CheckedBranchBuilder(
                CheckedBranchBuilderStorage {
                  operators: operators,
                  left: left,
                  right: right,
                  first: first_values,
                  second: second_values,
                  third: third_values
                }
              ),
              ordinal
            )
          }
      }
    }
  }

  fn freeze(self: owned Self) -> CheckedBranchColumns {
    match self {
      CheckedBranchBuilder(storage) -> {
        let { operators, left, right, first, second, third } = storage
        CheckedBranchColumns {
          operators: operators.freeze(),
          left: left.freeze(),
          right: right.freeze(),
          first: first.freeze(),
          second: second.freeze(),
          third: third.freeze()
        }
      }
    }
  }
}

impl Drop for CheckedBranchBuilder {
  fn drop(self) -> nil {
    match self {
      CheckedBranchBuilder(storage) -> {
        let { operators, left, right, first, second, third } = storage
        operators.drop()
        left.drop()
        right.drop()
        first.drop()
        second.drop()
        third.drop()
      }
    }
  }
}

fn checked_binding_expr_builder() -> owned CheckedBindingExprBuilder {
  CheckedBindingExprBuilder(
    CheckedBindingExprBuilderStorage {
      binary_bindings: dense_builder<usize>(),
      binary_values: dense_builder<usize>(),
      binary_bodies: dense_builder<usize>(),
      unary_bindings: dense_builder<usize>(),
      unary_values: dense_builder<usize>()
    }
  )
}

impl CheckedBindingExprBuilder {
  fn binary(
    self: owned Self,
    binding: usize,
    value: usize,
    body: usize
  ) -> (owned CheckedBindingExprBuilder, usize) {
    match self {
      CheckedBindingExprBuilder(storage) -> {
        let { binary_bindings, binary_values, binary_bodies, unary_bindings, unary_values } = storage
        let mut binding_values = binary_bindings
        let mut value_values = binary_values
        let mut body_values = binary_bodies
        let index = binding_values.push(binding)
        let ordinal = dense_index_value(index)
        if dense_index_value(value_values.push(value)) != ordinal or
          dense_index_value(body_values.push(body)) != ordinal {
            panic("Checked binding expression columns diverged")
          } else {
            (
              CheckedBindingExprBuilder(
                CheckedBindingExprBuilderStorage {
                  binary_bindings: binding_values,
                  binary_values: value_values,
                  binary_bodies: body_values,
                  unary_bindings: unary_bindings,
                  unary_values: unary_values
                }
              ),
              ordinal
            )
          }
      }
    }
  }

  fn unary(
    self: owned Self,
    binding: usize,
    value: usize
  ) -> (owned CheckedBindingExprBuilder, usize) {
    match self {
      CheckedBindingExprBuilder(storage) -> {
        let { binary_bindings, binary_values, binary_bodies, unary_bindings, unary_values } = storage
        let mut binding_values = unary_bindings
        let mut value_values = unary_values
        let index = binding_values.push(binding)
        let ordinal = dense_index_value(index)
        if dense_index_value(value_values.push(value)) != ordinal {
          panic("Checked assignment columns diverged")
        } else {
          (
            CheckedBindingExprBuilder(
              CheckedBindingExprBuilderStorage {
                binary_bindings: binary_bindings,
                binary_values: binary_values,
                binary_bodies: binary_bodies,
                unary_bindings: binding_values,
                unary_values: value_values
              }
            ),
            ordinal
          )
        }
      }
    }
  }

  fn freeze(self: owned Self) -> CheckedBindingExprColumns {
    match self {
      CheckedBindingExprBuilder(storage) -> {
        let { binary_bindings, binary_values, binary_bodies, unary_bindings, unary_values } = storage
        CheckedBindingExprColumns {
          binary_bindings: binary_bindings.freeze(),
          binary_values: binary_values.freeze(),
          binary_bodies: binary_bodies.freeze(),
          unary_bindings: unary_bindings.freeze(),
          unary_values: unary_values.freeze()
        }
      }
    }
  }
}

impl Drop for CheckedBindingExprBuilder {
  fn drop(self) -> nil {
    match self {
      CheckedBindingExprBuilder(storage) -> {
        let { binary_bindings, binary_values, binary_bodies, unary_bindings, unary_values } = storage
        binary_bindings.drop()
        binary_values.drop()
        binary_bodies.drop()
        unary_bindings.drop()
        unary_values.drop()
      }
    }
  }
}

fn checked_owner_builder() -> owned CheckedOwnerBuilder {
  CheckedOwnerBuilder(
    CheckedOwnerBuilderStorage {
      binding_owners: dense_builder<FunctionIdentity>(),
      binding_types: checked_type_reference_builder(),
      binding_starts: dense_builder<usize>(),
      binding_ends: dense_builder<usize>(),
      binding_mutability: dense_builder<CheckedBindingMutability>(),
      function_identities: dense_builder<FunctionIdentity>(),
      function_roots: dense_builder<usize>()
    }
  )
}

impl CheckedOwnerBuilder {
  fn binding_len(self: borrow Self) -> usize {
    match self {
      CheckedOwnerBuilder(storage) -> {
        let { binding_owners, binding_types: _, binding_starts: _, binding_ends: _, binding_mutability: _, function_identities: _, function_roots: _ } = storage
        binding_owners.len()
      }
    }
  }

  fn function_len(self: borrow Self) -> usize {
    match self {
      CheckedOwnerBuilder(storage) -> {
        let { binding_owners: _, binding_types: _, binding_starts: _, binding_ends: _, binding_mutability: _, function_identities, function_roots: _ } = storage
        function_identities.len()
      }
    }
  }

  fn binding(
    self: owned Self,
    segment: CheckedExprSegmentId,
    type_segment: SemanticTypeSegmentId,
    owner: FunctionIdentity,
    value_type: SemanticTypeId,
    range: CheckedSourceRange,
    mutability: CheckedBindingMutability
  ) -> (owned CheckedOwnerBuilder, CheckedBindingId) {
    match self {
      CheckedOwnerBuilder(storage) -> {
        let { binding_owners, binding_types, binding_starts, binding_ends, binding_mutability, function_identities, function_roots } = storage
        let mut owner_values = binding_owners
        let mut start_values = binding_starts
        let mut end_values = binding_ends
        let mut mutability_values = binding_mutability
        let index = owner_values.push(owner)
        let ordinal = dense_index_value(index)
        match binding_types.push(type_segment, value_type) {
          (type_values, type_index) -> if dense_index_value(type_index) != ordinal or
            dense_index_value(start_values.push(range.start)) != ordinal or
            dense_index_value(end_values.push(range.end)) != ordinal or
            dense_index_value(mutability_values.push(mutability)) != ordinal {
              panic("Checked binding columns diverged")
            } else {
              (
                CheckedOwnerBuilder(
                  CheckedOwnerBuilderStorage {
                    binding_owners: owner_values,
                    binding_types: type_values,
                    binding_starts: start_values,
                    binding_ends: end_values,
                    binding_mutability: mutability_values,
                    function_identities: function_identities,
                    function_roots: function_roots
                  }
                ),
                CheckedBindingId((segment, index))
              )
            }
        }
      }
    }
  }

  fn function(
    self: owned Self,
    identity: FunctionIdentity,
    root: usize
  ) -> owned CheckedOwnerBuilder {
    match self {
      CheckedOwnerBuilder(storage) -> {
        let { binding_owners, binding_types, binding_starts, binding_ends, binding_mutability, function_identities, function_roots } = storage
        let mut identity_values = function_identities
        let mut root_values = function_roots
        let index = identity_values.push(identity)
        if dense_index_value(index) != dense_index_value(root_values.push(root)) {
          panic("Checked function columns diverged")
        } else {
          CheckedOwnerBuilder(
            CheckedOwnerBuilderStorage {
              binding_owners: binding_owners,
              binding_types: binding_types,
              binding_starts: binding_starts,
              binding_ends: binding_ends,
              binding_mutability: binding_mutability,
              function_identities: identity_values,
              function_roots: root_values
            }
          )
        }
      }
    }
  }

  fn freeze(self: owned Self) -> CheckedOwnerColumns {
    match self {
      CheckedOwnerBuilder(storage) -> {
        let { binding_owners, binding_types, binding_starts, binding_ends, binding_mutability, function_identities, function_roots } = storage
        CheckedOwnerColumns {
          binding_owners: binding_owners.freeze(),
          binding_types: binding_types.freeze(),
          binding_starts: binding_starts.freeze(),
          binding_ends: binding_ends.freeze(),
          binding_mutability: binding_mutability.freeze(),
          function_identities: function_identities.freeze(),
          function_roots: function_roots.freeze()
        }
      }
    }
  }
}

impl Drop for CheckedOwnerBuilder {
  fn drop(self) -> nil {
    match self {
      CheckedOwnerBuilder(storage) -> {
        let { binding_owners, binding_types, binding_starts, binding_ends, binding_mutability, function_identities, function_roots } = storage
        binding_owners.drop()
        binding_types.drop()
        binding_starts.drop()
        binding_ends.drop()
        binding_mutability.drop()
        function_identities.drop()
        function_roots.drop()
      }
    }
  }
}

pub(package) fn checked_expr_graph_builder(
  module: ModuleIdentity,
  source: Source,
  types: SemanticTypeCatalog,
  expected: usize
) -> owned CheckedExprGraphBuilder {
  CheckedExprGraphBuilder(
    CheckedExprGraphBuilderStorage {
      segment: checked_expr_segment_id(module),
      source: source,
      types: types,
      headers: checked_header_builder(expected),
      values: checked_value_builder(),
      branches: checked_branch_builder(),
      binding_exprs: checked_binding_expr_builder(),
      owners: checked_owner_builder()
    }
  )
}

fn checked_expr_builder_value(
  segment: CheckedExprSegmentId,
  source: Source,
  types: SemanticTypeCatalog,
  headers: owned CheckedHeaderBuilder,
  values: owned CheckedValueBuilder,
  branches: owned CheckedBranchBuilder,
  binding_exprs: owned CheckedBindingExprBuilder,
  owners: owned CheckedOwnerBuilder
) -> owned CheckedExprGraphBuilder {
  CheckedExprGraphBuilder(
    CheckedExprGraphBuilderStorage {
      segment: segment,
      source: source,
      types: types,
      headers: headers,
      values: values,
      branches: branches,
      binding_exprs: binding_exprs,
      owners: owners
    }
  )
}

fn checked_expr_finish_node(
  segment: CheckedExprSegmentId,
  source: Source,
  types: SemanticTypeCatalog,
  headers: owned CheckedHeaderBuilder,
  values: owned CheckedValueBuilder,
  branches: owned CheckedBranchBuilder,
  binding_exprs: owned CheckedBindingExprBuilder,
  owners: owned CheckedOwnerBuilder,
  kind: CheckedExprKind,
  payload: usize,
  result: SemanticTypeId,
  range: CheckedSourceRange
) -> (owned CheckedExprGraphBuilder, CheckedExprId) {
  checked_result_type(types, result)
  match headers.push(
    segment,
    semantic_type_segment_id(checked_expr_segment_module(segment)),
    kind,
    payload,
    result,
    checked_range(source, range)
  ) {
    (next_headers, id) -> (
      checked_expr_builder_value(
        segment,
        source,
        types,
        next_headers,
        values,
        branches,
        binding_exprs,
        owners
      ),
      id
    )
  }
}

impl CheckedExprGraphBuilder {
  pub(package) fn len(self: borrow Self) -> usize {
    match self {
      CheckedExprGraphBuilder(storage) -> {
        let { segment, source: _, types: _, headers, values: _, branches: _, binding_exprs: _, owners: _ } = storage
        headers.len()
      }
    }
  }

  pub(package) fn binding_len(self: borrow Self) -> usize {
    match self {
      CheckedExprGraphBuilder(storage) -> {
        let { segment: _, source: _, types: _, headers: _, values: _, branches: _, binding_exprs: _, owners } = storage
        owners.binding_len()
      }
    }
  }

  pub(package) fn function_len(self: borrow Self) -> usize {
    match self {
      CheckedExprGraphBuilder(storage) -> {
        let { segment: _, source: _, types: _, headers: _, values: _, branches: _, binding_exprs: _, owners } = storage
        owners.function_len()
      }
    }
  }

  pub(package) fn binding(
    self: owned Self,
    owner: FunctionIdentity,
    value_type: SemanticTypeId,
    range: CheckedSourceRange,
    mutability: CheckedBindingMutability
  ) -> (owned CheckedExprGraphBuilder, CheckedBindingId) {
    match self {
      CheckedExprGraphBuilder(storage) -> {
        let { segment, source, types, headers, values, branches, binding_exprs, owners } = storage
        if not module_identity_eq(
          checked_expr_segment_module(segment),
          function_identity_module(owner)
        ) { panic("Checked binding owner belongs to another module") }
        else { nil }
        checked_result_type(types, value_type)
        match owners.binding(
          segment,
          semantic_type_segment_id(checked_expr_segment_module(segment)),
          owner,
          value_type,
          checked_range(source, range),
          mutability
        ) {
          (next_owners, id) -> (
            checked_expr_builder_value(
              segment,
              source,
              types,
              headers,
              values,
              branches,
              binding_exprs,
              next_owners
            ),
            id
          )
        }
      }
    }
  }

  pub(package) fn integer(
    self: owned Self,
    value: i64,
    result: SemanticTypeId,
    range: CheckedSourceRange
  ) -> (owned CheckedExprGraphBuilder, CheckedExprId) {
    match self {
      CheckedExprGraphBuilder(storage) -> {
        let { segment, source, types, headers, values, branches, binding_exprs, owners } = storage
        match values.integer(value) {
          (next_values, payload) -> checked_expr_finish_node(
            segment,
            source,
            types,
            headers,
            next_values,
            branches,
            binding_exprs,
            owners,
            CheckedIntegerKind,
            payload,
            result,
            range
          )
        }
      }
    }
  }

  pub(package) fn boolean(
    self: owned Self,
    value: bool,
    result: SemanticTypeId,
    range: CheckedSourceRange
  ) -> (owned CheckedExprGraphBuilder, CheckedExprId) {
    match self {
      CheckedExprGraphBuilder(storage) -> {
        let { segment, source, types, headers, values, branches, binding_exprs, owners } = storage
        match values.boolean(value) {
          (next_values, payload) -> checked_expr_finish_node(
            segment,
            source,
            types,
            headers,
            next_values,
            branches,
            binding_exprs,
            owners,
            CheckedBooleanKind,
            payload,
            result,
            range
          )
        }
      }
    }
  }

  pub(package) fn nil(
    self: owned Self,
    result: SemanticTypeId,
    range: CheckedSourceRange
  ) -> (owned CheckedExprGraphBuilder, CheckedExprId) {
    match self {
      CheckedExprGraphBuilder(storage) -> {
        let { segment, source, types, headers, values, branches, binding_exprs, owners } = storage
        checked_expr_finish_node(
          segment,
          source,
          types,
          headers,
          values,
          branches,
          binding_exprs,
          owners,
          CheckedNilKind,
          0,
          result,
          range
        )
      }
    }
  }

  pub(package) fn local_reference(
    self: owned Self,
    binding: CheckedBindingId,
    result: SemanticTypeId,
    range: CheckedSourceRange
  ) -> (owned CheckedExprGraphBuilder, CheckedExprId) {
    match self {
      CheckedExprGraphBuilder(storage) -> {
        let { segment, source, types, headers, values, branches, binding_exprs, owners } = storage
        let binding_ordinal = checked_binding_ordinal(segment, owners.binding_len(), binding)
        match values.binding_reference(binding_ordinal) {
          (next_values, payload) -> checked_expr_finish_node(
            segment,
            source,
            types,
            headers,
            next_values,
            branches,
            binding_exprs,
            owners,
            CheckedLocalReferenceKind,
            payload,
            result,
            range
          )
        }
      }
    }
  }

  pub(package) fn declaration_reference(
    self: owned Self,
    declaration: DeclarationIdentity,
    result: SemanticTypeId,
    range: CheckedSourceRange
  ) -> (owned CheckedExprGraphBuilder, CheckedExprId) {
    match self {
      CheckedExprGraphBuilder(storage) -> {
        let { segment, source, types, headers, values, branches, binding_exprs, owners } = storage
        match values.declaration(declaration) {
          (next_values, payload) -> checked_expr_finish_node(
            segment,
            source,
            types,
            headers,
            next_values,
            branches,
            binding_exprs,
            owners,
            CheckedDeclarationReferenceKind,
            payload,
            result,
            range
          )
        }
      }
    }
  }

  fn unary(
    self: owned Self,
    kind: CheckedExprKind,
    child: CheckedExprId,
    result: SemanticTypeId,
    range: CheckedSourceRange
  ) -> (owned CheckedExprGraphBuilder, CheckedExprId) {
    match self {
      CheckedExprGraphBuilder(storage) -> {
        let { segment, source, types, headers, values, branches, binding_exprs, owners } = storage
        let child_ordinal = checked_child_ordinal(segment, headers.len(), child)
        match values.unary(child_ordinal) {
          (next_values, payload) -> checked_expr_finish_node(
            segment,
            source,
            types,
            headers,
            next_values,
            branches,
            binding_exprs,
            owners,
            kind,
            payload,
            result,
            range
          )
        }
      }
    }
  }

  pub(package) fn not_expr(
    self: owned Self,
    operand: CheckedExprId,
    result: SemanticTypeId,
    range: CheckedSourceRange
  ) -> (owned CheckedExprGraphBuilder, CheckedExprId) {
    self.unary(CheckedNotKind, operand, result, range)
  }

