    self: owned Self,
    operand: CheckedExprId,
    result: SemanticTypeId,
    range: CheckedSourceRange
  ) -> (owned CheckedExprGraphBuilder, CheckedExprId) {
    self.unary(CheckedNegateKind, operand, result, range)
  }

  pub(package) fn loop_expr(
    self: owned Self,
    body: CheckedExprId,
    result: SemanticTypeId,
