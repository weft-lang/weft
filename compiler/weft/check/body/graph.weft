        checked_owners_function(owners, segment, index)
      }
    }
  }

  pub(package) fn inspect(self: borrow Self, id: CheckedExprId) -> CheckedExpr {
    let node = match self.kind(id) {
      CheckedIntegerKind -> CheckedIntegerNode(self.integer_value(id))
      CheckedBooleanKind -> CheckedBooleanNode(self.boolean_value(id))
      CheckedNilKind -> CheckedNilNode
      CheckedStringKind -> CheckedStringNode(self.string_value(id))
      CheckedFloatKind -> CheckedFloatNode(self.float_value(id))
      CheckedLocalReferenceKind -> CheckedLocalReferenceNode(self.local_binding(id))
      CheckedDeclarationReferenceKind -> CheckedDeclarationReferenceNode(self.declaration(id))
      CheckedNotKind -> CheckedNotNode(self.not_operand(id))
      CheckedNegateKind -> CheckedNegateNode(self.negate_operand(id))
      CheckedBinaryKind -> CheckedBinaryNode(
        self.binary_operator(id),
        self.binary_left(id),
        self.binary_right(id)
      )
      CheckedIfKind -> CheckedIfNode(
        self.if_condition(id),
        self.if_then(id),
        self.if_else(id)
      )
      CheckedBlockKind -> CheckedBlockNode(self.block_first(id), self.block_rest(id))
      CheckedLetKind -> match self.let_parts(id) {
        (binding, value, body) -> CheckedLetNode(binding, value, body)
      }
      CheckedLetMutKind -> match self.let_mut_parts(id) {
        (binding, value, body) -> CheckedLetMutNode(binding, value, body)
      }
      CheckedAssignKind -> match self.assign_parts(id) {
        (binding, value) -> CheckedAssignNode(binding, value)
      }
      CheckedWhileKind -> CheckedWhileNode(self.while_condition(id), self.while_body(id))
      CheckedLoopKind -> CheckedLoopNode(self.loop_body(id))
      CheckedBreakKind -> CheckedBreakNode(self.break_value(id))
      CheckedBreakNoValueKind -> CheckedBreakNoValueNode
      CheckedContinueKind -> CheckedContinueNode
      CheckedReturnKind -> CheckedReturnNode(self.return_value(id))
      CheckedReturnNoValueKind -> CheckedReturnNoValueNode
      CheckedDeferKind -> CheckedDeferNode(self.defer_cleanup(id), self.defer_body(id))
      CheckedDirectCallKind -> match self.direct_call_parts(id) {
        (function, arguments) -> CheckedDirectCallNode(function, arguments)
      }
      CheckedConstructorCallKind -> match self.constructor_call_parts(id) {
        (declaration, arguments) -> CheckedConstructorCallNode(declaration, arguments)
      }
      CheckedApplyKind -> match self.apply_parts(id) {
        (callee, arguments) -> CheckedApplyNode(callee, arguments)
      }
      CheckedGenericCallKind -> match self.generic_call_parts(id) {
        (callee, arguments) -> CheckedGenericCallNode(callee, arguments)
      }
      CheckedMethodCallKind -> match self.method_call_parts(id) {
        (declaration, receiver, arguments) -> CheckedMethodCallNode(
          declaration,
          receiver,
          arguments
        )
      }
      CheckedAddressOfKind -> match self.address_parts(id) {
        (mutable, target) -> CheckedAddressOfNode(mutable, target)
      }
      CheckedDerefKind -> CheckedDerefNode(self.dereference_pointer(id))
      CheckedPointerAssignKind -> match self.pointer_assign_parts(id) {
        (pointer, value) -> CheckedPointerAssignNode(pointer, value)
      }
      CheckedDeclaredFieldAccessKind -> match self.declared_field_access_parts(id) {
        (base, declaration, offset) -> CheckedDeclaredFieldAccessNode(
          base,
          declaration,
          offset
        )
      }
      CheckedStructuralFieldAccessKind -> match self.structural_field_access_parts(id) {
        (base, key, offset) -> CheckedStructuralFieldAccessNode(base, key, offset)
      }
      CheckedIndexedLengthKind -> match self.indexed_length_parts(id) {
        (base, element_type, length) -> CheckedIndexedLengthNode(base, element_type, length)
      }
      CheckedIndexedGetKind -> match self.indexed_get_parts(id) {
        CheckedIndexedGet(base, index, element_type, length) -> CheckedIndexedGetNode(
          base,
          index,
          element_type,
          length
        )
      }
      CheckedIndexedSetKind -> match self.indexed_set_parts(id) {
        CheckedIndexedMutation(base, index, value, element_type) -> CheckedIndexedSetNode(
          base,
          index,
          value,
          element_type
        )
      }
      CheckedIndexedSliceKind -> match self.indexed_slice_parts(id) {
        CheckedIndexedMutation(base, start, end, element_type) -> CheckedIndexedSliceNode(
          base,
          start,
          end,
          element_type
        )
      }
      CheckedRecordInitKind -> match self.record_init_parts(id) {
        (declaration, fields) -> CheckedRecordInitNode(declaration, fields)
      }
      CheckedRecordUpdateKind -> match self.record_update_parts(id) {
        (base, fields) -> CheckedRecordUpdateNode(base, fields)
      }
      CheckedArrayLiteralKind -> match self.array_literal_parts(id) {
        (elements, element_type) -> CheckedArrayLiteralNode(elements, element_type)
      }
      CheckedLambdaKind -> CheckedLambdaNode(self.lambda_detail(id))
      CheckedPerformKind -> CheckedPerformNode(self.perform_detail(id))
      CheckedHandleKind -> CheckedHandleNode(self.handle_detail(id))
      CheckedResumeKind -> CheckedResumeNode(self.resume_value(id))
      CheckedHandlerInstallKind -> CheckedHandlerInstallNode(self.handler_install_detail(id))
      CheckedExplicitMatchKind -> match self.match_parts(id) {
        (origin, scrutinee, arms) -> CheckedMatchNode(origin, scrutinee, arms)
      }
      CheckedLetDestructuringKind -> match self.match_parts(id) {
        (origin, scrutinee, arms) -> CheckedMatchNode(origin, scrutinee, arms)
      }
      CheckedForDestructuringKind -> match self.match_parts(id) {
        (origin, scrutinee, arms) -> CheckedMatchNode(origin, scrutinee, arms)
      }
    }
    CheckedExpr { result: self.result_type(id), range: self.range(id), node: node }
  }
}
