}

fn checked_branch_builder() -> owned CheckedBranchBuilder {
  CheckedBranchBuilder(
    CheckedBranchBuilderStorage {
      operators: dense_builder<CheckedBinaryOperator>(),
      left: dense_builder<usize>(),
      right: dense_builder<usize>(),
      first: dense_builder<usize>(),
      second: dense_builder<usize>(),
      third: dense_builder<usize>()
    }
  )
}

impl CheckedBranchBuilder {
  fn binary(
    self: owned Self,
    operator: CheckedBinaryOperator,
    left_ordinal: usize,
    right_ordinal: usize
  ) -> (owned CheckedBranchBuilder, usize) {
    match self {
      CheckedBranchBuilder(storage) -> {
        let { operators, left, right, first, second, third } = storage
        let mut operator_values = operators
        let mut left_values = left
        let mut right_values = right
        let index = operator_values.push(operator)
        let ordinal = dense_index_value(index)
        if dense_index_value(left_values.push(left_ordinal)) != ordinal or
          dense_index_value(right_values.push(right_ordinal)) != ordinal {
            panic("Checked binary expression columns diverged")
          } else {
            (
              CheckedBranchBuilder(
                CheckedBranchBuilderStorage {
                  operators: operator_values,
                  left: left_values,
                  right: right_values,
                  first: first,
                  second: second,
                  third: third
                }
              ),
              ordinal
            )
          }
      }
    }
  }

  fn pair(
    self: owned Self,
    left_ordinal: usize,
    right_ordinal: usize
  ) -> (owned CheckedBranchBuilder, usize) {
    match self {
      CheckedBranchBuilder(storage) -> {
        let { operators, left, right, first, second, third } = storage
        let mut left_values = left
        let mut right_values = right
        let index = left_values.push(left_ordinal)
        let ordinal = dense_index_value(index)
        if dense_index_value(right_values.push(right_ordinal)) != ordinal {
          panic("Checked binary child columns diverged")
        } else {
          (
            CheckedBranchBuilder(
              CheckedBranchBuilderStorage {
                operators: operators,
                left: left_values,
                right: right_values,
                first: first,
                second: second,
                third: third
              }
            ),
            ordinal
          )
        }
      }
    }
  }

  fn triple(
    self: owned Self,
    first_ordinal: usize,
    second_ordinal: usize,
    third_ordinal: usize
  ) -> (owned CheckedBranchBuilder, usize) {
    match self {
      CheckedBranchBuilder(storage) -> {
        let { operators, left, right, first, second, third } = storage
        let mut first_values = first
        let mut second_values = second
        let mut third_values = third
        let index = first_values.push(first_ordinal)
        let ordinal = dense_index_value(index)
        if dense_index_value(second_values.push(second_ordinal)) != ordinal or
          dense_index_value(third_values.push(third_ordinal)) != ordinal {
            panic("Checked ternary expression columns diverged")
          } else {
            (
              CheckedBranchBuilder(
                CheckedBranchBuilderStorage {
                  operators: operators,
                  left: left,
                  right: right,
                  first: first_values,
                  second: second_values,
                  third: third_values
                }
              ),
              ordinal
            )
          }
      }
    }
  }

  fn freeze(self: owned Self) -> CheckedBranchColumns {
    match self {
      CheckedBranchBuilder(storage) -> {
        let { operators, left, right, first, second, third } = storage
        CheckedBranchColumns {
          operators: operators.freeze(),
          left: left.freeze(),
          right: right.freeze(),
          first: first.freeze(),
          second: second.freeze(),
          third: third.freeze()
        }
      }
    }
  }
}

impl Drop for CheckedBranchBuilder {
  fn drop(self) -> nil {
    match self {
      CheckedBranchBuilder(storage) -> {
        let { operators, left, right, first, second, third } = storage
        operators.drop()
        left.drop()
        right.drop()
        first.drop()
        second.drop()
        third.drop()
      }
    }
  }
}

fn checked_binding_expr_builder() -> owned CheckedBindingExprBuilder {
  CheckedBindingExprBuilder(
    CheckedBindingExprBuilderStorage {
      binary_bindings: dense_builder<usize>(),
      binary_values: dense_builder<usize>(),
      binary_bodies: dense_builder<usize>(),
      unary_bindings: dense_builder<usize>(),
      unary_values: dense_builder<usize>()
    }
  )
}

impl CheckedBindingExprBuilder {
  fn binary(
    self: owned Self,
    binding: usize,
    value: usize,
    body: usize
  ) -> (owned CheckedBindingExprBuilder, usize) {
    match self {
      CheckedBindingExprBuilder(storage) -> {
        let { binary_bindings, binary_values, binary_bodies, unary_bindings, unary_values } = storage
        let mut binding_values = binary_bindings
        let mut value_values = binary_values
        let mut body_values = binary_bodies
        let index = binding_values.push(binding)
        let ordinal = dense_index_value(index)
        if dense_index_value(value_values.push(value)) != ordinal or
          dense_index_value(body_values.push(body)) != ordinal {
            panic("Checked binding expression columns diverged")
          } else {
            (
              CheckedBindingExprBuilder(
                CheckedBindingExprBuilderStorage {
                  binary_bindings: binding_values,
                  binary_values: value_values,
                  binary_bodies: body_values,
                  unary_bindings: unary_bindings,
                  unary_values: unary_values
                }
              ),
              ordinal
            )
          }
      }
    }
  }

  fn unary(
    self: owned Self,
    binding: usize,
    value: usize
  ) -> (owned CheckedBindingExprBuilder, usize) {
    match self {
      CheckedBindingExprBuilder(storage) -> {
        let { binary_bindings, binary_values, binary_bodies, unary_bindings, unary_values } = storage
        let mut binding_values = unary_bindings
        let mut value_values = unary_values
        let index = binding_values.push(binding)
        let ordinal = dense_index_value(index)
        if dense_index_value(value_values.push(value)) != ordinal {
          panic("Checked assignment columns diverged")
        } else {
          (
            CheckedBindingExprBuilder(
              CheckedBindingExprBuilderStorage {
                binary_bindings: binary_bindings,
                binary_values: binary_values,
                binary_bodies: binary_bodies,
                unary_bindings: binding_values,
                unary_values: value_values
              }
            ),
            ordinal
          )
        }
      }
    }
  }

  fn freeze(self: owned Self) -> CheckedBindingExprColumns {
    match self {
      CheckedBindingExprBuilder(storage) -> {
        let { binary_bindings, binary_values, binary_bodies, unary_bindings, unary_values } = storage
        CheckedBindingExprColumns {
          binary_bindings: binary_bindings.freeze(),
          binary_values: binary_values.freeze(),
          binary_bodies: binary_bodies.freeze(),
          unary_bindings: unary_bindings.freeze(),
          unary_values: unary_values.freeze()
        }
      }
    }
  }
}

impl Drop for CheckedBindingExprBuilder {
  fn drop(self) -> nil {
    match self {
      CheckedBindingExprBuilder(storage) -> {
        let { binary_bindings, binary_values, binary_bodies, unary_bindings, unary_values } = storage
        binary_bindings.drop()
        binary_values.drop()
        binary_bodies.drop()
        unary_bindings.drop()
        unary_values.drop()
      }
    }
  }
}

fn checked_owner_builder() -> owned CheckedOwnerBuilder {
  CheckedOwnerBuilder(
    CheckedOwnerBuilderStorage {
      binding_owners: dense_builder<FunctionIdentity>(),
      binding_types: checked_type_reference_builder(),
      binding_starts: dense_builder<usize>(),
      binding_ends: dense_builder<usize>(),
      binding_mutability: dense_builder<CheckedBindingMutability>(),
      function_identities: dense_builder<FunctionIdentity>(),
      function_roots: dense_builder<usize>()
    }
  )
}

impl CheckedOwnerBuilder {
  fn binding_len(self: borrow Self) -> usize {
    match self {
      CheckedOwnerBuilder(storage) -> {
        let { binding_owners, binding_types: _, binding_starts: _, binding_ends: _, binding_mutability: _, function_identities: _, function_roots: _ } = storage
        binding_owners.len()
      }
    }
  }

  fn function_len(self: borrow Self) -> usize {
    match self {
      CheckedOwnerBuilder(storage) -> {
        let { binding_owners: _, binding_types: _, binding_starts: _, binding_ends: _, binding_mutability: _, function_identities, function_roots: _ } = storage
        function_identities.len()
      }
    }
  }

  fn binding(
    self: owned Self,
    segment: CheckedExprSegmentId,
    type_segment: SemanticTypeSegmentId,
    owner: FunctionIdentity,
    value_type: SemanticTypeId,
    range: CheckedSourceRange,
    mutability: CheckedBindingMutability
  ) -> (owned CheckedOwnerBuilder, CheckedBindingId) {
    match self {
      CheckedOwnerBuilder(storage) -> {
        let { binding_owners, binding_types, binding_starts, binding_ends, binding_mutability, function_identities, function_roots } = storage
        let mut owner_values = binding_owners
        let mut start_values = binding_starts
        let mut end_values = binding_ends
        let mut mutability_values = binding_mutability
        let index = owner_values.push(owner)
        let ordinal = dense_index_value(index)
        match binding_types.push(type_segment, value_type) {
          (type_values, type_index) -> if dense_index_value(type_index) != ordinal or
            dense_index_value(start_values.push(range.start)) != ordinal or
            dense_index_value(end_values.push(range.end)) != ordinal or
            dense_index_value(mutability_values.push(mutability)) != ordinal {
              panic("Checked binding columns diverged")
            } else {
              (
                CheckedOwnerBuilder(
                  CheckedOwnerBuilderStorage {
                    binding_owners: owner_values,
                    binding_types: type_values,
                    binding_starts: start_values,
                    binding_ends: end_values,
                    binding_mutability: mutability_values,
                    function_identities: function_identities,
                    function_roots: function_roots
                  }
                ),
                CheckedBindingId((segment, index))
              )
            }
        }
      }
    }
  }

  fn function(
    self: owned Self,
    identity: FunctionIdentity,
    root: usize
  ) -> owned CheckedOwnerBuilder {
    match self {
      CheckedOwnerBuilder(storage) -> {
        let { binding_owners, binding_types, binding_starts, binding_ends, binding_mutability, function_identities, function_roots } = storage
        let mut identity_values = function_identities
        let mut root_values = function_roots
        let index = identity_values.push(identity)
        if dense_index_value(index) != dense_index_value(root_values.push(root)) {
          panic("Checked function columns diverged")
        } else {
          CheckedOwnerBuilder(
            CheckedOwnerBuilderStorage {
              binding_owners: binding_owners,
              binding_types: binding_types,
              binding_starts: binding_starts,
              binding_ends: binding_ends,
              binding_mutability: binding_mutability,
              function_identities: identity_values,
              function_roots: root_values
            }
          )
        }
      }
    }
  }

  fn freeze(self: owned Self) -> CheckedOwnerColumns {
    match self {
      CheckedOwnerBuilder(storage) -> {
        let { binding_owners, binding_types, binding_starts, binding_ends, binding_mutability, function_identities, function_roots } = storage
        CheckedOwnerColumns {
          binding_owners: binding_owners.freeze(),
          binding_types: binding_types.freeze(),
          binding_starts: binding_starts.freeze(),
          binding_ends: binding_ends.freeze(),
          binding_mutability: binding_mutability.freeze(),
          function_identities: function_identities.freeze(),
          function_roots: function_roots.freeze()
        }
      }
    }
  }
}

impl Drop for CheckedOwnerBuilder {
  fn drop(self) -> nil {
    match self {
      CheckedOwnerBuilder(storage) -> {
        let { binding_owners, binding_types, binding_starts, binding_ends, binding_mutability, function_identities, function_roots } = storage
        binding_owners.drop()
        binding_types.drop()
        binding_starts.drop()
        binding_ends.drop()
        binding_mutability.drop()
        function_identities.drop()
        function_roots.drop()
      }
    }
  }
}

fn checked_list_builder() -> owned CheckedListBuilder {
  CheckedListBuilder(
    CheckedListBuilderStorage {
      expr_children: dense_builder<usize>(),
      expr_starts: dense_builder<usize>(),
      expr_counts: dense_builder<usize>(),
      type_values: checked_type_reference_builder(),
      type_starts: dense_builder<usize>(),
      type_counts: dense_builder<usize>(),
      field_kinds: dense_builder<CheckedRecordFieldKind>(),
      field_payloads: dense_builder<usize>(),
      field_starts: dense_builder<usize>(),
      field_counts: dense_builder<usize>()
    }
  )
}

impl CheckedListBuilder {
  fn expr_len(self: borrow Self) -> usize {
    match self {
      CheckedListBuilder(storage) -> {
        let { expr_children, expr_starts: _, expr_counts: _, type_values: _, type_starts: _, type_counts: _, field_kinds: _, field_payloads: _, field_starts: _, field_counts: _ } = storage
        expr_children.len()
      }
    }
  }

  fn expr_list_len(self: borrow Self) -> usize {
    match self {
      CheckedListBuilder(storage) -> {
        let { expr_children: _, expr_starts, expr_counts: _, type_values: _, type_starts: _, type_counts: _, field_kinds: _, field_payloads: _, field_starts: _, field_counts: _ } = storage
        expr_starts.len()
      }
    }
  }

  fn expr_push(self: owned Self, child: usize) -> owned CheckedListBuilder {
    match self {
      CheckedListBuilder(storage) -> {
        let { expr_children, expr_starts, expr_counts, type_values, type_starts, type_counts, field_kinds, field_payloads, field_starts, field_counts } = storage
        let mut values = expr_children
        values.push(child)
        CheckedListBuilder(
          CheckedListBuilderStorage {
            expr_children: values,
            expr_starts: expr_starts,
            expr_counts: expr_counts,
            type_values: type_values,
            type_starts: type_starts,
            type_counts: type_counts,
            field_kinds: field_kinds,
            field_payloads: field_payloads,
            field_starts: field_starts,
            field_counts: field_counts
          }
        )
      }
    }
  }

  fn expr_finish(
    self: owned Self,
    segment: CheckedExprSegmentId,
    start: usize,
    count: usize
  ) -> (owned CheckedListBuilder, CheckedExprListId) {
    match self {
      CheckedListBuilder(storage) -> {
        let { expr_children, expr_starts, expr_counts, type_values, type_starts, type_counts, field_kinds, field_payloads, field_starts, field_counts } = storage
        let mut starts = expr_starts
        let mut counts = expr_counts
        let index = starts.push(start)
        if dense_index_value(counts.push(count)) != dense_index_value(index) {
          panic("Checked expression list columns diverged")
        } else {
          (
            CheckedListBuilder(
              CheckedListBuilderStorage {
                expr_children: expr_children,
                expr_starts: starts,
                expr_counts: counts,
                type_values: type_values,
                type_starts: type_starts,
                type_counts: type_counts,
                field_kinds: field_kinds,
                field_payloads: field_payloads,
                field_starts: field_starts,
                field_counts: field_counts
              }
            ),
            CheckedExprListId((segment, index))
          )
        }
      }
    }
  }

  fn type_len(self: borrow Self) -> usize {
    match self {
      CheckedListBuilder(storage) -> {
        let { expr_children: _, expr_starts: _, expr_counts: _, type_values, type_starts: _, type_counts: _, field_kinds: _, field_payloads: _, field_starts: _, field_counts: _ } = storage
        type_values.len()
      }
    }
  }

  fn type_list_len(self: borrow Self) -> usize {
    match self {
      CheckedListBuilder(storage) -> {
        let { expr_children: _, expr_starts: _, expr_counts: _, type_values: _, type_starts, type_counts: _, field_kinds: _, field_payloads: _, field_starts: _, field_counts: _ } = storage
        type_starts.len()
      }
    }
  }

  fn type_push(
    self: owned Self,
    local: SemanticTypeSegmentId,
    value: SemanticTypeId
  ) -> owned CheckedListBuilder {
    match self {
      CheckedListBuilder(storage) -> {
        let { expr_children, expr_starts, expr_counts, type_values, type_starts, type_counts, field_kinds, field_payloads, field_starts, field_counts } = storage
        match type_values.push(local, value) {
          (next_values, _) -> CheckedListBuilder(
            CheckedListBuilderStorage {
              expr_children: expr_children,
              expr_starts: expr_starts,
              expr_counts: expr_counts,
              type_values: next_values,
              type_starts: type_starts,
              type_counts: type_counts,
              field_kinds: field_kinds,
              field_payloads: field_payloads,
              field_starts: field_starts,
              field_counts: field_counts
            }
          )
        }
      }
    }
  }

  fn type_finish(
    self: owned Self,
    segment: CheckedExprSegmentId,
    start: usize,
    count: usize
  ) -> (owned CheckedListBuilder, CheckedTypeListId) {
    match self {
      CheckedListBuilder(storage) -> {
        let { expr_children, expr_starts, expr_counts, type_values, type_starts, type_counts, field_kinds, field_payloads, field_starts, field_counts } = storage
        let mut starts = type_starts
        let mut counts = type_counts
        let index = starts.push(start)
        if dense_index_value(counts.push(count)) != dense_index_value(index) {
          panic("Checked type list columns diverged")
        } else {
          (
            CheckedListBuilder(
              CheckedListBuilderStorage {
                expr_children: expr_children,
                expr_starts: expr_starts,
                expr_counts: expr_counts,
                type_values: type_values,
                type_starts: starts,
                type_counts: counts,
                field_kinds: field_kinds,
                field_payloads: field_payloads,
                field_starts: field_starts,
                field_counts: field_counts
              }
            ),
            CheckedTypeListId((segment, index))
          )
        }
      }
    }
  }

  fn field_len(self: borrow Self) -> usize {
    match self {
      CheckedListBuilder(storage) -> {
        let { expr_children: _, expr_starts: _, expr_counts: _, type_values: _, type_starts: _, type_counts: _, field_kinds, field_payloads: _, field_starts: _, field_counts: _ } = storage
        field_kinds.len()
      }
    }
  }

  fn field_list_len(self: borrow Self) -> usize {
    match self {
      CheckedListBuilder(storage) -> {
        let { expr_children: _, expr_starts: _, expr_counts: _, type_values: _, type_starts: _, type_counts: _, field_kinds: _, field_payloads: _, field_starts, field_counts: _ } = storage
        field_starts.len()
      }
    }
  }

  fn field_push(
    self: owned Self,
    kind: CheckedRecordFieldKind,
    payload: usize
  ) -> owned CheckedListBuilder {
    match self {
      CheckedListBuilder(storage) -> {
        let { expr_children, expr_starts, expr_counts, type_values, type_starts, type_counts, field_kinds, field_payloads, field_starts, field_counts } = storage
        let mut kinds = field_kinds
        let mut payloads = field_payloads
        let index = kinds.push(kind)
        if dense_index_value(payloads.push(payload)) != dense_index_value(index) {
          panic("Checked record field columns diverged")
        } else {
          CheckedListBuilder(
            CheckedListBuilderStorage {
              expr_children: expr_children,
              expr_starts: expr_starts,
              expr_counts: expr_counts,
              type_values: type_values,
              type_starts: type_starts,
              type_counts: type_counts,
              field_kinds: kinds,
              field_payloads: payloads,
              field_starts: field_starts,
              field_counts: field_counts
            }
          )
        }
      }
    }
  }

  fn field_finish(
    self: owned Self,
    segment: CheckedExprSegmentId,
    start: usize,
    count: usize
  ) -> (owned CheckedListBuilder, CheckedRecordFieldListId) {
    match self {
      CheckedListBuilder(storage) -> {
        let { expr_children, expr_starts, expr_counts, type_values, type_starts, type_counts, field_kinds, field_payloads, field_starts, field_counts } = storage
        let mut starts = field_starts
        let mut counts = field_counts
        let index = starts.push(start)
        if dense_index_value(counts.push(count)) != dense_index_value(index) {
          panic("Checked record field list columns diverged")
        } else {
          (
            CheckedListBuilder(
              CheckedListBuilderStorage {
                expr_children: expr_children,
                expr_starts: expr_starts,
                expr_counts: expr_counts,
                type_values: type_values,
                type_starts: type_starts,
                type_counts: type_counts,
                field_kinds: field_kinds,
                field_payloads: field_payloads,
                field_starts: starts,
                field_counts: counts
              }
            ),
            CheckedRecordFieldListId((segment, index))
          )
        }
      }
    }
  }

  fn freeze(self: owned Self) -> CheckedListColumns {
    match self {
      CheckedListBuilder(storage) -> {
        let { expr_children, expr_starts, expr_counts, type_values, type_starts, type_counts, field_kinds, field_payloads, field_starts, field_counts } = storage
        CheckedListColumns {
          expr_children: expr_children.freeze(),
          expr_starts: expr_starts.freeze(),
          expr_counts: expr_counts.freeze(),
          type_values: type_values.freeze(),
          type_starts: type_starts.freeze(),
          type_counts: type_counts.freeze(),
          field_kinds: field_kinds.freeze(),
          field_payloads: field_payloads.freeze(),
          field_starts: field_starts.freeze(),
          field_counts: field_counts.freeze()
        }
      }
    }
  }
}

impl Drop for CheckedListBuilder {
  fn drop(self) -> nil {
    match self {
      CheckedListBuilder(storage) -> {
        let { expr_children, expr_starts, expr_counts, type_values, type_starts, type_counts, field_kinds, field_payloads, field_starts, field_counts } = storage
        expr_children.drop()
        expr_starts.drop()
        expr_counts.drop()
        type_values.drop()
        type_starts.drop()
        type_counts.drop()
        field_kinds.drop()
        field_payloads.drop()
        field_starts.drop()
        field_counts.drop()
      }
    }
  }
}

fn checked_expr_list_builder_ordinal(
  lists: borrow CheckedListBuilder,
  segment: CheckedExprSegmentId,
  id: CheckedExprListId
) -> usize {
  checked_list_segment(segment, checked_expr_list_id_segment(id))
  let ordinal = checked_expr_list_id_ordinal(id)
  if ordinal >= lists.expr_list_len() { panic("Checked expression list is not published") }
  else { ordinal }
}

fn checked_type_list_builder_ordinal(
  lists: borrow CheckedListBuilder,
  segment: CheckedExprSegmentId,
  id: CheckedTypeListId
) -> usize {
  checked_list_segment(segment, checked_type_list_id_segment(id))
  let ordinal = checked_type_list_id_ordinal(id)
  if ordinal >= lists.type_list_len() { panic("Checked type list is not published") }
  else { ordinal }
}

fn checked_field_list_builder_ordinal(
  lists: borrow CheckedListBuilder,
  segment: CheckedExprSegmentId,
  id: CheckedRecordFieldListId
) -> usize {
  checked_list_segment(segment, checked_field_list_id_segment(id))
  let ordinal = checked_field_list_id_ordinal(id)
  if ordinal >= lists.field_list_len() { panic("Checked record field list is not published") }
  else { ordinal }
}

fn checked_field_builder() -> owned CheckedFieldBuilder {
  CheckedFieldBuilder(
    CheckedFieldBuilderStorage {
      declared_identities: dense_builder<DeclarationIdentity>(),
      declared_values: dense_builder<usize>(),
      declared_offsets: dense_builder<usize>(),
      declared_types: checked_type_reference_builder(),
      structural_keys: dense_builder<i64>(),
      structural_values: dense_builder<usize>(),
      structural_offsets: dense_builder<usize>(),
      structural_types: checked_type_reference_builder()
    }
  )
}

impl CheckedFieldBuilder {
  fn declared(
    self: owned Self,
    local: SemanticTypeSegmentId,
    declaration: DeclarationIdentity,
    value: usize,
    offset: usize,
    value_type: SemanticTypeId
  ) -> (owned CheckedFieldBuilder, usize) {
    match self {
      CheckedFieldBuilder(storage) -> {
        let { declared_identities, declared_values, declared_offsets, declared_types, structural_keys, structural_values, structural_offsets, structural_types } = storage
        let mut identities = declared_identities
        let mut values = declared_values
        let mut offsets = declared_offsets
        let index = identities.push(declaration)
        let ordinal = dense_index_value(index)
        match declared_types.push(local, value_type) {
          (types, type_index) -> if dense_index_value(values.push(value)) != ordinal or
            dense_index_value(offsets.push(offset)) != ordinal or
            dense_index_value(type_index) != ordinal {
              panic("Checked declared record field columns diverged")
            } else {
              (
                CheckedFieldBuilder(
                  CheckedFieldBuilderStorage {
                    declared_identities: identities,
                    declared_values: values,
                    declared_offsets: offsets,
                    declared_types: types,
                    structural_keys: structural_keys,
                    structural_values: structural_values,
                    structural_offsets: structural_offsets,
                    structural_types: structural_types
                  }
                ),
                ordinal
              )
            }
        }
      }
    }
  }

  fn structural(
    self: owned Self,
    local: SemanticTypeSegmentId,
    key: i64,
    value: usize,
    offset: usize,
    value_type: SemanticTypeId
  ) -> (owned CheckedFieldBuilder, usize) {
    match self {
      CheckedFieldBuilder(storage) -> {
        let { declared_identities, declared_values, declared_offsets, declared_types, structural_keys, structural_values, structural_offsets, structural_types } = storage
        let mut keys = structural_keys
        let mut values = structural_values
        let mut offsets = structural_offsets
        let index = keys.push(key)
        let ordinal = dense_index_value(index)
        match structural_types.push(local, value_type) {
          (types, type_index) -> if dense_index_value(values.push(value)) != ordinal or
            dense_index_value(offsets.push(offset)) != ordinal or
            dense_index_value(type_index) != ordinal {
              panic("Checked structural record field columns diverged")
            } else {
              (
                CheckedFieldBuilder(
                  CheckedFieldBuilderStorage {
                    declared_identities: declared_identities,
                    declared_values: declared_values,
                    declared_offsets: declared_offsets,
                    declared_types: declared_types,
                    structural_keys: keys,
                    structural_values: values,
                    structural_offsets: offsets,
                    structural_types: types
                  }
                ),
                ordinal
              )
            }
        }
      }
    }
  }

  fn freeze(self: owned Self) -> CheckedFieldColumns {
    match self {
      CheckedFieldBuilder(storage) -> {
        let { declared_identities, declared_values, declared_offsets, declared_types, structural_keys, structural_values, structural_offsets, structural_types } = storage
        CheckedFieldColumns {
          declared_identities: declared_identities.freeze(),
          declared_values: declared_values.freeze(),
          declared_offsets: declared_offsets.freeze(),
          declared_types: declared_types.freeze(),
          structural_keys: structural_keys.freeze(),
          structural_values: structural_values.freeze(),
          structural_offsets: structural_offsets.freeze(),
          structural_types: structural_types.freeze()
        }
      }
    }
  }
}

impl Drop for CheckedFieldBuilder {
  fn drop(self) -> nil {
    match self {
      CheckedFieldBuilder(storage) -> {
        let { declared_identities, declared_values, declared_offsets, declared_types, structural_keys, structural_values, structural_offsets, structural_types } = storage
        declared_identities.drop()
        declared_values.drop()
        declared_offsets.drop()
        declared_types.drop()
        structural_keys.drop()
        structural_values.drop()
        structural_offsets.drop()
        structural_types.drop()
      }
    }
  }
}

fn checked_call_builder() -> owned CheckedCallBuilder {
  CheckedCallBuilder(
    CheckedCallBuilderStorage {
      direct_functions: dense_builder<FunctionIdentity>(),
      direct_arguments: dense_builder<usize>(),
      constructor_declarations: dense_builder<DeclarationIdentity>(),
      constructor_arguments: dense_builder<usize>(),
      apply_callees: dense_builder<usize>(),
      apply_arguments: dense_builder<usize>(),
      generic_callees: dense_builder<usize>(),
      generic_types: dense_builder<usize>(),
      method_declarations: dense_builder<DeclarationIdentity>(),
      method_receivers: dense_builder<usize>(),
      method_arguments: dense_builder<usize>()
    }
  )
}

impl CheckedCallBuilder {
  fn direct(
    self: owned Self,
    function: FunctionIdentity,
    arguments: usize
  ) -> (owned CheckedCallBuilder, usize) {
    match self {
      CheckedCallBuilder(storage) -> {
        let { direct_functions, direct_arguments, constructor_declarations, constructor_arguments, apply_callees, apply_arguments, generic_callees, generic_types, method_declarations, method_receivers, method_arguments } = storage
        let mut functions = direct_functions
        let mut args = direct_arguments
        let index = functions.push(function)
        if dense_index_value(args.push(arguments)) != dense_index_value(index) {
          panic("Checked direct-call columns diverged")
        } else {
          (
            CheckedCallBuilder(
              CheckedCallBuilderStorage {
                direct_functions: functions,
                direct_arguments: args,
                constructor_declarations: constructor_declarations,
                constructor_arguments: constructor_arguments,
                apply_callees: apply_callees,
                apply_arguments: apply_arguments,
                generic_callees: generic_callees,
                generic_types: generic_types,
                method_declarations: method_declarations,
                method_receivers: method_receivers,
                method_arguments: method_arguments
              }
            ),
            dense_index_value(index)
          )
        }
      }
    }
  }

  fn constructor(
    self: owned Self,
    declaration: DeclarationIdentity,
    arguments: usize
  ) -> (owned CheckedCallBuilder, usize) {
    match self {
      CheckedCallBuilder(storage) -> {
        let { direct_functions, direct_arguments, constructor_declarations, constructor_arguments, apply_callees, apply_arguments, generic_callees, generic_types, method_declarations, method_receivers, method_arguments } = storage
        let mut declarations = constructor_declarations
        let mut args = constructor_arguments
        let index = declarations.push(declaration)
        if dense_index_value(args.push(arguments)) != dense_index_value(index) {
          panic("Checked constructor-call columns diverged")
        } else {
          (
            CheckedCallBuilder(
              CheckedCallBuilderStorage {
                direct_functions: direct_functions,
                direct_arguments: direct_arguments,
                constructor_declarations: declarations,
                constructor_arguments: args,
                apply_callees: apply_callees,
                apply_arguments: apply_arguments,
                generic_callees: generic_callees,
                generic_types: generic_types,
                method_declarations: method_declarations,
                method_receivers: method_receivers,
                method_arguments: method_arguments
              }
            ),
            dense_index_value(index)
          )
        }
      }
    }
  }

  fn method(
    self: owned Self,
    declaration: DeclarationIdentity,
    receiver: usize,
    arguments: usize
  ) -> (owned CheckedCallBuilder, usize) {
    match self {
      CheckedCallBuilder(storage) -> {
        let { direct_functions, direct_arguments, constructor_declarations, constructor_arguments, apply_callees, apply_arguments, generic_callees, generic_types, method_declarations, method_receivers, method_arguments } = storage
        let mut declarations = method_declarations
        let mut receivers = method_receivers
        let mut args = method_arguments
        let index = declarations.push(declaration)
        let ordinal = dense_index_value(index)
        if dense_index_value(receivers.push(receiver)) != ordinal or
          dense_index_value(args.push(arguments)) != ordinal {
            panic("Checked method-call columns diverged")
          } else {
            (
              CheckedCallBuilder(
                CheckedCallBuilderStorage {
                  direct_functions: direct_functions,
                  direct_arguments: direct_arguments,
                  constructor_declarations: constructor_declarations,
                  constructor_arguments: constructor_arguments,
                  apply_callees: apply_callees,
                  apply_arguments: apply_arguments,
                  generic_callees: generic_callees,
                  generic_types: generic_types,
                  method_declarations: declarations,
                  method_receivers: receivers,
                  method_arguments: args
                }
              ),
              ordinal
            )
          }
      }
    }
  }

  fn pair(
    self: owned Self,
    family: CheckedCallPairFamily,
    first: usize,
    second: usize
  ) -> (owned CheckedCallBuilder, usize) {
    match self {
      CheckedCallBuilder(storage) -> {
        let { direct_functions, direct_arguments, constructor_declarations, constructor_arguments, apply_callees, apply_arguments, generic_callees, generic_types, method_declarations, method_receivers, method_arguments } = storage
        match family {
          CheckedApplyFamily -> {
            let mut left = apply_callees
            let mut right = apply_arguments
            let index = left.push(first)
            if dense_index_value(right.push(second)) != dense_index_value(index) {
              panic("Checked apply columns diverged")
            } else {
              (
                CheckedCallBuilder(
                  CheckedCallBuilderStorage {
                    direct_functions: direct_functions,
                    direct_arguments: direct_arguments,
                    constructor_declarations: constructor_declarations,
                    constructor_arguments: constructor_arguments,
                    apply_callees: left,
                    apply_arguments: right,
                    generic_callees: generic_callees,
                    generic_types: generic_types,
                    method_declarations: method_declarations,
                    method_receivers: method_receivers,
                    method_arguments: method_arguments
                  }
                ),
                dense_index_value(index)
              )
            }
          }
          CheckedGenericFamily -> {
            let mut left = generic_callees
            let mut right = generic_types
            let index = left.push(first)
            if dense_index_value(right.push(second)) != dense_index_value(index) {
              panic("Checked generic call columns diverged")
            } else {
              (
                CheckedCallBuilder(
                  CheckedCallBuilderStorage {
                    direct_functions: direct_functions,
                    direct_arguments: direct_arguments,
                    constructor_declarations: constructor_declarations,
                    constructor_arguments: constructor_arguments,
                    apply_callees: apply_callees,
                    apply_arguments: apply_arguments,
                    generic_callees: left,
                    generic_types: right,
                    method_declarations: method_declarations,
                    method_receivers: method_receivers,
                    method_arguments: method_arguments
                  }
                ),
                dense_index_value(index)
              )
            }
          }
        }
      }
    }
  }

  fn freeze(self: owned Self) -> CheckedCallColumns {
    match self {
      CheckedCallBuilder(storage) -> {
        let { direct_functions, direct_arguments, constructor_declarations, constructor_arguments, apply_callees, apply_arguments, generic_callees, generic_types, method_declarations, method_receivers, method_arguments } = storage
        CheckedCallColumns {
          direct_functions: direct_functions.freeze(),
          direct_arguments: direct_arguments.freeze(),
          constructor_declarations: constructor_declarations.freeze(),
          constructor_arguments: constructor_arguments.freeze(),
          apply_callees: apply_callees.freeze(),
          apply_arguments: apply_arguments.freeze(),
          generic_callees: generic_callees.freeze(),
          generic_types: generic_types.freeze(),
          method_declarations: method_declarations.freeze(),
          method_receivers: method_receivers.freeze(),
          method_arguments: method_arguments.freeze()
        }
      }
    }
  }
}

impl Drop for CheckedCallBuilder {
  fn drop(self) -> nil {
    match self {
      CheckedCallBuilder(storage) -> {
        let { direct_functions, direct_arguments, constructor_declarations, constructor_arguments, apply_callees, apply_arguments, generic_callees, generic_types, method_declarations, method_receivers, method_arguments } = storage
        direct_functions.drop()
        direct_arguments.drop()
        constructor_declarations.drop()
        constructor_arguments.drop()
        apply_callees.drop()
        apply_arguments.drop()
        generic_callees.drop()
        generic_types.drop()
        method_declarations.drop()
        method_receivers.drop()
        method_arguments.drop()
      }
    }
  }
}

fn checked_access_builder() -> owned CheckedAccessBuilder {
  CheckedAccessBuilder(
    CheckedAccessBuilderStorage {
      address_mutable: dense_builder<bool>(),
      address_targets: dense_builder<usize>(),
      declared_bases: dense_builder<usize>(),
      declared_fields: dense_builder<DeclarationIdentity>(),
      declared_offsets: dense_builder<usize>(),
      structural_bases: dense_builder<usize>(),
      structural_keys: dense_builder<i64>(),
      structural_offsets: dense_builder<usize>(),
      index_bases: dense_builder<usize>(),
      index_first: dense_builder<usize>(),
      index_second: dense_builder<usize>(),
      index_types: checked_type_reference_builder(),
      index_lengths: dense_builder<isize>()
    }
  )
}

impl CheckedAccessBuilder {
  fn address(
    self: owned Self,
    mutable: bool,
    target: usize
  ) -> (owned CheckedAccessBuilder, usize) {
    match self {
      CheckedAccessBuilder(storage) -> {
        let { address_mutable, address_targets, declared_bases, declared_fields, declared_offsets, structural_bases, structural_keys, structural_offsets, index_bases, index_first, index_second, index_types, index_lengths } = storage
        let mut mutable_values = address_mutable
        let mut targets = address_targets
        let index = mutable_values.push(mutable)
        if dense_index_value(targets.push(target)) != dense_index_value(index) {
          panic("Checked address columns diverged")
        } else {
          (
            CheckedAccessBuilder(
              CheckedAccessBuilderStorage {
                address_mutable: mutable_values,
                address_targets: targets,
                declared_bases: declared_bases,
                declared_fields: declared_fields,
                declared_offsets: declared_offsets,
                structural_bases: structural_bases,
                structural_keys: structural_keys,
                structural_offsets: structural_offsets,
                index_bases: index_bases,
                index_first: index_first,
                index_second: index_second,
                index_types: index_types,
                index_lengths: index_lengths
              }
            ),
            dense_index_value(index)
          )
        }
      }
    }
  }

  fn declared_field(
    self: owned Self,
    base: usize,
    declaration: DeclarationIdentity,
    offset: usize
  ) -> (owned CheckedAccessBuilder, usize) {
    match self {
      CheckedAccessBuilder(storage) -> {
        let { address_mutable, address_targets, declared_bases, declared_fields, declared_offsets, structural_bases, structural_keys, structural_offsets, index_bases, index_first, index_second, index_types, index_lengths } = storage
        let mut bases = declared_bases
        let mut fields = declared_fields
        let mut offsets = declared_offsets
        let index = bases.push(base)
        let ordinal = dense_index_value(index)
        if dense_index_value(fields.push(declaration)) != ordinal or
          dense_index_value(offsets.push(offset)) != ordinal {
            panic("Checked declared field access columns diverged")
          } else {
            (
              CheckedAccessBuilder(
                CheckedAccessBuilderStorage {
                  address_mutable: address_mutable,
                  address_targets: address_targets,
                  declared_bases: bases,
                  declared_fields: fields,
                  declared_offsets: offsets,
                  structural_bases: structural_bases,
                  structural_keys: structural_keys,
                  structural_offsets: structural_offsets,
                  index_bases: index_bases,
                  index_first: index_first,
                  index_second: index_second,
                  index_types: index_types,
                  index_lengths: index_lengths
                }
              ),
              ordinal
            )
          }
      }
    }
  }

  fn structural_field(
    self: owned Self,
    base: usize,
    key: i64,
    offset: usize
  ) -> (owned CheckedAccessBuilder, usize) {
    match self {
      CheckedAccessBuilder(storage) -> {
        let { address_mutable, address_targets, declared_bases, declared_fields, declared_offsets, structural_bases, structural_keys, structural_offsets, index_bases, index_first, index_second, index_types, index_lengths } = storage
        let mut bases = structural_bases
        let mut keys = structural_keys
        let mut offsets = structural_offsets
        let index = bases.push(base)
        let ordinal = dense_index_value(index)
        if dense_index_value(keys.push(key)) != ordinal or
          dense_index_value(offsets.push(offset)) != ordinal {
            panic("Checked structural field access columns diverged")
          } else {
            (
              CheckedAccessBuilder(
                CheckedAccessBuilderStorage {
                  address_mutable: address_mutable,
                  address_targets: address_targets,
                  declared_bases: declared_bases,
                  declared_fields: declared_fields,
                  declared_offsets: declared_offsets,
                  structural_bases: bases,
                  structural_keys: keys,
                  structural_offsets: offsets,
                  index_bases: index_bases,
                  index_first: index_first,
                  index_second: index_second,
                  index_types: index_types,
                  index_lengths: index_lengths
                }
              ),
              ordinal
            )
          }
      }
    }
  }

  fn indexed(
    self: owned Self,
    local: SemanticTypeSegmentId,
    base: usize,
    first: usize,
    second: usize,
    element_type: SemanticTypeId,
    length: isize
  ) -> (owned CheckedAccessBuilder, usize) {
    match self {
      CheckedAccessBuilder(storage) -> {
        let { address_mutable, address_targets, declared_bases, declared_fields, declared_offsets, structural_bases, structural_keys, structural_offsets, index_bases, index_first, index_second, index_types, index_lengths } = storage
        let mut bases = index_bases
        let mut first_values = index_first
        let mut second_values = index_second
        let mut lengths = index_lengths
        let index = bases.push(base)
        let ordinal = dense_index_value(index)
        match index_types.push(local, element_type) {
          (types, type_index) -> if dense_index_value(first_values.push(first)) != ordinal or
            dense_index_value(second_values.push(second)) != ordinal or
            dense_index_value(type_index) != ordinal or
            dense_index_value(lengths.push(length)) != ordinal {
              panic("Checked indexed access columns diverged")
            } else {
              (
                CheckedAccessBuilder(
                  CheckedAccessBuilderStorage {
                    address_mutable: address_mutable,
                    address_targets: address_targets,
                    declared_bases: declared_bases,
                    declared_fields: declared_fields,
                    declared_offsets: declared_offsets,
                    structural_bases: structural_bases,
                    structural_keys: structural_keys,
                    structural_offsets: structural_offsets,
                    index_bases: bases,
                    index_first: first_values,
                    index_second: second_values,
                    index_types: types,
                    index_lengths: lengths
                  }
                ),
                ordinal
              )
            }
        }
      }
    }
  }

  fn freeze(self: owned Self) -> CheckedAccessColumns {
    match self {
      CheckedAccessBuilder(storage) -> {
        let { address_mutable, address_targets, declared_bases, declared_fields, declared_offsets, structural_bases, structural_keys, structural_offsets, index_bases, index_first, index_second, index_types, index_lengths } = storage
        CheckedAccessColumns {
          address_mutable: address_mutable.freeze(),
          address_targets: address_targets.freeze(),
          declared_bases: declared_bases.freeze(),
          declared_fields: declared_fields.freeze(),
          declared_offsets: declared_offsets.freeze(),
          structural_bases: structural_bases.freeze(),
          structural_keys: structural_keys.freeze(),
          structural_offsets: structural_offsets.freeze(),
          index_bases: index_bases.freeze(),
          index_first: index_first.freeze(),
          index_second: index_second.freeze(),
          index_types: index_types.freeze(),
          index_lengths: index_lengths.freeze()
        }
      }
    }
  }
}

impl Drop for CheckedAccessBuilder {
  fn drop(self) -> nil {
    match self {
      CheckedAccessBuilder(storage) -> {
        let { address_mutable, address_targets, declared_bases, declared_fields, declared_offsets, structural_bases, structural_keys, structural_offsets, index_bases, index_first, index_second, index_types, index_lengths } = storage
        address_mutable.drop()
        address_targets.drop()
        declared_bases.drop()
        declared_fields.drop()
        declared_offsets.drop()
        structural_bases.drop()
        structural_keys.drop()
        structural_offsets.drop()
        index_bases.drop()
        index_first.drop()
        index_second.drop()
        index_types.drop()
        index_lengths.drop()
      }
    }
  }
}

fn checked_aggregate_builder() -> owned CheckedAggregateBuilder {
  CheckedAggregateBuilder(
    CheckedAggregateBuilderStorage {
      record_declarations: dense_builder<DeclarationIdentity>(),
      record_fields: dense_builder<usize>(),
      update_bases: dense_builder<usize>(),
      update_fields: dense_builder<usize>(),
      array_elements: dense_builder<usize>(),
      array_types: checked_type_reference_builder()
    }
  )
}

impl CheckedAggregateBuilder {
  fn record(
    self: owned Self,
    declaration: DeclarationIdentity,
    fields: usize
  ) -> (owned CheckedAggregateBuilder, usize) {
    match self {
      CheckedAggregateBuilder(storage) -> {
        let { record_declarations, record_fields, update_bases, update_fields, array_elements, array_types } = storage
        let mut declarations = record_declarations
        let mut field_values = record_fields
        let index = declarations.push(declaration)
        if dense_index_value(field_values.push(fields)) != dense_index_value(index) {
          panic("Checked record initialization columns diverged")
        } else {
          (
            CheckedAggregateBuilder(
              CheckedAggregateBuilderStorage {
                record_declarations: declarations,
                record_fields: field_values,
                update_bases: update_bases,
                update_fields: update_fields,
                array_elements: array_elements,
                array_types: array_types
              }
            ),
            dense_index_value(index)
          )
        }
      }
    }
  }

  fn update(
    self: owned Self,
    base: usize,
    fields: usize
  ) -> (owned CheckedAggregateBuilder, usize) {
    match self {
      CheckedAggregateBuilder(storage) -> {
        let { record_declarations, record_fields, update_bases, update_fields, array_elements, array_types } = storage
        let mut bases = update_bases
        let mut field_values = update_fields
        let index = bases.push(base)
        if dense_index_value(field_values.push(fields)) != dense_index_value(index) {
          panic("Checked record update columns diverged")
        } else {
          (
            CheckedAggregateBuilder(
              CheckedAggregateBuilderStorage {
                record_declarations: record_declarations,
                record_fields: record_fields,
                update_bases: bases,
                update_fields: field_values,
                array_elements: array_elements,
                array_types: array_types
              }
            ),
            dense_index_value(index)
          )
        }
      }
    }
  }

  fn array(
    self: owned Self,
    local: SemanticTypeSegmentId,
    elements: usize,
    element_type: SemanticTypeId
  ) -> (owned CheckedAggregateBuilder, usize) {
    match self {
      CheckedAggregateBuilder(storage) -> {
        let { record_declarations, record_fields, update_bases, update_fields, array_elements, array_types } = storage
        let mut element_values = array_elements
        let index = element_values.push(elements)
        let ordinal = dense_index_value(index)
        match array_types.push(local, element_type) {
          (types, type_index) -> if dense_index_value(type_index) != ordinal {
            panic("Checked array literal columns diverged")
          } else {
            (
              CheckedAggregateBuilder(
                CheckedAggregateBuilderStorage {
                  record_declarations: record_declarations,
                  record_fields: record_fields,
                  update_bases: update_bases,
                  update_fields: update_fields,
                  array_elements: element_values,
                  array_types: types
                }
              ),
              ordinal
            )
          }
        }
      }
    }
  }

  fn freeze(self: owned Self) -> CheckedAggregateColumns {
    match self {
      CheckedAggregateBuilder(storage) -> {
        let { record_declarations, record_fields, update_bases, update_fields, array_elements, array_types } = storage
        CheckedAggregateColumns {
          record_declarations: record_declarations.freeze(),
          record_fields: record_fields.freeze(),
          update_bases: update_bases.freeze(),
          update_fields: update_fields.freeze(),
          array_elements: array_elements.freeze(),
          array_types: array_types.freeze()
        }
      }
    }
  }
}

impl Drop for CheckedAggregateBuilder {
  fn drop(self) -> nil {
    match self {
      CheckedAggregateBuilder(storage) -> {
        let { record_declarations, record_fields, update_bases, update_fields, array_elements, array_types } = storage
        record_declarations.drop()
        record_fields.drop()
        update_bases.drop()
        update_fields.drop()
        array_elements.drop()
        array_types.drop()
      }
    }
  }
}

fn checked_extra_builder() -> owned CheckedExtraBuilder {
  CheckedExtraBuilder(
    CheckedExtraBuilderStorage {
      lists: checked_list_builder(),
      fields: checked_field_builder(),
      calls: checked_call_builder(),
      accesses: checked_access_builder(),
      aggregates: checked_aggregate_builder()
    }
  )
}

impl CheckedExtraBuilder {
  fn expr_list_begin(
    self: owned Self,
    segment: CheckedExprSegmentId
  ) -> (owned CheckedExtraBuilder, CheckedExprListBuilder) {
    match self {
      CheckedExtraBuilder(storage) -> {
        let { lists, fields, calls, accesses, aggregates } = storage
        let start = lists.expr_len()
        (
          CheckedExtraBuilder(
            CheckedExtraBuilderStorage {
              lists: lists,
              fields: fields,
              calls: calls,
              accesses: accesses,
              aggregates: aggregates
            }
          ),
          CheckedExprListBuilder((segment, start, 0))
        )
      }
    }
  }

  fn expr_list_push(
    self: owned Self,
    segment: CheckedExprSegmentId,
    node_count: usize,
    list: CheckedExprListBuilder,
    child: CheckedExprId
  ) -> (owned CheckedExtraBuilder, CheckedExprListBuilder) {
    match list {
      CheckedExprListBuilder((owner, start, count)) -> {
        checked_list_segment(segment, owner)
        match self {
          CheckedExtraBuilder(storage) -> {
            let { lists, fields, calls, accesses, aggregates } = storage
            if lists.expr_len() != start + count {
              panic("Checked expression lists cannot be interleaved")
            } else { nil }
            let ordinal = checked_child_ordinal(segment, node_count, child)
            (
              CheckedExtraBuilder(
                CheckedExtraBuilderStorage {
                  lists: lists.expr_push(ordinal),
                  fields: fields,
                  calls: calls,
                  accesses: accesses,
                  aggregates: aggregates
                }
              ),
              CheckedExprListBuilder((segment, start, count + 1))
            )
          }
        }
      }
    }
  }

  fn expr_list_finish(
    self: owned Self,
    segment: CheckedExprSegmentId,
    list: CheckedExprListBuilder
  ) -> (owned CheckedExtraBuilder, CheckedExprListId) {
    match list {
      CheckedExprListBuilder((owner, start, count)) -> {
        checked_list_segment(segment, owner)
        match self {
          CheckedExtraBuilder(storage) -> {
            let { lists, fields, calls, accesses, aggregates } = storage
            if lists.expr_len() != start + count {
              panic("Checked expression list is not the active list")
            } else { nil }
            match lists.expr_finish(segment, start, count) {
              (next_lists, id) -> (
                CheckedExtraBuilder(
                  CheckedExtraBuilderStorage {
                    lists: next_lists,
                    fields: fields,
                    calls: calls,
                    accesses: accesses,
                    aggregates: aggregates
                  }
                ),
                id
              )
            }
          }
        }
      }
    }
  }

  fn type_list_begin(
    self: owned Self,
    segment: CheckedExprSegmentId
  ) -> (owned CheckedExtraBuilder, CheckedTypeListBuilder) {
    match self {
      CheckedExtraBuilder(storage) -> {
        let { lists, fields, calls, accesses, aggregates } = storage
        let start = lists.type_len()
        (
          CheckedExtraBuilder(
            CheckedExtraBuilderStorage {
              lists: lists,
              fields: fields,
              calls: calls,
              accesses: accesses,
              aggregates: aggregates
            }
          ),
          CheckedTypeListBuilder((segment, start, 0))
        )
      }
    }
  }

  fn type_list_push(
    self: owned Self,
    segment: CheckedExprSegmentId,
    local: SemanticTypeSegmentId,
    list: CheckedTypeListBuilder,
    value: SemanticTypeId
  ) -> (owned CheckedExtraBuilder, CheckedTypeListBuilder) {
    match list {
      CheckedTypeListBuilder((owner, start, count)) -> {
        checked_list_segment(segment, owner)
        match self {
          CheckedExtraBuilder(storage) -> {
            let { lists, fields, calls, accesses, aggregates } = storage
            if lists.type_len() != start + count {
              panic("Checked type lists cannot be interleaved")
            } else { nil }
            (
              CheckedExtraBuilder(
                CheckedExtraBuilderStorage {
                  lists: lists.type_push(local, value),
                  fields: fields,
                  calls: calls,
                  accesses: accesses,
                  aggregates: aggregates
                }
              ),
              CheckedTypeListBuilder((segment, start, count + 1))
            )
          }
        }
      }
    }
  }

  fn type_list_finish(
    self: owned Self,
    segment: CheckedExprSegmentId,
    list: CheckedTypeListBuilder
  ) -> (owned CheckedExtraBuilder, CheckedTypeListId) {
    match list {
      CheckedTypeListBuilder((owner, start, count)) -> {
        checked_list_segment(segment, owner)
        match self {
          CheckedExtraBuilder(storage) -> {
            let { lists, fields, calls, accesses, aggregates } = storage
            if lists.type_len() != start + count {
              panic("Checked type list is not the active list")
            } else { nil }
            match lists.type_finish(segment, start, count) {
              (next_lists, id) -> (
                CheckedExtraBuilder(
                  CheckedExtraBuilderStorage {
                    lists: next_lists,
                    fields: fields,
                    calls: calls,
                    accesses: accesses,
                    aggregates: aggregates
                  }
                ),
                id
              )
            }
          }
        }
      }
    }
  }

  fn field_list_begin(
    self: owned Self,
    segment: CheckedExprSegmentId
  ) -> (owned CheckedExtraBuilder, CheckedRecordFieldListBuilder) {
    match self {
      CheckedExtraBuilder(storage) -> {
        let { lists, fields, calls, accesses, aggregates } = storage
        let start = lists.field_len()
        (
          CheckedExtraBuilder(
            CheckedExtraBuilderStorage {
              lists: lists,
              fields: fields,
              calls: calls,
              accesses: accesses,
              aggregates: aggregates
            }
          ),
          CheckedRecordFieldListBuilder((segment, start, 0))
        )
      }
    }
  }

  fn declared_field(
    self: owned Self,
    segment: CheckedExprSegmentId,
    local: SemanticTypeSegmentId,
    list: CheckedRecordFieldListBuilder,
    declaration: DeclarationIdentity,
    value: usize,
    offset: usize,
    value_type: SemanticTypeId
  ) -> (owned CheckedExtraBuilder, CheckedRecordFieldListBuilder) {
    match list {
      CheckedRecordFieldListBuilder((owner, start, count)) -> {
        checked_list_segment(segment, owner)
        match self {
          CheckedExtraBuilder(storage) -> {
            let { lists, fields, calls, accesses, aggregates } = storage
            if lists.field_len() != start + count {
              panic("Checked record field lists cannot be interleaved")
            } else { nil }
            match fields.declared(local, declaration, value, offset, value_type) {
              (next_fields, payload) -> (
                CheckedExtraBuilder(
                  CheckedExtraBuilderStorage {
                    lists: lists.field_push(CheckedDeclaredRecordField, payload),
                    fields: next_fields,
                    calls: calls,
                    accesses: accesses,
                    aggregates: aggregates
                  }
                ),
                CheckedRecordFieldListBuilder((segment, start, count + 1))
              )
            }
          }
        }
      }
    }
  }

  fn structural_field(
    self: owned Self,
    segment: CheckedExprSegmentId,
    local: SemanticTypeSegmentId,
    list: CheckedRecordFieldListBuilder,
    key: i64,
    value: usize,
    offset: usize,
    value_type: SemanticTypeId
  ) -> (owned CheckedExtraBuilder, CheckedRecordFieldListBuilder) {
    match list {
      CheckedRecordFieldListBuilder((owner, start, count)) -> {
        checked_list_segment(segment, owner)
        match self {
          CheckedExtraBuilder(storage) -> {
            let { lists, fields, calls, accesses, aggregates } = storage
            if lists.field_len() != start + count {
              panic("Checked record field lists cannot be interleaved")
            } else { nil }
            match fields.structural(local, key, value, offset, value_type) {
              (next_fields, payload) -> (
                CheckedExtraBuilder(
                  CheckedExtraBuilderStorage {
                    lists: lists.field_push(CheckedStructuralRecordField, payload),
                    fields: next_fields,
                    calls: calls,
                    accesses: accesses,
                    aggregates: aggregates
                  }
                ),
                CheckedRecordFieldListBuilder((segment, start, count + 1))
              )
            }
          }
        }
      }
    }
  }

  fn field_list_finish(
    self: owned Self,
    segment: CheckedExprSegmentId,
    list: CheckedRecordFieldListBuilder
  ) -> (owned CheckedExtraBuilder, CheckedRecordFieldListId) {
    match list {
      CheckedRecordFieldListBuilder((owner, start, count)) -> {
        checked_list_segment(segment, owner)
        match self {
          CheckedExtraBuilder(storage) -> {
            let { lists, fields, calls, accesses, aggregates } = storage
            if lists.field_len() != start + count {
              panic("Checked record field list is not the active list")
            } else { nil }
            match lists.field_finish(segment, start, count) {
              (next_lists, id) -> (
                CheckedExtraBuilder(
                  CheckedExtraBuilderStorage {
                    lists: next_lists,
                    fields: fields,
                    calls: calls,
                    accesses: accesses,
                    aggregates: aggregates
                  }
                ),
                id
              )
            }
          }
        }
      }
    }
  }

  fn direct_call(
    self: owned Self,
    segment: CheckedExprSegmentId,
    function: FunctionIdentity,
    arguments: CheckedExprListId
  ) -> (owned CheckedExtraBuilder, usize) {
    match self {
      CheckedExtraBuilder(storage) -> {
        let { lists, fields, calls, accesses, aggregates } = storage
        let argument_ordinal = checked_expr_list_builder_ordinal(lists, segment, arguments)
        match calls.direct(function, argument_ordinal) {
          (next_calls, payload) -> (
            CheckedExtraBuilder(
              CheckedExtraBuilderStorage {
                lists: lists,
                fields: fields,
                calls: next_calls,
                accesses: accesses,
                aggregates: aggregates
              }
            ),
            payload
          )
        }
      }
    }
  }

  fn constructor_call(
    self: owned Self,
    segment: CheckedExprSegmentId,
    declaration: DeclarationIdentity,
    arguments: CheckedExprListId
  ) -> (owned CheckedExtraBuilder, usize) {
    match self {
      CheckedExtraBuilder(storage) -> {
        let { lists, fields, calls, accesses, aggregates } = storage
        let argument_ordinal = checked_expr_list_builder_ordinal(lists, segment, arguments)
        match calls.constructor(declaration, argument_ordinal) {
          (next_calls, payload) -> (
            CheckedExtraBuilder(
              CheckedExtraBuilderStorage {
                lists: lists,
                fields: fields,
                calls: next_calls,
                accesses: accesses,
                aggregates: aggregates
              }
            ),
            payload
          )
        }
      }
    }
  }

  fn call_pair(
    self: owned Self,
    segment: CheckedExprSegmentId,
    family: CheckedCallPairFamily,
    callee: usize,
    list: usize
  ) -> (owned CheckedExtraBuilder, usize) {
    match self {
      CheckedExtraBuilder(storage) -> {
        let { lists, fields, calls, accesses, aggregates } = storage
        let list_ordinal = match family {
          CheckedApplyFamily -> checked_expr_list_builder_ordinal(
            lists,
            segment,
            CheckedExprListId((segment, dense_index(list)))
          )
          CheckedGenericFamily -> checked_type_list_builder_ordinal(
            lists,
            segment,
            CheckedTypeListId((segment, dense_index(list)))
          )
        }
        match calls.pair(family, callee, list_ordinal) {
          (next_calls, payload) -> (
            CheckedExtraBuilder(
              CheckedExtraBuilderStorage {
                lists: lists,
                fields: fields,
                calls: next_calls,
                accesses: accesses,
                aggregates: aggregates
              }
            ),
            payload
          )
        }
      }
    }
  }

  fn method_call(
    self: owned Self,
    segment: CheckedExprSegmentId,
    declaration: DeclarationIdentity,
    receiver: usize,
    arguments: CheckedExprListId
  ) -> (owned CheckedExtraBuilder, usize) {
    match self {
      CheckedExtraBuilder(storage) -> {
        let { lists, fields, calls, accesses, aggregates } = storage
        let argument_ordinal = checked_expr_list_builder_ordinal(lists, segment, arguments)
        match calls.method(declaration, receiver, argument_ordinal) {
          (next_calls, payload) -> (
            CheckedExtraBuilder(
              CheckedExtraBuilderStorage {
                lists: lists,
                fields: fields,
                calls: next_calls,
                accesses: accesses,
                aggregates: aggregates
              }
            ),
            payload
          )
        }
      }
    }
  }

  fn address(
    self: owned Self,
    mutable: bool,
    target: usize
  ) -> (owned CheckedExtraBuilder, usize) {
    match self {
      CheckedExtraBuilder(storage) -> {
        let { lists, fields, calls, accesses, aggregates } = storage
        match accesses.address(mutable, target) {
          (next_accesses, payload) -> (
            CheckedExtraBuilder(
              CheckedExtraBuilderStorage {
                lists: lists,
                fields: fields,
                calls: calls,
                accesses: next_accesses,
                aggregates: aggregates
              }
            ),
            payload
          )
        }
      }
    }
  }

  fn declared_access(
    self: owned Self,
    base: usize,
    declaration: DeclarationIdentity,
    offset: usize
  ) -> (owned CheckedExtraBuilder, usize) {
    match self {
      CheckedExtraBuilder(storage) -> {
        let { lists, fields, calls, accesses, aggregates } = storage
        match accesses.declared_field(base, declaration, offset) {
          (next_accesses, payload) -> (
            CheckedExtraBuilder(
              CheckedExtraBuilderStorage {
                lists: lists,
                fields: fields,
                calls: calls,
                accesses: next_accesses,
                aggregates: aggregates
              }
            ),
            payload
          )
        }
      }
    }
  }

  fn structural_access(
    self: owned Self,
    base: usize,
    key: i64,
    offset: usize
  ) -> (owned CheckedExtraBuilder, usize) {
    match self {
      CheckedExtraBuilder(storage) -> {
        let { lists, fields, calls, accesses, aggregates } = storage
        match accesses.structural_field(base, key, offset) {
          (next_accesses, payload) -> (
            CheckedExtraBuilder(
              CheckedExtraBuilderStorage {
                lists: lists,
                fields: fields,
                calls: calls,
                accesses: next_accesses,
                aggregates: aggregates
              }
            ),
            payload
          )
        }
      }
    }
  }

  fn indexed(
    self: owned Self,
    local: SemanticTypeSegmentId,
    base: usize,
    first: usize,
    second: usize,
    element_type: SemanticTypeId,
    length: isize
  ) -> (owned CheckedExtraBuilder, usize) {
    match self {
      CheckedExtraBuilder(storage) -> {
        let { lists, fields, calls, accesses, aggregates } = storage
        match accesses.indexed(local, base, first, second, element_type, length) {
          (next_accesses, payload) -> (
            CheckedExtraBuilder(
              CheckedExtraBuilderStorage {
                lists: lists,
                fields: fields,
                calls: calls,
                accesses: next_accesses,
                aggregates: aggregates
              }
            ),
            payload
          )
        }
      }
    }
  }

  fn record_init(
    self: owned Self,
    segment: CheckedExprSegmentId,
    declaration: DeclarationIdentity,
    fields_id: CheckedRecordFieldListId
  ) -> (owned CheckedExtraBuilder, usize) {
    match self {
      CheckedExtraBuilder(storage) -> {
        let { lists, fields, calls, accesses, aggregates } = storage
        let field_ordinal = checked_field_list_builder_ordinal(lists, segment, fields_id)
        match aggregates.record(declaration, field_ordinal) {
          (next_aggregates, payload) -> (
            CheckedExtraBuilder(
              CheckedExtraBuilderStorage {
                lists: lists,
                fields: fields,
                calls: calls,
                accesses: accesses,
                aggregates: next_aggregates
              }
            ),
            payload
          )
        }
      }
    }
  }

  fn record_update(
    self: owned Self,
    segment: CheckedExprSegmentId,
    base: usize,
    fields_id: CheckedRecordFieldListId
  ) -> (owned CheckedExtraBuilder, usize) {
    match self {
      CheckedExtraBuilder(storage) -> {
        let { lists, fields, calls, accesses, aggregates } = storage
        let field_ordinal = checked_field_list_builder_ordinal(lists, segment, fields_id)
        match aggregates.update(base, field_ordinal) {
          (next_aggregates, payload) -> (
            CheckedExtraBuilder(
              CheckedExtraBuilderStorage {
                lists: lists,
                fields: fields,
                calls: calls,
                accesses: accesses,
                aggregates: next_aggregates
              }
            ),
            payload
          )
        }
      }
    }
  }

  fn array(
    self: owned Self,
    segment: CheckedExprSegmentId,
    local: SemanticTypeSegmentId,
    elements: CheckedExprListId,
    element_type: SemanticTypeId
  ) -> (owned CheckedExtraBuilder, usize) {
    match self {
      CheckedExtraBuilder(storage) -> {
        let { lists, fields, calls, accesses, aggregates } = storage
        let element_ordinal = checked_expr_list_builder_ordinal(lists, segment, elements)
        match aggregates.array(local, element_ordinal, element_type) {
          (next_aggregates, payload) -> (
            CheckedExtraBuilder(
              CheckedExtraBuilderStorage {
                lists: lists,
                fields: fields,
                calls: calls,
                accesses: accesses,
                aggregates: next_aggregates
              }
            ),
            payload
          )
        }
      }
    }
  }

  fn freeze(self: owned Self) -> CheckedExtraColumns {
    match self {
      CheckedExtraBuilder(storage) -> {
        let { lists, fields, calls, accesses, aggregates } = storage
        CheckedExtraColumns {
          lists: lists.freeze(),
          fields: fields.freeze(),
          calls: calls.freeze(),
          accesses: accesses.freeze(),
          aggregates: aggregates.freeze()
        }
      }
    }
  }
}

impl Drop for CheckedExtraBuilder {
  fn drop(self) -> nil {
    match self {
      CheckedExtraBuilder(storage) -> {
        let { lists, fields, calls, accesses, aggregates } = storage
        lists.drop()
        fields.drop()
        calls.drop()
        accesses.drop()
        aggregates.drop()
      }
    }
  }
}

pub(package) fn checked_expr_graph_builder(
  module: ModuleIdentity,
  source: Source,
  types: SemanticTypeCatalog,
  expected: usize
) -> owned CheckedExprGraphBuilder {
  CheckedExprGraphBuilder(
    CheckedExprGraphBuilderStorage {
      segment: checked_expr_segment_id(module),
      source: source,
      types: types,
      headers: checked_header_builder(expected),
      values: checked_value_builder(),
      branches: checked_branch_builder(),
      binding_exprs: checked_binding_expr_builder(),
      owners: checked_owner_builder(),
      extras: checked_extra_builder()
    }
  )
}

fn checked_expr_builder_value(
  segment: CheckedExprSegmentId,
  source: Source,
  types: SemanticTypeCatalog,
  headers: owned CheckedHeaderBuilder,
  values: owned CheckedValueBuilder,
  branches: owned CheckedBranchBuilder,
  binding_exprs: owned CheckedBindingExprBuilder,
  owners: owned CheckedOwnerBuilder,
  extras: owned CheckedExtraBuilder
) -> owned CheckedExprGraphBuilder {
  CheckedExprGraphBuilder(
    CheckedExprGraphBuilderStorage {
      segment: segment,
      source: source,
      types: types,
      headers: headers,
      values: values,
      branches: branches,
      binding_exprs: binding_exprs,
      owners: owners,
      extras: extras
    }
  )
}

fn checked_expr_finish_node(
  segment: CheckedExprSegmentId,
  source: Source,
  types: SemanticTypeCatalog,
  headers: owned CheckedHeaderBuilder,
  values: owned CheckedValueBuilder,
  branches: owned CheckedBranchBuilder,
  binding_exprs: owned CheckedBindingExprBuilder,
  owners: owned CheckedOwnerBuilder,
  extras: owned CheckedExtraBuilder,
  kind: CheckedExprKind,
  payload: usize,
  result: SemanticTypeId,
  range: CheckedSourceRange
) -> (owned CheckedExprGraphBuilder, CheckedExprId) {
  checked_result_type(types, result)
  match headers.push(
    segment,
    semantic_type_segment_id(checked_expr_segment_module(segment)),
    kind,
    payload,
    result,
    checked_range(source, range)
  ) {
    (next_headers, id) -> (
      checked_expr_builder_value(
        segment,
        source,
        types,
        next_headers,
        values,
        branches,
        binding_exprs,
        owners,
        extras
      ),
      id
    )
  }
}

impl CheckedExprGraphBuilder {
  pub(package) fn segment(self: borrow Self) -> CheckedExprSegmentId {
    match self {
      CheckedExprGraphBuilder(storage) -> {
        let { segment, source: _, types: _, headers: _, values: _, branches: _, binding_exprs: _, owners: _, extras: _ } = storage
        segment
      }
    }
  }

  pub(package) fn types(self: borrow Self) -> SemanticTypeCatalog {
    match self {
      CheckedExprGraphBuilder(storage) -> storage.types
    }
  }

  pub(package) fn len(self: borrow Self) -> usize {
    match self {
      CheckedExprGraphBuilder(storage) -> {
        let { segment, source: _, types: _, headers, values: _, branches: _, binding_exprs: _, owners: _, extras: _ } = storage
        headers.len()
      }
    }
  }

  pub(package) fn binding_len(self: borrow Self) -> usize {
    match self {
      CheckedExprGraphBuilder(storage) -> {
        let { segment: _, source: _, types: _, headers: _, values: _, branches: _, binding_exprs: _, owners, extras: _ } = storage
        owners.binding_len()
      }
    }
  }

  pub(package) fn function_len(self: borrow Self) -> usize {
    match self {
      CheckedExprGraphBuilder(storage) -> {
        let { segment: _, source: _, types: _, headers: _, values: _, branches: _, binding_exprs: _, owners, extras: _ } = storage
        owners.function_len()
      }
    }
  }

  pub(package) fn expression_list(
    self: owned Self
  ) -> (owned CheckedExprGraphBuilder, CheckedExprListBuilder) {
    match self {
      CheckedExprGraphBuilder(storage) -> {
        let { segment, source, types, headers, values, branches, binding_exprs, owners, extras } = storage
        match extras.expr_list_begin(segment) {
          (next_extras, list) -> (
            checked_expr_builder_value(
              segment,
              source,
              types,
              headers,
              values,
              branches,
              binding_exprs,
              owners,
              next_extras
            ),
            list
          )
        }
      }
    }
  }

  pub(package) fn expression_list_push(
    self: owned Self,
    list: CheckedExprListBuilder,
    child: CheckedExprId
  ) -> (owned CheckedExprGraphBuilder, CheckedExprListBuilder) {
    match self {
      CheckedExprGraphBuilder(storage) -> {
        let { segment, source, types, headers, values, branches, binding_exprs, owners, extras } = storage
        match extras.expr_list_push(segment, headers.len(), list, child) {
          (next_extras, next_list) -> (
            checked_expr_builder_value(
              segment,
              source,
              types,
              headers,
              values,
              branches,
              binding_exprs,
              owners,
              next_extras
            ),
            next_list
          )
        }
      }
    }
  }

  pub(package) fn finish_expression_list(
    self: owned Self,
