        match checked_lists_field_entry(
          lists,
          checked_field_list_id_ordinal(id),
          position
        ) {
          (CheckedDeclaredRecordField, payload) -> checked_fields_declared(
            fields,
            semantic_type_segment_id(checked_expr_segment_module(segment)),
            segment,
            payload
          )
          (CheckedStructuralRecordField, payload) -> checked_fields_structural(
            fields,
            semantic_type_segment_id(checked_expr_segment_module(segment)),
            segment,
            payload
          )
        }
      }
    }
  }

