        let mut next = booleans
        let index = dense_index_value(next.push(value))
        (
          CheckedValueBuilder(
            CheckedValueBuilderStorage {
              integers: integers,
              booleans: next,
              strings: strings,
              floats: floats,
              binding_references: binding_references,
              declarations: declarations,
              unary_children: unary_children
            }
          ),
          index
        )
      }
    }
  }

  fn string(self: owned Self, value: str) -> (owned CheckedValueBuilder, usize) {
    match self {
      CheckedValueBuilder(storage) -> {
        let { integers, booleans, strings, floats, binding_references, declarations, unary_children } = storage
        let mut next = strings
        let index = dense_index_value(next.push(value))
        (
          CheckedValueBuilder(
            CheckedValueBuilderStorage {
              integers: integers,
              booleans: booleans,
              strings: next,
              floats: floats,
              binding_references: binding_references,
              declarations: declarations,
              unary_children: unary_children
            }
          ),
          index
        )
      }
    }
  }

  fn float(self: owned Self, value: f64) -> (owned CheckedValueBuilder, usize) {
    match self {
      CheckedValueBuilder(storage) -> {
        let { integers, booleans, strings, floats, binding_references, declarations, unary_children } = storage
        let mut next = floats
        let index = dense_index_value(next.push(value))
        (
          CheckedValueBuilder(
            CheckedValueBuilderStorage {
              integers: integers,
              booleans: booleans,
              strings: strings,
              floats: next,
              binding_references: binding_references,
              declarations: declarations,
              unary_children: unary_children
            }
          ),
          index
        )
      }
    }
  }

  fn binding_reference(
    self: owned Self,
    ordinal: usize
  ) -> (owned CheckedValueBuilder, usize) {
    match self {
      CheckedValueBuilder(storage) -> {
        let { integers, booleans, strings, floats, binding_references, declarations, unary_children } = storage
        let mut next = binding_references
        let index = dense_index_value(next.push(ordinal))
        (
          CheckedValueBuilder(
            CheckedValueBuilderStorage {
              integers: integers,
              booleans: booleans,
              strings: strings,
              floats: floats,
              binding_references: next,
              declarations: declarations,
              unary_children: unary_children
            }
          ),
          index
        )
      }
    }
  }

  fn declaration(
    self: owned Self,
    identity: DeclarationIdentity
  ) -> (owned CheckedValueBuilder, usize) {
    match self {
      CheckedValueBuilder(storage) -> {
        let { integers, booleans, strings, floats, binding_references, declarations, unary_children } = storage
        let mut next = declarations
        let index = dense_index_value(next.push(identity))
        (
          CheckedValueBuilder(
            CheckedValueBuilderStorage {
              integers: integers,
              booleans: booleans,
              strings: strings,
              floats: floats,
              binding_references: binding_references,
              declarations: next,
              unary_children: unary_children
            }
          ),
          index
        )
      }
    }
  }

  fn unary(self: owned Self, ordinal: usize) -> (owned CheckedValueBuilder, usize) {
    match self {
      CheckedValueBuilder(storage) -> {
        let { integers, booleans, strings, floats, binding_references, declarations, unary_children } = storage
        let mut next = unary_children
        let index = dense_index_value(next.push(ordinal))
        (
          CheckedValueBuilder(
            CheckedValueBuilderStorage {
              integers: integers,
              booleans: booleans,
              strings: strings,
              floats: floats,
              binding_references: binding_references,
              declarations: declarations,
              unary_children: next
            }
          ),
          index
        )
      }
    }
  }

  fn freeze(self: owned Self) -> CheckedValueColumns {
    match self {
      CheckedValueBuilder(storage) -> {
        let { integers, booleans, strings, floats, binding_references, declarations, unary_children } = storage
        CheckedValueColumns {
          integers: integers.freeze(),
          booleans: booleans.freeze(),
          strings: strings.freeze(),
          floats: floats.freeze(),
          binding_references: binding_references.freeze(),
