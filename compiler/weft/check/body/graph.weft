  pub(package) fn constructor_call(
    self: owned Self,
    declaration: DeclarationIdentity,
    arguments: CheckedExprListId,
    result: SemanticTypeId,
    range: CheckedSourceRange
  ) -> (owned CheckedExprGraphBuilder, CheckedExprId) {
    match self {
      CheckedExprGraphBuilder(storage) -> {
        let { segment, source, types, headers, values, branches, binding_exprs, owners, extras } = storage
        match extras.constructor_call(segment, declaration, arguments) {
