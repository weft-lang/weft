  ) -> (owned CheckedExprGraphBuilder, CheckedExprId) {
    self.unary(CheckedReturnKind, value, result, range)
  }

  pub(package) fn binary(
    self: owned Self,
    operator: CheckedBinaryOperator,
    left: CheckedExprId,
    right: CheckedExprId,
    result: SemanticTypeId,
    range: CheckedSourceRange
  ) -> (owned CheckedExprGraphBuilder, CheckedExprId) {
    match self {
      CheckedExprGraphBuilder(storage) -> {
        let { segment, source, types, headers, values, branches, binding_exprs, owners } = storage
        let left_ordinal = checked_child_ordinal(segment, headers.len(), left)
        let right_ordinal = checked_child_ordinal(segment, headers.len(), right)
        match branches.binary(operator, left_ordinal, right_ordinal) {
          (next_branches, payload) -> checked_expr_finish_node(
            segment,
            source,
            types,
            headers,
            values,
            next_branches,
            binding_exprs,
            owners,
            CheckedBinaryKind,
            payload,
            result,
            range
          )
        }
      }
    }
  }

  fn pair(
    self: owned Self,
    kind: CheckedExprKind,
    left: CheckedExprId,
    right: CheckedExprId,
    result: SemanticTypeId,
    range: CheckedSourceRange
  ) -> (owned CheckedExprGraphBuilder, CheckedExprId) {
    match self {
      CheckedExprGraphBuilder(storage) -> {
        let { segment, source, types, headers, values, branches, binding_exprs, owners } = storage
        let left_ordinal = checked_child_ordinal(segment, headers.len(), left)
        let right_ordinal = checked_child_ordinal(segment, headers.len(), right)
        match branches.pair(left_ordinal, right_ordinal) {
          (next_branches, payload) -> checked_expr_finish_node(
            segment,
            source,
            types,
            headers,
            values,
            next_branches,
            binding_exprs,
            owners,
            kind,
            payload,
            result,
            range
          )
        }
      }
    }
  }

  pub(package) fn block(
    self: owned Self,
    first: CheckedExprId,
    rest: CheckedExprId,
    result: SemanticTypeId,
    range: CheckedSourceRange
  ) -> (owned CheckedExprGraphBuilder, CheckedExprId) {
    self.pair(CheckedBlockKind, first, rest, result, range)
  }

  pub(package) fn while_expr(
    self: owned Self,
    condition: CheckedExprId,
    body: CheckedExprId,
    result: SemanticTypeId,
    range: CheckedSourceRange
  ) -> (owned CheckedExprGraphBuilder, CheckedExprId) {
