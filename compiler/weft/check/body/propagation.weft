-- Immutable failure-propagation and optional-projection details.
--
-- Authored `?` and `?.` syntax does not survive checking. The checked product
-- retains the semantic operation instead: an exact effect atom, an already
-- checked operand/base, and an exact nominal or structural field projection.

use compiler/project/identity.{DeclarationIdentity}
use compiler/types/graph.{
  SemanticTypeId,
  SemanticTypeSegmentId,
  semantic_type_graph_contains,
  semantic_type_id_from_ordinal,
  semantic_type_id_ordinal,
  semantic_type_id_segment,
  semantic_type_segment_id,
  semantic_type_segment_id_eq
}
use compiler/types/graph/catalog.{SemanticTypeCatalog}
use compiler/weft/check/body/graph.{
  CheckedExprGraphBuilder,
  CheckedExprId,
  CheckedExprSegmentId,
  CheckedPropagationExprId,
  CheckedSourceRange,
  checked_expr_id_from_ordinal,
  checked_expr_id_ordinal,
  checked_expr_id_segment,
  checked_expr_segment_id_eq,
  checked_expr_segment_module,
  checked_propagation_expr_id,
  checked_propagation_expr_id_ordinal,
  checked_propagation_expr_id_segment
}
use compiler/weft/check/storage.{
  DenseBuilder,
  DenseIndex,
  DenseSegment,
  dense_builder,
  dense_builder_with_capacity,
  dense_index,
  dense_index_value
}
use stdlib/drop.{Drop}
use stdlib/map as map
use stdlib/map.{Map}
use stdlib/num/scalar.{num_scalar_usize_to_i64}
use stdlib/option.{None, Some}
use stdlib/panic.{panic}

pub(package) type CheckedPropagationExprKind {
  CheckedFailurePropagationDetailKind,
  CheckedDeclaredOptionalProjectionDetailKind,
  CheckedStructuralOptionalProjectionDetailKind
}

pub(package) type CheckedProjection {
  CheckedDeclaredProjection(DeclarationIdentity, usize),
  CheckedStructuralProjection(i64, usize)
}

pub(package) type CheckedFailurePropagation {
  value: CheckedExprId,
  atom: SemanticTypeId,
  operator_range: CheckedSourceRange
}

pub(package) type CheckedOptionalProjection {
  base: CheckedExprId,
  projection: CheckedProjection,
  atom: SemanticTypeId,
  field_range: CheckedSourceRange
}

pub(package) type CheckedPropagationExpr {
  CheckedFailurePropagationDetail(CheckedFailurePropagation),
  CheckedOptionalProjectionDetail(CheckedOptionalProjection)
}

type CheckedPropagationTypeBuilderStorage {
  ordinals: owned DenseBuilder<usize>,
  imported: owned DenseBuilder<bool>,
  segments: Map<i64, SemanticTypeSegmentId>
}

type CheckedPropagationTypeBuilder = opaque CheckedPropagationTypeBuilderStorage

type CheckedPropagationTypeReferences {
  ordinals: DenseSegment<usize>,
  imported: DenseSegment<bool>,
  segments: Map<i64, SemanticTypeSegmentId>
}

type CheckedPropagationHeaderBuilderStorage {
  kinds: owned DenseBuilder<CheckedPropagationExprKind>,
  payloads: owned DenseBuilder<usize>
}

type CheckedPropagationHeaderBuilder = opaque CheckedPropagationHeaderBuilderStorage

type CheckedPropagationHeaders {
  kinds: DenseSegment<CheckedPropagationExprKind>,
  payloads: DenseSegment<usize>
}

type CheckedFailureBuilderStorage {
  values: owned DenseBuilder<usize>,
  atoms: owned CheckedPropagationTypeBuilder,
  starts: owned DenseBuilder<usize>,
  ends: owned DenseBuilder<usize>
}

type CheckedFailureBuilder = opaque CheckedFailureBuilderStorage

type CheckedFailures {
  values: DenseSegment<usize>,
  atoms: CheckedPropagationTypeReferences,
  starts: DenseSegment<usize>,
  ends: DenseSegment<usize>
}

type CheckedDeclaredOptionalBuilderStorage {
  bases: owned DenseBuilder<usize>,
  declarations: owned DenseBuilder<DeclarationIdentity>,
  offsets: owned DenseBuilder<usize>,
  atoms: owned CheckedPropagationTypeBuilder,
  starts: owned DenseBuilder<usize>,
  ends: owned DenseBuilder<usize>
}

type CheckedDeclaredOptionalBuilder = opaque CheckedDeclaredOptionalBuilderStorage

type CheckedDeclaredOptionals {
  bases: DenseSegment<usize>,
  declarations: DenseSegment<DeclarationIdentity>,
  offsets: DenseSegment<usize>,
  atoms: CheckedPropagationTypeReferences,
  starts: DenseSegment<usize>,
  ends: DenseSegment<usize>
}

type CheckedStructuralOptionalBuilderStorage {
  bases: owned DenseBuilder<usize>,
  keys: owned DenseBuilder<i64>,
  offsets: owned DenseBuilder<usize>,
  atoms: owned CheckedPropagationTypeBuilder,
  starts: owned DenseBuilder<usize>,
  ends: owned DenseBuilder<usize>
}

type CheckedStructuralOptionalBuilder = opaque CheckedStructuralOptionalBuilderStorage

type CheckedStructuralOptionals {
  bases: DenseSegment<usize>,
  keys: DenseSegment<i64>,
  offsets: DenseSegment<usize>,
  atoms: CheckedPropagationTypeReferences,
  starts: DenseSegment<usize>,
  ends: DenseSegment<usize>
}

type CheckedPropagationBuilderStorage {
  segment: CheckedExprSegmentId,
  types: SemanticTypeCatalog,
  headers: owned CheckedPropagationHeaderBuilder,
  failures: owned CheckedFailureBuilder,
  declared: owned CheckedDeclaredOptionalBuilder,
  structural: owned CheckedStructuralOptionalBuilder
}

pub(package) type CheckedPropagationBuilder = opaque CheckedPropagationBuilderStorage

type CheckedPropagationGraphStorage {
  segment: CheckedExprSegmentId,
  headers: CheckedPropagationHeaders,
  failures: CheckedFailures,
  declared: CheckedDeclaredOptionals,
  structural: CheckedStructuralOptionals
}

pub(package) type CheckedPropagationGraph = opaque CheckedPropagationGraphStorage

fn propagation_type_key(index: DenseIndex) -> i64 {
  match num_scalar_usize_to_i64(dense_index_value(index)) {
    Some(value) -> value
    None -> panic("Checked propagation type index is not representable")
  }
}

fn propagation_type_builder() -> owned CheckedPropagationTypeBuilder {
  CheckedPropagationTypeBuilder(
    CheckedPropagationTypeBuilderStorage {
      ordinals: dense_builder<usize>(),
      imported: dense_builder<bool>(),
      segments: map.new<i64, SemanticTypeSegmentId>()
    }
  )
}

impl CheckedPropagationTypeBuilder {
  fn push(
    self: owned Self,
    local: SemanticTypeSegmentId,
    reference: SemanticTypeId
  ) -> (owned CheckedPropagationTypeBuilder, DenseIndex) {
    match self {
      CheckedPropagationTypeBuilder(storage) -> {
        let { ordinals, imported, segments } = storage
        let mut next_ordinals = ordinals
        let mut next_imported = imported
        let index = next_ordinals.push(semantic_type_id_ordinal(reference))
        let foreign = not semantic_type_segment_id_eq(
          local,
          semantic_type_id_segment(reference)
        )
        if dense_index_value(next_imported.push(foreign)) != dense_index_value(index) {
          panic("Checked propagation type columns diverged")
        } else { nil }
        let next_segments = if foreign {
          segments.insert(propagation_type_key(index), semantic_type_id_segment(reference))
        } else { segments }
        (
          CheckedPropagationTypeBuilder(
            CheckedPropagationTypeBuilderStorage {
              ordinals: next_ordinals,
              imported: next_imported,
              segments: next_segments
            }
          ),
          index
        )
      }
    }
  }

  fn freeze(self: owned Self) -> CheckedPropagationTypeReferences {
    match self {
      CheckedPropagationTypeBuilder(storage) -> {
        let { ordinals, imported, segments } = storage
        CheckedPropagationTypeReferences {
          ordinals: ordinals.freeze(),
          imported: imported.freeze(),
          segments: segments
        }
      }
    }
  }
}

impl Drop for CheckedPropagationTypeBuilder {
  fn drop(self) -> nil {
    match self {
      CheckedPropagationTypeBuilder(storage) -> {
        let { ordinals, imported, segments: _ } = storage
        ordinals.drop()
        imported.drop()
      }
    }
  }
}

fn propagation_type_at(
  references: borrow CheckedPropagationTypeReferences,
  local: SemanticTypeSegmentId,
  index: DenseIndex
) -> SemanticTypeId {
  let { ordinals, imported, segments } = references
  let segment = if imported.at(index) {
    match segments.get(propagation_type_key(index)) {
      Some(value) -> value
      None -> panic("Checked propagation type is missing its imported segment")
    }
  } else { local }
  semantic_type_id_from_ordinal(segment, ordinals.at(index))
}

fn checked_propagation_type(types: borrow SemanticTypeCatalog, value: SemanticTypeId) -> nil {
  match types.graph_for(value) {
    Some(graph) -> if semantic_type_graph_contains(graph, value) { nil }
    else { panic("Checked propagation type is outside its semantic graph") }
    None -> panic("Checked propagation type is outside its semantic catalog")
  }
}

fn same_segment(expected: CheckedExprSegmentId, found: CheckedExprSegmentId) -> nil {
  if checked_expr_segment_id_eq(expected, found) { nil }
  else { panic("Checked propagation value belongs to another module segment") }
}

fn checked_child(
  expressions: borrow CheckedExprGraphBuilder,
  segment: CheckedExprSegmentId,
  value: CheckedExprId
) -> usize {
  same_segment(segment, checked_expr_id_segment(value))
  let ordinal = checked_expr_id_ordinal(value)
  if ordinal >= expressions.len() { panic("Checked propagation child is not published") }
  else { ordinal }
}

fn propagation_header_builder(capacity: usize) -> owned CheckedPropagationHeaderBuilder {
  CheckedPropagationHeaderBuilder(
    CheckedPropagationHeaderBuilderStorage {
      kinds: dense_builder_with_capacity<CheckedPropagationExprKind>(capacity),
      payloads: dense_builder_with_capacity<usize>(capacity)
    }
  )
}

impl CheckedPropagationHeaderBuilder {
  fn len(self: borrow Self) -> usize {
    match self {
      CheckedPropagationHeaderBuilder(storage) -> {
        let { kinds, payloads: _ } = storage
        kinds.len()
      }
    }
  }

  fn push(
    self: owned Self,
    segment: CheckedExprSegmentId,
    kind: CheckedPropagationExprKind,
    payload: usize
  ) -> (owned CheckedPropagationHeaderBuilder, CheckedPropagationExprId) {
    match self {
      CheckedPropagationHeaderBuilder(storage) -> {
        let { kinds, payloads } = storage
        let mut next_kinds = kinds
        let mut next_payloads = payloads
        let index = next_kinds.push(kind)
        if dense_index_value(next_payloads.push(payload)) != dense_index_value(index) {
          panic("Checked propagation header columns diverged")
        } else {
          (
            CheckedPropagationHeaderBuilder(
              CheckedPropagationHeaderBuilderStorage {
                kinds: next_kinds,
                payloads: next_payloads
              }
            ),
            checked_propagation_expr_id(segment, dense_index_value(index))
          )
        }
      }
    }
  }

  fn freeze(self: owned Self) -> CheckedPropagationHeaders {
    match self {
      CheckedPropagationHeaderBuilder(storage) -> {
        let { kinds, payloads } = storage
        CheckedPropagationHeaders { kinds: kinds.freeze(), payloads: payloads.freeze() }
      }
    }
  }
}

impl Drop for CheckedPropagationHeaderBuilder {
  fn drop(self) -> nil {
    match self {
      CheckedPropagationHeaderBuilder(storage) -> {
        let { kinds, payloads } = storage
        kinds.drop()
        payloads.drop()
      }
    }
  }
}

fn failure_builder() -> owned CheckedFailureBuilder {
  CheckedFailureBuilder(
    CheckedFailureBuilderStorage {
      values: dense_builder<usize>(),
      atoms: propagation_type_builder(),
      starts: dense_builder<usize>(),
      ends: dense_builder<usize>()
    }
  )
}

impl CheckedFailureBuilder {
  fn push(
    self: owned Self,
    local: SemanticTypeSegmentId,
    value: usize,
    atom: SemanticTypeId,
    range: CheckedSourceRange
  ) -> (owned CheckedFailureBuilder, usize) {
    match self {
      CheckedFailureBuilder(storage) -> {
        let { values, atoms, starts, ends } = storage
        let mut next_values = values
        let mut next_starts = starts
        let mut next_ends = ends
        let index = next_values.push(value)
        let ordinal = dense_index_value(index)
        match atoms.push(local, atom) {
          (next_atoms, atom_index) -> if dense_index_value(atom_index) != ordinal or
            dense_index_value(next_starts.push(range.start)) != ordinal or
            dense_index_value(next_ends.push(range.end)) != ordinal {
              panic("Checked failure propagation columns diverged")
            } else {
              (
                CheckedFailureBuilder(
                  CheckedFailureBuilderStorage {
                    values: next_values,
                    atoms: next_atoms,
                    starts: next_starts,
                    ends: next_ends
                  }
                ),
                ordinal
              )
            }
        }
      }
    }
  }

  fn freeze(self: owned Self) -> CheckedFailures {
    match self {
      CheckedFailureBuilder(storage) -> {
        let { values, atoms, starts, ends } = storage
        CheckedFailures {
          values: values.freeze(),
          atoms: atoms.freeze(),
          starts: starts.freeze(),
          ends: ends.freeze()
        }
      }
    }
  }
}

impl Drop for CheckedFailureBuilder {
  fn drop(self) -> nil {
    match self {
      CheckedFailureBuilder(storage) -> {
        let { values, atoms, starts, ends } = storage
        values.drop()
        atoms.drop()
        starts.drop()
        ends.drop()
      }
    }
  }
}

fn declared_optional_builder() -> owned CheckedDeclaredOptionalBuilder {
  CheckedDeclaredOptionalBuilder(
    CheckedDeclaredOptionalBuilderStorage {
      bases: dense_builder<usize>(),
      declarations: dense_builder<DeclarationIdentity>(),
      offsets: dense_builder<usize>(),
      atoms: propagation_type_builder(),
      starts: dense_builder<usize>(),
      ends: dense_builder<usize>()
    }
  )
}

impl CheckedDeclaredOptionalBuilder {
  fn push(
    self: owned Self,
    local: SemanticTypeSegmentId,
    base: usize,
    declaration: DeclarationIdentity,
    offset: usize,
    atom: SemanticTypeId,
    range: CheckedSourceRange
  ) -> (owned CheckedDeclaredOptionalBuilder, usize) {
    match self {
      CheckedDeclaredOptionalBuilder(storage) -> {
        let { bases, declarations, offsets, atoms, starts, ends } = storage
        let mut next_bases = bases
        let mut next_declarations = declarations
        let mut next_offsets = offsets
        let mut next_starts = starts
        let mut next_ends = ends
        let index = next_bases.push(base)
        let ordinal = dense_index_value(index)
        match atoms.push(local, atom) {
          (next_atoms, atom_index) -> if dense_index_value(
            next_declarations.push(declaration)
          ) != ordinal or
            dense_index_value(next_offsets.push(offset)) != ordinal or
            dense_index_value(atom_index) != ordinal or
            dense_index_value(next_starts.push(range.start)) != ordinal or
            dense_index_value(next_ends.push(range.end)) != ordinal {
              panic("Checked declared optional projection columns diverged")
            } else {
              (
                CheckedDeclaredOptionalBuilder(
                  CheckedDeclaredOptionalBuilderStorage {
                    bases: next_bases,
                    declarations: next_declarations,
                    offsets: next_offsets,
                    atoms: next_atoms,
                    starts: next_starts,
                    ends: next_ends
                  }
                ),
                ordinal
              )
            }
        }
      }
    }
  }

  fn freeze(self: owned Self) -> CheckedDeclaredOptionals {
    match self {
      CheckedDeclaredOptionalBuilder(storage) -> {
        let { bases, declarations, offsets, atoms, starts, ends } = storage
        CheckedDeclaredOptionals {
          bases: bases.freeze(),
          declarations: declarations.freeze(),
          offsets: offsets.freeze(),
          atoms: atoms.freeze(),
          starts: starts.freeze(),
          ends: ends.freeze()
        }
      }
    }
  }
}

impl Drop for CheckedDeclaredOptionalBuilder {
  fn drop(self) -> nil {
    match self {
      CheckedDeclaredOptionalBuilder(storage) -> {
        let { bases, declarations, offsets, atoms, starts, ends } = storage
        bases.drop()
        declarations.drop()
        offsets.drop()
        atoms.drop()
        starts.drop()
        ends.drop()
      }
    }
  }
}

fn structural_optional_builder() -> owned CheckedStructuralOptionalBuilder {
  CheckedStructuralOptionalBuilder(
    CheckedStructuralOptionalBuilderStorage {
      bases: dense_builder<usize>(),
      keys: dense_builder<i64>(),
      offsets: dense_builder<usize>(),
      atoms: propagation_type_builder(),
      starts: dense_builder<usize>(),
      ends: dense_builder<usize>()
    }
  )
}

impl CheckedStructuralOptionalBuilder {
  fn push(
    self: owned Self,
    local: SemanticTypeSegmentId,
    base: usize,
    key: i64,
    offset: usize,
    atom: SemanticTypeId,
    range: CheckedSourceRange
  ) -> (owned CheckedStructuralOptionalBuilder, usize) {
    match self {
      CheckedStructuralOptionalBuilder(storage) -> {
        let { bases, keys, offsets, atoms, starts, ends } = storage
        let mut next_bases = bases
        let mut next_keys = keys
        let mut next_offsets = offsets
        let mut next_starts = starts
        let mut next_ends = ends
        let index = next_bases.push(base)
        let ordinal = dense_index_value(index)
        match atoms.push(local, atom) {
          (next_atoms, atom_index) -> if dense_index_value(next_keys.push(key)) != ordinal or
            dense_index_value(next_offsets.push(offset)) != ordinal or
            dense_index_value(atom_index) != ordinal or
            dense_index_value(next_starts.push(range.start)) != ordinal or
            dense_index_value(next_ends.push(range.end)) != ordinal {
              panic("Checked structural optional projection columns diverged")
            } else {
              (
                CheckedStructuralOptionalBuilder(
                  CheckedStructuralOptionalBuilderStorage {
                    bases: next_bases,
                    keys: next_keys,
                    offsets: next_offsets,
                    atoms: next_atoms,
                    starts: next_starts,
                    ends: next_ends
                  }
                ),
                ordinal
              )
            }
        }
      }
    }
  }

  fn freeze(self: owned Self) -> CheckedStructuralOptionals {
    match self {
      CheckedStructuralOptionalBuilder(storage) -> {
        let { bases, keys, offsets, atoms, starts, ends } = storage
        CheckedStructuralOptionals {
          bases: bases.freeze(),
          keys: keys.freeze(),
          offsets: offsets.freeze(),
          atoms: atoms.freeze(),
          starts: starts.freeze(),
          ends: ends.freeze()
        }
      }
    }
  }
}

impl Drop for CheckedStructuralOptionalBuilder {
  fn drop(self) -> nil {
    match self {
      CheckedStructuralOptionalBuilder(storage) -> {
        let { bases, keys, offsets, atoms, starts, ends } = storage
        bases.drop()
        keys.drop()
        offsets.drop()
        atoms.drop()
        starts.drop()
        ends.drop()
      }
    }
  }
}

pub(package) fn checked_propagation_builder(
  expressions: borrow CheckedExprGraphBuilder,
  capacity: usize
) -> owned CheckedPropagationBuilder {
  CheckedPropagationBuilder(
    CheckedPropagationBuilderStorage {
      segment: expressions.segment(),
      types: expressions.types(),
      headers: propagation_header_builder(capacity),
      failures: failure_builder(),
      declared: declared_optional_builder(),
      structural: structural_optional_builder()
    }
  )
}

impl CheckedPropagationBuilder {
  pub(package) fn segment(self: borrow Self) -> CheckedExprSegmentId {
    match self { CheckedPropagationBuilder(storage) -> storage.segment }
  }

  pub(package) fn with_types(
    self: owned Self,
    types: SemanticTypeCatalog
  ) -> owned CheckedPropagationBuilder {
    match self {
      CheckedPropagationBuilder(storage) -> {
        let { segment, types: _, headers, failures, declared, structural } = storage
        CheckedPropagationBuilder(
          CheckedPropagationBuilderStorage {
            segment: segment,
            types: types,
            headers: headers,
            failures: failures,
            declared: declared,
            structural: structural
          }
        )
      }
    }
  }

  pub(package) fn len(self: borrow Self) -> usize {
    match self {
      CheckedPropagationBuilder(storage) -> {
        let { segment: _, types: _, headers, failures: _, declared: _, structural: _ } = storage
        headers.len()
      }
    }
  }

  pub(package) fn failure(
    self: owned Self,
    expressions: borrow CheckedExprGraphBuilder,
    value: CheckedFailurePropagation
  ) -> (owned CheckedPropagationBuilder, CheckedPropagationExprId) {
    match self {
      CheckedPropagationBuilder(storage) -> {
        let { segment, types, headers, failures, declared, structural } = storage
        let { value: expression, atom, operator_range } = value
        checked_propagation_type(types, atom)
        let child = checked_child(expressions, segment, expression)
        let local = semantic_type_segment_id(checked_expr_segment_module(segment))
        match failures.push(local, child, atom, operator_range) {
          (next_failures, payload) -> match headers.push(
            segment,
            CheckedFailurePropagationDetailKind,
            payload
          ) {
            (next_headers, id) -> (
              CheckedPropagationBuilder(
                CheckedPropagationBuilderStorage {
                  segment: segment,
                  types: types,
                  headers: next_headers,
                  failures: next_failures,
                  declared: declared,
                  structural: structural
                }
              ),
              id
            )
          }
        }
      }
    }
  }

  pub(package) fn declared_optional_projection(
    self: owned Self,
    expressions: borrow CheckedExprGraphBuilder,
    value: CheckedOptionalProjection
  ) -> (owned CheckedPropagationBuilder, CheckedPropagationExprId) {
    let { base: base_expression, projection, atom, field_range } = value
    match projection {
      CheckedDeclaredProjection(declaration, offset) -> match self {
        CheckedPropagationBuilder(storage) -> {
          let { segment, types, headers, failures, declared, structural } = storage
          checked_propagation_type(types, atom)
          let base = checked_child(expressions, segment, base_expression)
          let local = semantic_type_segment_id(checked_expr_segment_module(segment))
          match declared.push(
            local,
            base,
            declaration,
            offset,
            atom,
            field_range
          ) {
            (next_declared, payload) -> match headers.push(
              segment,
              CheckedDeclaredOptionalProjectionDetailKind,
              payload
            ) {
              (next_headers, id) -> (
                CheckedPropagationBuilder(
                  CheckedPropagationBuilderStorage {
                    segment: segment,
                    types: types,
                    headers: next_headers,
                    failures: failures,
                    declared: next_declared,
                    structural: structural
                  }
                ),
                id
              )
            }
          }
        }
      }
      _ -> panic("Declared optional projection requires a declaration")
    }
  }

  pub(package) fn structural_optional_projection(
    self: owned Self,
    expressions: borrow CheckedExprGraphBuilder,
    value: CheckedOptionalProjection
  ) -> (owned CheckedPropagationBuilder, CheckedPropagationExprId) {
    let { base: base_expression, projection, atom, field_range } = value
    match projection {
      CheckedStructuralProjection(key, offset) -> match self {
        CheckedPropagationBuilder(storage) -> {
          let { segment, types, headers, failures, declared, structural } = storage
          checked_propagation_type(types, atom)
          let base = checked_child(expressions, segment, base_expression)
          let local = semantic_type_segment_id(checked_expr_segment_module(segment))
          match structural.push(local, base, key, offset, atom, field_range) {
            (next_structural, payload) -> match headers.push(
              segment,
              CheckedStructuralOptionalProjectionDetailKind,
              payload
            ) {
              (next_headers, id) -> (
                CheckedPropagationBuilder(
                  CheckedPropagationBuilderStorage {
                    segment: segment,
                    types: types,
                    headers: next_headers,
                    failures: failures,
                    declared: declared,
                    structural: next_structural
                  }
                ),
                id
              )
            }
          }
        }
      }
      _ -> panic("Structural optional projection requires a stable key")
    }
  }

  pub(package) fn freeze(self: owned Self) -> CheckedPropagationGraph {
    match self {
      CheckedPropagationBuilder(storage) -> {
        let { segment, types: _, headers, failures, declared, structural } = storage
        CheckedPropagationGraph(
          CheckedPropagationGraphStorage {
            segment: segment,
            headers: headers.freeze(),
            failures: failures.freeze(),
            declared: declared.freeze(),
            structural: structural.freeze()
          }
        )
      }
    }
  }
}

impl CheckedPropagationGraph {
  pub(package) fn segment(self: borrow Self) -> CheckedExprSegmentId {
    match self { CheckedPropagationGraph(storage) -> storage.segment }
  }

  pub(package) fn len(self: borrow Self) -> usize {
    match self {
      CheckedPropagationGraph(storage) -> {
        let { segment: _, headers, failures: _, declared: _, structural: _ } = storage
        let { kinds, payloads: _ } = headers
        kinds.len()
      }
    }
  }

  pub(package) fn contains(self: borrow Self, id: CheckedPropagationExprId) -> bool {
    checked_expr_segment_id_eq(
      self.segment(),
      checked_propagation_expr_id_segment(id)
    ) and checked_propagation_expr_id_ordinal(id) < self.len()
  }

  fn index(self: borrow Self, id: CheckedPropagationExprId) -> DenseIndex {
    same_segment(self.segment(), checked_propagation_expr_id_segment(id))
    let ordinal = checked_propagation_expr_id_ordinal(id)
    if ordinal >= self.len() { panic("Checked propagation identity is out of bounds") }
    else { dense_index(ordinal) }
  }

  pub(package) fn kind(
    self: borrow Self,
    id: CheckedPropagationExprId
  ) -> CheckedPropagationExprKind {
    let index = self.index(id)
    match self {
      CheckedPropagationGraph(storage) -> {
        let { segment: _, headers, failures: _, declared: _, structural: _ } = storage
        let { kinds, payloads: _ } = headers
        kinds.at(index)
      }
    }
  }

  fn payload(self: borrow Self, id: CheckedPropagationExprId) -> DenseIndex {
    let index = self.index(id)
    match self {
      CheckedPropagationGraph(storage) -> {
        let { segment: _, headers, failures: _, declared: _, structural: _ } = storage
        let { kinds: _, payloads } = headers
        dense_index(payloads.at(index))
      }
    }
  }

  pub(package) fn failure(
    self: borrow Self,
    id: CheckedPropagationExprId
  ) -> CheckedFailurePropagation {
    match self.kind(id) {
      CheckedFailurePropagationDetailKind -> {
        let index = self.payload(id)
        match self {
          CheckedPropagationGraph(storage) -> {
            let { segment, headers: _, failures, declared: _, structural: _ } = storage
            let { values, atoms, starts, ends } = failures
            let local = semantic_type_segment_id(checked_expr_segment_module(segment))
            CheckedFailurePropagation {
              value: checked_expr_id_from_ordinal(segment, values.at(index)),
              atom: propagation_type_at(atoms, local, index),
              operator_range: CheckedSourceRange {
                start: starts.at(index),
                end: ends.at(index)
              }
            }
          }
        }
      }
      _ -> panic("Checked propagation detail is not failure propagation")
    }
  }

  pub(package) fn optional_projection(
    self: borrow Self,
    id: CheckedPropagationExprId
  ) -> CheckedOptionalProjection {
    let kind = self.kind(id)
    let index = self.payload(id)
    match self {
      CheckedPropagationGraph(storage) -> {
        let { segment, headers: _, failures: _, declared, structural } = storage
        let local = semantic_type_segment_id(checked_expr_segment_module(segment))
        match kind {
          CheckedDeclaredOptionalProjectionDetailKind -> {
            let { bases, declarations, offsets, atoms, starts, ends } = declared
            CheckedOptionalProjection {
              base: checked_expr_id_from_ordinal(segment, bases.at(index)),
              projection: CheckedDeclaredProjection(
                declarations.at(index),
                offsets.at(index)
              ),
              atom: propagation_type_at(atoms, local, index),
              field_range: CheckedSourceRange {
                start: starts.at(index),
                end: ends.at(index)
              }
            }
          }
          CheckedStructuralOptionalProjectionDetailKind -> {
            let { bases, keys, offsets, atoms, starts, ends } = structural
            CheckedOptionalProjection {
              base: checked_expr_id_from_ordinal(segment, bases.at(index)),
              projection: CheckedStructuralProjection(
                keys.at(index),
                offsets.at(index)
              ),
              atom: propagation_type_at(atoms, local, index),
              field_range: CheckedSourceRange {
                start: starts.at(index),
                end: ends.at(index)
              }
            }
          }
          _ -> panic("Checked propagation detail is not optional projection")
        }
      }
    }
  }

  pub(package) fn inspect(
    self: borrow Self,
    id: CheckedPropagationExprId
  ) -> CheckedPropagationExpr {
    match self.kind(id) {
      CheckedFailurePropagationDetailKind -> CheckedFailurePropagationDetail(self.failure(id))
      CheckedDeclaredOptionalProjectionDetailKind -> CheckedOptionalProjectionDetail(
        self.optional_projection(id)
      )
      CheckedStructuralOptionalProjectionDetailKind -> CheckedOptionalProjectionDetail(
        self.optional_projection(id)
      )
    }
  }
}

impl Drop for CheckedPropagationBuilder {
  fn drop(self) -> nil {
    match self {
      CheckedPropagationBuilder(storage) -> {
        let { segment: _, types: _, headers, failures, declared, structural } = storage
        headers.drop()
        failures.drop()
        declared.drop()
        structural.drop()
      }
    }
  }
}
