-- Associated-type interpretation for registered declarations.
-- Authored syntax is retained unchanged; these transforms own checker storage.

use compiler/storage.{*}
use compiler/types/algebra.{*}
use compiler/weft/check/table.{*}
use runtime/memory.{*}

-- Resolve signature Self in host-owned nodes; method bodies are unchanged.
pub(package) fn substitute_self(fn_wrap: i64, self_ty: i64) -> i64 {
  let subst = subst_new()
  subst_add(subst, - 1, self_ty)
  let inner = node_f1(fn_wrap)
  let old_params = node_f3(inner)
  let params = nlist_new()
  for i in 0..nlist_len(old_params) {
    let param = nlist_get(old_params, i)
    nlist_add(
      params,
      node_new(
        node_tag(param),
        node_f1(param),
        node_f2(param),
        ty_subst(node_f3(param), subst),
        node_f4(param)
      )
    )
  }
  let new_inner = node_new(
    node_tag(inner),
    node_f1(inner),
    node_f2(inner),
    params,
    node_f4(inner)
  )
  node_new(
    node_tag(fn_wrap),
    new_inner,
    ty_subst(node_f2(fn_wrap), subst),
    ty_subst(node_f3(fn_wrap), subst),
    node_f4(fn_wrap)
  )
}

fn assoc_member_hash(member: i64, src: i64) -> i64 {
  effect_name_hash(src, node_f1(member), node_f2(member))
}

fn assoc_name_declared(members: i64, src: i64, name_hash: i64) -> bool {
  let mut found = false
  let mut i = 0
  while i < nlist_len(members) and not found {
    let member = nlist_get(members, i)
    let tag = node_tag(member)
    if (tag == 42 or tag == 43) and assoc_member_hash(member, src) == name_hash {
      found = true
    } else { i = i + 1 }
  }
  found
}

fn assoc_binding_type(members: i64, src: i64, name_hash: i64) -> i64 {
  let mut result = 0
  let mut i = 0
  while i < nlist_len(members) and result == 0 {
    let member = nlist_get(members, i)
    if node_tag(member) == 43 and assoc_member_hash(member, src) == name_hash {
      result = node_f3(member)
    } else { i = i + 1 }
  }
  result
}

fn assoc_binding_member(members: i64, src: i64, name_hash: i64) -> i64 {
  let mut result = 0
  let mut i = 0
  while i < nlist_len(members) and result == 0 {
    let member = nlist_get(members, i)
    if node_tag(member) == 43 and assoc_member_hash(member, src) == name_hash {
      result = member
    } else { i = i + 1 }
  }
  result
}

fn assoc_record_type_list_facts(
  types: i64,
  members: i64,
  src: i64,
  self_ty: i64,
  tparams: i64,
  tt: i64
) -> i64 {
  if types != 0 {
    for i in 0..nlist_len(types) {
      assoc_record_type_facts(nlist_get(types, i), members, src, self_ty, tparams, tt)
    }
  } else { 0 }
  0
}

fn assoc_record_type_facts(
  ty: i64,
  members: i64,
  src: i64,
  self_ty: i64,
  tparams: i64,
  tt: i64
) -> i64 {
  if ty == 0 { 0 }
  else {
    let tag = ty_tag(ty)
    if tag == 21 {
      let start = ty_assoc_source_start(ty)
      let len = ty_assoc_source_len(ty)
      let binding = assoc_binding_member(members, src, ty_f2(ty))
      if len > 0 and binding != 0 {
        ttable_add_semantic_symbol_fact(
          tt,
          src,
          start,
          len,
          src,
          node_f1(binding),
          node_f2(binding),
          assoc_resolve_type(ty, members, src, self_ty),
          tparams,
          semantic_symbol_kind_associated_type(),
          0,
          ty
        )
      } else { 0 }
      assoc_record_type_facts(ty_f1(ty), members, src, self_ty, tparams, tt)
    } else if tag == 3 or tag == 4 or tag == 14 {
      assoc_record_type_facts(ty_f1(ty), members, src, self_ty, tparams, tt)
      assoc_record_type_facts(ty_f2(ty), members, src, self_ty, tparams, tt)
    } else if tag == 5 or tag == 15 or tag == 16 or tag == 17 or tag == 18 or tag == 19 or
      tag == 22 or tag == 23 {
        assoc_record_type_facts(ty_f1(ty), members, src, self_ty, tparams, tt)
      } else if tag == 6 {
        assoc_record_type_list_facts(ty_f1(ty), members, src, self_ty, tparams, tt)
        assoc_record_type_facts(ty_f2(ty), members, src, self_ty, tparams, tt)
        assoc_record_type_facts(ty_f3(ty), members, src, self_ty, tparams, tt)
      } else if tag == 7 {
        let fields = ty_record_fields(ty)
        for i in 0..nlist_len(fields) {
          assoc_record_type_facts(
            ty_record_field_type(nlist_get(fields, i)),
            members,
            src,
            self_ty,
            tparams,
            tt
          )
        }
      } else if tag == 9 {
        assoc_record_type_facts(ty_f2(ty), members, src, self_ty, tparams, tt)
        assoc_record_type_list_facts(ty_f3(ty), members, src, self_ty, tparams, tt)
      } else if tag == 10 or tag == 11 {
        assoc_record_type_list_facts(
          if tag == 10 { ty_f1(ty) } else { ty_f2(ty) },
          members,
          src,
          self_ty,
          tparams,
          tt
        )
      } else { 0 }
    0
  }
}

fn assoc_mark_list(types: i64, members: i64, src: i64, self_ty: i64) -> i64 {
  if types == 0 { 0 }
  else {
    let result = nlist_new()
    for i in 0..nlist_len(types) {
      nlist_add(result, assoc_mark_type(nlist_get(types, i), members, src, self_ty))
    }
    result
  }
}

fn assoc_mark_record_fields(fields: i64, members: i64, src: i64, self_ty: i64) -> i64
{
  let result = nlist_new()
  if fields != 0 {
    for i in 0..nlist_len(fields) {
      let field = nlist_get(fields, i)
      nlist_add(
        result,
        ty_record_field(
          ty_record_field_hash(field),
          assoc_mark_type(ty_record_field_type(field), members, src, self_ty),
          ty_record_field_name_start(field),
          ty_record_field_name_len(field)
        )
      )
    }
  } else { 0 }
  result
}

-- Within a trait/impl signature, an unqualified declared associated name is
-- contextual syntax for Self.Name. Explicit Self.Name already has tag 21.
fn assoc_mark_type(ty: i64, members: i64, src: i64, self_ty: i64) -> i64 {
  if ty == 0 { 0 }
  else {
    match ty_tag(ty) {
      3 -> ty_union(
        assoc_mark_type(ty_f1(ty), members, src, self_ty),
        assoc_mark_type(ty_f2(ty), members, src, self_ty)
      )
      4 -> ty_inter(
        assoc_mark_type(ty_f1(ty), members, src, self_ty),
        assoc_mark_type(ty_f2(ty), members, src, self_ty)
      )
      5 -> ty_compl(assoc_mark_type(ty_f1(ty), members, src, self_ty))
      6 -> ty_fn(
        assoc_mark_list(ty_f1(ty), members, src, self_ty),
        assoc_mark_type(ty_f2(ty), members, src, self_ty),
        assoc_mark_type(ty_f3(ty), members, src, self_ty)
      )
      7 -> ty_record_with_kind(
        assoc_mark_record_fields(ty_record_fields(ty), members, src, self_ty),
        ty_record_open(ty),
        ty_record_tuple_kind(ty)
      )
      9 -> {
        if ty_f3(ty) == 0 and assoc_name_declared(members, src, ty_f1(ty)) {
          ty_assoc(self_ty, ty_f1(ty))
        } else {
          ty_named_with_metadata(
            ty_f1(ty),
            assoc_mark_type(ty_f2(ty), members, src, self_ty),
            assoc_mark_list(ty_f3(ty), members, src, self_ty),
            ty_f4(ty)
          )
        }
      }
      10 -> ty_effect_sig_with_tail(assoc_mark_list(ty_f1(ty), members, src, self_ty), ty_f2(ty))
      11 -> ty_surface_effect_app(
        ty_f1(ty),
        assoc_mark_list(ty_f2(ty), members, src, self_ty),
        ty_f3(ty),
        ty_f4(ty)
      )
      25 -> ty_qualified_effect_app(ty_f1(ty), assoc_mark_list(ty_f2(ty), members, src, self_ty))
      14 -> ty_continuation(
        assoc_mark_type(ty_f1(ty), members, src, self_ty),
        assoc_mark_type(ty_f2(ty), members, src, self_ty)
      )
      15 -> ty_ptr_with_mut(assoc_mark_type(ty_f1(ty), members, src, self_ty), ty_f2(ty))
      16 -> ty_weak(assoc_mark_type(ty_f1(ty), members, src, self_ty))
      17 -> ty_arc(assoc_mark_type(ty_f1(ty), members, src, self_ty))
      18 -> ty_unique(assoc_mark_type(ty_f1(ty), members, src, self_ty))
      19 -> ty_owned(assoc_mark_type(ty_f1(ty), members, src, self_ty))
      29 -> ty_borrow_with_mut(assoc_mark_type(ty_f1(ty), members, src, self_ty), ty_f2(ty))
      21 -> ty_assoc_at(
        assoc_mark_type(ty_f1(ty), members, src, self_ty),
        ty_f2(ty),
        ty_assoc_source_start(ty),
        ty_assoc_source_len(ty)
      )
      22 -> ty_array(assoc_mark_type(ty_f1(ty), members, src, self_ty), ty_f2(ty))
      23 -> ty_slice_with_mut(assoc_mark_type(ty_f1(ty), members, src, self_ty), ty_f2(ty))
      _ -> ty
    }
  }
}

fn assoc_resolve_list(
  types: i64,
  members: i64,
  src: i64,
  self_ty: i64,
  depth: i64
) -> i64 {
  if types == 0 { 0 }
  else {
    let result = nlist_new()
    for i in 0..nlist_len(types) {
      nlist_add(
        result,
        assoc_resolve_type_depth(nlist_get(types, i), members, src, self_ty, depth)
      )
    }
    result
  }
}

fn assoc_resolve_record_fields(
  fields: i64,
  members: i64,
  src: i64,
  self_ty: i64,
  depth: i64
) -> i64 {
  let result = nlist_new()
  if fields != 0 {
    for i in 0..nlist_len(fields) {
      let field = nlist_get(fields, i)
      nlist_add(
        result,
        ty_record_field(
          ty_record_field_hash(field),
          assoc_resolve_type_depth(ty_record_field_type(field), members, src, self_ty, depth),
          ty_record_field_name_start(field),
          ty_record_field_name_len(field)
        )
      )
    }
  } else { 0 }
  result
}

fn assoc_resolve_type_depth(
  ty: i64,
  members: i64,
  src: i64,
  self_ty: i64,
  depth: i64
) -> i64 {
  if ty == 0 or depth > 16 { ty }
  else {
    match ty_tag(ty) {
      3 -> ty_union(
        assoc_resolve_type_depth(ty_f1(ty), members, src, self_ty, depth),
        assoc_resolve_type_depth(ty_f2(ty), members, src, self_ty, depth)
      )
      4 -> ty_inter(
        assoc_resolve_type_depth(ty_f1(ty), members, src, self_ty, depth),
        assoc_resolve_type_depth(ty_f2(ty), members, src, self_ty, depth)
      )
      5 -> ty_compl(assoc_resolve_type_depth(ty_f1(ty), members, src, self_ty, depth))
      6 -> ty_fn(
        assoc_resolve_list(ty_f1(ty), members, src, self_ty, depth),
        assoc_resolve_type_depth(ty_f2(ty), members, src, self_ty, depth),
        assoc_resolve_type_depth(ty_f3(ty), members, src, self_ty, depth)
      )
      7 -> ty_record_with_kind(
        assoc_resolve_record_fields(ty_record_fields(ty), members, src, self_ty, depth),
        ty_record_open(ty),
        ty_record_tuple_kind(ty)
      )
      9 -> ty_named_with_metadata(
        ty_f1(ty),
        assoc_resolve_type_depth(ty_f2(ty), members, src, self_ty, depth),
        assoc_resolve_list(ty_f3(ty), members, src, self_ty, depth),
        ty_f4(ty)
      )
      10 -> ty_effect_sig_with_tail(
        assoc_resolve_list(ty_f1(ty), members, src, self_ty, depth),
        ty_f2(ty)
      )
      11 -> ty_surface_effect_app(
        ty_f1(ty),
        assoc_resolve_list(ty_f2(ty), members, src, self_ty, depth),
        ty_f3(ty),
        ty_f4(ty)
      )
      25 -> ty_qualified_effect_app(
        ty_f1(ty),
        assoc_resolve_list(ty_f2(ty), members, src, self_ty, depth)
      )
      14 -> ty_continuation(
        assoc_resolve_type_depth(ty_f1(ty), members, src, self_ty, depth),
        assoc_resolve_type_depth(ty_f2(ty), members, src, self_ty, depth)
      )
      15 -> ty_ptr_with_mut(
        assoc_resolve_type_depth(ty_f1(ty), members, src, self_ty, depth),
        ty_f2(ty)
      )
      16 -> ty_weak(assoc_resolve_type_depth(ty_f1(ty), members, src, self_ty, depth))
      17 -> ty_arc(assoc_resolve_type_depth(ty_f1(ty), members, src, self_ty, depth))
      18 -> ty_unique(assoc_resolve_type_depth(ty_f1(ty), members, src, self_ty, depth))
      19 -> ty_owned(assoc_resolve_type_depth(ty_f1(ty), members, src, self_ty, depth))
      29 -> ty_borrow_with_mut(
        assoc_resolve_type_depth(ty_f1(ty), members, src, self_ty, depth),
        ty_f2(ty)
      )
      22 -> ty_array(assoc_resolve_type_depth(ty_f1(ty), members, src, self_ty, depth), ty_f2(ty))
      23 -> ty_slice_with_mut(
        assoc_resolve_type_depth(ty_f1(ty), members, src, self_ty, depth),
        ty_f2(ty)
      )
      21 -> {
        let base = assoc_resolve_type_depth(ty_f1(ty), members, src, self_ty, depth)
        let binding = if ty_eq(base, self_ty) { assoc_binding_type(members, src, ty_f2(ty)) } else {
          0
        }
        if binding == 0 {
          ty_assoc_at(base, ty_f2(ty), ty_assoc_source_start(ty), ty_assoc_source_len(ty))
        }
        else { assoc_resolve_type_depth(binding, members, src, self_ty, depth + 1) }
      }
      _ -> ty
    }
  }
}

pub(package) fn assoc_resolve_type(ty: i64, members: i64, src: i64, self_ty: i64) -> i64 {
  assoc_resolve_type_depth(ty, members, src, self_ty, 0)
}

fn assoc_rewrite_params(
  params: i64,
  members: i64,
  src: i64,
  self_ty: i64,
  resolve: i64
) -> i64 {
  for i in 0..nlist_len(params) {
    let param = nlist_get(params, i)
    let marked = assoc_mark_type(node_f3(param), members, src, self_ty)
    let final_ty = if resolve == 1 { assoc_resolve_type(marked, members, src, self_ty) } else {
      marked
    }
    mem_store64_at(param, 24, final_ty)
  }
  0
}

pub(package) fn finalize_trait(methods: i64, src: i64) -> i64 {
  for i in 0..nlist_len(methods) {
    let method = nlist_get(methods, i)
    if node_tag(method) == 39 {
      assoc_rewrite_params(node_f3(method), methods, src, ty_self(), 0)
      let meta = node_f4(method)
      mem_store64_at(meta, 8, assoc_mark_type(node_f1(meta), methods, src, ty_self()))
      mem_store64_at(meta, 16, assoc_mark_type(node_f2(meta), methods, src, ty_self()))
    } else { 0 }
  }
  0
}

pub(package) fn finalize_impl(
  methods: i64,
  src: i64,
  self_ty: i64,
  impl_tparams: i64,
  tt: i64
) -> i64 {
  -- Resolve binding chains first so every method sees the complete impl body,
  -- independent of declaration order.
  for i in 0..nlist_len(methods) {
    let member = nlist_get(methods, i)
    if node_tag(member) == 43 {
      let marked = assoc_mark_type(node_f3(member), methods, src, self_ty)
      assoc_record_type_facts(marked, methods, src, self_ty, impl_tparams, tt)
      mem_store64_at(member, 24, assoc_resolve_type(marked, methods, src, self_ty))
    } else { 0 }
  }
  for i in 0..nlist_len(methods) {
    let method = nlist_get(methods, i)
    if node_tag(method) == 23 {
      let inner = node_f1(method)
      let params = node_f3(inner)
      for pi in 0..nlist_len(params) {
        let param = nlist_get(params, pi)
        let marked_param = assoc_mark_type(node_f3(param), methods, src, self_ty)
        assoc_record_type_facts(marked_param, methods, src, self_ty, impl_tparams, tt)
        mem_store64_at(param, 24, assoc_resolve_type(marked_param, methods, src, self_ty))
      }
      let marked_ret = assoc_mark_type(node_f2(method), methods, src, self_ty)
      let marked_eff = assoc_mark_type(node_f3(method), methods, src, self_ty)
      assoc_record_type_facts(marked_ret, methods, src, self_ty, impl_tparams, tt)
      assoc_record_type_facts(marked_eff, methods, src, self_ty, impl_tparams, tt)
      mem_store64_at(method, 16, assoc_resolve_type(marked_ret, methods, src, self_ty))
      mem_store64_at(method, 24, assoc_resolve_type(marked_eff, methods, src, self_ty))
    } else { 0 }
  }
  0
}
