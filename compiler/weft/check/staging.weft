-- compiler/weft/check/staging.weft -- staging sites as checker facts
--
-- A call to the blessed staging primitive `stdlib/grammar/staging.embed<G>`
-- is a staging site. The checker recognises the callee by declaration
-- identity, never by name, requires `G` to resolve to a grammar export of a
-- manifest in scope (the SDK, the workspace root or a dependency, through
-- the same package identities the export audit resolves), requires the
-- argument to be a staged literal whose decoded text is exactly its source
-- text, and records the site on the checker table. Build, artifact facts
-- and tools read that record; no phase rescans syntax for guest sources.

use compiler/diagnostic/location.{diagnostic_location_from_offsets}
use compiler/package/exports.{
  PackageExportResolved,
  package_export_resolve_loaded_from_table
}
use compiler/package/manifest.{*}
use compiler/project/module.{*}
use compiler/project/identity/equality.{declaration_identity_eq}
use compiler/storage.{*}
use compiler/types/algebra.{ty_f1, ty_named_surface_len, ty_named_surface_start, ty_tag}
use compiler/weft/check/table.{
  ttable_entry_name_len,
  ttable_entry_source,
  ttable_type_hash_index_find
}
use runtime/alloc.{alloc_words}
use runtime/memory.{mem_copy, mem_load8_at, mem_load64_at, mem_store64_at}
use runtime/string.{runtime_str_from_bytes_copy}
use stdlib/diagnostic/registry as registry
use stdlib/diagnostic/schema.{*}
use stdlib/string.{str_concat}

-- The recorded site: twenty-three words. Offsets are into the checked source.
--   0 call start, 1 call length, 2 literal token start, 3 literal token
--   length, 4 content start, 5 content length, 6 manifest export entry,
--   7 package identity entry, 8 the generic call node, 9 the owning source
--   buffer, 10 the blessed embed declaration, 11 material kind (zero before
--   staging, one validated, two staged), 12/13 value source name, 14/15
--   artifact digest, 16/17 artifact byte storage,
--   18 context kind (zero host types, one file), 19/20 context token range,
--   and 21/22 context content range.
pub(package) fn staging_site_call_start(site: i64) -> i64 { mem_load64_at(site, 0) }

pub(package) fn staging_site_call_len(site: i64) -> i64 { mem_load64_at(site, 8) }

pub(package) fn staging_site_token_start(site: i64) -> i64 { mem_load64_at(site, 16) }

pub(package) fn staging_site_token_len(site: i64) -> i64 { mem_load64_at(site, 24) }

pub(package) fn staging_site_content_start(site: i64) -> i64 { mem_load64_at(site, 32) }

pub(package) fn staging_site_content_len(site: i64) -> i64 { mem_load64_at(site, 40) }

pub(package) fn staging_site_export(site: i64) -> i64 { mem_load64_at(site, 48) }

pub(package) fn staging_site_identity(site: i64) -> i64 { mem_load64_at(site, 56) }

pub(package) fn staging_site_node(site: i64) -> i64 { mem_load64_at(site, 64) }

pub(package) fn staging_site_source(site: i64) -> i64 { mem_load64_at(site, 72) }

pub(package) fn staging_site_embed_decl(site: i64) -> i64 { mem_load64_at(site, 80) }

pub(package) fn staging_site_material_kind(site: i64) -> i64 { mem_load64_at(site, 88) }

pub(package) fn staging_site_material_source_ptr(site: i64) -> i64 { mem_load64_at(site, 96) }

pub(package) fn staging_site_material_source_len(site: i64) -> i64 { mem_load64_at(site, 104) }

pub(package) fn staging_site_material_digest_ptr(site: i64) -> i64 { mem_load64_at(site, 112) }

pub(package) fn staging_site_material_digest_len(site: i64) -> i64 { mem_load64_at(site, 120) }

pub(package) fn staging_site_material_bytes_ptr(site: i64) -> i64 { mem_load64_at(site, 128) }

pub(package) fn staging_site_material_bytes_len(site: i64) -> i64 { mem_load64_at(site, 136) }

pub(package) fn staging_site_context_kind(site: i64) -> i64 { mem_load64_at(site, 144) }

pub(package) fn staging_site_context_token_start(site: i64) -> i64 { mem_load64_at(site, 152) }

pub(package) fn staging_site_context_token_len(site: i64) -> i64 { mem_load64_at(site, 160) }

pub(package) fn staging_site_context_start(site: i64) -> i64 { mem_load64_at(site, 168) }

pub(package) fn staging_site_context_len(site: i64) -> i64 { mem_load64_at(site, 176) }

fn staging_site_new(
  call_start: i64,
  call_len: i64,
  token_start: i64,
  token_len: i64,
  content_start: i64,
  content_len: i64,
  export: i64,
  identity: i64,
  node: i64,
  source: i64,
  embed_decl: i64,
  context_kind: i64,
  context_token_start: i64,
  context_token_len: i64,
  context_start: i64,
  context_len: i64
) -> i64 {
  let site = alloc_words(23)
  mem_store64_at(site, 0, call_start)
  mem_store64_at(site, 8, call_len)
  mem_store64_at(site, 16, token_start)
  mem_store64_at(site, 24, token_len)
  mem_store64_at(site, 32, content_start)
  mem_store64_at(site, 40, content_len)
  mem_store64_at(site, 48, export)
  mem_store64_at(site, 56, identity)
  mem_store64_at(site, 64, node)
  mem_store64_at(site, 72, source)
  mem_store64_at(site, 80, embed_decl)
  mem_store64_at(site, 144, context_kind)
  mem_store64_at(site, 152, context_token_start)
  mem_store64_at(site, 160, context_token_len)
  mem_store64_at(site, 168, context_start)
  mem_store64_at(site, 176, context_len)
  site
}

fn staging_site_copy_text(text: str) -> (i64, i64) {
  let len = __str_len(text)
  if len == 0 { (0, 0) } else {
    let ptr = alloc_words((len + 7) / 8)
    mem_copy(ptr, __str_ptr(text), len)
    (ptr, len)
  }
}

--- Attach the verified build-time value consumed by lowering. The text is
--- copied into compiler-owned storage because the checker table outlives the
--- staging exchange's managed response values.
pub(package) fn staging_site_set_material(
  site: i64,
  kind: i64,
  source_name: str,
  digest: str,
  bytes: str
) -> nil {
  let (source_ptr, source_len) = staging_site_copy_text(source_name)
  let (digest_ptr, digest_len) = staging_site_copy_text(digest)
  let (bytes_ptr, bytes_len) = staging_site_copy_text(bytes)
  mem_store64_at(site, 88, kind)
  mem_store64_at(site, 96, source_ptr)
  mem_store64_at(site, 104, source_len)
  mem_store64_at(site, 112, digest_ptr)
  mem_store64_at(site, 120, digest_len)
  mem_store64_at(site, 128, bytes_ptr)
  mem_store64_at(site, 136, bytes_len)
  nil
}

--- The staging sites recorded on a checker table, in check order, as a
--- native list of site records; empty when none were recorded.
pub(package) fn ttable_staging_sites(tt: i64) -> i64 {
  if tt == 0 { 0 } else { mem_load64_at(tt, 272) }
}

--- Find the staging record for one generic call in its owning source.
pub(package) fn ttable_staging_site_find(tt: i64, source: i64, call_start: i64) -> i64 {
  let sites = ttable_staging_sites(tt)
  if sites == 0 { 0 } else {
    let mut index = 0
    let mut found = 0
    while index < nlist_len(sites) and found == 0 {
      let site = nlist_get(sites, index)
      if staging_site_source(site) == source and staging_site_call_start(site) == call_start {
        found = site
      } else { index = index + 1 }
    }
    found
  }
}

--- Resolve the stdlib constructor selected by the verified site material in
--- the same module as the blessed primitive, by declaration identity.
pub(package) fn staging_site_material_decl(tt: i64, site: i64) -> i64 {
  let embed_decl = staging_site_embed_decl(site)
  let source = if embed_decl == 0 { 0 } else { module_decl_fact_source(embed_decl) }
  let name = if staging_site_material_kind(site) == 1 { "validated" } else {
    if staging_site_material_kind(site) == 2 { "staged_from_static" } else { "" }
  }
  if source == 0 or __str_len(name) == 0 { 0 } else {
    module_decl_fact_find(
      tt,
      source,
      module_decl_namespace_value(),
      __str_ptr(name),
      0,
      __str_len(name)
    )
  }
}

fn ttable_record_staging_site(tt: i64, site: i64) -> nil {
  let existing = mem_load64_at(tt, 272)
  let sites = if existing != 0 { existing } else {
    let created = nlist_new()
    mem_store64_at(tt, 272, created)
    created
  }
  nlist_add(sites, site)
  nil
}

--- Which blessed staging primitive a declaration fact names: zero for an
--- ordinary declaration, one for host types and two for a context file.
pub(package) fn staging_decl_kind(decl: i64) -> i64 {
  if decl == 0 { 0 } else {
    let module_entry = module_decl_fact_module(decl)
    if module_entry == 0 { 0 } else {
      let staging_module = src_eq(
        module_fact_entry_path_ptr(module_entry),
        0,
        module_fact_entry_path_len(module_entry),
        "stdlib/grammar/staging"
      ) == 1
      if not staging_module { 0 } else {
        if src_eq(
          module_decl_fact_name_ptr(decl),
          0,
          module_decl_fact_name_len(decl),
          "embed"
        ) == 1 { 1 } else {
          if src_eq(
            module_decl_fact_name_ptr(decl),
            0,
            module_decl_fact_name_len(decl),
            "embed_with_file"
          ) == 1 { 2 } else { 0 }
        }
      }
    }
  }
}

fn text_of(src: i64, start: i64, len: i64) -> str {
  if len <= 0 { "" } else { runtime_str_from_bytes_copy(src + start, len) }
}

fn location_of(src: i64, start: i64, len: i64) -> DiagnosticLocation {
  diagnostic_location_from_offsets(
    DiagnosticSourceBuffer(src),
    start,
    start + if len > 0 { len } else { 1 }
  )
}

fn report_site(
  code: DiagnosticCode,
  message: str,
  src: i64,
  start: i64,
  len: i64,
  reason: str
) -[Diagnose]> i64 {
  Diagnose.report(
    Diagnostic(
      DiagnosticSeverityError,
      DiagnosticClassGrammar,
      code,
      message,
      location_of(src, start, len),
      DiagnosticRelatedLocationNil,
      DiagnosticFieldCons(DiagnosticFieldText("reason", reason), DiagnosticFieldNil)
    )
  )
  1
}

-- The declaration fact of a named type argument, through the checker's own
-- type registry: the resolved entry names its declaring source and spelling.
fn type_arg_decl(tt: i64, ty: i64) -> i64 {
  if ty == 0 or ty_tag(ty) != 9 { 0 } else {
    let entry = ttable_type_hash_index_find(tt, ty_f1(ty), 0 - 1)
    if entry == 0 { 0 } else {
      let source = ttable_entry_source(entry)
      module_decl_fact_find(
        tt,
        source,
        module_decl_namespace_type(),
        source,
        mem_load64_at(entry, 0),
        ttable_entry_name_len(entry)
      )
    }
  }
}

-- Whether two grammar exports of one manifest that name the same
-- declaration are aliases of one grammar: they must agree on tooling and
-- execution, or a site could not know which driver and capability apply.
fn exports_agree(left: i64, right: i64) -> bool {
  let same_execution = pkg_export_execution(left) == pkg_export_execution(right)
  let left_tooling = pkg_export_has_tooling(left)
  let right_tooling = pkg_export_has_tooling(right)
  let same_tooling = if left_tooling != right_tooling { false } else {
    if not left_tooling { true } else {
      pkg_export_tooling_module_len(left) == pkg_export_tooling_module_len(right) and
        src_eq_at(
          pkg_export_tooling_module_ptr(left),
          0,
          pkg_export_tooling_module_ptr(right),
          0,
          pkg_export_tooling_module_len(left)
        )
    }
  }
  same_execution and same_tooling
}

-- Whether an export is named after its module's final path segment: the
-- primary spelling of a grammar, as `sql` is for `stdlib/grammar/sql`.
fn export_named_after_module(entry: i64) -> bool {
  let module_ptr = pkg_export_module_ptr(entry)
  let module_len = pkg_export_module_len(entry)
  let mut segment = 0
  let mut index = 0
  while index < module_len {
    if mem_load8_at(module_ptr, index) == 47 { segment = index + 1 } else { 0 }
    index = index + 1
  }
  let segment_len = module_len - segment
  segment_len == pkg_export_name_len(entry) and
    src_eq_at(module_ptr, segment, pkg_export_name_ptr(entry), 0, segment_len)
}

-- Whether `candidate` is the better canonical export: named after its
-- module first, then bytewise-first by name. Neither depends on manifest
-- declaration order.
fn export_preferred(candidate: i64, current: i64) -> bool {
  let candidate_named = export_named_after_module(candidate)
  let current_named = export_named_after_module(current)
  if candidate_named != current_named { candidate_named } else {
    export_name_before(candidate, current)
  }
}

-- Whether `left` sorts before `right` by export name, bytewise.
fn export_name_before(left: i64, right: i64) -> bool {
  let left_len = pkg_export_name_len(left)
  let right_len = pkg_export_name_len(right)
  let shared = if left_len < right_len { left_len } else { right_len }
  let mut index = 0
  while index < shared {
    let a = mem_load8_at(pkg_export_name_ptr(left), index)
    let b = mem_load8_at(pkg_export_name_ptr(right), index)
    if a != b { return a < b } else { index = index + 1 }
  }
  left_len < right_len
}

--- How a type argument's declaration relates to the grammar exports of the
--- manifests in scope.
pub(package) type StagingExportResolution {
  --- No manifest exports the declaration as a grammar.
  StagingExportNone,
  --- The canonical export among aliases that agree on tooling and
  --- execution (the one named after its module, else the bytewise-first
  --- name) and its package identity.
  StagingExportFound(i64, i64),
  --- Two exports name the declaration but disagree on tooling or execution;
  --- the site cannot know which driver applies. The two names follow.
  StagingExportConflict(str, str)
}

-- The manifest grammar exports whose resolved declaration is `decl`,
-- searched through every package identity the checker loaded. A
-- declaration belongs to one package, so every match shares an identity;
-- aliases within it resolve to a canonical export by name, never by the
-- manifest's declaration order.
fn export_for_decl(tt: i64, decl: i64) -> StagingExportResolution {
  let identities = pkg_identity_entries(tt)
  let mut canonical = 0
  let mut canonical_identity = 0
  let mut conflict_left = ""
  let mut conflict_right = ""
  let mut conflicting = false
  for i in 0..nlist_len(identities) {
    let identity = nlist_get(identities, i)
    let manifest = pkg_identity_manifest(identity)
    let exports = if manifest == 0 { 0 } else { pkg_manifest_exports(manifest) }
    if exports != 0 {
      for j in 0..nlist_len(exports) {
        let entry = nlist_get(exports, j)
        if pkg_export_kind(entry) == pkg_export_kind_grammar() {
          match package_export_resolve_loaded_from_table(
            tt,
            mem_load64_at(identity, 16),
            entry
          ) {
            PackageExportResolved(exported) -> if declaration_identity_eq(
              exported,
              module_decl_fact_id(decl)
            ) {
              if canonical == 0 {
                canonical = entry
                canonical_identity = identity
              } else {
                if not exports_agree(canonical, entry) {
                  if not conflicting {
                    conflicting = true
                    conflict_left = text_of(
                      pkg_export_name_ptr(canonical),
                      0,
                      pkg_export_name_len(canonical)
                    )
                    conflict_right = text_of(
                      pkg_export_name_ptr(entry),
                      0,
                      pkg_export_name_len(entry)
                    )
                  } else { nil }
                } else { nil }
                if export_preferred(entry, canonical) {
                  canonical = entry
                  canonical_identity = identity
                } else { nil }
              }
            } else { nil }
            _ -> nil
          }
        } else { nil }
      }
    } else { nil }
  }
  if conflicting { StagingExportConflict(conflict_left, conflict_right) } else {
    if canonical == 0 { StagingExportNone } else {
      StagingExportFound(canonical, canonical_identity)
    }
  }
}

-- A staged literal: a plain string whose decoded bytes are exactly the bytes
-- between its quotes (so it has no escapes), or a raw string, whose token
-- names its own source bytes. Returns (content start, content length) or
-- (-1, -1) when the argument node is not a staged literal.
fn staged_literal_content(node: i64, src: i64) -> (i64, i64) {
  if node == 0 or node_tag(node) != 9 { (0 - 1, 0 - 1) } else {
    let decoded_start = node_f1(node)
    let decoded_len = node_f2(node)
    let token_start = node_f3(node)
    let token_len = node_f4(node)
    if token_len <= 0 { (0 - 1, 0 - 1) } else {
      if mem_load8_at(src, token_start) == 114 {
        -- Raw: the decoded range is the source content range.
        (decoded_start, decoded_len)
      } else {
        let content_start = token_start + 1
        let content_len = token_len - 2
        if content_len != decoded_len { (0 - 1, 0 - 1) } else {
          let mut same = true
          let mut index = 0
          while same and index < content_len {
            if mem_load8_at(src, decoded_start + index) != mem_load8_at(
              src,
              content_start + index
            ) { same = false } else { 0 }
            index = index + 1
          }
          if same { (content_start, content_len) } else { (0 - 1, 0 - 1) }
        }
      }
    }
  }
}

--- Check one generic use of the blessed staging primitive and record it as
--- a site. `type_args` are the resolved type arguments, `args` the call's
--- argument nodes, `called` whether the primitive is applied at this use
--- (a reference that is not applied, such as a function value, cannot be a
--- site: the literal must be at the call). `ns`/`nl` name the callee
--- spelling. Returns the number of errors reported.
pub(package) fn check_staging_site(
  tt: i64,
  src: i64,
  ns: i64,
  nl: i64,
  type_args: i64,
  args: i64,
  called: bool,
  node: i64,
  embed_decl: i64,
  staging_kind: i64
) -[Diagnose]> i64 {
  let type_arg = if type_args == 0 or nlist_len(type_args) == 0 { 0 } else {
    nlist_get(type_args, 0)
  }
  let decl = type_arg_decl(tt, type_arg)
  -- Spell the type as authored when the resolved argument retains its
  -- range, else by its declaration name.
  let type_spelling = if type_arg != 0 and ty_tag(type_arg) == 9 and ty_named_surface_len(
    type_arg
  ) > 0 {
    str_concat(
      "`",
      str_concat(
        text_of(src, ty_named_surface_start(type_arg), ty_named_surface_len(type_arg)),
        "`"
      )
    )
  } else {
    if decl == 0 { "the type argument" } else {
      str_concat(
        "`",
        str_concat(
          text_of(module_decl_fact_name_ptr(decl), 0, module_decl_fact_name_len(decl)),
          "`"
        )
      )
    }
  }
  let resolution = if decl == 0 { StagingExportNone } else { export_for_decl(tt, decl) }
  let (export, identity) = match resolution {
    StagingExportFound(found, found_identity) -> (found, found_identity)
    _ -> (0, 0)
  }
  let export_errors = match resolution {
    StagingExportFound(_, _) -> 0
    StagingExportNone -> report_site(
      registry.staging_site_grammar(),
      str_concat(
        "staging site: ",
        str_concat(type_spelling, " is not a grammar export of a manifest in scope")
      ),
      src,
      ns,
      nl,
      "not_a_grammar_export"
    )
    StagingExportConflict(left, right) -> report_site(
      registry.staging_site_grammar(),
      "staging site: "
      |> str_concat(type_spelling)
      |> str_concat(" is exported as `")
      |> str_concat(left)
      |> str_concat("` and `")
      |> str_concat(right)
      |> str_concat("` with different tooling or execution, so no one driver applies"),
      src,
      ns,
      nl,
      "conflicting_exports"
    )
  }
  let arg = if not called or args == 0 or nlist_len(args) == 0 { 0 } else {
    nlist_get(args, 0)
  }
  let (content_start, content_len) = staged_literal_content(arg, src)
  let literal_errors = if not called {
    report_site(
      registry.staging_site_literal(),
      "staging site: embed must be called directly with its source literal",
      src,
      ns,
      nl,
      "not_called"
    )
  } else {
    if content_start < 0 {
      let (start, len) = if arg == 0 { (ns, nl) } else {
        if node_tag(arg) == 9 { (node_f3(arg), node_f4(arg)) } else { (ns, nl) }
      }
      report_site(
        registry.staging_site_literal(),
        "staging site: the source must be a raw string literal or a plain string literal without escapes",
        src,
        start,
        len,
        if arg != 0 and node_tag(arg) == 9 { "escaped_literal" } else { "not_a_literal" }
      )
    } else { 0 }
  }
  let context_arg = if staging_kind != 2 or not called or args == 0 or nlist_len(args) < 2 {
    0
  } else { nlist_get(args, 1) }
  let (context_start, context_len) = if staging_kind == 2 {
    staged_literal_content(context_arg, src)
  } else { (0, 0) }
  let context_errors = if staging_kind != 2 or context_start >= 0 { 0 } else {
    let (start, len) = if context_arg == 0 { (ns, nl) } else {
      if node_tag(context_arg) == 9 {
        (node_f3(context_arg), node_f4(context_arg))
      } else { (ns, nl) }
    }
    report_site(
      registry.staging_site_literal(),
      "staging site: the context path must be a raw string literal or a plain string literal without escapes",
      src,
      start,
      len,
      if context_arg != 0 and node_tag(context_arg) == 9 {
        "escaped_context_literal"
      } else { "context_not_a_literal" }
    )
  }
  if export_errors + literal_errors + context_errors == 0 {
    ttable_record_staging_site(
      tt,
      staging_site_new(
        ns,
        nl,
        node_f3(arg),
        node_f4(arg),
        content_start,
        content_len,
        export,
        identity,
        node,
        src,
        embed_decl,
        if staging_kind == 2 { 1 } else { 0 },
        if staging_kind == 2 { node_f3(context_arg) } else { 0 },
        if staging_kind == 2 { node_f4(context_arg) } else { 0 },
        context_start,
        context_len
      )
    )
  } else { nil }
  export_errors + literal_errors + context_errors
}
