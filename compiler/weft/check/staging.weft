-- compiler/weft/check/staging.weft -- staging sites as checker facts
--
-- A call to the blessed staging primitive `stdlib/grammar/staging.embed<G>`
-- is a staging site. The checker recognises the callee by declaration
-- identity, never by name, requires `G` to resolve to a grammar export of a
-- manifest in scope (the SDK, the workspace root or a dependency, through
-- the same package identities the export audit resolves), requires the
-- argument to be a staged literal whose decoded text is exactly its source
-- text, and records the site on the checker table. Build, artifact facts
-- and tools read that record; no phase rescans syntax for guest sources.

use compiler/diagnostic/location.{diagnostic_location_from_offsets}
use compiler/package/exports.{package_export_resolve_loaded, package_export_status_resolved}
use compiler/package/manifest.{*}
use compiler/project/module.{*}
use compiler/storage.{*}
use compiler/types/algebra.{ty_f1, ty_named_surface_len, ty_named_surface_start, ty_tag}
use compiler/weft/check/table.{
  ttable_entry_name_len,
  ttable_entry_source,
  ttable_type_hash_index_find
}
use runtime/alloc.{alloc_words}
use runtime/memory.{mem_load8_at, mem_load64_at, mem_store64_at}
use runtime/string.{runtime_str_from_bytes_copy}
use stdlib/diagnostic/registry as registry
use stdlib/diagnostic/schema.{*}
use stdlib/string.{str_concat}

-- The recorded site: eight words. Offsets are into the checked source.
--   0 call start, 1 call length, 2 literal token start, 3 literal token
--   length, 4 content start, 5 content length, 6 manifest export entry,
--   7 package identity entry.
pub(package) fn staging_site_call_start(site: i64) -> i64 { mem_load64_at(site, 0) }

pub(package) fn staging_site_call_len(site: i64) -> i64 { mem_load64_at(site, 8) }

pub(package) fn staging_site_token_start(site: i64) -> i64 { mem_load64_at(site, 16) }

pub(package) fn staging_site_token_len(site: i64) -> i64 { mem_load64_at(site, 24) }

pub(package) fn staging_site_content_start(site: i64) -> i64 { mem_load64_at(site, 32) }

pub(package) fn staging_site_content_len(site: i64) -> i64 { mem_load64_at(site, 40) }

pub(package) fn staging_site_export(site: i64) -> i64 { mem_load64_at(site, 48) }

pub(package) fn staging_site_identity(site: i64) -> i64 { mem_load64_at(site, 56) }

fn staging_site_new(
  call_start: i64,
  call_len: i64,
  token_start: i64,
  token_len: i64,
  content_start: i64,
  content_len: i64,
  export: i64,
  identity: i64
) -> i64 {
  let site = alloc_words(8)
  mem_store64_at(site, 0, call_start)
  mem_store64_at(site, 8, call_len)
  mem_store64_at(site, 16, token_start)
  mem_store64_at(site, 24, token_len)
  mem_store64_at(site, 32, content_start)
  mem_store64_at(site, 40, content_len)
  mem_store64_at(site, 48, export)
  mem_store64_at(site, 56, identity)
  site
}

--- The staging sites recorded on a checker table, in check order, as a
--- native list of site records; empty when none were recorded.
pub(package) fn ttable_staging_sites(tt: i64) -> i64 {
  if tt == 0 { 0 } else { mem_load64_at(tt, 272) }
}

fn ttable_record_staging_site(tt: i64, site: i64) -> nil {
  let existing = mem_load64_at(tt, 272)
  let sites = if existing != 0 { existing } else {
    let created = nlist_new()
    mem_store64_at(tt, 272, created)
    created
  }
  nlist_add(sites, site)
  nil
}

--- Whether a function declaration fact is the blessed staging primitive.
pub(package) fn staging_decl_is_embed(decl: i64) -> bool {
  if decl == 0 { false } else {
    let module_entry = module_decl_fact_module(decl)
    if module_entry == 0 { false } else {
      src_eq(
        module_fact_entry_path_ptr(module_entry),
        0,
        module_fact_entry_path_len(module_entry),
        "stdlib/grammar/staging"
      ) == 1 and
        src_eq(module_decl_fact_name_ptr(decl), 0, module_decl_fact_name_len(decl), "embed") == 1
    }
  }
}

fn text_of(src: i64, start: i64, len: i64) -> str {
  if len <= 0 { "" } else { runtime_str_from_bytes_copy(src + start, len) }
}

fn location_of(src: i64, start: i64, len: i64) -> DiagnosticLocation {
  diagnostic_location_from_offsets(
    DiagnosticSourceBuffer(src),
    start,
    start + if len > 0 { len } else { 1 }
  )
}

fn report_site(
  code: DiagnosticCode,
  message: str,
  src: i64,
  start: i64,
  len: i64,
  reason: str
) -[Diagnose]> i64 {
  Diagnose.report(
    Diagnostic(
      DiagnosticSeverityError,
      DiagnosticClassGrammar,
      code,
      message,
      location_of(src, start, len),
      DiagnosticRelatedLocationNil,
      DiagnosticFieldCons(DiagnosticFieldText("reason", reason), DiagnosticFieldNil)
    )
  )
  1
}

-- The declaration fact of a named type argument, through the checker's own
-- type registry: the resolved entry names its declaring source and spelling.
fn type_arg_decl(tt: i64, ty: i64) -> i64 {
  if ty == 0 or ty_tag(ty) != 9 { 0 } else {
    let entry = ttable_type_hash_index_find(tt, ty_f1(ty), 0 - 1)
    if entry == 0 { 0 } else {
      let source = ttable_entry_source(entry)
      module_decl_fact_find(
        tt,
        source,
        module_decl_namespace_type(),
        source,
        mem_load64_at(entry, 0),
        ttable_entry_name_len(entry)
      )
    }
  }
}

-- The manifest grammar export whose resolved declaration is `decl`, searched
-- through every package identity the checker loaded. Returns the export
-- entry and its identity, or (0, 0).
fn export_for_decl(tt: i64, decl: i64) -> (i64, i64) {
  let identities = pkg_identity_entries(tt)
  let mut found_export = 0
  let mut found_identity = 0
  for i in 0..nlist_len(identities) {
    let identity = nlist_get(identities, i)
    let manifest = pkg_identity_manifest(identity)
    let exports = if manifest == 0 { 0 } else { pkg_manifest_exports(manifest) }
    if exports != 0 and found_export == 0 {
      for j in 0..nlist_len(exports) {
        let entry = nlist_get(exports, j)
        if found_export == 0 and pkg_export_kind(entry) == pkg_export_kind_grammar() {
          let status = package_export_resolve_loaded(tt, mem_load64_at(identity, 16), entry)
          if status == package_export_status_resolved() and
            module_decl_fact_same_identity(pkg_export_resolved_declaration(entry), decl) == 1 {
              found_export = entry
              found_identity = identity
            } else { 0 }
        } else { 0 }
      }
    } else { 0 }
  }
  (found_export, found_identity)
}

-- A staged literal: a plain string whose decoded bytes are exactly the bytes
-- between its quotes (so it has no escapes), or a raw string, whose token
-- names its own source bytes. Returns (content start, content length) or
-- (-1, -1) when the argument node is not a staged literal.
fn staged_literal_content(node: i64, src: i64) -> (i64, i64) {
  if node == 0 or node_tag(node) != 9 { (0 - 1, 0 - 1) } else {
    let decoded_start = node_f1(node)
    let decoded_len = node_f2(node)
    let token_start = node_f3(node)
    let token_len = node_f4(node)
    if token_len <= 0 { (0 - 1, 0 - 1) } else {
      if mem_load8_at(src, token_start) == 114 {
        -- Raw: the decoded range is the source content range.
        (decoded_start, decoded_len)
      } else {
        let content_start = token_start + 1
        let content_len = token_len - 2
        if content_len != decoded_len { (0 - 1, 0 - 1) } else {
          let mut same = true
          let mut index = 0
          while same and index < content_len {
            if mem_load8_at(src, decoded_start + index) != mem_load8_at(
              src,
              content_start + index
            ) { same = false } else { 0 }
            index = index + 1
          }
          if same { (content_start, content_len) } else { (0 - 1, 0 - 1) }
        }
      }
    }
  }
}

--- Check one generic call whose callee is the blessed staging primitive and
--- record it as a site. `type_args` are the call's resolved type arguments,
--- `args` its argument nodes; `ns`/`nl` name the callee spelling. Returns the
--- number of errors reported.
pub(package) fn check_staging_site(
  tt: i64,
  src: i64,
  ns: i64,
  nl: i64,
  type_args: i64,
  args: i64
) -[Diagnose]> i64 {
  let type_arg = if type_args == 0 or nlist_len(type_args) == 0 { 0 } else {
    nlist_get(type_args, 0)
  }
  let type_spelling = if type_arg == 0 or ty_tag(type_arg) != 9 { "the type argument" } else {
    let start = ty_named_surface_start(type_arg)
    let len = ty_named_surface_len(type_arg)
    if len > 0 { str_concat("`", str_concat(text_of(src, start, len), "`")) } else {
      "the type argument"
    }
  }
  let decl = type_arg_decl(tt, type_arg)
  let (export, identity) = if decl == 0 { (0, 0) } else { export_for_decl(tt, decl) }
  let export_errors = if export == 0 {
    report_site(
      registry.staging_site_grammar(),
      str_concat(
        "staging site: ",
        str_concat(type_spelling, " is not a grammar export of a manifest in scope")
      ),
      src,
      ns,
      nl,
      "not_a_grammar_export"
    )
  } else { 0 }
  let arg = if args == 0 or nlist_len(args) == 0 { 0 } else { nlist_get(args, 0) }
  let (content_start, content_len) = staged_literal_content(arg, src)
  let literal_errors = if content_start < 0 {
    let (start, len) = if arg == 0 { (ns, nl) } else {
      if node_tag(arg) == 9 { (node_f3(arg), node_f4(arg)) } else { (ns, nl) }
    }
    report_site(
      registry.staging_site_literal(),
      "staging site: the source must be a raw string literal or a plain string literal without escapes",
      src,
      start,
      len,
      if arg != 0 and node_tag(arg) == 9 { "escaped_literal" } else { "not_a_literal" }
    )
  } else { 0 }
  if export_errors + literal_errors == 0 {
    ttable_record_staging_site(
      tt,
      staging_site_new(
        ns,
        nl,
        node_f3(arg),
        node_f4(arg),
        content_start,
        content_len,
        export,
        identity
      )
    )
  } else { nil }
  export_errors + literal_errors
}
