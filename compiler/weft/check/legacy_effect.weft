-- Private checker-storage effect for legacy compiler and grammar consumers.
-- Public host inspection must expose structured facts with separate identity.

pub(package) effect TypeCheck {
  fn resolve_type(name_src: i64, name_start: i64, name_len: i64) -> i64
  fn resolve_field_type(base_ty: i64, field_src: i64, field_start: i64, field_len: i64) -> i64
  fn subtype(actual_ty: i64, expected_ty: i64) -> i64
}
