-- Typed dense storage for the Weft checker migration.
--
-- Mutation is confined to a linearly owned builder. Freezing transfers the
-- same vector storage into an opaque segment whose surface exposes no mutable
-- handle. Semantic stores layer their own typed ids and structural views over
-- this physical primitive; callers never receive an address, tag, or slot.

use stdlib/drop.{Drop}
use stdlib/num/scalar.{num_scalar_usize_to_i64}
use stdlib/option.{Option, Some, None}
use stdlib/panic.{panic}
use stdlib/vector as vector
use stdlib/vector.{
  PersistentVector,
  Vector,
  frozen_vector_get_in_bounds,
  frozen_vector_len,
  persistent_vector_empty,
  persistent_vector_get_option,
  persistent_vector_len,
  persistent_vector_push,
  persistent_vector_set,
  vector_get_in_bounds,
  vector_len,
  vector_push,
  vector_freeze,
  vector_set
}
use stdlib/vector/handles.{FrozenVector}

pub(package) type DenseIndex = opaque usize

pub(package) type DenseBuilder<T> = opaque owned Vector<T>

-- A frozen column: the builder's own vector storage, frozen in place. An
-- empty one holds no storage (`nil`): most columns of a small derived graph
-- stay empty. A frozen column costs one compact allocation; a persistent
-- vector per column would give every column of every derived graph its own
-- collection region.
pub(package) type DenseSegment<T> = opaque FrozenVector<T>?

-- A frozen column that later versions extend: `push` and `set` return a new
-- column sharing the old one's storage. Only structures that grow by versions,
-- such as a type catalog, need one.
pub(package) type PersistentDenseSegment<T> = opaque PersistentVector<T>?

pub(package) fn dense_index_value(index: DenseIndex) -> usize {
  match index { DenseIndex(value) -> value }
}

pub(package) fn dense_index(value: usize) -> DenseIndex { DenseIndex(value) }

pub(package) fn dense_builder<T>() -> owned DenseBuilder<T> {
  DenseBuilder<T>(vector.new<T>())
}

pub(package) fn dense_builder_with_capacity<T>(capacity: usize) -> owned DenseBuilder<T> {
  DenseBuilder<T>(vector.with_capacity<T>(capacity))
}

impl<T> DenseBuilder<T> {
  pub(package) fn len(self: borrow Self) -> usize {
    match self { DenseBuilder(values) -> values.len() }
  }

  pub(package) fn push(self: borrow mut Self, value: T) -> DenseIndex {
    match self {
      DenseBuilder(values) -> {
        let index = values.len()
        if vector_push<T>(values, value) { nil }
        else { panic("Dense checker storage capacity is too large") }
        DenseIndex(index)
      }
    }
  }

  pub(package) fn at(self: borrow Self, index: DenseIndex) -> T {
    let value = dense_index_value(index)
    match self {
      DenseBuilder(values) -> if value >= values.len() {
        panic("Dense checker builder index is out of bounds")
      } else {
        vector_get_in_bounds<T>(
          values,
          __u64_to_i64(__usize_to_u64(value))
        )
      }
    }
  }

  pub(package) fn set(self: borrow mut Self, index: DenseIndex, value: T) -> nil {
    let position = dense_index_value(index)
    match self {
      DenseBuilder(values) -> if position >= values.len() {
        panic("Dense checker builder index is out of bounds")
      } else {
        if vector_set<T>(values, __u64_to_i64(__usize_to_u64(position)), value) {
          nil
        } else { panic("Dense checker builder mutation failed") }
      }
    }
  }

  pub(package) fn freeze(self: owned Self) -> DenseSegment<T> {
    match self {
      DenseBuilder(values) -> if vector_len<T>(values) == 0 {
        DenseSegment<T>(nil)
      } else { DenseSegment<T>(vector_freeze<T>(values)) }
    }
  }

  pub(package) fn freeze_persistent(self: owned Self) -> PersistentDenseSegment<T> {
    match self {
      DenseBuilder(values) -> if vector_len<T>(values) == 0 {
        PersistentDenseSegment<T>(nil)
      } else {
        let mut frozen = persistent_vector_empty<T>()
        for index in 0..vector_len<T>(values) {
          frozen = persistent_vector_push<T>(
            frozen,
            vector_get_in_bounds<T>(values, index)
          )
        }
        PersistentDenseSegment<T>(frozen)
      }
    }
  }
}

impl<T> Drop for DenseBuilder<T> {
  fn drop(self) -> nil {
    match self { DenseBuilder(values) -> values.drop() }
  }
}

-- A persistent column's length, observed through a borrow of the column.
fn dense_column_len<T>(values: borrow PersistentVector<T>) -> usize {
  __i64_to_usize(persistent_vector_len<T>(values))
}

impl<T> DenseSegment<T> {
  pub(package) fn len(self: borrow Self) -> usize {
    match self {
      DenseSegment(storage) -> match storage {
        nil -> __i64_to_usize(0)
        values: FrozenVector<T> -> __i64_to_usize(frozen_vector_len<T>(values))
      }
    }
  }

  -- Checked materialisation for cold paths. Managed T values may carry the
  -- ordinary cost of returning an Option<T>; hot checker traversal uses at
  -- over scalar columns instead.
  pub(package) fn get(self: borrow Self, index: DenseIndex) -> Option<T> {
    let value = dense_index_value(index)
    match self {
      DenseSegment(storage) -> match storage {
        nil -> None<T>()
        values: FrozenVector<T> -> if value >= __i64_to_usize(frozen_vector_len<T>(values)) {
          None<T>()
        } else {
          Some<T>(frozen_vector_get_in_bounds<T>(values, __u64_to_i64(__usize_to_u64(value))))
        }
      }
    }
  }

  -- Bounds-checked constant-time access for dense scalar columns.
  pub(package) fn at(self: borrow Self, index: DenseIndex) -> T {
    let value = dense_index_value(index)
    match self {
      DenseSegment(storage) -> match storage {
        nil -> panic("Dense checker storage index is out of bounds")
        values: FrozenVector<T> -> if value >= __i64_to_usize(frozen_vector_len<T>(values)) {
          panic("Dense checker storage index is out of bounds")
        } else {
          frozen_vector_get_in_bounds<T>(values, __u64_to_i64(__usize_to_u64(value)))
        }
      }
    }
  }
}

impl<T> PersistentDenseSegment<T> {
  pub(package) fn len(self: borrow Self) -> usize {
    match self {
      PersistentDenseSegment(storage) -> match storage {
        nil -> __i64_to_usize(0)
        values: PersistentVector<T> -> dense_column_len<T>(values)
      }
    }
  }

  -- Checked materialisation for cold paths. Managed T values may carry the
  -- ordinary cost of returning an Option<T>; hot checker traversal uses at
  -- over scalar columns instead.
  pub(package) fn get(self: borrow Self, index: DenseIndex) -> Option<T> {
    match self {
      PersistentDenseSegment(storage) -> match storage {
        nil -> None<T>()
        values: PersistentVector<T> -> match num_scalar_usize_to_i64(dense_index_value(index)) {
          Some(storage_index) -> persistent_vector_get_option<T>(values, storage_index)
          None -> None<T>()
        }
      }
    }
  }

  -- Bounds-checked constant-time access for dense scalar columns.
  pub(package) fn at(self: borrow Self, index: DenseIndex) -> T {
    let value = dense_index_value(index)
    match self {
      PersistentDenseSegment(storage) -> match storage {
        nil -> panic("Dense checker storage index is out of bounds")
        values: PersistentVector<T> -> if value >= dense_column_len<T>(values) {
          panic("Dense checker storage index is out of bounds")
        } else {
          match num_scalar_usize_to_i64(value) {
            Some(storage_index) -> match persistent_vector_get_option<T>(
              values,
              storage_index
            ) {
              Some(item) -> item
              None -> panic("Dense checker storage index is out of bounds")
            }
            None -> panic("Dense checker storage index is not representable")
          }
        }
      }
    }
  }

  pub(package) fn push(self: Self, value: T) -> PersistentDenseSegment<T> {
    match self {
      PersistentDenseSegment(storage) -> match storage {
        nil -> PersistentDenseSegment<T>(
          persistent_vector_push<T>(persistent_vector_empty<T>(), value)
        )
        values: PersistentVector<T> -> PersistentDenseSegment<T>(
          persistent_vector_push<T>(values, value)
        )
      }
    }
  }

  pub(package) fn set(self: Self, index: DenseIndex, value: T) -> PersistentDenseSegment<T> {
    let position = dense_index_value(index)
    match self {
      PersistentDenseSegment(storage) -> match storage {
        nil -> panic("Dense checker storage index is out of bounds")
        values: PersistentVector<T> -> if position >= values.len() {
          panic("Dense checker storage index is out of bounds")
        } else {
          match num_scalar_usize_to_i64(position) {
            Some(storage_index) -> PersistentDenseSegment<T>(
              persistent_vector_set<T>(values, storage_index, value)
            )
            None -> panic("Dense checker storage index is not representable")
          }
        }
      }
    }
  }
}
