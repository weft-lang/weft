-- Contextual integer literals: a literal's exact magnitude, and whether it
-- fits the integer primitive its context selects.
--
-- The magnitude comes from the authored spelling, never from the wrapped
-- 64-bit value, so `0xFFFF_FFFF_FFFF_FFFF` fits `u64` and a spelling beyond
-- every width fits none. A negated literal is its negative magnitude, so
-- `-128` fits `i8` while `128` does not; no unsigned primitive holds a
-- negated literal.

use compiler/ir/data.{BinOp, Expr, IntLit}
use compiler/types/graph.{
  SemanticI16,
  SemanticI32,
  SemanticI64,
  SemanticI8,
  SemanticIsize,
  SemanticPrimitive,
  SemanticU16,
  SemanticU32,
  SemanticU64,
  SemanticU8,
  SemanticUsize
}
use compiler/weft/syntax/numeric.{
  ExactMagnitude,
  ExpressionNumber,
  IntegerMagnitude,
  IntegerSpelling,
  OversizedMagnitude,
  numeric_scan
}
use stdlib/option.{None, Option, Some}
use stdlib/source.{Source}

-- The exact magnitude an integer literal spells. A literal with no authored
-- spelling is its value.
pub(package) fn checked_integer_literal_magnitude(
  source: Source,
  value: i64,
  start: i64,
  length: i64
) -> IntegerMagnitude {
  let spelled: IntegerMagnitude? = if start < 0 or length <= 0 { nil } else {
    match numeric_scan(source.all(), __i64_to_usize(start), ExpressionNumber) {
      IntegerSpelling(end, magnitude) -> if end == __i64_to_usize(start + length) {
        magnitude
      } else { nil }
      _ -> nil
    }
  }
  match spelled {
    found: IntegerMagnitude -> found
    nil -> ExactMagnitude(__i64_to_u64(value))
  }
}

-- The largest positive magnitude and, for signed primitives, the largest
-- negative magnitude an integer primitive holds.
type CheckedIntegerBounds {
  CheckedUnsignedBounds(u64),
  CheckedSignedBounds(u64, u64),
  CheckedNotInteger
}

fn checked_integer_bounds(primitive: SemanticPrimitive) -> CheckedIntegerBounds {
  match primitive {
    SemanticU8 -> CheckedUnsignedBounds(255)
    SemanticU16 -> CheckedUnsignedBounds(65535)
    SemanticU32 -> CheckedUnsignedBounds(4294967295)
    SemanticU64 -> CheckedUnsignedBounds(18446744073709551615)
    SemanticUsize -> CheckedUnsignedBounds(18446744073709551615)
    SemanticI8 -> CheckedSignedBounds(127, 128)
    SemanticI16 -> CheckedSignedBounds(32767, 32768)
    SemanticI32 -> CheckedSignedBounds(2147483647, 2147483648)
    SemanticI64 -> CheckedSignedBounds(9223372036854775807, 9223372036854775808)
    SemanticIsize -> CheckedSignedBounds(9223372036854775807, 9223372036854775808)
    _ -> CheckedNotInteger
  }
}

pub(package) fn checked_integer_literal_fits(
  primitive: SemanticPrimitive,
  magnitude: IntegerMagnitude,
  negated: bool
) -> bool {
  match magnitude {
    OversizedMagnitude(_) -> false
    ExactMagnitude(value) -> match checked_integer_bounds(primitive) {
      CheckedUnsignedBounds(largest) -> not negated and value <= largest
      CheckedSignedBounds(positive, negative) -> if negated { value <= negative } else {
        value <= positive
      }
      CheckedNotInteger -> false
    }
  }
}

-- The parser spells a negated integer literal as `0 - literal` over a zero
-- with no authored position, keeping the literal's own spelling for its
-- magnitude. That shape is the literal's value, span and negative magnitude.
pub(package) fn checked_negated_integer_literal(expression: Expr) -> Option<(i64, i64, i64)> {
  match expression {
    BinOp(2, IntLit(0, 0, 0), IntLit(value, start, length)) -> Some((value, start, length))
    _ -> None<(i64, i64, i64)>()
  }
}
