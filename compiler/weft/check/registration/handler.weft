-- Exact named-handler selection from a frozen module scope.
--
-- A `with` configuration names an imported module, not a value or an effect.
-- Keep that selection separate from checking the implementation's types and
-- clauses so neither phase has to recover a module from source spelling.

use compiler/project/identity.{
  HandlerImplementationIdentity,
  ModuleIdentity,
  handler_implementation_module,
  module_identity_package
}
use compiler/project/identity/equality.{
  handler_implementation_identity_eq,
  module_identity_eq
}
use compiler/project/module.{PrivateVisibility, PackageVisibility, PublicVisibility}
use compiler/weft/check/registration/catalog.{
  RegisteredHandler,
  RegisteredHandlerDeclaration,
  RegisteredModule
}
use compiler/weft/check/registration/scope.{
  RegistrationScope,
  ScopeModuleTarget,
  ScopeNameAmbiguous,
  ScopeNameMissing,
  ScopeNameResolved,
  registration_scope_find,
  registration_scope_lookup_span
}
use compiler/weft/check/storage.{dense_index}
use stdlib/option.{None, Some}
use stdlib/source.{Span}

pub(package) type RegisteredHandlerSelection {
  RegisteredHandlerSelected(RegisteredModule, RegisteredHandler),
  RegisteredHandlerAliasMissing,
  RegisteredHandlerAliasAmbiguous,
  RegisteredHandlerAliasNotModule,
  RegisteredHandlerImplementationMissing,
  RegisteredHandlerImplementationAmbiguous,
  RegisteredHandlerImplementationInvisible
}

fn handler_visible(
  handler: RegisteredHandler,
  target: ModuleIdentity,
  caller: ModuleIdentity
) -> bool {
  if module_identity_eq(target, caller) { true }
  else {
    match handler.visibility {
      PublicVisibility -> true
      PackageVisibility -> module_identity_package(target) == module_identity_package(caller)
      PrivateVisibility -> false
    }
  }
}

fn handler_in_module(
  module: RegisteredModule,
  caller: ModuleIdentity
) -> RegisteredHandlerSelection {
  let declarations = module.declarations
  let mut selected: RegisteredHandler? = nil
  let mut index: usize = 0
  while index < declarations.len() {
    let declaration = declarations.at(dense_index(index))
    match declaration.kind {
      RegisteredHandlerDeclaration(handler) -> match selected {
        existing: RegisteredHandler -> return RegisteredHandlerImplementationAmbiguous
        nil -> { selected = handler }
      }
      _ -> nil
    }
    index = index + 1
  }
  match selected {
    nil -> RegisteredHandlerImplementationMissing
    handler: RegisteredHandler -> if handler_visible(handler, module.identity, caller) {
      RegisteredHandlerSelected(module, handler)
    } else { RegisteredHandlerImplementationInvisible }
  }
}

pub(package) fn registration_scope_select_handler(
  scope: RegistrationScope,
  caller: ModuleIdentity,
  alias: Span
) -> RegisteredHandlerSelection {
  match registration_scope_lookup_span(scope, caller, alias) {
    ScopeNameMissing -> RegisteredHandlerAliasMissing
    ScopeNameAmbiguous(_, _) -> RegisteredHandlerAliasAmbiguous
    ScopeNameResolved(candidate) -> match candidate.target {
      ScopeModuleTarget(target) -> match registration_scope_find(scope, target) {
        Some(module) -> handler_in_module(module, caller)
        None -> RegisteredHandlerImplementationMissing
      }
      _ -> RegisteredHandlerAliasNotModule
    }
  }
}

-- A checked installation already names the implementation by identity. The
-- composer must not reinterpret the caller's source alias after checking.
pub(package) fn registration_scope_select_handler_identity(
  scope: RegistrationScope,
  caller: ModuleIdentity,
  identity: HandlerImplementationIdentity
) -> RegisteredHandlerSelection {
  match registration_scope_find(scope, handler_implementation_module(identity)) {
    None -> RegisteredHandlerImplementationMissing
    Some(module) -> match handler_in_module(module, caller) {
      RegisteredHandlerSelected(owner, handler) -> if handler_implementation_identity_eq(
        handler.identity,
        identity
      ) { RegisteredHandlerSelected(owner, handler) }
      else { RegisteredHandlerImplementationMissing }
      other -> other
    }
  }
}
