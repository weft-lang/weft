-- Typed registrations for compiler-produced native-binding declarations.
--
-- The package manifest owns their spelling and ABI and the source host owns
-- selection of the active target. This adapter retains ordinary private
-- declaration identities and their ABI kinds in the typed catalog; it does
-- not grant trust or expose symbols.

use compiler/package/manifest.{
  NativeSymbolFact,
  pkg_native_symbol_fact,
  pkg_native_target_symbols
}
use compiler/project/identity.{ModuleIdentity, ValueDeclaration}
use compiler/project/module.{PrivateVisibility}
use compiler/storage.{nlist_get, nlist_len}
use compiler/weft/check/registration/catalog.{RegisteredNativeFunction, synthetic_module_name}
use compiler/weft/check/registration/scope.{
  RegistrationBuilder,
  registration_builder_add_native
}

pub(package) fn retain_native_declarations(
  registrations: RegistrationBuilder,
  module: ModuleIdentity,
  target: i64
) -> nil {
  let symbols = pkg_native_target_symbols(target)
  for index in 0..nlist_len(symbols) {
    match pkg_native_symbol_fact(nlist_get(symbols, index)) {
      NativeSymbolFact(declaration, _, _, parameters, result, _) ->
        registration_builder_add_native(
          registrations,
          module,
          RegisteredNativeFunction {
            name: synthetic_module_name(module, ValueDeclaration, declaration, PrivateVisibility),
            parameters: parameters,
            result: result
          }
        )
    }
  }
  nil
}
