-- Typed registrations for compiler-produced native-binding declarations.
--
-- The package manifest owns their spelling and the source host owns selection
-- of the active target. This adapter retains only ordinary private declaration
-- identities in the typed catalog; it does not grant trust or expose symbols.

use compiler/package/manifest.{
  pkg_native_symbol_declaration_len,
  pkg_native_symbol_declaration_ptr,
  pkg_native_target_symbols,
  pkg_str_view
}
use compiler/project/identity.{ModuleIdentity, ValueDeclaration}
use compiler/project/module.{PrivateVisibility}
use compiler/storage.{nlist_get, nlist_len}
use compiler/weft/check/registration/catalog.{synthetic_module_name}
use compiler/weft/check/registration/scope.{
  RegistrationBuilder,
  registration_builder_add_synthetic
}

pub(package) fn retain_native_declarations(
  registrations: RegistrationBuilder,
  module: ModuleIdentity,
  target: i64
) -> nil {
  let symbols = pkg_native_target_symbols(target)
  for index in 0..nlist_len(symbols) {
    let symbol = nlist_get(symbols, index)
    registration_builder_add_synthetic(
      registrations,
      synthetic_module_name(
        module,
        ValueDeclaration,
        pkg_str_view(
          pkg_native_symbol_declaration_ptr(symbol),
          pkg_native_symbol_declaration_len(symbol)
        ),
        PrivateVisibility
      )
    )
  }
  nil
}
