-- Bounded join between typed declaration identity and legacy semantic storage.
--
-- Name and visibility decisions belong to RegistrationScope. The raw checker
-- table remains only the physical owner of semantic type/body cells until the
-- typed stores replace it; no caller should perform a second raw name lookup.

use compiler/project/identity.{
  DeclarationIdentity,
  DeclarationNamespace,
  ModuleIdentity,
  ModuleDeclarationIdentity,
  MemberDeclarationIdentity,
  NamedModuleIdentity,
  AnonymousModuleIdentity,
  declaration_identity_name,
  declaration_identity_namespace,
  declaration_namespace_code
}
use compiler/project/identity/equality.{module_identity_eq}
use compiler/project/module.{
  ModuleNameResolution,
  MissingModuleName,
  InvisibleModuleName,
  AmbiguousModuleName,
  PublicVisibility,
  ResolvedDeclarationName,
  ResolvedModuleName,
  module_decl_fact_find_indexed,
  module_decl_fact_id,
  module_fact_entry_anonymous,
  module_fact_entry_package,
  module_fact_entry_source,
  module_fact_find_path,
  module_fact_module_at,
  module_fact_module_count,
  module_id_from_entry
}
use compiler/weft/check/registration/catalog.{RegisteredName, RegisteredModule}
use compiler/weft/check/registration/scope.{
  RegistrationScope,
  ScopeEntry,
  ScopeEntryResolved,
  ScopeCandidate,
  ScopeDeclarationTarget,
  ScopeModuleTarget,
  ScopeNameResolved,
  QualifiedScopeResolved,
  QualifiedScopeInvisible,
  QualifiedScopeAmbiguous,
  QualifiedScopeMissing,
  registration_scope_at,
  registration_scope_candidate_declaration,
  registration_scope_declaration_from_lookup,
  registration_scope_declaration_is_weak_only,
  registration_scope_entry_at,
  registration_scope_entry_count_at,
  registration_scope_len,
  scope_entry_is_type_constructor_pair,
  registration_scope_lookup_at,
  registration_scope_lookup_qualified_declaration_span,
  registration_scope_lookup_span_at,
  registration_name_belongs_to,
  registration_scope_declaration_spelling_is_unique,
  registration_scope_module_alias,
  registration_scope_visible_declaration_spelling,
  registration_scope_qualified_from_lookup
}
use stdlib/map as map
use stdlib/map.{Map}
use stdlib/option.{Option, Some, None}
use stdlib/source.{Span}

pub(package) type RegistrationStorage = opaque(
  i64,
  RegistrationScope,
  Map<i64, i64>
)

-- A resolved declaration spelling projected for diagnostics. Name selection
-- stays owned by RegistrationScope; consumers cannot inspect or rebuild its
-- import graph merely to offer a nearby-name suggestion.
pub(package) type RegistrationNameCandidate {
  spelling: str,
  declaration: DeclarationIdentity,
  origin: Option<Span>
}

-- One resolved spelling in a module's typed scope. Stable fact producers use
-- this projection instead of walking the legacy module-scope table.
pub(package) type RegistrationVisibleName {
  RegistrationVisibleDeclaration(str, DeclarationIdentity),
  RegistrationVisibleModule(str, ModuleIdentity)
}

-- A public facade spelling and the root declaration it re-exports. Doc
-- generation consumes this projection instead of reconstructing import
-- ownership and type-constructor pairing from the legacy scope table.
pub(package) type RegistrationPublicReexport {
  RegistrationReexport(str, DeclarationIdentity)
}

pub(package) fn registration_storage(
  table: i64,
  registrations: RegistrationScope
) -> RegistrationStorage {
  let mut index = map.new<i64, i64>()
  let length = __u64_to_i64(__usize_to_u64(registration_scope_len(registrations)))
  for ordinal in 0..length {
    let module = registration_scope_at(registrations, ordinal)
    let entry = module_entry_for_identity(table, module.identity)
    if entry != 0 {
      let source = module_fact_entry_source(entry)
      -- Retained source buffers and raw module entries are distinct live
      -- allocations. One scalar map therefore indexes source -> entry and
      -- entry -> typed ordinal without widening the storage ABI.
      index = index.insert(source, entry)
      index = index.insert(entry, ordinal)
    } else { nil }
  }
  RegistrationStorage((table, registrations, index))
}

fn module_entry_for_identity(table: i64, identity: ModuleIdentity) -> i64 {
  match identity {
    NamedModuleIdentity(path, package_id) -> module_fact_find_path(
      table,
      __str_ptr(path),
      __str_len(path),
      package_id
    )
    AnonymousModuleIdentity(ordinal, package_id) -> {
      let mut index: i64 = 0
      while index < module_fact_module_count(table) {
        let entry = module_fact_module_at(table, index)
        if module_fact_entry_anonymous(entry) == __u64_to_i64(__usize_to_u64(ordinal)) and
          module_fact_entry_package(entry) == package_id {
            return entry
          }
        index = index + 1
      }
      0
    }
  }
}

fn span_start(span: Span) -> i64 {
  __u64_to_i64(__usize_to_u64(span.start()))
}

fn span_length(span: Span) -> i64 {
  __u64_to_i64(__usize_to_u64(span.len()))
}

pub(package) fn registration_storage_declaration(
  storage: borrow RegistrationStorage,
  identity: DeclarationIdentity
) -> i64 {
  match storage {
    RegistrationStorage((table, _, index)) -> match identity {
      ModuleDeclarationIdentity(module, namespace, name) -> {
        let entry = match index.get(__str_ptr(name.source().text)) {
          Some(found) -> found
          None -> module_entry_for_identity(table, module)
        }
        module_decl_fact_find_indexed(
          table,
          entry,
          0,
          declaration_namespace_code(namespace),
          __str_ptr(name.source().text),
          span_start(name),
          span_length(name)
        )
      }
      MemberDeclarationIdentity(owner, namespace, name) -> {
        let raw_owner = registration_storage_declaration(storage, owner)
        if raw_owner == 0 { 0 }
        else {
          module_decl_fact_find_indexed(
            table,
            0,
            raw_owner,
            declaration_namespace_code(namespace),
            __str_ptr(name.source().text),
            span_start(name),
            span_length(name)
          )
        }
      }
    }
  }
}

fn registered_module_span(
  module: RegisteredModule,
  source: i64,
  start: i64,
  length: i64
) -> Option<Span> {
  let absolute = source + start
  let retained = __str_ptr(module.source.text)
  let offset = absolute - retained
  let source_length = __str_len(module.source.text)
  if start < 0 or length < 0 or absolute < retained or offset > source_length or
    length > source_length - offset { None<Span>() }
  else {
    module.source.span(
      __i64_to_usize(offset),
      __i64_to_usize(offset + length)
    )
  }
}

fn registered_span(
  registrations: borrow RegistrationScope,
  source: i64,
  start: i64,
  length: i64
) -> Option<Span> {
  let count = __u64_to_i64(__usize_to_u64(registration_scope_len(registrations)))
  for ordinal in 0..count {
    match registered_module_span(
      registration_scope_at(registrations, ordinal),
      source,
      start,
      length
    ) {
      Some(span) -> return Some(span)
      None -> nil
    }
  }
  None<Span>()
}

fn source_module(
  index: borrow Map<i64, i64>,
  registrations: borrow RegistrationScope,
  source: i64
) -> Option<(ModuleIdentity, RegisteredModule, i64)> {
  match index.get(source) {
    Some(entry) -> match index.get(entry) {
      Some(ordinal) -> {
        let module = registration_scope_at(registrations, ordinal)
        Some((module.identity, module, ordinal))
      }
      None -> None<(ModuleIdentity, RegisteredModule, i64)>()
    }
    None -> None<(ModuleIdentity, RegisteredModule, i64)>()
  }
}

pub(package) fn registration_storage_has_source(
  storage: borrow RegistrationStorage,
  source: i64
) -> bool {
  match storage {
    RegistrationStorage((_, registrations, index)) -> match source_module(
      index,
      registrations,
      source
    ) {
      Some(_) -> true
      None -> false
    }
  }
}

pub(package) fn registration_storage_visible_declaration_name(
  storage: borrow RegistrationStorage,
  caller_source: i64,
  declaration: i64
) -> Option<str> {
  if declaration == 0 { None<str>() }
  else {
    match storage {
      RegistrationStorage((_, registrations, index)) -> match source_module(
        index,
        registrations,
        caller_source
      ) {
        Some((caller, _, _)) -> registration_scope_visible_declaration_spelling(
          registrations,
          caller,
          module_decl_fact_id(declaration)
        )
        None -> None<str>()
      }
    }
  }
}

pub(package) fn registration_storage_declaration_module_alias(
  storage: borrow RegistrationStorage,
  caller_source: i64,
  declaration: i64
) -> Option<str> {
  if declaration == 0 { None<str>() }
  else {
    match module_decl_fact_id(declaration) {
      ModuleDeclarationIdentity(target, _, _) -> match storage {
        RegistrationStorage((_, registrations, index)) -> match source_module(
          index,
          registrations,
          caller_source
        ) {
          Some((caller, _, _)) -> registration_scope_module_alias(
            registrations,
            caller,
            target
          )
          None -> None<str>()
        }
      }
      MemberDeclarationIdentity(_, _, _) -> None<str>()
    }
  }
}

pub(package) fn registration_storage_declaration_name_is_unique(
  storage: borrow RegistrationStorage,
  declaration: i64
) -> bool {
  if declaration == 0 { false }
  else {
    match storage {
      RegistrationStorage((_, registrations, _)) ->
        registration_scope_declaration_spelling_is_unique(
          registrations,
          module_decl_fact_id(declaration)
        )
    }
  }
}

pub(package) fn registration_storage_name_candidate_count(
  storage: borrow RegistrationStorage,
  source: i64
) -> usize {
  let zero: usize = 0
  match storage {
    RegistrationStorage((_, registrations, index)) -> match source_module(
      index,
      registrations,
      source
    ) {
      Some((_, _, ordinal)) -> registration_scope_entry_count_at(registrations, ordinal)
      None -> zero
    }
  }
}

pub(package) fn registration_storage_name_candidate_at(
  storage: borrow RegistrationStorage,
  source: i64,
  index: i64
) -> Option<RegistrationNameCandidate> {
  match storage {
    RegistrationStorage((_, registrations, sources)) -> match source_module(
      sources,
      registrations,
      source
    ) {
      Some((_, _, ordinal)) -> {
        let count = registration_scope_entry_count_at(registrations, ordinal)
        if index < 0 or index >= __u64_to_i64(__usize_to_u64(count)) {
          None<RegistrationNameCandidate>()
        } else {
          let entry = registration_scope_entry_at(registrations, ordinal, index)
          match entry.status {
            ScopeEntryResolved -> match entry.primary.target {
              ScopeDeclarationTarget(name) -> match declaration_identity_namespace(name.identity) {
                ValueDeclaration -> Some(
                  RegistrationNameCandidate {
                    spelling: entry.spelling,
                    declaration: name.identity,
                    origin: entry.primary.origin
                  }
                )
                ConstructorDeclaration -> Some(
                  RegistrationNameCandidate {
                    spelling: entry.spelling,
                    declaration: name.identity,
                    origin: entry.primary.origin
                  }
                )
                _ -> None<RegistrationNameCandidate>()
              }
              ScopeModuleTarget(_) -> None<RegistrationNameCandidate>()
            }
            _ -> None<RegistrationNameCandidate>()
          }
        }
      }
      None -> None<RegistrationNameCandidate>()
    }
  }
}

pub(package) fn registration_storage_visible_name_count(
  storage: borrow RegistrationStorage,
  source: i64
) -> usize {
  registration_storage_name_candidate_count(storage, source)
}

fn registration_type_candidate(
  candidate: ScopeCandidate
) -> Option<DeclarationIdentity> {
  match candidate.target {
    ScopeDeclarationTarget(name) -> match declaration_identity_namespace(name.identity) {
      TypeDeclaration -> Some(name.identity)
      _ -> None<DeclarationIdentity>()
    }
    ScopeModuleTarget(_) -> None<DeclarationIdentity>()
  }
}

fn registration_entry_type_candidate(entry: ScopeEntry) -> Option<DeclarationIdentity> {
  match registration_type_candidate(entry.primary) {
    Some(identity) -> Some(identity)
    None -> match entry.conflict {
      Some(candidate) -> registration_type_candidate(candidate)
      None -> None<DeclarationIdentity>()
    }
  }
}

pub(package) fn registration_storage_visible_name_at(
  storage: borrow RegistrationStorage,
  source: i64,
  position: i64
) -> Option<RegistrationVisibleName> {
  match storage {
    RegistrationStorage((_, registrations, sources)) -> match source_module(
      sources,
      registrations,
      source
    ) {
      Some((_, _, ordinal)) -> {
        let count = registration_scope_entry_count_at(registrations, ordinal)
        if position < 0 or position >= __u64_to_i64(__usize_to_u64(count)) {
          None<RegistrationVisibleName>()
        } else {
          let entry = registration_scope_entry_at(registrations, ordinal, position)
          match entry.status {
            ScopeEntryResolved -> match entry.primary.target {
              ScopeDeclarationTarget(name) -> Some(
                RegistrationVisibleDeclaration(entry.spelling, name.identity)
              )
              ScopeModuleTarget(module) -> Some(RegistrationVisibleModule(entry.spelling, module))
            }
            ScopeEntryAmbiguous -> if scope_entry_is_type_constructor_pair(entry) {
              match registration_entry_type_candidate(entry) {
                Some(identity) -> Some(RegistrationVisibleDeclaration(entry.spelling, identity))
                None -> None<RegistrationVisibleName>()
              }
            } else { None<RegistrationVisibleName>() }
          }
        }
      }
      None -> None<RegistrationVisibleName>()
    }
  }
}

fn registration_candidate_public(candidate: ScopeCandidate) -> bool {
  match candidate.visibility {
    PublicVisibility -> true
    _ -> false
  }
}

fn registration_reexport_root(
  candidate: ScopeCandidate,
  caller: ModuleIdentity
) -> Option<DeclarationIdentity> {
  if not registration_candidate_public(candidate) { None<DeclarationIdentity>() }
  else {
    match candidate.target {
      ScopeDeclarationTarget(name) -> match name.identity {
        ModuleDeclarationIdentity(owner, namespace, _) -> if module_identity_eq(owner, caller) {
          None<DeclarationIdentity>()
        } else {
          match namespace {
            ValueDeclaration -> Some(name.identity)
            TypeDeclaration -> Some(name.identity)
            EffectDeclaration -> Some(name.identity)
            TraitDeclaration -> Some(name.identity)
            _ -> None<DeclarationIdentity>()
          }
        }
        MemberDeclarationIdentity(_, _, _) -> None<DeclarationIdentity>()
      }
      ScopeModuleTarget(_) -> None<DeclarationIdentity>()
    }
  }
}

fn registration_type_reexport_root(
  first: ScopeCandidate,
  second: Option<ScopeCandidate>,
  caller: ModuleIdentity
) -> Option<DeclarationIdentity> {
  match registration_reexport_root(first, caller) {
    Some(identity) -> match declaration_identity_namespace(identity) {
      TypeDeclaration -> Some(identity)
      _ -> match second {
        Some(candidate) -> registration_reexport_root(candidate, caller)
        None -> None<DeclarationIdentity>()
      }
    }
    None -> match second {
      Some(candidate) -> registration_reexport_root(candidate, caller)
      None -> None<DeclarationIdentity>()
    }
  }
}

pub(package) fn registration_storage_public_reexport_count(
  storage: borrow RegistrationStorage,
  source: i64
) -> usize {
  registration_storage_visible_name_count(storage, source)
}

pub(package) fn registration_storage_public_reexport_at(
  storage: borrow RegistrationStorage,
  source: i64,
  position: i64
) -> Option<RegistrationPublicReexport> {
  match storage {
    RegistrationStorage((_, registrations, sources)) -> match source_module(
      sources,
      registrations,
      source
    ) {
      Some((caller, _, ordinal)) -> {
        let count = registration_scope_entry_count_at(registrations, ordinal)
        if position < 0 or position >= __u64_to_i64(__usize_to_u64(count)) {
          None<RegistrationPublicReexport>()
        } else {
          let entry = registration_scope_entry_at(registrations, ordinal, position)
          let root = match entry.status {
            ScopeEntryResolved -> registration_reexport_root(entry.primary, caller)
            ScopeEntryAmbiguous -> if scope_entry_is_type_constructor_pair(entry) {
              registration_type_reexport_root(entry.primary, entry.conflict, caller)
            } else { None<DeclarationIdentity>() }
          }
          match root {
            Some(identity) -> Some(RegistrationReexport(entry.spelling, identity))
            None -> None<RegistrationPublicReexport>()
          }
        }
      }
      None -> None<RegistrationPublicReexport>()
    }
  }
}

pub(package) fn registration_storage_declaration_is_weak_only(
  storage: borrow RegistrationStorage,
  caller_source: i64,
  declaration: i64
) -> bool {
  if declaration == 0 { false }
  else {
    match storage {
      RegistrationStorage((_, registrations, index)) -> match source_module(
        index,
        registrations,
        caller_source
      ) {
        Some((caller, _, _)) -> registration_scope_declaration_is_weak_only(
          registrations,
          caller,
          module_decl_fact_id(declaration)
        )
        None -> false
      }
    }
  }
}

fn module_ordinal(
  table: i64,
  index: borrow Map<i64, i64>,
  identity: ModuleIdentity
) -> i64 {
  let entry = module_entry_for_identity(table, identity)
  if entry == 0 { 0 - 1 }
  else { index.get(entry).unwrap_or(0 - 1) }
}

fn qualified_lookup(
  table: i64,
  registrations: borrow RegistrationScope,
  index: borrow Map<i64, i64>,
  caller: ModuleIdentity,
  caller_ordinal: i64,
  qualifier: Span,
  spelling: Span
) -> QualifiedScopeLookup {
  match registration_scope_lookup_span_at(registrations, caller_ordinal, qualifier) {
    ScopeNameResolved(candidate) -> match candidate.target {
      ScopeModuleTarget(target) -> {
        let target_ordinal = module_ordinal(table, index, target)
        registration_scope_qualified_from_lookup(
          registration_scope_lookup_span_at(registrations, target_ordinal, spelling),
          target,
          caller
        )
      }
      _ -> QualifiedScopeMissing
    }
    _ -> QualifiedScopeMissing
  }
}

pub(package) fn registration_storage_lookup_declaration(
  storage: borrow RegistrationStorage,
  source: i64,
  namespace: DeclarationNamespace,
  name_source: i64,
  name_start: i64,
  name_length: i64
) -> i64 {
  match storage {
    RegistrationStorage((_, registrations, index)) -> match source_module(
      index,
      registrations,
      source
    ) {
      Some((_, module, ordinal)) -> match match registered_module_span(
        module,
        name_source,
        name_start,
        name_length
      ) {
        Some(spelling) -> Some(spelling)
        None -> registered_span(registrations, name_source, name_start, name_length)
      } {
        Some(spelling) -> match registration_scope_declaration_from_lookup(
          registration_scope_lookup_span_at(registrations, ordinal, spelling),
          namespace
        ) {
          Some(registered) -> registration_storage_declaration(storage, registered.identity)
          None -> 0
        }
        None -> 0
      }
      None -> 0
    }
  }
}

pub(package) fn registration_storage_lookup_local_declaration(
  storage: borrow RegistrationStorage,
  source: i64,
  namespace: DeclarationNamespace,
  name_source: i64,
  name_start: i64,
  name_length: i64
) -> i64 {
  match storage {
    RegistrationStorage((_, registrations, index)) -> match source_module(
      index,
      registrations,
      source
    ) {
      Some((module_identity, module, ordinal)) -> match registered_module_span(
        module,
        name_source,
        name_start,
        name_length
      ) {
        Some(spelling) -> match registration_scope_declaration_from_lookup(
          registration_scope_lookup_span_at(registrations, ordinal, spelling),
          namespace
        ) {
          Some(registered) -> if registration_name_belongs_to(
            registered,
            module_identity
          ) {
            registration_storage_declaration(storage, registered.identity)
          } else { 0 }
          None -> 0
        }
        None -> 0
      }
      None -> 0
    }
  }
}

pub(package) fn registration_storage_lookup_declaration_text(
  storage: borrow RegistrationStorage,
  source: i64,
  namespace: DeclarationNamespace,
  spelling: str
) -> i64 {
  match storage {
    RegistrationStorage((_, registrations, index)) -> match source_module(
      index,
      registrations,
      source
    ) {
      Some((_, _, ordinal)) -> match registration_scope_declaration_from_lookup(
        registration_scope_lookup_at(registrations, ordinal, spelling),
        namespace
      ) {
        Some(registered) -> registration_storage_declaration(storage, registered.identity)
        None -> 0
      }
      None -> 0
    }
  }
}

pub(package) fn registration_storage_lookup_qualified_declaration(
  storage: borrow RegistrationStorage,
  source: i64,
  qualifier_source: i64,
  qualifier_start: i64,
  qualifier_length: i64,
  namespace: DeclarationNamespace,
  name_source: i64,
  name_start: i64,
  name_length: i64
) -> i64 {
  match storage {
    RegistrationStorage((table, registrations, index)) -> match source_module(
      index,
      registrations,
      source
    ) {
      Some((module_identity, module, _)) -> match (
        registered_module_span(module, qualifier_source, qualifier_start, qualifier_length),
        registered_module_span(module, name_source, name_start, name_length)
      ) {
        (Some(qualifier), Some(spelling)) ->
          match registration_scope_lookup_qualified_declaration_span(
            registrations,
            module_identity,
            qualifier,
            namespace,
            spelling
          ) {
            Some(registered) -> registration_storage_declaration(storage, registered.identity)
            None -> 0
          }
        _ -> 0
      }
      None -> 0
    }
  }
}

pub(package) fn registration_storage_resolve_qualified_name(
  storage: borrow RegistrationStorage,
  source: i64,
  qualifier_source: i64,
  qualifier_start: i64,
  qualifier_length: i64,
  name_source: i64,
  name_start: i64,
  name_length: i64
) -> ModuleNameResolution {
  match storage {
    RegistrationStorage((table, registrations, index)) -> match source_module(
      index,
      registrations,
      source
    ) {
      Some((module_identity, module, ordinal)) -> match (
        registered_module_span(module, qualifier_source, qualifier_start, qualifier_length),
        registered_module_span(module, name_source, name_start, name_length)
      ) {
        (Some(qualifier), Some(spelling)) -> match qualified_lookup(
          table,
          registrations,
          index,
          module_identity,
          ordinal,
          qualifier,
          spelling
        ) {
          QualifiedScopeMissing -> MissingModuleName
          QualifiedScopeAmbiguous(_, _) -> AmbiguousModuleName
          QualifiedScopeInvisible(_) -> InvisibleModuleName
          QualifiedScopeResolved(candidate) -> match candidate.target {
            ScopeDeclarationTarget(declaration) ->
              ResolvedDeclarationName(declaration.identity)
            ScopeModuleTarget(target) -> ResolvedModuleName(target)
          }
        }
        _ -> MissingModuleName
      }
      None -> MissingModuleName
    }
  }
}

fn diagnostic_candidate_declaration(
  storage: borrow RegistrationStorage,
  candidate: ScopeCandidate,
  namespace: DeclarationNamespace
) -> i64 {
  match candidate.target {
    ScopeDeclarationTarget(declaration) -> if declaration_namespace_code(
      declaration_identity_namespace(declaration.identity)
    ) == declaration_namespace_code(namespace) {
      registration_storage_declaration(storage, declaration.identity)
    } else { 0 }
    _ -> 0
  }
}

pub(package) fn registration_storage_lookup_qualified_declaration_for_diagnostic(
  storage: borrow RegistrationStorage,
  source: i64,
  qualifier_source: i64,
  qualifier_start: i64,
  qualifier_length: i64,
  namespace: DeclarationNamespace,
  name_source: i64,
  name_start: i64,
  name_length: i64
) -> i64 {
  match storage {
    RegistrationStorage((table, registrations, index)) -> match source_module(
      index,
      registrations,
      source
    ) {
      Some((module_identity, module, ordinal)) -> match (
        registered_module_span(module, qualifier_source, qualifier_start, qualifier_length),
        registered_module_span(module, name_source, name_start, name_length)
      ) {
        (Some(qualifier), Some(spelling)) ->
          match qualified_lookup(
            table,
            registrations,
            index,
            module_identity,
            ordinal,
            qualifier,
            spelling
          ) {
            QualifiedScopeResolved(found) ->
              diagnostic_candidate_declaration(storage, found, namespace)
            QualifiedScopeInvisible(found) ->
              diagnostic_candidate_declaration(storage, found, namespace)
            _ -> 0
          }
        _ -> 0
      }
      None -> 0
    }
  }
}

pub(package) fn registration_storage_lookup_module(
  storage: borrow RegistrationStorage,
  source: i64,
  qualifier_source: i64,
  qualifier_start: i64,
  qualifier_length: i64
) -> i64 {
  match storage {
    RegistrationStorage((table, registrations, index)) -> match source_module(
      index,
      registrations,
      source
    ) {
      Some((_, module, ordinal)) -> match registered_module_span(
        module,
        qualifier_source,
        qualifier_start,
        qualifier_length
      ) {
        Some(qualifier) -> match registration_scope_lookup_span_at(
          registrations,
          ordinal,
          qualifier
        ) {
          ScopeNameResolved(candidate) -> match candidate.target {
            ScopeModuleTarget(target) -> module_entry_for_identity(table, target)
            _ -> 0
          }
          _ -> 0
        }
        None -> 0
      }
      None -> 0
    }
  }
}

pub(package) fn registration_storage_qualifier_is_module(
  storage: borrow RegistrationStorage,
  source: i64,
  qualifier_source: i64,
  qualifier_start: i64,
  qualifier_length: i64
) -> bool {
  registration_storage_lookup_module(
    storage,
    source,
    qualifier_source,
    qualifier_start,
    qualifier_length
  ) != 0
}
