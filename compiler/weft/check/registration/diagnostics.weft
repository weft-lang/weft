-- Structured diagnostics projected from the retained typed registration scope.

use compiler/project/module.{
  ModuleNameResolution,
  MissingModuleName,
  InvisibleModuleName,
  AmbiguousModuleName,
  WidenedReexportName
}
use compiler/project/diagnostics.{
  module_diagnostic_message,
  module_diagnostic_resolution_code,
  module_diagnostic_resolution_name
}
use compiler/weft/check/registration/scope.{*}
use stdlib/diagnostic.{Diagnose}
use stdlib/diagnostic/schema.{*}
use stdlib/option.{Option, Some, None}
use stdlib/source.{Span}

fn optional_location(span: Option<Span>) -> DiagnosticLocation {
  match span {
    Some(location) -> location.location()
    None -> DiagnosticLocationNone
  }
}

fn candidate_location(candidate: ScopeCandidate) -> DiagnosticLocation {
  optional_location(candidate.origin)
}

fn related_candidate(
  label: str,
  candidate: Option<ScopeCandidate>,
  rest: DiagnosticRelatedLocationList
) -> DiagnosticRelatedLocationList {
  match candidate {
    Some(found) -> DiagnosticRelatedLocationCons(
      DiagnosticRelatedLocation(label, candidate_location(found)),
      rest
    )
    None -> rest
  }
}

fn related_candidates(
  primary: Option<ScopeCandidate>,
  conflict: Option<ScopeCandidate>
) -> DiagnosticRelatedLocationList {
  related_candidate(
    "declaration is here",
    primary,
    related_candidate("conflicting declaration", conflict, DiagnosticRelatedLocationNil)
  )
}

fn issue_resolution(status: ScopeIssueStatus) -> ModuleNameResolution {
  match status {
    ScopeImportMissing -> MissingModuleName
    ScopeImportInvisible -> InvisibleModuleName
    ScopeImportWidenedReexport -> WidenedReexportName
    ScopeImportAmbiguous -> AmbiguousModuleName
  }
}

fn issue_message(issue: ScopeIssue) -> str {
  match issue.status {
    ScopeImportMissing -> module_diagnostic_message(
      "unknown module member ",
      issue.spelling,
      " in import"
    )
    ScopeImportInvisible -> module_diagnostic_message(
      "module member ",
      issue.spelling,
      " is not visible in this import"
    )
    ScopeImportWidenedReexport -> module_diagnostic_message(
      "module member ",
      issue.spelling,
      " cannot be re-exported at wider visibility"
    )
    ScopeImportAmbiguous -> module_diagnostic_message(
      "module member ",
      issue.spelling,
      " is ambiguous in this import"
    )
  }
}

fn diagnostic_fields(
  name: str,
  resolution: ModuleNameResolution
) -> DiagnosticFieldList {
  DiagnosticFieldCons(
    DiagnosticFieldText("name", name),
    DiagnosticFieldCons(
      DiagnosticFieldText("resolution", module_diagnostic_resolution_name(resolution)),
      DiagnosticFieldNil
    )
  )
}

fn issue_diagnostic(issue: ScopeIssue) -> Diagnostic {
  let resolution = issue_resolution(issue.status)
  Diagnostic(
    DiagnosticSeverityError,
    DiagnosticClassModule,
    module_diagnostic_resolution_code(resolution),
    issue_message(issue),
    optional_location(issue.location),
    related_candidates(issue.primary, issue.conflict),
    diagnostic_fields(issue.spelling, resolution)
  )
}

fn collision_diagnostic(entry: ScopeEntry) -> Diagnostic {
  let resolution = AmbiguousModuleName()
  let primary = match entry.conflict {
    Some(conflict) -> candidate_location(conflict)
    None -> candidate_location(entry.primary)
  }
  Diagnostic(
    DiagnosticSeverityError,
    DiagnosticClassModule,
    module_diagnostic_resolution_code(resolution),
    module_diagnostic_message("module item ", entry.spelling, " is ambiguous in this scope"),
    primary,
    related_candidates(Some(entry.primary), entry.conflict),
    diagnostic_fields(entry.spelling, resolution)
  )
}

pub(package) fn diagnose(scope: RegistrationScope) -[Diagnose]> i64 {
  let mut errors: i64 = 0
  for index in 0..registration_scope_issue_count(scope).to_u64().to_i64_checked().unwrap() {
    Diagnose.report(issue_diagnostic(registration_scope_issue_at(scope, index)))
    errors = errors + 1
  }
  for module_index in 0..registration_scope_len(scope).to_u64().to_i64_checked().unwrap() {
    let count = registration_scope_entry_count_at(scope, module_index)
    for entry_index in 0..count.to_u64().to_i64_checked().unwrap() {
      let entry = registration_scope_entry_at(scope, module_index, entry_index)
      match entry.status {
        ScopeEntryResolved -> nil
        ScopeEntryAmbiguous -> if scope_entry_is_type_constructor_pair(entry) { nil }
        else {
          Diagnose.report(collision_diagnostic(entry))
          errors = errors + 1
        }
      }
    }
  }
  errors
}
