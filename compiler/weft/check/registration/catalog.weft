-- Typed declaration registration over grammar-owned Weft syntax.
--
-- Registration assigns semantic identities but does not resolve annotations,
-- check bodies, or rewrite the authored tree. The catalog retains both the
-- complete parsed syntax and its Source.

use compiler/project/identity.{*}
use compiler/project/module.{DeclVisibility, PrivateVisibility}
use compiler/source/trust.{SourceAuthority, StrictSourceAuthority}
use compiler/weft/check/storage.{
  DenseSegment,
  dense_builder,
  dense_builder_with_capacity,
  dense_index
}
use compiler/weft/syntax/declarations.{*}
use compiler/weft/syntax/imports.{ImportDeclaration}
use compiler/ir/data.{*}
use stdlib/list.{List, Nil}
use stdlib/option.{Some, None}
use stdlib/panic.{panic}
use stdlib/diagnostic/schema.{DiagnosticSourceUnknown}
use stdlib/source.{Source, Span}

pub(package) type RegisteredName {
  identity: DeclarationIdentity,
  range: TypeNameRange,
  visibility: DeclVisibility
}

pub(package) type RegisteredFunction {
  identity: FunctionIdentity,
  syntax: FunctionSyntax,
  visibility: DeclVisibility,
  native_owner: DeclarationIdentity?,
  target: TypeExpr?,
  self_trait: TypeExpr?
}

pub(package) type RegisteredRecordField {
  name: RegisteredName,
  syntax: RecordFieldSyntax
}

pub(package) type RegisteredVariantMember {
  name: RegisteredName,
  syntax: VariantMemberSyntax
}

pub(package) type RegisteredType {
  RegisteredRecordType(RegisteredName, TypeParamList, List<RegisteredRecordField>),
  RegisteredVariantType(RegisteredName, TypeParamList, List<RegisteredVariantMember>),
  RegisteredOpaqueType(RegisteredName, TypeParamList, TypeExpr),
  RegisteredAliasType(RegisteredName, TypeParamList, TypeExpr)
}

pub(package) type RegisteredEffectOperation {
  name: RegisteredName,
  syntax: TypeEffectOp
}

pub(package) type RegisteredEffect {
  name: RegisteredName,
  type_params: TypeParamList,
  operations: List<RegisteredEffectOperation>
}

pub(package) type RegisteredTraitMember {
  RegisteredTraitMethod(RegisteredName, TypeTraitMember),
  RegisteredAssociatedType(RegisteredName, TypeTraitMember),
  RegisteredInvalidTraitMember(TypeTraitMember)
}

pub(package) type RegisteredTrait {
  name: RegisteredName,
  members: List<RegisteredTraitMember>
}

pub(package) type RegisteredImplMember {
  RegisteredImplMethod(RegisteredFunction, DeclVisibility),
  RegisteredImplTypeBinding(TypeNameRange, TypeExpr, TypeNameRange?)
}

pub(package) type RegisteredImpl {
  name: TypeNameRange,
  type_params: TypeParamList,
  target: TypeImplTarget,
  members: List<RegisteredImplMember>
}

pub(package) type RegisteredConstant {
  name: RegisteredName,
  declared_type: TypeExpr,
  initializer: Expr
}

pub(package) type RegisteredHandler {
  identity: HandlerImplementationIdentity,
  syntax: ModuleHandlerSyntax,
  visibility: DeclVisibility
}

pub(package) type RegisteredDefaultHandler {
  syntax: DefaultHandlerSyntax,
  visibility: DeclVisibility
}

pub(package) type RegisteredDeclarationKind {
  RegisteredFunctionDeclaration(RegisteredFunction),
  RegisteredTypeDeclaration(RegisteredType),
  RegisteredEffectDeclaration(RegisteredEffect),
  RegisteredTraitDeclaration(RegisteredTrait),
  RegisteredImplDeclaration(RegisteredImpl),
  RegisteredConstantDeclaration(RegisteredConstant),
  RegisteredHandlerDeclaration(RegisteredHandler),
  RegisteredDefaultHandlerDeclaration(RegisteredDefaultHandler),
  RegisteredImportDeclaration,
  RegisteredTestDeclaration(TestSyntax),
  RegisteredInvalidDeclaration
}

pub(package) type RegisteredDeclaration {
  authored: SourceDeclaration,
  kind: RegisteredDeclarationKind
}

pub(package) type RegisteredModule {
  identity: ModuleIdentity,
  source: Source,
  authority: SourceAuthority,
  internal_ownership_allowed: bool,
  syntax: ParsedModuleSyntax,
  declarations: DenseSegment<RegisteredDeclaration>,
  functions: DenseSegment<RegisteredFunction>
}

pub(package) type RegistrationSummary {
  declarations: usize,
  named_declarations: usize,
  functions: usize,
  types: usize,
  effects: usize,
  traits: usize,
  implementations: usize,
  constants: usize,
  handlers: usize,
  default_handlers: usize,
  imports: usize,
  tests: usize,
  invalid: usize
}

fn name_span(source: Source, range: TypeNameRange) -> Span {
  match source.span(
    __i64_to_usize(range.start),
    __i64_to_usize(range.start + range.length)
  ) {
    Some(span) -> span
    None -> panic("registered declaration name is outside its retained source")
  }
}

fn module_name(
  module: ModuleIdentity,
  source: Source,
  namespace: DeclarationNamespace,
  range: TypeNameRange,
  visibility: DeclVisibility
) -> RegisteredName {
  RegisteredName {
    identity: ModuleDeclarationIdentity(module, namespace, name_span(source, range)),
    range: range,
    visibility: visibility
  }
}

-- Compiler-generated declarations still belong to a retained module and use
-- ranges in that module's source. Publish them through the same semantic name
-- shape as authored declarations so later scope consumers never need to
-- rediscover them in the legacy checker table.
pub(package) fn registered_module_name(
  module: RegisteredModule,
  namespace: DeclarationNamespace,
  range: TypeNameRange,
  visibility: DeclVisibility
) -> RegisteredName {
  module_name(module.identity, module.source, namespace, range, visibility)
}

-- Native bindings publish private declarations from manifest data rather than
-- authored module syntax. Retain their spelling and semantic identity in the
-- same typed catalog without inventing a source location for generated text.
pub(package) fn synthetic_module_name(
  module: ModuleIdentity,
  namespace: DeclarationNamespace,
  spelling: str,
  visibility: DeclVisibility
) -> RegisteredName {
  let name = Source { text: spelling, identity: DiagnosticSourceUnknown }.all()
  RegisteredName {
    identity: ModuleDeclarationIdentity(module, namespace, name),
    range: TypeNameRange {
      start: 0,
      length: __u64_to_i64(__usize_to_u64(spelling.len()))
    },
    visibility: visibility
  }
}

fn member_name(
  owner: DeclarationIdentity,
  source: Source,
  namespace: DeclarationNamespace,
  range: TypeNameRange,
  visibility: DeclVisibility
) -> RegisteredName {
  RegisteredName {
    identity: MemberDeclarationIdentity(owner, namespace, name_span(source, range)),
    range: range,
    visibility: visibility
  }
}

fn effect_operation_range(operation: TypeEffectOp) -> TypeNameRange? {
  match operation {
    TypeEffectOp(start, length, _, _) -> return TypeNameRange { start: start, length: length }
    DeferredTypeEffectOp(start, length, _, _) -> return TypeNameRange {
      start: start,
      length: length
    }
    MissingTypeEffectOp -> nil
  }
  nil
}

fn register_record_fields(
  owner: DeclarationIdentity,
  source: Source,
  visibility: DeclVisibility,
  fields: List<RecordFieldSyntax>
) -> List<RegisteredRecordField> {
  fields.map<RegisteredRecordField>(
    (field: RecordFieldSyntax) => RegisteredRecordField {
      name: member_name(
        owner,
        source,
        RecordFieldDeclaration,
        field.name,
        visibility
      ),
      syntax: field
    }
  )
}

fn register_variant_members(
  owner: DeclarationIdentity,
  source: Source,
  visibility: DeclVisibility,
  members: List<VariantMemberSyntax>
) -> List<RegisteredVariantMember> {
  members.map<RegisteredVariantMember>(
    (member: VariantMemberSyntax) => RegisteredVariantMember {
      name: member_name(
        owner,
        source,
        ConstructorDeclaration,
        member.name,
        visibility
      ),
      syntax: member
    }
  )
}

fn register_type(
  module: ModuleIdentity,
  source: Source,
  visibility: DeclVisibility,
  syntax: TypeSyntax
) -> RegisteredType {
  match syntax {
    RecordSyntax(range, parameters, fields) -> {
      let name = module_name(module, source, TypeDeclaration, range, visibility)
      RegisteredRecordType(
        name,
        parameters,
        register_record_fields(name.identity, source, visibility, fields)
      )
    }
    VariantSyntax(range, parameters, members) -> {
      let name = module_name(module, source, TypeDeclaration, range, visibility)
      RegisteredVariantType(
        name,
        parameters,
        register_variant_members(name.identity, source, visibility, members)
      )
    }
    OpaqueSyntax(range, parameters, representation) -> RegisteredOpaqueType(
      module_name(module, source, TypeDeclaration, range, visibility),
      parameters,
      representation
    )
    AliasSyntax(range, parameters, target) -> RegisteredAliasType(
      module_name(module, source, TypeDeclaration, range, visibility),
      parameters,
      target
    )
  }
}

fn register_effect(
  module: ModuleIdentity,
  source: Source,
  visibility: DeclVisibility,
  syntax: EffectSyntax
) -> RegisteredEffect {
  let name = module_name(module, source, EffectDeclaration, syntax.name, visibility)
  let mut operations: List<RegisteredEffectOperation> = Nil
  for member in syntax.operations {
    match effect_operation_range(member.operation) {
      range: TypeNameRange -> {
        operations = operations.prepend(
          RegisteredEffectOperation {
            name: member_name(
              name.identity,
              source,
              EffectOperationDeclaration,
              range,
              member.visibility
            ),
            syntax: member.operation
          }
        )
      }
      nil -> nil
    }
  }
  RegisteredEffect {
    name: name,
    type_params: syntax.type_params,
    operations: operations.reverse()
  }
}

fn register_trait_member(
  owner: DeclarationIdentity,
  source: Source,
  member: TypeTraitMember
) -> RegisteredTraitMember {
  match member {
    TypeTraitMethod(start, length, _, _, _) -> RegisteredTraitMethod(
      member_name(
        owner,
        source,
        TraitMethodDeclaration,
        TypeNameRange { start: start, length: length },
        PrivateVisibility
      ),
      member
    )
    TypeTraitAssocType(start, length, _) -> RegisteredAssociatedType(
      member_name(
        owner,
        source,
        AssociatedTypeDeclaration,
        TypeNameRange { start: start, length: length },
        PrivateVisibility
      ),
      member
    )
    MissingTypeTraitMember -> RegisteredInvalidTraitMember(member)
  }
}

fn register_trait(
  module: ModuleIdentity,
  source: Source,
  visibility: DeclVisibility,
  syntax: TraitSyntax
) -> RegisteredTrait {
  let name = module_name(module, source, TraitDeclaration, syntax.name, visibility)
  let mut members: List<RegisteredTraitMember> = Nil
  let mut remaining = syntax.members
  loop {
    match remaining {
      TypeTraitMemberListNil -> break
      TypeTraitMemberListCons(member, rest) -> {
        members = members.prepend(register_trait_member(name.identity, source, member))
        remaining = rest
      }
    }
  }
  RegisteredTrait { name: name, members: members.reverse() }
}

fn range_eq(source: Source, left: TypeNameRange, right: TypeNameRange) -> bool {
  let left_span = name_span(source, left)
  let right_span = name_span(source, right)
  if left_span.len() != right_span.len() { return false }
  let mut index: usize = 0
  while index < left_span.len() {
    if left_span.byte_at(index) != right_span.byte_at(index) { return false }
    index = index + 1
  }
  true
}

fn local_type_identity(
  module: ModuleIdentity,
  source: Source,
  declarations: List<SourceDeclaration>,
  target: TypeNameRange
) -> DeclarationIdentity? {
  for declaration in declarations {
    match declaration.syntax {
      TypeDefinition(type_syntax) -> {
        let range = match type_syntax {
          RecordSyntax(name, _, _) -> name
          VariantSyntax(name, _, _) -> name
          OpaqueSyntax(name, _, _) -> name
          AliasSyntax(name, _, _) -> name
        }
        if range_eq(source, range, target) {
          return ModuleDeclarationIdentity(module, TypeDeclaration, name_span(source, range))
        }
      }
      _ -> nil
    }
  }
  nil
}

fn impl_self_trait(protocol: TypeImplProtocol) -> TypeExpr? {
  match protocol {
    UnqualifiedTypeImpl(hash, range) -> return UnqualifiedTraitTypeExpr(hash, range)
    QualifiedTypeImpl(_, qualifier, member) -> return QualifiedTraitTypeExpr(
      qualifier,
      member
    )
    ResolvedTypeImpl(_, declaration) -> return ResolvedTraitTypeExpr(declaration)
    InherentTypeImpl -> nil
    NamedTypeImpl(_) -> nil
  }
}

fn implementation_owner(
  module: ModuleIdentity,
  source: Source,
  declarations: List<SourceDeclaration>,
  syntax: ImplSyntax
) -> DeclarationIdentity? {
  match syntax.target.protocol {
    InherentTypeImpl -> nil
    _ -> return nil
  }
  match local_type_identity(module, source, declarations, syntax.name) {
    declaration: DeclarationIdentity -> return declaration
    nil -> nil
  }
  match syntax.target.target {
    PrimitiveTypeExpr(_) -> return ModuleDeclarationIdentity(
      module,
      ImplementationTargetDeclaration,
      name_span(source, syntax.name)
    )
    _ -> return nil
  }
}

fn register_impl(
  module: ModuleIdentity,
  source: Source,
  declarations: List<SourceDeclaration>,
  syntax: ImplSyntax,
  ordinal: usize
) -> (RegisteredImpl, List<RegisteredFunction>, usize) {
  let self_trait = impl_self_trait(syntax.target.protocol)
  let owner = implementation_owner(module, source, declarations, syntax)
  let mut members: List<RegisteredImplMember> = Nil
  let mut functions: List<RegisteredFunction> = Nil
  let mut next = ordinal
  for member in syntax.members {
    match member {
      ImplMethod(function, visibility) -> {
        let identity = match owner {
          declaration: DeclarationIdentity -> DeclaredFunctionIdentity(
            MemberDeclarationIdentity(
              declaration,
              InherentMethodDeclaration,
              name_span(source, function.name)
            )
          )
          nil -> {
            let generated = ModuleFunctionIdentity(module, next)
            next = next + 1
            generated
          }
        }
        let registered = RegisteredFunction {
          identity: identity,
          syntax: function,
          visibility: visibility,
          native_owner: owner,
          target: syntax.target.target,
          self_trait: self_trait
        }
        functions = functions.prepend(registered)
        members = members.prepend(RegisteredImplMethod(registered, visibility))
      }
      ImplTypeBinding(name, annotation, range) -> {
        members = members.prepend(RegisteredImplTypeBinding(name, annotation, range))
      }
    }
  }
  (
    RegisteredImpl {
      name: syntax.name,
      type_params: syntax.type_params,
      target: syntax.target,
      members: members.reverse()
    },
    functions.reverse(),
    next
  )
}

fn register_declaration(
  module: ModuleIdentity,
  source: Source,
  all: List<SourceDeclaration>,
  declaration: SourceDeclaration,
  ordinal: usize
) -> (RegisteredDeclaration, List<RegisteredFunction>, usize) {
  let (kind, functions, next) = match declaration.syntax {
    FunctionDefinition(function) -> {
      let name = module_name(
        module,
        source,
        ValueDeclaration,
        function.name,
        declaration.visibility
      )
      let registered = RegisteredFunction {
        identity: DeclaredFunctionIdentity(name.identity),
        syntax: function,
        visibility: declaration.visibility,
        native_owner: nil,
        target: nil,
        self_trait: nil
      }
      (
        RegisteredFunctionDeclaration(registered),
        Nil<RegisteredFunction>().prepend(registered),
        ordinal
      )
    }
    TypeDefinition(type_syntax) -> (
      RegisteredTypeDeclaration(
        register_type(
          module,
          source,
          declaration.visibility,
          type_syntax
        )
      ),
      Nil<RegisteredFunction>(),
      ordinal
    )
    EffectDefinition(effect_syntax) -> (
      RegisteredEffectDeclaration(
        register_effect(
          module,
          source,
          declaration.visibility,
          effect_syntax
        )
      ),
      Nil<RegisteredFunction>(),
      ordinal
    )
    TraitDefinition(trait_syntax) -> (
      RegisteredTraitDeclaration(
        register_trait(
          module,
          source,
          declaration.visibility,
          trait_syntax
        )
      ),
      Nil<RegisteredFunction>(),
      ordinal
    )
    ImplDefinition(implementation) -> match register_impl(
      module,
      source,
      all,
      implementation,
      ordinal
    ) {
      (registered, impl_functions, after) -> (
        RegisteredImplDeclaration(registered),
        impl_functions,
        after
      )
    }
    ConstantDefinition(constant) -> {
      let name = module_name(
        module,
        source,
        ValueDeclaration,
        constant.name,
        declaration.visibility
      )
      (
        RegisteredConstantDeclaration(
          RegisteredConstant {
            name: name,
            declared_type: constant.declared_type,
            initializer: constant.initializer
          }
        ),
        Nil<RegisteredFunction>(),
        ordinal
      )
    }
    HandlerDefinition(handler) -> (
      RegisteredHandlerDeclaration(
        RegisteredHandler {
          identity: handler_implementation_identity(module),
          syntax: handler,
          visibility: declaration.visibility
        }
      ),
      Nil<RegisteredFunction>(),
      ordinal
    )
    DefaultHandlerDefinition(handler) -> (
      RegisteredDefaultHandlerDeclaration(
        RegisteredDefaultHandler {
          syntax: handler,
          visibility: declaration.visibility
        }
      ),
      Nil<RegisteredFunction>(),
      ordinal
    )
    ImportDefinition(_) -> (
      RegisteredImportDeclaration(),
      Nil<RegisteredFunction>(),
      ordinal
    )
    TestDefinition(case_syntax) -> (
      RegisteredTestDeclaration(case_syntax),
      Nil<RegisteredFunction>(),
      ordinal
    )
    InvalidDefinition -> (
      RegisteredInvalidDeclaration(),
      Nil<RegisteredFunction>(),
      ordinal
    )
  }
  (
    RegisteredDeclaration { authored: declaration, kind: kind },
    functions,
    next
  )
}

pub(package) fn register(
  syntax: ParsedModuleSyntax,
  source: Source,
  identity: ModuleIdentity
) -> RegisteredModule {
  register_with_authority(syntax, source, identity, StrictSourceAuthority)
}

-- Only the host source-loading boundary may pass trusted authority. Ordinary
-- registration, including direct test fixtures, remains strict by default.
pub(package) fn register_with_authority(
  syntax: ParsedModuleSyntax,
  source: Source,
  identity: ModuleIdentity,
  authority: SourceAuthority
) -> RegisteredModule {
  register_with_capabilities(
    syntax,
    source,
    identity,
    authority,
    match authority {
      StrictSourceAuthority -> false
      TrustedSourceAuthority -> true
    }
  )
}

-- Capabilities come from the host's registered source, never its spelling in
-- a package-authored import. Internal ownership notation is independent of
-- the sealed Unsafe grant.
pub(package) fn register_with_capabilities(
  syntax: ParsedModuleSyntax,
  source: Source,
  identity: ModuleIdentity,
  authority: SourceAuthority,
  internal_ownership_allowed: bool
) -> RegisteredModule {
  let authored = syntax.declarations
  let mut registered = dense_builder_with_capacity<RegisteredDeclaration>(
    authored.len()
  )
  let mut functions = dense_builder<RegisteredFunction>()
  let mut ordinal: usize = 0
  for declaration in authored {
    match register_declaration(identity, source, authored, declaration, ordinal) {
      (item, item_functions, next) -> {
        registered.push(item)
        for function in item_functions { functions.push(function) }
        ordinal = next
      }
    }
  }
  RegisteredModule {
    identity: identity,
    source: source,
    authority: authority,
    internal_ownership_allowed: internal_ownership_allowed,
    syntax: syntax,
    declarations: registered.freeze(),
    functions: functions.freeze()
  }
}

fn registered_type_named_count(value: RegisteredType) -> usize {
  let one: usize = 1
  match value {
    RegisteredRecordType(_, _, fields) -> one + fields.len()
    RegisteredVariantType(_, _, members) -> one + members.len()
    RegisteredOpaqueType(_, _, _) -> one
    RegisteredAliasType(_, _, _) -> one
  }
}

fn registered_effect_named_count(value: RegisteredEffect) -> usize {
  let one: usize = 1
  one + value.operations.len()
}

fn registered_trait_named_count(value: RegisteredTrait) -> usize {
  let one: usize = 1
  one + value.members.len()
}

fn registered_impl_named_count(value: RegisteredImpl) -> usize {
  let zero: usize = 0
  let one: usize = 1
  value.members.fold<usize>(
    zero,
    (count: usize, member: RegisteredImplMember) => count +
      match member {
        RegisteredImplMethod(function, _) -> match function.identity {
          DeclaredFunctionIdentity(_) -> one
          ModuleFunctionIdentity(_, _) -> zero
          IntrinsicFunctionIdentity(_, _) -> zero
        }
        RegisteredImplTypeBinding(_, _, _) -> zero
      }
  )
}

pub(package) fn summary(module: RegisteredModule) -> RegistrationSummary {
  let declarations = module.declarations
  let functions = module.functions
  let imports = module.syntax.imports
  let mut named_declarations: usize = 0
  let mut types: usize = 0
  let mut effects: usize = 0
  let mut traits: usize = 0
  let mut implementations: usize = 0
  let mut constants: usize = 0
  let mut handlers: usize = 0
  let mut default_handlers: usize = 0
  let mut tests: usize = 0
  let mut invalid: usize = 0
  let mut declaration_index: usize = 0
  while declaration_index < declarations.len() {
    let declaration = declarations.at(dense_index(declaration_index))
    match declaration.kind {
      RegisteredFunctionDeclaration(_) -> {
        named_declarations = named_declarations + 1
      }
      RegisteredTypeDeclaration(value) -> {
        types = types + 1
        named_declarations = named_declarations + registered_type_named_count(value)
      }
      RegisteredEffectDeclaration(value) -> {
        effects = effects + 1
        named_declarations = named_declarations + registered_effect_named_count(value)
      }
      RegisteredTraitDeclaration(value) -> {
        traits = traits + 1
        named_declarations = named_declarations + registered_trait_named_count(value)
      }
      RegisteredImplDeclaration(value) -> {
        implementations = implementations + 1
        named_declarations = named_declarations + registered_impl_named_count(value)
      }
      RegisteredConstantDeclaration(_) -> {
        constants = constants + 1
        named_declarations = named_declarations + 1
      }
      RegisteredHandlerDeclaration(_) -> { handlers = handlers + 1 }
      RegisteredDefaultHandlerDeclaration(_) -> { default_handlers = default_handlers + 1 }
      RegisteredImportDeclaration -> nil
      RegisteredTestDeclaration(_) -> { tests = tests + 1 }
      RegisteredInvalidDeclaration -> { invalid = invalid + 1 }
    }
    declaration_index = declaration_index + 1
  }
  RegistrationSummary {
    declarations: declarations.len(),
    named_declarations: named_declarations,
    functions: functions.len(),
    types: types,
    effects: effects,
    traits: traits,
    implementations: implementations,
    constants: constants,
    handlers: handlers,
    default_handlers: default_handlers,
    imports: imports.len(),
    tests: tests,
    invalid: invalid
  }
}

pub(package) fn declaration_names(module: RegisteredModule) -> List<RegisteredName> {
  let declarations = module.declarations
  let mut names: List<RegisteredName> = Nil
  let mut declaration_index: usize = 0
  while declaration_index < declarations.len() {
    let declaration = declarations.at(dense_index(declaration_index))
    match declaration.kind {
      RegisteredFunctionDeclaration(function) -> match function.identity {
        DeclaredFunctionIdentity(identity) -> {
          names = names.prepend(
            RegisteredName {
              identity: identity,
              range: function.syntax.name,
              visibility: function.visibility
            }
          )
        }
        ModuleFunctionIdentity(_, _) -> nil
        IntrinsicFunctionIdentity(_, _) -> nil
      }
      RegisteredTypeDeclaration(value) -> match value {
        RegisteredRecordType(name, _, fields) -> {
          names = names.prepend(name)
          for field in fields { names = names.prepend(field.name) }
        }
        RegisteredVariantType(name, _, members) -> {
          names = names.prepend(name)
          for member in members { names = names.prepend(member.name) }
        }
        RegisteredOpaqueType(name, _, _) -> { names = names.prepend(name) }
        RegisteredAliasType(name, _, _) -> { names = names.prepend(name) }
      }
      RegisteredEffectDeclaration(effect_value) -> {
        names = names.prepend(effect_value.name)
        for operation in effect_value.operations { names = names.prepend(operation.name) }
      }
      RegisteredTraitDeclaration(trait_value) -> {
        names = names.prepend(trait_value.name)
        for member in trait_value.members {
          match member {
            RegisteredTraitMethod(name, _) -> { names = names.prepend(name) }
            RegisteredAssociatedType(name, _) -> { names = names.prepend(name) }
            RegisteredInvalidTraitMember(_) -> nil
          }
        }
      }
      RegisteredImplDeclaration(implementation) -> for member in implementation.members {
        match member {
          RegisteredImplMethod(function, _) -> match function.identity {
            DeclaredFunctionIdentity(identity) -> {
              names = names.prepend(
                RegisteredName {
                  identity: identity,
                  range: function.syntax.name,
                  visibility: function.visibility
                }
              )
            }
            ModuleFunctionIdentity(_, _) -> nil
            IntrinsicFunctionIdentity(_, _) -> nil
          }
          RegisteredImplTypeBinding(_, _, _) -> nil
        }
      }
      RegisteredConstantDeclaration(constant) -> { names = names.prepend(constant.name) }
      _ -> nil
    }
    declaration_index = declaration_index + 1
  }
  names.reverse()
}
