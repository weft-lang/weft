-- Retained registration products for one host assembly.
--
-- Parsing and import loading append through this private builder surface. The
-- product exposed to checking is read-only: consumers can inspect registered
-- modules but cannot manufacture or replace their identities.

use compiler/project/identity.{
  ModuleIdentity,
  DeclarationIdentity,
  DeclarationNamespace,
  declaration_namespace_code,
  declaration_identity_namespace,
  declaration_identity_name,
  declaration_identity_owner
}
use compiler/project/identity/equality.{module_identity_eq}
use compiler/weft/check/registration/catalog.{
  RegisteredModule,
  RegisteredName,
  declaration_names
}
use stdlib/string.{str_eq}
use stdlib/option.{Option, Some, None}
use stdlib/vector as vector
use stdlib/vector.{Vector, vector_get_in_bounds, vector_len, vector_push}

pub(package) type RegistrationBuilder = opaque Vector<RegisteredModule>

pub(package) type RegistrationScope = opaque Vector<RegisteredModule>

pub(package) fn registration_builder() -> RegistrationBuilder {
  RegistrationBuilder(vector.new<RegisteredModule>())
}

pub(package) fn registration_builder_add(
  builder: RegistrationBuilder,
  module: RegisteredModule
) -> nil {
  match builder {
    RegistrationBuilder(modules) -> {
      vector_push<RegisteredModule>(modules, module)
      nil
    }
  }
}

pub(package) fn registration_builder_freeze(
  builder: RegistrationBuilder
) -> RegistrationScope {
  match builder { RegistrationBuilder(modules) -> RegistrationScope(modules) }
}

pub(package) fn registration_scope() -> RegistrationScope {
  registration_builder_freeze(registration_builder())
}

pub(package) fn registration_scope_len(scope: RegistrationScope) -> usize {
  match scope { RegistrationScope(modules) -> modules.len() }
}

pub(package) fn registration_scope_at(
  scope: RegistrationScope,
  index: i64
) -> RegisteredModule {
  match scope {
    RegistrationScope(modules) -> vector_get_in_bounds<RegisteredModule>(modules, index)
  }
}

pub(package) fn registration_scope_find(
  scope: RegistrationScope,
  identity: ModuleIdentity
) -> Option<RegisteredModule> {
  match scope {
    RegistrationScope(modules) -> {
      for index in 0..vector_len<RegisteredModule>(modules) {
        let registered = vector_get_in_bounds<RegisteredModule>(modules, index)
        if module_identity_eq(registered.identity, identity) { return Some(registered) }
      }
      None
    }
  }
}

pub(package) fn registration_scope_combined(
  left: RegistrationScope,
  right: RegistrationScope
) -> RegistrationScope {
  let combined = registration_builder()
  match left {
    RegistrationScope(modules) -> for index in 0..vector_len<RegisteredModule>(modules) {
      registration_builder_add(
        combined,
        vector_get_in_bounds<RegisteredModule>(modules, index)
      )
    }
  }
  match right {
    RegistrationScope(modules) -> for index in 0..vector_len<RegisteredModule>(modules) {
      registration_builder_add(
        combined,
        vector_get_in_bounds<RegisteredModule>(modules, index)
      )
    }
  }
  registration_builder_freeze(combined)
}

fn registration_name_matches(
  registered: RegisteredName,
  namespace: DeclarationNamespace,
  name: str
) -> bool {
  declaration_identity_owner(registered.identity) == nil and
    declaration_namespace_code(declaration_identity_namespace(registered.identity)) ==
    declaration_namespace_code(namespace) and
    match declaration_identity_name(registered.identity).text() {
      Some(spelling) -> str_eq(spelling, name) == 1
      None -> false
    }
}

pub(package) fn registration_scope_find_declaration(
  scope: RegistrationScope,
  module: ModuleIdentity,
  namespace: DeclarationNamespace,
  name: str
) -> Option<RegisteredName> {
  match registration_scope_find(scope, module) {
    Some(registered_module) -> {
      for registered in declaration_names(registered_module) {
        if registration_name_matches(registered, namespace, name) { return Some(registered) }
      }
      None
    }
    None -> None
  }
}

pub(package) fn registration_scope_has_other_declaration(
  scope: RegistrationScope,
  module: ModuleIdentity,
  expected: DeclarationNamespace,
  name: str
) -> bool {
  match registration_scope_find(scope, module) {
    Some(registered_module) -> {
      for registered in declaration_names(registered_module) {
        if declaration_identity_owner(registered.identity) == nil and
          declaration_namespace_code(declaration_identity_namespace(registered.identity)) !=
          declaration_namespace_code(expected) and
          match declaration_identity_name(registered.identity).text() {
            Some(spelling) -> str_eq(spelling, name) == 1
            None -> false
          } { return true }
      }
      false
    }
    None -> false
  }
}
