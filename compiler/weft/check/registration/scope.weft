-- Typed module scopes over retained declaration catalogs.
--
-- Package resolution supplies exact target module identities. This producer
-- owns name visibility, import precedence and ambiguity; it never consults or
-- constructs the legacy checker table.

use compiler/project/identity.{*}
use compiler/project/identity/equality.{declaration_identity_eq, module_identity_eq}
use compiler/project/module.{
  DeclVisibility,
  PrivateVisibility,
  PackageVisibility,
  PublicVisibility
}
use compiler/storage.{src_eq_at}
use compiler/types/names.{str_hash}
use compiler/weft/check/registration/catalog.{
  RegisteredModule,
  RegisteredName,
  declaration_names
}
use compiler/weft/syntax/imports.{
  ImportBinding,
  ImportDeclaration,
  ImportModule,
  ImportName,
  ImportRenamedSymbol,
  ImportSelection,
  ImportSymbol,
  ImportSymbols,
  ImportWildcard
}
use stdlib/list.{List, Cons, Nil}
use stdlib/option.{Option, Some, None}
use stdlib/ord.{Ordering, Less, Equal, Greater, Ord}
use stdlib/panic.{panic}
use stdlib/diagnostic/schema.{DiagnosticSourceUnknown}
use stdlib/source.{Source, Span}
use stdlib/string.{str_eq}
use stdlib/vector as vector
use stdlib/vector.{
  PersistentVector,
  Vector,
  persistent_vector_empty,
  persistent_vector_get_option,
  persistent_vector_len,
  persistent_vector_push,
  vector_get_in_bounds,
  vector_len,
  vector_push,
  vector_set,
  vector_sort_by_in_place
}

pub(package) type ResolvedImportSelection {
  ResolvedImportWildcard,
  ResolvedImportSymbol(Span, Span)
}

pub(package) type ResolvedImportBinding {
  ResolvedModuleImport(Span),
  ResolvedSymbolImport(List<ResolvedImportSelection>)
}

pub(package) type ResolvedImport {
  importer: ModuleIdentity,
  target: ModuleIdentity,
  binding: ResolvedImportBinding,
  visibility: DeclVisibility,
  weak: bool,
  location: Option<Span>
}

pub(package) type ScopeTarget {
  ScopeDeclarationTarget(RegisteredName),
  ScopeModuleTarget(ModuleIdentity)
}

pub(package) type ScopeCandidate {
  target: ScopeTarget,
  visibility: DeclVisibility,
  weak: bool,
  origin: Option<Span>
}

pub(package) type ScopeEntryStatus {
  ScopeEntryResolved,
  ScopeEntryAmbiguous
}

pub(package) type ScopeEntry {
  module: ModuleIdentity,
  spelling: str,
  primary: ScopeCandidate,
  conflict: Option<ScopeCandidate>,
  status: ScopeEntryStatus
}

pub(package) type ScopeIssueStatus {
  ScopeImportMissing,
  ScopeImportInvisible,
  ScopeImportWidenedReexport,
  ScopeImportAmbiguous
}

pub(package) type ScopeIssue {
  module: ModuleIdentity,
  spelling: str,
  import: ResolvedImport,
  status: ScopeIssueStatus,
  location: Option<Span>,
  primary: Option<ScopeCandidate>,
  conflict: Option<ScopeCandidate>
}

pub(package) type ScopeLookup {
  ScopeNameResolved(ScopeCandidate),
  ScopeNameAmbiguous(ScopeCandidate, Option<ScopeCandidate>),
  ScopeNameMissing
}

pub(package) type QualifiedScopeLookup {
  QualifiedScopeResolved(ScopeCandidate),
  QualifiedScopeInvisible(ScopeCandidate),
  QualifiedScopeAmbiguous(ScopeCandidate, Option<ScopeCandidate>),
  QualifiedScopeMissing
}

type ScopeIndexEntry {
  hash: i64,
  ordinal: usize
}

type ScopeTable {
  entries: PersistentVector<ScopeEntry>,
  index: PersistentVector<ScopeIndexEntry>
}

pub(package) type RegistrationScope = opaque(
  PersistentVector<RegisteredModule>,
  PersistentVector<ResolvedImport>,
  PersistentVector<RegisteredName>,
  PersistentVector<ScopeTable>,
  PersistentVector<ScopeIssue>
)

-- Host assembly owns the mutable builder. Freezing publishes one read-only
-- scope product which can later gain resolved import edges without changing
-- the registered declaration identities.
type RegistrationBuilderEntry {
  RegistrationBuilderModule(RegisteredModule),
  RegistrationBuilderImport(ResolvedImport),
  RegistrationBuilderSynthetic(RegisteredName)
}

pub(package) type RegistrationBuilder = opaque Vector<RegistrationBuilderEntry>

fn required_span(source: Source, start: usize, end: usize) -> Span {
  match source.span(start, end) {
    Some(span) -> span
    None -> panic("registered import range is outside its retained source")
  }
}

fn import_name_span(source: Source, name: ImportName) -> Span {
  required_span(source, name.start, name.start + name.length)
}

fn resolved_import_selection(
  source: Source,
  selection: ImportSelection
) -> ResolvedImportSelection {
  match selection {
    ImportWildcard -> ResolvedImportWildcard
    ImportSymbol(name) -> {
      let spelling = import_name_span(source, name)
      ResolvedImportSymbol(spelling, spelling)
    }
    ImportRenamedSymbol(name, alias) -> ResolvedImportSymbol(
      import_name_span(source, name),
      import_name_span(source, alias)
    )
  }
}

pub(package) fn resolved_import(
  importer: RegisteredModule,
  declaration: ImportDeclaration,
  target: ModuleIdentity,
  weak: bool
) -> ResolvedImport {
  let binding = match declaration.syntax.binding {
    ImportModule(alias) -> ResolvedModuleImport(import_name_span(importer.source, alias))
    ImportSymbols(selections) -> ResolvedSymbolImport(
      selections.map<ResolvedImportSelection>(
        (selection: ImportSelection) => resolved_import_selection(importer.source, selection)
      )
    )
  }
  ResolvedImport {
    importer: importer.identity,
    target: target,
    binding: binding,
    visibility: declaration.visibility,
    weak: weak,
    location: Some(
      required_span(importer.source, declaration.start, declaration.end)
    )
  }
}

pub(package) fn resolved_implicit_wildcard_import(
  importer: ModuleIdentity,
  target: ModuleIdentity
) -> ResolvedImport {
  ResolvedImport {
    importer: importer,
    target: target,
    binding: ResolvedSymbolImport(
      Nil<ResolvedImportSelection>().prepend(ResolvedImportWildcard())
    ),
    visibility: PrivateVisibility,
    weak: true,
    location: None<Span>()
  }
}

fn visibility_rank(visibility: DeclVisibility) -> i64 {
  match visibility {
    PrivateVisibility -> 0
    PackageVisibility -> 1
    PublicVisibility -> 2
  }
}

fn target_eq(left: ScopeTarget, right: ScopeTarget) -> bool {
  match (left, right) {
    (ScopeDeclarationTarget(a), ScopeDeclarationTarget(b)) ->
      declaration_occurrence_eq(a.identity, b.identity)
    (ScopeModuleTarget(a), ScopeModuleTarget(b)) -> module_identity_eq(a, b)
    _ -> false
  }
}

-- Invalid source can declare the same spelling more than once. Semantic name
-- equality deliberately treats reparsed declarations alike, while scope
-- collision detection must still distinguish two authored occurrences in one
-- module. Exact retained ranges supply that occurrence discriminator.
fn declaration_occurrence_eq(
  left: DeclarationIdentity,
  right: DeclarationIdentity
) -> bool {
  if not declaration_identity_eq(left, right) { false }
  else {
    let left_name = declaration_identity_name(left)
    let right_name = declaration_identity_name(right)
    if left_name.start() != right_name.start() or left_name.end() != right_name.end() {
      false
    } else {
      match (declaration_identity_owner(left), declaration_identity_owner(right)) {
        (nil, nil) -> true
        (left_owner: DeclarationIdentity, right_owner: DeclarationIdentity) ->
          declaration_occurrence_eq(left_owner, right_owner)
        _ -> false
      }
    }
  }
}

fn candidate_visible_from(
  candidate: ScopeCandidate,
  declaring_scope: ModuleIdentity,
  importer: ModuleIdentity
) -> bool {
  if module_identity_eq(declaring_scope, importer) { true }
  else {
    match candidate.visibility {
      PublicVisibility -> true
      PackageVisibility -> module_identity_package(declaring_scope) ==
        module_identity_package(importer)
      PrivateVisibility -> false
    }
  }
}

fn module_item(name: RegisteredName) -> bool {
  match declaration_identity_namespace(name.identity) {
    ValueDeclaration -> declaration_identity_owner(name.identity) == nil
    TypeDeclaration -> declaration_identity_owner(name.identity) == nil
    EffectDeclaration -> declaration_identity_owner(name.identity) == nil
    TraitDeclaration -> declaration_identity_owner(name.identity) == nil
    ConstructorDeclaration -> true
    _ -> false
  }
}

fn required_text(span: Span) -> str {
  match span.text() {
    Some(text) -> text
    None -> panic("registered name range is outside its retained source")
  }
}

fn registered_origin(name: RegisteredName) -> Option<Span> {
  let location = declaration_identity_name(name.identity)
  match location.source().identity {
    DiagnosticSourceUnknown -> None<Span>()
    _ -> Some(location)
  }
}

fn entry_index(
  entries: borrow Vector<ScopeEntry>,
  spelling: str
) -> i64 {
  for index in 0..vector_len<ScopeEntry>(entries) {
    let entry = vector_get_in_bounds<ScopeEntry>(entries, index)
    if str_eq(entry.spelling, spelling) == 1 { return index }
  }
  0 - 1
}

fn spelling_matches_span(spelling: str, source: Span) -> bool {
  let length = __u64_to_i64(__usize_to_u64(source.len()))
  spelling.len() == source.len() and src_eq_at(
    __str_ptr(spelling),
    0,
    __str_ptr(source.source().text) + __u64_to_i64(__usize_to_u64(source.start())),
    0,
    length
  )
}

fn entry_index_span(
  entries: borrow Vector<ScopeEntry>,
  spelling: Span
) -> i64 {
  for index in 0..vector_len<ScopeEntry>(entries) {
    let entry = vector_get_in_bounds<ScopeEntry>(entries, index)
    if spelling_matches_span(entry.spelling, spelling) { return index }
  }
  0 - 1
}

fn scope_index_entry_compare(left: ScopeIndexEntry, right: ScopeIndexEntry) -> Ordering {
  if left.hash < right.hash { Less }
  else { if left.hash > right.hash { Greater } else { Equal } }
}

fn scope_index_for(entries: PersistentVector<ScopeEntry>) -> PersistentVector<ScopeIndexEntry> {
  let index = vector.with_capacity<ScopeIndexEntry>(entries.len())
  for ordinal in 0..persistent_vector_len<ScopeEntry>(entries) {
    let entry = persistent_get_in_bounds<ScopeEntry>(entries, ordinal)
    vector_push<ScopeIndexEntry>(
      index,
      ScopeIndexEntry {
        hash: str_hash(__str_ptr(entry.spelling), 0, __str_len(entry.spelling)),
        ordinal: __i64_to_usize(ordinal)
      }
    )
  }
  vector_sort_by_in_place<ScopeIndexEntry>(index, scope_index_entry_compare)
  persistent_from_vector<ScopeIndexEntry>(index)
}

fn persistent_entry_index(
  index: PersistentVector<ScopeIndexEntry>,
  entries: PersistentVector<ScopeEntry>,
  spelling: str
) -> i64 {
  let hash = str_hash(__str_ptr(spelling), 0, __str_len(spelling))
  let mut low: i64 = 0
  let mut high = persistent_vector_len<ScopeIndexEntry>(index)
  while low < high {
    let middle = low + (high - low) / 2
    let candidate = persistent_get_in_bounds<ScopeIndexEntry>(index, middle)
    if candidate.hash < hash { low = middle + 1 } else { high = middle }
  }
  while low < persistent_vector_len<ScopeIndexEntry>(index) {
    let candidate = persistent_get_in_bounds<ScopeIndexEntry>(index, low)
    if candidate.hash != hash { return 0 - 1 }
    let ordinal = __u64_to_i64(__usize_to_u64(candidate.ordinal))
    let entry = persistent_get_in_bounds<ScopeEntry>(entries, ordinal)
    if str_eq(entry.spelling, spelling) == 1 { return ordinal }
    low = low + 1
  }
  0 - 1
}

fn persistent_entry_index_span(
  index: PersistentVector<ScopeIndexEntry>,
  entries: PersistentVector<ScopeEntry>,
  spelling: Span
) -> i64 {
  let hash = str_hash(
    __str_ptr(spelling.source().text),
    __u64_to_i64(__usize_to_u64(spelling.start())),
    __u64_to_i64(__usize_to_u64(spelling.len()))
  )
  let mut low: i64 = 0
  let mut high = persistent_vector_len<ScopeIndexEntry>(index)
  while low < high {
    let middle = low + (high - low) / 2
    let candidate = persistent_get_in_bounds<ScopeIndexEntry>(index, middle)
    if candidate.hash < hash { low = middle + 1 } else { high = middle }
  }
  while low < persistent_vector_len<ScopeIndexEntry>(index) {
    let candidate = persistent_get_in_bounds<ScopeIndexEntry>(index, low)
    if candidate.hash != hash { return 0 - 1 }
    let ordinal = __u64_to_i64(__usize_to_u64(candidate.ordinal))
    let entry = persistent_get_in_bounds<ScopeEntry>(entries, ordinal)
    if spelling_matches_span(entry.spelling, spelling) { return ordinal }
    low = low + 1
  }
  0 - 1
}

fn persistent_entry_linear_index(
  entries: PersistentVector<ScopeEntry>,
  spelling: str
) -> i64 {
  for index in 0..persistent_vector_len<ScopeEntry>(entries) {
    let entry = persistent_get_in_bounds<ScopeEntry>(entries, index)
    if str_eq(entry.spelling, spelling) == 1 { return index }
  }
  0 - 1
}

fn replace_entry(entries: borrow Vector<ScopeEntry>, index: i64, entry: ScopeEntry) -> nil {
  if vector_set<ScopeEntry>(entries, index, entry) { nil }
  else { panic("typed scope entry index is out of bounds") }
}

fn add_binding(
  entries: borrow Vector<ScopeEntry>,
  module: ModuleIdentity,
  spelling: str,
  incoming: ScopeCandidate
) -> nil {
  let index = entry_index(entries, spelling)
  if index < 0 {
    vector_push<ScopeEntry>(
      entries,
      ScopeEntry {
        module: module,
        spelling: spelling,
        primary: incoming,
        conflict: None<ScopeCandidate>(),
        status: ScopeEntryResolved
      }
    )
    nil
  } else {
    let existing = vector_get_in_bounds<ScopeEntry>(entries, index)
    if existing.primary.weak and not incoming.weak {
      replace_entry(
        entries,
        index,
        ScopeEntry {
          module: module,
          spelling: spelling,
          primary: incoming,
          conflict: None<ScopeCandidate>(),
          status: ScopeEntryResolved
        }
      )
    } else {
      if not existing.primary.weak and incoming.weak { nil }
      else {
        if target_eq(existing.primary.target, incoming.target) {
          let primary = if visibility_rank(incoming.visibility) >
            visibility_rank(existing.primary.visibility) {
              ScopeCandidate {
                target: existing.primary.target,
                visibility: incoming.visibility,
                weak: existing.primary.weak,
                origin: existing.primary.origin
              }
            } else { existing.primary }
          replace_entry(
            entries,
            index,
            ScopeEntry {
              module: existing.module,
              spelling: existing.spelling,
              primary: primary,
              conflict: existing.conflict,
              status: existing.status
            }
          )
        } else {
          replace_entry(
            entries,
            index,
            ScopeEntry {
              module: existing.module,
              spelling: existing.spelling,
              primary: existing.primary,
              conflict: match existing.conflict {
                Some(conflict) -> Some(conflict)
                None -> Some(incoming)
              },
              status: ScopeEntryAmbiguous
            }
          )
        }
      }
    }
  }
}

fn add_issue(
  issues: borrow Vector<ScopeIssue>,
  edge: ResolvedImport,
  spelling: str,
  status: ScopeIssueStatus,
  location: Option<Span>,
  primary: Option<ScopeCandidate>,
  conflict: Option<ScopeCandidate>
) -> nil {
  vector_push<ScopeIssue>(
    issues,
    ScopeIssue {
      module: edge.importer,
      spelling: spelling,
      import: edge,
      status: status,
      location: location,
      primary: primary,
      conflict: conflict
    }
  )
  nil
}

fn candidates_are_type_constructor_pair(
  first_candidate: ScopeCandidate,
  conflict: Option<ScopeCandidate>
) -> bool {
  match (first_candidate.target, conflict) {
    (ScopeDeclarationTarget(first), Some(second_candidate)) -> match second_candidate.target {
      ScopeDeclarationTarget(second) -> {
        let first_namespace = declaration_identity_namespace(first.identity)
        let second_namespace = declaration_identity_namespace(second.identity)
        (
          match first_namespace { TypeDeclaration -> true, _ -> false }
        ) and match second_namespace {
          ConstructorDeclaration -> match declaration_identity_owner(second.identity) {
            owner: DeclarationIdentity -> declaration_occurrence_eq(owner, first.identity)
            nil -> false
          }
          _ -> false
        } or (
          match second_namespace { TypeDeclaration -> true, _ -> false }
        ) and match first_namespace {
          ConstructorDeclaration -> match declaration_identity_owner(first.identity) {
            owner: DeclarationIdentity -> declaration_occurrence_eq(owner, second.identity)
            nil -> false
          }
          _ -> false
        }
      }
      _ -> false
    }
    _ -> false
  }
}

fn type_constructor_pair(entry: ScopeEntry) -> bool {
  candidates_are_type_constructor_pair(entry.primary, entry.conflict)
}

pub(package) fn scope_entry_is_type_constructor_pair(entry: ScopeEntry) -> bool {
  type_constructor_pair(entry)
}

fn imported_candidate(
  candidate: ScopeCandidate,
  edge: ResolvedImport,
  origin: Option<Span>
) -> ScopeCandidate {
  ScopeCandidate {
    target: candidate.target,
    visibility: edge.visibility,
    weak: edge.weak,
    origin: origin
  }
}

fn import_candidate(
  entries: borrow Vector<ScopeEntry>,
  issues: borrow Vector<ScopeIssue>,
  edge: ResolvedImport,
  target_entry: ScopeEntry,
  spelling: str,
  candidate: ScopeCandidate,
  origin: Option<Span>,
  issue_location: Option<Span>
) -> nil {
  if not candidate_visible_from(candidate, target_entry.module, edge.importer) {
    add_issue(
      issues,
      edge,
      spelling,
      ScopeImportInvisible,
      issue_location,
      Some(candidate),
      None
    )
  } else {
    if visibility_rank(edge.visibility) > visibility_rank(candidate.visibility) {
      add_issue(
        issues,
        edge,
        spelling,
        ScopeImportWidenedReexport,
        issue_location,
        Some(candidate),
        None
      )
    } else {
      add_binding(
        entries,
        edge.importer,
        spelling,
        imported_candidate(candidate, edge, origin)
      )
    }
  }
}

fn import_entry(
  entries: borrow Vector<ScopeEntry>,
  issues: borrow Vector<ScopeIssue>,
  edge: ResolvedImport,
  target_entry: ScopeEntry,
  spelling: str,
  origin: Option<Span>,
  issue_location: Option<Span>
) -> nil {
  match target_entry.status {
    ScopeEntryResolved -> import_candidate(
      entries,
      issues,
      edge,
      target_entry,
      spelling,
      target_entry.primary,
      origin,
      issue_location
    )
    ScopeEntryAmbiguous -> if type_constructor_pair(target_entry) {
      import_candidate(
        entries,
        issues,
        edge,
        target_entry,
        spelling,
        target_entry.primary,
        origin,
        issue_location
      )
      match target_entry.conflict {
        Some(conflict) -> import_candidate(
          entries,
          issues,
          edge,
          target_entry,
          spelling,
          conflict,
          origin,
          issue_location
        )
        None -> nil
      }
    } else {
      add_issue(
        issues,
        edge,
        spelling,
        ScopeImportAmbiguous,
        issue_location,
        Some(target_entry.primary),
        target_entry.conflict
      )
    }
  }
}

fn add_wildcard_import(
  entries: borrow Vector<ScopeEntry>,
  target_entries: PersistentVector<ScopeEntry>,
  issues: borrow Vector<ScopeIssue>,
  edge: ResolvedImport
) -> nil {
  let count = persistent_vector_len<ScopeEntry>(target_entries)
  for index in 0..count {
    let entry = persistent_get_in_bounds<ScopeEntry>(target_entries, index)
    if candidate_visible_from(entry.primary, entry.module, edge.importer) and
      visibility_rank(edge.visibility) <= visibility_rank(entry.primary.visibility) {
        import_entry(
          entries,
          issues,
          edge,
          entry,
          entry.spelling,
          edge.location,
          edge.location
        )
      }
  }
  nil
}

fn add_selected_import(
  entries: borrow Vector<ScopeEntry>,
  target_entries: PersistentVector<ScopeEntry>,
  issues: borrow Vector<ScopeIssue>,
  edge: ResolvedImport,
  selected: Span,
  local: Span
) -> nil {
  let selected_name = required_text(selected)
  let local_name = required_text(local)
  let index = persistent_entry_linear_index(target_entries, selected_name)
  if index < 0 {
    add_issue(
      issues,
      edge,
      local_name,
      ScopeImportMissing,
      Some(selected),
      None,
      None
    )
  } else {
    import_entry(
      entries,
      issues,
      edge,
      persistent_get_in_bounds<ScopeEntry>(target_entries, index),
      local_name,
      Some(local),
      Some(selected)
    )
  }
}

fn add_import(
  entries: borrow Vector<ScopeEntry>,
  target_entries: PersistentVector<ScopeEntry>,
  issues: borrow Vector<ScopeIssue>,
  edge: ResolvedImport
) -> nil {
  match edge.binding {
    ResolvedModuleImport(alias) -> add_binding(
      entries,
      edge.importer,
      required_text(alias),
      ScopeCandidate {
        target: ScopeModuleTarget(edge.target),
        visibility: edge.visibility,
        weak: edge.weak,
        origin: Some(alias)
      }
    )
    ResolvedSymbolImport(selections) -> for selection in selections {
      match selection {
        ResolvedImportWildcard -> add_wildcard_import(
          entries,
          target_entries,
          issues,
          edge
        )
        ResolvedImportSymbol(selected, local) -> add_selected_import(
          entries,
          target_entries,
          issues,
          edge,
          selected,
          local
        )
      }
    }
  }
  nil
}

fn module_index(modules: borrow Vector<RegisteredModule>, identity: ModuleIdentity) -> i64 {
  for index in 0..vector_len<RegisteredModule>(modules) {
    if module_identity_eq(
      vector_get_in_bounds<RegisteredModule>(modules, index).identity,
      identity
    ) { return index }
  }
  0 - 1
}

fn persistent_get_in_bounds<T>(values: PersistentVector<T>, index: i64) -> T {
  match persistent_vector_get_option<T>(values, index) {
    Some(value) -> value
    None -> panic("persistent registration index is out of bounds")
  }
}

fn persistent_module_index(
  modules: PersistentVector<RegisteredModule>,
  identity: ModuleIdentity
) -> i64 {
  for index in 0..persistent_vector_len<RegisteredModule>(modules) {
    if module_identity_eq(
      persistent_get_in_bounds<RegisteredModule>(modules, index).identity,
      identity
    ) { return index }
  }
  0 - 1
}

fn persistent_from_vector<T>(values: borrow Vector<T>) -> PersistentVector<T> {
  let mut result = persistent_vector_empty<T>()
  for index in 0..vector_len<T>(values) {
    result = persistent_vector_push<T>(result, vector_get_in_bounds<T>(values, index))
  }
  result
}

fn add_registered_bindings(
  entries: borrow Vector<ScopeEntry>,
  identity: ModuleIdentity,
  names: List<RegisteredName>
) -> nil {
  match names {
    Nil -> nil
    Cons(name, rest) -> {
      if module_item(name) {
        let spelling = required_text(declaration_identity_name(name.identity))
        let candidate = ScopeCandidate {
          target: ScopeDeclarationTarget(name),
          visibility: name.visibility,
          weak: false,
          origin: registered_origin(name)
        }
        add_binding(entries, identity, spelling, candidate)
      }
      add_registered_bindings(entries, identity, rest)
    }
  }
}

fn build_module(
  modules: borrow Vector<RegisteredModule>,
  imports: borrow Vector<ResolvedImport>,
  synthetic: borrow Vector<RegisteredName>,
  scopes: borrow Vector<PersistentVector<ScopeEntry>>,
  issues: borrow Vector<ScopeIssue>,
  states: borrow Vector<i64>,
  identity: ModuleIdentity
) -> nil {
  let index = module_index(modules, identity)
  if index < 0 { nil }
  else {
    let state = vector_get_in_bounds<i64>(states, index)
    if state != 0 { nil }
    else {
      vector_set<i64>(states, index, 1)
      let module = vector_get_in_bounds<RegisteredModule>(modules, index)
      let entries = vector.new<ScopeEntry>()
      add_registered_bindings(entries, identity, declaration_names(module))
      for synthetic_index in 0..vector_len<RegisteredName>(synthetic) {
        let name = vector_get_in_bounds<RegisteredName>(synthetic, synthetic_index)
        match name.identity {
          ModuleDeclarationIdentity(owner, _, _) -> if module_identity_eq(owner, identity) {
            let spelling = required_text(declaration_identity_name(name.identity))
            let candidate = ScopeCandidate {
              target: ScopeDeclarationTarget(name),
              visibility: name.visibility,
              weak: false,
              origin: registered_origin(name)
            }
            add_binding(
              entries,
              identity,
              spelling,
              candidate
            )
          } else { nil }
          MemberDeclarationIdentity(_, _, _) -> nil
        }
      }
      for import_index in 0..vector_len<ResolvedImport>(imports) {
        let edge = vector_get_in_bounds<ResolvedImport>(imports, import_index)
        if module_identity_eq(edge.importer, identity) {
          build_module(
            modules,
            imports,
            synthetic,
            scopes,
            issues,
            states,
            edge.target
          )
          let target_index = module_index(modules, edge.target)
          if target_index >= 0 {
            let target_entries = vector_get_in_bounds<PersistentVector<ScopeEntry>>(
              scopes,
              target_index
            )
            add_import(
              entries,
              target_entries,
              issues,
              edge
            )
          } else { nil }
        }
      }
      vector_set<PersistentVector<ScopeEntry>>(
        scopes,
        index,
        persistent_from_vector<ScopeEntry>(entries)
      )
      vector_set<i64>(states, index, 2)
      nil
    }
  }
}

fn module_vector(modules: List<RegisteredModule>) -> Vector<RegisteredModule> {
  let result = vector.with_capacity<RegisteredModule>(modules.len())
  for module in modules { vector_push<RegisteredModule>(result, module) }
  result
}

fn import_vector(imports: List<ResolvedImport>) -> Vector<ResolvedImport> {
  let result = vector.with_capacity<ResolvedImport>(imports.len())
  for edge in imports { vector_push<ResolvedImport>(result, edge) }
  result
}

pub(package) fn registration_scope_build(
  module_list: List<RegisteredModule>,
  import_list: List<ResolvedImport>
) -> RegistrationScope {
  registration_scope_build_vectors(
    module_vector(module_list),
    import_vector(import_list),
    vector.new<RegisteredName>()
  )
}

fn registration_scope_build_vectors(
  modules: Vector<RegisteredModule>,
  imports: Vector<ResolvedImport>,
  synthetic: Vector<RegisteredName>
) -> RegistrationScope {
  let scopes = vector.with_capacity<PersistentVector<ScopeEntry>>(modules.len())
  let issues = vector.new<ScopeIssue>()
  let states = vector.with_capacity<i64>(modules.len())
  for _ in 0..vector_len<RegisteredModule>(modules) {
    vector_push<PersistentVector<ScopeEntry>>(scopes, persistent_vector_empty<ScopeEntry>())
    vector_push<i64>(states, 0)
  }
  for index in 0..vector_len<RegisteredModule>(modules) {
    build_module(
      modules,
      imports,
      synthetic,
      scopes,
      issues,
      states,
      vector_get_in_bounds<RegisteredModule>(modules, index).identity
    )
  }
  let tables = vector.with_capacity<ScopeTable>(modules.len())
  for index in 0..vector_len<PersistentVector<ScopeEntry>>(scopes) {
    let entries = vector_get_in_bounds<PersistentVector<ScopeEntry>>(scopes, index)
    vector_push<ScopeTable>(
      tables,
      ScopeTable { entries: entries, index: scope_index_for(entries) }
    )
  }
  RegistrationScope(
    (
      persistent_from_vector<RegisteredModule>(modules),
      persistent_from_vector<ResolvedImport>(imports),
      persistent_from_vector<RegisteredName>(synthetic),
      persistent_from_vector<ScopeTable>(tables),
      persistent_from_vector<ScopeIssue>(issues)
    )
  )
}

pub(package) fn registration_scope_lookup(
  scope: RegistrationScope,
  module: ModuleIdentity,
  spelling: str
) -> ScopeLookup {
  match scope {
    RegistrationScope((modules, _, _, _, _)) ->
      registration_scope_lookup_at(scope, persistent_module_index(modules, module), spelling)
  }
}

pub(package) fn registration_scope_lookup_at(
  scope: borrow RegistrationScope,
  module_index: i64,
  spelling: str
) -> ScopeLookup {
  match scope {
    RegistrationScope((_, _, _, scopes, _)) -> {
      if module_index < 0 or module_index >= persistent_vector_len<ScopeTable>(scopes) {
        ScopeNameMissing()
      } else {
        let table = persistent_get_in_bounds<ScopeTable>(scopes, module_index)
        let entries = table.entries
        let index = persistent_entry_index(table.index, entries, spelling)
        if index < 0 { ScopeNameMissing() }
        else {
          let entry = persistent_get_in_bounds<ScopeEntry>(entries, index)
          match entry.status {
            ScopeEntryResolved -> ScopeNameResolved(entry.primary)
            ScopeEntryAmbiguous -> ScopeNameAmbiguous(entry.primary, entry.conflict)
          }
        }
      }
    }
  }
}

pub(package) fn registration_scope_lookup_span(
  scope: RegistrationScope,
  module: ModuleIdentity,
  spelling: Span
) -> ScopeLookup {
  match scope {
    RegistrationScope((modules, _, _, _, _)) ->
      registration_scope_lookup_span_at(
        scope,
        persistent_module_index(modules, module),
        spelling
      )
  }
}

pub(package) fn registration_scope_lookup_span_at(
  scope: borrow RegistrationScope,
  module_index: i64,
  spelling: Span
) -> ScopeLookup {
  match scope {
    RegistrationScope((_, _, _, scopes, _)) -> {
      if module_index < 0 or module_index >= persistent_vector_len<ScopeTable>(scopes) {
        ScopeNameMissing()
      } else {
        let table = persistent_get_in_bounds<ScopeTable>(scopes, module_index)
        let entries = table.entries
        let index = persistent_entry_index_span(table.index, entries, spelling)
        if index < 0 { ScopeNameMissing() }
        else {
          let entry = persistent_get_in_bounds<ScopeEntry>(entries, index)
          match entry.status {
            ScopeEntryResolved -> ScopeNameResolved(entry.primary)
            ScopeEntryAmbiguous -> ScopeNameAmbiguous(entry.primary, entry.conflict)
          }
        }
      }
    }
  }
}

fn candidate_targets_declaration(
  candidate: ScopeCandidate,
  declaration: DeclarationIdentity
) -> bool {
  match candidate.target {
    ScopeDeclarationTarget(name) -> declaration_identity_eq(name.identity, declaration)
    ScopeModuleTarget(_) -> false
  }
}

fn lookup_exact_candidate(
  lookup: ScopeLookup,
  declaration: DeclarationIdentity
) -> Option<ScopeCandidate> {
  match lookup {
    ScopeNameResolved(candidate) -> if candidate_targets_declaration(candidate, declaration) {
      Some(candidate)
    } else { None<ScopeCandidate>() }
    ScopeNameAmbiguous(primary, conflict) -> if candidate_targets_declaration(
      primary,
      declaration
    ) { Some(primary) }
    else {
      match conflict {
        Some(candidate) -> if candidate_targets_declaration(candidate, declaration) {
          Some(candidate)
        } else { None<ScopeCandidate>() }
        None -> None<ScopeCandidate>()
      }
    }
    ScopeNameMissing -> None<ScopeCandidate>()
  }
}

--- The spelling by which one module can name an exact declaration. This is a
--- presentation projection over the already-resolved scope, not a fresh name
--- lookup; an ambiguous entry may still contain the exact identity being
--- described.
pub(package) fn registration_scope_visible_declaration_spelling(
  scope: RegistrationScope,
  caller: ModuleIdentity,
  declaration: DeclarationIdentity
) -> Option<str> {
  match scope {
    RegistrationScope((modules, _, _, scopes, _)) -> {
      let module_index = persistent_module_index(modules, caller)
      if module_index < 0 { None<str>() }
      else {
        let entries = persistent_get_in_bounds<ScopeTable>(scopes, module_index).entries
        for index in 0..persistent_vector_len<ScopeEntry>(entries) {
          let entry = persistent_get_in_bounds<ScopeEntry>(entries, index)
          if candidate_targets_declaration(entry.primary, declaration) {
            return Some<str>(entry.spelling)
          } else {
            match entry.conflict {
              Some(candidate) -> if candidate_targets_declaration(candidate, declaration) {
                return Some<str>(entry.spelling)
              }
              None -> nil
            }
          }
        }
        None<str>()
      }
    }
  }
}

--- Preserve the authored module alias that reaches an exact target. Module
--- aliases are import-edge data even when another binding makes the same
--- spelling ambiguous.
pub(package) fn registration_scope_module_alias(
  scope: RegistrationScope,
  caller: ModuleIdentity,
  target: ModuleIdentity
) -> Option<str> {
  match scope {
    RegistrationScope((_, imports, _, _, _)) -> {
      for index in 0..persistent_vector_len<ResolvedImport>(imports) {
        let edge = persistent_get_in_bounds<ResolvedImport>(imports, index)
        if module_identity_eq(edge.importer, caller) and module_identity_eq(edge.target, target) {
          match edge.binding {
            ResolvedModuleImport(alias) -> return Some<str>(required_text(alias))
            ResolvedSymbolImport(_) -> nil
          }
        } else { nil }
      }
      None<str>()
    }
  }
}

fn module_exposes_declaration(
  scope: RegistrationScope,
  module: ModuleIdentity,
  declaration: DeclarationIdentity,
  importer: ModuleIdentity
) -> bool {
  match scope {
    RegistrationScope((modules, _, _, scopes, _)) -> {
      let module_index = persistent_module_index(modules, module)
      if module_index < 0 { false }
      else {
        let entries = persistent_get_in_bounds<ScopeTable>(scopes, module_index).entries
        for index in 0..persistent_vector_len<ScopeEntry>(entries) {
          let entry = persistent_get_in_bounds<ScopeEntry>(entries, index)
          if candidate_targets_declaration(entry.primary, declaration) and
            candidate_visible_from(entry.primary, module, importer) { return true }
          match entry.conflict {
            Some(candidate) -> if candidate_targets_declaration(candidate, declaration) and
              candidate_visible_from(candidate, module, importer) { return true }
            None -> nil
          }
        }
        false
      }
    }
  }
}

-- Weak implicit-prelude bindings make a type name available for ordinary
-- expressions but do not grant its inherent methods. An explicit module
-- import does grant the public surface, including declarations re-exported by
-- a facade, without injecting those declarations into the caller's scope.
pub(package) fn registration_scope_declaration_is_weak_only(
  scope: RegistrationScope,
  caller: ModuleIdentity,
  declaration: DeclarationIdentity
) -> bool {
  let spelling = required_text(declaration_identity_name(declaration))
  match lookup_exact_candidate(registration_scope_lookup(scope, caller, spelling), declaration) {
    None -> false
    Some(binding) -> if not binding.weak { false }
    else {
      match scope {
        RegistrationScope((_, imports, _, _, _)) -> {
          for index in 0..persistent_vector_len<ResolvedImport>(imports) {
            let edge = persistent_get_in_bounds<ResolvedImport>(imports, index)
            if module_identity_eq(edge.importer, caller) and not edge.weak {
              match edge.binding {
                ResolvedModuleImport(_) -> if module_exposes_declaration(
                  scope,
                  edge.target,
                  declaration,
                  caller
                ) { return false }
                ResolvedSymbolImport(_) -> nil
              }
            } else { nil }
          }
          true
        }
      }
    }
  }
}

pub(package) fn registration_scope_lookup_qualified_span(
  scope: RegistrationScope,
  caller: ModuleIdentity,
  qualifier: Span,
  spelling: Span
) -> QualifiedScopeLookup {
  match registration_scope_lookup_span(scope, caller, qualifier) {
    ScopeNameResolved(candidate) -> match candidate.target {
      ScopeModuleTarget(target) -> match registration_scope_lookup_span(scope, target, spelling) {
        ScopeNameMissing -> QualifiedScopeMissing
        ScopeNameAmbiguous(primary, conflict) ->
          QualifiedScopeAmbiguous(primary, conflict)
        ScopeNameResolved(member) -> if candidate_visible_from(member, target, caller) {
          QualifiedScopeResolved(member)
        } else { QualifiedScopeInvisible(member) }
      }
      _ -> QualifiedScopeMissing
    }
    _ -> QualifiedScopeMissing
  }
}

pub(package) fn registration_scope_candidate_declaration(
  candidate: ScopeCandidate,
  namespace: DeclarationNamespace
) -> Option<RegisteredName> {
  match candidate.target {
    ScopeDeclarationTarget(name) -> if declaration_namespace_code(
      declaration_identity_namespace(name.identity)
    ) == declaration_namespace_code(namespace) { Some(name) }
    else { None }
    ScopeModuleTarget(_) -> None
  }
}

pub(package) fn registration_scope_declaration_from_lookup(
  lookup: ScopeLookup,
  namespace: DeclarationNamespace
) -> Option<RegisteredName> {
  match lookup {
    ScopeNameMissing -> None
    ScopeNameResolved(candidate) -> registration_scope_candidate_declaration(
      candidate,
      namespace
    )
    ScopeNameAmbiguous(primary, conflict) -> if candidates_are_type_constructor_pair(
      primary,
      conflict
    ) {
      match registration_scope_candidate_declaration(primary, namespace) {
        Some(name) -> Some(name)
        None -> match conflict {
          Some(candidate) -> registration_scope_candidate_declaration(candidate, namespace)
          None -> None
        }
      }
    } else { None<RegisteredName>() }
  }
}

pub(package) fn registration_scope_qualified_from_lookup(
  lookup: ScopeLookup,
  target: ModuleIdentity,
  caller: ModuleIdentity
) -> QualifiedScopeLookup {
  match lookup {
    ScopeNameMissing -> QualifiedScopeMissing
    ScopeNameAmbiguous(primary, conflict) -> QualifiedScopeAmbiguous(primary, conflict)
    ScopeNameResolved(candidate) -> if candidate_visible_from(candidate, target, caller) {
      QualifiedScopeResolved(candidate)
    } else { QualifiedScopeInvisible(candidate) }
  }
}

pub(package) fn registration_scope_qualified_declaration_from_lookup(
  lookup: ScopeLookup,
  namespace: DeclarationNamespace,
  target: ModuleIdentity,
  caller: ModuleIdentity
) -> Option<RegisteredName> {
  let selected = match lookup {
    ScopeNameMissing -> None<(RegisteredName, ScopeCandidate)>()
    ScopeNameResolved(candidate) -> match registration_scope_candidate_declaration(
      candidate,
      namespace
    ) {
      Some(name) -> Some((name, candidate))
      None -> None<(RegisteredName, ScopeCandidate)>()
    }
    ScopeNameAmbiguous(primary, conflict) -> if candidates_are_type_constructor_pair(
      primary,
      conflict
    ) {
      match registration_scope_candidate_declaration(primary, namespace) {
        Some(name) -> Some((name, primary))
        None -> match conflict {
          Some(candidate) -> match registration_scope_candidate_declaration(
            candidate,
            namespace
          ) {
            Some(name) -> Some((name, candidate))
            None -> None<(RegisteredName, ScopeCandidate)>()
          }
          None -> None<(RegisteredName, ScopeCandidate)>()
        }
      }
    } else { None<(RegisteredName, ScopeCandidate)>() }
  }
  match selected {
    Some((name, declaration)) -> if candidate_visible_from(declaration, target, caller) {
      Some(name)
    } else { None<RegisteredName>() }
    None -> None<RegisteredName>()
  }
}

pub(package) fn registration_scope_lookup_declaration(
  scope: RegistrationScope,
  module: ModuleIdentity,
  namespace: DeclarationNamespace,
  spelling: str
) -> Option<RegisteredName> {
  registration_scope_declaration_from_lookup(
    registration_scope_lookup(scope, module, spelling),
    namespace
  )
}

pub(package) fn registration_scope_lookup_declaration_span(
  scope: RegistrationScope,
  module: ModuleIdentity,
  namespace: DeclarationNamespace,
  spelling: Span
) -> Option<RegisteredName> {
  registration_scope_declaration_from_lookup(
    registration_scope_lookup_span(scope, module, spelling),
    namespace
  )
}

pub(package) fn registration_scope_lookup_qualified_declaration(
  scope: RegistrationScope,
  caller: ModuleIdentity,
  qualifier: str,
  namespace: DeclarationNamespace,
  spelling: str
) -> Option<RegisteredName> {
  match registration_scope_lookup(scope, caller, qualifier) {
    ScopeNameResolved(candidate) -> match candidate.target {
      ScopeModuleTarget(target) -> registration_scope_qualified_declaration_from_lookup(
        registration_scope_lookup(scope, target, spelling),
        namespace,
        target,
        caller
      )
      _ -> None
    }
    _ -> None
  }
}

pub(package) fn registration_scope_lookup_qualified_declaration_span(
  scope: RegistrationScope,
  caller: ModuleIdentity,
  qualifier: Span,
  namespace: DeclarationNamespace,
  spelling: Span
) -> Option<RegisteredName> {
  match registration_scope_lookup_span(scope, caller, qualifier) {
    ScopeNameResolved(candidate) -> match candidate.target {
      ScopeModuleTarget(target) -> registration_scope_qualified_declaration_from_lookup(
        registration_scope_lookup_span(scope, target, spelling),
        namespace,
        target,
        caller
      )
      _ -> None
    }
    _ -> None
  }
}

pub(package) fn registration_scope_issue_count(scope: RegistrationScope) -> usize {
  match scope { RegistrationScope((_, _, _, _, issues)) -> issues.len() }
}

pub(package) fn registration_scope_issue_at(
  scope: RegistrationScope,
  index: i64
) -> ScopeIssue {
  match scope {
    RegistrationScope((_, _, _, _, issues)) ->
      persistent_get_in_bounds<ScopeIssue>(issues, index)
  }
}

pub(package) fn registration_scope_entry_count_at(
  scope: RegistrationScope,
  module_index: i64
) -> usize {
  match scope {
    RegistrationScope((_, _, _, scopes, _)) -> {
      let table = persistent_get_in_bounds<ScopeTable>(scopes, module_index)
      table.entries.len()
    }
  }
}

pub(package) fn registration_scope_entry_at(
  scope: RegistrationScope,
  module_index: i64,
  entry_index: i64
) -> ScopeEntry {
  match scope {
    RegistrationScope((_, _, _, scopes, _)) -> {
      let table = persistent_get_in_bounds<ScopeTable>(scopes, module_index)
      let entries = table.entries
      persistent_get_in_bounds<ScopeEntry>(entries, entry_index)
    }
  }
}

pub(package) fn registration_builder() -> RegistrationBuilder {
  RegistrationBuilder(vector.new<RegistrationBuilderEntry>())
}

pub(package) fn registration_builder_from_scope(
  scope: RegistrationScope
) -> RegistrationBuilder {
  let builder = registration_builder()
  match scope {
    RegistrationScope((modules, imports, synthetic, _, _)) -> {
      for index in 0..persistent_vector_len<RegisteredModule>(modules) {
        registration_builder_add(
          builder,
          persistent_get_in_bounds<RegisteredModule>(modules, index)
        )
      }
      for index in 0..persistent_vector_len<ResolvedImport>(imports) {
        registration_builder_add_import(
          builder,
          persistent_get_in_bounds<ResolvedImport>(imports, index)
        )
      }
      for index in 0..persistent_vector_len<RegisteredName>(synthetic) {
        registration_builder_add_synthetic(
          builder,
          persistent_get_in_bounds<RegisteredName>(synthetic, index)
        )
      }
    }
  }
  builder
}

pub(package) fn registration_builder_add(
  builder: RegistrationBuilder,
  module: RegisteredModule
) -> nil {
  match builder {
    RegistrationBuilder(entries) -> {
      vector_push<RegistrationBuilderEntry>(entries, RegistrationBuilderModule(module))
      nil
    }
  }
}

pub(package) fn registration_builder_add_import(
  builder: RegistrationBuilder,
  edge: ResolvedImport
) -> nil {
  match builder {
    RegistrationBuilder(entries) -> {
      vector_push<RegistrationBuilderEntry>(entries, RegistrationBuilderImport(edge))
      nil
    }
  }
}

pub(package) fn registration_builder_add_synthetic(
  builder: RegistrationBuilder,
  declaration: RegisteredName
) -> nil {
  match builder {
    RegistrationBuilder(entries) -> {
      vector_push<RegistrationBuilderEntry>(
        entries,
        RegistrationBuilderSynthetic(declaration)
      )
      nil
    }
  }
}

fn registration_builder_find_module(
  entries: borrow Vector<RegistrationBuilderEntry>,
  identity: ModuleIdentity
) -> Option<RegisteredModule> {
  for index in 0..vector_len<RegistrationBuilderEntry>(entries) {
    match vector_get_in_bounds<RegistrationBuilderEntry>(entries, index) {
      RegistrationBuilderModule(module) -> if module_identity_eq(module.identity, identity) {
        return Some(module)
      } else { nil }
      _ -> nil
    }
  }
  None
}

pub(package) fn registration_builder_resolve_import(
  builder: RegistrationBuilder,
  importer: ModuleIdentity,
  target: ModuleIdentity,
  declaration: ImportDeclaration,
  weak: bool
) -> nil {
  match builder {
    RegistrationBuilder(entries) -> {
      match registration_builder_find_module(entries, importer) {
        None -> panic("resolved import has no retained importer registration")
        Some(module) -> {
          vector_push<RegistrationBuilderEntry>(
            entries,
            RegistrationBuilderImport(
              resolved_import(
                module,
                declaration,
                target,
                weak
              )
            )
          )
          nil
        }
      }
    }
  }
}

pub(package) fn registration_builder_freeze(
  builder: RegistrationBuilder
) -> RegistrationScope {
  let modules = vector.new<RegisteredModule>()
  let imports = vector.new<ResolvedImport>()
  let synthetic = vector.new<RegisteredName>()
  match builder {
    RegistrationBuilder(entries) -> {
      for index in 0..vector_len<RegistrationBuilderEntry>(entries) {
        match vector_get_in_bounds<RegistrationBuilderEntry>(entries, index) {
          RegistrationBuilderModule(module) -> vector_push<RegisteredModule>(modules, module)
          RegistrationBuilderImport(edge) -> vector_push<ResolvedImport>(imports, edge)
          RegistrationBuilderSynthetic(declaration) ->
            vector_push<RegisteredName>(synthetic, declaration)
        }
      }
    }
  }
  registration_scope_build_vectors(modules, imports, synthetic)
}

pub(package) fn registration_scope() -> RegistrationScope {
  registration_builder_freeze(registration_builder())
}

pub(package) fn registration_scope_len(scope: borrow RegistrationScope) -> usize {
  match scope { RegistrationScope((modules, _, _, _, _)) -> modules.len() }
}

pub(package) fn registration_scope_at(
  scope: borrow RegistrationScope,
  index: i64
) -> RegisteredModule {
  match scope {
    RegistrationScope((modules, _, _, _, _)) ->
      persistent_get_in_bounds<RegisteredModule>(modules, index)
  }
}

pub(package) fn registration_scope_find_source(
  scope: borrow RegistrationScope,
  source: i64
) -> Option<RegisteredModule> {
  match scope {
    RegistrationScope((modules, _, _, _, _)) -> {
      for index in 0..persistent_vector_len<RegisteredModule>(modules) {
        let module = persistent_get_in_bounds<RegisteredModule>(modules, index)
        if __str_ptr(module.source.text) == source { return Some(module) }
      }
      None<RegisteredModule>()
    }
  }
}

pub(package) fn registration_scope_find(
  scope: RegistrationScope,
  identity: ModuleIdentity
) -> Option<RegisteredModule> {
  match scope {
    RegistrationScope((modules, _, _, _, _)) -> {
      let index = persistent_module_index(modules, identity)
      if index < 0 { None<RegisteredModule>() }
      else { Some(persistent_get_in_bounds<RegisteredModule>(modules, index)) }
    }
  }
}

pub(package) fn registration_scope_combined(
  left: RegistrationScope,
  right: RegistrationScope
) -> RegistrationScope {
  registration_scope_combined_borrowed(left, right)
}

-- Reusable checked products own their scope once and lend it to each
-- extending consumer. Combining through borrows prevents one worker from
-- consuming the managed vectors that later workers still need.
pub(package) fn registration_scope_combined_borrowed(
  left: borrow RegistrationScope,
  right: borrow RegistrationScope
) -> RegistrationScope {
  let modules = vector.new<RegisteredModule>()
  let imports = vector.new<ResolvedImport>()
  let synthetic = vector.new<RegisteredName>()
  match left {
    RegistrationScope((left_modules, left_imports, left_synthetic, _, _)) -> {
      for index in 0..persistent_vector_len<RegisteredModule>(left_modules) {
        vector_push<RegisteredModule>(
          modules,
          persistent_get_in_bounds<RegisteredModule>(left_modules, index)
        )
      }
      for index in 0..persistent_vector_len<ResolvedImport>(left_imports) {
        vector_push<ResolvedImport>(
          imports,
          persistent_get_in_bounds<ResolvedImport>(left_imports, index)
        )
      }
      for index in 0..persistent_vector_len<RegisteredName>(left_synthetic) {
        vector_push<RegisteredName>(
          synthetic,
          persistent_get_in_bounds<RegisteredName>(left_synthetic, index)
        )
      }
    }
  }
  match right {
    RegistrationScope((right_modules, right_imports, right_synthetic, _, _)) -> {
      for index in 0..persistent_vector_len<RegisteredModule>(right_modules) {
        vector_push<RegisteredModule>(
          modules,
          persistent_get_in_bounds<RegisteredModule>(right_modules, index)
        )
      }
      for index in 0..persistent_vector_len<ResolvedImport>(right_imports) {
        vector_push<ResolvedImport>(
          imports,
          persistent_get_in_bounds<ResolvedImport>(right_imports, index)
        )
      }
      for index in 0..persistent_vector_len<RegisteredName>(right_synthetic) {
        vector_push<RegisteredName>(
          synthetic,
          persistent_get_in_bounds<RegisteredName>(right_synthetic, index)
        )
      }
    }
  }
  registration_scope_build_vectors(modules, imports, synthetic)
}

fn registration_name_matches(
  registered: RegisteredName,
  namespace: DeclarationNamespace,
  name: str
) -> bool {
  declaration_identity_owner(registered.identity) == nil and
    declaration_namespace_code(declaration_identity_namespace(registered.identity)) ==
    declaration_namespace_code(namespace) and
    match declaration_identity_name(registered.identity).text() {
      Some(spelling) -> str_eq(spelling, name) == 1
      None -> false
    }
}

--- Whether no distinct declaration in the retained module forest shares this
--- declaration's namespace and spelling. Used only for a readable fallback
--- when the consuming scope has no binding for an authority it must diagnose.
pub(package) fn registration_scope_declaration_spelling_is_unique(
  scope: RegistrationScope,
  declaration: DeclarationIdentity
) -> bool {
  let namespace = declaration_identity_namespace(declaration)
  let spelling = required_text(declaration_identity_name(declaration))
  match scope {
    RegistrationScope((modules, _, synthetic, _, _)) -> {
      for module_index in 0..persistent_vector_len<RegisteredModule>(modules) {
        let module = persistent_get_in_bounds<RegisteredModule>(modules, module_index)
        for registered in declaration_names(module) {
          if registration_name_matches(registered, namespace, spelling) and
            not
            declaration_identity_eq(registered.identity, declaration) { return false }
        }
      }
      for index in 0..persistent_vector_len<RegisteredName>(synthetic) {
        let registered = persistent_get_in_bounds<RegisteredName>(synthetic, index)
        if registration_name_matches(registered, namespace, spelling) and
          not
          declaration_identity_eq(registered.identity, declaration) { return false }
      }
      true
    }
  }
}

pub(package) fn registration_name_belongs_to(
  registered: RegisteredName,
  module: ModuleIdentity
) -> bool {
  match registered.identity {
    ModuleDeclarationIdentity(owner, _, _) -> module_identity_eq(owner, module)
    MemberDeclarationIdentity(_, _, _) -> false
  }
}

fn registration_module_selected(
  selected: borrow Vector<ModuleIdentity>,
  identity: ModuleIdentity
) -> bool {
  for index in 0..vector_len<ModuleIdentity>(selected) {
    if module_identity_eq(vector_get_in_bounds<ModuleIdentity>(selected, index), identity) {
      return true
    }
  }
  false
}

-- A checked dependency product retains only its selected module forest. Keep
-- the typed declaration catalogs and resolved imports over that same forest,
-- preserving producer identities without rebuilding them from raw tables.
pub(package) fn registration_scope_selected(
  scope: RegistrationScope,
  selected: borrow Vector<ModuleIdentity>
) -> RegistrationScope {
  let modules = vector.new<RegisteredModule>()
  let imports = vector.new<ResolvedImport>()
  let synthetic = vector.new<RegisteredName>()
  match scope {
    RegistrationScope((all_modules, all_imports, all_synthetic, _, _)) -> {
      for index in 0..persistent_vector_len<RegisteredModule>(all_modules) {
        let module = persistent_get_in_bounds<RegisteredModule>(all_modules, index)
        if registration_module_selected(selected, module.identity) {
          vector_push<RegisteredModule>(modules, module)
        } else { nil }
      }
      for index in 0..persistent_vector_len<ResolvedImport>(all_imports) {
        let edge = persistent_get_in_bounds<ResolvedImport>(all_imports, index)
        if registration_module_selected(selected, edge.importer) and
          registration_module_selected(selected, edge.target) {
            vector_push<ResolvedImport>(imports, edge)
          } else { nil }
      }
      for index in 0..persistent_vector_len<RegisteredName>(all_synthetic) {
        let declaration = persistent_get_in_bounds<RegisteredName>(all_synthetic, index)
        let mut retained = false
        for module_index in 0..vector_len<ModuleIdentity>(selected) {
          if registration_name_belongs_to(
            declaration,
            vector_get_in_bounds<ModuleIdentity>(selected, module_index)
          ) { retained = true }
        }
        if retained { vector_push<RegisteredName>(synthetic, declaration) } else { nil }
      }
    }
  }
  registration_scope_build_vectors(modules, imports, synthetic)
}

fn registration_scope_find_synthetic(
  scope: RegistrationScope,
  module: ModuleIdentity,
  namespace: DeclarationNamespace,
  name: str
) -> Option<RegisteredName> {
  match scope {
    RegistrationScope((_, _, synthetic, _, _)) -> {
      for index in 0..persistent_vector_len<RegisteredName>(synthetic) {
        let registered = persistent_get_in_bounds<RegisteredName>(synthetic, index)
        if registration_name_belongs_to(registered, module) and
          registration_name_matches(registered, namespace, name) { return Some(registered) }
      }
      None
    }
  }
}

pub(package) fn registration_scope_find_declaration(
  scope: RegistrationScope,
  module: ModuleIdentity,
  namespace: DeclarationNamespace,
  name: str
) -> Option<RegisteredName> {
  match registration_scope_find(scope, module) {
    Some(registered_module) -> {
      for registered in declaration_names(registered_module) {
        if registration_name_matches(registered, namespace, name) { return Some(registered) }
      }
      registration_scope_find_synthetic(scope, module, namespace, name)
    }
    None -> None
  }
}

pub(package) fn registration_scope_has_other_declaration(
  scope: RegistrationScope,
  module: ModuleIdentity,
  expected: DeclarationNamespace,
  name: str
) -> bool {
  match registration_scope_find(scope, module) {
    Some(registered_module) -> {
      for registered in declaration_names(registered_module) {
        if declaration_identity_owner(registered.identity) == nil and
          declaration_namespace_code(declaration_identity_namespace(registered.identity)) !=
          declaration_namespace_code(expected) and
          match declaration_identity_name(registered.identity).text() {
            Some(spelling) -> str_eq(spelling, name) == 1
            None -> false
          } { return true }
      }
      match scope {
        RegistrationScope((_, _, synthetic, _, _)) -> {
          for index in 0..persistent_vector_len<RegisteredName>(synthetic) {
            let registered = persistent_get_in_bounds<RegisteredName>(synthetic, index)
            if registration_name_belongs_to(registered, module) and
              declaration_namespace_code(declaration_identity_namespace(registered.identity)) !=
              declaration_namespace_code(expected) and
              match declaration_identity_name(registered.identity).text() {
                Some(spelling) -> str_eq(spelling, name) == 1
                None -> false
              } { return true }
          }
          false
        }
      }
    }
    None -> false
  }
}
