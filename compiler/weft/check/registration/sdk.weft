-- Exact declarations of the SDK package.
--
-- Sealed predicates and capabilities follow the exact SDK declaration, never
-- its spelling: a declaration counts only when its module belongs to the SDK
-- package.

use compiler/project/identity.{
  DeclarationIdentity,
  DeclarationNamespace,
  NamedModuleIdentity,
  module_identity_package
}
use compiler/weft/check/registration/scope.{
  RegistrationScope,
  registration_scope_at,
  registration_scope_find_declaration,
  registration_scope_len
}
use stdlib/option.{None, Option, Some}

-- The one declaration an SDK module exports under `name`, or nothing when
-- the program lacks the module or the name is ambiguous.
pub(package) fn registration_scope_sdk_declaration(
  scope: RegistrationScope,
  sdk_package_id: i64,
  module_path: str,
  namespace: DeclarationNamespace,
  name: str
) -> DeclarationIdentity? {
  let mut selected: DeclarationIdentity? = nil
  if sdk_package_id <= 0 { return nil }
  let mut index: usize = 0
  while index < registration_scope_len(scope) {
    let module = registration_scope_at(scope, __u64_to_i64(__usize_to_u64(index)))
    match module.identity {
      NamedModuleIdentity(path, _) -> if path == module_path and
        module_identity_package(module.identity) == sdk_package_id {
          match registration_scope_find_declaration(scope, module.identity, namespace, name) {
            Some(found) -> match selected {
              nil -> { selected = found.identity }
              other: DeclarationIdentity -> return nil
            }
            None -> nil
          }
        } else { nil }
      _ -> nil
    }
    index = index + 1
  }
  selected
}
