-- Scoped public host inspection over the existing checker. Raw table/type
-- storage is private to this adapter and disappears with checker storage.
use stdlib/typecheck.{*}
use stdlib/semantic_type.{*}
use stdlib/list.{*}
use stdlib/option.{*}
use stdlib/result.{*}
use stdlib/num
use stdlib/display
use runtime/identity.{RuntimeIdentity, runtime_identity_new}
use runtime/memory.{mem_load64_at}
use compiler/storage.{*}
use compiler/types/algebra.{*}
use compiler/weft/check/body.{*}
use compiler/weft/check/table.{*}
use compiler/project/module.{*}
use compiler/weft/parse.{resolve_primitive_type_name}
use compiler/weft/check/type_projection.{semantic_type_fact_copy, semantic_type_fact_from_checker}

-- Retaining the generative token prevents identity reuse. The raw type is
-- inspected only after exact scope equality, including for every type argument.
pub(package) type HostTypeIdentity = opaque (RuntimeIdentity, i64, i64)

type HostTypeScope { identity: RuntimeIdentity, table: i64, source: i64 }

fn issue_at(scope: HostTypeScope, ty: i64, origin: i64) -> ResolvedType<HostTypeIdentity> {
  ResolvedType {
    identity: HostTypeIdentity((scope.identity, ty, origin)),
    description: semantic_type_fact_from_checker(ty, scope.table, origin)
  }
}

fn issue(scope: HostTypeScope, ty: i64) -> ResolvedType<HostTypeIdentity> {
  issue_at(scope, ty, scope.source)
}

type HostTypeNode { HostTypeNode(i64, i64) }

fn type_node(scope: HostTypeScope, identity: HostTypeIdentity) -> Result<HostTypeNode, TypeQueryError> {
  match identity {
    HostTypeIdentity((owner, ty, origin)) -> if owner == scope.identity { Ok<HostTypeNode, TypeQueryError>(HostTypeNode(ty, origin)) }
      else { Err<HostTypeNode, TypeQueryError>(ForeignTypeIdentity) }
  }
}

fn type_argument_nodes(scope: HostTypeScope, arguments: List<HostTypeIdentity>) -> Result<i64, TypeQueryError> {
  let result = nlist_new()
  let mut remaining = arguments
  while not remaining.is_empty() {
    match remaining {
      Nil -> nil
      Cons(identity, rest) -> match type_node(scope, identity) {
        Err(error) -> return Err<i64, TypeQueryError>(error)
        Ok(HostTypeNode(ty, origin)) -> { nlist_add(result, ty); remaining = rest; nil }
      }
    }
  }
  Ok<i64, TypeQueryError>(result)
}

fn constraint_issues(scope: HostTypeScope, entry: i64, arguments: i64) -> List<TypeArgumentIssue> {
  let parameters = ttable_entry_tparams(entry)
  let substitution = build_subst(parameters, arguments)
  let mut issues = Nil<TypeArgumentIssue>()
  for i in 0..nlist_len(parameters) {
    let parameter = nlist_get(parameters, i)
    let bounds = node_f4(parameter)
    if bounds != 0 and i < nlist_len(arguments) {
      let argument = nlist_get(arguments, i)
      for bi in 0..nlist_len(bounds) {
        let required = typeck_subst_resolve_associated_type(nlist_get(bounds, bi), parameters, substitution, scope.table)
        let carried = if ty_tag(argument) == 12 {
          impl_tparam_has_bound(ttable_get_tparams(scope.table), ty_var_id(argument), required)
        } else { false }
        let position = i.to_usize_checked().unwrap()
        let argument_fact = semantic_type_fact_from_checker(argument, scope.table, scope.source)
        let required_fact = semantic_type_fact_from_checker(required, scope.table, scope.source)
        if not carried and ctable_conforms_type_atom(ttable_get_ct(scope.table), argument, required) == 0 {
          issues = Cons(TypeArgumentTraitRequired(position, argument_fact, required_fact), issues)
        } else {
          if typeck_trait_assoc_constraints_hold(scope.table, argument, required) == 0 {
            issues = Cons(TypeArgumentAssociatedTypesRejected(position, argument_fact, required_fact), issues)
          } else { nil }
        }
      }
    } else { nil }
  }
  issues.reverse()
}

fn resolve(scope: HostTypeScope, request: TypeName<HostTypeIdentity>) -> Result<ResolvedType<HostTypeIdentity>, TypeQueryError> {
  let arguments = match type_argument_nodes(scope, request.arguments) {
    Err(error) -> return Err<ResolvedType<HostTypeIdentity>, TypeQueryError>(error)
    Ok(values) -> values
  }
  let actual = nlist_len(arguments)
  let primitive = match request.qualifier {
    None -> resolve_primitive_type_name(__str_ptr(request.name), 0, __str_len(request.name))
    Some(_) -> 0
  }
  if primitive != 0 {
    if actual == 0 { return Ok<ResolvedType<HostTypeIdentity>, TypeQueryError>(issue(scope, primitive)) }
    else { return Err<ResolvedType<HostTypeIdentity>, TypeQueryError>(TypeArgumentCount(0, actual.to_usize_checked().unwrap())) }
  } else { nil }
  let declaration = match request.qualifier {
    None -> module_scope_lookup_declaration(scope.table, scope.source, module_decl_namespace_type(), __str_ptr(request.name), 0, __str_len(request.name))
    Some(qualifier) -> module_scope_lookup_qualified_declaration(scope.table, scope.source, __str_ptr(qualifier), 0, __str_len(qualifier), module_decl_namespace_type(), __str_ptr(request.name), 0, __str_len(request.name))
  }
  let entry = if declaration == 0 { 0 } else { ttable_lookup_decl_fact(scope.table, declaration) }
  if entry == 0 { return Err<ResolvedType<HostTypeIdentity>, TypeQueryError>(TypeNotFound) } else { nil }
  let parameters = ttable_entry_tparams(entry)
  let expected = if parameters == 0 { 0 } else { nlist_len(parameters) }
  if expected != actual {
    return Err<ResolvedType<HostTypeIdentity>, TypeQueryError>(TypeArgumentCount(expected.to_usize_checked().unwrap(), actual.to_usize_checked().unwrap()))
  } else { nil }
  if actual > 0 {
    let issues = constraint_issues(scope, entry, arguments)
    if not issues.is_empty() { return Err<ResolvedType<HostTypeIdentity>, TypeQueryError>(TypeArgumentsRejected(issues)) } else { nil }
  } else { nil }
  let ty = typeck_named_type_from_declaration(scope.table, declaration, arguments)
  if ty == 0 { Err<ResolvedType<HostTypeIdentity>, TypeQueryError>(TypeNotFound) }
  else { Ok<ResolvedType<HostTypeIdentity>, TypeQueryError>(issue_at(scope, ty, ttable_entry_source(entry))) }
}

fn field(scope: HostTypeScope, base: HostTypeIdentity, selector: TypeField) -> Result<ResolvedType<HostTypeIdentity>, TypeQueryError> {
  let node = match type_node(scope, base) {
    Err(error) -> return Err<ResolvedType<HostTypeIdentity>, TypeQueryError>(error)
    Ok(value) -> value
  }
  let (ty, origin) = match node { HostTypeNode(value, source) -> (value, source) }
  let tuple = ty_is_record(ty) and ty_record_tuple_kind(ty) != 0
  let found = match selector {
    NamedTypeField(name) -> if tuple { 0 }
      else { typecheck_resolve_field_type(scope.table, ty, __str_ptr(name), 0, __str_len(name)) }
    PositionalTypeField(index) -> if not tuple { 0 }
      else {
        let position = index.to_u64().to_i64_checked().unwrap_or(0 - 1)
        let fields = ty_record_fields(ty)
        if position < 0 or fields == 0 or position >= nlist_len(fields) { 0 }
        else { ty_record_field_type(ty_record_field_at_layout_index(ty, position)) }
      }
  }
  if found == 0 { Err<ResolvedType<HostTypeIdentity>, TypeQueryError>(TypeFieldNotFound) }
  else { Ok<ResolvedType<HostTypeIdentity>, TypeQueryError>(issue_at(scope, found, origin)) }
}

fn fields(scope: HostTypeScope, base: HostTypeIdentity) -> Result<List<ResolvedField<HostTypeIdentity>>, TypeQueryError> {
  let node = match type_node(scope, base) {
    Err(error) -> return Err<List<ResolvedField<HostTypeIdentity>>, TypeQueryError>(error)
    Ok(value) -> value
  }
  let (ty, origin) = match node { HostTypeNode(value, source) -> (value, source) }
  let tuple = ty_is_record(ty) and ty_record_tuple_kind(ty) != 0
  let structural = if ty_is_record(ty) { ty } else { 0 }
  let entry = if ty_tag(ty) == 9 { ttable_lookup_named_type(scope.table, ty) } else { 0 }
  if structural == 0 and (entry == 0 or ttable_entry_kind(entry) != 0) {
    return Err<List<ResolvedField<HostTypeIdentity>>, TypeQueryError>(TypeFieldsUnavailable)
  } else { nil }
  let mut result: List<ResolvedField<HostTypeIdentity>> = Nil<ResolvedField<HostTypeIdentity>>()
  if structural != 0 {
    let members = ty_record_fields(structural)
    for i in 0..nlist_len(members) {
      let member = nlist_get(members, i)
      let selector = if tuple { PositionalTypeField(i.to_usize_checked().unwrap()) }
        else { NamedTypeField(semantic_type_fact_copy(origin + ty_record_field_name_start(member), ty_record_field_name_len(member))) }
      result = Cons(ResolvedField {
        selector: selector,
        value: issue_at(scope, ty_record_field_type(member), origin)
      }, result)
    }
  } else {
    let entry_source = ttable_entry_source(entry)
    let members = mem_load64_at(entry + 32, 0)
    let count = mem_load64_at(entry + 24, 0)
    let substitution = type_cycle_subst_for_entry(entry, ty_f3(ty))
    for i in 0..count {
      let member = members + i * 24
      let member_type = type_cycle_maybe_subst(mem_load64_at(member + 16, 0), substitution)
      result = Cons(ResolvedField {
        selector: NamedTypeField(semantic_type_fact_copy(entry_source + mem_load64_at(member, 0), mem_load64_at(member + 8, 0))),
        value: issue_at(scope, member_type, entry_source)
      }, result)
    }
  }
  Ok<List<ResolvedField<HostTypeIdentity>>, TypeQueryError>(result.reverse())
}

fn subtype(scope: HostTypeScope, actual: HostTypeIdentity, expected: HostTypeIdentity) -> Result<bool, TypeQueryError> {
  let actual_ty = match type_node(scope, actual) { Err(error) -> return Err<bool, TypeQueryError>(error), Ok(HostTypeNode(value, origin)) -> value }
  let expected_ty = match type_node(scope, expected) { Err(error) -> return Err<bool, TypeQueryError>(error), Ok(HostTypeNode(value, origin)) -> value }
  Ok<bool, TypeQueryError>(typecheck_subtype(scope.table, actual_ty, expected_ty) == 1)
}

pub(package) fn run<R, E>(table: i64, source: i64, body: () -[TypeCheck<HostTypeIdentity>, E]> R) -[E]> R {
  let scope = HostTypeScope { identity: runtime_identity_new(), table: table, source: source }
  handle body() {
    TypeCheck<HostTypeIdentity>.resolve(request) -> resume(resolve(scope, request))
    TypeCheck<HostTypeIdentity>.field(base, selector) -> resume(field(scope, base, selector))
    TypeCheck<HostTypeIdentity>.fields(base) -> resume(fields(scope, base))
    TypeCheck<HostTypeIdentity>.subtype(actual, expected) -> resume(subtype(scope, actual, expected))
  }
}
