-- Typed classification of a rejected checked-program composition.
--
-- A rejection names the stage that refused the program, a stable category for
-- the refusing issue and the authored location when that issue retains one.
-- The differential checker oracle consumes this view now; the structured
-- diagnostic mapping for the switched checker will consume the same issues.

use compiler/project/identity.{
  AnonymousModuleIdentity,
  DeclaredFunctionIdentity,
  FunctionIdentity,
  IntrinsicFunctionIdentity,
  ModuleFunctionIdentity,
  ModuleIdentity,
  NamedModuleIdentity,
  declaration_identity_module,
  declaration_identity_name
}
use compiler/weft/check/body/graph.{CheckedSourceRange}
use compiler/weft/check/body/installer.{
  CheckedModuleInstallBodyInvalid,
  CheckedModuleInstallBodyRejected,
  CheckedModuleInstallCompositionRejected,
  CheckedModuleInstallContractRejected,
  CheckedModuleInstallDetailMissing,
  CheckedModuleInstallSelectionRejected,
  CheckedModuleInstallSpecializationRejected,
  CheckedModuleInstallTemplateRejected,
  CheckedModuleInstallerIssue,
  CheckedModuleOrdinaryRejected
}
use compiler/weft/check/body/producer.{*}
use compiler/weft/check/checked_program.{
  CheckedProgramAccepted,
  CheckedProgramDuplicateModule,
  CheckedProgramEntrypointRejected,
  CheckedProgramImportTargetMissing,
  CheckedProgramMainEffectful,
  CheckedProgramMainSignatureInvalid,
  CheckedProgramMainSignatureMissing,
  CheckedProgramModuleBodyRejected,
  CheckedProgramModuleResolutionRejected,
  CheckedProgramModuleSegmentMismatch,
  CheckedProgramResult,
  CheckedProgramRootMissing,
  CheckedProgramScopeRejected
}
use compiler/weft/check/registration/scope.{
  RegistrationScope,
  ScopeImportAmbiguous,
  ScopeImportInvisible,
  ScopeImportMissing,
  ScopeImportWidenedReexport,
  ScopeIssue,
  registration_scope_find
}
use compiler/weft/check/resolution.{
  SemanticDeclarationResolutionIssue,
  SemanticEffectDeclarationResolutionIssue,
  SemanticMethodDeclarationResolutionIssue,
  SemanticResolutionIssue,
  SemanticSignatureResolutionIssue
}
use compiler/weft/check/semantic_types.{*}
use compiler/ir/data.{TypeNameRange}
use stdlib/diagnostic.{DiagnosticLocation, DiagnosticLocationNone}
use stdlib/list.{Cons, List, Nil}
use stdlib/option.{None, Option, Some}

pub(package) type TypedCheckStage {
  TypedCheckRootStage,
  TypedCheckScopeStage,
  TypedCheckResolutionStage,
  TypedCheckBodyStage,
  TypedCheckHandlerStage,
  TypedCheckCompositionStage,
  TypedCheckEntrypointStage
}

pub(package) type TypedCheckRejection {
  stage: TypedCheckStage,
  module: str,
  function: str,
  category: str,
  location: DiagnosticLocation
}

pub(package) fn typed_check_stage_name(stage: TypedCheckStage) -> str {
  match stage {
    TypedCheckRootStage -> "root"
    TypedCheckScopeStage -> "scope"
    TypedCheckResolutionStage -> "resolution"
    TypedCheckBodyStage -> "body"
    TypedCheckHandlerStage -> "handler"
    TypedCheckCompositionStage -> "composition"
    TypedCheckEntrypointStage -> "entrypoint"
  }
}

fn typed_check_module_name(identity: ModuleIdentity) -> str {
  match identity {
    NamedModuleIdentity(path, _) -> path
    AnonymousModuleIdentity(_, _) -> "<anonymous>"
  }
}

fn typed_check_function_name(identity: FunctionIdentity) -> str {
  match identity {
    DeclaredFunctionIdentity(declaration) -> match declaration_identity_name(declaration).text() {
      Some(name) -> name
      None -> "<unnamed>"
    }
    ModuleFunctionIdentity(_, _) -> "<generated>"
    IntrinsicFunctionIdentity(_, _) -> "<intrinsic>"
  }
}

fn typed_check_rejection(
  stage: TypedCheckStage,
  module: str,
  category: str,
  location: DiagnosticLocation
) -> TypedCheckRejection {
  TypedCheckRejection {
    stage: stage,
    module: module,
    function: "-",
    category: category,
    location: location
  }
}

fn typed_check_module_location(
  scope: RegistrationScope,
  identity: ModuleIdentity,
  range: Option<CheckedSourceRange>
) -> DiagnosticLocation {
  match range {
    None -> DiagnosticLocationNone
    Some(selected) -> match registration_scope_find(scope, identity) {
      None -> DiagnosticLocationNone
      Some(module) -> match module.source.span(selected.start, selected.end) {
        None -> DiagnosticLocationNone
        Some(span) -> span.location()
      }
    }
  }
}

fn typed_check_scope_status_name(issue: ScopeIssue) -> str {
  match issue.status {
    ScopeImportMissing -> "import_missing"
    ScopeImportInvisible -> "import_invisible"
    ScopeImportWidenedReexport -> "import_widened_reexport"
    ScopeImportAmbiguous -> "import_ambiguous"
  }
}

fn typed_check_scope_rejection(issues: List<ScopeIssue>) -> TypedCheckRejection {
  match issues {
    Nil -> typed_check_rejection(
      TypedCheckScopeStage,
      "<unknown>",
      "scope_issue_missing",
      DiagnosticLocationNone
    )
    Cons(issue, _) -> typed_check_rejection(
      TypedCheckScopeStage,
      typed_check_module_name(issue.module),
      typed_check_scope_status_name(issue),
      match issue.location {
        None -> DiagnosticLocationNone
        Some(span) -> span.location()
      }
    )
  }
}

fn typed_check_type_issue_category(issue: SemanticTypeResolutionIssue) -> str {
  match issue {
    SemanticInvalidPrimitive(_) -> "invalid_primitive"
    SemanticInvalidVariable(_) -> "invalid_variable"
    SemanticInvalidArrayLength(_) -> "invalid_array_length"
    SemanticMissingAuthoredType -> "missing_authored_type"
    SemanticExpectedRecordField -> "expected_record_field"
    SemanticInvalidRecordFieldRange(_) -> "invalid_record_field_range"
    SemanticDuplicateRecordField(_) -> "duplicate_record_field"
    SemanticTypeArgumentCount(_, _) -> "type_argument_count"
    SemanticDefinitionExpansionRequired(_) -> "definition_expansion_required"
    SemanticRecursiveTypeDefinition(_) -> "recursive_type_definition"
    SemanticInternalOwnershipRequiresAuthority -> "internal_ownership_requires_authority"
    SemanticDeclarationResolutionRequired -> "declaration_resolution_required"
    SemanticUnsupportedAuthoredType(_) -> "unsupported_authored_type"
  }
}

fn typed_check_type_issue_range(issue: SemanticTypeResolutionIssue) -> Option<CheckedSourceRange>
{
  let range = match issue {
    SemanticInvalidRecordFieldRange(range) -> Some(range)
    SemanticDuplicateRecordField(range) -> Some(range)
    _ -> None<TypeNameRange>()
  }
  match range {
    Some(found) -> if found.start < 0 or found.length < 0 { None<CheckedSourceRange>() }
    else {
      Some(
        CheckedSourceRange {
          start: __i64_to_usize(found.start),
          end: __i64_to_usize(found.start + found.length)
        }
      )
    }
    None -> None<CheckedSourceRange>()
  }
}

fn typed_check_resolution_rejection(
  scope: RegistrationScope,
  identity: ModuleIdentity,
  issue: SemanticResolutionIssue
) -> TypedCheckRejection {
  let module = typed_check_module_name(identity)
  match issue {
    SemanticSignatureResolutionIssue(function, type_issue) -> TypedCheckRejection {
      stage: TypedCheckResolutionStage,
      module: module,
      function: typed_check_function_name(function),
      category: "signature/".concat(typed_check_type_issue_category(type_issue)),
      location: typed_check_module_location(
        scope,
        identity,
        typed_check_type_issue_range(type_issue)
      )
    }
    -- Declarations resolve across the whole scope, so the failing
    -- declaration names its own module rather than the checked one.
    SemanticDeclarationResolutionIssue(declaration, type_issue) -> {
      let owner = declaration_identity_module(declaration)
      let name = declaration_identity_name(declaration)
      TypedCheckRejection {
        stage: TypedCheckResolutionStage,
        module: typed_check_module_name(owner),
        function: match name.text() {
          Some(text) -> text
          None -> "<unnamed>"
        },
        category: "declaration/".concat(typed_check_type_issue_category(type_issue)),
        location: match typed_check_type_issue_range(type_issue) {
          Some(range) -> typed_check_module_location(scope, owner, Some(range))
          None -> name.location()
        }
      }
    }
    SemanticEffectDeclarationResolutionIssue(_) -> typed_check_rejection(
      TypedCheckResolutionStage,
      module,
      "effect_declaration",
      DiagnosticLocationNone
    )
    SemanticMethodDeclarationResolutionIssue(_) -> typed_check_rejection(
      TypedCheckResolutionStage,
      module,
      "method_declaration",
      DiagnosticLocationNone
    )
  }
}

pub(package) fn checked_body_producer_issue_range(
  issue: CheckedBodyProducerIssue
) -> Option<CheckedSourceRange> {
  match issue {
    CheckedBodyProducerUnknownIdentifier(range) -> Some(range)
    CheckedBodyProducerUnknownField(range) -> Some(range)
    CheckedBodyProducerImmutableAssignment(range) -> Some(range)
    CheckedBodyProducerMutablePointerBindingRequired(range) -> Some(range)
    CheckedBodyProducerInferredBranchMismatch(_, _, range) -> Some(range)
    CheckedBodyProducerGenericInferenceIncomplete(range) -> Some(range)
    CheckedBodyProducerLambdaContextRequired(range) -> Some(range)
    CheckedBodyProducerLambdaCaptureUnsupported(range) -> Some(range)
    CheckedBodyProducerGenericDeclarationRequired(range) -> Some(range)
    CheckedBodyProducerContinuationConsumerRequired(range) -> Some(range)
    CheckedBodyProducerContinuationResultRequired(range) -> Some(range)
    CheckedBodyProducerContinuationBranchEscape(range) -> Some(range)
    CheckedBodyProducerContinuationMutableBinding(range) -> Some(range)
    CheckedBodyProducerInvalidFloatLiteral(range) -> Some(range)
    CheckedBodyProducerSignatureUnavailable(range) -> Some(range)
    CheckedBodyProducerIndexedNamedBindingRequired(range) -> Some(range)
    CheckedBodyProducerEffectUnavailable(_, range) -> Some(range)
    CheckedBodyProducerUnknownEffectOperation(range) -> Some(range)
    CheckedBodyProducerUnknownMethod(range) -> Some(range)
    CheckedBodyProducerAmbiguousMethod(range) -> Some(range)
    CheckedBodyProducerDuplicateRecordPatternField(range) -> Some(range)
    CheckedBodyProducerDuplicateRecordField(range) -> Some(range)
    CheckedBodyProducerUnknownRecordType(range) -> Some(range)
    CheckedBodyProducerVariantPatternRequired(_, range, _) -> Some(range)
    CheckedBodyProducerUnknownConstructor(range) -> Some(range)
    CheckedBodyProducerOpaqueConstructorPrivate(range) -> Some(range)
    CheckedBodyProducerTypedArmOutsideScrutinee(range) -> Some(range)
    CheckedBodyProducerRuntimeDiscriminationUnavailable(_, range) -> Some(range)
    CheckedBodyProducerOpaqueProjectionPrivate(range) -> Some(range)
    CheckedBodyProducerConstructorResultRequired(range) -> Some(range)
    CheckedBodyProducerConstructorResultAmbiguous(range) -> Some(range)
    _ -> None<CheckedSourceRange>()
  }
}

pub(package) fn checked_body_producer_issue_category(issue: CheckedBodyProducerIssue) -> str {
  match issue {
    CheckedBodyProducerTypeRejected(_) -> "type_rejected"
    CheckedBodyProducerInvalidRange -> "invalid_range"
    CheckedBodyProducerUnknownIdentifier(_) -> "unknown_identifier"
    CheckedBodyProducerUnknownField(_) -> "unknown_field"
    CheckedBodyProducerImmutableAssignment(_) -> "immutable_assignment"
    CheckedBodyProducerPointerSealed -> "pointer_sealed"
    CheckedBodyProducerUnsafeEffectUnavailable -> "unsafe_effect_unavailable"
    CheckedBodyProducerPointerBindingRequired -> "pointer_binding_required"
    CheckedBodyProducerMutablePointerBindingRequired(_) -> "mutable_pointer_binding_required"
    CheckedBodyProducerPointerTypeRequired(_) -> "pointer_type_required"
    CheckedBodyProducerMutablePointerRequired(_) -> "mutable_pointer_required"
    CheckedBodyProducerInferredBranchMismatch(_, _, _) -> "inferred_branch_mismatch"
    CheckedBodyProducerBreakOutsideLoop -> "break_outside_loop"
    CheckedBodyProducerContinueOutsideLoop -> "continue_outside_loop"
    CheckedBodyProducerArityMismatch(_, _) -> "arity_mismatch"
    CheckedBodyProducerGenericBoundRejected(_, _) -> "generic_bound_rejected"
    CheckedBodyProducerGenericInferenceIncomplete(_) -> "generic_inference_incomplete"
    CheckedBodyProducerLambdaContextRequired(_) -> "lambda_context_required"
    CheckedBodyProducerLambdaCaptureUnsupported(_) -> "lambda_capture_unsupported"
    CheckedBodyProducerGenericDeclarationRequired(_) -> "generic_declaration_required"
    CheckedBodyProducerCallableRequired(_) -> "callable_required"
    CheckedBodyProducerContinuationConsumerRequired(_) -> "continuation_consumer_required"
    CheckedBodyProducerContinuationResultRequired(_) -> "continuation_result_required"
    CheckedBodyProducerContinuationBranchEscape(_) -> "continuation_branch_escape"
    CheckedBodyProducerContinuationMutableBinding(_) -> "continuation_mutable_binding"
    CheckedBodyProducerBinaryOperandMismatch(_, _) -> "binary_operand_mismatch"
    CheckedBodyProducerIntegerOperandRequired(_) -> "integer_operand_required"
    CheckedBodyProducerInvalidFloatLiteral(_) -> "invalid_float_literal"
    CheckedBodyProducerNumericOperandRequired(_) -> "numeric_operand_required"
    CheckedBodyProducerNonExhaustiveMatch -> "non_exhaustive_match"
    CheckedBodyProducerCanonicalEqUnavailable -> "canonical_eq_unavailable"
    CheckedBodyProducerCanonicalEqInvalid(_) -> "canonical_eq_invalid"
    CheckedBodyProducerEqImplementationRequired(_) -> "eq_implementation_required"
    CheckedBodyProducerCanonicalOrdUnavailable -> "canonical_ord_unavailable"
    CheckedBodyProducerCanonicalOrdInvalid(_) -> "canonical_ord_invalid"
    CheckedBodyProducerOrdImplementationRequired(_) -> "ord_implementation_required"
    CheckedBodyProducerOrderingCaseUnavailable(_) -> "ordering_case_unavailable"
    CheckedBodyProducerCanonicalDisplayUnavailable -> "canonical_display_unavailable"
    CheckedBodyProducerCanonicalDisplayInvalid(_) -> "canonical_display_invalid"
    CheckedBodyProducerDisplayImplementationRequired(_) -> "display_implementation_required"
    CheckedBodyProducerCanonicalResultUnavailable -> "canonical_result_unavailable"
    CheckedBodyProducerCanonicalFailUnavailable -> "canonical_fail_unavailable"
    CheckedBodyProducerResultOperandRequired(_) -> "result_operand_required"
    CheckedBodyProducerTryEffectUnavailable(_) -> "try_effect_unavailable"
    CheckedBodyProducerOptionalBaseRequired(_) -> "optional_base_required"
    CheckedBodyProducerMaybeEffectUnavailable -> "maybe_effect_unavailable"
    CheckedBodyProducerSignatureUnavailable(_) -> "signature_unavailable"
    CheckedBodyProducerFieldProjectionUnavailable(_) -> "field_projection_unavailable"
    CheckedBodyProducerIndexedBaseRequired(_) -> "indexed_base_required"
    CheckedBodyProducerIterableRequired(_) -> "iterable_required"
    CheckedBodyProducerIteratorResultRequired(_) -> "iterator_result_required"
    CheckedBodyProducerIteratorItemInvalid(_) -> "iterator_item_invalid"
    CheckedBodyProducerIteratorItemUnresolved(_) -> "iterator_item_unresolved"
    CheckedBodyProducerIteratorNextRequired(_) -> "iterator_next_required"
    CheckedBodyProducerIteratorOptionRequired(_) -> "iterator_option_required"
    CheckedBodyProducerIteratorOptionCaseRequired(_) -> "iterator_option_case_required"
    CheckedBodyProducerIteratorOptionItemMismatch(_) -> "iterator_option_item_mismatch"
    CheckedBodyProducerIteratorOptionPayloadMismatch(_) -> "iterator_option_payload_mismatch"
    CheckedBodyProducerIndexedNamedBindingRequired(_) -> "indexed_named_binding_required"
    CheckedBodyProducerEffectReferenceRequired -> "effect_reference_required"
    CheckedBodyProducerEffectUnavailable(_, _) -> "effect_unavailable"
    CheckedBodyProducerEffectTailUnavailable(_) -> "effect_tail_unavailable"
    CheckedBodyProducerEffectApplicationUnavailable -> "effect_application_unavailable"
    CheckedBodyProducerUnknownEffectOperation(_) -> "unknown_effect_operation"
    CheckedBodyProducerAmbiguousEffectApplication(_) -> "ambiguous_effect_application"
    CheckedBodyProducerUnknownMethod(_) -> "unknown_method"
    CheckedBodyProducerAmbiguousMethod(_) -> "ambiguous_method"
    CheckedBodyProducerHandlerClauseRequired -> "handler_clause_required"
    CheckedBodyProducerHandlerCallRejected(_) -> "handler_call_rejected"
    CheckedBodyProducerHandlerConstructorRejected(_) -> "handler_constructor_rejected"
    CheckedBodyProducerDuplicateHandlerClause(_) -> "duplicate_handler_clause"
    CheckedBodyProducerMissingHandlerClause(_) -> "missing_handler_clause"
    CheckedBodyProducerHandlerEffectMismatch(_, _) -> "handler_effect_mismatch"
    CheckedBodyProducerHandlerContinuationRequiresDeferred ->
      "handler_continuation_requires_deferred"
    CheckedBodyProducerResumeOutsideHandler -> "resume_outside_handler"
    CheckedBodyProducerBodyLocalTypeUnavailable(_) -> "body_local_type_unavailable"
    CheckedBodyProducerUnsupportedBinaryOperator(_) -> "unsupported_binary_operator"
    CheckedBodyProducerUnsupportedMatchArm -> "unsupported_match_arm"
    CheckedBodyProducerUnsupportedPattern -> "unsupported_pattern"
    CheckedBodyProducerTuplePatternRequired(_) -> "tuple_pattern_required"
    CheckedBodyProducerTuplePatternArityMismatch(_, _) -> "tuple_pattern_arity_mismatch"
    CheckedBodyProducerRecordPatternRequired(_) -> "record_pattern_required"
    CheckedBodyProducerDuplicateRecordPatternField(_) -> "duplicate_record_pattern_field"
    CheckedBodyProducerDuplicateRecordField(_) -> "duplicate_record_field"
    CheckedBodyProducerUnknownRecordType(_) -> "unknown_record_type"
    CheckedBodyProducerNotRecordType(_) -> "not_record_type"
    CheckedBodyProducerRecordTemplateUnavailable(_) -> "record_template_unavailable"
    CheckedBodyProducerRecordTemplateAmbiguous(_) -> "record_template_ambiguous"
    CheckedBodyProducerRecordArgumentsUnresolved(_) -> "record_arguments_unresolved"
    CheckedBodyProducerMissingRecordField(_) -> "missing_record_field"
    CheckedBodyProducerRecordUpdateRequired(_) -> "record_update_required"
    CheckedBodyProducerVariantPatternRequired(_, _, _) -> "variant_pattern_required"
    CheckedBodyProducerUnknownConstructor(_) -> "unknown_constructor"
    CheckedBodyProducerOpaqueConstructorPrivate(_) -> "opaque_constructor_private"
    CheckedBodyProducerTypedArmOutsideScrutinee(_) -> "typed_arm_outside_scrutinee"
    CheckedBodyProducerRuntimeDiscriminationUnavailable(_, _) -> "runtime_discrimination"
    CheckedBodyProducerOpaqueProjectionPrivate(_) -> "opaque_projection_private"
    CheckedBodyProducerConstructorResultRequired(_) -> "constructor_result_required"
    CheckedBodyProducerConstructorResultAmbiguous(_) -> "constructor_result_ambiguous"
    CheckedBodyProducerConstructorArityMismatch(_, _) -> "constructor_arity_mismatch"
    CheckedBodyProducerConstructorPatternArityMismatch(_, _) ->
      "constructor_pattern_arity_mismatch"
    CheckedBodyProducerUnsupportedParameter -> "unsupported_parameter"
    CheckedBodyProducerTypeMismatch(_, _) -> "type_mismatch"
    CheckedBodyProducerUnsupportedExpression -> "unsupported_expression"
    CheckedBodyProducerFreezeRejected(_) -> "freeze_rejected"
  }
}

fn typed_check_installer_rejection(
  scope: RegistrationScope,
  identity: ModuleIdentity,
  issue: CheckedModuleInstallerIssue
) -> TypedCheckRejection {
  let module = typed_check_module_name(identity)
  match issue {
    CheckedModuleOrdinaryRejected(function, body) -> TypedCheckRejection {
      stage: TypedCheckBodyStage,
      module: module,
      function: typed_check_function_name(function),
      category: checked_body_producer_issue_category(body),
      location: typed_check_module_location(
        scope,
        identity,
        checked_body_producer_issue_range(body)
      )
    }
    -- Contextual clause ranges belong to the implementation module, which the
    -- installer issue does not name; report them without guessing a location.
    CheckedModuleInstallBodyRejected(_, body) -> typed_check_rejection(
      TypedCheckHandlerStage,
      module,
      checked_body_producer_issue_category(body),
      DiagnosticLocationNone
    )
    CheckedModuleInstallDetailMissing(_) -> typed_check_rejection(
      TypedCheckHandlerStage,
      module,
      "install_detail_missing",
      DiagnosticLocationNone
    )
    CheckedModuleInstallSelectionRejected(_) -> typed_check_rejection(
      TypedCheckHandlerStage,
      module,
      "install_selection_rejected",
      DiagnosticLocationNone
    )
    CheckedModuleInstallTemplateRejected(_, _) -> typed_check_rejection(
      TypedCheckHandlerStage,
      module,
      "install_template_rejected",
      DiagnosticLocationNone
    )
    CheckedModuleInstallContractRejected(_, _) -> typed_check_rejection(
      TypedCheckHandlerStage,
      module,
      "install_contract_rejected",
      DiagnosticLocationNone
    )
    CheckedModuleInstallSpecializationRejected(_, _) -> typed_check_rejection(
      TypedCheckHandlerStage,
      module,
      "install_specialization_rejected",
      DiagnosticLocationNone
    )
    CheckedModuleInstallBodyInvalid(_, _) -> typed_check_rejection(
      TypedCheckHandlerStage,
      module,
      "install_body_invalid",
      DiagnosticLocationNone
    )
    CheckedModuleInstallCompositionRejected(_) -> typed_check_rejection(
      TypedCheckCompositionStage,
      module,
      "install_composition_rejected",
      DiagnosticLocationNone
    )
  }
}

-- Classify a composition result. Accepted programs have no rejection.
pub(package) fn typed_check_program_rejection(
  result: CheckedProgramResult,
  scope: RegistrationScope
) -> Option<TypedCheckRejection> {
  match result {
    CheckedProgramAccepted(_) -> None<TypedCheckRejection>()
    CheckedProgramRootMissing -> Some(
      typed_check_rejection(
        TypedCheckRootStage,
        "<root>",
        "root_missing",
        DiagnosticLocationNone
      )
    )
    CheckedProgramImportTargetMissing(edge) -> Some(
      typed_check_rejection(
        TypedCheckScopeStage,
        typed_check_module_name(edge.importer),
        "import_target_missing",
        match edge.location {
          None -> DiagnosticLocationNone
          Some(span) -> span.location()
        }
      )
    )
    CheckedProgramScopeRejected(issues) -> Some(typed_check_scope_rejection(issues))
    CheckedProgramDuplicateModule(identity) -> Some(
      typed_check_rejection(
        TypedCheckScopeStage,
        typed_check_module_name(identity),
        "duplicate_module",
        DiagnosticLocationNone
      )
    )
    CheckedProgramModuleResolutionRejected(identity, issue) -> Some(
      typed_check_resolution_rejection(scope, identity, issue)
    )
    CheckedProgramModuleBodyRejected(identity, issue) -> Some(
      typed_check_installer_rejection(scope, identity, issue)
    )
    CheckedProgramModuleSegmentMismatch(identity) -> Some(
      typed_check_rejection(
        TypedCheckCompositionStage,
        typed_check_module_name(identity),
        "segment_mismatch",
        DiagnosticLocationNone
      )
    )
    CheckedProgramEntrypointRejected(root, issue) -> Some(
      typed_check_rejection(
        TypedCheckEntrypointStage,
        typed_check_module_name(root.registered().identity),
        match issue {
          CheckedProgramMainSignatureMissing(_) -> "main_signature_missing"
          CheckedProgramMainSignatureInvalid(_) -> "main_signature_invalid"
          CheckedProgramMainEffectful(_, _) -> "main_effectful"
        },
        DiagnosticLocationNone
      )
    )
  }
}
