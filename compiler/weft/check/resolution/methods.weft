-- Immutable trait and implementation method declarations.
--
-- Trait signatures retain rigid Self. Implementation targets, conditional
-- bounds and method signatures share the enclosing semantic type catalog, so
-- selection returns exact identities plus a graph-native substitution rather
-- than a spelling hash or checker-table entry.

use compiler/ir/data.{
  AssociatedBindingTypeExpr,
  ConstraintTypeExpr,
  EffectSetTypeExpr,
  EffectSig,
  FunctionTypeExpr,
  InherentTypeImpl,
  MissingEffectSig,
  MissingTypeExpr,
  MissingTypeParam,
  NamedTypeImpl,
  Param,
  ParamList,
  ParamListCons,
  ParamListNil,
  QualifiedTraitTypeExpr,
  QualifiedTypeImpl,
  ResolvedTraitTypeExpr,
  ResolvedTypeImpl,
  TypeExpr,
  TypeExprList,
  TypeExprListCons,
  TypeExprListNil,
  TypeImplProtocol,
  TypeImplTarget,
  TypeNameRange,
  TypeParam,
  TypeParamBoundList,
  TypeParamBoundListCons,
  TypeParamBoundListNil,
  TypeParamList,
  TypeParamListCons,
  TypeParamListNil,
  TypeTraitMember,
  TypeTraitMethod,
  UnqualifiedTraitTypeExpr,
  UnqualifiedTypeImpl,
  UnknownParam
}
use compiler/project/identity.{
  DeclarationIdentity,
  DeclaredFunctionIdentity,
  FunctionIdentity,
  ImplementationTargetDeclaration,
  InherentMethodDeclaration,
  MemberDeclarationIdentity,
  ModuleDeclarationIdentity,
  declaration_identity_name
}
use compiler/project/identity/equality.{declaration_identity_eq, function_identity_eq}
use compiler/types/graph.{
  SemanticParameterVariable,
  SemanticNamedNode,
  SemanticOwnedNode,
  SemanticSelfVariable,
  SemanticTraitNode,
  SemanticTypeId,
  SemanticTypeVariable,
  SemanticUniqueNode,
  SemanticVariableNode,
  SemanticVariantNode,
  semantic_type_graph_node,
  semantic_type_graph_trait_binding_declaration,
  semantic_type_graph_trait_binding_type_id,
  semantic_type_graph_traits_local,
  semantic_type_trait_binding_count,
  semantic_type_trait_binding_edge
}
use compiler/types/graph/catalog.{SemanticTypeCatalog}
use compiler/types/graph/conformance/catalog.{
  SemanticConformanceCatalog,
  SemanticConformanceRequirement,
  semantic_conformance_catalog_add_evidence,
  semantic_conformance_catalog_conforms_substituted,
  semantic_conformance_catalog_empty,
  semantic_conformance_evidence,
  semantic_conformance_requirement,
  semantic_conformance_trait_atom_satisfies
}
use compiler/types/graph/pattern.{
  SemanticTypePatternMatched,
  SemanticTypePatternRejected,
  semantic_type_pattern_match
}
use compiler/types/graph/substitution.{
  SemanticTypeSubstitution,
  semantic_type_substitution_bind,
  semantic_type_substitution_bind_associated,
  semantic_type_substitution_empty,
  semantic_type_substitution_get
}
use compiler/weft/check/registration/catalog.{
  RegisteredAssociatedType,
  RegisteredDeclarationKind,
  RegisteredImpl,
  RegisteredImplDeclaration,
  RegisteredImplMember,
  RegisteredImplMethod,
  RegisteredImplTypeBinding,
  RegisteredInvalidTraitMember,
  RegisteredModule,
  RegisteredTraitDeclaration,
  RegisteredTraitMember,
  RegisteredTraitMethod
}
use compiler/weft/check/registration/scope.{
  RegistrationScope,
  registration_scope_at,
  registration_scope_len
}
use compiler/weft/check/semantic_types.{
  SemanticDeclarationResolutionRequired,
  SemanticInvalidVariable,
  SemanticTypeProductBuilder,
  SemanticTypeRejected,
  SemanticTypeResolutionIssue,
  SemanticTypeResolved,
  resolve_function_signature_product_with_self_in_scope,
  resolve_type_product_in_scope,
  resolve_type_product_with_self_in_scope,
  semantic_type_product_catalog
}
use compiler/weft/check/storage.{dense_index}
use compiler/project/identity/hash.{retained_declaration_identity_hash}
use compiler/types/graph/pattern.{semantic_type_pattern_head}
use stdlib/list.{Cons, List, Nil}
use stdlib/map as map
use stdlib/map.{Map}
use stdlib/option.{None, Option, Some}
use stdlib/panic.{panic}
use stdlib/persistent_vector as persistent_vector
use stdlib/persistent_vector.{PersistentVector}
use stdlib/source.{Span}
use stdlib/string.{str_eq}

-- Trait contracts in declaration order: one declaration, method start and
-- method count per trait beside the flat method columns, and each trait's
-- position by its declaration's retained hash, newest first.
type SemanticTraitColumns {
  declarations: PersistentVector<DeclarationIdentity>,
  index: Map<i64, List<usize>>,
  method_starts: PersistentVector<usize>,
  method_counts: PersistentVector<usize>,
  method_declarations: PersistentVector<DeclarationIdentity>,
  method_signatures: PersistentVector<SemanticTypeId>
}

-- Implementations in declaration order: one target, trait, requirement
-- start and count, and method start and count each, beside the flat
-- requirement and method columns; each implementation's position by its
-- target's pattern head; and each method function's implementation, keyed
-- by its declaration's retained hash.
type SemanticImplementationColumns {
  targets: PersistentVector<SemanticTypeId>,
  heads: SemanticImplementationHeads,
  trait_present: PersistentVector<bool>,
  trait_atoms: PersistentVector<SemanticTypeId>,
  requirement_starts: PersistentVector<usize>,
  requirement_counts: PersistentVector<usize>,
  requirement_variables: PersistentVector<SemanticTypeVariable>,
  requirement_traits: PersistentVector<SemanticTypeId>,
  method_starts: PersistentVector<usize>,
  method_counts: PersistentVector<usize>,
  method_declarations: PersistentVector<DeclarationIdentity>,
  method_functions: PersistentVector<FunctionIdentity>,
  method_signatures: PersistentVector<SemanticTypeId>,
  method_owners: Map<i64, List<SemanticMethodImplementationEntry>>
}

-- Every column is a flat persistent vector, so a member is an indexed
-- lookup; traits are found by declaration and implementations by their
-- target's head, so selection visits only the entries that could apply.
type SemanticMethodCatalogStorage {
  traits: SemanticTraitColumns,
  implementations: SemanticImplementationColumns
}

-- Implementation positions by their target's pattern head, newest first,
-- beside the implementations whose target is a bare type variable. A head
-- narrows a selection and never decides it: the target pattern does.
type SemanticImplementationHeads {
  keyed: Map<i64, List<usize>>,
  unkeyed: List<usize>
}

type SemanticMethodImplementationEntry {
  function: FunctionIdentity,
  implementation: usize
}

pub(package) type SemanticMethodCatalog = opaque SemanticMethodCatalogStorage

pub(package) type SemanticMethodResolutionIssue {
  SemanticTraitMethodTypeRejected(DeclarationIdentity, SemanticTypeResolutionIssue),
  SemanticImplementationTargetRejected(TypeNameRange, SemanticTypeResolutionIssue),
  SemanticImplementationTraitRejected(TypeNameRange, SemanticTypeResolutionIssue),
  SemanticImplementationBoundRejected(TypeNameRange, SemanticTypeResolutionIssue),
  SemanticImplementationMethodMissing(FunctionIdentity, Option<Span>),
  SemanticImplementationMethodTypeRejected(FunctionIdentity, SemanticTypeResolutionIssue),
  SemanticImplementationTraitContractMissing(TypeNameRange),
  SemanticImplementationRequiredMethodMissing(DeclarationIdentity)
}

pub(package) type SemanticMethodsResolution {
  SemanticMethodsResolved(
    SemanticTypeProductBuilder,
    SemanticMethodCatalog,
    SemanticConformanceCatalog
  ),
  SemanticMethodsRejected(SemanticMethodResolutionIssue)
}

pub(package) type SemanticTraitMethodSelection {
  SemanticTraitMethodSelected(DeclarationIdentity, SemanticTypeId),
  SemanticTraitMethodSelectionMissing,
  SemanticTraitMethodSelectionAmbiguous
}

pub(package) type SemanticImplementationMethodSelection {
  SemanticImplementationMethodSelected(
    DeclarationIdentity,
    FunctionIdentity,
    SemanticTypeId,
    SemanticTypeSubstitution
  ),
  SemanticImplementationMethodSelectionMissing,
  SemanticImplementationMethodSelectionAmbiguous
}

type SemanticTraitMethodsBuild {
  SemanticTraitMethodsBuilt(
    SemanticTypeProductBuilder,
    List<DeclarationIdentity>,
    List<SemanticTypeId>
  ),
  SemanticTraitMethodsRejected(DeclarationIdentity, SemanticTypeResolutionIssue)
}

type SemanticRequirementsBuild {
  SemanticRequirementsBuilt(
    SemanticTypeProductBuilder,
    List<SemanticConformanceRequirement>
  ),
  SemanticRequirementsRejected(SemanticTypeProductBuilder, SemanticTypeResolutionIssue)
}

type SemanticImplementationMethodsBuild {
  SemanticImplementationMethodsBuilt(
    SemanticTypeProductBuilder,
    List<DeclarationIdentity>,
    List<FunctionIdentity>,
    List<SemanticTypeId>
  ),
  SemanticImplementationMethodsRejected(
    SemanticTypeProductBuilder,
    SemanticMethodResolutionIssue
  )
}

pub(package) fn semantic_method_catalog_empty() -> SemanticMethodCatalog {
  SemanticMethodCatalog(
    SemanticMethodCatalogStorage {
      traits: SemanticTraitColumns {
        declarations: persistent_vector.new<DeclarationIdentity>(),
        index: map.new<i64, List<usize>>(),
        method_starts: persistent_vector.new<usize>(),
        method_counts: persistent_vector.new<usize>(),
        method_declarations: persistent_vector.new<DeclarationIdentity>(),
        method_signatures: persistent_vector.new<SemanticTypeId>()
      },
      implementations: SemanticImplementationColumns {
        targets: persistent_vector.new<SemanticTypeId>(),
        heads: SemanticImplementationHeads {
          keyed: map.new<i64, List<usize>>(),
          unkeyed: Nil<usize>()
        },
        trait_present: persistent_vector.new<bool>(),
        trait_atoms: persistent_vector.new<SemanticTypeId>(),
        requirement_starts: persistent_vector.new<usize>(),
        requirement_counts: persistent_vector.new<usize>(),
        requirement_variables: persistent_vector.new<SemanticTypeVariable>(),
        requirement_traits: persistent_vector.new<SemanticTypeId>(),
        method_starts: persistent_vector.new<usize>(),
        method_counts: persistent_vector.new<usize>(),
        method_declarations: persistent_vector.new<DeclarationIdentity>(),
        method_functions: persistent_vector.new<FunctionIdentity>(),
        method_signatures: persistent_vector.new<SemanticTypeId>(),
        method_owners: map.new<i64, List<SemanticMethodImplementationEntry>>()
      }
    }
  )
}

fn semantic_method_push_all<T>(values: PersistentVector<T>, items: List<T>) -> PersistentVector<T>
{
  match items {
    Nil -> values
    Cons(item, rest) -> semantic_method_push_all<T>(values.push(item), rest)
  }
}

-- `position` at the front of its key's bucket.
fn semantic_method_index_add(
  index: Map<i64, List<usize>>,
  key: i64,
  position: usize
) -> Map<i64, List<usize>> {
  let bucket = match index.get(key) {
    Some(positions) -> positions
    None -> Nil<usize>()
  }
  index.insert(key, bucket.prepend(position))
}

fn semantic_method_catalog_add_trait(
  catalog: SemanticMethodCatalog,
  declaration: DeclarationIdentity,
  methods: List<DeclarationIdentity>,
  signatures: List<SemanticTypeId>
) -> SemanticMethodCatalog {
  match catalog {
    SemanticMethodCatalog(storage) -> {
      let { traits, implementations } = storage
      SemanticMethodCatalog(
        SemanticMethodCatalogStorage {
          traits: SemanticTraitColumns {
            declarations: traits.declarations.push(declaration),
            index: semantic_method_index_add(
              traits.index,
              retained_declaration_identity_hash(declaration),
              traits.declarations.len()
            ),
            method_starts: traits.method_starts.push(traits.method_declarations.len()),
            method_counts: traits.method_counts.push(methods.len()),
            method_declarations: semantic_method_push_all<DeclarationIdentity>(
              traits.method_declarations,
              methods
            ),
            method_signatures: semantic_method_push_all<SemanticTypeId>(
              traits.method_signatures,
              signatures
            )
          },
          implementations: implementations
        }
      )
    }
  }
}

fn semantic_implementation_heads_add(
  heads: SemanticImplementationHeads,
  head: Option<i64>,
  position: usize
) -> SemanticImplementationHeads {
  let { keyed, unkeyed } = heads
  match head {
    None -> SemanticImplementationHeads { keyed: keyed, unkeyed: unkeyed.prepend(position) }
    Some(key) -> SemanticImplementationHeads {
      keyed: semantic_method_index_add(keyed, key, position),
      unkeyed: unkeyed
    }
  }
}

-- The implementations whose target could match a receiver with `head`:
-- those sharing its head and every variable-rooted one. A receiver without
-- a head is a bare variable, which only a variable-rooted target matches.
fn semantic_implementation_candidates(
  heads: borrow SemanticImplementationHeads,
  head: Option<i64>
) -> List<usize> {
  match head {
    None -> heads.unkeyed
    Some(key) -> match heads.keyed.get(key) {
      Some(positions) -> positions.concat(heads.unkeyed)
      None -> heads.unkeyed
    }
  }
}

fn semantic_method_catalog_add_implementation(
  catalog: SemanticMethodCatalog,
  types: borrow SemanticTypeCatalog,
  target: SemanticTypeId,
  trait_atom: Option<SemanticTypeId>,
  requirements: List<SemanticConformanceRequirement>,
  declarations: List<DeclarationIdentity>,
  functions: List<FunctionIdentity>,
  signatures: List<SemanticTypeId>
) -> SemanticMethodCatalog {
  let trait_present = match trait_atom { Some(_) -> true, None -> false }
  let stored_trait = match trait_atom { Some(value) -> value, None -> target }
  let variables = requirements.map<SemanticTypeVariable>(
    (requirement: SemanticConformanceRequirement) => requirement.variable
  )
  let traits = requirements.map<SemanticTypeId>(
    (requirement: SemanticConformanceRequirement) => requirement.trait_atom
  )
  match catalog {
    SemanticMethodCatalog(storage) -> {
      let { traits: contracts, implementations } = storage
      let position = implementations.targets.len()
      SemanticMethodCatalog(
        SemanticMethodCatalogStorage {
          traits: contracts,
          implementations: SemanticImplementationColumns {
            targets: implementations.targets.push(target),
            heads: semantic_implementation_heads_add(
              implementations.heads,
              semantic_type_pattern_head(types, target),
              position
            ),
            trait_present: implementations.trait_present.push(trait_present),
            trait_atoms: implementations.trait_atoms.push(stored_trait),
            requirement_starts: implementations.requirement_starts.push(
              implementations.requirement_variables.len()
            ),
            requirement_counts: implementations.requirement_counts.push(requirements.len()),
            requirement_variables: semantic_method_push_all<SemanticTypeVariable>(
              implementations.requirement_variables,
              variables
            ),
            requirement_traits: semantic_method_push_all<SemanticTypeId>(
              implementations.requirement_traits,
              traits
            ),
            method_starts: implementations.method_starts.push(
              implementations.method_declarations.len()
            ),
            method_counts: implementations.method_counts.push(declarations.len()),
            method_declarations: semantic_method_push_all<DeclarationIdentity>(
              implementations.method_declarations,
              declarations
            ),
            method_functions: semantic_method_push_all<FunctionIdentity>(
              implementations.method_functions,
              functions
            ),
            method_signatures: semantic_method_push_all<SemanticTypeId>(
              implementations.method_signatures,
              signatures
            ),
            method_owners: semantic_method_index_functions(
              implementations.method_owners,
              functions,
              position
            )
          }
        }
      )
    }
  }
}

-- A method function's index key: its declaration's retained hash. Only
-- declared functions are methods.
fn semantic_method_function_key(function: FunctionIdentity) -> Option<i64> {
  match function {
    DeclaredFunctionIdentity(declaration) -> Some(retained_declaration_identity_hash(declaration))
    _ -> None<i64>()
  }
}

fn semantic_method_index_functions(
  index: Map<i64, List<SemanticMethodImplementationEntry>>,
  functions: List<FunctionIdentity>,
  implementation: usize
) -> Map<i64, List<SemanticMethodImplementationEntry>> {
  match functions {
    Nil -> index
    Cons(function, rest) -> semantic_method_index_functions(
      match semantic_method_function_key(function) {
        None -> index
        Some(key) -> {
          let bucket = match index.get(key) {
            Some(entries) -> entries
            None -> Nil<SemanticMethodImplementationEntry>()
          }
          index.insert(
            key,
            bucket.prepend(
              SemanticMethodImplementationEntry {
                function: function,
                implementation: implementation
              }
            )
          )
        }
      },
      rest,
      implementation
    )
  }
}

fn semantic_method_indexed_entry(
  entries: List<SemanticMethodImplementationEntry>,
  wanted: FunctionIdentity
) -> Option<usize> {
  match entries {
    Nil -> None<usize>()
    Cons(entry, rest) -> if function_identity_eq(entry.function, wanted) {
      Some(entry.implementation)
    } else { semantic_method_indexed_entry(rest, wanted) }
  }
}

-- The implementation a method function belongs to.
fn semantic_method_function_implementation(
  storage: SemanticMethodCatalogStorage,
  wanted: FunctionIdentity
) -> Option<usize> {
  match semantic_method_function_key(wanted) {
    None -> semantic_method_function_implementation_from(storage, wanted, 0)
    Some(key) -> match storage.implementations.method_owners.get(key) {
      None -> None<usize>()
      Some(entries) -> semantic_method_indexed_entry(entries, wanted)
    }
  }
}

fn semantic_method_parameter_types(parameters: ParamList) -> TypeExprList {
  match parameters {
    ParamListNil -> TypeExprListNil
    ParamListCons(parameter, remaining) -> match parameter {
      Param(_, _, annotation, _) -> TypeExprListCons(
        annotation,
        semantic_method_parameter_types(remaining),
        nil
      )
      UnknownParam(_) -> TypeExprListCons(
        MissingTypeExpr,
        semantic_method_parameter_types(remaining),
        nil
      )
    }
  }
}

fn semantic_method_effect_type(effects: EffectSig) -> TypeExpr {
  match effects {
    EffectSig(atoms, tail) -> EffectSetTypeExpr(atoms, tail)
    MissingEffectSig -> MissingTypeExpr
  }
}

fn semantic_trait_methods(
  product: SemanticTypeProductBuilder,
  module: RegisteredModule,
  scope: RegistrationScope,
  self_trait: TypeExpr,
  members: List<RegisteredTraitMember>,
  declarations: List<DeclarationIdentity>,
  signatures: List<SemanticTypeId>
) -> SemanticTraitMethodsBuild {
  match members {
    Nil -> SemanticTraitMethodsBuilt(
      product,
      declarations.reverse(),
      signatures.reverse()
    )
    Cons(member, remaining) -> match member {
      RegisteredTraitMethod(name, syntax) -> match syntax {
        TypeTraitMethod(_, _, parameters, result, effects) -> {
          match resolve_type_product_with_self_in_scope(
            product,
            module,
            scope,
            TypeParamListNil,
            self_trait,
            FunctionTypeExpr(
              semantic_method_parameter_types(parameters),
              result,
              semantic_method_effect_type(effects)
            )
          ) {
            (product, SemanticTypeResolved(signature)) -> semantic_trait_methods(
              product,
              module,
              scope,
              self_trait,
              remaining,
              declarations.prepend(name.identity),
              signatures.prepend(signature)
            )
            (_, SemanticTypeRejected(issue)) -> SemanticTraitMethodsRejected(
              name.identity,
              issue
            )
          }
        }
        _ -> SemanticTraitMethodsRejected(
          name.identity,
          SemanticDeclarationResolutionRequired
        )
      }
      RegisteredAssociatedType(_, _) -> semantic_trait_methods(
        product,
        module,
        scope,
        self_trait,
        remaining,
        declarations,
        signatures
      )
      RegisteredInvalidTraitMember(_) -> semantic_trait_methods(
        product,
        module,
        scope,
        self_trait,
        remaining,
        declarations,
        signatures
      )
    }
  }
}

fn semantic_method_trait_expr(protocol: TypeImplProtocol) -> Option<TypeExpr> {
  match protocol {
    UnqualifiedTypeImpl(hash, range) -> Some<TypeExpr>(
      UnqualifiedTraitTypeExpr(hash, range)
    )
    QualifiedTypeImpl(_, qualifier, member) -> Some<TypeExpr>(
      QualifiedTraitTypeExpr(qualifier, member)
    )
    ResolvedTypeImpl(_, declaration) -> Some<TypeExpr>(
      ResolvedTraitTypeExpr(declaration)
    )
    InherentTypeImpl -> None<TypeExpr>()
    NamedTypeImpl(_) -> None<TypeExpr>()
  }
}

fn semantic_method_binding_exprs(
  members: List<RegisteredImplMember>
) -> TypeExprList {
  match members {
    Nil -> TypeExprListNil
    Cons(member, remaining) -> match member {
      RegisteredImplTypeBinding(name, annotation, _) -> TypeExprListCons(
        AssociatedBindingTypeExpr(0, annotation, name),
        semantic_method_binding_exprs(remaining),
        nil
      )
      _ -> semantic_method_binding_exprs(remaining)
    }
  }
}

fn semantic_method_trait_type(
  protocol: TypeImplProtocol,
  members: List<RegisteredImplMember>
) -> Option<TypeExpr> {
  match semantic_method_trait_expr(protocol) {
    Some(trait_expr) -> Some<TypeExpr>(
      ConstraintTypeExpr(trait_expr, semantic_method_binding_exprs(members))
    )
    None -> None<TypeExpr>()
  }
}

fn semantic_method_requirements_for_bounds(
  product: SemanticTypeProductBuilder,
  module: RegisteredModule,
  scope: RegistrationScope,
  parameters: TypeParamList,
  variable: SemanticTypeVariable,
  bounds: TypeParamBoundList,
  requirements: List<SemanticConformanceRequirement>
) -> SemanticRequirementsBuild {
  match bounds {
    TypeParamBoundListNil -> SemanticRequirementsBuilt(product, requirements)
    TypeParamBoundListCons(bound, _, remaining) -> match resolve_type_product_in_scope(
      product,
      module,
      scope,
      parameters,
      bound
    ) {
      (product, SemanticTypeResolved(trait_atom)) -> semantic_method_requirements_for_bounds(
        product,
        module,
        scope,
        parameters,
        variable,
        remaining,
        requirements.prepend(
          semantic_conformance_requirement(variable, trait_atom)
        )
      )
      (product, SemanticTypeRejected(issue)) -> SemanticRequirementsRejected(
        product,
        issue
      )
    }
  }
}

fn semantic_method_requirements(
  product: SemanticTypeProductBuilder,
  module: RegisteredModule,
  scope: RegistrationScope,
  parameters: TypeParamList,
  remaining: TypeParamList,
  requirements: List<SemanticConformanceRequirement>
) -> SemanticRequirementsBuild {
  match remaining {
    TypeParamListNil -> SemanticRequirementsBuilt(product, requirements.reverse())
    TypeParamListCons(parameter, rest) -> match parameter {
      TypeParam(_, _, identity, bounds) -> if identity < 0 {
        SemanticRequirementsRejected(product, SemanticInvalidVariable(identity))
      } else {
        match semantic_method_requirements_for_bounds(
          product,
          module,
          scope,
          parameters,
          SemanticParameterVariable(__i64_to_usize(identity)),
          bounds,
          requirements
        ) {
          SemanticRequirementsBuilt(product, next) -> semantic_method_requirements(
            product,
            module,
            scope,
            parameters,
            rest,
            next
          )
          SemanticRequirementsRejected(product, issue) ->
            SemanticRequirementsRejected(product, issue)
        }
      }
      MissingTypeParam -> SemanticRequirementsRejected(
        product,
        SemanticDeclarationResolutionRequired
      )
    }
  }
}

fn semantic_method_same_name(declaration: DeclarationIdentity, source: str) -> bool {
  match declaration_identity_name(declaration).text() {
    Some(spelling) -> str_eq(spelling, source) == 1
    None -> false
  }
}

fn semantic_method_trait_member_from_catalog(
  catalog: borrow SemanticMethodCatalog,
  types: borrow SemanticTypeCatalog,
  trait_atom: SemanticTypeId,
  source: Span
) -> Option<DeclarationIdentity> {
  match types.graph_for(trait_atom) {
    None -> None<DeclarationIdentity>()
    Some(graph) -> match semantic_type_graph_node(graph, trait_atom) {
      SemanticTraitNode(declaration, _) -> match source.text() {
        None -> None<DeclarationIdentity>()
        Some(spelling) -> match semantic_trait_method_select(
          catalog,
          declaration,
          spelling
        ) {
          SemanticTraitMethodSelected(method, _) -> Some<DeclarationIdentity>(method)
          -- A trait implementation may also expose concrete methods beyond
          -- the trait contract. Keep their family distinct from required
          -- trait members while the function identity remains exact.
          SemanticTraitMethodSelectionMissing -> Some<DeclarationIdentity>(
            MemberDeclarationIdentity(declaration, InherentMethodDeclaration, source)
          )
          SemanticTraitMethodSelectionAmbiguous -> None<DeclarationIdentity>()
        }
      }
      _ -> None<DeclarationIdentity>()
    }
  }
}

fn semantic_implementation_contains_method(
  implemented: List<DeclarationIdentity>,
  required: DeclarationIdentity
) -> bool {
  match implemented {
    Nil -> false
    Cons(method, remaining) -> if declaration_identity_eq(method, required) { true }
    else { semantic_implementation_contains_method(remaining, required) }
  }
}

-- The position of the most recently added trait `wanted` declares.
fn semantic_trait_position(
  storage: borrow SemanticMethodCatalogStorage,
  wanted: DeclarationIdentity
) -> Option<usize> {
  let mut positions = match storage.traits.index.get(retained_declaration_identity_hash(wanted)) {
    Some(found) -> found
    None -> return None<usize>()
  }
  loop {
    match positions {
      Nil -> return None<usize>()
      Cons(position, rest) -> match storage.traits.declarations.get(position) {
        Some(declaration) -> if declaration_identity_eq(declaration, wanted) {
          return Some<usize>(position)
        } else { positions = rest }
        None -> panic("Semantic trait index diverged from its declarations")
      }
    }
  }
}

fn semantic_required_method_missing(
  available: PersistentVector<DeclarationIdentity>,
  start: usize,
  count: usize,
  implemented: List<DeclarationIdentity>
) -> Option<DeclarationIdentity> {
  if count == 0 { None<DeclarationIdentity>() }
  else {
    match available.get(start) {
      None -> None<DeclarationIdentity>()
      Some(required) -> if semantic_implementation_contains_method(implemented, required) {
        semantic_required_method_missing(available, start + 1, count - 1, implemented)
      } else { Some(required) }
    }
  }
}

fn semantic_implementation_coverage_issue(
  catalog: borrow SemanticMethodCatalog,
  types: borrow SemanticTypeCatalog,
  trait_atom: Option<SemanticTypeId>,
  site: TypeNameRange,
  implemented: List<DeclarationIdentity>
) -> Option<SemanticMethodResolutionIssue> {
  match trait_atom {
    None -> None<SemanticMethodResolutionIssue>()
    Some(atom) -> match types.graph_for(atom) {
      None -> Some(SemanticImplementationTraitContractMissing(site))
      Some(graph) -> match semantic_type_graph_node(graph, atom) {
        SemanticTraitNode(declaration, _) -> match catalog {
          SemanticMethodCatalog(storage) -> match semantic_trait_position(storage, declaration) {
            None -> Some(SemanticImplementationTraitContractMissing(site))
            Some(index) -> match (
              storage.traits.method_counts.get(index),
              storage.traits.method_starts.get(index)
            ) {
              (Some(count), Some(start)) -> match semantic_required_method_missing(
                storage.traits.method_declarations,
                start,
                count,
                implemented
              ) {
                Some(method) -> Some(SemanticImplementationRequiredMethodMissing(method))
                None -> None<SemanticMethodResolutionIssue>()
              }
              _ -> Some(SemanticImplementationTraitContractMissing(site))
            }
          }
        }
        _ -> Some(SemanticImplementationTraitContractMissing(site))
      }
    }
  }
}

fn semantic_inherent_method_owner(
  types: borrow SemanticTypeCatalog,
  target: SemanticTypeId,
  module: RegisteredModule,
  site: TypeNameRange
) -> Option<DeclarationIdentity> {
  match types.graph_for(target) {
    None -> None<DeclarationIdentity>()
    Some(graph) -> match semantic_type_graph_node(graph, target) {
      SemanticNamedNode(declaration, _, _, _) -> Some(declaration)
      SemanticVariantNode(declaration, _) -> Some(declaration)
      SemanticOwnedNode(inner) -> semantic_inherent_method_owner(types, inner, module, site)
      SemanticUniqueNode(inner) -> semantic_inherent_method_owner(types, inner, module, site)
      _ -> match module.source.span(
        __i64_to_usize(site.start),
        __i64_to_usize(site.start + site.length)
      ) {
        Some(target_name) -> Some(
          ModuleDeclarationIdentity(
            module.identity,
            ImplementationTargetDeclaration,
            target_name
          )
        )
        None -> None<DeclarationIdentity>()
      }
    }
  }
}

fn semantic_implementation_methods(
  product: SemanticTypeProductBuilder,
  module: RegisteredModule,
  scope: RegistrationScope,
  catalog: borrow SemanticMethodCatalog,
  types: borrow SemanticTypeCatalog,
  trait_atom: Option<SemanticTypeId>,
  target: SemanticTypeId,
  target_name: TypeNameRange,
  members: List<RegisteredImplMember>,
  declarations: List<DeclarationIdentity>,
  functions: List<FunctionIdentity>,
  signatures: List<SemanticTypeId>
) -> SemanticImplementationMethodsBuild {
  match members {
    Nil -> SemanticImplementationMethodsBuilt(
      product,
      declarations.reverse(),
      functions.reverse(),
      signatures.reverse()
    )
    Cons(member, remaining) -> match member {
      RegisteredImplMethod(function, _) -> match module.source.span(
        __i64_to_usize(function.syntax.name.start),
        __i64_to_usize(function.syntax.name.start + function.syntax.name.length)
      ) {
        None -> SemanticImplementationMethodsRejected(
          product,
          SemanticImplementationMethodMissing(function.identity, None<Span>())
        )
        Some(name_span) -> match name_span.text() {
          None -> SemanticImplementationMethodsRejected(
            product,
            SemanticImplementationMethodMissing(function.identity, Some(name_span))
          )
          Some(_) -> {
            let declaration = match trait_atom {
              Some(atom) -> semantic_method_trait_member_from_catalog(
                catalog,
                types,
                atom,
                name_span
              )
              None -> match function.identity {
                DeclaredFunctionIdentity(identity) -> Some<DeclarationIdentity>(identity)
                _ -> match semantic_inherent_method_owner(
                  types,
                  target,
                  module,
                  target_name
                ) {
                  Some(owner) -> Some<DeclarationIdentity>(
                    MemberDeclarationIdentity(owner, InherentMethodDeclaration, name_span)
                  )
                  None -> None<DeclarationIdentity>()
                }
              }
            }
            match declaration {
              None -> SemanticImplementationMethodsRejected(
                product,
                SemanticImplementationMethodMissing(function.identity, Some(name_span))
              )
              Some(selected) -> match
                resolve_function_signature_product_with_self_in_scope(
                  product,
                  module,
                  scope,
                  function.syntax,
                  function.self_trait
                ) {
                  (product, SemanticTypeResolved(signature)) ->
                    semantic_implementation_methods(
                      product,
                      module,
                      scope,
                      catalog,
                      types,
                      trait_atom,
                      target,
                      target_name,
                      remaining,
                      declarations.prepend(selected),
                      functions.prepend(function.identity),
                      signatures.prepend(signature)
                    )
                  (product, SemanticTypeRejected(issue)) ->
                    SemanticImplementationMethodsRejected(
                      product,
                      SemanticImplementationMethodTypeRejected(function.identity, issue)
                    )
                }
            }
          }
        }
      }
      RegisteredImplTypeBinding(_, _, _) -> semantic_implementation_methods(
        product,
        module,
        scope,
        catalog,
        types,
        trait_atom,
        target,
        target_name,
        remaining,
        declarations,
        functions,
        signatures
      )
    }
  }
}

fn semantic_resolve_implementation(
  product: SemanticTypeProductBuilder,
  module: RegisteredModule,
  scope: RegistrationScope,
  implementation: RegisteredImpl,
  catalog: SemanticMethodCatalog,
  conformances: SemanticConformanceCatalog
) -> SemanticMethodsResolution {
  match resolve_type_product_in_scope(
    product,
    module,
    scope,
    implementation.type_params,
    implementation.target.target
  ) {
    (product, SemanticTypeRejected(issue)) -> SemanticMethodsRejected(
      SemanticImplementationTargetRejected(implementation.name, issue)
    )
    (product, SemanticTypeResolved(target)) -> {
      let trait_type = semantic_method_trait_type(
        implementation.target.protocol,
        implementation.members
      )
      match trait_type {
        Some(authored) -> match resolve_type_product_in_scope(
          product,
          module,
          scope,
          implementation.type_params,
          authored
        ) {
          (_, SemanticTypeRejected(issue)) -> SemanticMethodsRejected(
            SemanticImplementationTraitRejected(implementation.name, issue)
          )
          (product, SemanticTypeResolved(atom)) -> semantic_resolve_implementation_ready(
            product,
            module,
            scope,
            implementation,
            target,
            Some<SemanticTypeId>(atom),
            catalog,
            conformances
          )
        }
        None -> semantic_resolve_implementation_ready(
          product,
          module,
          scope,
          implementation,
          target,
          None<SemanticTypeId>(),
          catalog,
          conformances
        )
      }
    }
  }
}

fn semantic_resolve_implementation_ready(
  product: SemanticTypeProductBuilder,
  module: RegisteredModule,
  scope: RegistrationScope,
  implementation: RegisteredImpl,
  target: SemanticTypeId,
  trait_atom: Option<SemanticTypeId>,
  catalog: SemanticMethodCatalog,
  conformances: SemanticConformanceCatalog
) -> SemanticMethodsResolution {
  match semantic_method_requirements(
    product,
    module,
    scope,
    implementation.type_params,
    implementation.type_params,
    Nil<SemanticConformanceRequirement>()
  ) {
    SemanticRequirementsRejected(_, issue) -> SemanticMethodsRejected(
      SemanticImplementationBoundRejected(implementation.name, issue)
    )
    SemanticRequirementsBuilt(product, requirements) -> {
      let types = semantic_type_product_catalog(product)
      match semantic_implementation_methods(
        product,
        module,
        scope,
        catalog,
        types,
        trait_atom,
        target,
        implementation.name,
        implementation.members,
        Nil<DeclarationIdentity>(),
        Nil<FunctionIdentity>(),
        Nil<SemanticTypeId>()
      ) {
        SemanticImplementationMethodsRejected(_, issue) -> SemanticMethodsRejected(issue)
        SemanticImplementationMethodsBuilt(
          product,
          declarations,
          functions,
          signatures,
        ) -> match semantic_implementation_coverage_issue(
          catalog,
          types,
          trait_atom,
          implementation.name,
          declarations
        ) {
          Some(issue) -> SemanticMethodsRejected(issue)
          None -> {
            let resolved_types = semantic_type_product_catalog(product)
            let next_catalog = semantic_method_catalog_add_implementation(
              catalog,
              resolved_types,
              target,
              trait_atom,
              requirements,
              declarations,
              functions,
              signatures
            )
            let next_conformances = match trait_atom {
              Some(atom) -> semantic_conformance_catalog_add_evidence(
                conformances,
                semantic_conformance_evidence(target, atom, requirements)
              )
              None -> conformances
            }
            SemanticMethodsResolved(product, next_catalog, next_conformances)
          }
        }
      }
    }
  }
}

fn semantic_resolve_declarations(
  product: SemanticTypeProductBuilder,
  module: RegisteredModule,
  scope: RegistrationScope,
  index: usize,
  implementations: bool,
  catalog: SemanticMethodCatalog,
  conformances: SemanticConformanceCatalog
) -> SemanticMethodsResolution {
  let declarations = module.declarations
  if index >= declarations.len() {
    SemanticMethodsResolved(product, catalog, conformances)
  } else {
    let declaration = declarations.at(dense_index(index))
    match declaration.kind {
      RegisteredTraitDeclaration(trait_value) -> if implementations {
        semantic_resolve_declarations(
          product,
          module,
          scope,
          index + 1,
          implementations,
          catalog,
          conformances
        )
      } else {
        match semantic_trait_methods(
          product,
          module,
          scope,
          UnqualifiedTraitTypeExpr(0, trait_value.name.range),
          trait_value.members,
          Nil<DeclarationIdentity>(),
          Nil<SemanticTypeId>()
        ) {
          SemanticTraitMethodsRejected(member, issue) -> SemanticMethodsRejected(
            SemanticTraitMethodTypeRejected(member, issue)
          )
          SemanticTraitMethodsBuilt(product, methods, signatures) ->
            semantic_resolve_declarations(
              product,
              module,
              scope,
              index + 1,
              implementations,
              semantic_method_catalog_add_trait(
                catalog,
                trait_value.name.identity,
                methods,
                signatures
              ),
              conformances
            )
        }
      }
      RegisteredImplDeclaration(implementation) -> if not implementations {
        semantic_resolve_declarations(
          product,
          module,
          scope,
          index + 1,
          implementations,
          catalog,
          conformances
        )
      } else {
        match semantic_resolve_implementation(
          product,
          module,
          scope,
          implementation,
          catalog,
          conformances
        ) {
          SemanticMethodsRejected(issue) -> SemanticMethodsRejected(issue)
          SemanticMethodsResolved(product, catalog, conformances) ->
            semantic_resolve_declarations(
              product,
              module,
              scope,
              index + 1,
              implementations,
              catalog,
              conformances
            )
        }
      }
      _ -> semantic_resolve_declarations(
        product,
        module,
        scope,
        index + 1,
        implementations,
        catalog,
        conformances
      )
    }
  }
}

fn semantic_resolve_modules(
  product: SemanticTypeProductBuilder,
  scope: RegistrationScope,
  index: usize,
  implementations: bool,
  catalog: SemanticMethodCatalog,
  conformances: SemanticConformanceCatalog
) -> SemanticMethodsResolution {
  if index >= registration_scope_len(scope) {
    SemanticMethodsResolved(product, catalog, conformances)
  } else {
    let module = registration_scope_at(scope, __u64_to_i64(__usize_to_u64(index)))
    match semantic_resolve_declarations(
      product,
      module,
      scope,
      0,
      implementations,
      catalog,
      conformances
    ) {
      SemanticMethodsRejected(issue) -> SemanticMethodsRejected(issue)
      SemanticMethodsResolved(product, catalog, conformances) -> semantic_resolve_modules(
        product,
        scope,
        index + 1,
        implementations,
        catalog,
        conformances
      )
    }
  }
}

pub(package) fn resolve_semantic_methods(
  product: SemanticTypeProductBuilder,
  scope: RegistrationScope
) -> SemanticMethodsResolution {
  match semantic_resolve_modules(
    product,
    scope,
    0,
    false,
    semantic_method_catalog_empty(),
    semantic_conformance_catalog_empty()
  ) {
    SemanticMethodsRejected(issue) -> SemanticMethodsRejected(issue)
    SemanticMethodsResolved(product, catalog, conformances) -> semantic_resolve_modules(
      product,
      scope,
      0,
      true,
      catalog,
      conformances
    )
  }
}

fn semantic_method_named(
  declarations: PersistentVector<DeclarationIdentity>,
  signatures: PersistentVector<SemanticTypeId>,
  start: usize,
  count: usize,
  spelling: str,
  found: SemanticTraitMethodSelection
) -> SemanticTraitMethodSelection {
  if count == 0 { found }
  else {
    match (declarations.get(start), signatures.get(start)) {
      (Some(declaration), Some(signature)) -> {
        let next = if semantic_method_same_name(declaration, spelling) {
          match found {
            SemanticTraitMethodSelectionMissing -> SemanticTraitMethodSelected(
              declaration,
              signature
            )
            _ -> SemanticTraitMethodSelectionAmbiguous
          }
        } else { found }
        semantic_method_named(
          declarations,
          signatures,
          start + 1,
          count - 1,
          spelling,
          next
        )
      }
      _ -> SemanticTraitMethodSelectionMissing
    }
  }
}

fn semantic_trait_method_select_from(
  storage: borrow SemanticMethodCatalogStorage,
  trait_declaration: DeclarationIdentity,
  spelling: str
) -> SemanticTraitMethodSelection {
  match semantic_trait_position(storage, trait_declaration) {
    None -> SemanticTraitMethodSelectionMissing
    Some(index) -> match (
      storage.traits.method_counts.get(index),
      storage.traits.method_starts.get(index)
    ) {
      (Some(count), Some(start)) -> semantic_method_named(
        storage.traits.method_declarations,
        storage.traits.method_signatures,
        start,
        count,
        spelling,
        SemanticTraitMethodSelectionMissing
      )
      _ -> SemanticTraitMethodSelectionMissing
    }
  }
}

pub(package) fn semantic_trait_method_select(
  catalog: borrow SemanticMethodCatalog,
  trait_declaration: DeclarationIdentity,
  spelling: str
) -> SemanticTraitMethodSelection {
  match catalog {
    SemanticMethodCatalog(storage) -> semantic_trait_method_select_from(
      storage,
      trait_declaration,
      spelling
    )
  }
}

pub(package) fn semantic_method_implementation_count(
  catalog: borrow SemanticMethodCatalog
) -> usize {
  match catalog {
    SemanticMethodCatalog(storage) -> storage.implementations.targets.len()
  }
}

pub(package) fn semantic_method_signature_count(
  catalog: borrow SemanticMethodCatalog
) -> usize {
  match catalog {
    SemanticMethodCatalog(storage) ->
      storage.traits.method_signatures.len() + storage.implementations.method_signatures.len()
  }
}

pub(package) fn semantic_method_signature_at(
  catalog: borrow SemanticMethodCatalog,
  index: usize
) -> Option<SemanticTypeId> {
  match catalog {
    SemanticMethodCatalog(storage) -> {
      let trait_count = storage.traits.method_signatures.len()
      if index < trait_count { storage.traits.method_signatures.get(index) }
      else { storage.implementations.method_signatures.get(index - trait_count) }
    }
  }
}

pub(package) fn semantic_method_implementation_target(
  catalog: borrow SemanticMethodCatalog,
  index: usize
) -> Option<SemanticTypeId> {
  match catalog {
    SemanticMethodCatalog(storage) -> storage.implementations.targets.get(index)
  }
}

fn semantic_method_function_in_range(
  functions: borrow PersistentVector<FunctionIdentity>,
  wanted: FunctionIdentity,
  start: usize,
  count: usize
) -> bool {
  let mut offset: usize = 0
  while offset < count {
    match functions.get(start + offset) {
      Some(function) -> if function_identity_eq(function, wanted) { return true }
      None -> return false
    }
    offset = offset + 1
  }
  false
}

-- The implementation holding a method function that has no retained key.
fn semantic_method_function_implementation_from(
  storage: borrow SemanticMethodCatalogStorage,
  wanted: FunctionIdentity,
  implementation: usize
) -> Option<usize> {
  match (
    storage.implementations.method_counts.get(implementation),
    storage.implementations.method_starts.get(implementation),
  ) {
    (Some(count), Some(start)) -> {
      let functions = storage.implementations.method_functions
      if semantic_method_function_in_range(functions, wanted, start, count) {
        Some<usize>(implementation)
      } else {
        semantic_method_function_implementation_from(storage, wanted, implementation + 1)
      }
    }
    _ -> None<usize>()
  }
}

pub(package) fn semantic_method_function_substitution(
  catalog: borrow SemanticMethodCatalog,
  types: borrow SemanticTypeCatalog,
  function: FunctionIdentity
) -> Option<SemanticTypeSubstitution> {
  match catalog {
    SemanticMethodCatalog(storage) -> match semantic_method_function_implementation(
      storage,
      function
    ) {
      None -> None<SemanticTypeSubstitution>()
      Some(implementation) -> match storage.implementations.targets.get(implementation) {
        None -> None<SemanticTypeSubstitution>()
        Some(target) -> Some<SemanticTypeSubstitution>(
          semantic_method_bind_associated(
            storage,
            types,
            implementation,
            target,
            semantic_type_substitution_bind(
              semantic_type_substitution_empty(),
              SemanticSelfVariable,
              target
            )
          )
        )
      }
    }
  }
}

fn semantic_method_function_named_in_range(
  storage: borrow SemanticMethodCatalogStorage,
  wanted: FunctionIdentity,
  spelling: str,
  start: usize,
  count: usize
) -> bool {
  if count == 0 { false }
  else {
    match (
      storage.implementations.method_functions.get(start),
      storage.implementations.method_declarations.get(start),
    ) {
      (Some(function), Some(declaration)) -> if function_identity_eq(function, wanted) and
        semantic_method_same_name(declaration, spelling) { true }
      else {
        semantic_method_function_named_in_range(
          storage,
          wanted,
          spelling,
          start + 1,
          count - 1
        )
      }
      _ -> false
    }
  }
}

--- Whether an implementation body receives its `self` binding as the final
--- owned resource stake. Dispatch still uses the nominal implementation
--- target; this fact affects only the method body's lexical receiver.
pub(package) fn semantic_method_function_consumes_receiver(
  catalog: borrow SemanticMethodCatalog,
  types: borrow SemanticTypeCatalog,
  function: FunctionIdentity
) -> bool {
  match catalog {
    SemanticMethodCatalog(storage) -> match semantic_method_function_implementation(
      storage,
      function
    ) {
      None -> false
      Some(implementation) -> match (
        storage.implementations.trait_present.get(implementation),
        storage.implementations.trait_atoms.get(implementation),
        storage.implementations.method_counts.get(implementation),
        storage.implementations.method_starts.get(implementation),
      ) {
        (Some(true), Some(trait_atom), Some(count), Some(start)) -> match
          types.graph_for(trait_atom) {
            None -> false
            Some(graph) -> match semantic_type_graph_node(graph, trait_atom) {
              SemanticTraitNode(declaration, _) -> semantic_method_same_name(
                declaration,
                "Drop"
              ) and semantic_method_function_named_in_range(
                storage,
                function,
                "drop",
                start,
                count
              )
              _ -> false
            }
          }
        _ -> false
      }
    }
  }
}

-- A conformance a checking context may assume: a rigid type variable of the
-- enclosing function or implementation, which its bounds declare to conform
-- to a trait. Only that exact variable is covered; an assumption is never a
-- pattern that other types match.
pub(package) type SemanticAssumedConformance {
  variable: SemanticTypeVariable,
  trait_atom: SemanticTypeId
}

fn semantic_assumption_covers(
  types: borrow SemanticTypeCatalog,
  assumptions: List<SemanticAssumedConformance>,
  concrete: SemanticTypeId,
  trait_atom: SemanticTypeId
) -> bool {
  match types.graph_for(concrete) {
    None -> false
    Some(graph) -> match semantic_type_graph_node(graph, concrete) {
      SemanticVariableNode(variable) -> semantic_assumptions_list(
        types,
        assumptions,
        variable,
        trait_atom
      )
      _ -> false
    }
  }
}

fn semantic_assumptions_list(
  types: borrow SemanticTypeCatalog,
  assumptions: List<SemanticAssumedConformance>,
  variable: SemanticTypeVariable,
  trait_atom: SemanticTypeId
) -> bool {
  match assumptions {
    Nil -> false
    Cons(assumed, rest) -> (
      semantic_method_type_variable_eq(assumed.variable, variable) and
        semantic_conformance_trait_atom_satisfies(types, assumed.trait_atom, trait_atom)
    ) or semantic_assumptions_list(types, rest, variable, trait_atom)
  }
}

fn semantic_method_type_variable_eq(
  left: SemanticTypeVariable,
  right: SemanticTypeVariable
) -> bool {
  match (left, right) {
    (SemanticSelfVariable, SemanticSelfVariable) -> true
    (SemanticParameterVariable(a), SemanticParameterVariable(b)) -> a == b
    _ -> false
  }
}

fn semantic_method_requirements_hold(
  types: borrow SemanticTypeCatalog,
  conformances: borrow SemanticConformanceCatalog,
  assumptions: List<SemanticAssumedConformance>,
  variables: PersistentVector<SemanticTypeVariable>,
  traits: PersistentVector<SemanticTypeId>,
  start: usize,
  count: usize,
  substitution: borrow SemanticTypeSubstitution
) -> bool {
  if count == 0 { true }
  else {
    match (variables.get(start), traits.get(start)) {
      (Some(variable), Some(trait_atom)) -> match semantic_type_substitution_get(
        substitution,
        variable
      ) {
        Some(concrete) -> (
          semantic_conformance_catalog_conforms_substituted(
            types,
            conformances,
            concrete,
            trait_atom,
            substitution
          ) or semantic_assumption_covers(types, assumptions, concrete, trait_atom)
        ) and semantic_method_requirements_hold(
          types,
          conformances,
          assumptions,
          variables,
          traits,
          start + 1,
          count - 1,
          substitution
        )
        None -> false
      }
      _ -> false
    }
  }
}

fn semantic_method_bind_associated_from(
  types: borrow SemanticTypeCatalog,
  trait_atom: SemanticTypeId,
  receiver: SemanticTypeId,
  offset: usize,
  substitution: SemanticTypeSubstitution
) -> SemanticTypeSubstitution {
  let graph = types.graph_for(trait_atom).unwrap()
  match semantic_type_graph_node(graph, trait_atom) {
    SemanticTraitNode(_, bindings) -> {
      let traits = semantic_type_graph_traits_local(graph)
      if offset >= semantic_type_trait_binding_count(traits, bindings) { substitution }
      else {
        let edge = semantic_type_trait_binding_edge(traits, bindings, offset)
        semantic_method_bind_associated_from(
          types,
          trait_atom,
          receiver,
          offset + 1,
          semantic_type_substitution_bind_associated(
            substitution,
            SemanticSelfVariable,
            semantic_type_graph_trait_binding_declaration(graph, edge),
            semantic_type_graph_trait_binding_type_id(graph, edge)
          )
        )
      }
    }
    _ -> substitution
  }
}

pub(package) fn semantic_trait_method_substitution(
  types: borrow SemanticTypeCatalog,
  trait_atom: SemanticTypeId,
  receiver: SemanticTypeId
) -> SemanticTypeSubstitution {
  semantic_method_bind_associated_from(
    types,
    trait_atom,
    receiver,
    0,
    semantic_type_substitution_bind(
      semantic_type_substitution_empty(),
      SemanticSelfVariable,
      receiver
    )
  )
}

fn semantic_method_bind_associated(
  storage: borrow SemanticMethodCatalogStorage,
  types: borrow SemanticTypeCatalog,
  implementation: usize,
  receiver: SemanticTypeId,
  substitution: SemanticTypeSubstitution
) -> SemanticTypeSubstitution {
  match (
    storage.implementations.trait_present.get(implementation),
    storage.implementations.trait_atoms.get(implementation),
  ) {
    (Some(true), Some(trait_atom)) -> semantic_method_bind_associated_from(
      types,
      trait_atom,
      receiver,
      0,
      substitution
    )
    _ -> substitution
  }
}

fn semantic_implementation_named(
  storage: borrow SemanticMethodCatalogStorage,
  start: usize,
  count: usize,
  spelling: str,
  substitution: SemanticTypeSubstitution
) -> SemanticImplementationMethodSelection {
  if count == 0 { SemanticImplementationMethodSelectionMissing }
  else {
    match (
      storage.implementations.method_declarations.get(start),
      storage.implementations.method_functions.get(start),
      storage.implementations.method_signatures.get(start),
    ) {
      (Some(declaration), Some(function), Some(signature)) -> if
        semantic_method_same_name(declaration, spelling) {
          SemanticImplementationMethodSelected(
            declaration,
            function,
            signature,
            substitution
          )
        } else {
          semantic_implementation_named(
            storage,
            start + 1,
            count - 1,
            spelling,
            substitution
          )
        }
      _ -> SemanticImplementationMethodSelectionMissing
    }
  }
}

fn semantic_implementation_exact(
  storage: borrow SemanticMethodCatalogStorage,
  start: usize,
  count: usize,
  wanted: DeclarationIdentity,
  substitution: SemanticTypeSubstitution
) -> SemanticImplementationMethodSelection {
  if count == 0 { SemanticImplementationMethodSelectionMissing }
  else {
    match (
      storage.implementations.method_declarations.get(start),
      storage.implementations.method_functions.get(start),
      storage.implementations.method_signatures.get(start),
    ) {
      (Some(declaration), Some(function), Some(signature)) -> if
        declaration_identity_eq(declaration, wanted) {
          SemanticImplementationMethodSelected(
            declaration,
            function,
            signature,
            substitution
          )
        } else {
          semantic_implementation_exact(
            storage,
            start + 1,
            count - 1,
            wanted,
            substitution
          )
        }
      _ -> SemanticImplementationMethodSelectionMissing
    }
  }
}

-- How a selection names the method it wants: by its authored spelling, or
-- by the exact declaration checking already selected.
type SemanticImplementationMethodWanted {
  SemanticMethodWantedBySpelling(str),
  SemanticMethodWantedByDeclaration(DeclarationIdentity)
}

-- One implementation's wanted method for `receiver`, when its target
-- matches and its requirements hold.
fn semantic_implementation_candidate(
  storage: borrow SemanticMethodCatalogStorage,
  types: borrow SemanticTypeCatalog,
  conformances: borrow SemanticConformanceCatalog,
  assumptions: List<SemanticAssumedConformance>,
  receiver: SemanticTypeId,
  index: usize,
  wanted: SemanticImplementationMethodWanted
) -> SemanticImplementationMethodSelection {
  match (
    storage.implementations.targets.get(index),
    storage.implementations.requirement_starts.get(index),
    storage.implementations.requirement_counts.get(index),
    storage.implementations.method_starts.get(index),
    storage.implementations.method_counts.get(index),
  ) {
    (
      Some(target),
      Some(requirement_start),
      Some(requirement_count),
      Some(method_start),
      Some(method_count),
    ) -> match semantic_type_pattern_match(types, target, receiver) {
      SemanticTypePatternRejected -> SemanticImplementationMethodSelectionMissing
      SemanticTypePatternMatched(target_substitution) -> {
        let substitution = semantic_method_bind_associated(
          storage,
          types,
          index,
          receiver,
          semantic_type_substitution_bind(target_substitution, SemanticSelfVariable, receiver)
        )
        if semantic_method_requirements_hold(
          types,
          conformances,
          assumptions,
          storage.implementations.requirement_variables,
          storage.implementations.requirement_traits,
          requirement_start,
          requirement_count,
          substitution
        ) {
          match wanted {
            SemanticMethodWantedBySpelling(spelling) -> semantic_implementation_named(
              storage,
              method_start,
              method_count,
              spelling,
              substitution
            )
            SemanticMethodWantedByDeclaration(declaration) -> semantic_implementation_exact(
              storage,
              method_start,
              method_count,
              declaration,
              substitution
            )
          }
        } else { SemanticImplementationMethodSelectionMissing }
      }
    }
    _ -> panic("Semantic implementation columns diverged")
  }
}

-- The one selection among candidate implementations: a second selection
-- makes the whole choice ambiguous.
fn semantic_implementation_join(
  found: SemanticImplementationMethodSelection,
  next: SemanticImplementationMethodSelection
) -> SemanticImplementationMethodSelection {
  match (found, next) {
    (SemanticImplementationMethodSelectionAmbiguous, _) ->
      SemanticImplementationMethodSelectionAmbiguous
    (_, SemanticImplementationMethodSelectionAmbiguous) ->
      SemanticImplementationMethodSelectionAmbiguous
    (SemanticImplementationMethodSelectionMissing, selection) -> selection
    (selection, SemanticImplementationMethodSelectionMissing) -> selection
    _ -> SemanticImplementationMethodSelectionAmbiguous
  }
}

-- Resolve the exact declaration selected by checking to its implementation
-- function for a concrete receiver. This preserves trait qualification and
-- avoids reopening method spelling during specialization.
pub(package) fn semantic_implementation_method_resolve(
  catalog: borrow SemanticMethodCatalog,
  types: borrow SemanticTypeCatalog,
  conformances: borrow SemanticConformanceCatalog,
  receiver: SemanticTypeId,
  declaration: DeclarationIdentity
) -> SemanticImplementationMethodSelection {
  match catalog {
    SemanticMethodCatalog(storage) -> {
      let heads = storage.implementations.heads
      let mut found = SemanticImplementationMethodSelectionMissing
      for index in semantic_implementation_candidates(
        heads,
        semantic_type_pattern_head(types, receiver)
      ) {
        found = semantic_implementation_join(
          found,
          semantic_implementation_candidate(
            storage,
            types,
            conformances,
            Nil<SemanticAssumedConformance>(),
            receiver,
            index,
            SemanticMethodWantedByDeclaration(declaration)
          )
        )
      }
      found
    }
  }
}

fn semantic_implementation_select_from(
  storage: borrow SemanticMethodCatalogStorage,
  types: borrow SemanticTypeCatalog,
  conformances: borrow SemanticConformanceCatalog,
  assumptions: List<SemanticAssumedConformance>,
  receiver: SemanticTypeId,
  spelling: str,
  required_trait: DeclarationIdentity?
) -> SemanticImplementationMethodSelection {
  let heads = storage.implementations.heads
  let mut found = SemanticImplementationMethodSelectionMissing
  for index in semantic_implementation_candidates(
    heads,
    semantic_type_pattern_head(types, receiver)
  ) {
    if semantic_implementation_trait_matches(storage, types, index, required_trait) {
      found = semantic_implementation_join(
        found,
        semantic_implementation_candidate(
          storage,
          types,
          conformances,
          assumptions,
          receiver,
          index,
          SemanticMethodWantedBySpelling(spelling)
        )
      )
    }
  }
  found
}

fn semantic_implementation_trait_matches(
  storage: borrow SemanticMethodCatalogStorage,
  types: borrow SemanticTypeCatalog,
  index: usize,
  required: DeclarationIdentity?
) -> bool {
  match required {
    nil -> true
    declaration: DeclarationIdentity -> match (
      storage.implementations.trait_present.get(index),
      storage.implementations.trait_atoms.get(index),
    ) {
      (Some(true), Some(atom)) -> match types.graph_for(atom) {
        None -> false
        Some(graph) -> match semantic_type_graph_node(graph, atom) {
          SemanticTraitNode(candidate, _) -> declaration_identity_eq(candidate, declaration)
          _ -> false
        }
      }
      _ -> false
    }
  }
}

pub(package) fn semantic_implementation_method_select(
  catalog: borrow SemanticMethodCatalog,
  types: borrow SemanticTypeCatalog,
  conformances: borrow SemanticConformanceCatalog,
  assumptions: List<SemanticAssumedConformance>,
  receiver: SemanticTypeId,
  spelling: str
) -> SemanticImplementationMethodSelection {
  match catalog {
    SemanticMethodCatalog(storage) -> semantic_implementation_select_from(
      storage,
      types,
      conformances,
      assumptions,
      receiver,
      spelling,
      nil
    )
  }
}

pub(package) fn semantic_trait_implementation_method_select(
  catalog: borrow SemanticMethodCatalog,
  types: borrow SemanticTypeCatalog,
  conformances: borrow SemanticConformanceCatalog,
  assumptions: List<SemanticAssumedConformance>,
  receiver: SemanticTypeId,
  trait_declaration: DeclarationIdentity,
  spelling: str
) -> SemanticImplementationMethodSelection {
  match catalog {
    SemanticMethodCatalog(storage) -> semantic_implementation_select_from(
      storage,
      types,
      conformances,
      assumptions,
      receiver,
      spelling,
      trait_declaration
    )
  }
}
