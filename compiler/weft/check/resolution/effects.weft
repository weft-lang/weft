-- Resolved effect declarations and operation signature templates.
--
-- Effect atoms and operation types extend the same immutable semantic catalog
-- as function signatures and declared data. Generic operation templates retain
-- their declaration variables; concrete perform/handle composition applies the
-- substitution selected by the atom pattern.

use compiler/ir/data.{
  DeferredTypeEffectOp,
  MissingTypeExpr,
  MissingTypeParam,
  Param,
  ParamList,
  ParamListCons,
  ParamListNil,
  TypeEffectOp,
  TypeExpr,
  TypeExprList,
  TypeExprListCons,
  TypeExprListNil,
  TypeParam,
  TypeParamList,
  TypeParamListCons,
  TypeParamListNil,
  UnqualifiedEffectTypeExpr,
  UnknownParam,
  VariableTypeExpr
}
use compiler/project/identity.{DeclarationIdentity}
use compiler/types/graph.{SemanticTypeId}
use compiler/types/graph/catalog.{SemanticTypeCatalog}
use compiler/types/graph/pattern.{
  SemanticTypePatternMatched,
  SemanticTypePatternRejected,
  semantic_type_pattern_match_substituted
}
use compiler/types/graph/substitution.{
  SemanticTypeSubstitution,
  semantic_type_substitution_empty
}
use compiler/weft/check/registration/catalog.{
  RegisteredDeclarationKind,
  RegisteredEffect,
  RegisteredEffectDeclaration,
  RegisteredEffectOperation,
  RegisteredModule
}
use compiler/weft/check/registration/scope.{RegistrationScope}
use compiler/weft/check/semantic_types.{
  SemanticDeclarationResolutionRequired,
  SemanticTypeProductBuilder,
  SemanticTypeRejected,
  SemanticTypeResolutionIssue,
  SemanticTypeResolved,
  resolve_type_product_in_scope,
  semantic_type_product_catalog
}
use compiler/weft/check/storage.{dense_index}
use stdlib/list.{Cons, List, Nil}
use stdlib/num/scalar.{num_scalar_usize_checked_add}
use stdlib/option.{None, Option, Some}
use stdlib/panic.{panic}

type SemanticEffectDeclarationCatalogStorage {
  targets: List<SemanticTypeId>,
  declarations: List<DeclarationIdentity>,
  operation_counts: List<usize>,
  operation_declarations: List<DeclarationIdentity>,
  operation_deferred: List<bool>,
  operation_parameter_counts: List<usize>,
  operation_parameter_types: List<SemanticTypeId>,
  operation_results: List<SemanticTypeId>
}

pub(package) type SemanticEffectDeclarationCatalog = opaque SemanticEffectDeclarationCatalogStorage

pub(package) type SemanticEffectDeclarationMatch {
  SemanticEffectDeclarationMatched(usize, SemanticTypeSubstitution),
  SemanticEffectDeclarationMissing
}

pub(package) type SemanticEffectResolutionIssue {
  SemanticEffectTypeRejected(DeclarationIdentity, SemanticTypeResolutionIssue),
  SemanticEffectOperationTypeRejected(
    DeclarationIdentity,
    SemanticTypeResolutionIssue
  )
}

pub(package) type SemanticEffectsResolution {
  SemanticEffectsResolved(
    SemanticTypeProductBuilder,
    SemanticEffectDeclarationCatalog
  ),
  SemanticEffectsRejected(SemanticEffectResolutionIssue)
}

type SemanticEffectParameterResolution {
  SemanticEffectParametersResolved(
    SemanticTypeProductBuilder,
    List<SemanticTypeId>,
    usize
  ),
  SemanticEffectParametersRejected(
    SemanticTypeProductBuilder,
    SemanticTypeResolutionIssue
  )
}

type SemanticEffectOperationsResolution {
  SemanticEffectOperationsResolved(
    SemanticTypeProductBuilder,
    List<DeclarationIdentity>,
    List<bool>,
    List<usize>,
    List<SemanticTypeId>,
    List<SemanticTypeId>
  ),
  SemanticEffectOperationsRejected(
    SemanticTypeProductBuilder,
    DeclarationIdentity,
    SemanticTypeResolutionIssue
  )
}

fn semantic_effect_declaration_catalog_empty(
) -> SemanticEffectDeclarationCatalog {
  SemanticEffectDeclarationCatalog(
    SemanticEffectDeclarationCatalogStorage {
      targets: Nil<SemanticTypeId>(),
      declarations: Nil<DeclarationIdentity>(),
      operation_counts: Nil<usize>(),
      operation_declarations: Nil<DeclarationIdentity>(),
      operation_deferred: Nil<bool>(),
      operation_parameter_counts: Nil<usize>(),
      operation_parameter_types: Nil<SemanticTypeId>(),
      operation_results: Nil<SemanticTypeId>()
    }
  )
}

fn semantic_effect_declarations_prepend(
  values: List<DeclarationIdentity>,
  suffix: List<DeclarationIdentity>
) -> List<DeclarationIdentity> {
  match values {
    Nil -> suffix
    Cons(value, remaining) -> Cons<DeclarationIdentity>(
      value,
      semantic_effect_declarations_prepend(remaining, suffix)
    )
  }
}

fn semantic_effect_bools_prepend(
  values: List<bool>,
  suffix: List<bool>
) -> List<bool> {
  match values {
    Nil -> suffix
    Cons(value, remaining) -> Cons<bool>(
      value,
      semantic_effect_bools_prepend(remaining, suffix)
    )
  }
}

fn semantic_effect_usizes_prepend(
  values: List<usize>,
  suffix: List<usize>
) -> List<usize> {
  match values {
    Nil -> suffix
    Cons(value, remaining) -> Cons<usize>(
      value,
      semantic_effect_usizes_prepend(remaining, suffix)
    )
  }
}

fn semantic_effect_types_prepend(
  values: List<SemanticTypeId>,
  suffix: List<SemanticTypeId>
) -> List<SemanticTypeId> {
  match values {
    Nil -> suffix
    Cons(value, remaining) -> Cons<SemanticTypeId>(
      value,
      semantic_effect_types_prepend(remaining, suffix)
    )
  }
}

fn semantic_effect_declaration_catalog_add(
  catalog: SemanticEffectDeclarationCatalog,
  target: SemanticTypeId,
  declaration: DeclarationIdentity,
  operation_declarations: List<DeclarationIdentity>,
  operation_deferred: List<bool>,
  operation_parameter_counts: List<usize>,
  operation_parameter_types: List<SemanticTypeId>,
  operation_results: List<SemanticTypeId>
) -> SemanticEffectDeclarationCatalog {
  match catalog {
    SemanticEffectDeclarationCatalog(storage) ->
      SemanticEffectDeclarationCatalog(
        SemanticEffectDeclarationCatalogStorage {
          targets: storage.targets.prepend(target),
          declarations: storage.declarations.prepend(declaration),
          operation_counts: storage.operation_counts.prepend(
            operation_declarations.len()
          ),
          operation_declarations: semantic_effect_declarations_prepend(
            operation_declarations,
            storage.operation_declarations
          ),
          operation_deferred: semantic_effect_bools_prepend(
            operation_deferred,
            storage.operation_deferred
          ),
          operation_parameter_counts: semantic_effect_usizes_prepend(
            operation_parameter_counts,
            storage.operation_parameter_counts
          ),
          operation_parameter_types: semantic_effect_types_prepend(
            operation_parameter_types,
            storage.operation_parameter_types
          ),
          operation_results: semantic_effect_types_prepend(
            operation_results,
            storage.operation_results
          )
        }
      )
  }
}

fn semantic_effect_parameter_arguments(parameters: TypeParamList) -> TypeExprList {
  match parameters {
    TypeParamListNil -> TypeExprListNil
    TypeParamListCons(parameter, remaining) -> match parameter {
      TypeParam(_, _, identity, _) -> TypeExprListCons(
        VariableTypeExpr(identity),
        semantic_effect_parameter_arguments(remaining),
        nil
      )
      MissingTypeParam -> TypeExprListCons(
        MissingTypeExpr,
        semantic_effect_parameter_arguments(remaining),
        nil
      )
    }
  }
}

fn semantic_effect_parameters(
  product: SemanticTypeProductBuilder,
  module: RegisteredModule,
  scope: RegistrationScope,
  type_parameters: TypeParamList,
  parameters: ParamList,
  types: List<SemanticTypeId>,
  count: usize
) -> SemanticEffectParameterResolution {
  match parameters {
    ParamListNil -> SemanticEffectParametersResolved(product, types, count)
    ParamListCons(parameter, remaining) -> match parameter {
      Param(_, _, annotation, _) -> match resolve_type_product_in_scope(
        product,
        module,
        scope,
        type_parameters,
        annotation
      ) {
        (product, SemanticTypeResolved(parameter_type)) -> semantic_effect_parameters(
          product,
          module,
          scope,
          type_parameters,
          remaining,
          types.prepend(parameter_type),
          count + 1
        )
        (product, SemanticTypeRejected(issue)) -> SemanticEffectParametersRejected(
          product,
          issue
        )
      }
      UnknownParam(_) -> SemanticEffectParametersRejected(
        product,
        SemanticDeclarationResolutionRequired
      )
    }
  }
}

fn semantic_effect_operations(
  product: SemanticTypeProductBuilder,
  module: RegisteredModule,
  scope: RegistrationScope,
  type_parameters: TypeParamList,
  operations: List<RegisteredEffectOperation>,
  declarations: List<DeclarationIdentity>,
  deferred: List<bool>,
  parameter_counts: List<usize>,
  parameter_types: List<SemanticTypeId>,
  results: List<SemanticTypeId>
) -> SemanticEffectOperationsResolution {
  match operations {
    Nil -> SemanticEffectOperationsResolved(
      product,
      declarations.reverse(),
      deferred.reverse(),
      parameter_counts.reverse(),
      parameter_types.reverse(),
      results.reverse()
    )
    Cons(operation, remaining) -> {
      let (parameters, result, is_deferred) = match operation.syntax {
        TypeEffectOp(_, _, parameters, result) -> (parameters, result, false)
        DeferredTypeEffectOp(_, _, parameters, result) -> (parameters, result, true)
        _ -> return SemanticEffectOperationsRejected(
          product,
          operation.name.identity,
          SemanticDeclarationResolutionRequired
        )
      }
      match semantic_effect_parameters(
        product,
        module,
        scope,
        type_parameters,
        parameters,
        parameter_types,
        0
      ) {
        SemanticEffectParametersRejected(product, issue) ->
          SemanticEffectOperationsRejected(product, operation.name.identity, issue)
        SemanticEffectParametersResolved(product, parameter_types, parameter_count) ->
          match resolve_type_product_in_scope(
            product,
            module,
            scope,
            type_parameters,
            result
          ) {
            (product, SemanticTypeRejected(issue)) ->
              SemanticEffectOperationsRejected(product, operation.name.identity, issue)
            (product, SemanticTypeResolved(result_type)) -> semantic_effect_operations(
              product,
              module,
              scope,
              type_parameters,
              remaining,
              declarations.prepend(operation.name.identity),
              deferred.prepend(is_deferred),
              parameter_counts.prepend(parameter_count),
              parameter_types,
              results.prepend(result_type)
            )
          }
      }
    }
  }
}

fn semantic_resolve_effect_declaration(
  product: SemanticTypeProductBuilder,
  module: RegisteredModule,
  scope: RegistrationScope,
  effect_value: RegisteredEffect,
  catalog: SemanticEffectDeclarationCatalog
) -> SemanticEffectsResolution {
  match resolve_type_product_in_scope(
    product,
    module,
    scope,
    effect_value.type_params,
    UnqualifiedEffectTypeExpr(
      0,
      semantic_effect_parameter_arguments(effect_value.type_params),
      effect_value.name.range
    )
  ) {
    (product, SemanticTypeRejected(issue)) -> SemanticEffectsRejected(
      SemanticEffectTypeRejected(effect_value.name.identity, issue)
    )
    (product, SemanticTypeResolved(target)) -> match semantic_effect_operations(
      product,
      module,
      scope,
      effect_value.type_params,
      effect_value.operations,
      Nil<DeclarationIdentity>(),
      Nil<bool>(),
      Nil<usize>(),
      Nil<SemanticTypeId>(),
      Nil<SemanticTypeId>()
    ) {
      SemanticEffectOperationsRejected(_, operation, issue) ->
        SemanticEffectsRejected(SemanticEffectOperationTypeRejected(operation, issue))
      SemanticEffectOperationsResolved(
        product,
        operation_declarations,
        operation_deferred,
        operation_parameter_counts,
        operation_parameter_types,
        operation_results,
      ) -> SemanticEffectsResolved(
        product,
        semantic_effect_declaration_catalog_add(
          catalog,
          target,
          effect_value.name.identity,
          operation_declarations,
          operation_deferred,
          operation_parameter_counts,
          operation_parameter_types,
          operation_results
        )
      )
    }
  }
}

fn semantic_effect_declarations(
  module: RegisteredModule,
  scope: RegistrationScope,
  index: usize,
  product: SemanticTypeProductBuilder,
  catalog: SemanticEffectDeclarationCatalog
) -> SemanticEffectsResolution {
  let declarations = module.declarations
  if index >= declarations.len() { SemanticEffectsResolved(product, catalog) }
  else {
    let declaration = declarations.at(dense_index(index))
    match declaration.kind {
      RegisteredEffectDeclaration(effect_value) -> match semantic_resolve_effect_declaration(
        product,
        module,
        scope,
        effect_value,
        catalog
      ) {
        SemanticEffectsRejected(issue) -> SemanticEffectsRejected(issue)
        SemanticEffectsResolved(product, catalog) -> semantic_effect_declarations(
          module,
          scope,
          index + 1,
          product,
          catalog
        )
      }
      _ -> semantic_effect_declarations(
        module,
        scope,
        index + 1,
        product,
        catalog
      )
    }
  }
}

pub(package) fn resolve_semantic_effect_declarations(
  module: RegisteredModule,
  scope: RegistrationScope,
  product: SemanticTypeProductBuilder
) -> SemanticEffectsResolution {
  semantic_effect_declarations(
    module,
    scope,
    0,
    product,
    semantic_effect_declaration_catalog_empty()
  )
}

fn semantic_effect_layout_resolve_from(
  types: borrow SemanticTypeCatalog,
  targets: List<SemanticTypeId>,
  concrete: SemanticTypeId,
  concrete_substitution: borrow SemanticTypeSubstitution,
  index: usize
) -> SemanticEffectDeclarationMatch {
  match targets {
    Nil -> SemanticEffectDeclarationMissing
    Cons(target, remaining) -> match semantic_type_pattern_match_substituted(
      types,
      target,
      semantic_type_substitution_empty(),
      concrete,
      concrete_substitution
    ) {
      SemanticTypePatternMatched(substitution) ->
        SemanticEffectDeclarationMatched(index, substitution)
      SemanticTypePatternRejected -> semantic_effect_layout_resolve_from(
        types,
        remaining,
        concrete,
        concrete_substitution,
        index + 1
      )
    }
  }
}

pub(package) fn semantic_effect_declaration_catalog_resolve(
  types: borrow SemanticTypeCatalog,
  catalog: borrow SemanticEffectDeclarationCatalog,
  concrete: SemanticTypeId,
  concrete_substitution: borrow SemanticTypeSubstitution
) -> SemanticEffectDeclarationMatch {
  match catalog {
    SemanticEffectDeclarationCatalog(storage) -> semantic_effect_layout_resolve_from(
      types,
      storage.targets,
      concrete,
      concrete_substitution,
      0
    )
  }
}

fn semantic_effect_at<T>(values: List<T>, index: usize) -> Option<T> {
  match values {
    Nil -> None<T>()
    Cons(value, remaining) -> if index == 0 { Some<T>(value) }
    else { semantic_effect_at(remaining, index - 1) }
  }
}

fn semantic_effect_prefix(
  values: List<usize>,
  count: usize,
  total: usize
) -> Option<usize> {
  if count == 0 { Some<usize>(total) }
  else {
    match values {
      Nil -> None<usize>()
      Cons(value, remaining) -> match num_scalar_usize_checked_add(total, value) {
        Some(next) -> semantic_effect_prefix(remaining, count - 1, next)
        None -> None<usize>()
      }
    }
  }
}

fn semantic_effect_operation_ordinal(
  storage: SemanticEffectDeclarationCatalogStorage,
  layout: usize,
  operation: usize
) -> Option<usize> {
  match semantic_effect_prefix(storage.operation_counts, layout, 0) {
    Some(start) -> num_scalar_usize_checked_add(start, operation)
    None -> None<usize>()
  }
}

pub(package) fn semantic_effect_declaration(
  catalog: borrow SemanticEffectDeclarationCatalog,
  layout: usize
) -> Option<DeclarationIdentity> {
  match catalog {
    SemanticEffectDeclarationCatalog(storage) ->
      semantic_effect_at(storage.declarations, layout)
  }
}

pub(package) fn semantic_effect_operation_count(
  catalog: borrow SemanticEffectDeclarationCatalog,
  layout: usize
) -> Option<usize> {
  match catalog {
    SemanticEffectDeclarationCatalog(storage) ->
      semantic_effect_at(storage.operation_counts, layout)
  }
}

pub(package) fn semantic_effect_operation_declaration(
  catalog: borrow SemanticEffectDeclarationCatalog,
  layout: usize,
  operation: usize
) -> Option<DeclarationIdentity> {
  match catalog {
    SemanticEffectDeclarationCatalog(storage) -> match semantic_effect_operation_ordinal(
      storage,
      layout,
      operation
    ) {
      Some(index) -> semantic_effect_at(storage.operation_declarations, index)
      None -> None<DeclarationIdentity>()
    }
  }
}

pub(package) fn semantic_effect_operation_is_deferred(
  catalog: borrow SemanticEffectDeclarationCatalog,
  layout: usize,
  operation: usize
) -> Option<bool> {
  match catalog {
    SemanticEffectDeclarationCatalog(storage) -> match semantic_effect_operation_ordinal(
      storage,
      layout,
      operation
    ) {
      Some(index) -> semantic_effect_at(storage.operation_deferred, index)
      None -> None<bool>()
    }
  }
}

pub(package) fn semantic_effect_operation_parameter_count(
  catalog: borrow SemanticEffectDeclarationCatalog,
  layout: usize,
  operation: usize
) -> Option<usize> {
  match catalog {
    SemanticEffectDeclarationCatalog(storage) -> match semantic_effect_operation_ordinal(
      storage,
      layout,
      operation
    ) {
      Some(index) -> semantic_effect_at(storage.operation_parameter_counts, index)
      None -> None<usize>()
    }
  }
}

pub(package) fn semantic_effect_operation_parameter_type(
  catalog: borrow SemanticEffectDeclarationCatalog,
  layout: usize,
  operation: usize,
  parameter: usize
) -> Option<SemanticTypeId> {
  match catalog {
    SemanticEffectDeclarationCatalog(storage) -> match semantic_effect_operation_ordinal(
      storage,
      layout,
      operation
    ) {
      None -> None<SemanticTypeId>()
      Some(operation_index) -> match semantic_effect_at(
        storage.operation_parameter_counts,
        operation_index
      ) {
        Some(count) -> if parameter >= count { None<SemanticTypeId>() }
        else {
          match semantic_effect_prefix(
            storage.operation_parameter_counts,
            operation_index,
            0
          ) {
            Some(start) -> match num_scalar_usize_checked_add(start, parameter) {
              Some(index) -> semantic_effect_at(
                storage.operation_parameter_types,
                index
              )
              None -> None<SemanticTypeId>()
            }
            None -> None<SemanticTypeId>()
          }
        }
        None -> None<SemanticTypeId>()
      }
    }
  }
}

pub(package) fn semantic_effect_operation_result(
  catalog: borrow SemanticEffectDeclarationCatalog,
  layout: usize,
  operation: usize
) -> Option<SemanticTypeId> {
  match catalog {
    SemanticEffectDeclarationCatalog(storage) -> match semantic_effect_operation_ordinal(
      storage,
      layout,
      operation
    ) {
      Some(index) -> semantic_effect_at(storage.operation_results, index)
      None -> None<SemanticTypeId>()
    }
  }
}
