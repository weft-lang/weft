-- A specialized named-handler operation contract contains no authored syntax.
-- The defining module owns the clause body; the caller supplies the concrete
-- effect atom when the handler is installed.

use compiler/project/identity.{DeclarationIdentity}
use compiler/types/graph.{SemanticTypeId}

pub(package) type SemanticHandlerClauseRequirement {
  operation: DeclarationIdentity,
  atom: SemanticTypeId,
  parameter_count: usize,
  allows_deferred: bool
}
