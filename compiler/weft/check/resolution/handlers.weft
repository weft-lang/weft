-- Semantic templates for module-owned handler implementations.
--
-- Selection happens through a registered module alias. This resolver keeps
-- the implementation's source and type parameters, and turns its effect and
-- constructor annotations into graph identities before an installation is
-- specialized for a caller.

use compiler/ir/data.{
  Expr,
  FieldAccess,
  GenericCall,
  Ident,
  MissingTypeExpr,
  Param,
  ParamList,
  ParamListCons,
  ParamListNil,
  QualifiedEffectTypeExpr,
  TypeExpr,
  TypeExprList,
  TypeExprListNil,
  TypeNameRange,
  TypeParam,
  TypeParamBoundList,
  TypeParamBoundListCons,
  TypeParamBoundListNil,
  TypeParamList,
  TypeParamListCons,
  TypeParamListNil,
  UnqualifiedEffectTypeExpr,
  UnknownParam
}
use compiler/project/identity.{HandlerImplementationIdentity}
use compiler/types/graph.{
  SemanticEffectAtomNode,
  SemanticParameterVariable,
  SemanticTypeId,
  semantic_type_graph_node
}
use compiler/types/graph/conformance.{SemanticConformance}
use compiler/types/graph/substitution.{
  SemanticTypeSubstitution,
  semantic_type_substitution_bind,
  semantic_type_substitution_empty
}
use compiler/types/graph/subtyping.{semantic_type_is_subtype}
use compiler/weft/check/registration/catalog.{RegisteredHandler, RegisteredModule}
use compiler/weft/check/registration/scope.{RegistrationScope}
use compiler/weft/check/semantic_types.{
  SemanticTypeProductBuilder,
  SemanticTypeRejected,
  SemanticTypeResolutionIssue,
  SemanticTypeResolved,
  resolve_type_product_in_scope,
  semantic_type_product_catalog,
  semantic_type_product_substitute
}
use stdlib/list.{Cons, List, Nil}
use stdlib/option.{None, Option, Some}

pub(package) type SemanticHandlerTemplate {
  identity: HandlerImplementationIdentity,
  module: RegisteredModule,
  handler: RegisteredHandler,
  atom: SemanticTypeId,
  constructor_parameters: List<SemanticTypeId>
}

pub(package) type SemanticHandlerTemplateIssue {
  SemanticHandlerEffectReferenceRequired,
  SemanticHandlerEffectTypeRejected(SemanticTypeResolutionIssue),
  SemanticHandlerEffectAtomRequired(SemanticTypeId),
  SemanticHandlerParameterRequired(usize),
  SemanticHandlerParameterTypeRejected(usize, SemanticTypeResolutionIssue)
}

pub(package) type SemanticHandlerTemplateResolution {
  SemanticHandlerTemplateResolved(SemanticTypeProductBuilder, SemanticHandlerTemplate),
  SemanticHandlerTemplateRejected(SemanticTypeProductBuilder, SemanticHandlerTemplateIssue)
}

pub(package) type SemanticHandlerSpecialization {
  identity: HandlerImplementationIdentity,
  atom: SemanticTypeId,
  constructor_parameters: List<SemanticTypeId>
}

pub(package) type SemanticHandlerSpecializationIssue {
  SemanticHandlerTypeArgumentCountMismatch,
  SemanticHandlerTypeVariableInvalid(i64),
  SemanticHandlerBoundTypeRejected(SemanticTypeResolutionIssue),
  SemanticHandlerBoundUnsatisfied(SemanticTypeId, SemanticTypeId)
}

pub(package) type SemanticHandlerSpecializationResult {
  SemanticHandlerSpecialized(SemanticTypeProductBuilder, SemanticHandlerSpecialization),
  SemanticHandlerSpecializationRejected(
    SemanticTypeProductBuilder,
    SemanticHandlerSpecializationIssue
  )
}

type SemanticHandlerBindings {
  SemanticHandlerArgumentsBound(SemanticTypeSubstitution),
  SemanticHandlerArgumentsRejected(SemanticHandlerSpecializationIssue)
}

type SemanticHandlerBounds {
  SemanticHandlerBoundsAccepted(SemanticTypeProductBuilder),
  SemanticHandlerBoundsRejected(
    SemanticTypeProductBuilder,
    SemanticHandlerSpecializationIssue
  )
}

fn handler_effect_type(reference: Expr) -> Option<TypeExpr> {
  match reference {
    Ident(start, length) -> Some<TypeExpr>(
      UnqualifiedEffectTypeExpr(
        0,
        TypeExprListNil,
        TypeNameRange { start: start, length: length }
      )
    )
    GenericCall(arguments, Ident(start, length)) -> Some<TypeExpr>(
      UnqualifiedEffectTypeExpr(
        0,
        arguments,
        TypeNameRange { start: start, length: length }
      )
    )
    FieldAccess(Ident(qualifier_start, qualifier_length), start, length, _) -> Some<TypeExpr>(
      QualifiedEffectTypeExpr(
        TypeNameRange { start: qualifier_start, length: qualifier_length },
        TypeNameRange { start: start, length: length },
        TypeExprListNil
      )
    )
    GenericCall(
      arguments,
      FieldAccess(Ident(qualifier_start, qualifier_length), start, length, _),
    ) -> Some<TypeExpr>(
      QualifiedEffectTypeExpr(
        TypeNameRange { start: qualifier_start, length: qualifier_length },
        TypeNameRange { start: start, length: length },
        arguments
      )
    )
    _ -> None<TypeExpr>()
  }
}

fn handler_parameter_types(
  product: SemanticTypeProductBuilder,
  module: RegisteredModule,
  scope: RegistrationScope,
  handler: RegisteredHandler,
  atom: SemanticTypeId,
  parameters: ParamList,
  index: usize,
  resolved: List<SemanticTypeId>
) -> SemanticHandlerTemplateResolution {
  match parameters {
    ParamListNil -> SemanticHandlerTemplateResolved(
      product,
      SemanticHandlerTemplate {
        identity: handler.identity,
        module: module,
        handler: handler,
        atom: atom,
        constructor_parameters: resolved
      }
    )
    ParamListCons(parameter, remaining) -> match parameter {
      Param(_, _, annotation, _) -> match annotation {
        MissingTypeExpr -> SemanticHandlerTemplateRejected(
          product,
          SemanticHandlerParameterRequired(index)
        )
        _ -> match resolve_type_product_in_scope(
          product,
          module,
          scope,
          handler.syntax.type_params,
          annotation
        ) {
          (product, SemanticTypeRejected(issue)) -> SemanticHandlerTemplateRejected(
            product,
            SemanticHandlerParameterTypeRejected(index, issue)
          )
          (product, SemanticTypeResolved(value)) -> handler_parameter_types(
            product,
            module,
            scope,
            handler,
            atom,
            remaining,
            index + 1,
            resolved.append(value)
          )
        }
      }
      UnknownParam(_) -> SemanticHandlerTemplateRejected(
        product,
        SemanticHandlerParameterRequired(index)
      )
    }
  }
}

pub(package) fn resolve_semantic_handler_template(
  product: SemanticTypeProductBuilder,
  scope: RegistrationScope,
  module: RegisteredModule,
  handler: RegisteredHandler
) -> SemanticHandlerTemplateResolution {
  match handler_effect_type(handler.syntax.effect_reference) {
    None -> SemanticHandlerTemplateRejected(
      product,
      SemanticHandlerEffectReferenceRequired
    )
    Some(reference) -> match resolve_type_product_in_scope(
      product,
      module,
      scope,
      handler.syntax.type_params,
      reference
    ) {
      (product, SemanticTypeRejected(issue)) -> SemanticHandlerTemplateRejected(
        product,
        SemanticHandlerEffectTypeRejected(issue)
      )
      (product, SemanticTypeResolved(atom)) -> {
        let catalog = semantic_type_product_catalog(product)
        match catalog.graph_for(atom) {
          None -> SemanticHandlerTemplateRejected(
            product,
            SemanticHandlerEffectAtomRequired(atom)
          )
          Some(graph) -> match semantic_type_graph_node(graph, atom) {
            SemanticEffectAtomNode(_, _) -> handler_parameter_types(
              product,
              module,
              scope,
              handler,
              atom,
              handler.syntax.params,
              0,
              Nil<SemanticTypeId>()
            )
            _ -> SemanticHandlerTemplateRejected(
              product,
              SemanticHandlerEffectAtomRequired(atom)
            )
          }
        }
      }
    }
  }
}

fn handler_bind_arguments(
  parameters: TypeParamList,
  arguments: List<SemanticTypeId>,
  substitution: SemanticTypeSubstitution
) -> SemanticHandlerBindings {
  match (parameters, arguments) {
    (TypeParamListNil, Nil) -> SemanticHandlerArgumentsBound(substitution)
    (TypeParamListCons(parameter, remaining_parameters), Cons(argument, remaining_arguments)) ->
      match parameter {
        TypeParam(_, _, identity, _) -> if identity < 0 {
          SemanticHandlerArgumentsRejected(SemanticHandlerTypeVariableInvalid(identity))
        } else {
          handler_bind_arguments(
            remaining_parameters,
            remaining_arguments,
            semantic_type_substitution_bind(
              substitution,
              SemanticParameterVariable(__i64_to_usize(identity)),
              argument
            )
          )
        }
        _ -> SemanticHandlerArgumentsRejected(SemanticHandlerTypeArgumentCountMismatch)
      }
    _ -> SemanticHandlerArgumentsRejected(SemanticHandlerTypeArgumentCountMismatch)
  }
}

fn handler_check_bound_list(
  product: SemanticTypeProductBuilder,
  scope: RegistrationScope,
  template: SemanticHandlerTemplate,
  substitution: borrow SemanticTypeSubstitution,
  concrete: SemanticTypeId,
  bounds: TypeParamBoundList
) -[SemanticConformance]> SemanticHandlerBounds {
  match bounds {
    TypeParamBoundListNil -> SemanticHandlerBoundsAccepted(product)
    TypeParamBoundListCons(bound, _, remaining) -> match resolve_type_product_in_scope(
      product,
      template.module,
      scope,
      template.handler.syntax.type_params,
      bound
    ) {
      (product, SemanticTypeRejected(issue)) -> SemanticHandlerBoundsRejected(
        product,
        SemanticHandlerBoundTypeRejected(issue)
      )
      (product, SemanticTypeResolved(trait_template)) -> {
        let (product, trait_atom) = semantic_type_product_substitute(
          product,
          substitution,
          trait_template
        )
        let catalog = semantic_type_product_catalog(product)
        if semantic_type_is_subtype(catalog, concrete, trait_atom) {
          handler_check_bound_list(
            product,
            scope,
            template,
            substitution,
            concrete,
            remaining
          )
        } else {
          SemanticHandlerBoundsRejected(
            product,
            SemanticHandlerBoundUnsatisfied(concrete, trait_atom)
          )
        }
      }
    }
  }
}

fn handler_check_bounds(
  product: SemanticTypeProductBuilder,
  scope: RegistrationScope,
  template: SemanticHandlerTemplate,
  substitution: borrow SemanticTypeSubstitution,
  parameters: TypeParamList,
  arguments: List<SemanticTypeId>
) -[SemanticConformance]> SemanticHandlerBounds {
  match (parameters, arguments) {
    (TypeParamListNil, Nil) -> SemanticHandlerBoundsAccepted(product)
    (TypeParamListCons(parameter, remaining_parameters), Cons(argument, remaining_arguments)) ->
      match parameter {
        TypeParam(_, _, _, bounds) -> match handler_check_bound_list(
          product,
          scope,
          template,
          substitution,
          argument,
          bounds
        ) {
          SemanticHandlerBoundsAccepted(product) -> handler_check_bounds(
            product,
            scope,
            template,
            substitution,
            remaining_parameters,
            remaining_arguments
          )
          SemanticHandlerBoundsRejected(product, issue) -> SemanticHandlerBoundsRejected(
            product,
            issue
          )
        }
        _ -> SemanticHandlerBoundsRejected(
          product,
          SemanticHandlerTypeArgumentCountMismatch
        )
      }
    _ -> SemanticHandlerBoundsRejected(product, SemanticHandlerTypeArgumentCountMismatch)
  }
}

fn handler_specialize_parameters(
  product: SemanticTypeProductBuilder,
  substitution: borrow SemanticTypeSubstitution,
  parameters: List<SemanticTypeId>,
  result: List<SemanticTypeId>
) -> (SemanticTypeProductBuilder, List<SemanticTypeId>) {
  match parameters {
    Nil -> (product, result)
    Cons(parameter, remaining) -> {
      let (product, concrete) = semantic_type_product_substitute(
        product,
        substitution,
        parameter
      )
      handler_specialize_parameters(product, substitution, remaining, result.append(concrete))
    }
  }
}

pub(package) fn specialize_semantic_handler_template(
  product: SemanticTypeProductBuilder,
  scope: RegistrationScope,
  template: SemanticHandlerTemplate,
  arguments: List<SemanticTypeId>
) -[SemanticConformance]> SemanticHandlerSpecializationResult {
  let parameters = template.handler.syntax.type_params
  match handler_bind_arguments(parameters, arguments, semantic_type_substitution_empty()) {
    SemanticHandlerArgumentsRejected(issue) -> SemanticHandlerSpecializationRejected(
      product,
      issue
    )
    SemanticHandlerArgumentsBound(substitution) -> match handler_check_bounds(
      product,
      scope,
      template,
      substitution,
      parameters,
      arguments
    ) {
      SemanticHandlerBoundsRejected(product, issue) -> SemanticHandlerSpecializationRejected(
        product,
        issue
      )
      SemanticHandlerBoundsAccepted(product) -> {
        let (product, atom) = semantic_type_product_substitute(
          product,
          substitution,
          template.atom
        )
        let (product, constructor_parameters) = handler_specialize_parameters(
          product,
          substitution,
          template.constructor_parameters,
          Nil<SemanticTypeId>()
        )
        SemanticHandlerSpecialized(
          product,
          SemanticHandlerSpecialization {
            identity: template.identity,
            atom: atom,
            constructor_parameters: constructor_parameters
          }
        )
      }
    }
  }
}
