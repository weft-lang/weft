-- Semantic templates for module-owned handler implementations.
--
-- Selection happens through a registered module alias. This resolver keeps
-- the implementation's source and type parameters, and turns its effect and
-- constructor annotations into graph identities before an installation is
-- specialized for a caller.

use compiler/ir/data.{
  Expr,
  FieldAccess,
  GenericCall,
  HandlerClause,
  HandlerClauseContinuation,
  HandlerClauseList,
  HandlerClauseListCons,
  HandlerClauseListNil,
  HandlerClauseName,
  HandlerClauseNoContinuation,
  HandlerConfiguration,
  Ident,
  MissingTypeExpr,
  MissingTypeEffectOp,
  Param,
  ParamList,
  ParamListCons,
  ParamListNil,
  QualifiedEffectTypeExpr,
  TypeExpr,
  TypeExprList,
  TypeExprListCons,
  TypeExprListNil,
  TypeEffectOp,
  DeferredTypeEffectOp,
  TypeNameRange,
  TypeParam,
  TypeParamBoundList,
  TypeParamBoundListCons,
  TypeParamBoundListNil,
  TypeParamList,
  TypeParamListCons,
  TypeParamListNil,
  UnqualifiedEffectTypeExpr,
  UnknownHandlerConfiguration,
  UnknownHandlerClause,
  UnknownHandlerClauseContinuation,
  UnknownHandlerClauseName,
  UnknownParam,
  expr_list_len,
  param_list_len
}
use compiler/project/identity.{
  DeclarationIdentity,
  HandlerImplementationIdentity,
  declaration_identity_module,
  declaration_identity_name,
  module_identity_package
}
use compiler/project/identity/equality.{declaration_identity_eq, module_identity_eq}
use compiler/project/module.{PackageVisibility, PublicVisibility}
use compiler/types/graph.{
  SemanticEffectAtomNode,
  SemanticParameterVariable,
  SemanticTypeId,
  semantic_type_graph_node
}
use compiler/types/graph/conformance.{SemanticConformance}
use compiler/types/graph/catalog.{SemanticTypeCatalog}
use compiler/types/graph/substitution.{
  SemanticTypeSubstitution,
  semantic_type_substitution_bind,
  semantic_type_substitution_empty
}
use compiler/types/graph/subtyping.{semantic_type_is_subtype}
use compiler/types/graph/equality.{semantic_type_catalog_equal}
use compiler/weft/check/registration/catalog.{
  RegisteredEffect,
  RegisteredEffectDeclaration,
  RegisteredEffectOperation,
  RegisteredHandler,
  RegisteredModule
}
use compiler/weft/check/registration/handler.{
  RegisteredHandlerSelected,
  RegisteredHandlerSelection,
  registration_scope_select_handler
}
use compiler/weft/check/registration/scope.{RegistrationScope, registration_scope_find}
use compiler/weft/check/resolution/handler_contract.{SemanticHandlerClauseRequirement}
use compiler/weft/check/storage.{dense_index}
use compiler/weft/check/semantic_types.{
  SemanticTypeProductBuilder,
  SemanticTypeRejected,
  SemanticTypeResolutionIssue,
  SemanticTypeResolved,
  resolve_type_product_in_scope,
  semantic_type_product_catalog,
  semantic_type_product_substitute
}
use stdlib/list.{Cons, List, Nil}
use stdlib/option.{None, Option, Some}

pub(package) type SemanticHandlerTemplate {
  identity: HandlerImplementationIdentity,
  module: RegisteredModule,
  handler: RegisteredHandler,
  atom: SemanticTypeId,
  constructor_parameters: List<SemanticTypeId>
}

pub(package) type SemanticHandlerTemplateIssue {
  SemanticHandlerEffectReferenceRequired,
  SemanticHandlerEffectTypeRejected(SemanticTypeResolutionIssue),
  SemanticHandlerEffectAtomRequired(SemanticTypeId),
  SemanticHandlerParameterRequired(usize),
  SemanticHandlerParameterTypeRejected(usize, SemanticTypeResolutionIssue)
}

pub(package) type SemanticHandlerTemplateResolution {
  SemanticHandlerTemplateResolved(SemanticTypeProductBuilder, SemanticHandlerTemplate),
  SemanticHandlerTemplateRejected(SemanticTypeProductBuilder, SemanticHandlerTemplateIssue)
}

pub(package) type SemanticHandlerSpecialization {
  identity: HandlerImplementationIdentity,
  atom: SemanticTypeId,
  constructor_parameters: List<SemanticTypeId>
}

pub(package) type SemanticHandlerSpecializationIssue {
  SemanticHandlerTypeArgumentCountMismatch,
  SemanticHandlerTypeVariableInvalid(i64),
  SemanticHandlerBoundTypeRejected(SemanticTypeResolutionIssue),
  SemanticHandlerBoundUnsatisfied(SemanticTypeId, SemanticTypeId)
}

pub(package) type SemanticHandlerSpecializationResult {
  SemanticHandlerSpecialized(SemanticTypeProductBuilder, SemanticHandlerSpecialization),
  SemanticHandlerSpecializationRejected(
    SemanticTypeProductBuilder,
    SemanticHandlerSpecializationIssue
  )
}

pub(package) type SemanticHandlerConstructorIssue {
  SemanticHandlerConstructorValueCountMismatch(usize, usize),
  SemanticHandlerConstructorValueTypeMismatch(usize, SemanticTypeId, SemanticTypeId)
}

pub(package) type SemanticHandlerConstructorValidation {
  SemanticHandlerConstructorValuesAccepted,
  SemanticHandlerConstructorValuesRejected(SemanticHandlerConstructorIssue)
}

fn validate_semantic_handler_constructor_values(
  catalog: borrow SemanticTypeCatalog,
  parameters: List<SemanticTypeId>,
  values: List<SemanticTypeId>,
  index: usize
) -[SemanticConformance]> SemanticHandlerConstructorValidation {
  match (parameters, values) {
    (Nil, Nil) -> SemanticHandlerConstructorValuesAccepted
    (Cons(expected, rest_parameters), Cons(actual, rest_values)) ->
      if semantic_type_is_subtype(catalog, actual, expected) {
        validate_semantic_handler_constructor_values(
          catalog,
          rest_parameters,
          rest_values,
          index + 1
        )
      } else {
        SemanticHandlerConstructorValuesRejected(
          SemanticHandlerConstructorValueTypeMismatch(index, expected, actual)
        )
      }
    _ -> SemanticHandlerConstructorValuesRejected(
      SemanticHandlerConstructorValueCountMismatch(parameters.len(), values.len())
    )
  }
}

-- Constructor expressions are checked in the caller's environment. Their
-- resulting types must satisfy the implementation's specialized parameters.
pub(package) fn validate_semantic_handler_constructor(
  catalog: borrow SemanticTypeCatalog,
  specialization: SemanticHandlerSpecialization,
  values: List<SemanticTypeId>
) -[SemanticConformance]> SemanticHandlerConstructorValidation {
  let parameters = specialization.constructor_parameters
  if parameters.len() != values.len() {
    SemanticHandlerConstructorValuesRejected(
      SemanticHandlerConstructorValueCountMismatch(parameters.len(), values.len())
    )
  } else {
    validate_semantic_handler_constructor_values(catalog, parameters, values, 0)
  }
}

pub(package) type SemanticHandlerCallIssue {
  SemanticHandlerConfigurationRequired,
  SemanticHandlerAliasRangeInvalid,
  SemanticHandlerSelectionRejected(RegisteredHandlerSelection),
  SemanticHandlerCallTemplateRejected(SemanticHandlerTemplateIssue),
  SemanticHandlerCallContractRejected(SemanticHandlerContractIssue),
  SemanticHandlerTypeArgumentRejected(usize, SemanticTypeResolutionIssue),
  SemanticHandlerCallSpecializationRejected(SemanticHandlerSpecializationIssue),
  SemanticHandlerConstructorArityMismatch(usize, usize)
}

pub(package) type SemanticHandlerCallResolution {
  SemanticHandlerCallResolved(
    SemanticTypeProductBuilder,
    SemanticHandlerTemplate,
    SemanticHandlerSpecialization,
    List<SemanticTypeId>,
    List<SemanticHandlerClauseContract>
  ),
  SemanticHandlerCallRejected(SemanticTypeProductBuilder, SemanticHandlerCallIssue)
}

pub(package) type SemanticHandlerClauseContract {
  operation: DeclarationIdentity,
  parameter_count: usize,
  allows_deferred: bool,
  syntax: HandlerClause
}

pub(package) fn semantic_handler_clause_requirements(
  specialization: SemanticHandlerSpecialization,
  clauses: List<SemanticHandlerClauseContract>
) -> List<SemanticHandlerClauseRequirement> {
  match clauses {
    Nil -> Nil<SemanticHandlerClauseRequirement>()
    Cons(clause, rest) -> Cons<SemanticHandlerClauseRequirement>(
      SemanticHandlerClauseRequirement {
        operation: clause.operation,
        atom: specialization.atom,
        parameter_count: clause.parameter_count,
        allows_deferred: clause.allows_deferred
      },
      semantic_handler_clause_requirements(specialization, rest)
    )
  }
}

pub(package) type SemanticHandlerContractIssue {
  SemanticHandlerTargetDeclarationMissing,
  SemanticHandlerOperationInvisible(DeclarationIdentity),
  SemanticHandlerClauseSyntaxInvalid,
  SemanticHandlerClauseRangeInvalid,
  SemanticHandlerClauseEffectRejected(SemanticTypeResolutionIssue),
  SemanticHandlerClauseAtomMismatch(SemanticTypeId),
  SemanticHandlerClauseOperationMissing(str),
  SemanticHandlerClauseArityMismatch(DeclarationIdentity, usize, usize),
  SemanticHandlerClauseContinuationMismatch(DeclarationIdentity),
  SemanticHandlerClauseDuplicate(DeclarationIdentity),
  SemanticHandlerClauseMissing(DeclarationIdentity)
}

pub(package) type SemanticHandlerContractResult {
  SemanticHandlerContractResolved(
    SemanticTypeProductBuilder,
    SemanticHandlerTemplate,
    List<SemanticHandlerClauseContract>
  ),
  SemanticHandlerContractRejected(
    SemanticTypeProductBuilder,
    SemanticHandlerContractIssue
  )
}

type HandlerOperationSignature {
  HandlerOperationSignature(usize, bool),
  HandlerOperationInvalid
}

type SemanticHandlerCallArguments {
  SemanticHandlerCallArgumentsResolved(SemanticTypeProductBuilder, List<SemanticTypeId>),
  SemanticHandlerCallArgumentsRejected(
    SemanticTypeProductBuilder,
    usize,
    SemanticTypeResolutionIssue
  )
}

type SemanticHandlerBindings {
  SemanticHandlerArgumentsBound(SemanticTypeSubstitution),
  SemanticHandlerArgumentsRejected(SemanticHandlerSpecializationIssue)
}

type SemanticHandlerBounds {
  SemanticHandlerBoundsAccepted(SemanticTypeProductBuilder),
  SemanticHandlerBoundsRejected(
    SemanticTypeProductBuilder,
    SemanticHandlerSpecializationIssue
  )
}

fn handler_effect_type(reference: Expr) -> Option<TypeExpr> {
  match reference {
    Ident(start, length) -> Some<TypeExpr>(
      UnqualifiedEffectTypeExpr(
        0,
        TypeExprListNil,
        TypeNameRange { start: start, length: length }
      )
    )
    GenericCall(arguments, Ident(start, length)) -> Some<TypeExpr>(
      UnqualifiedEffectTypeExpr(
        0,
        arguments,
        TypeNameRange { start: start, length: length }
      )
    )
    FieldAccess(Ident(qualifier_start, qualifier_length), start, length, _) -> Some<TypeExpr>(
      QualifiedEffectTypeExpr(
        TypeNameRange { start: qualifier_start, length: qualifier_length },
        TypeNameRange { start: start, length: length },
        TypeExprListNil
      )
    )
    GenericCall(
      arguments,
      FieldAccess(Ident(qualifier_start, qualifier_length), start, length, _),
    ) -> Some<TypeExpr>(
      QualifiedEffectTypeExpr(
        TypeNameRange { start: qualifier_start, length: qualifier_length },
        TypeNameRange { start: start, length: length },
        arguments
      )
    )
    _ -> None<TypeExpr>()
  }
}

fn handler_parameter_types(
  product: SemanticTypeProductBuilder,
  module: RegisteredModule,
  scope: RegistrationScope,
  handler: RegisteredHandler,
  atom: SemanticTypeId,
  parameters: ParamList,
  index: usize,
  resolved: List<SemanticTypeId>
) -> SemanticHandlerTemplateResolution {
  match parameters {
    ParamListNil -> SemanticHandlerTemplateResolved(
      product,
      SemanticHandlerTemplate {
        identity: handler.identity,
        module: module,
        handler: handler,
        atom: atom,
        constructor_parameters: resolved
      }
    )
    ParamListCons(parameter, remaining) -> match parameter {
      Param(_, _, annotation, _) -> match annotation {
        MissingTypeExpr -> SemanticHandlerTemplateRejected(
          product,
          SemanticHandlerParameterRequired(index)
        )
        _ -> match resolve_type_product_in_scope(
          product,
          module,
          scope,
          handler.syntax.type_params,
          annotation
        ) {
          (product, SemanticTypeRejected(issue)) -> SemanticHandlerTemplateRejected(
            product,
            SemanticHandlerParameterTypeRejected(index, issue)
          )
          (product, SemanticTypeResolved(value)) -> handler_parameter_types(
            product,
            module,
            scope,
            handler,
            atom,
            remaining,
            index + 1,
            resolved.append(value)
          )
        }
      }
      UnknownParam(_) -> SemanticHandlerTemplateRejected(
        product,
        SemanticHandlerParameterRequired(index)
      )
    }
  }
}

pub(package) fn resolve_semantic_handler_template(
  product: SemanticTypeProductBuilder,
  scope: RegistrationScope,
  module: RegisteredModule,
  handler: RegisteredHandler
) -> SemanticHandlerTemplateResolution {
  match handler_effect_type(handler.syntax.effect_reference) {
    None -> SemanticHandlerTemplateRejected(
      product,
      SemanticHandlerEffectReferenceRequired
    )
    Some(reference) -> match resolve_type_product_in_scope(
      product,
      module,
      scope,
      handler.syntax.type_params,
      reference
    ) {
      (product, SemanticTypeRejected(issue)) -> SemanticHandlerTemplateRejected(
        product,
        SemanticHandlerEffectTypeRejected(issue)
      )
      (product, SemanticTypeResolved(atom)) -> {
        let catalog = semantic_type_product_catalog(product)
        match catalog.graph_for(atom) {
          None -> SemanticHandlerTemplateRejected(
            product,
            SemanticHandlerEffectAtomRequired(atom)
          )
          Some(graph) -> match semantic_type_graph_node(graph, atom) {
            SemanticEffectAtomNode(_, _) -> handler_parameter_types(
              product,
              module,
              scope,
              handler,
              atom,
              handler.syntax.params,
              0,
              Nil<SemanticTypeId>()
            )
            _ -> SemanticHandlerTemplateRejected(
              product,
              SemanticHandlerEffectAtomRequired(atom)
            )
          }
        }
      }
    }
  }
}

fn handler_bind_arguments(
  parameters: TypeParamList,
  arguments: List<SemanticTypeId>,
  substitution: SemanticTypeSubstitution
) -> SemanticHandlerBindings {
  match (parameters, arguments) {
    (TypeParamListNil, Nil) -> SemanticHandlerArgumentsBound(substitution)
    (TypeParamListCons(parameter, remaining_parameters), Cons(argument, remaining_arguments)) ->
      match parameter {
        TypeParam(_, _, identity, _) -> if identity < 0 {
          SemanticHandlerArgumentsRejected(SemanticHandlerTypeVariableInvalid(identity))
        } else {
          handler_bind_arguments(
            remaining_parameters,
            remaining_arguments,
            semantic_type_substitution_bind(
              substitution,
              SemanticParameterVariable(__i64_to_usize(identity)),
              argument
            )
          )
        }
        _ -> SemanticHandlerArgumentsRejected(SemanticHandlerTypeArgumentCountMismatch)
      }
    _ -> SemanticHandlerArgumentsRejected(SemanticHandlerTypeArgumentCountMismatch)
  }
}

fn handler_check_bound_list(
  product: SemanticTypeProductBuilder,
  scope: RegistrationScope,
  template: SemanticHandlerTemplate,
  substitution: borrow SemanticTypeSubstitution,
  concrete: SemanticTypeId,
  bounds: TypeParamBoundList
) -[SemanticConformance]> SemanticHandlerBounds {
  match bounds {
    TypeParamBoundListNil -> SemanticHandlerBoundsAccepted(product)
    TypeParamBoundListCons(bound, _, remaining) -> match resolve_type_product_in_scope(
      product,
      template.module,
      scope,
      template.handler.syntax.type_params,
      bound
    ) {
      (product, SemanticTypeRejected(issue)) -> SemanticHandlerBoundsRejected(
        product,
        SemanticHandlerBoundTypeRejected(issue)
      )
      (product, SemanticTypeResolved(trait_template)) -> {
        let (product, trait_atom) = semantic_type_product_substitute(
          product,
          substitution,
          trait_template
        )
        let catalog = semantic_type_product_catalog(product)
        if semantic_type_is_subtype(catalog, concrete, trait_atom) {
          handler_check_bound_list(
            product,
            scope,
            template,
            substitution,
            concrete,
            remaining
          )
        } else {
          SemanticHandlerBoundsRejected(
            product,
            SemanticHandlerBoundUnsatisfied(concrete, trait_atom)
          )
        }
      }
    }
  }
}

fn handler_check_bounds(
  product: SemanticTypeProductBuilder,
  scope: RegistrationScope,
  template: SemanticHandlerTemplate,
  substitution: borrow SemanticTypeSubstitution,
  parameters: TypeParamList,
  arguments: List<SemanticTypeId>
) -[SemanticConformance]> SemanticHandlerBounds {
  match (parameters, arguments) {
    (TypeParamListNil, Nil) -> SemanticHandlerBoundsAccepted(product)
    (TypeParamListCons(parameter, remaining_parameters), Cons(argument, remaining_arguments)) ->
      match parameter {
        TypeParam(_, _, _, bounds) -> match handler_check_bound_list(
          product,
          scope,
          template,
          substitution,
          argument,
          bounds
        ) {
          SemanticHandlerBoundsAccepted(product) -> handler_check_bounds(
            product,
            scope,
            template,
            substitution,
            remaining_parameters,
            remaining_arguments
          )
          SemanticHandlerBoundsRejected(product, issue) -> SemanticHandlerBoundsRejected(
            product,
            issue
          )
        }
        _ -> SemanticHandlerBoundsRejected(
          product,
          SemanticHandlerTypeArgumentCountMismatch
        )
      }
    _ -> SemanticHandlerBoundsRejected(product, SemanticHandlerTypeArgumentCountMismatch)
  }
}

fn handler_specialize_parameters(
  product: SemanticTypeProductBuilder,
  substitution: borrow SemanticTypeSubstitution,
  parameters: List<SemanticTypeId>,
  result: List<SemanticTypeId>
) -> (SemanticTypeProductBuilder, List<SemanticTypeId>) {
  match parameters {
    Nil -> (product, result)
    Cons(parameter, remaining) -> {
      let (product, concrete) = semantic_type_product_substitute(
        product,
        substitution,
        parameter
      )
      handler_specialize_parameters(product, substitution, remaining, result.append(concrete))
    }
  }
}

pub(package) fn specialize_semantic_handler_template(
  product: SemanticTypeProductBuilder,
  scope: RegistrationScope,
  template: SemanticHandlerTemplate,
  arguments: List<SemanticTypeId>
) -[SemanticConformance]> SemanticHandlerSpecializationResult {
  let parameters = template.handler.syntax.type_params
  match handler_bind_arguments(parameters, arguments, semantic_type_substitution_empty()) {
    SemanticHandlerArgumentsRejected(issue) -> SemanticHandlerSpecializationRejected(
      product,
      issue
    )
    SemanticHandlerArgumentsBound(substitution) -> match handler_check_bounds(
      product,
      scope,
      template,
      substitution,
      parameters,
      arguments
    ) {
      SemanticHandlerBoundsRejected(product, issue) -> SemanticHandlerSpecializationRejected(
        product,
        issue
      )
      SemanticHandlerBoundsAccepted(product) -> {
        let (product, atom) = semantic_type_product_substitute(
          product,
          substitution,
          template.atom
        )
        let (product, constructor_parameters) = handler_specialize_parameters(
          product,
          substitution,
          template.constructor_parameters,
          Nil<SemanticTypeId>()
        )
        SemanticHandlerSpecialized(
          product,
          SemanticHandlerSpecialization {
            identity: template.identity,
            atom: atom,
            constructor_parameters: constructor_parameters
          }
        )
      }
    }
  }
}

fn handler_call_type_arguments(
  product: SemanticTypeProductBuilder,
  caller: RegisteredModule,
  scope: RegistrationScope,
  parameters: TypeParamList,
  authored: TypeExprList,
  index: usize,
  resolved: List<SemanticTypeId>
) -> SemanticHandlerCallArguments {
  match authored {
    TypeExprListNil -> SemanticHandlerCallArgumentsResolved(product, resolved)
    TypeExprListCons(argument, rest, _) -> match resolve_type_product_in_scope(
      product,
      caller,
      scope,
      parameters,
      argument
    ) {
      (product, SemanticTypeRejected(issue)) -> SemanticHandlerCallArgumentsRejected(
        product,
        index,
        issue
      )
      (product, SemanticTypeResolved(value)) -> handler_call_type_arguments(
        product,
        caller,
        scope,
        parameters,
        rest,
        index + 1,
        resolved.append(value)
      )
    }
  }
}

-- Resolve the complete type-level part of one authored `with module<T>(...)`
-- site. Constructor expressions and implementation clauses are checked by the
-- body/product stages; neither can be replaced by a legacy installation fact.
pub(package) fn resolve_semantic_handler_call(
  product: SemanticTypeProductBuilder,
  scope: RegistrationScope,
  caller: RegisteredModule,
  parameters: TypeParamList,
  configuration: HandlerConfiguration
) -[SemanticConformance]> SemanticHandlerCallResolution {
  match configuration {
    UnknownHandlerConfiguration -> SemanticHandlerCallRejected(
      product,
      SemanticHandlerConfigurationRequired
    )
    HandlerConfiguration(start, length, authored_types, constructor_arguments) -> {
      if start < 0 or length <= 0 {
        return SemanticHandlerCallRejected(product, SemanticHandlerAliasRangeInvalid)
      }
      match caller.source.span(
        __i64_to_usize(start),
        __i64_to_usize(start + length)
      ) {
        None -> SemanticHandlerCallRejected(product, SemanticHandlerAliasRangeInvalid)
        Some(alias) -> match registration_scope_select_handler(
          scope,
          caller.identity,
          alias
        ) {
          RegisteredHandlerSelected(module, handler) -> match resolve_semantic_handler_template(
            product,
            scope,
            module,
            handler
          ) {
            SemanticHandlerTemplateRejected(product, issue) -> SemanticHandlerCallRejected(
              product,
              SemanticHandlerCallTemplateRejected(issue)
            )
            SemanticHandlerTemplateResolved(product, template) ->
              match resolve_semantic_handler_contract(product, scope, template) {
                SemanticHandlerContractRejected(product, issue) ->
                  SemanticHandlerCallRejected(product, SemanticHandlerCallContractRejected(issue))
                SemanticHandlerContractResolved(product, template, clauses) ->
                  match handler_call_type_arguments(
                    product,
                    caller,
                    scope,
                    parameters,
                    authored_types,
                    0,
                    Nil<SemanticTypeId>()
                  ) {
                    SemanticHandlerCallArgumentsRejected(product, index, issue) ->
                      SemanticHandlerCallRejected(
                        product,
                        SemanticHandlerTypeArgumentRejected(index, issue)
                      )
                    SemanticHandlerCallArgumentsResolved(product, arguments) ->
                      match specialize_semantic_handler_template(
                        product,
                        scope,
                        template,
                        arguments
                      ) {
                        SemanticHandlerSpecializationRejected(product, issue) ->
                          SemanticHandlerCallRejected(
                            product,
                            SemanticHandlerCallSpecializationRejected(issue)
                          )
                        SemanticHandlerSpecialized(product, specialization) -> {
                          let expected = specialization.constructor_parameters.len()
                          let actual = __i64_to_usize(expr_list_len(constructor_arguments))
                          if actual != expected {
                            SemanticHandlerCallRejected(
                              product,
                              SemanticHandlerConstructorArityMismatch(expected, actual)
                            )
                          } else {
                            SemanticHandlerCallResolved(
                              product,
                              template,
                              specialization,
                              arguments,
                              clauses
                            )
                          }
                        }
                      }
                  }
              }
          }
          rejected -> SemanticHandlerCallRejected(
            product,
            SemanticHandlerSelectionRejected(rejected)
          )
        }
      }
    }
  }
}

fn handler_target_effect(
  scope: RegistrationScope,
  atom: SemanticTypeId,
  product: SemanticTypeProductBuilder
) -> Option<(RegisteredModule, RegisteredEffect)> {
  let catalog = semantic_type_product_catalog(product)
  match catalog.graph_for(atom) {
    None -> None<(RegisteredModule, RegisteredEffect)>()
    Some(graph) -> match semantic_type_graph_node(graph, atom) {
      SemanticEffectAtomNode(declaration, _) -> match registration_scope_find(
        scope,
        declaration_identity_module(declaration)
      ) {
        None -> None<(RegisteredModule, RegisteredEffect)>()
        Some(module) -> {
          let declarations = module.declarations
          let mut index: usize = 0
          while index < declarations.len() {
            let candidate = declarations.at(dense_index(index))
            match candidate.kind {
              RegisteredEffectDeclaration(target_effect) -> if declaration_identity_eq(
                target_effect.name.identity,
                declaration
              ) {
                return Some<(RegisteredModule, RegisteredEffect)>((module, target_effect))
              }
              _ -> nil
            }
            index = index + 1
          }
          None<(RegisteredModule, RegisteredEffect)>()
        }
      }
      _ -> None<(RegisteredModule, RegisteredEffect)>()
    }
  }
}

fn handler_contract_operation_visible(
  operation: RegisteredEffectOperation,
  owner: RegisteredModule,
  handler: RegisteredModule
) -> bool {
  if module_identity_eq(owner.identity, handler.identity) { true }
  else {
    match operation.name.visibility {
      PublicVisibility -> true
      PackageVisibility -> module_identity_package(owner.identity) ==
        module_identity_package(handler.identity)
      _ -> false
    }
  }
}

fn handler_contract_hidden_operation(
  operations: List<RegisteredEffectOperation>,
  owner: RegisteredModule,
  handler: RegisteredModule
) -> Option<DeclarationIdentity> {
  match operations {
    Nil -> None<DeclarationIdentity>()
    Cons(operation, rest) -> if handler_contract_operation_visible(operation, owner, handler) {
      handler_contract_hidden_operation(rest, owner, handler)
    } else { Some<DeclarationIdentity>(operation.name.identity) }
  }
}

fn handler_contract_find_operation(
  operations: List<RegisteredEffectOperation>,
  name: str
) -> Option<RegisteredEffectOperation> {
  match operations {
    Nil -> None<RegisteredEffectOperation>()
    Cons(operation, rest) -> if match declaration_identity_name(operation.name.identity).text() {
      Some(found) -> found == name
      None -> false
    } {
      Some<RegisteredEffectOperation>(operation)
    } else { handler_contract_find_operation(rest, name) }
  }
}

fn handler_contract_operation_signature(
  operation: RegisteredEffectOperation
) -> HandlerOperationSignature {
  match operation.syntax {
    TypeEffectOp(_, _, parameters, _) ->
      HandlerOperationSignature(__i64_to_usize(param_list_len(parameters)), false)
    DeferredTypeEffectOp(_, _, parameters, _) ->
      HandlerOperationSignature(__i64_to_usize(param_list_len(parameters)), true)
    MissingTypeEffectOp -> HandlerOperationInvalid
  }
}

fn handler_contract_seen(
  seen: List<DeclarationIdentity>,
  operation: DeclarationIdentity
) -> bool {
  match seen {
    Nil -> false
    Cons(candidate, rest) -> if declaration_identity_eq(candidate, operation) { true }
    else { handler_contract_seen(rest, operation) }
  }
}

fn handler_contract_missing_operation(
  operations: List<RegisteredEffectOperation>,
  seen: List<DeclarationIdentity>
) -> Option<DeclarationIdentity> {
  match operations {
    Nil -> None<DeclarationIdentity>()
    Cons(operation, rest) -> if handler_contract_seen(seen, operation.name.identity) {
      handler_contract_missing_operation(rest, seen)
    } else { Some<DeclarationIdentity>(operation.name.identity) }
  }
}

fn handler_contract_clauses(
  product: SemanticTypeProductBuilder,
  scope: RegistrationScope,
  template: SemanticHandlerTemplate,
  target_effect: RegisteredEffect,
  clauses: HandlerClauseList,
  seen: List<DeclarationIdentity>,
  selected: List<SemanticHandlerClauseContract>
) -> SemanticHandlerContractResult {
  match clauses {
    HandlerClauseListNil -> match handler_contract_missing_operation(
      target_effect.operations,
      seen
    ) {
      Some(operation) -> SemanticHandlerContractRejected(
        product,
        SemanticHandlerClauseMissing(operation)
      )
      None -> SemanticHandlerContractResolved(product, template, selected)
    }
    HandlerClauseListCons(clause, rest) -> match clause {
      UnknownHandlerClause(_) -> SemanticHandlerContractRejected(
        product,
        SemanticHandlerClauseSyntaxInvalid
      )
      HandlerClause(name, parameters, _, continuation) -> match name {
        UnknownHandlerClauseName -> SemanticHandlerContractRejected(
          product,
          SemanticHandlerClauseSyntaxInvalid
        )
        HandlerClauseName(reference, start, length) -> {
          if start < 0 or length <= 0 {
            return SemanticHandlerContractRejected(
              product,
              SemanticHandlerClauseRangeInvalid
            )
          }
          match template.module.source.span(
            __i64_to_usize(start),
            __i64_to_usize(start + length)
          ) {
            None -> SemanticHandlerContractRejected(
              product,
              SemanticHandlerClauseRangeInvalid
            )
            Some(span) -> match (span.text(), handler_effect_type(reference)) {
              (Some(operation_name), Some(effect_type)) ->
                match resolve_type_product_in_scope(
                  product,
                  template.module,
                  scope,
                  template.handler.syntax.type_params,
                  effect_type
                ) {
                  (product, SemanticTypeRejected(issue)) -> SemanticHandlerContractRejected(
                    product,
                    SemanticHandlerClauseEffectRejected(issue)
                  )
                  (product, SemanticTypeResolved(atom)) -> {
                    let catalog = semantic_type_product_catalog(product)
                    if not semantic_type_catalog_equal(catalog, atom, template.atom) {
                      SemanticHandlerContractRejected(
                        product,
                        SemanticHandlerClauseAtomMismatch(atom)
                      )
                    } else {
                      match handler_contract_find_operation(
                        target_effect.operations,
                        operation_name
                      ) {
                        None -> SemanticHandlerContractRejected(
                          product,
                          SemanticHandlerClauseOperationMissing(operation_name)
                        )
                        Some(operation) -> {
                          let identity = operation.name.identity
                          if handler_contract_seen(seen, identity) {
                            return SemanticHandlerContractRejected(
                              product,
                              SemanticHandlerClauseDuplicate(identity)
                            )
                          }
                          match handler_contract_operation_signature(operation) {
                            HandlerOperationInvalid -> SemanticHandlerContractRejected(
                              product,
                              SemanticHandlerClauseSyntaxInvalid
                            )
                            HandlerOperationSignature(expected, deferred) -> {
                              let actual = __i64_to_usize(param_list_len(parameters))
                              if actual != expected {
                                return SemanticHandlerContractRejected(
                                  product,
                                  SemanticHandlerClauseArityMismatch(identity, expected, actual)
                                )
                              }
                              let valid_continuation = match continuation {
                                HandlerClauseNoContinuation -> true
                                HandlerClauseContinuation(_, _) -> deferred
                                UnknownHandlerClauseContinuation -> false
                              }
                              if not valid_continuation {
                                SemanticHandlerContractRejected(
                                  product,
                                  SemanticHandlerClauseContinuationMismatch(identity)
                                )
                              } else {
                                handler_contract_clauses(
                                  product,
                                  scope,
                                  template,
                                  target_effect,
                                  rest,
                                  Cons<DeclarationIdentity>(identity, seen),
                                  selected.append(
                                    SemanticHandlerClauseContract {
                                      operation: identity,
                                      parameter_count: expected,
                                      allows_deferred: deferred,
                                      syntax: clause
                                    }
                                  )
                                )
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              _ -> SemanticHandlerContractRejected(
                product,
                SemanticHandlerClauseSyntaxInvalid
              )
            }
          }
        }
      }
    }
  }
}

-- Validate the package-owned implementation independently of any call site's
-- result type. Clause bodies are checked later against that contextual result.
pub(package) fn resolve_semantic_handler_contract(
  product: SemanticTypeProductBuilder,
  scope: RegistrationScope,
  template: SemanticHandlerTemplate
) -> SemanticHandlerContractResult {
  match handler_target_effect(scope, template.atom, product) {
    None -> SemanticHandlerContractRejected(product, SemanticHandlerTargetDeclarationMissing)
    Some((owner, target_effect)) -> match handler_contract_hidden_operation(
      target_effect.operations,
      owner,
      template.module
    ) {
      Some(operation) -> SemanticHandlerContractRejected(
        product,
        SemanticHandlerOperationInvisible(operation)
      )
      None -> handler_contract_clauses(
        product,
        scope,
        template,
        target_effect,
        template.handler.syntax.clauses,
        Nil<DeclarationIdentity>(),
        Nil<SemanticHandlerClauseContract>()
      )
    }
  }
}
