-- Concrete declaration applications resolved before body checking.
--
-- Record and effect layouts retain generic member templates. This product
-- walks the semantic types reachable from function signatures, applies each
-- concrete substitution once, and recursively follows the resulting member
-- types. Checked expressions therefore consume immutable complete catalogs
-- rather than extending type storage while companion graphs are being built.

use compiler/project/identity.{
  DeclarationIdentity,
  declaration_identity_name
}
use compiler/types/graph.{*}
use compiler/types/graph/catalog.{SemanticTypeCatalog}
use compiler/types/graph/declarations.{
  SemanticRecordDeclarationLayoutMatched,
  SemanticTypeDeclarationCatalog,
  semantic_type_declaration_catalog_resolve,
  semantic_type_declared_record_field_count,
  semantic_type_declared_record_field_declaration,
  semantic_type_declared_record_field_type
}
use compiler/types/graph/equality.{semantic_type_catalog_equal}
use compiler/types/graph/substitution.{
  SemanticTypeSubstitution,
  semantic_type_substitution_empty
}
use compiler/weft/check/resolution/effects.{
  SemanticEffectDeclarationCatalog,
  SemanticEffectDeclarationMatched,
  semantic_effect_declaration,
  semantic_effect_declaration_catalog_resolve,
  semantic_effect_operation_count,
  semantic_effect_operation_declaration,
  semantic_effect_operation_is_deferred,
  semantic_effect_operation_parameter_count,
  semantic_effect_operation_parameter_type,
  semantic_effect_operation_result
}
use compiler/weft/check/semantic_types.{
  SemanticTypeProductBuilder,
  semantic_type_product_catalog,
  semantic_type_product_substitute
}
use compiler/weft/check/signatures.{SemanticSignatureProduct}
use stdlib/list.{Cons, List, Nil}
use stdlib/num/scalar.{num_scalar_usize_checked_add}
use stdlib/option.{None, Option, Some}
use stdlib/panic.{panic}

type SemanticRecordApplicationCatalogStorage {
  targets: List<SemanticTypeId>,
  field_counts: List<usize>,
  declarations: List<DeclarationIdentity>,
  types: List<SemanticTypeId>
}

pub(package) type SemanticRecordApplicationCatalog = opaque SemanticRecordApplicationCatalogStorage

type SemanticEffectApplicationCatalogStorage {
  targets: List<SemanticTypeId>,
  declarations: List<DeclarationIdentity>,
  operation_counts: List<usize>,
  operation_declarations: List<DeclarationIdentity>,
  operation_deferred: List<bool>,
  operation_parameter_counts: List<usize>,
  operation_parameter_types: List<SemanticTypeId>,
  operation_results: List<SemanticTypeId>
}

pub(package) type SemanticEffectApplicationCatalog = opaque SemanticEffectApplicationCatalogStorage

pub(package) type SemanticDeclaredFieldProjection {
  SemanticDeclaredFieldProjected(DeclarationIdentity, usize, SemanticTypeId),
  SemanticDeclaredFieldMissing,
  SemanticDeclaredFieldProjectionUnavailable
}

pub(package) type SemanticEffectOperationProjection {
  SemanticEffectOperationProjected(
    SemanticTypeId,
    DeclarationIdentity,
    DeclarationIdentity,
    bool,
    usize,
    SemanticTypeId
  ),
  SemanticEffectOperationMissing,
  SemanticEffectApplicationUnavailable
}

type SemanticApplicationBuild {
  product: SemanticTypeProductBuilder,
  records: SemanticRecordApplicationCatalog,
  effects: SemanticEffectApplicationCatalog,
  visited: List<SemanticTypeId>
}

type SemanticApplicationFields {
  build: SemanticApplicationBuild,
  declarations: List<DeclarationIdentity>,
  types: List<SemanticTypeId>
}

type SemanticApplicationOperationFields {
  build: SemanticApplicationBuild,
  declarations: List<DeclarationIdentity>,
  deferred: List<bool>,
  parameter_counts: List<usize>,
  parameter_types: List<SemanticTypeId>,
  results: List<SemanticTypeId>
}

fn semantic_record_applications_empty() -> SemanticRecordApplicationCatalog {
  SemanticRecordApplicationCatalog(
    SemanticRecordApplicationCatalogStorage {
      targets: Nil<SemanticTypeId>(),
      field_counts: Nil<usize>(),
      declarations: Nil<DeclarationIdentity>(),
      types: Nil<SemanticTypeId>()
    }
  )
}

fn semantic_effect_applications_empty() -> SemanticEffectApplicationCatalog {
  SemanticEffectApplicationCatalog(
    SemanticEffectApplicationCatalogStorage {
      targets: Nil<SemanticTypeId>(),
      declarations: Nil<DeclarationIdentity>(),
      operation_counts: Nil<usize>(),
      operation_declarations: Nil<DeclarationIdentity>(),
      operation_deferred: Nil<bool>(),
      operation_parameter_counts: Nil<usize>(),
      operation_parameter_types: Nil<SemanticTypeId>(),
      operation_results: Nil<SemanticTypeId>()
    }
  )
}

fn semantic_application_declarations_prepend(
  values: List<DeclarationIdentity>,
  suffix: List<DeclarationIdentity>
) -> List<DeclarationIdentity> {
  match values {
    Nil -> suffix
    Cons(value, remaining) -> Cons<DeclarationIdentity>(
      value,
      semantic_application_declarations_prepend(remaining, suffix)
    )
  }
}

fn semantic_application_types_prepend(
  values: List<SemanticTypeId>,
  suffix: List<SemanticTypeId>
) -> List<SemanticTypeId> {
  match values {
    Nil -> suffix
    Cons(value, remaining) -> Cons<SemanticTypeId>(
      value,
      semantic_application_types_prepend(remaining, suffix)
    )
  }
}

fn semantic_application_bools_prepend(
  values: List<bool>,
  suffix: List<bool>
) -> List<bool> {
  match values {
    Nil -> suffix
    Cons(value, remaining) -> Cons<bool>(
      value,
      semantic_application_bools_prepend(remaining, suffix)
    )
  }
}

fn semantic_application_usizes_prepend(
  values: List<usize>,
  suffix: List<usize>
) -> List<usize> {
  match values {
    Nil -> suffix
    Cons(value, remaining) -> Cons<usize>(
      value,
      semantic_application_usizes_prepend(remaining, suffix)
    )
  }
}

fn semantic_record_applications_add(
  applications: SemanticRecordApplicationCatalog,
  target: SemanticTypeId,
  declarations: List<DeclarationIdentity>,
  types: List<SemanticTypeId>
) -> SemanticRecordApplicationCatalog {
  match applications {
    SemanticRecordApplicationCatalog(storage) ->
      SemanticRecordApplicationCatalog(
        SemanticRecordApplicationCatalogStorage {
          targets: storage.targets.prepend(target),
          field_counts: storage.field_counts.prepend(declarations.len()),
          declarations: semantic_application_declarations_prepend(
            declarations,
            storage.declarations
          ),
          types: semantic_application_types_prepend(types, storage.types)
        }
      )
  }
}

fn semantic_effect_applications_add(
  applications: SemanticEffectApplicationCatalog,
  target: SemanticTypeId,
  declaration: DeclarationIdentity,
  operation_declarations: List<DeclarationIdentity>,
  operation_deferred: List<bool>,
  operation_parameter_counts: List<usize>,
  operation_parameter_types: List<SemanticTypeId>,
  operation_results: List<SemanticTypeId>
) -> SemanticEffectApplicationCatalog {
  match applications {
    SemanticEffectApplicationCatalog(storage) -> SemanticEffectApplicationCatalog(
      SemanticEffectApplicationCatalogStorage {
        targets: storage.targets.prepend(target),
        declarations: storage.declarations.prepend(declaration),
        operation_counts: storage.operation_counts.prepend(
          operation_declarations.len()
        ),
        operation_declarations: semantic_application_declarations_prepend(
          operation_declarations,
          storage.operation_declarations
        ),
        operation_deferred: semantic_application_bools_prepend(
          operation_deferred,
          storage.operation_deferred
        ),
        operation_parameter_counts: semantic_application_usizes_prepend(
          operation_parameter_counts,
          storage.operation_parameter_counts
        ),
        operation_parameter_types: semantic_application_types_prepend(
          operation_parameter_types,
          storage.operation_parameter_types
        ),
        operation_results: semantic_application_types_prepend(
          operation_results,
          storage.operation_results
        )
      }
    )
  }
}

fn semantic_application_seen(
  visited: List<SemanticTypeId>,
  wanted: SemanticTypeId,
  catalog: borrow SemanticTypeCatalog
) -> bool {
  match visited {
    Nil -> false
    Cons(value, remaining) -> semantic_type_catalog_equal(catalog, value, wanted) or
      semantic_application_seen(remaining, wanted, catalog)
  }
}

fn semantic_application_with_visit(
  build: SemanticApplicationBuild,
  value: SemanticTypeId
) -> SemanticApplicationBuild {
  SemanticApplicationBuild {
    product: build.product,
    records: build.records,
    effects: build.effects,
    visited: build.visited.prepend(value)
  }
}

fn semantic_application_with_product(
  build: SemanticApplicationBuild,
  product: SemanticTypeProductBuilder
) -> SemanticApplicationBuild {
  SemanticApplicationBuild {
    product: product,
    records: build.records,
    effects: build.effects,
    visited: build.visited
  }
}

fn semantic_application_with_record_catalog(
  build: SemanticApplicationBuild,
  applications: SemanticRecordApplicationCatalog
) -> SemanticApplicationBuild {
  SemanticApplicationBuild {
    product: build.product,
    records: applications,
    effects: build.effects,
    visited: build.visited
  }
}

fn semantic_application_with_effect_catalog(
  build: SemanticApplicationBuild,
  applications: SemanticEffectApplicationCatalog
) -> SemanticApplicationBuild {
  SemanticApplicationBuild {
    product: build.product,
    records: build.records,
    effects: applications,
    visited: build.visited
  }
}

fn semantic_application_type_list(
  build: SemanticApplicationBuild,
  declarations: borrow SemanticTypeDeclarationCatalog,
  effect_declarations: borrow SemanticEffectDeclarationCatalog,
  graph: borrow SemanticTypeGraph,
  values: SemanticTypeListId,
  index: usize
) -> SemanticApplicationBuild {
  let lists = semantic_type_graph_type_lists_local(graph)
  if index >= semantic_type_list_len(lists, values) { build }
  else {
    let value = semantic_type_graph_list_type_id(
      graph,
      semantic_type_list_edge(lists, values, index)
    )
    semantic_application_type_list(
      semantic_application_type(build, declarations, effect_declarations, value),
      declarations,
      effect_declarations,
      graph,
      values,
      index + 1
    )
  }
}

fn semantic_application_record_fields(
  build: SemanticApplicationBuild,
  declarations: borrow SemanticTypeDeclarationCatalog,
  effect_declarations: borrow SemanticEffectDeclarationCatalog,
  graph: borrow SemanticTypeGraph,
  fields: SemanticRecordFieldListId,
  index: usize
) -> SemanticApplicationBuild {
  let records = semantic_type_graph_records_local(graph)
  if index >= semantic_type_record_field_count(records, fields) { build }
  else {
    let field = semantic_type_record_field_edge(records, fields, index)
    semantic_application_record_fields(
      semantic_application_type(
        build,
        declarations,
        effect_declarations,
        semantic_type_graph_record_field_type_id(graph, field)
      ),
      declarations,
      effect_declarations,
      graph,
      fields,
      index + 1
    )
  }
}

fn semantic_application_trait_bindings(
  build: SemanticApplicationBuild,
  declarations: borrow SemanticTypeDeclarationCatalog,
  effect_declarations: borrow SemanticEffectDeclarationCatalog,
  graph: borrow SemanticTypeGraph,
  bindings: SemanticTraitBindingListId,
  index: usize
) -> SemanticApplicationBuild {
  let traits = semantic_type_graph_traits_local(graph)
  if index >= semantic_type_trait_binding_count(traits, bindings) { build }
  else {
    let binding = semantic_type_trait_binding_edge(traits, bindings, index)
    semantic_application_trait_bindings(
      semantic_application_type(
        build,
        declarations,
        effect_declarations,
        semantic_type_graph_trait_binding_type_id(graph, binding)
      ),
      declarations,
      effect_declarations,
      graph,
      bindings,
      index + 1
    )
  }
}

fn semantic_application_declared_fields(
  build: SemanticApplicationBuild,
  declarations: borrow SemanticTypeDeclarationCatalog,
  effect_declarations: borrow SemanticEffectDeclarationCatalog,
  layout: usize,
  substitution: borrow SemanticTypeSubstitution,
  index: usize,
  field_count: usize,
  resolved_declarations: List<DeclarationIdentity>,
  resolved_types: List<SemanticTypeId>
) -> SemanticApplicationFields {
  if index >= field_count {
    SemanticApplicationFields {
      build: build,
      declarations: resolved_declarations.reverse(),
      types: resolved_types.reverse()
    }
  } else {
    match (
      semantic_type_declared_record_field_declaration(declarations, layout, index),
      semantic_type_declared_record_field_type(declarations, layout, index),
    ) {
      (Some(declaration), Some(template)) -> {
        let (product, resolved) = semantic_type_product_substitute(
          build.product,
          substitution,
          template
        )
        let next = semantic_application_type(
          semantic_application_with_product(build, product),
          declarations,
          effect_declarations,
          resolved
        )
        semantic_application_declared_fields(
          next,
          declarations,
          effect_declarations,
          layout,
          substitution,
          index + 1,
          field_count,
          resolved_declarations.prepend(declaration),
          resolved_types.prepend(resolved)
        )
      }
      _ -> panic("Semantic record declaration columns diverged")
    }
  }
}

fn semantic_application_type_values(
  build: SemanticApplicationBuild,
  declarations: borrow SemanticTypeDeclarationCatalog,
  effect_declarations: borrow SemanticEffectDeclarationCatalog,
  values: List<SemanticTypeId>
) -> SemanticApplicationBuild {
  match values {
    Nil -> build
    Cons(value, remaining) -> semantic_application_type_values(
      semantic_application_type(
        build,
        declarations,
        effect_declarations,
        value
      ),
      declarations,
      effect_declarations,
      remaining
    )
  }
}

fn semantic_application_operation_parameters(
  build: SemanticApplicationBuild,
  effect_declarations: borrow SemanticEffectDeclarationCatalog,
  layout: usize,
  operation: usize,
  substitution: borrow SemanticTypeSubstitution,
  index: usize,
  count: usize,
  types: List<SemanticTypeId>
) -> (SemanticApplicationBuild, List<SemanticTypeId>) {
  if index >= count { (build, types) }
  else {
    match semantic_effect_operation_parameter_type(
      effect_declarations,
      layout,
      operation,
      index
    ) {
      None -> panic("Semantic effect parameter columns diverged")
      Some(template) -> {
        let (product, resolved) = semantic_type_product_substitute(
          build.product,
          substitution,
          template
        )
        semantic_application_operation_parameters(
          semantic_application_with_product(build, product),
          effect_declarations,
          layout,
          operation,
          substitution,
          index + 1,
          count,
          types.prepend(resolved)
        )
      }
    }
  }
}

fn semantic_application_operations(
  build: SemanticApplicationBuild,
  effect_declarations: borrow SemanticEffectDeclarationCatalog,
  layout: usize,
  substitution: borrow SemanticTypeSubstitution,
  index: usize,
  count: usize,
  declarations: List<DeclarationIdentity>,
  deferred: List<bool>,
  parameter_counts: List<usize>,
  parameter_types: List<SemanticTypeId>,
  results: List<SemanticTypeId>
) -> SemanticApplicationOperationFields {
  if index >= count {
    SemanticApplicationOperationFields {
      build: build,
      declarations: declarations.reverse(),
      deferred: deferred.reverse(),
      parameter_counts: parameter_counts.reverse(),
      parameter_types: parameter_types.reverse(),
      results: results.reverse()
    }
  } else {
    match (
      semantic_effect_operation_declaration(effect_declarations, layout, index),
      semantic_effect_operation_is_deferred(effect_declarations, layout, index),
      semantic_effect_operation_parameter_count(effect_declarations, layout, index),
      semantic_effect_operation_result(effect_declarations, layout, index),
    ) {
      (Some(operation), Some(is_deferred), Some(parameter_count), Some(result)) -> {
        let (next, parameters) = semantic_application_operation_parameters(
          build,
          effect_declarations,
          layout,
          index,
          substitution,
          0,
          parameter_count,
          parameter_types
        )
        let (product, resolved_result) = semantic_type_product_substitute(
          next.product,
          substitution,
          result
        )
        semantic_application_operations(
          semantic_application_with_product(next, product),
          effect_declarations,
          layout,
          substitution,
          index + 1,
          count,
          declarations.prepend(operation),
          deferred.prepend(is_deferred),
          parameter_counts.prepend(parameter_count),
          parameters,
          results.prepend(resolved_result)
        )
      }
      _ -> panic("Semantic effect operation columns diverged")
    }
  }
}

fn semantic_application_effect(
  build: SemanticApplicationBuild,
  declarations: borrow SemanticTypeDeclarationCatalog,
  effect_declarations: borrow SemanticEffectDeclarationCatalog,
  value: SemanticTypeId,
  arguments: SemanticTypeListId,
  graph: borrow SemanticTypeGraph
) -> SemanticApplicationBuild {
  let product = build.product
  let catalog = semantic_type_product_catalog(product)
  let empty = semantic_type_substitution_empty()
  let next = match semantic_effect_declaration_catalog_resolve(
    catalog,
    effect_declarations,
    value,
    empty
  ) {
    SemanticEffectDeclarationMatched(layout, substitution) -> match (
      semantic_effect_declaration(effect_declarations, layout),
      semantic_effect_operation_count(effect_declarations, layout),
    ) {
      (Some(declaration), Some(operation_count)) -> {
        let operations = semantic_application_operations(
          build,
          effect_declarations,
          layout,
          substitution,
          0,
          operation_count,
          Nil<DeclarationIdentity>(),
          Nil<bool>(),
          Nil<usize>(),
          Nil<SemanticTypeId>(),
          Nil<SemanticTypeId>()
        )
        let resolved_types = semantic_application_types_prepend(
          operations.parameter_types,
          operations.results
        )
        semantic_application_type_values(
          semantic_application_with_effect_catalog(
            operations.build,
            semantic_effect_applications_add(
              operations.build.effects,
              value,
              declaration,
              operations.declarations,
              operations.deferred,
              operations.parameter_counts,
              operations.parameter_types,
              operations.results
            )
          ),
          declarations,
          effect_declarations,
          resolved_types
        )
      }
      _ -> panic("Semantic effect declaration columns diverged")
    }
    _ -> build
  }
  semantic_application_type_list(
    next,
    declarations,
    effect_declarations,
    graph,
    arguments,
    0
  )
}

fn semantic_application_named(
  build: SemanticApplicationBuild,
  declarations: borrow SemanticTypeDeclarationCatalog,
  effect_declarations: borrow SemanticEffectDeclarationCatalog,
  value: SemanticTypeId,
  representation: SemanticTypeId,
  arguments: SemanticTypeListId,
  graph: borrow SemanticTypeGraph
) -> SemanticApplicationBuild {
  let product = build.product
  let catalog = semantic_type_product_catalog(product)
  let empty = semantic_type_substitution_empty()
  let next = match semantic_type_declaration_catalog_resolve(
    catalog,
    declarations,
    value,
    empty
  ) {
    SemanticRecordDeclarationLayoutMatched(layout, substitution) ->
      match semantic_type_declared_record_field_count(declarations, layout) {
        Some(field_count) -> {
          let fields = semantic_application_declared_fields(
            build,
            declarations,
            effect_declarations,
            layout,
            substitution,
            0,
            field_count,
            Nil<DeclarationIdentity>(),
            Nil<SemanticTypeId>()
          )
          semantic_application_with_record_catalog(
            fields.build,
            semantic_record_applications_add(
              fields.build.records,
              value,
              fields.declarations,
              fields.types
            )
          )
        }
        None -> panic("Semantic record declaration count is missing")
      }
    _ -> build
  }
  semantic_application_type_list(
    semantic_application_type(
      next,
      declarations,
      effect_declarations,
      representation
    ),
    declarations,
    effect_declarations,
    graph,
    arguments,
    0
  )
}

fn semantic_application_type(
  build: SemanticApplicationBuild,
  declarations: borrow SemanticTypeDeclarationCatalog,
  effect_declarations: borrow SemanticEffectDeclarationCatalog,
  value: SemanticTypeId
) -> SemanticApplicationBuild {
  let product = build.product
  let catalog = semantic_type_product_catalog(product)
  if semantic_application_seen(build.visited, value, catalog) { build }
  else {
    let next = semantic_application_with_visit(build, value)
    match catalog.graph_for(value) {
      None -> panic("Semantic application type is outside its catalog")
      Some(graph) -> match semantic_type_graph_node(graph, value) {
        SemanticBottomNode -> next
        SemanticTopNode -> next
        SemanticPrimitiveNode(_) -> next
        SemanticVariableNode(_) -> next
        SemanticUnionNode(left, right) -> semantic_application_type(
          semantic_application_type(next, declarations, effect_declarations, left),
          declarations,
          effect_declarations,
          right
        )
        SemanticIntersectionNode(left, right) -> semantic_application_type(
          semantic_application_type(next, declarations, effect_declarations, left),
          declarations,
          effect_declarations,
          right
        )
        SemanticContinuationNode(input, result) -> semantic_application_type(
          semantic_application_type(next, declarations, effect_declarations, input),
          declarations,
          effect_declarations,
          result
        )
        SemanticComplementNode(inner) -> semantic_application_type(
          next,
          declarations,
          effect_declarations,
          inner
        )
        SemanticWeakNode(inner) -> semantic_application_type(
          next,
          declarations,
          effect_declarations,
          inner
        )
        SemanticAtomicNode(inner) -> semantic_application_type(
          next,
          declarations,
          effect_declarations,
          inner
        )
        SemanticUniqueNode(inner) -> semantic_application_type(
          next,
          declarations,
          effect_declarations,
          inner
        )
        SemanticOwnedNode(inner) -> semantic_application_type(
          next,
          declarations,
          effect_declarations,
          inner
        )
        SemanticPointerNode(inner, _) -> semantic_application_type(
          next,
          declarations,
          effect_declarations,
          inner
        )
        SemanticBorrowNode(inner, _) -> semantic_application_type(
          next,
          declarations,
          effect_declarations,
          inner
        )
        SemanticSliceNode(inner, _) -> semantic_application_type(
          next,
          declarations,
          effect_declarations,
          inner
        )
        SemanticArrayNode(inner, _) -> semantic_application_type(
          next,
          declarations,
          effect_declarations,
          inner
        )
        SemanticFunctionNode(parameters, result, effects) -> semantic_application_type(
          semantic_application_type(
            semantic_application_type_list(
              next,
              declarations,
              effect_declarations,
              graph,
              parameters,
              0
            ),
            declarations,
            effect_declarations,
            result
          ),
          declarations,
          effect_declarations,
          effects
        )
        SemanticEffectAtomNode(_, arguments) -> semantic_application_effect(
          next,
          declarations,
          effect_declarations,
          value,
          arguments,
          graph
        )
        SemanticEffectSignatureNode(effects, _) -> semantic_application_type_list(
          next,
          declarations,
          effect_declarations,
          graph,
          effects,
          0
        )
        SemanticNamedNode(_, _, representation, arguments) -> semantic_application_named(
          next,
          declarations,
          effect_declarations,
          value,
          representation,
          arguments,
          graph
        )
        SemanticRecordNode(fields, _, _) -> semantic_application_record_fields(
          next,
          declarations,
          effect_declarations,
          graph,
          fields,
          0
        )
        SemanticVariantNode(_, payload) -> semantic_application_type(
          next,
          declarations,
          effect_declarations,
          payload
        )
        SemanticTraitNode(_, bindings) -> semantic_application_trait_bindings(
          next,
          declarations,
          effect_declarations,
          graph,
          bindings,
          0
        )
        SemanticAssociatedNode(base, _) -> semantic_application_type(
          next,
          declarations,
          effect_declarations,
          base
        )
      }
    }
  }
}

fn semantic_application_signatures(
  build: SemanticApplicationBuild,
  signatures: borrow SemanticSignatureProduct,
  declarations: borrow SemanticTypeDeclarationCatalog,
  effect_declarations: borrow SemanticEffectDeclarationCatalog,
  index: usize
) -> SemanticApplicationBuild {
  if index >= signatures.len() { build }
  else {
    let signature = signatures.at(index)
    let mut next = semantic_application_type(
      build,
      declarations,
      effect_declarations,
      signature.type_id
    )
    let mut bound: usize = 0
    while bound < signatures.bound_count(signature) {
      next = semantic_application_type(
        next,
        declarations,
        effect_declarations,
        signatures.bound_at(signature, bound).trait_atom
      )
      bound = bound + 1
    }
    semantic_application_signatures(
      next,
      signatures,
      declarations,
      effect_declarations,
      index + 1
    )
  }
}

pub(package) fn resolve_semantic_applications(
  product: SemanticTypeProductBuilder,
  signatures: borrow SemanticSignatureProduct,
  declarations: borrow SemanticTypeDeclarationCatalog,
  effect_declarations: borrow SemanticEffectDeclarationCatalog
) -> (
  SemanticTypeProductBuilder,
  SemanticRecordApplicationCatalog,
  SemanticEffectApplicationCatalog
) {
  let build = semantic_application_signatures(
    SemanticApplicationBuild {
      product: product,
      records: semantic_record_applications_empty(),
      effects: semantic_effect_applications_empty(),
      visited: Nil<SemanticTypeId>()
    },
    signatures,
    declarations,
    effect_declarations,
    0
  )
  (build.product, build.records, build.effects)
}

fn semantic_application_usize_prefix(
  values: List<usize>,
  count: usize,
  total: usize
) -> Option<usize> {
  if count == 0 { Some<usize>(total) }
  else {
    match values {
      Nil -> None<usize>()
      Cons(value, remaining) -> match num_scalar_usize_checked_add(total, value) {
        Some(next) -> semantic_application_usize_prefix(remaining, count - 1, next)
        None -> None<usize>()
      }
    }
  }
}

fn semantic_application_at<T>(values: List<T>, index: usize) -> Option<T> {
  match values {
    Nil -> None<T>()
    Cons(value, remaining) -> if index == 0 { Some<T>(value) }
    else { semantic_application_at(remaining, index - 1) }
  }
}

fn semantic_application_target_index(
  targets: List<SemanticTypeId>,
  wanted: SemanticTypeId,
  catalog: borrow SemanticTypeCatalog,
  index: usize
) -> Option<usize> {
  match targets {
    Nil -> None<usize>()
    Cons(target, remaining) -> if semantic_type_catalog_equal(catalog, target, wanted) {
      Some<usize>(index)
    } else {
      semantic_application_target_index(remaining, wanted, catalog, index + 1)
    }
  }
}

fn semantic_application_field_projection(
  storage: SemanticRecordApplicationCatalogStorage,
  wanted: str,
  field: usize,
  field_count: usize,
  start: usize
) -> SemanticDeclaredFieldProjection {
  if field >= field_count { SemanticDeclaredFieldMissing }
  else {
    let ordinal = start + field
    match (
      semantic_application_at(storage.declarations, ordinal),
      semantic_application_at(storage.types, ordinal),
    ) {
      (Some(declaration), Some(field_type)) -> {
        let name = declaration_identity_name(declaration)
        if match name.text() { Some(value) -> value == wanted, None -> false } {
          SemanticDeclaredFieldProjected(declaration, field, field_type)
        } else {
          semantic_application_field_projection(
            storage,
            wanted,
            field + 1,
            field_count,
            start
          )
        }
      }
      _ -> panic("Semantic record application columns diverged")
    }
  }
}

pub(package) fn semantic_declared_field_projection(
  applications: borrow SemanticRecordApplicationCatalog,
  types: borrow SemanticTypeCatalog,
  base: SemanticTypeId,
  wanted: str
) -> SemanticDeclaredFieldProjection {
  match applications {
    SemanticRecordApplicationCatalog(storage) -> match semantic_application_target_index(
      storage.targets,
      base,
      types,
      0
    ) {
      None -> SemanticDeclaredFieldProjectionUnavailable
      Some(application) -> match (
        semantic_application_at(storage.field_counts, application),
        semantic_application_usize_prefix(storage.field_counts, application, 0),
      ) {
        (Some(field_count), Some(start)) -> semantic_application_field_projection(
          storage,
          wanted,
          0,
          field_count,
          start
        )
        _ -> panic("Semantic record application bounds diverged")
      }
    }
  }
}

fn semantic_effect_application_operation_index(
  storage: SemanticEffectApplicationCatalogStorage,
  application: usize,
  wanted: str
) -> Option<usize> {
  match (
    semantic_application_at(storage.operation_counts, application),
    semantic_application_usize_prefix(storage.operation_counts, application, 0),
  ) {
    (Some(count), Some(start)) -> {
      let mut offset: usize = 0
      while offset < count {
        let ordinal = start + offset
        match semantic_application_at(storage.operation_declarations, ordinal) {
          Some(operation) -> {
            let name = declaration_identity_name(operation)
            if match name.text() { Some(value) -> value == wanted, None -> false } {
              return Some<usize>(ordinal)
            }
          }
          None -> panic("Semantic effect application columns diverged")
        }
        offset = offset + 1
      }
      None<usize>()
    }
    _ -> panic("Semantic effect application bounds diverged")
  }
}

pub(package) fn semantic_effect_operation_projection(
  applications: borrow SemanticEffectApplicationCatalog,
  types: borrow SemanticTypeCatalog,
  atom: SemanticTypeId,
  wanted: str
) -> SemanticEffectOperationProjection {
  match applications {
    SemanticEffectApplicationCatalog(storage) -> match semantic_application_target_index(
      storage.targets,
      atom,
      types,
      0
    ) {
      None -> SemanticEffectApplicationUnavailable
      Some(application) -> match semantic_effect_application_operation_index(
        storage,
        application,
        wanted
      ) {
        None -> SemanticEffectOperationMissing
        Some(operation_index) -> match (
          semantic_application_at(storage.declarations, application),
          semantic_application_at(storage.operation_declarations, operation_index),
          semantic_application_at(storage.operation_deferred, operation_index),
          semantic_application_at(storage.operation_parameter_counts, operation_index),
          semantic_application_at(storage.operation_results, operation_index),
        ) {
          (
            Some(declaration),
            Some(operation),
            Some(deferred),
            Some(parameter_count),
            Some(result),
          ) -> SemanticEffectOperationProjected(
            semantic_application_at(storage.targets, application).unwrap(),
            declaration,
            operation,
            deferred,
            parameter_count,
            result
          )
          _ -> panic("Semantic effect application columns diverged")
        }
      }
    }
  }
}

pub(package) fn semantic_effect_application_parameter_type(
  applications: borrow SemanticEffectApplicationCatalog,
  types: borrow SemanticTypeCatalog,
  atom: SemanticTypeId,
  wanted: str,
  parameter: usize
) -> Option<SemanticTypeId> {
  match applications {
    SemanticEffectApplicationCatalog(storage) -> match semantic_application_target_index(
      storage.targets,
      atom,
      types,
      0
    ) {
      None -> None<SemanticTypeId>()
      Some(application) -> match semantic_effect_application_operation_index(
        storage,
        application,
        wanted
      ) {
        None -> None<SemanticTypeId>()
        Some(operation_index) -> match semantic_application_at(
          storage.operation_parameter_counts,
          operation_index
        ) {
          Some(count) -> if parameter >= count { None<SemanticTypeId>() }
          else {
            match semantic_application_usize_prefix(
              storage.operation_parameter_counts,
              operation_index,
              0
            ) {
              None -> None<SemanticTypeId>()
              Some(start) -> match num_scalar_usize_checked_add(start, parameter) {
                None -> None<SemanticTypeId>()
                Some(index) -> semantic_application_at(
                  storage.operation_parameter_types,
                  index
                )
              }
            }
          }
          None -> None<SemanticTypeId>()
        }
      }
    }
  }
}
