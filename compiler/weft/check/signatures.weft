-- Frozen semantic signatures for one registered module.
--
-- The product owns the catalog that gives every published SemanticTypeId a
-- lifetime. Body checking consumes this value rather than separating a wide
-- root id from its graph or recovering a signature from authored syntax.

use compiler/ir/data.{
  MissingTypeParam,
  TypeParam,
  TypeParamBoundList,
  TypeParamBoundListCons,
  TypeParamBoundListNil,
  TypeParamList,
  TypeParamListCons,
  TypeParamListNil
}
use compiler/project/identity.{FunctionIdentity, ModuleIdentity, function_identity_module}
use compiler/project/identity/equality.{function_identity_eq, module_identity_eq}
use compiler/types/graph.{*}
use compiler/types/graph/catalog.{*}
use compiler/weft/check/registration/catalog.{RegisteredFunction, RegisteredModule}
use compiler/weft/check/registration/scope.{RegistrationScope, registration_scope_find}
use compiler/weft/check/semantic_types.{
  SemanticTypeProductBuilder,
  SemanticDeclarationResolutionRequired,
  SemanticInvalidVariable,
  SemanticTypeRejected,
  SemanticTypeResolutionIssue,
  SemanticTypeResolved,
  resolve_function_signature_product_with_self_in_scope,
  resolve_type_product_in_scope,
  semantic_type_product_builder,
  semantic_type_product_catalog,
  semantic_type_product_continue,
  semantic_type_product_next_segment
}
use compiler/weft/check/storage.{
  DenseBuilder,
  DenseSegment,
  dense_builder_with_capacity,
  dense_index
}
use stdlib/option.{None, Option, Some}
use stdlib/panic.{panic}

pub(package) type SemanticFunctionSignature {
  identity: FunctionIdentity,
  type_id: SemanticTypeId,
  type_parameters_start: usize,
  type_parameters_count: usize,
  bounds_start: usize,
  bounds_count: usize
}

pub(package) type SemanticSignatureBound {
  variable: SemanticTypeVariable,
  trait_atom: SemanticTypeId
}

type SemanticSignatureProductStorage {
  module: ModuleIdentity,
  catalog: SemanticTypeCatalog,
  next_type_segment: usize,
  functions: DenseSegment<SemanticFunctionSignature>,
  external_functions: DenseSegment<SemanticFunctionSignature>,
  type_parameters: DenseSegment<SemanticTypeVariable>,
  bounds: DenseSegment<SemanticSignatureBound>
}

pub(package) type SemanticSignatureProduct = opaque SemanticSignatureProductStorage

pub(package) type SemanticSignatureResolution {
  SemanticSignaturesResolved(SemanticSignatureProduct),
  SemanticSignaturesRejected(FunctionIdentity, SemanticTypeResolutionIssue)
}

pub(package) type SemanticScopeSignatureLookup {
  SemanticScopeSignatureFound(SemanticSignatureProduct, SemanticFunctionSignature),
  SemanticScopeSignatureMissing(SemanticSignatureProduct),
  SemanticScopeSignatureRejected(SemanticSignatureProduct, SemanticTypeResolutionIssue)
}

type SemanticSignatureBuild {
  SemanticSignatureBuildResolved(
    SemanticTypeProductBuilder,
    owned DenseBuilder<SemanticFunctionSignature>,
    owned DenseBuilder<SemanticTypeVariable>,
    owned DenseBuilder<SemanticSignatureBound>
  ),
  SemanticSignatureBuildRejected(
    SemanticTypeProductBuilder,
    owned DenseBuilder<SemanticFunctionSignature>,
    owned DenseBuilder<SemanticTypeVariable>,
    owned DenseBuilder<SemanticSignatureBound>,
    FunctionIdentity,
    SemanticTypeResolutionIssue
  )
}

type SemanticSignatureBoundsBuild {
  SemanticSignatureBoundsResolved(
    SemanticTypeProductBuilder,
    owned DenseBuilder<SemanticSignatureBound>,
    owned DenseBuilder<SemanticTypeVariable>
  ),
  SemanticSignatureBoundsRejected(
    SemanticTypeProductBuilder,
    owned DenseBuilder<SemanticSignatureBound>,
    owned DenseBuilder<SemanticTypeVariable>,
    SemanticTypeResolutionIssue
  )
}

fn resolve_parameter_bound_list(
  module: RegisteredModule,
  scope: RegistrationScope,
  parameters: TypeParamList,
  variable: SemanticTypeVariable,
  authored: TypeParamBoundList,
  product: SemanticTypeProductBuilder,
  bounds: owned DenseBuilder<SemanticSignatureBound>,
  variables: owned DenseBuilder<SemanticTypeVariable>
) -> SemanticSignatureBoundsBuild {
  match authored {
    TypeParamBoundListNil -> SemanticSignatureBoundsResolved(product, bounds, variables)
    TypeParamBoundListCons(bound, _, rest) -> match resolve_type_product_in_scope(
      product,
      module,
      scope,
      parameters,
      bound
    ) {
      (product, SemanticTypeResolved(trait_atom)) -> {
        let mut next_bounds = bounds
        next_bounds.push(
          SemanticSignatureBound {
            variable: variable,
            trait_atom: trait_atom
          }
        )
        resolve_parameter_bound_list(
          module,
          scope,
          parameters,
          variable,
          rest,
          product,
          next_bounds,
          variables
        )
      }
      (product, SemanticTypeRejected(issue)) -> SemanticSignatureBoundsRejected(
        product,
        bounds,
        variables,
        issue
      )
    }
  }
}

fn resolve_parameter_bounds(
  module: RegisteredModule,
  scope: RegistrationScope,
  parameters: TypeParamList,
  remaining: TypeParamList,
  product: SemanticTypeProductBuilder,
  bounds: owned DenseBuilder<SemanticSignatureBound>,
  variables: owned DenseBuilder<SemanticTypeVariable>
) -> SemanticSignatureBoundsBuild {
  match remaining {
    TypeParamListNil -> SemanticSignatureBoundsResolved(product, bounds, variables)
    TypeParamListCons(parameter, rest) -> match parameter {
      TypeParam(_, _, identity, authored) -> if identity < 0 {
        SemanticSignatureBoundsRejected(
          product,
          bounds,
          variables,
          SemanticInvalidVariable(identity)
        )
      } else {
        match resolve_parameter_bound_list(
          module,
          scope,
          parameters,
          SemanticParameterVariable(__i64_to_usize(identity)),
          authored,
          product,
          bounds,
          variables
        ) {
          SemanticSignatureBoundsResolved(product, bounds, variables) -> {
            let mut next_variables = variables
            next_variables.push(SemanticParameterVariable(__i64_to_usize(identity)))
            resolve_parameter_bounds(
              module,
              scope,
              parameters,
              rest,
              product,
              bounds,
              next_variables
            )
          }
          SemanticSignatureBoundsRejected(product, bounds, variables, issue) ->
            SemanticSignatureBoundsRejected(product, bounds, variables, issue)
        }
      }
      MissingTypeParam -> SemanticSignatureBoundsRejected(
        product,
        bounds,
        variables,
        SemanticDeclarationResolutionRequired
      )
    }
  }
}

fn resolve_registered_functions(
  module: RegisteredModule,
  scope: RegistrationScope,
  index: usize,
  product: SemanticTypeProductBuilder,
  signatures: owned DenseBuilder<SemanticFunctionSignature>,
  type_parameters: owned DenseBuilder<SemanticTypeVariable>,
  bounds: owned DenseBuilder<SemanticSignatureBound>
) -> SemanticSignatureBuild {
  let functions = module.functions
  if index >= functions.len() {
    SemanticSignatureBuildResolved(product, signatures, type_parameters, bounds)
  } else {
    let function = functions.at(dense_index(index))
    let bounds_start = bounds.len()
    let type_parameters_start = type_parameters.len()
    match resolve_parameter_bounds(
      module,
      scope,
      function.syntax.type_params,
      function.syntax.type_params,
      product,
      bounds,
      type_parameters
    ) {
      SemanticSignatureBoundsResolved(product, bounds, type_parameters) ->
        match resolve_function_signature_product_with_self_in_scope(
          product,
          module,
          scope,
          function.syntax,
          function.self_trait
        ) {
          (product, SemanticTypeResolved(type_id)) -> {
            let mut next_signatures = signatures
            next_signatures.push(
              SemanticFunctionSignature {
                identity: function.identity,
                type_id: type_id,
                type_parameters_start: type_parameters_start,
                type_parameters_count: type_parameters.len() - type_parameters_start,
                bounds_start: bounds_start,
                bounds_count: bounds.len() - bounds_start
              }
            )
            resolve_registered_functions(
              module,
              scope,
              index + 1,
              product,
              next_signatures,
              type_parameters,
              bounds
            )
          }
          (product, SemanticTypeRejected(issue)) -> SemanticSignatureBuildRejected(
            product,
            signatures,
            type_parameters,
            bounds,
            function.identity,
            issue
          )
        }
      SemanticSignatureBoundsRejected(product, bounds, type_parameters, issue) ->
        SemanticSignatureBuildRejected(
          product,
          signatures,
          type_parameters,
          bounds,
          function.identity,
          issue
        )
    }
  }
}

pub(package) fn resolve_module_signatures(
  module: RegisteredModule,
  scope: RegistrationScope
) -> SemanticSignatureResolution {
  let functions = module.functions
  let product = semantic_type_product_builder(module.identity, functions.len())
  let signatures = dense_builder_with_capacity<SemanticFunctionSignature>(
    functions.len()
  )
  let type_parameters = dense_builder_with_capacity<SemanticTypeVariable>(functions.len())
  let bounds = dense_builder_with_capacity<SemanticSignatureBound>(functions.len())
  match resolve_registered_functions(
    module,
    scope,
    0,
    product,
    signatures,
    type_parameters,
    bounds
  ) {
    SemanticSignatureBuildResolved(product, signatures, type_parameters, bounds) -> {
      let catalog = semantic_type_product_catalog(product)
      let next_type_segment = semantic_type_product_next_segment(product)
      SemanticSignaturesResolved(
        SemanticSignatureProduct(
          SemanticSignatureProductStorage {
            module: module.identity,
            catalog: catalog,
            next_type_segment: next_type_segment,
            functions: signatures.freeze(),
            external_functions: dense_builder_with_capacity<SemanticFunctionSignature>(0).freeze(),
            type_parameters: type_parameters.freeze(),
            bounds: bounds.freeze()
          }
        )
      )
    }
    SemanticSignatureBuildRejected(_, signatures, type_parameters, bounds, function, issue) -> {
      signatures.drop()
      type_parameters.drop()
      bounds.drop()
      SemanticSignaturesRejected(function, issue)
    }
  }
}

fn registered_function_for_identity(
  module: RegisteredModule,
  wanted: FunctionIdentity
) -> Option<RegisteredFunction> {
  let functions = module.functions
  let mut index: usize = 0
  while index < functions.len() {
    let function = functions.at(dense_index(index))
    if function_identity_eq(function.identity, wanted) {
      return Some<RegisteredFunction>(function)
    } else { nil }
    index = index + 1
  }
  None<RegisteredFunction>()
}

-- The scope lookup has already established visibility. Materialize only the
-- selected dependency function, retaining its generic bounds in this product
-- rather than re-resolving every function in every imported module.
pub(package) fn semantic_signature_in_scope(
  signatures: SemanticSignatureProduct,
  catalog: SemanticTypeCatalog,
  scope: RegistrationScope,
  wanted: FunctionIdentity
) -> SemanticScopeSignatureLookup {
  match signatures.find(wanted) {
    Some(signature) -> SemanticScopeSignatureFound(signatures.with_catalog(catalog), signature)
    None -> if module_identity_eq(signatures.module(), function_identity_module(wanted)) {
      SemanticScopeSignatureMissing(signatures)
    } else {
      match registration_scope_find(scope, function_identity_module(wanted)) {
        None -> SemanticScopeSignatureMissing(signatures)
        Some(module) -> match registered_function_for_identity(module, wanted) {
          None -> SemanticScopeSignatureMissing(signatures)
          Some(function) -> {
            let next_segment = catalog.next_derived_segment(
              signatures.module(),
              signatures.next_type_segment()
            )
            let product = semantic_type_product_continue(
              signatures.module(),
              catalog,
              next_segment
            )
            match resolve_parameter_bounds(
              module,
              scope,
              function.syntax.type_params,
              function.syntax.type_params,
              product,
              dense_builder_with_capacity<SemanticSignatureBound>(0),
              dense_builder_with_capacity<SemanticTypeVariable>(0)
            ) {
              SemanticSignatureBoundsRejected(_, bounds, variables, issue) -> {
                bounds.drop()
                variables.drop()
                SemanticScopeSignatureRejected(signatures, issue)
              }
              SemanticSignatureBoundsResolved(product, bounds, variables) ->
                match resolve_function_signature_product_with_self_in_scope(
                  product,
                  module,
                  scope,
                  function.syntax,
                  function.self_trait
                ) {
                  (_, SemanticTypeRejected(issue)) -> {
                    bounds.drop()
                    variables.drop()
                    SemanticScopeSignatureRejected(signatures, issue)
                  }
                  (product, SemanticTypeResolved(type_id)) -> {
                    let SemanticSignatureProduct(storage) = signatures
                    let local_variables = storage.type_parameters
                    let local_bounds = storage.bounds
                    let signature = SemanticFunctionSignature {
                      identity: wanted,
                      type_id: type_id,
                      type_parameters_start: local_variables.len(),
                      type_parameters_count: variables.len(),
                      bounds_start: local_bounds.len(),
                      bounds_count: bounds.len()
                    }
                    let mut merged_variables = local_variables
                    let variables = variables.freeze()
                    let mut index: usize = 0
                    while index < variables.len() {
                      merged_variables = merged_variables.push(variables.at(dense_index(index)))
                      index = index + 1
                    }
                    let mut merged_bounds = local_bounds
                    let bounds = bounds.freeze()
                    index = 0
                    while index < bounds.len() {
                      merged_bounds = merged_bounds.push(bounds.at(dense_index(index)))
                      index = index + 1
                    }
                    SemanticScopeSignatureFound(
                      SemanticSignatureProduct(
                        SemanticSignatureProductStorage {
                          module: storage.module,
                          catalog: semantic_type_product_catalog(product),
                          next_type_segment: semantic_type_product_next_segment(product),
                          functions: storage.functions,
                          external_functions: storage.external_functions.push(signature),
                          type_parameters: merged_variables,
                          bounds: merged_bounds
                        }
                      ),
                      signature
                    )
                  }
                }
            }
          }
        }
      }
    }
  }
}

impl SemanticSignatureProduct {
  pub(package) fn with_catalog(
    self: Self,
    catalog: SemanticTypeCatalog
  ) -> SemanticSignatureProduct {
    let SemanticSignatureProduct(storage) = self
    SemanticSignatureProduct(
      SemanticSignatureProductStorage {
        module: storage.module,
        catalog: catalog,
        next_type_segment: storage.next_type_segment,
        functions: storage.functions,
        external_functions: storage.external_functions,
        type_parameters: storage.type_parameters,
        bounds: storage.bounds
      }
    )
  }

  pub(package) fn next_type_segment(self: borrow Self) -> usize {
    match self {
      SemanticSignatureProduct(storage) -> storage.next_type_segment
    }
  }

  pub(package) fn module(self: borrow Self) -> ModuleIdentity {
    match self {
      SemanticSignatureProduct(storage) -> {
        let { module, catalog: _, next_type_segment: _, functions: _, external_functions: _, type_parameters: _, bounds: _ } = storage
        module
      }
    }
  }

  pub(package) fn catalog(self: borrow Self) -> SemanticTypeCatalog {
    match self {
      SemanticSignatureProduct(storage) -> {
        let { module: _, catalog, next_type_segment: _, functions: _, external_functions: _, type_parameters: _, bounds: _ } = storage
        catalog
      }
    }
  }

  pub(package) fn continue_types(self: borrow Self) -> SemanticTypeProductBuilder {
    match self {
      SemanticSignatureProduct(storage) -> {
        let { module, catalog, next_type_segment, functions: _, external_functions: _, type_parameters: _, bounds: _ } = storage
        semantic_type_product_continue(module, catalog, next_type_segment)
      }
    }
  }

  pub(package) fn len(self: borrow Self) -> usize {
    match self {
      SemanticSignatureProduct(storage) -> {
        let { module: _, catalog: _, next_type_segment: _, functions, external_functions: _, type_parameters: _, bounds: _ } = storage
        functions.len()
      }
    }
  }

  pub(package) fn at(self: borrow Self, index: usize) -> SemanticFunctionSignature {
    match self {
      SemanticSignatureProduct(storage) -> {
        let { module: _, catalog: _, next_type_segment: _, functions, external_functions: _, type_parameters: _, bounds: _ } = storage
        functions.at(dense_index(index))
      }
    }
  }

  pub(package) fn type_parameter_count(
    self: borrow Self,
    signature: SemanticFunctionSignature
  ) -> usize {
    signature.type_parameters_count
  }

  pub(package) fn type_parameter_at(
    self: borrow Self,
    signature: SemanticFunctionSignature,
    index: usize
  ) -> SemanticTypeVariable {
    if index >= signature.type_parameters_count {
      panic("Semantic signature type parameter index is out of bounds")
    } else {
      match self {
        SemanticSignatureProduct(storage) -> {
          let { module: _, catalog: _, next_type_segment: _, functions: _, external_functions: _, type_parameters, bounds: _ } = storage
          type_parameters.at(dense_index(signature.type_parameters_start + index))
        }
      }
    }
  }

  pub(package) fn bound_count(
    self: borrow Self,
    signature: SemanticFunctionSignature
  ) -> usize {
    signature.bounds_count
  }

  pub(package) fn bound_at(
    self: borrow Self,
    signature: SemanticFunctionSignature,
    index: usize
  ) -> SemanticSignatureBound {
    if index >= signature.bounds_count {
      panic("Semantic signature bound index is out of bounds")
    } else {
      match self {
        SemanticSignatureProduct(storage) -> {
          let { module: _, catalog: _, next_type_segment: _, functions: _, external_functions: _, type_parameters: _, bounds } = storage
          bounds.at(dense_index(signature.bounds_start + index))
        }
      }
    }
  }

  pub(package) fn find(
    self: borrow Self,
    wanted: FunctionIdentity
  ) -> Option<SemanticFunctionSignature> {
    match self {
      SemanticSignatureProduct(storage) -> {
        let { module, catalog: _, next_type_segment: _, functions, external_functions, type_parameters: _, bounds: _ } = storage
        let selected = if module_identity_eq(module, function_identity_module(wanted)) {
          functions
        } else { external_functions }
        let mut index: usize = 0
        while index < selected.len() {
          let signature = selected.at(dense_index(index))
          if function_identity_eq(signature.identity, wanted) {
            return Some<SemanticFunctionSignature>(signature)
          } else { nil }
          index = index + 1
        }
        None<SemanticFunctionSignature>()
      }
    }
  }
}
