-- The program's sealed Sendable identities.
--
-- Mutable containers, runtime tokens and persistent collections are
-- classified by the exact SDK declaration, never by spelling: a user type
-- named `Map` is ordinary data whose fields decide its Sendable fact. A
-- declaration counts only when its module belongs to the SDK package.

use compiler/project/identity.{DeclarationIdentity, TypeDeclaration}
use compiler/types/graph/sendable.{
  SemanticSealedDeclaration,
  SemanticSealedKind,
  SemanticSealedMutableContainer,
  SemanticSealedPersistentCollection,
  SemanticSealedRuntimeToken,
  SemanticSendableIdentities,
  semantic_sendable_identities
}
use compiler/weft/check/registration/scope.{RegistrationScope}
use compiler/weft/check/registration/sdk.{registration_scope_sdk_declaration}
use stdlib/list.{List, Nil}

fn checked_sealed(
  entries: List<SemanticSealedDeclaration>,
  scope: RegistrationScope,
  sdk_package_id: i64,
  module_path: str,
  name: str,
  kind: SemanticSealedKind
) -> List<SemanticSealedDeclaration> {
  match registration_scope_sdk_declaration(
    scope,
    sdk_package_id,
    module_path,
    TypeDeclaration,
    name
  ) {
    nil -> entries
    found: DeclarationIdentity -> entries.prepend(
      SemanticSealedDeclaration { declaration: found, kind: kind }
    )
  }
}

pub(package) fn checked_sendable_identities(
  scope: RegistrationScope,
  sdk_package_id: i64
) -> SemanticSendableIdentities {
  let mut entries = Nil<SemanticSealedDeclaration>()
  entries = checked_sealed(
    entries,
    scope,
    sdk_package_id,
    "stdlib/vector/handles",
    "Vector",
    SemanticSealedMutableContainer
  )
  entries = checked_sealed(
    entries,
    scope,
    sdk_package_id,
    "stdlib/vector/handles",
    "PersistentVector",
    SemanticSealedPersistentCollection
  )
  entries = checked_sealed(
    entries,
    scope,
    sdk_package_id,
    "stdlib/vector/handles",
    "FrozenVector",
    SemanticSealedPersistentCollection
  )
  entries = checked_sealed(
    entries,
    scope,
    sdk_package_id,
    "stdlib/map/handles",
    "Map",
    SemanticSealedPersistentCollection
  )
  entries = checked_sealed(
    entries,
    scope,
    sdk_package_id,
    "stdlib/map/handles",
    "Set",
    SemanticSealedPersistentCollection
  )
  entries = checked_sealed(
    entries,
    scope,
    sdk_package_id,
    "stdlib/iter/protocol",
    "Iterator",
    SemanticSealedRuntimeToken
  )
  entries = checked_sealed(
    entries,
    scope,
    sdk_package_id,
    "stdlib/generator",
    "Generator",
    SemanticSealedRuntimeToken
  )
  entries = checked_sealed(
    entries,
    scope,
    sdk_package_id,
    "stdlib/par",
    "ParTask",
    SemanticSealedRuntimeToken
  )
  entries = checked_sealed(
    entries,
    scope,
    sdk_package_id,
    "stdlib/task",
    "Task",
    SemanticSealedRuntimeToken
  )
  semantic_sendable_identities(entries)
}
