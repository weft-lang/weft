-- The program's sealed Sendable identities and exact SDK declarations.
--
-- Mutable containers, runtime tokens and persistent collections are
-- classified by the exact SDK declaration, never by spelling: a user type
-- named `Map` is ordinary data whose fields decide its Sendable fact. A
-- declaration counts only when its module belongs to the SDK package.

use compiler/project/identity.{
  DeclarationIdentity,
  DeclarationNamespace,
  NamedModuleIdentity,
  TypeDeclaration,
  module_identity_package
}
use compiler/types/graph/sendable.{
  SemanticSealedDeclaration,
  SemanticSealedKind,
  SemanticSealedMutableContainer,
  SemanticSealedPersistentCollection,
  SemanticSealedRuntimeToken,
  SemanticSendableIdentities,
  semantic_sendable_identities
}
use compiler/weft/check/registration/scope.{
  RegistrationScope,
  registration_scope_at,
  registration_scope_find_declaration,
  registration_scope_len
}
use stdlib/list.{List, Nil}
use stdlib/option.{None, Option, Some}

-- The one declaration an SDK module exports under `name`, or nothing when
-- the program lacks the module or the name is ambiguous.
pub(package) fn checked_sdk_declaration(
  scope: RegistrationScope,
  sdk_package_id: i64,
  module_path: str,
  namespace: DeclarationNamespace,
  name: str
) -> DeclarationIdentity? {
  let mut selected: DeclarationIdentity? = nil
  if sdk_package_id <= 0 { return nil }
  let mut index: usize = 0
  while index < registration_scope_len(scope) {
    let module = registration_scope_at(scope, __u64_to_i64(__usize_to_u64(index)))
    match module.identity {
      NamedModuleIdentity(path, _) -> if path == module_path and
        module_identity_package(module.identity) == sdk_package_id {
          match registration_scope_find_declaration(scope, module.identity, namespace, name) {
            Some(found) -> match selected {
              nil -> { selected = found.identity }
              other: DeclarationIdentity -> return nil
            }
            None -> nil
          }
        } else { nil }
      _ -> nil
    }
    index = index + 1
  }
  selected
}

fn checked_sealed(
  entries: List<SemanticSealedDeclaration>,
  scope: RegistrationScope,
  sdk_package_id: i64,
  module_path: str,
  name: str,
  kind: SemanticSealedKind
) -> List<SemanticSealedDeclaration> {
  match checked_sdk_declaration(scope, sdk_package_id, module_path, TypeDeclaration, name) {
    nil -> entries
    found: DeclarationIdentity -> entries.prepend(
      SemanticSealedDeclaration { declaration: found, kind: kind }
    )
  }
}

pub(package) fn checked_sendable_identities(
  scope: RegistrationScope,
  sdk_package_id: i64
) -> SemanticSendableIdentities {
  let mut entries = Nil<SemanticSealedDeclaration>()
  entries = checked_sealed(
    entries,
    scope,
    sdk_package_id,
    "stdlib/vector/handles",
    "Vector",
    SemanticSealedMutableContainer
  )
  entries = checked_sealed(
    entries,
    scope,
    sdk_package_id,
    "stdlib/vector/handles",
    "PersistentVector",
    SemanticSealedPersistentCollection
  )
  entries = checked_sealed(
    entries,
    scope,
    sdk_package_id,
    "stdlib/map/handles",
    "Map",
    SemanticSealedPersistentCollection
  )
  entries = checked_sealed(
    entries,
    scope,
    sdk_package_id,
    "stdlib/map/handles",
    "Set",
    SemanticSealedPersistentCollection
  )
  entries = checked_sealed(
    entries,
    scope,
    sdk_package_id,
    "stdlib/iter/protocol",
    "Iterator",
    SemanticSealedRuntimeToken
  )
  entries = checked_sealed(
    entries,
    scope,
    sdk_package_id,
    "stdlib/generator",
    "Generator",
    SemanticSealedRuntimeToken
  )
  entries = checked_sealed(
    entries,
    scope,
    sdk_package_id,
    "stdlib/par",
    "ParTask",
    SemanticSealedRuntimeToken
  )
  entries = checked_sealed(
    entries,
    scope,
    sdk_package_id,
    "stdlib/task",
    "Task",
    SemanticSealedRuntimeToken
  )
  semantic_sendable_identities(entries)
}
