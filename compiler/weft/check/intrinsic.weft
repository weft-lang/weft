-- Typed contracts for the sealed primitives understood by Weft lowering.
--
-- A leading `__` is not authority. Trusted source must still resolve the
-- spelling through this closed catalog before a checked intrinsic identity is
-- published. Lowering consumes that identity rather than recognizing source
-- text a second time.

use compiler/project/identity.{
  IntrinsicIdentity,
  intrinsic_identity,
  intrinsic_identity_with_native_key
}
use stdlib/hash.{Hash}
use stdlib/list as list
use stdlib/list.{List, Nil}
use stdlib/option.{None, Option, Some}
use stdlib/source.{Span}

pub(package) type WeftIntrinsicType {
  WeftIntrinsicAny,
  WeftIntrinsicI64,
  WeftIntrinsicI32,
  WeftIntrinsicI16,
  WeftIntrinsicI8,
  WeftIntrinsicIsize,
  WeftIntrinsicU64,
  WeftIntrinsicU32,
  WeftIntrinsicU16,
  WeftIntrinsicU8,
  WeftIntrinsicUsize,
  WeftIntrinsicF64,
  WeftIntrinsicF32,
  WeftIntrinsicStr,
  WeftIntrinsicRcI64
}

pub(package) type WeftIntrinsicResult {
  WeftIntrinsicFixedResult(WeftIntrinsicType),
  WeftIntrinsicContextualResult
}

pub(package) type WeftIntrinsicAuthority {
  WeftSafeIntrinsic,
  WeftTrustedIntrinsic
}

pub(package) type WeftIntrinsicContract {
  identity: IntrinsicIdentity,
  parameters: List<WeftIntrinsicType>,
  result: WeftIntrinsicResult,
  authority: WeftIntrinsicAuthority
}

fn contract(
  code: usize,
  parameters: List<WeftIntrinsicType>,
  result: WeftIntrinsicResult,
  authority: WeftIntrinsicAuthority
) -> WeftIntrinsicContract {
  WeftIntrinsicContract {
    identity: intrinsic_identity(code),
    parameters: parameters,
    result: result,
    authority: authority
  }
}

fn unary(
  code: usize,
  parameter: WeftIntrinsicType,
  result: WeftIntrinsicType
) -> WeftIntrinsicContract {
  let parameters = [parameter]
  contract(
    code,
    list.from_slice(parameters[..]),
    WeftIntrinsicFixedResult(result),
    WeftSafeIntrinsic
  )
}

fn trusted_unary(
  code: usize,
  parameter: WeftIntrinsicType,
  result: WeftIntrinsicType
) -> WeftIntrinsicContract {
  let parameters = [parameter]
  contract(
    code,
    list.from_slice(parameters[..]),
    WeftIntrinsicFixedResult(result),
    WeftTrustedIntrinsic
  )
}

fn fixed_i64(code: usize, arity: usize) -> WeftIntrinsicContract {
  let mut parameters: List<WeftIntrinsicType> = Nil
  let mut index: usize = 0
  while index < arity {
    parameters = parameters.prepend(WeftIntrinsicI64)
    index = index + 1
  }
  contract(
    code,
    parameters,
    WeftIntrinsicFixedResult(WeftIntrinsicI64),
    WeftTrustedIntrinsic
  )
}

fn numeric_cast(name: str) -> Option<WeftIntrinsicContract> {
  if name == "__i8_to_i64" { Some(unary(100, WeftIntrinsicI8, WeftIntrinsicI64)) }
  else if name == "__i16_to_i64" { Some(unary(101, WeftIntrinsicI16, WeftIntrinsicI64)) }
  else if name == "__i32_to_i64" { Some(unary(102, WeftIntrinsicI32, WeftIntrinsicI64)) }
  else if name == "__isize_to_i64" { Some(unary(103, WeftIntrinsicIsize, WeftIntrinsicI64)) }
  else if name == "__u8_to_u64" { Some(unary(104, WeftIntrinsicU8, WeftIntrinsicU64)) }
  else if name == "__u16_to_u64" { Some(unary(105, WeftIntrinsicU16, WeftIntrinsicU64)) }
  else if name == "__u32_to_u64" { Some(unary(106, WeftIntrinsicU32, WeftIntrinsicU64)) }
  else if name == "__usize_to_u64" { Some(unary(107, WeftIntrinsicUsize, WeftIntrinsicU64)) }
  else if name == "__i64_to_i8" { Some(unary(108, WeftIntrinsicI64, WeftIntrinsicI8)) }
  else if name == "__i64_to_i16" { Some(unary(109, WeftIntrinsicI64, WeftIntrinsicI16)) }
  else if name == "__i64_to_i32" { Some(unary(110, WeftIntrinsicI64, WeftIntrinsicI32)) }
  else if name == "__i64_to_isize" { Some(unary(111, WeftIntrinsicI64, WeftIntrinsicIsize)) }
  else if name == "__i64_to_u8" { Some(unary(112, WeftIntrinsicI64, WeftIntrinsicU8)) }
  else if name == "__i64_to_u16" { Some(unary(113, WeftIntrinsicI64, WeftIntrinsicU16)) }
  else if name == "__i64_to_u32" { Some(unary(114, WeftIntrinsicI64, WeftIntrinsicU32)) }
  else if name == "__i64_to_u64" { Some(unary(115, WeftIntrinsicI64, WeftIntrinsicU64)) }
  else if name == "__i64_to_usize" { Some(unary(116, WeftIntrinsicI64, WeftIntrinsicUsize)) }
  else if name == "__u64_to_i8" { Some(unary(117, WeftIntrinsicU64, WeftIntrinsicI8)) }
  else if name == "__u64_to_i16" { Some(unary(118, WeftIntrinsicU64, WeftIntrinsicI16)) }
  else if name == "__u64_to_i32" { Some(unary(119, WeftIntrinsicU64, WeftIntrinsicI32)) }
  else if name == "__u64_to_i64" { Some(unary(120, WeftIntrinsicU64, WeftIntrinsicI64)) }
  else if name == "__u64_to_isize" { Some(unary(121, WeftIntrinsicU64, WeftIntrinsicIsize)) }
  else if name == "__u64_to_u8" { Some(unary(122, WeftIntrinsicU64, WeftIntrinsicU8)) }
  else if name == "__u64_to_u16" { Some(unary(123, WeftIntrinsicU64, WeftIntrinsicU16)) }
  else if name == "__u64_to_u32" { Some(unary(124, WeftIntrinsicU64, WeftIntrinsicU32)) }
  else if name == "__u64_to_usize" { Some(unary(125, WeftIntrinsicU64, WeftIntrinsicUsize)) }
  else if name == "__i8_to_f64" { Some(unary(126, WeftIntrinsicI8, WeftIntrinsicF64)) }
  else if name == "__i16_to_f64" { Some(unary(127, WeftIntrinsicI16, WeftIntrinsicF64)) }
  else if name == "__i32_to_f64" { Some(unary(128, WeftIntrinsicI32, WeftIntrinsicF64)) }
  else if name == "__i64_to_f64" { Some(unary(129, WeftIntrinsicI64, WeftIntrinsicF64)) }
  else if name == "__isize_to_f64" { Some(unary(130, WeftIntrinsicIsize, WeftIntrinsicF64)) }
  else if name == "__u8_to_f64" { Some(unary(131, WeftIntrinsicU8, WeftIntrinsicF64)) }
  else if name == "__u16_to_f64" { Some(unary(132, WeftIntrinsicU16, WeftIntrinsicF64)) }
  else if name == "__u32_to_f64" { Some(unary(133, WeftIntrinsicU32, WeftIntrinsicF64)) }
  else if name == "__u64_to_f64" { Some(unary(134, WeftIntrinsicU64, WeftIntrinsicF64)) }
  else if name == "__usize_to_f64" { Some(unary(135, WeftIntrinsicUsize, WeftIntrinsicF64)) }
  else if name == "__i8_to_f32" { Some(unary(136, WeftIntrinsicI8, WeftIntrinsicF32)) }
  else if name == "__i16_to_f32" { Some(unary(137, WeftIntrinsicI16, WeftIntrinsicF32)) }
  else if name == "__i32_to_f32" { Some(unary(138, WeftIntrinsicI32, WeftIntrinsicF32)) }
  else if name == "__i64_to_f32" { Some(unary(139, WeftIntrinsicI64, WeftIntrinsicF32)) }
  else if name == "__isize_to_f32" { Some(unary(140, WeftIntrinsicIsize, WeftIntrinsicF32)) }
  else if name == "__u8_to_f32" { Some(unary(141, WeftIntrinsicU8, WeftIntrinsicF32)) }
  else if name == "__u16_to_f32" { Some(unary(142, WeftIntrinsicU16, WeftIntrinsicF32)) }
  else if name == "__u32_to_f32" { Some(unary(143, WeftIntrinsicU32, WeftIntrinsicF32)) }
  else if name == "__u64_to_f32" { Some(unary(144, WeftIntrinsicU64, WeftIntrinsicF32)) }
  else if name == "__usize_to_f32" { Some(unary(145, WeftIntrinsicUsize, WeftIntrinsicF32)) }
  else if name == "__f64_to_i64_trunc" { Some(unary(146, WeftIntrinsicF64, WeftIntrinsicI64)) }
  else if name == "__f32_to_f64" { Some(unary(147, WeftIntrinsicF32, WeftIntrinsicF64)) }
  else if name == "__f64_to_f32" { Some(unary(148, WeftIntrinsicF64, WeftIntrinsicF32)) }
  else if name == "__f64_sqrt" { Some(unary(149, WeftIntrinsicF64, WeftIntrinsicF64)) }
  else if name == "__f32_sqrt" { Some(unary(150, WeftIntrinsicF32, WeftIntrinsicF32)) }
  else { None<WeftIntrinsicContract>() }
}

fn platform_intrinsic(name: str) -> Option<WeftIntrinsicContract> {
  if name == "__platform_read" { Some(fixed_i64(200, 3)) }
  else if name == "__platform_write" { Some(fixed_i64(201, 3)) }
  else if name == "__platform_open_read" { Some(fixed_i64(202, 1)) }
  else if name == "__platform_open_write_create_new" { Some(fixed_i64(203, 2)) }
  else if name == "__platform_open_write_create_truncate" { Some(fixed_i64(204, 2)) }
  else if name == "__platform_open_write_append" { Some(fixed_i64(205, 2)) }
  else if name == "__platform_open_read_write_create_truncate" {
    Some(fixed_i64(206, 2))
