pub(package) fn weft_intrinsic_contract(name: Span) -> Option<WeftIntrinsicContract> {
  match name.text() {
    None -> None<WeftIntrinsicContract>()
    Some(spelling) -> {
      let resolved = if spelling == "__str_ptr" {
        Some(trusted_unary(1, WeftIntrinsicStr, WeftIntrinsicI64))
      } else if spelling == "__str_len" {
        Some(trusted_unary(2, WeftIntrinsicAny, WeftIntrinsicI64))
      } else if spelling == "__syscall" {
        Some(fixed_i64(3, 7))
      } else if spelling == "__mem_load64" {
        Some(trusted_unary(4, WeftIntrinsicAny, WeftIntrinsicI64))
      } else if spelling == "__mem_store64" {
        let parameters = [WeftIntrinsicAny, WeftIntrinsicAny]
        Some(
          contract(
            5,
            list.from_slice(parameters[..]),
            WeftIntrinsicFixedResult(WeftIntrinsicI64),
            WeftTrustedIntrinsic
          )
        )
      } else if spelling == "__mem_load8" {
        Some(trusted_unary(6, WeftIntrinsicAny, WeftIntrinsicI64))
      } else if spelling == "__mem_store8" {
        let parameters = [WeftIntrinsicAny, WeftIntrinsicAny]
        Some(
          contract(
            7,
            list.from_slice(parameters[..]),
            WeftIntrinsicFixedResult(WeftIntrinsicI64),
            WeftTrustedIntrinsic
          )
        )
      } else if spelling == "__mem_load_sized" {
        let parameters = [WeftIntrinsicAny, WeftIntrinsicI64, WeftIntrinsicI64]
        Some(
          contract(
            8,
            list.from_slice(parameters[..]),
            WeftIntrinsicFixedResult(WeftIntrinsicI64),
            WeftTrustedIntrinsic
          )
        )
      } else if spelling == "__mem_store_sized" {
        let parameters = [
          WeftIntrinsicAny,
          WeftIntrinsicI64,
          WeftIntrinsicI64,
          WeftIntrinsicAny
        ]
        Some(
          contract(
            9,
            list.from_slice(parameters[..]),
            WeftIntrinsicFixedResult(WeftIntrinsicI64),
            WeftTrustedIntrinsic
          )
        )
      } else if spelling == "__bump_alloc" {
        Some(trusted_unary(10, WeftIntrinsicI64, WeftIntrinsicI64))
      } else if spelling == "__runtime_state" {
        Some(fixed_i64(11, 0))
      } else if spelling == "__transmute" {
        let parameters = [WeftIntrinsicAny]
        Some(
          contract(
            12,
            list.from_slice(parameters[..]),
            WeftIntrinsicContextualResult,
            WeftTrustedIntrinsic
          )
        )
      } else if spelling == "__frame_pointer" {
        Some(fixed_i64(13, 0))
      } else if spelling == "__platform_exit" {
        Some(fixed_i64(14, 1))
      } else if spelling == "__atomic_lock64" {
        Some(fixed_i64(15, 1))
      } else if spelling == "__atomic_unlock64" {
        Some(fixed_i64(16, 1))
      } else if spelling == "__call_i64" {
        Some(fixed_i64(17, 2))
      } else if spelling == "__call_closure_i64" {
        Some(fixed_i64(18, 2))
      } else if spelling == "__set_runtime_state" {
        Some(fixed_i64(21, 1))
      } else if spelling == "__set_handler_stack" {
        Some(fixed_i64(22, 1))
      } else if spelling == "__fiber_trampoline" {
        Some(fixed_i64(23, 3))
      } else if spelling == "__fiber_suspend" {
        Some(fixed_i64(24, 1))
      } else if spelling == "__fiber_resume" {
        Some(fixed_i64(25, 2))
      } else if spelling == "__fiber_is_done" {
        Some(fixed_i64(26, 0))
      } else if spelling == "__rc_from_word" {
        Some(trusted_unary(27, WeftIntrinsicI64, WeftIntrinsicRcI64))
      } else if spelling == "__raw_offset" {
        let parameters = [WeftIntrinsicAny, WeftIntrinsicI64]
        Some(
          contract(
            19,
            list.from_slice(parameters[..]),
            WeftIntrinsicContextualResult,
            WeftTrustedIntrinsic
          )
        )
      } else if spelling == "__int_to_ptr" {
        let parameters = [WeftIntrinsicI64]
        Some(
          contract(
            20,
            list.from_slice(parameters[..]),
            WeftIntrinsicContextualResult,
            WeftTrustedIntrinsic
          )
        )
      } else {
        match numeric_cast(spelling) {
          Some(found) -> Some(found)
          None -> platform_intrinsic(spelling)
        }
      }
      match resolved {
        None -> None<WeftIntrinsicContract>()
        Some(found) -> Some(
          WeftIntrinsicContract {
            identity: intrinsic_identity_with_native_key(found.identity, spelling.hash()),
            parameters: found.parameters,
            result: found.result,
            authority: found.authority
          }
        )
      }
    }
  }
}

pub(package) fn weft_intrinsic_contextual_effect_result(operation: str) -> bool {
  operation == "raw_offset" or operation == "transmute" or operation == "int_to_ptr"
}
