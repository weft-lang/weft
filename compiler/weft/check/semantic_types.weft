-- Resolution of authored Weft type syntax into the immutable semantic graph.
--
-- This module deliberately has no dependency on the legacy pointer-shaped
-- type algebra. Declaration-independent syntax can therefore feed typed
-- signature and body checking before production changes representation.

use compiler/ir/data.{*}
use compiler/project/identity.{
  DeclarationIdentity,
  DeclarationNamespace,
  EffectDeclaration,
  MemberDeclarationIdentity,
  ModuleDeclarationIdentity,
  ModuleIdentity,
  TraitDeclaration,
  TypeDeclaration
}
use compiler/project/identity/equality.{declaration_identity_eq}
use compiler/types/graph.{*}
use compiler/weft/check/registration/catalog.{
  RegisteredDeclarationKind,
  RegisteredModule,
  RegisteredName,
  RegisteredType,
  RegisteredAliasType,
  RegisteredOpaqueType,
  RegisteredRecordType,
  RegisteredTypeDeclaration,
  RegisteredVariantType
}
use compiler/weft/check/registration/scope.{
  RegistrationScope,
  registration_scope_find,
  registration_scope_lookup_declaration_span,
  registration_scope_lookup_qualified_declaration_span
}
use compiler/weft/check/storage.{dense_index}
use compiler/weft/syntax/declarations.{FunctionSyntax}
use stdlib/list.{Cons, List, Nil}
use stdlib/option.{None, Some}
use stdlib/source.{Source}

pub(package) type SemanticTypeResolutionIssue {
  SemanticInvalidPrimitive(i64),
  SemanticInvalidVariable(i64),
  SemanticInvalidArrayLength(i64),
  SemanticMissingAuthoredType,
  SemanticExpectedRecordField,
  SemanticInvalidRecordFieldRange(TypeNameRange),
  SemanticTypeArgumentCount(usize, usize),
  SemanticDefinitionExpansionRequired(DeclarationIdentity),
  SemanticRecursiveTypeDefinition(DeclarationIdentity),
  SemanticDeclarationResolutionRequired,
  SemanticUnsupportedAuthoredType(i64)
}

pub(package) type SemanticTypeResolution {
  SemanticTypeResolved(SemanticTypeId),
  SemanticTypeRejected(SemanticTypeResolutionIssue)
}

type SemanticTypeValuesResolution {
  SemanticTypeValuesResolved(List<SemanticTypeId>),
  SemanticTypeValuesRejected(SemanticTypeResolutionIssue)
}

type SemanticTypeListResolution {
  SemanticTypeListResolved(SemanticTypeListId),
  SemanticTypeListRejected(SemanticTypeResolutionIssue)
}

type SemanticRecordFieldsResolution {
  SemanticRecordFieldsResolved(List<str>, List<SemanticTypeId>),
  SemanticRecordFieldsRejected(SemanticTypeResolutionIssue)
}

type SemanticTypeEnvironment {
  SemanticTypesWithoutScope(Source),
  SemanticTypesInScope(
    RegisteredModule,
    RegistrationScope,
    List<DeclarationIdentity>
  )
}

fn environment_source(environment: SemanticTypeEnvironment) -> Source {
  match environment {
    SemanticTypesWithoutScope(source) -> source
    SemanticTypesInScope(module, _, _) -> module.source
  }
}

fn environment_declaration(
  environment: SemanticTypeEnvironment,
  namespace: DeclarationNamespace,
  range: TypeNameRange
) -> RegisteredName? {
  match environment {
    SemanticTypesWithoutScope(_) -> nil
    SemanticTypesInScope(module, scope, _) -> match module.source.span(
      __i64_to_usize(range.start),
      __i64_to_usize(range.start + range.length)
    ) {
      Some(name) -> match registration_scope_lookup_declaration_span(
        scope,
        module.identity,
        namespace,
        name
      ) {
        Some(registered) -> return registered
        None -> nil
      }
      None -> nil
    }
  }
}

fn environment_qualified_declaration(
  environment: SemanticTypeEnvironment,
  namespace: DeclarationNamespace,
  qualifier: TypeNameRange,
  range: TypeNameRange
) -> RegisteredName? {
  match environment {
    SemanticTypesWithoutScope(_) -> nil
    SemanticTypesInScope(module, scope, _) -> match (
      module.source.span(
        __i64_to_usize(qualifier.start),
        __i64_to_usize(qualifier.start + qualifier.length)
      ),
      module.source.span(
        __i64_to_usize(range.start),
        __i64_to_usize(range.start + range.length)
      )
    ) {
      (Some(qualifier_span), Some(name_span)) ->
        match registration_scope_lookup_qualified_declaration_span(
          scope,
          module.identity,
          qualifier_span,
          namespace,
          name_span
        ) {
          Some(registered) -> return registered
          None -> nil
        }
      _ -> nil
    }
  }
  nil
}

fn declaration_module(identity: DeclarationIdentity) -> ModuleIdentity {
  match identity {
    ModuleDeclarationIdentity(module, _, _) -> module
    MemberDeclarationIdentity(owner, _, _) -> declaration_module(owner)
  }
}

fn expansion_contains(
  expansions: List<DeclarationIdentity>,
  identity: DeclarationIdentity
) -> bool {
  match expansions {
    Nil -> false
    Cons(found, rest) -> if declaration_identity_eq(found, identity) { true }
    else { expansion_contains(rest, identity) }
  }
}

fn environment_for_definition(
  environment: SemanticTypeEnvironment,
  identity: DeclarationIdentity
) -> SemanticTypeEnvironment? {
  match environment {
    SemanticTypesWithoutScope(_) -> nil
    SemanticTypesInScope(_, scope, expansions) -> if expansion_contains(
      expansions,
      identity
    ) { nil }
    else {
      match registration_scope_find(scope, declaration_module(identity)) {
        Some(module) -> return SemanticTypesInScope(
          module,
          scope,
          Cons(identity, expansions)
        )
        None -> nil
      }
    }
  }
  nil
}

fn registered_type_name(ty: RegisteredType) -> RegisteredName {
  match ty {
    RegisteredRecordType(name, _, _) -> name
    RegisteredVariantType(name, _, _) -> name
    RegisteredOpaqueType(name, _, _) -> name
    RegisteredAliasType(name, _, _) -> name
  }
}

fn registered_type_parameters(ty: RegisteredType) -> TypeParamList {
  match ty {
    RegisteredRecordType(_, parameters, _) -> parameters
    RegisteredVariantType(_, parameters, _) -> parameters
    RegisteredOpaqueType(_, parameters, _) -> parameters
    RegisteredAliasType(_, parameters, _) -> parameters
  }
}

fn environment_registered_type(
  environment: SemanticTypeEnvironment,
  identity: DeclarationIdentity
) -> RegisteredType? {
  match environment {
    SemanticTypesWithoutScope(_) -> nil
    SemanticTypesInScope(_, scope, _) -> match registration_scope_find(
      scope,
      declaration_module(identity)
    ) {
      Some(module) -> {
        let declarations = module.declarations
        let mut index: usize = 0
        while index < declarations.len() {
          let declaration = declarations.at(dense_index(index))
          match declaration.kind {
            RegisteredTypeDeclaration(registered) -> if declaration_identity_eq(
              registered_type_name(registered).identity,
              identity
            ) { return registered } else { nil }
            _ -> nil
          }
          index = index + 1
        }
        nil
      }
      None -> nil
    }
  }
}

fn primitive_from_authored(code: i64) -> SemanticPrimitive? {
  match code {
    0 -> return SemanticI64
    1 -> return SemanticStr
    2 -> return SemanticBool
    3 -> return SemanticNil
    4 -> return SemanticF64
    5 -> return SemanticI32
    6 -> return SemanticI8
    7 -> return SemanticI16
    8 -> return SemanticU8
    9 -> return SemanticU16
    10 -> return SemanticU32
    11 -> return SemanticU64
    12 -> return SemanticIsize
    13 -> return SemanticUsize
    14 -> return SemanticF32
    _ -> nil
  }
  nil
}

fn semantic_mutability(access: TypeAccess) -> SemanticMutability {
  match access {
    ReadOnlyTypeAccess -> SemanticImmutable
    MutableTypeAccess -> SemanticMutable
  }
}

fn record_openness(extent: TypeRecordExtent) -> SemanticRecordOpenness {
  match extent {
    ExactTypeFields -> SemanticClosedRecord
    AdditionalTypeFields -> SemanticOpenRecord
  }
}

fn resolve_type_values(
  builder: owned SemanticTypeGraphBuilder,
  environment: SemanticTypeEnvironment,
  values: TypeExprList
) -> (owned SemanticTypeGraphBuilder, SemanticTypeValuesResolution) {
  match values {
    TypeExprListNil -> (builder, SemanticTypeValuesResolved(Nil<SemanticTypeId>()))
    TypeExprListCons(value, rest, _) -> match resolve_type_with(
      builder,
      environment,
      value
    ) {
      (builder, SemanticTypeResolved(resolved)) -> match resolve_type_values(
        builder,
        environment,
        rest
      ) {
        (builder, SemanticTypeValuesResolved(resolved_rest)) -> (
          builder,
          SemanticTypeValuesResolved(Cons(resolved, resolved_rest))
        )
        (builder, SemanticTypeValuesRejected(issue)) -> (
          builder,
          SemanticTypeValuesRejected(issue)
        )
      }
      (builder, SemanticTypeRejected(issue)) -> (
        builder,
        SemanticTypeValuesRejected(issue)
      )
    }
  }
}

fn resolve_type_list(
  builder: owned SemanticTypeGraphBuilder,
  environment: SemanticTypeEnvironment,
  values: TypeExprList
) -> (owned SemanticTypeGraphBuilder, SemanticTypeListResolution) {
  match resolve_type_values(builder, environment, values) {
    (builder, SemanticTypeValuesResolved(resolved)) -> {
      let (builder, list) = builder.type_list(resolved)
      (builder, SemanticTypeListResolved(list))
    }
    (builder, SemanticTypeValuesRejected(issue)) -> (builder, SemanticTypeListRejected(issue))
  }
}

fn required_field_name(source: Source, range: TypeNameRange) -> Option<str> {
  let end = range.start + range.length
  if range.start < 0 or range.length < 0 or end < range.start { None<str>() }
  else {
    match source.span(
      __i64_to_usize(range.start),
      __i64_to_usize(end)
    ) {
      Some(span) -> span.text()
      None -> None<str>()
    }
  }
}

fn resolve_named_record_fields(
  builder: owned SemanticTypeGraphBuilder,
  environment: SemanticTypeEnvironment,
  fields: TypeExprList
) -> (owned SemanticTypeGraphBuilder, SemanticRecordFieldsResolution) {
  match fields {
    TypeExprListNil -> (
      builder,
      SemanticRecordFieldsResolved(Nil<str>(), Nil<SemanticTypeId>())
    )
    TypeExprListCons(field, rest, _) -> match field {
      RecordFieldTypeExpr(_, annotation, range) -> match required_field_name(
        environment_source(environment),
        range
      ) {
        Some(name) -> match resolve_type_with(builder, environment, annotation) {
          (builder, SemanticTypeResolved(resolved)) -> match resolve_named_record_fields(
            builder,
            environment,
            rest
          ) {
            (builder, SemanticRecordFieldsResolved(names, values)) -> (
              builder,
              SemanticRecordFieldsResolved(Cons(name, names), Cons(resolved, values))
            )
            (builder, SemanticRecordFieldsRejected(issue)) -> (
              builder,
              SemanticRecordFieldsRejected(issue)
            )
          }
          (builder, SemanticTypeRejected(issue)) -> (
            builder,
            SemanticRecordFieldsRejected(issue)
          )
        }
        None -> (
          builder,
          SemanticRecordFieldsRejected(SemanticInvalidRecordFieldRange(range))
        )
      }
      _ -> (
        builder,
        SemanticRecordFieldsRejected(SemanticExpectedRecordField)
      )
    }
  }
}

fn resolve_tuple_fields(
  builder: owned SemanticTypeGraphBuilder,
  environment: SemanticTypeEnvironment,
  fields: TypeExprList
) -> (owned SemanticTypeGraphBuilder, SemanticTypeValuesResolution) {
  match fields {
    TypeExprListNil -> (builder, SemanticTypeValuesResolved(Nil<SemanticTypeId>()))
    TypeExprListCons(field, rest, _) -> match field {
      RecordFieldTypeExpr(_, annotation, _) -> match resolve_type_with(
        builder,
        environment,
        annotation
      ) {
        (builder, SemanticTypeResolved(resolved)) -> match resolve_tuple_fields(
          builder,
          environment,
          rest
        ) {
          (builder, SemanticTypeValuesResolved(values)) -> (
            builder,
            SemanticTypeValuesResolved(Cons(resolved, values))
          )
          (builder, SemanticTypeValuesRejected(issue)) -> (
            builder,
            SemanticTypeValuesRejected(issue)
          )
        }
        (builder, SemanticTypeRejected(issue)) -> (
          builder,
          SemanticTypeValuesRejected(issue)
        )
      }
      _ -> (
        builder,
        SemanticTypeValuesRejected(SemanticExpectedRecordField)
      )
    }
  }
}

fn resolve_binary(
  builder: owned SemanticTypeGraphBuilder,
  environment: SemanticTypeEnvironment,
  left: TypeExpr,
  right: TypeExpr,
  intersection: bool
) -> (owned SemanticTypeGraphBuilder, SemanticTypeResolution) {
  match resolve_type_with(builder, environment, left) {
    (builder, SemanticTypeResolved(resolved_left)) -> match resolve_type_with(
      builder,
      environment,
      right
    ) {
      (builder, SemanticTypeResolved(resolved_right)) -> {
        let (builder, result) = if intersection {
          builder.intersection(resolved_left, resolved_right)
        } else { builder.union(resolved_left, resolved_right) }
        (builder, SemanticTypeResolved(result))
      }
      (builder, SemanticTypeRejected(issue)) -> (builder, SemanticTypeRejected(issue))
    }
    (builder, SemanticTypeRejected(issue)) -> (builder, SemanticTypeRejected(issue))
  }
}

fn resolve_unary(
  builder: owned SemanticTypeGraphBuilder,
  environment: SemanticTypeEnvironment,
  inner: TypeExpr,
  kind: i64
) -> (owned SemanticTypeGraphBuilder, SemanticTypeResolution) {
  match resolve_type_with(builder, environment, inner) {
    (builder, SemanticTypeResolved(resolved)) -> {
      let (builder, result) = match kind {
        0 -> builder.complement(resolved)
        1 -> builder.weak(resolved)
        2 -> builder.atomic(resolved)
        3 -> builder.unique(resolved)
        _ -> builder.owned(resolved)
      }
      (builder, SemanticTypeResolved(result))
    }
    (builder, SemanticTypeRejected(issue)) -> (builder, SemanticTypeRejected(issue))
  }
}

fn resolve_mutable_unary(
  builder: owned SemanticTypeGraphBuilder,
  environment: SemanticTypeEnvironment,
  inner: TypeExpr,
  access: TypeAccess,
  kind: i64
) -> (owned SemanticTypeGraphBuilder, SemanticTypeResolution) {
  match resolve_type_with(builder, environment, inner) {
    (builder, SemanticTypeResolved(resolved)) -> {
      let mutability = semantic_mutability(access)
      let (builder, result) = match kind {
        0 -> builder.pointer(resolved, mutability)
        1 -> builder.borrow(resolved, mutability)
        _ -> builder.slice(resolved, mutability)
      }
      (builder, SemanticTypeResolved(result))
    }
    (builder, SemanticTypeRejected(issue)) -> (builder, SemanticTypeRejected(issue))
  }
}

fn resolve_effect_atom(
  builder: owned SemanticTypeGraphBuilder,
  environment: SemanticTypeEnvironment,
  atom: TypeExpr
) -> (owned SemanticTypeGraphBuilder, SemanticTypeResolution) {
  let declaration = match atom {
    UnqualifiedEffectTypeExpr(_, _, range) -> environment_declaration(
      environment,
      EffectDeclaration,
      range
    )
    QualifiedEffectTypeExpr(qualifier, range, _) -> environment_qualified_declaration(
      environment,
      EffectDeclaration,
      qualifier,
      range
    )
    _ -> nil
  }
  match declaration {
    registered: RegisteredName -> {
      let arguments = match atom {
        UnqualifiedEffectTypeExpr(_, values, _) -> values
        QualifiedEffectTypeExpr(_, _, values) -> values
        _ -> TypeExprListNil
      }
      match resolve_type_list(builder, environment, arguments) {
        (builder, SemanticTypeListResolved(resolved_arguments)) -> {
          let (builder, resolved) = builder.effect_atom(
            registered.identity,
            resolved_arguments
          )
          (builder, SemanticTypeResolved(resolved))
        }
        (builder, SemanticTypeListRejected(issue)) -> (
          builder,
          SemanticTypeRejected(issue)
        )
      }
    }
    nil -> (builder, SemanticTypeRejected(SemanticDeclarationResolutionRequired))
  }
}

fn resolve_effect_atoms(
  builder: owned SemanticTypeGraphBuilder,
  environment: SemanticTypeEnvironment,
  atoms: TypeExprList
) -> (owned SemanticTypeGraphBuilder, SemanticTypeValuesResolution) {
  match atoms {
    TypeExprListNil -> (builder, SemanticTypeValuesResolved(Nil<SemanticTypeId>()))
    TypeExprListCons(atom, rest, _) -> match resolve_effect_atom(
      builder,
      environment,
      atom
    ) {
      (builder, SemanticTypeResolved(resolved)) -> match resolve_effect_atoms(
        builder,
        environment,
        rest
      ) {
        (builder, SemanticTypeValuesResolved(resolved_rest)) -> (
          builder,
          SemanticTypeValuesResolved(Cons(resolved, resolved_rest))
        )
        (builder, SemanticTypeValuesRejected(issue)) -> (
          builder,
          SemanticTypeValuesRejected(issue)
        )
      }
      (builder, SemanticTypeRejected(issue)) -> (
        builder,
        SemanticTypeValuesRejected(issue)
      )
    }
  }
}

fn resolve_effect_set(
  builder: owned SemanticTypeGraphBuilder,
  environment: SemanticTypeEnvironment,
  atoms: TypeExprList,
  tail: i64
) -> (owned SemanticTypeGraphBuilder, SemanticTypeResolution) {
  if tail < 0 { (builder, SemanticTypeRejected(SemanticInvalidVariable(tail))) }
  else {
    match resolve_effect_atoms(builder, environment, atoms) {
      (builder, SemanticTypeValuesResolved(resolved_atoms)) -> {
        let (builder, effects) = builder.type_list(resolved_atoms)
        let semantic_tail = if tail == 0 { SemanticClosedEffects }
        else { SemanticOpenEffects(__i64_to_usize(tail - 1)) }
        let (builder, result) = builder.effect_signature(effects, semantic_tail)
        (builder, SemanticTypeResolved(result))
      }
      (builder, SemanticTypeValuesRejected(issue)) -> (
        builder,
        SemanticTypeRejected(issue)
      )
    }
  }
}

fn resolve_trait_atom(
  builder: owned SemanticTypeGraphBuilder,
  environment: SemanticTypeEnvironment,
  ty: TypeExpr
) -> (owned SemanticTypeGraphBuilder, SemanticTypeResolution) {
  let declaration = match ty {
    UnqualifiedTraitTypeExpr(_, range) -> environment_declaration(
      environment,
      TraitDeclaration,
      range
    )
    QualifiedTraitTypeExpr(qualifier, range) -> environment_qualified_declaration(
      environment,
      TraitDeclaration,
      qualifier,
      range
    )
    _ -> nil
  }
  match declaration {
    registered: RegisteredName -> {
      let (builder, resolved) = builder.trait_atom(registered.identity)
      (builder, SemanticTypeResolved(resolved))
    }
    nil -> (builder, SemanticTypeRejected(SemanticDeclarationResolutionRequired))
  }
}

fn resolve_named_declaration(
  builder: owned SemanticTypeGraphBuilder,
  environment: SemanticTypeEnvironment,
  declaration: RegisteredName,
  arguments: TypeExprList
) -> (owned SemanticTypeGraphBuilder, SemanticTypeResolution) {
  match environment_registered_type(environment, declaration.identity) {
    registered: RegisteredType -> {
      let expected = __i64_to_usize(
        type_param_list_len(registered_type_parameters(registered))
      )
      let actual = __i64_to_usize(type_expr_list_len(arguments))
      if expected != actual {
        (builder, SemanticTypeRejected(SemanticTypeArgumentCount(expected, actual)))
      } else {
        match registered {
          RegisteredRecordType(_, _, _) -> match resolve_type_list(
            builder,
            environment,
            arguments
          ) {
            (builder, SemanticTypeListResolved(resolved_arguments)) -> {
              let (builder, representation) = builder.top()
              let (builder, resolved) = builder.named(
                declaration.identity,
                SemanticNominalType,
                representation,
                resolved_arguments
              )
              (builder, SemanticTypeResolved(resolved))
            }
            (builder, SemanticTypeListRejected(issue)) -> (
              builder,
              SemanticTypeRejected(issue)
            )
          }
          RegisteredVariantType(_, _, _) -> match resolve_type_list(
            builder,
            environment,
            arguments
          ) {
            (builder, SemanticTypeListResolved(resolved_arguments)) -> {
              let (builder, representation) = builder.top()
              let (builder, resolved) = builder.named(
                declaration.identity,
                SemanticNominalType,
                representation,
                resolved_arguments
              )
              (builder, SemanticTypeResolved(resolved))
            }
            (builder, SemanticTypeListRejected(issue)) -> (
              builder,
              SemanticTypeRejected(issue)
            )
          }
          RegisteredOpaqueType(_, _, representation) -> if expected != 0 {
            (
              builder,
              SemanticTypeRejected(
                SemanticDefinitionExpansionRequired(declaration.identity)
              )
            )
          } else {
            match environment_for_definition(environment, declaration.identity) {
              definition: SemanticTypeEnvironment -> match resolve_type_with(
                builder,
                definition,
                representation
              ) {
                (builder, SemanticTypeResolved(resolved_representation)) -> {
                  let (builder, resolved_arguments) = builder.type_list(
                    Nil<SemanticTypeId>()
                  )
                  let (builder, resolved) = builder.named(
                    declaration.identity,
                    SemanticOpaqueType,
                    resolved_representation,
                    resolved_arguments
                  )
                  (builder, SemanticTypeResolved(resolved))
                }
                (builder, SemanticTypeRejected(issue)) -> (
                  builder,
                  SemanticTypeRejected(issue)
                )
              }
              nil -> (
                builder,
                SemanticTypeRejected(
                  SemanticRecursiveTypeDefinition(declaration.identity)
                )
              )
            }
          }
          RegisteredAliasType(_, _, target) -> if expected != 0 {
            (
              builder,
              SemanticTypeRejected(
                SemanticDefinitionExpansionRequired(declaration.identity)
              )
            )
          } else {
            match environment_for_definition(environment, declaration.identity) {
              definition: SemanticTypeEnvironment -> resolve_type_with(
                builder,
                definition,
                target
              )
              nil -> (
                builder,
                SemanticTypeRejected(
                  SemanticRecursiveTypeDefinition(declaration.identity)
                )
              )
            }
          }
        }
      }
    }
    nil -> (builder, SemanticTypeRejected(SemanticDeclarationResolutionRequired))
  }
}

fn resolve_unqualified_named(
  builder: owned SemanticTypeGraphBuilder,
  environment: SemanticTypeEnvironment,
  arguments: TypeExprList,
  range: TypeNameRange
) -> (owned SemanticTypeGraphBuilder, SemanticTypeResolution) {
  match environment_declaration(environment, TypeDeclaration, range) {
    declaration: RegisteredName -> resolve_named_declaration(
      builder,
      environment,
      declaration,
      arguments
    )
    nil -> (builder, SemanticTypeRejected(SemanticDeclarationResolutionRequired))
  }
}

fn resolve_qualified_named(
  builder: owned SemanticTypeGraphBuilder,
  environment: SemanticTypeEnvironment,
  base: TypeExpr,
  range: TypeNameRange
) -> (owned SemanticTypeGraphBuilder, SemanticTypeResolution) {
  match base {
    NamedTypeExpr(_, _, arguments, SourceTypeOrigin(qualifier)) -> {
      let member_start = qualifier.start + qualifier.length + 1
      let member_length = range.start + range.length - member_start
      if member_length <= 0 {
        (builder, SemanticTypeRejected(SemanticDeclarationResolutionRequired))
      } else {
        let member = TypeNameRange { start: member_start, length: member_length }
        match environment_qualified_declaration(
          environment,
          TypeDeclaration,
          qualifier,
          member
        ) {
          declaration: RegisteredName -> resolve_named_declaration(
            builder,
            environment,
            declaration,
            arguments
          )
          nil -> (builder, SemanticTypeRejected(SemanticDeclarationResolutionRequired))
        }
      }
    }
    _ -> (builder, SemanticTypeRejected(SemanticDeclarationResolutionRequired))
  }
}

fn resolve_function_type(
  builder: owned SemanticTypeGraphBuilder,
  environment: SemanticTypeEnvironment,
  parameters: TypeExprList,
  result: TypeExpr,
  effects: TypeExpr
) -> (owned SemanticTypeGraphBuilder, SemanticTypeResolution) {
  match resolve_type_list(builder, environment, parameters) {
    (builder, SemanticTypeListResolved(parameter_types)) -> match resolve_type_with(
      builder,
      environment,
      result
    ) {
      (builder, SemanticTypeResolved(result_type)) -> match effects {
        EffectSetTypeExpr(atoms, tail) -> match resolve_effect_set(
          builder,
          environment,
          atoms,
          tail
        ) {
          (builder, SemanticTypeResolved(effect_type)) -> {
            let (builder, function) = builder.function(
              parameter_types,
              result_type,
              effect_type
            )
            (builder, SemanticTypeResolved(function))
          }
          (builder, SemanticTypeRejected(issue)) -> (builder, SemanticTypeRejected(issue))
        }
        _ -> (builder, SemanticTypeRejected(SemanticUnsupportedAuthoredType(6)))
      }
      (builder, SemanticTypeRejected(issue)) -> (builder, SemanticTypeRejected(issue))
    }
    (builder, SemanticTypeListRejected(issue)) -> (builder, SemanticTypeRejected(issue))
  }
}

fn resolve_type_with(
  builder: owned SemanticTypeGraphBuilder,
  environment: SemanticTypeEnvironment,
  ty: TypeExpr
) -> (owned SemanticTypeGraphBuilder, SemanticTypeResolution) {
  match ty {
    NeverTypeExpr -> {
      let (builder, resolved) = builder.bottom()
      (builder, SemanticTypeResolved(resolved))
    }
    AnyTypeExpr -> {
      let (builder, resolved) = builder.top()
      (builder, SemanticTypeResolved(resolved))
    }
    PrimitiveTypeExpr(code) -> match primitive_from_authored(code) {
      primitive: SemanticPrimitive -> {
        let (builder, resolved) = builder.primitive(primitive)
        (builder, SemanticTypeResolved(resolved))
      }
      nil -> (builder, SemanticTypeRejected(SemanticInvalidPrimitive(code)))
    }
    UnionTypeExpr(left, right) -> resolve_binary(builder, environment, left, right, false)
    IntersectionTypeExpr(left, right) -> resolve_binary(
      builder,
      environment,
      left,
      right,
      true
    )
    ComplementTypeExpr(inner) -> resolve_unary(builder, environment, inner, 0)
    FunctionTypeExpr(parameters, result, effects) -> resolve_function_type(
      builder,
      environment,
      parameters,
      result,
      effects
    )
    RecordTypeExpr(fields, extent, NamedTypeFields) -> match resolve_named_record_fields(
      builder,
      environment,
      fields
    ) {
      (builder, SemanticRecordFieldsResolved(names, values)) -> {
        let (builder, resolved) = builder.record(names, values, record_openness(extent))
        (builder, SemanticTypeResolved(resolved))
      }
      (builder, SemanticRecordFieldsRejected(issue)) -> (
        builder,
        SemanticTypeRejected(issue)
      )
    }
    RecordTypeExpr(fields, _, PositionalTypeFields) -> match resolve_tuple_fields(
      builder,
      environment,
      fields
    ) {
      (builder, SemanticTypeValuesResolved(values)) -> {
        let (builder, resolved) = builder.tuple(values)
        (builder, SemanticTypeResolved(resolved))
      }
      (builder, SemanticTypeValuesRejected(issue)) -> (
        builder,
        SemanticTypeRejected(issue)
      )
    }
    NamedTypeExpr(_, _, arguments, SourceTypeOrigin(range)) -> resolve_unqualified_named(
      builder,
      environment,
      arguments,
      range
    )
    SourceAssociatedTypeExpr(base, _, range) -> resolve_qualified_named(
      builder,
      environment,
      base,
      range
    )
    UnqualifiedEffectTypeExpr(_, _, _) -> resolve_effect_atom(builder, environment, ty)
    QualifiedEffectTypeExpr(_, _, _) -> resolve_effect_atom(builder, environment, ty)
    EffectSetTypeExpr(atoms, tail) -> resolve_effect_set(
      builder,
      environment,
      atoms,
      tail
    )
    UnqualifiedTraitTypeExpr(_, _) -> resolve_trait_atom(builder, environment, ty)
    QualifiedTraitTypeExpr(_, _) -> resolve_trait_atom(builder, environment, ty)
    VariableTypeExpr(identity) -> if identity == 0 - 1 {
      let (builder, resolved) = builder.variable(SemanticSelfVariable)
      (builder, SemanticTypeResolved(resolved))
    } else {
      if identity >= 0 {
        let (builder, resolved) = builder.variable(
          SemanticParameterVariable(__i64_to_usize(identity))
        )
        (builder, SemanticTypeResolved(resolved))
      } else { (builder, SemanticTypeRejected(SemanticInvalidVariable(identity))) }
    }
    ContinuationTypeExpr(input, result) -> match resolve_type_with(
      builder,
      environment,
      input
    ) {
      (builder, SemanticTypeResolved(resolved_input)) -> match resolve_type_with(
        builder,
        environment,
        result
      ) {
        (builder, SemanticTypeResolved(resolved_result)) -> {
          let (builder, resolved) = builder.continuation(resolved_input, resolved_result)
          (builder, SemanticTypeResolved(resolved))
        }
        (builder, SemanticTypeRejected(issue)) -> (builder, SemanticTypeRejected(issue))
      }
      (builder, SemanticTypeRejected(issue)) -> (builder, SemanticTypeRejected(issue))
    }
    PointerTypeExpr(inner, access) -> resolve_mutable_unary(
      builder,
      environment,
      inner,
      access,
      0
    )
    BorrowTypeExpr(inner, access) -> resolve_mutable_unary(
      builder,
      environment,
      inner,
      access,
      1
    )
    SliceTypeExpr(inner, access) -> resolve_mutable_unary(
      builder,
      environment,
      inner,
      access,
      2
    )
    WeakTypeExpr(inner) -> resolve_unary(builder, environment, inner, 1)
    AtomicTypeExpr(inner) -> resolve_unary(builder, environment, inner, 2)
    UniqueTypeExpr(inner) -> resolve_unary(builder, environment, inner, 3)
    OwnedTypeExpr(inner) -> resolve_unary(builder, environment, inner, 4)
    ArrayTypeExpr(inner, length) -> if length < 0 {
      (builder, SemanticTypeRejected(SemanticInvalidArrayLength(length)))
    } else {
      match resolve_type_with(builder, environment, inner) {
        (builder, SemanticTypeResolved(element)) -> {
          let (builder, resolved) = builder.array(element, __i64_to_usize(length))
          (builder, SemanticTypeResolved(resolved))
        }
        (builder, SemanticTypeRejected(issue)) -> (builder, SemanticTypeRejected(issue))
      }
    }
    MissingTypeExpr -> (builder, SemanticTypeRejected(SemanticMissingAuthoredType))
    UnsupportedTypeExpr(kind) -> (
      builder,
      SemanticTypeRejected(SemanticUnsupportedAuthoredType(kind))
    )
    _ -> (builder, SemanticTypeRejected(SemanticDeclarationResolutionRequired))
  }
}

pub(package) fn resolve_type(
  builder: owned SemanticTypeGraphBuilder,
  source: Source,
  ty: TypeExpr
) -> (owned SemanticTypeGraphBuilder, SemanticTypeResolution) {
  resolve_type_with(builder, SemanticTypesWithoutScope(source), ty)
}

pub(package) fn resolve_type_in_scope(
  builder: owned SemanticTypeGraphBuilder,
  module: RegisteredModule,
  scope: RegistrationScope,
  ty: TypeExpr
) -> (owned SemanticTypeGraphBuilder, SemanticTypeResolution) {
  resolve_type_with(
    builder,
    SemanticTypesInScope(module, scope, Nil<DeclarationIdentity>()),
    ty
  )
}

fn parameter_types(params: ParamList) -> TypeExprList {
  match params {
    ParamListNil -> TypeExprListNil
    ParamListCons(param, rest) -> match param {
      Param(_, _, annotation, _) -> TypeExprListCons(
        annotation,
        parameter_types(rest),
        nil
      )
      UnknownParam(_) -> TypeExprListCons(
        MissingTypeExpr,
        parameter_types(rest),
        nil
      )
    }
  }
}

fn effect_type(effects: EffectSig) -> TypeExpr {
  match effects {
    EffectSig(atoms, tail) -> EffectSetTypeExpr(atoms, tail)
    MissingEffectSig -> MissingTypeExpr
  }
}

pub(package) fn resolve_function_signature(
  builder: owned SemanticTypeGraphBuilder,
  source: Source,
  function: FunctionSyntax
) -> (owned SemanticTypeGraphBuilder, SemanticTypeResolution) {
  resolve_function_type(
    builder,
    SemanticTypesWithoutScope(source),
    parameter_types(function.params),
    function.result,
    effect_type(function.effects)
  )
}

pub(package) fn resolve_function_signature_in_scope(
  builder: owned SemanticTypeGraphBuilder,
  module: RegisteredModule,
  scope: RegistrationScope,
  function: FunctionSyntax
) -> (owned SemanticTypeGraphBuilder, SemanticTypeResolution) {
  resolve_function_type(
    builder,
    SemanticTypesInScope(module, scope, Nil<DeclarationIdentity>()),
    parameter_types(function.params),
    function.result,
    effect_type(function.effects)
  )
}
