-- Resolution of authored Weft type syntax into the immutable semantic graph.
--
-- This module deliberately has no dependency on the legacy pointer-shaped
-- type algebra. Declaration-independent syntax can therefore feed typed
-- signature and body checking before production changes representation.

use compiler/ir/data.{*}
use compiler/project/identity.{
  DeclarationIdentity,
  DeclarationNamespace,
  EffectDeclaration,
  MemberDeclarationIdentity,
  ModuleDeclarationIdentity,
  ModuleIdentity,
  TraitDeclaration,
  TypeDeclaration,
  declaration_identity_name
}
use compiler/project/identity/equality.{declaration_identity_eq}
use compiler/types/graph.{*}
use compiler/types/graph/catalog.{
  SemanticTypeCatalog,
  semantic_type_catalog_empty,
  semantic_type_catalog_with_graph
}
use compiler/types/graph/substitution.{
  SemanticTypeSubstitution,
  semantic_type_substitute,
  semantic_type_substitution_bind,
  semantic_type_substitution_empty
}
use compiler/weft/check/registration/catalog.{
  RegisteredDeclarationKind,
  RegisteredModule,
  RegisteredName,
  RegisteredTrait,
  RegisteredTraitMember,
  RegisteredAssociatedType,
  RegisteredInvalidTraitMember,
  RegisteredTraitDeclaration,
  RegisteredTraitMethod,
  RegisteredType,
  RegisteredAliasType,
  RegisteredOpaqueType,
  RegisteredRecordType,
  RegisteredTypeDeclaration,
  RegisteredVariantType
}
use compiler/weft/check/registration/scope.{
  RegistrationScope,
  registration_scope_find,
  registration_scope_lookup_declaration_span,
  registration_scope_lookup_qualified_declaration_span
}
use compiler/weft/check/storage.{dense_index}
use compiler/weft/syntax/declarations.{FunctionSyntax}
use stdlib/list.{Cons, List, Nil}
use stdlib/option.{None, Some}
use stdlib/panic.{panic}
use stdlib/source.{Source}
use stdlib/string

pub(package) type SemanticTypeResolutionIssue {
  SemanticInvalidPrimitive(i64),
  SemanticInvalidVariable(i64),
  SemanticInvalidArrayLength(i64),
  SemanticMissingAuthoredType,
  SemanticExpectedRecordField,
  SemanticInvalidRecordFieldRange(TypeNameRange),
  SemanticTypeArgumentCount(usize, usize),
  SemanticDefinitionExpansionRequired(DeclarationIdentity),
  SemanticRecursiveTypeDefinition(DeclarationIdentity),
  SemanticDeclarationResolutionRequired,
  SemanticUnsupportedAuthoredType(i64)
}

pub(package) type SemanticTypeResolution {
  SemanticTypeResolved(SemanticTypeId),
  SemanticTypeRejected(SemanticTypeResolutionIssue)
}

type SemanticTypeProductBuilderStorage {
  owner: ModuleIdentity,
  catalog: SemanticTypeCatalog,
  next_segment: usize
}

pub(package) type SemanticTypeProductBuilder = opaque SemanticTypeProductBuilderStorage

type SemanticTypeValuesResolution {
  SemanticTypeValuesResolved(List<SemanticTypeId>),
  SemanticTypeValuesRejected(SemanticTypeResolutionIssue)
}

type SemanticTypeListResolution {
  SemanticTypeListResolved(SemanticTypeListId),
  SemanticTypeListRejected(SemanticTypeResolutionIssue)
}

type SemanticRecordFieldsResolution {
  SemanticRecordFieldsResolved(List<str>, List<SemanticTypeId>),
  SemanticRecordFieldsRejected(SemanticTypeResolutionIssue)
}

type SemanticTypeEnvironment {
  SemanticTypesWithoutScope(Source),
  SemanticTypesInScope(
    RegisteredModule,
    RegistrationScope,
    List<DeclarationIdentity>,
    TypeParamList,
    TypeExpr?
  )
}

fn environment_source(environment: SemanticTypeEnvironment) -> Source {
  match environment {
    SemanticTypesWithoutScope(source) -> source
    SemanticTypesInScope(module, _, _, _, _) -> module.source
  }
}

fn environment_declaration(
  environment: SemanticTypeEnvironment,
  namespace: DeclarationNamespace,
  range: TypeNameRange
) -> RegisteredName? {
  match environment {
    SemanticTypesWithoutScope(_) -> nil
    SemanticTypesInScope(module, scope, _, _, _) -> match module.source.span(
      __i64_to_usize(range.start),
      __i64_to_usize(range.start + range.length)
    ) {
      Some(name) -> match registration_scope_lookup_declaration_span(
        scope,
        module.identity,
        namespace,
        name
      ) {
        Some(registered) -> return registered
        None -> nil
      }
      None -> nil
    }
  }
}

fn environment_qualified_declaration(
  environment: SemanticTypeEnvironment,
  namespace: DeclarationNamespace,
  qualifier: TypeNameRange,
  range: TypeNameRange
) -> RegisteredName? {
  match environment {
    SemanticTypesWithoutScope(_) -> nil
    SemanticTypesInScope(module, scope, _, _, _) -> match (
      module.source.span(
        __i64_to_usize(qualifier.start),
        __i64_to_usize(qualifier.start + qualifier.length)
      ),
      module.source.span(
        __i64_to_usize(range.start),
        __i64_to_usize(range.start + range.length)
      )
    ) {
      (Some(qualifier_span), Some(name_span)) ->
        match registration_scope_lookup_qualified_declaration_span(
          scope,
          module.identity,
          qualifier_span,
          namespace,
          name_span
        ) {
          Some(registered) -> return registered
          None -> nil
        }
      _ -> nil
    }
  }
  nil
}

fn declaration_module(identity: DeclarationIdentity) -> ModuleIdentity {
  match identity {
    ModuleDeclarationIdentity(module, _, _) -> module
    MemberDeclarationIdentity(owner, _, _) -> declaration_module(owner)
  }
}

fn expansion_contains(
  expansions: List<DeclarationIdentity>,
  identity: DeclarationIdentity
) -> bool {
  match expansions {
    Nil -> false
    Cons(found, rest) -> if declaration_identity_eq(found, identity) { true }
    else { expansion_contains(rest, identity) }
  }
}

fn environment_for_definition(
  environment: SemanticTypeEnvironment,
  identity: DeclarationIdentity,
  parameters: TypeParamList
) -> SemanticTypeEnvironment? {
  match environment {
    SemanticTypesWithoutScope(_) -> nil
    SemanticTypesInScope(_, scope, expansions, _, self_trait) -> if expansion_contains(
      expansions,
      identity
    ) { nil }
    else {
      match registration_scope_find(scope, declaration_module(identity)) {
        Some(module) -> return SemanticTypesInScope(
          module,
          scope,
          Cons(identity, expansions),
          parameters,
          self_trait
        )
        None -> nil
      }
    }
  }
  nil
}

fn registered_type_name(ty: RegisteredType) -> RegisteredName {
  match ty {
    RegisteredRecordType(name, _, _) -> name
    RegisteredVariantType(name, _, _) -> name
    RegisteredOpaqueType(name, _, _) -> name
    RegisteredAliasType(name, _, _) -> name
  }
}

fn registered_type_parameters(ty: RegisteredType) -> TypeParamList {
  match ty {
    RegisteredRecordType(_, parameters, _) -> parameters
    RegisteredVariantType(_, parameters, _) -> parameters
    RegisteredOpaqueType(_, parameters, _) -> parameters
    RegisteredAliasType(_, parameters, _) -> parameters
  }
}

fn environment_registered_type(
  environment: SemanticTypeEnvironment,
  identity: DeclarationIdentity
) -> RegisteredType? {
  match environment {
    SemanticTypesWithoutScope(_) -> nil
    SemanticTypesInScope(_, scope, _, _, _) -> match registration_scope_find(
      scope,
      declaration_module(identity)
    ) {
      Some(module) -> {
        let declarations = module.declarations
        let mut index: usize = 0
        while index < declarations.len() {
          let declaration = declarations.at(dense_index(index))
          match declaration.kind {
            RegisteredTypeDeclaration(registered) -> if declaration_identity_eq(
              registered_type_name(registered).identity,
              identity
            ) { return registered } else { nil }
            _ -> nil
          }
          index = index + 1
        }
        nil
      }
      None -> nil
    }
  }
}

fn environment_registered_trait(
  environment: SemanticTypeEnvironment,
  identity: DeclarationIdentity
) -> RegisteredTrait? {
  match environment {
    SemanticTypesWithoutScope(_) -> nil
    SemanticTypesInScope(_, scope, _, _, _) -> match registration_scope_find(
      scope,
      declaration_module(identity)
    ) {
      Some(module) -> {
        let declarations = module.declarations
        let mut index: usize = 0
        while index < declarations.len() {
          let declaration = declarations.at(dense_index(index))
          match declaration.kind {
            RegisteredTraitDeclaration(registered) -> if declaration_identity_eq(
              registered.name.identity,
              identity
            ) { return registered } else { nil }
            _ -> nil
          }
          index = index + 1
        }
        nil
      }
      None -> nil
    }
  }
}

fn environment_type_parameters(
  environment: SemanticTypeEnvironment
) -> TypeParamList {
  match environment {
    SemanticTypesWithoutScope(_) -> TypeParamListNil
    SemanticTypesInScope(_, _, _, parameters, _) -> parameters
  }
}

fn environment_self_trait(environment: SemanticTypeEnvironment) -> TypeExpr? {
  match environment {
    SemanticTypesWithoutScope(_) -> nil
    SemanticTypesInScope(_, _, _, _, self_trait) -> self_trait
  }
}

fn type_parameter_bounds_by_identity(
  parameters: TypeParamList,
  identity: i64
) -> TypeParamBoundList? {
  match parameters {
    TypeParamListNil -> nil
    TypeParamListCons(parameter, rest) -> match parameter {
      TypeParam(_, _, found, bounds) -> if found == identity { return bounds }
      else { type_parameter_bounds_by_identity(rest, identity) }
      MissingTypeParam -> type_parameter_bounds_by_identity(rest, identity)
    }
  }
}

fn trait_declaration_for(
  environment: SemanticTypeEnvironment,
  ty: TypeExpr
) -> RegisteredName? {
  match ty {
    UnqualifiedTraitTypeExpr(_, range) -> environment_declaration(
      environment,
      TraitDeclaration,
      range
    )
    QualifiedTraitTypeExpr(qualifier, range) -> environment_qualified_declaration(
      environment,
      TraitDeclaration,
      qualifier,
      range
    )
    ConstraintTypeExpr(constraint, _) -> trait_declaration_for(environment, constraint)
    _ -> nil
  }
}

fn registered_trait_associated_member(
  trait_value: RegisteredTrait,
  spelling: str
) -> RegisteredName? {
  for member in trait_value.members {
    match member {
      RegisteredAssociatedType(name, _) -> if match declaration_identity_name(
        name.identity
      ).text() {
        Some(candidate) -> candidate == spelling
        None -> false
      } { return name } else { nil }
      RegisteredTraitMethod(_, _) -> nil
      RegisteredInvalidTraitMember(_) -> nil
    }
  }
  nil
}

fn associated_declaration_from_bounds(
  environment: SemanticTypeEnvironment,
  bounds: TypeParamBoundList,
  spelling: str
) -> RegisteredName? {
  match bounds {
    TypeParamBoundListNil -> nil
    TypeParamBoundListCons(bound, _, rest) -> match trait_declaration_for(
      environment,
      bound
    ) {
      registered: RegisteredName -> match environment_registered_trait(
        environment,
        registered.identity
      ) {
        trait_value: RegisteredTrait -> match registered_trait_associated_member(
          trait_value,
          spelling
        ) {
          member: RegisteredName -> return member
          nil -> associated_declaration_from_bounds(environment, rest, spelling)
        }
        nil -> associated_declaration_from_bounds(environment, rest, spelling)
      }
      nil -> associated_declaration_from_bounds(environment, rest, spelling)
    }
  }
}

fn environment_associated_declaration(
  environment: SemanticTypeEnvironment,
  variable: i64,
  range: TypeNameRange
) -> RegisteredName? {
  match required_associated_member_name(environment_source(environment), range) {
    None -> nil
    Some(spelling) -> if variable == 0 - 1 {
      match environment_self_trait(environment) {
        trait_type: TypeExpr -> match trait_declaration_for(environment, trait_type) {
          declaration: RegisteredName -> match environment_registered_trait(
            environment,
            declaration.identity
          ) {
            trait_value: RegisteredTrait -> registered_trait_associated_member(
              trait_value,
              spelling
            )
            nil -> nil
          }
          nil -> nil
        }
        nil -> nil
      }
    } else if variable >= 0 {
      match type_parameter_bounds_by_identity(
        environment_type_parameters(environment),
        variable
      ) {
        bounds: TypeParamBoundList -> associated_declaration_from_bounds(
          environment,
          bounds,
          spelling
        )
        nil -> nil
      }
    } else {
      nil
    }
  }
}

fn primitive_from_authored(code: i64) -> SemanticPrimitive? {
  match code {
    0 -> return SemanticI64
    1 -> return SemanticStr
    2 -> return SemanticBool
    3 -> return SemanticNil
    4 -> return SemanticF64
    5 -> return SemanticI32
    6 -> return SemanticI8
    7 -> return SemanticI16
    8 -> return SemanticU8
    9 -> return SemanticU16
    10 -> return SemanticU32
    11 -> return SemanticU64
    12 -> return SemanticIsize
    13 -> return SemanticUsize
    14 -> return SemanticF32
    _ -> nil
  }
  nil
}

fn semantic_mutability(access: TypeAccess) -> SemanticMutability {
  match access {
    ReadOnlyTypeAccess -> SemanticImmutable
    MutableTypeAccess -> SemanticMutable
  }
}

fn record_openness(extent: TypeRecordExtent) -> SemanticRecordOpenness {
  match extent {
    ExactTypeFields -> SemanticClosedRecord
    AdditionalTypeFields -> SemanticOpenRecord
  }
}

fn resolve_type_values(
  builder: owned SemanticTypeGraphBuilder,
  environment: SemanticTypeEnvironment,
  values: TypeExprList
) -> (owned SemanticTypeGraphBuilder, SemanticTypeValuesResolution) {
  match values {
    TypeExprListNil -> (builder, SemanticTypeValuesResolved(Nil<SemanticTypeId>()))
    TypeExprListCons(value, rest, _) -> match resolve_type_with(
      builder,
      environment,
      value
    ) {
      (builder, SemanticTypeResolved(resolved)) -> match resolve_type_values(
        builder,
        environment,
        rest
      ) {
        (builder, SemanticTypeValuesResolved(resolved_rest)) -> (
          builder,
          SemanticTypeValuesResolved(Cons(resolved, resolved_rest))
        )
        (builder, SemanticTypeValuesRejected(issue)) -> (
          builder,
          SemanticTypeValuesRejected(issue)
        )
      }
      (builder, SemanticTypeRejected(issue)) -> (
        builder,
        SemanticTypeValuesRejected(issue)
      )
    }
  }
}

fn resolve_type_list(
  builder: owned SemanticTypeGraphBuilder,
  environment: SemanticTypeEnvironment,
  values: TypeExprList
) -> (owned SemanticTypeGraphBuilder, SemanticTypeListResolution) {
  match resolve_type_values(builder, environment, values) {
    (builder, SemanticTypeValuesResolved(resolved)) -> {
      let (builder, list) = builder.type_list(resolved)
      (builder, SemanticTypeListResolved(list))
    }
    (builder, SemanticTypeValuesRejected(issue)) -> (builder, SemanticTypeListRejected(issue))
  }
}

fn required_field_name(source: Source, range: TypeNameRange) -> Option<str> {
  let end = range.start + range.length
  if range.start < 0 or range.length < 0 or end < range.start { None<str>() }
  else {
    match source.span(
      __i64_to_usize(range.start),
      __i64_to_usize(end)
    ) {
      Some(span) -> span.text()
      None -> None<str>()
    }
  }
}

fn required_associated_member_name(
  source: Source,
  range: TypeNameRange
) -> Option<str> {
  match required_field_name(source, range) {
    Some(written) -> match written.find(".") {
      Some(separator) -> written.slice(separator + 1, written.len())
      None -> None<str>()
    }
    None -> None<str>()
  }
}

fn resolve_named_record_fields(
  builder: owned SemanticTypeGraphBuilder,
  environment: SemanticTypeEnvironment,
  fields: TypeExprList
) -> (owned SemanticTypeGraphBuilder, SemanticRecordFieldsResolution) {
  match fields {
    TypeExprListNil -> (
      builder,
      SemanticRecordFieldsResolved(Nil<str>(), Nil<SemanticTypeId>())
    )
    TypeExprListCons(field, rest, _) -> match field {
      RecordFieldTypeExpr(_, annotation, range) -> match required_field_name(
        environment_source(environment),
        range
      ) {
        Some(name) -> match resolve_type_with(builder, environment, annotation) {
          (builder, SemanticTypeResolved(resolved)) -> match resolve_named_record_fields(
            builder,
            environment,
            rest
          ) {
            (builder, SemanticRecordFieldsResolved(names, values)) -> (
              builder,
              SemanticRecordFieldsResolved(Cons(name, names), Cons(resolved, values))
            )
            (builder, SemanticRecordFieldsRejected(issue)) -> (
              builder,
              SemanticRecordFieldsRejected(issue)
            )
          }
          (builder, SemanticTypeRejected(issue)) -> (
            builder,
            SemanticRecordFieldsRejected(issue)
          )
        }
        None -> (
          builder,
          SemanticRecordFieldsRejected(SemanticInvalidRecordFieldRange(range))
        )
      }
      _ -> (
        builder,
        SemanticRecordFieldsRejected(SemanticExpectedRecordField)
      )
    }
  }
}

fn resolve_tuple_fields(
  builder: owned SemanticTypeGraphBuilder,
  environment: SemanticTypeEnvironment,
  fields: TypeExprList
) -> (owned SemanticTypeGraphBuilder, SemanticTypeValuesResolution) {
  match fields {
    TypeExprListNil -> (builder, SemanticTypeValuesResolved(Nil<SemanticTypeId>()))
    TypeExprListCons(field, rest, _) -> match field {
      RecordFieldTypeExpr(_, annotation, _) -> match resolve_type_with(
        builder,
        environment,
        annotation
      ) {
        (builder, SemanticTypeResolved(resolved)) -> match resolve_tuple_fields(
          builder,
          environment,
          rest
        ) {
          (builder, SemanticTypeValuesResolved(values)) -> (
            builder,
            SemanticTypeValuesResolved(Cons(resolved, values))
          )
          (builder, SemanticTypeValuesRejected(issue)) -> (
            builder,
            SemanticTypeValuesRejected(issue)
          )
        }
        (builder, SemanticTypeRejected(issue)) -> (
          builder,
          SemanticTypeValuesRejected(issue)
        )
      }
      _ -> (
        builder,
        SemanticTypeValuesRejected(SemanticExpectedRecordField)
      )
    }
  }
}

fn resolve_binary(
  builder: owned SemanticTypeGraphBuilder,
  environment: SemanticTypeEnvironment,
  left: TypeExpr,
  right: TypeExpr,
  intersection: bool
) -> (owned SemanticTypeGraphBuilder, SemanticTypeResolution) {
  match resolve_type_with(builder, environment, left) {
    (builder, SemanticTypeResolved(resolved_left)) -> match resolve_type_with(
      builder,
      environment,
      right
    ) {
      (builder, SemanticTypeResolved(resolved_right)) -> {
        let (builder, result) = if intersection {
          builder.intersection(resolved_left, resolved_right)
        } else { builder.union(resolved_left, resolved_right) }
        (builder, SemanticTypeResolved(result))
      }
      (builder, SemanticTypeRejected(issue)) -> (builder, SemanticTypeRejected(issue))
    }
    (builder, SemanticTypeRejected(issue)) -> (builder, SemanticTypeRejected(issue))
  }
}

fn resolve_unary(
  builder: owned SemanticTypeGraphBuilder,
  environment: SemanticTypeEnvironment,
  inner: TypeExpr,
  kind: i64
) -> (owned SemanticTypeGraphBuilder, SemanticTypeResolution) {
  match resolve_type_with(builder, environment, inner) {
    (builder, SemanticTypeResolved(resolved)) -> {
      let (builder, result) = match kind {
        0 -> builder.complement(resolved)
        1 -> builder.weak(resolved)
        2 -> builder.atomic(resolved)
        3 -> builder.unique(resolved)
        _ -> builder.owned(resolved)
      }
      (builder, SemanticTypeResolved(result))
    }
    (builder, SemanticTypeRejected(issue)) -> (builder, SemanticTypeRejected(issue))
  }
}

fn resolve_mutable_unary(
  builder: owned SemanticTypeGraphBuilder,
  environment: SemanticTypeEnvironment,
  inner: TypeExpr,
  access: TypeAccess,
  kind: i64
) -> (owned SemanticTypeGraphBuilder, SemanticTypeResolution) {
  match resolve_type_with(builder, environment, inner) {
    (builder, SemanticTypeResolved(resolved)) -> {
      let mutability = semantic_mutability(access)
      let (builder, result) = match kind {
        0 -> builder.pointer(resolved, mutability)
        1 -> builder.borrow(resolved, mutability)
        _ -> builder.slice(resolved, mutability)
      }
      (builder, SemanticTypeResolved(result))
    }
    (builder, SemanticTypeRejected(issue)) -> (builder, SemanticTypeRejected(issue))
  }
}

fn resolve_effect_atom(
  builder: owned SemanticTypeGraphBuilder,
  environment: SemanticTypeEnvironment,
  atom: TypeExpr
) -> (owned SemanticTypeGraphBuilder, SemanticTypeResolution) {
  let declaration = match atom {
    UnqualifiedEffectTypeExpr(_, _, range) -> environment_declaration(
      environment,
      EffectDeclaration,
      range
    )
    QualifiedEffectTypeExpr(qualifier, range, _) -> environment_qualified_declaration(
      environment,
      EffectDeclaration,
      qualifier,
      range
    )
    _ -> nil
  }
  match declaration {
    registered: RegisteredName -> {
      let arguments = match atom {
        UnqualifiedEffectTypeExpr(_, values, _) -> values
        QualifiedEffectTypeExpr(_, _, values) -> values
        _ -> TypeExprListNil
      }
      match resolve_type_list(builder, environment, arguments) {
        (builder, SemanticTypeListResolved(resolved_arguments)) -> {
          let (builder, resolved) = builder.effect_atom(
            registered.identity,
            resolved_arguments
          )
          (builder, SemanticTypeResolved(resolved))
        }
        (builder, SemanticTypeListRejected(issue)) -> (
          builder,
          SemanticTypeRejected(issue)
        )
      }
    }
    nil -> (builder, SemanticTypeRejected(SemanticDeclarationResolutionRequired))
  }
}

fn resolve_effect_atoms(
  builder: owned SemanticTypeGraphBuilder,
  environment: SemanticTypeEnvironment,
  atoms: TypeExprList
) -> (owned SemanticTypeGraphBuilder, SemanticTypeValuesResolution) {
  match atoms {
    TypeExprListNil -> (builder, SemanticTypeValuesResolved(Nil<SemanticTypeId>()))
    TypeExprListCons(atom, rest, _) -> match resolve_effect_atom(
      builder,
      environment,
      atom
    ) {
      (builder, SemanticTypeResolved(resolved)) -> match resolve_effect_atoms(
        builder,
        environment,
        rest
      ) {
        (builder, SemanticTypeValuesResolved(resolved_rest)) -> (
          builder,
          SemanticTypeValuesResolved(Cons(resolved, resolved_rest))
        )
        (builder, SemanticTypeValuesRejected(issue)) -> (
          builder,
          SemanticTypeValuesRejected(issue)
        )
      }
      (builder, SemanticTypeRejected(issue)) -> (
        builder,
        SemanticTypeValuesRejected(issue)
      )
    }
  }
}

fn resolve_effect_set(
  builder: owned SemanticTypeGraphBuilder,
  environment: SemanticTypeEnvironment,
  atoms: TypeExprList,
  tail: i64
) -> (owned SemanticTypeGraphBuilder, SemanticTypeResolution) {
  if tail < 0 { (builder, SemanticTypeRejected(SemanticInvalidVariable(tail))) }
  else {
    match resolve_effect_atoms(builder, environment, atoms) {
      (builder, SemanticTypeValuesResolved(resolved_atoms)) -> {
        let (builder, effects) = builder.type_list(resolved_atoms)
        let semantic_tail = if tail == 0 { SemanticClosedEffects }
        else { SemanticOpenEffects(__i64_to_usize(tail - 1)) }
        let (builder, result) = builder.effect_signature(effects, semantic_tail)
        (builder, SemanticTypeResolved(result))
      }
      (builder, SemanticTypeValuesRejected(issue)) -> (
        builder,
        SemanticTypeRejected(issue)
      )
    }
  }
}

fn resolve_trait_atom(
  builder: owned SemanticTypeGraphBuilder,
  environment: SemanticTypeEnvironment,
  ty: TypeExpr
) -> (owned SemanticTypeGraphBuilder, SemanticTypeResolution) {
  let declaration = trait_declaration_for(environment, ty)
  match declaration {
    registered: RegisteredName -> {
      let (builder, resolved) = builder.trait_atom(registered.identity)
      (builder, SemanticTypeResolved(resolved))
    }
    nil -> (builder, SemanticTypeRejected(SemanticDeclarationResolutionRequired))
  }
}

type SemanticTraitBindingsResolution {
  SemanticTraitBindingsResolved(List<DeclarationIdentity>, List<SemanticTypeId>),
  SemanticTraitBindingsRejected(SemanticTypeResolutionIssue)
}

fn resolve_trait_bindings(
  builder: owned SemanticTypeGraphBuilder,
  environment: SemanticTypeEnvironment,
  trait_value: RegisteredTrait,
  bindings: TypeExprList
) -> (owned SemanticTypeGraphBuilder, SemanticTraitBindingsResolution) {
  match bindings {
    TypeExprListNil -> (
      builder,
      SemanticTraitBindingsResolved(
        Nil<DeclarationIdentity>(),
        Nil<SemanticTypeId>()
      )
    )
    TypeExprListCons(binding, rest, _) -> match binding {
      AssociatedBindingTypeExpr(_, value, range) -> match required_field_name(
        environment_source(environment),
        range
      ) {
        Some(spelling) -> match registered_trait_associated_member(
          trait_value,
          spelling
        ) {
          member: RegisteredName -> match resolve_type_with(
            builder,
            environment,
            value
          ) {
            (builder, SemanticTypeResolved(resolved)) -> match resolve_trait_bindings(
              builder,
              environment,
              trait_value,
              rest
            ) {
              (builder, SemanticTraitBindingsResolved(declarations, values)) -> (
                builder,
                SemanticTraitBindingsResolved(
                  Cons<DeclarationIdentity>(member.identity, declarations),
                  Cons<SemanticTypeId>(resolved, values)
                )
              )
              (builder, SemanticTraitBindingsRejected(issue)) -> (
                builder,
                SemanticTraitBindingsRejected(issue)
              )
            }
            (builder, SemanticTypeRejected(issue)) -> (
              builder,
              SemanticTraitBindingsRejected(issue)
            )
          }
          nil -> (
            builder,
            SemanticTraitBindingsRejected(SemanticDeclarationResolutionRequired)
          )
        }
        None -> (
          builder,
          SemanticTraitBindingsRejected(SemanticInvalidRecordFieldRange(range))
        )
      }
      _ -> (
        builder,
        SemanticTraitBindingsRejected(SemanticDeclarationResolutionRequired)
      )
    }
  }
}

fn resolve_trait_constraint(
  builder: owned SemanticTypeGraphBuilder,
  environment: SemanticTypeEnvironment,
  constraint: TypeExpr,
  bindings: TypeExprList
) -> (owned SemanticTypeGraphBuilder, SemanticTypeResolution) {
  match trait_declaration_for(environment, constraint) {
    declaration: RegisteredName -> match environment_registered_trait(
      environment,
      declaration.identity
    ) {
      trait_value: RegisteredTrait -> match resolve_trait_bindings(
        builder,
        environment,
        trait_value,
        bindings
      ) {
        (builder, SemanticTraitBindingsResolved(declarations, values)) -> {
          let (builder, resolved) = builder.trait_constraint(
            declaration.identity,
            declarations,
            values
          )
          (builder, SemanticTypeResolved(resolved))
        }
        (builder, SemanticTraitBindingsRejected(issue)) -> (
          builder,
          SemanticTypeRejected(issue)
        )
      }
      nil -> (builder, SemanticTypeRejected(SemanticDeclarationResolutionRequired))
    }
    nil -> (builder, SemanticTypeRejected(SemanticDeclarationResolutionRequired))
  }
}

fn resolve_associated_projection(
  builder: owned SemanticTypeGraphBuilder,
  environment: SemanticTypeEnvironment,
  base: TypeExpr,
  range: TypeNameRange
) -> (owned SemanticTypeGraphBuilder, SemanticTypeResolution) {
  match base {
    VariableTypeExpr(variable) -> match environment_associated_declaration(
      environment,
      variable,
      range
    ) {
      declaration: RegisteredName -> match resolve_type_with(
        builder,
        environment,
        base
      ) {
        (builder, SemanticTypeResolved(resolved_base)) -> {
          let (builder, resolved) = builder.associated(
            resolved_base,
            declaration.identity
          )
          (builder, SemanticTypeResolved(resolved))
        }
        (builder, SemanticTypeRejected(issue)) -> (
          builder,
          SemanticTypeRejected(issue)
        )
      }
      nil -> (builder, SemanticTypeRejected(SemanticDeclarationResolutionRequired))
    }
    _ -> resolve_qualified_named(builder, environment, base, range)
  }
}

fn resolve_named_declaration(
  builder: owned SemanticTypeGraphBuilder,
  environment: SemanticTypeEnvironment,
  declaration: RegisteredName,
  arguments: TypeExprList
) -> (owned SemanticTypeGraphBuilder, SemanticTypeResolution) {
  match environment_registered_type(environment, declaration.identity) {
    registered: RegisteredType -> {
      let expected = __i64_to_usize(
        type_param_list_len(registered_type_parameters(registered))
      )
      let actual = __i64_to_usize(type_expr_list_len(arguments))
      if expected != actual {
        (builder, SemanticTypeRejected(SemanticTypeArgumentCount(expected, actual)))
      } else {
        match registered {
          RegisteredRecordType(_, _, _) -> match resolve_type_list(
            builder,
            environment,
            arguments
          ) {
            (builder, SemanticTypeListResolved(resolved_arguments)) -> {
              let (builder, representation) = builder.top()
              let (builder, resolved) = builder.named(
                declaration.identity,
                SemanticNominalType,
                representation,
                resolved_arguments
              )
              (builder, SemanticTypeResolved(resolved))
            }
            (builder, SemanticTypeListRejected(issue)) -> (
              builder,
              SemanticTypeRejected(issue)
            )
          }
          RegisteredVariantType(_, _, _) -> match resolve_type_list(
            builder,
            environment,
            arguments
          ) {
            (builder, SemanticTypeListResolved(resolved_arguments)) -> {
              let (builder, representation) = builder.top()
              let (builder, resolved) = builder.named(
                declaration.identity,
                SemanticNominalType,
                representation,
                resolved_arguments
              )
              (builder, SemanticTypeResolved(resolved))
            }
            (builder, SemanticTypeListRejected(issue)) -> (
              builder,
              SemanticTypeRejected(issue)
            )
          }
          RegisteredOpaqueType(_, parameters, representation) -> if expected != 0 {
            (
              builder,
              SemanticTypeRejected(
                SemanticDefinitionExpansionRequired(declaration.identity)
              )
            )
          } else {
            match environment_for_definition(
              environment,
              declaration.identity,
              parameters
            ) {
              definition: SemanticTypeEnvironment -> match resolve_type_with(
                builder,
                definition,
                representation
              ) {
                (builder, SemanticTypeResolved(resolved_representation)) -> {
                  let (builder, resolved_arguments) = builder.type_list(
                    Nil<SemanticTypeId>()
                  )
                  let (builder, resolved) = builder.named(
                    declaration.identity,
                    SemanticOpaqueType,
                    resolved_representation,
                    resolved_arguments
                  )
                  (builder, SemanticTypeResolved(resolved))
                }
                (builder, SemanticTypeRejected(issue)) -> (
                  builder,
                  SemanticTypeRejected(issue)
                )
              }
              nil -> (
                builder,
                SemanticTypeRejected(
                  SemanticRecursiveTypeDefinition(declaration.identity)
                )
              )
            }
          }
          RegisteredAliasType(_, parameters, target) -> if expected != 0 {
            (
              builder,
              SemanticTypeRejected(
                SemanticDefinitionExpansionRequired(declaration.identity)
              )
            )
          } else {
            match environment_for_definition(
              environment,
              declaration.identity,
              parameters
            ) {
              definition: SemanticTypeEnvironment -> resolve_type_with(
                builder,
                definition,
                target
              )
              nil -> (
                builder,
                SemanticTypeRejected(
                  SemanticRecursiveTypeDefinition(declaration.identity)
                )
              )
            }
          }
        }
      }
    }
    nil -> (builder, SemanticTypeRejected(SemanticDeclarationResolutionRequired))
  }
}

fn resolve_unqualified_named(
  builder: owned SemanticTypeGraphBuilder,
  environment: SemanticTypeEnvironment,
  arguments: TypeExprList,
  range: TypeNameRange
) -> (owned SemanticTypeGraphBuilder, SemanticTypeResolution) {
  match environment_declaration(environment, TypeDeclaration, range) {
    declaration: RegisteredName -> resolve_named_declaration(
      builder,
      environment,
      declaration,
      arguments
    )
    nil -> (builder, SemanticTypeRejected(SemanticDeclarationResolutionRequired))
  }
}

fn resolve_qualified_named(
  builder: owned SemanticTypeGraphBuilder,
  environment: SemanticTypeEnvironment,
  base: TypeExpr,
  range: TypeNameRange
) -> (owned SemanticTypeGraphBuilder, SemanticTypeResolution) {
  match base {
    NamedTypeExpr(_, _, arguments, SourceTypeOrigin(qualifier)) -> {
      let member_start = qualifier.start + qualifier.length + 1
      let member_length = range.start + range.length - member_start
      if member_length <= 0 {
        (builder, SemanticTypeRejected(SemanticDeclarationResolutionRequired))
      } else {
        let member = TypeNameRange { start: member_start, length: member_length }
        match environment_qualified_declaration(
          environment,
          TypeDeclaration,
          qualifier,
          member
        ) {
          declaration: RegisteredName -> resolve_named_declaration(
            builder,
            environment,
            declaration,
            arguments
          )
          nil -> (builder, SemanticTypeRejected(SemanticDeclarationResolutionRequired))
        }
      }
    }
    _ -> (builder, SemanticTypeRejected(SemanticDeclarationResolutionRequired))
  }
}

fn resolve_function_type(
  builder: owned SemanticTypeGraphBuilder,
  environment: SemanticTypeEnvironment,
  parameters: TypeExprList,
  result: TypeExpr,
  effects: TypeExpr
) -> (owned SemanticTypeGraphBuilder, SemanticTypeResolution) {
  match resolve_type_list(builder, environment, parameters) {
    (builder, SemanticTypeListResolved(parameter_types)) -> match resolve_type_with(
      builder,
      environment,
      result
    ) {
      (builder, SemanticTypeResolved(result_type)) -> match effects {
        EffectSetTypeExpr(atoms, tail) -> match resolve_effect_set(
          builder,
          environment,
          atoms,
          tail
        ) {
          (builder, SemanticTypeResolved(effect_type)) -> {
            let (builder, function) = builder.function(
              parameter_types,
              result_type,
              effect_type
            )
            (builder, SemanticTypeResolved(function))
          }
          (builder, SemanticTypeRejected(issue)) -> (builder, SemanticTypeRejected(issue))
        }
        _ -> (builder, SemanticTypeRejected(SemanticUnsupportedAuthoredType(6)))
      }
      (builder, SemanticTypeRejected(issue)) -> (builder, SemanticTypeRejected(issue))
    }
    (builder, SemanticTypeListRejected(issue)) -> (builder, SemanticTypeRejected(issue))
  }
}

fn resolve_type_with(
  builder: owned SemanticTypeGraphBuilder,
  environment: SemanticTypeEnvironment,
  ty: TypeExpr
) -> (owned SemanticTypeGraphBuilder, SemanticTypeResolution) {
  match ty {
    NeverTypeExpr -> {
      let (builder, resolved) = builder.bottom()
      (builder, SemanticTypeResolved(resolved))
    }
    AnyTypeExpr -> {
      let (builder, resolved) = builder.top()
      (builder, SemanticTypeResolved(resolved))
    }
    PrimitiveTypeExpr(code) -> match primitive_from_authored(code) {
      primitive: SemanticPrimitive -> {
        let (builder, resolved) = builder.primitive(primitive)
        (builder, SemanticTypeResolved(resolved))
      }
      nil -> (builder, SemanticTypeRejected(SemanticInvalidPrimitive(code)))
    }
    UnionTypeExpr(left, right) -> resolve_binary(builder, environment, left, right, false)
    IntersectionTypeExpr(left, right) -> resolve_binary(
      builder,
      environment,
      left,
      right,
      true
    )
    ComplementTypeExpr(inner) -> resolve_unary(builder, environment, inner, 0)
    FunctionTypeExpr(parameters, result, effects) -> resolve_function_type(
      builder,
      environment,
      parameters,
      result,
      effects
    )
    RecordTypeExpr(fields, extent, NamedTypeFields) -> match resolve_named_record_fields(
      builder,
      environment,
      fields
    ) {
      (builder, SemanticRecordFieldsResolved(names, values)) -> {
        let (builder, resolved) = builder.record(names, values, record_openness(extent))
        (builder, SemanticTypeResolved(resolved))
      }
      (builder, SemanticRecordFieldsRejected(issue)) -> (
        builder,
        SemanticTypeRejected(issue)
      )
    }
    RecordTypeExpr(fields, _, PositionalTypeFields) -> match resolve_tuple_fields(
      builder,
      environment,
      fields
    ) {
      (builder, SemanticTypeValuesResolved(values)) -> {
        let (builder, resolved) = builder.tuple(values)
        (builder, SemanticTypeResolved(resolved))
      }
      (builder, SemanticTypeValuesRejected(issue)) -> (
        builder,
        SemanticTypeRejected(issue)
      )
    }
    NamedTypeExpr(_, _, arguments, SourceTypeOrigin(range)) -> resolve_unqualified_named(
      builder,
      environment,
      arguments,
      range
    )
    SourceAssociatedTypeExpr(base, _, range) -> resolve_associated_projection(
      builder,
      environment,
      base,
      range
    )
    UnqualifiedEffectTypeExpr(_, _, _) -> resolve_effect_atom(builder, environment, ty)
    QualifiedEffectTypeExpr(_, _, _) -> resolve_effect_atom(builder, environment, ty)
    EffectSetTypeExpr(atoms, tail) -> resolve_effect_set(
      builder,
      environment,
      atoms,
      tail
    )
    UnqualifiedTraitTypeExpr(_, _) -> resolve_trait_atom(builder, environment, ty)
    QualifiedTraitTypeExpr(_, _) -> resolve_trait_atom(builder, environment, ty)
    ConstraintTypeExpr(constraint, bindings) -> resolve_trait_constraint(
      builder,
      environment,
      constraint,
      bindings
    )
    VariableTypeExpr(identity) -> if identity == 0 - 1 {
      let (builder, resolved) = builder.variable(SemanticSelfVariable)
      (builder, SemanticTypeResolved(resolved))
    } else {
      if identity >= 0 {
        let (builder, resolved) = builder.variable(
          SemanticParameterVariable(__i64_to_usize(identity))
        )
        (builder, SemanticTypeResolved(resolved))
      } else { (builder, SemanticTypeRejected(SemanticInvalidVariable(identity))) }
    }
    ContinuationTypeExpr(input, result) -> match resolve_type_with(
      builder,
      environment,
      input
    ) {
      (builder, SemanticTypeResolved(resolved_input)) -> match resolve_type_with(
        builder,
        environment,
        result
      ) {
        (builder, SemanticTypeResolved(resolved_result)) -> {
          let (builder, resolved) = builder.continuation(resolved_input, resolved_result)
          (builder, SemanticTypeResolved(resolved))
        }
        (builder, SemanticTypeRejected(issue)) -> (builder, SemanticTypeRejected(issue))
      }
      (builder, SemanticTypeRejected(issue)) -> (builder, SemanticTypeRejected(issue))
    }
    PointerTypeExpr(inner, access) -> resolve_mutable_unary(
      builder,
      environment,
      inner,
      access,
      0
    )
    BorrowTypeExpr(inner, access) -> resolve_mutable_unary(
      builder,
      environment,
      inner,
      access,
      1
    )
    SliceTypeExpr(inner, access) -> resolve_mutable_unary(
      builder,
      environment,
      inner,
      access,
      2
    )
    WeakTypeExpr(inner) -> resolve_unary(builder, environment, inner, 1)
    AtomicTypeExpr(inner) -> resolve_unary(builder, environment, inner, 2)
    UniqueTypeExpr(inner) -> resolve_unary(builder, environment, inner, 3)
    OwnedTypeExpr(inner) -> resolve_unary(builder, environment, inner, 4)
    ArrayTypeExpr(inner, length) -> if length < 0 {
      (builder, SemanticTypeRejected(SemanticInvalidArrayLength(length)))
    } else {
      match resolve_type_with(builder, environment, inner) {
        (builder, SemanticTypeResolved(element)) -> {
          let (builder, resolved) = builder.array(element, __i64_to_usize(length))
          (builder, SemanticTypeResolved(resolved))
        }
        (builder, SemanticTypeRejected(issue)) -> (builder, SemanticTypeRejected(issue))
      }
    }
    MissingTypeExpr -> (builder, SemanticTypeRejected(SemanticMissingAuthoredType))
    UnsupportedTypeExpr(kind) -> (
      builder,
      SemanticTypeRejected(SemanticUnsupportedAuthoredType(kind))
    )
    _ -> (builder, SemanticTypeRejected(SemanticDeclarationResolutionRequired))
  }
}

pub(package) fn resolve_type(
  builder: owned SemanticTypeGraphBuilder,
  source: Source,
  ty: TypeExpr
) -> (owned SemanticTypeGraphBuilder, SemanticTypeResolution) {
  resolve_type_with(builder, SemanticTypesWithoutScope(source), ty)
}

pub(package) fn resolve_type_in_scope(
  builder: owned SemanticTypeGraphBuilder,
  module: RegisteredModule,
  scope: RegistrationScope,
  ty: TypeExpr
) -> (owned SemanticTypeGraphBuilder, SemanticTypeResolution) {
  resolve_type_with(
    builder,
    SemanticTypesInScope(
      module,
      scope,
      Nil<DeclarationIdentity>(),
      TypeParamListNil,
      nil
    ),
    ty
  )
}

fn parameter_types(params: ParamList) -> TypeExprList {
  match params {
    ParamListNil -> TypeExprListNil
    ParamListCons(param, rest) -> match param {
      Param(_, _, annotation, _) -> TypeExprListCons(
        annotation,
        parameter_types(rest),
        nil
      )
      UnknownParam(_) -> TypeExprListCons(
        MissingTypeExpr,
        parameter_types(rest),
        nil
      )
    }
  }
}

fn effect_type(effects: EffectSig) -> TypeExpr {
  match effects {
    EffectSig(atoms, tail) -> EffectSetTypeExpr(atoms, tail)
    MissingEffectSig -> MissingTypeExpr
  }
}

pub(package) fn resolve_function_signature(
  builder: owned SemanticTypeGraphBuilder,
  source: Source,
  function: FunctionSyntax
) -> (owned SemanticTypeGraphBuilder, SemanticTypeResolution) {
  resolve_function_type(
    builder,
    SemanticTypesWithoutScope(source),
    parameter_types(function.params),
    function.result,
    effect_type(function.effects)
  )
}

pub(package) fn resolve_function_signature_in_scope(
  builder: owned SemanticTypeGraphBuilder,
  module: RegisteredModule,
  scope: RegistrationScope,
  function: FunctionSyntax
) -> (owned SemanticTypeGraphBuilder, SemanticTypeResolution) {
  resolve_function_type(
    builder,
    SemanticTypesInScope(
      module,
      scope,
      Nil<DeclarationIdentity>(),
      function.type_params,
      nil
    ),
    parameter_types(function.params),
    function.result,
    effect_type(function.effects)
  )
}

pub(package) fn semantic_type_product_builder(
  owner: ModuleIdentity,
  expected_segments: usize
) -> SemanticTypeProductBuilder {
  SemanticTypeProductBuilder(
    SemanticTypeProductBuilderStorage {
      owner: owner,
      catalog: semantic_type_catalog_empty(expected_segments),
      next_segment: 0
    }
  )
}

pub(package) fn semantic_type_product_continue(
  owner: ModuleIdentity,
  catalog: SemanticTypeCatalog,
  next_segment: usize
) -> SemanticTypeProductBuilder {
  SemanticTypeProductBuilder(
    SemanticTypeProductBuilderStorage {
      owner: owner,
      catalog: catalog,
      next_segment: next_segment
    }
  )
}

pub(package) fn semantic_type_product_catalog(
  product: borrow SemanticTypeProductBuilder
) -> SemanticTypeCatalog {
  match product {
    SemanticTypeProductBuilder(storage) -> storage.catalog
  }
}

pub(package) fn semantic_type_product_next_segment(
  product: borrow SemanticTypeProductBuilder
) -> usize {
  match product {
    SemanticTypeProductBuilder(storage) -> storage.next_segment
  }
}

fn semantic_type_product_segment(
  product: borrow SemanticTypeProductBuilder,
  offset: usize
) -> SemanticTypeSegmentId {
  match product {
    SemanticTypeProductBuilder(storage) -> semantic_type_derived_segment_id(
      storage.owner,
      storage.next_segment + offset
    )
  }
}

fn semantic_type_product_advance(
  product: SemanticTypeProductBuilder,
  count: usize
) -> SemanticTypeProductBuilder {
  let SemanticTypeProductBuilder(storage) = product
  SemanticTypeProductBuilder(
    SemanticTypeProductBuilderStorage {
      owner: storage.owner,
      catalog: storage.catalog,
      next_segment: storage.next_segment + count
    }
  )
}

fn semantic_type_product_include_graph(
  product: SemanticTypeProductBuilder,
  graph: SemanticTypeGraph,
  consumed_segments: usize
) -> SemanticTypeProductBuilder {
  let SemanticTypeProductBuilder(storage) = product
  let catalog = storage.catalog
  SemanticTypeProductBuilder(
    SemanticTypeProductBuilderStorage {
      owner: storage.owner,
      catalog: semantic_type_catalog_with_graph(catalog, graph),
      next_segment: storage.next_segment + consumed_segments
    }
  )
}

fn semantic_type_product_add_graph(
  product: SemanticTypeProductBuilder,
  graph: SemanticTypeGraph
) -> SemanticTypeProductBuilder {
  semantic_type_product_include_graph(product, graph, 1)
}

type SemanticProductResolution {
  SemanticProductResolved(SemanticTypeProductBuilder, SemanticTypeId),
  SemanticProductRejected(SemanticTypeResolutionIssue)
}

type SemanticProductValuesResolution {
  SemanticProductValuesResolved(SemanticTypeProductBuilder, List<SemanticTypeId>),
  SemanticProductValuesRejected(SemanticTypeResolutionIssue)
}

fn semantic_product_values(
  product: SemanticTypeProductBuilder,
  environment: SemanticTypeEnvironment,
  values: TypeExprList
) -> SemanticProductValuesResolution {
  match values {
    TypeExprListNil -> SemanticProductValuesResolved(
      product,
      Nil<SemanticTypeId>()
    )
    TypeExprListCons(value, rest, _) -> match resolve_type_product_with(
      product,
      environment,
      value
    ) {
      SemanticProductResolved(product, resolved) -> match semantic_product_values(
        product,
        environment,
        rest
      ) {
        SemanticProductValuesResolved(product, resolved_rest) ->
          SemanticProductValuesResolved(
            product,
            Cons<SemanticTypeId>(resolved, resolved_rest)
          )
        SemanticProductValuesRejected(issue) -> SemanticProductValuesRejected(issue)
      }
      SemanticProductRejected(issue) -> SemanticProductValuesRejected(issue)
    }
  }
}

fn semantic_product_add_binary(
  product: SemanticTypeProductBuilder,
  left: SemanticTypeId,
  right: SemanticTypeId,
  intersection: bool
) -> SemanticProductResolution {
  let builder = semantic_type_graph_builder(semantic_type_product_segment(product, 0))
  let (builder, root) = if intersection {
    builder.intersection(left, right)
  } else { builder.union(left, right) }
  SemanticProductResolved(
    semantic_type_product_add_graph(product, builder.freeze()),
    root
  )
}

fn semantic_product_add_unary(
  product: SemanticTypeProductBuilder,
  inner: SemanticTypeId,
  kind: i64
) -> SemanticProductResolution {
  let builder = semantic_type_graph_builder(semantic_type_product_segment(product, 0))
  let (builder, root) = match kind {
    0 -> builder.complement(inner)
    1 -> builder.weak(inner)
    2 -> builder.atomic(inner)
    3 -> builder.unique(inner)
    _ -> builder.owned(inner)
  }
  SemanticProductResolved(
    semantic_type_product_add_graph(product, builder.freeze()),
    root
  )
}

fn semantic_product_add_mutable_unary(
  product: SemanticTypeProductBuilder,
  inner: SemanticTypeId,
  access: TypeAccess,
  kind: i64
) -> SemanticProductResolution {
  let builder = semantic_type_graph_builder(semantic_type_product_segment(product, 0))
  let mutability = semantic_mutability(access)
  let (builder, root) = match kind {
    0 -> builder.pointer(inner, mutability)
    1 -> builder.borrow(inner, mutability)
    _ -> builder.slice(inner, mutability)
  }
  SemanticProductResolved(
    semantic_type_product_add_graph(product, builder.freeze()),
    root
  )
}

type SemanticProductRecordFieldsResolution {
  SemanticProductRecordFieldsResolved(
    SemanticTypeProductBuilder,
    List<str>,
    List<SemanticTypeId>
  ),
  SemanticProductRecordFieldsRejected(SemanticTypeResolutionIssue)
}

fn semantic_product_record_fields(
  product: SemanticTypeProductBuilder,
  environment: SemanticTypeEnvironment,
  fields: TypeExprList
) -> SemanticProductRecordFieldsResolution {
  match fields {
    TypeExprListNil -> SemanticProductRecordFieldsResolved(
      product,
      Nil<str>(),
      Nil<SemanticTypeId>()
    )
    TypeExprListCons(field, rest, _) -> match field {
      RecordFieldTypeExpr(_, annotation, range) -> match required_field_name(
        environment_source(environment),
        range
      ) {
        Some(name) -> match resolve_type_product_with(
          product,
          environment,
          annotation
        ) {
          SemanticProductResolved(product, resolved) ->
            match semantic_product_record_fields(product, environment, rest) {
              SemanticProductRecordFieldsResolved(product, names, values) ->
                SemanticProductRecordFieldsResolved(
                  product,
                  Cons<str>(name, names),
                  Cons<SemanticTypeId>(resolved, values)
                )
              SemanticProductRecordFieldsRejected(issue) ->
                SemanticProductRecordFieldsRejected(issue)
            }
          SemanticProductRejected(issue) -> SemanticProductRecordFieldsRejected(issue)
        }
        None -> SemanticProductRecordFieldsRejected(
          SemanticInvalidRecordFieldRange(range)
        )
      }
      _ -> SemanticProductRecordFieldsRejected(SemanticExpectedRecordField)
    }
  }
}

fn semantic_product_tuple_fields(
  product: SemanticTypeProductBuilder,
  environment: SemanticTypeEnvironment,
  fields: TypeExprList
) -> SemanticProductValuesResolution {
  match fields {
    TypeExprListNil -> SemanticProductValuesResolved(product, Nil<SemanticTypeId>())
    TypeExprListCons(field, rest, _) -> match field {
      RecordFieldTypeExpr(_, annotation, _) -> match resolve_type_product_with(
        product,
        environment,
        annotation
      ) {
        SemanticProductResolved(product, resolved) -> match semantic_product_tuple_fields(
          product,
          environment,
          rest
        ) {
          SemanticProductValuesResolved(product, values) ->
            SemanticProductValuesResolved(
              product,
              Cons<SemanticTypeId>(resolved, values)
            )
          SemanticProductValuesRejected(issue) -> SemanticProductValuesRejected(issue)
        }
        SemanticProductRejected(issue) -> SemanticProductValuesRejected(issue)
      }
      _ -> SemanticProductValuesRejected(SemanticExpectedRecordField)
    }
  }
}

fn semantic_product_add_record(
  product: SemanticTypeProductBuilder,
  names: List<str>,
  values: List<SemanticTypeId>,
  openness: SemanticRecordOpenness
) -> SemanticProductResolution {
  let builder = semantic_type_graph_builder(semantic_type_product_segment(product, 0))
  let (builder, root) = builder.record(names, values, openness)
  SemanticProductResolved(
    semantic_type_product_add_graph(product, builder.freeze()),
    root
  )
}

fn semantic_product_add_tuple(
  product: SemanticTypeProductBuilder,
  values: List<SemanticTypeId>
) -> SemanticProductResolution {
  let builder = semantic_type_graph_builder(semantic_type_product_segment(product, 0))
  let (builder, root) = builder.tuple(values)
  SemanticProductResolved(
    semantic_type_product_add_graph(product, builder.freeze()),
    root
  )
}

fn semantic_product_effect_atom(
  product: SemanticTypeProductBuilder,
  environment: SemanticTypeEnvironment,
  atom: TypeExpr
) -> SemanticProductResolution {
  let declaration = match atom {
    UnqualifiedEffectTypeExpr(_, _, range) -> environment_declaration(
      environment,
      EffectDeclaration,
      range
    )
    QualifiedEffectTypeExpr(qualifier, range, _) -> environment_qualified_declaration(
      environment,
      EffectDeclaration,
      qualifier,
      range
    )
    _ -> nil
  }
  match declaration {
    registered: RegisteredName -> {
      let arguments = match atom {
        UnqualifiedEffectTypeExpr(_, values, _) -> values
        QualifiedEffectTypeExpr(_, _, values) -> values
        _ -> TypeExprListNil
      }
      match semantic_product_values(product, environment, arguments) {
        SemanticProductValuesResolved(product, values) -> {
          let builder = semantic_type_graph_builder(
            semantic_type_product_segment(product, 0)
          )
          let (builder, list) = builder.type_list(values)
          let (builder, root) = builder.effect_atom(registered.identity, list)
          SemanticProductResolved(
            semantic_type_product_add_graph(product, builder.freeze()),
            root
          )
        }
        SemanticProductValuesRejected(issue) -> SemanticProductRejected(issue)
      }
    }
    nil -> SemanticProductRejected(SemanticDeclarationResolutionRequired)
  }
}

fn semantic_product_effect_atoms(
  product: SemanticTypeProductBuilder,
  environment: SemanticTypeEnvironment,
  atoms: TypeExprList
) -> SemanticProductValuesResolution {
  match atoms {
    TypeExprListNil -> SemanticProductValuesResolved(product, Nil<SemanticTypeId>())
    TypeExprListCons(atom, rest, _) -> match semantic_product_effect_atom(
      product,
      environment,
      atom
    ) {
      SemanticProductResolved(product, resolved) -> match semantic_product_effect_atoms(
        product,
        environment,
        rest
      ) {
        SemanticProductValuesResolved(product, values) ->
          SemanticProductValuesResolved(
            product,
            Cons<SemanticTypeId>(resolved, values)
          )
        SemanticProductValuesRejected(issue) -> SemanticProductValuesRejected(issue)
      }
      SemanticProductRejected(issue) -> SemanticProductValuesRejected(issue)
    }
  }
}

fn semantic_product_effect_set(
  product: SemanticTypeProductBuilder,
  environment: SemanticTypeEnvironment,
  atoms: TypeExprList,
  tail: i64
) -> SemanticProductResolution {
  if tail < 0 { SemanticProductRejected(SemanticInvalidVariable(tail)) }
  else {
    match semantic_product_effect_atoms(product, environment, atoms) {
      SemanticProductValuesResolved(product, values) -> {
        let builder = semantic_type_graph_builder(
          semantic_type_product_segment(product, 0)
        )
        let (builder, effects) = builder.type_list(values)
        let semantic_tail = if tail == 0 { SemanticClosedEffects }
        else { SemanticOpenEffects(__i64_to_usize(tail - 1)) }
        let (builder, root) = builder.effect_signature(effects, semantic_tail)
        SemanticProductResolved(
          semantic_type_product_add_graph(product, builder.freeze()),
          root
        )
      }
      SemanticProductValuesRejected(issue) -> SemanticProductRejected(issue)
    }
  }
}

type SemanticProductTraitBindingsResolution {
  SemanticProductTraitBindingsResolved(
    SemanticTypeProductBuilder,
    List<DeclarationIdentity>,
    List<SemanticTypeId>
  ),
  SemanticProductTraitBindingsRejected(SemanticTypeResolutionIssue)
}

fn semantic_product_trait_bindings(
  product: SemanticTypeProductBuilder,
  environment: SemanticTypeEnvironment,
  trait_value: RegisteredTrait,
  bindings: TypeExprList
) -> SemanticProductTraitBindingsResolution {
  match bindings {
    TypeExprListNil -> SemanticProductTraitBindingsResolved(
      product,
      Nil<DeclarationIdentity>(),
      Nil<SemanticTypeId>()
    )
    TypeExprListCons(binding, rest, _) -> match binding {
      AssociatedBindingTypeExpr(_, value, range) -> match required_field_name(
        environment_source(environment),
        range
      ) {
        Some(spelling) -> match registered_trait_associated_member(
          trait_value,
          spelling
        ) {
          member: RegisteredName -> match resolve_type_product_with(
            product,
            environment,
            value
          ) {
            SemanticProductResolved(product, resolved) ->
              match semantic_product_trait_bindings(
                product,
                environment,
                trait_value,
                rest
              ) {
                SemanticProductTraitBindingsResolved(
                product,
                declarations,
                values,
              ) -> SemanticProductTraitBindingsResolved(
                product,
                Cons<DeclarationIdentity>(member.identity, declarations),
                Cons<SemanticTypeId>(resolved, values)
              )
                SemanticProductTraitBindingsRejected(issue) ->
                  SemanticProductTraitBindingsRejected(issue)
              }
            SemanticProductRejected(issue) ->
              SemanticProductTraitBindingsRejected(issue)
          }
          nil -> SemanticProductTraitBindingsRejected(
            SemanticDeclarationResolutionRequired
          )
        }
        None -> SemanticProductTraitBindingsRejected(
          SemanticInvalidRecordFieldRange(range)
        )
      }
      _ -> SemanticProductTraitBindingsRejected(SemanticDeclarationResolutionRequired)
    }
  }
}

fn semantic_product_trait_constraint(
  product: SemanticTypeProductBuilder,
  environment: SemanticTypeEnvironment,
  constraint: TypeExpr,
  bindings: TypeExprList
) -> SemanticProductResolution {
  match trait_declaration_for(environment, constraint) {
    declaration: RegisteredName -> match environment_registered_trait(
      environment,
      declaration.identity
    ) {
      trait_value: RegisteredTrait -> match semantic_product_trait_bindings(
        product,
        environment,
        trait_value,
        bindings
      ) {
        SemanticProductTraitBindingsResolved(product, declarations, values) -> {
          let builder = semantic_type_graph_builder(
            semantic_type_product_segment(product, 0)
          )
          let (builder, root) = builder.trait_constraint(
            declaration.identity,
            declarations,
            values
          )
          SemanticProductResolved(
            semantic_type_product_add_graph(product, builder.freeze()),
            root
          )
        }
        SemanticProductTraitBindingsRejected(issue) -> SemanticProductRejected(issue)
      }
      nil -> SemanticProductRejected(SemanticDeclarationResolutionRequired)
    }
    nil -> SemanticProductRejected(SemanticDeclarationResolutionRequired)
  }
}

type SemanticProductSubstitutionResolution {
  SemanticProductSubstitutionResolved(SemanticTypeSubstitution),
  SemanticProductSubstitutionRejected(SemanticTypeResolutionIssue)
}

fn semantic_product_bind_parameters(
  parameters: TypeParamList,
  arguments: List<SemanticTypeId>,
  substitution: SemanticTypeSubstitution
) -> SemanticProductSubstitutionResolution {
  match (parameters, arguments) {
    (TypeParamListNil, Nil) -> SemanticProductSubstitutionResolved(substitution)
    (TypeParamListCons(parameter, remaining_parameters),
      Cons(argument, remaining_arguments)) -> match parameter {
        TypeParam(_, _, identity, _) -> if identity < 0 {
          SemanticProductSubstitutionRejected(SemanticInvalidVariable(identity))
        } else {
          semantic_product_bind_parameters(
            remaining_parameters,
            remaining_arguments,
            semantic_type_substitution_bind(
              substitution,
              SemanticParameterVariable(__i64_to_usize(identity)),
              argument
            )
          )
        }
        MissingTypeParam -> SemanticProductSubstitutionRejected(
          SemanticDeclarationResolutionRequired
        )
      }
    _ -> SemanticProductSubstitutionRejected(SemanticDeclarationResolutionRequired)
  }
}

fn semantic_product_substitute(
  product: SemanticTypeProductBuilder,
  substitution: borrow SemanticTypeSubstitution,
  root: SemanticTypeId
) -> SemanticProductResolution {
  let catalog = semantic_type_product_catalog(product)
  let provisional = semantic_type_product_segment(product, 0)
  let result_segment = semantic_type_product_segment(product, 1)
  let result = semantic_type_substitute(
    catalog,
    substitution,
    provisional,
    result_segment,
    root
  )
  let graph = result.graph
  if semantic_type_graph_len(graph) == 0 {
    SemanticProductResolved(semantic_type_product_advance(product, 2), result.root)
  } else {
    SemanticProductResolved(
      semantic_type_product_include_graph(product, graph, 2),
      result.root
    )
  }
}

pub(package) fn semantic_type_product_substitute(
  product: SemanticTypeProductBuilder,
  substitution: borrow SemanticTypeSubstitution,
  root: SemanticTypeId
) -> (SemanticTypeProductBuilder, SemanticTypeId) {
  match semantic_product_substitute(product, substitution, root) {
    SemanticProductResolved(product, resolved) -> (product, resolved)
    SemanticProductRejected(_) -> panic("Semantic substitution unexpectedly rejected")
  }
}

fn semantic_product_add_named(
  product: SemanticTypeProductBuilder,
  declaration: DeclarationIdentity,
  role: SemanticNamedRole,
  representation: SemanticTypeId,
  arguments: List<SemanticTypeId>
) -> SemanticProductResolution {
  let builder = semantic_type_graph_builder(semantic_type_product_segment(product, 0))
  let (builder, argument_list) = builder.type_list(arguments)
  let (builder, root) = builder.named(
    declaration,
    role,
    representation,
    argument_list
  )
  SemanticProductResolved(
    semantic_type_product_add_graph(product, builder.freeze()),
    root
  )
}

fn semantic_product_expand_definition(
  product: SemanticTypeProductBuilder,
  environment: SemanticTypeEnvironment,
  declaration: RegisteredName,
  parameters: TypeParamList,
  arguments: List<SemanticTypeId>,
  target: TypeExpr,
  opaque: bool
) -> SemanticProductResolution {
  match environment_for_definition(
    environment,
    declaration.identity,
    parameters
  ) {
    definition: SemanticTypeEnvironment -> match resolve_type_product_with(
      product,
      definition,
      target
    ) {
      SemanticProductResolved(product, template) ->
        match semantic_product_bind_parameters(
          parameters,
          arguments,
          semantic_type_substitution_empty()
        ) {
          SemanticProductSubstitutionResolved(substitution) ->
            match semantic_product_substitute(product, substitution, template) {
              SemanticProductResolved(product, resolved) -> if opaque {
                semantic_product_add_named(
                  product,
                  declaration.identity,
                  SemanticOpaqueType,
                  resolved,
                  arguments
                )
              } else { SemanticProductResolved(product, resolved) }
              SemanticProductRejected(issue) -> SemanticProductRejected(issue)
            }
          SemanticProductSubstitutionRejected(issue) -> SemanticProductRejected(issue)
        }
      SemanticProductRejected(issue) -> SemanticProductRejected(issue)
    }
    nil -> SemanticProductRejected(
      SemanticRecursiveTypeDefinition(declaration.identity)
    )
  }
}

fn semantic_product_named_declaration(
  product: SemanticTypeProductBuilder,
  environment: SemanticTypeEnvironment,
  declaration: RegisteredName,
  arguments: TypeExprList
) -> SemanticProductResolution {
  match environment_registered_type(environment, declaration.identity) {
    registered: RegisteredType -> {
      let parameters = registered_type_parameters(registered)
      let expected = __i64_to_usize(type_param_list_len(parameters))
      let actual = __i64_to_usize(type_expr_list_len(arguments))
      if expected != actual {
        SemanticProductRejected(SemanticTypeArgumentCount(expected, actual))
      } else {
        match semantic_product_values(product, environment, arguments) {
          SemanticProductValuesResolved(product, resolved_arguments) -> match registered {
            RegisteredRecordType(_, _, _) -> {
              let builder = semantic_type_graph_builder(
                semantic_type_product_segment(product, 0)
              )
              let (builder, representation) = builder.top()
              let (builder, argument_list) = builder.type_list(resolved_arguments)
              let (builder, root) = builder.named(
                declaration.identity,
                SemanticNominalType,
                representation,
                argument_list
              )
              SemanticProductResolved(
                semantic_type_product_add_graph(product, builder.freeze()),
                root
              )
            }
            RegisteredVariantType(_, _, _) -> {
              let builder = semantic_type_graph_builder(
                semantic_type_product_segment(product, 0)
              )
              let (builder, representation) = builder.top()
              let (builder, argument_list) = builder.type_list(resolved_arguments)
              let (builder, root) = builder.named(
                declaration.identity,
                SemanticNominalType,
                representation,
                argument_list
              )
              SemanticProductResolved(
                semantic_type_product_add_graph(product, builder.freeze()),
                root
              )
            }
            RegisteredOpaqueType(_, _, representation) ->
              semantic_product_expand_definition(
                product,
                environment,
                declaration,
                parameters,
                resolved_arguments,
                representation,
                true
              )
            RegisteredAliasType(_, _, target) -> semantic_product_expand_definition(
              product,
              environment,
              declaration,
              parameters,
              resolved_arguments,
              target,
              false
            )
          }
          SemanticProductValuesRejected(issue) -> SemanticProductRejected(issue)
        }
      }
    }
    nil -> SemanticProductRejected(SemanticDeclarationResolutionRequired)
  }
}

fn semantic_product_unqualified_named(
  product: SemanticTypeProductBuilder,
  environment: SemanticTypeEnvironment,
  arguments: TypeExprList,
  range: TypeNameRange
) -> SemanticProductResolution {
  match environment_declaration(environment, TypeDeclaration, range) {
    declaration: RegisteredName -> semantic_product_named_declaration(
      product,
      environment,
      declaration,
      arguments
    )
    nil -> SemanticProductRejected(SemanticDeclarationResolutionRequired)
  }
}

fn semantic_product_qualified_named(
  product: SemanticTypeProductBuilder,
  environment: SemanticTypeEnvironment,
  base: TypeExpr,
  range: TypeNameRange
) -> SemanticProductResolution {
  match base {
    NamedTypeExpr(_, _, arguments, SourceTypeOrigin(qualifier)) -> {
      let member_start = qualifier.start + qualifier.length + 1
      let member_length = range.start + range.length - member_start
      if member_length <= 0 {
        SemanticProductRejected(SemanticDeclarationResolutionRequired)
      } else {
        let member = TypeNameRange { start: member_start, length: member_length }
        match environment_qualified_declaration(
          environment,
          TypeDeclaration,
          qualifier,
          member
        ) {
          declaration: RegisteredName -> semantic_product_named_declaration(
            product,
            environment,
            declaration,
            arguments
          )
          nil -> SemanticProductRejected(SemanticDeclarationResolutionRequired)
        }
      }
    }
    _ -> SemanticProductRejected(SemanticDeclarationResolutionRequired)
  }
}

fn semantic_product_associated_projection(
  product: SemanticTypeProductBuilder,
  environment: SemanticTypeEnvironment,
  base: TypeExpr,
  range: TypeNameRange
) -> SemanticProductResolution {
  match base {
    VariableTypeExpr(variable) -> match environment_associated_declaration(
      environment,
      variable,
      range
    ) {
      declaration: RegisteredName -> match resolve_type_product_with(
        product,
        environment,
        base
      ) {
        SemanticProductResolved(product, resolved_base) -> {
          let builder = semantic_type_graph_builder(
            semantic_type_product_segment(product, 0)
          )
          let (builder, resolved) = builder.associated(
            resolved_base,
            declaration.identity
          )
          SemanticProductResolved(
            semantic_type_product_add_graph(product, builder.freeze()),
            resolved
          )
        }
        SemanticProductRejected(issue) -> SemanticProductRejected(issue)
      }
      nil -> SemanticProductRejected(SemanticDeclarationResolutionRequired)
    }
    _ -> semantic_product_qualified_named(product, environment, base, range)
  }
}

fn semantic_product_expanded_binary(
  product: SemanticTypeProductBuilder,
  environment: SemanticTypeEnvironment,
  left: TypeExpr,
  right: TypeExpr,
  intersection: bool
) -> SemanticProductResolution {
  match resolve_type_product_with(product, environment, left) {
    SemanticProductResolved(product, resolved_left) -> match resolve_type_product_with(
      product,
      environment,
      right
    ) {
      SemanticProductResolved(product, resolved_right) -> semantic_product_add_binary(
        product,
        resolved_left,
        resolved_right,
        intersection
      )
      SemanticProductRejected(issue) -> SemanticProductRejected(issue)
    }
    SemanticProductRejected(issue) -> SemanticProductRejected(issue)
  }
}

fn semantic_product_expanded_unary(
  product: SemanticTypeProductBuilder,
  environment: SemanticTypeEnvironment,
  inner: TypeExpr,
  kind: i64
) -> SemanticProductResolution {
  match resolve_type_product_with(product, environment, inner) {
    SemanticProductResolved(product, resolved) -> semantic_product_add_unary(
      product,
      resolved,
      kind
    )
    SemanticProductRejected(issue) -> SemanticProductRejected(issue)
  }
}

fn semantic_product_expanded_mutable_unary(
  product: SemanticTypeProductBuilder,
  environment: SemanticTypeEnvironment,
  inner: TypeExpr,
  access: TypeAccess,
  kind: i64
) -> SemanticProductResolution {
  match resolve_type_product_with(product, environment, inner) {
    SemanticProductResolved(product, resolved) -> semantic_product_add_mutable_unary(
      product,
      resolved,
      access,
      kind
    )
    SemanticProductRejected(issue) -> SemanticProductRejected(issue)
  }
}

fn semantic_product_expanded_function(
  product: SemanticTypeProductBuilder,
  environment: SemanticTypeEnvironment,
  parameters: TypeExprList,
  result: TypeExpr,
  effects: TypeExpr
) -> SemanticProductResolution {
  match semantic_product_values(product, environment, parameters) {
    SemanticProductValuesResolved(product, parameter_values) ->
      match resolve_type_product_with(product, environment, result) {
        SemanticProductResolved(product, result_value) -> match effects {
          EffectSetTypeExpr(atoms, tail) -> match semantic_product_effect_set(
            product,
            environment,
            atoms,
            tail
          ) {
            SemanticProductResolved(product, effect_value) -> {
              let builder = semantic_type_graph_builder(
                semantic_type_product_segment(product, 0)
              )
              let (builder, parameter_list) = builder.type_list(parameter_values)
              let (builder, root) = builder.function(
                parameter_list,
                result_value,
                effect_value
              )
              SemanticProductResolved(
                semantic_type_product_add_graph(product, builder.freeze()),
                root
              )
            }
            SemanticProductRejected(issue) -> SemanticProductRejected(issue)
          }
          _ -> SemanticProductRejected(SemanticUnsupportedAuthoredType(6))
        }
        SemanticProductRejected(issue) -> SemanticProductRejected(issue)
      }
    SemanticProductValuesRejected(issue) -> SemanticProductRejected(issue)
  }
}

fn resolve_type_product_expanded(
  product: SemanticTypeProductBuilder,
  environment: SemanticTypeEnvironment,
  ty: TypeExpr
) -> SemanticProductResolution {
  match ty {
    UnionTypeExpr(left, right) -> semantic_product_expanded_binary(
      product,
      environment,
      left,
      right,
      false
    )
    IntersectionTypeExpr(left, right) -> semantic_product_expanded_binary(
      product,
      environment,
      left,
      right,
      true
    )
    ComplementTypeExpr(inner) -> semantic_product_expanded_unary(
      product,
      environment,
      inner,
      0
    )
    FunctionTypeExpr(parameters, result, effects) -> semantic_product_expanded_function(
      product,
      environment,
      parameters,
      result,
      effects
    )
    RecordTypeExpr(fields, extent, NamedTypeFields) ->
      match semantic_product_record_fields(product, environment, fields) {
        SemanticProductRecordFieldsResolved(product, names, values) ->
          semantic_product_add_record(product, names, values, record_openness(extent))
        SemanticProductRecordFieldsRejected(issue) -> SemanticProductRejected(issue)
      }
    RecordTypeExpr(fields, _, PositionalTypeFields) ->
      match semantic_product_tuple_fields(product, environment, fields) {
        SemanticProductValuesResolved(product, values) -> semantic_product_add_tuple(
          product,
          values
        )
        SemanticProductValuesRejected(issue) -> SemanticProductRejected(issue)
      }
    NamedTypeExpr(_, _, arguments, SourceTypeOrigin(range)) ->
      semantic_product_unqualified_named(product, environment, arguments, range)
    SourceAssociatedTypeExpr(base, _, range) -> semantic_product_associated_projection(
      product,
      environment,
      base,
      range
    )
    UnqualifiedEffectTypeExpr(_, _, _) -> semantic_product_effect_atom(
      product,
      environment,
      ty
    )
    QualifiedEffectTypeExpr(_, _, _) -> semantic_product_effect_atom(
      product,
      environment,
      ty
    )
    EffectSetTypeExpr(atoms, tail) -> semantic_product_effect_set(
      product,
      environment,
      atoms,
      tail
    )
    ConstraintTypeExpr(constraint, bindings) -> semantic_product_trait_constraint(
      product,
      environment,
      constraint,
      bindings
    )
    ContinuationTypeExpr(input, result) -> match resolve_type_product_with(
      product,
      environment,
      input
    ) {
      SemanticProductResolved(product, resolved_input) -> match resolve_type_product_with(
        product,
        environment,
        result
      ) {
        SemanticProductResolved(product, resolved_result) -> {
          let builder = semantic_type_graph_builder(
            semantic_type_product_segment(product, 0)
          )
          let (builder, root) = builder.continuation(resolved_input, resolved_result)
          SemanticProductResolved(
            semantic_type_product_add_graph(product, builder.freeze()),
            root
          )
        }
        SemanticProductRejected(issue) -> SemanticProductRejected(issue)
      }
      SemanticProductRejected(issue) -> SemanticProductRejected(issue)
    }
    PointerTypeExpr(inner, access) -> semantic_product_expanded_mutable_unary(
      product,
      environment,
      inner,
      access,
      0
    )
    BorrowTypeExpr(inner, access) -> semantic_product_expanded_mutable_unary(
      product,
      environment,
      inner,
      access,
      1
    )
    SliceTypeExpr(inner, access) -> semantic_product_expanded_mutable_unary(
      product,
      environment,
      inner,
      access,
      2
    )
    WeakTypeExpr(inner) -> semantic_product_expanded_unary(
      product,
      environment,
      inner,
      1
    )
    AtomicTypeExpr(inner) -> semantic_product_expanded_unary(
      product,
      environment,
      inner,
      2
    )
    UniqueTypeExpr(inner) -> semantic_product_expanded_unary(
      product,
      environment,
      inner,
      3
    )
    OwnedTypeExpr(inner) -> semantic_product_expanded_unary(
      product,
      environment,
      inner,
      4
    )
    ArrayTypeExpr(inner, length) -> if length < 0 {
      SemanticProductRejected(SemanticInvalidArrayLength(length))
    } else {
      match resolve_type_product_with(product, environment, inner) {
        SemanticProductResolved(product, element) -> {
          let builder = semantic_type_graph_builder(
            semantic_type_product_segment(product, 0)
          )
          let (builder, root) = builder.array(element, __i64_to_usize(length))
          SemanticProductResolved(
            semantic_type_product_add_graph(product, builder.freeze()),
            root
          )
        }
        SemanticProductRejected(issue) -> SemanticProductRejected(issue)
      }
    }
    _ -> SemanticProductRejected(SemanticDeclarationResolutionRequired)
  }
}

fn resolve_type_product_with(
  product: SemanticTypeProductBuilder,
  environment: SemanticTypeEnvironment,
  ty: TypeExpr
) -> SemanticProductResolution {
  let builder = semantic_type_graph_builder(semantic_type_product_segment(product, 0))
  match resolve_type_with(builder, environment, ty) {
    (builder, SemanticTypeResolved(root)) -> SemanticProductResolved(
      semantic_type_product_add_graph(product, builder.freeze()),
      root
    )
    (builder, SemanticTypeRejected(SemanticDefinitionExpansionRequired(_))) -> {
      builder.drop()
      resolve_type_product_expanded(product, environment, ty)
    }
    (builder, SemanticTypeRejected(issue)) -> {
      builder.drop()
      SemanticProductRejected(issue)
    }
  }
}

pub(package) fn resolve_function_signature_product_in_scope(
  product: SemanticTypeProductBuilder,
  module: RegisteredModule,
  scope: RegistrationScope,
  function: FunctionSyntax
) -> (SemanticTypeProductBuilder, SemanticTypeResolution) {
  resolve_function_signature_product_with_self_in_scope(
    product,
    module,
    scope,
    function,
    nil
  )
}

pub(package) fn resolve_function_signature_product_with_self_in_scope(
  product: SemanticTypeProductBuilder,
  module: RegisteredModule,
  scope: RegistrationScope,
  function: FunctionSyntax,
  self_trait: TypeExpr?
) -> (SemanticTypeProductBuilder, SemanticTypeResolution) {
  match resolve_type_product_with(
    product,
    SemanticTypesInScope(
      module,
      scope,
      Nil<DeclarationIdentity>(),
      function.type_params,
      self_trait
    ),
    FunctionTypeExpr(
      parameter_types(function.params),
      function.result,
      effect_type(function.effects)
    )
  ) {
    SemanticProductResolved(product, root) -> (
      product,
      SemanticTypeResolved(root)
    )
    SemanticProductRejected(issue) -> (
      product,
      SemanticTypeRejected(issue)
    )
  }
}

pub(package) fn resolve_type_product_in_scope(
  product: SemanticTypeProductBuilder,
  module: RegisteredModule,
  scope: RegistrationScope,
  parameters: TypeParamList,
  ty: TypeExpr
) -> (SemanticTypeProductBuilder, SemanticTypeResolution) {
  resolve_type_product_with_self_in_scope(
    product,
    module,
    scope,
    parameters,
    nil,
    ty
  )
}

pub(package) fn resolve_type_product_with_self_in_scope(
  product: SemanticTypeProductBuilder,
  module: RegisteredModule,
  scope: RegistrationScope,
  parameters: TypeParamList,
  self_trait: TypeExpr?,
  ty: TypeExpr
) -> (SemanticTypeProductBuilder, SemanticTypeResolution) {
  match resolve_type_product_with(
    product,
    SemanticTypesInScope(
      module,
      scope,
      Nil<DeclarationIdentity>(),
      parameters,
      self_trait
    ),
    ty
  ) {
    SemanticProductResolved(product, root) -> (
      product,
      SemanticTypeResolved(root)
    )
    SemanticProductRejected(issue) -> (
      product,
      SemanticTypeRejected(issue)
    )
  }
}
