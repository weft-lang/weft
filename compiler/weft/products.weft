-- Retained compiler products shared by grammar checking and later passes.
-- Storage views remain private until the inspectable syntax/fact migration
-- replaces them. A TypedModule is a fact view; only Checked grants acceptance.

use compiler/source/owners.{SourceOwners}
use compiler/weft/syntax/declarations.{SourceDeclaration}
use stdlib/list.{List}

pub(package) type AstModule {
  AstModule(i64, i64, i64, SourceOwners, List<SourceDeclaration>)
}

-- Host assembly retains the root's canonical syntax alongside callable
-- storage. Imported declarations never become tests of the importing root.
pub(package) type LoadedModuleSyntax {
  functions: i64,
  owners: SourceOwners,
  declarations: List<SourceDeclaration>
}

pub(package) type TypedModule {
  TypedModule(i64, i64, i64, SourceOwners)
}
