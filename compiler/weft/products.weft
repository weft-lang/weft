-- Retained compiler products shared by grammar checking and later passes.
-- Storage views remain private until the inspectable syntax/fact migration
-- replaces them. A TypedModule is a fact view; only Checked grants acceptance.

use compiler/source/owners.{SourceOwners}

pub(package) type AstModule {
  AstModule(i64, i64, i64, SourceOwners)
}

pub(package) type TypedModule {
  TypedModule(i64, i64, i64, SourceOwners)
}
