-- compiler/weft/test_prepare.weft -- shared test-source preparation boundary
--
-- Check, test, LSP, MCP, and project sessions must agree on the source and AST
-- transformation that makes `test` declarations checkable as ordinary
-- package-visible functions. Runtime harness generation and execution remain
-- command concerns; this module owns only deterministic compiler input.

use compiler/ir/data.{*}
use compiler/weft/syntax/declarations.{
  FunctionSyntax,
  SourceDeclaration,
  TestSyntax,
  TestDefinition
}
use stdlib/list.{List, Nil}
use stdlib/option.{Some, None}
use stdlib/panic.{panic}
use compiler/storage.{nlist_add, nlist_get, nlist_len, nlist_new}
use compiler/project/module.{*}
use compiler/project/identity.{ValueDeclaration}
use compiler/weft/check/declarations.{register_function}
use compiler/weft/check/registration/catalog.{RegisteredModule, registered_module_name}
use compiler/weft/check/registration/scope.{
  RegistrationScope,
  registration_builder,
  registration_builder_add_synthetic,
  registration_builder_freeze,
  registration_scope_combined,
  registration_scope_find_source
}
use compiler/weft/check/table.{effect_name_hash}
use compiler/weft/check/body.{effect_hash_unsafe}
use stdlib/string.{int_to_str, str_concat}

pub(package) type TestPreparedSource {
  TestPreparedSource(str, i64)
}

pub(package) type WrappedTestModule {
  functions: i64,
  registrations: RegistrationScope
}

pub(package) fn test_prepare_source_content(prepared: TestPreparedSource) -> str {
  match prepared { TestPreparedSource(content, wrapper_bank_start) -> content }
}

pub(package) fn test_prepare_source_wrapper_bank_start(prepared: TestPreparedSource) -> i64 {
  match prepared { TestPreparedSource(content, wrapper_bank_start) -> wrapper_bank_start }
}

pub(package) fn test_prepare_wrapper_name(index: i64) -> str {
  str_concat("t_", int_to_str(index))
}

pub(package) fn test_prepare_wrapper_name_digit_count(index: i64) -> i64 {
  if index < 10 { 1 } else { 1 + test_prepare_wrapper_name_digit_count(index / 10) }
}

pub(package) fn test_prepare_wrapper_name_len(index: i64) -> i64 {
  2 + test_prepare_wrapper_name_digit_count(index)
}

pub(package) fn test_prepare_wrapper_name_offset_from_bank(
  name_bank_start: i64,
  index: i64
) -> i64 {
  let mut offset = name_bank_start + 4
  let mut i = 0
  while i < index {
    offset = offset + test_prepare_wrapper_name_len(i) + 1
    i = i + 1
  }
  offset
}

fn test_prepare_name_bank(index: i64, count: i64, acc: str) -> str {
  if index >= count { acc }
  else {
    test_prepare_name_bank(
      index + 1,
      count,
      str_concat(acc, str_concat(test_prepare_wrapper_name(index), " "))
    )
  }
}

pub(package) fn test_prepare_source(raw: str, wrapper_count: i64) -> TestPreparedSource {
  let prefix = "use stdlib/test.{*} "
  let wrapper_bank_start = __str_len(prefix) + __str_len(raw)
  let bank = if wrapper_count <= 0 { "" }
  else { test_prepare_name_bank(0, wrapper_count, "\n-- ") }
  TestPreparedSource(str_concat(prefix, str_concat(raw, bank)), wrapper_bank_start)
}

-- Selection is an interpretation of the parser's canonical declarations.
-- No function-body decoding is needed to discover or count tests.
pub(package) fn tests(declarations: List<SourceDeclaration>) -> List<TestSyntax> {
  let mut result: List<TestSyntax> = Nil
  for declaration in declarations {
    match declaration.syntax {
      TestDefinition(case_syntax) -> { result = result.prepend(case_syntax) }
      _ -> nil
    }
  }
  result.reverse()
}

pub(package) fn count(declarations: List<SourceDeclaration>) -> i64 {
  let mut total = 0
  for declaration in declarations {
    match declaration.syntax {
      TestDefinition(_) -> { total = total + 1 }
      _ -> nil
    }
  }
  total
}

-- The effect signature of every generated wrapper: `Test`, plus `Unsafe` for
-- trusted roots whose linked tests perform raw calls. The generated harness
-- chain declares the same effects, so the callee-subset check accepts the
-- wrapper calls.
pub(package) fn wrapper_effects(trusted: bool) -> EffectSig {
  let test_atom = EffectApplicationTypeExpr(
    effect_name_hash(__str_ptr("Test"), 0, 4),
    TypeExprListNil
  )
  let atoms = if trusted {
    TypeExprListCons(
      test_atom,
      TypeExprListCons(
        EffectApplicationTypeExpr(effect_hash_unsafe(), TypeExprListNil),
        TypeExprListNil,
        nil
      ),
      nil
    )
  } else { TypeExprListCons(test_atom, TypeExprListNil, nil) }
  EffectSig(atoms, 0)
}

-- A test declaration becomes an ordinary typed function whose body is the
-- authored block; it registers through the same path as authored functions.
-- The compiler-owned harness is an SDK module in installed layouts. Only
-- reserved synthetic wrappers cross its one-way import edge into the user
-- test module, so they are public values; authored declarations keep their
-- own visibility and package.
pub(package) fn add_wrapper(
  regular: i64,
  case_syntax: TestSyntax,
  test_src: i64,
  test_effects: EffectSig,
  index: i64,
  name_bank_start: i64,
  tt: i64
) -> nil {
  let wrapper = FunctionSyntax {
    name: TypeNameRange {
      start: test_prepare_wrapper_name_offset_from_bank(name_bank_start, index),
      length: test_prepare_wrapper_name_len(index)
    },
    params: ParamListNil,
    result: MissingTypeExpr,
    effects: test_effects,
    type_params: TypeParamListNil,
    body: case_syntax.body
  }
  register_function(tt, test_src, wrapper, PublicVisibility, regular)
}

pub(package) fn wrapper_registrations(
  registrations: borrow RegistrationScope,
  test_src: i64,
  count: i64,
  name_bank_start: i64
) -> RegistrationScope {
  let module = match registration_scope_find_source(registrations, test_src) {
    Some(found) -> found
    None -> panic("test wrapper source has no retained module registration")
  }
  let builder = registration_builder()
  let mut index = 0
  while index < count {
    let range = TypeNameRange {
      start: test_prepare_wrapper_name_offset_from_bank(name_bank_start, index),
      length: test_prepare_wrapper_name_len(index)
    }
    registration_builder_add_synthetic(
      builder,
      registered_module_name(module, ValueDeclaration, range, PublicVisibility)
    )
    index = index + 1
  }
  registration_builder_freeze(builder)
}

pub(package) fn wrap(
  fns: i64,
  declarations: List<SourceDeclaration>,
  src: i64,
  name_bank_start: i64,
  tt: i64,
  registrations: RegistrationScope
) -> WrappedTestModule {
  let regular = nlist_new()
  for i in 0..nlist_len(fns) { nlist_add(regular, nlist_get(fns, i)) }
  let test_effects = wrapper_effects(false)
  let mut index = 0
  for case_syntax in tests(declarations) {
    add_wrapper(regular, case_syntax, src, test_effects, index, name_bank_start, tt)
    index = index + 1
  }
  WrappedTestModule {
    functions: regular,
    registrations: registration_scope_combined(
      registrations,
      wrapper_registrations(registrations, src, index, name_bank_start)
    )
  }
}
