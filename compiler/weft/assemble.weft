-- Retained native module assembly for the public checked-grammar path.
-- Acquisition stays separate from checking so the assembled product exposes
-- no parser node, checker table or raw function storage.

use compiler/diagnostic/observe.{observe_errors}
use compiler/project/identity.{ModuleIdentity}
use compiler/source/loading.{SourceLoader, source_loader_owners}
use compiler/pipeline.{
  pipeline_bind_checker_storage_census_prelude_with_registration_scope,
  pipeline_bind_native_runtime_preludes_inner_with_registration_scope,
  pipeline_bind_rc_census_prelude_with_registration_scope,
  pipeline_bind_runtime_preludes_inner_with_registration_scope
}
use compiler/weft/check/registration/scope.{
  RegistrationScope,
  registration_builder_freeze,
  registration_builder_from_scope
}
use compiler/weft/imports.{parse_bind_implicit_prelude_with_registration_scope}
use compiler/weft/load.{
  NativeRuntime,
  NativeRuntimeSupport,
  NativeRuntimeWithCheckerStorageCensus,
  NativeRuntimeWithRcCensus
}
use compiler/weft/products.{AssembledWeftProgram, AstModule}
use stdlib/diagnostic.{Diagnose}
use stdlib/grammar.{Checked, CheckRejected, CheckResult}

pub(package) fn assemble_weft_native_program_with_support_and_loader<E>(
  syntax: AstModule,
  root: ModuleIdentity,
  support: NativeRuntimeSupport,
  loader: SourceLoader<E>
) -[Diagnose, E]> CheckResult<AssembledWeftProgram> {
  let load: () -[Diagnose, E]> RegistrationScope = () => match syntax {
    AstModule(functions, source, table, _, (_, registrations)) -> {
      let builder = registration_builder_from_scope(registrations)
      pipeline_bind_native_runtime_preludes_inner_with_registration_scope<E>(
        functions,
        source,
        table,
        loader,
        builder
      )
      match support {
        NativeRuntime -> 0
        NativeRuntimeWithRcCensus ->
          pipeline_bind_rc_census_prelude_with_registration_scope<E>(
            functions,
            table,
            loader,
            builder
          )
        NativeRuntimeWithCheckerStorageCensus ->
          pipeline_bind_checker_storage_census_prelude_with_registration_scope<E>(
            functions,
            table,
            loader,
            builder
          )
      }
      parse_bind_implicit_prelude_with_registration_scope<E>(
        functions,
        source,
        table,
        loader,
        builder
      )
      pipeline_bind_runtime_preludes_inner_with_registration_scope<E>(
        functions,
        source,
        table,
        loader,
        builder
      )
      registration_builder_freeze(builder)
    }
  }
  assemble_weft_loaded_program<E>(root, loader, load)
}

-- Checking binds the implicit prelude and the runtime preludes that every
-- program sees; native assembly above also binds its runtime support.
pub(package) fn assemble_weft_program_with_loader<E>(
  syntax: AstModule,
  root: ModuleIdentity,
  loader: SourceLoader<E>
) -[Diagnose, E]> CheckResult<AssembledWeftProgram> {
  let load: () -[Diagnose, E]> RegistrationScope = () => match syntax {
    AstModule(functions, source, table, _, (_, registrations)) -> {
      let builder = registration_builder_from_scope(registrations)
      parse_bind_implicit_prelude_with_registration_scope<E>(
        functions,
        source,
        table,
        loader,
        builder
      )
      pipeline_bind_runtime_preludes_inner_with_registration_scope<E>(
        functions,
        source,
        table,
        loader,
        builder
      )
      registration_builder_freeze(builder)
    }
  }
  assemble_weft_loaded_program<E>(root, loader, load)
}

-- Loading diagnostics refuse publication even when recovery left a usable
-- registration forest, matching the legacy checker's loading boundary.
fn assemble_weft_loaded_program<E>(
  root: ModuleIdentity,
  loader: SourceLoader<E>,
  load: () -[Diagnose, E]> RegistrationScope
) -[Diagnose, E]> CheckResult<AssembledWeftProgram> {
  let (scope, errors) = observe_errors(load)
  if errors != 0 { CheckRejected<AssembledWeftProgram>() }
  else {
    Checked(
      AssembledWeftProgram {
        root: root,
        registrations: scope,
        owners: source_loader_owners(loader)
      }
    )
  }
}
