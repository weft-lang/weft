-- Parse-only inspection of canonical declarations. Rendering never rebuilds
-- checker nodes or depends on a checker table.

use compiler/weft/syntax/declarations.{
  SourceDeclaration,
  FunctionDefinition,
  TestDefinition,
  ImplDefinition,
  ImplMemberSyntax,
  ImplMethod,
  ImplTypeBinding
}
use compiler/ir/data.{*}
use stdlib/list.{List}
use stdlib/num
use stdlib/result.{Ok}
use stdlib/option.{Some, None}
use stdlib/string.{int_to_str, str_concat}
use stdlib/string/builder as builder
use stdlib/string/builder.{Builder}

fn source_text(source: str, start: i64, length: i64) -> str {
  if start < 0 or length < 0 or start > 9223372036854775807 - length { "<invalid range>" }
  else {
    match (start.to_usize_checked(), (start + length).to_usize_checked()) {
      (Ok(first), Ok(last)) -> match source.slice(first, last) {
        Some(text) -> text
        None -> "<invalid range>"
      }
      _ -> "<invalid range>"
    }
  }
}

fn present(expr: Expr) -> bool {
  match expr { UnknownExpr(0) -> false, _ -> true }
}

fn expressions(out: borrow mut Builder, items: ExprList, source: str, indent: str) -> nil {
  let mut remaining = items
  loop {
    match remaining {
      ExprListNil -> break
      ExprListCons(item, rest) -> {
        expression(out, item, source, indent)
        remaining = rest
      }
    }
  }
}

fn expression(out: borrow mut Builder, expr: Expr, source: str, indent: str) -> nil {
  out.append(indent)
  let child_indent = indent.concat("  ")
  match expr {
    IntLit(value, start, length) -> {
      out.append("IntLit(")
      out.append(if length > 0 { source_text(source, start, length) } else { int_to_str(value) })
      out.append(")\n")
    }
    Ident(start, length) -> {
      out.append("Ident(")
      out.append(source_text(source, start, length))
      out.append(")\n")
    }
    FloatLit(start, length, _) -> {
      out.append("FloatLit(")
      out.append(source_text(source, start, length))
      out.append(")\n")
    }
    StringLit(_, _, _, _) -> out.append("StringLit\n")
    BoolLit(value, _, _) -> out.append(
      if value == 1 { "BoolLit(true)\n" } else { "BoolLit(false)\n" }
    )
    BinOp(op, left, right) -> {
      out.append("BinOp(op=")
      out.append(int_to_str(op))
      out.append(")\n")
      expression(out, left, source, child_indent)
      expression(out, right, source, child_indent)
    }
    Apply(callee, args, _, _) -> {
      out.append("Apply\n")
      expression(out, callee, source, child_indent)
      expressions(out, args, source, child_indent)
    }
    Call(start, length, args) -> {
      out.append("Call(")
      out.append(source_text(source, start, length))
      out.append(", nargs=")
      out.append(int_to_str(expr_list_len(args)))
      out.append(")\n")
    }
    If(condition, yes, no) -> {
      out.append("If\n")
      expression(out, condition, source, child_indent)
      expression(out, yes, source, child_indent)
      if present(no) { expression(out, no, source, child_indent) }
    }
    Let(start, length, value, rest) -> {
      out.append("Let(")
      out.append(source_text(source, start, length))
      out.append(")\n")
      expression(out, value, source, child_indent)
      expression(out, rest, source, child_indent)
    }
    Block(first, rest) -> {
      out.append("Block\n")
      expression(out, first, source, child_indent)
      if present(rest) { expression(out, rest, source, child_indent) }
    }
    Negate(value, _) -> {
      out.append("Negate\n")
      expression(out, value, source, child_indent)
    }
    Match(value, arms, _) -> {
      out.append("Match(narms=")
      out.append(int_to_str(match_arm_list_len(arms)))
      out.append(")\n")
      expression(out, value, source, child_indent)
    }
    Defer(cleanup, rest, _) -> {
      out.append("Defer\n")
      expression(out, cleanup, source, child_indent)
      expression(out, rest, source, child_indent)
    }
    LetTyped(value, annotation) -> {
      out.append("LetTyped(type_tag=")
      out.append(int_to_str(type_expr_tag_or(annotation, 0)))
      out.append(", type_payload=")
      out.append(int_to_str(type_expr_prim_id_or(annotation, 0)))
      out.append(")\n")
      expression(out, value, source, child_indent)
    }
    other -> {
      out.append("Node(tag=")
      out.append(int_to_str(expr_tag(other)))
      out.append(")\n")
    }
  }
}

fn body(out: borrow mut Builder, kind: str, name: str, expr: Expr, source: str) -> nil {
  out.append(kind)
  out.append(" ")
  out.append(name)
  out.append(":\n")
  expression(out, expr, source, "  ")
  out.append("\n")
}

fn methods(out: borrow mut Builder, members: List<ImplMemberSyntax>, source: str) -> i64 {
  let mut count = 0
  for member in members {
    match member {
      ImplMethod(function, _) -> {
        body(
          out,
          "fn",
          source_text(source, function.name.start, function.name.length),
          function.body,
          source
        )
        count = count + 1
      }
      ImplTypeBinding(_, _, _) -> nil
    }
  }
  count
}

pub(package) fn render(declarations: List<SourceDeclaration>, source: str) -> str {
  let mut out = builder.new()
  let mut count = 0
  for declaration in declarations {
    match declaration.syntax {
      FunctionDefinition(function) -> {
        body(
          out,
          "fn",
          source_text(source, function.name.start, function.name.length),
          function.body,
          source
        )
        count = count + 1
      }
      TestDefinition(case_syntax) -> {
        body(out, "test", case_syntax.name, case_syntax.body, source)
        count = count + 1
      }
      ImplDefinition(implementation) -> {
        count = count + methods(out, implementation.members, source)
      }
      _ -> nil
    }
  }
  let text = out.finish()
  "--- AST: " |> str_concat(int_to_str(count)) |> str_concat(" functions ---\n\n") |> str_concat(
    text
  )
}
