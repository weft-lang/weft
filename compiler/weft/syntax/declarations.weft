-- Authored declarations before host registration or semantic resolution.
-- Names are source-relative ranges, never checker-table/source-buffer identities.

use compiler/weft/syntax/imports.{ImportSyntax, ImportDeclaration}
use compiler/ir/data.{*}
use compiler/project/module.{DeclVisibility}
use stdlib/list.{List}

pub(package) type FunctionSyntax {
  name: TypeNameRange,
  params: ParamList,
  result: TypeExpr,
  effects: EffectSig,
  type_params: TypeParamList,
  body: Expr
}

pub(package) type ConstantSyntax {
  name: TypeNameRange,
  declared_type: TypeExpr,
  initializer: Expr
}

pub(package) type ModuleHandlerSyntax {
  effect_reference: Expr,
  params: ParamList,
  clauses: HandlerClauseList,
  type_params: TypeParamList,
  keyword: TypeNameRange
}

pub(package) type DefaultHandlerSyntax { configuration: Expr, keyword: TypeNameRange }

pub(package) type RecordFieldSyntax { name: TypeNameRange, annotation: TypeExpr }

pub(package) type VariantMemberSyntax { name: TypeNameRange, payloads: List<TypeExpr> }

pub(package) type TypeSyntax {
  RecordSyntax(TypeNameRange, TypeParamList, List<RecordFieldSyntax>),
  VariantSyntax(TypeNameRange, TypeParamList, List<VariantMemberSyntax>),
  OpaqueSyntax(TypeNameRange, TypeParamList, TypeExpr),
  AliasSyntax(TypeNameRange, TypeParamList, TypeExpr)
}

pub(package) type EffectOperationSyntax { operation: TypeEffectOp, visibility: DeclVisibility }

pub(package) type EffectSyntax {
  name: TypeNameRange,
  type_params: TypeParamList,
  operations: List<EffectOperationSyntax>
}

pub(package) type TraitSyntax { name: TypeNameRange, members: TypeTraitMemberList }

pub(package) type ImplMemberSyntax {
  ImplMethod(FunctionSyntax, DeclVisibility),
  ImplTypeBinding(TypeNameRange, TypeExpr, TypeNameRange?)
}

pub(package) type ImplSyntax {
  name: TypeNameRange,
  type_params: TypeParamList,
  target: TypeImplTarget,
  members: List<ImplMemberSyntax>
}

pub(package) type TestSyntax {
  name: str,
  -- Authored string token, including quotes; decoded text has its own backing.
  name_range: TypeNameRange,
  body: Expr
}

pub(package) type DeclarationSyntax {
  FunctionDefinition(FunctionSyntax),
  TypeDefinition(TypeSyntax),
  EffectDefinition(EffectSyntax),
  TraitDefinition(TraitSyntax),
  ImplDefinition(ImplSyntax),
  ConstantDefinition(ConstantSyntax),
  HandlerDefinition(ModuleHandlerSyntax),
  DefaultHandlerDefinition(DefaultHandlerSyntax),
  ImportDefinition(ImportSyntax),
  TestDefinition(TestSyntax),
  InvalidDefinition
}

pub(package) type DeclarationValidity { ParsedDeclaration, RecoveredDeclaration }

pub(package) type DeclarationParse {
  syntax: DeclarationSyntax,
  next: i64
}

pub(package) type FunctionParse { syntax: FunctionSyntax, next: i64 }

pub(package) type SourceDeclaration {
  syntax: DeclarationSyntax,
  visibility: DeclVisibility,
  range: TypeNameRange,
  validity: DeclarationValidity
}

pub(package) type ParsedModuleSyntax {
  imports: List<ImportDeclaration>,
  declarations: List<SourceDeclaration>
}
