-- A concrete impl-method resolution. The method wrapper still carries the
-- generic signature; f3 is the substitution obtained by matching the impl
-- target against the receiver and f4 carries impl parameters + target type.
pub(package) fn method_resolution_new(method: i64, src: i64, subst: i64, tparams: i64, target_ty: i64, declaration: i64) -> i64 {
  node_new(71, method, src, subst, node_new(0, tparams, target_ty, declaration, 0))
}
pub(package) fn method_resolution_method(resolution: i64) -> i64 { node_f1(resolution) }
pub(package) fn method_resolution_src(resolution: i64) -> i64 { node_f2(resolution) }
pub(package) fn method_resolution_subst(resolution: i64) -> i64 { node_f3(resolution) }
pub(package) fn method_resolution_tparams(resolution: i64) -> i64 { node_f1(node_f4(resolution)) }
pub(package) fn method_resolution_target_ty(resolution: i64) -> i64 { node_f2(node_f4(resolution)) }
pub(package) fn method_resolution_declaration(resolution: i64) -> i64 { node_f3(node_f4(resolution)) }

pub(package) fn method_resolution_is_weak_prelude_only(tt: i64, caller_src: i64, resolution: i64) -> i64 {
  if resolution == 0 { 0 }
  else {
    let decl = method_resolution_declaration(resolution)
    if decl == 0 or module_decl_fact_namespace(decl) != module_decl_namespace_inherent_method() { 0 }
    else {
      let owner = module_decl_fact_owner(decl)
      let caller_module = module_fact_find_source(tt, caller_src)
      if owner == 0 or caller_module == 0 { 0 }
      else {
        module_scope_build_all(tt)
        let binding = module_scope_find_binding(tt, caller_module, module_decl_fact_name_ptr(owner), module_decl_fact_name_len(owner))
        if binding != 0 and module_scope_entry_target(binding) == owner and module_scope_entry_is_weak(binding) == 1 {
          if module_scope_strong_module_import_exposes_declaration(tt, caller_module, owner) == 1 { 0 } else { 1 }
        } else { 0 }
      }
    }
  }
}

pub(package) fn typeck_params_subst(params: i64, subst: i64) -> i64 {
  if params == 0 { 0 }
  else {
    let result = nlist_new()
    for i in 0..nlist_len(params) {
      let p = nlist_get(params, i)
      let param_ty = node_f3(p)
      nlist_add(result, node_new(node_tag(p), node_f1(p), node_f2(p), if param_ty == 0 { 0 } else { ty_subst(param_ty, subst) }, node_f4(p)))
    }
    result
  }
}

pub(package) fn method_resolution_params(resolution: i64) -> i64 {
  let method = method_resolution_method(resolution)
  typeck_params_subst(node_f3(fn_inner(method)), method_resolution_subst(resolution))
}

pub(package) fn method_resolution_ret(resolution: i64) -> i64 {
  ty_subst(fn_ret_type(method_resolution_method(resolution)), method_resolution_subst(resolution))
}

pub(package) fn method_resolution_effects(resolution: i64) -> i64 {
  let effects = fn_effects(method_resolution_method(resolution))
  if effects == 0 { 0 } else { ty_subst(effects, method_resolution_subst(resolution)) }
}

pub(package) fn method_resolution_call_subst(resolution: i64, method_ref: i64) -> i64 {
  let method = method_resolution_method(resolution)
  let tparams = fn_tparams(method)
  let type_args = method_ref_type_args(method_ref)
  let impl_tparams = method_resolution_tparams(resolution)
  let first_local = if impl_tparams == 0 { 0 } else { nlist_len(impl_tparams) }
  let count = if tparams == 0 { 0 } else { nlist_len(tparams) }
  -- Apply enclosing and method-local arguments to the raw signature in one
  -- capture-avoiding pass. Sequential substitution can reinterpret caller
  -- variables inside an impl binding as method variables with the same local
  -- ids: Vector<Pair<K, V>> became Vector<Pair<Pair<K, V>, V>>.
  let subst = subst_new()
  let resolved = method_resolution_subst(resolution)
  for i in 0..nlist_len(resolved) {
    let binding = nlist_get(resolved, i)
    subst_add(subst, node_f1(binding), node_f2(binding))
  }
  if type_args != 0 {
    let available = nlist_len(type_args)
    let mut i = first_local
    while i < count {
      if i < available {
        subst_add(subst, node_f3(nlist_get(tparams, i)), nlist_get(type_args, i))
      } else { 0 }
      i = i + 1
    }
  } else { 0 }
  subst
}

pub(package) fn method_resolution_params_for_ref(resolution: i64, method_ref: i64) -> i64 {
  let method = method_resolution_method(resolution)
  typeck_params_subst(node_f3(fn_inner(method)), method_resolution_call_subst(resolution, method_ref))
}

pub(package) fn method_resolution_ret_for_ref(resolution: i64, method_ref: i64, tt: i64) -> i64 {
  let method = method_resolution_method(resolution)
  typeck_subst_resolve_associated_type(
    fn_ret_type(method),
    fn_tparams(method),
    method_resolution_call_subst(resolution, method_ref),
    tt
  )
}

pub(package) fn method_resolution_effects_for_ref(resolution: i64, method_ref: i64) -> i64 {
  let effects = fn_effects(method_resolution_method(resolution))
  if effects == 0 { 0 } else { ty_subst(effects, method_resolution_call_subst(resolution, method_ref)) }
}

pub(package) fn method_resolution_type_args(resolution: i64) -> i64 {
  ty_pattern_bound_args(method_resolution_tparams(resolution), method_resolution_subst(resolution))
}

pub(package) fn method_resolution_ref_type_args(resolution: i64, receiver_ty: i64) -> i64 {
  if method_resolution_tparams(resolution) != 0 { method_resolution_type_args(resolution) }
  else {
    let target_ty = method_resolution_target_ty(resolution)
    if target_ty != 0 and ty_tag(target_ty) == 9 { ty_f3(target_ty) } else { 0 }
  }
}

pub(package) fn impl_method_find(methods: i64, src: i64, method_hash: i64) -> i64 {
  let mut i = 0
  let mut result = 0
  while i < nlist_len(methods) {
    let method = nlist_get(methods, i)
    if method_impl_params(method, src, method_hash) != 0 {
      result = method
      i = nlist_len(methods)
    } else { i = i + 1 }
  }
  result
}

-- Resolve against the complete receiver type. A generic impl target binds its
-- parameters structurally; a legacy argument-less impl remains head-wide
-- until the stdlib declarations are migrated by the final effect-surface migration slice.
pub(package) fn ttable_resolve_method(tt: i64, receiver_ty: i64, owner_hash: i64, method_hash: i64) -> i64 {
  if tt == 0 { 0 }
  else {
    let n = mem_load64_at(tt, 8)
    let d = mem_load64_at(tt, 0)
    let mut i = 0
    let mut result = 0
    while i < n {
      let entry = d + i * 64
      let kind = mem_load64_at(entry, 16)
      if kind == 4 and mem_load64_at(entry, 56) == owner_hash {
        let impl_info = mem_load64_at(entry, 40)
        let target_ty = node_f3(impl_info)
        let tparams = node_f2(impl_info)
        let subst = subst_new()
        let target_matches = if tparams == 0 {
          if ty_eq(target_ty, receiver_ty) { true }
            else { ty_tag(target_ty) == 9 and not ty_named_is_opaque(target_ty) and not ty_named_is_opaque(receiver_ty) and ty_f1(target_ty) == owner_hash and ty_f3(target_ty) == 0 }
        } else { ty_pattern_match(target_ty, receiver_ty, subst) }
        if target_matches {
          let entry_src = mem_load64_at(entry, 48)
          let method = impl_method_find(mem_load64_at(entry, 32), entry_src, method_hash)
          if method != 0 {
            let type_decl = module_scope_lookup_declaration(tt, entry_src, module_decl_namespace_type(), entry_src, mem_load64_at(entry, 0), mem_load64_at(entry, 8))
            let method_inner = fn_inner(method)
            let method_decl = if node_f1(impl_info) == 0 {
              module_decl_fact_find_member(tt, type_decl, module_decl_namespace_inherent_method(), entry_src, node_f1(method_inner), node_f2(method_inner))
            } else {
              let trait_entry = lookup_trait_entry_ref(tt, node_f1(impl_info), node_f4(impl_info))
              let trait_src = if trait_entry == 0 { 0 } else { mem_load64_at(trait_entry, 48) }
              let trait_decl = if trait_entry == 0 { 0 } else { module_decl_fact_find(tt, trait_src, module_decl_namespace_trait(), trait_src, mem_load64_at(trait_entry, 0), mem_load64_at(trait_entry, 8)) }
              if trait_decl == 0 { 0 }
              else { module_decl_fact_find_member(tt, trait_decl, module_decl_namespace_trait_method(), trait_src, node_f1(method_inner), node_f2(method_inner)) }
            }
            result = method_resolution_new(method, entry_src, subst, tparams, target_ty, method_decl)
            i = n
          } else { i = i + 1 }
        } else { i = i + 1 }
      } else { i = i + 1 }
    }
    if result != 0 { result }
    else { if ty_is_unique(receiver_ty) {
      ttable_resolve_method(tt, ty_unique_inner(receiver_ty), owner_hash, method_hash)
    } else { if ty_is_owned(receiver_ty) {
      ttable_resolve_method(tt, ty_owned_inner(receiver_ty), owner_hash, method_hash)
    } else { result } } }
  }
}

pub(package) fn ttable_lookup_method_ret(tt: i64, type_hash: i64, method_hash: i64) -> i64 {
  if tt == 0 { 0 }
  else {
    let n = mem_load64_at(tt, 8)
    let d = mem_load64_at(tt, 0)
    let mut i = 0
    let mut result = 0
    while i < n {
      let entry = d + i * 64
      let entry_src = mem_load64_at(entry, 48)
      let ns = mem_load64_at(entry, 0)
      let nl = mem_load64_at(entry, 8)
      let kind = mem_load64_at(entry, 16)
      if kind == 3 or kind == 4 {
        let entry_hash = mem_load64_at(entry, 56)
        if entry_hash == type_hash {
          let methods = mem_load64_at(entry, 32)
          let nmethods = mem_load64_at(entry, 24)
          let mut mi = 0
          while mi < nmethods {
            let m = nlist_get(methods, mi)
            let ret = if kind == 3 { method_trait_ret(m, entry_src, method_hash) } else { method_impl_ret(m, entry_src, method_hash) }
            if ret != 0 { result = ret mi = nmethods i = n }
            else { mi = mi + 1 }
          }
          if result == 0 { i = i + 1 } else { i = n }
        } else { i = i + 1 }
      } else { i = i + 1 }
    }
    result
  }
}

