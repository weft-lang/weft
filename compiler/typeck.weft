  if src_eq(src, ns, nl, "__platform_read") == 1 { true }
  else { if src_eq(src, ns, nl, "__platform_open_read") == 1 { true }
  else { if src_eq(src, ns, nl, "__platform_open_write_create_new") == 1 { true }
  else { if src_eq(src, ns, nl, "__platform_open_write_create_truncate") == 1 { true }
