pub(package) fn intrinsic_platform_network_arity(src: i64, ns: i64, nl: i64) -> i64 {
  let tcp = intrinsic_platform_tcp_arity(src, ns, nl)
  let poller = if tcp >= 0 { tcp } else { intrinsic_platform_net_poller_arity(src, ns, nl) }
  if poller >= 0 { poller } else {
    if src_eq(src, ns, nl, "__platform_secure_random_read") == 1 { 2 }
    else { if src_eq(src, ns, nl, "__platform_dns_udp_socket") == 1 { 1 }
    else { if src_eq(src, ns, nl, "__platform_dns_tcp_socket") == 1 { 1 }
    else { if src_eq(src, ns, nl, "__platform_dns_connect") == 1 { 3 }
    else { if src_eq(src, ns, nl, "__platform_dns_set_receive_timeout") == 1 { 2 }
    else { if src_eq(src, ns, nl, "__platform_dns_system_available") == 1 { 0 }
    else { if src_eq(src, ns, nl, "__platform_dns_system_resolve") == 1 { 4 }
    else { if src_eq(src, ns, nl, "__platform_dns_system_release") == 1 { 1 }
    else { if src_eq(src, ns, nl, "__platform_dns_system_error") == 1 { 0 }
    else { 0 - 1 } } } } } } } } } }
  }
}

pub(package) fn check_intrinsic_args(node: i64, env: i64, ft: i64, src: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let ns = node_f1(node)
  let nl = node_f2(node)
  let int_cast_arg_ty = intrinsic_int_cast_arg_ty(src, ns, nl)
  let int_to_f64_arg_ty = intrinsic_int_to_f64_arg_ty(src, ns, nl)
  let int_to_f32_arg_ty = intrinsic_int_to_f32_arg_ty(src, ns, nl)
  if int_cast_arg_ty != 0 {
    check_intrinsic_one_arg_type(node, env, ft, src, tt, int_cast_arg_ty)
  } else { if int_to_f64_arg_ty != 0 {
    check_intrinsic_one_arg_type(node, env, ft, src, tt, int_to_f64_arg_ty)
  } else { if int_to_f32_arg_ty != 0 {
    check_intrinsic_one_arg_type(node, env, ft, src, tt, int_to_f32_arg_ty)
  } else { if src_eq(src, ns, nl, "__f64_to_i64_trunc") == 1 {
    check_intrinsic_f64_to_i64_trunc_args(node, env, ft, src, tt)
  } else { if src_eq(src, ns, nl, "__f32_to_f64") == 1 {
    check_intrinsic_f32_to_f64_args(node, env, ft, src, tt)
  } else { if src_eq(src, ns, nl, "__f64_to_f32") == 1 {
    check_intrinsic_f64_to_f32_args(node, env, ft, src, tt)
  } else { if src_eq(src, ns, nl, "__f64_sqrt") == 1 {
    check_intrinsic_one_arg_type(node, env, ft, src, tt, ty_f64())
  } else { if src_eq(src, ns, nl, "__f32_sqrt") == 1 {
    check_intrinsic_one_arg_type(node, env, ft, src, tt, ty_f32())
  } else { if src_eq(src, ns, nl, "__frame_pointer") == 1 {
    if node_f4(node) == 0 { 0 }
    else {
      typeck_error_maybe(src, node_f1(node), "type error: arity mismatch")
      1
    }
  } else { if src_eq(src, ns, nl, "__raw_offset") == 1 {
    check_intrinsic_raw_offset_args(node, env, ft, src, tt)
  } else { if src_eq(src, ns, nl, "__transmute") == 1 {
    check_intrinsic_one_arg_any(node, src)
  } else { if src_eq(src, ns, nl, "__int_to_ptr") == 1 {
    check_intrinsic_one_arg_type(node, env, ft, src, tt, ty_i64())
  } else { if src_eq(src, ns, nl, "__mem_load_sized") == 1 {
    check_intrinsic_mem_load_sized_args(node, env, ft, src, tt)
  } else { if src_eq(src, ns, nl, "__mem_store_sized") == 1 {
    check_intrinsic_mem_store_sized_args(node, env, ft, src, tt)
  } else { if src_eq(src, ns, nl, "__platform_read") == 1 {
    check_intrinsic_i64_args(node, 3, env, ft, src, tt)
  } else { if src_eq(src, ns, nl, "__platform_open_read") == 1 {
    check_intrinsic_i64_args(node, 1, env, ft, src, tt)
  } else { if src_eq(src, ns, nl, "__platform_open_write_create_new") == 1 {
    check_intrinsic_i64_args(node, 2, env, ft, src, tt)
  } else { if src_eq(src, ns, nl, "__platform_open_write_create_truncate") == 1 {
    check_intrinsic_i64_args(node, 2, env, ft, src, tt)
  } else { if src_eq(src, ns, nl, "__platform_open_write_append") == 1 {
    check_intrinsic_i64_args(node, 2, env, ft, src, tt)
  } else { if src_eq(src, ns, nl, "__platform_open_read_write_create_truncate") == 1 {
    check_intrinsic_i64_args(node, 2, env, ft, src, tt)
  } else { if src_eq(src, ns, nl, "__platform_seek_start") == 1 {
    check_intrinsic_i64_args(node, 2, env, ft, src, tt)
  } else { if src_eq(src, ns, nl, "__platform_seek_current") == 1 {
    check_intrinsic_i64_args(node, 2, env, ft, src, tt)
  } else { if src_eq(src, ns, nl, "__platform_seek_end") == 1 {
    check_intrinsic_i64_args(node, 2, env, ft, src, tt)
  } else { if src_eq(src, ns, nl, "__platform_file_flush") == 1 {
    check_intrinsic_i64_args(node, 1, env, ft, src, tt)
  } else { if intrinsic_platform_directory_arity(src, ns, nl) >= 0 {
    check_intrinsic_i64_args(node, intrinsic_platform_directory_arity(src, ns, nl), env, ft, src, tt)
  } else { if intrinsic_platform_time_arity(src, ns, nl) >= 0 {
    check_intrinsic_i64_args(node, intrinsic_platform_time_arity(src, ns, nl), env, ft, src, tt)
  } else { if intrinsic_platform_proc_arity(src, ns, nl) >= 0 {
    check_intrinsic_i64_args(node, intrinsic_platform_proc_arity(src, ns, nl), env, ft, src, tt)
  } else { if intrinsic_platform_thread_arity(src, ns, nl) >= 0 {
    check_intrinsic_i64_args(node, intrinsic_platform_thread_arity(src, ns, nl), env, ft, src, tt)
  } else { if intrinsic_platform_network_arity(src, ns, nl) >= 0 {
    check_intrinsic_i64_args(node, intrinsic_platform_network_arity(src, ns, nl), env, ft, src, tt)
  } else { if src_eq(src, ns, nl, "__platform_close") == 1 {
    check_intrinsic_i64_args(node, 1, env, ft, src, tt)
  } else { if src_eq(src, ns, nl, "__platform_remove") == 1 {
    check_intrinsic_i64_args(node, 1, env, ft, src, tt)
  } else { if src_eq(src, ns, nl, "__platform_rename") == 1 {
    check_intrinsic_i64_args(node, 2, env, ft, src, tt)
  } else { if src_eq(src, ns, nl, "__platform_io_error") == 1 {
    check_intrinsic_i64_args(node, 1, env, ft, src, tt)
  } else { if src_eq(src, ns, nl, "__platform_map_rw_anonymous") == 1 {
    check_intrinsic_i64_args(node, 2, env, ft, src, tt)
  } else { if src_eq(src, ns, nl, "__platform_remap_rw_anonymous_fixed") == 1 {
    check_intrinsic_i64_args(node, 2, env, ft, src, tt)
  } else { if src_eq(src, ns, nl, "__platform_unmap") == 1 {
    check_intrinsic_i64_args(node, 2, env, ft, src, tt)
  } else { if src_eq(src, ns, nl, "__platform_write") == 1 {
    check_intrinsic_i64_args(node, 3, env, ft, src, tt)
  } else { if src_eq(src, ns, nl, "__platform_exit") == 1 {
    check_intrinsic_i64_args(node, 1, env, ft, src, tt)
  } else { if src_eq(src, ns, nl, "__platform_native_host_target") == 1 {
    check_intrinsic_i64_args(node, 0, env, ft, src, tt)
  } else { if src_eq(src, ns, nl, "__platform_terminal_is_tty") == 1 {
    check_intrinsic_i64_args(node, 2, env, ft, src, tt)
  } else { if src_eq(src, ns, nl, "__platform_file_chmod") == 1 {
    check_intrinsic_i64_args(node, 2, env, ft, src, tt)
  } else { if src_eq(src, ns, nl, "__atomic_lock64") == 1 {
    check_intrinsic_one_arg_type(node, env, ft, src, tt, ty_i64())
  } else { if src_eq(src, ns, nl, "__atomic_unlock64") == 1 {
    check_intrinsic_one_arg_type(node, env, ft, src, tt, ty_i64())
  } else { 0 } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } }
}

pub(package) fn effect_hash_unsafe() -> i64 {
  effect_name_hash(__str_ptr("Unsafe"), 0, 6)
}

pub(package) fn effect_hash_alloc() -> i64 {
  effect_name_hash(__str_ptr("Alloc"), 0, 5)
}

pub(package) fn intrinsic_alloc_effect_call_name(src: i64, ns: i64, nl: i64) -> i64 {
  if src_eq(src, ns, nl, "__bump_alloc") == 1 { true }
  else { src_eq(src, ns, nl, "alloc_bump") == 1 }
}

