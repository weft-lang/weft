  else { if src_eq(src, ns, nl, "__atomic_lock64") == 1 { true }
  else { if src_eq(src, ns, nl, "__atomic_unlock64") == 1 { true }
  else { src_eq(src, ns, nl, "__frame_pointer") == 1 } } } }
  } } } } }
}

pub(package) fn intrinsic_safe_memory_effect_call_name(src: i64, ns: i64, nl: i64) -> i64 {
  if src_eq(src, ns, nl, "vector_get") == 1 { true }
