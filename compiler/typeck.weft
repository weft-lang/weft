  } else {
    check_arg_against_param(nlist_get(node_f3(node), 0), ty_f64(), env, ft, src, tt, node_f1(node))
  }
}

pub(package) fn check_intrinsic_one_arg_type(node: i64, env: i64, ft: i64, src: i64, tt: i64, param_ty: i64) -[Conformance, Diagnose]> i64 {
  let nargs = node_f4(node)
  if nargs != 1 {
    typeck_error_maybe(src, node_f1(node), "type error: arity mismatch")
    1
  } else {
    check_arg_against_param(nlist_get(node_f3(node), 0), param_ty, env, ft, src, tt, node_f1(node))
  }
}

pub(package) fn check_intrinsic_one_arg_any(node: i64, src: i64) -[Diagnose]> i64 {
  let nargs = node_f4(node)
  if nargs != 1 {
    typeck_error_maybe(src, node_f1(node), "type error: arity mismatch")
    1
  } else { 0 }
}

pub(package) fn check_intrinsic_raw_offset_args(node: i64, env: i64, ft: i64, src: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let nargs = node_f4(node)
  if nargs != 2 {
    typeck_error_maybe(src, node_f1(node), "type error: arity mismatch")
    1
  } else {
    let ptr_arg = nlist_get(node_f3(node), 0)
    let off_arg = nlist_get(node_f3(node), 1)
    let ptr_ty = synth(ptr_arg, env, ft, src, tt)
    let mut errors = if type_is_unknown_or_any(ptr_ty) { 0 }
    else { if ty_is_ptr(ptr_ty) == 1 { 0 }
    else {
      typeck_report_expr_type_mismatch(src, ptr_arg, ty_ptr(ty_any()), ptr_ty, "argument", typeck_source_location(src, node_f1(node), node_f2(node)), tt)
      1
    } }
    errors = errors + check_arg_against_param(off_arg, ty_i64(), env, ft, src, tt, node_f1(node))
    errors
  }
}

pub(package) fn check_intrinsic_mem_load_sized_args(node: i64, env: i64, ft: i64, src: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let nargs = node_f4(node)
  if nargs != 3 {
    typeck_error_maybe(src, node_f1(node), "type error: arity mismatch")
    1
  } else {
    let args = node_f3(node)
    check_arg_against_param(nlist_get(args, 0), ty_i64(), env, ft, src, tt, node_f1(node)) +
    check_arg_against_param(nlist_get(args, 1), ty_i64(), env, ft, src, tt, node_f1(node)) +
    check_arg_against_param(nlist_get(args, 2), ty_i64(), env, ft, src, tt, node_f1(node))
  }
}

pub(package) fn check_intrinsic_mem_store_sized_args(node: i64, env: i64, ft: i64, src: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let nargs = node_f4(node)
  if nargs != 4 {
    typeck_error_maybe(src, node_f1(node), "type error: arity mismatch")
    1
  } else {
    let args = node_f3(node)
    check_arg_against_param(nlist_get(args, 0), ty_i64(), env, ft, src, tt, node_f1(node)) +
    check_arg_against_param(nlist_get(args, 1), ty_i64(), env, ft, src, tt, node_f1(node)) +
    check_arg_against_param(nlist_get(args, 2), ty_i64(), env, ft, src, tt, node_f1(node))
  }
}

pub(package) fn check_intrinsic_i64_args(node: i64, expected: i64, env: i64, ft: i64, src: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  if node_f4(node) != expected {
    typeck_error_maybe(src, node_f1(node), "type error: arity mismatch")
    1
  } else {
    let args = node_f3(node)
    let mut errors = 0
    for index in 0..expected {
      errors = errors + check_arg_against_param(nlist_get(args, index), ty_i64(), env, ft, src, tt, node_f1(node))
    }
    errors
  }
}

pub(package) fn intrinsic_platform_directory_arity(src: i64, ns: i64, nl: i64) -> i64 {
  if src_eq(src, ns, nl, "__platform_dir_open") == 1 { 1 }
  else { if src_eq(src, ns, nl, "__platform_dir_read") == 1 { 4 }
  else { if src_eq(src, ns, nl, "__platform_dir_entry_record_len") == 1 { 1 }
  else { if src_eq(src, ns, nl, "__platform_dir_entry_name") == 1 { 1 }
  else { if src_eq(src, ns, nl, "__platform_dir_entry_is_directory") == 1 { 1 }
  else { if src_eq(src, ns, nl, "__platform_stat_follow") == 1 { 2 }
  else { if src_eq(src, ns, nl, "__platform_stat_nofollow") == 1 { 2 }
  else { if src_eq(src, ns, nl, "__platform_dir_mkdir") == 1 { 2 }
  else { if src_eq(src, ns, nl, "__platform_dir_getcwd") == 1 { 2 }
  else { if src_eq(src, ns, nl, "__platform_dir_remove_directory") == 1 { 1 }
  else { if src_eq(src, ns, nl, "__platform_dir_current") == 1 { 3 }
  else { 0 - 1 } } } } } } } } } } } }
}

