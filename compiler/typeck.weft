fn check_region_escape_error(src: i64, pos: i64) -[Diagnose]> i64 {
  typeck_error_maybe(src, pos, "type error: region value cannot escape scoped arena")
  1
}

fn check_region_body(node: i64, names: i64, src: i64, result_pos: i64) -[Diagnose]> i64 {
  if node == 0 { 0 }
  else {
    let mut errors = 0
    if result_pos == 1 and region_expr_returns_region_value(node, names, src) == 1 {
      errors = errors + check_region_escape_error(src, expr_diag_pos(node))
    } else { errors = errors }
    match node_tag(node) {
      3 -> check_region_body(node_f2(node), names, src, 0) + check_region_body(node_f3(node), names, src, 0) + errors
      4 -> {
        let args = node_f3(node)
        let nargs = node_f4(node)
        if region_call_region_arg_escape(node, names, src) == 1 {
          errors = errors + check_region_escape_error(src, node_f1(node))
        } else { errors = errors }
        let mut i = 0
        while i < nargs {
          errors = errors + check_region_body(nlist_get(args, i), names, src, 0)
          i = i + 1
        }
        errors
      }
      5 -> check_region_body(node_f1(node), names, src, 0) + check_region_body(node_f2(node), names, src, result_pos) + check_region_body(node_f3(node), names, src, result_pos) + errors
      6 -> {
        let val = node_f3(node)
        let body = node_f4(node)
        let next_names = if region_expr_returns_region_value(val, names, src) == 1 {
          region_name_list_bind(names, node_f1(node), node_f2(node))
        } else { names }
        errors + check_region_body(val, names, src, 0) + check_region_body(body, next_names, src, result_pos)
      }
      7 -> errors + check_region_body(node_f1(node), names, src, 0) + check_region_body(node_f2(node), names, src, result_pos)
      10 -> errors + check_region_body(node_f1(node), names, src, 0) + check_region_body(node_f2(node), names, src, 0)
      11 -> {
        let val = node_f3(node)
        let body = node_f4(node)
        let next_names = if region_expr_returns_region_value(val, names, src) == 1 {
          region_name_list_bind(names, node_f1(node), node_f2(node))
        } else { names }
        errors + check_region_body(val, names, src, 0) + check_region_body(body, next_names, src, result_pos)
      }
      12 -> errors + check_region_body(node_f3(node), names, src, 0)
      13 -> errors + check_region_body(node_f1(node), names, src, 0)
      59 -> errors + check_region_body(node_f1(node), names, src, 0)
      60 -> errors + check_region_body(node_f1(node), names, src, 0) + check_region_body(node_f2(node), names, src, 0)
      61 -> errors + check_region_body(node_f1(node), names, src, 0) + check_region_body(node_f2(node), names, src, 0) + check_region_body(node_f3(node), names, src, 0)
      62 -> errors + check_region_body(node_f1(node), names, src, 0) + check_region_body(node_f2(node), names, src, 0) + check_region_body(node_f3(node), names, src, 0)
      14 -> {
        if region_record_fields_return_region(node_f3(node), node_f4(node), names, src) == 1 {
          errors = errors + check_region_escape_error(src, expr_diag_pos(node))
        } else { errors = errors }
        let fields = node_f3(node)
        let nfields = node_f4(node)
        for ri in 0..nfields {
          let field = nlist_get(fields, ri)
          errors = errors + check_region_body(node_f3(field), names, src, 0)
        }
        errors
      }
      58 -> {
        if region_arg_list_mentions_region(node_f1(node), node_f2(node), names, src) == 1 {
          errors = errors + check_region_escape_error(src, expr_diag_pos(node))
        } else { errors = errors }
        for ai in 0..node_f2(node) {
          errors = errors + check_region_body(nlist_get(node_f1(node), ai), names, src, 0)
        }
        errors
      }
      15 -> {
        errors = errors + check_region_body(node_f1(node), names, src, 0)
        let arms = node_f2(node)
        let n = node_f3(node)
        for i in 0..n {
          let arm = nlist_get(arms, i)
          errors = errors + check_region_body(node_f3(arm), names, src, 0)
          errors = errors + check_region_body(node_f2(arm), names, src, result_pos)
        }
        errors
      }
      22 -> errors + check_region_body(node_f1(node), names, src, 0)
      25 -> {
        if region_expr_returns_region_value(node_f1(node), names, src) == 1 {
          errors + check_region_escape_error(src, expr_diag_pos(node_f1(node)))
        } else { errors + check_region_body(node_f1(node), names, src, 0) }
      }
      26 -> {
        let val = node_f1(node)
        if val != 0 and region_expr_returns_region_value(val, names, src) == 1 {
          errors + check_region_escape_error(src, expr_diag_pos(val))
        } else { errors + check_region_body(val, names, src, 0) }
      }
      29 -> {
        if region_lambda_captures_region(node, names, src) == 1 {
          errors + check_region_escape_error(src, expr_diag_pos(node))
        } else { errors }
      }
      32 -> {
        if region_call_region_arg_escape(node, names, src) == 1 {
          errors = errors + check_region_escape_error(src, expr_diag_pos(node))
        } else { errors = errors }
        let args = node_f4(node)
        let nargs = nlist_len(args)
        for pai in 0..nargs {
          errors = errors + check_region_body(nlist_get(args, pai), names, src, 0)
        }
        errors + check_region_body(node_f1(node), names, src, 0)
      }
      33 -> {
        if region_deferred_handle_region_escape(node_f1(node), node_f2(node), node_f3(node), names, src) == 1 {
          errors = errors + check_region_escape_error(src, expr_diag_pos(node))
        } else { errors = errors }
        errors = errors + check_region_body(node_f1(node), names, src, result_pos)
        let clauses = node_f2(node)
        let nclauses = node_f3(node)
        for hci in 0..nclauses {
          let clause = nlist_get(clauses, hci)
          errors = errors + check_region_body(node_f3(clause), names, src, result_pos)
        }
        errors
      }
      35 -> {
        let val = node_f1(node)
        if region_expr_returns_region_value(val, names, src) == 1 {
          errors + check_region_escape_error(src, expr_diag_pos(val))
        } else { errors + check_region_body(val, names, src, 0) }
      }
      36 -> {
        let call_node = node_f2(node)
        let args = node_f3(call_node)
        let nargs = node_f4(call_node)
        if region_arg_list_mentions_region(args, nargs, names, src) == 1 {
          errors = errors + check_region_escape_error(src, node_f1(call_node))
        } else { errors = errors }
        for gi in 0..nargs {
          errors = errors + check_region_body(nlist_get(args, gi), names, src, 0)
        }
        errors
      }
      37 -> {
        let inner = node_f1(node)
        let val = node_f3(inner)
        let body = node_f4(inner)
        let next_names = if region_expr_returns_region_value(val, names, src) == 1 {
          region_name_list_bind(names, node_f1(inner), node_f2(inner))
        } else { names }
        errors + check_region_body(val, names, src, 0) + check_region_body(body, next_names, src, result_pos)
      }
      41 -> {
        let args = node_f3(node)
        let nargs = nlist_len(args)
        if region_arg_list_mentions_region(args, nargs, names, src) == 1 {
          errors = errors + check_region_escape_error(src, expr_diag_pos(node))
        } else { errors = errors }
        for mi in 0..nargs {
          errors = errors + check_region_body(nlist_get(args, mi), names, src, 0)
        }
        errors
      }
      45 -> errors + check_region_body(node_f1(node), names, src, 0)
      46 -> errors + check_region_body(node_f1(node), names, src, 0) + check_region_body(node_f2(node), names, src, 0)
      47 -> errors + check_region_body(node_f3(node), names, src, 0) + check_region_body(node_f4(node), names, src, 0)
      48 -> errors + check_region_body(node_f1(node), names, src, 0)
      49 -> errors + check_region_body(node_f1(node), names, src, 0)
      52 -> errors + check_region_body(node_f1(node), names, src, 0) + check_region_body(node_f2(node), names, src, 0)
      _ -> errors
    }
  }
}

fn check_scoped_region_helper(node: i64, src: i64) -[Diagnose]> i64 {
  let call_node = if node_tag(node) == 36 { node_f2(node) } else { node }
  if node_tag(call_node) != 4 { 0 }
  else { if region_scoped_arena_helper_name(src, node_f1(call_node), node_f2(call_node)) != 1 { 0 }
  else { if node_f4(call_node) != 2 { 0 }
  else {
    let args = node_f3(call_node)
    let lambda = nlist_get(args, 1)
    if node_tag(lambda) != 29 { 0 }
    else { if node_f3(lambda) != 0 { 0 }
    else { check_region_body(node_f2(lambda), nlist_new(), src, 1) } }
  } } }
}

fn check_call_args(node: i64, env: i64, ft: i64, src: i64, caller_eff: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let call_ns = node_f1(node)
  let call_nl = node_f2(node)
  if weak_ref_name(src, call_ns, call_nl) == 1 { check_weak_ref_args(node, env, ft, src, tt) }
  else { if weak_load_name(src, call_ns, call_nl) == 1 { check_weak_load_args(node, env, ft, src, tt) }
  else { if call_nl >= 2 {
    if mem_load8_at(src, call_ns) == 95 {
      if mem_load8_at(src, call_ns + 1) == 95 { check_intrinsic_args(node, env, ft, src, tt) }
      else { check_call_args_inner(node, env, ft, src, caller_eff, tt) }
    } else { check_call_args_inner(node, env, ft, src, caller_eff, tt) }
  } else { check_call_args_inner(node, env, ft, src, caller_eff, tt) }
  } }
}

fn check_generator_i64_producer_supported(arg: i64, env: i64, ft: i64, src: i64) -> i64 {
  match node_tag(arg) {
    29 -> if node_f3(arg) == 0 { 1 } else { 0 }
    2 -> {
      let local_ty = tenv_lookup(env, src, node_f1(arg), node_f2(arg))
      if local_ty != 0 {
        let origin = tenv_lookup_value(env, src, node_f1(arg), node_f2(arg))
        if origin == 0 { 0 }
        else { if node_tag(origin) != 29 { 0 }
        else { if node_f3(origin) != 0 { 0 }
        else { if ty_tag(local_ty) != 6 { 0 }
        else { if nlist_len(ty_f1(local_ty)) == 0 { 1 } else { 0 } } } } }
      } else {
        let params = ftypes_lookup_params(ft, src, node_f1(arg), node_f2(arg))
        if params != 0 and nlist_len(params) == 0 { 1 } else { 0 }
      }
    }
    _ -> 0
  }
}

fn check_generator_i64_new_shape(node: i64, env: i64, ft: i64, src: i64) -[Diagnose]> i64 {
  if src_eq(src, node_f1(node), node_f2(node), "generator_i64_new") != 1 { 0 }
  else { if node_f4(node) != 1 { 0 }
  else {
    let arg = nlist_get(node_f3(node), 0)
    if check_generator_i64_producer_supported(arg, env, ft, src) == 1 { 0 }
    else {
      typeck_error(src, node_f1(node), "type error: generator producer must be literal zero-arg lambda, known zero-arg function, or known zero-arg closure")
      1
    }
  } }
}

fn check_generator_new_shape(node: i64, env: i64, ft: i64, src: i64) -[Diagnose]> i64 {
  if node_tag(node) != 36 { 0 }
  else {
    let call_node = node_f2(node)
    if src_eq(src, node_f1(call_node), node_f2(call_node), "generator_new") != 1 { 0 }
    else { if node_f4(call_node) != 1 { 0 }
    else { if nlist_len(node_f1(node)) != 2 { 0 }
    else {
      let arg = nlist_get(node_f3(call_node), 0)
      if check_generator_i64_producer_supported(arg, env, ft, src) == 1 { 0 }
      else {
        typeck_error(src, node_f1(call_node), "type error: generator producer must be literal zero-arg lambda, known zero-arg function, or known zero-arg closure")
        1
      }
    } } }
  }
}

fn check_vector_to_array_type_args(src: i64, ns: i64, nl: i64, type_args: i64) -[Diagnose]> i64 {
  if src_eq(src, ns, nl, "to_array") != 1 { 0 }
  else { if type_args == 0 or nlist_len(type_args) != 2 { 0 }
  else {
    let element_ty = nlist_get(type_args, 0)
    let array_ty = nlist_get(type_args, 1)
    if not ty_is_array(array_ty) or not ty_eq(ty_array_inner(array_ty), element_ty) {
      typeck_error_maybe(src, ns, "type error: to_array result type must be [T; N]")
      1
    } else { if ty_array_length(array_ty) < 0 {
      typeck_error_maybe(src, ns, "type error: to_array length must be a non-negative integer literal")
      1
    } else { 0 } }
  } }
}

-- Everything the GenericCall (tag 36) arm checks EXCEPT recursing into
-- the argument expressions: type-arg count, trait bounds, arity,
-- substituted param checks, effect availability. Shared by the tag-36
-- check_expr arm and the bare-generic-call inference path in
-- check_call_args_inner (whose caller already recursed into the args).
fn check_generic_call_post_args(node: i64, env: i64, ft: i64, src: i64, caller_eff: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let type_args = node_f1(node)
  let call_node = node_f2(node)
  let call_args = node_f3(call_node)
  let nargs = node_f4(call_node)
  let ns = node_f1(call_node)
  let nl = node_f2(call_node)
  let mut errors = check_public_arc_type_list(tt, src, ns, type_args)
  errors = errors + check_move_only_storage_type_list(src, ns, type_args)
  errors = errors + check_internal_par_prepared_call_sealed(tt, call_node, src)
  -- Check arg types against substituted param types
  let tparams = ftypes_lookup_tparams(ft, src, ns, nl)
  let params = ftypes_lookup_params(ft, src, ns, nl)
  if tparams != 0 {
    errors = errors + check_generic_type_arg_count(tparams, type_args, src, ns)
    errors = errors + check_vector_to_array_type_args(src, ns, nl, type_args)
    errors = errors + check_generator_new_shape(node, env, ft, src)
    if params != 0 {
      errors = errors + check_arity(nlist_len(params), nargs, src, ns)
      let s = build_subst(tparams, type_args)
      -- Check trait bounds on type parameters
      errors = errors + check_trait_bounds(tparams, type_args, src, ns, tt)
      for pi in 0..nargs {
        if pi < nlist_len(params) {
          let param = nlist_get(params, pi)
          let param_ty = node_f3(param)
          if param_ty != 0 {
            let subst_ty = ty_subst(param_ty, s)
            errors = errors + check_arg_against_param(nlist_get(call_args, pi), subst_ty, env, ft, src, tt, ns)
          } else { errors = errors }
        } else { errors = errors }
      }
    } else { 0 }
  } else {
    errors = errors + check_generic_call_target_defined(call_node, env, ft, src, tt)
    errors = errors + check_call_args(call_node, env, ft, src, caller_eff, tt)
  }
  -- Effect checking for generic calls. 4c: substitute the call's type
  -- args into the callee's declared sig first, so -[Box<T>]> charges the
  -- instantiated atom (Box<str>), not Box<TypeVar>.
  let callee_eff_raw = ftypes_lookup_effects(ft, src, ns, nl)
  let callee_eff = if callee_eff_raw > 0 and tparams != 0 {
    ty_subst(callee_eff_raw, build_subst(tparams, type_args))
  } else { callee_eff_raw }
  if caller_eff > 0 {
    if callee_eff > 0 {
      if not effect_is_subset_rigid(callee_eff, caller_eff) {
        typeck_error(src, ns, "type error: effect not available in caller")
        errors = errors + 1
      } else { errors = errors }
    } else { errors = errors }
  } else { errors = errors }
  let instantiated = synth_generic_call(node, env, ft, src, tt)
  let result_ty = if node_tag(call_node) == 2 and ty_tag(instantiated) == 6 { ty_f2(instantiated) } else { instantiated }
  errors = errors + check_native_result_abi_ty(src, ns, result_ty)
  errors = errors + check_scoped_region_helper(node, src)
  errors
}

-- 1 when any declared param type mentions a type variable — the marker
-- of a generic callee reached as a bare (unparameterized) call. Cheap:
-- walks the handful of param type nodes, no table lookups.
fn params_mention_type_var(params: i64) -> i64 {
  let n = nlist_len(params)
  let mut found = 0
  for i in 0..n {
    if found == 0 and ty_mentions_type_var(node_f3(nlist_get(params, i))) == 1 { found = 1 } else { 0 }
  }
  found
}

fn ty_mentions_type_var(ty: i64) -> i64 {
  if ty == 0 { 0 }
  else {
    let tag = ty_tag(ty)
    if tag == 12 { 1 }
    else { if tag == 9 { ty_list_mentions_type_var(ty_f3(ty)) }
    else { if tag == 3 or tag == 4 {
      if ty_mentions_type_var(ty_f1(ty)) == 1 { 1 } else { ty_mentions_type_var(ty_f2(ty)) }
    }
    else { if tag == 6 {
      if ty_list_mentions_type_var(ty_f1(ty)) == 1 { 1 } else { ty_mentions_type_var(ty_f2(ty)) }
    }
    else { if tag == 7 { ty_record_fields_mention_type_var(ty_record_fields(ty)) }
    else { if tag == 5 or tag == 15 or tag == 16 or tag == 17 or tag == 18 or tag == 19 or tag == 22 or tag == 23 {
      ty_mentions_type_var(ty_f1(ty))
    }
    else { 0 } } } } } }
  }
}

fn ty_record_fields_mention_type_var(fields: i64) -> i64 {
  let mut found = 0
  if fields != 0 {
    for i in 0..nlist_len(fields) {
      if ty_mentions_type_var(ty_record_field_type(nlist_get(fields, i))) == 1 { found = 1 } else { 0 }
    }
  } else { 0 }
  found
}

fn ty_list_mentions_type_var(types: i64) -> i64 {
  if types == 0 { 0 }
  else {
    let n = nlist_len(types)
    let mut found = 0
    for i in 0..n {
      if found == 0 and ty_mentions_type_var(nlist_get(types, i)) == 1 { found = 1 } else { 0 }
    }
    found
  }
}

fn check_call_args_inner(node: i64, env: i64, ft: i64, src: i64, caller_eff: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let ns = node_f1(node)
  let nl = node_f2(node)
  let args = node_f3(node)
  let nargs = node_f4(node)
  let local_ty = tenv_lookup(env, src, ns, nl)
  if local_ty != 0 {
    if ty_tag(local_ty) == 6 { check_call_fn_type(node, local_ty, env, ft, src, caller_eff, tt) }
    else { if ty_tag(local_ty) == 14 { check_call_continuation_type(node, local_ty, env, ft, src, tt) }
    else { 0 }
    }
  } else {
    let params = ftypes_lookup_params(ft, src, ns, nl)
    if params == 0 { 0 }
  else { if params_mention_type_var(params) == 1 and node_tag(node) == 4 {
    -- Bare call to a generic callee (var-typed params betray it at zero
    -- lookup cost — an upfront tparams probe per call node cost ~5% on
    -- check_tree). Synthesis solves type args from the arguments and
    -- rewrites the node to an explicit GenericCall; args were already
    -- recursed by the tag-4 arm, so only the post-args checks run here.
    synth_call(node, env, ft, src, tt)
    if node_tag(node) == 36 {
      check_generic_call_post_args(node, env, ft, src, caller_eff, tt)
    } else {
      check_call_args_declared(node, params, env, ft, src, caller_eff, tt)
    }
  }
  else {
    check_call_args_declared(node, params, env, ft, src, caller_eff, tt)
  } }
  }
}

-- The ordinary declared-params arg check (shared by the plain path and
-- the bare-generic path when inference does not solve).
fn check_call_args_declared(node: i64, params: i64, env: i64, ft: i64, src: i64, caller_eff: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let ns = node_f1(node)
  let nl = node_f2(node)
  let args = node_f3(node)
  let nargs = node_f4(node)
  let nparams = nlist_len(params)
    let mut errors = 0
    errors = errors + check_generator_i64_new_shape(node, env, ft, src)
    errors = errors + check_arity(nparams, nargs, src, ns)
    -- Effect checking: only when caller has explicit annotation
    let callee_eff = ftypes_lookup_effects(ft, src, ns, nl)
    if caller_eff > 0 {
      if callee_eff > 0 {
        if not effect_is_subset_rigid(callee_eff, caller_eff) {
          typeck_error(src, ns, "type error: effect not available in caller")
          errors = errors + 1
        } else { errors = errors }
      } else { errors = errors }
    } else { errors = errors }
    for i in 0..nargs {
      if i < nparams {
        let param = nlist_get(params, i)
        let param_ty = node_f3(param)
        if param_ty != 0 {
          let allow_direct_continuation_i64 = continuation_call_arg_accepts_direct(ft, src, ns, nl, i)
          errors = errors + check_arg_against_param_mode(nlist_get(args, i), param_ty, env, ft, src, tt, ns, allow_direct_continuation_i64)
        } else { errors = errors }
      } else { errors = errors }
    }
    errors
}

-- Source borrow checking for non-owning slices (4e D2/D3).
--
-- The optimiser's BorrowOrigin/BorrowSummary plane proves where every lowered
-- slice came from. This source-side companion enforces the lifetime and
-- exclusivity contract while names and diagnostic positions still exist. An
-- origin is {owner name, lifetime class, mutability}: class 1 is a slice
-- parameter (caller-owned), class 2 is local storage, and class 3 is unknown.
-- Unknown origins overlap everything and may not escape.
fn slice_borrow_origin(ns: i64, nl: i64, lifetime: i64, mutable: i64) -> i64 {
  node_new(0, ns, nl, lifetime, mutable)
}

fn slice_borrow_origins_empty() -> i64 { nlist_new() }

fn slice_borrow_origins_single(ns: i64, nl: i64, lifetime: i64, mutable: i64) -> i64 {
  let result = nlist_new_capacity(1)
  nlist_add(result, slice_borrow_origin(ns, nl, lifetime, mutable))
  result
}

fn slice_borrow_origin_eq(left: i64, right: i64, src: i64) -> i64 {
  if node_f3(left) != node_f3(right) or node_f4(left) != node_f4(right) { 0 }
  else { if node_f3(left) == 3 { 1 }
  else { same_source_name(src, node_f1(left), node_f2(left), node_f1(right), node_f2(right)) } }
}

fn slice_borrow_origins_contains(origins: i64, target: i64, src: i64) -> i64 {
  let mut found = 0
  for i in 0..nlist_len(origins) {
    if slice_borrow_origin_eq(nlist_get(origins, i), target, src) == 1 { found = 1 } else { 0 }
  }
  found
}

fn slice_borrow_origins_union(left: i64, right: i64, src: i64) -> i64 {
  let result = nlist_new_capacity(nlist_len(left) + nlist_len(right))
  for i in 0..nlist_len(left) { nlist_add(result, nlist_get(left, i)) }
  for i in 0..nlist_len(right) {
    let origin = nlist_get(right, i)
    if slice_borrow_origins_contains(result, origin, src) == 0 { nlist_add(result, origin) } else { 0 }
  }
  result
}

fn slice_borrow_origins_overlap(left: i64, right: i64, src: i64) -> i64 {
  let mut found = 0
  for li in 0..nlist_len(left) {
    let l = nlist_get(left, li)
    for ri in 0..nlist_len(right) {
      let r = nlist_get(right, ri)
      if node_f3(l) == 3 or node_f3(r) == 3 {
        found = 1
      } else { if same_source_name(src, node_f1(l), node_f2(l), node_f1(r), node_f2(r)) {
        found = 1
      } else { 0 } }
    }
  }
  found
}

fn slice_borrow_origins_escape_kind(origins: i64) -> i64 {
  let mut kind = 0
  for i in 0..nlist_len(origins) {
    let lifetime = node_f3(nlist_get(origins, i))
    if lifetime == 2 { kind = 2 }
    else { if lifetime == 3 and kind == 0 { kind = 3 } else { 0 } }
  }
  kind
}

-- Binding information is {kind, view origins, contained origins, mutable}.
-- kind 1 is an owning array, 2 a slice, 3 an aggregate containing a borrow,
-- and 4 a growable Vector owner. Arrays have both their own storage origin and
-- (independently) any slice origins stored in their elements. Vector aliases
-- share origins because reallocation through any handle invalidates a view.
fn slice_borrow_info(kind: i64, origins: i64, contained: i64, mutable: i64) -> i64 {
  node_new(0, kind, origins, contained, mutable)
}

fn slice_borrow_info_kind(info: i64) -> i64 { if info == 0 { 0 } else { node_f1(info) } }
fn slice_borrow_info_origins(info: i64) -> i64 { if info == 0 { slice_borrow_origins_empty() } else { node_f2(info) } }
fn slice_borrow_info_contained(info: i64) -> i64 { if info == 0 { slice_borrow_origins_empty() } else { node_f3(info) } }
fn slice_borrow_info_mutable(info: i64) -> i64 { if info == 0 { 0 } else { node_f4(info) } }

-- A compact persistent environment keeps shadowing exact without mutating the
-- ordinary type environment. Entry layout is {name start, name len, info,
-- rest}.
fn slice_borrow_env_bind(env: i64, ns: i64, nl: i64, info: i64) -> i64 {
  node_new(0, ns, nl, info, env)
}

fn slice_borrow_env_lookup(env: i64, src: i64, ns: i64, nl: i64) -> i64 {
  if env == 0 { 0 }
  else { if same_source_name(src, ns, nl, node_f1(env), node_f2(env)) { node_f3(env) }
  else { slice_borrow_env_lookup(node_f4(env), src, ns, nl) } }
}

fn slice_borrow_type_list_contains(types: i64, tt: i64, depth: i64) -> i64 {
  if types == 0 { 0 }
  else {
    let mut found = 0
    for i in 0..nlist_len(types) {
      if slice_borrow_type_contains(nlist_get(types, i), tt, depth) == 1 { found = 1 } else { 0 }
    }
    found
  }
}

fn slice_borrow_named_type_contains(ty: i64, tt: i64, depth: i64) -> i64 {
  if depth >= 8 { 1 }
  else {
    let entry = ttable_lookup_by_type_hash(tt, ty_f1(ty))
    if entry == 0 { 0 }
    else {
      let kind = mem_load64_at(entry, 16)
      let mut found = 0
      if kind == 0 {
        let fields = mem_load64_at(entry, 32)
        let count = mem_load64_at(entry, 24)
        let subst = type_cycle_subst_for_entry(entry, ty_f3(ty))
        for i in 0..count {
          let raw_ty = mem_load64_at(fields, i * 24 + 16)
          let field_ty = type_cycle_maybe_subst(raw_ty, subst)
          if slice_borrow_type_contains(field_ty, tt, depth + 1) == 1 { found = 1 } else { 0 }
        }
      } else { if kind == 1 {
        let variants = mem_load64_at(entry, 32)
        let count = mem_load64_at(entry, 24)
        let subst = type_cycle_subst_for_entry(entry, ty_f3(ty))
        for vi in 0..count {
          let npayloads = mem_load64_at(variants, vi * 40 + 24)
          let payloads = mem_load64_at(variants, vi * 40 + 32)
          for pi in 0..npayloads {
            let payload_ty = type_cycle_maybe_subst(nlist_get(payloads, pi), subst)
            if slice_borrow_type_contains(payload_ty, tt, depth + 1) == 1 { found = 1 } else { 0 }
          }
        }
      } else { 0 } }
      found
    }
  }
}

fn slice_borrow_type_contains(ty: i64, tt: i64, depth: i64) -> i64 {
  if ty == 0 { 0 }
  else {
    match ty_tag(ty) {
      3 -> if slice_borrow_type_contains(ty_f1(ty), tt, depth) == 1 or slice_borrow_type_contains(ty_f2(ty), tt, depth) == 1 { 1 } else { 0 }
      4 -> if slice_borrow_type_contains(ty_f1(ty), tt, depth) == 1 or slice_borrow_type_contains(ty_f2(ty), tt, depth) == 1 { 1 } else { 0 }
      5 -> slice_borrow_type_contains(ty_f1(ty), tt, depth)
      7 -> slice_borrow_record_fields_contain(ty_record_fields(ty), tt, depth)
      8 -> slice_borrow_type_contains(ty_f2(ty), tt, depth)
      9 -> slice_borrow_named_type_contains(ty, tt, depth)
      11 -> slice_borrow_type_list_contains(ty_f2(ty), tt, depth)
      14 -> if slice_borrow_type_contains(ty_f1(ty), tt, depth) == 1 or slice_borrow_type_contains(ty_f2(ty), tt, depth) == 1 { 1 } else { 0 }
      15 -> slice_borrow_type_contains(ty_f1(ty), tt, depth)
      16 -> slice_borrow_type_contains(ty_f1(ty), tt, depth)
      17 -> slice_borrow_type_contains(ty_f1(ty), tt, depth)
      18 -> slice_borrow_type_contains(ty_f1(ty), tt, depth)
      19 -> slice_borrow_type_contains(ty_f1(ty), tt, depth)
      22 -> slice_borrow_type_contains(ty_array_inner(ty), tt, depth)
      23 -> 1
      _ -> 0
    }
  }
}

fn slice_borrow_record_fields_contain(fields: i64, tt: i64, depth: i64) -> i64 {
  let mut found = 0
  if fields != 0 {
    for i in 0..nlist_len(fields) {
      if slice_borrow_type_contains(ty_record_field_type(nlist_get(fields, i)), tt, depth) == 1 { found = 1 } else { 0 }
    }
  } else { 0 }
  found
}

fn slice_borrow_unknown_origins(mutable: i64) -> i64 {
  slice_borrow_origins_single(0, 0, 3, mutable)
}

fn slice_borrow_call_arg_origins(args: i64, nargs: i64, env: i64, tenv: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let mut result = slice_borrow_origins_empty()
  for i in 0..nargs {
    let arg = nlist_get(args, i)
    let arg_ty = synth(arg, tenv, ft, src, tt)
    if ty_is_slice(arg_ty) {
      result = slice_borrow_origins_union(result, slice_borrow_expr_view_origins(arg, env, tenv, ft, src, tt), src)
    } else { if ty_is_array(arg_ty) or typeck_type_is_vector(tt, arg_ty) == 1 {
      result = slice_borrow_origins_union(result, slice_borrow_info_origins(slice_borrow_info_for_expr(arg, env, tenv, ft, src, tt)), src)
    } else { 0 } }
  }
  result
}

fn slice_borrow_lambda_capture_origins(lambda: i64, env: i64, src: i64) -> i64 {
  let params = node_f1(lambda)
  let body = node_f2(lambda)
  let mut result = slice_borrow_origins_empty()
  let mut current = env
  while current != 0 {
    if unique_params_bind_name(params, node_f3(lambda), src, src, node_f1(current), node_f2(current)) == 0 and unique_ref_count_name(body, src, src, node_f1(current), node_f2(current)) > 0 {
      let info = node_f3(current)
      let incoming = if slice_borrow_info_kind(info) == 2 { slice_borrow_info_origins(info) } else { slice_borrow_info_contained(info) }
      result = slice_borrow_origins_union(result, incoming, src)
    } else { 0 }
    current = node_f4(current)
  }
  result
}

fn slice_borrow_record_origins(fields: i64, nfields: i64, env: i64, tenv: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let mut result = slice_borrow_origins_empty()
  for i in 0..nfields {
    let value = node_f3(nlist_get(fields, i))
    result = slice_borrow_origins_union(result, slice_borrow_expr_escape_origins(value, env, tenv, ft, src, tt), src)
  }
  result
}

fn slice_borrow_array_origins(items: i64, count: i64, env: i64, tenv: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let mut result = slice_borrow_origins_empty()
  for i in 0..count {
    result = slice_borrow_origins_union(result, slice_borrow_expr_escape_origins(nlist_get(items, i), env, tenv, ft, src, tt), src)
  }
  result
}

fn slice_borrow_expr_view_origins(node: i64, env: i64, tenv: i64, ft: i64, src: i64, tt: i64) -> i64 {
  if node == 0 { slice_borrow_origins_empty() }
  else {
    match node_tag(node) {
      2 -> slice_borrow_info_origins(slice_borrow_env_lookup(env, src, node_f1(node), node_f2(node)))
      4 -> {
        let local_callee_ty = tenv_lookup(tenv, src, node_f1(node), node_f2(node))
        if local_callee_ty != 0 and ty_tag(local_callee_ty) == 6 {
          let origin = tenv_lookup_value(tenv, src, node_f1(node), node_f2(node))
          if origin != 0 and node_tag(origin) == 29 {
            -- A literal local lambda has a sufficient summary: its result can
            -- only originate in its slice arguments or explicit captures.
            let from_args = slice_borrow_call_arg_origins(node_f3(node), node_f4(node), env, tenv, ft, src, tt)
            let from_captures = slice_borrow_lambda_capture_origins(origin, env, src)
            let result = slice_borrow_origins_union(from_args, from_captures, src)
            if nlist_len(result) == 0 { slice_borrow_unknown_origins(ty_slice_mutable(synth(node, tenv, ft, src, tt))) } else { result }
          } else {
            -- A parameter/opaque function value has no stable BorrowSummary
            -- contract, so its result cannot be guessed from its arguments.
            slice_borrow_unknown_origins(ty_slice_mutable(synth(node, tenv, ft, src, tt)))
          }
        } else {
          let result = slice_borrow_call_arg_origins(node_f3(node), node_f4(node), env, tenv, ft, src, tt)
          if nlist_len(result) == 0 { slice_borrow_unknown_origins(ty_slice_mutable(synth(node, tenv, ft, src, tt))) } else { result }
        }
      }
      5 -> slice_borrow_origins_union(
        slice_borrow_expr_view_origins(node_f2(node), env, tenv, ft, src, tt),
        slice_borrow_expr_view_origins(node_f3(node), env, tenv, ft, src, tt), src)
      6 -> {
        let value = node_f3(node)
        let info = slice_borrow_info_for_binding(value, node_f1(node), node_f2(node), env, tenv, ft, src, tt)
        let next_env = if info == 0 { env } else { slice_borrow_env_bind(env, node_f1(node), node_f2(node), info) }
        let value_ty = synth(value, tenv, ft, src, tt)
        let next_tenv = if node_tag(value) == 29 { tenv_bind_value(tenv, src, node_f1(node), node_f2(node), value_ty, value) } else { tenv_bind(tenv, src, node_f1(node), node_f2(node), value_ty) }
        slice_borrow_expr_view_origins(node_f4(node), next_env, next_tenv, ft, src, tt)
      }
      7 -> slice_borrow_expr_view_origins(node_f2(node), env, tenv, ft, src, tt)
      11 -> {
        let value = node_f3(node)
        let info = slice_borrow_info_for_binding(value, node_f1(node), node_f2(node), env, tenv, ft, src, tt)
        let next_env = if info == 0 { env } else { slice_borrow_env_bind(env, node_f1(node), node_f2(node), info) }
        let next_tenv = tenv_bind_mut(tenv, src, node_f1(node), node_f2(node), synth(value, tenv, ft, src, tt))
        slice_borrow_expr_view_origins(node_f4(node), next_env, next_tenv, ft, src, tt)
      }
      13 -> slice_borrow_info_contained(slice_borrow_info_for_expr(node_f1(node), env, tenv, ft, src, tt))
      15 -> {
        let arms = node_f2(node)
        let mut result = slice_borrow_origins_empty()
        for i in 0..node_f3(node) {
          result = slice_borrow_origins_union(result, slice_borrow_expr_view_origins(node_f2(nlist_get(arms, i)), env, tenv, ft, src, tt), src)
        }
        result
      }
      25 -> slice_borrow_expr_view_origins(node_f1(node), env, tenv, ft, src, tt)
      32 -> slice_borrow_unknown_origins(ty_slice_mutable(synth(node, tenv, ft, src, tt)))
      33 -> {
        let ret = node_f4(node)
        if ret == 0 { slice_borrow_expr_view_origins(node_f1(node), env, tenv, ft, src, tt) }
        else { slice_borrow_expr_view_origins(node_f3(ret), env, tenv, ft, src, tt) }
      }
      35 -> slice_borrow_expr_view_origins(node_f1(node), env, tenv, ft, src, tt)
      36 -> {
        -- The inner Call is representation, not an independent bare call.
        -- Synthesising it would run generic inference a second time and
        -- rewrite GenericCall(type_args, Call) into a nested GenericCall.
        let call_node = node_f2(node)
        let result = slice_borrow_call_arg_origins(node_f3(call_node), node_f4(call_node), env, tenv, ft, src, tt)
        if nlist_len(result) == 0 { slice_borrow_unknown_origins(ty_slice_mutable(synth(node, tenv, ft, src, tt))) } else { result }
      }
      37 -> slice_borrow_expr_view_origins(node_f1(node), env, tenv, ft, src, tt)
      41 -> {
        let args = node_f3(node)
        let from_args = slice_borrow_call_arg_origins(args, nlist_len(args), env, tenv, ft, src, tt)
        let recv_ty = synth(node_f1(node), tenv, ft, src, tt)
        let result = if ty_is_slice(recv_ty) {
          slice_borrow_origins_union(slice_borrow_expr_view_origins(node_f1(node), env, tenv, ft, src, tt), from_args, src)
        } else { from_args }
        if nlist_len(result) == 0 { slice_borrow_unknown_origins(ty_slice_mutable(synth(node, tenv, ft, src, tt))) } else { result }
      }
      52 -> slice_borrow_expr_view_origins(node_f2(node), env, tenv, ft, src, tt)
      60 -> {
        let fact_ty = node_f3(node)
        if ty_is_slice(fact_ty) {
          let contained = slice_borrow_info_contained(slice_borrow_info_for_expr(node_f1(node), env, tenv, ft, src, tt))
          if nlist_len(contained) == 0 { slice_borrow_unknown_origins(ty_slice_mutable(fact_ty)) } else { contained }
        } else { slice_borrow_origins_empty() }
      }
      62 -> {
        let origins = slice_borrow_expr_view_origins(node_f1(node), env, tenv, ft, src, tt)
        if nlist_len(origins) == 0 {
          let fact = node_f4(node)
          slice_borrow_unknown_origins(if fact == 0 { 0 } else { node_f4(fact) })
        } else { origins }
      }
      _ -> {
        let ty = synth(node, tenv, ft, src, tt)
        if ty_is_slice(ty) { slice_borrow_unknown_origins(ty_slice_mutable(ty)) }
        else { slice_borrow_origins_empty() }
      }
    }
  }
}

fn slice_borrow_expr_contained_origins(node: i64, env: i64, tenv: i64, ft: i64, src: i64, tt: i64) -> i64 {
  if node == 0 { slice_borrow_origins_empty() }
  else {
    match node_tag(node) {
      2 -> slice_borrow_info_contained(slice_borrow_env_lookup(env, src, node_f1(node), node_f2(node)))
      5 -> slice_borrow_origins_union(
        slice_borrow_expr_contained_origins(node_f2(node), env, tenv, ft, src, tt),
        slice_borrow_expr_contained_origins(node_f3(node), env, tenv, ft, src, tt), src)
      6 -> {
        let value = node_f3(node)
        let info = slice_borrow_info_for_binding(value, node_f1(node), node_f2(node), env, tenv, ft, src, tt)
        let next_env = if info == 0 { env } else { slice_borrow_env_bind(env, node_f1(node), node_f2(node), info) }
        let value_ty = synth(value, tenv, ft, src, tt)
        let next_tenv = if node_tag(value) == 29 { tenv_bind_value(tenv, src, node_f1(node), node_f2(node), value_ty, value) } else { tenv_bind(tenv, src, node_f1(node), node_f2(node), value_ty) }
        slice_borrow_expr_contained_origins(node_f4(node), next_env, next_tenv, ft, src, tt)
      }
      7 -> slice_borrow_expr_contained_origins(node_f2(node), env, tenv, ft, src, tt)
      11 -> {
        let value = node_f3(node)
        let info = slice_borrow_info_for_binding(value, node_f1(node), node_f2(node), env, tenv, ft, src, tt)
        let next_env = if info == 0 { env } else { slice_borrow_env_bind(env, node_f1(node), node_f2(node), info) }
        let next_tenv = tenv_bind_mut(tenv, src, node_f1(node), node_f2(node), synth(value, tenv, ft, src, tt))
        slice_borrow_expr_contained_origins(node_f4(node), next_env, next_tenv, ft, src, tt)
      }
      14 -> slice_borrow_record_origins(node_f3(node), node_f4(node), env, tenv, ft, src, tt)
      15 -> {
        let arms = node_f2(node)
        let mut result = slice_borrow_origins_empty()
        for i in 0..node_f3(node) {
          result = slice_borrow_origins_union(result, slice_borrow_expr_contained_origins(node_f2(nlist_get(arms, i)), env, tenv, ft, src, tt), src)
        }
        result
      }
      25 -> slice_borrow_expr_contained_origins(node_f1(node), env, tenv, ft, src, tt)
      36 -> {
        let ty = synth(node, tenv, ft, src, tt)
        if slice_borrow_type_contains(ty, tt, 0) == 1 and ty_is_slice(ty) == 0 { slice_borrow_unknown_origins(0) }
        else { slice_borrow_origins_empty() }
      }
      37 -> slice_borrow_expr_contained_origins(node_f1(node), env, tenv, ft, src, tt)
      52 -> slice_borrow_expr_contained_origins(node_f2(node), env, tenv, ft, src, tt)
      58 -> slice_borrow_array_origins(node_f1(node), node_f2(node), env, tenv, ft, src, tt)
      _ -> {
        let ty = synth(node, tenv, ft, src, tt)
        if slice_borrow_type_contains(ty, tt, 0) == 1 and ty_is_slice(ty) == 0 {
          slice_borrow_unknown_origins(0)
        } else { slice_borrow_origins_empty() }
      }
    }
  }
}

fn slice_borrow_expr_escape_origins(node: i64, env: i64, tenv: i64, ft: i64, src: i64, tt: i64) -> i64 {
  if node == 0 { slice_borrow_origins_empty() }
  else {
    let ty = synth(node, tenv, ft, src, tt)
    if ty_is_slice(ty) { slice_borrow_expr_view_origins(node, env, tenv, ft, src, tt) }
    else { slice_borrow_expr_contained_origins(node, env, tenv, ft, src, tt) }
  }
}

fn slice_borrow_info_for_expr(node: i64, env: i64, tenv: i64, ft: i64, src: i64, tt: i64) -> i64 {
  if node == 0 { 0 }
  else {
    let ty = synth(node, tenv, ft, src, tt)
    if ty_is_array(ty) {
      let info = if node_tag(node) == 2 { slice_borrow_env_lookup(env, src, node_f1(node), node_f2(node)) } else { 0 }
      if info != 0 { info }
      else { slice_borrow_info(1, slice_borrow_unknown_origins(0), slice_borrow_expr_contained_origins(node, env, tenv, ft, src, tt), 0) }
    } else { if ty_is_slice(ty) {
      slice_borrow_info(2, slice_borrow_expr_view_origins(node, env, tenv, ft, src, tt), slice_borrow_origins_empty(), ty_slice_mutable(ty))
    } else { if typeck_type_is_vector(tt, ty) == 1 {
      let info = if node_tag(node) == 2 { slice_borrow_env_lookup(env, src, node_f1(node), node_f2(node)) } else { 0 }
      if info != 0 { info }
      else { slice_borrow_info(4, slice_borrow_unknown_origins(0), slice_borrow_origins_empty(), 0) }
    } else {
      let contained = slice_borrow_expr_contained_origins(node, env, tenv, ft, src, tt)
      if nlist_len(contained) == 0 { 0 } else { slice_borrow_info(3, slice_borrow_origins_empty(), contained, 0) }
    } } }
  }
}

fn slice_borrow_expr_is_fresh_vector(node: i64, src: i64) -> i64 {
  let call = if node_tag(node) == 36 { node_f2(node) } else { node }
  if call == 0 or node_tag(call) != 4 { 0 }
  else {
    let ns = node_f1(call)
    let nl = node_f2(call)
    if src_eq(src, ns, nl, "vector_new") == 1 { 1 }
    else { if src_eq(src, ns, nl, "vector_with_capacity") == 1 { 1 }
    else { if src_eq(src, ns, nl, "vector_map") == 1 { 1 }
    else { if src_eq(src, ns, nl, "vector_slice") == 1 { 1 }
    else { if src_eq(src, ns, nl, "vector_concat") == 1 { 1 }
    else { if src_eq(src, ns, nl, "vector_filter") == 1 { 1 }
    else { if src_eq(src, ns, nl, "vector_dedup_by") == 1 { 1 }
    else { if src_eq(src, ns, nl, "vector_dedup") == 1 { 1 }
    else { if src_eq(src, ns, nl, "vector_from_range") == 1 { 1 } else { 0 } }
    } } } } } } } }
  }
}

fn slice_borrow_info_for_binding(node: i64, ns: i64, nl: i64, env: i64, tenv: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let ty = synth(node, tenv, ft, src, tt)
  if ty_is_array(ty) {
    slice_borrow_info(1, slice_borrow_origins_single(ns, nl, 2, 0), slice_borrow_expr_contained_origins(node, env, tenv, ft, src, tt), 0)
  } else { if ty_is_slice(ty) {
    slice_borrow_info(2, slice_borrow_expr_view_origins(node, env, tenv, ft, src, tt), slice_borrow_origins_empty(), ty_slice_mutable(ty))
  } else { if typeck_type_is_vector(tt, ty) == 1 {
    let existing = if node_tag(node) == 2 { slice_borrow_env_lookup(env, src, node_f1(node), node_f2(node)) } else { 0 }
    if existing != 0 { existing }
    else { if slice_borrow_expr_is_fresh_vector(node, src) == 1 {
      slice_borrow_info(4, slice_borrow_origins_single(ns, nl, 2, 0), slice_borrow_origins_empty(), 0)
    } else { slice_borrow_info(4, slice_borrow_unknown_origins(0), slice_borrow_origins_empty(), 0) } }
  } else {
    let contained = slice_borrow_expr_contained_origins(node, env, tenv, ft, src, tt)
    if nlist_len(contained) == 0 { 0 } else { slice_borrow_info(3, slice_borrow_origins_empty(), contained, 0) }
  } } }
}

fn slice_borrow_env_bind_param_list(params: i64, nparams: i64, env: i64, src: i64, tt: i64) -> i64 {
  let mut result = env
  for i in 0..nparams {
    let param = nlist_get(params, i)
    let ns = node_f1(param)
    let nl = node_f2(param)
    let ty = node_f3(param)
    if ty_is_slice(ty) {
      result = slice_borrow_env_bind(result, ns, nl, slice_borrow_info(2, slice_borrow_origins_single(ns, nl, 1, ty_slice_mutable(ty)), slice_borrow_origins_empty(), ty_slice_mutable(ty)))
    } else { if ty_is_array(ty) {
      let contained = if slice_borrow_type_contains(ty_array_inner(ty), tt, 0) == 1 { slice_borrow_unknown_origins(0) } else { slice_borrow_origins_empty() }
      result = slice_borrow_env_bind(result, ns, nl, slice_borrow_info(1, slice_borrow_origins_single(ns, nl, 1, 0), contained, 0))
    } else { if typeck_type_is_vector(tt, ty) == 1 {
      result = slice_borrow_env_bind(result, ns, nl, slice_borrow_info(4, slice_borrow_origins_single(ns, nl, 1, 0), slice_borrow_origins_empty(), 0))
    } else { if slice_borrow_type_contains(ty, tt, 0) == 1 {
      result = slice_borrow_env_bind(result, ns, nl, slice_borrow_info(3, slice_borrow_origins_empty(), slice_borrow_unknown_origins(0), 0))
    } else { 0 } } } }
  }
  result
}

fn slice_borrow_tenv_bind_param_list(params: i64, nparams: i64, env: i64, src: i64) -> i64 {
  let mut result = env
  for i in 0..nparams {
    let param = nlist_get(params, i)
    let param_ty = node_f3(param)
    result = tenv_bind(result, src, node_f1(param), node_f2(param), if param_ty == 0 { ty_any() } else { param_ty })
  }
  result
}

-- Active borrow entry is {borrower name, origins, mutable}; the surrounding
-- link keeps the four-field raw node layout available.
fn slice_borrow_active_push(active: i64, ns: i64, nl: i64, origins: i64, mutable: i64, parent: i64) -> i64 {
  let parent_ns = if parent != 0 and node_tag(parent) == 2 { node_f1(parent) } else { 0 }
  let parent_nl = if parent != 0 and node_tag(parent) == 2 { node_f2(parent) } else { 0 }
  node_new(0, node_new(0, ns, nl, origins, mutable), active, parent_ns, parent_nl)
}

fn slice_borrow_active_entry_live(entry: i64, context: i64, src: i64) -> i64 {
  if context == 0 { 0 }
  else { if unique_ref_count_name(context, src, src, node_f1(entry), node_f2(entry)) > 0 { 1 } else { 0 } }
}

fn slice_borrow_name_is(src: i64, node: i64, ns: i64, nl: i64) -> i64 {
  if node == 0 or node_tag(node) != 2 { 0 }
  else { if same_source_name(src, node_f1(node), node_f2(node), ns, nl) { 1 } else { 0 } }
}

fn slice_borrow_new_conflicts(origins: i64, mutable: i64, allowed_source: i64, active: i64, context: i64, src: i64) -> i64 {
  let mut current = active
  let mut conflict = 0
  while current != 0 {
    let entry = node_f1(current)
    if slice_borrow_active_entry_live(entry, context, src) == 1 and slice_borrow_origins_overlap(origins, node_f3(entry), src) == 1 {
      let allowed = if allowed_source == 0 { 0 } else { slice_borrow_name_is(src, allowed_source, node_f1(entry), node_f2(entry)) }
      if allowed == 0 and (mutable == 1 or node_f4(entry) == 1) { conflict = 1 } else { 0 }
    } else { 0 }
    current = node_f2(current)
  }
  conflict
}

fn slice_borrow_check_new(node: i64, allowed_source: i64, active: i64, context: i64, env: i64, tenv: i64, ft: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  let ty = synth(node, tenv, ft, src, tt)
  if ty_is_slice(ty) == 0 { 0 }
  else {
    let origins = slice_borrow_expr_view_origins(node, env, tenv, ft, src, tt)
    if slice_borrow_new_conflicts(origins, ty_slice_mutable(ty), allowed_source, active, context, src) == 1 {
      typeck_error_maybe(src, expr_diag_pos(node), "type error: slice borrow conflicts with a live exclusive borrow")
      1
    } else { 0 }
  }
}

fn slice_borrow_check_access(base: i64, write: i64, active: i64, context: i64, env: i64, src: i64) -[Diagnose]> i64 {
  if base == 0 or node_tag(base) != 2 { 0 }
  else {
    let info = slice_borrow_env_lookup(env, src, node_f1(base), node_f2(base))
    let kind = slice_borrow_info_kind(info)
    if kind != 1 and kind != 2 and kind != 4 { 0 }
    else {
      let origins = slice_borrow_info_origins(info)
      let base_mutable_slice = if kind == 2 { slice_borrow_info_mutable(info) } else { 0 }
      -- A live reborrow freezes its parent, but the child itself must still be
      -- usable. Remember the direct parent on the active-link node so access
      -- through the child can ignore precisely that one capability.
      let mut parent_ns = 0
      let mut parent_nl = 0
      let mut parent_scan = active
      while parent_scan != 0 {
        let own = node_f1(parent_scan)
        if same_source_name(src, node_f1(base), node_f2(base), node_f1(own), node_f2(own)) {
          parent_ns = node_f3(parent_scan)
          parent_nl = node_f4(parent_scan)
        } else { 0 }
        parent_scan = node_f2(parent_scan)
      }
      let mut current = active
      let mut conflict = 0
      while current != 0 {
        let entry = node_f1(current)
        let same_borrower = if same_source_name(src, node_f1(base), node_f2(base), node_f1(entry), node_f2(entry)) { 1 } else { 0 }
        let is_parent = if parent_nl > 0 and same_source_name(src, parent_ns, parent_nl, node_f1(entry), node_f2(entry)) { 1 } else { 0 }
        if same_borrower == 0 and is_parent == 0 and slice_borrow_active_entry_live(entry, context, src) == 1 and slice_borrow_origins_overlap(origins, node_f3(entry), src) == 1 {
          if write == 1 or base_mutable_slice == 1 or node_f4(entry) == 1 { conflict = 1 } else { 0 }
        } else { 0 }
        current = node_f2(current)
      }
      if conflict == 1 {
        typeck_error_maybe(src, expr_diag_pos(base), if write == 1 { "type error: mutation conflicts with a live slice borrow" } else { "type error: access conflicts with a live mutable slice borrow" })
        1
      } else { 0 }
    }
  }
}

-- Vector's current handle API has interior mutation rather than a public
-- `mut` receiver type. While a zero-copy view is live, calls are therefore
-- conservative by default; only the canonical read-only operations may
-- observe the owner. Unknown wrappers remain potentially reallocating.
fn slice_borrow_vector_call_is_read_only(src: i64, ns: i64, nl: i64) -> i64 {
  if src_eq(src, ns, nl, "vector_len") == 1 { 1 }
  else { if src_eq(src, ns, nl, "vector_capacity") == 1 { 1 }
  else { if src_eq(src, ns, nl, "vector_data") == 1 { 1 }
  else { if src_eq(src, ns, nl, "vector_element_size") == 1 { 1 }
  else { if src_eq(src, ns, nl, "vector_element_mode") == 1 { 1 }
  else { if src_eq(src, ns, nl, "vector_capacity_bytes") == 1 { 1 }
  else { if src_eq(src, ns, nl, "vector_is_empty") == 1 { 1 }
  else { if src_eq(src, ns, nl, "vector_in_bounds") == 1 { 1 }
  else { if src_eq(src, ns, nl, "vector_get") == 1 { 1 }
  else { if src_eq(src, ns, nl, "vector_get_in_bounds") == 1 { 1 }
  else { if src_eq(src, ns, nl, "vector_get_field_in_bounds") == 1 { 1 }
  else { if src_eq(src, ns, nl, "vector_get_option") == 1 { 1 }
  else { if src_eq(src, ns, nl, "vector_sum_i64") == 1 { 1 }
  else { if src_eq(src, ns, nl, "vector_slice") == 1 { 1 }
  else { if src_eq(src, ns, nl, "vector_concat") == 1 { 1 }
  else { if src_eq(src, ns, nl, "to_array") == 1 { 1 } else { 0 } }
  } } } } } } } } } } } } } } }
}

fn slice_borrow_vector_method_is_read_only(method_hash: i64) -> i64 {
  if method_hash == effect_name_hash(__str_ptr("to_array"), 0, __str_len("to_array")) { 1 }
  else { 0 }
}

fn slice_borrow_check_vector_expr_access(node: i64, write: i64, env: i64, active: i64, context: i64, tenv: i64, ft: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  let ty = synth(node, tenv, ft, src, tt)
  if typeck_type_is_vector(tt, ty) == 0 { 0 }
  else {
    let info = slice_borrow_info_for_expr(node, env, tenv, ft, src, tt)
    let origins = slice_borrow_info_origins(info)
    let mut current = active
    let mut conflict = 0
    while current != 0 {
      let entry = node_f1(current)
      if slice_borrow_active_entry_live(entry, context, src) == 1 and slice_borrow_origins_overlap(origins, node_f3(entry), src) == 1 {
        if write == 1 or node_f4(entry) == 1 { conflict = 1 } else { 0 }
      } else { 0 }
      current = node_f2(current)
    }
    if conflict == 1 {
      typeck_error_maybe(src, expr_diag_pos(node), if write == 1 { "type error: Vector mutation or reallocation conflicts with a live slice borrow" } else { "type error: Vector access conflicts with a live mutable slice borrow" })
      1
    } else { 0 }
  }
}

fn slice_borrow_check_vector_call_args(args: i64, nargs: i64, read_only: i64, env: i64, active: i64, context: i64, tenv: i64, ft: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  let mut errors = 0
  for i in 0..nargs {
    errors = errors + slice_borrow_check_vector_expr_access(nlist_get(args, i), if read_only == 1 { 0 } else { 1 }, env, active, context, tenv, ft, src, tt)
  }
  errors
}

fn slice_borrow_check_result(node: i64, env: i64, tenv: i64, ft: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  let origins = slice_borrow_expr_escape_origins(node, env, tenv, ft, src, tt)
  let result_ty = synth(node, tenv, ft, src, tt)
  let kind = slice_borrow_origins_escape_kind(origins)
  if nlist_len(origins) > 0 and ty_is_slice(result_ty) == 0 {
    -- BorrowSummary currently maps slice-valued returns. An aggregate can
    -- carry local slices internally, but it cannot cross the function/closure
    -- boundary until aggregate return summaries can map those fields.
    typeck_error_maybe(src, expr_diag_pos(node), "type error: slice-containing aggregate cannot escape its borrow scope")
    1
  } else { if kind == 2 {
    typeck_error_maybe(src, expr_diag_pos(node), "type error: slice borrow escapes its owner")
    1
  } else { if kind == 3 {
    typeck_error_maybe(src, expr_diag_pos(node), "type error: slice provenance is unknown at escape")
    1
  } else { 0 } } }
}

fn slice_borrow_check_call_siblings(args: i64, nargs: i64, env: i64, tenv: i64, ft: i64, src: i64, tt: i64, pos: i64) -[Diagnose]> i64 {
  let mut conflict = 0
  for i in 0..nargs {
    let left = nlist_get(args, i)
    let left_ty = synth(left, tenv, ft, src, tt)
    if ty_is_slice(left_ty) {
      let left_origins = slice_borrow_expr_view_origins(left, env, tenv, ft, src, tt)
      for j in (i + 1)..nargs {
        let right = nlist_get(args, j)
        let right_ty = synth(right, tenv, ft, src, tt)
        if ty_is_slice(right_ty) and (ty_slice_mutable(left_ty) == 1 or ty_slice_mutable(right_ty) == 1) {
          if slice_borrow_origins_overlap(left_origins, slice_borrow_expr_view_origins(right, env, tenv, ft, src, tt), src) == 1 { conflict = 1 } else { 0 }
        } else { 0 }
      }
    } else { 0 }
  }
  if conflict == 1 {
    typeck_error_maybe(src, pos, "type error: call arguments contain overlapping mutable slice borrows")
    1
  } else { 0 }
}

-- A scoped Par body is called synchronously and cannot outlive the borrow.
-- A par_map worker may run on another thread, so its captured slice elements
-- additionally need a structural shareability proof. Lambda f4 is otherwise
-- reserved; keep this typed-AST fact distinct from source spelling at the
-- capture consumer.
fn slice_borrow_par_lambda_scope_body() -> i64 { 1 }
fn slice_borrow_par_lambda_worker() -> i64 { 2 }

-- This is the deliberately conservative v1 subset of the future Sendable
-- structural fact. The current promotion path cannot discover managed values
-- reachable through a two-word slice descriptor, so only word scalars and
-- inline records made entirely from such scalars are shareable here.
fn slice_borrow_scoped_par_plain_record_shareable(tt: i64, ty: i64) -> i64 {
  let entry = ttable_lookup_by_type_hash(tt, ty_f1(ty))
  if entry == 0 { 0 }
  else {
    let nfields = mem_load64_at(entry, 24)
    if nfields <= 0 { 0 }
    else {
      let fields = mem_load64_at(entry, 32)
      let subst = type_cycle_subst_for_entry(entry, ty_f3(ty))
      let mut ok = 1
      for i in 0..nfields {
        let raw_ty = mem_load64_at(fields, i * 24 + 16)
        let field_ty = type_cycle_maybe_subst(raw_ty, subst)
        if ty_tag(field_ty) != 2 or ty_f1(field_ty) == PRIM_STR() or ty_f1(field_ty) == PRIM_NIL() {
          ok = 0
        } else { 0 }
      }
      ok
    }
  }
}

fn slice_borrow_scoped_par_element_shareable(tt: i64, ty: i64) -> i64 {
  if ty == 0 { 0 }
  else {
    let tag = ty_tag(ty)
    match tag {
      0 -> 1
      2 -> if ty_f1(ty) == PRIM_STR() { 0 } else { 1 }
      3 -> if ty_union_storage_class(ty) == 1 and slice_borrow_scoped_par_element_shareable(tt, ty_f1(ty)) == 1 and slice_borrow_scoped_par_element_shareable(tt, ty_f2(ty)) == 1 { 1 } else { 0 }
      9 -> slice_borrow_scoped_par_plain_record_shareable(tt, ty)
      _ -> 0
    }
  }
}

fn slice_borrow_call_named(call_node: i64, src: i64, name: str) -> i64 {
  if call_node == 0 or node_tag(call_node) != 4 { 0 }
  else { src_eq(src, node_f1(call_node), node_f2(call_node), name) }
}

fn slice_borrow_call_is_par_scope(call_node: i64, src: i64) -> i64 {
  if slice_borrow_call_named(call_node, src, "par_with_sequential_i64") == 1 and node_f4(call_node) == 1 { 1 }
  else { if slice_borrow_call_named(call_node, src, "par_with_pthread_pool_i64") == 1 and node_f4(call_node) == 3 { 1 } else { 0 } }
}

fn slice_borrow_mark_scoped_par_expr_list(items: i64, count: i64, src: i64, in_scope: i64) -> i64 {
  for i in 0..count { slice_borrow_mark_scoped_par_expr(nlist_get(items, i), src, in_scope) }
  0
}

fn slice_borrow_mark_scoped_par_call(call_node: i64, src: i64, in_scope: i64) -> i64 {
  let args = node_f3(call_node)
  let nargs = node_f4(call_node)
  if slice_borrow_call_is_par_scope(call_node, src) == 1 {
    let body_index = if slice_borrow_call_named(call_node, src, "par_with_sequential_i64") == 1 { 0 } else { 2 }
    for i in 0..nargs {
      let arg = nlist_get(args, i)
      if i == body_index and node_tag(arg) == 29 {
        mem_store64_at(arg, 32, slice_borrow_par_lambda_scope_body())
        slice_borrow_mark_scoped_par_expr(node_f2(arg), src, 1)
      } else { slice_borrow_mark_scoped_par_expr(arg, src, in_scope) }
    }
  } else { if in_scope == 1 and slice_borrow_call_named(call_node, src, "par_map") == 1 and nargs == 2 {
    slice_borrow_mark_scoped_par_expr(nlist_get(args, 0), src, in_scope)
    let callback = nlist_get(args, 1)
    if node_tag(callback) == 29 {
      mem_store64_at(callback, 32, slice_borrow_par_lambda_worker())
      slice_borrow_mark_scoped_par_expr(node_f2(callback), src, 0)
    } else { slice_borrow_mark_scoped_par_expr(callback, src, in_scope) }
  } else { slice_borrow_mark_scoped_par_expr_list(args, nargs, src, in_scope) } }
  0
}

fn slice_borrow_mark_scoped_par_expr(node: i64, src: i64, in_scope: i64) -> i64 {
  if node == 0 { 0 }
  else {
    let tag = node_tag(node)
    match tag {
      3 -> slice_borrow_mark_scoped_par_expr(node_f2(node), src, in_scope) + slice_borrow_mark_scoped_par_expr(node_f3(node), src, in_scope)
      4 -> slice_borrow_mark_scoped_par_call(node, src, in_scope)
      5 -> slice_borrow_mark_scoped_par_expr(node_f1(node), src, in_scope) + slice_borrow_mark_scoped_par_expr(node_f2(node), src, in_scope) + slice_borrow_mark_scoped_par_expr(node_f3(node), src, in_scope)
      6 -> slice_borrow_mark_scoped_par_expr(node_f3(node), src, in_scope) + slice_borrow_mark_scoped_par_expr(node_f4(node), src, in_scope)
      7 -> slice_borrow_mark_scoped_par_expr(node_f1(node), src, in_scope) + slice_borrow_mark_scoped_par_expr(node_f2(node), src, in_scope)
      10 -> slice_borrow_mark_scoped_par_expr(node_f1(node), src, in_scope) + slice_borrow_mark_scoped_par_expr(node_f2(node), src, in_scope)
      11 -> slice_borrow_mark_scoped_par_expr(node_f3(node), src, in_scope) + slice_borrow_mark_scoped_par_expr(node_f4(node), src, in_scope)
      12 -> slice_borrow_mark_scoped_par_expr(node_f3(node), src, in_scope)
      13 -> slice_borrow_mark_scoped_par_expr(node_f1(node), src, in_scope)
      14 -> {
        let fields = node_f3(node)
        for i in 0..node_f4(node) { slice_borrow_mark_scoped_par_expr(node_f3(nlist_get(fields, i)), src, in_scope) }
        0
      }
      15 -> {
        slice_borrow_mark_scoped_par_expr(node_f1(node), src, in_scope)
        let arms = node_f2(node)
        for i in 0..node_f3(node) {
          let arm = nlist_get(arms, i)
          slice_borrow_mark_scoped_par_expr(node_f3(arm), src, in_scope)
          slice_borrow_mark_scoped_par_expr(node_f2(arm), src, in_scope)
        }
        0
      }
      22 -> slice_borrow_mark_scoped_par_expr(node_f1(node), src, in_scope)
      25 -> slice_borrow_mark_scoped_par_expr(node_f1(node), src, in_scope)
      26 -> slice_borrow_mark_scoped_par_expr(node_f1(node), src, in_scope)
      29 -> slice_borrow_mark_scoped_par_expr(node_f2(node), src, if node_f4(node) == slice_borrow_par_lambda_scope_body() { 1 } else { 0 })
      32 -> slice_borrow_mark_scoped_par_expr(node_f1(node), src, in_scope) + slice_borrow_mark_scoped_par_expr_list(node_f4(node), nlist_len(node_f4(node)), src, in_scope)
      33 -> {
        slice_borrow_mark_scoped_par_expr(node_f1(node), src, in_scope)
        let clauses = node_f2(node)
        for i in 0..node_f3(node) { slice_borrow_mark_scoped_par_expr(node_f3(nlist_get(clauses, i)), src, in_scope) }
        let ret = node_f4(node)
        if ret != 0 { slice_borrow_mark_scoped_par_expr(node_f3(ret), src, in_scope) } else { 0 }
      }
      35 -> slice_borrow_mark_scoped_par_expr(node_f1(node), src, in_scope)
      36 -> slice_borrow_mark_scoped_par_call(node_f2(node), src, in_scope)
      37 -> slice_borrow_mark_scoped_par_expr(node_f1(node), src, in_scope)
      41 -> slice_borrow_mark_scoped_par_expr(node_f1(node), src, in_scope) + slice_borrow_mark_scoped_par_expr_list(node_f3(node), nlist_len(node_f3(node)), src, in_scope)
      45 -> slice_borrow_mark_scoped_par_expr(node_f1(node), src, in_scope)
      46 -> slice_borrow_mark_scoped_par_expr(node_f1(node), src, in_scope) + slice_borrow_mark_scoped_par_expr(node_f2(node), src, in_scope)
      47 -> slice_borrow_mark_scoped_par_expr(node_f3(node), src, in_scope) + slice_borrow_mark_scoped_par_expr(node_f4(node), src, in_scope)
      48 -> slice_borrow_mark_scoped_par_expr(node_f1(node), src, in_scope)
      49 -> slice_borrow_mark_scoped_par_expr(node_f1(node), src, in_scope)
      52 -> slice_borrow_mark_scoped_par_expr(node_f1(node), src, in_scope) + slice_borrow_mark_scoped_par_expr(node_f2(node), src, in_scope)
      55 -> slice_borrow_mark_scoped_par_expr(node_f2(node), src, in_scope)
      56 -> slice_borrow_mark_scoped_par_expr(node_f1(node), src, in_scope)
      57 -> slice_borrow_mark_scoped_par_expr(node_f1(node), src, in_scope) + slice_borrow_mark_scoped_par_expr(node_f2(node), src, in_scope)
      58 -> slice_borrow_mark_scoped_par_expr_list(node_f1(node), node_f2(node), src, in_scope)
      59 -> slice_borrow_mark_scoped_par_expr(node_f1(node), src, in_scope)
      60 -> slice_borrow_mark_scoped_par_expr(node_f1(node), src, in_scope) + slice_borrow_mark_scoped_par_expr(node_f2(node), src, in_scope)
      61 -> slice_borrow_mark_scoped_par_expr(node_f1(node), src, in_scope) + slice_borrow_mark_scoped_par_expr(node_f2(node), src, in_scope) + slice_borrow_mark_scoped_par_expr(node_f3(node), src, in_scope)
      62 -> slice_borrow_mark_scoped_par_expr(node_f1(node), src, in_scope) + slice_borrow_mark_scoped_par_expr(node_f2(node), src, in_scope) + slice_borrow_mark_scoped_par_expr(node_f3(node), src, in_scope)
      _ -> 0
    }
  }
}

fn slice_borrow_check_expr_list(items: i64, count: i64, env: i64, active: i64, context: i64, tenv: i64, ft: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  let mut errors = 0
  for i in 0..count {
    let item = nlist_get(items, i)
    if node_tag(item) == 2 and typeck_type_is_vector(tt, synth(item, tenv, ft, src, tt)) == 0 { errors = errors + slice_borrow_check_access(item, 0, active, context, env, src) } else { 0 }
    errors = errors + slice_borrow_check_expr(item, env, active, context, tenv, ft, src, tt, 0)
  }
  errors
}

fn slice_borrow_lambda_capture_errors(lambda: i64, env: i64, tenv: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  let params = node_f1(lambda)
  let body = node_f2(lambda)
  let par_kind = node_f4(lambda)
  let mut current = env
  let mut errors = 0
  while current != 0 {
    let info = node_f3(current)
    let origins = if slice_borrow_info_kind(info) == 2 { slice_borrow_info_origins(info) } else { slice_borrow_info_contained(info) }
    -- A closure has no surface lifetime parameter, so even caller-owned slice
    -- parameters cannot be captured by an arbitrary escaping closure. The two
    -- marked scoped-Par forms below are the only proven non-escaping/joined
    -- consumers; checking only local/unknown origin classes here would let an
    -- unjoined worker carry a caller's slice indefinitely.
    if nlist_len(origins) > 0 and unique_params_bind_name(params, node_f3(lambda), src, src, node_f1(current), node_f2(current)) == 0 {
      if unique_ref_count_name(body, src, src, node_f1(current), node_f2(current)) > 0 {
        if par_kind == slice_borrow_par_lambda_scope_body() and slice_borrow_info_kind(info) == 2 {
          errors = errors
        } else { if par_kind == slice_borrow_par_lambda_worker() and slice_borrow_info_kind(info) == 2 {
          let capture_ty = tenv_lookup(tenv, src, node_f1(current), node_f2(current))
          if ty_is_slice(capture_ty) and ty_slice_mutable(capture_ty) == 1 {
            typeck_error_maybe(src, node_f1(current), "type error: mutable slice cannot cross a scoped Par boundary")
            errors = errors + 1
          } else { if ty_is_slice(capture_ty) and slice_borrow_scoped_par_element_shareable(tt, ty_slice_inner(capture_ty)) == 1 {
            errors = errors
          } else {
            typeck_error_maybe(src, node_f1(current), "type error: slice element type is not Sendable across scoped Par")
            errors = errors + 1
          } }
        } else {
          typeck_error_maybe(src, node_f1(current), "type error: slice borrow cannot be captured by an escaping closure")
          errors = errors + 1
        } }
      } else { 0 }
    } else { 0 }
    current = node_f4(current)
  }
  errors
}

fn slice_borrow_check_expr(node: i64, env: i64, active: i64, live_context: i64, tenv: i64, ft: i64, src: i64, tt: i64, result_pos: i64) -[Diagnose]> i64 {
  if node == 0 { 0 }
  else {
    let tag = node_tag(node)
    -- Result-shaped control nodes delegate the check to their actual result
    -- expressions. This avoids duplicate diagnostics while still checking
    -- explicit returns nested below a non-result statement.
    let result_container = if tag == 5 or tag == 6 or tag == 7 or tag == 11 or tag == 15 or tag == 25 or tag == 33 or tag == 36 or tag == 37 or tag == 52 { 1 } else { 0 }
    let mut errors = if result_pos == 1 and result_container == 0 { slice_borrow_check_result(node, env, tenv, ft, src, tt) } else { 0 }
    match tag {
      3 -> errors + slice_borrow_check_expr(node_f2(node), env, active, live_context, tenv, ft, src, tt, 0) + slice_borrow_check_expr(node_f3(node), env, active, live_context, tenv, ft, src, tt, 0)
      4 -> {
        let args = node_f3(node)
        errors = errors + slice_borrow_check_call_siblings(args, node_f4(node), env, tenv, ft, src, tt, node_f1(node))
        errors = errors + slice_borrow_check_vector_call_args(args, node_f4(node), slice_borrow_vector_call_is_read_only(src, node_f1(node), node_f2(node)), env, active, live_context, tenv, ft, src, tt)
        errors + slice_borrow_check_expr_list(args, node_f4(node), env, active, live_context, tenv, ft, src, tt)
      }
      5 -> errors + slice_borrow_check_expr(node_f1(node), env, active, live_context, tenv, ft, src, tt, 0) + slice_borrow_check_expr(node_f2(node), env, active, node_f2(node), tenv, ft, src, tt, result_pos) + slice_borrow_check_expr(node_f3(node), env, active, node_f3(node), tenv, ft, src, tt, result_pos)
      6 -> {
        let value = node_f3(node)
        let body = node_f4(node)
        errors = errors + slice_borrow_check_expr(value, env, active, live_context, tenv, ft, src, tt, 0)
        let info = slice_borrow_info_for_binding(value, node_f1(node), node_f2(node), env, tenv, ft, src, tt)
        if slice_borrow_info_kind(info) == 2 and node_tag(value) != 62 {
          let allowed = if node_tag(value) == 2 { value } else { 0 }
          errors = errors + slice_borrow_check_new(value, allowed, active, live_context, env, tenv, ft, src, tt)
        } else { 0 }
        let next_env = if info == 0 { env } else { slice_borrow_env_bind(env, node_f1(node), node_f2(node), info) }
        let value_ty = synth(value, tenv, ft, src, tt)
        let next_tenv = if node_tag(value) == 29 { tenv_bind_value(tenv, src, node_f1(node), node_f2(node), value_ty, value) } else { tenv_bind(tenv, src, node_f1(node), node_f2(node), value_ty) }
        let parent = if node_tag(value) == 62 and node_tag(node_f1(value)) == 2 { node_f1(value) } else { if node_tag(value) == 2 { value } else { 0 } }
        let next_active = if slice_borrow_info_kind(info) == 2 and unique_ref_count_name(body, src, src, node_f1(node), node_f2(node)) > 0 {
          slice_borrow_active_push(active, node_f1(node), node_f2(node), slice_borrow_info_origins(info), slice_borrow_info_mutable(info), parent)
        } else { active }
        errors + slice_borrow_check_expr(body, next_env, next_active, body, next_tenv, ft, src, tt, result_pos)
      }
      7 -> errors + slice_borrow_check_expr(node_f1(node), env, active, node, tenv, ft, src, tt, 0) + slice_borrow_check_expr(node_f2(node), env, active, node_f2(node), tenv, ft, src, tt, result_pos)
      10 -> errors + slice_borrow_check_expr(node_f1(node), env, active, live_context, tenv, ft, src, tt, 0) + slice_borrow_check_expr(node_f2(node), env, active, live_context, tenv, ft, src, tt, 0)
      11 -> {
        let value = node_f3(node)
        let body = node_f4(node)
        errors = errors + slice_borrow_check_expr(value, env, active, live_context, tenv, ft, src, tt, 0)
        let info = slice_borrow_info_for_binding(value, node_f1(node), node_f2(node), env, tenv, ft, src, tt)
        if slice_borrow_info_kind(info) == 2 and node_tag(value) != 62 {
          let allowed = if node_tag(value) == 2 { value } else { 0 }
          errors = errors + slice_borrow_check_new(value, allowed, active, live_context, env, tenv, ft, src, tt)
        } else { 0 }
        let next_env = if info == 0 { env } else { slice_borrow_env_bind(env, node_f1(node), node_f2(node), info) }
        let value_ty = synth(value, tenv, ft, src, tt)
        let next_tenv = tenv_bind_mut(tenv, src, node_f1(node), node_f2(node), value_ty)
        let parent = if node_tag(value) == 62 and node_tag(node_f1(value)) == 2 { node_f1(value) } else { if node_tag(value) == 2 { value } else { 0 } }
        let next_active = if slice_borrow_info_kind(info) == 2 and unique_ref_count_name(body, src, src, node_f1(node), node_f2(node)) > 0 {
          slice_borrow_active_push(active, node_f1(node), node_f2(node), slice_borrow_info_origins(info), slice_borrow_info_mutable(info), parent)
        } else { active }
        errors + slice_borrow_check_expr(body, next_env, next_active, body, next_tenv, ft, src, tt, result_pos)
      }
      12 -> {
        let info = slice_borrow_env_lookup(env, src, node_f1(node), node_f2(node))
        if slice_borrow_info_kind(info) == 2 or nlist_len(slice_borrow_info_contained(info)) > 0 {
          typeck_error_maybe(src, node_f1(node), "type error: cannot reassign a binding that carries a slice borrow")
          errors = errors + 1
        } else { 0 }
        let target = node_new(2, node_f1(node), node_f2(node), 0, 0)
        errors + slice_borrow_check_access(target, 1, active, live_context, env, src) + slice_borrow_check_expr(node_f3(node), env, active, live_context, tenv, ft, src, tt, 0)
      }
      13 -> errors + slice_borrow_check_expr(node_f1(node), env, active, live_context, tenv, ft, src, tt, 0)
      14 -> {
        let fields = node_f3(node)
        for i in 0..node_f4(node) { errors = errors + slice_borrow_check_expr(node_f3(nlist_get(fields, i)), env, active, live_context, tenv, ft, src, tt, 0) }
        errors
      }
      15 -> {
        errors = errors + slice_borrow_check_expr(node_f1(node), env, active, live_context, tenv, ft, src, tt, 0)
        let arms = node_f2(node)
        for i in 0..node_f3(node) {
          let arm = nlist_get(arms, i)
          errors = errors + slice_borrow_check_expr(node_f3(arm), env, active, node_f3(arm), tenv, ft, src, tt, 0)
          errors = errors + slice_borrow_check_expr(node_f2(arm), env, active, node_f2(arm), tenv, ft, src, tt, result_pos)
        }
        errors
      }
      22 -> errors + slice_borrow_check_expr(node_f1(node), env, active, live_context, tenv, ft, src, tt, 0)
      25 -> errors + slice_borrow_check_expr(node_f1(node), env, active, node_f1(node), tenv, ft, src, tt, 1)
      26 -> errors + slice_borrow_check_expr(node_f1(node), env, active, node_f1(node), tenv, ft, src, tt, 0)
      29 -> {
        errors = errors + slice_borrow_lambda_capture_errors(node, env, tenv, src, tt)
        let capture_origins = slice_borrow_lambda_capture_origins(node, env, src)
        if result_pos == 1 and nlist_len(capture_origins) > 0 {
          typeck_error_maybe(src, expr_diag_pos(node), "type error: escaping closure cannot capture a slice borrow")
          errors = errors + 1
        } else { 0 }
        let params = node_f1(node)
        let lambda_env = slice_borrow_env_bind_param_list(params, node_f3(node), env, src, tt)
        let lambda_tenv = slice_borrow_tenv_bind_param_list(params, node_f3(node), tenv, src)
        errors + slice_borrow_check_expr(node_f2(node), lambda_env, 0, node_f2(node), lambda_tenv, ft, src, tt, 1)
      }
      32 -> {
        let args = node_f4(node)
        for i in 0..nlist_len(args) {
          let kind = slice_borrow_origins_escape_kind(slice_borrow_expr_escape_origins(nlist_get(args, i), env, tenv, ft, src, tt))
          if kind != 0 {
            typeck_error_maybe(src, expr_diag_pos(nlist_get(args, i)), "type error: slice borrow cannot enter effect handler state")
            errors = errors + 1
          } else { 0 }
        }
        errors + slice_borrow_check_expr_list(args, nlist_len(args), env, active, live_context, tenv, ft, src, tt)
      }
      33 -> {
        errors = errors + slice_borrow_check_expr(node_f1(node), env, active, live_context, tenv, ft, src, tt, result_pos)
        let clauses = node_f2(node)
        for i in 0..node_f3(node) {
          let clause = nlist_get(clauses, i)
          let params = node_f2(clause)
          let clause_env = slice_borrow_env_bind_param_list(params, nlist_len(params), env, src, tt)
          let clause_tenv = slice_borrow_tenv_bind_param_list(params, nlist_len(params), tenv, src)
          errors = errors + slice_borrow_check_expr(node_f3(clause), clause_env, active, node_f3(clause), clause_tenv, ft, src, tt, result_pos)
        }
        let ret = node_f4(node)
        if ret != 0 { errors = errors + slice_borrow_check_expr(node_f3(ret), env, active, node_f3(ret), tenv, ft, src, tt, result_pos) } else { 0 }
        errors
      }
      35 -> {
        let kind = slice_borrow_origins_escape_kind(slice_borrow_expr_escape_origins(node_f1(node), env, tenv, ft, src, tt))
        if kind != 0 {
          typeck_error_maybe(src, expr_diag_pos(node_f1(node)), "type error: slice borrow cannot cross a continuation boundary")
          errors = errors + 1
        } else { 0 }
        errors + slice_borrow_check_expr(node_f1(node), env, active, live_context, tenv, ft, src, tt, 0)
      }
      36 -> {
        -- Check the represented call's arguments, but do not feed its inner
        -- Call node back through result checking: it is already covered by
        -- the outer explicit instantiation and must not be inferred again.
        let call_node = node_f2(node)
        let args = node_f3(call_node)
        errors = errors + slice_borrow_check_call_siblings(args, node_f4(call_node), env, tenv, ft, src, tt, node_f1(call_node))
        errors = errors + slice_borrow_check_vector_call_args(args, node_f4(call_node), slice_borrow_vector_call_is_read_only(src, node_f1(call_node), node_f2(call_node)), env, active, live_context, tenv, ft, src, tt)
        errors + slice_borrow_check_expr_list(args, node_f4(call_node), env, active, live_context, tenv, ft, src, tt)
      }
      37 -> {
        let inner = node_f1(node)
        let value = node_f3(inner)
        let body = node_f4(inner)
        errors = errors + slice_borrow_check_expr(value, env, active, live_context, tenv, ft, src, tt, 0)
        let info = slice_borrow_info_for_binding(value, node_f1(inner), node_f2(inner), env, tenv, ft, src, tt)
        if slice_borrow_info_kind(info) == 2 and node_tag(value) != 62 {
          let allowed = if node_tag(value) == 2 { value } else { 0 }
          errors = errors + slice_borrow_check_new(value, allowed, active, live_context, env, tenv, ft, src, tt)
        } else { 0 }
        let next_env = if info == 0 { env } else { slice_borrow_env_bind(env, node_f1(inner), node_f2(inner), info) }
        let next_tenv = if node_tag(inner) == 11 { tenv_bind_mut(tenv, src, node_f1(inner), node_f2(inner), node_f2(node)) } else { if node_tag(value) == 29 { tenv_bind_value(tenv, src, node_f1(inner), node_f2(inner), node_f2(node), value) } else { tenv_bind(tenv, src, node_f1(inner), node_f2(inner), node_f2(node)) } }
        let parent = if node_tag(value) == 62 and node_tag(node_f1(value)) == 2 { node_f1(value) } else { if node_tag(value) == 2 { value } else { 0 } }
        let next_active = if slice_borrow_info_kind(info) == 2 and unique_ref_count_name(body, src, src, node_f1(inner), node_f2(inner)) > 0 {
          slice_borrow_active_push(active, node_f1(inner), node_f2(inner), slice_borrow_info_origins(info), slice_borrow_info_mutable(info), parent)
        } else { active }
        errors + slice_borrow_check_expr(body, next_env, next_active, body, next_tenv, ft, src, tt, result_pos)
      }
      41 -> {
        let recv = node_f1(node)
        let recv_ty = synth(recv, tenv, ft, src, tt)
        if typeck_type_is_vector(tt, recv_ty) == 1 {
          errors = errors + slice_borrow_check_vector_expr_access(recv, if slice_borrow_vector_method_is_read_only(node_f2(node)) == 1 { 0 } else { 1 }, env, active, live_context, tenv, ft, src, tt)
        } else { errors = errors + slice_borrow_check_access(recv, 0, active, live_context, env, src) }
        errors = errors + slice_borrow_check_expr(recv, env, active, live_context, tenv, ft, src, tt, 0)
        let args = node_f3(node)
        errors = errors + slice_borrow_check_call_siblings(args, nlist_len(args), env, tenv, ft, src, tt, expr_diag_pos(node))
        errors + slice_borrow_check_expr_list(args, nlist_len(args), env, active, live_context, tenv, ft, src, tt)
      }
      45 -> errors + slice_borrow_check_expr(node_f1(node), env, active, live_context, tenv, ft, src, tt, 0)
      46 -> errors + slice_borrow_check_expr(node_f1(node), env, active, live_context, tenv, ft, src, tt, 0) + slice_borrow_check_expr(node_f2(node), env, active, live_context, tenv, ft, src, tt, 0)
      47 -> errors + slice_borrow_check_access(node_f3(node), 0, active, live_context, env, src) + slice_borrow_check_expr(node_f3(node), env, active, live_context, tenv, ft, src, tt, 0) + slice_borrow_check_expr(node_f4(node), env, active, live_context, tenv, ft, src, tt, 0)
      48 -> errors + slice_borrow_check_expr(node_f1(node), env, active, live_context, tenv, ft, src, tt, 0)
      49 -> errors + slice_borrow_check_expr(node_f1(node), env, active, live_context, tenv, ft, src, tt, 0)
      52 -> errors + slice_borrow_check_expr(node_f1(node), env, active, live_context, tenv, ft, src, tt, 0) + slice_borrow_check_expr(node_f2(node), env, active, live_context, tenv, ft, src, tt, result_pos)
      58 -> errors + slice_borrow_check_expr_list(node_f1(node), node_f2(node), env, active, live_context, tenv, ft, src, tt)
      59 -> errors + slice_borrow_check_access(node_f1(node), 0, active, live_context, env, src)
      60 -> errors + slice_borrow_check_access(node_f1(node), 0, active, live_context, env, src) + slice_borrow_check_expr(node_f2(node), env, active, live_context, tenv, ft, src, tt, 0)
      61 -> errors + slice_borrow_check_access(node_f1(node), 1, active, live_context, env, src) + slice_borrow_check_expr(node_f2(node), env, active, live_context, tenv, ft, src, tt, 0) + slice_borrow_check_expr(node_f3(node), env, active, live_context, tenv, ft, src, tt, 0)
      62 -> {
        let allowed = if node_tag(node_f1(node)) == 2 { node_f1(node) } else { 0 }
        errors = errors + slice_borrow_check_new(node, allowed, active, live_context, env, tenv, ft, src, tt)
        errors + slice_borrow_check_expr(node_f2(node), env, active, live_context, tenv, ft, src, tt, 0) + slice_borrow_check_expr(node_f3(node), env, active, live_context, tenv, ft, src, tt, 0)
      }
      _ -> errors
    }
  }
}

fn slice_borrow_expr_list_relevant(items: i64, count: i64, tt: i64) -> i64 {
  let mut found = 0
  for i in 0..count {
    if slice_borrow_expr_relevant(nlist_get(items, i), tt) == 1 { found = 1 } else { 0 }
  }
  found
}

fn slice_borrow_param_list_relevant(params: i64, count: i64, tt: i64) -> i64 {
  let mut found = 0
  for i in 0..count {
    if slice_borrow_type_contains(node_f3(nlist_get(params, i)), tt, 0) == 1 { found = 1 } else { 0 }
  }
  found
}

-- Keep the lifetime checker off the overwhelmingly common slice-free
-- function. Besides being cheaper, this avoids allocating empty origin lists
-- for every scalar node in large numeric modules. Any explicit slice creation,
-- slice-bearing signature/annotation, or nested callable signature turns the
-- full walk on for the containing function.
fn slice_borrow_expr_relevant(node: i64, tt: i64) -> i64 {
  if node == 0 { 0 }
  else {
    match node_tag(node) {
      3 -> if slice_borrow_expr_relevant(node_f2(node), tt) == 1 or slice_borrow_expr_relevant(node_f3(node), tt) == 1 { 1 } else { 0 }
      4 -> slice_borrow_expr_list_relevant(node_f3(node), node_f4(node), tt)
      5 -> if slice_borrow_expr_relevant(node_f1(node), tt) == 1 or slice_borrow_expr_relevant(node_f2(node), tt) == 1 or slice_borrow_expr_relevant(node_f3(node), tt) == 1 { 1 } else { 0 }
      6 -> if slice_borrow_expr_relevant(node_f3(node), tt) == 1 or slice_borrow_expr_relevant(node_f4(node), tt) == 1 { 1 } else { 0 }
      7 -> if slice_borrow_expr_relevant(node_f1(node), tt) == 1 or slice_borrow_expr_relevant(node_f2(node), tt) == 1 { 1 } else { 0 }
      10 -> if slice_borrow_expr_relevant(node_f1(node), tt) == 1 or slice_borrow_expr_relevant(node_f2(node), tt) == 1 { 1 } else { 0 }
      11 -> if slice_borrow_expr_relevant(node_f3(node), tt) == 1 or slice_borrow_expr_relevant(node_f4(node), tt) == 1 { 1 } else { 0 }
      12 -> slice_borrow_expr_relevant(node_f3(node), tt)
      13 -> slice_borrow_expr_relevant(node_f1(node), tt)
      14 -> {
        let fields = node_f3(node)
        let mut found = 0
        for i in 0..node_f4(node) { if slice_borrow_expr_relevant(node_f3(nlist_get(fields, i)), tt) == 1 { found = 1 } else { 0 } }
        found
      }
      15 -> {
        let arms = node_f2(node)
        let mut found = slice_borrow_expr_relevant(node_f1(node), tt)
        for i in 0..node_f3(node) {
          let arm = nlist_get(arms, i)
          if slice_borrow_expr_relevant(node_f2(arm), tt) == 1 or slice_borrow_expr_relevant(node_f3(arm), tt) == 1 { found = 1 } else { 0 }
        }
        found
      }
      22 -> slice_borrow_expr_relevant(node_f1(node), tt)
      25 -> slice_borrow_expr_relevant(node_f1(node), tt)
      26 -> slice_borrow_expr_relevant(node_f1(node), tt)
      29 -> if slice_borrow_param_list_relevant(node_f1(node), node_f3(node), tt) == 1 or slice_borrow_expr_relevant(node_f2(node), tt) == 1 { 1 } else { 0 }
      32 -> if slice_borrow_expr_relevant(node_f1(node), tt) == 1 or slice_borrow_expr_list_relevant(node_f4(node), nlist_len(node_f4(node)), tt) == 1 { 1 } else { 0 }
      33 -> {
        let mut found = slice_borrow_expr_relevant(node_f1(node), tt)
        let clauses = node_f2(node)
        for i in 0..node_f3(node) {
          let clause = nlist_get(clauses, i)
          if slice_borrow_param_list_relevant(node_f2(clause), nlist_len(node_f2(clause)), tt) == 1 or slice_borrow_expr_relevant(node_f3(clause), tt) == 1 { found = 1 } else { 0 }
        }
        let ret = node_f4(node)
        if ret != 0 and slice_borrow_expr_relevant(node_f3(ret), tt) == 1 { found = 1 } else { 0 }
        found
      }
      35 -> slice_borrow_expr_relevant(node_f1(node), tt)
      36 -> slice_borrow_expr_relevant(node_f2(node), tt)
      37 -> if slice_borrow_type_contains(node_f2(node), tt, 0) == 1 or slice_borrow_expr_relevant(node_f1(node), tt) == 1 { 1 } else { 0 }
      41 -> if slice_borrow_expr_relevant(node_f1(node), tt) == 1 or slice_borrow_expr_list_relevant(node_f3(node), nlist_len(node_f3(node)), tt) == 1 { 1 } else { 0 }
      45 -> slice_borrow_expr_relevant(node_f1(node), tt)
      46 -> if slice_borrow_expr_relevant(node_f1(node), tt) == 1 or slice_borrow_expr_relevant(node_f2(node), tt) == 1 { 1 } else { 0 }
      47 -> if slice_borrow_expr_relevant(node_f3(node), tt) == 1 or slice_borrow_expr_relevant(node_f4(node), tt) == 1 { 1 } else { 0 }
      48 -> slice_borrow_expr_relevant(node_f1(node), tt)
      49 -> slice_borrow_expr_relevant(node_f1(node), tt)
      52 -> if slice_borrow_expr_relevant(node_f1(node), tt) == 1 or slice_borrow_expr_relevant(node_f2(node), tt) == 1 { 1 } else { 0 }
      55 -> slice_borrow_expr_relevant(node_f2(node), tt)
      56 -> slice_borrow_expr_relevant(node_f1(node), tt)
      57 -> if slice_borrow_expr_relevant(node_f1(node), tt) == 1 or slice_borrow_expr_relevant(node_f2(node), tt) == 1 { 1 } else { 0 }
      58 -> slice_borrow_expr_list_relevant(node_f1(node), node_f2(node), tt)
      59 -> slice_borrow_expr_relevant(node_f1(node), tt)
      60 -> if slice_borrow_expr_relevant(node_f1(node), tt) == 1 or slice_borrow_expr_relevant(node_f2(node), tt) == 1 { 1 } else { 0 }
      61 -> if slice_borrow_expr_relevant(node_f1(node), tt) == 1 or slice_borrow_expr_relevant(node_f2(node), tt) == 1 or slice_borrow_expr_relevant(node_f3(node), tt) == 1 { 1 } else { 0 }
      62 -> 1
      _ -> 0
    }
  }
}

fn check_slice_borrow_contract(body: i64, params: i64, nparams: i64, ret_ty: i64, tenv: i64, ft: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  let signature_relevant = if slice_borrow_param_list_relevant(params, nparams, tt) == 1 or slice_borrow_type_contains(ret_ty, tt, 0) == 1 { 1 } else { 0 }
  if signature_relevant == 0 and slice_borrow_expr_relevant(body, tt) == 0 { 0 }
  else {
    slice_borrow_mark_scoped_par_expr(body, src, 0)
    let env = slice_borrow_env_bind_param_list(params, nparams, 0, src, tt)
    slice_borrow_check_expr(body, env, 0, body, tenv, ft, src, tt, 1)
  }
}

fn check_fn(fn_node: i64, ft: i64, src: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  -- fn_node may be wrapped in tag-23 {inner, ret_type}
  let inner = if node_tag(fn_node) == 23 { node_f1(fn_node) } else { fn_node }
  let params = node_f3(inner)
  let body = node_f4(inner)
  let nparams = nlist_len(params)
  let ret_ty = fn_ret_type(fn_node)
  let mut errors = check_public_arc_params(tt, src, params) + check_public_arc_ty(tt, src, node_f1(inner), ret_ty)
  errors = errors + check_native_result_abi_ty(src, node_f1(inner), ret_ty)
  errors = errors + check_move_only_storage_params(src, params) + check_move_only_storage_ty(src, node_f1(inner), ret_ty)
  errors = errors + check_owned_resource_params(tt, src, params) + check_owned_resource_ty(tt, src, node_f1(inner), ret_ty)
  -- Build environment from params using their type annotations
  let mut env = tenv_new()
  for i in 0..nparams {
    let p = nlist_get(params, i)
    let param_ty = node_f3(p)
    -- If param has a type annotation (f3 != 0), use it; else default to any
    let ty = if param_ty != 0 { param_ty } else { ty_any() }
    env = tenv_bind(env, src, node_f1(p), node_f2(p), ty)
  }
  -- Store current function's tparams for generic method resolution
  let tparams = fn_tparams(fn_node)
  let saved_tparams = ttable_get_tparams(tt)
  ttable_set_tparams(tt, tparams)
  let caller_eff = fn_effects(fn_node)
  -- 4c: expose the declared effect sig to synth-time perform checking
  -- (parameterized-atom instantiation), mirroring the tparams slot.
  let saved_fn_eff = ttable_get_current_fn_eff(tt)
  ttable_set_current_fn_eff(tt, caller_eff)
  -- 4a S1: the declared effect list can carry unsupported-surface markers
  -- (effect type arguments); walk it like params and the return type.
  errors = errors + check_public_arc_ty(tt, src, node_f1(inner), caller_eff)
  errors = errors + check_owned_drop_param_effects(params, nparams, tt, src, caller_eff)
  prepare_expr_contextual(body, ret_ty, env, ft, src, tt)
  -- synth first to convert tag-32 dot-calls to tag-41 method calls
  let body_ty_pre = synth(body, env, ft, src, tt)
  -- Generic ctor inference pre-pass: result-position (and returned) bare
  -- generic ctors solve their type args from the declared return type
  -- and are rewritten to explicit GenericCall nodes BEFORE check_expr
  -- would flag their bare form. Gated on the return type being a named
  -- type — the only expected-type shape context inference can solve —
  -- so ordinary functions never pay for the walk.
  let body_ty = if ty_tag(ret_ty) == 9 and infer_generic_ctor_result(body, ret_ty, env, ft, src, tt) == 1 {
    synth(body, env, ft, src, tt)
  } else { body_ty_pre }
  -- check_expr recurses deeper and resolves remaining tag-32 nodes
  errors = errors + check_expr(body, env, ft, src, caller_eff, tt)
  errors = errors + check_slice_borrow_contract(body, params, nparams, ret_ty, env, ft, src, tt)
  errors = errors + check_resume_scope(body, src, 0)
  errors = errors + check_continuation_param_usage_with_result(body, params, nparams, ret_ty, src, ft)
  if typeck_params_contain_unique(params) == 1 or typeck_ty_contains_unique(ret_ty) == 1 {
    errors = errors + check_unique_param_usage(params, nparams, body, src)
    errors = errors + check_unique_linear_expr(body, env, ft, src, tt)
  } else { errors = errors }
  errors = errors + check_return_values(body, env, ft, src, ret_ty, tt)
  -- Check return type: body type must be subtype of declared return type
  -- (the inference pre-pass above already resolved result-position ctors).
  if type_is_unknown_or_any(body_ty) { errors = errors }
  else { if expr_matches_type_contextual(body, body_ty, ret_ty, src) != 1 {
    typeck_error_maybe(src, node_f1(inner), "type error: return type mismatch")
    errors = errors + 1
  } else { errors = errors } }
  -- Restore previous function's tparams
  ttable_set_tparams(tt, saved_tparams)
  ttable_set_current_fn_eff(tt, saved_fn_eff)
  errors
}

-- Get return type from fn wrapper (tag-23 has ret_type at f2)
fn fn_ret_type(fn_wrap: i64) -> i64 {
  if node_tag(fn_wrap) == 23 {
    let rt = node_f2(fn_wrap)
    if rt != 0 { rt } else { ty_any() }
  } else { ty_any() }
}

-- Get effect signature from fn wrapper (tag-23 has effects at f3)
fn fn_effects(fn_wrap: i64) -> i64 {
  if node_tag(fn_wrap) == 23 {
    let eff = node_f3(fn_wrap)
    if eff != 0 { eff } else { 0 }
  } else { 0 }
}

-- Get type params from fn wrapper (tag-23 has tparams at f4)
fn fn_tparams(fn_wrap: i64) -> i64 {
  if node_tag(fn_wrap) == 23 { node_f4(fn_wrap) } else { 0 }
}

-- Get inner fn from wrapper
fn fn_inner(fn_wrap: i64) -> i64 {
  if node_tag(fn_wrap) == 23 { node_f1(fn_wrap) } else { fn_wrap }
}

-- Register variant constructors from the type table as synthetic functions in ftypes
-- So the type checker can verify constructor argument types
fn register_ctors(ft: i64, tt: i64, user_src: i64) -> i64 {
  if tt == 0 { 0 }
  else {
    let n = mem_load64_at(tt, 8)
    let d = mem_load64_at(tt, 0)
    for ti in 0..n {
      let kind = mem_load64_at(d, ti * 64 + 16)
      if kind == 1 {
        let nvariants = mem_load64_at(d, ti * 64 + 24)
        let variants = mem_load64_at(d, ti * 64 + 32)
        let tparams = mem_load64_at(d, ti * 64 + 40)
        for vi in 0..nvariants {
          let v_ns = mem_load64_at(variants, vi * 40)
          let v_nl = mem_load64_at(variants, vi * 40 + 8)
          let npayloads = mem_load64_at(variants, vi * 40 + 24)
          -- Compute parent type hash for Named return type using entry's src
          let type_ns = mem_load64_at(d, ti * 64)
          let type_nl = mem_load64_at(d, ti * 64 + 8)
          let entry_src = mem_load64_at(d, ti * 64 + 48)
          let parent_hash = mem_load64_at(d, ti * 64 + 56)
          let ctor_ret = ctor_return_type(parent_hash, tparams)
          if npayloads > 0 {
            let params = nlist_new()
            let payload_types = mem_load64_at(variants, vi * 40 + 32)
            for pi in 0..npayloads {
              let pty = if payload_types != 0 { nlist_get(payload_types, pi) } else { ty_any() }
              nlist_add(params, node_new(2, 0, 0, pty, 0))
            }
            -- Key by the declaring buffer: v_ns/v_nl are offsets into
            -- entry_src, and ftypes hashes name bytes through the stored src.
            ftypes_add(ft, entry_src, v_ns, v_nl, ctor_ret, params, 0, tparams)
          } else {
            -- Bare constructor (no payload): register with empty params
            ftypes_add(ft, entry_src, v_ns, v_nl, ctor_ret, nlist_new(), 0, tparams)
          }
        }
      } else { 0 }
    }
    0
  }
}

fn ctor_type_args_from_tparams(tparams: i64) -> i64 {
  if tparams == 0 { 0 }
  else {
    let args = nlist_new()
    let n = nlist_len(tparams)
    for i in 0..n {
      let tp = nlist_get(tparams, i)
      nlist_add(args, ty_var(node_f3(tp)))
    }
    args
  }
}

fn ctor_return_type(parent_hash: i64, tparams: i64) -> i64 {
  let args = ctor_type_args_from_tparams(tparams)
  if args == 0 { ty_named(parent_hash, ty_i64()) }
  else { ty_named_app(parent_hash, ty_i64(), args) }
}

-- Add an effect to an effect set (for handler discharge — expands caller_eff)
-- If caller_eff is 0 (unannotated), returns 0 (no checking)
-- Otherwise, creates a new EffectSig with the added effect
fn effect_add(eff: i64, eff_hash: i64) -> i64 {
  if eff == 0 { 0 }
  else {
    if eff_hash == 0 { eff }
    else {
      if ty_tag(eff) != 10 { eff }
      else {
        let old_list = ty_f1(eff)
        let new_list = nlist_new()
        -- Copy existing effects
        for i in 0..nlist_len(old_list) {
          nlist_add(new_list, nlist_get(old_list, i))
        }
        -- Add the new effect
        nlist_add(new_list, ty_effect_app(eff_hash))
        -- Handler expansion adds one concrete atom but must leave the
        -- caller's polymorphic remainder alone. Closing -[E]> here made
        -- the exact kernel with_state<S,T,E> shape reject f(): the handled
        -- State<S> was available, but the callback's E had disappeared.
        ty_effect_sig_with_tail(new_list, ty_f2(eff))
      }
    }
  }
}

-- 4c: effect_add variant that appends a specific (possibly parameterized)
-- atom rather than a bare head, so a handle body's callees can charge
-- their instantiated atoms against the expanded set.
fn effect_add_with_atom(eff: i64, eff_hash: i64, atom: i64) -> i64 {
  if atom == 0 { effect_add(eff, eff_hash) }
  else {
    if eff == 0 { 0 }
    else {
      if ty_tag(eff) != 10 { eff }
      else {
        let old_list = ty_f1(eff)
        let new_list = nlist_new()
        for i in 0..nlist_len(old_list) {
          nlist_add(new_list, nlist_get(old_list, i))
        }
        nlist_add(new_list, atom)
        ty_effect_sig_with_tail(new_list, ty_f2(eff))
      }
    }
  }
}

-- Check every function in the module — root and imported sources alike.
-- (Imported bodies were historically skipped, which let unknown calls,
-- effect drift, and type errors in use'd files pass with 0 errors.)
fn check_user_fns(fns: i64, user_src: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let n = nlist_len(fns)
  let ft = ftypes_new()
  -- Pass 1: register all function return types
  for i in 0..n {
    let pair = nlist_get(fns, i)
    let fn_wrap = node_f1(pair)
    let fn_src = node_f2(pair)
    let inner = fn_inner(fn_wrap)
    let reg_entry = ftypes_add(ft, fn_src, node_f1(inner), node_f2(inner), fn_ret_type(fn_wrap), node_f3(inner), fn_effects(fn_wrap), fn_tparams(fn_wrap))
    if node_f3(pair) != 0 { mem_store64_at(reg_entry, 72, 1) } else { 0 }
    ftypes_set_body(ft, fn_src, node_f1(inner), node_f2(inner), node_f4(inner))
  }
  -- Register variant constructors from type table
  register_ctors(ft, tt, user_src)
  -- Pass 2: check impl declarations and functions from user_src
  let mut total_errors = check_type_cycles(tt, user_src) + check_aggregate_release_mask_capacity(tt, user_src) + check_impl_decls(tt, user_src) + check_decl_signature_surfaces(tt, user_src)
  for j in 0..n {
    let pair = nlist_get(fns, j)
    let fn_src = node_f2(pair)
    total_errors = total_errors + check_fn(node_f1(pair), ft, fn_src, tt)
  }
  total_errors = total_errors + check_imported_unsafe_raw_fns(fns, user_src, tt)
  total_errors = total_errors + check_strict_root_unsafe_raw_fns(fns, user_src, tt)
  total_errors
}

-- Check all functions in a module
fn check_module(fns: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let n = nlist_len(fns)
  let ft = ftypes_new()
  -- Pass 1: register all function return types (use declared type or any)
  for i in 0..n {
    let pair = nlist_get(fns, i)
    let fn_node = node_f1(pair)
    let fn_src = node_f2(pair)
    let inner = fn_inner(fn_node)
    ftypes_add(ft, fn_src, node_f1(inner), node_f2(inner), fn_ret_type(fn_node), node_f3(inner), fn_effects(fn_node), fn_tparams(fn_node))
    ftypes_set_body(ft, fn_src, node_f1(inner), node_f2(inner), node_f4(inner))
  }
  -- Pass 2: check impl declarations and all function bodies
  let mut total_errors = check_type_cycles(tt, 0) + check_aggregate_release_mask_capacity(tt, 0) + check_impl_decls(tt, 0) + check_decl_signature_surfaces(tt, 0)
  for j in 0..n {
    let pair = nlist_get(fns, j)
    let fn_node = node_f1(pair)
    let fn_src = node_f2(pair)
    total_errors = total_errors + check_fn(fn_node, ft, fn_src, tt)
  }
  total_errors
}
