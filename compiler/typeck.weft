  else { if src_eq(src, ns, nl, "__platform_file_chmod") == 1 { true }
  else { if intrinsic_platform_directory_arity(src, ns, nl) >= 0 { true }
  else { if intrinsic_platform_time_arity(src, ns, nl) >= 0 { true }
  else { if intrinsic_platform_proc_arity(src, ns, nl) >= 0 { true }
  else { if intrinsic_platform_thread_arity(src, ns, nl) >= 0 { true }
  else { if intrinsic_platform_network_arity(src, ns, nl) >= 0 { true }
  else { if src_eq(src, ns, nl, "__platform_close") == 1 { true }
