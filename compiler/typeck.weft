pub(package) fn intrinsic_semantic_effect_flags(src: i64, ns: i64, nl: i64) -> i64 {
  let alloc = if intrinsic_alloc_effect_call_name(src, ns, nl) == 1 { 1 } else { 0 }
  let unsafe = if intrinsic_memory_effect_call_name(src, ns, nl) == 1 or intrinsic_platform_effect_call_name(src, ns, nl) == 1 or is_unsafe_raw_call_name(src, ns, nl) == 1 { 1 } else { 0 }
  let memory = if intrinsic_safe_memory_effect_call_name(src, ns, nl) == 1 { 1 } else { 0 }
  alloc + unsafe * 2 + memory * 8
}

pub(package) fn is_got_call_name(src: i64, ns: i64, nl: i64) -> bool {
  if nl > 6 {
    src_eq_at(src, ns, __str_ptr("__got_"), 0, 6) == 1
  } else { false }
}

pub(package) fn is_known_got_call_name(src: i64, ns: i64, nl: i64) -> bool {
  if is_got_call_name(src, ns, nl) {
    let rest_ns = ns + 6
    let rest_nl = nl - 6
    if src_eq(src, rest_ns, rest_nl, "posix_spawn") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "waitpid") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "exit") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "pthread_create") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "pthread_join") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "mmap") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "write") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "read") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "open") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "close") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "pthread_mutex_init") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "pthread_mutex_lock") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "pthread_mutex_unlock") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "pthread_mutex_destroy") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "pthread_cond_init") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "pthread_cond_wait") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "pthread_cond_signal") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "pthread_cond_broadcast") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "pthread_cond_destroy") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "clock_gettime") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "nanosleep") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "getenv") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "opendir") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "readdir") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "closedir") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "stat") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "mkdir") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "remove") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "rename") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "getcwd") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "__error") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "pipe") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "fcntl") == 1 { false }
    else { if src_eq(src, rest_ns, rest_nl, "posix_spawn_file_actions_init") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "posix_spawn_file_actions_adddup2") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "posix_spawn_file_actions_addclose") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "posix_spawn_file_actions_destroy") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "kill") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "getaddrinfo") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "freeaddrinfo") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "signal") == 1 { true }
    else { false } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } }
  } else { false }
}

pub(package) fn check_got_call_known(node: i64, src: i64) -[Diagnose]> i64 {
  let ns = node_f1(node)
  let nl = node_f2(node)
  if is_got_call_name(src, ns, nl) {
    if is_known_got_call_name(src, ns, nl) { 0 }
    else {
      typeck_error_maybe(src, ns, "type error: unknown GOT symbol")
      1
    }
  } else { 0 }
}

pub(package) fn is_unsafe_raw_call_name(src: i64, ns: i64, nl: i64) -> bool {
  if src_eq(src, ns, nl, "__syscall") == 1 { true }
  else { if src_eq(src, ns, nl, "__raw_offset") == 1 { true }
  else { if src_eq(src, ns, nl, "__transmute") == 1 { true }
  else { if src_eq(src, ns, nl, "__int_to_ptr") == 1 { true }
  else { if src_eq(src, ns, nl, "__runtime_state") == 1 { true }
  else { if src_eq(src, ns, nl, "__set_runtime_state") == 1 { true }
  else { if src_eq(src, ns, nl, "__set_handler_stack") == 1 { true }
  else { if src_eq(src, ns, nl, "__call_i64") == 1 { true }
  else { if src_eq(src, ns, nl, "__call_closure_i64") == 1 { true }
  else { if src_eq(src, ns, nl, "__fiber_trampoline") == 1 { true }
  else { if src_eq(src, ns, nl, "__fiber_suspend") == 1 { true }
  else { if src_eq(src, ns, nl, "__fiber_resume") == 1 { true }
  else { if src_eq(src, ns, nl, "__fiber_is_done") == 1 { true }
  else { is_got_call_name(src, ns, nl) }
  } } } } } } } } } } } }
}

pub(package) fn check_unsafe_raw_call_available(node: i64, src: i64, caller_eff: i64, tt: i64) -[Diagnose]> i64 {
  let ns = node_f1(node)
  let nl = node_f2(node)
  if is_unsafe_raw_call_name(src, ns, nl) {
    check_effect_hash_available(effect_hash_unsafe(), src, ns, caller_eff, tt, "unsafe operation")
  } else { 0 }
}

pub(package) fn check_imported_raw_call_sealed(node: i64, src: i64) -[Diagnose]> i64 {
  let ns = node_f1(node)
  let nl = node_f2(node)
  if intrinsic_alloc_effect_call_name(src, ns, nl) == 1 {
    typeck_error_maybe(src, ns, "type error: raw allocation is sealed to trusted runtime/platform code")
    1
  } else { if is_unsafe_raw_call_name(src, ns, nl) or is_unsafe_helper_call_name(src, ns, nl) == 1 or intrinsic_memory_effect_call_name(src, ns, nl) == 1 or intrinsic_platform_effect_call_name(src, ns, nl) == 1 {
    typeck_error_maybe(src, ns, "type error: Unsafe is sealed to trusted runtime/platform code")
    1
  } else { 0 } }
}

pub(package) fn is_unsafe_helper_call_name(src: i64, ns: i64, nl: i64) -> i64 {
  if src_eq(src, ns, nl, "unsafe_raw_offset") == 1 { true }
  else { if src_eq(src, ns, nl, "unsafe_raw_offset_mut") == 1 { true }
  else { if src_eq(src, ns, nl, "unsafe_transmute") == 1 { true }
  else { if src_eq(src, ns, nl, "unsafe_raw_syscall") == 1 { true }
  else { if src_eq(src, ns, nl, "unsafe_int_to_ptr") == 1 { true }
  else { if src_eq(src, ns, nl, "unsafe_runtime_state") == 1 { true }
  else { src_eq(src, ns, nl, "unsafe_raw_call_i64") } } } } } }
}

pub(package) fn is_source_trust_grant_call_name(src: i64, ns: i64, nl: i64) -> i64 {
  if src_eq(src, ns, nl, "pipeline_mark_root_origin") == 1 { true }
  else { if src_eq(src, ns, nl, "pipeline_mark_root_origin_with_grant") == 1 { true }
  else { if src_eq(src, ns, nl, "pipeline_parse_source_with_trust") == 1 { true }
  else { if src_eq(src, ns, nl, "pipeline_parse_source_with_origin") == 1 { true }
  else { if src_eq(src, ns, nl, "pipeline_parse_source_with_diagnostics_and_trust") == 1 { true }
  else { if src_eq(src, ns, nl, "pipeline_parse_source_with_diagnostics_and_origin") == 1 { true }
  else { if src_eq(src, ns, nl, "pipeline_check_source_with_trust") == 1 { true }
  else { if src_eq(src, ns, nl, "pipeline_check_source_with_origin") == 1 { true }
  else { if src_eq(src, ns, nl, "pipeline_check_source_with_diagnostics_and_trust") == 1 { true }
  else { if src_eq(src, ns, nl, "pipeline_check_source_with_diagnostics_and_origin") == 1 { true }
  else { if src_eq(src, ns, nl, "pipeline_compile_native_source_with_trust") == 1 { true }
  else { if src_eq(src, ns, nl, "pipeline_compile_native_source_with_origin") == 1 { true }
  else { if src_eq(src, ns, nl, "ttable_mark_source_trust_grant_source") == 1 { true }
  else { src_eq(src, ns, nl, "ttable_mark_trusted_source") } }
  } } } } } } } } } } } }
}

pub(package) fn check_imported_source_trust_grant_sealed(tt: i64, node: i64, src: i64) -[Diagnose]> i64 {
  let ns = node_f1(node)
  let nl = node_f2(node)
  if is_source_trust_grant_call_name(src, ns, nl) == 1 {
    if ttable_source_can_grant_trust(tt, src) == 1 { 0 }
    else {
      typeck_error_maybe(src, ns, "type error: source trust is sealed to trusted compiler/runtime code")
      1
    }
  } else { 0 }
}

pub(package) fn is_internal_par_prepared_call_name(src: i64, ns: i64, nl: i64) -> i64 {
  if src_eq(src, ns, nl, "par_pthread_pool_submit_prepared") == 1 { true }
  else { src_eq(src, ns, nl, "par_pthread_pool_submit_prepared_result") == 1 }
}

pub(package) fn check_internal_par_prepared_call_sealed(tt: i64, node: i64, src: i64) -[Diagnose]> i64 {
  if ttable_source_is_trusted(tt, src) == 1 { 0 }
  else {
    let ns = node_f1(node)
    let nl = node_f2(node)
    if is_internal_par_prepared_call_name(src, ns, nl) == 1 {
      typeck_error_maybe(src, ns, "type error: prepared Par submission is compiler-internal")
      1
    } else { 0 }
  }
}

pub(package) fn check_imported_unsafe_perform_sealed(node: i64, src: i64) -[Diagnose]> i64 {
  let lhs = node_f1(node)
  let ident = effect_ref_ident_node(lhs)
  if ident != 0 {
    if src_eq(src, node_f1(ident), node_f2(ident), "Unsafe") == 1 {
      typeck_error_maybe(src, node_f1(ident), "type error: Unsafe is sealed to trusted runtime/platform code")
      1
    } else { 0 }
  } else { 0 }
}

pub(package) fn check_imported_unsafe_handle_sealed(handled_eff_hash: i64, clause_name: i64, src: i64) -[Diagnose]> i64 {
  if handled_eff_hash == effect_hash_unsafe() {
    let ident = effect_ref_ident_node(clause_name)
    typeck_error_maybe(src, if ident == 0 { 0 } else { node_f1(ident) }, "type error: Unsafe is sealed to trusted runtime/platform code")
    1
  } else { 0 }
}

pub(package) fn check_imported_pointer_surface_sealed(node: i64, src: i64) -[Diagnose]> i64 {
  typeck_error_maybe(src, expr_diag_pos(node), "type error: Unsafe is sealed to trusted runtime/platform code")
  1
}

pub(package) fn check_imported_unsafe_raw_expr_list(tt: i64, list: i64, n: i64, src: i64, caller_eff: i64) -[Diagnose]> i64 {
  let mut errors = 0
  for i in 0..n {
    errors = errors + check_imported_unsafe_raw_expr(tt, nlist_get(list, i), src, caller_eff)
  }
  errors
}

pub(package) fn check_imported_unsafe_raw_record_fields(tt: i64, fields: i64, nfields: i64, src: i64, caller_eff: i64) -[Diagnose]> i64 {
  let mut errors = 0
  for i in 0..nfields {
    errors = errors + check_imported_unsafe_raw_expr(tt, node_f3(nlist_get(fields, i)), src, caller_eff)
  }
  errors
}

pub(package) fn check_imported_unsafe_raw_match_arms(tt: i64, arms: i64, narms: i64, src: i64, caller_eff: i64) -[Diagnose]> i64 {
  let mut errors = 0
  for i in 0..narms {
    let arm = nlist_get(arms, i)
    errors = errors + check_imported_unsafe_raw_expr(tt, node_f2(arm), src, caller_eff)
    if node_f3(arm) != 0 {
      errors = errors + check_imported_unsafe_raw_expr(tt, node_f3(arm), src, caller_eff)
    } else { errors = errors }
  }
  errors
}

pub(package) fn check_imported_unsafe_raw_handler_clauses(tt: i64, clauses: i64, nclauses: i64, handled_eff_hash: i64, src: i64, caller_eff: i64) -[Diagnose]> i64 {
  let mut errors = 0
  let clause_eff = if handled_eff_hash == effect_hash_unsafe() {
    effect_add(caller_eff, handled_eff_hash)
  } else { caller_eff }
  for i in 0..nclauses {
    errors = errors + check_imported_unsafe_raw_expr(tt, node_f3(nlist_get(clauses, i)), src, clause_eff)
  }
  errors
}

pub(package) fn check_imported_unsafe_raw_expr(tt: i64, node: i64, src: i64, caller_eff: i64) -[Diagnose]> i64 {
  if node == 0 { 0 }
  else {
    match node_tag(node) {
      3 -> check_imported_unsafe_raw_expr(tt, node_f2(node), src, caller_eff) + check_imported_unsafe_raw_expr(tt, node_f3(node), src, caller_eff)
      4 -> check_got_call_known(node, src) + check_imported_raw_call_sealed(node, src) + check_imported_source_trust_grant_sealed(tt, node, src) + check_imported_unsafe_raw_expr_list(tt, node_f3(node), node_f4(node), src, caller_eff)
      5 -> check_imported_unsafe_raw_expr(tt, node_f1(node), src, caller_eff) + check_imported_unsafe_raw_expr(tt, node_f2(node), src, caller_eff) + check_imported_unsafe_raw_expr(tt, node_f3(node), src, caller_eff)
      6 -> check_imported_unsafe_raw_expr(tt, node_f3(node), src, caller_eff) + check_imported_unsafe_raw_expr(tt, node_f4(node), src, caller_eff)
      7 -> check_imported_unsafe_raw_expr(tt, node_f1(node), src, caller_eff) + check_imported_unsafe_raw_expr(tt, node_f2(node), src, caller_eff)
      10 -> check_imported_unsafe_raw_expr(tt, node_f1(node), src, caller_eff) + check_imported_unsafe_raw_expr(tt, node_f2(node), src, caller_eff)
      11 -> check_imported_unsafe_raw_expr(tt, node_f3(node), src, caller_eff) + check_imported_unsafe_raw_expr(tt, node_f4(node), src, caller_eff)
      12 -> check_imported_unsafe_raw_expr(tt, node_f3(node), src, caller_eff)
      57 -> check_imported_pointer_surface_sealed(node, src) + check_imported_unsafe_raw_expr(tt, node_f1(node), src, caller_eff) + check_imported_unsafe_raw_expr(tt, node_f2(node), src, caller_eff)
      13 -> check_imported_unsafe_raw_expr(tt, node_f1(node), src, caller_eff)
      59 -> check_imported_unsafe_raw_expr(tt, node_f1(node), src, caller_eff)
      60 -> check_imported_unsafe_raw_expr(tt, node_f1(node), src, caller_eff) + check_imported_unsafe_raw_expr(tt, node_f2(node), src, caller_eff)
      61 -> check_imported_unsafe_raw_expr(tt, node_f1(node), src, caller_eff) + check_imported_unsafe_raw_expr(tt, node_f2(node), src, caller_eff) + check_imported_unsafe_raw_expr(tt, node_f3(node), src, caller_eff)
      62 -> check_imported_unsafe_raw_expr(tt, node_f1(node), src, caller_eff) + check_imported_unsafe_raw_expr(tt, node_f2(node), src, caller_eff) + check_imported_unsafe_raw_expr(tt, node_f3(node), src, caller_eff)
      14 -> check_imported_unsafe_raw_record_fields(tt, node_f3(node), node_f4(node), src, caller_eff)
      63 -> check_imported_unsafe_raw_expr(tt, node_f1(node), src, caller_eff) + check_imported_unsafe_raw_record_fields(tt, node_f2(node), node_f3(node), src, caller_eff)
      58 -> check_imported_unsafe_raw_expr_list(tt, node_f1(node), node_f2(node), src, caller_eff)
      15 -> check_imported_unsafe_raw_expr(tt, node_f1(node), src, caller_eff) + check_imported_unsafe_raw_match_arms(tt, node_f2(node), node_f3(node), src, caller_eff)
      22 -> check_imported_unsafe_raw_expr(tt, node_f1(node), src, caller_eff)
      25 -> check_imported_unsafe_raw_expr(tt, node_f1(node), src, caller_eff)
      26 -> check_imported_unsafe_raw_expr(tt, node_f1(node), src, caller_eff)
      29 -> check_imported_unsafe_raw_expr(tt, node_f2(node), src, caller_eff)
      32 -> {
        let declaration = typeck_qualified_call_declaration(node)
        let target_errors = if declaration == 0 { check_imported_unsafe_perform_sealed(node, src) + check_imported_unsafe_raw_expr(tt, node_f1(node), src, caller_eff) } else { 0 }
        target_errors + check_imported_unsafe_raw_expr_list(tt, node_f4(node), nlist_len(node_f4(node)), src, caller_eff)
      }
      33 -> {
        let clauses = node_f2(node)
        let nclauses = node_f3(node)
        let handled_eff_hash = if nclauses > 0 {
          let effect_ref = node_f1(node_f1(nlist_get(clauses, 0)))
          typeck_effect_ref_name_hash(effect_ref, src)
        } else { 0 }
        let first_name = if nclauses > 0 { node_f1(node_f1(nlist_get(clauses, 0))) } else { 0 }
        check_imported_unsafe_handle_sealed(handled_eff_hash, first_name, src) + check_imported_unsafe_raw_expr(tt, node_f1(node), src, effect_add(caller_eff, handled_eff_hash)) + check_imported_unsafe_raw_handler_clauses(tt, clauses, nclauses, handled_eff_hash, src, caller_eff)
      }
      35 -> check_imported_unsafe_raw_expr(tt, node_f1(node), src, caller_eff)
      36 -> {
        let call_node = node_f2(node)
        let target_errors = if node_tag(call_node) == 4 { check_got_call_known(call_node, src) + check_imported_raw_call_sealed(call_node, src) + check_imported_source_trust_grant_sealed(tt, call_node, src) } else { 0 }
        target_errors + check_imported_unsafe_raw_expr_list(tt, generic_call_inner_args(call_node), generic_call_inner_arg_count(call_node), src, caller_eff)
      }
      37 -> check_imported_unsafe_raw_expr(tt, node_f1(node), src, caller_eff)
      41 -> check_imported_unsafe_raw_expr(tt, node_f1(node), src, caller_eff) + check_imported_unsafe_raw_expr_list(tt, node_f3(node), nlist_len(node_f3(node)), src, caller_eff)
      45 -> check_imported_unsafe_raw_expr(tt, node_f1(node), src, caller_eff)
      46 -> check_imported_unsafe_raw_expr(tt, node_f1(node), src, caller_eff) + check_imported_unsafe_raw_expr(tt, node_f2(node), src, caller_eff)
      47 -> check_imported_unsafe_raw_expr(tt, node_f3(node), src, caller_eff) + check_imported_unsafe_raw_expr(tt, node_f4(node), src, caller_eff)
      48 -> check_imported_unsafe_raw_expr(tt, node_f1(node), src, caller_eff)
      49 -> check_imported_unsafe_raw_expr(tt, node_f1(node), src, caller_eff)
      52 -> check_imported_unsafe_raw_expr(tt, node_f1(node), src, caller_eff) + check_imported_unsafe_raw_expr(tt, node_f2(node), src, caller_eff)
      55 -> check_imported_pointer_surface_sealed(node, src) + check_imported_unsafe_raw_expr(tt, node_f2(node), src, caller_eff)
      56 -> check_imported_pointer_surface_sealed(node, src) + check_imported_unsafe_raw_expr(tt, node_f1(node), src, caller_eff)
      _ -> 0
    }
  }
}

pub(package) fn check_imported_unsafe_raw_fns(fns: i64, user_src: i64, tt: i64) -[Diagnose]> i64 {
  let mut errors = 0
  let n = nlist_len(fns)
  for i in 0..n {
    let pair = nlist_get(fns, i)
    let fn_src = node_f2(pair)
    if fn_src != user_src {
      if ttable_source_is_trusted(tt, fn_src) == 1 {
        errors = errors
      } else {
        let fn_wrap = node_f1(pair)
        let inner = fn_inner(fn_wrap)
        errors = errors + check_imported_unsafe_raw_expr(tt, node_f4(inner), fn_src, fn_effects(fn_wrap))
      }
    } else { errors = errors }
  }
  errors
}

pub(package) fn check_strict_root_unsafe_raw_fns(fns: i64, user_src: i64, tt: i64) -[Diagnose]> i64 {
  if ttable_source_is_strict(tt, user_src) == 1 and ttable_source_is_trusted(tt, user_src) == 0 {
    let mut errors = 0
    let n = nlist_len(fns)
    for i in 0..n {
      let pair = nlist_get(fns, i)
      let fn_src = node_f2(pair)
      if fn_src == user_src {
        let fn_wrap = node_f1(pair)
        let inner = fn_inner(fn_wrap)
        errors = errors + check_imported_unsafe_raw_expr(tt, node_f4(inner), fn_src, fn_effects(fn_wrap))
      } else { errors = errors }
    }
    errors
  } else { 0 }
}

-- Variant name lookups prefer a declaration in the caller's own source
-- (local shadows imported), falling back to first declaration in table
-- order. field selects the per-variant payload count (offset 24) or the
-- per-type tparams (entry offset 40); mode 0 returns the variant field,
-- mode 1 the entry field.
-- Variant lookup goes through a name-hash index (open-addressed,
-- 32-byte entries [name_hash, ti, vi, entry_src]) built lazily and
-- rebuilt whenever the type-entry count changes. Probe order matches
-- the old linear scan's first-match order for equal names: entries
-- insert in table order and lookups walk the same chain. The
-- local-shadows-imported preference stays in the callers' two-pass
-- (same_src_only) structure.
pub(package) fn ttable_variant_index_build(tt: i64) -> i64 {
  let n = mem_load64_at(tt, 8)
  let d = mem_load64_at(tt, 0)
  let mut total = 0
  let mut ti = 0
  while ti < n {
    if mem_load64_at(d, ti * 64 + 16) == 1 { total = total + mem_load64_at(d, ti * 64 + 24) } else { 0 }
    ti = ti + 1
  }
  let mut slots = 512
  while slots < total * 4 { slots = slots * 2 }
  let idx = alloc_words((16 + slots * 32 + 7) / 8)
  mem_store64_at(idx, 0, slots)
  mem_store64_at(idx + 8, 0, n)
  ti = 0
  while ti < n {
    if mem_load64_at(d, ti * 64 + 16) == 1 {
      let entry_src = mem_load64_at(d, ti * 64 + 48)
      let nvariants = mem_load64_at(d, ti * 64 + 24)
      let variants = mem_load64_at(d, ti * 64 + 32)
      let mut vi = 0
      while vi < nvariants {
        let v_ns = mem_load64_at(variants, vi * 40)
        let v_nl = mem_load64_at(variants, vi * 40 + 8)
        let h = str_hash(entry_src, v_ns, v_nl)
        let mut slot = h band (slots - 1)
        while mem_load64_at(idx + 16 + slot * 32, 0) != 0 { slot = (slot + 1) band (slots - 1) }
        mem_store64_at(idx + 16 + slot * 32, 0, h)
        mem_store64_at(idx + 16 + slot * 32 + 8, 0, ti)
        mem_store64_at(idx + 16 + slot * 32 + 16, 0, vi)
        mem_store64_at(idx + 16 + slot * 32 + 24, 0, entry_src)
        vi = vi + 1
      }
    } else { 0 }
    ti = ti + 1
  }
  idx
}

pub(package) fn ttable_variant_index(tt: i64) -> i64 {
  let idx = mem_load64_at(tt + 80, 0)
  if idx != 0 and mem_load64_at(idx + 8, 0) == mem_load64_at(tt, 8) { idx }
  else {
    let fresh = ttable_variant_index_build(tt)
    mem_store64_at(tt + 80, 0, fresh)
    fresh
  }
}

pub(package) fn ttable_variant_scan(tt: i64, src: i64, ns: i64, nl: i64, same_src_only: i64, mode: i64, missing: i64) -> i64 {
  let idx = ttable_variant_index(tt)
  let slots = mem_load64_at(idx, 0)
  let d = mem_load64_at(tt, 0)
  let h = str_hash(src, ns, nl)
  let mut slot = h band (slots - 1)
  let mut probes = 0
  let mut result = missing
  let mut done = 0
  while done == 0 and probes < slots {
    let key = mem_load64_at(idx + 16 + slot * 32, 0)
    if key == 0 { done = 1 }
    else {
      if key == h {
        let entry_src = mem_load64_at(idx + 16 + slot * 32 + 24, 0)
        if same_src_only == 0 or entry_src == src {
          let ti = mem_load64_at(idx + 16 + slot * 32 + 8, 0)
          let vi = mem_load64_at(idx + 16 + slot * 32 + 16, 0)
          let variants = mem_load64_at(d, ti * 64 + 32)
          let v_ns = mem_load64_at(variants, vi * 40)
          let v_nl = mem_load64_at(variants, vi * 40 + 8)
          if v_nl == nl and src_eq_at(src, ns, entry_src + v_ns, 0, nl) == 1 {
            -- mode 0: payload count; 1: owner tparams; 2: variant
            -- record address; 3: owner entry address.
            result = if mode == 0 { mem_load64_at(variants, vi * 40 + 24) }
              else { if mode == 1 { mem_load64_at(d, ti * 64 + 40) }
              else { if mode == 2 { variants + vi * 40 }
              else { d + ti * 64 } } }
            done = 1
          } else { 0 }
        } else { 0 }
      } else { 0 }
      if done == 0 {
        slot = (slot + 1) band (slots - 1)
        probes = probes + 1
      } else { 0 }
    }
  }
  result
}

pub(package) fn ttable_variant_payload_count(tt: i64, src: i64, ns: i64, nl: i64) -> i64 {
  if tt == 0 { 0 - 1 }
  else {
    let local = ttable_variant_scan(tt, src, ns, nl, 1, 0, 0 - 1)
    if local != 0 - 1 { local }
    else { ttable_variant_scan(tt, src, ns, nl, 0, 0, 0 - 1) }
  }
}

pub(package) fn ttable_variant_tparams(tt: i64, src: i64, ns: i64, nl: i64) -> i64 {
  if tt == 0 { 0 }
  else {
    -- Resolve which TYPE owns the variant with local-shadows-imported
    -- preference; payload-count success implies the same entry wins here.
    let local = if ttable_variant_scan(tt, src, ns, nl, 1, 0, 0 - 1) != 0 - 1 { 1 } else { 0 }
    if local == 1 { ttable_variant_scan(tt, src, ns, nl, 1, 1, 0) }
    else { ttable_variant_scan(tt, src, ns, nl, 0, 1, 0) }
  }
}

pub(package) fn typeck_record_binding_fact(tt: i64, src: i64, ns: i64, nl: i64, ty: i64, kind: i64, env: i64) -> i64 {
  ttable_add_semantic_symbol_fact(tt, src, ns, nl, src, ns, nl, ty, ttable_get_tparams(tt), kind, env, 0)
}

pub(package) fn typeck_record_symbol_use(tt: i64, ft: i64, env: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let local = tenv_find_entry(env, src, ns, nl)
  if local != 0 {
    ttable_add_semantic_symbol_fact(
      tt,
      src,
      ns,
      nl,
      tenv_entry_source(local),
      tenv_entry_name_start(local),
      tenv_entry_name_len(local),
      tenv_entry_type(local),
      ttable_get_tparams(tt),
      tenv_entry_kind(local),
      env,
      0
    )
  } else {
    let constant_decl = typeck_constant_decl_for_ident(tt, src, ns, nl)
    if constant_decl != 0 {
      let constant = module_decl_fact_constant_fact(constant_decl)
      let def_src = module_decl_fact_source(constant_decl)
      ttable_add_semantic_symbol_fact(
        tt, src, ns, nl,
        def_src, module_decl_fact_name_ptr(constant_decl) - def_src, module_decl_fact_name_len(constant_decl),
        module_constant_fact_declared_type(constant), 0, semantic_symbol_kind_constant(), env, constant_decl
      )
    } else {
      let entry = ftypes_find(ft, src, ns, nl)
      if entry == 0 { 0 }
      else {
      let decl = ftypes_entry_decl_fact(entry)
      let def_src = if decl == 0 { ftypes_entry_source(entry) } else { module_decl_fact_source(decl) }
      let def_start = if decl == 0 { ftypes_entry_name_start(entry) } else { module_decl_fact_name_ptr(decl) - def_src }
      let def_len = if decl == 0 { ftypes_entry_name_len(entry) } else { module_decl_fact_name_len(decl) }
      let decl_entry = if decl == 0 { 0 } else { ttable_lookup_decl_fact(tt, decl) }
      let kind = if decl != 0 and (module_decl_fact_namespace(decl) == module_decl_namespace_constructor() or (decl_entry != 0 and mem_load64_at(decl_entry, 16) == 5)) {
        semantic_symbol_kind_constructor()
      } else { semantic_symbol_kind_function() }
      ttable_add_semantic_symbol_fact(tt, src, ns, nl, def_src, def_start, def_len, ftypes_entry_fn_type(entry), ftypes_entry_tparams(entry), kind, env, 0)
      }
    }
  }
}

pub(package) fn typeck_record_qualified_constant_use(tt: i64, env: i64, src: i64, node: i64, decl: i64) -> i64 {
  let constant = module_decl_fact_constant_fact(decl)
  let def_src = module_decl_fact_source(decl)
  ttable_add_semantic_symbol_fact(
    tt, src, node_f2(node), node_f3(node),
    def_src, module_decl_fact_name_ptr(decl) - def_src, module_decl_fact_name_len(decl),
    module_constant_fact_declared_type(constant), 0, semantic_symbol_kind_constant(), env, decl
  )
}

-- A qualified call carries an expression node in f1, not a source offset.
-- Keep its symbol fact on the member spelling and resolve the definition by
-- declaration identity; feeding f1/f2 to the bare-name recorder turns the
-- AST pointer into an invalid source address.
pub(package) fn typeck_record_qualified_call_symbol_use(tt: i64, ft: i64, env: i64, src: i64, call_node: i64) -> i64 {
  let decl = typeck_resolve_qualified_call(call_node, env, src, tt)
  let entry = ftypes_find_decl(ft, decl)
  if decl == 0 or entry == 0 { 0 }
  else {
    let def_src = module_decl_fact_source(decl)
    let kind = if module_decl_fact_namespace(decl) == module_decl_namespace_constructor() {
      semantic_symbol_kind_constructor()
    } else { semantic_symbol_kind_function() }
    ttable_add_semantic_symbol_fact(
      tt,
      src,
      node_f2(call_node),
      node_f3(call_node),
      def_src,
      module_decl_fact_name_ptr(decl) - def_src,
      module_decl_fact_name_len(decl),
      ftypes_entry_fn_type(entry),
      ftypes_entry_tparams(entry),
      kind,
      env,
      0
    )
  }
}

pub(package) fn typeck_record_generic_call_symbol_use(tt: i64, ft: i64, env: i64, src: i64, call_node: i64) -> i64 {
  if node_tag(call_node) == 32 { typeck_record_qualified_call_symbol_use(tt, ft, env, src, call_node) }
  else { typeck_record_symbol_use(tt, ft, env, src, node_f1(call_node), node_f2(call_node)) }
}

pub(package) fn typeck_record_function_definition(tt: i64, ft: i64, src: i64, ns: i64, nl: i64, env: i64) -> i64 {
  let entry = ftypes_find(ft, src, ns, nl)
  if entry == 0 { 0 }
  else {
    ttable_add_semantic_symbol_fact(tt, src, ns, nl, src, ns, nl, ftypes_entry_fn_type(entry), ftypes_entry_tparams(entry), semantic_symbol_kind_function(), env, 0)
  }
}

pub(package) fn check_ident_defined(node: i64, env: i64, ft: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  let ns = node_f1(node)
  let nl = node_f2(node)
  if tenv_lookup(env, src, ns, nl) != 0 { 0 }
  else { if typeck_constant_decl_for_ident(tt, src, ns, nl) != 0 { 0 }
  else {
    let declared_fn_ty = ftypes_lookup_fn_type(ft, src, ns, nl)
    if declared_fn_ty != 0 {
      if typeck_fn_type_has_open_structural_shape(declared_fn_ty) == 1 {
        typeck_error_maybe(src, ns, "type error: shape-polymorphic function cannot cross an opaque function-value boundary")
        1
      } else { 0 }
    }
    else {
      if ttable_variant_payload_count(tt, src, ns, nl) == 0 { 0 }
      else {
        if module_scope_problem_is_diagnosed(tt, src, src, ns, nl) == 0 {
          typeck_report_unknown_name(src, ns, nl, env, ft, tt, 0)
          1
        } else { 0 }
      }
    }
  } }
}

pub(package) fn typeck_expected_callable_type(arity: i64) -> i64 {
  let params = nlist_new()
  for i in 0..arity { nlist_add(params, ty_any()) }
  ty_fn(params, ty_any(), ty_effect_pure())
}

pub(package) fn typeck_report_non_callable(node: i64, found_ty: i64, src: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  Diagnose.report(typeck_type_mismatch_diagnostic_with_reason(
    src,
    node_f1(node),
    node_f2(node),
    typeck_expected_callable_type(node_f4(node)),
    found_ty,
    "called value",
    DiagnosticLocationNone,
    tt,
    "non_callable"
  ))
}

pub(package) fn check_call_defined(node: i64, env: i64, ft: i64, src: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let ns = node_f1(node)
  let nl = node_f2(node)
  if weak_ref_name(src, ns, nl) == 1 or weak_load_name(src, ns, nl) == 1 { 0 }
  else { if is_got_call_name(src, ns, nl) {
    check_got_call_known(node, src)
  }
  else { if is_intrinsic_name(src, ns, nl) == 1 and is_known_intrinsic_name(src, ns, nl) == 1 { 0 }
  else {
    let local_ty = tenv_lookup(env, src, ns, nl)
    if local_ty != 0 {
      if ty_tag(local_ty) == 6 { 0 }
      else { if ty_tag(local_ty) == 14 { 0 }
      else {
        typeck_report_non_callable(node, local_ty, src, tt)
        1
      } }
    } else {
      if ftypes_lookup_params(ft, src, ns, nl) != 0 { 0 }
      else {
        let constant_decl = typeck_constant_decl_for_ident(tt, src, ns, nl)
        if constant_decl != 0 {
          typeck_report_non_callable(node, module_constant_fact_declared_type(module_decl_fact_constant_fact(constant_decl)), src, tt)
          1
        } else {
          let type_decl = module_scope_lookup_declaration(tt, src, module_decl_namespace_type(), src, ns, nl)
          let type_entry = ttable_lookup_decl_fact(tt, type_decl)
          if type_entry != 0 and mem_load64_at(type_entry, 16) == 5 {
            typeck_error(src, ns, "type error: opaque constructor is private to its declaring module; use an exported factory")
            1
          } else { if module_scope_problem_is_diagnosed(tt, src, src, ns, nl) == 0 {
            typeck_report_unknown_name(src, ns, nl, env, ft, tt, 1)
            1
          } else { 0 } }
        }
      }
    }
  } }
  }
}

pub(package) fn check_generic_call_target_defined(node: i64, env: i64, ft: i64, src: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let ns = node_f1(node)
  let nl = node_f2(node)
  let local_ty = tenv_lookup(env, src, ns, nl)
  if local_ty != 0 {
    if ty_tag(local_ty) == 6 {
      typeck_error(src, ns, "type error: generic call target is not generic")
      1
    } else {
      typeck_report_non_callable(node, local_ty, src, tt)
      1
    }
  } else {
    let variant_payload_count = ttable_variant_payload_count(tt, src, ns, nl)
    if variant_payload_count >= 0 {
      if ttable_variant_tparams(tt, src, ns, nl) != 0 {
        0
      } else {
        typeck_error(src, ns, "type error: generic call target is not generic")
        1
      }
    } else {
      let constant_decl = typeck_constant_decl_for_ident(tt, src, ns, nl)
      if constant_decl != 0 {
        typeck_report_non_callable(node, module_constant_fact_declared_type(module_decl_fact_constant_fact(constant_decl)), src, tt)
        1
      } else { if ftypes_lookup_params(ft, src, ns, nl) != 0 {
        typeck_error(src, ns, "type error: generic call target is not generic")
        1
      } else {
        if module_scope_problem_is_diagnosed(tt, src, src, ns, nl) == 0 {
          typeck_report_unknown_name(src, ns, nl, env, ft, tt, 1)
          1
        } else { 0 }
      } }
    }
  }
}

pub(package) fn check_field_access(node: i64, env: i64, ft: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  let base = node_f1(node)
  let field_ns = node_f2(node)
  let field_nl = node_f3(node)
  let raw_base_ty = synth(base, env, ft, src, tt)
  let base_ty = if ty_is_borrow(raw_base_ty) { ty_borrow_inner(raw_base_ty) }
    else { if ty_is_owned(raw_base_ty) { ty_owned_inner(raw_base_ty) }
    else { if ty_is_unique(raw_base_ty) { ty_unique_inner(raw_base_ty) } else { raw_base_ty } } }
  let tag = ty_tag(base_ty)
  if typeck_resolve_indexed_len(node, base_ty, src, field_ns, field_nl) == 1 { 0 }
  else { if tag == 7 {
    let resolved_field_ty = synth_field_access(node, env, ft, src, tt)
    let positional = field_access_is_tuple_position(field_nl)
    let tuple = ty_record_tuple_kind(base_ty) == 1
    let field_hash = field_access_key(src, field_ns, field_nl)
    let field = ty_record_field_by_hash(ty_record_fields(base_ty), field_hash)
    if tuple and positional == 0 {
      typeck_error(src, field_ns, "type error: tuple positions use numeric labels")
      1
    } else { if not tuple and positional == 1 {
      typeck_error(src, field_ns, "type error: tuple position access on non-tuple record")
      1
    } else { if field == 0 {
      if tuple { typeck_error(src, field_ns, "type error: unknown tuple position") }
      else { typeck_error(src, field_ns, "type error: unknown structural record field") }
      1
    } else {
      if tuple {
        let use_len = field_access_source_len(field_nl)
        ttable_add_semantic_symbol_fact(
          tt, src, field_ns, use_len, src, field_ns, use_len,
          ty_record_field_type(field), ttable_get_tparams(tt),
          semantic_symbol_kind_tuple_position(), env,
          field_access_tuple_position(src, field_ns, field_nl)
        )
      } else { 0 }
      0
    } } }
  } else { if tag == 9 {
    if field_access_is_tuple_position(field_nl) == 1 {
      typeck_error(src, field_ns, "type error: tuple position access on non-tuple record")
      1
    } else {
      let resolved_field_ty = synth_field_access(node, env, ft, src, tt)
      let idx = ttable_find_field_by_type_hash(tt, ty_f1(base_ty), src, field_ns, field_nl)
      if idx >= 0 { 0 }
      else {
        typeck_error(src, field_ns, "type error: unknown field")
        1
      }
    }
  } else { if ty_is_array(base_ty) or ty_is_slice(base_ty) {
    typeck_error(src, field_ns, "type error: unknown indexed-storage field; arrays and slices expose .len")
    1
  } else {
    if tag == 1 { 0 }
    else {
      typeck_error(src, field_ns, "type error: field access on non-record")
      1
    }
  } } } }
}

pub(package) fn check_module_member_resolution(base: i64, member_ns: i64, member_nl: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  let entry = module_scope_lookup_qualified_entry(tt, src, src, node_f1(base), node_f2(base), src, member_ns, member_nl)
  let resolution = module_resolve_qualified_name(tt, src, src, node_f1(base), node_f2(base), src, member_ns, member_nl)
  if entry != 0 and module_scope_entry_is_diagnosed(entry) == 1 { 0 }
  else {
    let declaration = if entry == 0 { 0 } else { module_scope_entry_target(entry) }
    let type_entry = if declaration == 0 { 0 } else { ttable_lookup_decl_fact(tt, declaration) }
    if type_entry != 0 and mem_load64_at(type_entry, 16) == 5 {
      typeck_error(src, member_ns, "type error: opaque constructor is private to its declaring module; use an exported factory")
      1
    } else {
      Diagnose.report(module_diagnostic_qualified_member(resolution, entry, src, node_f1(base), node_f2(base), member_ns, member_nl))
      1
    }
  }
}

pub(package) fn check_qualified_function_ref(node: i64, env: i64, ft: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  let decl = typeck_resolve_module_member_access(node, env, src, tt)
  if decl == 0 { check_module_member_resolution(node_f1(node), node_f2(node), node_f3(node), src, tt) }
  else {
    let entry = ftypes_find_decl(ft, decl)
    let fn_ty = if module_decl_fact_namespace(decl) == module_decl_namespace_constructor() and nlist_len(ftypes_entry_params(entry)) == 0 {
      ftypes_entry_return_type(entry)
    } else { ftypes_entry_fn_type(entry) }
    if fn_ty == 0 {
      typeck_error(src, node_f2(node), "type error: module member is not a function value")
      1
    } else { if typeck_fn_type_has_open_structural_shape(fn_ty) == 1 {
      typeck_error_maybe(src, node_f2(node), "type error: shape-polymorphic function cannot cross an opaque function-value boundary")
      1
    } else { 0 } }
  }
}

-- A bare generic call may remain symbolic inside another generic body when
-- every callee parameter can be recovered from value arguments after the
-- caller is specialized. A parameter absent from the value contract can
-- never be recovered that way and therefore requires explicit type args.
pub(package) fn call_params_cover_tparams(params: i64, tparams: i64) -> bool {
  if tparams == 0 { true }
  else {
    let mut covered = true
    let mut ti = 0
    while ti < nlist_len(tparams) and covered {
      let var_id = node_f3(nlist_get(tparams, ti))
      let mut found = false
      let mut pi = 0
      while pi < nlist_len(params) and not found {
        if impl_target_mentions_var(node_f3(nlist_get(params, pi)), var_id) {
          found = true
        } else {
          pi = pi + 1
        }
      }
      if found { ti = ti + 1 } else { covered = false }
    }
    covered
  }
}

pub(package) fn call_entry_is_constructor(entry: i64) -> bool {
  let declaration = ftypes_entry_decl_fact(entry)
  declaration != 0 and module_decl_fact_namespace(declaration) == module_decl_namespace_constructor()
}

pub(package) fn check_qualified_call_declared(node: i64, entry: i64, env: i64, ft: i64, src: i64, caller_eff: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let args = node_f4(node)
  let nargs = nlist_len(args)
  let params = ftypes_entry_params(entry)
  let member_ns = node_f2(node)
  let mut errors = 0
  if entry == 0 {
    let declaration = typeck_qualified_call_declaration(node)
    let type_entry = if declaration == 0 { 0 } else { ttable_lookup_decl_fact(tt, declaration) }
    if type_entry != 0 and mem_load64_at(type_entry, 16) == 5 {
      typeck_error(src, member_ns, "type error: opaque constructor is private to its declaring module; use an exported factory")
      errors = errors + 1
    } else {
      let lhs = node_f1(node)
      let base = if node_tag(lhs) == 13 { node_f1(lhs) } else { lhs }
      errors = errors + check_module_member_resolution(base, member_ns, node_f3(node), src, tt)
    }
  } else {
    errors = errors + check_arity(nlist_len(params), nargs, src, member_ns)
    let callee_eff = ftypes_entry_effects(entry)
    errors = errors + check_effect_sig_available(
      callee_eff, src, member_ns, node_f3(node), caller_eff, tt, "call",
      typeck_source_location(ftypes_entry_source(entry), ftypes_entry_name_start(entry), ftypes_entry_name_len(entry))
    )
    for i in 0..nargs {
      if i < nlist_len(params) {
        let param = nlist_get(params, i)
        let param_ty = node_f3(param)
        if param_ty != 0 {
          errors = errors + check_arg_against_direct_param_mode_at(
            nlist_get(args, i), param_ty, env, ft, src, tt, member_ns, 0,
            typeck_source_location(ftypes_entry_source(entry), node_f1(param), node_f2(param))
          )
        } else { 0 }
      } else { 0 }
    }
    errors = errors + check_borrow_call_conflicts(args, nargs, src, member_ns)
    errors = errors + check_native_result_abi_ty(src, member_ns, ftypes_entry_return_type(entry))
  }
  errors
}

pub(package) fn check_address_of(node: i64, env: i64, ft: i64, src: i64, caller_eff: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let target = node_f2(node)
  let mutable = node_f1(node)
  let mut errors = check_effect_hash_available(effect_hash_unsafe(), src, expr_diag_pos(node), caller_eff, tt, "unsafe operation") + check_expr(target, env, ft, src, caller_eff, tt)
  if node_tag(target) != 2 {
    typeck_error_maybe(src, expr_diag_pos(target), "type error: address-of target must be a binding")
    errors = errors + 1
  } else { if mutable == 1 {
    if tenv_lookup_mutable(env, src, node_f1(target), node_f2(target)) != 1 {
      typeck_error_maybe(src, expr_diag_pos(target), "type error: cannot take mutable pointer to immutable binding")
      errors = errors + 1
    } else { errors = errors }
  } else { errors = errors } }
  errors
}

pub(package) fn check_deref(node: i64, env: i64, ft: i64, src: i64, caller_eff: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let ptr = node_f1(node)
  let mut errors = check_effect_hash_available(effect_hash_unsafe(), src, expr_diag_pos(node), caller_eff, tt, "unsafe operation") + check_expr(ptr, env, ft, src, caller_eff, tt)
  let ptr_ty = synth(ptr, env, ft, src, tt)
  if type_is_unknown_or_any(ptr_ty) { errors }
  else { if ty_is_ptr(ptr_ty) == 1 { errors }
  else {
    typeck_error_maybe(src, expr_diag_pos(ptr), "type error: dereference of non-pointer")
    errors + 1
  } }
}

pub(package) fn check_ptr_assign(node: i64, env: i64, ft: i64, src: i64, caller_eff: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let ptr = node_f1(node)
  let val = node_f2(node)
  let mut errors = check_effect_hash_available(effect_hash_unsafe(), src, expr_diag_pos(node), caller_eff, tt, "unsafe operation") + check_expr(ptr, env, ft, src, caller_eff, tt) + check_expr(val, env, ft, src, caller_eff, tt)
  let ptr_ty = synth(ptr, env, ft, src, tt)
  if type_is_unknown_or_any(ptr_ty) { errors }
  else { if ty_is_ptr(ptr_ty) != 1 {
    typeck_error_maybe(src, expr_diag_pos(ptr), "type error: dereference of non-pointer")
    errors + 1
  } else { if ty_ptr_mutable(ptr_ty) != 1 {
    typeck_error_maybe(src, expr_diag_pos(ptr), "type error: cannot write through immutable pointer")
    errors + 1
  } else {
    let target_ty = ty_ptr_inner(ptr_ty)
    prepare_expr_contextual(val, target_ty, env, ft, src, tt)
    let val_ty = synth(val, env, ft, src, tt)
    if type_is_unknown_or_any(target_ty) { errors }
    else { if type_is_unknown_or_any(val_ty) and ty_contains_opaque(target_ty) == 0 { errors }
    else { if expr_matches_type_contextual(val, val_ty, target_ty, src, ft) == 1 { errors }
    else {
      typeck_report_expr_type_mismatch(src, val, target_ty, val_ty, "pointer assignment", typeck_source_location(src, expr_diag_pos(ptr), expr_diag_len(ptr)), tt)
      errors + 1
    } } }
  } } }
}

pub(package) fn check_indexed_get(node: i64, env: i64, ft: i64, src: i64, caller_eff: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let base = node_f1(node)
  let index = node_f2(node)
  let mut errors = check_expr(base, env, ft, src, caller_eff, tt) + check_expr(index, env, ft, src, caller_eff, tt)
  let raw_base_ty = synth(base, env, ft, src, tt)
  let base_ty = if ty_is_borrow(raw_base_ty) { ty_borrow_inner(raw_base_ty) } else { raw_base_ty }
  if type_is_unknown_or_any(base_ty) { errors = errors }
  else { if ty_is_array(base_ty) == 0 and ty_is_slice(base_ty) == 0 {
    typeck_error_maybe(src, expr_diag_pos(base), "type error: indexing requires an array or slice")
    errors = errors + 1
  } else { synth_indexed_get(node, env, ft, src, tt) } }
  prepare_expr_contextual(index, ty_usize(), env, ft, src, tt)
  let index_ty = synth(index, env, ft, src, tt)
  if type_is_unknown_or_any(index_ty) { errors }
  else { if expr_matches_type_contextual(index, index_ty, ty_usize(), src, ft) == 1 { errors }
  else {
    typeck_error_maybe(src, expr_diag_pos(index), "type error: index must be usize")
    errors + 1
  } }
}

pub(package) fn check_indexed_slice_bound(bound: i64, env: i64, ft: i64, src: i64, caller_eff: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  if node_tag(bound) == 51 { 0 }
  else {
    let mut errors = check_expr(bound, env, ft, src, caller_eff, tt)
    prepare_expr_contextual(bound, ty_usize(), env, ft, src, tt)
    let bound_ty = synth(bound, env, ft, src, tt)
    if type_is_unknown_or_any(bound_ty) { errors }
    else { if expr_matches_type_contextual(bound, bound_ty, ty_usize(), src, ft) == 1 { errors }
    else {
      typeck_error_maybe(src, expr_diag_pos(bound), "type error: slice bound must be usize")
      errors + 1
    } }
  }
}

pub(package) fn check_indexed_slice(node: i64, env: i64, ft: i64, src: i64, caller_eff: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let base = node_f1(node)
  let mut errors = check_expr(base, env, ft, src, caller_eff, tt)
  errors = errors + check_indexed_slice_bound(node_f2(node), env, ft, src, caller_eff, tt)
  errors = errors + check_indexed_slice_bound(node_f3(node), env, ft, src, caller_eff, tt)
  let raw_base_ty = synth(base, env, ft, src, tt)
  let base_ty = if ty_is_borrow(raw_base_ty) { ty_borrow_inner(raw_base_ty) } else { raw_base_ty }
  if type_is_unknown_or_any(base_ty) { errors }
  else { if ty_is_array(base_ty) == 0 and ty_is_slice(base_ty) == 0 and typeck_type_is_vector(tt, base_ty) == 0 {
    typeck_error_maybe(src, expr_diag_pos(base), "type error: slicing requires an array, slice, or Vector")
    errors + 1
  } else { if (ty_is_array(base_ty) or typeck_type_is_vector(tt, base_ty) == 1) and node_tag(base) != 2 {
    -- A slice is deliberately only (data, len): it does not retain its
    -- owner. Until expression-temporary lifetime extension is a shared
    -- ownership fact, borrowing array storage therefore requires a binding
    -- whose lifetime the source borrow checker can name and verify.
    typeck_error_maybe(src, expr_diag_pos(base), "type error: slicing an owning container temporary requires a named owner binding")
    errors + 1
  } else {
    synth_indexed_slice(node, env, ft, src, tt)
    let fact = node_f4(node)
    let wants_mutable = if fact == 0 { 0 } else { node_f4(fact) }
    if wants_mutable == 0 { errors }
    else { if node_tag(base) != 2 {
      typeck_error_maybe(src, expr_diag_pos(base), "type error: mutable slicing requires a named container binding")
      errors + 1
    } else { if ty_is_array(base_ty) and tenv_lookup_mutable(env, src, node_f1(base), node_f2(base)) != 1 {
      typeck_error_maybe(src, expr_diag_pos(base), "type error: cannot mutably slice immutable array binding")
      errors + 1
    } else { if ty_is_slice(base_ty) and ty_slice_mutable(base_ty) != 1 {
      typeck_error_maybe(src, expr_diag_pos(base), "type error: cannot mutably reborrow immutable slice")
      errors + 1
    } else { errors } } }
  } } } }
}

pub(package) fn check_indexed_set(node: i64, env: i64, ft: i64, src: i64, caller_eff: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let base = node_f1(node)
  let index = node_f2(node)
  let value = node_f3(node)
  let mut errors = check_expr(base, env, ft, src, caller_eff, tt) + check_expr(index, env, ft, src, caller_eff, tt) + check_expr(value, env, ft, src, caller_eff, tt)
  let base_ty = synth(base, env, ft, src, tt)
  let mut element_ty = ty_any()
  let mut fixed_len = 0 - 1
  if type_is_unknown_or_any(base_ty) { errors = errors }
  else { if ty_is_array(base_ty) == 0 and ty_is_slice(base_ty) == 0 {
    typeck_error_maybe(src, expr_diag_pos(base), "type error: indexed mutation requires an array or mutable slice")
    errors = errors + 1
  } else {
    element_ty = if ty_is_array(base_ty) { ty_array_inner(base_ty) } else { ty_slice_inner(base_ty) }
    fixed_len = if ty_is_array(base_ty) { ty_array_length(base_ty) } else { 0 - 1 }
    if node_tag(base) != 2 {
      typeck_error_maybe(src, expr_diag_pos(base), "type error: indexed mutation requires a named container binding")
      errors = errors + 1
    } else { if ty_is_array(base_ty) and tenv_lookup_mutable(env, src, node_f1(base), node_f2(base)) != 1 {
      typeck_error_maybe(src, expr_diag_pos(base), "type error: cannot mutate immutable array binding")
      errors = errors + 1
    } else { if ty_is_slice(base_ty) and ty_slice_mutable(base_ty) != 1 {
      typeck_error_maybe(src, expr_diag_pos(base), "type error: cannot mutate through immutable slice")
      errors = errors + 1
    } else { errors = errors } } }
    mem_store64_at(node, 32, node_new(0, element_ty, fixed_len, base_ty, 0))
  } }
  prepare_expr_contextual(index, ty_usize(), env, ft, src, tt)
  let index_ty = synth(index, env, ft, src, tt)
  if type_is_unknown_or_any(index_ty) { errors = errors }
  else { if expr_matches_type_contextual(index, index_ty, ty_usize(), src, ft) == 1 { errors = errors }
  else {
    typeck_error_maybe(src, expr_diag_pos(index), "type error: index must be usize")
    errors = errors + 1
  } }
  prepare_expr_contextual(value, element_ty, env, ft, src, tt)
  let value_ty = synth(value, env, ft, src, tt)
  if type_is_unknown_or_any(element_ty) or type_is_unknown_or_any(value_ty) { errors }
  else { if expr_matches_type_contextual(value, value_ty, element_ty, src, ft) == 1 { errors }
  else {
    typeck_report_expr_type_mismatch(src, value, element_ty, value_ty, "indexed assignment", typeck_source_location(src, expr_diag_pos(base), expr_diag_len(base)), tt)
    errors + 1
  } }
}

pub(package) fn ttable_field_type(entry: i64, entry_src: i64, caller_src: i64, field_ns: i64, field_nl: i64) -> i64 {
  let idx = ttable_field_index(entry, entry_src, caller_src, field_ns, field_nl)
  if idx < 0 { 0 }
  else {
    let fields = mem_load64_at(entry, 32)
    mem_load64_at(fields, idx * 24 + 16)
  }
}

pub(package) fn ttable_lookup_by_type_hash(tt: i64, type_hash: i64) -> i64 {
  if tt == 0 { 0 }
  else {
    let n = mem_load64_at(tt, 8)
    let d = mem_load64_at(tt, 0)
    let mut i = 0
    let mut result = 0
    while i < n {
      let kind = mem_load64_at(d, i * 64 + 16)
      if kind == 0 {
        let entry_src = mem_load64_at(d, i * 64 + 48)
        let type_ns = mem_load64_at(d, i * 64)
        let type_nl = mem_load64_at(d, i * 64 + 8)
        if str_hash(entry_src, type_ns, type_nl) == type_hash {
          result = d + i * 64
          i = n
        } else { i = i + 1 }
      } else { i = i + 1 }
    }
    result
  }
}

pub(package) fn typecheck_resolve_type_in_source(tt: i64, context_src: i64, name_src: i64, name_start: i64, name_len: i64) -> i64 {
  let scoped_declaration = module_scope_lookup_declaration(tt, context_src, module_decl_namespace_type(), name_src, name_start, name_len)
  let entry = ttable_lookup_resolved_decl(tt, context_src, module_decl_namespace_type(), name_src, name_start, name_len)
  if entry == 0 { 0 }
  else {
    let kind = mem_load64_at(entry, 16)
    let declaration = if scoped_declaration != 0 { scoped_declaration }
      else { module_decl_fact_find(tt, mem_load64_at(entry, 48), module_decl_namespace_type(), mem_load64_at(entry, 48), mem_load64_at(entry, 0), mem_load64_at(entry, 8)) }
    if kind == 0 {
      let entry_src = mem_load64_at(entry, 48)
      let ns = mem_load64_at(entry, 0)
      let nl = mem_load64_at(entry, 8)
      ty_named(mem_load64_at(entry, 56), ty_i64())
    } else { if kind == 5 {
      typeck_named_type_from_declaration(tt, declaration, 0)
    } else { 0 }
    }
  }
}

pub(package) fn typecheck_resolve_type(tt: i64, name_src: i64, name_start: i64, name_len: i64) -> i64 {
  typecheck_resolve_type_in_source(tt, name_src, name_src, name_start, name_len)
}

pub(package) fn typecheck_resolve_field_type(tt: i64, base_ty: i64, field_src: i64, field_start: i64, field_len: i64) -> i64 {
  if base_ty == 0 { 0 }
  else { if ty_tag(base_ty) != 9 { 0 }
  else {
    let entry = ttable_lookup_by_type_hash(tt, ty_f1(base_ty))
    if entry == 0 { 0 }
    else {
      let entry_src = mem_load64_at(entry, 48)
      let raw_field_ty = ttable_field_type(entry, entry_src, field_src, field_start, field_len)
      type_cycle_maybe_subst(raw_field_ty, type_cycle_subst_for_entry(entry, ty_f3(base_ty)))
    }
  } }
}

pub(package) fn typecheck_subtype(tt: i64, actual_ty: i64, expected_ty: i64) -> i64 {
  if actual_ty == 0 or expected_ty == 0 { 0 }
  else {
    let projected = if ty_tag(actual_ty) == 9 and ty_is_record(expected_ty) {
      typeck_named_record_projection(tt, actual_ty)
    } else { 0 }
    let compared_actual = if projected != 0 { projected } else { actual_ty }
    let ct = ttable_get_ct(tt)
    handle is_subtype(compared_actual, expected_ty) {
      Conformance.conforms(ty, trh) -> {
        if ct == 0 { resume(0) } else { resume(ctable_conforms_type_atom(ct, ty, trh)) }
      }
    }
  }
}

pub(package) fn record_init_has_literal_field(fields: i64, nfields: i64, src: i64, entry_src: i64, field_ns: i64, field_nl: i64) -> bool {
  let mut found = false
  let mut i = 0
  while i < nfields {
    let field = nlist_get(fields, i)
    if node_f2(field) == field_nl {
      if src_eq_at(src, node_f1(field), entry_src + field_ns, 0, field_nl) == 1 {
        found = true
        i = nfields
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  found
}

pub(package) fn check_record_init_duplicate_fields(fields: i64, nfields: i64, src: i64) -[Diagnose]> i64 {
  let mut errors = 0
  for i in 0..nfields {
    let field = nlist_get(fields, i)
    let f_ns = node_f1(field)
    let f_nl = node_f2(field)
    let mut j = i + 1
    while j < nfields {
      let other = nlist_get(fields, j)
      if node_f2(other) == f_nl {
        if src_eq_at(src, node_f1(other), src + f_ns, 0, f_nl) == 1 {
          typeck_error(src, node_f1(other), "type error: duplicate record field")
          errors = errors + 1
        } else { 0 }
      } else { 0 }
      j = j + 1
    }
  }
  errors
}

pub(package) fn check_record_init_shape(node: i64, env: i64, ft: i64, src: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  if record_init_is_structural(node) {
    let mut errors = if record_init_is_tuple(node) { 0 }
      else { check_record_init_duplicate_fields(node_f3(node), node_f4(node), src) }
    let record_ty = synth_structural_record_init(node, env, ft, src, tt)
    -- A generic structural literal has no concrete lane count until its
    -- monomorphised body substitutes the type variables. Accept that deferred
    -- representation here; lowering must resolve the concrete shape from the
    -- specialization substitution before assigning field offsets.
    if node_f4(node) > 0 and ty_value_storage_word_count(record_ty) <= 0 and ty_mentions_type_var(record_ty) == 0 {
      typeck_error_maybe(src, expr_diag_pos(node), "type error: structural value has no concrete native representation")
      errors = errors + 1
    } else { record_init_write_structural_facts(node, record_ty, src) }
    errors
  } else { if tt == 0 { 0 }
  else {
    let type_ns = node_f1(node)
    let type_nl = node_f2(node)
    let fields = node_f3(node)
    let nfields = node_f4(node)
    let entry = ttable_lookup(tt, src, type_ns, type_nl)
    if entry == 0 {
      typeck_error(src, type_ns, "type error: unknown record type")
      1
    } else {
      let kind = mem_load64_at(entry, 16)
      if kind != 0 {
        typeck_error(src, type_ns, "type error: not a record type")
        1
      } else {
        let mut errors = check_record_init_duplicate_fields(fields, nfields, src)
        let entry_src = mem_load64_at(entry, 48)
        for i in 0..nfields {
          let field = nlist_get(fields, i)
          let idx = ttable_field_index(entry, entry_src, src, node_f1(field), node_f2(field))
          if idx < 0 {
            typeck_error(src, node_f1(field), "type error: unknown record field")
            errors = errors + 1
          } else {
            let expected_ty = ttable_field_type(entry, entry_src, src, node_f1(field), node_f2(field))
            if expected_ty != 0 {
              let value = node_f3(field)
              prepare_expr_contextual(value, expected_ty, env, ft, src, tt)
              let value_ty = synth(value, env, ft, src, tt)
              if expr_matches_type_contextual(value, value_ty, expected_ty, src, ft) != 1 {
                let decl_fields = mem_load64_at(entry, 32)
                let decl_ns = mem_load64_at(decl_fields, idx * 24)
                let decl_nl = mem_load64_at(decl_fields, idx * 24 + 8)
                typeck_report_expr_type_mismatch(src, value, expected_ty, value_ty, "record field", typeck_source_location(entry_src, decl_ns, decl_nl), tt)
                errors = errors + 1
              } else { errors = errors }
            } else { errors = errors }
          }
        }
        let decl_fields = mem_load64_at(entry, 32)
        let decl_count = mem_load64_at(entry, 24)
        for di in 0..decl_count {
          let f_ns = mem_load64_at(decl_fields, di * 24)
          let f_nl = mem_load64_at(decl_fields, di * 24 + 8)
          if not record_init_has_literal_field(fields, nfields, src, entry_src, f_ns, f_nl) {
            typeck_error(src, type_ns, "type error: missing record field")
            errors = errors + 1
          } else { errors = errors }
        }
        errors
      }
    }
  } }
}

pub(package) fn check_record_update_shape(node: i64, env: i64, ft: i64, src: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let base_ty = synth(node_f1(node), env, ft, src, tt)
  let tag = if base_ty == 0 { 0 - 1 } else { ty_tag(base_ty) }
  if tag == 9 {
    let entry = ttable_lookup_by_type_hash(tt, ty_f1(base_ty))
    if entry == 0 or mem_load64_at(entry, 16) != 0 {
      typeck_error_maybe(src, expr_diag_pos(node_f1(node)), "type error: functional update requires a record value")
      1
    } else {
      let fields = node_f2(node)
      let count = node_f3(node)
      let entry_src = mem_load64_at(entry, 48)
      let field_subst = type_cycle_subst_for_entry(entry, ty_f3(base_ty))
      let mut errors = check_record_init_duplicate_fields(fields, count, src)
      for i in 0..count {
        let field = nlist_get(fields, i)
        let field_ns = node_f1(field)
        let field_nl = node_f2(field)
        let raw_ty = ttable_field_type(entry, entry_src, src, field_ns, field_nl)
        if raw_ty == 0 {
          typeck_error_maybe(src, field_ns, "type error: unknown record field in functional update")
          errors = errors + 1
        } else {
          let expected_ty = type_cycle_maybe_subst(raw_ty, field_subst)
          let value = node_f3(field)
          prepare_expr_contextual(value, expected_ty, env, ft, src, tt)
          let value_ty = synth(value, env, ft, src, tt)
          if expr_matches_type_contextual(value, value_ty, expected_ty, src, ft) != 1 {
            let field_index = ttable_field_index(entry, entry_src, src, field_ns, field_nl)
            let decl_fields = mem_load64_at(entry, 32)
            let decl_ns = if field_index < 0 { 0 } else { mem_load64_at(decl_fields, field_index * 24) }
            let decl_nl = if field_index < 0 { 0 } else { mem_load64_at(decl_fields, field_index * 24 + 8) }
            typeck_report_expr_type_mismatch(src, value, expected_ty, value_ty, "record update", typeck_source_location(entry_src, decl_ns, decl_nl), tt)
            errors = errors + 1
          } else {
            let field_hash = record_value_field_hash(field, src)
            let word_offset = typeck_named_record_field_word_offset(entry, base_ty, src, field_ns, field_nl)
            mem_store64_at(field, 32, node_new(1, expected_ty, field_hash, word_offset, 0))
          }
        }
      }
      mem_store64_at(node, 32, node_new(1, base_ty, base_ty, 0, 0))
      errors
    }
  } else { if tag != 7 {
    typeck_error_maybe(src, expr_diag_pos(node_f1(node)), "type error: functional update requires a record value")
    1
  } else { if ty_record_tuple_kind(base_ty) == 1 {
    typeck_error_maybe(src, expr_diag_pos(node_f1(node)), "type error: named-field functional update is not available on tuples")
    1
  } else { if ty_record_open(base_ty) == 1 {
    typeck_error_maybe(src, expr_diag_pos(node_f1(node)), "type error: functional update requires a concrete closed structural shape")
    1
  } else {
    let mut errors = check_record_init_duplicate_fields(node_f2(node), node_f3(node), src)
    let result_ty = synth_record_update(node, env, ft, src, tt)
    if ty_value_storage_word_count(result_ty) <= 0 and ty_mentions_type_var(result_ty) == 0 {
      typeck_error_maybe(src, expr_diag_pos(node), "type error: structural value has no concrete native representation")
      errors = errors + 1
    } else {
      record_update_write_facts(node, base_ty, result_ty, src)
    }
    errors
  } } } }
}

pub(package) fn check_call_fn_type(node: i64, fn_ty: i64, env: i64, ft: i64, src: i64, caller_eff: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let ns = node_f1(node)
  let nl = node_f2(node)
  let args = node_f3(node)
  let nargs = node_f4(node)
  let params = ty_f1(fn_ty)
  let nparams = nlist_len(params)
  let mut errors = check_native_result_abi_ty(src, ns, ty_f2(fn_ty))
  errors = errors + check_arity(nparams, nargs, src, ns)
  let callee_eff = ty_f3(fn_ty)
  let callee_entry = tenv_find_entry(env, src, ns, nl)
  let expected_origin = if callee_entry == 0 {
    typeck_source_location(src, ns, nl)
  } else {
    typeck_source_location(tenv_entry_source(callee_entry), tenv_entry_name_start(callee_entry), tenv_entry_name_len(callee_entry))
  }
  errors = errors + check_effect_sig_available(callee_eff, src, ns, nl, caller_eff, tt, "call", expected_origin)
  for i in 0..nargs {
    if i < nparams {
      errors = errors + check_arg_against_opaque_param(nlist_get(args, i), nlist_get(params, i), env, ft, src, tt, ns, expected_origin)
    } else { errors = errors }
  }
  errors = errors + check_borrow_call_conflicts(args, nargs, src, ns)
  errors
}

pub(package) fn check_call_continuation_type(node: i64, cont_ty: i64, env: i64, ft: i64, src: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let ns = node_f1(node)
  let nl = node_f2(node)
  let args = node_f3(node)
  let nargs = node_f4(node)
  let mut errors = check_native_result_abi_ty(src, ns, ty_f2(cont_ty))
  errors = errors + check_arity(1, nargs, src, ns)
  if nargs > 0 {
    let callee_entry = tenv_find_entry(env, src, ns, nl)
    let expected_origin = if callee_entry == 0 {
      typeck_source_location(src, ns, nl)
    } else {
      typeck_source_location(tenv_entry_source(callee_entry), tenv_entry_name_start(callee_entry), tenv_entry_name_len(callee_entry))
    }
    errors = errors + check_arg_against_param_at(nlist_get(args, 0), ty_f1(cont_ty), env, ft, src, tt, ns, expected_origin)
  } else { errors = errors }
  errors
}


-- Method call on a type-variable receiver, left as tag 32 by synth: check
-- name and arguments against the bound trait's method table without
-- mutating the shared template node.
pub(package) fn check_tyvar_method_call(node: i64, env: i64, ft: i64, src: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let method_hash = effect_name_hash(src, node_f2(node), node_f3(node))
  let lhs = node_f1(node)
  let var_ty = tenv_lookup(env, src, node_f1(lhs), node_f2(lhs))
  let var_id = ty_f1(var_ty)
  let trait_atom = typevar_method_bound_atom(tt, var_id, method_hash)
  if trait_atom == 0 {
    if method_hash == interp_display_hash() {
      typeck_error_maybe(src, node_f2(node), "type error: unknown method 'display' — implement Display for the interpolated type")
    } else {
      typeck_error_maybe(src, node_f2(node), "type error: unknown method")
    }
    1
  }
  else {
    let params = ttable_lookup_trait_method_params_atom(tt, trait_atom, method_hash)
    let trait_entry = ttable_find_entry_by_hash_kind(tt, trait_atom_head(trait_atom), 3)
    let trait_src = if trait_entry == 0 { src } else { ttable_entry_source(trait_entry) }
    let mut errors = 0
    let args = node_f4(node)
    let nargs = nlist_len(args)
    if params != 0 {
      let nparams = nlist_len(params)
      let has_receiver = typeck_method_params_have_receiver(params, trait_src)
      let expected = if has_receiver == 1 { nparams - 1 } else { nparams }
      if has_receiver == 0 {
        typeck_error_maybe(src, node_f2(node), "type error: associated function must be called on a type")
        errors = errors + 1
      } else { errors = errors }
      errors = errors + check_arity(expected, nargs, src, node_f2(node))
      let self_subst = subst_new()
      subst_add(self_subst, 0 - 1, var_ty)
      for i in 0..nargs {
        if i < expected {
          let param = nlist_get(params, i + has_receiver)
          -- Trait signatures retain rigid Self. On a bounded type-variable
          -- receiver it denotes that receiver variable, not an unrelated
          -- unsolved type; substitute before checking method arguments.
          let param_ty = typeck_resolve_bound_associated_type(ty_subst(node_f3(param), self_subst), tt)
          if param_ty != 0 {
            errors = errors + check_arg_against_param_at(
              nlist_get(args, i), param_ty, env, ft, src, tt, node_f2(node),
              typeck_source_location(trait_src, node_f1(param), node_f2(param))
            )
          } else { errors = errors }
        } else { errors = errors }
      }
    } else {
      if method_hash == interp_display_hash() {
        typeck_error_maybe(src, node_f2(node), "type error: unknown method 'display' — implement Display for the interpolated type")
      } else {
        typeck_error_maybe(src, node_f2(node), "type error: unknown method")
      }
      errors = errors + 1
    }
    errors
  }
}

pub(package) fn check_method_call(node: i64, env: i64, ft: i64, src: i64, caller_eff: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let recv = node_f1(node)
  let method_hash = node_f2(node)
  let args = node_f3(node)
  let nargs = nlist_len(args)
  let method_ref = node_f4(node)
  let recv_ty = method_ref_receiver_ty(method_ref)
  let delayed_trait = if method_ref_owner_hash(method_ref) == 0 and ty_tag(recv_ty) == 12 {
    typevar_method_bound_atom(tt, ty_var_id(recv_ty), method_hash)
  } else { 0 }
  let candidate_resolution = if delayed_trait == 0 { ttable_resolve_method(tt, recv_ty, method_ref_owner_hash(method_ref), method_hash) } else { 0 }
  -- Prelude loading imports only its named type/constructor/effect surface.
  -- Inherent methods remain ordinary module API and require an explicit
  -- import; otherwise their signatures would be visible without their code
  -- bodies being part of the caller's compilation unit.
  let resolution = if method_resolution_is_weak_prelude_only(tt, src, candidate_resolution) == 1 { 0 } else { candidate_resolution }
  let params = if delayed_trait != 0 { ttable_lookup_trait_method_params_atom(tt, delayed_trait, method_hash) }
    else { if resolution == 0 { 0 } else { method_resolution_params_for_ref(resolution, method_ref) } }
  let mut errors = 0
  let target_entry = if ty_tag(recv_ty) == 9 { type_cycle_entry_for_hash(tt, ty_f1(recv_ty)) } else { 0 }
  let target_tparams = if target_entry == 0 { 0 } else { mem_load64_at(target_entry, 40) }
  let target_args = if ty_tag(recv_ty) == 9 { ty_f3(recv_ty) } else { 0 }
  let expected_type_args = if target_tparams == 0 { 0 } else { nlist_len(target_tparams) }
  let actual_type_args = if target_args == 0 { 0 } else { nlist_len(target_args) }
  let type_arg_errors = if target_entry != 0 and expected_type_args != actual_type_args {
    typeck_error_maybe(src, expr_diag_pos(recv), "type error: generic type argument count mismatch")
    1
  } else { 0 }
  errors = errors + type_arg_errors
  let method_decl = if resolution == 0 { 0 } else { method_resolution_declaration(resolution) }
  if method_decl != 0 and module_decl_fact_visible_from(tt, method_decl, module_fact_find_source(tt, src)) == 0 {
    typeck_error_maybe(src, expr_diag_pos(recv), "type error: method is not visible")
    errors = errors + 1
  } else { 0 }
  if params != 0 {
    let method_tparams = if resolution == 0 { 0 } else { fn_tparams(method_resolution_method(resolution)) }
    if method_tparams != 0 {
      errors = errors + check_generic_type_arg_count(method_tparams, method_ref_type_args(method_ref), src, expr_diag_pos(recv))
      errors = errors + check_trait_bounds_at(method_tparams, method_ref_type_args(method_ref), src, expr_diag_pos(recv), expr_diag_len(recv), method_resolution_src(resolution), tt, "generic method")
    } else { errors = errors }
    let nparams = nlist_len(params)
    let associated = method_ref_is_associated(method_ref)
    let method_src = if delayed_trait != 0 {
      let trait_entry = ttable_find_entry_by_hash_kind(tt, trait_atom_head(delayed_trait), 3)
      if trait_entry == 0 { src } else { ttable_entry_source(trait_entry) }
    } else { if resolution == 0 { src } else { method_resolution_src(resolution) } }
    let has_receiver = typeck_method_params_have_receiver(params, method_src)
    if associated and has_receiver == 1 {
      typeck_error_maybe(src, expr_diag_pos(recv), "type error: instance method must be called on a value")
      errors = errors + 1
    } else { if not associated and has_receiver == 0 {
      typeck_error_maybe(src, expr_diag_pos(recv), "type error: associated function must be called on a type")
      errors = errors + 1
    } else { errors = errors } }
    let expected = if has_receiver == 1 { nparams - 1 } else { nparams }
    errors = errors + check_arity(expected, nargs, src, expr_diag_pos(recv))
    if not associated and has_receiver == 1 {
      let self_param = nlist_get(params, 0)
      let raw_self_ty = node_f3(self_param)
      let self_ty = if delayed_trait != 0 {
        let self_subst = subst_new()
        subst_add(self_subst, 0 - 1, recv_ty)
        typeck_resolve_bound_associated_type(ty_subst(raw_self_ty, self_subst), tt)
      } else { raw_self_ty }
      if ty_is_borrow(self_ty) {
        let method_src = if method_decl == 0 { src } else { module_decl_fact_source(method_decl) }
        errors = errors + check_arg_against_borrow_param(
          recv, self_ty, env, src, expr_diag_pos(recv),
          typeck_source_location(method_src, node_f1(self_param), node_f2(self_param)), tt
        )
      } else { if ty_is_unique(self_ty) or ty_is_owned(self_ty) {
        let method_src = if method_decl == 0 { src } else { module_decl_fact_source(method_decl) }
        errors = errors + check_arg_against_param_at(
          recv, self_ty, env, ft, src, tt, expr_diag_pos(recv),
          typeck_source_location(method_src, node_f1(self_param), node_f2(self_param))
        )
      } else { 0 } }
    } else { 0 }
    for i in 0..nargs {
      if i < expected {
        let param = nlist_get(params, i + has_receiver)
        let raw_param_ty = node_f3(param)
        let param_ty = if delayed_trait != 0 {
          let self_subst = subst_new()
          subst_add(self_subst, 0 - 1, recv_ty)
          typeck_resolve_bound_associated_type(ty_subst(raw_param_ty, self_subst), tt)
        } else { raw_param_ty }
        if param_ty != 0 {
          let method_src = if method_decl == 0 { src } else { module_decl_fact_source(method_decl) }
          let origin = if method_decl == 0 {
            typeck_source_location(src, expr_diag_pos(recv), expr_diag_len(recv))
          } else { typeck_source_location(method_src, node_f1(param), node_f2(param)) }
          errors = errors + check_arg_against_param_at(nlist_get(args, i), param_ty, env, ft, src, tt, expr_diag_pos(recv), origin)
        } else { errors = errors }
      } else { errors = errors }
    }
    if associated { errors = errors }
    else { errors = errors + check_borrow_call_conflicts_with_receiver(args, nargs, recv, src, expr_diag_pos(recv)) }
  } else { if type_arg_errors != 0 { errors }
  else {
    let recv_ty = synth(recv, env, ft, src, tt)
    if type_is_unknown_or_any(recv_ty) { errors = errors }
    else {
      let pos = if method_ref_name_start(method_ref) > 0 { method_ref_name_start(method_ref) } else { expr_diag_pos(recv) }
      if method_hash == interp_display_hash() {
        typeck_error_maybe(src, pos, "type error: unknown method 'display' — implement Display for the interpolated type")
      } else {
        typeck_error_maybe(src, pos, "type error: unknown method")
      }
      errors = errors + 1
    }
  } }
  let method_eff = if delayed_trait != 0 { ttable_lookup_trait_method_effects_atom(tt, delayed_trait, method_hash) }
    else { if resolution == 0 { 0 } else { method_resolution_effects_for_ref(resolution, method_ref) } }
  let method_origin = if method_decl == 0 { DiagnosticLocationNone } else { module_diagnostic_decl_location(method_decl) }
  let method_start = if method_ref_name_len(method_ref) > 0 { method_ref_name_start(method_ref) } else { expr_diag_pos(recv) }
  let method_len = if method_ref_name_len(method_ref) > 0 { method_ref_name_len(method_ref) } else { expr_diag_len(recv) }
  errors = errors + check_effect_sig_available(method_eff, src, method_start, method_len, caller_eff, tt, "method call", method_origin)
  errors
}

pub(package) fn handler_clause_effect_ref_node(clause: i64) -> i64 {
  let names = node_f1(clause)
  if names == 0 { 0 } else { node_f1(names) }
}

pub(package) fn handler_clause_effect_ident_node(clause: i64) -> i64 {
  effect_ref_ident_node(handler_clause_effect_ref_node(clause))
}

pub(package) fn handler_clause_op_name_start(clause: i64) -> i64 {
  let names = node_f1(clause)
  if names == 0 { 0 } else { node_f2(names) }
}

pub(package) fn handler_clause_op_name_len(clause: i64) -> i64 {
  let names = node_f1(clause)
  if names == 0 { 0 } else { node_f3(names) }
}

pub(package) fn handler_clause_atom(clause: i64, src: i64) -> i64 {
  typeck_effect_ref_atom(handler_clause_effect_ref_node(clause), src)
}

pub(package) fn typeck_record_handler_clause_effect_facts(clause: i64, env: i64, src: i64, tt: i64, op: i64) -> i64 {
  let effect_ref = handler_clause_effect_ref_node(clause)
  let entry = typeck_effect_ref_entry(effect_ref, src, tt)
  if entry == 0 or op == 0 or not typeck_effect_operation_visible(entry, op, src, tt) { 0 }
  else {
    let atom = handler_clause_atom(clause, src)
    let effect_start = typeck_effect_ref_name_start(effect_ref)
    let effect_len = typeck_effect_ref_name_len(effect_ref)
    let entry_src = ttable_entry_source(entry)
    let op_ty = typeck_instantiated_effect_op_type(op, atom, entry)
    ttable_add_semantic_symbol_fact(
      tt, src, effect_start, effect_len,
      entry_src, ttable_entry_name_ptr(entry) - entry_src, ttable_entry_name_len(entry),
      op_ty, ttable_get_tparams(tt), semantic_symbol_kind_effect_atom(), env, atom
    )
    ttable_add_semantic_symbol_fact(
      tt, src, handler_clause_op_name_start(clause), handler_clause_op_name_len(clause),
      entry_src, node_f1(op), node_f2(op),
      op_ty, ttable_get_tparams(tt), semantic_symbol_kind_effect_operation(), env, atom
    )
    1
  }
}

pub(package) fn canonicalize_handler_clause_effect_ref(clause: i64, atom: i64) -> i64 {
  let names = node_f1(clause)
  let current = handler_clause_effect_ref_node(clause)
  let canonical = effect_ref_with_atom(current, atom)
  if names != 0 and canonical != current { mem_store64_at(names, 8, canonical) } else { 0 }
  canonical
}

pub(package) fn canonicalize_unqualified_handler_clauses(clauses: i64, nclauses: i64, atom: i64) -> i64 {
  if atom == 0 { 0 }
  else {
    for i in 0..nclauses {
      let clause = nlist_get(clauses, i)
      if typeck_effect_ref_is_parameterized(handler_clause_effect_ref_node(clause)) == 0 {
        canonicalize_handler_clause_effect_ref(clause, atom)
      } else { 0 }
    }
    0
  }
}

pub(package) fn lookup_handler_clause_op(clause: i64, src: i64, tt: i64) -> i64 {
  if tt == 0 { 0 }
  else {
    let effect_ref = handler_clause_effect_ref_node(clause)
    let entry = typeck_effect_ref_entry(effect_ref, src, tt)
    if entry == 0 { 0 }
    else {
      let kind = mem_load64_at(entry, 16)
      if kind != 2 { 0 }
      else {
        let entry_src = mem_load64_at(entry, 48)
        let op_hash = effect_name_hash(src, handler_clause_op_name_start(clause), handler_clause_op_name_len(clause))
        let nops = mem_load64_at(entry, 24)
        let ops = mem_load64_at(entry, 32)
        let mut i = 0
        let mut result = 0
        while i < nops {
          let op = nlist_get(ops, i)
          let op_name_hash = effect_name_hash(entry_src, node_f1(op), node_f2(op))
          if op_name_hash == op_hash {
            result = op
            i = nops
          } else { i = i + 1 }
        }
        result
      }
    }
  }
}

pub(package) fn handler_clause_matches_perform_node(clause: i64, node: i64, src: i64) -> i64 {
  if node == 0 { 0 }
  else { if node_tag(node) != 32 { 0 }
  else { if typeck_qualified_call_declaration(node) != 0 { 0 }
  else {
    let lhs = node_f1(node)
    if effect_ref_ident_node(lhs) == 0 and effect_ref_field_node(lhs) == 0 { 0 }
    else {
      let clause_ref = handler_clause_effect_ref_node(clause)
      let same_effect = if typeck_effect_ref_is_parameterized(clause_ref) == 1 and typeck_effect_ref_is_parameterized(lhs) == 1 {
        effect_atom_eq(typeck_effect_ref_atom(clause_ref, src), typeck_effect_ref_atom(lhs, src))
      } else { typeck_effect_ref_name_hash(clause_ref, src) == typeck_effect_ref_name_hash(lhs, src) }
      if not same_effect { 0 }
      else { if effect_name_hash(src, handler_clause_op_name_start(clause), handler_clause_op_name_len(clause)) == effect_name_hash(src, node_f2(node), node_f3(node)) { 1 } else { 0 } }
    }
  } } }
}

pub(package) fn deferred_split_pure_context(node: i64) -> bool {
  if node == 0 { true }
  else {
    match node_tag(node) {
      1 -> true
      2 -> true
      3 -> deferred_split_pure_context(node_f2(node)) and deferred_split_pure_context(node_f3(node))
      5 -> deferred_split_pure_context(node_f1(node)) and deferred_split_pure_context(node_f2(node)) and deferred_split_pure_context(node_f3(node))
      24 -> true
      _ -> false
    }
  }
}

pub(package) fn deferred_split_args_pure(args: i64, n: i64) -> i64 {
  let mut ok = 1
  let mut i = 0
  while i < n {
    if deferred_split_pure_context(nlist_get(args, i)) == 0 {
      ok = 0
      i = n
    } else { i = i + 1 }
  }
  ok
}

pub(package) fn deferred_split_type_is_managed(ty: i64) -> bool {
  if ty == 0 { false }
  else { if ty_is_rc(ty) == 1 { true }
  else { if ty_tag(ty) == 6 { true }
  else { if typeck_ty_is_weak_managed_ref(ty) == 1 { true } else { false } } } }
}

pub(package) fn deferred_split_name_in_params(params: i64, src: i64, ns: i64, nl: i64) -> bool {
  let mut found = false
  let mut i = 0
  let n = nlist_len(params)
  while i < n {
    let p = nlist_get(params, i)
    if node_f2(p) == nl and src_eq_at(src, ns, src + node_f1(p), 0, nl) == 1 {
      found = 1
      i = n
    } else { i = i + 1 }
  }
  found
}

pub(package) fn deferred_split_expr_refs_only_params(node: i64, params: i64, src: i64) -> bool {
  if node == 0 { true }
  else {
    match node_tag(node) {
      1 -> true
      2 -> deferred_split_name_in_params(params, src, node_f1(node), node_f2(node))
      3 -> deferred_split_expr_refs_only_params(node_f2(node), params, src) and deferred_split_expr_refs_only_params(node_f3(node), params, src)
      5 -> deferred_split_expr_refs_only_params(node_f1(node), params, src) and deferred_split_expr_refs_only_params(node_f2(node), params, src) and deferred_split_expr_refs_only_params(node_f3(node), params, src)
      24 -> true
      _ -> false
    }
  }
}

pub(package) fn deferred_split_param_type_by_name(params: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let mut result = 0
  let mut i = 0
  let n = nlist_len(params)
  while i < n {
    let p = nlist_get(params, i)
    if node_f2(p) == nl and src_eq_at(src, ns, src + node_f1(p), 0, nl) == 1 {
      result = node_f3(p)
      i = n
    } else { i = i + 1 }
  }
  result
}

pub(package) fn deferred_split_expr_refs_managed_param(node: i64, params: i64, src: i64) -> bool {
  if node == 0 { false }
  else {
    match node_tag(node) {
      1 -> false
      2 -> deferred_split_type_is_managed(deferred_split_param_type_by_name(params, src, node_f1(node), node_f2(node)))
      3 -> deferred_split_expr_refs_managed_param(node_f2(node), params, src) or deferred_split_expr_refs_managed_param(node_f3(node), params, src)
      5 -> deferred_split_expr_refs_managed_param(node_f1(node), params, src) or deferred_split_expr_refs_managed_param(node_f2(node), params, src) or deferred_split_expr_refs_managed_param(node_f3(node), params, src)
      24 -> false
      _ -> false
    }
  }
}

pub(package) fn deferred_split_target_args_supported(target: i64, params: i64, src: i64) -> i64 {
  let args = node_f4(target)
  let n = nlist_len(args)
  let mut ok = 1
  let mut i = 0
  while i < n {
    let arg = nlist_get(args, i)
    if deferred_split_pure_context(arg) == 0 or deferred_split_expr_refs_only_params(arg, params, src) == 0 or deferred_split_expr_refs_managed_param(arg, params, src) == 1 {
      ok = 0
      i = n
    } else { i = i + 1 }
  }
  ok
}

pub(package) fn deferred_split_function_call_supports_clause(node: i64, clause: i64, src: i64, ft: i64) -> bool {
  if node_tag(node) != 4 { false }
  else {
    let params = ftypes_lookup_params(ft, src, node_f1(node), node_f2(node))
    let nargs = node_f4(node)
    if params == 0 { false }
    else { if nlist_len(params) != nargs { false }
    else { if deferred_split_args_pure(node_f3(node), nargs) == 0 { false }
  else {
    let body = ftypes_lookup_body(ft, src, node_f1(node), node_f2(node))
    if body == 0 { false }
    else {
      let target = deferred_split_find_target(body, clause, src, ft)
      if target == 0 { false }
      else { if deferred_split_target_args_supported(target, params, src) == 0 { false }
      else { deferred_split_body_supports_clause(body, clause, src, ft) } }
    }
  } } } }
}

pub(package) fn deferred_split_find_target(node: i64, clause: i64, src: i64, ft: i64) -> i64 {
  if node == 0 { 0 }
  else { if handler_clause_matches_perform_node(clause, node, src) == 1 { node }
  else {
    match node_tag(node) {
      3 -> {
        let left = deferred_split_find_target(node_f2(node), clause, src, ft)
        if left != 0 { left } else { deferred_split_find_target(node_f3(node), clause, src, ft) }
      }
      6 -> deferred_split_find_target(node_f3(node), clause, src, ft)
      7 -> deferred_split_find_target(node_f1(node), clause, src, ft)
      37 -> deferred_split_find_target(node_f1(node), clause, src, ft)
      _ -> 0
    }
  } }
}

pub(package) fn deferred_split_body_supports_clause(node: i64, clause: i64, src: i64, ft: i64) -> bool {
  if node == 0 { false }
  else { if handler_clause_matches_perform_node(clause, node, src) == 1 { true }
  else {
    match node_tag(node) {
      3 -> {
        let left = node_f2(node)
        let right = node_f3(node)
        (deferred_split_body_supports_clause(left, clause, src, ft) and deferred_split_pure_context(right)) or
        (deferred_split_body_supports_clause(right, clause, src, ft) and deferred_split_pure_context(left))
      }
      6 -> {
        deferred_split_body_supports_clause(node_f3(node), clause, src, ft) and deferred_split_pure_context(node_f4(node))
      }
      7 -> {
        deferred_split_body_supports_clause(node_f1(node), clause, src, ft) and deferred_split_pure_context(node_f2(node))
      }
      4 -> deferred_split_function_call_supports_clause(node, clause, src, ft)
      37 -> deferred_split_body_supports_clause(node_f1(node), clause, src, ft)
      _ -> false
    }
  } }
}

pub(package) fn deferred_fiber_count_max(left: i64, right: i64) -> i64 {
  if left < 0 or right < 0 { 0 - 1 }
  else { if left > right { left } else { right } }
}

pub(package) fn deferred_fiber_count_add(left: i64, right: i64) -> i64 {
  if left < 0 or right < 0 { 0 - 1 }
  else { left + right }
}

pub(package) fn deferred_fiber_count_list(list: i64, n: i64, clause: i64, src: i64, env: i64, ft: i64) -> i64 {
  let mut count = 0
  for i in 0..n {
    count = deferred_fiber_count_add(count, deferred_fiber_perform_count(nlist_get(list, i), clause, src, env, ft))
  }
  count
}

pub(package) fn deferred_fiber_params_unmanaged(params: i64) -> i64 {
  if params == 0 { 0 }
  else {
    let mut ok = 1
    let mut i = 0
    while i < nlist_len(params) {
      if deferred_split_type_is_managed(node_f3(nlist_get(params, i))) == 1 {
        ok = 0
        i = nlist_len(params)
      } else { i = i + 1 }
    }
    ok
  }
}

pub(package) fn deferred_fiber_body_list_has_perform(list: i64, n: i64, clause: i64, src: i64) -> bool {
  let mut found = false
  let mut i = 0
  while i < n {
    if deferred_fiber_body_has_perform(nlist_get(list, i), clause, src) == 1 {
      found = true
      i = n
    } else { i = i + 1 }
  }
  found
}

pub(package) fn deferred_fiber_body_has_perform(node: i64, clause: i64, src: i64) -> bool {
  if node == 0 { false }
  else {
    match node_tag(node) {
      3 -> deferred_fiber_body_has_perform(node_f2(node), clause, src) or deferred_fiber_body_has_perform(node_f3(node), clause, src)
      4 -> deferred_fiber_body_list_has_perform(node_f3(node), node_f4(node), clause, src)
      5 -> deferred_fiber_body_has_perform(node_f1(node), clause, src) or deferred_fiber_body_has_perform(node_f2(node), clause, src) or deferred_fiber_body_has_perform(node_f3(node), clause, src)
      6 -> deferred_fiber_body_has_perform(node_f3(node), clause, src) or deferred_fiber_body_has_perform(node_f4(node), clause, src)
      7 -> deferred_fiber_body_has_perform(node_f1(node), clause, src) or deferred_fiber_body_has_perform(node_f2(node), clause, src)
      11 -> deferred_fiber_body_has_perform(node_f3(node), clause, src) or deferred_fiber_body_has_perform(node_f4(node), clause, src)
      12 -> deferred_fiber_body_has_perform(node_f3(node), clause, src)
      57 -> deferred_fiber_body_has_perform(node_f1(node), clause, src) or deferred_fiber_body_has_perform(node_f2(node), clause, src)
      13 -> deferred_fiber_body_has_perform(node_f1(node), clause, src)
      59 -> deferred_fiber_body_has_perform(node_f1(node), clause, src)
      60 -> deferred_fiber_body_has_perform(node_f1(node), clause, src) or deferred_fiber_body_has_perform(node_f2(node), clause, src)
      61 -> deferred_fiber_body_has_perform(node_f1(node), clause, src) or deferred_fiber_body_has_perform(node_f2(node), clause, src) or deferred_fiber_body_has_perform(node_f3(node), clause, src)
      62 -> deferred_fiber_body_has_perform(node_f1(node), clause, src) or deferred_fiber_body_has_perform(node_f2(node), clause, src) or deferred_fiber_body_has_perform(node_f3(node), clause, src)
      14 -> deferred_fiber_body_list_has_perform(node_f3(node), node_f4(node), clause, src)
      63 -> deferred_fiber_body_has_perform(node_f1(node), clause, src) or deferred_fiber_body_list_has_perform(record_field_expr_nodes(node_f2(node), node_f3(node)), node_f3(node), clause, src)
      58 -> deferred_fiber_body_list_has_perform(node_f1(node), node_f2(node), clause, src)
      15 -> {
        let arms = node_f2(node)
        let n = node_f3(node)
        let mut found = deferred_fiber_body_has_perform(node_f1(node), clause, src)
        let mut i = 0
        while i < n and found == 0 {
          let arm = nlist_get(arms, i)
          let guard = node_f3(arm)
          found = if guard != 0 { deferred_fiber_body_has_perform(guard, clause, src) } else { false }
          if found == 0 { found = deferred_fiber_body_has_perform(node_f2(arm), clause, src) } else { found = found }
          i = i + 1
        }
        found
      }
      22 -> deferred_fiber_body_has_perform(node_f1(node), clause, src)
      25 -> deferred_fiber_body_has_perform(node_f1(node), clause, src)
      26 -> deferred_fiber_body_has_perform(node_f1(node), clause, src)
      32 -> if handler_clause_matches_perform_node(clause, node, src) == 1 { true }
        else { deferred_fiber_body_list_has_perform(node_f4(node), nlist_len(node_f4(node)), clause, src) }
      35 -> deferred_fiber_body_has_perform(node_f1(node), clause, src)
      36 -> {
        let call_node = node_f2(node)
        deferred_fiber_body_list_has_perform(generic_call_inner_args(call_node), generic_call_inner_arg_count(call_node), clause, src)
      }
      37 -> deferred_fiber_body_has_perform(node_f1(node), clause, src)
      41 -> deferred_fiber_body_has_perform(node_f1(node), clause, src) or deferred_fiber_body_list_has_perform(node_f3(node), nlist_len(node_f3(node)), clause, src)
      45 -> deferred_fiber_body_has_perform(node_f1(node), clause, src)
      46 -> deferred_fiber_body_has_perform(node_f1(node), clause, src) or deferred_fiber_body_has_perform(node_f2(node), clause, src)
      48 -> deferred_fiber_body_has_perform(node_f1(node), clause, src)
      52 -> deferred_fiber_body_has_perform(node_f1(node), clause, src) or deferred_fiber_body_has_perform(node_f2(node), clause, src)
      _ -> false
    }
  }
}

pub(package) fn deferred_fiber_call_stores_continuation(node: i64, cont: i64, src: i64) -> i64 {
  if node_tag(node) != 4 { 0 }
  else {
    let stores = src_eq(src, node_f1(node), node_f2(node), "continuation_cell_store_i64") == 1 or
      src_eq(src, node_f1(node), node_f2(node), "continuation_cell_store_i64_raw") == 1 or
      src_eq(src, node_f1(node), node_f2(node), "runtime_continuation_cell_store_i64") == 1
    if stores == 0 { 0 }
    else {
      let args = node_f3(node)
      let nargs = node_f4(node)
      let mut found = 0
      let mut i = 0
      while i < nargs {
        if continuation_direct_ref(nlist_get(args, i), cont, src) == 1 {
          found = 1
          i = nargs
        } else { i = i + 1 }
      }
      found
    }
  }
}

pub(package) fn deferred_fiber_body_stores_continuation(node: i64, cont: i64, src: i64) -> bool {
  if node == 0 { false }
  else {
    match node_tag(node) {
      3 -> deferred_fiber_body_stores_continuation(node_f2(node), cont, src) or deferred_fiber_body_stores_continuation(node_f3(node), cont, src)
      4 -> if deferred_fiber_call_stores_continuation(node, cont, src) == 1 { true }
        else { deferred_fiber_list_stores_continuation(node_f3(node), node_f4(node), cont, src) }
      6 -> deferred_fiber_body_stores_continuation(node_f3(node), cont, src) or deferred_fiber_body_stores_continuation(node_f4(node), cont, src)
      7 -> deferred_fiber_body_stores_continuation(node_f1(node), cont, src) or deferred_fiber_body_stores_continuation(node_f2(node), cont, src)
      37 -> deferred_fiber_body_stores_continuation(node_f1(node), cont, src)
      59 -> deferred_fiber_body_stores_continuation(node_f1(node), cont, src)
      60 -> deferred_fiber_body_stores_continuation(node_f1(node), cont, src) or deferred_fiber_body_stores_continuation(node_f2(node), cont, src)
      61 -> deferred_fiber_body_stores_continuation(node_f1(node), cont, src) or deferred_fiber_body_stores_continuation(node_f2(node), cont, src) or deferred_fiber_body_stores_continuation(node_f3(node), cont, src)
      62 -> deferred_fiber_body_stores_continuation(node_f1(node), cont, src) or deferred_fiber_body_stores_continuation(node_f2(node), cont, src) or deferred_fiber_body_stores_continuation(node_f3(node), cont, src)
      58 -> deferred_fiber_list_stores_continuation(node_f1(node), node_f2(node), cont, src)
      _ -> false
    }
  }
}

pub(package) fn deferred_fiber_list_stores_continuation(list: i64, n: i64, cont: i64, src: i64) -> bool {
  let mut found = false
  let mut i = 0
  while i < n {
    if deferred_fiber_body_stores_continuation(nlist_get(list, i), cont, src) == 1 {
      found = 1
