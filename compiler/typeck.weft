-- compiler/typeck.weft — Bidirectional type checker
--
-- Synthesizes types bottom-up for expressions:
--   IntLit → i64, StringLit → str, true/false → bool
--   BinOp(+,-,*,/,%) → i64 (both operands must be i64)
--   BinOp(==,!=,<,>,<=,>=) → bool
--   BinOp(and,or) → bool
--   not expr → bool
--   if/else → unify branches
--   function call → return type of function
--
-- Reports type errors through Diagnose where migrated, with legacy direct
-- stderr emission still present in older checker paths.
-- Does NOT block compilation — errors are informational for now.

use compiler/diagnose.{*}
use compiler/effect_ref.{*}
use compiler/ir.{Arm, BoolLit, CtorPattern, MatchArmListCons, MatchArmListNil, NilExpr, PatternListNil, Wildcard, match_arm_list_to_nodes}
use compiler/lib.{*}
use compiler/module.{*}
use compiler/module_diagnostics.{module_diagnostic_decl_location, module_diagnostic_import_local_location, module_diagnostic_qualified_member}
use compiler/package.{*}
use compiler/parse.{*}
use compiler/source_trust.{*}
use compiler/semantic_type_projection.{*}
use compiler/typecheck_effect.{*}
use compiler/type_registry.{*}
use compiler/types.{*}
use runtime/alloc.{*}
use runtime/buffer.{*}
use runtime/memory.{*}
use runtime/string.{runtime_int_to_str, runtime_str_from_bytes_copy}
use stdlib/diagnostic.{*}
use stdlib/diagnostic/registry
use stdlib/diagnostic/schema.{*}
use stdlib/semantic_type.{*}
use stdlib/semantic_type/render
use stdlib/utf8.{Utf8Decoded, Utf8Malformed, utf8_decode_next_bytes}

-- span is an offset into src; the diagnostic carries the absolute address so
-- the renderer can resolve which loaded source buffer it belongs to. Spans
-- already above the offset ceiling are assumed absolute and passed through.
pub(package) fn typeck_error(src: i64, span: i64, msg: str) -[Diagnose]> i64 {
  let abs_span = if span < 0 { span }
    else { if span < diagnose_max_render_span() { src + span } else { span } }
  Diagnose.error(msg, abs_span)
}

pub(package) fn typeck_error_maybe(src: i64, span: i64, msg: str) -[Diagnose]> i64 {
  let diag_span = if span > 0 { span } else { 0 - 1 }
  typeck_error(src, diag_span, msg)
}

pub(package) fn typeck_source_location(src: i64, start: i64, len: i64) -> DiagnosticLocation {
  if start < 0 { DiagnosticLocationNone }
  else { DiagnosticSourceRange(DiagnosticSourceBuffer(src), start, start + if len > 0 { len } else { 1 }) }
}

pub(package) fn typeck_location_source_or(location: DiagnosticLocation, fallback: i64) -> i64 {
  match location {
    DiagnosticSourceRange(DiagnosticSourceBuffer(source), start, end) -> source
    _ -> fallback
  }
}

pub(package) fn typeck_text_eq(value: str, expected: str) -> i64 {
  if __str_len(value) != __str_len(expected) { 0 }
  else { src_eq(__str_ptr(value), 0, __str_len(value), expected) }
}

pub(package) fn typeck_mismatch_message(reason: str, context: str, expected: str, found: str) -> str {
  let b = buf_new(96)
  if typeck_text_eq(reason, "integer_literal_range") == 1 {
    bstr(b, "integer literal does not fit expected type `")
    bstr(b, expected)
    bstr(b, "`")
  } else { if typeck_text_eq(reason, "non_callable") == 1 {
    bstr(b, "value is not callable: expected callable type `")
    bstr(b, expected)
    bstr(b, "`, found `")
    bstr(b, found)
    bstr(b, "`")
  } else { if typeck_text_eq(reason, "unique_origin") == 1 {
    bstr(b, context)
    bstr(b, " requires proven unique ownership: expected `")
    bstr(b, expected)
    bstr(b, "`, found potentially aliased `")
    bstr(b, found)
    bstr(b, "`")
  } else {
    bstr(b, context)
    bstr(b, " type mismatch: expected `")
    bstr(b, expected)
    bstr(b, "`, found `")
    bstr(b, found)
    bstr(b, "`")
  } } }
  runtime_str_from_bytes_copy(buf_ptr(b), buf_len(b))
}

pub(package) fn typeck_mismatch_reason(expected_ty: i64, found_ty: i64) -[Conformance]> str {
  let found_non_nil = if type_allows_nil(found_ty) == 1 { ty_narrow_drop_nil(found_ty) } else { 0 }
  if ty_is_unique(expected_ty) and not ty_is_unique(found_ty) and is_subtype(found_ty, ty_unique_inner(expected_ty)) {
    "unique_origin"
  } else { if type_allows_nil(expected_ty) == 0 and found_non_nil != 0 and is_subtype(found_non_nil, expected_ty) {
    "possibly_nil"
  } else { if ty_is_array(expected_ty) and ty_is_array(found_ty) and ty_eq(ty_array_inner(expected_ty), ty_array_inner(found_ty)) and ty_array_length(expected_ty) != ty_array_length(found_ty) {
    "array_length"
  } else { if ty_is_slice(expected_ty) and ty_is_slice(found_ty) and (ty_slice_mutable(expected_ty) != ty_slice_mutable(found_ty) or not ty_eq(ty_slice_inner(expected_ty), ty_slice_inner(found_ty))) {
    "mutable_slice_contract"
  } else { if ty_tag(expected_ty) == 9 and ty_tag(found_ty) == 9 and ty_f1(expected_ty) == ty_f1(found_ty) {
    "nominal_type_arguments"
  } else { if ty_is_record(expected_ty) or ty_is_record(found_ty) {
    "structural_shape"
  } else { "incompatible_types" } } } } } }
}

pub(package) fn typeck_mismatch_reason_for_expr(node: i64, expected_ty: i64, found_ty: i64, src: i64) -[Conformance]> str {
  let contextual_expected = if ty_is_unique(expected_ty) { ty_unique_inner(expected_ty) }
    else { if ty_is_owned(expected_ty) { ty_owned_inner(expected_ty) } else { expected_ty } }
  if node != 0 and expr_is_contextual_int_lit_shape(node) == 1 and type_int_prim(contextual_expected) >= 0 and expr_contextual_int_lit_matches_type(node, contextual_expected, src) != 1 {
    "integer_literal_range"
  } else { typeck_mismatch_reason(expected_ty, found_ty) }
}

pub(package) fn typeck_int_prim_min_str(prim: i64) -> str {
  if prim_is_unsigned_integer(prim) == 1 { "0" }
  else { if prim == PRIM_I8() { "-128" }
  else { if prim == PRIM_I16() { "-32768" }
  else { if prim == PRIM_I32() { "-2147483648" }
  else { "-9223372036854775808" } } } }
}

pub(package) fn typeck_mismatch_detail_fields(reason: str, expected_ty: i64, expected_origin: DiagnosticLocation) -> DiagnosticFieldList {
  let tail = DiagnosticFieldCons(DiagnosticFieldLocation("expected_origin", expected_origin), DiagnosticFieldNil)
  if typeck_text_eq(reason, "integer_literal_range") == 1 {
    let prim = type_int_prim(expected_ty)
    DiagnosticFieldCons(
      DiagnosticFieldText("expected_min", typeck_int_prim_min_str(prim)),
      DiagnosticFieldCons(DiagnosticFieldText("expected_max", int_prim_positive_max_str(prim)), tail)
    )
  } else { tail }
}

pub(package) fn typeck_type_mismatch_diagnostic_with_reason(
  src: i64,
  start: i64,
  len: i64,
  expected_ty: i64,
  found_ty: i64,
  context: str,
  expected_origin: DiagnosticLocation,
  tt: i64,
  reason: str
) -[Conformance]> Diagnostic {
  let expected = semantic_type_fact_from_checker(expected_ty, tt, typeck_location_source_or(expected_origin, src))
  let found = semantic_type_fact_from_checker(found_ty, tt, src)
  let expected_text = expected.render()
  let found_text = found.render()
  let relationship = if typeck_text_eq(reason, "integer_literal_range") == 1 { "literal_out_of_range" }
    else { if typeck_text_eq(reason, "unique_origin") == 1 { "unique_origin_not_proven" }
    else { "found_not_subtype_of_expected" } }
  let related = match expected_origin {
    DiagnosticLocationNone -> DiagnosticRelatedLocationNil
    _ -> DiagnosticRelatedLocationCons(DiagnosticRelatedLocation("expected type established here", expected_origin), DiagnosticRelatedLocationNil)
  }
  Diagnostic(
    DiagnosticSeverityError,
    DiagnosticClassType,
    registry.type_mismatch(),
    typeck_mismatch_message(reason, context, expected_text, found_text),
    typeck_source_location(src, start, len),
    related,
    DiagnosticFieldCons(
      DiagnosticFieldText("context", context),
      DiagnosticFieldCons(
        DiagnosticFieldType("expected_type", expected),
        DiagnosticFieldCons(
          DiagnosticFieldType("found_type", found),
          DiagnosticFieldCons(
            DiagnosticFieldText("expected", expected_text),
            DiagnosticFieldCons(
              DiagnosticFieldText("found", found_text),
              DiagnosticFieldCons(
              DiagnosticFieldText("relationship", relationship),
                DiagnosticFieldCons(
                  DiagnosticFieldText("reason", reason),
                  typeck_mismatch_detail_fields(reason, expected_ty, expected_origin)
                )
              )
            )
          )
        )
      )
    )
  )
}

pub(package) fn typeck_type_mismatch_diagnostic(
  src: i64,
  start: i64,
  len: i64,
  expected_ty: i64,
  found_ty: i64,
  context: str,
  expected_origin: DiagnosticLocation,
  tt: i64
) -[Conformance]> Diagnostic {
  typeck_type_mismatch_diagnostic_with_reason(src, start, len, expected_ty, found_ty, context, expected_origin, tt, typeck_mismatch_reason(expected_ty, found_ty))
}

pub(package) fn typeck_report_type_mismatch(
  src: i64,
  start: i64,
  len: i64,
  expected_ty: i64,
  found_ty: i64,
  context: str,
  expected_origin: DiagnosticLocation,
  tt: i64
) -[Conformance, Diagnose]> i64 {
  Diagnose.report(typeck_type_mismatch_diagnostic(src, start, len, expected_ty, found_ty, context, expected_origin, tt))
}

pub(package) fn typeck_report_expr_type_mismatch(
  src: i64,
  node: i64,
  expected_ty: i64,
  found_ty: i64,
  context: str,
  expected_origin: DiagnosticLocation,
  tt: i64
) -[Conformance, Diagnose]> i64 {
  Diagnose.report(typeck_type_mismatch_diagnostic_with_reason(
    src,
    if node == 0 { 0 } else { expr_diag_pos(node) },
    if node == 0 { 1 } else { expr_diag_len(node) },
    expected_ty,
    found_ty,
    context,
    expected_origin,
    tt,
    typeck_mismatch_reason_for_expr(node, expected_ty, found_ty, src)
  ))
}

-- E1001 carries the unresolved spelling and the best semantically eligible
-- in-scope replacement. Distance is over Unicode scalar values rather than
-- UTF-8 bytes, so an international identifier is not penalised per byte.
pub(package) type TypeckNameSuggestion {
  NoTypeckNameSuggestion
  TypeckNameSuggestion(str, DiagnosticLocation, i64, i64) -- spelling, location, distance, rank
}

pub(package) fn typeck_name_scalars(ptr: i64, len: i64) -> i64 {
  let values = nlist_new_capacity(if len < 1 { 1 } else { len })
  let mut pos = 0
  while pos < len {
    match utf8_decode_next_bytes(ptr, len, pos) {
      Utf8Decoded(next, scalar) -> {
        nlist_add(values, scalar)
        pos = next
      }
      Utf8Malformed(offset) -> {
        -- Lexer-produced identifiers are valid UTF-8. This fallback keeps the
        -- helper total for raw unit tests and malformed trusted inputs.
        nlist_add(values, mem_load8_at(ptr, pos))
        pos = pos + 1
      }
    }
  }
  values
}

pub(package) fn typeck_name_edit_distance(left_ptr: i64, left_len: i64, right_ptr: i64, right_len: i64) -> i64 {
  -- Suggestions are deliberately bounded. Long hostile names retain a full
  -- diagnostic but cannot force an unbounded quadratic allocation.
  if left_len > 256 or right_len > 256 { 257 }
  else {
    let left = typeck_name_scalars(left_ptr, left_len)
    let right = typeck_name_scalars(right_ptr, right_len)
    let ln = nlist_len(left)
    let rn = nlist_len(right)
    let mut two_ago = alloc_words(rn + 1)
    let mut previous = alloc_words(rn + 1)
    let mut current = alloc_words(rn + 1)
    for j in 0..rn + 1 { mem_store64_at(previous, j * 8, j) }
    for i in 0..ln {
      mem_store64_at(current, 0, i + 1)
      for j in 0..rn {
        let deletion = mem_load64_at(previous, (j + 1) * 8) + 1
        let insertion = mem_load64_at(current, j * 8) + 1
        let substitution = mem_load64_at(previous, j * 8) + if nlist_get(left, i) == nlist_get(right, j) { 0 } else { 1 }
        let first = if deletion < insertion { deletion } else { insertion }
        let ordinary = if substitution < first { substitution } else { first }
        let transposition = if i > 0 and j > 0 and nlist_get(left, i) == nlist_get(right, j - 1) and nlist_get(left, i - 1) == nlist_get(right, j) {
          mem_load64_at(two_ago, (j - 1) * 8) + 1
        } else { ordinary }
        mem_store64_at(current, (j + 1) * 8, if transposition < ordinary { transposition } else { ordinary })
      }
      let reusable = two_ago
      two_ago = previous
      previous = current
      current = reusable
    }
    mem_load64_at(previous, rn * 8)
  }
}

pub(package) fn typeck_name_scalar_count(ptr: i64, len: i64) -> i64 {
  if len > 256 { 257 } else { nlist_len(typeck_name_scalars(ptr, len)) }
}

pub(package) fn typeck_name_suggestion_threshold(scalar_count: i64) -> i64 {
  if scalar_count <= 4 { 1 } else { if scalar_count <= 8 { 2 } else { 3 } }
}

pub(package) fn typeck_name_bytes_compare(left_ptr: i64, left_len: i64, right_ptr: i64, right_len: i64) -> i64 {
  let n = if left_len < right_len { left_len } else { right_len }
  let mut i = 0
  let mut result = 0
  while i < n and result == 0 {
    let left = mem_load8_at(left_ptr, i)
    let right = mem_load8_at(right_ptr, i)
    if left < right { result = 0 - 1 } else { if left > right { result = 1 } else { i = i + 1 } }
  }
  if result != 0 { result }
  else { if left_len < right_len { 0 - 1 } else { if left_len > right_len { 1 } else { 0 } } }
}

pub(package) fn typeck_name_suggestion_consider(
  current: TypeckNameSuggestion,
  query_ptr: i64,
  query_len: i64,
  candidate_ptr: i64,
  candidate_len: i64,
  location: DiagnosticLocation,
  rank: i64
) -> TypeckNameSuggestion {
  let query_count = typeck_name_scalar_count(query_ptr, query_len)
  let candidate_count = typeck_name_scalar_count(candidate_ptr, candidate_len)
  let threshold = typeck_name_suggestion_threshold(query_count)
  let length_delta = if query_count > candidate_count { query_count - candidate_count } else { candidate_count - query_count }
  if query_count > 64 or candidate_count > 64 or length_delta > threshold { current }
  else {
    let distance = typeck_name_edit_distance(query_ptr, query_len, candidate_ptr, candidate_len)
    if distance == 0 or distance > threshold { current }
    else {
      let replace = match current {
        NoTypeckNameSuggestion -> 1
        TypeckNameSuggestion(spelling, prior_location, prior_distance, prior_rank) -> {
          if distance < prior_distance { 1 }
          else { if distance > prior_distance { 0 }
          else { if rank < prior_rank { 1 }
          else { if rank > prior_rank { 0 }
          else { if typeck_name_bytes_compare(candidate_ptr, candidate_len, __str_ptr(spelling), __str_len(spelling)) < 0 { 1 } else { 0 } } } } }
        }
      }
      if replace == 1 {
        TypeckNameSuggestion(runtime_str_from_bytes_copy(candidate_ptr, candidate_len), location, distance, rank)
      } else { current }
    }
  }
}

pub(package) fn typeck_name_suggest_env(current: TypeckNameSuggestion, query_ptr: i64, query_len: i64, env: i64, function_only: i64) -> TypeckNameSuggestion {
  let mut candidate = current
  let mut entry = env
  while entry != 0 {
    let candidate_ty = tenv_entry_type(entry)
    let callable = if ty_tag(candidate_ty) == 6 or ty_tag(candidate_ty) == 14 { 1 } else { 0 }
    if function_only == 0 or callable == 1 {
      let source = tenv_entry_source(entry)
      let start = tenv_entry_name_start(entry)
      let len = tenv_entry_name_len(entry)
      candidate = typeck_name_suggestion_consider(
        candidate,
        query_ptr,
        query_len,
        source + start,
        len,
        DiagnosticSourceRange(DiagnosticSourceBuffer(source), start, start + len),
        0
      )
    } else { 0 }
    entry = mem_load64_at(entry, 32)
  }
  candidate
}

pub(package) fn typeck_name_scope_candidate_ok(entry: i64) -> i64 {
  if module_scope_entry_status(entry) != module_scope_status_resolved() or module_scope_entry_kind(entry) != module_scope_kind_declaration() { 0 }
  else {
    let namespace = module_decl_fact_namespace(module_scope_entry_target(entry))
    if namespace == module_decl_namespace_value() or namespace == module_decl_namespace_constructor() { 1 } else { 0 }
  }
}

pub(package) fn typeck_name_suggest_scope(current: TypeckNameSuggestion, query_ptr: i64, query_len: i64, src: i64, tt: i64) -> TypeckNameSuggestion {
  let module_entry = module_fact_find_source(tt, src)
  if module_entry == 0 { current }
  else {
    module_scope_build_all(tt)
    let scopes = module_fact_scopes(tt)
    let mut candidate = current
    for i in 0..nlist_len(scopes) {
      let entry = nlist_get(scopes, i)
      if module_scope_entry_module(entry) == module_entry and typeck_name_scope_candidate_ok(entry) == 1 {
        let import_entry = module_scope_entry_import(entry)
        let location = if import_entry == 0 { module_diagnostic_decl_location(module_scope_entry_target(entry)) }
          else { module_diagnostic_import_local_location(entry, import_entry) }
        candidate = typeck_name_suggestion_consider(
          candidate,
          query_ptr,
          query_len,
          module_scope_entry_name_ptr(entry),
          module_scope_entry_name_len(entry),
          location,
          1
        )
      } else { 0 }
    }
    candidate
  }
}

pub(package) fn typeck_name_suggest_ftypes(current: TypeckNameSuggestion, query_ptr: i64, query_len: i64, ft: i64) -> TypeckNameSuggestion {
  let mut candidate = current
  for i in 0..nlist_len(ft) {
    let entry = nlist_get(ft, i)
    let source = ftypes_entry_source(entry)
    let start = ftypes_entry_name_start(entry)
    let len = ftypes_entry_name_len(entry)
    candidate = typeck_name_suggestion_consider(
      candidate,
      query_ptr,
      query_len,
      source + start,
      len,
      DiagnosticSourceRange(DiagnosticSourceBuffer(source), start, start + len),
      2
    )
  }
  candidate
}

pub(package) fn typeck_name_suggestion(src: i64, start: i64, len: i64, env: i64, ft: i64, tt: i64, function_only: i64) -> TypeckNameSuggestion {
  let local = typeck_name_suggest_env(NoTypeckNameSuggestion(), src + start, len, env, function_only)
  let scoped = typeck_name_suggest_scope(local, src + start, len, src, tt)
  if module_fact_find_source(tt, src) == 0 { typeck_name_suggest_ftypes(scoped, src + start, len, ft) } else { scoped }
}

pub(package) fn typeck_unknown_name_message(name: str, name_kind: str) -> str {
  let message = buf_new(__str_len(name) + __str_len(name_kind) + 12)
  bstr(message, "unknown ")
  bstr(message, name_kind)
  bstr(message, " '")
  bstr(message, name)
  bstr(message, "'")
  runtime_str_from_bytes_copy(buf_ptr(message), buf_len(message))
}

pub(package) fn typeck_unknown_name_diagnostic(src: i64, start: i64, len: i64, name_kind: str, suggestion: TypeckNameSuggestion) -> Diagnostic {
  let name = runtime_str_from_bytes_copy(src + start, len)
  let primary = DiagnosticSourceRange(DiagnosticSourceBuffer(src), start, start + len)
  let base_fields = DiagnosticFieldCons(
    DiagnosticFieldText("name", name),
    DiagnosticFieldCons(DiagnosticFieldText("name_kind", name_kind), DiagnosticFieldNil)
  )
  match suggestion {
    NoTypeckNameSuggestion -> Diagnostic(
      DiagnosticSeverityError,
      DiagnosticClassType,
      registry.unknown_name(),
      typeck_unknown_name_message(name, name_kind),
      primary,
      DiagnosticRelatedLocationNil,
      base_fields
    )
    TypeckNameSuggestion(spelling, location, distance, rank) -> Diagnostic(
      DiagnosticSeverityError,
      DiagnosticClassType,
      registry.unknown_name(),
      typeck_unknown_name_message(name, name_kind),
      primary,
      match location {
        DiagnosticLocationNone -> DiagnosticRelatedLocationNil
        _ -> DiagnosticRelatedLocationCons(DiagnosticRelatedLocation("similarly named declaration", location), DiagnosticRelatedLocationNil)
      },
      DiagnosticFieldCons(
        DiagnosticFieldText("name", name),
        DiagnosticFieldCons(
          DiagnosticFieldText("name_kind", name_kind),
          DiagnosticFieldCons(
            DiagnosticFieldText("suggestion", spelling),
            DiagnosticFieldCons(
              DiagnosticFieldI64("suggestion_distance", distance),
              DiagnosticFieldCons(
                DiagnosticFieldText("suggestion_confidence", if distance == 1 { "high" } else { "medium" }),
                DiagnosticFieldCons(
                  DiagnosticFieldText("suggestion_origin", if rank == 0 { "local" } else { if rank == 1 { "module-scope" } else { "function-catalog" } }),
                  DiagnosticFieldCons(
                    DiagnosticFieldLocation("suggestion_declaration", location),
                    DiagnosticFieldCons(
                      DiagnosticFieldSuggestion(DiagnosticSuggestion(
                        "replace the unresolved name",
                        DiagnosticSuggestionMaybeIncorrect,
                        DiagnosticTextEditCons(DiagnosticTextEdit(primary, spelling), DiagnosticTextEditNil)
                      )),
                      DiagnosticFieldNil
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  }
}

pub(package) fn typeck_report_unknown_name(src: i64, start: i64, len: i64, env: i64, ft: i64, tt: i64, function_only: i64) -[Diagnose]> i64 {
  let name_kind = if function_only == 1 { "function" } else { "identifier" }
  Diagnose.report(typeck_unknown_name_diagnostic(src, start, len, name_kind, typeck_name_suggestion(src, start, len, env, ft, tt, function_only)))
}

-- Type environment: maps variable names to types
-- Linked list of {name_start, name_len, type, src, next, mutable,
-- value_origin, semantic_symbol_kind}
pub(package) fn tenv_new() -> i64 { 0 }

pub(package) fn tenv_bind_full_kind(env: i64, src: i64, ns: i64, nl: i64, ty: i64, mutable: i64, value_origin: i64, kind: i64) -> i64 {
  let e = alloc_words(8)
  mem_store64_at(e, 0, ns)
  mem_store64_at(e, 8, nl)
  mem_store64_at(e, 16, ty)
  mem_store64_at(e, 24, src)
  mem_store64_at(e, 32, env)
  mem_store64_at(e, 40, mutable)
  mem_store64_at(e, 48, value_origin)
  mem_store64_at(e, 56, kind)
  e
}

pub(package) fn tenv_bind_full(env: i64, src: i64, ns: i64, nl: i64, ty: i64, mutable: i64, value_origin: i64) -> i64 {
  tenv_bind_full_kind(env, src, ns, nl, ty, mutable, value_origin, semantic_symbol_kind_local())
}

pub(package) fn tenv_bind_kind(env: i64, src: i64, ns: i64, nl: i64, ty: i64, kind: i64) -> i64 {
  tenv_bind_full_kind(env, src, ns, nl, ty, 0, 0, kind)
}

pub(package) fn tenv_bind_mut_kind(env: i64, src: i64, ns: i64, nl: i64, ty: i64, kind: i64) -> i64 {
  tenv_bind_full_kind(env, src, ns, nl, ty, 1, 0, kind)
}

pub(package) fn tenv_bind_with_mut(env: i64, src: i64, ns: i64, nl: i64, ty: i64, mutable: i64) -> i64 {
  tenv_bind_full(env, src, ns, nl, ty, mutable, 0)
}

pub(package) fn tenv_bind(env: i64, src: i64, ns: i64, nl: i64, ty: i64) -> i64 {
  tenv_bind_with_mut(env, src, ns, nl, ty, 0)
}

pub(package) fn tenv_bind_value(env: i64, src: i64, ns: i64, nl: i64, ty: i64, value_origin: i64) -> i64 {
  tenv_bind_full(env, src, ns, nl, ty, 0, value_origin)
}

pub(package) fn tenv_bind_mut(env: i64, src: i64, ns: i64, nl: i64, ty: i64) -> i64 {
  tenv_bind_with_mut(env, src, ns, nl, ty, 1)
}

pub(package) fn tenv_find_entry(env: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let mut cur = env
  let mut result = 0
  while cur != 0 and result == 0 {
    let e_ns = mem_load64_at(cur, 0)
    let e_nl = mem_load64_at(cur, 8)
    let e_src = mem_load64_at(cur, 24)
    if e_nl == nl and src_eq_at(src, ns, e_src + e_ns, 0, nl) == 1 {
      result = cur
    } else { cur = mem_load64_at(cur, 32) }
  }
  result
}

pub(package) fn tenv_entry_name_start(entry: i64) -> i64 { mem_load64_at(entry, 0) }
pub(package) fn tenv_entry_name_len(entry: i64) -> i64 { mem_load64_at(entry + 8, 0) }
pub(package) fn tenv_entry_type(entry: i64) -> i64 { mem_load64_at(entry + 16, 0) }
pub(package) fn tenv_entry_source(entry: i64) -> i64 { mem_load64_at(entry + 24, 0) }
pub(package) fn tenv_entry_kind(entry: i64) -> i64 { mem_load64_at(entry + 56, 0) }
pub(package) fn tenv_entry_mutable(entry: i64) -> i64 { mem_load64_at(entry + 40, 0) }
pub(package) fn tenv_entry_value_origin(entry: i64) -> i64 { mem_load64_at(entry + 48, 0) }

pub(package) fn tenv_refine_type(env: i64, entry: i64, ty: i64) -> i64 {
  tenv_bind_full_kind(
    env,
    tenv_entry_source(entry),
    tenv_entry_name_start(entry),
    tenv_entry_name_len(entry),
    ty,
    tenv_entry_mutable(entry),
    tenv_entry_value_origin(entry),
    tenv_entry_kind(entry)
  )
}

pub(package) fn tenv_lookup(env: i64, src: i64, ns: i64, nl: i64) -> i64 {
  if env == 0 { 0 }
  else {
    let e_ns = mem_load64_at(env, 0)
    let e_nl = mem_load64_at(env, 8)
    let e_src = mem_load64_at(env, 24)
    if e_nl == nl {
      if src_eq_at(src, ns, e_src + e_ns, 0, nl) == 1 {
        mem_load64_at(env, 16)
      } else { tenv_lookup(mem_load64_at(env, 32), src, ns, nl) }
    } else { tenv_lookup(mem_load64_at(env, 32), src, ns, nl) }
  }
}

pub(package) fn tenv_lookup_value(env: i64, src: i64, ns: i64, nl: i64) -> i64 {
  if env == 0 { 0 }
  else {
    let e_ns = mem_load64_at(env, 0)
    let e_nl = mem_load64_at(env, 8)
    let e_src = mem_load64_at(env, 24)
    if e_nl == nl {
      if src_eq_at(src, ns, e_src + e_ns, 0, nl) == 1 {
        mem_load64_at(env, 48)
      } else { tenv_lookup_value(mem_load64_at(env, 32), src, ns, nl) }
    } else { tenv_lookup_value(mem_load64_at(env, 32), src, ns, nl) }
  }
}

pub(package) fn tenv_lookup_mutable(env: i64, src: i64, ns: i64, nl: i64) -> i64 {
  if env == 0 { 0 }
  else {
    let e_ns = mem_load64_at(env, 0)
    let e_nl = mem_load64_at(env, 8)
    let e_src = mem_load64_at(env, 24)
    if e_nl == nl {
      if src_eq_at(src, ns, e_src + e_ns, 0, nl) == 1 {
        mem_load64_at(env, 40)
      } else { tenv_lookup_mutable(mem_load64_at(env, 32), src, ns, nl) }
    } else { tenv_lookup_mutable(mem_load64_at(env, 32), src, ns, nl) }
  }
}

-- Function type table: maps function names to {param_types, ret_type}
-- For now, a simple list. Built during pass 1 of type checking.
pub(package) fn ftypes_new() -> i64 { nlist_new() }

pub(package) fn ftypes_new_with_ttable(tt: i64) -> i64 {
  let ft = nlist_new()
  -- The index-cache node's tag carries the semantic context without changing
  -- every lookup signature. f1..f4 retain the existing cache contract.
  mem_store64_at(ft, 24, node_new(tt, 0, 0, ft, ftypes_index_magic()))
  ft
}

pub(package) fn ftypes_add(ft: i64, src: i64, ns: i64, nl: i64, ret_ty: i64, params: i64, effects: i64, tparams: i64) -> i64 {
  let e = alloc_words(11)
  mem_store64_at(e, 0, ns)
  mem_store64_at(e, 8, nl)
  mem_store64_at(e, 16, ret_ty)
  mem_store64_at(e, 24, src)
  mem_store64_at(e, 32, params)
  mem_store64_at(e, 40, effects)
  mem_store64_at(e, 48, tparams)
  mem_store64_at(e, 56, 0)
  -- Same-name collision chain (offset 64): distinct declarations sharing a
  -- name hash link here so lookups can prefer the caller's own source.
  mem_store64_at(e, 64, 0)
  -- offset 72: nonzero when this entry is an impl method registered under
  -- its bare name; such entries never shadow plain functions.
  mem_store64_at(e, 72, 0)
  -- offset 80: producer-owned declaration identity. Inherent methods carry
  -- their member DeclId; trait-impl compatibility entries have no second
  -- declaration and remain zero because they satisfy the trait member.
  mem_store64_at(e, 80, 0)
  nlist_add(ft, e)
  e
}

pub(package) fn ftypes_bind_decl_fact(entry: i64, tt: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let decl = module_decl_fact_find(tt, src, module_decl_namespace_value(), src, ns, nl)
  if decl != 0 and module_decl_fact_owner(decl) == 0 { mem_store64_at(entry, 80, decl) } else { 0 }
  decl
}

pub(package) fn ftypes_entry_decl_fact(entry: i64) -> i64 { if entry == 0 { 0 } else { mem_load64_at(entry, 80) } }

-- Function-type lookups were linear byte-compare scans per call
-- expression; a hash-ordered tree in the list's fourth header word
-- answers them. Finds interleave with adds during setup, so the index
-- tops up incrementally: on a length change only the new entries are
-- inserted (first-wins, matching the scan's first-declaration
-- resolution). Rollback-reused cache memory is rejected by the
-- owner + magic + monotone-length guard.
pub(package) fn ftypes_index_magic() -> i64 { 91542376012 }

pub(package) fn ftypes_index_insert(tree: i64, hash: i64, entry: i64) -> i64 {
  let leaf = node_new(0, hash, entry, 0, 0)
  if tree == 0 { leaf }
  else {
    let mut cur = tree
    let mut done = 0
    while done == 0 {
      let cur_hash = node_f1(cur)
      if hash < cur_hash {
        if node_f3(cur) == 0 {
          mem_store64_at(cur, 24, leaf)
          done = 1
        } else { cur = node_f3(cur) }
      } else { if hash > cur_hash {
        if node_f4(cur) == 0 {
          mem_store64_at(cur, 32, leaf)
          done = 1
        } else { cur = node_f4(cur) }
      } else {
        -- Same hash: keep first-wins head, chain the newcomer so lookups
        -- can prefer an entry declared in the caller's source.
        let mut chain = node_f2(cur)
        let mut linked = 0
        while linked == 0 {
          if chain == entry { linked = 1 }
          else { if mem_load64_at(chain, 64) == 0 {
            mem_store64_at(chain, 64, entry)
            linked = 1
          } else { chain = mem_load64_at(chain, 64) } }
        }
        done = 1
      } }
    }
    tree
  }
}

pub(package) fn ftypes_index(ft: i64) -> i64 {
  let n = nlist_len(ft)
  let cached = mem_load64_at(ft, 24)
  let valid = if cached != 0 {
    if node_f3(cached) == ft and node_f4(cached) == ftypes_index_magic() and node_f2(cached) <= n { 1 } else { 0 }
  } else { 0 }
  if valid == 1 and node_f2(cached) == n {
    node_f1(cached)
  } else {
    let mut tree = if valid == 1 { node_f1(cached) } else { 0 }
    let mut i = if valid == 1 { node_f2(cached) } else { 0 }
    while i < n {
      let e = nlist_get(ft, i)
      tree = ftypes_index_insert(tree, str_hash(mem_load64_at(e, 24), mem_load64_at(e, 0), mem_load64_at(e, 8)), e)
      i = i + 1
    }
    let context_tt = if valid == 1 { node_tag(cached) } else { 0 }
    mem_store64_at(ft, 24, node_new(context_tt, tree, n, ft, ftypes_index_magic()))
    tree
  }
}

pub(package) fn ftypes_context_ttable(ft: i64) -> i64 {
  let cached = mem_load64_at(ft, 24)
  if cached != 0 and node_f3(cached) == ft and node_f4(cached) == ftypes_index_magic() { node_tag(cached) } else { 0 }
}

pub(package) fn ftypes_entry_name_eq(entry: i64, name_ptr: i64, name_len: i64) -> i64 {
  if mem_load64_at(entry, 8) != name_len { 0 }
  else { src_eq_at(mem_load64_at(entry, 24), mem_load64_at(entry, 0), name_ptr, 0, name_len) }
}

pub(package) fn ftypes_find_hash_head(tree: i64, hash: i64) -> i64 {
  let mut cur = tree
  let mut result = 0
  while cur != 0 and result == 0 {
    let cur_hash = node_f1(cur)
    if hash == cur_hash { result = node_f2(cur) }
    else { if hash < cur_hash { cur = node_f3(cur) } else { cur = node_f4(cur) } }
  }
  result
}

pub(package) fn ftypes_find(ft: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let tree = ftypes_index(ft)
  let tt = ftypes_context_ttable(ft)
  let caller_module = if tt == 0 { 0 } else { module_fact_find_source(tt, src) }
  let value_decl = if caller_module == 0 { 0 }
    else { module_scope_lookup_declaration(tt, src, module_decl_namespace_value(), src, ns, nl) }
  let scoped_ctor_decl = if caller_module == 0 { 0 }
    else { module_scope_lookup_declaration(tt, src, module_decl_namespace_constructor(), src, ns, nl) }
  let local_ctor_decl = if caller_module == 0 { 0 }
    else { module_decl_fact_find(tt, src, module_decl_namespace_constructor(), src, ns, nl) }
  let local_type_decl = if caller_module == 0 { 0 }
    else { module_decl_fact_find(tt, src, module_decl_namespace_type(), src, ns, nl) }
  let local_opaque_decl = if local_type_decl == 0 { 0 }
    else {
      let local_type_entry = ttable_lookup_decl_fact(tt, local_type_decl)
      if local_type_entry != 0 and mem_load64_at(local_type_entry, 16) == 5 { local_type_decl } else { 0 }
    }
  let resolved_decl = if value_decl != 0 { value_decl }
    else { if scoped_ctor_decl != 0 { scoped_ctor_decl }
    else { if local_ctor_decl != 0 { local_ctor_decl } else { local_opaque_decl } } }
  let lookup_ptr = if resolved_decl == 0 { src + ns } else { module_decl_fact_name_ptr(resolved_decl) }
  let lookup_len = if resolved_decl == 0 { nl } else { module_decl_fact_name_len(resolved_decl) }
  let hash = str_hash(lookup_ptr, 0, lookup_len)
  let head = ftypes_find_hash_head(tree, hash)
  let mut result = 0
  if resolved_decl != 0 {
    -- Aliases and diamonds terminate here: only the exact origin identity is
    -- eligible, independent of spelling or declaration order.
    let mut chain = head
    while chain != 0 and result == 0 {
      if ftypes_entry_decl_fact(chain) == resolved_decl { result = chain }
      else { chain = mem_load64_at(chain, 64) }
    }
  } else { if caller_module != 0 {
    -- A registered module with no resolved binding never falls through to an
    -- unrelated short-name entry. Constructors and functions carry DeclId;
    -- methods resolve through their owner-specific path.
    result = 0
  } else {
    -- Ttable-less internal callers retain the raw catalog bridge.
    let mut chain = head
    while chain != 0 {
      if ftypes_entry_name_eq(chain, lookup_ptr, lookup_len) == 1 {
        if result == 0 { result = chain } else { 0 }
        if mem_load64_at(chain, 24) == src and mem_load64_at(chain, 72) == 0 { result = chain }
      } else { 0 }
      chain = mem_load64_at(chain, 64)
    }
  } }
  result
}

pub(package) fn ftypes_find_decl(ft: i64, decl: i64) -> i64 {
  if decl == 0 { 0 }
  else {
    let tree = ftypes_index(ft)
    let head = ftypes_find_hash_head(tree, str_hash(module_decl_fact_name_ptr(decl), 0, module_decl_fact_name_len(decl)))
    let mut chain = head
    let mut result = 0
    while chain != 0 and result == 0 {
      if ftypes_entry_decl_fact(chain) == decl { result = chain }
      else { chain = mem_load64_at(chain, 64) }
    }
    result
  }
}

pub(package) fn ftypes_entry_return_type(entry: i64) -> i64 { if entry == 0 { 0 } else { mem_load64_at(entry, 16) } }
pub(package) fn ftypes_entry_params(entry: i64) -> i64 { if entry == 0 { 0 } else { mem_load64_at(entry, 32) } }
pub(package) fn ftypes_entry_effects(entry: i64) -> i64 { if entry == 0 { 0 } else { mem_load64_at(entry, 40) } }
pub(package) fn ftypes_entry_tparams(entry: i64) -> i64 { if entry == 0 { 0 } else { mem_load64_at(entry, 48) } }
pub(package) fn ftypes_entry_source(entry: i64) -> i64 { if entry == 0 { 0 } else { mem_load64_at(entry, 24) } }
pub(package) fn ftypes_entry_name_start(entry: i64) -> i64 { if entry == 0 { 0 } else { mem_load64_at(entry, 0) } }
pub(package) fn ftypes_entry_name_len(entry: i64) -> i64 { if entry == 0 { 0 } else { mem_load64_at(entry, 8) } }

pub(package) fn ftypes_entry_fn_type(entry: i64) -> i64 {
  if entry == 0 { 0 }
  else { ty_fn(param_type_list(ftypes_entry_params(entry)), ftypes_entry_return_type(entry), ftypes_entry_effects(entry)) }
}

pub(package) fn ftypes_add_module_decl(ft: i64, tt: i64, src: i64, ns: i64, nl: i64, ret_ty: i64, params: i64, effects: i64, tparams: i64) -> i64 {
  let entry = ftypes_add(ft, src, ns, nl, ret_ty, params, effects, tparams)
  ftypes_bind_decl_fact(entry, tt, src, ns, nl)
  entry
}

pub(package) fn ftypes_set_body_entry(entry: i64, body: i64) -> i64 {
  if entry == 0 { 0 }
  else {
    mem_store64_at(entry, 56, body)
    1
  }
}

pub(package) fn ftypes_set_body(ft: i64, src: i64, ns: i64, nl: i64, body: i64) -> i64 {
  let e = ftypes_find(ft, src, ns, nl)
  if e == 0 { 0 } else { mem_store64_at(e, 56, body) 1 }
}

pub(package) fn ftypes_lookup_body(ft: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let e = ftypes_find(ft, src, ns, nl)
  if e == 0 { 0 } else { mem_load64_at(e, 56) }
}

-- Look up return type
pub(package) fn ftypes_lookup(ft: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let e = ftypes_find(ft, src, ns, nl)
  if e == 0 { 0 } else { mem_load64_at(e, 16) }
}

-- Look up params list for a function
pub(package) fn ftypes_lookup_params(ft: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let e = ftypes_find(ft, src, ns, nl)
  if e == 0 { 0 } else { mem_load64_at(e, 32) }
}

-- Look up effects for a function
pub(package) fn ftypes_lookup_effects(ft: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let e = ftypes_find(ft, src, ns, nl)
  if e == 0 { 0 } else { mem_load64_at(e, 40) }
}

-- Look up type params for a function (for generics)
pub(package) fn ftypes_lookup_tparams(ft: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let e = ftypes_find(ft, src, ns, nl)
  if e == 0 { 0 } else { mem_load64_at(e, 48) }
}

pub(package) fn param_type_list(params: i64) -> i64 {
  let result = nlist_new()
  let n = nlist_len(params)
  for i in 0..n {
    let p = nlist_get(params, i)
    let ty = node_f3(p)
    if ty != 0 { nlist_add(result, ty) }
    else { nlist_add(result, ty_any()) }
  }
  result
}

pub(package) fn ftypes_lookup_fn_type(ft: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let ret = ftypes_lookup(ft, src, ns, nl)
  if ret == 0 { 0 }
  else {
    let params = ftypes_lookup_params(ft, src, ns, nl)
    let effects = ftypes_lookup_effects(ft, src, ns, nl)
    ty_fn(param_type_list(params), ret, effects)
  }
}

-- ══════════════════════════════════════════════════════════════
-- Conformance table: maps a concrete target pattern and trait to an impl.
-- Entry: [head_hash, trait_hash, methods, impl_tparams, target_ty, trait_decl,
--         impl_src, impl_span] = 64 bytes. The final two words are diagnostic
-- provenance captured when the fact is produced; conformance consumers never
-- have to find an impl by rescanning declarations.
-- Used by the DNF emptiness checker to determine if
-- a conjunction like `i64 & Display` is satisfiable.
-- ══════════════════════════════════════════════════════════════

pub(package) fn ctable_new() -> i64 {
  let h = alloc_words(4)
  let d = alloc_words(4000)
  mem_store64_at(h, 0, d)
  mem_store64_at(h, 8, 0)
  mem_store64_at(h, 16, 500)
  mem_store64_at(h, 24, 0)
  h
}

pub(package) fn ctable_set_ttable(ct: i64, tt: i64) -> i64 {
  if ct == 0 { 0 } else { mem_store64_at(ct, 24, tt) }
}

pub(package) fn ctable_ttable(ct: i64) -> i64 {
  if ct == 0 { 0 } else { mem_load64_at(ct, 24) }
}

pub(package) fn typeck_sendable_trait_hash() -> i64 {
  effect_name_hash(__str_ptr("Sendable"), 0, 8)
}

pub(package) fn ctable_add_pattern_ref_at(ct: i64, type_hash: i64, trait_hash: i64, trait_decl: i64, methods: i64, impl_tp: i64, target_ty: i64, impl_src: i64, impl_start: i64, impl_len: i64) -> i64 {
  let d = mem_load64_at(ct, 0)
  let n = mem_load64_at(ct, 8)
  let cap = mem_load64_at(ct, 16)
  if n >= cap { ct }
  else {
    mem_store64_at(d, n * 64, type_hash)
    mem_store64_at(d, n * 64 + 8, trait_hash)
    mem_store64_at(d, n * 64 + 16, methods)
    mem_store64_at(d, n * 64 + 24, impl_tp)
    mem_store64_at(d, n * 64 + 32, target_ty)
    mem_store64_at(d, n * 64 + 40, trait_decl)
    mem_store64_at(d, n * 64 + 48, impl_src)
    mem_store64_at(d, n * 64 + 56, if impl_src == 0 { 0 } else { node_new(0, impl_start, impl_len, 0, 0) })
    mem_store64_at(ct, 8, n + 1)
    ct
  }
}

pub(package) fn ctable_add_pattern_ref(ct: i64, type_hash: i64, trait_hash: i64, trait_decl: i64, methods: i64, impl_tp: i64, target_ty: i64) -> i64 {
  ctable_add_pattern_ref_at(ct, type_hash, trait_hash, trait_decl, methods, impl_tp, target_ty, 0, 0, 0)
}

pub(package) fn ctable_add_pattern(ct: i64, type_hash: i64, trait_hash: i64, methods: i64, impl_tp: i64, target_ty: i64) -> i64 {
  ctable_add_pattern_ref(ct, type_hash, trait_hash, 0, methods, impl_tp, target_ty)
}

pub(package) fn ctable_add_full(ct: i64, type_hash: i64, trait_hash: i64, methods: i64, impl_tp: i64) -> i64 {
  ctable_add_pattern(ct, type_hash, trait_hash, methods, impl_tp, 0)
}

pub(package) fn ctable_add(ct: i64, type_hash: i64, trait_hash: i64, methods: i64) -> i64 {
  ctable_add_full(ct, type_hash, trait_hash, methods, 0)
}

-- Check if (type_hash, trait_hash) exists in the conformance table.
-- For conditional impls with tparams, recursively checks that the
-- type args satisfy the impl's bounds.
pub(package) fn ctable_conforms(ct: i64, type_hash: i64, trait_hash: i64) -> i64 {
  if ct == 0 { false }
  else {
    let d = mem_load64_at(ct, 0)
    let n = mem_load64_at(ct, 8)
    let mut i = 0
    let mut found = false
    while i < n {
      if mem_load64_at(d, i * 64) == type_hash {
        if mem_load64_at(d, i * 64 + 8) == trait_hash {
          found = true
          i = n
        } else { i = i + 1 }
      } else { i = i + 1 }
    }
    found
  }
}

pub(package) fn ctable_impl_bounds_hold(ct: i64, tparams: i64, subst: i64) -> i64 {
  if tparams == 0 { 1 }
  else {
    let mut ok = 1
    let mut i = 0
    while i < nlist_len(tparams) and ok == 1 {
      let tp = nlist_get(tparams, i)
      let arg = subst_lookup(subst, node_f3(tp))
      let bounds = node_f4(tp)
      if arg == 0 { ok = 0 }
      else { if bounds != 0 {
        let mut bi = 0
        while bi < nlist_len(bounds) and ok == 1 {
          let required = ty_subst(nlist_get(bounds, bi), subst)
          if ctable_conforms_type_atom(ct, arg, required) == 1 and typeck_trait_assoc_constraints_hold(ctable_ttable(ct), arg, required) == 1 {
            bi = bi + 1
          } else { ok = 0 }
        }
      } else { 0 } }
      i = i + 1
    }
    ok
  }
}

pub(package) fn ctable_conforms_type_atom(ct: i64, concrete_ty: i64, trait_atom: i64) -> i64 {
  let trait_hash = trait_atom_head(trait_atom)
  let trait_decl = trait_atom_decl(trait_atom)
  if concrete_ty == 0 { 0 }
  else { if trait_hash == typeck_sendable_trait_hash() {
    let fact = typeck_sendability_type(ctable_ttable(ct), concrete_ty)
    let value_needs = typeck_sendability_needs_capture_proof() bor typeck_sendability_needs_scoped_borrow()
    if typeck_sendability_fact_decision(fact) == typeck_sendability_decision_yes() and (typeck_sendability_fact_needs(fact) band value_needs) == 0 { 1 } else { 0 }
  } else { if ct == 0 { 0 }
  else {
    let concrete_hash = type_hash_of(concrete_ty)
    let d = mem_load64_at(ct, 0)
    let n = mem_load64_at(ct, 8)
    let mut i = 0
    let mut found = 0
    while i < n and found == 0 {
      let entry = d + i * 64
      let entry_decl = mem_load64_at(entry, 40)
      let same_trait = mem_load64_at(entry, 8) == trait_hash and (trait_decl == 0 or entry_decl == 0 or entry_decl == trait_decl)
      if mem_load64_at(entry, 0) == concrete_hash and same_trait {
        let target_ty = mem_load64_at(entry, 32)
        let tparams = mem_load64_at(entry, 24)
        let subst = subst_new()
        let matches = if target_ty == 0 { true }
        else { if tparams == 0 {
          if ty_eq(target_ty, concrete_ty) { true }
          else { ty_tag(target_ty) == 9 and not ty_named_is_opaque(target_ty) and not ty_named_is_opaque(concrete_ty) and ty_f1(target_ty) == concrete_hash and ty_f3(target_ty) == 0 }
        }
        else { ty_pattern_match(target_ty, concrete_ty, subst) } }
        if matches and ctable_impl_bounds_hold(ct, tparams, subst) == 1 { found = 1 } else { i = i + 1 }
      } else { i = i + 1 }
    }
    found
  } } }
}

pub(package) fn ctable_conforms_type(ct: i64, concrete_ty: i64, trait_hash: i64) -> i64 {
  ctable_conforms_type_atom(ct, concrete_ty, ty_trait(trait_hash))
}

pub(package) fn ctable_has_overlapping_target_ref(ct: i64, type_hash: i64, trait_hash: i64, trait_decl: i64, target_ty: i64) -> i64 {
  if ct == 0 { 0 }
  else {
    let d = mem_load64_at(ct, 0)
    let n = mem_load64_at(ct, 8)
    let mut i = 0
    let mut found = 0
    while i < n and found == 0 {
      let entry = d + i * 64
      let existing_decl = mem_load64_at(entry, 40)
      let same_trait = mem_load64_at(entry, 8) == trait_hash and (trait_decl == 0 or existing_decl == 0 or existing_decl == trait_decl)
      if mem_load64_at(entry, 0) == type_hash and same_trait {
        let existing_target = mem_load64_at(entry, 32)
        let existing_mode = typeck_impl_receiver_ownership_mode(existing_target)
        let target_mode = typeck_impl_receiver_ownership_mode(target_ty)
        let qualifier_erasure_overlap = if existing_mode == target_mode or (existing_mode != 0 and target_mode != 0) { false }
          else {
            let existing_inner = if existing_mode == 0 { existing_target }
              else { if ty_is_unique(existing_target) { ty_unique_inner(existing_target) } else { ty_owned_inner(existing_target) } }
            let target_inner = if target_mode == 0 { target_ty }
              else { if ty_is_unique(target_ty) { ty_unique_inner(target_ty) } else { ty_owned_inner(target_ty) } }
            ty_patterns_overlap(existing_inner, target_inner)
          }
        if existing_target == 0 or target_ty == 0 or ty_patterns_overlap(existing_target, target_ty) or qualifier_erasure_overlap { found = 1 } else { i = i + 1 }
      } else { i = i + 1 }
    }
    found
  }
}


pub(package) fn ctable_has_overlapping_target(ct: i64, type_hash: i64, trait_hash: i64, target_ty: i64) -> i64 {
  ctable_has_overlapping_target_ref(ct, type_hash, trait_hash, 0, target_ty)
}

-- Build conformance table from impl blocks in the ttable
-- Scans for kind=4 entries (impl blocks) and registers conformances
-- Look up a trait declaration in the ttable by name hash.
-- Returns the methods list (nlist of tag-39 nodes), or 0 if not found.
pub(package) fn lookup_trait_methods(tt: i64, src: i64, trait_hash: i64) -> i64 {
  if tt == 0 { 0 }
  else {
    let n = mem_load64_at(tt, 8)
    let d = mem_load64_at(tt, 0)
    let mut i = 0
    let mut result = 0
    while i < n {
      let kind = mem_load64_at(d, i * 64 + 16)
      if kind == 3 {
        let t_ns = mem_load64_at(d, i * 64)
        let t_nl = mem_load64_at(d, i * 64 + 8)
        let t_src = mem_load64_at(d, i * 64 + 48)
        let t_hash = effect_name_hash(t_src, t_ns, t_nl)
        if t_hash == trait_hash {
          result = mem_load64_at(d, i * 64 + 32)
          i = n
        } else { i = i + 1 }
      } else { i = i + 1 }
    }
    result
  }
}

pub(package) fn lookup_trait_entry_ref(tt: i64, trait_hash: i64, trait_decl: i64) -> i64 {
  if trait_decl != 0 { ttable_lookup_decl_fact(tt, trait_decl) }
  else { ttable_find_entry_by_hash_kind(tt, trait_hash, 3) }
}

pub(package) fn lookup_trait_methods_ref(tt: i64, src: i64, trait_hash: i64, trait_decl: i64) -> i64 {
  let entry = lookup_trait_entry_ref(tt, trait_hash, trait_decl)
  if entry == 0 { 0 } else { mem_load64_at(entry, 32) }
}

pub(package) fn check_impl_orphan_rule_ref(tt: i64, impl_src: i64, type_hash: i64, trait_hash: i64, trait_decl: i64, target_ty: i64, diag_pos: i64) -[Diagnose]> i64 {
  let trait_entry = lookup_trait_entry_ref(tt, trait_hash, trait_decl)
  -- Legacy unknown-trait impls retain their existing diagnostic behavior.
  -- Once a trait is known, however, its coherence boundary is enforceable.
  if trait_entry == 0 { 0 }
  else {
    let target_head = typeck_impl_target_head_type(target_ty)
    let exact_opaque = if ty_named_is_opaque(target_head) { ttable_lookup_decl_fact(tt, ty_named_opaque_declaration(target_head)) } else { 0 }
    let record_entry = if exact_opaque != 0 { 0 } else { ttable_find_entry_by_hash_kind(tt, type_hash, 0) }
    let variant_entry = if record_entry != 0 { 0 } else { ttable_find_entry_by_hash_kind(tt, type_hash, 1) }
    let type_entry = if exact_opaque != 0 { exact_opaque }
      else { if record_entry != 0 { record_entry } else { variant_entry } }
    -- Coherence is package-owned, not file-owned. A package may organise a
    -- public type, its protocol, and its implementation across focused
    -- modules without turning that ordinary namespace split into an orphan.
    let impl_module = module_fact_find_source(tt, impl_src)
    let trait_module = module_fact_find_source(tt, mem_load64_at(trait_entry, 48))
    let type_module = if type_entry == 0 { 0 } else { module_fact_find_source(tt, mem_load64_at(type_entry, 48)) }
    let trait_local = impl_module != 0 and trait_module != 0 and module_scope_same_package(impl_module, trait_module) == 1
    let type_local = impl_module != 0 and type_module != 0 and module_scope_same_package(impl_module, type_module) == 1
    if trait_local or type_local { 0 }
    else {
      typeck_error_maybe(impl_src, diag_pos, "type error: orphan impl is not allowed — define the trait or target type in this package")
      1
    }
  }
}

pub(package) fn check_impl_orphan_rule(tt: i64, impl_src: i64, type_hash: i64, trait_hash: i64, diag_pos: i64) -[Diagnose]> i64 {
  check_impl_orphan_rule_ref(tt, impl_src, type_hash, trait_hash, 0, 0, diag_pos)
}

-- Verify that an impl block's methods match the trait declaration.
-- Returns number of errors found.
pub(package) fn effect_sig_is_empty(eff: i64) -> bool {
  if eff == 0 { true }
  else {
    if ty_tag(eff) != 10 { true }
    else { nlist_len(ty_f1(eff)) == 0 and ty_f2(eff) == 0 }
  }
}

pub(package) fn effect_sig_subset(actual: i64, expected: i64) -> bool {
  if actual == 0 { true }
  else {
    if expected == 0 { effect_sig_is_empty(actual) }
    else { effect_is_subset(actual, expected) }
  }
}

pub(package) fn param_type_or_any(param: i64) -> i64 {
  let ty = node_f3(param)
  if ty != 0 { ty } else { ty_any() }
}

pub(package) fn trait_method_ret_or_any(method: i64) -> i64 {
  let ret_wrap = node_f4(method)
  if ret_wrap == 0 { ty_any() }
  else {
    let ret_ty = node_f1(ret_wrap)
    if ret_ty != 0 { ret_ty } else { ty_any() }
  }
}

pub(package) fn trait_method_effects(method: i64) -> i64 {
  let ret_wrap = node_f4(method)
  if ret_wrap == 0 { 0 } else { node_f2(ret_wrap) }
}

-- Receiver-ness is a declaration fact, not an arity convention. Associated
-- functions may accept any number of ordinary parameters; only a leading
-- parameter literally named `self` makes a method an instance method.
pub(package) fn typeck_method_params_have_receiver(params: i64, src: i64) -> i64 {
  if params == 0 or nlist_len(params) == 0 { 0 }
  else {
    let first = nlist_get(params, 0)
    if src_eq(src, node_f1(first), node_f2(first), "self") == 1 { 1 } else { 0 }
  }
}

-- Ownership is part of a qualified protocol receiver's declaration identity.
-- Ordinary subtyping intentionally permits `unique T`/`owned T` where a plain
-- `T` value is expected, but using that erasure while verifying `self` would
-- make an implementation advertise a consuming capability that its method did
-- not actually accept.
pub(package) fn typeck_impl_receiver_ownership_mode(ty: i64) -> i64 {
  if ty_is_unique(ty) { 1 }
  else { if ty_is_owned(ty) { 2 }
  else { if ty_is_borrow(ty) { 3 + ty_borrow_mutable(ty) }
  else { 0 } } }
}

pub(package) fn typeck_impl_receiver_ownership_matches(expected: i64, actual: i64) -> bool {
  typeck_impl_receiver_ownership_mode(expected) == typeck_impl_receiver_ownership_mode(actual)
}

pub(package) fn check_impl_method_signature(trait_method: i64, impl_method: i64, impl_methods: i64, src: i64, trait_src: i64, type_ns: i64, self_ty: i64) -[Conformance, Diagnose]> i64 {
  let impl_inner = fn_inner(impl_method)
  let trait_params = node_f3(trait_method)
  let impl_params = node_f3(impl_inner)
  let self_subst = subst_new()
  subst_add(self_subst, 0 - 1, self_ty)
  let ntrait = nlist_len(trait_params)
  let nimpl = nlist_len(impl_params)
  let mut errors = 0
  if typeck_method_params_have_receiver(trait_params, trait_src) != typeck_method_params_have_receiver(impl_params, src) {
    typeck_error_maybe(src, type_ns, "type error: impl method receiver kind mismatch")
    errors = errors + 1
  } else { errors = errors }
  if nimpl != ntrait {
    typeck_error_maybe(src, type_ns, "type error: impl method arity mismatch")
    errors = errors + 1
  } else {
    for pi in 0..ntrait {
      let trait_param_ty = parse_assoc_resolve_type(ty_subst(param_type_or_any(nlist_get(trait_params, pi)), self_subst), impl_methods, src, self_ty)
      let impl_param_ty = param_type_or_any(nlist_get(impl_params, pi))
      let receiver_ownership_matches = if pi == 0 and typeck_method_params_have_receiver(trait_params, trait_src) == 1 {
        typeck_impl_receiver_ownership_matches(trait_param_ty, impl_param_ty)
      } else { true }
      if not receiver_ownership_matches or not is_subtype(trait_param_ty, impl_param_ty) {
        typeck_error_maybe(src, type_ns, "type error: impl method parameter type mismatch")
        errors = errors + 1
      } else { errors = errors }
    }
  }
  let trait_ret = parse_assoc_resolve_type(ty_subst(trait_method_ret_or_any(trait_method), self_subst), impl_methods, src, self_ty)
  let impl_ret = fn_ret_type(impl_method)
  if not is_subtype(impl_ret, trait_ret) {
    typeck_error_maybe(src, type_ns, "type error: impl method return type mismatch")
    errors = errors + 1
  } else { errors = errors }
  let trait_eff = parse_assoc_resolve_type(ty_subst(trait_method_effects(trait_method), self_subst), impl_methods, src, self_ty)
  let impl_eff = fn_effects(impl_method)
  if not effect_sig_subset(impl_eff, trait_eff) {
    typeck_error_maybe(src, type_ns, "type error: impl method effect mismatch")
    errors = errors + 1
  } else { errors = errors }
  errors
}

pub(package) fn trait_has_assoc_type(trait_methods: i64, trait_src: i64, assoc_hash: i64) -> bool {
  let ntrait = nlist_len(trait_methods)
  let mut found = false
  let mut ti = 0
  while ti < ntrait {
    let tm = nlist_get(trait_methods, ti)
    if node_tag(tm) == 42 {
      let tm_hash = effect_name_hash(trait_src, node_f1(tm), node_f2(tm))
      if tm_hash == assoc_hash {
        found = true
        ti = ntrait
      } else { ti = ti + 1 }
    } else { ti = ti + 1 }
  }
  found
}

pub(package) fn impl_tparam_has_bound(tparams: i64, var_id: i64, trait_atom: i64) -> bool {
  if tparams == 0 { false }
  else {
    let mut found = false
    let mut i = 0
    while i < nlist_len(tparams) and not found {
      let tp = nlist_get(tparams, i)
      if node_f3(tp) == var_id {
        let bounds = node_f4(tp)
        let mut bi = 0
        while bounds != 0 and bi < nlist_len(bounds) and not found {
          if trait_atom_eq(nlist_get(bounds, bi), trait_atom) { found = true } else { bi = bi + 1 }
        }
        i = nlist_len(tparams)
      } else { i = i + 1 }
    }
    found
  }
}

pub(package) fn check_impl_assoc_type(trait_member: i64, impl_methods: i64, impl_tparams: i64, impl_src: i64, trait_src: i64, type_ns: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let tm_ns = node_f1(trait_member)
  let tm_nl = node_f2(trait_member)
  let tm_hash = effect_name_hash(trait_src, tm_ns, tm_nl)
  let nimpl = if impl_methods == 0 { 0 } else { nlist_len(impl_methods) }
  let mut found = false
  let mut binding_ty = 0
  let mut binding = 0
  let mut errors = 0
  for ii in 0..nimpl {
    let im = nlist_get(impl_methods, ii)
    if node_tag(im) == 43 {
      let im_hash = effect_name_hash(impl_src, node_f1(im), node_f2(im))
      if im_hash == tm_hash {
        if found {
          typeck_error_maybe(impl_src, type_ns, "type error: duplicate associated type binding")
          errors = errors + 1
        } else {
          found = true
          binding_ty = node_f3(im)
          binding = im
        }
      } else { errors = errors }
    } else { errors = errors }
  }
  if not found {
    typeck_error_maybe(impl_src, type_ns, "type error: impl missing required associated type")
    errors = errors + 1
  } else {
    let bounds = node_f3(trait_member)
    if bounds != 0 {
      for bi in 0..nlist_len(bounds) {
        let bound = nlist_get(bounds, bi)
        let satisfies = if ty_tag(binding_ty) == 12 and not ty_is_self(binding_ty) {
          impl_tparam_has_bound(impl_tparams, ty_var_id(binding_ty), bound)
        } else { Conformance.conforms(binding_ty, bound) == 1 }
        if not satisfies {
          let binding_location = if binding == 0 { 0 } else { node_f4(binding) }
          let primary_start = if binding_location == 0 { if binding == 0 { type_ns } else { node_f1(binding) } } else { node_f1(binding_location) }
          let primary_len = if binding_location == 0 { if binding == 0 { 1 } else { node_f2(binding) } } else { node_f2(binding_location) }
          let bound_location = typeck_type_list_location(bounds, bi, trait_src, node_f1(trait_member), node_f2(trait_member))
          typeck_report_trait_conformance(binding_ty, bound, tt, impl_src, primary_start, primary_len, bound_location, "associated type binding", impl_tparams)
          errors = errors + 1
        } else { errors = errors }
      }
    } else { errors = errors }
  }
  errors
}

pub(package) fn check_impl_extra_assoc_types(impl_methods: i64, trait_methods: i64, impl_src: i64, trait_src: i64, type_ns: i64) -[Diagnose]> i64 {
  let nimpl = if impl_methods == 0 { 0 } else { nlist_len(impl_methods) }
  let mut errors = 0
  for ii in 0..nimpl {
    let im = nlist_get(impl_methods, ii)
    if node_tag(im) == 43 {
      let im_hash = effect_name_hash(impl_src, node_f1(im), node_f2(im))
      if not trait_has_assoc_type(trait_methods, trait_src, im_hash) {
        typeck_error_maybe(impl_src, type_ns, "type error: impl associated type is not declared by trait")
        errors = errors + 1
      } else { errors = errors }
    } else { errors = errors }
  }
  errors
}

pub(package) fn verify_impl_methods(impl_methods: i64, trait_methods: i64, impl_src: i64, trait_src: i64, type_ns: i64, trait_hash: i64, self_ty: i64, impl_tparams: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  if trait_methods == 0 { 0 }
  else {
    let mut errors = 0
    -- Check each trait method is present in the impl
    let ntrait = nlist_len(trait_methods)
    let nimpl = if impl_methods == 0 { 0 } else { nlist_len(impl_methods) }
    for ti in 0..ntrait {
      let tm = nlist_get(trait_methods, ti)
      if node_tag(tm) == 39 {
        let tm_ns = node_f1(tm)
        let tm_nl = node_f2(tm)
        let tm_hash = effect_name_hash(trait_src, tm_ns, tm_nl)
        -- Search impl methods for this name
        let mut found = false
        let mut found_method = 0
        let mut ii = 0
        while ii < nimpl {
          let im = nlist_get(impl_methods, ii)
          if node_tag(im) == 23 {
            let im_inner = node_f1(im)
            let im_ns = node_f1(im_inner)
            let im_nl = node_f2(im_inner)
            let im_hash = effect_name_hash(impl_src, im_ns, im_nl)
            if im_hash == tm_hash {
              found = true
              found_method = im
              ii = nimpl
            } else { ii = ii + 1 }
          } else { ii = ii + 1 }
        }
        if not found {
          typeck_error_maybe(impl_src, type_ns, "type error: impl missing required method")
          errors = errors + 1
        } else {
          errors = errors + check_impl_method_signature(tm, found_method, impl_methods, impl_src, trait_src, type_ns, self_ty)
        }
      } else {
        if node_tag(tm) == 42 {
          errors = errors + check_impl_assoc_type(tm, impl_methods, impl_tparams, impl_src, trait_src, type_ns, tt)
        } else { errors = errors }
      }
    }
    errors = errors + check_impl_extra_assoc_types(impl_methods, trait_methods, impl_src, trait_src, type_ns)
    errors
  }
}

pub(package) fn find_impl_method_by_hash(impl_methods: i64, src: i64, method_hash: i64) -> i64 {
  let nimpl = if impl_methods == 0 { 0 } else { nlist_len(impl_methods) }
  let mut result = 0
  let mut ii = 0
  while ii < nimpl {
    let im = nlist_get(impl_methods, ii)
    if node_tag(im) == 23 {
      let im_inner = node_f1(im)
      let im_hash = effect_name_hash(src, node_f1(im_inner), node_f2(im_inner))
      if im_hash == method_hash {
        result = im
        ii = nimpl
      } else { ii = ii + 1 }
    } else { ii = ii + 1 }
  }
  result
}

pub(package) fn check_drop_impl_method_shape(impl_method: i64, impl_self_ty: i64, src: i64, type_ns: i64) -[Conformance, Diagnose]> i64 {
  let impl_inner = fn_inner(impl_method)
  let params = node_f3(impl_inner)
  let nparams = nlist_len(params)
  let mut errors = 0
  if nparams != 1 {
    typeck_error_maybe(src, type_ns, "type error: Drop impl method arity mismatch")
    errors = errors + 1
  } else {
    let param_ty = param_type_or_any(nlist_get(params, 0))
    -- Typed `self` is the kernel §10.12 surface. Keep the legacy i64 form
    -- accepted while runtime resource impls migrate; both lower through the
    -- same one-word owned-resource ABI.
    if not is_subtype(impl_self_ty, param_ty) and not is_subtype(ty_i64(), param_ty) {
      typeck_error_maybe(src, type_ns, "type error: Drop impl method parameter type mismatch")
      errors = errors + 1
    } else { errors = errors }
  }
  let ret_ty = fn_ret_type(impl_method)
  if type_is_i64_like(ret_ty) == 1 or type_is_nil_exact(ret_ty) == 1 {
    errors
  } else {
    typeck_error_maybe(src, type_ns, "type error: Drop impl method return type mismatch")
    errors + 1
  }
}

pub(package) fn check_drop_impl_methods(impl_methods: i64, impl_self_ty: i64, src: i64, type_ns: i64, trait_hash: i64) -[Conformance, Diagnose]> i64 {
  if trait_hash != typeck_drop_trait_hash() { 0 }
  else {
    let drop_method = find_impl_method_by_hash(impl_methods, src, typeck_drop_method_hash())
    if drop_method == 0 {
      typeck_error_maybe(src, type_ns, "type error: Drop impl missing concrete drop method")
      1
    } else {
      check_drop_impl_method_shape(drop_method, impl_self_ty, src, type_ns)
    }
  }
}

pub(package) fn impl_target_mentions_var_list(types: i64, var_id: i64) -> bool {
  if types == 0 { false }
  else {
    let mut found = false
    let mut i = 0
    while i < nlist_len(types) and not found {
      if impl_target_mentions_var(nlist_get(types, i), var_id) { found = true } else { i = i + 1 }
    }
    found
  }
}

pub(package) fn impl_target_record_fields_mention_var(fields: i64, var_id: i64) -> bool {
  if fields == 0 { false }
  else {
    let mut found = false
    let mut i = 0
    while i < nlist_len(fields) and not found {
      if impl_target_mentions_var(ty_record_field_type(nlist_get(fields, i)), var_id) { found = true }
      else { i = i + 1 }
    }
    found
  }
}

pub(package) fn impl_target_mentions_var(ty: i64, var_id: i64) -> bool {
  if ty == 0 { false }
  else {
    match ty_tag(ty) {
      3 -> impl_target_mentions_var(ty_f1(ty), var_id) or impl_target_mentions_var(ty_f2(ty), var_id)
      4 -> impl_target_mentions_var(ty_f1(ty), var_id) or impl_target_mentions_var(ty_f2(ty), var_id)
      5 -> impl_target_mentions_var(ty_f1(ty), var_id)
      6 -> impl_target_mentions_var_list(ty_f1(ty), var_id) or impl_target_mentions_var(ty_f2(ty), var_id)
      7 -> impl_target_record_fields_mention_var(ty_record_fields(ty), var_id)
      9 -> impl_target_mentions_var_list(ty_f3(ty), var_id)
      12 -> ty_var_id(ty) == var_id
      14 -> impl_target_mentions_var(ty_f1(ty), var_id) or impl_target_mentions_var(ty_f2(ty), var_id)
      15 -> impl_target_mentions_var(ty_f1(ty), var_id)
      16 -> impl_target_mentions_var(ty_f1(ty), var_id)
      17 -> impl_target_mentions_var(ty_f1(ty), var_id)
      18 -> impl_target_mentions_var(ty_f1(ty), var_id)
      19 -> impl_target_mentions_var(ty_f1(ty), var_id)
      29 -> impl_target_mentions_var(ty_f1(ty), var_id)
      21 -> impl_target_mentions_var(ty_f1(ty), var_id)
      22 -> impl_target_mentions_var(ty_f1(ty), var_id)
      23 -> impl_target_mentions_var(ty_f1(ty), var_id)
      _ -> false
    }
  }
}

-- Ownership qualifiers are exact protocol capability targets but do not own
-- a second nominal declaration. Borrow remains a parameter mode and is never
-- a conformance target.
pub(package) fn typeck_impl_target_head_type(ty: i64) -> i64 {
  if ty_is_unique(ty) { ty_unique_inner(ty) }
  else { if ty_is_owned(ty) { ty_owned_inner(ty) } else { ty } }
}

pub(package) fn check_impl_target_shape(tt: i64, target_ty: i64, tparams: i64, src: i64, pos: i64) -[Diagnose]> i64 {
  let mut errors = 0
  let target_head = typeck_impl_target_head_type(target_ty)
  let qualified = ty_is_unique(target_ty) or ty_is_owned(target_ty)
  let valid_head = if qualified { ty_tag(target_head) == 9 }
    else { ty_tag(target_head) == 2 or ty_tag(target_head) == 9 }
  if not valid_head {
    typeck_error_maybe(src, pos, "type error: impl target must be a nominal or primitive type")
    errors = errors + 1
  } else { if ty_tag(target_head) == 9 {
    let args = ty_f3(target_head)
    let exact_opaque = if ty_named_is_opaque(target_head) { ttable_lookup_decl_fact(tt, ty_named_opaque_declaration(target_head)) } else { 0 }
    let record_entry = if exact_opaque != 0 { 0 } else { ttable_find_entry_by_hash_kind(tt, ty_f1(target_head), 0) }
    let variant_entry = if exact_opaque != 0 or record_entry != 0 { 0 } else { ttable_find_entry_by_hash_kind(tt, ty_f1(target_head), 1) }
    let entry = if exact_opaque != 0 { exact_opaque }
      else { if record_entry != 0 { record_entry } else { variant_entry } }
    if entry != 0 {
      if args != 0 {
        let declared = mem_load64_at(entry, 40)
        let declared_count = if declared == 0 { 0 } else { nlist_len(declared) }
        if nlist_len(args) != declared_count {
          typeck_error_maybe(src, pos, "type error: impl target type argument count mismatch")
          errors = errors + 1
        } else { errors = errors }
      } else { errors = errors }
    } else { errors = errors }
  } else { errors = errors } }
  if tparams != 0 {
    for i in 0..nlist_len(tparams) {
      if not impl_target_mentions_var(target_ty, node_f3(nlist_get(tparams, i))) {
        typeck_error_maybe(src, pos, "type error: impl parameter is not determined by the target type")
        errors = errors + 1
      } else { errors = errors }
    }
  } else { errors = errors }
  errors
}

pub(package) fn impl_method_lists_share_name(left: i64, left_src: i64, right: i64, right_src: i64) -> bool {
  let mut found = false
  let mut i = 0
  while i < nlist_len(left) and not found {
    let lm = nlist_get(left, i)
    if node_tag(lm) != 43 {
      let li = fn_inner(lm)
      let lh = effect_name_hash(left_src, node_f1(li), node_f2(li))
      let mut j = 0
      while j < nlist_len(right) and not found {
        let rm = nlist_get(right, j)
        if node_tag(rm) != 43 {
          let ri = fn_inner(rm)
          if effect_name_hash(right_src, node_f1(ri), node_f2(ri)) == lh { found = true } else { j = j + 1 }
        } else { j = j + 1 }
      }
    } else { 0 }
    if not found { i = i + 1 } else { i = nlist_len(left) }
  }
  found
}

pub(package) fn check_inherent_impl_method_coherence_before(d: i64, index: i64, type_hash: i64, target_ty: i64, methods: i64, src: i64, pos: i64) -[Diagnose]> i64 {
  let mut i = 0
  let mut conflict = false
  while i < index and not conflict {
    let entry = d + i * 64
    if mem_load64_at(entry, 16) == 4 and mem_load64_at(entry, 56) == type_hash {
      let impl_info = mem_load64_at(entry, 40)
      if node_f1(impl_info) == 0 and ty_patterns_overlap(node_f3(impl_info), target_ty) {
        conflict = impl_method_lists_share_name(mem_load64_at(entry, 32), mem_load64_at(entry, 48), methods, src)
      } else { 0 }
    } else { 0 }
    i = i + 1
  }
  if conflict {
    typeck_error_maybe(src, pos, "type error: conflicting inherent implementations for method")
    1
  } else { 0 }
}

pub(package) fn impl_target_is_parameterized(target_ty: i64, tparams: i64) -> bool {
  if tparams != 0 and nlist_len(tparams) > 0 { true }
  else {
    let target_head = typeck_impl_target_head_type(target_ty)
    ty_tag(target_head) == 9 and ty_f3(target_head) != 0 and nlist_len(ty_f3(target_head)) > 0
  }
}

pub(package) fn impl_head_list_contains(heads: i64, type_hash: i64) -> bool {
  let mut found = false
  let mut i = 0
  while i < nlist_len(heads) and not found {
    if nlist_get(heads, i) == type_hash { found = true } else { i = i + 1 }
  }
  found
}

pub(package) fn check_impl_decls(tt: i64, user_src: i64) -[Conformance, Diagnose]> i64 {
  if tt == 0 { 0 }
  else {
    let n = mem_load64_at(tt, 8)
    let d = mem_load64_at(tt, 0)
    let mut errors = 0
    let seen = ctable_new()
    let parameterized_inherent_heads = nlist_new()
    for i in 0..n {
      let kind = mem_load64_at(d, i * 64 + 16)
      let entry_src = mem_load64_at(d, i * 64 + 48)
      if kind == 4 and (user_src == 0 or entry_src == user_src) {
        let type_ns = mem_load64_at(d, i * 64)
        let type_nl = mem_load64_at(d, i * 64 + 8)
        let impl_info = mem_load64_at(d, i * 64 + 40)
        let trait_hash = node_f1(impl_info)
        let trait_decl = node_f4(impl_info)
        let self_ty = node_f3(impl_info)
        let impl_tparams = node_f2(impl_info)
        let methods = mem_load64_at(d, i * 64 + 32)
        errors = errors + check_impl_target_shape(tt, self_ty, impl_tparams, entry_src, type_ns)
        if trait_hash == typeck_sendable_trait_hash() {
          typeck_error_maybe(entry_src, type_ns, "type error: Sendable is a sealed structural predicate and cannot be implemented")
          errors = errors + 1
        } else { if trait_hash != 0 {
          let type_hash = mem_load64_at(d, i * 64 + 56)
          errors = errors + check_impl_orphan_rule_ref(tt, entry_src, type_hash, trait_hash, trait_decl, self_ty, type_ns)
          if ctable_has_overlapping_target_ref(seen, type_hash, trait_hash, trait_decl, self_ty) == 1 {
            typeck_error_maybe(entry_src, type_ns, "type error: conflicting implementations of trait for type")
            errors = errors + 1
          } else {
            ctable_add_pattern_ref_at(seen, type_hash, trait_hash, trait_decl, methods, impl_tparams, self_ty, entry_src, type_ns, type_nl)
          }
          let trait_methods = lookup_trait_methods_ref(tt, entry_src, trait_hash, trait_decl)
          let trait_entry = lookup_trait_entry_ref(tt, trait_hash, trait_decl)
          let trait_src = if trait_entry == 0 { entry_src } else { mem_load64_at(trait_entry, 48) }
          errors = errors + verify_impl_methods(methods, trait_methods, entry_src, trait_src, type_ns, trait_hash, self_ty, impl_tparams, tt)
          errors = errors + check_drop_impl_methods(methods, self_ty, entry_src, type_ns, trait_hash)
        } else {
          let type_hash = mem_load64_at(d, i * 64 + 56)
          let target_is_parameterized = impl_target_is_parameterized(self_ty, impl_tparams)
          if target_is_parameterized or impl_head_list_contains(parameterized_inherent_heads, type_hash) {
            errors = errors + check_inherent_impl_method_coherence_before(d, i, type_hash, self_ty, methods, entry_src, type_ns)
          } else { errors = errors }
          if target_is_parameterized and not impl_head_list_contains(parameterized_inherent_heads, type_hash) {
            nlist_add(parameterized_inherent_heads, type_hash)
          } else { 0 }
        } }
      } else { errors = errors }
    }
    errors
  }
}

pub(package) fn build_ctable(tt: i64, src: i64) -> i64 {
  let ct = ctable_new()
  ctable_set_ttable(ct, tt)
  if tt == 0 { ct }
  else {
    let n = mem_load64_at(tt, 8)
    let d = mem_load64_at(tt, 0)
    for i in 0..n {
      let kind = mem_load64_at(d, i * 64 + 16)
      if kind == 4 {
        -- impl block: tparams field (offset 40) stores node(trait_hash, impl_tparams)
        let type_ns = mem_load64_at(d, i * 64)
        let type_nl = mem_load64_at(d, i * 64 + 8)
        let impl_info = mem_load64_at(d, i * 64 + 40)
        let entry_src = mem_load64_at(d, i * 64 + 48)
        let trait_hash = node_f1(impl_info)
        let trait_decl = node_f4(impl_info)
        let impl_tparams = node_f2(impl_info)
        let methods = mem_load64_at(d, i * 64 + 32)
        let type_hash = mem_load64_at(d, i * 64 + 56)
        if trait_hash != 0 and trait_hash != typeck_sendable_trait_hash() {
          -- Trait impl: check coherence (no duplicate impls)
          let target_ty = node_f3(impl_info)
          if ctable_has_overlapping_target_ref(ct, type_hash, trait_hash, trait_decl, target_ty) == 1 {
            0
          } else {
            ctable_add_pattern_ref_at(ct, type_hash, trait_hash, trait_decl, methods, impl_tparams, target_ty, entry_src, type_ns, type_nl)
          }
        } else { 0 }
      } else { 0 }
    }
    ct
  }
}

pub(package) fn check_reserved_structural_trait_decls(tt: i64, user_src: i64) -[Diagnose]> i64 {
  if tt == 0 { 0 }
  else {
    let count = mem_load64_at(tt, 8)
    let entries = mem_load64_at(tt, 0)
    let mut errors = 0
    for i in 0..count {
      let entry = entries + i * 64
      let kind = mem_load64_at(entry, 16)
      let entry_src = mem_load64_at(entry, 48)
      if kind == 3 and (user_src == 0 or entry_src == user_src) {
        let ns = mem_load64_at(entry, 0)
        let nl = mem_load64_at(entry, 8)
        if effect_name_hash(entry_src, ns, nl) == typeck_sendable_trait_hash() {
          typeck_error_maybe(entry_src, ns, "type error: Sendable is reserved as a sealed structural predicate")
          errors = errors + 1
        } else { 0 }
      } else { 0 }
    }
    errors
  }
}

pub(package) fn type_cycle_hash_list_contains(list: i64, hash: i64) -> i64 {
  let mut i = 0
  let mut found = 0
  while i < nlist_len(list) {
    if nlist_get(list, i) == hash {
      found = 1
      i = nlist_len(list)
    } else { i = i + 1 }
  }
  found
}

pub(package) fn type_cycle_entry_for_hash(tt: i64, type_hash: i64) -> i64 {
  if tt == 0 { 0 }
  else {
    let n = mem_load64_at(tt, 8)
    let d = mem_load64_at(tt, 0)
    let mut i = 0
    let mut result = 0
    while i < n {
      let entry = d + i * 64
      let kind = mem_load64_at(entry, 16)
      if kind == 0 or kind == 1 {
        let entry_src = mem_load64_at(entry, 48)
        let ns = mem_load64_at(entry, 0)
        let nl = mem_load64_at(entry, 8)
        if mem_load64_at(entry, 56) == type_hash {
          result = entry
          i = n
        } else { i = i + 1 }
      } else { i = i + 1 }
    }
    result
  }
}

pub(package) fn type_cycle_mut_container_vector_hash() -> i64 { 6952878250872 }
pub(package) fn type_cycle_mut_container_map_hash() -> i64 { 193464163 }
pub(package) fn type_cycle_mut_container_set_hash() -> i64 { 193470833 }
pub(package) fn type_cycle_mut_container_sorted_map_hash() -> i64 { 249861812019906484 }
pub(package) fn type_cycle_mut_container_sorted_set_hash() -> i64 { 249861812019913154 }

pub(package) fn type_cycle_is_mutable_strong_container_hash(type_hash: i64) -> i64 {
  type_hash == type_cycle_mut_container_vector_hash() or
    type_hash == type_cycle_mut_container_map_hash() or
    type_hash == type_cycle_mut_container_set_hash() or
    type_hash == type_cycle_mut_container_sorted_map_hash() or
    type_hash == type_cycle_mut_container_sorted_set_hash()
}

pub(package) fn type_cycle_subst_for_entry(entry: i64, type_args: i64) -> i64 {
  if entry == 0 { 0 }
  else {
    let tparams = mem_load64_at(entry, 40)
    if tparams != 0 and type_args != 0 { build_subst(tparams, type_args) } else { 0 }
  }
}

pub(package) fn type_cycle_maybe_subst(ty: i64, subst: i64) -> i64 {
  if subst != 0 { ty_subst(ty, subst) } else { ty }
}

pub(package) fn type_cycle_strong_path_type_args(tt: i64, type_args: i64, target_hash: i64, visited: i64) -> bool {
  if type_args == 0 { false }
  else {
    let mut i = 0
    let mut found = false
    while i < nlist_len(type_args) {
      if type_cycle_strong_path_ty(tt, nlist_get(type_args, i), target_hash, visited) == 1 {
        found = true
        i = nlist_len(type_args)
      } else { i = i + 1 }
    }
    found
  }
}

pub(package) fn type_cycle_strong_path_record_fields(tt: i64, fields: i64, target_hash: i64, visited: i64) -> bool {
  let mut found = false
  let mut i = 0
  while fields != 0 and i < nlist_len(fields) and not found {
    if type_cycle_strong_path_ty(tt, ty_record_field_type(nlist_get(fields, i)), target_hash, visited) { found = true }
    else { i = i + 1 }
  }
  found
}

pub(package) fn type_cycle_strong_path_entry(tt: i64, entry: i64, type_args: i64, target_hash: i64, visited: i64) -> bool {
  if entry == 0 { false }
  else {
    let kind = mem_load64_at(entry, 16)
    let subst = type_cycle_subst_for_entry(entry, type_args)
    let mut found = false
    if kind == 0 {
      let nfields = mem_load64_at(entry, 24)
      let fields = mem_load64_at(entry, 32)
      let mut i = 0
      while i < nfields {
        let raw_ty = mem_load64_at(fields, i * 24 + 16)
        let field_ty = type_cycle_maybe_subst(raw_ty, subst)
        if type_cycle_strong_path_ty(tt, field_ty, target_hash, visited) == 1 {
          found = true
          i = nfields
        } else { i = i + 1 }
      }
    } else { if kind == 1 {
      let nvariants = mem_load64_at(entry, 24)
      let variants = mem_load64_at(entry, 32)
      let mut vi = 0
      while vi < nvariants {
        let npayloads = mem_load64_at(variants, vi * 40 + 24)
        let payloads = mem_load64_at(variants, vi * 40 + 32)
        let mut pi = 0
        while pi < npayloads {
          let raw_ty = nlist_get(payloads, pi)
          let payload_ty = type_cycle_maybe_subst(raw_ty, subst)
          if type_cycle_strong_path_ty(tt, payload_ty, target_hash, visited) == 1 {
            found = true
            pi = npayloads
            vi = nvariants
          } else { pi = pi + 1 }
        }
        if vi < nvariants { vi = vi + 1 } else { vi = vi }
      }
    } else { found = false } }
    found
  }
}

pub(package) fn type_cycle_strong_path_hash(tt: i64, current_hash: i64, type_args: i64, target_hash: i64, visited: i64) -> bool {
  if current_hash == target_hash { true }
  else { if type_cycle_hash_list_contains(visited, current_hash) == 1 { false }
  else {
    nlist_add(visited, current_hash)
    type_cycle_strong_path_entry(tt, type_cycle_entry_for_hash(tt, current_hash), type_args, target_hash, visited)
  } }
}

pub(package) fn type_cycle_strong_path_ty(tt: i64, ty: i64, target_hash: i64, visited: i64) -> bool {
  if ty == 0 { false }
  else {
    match ty_tag(ty) {
      3 -> type_cycle_strong_path_ty(tt, ty_f1(ty), target_hash, visited) or type_cycle_strong_path_ty(tt, ty_f2(ty), target_hash, visited)
      4 -> type_cycle_strong_path_ty(tt, ty_f1(ty), target_hash, visited) or type_cycle_strong_path_ty(tt, ty_f2(ty), target_hash, visited)
      5 -> type_cycle_strong_path_ty(tt, ty_f1(ty), target_hash, visited)
      7 -> type_cycle_strong_path_record_fields(tt, ty_record_fields(ty), target_hash, visited)
      8 -> type_cycle_strong_path_ty(tt, ty_f2(ty), target_hash, visited)
      9 -> {
        if ty_is_rc(ty) == 1 {
          type_cycle_strong_path_ty(tt, ty_rc_inner(ty), target_hash, visited)
        } else {
          let type_hash = ty_f1(ty)
          if type_cycle_is_mutable_strong_container_hash(type_hash) == 1 {
            type_cycle_strong_path_type_args(tt, ty_f3(ty), target_hash, visited)
          } else {
            type_cycle_strong_path_hash(tt, type_hash, ty_f3(ty), target_hash, visited)
          }
        }
      }
      16 -> false
      17 -> type_cycle_strong_path_ty(tt, ty_arc_inner(ty), target_hash, visited)
      18 -> type_cycle_strong_path_ty(tt, ty_unique_inner(ty), target_hash, visited)
      19 -> type_cycle_strong_path_ty(tt, ty_owned_inner(ty), target_hash, visited)
      29 -> type_cycle_strong_path_ty(tt, ty_borrow_inner(ty), target_hash, visited)
      22 -> type_cycle_strong_path_ty(tt, ty_array_inner(ty), target_hash, visited)
      23 -> false
      _ -> false
    }
  }
}

pub(package) fn type_cycle_hidden_capture_type_args(tt: i64, type_args: i64, visited: i64) -> bool {
  if type_args == 0 { false }
  else {
    let mut i = 0
    let mut found = false
    while i < nlist_len(type_args) {
      if type_cycle_hidden_capture_ty(tt, nlist_get(type_args, i), visited) == 1 {
        found = true
        i = nlist_len(type_args)
      } else { i = i + 1 }
    }
    found
  }
}

pub(package) fn type_cycle_hidden_capture_record_fields(tt: i64, fields: i64, visited: i64) -> bool {
  let mut found = false
  let mut i = 0
  while fields != 0 and i < nlist_len(fields) and not found {
    if type_cycle_hidden_capture_ty(tt, ty_record_field_type(nlist_get(fields, i)), visited) { found = true }
    else { i = i + 1 }
  }
  found
}

pub(package) fn type_cycle_hidden_capture_entry(tt: i64, entry: i64, type_args: i64, visited: i64) -> bool {
  if entry == 0 { false }
  else {
    let kind = mem_load64_at(entry, 16)
    let subst = type_cycle_subst_for_entry(entry, type_args)
    let mut found = false
    if kind == 0 {
      let nfields = mem_load64_at(entry, 24)
      let fields = mem_load64_at(entry, 32)
      let mut i = 0
      while i < nfields {
        let raw_ty = mem_load64_at(fields, i * 24 + 16)
        let field_ty = type_cycle_maybe_subst(raw_ty, subst)
        if type_cycle_hidden_capture_ty(tt, field_ty, visited) == 1 {
          found = true
          i = nfields
        } else { i = i + 1 }
      }
    } else { if kind == 1 {
      let nvariants = mem_load64_at(entry, 24)
      let variants = mem_load64_at(entry, 32)
      let mut vi = 0
      while vi < nvariants {
        let npayloads = mem_load64_at(variants, vi * 40 + 24)
        let payloads = mem_load64_at(variants, vi * 40 + 32)
        let mut pi = 0
        while pi < npayloads {
          let raw_ty = nlist_get(payloads, pi)
          let payload_ty = type_cycle_maybe_subst(raw_ty, subst)
          if type_cycle_hidden_capture_ty(tt, payload_ty, visited) == 1 {
            found = true
            pi = npayloads
            vi = nvariants
          } else { pi = pi + 1 }
        }
        if vi < nvariants { vi = vi + 1 } else { vi = vi }
      }
    } else { found = false } }
    found
  }
}

pub(package) fn type_cycle_hidden_capture_hash(tt: i64, type_hash: i64, type_args: i64, visited: i64) -> bool {
  if type_cycle_hash_list_contains(visited, type_hash) == 1 { false }
  else {
    nlist_add(visited, type_hash)
    type_cycle_hidden_capture_entry(tt, type_cycle_entry_for_hash(tt, type_hash), type_args, visited)
  }
}

pub(package) fn type_cycle_hidden_capture_ty(tt: i64, ty: i64, visited: i64) -> bool {
  if ty == 0 { false }
  else {
    match ty_tag(ty) {
      3 -> type_cycle_hidden_capture_ty(tt, ty_f1(ty), visited) or type_cycle_hidden_capture_ty(tt, ty_f2(ty), visited)
      4 -> type_cycle_hidden_capture_ty(tt, ty_f1(ty), visited) or type_cycle_hidden_capture_ty(tt, ty_f2(ty), visited)
      5 -> type_cycle_hidden_capture_ty(tt, ty_f1(ty), visited)
      6 -> true
      7 -> type_cycle_hidden_capture_record_fields(tt, ty_record_fields(ty), visited)
      8 -> type_cycle_hidden_capture_ty(tt, ty_f2(ty), visited)
      9 -> {
        if ty_is_rc(ty) == 1 {
          type_cycle_hidden_capture_ty(tt, ty_rc_inner(ty), visited)
        } else {
          let type_hash = ty_f1(ty)
          if type_cycle_is_mutable_strong_container_hash(type_hash) == 1 {
            type_cycle_hidden_capture_type_args(tt, ty_f3(ty), visited)
          } else {
            type_cycle_hidden_capture_hash(tt, type_hash, ty_f3(ty), visited)
          }
        }
      }
      14 -> true
      16 -> false
      17 -> type_cycle_hidden_capture_ty(tt, ty_arc_inner(ty), visited)
      18 -> type_cycle_hidden_capture_ty(tt, ty_unique_inner(ty), visited)
      19 -> type_cycle_hidden_capture_ty(tt, ty_owned_inner(ty), visited)
      29 -> type_cycle_hidden_capture_ty(tt, ty_borrow_inner(ty), visited)
      22 -> type_cycle_hidden_capture_ty(tt, ty_array_inner(ty), visited)
      23 -> false
      _ -> false
    }
  }
}

pub(package) fn check_type_cycle_hidden_capture_container(tt: i64, src: i64, diag_pos: i64, type_args: i64) -[Diagnose]> i64 {
  if type_cycle_hidden_capture_type_args(tt, type_args, nlist_new()) == 1 {
    typeck_error_maybe(src, diag_pos, "type error: closure capture cycle requires weak or id edge")
    1
  } else { 0 }
}

pub(package) fn check_type_cycle_target(tt: i64, src: i64, diag_pos: i64, owner_hash: i64, target_hash: i64, type_args: i64, cycle_forming: i64) -[Diagnose]> i64 {
  if cycle_forming != 1 { 0 }
  else {
    if type_cycle_strong_path_hash(tt, target_hash, type_args, owner_hash, nlist_new()) == 1 {
      typeck_error_maybe(src, diag_pos, "type error: strong ownership cycle requires weak or id edge")
      1
    } else { 0 }
  }
}

pub(package) fn check_type_cycle_ty(tt: i64, src: i64, diag_pos: i64, owner_hash: i64, ty: i64, cycle_forming: i64) -[Diagnose]> i64 {
  if ty == 0 { 0 }
  else {
    match ty_tag(ty) {
      3 -> check_type_cycle_ty(tt, src, diag_pos, owner_hash, ty_f1(ty), cycle_forming) + check_type_cycle_ty(tt, src, diag_pos, owner_hash, ty_f2(ty), cycle_forming)
      4 -> check_type_cycle_ty(tt, src, diag_pos, owner_hash, ty_f1(ty), cycle_forming) + check_type_cycle_ty(tt, src, diag_pos, owner_hash, ty_f2(ty), cycle_forming)
      5 -> check_type_cycle_ty(tt, src, diag_pos, owner_hash, ty_f1(ty), cycle_forming)
      7 -> check_type_cycle_record_fields(tt, src, diag_pos, owner_hash, ty_record_fields(ty), cycle_forming)
      8 -> check_type_cycle_ty(tt, src, diag_pos, owner_hash, ty_f2(ty), cycle_forming)
      9 -> {
        if ty_is_rc(ty) == 1 {
          check_type_cycle_ty(tt, src, diag_pos, owner_hash, ty_rc_inner(ty), cycle_forming)
        } else {
          let type_hash = ty_f1(ty)
          if type_cycle_is_mutable_strong_container_hash(type_hash) == 1 {
            check_type_cycle_hidden_capture_container(tt, src, diag_pos, ty_f3(ty)) +
              check_type_cycle_type_args(tt, src, diag_pos, owner_hash, ty_f3(ty), 1)
          } else {
            check_type_cycle_target(tt, src, diag_pos, owner_hash, type_hash, ty_f3(ty), cycle_forming)
          }
        }
      }
      16 -> 0
      17 -> check_type_cycle_ty(tt, src, diag_pos, owner_hash, ty_arc_inner(ty), cycle_forming)
      18 -> check_type_cycle_ty(tt, src, diag_pos, owner_hash, ty_unique_inner(ty), cycle_forming)
      19 -> check_type_cycle_ty(tt, src, diag_pos, owner_hash, ty_owned_inner(ty), cycle_forming)
      29 -> check_type_cycle_ty(tt, src, diag_pos, owner_hash, ty_borrow_inner(ty), cycle_forming)
      22 -> check_type_cycle_ty(tt, src, diag_pos, owner_hash, ty_array_inner(ty), cycle_forming)
      23 -> 0
      _ -> 0
    }
  }
}

pub(package) fn check_type_cycle_record_fields(tt: i64, src: i64, diag_pos: i64, owner_hash: i64, fields: i64, cycle_forming: i64) -[Diagnose]> i64 {
  let mut errors = 0
  if fields != 0 {
    for i in 0..nlist_len(fields) {
      errors = errors + check_type_cycle_ty(tt, src, diag_pos, owner_hash, ty_record_field_type(nlist_get(fields, i)), cycle_forming)
    }
  } else { 0 }
  errors
}

pub(package) fn check_type_cycle_type_args(tt: i64, src: i64, diag_pos: i64, owner_hash: i64, type_args: i64, cycle_forming: i64) -[Diagnose]> i64 {
  if type_args == 0 { 0 }
  else {
    let mut errors = 0
    let n = nlist_len(type_args)
    for i in 0..n {
      errors = errors + check_type_cycle_ty(tt, src, diag_pos, owner_hash, nlist_get(type_args, i), cycle_forming)
    }
    errors
  }
}

pub(package) fn check_public_arc_type_list_inner(tt: i64, policy: i64, src: i64, diag_pos: i64, types: i64, allow_self: i64) -[Diagnose]> i64 {
  if types == 0 { 0 }
  else {
    let mut errors = 0
    let n = nlist_len(types)
    for i in 0..n {
      errors = errors + check_public_arc_ty_inner(tt, policy, src, diag_pos, nlist_get(types, i), allow_self)
    }
    errors
  }
}

pub(package) fn check_public_arc_effect_list_inner(tt: i64, policy: i64, src: i64, diag_pos: i64, effects: i64, allow_self: i64) -[Diagnose]> i64 {
  if effects == 0 { 0 }
  else {
    let mut errors = 0
    let n = nlist_len(effects)
    for i in 0..n {
      errors = errors + check_public_arc_ty_inner(tt, policy, src, diag_pos, nlist_get(effects, i), allow_self)
    }
    errors
  }
}

pub(package) fn check_public_arc_record_fields_inner(tt: i64, policy: i64, src: i64, diag_pos: i64, fields: i64, allow_self: i64) -[Diagnose]> i64 {
  let mut errors = 0
  if fields != 0 {
    for i in 0..nlist_len(fields) {
      let field = nlist_get(fields, i)
      let field_pos = if ty_record_field_name_start(field) > 0 { ty_record_field_name_start(field) } else { diag_pos }
      errors = errors + check_public_arc_ty_inner(tt, policy, src, field_pos, ty_record_field_type(field), allow_self)
    }
    let duplicate = ty_record_fields_have_duplicate(fields)
    if duplicate > 0 {
      let field = nlist_get(fields, duplicate - 1)
      typeck_error_maybe(src, ty_record_field_name_start(field), "type error: duplicate structural record field")
      errors = errors + 1
    } else { 0 }
  } else { 0 }
  errors
}

-- Surface walker over user-written annotation types. `policy` == 1 for
-- untrusted sources: policy-scoped ownership spellings (rc, arc) are internal
-- compiler/runtime facts and fire only there.
-- Correctness checks (unsupported markers, effect arity, ~Trait) fire
-- unconditionally — trusted code has no license to write those either.
pub(package) fn check_public_arc_ty_inner(tt: i64, policy: i64, src: i64, diag_pos: i64, ty: i64, allow_self: i64) -[Diagnose]> i64 {
  if ty == 0 { 0 }
  else {
    match ty_tag(ty) {
      3 -> check_public_arc_ty_inner(tt, policy, src, diag_pos, ty_f1(ty), allow_self) + check_public_arc_ty_inner(tt, policy, src, diag_pos, ty_f2(ty), allow_self)
      4 -> check_public_arc_ty_inner(tt, policy, src, diag_pos, ty_f1(ty), allow_self) + check_public_arc_ty_inner(tt, policy, src, diag_pos, ty_f2(ty), allow_self)
      5 -> {
        -- set-theoretic surface (law L1): trait atoms under complement are not surface types.
        -- Conformance is open-world; ~Trait would make emptiness non-monotonic
        -- under linking. Kernel §2.4. In surface positions a trait name parses
        -- as a Named atom, so the trait test is a ttable lookup by hash.
        let inner = ty_f1(ty)
        let is_trait_atom = if ty_tag(inner) == 13 { 1 }
          else { if ty_tag(inner) == 9 { ttable_hash_is_trait(tt, ty_f1(inner)) } else { 0 } }
        if is_trait_atom == 1 {
          typeck_error_maybe(src, diag_pos, "type error: trait complement is not a surface type")
          1
        } else { check_public_arc_ty_inner(tt, policy, src, diag_pos, inner, allow_self) }
      }
      6 -> check_public_arc_type_list_inner(tt, policy, src, diag_pos, ty_f1(ty), allow_self) + check_public_arc_ty_inner(tt, policy, src, diag_pos, ty_f2(ty), allow_self) + check_public_arc_ty_inner(tt, policy, src, diag_pos, ty_f3(ty), allow_self)
      7 -> check_public_arc_record_fields_inner(tt, policy, src, diag_pos, ty_record_fields(ty), allow_self)
      8 -> check_public_arc_ty_inner(tt, policy, src, diag_pos, ty_f2(ty), allow_self)
      9 -> {
        -- Default managed ownership is implicit.
        -- The nominal rc atom remains available only to the trusted runtime
        -- and compiler implementation as an internal ownership class.
        if ty_named_is_opaque(ty) {
          -- The representation is declaration-private. Validate it once in
          -- its owning source, never as though it were written at each use.
          check_public_arc_type_list_inner(tt, policy, src, diag_pos, ty_f3(ty), allow_self)
        } else { if policy == 1 and ty_is_rc(ty) {
          typeck_error_maybe(src, diag_pos, "type error: rc is not public syntax")
          1
        } else {
          check_public_arc_ty_inner(tt, policy, src, diag_pos, ty_f2(ty), allow_self) + check_public_arc_type_list_inner(tt, policy, src, diag_pos, ty_f3(ty), allow_self)
        } }
      }
      10 -> {
        let elist = ty_f1(ty)
        check_public_arc_effect_list_inner(tt, policy, src, diag_pos, elist, allow_self)
      }
      11 -> {
        -- parameterized effects: effect atom arity vs its declaration (unconditional).
        let entry = ttable_find_entry_by_hash_kind(tt, ty_f1(ty), 2)
        let args = ty_f2(ty)
        let n_args = if args == 0 { 0 } else { nlist_len(args) }
        let arity_errors = if entry == 0 { 0 } else {
          let tps = ttable_entry_tparams(entry)
          let n_tp = if tps == 0 { 0 } else { nlist_len(tps) }
          if n_tp != n_args {
            typeck_error_maybe(src, diag_pos, "type error: effect type argument count mismatch")
            1
          } else { 0 }
        }
        arity_errors + check_public_arc_type_list_inner(tt, policy, src, diag_pos, args, allow_self)
      }
      25 -> {
        -- module identity: a qualified effect atom already carries the exact declaration
        -- fact, so arity validation must not fall back to the spelling hash.
        let entry = ttable_lookup_decl_fact(tt, ty_f1(ty))
        let args = ty_f2(ty)
        let n_args = if args == 0 { 0 } else { nlist_len(args) }
        let arity_errors = if entry == 0 { 0 } else {
          let tps = ttable_entry_tparams(entry)
          let n_tp = if tps == 0 { 0 } else { nlist_len(tps) }
          if n_tp != n_args {
            typeck_error_maybe(src, diag_pos, "type error: effect type argument count mismatch")
            1
          } else { 0 }
        }
        arity_errors + check_public_arc_type_list_inner(tt, policy, src, diag_pos, args, allow_self)
      }
      12 -> {
        if ty_is_self(ty) and allow_self == 0 {
          typeck_error_maybe(src, diag_pos, "type error: Self is only valid in trait and impl method signatures")
          1
        } else { 0 }
      }
      14 -> check_public_arc_ty_inner(tt, policy, src, diag_pos, ty_f1(ty), allow_self) + check_public_arc_ty_inner(tt, policy, src, diag_pos, ty_f2(ty), allow_self)
      15 -> check_public_arc_ty_inner(tt, policy, src, diag_pos, ty_f1(ty), allow_self)
      16 -> check_public_arc_ty_inner(tt, policy, src, diag_pos, ty_f1(ty), allow_self)
      17 -> {
        if policy == 1 {
          typeck_error_maybe(src, diag_pos, "type error: arc is not public syntax")
          1
        } else { check_public_arc_ty_inner(tt, policy, src, diag_pos, ty_f1(ty), allow_self) }
      }
      18 -> check_public_arc_ty_inner(tt, policy, src, diag_pos, ty_f1(ty), allow_self)
      19 -> check_public_arc_ty_inner(tt, policy, src, diag_pos, ty_f1(ty), allow_self)
      29 -> check_public_arc_ty_inner(tt, policy, src, diag_pos, ty_f1(ty), allow_self)
      20 -> {
        -- set-theoretic surface: unsupported-surface markers produced by the parser instead of
        -- silent any-erasure. Kind names the unsupported surface feature.
        let kind = ty_f1(ty)
        if kind == 1 { typeck_error_maybe(src, diag_pos, "type error: structural record type is malformed") }
        else { if kind == 2 { typeck_error_maybe(src, diag_pos, "type error: tuple type is malformed") }
        else { if kind == 3 { typeck_error_maybe(src, diag_pos, "type error: array and slice types are not implemented yet") }
        else { if kind == 4 { typeck_error_maybe(src, diag_pos, "type error: parameterized effects are not implemented yet") }
        else { if kind == 5 { typeck_error_maybe(src, diag_pos, "type error: array or slice type must be [T], [mut T], or [T; N]") }
        else { if kind == 6 { typeck_error_maybe(src, diag_pos, "type error: array length must be a non-negative compile-time integer literal") }
        else { if kind == 7 { typeck_error_maybe(src, diag_pos, "type error: array length exceeds compiler integer range") }
        else { if kind == 9 { typeck_error_maybe(src, diag_pos, "type error: structural record type is malformed") }
        else { typeck_error_maybe(src, diag_pos, "type error: fixed arrays cannot use mut in the element position") } } } } } } } }
        1
      }
      21 -> check_public_arc_ty_inner(tt, policy, src, diag_pos, ty_f1(ty), allow_self)
      22 -> check_public_arc_ty_inner(tt, policy, src, diag_pos, ty_f1(ty), allow_self)
      23 -> check_public_arc_ty_inner(tt, policy, src, diag_pos, ty_f1(ty), allow_self)
      _ -> 0
    }
  }
}

pub(package) fn check_public_surface_policy(tt: i64, src: i64) -> i64 {
  if ttable_source_is_trusted(tt, src) == 1 { 0 }
  else {
    let entry = ttable_find_source_entry(tt, src)
    if entry == 0 { 1 }
    else {
      let path = mem_load64_at(entry + 16, 0)
      let path_len = mem_load64_at(entry + 24, 0)
      if source_trust_allows_internal_ownership(path, path_len) == 1 { 0 } else { 1 }
    }
  }
}

pub(package) fn check_public_arc_ty(tt: i64, src: i64, diag_pos: i64, ty: i64) -[Diagnose]> i64 {
  let policy = check_public_surface_policy(tt, src)
  check_public_arc_ty_inner(tt, policy, src, diag_pos, ty, 0)
}

pub(package) fn check_public_arc_ty_with_self(tt: i64, src: i64, diag_pos: i64, ty: i64) -[Diagnose]> i64 {
  let policy = check_public_surface_policy(tt, src)
  check_public_arc_ty_inner(tt, policy, src, diag_pos, ty, 1)
}

pub(package) fn check_public_arc_type_list(tt: i64, src: i64, diag_pos: i64, types: i64) -[Diagnose]> i64 {
  let policy = check_public_surface_policy(tt, src)
  check_public_arc_type_list_inner(tt, policy, src, diag_pos, types, 0)
}

pub(package) fn check_public_arc_params(tt: i64, src: i64, params: i64) -[Diagnose]> i64 {
  check_public_arc_params_with_self(tt, src, params, 0)
}

pub(package) fn check_public_arc_params_with_self(tt: i64, src: i64, params: i64, allow_self: i64) -[Diagnose]> i64 {
  let policy = check_public_surface_policy(tt, src)
  let mut errors = 0
  let n = nlist_len(params)
  for i in 0..n {
    let p = nlist_get(params, i)
    errors = errors + check_public_arc_ty_inner(tt, policy, src, node_f1(p), node_f3(p), allow_self)
  }
  errors
}

-- Structural results use the native x0..x7 result bank. Wider concrete
-- shapes need an sret convention; reject them while the type fact is still
-- available instead of letting the backend's impossible-lane guard become a
-- runtime trap. Generic declarations remain admissible and are checked after
-- substitution at each call/perform site.
pub(package) fn check_native_result_abi_ty(src: i64, diag_pos: i64, ty: i64) -[Diagnose]> i64 {
  let lanes = ty_value_storage_word_count(ty)
  if lanes > 8 {
    typeck_error_maybe(src, diag_pos, "type error: result type exceeds 8-lane native ABI")
    1
  } else { 0 }
}

-- A manifest trust grant authorises an exact binding leaf to implement a
-- safe facade; it does not make raw addresses or the Unsafe capability part
-- of that facade. Opaque nominal types are the intentional boundary: their
-- private representation is checked in the declaring leaf, while uses expose
-- only the nominal identity and type arguments.
pub(package) fn typeck_type_list_contains_public_raw_pointer(types: i64) -> bool {
  if types == 0 { false }
  else {
    let mut found = false
    for i in 0..nlist_len(types) {
      if typeck_ty_contains_public_raw_pointer(nlist_get(types, i)) { found = true } else { 0 }
    }
    found
  }
}

pub(package) fn typeck_record_fields_contain_public_raw_pointer(fields: i64) -> bool {
  if fields == 0 { false }
  else {
    let mut found = false
    for i in 0..nlist_len(fields) {
      if typeck_ty_contains_public_raw_pointer(ty_record_field_type(nlist_get(fields, i))) { found = true } else { 0 }
    }
    found
  }
}

pub(package) fn typeck_effect_list_contains_public_raw_pointer(effects: i64) -> bool {
  if effects == 0 { false }
  else {
    let mut found = false
    for i in 0..nlist_len(effects) {
      if typeck_ty_contains_public_raw_pointer(nlist_get(effects, i)) { found = true } else { 0 }
    }
    found
  }
}

pub(package) fn typeck_ty_contains_public_raw_pointer(ty: i64) -> bool {
  if ty == 0 { false }
  else {
    match ty_tag(ty) {
      3 -> typeck_ty_contains_public_raw_pointer(ty_f1(ty)) or typeck_ty_contains_public_raw_pointer(ty_f2(ty))
      4 -> typeck_ty_contains_public_raw_pointer(ty_f1(ty)) or typeck_ty_contains_public_raw_pointer(ty_f2(ty))
      5 -> typeck_ty_contains_public_raw_pointer(ty_f1(ty))
      6 -> typeck_type_list_contains_public_raw_pointer(ty_f1(ty)) or typeck_ty_contains_public_raw_pointer(ty_f2(ty)) or typeck_ty_contains_public_raw_pointer(ty_f3(ty))
      7 -> typeck_record_fields_contain_public_raw_pointer(ty_record_fields(ty))
      8 -> typeck_ty_contains_public_raw_pointer(ty_f2(ty))
      9 -> typeck_type_list_contains_public_raw_pointer(ty_f3(ty))
      10 -> typeck_effect_list_contains_public_raw_pointer(ty_f1(ty))
      11 -> typeck_type_list_contains_public_raw_pointer(ty_f2(ty))
      14 -> typeck_ty_contains_public_raw_pointer(ty_f1(ty)) or typeck_ty_contains_public_raw_pointer(ty_f2(ty))
      15 -> true
      16 -> typeck_ty_contains_public_raw_pointer(ty_f1(ty))
      17 -> typeck_ty_contains_public_raw_pointer(ty_f1(ty))
      18 -> typeck_ty_contains_public_raw_pointer(ty_f1(ty))
      19 -> typeck_ty_contains_public_raw_pointer(ty_f1(ty))
      21 -> typeck_ty_contains_public_raw_pointer(ty_f1(ty))
      22 -> typeck_ty_contains_public_raw_pointer(ty_f1(ty))
      23 -> typeck_ty_contains_public_raw_pointer(ty_f1(ty))
      25 -> typeck_type_list_contains_public_raw_pointer(ty_f2(ty))
      29 -> typeck_ty_contains_public_raw_pointer(ty_f1(ty))
      _ -> false
    }
  }
}

pub(package) fn check_native_binding_public_ty(src: i64, diag_pos: i64, ty: i64) -[Diagnose]> i64 {
  if typeck_ty_contains_public_raw_pointer(ty) {
    typeck_error_maybe(src, diag_pos, "type error: native binding public surface cannot expose raw pointers")
    1
  } else { 0 }
}

pub(package) fn check_native_binding_public_params(src: i64, params: i64) -[Diagnose]> i64 {
  let mut errors = 0
  for i in 0..nlist_len(params) {
    let param = nlist_get(params, i)
    errors = errors + check_native_binding_public_ty(src, node_f1(param), node_f3(param))
  }
  errors
}

-- borrow parameters: borrow is a callable-parameter mode, not a storage/value-set type.
-- Function types recursively reopen parameter position for their own input
-- list; every result/storage/type-argument position remains closed.
pub(package) fn check_borrow_surface_type_list(src: i64, diag_pos: i64, types: i64, allow_roots: i64) -[Diagnose]> i64 {
  if types == 0 { 0 }
  else {
    let mut errors = 0
    for i in 0..nlist_len(types) {
      errors = errors + check_borrow_surface_ty_inner(src, diag_pos, nlist_get(types, i), allow_roots)
    }
    errors
  }
}

pub(package) fn check_borrow_surface_record_fields(src: i64, diag_pos: i64, fields: i64) -[Diagnose]> i64 {
  if fields == 0 { 0 }
  else {
    let mut errors = 0
    for i in 0..nlist_len(fields) {
      errors = errors + check_borrow_surface_ty_inner(src, diag_pos, ty_record_field_type(nlist_get(fields, i)), 0)
    }
    errors
  }
}

pub(package) fn check_borrow_surface_ty_inner(src: i64, diag_pos: i64, ty: i64, allow_root: i64) -[Diagnose]> i64 {
  if ty == 0 { 0 }
  else {
    match ty_tag(ty) {
      3 -> check_borrow_surface_ty_inner(src, diag_pos, ty_f1(ty), 0) + check_borrow_surface_ty_inner(src, diag_pos, ty_f2(ty), 0)
      4 -> check_borrow_surface_ty_inner(src, diag_pos, ty_f1(ty), 0) + check_borrow_surface_ty_inner(src, diag_pos, ty_f2(ty), 0)
      5 -> check_borrow_surface_ty_inner(src, diag_pos, ty_f1(ty), 0)
      6 -> check_borrow_surface_type_list(src, diag_pos, ty_f1(ty), 1) + check_borrow_surface_ty_inner(src, diag_pos, ty_f2(ty), 0) + check_borrow_surface_ty_inner(src, diag_pos, ty_f3(ty), 0)
      7 -> check_borrow_surface_record_fields(src, diag_pos, ty_record_fields(ty))
      8 -> check_borrow_surface_ty_inner(src, diag_pos, ty_f2(ty), 0)
      9 -> check_borrow_surface_type_list(src, diag_pos, ty_f3(ty), 0)
      10 -> check_borrow_surface_type_list(src, diag_pos, ty_f1(ty), 0)
      11 -> check_borrow_surface_type_list(src, diag_pos, ty_f2(ty), 0)
      14 -> check_borrow_surface_ty_inner(src, diag_pos, ty_f1(ty), 0) + check_borrow_surface_ty_inner(src, diag_pos, ty_f2(ty), 0)
      15 -> check_borrow_surface_ty_inner(src, diag_pos, ty_f1(ty), 0)
      16 -> check_borrow_surface_ty_inner(src, diag_pos, ty_f1(ty), 0)
      17 -> check_borrow_surface_ty_inner(src, diag_pos, ty_f1(ty), 0)
      18 -> check_borrow_surface_ty_inner(src, diag_pos, ty_f1(ty), 0)
      19 -> check_borrow_surface_ty_inner(src, diag_pos, ty_f1(ty), 0)
      21 -> check_borrow_surface_ty_inner(src, diag_pos, ty_f1(ty), 0)
      22 -> check_borrow_surface_ty_inner(src, diag_pos, ty_array_inner(ty), 0)
      23 -> check_borrow_surface_ty_inner(src, diag_pos, ty_slice_inner(ty), 0)
      25 -> check_borrow_surface_type_list(src, diag_pos, ty_f2(ty), 0)
      29 -> {
        if allow_root == 1 {
          let inner = ty_borrow_inner(ty)
          if ty_is_borrow(inner) or ty_is_owned(inner) or ty_is_unique(inner) or ty_is_weak(inner) or ty_is_arc(inner) {
            typeck_error_maybe(src, diag_pos, "type error: borrow cannot wrap another ownership qualifier")
            1
          } else { check_borrow_surface_ty_inner(src, diag_pos, inner, 0) }
        } else {
          typeck_error_maybe(src, diag_pos, "type error: borrow is only valid on callable parameters")
          1
        }
      }
      _ -> 0
    }
  }
}

pub(package) fn check_borrow_surface_ty(src: i64, diag_pos: i64, ty: i64) -[Diagnose]> i64 {
  check_borrow_surface_ty_inner(src, diag_pos, ty, 0)
}

pub(package) fn check_borrow_surface_params(src: i64, params: i64) -[Diagnose]> i64 {
  let mut errors = 0
  for i in 0..nlist_len(params) {
    let p = nlist_get(params, i)
    errors = errors + check_borrow_surface_ty_inner(src, node_f1(p), node_f3(p), 1)
  }
  errors
}

-- set-theoretic surface: effect-op (ttable kind 2) and trait-method (kind 3) declaration
-- signatures were never surface-walked — impl methods go through check_fn,
-- but a record/tuple/array marker or banned spelling in a bare effect or
-- trait declaration escaped silently. Walk them like fn signatures.
pub(package) fn check_decl_signature_surfaces(tt: i64, user_src: i64) -[Diagnose]> i64 {
  if tt == 0 { 0 }
  else {
    let n = mem_load64_at(tt, 8)
    let d = mem_load64_at(tt, 0)
    let mut errors = 0
    for i in 0..n {
      let entry = d + i * 64
      let kind = mem_load64_at(entry, 16)
      let entry_src = mem_load64_at(entry, 48)
      if (kind == 2 or kind == 3) and (user_src == 0 or entry_src == user_src) {
        let owner_namespace = if kind == 2 { module_decl_namespace_effect() } else { module_decl_namespace_trait() }
        let owner_decl = module_decl_fact_find(tt, entry_src, owner_namespace, entry_src, mem_load64_at(entry, 0), mem_load64_at(entry, 8))
        let public_native = if ttable_native_binding_source_find(tt, entry_src) == 0 or owner_decl == 0 { 0 }
          else { if module_decl_fact_visibility_code(owner_decl) == module_visibility_public() { 1 } else { 0 } }
        let nops = mem_load64_at(entry, 24)
        let ops = mem_load64_at(entry, 32)
        for j in 0..nops {
          let op = nlist_get(ops, j)
          -- Effect ops are node 31, trait methods node 39. Trait bodies also
          -- carry associated-type declarations (node 42) in the same list —
          -- those have no params/ret shape and must be skipped.
          if kind == 2 and node_tag(op) == 31 {
            errors = errors + check_public_arc_params(tt, entry_src, node_f3(op))
            errors = errors + check_borrow_surface_params(entry_src, node_f3(op))
            errors = errors + check_public_arc_ty(tt, entry_src, node_f1(op), effect_op_ret_type(op))
            errors = errors + check_borrow_surface_ty(entry_src, node_f1(op), effect_op_ret_type(op))
            errors = errors + check_native_result_abi_ty(entry_src, node_f1(op), effect_op_ret_type(op))
            if public_native == 1 {
              errors = errors + check_native_binding_public_params(entry_src, node_f3(op))
              errors = errors + check_native_binding_public_ty(entry_src, node_f1(op), effect_op_ret_type(op))
            } else { 0 }
          } else { if kind == 3 and node_tag(op) == 39 {
            let meta = node_f4(op)
            errors = errors + check_public_arc_params_with_self(tt, entry_src, node_f3(op), 1)
            errors = errors + check_borrow_surface_params(entry_src, node_f3(op))
            errors = errors + check_public_arc_ty_with_self(tt, entry_src, node_f1(op), node_f1(meta))
            errors = errors + check_borrow_surface_ty(entry_src, node_f1(op), node_f1(meta))
            errors = errors + check_public_arc_ty_with_self(tt, entry_src, node_f1(op), node_f2(meta))
            errors = errors + check_native_result_abi_ty(entry_src, node_f1(op), node_f1(meta))
            if public_native == 1 {
              errors = errors + check_native_binding_public_params(entry_src, node_f3(op))
              errors = errors + check_native_binding_public_ty(entry_src, node_f1(op), node_f1(meta))
              errors = errors + check_native_binding_public_ty(entry_src, node_f1(op), node_f2(meta))
            } else { 0 }
          } else { errors = errors } }
        }
      } else { errors = errors }
    }
    errors
  }
}

pub(package) fn check_move_only_storage_reason_message(reason: i64) -> str {
  if reason == typeck_linear_layout_reason_recursive() { "type error: recursive aggregate cannot contain an owned resource" }
  else { if reason == typeck_linear_layout_reason_container() { "type error: owned resource requires finite record, tuple, or tagged-variant storage; arbitrary containers remain unsupported" }
  else { if reason == typeck_linear_layout_reason_set_operator() { "type error: owned resource cannot be stored through an untagged union, intersection, or complement" }
  else { if reason == typeck_linear_layout_reason_open_record() { "type error: owned resource cannot be stored in an open record" }
  else { if reason == typeck_linear_layout_reason_unique() { "type error: Unique cannot be nested inside another storage shape" }
  else { "type error: owned resource storage shape cannot be resolved" } } } } }
}

pub(package) fn check_move_only_storage_type_list_with(tt: i64, src: i64, diag_pos: i64, types: i64, allow_root: i64) -[Diagnose]> i64 {
  if types == 0 { 0 }
  else {
    let mut errors = 0
    let n = nlist_len(types)
    for i in 0..n {
      errors = errors + check_move_only_storage_ty_inner(tt, src, diag_pos, nlist_get(types, i), allow_root)
    }
    errors
  }
}

pub(package) fn check_move_only_storage_type_list_inner(tt: i64, src: i64, diag_pos: i64, types: i64) -[Diagnose]> i64 {
  check_move_only_storage_type_list_with(tt, src, diag_pos, types, 1)
}

pub(package) fn check_move_only_storage_record_fields(tt: i64, src: i64, diag_pos: i64, fields: i64) -[Diagnose]> i64 {
  let mut errors = 0
  if fields != 0 {
    for i in 0..nlist_len(fields) {
      errors = errors + check_move_only_storage_ty_inner(tt, src, diag_pos, ty_record_field_type(nlist_get(fields, i)), 0)
    }
  } else { 0 }
  errors
}

pub(package) fn check_move_only_storage_ty_inner(tt: i64, src: i64, diag_pos: i64, ty: i64, allow_root: i64) -[Diagnose]> i64 {
  if ty == 0 { 0 }
  else { if ty_tag(ty) == 18 {
    if allow_root == 0 {
      typeck_error_maybe(src, diag_pos, check_move_only_storage_reason_message(typeck_linear_layout_reason_unique()))
      1
    } else {
      let inner = typeck_linear_layout_type(tt, ty_f1(ty))
      if typeck_linear_layout_fact_decision(inner) == typeck_linear_layout_decision_copyable() { 0 }
      else {
        typeck_error_maybe(src, diag_pos, "type error: Unique cannot wrap another linear resource shape")
        1
      }
    }
  } else {
    let fact = typeck_linear_layout_type(tt, ty)
    if typeck_linear_layout_fact_decision(fact) == typeck_linear_layout_decision_unsupported() {
      typeck_error_maybe(src, diag_pos, check_move_only_storage_reason_message(typeck_linear_layout_fact_reason(fact)))
      1
    } else { 0 }
  } }
}

pub(package) fn check_move_only_storage_ty(tt: i64, src: i64, diag_pos: i64, ty: i64) -[Diagnose]> i64 {
  check_move_only_storage_ty_inner(tt, src, diag_pos, ty, 1)
}

pub(package) fn check_move_only_storage_field_ty(tt: i64, src: i64, diag_pos: i64, ty: i64) -[Diagnose]> i64 {
  check_move_only_storage_ty_inner(tt, src, diag_pos, ty, 0)
}

pub(package) fn check_move_only_storage_type_list(tt: i64, src: i64, diag_pos: i64, types: i64) -[Diagnose]> i64 {
  check_move_only_storage_type_list_inner(tt, src, diag_pos, types)
}

pub(package) fn check_move_only_storage_params(tt: i64, src: i64, params: i64) -[Diagnose]> i64 {
  let mut errors = 0
  let n = nlist_len(params)
  for i in 0..n {
    let p = nlist_get(params, i)
    errors = errors + check_move_only_storage_ty(tt, src, node_f1(p), node_f3(p))
  }
  errors
}

pub(package) fn check_type_cycles_entry(tt: i64, entry: i64) -[Diagnose]> i64 {
  let kind = mem_load64_at(entry, 16)
  let src = mem_load64_at(entry, 48)
  let type_ns = mem_load64_at(entry, 0)
  let type_nl = mem_load64_at(entry, 8)
  let owner_hash = type_name_hash(src, type_ns, type_nl)
  let type_decl = module_decl_fact_find(tt, src, module_decl_namespace_type(), src, type_ns, type_nl)
  let public_native = if ttable_native_binding_source_find(tt, src) == 0 or type_decl == 0 { 0 }
    else { if module_decl_fact_visibility_code(type_decl) == module_visibility_public() { 1 } else { 0 } }
  let mut errors = 0
  if kind == 0 {
    let nfields = mem_load64_at(entry, 24)
    let fields = mem_load64_at(entry, 32)
    for i in 0..nfields {
      let field_ty = mem_load64_at(fields, i * 24 + 16)
      errors = errors + check_public_arc_ty(tt, src, type_ns, field_ty)
      errors = errors + check_borrow_surface_ty(src, type_ns, field_ty)
      errors = errors + check_owned_resource_ty(tt, src, type_ns, field_ty)
      errors = errors + check_move_only_storage_field_ty(tt, src, type_ns, field_ty)
      errors = errors + check_type_cycle_ty(tt, src, type_ns, owner_hash, field_ty, 0)
      if public_native == 1 { errors = errors + check_native_binding_public_ty(src, type_ns, field_ty) } else { 0 }
    }
  } else { if kind == 1 {
    let nvariants = mem_load64_at(entry, 24)
    let variants = mem_load64_at(entry, 32)
    for vi in 0..nvariants {
      let npayloads = mem_load64_at(variants, vi * 40 + 24)
      let payloads = mem_load64_at(variants, vi * 40 + 32)
      for pi in 0..npayloads {
        let payload_ty = nlist_get(payloads, pi)
        errors = errors + check_public_arc_ty(tt, src, type_ns, payload_ty)
        errors = errors + check_borrow_surface_ty(src, type_ns, payload_ty)
        errors = errors + check_owned_resource_ty(tt, src, type_ns, payload_ty)
        errors = errors + check_move_only_storage_field_ty(tt, src, type_ns, payload_ty)
        errors = errors + check_type_cycle_ty(tt, src, type_ns, owner_hash, payload_ty, 0)
        if public_native == 1 { errors = errors + check_native_binding_public_ty(src, type_ns, payload_ty) } else { 0 }
      }
    }
  } else { if kind == 5 {
    let representation = ttable_entry_opaque_representation(entry)
    errors = errors + check_public_arc_ty(tt, src, type_ns, representation)
    errors = errors + check_borrow_surface_ty(src, type_ns, representation)
    errors = errors + check_owned_resource_ty(tt, src, type_ns, representation)
    errors = errors + check_move_only_storage_ty(tt, src, type_ns, representation)
    errors = errors + check_native_result_abi_ty(src, type_ns, representation)
  } else { errors = errors } } }
  errors
}

pub(package) fn check_type_cycles(tt: i64, user_src: i64) -[Diagnose]> i64 {
  if tt == 0 { 0 }
  else {
    let n = mem_load64_at(tt, 8)
    let d = mem_load64_at(tt, 0)
    let mut errors = 0
    for i in 0..n {
      let entry = d + i * 64
      let kind = mem_load64_at(entry, 16)
      let entry_src = mem_load64_at(entry, 48)
      if (kind == 0 or kind == 1 or kind == 5) and (user_src == 0 or entry_src == user_src) {
        errors = errors + check_type_cycles_entry(tt, entry)
      } else { errors = errors }
    }
    errors
  }
}

-- The compact rc header has 32 release-mask bits: two bits for each of
-- payload words 0..15. Records start at word 0; variants reserve word 0
-- for their tag. Wider all-unmanaged aggregates remain valid, but a
-- definitely- or potentially-managed field outside that window would
-- otherwise release shallow. Reject that layout while it is still a
-- source-level type fact.
pub(package) fn check_aggregate_release_mask_capacity_entry(entry: i64) -[Diagnose]> i64 {
  let kind = mem_load64_at(entry, 16)
  let src = mem_load64_at(entry, 48)
  let type_ns = mem_load64_at(entry, 0)
  let mut overflow = 0
  if kind == 0 {
    let nfields = mem_load64_at(entry, 24)
    let fields = mem_load64_at(entry, 32)
    let mut i = 0
    let mut word = 0
    while i < nfields and overflow == 0 {
      let field_ty = mem_load64_at(fields, i * 24 + 16)
      if word >= 16 and ty_field_may_require_release_mask(field_ty) == 1 { overflow = 1 }
      else {
        let width = ty_value_storage_word_count(field_ty)
        word = word + if width > 0 { width } else { 1 }
        i = i + 1
      }
    }
  } else { if kind == 1 {
    let nvariants = mem_load64_at(entry, 24)
    let variants = mem_load64_at(entry, 32)
    let mut vi = 0
    while vi < nvariants and overflow == 0 {
      let npayloads = mem_load64_at(variants, vi * 40 + 24)
      let payloads = mem_load64_at(variants, vi * 40 + 32)
      let mut pi = 0
      let mut word = 1
      while pi < npayloads and overflow == 0 {
        let payload_ty = nlist_get(payloads, pi)
        -- Fixed arrays occupy one managed storage-handle word in a variant.
        -- Records with direct arrays use the arbitrary-offset descriptor path,
        -- so this representation-specific capacity rule belongs here rather
        -- than in the type-wide compact-mask predicate.
        if word >= 16 and (ty_is_array(payload_ty) or ty_field_may_require_release_mask(payload_ty) == 1) { overflow = 1 }
        else {
          let width = ty_value_storage_word_count(payload_ty)
          word = word + if width > 0 { width } else { 1 }
          pi = pi + 1
        }
      }
      vi = vi + 1
    }
  } else { 0 } }
  if overflow == 1 {
    typeck_error_maybe(src, type_ns, "type error: aggregate field may require release beyond 16-word mask")
    1
  } else { 0 }
}

pub(package) fn check_aggregate_release_mask_capacity(tt: i64, user_src: i64) -[Diagnose]> i64 {
  if tt == 0 { 0 }
  else {
    let n = mem_load64_at(tt, 8)
    let d = mem_load64_at(tt, 0)
    let mut errors = 0
    for i in 0..n {
      let entry = d + i * 64
      let kind = mem_load64_at(entry, 16)
      let entry_src = mem_load64_at(entry, 48)
      if (kind == 0 or kind == 1) and (user_src == 0 or entry_src == user_src) {
        errors = errors + check_aggregate_release_mask_capacity_entry(entry)
      } else { 0 }
    }
    errors
  }
}

-- ══════════════════════════════════════════════════════════════
-- Trait bound checking at generic call sites
-- ══════════════════════════════════════════════════════════════

pub(package) fn typeck_type_list_location(items: i64, index: i64, src: i64, fallback_start: i64, fallback_len: i64) -> DiagnosticLocation {
  if items == 0 { typeck_source_location(src, fallback_start, fallback_len) }
  else {
    let locations = mem_load64_at(items, 24)
    if locations == 0 or index < 0 or index >= nlist_len(locations) { typeck_source_location(src, fallback_start, fallback_len) }
    else {
      let location = nlist_get(locations, index)
      typeck_source_location(src, node_f1(location), node_f2(location))
    }
  }
}

pub(package) fn typeck_trait_decl_from_atom(tt: i64, trait_atom: i64) -> i64 {
  let exact = trait_atom_decl(trait_atom)
  if exact != 0 { exact }
  else {
    let entry = lookup_trait_entry_ref(tt, trait_atom_head(trait_atom), 0)
    if entry == 0 { 0 }
    else {
      let entry_src = mem_load64_at(entry, 48)
      module_decl_fact_find(tt, entry_src, module_decl_namespace_trait(), entry_src, mem_load64_at(entry, 0), mem_load64_at(entry, 8))
    }
  }
}

pub(package) fn typeck_conformance_target_entry(tt: i64, target_ty: i64) -> i64 {
  let target_head = typeck_impl_target_head_type(target_ty)
  if target_head == 0 or ty_tag(target_head) != 9 { 0 }
  else { if ty_named_is_opaque(target_head) {
    ttable_lookup_decl_fact(tt, ty_named_opaque_declaration(target_head))
  } else {
    let record = ttable_find_entry_by_hash_kind(tt, ty_f1(target_head), 0)
    if record != 0 { record } else { ttable_find_entry_by_hash_kind(tt, ty_f1(target_head), 1) }
  } }
}

pub(package) fn typeck_conformance_target_decl(tt: i64, target_ty: i64) -> i64 {
  let target_head = typeck_impl_target_head_type(target_ty)
  if target_head != 0 and ty_named_is_opaque(target_head) { ty_named_opaque_declaration(target_head) }
  else {
    let entry = typeck_conformance_target_entry(tt, target_ty)
    if entry == 0 { 0 }
    else {
      let entry_src = mem_load64_at(entry, 48)
      module_decl_fact_find(tt, entry_src, module_decl_namespace_type(), entry_src, mem_load64_at(entry, 0), mem_load64_at(entry, 8))
    }
  }
}

pub(package) fn ctable_entry_target_subst(entry: i64, concrete_ty: i64) -> i64 {
  if entry == 0 { 0 }
  else {
    let target_ty = mem_load64_at(entry, 32)
    let tparams = mem_load64_at(entry, 24)
    let subst = subst_new()
    if target_ty == 0 { subst }
    else { if tparams == 0 {
      if ty_eq(target_ty, concrete_ty) or
        (ty_tag(target_ty) == 9 and not ty_named_is_opaque(target_ty) and not ty_named_is_opaque(concrete_ty) and ty_f1(target_ty) == type_hash_of(concrete_ty) and ty_f3(target_ty) == 0) { subst }
      else { 0 }
    } else { if ty_pattern_match(target_ty, concrete_ty, subst) { subst } else { 0 } } }
  }
}

pub(package) fn ctable_conformance_candidate_count(ct: i64, concrete_ty: i64, trait_atom: i64) -> i64 {
  if ct == 0 { 0 }
  else {
    let d = mem_load64_at(ct, 0)
    let n = mem_load64_at(ct, 8)
    let trait_hash = trait_atom_head(trait_atom)
    let trait_decl = trait_atom_decl(trait_atom)
    let concrete_hash = type_hash_of(concrete_ty)
    let mut count = 0
    for i in 0..n {
      let entry = d + i * 64
      let entry_decl = mem_load64_at(entry, 40)
      let same_trait = mem_load64_at(entry, 8) == trait_hash and (trait_decl == 0 or entry_decl == 0 or entry_decl == trait_decl)
      if mem_load64_at(entry, 0) == concrete_hash and same_trait and ctable_entry_target_subst(entry, concrete_ty) != 0 { count = count + 1 } else { 0 }
    }
    count
  }
}

-- Return [entry, failing concrete argument, failing nested trait] for the first
-- declaration-order conditional candidate whose target matches but whose
-- carried bound does not. This is the negative proof already used by the
-- oracle, made available to diagnostics instead of being discarded.
pub(package) fn ctable_first_failed_impl_bound(ct: i64, concrete_ty: i64, trait_atom: i64) -> i64 {
  if ct == 0 { 0 }
  else {
    let d = mem_load64_at(ct, 0)
    let n = mem_load64_at(ct, 8)
    let trait_hash = trait_atom_head(trait_atom)
    let trait_decl = trait_atom_decl(trait_atom)
    let concrete_hash = type_hash_of(concrete_ty)
    let mut result = 0
    let mut i = 0
    while i < n and result == 0 {
      let entry = d + i * 64
      let entry_decl = mem_load64_at(entry, 40)
      let same_trait = mem_load64_at(entry, 8) == trait_hash and (trait_decl == 0 or entry_decl == 0 or entry_decl == trait_decl)
      let subst = if mem_load64_at(entry, 0) == concrete_hash and same_trait { ctable_entry_target_subst(entry, concrete_ty) } else { 0 }
      let tparams = mem_load64_at(entry, 24)
      if subst != 0 and tparams != 0 {
        let mut ti = 0
        while ti < nlist_len(tparams) and result == 0 {
          let tp = nlist_get(tparams, ti)
          let arg = subst_lookup(subst, node_f3(tp))
          let bounds = node_f4(tp)
          let mut bi = 0
          while arg != 0 and bounds != 0 and bi < nlist_len(bounds) and result == 0 {
            let nested = ty_subst(nlist_get(bounds, bi), subst)
            if ctable_conforms_type_atom(ct, arg, nested) == 0 or typeck_trait_assoc_constraints_hold(ctable_ttable(ct), arg, nested) == 0 {
              result = node_new(0, entry, arg, nested, 0)
            } else { bi = bi + 1 }
          }
          ti = ti + 1
        }
      } else { 0 }
      i = i + 1
    }
    result
  }
}

pub(package) fn ctable_same_name_other_trait_entry(ct: i64, concrete_ty: i64, trait_atom: i64) -> i64 {
  let required_decl = trait_atom_decl(trait_atom)
  if ct == 0 or required_decl == 0 { 0 }
  else {
    let d = mem_load64_at(ct, 0)
    let n = mem_load64_at(ct, 8)
    let concrete_hash = type_hash_of(concrete_ty)
    let mut result = 0
    let mut i = 0
    while i < n and result == 0 {
      let entry = d + i * 64
      let entry_decl = mem_load64_at(entry, 40)
      let subst = if mem_load64_at(entry, 0) == concrete_hash and mem_load64_at(entry, 8) == trait_atom_head(trait_atom) and entry_decl != 0 and entry_decl != required_decl {
        ctable_entry_target_subst(entry, concrete_ty)
      } else { 0 }
      if subst != 0 and ctable_impl_bounds_hold(ct, mem_load64_at(entry, 24), subst) == 1 { result = entry } else { i = i + 1 }
    }
    result
  }
}

pub(package) fn typeck_sendability_reason_text(reason: i64) -> str {
  if reason == typeck_sendability_reason_any() { "dynamic `any` has no structural Sendable proof" }
  else { if reason == typeck_sendability_reason_effectful_function() { "effectful function values cannot cross this thread boundary" }
  else { if reason == typeck_sendability_reason_raw_pointer() { "raw pointers are not Sendable" }
  else { if reason == typeck_sendability_reason_continuation() { "continuations are thread-affine" }
  else { if reason == typeck_sendability_reason_mutable_slice() { "mutable slices require scoped-join provenance" }
  else { if reason == typeck_sendability_reason_owned_resource() { "owned resources are not structurally Sendable" }
  else { if reason == typeck_sendability_reason_mutable_state() { "reachable mutable state is not Sendable" }
  else { if reason == typeck_sendability_reason_open_record() { "open records do not prove every field Sendable" }
  else { if reason == typeck_sendability_reason_type_evidence() { "this type still requires Sendable evidence" }
  else { if reason == typeck_sendability_reason_unknown_nominal() { "the nominal representation has no Sendable proof" }
  else { if reason == typeck_sendability_reason_runtime_token() { "sealed runtime tokens cannot cross this thread boundary" }
  else { if reason == typeck_sendability_reason_unsupported_type() { "this type shape has no structural Sendable rule" }
  else { if reason == typeck_sendability_reason_capture_unproven() { "closure captures have not been proven Sendable" }
  else { if reason == typeck_sendability_reason_mutable_capture() { "the closure captures mutable state" }
  else { if reason == typeck_sendability_reason_linear_capture() { "the closure captures a linear value" }
  else { "this type is not structurally Sendable" } } } } } } } } } } } } } } }
}

pub(package) fn typeck_sendability_diagnostic_reason_text(fact: i64) -> str {
  let needs = typeck_sendability_fact_needs(fact)
  if typeck_sendability_fact_decision(fact) == typeck_sendability_decision_yes() and (needs band typeck_sendability_needs_capture_proof()) != 0 {
    "a function type alone cannot prove its concrete closure captures are Sendable"
  } else { if typeck_sendability_fact_decision(fact) == typeck_sendability_decision_yes() and (needs band typeck_sendability_needs_scoped_borrow()) != 0 {
    "a slice type alone cannot prove the scoped-join provenance of its concrete borrow"
  } else { typeck_sendability_reason_text(typeck_sendability_fact_reason(fact)) } }
}

pub(package) fn typeck_conformance_message(target_text: str, trait_text: str) -> str {
  let b = buf_new(__str_len(target_text) + __str_len(trait_text) + 48)
  bstr(b, "type `") bstr(b, target_text) bstr(b, "` does not implement `") bstr(b, trait_text) bstr(b, "`")
  runtime_str_from_bytes_copy(buf_ptr(b), buf_len(b))
}

pub(package) fn typeck_report_trait_conformance(
  target_ty: i64,
  trait_atom: i64,
  tt: i64,
  src: i64,
  start: i64,
  len: i64,
  bound_location: DiagnosticLocation,
  context: str,
  projection_tparams: i64
) -[Diagnose]> i64 {
  let ct = ttable_get_ct(tt)
  let target_fact = semantic_type_fact(target_ty, tt, src, projection_tparams)
  -- Associated-type equality constraints refine a trait obligation; the
  -- conformance diagnostic still names the owning trait when the base
  -- implementation itself is absent.
  let trait_fact = semantic_type_fact(trait_atom_base(trait_atom), tt, src, projection_tparams)
  let target_text = target_fact.render()
  let trait_text = trait_fact.render()
  let failed_candidate = ctable_first_failed_impl_bound(ct, target_ty, trait_atom)
  let nearby_entry = ctable_same_name_other_trait_entry(ct, target_ty, trait_atom)
  let sendability = if trait_atom_head(trait_atom) == typeck_sendable_trait_hash() { typeck_sendability_type(tt, target_ty) } else { 0 }
  let reason = if ty_tag(target_ty) == 12 { "missing_carried_bound" }
    else { if nearby_entry != 0 { "different_trait_declaration" }
    else { if failed_candidate != 0 { "conditional_impl_bound_failed" }
    else { if sendability != 0 { "sealed_structural_requirement" } else { "missing_impl" } } } }
  let trait_decl = typeck_trait_decl_from_atom(tt, trait_atom)
  let target_decl = typeck_conformance_target_decl(tt, target_ty)
  let trait_src = if trait_decl == 0 { 0 } else { module_decl_fact_source(trait_decl) }
  let target_src = if target_decl == 0 { 0 } else { module_decl_fact_source(target_decl) }
  let impl_allowed = sendability == 0 and ty_tag(target_ty) != 12 and (trait_src == src or target_src == src)
  let impl_placement = if sendability != 0 { "sealed_structural_predicate" }
    else { if ty_tag(target_ty) == 12 { "carry_bound" }
    else { if trait_src == src { "current_module_trait_local" }
    else { if target_src == src { "current_module_type_local" }
    else { if target_decl == 0 { "trait_defining_module_only" } else { "trait_or_type_defining_module" } } } } }
  let candidate_count = ctable_conformance_candidate_count(ct, target_ty, trait_atom)
  let mut fields = DiagnosticFieldCons(
    DiagnosticFieldText("context", context),
    DiagnosticFieldCons(
      DiagnosticFieldText("reason", reason),
      DiagnosticFieldCons(
        DiagnosticFieldText("decision", "no"),
        DiagnosticFieldCons(
          DiagnosticFieldType("target_type", target_fact),
          DiagnosticFieldCons(
            DiagnosticFieldType("required_trait", trait_fact),
            DiagnosticFieldCons(
              DiagnosticFieldText("target_type_text", target_text),
              DiagnosticFieldCons(
                DiagnosticFieldText("required_trait_text", trait_text),
                DiagnosticFieldCons(
                  DiagnosticFieldBool("impl_allowed_here", impl_allowed),
                  DiagnosticFieldCons(
                    DiagnosticFieldText("impl_placement", impl_placement),
                    DiagnosticFieldCons(
                      DiagnosticFieldI64("candidate_impl_count", candidate_count),
                      DiagnosticFieldCons(
                        DiagnosticFieldSuggestion(DiagnosticSuggestion(
                          if impl_allowed {
                            "define a legal implementation in this module or use a conforming type"
                          } else { if ty_tag(target_ty) == 12 {
                            "carry the required bound on the enclosing type parameter"
                          } else { if sendability != 0 {
                            "change the value shape so it has a structural Sendable proof"
                          } else {
                            "add the implementation in a module that owns the trait or target type, or use a conforming type"
                          } } },
                          DiagnosticSuggestionMaybeIncorrect,
                          DiagnosticTextEditNil
                        )),
                        DiagnosticFieldNil
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
  let mut related = DiagnosticRelatedLocationNil
  if target_decl != 0 { related = DiagnosticRelatedLocationCons(DiagnosticRelatedLocation("target type declared here", module_diagnostic_decl_location(target_decl)), related) } else { 0 }
  if trait_decl != 0 { related = DiagnosticRelatedLocationCons(DiagnosticRelatedLocation("trait declared here", module_diagnostic_decl_location(trait_decl)), related) } else { 0 }
  match bound_location {
    DiagnosticLocationNone -> 0
    _ -> { related = DiagnosticRelatedLocationCons(DiagnosticRelatedLocation("required by this trait bound", bound_location), related) 0 }
  }
  if failed_candidate != 0 {
    let candidate_entry = node_f1(failed_candidate)
    let nested_ty = node_f2(failed_candidate)
    let nested_trait = node_f3(failed_candidate)
    let candidate_src = mem_load64_at(candidate_entry, 48)
    let candidate_span = mem_load64_at(candidate_entry, 56)
    let candidate_tparams = mem_load64_at(candidate_entry, 24)
    let candidate_target_fact = semantic_type_fact(mem_load64_at(candidate_entry, 32), tt, candidate_src, candidate_tparams)
    let nested_ty_fact = semantic_type_fact(nested_ty, tt, src, projection_tparams)
    let nested_trait_fact = semantic_type_fact(trait_atom_base(nested_trait), tt, candidate_src, candidate_tparams)
    fields = DiagnosticFieldCons(DiagnosticFieldType("candidate_target", candidate_target_fact), fields)
    fields = DiagnosticFieldCons(DiagnosticFieldType("unsatisfied_nested_type", nested_ty_fact), fields)
    fields = DiagnosticFieldCons(DiagnosticFieldType("unsatisfied_nested_trait", nested_trait_fact), fields)
    fields = DiagnosticFieldCons(DiagnosticFieldText("candidate_target_text", candidate_target_fact.render()), fields)
    fields = DiagnosticFieldCons(DiagnosticFieldText("unsatisfied_nested_type_text", nested_ty_fact.render()), fields)
    fields = DiagnosticFieldCons(DiagnosticFieldText("unsatisfied_nested_trait_text", nested_trait_fact.render()), fields)
    if candidate_src != 0 and candidate_span != 0 {
      related = DiagnosticRelatedLocationCons(DiagnosticRelatedLocation("matching impl candidate rejected by its own bound", typeck_source_location(candidate_src, node_f1(candidate_span), node_f2(candidate_span))), related)
    } else { 0 }
  } else { 0 }
  if nearby_entry != 0 {
    let nearby_decl = mem_load64_at(nearby_entry, 40)
    let nearby_atom = if nearby_decl != 0 { ty_qualified_trait(nearby_decl) } else { ty_trait(mem_load64_at(nearby_entry, 8)) }
    let nearby_fact = semantic_type_fact(nearby_atom, tt, src, projection_tparams)
    fields = DiagnosticFieldCons(DiagnosticFieldType("nearby_trait", nearby_fact), fields)
    fields = DiagnosticFieldCons(DiagnosticFieldText("nearby_trait_text", nearby_fact.render()), fields)
    if nearby_decl != 0 { related = DiagnosticRelatedLocationCons(DiagnosticRelatedLocation("this is the distinct trait declaration the type implements", module_diagnostic_decl_location(nearby_decl)), related) } else { 0 }
  } else { 0 }
  if sendability != 0 {
    let offender = typeck_sendability_fact_offender(sendability)
    fields = DiagnosticFieldCons(DiagnosticFieldText("sendability_reason", typeck_sendability_diagnostic_reason_text(sendability)), fields)
    if offender != 0 { fields = DiagnosticFieldCons(DiagnosticFieldType("sendability_offender", semantic_type_fact(offender, tt, src, projection_tparams)), fields) } else { 0 }
  } else { 0 }
  Diagnose.report(Diagnostic(
    DiagnosticSeverityError,
    DiagnosticClassType,
    registry.trait_conformance(),
    typeck_conformance_message(target_text, trait_text),
    typeck_source_location(src, start, len),
    related,
    fields
  ))
}

-- Check that each concrete type arg satisfies its declared trait bound.
-- tparams: list of node_new(2, ns, nl, var_id, bound)
-- type_args: list of concrete type nodes
-- Returns number of errors.
pub(package) fn check_trait_bounds_at(tparams: i64, type_args: i64, src: i64, call_ns: i64, call_len: i64, bound_src: i64, tt: i64, context: str) -[Conformance, Diagnose]> i64 {
  let n = nlist_len(tparams)
  let mut errors = 0
  let call_subst = build_subst(tparams, type_args)
  for i in 0..n {
    let tp = nlist_get(tparams, i)
    let bounds = node_f4(tp)
    if bounds != 0 {
      -- Bounds are semantic trait atoms; qualified atoms retain DeclId.
      if i < nlist_len(type_args) {
        let type_arg = nlist_get(type_args, i)
        -- Check each bound in the list
        let nbounds = nlist_len(bounds)
        for bi in 0..nbounds {
          let trait_atom = typeck_subst_resolve_associated_type(nlist_get(bounds, bi), tparams, call_subst, tt)
          let carried_bound = if ty_tag(type_arg) == 12 {
            impl_tparam_has_bound(ttable_get_tparams(tt), ty_var_id(type_arg), trait_atom)
          } else { false }
          if not carried_bound and Conformance.conforms(type_arg, trait_atom) == 0 {
            let primary = typeck_type_list_location(type_args, i, src, call_ns, call_len)
            let primary_start = primary.start()
            let primary_len = primary.end() - primary_start
            let bound_location = typeck_type_list_location(bounds, bi, bound_src, node_f1(tp), node_f2(tp))
            typeck_report_trait_conformance(type_arg, trait_atom, tt, src, primary_start, primary_len, bound_location, context, ttable_get_tparams(tt))
            errors = errors + 1
          } else {
            if typeck_trait_assoc_constraints_hold(tt, type_arg, trait_atom) == 0 {
              let primary = typeck_type_list_location(type_args, i, src, call_ns, call_len)
              typeck_error_maybe(src, primary.start(), "type error: associated type constraint mismatch")
              errors = errors + 1
            } else { errors = errors }
          }
        }
      } else { errors = errors }
    } else { errors = errors }
  }
  errors
}

pub(package) fn impl_tparam_bound_atom(tparams: i64, var_id: i64, required: i64) -> i64 {
  if tparams == 0 { 0 }
  else {
    let mut result = 0
    let mut i = 0
    while i < nlist_len(tparams) and result == 0 {
      let tp = nlist_get(tparams, i)
      if node_f3(tp) == var_id {
        let bounds = node_f4(tp)
        let mut bi = 0
        while bounds != 0 and bi < nlist_len(bounds) and result == 0 {
          let candidate = nlist_get(bounds, bi)
          if trait_atom_eq(candidate, required) { result = candidate } else { bi = bi + 1 }
        }
        i = nlist_len(tparams)
      } else { i = i + 1 }
    }
    result
  }
}

pub(package) fn ctable_associated_binding_type(ct: i64, concrete_ty: i64, trait_atom: i64, assoc_hash: i64) -> i64 {
  if ct == 0 { 0 }
  else {
    let data = mem_load64_at(ct, 0)
    let count = mem_load64_at(ct, 8)
    let concrete_hash = type_hash_of(concrete_ty)
    let required_hash = trait_atom_head(trait_atom)
    let required_decl = trait_atom_decl(trait_atom)
    let mut result = 0
    let mut i = 0
    while i < count and result == 0 {
      let entry = data + i * 64
      let entry_decl = mem_load64_at(entry, 40)
      let same_trait = mem_load64_at(entry, 8) == required_hash and (required_decl == 0 or entry_decl == 0 or entry_decl == required_decl)
      let subst = if mem_load64_at(entry, 0) == concrete_hash and same_trait { ctable_entry_target_subst(entry, concrete_ty) } else { 0 }
      if subst != 0 and ctable_impl_bounds_hold(ct, mem_load64_at(entry, 24), subst) == 1 {
        let methods = mem_load64_at(entry, 16)
        let impl_src = mem_load64_at(entry, 48)
        let mut mi = 0
        while methods != 0 and mi < nlist_len(methods) and result == 0 {
          let member = nlist_get(methods, mi)
          if node_tag(member) == 43 and effect_name_hash(impl_src, node_f1(member), node_f2(member)) == assoc_hash {
            result = ty_subst(node_f3(member), subst)
          } else { mi = mi + 1 }
        }
      } else { 0 }
      i = i + 1
    }
    result
  }
}

pub(package) fn typeck_trait_assoc_constraints_hold(tt: i64, concrete_ty: i64, trait_atom: i64) -> i64 {
  let bindings = trait_atom_assoc_bindings(trait_atom)
  if bindings == 0 { 1 }
  else {
    let carried = if ty_tag(concrete_ty) == 12 {
      impl_tparam_bound_atom(ttable_get_tparams(tt), ty_var_id(concrete_ty), trait_atom)
    } else { 0 }
    let mut ok = 1
    let mut i = 0
    while i < nlist_len(bindings) and ok == 1 {
      let binding = nlist_get(bindings, i)
      let actual = if carried != 0 {
        trait_atom_assoc_type(carried, trait_assoc_binding_name(binding))
      } else {
        ctable_associated_binding_type(ttable_get_ct(tt), concrete_ty, trait_atom, trait_assoc_binding_name(binding))
      }
      if actual != 0 and ty_eq(actual, trait_assoc_binding_type(binding)) { i = i + 1 }
      else { ok = 0 }
    }
    ok
  }
}

pub(package) fn check_trait_bounds(tparams: i64, type_args: i64, src: i64, call_ns: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  check_trait_bounds_at(tparams, type_args, src, call_ns, 1, src, tt, "generic argument")
}

-- Get the type_hash of a concrete type (for conformance checking)
-- Matches the convention in type_name_hash: prims are negative, named are hashes
pub(package) fn type_hash_of(ty: i64) -> i64 {
  let tag = ty_tag(ty)
  if tag == 2 { 0 - ty_f1(ty) - 1 }
  else { if tag == 9 { ty_f1(ty) }
  else { if tag == 18 or tag == 19 { type_hash_of(ty_f1(ty)) }
  else { 0 } }
  }
}

pub(package) fn type_is_unknown_or_any(ty: i64) -> bool {
  if ty == 0 { true }
  else { ty_tag(ty) == 1 }
}

pub(package) fn type_is_nil_exact(ty: i64) -> i64 {
  if type_is_unknown_or_any(ty) { false }
  else { ty_tag(ty) == 2 and ty_f1(ty) == PRIM_NIL() }
}

pub(package) fn type_allows_nil(ty: i64) -[Conformance]> i64 {
  if type_is_unknown_or_any(ty) { false }
  else { is_subtype(ty_nil(), ty) }
}

pub(package) fn type_union_with_nil_subtype_of(ty: i64, inner: i64) -[Conformance]> bool {
  if type_is_unknown_or_any(ty) { false }
  else { if type_is_unknown_or_any(inner) { false }
  else { if ty_tag(ty) != 3 { false }
  else {
    let lhs = ty_f1(ty)
    let rhs = ty_f2(ty)
    if type_is_nil_exact(lhs) == 1 { is_subtype(rhs, inner) }
    else { if type_is_nil_exact(rhs) == 1 { is_subtype(lhs, inner) }
    else { false } }
  } } }
}

pub(package) fn type_nullable_equality_compatible(lhs_ty: i64, rhs_ty: i64) -[Conformance]> i64 {
  if type_is_nil_exact(lhs_ty) == 1 { type_allows_nil(rhs_ty) }
  else { if type_is_nil_exact(rhs_ty) == 1 { type_allows_nil(lhs_ty) }
  else { if type_union_with_nil_subtype_of(lhs_ty, rhs_ty) == 1 and is_subtype(rhs_ty, lhs_ty) { true }
  else { type_union_with_nil_subtype_of(rhs_ty, lhs_ty) == 1 and is_subtype(lhs_ty, rhs_ty) } } }
}

pub(package) fn type_is_i64_like(ty: i64) -[Conformance]> i64 {
  if type_is_unknown_or_any(ty) { false }
  else { is_subtype(ty, ty_i64()) }
}

pub(package) fn type_is_f64_exact(ty: i64) -> bool {
  if type_is_unknown_or_any(ty) { false }
  else { ty_tag(ty) == 2 and ty_f1(ty) == PRIM_F64() }
}

pub(package) fn type_is_f32_exact(ty: i64) -> bool {
  if type_is_unknown_or_any(ty) { false }
  else { ty_tag(ty) == 2 and ty_f1(ty) == PRIM_F32() }
}

pub(package) fn type_is_float_exact(ty: i64) -> i64 {
  type_is_f64_exact(ty) == 1 or type_is_f32_exact(ty) == 1
}

pub(package) fn prim_is_integer(prim: i64) -> i64 {
  prim == PRIM_I64() or prim == PRIM_I32() or prim == PRIM_I8() or prim == PRIM_I16() or prim == PRIM_U8() or prim == PRIM_U16() or prim == PRIM_U32() or prim == PRIM_U64() or prim == PRIM_ISIZE() or prim == PRIM_USIZE()
}

pub(package) fn prim_is_unsigned_integer(prim: i64) -> i64 {
  prim == PRIM_U8() or prim == PRIM_U16() or prim == PRIM_U32() or prim == PRIM_U64() or prim == PRIM_USIZE()
}

pub(package) fn type_int_prim(ty: i64) -> i64 {
  if type_is_unknown_or_any(ty) { 0 - 1 }
  else { if ty_tag(ty) != 2 { 0 - 1 }
  else {
    let prim = ty_f1(ty)
    if prim_is_integer(prim) == 1 { prim } else { 0 - 1 }
  } }
}

pub(package) fn type_is_integer_exact(ty: i64) -> i64 {
  type_int_prim(ty) >= 0
}

pub(package) fn type_is_unsigned_integer_exact(ty: i64) -> i64 {
  let prim = type_int_prim(ty)
  if prim < 0 { 0 } else { prim_is_unsigned_integer(prim) }
}

pub(package) fn type_is_numeric(ty: i64) -> bool {
  type_is_integer_exact(ty) == 1 or type_is_float_exact(ty) == 1
}

pub(package) fn expr_is_zero_i64_lit(node: i64) -> bool {
  if node_tag(node) == 1 { node_f1(node) == 0 } else { false }
}

pub(package) fn int_prim_positive_max(prim: i64) -> i64 {
  if prim == PRIM_I8() { 127 }
  else { if prim == PRIM_I16() { 32767 }
  else { if prim == PRIM_I32() { 2147483647 }
  else { if prim == PRIM_U8() { 255 }
  else { if prim == PRIM_U16() { 65535 }
  else { if prim == PRIM_U32() { 4294967295 }
  else { if prim == PRIM_U64() { 9223372036854775807 }
  else { if prim == PRIM_ISIZE() { 9223372036854775807 }
  else { if prim == PRIM_USIZE() { 9223372036854775807 }
  else { 9223372036854775807 } } } } } } } } }
}

pub(package) fn int_prim_positive_max_str(prim: i64) -> str {
  if prim == PRIM_I8() { "127" }
  else { if prim == PRIM_I16() { "32767" }
  else { if prim == PRIM_I32() { "2147483647" }
  else { if prim == PRIM_U8() { "255" }
  else { if prim == PRIM_U16() { "65535" }
  else { if prim == PRIM_U32() { "4294967295" }
  else { if prim == PRIM_U64() { "18446744073709551615" }
  else { if prim == PRIM_ISIZE() { "9223372036854775807" }
  else { if prim == PRIM_USIZE() { "18446744073709551615" }
  else { "9223372036854775807" } } } } } } } } }
}

pub(package) fn int_prim_negative_magnitude_max(prim: i64) -> i64 {
  if prim == PRIM_I8() { 128 }
  else { if prim == PRIM_I16() { 32768 }
  else { if prim == PRIM_I32() { 2147483648 }
  else { if prim == PRIM_ISIZE() { 9223372036854775807 }
  else { 9223372036854775807 } } } }
}

pub(package) fn int_prim_negative_magnitude_max_str(prim: i64) -> str {
  if prim == PRIM_I8() { "128" }
  else { if prim == PRIM_I16() { "32768" }
  else { if prim == PRIM_I32() { "2147483648" }
  else { if prim == PRIM_ISIZE() { "9223372036854775808" }
  else { "9223372036854775808" } } } }
}

pub(package) fn int_literal_has_span(node: i64) -> i64 {
  node != 0 and node_f3(node) > 0
}

pub(package) fn int_literal_positive_fits_prim(node: i64, prim: i64, src: i64) -> i64 {
  if int_literal_has_span(node) == 1 {
    decimal_span_le_str(src, node_f2(node), node_f3(node), int_prim_positive_max_str(prim))
  } else {
    let value = node_f1(node)
    if value >= 0 and value <= int_prim_positive_max(prim) { 1 } else { 0 }
  }
}

pub(package) fn int_literal_negative_magnitude_fits_prim(node: i64, prim: i64, src: i64) -> i64 {
  if prim_is_unsigned_integer(prim) == 1 { 0 }
  else { if int_literal_has_span(node) == 1 {
    decimal_span_le_str(src, node_f2(node), node_f3(node), int_prim_negative_magnitude_max_str(prim))
  } else {
    let mag = node_f1(node)
    if mag >= 0 and mag <= int_prim_negative_magnitude_max(prim) { 1 } else { 0 }
  } }
}

pub(package) fn expr_is_contextual_int_lit_for_prim(node: i64, prim: i64, src: i64) -> i64 {
  if node == 0 { 0 }
  else {
    let tag = node_tag(node)
    if tag == 1 {
      if node_f4(node) != 0 { type_int_prim(node_f4(node)) == prim }
      else { int_literal_positive_fits_prim(node, prim, src) }
    } else { if tag == 3 and node_f1(node) == 2 and expr_is_zero_i64_lit(node_f2(node)) == 1 and node_tag(node_f3(node)) == 1 {
      int_literal_negative_magnitude_fits_prim(node_f3(node), prim, src)
    } else { 0 } }
  }
}

pub(package) fn expr_is_contextual_int_lit_shape(node: i64) -> i64 {
  if node == 0 { 0 }
  else {
    let tag = node_tag(node)
    if tag == 1 { 1 }
    else { if tag == 3 and node_f1(node) == 2 and expr_is_zero_i64_lit(node_f2(node)) == 1 and node_tag(node_f3(node)) == 1 { 1 }
    else { 0 } }
  }
}

pub(package) fn expr_matches_int_prim_contextual(node: i64, node_ty: i64, prim: i64, src: i64) -> i64 {
  if expr_is_contextual_int_lit_shape(node) == 1 { expr_is_contextual_int_lit_for_prim(node, prim, src) }
  else { if type_int_prim(node_ty) == prim { 1 }
  else { expr_is_contextual_int_lit_for_prim(node, prim, src) }
  }
}

pub(package) fn expr_contextual_int_match_arms_match_type(arms: i64, count: i64, prim: i64, src: i64) -> i64 {
  let mut matches = 1
  for i in 0..count {
    if expr_contextual_int_tree_matches_prim(node_f2(nlist_get(arms, i)), prim, src) != 1 { matches = 0 } else { 0 }
  }
  matches
}

pub(package) fn expr_contextual_int_tree_matches_prim(node: i64, prim: i64, src: i64) -> i64 {
  if expr_is_contextual_int_lit_shape(node) == 1 { expr_is_contextual_int_lit_for_prim(node, prim, src) }
  else {
    match node_tag(node) {
      5 -> expr_contextual_int_tree_matches_prim(node_f2(node), prim, src) == 1 and expr_contextual_int_tree_matches_prim(node_f3(node), prim, src) == 1
      6 -> expr_contextual_int_tree_matches_prim(node_f4(node), prim, src)
      7 -> expr_contextual_int_tree_matches_prim(node_f2(node), prim, src)
      11 -> expr_contextual_int_tree_matches_prim(node_f4(node), prim, src)
      15 -> expr_contextual_int_match_arms_match_type(node_f2(node), node_f3(node), prim, src)
      37 -> expr_contextual_int_tree_matches_prim(node_f4(node_f1(node)), prim, src)
      52 -> expr_contextual_int_tree_matches_prim(node_f2(node), prim, src)
      _ -> 0
    }
  }
}

pub(package) fn expr_contextual_int_lit_matches_type(node: i64, target_ty: i64, src: i64) -> i64 {
  let prim = type_int_prim(target_ty)
  if prim >= 0 { expr_contextual_int_tree_matches_prim(node, prim, src) } else { 0 }
}

pub(package) fn expr_contextual_f32_match_arms_match(arms: i64, count: i64) -> i64 {
  let mut matches = 1
  for i in 0..count {
    if expr_is_contextual_f32_literal_tree(node_f2(nlist_get(arms, i))) != 1 { matches = 0 } else { 0 }
  }
  matches
}

pub(package) fn expr_is_contextual_f32_literal_tree(node: i64) -> i64 {
  if node == 0 { 0 }
  else {
    match node_tag(node) {
      54 -> 1
      3 -> {
        let op = node_f1(node)
        if op >= 1 and op <= 4 {
          if op == 2 and expr_is_zero_i64_lit(node_f2(node)) == 1 {
            expr_is_contextual_f32_literal_tree(node_f3(node))
          } else {
            expr_is_contextual_f32_literal_tree(node_f2(node)) == 1 and expr_is_contextual_f32_literal_tree(node_f3(node)) == 1
          }
        } else { 0 }
      }
      5 -> expr_is_contextual_f32_literal_tree(node_f2(node)) == 1 and expr_is_contextual_f32_literal_tree(node_f3(node)) == 1
      6 -> expr_is_contextual_f32_literal_tree(node_f4(node))
      7 -> expr_is_contextual_f32_literal_tree(node_f2(node))
      11 -> expr_is_contextual_f32_literal_tree(node_f4(node))
      15 -> expr_contextual_f32_match_arms_match(node_f2(node), node_f3(node))
      37 -> expr_is_contextual_f32_literal_tree(node_f4(node_f1(node)))
      52 -> expr_is_contextual_f32_literal_tree(node_f2(node))
      _ -> 0
    }
  }
}

pub(package) fn expr_matches_f32_contextual(node: i64, node_ty: i64) -> i64 {
  if type_is_f32_exact(node_ty) == 1 { 1 }
  else { expr_is_contextual_f32_literal_tree(node) }
}

-- Literal 0/1 in a bool-expected position: the singletons {0} and {1}
-- ARE false and true in the value model, so the literals check as bool.
pub(package) fn expr_is_bool_int_literal(node: i64, src: i64) -> i64 {
  if node_tag(node) != 1 { 0 }
  else { if int_literal_has_span(node) == 1 {
    if node_f3(node) == 1 {
      let ch = mem_load8_at(src, node_f2(node))
      if ch == 48 or ch == 49 { 1 } else { 0 }
    } else { 0 }
  } else {
    if node_f1(node) == 0 or node_f1(node) == 1 { 1 } else { 0 }
  } }
}

pub(package) fn type_is_bool_exact(ty: i64) -> i64 {
  if ty == 0 { 0 }
  else { if ty_tag(ty) != 2 { 0 } else { ty_f1(ty) == PRIM_BOOL() } }
}

pub(package) fn expr_array_matches_type_contextual(node: i64, node_ty: i64, target_ty: i64, src: i64) -[Conformance]> i64 {
  if node_tag(node) != 58 or not ty_is_array(target_ty) { 0 }
  else { if node_f2(node) != ty_array_length(target_ty) { 0 }
  else {
    if ty_eq(node_f3(node), target_ty) { 1 }
    else { if is_subtype(node_ty, target_ty) { mem_store64_at(node, 24, target_ty) 1 } else { 0 } }
  } }
}

-- Expected-type preparation is the type-checker's single producer for the
-- resolved array-literal fact. It runs where the full environment is known;
-- the pure compatibility predicate above then consumes only that fact.
pub(package) fn prepare_expr_contextual(node: i64, target_ty: i64, env: i64, ft: i64, src: i64, tt: i64) -[Conformance]> i64 {
  let target = if ty_is_unique(target_ty) == 1 { ty_unique_inner(target_ty) }
    else { if ty_is_owned(target_ty) == 1 { ty_owned_inner(target_ty) } else { target_ty } }
  if node_tag(node) == 58 and ty_is_array(target) {
    if node_f2(node) != ty_array_length(target) { 0 }
  else {
    let elements = node_f1(node)
    let inner_ty = ty_array_inner(target)
    let mut matches = 1
    for i in 0..node_f2(node) {
      let element = nlist_get(elements, i)
      prepare_expr_contextual(element, inner_ty, env, ft, src, tt)
      let element_ty = synth(element, env, ft, src, tt)
      if expr_matches_type_contextual(element, element_ty, inner_ty, src, ft) != 1 {
        if infer_generic_ctor_result(element, inner_ty, env, ft, src, tt) == 1 and expr_matches_type_contextual(element, synth(element, env, ft, src, tt), inner_ty, src, ft) == 1 { 0 }
        else { matches = 0 }
      } else { 0 }
    }
    if matches == 1 { mem_store64_at(node, 24, target) } else { 0 }
    matches
  }
  } else {
    match node_tag(node) {
      14 -> {
        if record_init_is_structural(node) and ty_is_record(target) and record_init_is_tuple(node) == (ty_record_tuple_kind(target) == 1) {
          let fields = node_f3(node)
          let mut matches = 1
          for i in 0..node_f4(node) {
            let field = nlist_get(fields, i)
            let field_hash = record_value_field_hash(field, src)
            let target_field = ty_record_field_by_hash(ty_record_fields(target), field_hash)
            if target_field == 0 {
              if ty_record_open(target) == 0 { matches = 0 } else { 0 }
            } else {
              let expected_ty = ty_record_field_type(target_field)
              let value = node_f3(field)
              prepare_expr_contextual(value, expected_ty, env, ft, src, tt)
              let value_ty = synth(value, env, ft, src, tt)
              if expr_matches_type_contextual(value, value_ty, expected_ty, src, ft) == 1 {
                mem_store64_at(field, 32, node_new(1, expected_ty, field_hash, ty_record_field_word_offset(target, field_hash), 0))
              } else { matches = 0 }
            }
          }
          if matches == 1 {
            -- Contextual types refine field values, but an open record is a
            -- predicate and has no physical offsets. Rebuild the literal's
            -- facts from its own exact closed shape before lowering consumes
            -- them; otherwise an open argument context poisons every matched
            -- field with the predicate's `-1` offset.
            let actual = synth_structural_record_init(node, env, ft, src, tt)
            record_init_write_structural_facts(node, actual, src)
            if is_subtype(actual, target) { 1 } else { 0 }
          } else { 0 }
        } else { 0 }
      }
      63 -> {
        let base_ty = synth(node_f1(node), env, ft, src, tt)
        if ty_is_record(base_ty) and ty_record_open(base_ty) == 0 and ty_is_record(target) and ty_record_tuple_kind(base_ty) == ty_record_tuple_kind(target) {
          let fields = node_f2(node)
          let mut matches = 1
          for i in 0..node_f3(node) {
            let field = nlist_get(fields, i)
            let field_hash = record_value_field_hash(field, src)
            let target_field = ty_record_field_by_hash(ty_record_fields(target), field_hash)
            if target_field == 0 {
              if ty_record_open(target) == 0 { matches = 0 } else { 0 }
            } else {
              let expected_ty = ty_record_field_type(target_field)
              let value = node_f3(field)
              prepare_expr_contextual(value, expected_ty, env, ft, src, tt)
              if expr_matches_type_contextual(value, synth(value, env, ft, src, tt), expected_ty, src, ft) != 1 { matches = 0 } else { 0 }
            }
          }
          if matches == 1 and is_subtype(synth_record_update(node, env, ft, src, tt), target) { 1 } else { 0 }
        } else { 0 }
      }
      5 -> {
        let then_ok = prepare_expr_contextual(node_f2(node), target, tenv_narrow_guard(env, node_f1(node), 6, src), ft, src, tt)
        let else_ok = prepare_expr_contextual(node_f3(node), target, tenv_narrow_guard(env, node_f1(node), 5, src), ft, src, tt)
        if then_ok == 1 and else_ok == 1 { 1 } else { 0 }
      }
      6 -> {
        let val_ty = synth(node_f3(node), env, ft, src, tt)
        prepare_expr_contextual(node_f4(node), target, tenv_bind(env, src, node_f1(node), node_f2(node), val_ty), ft, src, tt)
      }
      7 -> prepare_expr_contextual(node_f2(node), target, env, ft, src, tt)
      11 -> {
        let val_ty = synth(node_f3(node), env, ft, src, tt)
        prepare_expr_contextual(node_f4(node), target, tenv_bind_mut(env, src, node_f1(node), node_f2(node), val_ty), ft, src, tt)
      }
      15 -> {
        let scr_ty = synth(node_f1(node), env, ft, src, tt)
        let mut matches = 1
        for i in 0..node_f3(node) {
          let arm = nlist_get(node_f2(node), i)
          let arm_env = bind_match_pattern(node_f1(arm), env, src, scr_ty, tt)
          if prepare_expr_contextual(node_f2(arm), target, arm_env, ft, src, tt) != 1 { matches = 0 } else { 0 }
        }
        matches
      }
      37 -> {
        let inner = node_f1(node)
        let ann_ty = node_f2(node)
        prepare_expr_contextual(node_f3(inner), ann_ty, env, ft, src, tt)
        let next_env = if node_tag(inner) == 11 {
          tenv_bind_mut(env, src, node_f1(inner), node_f2(inner), ann_ty)
        } else { tenv_bind(env, src, node_f1(inner), node_f2(inner), ann_ty) }
        prepare_expr_contextual(node_f4(inner), target, next_env, ft, src, tt)
      }
      52 -> prepare_expr_contextual(node_f2(node), target, env, ft, src, tt)
      62 -> {
        if ty_is_slice(target) == 0 { 0 }
        else {
          let inferred = synth_indexed_slice(node, env, ft, src, tt)
          let fact = node_f4(node)
          if fact != 0 and ty_slice_mutable(target) == 1 { mem_store64_at(fact, 32, 1) } else { 0 }
          if type_is_unknown_or_any(inferred) == 1 { 0 } else { 1 }
        }
      }
      _ -> 0
    }
  }
}

pub(package) fn typeck_unique_identity_free_fields(fields: i64) -> i64 {
  if fields == 0 { 1 }
  else {
    let mut result = 1
    for i in 0..nlist_len(fields) {
      if typeck_unique_identity_free_type(ty_record_field_type(nlist_get(fields, i))) == 0 { result = 0 } else { 0 }
    }
    result
  }
}

-- A value can enter a unique context without an ownership origin only when
-- its entire representation is inline and carries no reference identity.
-- Named managed values, opaque handles, pointers, arrays/slices, functions,
-- and unresolved type variables deliberately remain outside this proof.
pub(package) fn typeck_unique_identity_free_type(ty: i64) -> i64 {
  if ty == 0 { 0 }
  else {
    match ty_tag(ty) {
      0 -> 1
      2 -> if ty_f1(ty) == PRIM_STR() { 0 } else { 1 }
      3 -> typeck_unique_identity_free_type(ty_f1(ty)) * typeck_unique_identity_free_type(ty_f2(ty))
      4 -> if typeck_unique_identity_free_type(ty_f1(ty)) == 1 or typeck_unique_identity_free_type(ty_f2(ty)) == 1 { 1 } else { 0 }
      7 -> if ty_record_open(ty) == 1 { 0 } else { typeck_unique_identity_free_fields(ty_record_fields(ty)) }
      9 -> if ty_named_is_payloadless_variant(ty) { 1 } else { 0 }
      18 -> typeck_unique_identity_free_type(ty_unique_inner(ty))
      _ -> 0
    }
  }
}

pub(package) fn typeck_unique_origin_call_entry(node: i64, src: i64, ft: i64) -> i64 {
  let call = if node_tag(node) == 36 { node_f2(node) } else { node }
  if call == 0 { 0 }
  else { if node_tag(call) == 4 {
    ftypes_find(ft, src, node_f1(call), node_f2(call))
  } else { if node_tag(call) == 32 and typeck_qualified_call_declaration(call) != 0 {
    ftypes_find_decl(ft, typeck_qualified_call_declaration(call))
  } else { 0 } } }
}

pub(package) fn typeck_unique_origin_call_is_constructor(node: i64, src: i64, ft: i64) -> i64 {
  let entry = typeck_unique_origin_call_entry(node, src, ft)
  if call_entry_is_constructor(entry) { 1 }
  else {
    let declaration = if entry == 0 { 0 } else { ftypes_entry_decl_fact(entry) }
    let tt = ftypes_context_ttable(ft)
    let type_entry = if declaration == 0 or tt == 0 { 0 } else { ttable_lookup_decl_fact(tt, declaration) }
    if type_entry != 0 and mem_load64_at(type_entry, 16) == 5 { 1 } else { 0 }
  }
}

-- Unique introduction is an expression-origin fact, independent of source
-- spelling. Direct constructors create an unpublished outer identity;
-- control-flow expressions prove the fact only when every result path does.
pub(package) fn typeck_expr_has_unique_origin(node: i64, node_ty: i64, src: i64, ft: i64) -> i64 {
  if ty_is_unique(node_ty) { 1 }
  else { if typeck_unique_identity_free_type(node_ty) == 1 { 1 }
  else { if node == 0 { 0 }
  else {
    match node_tag(node) {
      4 -> typeck_unique_origin_call_is_constructor(node, src, ft)
      36 -> typeck_unique_origin_call_is_constructor(node, src, ft)
      14 -> if record_init_is_structural(node) { 0 } else { 1 }
      5 -> typeck_expr_has_unique_origin(node_f2(node), node_ty, src, ft) * typeck_expr_has_unique_origin(node_f3(node), node_ty, src, ft)
      6 -> typeck_expr_has_unique_origin(node_f4(node), node_ty, src, ft)
      7 -> typeck_expr_has_unique_origin(node_f2(node), node_ty, src, ft)
      11 -> typeck_expr_has_unique_origin(node_f4(node), node_ty, src, ft)
      15 -> {
        let mut result = 1
        for i in 0..node_f3(node) {
          if typeck_expr_has_unique_origin(node_f2(nlist_get(node_f2(node), i)), node_ty, src, ft) == 0 { result = 0 } else { 0 }
        }
        result
      }
      37 -> typeck_expr_has_unique_origin(node_f4(node_f1(node)), node_ty, src, ft)
      52 -> typeck_expr_has_unique_origin(node_f2(node), node_ty, src, ft)
      58 -> 1
      _ -> 0
    }
  } } }
}

pub(package) fn expr_matches_type_contextual(node: i64, node_ty: i64, target_ty: i64, src: i64, ft: i64) -[Conformance]> i64 {
  if expr_is_contextual_int_lit_shape(node) == 1 and type_int_prim(target_ty) >= 0 {
    expr_contextual_int_lit_matches_type(node, target_ty, src)
  } else { if ty_is_unique(target_ty) == 1 {
    if typeck_expr_has_unique_origin(node, node_ty, src, ft) == 1 {
      expr_matches_type_contextual(node, node_ty, ty_unique_inner(target_ty), src, ft)
    } else { 0 }
  } else { if ty_is_owned(target_ty) == 1 {
    expr_matches_type_contextual(node, node_ty, ty_owned_inner(target_ty), src, ft)
  } else { if node_tag(node) == 58 and ty_is_array(target_ty) {
    expr_array_matches_type_contextual(node, node_ty, target_ty, src)
  } else { if is_subtype(node_ty, target_ty) { 1 }
  else { if expr_contextual_int_lit_matches_type(node, target_ty, src) == 1 { 1 }
  else { if type_is_f32_exact(target_ty) == 1 { expr_is_contextual_f32_literal_tree(node) }
  else { if type_is_bool_exact(target_ty) == 1 { expr_is_bool_int_literal(node, src) }
  else { 0 } } } } } } } }
}

-- Module constants are declaration facts evaluated before function bodies.
-- The evaluator intentionally accepts only operations whose compile-time
-- behavior is already proven identical to emitted scalar instructions.
pub(package) fn typeck_constant_evaluation_error(decl: i64, src: i64, start: i64, len: i64, reason: str) -[Diagnose]> i64 {
  let def_src = module_decl_fact_source(decl)
  let def_start = module_decl_fact_name_ptr(decl) - def_src
  let name = runtime_str_from_bytes_copy(module_decl_fact_name_ptr(decl), module_decl_fact_name_len(decl))
  Diagnose.report(Diagnostic(
    DiagnosticSeverityError,
    DiagnosticClassType,
    registry.constant_evaluation(),
    "module constant is not a compile-time value",
    DiagnosticSourceRange(DiagnosticSourceBuffer(src), start, start + if len > 0 { len } else { 1 }),
    DiagnosticRelatedLocationCons(
      DiagnosticRelatedLocation(
        "constant declared here",
        DiagnosticSourceRange(DiagnosticSourceBuffer(def_src), def_start, def_start + module_decl_fact_name_len(decl))
      ),
      DiagnosticRelatedLocationNil
    ),
    DiagnosticFieldCons(
      DiagnosticFieldText("reason", reason),
      DiagnosticFieldCons(
        DiagnosticFieldText("constant", name),
        DiagnosticFieldCons(
          DiagnosticFieldText("requirement", "immutable scalar or string expression evaluable without calls, effects, allocation, mutation, or control flow"),
          DiagnosticFieldNil
        )
      )
    )
  ))
}

pub(package) fn typeck_constant_decl_for_ident(tt: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let decl = module_scope_lookup_declaration(tt, src, module_decl_namespace_value(), src, ns, nl)
  if decl != 0 and module_decl_fact_constant_fact(decl) != 0 { decl } else { 0 }
}

pub(package) fn typeck_constant_decl_for_field(node: i64, env: i64, src: i64, tt: i64) -> i64 {
  let decl = typeck_resolve_module_member_access(node, env, src, tt)
  if decl != 0 and module_decl_fact_constant_fact(decl) != 0 { decl } else { 0 }
}

pub(package) fn typeck_constant_value_copy(value: i64, from_src: i64, to_src: i64) -> i64 {
  match node_tag(value) {
    1 -> node_new(1, node_f1(value), if node_f3(value) > 0 { from_src + node_f2(value) - to_src } else { 0 }, node_f3(value), node_f4(value))
    9 -> node_new(9, from_src + node_f1(value) - to_src, node_f2(value), 0, 0)
    24 -> node_new(24, node_f1(value), 0, 0, 0)
    51 -> node_new(51, 0, 0, 0, 0)
    54 -> node_new(54, from_src + node_f1(value) - to_src, node_f2(value), node_f3(value), 0)
    _ -> 0
  }
}

pub(package) fn typeck_constant_stamp_type(value: i64, ty: i64) -> i64 {
  if node_tag(value) == 1 { mem_store64_at(value, 32, ty) }
  else { if node_tag(value) == 54 { mem_store64_at(value, 24, ty) } else { 0 } }
  value
}

pub(package) fn typeck_constant_type_is_supported(ty: i64) -> i64 {
  if type_is_integer_exact(ty) == 1 or type_is_float_exact(ty) == 1 or type_is_bool_exact(ty) == 1 { 1 }
  else { if ty_eq(ty, ty_str()) or ty_eq(ty, ty_nil()) { 1 } else { 0 } }
}

pub(package) fn typeck_constant_write_node(target: i64, value: i64) -> i64 {
  mem_store64_at(target, 0, node_tag(value))
  mem_store64_at(target, 8, node_f1(value))
  mem_store64_at(target, 16, node_f2(value))
  mem_store64_at(target, 24, node_f3(value))
  mem_store64_at(target, 32, node_f4(value))
  target
}

pub(package) fn typeck_materialize_constant_use(node: i64, decl: i64, use_src: i64) -> i64 {
  let fact = module_decl_fact_constant_fact(decl)
  if fact == 0 or module_constant_fact_state(fact) != module_constant_state_resolved() { 0 }
  else {
    let value = typeck_constant_value_copy(module_constant_fact_value(fact), module_decl_fact_source(decl), use_src)
    if value == 0 { 0 } else { typeck_constant_write_node(node, value) 1 }
  }
}

pub(package) fn typeck_constant_eval_reference(decl: i64, owner_src: i64, ft: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let value = typeck_evaluate_constant_decl(decl, ft, tt)
  if value == 0 { 0 }
  else { typeck_constant_value_copy(value, module_decl_fact_source(decl), owner_src) }
}

pub(package) fn typeck_constant_eval_binary(node: i64, owner_decl: i64, owner_src: i64, ft: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let lhs = typeck_constant_eval_expr(node_f2(node), owner_decl, owner_src, ft, tt)
  let rhs = typeck_constant_eval_expr(node_f3(node), owner_decl, owner_src, ft, tt)
  if lhs == 0 or rhs == 0 { 0 }
  else {
    let op = node_f1(node)
    let lhs_i64 = node_tag(lhs) == 1 and type_int_prim(synth(lhs, tenv_new(), ft, owner_src, tt)) == PRIM_I64()
    let rhs_i64 = node_tag(rhs) == 1 and type_int_prim(synth(rhs, tenv_new(), ft, owner_src, tt)) == PRIM_I64()
    let lhs_bool = node_tag(lhs) == 24
    let rhs_bool = node_tag(rhs) == 24
    if (op == 1 or op == 2 or op == 3) and lhs_i64 and rhs_i64 {
      let result = if op == 1 { node_f1(lhs) + node_f1(rhs) }
        else { if op == 2 { node_f1(lhs) - node_f1(rhs) } else { node_f1(lhs) * node_f1(rhs) } }
      node_new(1, result, 0, 0, ty_i64())
    } else { if (op == 5 or op == 6 or op == 7 or op == 8 or op == 9 or op == 10) and lhs_i64 and rhs_i64 {
      let truth = if op == 5 { node_f1(lhs) == node_f1(rhs) }
        else { if op == 6 { node_f1(lhs) != node_f1(rhs) }
        else { if op == 7 { node_f1(lhs) < node_f1(rhs) }
        else { if op == 8 { node_f1(lhs) > node_f1(rhs) }
        else { if op == 9 { node_f1(lhs) <= node_f1(rhs) }
        else { node_f1(lhs) >= node_f1(rhs) } } } } }
      node_new(24, if truth { 6 } else { 7 }, 0, 0, 0)
    } else { if (op == 12 or op == 13) and lhs_bool and rhs_bool {
      let lhs_true = node_f1(lhs) == 6
      let rhs_true = node_f1(rhs) == 6
      let truth = if op == 12 { lhs_true and rhs_true } else { lhs_true or rhs_true }
      node_new(24, if truth { 6 } else { 7 }, 0, 0, 0)
    } else {
      typeck_constant_evaluation_error(owner_decl, owner_src, expr_diag_pos(node), expr_diag_len(node), if op == 4 or op == 11 { "operator_semantics_not_audited" } else { "operator_not_constant_evaluable" })
      0
    } } }
  }
}

pub(package) fn typeck_constant_eval_expr(node: i64, owner_decl: i64, owner_src: i64, ft: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  match node_tag(node) {
    1 -> typeck_constant_value_copy(node, owner_src, owner_src)
    9 -> typeck_constant_value_copy(node, owner_src, owner_src)
    24 -> typeck_constant_value_copy(node, owner_src, owner_src)
    51 -> typeck_constant_value_copy(node, owner_src, owner_src)
    54 -> typeck_constant_value_copy(node, owner_src, owner_src)
    2 -> {
      let decl = typeck_constant_decl_for_ident(tt, owner_src, node_f1(node), node_f2(node))
      if decl == 0 {
        typeck_constant_evaluation_error(owner_decl, owner_src, node_f1(node), node_f2(node), "name_is_not_a_module_constant")
        0
      } else { typeck_constant_eval_reference(decl, owner_src, ft, tt) }
    }
    13 -> {
      let decl = typeck_constant_decl_for_field(node, tenv_new(), owner_src, tt)
      if decl == 0 {
        typeck_constant_evaluation_error(owner_decl, owner_src, expr_diag_pos(node), expr_diag_len(node), "qualified_name_is_not_a_module_constant")
        0
      } else { typeck_constant_eval_reference(decl, owner_src, ft, tt) }
    }
    22 -> {
      let operand = typeck_constant_eval_expr(node_f1(node), owner_decl, owner_src, ft, tt)
      if operand != 0 and node_tag(operand) == 24 {
        node_new(24, if node_f1(operand) == 6 { 7 } else { 6 }, 0, 0, 0)
      } else {
        if operand != 0 { typeck_constant_evaluation_error(owner_decl, owner_src, expr_diag_pos(node), expr_diag_len(node), "not_operand_is_not_bool") } else { 0 }
        0
      }
    }
    3 -> typeck_constant_eval_binary(node, owner_decl, owner_src, ft, tt)
    _ -> {
      typeck_constant_evaluation_error(owner_decl, owner_src, expr_diag_pos(node), expr_diag_len(node), "expression_requires_runtime_evaluation")
      0
    }
  }
}

pub(package) fn typeck_evaluate_constant_decl(decl: i64, ft: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let fact = module_decl_fact_constant_fact(decl)
  if fact == 0 { 0 }
  else { if module_constant_fact_state(fact) == module_constant_state_resolved() { module_constant_fact_value(fact) }
  else { if module_constant_fact_state(fact) == module_constant_state_failed() { 0 }
  else { if module_constant_fact_state(fact) == module_constant_state_resolving() {
    let src = module_decl_fact_source(decl)
    let start = module_decl_fact_name_ptr(decl) - src
    typeck_constant_evaluation_error(decl, src, start, module_decl_fact_name_len(decl), "constant_reference_cycle")
    module_constant_fact_set_state(fact, module_constant_state_failed())
    0
  } else {
    module_constant_fact_set_state(fact, module_constant_state_resolving())
    let src = module_decl_fact_source(decl)
    let declared_ty = module_constant_fact_declared_type(fact)
    if typeck_constant_type_is_supported(declared_ty) == 0 {
      typeck_constant_evaluation_error(decl, src, module_decl_fact_name_ptr(decl) - src, module_decl_fact_name_len(decl), "constant_type_requires_runtime_representation")
      module_constant_fact_set_state(fact, module_constant_state_failed())
      0
    } else {
      let value = typeck_constant_eval_expr(module_constant_fact_initializer(fact), decl, src, ft, tt)
      if value == 0 {
        module_constant_fact_set_state(fact, module_constant_state_failed())
        0
      } else {
        let found_ty = synth(value, tenv_new(), ft, src, tt)
        if expr_matches_type_contextual(value, found_ty, declared_ty, src, ft) != 1 {
          typeck_report_expr_type_mismatch(
            src,
            module_constant_fact_initializer(fact),
            declared_ty,
            found_ty,
            "constant initializer",
            typeck_source_location(src, module_decl_fact_name_ptr(decl) - src, module_decl_fact_name_len(decl)),
            tt
          )
          module_constant_fact_set_state(fact, module_constant_state_failed())
          0
        } else {
          typeck_constant_stamp_type(value, declared_ty)
          module_constant_fact_set_value(fact, value)
          module_constant_fact_set_state(fact, module_constant_state_resolved())
          value
        }
      }
    }
  } } } }
}

pub(package) fn typeck_resolve_constants(tt: i64, ft: i64) -[Conformance, Diagnose]> i64 {
  let mut errors = 0
  -- Resolve every declared type before evaluating any initializer so forward
  -- references observe the same graph-wide type facts as backward ones.
  for i in 0..module_fact_decl_count(tt) {
    let decl = module_fact_decl_at(tt, i)
    let fact = module_decl_fact_constant_fact(decl)
    if fact != 0 and module_constant_fact_state(fact) == module_constant_state_unvisited() {
      errors = errors + typeck_resolve_qualified_effects_in_ty(module_constant_fact_declared_type(fact), module_decl_fact_source(decl), tt)
    } else { 0 }
  }
  for i in 0..module_fact_decl_count(tt) {
    let decl = module_fact_decl_at(tt, i)
    let fact = module_decl_fact_constant_fact(decl)
    if fact != 0 and module_constant_fact_state(fact) == module_constant_state_unvisited() {
      if typeck_evaluate_constant_decl(decl, ft, tt) == 0 { errors = errors + 1 }
      else {
        let src = module_decl_fact_source(decl)
        let start = module_decl_fact_name_ptr(decl) - src
        ttable_add_semantic_symbol_fact(
          tt, src, start, module_decl_fact_name_len(decl),
          src, start, module_decl_fact_name_len(decl),
          module_constant_fact_declared_type(fact), 0, semantic_symbol_kind_constant(), tenv_new(), decl
        )
      }
    } else { 0 }
  }
  errors
}

-- ══════════════════════════════════════════════════════════════
-- Type synthesis: infer the type of an expression
-- ══════════════════════════════════════════════════════════════
-- Returns a type pointer (ty_i64(), ty_str(), etc.) or 0 for unknown

-- ══════════════════════════════════════════════════════════════
-- Guard narrowing: `x != nil` and `x == nil` guards refine the
-- guarded ident's type in positions the short-circuit contract
-- (kernel.md §5.3.1) proves conditionally executed:
--   if x != nil { <x: T> } else { ... }
--   if x == nil { ... } else { <x: T> }
--   x != nil and <x: T>
--   x == nil or <x: T>
-- Only the NON-nil direction is bound (T <: T | nil, so narrowing can
-- only accept more programs, never reject working code), and only for
-- immutable bindings (assignment would invalidate the refinement).
-- ══════════════════════════════════════════════════════════════

-- The guarded ident node when cond is `x <op> nil` / `nil <op> x` with
-- the wanted comparison op (5 = ==, 6 = !=); 0 otherwise.
pub(package) fn guard_nil_ident(cond: i64, want_op: i64) -> i64 {
  if node_tag(cond) != 3 { 0 }
  else { if node_f1(cond) != want_op { 0 }
  else {
    let lhs = node_f2(cond)
    let rhs = node_f3(cond)
    if node_tag(lhs) == 51 and node_tag(rhs) == 2 { rhs }
    else { if node_tag(rhs) == 51 and node_tag(lhs) == 2 { lhs } else { 0 } }
  } }
}

-- Env for the branch where the guard proves the ident non-nil: shadow
-- the binding with its nil-free type. Unchanged env when the guard
-- shape does not apply, the binding is mutable, or nil-free narrowing
-- would not change the type.
pub(package) fn tenv_narrow_guard(env: i64, cond: i64, want_op: i64, src: i64) -> i64 {
  let ident = guard_nil_ident(cond, want_op)
  if ident == 0 { env }
  else {
    let ns = node_f1(ident)
    let nl = node_f2(ident)
    if tenv_lookup_mutable(env, src, ns, nl) == 1 { env }
    else {
      let entry = tenv_find_entry(env, src, ns, nl)
      let ty = if entry == 0 { 0 } else { tenv_entry_type(entry) }
      if entry == 0 or ty == 0 { env }
      else {
        let narrowed = ty_narrow_drop_nil(ty)
        if narrowed == 0 { env } else { tenv_refine_type(env, entry, narrowed) }
      }
    }
  }
}

pub(package) fn synth(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let tag = node_tag(node)
  match tag {
    -- IntLit → i64
    1 -> if node_f4(node) != 0 { node_f4(node) } else { ty_i64() }
    -- Ident → lookup in environment or function table
    2 -> synth_ident(node, env, ft, src, tt)
    -- BinOp → depends on operator
    3 -> synth_binop(node, env, ft, src, tt)
    -- Call → return type of function
    4 -> synth_call(node, env, ft, src, tt)
    -- If/else → unify branches
    5 -> synth_if(node, env, ft, src, tt)
    -- Let → type of body
    6 -> synth_let(node, env, ft, src, tt)
    -- Block → type of last expression
    7 -> synth_block(node, env, ft, src, tt)
    -- StringLit → str
    9 -> ty_str()
    -- While → nil (loops don't produce values)
    10 -> ty_nil()
    -- LetMut → type of body
    11 -> synth_let_mut(node, env, ft, src, tt)
    -- Assign → nil
    12 -> ty_nil()
    -- FieldAccess → i64 (and annotate record offset when type is known)
    13 -> synth_field_access(node, env, ft, src, tt)
    -- Checker-resolved array/slice `.len` fact.
    59 -> ty_usize()
    -- Checker-resolved indexed-storage access fact.
    60 -> synth_indexed_get(node, env, ft, src, tt)
    -- Indexed mutation is statement-valued.
    61 -> ty_nil()
    -- Checker-resolved half-open slice construction.
    62 -> synth_indexed_slice(node, env, ft, src, tt)
    -- RecordInit is either a nominal constructor or a checker-resolved closed
    -- structural record/tuple value.
    14 -> if record_init_is_structural(node) {
      synth_structural_record_init(node, env, ft, src, tt)
    } else { ty_named(effect_name_hash(src, node_f1(node), node_f2(node)), ty_i64()) }
    -- Functional record update carries its complete checker-produced shape.
    63 -> synth_record_update(node, env, ft, src, tt)
    -- Named module handler installation preserves normal completion type.
    64 -> synth(node_f2(node), env, ft, src, tt)
    -- Match → type of first arm body (simplified)
    15 -> synth_match(node, env, ft, src, tt)
    -- Not → bool
    22 -> ty_bool()
    -- Return exits the current function/handler helper and produces no local value.
    25 -> ty_never()
    -- BoolLit → bool
    24 -> ty_bool()
    -- FloatLit → f64
    54 -> if node_f3(node) != 0 { node_f3(node) } else { ty_f64() }
    -- AddressOf → *T / *mut T
    55 -> synth_address_of(node, env, ft, src, tt)
    -- Deref → pointee type
    56 -> synth_deref(node, env, ft, src, tt)
    -- PtrAssign → nil
    57 -> ty_nil()
    -- Perform/dot-call → synthesize method resolution
    32 -> synth_dot_call(node, env, ft, src, tt)
    -- Already-resolved method call → recover the resolved method return type
    41 -> synth_resolved_method_call(node, tt)
    -- Handle → type of body (handler discharges an effect, doesn't change type)
    33 -> {
      -- Handle discharges an effect; without a return clause the type is
      -- the body's. With one (parameterized effects, §7.3), the result is the clause body's
      -- type, its binder bound to the body's type.
      let body_ty = synth(node_f1(node), env, ft, src, tt)
      let ret_clause = node_f4(node)
      if ret_clause == 0 { body_ty }
      else {
        let renv = tenv_bind(env, src, node_f1(ret_clause), node_f2(ret_clause), body_ty)
        synth(node_f3(ret_clause), renv, ft, src, tt)
      }
    }
    -- Resume → value sent back to the suspended perform site
    35 -> synth(node_f1(node), env, ft, src, tt)
    -- GenericCall → substitute type args into return type
    36 -> synth_generic_call(node, env, ft, src, tt)
    -- LetTyped → check annotation matches value type
    37 -> synth_let_typed(node, env, ft, src, tt)
    -- Lambda → synthesize a first-order function value type
    29 -> synth_lambda(node, env, ft, src, tt)
    -- Try → payload type of the Result-like named value
    45 -> synth_try(node, env, ft, src, tt)
    -- String interpolation concat → str
    46 -> ty_str()
    -- For-iterator → nil
    47 -> ty_nil()
    -- Optional chain → field payload, currently i64-shaped
    48 -> ty_i64()
    -- Loop → union of break payloads
    49 -> synth_loop(node, env, ft, src, tt)
    -- Synthetic nil expression used by omitted else branches
    51 -> ty_nil()
    -- Defer preserves the body's type; cleanup is effect/type checked separately.
    52 -> synth(node_f2(node), env, ft, src, tt)
    -- ArrayLiteral → fixed array carrying the union of element types. The
    -- resolved fact may later be narrowed by an expected array type.
    58 -> synth_array_literal(node, env, ft, src, tt)
    -- Unknown
    _ -> ty_any()
  }
}

pub(package) fn synth_array_literal(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  if node_f3(node) != 0 { node_f3(node) }
  else {
    let elements = node_f1(node)
    let count = node_f2(node)
    let mut inner = ty_never()
    for i in 0..count {
      let elem_ty = synth(nlist_get(elements, i), env, ft, src, tt)
      if i == 0 { inner = elem_ty }
      else { if ty_eq(inner, elem_ty) { 0 } else { inner = ty_union(inner, elem_ty) } }
    }
    let result = ty_array(inner, count)
    mem_store64_at(node, 24, result)
    result
  }
}

pub(package) fn synth_try(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let inner_ty = synth(node_f1(node), env, ft, src, tt)
  if ty_tag(inner_ty) == 9 {
    let args = ty_f3(inner_ty)
    if args != 0 {
      if nlist_len(args) > 0 { nlist_get(args, 0) } else { ty_i64() }
    } else { ty_i64() }
  } else { ty_i64() }
}

pub(package) fn synth_loop_break_union(a: i64, b: i64) -> i64 {
  if a == 0 { b }
  else { if b == 0 { a }
  else { if ty_eq(a, b) { a } else { ty_union(a, b) } } }
}

pub(package) fn synth_loop_break_type(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  if node == 0 { 0 }
  else {
    let tag = node_tag(node)
    match tag {
      26 -> {
        let value = node_f1(node)
        if value == 0 { ty_nil() } else { synth(value, env, ft, src, tt) }
      }
      5 -> synth_loop_break_union(
        synth_loop_break_type(node_f2(node), env, ft, src, tt),
        synth_loop_break_type(node_f3(node), env, ft, src, tt)
      )
      7 -> synth_loop_break_union(
        synth_loop_break_type(node_f1(node), env, ft, src, tt),
        synth_loop_break_type(node_f2(node), env, ft, src, tt)
      )
      6 -> {
        let val_ty = synth(node_f3(node), env, ft, src, tt)
        let next_env = tenv_bind(env, src, node_f1(node), node_f2(node), val_ty)
        synth_loop_break_type(node_f4(node), next_env, ft, src, tt)
      }
      11 -> {
        let val_ty = synth(node_f3(node), env, ft, src, tt)
        let next_env = tenv_bind_mut(env, src, node_f1(node), node_f2(node), val_ty)
        synth_loop_break_type(node_f4(node), next_env, ft, src, tt)
      }
      37 -> synth_loop_break_type(node_f1(node), env, ft, src, tt)
      52 -> synth_loop_break_union(
        synth_loop_break_type(node_f1(node), env, ft, src, tt),
        synth_loop_break_type(node_f2(node), env, ft, src, tt)
      )
      _ -> 0
    }
  }
}

pub(package) fn synth_loop(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let break_ty = synth_loop_break_type(node_f1(node), env, ft, src, tt)
  if break_ty == 0 { ty_never() } else { break_ty }
}

pub(package) fn synth_explicit_return_type_list(items: i64, count: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let mut result = 0
  for i in 0..count {
    result = synth_loop_break_union(result, synth_explicit_return_type(nlist_get(items, i), env, ft, src, tt))
  }
  result
}

-- A body consisting only of explicit `return` expressions synthesizes as
-- `never`, but the returned values still determine a lambda's function type.
-- Collect those values without entering nested lambdas; the normal contextual
-- checker validates every return against the resulting type afterwards.
pub(package) fn synth_explicit_return_type(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  if node == 0 { 0 }
  else {
    let tag = node_tag(node)
    match tag {
      25 -> if node_f1(node) == 0 { ty_nil() } else { synth(node_f1(node), env, ft, src, tt) }
      3 -> synth_loop_break_union(synth_explicit_return_type(node_f2(node), env, ft, src, tt), synth_explicit_return_type(node_f3(node), env, ft, src, tt))
      4 -> synth_explicit_return_type_list(node_f3(node), node_f4(node), env, ft, src, tt)
      5 -> synth_loop_break_union(
        synth_explicit_return_type(node_f1(node), env, ft, src, tt),
        synth_loop_break_union(synth_explicit_return_type(node_f2(node), env, ft, src, tt), synth_explicit_return_type(node_f3(node), env, ft, src, tt))
      )
      6 -> {
        let value = node_f3(node)
        let value_ty = synth(value, env, ft, src, tt)
        let next_env = tenv_bind(env, src, node_f1(node), node_f2(node), value_ty)
        synth_loop_break_union(synth_explicit_return_type(value, env, ft, src, tt), synth_explicit_return_type(node_f4(node), next_env, ft, src, tt))
      }
      7 -> synth_loop_break_union(synth_explicit_return_type(node_f1(node), env, ft, src, tt), synth_explicit_return_type(node_f2(node), env, ft, src, tt))
      10 -> synth_loop_break_union(synth_explicit_return_type(node_f1(node), env, ft, src, tt), synth_explicit_return_type(node_f2(node), env, ft, src, tt))
      11 -> {
        let value = node_f3(node)
        let value_ty = synth(value, env, ft, src, tt)
        let next_env = tenv_bind_mut(env, src, node_f1(node), node_f2(node), value_ty)
        synth_loop_break_union(synth_explicit_return_type(value, env, ft, src, tt), synth_explicit_return_type(node_f4(node), next_env, ft, src, tt))
      }
      12 -> synth_explicit_return_type(node_f3(node), env, ft, src, tt)
      13 -> synth_explicit_return_type(node_f1(node), env, ft, src, tt)
      14 -> {
        let fields = node_f3(node)
        let mut result = 0
        for i in 0..node_f4(node) {
          result = synth_loop_break_union(result, synth_explicit_return_type(node_f3(nlist_get(fields, i)), env, ft, src, tt))
        }
        result
      }
      15 -> {
        let scrutinee = node_f1(node)
        let scrutinee_ty = synth(scrutinee, env, ft, src, tt)
        let arms = node_f2(node)
        let mut result = synth_explicit_return_type(scrutinee, env, ft, src, tt)
        for i in 0..node_f3(node) {
          let arm = nlist_get(arms, i)
          let arm_env = bind_match_pattern(node_f1(arm), env, src, scrutinee_ty, tt)
          result = synth_loop_break_union(result, synth_explicit_return_type(node_f3(arm), arm_env, ft, src, tt))
          result = synth_loop_break_union(result, synth_explicit_return_type(node_f2(arm), arm_env, ft, src, tt))
        }
        result
      }
      22 -> synth_explicit_return_type(node_f1(node), env, ft, src, tt)
      26 -> synth_explicit_return_type(node_f1(node), env, ft, src, tt)
      29 -> 0
      32 -> synth_loop_break_union(
        synth_explicit_return_type(node_f1(node), env, ft, src, tt),
        synth_explicit_return_type_list(node_f4(node), nlist_len(node_f4(node)), env, ft, src, tt)
      )
      33 -> synth_explicit_return_type(node_f1(node), env, ft, src, tt)
      35 -> synth_explicit_return_type(node_f1(node), env, ft, src, tt)
      36 -> {
        let call = node_f2(node)
        synth_explicit_return_type_list(generic_call_inner_args(call), generic_call_inner_arg_count(call), env, ft, src, tt)
      }
      37 -> synth_explicit_return_type(node_f1(node), env, ft, src, tt)
      41 -> synth_loop_break_union(
        synth_explicit_return_type(node_f1(node), env, ft, src, tt),
        synth_explicit_return_type_list(node_f3(node), nlist_len(node_f3(node)), env, ft, src, tt)
      )
      45 -> synth_explicit_return_type(node_f1(node), env, ft, src, tt)
      46 -> synth_loop_break_union(synth_explicit_return_type(node_f1(node), env, ft, src, tt), synth_explicit_return_type(node_f2(node), env, ft, src, tt))
      47 -> {
        let collection = node_f3(node)
        let loop_env = tenv_bind(env, src, node_f1(node), node_f2(node), for_iter_item_type(node, env, ft, src, tt))
        synth_loop_break_union(synth_explicit_return_type(collection, env, ft, src, tt), synth_explicit_return_type(node_f4(node), loop_env, ft, src, tt))
      }
      48 -> synth_explicit_return_type(node_f1(node), env, ft, src, tt)
      49 -> synth_explicit_return_type(node_f1(node), env, ft, src, tt)
      52 -> synth_loop_break_union(synth_explicit_return_type(node_f1(node), env, ft, src, tt), synth_explicit_return_type(node_f2(node), env, ft, src, tt))
      57 -> synth_loop_break_union(synth_explicit_return_type(node_f1(node), env, ft, src, tt), synth_explicit_return_type(node_f2(node), env, ft, src, tt))
      58 -> synth_explicit_return_type_list(node_f1(node), node_f2(node), env, ft, src, tt)
      59 -> synth_explicit_return_type(node_f1(node), env, ft, src, tt)
      60 -> synth_loop_break_union(synth_explicit_return_type(node_f1(node), env, ft, src, tt), synth_explicit_return_type(node_f2(node), env, ft, src, tt))
      61 -> synth_loop_break_union(
        synth_explicit_return_type(node_f1(node), env, ft, src, tt),
        synth_loop_break_union(synth_explicit_return_type(node_f2(node), env, ft, src, tt), synth_explicit_return_type(node_f3(node), env, ft, src, tt))
      )
      62 -> synth_loop_break_union(
        synth_explicit_return_type(node_f1(node), env, ft, src, tt),
        synth_loop_break_union(synth_explicit_return_type(node_f2(node), env, ft, src, tt), synth_explicit_return_type(node_f3(node), env, ft, src, tt))
      )
      63 -> synth_loop_break_union(
        synth_explicit_return_type(node_f1(node), env, ft, src, tt),
        synth_explicit_return_type_list(record_field_expr_nodes(node_f2(node), node_f3(node)), node_f3(node), env, ft, src, tt)
      )
      64 -> synth_explicit_return_type(node_f2(node), env, ft, src, tt)
      _ -> 0
    }
  }
}

pub(package) fn synth_lambda_body_type(body: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let body_ty = synth(body, env, ft, src, tt)
  if ty_eq(body_ty, ty_never()) {
    let returned_ty = synth_explicit_return_type(body, env, ft, src, tt)
    if returned_ty == 0 { body_ty } else { returned_ty }
  } else { body_ty }
}

pub(package) fn lambda_param_ty(param: i64) -> i64 {
  let ann_ty = node_f3(param)
  if ann_ty != 0 { ann_ty } else { ty_i64() }
}

pub(package) fn synth_lambda(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let params = node_f1(node)
  let body = node_f2(node)
  let nparams = node_f3(node)
  let param_tys = nlist_new()
  let mut lambda_env = env
  for i in 0..nparams {
    let p = nlist_get(params, i)
    let param_ty = lambda_param_ty(p)
    nlist_add(param_tys, param_ty)
    lambda_env = tenv_bind(lambda_env, src, node_f1(p), node_f2(p), param_ty)
  }
  ty_fn(param_tys, synth_lambda_body_type(body, lambda_env, ft, src, tt), infer_expr_effects(body, lambda_env, ft, src, tt))
}

pub(package) fn synth_ident(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let ns = node_f1(node)
  let nl = node_f2(node)
  let ty = tenv_lookup(env, src, ns, nl)
  if ty == 0 {
    let constant_decl = typeck_constant_decl_for_ident(tt, src, ns, nl)
    if constant_decl != 0 {
      module_constant_fact_declared_type(module_decl_fact_constant_fact(constant_decl))
    } else { if ttable_variant_payload_count(tt, src, ns, nl) == 0 {
      let variant_ty = ftypes_lookup(ft, src, ns, nl)
      if variant_ty == 0 { ty_any() } else { variant_ty }
    } else {
      let fn_ty = ftypes_lookup_fn_type(ft, src, ns, nl)
      if fn_ty == 0 { ty_any() } else { fn_ty }
    } }
  } else { ty }
}

-- A declaration-access fact is stored in FieldAccess.f4 as raw tag 2.  It is
-- distinct from an Ident because the slot is fact-typed, and survives the
-- raw/typed IR bridge as ResolvedDeclarationAccessFact.
pub(package) fn typeck_declaration_access_fact(decl: i64) -> i64 { node_new(2, decl, 0, 0, 0) }

pub(package) fn typeck_field_access_declaration(node: i64) -> i64 {
  if node == 0 or node_tag(node) != 13 { 0 }
  else {
    let fact = node_f4(node)
    if fact != 0 and node_tag(fact) == 2 { node_f1(fact) } else { 0 }
  }
}

pub(package) fn typeck_resolve_effect_ref(effect_ref: i64, env: i64, src: i64, tt: i64) -> i64 {
  let existing = effect_ref_decl_fact(effect_ref)
  if existing != 0 { existing }
  else {
    let field = effect_ref_field_node(effect_ref)
    if field == 0 { 0 }
    else {
      let base = node_f1(field)
      if node_tag(base) != 2 or tenv_lookup(env, src, node_f1(base), node_f2(base)) != 0 { 0 }
      else {
        let decl = module_scope_lookup_qualified_declaration(tt, src, src, node_f1(base), node_f2(base), module_decl_namespace_effect(), src, node_f2(field), node_f3(field))
        if decl != 0 {
          let fact = node_f4(field)
          if fact != 0 and node_tag(fact) == 3 { mem_store64_at(fact, 8, decl) }
          else { mem_store64_at(field, 32, typeck_declaration_access_fact(decl)) }
        } else { 0 }
        decl
      }
    }
  }
}

pub(package) fn typeck_effect_ref_entry(effect_ref: i64, src: i64, tt: i64) -> i64 {
  let decl = effect_ref_decl_fact(effect_ref)
  if decl != 0 { ttable_lookup_decl_fact(tt, decl) }
  else {
    let ident = effect_ref_ident_node(effect_ref)
    if ident == 0 { 0 }
    else { ttable_lookup_resolved_decl(tt, src, module_decl_namespace_effect(), src, node_f1(ident), node_f2(ident)) }
  }
}

pub(package) fn typeck_effect_ref_name_start(effect_ref: i64) -> i64 {
  let field = effect_ref_field_node(effect_ref)
  if field != 0 { node_f2(field) }
  else {
    let ident = effect_ref_ident_node(effect_ref)
    if ident == 0 { 0 } else { node_f1(ident) }
  }
}

pub(package) fn typeck_effect_ref_name_len(effect_ref: i64) -> i64 {
  let field = effect_ref_field_node(effect_ref)
  if field != 0 { node_f3(field) }
  else {
    let ident = effect_ref_ident_node(effect_ref)
    if ident == 0 { 0 } else { node_f2(ident) }
  }
}

pub(package) fn typeck_effect_ref_name_hash(effect_ref: i64, src: i64) -> i64 {
  let field = effect_ref_field_node(effect_ref)
  if field != 0 { effect_name_hash(src, node_f2(field), node_f3(field)) }
  else { effect_ref_name_hash(effect_ref, src) }
}

pub(package) fn typeck_effect_ref_is_parameterized(effect_ref: i64) -> i64 {
  let field = effect_ref_field_node(effect_ref)
  let fact = if field == 0 { 0 } else { node_f4(field) }
  if fact != 0 and node_tag(fact) == 3 and node_f2(fact) != 0 { 1 }
  else { effect_ref_is_qualified(effect_ref) }
}

pub(package) fn typeck_effect_ref_type_args(effect_ref: i64) -> i64 {
  let field = effect_ref_field_node(effect_ref)
  let fact = if field == 0 { 0 } else { node_f4(field) }
  if fact != 0 and node_tag(fact) == 3 { node_f2(fact) } else { effect_ref_type_args(effect_ref) }
}

pub(package) fn typeck_effect_ref_atom(effect_ref: i64, src: i64) -> i64 {
  let hash = typeck_effect_ref_name_hash(effect_ref, src)
  let args = typeck_effect_ref_type_args(effect_ref)
  let decl = effect_ref_decl_fact(effect_ref)
  if decl != 0 { ty_qualified_effect_app(decl, args) }
  else { if hash == 0 { 0 } else { if args == 0 { ty_effect_app(hash) } else { ty_effect_app_args(hash, args) } } }
}

pub(package) fn typeck_is_effect_ref(effect_ref: i64, src: i64, tt: i64) -> bool {
  let decl = effect_ref_decl_fact(effect_ref)
  if decl != 0 { module_decl_fact_namespace(decl) == module_decl_namespace_effect() }
  else { is_effect_ident(effect_ref, src, tt) }
}

pub(package) fn typeck_resolve_module_member_access(node: i64, env: i64, src: i64, tt: i64) -> i64 {
  let resolved = typeck_field_access_declaration(node)
  if resolved != 0 { resolved }
  else {
    let base = node_f1(node)
    if node_tag(base) != 2 or tenv_lookup(env, src, node_f1(base), node_f2(base)) != 0 { 0 }
    else {
      let value_decl = module_scope_lookup_qualified_declaration(
        tt,
        src,
        src,
        node_f1(base),
        node_f2(base),
        module_decl_namespace_value(),
        src,
        node_f2(node),
        node_f3(node)
      )
      let decl = if value_decl != 0 { value_decl }
        else { module_scope_lookup_qualified_declaration(tt, src, src, node_f1(base), node_f2(base), module_decl_namespace_constructor(), src, node_f2(node), node_f3(node)) }
      if decl != 0 {
        mem_store64_at(node, 32, typeck_declaration_access_fact(decl))
      } else { 0 }
      decl
    }
  }
}

pub(package) fn typeck_qualified_call_declaration(node: i64) -> i64 {
  if node == 0 or node_tag(node) != 32 { 0 }
  else {
    let decl = typeck_field_access_declaration(node_f1(node))
    if decl != 0 and (module_decl_fact_namespace(decl) == module_decl_namespace_value() or module_decl_fact_namespace(decl) == module_decl_namespace_constructor()) { decl } else { 0 }
  }
}

pub(package) fn typeck_resolve_qualified_call(node: i64, env: i64, src: i64, tt: i64) -> i64 {
  let resolved = typeck_qualified_call_declaration(node)
  if resolved != 0 { resolved }
  else {
    let base = node_f1(node)
    if node_tag(base) != 2 or tenv_lookup(env, src, node_f1(base), node_f2(base)) != 0 { 0 }
    else {
      let access = node_new(13, base, node_f2(node), node_f3(node), 0)
      let decl = typeck_resolve_module_member_access(access, env, src, tt)
      if decl != 0 { mem_store64_at(node, 8, access) } else { 0 }
      decl
    }
  }
}

pub(package) fn typeck_qualified_member_entry(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let decl = if node_tag(node) == 13 and field_access_is_tuple_position(node_f3(node)) == 0 { typeck_resolve_module_member_access(node, env, src, tt) }
    else { if node_tag(node) == 32 { typeck_resolve_qualified_call(node, env, src, tt) } else { 0 } }
  ftypes_find_decl(ft, decl)
}

pub(package) fn typeck_field_name_is_len(src: i64, field_ns: i64, field_nl: i64) -> i64 {
  src_eq(src, field_ns, field_nl, "len")
}

-- Vector is the one nominal indexed owner admitted by array/slice semantics. Resolve it through
-- the type table instead of trusting a user-source spelling at each consumer.
pub(package) fn typeck_type_is_named(tt: i64, ty: i64, name: str) -> i64 {
  if ty == 0 or ty_tag(ty) != 9 { 0 }
  else {
    let entry = ttable_lookup(tt, __str_ptr(name), 0, __str_len(name))
    if entry == 0 { 0 } else { if mem_load64_at(entry, 56) == ty_f1(ty) { 1 } else { 0 } }
  }
}

pub(package) fn typeck_type_is_vector(tt: i64, ty: i64) -> i64 {
  let value_ty = if ty_is_borrow(ty) { ty_borrow_inner(ty) }
    else { if ty_is_owned(ty) { ty_owned_inner(ty) }
    else { if ty_is_unique(ty) { ty_unique_inner(ty) } else { ty } } }
  typeck_type_is_named(tt, value_ty, "Vector")
}

pub(package) fn typeck_vector_element_type(ty: i64) -> i64 {
  let value_ty = if ty_is_borrow(ty) { ty_borrow_inner(ty) }
    else { if ty_is_owned(ty) { ty_owned_inner(ty) }
    else { if ty_is_unique(ty) { ty_unique_inner(ty) } else { ty } } }
  let args = if value_ty == 0 { 0 } else { ty_f3(value_ty) }
  if args == 0 or nlist_len(args) != 1 { ty_any() } else { nlist_get(args, 0) }
}

-- Rewrite field-shaped surface syntax to an explicit typed semantic fact.
-- Native lowering therefore consumes either the fixed array length or the
-- slice's secondary ABI lane without rediscovering the source spelling.
pub(package) fn typeck_resolve_indexed_len(node: i64, base_ty: i64, src: i64, field_ns: i64, field_nl: i64) -> i64 {
  if (ty_is_array(base_ty) or ty_is_slice(base_ty)) and typeck_field_name_is_len(src, field_ns, field_nl) == 1 {
    let fixed_len = if ty_is_array(base_ty) { ty_array_length(base_ty) } else { 0 - 1 }
    mem_store64_at(node, 0, 59)
    mem_store64_at(node, 16, fixed_len)
    mem_store64_at(node, 24, field_ns)
    mem_store64_at(node, 32, field_nl)
    1
  } else { 0 }
}

pub(package) fn record_init_is_structural(node: i64) -> bool {
  node_f1(node) == 0 and node_f2(node) <= 0
}

pub(package) fn record_init_is_tuple(node: i64) -> bool {
  record_init_is_structural(node) and node_f2(node) < 0
}

pub(package) fn record_value_field_hash(field: i64, src: i64) -> i64 {
  if node_f2(field) < 0 { node_f1(field) }
  else { effect_name_hash(src, node_f1(field), node_f2(field)) }
}

pub(package) fn record_value_field_fact_type(field: i64) -> i64 {
  let fact = node_f4(field)
  if fact == 0 { 0 } else { node_f1(fact) }
}

pub(package) fn synth_structural_record_init(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let fields = node_f3(node)
  let count = node_f4(node)
  if record_init_is_tuple(node) {
    let types = nlist_new()
    for i in 0..count {
      let field = nlist_get(fields, i)
      let resolved = record_value_field_fact_type(field)
      nlist_add(types, if resolved != 0 { resolved } else { synth(node_f3(field), env, ft, src, tt) })
    }
    ty_tuple(types)
  } else {
    let typed_fields = nlist_new()
    for i in 0..count {
      let field = nlist_get(fields, i)
      let resolved = record_value_field_fact_type(field)
      let field_ty = if resolved != 0 { resolved } else { synth(node_f3(field), env, ft, src, tt) }
      nlist_add(typed_fields, ty_record_field(record_value_field_hash(field, src), field_ty, node_f1(field), node_f2(field)))
    }
    ty_record(typed_fields, 0)
  }
}

pub(package) fn record_init_write_structural_facts(node: i64, record_ty: i64, src: i64) -> i64 {
  let fields = node_f3(node)
  for i in 0..node_f4(node) {
    let field = nlist_get(fields, i)
    let field_hash = record_value_field_hash(field, src)
    let type_field = ty_record_field_by_hash(ty_record_fields(record_ty), field_hash)
    let field_ty = if type_field == 0 { ty_any() } else { ty_record_field_type(type_field) }
    let word_offset = ty_record_field_word_offset(record_ty, field_hash)
    mem_store64_at(field, 32, node_new(1, field_ty, field_hash, word_offset, 0))
  }
  0
}

pub(package) fn record_update_field_by_hash(fields: i64, count: i64, field_hash: i64, src: i64) -> i64 {
  let mut result = 0
  let mut i = 0
  while i < count and result == 0 {
    let field = nlist_get(fields, i)
    if record_value_field_hash(field, src) == field_hash { result = field } else { i = i + 1 }
  }
  result
}

pub(package) fn record_update_base_has_hash(base_ty: i64, field_hash: i64) -> i64 {
  if ty_record_field_by_hash(ty_record_fields(base_ty), field_hash) == 0 { 0 } else { 1 }
}

pub(package) fn synth_record_update(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let fact = node_f4(node)
  if fact != 0 { node_f1(fact) }
  else {
    let base_ty = synth(node_f1(node), env, ft, src, tt)
    if not ty_is_record(base_ty) or ty_record_open(base_ty) == 1 { ty_any() }
    else {
      let updates = node_f2(node)
      let update_count = node_f3(node)
      let result_fields = nlist_new()
      let base_fields = ty_record_fields(base_ty)
      let base_count = if base_fields == 0 { 0 } else { nlist_len(base_fields) }
      for i in 0..base_count {
        let base_field = ty_record_field_at_layout_index(base_ty, i)
        let field_hash = ty_record_field_hash(base_field)
        let update = record_update_field_by_hash(updates, update_count, field_hash, src)
        if update == 0 {
          nlist_add(result_fields, base_field)
        } else {
          nlist_add(result_fields, ty_record_field(field_hash, synth(node_f3(update), env, ft, src, tt), node_f1(update), node_f2(update)))
        }
      }
      for i in 0..update_count {
        let update = nlist_get(updates, i)
        let field_hash = record_value_field_hash(update, src)
        if record_update_base_has_hash(base_ty, field_hash) == 0 {
          nlist_add(result_fields, ty_record_field(field_hash, synth(node_f3(update), env, ft, src, tt), node_f1(update), node_f2(update)))
        } else { 0 }
      }
      ty_record(result_fields, 0)
    }
  }
}

pub(package) fn record_update_write_facts(node: i64, base_ty: i64, result_ty: i64, src: i64) -> i64 {
  let fields = node_f2(node)
  for i in 0..node_f3(node) {
    let field = nlist_get(fields, i)
    let field_hash = record_value_field_hash(field, src)
    let result_field = ty_record_field_by_hash(ty_record_fields(result_ty), field_hash)
    let field_ty = if result_field == 0 { ty_any() } else { ty_record_field_type(result_field) }
    mem_store64_at(field, 32, node_new(1, field_ty, field_hash, ty_record_field_word_offset(result_ty, field_hash), 0))
  }
  mem_store64_at(node, 32, node_new(1, result_ty, base_ty, 0, 0))
  0
}

pub(package) fn typeck_named_record_field_word_offset(entry: i64, base_ty: i64, caller_src: i64, field_ns: i64, field_nl: i64) -> i64 {
  if entry == 0 { 0 - 1 }
  else {
    let entry_src = mem_load64_at(entry, 48)
    let fields = mem_load64_at(entry, 32)
    let nfields = mem_load64_at(entry, 24)
    let subst = type_cycle_subst_for_entry(entry, ty_f3(base_ty))
    let mut offset = 0
    let mut result = 0 - 1
    let mut i = 0
    while i < nfields and result < 0 {
      let declared_ns = mem_load64_at(fields, i * 24)
      let declared_nl = mem_load64_at(fields, i * 24 + 8)
      if declared_nl == field_nl and src_eq_at(caller_src, field_ns, entry_src + declared_ns, 0, field_nl) == 1 {
        result = offset
      } else {
        let raw_ty = mem_load64_at(fields, i * 24 + 16)
        let field_ty = type_cycle_maybe_subst(raw_ty, subst)
        let words = ty_value_storage_word_count(field_ty)
        offset = offset + if words > 0 { words } else { 1 }
        i = i + 1
      }
    }
    result
  }
}

-- Every nominal record publishes the finite-map predicate its declaration
-- proves.  Keep this in the checker/type-relation layer: consumers compare
-- the projection as a semantic type, while lowering continues to use the
-- nominal value's concrete storage layout.
pub(package) fn typeck_named_record_projection(tt: i64, named_ty: i64) -> i64 {
  if named_ty == 0 or ty_tag(named_ty) != 9 { 0 }
  else {
    let entry = ttable_lookup_by_type_hash(tt, ty_f1(named_ty))
    if entry == 0 { 0 }
    else {
      let entry_src = mem_load64_at(entry, 48)
      let fields = mem_load64_at(entry, 32)
      let nfields = mem_load64_at(entry, 24)
      let subst = type_cycle_subst_for_entry(entry, ty_f3(named_ty))
      let projected = nlist_new_capacity(nfields)
      for i in 0..nfields {
        let field_ns = mem_load64_at(fields, i * 24)
        let field_nl = mem_load64_at(fields, i * 24 + 8)
        let raw_ty = mem_load64_at(fields, i * 24 + 16)
        let field_ty = type_cycle_maybe_subst(raw_ty, subst)
        nlist_add(projected, ty_record_field(effect_name_hash(entry_src, field_ns, field_nl), field_ty, field_ns, field_nl))
      }
      ty_record(projected, 0)
    }
  }
}

pub(package) fn synth_field_access(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let base = node_f1(node)
  let field_ns = node_f2(node)
  let field_nl = node_f3(node)
  let declaration = typeck_resolve_module_member_access(node, env, src, tt)
  let constant = if declaration == 0 { 0 } else { module_decl_fact_constant_fact(declaration) }
  let member_entry = if constant != 0 { 0 } else { typeck_qualified_member_entry(node, env, ft, src, tt) }
  if constant != 0 {
    module_constant_fact_declared_type(constant)
  } else { if member_entry != 0 {
    let decl = ftypes_entry_decl_fact(member_entry)
    if decl != 0 and module_decl_fact_namespace(decl) == module_decl_namespace_constructor() and nlist_len(ftypes_entry_params(member_entry)) == 0 {
      ftypes_entry_return_type(member_entry)
    } else { ftypes_entry_fn_type(member_entry) }
  }
  else {
  let raw_base_ty = synth(base, env, ft, src, tt)
  let base_ty = if ty_is_borrow(raw_base_ty) { ty_borrow_inner(raw_base_ty) }
    else { if ty_is_owned(raw_base_ty) { ty_owned_inner(raw_base_ty) }
    else { if ty_is_unique(raw_base_ty) { ty_unique_inner(raw_base_ty) } else { raw_base_ty } } }
  if typeck_resolve_indexed_len(node, base_ty, src, field_ns, field_nl) == 1 { ty_usize() }
  else { if ty_tag(base_ty) == 7 {
    let field_hash = field_access_key(src, field_ns, field_nl)
    let field = ty_record_field_by_hash(ty_record_fields(base_ty), field_hash)
    let word_offset = ty_record_field_word_offset(base_ty, field_hash)
    let field_ty = if field == 0 { ty_any() } else { ty_record_field_type(field) }
    if field != 0 {
      mem_store64_at(node, 32, node_new(1, field_ty, word_offset, base_ty, 1))
    } else { 0 }
    field_ty
  } else { if ty_tag(base_ty) == 9 and field_access_is_tuple_position(field_nl) == 0 {
    let entry = ttable_lookup_by_type_hash(tt, ty_f1(base_ty))
    if entry != 0 {
      let entry_src = mem_load64_at(entry, 48)
      let raw_field_ty = ttable_field_type(entry, entry_src, src, field_ns, field_nl)
      let field_subst = type_cycle_subst_for_entry(entry, ty_f3(base_ty))
      let resolved = type_cycle_maybe_subst(raw_field_ty, field_subst)
      let field_ty = if resolved != 0 { resolved } else { ty_i64() }
      let word_offset = typeck_named_record_field_word_offset(entry, base_ty, src, field_ns, field_nl)
      if raw_field_ty != 0 and word_offset >= 0 { mem_store64_at(node, 32, node_new(1, field_ty, word_offset, base_ty, 0)) } else { 0 }
      field_ty
    } else { ty_i64() }
  } else { ty_i64() } } }
  } }
}

pub(package) fn synth_indexed_get(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let raw_base_ty = synth(node_f1(node), env, ft, src, tt)
  let base_ty = if ty_is_borrow(raw_base_ty) { ty_borrow_inner(raw_base_ty) } else { raw_base_ty }
  if ty_is_array(base_ty) or ty_is_slice(base_ty) {
    let element_ty = if ty_is_array(base_ty) { ty_array_inner(base_ty) } else { ty_slice_inner(base_ty) }
    let fixed_len = if ty_is_array(base_ty) { ty_array_length(base_ty) } else { 0 - 1 }
    mem_store64_at(node, 24, element_ty)
    mem_store64_at(node, 32, fixed_len)
    element_ty
  } else { ty_any() }
}

pub(package) fn synth_indexed_slice(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let raw_base_ty = synth(node_f1(node), env, ft, src, tt)
  let base_ty = if ty_is_borrow(raw_base_ty) { ty_borrow_inner(raw_base_ty) }
    else { if ty_is_owned(raw_base_ty) { ty_owned_inner(raw_base_ty) }
    else { if ty_is_unique(raw_base_ty) { ty_unique_inner(raw_base_ty) } else { raw_base_ty } } }
  if ty_is_array(base_ty) or ty_is_slice(base_ty) or typeck_type_is_vector(tt, base_ty) == 1 {
    let element_ty = if ty_is_array(base_ty) { ty_array_inner(base_ty) }
      else { if ty_is_slice(base_ty) { ty_slice_inner(base_ty) } else { typeck_vector_element_type(base_ty) } }
    let fixed_len = if ty_is_array(base_ty) { ty_array_length(base_ty) } else { 0 - 1 }
    let existing = node_f4(node)
    let mutable = if existing == 0 { 0 } else { node_f4(existing) }
    if existing == 0 { mem_store64_at(node, 32, node_new(0, element_ty, fixed_len, base_ty, mutable)) } else { 0 }
    ty_slice_with_mut(element_ty, mutable)
  } else { ty_any() }
}

pub(package) fn synth_address_of(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let inner_ty = synth(node_f2(node), env, ft, src, tt)
  ty_ptr_with_mut(inner_ty, node_f1(node))
}

pub(package) fn synth_deref(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let ptr_ty = synth(node_f1(node), env, ft, src, tt)
  if ty_is_ptr(ptr_ty) == 1 { ty_ptr_inner(ptr_ty) } else { ty_any() }
}

pub(package) fn ty_for_int_prim(prim: i64) -> i64 {
  if prim == PRIM_I8() { ty_i8() }
  else { if prim == PRIM_I16() { ty_i16() }
  else { if prim == PRIM_I32() { ty_i32() }
  else { if prim == PRIM_U8() { ty_u8() }
  else { if prim == PRIM_U16() { ty_u16() }
  else { if prim == PRIM_U32() { ty_u32() }
  else { if prim == PRIM_U64() { ty_u64() }
  else { if prim == PRIM_ISIZE() { ty_isize() }
  else { if prim == PRIM_USIZE() { ty_usize() }
  else { ty_i64() } } } } } } } } }
}

pub(package) fn int_binop_candidate_prim(lhs_ty: i64, rhs_ty: i64) -> i64 {
  let lhs_prim = type_int_prim(lhs_ty)
  let rhs_prim = type_int_prim(rhs_ty)
  if lhs_prim >= 0 and lhs_prim != PRIM_I64() { lhs_prim }
  else { if rhs_prim >= 0 and rhs_prim != PRIM_I64() { rhs_prim }
  else { PRIM_I64() } }
}

pub(package) fn synth_int_binop_type(lhs: i64, rhs: i64, lhs_ty: i64, rhs_ty: i64, src: i64) -> i64 {
  let prim = int_binop_candidate_prim(lhs_ty, rhs_ty)
  if expr_matches_int_prim_contextual(lhs, lhs_ty, prim, src) == 1 and expr_matches_int_prim_contextual(rhs, rhs_ty, prim, src) == 1 {
    ty_for_int_prim(prim)
  } else { ty_i64() }
}

pub(package) fn synth_numeric_binop_type(lhs: i64, rhs: i64, lhs_ty: i64, rhs_ty: i64, src: i64) -> i64 {
  let has_f32 = type_is_f32_exact(lhs_ty) == 1 or type_is_f32_exact(rhs_ty) == 1
  if has_f32 == 1 and expr_matches_f32_contextual(lhs, lhs_ty) == 1 and expr_matches_f32_contextual(rhs, rhs_ty) == 1 {
    ty_f32()
  } else { if type_is_f64_exact(lhs_ty) or type_is_f64_exact(rhs_ty) { ty_f64() }
  else { if type_is_f32_exact(lhs_ty) or type_is_f32_exact(rhs_ty) { ty_f32() }
  else { synth_int_binop_type(lhs, rhs, lhs_ty, rhs_ty, src) } } }
}

pub(package) fn synth_binop(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let op = node_f1(node)
  let lhs = node_f2(node)
  let rhs = node_f3(node)
  let lhs_ty = synth(lhs, env, ft, src, tt)
  let rhs_ty = synth(rhs, env, ft, src, tt)
  match op {
    -- Arithmetic: f32/f64 stay in their exact float lane; otherwise integer.
    1 -> synth_numeric_binop_type(lhs, rhs, lhs_ty, rhs_ty, src)
    2 -> synth_numeric_binop_type(lhs, rhs, lhs_ty, rhs_ty, src)
    3 -> synth_numeric_binop_type(lhs, rhs, lhs_ty, rhs_ty, src)
    4 -> synth_numeric_binop_type(lhs, rhs, lhs_ty, rhs_ty, src)
    -- Modulo is i64-only.
    11 -> synth_int_binop_type(lhs, rhs, lhs_ty, rhs_ty, src)
    -- Comparison: ==,!=,<,>,<=,>= → bool
    5 -> ty_bool()
    6 -> ty_bool()
    7 -> ty_bool()
    8 -> ty_bool()
    9 -> ty_bool()
    10 -> ty_bool()
    -- Logical: and=12, or=13 → bool
    12 -> ty_bool()
    13 -> ty_bool()
    -- Bitwise: band=14..bshr=18 → integer operand type
    _ -> synth_int_binop_type(lhs, rhs, lhs_ty, rhs_ty, src)
  }
}

pub(package) fn intrinsic_int_to_f64_arg_ty(src: i64, ns: i64, nl: i64) -> i64 {
  if src_eq(src, ns, nl, "__i8_to_f64") == 1 { ty_i8() }
  else { if src_eq(src, ns, nl, "__i16_to_f64") == 1 { ty_i16() }
  else { if src_eq(src, ns, nl, "__i32_to_f64") == 1 { ty_i32() }
  else { if src_eq(src, ns, nl, "__i64_to_f64") == 1 { ty_i64() }
  else { if src_eq(src, ns, nl, "__isize_to_f64") == 1 { ty_isize() }
  else { if src_eq(src, ns, nl, "__u8_to_f64") == 1 { ty_u8() }
  else { if src_eq(src, ns, nl, "__u16_to_f64") == 1 { ty_u16() }
  else { if src_eq(src, ns, nl, "__u32_to_f64") == 1 { ty_u32() }
  else { if src_eq(src, ns, nl, "__u64_to_f64") == 1 { ty_u64() }
  else { if src_eq(src, ns, nl, "__usize_to_f64") == 1 { ty_usize() }
  else { 0 } } } } } } } } } }
}

pub(package) fn intrinsic_int_to_f32_arg_ty(src: i64, ns: i64, nl: i64) -> i64 {
  if src_eq(src, ns, nl, "__i8_to_f32") == 1 { ty_i8() }
  else { if src_eq(src, ns, nl, "__i16_to_f32") == 1 { ty_i16() }
  else { if src_eq(src, ns, nl, "__i32_to_f32") == 1 { ty_i32() }
  else { if src_eq(src, ns, nl, "__i64_to_f32") == 1 { ty_i64() }
  else { if src_eq(src, ns, nl, "__isize_to_f32") == 1 { ty_isize() }
  else { if src_eq(src, ns, nl, "__u8_to_f32") == 1 { ty_u8() }
  else { if src_eq(src, ns, nl, "__u16_to_f32") == 1 { ty_u16() }
  else { if src_eq(src, ns, nl, "__u32_to_f32") == 1 { ty_u32() }
  else { if src_eq(src, ns, nl, "__u64_to_f32") == 1 { ty_u64() }
  else { if src_eq(src, ns, nl, "__usize_to_f32") == 1 { ty_usize() }
  else { 0 } } } } } } } } } }
}

pub(package) fn intrinsic_int_cast_arg_ty(src: i64, ns: i64, nl: i64) -> i64 {
  if src_eq(src, ns, nl, "__i8_to_i64") == 1 { ty_i8() }
  else { if src_eq(src, ns, nl, "__i16_to_i64") == 1 { ty_i16() }
  else { if src_eq(src, ns, nl, "__i32_to_i64") == 1 { ty_i32() }
  else { if src_eq(src, ns, nl, "__isize_to_i64") == 1 { ty_isize() }
  else { if src_eq(src, ns, nl, "__u8_to_u64") == 1 { ty_u8() }
  else { if src_eq(src, ns, nl, "__u16_to_u64") == 1 { ty_u16() }
  else { if src_eq(src, ns, nl, "__u32_to_u64") == 1 { ty_u32() }
  else { if src_eq(src, ns, nl, "__usize_to_u64") == 1 { ty_usize() }
  else { if src_eq(src, ns, nl, "__i64_to_i8") == 1 or src_eq(src, ns, nl, "__i64_to_i16") == 1 or src_eq(src, ns, nl, "__i64_to_i32") == 1 { ty_i64() }
  else { if src_eq(src, ns, nl, "__i64_to_isize") == 1 or src_eq(src, ns, nl, "__i64_to_u8") == 1 or src_eq(src, ns, nl, "__i64_to_u16") == 1 { ty_i64() }
  else { if src_eq(src, ns, nl, "__i64_to_u32") == 1 or src_eq(src, ns, nl, "__i64_to_u64") == 1 or src_eq(src, ns, nl, "__i64_to_usize") == 1 { ty_i64() }
  else { if src_eq(src, ns, nl, "__u64_to_i8") == 1 or src_eq(src, ns, nl, "__u64_to_i16") == 1 or src_eq(src, ns, nl, "__u64_to_i32") == 1 { ty_u64() }
  else { if src_eq(src, ns, nl, "__u64_to_i64") == 1 or src_eq(src, ns, nl, "__u64_to_isize") == 1 or src_eq(src, ns, nl, "__u64_to_u8") == 1 { ty_u64() }
  else { if src_eq(src, ns, nl, "__u64_to_u16") == 1 or src_eq(src, ns, nl, "__u64_to_u32") == 1 or src_eq(src, ns, nl, "__u64_to_usize") == 1 { ty_u64() }
  else { 0 } } } } } } } } } } } } } } }
}

pub(package) fn intrinsic_int_cast_return_ty(src: i64, ns: i64, nl: i64) -> i64 {
  if src_eq(src, ns, nl, "__i8_to_i64") == 1 or src_eq(src, ns, nl, "__i16_to_i64") == 1 or src_eq(src, ns, nl, "__i32_to_i64") == 1 or src_eq(src, ns, nl, "__isize_to_i64") == 1 { ty_i64() }
  else { if src_eq(src, ns, nl, "__u8_to_u64") == 1 or src_eq(src, ns, nl, "__u16_to_u64") == 1 or src_eq(src, ns, nl, "__u32_to_u64") == 1 or src_eq(src, ns, nl, "__usize_to_u64") == 1 { ty_u64() }
  else { if src_eq(src, ns, nl, "__i64_to_i8") == 1 or src_eq(src, ns, nl, "__u64_to_i8") == 1 { ty_i8() }
  else { if src_eq(src, ns, nl, "__i64_to_i16") == 1 or src_eq(src, ns, nl, "__u64_to_i16") == 1 { ty_i16() }
  else { if src_eq(src, ns, nl, "__i64_to_i32") == 1 or src_eq(src, ns, nl, "__u64_to_i32") == 1 { ty_i32() }
  else { if src_eq(src, ns, nl, "__i64_to_isize") == 1 or src_eq(src, ns, nl, "__u64_to_isize") == 1 { ty_isize() }
  else { if src_eq(src, ns, nl, "__i64_to_u8") == 1 or src_eq(src, ns, nl, "__u64_to_u8") == 1 { ty_u8() }
  else { if src_eq(src, ns, nl, "__i64_to_u16") == 1 or src_eq(src, ns, nl, "__u64_to_u16") == 1 { ty_u16() }
  else { if src_eq(src, ns, nl, "__i64_to_u32") == 1 or src_eq(src, ns, nl, "__u64_to_u32") == 1 { ty_u32() }
  else { if src_eq(src, ns, nl, "__i64_to_u64") == 1 { ty_u64() }
  else { if src_eq(src, ns, nl, "__i64_to_usize") == 1 or src_eq(src, ns, nl, "__u64_to_usize") == 1 { ty_usize() }
  else { if src_eq(src, ns, nl, "__u64_to_i64") == 1 { ty_i64() }
  else { 0 } } } } } } } } } } } }
}

pub(package) fn synth_intrinsic_call(src: i64, ns: i64, nl: i64) -> i64 {
  let int_cast_ret_ty = intrinsic_int_cast_return_ty(src, ns, nl)
  if int_cast_ret_ty != 0 { int_cast_ret_ty }
  else { if intrinsic_int_to_f64_arg_ty(src, ns, nl) != 0 { ty_f64() }
  else { if intrinsic_int_to_f32_arg_ty(src, ns, nl) != 0 { ty_f32() }
  else { if src_eq(src, ns, nl, "__f64_to_i64_trunc") == 1 { ty_i64() }
  else { if src_eq(src, ns, nl, "__f32_to_f64") == 1 { ty_f64() }
  else { if src_eq(src, ns, nl, "__f64_to_f32") == 1 { ty_f32() }
  else { if src_eq(src, ns, nl, "__f64_sqrt") == 1 { ty_f64() }
  else { if src_eq(src, ns, nl, "__f32_sqrt") == 1 { ty_f32() }
  else { if src_eq(src, ns, nl, "__raw_offset") == 1 { ty_any() }
  else { if src_eq(src, ns, nl, "__transmute") == 1 { ty_any() }
  else { if src_eq(src, ns, nl, "__int_to_ptr") == 1 { ty_any() }
  else { if src_eq(src, ns, nl, "__mem_load_sized") == 1 { ty_i64() }
  else { if src_eq(src, ns, nl, "__mem_store_sized") == 1 { ty_i64() }
  else { ty_i64() }
  } } } } } } } } } } } }
}

pub(package) fn weak_ref_name(src: i64, ns: i64, nl: i64) -> i64 {
  src_eq(src, ns, nl, "weak_ref")
}

pub(package) fn weak_load_name(src: i64, ns: i64, nl: i64) -> i64 {
  src_eq(src, ns, nl, "weak_load")
}

pub(package) fn typeck_ty_is_weak_target(ty: i64) -> i64 {
  if ty == 0 { 0 }
  else {
    let kind = ty_field_release_mask_kind(ty)
    kind == 1 or kind == 2 or ty_is_arc(ty) == 1
  }
}

pub(package) fn typeck_ty_is_weak_managed_ref(ty: i64) -> i64 {
  if ty == 0 { 0 }
  else { if ty_is_weak(ty) != 1 { 0 } else { typeck_ty_is_weak_target(ty_weak_inner(ty)) } }
}

pub(package) fn synth_weak_ref_call(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  if node_f4(node) == 1 { ty_weak(synth(nlist_get(node_f3(node), 0), env, ft, src, tt)) }
  else { ty_i64() }
}

pub(package) fn synth_weak_load_call(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  if node_f4(node) == 1 {
    let weak_ty = synth(nlist_get(node_f3(node), 0), env, ft, src, tt)
    if ty_is_weak(weak_ty) == 1 { ty_nullable(ty_weak_inner(weak_ty)) } else { ty_i64() }
  } else { ty_i64() }
}

pub(package) fn synth_call(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let ns = node_f1(node)
  let nl = node_f2(node)
  if weak_ref_name(src, ns, nl) == 1 {
    synth_weak_ref_call(node, env, ft, src, tt)
  } else { if weak_load_name(src, ns, nl) == 1 {
    synth_weak_load_call(node, env, ft, src, tt)
  } else { if src_eq(src, ns, nl, "rc_default_alloc") == 1 {
    ty_rc(ty_i64())
  } else {
    if nl >= 2 {
      if mem_load8_at(src, ns) == 95 {
        if mem_load8_at(src, ns + 1) == 95 { synth_intrinsic_call(src, ns, nl) }
        else { synth_call_general(node, env, ft, src, tt) }
      } else { synth_call_general(node, env, ft, src, tt) }
    } else { synth_call_general(node, env, ft, src, tt) }
  }
  } }
}

-- Bare calls try generic type-arg inference first (which rewrites the
-- node to an explicit GenericCall when it solves); otherwise ordinary
-- return-type lookup.
pub(package) fn synth_call_general(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let inferred = synth_call_infer_generic(node, env, ft, src, tt)
  if inferred != 0 { inferred }
  else { synth_call_lookup(env, ft, src, node_f1(node), node_f2(node)) }
}

pub(package) fn synth_call_lookup(env: i64, ft: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let local_ty = tenv_lookup(env, src, ns, nl)
  if local_ty != 0 {
    if ty_tag(local_ty) == 6 { ty_f2(local_ty) }
    else { if ty_tag(local_ty) == 14 { ty_f2(local_ty) }
    else {
      let ret = ftypes_lookup(ft, src, ns, nl)
      if ret == 0 { ty_i64() } else { ret }
    } }
  } else {
    let ret = ftypes_lookup(ft, src, ns, nl)
    if ret == 0 { ty_i64() } else { ret }
  }
}

-- Build substitution from type params + explicit type args
pub(package) fn build_subst(tparams: i64, type_args: i64) -> i64 {
  let s = subst_new()
  let n = nlist_len(tparams)
  for i in 0..n {
    if i < nlist_len(type_args) {
      let tp = nlist_get(tparams, i)
      let var_id = node_f3(tp)
      let concrete = nlist_get(type_args, i)
      subst_add(s, var_id, concrete)
    } else { 0 }
  }
  s
}

-- GenericCall: tag 36 = (type_args_list, inner_call_node, num_type_args, 0)
pub(package) fn generic_call_inner_args(call_node: i64) -> i64 {
  if node_tag(call_node) == 32 { node_f4(call_node) } else { node_f3(call_node) }
}

pub(package) fn generic_call_inner_arg_count(call_node: i64) -> i64 {
  let args = generic_call_inner_args(call_node)
  if args == 0 { 0 } else { if node_tag(call_node) == 32 { nlist_len(args) } else { node_f4(call_node) } }
}

pub(package) fn generic_call_inner_name_start(call_node: i64) -> i64 {
  if node_tag(call_node) == 32 { node_f2(call_node) } else { node_f1(call_node) }
}

pub(package) fn generic_call_inner_name_len(call_node: i64) -> i64 {
  if node_tag(call_node) == 32 { node_f3(call_node) } else { node_f2(call_node) }
}

pub(package) fn generic_call_ftypes_entry(call_node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  if node_tag(call_node) == 32 {
    typeck_qualified_member_entry(call_node, env, ft, src, tt)
  } else { ftypes_find(ft, src, node_f1(call_node), node_f2(call_node)) }
}

pub(package) fn typeck_type_lists_concat(left: i64, right: i64) -> i64 {
  let left_len = if left == 0 { 0 } else { nlist_len(left) }
  let right_len = if right == 0 { 0 } else { nlist_len(right) }
  let result = nlist_new_capacity(left_len + right_len)
  for i in 0..left_len { nlist_add(result, nlist_get(left, i)) }
  for i in 0..right_len { nlist_add(result, nlist_get(right, i)) }
  result
}

-- Dot-generic syntax first parses neutrally as GenericCall(Perform(...)).
-- Once the receiver resolves to a method, fold the explicit method arguments
-- into the checker-owned MethodRef and replace the wrapper with the ordinary
-- MethodCall fact consumed by every later pass.
pub(package) fn typeck_rewrite_generic_method_call(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let call_node = node_f2(node)
  if node_tag(call_node) != 32 { 0 }
  else { if typeck_qualified_member_entry(call_node, env, ft, src, tt) != 0 {
    -- An inferred qualified generic function is already represented by this
    -- outer GenericCall and its neutral qualified-call child. Re-synthesising
    -- the child here would wrap a second GenericCall inside the first, after
    -- which its type-list pointers could be mistaken for source offsets.
    0
  } else {
    synth_dot_call(call_node, env, ft, src, tt)
    if node_tag(call_node) != 41 { 0 }
    else {
      let previous = node_f4(call_node)
      let complete_args = typeck_type_lists_concat(method_ref_type_args(previous), node_f1(node))
      let updated = method_ref_with_source(method_ref_with_declaration(method_ref_new(
        method_ref_owner_hash(previous),
        method_ref_receiver_ty(previous),
        complete_args,
        1
      ), method_ref_declaration(previous)), method_ref_name_start(previous), method_ref_name_len(previous))
      mem_store64_at(node, 0, 41)
      mem_store64_at(node, 8, node_f1(call_node))
      mem_store64_at(node, 16, node_f2(call_node))
      mem_store64_at(node, 24, node_f3(call_node))
      mem_store64_at(node, 32, updated)
      1
    }
  } }
}

pub(package) fn synth_generic_call(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  if typeck_rewrite_generic_method_call(node, env, ft, src, tt) == 1 {
    return synth_resolved_method_call(node, tt)
  } else { 0 }
  let type_args = node_f1(node)
  let call_node = node_f2(node)
  let entry = generic_call_ftypes_entry(call_node, env, ft, src, tt)
  let tparams = ftypes_entry_tparams(entry)
  let is_ref = node_tag(call_node) == 2
  let ret_ty = if is_ref { ftypes_entry_fn_type(entry) } else { ftypes_entry_return_type(entry) }
  if tparams == 0 {
    -- Not generic or not found: fall back to regular call synthesis
    if ret_ty == 0 { ty_i64() } else { ret_ty }
  } else {
    -- Check type arg count matches
    let n_tparams = nlist_len(tparams)
    let n_targs = nlist_len(type_args)
    -- Compiler-produced shape specialisations append one exact type per
    -- value parameter after the source-written generic arguments.  The
    -- ordinary substitution deliberately consumes only the tparam prefix.
    if n_targs < n_tparams {
      if ret_ty == 0 { ty_any() } else { ret_ty }
    } else {
      -- Build substitution and apply to return type
      let s = build_subst(tparams, type_args)
      if ret_ty == 0 { ty_any() } else { typeck_subst_resolve_associated_type(ret_ty, tparams, s, tt) }
    }
  }
}

-- ══════════════════════════════════════════════════════════════
-- Generic instantiation inference
--
-- Bare calls to generic ctors/functions solve their type args from
-- argument types (synth_call path); generic ctors in result positions
-- additionally solve from the expected type (return position, let
-- annotation, argument position, assignment). Successful inference
-- rewrites the node in place into the explicit GenericCall (tag 36)
-- shape the parser produces for name<targs>(args), so checking,
-- monomorphisation, and codegen all see the one explicit shape.
--
-- Inference only fires where the program would otherwise fail to
-- check (context sites are second-chance-on-mismatch; the synth_call
-- path only rewrites calls whose bare form cannot check against
-- var-typed params), so it strictly accepts more programs.
-- ══════════════════════════════════════════════════════════════

-- Structural type identity for conflict detection. Conservative: shapes
-- it does not model compare unequal, which aborts inference rather than
-- risking a wrong instantiation.
pub(package) fn ty_infer_same(a: i64, b: i64) -> i64 {
  if a == b { 1 }
  else { if a == 0 or b == 0 { 0 }
  else {
    let atag = ty_tag(a)
    if atag != ty_tag(b) { 0 }
    else {
      match atag {
        0 -> 1
        1 -> 1
        2 -> if ty_f1(a) == ty_f1(b) { 1 } else { 0 }
        12 -> if ty_f1(a) == ty_f1(b) { 1 } else { 0 }
        3 -> if ty_infer_same(ty_f1(a), ty_f1(b)) == 1 { ty_infer_same(ty_f2(a), ty_f2(b)) } else { 0 }
        7 -> if ty_eq(a, b) { 1 } else { 0 }
        9 -> {
          if ty_f1(a) != ty_f1(b) { 0 }
          else { ty_infer_same_list(ty_f3(a), ty_f3(b)) }
        }
        16 -> ty_infer_same(ty_f1(a), ty_f1(b))
        17 -> ty_infer_same(ty_f1(a), ty_f1(b))
        18 -> ty_infer_same(ty_f1(a), ty_f1(b))
        19 -> ty_infer_same(ty_f1(a), ty_f1(b))
        29 -> if ty_f2(a) == ty_f2(b) { ty_infer_same(ty_f1(a), ty_f1(b)) } else { 0 }
        22 -> if ty_f2(a) == ty_f2(b) { ty_infer_same(ty_f1(a), ty_f1(b)) } else { 0 }
        23 -> if ty_f2(a) == ty_f2(b) { ty_infer_same(ty_f1(a), ty_f1(b)) } else { 0 }
        _ -> 0
      }
    }
  } }
}

pub(package) fn ty_infer_same_list(a: i64, b: i64) -> i64 {
  if a == 0 and b == 0 { 1 }
  else { if a == 0 or b == 0 { 0 }
  else {
    let n = nlist_len(a)
    if n != nlist_len(b) { 0 }
    else {
      let mut same = 1
      for i in 0..n {
        if ty_infer_same(nlist_get(a, i), nlist_get(b, i)) == 0 { same = 0 } else { 0 }
      }
      same
    }
  } }
}

-- Solve type vars in pat against a concrete type, extending s. Returns
-- 1 on success (bindings may or may not have been added), 0 on a
-- conflict with an existing binding. Shapes that carry no information
-- succeed without binding — validation stays with the ordinary checks
-- that run over the rewritten node.
pub(package) fn effect_infer_find_head(atoms: i64, head: i64) -> i64 {
  if atoms == 0 { 0 }
  else {
    let mut result = 0
    for i in 0..nlist_len(atoms) {
      let atom = nlist_get(atoms, i)
      if effect_atom_head(atom) == head { result = atom } else { 0 }
    }
    result
  }
}

pub(package) fn effect_infer_find_atom(atoms: i64, pattern: i64, s: i64) -> i64 {
  if atoms == 0 { 0 }
  else {
    let pattern_args = ty_f2(pattern)
    let concrete_pattern_args = if pattern_args == 0 { 0 } else { type_list_subst(pattern_args, s) }
    let mut result = 0
    let mut i = 0
    while i < nlist_len(atoms) {
      let atom = nlist_get(atoms, i)
      let same_args = if concrete_pattern_args == 0 and ty_f2(atom) == 0 { 1 }
        else { if concrete_pattern_args == 0 or ty_f2(atom) == 0 { 0 }
        else { ty_infer_same_list(concrete_pattern_args, ty_f2(atom)) } }
      if effect_atom_head(atom) == effect_atom_head(pattern) and same_args == 1 {
        result = atom
        i = nlist_len(atoms)
      } else { i = i + 1 }
    }
    if result != 0 { result }
    else {
      let head = ty_f1(pattern)
      if effect_list_head_is_ambiguous(atoms, head) == 1 { 0 }
      else { effect_infer_find_head(atoms, head) }
    }
  }
}

pub(package) fn effect_infer_list_has_atom(atoms: i64, wanted: i64) -> i64 {
  if atoms == 0 or wanted == 0 { 0 }
  else {
    let mut found = 0
    for i in 0..nlist_len(atoms) {
      if effect_atom_eq(nlist_get(atoms, i), wanted) { found = 1 } else { 0 }
    }
    found
  }
}

pub(package) fn effect_infer_sig_same(a: i64, b: i64) -> i64 {
  if a == 0 or b == 0 { 0 }
  else { if ty_tag(a) != 10 or ty_tag(b) != 10 { 0 }
  else { if ty_f2(a) != ty_f2(b) { 0 }
  else {
    let aa = ty_f1(a)
    let ba = ty_f1(b)
    if nlist_len(aa) != nlist_len(ba) { 0 }
    else {
      let mut same = 1
      for i in 0..nlist_len(aa) {
        let atom = nlist_get(aa, i)
        if effect_infer_list_has_atom(ba, atom) == 0 { same = 0 } else { 0 }
      }
      same
    }
  } } }
}

-- Solve a function-effect pattern against the actual callback effects.
-- Pattern concretes match exact atoms after applying already-known type
-- substitutions. The unmatched atoms -- including other instantiations of
-- the same head -- become the compact EffectSig binding for the pattern tail.
pub(package) fn effect_infer_solve(pat: i64, concrete: i64, s: i64) -> i64 {
  if pat == 0 or concrete == 0 { 1 }
  else { if ty_tag(pat) != 10 or ty_tag(concrete) != 10 { 1 }
  else {
    let pats = ty_f1(pat)
    let actuals = ty_f1(concrete)
    let matched = nlist_new()
    let mut ok = 1
    for i in 0..nlist_len(pats) {
      let pa = nlist_get(pats, i)
      let ca = effect_infer_find_atom(actuals, pa, s)
      if ca != 0 {
        if ty_infer_solve_list(ty_f2(pa), ty_f2(ca), s) == 0 { ok = 0 }
        else { nlist_add(matched, ca) }
      } else { 0 }
    }
    let tail = ty_f2(pat)
    if ok == 0 or tail == 0 { ok }
    else {
      let residual = nlist_new()
      for i in 0..nlist_len(actuals) {
        let atom = nlist_get(actuals, i)
        if effect_infer_list_has_atom(matched, atom) == 0 {
          nlist_add(residual, atom)
        } else { 0 }
      }
      let binding = ty_effect_sig_with_tail(residual, ty_f2(concrete))
      let existing = subst_lookup(s, tail - 1)
      if existing == 0 {
        subst_add(s, tail - 1, binding)
        1
      } else { effect_infer_sig_same(existing, binding) }
    }
  } }
}

pub(package) fn ty_infer_solve_record_fields(pattern: i64, concrete: i64, s: i64, bind_concrete_vars: i64) -> i64 {
  let pattern_fields = ty_record_fields(pattern)
  let concrete_fields = ty_record_fields(concrete)
  if ty_record_tuple_kind(pattern) != ty_record_tuple_kind(concrete) { 0 }
  else { if ty_record_open(pattern) == 0 and not record_fields_domain_equal(pattern_fields, concrete_fields) { 0 }
  else {
    let mut ok = 1
    let mut i = 0
    while pattern_fields != 0 and i < nlist_len(pattern_fields) and ok == 1 {
      let pattern_field = nlist_get(pattern_fields, i)
      let concrete_field = ty_record_field_by_hash(concrete_fields, ty_record_field_hash(pattern_field))
      if concrete_field == 0 { ok = 0 }
      else {
        if ty_infer_solve_mode(ty_record_field_type(pattern_field), ty_record_field_type(concrete_field), s, bind_concrete_vars) == 1 { i = i + 1 }
        else { ok = 0 }
      }
    }
    ok
  } }
}

pub(package) fn ty_infer_solve_mode(pat: i64, concrete: i64, s: i64, bind_concrete_vars: i64) -> i64 {
  if pat == 0 or concrete == 0 { 1 }
  else {
    let ptag = ty_tag(pat)
    if ptag == 12 {
      -- A type-var "concrete" carries no information: it is either an
      -- unsolved nested ctor (its instantiation cascades later from the
      -- rewritten parameter type) or an enclosing template's tparam
      -- (templates stay unmutated by inference — mono owns them).
      if ty_tag(concrete) == 12 and bind_concrete_vars == 0 { 1 }
      else {
        let existing = subst_lookup(s, ty_f1(pat))
        if existing == 0 {
          if type_is_unknown_or_any(concrete) { 1 }
          else {
            subst_add(s, ty_f1(pat), concrete)
            1
          }
        } else {
          if type_is_unknown_or_any(concrete) { 1 } else { ty_infer_same(existing, concrete) }
        }
      }
    }
    else { if ptag == 9 and ty_tag(concrete) == 9 {
      if ty_f1(pat) != ty_f1(concrete) { 1 }
      else { ty_infer_solve_list_mode(ty_f3(pat), ty_f3(concrete), s, bind_concrete_vars) }
    }
    else { if ptag == 3 and ty_tag(concrete) == 3 {
      if ty_infer_solve_mode(ty_f1(pat), ty_f1(concrete), s, bind_concrete_vars) == 1 {
        ty_infer_solve_mode(ty_f2(pat), ty_f2(concrete), s, bind_concrete_vars)
      } else { 0 }
    }
    else { if ptag == 6 and ty_tag(concrete) == 6 {
      if ty_infer_solve_list_mode(ty_f1(pat), ty_f1(concrete), s, bind_concrete_vars) == 1 {
        if ty_infer_solve_mode(ty_f2(pat), ty_f2(concrete), s, bind_concrete_vars) == 1 {
          effect_infer_solve(ty_f3(pat), ty_f3(concrete), s)
        } else { 0 }
      } else { 0 }
    }
    else { if ptag == 7 and ty_tag(concrete) == 7 {
      ty_infer_solve_record_fields(pat, concrete, s, bind_concrete_vars)
    }
    else { if ptag == 29 {
      let concrete_inner = if ty_is_owned(concrete) { ty_owned_inner(concrete) }
        else { if ty_is_borrow(concrete) { ty_borrow_inner(concrete) } else { 0 } }
      if concrete_inner == 0 { 1 }
      else { ty_infer_solve_mode(ty_borrow_inner(pat), concrete_inner, s, bind_concrete_vars) }
    }
    else { if ty_tag(concrete) == ptag and (ptag == 16 or ptag == 17 or ptag == 18 or ptag == 19 or ptag == 15) {
      ty_infer_solve_mode(ty_f1(pat), ty_f1(concrete), s, bind_concrete_vars)
    }
    else { if ty_tag(concrete) == ptag and (ptag == 22 or ptag == 23) {
      if ty_f2(pat) == ty_f2(concrete) {
        ty_infer_solve_mode(ty_f1(pat), ty_f1(concrete), s, bind_concrete_vars)
      } else { 1 }
    }
    else { 1 } } } } } } } }
  }
}

pub(package) fn ty_infer_solve(pat: i64, concrete: i64, s: i64) -> i64 {
  ty_infer_solve_mode(pat, concrete, s, 0)
}

pub(package) fn ty_infer_solve_ref(pat: i64, concrete: i64, s: i64) -> i64 {
  ty_infer_solve_mode(pat, concrete, s, 1)
}

pub(package) fn ty_infer_solve_list_mode(pats: i64, concretes: i64, s: i64, bind_concrete_vars: i64) -> i64 {
  if pats == 0 or concretes == 0 { 1 }
  else {
    let n = nlist_len(pats)
    if n != nlist_len(concretes) { 1 }
    else {
      let mut ok = 1
      for i in 0..n {
        if ty_infer_solve_mode(nlist_get(pats, i), nlist_get(concretes, i), s, bind_concrete_vars) == 0 { ok = 0 } else { 0 }
      }
      ok
    }
  }
}

pub(package) fn ty_infer_solve_list(pats: i64, concretes: i64, s: i64) -> i64 {
  ty_infer_solve_list_mode(pats, concretes, s, 0)
}

pub(package) fn generic_infer_associated_actual(tt: i64, concrete: i64, trait_atom: i64, assoc_hash: i64) -> i64 {
  let carried = if ty_tag(concrete) == 12 {
    impl_tparam_bound_atom(ttable_get_tparams(tt), ty_var_id(concrete), trait_atom)
  } else { 0 }
  if carried != 0 { trait_atom_assoc_type(carried, assoc_hash) }
  else { ctable_associated_binding_type(ttable_get_ct(tt), concrete, trait_atom, assoc_hash) }
}

-- Argument inference first solves the parameter that names a protocol
-- witness, then uses that concrete implementation's associated bindings as
-- evidence for any remaining type variables. For example, inferring
-- `S = List<i64>` in `S: IntoIterator & {type Item = T}` also proves
-- `T = i64`; callers should not have to spell an implementation detail that
-- the conformance table already knows. Repeating at most once per type
-- parameter closes short dependency chains while remaining monotonic.
pub(package) fn generic_infer_solve_associated_bounds(tparams: i64, s: i64, tt: i64) -> i64 {
  let count = if tparams == 0 { 0 } else { nlist_len(tparams) }
  for pass in 0..count {
    for i in 0..count {
      let tp = nlist_get(tparams, i)
      let concrete = subst_lookup(s, node_f3(tp))
      let bounds = node_f4(tp)
      if concrete != 0 and bounds != 0 {
        for bi in 0..nlist_len(bounds) {
          let trait_atom = nlist_get(bounds, bi)
          let bindings = trait_atom_assoc_bindings(trait_atom)
          if bindings != 0 {
            for ai in 0..nlist_len(bindings) {
              let binding = nlist_get(bindings, ai)
              let actual = generic_infer_associated_actual(
                tt, concrete, trait_atom, trait_assoc_binding_name(binding)
              )
              if actual != 0 {
                ty_infer_solve(trait_assoc_binding_type(binding), actual, s)
              } else { 0 }
            }
          } else { 0 }
        }
      } else { 0 }
    }
  }
  0
}

-- Solved type-arg list in tparam order, or 0 if any tparam is unsolved.
pub(package) fn generic_infer_solved_targs(tparams: i64, s: i64) -> i64 {
  let n = nlist_len(tparams)
  if n == 0 { 0 }
  else {
    let targs = nlist_new()
    let mut ok = 1
    for i in 0..n {
      let v = subst_lookup(s, node_f3(nlist_get(tparams, i)))
      if v == 0 { ok = 0 } else { nlist_add(targs, v) }
    }
    if ok == 1 { targs } else { 0 }
  }
}

-- Rewrite a bare call/ident node in place to GenericCall(targs, Call).
-- Tag 36 layout: f1=type_args_list, f2=inner_call_node, f3=count, f4=0.
pub(package) fn generic_call_rewrite_to_explicit(node: i64, ns: i64, nl: i64, args: i64, nargs: i64, targs: i64) -> i64 {
  let inner = node_new(4, ns, nl, args, nargs)
  mem_store64_at(node, 0, 36)
  mem_store64_at(node, 8, targs)
  mem_store64_at(node, 16, inner)
  mem_store64_at(node, 24, nlist_len(targs))
  mem_store64_at(node, 32, 0)
  0
}

-- Contextual generic function references use the same explicit generic
-- wrapper as calls, but carry an Ident as the inner expression. Keeping the
-- inferred arguments in the typed tree lets monomorphisation, lowering, and
-- semantic-fact production consume one shared decision.
pub(package) fn generic_ref_rewrite_to_explicit(node: i64, ns: i64, nl: i64, targs: i64) -> i64 {
  let inner = node_new(2, ns, nl, 0, 0)
  mem_store64_at(node, 0, 36)
  mem_store64_at(node, 8, targs)
  mem_store64_at(node, 16, inner)
  mem_store64_at(node, 24, nlist_len(targs))
  mem_store64_at(node, 32, 0)
  0
}

pub(package) fn infer_generic_ref_from_expected(node: i64, target_ty: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  if node_tag(node) != 2 or ty_tag(target_ty) != 6 { 0 }
  else {
    let ns = node_f1(node)
    let nl = node_f2(node)
    if tenv_lookup(env, src, ns, nl) != 0 or ttable_variant_payload_count(tt, src, ns, nl) >= 0 { 0 }
    else {
      let tparams = ftypes_lookup_tparams(ft, src, ns, nl)
      let fn_ty = ftypes_lookup_fn_type(ft, src, ns, nl)
      if tparams == 0 or fn_ty == 0 { 0 }
      else {
        let s = subst_new()
        if ty_infer_solve_ref(fn_ty, target_ty, s) == 0 { 0 }
        else {
          generic_infer_solve_associated_bounds(tparams, s, tt)
          let targs = generic_infer_solved_targs(tparams, s)
          if targs == 0 { 0 }
          else {
            generic_ref_rewrite_to_explicit(node, ns, nl, targs)
            1
          }
        }
      }
    }
  }
}

-- Argument-driven inference for a bare tag-4 call to a generic callee.
-- Returns the substituted return type after rewriting the node, or 0
-- when inference does not apply or does not fully solve.
pub(package) fn synth_call_infer_generic(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let ns = node_f1(node)
  let nl = node_f2(node)
  if tenv_lookup(env, src, ns, nl) != 0 { 0 }
  else {
    let tparams = ftypes_lookup_tparams(ft, src, ns, nl)
    if tparams == 0 { 0 }
    else {
      let params = ftypes_lookup_params(ft, src, ns, nl)
      let args = node_f3(node)
      let nargs = node_f4(node)
      if params == 0 or nargs == 0 { 0 }
      else { if nlist_len(params) != nargs { 0 }
      else {
        let s = subst_new()
        for i in 0..nargs {
          let pty = node_f3(nlist_get(params, i))
          if pty != 0 {
            let actual_ty = synth(nlist_get(args, i), env, ft, src, tt)
            let projected = if ty_is_record(pty) and ty_tag(actual_ty) == 9 { typeck_named_record_projection(tt, actual_ty) } else { 0 }
            let inference_ty = if projected != 0 { projected } else { actual_ty }
            ty_infer_solve(pty, inference_ty, s)
          } else { 0 }
        }
        generic_infer_solve_associated_bounds(tparams, s, tt)
        -- A conflicting later argument must not erase facts solved by an
        -- earlier one. If every type parameter has a witness, retain that
        -- recovery specialization: the ordinary substituted argument checker
        -- then reports the actual conflict once with concrete expected/found
        -- types instead of cascading `unknown` diagnostics over every arg.
        let targs = generic_infer_solved_targs(tparams, s)
        if targs == 0 { 0 }
        else {
          let ret_ty = ftypes_lookup(ft, src, ns, nl)
          generic_call_rewrite_to_explicit(node, ns, nl, args, nargs, targs)
          if ret_ty == 0 { ty_any() } else { typeck_subst_resolve_associated_type(ret_ty, tparams, s, tt) }
        }
      } }
    }
  }
}

pub(package) fn generic_qualified_call_rewrite_to_explicit(node: i64, targs: i64) -> i64 {
  let inner = node_new(32, node_f1(node), node_f2(node), node_f3(node), node_f4(node))
  mem_store64_at(node, 0, 36)
  mem_store64_at(node, 8, targs)
  mem_store64_at(node, 16, inner)
  mem_store64_at(node, 24, nlist_len(targs))
  mem_store64_at(node, 32, 0)
  0
}

pub(package) fn synth_qualified_call_infer_generic(node: i64, entry: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let tparams = ftypes_entry_tparams(entry)
  let params = ftypes_entry_params(entry)
  let args = node_f4(node)
  let nargs = nlist_len(args)
  if tparams == 0 or params == 0 or nargs == 0 or nlist_len(params) != nargs { 0 }
  else {
    let s = subst_new()
    for i in 0..nargs {
      let pty = node_f3(nlist_get(params, i))
      if pty != 0 {
        let actual_ty = synth(nlist_get(args, i), env, ft, src, tt)
        let projected = if ty_is_record(pty) and ty_tag(actual_ty) == 9 { typeck_named_record_projection(tt, actual_ty) } else { 0 }
        let inference_ty = if projected != 0 { projected } else { actual_ty }
        ty_infer_solve(pty, inference_ty, s)
      } else { 0 }
    }
    generic_infer_solve_associated_bounds(tparams, s, tt)
    let targs = generic_infer_solved_targs(tparams, s)
    if targs == 0 { 0 }
    else {
      let ret_ty = ftypes_entry_return_type(entry)
      generic_qualified_call_rewrite_to_explicit(node, targs)
      if ret_ty == 0 { ty_any() } else { typeck_subst_resolve_associated_type(ret_ty, tparams, s, tt) }
    }
  }
}

-- Context-driven inference for a generic ctor meeting an expected type.
-- Ctors only: their declared return type is exactly parent<vars>, so
-- unifying it against the expected type either fully solves the
-- instantiation or leaves vars for payload args to fill.
pub(package) fn try_infer_ctor_from_expected(node: i64, target_ty: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let tag = node_tag(node)
  let ns = node_f1(node)
  let nl = node_f2(node)
  if tag == 2 and tenv_lookup(env, src, ns, nl) != 0 { 0 }
  else { if ttable_variant_payload_count(tt, src, ns, nl) < 0 { 0 }
  else {
    let tparams = ftypes_lookup_tparams(ft, src, ns, nl)
    if tparams == 0 { 0 }
    else {
      let ret_ty = ftypes_lookup(ft, src, ns, nl)
      if ret_ty == 0 { 0 }
      else {
        let s = subst_new()
        if ty_infer_solve(ret_ty, target_ty, s) == 0 { 0 }
        else {
          let mut ok = 1
          if tag == 4 {
            let params = ftypes_lookup_params(ft, src, ns, nl)
            let args = node_f3(node)
            let nargs = node_f4(node)
            if params != 0 and nlist_len(params) == nargs {
              for i in 0..nargs {
                let pty = node_f3(nlist_get(params, i))
                if pty != 0 {
                  if ty_infer_solve(pty, synth(nlist_get(args, i), env, ft, src, tt), s) == 0 { ok = 0 } else { 0 }
                } else { 0 }
              }
            } else { 0 }
          } else { 0 }
          generic_infer_solve_associated_bounds(tparams, s, tt)
          if ok == 0 { 0 }
          else {
            let targs = generic_infer_solved_targs(tparams, s)
            if targs == 0 { 0 }
            else {
              let args = if tag == 4 { node_f3(node) } else { nlist_new() }
              let nargs = if tag == 4 { node_f4(node) } else { 0 }
              generic_call_rewrite_to_explicit(node, ns, nl, args, nargs, targs)
              1
            }
          }
        }
      }
    }
  } }
}

-- Walk an expression tree trying ctor instantiation inference against
-- the expected type. is_result = 1 means the current node's value flows
-- to the expected type (block tails, if branches, match arm bodies, let
-- bodies); statement positions recurse with is_result = 0 purely to
-- reach `return` values, which are always result positions. Env is
-- threaded through let/pattern bindings the same way check_return_values
-- threads it. Returns 1 if any node was rewritten.
pub(package) fn infer_generic_ctor_walk(node: i64, target_ty: i64, env: i64, ft: i64, src: i64, tt: i64, is_result: i64) -> i64 {
  if node == 0 or target_ty == 0 { 0 }
  else { if type_is_unknown_or_any(target_ty) { 0 }
  else {
    let tag = node_tag(node)
    if tag == 2 or tag == 4 {
      if is_result == 1 { try_infer_ctor_from_expected(node, target_ty, env, ft, src, tt) } else { 0 }
    }
    else { if tag == 25 {
      infer_generic_ctor_walk(node_f1(node), target_ty, env, ft, src, tt, 1)
    }
    else { if tag == 7 {
      let rest = node_f2(node)
      if rest == 0 { infer_generic_ctor_walk(node_f1(node), target_ty, env, ft, src, tt, is_result) }
      else {
        let a = infer_generic_ctor_walk(node_f1(node), target_ty, env, ft, src, tt, 0)
        let b = infer_generic_ctor_walk(rest, target_ty, env, ft, src, tt, is_result)
        if a == 1 or b == 1 { 1 } else { 0 }
      }
    }
    else { if tag == 5 {
      let c = infer_generic_ctor_walk(node_f1(node), target_ty, env, ft, src, tt, 0)
      let a = infer_generic_ctor_walk(node_f2(node), target_ty, env, ft, src, tt, is_result)
      let b = infer_generic_ctor_walk(node_f3(node), target_ty, env, ft, src, tt, is_result)
      if a == 1 or b == 1 or c == 1 { 1 } else { 0 }
    }
    else { if tag == 15 {
      let scr_ty = synth(node_f1(node), env, ft, src, tt)
      let arms = node_f2(node)
      let n_arms = node_f3(node)
      let mut any = infer_generic_ctor_walk(node_f1(node), target_ty, env, ft, src, tt, 0)
      for i in 0..n_arms {
        let arm = nlist_get(arms, i)
        let arm_env = bind_match_pattern(node_f1(arm), env, src, scr_ty, tt)
        if infer_generic_ctor_walk(node_f2(arm), target_ty, arm_env, ft, src, tt, is_result) == 1 { any = 1 } else { 0 }
      }
      any
    }
    else { if tag == 6 or tag == 11 {
      let a = infer_generic_ctor_walk(node_f3(node), target_ty, env, ft, src, tt, 0)
      let val_ty = synth(node_f3(node), env, ft, src, tt)
      let new_env = if tag == 11 { tenv_bind_mut(env, src, node_f1(node), node_f2(node), val_ty) }
        else { tenv_bind(env, src, node_f1(node), node_f2(node), val_ty) }
      let b = infer_generic_ctor_walk(node_f4(node), target_ty, new_env, ft, src, tt, is_result)
      if a == 1 or b == 1 { 1 } else { 0 }
    }
    else { if tag == 37 {
      let inner = node_f1(node)
      let ann_ty = node_f2(node)
      let a = infer_generic_ctor_walk(node_f3(inner), target_ty, env, ft, src, tt, 0)
      let new_env = if node_tag(inner) == 11 { tenv_bind_mut(env, src, node_f1(inner), node_f2(inner), ann_ty) }
        else { tenv_bind(env, src, node_f1(inner), node_f2(inner), ann_ty) }
      let b = infer_generic_ctor_walk(node_f4(inner), target_ty, new_env, ft, src, tt, is_result)
      if a == 1 or b == 1 { 1 } else { 0 }
    }
    else { if tag == 10 {
      let a = infer_generic_ctor_walk(node_f1(node), target_ty, env, ft, src, tt, 0)
      let b = infer_generic_ctor_walk(node_f2(node), target_ty, env, ft, src, tt, 0)
      if a == 1 or b == 1 { 1 } else { 0 }
    }
    else { if tag == 33 {
      infer_generic_ctor_walk(node_f1(node), target_ty, env, ft, src, tt, is_result)
    }
    else { if tag == 52 {
      infer_generic_ctor_walk(node_f2(node), target_ty, env, ft, src, tt, is_result)
    }
    else { 0 } } } } } } } } } }
  } }
}

pub(package) fn infer_generic_ctor_result(node: i64, target_ty: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  infer_generic_ctor_walk(node, target_ty, env, ft, src, tt, 1)
}

pub(package) fn check_generic_type_arg_count(tparams: i64, type_args: i64, src: i64, ns: i64) -[Diagnose]> i64 {
  if tparams == 0 { 0 }
  else {
    let n_tparams = nlist_len(tparams)
    let n_targs = nlist_len(type_args)
    if n_tparams != n_targs {
      typeck_error_maybe(src, ns, "type error: wrong number of type arguments")
      1
    } else { 0 }
  }
}

pub(package) fn ttable_variant_name_is_cons(entry_src: i64, v_ns: i64, v_nl: i64) -> i64 {
  if v_nl == 4 {
    mem_load8_at(entry_src, v_ns) == 67 and
    mem_load8_at(entry_src, v_ns + 1) == 111 and
    mem_load8_at(entry_src, v_ns + 2) == 110 and
    mem_load8_at(entry_src, v_ns + 3) == 115
  } else { false }
}

pub(package) fn ttable_variant_name_is_nil(entry_src: i64, v_ns: i64, v_nl: i64) -> i64 {
  if v_nl == 3 {
    mem_load8_at(entry_src, v_ns) == 78 and
    mem_load8_at(entry_src, v_ns + 1) == 105 and
    mem_load8_at(entry_src, v_ns + 2) == 108
  } else { false }
}

pub(package) fn typeck_into_iterator_trait_hash() -> i64 {
  effect_name_hash(__str_ptr("IntoIterator"), 0, __str_len("IntoIterator"))
}

pub(package) fn typeck_into_iter_method_hash() -> i64 {
  effect_name_hash(__str_ptr("into_iter"), 0, __str_len("into_iter"))
}

pub(package) fn typeck_iterator_type_hash() -> i64 {
  effect_name_hash(__str_ptr("Iterator"), 0, __str_len("Iterator"))
}

-- Ownership qualifiers describe how the iterable value moves; protocol
-- lookup and item projection operate on its underlying semantic type.
pub(package) fn for_iter_collection_value_type(collection_ty: i64) -> i64 {
  if ty_is_owned(collection_ty) { for_iter_collection_value_type(ty_owned_inner(collection_ty)) }
  else { if ty_is_unique(collection_ty) { for_iter_collection_value_type(ty_unique_inner(collection_ty)) }
  else { if ty_is_borrow(collection_ty) { for_iter_collection_value_type(ty_borrow_inner(collection_ty)) }
  else { collection_ty } } }
}

pub(package) fn for_iter_iterator_item_type(collection_ty: i64) -> i64 {
  let value_ty = for_iter_collection_value_type(collection_ty)
  if value_ty == 0 or ty_tag(value_ty) != 9 or ty_f1(value_ty) != typeck_iterator_type_hash() { 0 }
  else {
    let args = ty_f3(value_ty)
    if args == 0 or nlist_len(args) == 0 { 0 } else { nlist_get(args, 0) }
  }
}

pub(package) fn for_iter_item_type_from_collection(tt: i64, collection_ty: i64) -> i64 {
  let value_ty = for_iter_collection_value_type(collection_ty)
  if ty_is_array(value_ty) { ty_array_inner(value_ty) }
  else { if ty_is_slice(value_ty) { ty_slice_inner(value_ty) }
  else { if for_iter_iterator_item_type(value_ty) != 0 { for_iter_iterator_item_type(value_ty) }
  else { if tt == 0 { ty_i64() }
  else { if ty_tag(value_ty) != 9 { ty_i64() }
  else {
    let type_hash = ty_f1(value_ty)
    let type_args = ty_f3(value_ty)
    let n = mem_load64_at(tt, 8)
    let d = mem_load64_at(tt, 0)
    let mut ti = 0
    let mut result = ty_i64()
    while ti < n {
      let kind = mem_load64_at(d, ti * 64 + 16)
      if kind == 1 {
        let entry_src = mem_load64_at(d, ti * 64 + 48)
        let type_ns = mem_load64_at(d, ti * 64)
        let type_nl = mem_load64_at(d, ti * 64 + 8)
        if mem_load64_at(d, ti * 64 + 56) == type_hash {
          let nvariants = mem_load64_at(d, ti * 64 + 24)
          let variants = mem_load64_at(d, ti * 64 + 32)
          let tparams = mem_load64_at(d, ti * 64 + 40)
          let mut vi = 0
          while vi < nvariants {
            let v_ns = mem_load64_at(variants, vi * 40)
            let v_nl = mem_load64_at(variants, vi * 40 + 8)
            if ttable_variant_name_is_cons(entry_src, v_ns, v_nl) == 1 {
              let npayloads = mem_load64_at(variants, vi * 40 + 24)
              let payloads = mem_load64_at(variants, vi * 40 + 32)
              if npayloads > 0 {
                let pty = if payloads != 0 { nlist_get(payloads, 0) } else { ty_i64() }
                if tparams != 0 {
                  if type_args != 0 { result = ty_subst(pty, build_subst(tparams, type_args)) }
                  else { result = pty }
                } else { result = pty }
              } else { result = ty_i64() }
              vi = nvariants
              ti = n
            } else { vi = vi + 1 }
          }
          if ti < n { ti = ti + 1 } else { ti = ti }
        } else { ti = ti + 1 }
      } else { ti = ti + 1 }
    }
    result
  } } } } }
}

pub(package) fn for_iter_collection_has_list_shape(tt: i64, collection_ty: i64) -> i64 {
  let value_ty = for_iter_collection_value_type(collection_ty)
  if type_is_unknown_or_any(value_ty) { 1 }
  else { if tt == 0 { 1 }
  else { if ty_tag(value_ty) != 9 { 0 }
  else {
    let type_hash = ty_f1(value_ty)
    let n = mem_load64_at(tt, 8)
    let d = mem_load64_at(tt, 0)
    let mut ti = 0
    let mut found_cons = 0
    let mut found_nil = 0
    while ti < n {
      let kind = mem_load64_at(d, ti * 64 + 16)
      if kind == 1 {
        let entry_src = mem_load64_at(d, ti * 64 + 48)
        let type_ns = mem_load64_at(d, ti * 64)
        let type_nl = mem_load64_at(d, ti * 64 + 8)
        if mem_load64_at(d, ti * 64 + 56) == type_hash {
          let nvariants = mem_load64_at(d, ti * 64 + 24)
          let variants = mem_load64_at(d, ti * 64 + 32)
          let mut vi = 0
          while vi < nvariants {
            let v_ns = mem_load64_at(variants, vi * 40)
            let v_nl = mem_load64_at(variants, vi * 40 + 8)
            if ttable_variant_name_is_cons(entry_src, v_ns, v_nl) == 1 { found_cons = 1 } else { found_cons = found_cons }
            if ttable_variant_name_is_nil(entry_src, v_ns, v_nl) == 1 { found_nil = 1 } else { found_nil = found_nil }
            vi = vi + 1
          }
          ti = n
        } else { ti = ti + 1 }
      } else { ti = ti + 1 }
    }
    found_cons == 1 and found_nil == 1
  } } }
}

pub(package) fn for_iter_item_type(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  for_iter_item_type_from_collection(tt, synth(node_f3(node), env, ft, src, tt))
}

pub(package) fn for_iter_collection_conforms_into_iterator(tt: i64, collection_ty: i64) -> i64 {
  let value_ty = for_iter_collection_value_type(collection_ty)
  if value_ty == 0 { 0 }
  else { if ty_tag(value_ty) == 12 {
    let atom = typevar_method_bound_atom(tt, ty_var_id(value_ty), typeck_into_iter_method_hash())
    if atom != 0 and trait_atom_head(atom) == typeck_into_iterator_trait_hash() { 1 } else { 0 }
  } else {
    let ct = ttable_get_ct(tt)
    if ct == 0 { 0 } else { ctable_conforms_type(ct, collection_ty, typeck_into_iterator_trait_hash()) }
  } }
}

-- Checker-owned elaboration fact for general `for`: replace only the
-- collection operand with the resolved protocol call. The loop itself stays
-- structural IR, while method selection and generic specialisation consume
-- the same MethodRef fact as an explicit `.into_iter()` call.
pub(package) fn for_iter_rewrite_into_iterator(node: i64, collection_ty: i64, tt: i64) -> i64 {
  let value_ty = for_iter_collection_value_type(collection_ty)
  let method_hash = typeck_into_iter_method_hash()
  let owner_hash = if ty_tag(value_ty) == 12 { 0 } else { type_hash_of(value_ty) }
  let resolution = if owner_hash == 0 { 0 } else { ttable_resolve_method(tt, collection_ty, owner_hash, method_hash) }
  let method_ref = method_ref_with_declaration(method_ref_new(
    owner_hash,
    collection_ty,
    if resolution == 0 { 0 } else { method_resolution_ref_type_args(resolution, collection_ty) },
    if resolution != 0 and method_resolution_tparams(resolution) != 0 { 1 } else { 0 }
  ), if resolution == 0 { 0 } else { method_resolution_declaration(resolution) })
  let call = node_new(41, node_f3(node), method_hash, nlist_new(), method_ref)
  mem_store64_at(node, 24, call)
  0
}

pub(package) fn check_for_iter_collection(node: i64, env: i64, ft: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  let collection = node_f3(node)
  let collection_ty = synth(collection, env, ft, src, tt)
  let value_ty = for_iter_collection_value_type(collection_ty)
  if ty_is_array(value_ty) or ty_is_slice(value_ty) or
    for_iter_iterator_item_type(collection_ty) != 0 or
    for_iter_collection_has_list_shape(tt, collection_ty) == 1 {
    0
  } else { if for_iter_collection_conforms_into_iterator(tt, collection_ty) == 1 {
    for_iter_rewrite_into_iterator(node, collection_ty, tt)
  } else {
    let pos = if node_tag(collection) == 2 { node_f1(collection) } else { node_f1(node) }
    typeck_error_maybe(src, pos, "type error: for iterator requires an array, slice, Cons/Nil list, or IntoIterator")
    1
  } }
}

pub(package) fn synth_if(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  -- Branches synth under the guard-narrowed env so
  -- `if x != nil { x } else { fallback }` reads T, not T | nil.
  let then_ty = synth(node_f2(node), tenv_narrow_guard(env, node_f1(node), 6, src), ft, src, tt)
  let else_node = node_f3(node)
  if else_node == 0 { ty_nil() }
  else {
    let else_ty = synth(else_node, tenv_narrow_guard(env, node_f1(node), 5, src), ft, src, tt)
    -- If both branches have the same type, use it
    if ty_eq(then_ty, else_ty) { then_ty }
    else { ty_union(then_ty, else_ty) }
  }
}

pub(package) fn synth_let(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let ns = node_f1(node)
  let nl = node_f2(node)
  let val = node_f3(node)
  let body = node_f4(node)
  let val_ty = synth(val, env, ft, src, tt)
  let new_env = tenv_bind(env, src, ns, nl, val_ty)
  synth(body, new_env, ft, src, tt)
}

pub(package) fn synth_let_mut(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let ns = node_f1(node)
  let nl = node_f2(node)
  let val = node_f3(node)
  let body = node_f4(node)
  let val_ty = synth(val, env, ft, src, tt)
  let new_env = tenv_bind_mut(env, src, ns, nl, val_ty)
  synth(body, new_env, ft, src, tt)
}

-- LetTyped: tag 37 wraps inner let (tag 6 or 11) with annotation type
pub(package) fn synth_let_typed(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let inner = node_f1(node)
  let ann_ty = node_f2(node)
  let val = node_f3(inner)
  let body = node_f4(inner)
  let ns = node_f1(inner)
  let nl = node_f2(inner)
  let _val_ty = synth(val, env, ft, src, tt)
  let new_env = if node_tag(inner) == 11 {
    tenv_bind_mut(env, src, ns, nl, ann_ty)
  } else {
    tenv_bind(env, src, ns, nl, ann_ty)
  }
  synth(body, new_env, ft, src, tt)
}

-- Resolve an identifier in expression position as one of the current
-- function's type parameters. This is deliberately separate from the value
-- environment: `T.default()` is a type-qualified associated call, while
-- `value.default()` remains an ordinary receiver call.
pub(package) fn typeck_tparam_type_by_name(tt: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let tparams = ttable_get_tparams(tt)
  if tparams == 0 { 0 }
  else {
    let mut result = 0
    let mut i = 0
    while i < nlist_len(tparams) and result == 0 {
      let tp = nlist_get(tparams, i)
      if node_f2(tp) == nl and src_eq_at(src, ns, src + node_f1(tp), 0, nl) == 1 {
        result = ty_var(node_f3(tp))
        i = nlist_len(tparams)
      } else { i = i + 1 }
    }
    result
  }
}

pub(package) fn synth_associated_method_call(node: i64, target_ty: i64, src: i64, tt: i64) -> i64 {
  let type_pos = node_f1(node_f1(node))
  let type_len = node_f2(node_f1(node))
  let method_hash = effect_name_hash(src, node_f2(node), node_f3(node))
  let args = node_f4(node)
  -- Method lowering has one receiver-shaped value slot. Associated methods
  -- do not expose it in their signature; a dead i64 value keeps the existing
  -- dispatch ABI and is ignored by the zero-parameter implementation.
  let dead_receiver = node_new(1, 0, type_pos, type_len, 0)
  mem_store64_at(node, 0, 41)
  mem_store64_at(node, 8, dead_receiver)
  mem_store64_at(node, 16, method_hash)
  mem_store64_at(node, 24, args)
  let owner_hash = if ty_tag(target_ty) == 9 { ty_f1(target_ty) } else { 0 }
  let resolution = if owner_hash == 0 { 0 } else { ttable_resolve_method(tt, target_ty, owner_hash, method_hash) }
  let method_ref = if resolution == 0 { method_ref_new_associated(owner_hash, target_ty, if ty_tag(target_ty) == 9 { ty_f3(target_ty) } else { 0 }, 0) }
    else { method_ref_with_declaration(method_ref_new_associated(
      owner_hash,
      target_ty,
      method_resolution_ref_type_args(resolution, target_ty),
      if method_resolution_tparams(resolution) != 0 { 1 } else { 0 }
    ), method_resolution_declaration(resolution)) }
  mem_store64_at(node, 32, method_ref)
  synth_resolved_method_call(node, tt)
}

pub(package) fn typeck_variant_entry_is_payloadless(entry: i64) -> i64 {
  if entry == 0 or mem_load64_at(entry, 16) != 1 { 0 }
  else {
    let count = mem_load64_at(entry, 24)
    let variants = mem_load64_at(entry, 32)
    let mut payloadless = if count > 0 { 1 } else { 0 }
    let mut i = 0
    while i < count and payloadless == 1 {
      if mem_load64_at(variants, i * 40 + 24) == 0 { i = i + 1 }
      else { payloadless = 0 }
    }
    payloadless
  }
}

pub(package) fn typeck_named_type_from_declaration(tt: i64, declaration: i64, type_args: i64) -> i64 {
  let entry = if declaration == 0 { 0 } else { ttable_lookup_decl_fact(tt, declaration) }
  if entry == 0 { 0 }
  else {
    let kind = mem_load64_at(entry, 16)
    if kind == 0 or kind == 1 {
      if kind == 1 and typeck_variant_entry_is_payloadless(entry) == 1 {
        ty_named_with_metadata(mem_load64_at(entry, 56), ty_i64(), type_args, ty_named_payloadless_variant_meta(declaration))
      } else {
        if type_args == 0 { ty_named(mem_load64_at(entry, 56), ty_i64()) }
        else { ty_named_app(mem_load64_at(entry, 56), ty_i64(), type_args) }
      }
    } else { if kind == 5 {
      let raw = ttable_entry_opaque_representation(entry)
      let tparams = mem_load64_at(entry, 40)
      let representation = if tparams != 0 and type_args != 0 { ty_subst(raw, type_cycle_subst_for_entry(entry, type_args)) } else { raw }
      ty_named_with_metadata(mem_load64_at(entry, 56), representation, type_args, ty_named_opaque_meta(declaration))
    } else { 0 }
    }
  }
}

-- Resolve the neutral left side of `Type.method()` after lexical values and
-- module-value calls have had priority. The returned nominal type derives
-- from the producer-owned type declaration; the nested access retains that
-- declaration fact so no later phase must reconstruct module ownership.
pub(package) fn typeck_associated_target_type(lhs: i64, env: i64, src: i64, tt: i64) -> i64 {
  if node_tag(lhs) == 2 {
    if tenv_lookup(env, src, node_f1(lhs), node_f2(lhs)) != 0 { 0 }
    else {
      let tparam = typeck_tparam_type_by_name(tt, src, node_f1(lhs), node_f2(lhs))
      if tparam != 0 { tparam }
      else {
        let declaration = module_scope_lookup_declaration(tt, src, module_decl_namespace_type(), src, node_f1(lhs), node_f2(lhs))
        typeck_named_type_from_declaration(tt, declaration, 0)
      }
    }
  } else { if node_tag(lhs) == 13 {
    let base = node_f1(lhs)
    if node_tag(base) != 2 or tenv_lookup(env, src, node_f1(base), node_f2(base)) != 0 { 0 }
    else {
      let surface_meta = node_f4(lhs)
      let type_args = if surface_meta != 0 and node_tag(surface_meta) == 3 { node_f2(surface_meta) } else { 0 }
      let declaration = module_scope_lookup_qualified_declaration(
        tt, src, src, node_f1(base), node_f2(base), module_decl_namespace_type(), src, node_f2(lhs), node_f3(lhs)
      )
      if declaration != 0 { mem_store64_at(lhs, 32, typeck_declaration_access_fact(declaration)) } else { 0 }
      typeck_named_type_from_declaration(tt, declaration, type_args)
    }
  } else { 0 } }
}

pub(package) fn typeck_named_type_has_constructor(tt: i64, target_ty: i64, name_src: i64, name_start: i64, name_len: i64) -> i64 {
  let entry = if target_ty == 0 or ty_tag(target_ty) != 9 { 0 } else { type_cycle_entry_for_hash(tt, ty_f1(target_ty)) }
  if entry == 0 or mem_load64_at(entry, 16) != 1 { 0 }
  else {
    let variants = mem_load64_at(entry, 32)
    let count = mem_load64_at(entry, 24)
    let entry_src = mem_load64_at(entry, 48)
    let mut found = 0
    let mut i = 0
    while i < count and found == 0 {
      let variant = variants + i * 40
      if mem_load64_at(variant + 8, 0) == name_len and src_eq_at(entry_src, mem_load64_at(variant, 0), name_src + name_start, 0, name_len) == 1 { found = 1 }
      else { i = i + 1 }
    }
    found
  }
}

pub(package) fn typeck_named_app_one(tt: i64, name: str, arg: i64) -> i64 {
  let entry = ttable_lookup(tt, __str_ptr(name), 0, __str_len(name))
  if entry == 0 { ty_any() }
  else {
    let args = nlist_new_capacity(1)
    nlist_add(args, arg)
    ty_named_app(mem_load64_at(entry, 56), ty_i64(), args)
  }
}

pub(package) fn typeck_dot_name_is(node: i64, src: i64, name: str) -> i64 {
  src_eq(src, node_f2(node), node_f3(node), name)
}

-- Phase-E conversion surface is method-shaped, but its semantic fact is an
-- ordinary explicit generic call. `to_vector<T>` is a real pure stdlib copy
-- helper. `to_array<T, [T; N]>` is a checked compiler intrinsic whose second
-- type argument carries the exact result layout; lowering never reparses the
-- source spelling or the const argument.
pub(package) fn synth_indexed_conversion_dot_call(node: i64, recv_ty: i64, src: i64, tt: i64) -> i64 {
  let surface_args = node_f4(node)
  let nargs = if surface_args == 0 { 0 } else { nlist_len(surface_args) }
  if typeck_dot_name_is(node, src, "to_vector") == 1 and nargs == 0 and (ty_is_array(recv_ty) or ty_is_slice(recv_ty)) {
    let element_ty = if ty_is_array(recv_ty) { ty_array_inner(recv_ty) } else { ty_slice_inner(recv_ty) }
    let receiver = node_f1(node)
    let needs_view = if ty_is_array(recv_ty) { 1 } else { ty_slice_mutable(recv_ty) }
    let source = if needs_view == 1 {
      let fixed_len = if ty_is_array(recv_ty) { ty_array_length(recv_ty) } else { 0 - 1 }
      node_new(62, receiver, node_new(51, 0, 0, 0, 0), node_new(51, 0, 0, 0, 0), node_new(0, element_ty, fixed_len, recv_ty, 0))
    } else { receiver }
    let call_args = nlist_new_capacity(1)
    nlist_add(call_args, source)
    let type_args = nlist_new_capacity(1)
    nlist_add(type_args, element_ty)
    let inner = node_new(4, node_f2(node), node_f3(node), call_args, 1)
    mem_store64_at(node, 0, 36)
    mem_store64_at(node, 8, type_args)
    mem_store64_at(node, 16, inner)
    mem_store64_at(node, 24, 1)
    mem_store64_at(node, 32, 0)
    typeck_named_app_one(tt, "Vector", element_ty)
  } else { if typeck_dot_name_is(node, src, "to_array") == 1 and typeck_type_is_vector(tt, recv_ty) == 1 and nargs == 1 {
    let length_arg = nlist_get(surface_args, 0)
    if node_tag(length_arg) != 1 or node_f3(length_arg) >= 0 { 0 }
    else {
      let element_ty = typeck_vector_element_type(recv_ty)
      let array_ty = ty_array(element_ty, node_f1(length_arg))
      let call_args = nlist_new_capacity(1)
      nlist_add(call_args, node_f1(node))
      let type_args = nlist_new_capacity(2)
      nlist_add(type_args, element_ty)
      nlist_add(type_args, array_ty)
      let inner = node_new(4, node_f2(node), node_f3(node), call_args, 1)
      mem_store64_at(node, 0, 36)
      mem_store64_at(node, 8, type_args)
      mem_store64_at(node, 16, inner)
      mem_store64_at(node, 24, 2)
      mem_store64_at(node, 32, 0)
      typeck_named_app_one(tt, "Option", array_ty)
    }
  } else { 0 } }
}

pub(package) fn synth_dot_call(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let lhs = node_f1(node)
  let effect_decl = typeck_resolve_effect_ref(lhs, env, src, tt)
  let resolved_entry = typeck_qualified_member_entry(node, env, ft, src, tt)
  if resolved_entry != 0 {
    let inferred = synth_qualified_call_infer_generic(node, resolved_entry, env, ft, src, tt)
    if inferred != 0 { inferred }
    else {
      let ret_ty = ftypes_entry_return_type(resolved_entry)
      if ret_ty == 0 { ty_any() } else { ret_ty }
    }
  } else {
    -- Preserve the kernel's Type.Variant(...) prohibition. A variant type is
    -- a valid associated-method qualifier only when the selected spelling is
    -- actually a method; its own constructor spellings remain bare values.
    let candidate_associated_target = typeck_associated_target_type(lhs, env, src, tt)
    let associated_target = if typeck_named_type_has_constructor(tt, candidate_associated_target, src, node_f2(node), node_f3(node)) == 1 { 0 }
      else { candidate_associated_target }
    if associated_target != 0 {
      synth_associated_method_call(node, associated_target, src, tt)
    } else { if node_tag(lhs) == 2 {
    let ns = node_f1(lhs)
    let nl = node_f2(lhs)
    let var_ty = tenv_lookup(env, src, ns, nl)
    if var_ty == 0 {
      -- Not a lexical value, module binding, type parameter, or named type:
      -- the final neutral-dot interpretation is an effect operation.
      synth_effect_perform(node, src, tt)
    } else {
      -- In type env → method call. Resolve receiver type.
      let conversion = synth_indexed_conversion_dot_call(node, var_ty, src, tt)
      if conversion != 0 { conversion } else { synth_method_call(node, var_ty, env, ft, src, tt) }
    }
  } else { if effect_decl != 0 or typeck_is_effect_ref(lhs, src, tt) {
    -- A parameterized effect atom such as `Box<i64>` is itself a complex
    -- expression node. Preserve qualified-effect identity before attempting
    -- ordinary receiver-method synthesis.
    synth_effect_perform(node, src, tt)
  } else {
    -- Complex expression as receiver: synth type, then resolve method
    let recv_ty = synth(lhs, env, ft, src, tt)
    let conversion = synth_indexed_conversion_dot_call(node, recv_ty, src, tt)
    if conversion != 0 { conversion } else { synth_method_call(node, recv_ty, env, ft, src, tt) }
  } } } } }
}

pub(package) fn effect_op_ret_type(op: i64) -> i64 {
  let meta = node_f4(op)
  if meta == 0 { 0 }
  else {
    if node_tag(meta) == 53 { node_f1(meta) } else { meta }
  }
}

pub(package) fn effect_op_is_deferred(op: i64) -> i64 {
  let meta = node_f4(op)
  if meta == 0 { 0 }
  else {
    if node_tag(meta) == 53 { node_f2(meta) } else { 0 }
  }
}

pub(package) fn type_list_single(ty: i64) -> i64 {
  let params = nlist_new()
  nlist_add(params, ty)
  params
}

pub(package) fn continuation_fn_type(value_ty: i64, result_ty: i64) -> i64 {
  ty_continuation(value_ty, result_ty)
}

pub(package) fn same_source_name(src: i64, a_ns: i64, a_nl: i64, b_ns: i64, b_nl: i64) -> bool {
  if a_nl != b_nl { false }
  else { src_eq_at(src, a_ns, src + b_ns, 0, a_nl) }
}

pub(package) fn continuation_name_matches(cont: i64, src: i64, ns: i64, nl: i64) -> bool {
  if cont == 0 { false }
  else { same_source_name(src, ns, nl, node_f1(cont), node_f2(cont)) }
}

pub(package) fn continuation_call_matches(node: i64, cont: i64, src: i64) -> i64 {
  if node_tag(node) == 4 {
    continuation_name_matches(cont, src, node_f1(node), node_f2(node))
  } else { 0 }
}

pub(package) fn continuation_count_max(left: i64, right: i64) -> i64 {
  if left > right { left } else { right }
}

pub(package) fn record_field_expr_nodes(fields: i64, nfields: i64) -> i64 {
  let values = nlist_new()
  for i in 0..nfields {
    nlist_add(values, node_f3(nlist_get(fields, i)))
  }
  values
}

pub(package) fn continuation_ref_count_list(list: i64, n: i64, cont: i64, src: i64) -> i64 {
  let mut count = 0
  for i in 0..n {
    count = count + continuation_ref_count(nlist_get(list, i), cont, src)
  }
  count
}

pub(package) fn continuation_ref_count(node: i64, cont: i64, src: i64) -> i64 {
  if node == 0 { 0 }
  else {
    match node_tag(node) {
      2 -> continuation_name_matches(cont, src, node_f1(node), node_f2(node))
      3 -> continuation_ref_count(node_f2(node), cont, src) + continuation_ref_count(node_f3(node), cont, src)
      4 -> continuation_call_matches(node, cont, src) + continuation_ref_count_list(node_f3(node), node_f4(node), cont, src)
      5 -> continuation_ref_count(node_f1(node), cont, src) + continuation_ref_count(node_f2(node), cont, src) + continuation_ref_count(node_f3(node), cont, src)
      6 -> {
        let alias = continuation_alias_from_let(node, cont, src, 0)
        if alias != 0 {
          continuation_ref_count(node_f4(node), alias, src) + continuation_ref_count(node_f4(node), cont, src)
        } else {
          continuation_ref_count(node_f3(node), cont, src) + continuation_ref_count(node_f4(node), cont, src)
        }
      }
      7 -> continuation_ref_count(node_f1(node), cont, src) + continuation_ref_count(node_f2(node), cont, src)
      10 -> continuation_ref_count(node_f1(node), cont, src) + continuation_ref_count(node_f2(node), cont, src)
      11 -> continuation_ref_count(node_f3(node), cont, src) + continuation_ref_count(node_f4(node), cont, src)
      12 -> continuation_ref_count(node_f3(node), cont, src)
      57 -> continuation_ref_count(node_f1(node), cont, src) + continuation_ref_count(node_f2(node), cont, src)
      13 -> continuation_ref_count(node_f1(node), cont, src)
      59 -> continuation_ref_count(node_f1(node), cont, src)
      60 -> continuation_ref_count(node_f1(node), cont, src) + continuation_ref_count(node_f2(node), cont, src)
      61 -> continuation_ref_count(node_f1(node), cont, src) + continuation_ref_count(node_f2(node), cont, src) + continuation_ref_count(node_f3(node), cont, src)
      62 -> continuation_ref_count(node_f1(node), cont, src) + continuation_ref_count(node_f2(node), cont, src) + continuation_ref_count(node_f3(node), cont, src)
      14 -> {
        let fields = node_f3(node)
        let nfields = node_f4(node)
        let mut count = 0
        for ri in 0..nfields {
          count = count + continuation_ref_count(node_f3(nlist_get(fields, ri)), cont, src)
        }
        count
      }
      63 -> continuation_ref_count(node_f1(node), cont, src) + continuation_ref_count_list(record_field_expr_nodes(node_f2(node), node_f3(node)), node_f3(node), cont, src)
      58 -> continuation_ref_count_list(node_f1(node), node_f2(node), cont, src)
      15 -> {
        let arms = node_f2(node)
        let n = node_f3(node)
        let mut count = continuation_ref_count(node_f1(node), cont, src)
        for i in 0..n {
          let arm = nlist_get(arms, i)
          let guard = node_f3(arm)
          if guard != 0 { count = count + continuation_ref_count(guard, cont, src) } else { count = count }
          count = count + continuation_ref_count(node_f2(arm), cont, src)
        }
        count
      }
      22 -> continuation_ref_count(node_f1(node), cont, src)
      25 -> continuation_ref_count(node_f1(node), cont, src)
      26 -> continuation_ref_count(node_f1(node), cont, src)
      29 -> continuation_ref_count(node_f2(node), cont, src)
      32 -> continuation_ref_count(node_f1(node), cont, src) + continuation_ref_count_list(node_f4(node), nlist_len(node_f4(node)), cont, src)
      33 -> continuation_ref_count(node_f1(node), cont, src)
      35 -> continuation_ref_count(node_f1(node), cont, src)
      36 -> {
        let call_node = node_f2(node)
        continuation_ref_count_list(generic_call_inner_args(call_node), generic_call_inner_arg_count(call_node), cont, src)
      }
      37 -> continuation_ref_count(node_f1(node), cont, src)
      41 -> continuation_ref_count(node_f1(node), cont, src) + continuation_ref_count_list(node_f3(node), nlist_len(node_f3(node)), cont, src)
      45 -> continuation_ref_count(node_f1(node), cont, src)
      46 -> continuation_ref_count(node_f1(node), cont, src) + continuation_ref_count(node_f2(node), cont, src)
      47 -> continuation_ref_count(node_f3(node), cont, src) + continuation_ref_count(node_f4(node), cont, src)
      48 -> continuation_ref_count(node_f1(node), cont, src)
      49 -> continuation_ref_count(node_f1(node), cont, src)
      52 -> continuation_ref_count(node_f1(node), cont, src) + continuation_ref_count(node_f2(node), cont, src)
      _ -> 0
    }
  }
}

pub(package) fn continuation_call_count(node: i64, cont: i64, src: i64, ft: i64) -> i64 {
  if node == 0 { 0 }
  else {
    match node_tag(node) {
      3 -> continuation_call_count(node_f2(node), cont, src, ft) + continuation_call_count(node_f3(node), cont, src, ft)
      4 -> continuation_call_matches(node, cont, src) + continuation_call_arg_count_list(node_f3(node), node_f4(node), cont, src, ft)
      5 -> {
        let cond_count = continuation_call_count(node_f1(node), cont, src, ft)
        let then_count = continuation_call_count(node_f2(node), cont, src, ft)
        let else_count = continuation_call_count(node_f3(node), cont, src, ft)
        cond_count + continuation_count_max(then_count, else_count)
      }
      6 -> {
        let alias = continuation_alias_from_let(node, cont, src, ft)
        if alias != 0 {
          continuation_call_count(node_f4(node), alias, src, ft) + continuation_call_count(node_f4(node), cont, src, ft)
        } else {
          continuation_call_count(node_f3(node), cont, src, ft) + continuation_call_count(node_f4(node), cont, src, ft)
        }
      }
      7 -> continuation_call_count(node_f1(node), cont, src, ft) + continuation_call_count(node_f2(node), cont, src, ft)
      10 -> continuation_call_count(node_f1(node), cont, src, ft) + continuation_call_count(node_f2(node), cont, src, ft)
      11 -> continuation_call_count(node_f3(node), cont, src, ft) + continuation_call_count(node_f4(node), cont, src, ft)
      12 -> continuation_call_count(node_f3(node), cont, src, ft)
      57 -> continuation_call_count(node_f1(node), cont, src, ft) + continuation_call_count(node_f2(node), cont, src, ft)
      13 -> continuation_call_count(node_f1(node), cont, src, ft)
      59 -> continuation_call_count(node_f1(node), cont, src, ft)
      60 -> continuation_call_count(node_f1(node), cont, src, ft) + continuation_call_count(node_f2(node), cont, src, ft)
      61 -> continuation_call_count(node_f1(node), cont, src, ft) + continuation_call_count(node_f2(node), cont, src, ft) + continuation_call_count(node_f3(node), cont, src, ft)
      62 -> continuation_call_count(node_f1(node), cont, src, ft) + continuation_call_count(node_f2(node), cont, src, ft) + continuation_call_count(node_f3(node), cont, src, ft)
      14 -> {
        let fields = node_f3(node)
        let nfields = node_f4(node)
        let mut count = 0
        for ri in 0..nfields {
          count = count + continuation_call_count(node_f3(nlist_get(fields, ri)), cont, src, ft)
        }
        count
      }
      63 -> continuation_call_count(node_f1(node), cont, src, ft) + continuation_call_count_list(record_field_expr_nodes(node_f2(node), node_f3(node)), node_f3(node), cont, src, ft)
      58 -> continuation_call_count_list(node_f1(node), node_f2(node), cont, src, ft)
      15 -> {
        let arms = node_f2(node)
        let n = node_f3(node)
        let mut count = continuation_call_count(node_f1(node), cont, src, ft)
        for i in 0..n {
          let arm = nlist_get(arms, i)
          let guard = node_f3(arm)
          if guard != 0 { count = count + continuation_call_count(guard, cont, src, ft) } else { count = count }
          count = count + continuation_call_count(node_f2(arm), cont, src, ft)
        }
        count
      }
      22 -> continuation_call_count(node_f1(node), cont, src, ft)
      25 -> continuation_call_count(node_f1(node), cont, src, ft)
      26 -> continuation_call_count(node_f1(node), cont, src, ft)
      29 -> 0
      32 -> continuation_call_count(node_f1(node), cont, src, ft) + continuation_call_arg_count_list(node_f4(node), nlist_len(node_f4(node)), cont, src, ft)
      33 -> continuation_call_count(node_f1(node), cont, src, ft)
      35 -> continuation_call_count(node_f1(node), cont, src, ft)
      36 -> {
        let call_node = node_f2(node)
        continuation_call_arg_count_list(generic_call_inner_args(call_node), generic_call_inner_arg_count(call_node), cont, src, ft)
      }
      37 -> continuation_call_count(node_f1(node), cont, src, ft)
      41 -> continuation_call_count(node_f1(node), cont, src, ft) + continuation_call_arg_count_list(node_f3(node), nlist_len(node_f3(node)), cont, src, ft)
      45 -> continuation_call_count(node_f1(node), cont, src, ft)
      46 -> continuation_call_count(node_f1(node), cont, src, ft) + continuation_call_count(node_f2(node), cont, src, ft)
      47 -> continuation_call_count(node_f3(node), cont, src, ft) + continuation_call_count(node_f4(node), cont, src, ft)
      48 -> continuation_call_count(node_f1(node), cont, src, ft)
      49 -> continuation_call_count(node_f1(node), cont, src, ft)
      52 -> continuation_call_count(node_f1(node), cont, src, ft) + continuation_call_count(node_f2(node), cont, src, ft)
      _ -> 0
    }
  }
}

pub(package) fn continuation_call_count_list(list: i64, n: i64, cont: i64, src: i64, ft: i64) -> i64 {
  let mut count = 0
  for i in 0..n {
    count = count + continuation_call_count(nlist_get(list, i), cont, src, ft)
  }
  count
}

pub(package) fn continuation_call_arg_count_list(list: i64, n: i64, cont: i64, src: i64, ft: i64) -> i64 {
  let mut count = 0
  for i in 0..n {
    let arg = nlist_get(list, i)
    if continuation_direct_ref(arg, cont, src) == 1 {
      count = count + 1
    } else {
      count = count + continuation_call_count(arg, cont, src, ft)
    }
  }
  count
}

pub(package) fn continuation_direct_ref_count_list(list: i64, n: i64, cont: i64, src: i64) -> i64 {
  let mut count = 0
  for i in 0..n {
    if continuation_direct_ref(nlist_get(list, i), cont, src) == 1 {
      count = count + 1
    } else { count = count }
  }
  count
}

pub(package) fn continuation_direct_result(node: i64, cont: i64, src: i64) -> i64 {
  if continuation_direct_ref(node, cont, src) == 1 { 1 }
  else { if node != 0 {
    if node_tag(node) == 25 { continuation_direct_ref(node_f1(node), cont, src) } else { 0 }
  } else { 0 } }
}

pub(package) fn continuation_call_returns_direct_arg(call_node: i64, cont: i64, src: i64, ft: i64) -> i64 {
  if node_tag(call_node) != 4 { 0 }
  else {
    let entry = ftypes_find(ft, src, node_f1(call_node), node_f2(call_node))
    if entry == 0 { 0 }
    else {
      let fn_src = mem_load64_at(entry, 24)
      let ret_ty = mem_load64_at(entry, 16)
      let params = mem_load64_at(entry, 32)
      let body = mem_load64_at(entry, 56)
      if ty_is_continuation(ret_ty) == 0 or params == 0 or body == 0 { 0 }
      else {
        let args = node_f3(call_node)
        let nargs = node_f4(call_node)
        let mut result = 0
        for i in 0..nargs {
          if i < nlist_len(params) {
            let arg = nlist_get(args, i)
            let param = nlist_get(params, i)
            if continuation_direct_ref(arg, cont, src) == 1 and ty_is_continuation(node_f3(param)) == 1 and continuation_direct_result(body, param, fn_src) == 1 {
              result = 1
            } else { result = result }
          } else { result = result }
        }
        result
      }
    }
  }
}

pub(package) fn continuation_value_returns_direct_arg(node: i64, cont: i64, src: i64, ft: i64) -> i64 {
  if node == 0 { 0 }
  else {
    match node_tag(node) {
      4 -> continuation_call_returns_direct_arg(node, cont, src, ft)
      36 -> continuation_call_returns_direct_arg(node_f2(node), cont, src, ft)
      37 -> continuation_value_returns_direct_arg(node_f1(node), cont, src, ft)
      _ -> 0
    }
  }
}

pub(package) fn continuation_tail_call_count(node: i64, cont: i64, src: i64, ft: i64) -> i64 {
  if node == 0 { 0 }
  else {
    match node_tag(node) {
      4 -> continuation_call_matches(node, cont, src) + continuation_direct_ref_count_list(node_f3(node), node_f4(node), cont, src)
      5 -> continuation_tail_call_count(node_f2(node), cont, src, ft) + continuation_tail_call_count(node_f3(node), cont, src, ft)
      6 -> {
        let alias = continuation_alias_from_let(node, cont, src, ft)
        if alias != 0 {
          continuation_tail_call_count(node_f4(node), alias, src, ft) + continuation_tail_call_count(node_f4(node), cont, src, ft)
        } else { continuation_tail_call_count(node_f4(node), cont, src, ft) }
      }
      7 -> continuation_tail_call_count(node_f2(node), cont, src, ft)
      11 -> continuation_tail_call_count(node_f4(node), cont, src, ft)
      15 -> {
        let arms = node_f2(node)
        let n = node_f3(node)
        let mut count = 0
        for i in 0..n {
          count = count + continuation_tail_call_count(node_f2(nlist_get(arms, i)), cont, src, ft)
        }
        count
      }
      37 -> continuation_tail_call_count(node_f1(node), cont, src, ft)
      _ -> 0
    }
  }
}

pub(package) fn continuation_alias_node(ns: i64, nl: i64) -> i64 {
  node_new(0, ns, nl, 0, 0)
}

pub(package) fn continuation_alias_from_let(node: i64, cont: i64, src: i64, ft: i64) -> i64 {
  if node_tag(node) == 37 {
    continuation_alias_from_let(node_f1(node), cont, src, ft)
  } else { if node_tag(node) == 6 {
    let value = node_f3(node)
    if node_tag(value) == 2 {
      if continuation_name_matches(cont, src, node_f1(value), node_f2(value)) {
        continuation_alias_node(node_f1(node), node_f2(node))
      } else { 0 }
    } else {
      if continuation_value_returns_direct_arg(value, cont, src, ft) == 1 {
        continuation_alias_node(node_f1(node), node_f2(node))
      } else { 0 }
    }
  } else { 0 } }
}

pub(package) fn check_continuation_capture(node: i64, cont: i64, src: i64, ft: i64) -> i64 {
  if node == 0 { 0 }
  else {
    match node_tag(node) {
      29 -> {
        0
      }
      3 -> check_continuation_capture(node_f2(node), cont, src, ft) + check_continuation_capture(node_f3(node), cont, src, ft)
      4 -> continuation_capture_list(node_f3(node), node_f4(node), cont, src, ft)
      5 -> check_continuation_capture(node_f1(node), cont, src, ft) + check_continuation_capture(node_f2(node), cont, src, ft) + check_continuation_capture(node_f3(node), cont, src, ft)
      6 -> {
        let alias = continuation_alias_from_let(node, cont, src, ft)
        if alias != 0 {
          check_continuation_capture(node_f4(node), alias, src, ft) + check_continuation_capture(node_f4(node), cont, src, ft)
        } else {
          check_continuation_capture(node_f3(node), cont, src, ft) + check_continuation_capture(node_f4(node), cont, src, ft)
        }
      }
      7 -> check_continuation_capture(node_f1(node), cont, src, ft) + check_continuation_capture(node_f2(node), cont, src, ft)
      10 -> check_continuation_capture(node_f1(node), cont, src, ft) + check_continuation_capture(node_f2(node), cont, src, ft)
      11 -> check_continuation_capture(node_f3(node), cont, src, ft) + check_continuation_capture(node_f4(node), cont, src, ft)
      12 -> check_continuation_capture(node_f3(node), cont, src, ft)
      57 -> check_continuation_capture(node_f1(node), cont, src, ft) + check_continuation_capture(node_f2(node), cont, src, ft)
      13 -> check_continuation_capture(node_f1(node), cont, src, ft)
      59 -> check_continuation_capture(node_f1(node), cont, src, ft)
      60 -> check_continuation_capture(node_f1(node), cont, src, ft) + check_continuation_capture(node_f2(node), cont, src, ft)
      61 -> check_continuation_capture(node_f1(node), cont, src, ft) + check_continuation_capture(node_f2(node), cont, src, ft) + check_continuation_capture(node_f3(node), cont, src, ft)
      62 -> check_continuation_capture(node_f1(node), cont, src, ft) + check_continuation_capture(node_f2(node), cont, src, ft) + check_continuation_capture(node_f3(node), cont, src, ft)
      14 -> {
        let fields = node_f3(node)
        let nfields = node_f4(node)
        let mut errors = 0
        for ri in 0..nfields {
          errors = errors + check_continuation_capture(node_f3(nlist_get(fields, ri)), cont, src, ft)
        }
        errors
      }
      63 -> check_continuation_capture(node_f1(node), cont, src, ft) + continuation_capture_list(record_field_expr_nodes(node_f2(node), node_f3(node)), node_f3(node), cont, src, ft)
      58 -> continuation_capture_list(node_f1(node), node_f2(node), cont, src, ft)
      15 -> {
        let arms = node_f2(node)
        let n = node_f3(node)
        let mut errors = check_continuation_capture(node_f1(node), cont, src, ft)
        for i in 0..n {
          let arm = nlist_get(arms, i)
          let guard = node_f3(arm)
          if guard != 0 { errors = errors + check_continuation_capture(guard, cont, src, ft) } else { errors = errors }
          errors = errors + check_continuation_capture(node_f2(arm), cont, src, ft)
        }
        errors
      }
      22 -> check_continuation_capture(node_f1(node), cont, src, ft)
      25 -> check_continuation_capture(node_f1(node), cont, src, ft)
      26 -> check_continuation_capture(node_f1(node), cont, src, ft)
      32 -> check_continuation_capture(node_f1(node), cont, src, ft) + continuation_capture_list(node_f4(node), nlist_len(node_f4(node)), cont, src, ft)
      33 -> check_continuation_capture(node_f1(node), cont, src, ft)
      35 -> check_continuation_capture(node_f1(node), cont, src, ft)
      36 -> {
        let call_node = node_f2(node)
        continuation_capture_list(generic_call_inner_args(call_node), generic_call_inner_arg_count(call_node), cont, src, ft)
      }
      37 -> check_continuation_capture(node_f1(node), cont, src, ft)
      41 -> check_continuation_capture(node_f1(node), cont, src, ft) + continuation_capture_list(node_f3(node), nlist_len(node_f3(node)), cont, src, ft)
      45 -> check_continuation_capture(node_f1(node), cont, src, ft)
      46 -> check_continuation_capture(node_f1(node), cont, src, ft) + check_continuation_capture(node_f2(node), cont, src, ft)
      47 -> check_continuation_capture(node_f3(node), cont, src, ft) + check_continuation_capture(node_f4(node), cont, src, ft)
      48 -> check_continuation_capture(node_f1(node), cont, src, ft)
      49 -> check_continuation_capture(node_f1(node), cont, src, ft)
      52 -> check_continuation_capture(node_f1(node), cont, src, ft) + check_continuation_capture(node_f2(node), cont, src, ft)
      _ -> 0
    }
  }
}

pub(package) fn continuation_capture_list(list: i64, n: i64, cont: i64, src: i64, ft: i64) -> i64 {
  let mut errors = 0
  for i in 0..n {
    errors = errors + check_continuation_capture(nlist_get(list, i), cont, src, ft)
  }
  errors
}

pub(package) fn continuation_direct_ref(node: i64, cont: i64, src: i64) -> i64 {
  if node == 0 { 0 }
  else { if node_tag(node) == 2 { continuation_name_matches(cont, src, node_f1(node), node_f2(node)) } else { 0 } }
}

pub(package) fn check_continuation_escape(node: i64, cont: i64, src: i64, ft: i64) -[Diagnose]> i64 {
  check_continuation_escape_mode(node, cont, src, ft, 0)
}

pub(package) fn check_continuation_value_escape(node: i64, cont: i64, src: i64, ft: i64) -[Diagnose]> i64 {
  check_continuation_escape_mode(node, cont, src, ft, 1)
}

pub(package) fn continuation_call_arg_accepts_direct(ft: i64, src: i64, ns: i64, nl: i64, arg_index: i64) -> i64 {
  if (src_eq(src, ns, nl, "continuation_cell_store_i64_raw") == 1 or src_eq(src, ns, nl, "runtime_continuation_cell_store_i64") == 1) and arg_index == 1 { 1 }
  else { if ft == 0 { 0 }
  else { if ftypes_lookup_body(ft, src, ns, nl) == 0 { 0 }
  else {
    let params = ftypes_lookup_params(ft, src, ns, nl)
    if params == 0 { 0 }
    else { if arg_index >= nlist_len(params) { 0 }
    else { ty_is_continuation(node_f3(nlist_get(params, arg_index))) } }
  } } }
}

pub(package) fn continuation_generic_call_arg_accepts_direct(ft: i64, src: i64, call_node: i64, type_args: i64, arg_index: i64) -> i64 {
  if ft == 0 { 0 }
  else {
    let ns = node_f1(call_node)
    let nl = node_f2(call_node)
    if ftypes_lookup_body(ft, src, ns, nl) == 0 { 0 }
    else {
      let tparams = ftypes_lookup_tparams(ft, src, ns, nl)
      let params = ftypes_lookup_params(ft, src, ns, nl)
      if tparams == 0 or params == 0 { 0 }
      else { if nlist_len(tparams) != nlist_len(type_args) { 0 }
      else { if arg_index >= nlist_len(params) { 0 }
      else {
        ty_is_continuation(node_f3(nlist_get(params, arg_index)))
      } } }
    }
  }
}

pub(package) fn continuation_escape_call_args_mode(call_node: i64, cont: i64, src: i64, ft: i64, allow_direct_arg: i64) -[Diagnose]> i64 {
  let args = node_f3(call_node)
  let nargs = node_f4(call_node)
  let mut errors = 0
  for i in 0..nargs {
    let arg = nlist_get(args, i)
    let allow_arg = allow_direct_arg == 1 and continuation_call_arg_accepts_direct(ft, src, node_f1(call_node), node_f2(call_node), i) == 1
    errors = errors + check_continuation_escape_arg_mode(arg, cont, src, ft, allow_arg)
  }
  errors
}

pub(package) fn continuation_escape_generic_call_args_mode(node: i64, cont: i64, src: i64, ft: i64, allow_direct_arg: i64) -[Diagnose]> i64 {
  let type_args = node_f1(node)
  let call_node = node_f2(node)
  let args = generic_call_inner_args(call_node)
  let nargs = generic_call_inner_arg_count(call_node)
  let mut errors = 0
  for i in 0..nargs {
    let arg = nlist_get(args, i)
    let allow_arg = allow_direct_arg == 1 and node_tag(call_node) == 4 and continuation_generic_call_arg_accepts_direct(ft, src, call_node, type_args, i) == 1
    errors = errors + check_continuation_escape_arg_mode(arg, cont, src, ft, allow_arg)
  }
  errors
}

pub(package) fn check_continuation_escape_mode(node: i64, cont: i64, src: i64, ft: i64, allow_direct_arg: i64) -[Diagnose]> i64 {
  if node == 0 { 0 }
  else {
    match node_tag(node) {
      2 -> {
        if continuation_name_matches(cont, src, node_f1(node), node_f2(node)) {
          typeck_error_maybe(src, node_f1(node), "type error: continuation cannot escape")
          1
        } else { 0 }
      }
      3 -> check_continuation_escape_mode(node_f2(node), cont, src, ft, allow_direct_arg) + check_continuation_escape_mode(node_f3(node), cont, src, ft, allow_direct_arg)
      4 -> continuation_escape_call_args_mode(node, cont, src, ft, allow_direct_arg)
      5 -> check_continuation_escape_mode(node_f1(node), cont, src, ft, allow_direct_arg) + check_continuation_escape_mode(node_f2(node), cont, src, ft, allow_direct_arg) + check_continuation_escape_mode(node_f3(node), cont, src, ft, allow_direct_arg)
      6 -> {
        let alias = continuation_alias_from_let(node, cont, src, ft)
        if alias != 0 {
          check_continuation_escape_mode(node_f4(node), alias, src, ft, allow_direct_arg) + check_continuation_escape_mode(node_f4(node), cont, src, ft, allow_direct_arg)
        } else {
          check_continuation_escape_mode(node_f3(node), cont, src, ft, allow_direct_arg) + check_continuation_escape_mode(node_f4(node), cont, src, ft, allow_direct_arg)
        }
      }
      7 -> check_continuation_escape_mode(node_f1(node), cont, src, ft, allow_direct_arg) + check_continuation_escape_mode(node_f2(node), cont, src, ft, allow_direct_arg)
      10 -> check_continuation_escape_mode(node_f1(node), cont, src, ft, allow_direct_arg) + check_continuation_escape_mode(node_f2(node), cont, src, ft, allow_direct_arg)
      11 -> check_continuation_escape_mode(node_f3(node), cont, src, ft, allow_direct_arg) + check_continuation_escape_mode(node_f4(node), cont, src, ft, allow_direct_arg)
      12 -> check_continuation_escape_mode(node_f3(node), cont, src, ft, allow_direct_arg)
      57 -> check_continuation_escape_mode(node_f1(node), cont, src, ft, allow_direct_arg) + check_continuation_escape_mode(node_f2(node), cont, src, ft, allow_direct_arg)
      13 -> check_continuation_escape_mode(node_f1(node), cont, src, ft, allow_direct_arg)
      59 -> check_continuation_escape_mode(node_f1(node), cont, src, ft, allow_direct_arg)
      60 -> check_continuation_escape_mode(node_f1(node), cont, src, ft, allow_direct_arg) + check_continuation_escape_mode(node_f2(node), cont, src, ft, allow_direct_arg)
      61 -> check_continuation_escape_mode(node_f1(node), cont, src, ft, allow_direct_arg) + check_continuation_escape_mode(node_f2(node), cont, src, ft, allow_direct_arg) + check_continuation_escape_mode(node_f3(node), cont, src, ft, allow_direct_arg)
      62 -> check_continuation_escape_mode(node_f1(node), cont, src, ft, allow_direct_arg) + check_continuation_escape_mode(node_f2(node), cont, src, ft, allow_direct_arg) + check_continuation_escape_mode(node_f3(node), cont, src, ft, allow_direct_arg)
      14 -> {
        let fields = node_f3(node)
        let nfields = node_f4(node)
        let mut errors = 0
        for ri in 0..nfields {
          errors = errors + check_continuation_escape_mode(node_f3(nlist_get(fields, ri)), cont, src, ft, 0)
        }
        errors
      }
      63 -> check_continuation_escape_mode(node_f1(node), cont, src, ft, allow_direct_arg) + continuation_escape_list_mode(record_field_expr_nodes(node_f2(node), node_f3(node)), node_f3(node), cont, src, ft, 0)
      58 -> continuation_escape_list_mode(node_f1(node), node_f2(node), cont, src, ft, 0)
      15 -> {
        let arms = node_f2(node)
        let n = node_f3(node)
        let mut errors = check_continuation_escape_mode(node_f1(node), cont, src, ft, allow_direct_arg)
        for i in 0..n {
          let arm = nlist_get(arms, i)
          let guard = node_f3(arm)
          if guard != 0 { errors = errors + check_continuation_escape_mode(guard, cont, src, ft, allow_direct_arg) } else { errors = errors }
          errors = errors + check_continuation_escape_mode(node_f2(arm), cont, src, ft, allow_direct_arg)
        }
        errors
      }
      22 -> check_continuation_escape_mode(node_f1(node), cont, src, ft, allow_direct_arg)
      25 -> check_continuation_escape_mode(node_f1(node), cont, src, ft, allow_direct_arg)
      26 -> check_continuation_escape_mode(node_f1(node), cont, src, ft, allow_direct_arg)
      29 -> 0
      32 -> check_continuation_escape_mode(node_f1(node), cont, src, ft, allow_direct_arg) + continuation_escape_list_mode(node_f4(node), nlist_len(node_f4(node)), cont, src, ft, 0)
      33 -> check_continuation_escape_mode(node_f1(node), cont, src, ft, allow_direct_arg)
      35 -> check_continuation_escape_mode(node_f1(node), cont, src, ft, allow_direct_arg)
      36 -> {
        continuation_escape_generic_call_args_mode(node, cont, src, ft, allow_direct_arg)
      }
      37 -> check_continuation_escape_mode(node_f1(node), cont, src, ft, allow_direct_arg)
      41 -> check_continuation_escape_mode(node_f1(node), cont, src, ft, allow_direct_arg) + continuation_escape_list_mode(node_f3(node), nlist_len(node_f3(node)), cont, src, ft, 0)
      45 -> check_continuation_escape_mode(node_f1(node), cont, src, ft, allow_direct_arg)
      46 -> check_continuation_escape_mode(node_f1(node), cont, src, ft, allow_direct_arg) + check_continuation_escape_mode(node_f2(node), cont, src, ft, allow_direct_arg)
      47 -> check_continuation_escape_mode(node_f3(node), cont, src, ft, allow_direct_arg) + check_continuation_escape_mode(node_f4(node), cont, src, ft, allow_direct_arg)
      48 -> check_continuation_escape_mode(node_f1(node), cont, src, ft, allow_direct_arg)
      49 -> check_continuation_escape_mode(node_f1(node), cont, src, ft, allow_direct_arg)
      52 -> check_continuation_escape_mode(node_f1(node), cont, src, ft, allow_direct_arg) + check_continuation_escape_mode(node_f2(node), cont, src, ft, allow_direct_arg)
      _ -> 0
    }
  }
}

pub(package) fn check_continuation_escape_arg_mode(node: i64, cont: i64, src: i64, ft: i64, allow_direct_arg: i64) -[Diagnose]> i64 {
  if allow_direct_arg == 1 and continuation_direct_ref(node, cont, src) == 1 { 0 }
  else { check_continuation_escape_mode(node, cont, src, ft, 0) }
}

pub(package) fn continuation_escape_list_mode(list: i64, n: i64, cont: i64, src: i64, ft: i64, allow_direct_arg: i64) -[Diagnose]> i64 {
  let mut errors = 0
  for i in 0..n {
    errors = errors + check_continuation_escape_arg_mode(nlist_get(list, i), cont, src, ft, allow_direct_arg)
  }
  errors
}

pub(package) fn continuation_escape_list(list: i64, n: i64, cont: i64, src: i64, ft: i64) -[Diagnose]> i64 {
  let mut errors = 0
  for i in 0..n {
    errors = errors + check_continuation_escape(nlist_get(list, i), cont, src, ft)
  }
  errors
}

pub(package) fn continuation_lambda_alias_from_let(node: i64, cont: i64, src: i64) -> i64 {
  if node_tag(node) == 37 {
    continuation_lambda_alias_from_let(node_f1(node), cont, src)
  } else { if node_tag(node) == 6 {
    let value = node_f3(node)
    if node_tag(value) == 29 {
      if continuation_ref_count(node_f2(value), cont, src) > 0 {
        continuation_alias_node(node_f1(node), node_f2(node))
      } else { 0 }
    } else { 0 }
  } else { 0 } }
}

pub(package) fn continuation_lambda_usage_list(list: i64, n: i64, cont: i64, src: i64, allow_non_tail: i64, ft: i64) -[Diagnose]> i64 {
  let mut errors = 0
  for i in 0..n {
    errors = errors + check_continuation_lambda_usage(nlist_get(list, i), cont, src, allow_non_tail, ft)
  }
  errors
}

pub(package) fn check_continuation_lambda_alias_usage(body: i64, alias: i64, src: i64, allow_non_tail: i64, ft: i64) -[Diagnose]> i64 {
  let calls = continuation_call_count(body, alias, src, ft)
  let tail_calls = continuation_tail_call_count(body, alias, src, ft)
  let mut errors = check_continuation_escape(body, alias, src, ft) + check_continuation_lambda_usage(body, alias, src, allow_non_tail, ft)
  if calls > 1 {
    typeck_error_maybe(src, node_f1(alias), "type error: continuation used more than once")
    errors = errors + 1
  } else { errors = errors }
  if allow_non_tail == 0 and calls > tail_calls {
    typeck_error_maybe(src, node_f1(alias), "type error: continuation call must be tail position")
    errors = errors + 1
  } else { errors = errors }
  errors
}

pub(package) fn check_continuation_lambda_body_usage(lambda: i64, cont: i64, src: i64, allow_non_tail: i64, ft: i64) -[Diagnose]> i64 {
  let body = node_f2(lambda)
  let calls = continuation_call_count(body, cont, src, ft)
  let tail_calls = continuation_tail_call_count(body, cont, src, ft)
  let mut errors = check_continuation_value_escape(body, cont, src, ft) + check_continuation_lambda_usage(body, cont, src, allow_non_tail, ft)
  if calls > 1 {
    typeck_error_maybe(src, node_f1(cont), "type error: continuation used more than once")
    errors = errors + 1
  } else { errors = errors }
  if allow_non_tail == 0 and calls > tail_calls {
    typeck_error_maybe(src, node_f1(cont), "type error: continuation call must be tail position")
    errors = errors + 1
  } else { errors = errors }
  errors
}

pub(package) fn check_continuation_lambda_usage(node: i64, cont: i64, src: i64, allow_non_tail: i64, ft: i64) -[Diagnose]> i64 {
  if node == 0 { 0 }
  else {
    match node_tag(node) {
      29 -> {
        if continuation_ref_count(node_f2(node), cont, src) > 0 {
          typeck_error_maybe(src, node_f1(cont), "type error: continuation-capturing closure must stay local")
          1
        } else { 0 }
      }
      3 -> check_continuation_lambda_usage(node_f2(node), cont, src, allow_non_tail, ft) + check_continuation_lambda_usage(node_f3(node), cont, src, allow_non_tail, ft)
      4 -> continuation_lambda_usage_list(node_f3(node), node_f4(node), cont, src, allow_non_tail, ft)
      5 -> check_continuation_lambda_usage(node_f1(node), cont, src, allow_non_tail, ft) + check_continuation_lambda_usage(node_f2(node), cont, src, allow_non_tail, ft) + check_continuation_lambda_usage(node_f3(node), cont, src, allow_non_tail, ft)
      6 -> {
        let alias = continuation_alias_from_let(node, cont, src, ft)
        if alias != 0 {
          -- Fiber-backed direct resumption may continue in the clause, but a
          -- continuation returned through an ordinary helper has crossed an
          -- opaque value boundary. Keep that alias tail-only: the deferred
          -- body proof authorises the prompt, not arbitrary non-tail aliases.
          let alias_tail_errors = if allow_non_tail == 2 and node_tag(node_f3(node)) != 2 {
            let alias_calls = continuation_call_count(node_f4(node), alias, src, ft)
            let alias_tail_calls = continuation_tail_call_count(node_f4(node), alias, src, ft)
            if alias_calls > alias_tail_calls {
              typeck_error_maybe(src, node_f1(alias), "type error: continuation call must be tail position")
              1
            } else { 0 }
          } else { 0 }
          alias_tail_errors + check_continuation_lambda_usage(node_f4(node), alias, src, allow_non_tail, ft) + check_continuation_lambda_usage(node_f4(node), cont, src, allow_non_tail, ft)
        } else {
          let lambda_alias = continuation_lambda_alias_from_let(node, cont, src)
          if lambda_alias != 0 {
            check_continuation_lambda_body_usage(node_f3(node), cont, src, allow_non_tail, ft) + check_continuation_lambda_alias_usage(node_f4(node), lambda_alias, src, allow_non_tail, ft) + check_continuation_lambda_usage(node_f4(node), cont, src, allow_non_tail, ft)
          } else {
            check_continuation_lambda_usage(node_f3(node), cont, src, allow_non_tail, ft) + check_continuation_lambda_usage(node_f4(node), cont, src, allow_non_tail, ft)
          }
        }
      }
      7 -> check_continuation_lambda_usage(node_f1(node), cont, src, allow_non_tail, ft) + check_continuation_lambda_usage(node_f2(node), cont, src, allow_non_tail, ft)
      10 -> check_continuation_lambda_usage(node_f1(node), cont, src, allow_non_tail, ft) + check_continuation_lambda_usage(node_f2(node), cont, src, allow_non_tail, ft)
      11 -> check_continuation_lambda_usage(node_f3(node), cont, src, allow_non_tail, ft) + check_continuation_lambda_usage(node_f4(node), cont, src, allow_non_tail, ft)
      12 -> check_continuation_lambda_usage(node_f3(node), cont, src, allow_non_tail, ft)
      57 -> check_continuation_lambda_usage(node_f1(node), cont, src, allow_non_tail, ft) + check_continuation_lambda_usage(node_f2(node), cont, src, allow_non_tail, ft)
      13 -> check_continuation_lambda_usage(node_f1(node), cont, src, allow_non_tail, ft)
      59 -> check_continuation_lambda_usage(node_f1(node), cont, src, allow_non_tail, ft)
      60 -> check_continuation_lambda_usage(node_f1(node), cont, src, allow_non_tail, ft) + check_continuation_lambda_usage(node_f2(node), cont, src, allow_non_tail, ft)
      61 -> check_continuation_lambda_usage(node_f1(node), cont, src, allow_non_tail, ft) + check_continuation_lambda_usage(node_f2(node), cont, src, allow_non_tail, ft) + check_continuation_lambda_usage(node_f3(node), cont, src, allow_non_tail, ft)
      62 -> check_continuation_lambda_usage(node_f1(node), cont, src, allow_non_tail, ft) + check_continuation_lambda_usage(node_f2(node), cont, src, allow_non_tail, ft) + check_continuation_lambda_usage(node_f3(node), cont, src, allow_non_tail, ft)
      14 -> {
        let fields = node_f3(node)
        let nfields = node_f4(node)
        let mut errors = 0
        for ri in 0..nfields {
          errors = errors + check_continuation_lambda_usage(node_f3(nlist_get(fields, ri)), cont, src, allow_non_tail, ft)
        }
        errors
      }
      63 -> check_continuation_lambda_usage(node_f1(node), cont, src, allow_non_tail, ft) + continuation_lambda_usage_list(record_field_expr_nodes(node_f2(node), node_f3(node)), node_f3(node), cont, src, allow_non_tail, ft)
      58 -> continuation_lambda_usage_list(node_f1(node), node_f2(node), cont, src, allow_non_tail, ft)
      15 -> {
        let arms = node_f2(node)
        let n = node_f3(node)
        let mut errors = check_continuation_lambda_usage(node_f1(node), cont, src, allow_non_tail, ft)
        for i in 0..n {
          let arm = nlist_get(arms, i)
          let guard = node_f3(arm)
          if guard != 0 { errors = errors + check_continuation_lambda_usage(guard, cont, src, allow_non_tail, ft) } else { errors = errors }
          errors = errors + check_continuation_lambda_usage(node_f2(arm), cont, src, allow_non_tail, ft)
        }
        errors
      }
      22 -> check_continuation_lambda_usage(node_f1(node), cont, src, allow_non_tail, ft)
      25 -> check_continuation_lambda_usage(node_f1(node), cont, src, allow_non_tail, ft)
      26 -> check_continuation_lambda_usage(node_f1(node), cont, src, allow_non_tail, ft)
      32 -> check_continuation_lambda_usage(node_f1(node), cont, src, allow_non_tail, ft) + continuation_lambda_usage_list(node_f4(node), nlist_len(node_f4(node)), cont, src, allow_non_tail, ft)
      33 -> check_continuation_lambda_usage(node_f1(node), cont, src, allow_non_tail, ft)
      35 -> check_continuation_lambda_usage(node_f1(node), cont, src, allow_non_tail, ft)
      36 -> {
        let call_node = node_f2(node)
        continuation_lambda_usage_list(generic_call_inner_args(call_node), generic_call_inner_arg_count(call_node), cont, src, allow_non_tail, ft)
      }
      37 -> check_continuation_lambda_usage(node_f1(node), cont, src, allow_non_tail, ft)
      41 -> check_continuation_lambda_usage(node_f1(node), cont, src, allow_non_tail, ft) + continuation_lambda_usage_list(node_f3(node), nlist_len(node_f3(node)), cont, src, allow_non_tail, ft)
      45 -> check_continuation_lambda_usage(node_f1(node), cont, src, allow_non_tail, ft)
      46 -> check_continuation_lambda_usage(node_f1(node), cont, src, allow_non_tail, ft) + check_continuation_lambda_usage(node_f2(node), cont, src, allow_non_tail, ft)
      47 -> check_continuation_lambda_usage(node_f3(node), cont, src, allow_non_tail, ft) + check_continuation_lambda_usage(node_f4(node), cont, src, allow_non_tail, ft)
      48 -> check_continuation_lambda_usage(node_f1(node), cont, src, allow_non_tail, ft)
      49 -> check_continuation_lambda_usage(node_f1(node), cont, src, allow_non_tail, ft)
      52 -> check_continuation_lambda_usage(node_f1(node), cont, src, allow_non_tail, ft) + check_continuation_lambda_usage(node_f2(node), cont, src, allow_non_tail, ft)
      _ -> 0
    }
  }
}

pub(package) fn check_continuation_usage(body: i64, cont: i64, src: i64, allow_non_tail: i64, ft: i64) -[Diagnose]> i64 {
  check_continuation_usage_with_result(body, cont, src, allow_non_tail, 0, ft)
}

pub(package) fn check_continuation_usage_with_result(body: i64, cont: i64, src: i64, allow_non_tail: i64, allow_direct_result: i64, ft: i64) -[Diagnose]> i64 {
  if cont == 0 { 0 }
  else {
    let result_use = if allow_direct_result == 1 { continuation_direct_result(body, cont, src) } else { 0 }
    let calls = continuation_call_count(body, cont, src, ft) + result_use
    let tail_calls = continuation_tail_call_count(body, cont, src, ft)
    let escape_errors = if result_use == 1 { 0 } else { check_continuation_value_escape(body, cont, src, ft) }
    let mut errors = check_continuation_capture(body, cont, src, ft) + escape_errors + check_continuation_lambda_usage(body, cont, src, allow_non_tail, ft)
    if calls > 1 {
      typeck_error_maybe(src, node_f1(cont), "type error: continuation used more than once")
      errors = errors + 1
    } else { errors = errors }
    if allow_non_tail == 0 and calls > tail_calls {
      typeck_error_maybe(src, node_f1(cont), "type error: continuation call must be tail position")
      errors = errors + 1
    } else {
      errors = errors
    }
    errors
  }
}

pub(package) fn check_continuation_param_usage(body: i64, params: i64, nparams: i64, src: i64) -[Diagnose]> i64 {
  check_continuation_param_usage_with_result(body, params, nparams, ty_any(), src, 0)
}

pub(package) fn check_continuation_param_usage_with_result(body: i64, params: i64, nparams: i64, ret_ty: i64, src: i64, ft: i64) -[Diagnose]> i64 {
  let mut errors = 0
  let allow_direct_result = ty_is_continuation(ret_ty)
  for i in 0..nparams {
    let p = nlist_get(params, i)
    if ty_is_continuation(node_f3(p)) == 1 {
      errors = errors + check_continuation_usage_with_result(body, p, src, 1, allow_direct_result, ft)
    } else { errors = errors }
  }
  errors
}

-- Synthesize the return type of an effect perform: EffectName.op(args)
-- Looks up the effect in ttable (kind=2) and finds the operation's return type.
pub(package) fn synth_effect_perform(node: i64, src: i64, tt: i64) -> i64 {
  let lhs = node_f1(node)
  let op_hash = effect_name_hash(src, node_f2(node), node_f3(node))
  -- Look up effect in ttable
  if tt == 0 { ty_any() }
  else {
    let entry = typeck_effect_ref_entry(lhs, src, tt)
    if entry == 0 { ty_any() }
    else {
      let kind = mem_load64_at(entry, 16)
      if kind != 2 { ty_any() }
      else {
        -- Found effect. Search its operations for matching op_hash.
        let entry_src = mem_load64_at(entry, 48)
        let nops = mem_load64_at(entry, 24)
        let ops = mem_load64_at(entry, 32)
        let mut i = 0
        let mut ret = ty_any()
        while i < nops {
          let op = nlist_get(ops, i)
          let op_name_hash = effect_name_hash(entry_src, node_f1(op), node_f2(op))
          if op_name_hash == op_hash {
            let op_ret = effect_op_ret_type(op)
            -- parameterized effects: instantiate a generic effect's op return type from the
            -- enclosing function's declared atom (found by head).
            let eff_hash = typeck_effect_ref_name_hash(lhs, src)
            let explicit_atom = if typeck_effect_ref_is_parameterized(lhs) == 1 { typeck_effect_ref_atom(lhs, src) } else { 0 }
            let atom = if explicit_atom != 0 { explicit_atom }
              else { effect_sig_find_atom_by_head(ttable_get_current_fn_eff(tt), eff_hash) }
            let s = effect_entry_atom_subst(entry, atom)
            let inst_ret = if op_ret != 0 and s != 0 { ty_subst(op_ret, s) } else { op_ret }
            ret = if inst_ret != 0 { inst_ret } else { ty_any() }
            i = nops
          } else { i = i + 1 }
        }
        ret
      }
    }
  }
}

pub(package) fn effect_sig_one(eff_hash: i64) -> i64 {
  let effects = nlist_new()
  nlist_add(effects, ty_effect_app(eff_hash))
  ty_effect_sig(effects)
}

pub(package) fn effect_list_add_hash(effects: i64, eff_hash: i64) -> i64 {
  if eff_hash == 0 { 0 }
  else {
    let mut found = false
    let mut i = 0
    while i < nlist_len(effects) {
      let app = nlist_get(effects, i)
      if effect_atom_head(app) == eff_hash {
        found = true
        i = nlist_len(effects)
      } else { i = i + 1 }
    }
    if not found { nlist_add(effects, ty_effect_app(eff_hash)) } else { 0 }
  }
}

-- Add a full atom to a collected effect list. Identity is the complete
-- (head, args) pair even while the public duplicate-head fence remains;
-- this makes collection a sound fact producer for qualified-name resolution.
pub(package) fn effect_list_add_atom(effects: i64, atom: i64) -> i64 {
  let eff_hash = effect_atom_head(atom)
  if eff_hash == 0 { 0 }
  else {
    let mut found = false
    let mut i = 0
    while i < nlist_len(effects) {
      if effect_atom_eq(nlist_get(effects, i), atom) {
        found = true
        i = nlist_len(effects)
      } else { i = i + 1 }
    }
    if not found { nlist_add(effects, atom) } else { 0 }
  }
}

pub(package) fn effect_list_merge_sig(effects: i64, eff: i64) -> i64 {
  if eff == 0 { 0 }
  else {
    if ty_tag(eff) != 10 { 0 }
    else {
      let apps = ty_f1(eff)
      let n = nlist_len(apps)
      for i in 0..n {
        -- parameterized effects: preserve the full atom (args included) when merging a
        -- declared sig into a collected set, so handler-clause and
        -- discharge paths can recover the instantiation.
        effect_list_add_atom(effects, nlist_get(apps, i))
      }
      0
    }
  }
}

pub(package) fn effect_list_merge_except_atom(effects: i64, apps: i64, excluded_atom: i64) -> i64 {
  let n = nlist_len(apps)
  for i in 0..n {
    let atom = nlist_get(apps, i)
    if excluded_atom == 0 or not effect_atom_eq(atom, excluded_atom) {
      effect_list_add_atom(effects, atom)
    } else { 0 }
  }
  0
}

-- `?` selects Fail<E> from the Result-like value's error argument. Keep the
-- resolved atom on the syntax node so typed IR and monomorphisation consume a
-- checker-produced semantic fact instead of rediscovering it from syntax.
pub(package) fn typeck_try_error_type(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let inner_ty = synth(node_f1(node), env, ft, src, tt)
  if inner_ty == 0 or ty_tag(inner_ty) != 9 { 0 }
  else {
    let args = ty_f3(inner_ty)
    if args != 0 and nlist_len(args) > 1 { nlist_get(args, 1) } else { 0 }
  }
}

pub(package) fn typeck_try_effect_atom(node: i64, env: i64, ft: i64, src: i64, tt: i64, caller_eff: i64) -> i64 {
  let recorded = node_f2(node)
  if recorded != 0 { recorded }
  else {
    let error_ty = typeck_try_error_type(node, env, ft, src, tt)
    if error_ty != 0 {
      let args = nlist_new()
      nlist_add(args, error_ty)
      ty_effect_app_args(effect_fail_head_hash(), args)
    } else {
      let in_scope = effect_sig_find_atom_by_head(caller_eff, effect_fail_head_hash())
      if in_scope != 0 { in_scope } else { ty_effect_app(effect_fail_head_hash()) }
    }
  }
}

pub(package) fn typeck_record_try_effect_atom(node: i64, atom: i64) -> i64 {
  if atom == 0 { 0 } else { mem_store64_at(node, 16, atom) }
}

pub(package) fn typeck_maybe_effect_atom(node: i64) -> i64 {
  let recorded = node_f4(node)
  if recorded != 0 { recorded } else { ty_effect_app(effect_maybe_head_hash()) }
}

pub(package) fn typeck_record_maybe_effect_atom(node: i64, atom: i64) -> i64 {
  if atom == 0 { 0 } else { mem_store64_at(node, 32, atom) }
}

pub(package) fn infer_expr_effects(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let effects = nlist_new()
  collect_expr_effects(node, env, ft, src, tt, effects)
  ty_effect_sig(effects)
}

pub(package) fn collect_call_effects(node: i64, env: i64, ft: i64, src: i64, effects: i64) -> i64 {
  let ns = node_f1(node)
  let nl = node_f2(node)
  let intrinsic_flags = intrinsic_semantic_effect_flags(src, ns, nl)
  if intrinsic_flags != 0 {
    if intrinsic_flags % 2 == 1 { effect_list_add_hash(effects, effect_hash_alloc()) } else { 0 }
    if intrinsic_flags / 2 % 2 == 1 { effect_list_add_hash(effects, effect_hash_unsafe()) } else { 0 }
  } else { if is_unsafe_raw_call_name(src, ns, nl) {
    effect_list_add_hash(effects, effect_hash_unsafe())
  } else {
    let local_ty = tenv_lookup(env, src, ns, nl)
    if local_ty != 0 {
      if ty_tag(local_ty) == 6 { effect_list_merge_sig(effects, ty_f3(local_ty)) }
      else { if ty_tag(local_ty) == 14 { 0 }
      else { effect_list_merge_sig(effects, ftypes_lookup_effects(ft, src, ns, nl)) }
      }
    } else { effect_list_merge_sig(effects, ftypes_lookup_effects(ft, src, ns, nl)) }
  } }
}

pub(package) fn collect_qualified_call_effects(node: i64, env: i64, ft: i64, src: i64, tt: i64, type_args: i64, effects: i64) -> i64 {
  let entry = typeck_qualified_member_entry(node, env, ft, src, tt)
  if entry != 0 {
    let raw = ftypes_entry_effects(entry)
    let tparams = ftypes_entry_tparams(entry)
    let concrete = if raw > 0 and tparams != 0 and type_args != 0 { ty_subst(raw, build_subst(tparams, type_args)) } else { raw }
    effect_list_merge_sig(effects, concrete)
  } else { 0 }
}

pub(package) fn collect_expr_effects_list(list: i64, n: i64, env: i64, ft: i64, src: i64, tt: i64, effects: i64) -> i64 {
  for i in 0..n {
    collect_expr_effects(nlist_get(list, i), env, ft, src, tt, effects)
  }
  0
}

pub(package) fn collect_expr_effects(node: i64, env: i64, ft: i64, src: i64, tt: i64, effects: i64) -> i64 {
  if node == 0 { 0 }
  else {
    let tag = node_tag(node)
    match tag {
      3 -> {
        collect_expr_effects(node_f2(node), env, ft, src, tt, effects)
        collect_expr_effects(node_f3(node), env, ft, src, tt, effects)
      }
      4 -> {
        collect_call_effects(node, env, ft, src, effects)
        collect_expr_effects_list(node_f3(node), node_f4(node), env, ft, src, tt, effects)
      }
      5 -> {
        collect_expr_effects(node_f1(node), env, ft, src, tt, effects)
        collect_expr_effects(node_f2(node), env, ft, src, tt, effects)
        collect_expr_effects(node_f3(node), env, ft, src, tt, effects)
      }
      6 -> {
        let val = node_f3(node)
        collect_expr_effects(val, env, ft, src, tt, effects)
        let val_ty = synth(val, env, ft, src, tt)
        let new_env = tenv_bind(env, src, node_f1(node), node_f2(node), val_ty)
        collect_expr_effects(node_f4(node), new_env, ft, src, tt, effects)
      }
      7 -> {
        collect_expr_effects(node_f1(node), env, ft, src, tt, effects)
        collect_expr_effects(node_f2(node), env, ft, src, tt, effects)
      }
      10 -> {
        collect_expr_effects(node_f1(node), env, ft, src, tt, effects)
        collect_expr_effects(node_f2(node), env, ft, src, tt, effects)
      }
      11 -> {
        let val = node_f3(node)
        collect_expr_effects(val, env, ft, src, tt, effects)
        let val_ty = synth(val, env, ft, src, tt)
        let new_env = tenv_bind_mut(env, src, node_f1(node), node_f2(node), val_ty)
        collect_expr_effects(node_f4(node), new_env, ft, src, tt, effects)
      }
      12 -> collect_expr_effects(node_f3(node), env, ft, src, tt, effects)
      57 -> {
        effect_list_add_hash(effects, effect_hash_unsafe())
        collect_expr_effects(node_f1(node), env, ft, src, tt, effects)
        collect_expr_effects(node_f2(node), env, ft, src, tt, effects)
      }
      13 -> collect_expr_effects(node_f1(node), env, ft, src, tt, effects)
      59 -> collect_expr_effects(node_f1(node), env, ft, src, tt, effects)
      60 -> { collect_expr_effects(node_f1(node), env, ft, src, tt, effects) collect_expr_effects(node_f2(node), env, ft, src, tt, effects) }
      61 -> { collect_expr_effects(node_f1(node), env, ft, src, tt, effects) collect_expr_effects(node_f2(node), env, ft, src, tt, effects) collect_expr_effects(node_f3(node), env, ft, src, tt, effects) }
      62 -> { collect_expr_effects(node_f1(node), env, ft, src, tt, effects) collect_expr_effects(node_f2(node), env, ft, src, tt, effects) collect_expr_effects(node_f3(node), env, ft, src, tt, effects) }
      14 -> {
        let fields = node_f3(node)
        let nfields = node_f4(node)
        for ri in 0..nfields {
          collect_expr_effects(node_f3(nlist_get(fields, ri)), env, ft, src, tt, effects)
        }
        0
      }
      63 -> {
        collect_expr_effects(node_f1(node), env, ft, src, tt, effects)
        collect_expr_effects_list(record_field_expr_nodes(node_f2(node), node_f3(node)), node_f3(node), env, ft, src, tt, effects)
      }
      58 -> collect_expr_effects_list(node_f1(node), node_f2(node), env, ft, src, tt, effects)
      15 -> {
        collect_expr_effects(node_f1(node), env, ft, src, tt, effects)
        let scr_ty = synth(node_f1(node), env, ft, src, tt)
        let arms = node_f2(node)
        let narms = node_f3(node)
        for mi in 0..narms {
          let arm = nlist_get(arms, mi)
          let arm_env = bind_match_pattern(node_f1(arm), env, src, scr_ty, tt)
          let guard = node_f3(arm)
          if guard != 0 { collect_expr_effects(guard, arm_env, ft, src, tt, effects) } else { 0 }
          collect_expr_effects(node_f2(arm), arm_env, ft, src, tt, effects)
        }
        0
      }
      22 -> collect_expr_effects(node_f1(node), env, ft, src, tt, effects)
      25 -> collect_expr_effects(node_f1(node), env, ft, src, tt, effects)
      29 -> 0
      32 -> {
        let lhs = node_f1(node)
        if typeck_qualified_call_declaration(node) != 0 {
          collect_qualified_call_effects(node, env, ft, src, tt, 0, effects)
        } else { if typeck_is_effect_ref(lhs, src, tt) {
          if typeck_effect_ref_is_parameterized(lhs) == 1 {
            effect_list_add_atom(effects, typeck_effect_ref_atom(lhs, src))
          } else {
            effect_list_add_hash(effects, typeck_effect_ref_name_hash(lhs, src))
          }
        } else {
          collect_expr_effects(lhs, env, ft, src, tt, effects)
        } }
        collect_expr_effects_list(node_f4(node), nlist_len(node_f4(node)), env, ft, src, tt, effects)
      }
      33 -> {
        let clauses = node_f2(node)
        let nclauses = node_f3(node)
        let body_effects = nlist_new()
        collect_expr_effects(node_f1(node), env, ft, src, tt, body_effects)
        let handled_atom = if nclauses > 0 {
          let effect_ref = node_f1(node_f1(nlist_get(clauses, 0)))
          if typeck_effect_ref_is_parameterized(effect_ref) == 1 { typeck_effect_ref_atom(effect_ref, src) }
          else { effect_list_find_atom_by_head(body_effects, typeck_effect_ref_name_hash(effect_ref, src)) }
        } else { 0 }
        effect_list_merge_except_atom(effects, body_effects, handled_atom)
        for ci in 0..nclauses {
          collect_expr_effects(node_f3(nlist_get(clauses, ci)), env, ft, src, tt, effects)
        }
        0
      }
      35 -> collect_expr_effects(node_f1(node), env, ft, src, tt, effects)
      36 -> {
        let call_node = node_f2(node)
        if node_tag(call_node) == 2 { 0 }
        else { if node_tag(call_node) == 32 {
          collect_qualified_call_effects(call_node, env, ft, src, tt, node_f1(node), effects)
          collect_expr_effects_list(generic_call_inner_args(call_node), generic_call_inner_arg_count(call_node), env, ft, src, tt, effects)
        } else {
          collect_call_effects(call_node, env, ft, src, effects)
          collect_expr_effects_list(node_f3(call_node), node_f4(call_node), env, ft, src, tt, effects)
        } }
      }
      37 -> collect_expr_effects(node_f1(node), env, ft, src, tt, effects)
      41 -> {
        let method_ref = node_f4(node)
        let resolution = ttable_resolve_method(tt, method_ref_receiver_ty(method_ref), method_ref_owner_hash(method_ref), node_f2(node))
        if resolution != 0 { effect_list_merge_sig(effects, method_resolution_effects(resolution)) } else { 0 }
        collect_expr_effects(node_f1(node), env, ft, src, tt, effects)
        collect_expr_effects_list(node_f3(node), nlist_len(node_f3(node)), env, ft, src, tt, effects)
      }
      45 -> {
        let atom = typeck_try_effect_atom(node, env, ft, src, tt, ttable_get_current_fn_eff(tt))
        typeck_record_try_effect_atom(node, atom)
        effect_list_add_atom(effects, atom)
        collect_expr_effects(node_f1(node), env, ft, src, tt, effects)
      }
      46 -> {
        collect_expr_effects(node_f1(node), env, ft, src, tt, effects)
        collect_expr_effects(node_f2(node), env, ft, src, tt, effects)
      }
      47 -> {
        collect_expr_effects(node_f3(node), env, ft, src, tt, effects)
        let loop_env = tenv_bind(env, src, node_f1(node), node_f2(node), for_iter_item_type(node, env, ft, src, tt))
        collect_expr_effects(node_f4(node), loop_env, ft, src, tt, effects)
      }
      48 -> {
        let atom = typeck_maybe_effect_atom(node)
        typeck_record_maybe_effect_atom(node, atom)
        effect_list_add_atom(effects, atom)
        collect_expr_effects(node_f1(node), env, ft, src, tt, effects)
      }
      49 -> collect_expr_effects(node_f1(node), env, ft, src, tt, effects)
      52 -> {
        collect_expr_effects(node_f1(node), env, ft, src, tt, effects)
        collect_expr_effects(node_f2(node), env, ft, src, tt, effects)
      }
      55 -> {
        effect_list_add_hash(effects, effect_hash_unsafe())
        collect_expr_effects(node_f2(node), env, ft, src, tt, effects)
      }
      56 -> {
        effect_list_add_hash(effects, effect_hash_unsafe())
        collect_expr_effects(node_f1(node), env, ft, src, tt, effects)
      }
      _ -> 0
    }
  }
}

-- Active-handler frames are checker facts, not syntax rediscovery. They let a
-- diagnostic distinguish "unhandled" from the more useful "the nearest
-- handler handles the same effect head at a different instantiation".
pub(package) fn typeck_handler_frame(atom: i64, src: i64, start: i64, len: i64, parent: i64) -> i64 {
  let frame = alloc_words(5)
  mem_store64_at(frame, 0, atom)
  mem_store64_at(frame + 8, 0, src)
  mem_store64_at(frame + 16, 0, start)
  mem_store64_at(frame + 24, 0, len)
  mem_store64_at(frame + 32, 0, parent)
  frame
}

pub(package) fn typeck_handler_frame_atom(frame: i64) -> i64 { if frame == 0 { 0 } else { mem_load64_at(frame, 0) } }
pub(package) fn typeck_handler_frame_parent(frame: i64) -> i64 { if frame == 0 { 0 } else { mem_load64_at(frame + 32, 0) } }
pub(package) fn typeck_handler_frame_location(frame: i64) -> DiagnosticLocation {
  if frame == 0 { DiagnosticLocationNone }
  else { typeck_source_location(mem_load64_at(frame + 8, 0), mem_load64_at(frame + 16, 0), mem_load64_at(frame + 24, 0)) }
}

pub(package) fn typeck_nearest_same_head_handler(tt: i64, atom: i64) -> i64 {
  if tt == 0 or atom == 0 { 0 }
  else {
    let mut frame = ttable_get_current_handler(tt)
    let mut found = 0
    while frame != 0 and found == 0 {
      let handled = typeck_handler_frame_atom(frame)
      if handled != 0 and effect_atom_head(handled) == effect_atom_head(atom) and not effect_atom_eq(handled, atom) {
        found = frame
      } else { frame = typeck_handler_frame_parent(frame) }
    }
    found
  }
}

pub(package) fn typeck_effect_sig_from_atom(atom: i64) -> i64 {
  let atoms = nlist_new()
  if atom != 0 { nlist_add(atoms, atom) } else { 0 }
  ty_effect_sig(atoms)
}

pub(package) fn typeck_missing_effects(required: i64, available: i64) -> i64 {
  if required == 0 or ty_tag(required) != 10 { ty_effect_pure() }
  else {
    let missing = nlist_new()
    let available_atoms = if available != 0 and ty_tag(available) == 10 { ty_f1(available) } else { nlist_new() }
    for i in 0..nlist_len(ty_f1(required)) {
      let required_atom = nlist_get(ty_f1(required), i)
      let mut found = false
      for j in 0..nlist_len(available_atoms) {
        if effect_atom_eq(required_atom, nlist_get(available_atoms, j)) { found = true } else { 0 }
      }
      if not found { nlist_add(missing, required_atom) } else { 0 }
    }
    let missing_tail = if ty_f2(required) > 0 and (available == 0 or ty_tag(available) != 10 or ty_f2(available) == 0) { ty_f2(required) } else { 0 }
    ty_effect_sig_with_tail(missing, missing_tail)
  }
}

pub(package) fn typeck_first_effect_atom(effects: i64) -> i64 {
  if effects == 0 or ty_tag(effects) != 10 or nlist_len(ty_f1(effects)) == 0 { 0 }
  else { nlist_get(ty_f1(effects), 0) }
}

pub(package) fn typeck_effect_unavailable_reason(missing: i64, available: i64) -> str {
  let atom = typeck_first_effect_atom(missing)
  let same_head = if atom == 0 or available == 0 or ty_tag(available) != 10 { 0 }
    else { effect_sig_find_atom_by_head(available, effect_atom_head(atom)) }
  if available != 0 and ty_tag(available) == 10 and nlist_len(ty_f1(available)) == 0 and ty_f2(available) == 0 { "pure_context" }
  else { if same_head != 0 and not effect_atom_eq(atom, same_head) {
    if effect_atom_same_declaration(atom, same_head) { "different_instantiation" } else { "different_effect_declaration" }
  }
  else { if atom == 0 and missing != 0 and ty_tag(missing) == 10 and ty_f2(missing) > 0 { "open_effect_tail" }
  else { "missing_effect" } } }
}

pub(package) fn typeck_effect_unavailable_message(missing_text: str, missing: i64) -> str {
  let b = buf_new(__str_len(missing_text) + 64)
  let atom_count = if missing == 0 or ty_tag(missing) != 10 { 0 } else { nlist_len(ty_f1(missing)) }
  let has_tail = if missing == 0 or ty_tag(missing) != 10 { false } else { ty_f2(missing) > 0 }
  if atom_count == 1 and not has_tail { bstr(b, "effect `") } else { bstr(b, "effects `") }
  bstr(b, missing_text)
  bstr(b, "` ")
  if atom_count == 1 and not has_tail { bstr(b, "is") } else { bstr(b, "are") }
  bstr(b, " not available in this context")
  runtime_str_from_bytes_copy(buf_ptr(b), buf_len(b))
}

pub(package) fn typeck_effect_origin_label(context: str) -> str {
  if typeck_text_eq(context, "effect operation") == 1 { "operation requires this effect" }
  else { if typeck_text_eq(context, "method call") == 1 { "method declares this effect" }
  else { "callee declares this effect" } }
}

pub(package) fn typeck_report_effect_unavailable(
  required: i64,
  src: i64,
  start: i64,
  len: i64,
  available: i64,
  tt: i64,
  context: str,
  origin: DiagnosticLocation
) -[Diagnose]> i64 {
  let missing = typeck_missing_effects(required, available)
  let tparams = if tt == 0 { 0 } else { ttable_get_tparams(tt) }
  let required_fact = semantic_type_fact_effects(required, tt, src, tparams)
  let available_fact = semantic_type_fact_effects(available, tt, src, tparams)
  let missing_fact = semantic_type_fact_effects(missing, tt, src, tparams)
  let missing_text = missing_fact.render()
  let available_text = available_fact.render()
  let reason = typeck_effect_unavailable_reason(missing, available)
  let missing_atom = typeck_first_effect_atom(missing)
  let available_same_head = if missing_atom == 0 or available == 0 or ty_tag(available) != 10 { 0 }
    else { effect_sig_find_atom_by_head(available, effect_atom_head(missing_atom)) }
  let near_handler = typeck_nearest_same_head_handler(tt, missing_atom)
  let near_atom = if near_handler != 0 { typeck_handler_frame_atom(near_handler) } else { available_same_head }
  let near_text = if near_atom == 0 { "" }
    else { semantic_type_fact_effect_atom(near_atom, tt, src, tparams).render() }
  let mut fields = DiagnosticFieldCons(
    DiagnosticFieldText("context", context),
    DiagnosticFieldCons(
      DiagnosticFieldText("reason", reason),
      DiagnosticFieldCons(
        DiagnosticFieldEffectSet("required_effects", required_fact),
        DiagnosticFieldCons(
          DiagnosticFieldEffectSet("available_effects", available_fact),
          DiagnosticFieldCons(
            DiagnosticFieldEffectSet("missing_effects", missing_fact),
            DiagnosticFieldCons(
              DiagnosticFieldText("missing_effects_text", missing_text),
              DiagnosticFieldCons(
                DiagnosticFieldText("available_effects_text", available_text),
                DiagnosticFieldCons(
                  DiagnosticFieldSuggestion(DiagnosticSuggestion(
                    "add the missing effect to the enclosing signature or handle it here",
                    DiagnosticSuggestionMaybeIncorrect,
                    DiagnosticTextEditNil
                  )),
                  DiagnosticFieldNil
                )
              )
            )
          )
        )
      )
    )
  )
  if missing_atom != 0 {
    fields = DiagnosticFieldCons(DiagnosticFieldEffectAtom("missing_effect", semantic_type_fact_effect_atom(missing_atom, tt, src, tparams)), fields)
  } else { 0 }
  if near_atom != 0 {
    fields = DiagnosticFieldCons(
      DiagnosticFieldEffectAtom("nearby_effect", semantic_type_fact_effect_atom(near_atom, tt, src, tparams)),
      DiagnosticFieldCons(DiagnosticFieldText("nearby_effect_text", near_text), fields)
    )
  } else { 0 }
  let origin_related = match origin {
    DiagnosticLocationNone -> DiagnosticRelatedLocationNil
    _ -> DiagnosticRelatedLocationCons(DiagnosticRelatedLocation(typeck_effect_origin_label(context), origin), DiagnosticRelatedLocationNil)
  }
  let related = if near_handler == 0 { origin_related }
    else {
      DiagnosticRelatedLocationCons(
        DiagnosticRelatedLocation(
          if typeck_text_eq(reason, "different_effect_declaration") == 1 {
            "nearest handler handles a different effect declaration with the same short name"
          } else { "nearest handler handles a different instantiation of this effect" },
          typeck_handler_frame_location(near_handler)
        ),
        origin_related
      )
    }
  Diagnose.report(Diagnostic(
    DiagnosticSeverityError,
    DiagnosticClassEffect,
    registry.effect_unavailable(),
    typeck_effect_unavailable_message(missing_text, missing),
    typeck_source_location(src, start, len),
    related,
    fields
  ))
}

pub(package) fn check_effect_sig_available(required: i64, src: i64, pos: i64, len: i64, caller_eff: i64, tt: i64, context: str, origin: DiagnosticLocation) -[Diagnose]> i64 {
  if required == 0 or caller_eff == 0 or effect_is_subset_rigid(required, caller_eff) { 0 }
  else { typeck_report_effect_unavailable(required, src, pos, len, caller_eff, tt, context, origin) 1 }
}

pub(package) fn check_effect_hash_available(eff_hash: i64, src: i64, pos: i64, caller_eff: i64, tt: i64, context: str) -[Diagnose]> i64 {
  if caller_eff == 0 { 0 }
  else {
    -- A bare operation selects the unique in-scope atom by head. Preserve
    -- that exact atom in the diagnostic whenever one exists.
    let atom = effect_sig_find_atom_by_head(caller_eff, eff_hash)
    if atom != 0 { 0 }
    else { check_effect_sig_available(effect_sig_one(eff_hash), src, pos, 1, caller_eff, tt, context, DiagnosticLocationNone) }
  }
}

pub(package) fn check_effect_atom_available(atom: i64, src: i64, pos: i64, len: i64, caller_eff: i64, tt: i64, context: str, origin: DiagnosticLocation) -[Diagnose]> i64 {
  if atom == 0 { 0 }
  else { check_effect_sig_available(typeck_effect_sig_from_atom(atom), src, pos, len, caller_eff, tt, context, origin) }
}

pub(package) fn effect_ref_with_atom(effect_ref: i64, atom: i64) -> i64 {
  let ident = effect_ref_ident_node(effect_ref)
  let field = effect_ref_field_node(effect_ref)
  let inner = if ident != 0 { ident } else { field }
  let args = if atom == 0 { 0 } else { effect_atom_args(atom) }
  if inner == 0 or args == 0 { effect_ref }
  else { if field != 0 {
    let decl = effect_ref_decl_fact(effect_ref)
    mem_store64_at(field, 32, node_new(3, decl, args, 0, 0))
    field
  } else { node_new(36, args, inner, nlist_len(args), 0) } }
}

pub(package) fn canonicalize_perform_effect_ref(node: i64, atom: i64) -> i64 {
  let current = node_f1(node)
  let canonical = effect_ref_with_atom(current, atom)
  if canonical != current { mem_store64_at(node, 8, canonical) } else { 0 }
  canonical
}

pub(package) fn check_effect_ref_type_arg_count(effect_ref: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  if typeck_effect_ref_is_parameterized(effect_ref) == 0 { 0 }
  else {
    let entry = typeck_effect_ref_entry(effect_ref, src, tt)
    if entry == 0 or mem_load64_at(entry, 16) != 2 { 0 }
    else {
      let tparams = mem_load64_at(entry, 40)
      let expected = if tparams == 0 { 0 } else { nlist_len(tparams) }
      let args = typeck_effect_ref_type_args(effect_ref)
      let actual = if args == 0 { 0 } else { nlist_len(args) }
      if expected == actual { 0 }
      else {
        typeck_error_maybe(src, typeck_effect_ref_name_start(effect_ref), "type error: effect type argument count mismatch")
        1
      }
    }
  }
}

pub(package) fn typeck_effect_atom_entry(atom: i64, tt: i64) -> i64 {
  if atom == 0 { 0 }
  else { if ty_tag(atom) == 25 { ttable_lookup_decl_fact(tt, ty_f1(atom)) }
  else { if ty_tag(atom) == 11 { ttable_find_entry_by_hash_kind(tt, effect_atom_head(atom), 2) }
  else { 0 } } }
}

pub(package) fn check_effect_atom_trait_bounds_at(
  atom: i64,
  src: i64,
  diag_start: i64,
  diag_len: i64,
  tt: i64
) -[Conformance, Diagnose]> i64 {
  let entry = typeck_effect_atom_entry(atom, tt)
  if entry == 0 { 0 }
  else {
    let tparams = ttable_entry_tparams(entry)
    let args = effect_atom_args(atom)
    let expected = if tparams == 0 { 0 } else { nlist_len(tparams) }
    let actual = if args == 0 { 0 } else { nlist_len(args) }
    if expected == 0 or expected != actual { 0 }
    else {
      check_trait_bounds_at(
        tparams, args, src, diag_start, diag_len,
        ttable_entry_source(entry), tt, "effect argument"
      )
    }
  }
}

pub(package) fn check_effect_sig_trait_bounds_at(
  effects: i64,
  src: i64,
  diag_start: i64,
  diag_len: i64,
  tt: i64
) -[Conformance, Diagnose]> i64 {
  if effects == 0 or ty_tag(effects) != 10 { 0 }
  else {
    let atoms = ty_f1(effects)
    let mut errors = 0
    for i in 0..nlist_len(atoms) {
      errors = errors + check_effect_atom_trait_bounds_at(nlist_get(atoms, i), src, diag_start, diag_len, tt)
    }
    errors
  }
}

pub(package) fn check_effect_ref_trait_bounds(effect_ref: i64, src: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  if typeck_effect_ref_is_parameterized(effect_ref) == 0 { 0 }
  else {
    check_effect_atom_trait_bounds_at(
      typeck_effect_ref_atom(effect_ref, src), src,
      typeck_effect_ref_name_start(effect_ref), typeck_effect_ref_name_len(effect_ref), tt
    )
  }
}

-- Qualified variant construction (Type.Variant / Type.Variant(args)) is
-- not a language form — kernel.md §3.2: constructors are bare values.
-- Detect a bare variant-type-name receiver so the checker rejects the
-- shape with a targeted diagnostic instead of letting it fall through
-- to the dynamic-perform / unknown-identifier paths (which used to
-- typecheck clean and BRK at runtime).
pub(package) fn ident_names_variant_type(node: i64, env: i64, src: i64, tt: i64) -> i64 {
  if node_tag(node) != 2 { 0 }
  else { if tenv_lookup(env, src, node_f1(node), node_f2(node)) != 0 { 0 }
  else {
    let entry = ttable_lookup(tt, src, node_f1(node), node_f2(node))
    if entry == 0 { 0 }
    else { if mem_load64_at(entry + 16, 0) == 1 { 1 } else { 0 } }
  } }
}

pub(package) fn check_effect_perform_available(node: i64, src: i64, caller_eff: i64, tt: i64) -[Diagnose]> i64 {
  let lhs = node_f1(node)
  if typeck_is_effect_ref(lhs, src, tt) {
    let eff_hash = typeck_effect_ref_name_hash(lhs, src)
    let entry = typeck_effect_ref_entry(lhs, src, tt)
    let op = lookup_effect_perform_op(node, src, tt)
    let visibility = if entry == 0 or op == 0 { 0 }
      else { check_effect_operation_visible(entry, op, src, node_f2(node), tt) }
    let origin = if entry == 0 or op == 0 { DiagnosticLocationNone }
      else { typeck_source_location(mem_load64_at(entry, 48), node_f1(op), node_f2(op)) }
    let availability = if typeck_effect_ref_is_parameterized(lhs) == 1 {
      check_effect_atom_available(
        typeck_effect_ref_atom(lhs, src), src, typeck_effect_ref_name_start(lhs), typeck_effect_ref_name_len(lhs), caller_eff, tt,
        "effect operation", origin
      )
    } else { if effect_sig_head_is_ambiguous(caller_eff, eff_hash) == 1 {
      typeck_error_maybe(src, typeck_effect_ref_name_start(lhs), "type error: ambiguous effect atom; qualify the operation")
      1
    } else {
      let atom = effect_sig_find_atom_by_head(caller_eff, eff_hash)
      let checked = if atom != 0 { 0 }
        else { check_effect_sig_available(effect_sig_one(eff_hash), src, typeck_effect_ref_name_start(lhs), typeck_effect_ref_name_len(lhs), caller_eff, tt, "effect operation", origin) }
      if atom != 0 { canonicalize_perform_effect_ref(node, atom) } else { 0 }
      checked
    } }
    visibility + availability + check_effect_ref_type_arg_count(node_f1(node), src, tt)
  } else { 0 }
}

pub(package) fn lookup_effect_perform_op(node: i64, src: i64, tt: i64) -> i64 {
  let lhs = node_f1(node)
  if tt == 0 { 0 }
  else {
    if typeck_is_effect_ref(lhs, src, tt) {
      let entry = typeck_effect_ref_entry(lhs, src, tt)
      if entry == 0 { 0 }
      else {
        let entry_src = mem_load64_at(entry, 48)
        let op_hash = effect_name_hash(src, node_f2(node), node_f3(node))
        let nops = mem_load64_at(entry, 24)
        let ops = mem_load64_at(entry, 32)
        let mut i = 0
        let mut result = 0
        while i < nops {
          let op = nlist_get(ops, i)
          let op_name_hash = effect_name_hash(entry_src, node_f1(op), node_f2(op))
          if op_name_hash == op_hash {
            result = op
            i = nops
          } else { i = i + 1 }
        }
        result
      }
    } else { 0 }
  }
}

pub(package) fn typeck_effect_operation_declaration(entry: i64, op: i64, tt: i64) -> i64 {
  if entry == 0 or op == 0 { 0 }
  else {
    let effect_src = ttable_entry_source(entry)
    let owner = module_decl_fact_find(
      tt, effect_src, module_decl_namespace_effect(), effect_src,
      ttable_entry_name_ptr(entry) - effect_src, ttable_entry_name_len(entry)
    )
    if owner == 0 { 0 }
    else {
      module_decl_fact_find_member(
        tt, owner, module_decl_namespace_effect_operation(),
        effect_src, node_f1(op), node_f2(op)
      )
    }
  }
}

pub(package) fn typeck_effect_operation_visible(entry: i64, op: i64, caller_src: i64, tt: i64) -> bool {
  let declaration = typeck_effect_operation_declaration(entry, op, tt)
  if declaration == 0 { true }
  else {
    let caller_module = module_fact_find_source(tt, caller_src)
    module_decl_fact_visible_from(tt, declaration, caller_module) == 1
  }
}

pub(package) fn check_effect_operation_visible(entry: i64, op: i64, caller_src: i64, position: i64, tt: i64) -[Diagnose]> i64 {
  if typeck_effect_operation_visible(entry, op, caller_src, tt) { 0 }
  else {
    typeck_error_maybe(caller_src, position, "type error: effect operation is not visible from this module")
    1
  }
}

pub(package) fn typeck_effect_entry_has_hidden_operations(entry: i64, caller_src: i64, tt: i64) -> bool {
  if entry == 0 { false }
  else {
    let ops = ttable_entry_items(entry)
    let mut hidden = false
    let mut index = 0
    while index < ttable_entry_item_count(entry) and not hidden {
      let op = nlist_get(ops, index)
      if node_tag(op) == 31 and not typeck_effect_operation_visible(entry, op, caller_src, tt) {
        hidden = true
      } else { index = index + 1 }
    }
    hidden
  }
}

-- parameterized effects: substitution instantiating a generic effect's op signatures from a
-- parameterized atom's args. 0 when the effect is not generic or the atom
-- carries no args (op types then pass through unchanged).
pub(package) fn effect_entry_atom_subst(entry: i64, atom: i64) -> i64 {
  if entry == 0 { 0 }
  else {
    let tparams = mem_load64_at(entry, 40)
    let args = if atom == 0 { 0 } else { ty_f2(atom) }
    if tparams != 0 and args != 0 { build_subst(tparams, args) } else { 0 }
  }
}

-- parameterized effects: the instantiating substitution for a perform site: the atom comes
-- from the enclosing function's declared effect sig (ttable slot), found
-- by head. Direct performs under a handle whose enclosing sig lacks the
-- atom get no substitution (op TypeVars stay opaque) — recorded generic-effect substitution debt.
pub(package) fn effect_perform_site_subst(node: i64, src: i64, tt: i64) -> i64 {
  let lhs = node_f1(node)
  if tt == 0 { 0 }
  else {
    let ident = effect_ref_ident_node(lhs)
    let decl = if effect_ref_field_node(lhs) == 0 { 0 } else { effect_ref_decl_fact(lhs) }
    let entry = if decl != 0 { ttable_lookup_decl_fact(tt, decl) }
      else { if ident == 0 { 0 } else { ttable_lookup(tt, src, node_f1(ident), node_f2(ident)) } }
    if entry == 0 { 0 }
    else { if mem_load64_at(entry, 16) != 2 { 0 }
    else {
      let eff_hash = typeck_effect_ref_name_hash(lhs, src)
      let atom = if typeck_effect_ref_is_parameterized(lhs) == 1 { typeck_effect_ref_atom(lhs, src) }
        else { effect_sig_find_atom_by_head(ttable_get_current_fn_eff(tt), eff_hash) }
      effect_entry_atom_subst(entry, atom)
    } }
  }
}

pub(package) fn check_effect_perform_args(node: i64, env: i64, ft: i64, src: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let op = lookup_effect_perform_op(node, src, tt)
  if op == 0 {
    typeck_error_maybe(src, node_f2(node), "type error: unknown effect operation")
    1
  }
  else {
    let params = node_f3(op)
    let args = node_f4(node)
    let nparams = nlist_len(params)
    let nargs = nlist_len(args)
    let effect_entry = typeck_effect_ref_entry(node_f1(node), src, tt)
    let effect_src = if effect_entry == 0 { src } else { ttable_entry_source(effect_entry) }
    let mut errors = 0
    errors = errors + check_arity(nparams, nargs, src, node_f2(node))
    let s = effect_perform_site_subst(node, src, tt)
    let ncheck = if nargs < nparams { nargs } else { nparams }
    for i in 0..ncheck {
      let param = nlist_get(params, i)
      let param_ty = node_f3(param)
      if param_ty != 0 {
        let inst_ty = if s != 0 { ty_subst(param_ty, s) } else { param_ty }
        errors = errors + check_arg_against_param_at(
          nlist_get(args, i), inst_ty, env, ft, src, tt, node_f2(node),
          typeck_source_location(effect_src, node_f1(param), node_f2(param))
        )
      } else { errors = errors }
    }
    -- Borrow loans created by one perform overlap exactly as they do for an
    -- ordinary call: dispatch cannot make an exclusive and another loan of
    -- the same owner coexist safely.
    errors = errors + check_borrow_call_conflicts(args, nargs, src, node_f2(node))
    errors
  }
}

pub(package) fn effect_op_params_have_borrow(params: i64, subst: i64) -> i64 {
  let mut found = 0
  let mut i = 0
  while i < nlist_len(params) and found == 0 {
    let raw_ty = node_f3(nlist_get(params, i))
    let param_ty = if raw_ty != 0 and subst != 0 { ty_subst(raw_ty, subst) } else { raw_ty }
    if ty_is_borrow(param_ty) { found = 1 } else { i = i + 1 }
  }
  found
}

pub(package) fn typeck_instantiated_effect_op_type(op: i64, atom: i64, entry: i64) -> i64 {
  let params = node_f3(op)
  let subst = effect_entry_atom_subst(entry, atom)
  let param_types = nlist_new()
  for i in 0..nlist_len(params) {
    let raw_ty = node_f3(nlist_get(params, i))
    nlist_add(param_types, if raw_ty != 0 and subst != 0 { ty_subst(raw_ty, subst) } else { if raw_ty == 0 { ty_any() } else { raw_ty } })
  }
  let raw_ret = effect_op_ret_type(op)
  let ret = if raw_ret != 0 and subst != 0 { ty_subst(raw_ret, subst) } else { if raw_ret == 0 { ty_any() } else { raw_ret } }
  let effects = nlist_new()
  if atom != 0 { nlist_add(effects, atom) } else { 0 }
  ty_fn(param_types, ret, ty_effect_sig(effects))
}

pub(package) fn typeck_record_effect_perform_facts(node: i64, env: i64, src: i64, tt: i64) -> i64 {
  let effect_ref = node_f1(node)
  let entry = typeck_effect_ref_entry(effect_ref, src, tt)
  let op = lookup_effect_perform_op(node, src, tt)
  if entry == 0 or op == 0 or not typeck_effect_operation_visible(entry, op, src, tt) { 0 }
  else {
    let atom = typeck_effect_ref_atom(effect_ref, src)
    let effect_start = typeck_effect_ref_name_start(effect_ref)
    let effect_len = typeck_effect_ref_name_len(effect_ref)
    let entry_src = ttable_entry_source(entry)
    let op_ty = typeck_instantiated_effect_op_type(op, atom, entry)
    ttable_add_semantic_symbol_fact(
      tt, src, effect_start, effect_len,
      entry_src, ttable_entry_name_ptr(entry) - entry_src, ttable_entry_name_len(entry),
      op_ty, ttable_get_tparams(tt), semantic_symbol_kind_effect_atom(), env, atom
    )
    ttable_add_semantic_symbol_fact(
      tt, src, node_f2(node), node_f3(node),
      entry_src, node_f1(op), node_f2(op),
      op_ty, ttable_get_tparams(tt), semantic_symbol_kind_effect_operation(), env, atom
    )
    1
  }
}

pub(package) fn check_arity(expected: i64, actual: i64, src: i64, pos: i64) -[Diagnose]> i64 {
  if expected == actual { 0 }
  else {
    typeck_error_maybe(src, pos, "type error: arity mismatch")
    1
  }
}

pub(package) fn bind_capture_pattern(pat: i64, local_env: i64, src: i64) -> i64 {
  let tag = node_tag(pat)
  match tag {
    18 -> tenv_bind(local_env, src, node_f1(pat), node_f2(pat), ty_any())
    60 -> tenv_bind(local_env, src, node_f1(pat), node_f2(pat), node_f3(pat))
    20 -> {
      let b_ns = node_f3(pat)
      let b_nl = node_f4(pat)
      if b_nl > 0 {
        tenv_bind(local_env, src, b_ns, b_nl, ty_any())
      } else { if b_nl < 0 {
        let bindings = b_ns
        let nb = 0 - b_nl
        let mut result = local_env
        for i in 0..nb {
          result = bind_capture_pattern(nlist_get(bindings, i), result, src)
        }
        result
      } else { local_env } }
    }
    67 -> bind_capture_pattern(ctor_pattern_raw(pat), local_env, src)
    64 -> {
      let fields = node_f1(pat)
      let mut result = local_env
      for i in 0..node_f2(pat) {
        result = bind_capture_pattern(node_f3(nlist_get(fields, i)), result, src)
      }
      result
    }
    65 -> {
      let items = node_f1(pat)
      let mut result = local_env
      for i in 0..node_f2(pat) {
        result = bind_capture_pattern(nlist_get(items, i), result, src)
      }
      result
    }
    _ -> local_env
  }
}

pub(package) fn bind_capture_params(params: i64, nparams: i64, local_env: i64, src: i64) -> i64 {
  let mut result = local_env
  for i in 0..nparams {
    let p = nlist_get(params, i)
    result = tenv_bind(result, src, node_f1(p), node_f2(p), ty_any())
  }
  result
}

pub(package) fn check_mut_capture_name(ns: i64, nl: i64, outer_env: i64, local_env: i64, src: i64, allow_scoped_borrow: i64) -[Diagnose]> i64 {
  if tenv_lookup(local_env, src, ns, nl) != 0 { 0 }
  else {
    let outer_ty = tenv_lookup(outer_env, src, ns, nl)
    if ty_is_borrow(outer_ty) and allow_scoped_borrow == 0 {
      typeck_error_maybe(src, ns, "type error: borrowed resource cannot be captured by closure")
      1
    } else { if tenv_lookup_mutable(outer_env, src, ns, nl) == 1 {
      typeck_error_maybe(src, ns, "type error: cannot capture mut binding")
      1
    } else { 0 } }
  }
}

pub(package) fn check_mut_capture_ident(node: i64, outer_env: i64, local_env: i64, src: i64, allow_scoped_borrow: i64) -[Diagnose]> i64 {
  check_mut_capture_name(node_f1(node), node_f2(node), outer_env, local_env, src, allow_scoped_borrow)
}

pub(package) fn check_mut_captures_list(list: i64, n: i64, outer_env: i64, local_env: i64, src: i64, allow_scoped_borrow: i64) -[Diagnose]> i64 {
  let mut errors = 0
  for i in 0..n {
    errors = errors + check_mut_captures(nlist_get(list, i), outer_env, local_env, src, allow_scoped_borrow)
  }
  errors
}

pub(package) fn check_mut_captures(node: i64, outer_env: i64, local_env: i64, src: i64, allow_scoped_borrow: i64) -[Diagnose]> i64 {
  if node == 0 { 0 }
  else {
    let tag = node_tag(node)
    match tag {
      2 -> check_mut_capture_ident(node, outer_env, local_env, src, allow_scoped_borrow)
      3 -> check_mut_captures(node_f2(node), outer_env, local_env, src, allow_scoped_borrow) + check_mut_captures(node_f3(node), outer_env, local_env, src, allow_scoped_borrow)
      4 -> check_mut_capture_name(node_f1(node), node_f2(node), outer_env, local_env, src, allow_scoped_borrow) + check_mut_captures_list(node_f3(node), node_f4(node), outer_env, local_env, src, allow_scoped_borrow)
      5 -> check_mut_captures(node_f1(node), outer_env, local_env, src, allow_scoped_borrow) + check_mut_captures(node_f2(node), outer_env, local_env, src, allow_scoped_borrow) + check_mut_captures(node_f3(node), outer_env, local_env, src, allow_scoped_borrow)
      6 -> {
        let val = node_f3(node)
        let body = node_f4(node)
        let new_local = tenv_bind(local_env, src, node_f1(node), node_f2(node), ty_any())
        check_mut_captures(val, outer_env, local_env, src, allow_scoped_borrow) + check_mut_captures(body, outer_env, new_local, src, allow_scoped_borrow)
      }
      7 -> check_mut_captures(node_f1(node), outer_env, local_env, src, allow_scoped_borrow) + check_mut_captures(node_f2(node), outer_env, local_env, src, allow_scoped_borrow)
      10 -> check_mut_captures(node_f1(node), outer_env, local_env, src, allow_scoped_borrow) + check_mut_captures(node_f2(node), outer_env, local_env, src, allow_scoped_borrow)
      11 -> {
        let val = node_f3(node)
        let body = node_f4(node)
        let new_local = tenv_bind(local_env, src, node_f1(node), node_f2(node), ty_any())
        check_mut_captures(val, outer_env, local_env, src, allow_scoped_borrow) + check_mut_captures(body, outer_env, new_local, src, allow_scoped_borrow)
      }
      12 -> check_mut_capture_name(node_f1(node), node_f2(node), outer_env, local_env, src, allow_scoped_borrow) + check_mut_captures(node_f3(node), outer_env, local_env, src, allow_scoped_borrow)
      57 -> check_mut_captures(node_f1(node), outer_env, local_env, src, allow_scoped_borrow) + check_mut_captures(node_f2(node), outer_env, local_env, src, allow_scoped_borrow)
      13 -> check_mut_captures(node_f1(node), outer_env, local_env, src, allow_scoped_borrow)
      59 -> check_mut_captures(node_f1(node), outer_env, local_env, src, allow_scoped_borrow)
      60 -> check_mut_captures(node_f1(node), outer_env, local_env, src, allow_scoped_borrow) + check_mut_captures(node_f2(node), outer_env, local_env, src, allow_scoped_borrow)
      61 -> check_mut_captures(node_f1(node), outer_env, local_env, src, allow_scoped_borrow) + check_mut_captures(node_f2(node), outer_env, local_env, src, allow_scoped_borrow) + check_mut_captures(node_f3(node), outer_env, local_env, src, allow_scoped_borrow)
      62 -> check_mut_captures(node_f1(node), outer_env, local_env, src, allow_scoped_borrow) + check_mut_captures(node_f2(node), outer_env, local_env, src, allow_scoped_borrow) + check_mut_captures(node_f3(node), outer_env, local_env, src, allow_scoped_borrow)
      14 -> {
        let fields = node_f3(node)
        let nfields = node_f4(node)
        let mut errors = 0
        for i in 0..nfields {
          errors = errors + check_mut_captures(node_f3(nlist_get(fields, i)), outer_env, local_env, src, allow_scoped_borrow)
        }
        errors
      }
      63 -> check_mut_captures(node_f1(node), outer_env, local_env, src, allow_scoped_borrow) + check_mut_captures_list(record_field_expr_nodes(node_f2(node), node_f3(node)), node_f3(node), outer_env, local_env, src, allow_scoped_borrow)
      58 -> check_mut_captures_list(node_f1(node), node_f2(node), outer_env, local_env, src, allow_scoped_borrow)
      15 -> {
        let scrutinee = node_f1(node)
        let arms = node_f2(node)
        let n = node_f3(node)
        let mut errors = check_mut_captures(scrutinee, outer_env, local_env, src, allow_scoped_borrow)
        for i in 0..n {
          let arm = nlist_get(arms, i)
          let arm_local = bind_capture_pattern(node_f1(arm), local_env, src)
          let guard = node_f3(arm)
          if guard != 0 { errors = errors + check_mut_captures(guard, outer_env, arm_local, src, allow_scoped_borrow) } else { errors = errors }
          errors = errors + check_mut_captures(node_f2(arm), outer_env, arm_local, src, allow_scoped_borrow)
        }
        errors
      }
      22 -> check_mut_captures(node_f1(node), outer_env, local_env, src, allow_scoped_borrow)
      25 -> check_mut_captures(node_f1(node), outer_env, local_env, src, allow_scoped_borrow)
      26 -> check_mut_captures(node_f1(node), outer_env, local_env, src, allow_scoped_borrow)
      29 -> 0
      32 -> check_mut_captures(node_f1(node), outer_env, local_env, src, allow_scoped_borrow) + check_mut_captures_list(node_f4(node), nlist_len(node_f4(node)), outer_env, local_env, src, allow_scoped_borrow)
      33 -> {
        let clauses = node_f2(node)
        let nclauses = node_f3(node)
        let mut errors = check_mut_captures(node_f1(node), outer_env, local_env, src, allow_scoped_borrow)
        for ci in 0..nclauses {
          let clause = nlist_get(clauses, ci)
          let params = node_f2(clause)
          let clause_local = bind_capture_params(params, nlist_len(params), local_env, src)
          errors = errors + check_mut_captures(node_f3(clause), outer_env, clause_local, src, allow_scoped_borrow)
        }
        errors
      }
      35 -> check_mut_captures(node_f1(node), outer_env, local_env, src, allow_scoped_borrow)
      36 -> {
        let call_node = node_f2(node)
        let target_errors = if node_tag(call_node) == 4 { check_mut_capture_name(node_f1(call_node), node_f2(call_node), outer_env, local_env, src, allow_scoped_borrow) } else { 0 }
        target_errors + check_mut_captures_list(generic_call_inner_args(call_node), generic_call_inner_arg_count(call_node), outer_env, local_env, src, allow_scoped_borrow)
      }
      37 -> {
        let inner = node_f1(node)
        let val = node_f3(inner)
        let body = node_f4(inner)
        let new_local = tenv_bind(local_env, src, node_f1(inner), node_f2(inner), ty_any())
        check_mut_captures(val, outer_env, local_env, src, allow_scoped_borrow) + check_mut_captures(body, outer_env, new_local, src, allow_scoped_borrow)
      }
      41 -> check_mut_captures(node_f1(node), outer_env, local_env, src, allow_scoped_borrow) + check_mut_captures_list(node_f3(node), nlist_len(node_f3(node)), outer_env, local_env, src, allow_scoped_borrow)
      45 -> check_mut_captures(node_f1(node), outer_env, local_env, src, allow_scoped_borrow)
      46 -> check_mut_captures(node_f1(node), outer_env, local_env, src, allow_scoped_borrow) + check_mut_captures(node_f2(node), outer_env, local_env, src, allow_scoped_borrow)
      47 -> {
        let loop_local = tenv_bind(local_env, src, node_f1(node), node_f2(node), ty_any())
        check_mut_captures(node_f3(node), outer_env, local_env, src, allow_scoped_borrow) + check_mut_captures(node_f4(node), outer_env, loop_local, src, allow_scoped_borrow)
      }
      48 -> check_mut_captures(node_f1(node), outer_env, local_env, src, allow_scoped_borrow)
      49 -> check_mut_captures(node_f1(node), outer_env, local_env, src, allow_scoped_borrow)
      52 -> check_mut_captures(node_f1(node), outer_env, local_env, src, allow_scoped_borrow) + check_mut_captures(node_f2(node), outer_env, local_env, src, allow_scoped_borrow)
      _ -> 0
    }
  }
}

pub(package) fn check_closure_mut_captures(body: i64, params: i64, nparams: i64, outer_env: i64, src: i64) -[Diagnose]> i64 {
  let local_env = bind_capture_params(params, nparams, tenv_new(), src)
  check_mut_captures(body, outer_env, local_env, src, 0)
}

pub(package) fn check_immediate_handler_captures(body: i64, params: i64, nparams: i64, outer_env: i64, src: i64) -[Diagnose]> i64 {
  let local_env = bind_capture_params(params, nparams, tenv_new(), src)
  check_mut_captures(body, outer_env, local_env, src, 1)
}

pub(package) fn check_resume_capture_list(list: i64, n: i64, src: i64, lambda_depth: i64) -[Diagnose]> i64 {
  let mut errors = 0
  for i in 0..n {
    errors = errors + check_resume_captures(nlist_get(list, i), src, lambda_depth)
  }
  errors
}

pub(package) fn check_resume_captures(node: i64, src: i64, lambda_depth: i64) -[Diagnose]> i64 {
  if node == 0 { 0 }
  else {
    let tag = node_tag(node)
    match tag {
      3 -> check_resume_captures(node_f2(node), src, lambda_depth) + check_resume_captures(node_f3(node), src, lambda_depth)
      4 -> check_resume_capture_list(node_f3(node), node_f4(node), src, lambda_depth)
      5 -> check_resume_captures(node_f1(node), src, lambda_depth) + check_resume_captures(node_f2(node), src, lambda_depth) + check_resume_captures(node_f3(node), src, lambda_depth)
      6 -> check_resume_captures(node_f3(node), src, lambda_depth) + check_resume_captures(node_f4(node), src, lambda_depth)
      7 -> check_resume_captures(node_f1(node), src, lambda_depth) + check_resume_captures(node_f2(node), src, lambda_depth)
      10 -> check_resume_captures(node_f1(node), src, lambda_depth) + check_resume_captures(node_f2(node), src, lambda_depth)
      11 -> check_resume_captures(node_f3(node), src, lambda_depth) + check_resume_captures(node_f4(node), src, lambda_depth)
      12 -> check_resume_captures(node_f3(node), src, lambda_depth)
      57 -> check_resume_captures(node_f1(node), src, lambda_depth) + check_resume_captures(node_f2(node), src, lambda_depth)
      13 -> check_resume_captures(node_f1(node), src, lambda_depth)
      59 -> check_resume_captures(node_f1(node), src, lambda_depth)
      60 -> check_resume_captures(node_f1(node), src, lambda_depth) + check_resume_captures(node_f2(node), src, lambda_depth)
      61 -> check_resume_captures(node_f1(node), src, lambda_depth) + check_resume_captures(node_f2(node), src, lambda_depth) + check_resume_captures(node_f3(node), src, lambda_depth)
      62 -> check_resume_captures(node_f1(node), src, lambda_depth) + check_resume_captures(node_f2(node), src, lambda_depth) + check_resume_captures(node_f3(node), src, lambda_depth)
      14 -> {
        let fields = node_f3(node)
        let nfields = node_f4(node)
        let mut errors = 0
        for ri in 0..nfields {
          errors = errors + check_resume_captures(node_f3(nlist_get(fields, ri)), src, lambda_depth)
        }
        errors
      }
      63 -> check_resume_captures(node_f1(node), src, lambda_depth) + check_resume_capture_list(record_field_expr_nodes(node_f2(node), node_f3(node)), node_f3(node), src, lambda_depth)
      58 -> check_resume_capture_list(node_f1(node), node_f2(node), src, lambda_depth)
      15 -> {
        let arms = node_f2(node)
        let n = node_f3(node)
        let mut errors = check_resume_captures(node_f1(node), src, lambda_depth)
        for i in 0..n {
          let arm = nlist_get(arms, i)
          let guard = node_f3(arm)
          if guard != 0 { errors = errors + check_resume_captures(guard, src, lambda_depth) } else { errors = errors }
          errors = errors + check_resume_captures(node_f2(arm), src, lambda_depth)
        }
        errors
      }
      22 -> check_resume_captures(node_f1(node), src, lambda_depth)
      25 -> check_resume_captures(node_f1(node), src, lambda_depth)
      26 -> check_resume_captures(node_f1(node), src, lambda_depth)
      29 -> check_resume_captures(node_f2(node), src, lambda_depth + 1)
      32 -> check_resume_captures(node_f1(node), src, lambda_depth) + check_resume_capture_list(node_f4(node), nlist_len(node_f4(node)), src, lambda_depth)
      33 -> check_resume_captures(node_f1(node), src, lambda_depth)
      35 -> {
        let nested = check_resume_captures(node_f1(node), src, lambda_depth)
        if lambda_depth > 0 {
          let pos = expr_diag_pos(node_f1(node))
          typeck_error_maybe(src, pos, "type error: cannot capture resume")
          nested + 1
        } else { nested }
      }
      36 -> {
        let call_node = node_f2(node)
        check_resume_capture_list(generic_call_inner_args(call_node), generic_call_inner_arg_count(call_node), src, lambda_depth)
      }
      37 -> check_resume_captures(node_f1(node), src, lambda_depth)
      41 -> check_resume_captures(node_f1(node), src, lambda_depth) + check_resume_capture_list(node_f3(node), nlist_len(node_f3(node)), src, lambda_depth)
      45 -> check_resume_captures(node_f1(node), src, lambda_depth)
      46 -> check_resume_captures(node_f1(node), src, lambda_depth) + check_resume_captures(node_f2(node), src, lambda_depth)
      47 -> check_resume_captures(node_f3(node), src, lambda_depth) + check_resume_captures(node_f4(node), src, lambda_depth)
      48 -> check_resume_captures(node_f1(node), src, lambda_depth)
      49 -> check_resume_captures(node_f1(node), src, lambda_depth)
      52 -> check_resume_captures(node_f1(node), src, lambda_depth) + check_resume_captures(node_f2(node), src, lambda_depth)
      _ -> 0
    }
  }
}

pub(package) fn check_resume_scope_list(list: i64, n: i64, src: i64, in_clause: i64) -[Diagnose]> i64 {
  let mut errors = 0
  for i in 0..n {
    errors = errors + check_resume_scope(nlist_get(list, i), src, in_clause)
  }
  errors
}

pub(package) fn check_resume_scope(node: i64, src: i64, in_clause: i64) -[Diagnose]> i64 {
  if node == 0 { 0 }
  else {
    let tag = node_tag(node)
    match tag {
      3 -> check_resume_scope(node_f2(node), src, in_clause) + check_resume_scope(node_f3(node), src, in_clause)
      4 -> check_resume_scope_list(node_f3(node), node_f4(node), src, in_clause)
      5 -> check_resume_scope(node_f1(node), src, in_clause) + check_resume_scope(node_f2(node), src, in_clause) + check_resume_scope(node_f3(node), src, in_clause)
      6 -> check_resume_scope(node_f3(node), src, in_clause) + check_resume_scope(node_f4(node), src, in_clause)
      7 -> check_resume_scope(node_f1(node), src, in_clause) + check_resume_scope(node_f2(node), src, in_clause)
      10 -> check_resume_scope(node_f1(node), src, in_clause) + check_resume_scope(node_f2(node), src, in_clause)
      11 -> check_resume_scope(node_f3(node), src, in_clause) + check_resume_scope(node_f4(node), src, in_clause)
      12 -> check_resume_scope(node_f3(node), src, in_clause)
      57 -> check_resume_scope(node_f1(node), src, in_clause) + check_resume_scope(node_f2(node), src, in_clause)
      13 -> check_resume_scope(node_f1(node), src, in_clause)
      59 -> check_resume_scope(node_f1(node), src, in_clause)
      60 -> check_resume_scope(node_f1(node), src, in_clause) + check_resume_scope(node_f2(node), src, in_clause)
      61 -> check_resume_scope(node_f1(node), src, in_clause) + check_resume_scope(node_f2(node), src, in_clause) + check_resume_scope(node_f3(node), src, in_clause)
      62 -> check_resume_scope(node_f1(node), src, in_clause) + check_resume_scope(node_f2(node), src, in_clause) + check_resume_scope(node_f3(node), src, in_clause)
      14 -> {
        let fields = node_f3(node)
        let nfields = node_f4(node)
        let mut errors = 0
        for ri in 0..nfields {
          errors = errors + check_resume_scope(node_f3(nlist_get(fields, ri)), src, in_clause)
        }
        errors
      }
      63 -> check_resume_scope(node_f1(node), src, in_clause) + check_resume_scope_list(record_field_expr_nodes(node_f2(node), node_f3(node)), node_f3(node), src, in_clause)
      58 -> check_resume_scope_list(node_f1(node), node_f2(node), src, in_clause)
      15 -> {
        let arms = node_f2(node)
        let n = node_f3(node)
        let mut errors = check_resume_scope(node_f1(node), src, in_clause)
        for i in 0..n {
          let arm = nlist_get(arms, i)
          let guard = node_f3(arm)
          if guard != 0 { errors = errors + check_resume_scope(guard, src, in_clause) } else { errors = errors }
          errors = errors + check_resume_scope(node_f2(arm), src, in_clause)
        }
        errors
      }
      22 -> check_resume_scope(node_f1(node), src, in_clause)
      25 -> check_resume_scope(node_f1(node), src, in_clause)
      26 -> check_resume_scope(node_f1(node), src, in_clause)
      29 -> check_resume_scope(node_f2(node), src, in_clause)
      32 -> check_resume_scope(node_f1(node), src, in_clause) + check_resume_scope_list(node_f4(node), nlist_len(node_f4(node)), src, in_clause)
      33 -> {
        let clauses = node_f2(node)
        let nclauses = node_f3(node)
        let mut errors = check_resume_scope(node_f1(node), src, in_clause)
        for ci in 0..nclauses {
          errors = errors + check_resume_scope(node_f3(nlist_get(clauses, ci)), src, 1)
        }
        errors
      }
      35 -> {
        let nested = check_resume_scope(node_f1(node), src, in_clause)
        if in_clause == 0 {
          let pos = expr_diag_pos(node_f1(node))
          typeck_error_maybe(src, pos, "type error: resume outside handler clause")
          nested + 1
        } else { nested }
      }
      36 -> {
        let call_node = node_f2(node)
        check_resume_scope_list(generic_call_inner_args(call_node), generic_call_inner_arg_count(call_node), src, in_clause)
      }
      37 -> check_resume_scope(node_f1(node), src, in_clause)
      41 -> check_resume_scope(node_f1(node), src, in_clause) + check_resume_scope_list(node_f3(node), nlist_len(node_f3(node)), src, in_clause)
      45 -> check_resume_scope(node_f1(node), src, in_clause)
      46 -> check_resume_scope(node_f1(node), src, in_clause) + check_resume_scope(node_f2(node), src, in_clause)
      47 -> check_resume_scope(node_f3(node), src, in_clause) + check_resume_scope(node_f4(node), src, in_clause)
      48 -> check_resume_scope(node_f1(node), src, in_clause)
      49 -> check_resume_scope(node_f1(node), src, in_clause)
      52 -> check_resume_scope(node_f1(node), src, in_clause) + check_resume_scope(node_f2(node), src, in_clause)
      _ -> 0
    }
  }
}


-- Does this clause body contain a resume(...) call (AST tag 35)?
pub(package) fn clause_body_has_resume(node: i64) -> bool {
  if node == 0 { false }
  else {
    let tag = node_tag(node)
    if tag == 35 { true }
    else { if tag == 14 { clause_body_has_resume_list(record_field_expr_nodes(node_f3(node), node_f4(node)), node_f4(node)) }
    else { if tag == 63 { clause_body_has_resume(node_f1(node)) or clause_body_has_resume_list(record_field_expr_nodes(node_f2(node), node_f3(node)), node_f3(node)) }
    else { if tag == 3 { clause_body_has_resume(node_f2(node)) or clause_body_has_resume(node_f3(node)) }
    else { if tag == 4 { clause_body_has_resume_list(node_f3(node), node_f4(node)) }
    else { if tag == 5 { clause_body_has_resume(node_f1(node)) or clause_body_has_resume(node_f2(node)) or clause_body_has_resume(node_f3(node)) }
    else { if tag == 6 { clause_body_has_resume(node_f3(node)) or clause_body_has_resume(node_f4(node)) }
    else { if tag == 7 { clause_body_has_resume(node_f1(node)) or clause_body_has_resume(node_f2(node)) }
    else { if tag == 10 { clause_body_has_resume(node_f1(node)) or clause_body_has_resume(node_f2(node)) }
    else { if tag == 11 { clause_body_has_resume(node_f3(node)) or clause_body_has_resume(node_f4(node)) }
    else { if tag == 12 { clause_body_has_resume(node_f3(node)) }
    else { if tag == 13 or tag == 59 { clause_body_has_resume(node_f1(node)) }
    else { if tag == 60 { clause_body_has_resume(node_f1(node)) or clause_body_has_resume(node_f2(node)) }
    else { if tag == 61 { clause_body_has_resume(node_f1(node)) or clause_body_has_resume(node_f2(node)) or clause_body_has_resume(node_f3(node)) }
    else { if tag == 15 { clause_body_has_resume(node_f1(node)) or clause_body_has_resume_arms(node_f2(node), node_f3(node)) }
    else { if tag == 22 { clause_body_has_resume(node_f1(node)) }
    else { if tag == 25 { clause_body_has_resume(node_f1(node)) }
    else { if tag == 32 { clause_body_has_resume(node_f1(node)) or clause_body_has_resume_list(node_f4(node), nlist_len(node_f4(node))) }
    else { if tag == 36 { clause_body_has_resume(node_f2(node)) }
    else { if tag == 41 { clause_body_has_resume(node_f1(node)) or clause_body_has_resume_list(node_f3(node), nlist_len(node_f3(node))) }
    else { if tag == 57 { clause_body_has_resume(node_f1(node)) or clause_body_has_resume(node_f2(node)) }
    else { if tag == 58 { clause_body_has_resume_list(node_f1(node), node_f2(node)) }
    else { false } } } } } } } } } } } } } } } } } } } } } }
  }
}

pub(package) fn clause_body_has_resume_list(list: i64, n: i64) -> bool {
  let mut found = false
  let mut i = 0
  while i < n {
    if clause_body_has_resume(nlist_get(list, i)) { found = true i = n }
    else { i = i + 1 }
  }
  found
}

pub(package) fn clause_body_has_resume_arms(arms: i64, n: i64) -> bool {
  let mut found = false
  let mut i = 0
  while i < n {
    if clause_body_has_resume(node_f2(nlist_get(arms, i))) { found = true i = n }
    else { i = i + 1 }
  }
  found
}

pub(package) fn check_no_resume_with_continuation_list(list: i64, n: i64, src: i64) -[Diagnose]> i64 {
  let mut errors = 0
  for i in 0..n {
    errors = errors + check_no_resume_with_continuation(nlist_get(list, i), src)
  }
  errors
}

pub(package) fn check_no_resume_with_continuation(node: i64, src: i64) -[Diagnose]> i64 {
  if node == 0 { 0 }
  else {
    match node_tag(node) {
      3 -> check_no_resume_with_continuation(node_f2(node), src) + check_no_resume_with_continuation(node_f3(node), src)
      4 -> check_no_resume_with_continuation_list(node_f3(node), node_f4(node), src)
      5 -> check_no_resume_with_continuation(node_f1(node), src) + check_no_resume_with_continuation(node_f2(node), src) + check_no_resume_with_continuation(node_f3(node), src)
      6 -> check_no_resume_with_continuation(node_f3(node), src) + check_no_resume_with_continuation(node_f4(node), src)
      7 -> check_no_resume_with_continuation(node_f1(node), src) + check_no_resume_with_continuation(node_f2(node), src)
      10 -> check_no_resume_with_continuation(node_f1(node), src) + check_no_resume_with_continuation(node_f2(node), src)
      11 -> check_no_resume_with_continuation(node_f3(node), src) + check_no_resume_with_continuation(node_f4(node), src)
      12 -> check_no_resume_with_continuation(node_f3(node), src)
      57 -> check_no_resume_with_continuation(node_f1(node), src) + check_no_resume_with_continuation(node_f2(node), src)
      13 -> check_no_resume_with_continuation(node_f1(node), src)
      59 -> check_no_resume_with_continuation(node_f1(node), src)
      60 -> check_no_resume_with_continuation(node_f1(node), src) + check_no_resume_with_continuation(node_f2(node), src)
      61 -> check_no_resume_with_continuation(node_f1(node), src) + check_no_resume_with_continuation(node_f2(node), src) + check_no_resume_with_continuation(node_f3(node), src)
      62 -> check_no_resume_with_continuation(node_f1(node), src) + check_no_resume_with_continuation(node_f2(node), src) + check_no_resume_with_continuation(node_f3(node), src)
      14 -> {
        let fields = node_f3(node)
        let nfields = node_f4(node)
        let mut errors = 0
        for ri in 0..nfields {
          errors = errors + check_no_resume_with_continuation(node_f3(nlist_get(fields, ri)), src)
        }
        errors
      }
      63 -> check_no_resume_with_continuation(node_f1(node), src) + check_no_resume_with_continuation_list(record_field_expr_nodes(node_f2(node), node_f3(node)), node_f3(node), src)
      58 -> check_no_resume_with_continuation_list(node_f1(node), node_f2(node), src)
      15 -> {
        let arms = node_f2(node)
        let n = node_f3(node)
        let mut errors = check_no_resume_with_continuation(node_f1(node), src)
        for i in 0..n {
          let arm = nlist_get(arms, i)
          let guard = node_f3(arm)
          if guard != 0 { errors = errors + check_no_resume_with_continuation(guard, src) } else { errors = errors }
          errors = errors + check_no_resume_with_continuation(node_f2(arm), src)
        }
        errors
      }
      22 -> check_no_resume_with_continuation(node_f1(node), src)
      25 -> check_no_resume_with_continuation(node_f1(node), src)
      26 -> check_no_resume_with_continuation(node_f1(node), src)
      29 -> 0
      32 -> check_no_resume_with_continuation(node_f1(node), src) + check_no_resume_with_continuation_list(node_f4(node), nlist_len(node_f4(node)), src)
      33 -> check_no_resume_with_continuation(node_f1(node), src)
      35 -> {
        let nested = check_no_resume_with_continuation(node_f1(node), src)
        let pos = expr_diag_pos(node_f1(node))
        typeck_error_maybe(src, pos, "type error: use continuation binding instead of resume")
        nested + 1
      }
      36 -> {
        let call_node = node_f2(node)
        check_no_resume_with_continuation_list(generic_call_inner_args(call_node), generic_call_inner_arg_count(call_node), src)
      }
      37 -> check_no_resume_with_continuation(node_f1(node), src)
      41 -> check_no_resume_with_continuation(node_f1(node), src) + check_no_resume_with_continuation_list(node_f3(node), nlist_len(node_f3(node)), src)
      45 -> check_no_resume_with_continuation(node_f1(node), src)
      46 -> check_no_resume_with_continuation(node_f1(node), src) + check_no_resume_with_continuation(node_f2(node), src)
      47 -> check_no_resume_with_continuation(node_f3(node), src) + check_no_resume_with_continuation(node_f4(node), src)
      48 -> check_no_resume_with_continuation(node_f1(node), src)
      49 -> check_no_resume_with_continuation(node_f1(node), src)
      52 -> check_no_resume_with_continuation(node_f1(node), src) + check_no_resume_with_continuation(node_f2(node), src)
      _ -> 0
    }
  }
}

pub(package) fn lambda_span(lambda: i64) -> i64 {
  let params = node_f1(lambda)
  if nlist_len(params) > 0 {
    let p = nlist_get(params, 0)
    node_f1(p)
  } else { 0 }
}

pub(package) fn check_lambda_against_fn(lambda: i64, expected: i64, env: i64, ft: i64, src: i64, tt: i64, pos: i64) -[Conformance, Diagnose]> i64 {
  if ty_tag(expected) != 6 { 0 }
  else {
    -- Contextual lambdas are functions in their own right. Generic effect
    -- operations in the body must instantiate from the expected function's
    -- effect signature, not from the enclosing function being checked.
    let saved_fn_eff = ttable_get_current_fn_eff(tt)
    ttable_set_current_fn_eff(tt, ty_f3(expected))
    let params = node_f1(lambda)
    let body = node_f2(lambda)
    let nparams = node_f3(lambda)
    let expected_params = ty_f1(expected)
    let nexpected = nlist_len(expected_params)
    if nparams == 0 and nexpected == 0 {
      mem_store64_at(lambda, 32, lambda_ast_metadata_with_generator_producer(node_f4(lambda)))
    } else { 0 }
    let mut errors = 0
    if typeck_fn_type_has_open_structural_shape(expected) == 1 {
      typeck_error_maybe(src, if pos > 0 { pos } else { lambda_span(lambda) }, "type error: open structural parameters cannot cross a function-value boundary")
      errors = errors + 1
    } else { errors = errors }
    if nparams != nexpected {
      if pos > 0 {
        typeck_error(src, pos, "type error: argument type mismatch")
      } else {
        typeck_error(src, lambda_span(lambda), "type error: argument type mismatch")
      }
      errors = errors + 1
    } else { errors = errors }
    let nbind = if nparams < nexpected { nparams } else { nexpected }
    let mut lambda_env = env
    for i in 0..nbind {
      let p = nlist_get(params, i)
      let expected_param = nlist_get(expected_params, i)
      let ann_ty = node_f3(p)
      let bind_ty = if ann_ty != 0 {
        if not is_subtype(expected_param, ann_ty) {
          typeck_report_type_mismatch(
            src,
            node_f1(p),
            node_f2(p),
            expected_param,
            ann_ty,
            "lambda parameter",
            typeck_source_location(src, if pos > 0 { pos } else { lambda_span(lambda) }, 1),
            tt
          )
          errors = errors + 1
        } else { errors = errors }
        ann_ty
      } else { expected_param }
      -- Contextual checking is the single producer for an unannotated
      -- lambda parameter's exact type. Preserve that fact on the typed
      -- parameter node so lowering can select its ABI lanes and cleanup
      -- obligations after generic specialization. Leaving the parser's
      -- missing-type sentinel here made managed callback parameters lower
      -- as i64 even though the checker had already proved their type.
      if ann_ty == 0 { mem_store64_at(p, 24, bind_ty) } else { 0 }
      lambda_env = tenv_bind_kind(lambda_env, src, node_f1(p), node_f2(p), bind_ty, semantic_symbol_kind_parameter())
      typeck_record_binding_fact(tt, src, node_f1(p), node_f2(p), bind_ty, semantic_symbol_kind_parameter(), lambda_env)
    }
    prepare_expr_contextual(body, ty_f2(expected), lambda_env, ft, src, tt)
    let body_ty = synth(body, lambda_env, ft, src, tt)
    errors = errors + check_closure_mut_captures(body, params, nparams, env, src)
    errors = errors + check_sendability_scoped_par_lambda(lambda, env, ft, src, tt)
    errors = errors + check_expr(body, lambda_env, ft, src, ty_f3(expected), tt)
    if typeck_type_list_contains_unique(expected_params) == 1 or typeck_params_contain_unique(params) == 1 or tenv_contains_unique(env) == 1 {
      errors = errors + check_closure_unique_captures(body, params, nparams, env, src, tt)
      errors = errors + check_unique_param_usage_against_types(params, expected_params, nbind, body, src, tt)
      errors = errors + check_unique_linear_expr(body, lambda_env, ft, src, tt)
    } else { errors = errors }
    errors = errors + check_return_values_at(
      body, lambda_env, ft, src, ty_f2(expected), tt,
      typeck_source_location(src, if pos > 0 { pos } else { lambda_span(lambda) }, 1)
    )
    if type_is_unknown_or_any(body_ty) and ty_contains_opaque(ty_f2(expected)) == 0 { errors = errors }
    else { if expr_matches_type_contextual(body, body_ty, ty_f2(expected), src, ft) != 1 {
      typeck_report_expr_type_mismatch(
        src,
        body,
        ty_f2(expected),
        body_ty,
        "lambda return value",
        typeck_source_location(src, if pos > 0 { pos } else { lambda_span(lambda) }, 1),
        tt
      )
      errors = errors + 1
    } else { errors = errors } }
    ttable_set_current_fn_eff(tt, saved_fn_eff)
    errors
  }
}

pub(package) fn check_lambda_standalone(lambda: i64, env: i64, ft: i64, src: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let params = node_f1(lambda)
  let body = node_f2(lambda)
  let nparams = node_f3(lambda)
  if nparams == 0 {
    mem_store64_at(lambda, 32, lambda_ast_metadata_with_generator_producer(node_f4(lambda)))
  } else { 0 }
  let mut lambda_env = env
  for i in 0..nparams {
    let p = nlist_get(params, i)
    let param_ty = lambda_param_ty(p)
    lambda_env = tenv_bind_kind(lambda_env, src, node_f1(p), node_f2(p), param_ty, semantic_symbol_kind_parameter())
    typeck_record_binding_fact(tt, src, node_f1(p), node_f2(p), param_ty, semantic_symbol_kind_parameter(), lambda_env)
  }
  let body_ty = synth_lambda_body_type(body, lambda_env, ft, src, tt)
  let checked_errors = check_expr(body, lambda_env, ft, src, infer_expr_effects(body, lambda_env, ft, src, tt), tt)
  let unique_errors = if typeck_params_contain_unique(params) == 1 or tenv_contains_unique(env) == 1 {
    check_closure_unique_captures(body, params, nparams, env, src, tt) +
      check_unique_param_usage(params, nparams, body, src, tt) +
      check_unique_linear_expr(body, lambda_env, ft, src, tt)
  } else { 0 }
  let shape_errors = if typeck_params_have_open_structural_shape(params) == 1 {
    typeck_error_maybe(src, lambda_span(lambda), "type error: open structural parameters require a direct named function")
    1
  } else { 0 }
  shape_errors + check_closure_mut_captures(body, params, nparams, env, src) +
    unique_errors +
    checked_errors +
    check_return_values(body, lambda_env, ft, src, body_ty, tt)
}

-- borrow parameters: a successful borrow-parameter check annotates the identifier use with
-- its exact lexical owner. The fact is intentionally attached to the use,
-- not rediscovered from call syntax by the linear checker or lowerer.
-- tag 68: f1=owner tenv entry, f2=exclusive bit, f3=borrow contract type.
pub(package) fn typeck_borrow_use_fact(arg: i64) -> i64 {
  if arg == 0 or node_tag(arg) != 2 { 0 }
  else {
    let fact = node_f3(arg)
    if fact != 0 and node_tag(fact) == 68 { fact } else { 0 }
  }
}

pub(package) fn typeck_mark_borrow_use(arg: i64, owner: i64, param_ty: i64) -> i64 {
  mem_store64_at(arg, 24, node_new(68, owner, ty_borrow_mutable(param_ty), param_ty, 0))
  0
}

pub(package) fn check_arg_against_borrow_param(arg: i64, param_ty: i64, env: i64, src: i64, pos: i64, expected_origin: DiagnosticLocation, tt: i64) -[Conformance, Diagnose]> i64 {
  if node_tag(arg) != 2 {
    typeck_error_maybe(src, expr_diag_pos(arg), "type error: borrow requires a named linear owner binding")
    1
  } else {
    let owner = tenv_find_entry(env, src, node_f1(arg), node_f2(arg))
    if owner == 0 {
      typeck_error_maybe(src, expr_diag_pos(arg), "type error: borrow requires a named linear owner binding")
      1
    } else {
      let actual_ty = tenv_entry_type(owner)
      let actual_is_owned = ty_is_owned(actual_ty)
      let actual_is_unique = ty_is_unique(actual_ty)
      let actual_is_borrow = ty_is_borrow(actual_ty)
      let actual_is_slice_view = ty_is_slice(actual_ty)
      let actual_is_shared_managed = not actual_is_owned and not actual_is_unique and
        not actual_is_borrow and ty_value_has_release_lane(actual_ty) == 1
      if not actual_is_owned and not actual_is_unique and not actual_is_borrow and
        not actual_is_slice_view and not actual_is_shared_managed {
        typeck_error_maybe(src, expr_diag_pos(arg), "type error: borrow requires a named owner or slice-view binding")
        1
      } else {
        let actual_inner = if actual_is_owned { ty_owned_inner(actual_ty) }
          else { if actual_is_unique { ty_unique_inner(actual_ty) }
          else { if actual_is_borrow { ty_borrow_inner(actual_ty) } else { actual_ty } } }
        if not ty_eq(actual_inner, ty_borrow_inner(param_ty)) {
          typeck_report_expr_type_mismatch(src, arg, ty_borrow_inner(param_ty), actual_inner, "borrowed argument", expected_origin, tt)
          1
        } else { if actual_is_slice_view and
          (ty_borrow_mutable(param_ty) == 1 or ty_slice_mutable(actual_ty) == 1 or ty_slice_mutable(ty_borrow_inner(param_ty)) == 1) {
          typeck_error_maybe(src, expr_diag_pos(arg), "type error: scoped slice reborrows must be immutable")
          1
        } else { if ty_borrow_mutable(param_ty) == 1 and actual_is_shared_managed {
          typeck_error_maybe(src, expr_diag_pos(arg), "type error: exclusive borrow requires a unique or owned mutable binding")
          1
        } else { if ty_borrow_mutable(param_ty) == 1 and actual_is_borrow and ty_borrow_mutable(actual_ty) == 0 {
          typeck_error_maybe(src, expr_diag_pos(arg), "type error: shared resource borrow cannot be forwarded as exclusive")
          1
        } else { if ty_borrow_mutable(param_ty) == 1 and (actual_is_owned or actual_is_unique) and tenv_entry_mutable(owner) == 0 {
          typeck_error_maybe(src, expr_diag_pos(arg), "type error: exclusive borrow requires a mutable owner binding")
          1
        } else {
          typeck_mark_borrow_use(arg, owner, param_ty)
          0
        } } } } }
      }
    }
  }
}

pub(package) fn typeck_borrow_facts_conflict(left: i64, right: i64) -> i64 {
  if left == 0 or right == 0 { 0 }
  else { if node_f1(left) != node_f1(right) { 0 }
  else { if node_f2(left) == 1 or node_f2(right) == 1 { 1 } else { 0 } } }
}

pub(package) fn check_borrow_call_conflicts_with_receiver(args: i64, nargs: i64, receiver: i64, src: i64, pos: i64) -[Diagnose]> i64 {
  let receiver_fact = typeck_borrow_use_fact(receiver)
  let mut errors = 0
  for i in 0..nargs {
    let left = typeck_borrow_use_fact(nlist_get(args, i))
    if typeck_borrow_facts_conflict(receiver_fact, left) == 1 {
      typeck_error_maybe(src, expr_diag_pos(nlist_get(args, i)), "type error: conflicting resource borrows in one call")
      errors = errors + 1
    } else { 0 }
    for j in 0..i {
      let right = typeck_borrow_use_fact(nlist_get(args, j))
      if typeck_borrow_facts_conflict(left, right) == 1 {
        typeck_error_maybe(src, expr_diag_pos(nlist_get(args, i)), "type error: conflicting resource borrows in one call")
        errors = errors + 1
      } else { 0 }
    }
  }
  errors
}

pub(package) fn check_borrow_call_conflicts(args: i64, nargs: i64, src: i64, pos: i64) -[Diagnose]> i64 {
  check_borrow_call_conflicts_with_receiver(args, nargs, 0, src, pos)
}

pub(package) fn check_arg_against_param_mode_at(arg: i64, param_ty: i64, env: i64, ft: i64, src: i64, tt: i64, pos: i64, allow_direct_continuation_i64: i64, expected_origin: DiagnosticLocation) -[Conformance, Diagnose]> i64 {
  if param_ty == 0 { 0 }
  else { if ty_is_borrow(param_ty) { check_arg_against_borrow_param(arg, param_ty, env, src, pos, expected_origin, tt) }
  else {
    prepare_expr_contextual(arg, param_ty, env, ft, src, tt)
    if ty_tag(param_ty) == 6 {
      if node_tag(arg) == 29 {
        check_lambda_against_fn(arg, param_ty, env, ft, src, tt, pos)
      } else {
        let generic_ref_candidate = if node_tag(arg) == 2 and tenv_lookup(env, src, node_f1(arg), node_f2(arg)) == 0 and ttable_variant_payload_count(tt, src, node_f1(arg), node_f2(arg)) < 0 {
          if ftypes_lookup_tparams(ft, src, node_f1(arg), node_f2(arg)) != 0 { 1 } else { 0 }
        } else { 0 }
        let inferred_ref = infer_generic_ref_from_expected(arg, param_ty, env, ft, src, tt)
        let arg_ty = synth(arg, env, ft, src, tt)
        let bound_errors = if inferred_ref == 1 {
          let inner = node_f2(arg)
          let entry = ftypes_find(ft, src, node_f1(inner), node_f2(inner))
          check_trait_bounds_at(ftypes_entry_tparams(entry), node_f1(arg), src, node_f1(inner), node_f2(inner), ftypes_entry_source(entry), tt, "generic function value")
        } else { 0 }
        if generic_ref_candidate == 1 and inferred_ref == 0 {
          typeck_error_maybe(src, pos, "type error: cannot infer generic function reference")
          1
        } else { if bound_errors > 0 { bound_errors }
        else { if ty_is_continuation(arg_ty) == 1 {
          if ty_is_continuation(param_ty) == 0 and not (allow_direct_continuation_i64 == 1 and type_is_i64_like(param_ty) == 1) {
            typeck_report_expr_type_mismatch(src, arg, param_ty, arg_ty, "argument", expected_origin, tt)
            1
          } else { 0 }
        } else { if expr_matches_type_contextual(arg, arg_ty, param_ty, src, ft) != 1 {
          typeck_report_expr_type_mismatch(src, arg, param_ty, arg_ty, "argument", expected_origin, tt)
          1
        } else { 0 } } } }
      }
    } else {
      let arg_ty = synth(arg, env, ft, src, tt)
      if ty_is_continuation(arg_ty) == 1 {
        if ty_is_continuation(param_ty) == 0 and not (allow_direct_continuation_i64 == 1 and type_is_i64_like(param_ty) == 1) {
          typeck_report_expr_type_mismatch(src, arg, param_ty, arg_ty, "argument", expected_origin, tt)
          1
        } else { 0 }
      } else { if expr_matches_type_contextual(arg, arg_ty, param_ty, src, ft) != 1 {
        -- Second chance: generic ctor argument solves its type args from
        -- the declared parameter type.
        if infer_generic_ctor_result(arg, param_ty, env, ft, src, tt) == 1 and expr_matches_type_contextual(arg, synth(arg, env, ft, src, tt), param_ty, src, ft) == 1 { 0 }
        else {
          typeck_report_expr_type_mismatch(src, arg, param_ty, arg_ty, "argument", expected_origin, tt)
          1
        }
      } else { 0 } }
    }
  } }
}

pub(package) fn check_arg_against_param_mode(arg: i64, param_ty: i64, env: i64, ft: i64, src: i64, tt: i64, pos: i64, allow_direct_continuation_i64: i64) -[Conformance, Diagnose]> i64 {
  check_arg_against_param_mode_at(arg, param_ty, env, ft, src, tt, pos, allow_direct_continuation_i64, typeck_source_location(src, pos, 1))
}

pub(package) fn check_arg_against_param(arg: i64, param_ty: i64, env: i64, ft: i64, src: i64, tt: i64, pos: i64) -[Conformance, Diagnose]> i64 {
  check_arg_against_param_mode(arg, param_ty, env, ft, src, tt, pos, 0)
}

pub(package) fn check_arg_against_param_at(arg: i64, param_ty: i64, env: i64, ft: i64, src: i64, tt: i64, pos: i64, expected_origin: DiagnosticLocation) -[Conformance, Diagnose]> i64 {
  check_arg_against_param_mode_at(arg, param_ty, env, ft, src, tt, pos, 0, expected_origin)
}

-- A direct declaration call may preserve an argument's exact record shape by
-- specialising the callee.  `2` means the semantic subtype relation holds but
-- the ordinary ABI does not: either a nominal record projects to the expected
-- predicate, or a closed structural value refines a different/open predicate.
pub(package) fn typeck_structural_call_match_kind(tt: i64, actual_ty: i64, expected_ty: i64) -> i64 {
  if actual_ty == 0 or expected_ty == 0 or not ty_is_record(expected_ty) { 0 }
  else { if ty_tag(actual_ty) == 9 {
    if typecheck_subtype(tt, actual_ty, expected_ty) == 1 { 2 } else { 0 }
  } else { if ty_is_record(actual_ty) and typecheck_subtype(tt, actual_ty, expected_ty) == 1 {
    if ty_record_open(actual_ty) == 1 { 3 }
    else { if ty_eq(actual_ty, expected_ty) { 1 } else { 2 } }
  } else { 0 } } }
}

pub(package) fn check_arg_against_direct_param_mode(arg: i64, param_ty: i64, env: i64, ft: i64, src: i64, tt: i64, pos: i64, allow_direct_continuation_i64: i64) -[Conformance, Diagnose]> i64 {
  check_arg_against_direct_param_mode_at(arg, param_ty, env, ft, src, tt, pos, allow_direct_continuation_i64, typeck_source_location(src, pos, 1))
}

pub(package) fn check_arg_against_direct_param_mode_at(arg: i64, param_ty: i64, env: i64, ft: i64, src: i64, tt: i64, pos: i64, allow_direct_continuation_i64: i64, expected_origin: DiagnosticLocation) -[Conformance, Diagnose]> i64 {
  prepare_expr_contextual(arg, param_ty, env, ft, src, tt)
  let actual_ty = synth(arg, env, ft, src, tt)
  if typeck_structural_call_match_kind(tt, actual_ty, param_ty) >= 2 { 0 }
  else { check_arg_against_param_mode_at(arg, param_ty, env, ft, src, tt, pos, allow_direct_continuation_i64, expected_origin) }
}

pub(package) fn check_arg_against_opaque_param(arg: i64, param_ty: i64, env: i64, ft: i64, src: i64, tt: i64, pos: i64, expected_origin: DiagnosticLocation) -[Conformance, Diagnose]> i64 {
  prepare_expr_contextual(arg, param_ty, env, ft, src, tt)
  let actual_ty = synth(arg, env, ft, src, tt)
  if typeck_structural_call_match_kind(tt, actual_ty, param_ty) >= 2 {
    typeck_error_maybe(src, pos, "type error: structural shape adaptation requires a direct function call")
    1
  } else { check_arg_against_param_at(arg, param_ty, env, ft, src, tt, pos, expected_origin) }
}

pub(package) fn typeck_call_shape_type_args(args: i64, nargs: i64, params: i64, subst: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  if params == 0 or nargs != nlist_len(params) { 0 }
  else {
    let exact = nlist_new_capacity(nargs)
    let mut needs_shape = 0
    for i in 0..nargs {
      let raw_param_ty = node_f3(nlist_get(params, i))
      let param_ty = if subst == 0 or raw_param_ty == 0 { raw_param_ty } else { ty_subst(raw_param_ty, subst) }
      let actual_ty = synth(nlist_get(args, i), env, ft, src, tt)
      if typeck_structural_call_match_kind(tt, actual_ty, param_ty) >= 2 { needs_shape = 1 } else { 0 }
      nlist_add(exact, actual_ty)
    }
    if needs_shape == 1 { exact } else { 0 }
  }
}

pub(package) fn typeck_append_shape_type_args(type_args: i64, exact: i64) -> i64 {
  if exact == 0 { 0 }
  else {
    for i in 0..nlist_len(exact) { nlist_add(type_args, nlist_get(exact, i)) }
    1
  }
}

pub(package) fn is_intrinsic_name(src: i64, ns: i64, nl: i64) -> i64 {
  if nl >= 2 {
    if mem_load8_at(src, ns) == 95 {
      mem_load8_at(src, ns + 1) == 95
    } else { false }
  } else { false }
}

-- The closed set of compiler intrinsics. A "__" prefix alone does not make a
-- name an intrinsic — unknown "__" calls must fall through to normal
-- resolution so they get "unknown function" instead of silent acceptance.
pub(package) fn is_known_intrinsic_name(src: i64, ns: i64, nl: i64) -> i64 {
  if intrinsic_int_cast_arg_ty(src, ns, nl) != 0 { true }
  else { if intrinsic_int_to_f64_arg_ty(src, ns, nl) != 0 { true }
  else { if intrinsic_int_to_f32_arg_ty(src, ns, nl) != 0 { true }
  else {
    src_eq(src, ns, nl, "__f64_to_i64_trunc") == 1 or
    src_eq(src, ns, nl, "__f32_to_f64") == 1 or
    src_eq(src, ns, nl, "__f64_to_f32") == 1 or
    src_eq(src, ns, nl, "__f64_sqrt") == 1 or
    src_eq(src, ns, nl, "__f32_sqrt") == 1 or
    src_eq(src, ns, nl, "__raw_offset") == 1 or
    src_eq(src, ns, nl, "__transmute") == 1 or
    src_eq(src, ns, nl, "__int_to_ptr") == 1 or
    src_eq(src, ns, nl, "__mem_load64") == 1 or
    src_eq(src, ns, nl, "__mem_store64") == 1 or
    src_eq(src, ns, nl, "__mem_load8") == 1 or
    src_eq(src, ns, nl, "__mem_store8") == 1 or
    src_eq(src, ns, nl, "__mem_load_sized") == 1 or
    src_eq(src, ns, nl, "__mem_store_sized") == 1 or
    src_eq(src, ns, nl, "__str_ptr") == 1 or
    src_eq(src, ns, nl, "__str_len") == 1 or
    src_eq(src, ns, nl, "__bump_alloc") == 1 or
    src_eq(src, ns, nl, "__syscall") == 1 or
    src_eq(src, ns, nl, "__platform_read") == 1 or
    src_eq(src, ns, nl, "__platform_open_read") == 1 or
    src_eq(src, ns, nl, "__platform_open_write_create_new") == 1 or
    src_eq(src, ns, nl, "__platform_open_write_create_truncate") == 1 or
    src_eq(src, ns, nl, "__platform_open_write_append") == 1 or
    src_eq(src, ns, nl, "__platform_open_read_write_create_truncate") == 1 or
    src_eq(src, ns, nl, "__platform_seek_start") == 1 or
    src_eq(src, ns, nl, "__platform_seek_current") == 1 or
    src_eq(src, ns, nl, "__platform_seek_end") == 1 or
    src_eq(src, ns, nl, "__platform_file_flush") == 1 or
    src_eq(src, ns, nl, "__platform_dir_open") == 1 or
    src_eq(src, ns, nl, "__platform_dir_read") == 1 or
    src_eq(src, ns, nl, "__platform_dir_entry_record_len") == 1 or
    src_eq(src, ns, nl, "__platform_dir_entry_name") == 1 or
    src_eq(src, ns, nl, "__platform_dir_entry_is_directory") == 1 or
    src_eq(src, ns, nl, "__platform_stat_follow") == 1 or
    src_eq(src, ns, nl, "__platform_stat_nofollow") == 1 or
    src_eq(src, ns, nl, "__platform_dir_mkdir") == 1 or
    src_eq(src, ns, nl, "__platform_dir_getcwd") == 1 or
    src_eq(src, ns, nl, "__platform_dir_remove_directory") == 1 or
    src_eq(src, ns, nl, "__platform_dir_current") == 1 or
    src_eq(src, ns, nl, "__platform_time_realtime") == 1 or
    src_eq(src, ns, nl, "__platform_time_monotonic") == 1 or
    src_eq(src, ns, nl, "__platform_time_sleep") == 1 or
    src_eq(src, ns, nl, "__platform_proc_pipe") == 1 or
    src_eq(src, ns, nl, "__platform_proc_set_cloexec") == 1 or
    src_eq(src, ns, nl, "__platform_proc_set_nonblocking") == 1 or
    src_eq(src, ns, nl, "__platform_proc_spawn") == 1 or
    src_eq(src, ns, nl, "__platform_proc_wait_blocking") == 1 or
    src_eq(src, ns, nl, "__platform_proc_wait_nonblocking") == 1 or
    src_eq(src, ns, nl, "__platform_proc_kill") == 1 or
    src_eq(src, ns, nl, "__platform_proc_id") == 1 or
    src_eq(src, ns, nl, "__platform_proc_fork") == 1 or
    src_eq(src, ns, nl, "__platform_proc_set_group") == 1 or
    src_eq(src, ns, nl, "__platform_proc_dup_to") == 1 or
    src_eq(src, ns, nl, "__platform_proc_exec") == 1 or
    src_eq(src, ns, nl, "__platform_proc_wait_usage") == 1 or
    src_eq(src, ns, nl, "__platform_thread_stack_size") == 1 or
    src_eq(src, ns, nl, "__platform_thread_stack_guard") == 1 or
    src_eq(src, ns, nl, "__platform_thread_create") == 1 or
    src_eq(src, ns, nl, "__platform_thread_join") == 1 or
    src_eq(src, ns, nl, "__platform_thread_mutex_init") == 1 or
    src_eq(src, ns, nl, "__platform_thread_mutex_destroy") == 1 or
    src_eq(src, ns, nl, "__platform_thread_mutex_lock") == 1 or
    src_eq(src, ns, nl, "__platform_thread_mutex_unlock") == 1 or
    src_eq(src, ns, nl, "__platform_thread_cond_init") == 1 or
    src_eq(src, ns, nl, "__platform_thread_cond_destroy") == 1 or
    src_eq(src, ns, nl, "__platform_thread_cond_wait") == 1 or
    src_eq(src, ns, nl, "__platform_thread_cond_signal") == 1 or
    src_eq(src, ns, nl, "__platform_thread_cond_broadcast") == 1 or
    intrinsic_platform_network_arity(src, ns, nl) >= 0 or
    src_eq(src, ns, nl, "__platform_close") == 1 or
    src_eq(src, ns, nl, "__platform_remove") == 1 or
    src_eq(src, ns, nl, "__platform_rename") == 1 or
    src_eq(src, ns, nl, "__platform_io_error") == 1 or
    src_eq(src, ns, nl, "__platform_map_rw_anonymous") == 1 or
    src_eq(src, ns, nl, "__platform_remap_rw_anonymous_fixed") == 1 or
    src_eq(src, ns, nl, "__platform_unmap") == 1 or
    src_eq(src, ns, nl, "__platform_write") == 1 or
    src_eq(src, ns, nl, "__platform_exit") == 1 or
    src_eq(src, ns, nl, "__platform_native_host_target") == 1 or
    src_eq(src, ns, nl, "__platform_terminal_is_tty") == 1 or
    src_eq(src, ns, nl, "__platform_file_chmod") == 1 or
    src_eq(src, ns, nl, "__runtime_state") == 1 or
    src_eq(src, ns, nl, "__frame_pointer") == 1 or
    src_eq(src, ns, nl, "__set_runtime_state") == 1 or
    src_eq(src, ns, nl, "__set_handler_stack") == 1 or
    src_eq(src, ns, nl, "__call_i64") == 1 or
    src_eq(src, ns, nl, "__call_closure_i64") == 1 or
    src_eq(src, ns, nl, "__atomic_lock64") == 1 or
    src_eq(src, ns, nl, "__atomic_unlock64") == 1 or
    src_eq(src, ns, nl, "__fiber_suspend") == 1 or
    src_eq(src, ns, nl, "__fiber_resume") == 1 or
    src_eq(src, ns, nl, "__fiber_is_done") == 1 or
    src_eq(src, ns, nl, "__fiber_trampoline") == 1
  } } }
}

pub(package) fn check_intrinsic_i64_to_f64_args(node: i64, env: i64, ft: i64, src: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let nargs = node_f4(node)
  if nargs != 1 {
    typeck_error_maybe(src, node_f1(node), "type error: arity mismatch")
    1
  } else {
    check_arg_against_param(nlist_get(node_f3(node), 0), ty_i64(), env, ft, src, tt, node_f1(node))
  }
}

pub(package) fn check_intrinsic_f64_to_i64_trunc_args(node: i64, env: i64, ft: i64, src: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let nargs = node_f4(node)
