      49 -> 0 - 1
      52 -> deferred_fiber_count_add(deferred_fiber_perform_count(node_f1(node), clause, src, env, ft), deferred_fiber_perform_count(node_f2(node), clause, src, env, ft))
      _ -> 0
    }
  }
}

fn deferred_fiber_handle_supports_clause(handle_body: i64, clauses: i64, nclauses: i64, clause: i64, src: i64, env: i64, ft: i64) -> bool {
  if nclauses != 1 { false }
  else { if node_f4(clause) == 0 { false }
