pub(package) fn typeck_drop_method_hash() -> i64 {
  effect_name_hash(__str_ptr("drop"), 0, 4)
}

pub(package) fn typeck_drop_trait_hash() -> i64 {
  effect_name_hash(__str_ptr("Drop"), 0, 4)
}

pub(package) fn typeck_owned_drop_type_hash(ty: i64) -> i64 {
  if ty_is_owned(ty) != 1 { 0 }
  else {
    let inner = ty_owned_inner(ty)
    if inner != 0 and ty_tag(inner) == 9 { ty_f1(inner) } else { 0 }
  }
}

pub(package) fn typeck_owned_drop_conforms(tt: i64, ty: i64) -> i64 {
  let inner = if ty_is_owned(ty) == 1 { ty_owned_inner(ty) } else { ty }
  if inner == 0 or ty_tag(inner) != 9 { 0 }
  else {
    let trait_hash = typeck_drop_trait_hash()
    if lookup_trait_methods(tt, __str_ptr("Drop"), trait_hash) == 0 { 0 }
    else {
      let ct = ttable_get_ct(tt)
      if ct == 0 { 0 } else { ctable_conforms_type(ct, inner, trait_hash) }
    }
  }
}

pub(package) fn check_owned_drop_effect_available(ty: i64, tt: i64, src: i64, pos: i64, caller_eff: i64) -[Diagnose]> i64 {
  let type_hash = typeck_owned_drop_type_hash(ty)
  if type_hash == 0 { 0 }
  else {
    if typeck_owned_drop_conforms(tt, ty) != 1 { 0 }
    else {
      let method_hash = typeck_drop_method_hash()
      let inner = ty_owned_inner(ty)
      let resolution = ttable_resolve_method(tt, inner, type_hash, method_hash)
      if resolution == 0 { 0 }
      else {
        let drop_eff = method_resolution_effects(resolution)
        if effect_sig_subset(drop_eff, caller_eff) { 0 }
        else {
          typeck_error_maybe(src, pos, "type error: owned Drop effect not available in caller")
          1
        }
      }
    }
  }
}

pub(package) fn check_owned_drop_param_effects(params: i64, nparams: i64, tt: i64, src: i64, caller_eff: i64) -[Diagnose]> i64 {
  let mut errors = 0
  for i in 0..nparams {
    let p = nlist_get(params, i)
    errors = errors + check_owned_drop_effect_available(node_f3(p), tt, src, node_f1(p), caller_eff)
  }
  errors
}

pub(package) fn check_owned_resource_root(tt: i64, src: i64, pos: i64, ty: i64) -[Diagnose]> i64 {
  let type_hash = typeck_owned_drop_type_hash(ty)
  if type_hash == 0 {
    typeck_error_maybe(src, pos, "type error: owned type requires Drop resource conformance")
    1
  } else {
    if typeck_owned_drop_conforms(tt, ty) == 1 { 0 }
    else {
      typeck_error_maybe(src, pos, "type error: owned type requires Drop resource conformance")
      1
    }
  }
}

pub(package) fn check_owned_resource_type_list(tt: i64, src: i64, pos: i64, types: i64) -[Diagnose]> i64 {
  if types == 0 { 0 }
  else {
    let mut errors = 0
    let n = nlist_len(types)
    for i in 0..n {
      errors = errors + check_owned_resource_ty(tt, src, pos, nlist_get(types, i))
    }
    errors
  }
}

pub(package) fn check_owned_resource_record_fields(tt: i64, src: i64, pos: i64, fields: i64) -[Diagnose]> i64 {
  let mut errors = 0
  if fields != 0 {
    for i in 0..nlist_len(fields) {
      errors = errors + check_owned_resource_ty(tt, src, pos, ty_record_field_type(nlist_get(fields, i)))
    }
  } else { 0 }
  errors
}

pub(package) fn check_owned_resource_ty(tt: i64, src: i64, pos: i64, ty: i64) -[Diagnose]> i64 {
  if ty == 0 { 0 }
  else {
    match ty_tag(ty) {
      3 -> check_owned_resource_ty(tt, src, pos, ty_f1(ty)) + check_owned_resource_ty(tt, src, pos, ty_f2(ty))
      4 -> check_owned_resource_ty(tt, src, pos, ty_f1(ty)) + check_owned_resource_ty(tt, src, pos, ty_f2(ty))
      5 -> check_owned_resource_ty(tt, src, pos, ty_f1(ty))
      6 -> check_owned_resource_type_list(tt, src, pos, ty_f1(ty)) + check_owned_resource_ty(tt, src, pos, ty_f2(ty))
      7 -> check_owned_resource_record_fields(tt, src, pos, ty_record_fields(ty))
      8 -> check_owned_resource_ty(tt, src, pos, ty_f2(ty))
      9 -> check_owned_resource_type_list(tt, src, pos, ty_f3(ty))
      14 -> check_owned_resource_ty(tt, src, pos, ty_f1(ty)) + check_owned_resource_ty(tt, src, pos, ty_f2(ty))
      15 -> check_owned_resource_ty(tt, src, pos, ty_f1(ty))
      16 -> check_owned_resource_ty(tt, src, pos, ty_f1(ty))
      18 -> check_owned_resource_ty(tt, src, pos, ty_f1(ty))
      19 -> check_owned_resource_root(tt, src, pos, ty)
      22 -> check_owned_resource_ty(tt, src, pos, ty_array_inner(ty))
      23 -> check_owned_resource_ty(tt, src, pos, ty_slice_inner(ty))
      -- A borrow may view either an owned resource or unique ordinary data.
      -- The call-site owner fact selects and validates that source; the
      -- signature therefore does not require its inner type to implement Drop.
      29 -> 0
      _ -> 0
    }
  }
}

pub(package) fn check_owned_resource_params(tt: i64, src: i64, params: i64) -[Diagnose]> i64 {
  let mut errors = 0
  let n = nlist_len(params)
  for i in 0..n {
    let p = nlist_get(params, i)
    errors = errors + check_owned_resource_ty(tt, src, node_f1(p), node_f3(p))
  }
  errors
}

pub(package) fn typevar_method_bound_atom(tt: i64, var_id: i64, method_hash: i64) -> i64 {
  let tparams = ttable_get_tparams(tt)
  if tparams == 0 { 0 }
  else {
    let mut result = 0
    let mut i = 0
    while i < nlist_len(tparams) and result == 0 {
      let tp = nlist_get(tparams, i)
      if node_f3(tp) == var_id {
        let bounds = node_f4(tp)
        let mut bi = 0
        while bounds != 0 and bi < nlist_len(bounds) and result == 0 {
          let bound = nlist_get(bounds, bi)
          if ttable_lookup_trait_method_params_atom(tt, bound, method_hash) != 0 { result = bound } else { bi = bi + 1 }
        }
        i = nlist_len(tparams)
      } else { i = i + 1 }
    }
    result
  }
}

pub(package) fn typevar_bound_associated_type(tt: i64, var_id: i64, assoc_hash: i64) -> i64 {
  let tparams = ttable_get_tparams(tt)
  if tparams == 0 { 0 }
  else {
    let mut result = 0
    let mut i = 0
    while i < nlist_len(tparams) and result == 0 {
      let tp = nlist_get(tparams, i)
      if node_f3(tp) == var_id {
        let bounds = node_f4(tp)
        let mut bi = 0
        while bounds != 0 and bi < nlist_len(bounds) and result == 0 {
          result = trait_atom_assoc_type(nlist_get(bounds, bi), assoc_hash)
          bi = bi + 1
        }
        i = nlist_len(tparams)
      } else { i = i + 1 }
    }
    result
  }
}

pub(package) fn typeck_resolve_bound_associated_list(types: i64, tt: i64, depth: i64) -> i64 {
  if types == 0 { 0 }
  else {
    let result = nlist_new()
    for i in 0..nlist_len(types) {
      nlist_add(result, typeck_resolve_bound_associated_type_depth(nlist_get(types, i), tt, depth))
    }
    result
  }
}

pub(package) fn typeck_resolve_bound_associated_fields(fields: i64, tt: i64, depth: i64) -> i64 {
  let result = nlist_new()
  if fields != 0 {
    for i in 0..nlist_len(fields) {
      let field = nlist_get(fields, i)
      nlist_add(result, ty_record_field(
        ty_record_field_hash(field),
        typeck_resolve_bound_associated_type_depth(ty_record_field_type(field), tt, depth),
        ty_record_field_name_start(field),
        ty_record_field_name_len(field)
      ))
    }
  } else { 0 }
  result
}

pub(package) fn typeck_tparam_associated_owner_atom(tparams: i64, var_id: i64, assoc_hash: i64, tt: i64) -> i64 {
  if tparams == 0 { 0 }
  else {
    let mut result = 0
    let mut i = 0
    while i < nlist_len(tparams) and result == 0 {
      let tparam = nlist_get(tparams, i)
      if node_f3(tparam) == var_id {
        let bounds = node_f4(tparam)
        let mut bi = 0
        while bounds != 0 and bi < nlist_len(bounds) and result == 0 {
          let atom = nlist_get(bounds, bi)
          let entry = lookup_trait_entry_ref(tt, trait_atom_head(atom), trait_atom_decl(atom))
          if entry != 0 and trait_has_assoc_type(mem_load64_at(entry, 32), mem_load64_at(entry, 48), assoc_hash) {
            result = atom
          } else { bi = bi + 1 }
        }
        i = nlist_len(tparams)
      } else { i = i + 1 }
    }
    result
  }
}

pub(package) fn typeck_subst_resolve_associated_list(types: i64, tparams: i64, subst: i64, tt: i64, depth: i64) -> i64 {
  if types == 0 { 0 }
  else {
    let result = nlist_new()
    for i in 0..nlist_len(types) {
      nlist_add(result, typeck_subst_resolve_associated_type_depth(nlist_get(types, i), tparams, subst, tt, depth))
    }
    result
  }
}

pub(package) fn typeck_subst_resolve_associated_fields(fields: i64, tparams: i64, subst: i64, tt: i64, depth: i64) -> i64 {
  let result = nlist_new()
  if fields != 0 {
    for i in 0..nlist_len(fields) {
      let field = nlist_get(fields, i)
      nlist_add(result, ty_record_field(
        ty_record_field_hash(field),
        typeck_subst_resolve_associated_type_depth(ty_record_field_type(field), tparams, subst, tt, depth),
        ty_record_field_name_start(field),
        ty_record_field_name_len(field)
      ))
    }
  } else { 0 }
  result
}

pub(package) fn typeck_subst_resolve_associated_bindings(bindings: i64, tparams: i64, subst: i64, tt: i64, depth: i64) -> i64 {
  let result = nlist_new()
  if bindings != 0 {
    for i in 0..nlist_len(bindings) {
      let binding = nlist_get(bindings, i)
      nlist_add(result, trait_assoc_binding(
        trait_assoc_binding_name(binding),
        typeck_subst_resolve_associated_type_depth(trait_assoc_binding_type(binding), tparams, subst, tt, depth),
        trait_assoc_binding_start(binding),
        trait_assoc_binding_len(binding)
      ))
    }
  } else { 0 }
  result
}

-- Resolve an associated projection while its owning generic bound is still
-- available. Substituting first would turn `C.Output` into
-- `Vector<T>.Output` and discard the fact that `Collect` owns `Output`.
pub(package) fn typeck_subst_resolve_associated_type_depth(ty: i64, tparams: i64, subst: i64, tt: i64, depth: i64) -> i64 {
  if ty == 0 or depth > 16 { ty }
  else {
    match ty_tag(ty) {
      3 -> ty_union(typeck_subst_resolve_associated_type_depth(ty_f1(ty), tparams, subst, tt, depth), typeck_subst_resolve_associated_type_depth(ty_f2(ty), tparams, subst, tt, depth))
      4 -> ty_inter(typeck_subst_resolve_associated_type_depth(ty_f1(ty), tparams, subst, tt, depth), typeck_subst_resolve_associated_type_depth(ty_f2(ty), tparams, subst, tt, depth))
      5 -> ty_compl(typeck_subst_resolve_associated_type_depth(ty_f1(ty), tparams, subst, tt, depth))
      6 -> ty_fn(typeck_subst_resolve_associated_list(ty_f1(ty), tparams, subst, tt, depth), typeck_subst_resolve_associated_type_depth(ty_f2(ty), tparams, subst, tt, depth), typeck_subst_resolve_associated_type_depth(ty_f3(ty), tparams, subst, tt, depth))
      7 -> ty_record_with_kind(typeck_subst_resolve_associated_fields(ty_record_fields(ty), tparams, subst, tt, depth), ty_record_open(ty), ty_record_tuple_kind(ty))
      9 -> ty_named_with_metadata(ty_f1(ty), typeck_subst_resolve_associated_type_depth(ty_f2(ty), tparams, subst, tt, depth), typeck_subst_resolve_associated_list(ty_f3(ty), tparams, subst, tt, depth), ty_f4(ty))
      10 -> {
        -- Resolve projections in the declared concrete atoms before
        -- substitution can erase their owning generic bound. Resolve the
        -- effect tail independently, then merge its concrete residual set;
        -- higher-order parameters may carry both facts at once.
        let concrete = typeck_subst_resolve_associated_list(ty_f1(ty), tparams, subst, tt, depth)
        let tail = ty_f2(ty)
        if tail == 0 { ty_effect_sig(concrete) }
        else {
          let tail_sig = effect_sig_subst(ty_effect_sig_with_tail(nlist_new(), tail), subst)
          effect_atom_list_add_unique(concrete, ty_f1(tail_sig))
          ty_effect_sig_with_tail(concrete, ty_f2(tail_sig))
        }
      }
      11 -> ty_effect_app_args(ty_f1(ty), typeck_subst_resolve_associated_list(ty_f2(ty), tparams, subst, tt, depth))
      12 -> {
        let bound = subst_lookup(subst, ty_var_id(ty))
        if bound == 0 { ty } else { bound }
      }
      14 -> ty_continuation(typeck_subst_resolve_associated_type_depth(ty_f1(ty), tparams, subst, tt, depth), typeck_subst_resolve_associated_type_depth(ty_f2(ty), tparams, subst, tt, depth))
      15 -> ty_ptr_with_mut(typeck_subst_resolve_associated_type_depth(ty_f1(ty), tparams, subst, tt, depth), ty_f2(ty))
      16 -> ty_weak(typeck_subst_resolve_associated_type_depth(ty_f1(ty), tparams, subst, tt, depth))
      17 -> ty_arc(typeck_subst_resolve_associated_type_depth(ty_f1(ty), tparams, subst, tt, depth))
      18 -> ty_unique(typeck_subst_resolve_associated_type_depth(ty_f1(ty), tparams, subst, tt, depth))
      19 -> ty_owned(typeck_subst_resolve_associated_type_depth(ty_f1(ty), tparams, subst, tt, depth))
      29 -> ty_borrow_with_mut(typeck_subst_resolve_associated_type_depth(ty_f1(ty), tparams, subst, tt, depth), ty_f2(ty))
      21 -> {
        let raw_base = ty_f1(ty)
        let base = typeck_subst_resolve_associated_type_depth(raw_base, tparams, subst, tt, depth)
        let owner = if ty_tag(raw_base) == 12 { typeck_tparam_associated_owner_atom(tparams, ty_var_id(raw_base), ty_f2(ty), tt) } else { 0 }
        let constrained = if owner == 0 { 0 } else { trait_atom_assoc_type(owner, ty_f2(ty)) }
        let binding = if constrained != 0 { typeck_subst_resolve_associated_type_depth(constrained, tparams, subst, tt, depth + 1) }
          else { if owner != 0 { ctable_associated_binding_type(ttable_get_ct(tt), base, owner, ty_f2(ty)) } else { 0 } }
        if binding == 0 { ty_assoc_at(base, ty_f2(ty), ty_assoc_source_start(ty), ty_assoc_source_len(ty)) }
        else { typeck_subst_resolve_associated_type_depth(binding, tparams, subst, tt, depth + 1) }
      }
      22 -> ty_array(typeck_subst_resolve_associated_type_depth(ty_f1(ty), tparams, subst, tt, depth), ty_f2(ty))
      23 -> ty_slice_with_mut(typeck_subst_resolve_associated_type_depth(ty_f1(ty), tparams, subst, tt, depth), ty_f2(ty))
      30 -> ty_trait_constraint(typeck_subst_resolve_associated_type_depth(ty_f1(ty), tparams, subst, tt, depth), typeck_subst_resolve_associated_bindings(ty_f2(ty), tparams, subst, tt, depth))
      _ -> ty_subst(ty, subst)
    }
  }
}

pub(package) fn typeck_subst_resolve_associated_type(ty: i64, tparams: i64, subst: i64, tt: i64) -> i64 {
  typeck_resolve_bound_associated_type(typeck_subst_resolve_associated_type_depth(ty, tparams, subst, tt, 0), tt)
}

pub(package) fn typeck_resolve_bound_associated_type_depth(ty: i64, tt: i64, depth: i64) -> i64 {
  if ty == 0 or depth > 16 { ty }
  else {
    match ty_tag(ty) {
      3 -> ty_union(typeck_resolve_bound_associated_type_depth(ty_f1(ty), tt, depth), typeck_resolve_bound_associated_type_depth(ty_f2(ty), tt, depth))
      4 -> ty_inter(typeck_resolve_bound_associated_type_depth(ty_f1(ty), tt, depth), typeck_resolve_bound_associated_type_depth(ty_f2(ty), tt, depth))
      5 -> ty_compl(typeck_resolve_bound_associated_type_depth(ty_f1(ty), tt, depth))
      6 -> ty_fn(typeck_resolve_bound_associated_list(ty_f1(ty), tt, depth), typeck_resolve_bound_associated_type_depth(ty_f2(ty), tt, depth), typeck_resolve_bound_associated_type_depth(ty_f3(ty), tt, depth))
      7 -> ty_record_with_kind(typeck_resolve_bound_associated_fields(ty_record_fields(ty), tt, depth), ty_record_open(ty), ty_record_tuple_kind(ty))
      9 -> ty_named_with_metadata(ty_f1(ty), typeck_resolve_bound_associated_type_depth(ty_f2(ty), tt, depth), typeck_resolve_bound_associated_list(ty_f3(ty), tt, depth), ty_f4(ty))
      10 -> ty_effect_sig_with_tail(typeck_resolve_bound_associated_list(ty_f1(ty), tt, depth), ty_f2(ty))
      11 -> ty_effect_app_args(ty_f1(ty), typeck_resolve_bound_associated_list(ty_f2(ty), tt, depth))
      14 -> ty_continuation(typeck_resolve_bound_associated_type_depth(ty_f1(ty), tt, depth), typeck_resolve_bound_associated_type_depth(ty_f2(ty), tt, depth))
      15 -> ty_ptr_with_mut(typeck_resolve_bound_associated_type_depth(ty_f1(ty), tt, depth), ty_f2(ty))
      16 -> ty_weak(typeck_resolve_bound_associated_type_depth(ty_f1(ty), tt, depth))
      17 -> ty_arc(typeck_resolve_bound_associated_type_depth(ty_f1(ty), tt, depth))
      18 -> ty_unique(typeck_resolve_bound_associated_type_depth(ty_f1(ty), tt, depth))
      19 -> ty_owned(typeck_resolve_bound_associated_type_depth(ty_f1(ty), tt, depth))
      29 -> ty_borrow_with_mut(typeck_resolve_bound_associated_type_depth(ty_f1(ty), tt, depth), ty_f2(ty))
      21 -> {
        let base = typeck_resolve_bound_associated_type_depth(ty_f1(ty), tt, depth)
        let binding = if ty_tag(base) == 12 { typevar_bound_associated_type(tt, ty_var_id(base), ty_f2(ty)) } else { 0 }
        if binding == 0 { ty_assoc_at(base, ty_f2(ty), ty_assoc_source_start(ty), ty_assoc_source_len(ty)) }
        else { typeck_resolve_bound_associated_type_depth(binding, tt, depth + 1) }
      }
      22 -> ty_array(typeck_resolve_bound_associated_type_depth(ty_f1(ty), tt, depth), ty_f2(ty))
      23 -> ty_slice_with_mut(typeck_resolve_bound_associated_type_depth(ty_f1(ty), tt, depth), ty_f2(ty))
      30 -> ty_trait_constraint(typeck_resolve_bound_associated_type_depth(ty_f1(ty), tt, depth), trait_assoc_bindings_resolve_bound(ty_f2(ty), tt, depth))
      _ -> ty
    }
  }
}

pub(package) fn trait_assoc_bindings_resolve_bound(bindings: i64, tt: i64, depth: i64) -> i64 {
  let result = nlist_new()
  if bindings != 0 {
    for i in 0..nlist_len(bindings) {
      let binding = nlist_get(bindings, i)
      nlist_add(result, trait_assoc_binding(
        trait_assoc_binding_name(binding),
        typeck_resolve_bound_associated_type_depth(trait_assoc_binding_type(binding), tt, depth),
        trait_assoc_binding_start(binding),
        trait_assoc_binding_len(binding)
      ))
    }
  } else { 0 }
  result
}

pub(package) fn typeck_resolve_bound_associated_type(ty: i64, tt: i64) -> i64 {
  typeck_resolve_bound_associated_type_depth(ty, tt, 0)
}

pub(package) fn synth_resolved_method_call(node: i64, tt: i64) -> i64 {
  let method_hash = node_f2(node)
  let method_ref = node_f4(node)
  let recv_ty = method_ref_receiver_ty(method_ref)
  let delayed_trait = if method_ref_owner_hash(method_ref) == 0 and ty_tag(recv_ty) == 12 {
    typevar_method_bound_atom(tt, ty_var_id(recv_ty), method_hash)
  } else { 0 }
  let resolution = if delayed_trait == 0 { ttable_resolve_method(tt, recv_ty, method_ref_owner_hash(method_ref), method_hash) } else { 0 }
  let raw_ret = if delayed_trait != 0 { ttable_lookup_trait_method_ret_atom(tt, delayed_trait, method_hash) }
    else { if resolution == 0 { 0 } else { method_resolution_ret_for_ref(resolution, method_ref, tt) } }
  let self_subst = subst_new()
  subst_add(self_subst, 0 - 1, recv_ty)
  let method_ret = if raw_ret == 0 { 0 } else { typeck_resolve_bound_associated_type(ty_subst(raw_ret, self_subst), tt) }
  if method_ret != 0 { method_ret } else { ty_any() }
}

-- Resolve a method call given the receiver type.
-- Extracts type_hash from the receiver type, mutates node to tag 41
-- so codegen can do (type_hash, method_hash) lookup.
pub(package) fn synth_method_call(node: i64, recv_ty: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  -- Borrow is only a call-duration receiver mode. Owned and unique values keep
  -- their exact conformance target; method resolution falls back to the inner
  -- nominal implementation only when no qualified protocol target exists.
  if ty_is_borrow(recv_ty) { synth_method_call(node, ty_borrow_inner(recv_ty), env, ft, src, tt) }
  else {
  -- Perform node: f1=lhs, f2=op_ns, f3=op_nl, f4=args
  let method_ns = node_f2(node)
  let method_nl = node_f3(node)
  let method_hash = effect_name_hash(src, method_ns, method_nl)
  -- Extract type_hash from the receiver type
  -- Must match the convention in type_name_hash (parse.weft):
  -- Primitives: i64=-1, str=-2, bool=-3, nil=-4
  -- Named types: djb2 hash stored in ty_f1
  let typevar_bound = if ty_tag(recv_ty) == 12 { typevar_method_bound_atom(tt, ty_f1(recv_ty), method_hash) } else { 0 }
  let type_hash = if ty_tag(recv_ty) == 12 {
    -- Resolve the bound which actually owns this method. Bounds are sets;
    -- declaration order must not change method lookup.
    trait_atom_head(typevar_bound)
  } else { type_hash_of(recv_ty) }
  -- Mutate the node: change tag to 41, rearrange fields for MethodCall layout
  -- Tag 41 = MethodCall: f1=receiver, f2=method_hash, f3=args,
  -- f4=resolved method fact (owner + concrete receiver + impl args).
  -- Perform layout was: f1=lhs, f2=op_ns, f3=op_nl, f4=args
  -- EXCEPT for a type-variable receiver: monomorphisation owns per-
  -- specialisation method resolution, and baking the trait hash into the
  -- shared template at check time pins every specialisation to one impl
  -- (`i16.bit_width()` answered 8). Type the call here, mutate nothing.
  if ty_tag(recv_ty) == 12 { 0 }
  else {
    let resolution = ttable_resolve_method(tt, recv_ty, type_hash, method_hash)
    let args = node_f4(node)
    mem_store64_at(node, 0, 41)
    mem_store64_at(node, 16, method_hash)
    mem_store64_at(node, 24, args)
    mem_store64_at(node, 32, method_ref_with_source(method_ref_with_declaration(method_ref_new(
      type_hash,
      recv_ty,
      if resolution == 0 { 0 } else { method_resolution_ref_type_args(resolution, recv_ty) },
      if resolution != 0 and method_resolution_tparams(resolution) != 0 { 1 } else { 0 }
    ), if resolution == 0 { 0 } else { method_resolution_declaration(resolution) }), method_ns, method_nl))
  }
  let resolution = if ty_tag(recv_ty) == 12 { 0 } else { ttable_resolve_method(tt, recv_ty, type_hash, method_hash) }
  let raw_method_ret = if typevar_bound != 0 { ttable_lookup_trait_method_ret_atom(tt, typevar_bound, method_hash) }
    else { if resolution == 0 { ttable_lookup_method_ret(tt, type_hash, method_hash) } else { method_resolution_ret(resolution) } }
  let self_subst = subst_new()
  subst_add(self_subst, 0 - 1, recv_ty)
  let method_ret = typeck_resolve_bound_associated_type(ty_subst(raw_method_ret, self_subst), tt)
  if method_ret != 0 { method_ret }
  else {
    let mut fi = 0
    let mut ret = ty_any()
    while fi < nlist_len(ft) {
      let e = nlist_get(ft, fi)
      let e_ns = mem_load64_at(e, 0)
      let e_nl = mem_load64_at(e, 8)
      let e_src = mem_load64_at(e, 24)
      let fn_hash = effect_name_hash(e_src, e_ns, e_nl)
      if fn_hash == method_hash {
        let e_ret = mem_load64_at(e, 16)
        ret = if e_ret != 0 { e_ret } else { ty_any() }
        fi = nlist_len(ft)
      } else { fi = fi + 1 }
    }
    ret
  }
  }
}

pub(package) fn synth_block(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  -- Block has first and rest; type is type of rest (last expr)
  let rest = node_f2(node)
  if rest == 0 { synth(node_f1(node), env, ft, src, tt) }
  else { synth(rest, env, ft, src, tt) }
}

-- A resource borrow is an ownership contract, not a different runtime value.
-- Destructuring observes the borrowed value's inner shape, while an ordinary
-- binding pattern retains the borrow contract instead of manufacturing an
-- owned value. Every match walk consumes this shared distinction.
pub(package) fn typeck_match_pattern_scrutinee_type(pat: i64, scr_ty: i64) -> i64 {
  let tag = node_tag(pat)
  let destructures = tag == 20 or tag == 67 or tag == 64 or tag == 65
  if not destructures { scr_ty }
  else { if ty_is_borrow(scr_ty) { ty_borrow_inner(scr_ty) }
  else { if ty_is_owned(scr_ty) { ty_owned_inner(scr_ty) }
  else { if ty_is_unique(scr_ty) { ty_unique_inner(scr_ty) }
  else { scr_ty } } } }
}

pub(package) fn typeck_match_matrix_scrutinee_type(scr_ty: i64) -> i64 {
  if ty_is_borrow(scr_ty) { ty_borrow_inner(scr_ty) }
  else { if ty_is_owned(scr_ty) { ty_owned_inner(scr_ty) }
  else { if ty_is_unique(scr_ty) { ty_unique_inner(scr_ty) }
  else { scr_ty } } }
}

pub(package) fn bind_match_pattern(pat: i64, env: i64, src: i64, scr_ty: i64, tt: i64) -> i64 {
  -- Keep a borrowed scrutinee borrowed while descending the pattern. The
  -- destructuring helpers inspect its inner layout, but any linear child they
  -- bind remains a non-owning view and cannot be moved or dropped.
  bind_pattern(pat, env, src, scr_ty, tt)
}

pub(package) fn synth_match(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let scrutinee = node_f1(node)
  let arms = node_f2(node)
  let n_arms = node_f3(node)
  let scr_ty = synth(scrutinee, env, ft, src, tt)
  if n_arms == 0 { ty_nil() }
  else { synth_match_arms(arms, n_arms, env, ft, src, scr_ty, tt) }
}

pub(package) fn synth_match_arms(arms: i64, n: i64, env: i64, ft: i64, src: i64, scr_ty: i64, tt: i64) -> i64 {
  -- Synthesize union of all arm body types
  let mut result = ty_never()
  for i in 0..n {
    let arm = nlist_get(arms, i)
    let pat = node_f1(arm)
    let body = node_f2(arm)
    -- Extend env with pattern bindings
    let arm_env = bind_match_pattern(pat, env, src, scr_ty, tt)
    let body_ty = synth(body, arm_env, ft, src, tt)
    -- Union all arm types
    result = if ty_eq(result, ty_never()) { body_ty }
      else { if ty_eq(result, body_ty) { result }
      else { ty_union(result, body_ty) } }
  }
  result
}

pub(package) fn check_match_arm_type_consistency(arms: i64, n: i64, env: i64, ft: i64, src: i64, scr_ty: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  if n < 2 { 0 }
  else {
    let first_arm = nlist_get(arms, 0)
    let first_env = bind_match_pattern(node_f1(first_arm), env, src, scr_ty, tt)
    let expected = synth(node_f2(first_arm), first_env, ft, src, tt)
    let mut errors = 0
    for i in 1..n {
      let arm = nlist_get(arms, i)
      let arm_env = bind_match_pattern(node_f1(arm), env, src, scr_ty, tt)
      let got = synth(node_f2(arm), arm_env, ft, src, tt)
      if type_is_unknown_or_any(expected) { errors = errors }
      else { if type_is_unknown_or_any(got) { errors = errors }
      -- Arms must be comparable (one a subtype of the other), not equal:
      -- bool and i64 arms form a chain under bool <: i64 and union to i64,
      -- while genuinely unrelated arms (i64 vs str) still error.
      else { if not is_subtype(got, expected) and not is_subtype(expected, got) {
        typeck_report_expr_type_mismatch(
          src,
          node_f2(arm),
          expected,
          got,
          "match arm",
          typeck_source_location(src, expr_diag_pos(node_f2(first_arm)), expr_diag_len(node_f2(first_arm))),
          tt
        )
        errors = errors + 1
      } else { errors = errors } } }
    }
    errors
  }
}

pub(package) fn pattern_named_variant_entry_by_hash(tt: i64, type_hash: i64) -> i64 {
  if tt == 0 { 0 }
  else {
    let n = mem_load64_at(tt, 8)
    let d = mem_load64_at(tt, 0)
    let mut i = 0
    let mut result = 0
    while i < n and result == 0 {
      if mem_load64_at(d, i * 64 + 16) == 1 and mem_load64_at(d, i * 64 + 56) == type_hash { result = d + i * 64 }
      else { i = i + 1 }
    }
    result
  }
}

pub(package) fn pattern_list_is_irrefutable_for_payloads(patterns: i64, count: i64, payloads: i64, subst: i64, src: i64, tt: i64) -[Conformance]> i64 {
  if count != nlist_len(payloads) { 0 }
  else {
    let mut i = 0
    let mut result = 1
    while i < count and result == 1 {
      let raw_ty = nlist_get(payloads, i)
      let payload_ty = if subst == 0 { raw_ty } else { ty_subst(raw_ty, subst) }
      if pattern_is_irrefutable_for_type(nlist_get(patterns, i), payload_ty, src, tt) == 1 { i = i + 1 }
      else { result = 0 }
    }
    result
  }
}

pub(package) fn ctor_pattern_is_irrefutable_for_type(pat: i64, scr_ty: i64, src: i64, tt: i64) -[Conformance]> i64 {
  let wrapper = pat
  let opaque_entry = typeck_opaque_pattern_entry(wrapper, tt)
  let pat = ctor_pattern_raw(wrapper)
  if ty_tag(scr_ty) != 9 { 0 }
  else { if opaque_entry != 0 {
    let declaration = ctor_pattern_decl(wrapper)
    if ty_named_is_opaque(scr_ty) == 0 or ty_named_opaque_declaration(scr_ty) != declaration { 0 }
    else {
      let children = pattern_matrix_ctor_children(wrapper)
      if nlist_len(children) != 1 { 0 }
      else { pattern_is_irrefutable_for_type(nlist_get(children, 0), ty_named_opaque_representation(scr_ty), src, tt) }
    }
  }
  else {
    let entry = pattern_named_variant_entry_by_hash(tt, ty_f1(scr_ty))
    if entry == 0 or mem_load64_at(entry, 24) != 1 { 0 }
    else {
      let variant = mem_load64_at(entry, 32)
      let entry_src = mem_load64_at(entry, 48)
      let variant_ns = mem_load64_at(variant, 0)
      let variant_nl = mem_load64_at(variant, 8)
      if node_f2(pat) != variant_nl or src_eq_at(src, node_f1(pat), entry_src + variant_ns, 0, variant_nl) == 0 { 0 }
      else {
        let count = ctor_pattern_binding_count(pat)
        let payload_count = mem_load64_at(variant, 24)
        if count != payload_count { 0 }
        else { if count == 0 { 1 }
        else { if node_f4(pat) > 0 { 1 }
        else {
          let tparams = mem_load64_at(entry, 40)
          let subst = if tparams == 0 or ty_f3(scr_ty) == 0 { 0 } else { build_subst(tparams, ty_f3(scr_ty)) }
          pattern_list_is_irrefutable_for_payloads(node_f3(pat), count, mem_load64_at(variant, 32), subst, src, tt)
        } } }
      }
    }
  } }
}

pub(package) fn record_pattern_is_irrefutable_for_type(pat: i64, scr_ty: i64, src: i64, tt: i64) -[Conformance]> i64 {
  let shape = typeck_pattern_record_shape(scr_ty, tt)
  if shape == 0 or ty_record_tuple_kind(shape) == 1 { 0 }
  else {
    let fields = node_f1(pat)
    let mut i = 0
    let mut result = 1
    while i < node_f2(pat) and result == 1 {
      let field = nlist_get(fields, i)
      let field_ty = typeck_pattern_record_field_type(scr_ty, tt, src, node_f1(field), node_f2(field))
      if type_is_unknown_or_any(field_ty) { result = 0 }
      else { if pattern_is_irrefutable_for_type(node_f3(field), field_ty, src, tt) == 1 { i = i + 1 } else { result = 0 } }
    }
    result
  }
}

pub(package) fn tuple_pattern_is_irrefutable_for_type(pat: i64, scr_ty: i64, src: i64, tt: i64) -[Conformance]> i64 {
  if not ty_is_record(scr_ty) or ty_record_tuple_kind(scr_ty) != 1 { 0 }
  else {
    let fields = ty_record_fields(scr_ty)
    let count = if fields == 0 { 0 } else { nlist_len(fields) }
    if node_f2(pat) != count { 0 }
    else {
      let mut i = 0
      let mut result = 1
      while i < count and result == 1 {
        let field_ty = ty_record_field_type(ty_record_field_at_layout_index(scr_ty, i))
        if pattern_is_irrefutable_for_type(nlist_get(node_f1(pat), i), field_ty, src, tt) == 1 { i = i + 1 }
        else { result = 0 }
      }
      result
    }
  }
}

pub(package) fn pattern_is_irrefutable_for_type(pat: i64, scr_ty: i64, src: i64, tt: i64) -[Conformance]> i64 {
  match node_tag(pat) {
    17 -> 1
    18 -> 1
    20 -> ctor_pattern_is_irrefutable_for_type(pat, scr_ty, src, tt)
    67 -> ctor_pattern_is_irrefutable_for_type(pat, scr_ty, src, tt)
    60 -> if type_is_unknown_or_any(scr_ty) or type_is_unknown_or_any(node_f3(pat)) { 0 }
      else { if type_allows_nil(scr_ty) == 1 and type_allows_nil(node_f3(pat)) == 0 { 0 }
      else { if is_subtype(scr_ty, node_f3(pat)) { 1 } else { 0 } } }
    64 -> record_pattern_is_irrefutable_for_type(pat, scr_ty, src, tt)
    65 -> tuple_pattern_is_irrefutable_for_type(pat, scr_ty, src, tt)
    _ -> 0
  }
}

pub(package) fn match_arm_is_unguarded_catch_all(arm: i64, scr_ty: i64, src: i64, tt: i64) -[Conformance]> i64 {
  if node_f3(arm) == 0 {
    pattern_is_irrefutable_for_type(node_f1(arm), scr_ty, src, tt)
  } else { 0 }
}

pub(package) fn match_arms_have_unguarded_catch_all(arms: i64, n: i64, scr_ty: i64, src: i64, tt: i64) -[Conformance]> i64 {
  let mut i = 0
  let mut result = 0
  while i < n {
    if match_arm_is_unguarded_catch_all(nlist_get(arms, i), scr_ty, src, tt) == 1 {
      result = 1
      i = n
    } else {
      i = i + 1
    }
  }
  result
}

pub(package) fn match_ctor_patterns_same(left: i64, right: i64, src: i64) -> i64 {
  let left = ctor_pattern_raw(left)
  let right = ctor_pattern_raw(right)
  if node_f2(left) == node_f2(right) {
    src_eq_at(src, node_f1(left), src + node_f1(right), 0, node_f2(left))
  } else { 0 }
}

-- Until the recursive pattern matrix specializes constructor payload columns,
-- only binding/wildcard payloads cover the whole outer constructor. Treating
-- a nested literal, typed test, nil test, or constructor as full coverage is
-- unsound even though the outer tag matches.
pub(package) fn ctor_pattern_children_are_irrefutable(pat: i64) -> i64 {
  let pat = ctor_pattern_raw(pat)
  let raw = node_f3(pat)
  let count = node_f4(pat)
  if count >= 0 { 1 }
  else {
    let mut ok = 1
    let mut i = 0
    while i < 0 - count and ok == 1 {
      let tag = node_tag(nlist_get(raw, i))
      if tag == 17 or tag == 18 { i = i + 1 }
      else { ok = 0 }
    }
    ok
  }
}

pub(package) fn check_match_duplicate_ctor_arms(arms: i64, n: i64, src: i64) -[Diagnose]> i64 {
  let mut errors = 0
  let mut i = 0
  while i < n {
    let left_arm = nlist_get(arms, i)
    let left_pat = node_f1(left_arm)
    if node_f3(left_arm) == 0 and pattern_is_ctor(left_pat) == 1 {
      let mut j = i + 1
      while j < n {
        let right_arm = nlist_get(arms, j)
        let right_pat = node_f1(right_arm)
        if node_f3(right_arm) == 0 and pattern_is_ctor(right_pat) == 1 {
          if match_ctor_patterns_same(left_pat, right_pat, src) == 1 and ctor_pattern_children_are_irrefutable(left_pat) == 1 and ctor_pattern_children_are_irrefutable(right_pat) == 1 {
            typeck_error(src, pattern_diag_pos(right_pat), "type error: duplicate match constructor arm")
            errors = errors + 1
            j = n
          } else { j = j + 1 }
        } else { j = j + 1 }
      }
    } else { 0 }
    i = i + 1
  }
  errors
}

pub(package) fn match_arm_has_unguarded_ctor(arms: i64, n: i64, src: i64, entry_src: i64, variant_ns: i64, variant_nl: i64) -> i64 {
  let mut i = 0
  let mut result = 0
  while i < n {
    let arm = nlist_get(arms, i)
    let pat = node_f1(arm)
    if node_f3(arm) == 0 and pattern_is_ctor(pat) == 1 and ctor_pattern_children_are_irrefutable(pat) == 1 {
      let pat = ctor_pattern_raw(pat)
      if node_f2(pat) == variant_nl {
        if src_eq_at(src, node_f1(pat), entry_src + variant_ns, 0, variant_nl) == 1 {
          result = 1
          i = n
        } else { i = i + 1 }
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  result
}

pub(package) fn match_arms_cover_named_type_variants(arms: i64, n_arms: i64, src: i64, entry_src: i64, variants: i64, nvariants: i64) -> i64 {
  let mut vi = 0
  let mut result = 1
  while vi < nvariants {
    let v_ns = mem_load64_at(variants, vi * 40)
    let v_nl = mem_load64_at(variants, vi * 40 + 8)
    if match_arm_has_unguarded_ctor(arms, n_arms, src, entry_src, v_ns, v_nl) == 1 {
      vi = vi + 1
    } else {
      result = 0
      vi = nvariants
    }
  }
  result
}

pub(package) fn match_arms_cover_named_type(tt: i64, src: i64, arms: i64, n_arms: i64, type_hash: i64) -> i64 {
  if tt == 0 { 0 }
  else {
    let n = mem_load64_at(tt, 8)
    let d = mem_load64_at(tt, 0)
    let mut ti = 0
    let mut result = 0
    while ti < n {
      let kind = mem_load64_at(d, ti * 64 + 16)
      if kind == 1 {
        let entry_src = mem_load64_at(d, ti * 64 + 48)
        let type_ns = mem_load64_at(d, ti * 64)
        let type_nl = mem_load64_at(d, ti * 64 + 8)
        if mem_load64_at(d, ti * 64 + 56) == type_hash {
          result = match_arms_cover_named_type_variants(arms, n_arms, src, entry_src, mem_load64_at(d, ti * 64 + 32), mem_load64_at(d, ti * 64 + 24))
          ti = n
        } else { ti = ti + 1 }
      } else { ti = ti + 1 }
    }
    result
  }
}

-- Preserve readable set vocabulary while calculating the same residual facts
-- used by match exhaustiveness. The subtype/disjoint fast paths turn the
-- common `T | nil` cases into T/nil/never rather than leaking the checker's
-- intersection-with-complement representation through the Stable fact plane.
pub(package) fn typeck_match_narrowed_type(residual: i64, matched: i64) -[Conformance]> i64 {
  if is_subtype(residual, matched) { residual }
  else { if is_subtype(matched, residual) { matched }
  else { if ty_is_empty(ty_inter(residual, matched)) { ty_never() }
  else { ty_inter(residual, matched) } } }
}

pub(package) fn typeck_match_residual_subtract(residual: i64, matched: i64) -[Conformance]> i64 {
  if is_subtype(residual, matched) { ty_never() }
  else { if ty_is_empty(ty_inter(residual, matched)) { residual }
  else { if ty_tag(residual) == 3 {
    let left = typeck_match_residual_subtract(ty_f1(residual), matched)
    let right = typeck_match_residual_subtract(ty_f2(residual), matched)
    if ty_tag(left) == 0 { right }
    else { if ty_tag(right) == 0 { left } else { ty_union(left, right) } }
  } else { ty_inter(residual, ty_compl(matched)) } } }
}

pub(package) fn typeck_record_match_arm_facts(arms: i64, n: i64, env: i64, src: i64, scr_ty: i64, tt: i64) -[Conformance]> i64 {
  let mut residual = scr_ty
  for i in 0..n {
    let arm = nlist_get(arms, i)
    let pat = node_f1(arm)
    let ptag = node_tag(pat)
    let guarded = if node_f3(arm) == 0 { 0 } else { 1 }
    let matched = if ptag == 60 { node_f3(pat) }
      else { if ptag == 61 { ty_nil() } else { 0 } }
    if matched != 0 {
      let start = node_f1(pat)
      let len = node_f2(pat)
      let previous = ttable_find_semantic_symbol_fact(tt, src, start)
      let fact_env = if previous == 0 { env } else { semantic_symbol_fact_environment(previous) }
      let narrowed = typeck_match_narrowed_type(residual, matched)
      let after = if guarded == 1 { residual } else { typeck_match_residual_subtract(residual, matched) }
      ttable_add_semantic_symbol_fact(
        tt, src, start, len, src, start, len, narrowed,
        ttable_get_tparams(tt), semantic_symbol_kind_match_arm(), fact_env,
        semantic_match_arm_context(after, guarded)
      )
      residual = after
    } else { if guarded == 0 and (ptag == 17 or ptag == 18) {
      residual = ty_never()
    } else { 0 } }
  }
  0
}

-- Recursive pattern matrix (structural pattern matching). Rows and type columns are nlists so the
-- checker can specialize products and finite sums without introducing a
-- second AST. Every specialization consumes only checked pattern/type facts.
pub(package) fn pattern_matrix_vector_copy_from(values: i64, start: i64) -> i64 {
  let result = nlist_new()
  if values != 0 {
    for i in start..nlist_len(values) { nlist_add(result, nlist_get(values, i)) }
  } else { 0 }
  result
}

pub(package) fn pattern_matrix_vector_append_into(left: i64, right: i64) -> i64 {
  let result = nlist_new()
  if left != 0 {
    for i in 0..nlist_len(left) { nlist_add(result, nlist_get(left, i)) }
  } else { 0 }
  if right != 0 {
    for i in 0..nlist_len(right) { nlist_add(result, nlist_get(right, i)) }
  } else { 0 }
  result
}

pub(package) fn pattern_matrix_wildcards_then(count: i64, tail: i64) -> i64 {
  let result = nlist_new()
  for i in 0..count { nlist_add(result, node_new(17, 0, 0, 0, 0)) }
  if tail != 0 {
    for i in 0..nlist_len(tail) { nlist_add(result, nlist_get(tail, i)) }
  } else { 0 }
  result
}

pub(package) fn pattern_matrix_from_arms(arms: i64, count: i64) -> i64 {
  let rows = nlist_new()
  for i in 0..count {
    let arm = nlist_get(arms, i)
    if node_f3(arm) == 0 {
      let row = nlist_new()
      nlist_add(row, node_f1(arm))
      nlist_add(rows, row)
    } else { 0 }
  }
  rows
}

pub(package) fn pattern_matrix_irrefutable_first_rows(rows: i64, first_ty: i64, src: i64, tt: i64) -[Conformance]> i64 {
  let result = nlist_new()
  if rows != 0 {
    for i in 0..nlist_len(rows) {
      let row = nlist_get(rows, i)
      if row != 0 and nlist_len(row) > 0 and pattern_is_irrefutable_for_type(nlist_get(row, 0), first_ty, src, tt) == 1 {
        nlist_add(result, pattern_matrix_vector_copy_from(row, 1))
      } else { 0 }
    }
  } else { 0 }
  result
}

pub(package) fn pattern_matrix_ctor_children(pat: i64) -> i64 {
  let pat = ctor_pattern_raw(pat)
  let result = nlist_new()
  let count = node_f4(pat)
  if count > 0 {
    nlist_add(result, node_new(18, node_f3(pat), count, 0, 0))
  } else { if count < 0 {
    let raw = node_f3(pat)
    for i in 0..0 - count { nlist_add(result, nlist_get(raw, i)) }
  } else { 0 } }
  result
}

pub(package) fn pattern_matrix_variant_matches(pat: i64, src: i64, entry_src: i64, variant: i64) -> i64 {
  let pat = ctor_pattern_raw(pat)
  let nl = mem_load64_at(variant, 8)
  if node_tag(pat) != 20 or node_f2(pat) != nl { 0 }
  else { src_eq_at(src, node_f1(pat), entry_src + mem_load64_at(variant, 0), 0, nl) }
}

pub(package) fn pattern_matrix_variant_payload_types(entry: i64, variant: i64, scr_ty: i64) -> i64 {
  let result = nlist_new()
  let count = mem_load64_at(variant, 24)
  let payloads = mem_load64_at(variant, 32)
  let tparams = mem_load64_at(entry, 40)
  let subst = if tparams == 0 or ty_f3(scr_ty) == 0 { 0 } else { build_subst(tparams, ty_f3(scr_ty)) }
  for i in 0..count {
    let raw_ty = nlist_get(payloads, i)
    nlist_add(result, if subst == 0 { raw_ty } else { ty_subst(raw_ty, subst) })
  }
  result
}

pub(package) fn pattern_matrix_types_contain(types: i64, expected: i64) -> i64 {
  let mut i = 0
  let mut found = 0
  while i < nlist_len(types) and found == 0 {
    if ty_eq(nlist_get(types, i), expected) { found = 1 } else { i = i + 1 }
  }
  found
}

pub(package) fn pattern_matrix_specialize_variant(rows: i64, scr_ty: i64, entry: i64, variant: i64, src: i64, tt: i64) -[Conformance]> i64 {
  let result = nlist_new()
  let payload_count = mem_load64_at(variant, 24)
  let entry_src = mem_load64_at(entry, 48)
  if rows != 0 {
    for i in 0..nlist_len(rows) {
      let row = nlist_get(rows, i)
      if row != 0 and nlist_len(row) > 0 {
        let pat = nlist_get(row, 0)
        let tail = pattern_matrix_vector_copy_from(row, 1)
        if pattern_is_irrefutable_for_type(pat, scr_ty, src, tt) == 1 {
          nlist_add(result, pattern_matrix_wildcards_then(payload_count, tail))
        } else { if pattern_matrix_variant_matches(pat, src, entry_src, variant) == 1 {
          let children = pattern_matrix_ctor_children(pat)
          if nlist_len(children) == payload_count { nlist_add(result, pattern_matrix_vector_append_into(children, tail)) } else { 0 }
        } else { 0 } }
      } else { 0 }
    }
  } else { 0 }
  result
}

pub(package) fn pattern_matrix_opaque_matches(pat: i64, scr_ty: i64, tt: i64) -> i64 {
  let declaration = ctor_pattern_decl(pat)
  if declaration == 0 or ty_named_is_opaque(scr_ty) == 0 { 0 }
  else { if declaration == ty_named_opaque_declaration(scr_ty) and typeck_opaque_pattern_entry(pat, tt) != 0 { 1 } else { 0 } }
}

pub(package) fn pattern_matrix_specialize_opaque(rows: i64, scr_ty: i64, src: i64, tt: i64) -[Conformance]> i64 {
  let result = nlist_new()
  if rows != 0 {
    for i in 0..nlist_len(rows) {
      let row = nlist_get(rows, i)
      if row != 0 and nlist_len(row) > 0 {
        let pat = nlist_get(row, 0)
        let tail = pattern_matrix_vector_copy_from(row, 1)
        if pattern_matrix_opaque_matches(pat, scr_ty, tt) == 1 {
          let children = pattern_matrix_ctor_children(pat)
          if nlist_len(children) == 1 { nlist_add(result, pattern_matrix_vector_append_into(children, tail)) } else { 0 }
        } else { if pattern_is_irrefutable_for_type(pat, scr_ty, src, tt) == 1 {
          nlist_add(result, pattern_matrix_wildcards_then(1, tail))
        } else { 0 } }
      } else { 0 }
    }
  } else { 0 }
  result
}

pub(package) fn pattern_matrix_record_child_by_hash(pat: i64, field_hash: i64, src: i64) -> i64 {
  if node_tag(pat) != 64 { 0 }
  else {
    let fields = node_f1(pat)
    let mut i = 0
    let mut result = 0
    while i < node_f2(pat) and result == 0 {
      let field = nlist_get(fields, i)
      if effect_name_hash(src, node_f1(field), node_f2(field)) == field_hash { result = node_f3(field) }
      else { i = i + 1 }
    }
    result
  }
}

pub(package) fn pattern_matrix_product_types(shape: i64) -> i64 {
  let result = nlist_new()
  let fields = ty_record_fields(shape)
  let count = if fields == 0 { 0 } else { nlist_len(fields) }
  for i in 0..count { nlist_add(result, ty_record_field_type(ty_record_field_at_layout_index(shape, i))) }
  result
}

pub(package) fn pattern_matrix_product_pattern(pat: i64, shape: i64, src: i64) -> i64 {
  let result = nlist_new()
  let fields = ty_record_fields(shape)
  let count = if fields == 0 { 0 } else { nlist_len(fields) }
  if node_tag(pat) == 65 {
    let items = node_f1(pat)
    for i in 0..node_f2(pat) { nlist_add(result, nlist_get(items, i)) }
  } else {
    for i in 0..count {
      let field = ty_record_field_at_layout_index(shape, i)
      let child = pattern_matrix_record_child_by_hash(pat, ty_record_field_hash(field), src)
      nlist_add(result, if child == 0 { node_new(17, 0, 0, 0, 0) } else { child })
    }
  }
  result
}

pub(package) fn pattern_matrix_specialize_product(rows: i64, scr_ty: i64, shape: i64, src: i64, tt: i64) -[Conformance]> i64 {
  let result = nlist_new()
  let field_count = if ty_record_fields(shape) == 0 { 0 } else { nlist_len(ty_record_fields(shape)) }
  if rows != 0 {
    for i in 0..nlist_len(rows) {
      let row = nlist_get(rows, i)
      if row != 0 and nlist_len(row) > 0 {
        let pat = nlist_get(row, 0)
        let tail = pattern_matrix_vector_copy_from(row, 1)
        if pattern_is_irrefutable_for_type(pat, scr_ty, src, tt) == 1 {
          nlist_add(result, pattern_matrix_wildcards_then(field_count, tail))
        } else { if (node_tag(pat) == 64 and ty_record_tuple_kind(shape) == 0) or (node_tag(pat) == 65 and ty_record_tuple_kind(shape) == 1) {
          nlist_add(result, pattern_matrix_vector_append_into(pattern_matrix_product_pattern(pat, shape, src), tail))
        } else { 0 } }
      } else { 0 }
    }
  } else { 0 }
  result
}

pub(package) fn pattern_matrix_specialize_nil_class(rows: i64, scr_ty: i64, non_nil: i64, want_nil: i64, src: i64, tt: i64) -[Conformance]> i64 {
  let result = nlist_new()
  if rows != 0 {
    for i in 0..nlist_len(rows) {
      let row = nlist_get(rows, i)
      if row != 0 and nlist_len(row) > 0 {
        let pat = nlist_get(row, 0)
        let tag = node_tag(pat)
        -- Only syntactic catch-alls span both halves of a nil partition.
        -- Typed rows select a half from their annotation; consulting generic
        -- irrefutability here used to let `x: T` cover nil in `T | nil`.
        let include = if tag == 17 or tag == 18 { 1 }
          else { if want_nil == 1 {
            if tag == 61 { 1 }
            else { if tag == 60 and type_allows_nil(node_f3(pat)) == 1 { 1 } else { 0 } }
          } else {
            if tag == 60 and non_nil != 0 and is_subtype(non_nil, node_f3(pat)) { 1 } else { 0 }
          } }
        if include == 1 { nlist_add(result, pattern_matrix_vector_copy_from(row, 1)) } else { 0 }
      } else { 0 }
    }
  } else { 0 }
  result
}

-- The matrix's negative result is itself a semantic fact: one concrete value
-- vector which no row accepts.  Exhaustiveness and E1003 both consume this
-- producer, so the diagnostic can never drift from the proof that rejected
-- the match. Witness nodes are private render-time values:
--   80 integer, 81 scalar example, 82 nil, 83 variant constructor,
--   84 tuple, 85 record, 86 opaque constructor.
pub(package) fn pattern_matrix_witness_prepend(value: i64, tail: i64) -> i64 {
  let result = nlist_new()
  nlist_add(result, value)
  if tail != 0 {
    for i in 0..nlist_len(tail) { nlist_add(result, nlist_get(tail, i)) }
  } else { 0 }
  result
}

pub(package) fn pattern_matrix_witness_take(values: i64, count: i64) -> i64 {
  let result = nlist_new()
  for i in 0..count { nlist_add(result, nlist_get(values, i)) }
  result
}

pub(package) fn pattern_matrix_integer_positive_max(prim: i64) -> i64 {
  if prim == PRIM_I8() { 127 }
  else { if prim == PRIM_U8() { 255 }
  else { if prim == PRIM_I16() { 32767 }
  else { if prim == PRIM_U16() { 65535 }
  else { if prim == PRIM_I32() { 2147483647 }
  else { if prim == PRIM_U32() { 4294967295 }
  else { 9223372036854775807 } } } } } }
}

pub(package) fn pattern_matrix_scalar_witness(ty: i64) -> i64 {
  if type_is_integer_exact(ty) == 1 { node_new(80, 0, 0, 0, 0) }
  else { if type_is_bool_exact(ty) == 1 { node_new(81, 1, 0, 0, 0) }
  else { if ty_tag(ty) == 2 and ty_f1(ty) == PRIM_STR() { node_new(81, 2, 0, 0, 0) }
  else { if type_is_float_exact(ty) == 1 { node_new(81, 3, 0, 0, 0) }
  else { node_new(81, 4, 0, 0, 0) } } } }
}

pub(package) fn pattern_matrix_record_witness_source(ty: i64, tt: i64, fallback: i64) -> i64 {
  if ty_tag(ty) != 9 { fallback }
  else {
    let entry = ttable_find_entry_by_hash_kind(tt, ty_f1(ty), 0)
    if entry == 0 { fallback } else { ttable_entry_source(entry) }
  }
}

pub(package) fn pattern_matrix_uncovered_integer(rows: i64, tail_types: i64, first_ty: i64, src: i64, tt: i64) -[Conformance]> i64 {
  let prim = type_int_prim(first_ty)
  let max = pattern_matrix_integer_positive_max(prim)
  let row_count = if rows == 0 { 0 } else { nlist_len(rows) }
  let search_max = if row_count < max { row_count } else { max }
  let mut candidate = 0
  let mut result = 0
  while candidate <= search_max and result == 0 {
    let candidate_rows = pattern_matrix_rows_cover_literal(rows, first_ty, candidate, src, tt)
    let tail = pattern_matrix_uncovered_witness(candidate_rows, tail_types, src, tt)
    if tail != 0 { result = pattern_matrix_witness_prepend(node_new(80, candidate, 0, 0, 0), tail) }
    else { candidate = candidate + 1 }
  }
  if result != 0 { result }
  else { if prim_is_unsigned_integer(prim) == 1 { 0 }
  else {
    -- Negative literals are values even though v1 pattern syntax has no
    -- unary-negative pattern. An uncovered -1 therefore teaches a wildcard
    -- arm rather than inventing an unsupported repair.
    let irrefutable = pattern_matrix_irrefutable_first_rows(rows, first_ty, src, tt)
    let tail = pattern_matrix_uncovered_witness(irrefutable, tail_types, src, tt)
    if tail == 0 { 0 } else { pattern_matrix_witness_prepend(node_new(80, 0 - 1, 0, 0, 0), tail) }
  } }
}

pub(package) fn pattern_matrix_uncovered_bool(rows: i64, tail_types: i64, first_ty: i64, src: i64, tt: i64) -[Conformance]> i64 {
  let zero_tail = pattern_matrix_uncovered_witness(pattern_matrix_rows_cover_literal(rows, first_ty, 0, src, tt), tail_types, src, tt)
  if zero_tail != 0 { pattern_matrix_witness_prepend(node_new(81, 1, 0, 0, 0), zero_tail) }
  else {
    let one_tail = pattern_matrix_uncovered_witness(pattern_matrix_rows_cover_literal(rows, first_ty, 1, src, tt), tail_types, src, tt)
    if one_tail == 0 { 0 } else { pattern_matrix_witness_prepend(node_new(81, 5, 0, 0, 0), one_tail) }
  }
}

pub(package) fn pattern_matrix_uncovered_witness(rows: i64, types: i64, src: i64, tt: i64) -[Conformance]> i64 {
  let column_count = if types == 0 { 0 } else { nlist_len(types) }
  if column_count == 0 {
    if rows != 0 and nlist_len(rows) > 0 { 0 } else { nlist_new() }
  } else {
    let first_ty = nlist_get(types, 0)
    if ty_is_empty(first_ty) { 0 }
    else {
      let tail_types = pattern_matrix_vector_copy_from(types, 1)
      let irrefutable = pattern_matrix_irrefutable_first_rows(rows, first_ty, src, tt)
      let irrefutable_covers_all = nlist_len(irrefutable) > 0 and pattern_matrix_uncovered_witness(irrefutable, tail_types, src, tt) == 0
      if irrefutable_covers_all { 0 }
      else {
        let has_nil = type_allows_nil(first_ty)
        let non_nil = if has_nil == 1 { ty_narrow_drop_nil(first_ty) } else { 0 }
        if has_nil == 1 {
          let nil_rows = pattern_matrix_specialize_nil_class(rows, first_ty, non_nil, 1, src, tt)
          let nil_tail = pattern_matrix_uncovered_witness(nil_rows, tail_types, src, tt)
          if nil_tail != 0 { pattern_matrix_witness_prepend(node_new(82, 0, 0, 0, 0), nil_tail) }
          else { if non_nil == 0 or ty_is_empty(non_nil) { 0 }
          else {
            let value_rows = pattern_matrix_specialize_nil_class(rows, first_ty, non_nil, 0, src, tt)
            let value_tail = pattern_matrix_uncovered_witness(value_rows, tail_types, src, tt)
            if value_tail == 0 { 0 }
            else {
              let value_types = nlist_new()
              nlist_add(value_types, non_nil)
              let canonical = pattern_matrix_uncovered_witness(nlist_new(), value_types, src, tt)
              pattern_matrix_witness_prepend(nlist_get(canonical, 0), value_tail)
            }
          } }
        } else { if ty_named_is_opaque(first_ty) {
          let specialized = pattern_matrix_specialize_opaque(rows, first_ty, src, tt)
          let opaque_types = nlist_new()
          nlist_add(opaque_types, ty_named_opaque_representation(first_ty))
          let nested = pattern_matrix_uncovered_witness(specialized, pattern_matrix_vector_append_into(opaque_types, tail_types), src, tt)
          if nested == 0 { 0 }
          else {
            let children = pattern_matrix_witness_take(nested, 1)
            pattern_matrix_witness_prepend(node_new(86, ty_named_opaque_declaration(first_ty), 0, children, 1), pattern_matrix_vector_copy_from(nested, 1))
          }
        } else {
          let variant_entry = if ty_tag(first_ty) == 9 { pattern_named_variant_entry_by_hash(tt, ty_f1(first_ty)) } else { 0 }
          if variant_entry != 0 {
            let variants = mem_load64_at(variant_entry, 32)
            let count = mem_load64_at(variant_entry, 24)
            let mut result = 0
            -- Prefer a finite constructor before following a direct recursive
            -- edge. This is diagnostic search order, not language semantics:
            -- it produces `Nil`/`End` for an empty matrix and still revisits
            -- recursive constructors when every finite branch is covered.
            let mut recursion_pass = 0
            while recursion_pass < 2 and result == 0 {
              let mut vi = 0
              while vi < count and result == 0 {
                let variant = variants + vi * 40
                let payload_count = mem_load64_at(variant, 24)
                let payload_types = pattern_matrix_variant_payload_types(variant_entry, variant, first_ty)
                let directly_recursive = pattern_matrix_types_contain(payload_types, first_ty)
                if directly_recursive == recursion_pass {
                  let specialized = pattern_matrix_specialize_variant(rows, first_ty, variant_entry, variant, src, tt)
                  let nested = pattern_matrix_uncovered_witness(specialized, pattern_matrix_vector_append_into(payload_types, tail_types), src, tt)
                  if nested != 0 {
                    let children = pattern_matrix_witness_take(nested, payload_count)
                    result = pattern_matrix_witness_prepend(node_new(83, variant_entry, variant, children, payload_count), pattern_matrix_vector_copy_from(nested, payload_count))
                  } else { 0 }
                } else { 0 }
                vi = vi + 1
              }
              recursion_pass = recursion_pass + 1
            }
            result
          } else {
            let shape = typeck_pattern_record_shape(first_ty, tt)
            if shape != 0 {
              let child_types = pattern_matrix_product_types(shape)
              let child_count = nlist_len(child_types)
              let specialized = pattern_matrix_specialize_product(rows, first_ty, shape, src, tt)
              let nested = pattern_matrix_uncovered_witness(specialized, pattern_matrix_vector_append_into(child_types, tail_types), src, tt)
              if nested == 0 { 0 }
              else {
                let children = pattern_matrix_witness_take(nested, child_count)
                let product = if ty_record_tuple_kind(shape) == 1 { node_new(84, children, child_count, 0, 0) }
                  else { node_new(85, shape, pattern_matrix_record_witness_source(first_ty, tt, src), children, child_count) }
                pattern_matrix_witness_prepend(product, pattern_matrix_vector_copy_from(nested, child_count))
              }
            } else { if type_is_bool_exact(first_ty) == 1 {
              pattern_matrix_uncovered_bool(rows, tail_types, first_ty, src, tt)
            } else { if type_is_integer_exact(first_ty) == 1 {
              pattern_matrix_uncovered_integer(rows, tail_types, first_ty, src, tt)
            } else {
              let tail = pattern_matrix_uncovered_witness(irrefutable, tail_types, src, tt)
              if tail == 0 { 0 } else { pattern_matrix_witness_prepend(pattern_matrix_scalar_witness(first_ty), tail) }
            } } }
          }
        } }
      }
    }
  }
}

pub(package) fn pattern_matrix_exhaustive(rows: i64, types: i64, src: i64, tt: i64) -[Conformance]> i64 {
  if pattern_matrix_uncovered_witness(rows, types, src, tt) == 0 { 1 } else { 0 }
}

pub(package) fn pattern_matrix_witness_render_name_prefix(b: i64, tt: i64, src: i64, target_src: i64) -> i64 {
  let target_module = module_fact_find_source(tt, target_src)
  let alias = semantic_type_fact_module_alias(tt, src, target_module)
  if __str_len(alias) > 0 { bstr(b, alias) bstr(b, ".") } else { 0 }
}

pub(package) fn pattern_matrix_witness_render_children(b: i64, children: i64, count: i64, tt: i64, src: i64, pattern_mode: i64) -> i64 {
  for i in 0..count {
    if i > 0 { bstr(b, ", ") } else { 0 }
    pattern_matrix_witness_render_into(b, nlist_get(children, i), tt, src, pattern_mode)
  }
  0
}

pub(package) fn pattern_matrix_witness_render_into(b: i64, witness: i64, tt: i64, src: i64, pattern_mode: i64) -> i64 {
  match node_tag(witness) {
    80 -> {
      if pattern_mode == 1 and node_f1(witness) < 0 { bstr(b, "_") }
      else { bstr(b, runtime_int_to_str(node_f1(witness))) }
    }
    81 -> match node_f1(witness) {
      1 -> if pattern_mode == 1 { bstr(b, "_") } else { bstr(b, "false") }
      2 -> if pattern_mode == 1 { bstr(b, "_") } else { bstr(b, "\"\"") }
      3 -> if pattern_mode == 1 { bstr(b, "_") } else { bstr(b, "0.0") }
      5 -> if pattern_mode == 1 { bstr(b, "_") } else { bstr(b, "true") }
      _ -> if pattern_mode == 1 { bstr(b, "_") } else { bstr(b, "<some value>") }
    }
    82 -> bstr(b, "nil")
    83 -> {
      let entry = node_f1(witness)
      let variant = node_f2(witness)
      let entry_src = ttable_entry_source(entry)
      pattern_matrix_witness_render_name_prefix(b, tt, src, entry_src)
      bscopy(b, entry_src + mem_load64_at(variant, 0), mem_load64_at(variant, 8), 0)
      if node_f4(witness) > 0 {
        bstr(b, "(")
        pattern_matrix_witness_render_children(b, node_f3(witness), node_f4(witness), tt, src, pattern_mode)
        bstr(b, ")")
      } else { 0 }
    }
    84 -> {
      bstr(b, "(")
      pattern_matrix_witness_render_children(b, node_f1(witness), node_f2(witness), tt, src, pattern_mode)
      if node_f2(witness) == 1 { bstr(b, ",") } else { 0 }
      bstr(b, ")")
    }
    85 -> {
      let shape = node_f1(witness)
      let name_src = node_f2(witness)
      let children = node_f3(witness)
      bstr(b, "{")
      for i in 0..node_f4(witness) {
        if i > 0 { bstr(b, ", ") } else { 0 }
        let field = ty_record_field_at_layout_index(shape, i)
        bscopy(b, name_src + ty_record_field_name_start(field), ty_record_field_name_len(field), 0)
        bstr(b, ": ")
        pattern_matrix_witness_render_into(b, nlist_get(children, i), tt, src, pattern_mode)
      }
      bstr(b, "}")
    }
    86 -> {
      let declaration = node_f1(witness)
      let declaration_src = module_decl_fact_source(declaration)
      pattern_matrix_witness_render_name_prefix(b, tt, src, declaration_src)
      bscopy(b, module_decl_fact_name_ptr(declaration), module_decl_fact_name_len(declaration), 0)
      bstr(b, "(")
      pattern_matrix_witness_render_children(b, node_f3(witness), node_f4(witness), tt, src, pattern_mode)
      bstr(b, ")")
    }
    _ -> bstr(b, "_")
  }
}

pub(package) fn pattern_matrix_witness_render(witness: i64, tt: i64, src: i64, pattern_mode: i64) -> str {
  let b = buf_new(64)
  pattern_matrix_witness_render_into(b, witness, tt, src, pattern_mode)
  runtime_str_from_bytes_copy(buf_ptr(b), buf_len(b))
}

pub(package) fn pattern_matrix_witness_is_concrete(witness: i64) -> i64 {
  match node_tag(witness) {
    81 -> if node_f1(witness) == 4 { 0 } else { 1 }
    83 -> pattern_matrix_witness_children_are_concrete(node_f3(witness), node_f4(witness))
    84 -> pattern_matrix_witness_children_are_concrete(node_f1(witness), node_f2(witness))
    85 -> pattern_matrix_witness_children_are_concrete(node_f3(witness), node_f4(witness))
    86 -> pattern_matrix_witness_children_are_concrete(node_f3(witness), node_f4(witness))
    _ -> 1
  }
}

pub(package) fn pattern_matrix_witness_children_are_concrete(children: i64, count: i64) -> i64 {
  let mut i = 0
  let mut concrete = 1
  while i < count and concrete == 1 {
    if pattern_matrix_witness_is_concrete(nlist_get(children, i)) == 1 { i = i + 1 } else { concrete = 0 }
  }
  concrete
}

pub(package) fn pattern_matrix_guarded_arm_count(arms: i64, count: i64) -> i64 {
  let mut guarded = 0
  for i in 0..count { if node_f3(nlist_get(arms, i)) != 0 { guarded = guarded + 1 } else { 0 } }
  guarded
}

pub(package) fn pattern_matrix_first_guard_location(arms: i64, count: i64, src: i64) -> DiagnosticLocation {
  let mut i = 0
  let mut location = DiagnosticLocationNone
  while i < count {
    let guard = node_f3(nlist_get(arms, i))
    if guard != 0 {
      location = typeck_source_location(src, expr_diag_pos(guard), expr_diag_len(guard))
      i = count
    } else { i = i + 1 }
  }
  location
}

pub(package) fn pattern_matrix_type_declaration_location(ty: i64, tt: i64) -> DiagnosticLocation {
  if ty_named_is_opaque(ty) {
    let declaration = ty_named_opaque_declaration(ty)
    let declaration_src = module_decl_fact_source(declaration)
    DiagnosticSourceRange(
      DiagnosticSourceBuffer(declaration_src),
      module_decl_fact_name_ptr(declaration) - declaration_src,
      module_decl_fact_name_ptr(declaration) - declaration_src + module_decl_fact_name_len(declaration)
    )
  } else { if ty_tag(ty) == 9 {
    let record = ttable_find_entry_by_hash_kind(tt, ty_f1(ty), 0)
    let entry = if record != 0 { record } else { ttable_find_entry_by_hash_kind(tt, ty_f1(ty), 1) }
    if entry == 0 { DiagnosticLocationNone }
    else {
      let entry_src = ttable_entry_source(entry)
      DiagnosticSourceRange(DiagnosticSourceBuffer(entry_src), ttable_entry_name_ptr(entry) - entry_src, ttable_entry_name_ptr(entry) - entry_src + ttable_entry_name_len(entry))
    }
  } else { DiagnosticLocationNone } }
}

pub(package) fn pattern_matrix_non_exhaustive_message(witness: str, concrete: i64) -> str {
  let b = buf_new(96)
  bstr(b, "non-exhaustive match: ")
  bstr(b, if concrete == 1 { "value `" } else { "value class `" })
  bstr(b, witness)
  bstr(b, "` is not covered")
  runtime_str_from_bytes_copy(buf_ptr(b), buf_len(b))
}

pub(package) fn pattern_matrix_non_exhaustive_suggestion(pattern: str) -> str {
  let b = buf_new(64)
  bstr(b, "add a match arm for `")
  bstr(b, pattern)
  bstr(b, "`")
  runtime_str_from_bytes_copy(buf_ptr(b), buf_len(b))
}

pub(package) fn typeck_non_exhaustive_match_diagnostic(
  arms: i64,
  count: i64,
  src: i64,
  scr_ty: i64,
  tt: i64,
  start: i64,
  len: i64,
  witness: i64
) -> Diagnostic {
  let witness_text = pattern_matrix_witness_render(witness, tt, src, 0)
  let suggested_pattern = pattern_matrix_witness_render(witness, tt, src, 1)
  let concrete = pattern_matrix_witness_is_concrete(witness)
  let guarded_count = pattern_matrix_guarded_arm_count(arms, count)
  let type_location = pattern_matrix_type_declaration_location(scr_ty, tt)
  let related_tail = match type_location {
    DiagnosticLocationNone -> DiagnosticRelatedLocationNil
    _ -> DiagnosticRelatedLocationCons(DiagnosticRelatedLocation("matched type declared here", type_location), DiagnosticRelatedLocationNil)
  }
  let guard_location = pattern_matrix_first_guard_location(arms, count, src)
  let related = match guard_location {
    DiagnosticLocationNone -> related_tail
    _ -> DiagnosticRelatedLocationCons(DiagnosticRelatedLocation("a guarded arm does not prove coverage when its guard is false", guard_location), related_tail)
  }
  Diagnostic(
    DiagnosticSeverityError,
    DiagnosticClassType,
    registry.non_exhaustive_match(),
    pattern_matrix_non_exhaustive_message(witness_text, concrete),
    typeck_source_location(src, start, len),
    related,
    DiagnosticFieldCons(
      DiagnosticFieldText("context", "match"),
      DiagnosticFieldCons(
        DiagnosticFieldText("reason", "uncovered_value"),
        DiagnosticFieldCons(
          DiagnosticFieldText("coverage_model", "recursive_pattern_matrix"),
          DiagnosticFieldCons(
            DiagnosticFieldText("witness", witness_text),
            DiagnosticFieldCons(
              DiagnosticFieldText("witness_kind", if concrete == 1 { "concrete_value" } else { "value_class" }),
              DiagnosticFieldCons(
                DiagnosticFieldText("suggested_pattern", suggested_pattern),
                DiagnosticFieldCons(
                  DiagnosticFieldType("scrutinee_type", semantic_type_fact_from_checker(scr_ty, tt, src)),
                  DiagnosticFieldCons(
                    DiagnosticFieldI64("guarded_arm_count", guarded_count),
                    DiagnosticFieldCons(
                      DiagnosticFieldSuggestion(DiagnosticSuggestion(pattern_matrix_non_exhaustive_suggestion(suggested_pattern), DiagnosticSuggestionMaybeIncorrect, DiagnosticTextEditNil)),
                      DiagnosticFieldNil
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
}

pub(package) fn pattern_matrix_rows_cover_literal(rows: i64, first_ty: i64, expected: i64, src: i64, tt: i64) -[Conformance]> i64 {
  let result = nlist_new()
  if rows != 0 {
    for i in 0..nlist_len(rows) {
      let row = nlist_get(rows, i)
      if row != 0 and nlist_len(row) > 0 {
        let pat = nlist_get(row, 0)
        if pattern_is_irrefutable_for_type(pat, first_ty, src, tt) == 1 or (node_tag(pat) == 19 and node_f1(pat) == expected) {
          nlist_add(result, pattern_matrix_vector_copy_from(row, 1))
        } else { 0 }
      } else { 0 }
    }
  } else { 0 }
  result
}

pub(package) fn pattern_matrix_query_useful_wildcard(rows: i64, tail_query: i64, tail_types: i64, first_ty: i64, src: i64, tt: i64) -[Conformance]> i64 {
  if ty_named_is_opaque(first_ty) {
    let specialized = pattern_matrix_specialize_opaque(rows, first_ty, src, tt)
    let next_query = pattern_matrix_wildcards_then(1, tail_query)
    let opaque_types = nlist_new()
    nlist_add(opaque_types, ty_named_opaque_representation(first_ty))
    let next_types = pattern_matrix_vector_append_into(opaque_types, tail_types)
    pattern_matrix_query_useful(specialized, next_query, next_types, src, tt)
  } else {
  let variant_entry = if ty_tag(first_ty) == 9 { pattern_named_variant_entry_by_hash(tt, ty_f1(first_ty)) } else { 0 }
  if variant_entry != 0 {
    let variants = mem_load64_at(variant_entry, 32)
    let count = mem_load64_at(variant_entry, 24)
    let mut vi = 0
    let mut useful = 0
    while vi < count and useful == 0 {
      let variant = variants + vi * 40
      let specialized = pattern_matrix_specialize_variant(rows, first_ty, variant_entry, variant, src, tt)
      let next_query = pattern_matrix_wildcards_then(mem_load64_at(variant, 24), tail_query)
      let next_types = pattern_matrix_vector_append_into(pattern_matrix_variant_payload_types(variant_entry, variant, first_ty), tail_types)
      if pattern_matrix_query_useful(specialized, next_query, next_types, src, tt) == 1 { useful = 1 }
      else { vi = vi + 1 }
    }
    useful
  } else {
    let shape = typeck_pattern_record_shape(first_ty, tt)
    if shape != 0 {
      let specialized = pattern_matrix_specialize_product(rows, first_ty, shape, src, tt)
      let field_count = if ty_record_fields(shape) == 0 { 0 } else { nlist_len(ty_record_fields(shape)) }
      let next_query = pattern_matrix_wildcards_then(field_count, tail_query)
      let next_types = pattern_matrix_vector_append_into(pattern_matrix_product_types(shape), tail_types)
      pattern_matrix_query_useful(specialized, next_query, next_types, src, tt)
    } else {
      let has_nil = type_allows_nil(first_ty)
      let non_nil = if has_nil == 1 { ty_narrow_drop_nil(first_ty) } else { 0 }
      if has_nil == 1 and non_nil != 0 {
        let nil_rows = pattern_matrix_specialize_nil_class(rows, first_ty, non_nil, 1, src, tt)
        let nil_useful = pattern_matrix_query_useful(nil_rows, tail_query, tail_types, src, tt)
        if nil_useful == 1 { 1 }
        else { if ty_is_empty(non_nil) { 0 }
        else {
          let value_rows = pattern_matrix_specialize_nil_class(rows, first_ty, non_nil, 0, src, tt)
          pattern_matrix_query_useful(value_rows, tail_query, tail_types, src, tt)
        } }
      } else {
        let scalar_rows = pattern_matrix_irrefutable_first_rows(rows, first_ty, src, tt)
        pattern_matrix_query_useful(scalar_rows, tail_query, tail_types, src, tt)
      }
    }
  } }
}

pub(package) fn pattern_matrix_query_useful_ctor(rows: i64, pat: i64, tail_query: i64, tail_types: i64, first_ty: i64, entry: i64, src: i64, tt: i64) -[Conformance]> i64 {
  let variants = mem_load64_at(entry, 32)
  let count = mem_load64_at(entry, 24)
  let mut vi = 0
  let mut result = 0
  while vi < count and result == 0 {
    let variant = variants + vi * 40
    if pattern_matrix_variant_matches(pat, src, mem_load64_at(entry, 48), variant) == 1 {
      let specialized = pattern_matrix_specialize_variant(rows, first_ty, entry, variant, src, tt)
      let next_query = pattern_matrix_vector_append_into(pattern_matrix_ctor_children(pat), tail_query)
      let next_types = pattern_matrix_vector_append_into(pattern_matrix_variant_payload_types(entry, variant, first_ty), tail_types)
      result = pattern_matrix_query_useful(specialized, next_query, next_types, src, tt)
      vi = count
    } else { vi = vi + 1 }
  }
  result
}

pub(package) fn pattern_matrix_query_useful_opaque(rows: i64, pat: i64, tail_query: i64, tail_types: i64, first_ty: i64, src: i64, tt: i64) -[Conformance]> i64 {
  if pattern_matrix_opaque_matches(pat, first_ty, tt) == 0 { 0 }
  else {
    let specialized = pattern_matrix_specialize_opaque(rows, first_ty, src, tt)
    let next_query = pattern_matrix_vector_append_into(pattern_matrix_ctor_children(pat), tail_query)
    let opaque_types = nlist_new()
    nlist_add(opaque_types, ty_named_opaque_representation(first_ty))
    let next_types = pattern_matrix_vector_append_into(opaque_types, tail_types)
    pattern_matrix_query_useful(specialized, next_query, next_types, src, tt)
  }
}

pub(package) fn pattern_matrix_query_useful_product(rows: i64, pat: i64, tail_query: i64, tail_types: i64, first_ty: i64, shape: i64, src: i64, tt: i64) -[Conformance]> i64 {
  let specialized = pattern_matrix_specialize_product(rows, first_ty, shape, src, tt)
  let next_query = pattern_matrix_vector_append_into(pattern_matrix_product_pattern(pat, shape, src), tail_query)
  let next_types = pattern_matrix_vector_append_into(pattern_matrix_product_types(shape), tail_types)
  pattern_matrix_query_useful(specialized, next_query, next_types, src, tt)
}

pub(package) fn pattern_matrix_query_useful(rows: i64, query: i64, types: i64, src: i64, tt: i64) -[Conformance]> i64 {
  let column_count = if types == 0 { 0 } else { nlist_len(types) }
  if column_count == 0 { if rows == 0 or nlist_len(rows) == 0 { 1 } else { 0 } }
  else { if query == 0 or nlist_len(query) == 0 { 0 }
  else {
    let first_ty = nlist_get(types, 0)
    if ty_is_empty(first_ty) { 0 }
    else { if rows == 0 or nlist_len(rows) == 0 { 1 }
    else {
      let pat = nlist_get(query, 0)
      let tag = node_tag(pat)
      let tail_query = pattern_matrix_vector_copy_from(query, 1)
      let tail_types = pattern_matrix_vector_copy_from(types, 1)
      let variant_entry = if ty_tag(first_ty) == 9 { pattern_named_variant_entry_by_hash(tt, ty_f1(first_ty)) } else { 0 }
      let shape = if variant_entry == 0 { typeck_pattern_record_shape(first_ty, tt) } else { 0 }
      let irrefutable_rows = pattern_matrix_irrefutable_first_rows(rows, first_ty, src, tt)
      -- This cut prevents wildcard expansion from chasing recursive type
      -- definitions forever.  It is valid only for an irrefutable query:
      -- specific nil/typed/constructor/product queries must still select
      -- their own class before deciding whether earlier rows cover it.
      let already_covered = if not (tag == 17 or tag == 18) or nlist_len(irrefutable_rows) == 0 { 0 }
        else { if pattern_matrix_query_useful(irrefutable_rows, tail_query, tail_types, src, tt) == 0 { 1 } else { 0 } }
      if already_covered == 1 { 0 }
      else { match tag {
        19 -> pattern_matrix_query_useful(pattern_matrix_rows_cover_literal(rows, first_ty, node_f1(pat), src, tt), tail_query, tail_types, src, tt)
        20 -> if ty_named_is_opaque(first_ty) { pattern_matrix_query_useful_opaque(rows, pat, tail_query, tail_types, first_ty, src, tt) }
          else { if variant_entry == 0 { 0 } else { pattern_matrix_query_useful_ctor(rows, pat, tail_query, tail_types, first_ty, variant_entry, src, tt) } }
        67 -> if ty_named_is_opaque(first_ty) { pattern_matrix_query_useful_opaque(rows, pat, tail_query, tail_types, first_ty, src, tt) }
          else { if variant_entry == 0 { 0 } else { pattern_matrix_query_useful_ctor(rows, pat, tail_query, tail_types, first_ty, variant_entry, src, tt) } }
        61 -> pattern_matrix_query_useful(pattern_matrix_specialize_nil_class(rows, first_ty, ty_narrow_drop_nil(first_ty), 1, src, tt), tail_query, tail_types, src, tt)
        64 -> if shape == 0 or ty_record_tuple_kind(shape) == 1 { 0 } else { pattern_matrix_query_useful_product(rows, pat, tail_query, tail_types, first_ty, shape, src, tt) }
        65 -> if shape == 0 or ty_record_tuple_kind(shape) == 0 { 0 } else { pattern_matrix_query_useful_product(rows, pat, tail_query, tail_types, first_ty, shape, src, tt) }
        60 -> {
          let has_nil = type_allows_nil(first_ty)
          if pattern_is_irrefutable_for_type(pat, first_ty, src, tt) == 0 and has_nil == 1 {
            let non_nil = ty_narrow_drop_nil(first_ty)
            pattern_matrix_query_useful(pattern_matrix_specialize_nil_class(rows, first_ty, non_nil, 0, src, tt), tail_query, tail_types, src, tt)
          } else { pattern_matrix_query_useful_wildcard(rows, tail_query, tail_types, first_ty, src, tt) }
        }
        _ -> pattern_matrix_query_useful_wildcard(rows, tail_query, tail_types, first_ty, src, tt)
      } }
    } }
  } }
}

pub(package) fn check_match_pattern_usefulness(arms: i64, count: i64, scr_ty: i64, src: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let previous = nlist_new()
  let types = nlist_new()
  nlist_add(types, scr_ty)
  let mut errors = 0
  for i in 0..count {
    let arm = nlist_get(arms, i)
    if node_f3(arm) == 0 {
      let pat = node_f1(arm)
      let query = nlist_new()
      nlist_add(query, pat)
      if pattern_matrix_query_useful(previous, query, types, src, tt) == 0 {
        let tag = node_tag(pat)
        -- A final defensive catch-all is intentionally permitted: compiler
        -- IR consumers use it as a forward-compatibility boundary even when
        -- today's closed variants make it redundant. Structured/literal
        -- rows still receive exact usefulness diagnostics.
        if tag == 17 or tag == 18 {
          let row = nlist_new()
          nlist_add(row, pat)
          nlist_add(previous, row)
        }
        else {
          if tag == 20 or tag == 67 { typeck_error_maybe(src, pattern_diag_pos(pat), "type error: duplicate match constructor arm") }
          else { typeck_error_maybe(src, pattern_diag_pos(pat), "type error: unreachable match arm") }
          errors = errors + 1
        }
      } else {
        let row = nlist_new()
        nlist_add(row, pat)
        nlist_add(previous, row)
      }
    } else { 0 }
  }
  errors
}

pub(package) fn match_destructuring_origin(node: i64) -> i64 {
  let meta = node_f4(node)
  if meta == 0 { 0 } else { node_f1(meta) }
}

pub(package) fn check_match_exhaustive(arms: i64, n: i64, src: i64, scr_ty: i64, tt: i64, pos: i64, len: i64) -[Conformance, Diagnose]> i64 {
  if type_is_unknown_or_any(scr_ty) {
    0
  } else {
    let types = nlist_new()
    nlist_add(types, scr_ty)
    let uncovered = pattern_matrix_uncovered_witness(pattern_matrix_from_arms(arms, n), types, src, tt)
    if uncovered == 0 { 0 }
    else {
      Diagnose.report(typeck_non_exhaustive_match_diagnostic(arms, n, src, scr_ty, tt, pos, len, nlist_get(uncovered, 0)))
      1
    }
  }
}

pub(package) fn variant_payload_type(tt: i64, src: i64, tag_ns: i64, tag_nl: i64, scr_ty: i64, idx: i64) -> i64 {
  if tt == 0 { ty_i64() }
  else { if ty_tag(scr_ty) != 9 { ty_i64() }
  else {
    let type_hash = ty_f1(scr_ty)
    let type_args = ty_f3(scr_ty)
    let n = mem_load64_at(tt, 8)
    let d = mem_load64_at(tt, 0)
    let mut ti = 0
    let mut result = ty_i64()
    while ti < n {
      let kind = mem_load64_at(d, ti * 64 + 16)
      if kind == 1 {
        let entry_src = mem_load64_at(d, ti * 64 + 48)
        let type_ns = mem_load64_at(d, ti * 64)
        let type_nl = mem_load64_at(d, ti * 64 + 8)
        if mem_load64_at(d, ti * 64 + 56) == type_hash {
          let nvariants = mem_load64_at(d, ti * 64 + 24)
          let variants = mem_load64_at(d, ti * 64 + 32)
          let tparams = mem_load64_at(d, ti * 64 + 40)
          let mut vi = 0
          while vi < nvariants {
            let v_ns = mem_load64_at(variants, vi * 40)
            let v_nl = mem_load64_at(variants, vi * 40 + 8)
            if v_nl == tag_nl {
              if src_eq_at(src, tag_ns, entry_src + v_ns, 0, tag_nl) == 1 {
                let npayloads = mem_load64_at(variants, vi * 40 + 24)
                let payloads = mem_load64_at(variants, vi * 40 + 32)
                if idx < npayloads {
                  let pty = if payloads != 0 { nlist_get(payloads, idx) } else { ty_i64() }
                  if tparams != 0 {
                    if type_args != 0 { result = ty_subst(pty, build_subst(tparams, type_args)) }
                    else { result = pty }
                  } else { result = pty }
                } else { result = ty_i64() }
                vi = nvariants
                ti = n
              } else { vi = vi + 1 }
            } else { vi = vi + 1 }
          }
          if ti < n { ti = ti + 1 } else { ti = ti }
        } else { ti = ti + 1 }
      } else { ti = ti + 1 }
    }
    result
  } }
}

pub(package) fn ctor_pattern_raw(pat: i64) -> i64 { if node_tag(pat) == 67 { node_f1(pat) } else { pat } }
pub(package) fn ctor_pattern_decl(pat: i64) -> i64 { if node_tag(pat) == 67 { node_f2(pat) } else { 0 } }
pub(package) fn pattern_is_ctor(pat: i64) -> i64 { if node_tag(pat) == 20 or node_tag(pat) == 67 { 1 } else { 0 } }

pub(package) fn typeck_opaque_pattern_entry(pat: i64, tt: i64) -> i64 {
  let declaration = ctor_pattern_decl(pat)
  let entry = if declaration == 0 { 0 } else { ttable_lookup_decl_fact(tt, declaration) }
  if entry != 0 and mem_load64_at(entry, 16) == 5 { entry } else { 0 }
}

pub(package) fn typeck_pattern_child_view(parent_ty: i64, child_ty: i64, tt: i64) -> i64 {
  if not ty_is_borrow(parent_ty) or child_ty == 0 { child_ty }
  else {
    let fact = typeck_linear_layout_type(tt, child_ty)
    if typeck_linear_layout_fact_decision(fact) == typeck_linear_layout_decision_linear() {
      ty_borrow(if ty_is_owned(child_ty) { ty_owned_inner(child_ty) } else { child_ty })
    } else { child_ty }
  }
}

pub(package) fn typeck_mark_opaque_pattern(wrapper: i64, declaration: i64) -> i64 {
  if node_tag(wrapper) == 67 { mem_store64_at(wrapper, 16, declaration) }
  else {
    let raw = node_new(20, node_f1(wrapper), node_f2(wrapper), node_f3(wrapper), node_f4(wrapper))
    mem_store64_at(wrapper, 0, 67)
    mem_store64_at(wrapper, 8, raw)
    mem_store64_at(wrapper, 16, declaration)
    mem_store64_at(wrapper, 24, 0)
    mem_store64_at(wrapper, 32, 0)
  }
  wrapper
}

pub(package) fn bind_ctor_pattern(pat: i64, env: i64, src: i64, scr_ty: i64, tt: i64) -> i64 {
  let wrapper = pat
  let raw = ctor_pattern_raw(wrapper)
  let tag_ns = node_f1(raw)
  let tag_nl = node_f2(raw)
  let destructured_ty = typeck_match_pattern_scrutinee_type(raw, scr_ty)
  let scr_decl = if ty_named_is_opaque(destructured_ty) { ty_named_opaque_declaration(destructured_ty) } else { 0 }
  let scr_name_matches = if scr_decl == 0 or module_decl_fact_source(scr_decl) != src or module_decl_fact_name_len(scr_decl) != tag_nl { 0 }
    else { src_eq_at(src, tag_ns, module_decl_fact_name_ptr(scr_decl), 0, tag_nl) }
  let inferred_entry = if node_tag(wrapper) == 20 and scr_name_matches == 1 { ttable_lookup_decl_fact(tt, scr_decl) } else { 0 }
  let opaque_entry = if inferred_entry != 0 and mem_load64_at(inferred_entry, 16) == 5 {
    typeck_mark_opaque_pattern(wrapper, scr_decl)
    inferred_entry
  } else { typeck_opaque_pattern_entry(wrapper, tt) }
  let pat = ctor_pattern_raw(wrapper)
  let b_ns = node_f3(pat)
  let b_nl = node_f4(pat)
  if opaque_entry != 0 {
    let representation = if ty_named_is_opaque(destructured_ty) { ty_named_opaque_representation(destructured_ty) }
      else { ttable_entry_opaque_representation(opaque_entry) }
    let view_ty = typeck_pattern_child_view(scr_ty, representation, tt)
    if b_nl > 0 {
      let result = tenv_bind_kind(env, src, b_ns, b_nl, view_ty, semantic_symbol_kind_pattern())
      typeck_record_binding_fact(tt, src, b_ns, b_nl, view_ty, semantic_symbol_kind_pattern(), result)
      result
    } else { if b_nl < 0 and 0 - b_nl == 1 {
      bind_pattern(nlist_get(b_ns, 0), env, src, view_ty, tt)
    } else { env } }
  } else { if b_nl > 0 {
    let bind_ty = typeck_pattern_child_view(scr_ty, variant_payload_type(tt, src, tag_ns, tag_nl, destructured_ty, 0), tt)
    let result = tenv_bind_kind(env, src, b_ns, b_nl, bind_ty, semantic_symbol_kind_pattern())
    typeck_record_binding_fact(tt, src, b_ns, b_nl, bind_ty, semantic_symbol_kind_pattern(), result)
    result
  } else { if b_nl < 0 {
    let bindings = b_ns
    let nb = 0 - b_nl
    let mut result = env
    for i in 0..nb {
      let b = nlist_get(bindings, i)
      let payload_ty = variant_payload_type(tt, src, tag_ns, tag_nl, destructured_ty, i)
      result = bind_pattern(b, result, src, typeck_pattern_child_view(scr_ty, payload_ty, tt), tt)
    }
    result
  } else { env } } }
}

pub(package) fn typeck_pattern_record_shape(scr_ty: i64, tt: i64) -> i64 {
  let destructured_ty = typeck_match_matrix_scrutinee_type(scr_ty)
  if ty_is_record(destructured_ty) { destructured_ty }
  else { if ty_tag(destructured_ty) == 9 { typeck_named_record_projection(tt, destructured_ty) } else { 0 } }
}

pub(package) fn typeck_pattern_record_field_type(scr_ty: i64, tt: i64, src: i64, field_ns: i64, field_nl: i64) -> i64 {
  let shape = typeck_pattern_record_shape(scr_ty, tt)
  if shape == 0 { ty_any() }
  else {
    let field = ty_record_field_by_hash(ty_record_fields(shape), effect_name_hash(src, field_ns, field_nl))
    if field == 0 { ty_any() } else { ty_record_field_type(field) }
  }
}

pub(package) fn bind_record_pattern(pat: i64, env: i64, src: i64, scr_ty: i64, tt: i64) -> i64 {
  let fields = node_f1(pat)
  let mut result = env
  for i in 0..node_f2(pat) {
    let field = nlist_get(fields, i)
    let field_ty = typeck_pattern_record_field_type(scr_ty, tt, src, node_f1(field), node_f2(field))
    result = bind_pattern(node_f3(field), result, src, typeck_pattern_child_view(scr_ty, field_ty, tt), tt)
  }
  result
}

pub(package) fn bind_tuple_pattern(pat: i64, env: i64, src: i64, scr_ty: i64, tt: i64) -> i64 {
  let items = node_f1(pat)
  let tuple_ty = typeck_match_matrix_scrutinee_type(scr_ty)
  let fields = ty_record_fields(tuple_ty)
  let mut result = env
  for i in 0..node_f2(pat) {
    let field = if fields == 0 or i >= nlist_len(fields) { 0 } else { ty_record_field_at_layout_index(tuple_ty, i) }
    let item_ty = if field == 0 { ty_any() } else { ty_record_field_type(field) }
    result = bind_pattern(nlist_get(items, i), result, src, typeck_pattern_child_view(scr_ty, item_ty, tt), tt)
  }
  result
}

-- Bind pattern variables to the environment with the scrutinee type
pub(package) fn bind_pattern(pat: i64, env: i64, src: i64, scr_ty: i64, tt: i64) -> i64 {
  let tag = node_tag(pat)
  match tag {
    -- Wildcard: no bindings
    17 -> env
    -- Binding: bind name to scrutinee type
    18 -> {
      let result = tenv_bind_kind(env, src, node_f1(pat), node_f2(pat), scr_ty, semantic_symbol_kind_pattern())
      typeck_record_binding_fact(tt, src, node_f1(pat), node_f2(pat), scr_ty, semantic_symbol_kind_pattern(), result)
      result
    }
    -- IntLit pattern: no bindings
    19 -> env
    -- Constructor pattern: bind payload variables from the variant declaration.
    20 -> bind_ctor_pattern(pat, env, src, scr_ty, tt)
    67 -> bind_ctor_pattern(pat, env, src, scr_ty, tt)
    -- Typed binding (kernel §6.2): bind the name at the ANNOTATED type
    -- — set-theoretic narrowing is the point of the arm.
    60 -> {
      let result = tenv_bind_kind(env, src, node_f1(pat), node_f2(pat), node_f3(pat), semantic_symbol_kind_pattern())
      typeck_record_binding_fact(tt, src, node_f1(pat), node_f2(pat), node_f3(pat), semantic_symbol_kind_pattern(), result)
      result
    }
    -- nil pattern: no bindings
    61 -> env
    -- Product patterns recursively bind their selected fields/lanes.
    64 -> bind_record_pattern(pat, env, src, scr_ty, tt)
    65 -> bind_tuple_pattern(pat, env, src, scr_ty, tt)
    _ -> env
  }
}

pub(package) fn ctor_pattern_binding_count(pat: i64) -> i64 {
  let pat = ctor_pattern_raw(pat)
  let b_nl = node_f4(pat)
  if b_nl > 0 { 1 }
  else { if b_nl < 0 { 0 - b_nl } else { 0 } }
}

pub(package) fn variant_payload_count_in_named_type(tt: i64, src: i64, tag_ns: i64, tag_nl: i64, type_hash: i64) -> i64 {
  if tt == 0 { 0 - 1 }
  else {
    let n = mem_load64_at(tt, 8)
    let d = mem_load64_at(tt, 0)
    let mut result = 0 - 1
    let mut ti = 0
    while ti < n {
      let kind = mem_load64_at(d, ti * 64 + 16)
      if kind == 1 {
        let entry_src = mem_load64_at(d, ti * 64 + 48)
        let type_ns = mem_load64_at(d, ti * 64)
        let type_nl = mem_load64_at(d, ti * 64 + 8)
        if mem_load64_at(d, ti * 64 + 56) == type_hash {
          let nvariants = mem_load64_at(d, ti * 64 + 24)
          let variants = mem_load64_at(d, ti * 64 + 32)
          let mut vi = 0
          while vi < nvariants {
            let v_ns = mem_load64_at(variants, vi * 40)
            let v_nl = mem_load64_at(variants, vi * 40 + 8)
            if v_nl == tag_nl {
              if src_eq_at(src, tag_ns, entry_src + v_ns, 0, tag_nl) == 1 {
                result = mem_load64_at(variants, vi * 40 + 24)
                vi = nvariants
                ti = n
              } else { vi = vi + 1 }
            } else { vi = vi + 1 }
          }
          if ti < n { ti = ti + 1 } else { ti = ti }
        } else { ti = ti + 1 }
      } else { ti = ti + 1 }
    }
    result
  }
}

pub(package) fn pattern_diag_pos(pat: i64) -> i64 {
  let tag = node_tag(pat)
  match tag {
    18 -> node_f1(pat)
    19 -> if node_f3(pat) > 0 { node_f2(pat) } else { node_f1(pat) }
    20 -> node_f1(pat)
    67 -> node_f1(ctor_pattern_raw(pat))
    60 -> node_f1(pat)
    61 -> node_f1(pat)
    64 -> if node_f2(pat) > 0 { node_f1(nlist_get(node_f1(pat), 0)) } else { 0 }
    65 -> if node_f2(pat) > 0 { pattern_diag_pos(nlist_get(node_f1(pat), 0)) } else { 0 }
    _ -> 0
  }
}

-- Typed match arm admission (kernel §6.2, option-1 discipline
-- 2026-08-03): the annotation must be a member of the scrutinee set,
-- and the arm must have a runtime test to compile to. Discriminable
-- shapes in v1: the annotation covers the WHOLE scrutinee (no test —
-- a typed catch-all), or the scrutinee is `A | nil` and the
-- annotation is exactly its non-nil part (test = the nil sentinel).
-- Everything else — `i64 | str`, two distinct nominal types — has no
-- runtime discrimination in Weft's untagged unions and is rejected
-- with a diagnostic that teaches the fix (a variant type IS the
-- explicit tagged sum).
pub(package) fn check_typed_pattern(pat: i64, scr_ty: i64, src: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let ann = node_f3(pat)
  if type_is_unknown_or_any(scr_ty) { 0 }
  else { if type_is_unknown_or_any(ann) { 0 }
  else {
    if not is_subtype(ann, scr_ty) {
      typeck_error_maybe(src, node_f1(pat), "type error: typed match arm annotation is not part of the scrutinee type")
      1
    } else { if is_subtype(scr_ty, ann) {
      0
    } else {
      let non_nil = ty_narrow_drop_nil(scr_ty)
      let discriminable = if non_nil == 0 { 0 }
        else { if is_subtype(non_nil, ann) and is_subtype(ann, non_nil) { 1 } else { 0 } }
      if discriminable == 1 { 0 }
      else {
        typeck_error_maybe(src, node_f1(pat), "type error: typed match arm needs a runtime-discriminable union (nil-sentinel or variant family) — untagged unions like i64 | str carry no runtime tag; use a variant type to tag the members")
        1
      }
    } }
  } }
}

pub(package) fn check_nil_pattern(pat: i64, scr_ty: i64, src: i64) -[Conformance, Diagnose]> i64 {
  if type_is_unknown_or_any(scr_ty) { 0 }
  else {
    if ty_is_empty(ty_inter(scr_ty, ty_nil())) {
      typeck_error_maybe(src, node_f1(pat), "type error: nil match arm on a scrutinee that is never nil")
      1
    } else { 0 }
  }
}

pub(package) fn check_pattern(pat: i64, scr_ty: i64, src: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let tag = node_tag(pat)
  match tag {
    19 -> check_int_pattern(pat, scr_ty, src)
    20 -> check_ctor_pattern(pat, scr_ty, src, tt)
    67 -> check_ctor_pattern(pat, scr_ty, src, tt)
    60 -> check_typed_pattern(pat, scr_ty, src, tt)
    61 -> check_nil_pattern(pat, scr_ty, src)
    64 -> check_record_pattern(pat, scr_ty, src, tt)
    65 -> check_tuple_pattern(pat, scr_ty, src, tt)
    _ -> 0
  }
}

pub(package) fn record_pattern_field_seen_before(fields: i64, index: i64, src: i64) -> i64 {
  let current = nlist_get(fields, index)
  let wanted = effect_name_hash(src, node_f1(current), node_f2(current))
  let mut i = 0
  let mut found = 0
  while i < index and found == 0 {
    let earlier = nlist_get(fields, i)
    if effect_name_hash(src, node_f1(earlier), node_f2(earlier)) == wanted { found = 1 }
    else { i = i + 1 }
  }
  found
}

pub(package) fn check_record_pattern(pat: i64, scr_ty: i64, src: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  if type_is_unknown_or_any(scr_ty) { 0 }
  else {
    let shape = typeck_pattern_record_shape(scr_ty, tt)
    if shape == 0 or ty_record_tuple_kind(shape) == 1 {
      typeck_error_maybe(src, pattern_diag_pos(pat), "type error: record pattern does not match scrutinee")
      1
    } else {
      let fields = node_f1(pat)
      let count = node_f2(pat)
      let structural = if ty_is_record(scr_ty) { 1 } else { 0 }
      let entry = if structural == 1 { 0 } else { ttable_lookup_by_type_hash(tt, ty_f1(scr_ty)) }
      let mut errors = 0
      for i in 0..count {
        let raw_field = nlist_get(fields, i)
        let field_ns = node_f1(raw_field)
        let field_nl = node_f2(raw_field)
        let field_hash = effect_name_hash(src, field_ns, field_nl)
        if record_pattern_field_seen_before(fields, i, src) == 1 {
          typeck_error_maybe(src, field_ns, "type error: duplicate record pattern field")
          errors = errors + 1
        } else {
          let shape_field = ty_record_field_by_hash(ty_record_fields(shape), field_hash)
          if shape_field == 0 {
            typeck_error_maybe(src, field_ns, "type error: unknown record pattern field")
            errors = errors + 1
          } else {
            let field_ty = ty_record_field_type(shape_field)
            let word_offset = if structural == 1 { ty_record_field_word_offset(shape, field_hash) }
              else { typeck_named_record_field_word_offset(entry, scr_ty, src, field_ns, field_nl) }
            mem_store64_at(raw_field, 32, node_new(1, field_ty, word_offset, scr_ty, structural))
            errors = errors + check_pattern(node_f3(raw_field), field_ty, src, tt)
          }
        }
      }
      errors
    }
  }
}

pub(package) fn check_tuple_pattern(pat: i64, scr_ty: i64, src: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  if type_is_unknown_or_any(scr_ty) { 0 }
  else { if not ty_is_record(scr_ty) or ty_record_tuple_kind(scr_ty) != 1 {
    typeck_error_maybe(src, pattern_diag_pos(pat), "type error: tuple pattern does not match scrutinee")
    1
  } else {
    let fields = ty_record_fields(scr_ty)
    let expected = if fields == 0 { 0 } else { nlist_len(fields) }
    let actual = node_f2(pat)
    if expected != actual {
      typeck_error_maybe(src, pattern_diag_pos(pat), "type error: tuple pattern arity mismatch")
      1
    } else {
      let items = node_f1(pat)
      let mut errors = 0
      for i in 0..actual {
        errors = errors + check_pattern(nlist_get(items, i), ty_record_field_type(ty_record_field_at_layout_index(scr_ty, i)), src, tt)
      }
      errors
    }
  } }
}

pub(package) fn check_int_pattern(pat: i64, scr_ty: i64, src: i64) -[Conformance, Diagnose]> i64 {
  if type_is_unknown_or_any(scr_ty) { 0 }
  else {
    let prim = type_int_prim(scr_ty)
    if prim >= 0 {
      if int_literal_positive_fits_prim(pat, prim, src) == 1 { 0 }
      else {
        typeck_error(src, pattern_diag_pos(pat), "type error: literal pattern does not match scrutinee")
        1
      }
    } else { if ty_is_empty(ty_inter(scr_ty, ty_i64())) {
      typeck_error(src, pattern_diag_pos(pat), "type error: literal pattern does not match scrutinee")
      1
    } else { 0 } }
  }
}

pub(package) fn check_ctor_pattern(pat: i64, scr_ty: i64, src: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let wrapper = pat
  let pat = ctor_pattern_raw(wrapper)
  let tag_ns = node_f1(pat)
  let tag_nl = node_f2(pat)
  -- A bare opaque projection is rewritten to the resolved tag-67 wrapper
  -- during synthesis. Only a non-empty qualifier span means the user wrote
  -- `module.Name(...)`; resolved bare patterns keep both qualifier fields 0.
  let qualified = node_tag(wrapper) == 67 and node_f4(wrapper) > 0
  let scr_decl = if ty_named_is_opaque(scr_ty) { ty_named_opaque_declaration(scr_ty) } else { 0 }
  let qualified_type_decl = if qualified {
    module_scope_lookup_qualified_declaration(tt, src, src, node_f3(wrapper), node_f4(wrapper), module_decl_namespace_type(), src, tag_ns, tag_nl)
  } else { 0 }
  let local_type_decl = if qualified { qualified_type_decl }
    else { module_scope_lookup_declaration(tt, src, module_decl_namespace_type(), src, tag_ns, tag_nl) }
  let candidate_decl = if scr_decl != 0 { scr_decl } else { local_type_decl }
  let candidate_entry = if candidate_decl == 0 { 0 } else { ttable_lookup_decl_fact(tt, candidate_decl) }
  let candidate_opaque = candidate_entry != 0 and mem_load64_at(candidate_entry, 16) == 5
  let name_matches = if candidate_decl == 0 { 0 }
    else { if module_decl_fact_name_len(candidate_decl) != tag_nl { 0 }
    else { src_eq_at(src, tag_ns, module_decl_fact_name_ptr(candidate_decl), 0, tag_nl) } }
  if candidate_opaque and name_matches == 1 {
    if qualified or module_decl_fact_source(candidate_decl) != src {
      typeck_error_maybe(src, tag_ns, "type error: opaque projection pattern is private to its declaring module; use an exported accessor")
      1
    } else {
      typeck_mark_opaque_pattern(wrapper, candidate_decl)
      let bind_count = ctor_pattern_binding_count(wrapper)
      if bind_count != 1 {
        typeck_error_maybe(src, tag_ns, "type error: opaque projection pattern requires exactly one child pattern")
        1
      } else {
        let raw = ctor_pattern_raw(wrapper)
        if node_f4(raw) > 0 { 0 }
        else {
          check_pattern(nlist_get(node_f3(raw), 0), ty_named_opaque_representation(scr_ty), src, tt)
        }
      }
    }
  } else { if scr_decl != 0 {
    typeck_error_maybe(src, tag_ns, "type error: constructor pattern does not match opaque scrutinee")
    1
  } else {
  let decl = if qualified {
    let found = module_scope_lookup_qualified_declaration(tt, src, src, node_f3(wrapper), node_f4(wrapper), module_decl_namespace_constructor(), src, tag_ns, tag_nl)
    if found != 0 { mem_store64_at(wrapper, 16, found) } else { 0 }
    found
  } else { 0 }
  let origin_src = if decl == 0 { src } else { module_decl_fact_source(decl) }
  let origin_ns = if decl == 0 { tag_ns } else { module_decl_fact_name_ptr(decl) - origin_src }
  let global_count = if qualified and decl == 0 { 0 - 1 } else { ttable_variant_payload_count(tt, origin_src, origin_ns, tag_nl) }
  if global_count < 0 {
    if qualified { check_module_member_resolution(node_new(2, node_f3(wrapper), node_f4(wrapper), 0, 0), tag_ns, tag_nl, src, tt) }
    else { typeck_error(src, tag_ns, "type error: unknown constructor pattern") }
    1
  } else {
    let owner_entry = if decl == 0 { 0 } else { ttable_lookup_decl_fact(tt, module_decl_fact_owner(decl)) }
    let identity_matches = if owner_entry == 0 or type_is_unknown_or_any(scr_ty) { 1 }
      else { if ty_tag(scr_ty) == 9 and mem_load64_at(owner_entry, 56) == ty_f1(scr_ty) { 1 } else { 0 } }
    let payload_count = if identity_matches == 0 { 0 - 1 }
    else { if type_is_unknown_or_any(scr_ty) {
      global_count
    } else { if ty_tag(scr_ty) == 9 {
      variant_payload_count_in_named_type(tt, src, tag_ns, tag_nl, ty_f1(scr_ty))
    } else { 0 - 1 } } }
    if payload_count < 0 {
      typeck_error(src, tag_ns, "type error: constructor pattern does not match scrutinee")
      1
    } else {
      let bind_count = ctor_pattern_binding_count(pat)
      if bind_count == payload_count {
        let b_ns = node_f3(pat)
        let b_nl = node_f4(pat)
        if b_nl > 0 { 0 }
        else {
          let mut errors = 0
          let bindings = b_ns
          for i in 0..bind_count {
            errors = errors + check_pattern(nlist_get(bindings, i), variant_payload_type(tt, src, tag_ns, tag_nl, scr_ty, i), src, tt)
          }
          errors
        }
      }
      else {
        typeck_error(src, tag_ns, "type error: constructor pattern arity mismatch")
        1
      }
    }
  }
  } }
}

-- ══════════════════════════════════════════════════════════════
-- Type checking: verify type constraints
-- ══════════════════════════════════════════════════════════════

-- Check a binary operation's operand types
pub(package) fn check_binop(node: i64, env: i64, ft: i64, src: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let op = node_f1(node)
  let lhs = node_f2(node)
  let rhs = node_f3(node)
  let lhs_ty = synth(lhs, env, ft, src, tt)
  let rhs_ty = synth(rhs, env, ft, src, tt)
  -- Use LHS position for error reporting (best available)
  let pos = expr_diag_pos(lhs)
  match op {
    1 -> check_arith_operand_node(op, lhs, rhs, lhs_ty, rhs_ty, src, pos)
    2 -> check_arith_operand_node(op, lhs, rhs, lhs_ty, rhs_ty, src, pos)
    3 -> check_arith_operand_node(op, lhs, rhs, lhs_ty, rhs_ty, src, pos)
    4 -> check_arith_operand_node(op, lhs, rhs, lhs_ty, rhs_ty, src, pos)
    5 -> check_equality_operand(lhs, rhs, lhs_ty, rhs_ty, src, pos)
    6 -> check_equality_operand(lhs, rhs, lhs_ty, rhs_ty, src, pos)
    7 -> check_order_operand(node, lhs, rhs, lhs_ty, rhs_ty, src, pos, tt)
    8 -> check_order_operand(node, lhs, rhs, lhs_ty, rhs_ty, src, pos, tt)
    9 -> check_order_operand(node, lhs, rhs, lhs_ty, rhs_ty, src, pos, tt)
    10 -> check_order_operand(node, lhs, rhs, lhs_ty, rhs_ty, src, pos, tt)
    11 -> check_integer_operand_node(lhs, rhs, lhs_ty, rhs_ty, src, pos, "type error: arithmetic operand is not i64", "type error: arithmetic operand type mismatch")
    12 -> check_logical_operand(lhs_ty, rhs_ty, src, pos)
    13 -> check_logical_operand(lhs_ty, rhs_ty, src, pos)
    14 -> check_integer_operand_node(lhs, rhs, lhs_ty, rhs_ty, src, pos, "type error: bitwise operand is not i64", "type error: bitwise operand type mismatch")
    15 -> check_integer_operand_node(lhs, rhs, lhs_ty, rhs_ty, src, pos, "type error: bitwise operand is not i64", "type error: bitwise operand type mismatch")
    16 -> check_integer_operand_node(lhs, rhs, lhs_ty, rhs_ty, src, pos, "type error: bitwise operand is not i64", "type error: bitwise operand type mismatch")
    17 -> check_integer_operand_node(lhs, rhs, lhs_ty, rhs_ty, src, pos, "type error: bitwise operand is not i64", "type error: bitwise operand type mismatch")
    18 -> check_integer_operand_node(lhs, rhs, lhs_ty, rhs_ty, src, pos, "type error: bitwise operand is not i64", "type error: bitwise operand type mismatch")
    _ -> 0
  }
}

pub(package) fn check_equality_operand(lhs: i64, rhs: i64, lhs_ty: i64, rhs_ty: i64, src: i64, pos: i64) -[Conformance, Diagnose]> i64 {
  if type_is_unknown_or_any(lhs_ty) { 0 }
  else { if type_is_unknown_or_any(rhs_ty) { 0 }
  else { if is_subtype(lhs_ty, ty_i64()) and is_subtype(rhs_ty, ty_i64()) { 0 }
  else { if type_is_integer_exact(lhs_ty) == 1 or type_is_integer_exact(rhs_ty) == 1 {
    let prim = int_binop_candidate_prim(lhs_ty, rhs_ty)
    if expr_matches_int_prim_contextual(lhs, lhs_ty, prim, src) == 1 and expr_matches_int_prim_contextual(rhs, rhs_ty, prim, src) == 1 { 0 }
    else {
      typeck_error_maybe(src, pos, "type error: equality operand mismatch")
      1
    }
  }
  else { if (type_is_f32_exact(lhs_ty) == 1 or type_is_f32_exact(rhs_ty) == 1) and expr_matches_f32_contextual(lhs, lhs_ty) == 1 and expr_matches_f32_contextual(rhs, rhs_ty) == 1 { 0 }
  else { if type_is_f64_exact(lhs_ty) and type_is_f64_exact(rhs_ty) { 0 }
  else { if type_nullable_equality_compatible(lhs_ty, rhs_ty) == 1 { 0 }
  else { if is_subtype(lhs_ty, rhs_ty) {
    if is_subtype(rhs_ty, lhs_ty) { 0 }
    else {
      typeck_error_maybe(src, pos, "type error: equality operand mismatch")
      1
    }
  } else {
    typeck_error_maybe(src, pos, "type error: equality operand mismatch")
    1
  } } } } } } } }
}

pub(package) fn check_i64_operand(lhs_ty: i64, rhs_ty: i64, src: i64, pos: i64, msg: str) -[Conformance, Diagnose]> i64 {
  let mut errors = 0
  if type_is_unknown_or_any(lhs_ty) { errors = errors }
  else { if not is_subtype(lhs_ty, ty_i64()) {
    typeck_error_maybe(src, pos, msg)
    errors = errors + 1
  } else { errors = errors } }
  if type_is_unknown_or_any(rhs_ty) { errors = errors }
  else { if not is_subtype(rhs_ty, ty_i64()) {
    typeck_error_maybe(src, pos, msg)
    errors = errors + 1
  } else { errors = errors } }
  errors
}

pub(package) fn numeric_pair_matches(lhs: i64, rhs: i64, lhs_ty: i64, rhs_ty: i64, src: i64) -> i64 {
  if type_is_unknown_or_any(lhs_ty) or type_is_unknown_or_any(rhs_ty) { 1 }
  else {
    let prim = int_binop_candidate_prim(lhs_ty, rhs_ty)
    let both_int = expr_matches_int_prim_contextual(lhs, lhs_ty, prim, src) == 1 and expr_matches_int_prim_contextual(rhs, rhs_ty, prim, src) == 1
    let both_f32 = (type_is_f32_exact(lhs_ty) == 1 or type_is_f32_exact(rhs_ty) == 1) and expr_matches_f32_contextual(lhs, lhs_ty) == 1 and expr_matches_f32_contextual(rhs, rhs_ty) == 1
    let both_f64 = type_is_f64_exact(lhs_ty) and type_is_f64_exact(rhs_ty)
    if both_int or both_f32 or both_f64 { 1 } else { 0 }
  }
}

pub(package) fn check_numeric_pair_or_legacy(lhs: i64, rhs: i64, lhs_ty: i64, rhs_ty: i64, src: i64, pos: i64, legacy_msg: str, mismatch_msg: str) -[Diagnose]> i64 {
  if numeric_pair_matches(lhs, rhs, lhs_ty, rhs_ty, src) == 1 { 0 }
  else {
    if type_is_numeric(lhs_ty) and type_is_numeric(rhs_ty) {
      typeck_error_maybe(src, pos, mismatch_msg)
      1
    } else {
      let mut errors = 0
      if not type_is_numeric(lhs_ty) {
        typeck_error_maybe(src, pos, legacy_msg)
        errors = errors + 1
      } else { errors = errors }
      if not type_is_numeric(rhs_ty) {
        typeck_error_maybe(src, pos, legacy_msg)
        errors = errors + 1
      } else { errors = errors }
      errors
    }
  }
}

pub(package) fn check_arith_operand_node(op: i64, lhs: i64, rhs: i64, lhs_ty: i64, rhs_ty: i64, src: i64, pos: i64) -[Diagnose]> i64 {
  if op == 2 and expr_is_zero_i64_lit(lhs) and node_tag(rhs) == 1 { 0 }
  else { if op == 2 and expr_is_zero_i64_lit(lhs) and type_is_f64_exact(rhs_ty) { 0 }
  else { if op == 2 and expr_is_zero_i64_lit(lhs) and type_is_f32_exact(rhs_ty) { 0 }
  else {
    check_numeric_pair_or_legacy(lhs, rhs, lhs_ty, rhs_ty, src, pos, "type error: arithmetic operand is not i64", "type error: arithmetic operand type mismatch")
  } } }
}

pub(package) fn typeck_ord_trait_hash() -> i64 {
  effect_name_hash(__str_ptr("Ord"), 0, 3)
}

pub(package) fn typeck_ord_compare_hash() -> i64 {
  effect_name_hash(__str_ptr("compare"), 0, 7)
}

pub(package) fn typeck_ordering_type_declaration(tt: i64) -> i64 {
  let decls = module_fact_decls(tt)
  let mut result = 0
  let mut i = 0
  while i < nlist_len(decls) and result == 0 {
    let decl = nlist_get(decls, i)
    if module_decl_fact_namespace(decl) == module_decl_namespace_type() and
      typeck_decl_identity_is(decl, "stdlib/ord", "Ordering") == 1 {
      result = decl
    } else { i = i + 1 }
  }
  result
}

pub(package) fn typeck_ordering_constructor_declaration(tt: i64, name: str) -> i64 {
  let ordering = typeck_ordering_type_declaration(tt)
  let wanted = str_hash(__str_ptr(name), 0, __str_len(name))
  let decls = module_fact_decls(tt)
  let mut result = 0
  let mut i = 0
  while i < nlist_len(decls) and result == 0 {
    let decl = nlist_get(decls, i)
    if module_decl_fact_namespace(decl) == module_decl_namespace_constructor() and
      module_decl_fact_owner(decl) == ordering and
      str_hash(module_decl_fact_name_ptr(decl), 0, module_decl_fact_name_len(decl)) == wanted {
      result = decl
    } else { i = i + 1 }
  }
  result
}

pub(package) fn typeck_ord_trait_signature_is_canonical(tt: i64) -> i64 {
  let trait_hash = typeck_ord_trait_hash()
  let method_hash = typeck_ord_compare_hash()
  let params = ttable_lookup_method_params(tt, trait_hash, method_hash)
  let ret = ttable_lookup_method_ret(tt, trait_hash, method_hash)
  let effects = ttable_lookup_method_effects(tt, trait_hash, method_hash)
  if params == 0 or nlist_len(params) != 2 { 0 }
  else {
    let self_ty = node_f3(nlist_get(params, 0))
    let other_ty = node_f3(nlist_get(params, 1))
    let ordering_decl = typeck_ordering_type_declaration(tt)
    let ordering_ty = if ordering_decl == 0 { 0 } else { typeck_named_type_from_declaration(tt, ordering_decl, 0) }
    if not ty_is_self(self_ty) or not ty_is_self(other_ty) or not effect_sig_is_empty(effects) { 0 }
    else { if ordering_ty != 0 and ty_eq(ret, ordering_ty) { 1 } else { 0 } }
  }
}

pub(package) fn typeck_ord_typevar_has_bound(tt: i64, ty: i64) -> bool {
  if ty_tag(ty) != 12 or ty_is_self(ty) { false }
  else { impl_tparam_has_bound(ttable_get_tparams(tt), ty_var_id(ty), ty_trait(typeck_ord_trait_hash())) }
}

pub(package) fn typeck_rewrite_order_compare(node: i64, lhs: i64, rhs: i64, lhs_ty: i64, method_ref: i64, tt: i64) -> i64 {
  let op = node_f1(node)
  let constructor_name = if op == 7 or op == 10 { "Less" } else { "Greater" }
  let constructor = typeck_ordering_constructor_declaration(tt, constructor_name)
  if constructor == 0 { 1 }
  else {
    let args = nlist_new()
    nlist_add(args, rhs)
    let compare_call = node_new(41, lhs, typeck_ord_compare_hash(), args, method_ref)
    let matched_value = if op == 7 or op == 8 { 1 } else { 0 }
    let fallback_value = if matched_value == 1 { 0 } else { 1 }
    let arms = MatchArmListCons(
      Arm(CtorPattern(0, module_decl_fact_name_len(constructor), PatternListNil, constructor), BoolLit(matched_value), NilExpr, 0),
      MatchArmListCons(Arm(Wildcard, BoolLit(fallback_value), NilExpr, 0), MatchArmListNil)
    )
    let arm_nodes = match_arm_list_to_nodes(arms)
    mem_store64_at(node, 0, 15)
    mem_store64_at(node, 8, compare_call)
    mem_store64_at(node, 16, arm_nodes)
    mem_store64_at(node, 24, 2)
    mem_store64_at(node, 32, 0)
    0
  }
}

-- Non-numeric ordering is canonical Ord dispatch. Rewrite the relational
-- operator to an exhaustive match over `a.compare(b)` after proving exact
-- operand agreement and conformance. The ordinary typed method-call path then
-- owns specialisation, evaluation order, ownership, and native dispatch.
-- Numeric operands retain their direct primitive lowering.
pub(package) fn check_order_operand(node: i64, lhs: i64, rhs: i64, lhs_ty: i64, rhs_ty: i64, src: i64, pos: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  if numeric_pair_matches(lhs, rhs, lhs_ty, rhs_ty, src) == 1 { 0 }
  else { if type_is_numeric(lhs_ty) or type_is_numeric(rhs_ty) {
    typeck_error_maybe(src, pos, "type error: comparison operand type mismatch")
    1
  } else { if not ty_eq(lhs_ty, rhs_ty) {
    typeck_error_maybe(src, pos, "type error: ordering operand type mismatch")
    1
  } else {
    let delayed_typevar = typeck_ord_typevar_has_bound(tt, lhs_ty)
    let conforms = if delayed_typevar { 1 } else { Conformance.conforms(lhs_ty, ty_trait(typeck_ord_trait_hash())) }
    if conforms == 0 {
    typeck_report_trait_conformance(lhs_ty, ty_trait(typeck_ord_trait_hash()), tt, src, expr_diag_pos(lhs), expr_diag_len(lhs), DiagnosticLocationNone, "ordering operand", ttable_get_tparams(tt))
    1
  } else { if typeck_ord_trait_signature_is_canonical(tt) == 0 {
    typeck_error_maybe(src, pos, "type error: Ord must define pure compare(self, Self) -> Ordering")
    1
  } else { if delayed_typevar {
    -- Owner hash zero is an explicit delayed-dispatch marker. Generic
    -- specialisation substitutes the receiver and resolves the concrete impl
    -- before lowering, including generic impl targets.
    typeck_rewrite_order_compare(node, lhs, rhs, lhs_ty, method_ref_new(0, lhs_ty, 0, 0), tt)
  } else {
    let owner_hash = type_hash_of(lhs_ty)
    let method_hash = typeck_ord_compare_hash()
    let resolution = ttable_resolve_method(tt, lhs_ty, owner_hash, method_hash)
    if resolution == 0 {
      typeck_error_maybe(src, pos, "type error: Ord implementation must provide the canonical compare(self, Self) method")
      1
    } else {
      let method_ref = method_ref_new(
        owner_hash,
        lhs_ty,
        method_resolution_ref_type_args(resolution, lhs_ty),
        if method_resolution_tparams(resolution) != 0 { 1 } else { 0 }
      )
      typeck_rewrite_order_compare(node, lhs, rhs, lhs_ty, method_ref, tt)
    }
  } } } } } }
}

pub(package) fn check_integer_operand_node(lhs: i64, rhs: i64, lhs_ty: i64, rhs_ty: i64, src: i64, pos: i64, legacy_msg: str, mismatch_msg: str) -[Diagnose]> i64 {
  if type_is_unknown_or_any(lhs_ty) or type_is_unknown_or_any(rhs_ty) { 0 }
  else {
    let prim = int_binop_candidate_prim(lhs_ty, rhs_ty)
    let both_int = expr_matches_int_prim_contextual(lhs, lhs_ty, prim, src) == 1 and expr_matches_int_prim_contextual(rhs, rhs_ty, prim, src) == 1
    if both_int { 0 }
    else { if type_is_integer_exact(lhs_ty) == 1 {
      if type_is_integer_exact(rhs_ty) == 1 {
        typeck_error_maybe(src, pos, mismatch_msg)
        1
      } else {
        typeck_error_maybe(src, pos, legacy_msg)
        1
      }
    } else {
      typeck_error_maybe(src, pos, legacy_msg)
      1
    } }
  }
}

pub(package) fn expr_diag_pos(node: i64) -> i64 {
  let tag = node_tag(node)
  if tag == 1 { if node_f3(node) > 0 { node_f2(node) } else { 0 } }
  else { if tag == 2 { node_f1(node) }
  else { if tag == 4 { node_f1(node) }
  else { if tag == 9 { if node_f4(node) > 0 { node_f3(node) } else { 0 } }
  else { if tag == 54 { node_f1(node) }
  else { if tag == 24 { if node_f3(node) > 0 { node_f2(node) } else { 0 } }
  else { if tag == 13 { node_f2(node) }
  else { if tag == 59 { node_f3(node) }
  else { if tag == 60 { expr_diag_pos(node_f2(node)) }
  else { if tag == 61 { expr_diag_pos(node_f2(node)) }
  else { if tag == 62 { expr_diag_pos(node_f1(node)) }
  else { if tag == 14 { node_f1(node) }
  -- Binary op: locate at the left operand so and/or/comparison chains
  -- report a real position instead of silently dropping the span.
  else { if tag == 3 { expr_diag_pos(node_f2(node)) }
  -- Not: locate at the operand.
  else { if tag == 22 { expr_diag_pos(node_f1(node)) }
  -- GenericCall: locate at the inner call.
  else { if tag == 36 { expr_diag_pos(node_f2(node)) }
  else { if tag == 58 { node_f4(node) }
  else { 0 } } } } } } } } } } } } } } } }
}

pub(package) fn expr_diag_len(node: i64) -> i64 {
  let tag = node_tag(node)
  if tag == 1 { if node_f3(node) > 0 { node_f3(node) } else { 1 } }
  else { if tag == 2 or tag == 4 { node_f2(node) }
  else { if tag == 9 { if node_f4(node) > 0 { node_f4(node) } else { 1 } }
  else { if tag == 24 { if node_f3(node) > 0 { node_f3(node) } else { 1 } }
  else { if tag == 54 { node_f2(node) }
  else { if tag == 13 { node_f3(node) }
  else { if tag == 36 { expr_diag_len(node_f2(node)) }
  else { 1 } } } } } } }
}

pub(package) fn expr_int_literal_fits_default_i64(node: i64, src: i64) -> i64 {
  if expr_is_contextual_int_lit_shape(node) == 1 {
    expr_is_contextual_int_lit_for_prim(node, PRIM_I64(), src)
  } else { 1 }
}

pub(package) fn check_default_i64_literal_expr(node: i64, src: i64) -[Diagnose]> i64 {
  if expr_int_literal_fits_default_i64(node, src) == 1 { 0 }
  else {
    typeck_error_maybe(src, expr_diag_pos(node), "type error: integer literal out of range")
    1
  }
}

pub(package) fn check_bool_required(ty: i64, src: i64, pos: i64) -[Conformance, Diagnose]> i64 {
  if type_is_unknown_or_any(ty) { 0 }
  else { if is_subtype(ty, ty_bool()) { 0 }
  else {
    typeck_error_maybe(src, pos, "type error: boolean expression is not bool")
    1
  } }
}

pub(package) fn check_bool_expr(node: i64, env: i64, ft: i64, src: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  check_bool_required(synth(node, env, ft, src, tt), src, expr_diag_pos(node))
}

pub(package) fn check_logical_operand(lhs_ty: i64, rhs_ty: i64, src: i64, pos: i64) -[Conformance, Diagnose]> i64 {
  check_bool_required(lhs_ty, src, pos) + check_bool_required(rhs_ty, src, pos)
}

pub(package) fn check_assign_target(node: i64, env: i64, ft: i64, src: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let ns = node_f1(node)
  let nl = node_f2(node)
  let val = node_f3(node)
  let target_entry = tenv_find_entry(env, src, ns, nl)
  let target_ty = if target_entry == 0 { 0 } else { tenv_entry_type(target_entry) }
  if target_ty == 0 {
    if module_scope_problem_is_diagnosed(tt, src, src, ns, nl) == 0 {
      typeck_report_unknown_name(src, ns, nl, env, ft, tt, 0)
      1
    } else { 0 }
  } else {
    let mut errors = 0
    if tenv_lookup_mutable(env, src, ns, nl) == 0 {
      typeck_error_maybe(src, ns, "type error: cannot assign to immutable binding")
      errors = errors + 1
    } else { errors = errors }
    prepare_expr_contextual(val, target_ty, env, ft, src, tt)
    let val_ty = synth(val, env, ft, src, tt)
    if type_is_unknown_or_any(target_ty) { errors }
    else { if type_is_unknown_or_any(val_ty) and ty_contains_opaque(target_ty) == 0 { errors }
    else { if expr_matches_type_contextual(val, val_ty, target_ty, src, ft) == 1 { errors }
    else { if infer_generic_ctor_result(val, target_ty, env, ft, src, tt) == 1 and expr_matches_type_contextual(val, synth(val, env, ft, src, tt), target_ty, src, ft) == 1 { errors }
    else {
      typeck_report_expr_type_mismatch(
        src,
        val,
        target_ty,
        val_ty,
        "assignment",
        typeck_source_location(tenv_entry_source(target_entry), tenv_entry_name_start(target_entry), tenv_entry_name_len(target_entry)),
        tt
      )
      errors + 1
    } } } }
  }
}

pub(package) fn check_return_value_type_at(val: i64, env: i64, ft: i64, src: i64, ret_ty: i64, tt: i64, expected_origin: DiagnosticLocation) -[Conformance, Diagnose]> i64 {
  if val != 0 { prepare_expr_contextual(val, ret_ty, env, ft, src, tt) } else { 0 }
  let val_ty = if val == 0 { ty_nil() } else { synth(val, env, ft, src, tt) }
  if type_is_unknown_or_any(val_ty) and ty_contains_opaque(ret_ty) == 0 { 0 }
  else { if type_is_unknown_or_any(ret_ty) { 0 }
  else { if expr_matches_type_contextual(val, val_ty, ret_ty, src, ft) == 1 { 0 }
  else { if infer_generic_ctor_result(val, ret_ty, env, ft, src, tt) == 1 and expr_matches_type_contextual(val, synth(val, env, ft, src, tt), ret_ty, src, ft) == 1 { 0 }
  else {
    typeck_report_expr_type_mismatch(src, val, ret_ty, val_ty, "return value", expected_origin, tt)
    1
  } } } }
}

pub(package) fn check_return_values_list_at(list: i64, n: i64, env: i64, ft: i64, src: i64, ret_ty: i64, tt: i64, expected_origin: DiagnosticLocation) -[Conformance, Diagnose]> i64 {
  let mut errors = 0
  for i in 0..n {
    errors = errors + check_return_values_at(nlist_get(list, i), env, ft, src, ret_ty, tt, expected_origin)
  }
  errors
}

pub(package) fn check_return_values_at(node: i64, env: i64, ft: i64, src: i64, ret_ty: i64, tt: i64, expected_origin: DiagnosticLocation) -[Conformance, Diagnose]> i64 {
  if node == 0 { 0 }
  else {
    let tag = node_tag(node)
    match tag {
      3 -> check_return_values_at(node_f2(node), env, ft, src, ret_ty, tt, expected_origin) + check_return_values_at(node_f3(node), env, ft, src, ret_ty, tt, expected_origin)
      4 -> check_return_values_list_at(node_f3(node), node_f4(node), env, ft, src, ret_ty, tt, expected_origin)
      5 -> check_return_values_at(node_f1(node), env, ft, src, ret_ty, tt, expected_origin) + check_return_values_at(node_f2(node), env, ft, src, ret_ty, tt, expected_origin) + check_return_values_at(node_f3(node), env, ft, src, ret_ty, tt, expected_origin)
      6 -> {
        let val = node_f3(node)
        let val_ty = synth(val, env, ft, src, tt)
        let new_env = tenv_bind(env, src, node_f1(node), node_f2(node), val_ty)
        check_return_values_at(val, env, ft, src, ret_ty, tt, expected_origin) + check_return_values_at(node_f4(node), new_env, ft, src, ret_ty, tt, expected_origin)
      }
      7 -> check_return_values_at(node_f1(node), env, ft, src, ret_ty, tt, expected_origin) + check_return_values_at(node_f2(node), env, ft, src, ret_ty, tt, expected_origin)
      10 -> check_return_values_at(node_f1(node), env, ft, src, ret_ty, tt, expected_origin) + check_return_values_at(node_f2(node), env, ft, src, ret_ty, tt, expected_origin)
      11 -> {
        let val = node_f3(node)
        let val_ty = synth(val, env, ft, src, tt)
        let new_env = tenv_bind_mut(env, src, node_f1(node), node_f2(node), val_ty)
        check_return_values_at(val, env, ft, src, ret_ty, tt, expected_origin) + check_return_values_at(node_f4(node), new_env, ft, src, ret_ty, tt, expected_origin)
      }
      12 -> check_return_values_at(node_f3(node), env, ft, src, ret_ty, tt, expected_origin)
      57 -> check_return_values_at(node_f1(node), env, ft, src, ret_ty, tt, expected_origin) + check_return_values_at(node_f2(node), env, ft, src, ret_ty, tt, expected_origin)
      13 -> check_return_values_at(node_f1(node), env, ft, src, ret_ty, tt, expected_origin)
      59 -> check_return_values_at(node_f1(node), env, ft, src, ret_ty, tt, expected_origin)
      60 -> check_return_values_at(node_f1(node), env, ft, src, ret_ty, tt, expected_origin) + check_return_values_at(node_f2(node), env, ft, src, ret_ty, tt, expected_origin)
      61 -> check_return_values_at(node_f1(node), env, ft, src, ret_ty, tt, expected_origin) + check_return_values_at(node_f2(node), env, ft, src, ret_ty, tt, expected_origin) + check_return_values_at(node_f3(node), env, ft, src, ret_ty, tt, expected_origin)
      62 -> check_return_values_at(node_f1(node), env, ft, src, ret_ty, tt, expected_origin) + check_return_values_at(node_f2(node), env, ft, src, ret_ty, tt, expected_origin) + check_return_values_at(node_f3(node), env, ft, src, ret_ty, tt, expected_origin)
      14 -> {
        let fields = node_f3(node)
        let nfields = node_f4(node)
        let mut errors = 0
        for i in 0..nfields {
          errors = errors + check_return_values_at(node_f3(nlist_get(fields, i)), env, ft, src, ret_ty, tt, expected_origin)
        }
        errors
      }
      63 -> check_return_values_at(node_f1(node), env, ft, src, ret_ty, tt, expected_origin) + check_return_values_list_at(record_field_expr_nodes(node_f2(node), node_f3(node)), node_f3(node), env, ft, src, ret_ty, tt, expected_origin)
      58 -> check_return_values_list_at(node_f1(node), node_f2(node), env, ft, src, ret_ty, tt, expected_origin)
      15 -> {
        let scrutinee = node_f1(node)
        let arms = node_f2(node)
        let n = node_f3(node)
        let scr_ty = synth(scrutinee, env, ft, src, tt)
        let mut errors = check_return_values_at(scrutinee, env, ft, src, ret_ty, tt, expected_origin)
        for i in 0..n {
          let arm = nlist_get(arms, i)
          let arm_env = bind_match_pattern(node_f1(arm), env, src, scr_ty, tt)
          let guard = node_f3(arm)
          if guard != 0 { errors = errors + check_return_values_at(guard, arm_env, ft, src, ret_ty, tt, expected_origin) } else { errors = errors }
          errors = errors + check_return_values_at(node_f2(arm), arm_env, ft, src, ret_ty, tt, expected_origin)
        }
        errors
      }
      22 -> check_return_values_at(node_f1(node), env, ft, src, ret_ty, tt, expected_origin)
      25 -> check_return_value_type_at(node_f1(node), env, ft, src, ret_ty, tt, expected_origin)
      26 -> check_return_values_at(node_f1(node), env, ft, src, ret_ty, tt, expected_origin)
      29 -> 0
      32 -> check_return_values_at(node_f1(node), env, ft, src, ret_ty, tt, expected_origin) + check_return_values_list_at(node_f4(node), nlist_len(node_f4(node)), env, ft, src, ret_ty, tt, expected_origin)
      33 -> check_return_values_at(node_f1(node), env, ft, src, ret_ty, tt, expected_origin)
      35 -> check_return_values_at(node_f1(node), env, ft, src, ret_ty, tt, expected_origin)
      36 -> {
        let call_node = node_f2(node)
        check_return_values_list_at(generic_call_inner_args(call_node), generic_call_inner_arg_count(call_node), env, ft, src, ret_ty, tt, expected_origin)
      }
      37 -> check_return_values_at(node_f1(node), env, ft, src, ret_ty, tt, expected_origin)
      41 -> check_return_values_at(node_f1(node), env, ft, src, ret_ty, tt, expected_origin) + check_return_values_list_at(node_f3(node), nlist_len(node_f3(node)), env, ft, src, ret_ty, tt, expected_origin)
      45 -> check_return_values_at(node_f1(node), env, ft, src, ret_ty, tt, expected_origin)
      46 -> check_return_values_at(node_f1(node), env, ft, src, ret_ty, tt, expected_origin) + check_return_values_at(node_f2(node), env, ft, src, ret_ty, tt, expected_origin)
      47 -> {
        let loop_env = tenv_bind(env, src, node_f1(node), node_f2(node), for_iter_item_type(node, env, ft, src, tt))
        check_return_values_at(node_f3(node), env, ft, src, ret_ty, tt, expected_origin) + check_return_values_at(node_f4(node), loop_env, ft, src, ret_ty, tt, expected_origin)
      }
      48 -> check_return_values_at(node_f1(node), env, ft, src, ret_ty, tt, expected_origin)
      49 -> check_return_values_at(node_f1(node), env, ft, src, ret_ty, tt, expected_origin)
      52 -> check_return_values_at(node_f1(node), env, ft, src, ret_ty, tt, expected_origin) + check_return_values_at(node_f2(node), env, ft, src, ret_ty, tt, expected_origin)
      _ -> 0
    }
  }
}

pub(package) fn check_return_values(node: i64, env: i64, ft: i64, src: i64, ret_ty: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  check_return_values_at(node, env, ft, src, ret_ty, tt, DiagnosticLocationNone)
}

pub(package) fn unique_name_matches(use_src: i64, use_ns: i64, use_nl: i64, bind_src: i64, bind_ns: i64, bind_nl: i64) -> i64 {
  if use_nl != bind_nl { 0 }
  else { src_eq_at(use_src, use_ns, bind_src + bind_ns, 0, bind_nl) }
}

pub(package) fn unique_ref_count_list(list: i64, n: i64, src: i64, bind_src: i64, bind_ns: i64, bind_nl: i64) -> i64 {
  let mut count = 0
  for i in 0..n {
    count = count + unique_ref_count_name(nlist_get(list, i), src, bind_src, bind_ns, bind_nl)
  }
  count
}

pub(package) fn unique_params_bind_name(params: i64, nparams: i64, src: i64, bind_src: i64, bind_ns: i64, bind_nl: i64) -> i64 {
  let mut found = 0
  for i in 0..nparams {
    let p = nlist_get(params, i)
    if unique_name_matches(src, node_f1(p), node_f2(p), bind_src, bind_ns, bind_nl) == 1 {
      found = 1
    } else { found = found }
  }
  found
}

pub(package) fn unique_pattern_binds_name(pat: i64, src: i64, bind_src: i64, bind_ns: i64, bind_nl: i64) -> i64 {
  if pat == 0 { 0 }
  else {
    let tag = node_tag(pat)
    match tag {
      18 -> unique_name_matches(src, node_f1(pat), node_f2(pat), bind_src, bind_ns, bind_nl)
      60 -> unique_name_matches(src, node_f1(pat), node_f2(pat), bind_src, bind_ns, bind_nl)
      20 -> {
        let b_ns = node_f3(pat)
        let b_nl = node_f4(pat)
        if b_nl > 0 {
          unique_name_matches(src, b_ns, b_nl, bind_src, bind_ns, bind_nl)
        } else { if b_nl < 0 {
          let bindings = b_ns
          let nb = 0 - b_nl
          let mut found = 0
          for i in 0..nb {
            let b = nlist_get(bindings, i)
            if unique_pattern_binds_name(b, src, bind_src, bind_ns, bind_nl) == 1 { found = 1 } else { found = found }
          }
          found
        } else { 0 } }
      }
      67 -> unique_pattern_binds_name(ctor_pattern_raw(pat), src, bind_src, bind_ns, bind_nl)
      64 -> {
        let fields = node_f1(pat)
        let mut found = 0
        for i in 0..node_f2(pat) {
          if unique_pattern_binds_name(node_f3(nlist_get(fields, i)), src, bind_src, bind_ns, bind_nl) == 1 { found = 1 } else { found = found }
        }
        found
      }
      65 -> {
        let items = node_f1(pat)
        let mut found = 0
        for i in 0..node_f2(pat) {
          if unique_pattern_binds_name(nlist_get(items, i), src, bind_src, bind_ns, bind_nl) == 1 { found = 1 } else { found = found }
        }
        found
      }
      _ -> 0
    }
  }
}

pub(package) fn unique_ref_count_name(node: i64, src: i64, bind_src: i64, bind_ns: i64, bind_nl: i64) -> i64 {
  if node == 0 { 0 }
  else {
    let tag = node_tag(node)
    match tag {
      2 -> if typeck_borrow_use_fact(node) != 0 { 0 } else { unique_name_matches(src, node_f1(node), node_f2(node), bind_src, bind_ns, bind_nl) }
      3 -> unique_ref_count_name(node_f2(node), src, bind_src, bind_ns, bind_nl) + unique_ref_count_name(node_f3(node), src, bind_src, bind_ns, bind_nl)
      4 -> unique_ref_count_list(node_f3(node), node_f4(node), src, bind_src, bind_ns, bind_nl)
      5 -> {
        let condition = unique_ref_count_name(node_f1(node), src, bind_src, bind_ns, bind_nl)
        let when_true = unique_ref_count_name(node_f2(node), src, bind_src, bind_ns, bind_nl)
        let when_false = unique_ref_count_name(node_f3(node), src, bind_src, bind_ns, bind_nl)
        condition + if when_true > when_false { when_true } else { when_false }
      }
      6 -> {
        let val = node_f3(node)
        let body = node_f4(node)
        let val_count = unique_ref_count_name(val, src, bind_src, bind_ns, bind_nl)
        if unique_name_matches(src, node_f1(node), node_f2(node), bind_src, bind_ns, bind_nl) == 1 {
          val_count
        } else { val_count + unique_ref_count_name(body, src, bind_src, bind_ns, bind_nl) }
      }
      7 -> unique_ref_count_name(node_f1(node), src, bind_src, bind_ns, bind_nl) + unique_ref_count_name(node_f2(node), src, bind_src, bind_ns, bind_nl)
      10 -> unique_ref_count_name(node_f1(node), src, bind_src, bind_ns, bind_nl) + unique_ref_count_name(node_f2(node), src, bind_src, bind_ns, bind_nl)
      11 -> {
        let val = node_f3(node)
        let body = node_f4(node)
        let val_count = unique_ref_count_name(val, src, bind_src, bind_ns, bind_nl)
        if unique_name_matches(src, node_f1(node), node_f2(node), bind_src, bind_ns, bind_nl) == 1 {
          val_count
        } else { val_count + unique_ref_count_name(body, src, bind_src, bind_ns, bind_nl) }
      }
      12 -> unique_ref_count_name(node_f3(node), src, bind_src, bind_ns, bind_nl)
      57 -> unique_ref_count_name(node_f1(node), src, bind_src, bind_ns, bind_nl) + unique_ref_count_name(node_f2(node), src, bind_src, bind_ns, bind_nl)
      13 -> unique_ref_count_name(node_f1(node), src, bind_src, bind_ns, bind_nl)
      59 -> unique_ref_count_name(node_f1(node), src, bind_src, bind_ns, bind_nl)
      60 -> unique_ref_count_name(node_f1(node), src, bind_src, bind_ns, bind_nl) + unique_ref_count_name(node_f2(node), src, bind_src, bind_ns, bind_nl)
      61 -> unique_ref_count_name(node_f1(node), src, bind_src, bind_ns, bind_nl) + unique_ref_count_name(node_f2(node), src, bind_src, bind_ns, bind_nl) + unique_ref_count_name(node_f3(node), src, bind_src, bind_ns, bind_nl)
      62 -> unique_ref_count_name(node_f1(node), src, bind_src, bind_ns, bind_nl) + unique_ref_count_name(node_f2(node), src, bind_src, bind_ns, bind_nl) + unique_ref_count_name(node_f3(node), src, bind_src, bind_ns, bind_nl)
      14 -> {
        let fields = node_f3(node)
        let nfields = node_f4(node)
        let mut count = 0
        for i in 0..nfields {
          count = count + unique_ref_count_name(node_f3(nlist_get(fields, i)), src, bind_src, bind_ns, bind_nl)
        }
        count
      }
      63 -> unique_ref_count_name(node_f1(node), src, bind_src, bind_ns, bind_nl) + unique_ref_count_list(record_field_expr_nodes(node_f2(node), node_f3(node)), node_f3(node), src, bind_src, bind_ns, bind_nl)
      58 -> unique_ref_count_list(node_f1(node), node_f2(node), src, bind_src, bind_ns, bind_nl)
      15 -> {
        let arms = node_f2(node)
        let n = node_f3(node)
        let scrutinee_count = unique_ref_count_name(node_f1(node), src, bind_src, bind_ns, bind_nl)
        let mut guard_count = 0
        let mut body_count = 0
        for i in 0..n {
          let arm = nlist_get(arms, i)
          if unique_pattern_binds_name(node_f1(arm), src, bind_src, bind_ns, bind_nl) == 0 {
            let guard = node_f3(arm)
            if guard != 0 {
              -- A false guard can fall through to a later row, so consuming
              -- uses in guards compose sequentially rather than as arms.
              guard_count = guard_count + unique_ref_count_name(guard, src, bind_src, bind_ns, bind_nl)
            } else { 0 }
            let arm_body = unique_ref_count_name(node_f2(arm), src, bind_src, bind_ns, bind_nl)
            if arm_body > body_count { body_count = arm_body } else { 0 }
          } else { 0 }
        }
        scrutinee_count + guard_count + body_count
      }
      22 -> unique_ref_count_name(node_f1(node), src, bind_src, bind_ns, bind_nl)
      25 -> unique_ref_count_name(node_f1(node), src, bind_src, bind_ns, bind_nl)
      26 -> unique_ref_count_name(node_f1(node), src, bind_src, bind_ns, bind_nl)
      29 -> {
        if unique_params_bind_name(node_f1(node), node_f3(node), src, bind_src, bind_ns, bind_nl) == 1 { 0 }
        else { unique_ref_count_name(node_f2(node), src, bind_src, bind_ns, bind_nl) }
      }
      32 -> unique_ref_count_name(node_f1(node), src, bind_src, bind_ns, bind_nl) + unique_ref_count_list(node_f4(node), nlist_len(node_f4(node)), src, bind_src, bind_ns, bind_nl)
      33 -> {
        let clauses = node_f2(node)
        let nclauses = node_f3(node)
        let mut count = unique_ref_count_name(node_f1(node), src, bind_src, bind_ns, bind_nl)
        for ci in 0..nclauses {
          let clause = nlist_get(clauses, ci)
          if unique_params_bind_name(node_f2(clause), nlist_len(node_f2(clause)), src, bind_src, bind_ns, bind_nl) == 0 {
            count = count + unique_ref_count_name(node_f3(clause), src, bind_src, bind_ns, bind_nl)
          } else { count = count }
        }
        count
      }
      35 -> unique_ref_count_name(node_f1(node), src, bind_src, bind_ns, bind_nl)
      36 -> {
        let call_node = node_f2(node)
        unique_ref_count_list(generic_call_inner_args(call_node), generic_call_inner_arg_count(call_node), src, bind_src, bind_ns, bind_nl)
      }
      37 -> unique_ref_count_name(node_f1(node), src, bind_src, bind_ns, bind_nl)
      41 -> unique_ref_count_name(node_f1(node), src, bind_src, bind_ns, bind_nl) + unique_ref_count_list(node_f3(node), nlist_len(node_f3(node)), src, bind_src, bind_ns, bind_nl)
      45 -> unique_ref_count_name(node_f1(node), src, bind_src, bind_ns, bind_nl)
      46 -> unique_ref_count_name(node_f1(node), src, bind_src, bind_ns, bind_nl) + unique_ref_count_name(node_f2(node), src, bind_src, bind_ns, bind_nl)
      47 -> {
        let collection_count = unique_ref_count_name(node_f3(node), src, bind_src, bind_ns, bind_nl)
        if unique_name_matches(src, node_f1(node), node_f2(node), bind_src, bind_ns, bind_nl) == 1 {
          collection_count
        } else { collection_count + unique_ref_count_name(node_f4(node), src, bind_src, bind_ns, bind_nl) }
      }
      48 -> unique_ref_count_name(node_f1(node), src, bind_src, bind_ns, bind_nl)
      49 -> unique_ref_count_name(node_f1(node), src, bind_src, bind_ns, bind_nl)
      52 -> unique_ref_count_name(node_f1(node), src, bind_src, bind_ns, bind_nl) + unique_ref_count_name(node_f2(node), src, bind_src, bind_ns, bind_nl)
      55 -> unique_ref_count_name(node_f1(node), src, bind_src, bind_ns, bind_nl)
      56 -> unique_ref_count_name(node_f1(node), src, bind_src, bind_ns, bind_nl)
      _ -> 0
    }
  }
}

-- Borrow uses do not consume a linear binding, so the cardinality check above
-- intentionally excludes them. Cardinality alone cannot, however, distinguish
-- a valid borrow-before-move from a borrow after the one permitted consuming
-- use. This compact summary records whether an expression may consume (bit 0),
-- may borrow (bit 1), or contains a consuming-use-before-borrow path (bit 2).
-- Sequence and alternatives compose differently so mutually exclusive match
-- and if arms never manufacture a false use-after-move path.
pub(package) fn unique_linear_use_summary_pack(consumes: i64, borrows: i64, invalid: i64) -> i64 {
  consumes + borrows * 2 + invalid * 4
}

pub(package) fn unique_linear_use_summary_consumes(summary: i64) -> i64 {
  summary % 2
}

pub(package) fn unique_linear_use_summary_borrows(summary: i64) -> i64 {
  (summary / 2) % 2
}

pub(package) fn unique_linear_use_summary_invalid(summary: i64) -> i64 {
  if summary >= 4 { 1 } else { 0 }
}

pub(package) fn unique_linear_use_summary_sequence(left: i64, right: i64) -> i64 {
  let consumes = if unique_linear_use_summary_consumes(left) == 1 or unique_linear_use_summary_consumes(right) == 1 { 1 } else { 0 }
  let borrows = if unique_linear_use_summary_borrows(left) == 1 or unique_linear_use_summary_borrows(right) == 1 { 1 } else { 0 }
  let cross = unique_linear_use_summary_consumes(left) * unique_linear_use_summary_borrows(right)
  let invalid = if unique_linear_use_summary_invalid(left) == 1 or unique_linear_use_summary_invalid(right) == 1 or cross == 1 { 1 } else { 0 }
  unique_linear_use_summary_pack(consumes, borrows, invalid)
}

pub(package) fn unique_linear_use_summary_alternative(left: i64, right: i64) -> i64 {
  let consumes = if unique_linear_use_summary_consumes(left) == 1 or unique_linear_use_summary_consumes(right) == 1 { 1 } else { 0 }
  let borrows = if unique_linear_use_summary_borrows(left) == 1 or unique_linear_use_summary_borrows(right) == 1 { 1 } else { 0 }
  let invalid = if unique_linear_use_summary_invalid(left) == 1 or unique_linear_use_summary_invalid(right) == 1 { 1 } else { 0 }
  unique_linear_use_summary_pack(consumes, borrows, invalid)
}

pub(package) fn unique_linear_use_summary_loop(body: i64) -> i64 {
  -- A borrow and consume in a repeated body cross in one direction on either
  -- the first or a later iteration, irrespective of their textual order.
  let cross_iteration = unique_linear_use_summary_consumes(body) * unique_linear_use_summary_borrows(body)
  unique_linear_use_summary_pack(
    unique_linear_use_summary_consumes(body),
    unique_linear_use_summary_borrows(body),
    if unique_linear_use_summary_invalid(body) == 1 or cross_iteration == 1 { 1 } else { 0 }
  )
}

pub(package) fn unique_linear_use_summary_list(list: i64, n: i64, src: i64, bind_src: i64, bind_ns: i64, bind_nl: i64) -> i64 {
  let mut summary = 0
  for i in 0..n {
    summary = unique_linear_use_summary_sequence(summary, unique_linear_use_summary_name(nlist_get(list, i), src, bind_src, bind_ns, bind_nl))
  }
  summary
}

pub(package) fn unique_linear_use_summary_name(node: i64, src: i64, bind_src: i64, bind_ns: i64, bind_nl: i64) -> i64 {
  if node == 0 { 0 }
  else {
    let tag = node_tag(node)
    match tag {
      2 -> {
        if unique_name_matches(src, node_f1(node), node_f2(node), bind_src, bind_ns, bind_nl) == 0 { 0 }
        else { if typeck_borrow_use_fact(node) != 0 { 2 } else { 1 } }
      }
      3 -> unique_linear_use_summary_sequence(
        unique_linear_use_summary_name(node_f2(node), src, bind_src, bind_ns, bind_nl),
        unique_linear_use_summary_name(node_f3(node), src, bind_src, bind_ns, bind_nl)
      )
      4 -> unique_linear_use_summary_list(node_f3(node), node_f4(node), src, bind_src, bind_ns, bind_nl)
      5 -> {
        let cond = unique_linear_use_summary_name(node_f1(node), src, bind_src, bind_ns, bind_nl)
        let branches = unique_linear_use_summary_alternative(
          unique_linear_use_summary_name(node_f2(node), src, bind_src, bind_ns, bind_nl),
          unique_linear_use_summary_name(node_f3(node), src, bind_src, bind_ns, bind_nl)
        )
        unique_linear_use_summary_sequence(cond, branches)
      }
      6 -> {
        let value = unique_linear_use_summary_name(node_f3(node), src, bind_src, bind_ns, bind_nl)
        if unique_name_matches(src, node_f1(node), node_f2(node), bind_src, bind_ns, bind_nl) == 1 { value }
        else { unique_linear_use_summary_sequence(value, unique_linear_use_summary_name(node_f4(node), src, bind_src, bind_ns, bind_nl)) }
      }
      7 -> unique_linear_use_summary_sequence(
        unique_linear_use_summary_name(node_f1(node), src, bind_src, bind_ns, bind_nl),
        unique_linear_use_summary_name(node_f2(node), src, bind_src, bind_ns, bind_nl)
      )
      10 -> {
        let loop_summary = unique_linear_use_summary_sequence(
          unique_linear_use_summary_name(node_f1(node), src, bind_src, bind_ns, bind_nl),
          unique_linear_use_summary_name(node_f2(node), src, bind_src, bind_ns, bind_nl)
        )
        unique_linear_use_summary_loop(loop_summary)
      }
      11 -> {
        let value = unique_linear_use_summary_name(node_f3(node), src, bind_src, bind_ns, bind_nl)
        if unique_name_matches(src, node_f1(node), node_f2(node), bind_src, bind_ns, bind_nl) == 1 { value }
        else { unique_linear_use_summary_sequence(value, unique_linear_use_summary_name(node_f4(node), src, bind_src, bind_ns, bind_nl)) }
      }
      12 -> unique_linear_use_summary_name(node_f3(node), src, bind_src, bind_ns, bind_nl)
      57 -> unique_linear_use_summary_sequence(
        unique_linear_use_summary_name(node_f1(node), src, bind_src, bind_ns, bind_nl),
        unique_linear_use_summary_name(node_f2(node), src, bind_src, bind_ns, bind_nl)
      )
      13 -> unique_linear_use_summary_name(node_f1(node), src, bind_src, bind_ns, bind_nl)
      59 -> unique_linear_use_summary_name(node_f1(node), src, bind_src, bind_ns, bind_nl)
      60 -> unique_linear_use_summary_sequence(
        unique_linear_use_summary_name(node_f1(node), src, bind_src, bind_ns, bind_nl),
        unique_linear_use_summary_name(node_f2(node), src, bind_src, bind_ns, bind_nl)
      )
      61 -> unique_linear_use_summary_sequence(
        unique_linear_use_summary_sequence(
          unique_linear_use_summary_name(node_f1(node), src, bind_src, bind_ns, bind_nl),
          unique_linear_use_summary_name(node_f2(node), src, bind_src, bind_ns, bind_nl)
        ),
        unique_linear_use_summary_name(node_f3(node), src, bind_src, bind_ns, bind_nl)
      )
      62 -> unique_linear_use_summary_sequence(
        unique_linear_use_summary_sequence(
          unique_linear_use_summary_name(node_f1(node), src, bind_src, bind_ns, bind_nl),
          unique_linear_use_summary_name(node_f2(node), src, bind_src, bind_ns, bind_nl)
        ),
        unique_linear_use_summary_name(node_f3(node), src, bind_src, bind_ns, bind_nl)
      )
      14 -> {
        let fields = node_f3(node)
        let mut summary = 0
        for i in 0..node_f4(node) {
          summary = unique_linear_use_summary_sequence(summary, unique_linear_use_summary_name(node_f3(nlist_get(fields, i)), src, bind_src, bind_ns, bind_nl))
        }
        summary
      }
      63 -> unique_linear_use_summary_sequence(
        unique_linear_use_summary_name(node_f1(node), src, bind_src, bind_ns, bind_nl),
        unique_linear_use_summary_list(record_field_expr_nodes(node_f2(node), node_f3(node)), node_f3(node), src, bind_src, bind_ns, bind_nl)
      )
      58 -> unique_linear_use_summary_list(node_f1(node), node_f2(node), src, bind_src, bind_ns, bind_nl)
      15 -> {
        let scrutinee = unique_linear_use_summary_name(node_f1(node), src, bind_src, bind_ns, bind_nl)
        let arms = node_f2(node)
        let mut alternatives = 0
        for i in 0..node_f3(node) {
          let arm = nlist_get(arms, i)
          let arm_summary = if unique_pattern_binds_name(node_f1(arm), src, bind_src, bind_ns, bind_nl) == 1 { 0 }
          else {
            unique_linear_use_summary_sequence(
              unique_linear_use_summary_name(node_f3(arm), src, bind_src, bind_ns, bind_nl),
              unique_linear_use_summary_name(node_f2(arm), src, bind_src, bind_ns, bind_nl)
            )
          }
          alternatives = unique_linear_use_summary_alternative(alternatives, arm_summary)
        }
        unique_linear_use_summary_sequence(scrutinee, alternatives)
      }
      22 -> unique_linear_use_summary_name(node_f1(node), src, bind_src, bind_ns, bind_nl)
      25 -> unique_linear_use_summary_name(node_f1(node), src, bind_src, bind_ns, bind_nl)
      26 -> unique_linear_use_summary_name(node_f1(node), src, bind_src, bind_ns, bind_nl)
      29 -> {
        if unique_params_bind_name(node_f1(node), node_f3(node), src, bind_src, bind_ns, bind_nl) == 1 { 0 }
        else { unique_linear_use_summary_name(node_f2(node), src, bind_src, bind_ns, bind_nl) }
      }
      32 -> unique_linear_use_summary_sequence(
        unique_linear_use_summary_name(node_f1(node), src, bind_src, bind_ns, bind_nl),
        unique_linear_use_summary_list(node_f4(node), nlist_len(node_f4(node)), src, bind_src, bind_ns, bind_nl)
      )
      33 -> {
        let body = unique_linear_use_summary_name(node_f1(node), src, bind_src, bind_ns, bind_nl)
        let clauses = node_f2(node)
        let mut alternatives = 0
        for ci in 0..node_f3(node) {
          let clause = nlist_get(clauses, ci)
          let clause_summary = if unique_params_bind_name(node_f2(clause), nlist_len(node_f2(clause)), src, bind_src, bind_ns, bind_nl) == 1 { 0 }
          else { unique_linear_use_summary_name(node_f3(clause), src, bind_src, bind_ns, bind_nl) }
          alternatives = unique_linear_use_summary_alternative(alternatives, clause_summary)
        }
        unique_linear_use_summary_alternative(body, alternatives)
      }
      35 -> unique_linear_use_summary_name(node_f1(node), src, bind_src, bind_ns, bind_nl)
      36 -> {
        let call_node = node_f2(node)
        unique_linear_use_summary_list(generic_call_inner_args(call_node), generic_call_inner_arg_count(call_node), src, bind_src, bind_ns, bind_nl)
      }
      37 -> unique_linear_use_summary_name(node_f1(node), src, bind_src, bind_ns, bind_nl)
      41 -> unique_linear_use_summary_sequence(
        unique_linear_use_summary_name(node_f1(node), src, bind_src, bind_ns, bind_nl),
        unique_linear_use_summary_list(node_f3(node), nlist_len(node_f3(node)), src, bind_src, bind_ns, bind_nl)
      )
      45 -> unique_linear_use_summary_name(node_f1(node), src, bind_src, bind_ns, bind_nl)
      46 -> unique_linear_use_summary_sequence(
        unique_linear_use_summary_name(node_f1(node), src, bind_src, bind_ns, bind_nl),
        unique_linear_use_summary_name(node_f2(node), src, bind_src, bind_ns, bind_nl)
      )
      47 -> {
        let collection = unique_linear_use_summary_name(node_f3(node), src, bind_src, bind_ns, bind_nl)
        let body = if unique_name_matches(src, node_f1(node), node_f2(node), bind_src, bind_ns, bind_nl) == 1 { 0 }
        else { unique_linear_use_summary_loop(unique_linear_use_summary_name(node_f4(node), src, bind_src, bind_ns, bind_nl)) }
        unique_linear_use_summary_sequence(collection, body)
      }
      48 -> unique_linear_use_summary_name(node_f1(node), src, bind_src, bind_ns, bind_nl)
      49 -> unique_linear_use_summary_loop(unique_linear_use_summary_name(node_f1(node), src, bind_src, bind_ns, bind_nl))
      52 -> unique_linear_use_summary_sequence(
        unique_linear_use_summary_name(node_f2(node), src, bind_src, bind_ns, bind_nl),
        unique_linear_use_summary_name(node_f1(node), src, bind_src, bind_ns, bind_nl)
      )
      55 -> unique_linear_use_summary_name(node_f1(node), src, bind_src, bind_ns, bind_nl)
      56 -> unique_linear_use_summary_name(node_f1(node), src, bind_src, bind_ns, bind_nl)
      _ -> 0
    }
  }
}

pub(package) fn typeck_ty_is_linear_root(ty: i64) -> i64 {
  ty_is_unique(ty) == 1 or ty_is_owned(ty) == 1
}

pub(package) fn typeck_ty_is_linear(tt: i64, ty: i64) -> i64 {
  if typeck_ty_is_linear_root(ty) == 1 { 1 }
  else {
    let fact = typeck_linear_layout_type(tt, ty)
    if typeck_linear_layout_fact_decision(fact) == typeck_linear_layout_decision_linear() { 1 } else { 0 }
  }
}

pub(package) fn typeck_linear_use_twice_message(tt: i64, ty: i64) -> str {
  if ty_is_owned(ty) == 1 {
    "type error: owned value used more than once"
  } else { if ty_is_unique(ty) == 1 {
    "type error: unique value used more than once"
  } else { if typeck_ty_is_linear(tt, ty) == 1 {
    "type error: linear aggregate value used more than once"
  } else { "type error: linear value used more than once" } } }
}

pub(package) fn typeck_linear_capture_message(tt: i64, ty: i64) -> str {
  if ty_is_owned(ty) == 1 {
    "type error: owned value cannot be captured by closure"
  } else { if ty_is_unique(ty) == 1 {
    "type error: unique value cannot be captured by closure"
  } else { if typeck_ty_is_linear(tt, ty) == 1 {
    "type error: linear aggregate value cannot be captured by closure"
  } else { "type error: linear value cannot be captured by closure" } } }
}

pub(package) fn check_linear_binding_use_order(src: i64, ns: i64, nl: i64, binding_ty: i64, body: i64, tt: i64) -[Diagnose]> i64 {
  let summary = unique_linear_use_summary_name(body, src, src, ns, nl)
  if unique_linear_use_summary_invalid(summary) == 1 {
    typeck_error_maybe(src, ns, typeck_linear_use_twice_message(tt, binding_ty))
    1
  } else { 0 }
}

pub(package) fn check_unique_param_usage(params: i64, nparams: i64, body: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  let mut errors = 0
  for i in 0..nparams {
    let p = nlist_get(params, i)
    let param_ty = node_f3(p)
    if typeck_ty_is_linear(tt, param_ty) == 1 {
      let consuming_uses = unique_ref_count_name(body, src, src, node_f1(p), node_f2(p))
      if consuming_uses > 1 {
        typeck_error_maybe(src, node_f1(p), typeck_linear_use_twice_message(tt, param_ty))
        errors = errors + 1
      } else { errors = errors + check_linear_binding_use_order(src, node_f1(p), node_f2(p), param_ty, body, tt) }
    } else { errors = errors }
  }
  errors
}

pub(package) fn check_unique_param_usage_against_types(params: i64, param_types: i64, nparams: i64, body: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  let mut errors = 0
  for i in 0..nparams {
    let p = nlist_get(params, i)
    let param_ty = nlist_get(param_types, i)
    if typeck_ty_is_linear(tt, param_ty) == 1 {
      let consuming_uses = unique_ref_count_name(body, src, src, node_f1(p), node_f2(p))
      if consuming_uses > 1 {
        typeck_error_maybe(src, node_f1(p), typeck_linear_use_twice_message(tt, param_ty))
        errors = errors + 1
      } else { errors = errors + check_linear_binding_use_order(src, node_f1(p), node_f2(p), param_ty, body, tt) }
    } else { errors = errors }
  }
  errors
}

pub(package) fn typeck_type_list_contains_unique(types: i64) -> bool {
  if types == 0 { false }
  else {
    let mut found = false
    for i in 0..nlist_len(types) {
      if typeck_ty_contains_unique(nlist_get(types, i)) == 1 { found = 1 } else { found = found }
    }
    found
  }
}

pub(package) fn typeck_record_fields_contain_unique(fields: i64) -> bool {
  let mut found = false
  if fields != 0 {
    for i in 0..nlist_len(fields) {
      if typeck_ty_contains_unique(ty_record_field_type(nlist_get(fields, i))) { found = true } else { 0 }
    }
  } else { 0 }
  found
}

pub(package) fn typeck_ty_contains_unique(ty: i64) -> bool {
  if ty == 0 { false }
  else {
    match ty_tag(ty) {
      3 -> typeck_ty_contains_unique(ty_f1(ty)) or typeck_ty_contains_unique(ty_f2(ty))
      4 -> typeck_ty_contains_unique(ty_f1(ty)) or typeck_ty_contains_unique(ty_f2(ty))
      5 -> typeck_ty_contains_unique(ty_f1(ty))
      6 -> typeck_type_list_contains_unique(ty_f1(ty)) or typeck_ty_contains_unique(ty_f2(ty))
      7 -> typeck_record_fields_contain_unique(ty_record_fields(ty))
      8 -> typeck_ty_contains_unique(ty_f2(ty))
      9 -> typeck_ty_contains_unique(ty_f2(ty)) or typeck_type_list_contains_unique(ty_f3(ty))
      11 -> typeck_type_list_contains_unique(ty_f2(ty))
      14 -> typeck_ty_contains_unique(ty_f1(ty)) or typeck_ty_contains_unique(ty_f2(ty))
      15 -> typeck_ty_contains_unique(ty_f1(ty))
      16 -> typeck_ty_contains_unique(ty_f1(ty))
      17 -> typeck_ty_contains_unique(ty_f1(ty))
      18 -> true
      19 -> true
      22 -> typeck_ty_contains_unique(ty_array_inner(ty))
      23 -> typeck_ty_contains_unique(ty_slice_inner(ty))
      _ -> false
    }
  }
}

pub(package) fn typeck_params_contain_unique(params: i64) -> i64 {
  if params == 0 { 0 }
  else {
    let mut found = 0
    for i in 0..nlist_len(params) {
      if typeck_ty_contains_unique(node_f3(nlist_get(params, i))) == 1 { found = 1 } else { found = found }
    }
    found
  }
}

pub(package) fn tenv_contains_unique(env: i64) -> i64 {
  if env == 0 { 0 }
  else {
    if typeck_ty_contains_unique(mem_load64_at(env, 16)) == 1 { 1 }
    else { tenv_contains_unique(mem_load64_at(env, 32)) }
  }
}

pub(package) fn check_unique_binding_usage(src: i64, ns: i64, nl: i64, binding_ty: i64, body: i64, tt: i64) -[Diagnose]> i64 {
  if typeck_ty_is_linear(tt, binding_ty) == 1 {
    let consuming_uses = unique_ref_count_name(body, src, src, ns, nl)
    if consuming_uses > 1 {
      typeck_error_maybe(src, ns, typeck_linear_use_twice_message(tt, binding_ty))
      1
    } else { check_linear_binding_use_order(src, ns, nl, binding_ty, body, tt) }
  } else { 0 }
}

pub(package) fn check_linear_pattern_name_usage(pat: i64, arm_env: i64, guard: i64, body: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  let ns = node_f1(pat)
  let nl = node_f2(pat)
  let binding_ty = tenv_lookup(arm_env, src, ns, nl)
  if typeck_ty_is_linear(tt, binding_ty) != 1 { 0 }
  else {
    let guard_uses = if guard == 0 { 0 } else { unique_ref_count_name(guard, src, src, ns, nl) }
    let body_uses = unique_ref_count_name(body, src, src, ns, nl)
    if guard_uses > 0 {
      -- A failing guard must leave the scrutinee intact for later arms. A
      -- borrow is excluded by unique_ref_count_name and remains valid.
      typeck_error_maybe(src, ns, "type error: linear pattern binding cannot be consumed in a match guard")
      1
    } else { if body_uses > 1 {
      typeck_error_maybe(src, ns, typeck_linear_use_twice_message(tt, binding_ty))
      1
    } else {
      let guard_summary = if guard == 0 { 0 } else { unique_linear_use_summary_name(guard, src, src, ns, nl) }
      let body_summary = unique_linear_use_summary_name(body, src, src, ns, nl)
      if unique_linear_use_summary_invalid(unique_linear_use_summary_sequence(guard_summary, body_summary)) == 1 {
        typeck_error_maybe(src, ns, typeck_linear_use_twice_message(tt, binding_ty))
        1
      } else { 0 }
    } }
  }
}

pub(package) fn check_linear_pattern_bindings_usage(pat: i64, arm_env: i64, guard: i64, body: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  if pat == 0 { 0 }
  else {
    let tag = node_tag(pat)
    match tag {
      18 -> check_linear_pattern_name_usage(pat, arm_env, guard, body, src, tt)
      60 -> check_linear_pattern_name_usage(pat, arm_env, guard, body, src, tt)
      20 -> {
        let b_ns = node_f3(pat)
        let b_nl = node_f4(pat)
        if b_nl > 0 {
          let binding = node_new(18, b_ns, b_nl, 0, 0)
          check_linear_pattern_name_usage(binding, arm_env, guard, body, src, tt)
        } else { if b_nl < 0 {
          let mut errors = 0
          for i in 0..(0 - b_nl) {
            errors = errors + check_linear_pattern_bindings_usage(nlist_get(b_ns, i), arm_env, guard, body, src, tt)
          }
          errors
        } else { 0 } }
      }
      67 -> check_linear_pattern_bindings_usage(ctor_pattern_raw(pat), arm_env, guard, body, src, tt)
      64 -> {
        let fields = node_f1(pat)
        let mut errors = 0
        for i in 0..node_f2(pat) {
          errors = errors + check_linear_pattern_bindings_usage(node_f3(nlist_get(fields, i)), arm_env, guard, body, src, tt)
        }
        errors
      }
      65 -> {
        let items = node_f1(pat)
        let mut errors = 0
        for i in 0..node_f2(pat) {
          errors = errors + check_linear_pattern_bindings_usage(nlist_get(items, i), arm_env, guard, body, src, tt)
        }
        errors
      }
      _ -> 0
    }
  }
}

pub(package) fn check_unique_linear_expr_list(list: i64, n: i64, env: i64, ft: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  let mut errors = 0
  for i in 0..n {
    errors = errors + check_unique_linear_expr(nlist_get(list, i), env, ft, src, tt)
  }
  errors
}

pub(package) fn check_unique_linear_expr(node: i64, env: i64, ft: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  if node == 0 { 0 }
  else {
    let tag = node_tag(node)
    match tag {
      3 -> check_unique_linear_expr(node_f2(node), env, ft, src, tt) + check_unique_linear_expr(node_f3(node), env, ft, src, tt)
      4 -> check_unique_linear_expr_list(node_f3(node), node_f4(node), env, ft, src, tt)
      5 -> check_unique_linear_expr(node_f1(node), env, ft, src, tt) + check_unique_linear_expr(node_f2(node), env, ft, src, tt) + check_unique_linear_expr(node_f3(node), env, ft, src, tt)
      6 -> {
        let val = node_f3(node)
        let body = node_f4(node)
        let val_ty = synth(val, env, ft, src, tt)
        let new_env = tenv_bind(env, src, node_f1(node), node_f2(node), val_ty)
        check_unique_linear_expr(val, env, ft, src, tt) +
          check_unique_binding_usage(src, node_f1(node), node_f2(node), val_ty, body, tt) +
          check_unique_linear_expr(body, new_env, ft, src, tt)
      }
      7 -> check_unique_linear_expr(node_f1(node), env, ft, src, tt) + check_unique_linear_expr(node_f2(node), env, ft, src, tt)
      10 -> check_unique_linear_expr(node_f1(node), env, ft, src, tt) + check_unique_linear_expr(node_f2(node), env, ft, src, tt)
      11 -> {
        let val = node_f3(node)
        let body = node_f4(node)
        let val_ty = synth(val, env, ft, src, tt)
        let new_env = tenv_bind_mut(env, src, node_f1(node), node_f2(node), val_ty)
        check_unique_linear_expr(val, env, ft, src, tt) +
          check_unique_binding_usage(src, node_f1(node), node_f2(node), val_ty, body, tt) +
          check_unique_linear_expr(body, new_env, ft, src, tt)
      }
      12 -> check_unique_linear_expr(node_f3(node), env, ft, src, tt)
      57 -> check_unique_linear_expr(node_f1(node), env, ft, src, tt) + check_unique_linear_expr(node_f2(node), env, ft, src, tt)
      13 -> check_unique_linear_expr(node_f1(node), env, ft, src, tt)
      59 -> check_unique_linear_expr(node_f1(node), env, ft, src, tt)
      60 -> check_unique_linear_expr(node_f1(node), env, ft, src, tt) + check_unique_linear_expr(node_f2(node), env, ft, src, tt)
      61 -> check_unique_linear_expr(node_f1(node), env, ft, src, tt) + check_unique_linear_expr(node_f2(node), env, ft, src, tt) + check_unique_linear_expr(node_f3(node), env, ft, src, tt)
      62 -> check_unique_linear_expr(node_f1(node), env, ft, src, tt) + check_unique_linear_expr(node_f2(node), env, ft, src, tt) + check_unique_linear_expr(node_f3(node), env, ft, src, tt)
      14 -> {
        let fields = node_f3(node)
        let nfields = node_f4(node)
        let mut errors = 0
        for i in 0..nfields {
          errors = errors + check_unique_linear_expr(node_f3(nlist_get(fields, i)), env, ft, src, tt)
        }
        errors
      }
      63 -> check_unique_linear_expr(node_f1(node), env, ft, src, tt) + check_unique_linear_expr_list(record_field_expr_nodes(node_f2(node), node_f3(node)), node_f3(node), env, ft, src, tt)
      58 -> check_unique_linear_expr_list(node_f1(node), node_f2(node), env, ft, src, tt)
      15 -> {
        let scrutinee = node_f1(node)
        let scr_ty = synth(scrutinee, env, ft, src, tt)
        let arms = node_f2(node)
        let n = node_f3(node)
        let mut errors = check_unique_linear_expr(scrutinee, env, ft, src, tt)
        for i in 0..n {
          let arm = nlist_get(arms, i)
          let arm_env = bind_match_pattern(node_f1(arm), env, src, scr_ty, tt)
          let guard = node_f3(arm)
          if guard != 0 { errors = errors + check_unique_linear_expr(guard, arm_env, ft, src, tt) } else { errors = errors }
          errors = errors + check_unique_linear_expr(node_f2(arm), arm_env, ft, src, tt)
        }
        errors
      }
      22 -> check_unique_linear_expr(node_f1(node), env, ft, src, tt)
      25 -> check_unique_linear_expr(node_f1(node), env, ft, src, tt)
      26 -> check_unique_linear_expr(node_f1(node), env, ft, src, tt)
      29 -> 0
      32 -> check_unique_linear_expr(node_f1(node), env, ft, src, tt) + check_unique_linear_expr_list(node_f4(node), nlist_len(node_f4(node)), env, ft, src, tt)
      33 -> {
        let clauses = node_f2(node)
        let nclauses = node_f3(node)
        let mut errors = check_unique_linear_expr(node_f1(node), env, ft, src, tt)
        for ci in 0..nclauses {
          let clause = nlist_get(clauses, ci)
          let clause_env = bind_capture_params(node_f2(clause), nlist_len(node_f2(clause)), env, src)
          errors = errors + check_unique_linear_expr(node_f3(clause), clause_env, ft, src, tt)
        }
        errors
      }
      35 -> check_unique_linear_expr(node_f1(node), env, ft, src, tt)
      36 -> {
        let call_node = node_f2(node)
        check_unique_linear_expr_list(generic_call_inner_args(call_node), generic_call_inner_arg_count(call_node), env, ft, src, tt)
      }
      37 -> {
        let inner = node_f1(node)
        let ann_ty = node_f2(node)
        let val = node_f3(inner)
        let body = node_f4(inner)
        let new_env = if node_tag(inner) == 11 {
          tenv_bind_mut(env, src, node_f1(inner), node_f2(inner), ann_ty)
        } else {
          tenv_bind(env, src, node_f1(inner), node_f2(inner), ann_ty)
        }
        check_unique_linear_expr(val, env, ft, src, tt) +
          check_unique_binding_usage(src, node_f1(inner), node_f2(inner), ann_ty, body, tt) +
          check_unique_linear_expr(body, new_env, ft, src, tt)
      }
      41 -> check_unique_linear_expr(node_f1(node), env, ft, src, tt) + check_unique_linear_expr_list(node_f3(node), nlist_len(node_f3(node)), env, ft, src, tt)
      45 -> check_unique_linear_expr(node_f1(node), env, ft, src, tt)
      46 -> check_unique_linear_expr(node_f1(node), env, ft, src, tt) + check_unique_linear_expr(node_f2(node), env, ft, src, tt)
      47 -> {
        let loop_env = tenv_bind(env, src, node_f1(node), node_f2(node), for_iter_item_type(node, env, ft, src, tt))
        check_unique_linear_expr(node_f3(node), env, ft, src, tt) + check_unique_linear_expr(node_f4(node), loop_env, ft, src, tt)
      }
      48 -> check_unique_linear_expr(node_f1(node), env, ft, src, tt)
      49 -> check_unique_linear_expr(node_f1(node), env, ft, src, tt)
      52 -> check_unique_linear_expr(node_f1(node), env, ft, src, tt) + check_unique_linear_expr(node_f2(node), env, ft, src, tt)
      55 -> check_unique_linear_expr(node_f1(node), env, ft, src, tt)
      56 -> check_unique_linear_expr(node_f1(node), env, ft, src, tt)
      _ -> 0
    }
  }
}

pub(package) fn check_unique_capture_name(ns: i64, nl: i64, outer_env: i64, local_env: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  if tenv_lookup(local_env, src, ns, nl) != 0 { 0 }
  else {
    let outer_ty = tenv_lookup(outer_env, src, ns, nl)
    if typeck_ty_is_linear(tt, outer_ty) == 1 {
      typeck_error_maybe(src, ns, typeck_linear_capture_message(tt, outer_ty))
      1
    } else { 0 }
  }
}

pub(package) fn check_unique_captures_list(list: i64, n: i64, outer_env: i64, local_env: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  let mut errors = 0
  for i in 0..n {
    errors = errors + check_unique_captures(nlist_get(list, i), outer_env, local_env, src, tt)
  }
  errors
}

pub(package) fn check_unique_captures(node: i64, outer_env: i64, local_env: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  if node == 0 { 0 }
  else {
    let tag = node_tag(node)
    match tag {
      2 -> check_unique_capture_name(node_f1(node), node_f2(node), outer_env, local_env, src, tt)
      3 -> check_unique_captures(node_f2(node), outer_env, local_env, src, tt) + check_unique_captures(node_f3(node), outer_env, local_env, src, tt)
      4 -> check_unique_captures_list(node_f3(node), node_f4(node), outer_env, local_env, src, tt)
      5 -> check_unique_captures(node_f1(node), outer_env, local_env, src, tt) + check_unique_captures(node_f2(node), outer_env, local_env, src, tt) + check_unique_captures(node_f3(node), outer_env, local_env, src, tt)
      6 -> {
        let new_local = tenv_bind(local_env, src, node_f1(node), node_f2(node), ty_any())
        check_unique_captures(node_f3(node), outer_env, local_env, src, tt) + check_unique_captures(node_f4(node), outer_env, new_local, src, tt)
      }
      7 -> check_unique_captures(node_f1(node), outer_env, local_env, src, tt) + check_unique_captures(node_f2(node), outer_env, local_env, src, tt)
      10 -> check_unique_captures(node_f1(node), outer_env, local_env, src, tt) + check_unique_captures(node_f2(node), outer_env, local_env, src, tt)
      11 -> {
        let new_local = tenv_bind(local_env, src, node_f1(node), node_f2(node), ty_any())
        check_unique_captures(node_f3(node), outer_env, local_env, src, tt) + check_unique_captures(node_f4(node), outer_env, new_local, src, tt)
      }
      12 -> check_unique_captures(node_f3(node), outer_env, local_env, src, tt)
      57 -> check_unique_captures(node_f1(node), outer_env, local_env, src, tt) + check_unique_captures(node_f2(node), outer_env, local_env, src, tt)
      13 -> check_unique_captures(node_f1(node), outer_env, local_env, src, tt)
      59 -> check_unique_captures(node_f1(node), outer_env, local_env, src, tt)
      60 -> check_unique_captures(node_f1(node), outer_env, local_env, src, tt) + check_unique_captures(node_f2(node), outer_env, local_env, src, tt)
      61 -> check_unique_captures(node_f1(node), outer_env, local_env, src, tt) + check_unique_captures(node_f2(node), outer_env, local_env, src, tt) + check_unique_captures(node_f3(node), outer_env, local_env, src, tt)
      62 -> check_unique_captures(node_f1(node), outer_env, local_env, src, tt) + check_unique_captures(node_f2(node), outer_env, local_env, src, tt) + check_unique_captures(node_f3(node), outer_env, local_env, src, tt)
      14 -> {
        let fields = node_f3(node)
        let nfields = node_f4(node)
        let mut errors = 0
        for i in 0..nfields {
          errors = errors + check_unique_captures(node_f3(nlist_get(fields, i)), outer_env, local_env, src, tt)
        }
        errors
      }
      63 -> check_unique_captures(node_f1(node), outer_env, local_env, src, tt) + check_unique_captures_list(record_field_expr_nodes(node_f2(node), node_f3(node)), node_f3(node), outer_env, local_env, src, tt)
      58 -> check_unique_captures_list(node_f1(node), node_f2(node), outer_env, local_env, src, tt)
      15 -> {
        let arms = node_f2(node)
        let n = node_f3(node)
        let mut errors = check_unique_captures(node_f1(node), outer_env, local_env, src, tt)
        for i in 0..n {
          let arm = nlist_get(arms, i)
          let arm_local = bind_capture_pattern(node_f1(arm), local_env, src)
          let guard = node_f3(arm)
          if guard != 0 { errors = errors + check_unique_captures(guard, outer_env, arm_local, src, tt) } else { errors = errors }
          errors = errors + check_unique_captures(node_f2(arm), outer_env, arm_local, src, tt)
        }
        errors
      }
      22 -> check_unique_captures(node_f1(node), outer_env, local_env, src, tt)
      25 -> check_unique_captures(node_f1(node), outer_env, local_env, src, tt)
      26 -> check_unique_captures(node_f1(node), outer_env, local_env, src, tt)
      29 -> 0
      32 -> check_unique_captures(node_f1(node), outer_env, local_env, src, tt) + check_unique_captures_list(node_f4(node), nlist_len(node_f4(node)), outer_env, local_env, src, tt)
      33 -> check_unique_captures(node_f1(node), outer_env, local_env, src, tt)
      35 -> check_unique_captures(node_f1(node), outer_env, local_env, src, tt)
      36 -> {
        let call_node = node_f2(node)
        check_unique_captures_list(generic_call_inner_args(call_node), generic_call_inner_arg_count(call_node), outer_env, local_env, src, tt)
      }
      37 -> {
        let inner = node_f1(node)
        let new_local = tenv_bind(local_env, src, node_f1(inner), node_f2(inner), ty_any())
        check_unique_captures(node_f3(inner), outer_env, local_env, src, tt) + check_unique_captures(node_f4(inner), outer_env, new_local, src, tt)
      }
      41 -> check_unique_captures(node_f1(node), outer_env, local_env, src, tt) + check_unique_captures_list(node_f3(node), nlist_len(node_f3(node)), outer_env, local_env, src, tt)
      45 -> check_unique_captures(node_f1(node), outer_env, local_env, src, tt)
      46 -> check_unique_captures(node_f1(node), outer_env, local_env, src, tt) + check_unique_captures(node_f2(node), outer_env, local_env, src, tt)
      47 -> {
        let loop_local = tenv_bind(local_env, src, node_f1(node), node_f2(node), ty_any())
        check_unique_captures(node_f3(node), outer_env, local_env, src, tt) + check_unique_captures(node_f4(node), outer_env, loop_local, src, tt)
      }
      48 -> check_unique_captures(node_f1(node), outer_env, local_env, src, tt)
      49 -> check_unique_captures(node_f1(node), outer_env, local_env, src, tt)
      52 -> check_unique_captures(node_f1(node), outer_env, local_env, src, tt) + check_unique_captures(node_f2(node), outer_env, local_env, src, tt)
      55 -> check_unique_captures(node_f1(node), outer_env, local_env, src, tt)
      56 -> check_unique_captures(node_f1(node), outer_env, local_env, src, tt)
      _ -> 0
    }
  }
}

pub(package) fn check_closure_unique_captures(body: i64, params: i64, nparams: i64, outer_env: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  let local_env = bind_capture_params(params, nparams, tenv_new(), src)
  check_unique_captures(body, outer_env, local_env, src, tt)
}

pub(package) fn check_with_handler(node: i64, env: i64, ft: i64, src: i64, caller_eff: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let config = node_f1(node)
  let body = node_f2(node)
  let resolution = if node_f3(node) != 0 { 0 }
    else { typeck_resolve_handler_configuration(config, src, tt) }
  let install = if node_f3(node) != 0 { node_f3(node) }
    else { if resolution == 0 { 0 } else { mem_load64_at(resolution, 0) } }
  let mut errors = if resolution == 0 { 0 } else { mem_load64_at(resolution + 8, 0) }
  if install != 0 { mem_store64_at(node, 24, install) } else { 0 }
  let args = typeck_handler_config_args(config)
  let nargs = typeck_handler_config_arg_count(config)
  for ai in 0..nargs {
    errors = errors + check_expr(nlist_get(args, ai), env, ft, src, caller_eff, tt)
  }
  if install == 0 {
    errors + check_expr(body, env, ft, src, caller_eff, tt)
  } else {
    let target = node_f1(install)
    let implementation = node_f2(install)
    let subst = node_f3(install)
    let exact_atom = node_f4(install)
    let impl_src = module_fact_entry_source(target)
    let ctor_params = typeck_handler_implementation_params(implementation)
    let nparams = if ctor_params == 0 { 0 } else { nlist_len(ctor_params) }
    if nargs != nparams {
      typeck_error_maybe(src, typeck_handler_config_name_start(config), "type error: handler constructor arity mismatch")
      errors = errors + 1
    } else { 0 }
    let nbind = if nargs < nparams { nargs } else { nparams }
    let mut clause_env = tenv_new()
    for pi in 0..nparams {
      let param = nlist_get(ctor_params, pi)
      let raw_ty = node_f3(param)
      let expected = if raw_ty != 0 and subst != 0 { ty_subst(raw_ty, subst) } else { if raw_ty == 0 { ty_any() } else { raw_ty } }
      clause_env = tenv_bind_kind(clause_env, impl_src, node_f1(param), node_f2(param), expected, semantic_symbol_kind_parameter())
      if pi < nbind {
        let arg = nlist_get(args, pi)
        let actual = synth(arg, env, ft, src, tt)
        if expr_matches_type_contextual(arg, actual, expected, src, ft) != 1 {
          typeck_report_expr_type_mismatch(
            src, arg, expected, actual, "handler constructor argument",
            typeck_source_location(impl_src, node_f1(param), node_f2(param)), tt
          )
          errors = errors + 1
        } else { 0 }
      } else { 0 }
    }
    let raw_atom = typeck_handler_implementation_atom(implementation)
    let handled_hash = effect_atom_head(raw_atom)
    let expanded_eff = effect_add_with_atom(caller_eff, effect_atom_head(exact_atom), exact_atom)
    let saved_handler = ttable_get_current_handler(tt)
    let handler_frame = typeck_handler_frame(exact_atom, src, typeck_handler_config_name_start(config), typeck_handler_config_name_len(config), saved_handler)
    ttable_set_current_handler(tt, handler_frame)
    errors = errors + check_expr(body, env, ft, src, expanded_eff, tt)
    ttable_set_current_handler(tt, saved_handler)
    let result_ty = synth(body, env, ft, src, tt)
    errors = errors + check_native_result_abi_ty(src, expr_diag_pos(body), result_ty)
    let effect_entry = typeck_effect_ref_entry(typeck_handler_implementation_effect_ref(implementation), impl_src, tt)
    let hsubst = if effect_entry == 0 { 0 } else { effect_entry_atom_subst(effect_entry, exact_atom) }
    let clauses = typeck_handler_implementation_clauses(implementation)
    let nclauses = typeck_handler_implementation_clause_count(implementation)
    for ci in 0..nclauses {
      let clause = nlist_get(clauses, ci)
      let allow_non_tail = if node_f4(clause) == 0 { 0 } else { 2 }
      errors = errors + check_handler_clause(
        clause, handled_hash, clause_env, ft, impl_src, caller_eff, tt,
        node_new(0, result_ty, allow_non_tail, hsubst, raw_atom)
      )
    }
    errors
  }
}

-- Check all expressions in a function body
pub(package) fn check_expr(node: i64, env: i64, ft: i64, src: i64, caller_eff: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let tag = node_tag(node)
  let mut errors = 0
  match tag {
    64 -> check_with_handler(node, env, ft, src, caller_eff, tt)
    58 -> {
      let elements = node_f1(node)
      for ai in 0..node_f2(node) {
        errors = errors + check_expr(nlist_get(elements, ai), env, ft, src, caller_eff, tt)
      }
      let array_ty = synth_array_literal(node, env, ft, src, tt)
      if ty_is_array(array_ty) and ty_union_storage_class(ty_array_inner(array_ty)) < 0 {
        typeck_error_maybe(src, expr_diag_pos(node), "type error: array element union has no uniform untagged storage; use a variant type")
        errors = errors + 1
      } else { errors = errors }
      errors
    }
    2 -> {
      typeck_record_symbol_use(tt, ft, env, src, node_f1(node), node_f2(node))
      let constant_decl = if tenv_lookup(env, src, node_f1(node), node_f2(node)) == 0 { typeck_constant_decl_for_ident(tt, src, node_f1(node), node_f2(node)) } else { 0 }
      if constant_decl != 0 and typeck_materialize_constant_use(node, constant_decl, src) == 1 { 0 }
      else { check_ident_defined(node, env, ft, src, tt) }
    }
    3 -> {
      -- BinOp: check operand types
      -- Keep the parsed children: successful typed Ord checking rewrites this
      -- node to an exhaustive match whose synthesized compare call still
      -- needs the ordinary recursive check exactly once.
      let lhs = node_f2(node)
      let rhs = node_f3(node)
      let op = node_f1(node)
      errors = errors + check_binop(node, env, ft, src, tt)
      if node_tag(node) == 15 {
        -- Constructor identity is already exact; checking only the generated
        -- call avoids re-resolving imported pattern text in the caller buffer.
        errors = errors + check_expr(node_f1(node), env, ft, src, caller_eff, tt)
      } else {
        -- Recursively check sub-expressions. Short-circuit rhs positions
        -- see the guard-narrowed env: `x != nil and use(x)` checks use(x)
        -- with x non-nil, `x == nil or use(x)` likewise (§5.3.1 licenses
        -- this: the rhs only evaluates when the guard passed/failed).
        errors = errors + check_expr(lhs, env, ft, src, caller_eff, tt)
        let rhs_env = if op == 12 { tenv_narrow_guard(env, lhs, 6, src) }
          else { if op == 13 { tenv_narrow_guard(env, lhs, 5, src) } else { env } }
        errors = errors + check_expr(rhs, rhs_env, ft, src, caller_eff, tt)
      }
      errors
    }
    5 -> {
      -- If: check condition is bool-like, check branches under the
      -- guard-narrowed env (then sees `x != nil`, else sees the negation
      -- of `x == nil`).
      let cond = node_f1(node)
      let then_node = node_f2(node)
      errors = errors + check_expr(cond, env, ft, src, caller_eff, tt)
      errors = errors + check_bool_expr(cond, env, ft, src, tt)
      let then_env = tenv_narrow_guard(env, cond, 6, src)
      errors = errors + check_expr(then_node, then_env, ft, src, caller_eff, tt)
      let else_node = node_f3(node)
      if else_node != 0 {
        let else_env = tenv_narrow_guard(env, cond, 5, src)
        errors = errors + check_expr(else_node, else_env, ft, src, caller_eff, tt)
      } else { errors = errors }
      errors
    }
    6 -> {
      -- Let: check value, then check body with extended env
      let val = node_f3(node)
      let body = node_f4(node)
      errors = errors + check_expr(val, env, ft, src, caller_eff, tt)
      errors = errors + check_default_i64_literal_expr(val, src)
      let val_ty = synth(val, env, ft, src, tt)
      let new_env = if node_tag(val) == 29 {
        tenv_bind_value(env, src, node_f1(node), node_f2(node), val_ty, val)
      } else {
        tenv_bind(env, src, node_f1(node), node_f2(node), val_ty)
      }
      typeck_record_binding_fact(tt, src, node_f1(node), node_f2(node), val_ty, semantic_symbol_kind_local(), new_env)
      errors = errors + check_owned_drop_effect_available(val_ty, tt, src, node_f1(node), caller_eff)
      errors = errors + check_expr(body, new_env, ft, src, caller_eff, tt)
      -- Borrow-use facts are produced while checking calls in the body; the
      -- linear count must consume those facts, never run ahead of them.
      errors = errors + check_unique_binding_usage(src, node_f1(node), node_f2(node), val_ty, body, tt)
      errors
    }
    11 -> {
      -- LetMut: same as let
      let val = node_f3(node)
      let body = node_f4(node)
      errors = errors + check_expr(val, env, ft, src, caller_eff, tt)
      errors = errors + check_default_i64_literal_expr(val, src)
      let val_ty = synth(val, env, ft, src, tt)
      let new_env = tenv_bind_mut(env, src, node_f1(node), node_f2(node), val_ty)
      typeck_record_binding_fact(tt, src, node_f1(node), node_f2(node), val_ty, semantic_symbol_kind_local(), new_env)
      errors = errors + check_owned_drop_effect_available(val_ty, tt, src, node_f1(node), caller_eff)
      errors = errors + check_expr(body, new_env, ft, src, caller_eff, tt)
      errors = errors + check_unique_binding_usage(src, node_f1(node), node_f2(node), val_ty, body, tt)
      errors
    }
    37 -> {
      -- LetTyped: check value against annotation, then check body
      let inner = node_f1(node)
      let ann_ty = node_f2(node)
      let val = node_f3(inner)
      let body = node_f4(inner)
      errors = errors + check_public_arc_ty(tt, src, node_f1(inner), ann_ty)
      errors = errors + check_borrow_surface_ty(src, node_f1(inner), ann_ty)
      errors = errors + check_move_only_storage_ty(tt, src, node_f1(inner), ann_ty)
      errors = errors + check_owned_resource_ty(tt, src, node_f1(inner), ann_ty)
      prepare_expr_contextual(val, ann_ty, env, ft, src, tt)
      errors = errors + check_expr(val, env, ft, src, caller_eff, tt)
      let val_ty = synth(val, env, ft, src, tt)
      if ann_ty != 0 {
        if val_ty != 0 {
          if expr_matches_type_contextual(val, val_ty, ann_ty, src, ft) != 1 {
            -- Second chance: generic ctor solves type args from the annotation.
            if infer_generic_ctor_result(val, ann_ty, env, ft, src, tt) == 1 and expr_matches_type_contextual(val, synth(val, env, ft, src, tt), ann_ty, src, ft) == 1 {
              errors = errors
            } else {
              typeck_report_expr_type_mismatch(
                src,
                val,
                ann_ty,
                val_ty,
                "type annotation",
                typeck_source_location(src, node_f1(inner), node_f2(inner)),
                tt
              )
              errors = errors + 1
            }
          } else { errors = errors }
        } else { errors = errors }
      } else { errors = errors }
      errors = errors + check_owned_drop_effect_available(ann_ty, tt, src, node_f1(inner), caller_eff)
      let new_env = if node_tag(inner) == 11 {
        tenv_bind_mut(env, src, node_f1(inner), node_f2(inner), ann_ty)
      } else {
        if node_tag(val) == 29 {
          tenv_bind_value(env, src, node_f1(inner), node_f2(inner), ann_ty, val)
        } else {
          tenv_bind(env, src, node_f1(inner), node_f2(inner), ann_ty)
        }
      }
      typeck_record_binding_fact(tt, src, node_f1(inner), node_f2(inner), ann_ty, semantic_symbol_kind_local(), new_env)
      errors = errors + check_expr(body, new_env, ft, src, caller_eff, tt)
      errors = errors + check_unique_binding_usage(src, node_f1(inner), node_f2(inner), ann_ty, body, tt)
      errors
    }
    7 -> {
      -- Block: check first, then rest
      errors = errors + check_expr(node_f1(node), env, ft, src, caller_eff, tt)
      let rest = node_f2(node)
      if rest != 0 { errors = errors + check_expr(rest, env, ft, src, caller_eff, tt) } else { errors = errors }
      errors
    }
    10 -> {
      -- While: check condition and body
      errors = errors + check_expr(node_f1(node), env, ft, src, caller_eff, tt)
      errors = errors + check_bool_expr(node_f1(node), env, ft, src, tt)
      errors = errors + check_expr(node_f2(node), env, ft, src, caller_eff, tt)
      errors
    }
    12 -> {
      -- Assign: check assigned value
      errors = errors + check_expr(node_f3(node), env, ft, src, caller_eff, tt)
      errors = errors + check_assign_target(node, env, ft, src, tt)
      errors
    }
    57 -> check_ptr_assign(node, env, ft, src, caller_eff, tt)
    13 -> {
      let qualified_decl = typeck_resolve_module_member_access(node, env, src, tt)
      let constant = if qualified_decl == 0 { 0 } else { module_decl_fact_constant_fact(qualified_decl) }
      if constant != 0 {
        typeck_record_qualified_constant_use(tt, env, src, node, qualified_decl)
        if typeck_materialize_constant_use(node, qualified_decl, src) == 1 { 0 } else { errors }
      } else { if qualified_decl != 0 {
        errors + check_qualified_function_ref(node, env, ft, src, tt)
      } else { if node_tag(node_f1(node)) == 2 and tenv_lookup(env, src, node_f1(node_f1(node)), node_f2(node_f1(node))) == 0 and module_scope_qualifier_is_module(tt, src, src, node_f1(node_f1(node)), node_f2(node_f1(node))) == 1 {
        errors + check_module_member_resolution(node_f1(node), node_f2(node), node_f3(node), src, tt)
      } else { if ident_names_variant_type(node_f1(node), env, src, tt) == 1 {
        -- Type.Variant nullary qualified construction: reject with the
        -- targeted message instead of "unknown identifier" on the type.
        typeck_error(src, node_f2(node), "type error: qualified constructor syntax is not supported; constructors are bare values")
        errors + 1
      } else {
        -- Field access: check base expression
        errors = errors + check_expr(node_f1(node), env, ft, src, caller_eff, tt)
        errors = errors + check_field_access(node, env, ft, src, tt)
        errors
      } } } }
    }
    59 -> check_expr(node_f1(node), env, ft, src, caller_eff, tt)
    60 -> check_indexed_get(node, env, ft, src, caller_eff, tt)
    61 -> check_indexed_set(node, env, ft, src, caller_eff, tt)
    62 -> check_indexed_slice(node, env, ft, src, caller_eff, tt)
    14 -> {
      -- Record init: check field value expressions
      let fields = node_f3(node)
      let nfields = node_f4(node)
      for ri in 0..nfields {
        let field = nlist_get(fields, ri)
        errors = errors + check_expr(node_f3(field), env, ft, src, caller_eff, tt)
      }
      errors = errors + check_record_init_shape(node, env, ft, src, tt)
      errors
    }
    63 -> {
      errors = errors + check_expr(node_f1(node), env, ft, src, caller_eff, tt)
      let fields = node_f2(node)
      for ri in 0..node_f3(node) {
        errors = errors + check_expr(node_f3(nlist_get(fields, ri)), env, ft, src, caller_eff, tt)
      }
      errors = errors + check_record_update_shape(node, env, ft, src, tt)
      errors
    }
    22 -> {
      -- Not: check operand
      errors = errors + check_expr(node_f1(node), env, ft, src, caller_eff, tt)
      errors = errors + check_bool_expr(node_f1(node), env, ft, src, tt)
      errors
    }
    25 -> {
      let val = node_f1(node)
      if val != 0 { errors = errors + check_expr(val, env, ft, src, caller_eff, tt) } else { errors = errors }
      errors
    }
    26 -> {
      let val = node_f1(node)
      if val != 0 { errors = errors + check_expr(val, env, ft, src, caller_eff, tt) } else { errors = errors }
      errors
    }
    27 -> errors
    33 -> {
      -- Handle: check body with expanded effect set (handler discharges an effect)
      let handle_body = node_f1(node)
      let clauses = node_f2(node)
      let nclauses = node_f3(node)
      for hi in 0..nclauses {
        typeck_resolve_effect_ref(handler_clause_effect_ref_node(nlist_get(clauses, hi)), env, src, tt)
      }
      -- Get the handled effect head and, when written, its exact atom from
      -- the first clause's shared effect-reference node.
      let handled_eff_hash = if nclauses > 0 {
        handler_clause_eff_hash(nlist_get(clauses, 0), src)
      } else { 0 }
      -- parameterized effects: recover the handled atom's instantiation from the body's
      -- collected effects (callee declared sigs preserve args). Bare when
      -- the body only performs directly — recorded generic-effect substitution debt.
      let explicit_handled_atom = if nclauses > 0 {
        let first_ref = handler_clause_effect_ref_node(nlist_get(clauses, 0))
        if typeck_effect_ref_is_parameterized(first_ref) == 1 { typeck_effect_ref_atom(first_ref, src) } else { 0 }
      } else { 0 }
      let body_effects = nlist_new()
      if handled_eff_hash != 0 { collect_expr_effects(handle_body, env, ft, src, tt, body_effects) } else { 0 }
      let first_unqualified = if nclauses > 0 {
        if typeck_effect_ref_is_parameterized(handler_clause_effect_ref_node(nlist_get(clauses, 0))) == 0 { 1 } else { 0 }
      } else { 0 }
      if first_unqualified == 1 and effect_list_head_is_ambiguous(body_effects, handled_eff_hash) == 1 {
        let first_ident = handler_clause_effect_ident_node(nlist_get(clauses, 0))
        typeck_error_maybe(src, if first_ident == 0 { 0 } else { node_f1(first_ident) }, "type error: ambiguous handler effect atom; qualify the clause")
        errors = errors + 1
      } else { errors = errors }
      let handled_atom = if explicit_handled_atom != 0 { explicit_handled_atom }
      else { if handled_eff_hash != 0 {
        effect_list_find_atom_by_head(body_effects, handled_eff_hash)
      } else { 0 } }
      canonicalize_unqualified_handler_clauses(clauses, nclauses, handled_atom)
      -- Expand caller_eff to include the handled effect (full atom form)
      let expanded_eff = effect_add_with_atom(caller_eff, handled_eff_hash, handled_atom)
      -- Check structural handler shape before validating clause bodies.
      errors = errors + check_handler_duplicate_clauses(clauses, nclauses, src)
      -- Check body with expanded effects (body is allowed to perform the handled effect)
      let saved_handler = ttable_get_current_handler(tt)
      let handler_frame = if nclauses == 0 { 0 }
        else {
          let first_ref = handler_clause_effect_ref_node(nlist_get(clauses, 0))
          typeck_handler_frame(handled_atom, src, typeck_effect_ref_name_start(first_ref), typeck_effect_ref_name_len(first_ref), saved_handler)
        }
      if handler_frame != 0 { ttable_set_current_handler(tt, handler_frame) } else { 0 }
      errors = errors + check_expr(handle_body, env, ft, src, expanded_eff, tt)
      ttable_set_current_handler(tt, saved_handler)
      errors = errors + check_missing_handler_clauses(handle_body, clauses, nclauses, handled_eff_hash, src, tt)
      -- Check clause bodies (they run in the handler's scope, not the body's)
      -- Clause layout: f1=name_info, f2=params, f3=body, f4=0
      let body_completion_ty = synth(handle_body, env, ft, src, tt)
      -- Kernel §7.3: with a return clause, the handle's result is the clause
      -- body's type; abortive op clauses and resume continuations type
      -- against the TRANSFORMED result. The binder sees the body's type.
      let ret_clause = node_f4(node)
      let handle_result_ty = if ret_clause == 0 { body_completion_ty }
      else {
        let renv = tenv_bind_kind(env, src, node_f1(ret_clause), node_f2(ret_clause), body_completion_ty, semantic_symbol_kind_pattern())
        typeck_record_binding_fact(tt, src, node_f1(ret_clause), node_f2(ret_clause), body_completion_ty, semantic_symbol_kind_pattern(), renv)
        errors = errors + check_expr(node_f3(ret_clause), renv, ft, src, caller_eff, tt)
        let renv2 = tenv_bind(env, src, node_f1(ret_clause), node_f2(ret_clause), body_completion_ty)
        synth(node_f3(ret_clause), renv2, ft, src, tt)
      }
      errors = errors + check_native_result_abi_ty(src, expr_diag_pos(handle_body), handle_result_ty)
      -- parameterized effects: instantiating substitution for the clauses' op signatures.
      let hsubst = if nclauses > 0 and handled_atom != 0 {
        let first_ref = handler_clause_effect_ref_node(nlist_get(clauses, 0))
        effect_entry_atom_subst(typeck_effect_ref_entry(first_ref, src, tt), handled_atom)
      } else { 0 }
      for ci in 0..nclauses {
        let clause = nlist_get(clauses, ci)
        let allow_non_tail = if node_f4(clause) == 0 { 0 }
        else { if deferred_split_body_supports_clause(handle_body, clause, src, ft) { 1 }
        else { if deferred_fiber_handle_supports_clause(handle_body, clauses, nclauses, clause, src, env, ft, tt) { 2 }
        else { 0 } } }
        errors = errors + check_handler_clause(clause, handled_eff_hash, env, ft, src, caller_eff, tt, node_new(0, handle_result_ty, allow_non_tail, hsubst, handled_atom))
      }
      errors
    }
    4 -> {
      -- Call: check arguments recursively + check arg types match params.
      -- Bare calls to generic callees are handled inside check_call_args:
      -- var-typed params trigger type-arg inference there (rewriting the
      -- node to an explicit GenericCall) at zero cost to ordinary calls.
      typeck_record_symbol_use(tt, ft, env, src, node_f1(node), node_f2(node))
      let args = node_f3(node)
      let nargs = node_f4(node)
      for i in 0..nargs {
        let arg = nlist_get(args, i)
        -- A direct lambda is checked below against the callee parameter.
        -- Standalone checking here loses that expected signature and used to
        -- reject generic effect ops before the contextual pass could run.
        if node_tag(arg) != 29 {
          errors = errors + check_expr(arg, env, ft, src, caller_eff, tt)
        } else { errors = errors }
      }
      errors = errors + check_call_defined(node, env, ft, src, tt)
      errors = errors + check_internal_par_prepared_call_sealed(tt, node, src)
      errors = errors + check_unsafe_raw_call_available(node, src, caller_eff, tt)
      -- Check arg types match declared param types
      errors = errors + check_call_args(node, env, ft, src, caller_eff, tt)
      errors = errors + check_scoped_region_helper(node, src)
      errors
    }
    36 -> {
      -- Explicit dot-generic calls elaborate to the same resolved MethodCall
      -- fact as ordinary method syntax before the generic function path runs.
      synth_generic_call(node, env, ft, src, tt)
      if node_tag(node) == 41 { return check_expr(node, env, ft, src, caller_eff, tt) } else { 0 }
      -- A contextual generic reference is the same wrapper with an Ident
      -- rather than a Call. Taking the value is pure and has no call arity;
      -- only its instantiation and bounds need validating here.
      let call_node = node_f2(node)
      if node_tag(call_node) == 2 {
        typeck_record_symbol_use(tt, ft, env, src, node_f1(call_node), node_f2(call_node))
        let type_args = node_f1(node)
        let entry = ftypes_find(ft, src, node_f1(call_node), node_f2(call_node))
        let tparams = ftypes_entry_tparams(entry)
        errors = errors + check_public_arc_type_list(tt, src, node_f1(call_node), type_args)
        errors = errors + check_move_only_storage_type_list(tt, src, node_f1(call_node), type_args)
        if tparams == 0 {
          typeck_error_maybe(src, node_f1(call_node), "type error: generic target is not generic")
          errors = errors + 1
        } else {
          errors = errors + check_generic_type_arg_count(tparams, type_args, src, node_f1(call_node))
          errors = errors + check_trait_bounds_at(tparams, type_args, src, node_f1(call_node), node_f2(call_node), ftypes_entry_source(entry), tt, "generic function value")
        }
        let instantiated = synth_generic_call(node, env, ft, src, tt)
        if typeck_fn_type_has_open_structural_shape(instantiated) == 1 {
          typeck_error_maybe(src, node_f1(call_node), "type error: shape-polymorphic function cannot cross an opaque function-value boundary")
          errors = errors + 1
        } else { 0 }
        if ty_tag(instantiated) == 6 {
          errors = errors + check_native_result_abi_ty(src, node_f1(call_node), ty_f2(instantiated))
        } else { errors = errors }
      } else {
        typeck_record_generic_call_symbol_use(tt, ft, env, src, call_node)
        let call_args = generic_call_inner_args(call_node)
        let nargs = generic_call_inner_arg_count(call_node)
        -- Check arg expressions recursively
        for ai in 0..nargs {
          let arg = nlist_get(call_args, ai)
          if node_tag(arg) != 29 {
            errors = errors + check_expr(arg, env, ft, src, caller_eff, tt)
          } else { errors = errors }
        }
        errors = errors + check_generic_call_post_args(node, env, ft, src, caller_eff, tt)
      }
      errors
    }
    15 -> {
      -- Match: check scrutinee + all arm bodies with pattern bindings
      let scrutinee = node_f1(node)
      let arms_list = node_f2(node)
      let n_arms = node_f3(node)
      let destructuring_origin = match_destructuring_origin(node)
      errors = errors + check_expr(scrutinee, env, ft, src, caller_eff, tt)
      let scr_ty = synth(scrutinee, env, ft, src, tt)
      let mut pattern_errors = 0
      for mi in 0..n_arms {
        let arm = nlist_get(arms_list, mi)
        let pat = node_f1(arm)
        let body = node_f2(arm)
        let guard = node_f3(arm)
        let arm_pattern_errors = check_pattern(pat, typeck_match_pattern_scrutinee_type(pat, scr_ty), src, tt)
        pattern_errors = pattern_errors + arm_pattern_errors
        errors = errors + arm_pattern_errors
        let arm_env = bind_match_pattern(pat, env, src, scr_ty, tt)
        if guard != 0 {
          errors = errors + check_expr(guard, arm_env, ft, src, caller_eff, tt)
          errors = errors + check_bool_expr(guard, arm_env, ft, src, tt)
        } else { errors = errors }
        errors = errors + check_expr(body, arm_env, ft, src, caller_eff, tt)
        -- Calls in the guard/body have now produced their borrow-use facts.
        -- Enforce linear pattern bindings here, on the unconditional checker
        -- path, just like let bindings: a function need not expose a linear
        -- parameter or result merely because one arm extracts a resource.
        errors = errors + check_linear_pattern_bindings_usage(pat, arm_env, guard, body, src, tt)
      }
      errors = errors + check_match_arm_type_consistency(arms_list, n_arms, env, ft, src, scr_ty, tt)
      -- An ill-typed pattern has no valid matrix semantics.  Suppress the
      -- secondary usefulness/exhaustiveness pass so its recovery shape does
      -- not create cascading diagnostics.
      if destructuring_origin != 0 {
        if pattern_errors == 0 and n_arms == 1 {
          let bind_pattern_node = node_f1(nlist_get(arms_list, 0))
          if pattern_is_irrefutable_for_type(bind_pattern_node, scr_ty, src, tt) == 0 {
            if destructuring_origin == 1 {
              typeck_error_maybe(src, pattern_diag_pos(bind_pattern_node), "type error: refutable pattern in let binding; use if let or match")
            } else {
              typeck_error_maybe(src, pattern_diag_pos(bind_pattern_node), "type error: refutable pattern in for binding; use if let or match inside the loop")
            }
            errors = errors + 1
          } else { 0 }
        } else { 0 }
      } else { if pattern_errors == 0 {
        let matrix_ty = typeck_match_matrix_scrutinee_type(scr_ty)
        typeck_record_match_arm_facts(arms_list, n_arms, env, src, matrix_ty, tt)
        errors = errors + check_match_pattern_usefulness(arms_list, n_arms, matrix_ty, src, tt)
        errors = errors + check_match_exhaustive(arms_list, n_arms, src, matrix_ty, tt, expr_diag_pos(scrutinee), expr_diag_len(scrutinee))
      } else { errors = errors }
      }
      errors
    }
    29 -> check_lambda_standalone(node, env, ft, src, tt) + check_sendability_scoped_par_lambda(node, env, ft, src, tt)
    32 -> {
      -- Perform/dot-call: resolve method calls (synth mutates tag 32 → 41)
      -- and explicit indexed conversions (tag 32 → 36), then recurse into
      -- args so nested calls also get resolved.  Ordinary function bodies
      -- receive a whole-body synth pass, but generated test wrappers can
      -- reach this recursive path first; both must consume the same fact.
      synth_dot_call(node, env, ft, src, tt)
      let new_tag = node_tag(node)
      if new_tag == 36 {
        check_expr(node, env, ft, src, caller_eff, tt)
      } else { if new_tag == 41 {
        -- Resolved as method call: validate the receiver too. A nested call
        -- may already have been resolved while synthesizing this outer call;
        -- skipping f1 let its argument/effect diagnostics evade the walk.
        errors = errors + check_expr(node_f1(node), env, ft, src, caller_eff, tt)
        let ma = node_f3(node)
        let mn = nlist_len(ma)
        for mai in 0..mn {
          errors = errors + check_expr(nlist_get(ma, mai), env, ft, src, caller_eff, tt)
        }
        errors = errors + check_method_call(node, env, ft, src, caller_eff, tt)
        errors = errors + check_native_result_abi_ty(src, expr_diag_pos(node), synth_resolved_method_call(node, tt))
        errors
      } else { if typeck_qualified_call_declaration(node) != 0 {
        let qa = node_f4(node)
        for qai in 0..nlist_len(qa) {
          errors = errors + check_expr(nlist_get(qa, qai), env, ft, src, caller_eff, tt)
        }
        let qualified_entry = ftypes_find_decl(ft, typeck_qualified_call_declaration(node))
        if ftypes_entry_tparams(qualified_entry) != 0 and not call_entry_is_constructor(qualified_entry) and not call_params_cover_tparams(
          ftypes_entry_params(qualified_entry),
          ftypes_entry_tparams(qualified_entry)
        ) {
          typeck_error_maybe(src, node_f2(node), "type error: cannot infer generic call type arguments; write explicit type arguments")
          errors + 1
        } else {
          errors + check_qualified_call_declared(node, qualified_entry, env, ft, src, caller_eff, tt)
        }
      } else {
        -- Still tag 32: either a genuine effect perform, or a method call on
        -- a type-variable receiver that synth deliberately left unconverted
        -- (monomorphisation resolves it per specialisation).
        let lhs = node_f1(node)
        let unresolved_module = if node_tag(lhs) == 2 and tenv_lookup(env, src, node_f1(lhs), node_f2(lhs)) == 0 {
          module_scope_qualifier_is_module(tt, src, src, node_f1(lhs), node_f2(lhs))
        } else { 0 }
        if unresolved_module == 1 {
          let qa = node_f4(node)
          for qai in 0..nlist_len(qa) {
            errors = errors + check_expr(nlist_get(qa, qai), env, ft, src, caller_eff, tt)
          }
          errors + check_module_member_resolution(lhs, node_f2(node), node_f3(node), src, tt)
        } else {
        let recv_ty = if node_tag(lhs) == 2 { tenv_lookup(env, src, node_f1(lhs), node_f2(lhs)) } else { 0 }
        if recv_ty != 0 and ty_tag(recv_ty) == 12 {
          errors = errors + check_tyvar_method_call(node, env, ft, src, tt)
          let pa = node_f4(node)
          let pn = nlist_len(pa)
          for pai in 0..pn {
            errors = errors + check_expr(nlist_get(pa, pai), env, ft, src, caller_eff, tt)
          }
          errors
        } else { if ident_names_variant_type(lhs, env, src, tt) == 1 {
          -- Type.Variant(args): reject qualified construction outright —
          -- otherwise it lowers to an unhandled dynamic perform (BRK).
          typeck_error(src, node_f2(node), "type error: qualified constructor syntax is not supported; constructors are bare values")
          errors = errors + 1
          let pa = node_f4(node)
          let pn = nlist_len(pa)
          for pai in 0..pn {
            errors = errors + check_expr(nlist_get(pa, pai), env, ft, src, caller_eff, tt)
          }
          errors
        } else {
          -- Effect perform: recurse into perform args (f4 in tag 32)
          errors = errors + check_effect_perform_available(node, src, caller_eff, tt)
          errors = errors + check_effect_perform_args(node, env, ft, src, tt)
          typeck_record_effect_perform_facts(node, env, src, tt)
          errors = errors + check_native_result_abi_ty(src, node_f2(node), synth_effect_perform(node, src, tt))
          let pa = node_f4(node)
          let pn = nlist_len(pa)
          for pai in 0..pn {
            let arg = nlist_get(pa, pai)
            if node_tag(arg) != 29 {
              errors = errors + check_expr(arg, env, ft, src, caller_eff, tt)
            } else { errors = errors }
          }
          errors
        } }
        }
      } } }
    }
    41 -> {
      -- Already-resolved method call: recurse into receiver and args.
      errors = errors + check_expr(node_f1(node), env, ft, src, caller_eff, tt)
      let ma = node_f3(node)
      let mn = nlist_len(ma)
      for mai in 0..mn {
        errors = errors + check_expr(nlist_get(ma, mai), env, ft, src, caller_eff, tt)
      }
      errors = errors + check_method_call(node, env, ft, src, caller_eff, tt)
      errors = errors + check_native_result_abi_ty(src, expr_diag_pos(node), synth_resolved_method_call(node, tt))
      errors
    }
    35 -> {
      errors = errors + check_expr(node_f1(node), env, ft, src, caller_eff, tt)
      errors
    }
    46 -> {
      errors = errors + check_expr(node_f1(node), env, ft, src, caller_eff, tt)
      errors = errors + check_expr(node_f2(node), env, ft, src, caller_eff, tt)
      errors
    }
    45 -> {
      -- Try operator performs the exact Fail<E> selected by the Result's
      -- error type. Legacy one-argument Result-like nodes fall back to the
      -- sole in-scope Fail atom for compatibility.
      errors = errors + check_expr(node_f1(node), env, ft, src, caller_eff, tt)
      let error_ty = typeck_try_error_type(node, env, ft, src, tt)
      if error_ty == 0 and effect_sig_head_is_ambiguous(caller_eff, effect_fail_head_hash()) == 1 {
        typeck_error_maybe(src, expr_diag_pos(node_f1(node)), "type error: ambiguous Fail atom for ?; use Result<T, E>")
        errors = errors + 1
      } else { errors = errors }
      let atom = typeck_try_effect_atom(node, env, ft, src, tt, caller_eff)
      typeck_record_try_effect_atom(node, atom)
      errors = errors + check_effect_atom_available(
        atom, src, expr_diag_pos(node_f1(node)), expr_diag_len(node_f1(node)), caller_eff, tt,
        "? operator", DiagnosticLocationNone
      )
      errors
    }
    47 -> {
      -- For-iterator: check collection and body with the item bound.
      errors = errors + check_expr(node_f3(node), env, ft, src, caller_eff, tt)
      errors = errors + check_for_iter_collection(node, env, ft, src, tt)
      let item_ty = for_iter_item_type(node, env, ft, src, tt)
      let loop_env = tenv_bind_kind(env, src, node_f1(node), node_f2(node), item_ty, semantic_symbol_kind_loop())
      typeck_record_binding_fact(tt, src, node_f1(node), node_f2(node), item_ty, semantic_symbol_kind_loop(), loop_env)
      errors = errors + check_expr(node_f4(node), loop_env, ft, src, caller_eff, tt)
      errors
    }
    48 -> {
      -- Optional chaining performs Maybe.none when the base is nil.
      errors = errors + check_expr(node_f1(node), env, ft, src, caller_eff, tt)
      let atom = typeck_maybe_effect_atom(node)
      typeck_record_maybe_effect_atom(node, atom)
      errors = errors + check_effect_atom_available(
        atom, src, expr_diag_pos(node_f1(node)), expr_diag_len(node_f1(node)), caller_eff, tt,
        "optional chain", DiagnosticLocationNone
      )
      errors
    }
    49 -> {
      errors = errors + check_expr(node_f1(node), env, ft, src, caller_eff, tt)
      errors
    }
    52 -> {
      errors = errors + check_expr(node_f1(node), env, ft, src, caller_eff, tt)
      errors = errors + check_expr(node_f2(node), env, ft, src, caller_eff, tt)
      errors
    }
    55 -> check_address_of(node, env, ft, src, caller_eff, tt)
    56 -> check_deref(node, env, ft, src, caller_eff, tt)
    _ -> errors
  }
}

-- Check function call argument types against declared parameter types
pub(package) fn check_weak_ref_args(node: i64, env: i64, ft: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  if node_f4(node) != 1 {
    typeck_error_maybe(src, node_f1(node), "type error: arity mismatch")
    1
  } else {
    let arg = nlist_get(node_f3(node), 0)
    let arg_ty = synth(arg, env, ft, src, tt)
    if typeck_ty_is_weak_target(arg_ty) == 1 { 0 }
    else {
      typeck_error_maybe(src, expr_diag_pos(arg), "type error: weak_ref requires managed value")
      1
    }
  }
}

pub(package) fn check_weak_load_args(node: i64, env: i64, ft: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  if node_f4(node) != 1 {
    typeck_error_maybe(src, node_f1(node), "type error: arity mismatch")
    1
  } else {
    let arg = nlist_get(node_f3(node), 0)
    let arg_ty = synth(arg, env, ft, src, tt)
    if typeck_ty_is_weak_managed_ref(arg_ty) == 1 { 0 }
    else {
      typeck_error_maybe(src, expr_diag_pos(arg), "type error: weak_load requires weak managed reference")
      1
    }
  }
}

pub(package) fn region_scoped_arena_helper_name(src: i64, ns: i64, nl: i64) -> i64 {
  if src_eq(src, ns, nl, "with_scoped_arena_alloc") == 1 { 1 }
  else { src_eq(src, ns, nl, "with_scoped_arena_alloc_value") }
}

pub(package) fn region_alloc_effect_call_name(src: i64, ns: i64, nl: i64) -> i64 {
  if src_eq(src, ns, nl, "alloc_effect") == 1 { 1 }
  else { if src_eq(src, ns, nl, "alloc_effect_zeroed") == 1 { 1 }
  else { src_eq(src, ns, nl, "alloc_effect_words") } }
}

pub(package) fn region_promote_call_name(src: i64, ns: i64, nl: i64) -> i64 {
  src_eq(src, ns, nl, "region_promote_rc")
}

pub(package) fn region_local_memory_call_name(src: i64, ns: i64, nl: i64) -> i64 {
  if src_eq(src, ns, nl, "__mem_load64") == 1 { 1 }
  else { if src_eq(src, ns, nl, "mem_load64") == 1 { 1 }
  else { if src_eq(src, ns, nl, "__mem_load8") == 1 { 1 }
  else { if src_eq(src, ns, nl, "mem_load8") == 1 { 1 }
  else { if src_eq(src, ns, nl, "__mem_load_sized") == 1 { 1 }
  else { if src_eq(src, ns, nl, "mem_load_sized") == 1 { 1 }
  else { if src_eq(src, ns, nl, "__mem_store64") == 1 { 1 }
  else { if src_eq(src, ns, nl, "mem_store64") == 1 { 1 }
  else { if src_eq(src, ns, nl, "__mem_store8") == 1 { 1 }
  else { if src_eq(src, ns, nl, "mem_store8") == 1 { 1 }
  else { if src_eq(src, ns, nl, "__mem_store_sized") == 1 { 1 }
  else { if src_eq(src, ns, nl, "mem_store_sized") == 1 { 1 }
  else { if src_eq(src, ns, nl, "__atomic_lock64") == 1 { 1 }
  else { src_eq(src, ns, nl, "__atomic_unlock64") } } } } } } } } } } } } }
}

pub(package) fn region_alloc_perform(node: i64, src: i64) -> i64 {
  if node == 0 { 0 }
  else { if node_tag(node) != 32 { 0 }
  else {
    let lhs = node_f1(node)
    if node_tag(lhs) != 2 { 0 }
    else { if src_eq(src, node_f1(lhs), node_f2(lhs), "Alloc") != 1 { 0 }
    else { if src_eq(src, node_f2(node), node_f3(node), "alloc") == 1 { 1 } else { 0 } } }
  } }
}

pub(package) fn region_free_perform(node: i64, src: i64) -> i64 {
  if node == 0 { 0 }
  else { if node_tag(node) != 32 { 0 }
  else {
    let lhs = node_f1(node)
    if node_tag(lhs) != 2 { 0 }
    else { if src_eq(src, node_f1(lhs), node_f2(lhs), "Alloc") != 1 { 0 }
    else { if src_eq(src, node_f2(node), node_f3(node), "free") == 1 { 1 } else { 0 } } }
  } }
}

pub(package) fn region_expr_is_alloc_value(node: i64, src: i64) -> i64 {
  if node == 0 { 0 }
  else { if region_alloc_perform(node, src) == 1 { 1 }
  else { if node_tag(node) != 4 { 0 }
  else { region_alloc_effect_call_name(src, node_f1(node), node_f2(node)) } } }
}

pub(package) fn region_name_list_contains(names: i64, src: i64, ns: i64, nl: i64) -> bool {
  if names == 0 { false }
  else {
    let n = nlist_len(names)
    let mut i = 0
    let mut found = false
    while i < n {
      let entry = nlist_get(names, i)
      if node_f2(entry) == nl and src_eq_at(src, ns, src + node_f1(entry), 0, nl) == 1 {
        found = 1
        i = n
      } else { i = i + 1 }
    }
    found
  }
}

pub(package) fn region_name_list_copy(names: i64) -> i64 {
  let result = nlist_new()
  if names == 0 { result }
  else {
    let n = nlist_len(names)
    for i in 0..n {
      nlist_add(result, nlist_get(names, i))
    }
    result
  }
}

pub(package) fn region_name_list_bind(names: i64, ns: i64, nl: i64) -> i64 {
  let result = region_name_list_copy(names)
  nlist_add(result, node_new(0, ns, nl, 0, 0))
  result
}

pub(package) fn region_arg_list_mentions_region(args: i64, nargs: i64, names: i64, src: i64) -> bool {
  let mut i = 0
  let mut found = false
  while i < nargs {
    if region_expr_returns_region_value(nlist_get(args, i), names, src) == 1 {
      found = true
      i = nargs
    } else { i = i + 1 }
  }
  found
}

pub(package) fn region_arg_at_mentions_region(args: i64, nargs: i64, idx: i64, names: i64, src: i64) -> i64 {
  if idx < 0 { 0 }
  else { if idx >= nargs { 0 }
  else { region_expr_returns_region_value(nlist_get(args, idx), names, src) } }
}

pub(package) fn region_arg_range_mentions_region(args: i64, nargs: i64, start: i64, end: i64, names: i64, src: i64) -> bool {
  let mut i = start
  let mut found = false
  while i < end and i < nargs {
    if region_expr_returns_region_value(nlist_get(args, i), names, src) == 1 {
      found = 1
      i = end
    } else { i = i + 1 }
  }
  found
}

pub(package) fn region_record_fields_return_region(fields: i64, nfields: i64, names: i64, src: i64) -> bool {
  let mut i = 0
  let mut found = false
  while i < nfields {
    let field = nlist_get(fields, i)
    if region_expr_returns_region_value(node_f3(field), names, src) == 1 {
      found = 1
      i = nfields
    } else { i = i + 1 }
  }
  found
}

pub(package) fn region_handler_clauses_return_region(clauses: i64, nclauses: i64, names: i64, src: i64) -> bool {
  let mut i = 0
  let mut found = false
  while i < nclauses {
    let clause = nlist_get(clauses, i)
    if region_expr_returns_region_value(node_f3(clause), names, src) == 1 {
      found = true
      i = nclauses
    } else { i = i + 1 }
  }
  found
}

pub(package) fn region_names_nonempty(names: i64) -> i64 {
  if names == 0 { 0 } else { if nlist_len(names) > 0 { 1 } else { 0 } }
}

pub(package) fn region_deferred_handle_mentions_region(body: i64, names: i64, src: i64) -> i64 {
  if region_names_nonempty(names) == 1 { 1 }
  else { region_expr_mentions_region_name(body, names, src) }
}

pub(package) fn region_deferred_handle_region_escape(body: i64, clauses: i64, nclauses: i64, names: i64, src: i64) -> i64 {
  if region_deferred_handle_mentions_region(body, names, src) != 1 { 0 }
  else {
    let mut found = 0
    let mut i = 0
    while i < nclauses {
      let clause = nlist_get(clauses, i)
      if node_f4(clause) != 0 {
        found = 1
        i = nclauses
      } else { i = i + 1 }
    }
    found
  }
}

pub(package) fn region_lambda_captures_region(lambda: i64, names: i64, src: i64) -> i64 {
  if node_tag(lambda) != 29 { 0 }
  else { region_expr_mentions_region_name(node_f2(lambda), names, src) }
}

pub(package) fn region_expr_returns_region_value(node: i64, names: i64, src: i64) -> bool {
  if node == 0 { false }
  else { if node_tag(node) == 4 and region_promote_call_name(src, node_f1(node), node_f2(node)) == 1 { false }
  else { if region_expr_is_alloc_value(node, src) == 1 { true }
  else {
    match node_tag(node) {
      2 -> region_name_list_contains(names, src, node_f1(node), node_f2(node))
      5 -> {
        let else_node = node_f3(node)
        region_expr_returns_region_value(node_f2(node), names, src) or
        if else_node == 0 { false } else { region_expr_returns_region_value(else_node, names, src) }
      }
      6 -> {
        let next_names = if region_expr_returns_region_value(node_f3(node), names, src) == 1 {
          region_name_list_bind(names, node_f1(node), node_f2(node))
        } else { names }
        region_expr_returns_region_value(node_f4(node), next_names, src)
      }
      11 -> {
        let next_names = if region_expr_returns_region_value(node_f3(node), names, src) == 1 {
          region_name_list_bind(names, node_f1(node), node_f2(node))
        } else { names }
        region_expr_returns_region_value(node_f4(node), next_names, src)
      }
      37 -> {
        let inner = node_f1(node)
        let next_names = if region_expr_returns_region_value(node_f3(inner), names, src) == 1 {
          region_name_list_bind(names, node_f1(inner), node_f2(inner))
        } else { names }
        region_expr_returns_region_value(node_f4(inner), next_names, src)
      }
      7 -> region_expr_returns_region_value(node_f2(node), names, src)
      14 -> region_record_fields_return_region(node_f3(node), node_f4(node), names, src)
      63 -> region_expr_returns_region_value(node_f1(node), names, src) or region_record_fields_return_region(node_f2(node), node_f3(node), names, src)
      58 -> region_arg_list_mentions_region(node_f1(node), node_f2(node), names, src)
      15 -> {
        let arms = node_f2(node)
        let n = node_f3(node)
        let mut i = 0
        let mut found = false
        while i < n {
          let arm = nlist_get(arms, i)
          if region_expr_returns_region_value(node_f2(arm), names, src) == 1 {
            found = 1
            i = n
          } else { i = i + 1 }
        }
        found
      }
      26 -> if node_f1(node) == 0 { false } else { region_expr_returns_region_value(node_f1(node), names, src) }
      33 -> {
        region_expr_returns_region_value(node_f1(node), names, src) or
        region_handler_clauses_return_region(node_f2(node), node_f3(node), names, src)
      }
      35 -> region_expr_returns_region_value(node_f1(node), names, src)
      _ -> false
    }
  } } }
}

pub(package) fn region_expr_mentions_region_name(node: i64, names: i64, src: i64) -> bool {
  if node == 0 { false }
  else { if region_expr_returns_region_value(node, names, src) == 1 { true }
  else {
    match node_tag(node) {
      3 -> region_expr_mentions_region_name(node_f2(node), names, src) or region_expr_mentions_region_name(node_f3(node), names, src)
      4 -> region_arg_list_mentions_region(node_f3(node), node_f4(node), names, src)
      5 -> region_expr_mentions_region_name(node_f1(node), names, src) or region_expr_mentions_region_name(node_f2(node), names, src) or region_expr_mentions_region_name(node_f3(node), names, src)
      6 -> {
        let next_names = if region_expr_returns_region_value(node_f3(node), names, src) == 1 {
          region_name_list_bind(names, node_f1(node), node_f2(node))
        } else { names }
        region_expr_mentions_region_name(node_f3(node), names, src) or region_expr_mentions_region_name(node_f4(node), next_names, src)
      }
      7 -> region_expr_mentions_region_name(node_f1(node), names, src) or region_expr_mentions_region_name(node_f2(node), names, src)
      10 -> region_expr_mentions_region_name(node_f1(node), names, src) or region_expr_mentions_region_name(node_f2(node), names, src)
      11 -> {
        let next_names = if region_expr_returns_region_value(node_f3(node), names, src) == 1 {
          region_name_list_bind(names, node_f1(node), node_f2(node))
        } else { names }
        region_expr_mentions_region_name(node_f3(node), names, src) or region_expr_mentions_region_name(node_f4(node), next_names, src)
      }
      12 -> region_expr_mentions_region_name(node_f3(node), names, src)
      13 -> region_expr_mentions_region_name(node_f1(node), names, src)
      59 -> region_expr_mentions_region_name(node_f1(node), names, src)
      60 -> region_expr_mentions_region_name(node_f1(node), names, src) or region_expr_mentions_region_name(node_f2(node), names, src)
      61 -> region_expr_mentions_region_name(node_f1(node), names, src) or region_expr_mentions_region_name(node_f2(node), names, src) or region_expr_mentions_region_name(node_f3(node), names, src)
      62 -> region_expr_mentions_region_name(node_f1(node), names, src) or region_expr_mentions_region_name(node_f2(node), names, src) or region_expr_mentions_region_name(node_f3(node), names, src)
      14 -> region_record_fields_return_region(node_f3(node), node_f4(node), names, src)
      63 -> region_expr_mentions_region_name(node_f1(node), names, src) or region_record_fields_return_region(node_f2(node), node_f3(node), names, src)
      58 -> region_arg_list_mentions_region(node_f1(node), node_f2(node), names, src)
      15 -> {
        let mut found = region_expr_mentions_region_name(node_f1(node), names, src)
        let arms = node_f2(node)
        let n = node_f3(node)
        let mut i = 0
        while i < n {
          let arm = nlist_get(arms, i)
          if region_expr_mentions_region_name(node_f2(arm), names, src) == 1 or region_expr_mentions_region_name(node_f3(arm), names, src) == 1 {
            found = 1
            i = n
          } else { i = i + 1 }
        }
        found
      }
      22 -> region_expr_mentions_region_name(node_f1(node), names, src)
      25 -> region_expr_mentions_region_name(node_f1(node), names, src)
      26 -> if node_f1(node) == 0 { false } else { region_expr_mentions_region_name(node_f1(node), names, src) }
      29 -> region_expr_mentions_region_name(node_f2(node), names, src)
      32 -> region_expr_mentions_region_name(node_f1(node), names, src) or region_arg_list_mentions_region(node_f4(node), nlist_len(node_f4(node)), names, src)
      33 -> {
        let mut found = region_expr_mentions_region_name(node_f1(node), names, src)
        let clauses = node_f2(node)
        let nclauses = node_f3(node)
        let mut ci = 0
        while ci < nclauses {
          if region_expr_mentions_region_name(node_f3(nlist_get(clauses, ci)), names, src) == 1 {
            found = 1
            ci = nclauses
          } else { ci = ci + 1 }
        }
        found
      }
      35 -> region_expr_mentions_region_name(node_f1(node), names, src)
      36 -> {
        -- Generic-call arguments may themselves be closures. A returns-only
        -- walk misses a region value captured inside such a closure (notably
        -- par.fork<T>(() => region_value)); recurse through every argument.
        let call_node = node_f2(node)
        let args = generic_call_inner_args(call_node)
        let nargs = generic_call_inner_arg_count(call_node)
        let mut found = false
        let mut i = 0
        while i < nargs and found == false {
          if region_expr_mentions_region_name(nlist_get(args, i), names, src) == 1 {
            found = true
          } else { i = i + 1 }
        }
        found
      }
      37 -> {
        let inner = node_f1(node)
        let next_names = if region_expr_returns_region_value(node_f3(inner), names, src) == 1 {
          region_name_list_bind(names, node_f1(inner), node_f2(inner))
        } else { names }
        region_expr_mentions_region_name(node_f3(inner), names, src) or region_expr_mentions_region_name(node_f4(inner), next_names, src)
      }
      41 -> region_arg_list_mentions_region(node_f3(node), nlist_len(node_f3(node)), names, src)
      45 -> region_expr_mentions_region_name(node_f1(node), names, src)
      46 -> region_expr_mentions_region_name(node_f1(node), names, src) or region_expr_mentions_region_name(node_f2(node), names, src)
      47 -> region_expr_mentions_region_name(node_f3(node), names, src) or region_expr_mentions_region_name(node_f4(node), names, src)
      48 -> region_expr_mentions_region_name(node_f1(node), names, src)
      49 -> region_expr_mentions_region_name(node_f1(node), names, src)
      52 -> region_expr_mentions_region_name(node_f1(node), names, src) or region_expr_mentions_region_name(node_f2(node), names, src)
      _ -> false
    }
  } }
}

pub(package) fn region_store_value_escapes(args: i64, nargs: i64, value_idx: i64, names: i64, src: i64) -> bool {
  if region_arg_at_mentions_region(args, nargs, value_idx, names, src) != 1 { false }
  else { if region_arg_at_mentions_region(args, nargs, 0, names, src) == 1 { false } else { true } }
}

pub(package) fn region_memory_call_region_arg_escape(node: i64, names: i64, src: i64) -> i64 {
  let args = node_f3(node)
  let nargs = node_f4(node)
  if src_eq(src, node_f1(node), node_f2(node), "__mem_load64") == 1 or src_eq(src, node_f1(node), node_f2(node), "mem_load64") == 1 {
    region_arg_range_mentions_region(args, nargs, 1, nargs, names, src)
  } else { if src_eq(src, node_f1(node), node_f2(node), "__mem_load8") == 1 or src_eq(src, node_f1(node), node_f2(node), "mem_load8") == 1 {
    region_arg_range_mentions_region(args, nargs, 1, nargs, names, src)
  } else { if src_eq(src, node_f1(node), node_f2(node), "__mem_load_sized") == 1 or src_eq(src, node_f1(node), node_f2(node), "mem_load_sized") == 1 {
    region_arg_range_mentions_region(args, nargs, 1, nargs, names, src)
  } else { if src_eq(src, node_f1(node), node_f2(node), "__mem_store64") == 1 or src_eq(src, node_f1(node), node_f2(node), "mem_store64") == 1 {
    region_store_value_escapes(args, nargs, 1, names, src)
  } else { if src_eq(src, node_f1(node), node_f2(node), "__mem_store8") == 1 or src_eq(src, node_f1(node), node_f2(node), "mem_store8") == 1 {
    region_store_value_escapes(args, nargs, 1, names, src)
  } else { if src_eq(src, node_f1(node), node_f2(node), "__mem_store_sized") == 1 or src_eq(src, node_f1(node), node_f2(node), "mem_store_sized") == 1 {
    region_arg_range_mentions_region(args, nargs, 1, 3, names, src) or
    region_store_value_escapes(args, nargs, 3, names, src)
  } else { 0 } } } } } }
}

pub(package) fn region_promote_call_region_arg_escape(node: i64, names: i64, src: i64) -> i64 {
  let args = node_f3(node)
  let nargs = node_f4(node)
  region_arg_range_mentions_region(args, nargs, 1, nargs, names, src)
}

pub(package) fn region_free_perform_region_arg_escape(node: i64, names: i64, src: i64) -> i64 {
  let args = node_f4(node)
  let nargs = nlist_len(args)
  region_arg_range_mentions_region(args, nargs, 1, nargs, names, src)
}

pub(package) fn region_call_region_arg_escape(node: i64, names: i64, src: i64) -> i64 {
  if node_tag(node) == 4 {
    if region_promote_call_name(src, node_f1(node), node_f2(node)) == 1 {
      region_promote_call_region_arg_escape(node, names, src)
    } else { if region_local_memory_call_name(src, node_f1(node), node_f2(node)) == 1 {
      region_memory_call_region_arg_escape(node, names, src)
    } else { region_arg_list_mentions_region(node_f3(node), node_f4(node), names, src) } }
  } else { if region_free_perform(node, src) == 1 {
    region_free_perform_region_arg_escape(node, names, src)
  } else { region_arg_list_mentions_region(node_f4(node), nlist_len(node_f4(node)), names, src) } }
}

pub(package) fn check_region_escape_error(src: i64, pos: i64) -[Diagnose]> i64 {
  typeck_error_maybe(src, pos, "type error: region value cannot escape scoped arena")
  1
}

pub(package) fn check_region_body(node: i64, names: i64, src: i64, result_pos: i64) -[Diagnose]> i64 {
  if node == 0 { 0 }
  else {
    let mut errors = 0
    if result_pos == 1 and region_expr_returns_region_value(node, names, src) == 1 {
      errors = errors + check_region_escape_error(src, expr_diag_pos(node))
    } else { errors = errors }
    match node_tag(node) {
      3 -> check_region_body(node_f2(node), names, src, 0) + check_region_body(node_f3(node), names, src, 0) + errors
      4 -> {
        let args = node_f3(node)
        let nargs = node_f4(node)
        if region_call_region_arg_escape(node, names, src) == 1 {
          errors = errors + check_region_escape_error(src, node_f1(node))
        } else { errors = errors }
        let mut i = 0
        while i < nargs {
          errors = errors + check_region_body(nlist_get(args, i), names, src, 0)
          i = i + 1
        }
        errors
      }
      5 -> check_region_body(node_f1(node), names, src, 0) + check_region_body(node_f2(node), names, src, result_pos) + check_region_body(node_f3(node), names, src, result_pos) + errors
      6 -> {
        let val = node_f3(node)
        let body = node_f4(node)
        let next_names = if region_expr_returns_region_value(val, names, src) == 1 {
          region_name_list_bind(names, node_f1(node), node_f2(node))
        } else { names }
        errors + check_region_body(val, names, src, 0) + check_region_body(body, next_names, src, result_pos)
      }
      7 -> errors + check_region_body(node_f1(node), names, src, 0) + check_region_body(node_f2(node), names, src, result_pos)
      10 -> errors + check_region_body(node_f1(node), names, src, 0) + check_region_body(node_f2(node), names, src, 0)
      11 -> {
        let val = node_f3(node)
        let body = node_f4(node)
        let next_names = if region_expr_returns_region_value(val, names, src) == 1 {
          region_name_list_bind(names, node_f1(node), node_f2(node))
        } else { names }
        errors + check_region_body(val, names, src, 0) + check_region_body(body, next_names, src, result_pos)
      }
      12 -> errors + check_region_body(node_f3(node), names, src, 0)
      13 -> errors + check_region_body(node_f1(node), names, src, 0)
      59 -> errors + check_region_body(node_f1(node), names, src, 0)
      60 -> errors + check_region_body(node_f1(node), names, src, 0) + check_region_body(node_f2(node), names, src, 0)
      61 -> errors + check_region_body(node_f1(node), names, src, 0) + check_region_body(node_f2(node), names, src, 0) + check_region_body(node_f3(node), names, src, 0)
      62 -> errors + check_region_body(node_f1(node), names, src, 0) + check_region_body(node_f2(node), names, src, 0) + check_region_body(node_f3(node), names, src, 0)
      14 -> {
        if region_record_fields_return_region(node_f3(node), node_f4(node), names, src) == 1 {
          errors = errors + check_region_escape_error(src, expr_diag_pos(node))
        } else { errors = errors }
        let fields = node_f3(node)
        let nfields = node_f4(node)
        for ri in 0..nfields {
          let field = nlist_get(fields, ri)
          errors = errors + check_region_body(node_f3(field), names, src, 0)
        }
        errors
      }
      63 -> {
        errors = errors + check_region_body(node_f1(node), names, src, 0)
        let fields = node_f2(node)
        for ri in 0..node_f3(node) {
          errors = errors + check_region_body(node_f3(nlist_get(fields, ri)), names, src, 0)
        }
        errors
      }
      58 -> {
        if region_arg_list_mentions_region(node_f1(node), node_f2(node), names, src) == 1 {
          errors = errors + check_region_escape_error(src, expr_diag_pos(node))
        } else { errors = errors }
        for ai in 0..node_f2(node) {
          errors = errors + check_region_body(nlist_get(node_f1(node), ai), names, src, 0)
        }
        errors
      }
      15 -> {
        errors = errors + check_region_body(node_f1(node), names, src, 0)
        let arms = node_f2(node)
        let n = node_f3(node)
        for i in 0..n {
          let arm = nlist_get(arms, i)
          errors = errors + check_region_body(node_f3(arm), names, src, 0)
          errors = errors + check_region_body(node_f2(arm), names, src, result_pos)
        }
        errors
      }
      22 -> errors + check_region_body(node_f1(node), names, src, 0)
      25 -> {
        if region_expr_returns_region_value(node_f1(node), names, src) == 1 {
          errors + check_region_escape_error(src, expr_diag_pos(node_f1(node)))
        } else { errors + check_region_body(node_f1(node), names, src, 0) }
      }
      26 -> {
        let val = node_f1(node)
        if val != 0 and region_expr_returns_region_value(val, names, src) == 1 {
          errors + check_region_escape_error(src, expr_diag_pos(val))
        } else { errors + check_region_body(val, names, src, 0) }
      }
      29 -> {
        if region_lambda_captures_region(node, names, src) == 1 {
          errors + check_region_escape_error(src, expr_diag_pos(node))
        } else { errors }
      }
      32 -> {
        if region_call_region_arg_escape(node, names, src) == 1 {
          errors = errors + check_region_escape_error(src, expr_diag_pos(node))
        } else { errors = errors }
        let args = node_f4(node)
        let nargs = nlist_len(args)
        for pai in 0..nargs {
          errors = errors + check_region_body(nlist_get(args, pai), names, src, 0)
        }
        errors + check_region_body(node_f1(node), names, src, 0)
      }
      33 -> {
        if region_deferred_handle_region_escape(node_f1(node), node_f2(node), node_f3(node), names, src) == 1 {
          errors = errors + check_region_escape_error(src, expr_diag_pos(node))
        } else { errors = errors }
        errors = errors + check_region_body(node_f1(node), names, src, result_pos)
        let clauses = node_f2(node)
        let nclauses = node_f3(node)
        for hci in 0..nclauses {
          let clause = nlist_get(clauses, hci)
          errors = errors + check_region_body(node_f3(clause), names, src, result_pos)
        }
        errors
      }
      35 -> {
        let val = node_f1(node)
        if region_expr_returns_region_value(val, names, src) == 1 {
          errors + check_region_escape_error(src, expr_diag_pos(val))
        } else { errors + check_region_body(val, names, src, 0) }
      }
      36 -> {
        let call_node = node_f2(node)
        let args = generic_call_inner_args(call_node)
        let nargs = generic_call_inner_arg_count(call_node)
        if region_arg_list_mentions_region(args, nargs, names, src) == 1 {
          errors = errors + check_region_escape_error(src, node_f1(call_node))
        } else { errors = errors }
        for gi in 0..nargs {
          errors = errors + check_region_body(nlist_get(args, gi), names, src, 0)
        }
        errors
      }
      37 -> {
        let inner = node_f1(node)
        let val = node_f3(inner)
        let body = node_f4(inner)
        let next_names = if region_expr_returns_region_value(val, names, src) == 1 {
          region_name_list_bind(names, node_f1(inner), node_f2(inner))
        } else { names }
        errors + check_region_body(val, names, src, 0) + check_region_body(body, next_names, src, result_pos)
      }
      41 -> {
        let args = node_f3(node)
        let nargs = nlist_len(args)
        if region_arg_list_mentions_region(args, nargs, names, src) == 1 {
          errors = errors + check_region_escape_error(src, expr_diag_pos(node))
        } else { errors = errors }
        for mi in 0..nargs {
          errors = errors + check_region_body(nlist_get(args, mi), names, src, 0)
        }
        errors
      }
      45 -> errors + check_region_body(node_f1(node), names, src, 0)
      46 -> errors + check_region_body(node_f1(node), names, src, 0) + check_region_body(node_f2(node), names, src, 0)
      47 -> errors + check_region_body(node_f3(node), names, src, 0) + check_region_body(node_f4(node), names, src, 0)
      48 -> errors + check_region_body(node_f1(node), names, src, 0)
      49 -> errors + check_region_body(node_f1(node), names, src, 0)
      52 -> errors + check_region_body(node_f1(node), names, src, 0) + check_region_body(node_f2(node), names, src, 0)
      _ -> errors
    }
  }
}

pub(package) fn check_scoped_region_helper(node: i64, src: i64) -[Diagnose]> i64 {
  let call_node = if node_tag(node) == 36 { node_f2(node) } else { node }
  if node_tag(call_node) != 4 { 0 }
  else { if region_scoped_arena_helper_name(src, node_f1(call_node), node_f2(call_node)) != 1 { 0 }
  else { if node_f4(call_node) != 2 { 0 }
  else {
    let args = node_f3(call_node)
    let lambda = nlist_get(args, 1)
    if node_tag(lambda) != 29 { 0 }
    else { if node_f3(lambda) != 0 { 0 }
    else { check_region_body(node_f2(lambda), nlist_new(), src, 1) } }
  } } }
}

pub(package) fn check_call_args(node: i64, env: i64, ft: i64, src: i64, caller_eff: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let call_ns = node_f1(node)
  let call_nl = node_f2(node)
  if weak_ref_name(src, call_ns, call_nl) == 1 { check_weak_ref_args(node, env, ft, src, tt) }
  else { if weak_load_name(src, call_ns, call_nl) == 1 { check_weak_load_args(node, env, ft, src, tt) }
  else { if call_nl >= 2 {
    if mem_load8_at(src, call_ns) == 95 {
      if mem_load8_at(src, call_ns + 1) == 95 { check_intrinsic_args(node, env, ft, src, tt) }
      else { check_call_args_inner(node, env, ft, src, caller_eff, tt) }
    } else { check_call_args_inner(node, env, ft, src, caller_eff, tt) }
  } else { check_call_args_inner(node, env, ft, src, caller_eff, tt) }
  } }
}

-- Generator construction consumes semantic producer facts. Contextually or
-- independently checked zero-argument lambdas carry the fact in their stable
-- metadata; immutable local bindings preserve that definition fact; named
-- functions use the function catalog's checked parameter signature.
pub(package) fn check_generator_producer_supported(arg: i64, env: i64, ft: i64, src: i64) -> i64 {
  match node_tag(arg) {
    29 -> lambda_ast_generator_producer(node_f4(arg))
    2 -> {
      let local_ty = tenv_lookup(env, src, node_f1(arg), node_f2(arg))
      if local_ty != 0 {
        let origin = tenv_lookup_value(env, src, node_f1(arg), node_f2(arg))
        if origin == 0 { 0 }
        else { if node_tag(origin) != 29 { 0 }
        else { if lambda_ast_generator_producer(node_f4(origin)) != 1 { 0 }
        else { if ty_tag(local_ty) != 6 { 0 }
        else { if nlist_len(ty_f1(local_ty)) == 0 { 1 } else { 0 } } } } }
      } else {
        let params = ftypes_lookup_params(ft, src, node_f1(arg), node_f2(arg))
        if params != 0 and nlist_len(params) == 0 { 1 } else { 0 }
      }
    }
    _ -> 0
  }
}

pub(package) fn check_generator_start_shape(node: i64, entry: i64, env: i64, ft: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  if node_tag(node) != 36 { 0 }
  else {
    let call_node = node_f2(node)
    let qualified_declaration = if node_tag(call_node) != 32 { 0 }
      else {
        let existing = typeck_qualified_call_declaration(call_node)
        if existing != 0 { existing }
        else {
          let access = node_new(13, node_f1(call_node), node_f2(call_node), node_f3(call_node), 0)
          typeck_resolve_module_member_access(access, env, src, tt)
        }
      }
    let declaration = if qualified_declaration != 0 { qualified_declaration } else { ftypes_entry_decl_fact(entry) }
    let is_generator_start = typeck_decl_identity_is(declaration, "stdlib/generator", "start") == 1
    if not is_generator_start { 0 }
    else { if generic_call_inner_arg_count(call_node) != 1 { 0 }
    else { if nlist_len(node_f1(node)) != 2 { 0 }
    else {
      let arg = nlist_get(generic_call_inner_args(call_node), 0)
      if check_generator_producer_supported(arg, env, ft, src) == 1 { 0 }
      else {
        typeck_error(src, generic_call_inner_name_start(call_node), "type error: generator producer must be literal zero-arg lambda, known zero-arg function, or known zero-arg closure")
        1
      }
    } } }
  }
}

pub(package) fn check_vector_to_array_type_args(src: i64, ns: i64, nl: i64, type_args: i64) -[Diagnose]> i64 {
  if src_eq(src, ns, nl, "to_array") != 1 { 0 }
  else { if type_args == 0 or nlist_len(type_args) != 2 { 0 }
  else {
    let element_ty = nlist_get(type_args, 0)
    let array_ty = nlist_get(type_args, 1)
    if not ty_is_array(array_ty) or not ty_eq(ty_array_inner(array_ty), element_ty) {
      typeck_error_maybe(src, ns, "type error: to_array result type must be [T; N]")
      1
    } else { if ty_array_length(array_ty) < 0 {
      typeck_error_maybe(src, ns, "type error: to_array length must be a non-negative integer literal")
      1
    } else { 0 } }
  } }
}

-- Everything the GenericCall (tag 36) arm checks EXCEPT recursing into
-- the argument expressions: type-arg count, trait bounds, arity,
-- substituted param checks, effect availability. Shared by the tag-36
-- check_expr arm and the bare-generic-call inference path in
-- check_call_args_inner (whose caller already recursed into the args).
pub(package) fn check_generic_call_post_args(node: i64, env: i64, ft: i64, src: i64, caller_eff: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let type_args = node_f1(node)
  let call_node = node_f2(node)
  let call_args = generic_call_inner_args(call_node)
  let nargs = generic_call_inner_arg_count(call_node)
  let ns = generic_call_inner_name_start(call_node)
  let nl = generic_call_inner_name_len(call_node)
  let entry = generic_call_ftypes_entry(call_node, env, ft, src, tt)
  let mut errors = check_public_arc_type_list(tt, src, ns, type_args)
  errors = errors + check_move_only_storage_type_list(tt, src, ns, type_args)
  errors = errors + check_internal_par_prepared_call_sealed(tt, call_node, src)
  -- Check arg types against substituted param types
  let tparams = ftypes_entry_tparams(entry)
  let params = ftypes_entry_params(entry)
  let ntparams = if tparams == 0 { 0 } else { nlist_len(tparams) }
  let nparams = if params == 0 { 0 } else { nlist_len(params) }
  let has_shape_suffix = if params != 0 and typeck_params_have_structural_shape(params) == 1 and nlist_len(type_args) == ntparams + nparams { 1 } else { 0 }
  if tparams != 0 {
    if has_shape_suffix == 0 { errors = errors + check_generic_type_arg_count(tparams, type_args, src, ns) } else { 0 }
    errors = errors + check_vector_to_array_type_args(src, ns, nl, type_args)
    if params != 0 {
      errors = errors + check_arity(nlist_len(params), nargs, src, ns)
      let s = build_subst(tparams, type_args)
      -- Check trait bounds on type parameters
      errors = errors + check_trait_bounds_at(tparams, type_args, src, ns, nl, ftypes_entry_source(entry), tt, "generic argument")
      for pi in 0..nargs {
        if pi < nlist_len(params) {
          let param = nlist_get(params, pi)
          let param_ty = node_f3(param)
          if param_ty != 0 {
            let subst_ty = typeck_subst_resolve_associated_type(param_ty, tparams, s, tt)
            errors = errors + check_arg_against_direct_param_mode_at(
              nlist_get(call_args, pi), subst_ty, env, ft, src, tt, ns, 0,
              typeck_source_location(ftypes_entry_source(entry), node_f1(param), node_f2(param))
            )
          } else { errors = errors }
        } else { errors = errors }
      }
      errors = errors + check_borrow_call_conflicts(call_args, nargs, src, ns)
      if has_shape_suffix == 0 {
        let exact_shapes = typeck_call_shape_type_args(call_args, nargs, params, s, env, ft, src, tt)
        if typeck_append_shape_type_args(type_args, exact_shapes) == 1 {
          mem_store64_at(node, 24, nlist_len(type_args))
        } else { 0 }
      } else { 0 }
    } else { 0 }
  } else { if has_shape_suffix == 1 {
    errors = errors + check_arity(nparams, nargs, src, ns)
    for pi in 0..nargs {
      if pi < nparams {
        let param = nlist_get(params, pi)
        let param_ty = node_f3(param)
        if param_ty != 0 {
          errors = errors + check_arg_against_direct_param_mode_at(
            nlist_get(call_args, pi), param_ty, env, ft, src, tt, ns, 0,
            typeck_source_location(ftypes_entry_source(entry), node_f1(param), node_f2(param))
          )
        } else { 0 }
      } else { 0 }
    }
    errors = errors + check_borrow_call_conflicts(call_args, nargs, src, ns)
  } else {
    if node_tag(call_node) == 32 {
      errors = errors + check_qualified_call_declared(call_node, entry, env, ft, src, caller_eff, tt)
    } else {
      errors = errors + check_generic_call_target_defined(call_node, env, ft, src, tt)
      errors = errors + check_call_args(call_node, env, ft, src, caller_eff, tt)
    }
  } }
  -- General argument checking above establishes the lambda/function facts
  -- consumed by the generator producer restriction. Qualified generic calls
  -- reach this common post-check even when their catalog lookup is deferred.
  errors = errors + check_generator_start_shape(node, entry, env, ft, src, tt)
  -- Effect checking for generic calls: substitute the call's type args into
  -- the callee's parameterized effect signature first, so -[Box<T>]> charges the
  -- instantiated atom (Box<str>), not Box<TypeVar>.
  let callee_eff_raw = ftypes_entry_effects(entry)
  let callee_eff = if callee_eff_raw > 0 and tparams != 0 {
    ty_subst(callee_eff_raw, build_subst(tparams, type_args))
  } else { callee_eff_raw }
  errors = errors + check_effect_sig_available(
    callee_eff, src, ns, nl, caller_eff, tt, "call",
    if entry == 0 { DiagnosticLocationNone }
    else { typeck_source_location(ftypes_entry_source(entry), ftypes_entry_name_start(entry), ftypes_entry_name_len(entry)) }
  )
  let instantiated = synth_generic_call(node, env, ft, src, tt)
  let result_ty = if node_tag(call_node) == 2 and ty_tag(instantiated) == 6 { ty_f2(instantiated) } else { instantiated }
  errors = errors + check_native_result_abi_ty(src, ns, result_ty)
  errors = errors + check_scoped_region_helper(node, src)
  errors = errors + check_task_concurrency_boundary(node, entry, env, ft, src, tt)
  errors
}

pub(package) fn ty_mentions_type_var(ty: i64) -> i64 {
  if ty == 0 { 0 }
  else {
    let tag = ty_tag(ty)
    if tag == 12 { 1 }
    else { if tag == 9 { ty_list_mentions_type_var(ty_f3(ty)) }
    else { if tag == 3 or tag == 4 {
      if ty_mentions_type_var(ty_f1(ty)) == 1 { 1 } else { ty_mentions_type_var(ty_f2(ty)) }
    }
    else { if tag == 6 {
      if ty_list_mentions_type_var(ty_f1(ty)) == 1 { 1 } else { ty_mentions_type_var(ty_f2(ty)) }
    }
    else { if tag == 7 { ty_record_fields_mention_type_var(ty_record_fields(ty)) }
    else { if tag == 21 { ty_mentions_type_var(ty_f1(ty)) }
    else { if tag == 5 or tag == 15 or tag == 16 or tag == 17 or tag == 18 or tag == 19 or tag == 22 or tag == 23 or tag == 29 {
      ty_mentions_type_var(ty_f1(ty))
    }
    else { 0 } } } } } } }
  }
}

pub(package) fn ty_record_fields_mention_type_var(fields: i64) -> i64 {
  let mut found = 0
  if fields != 0 {
    for i in 0..nlist_len(fields) {
      if ty_mentions_type_var(ty_record_field_type(nlist_get(fields, i))) == 1 { found = 1 } else { 0 }
    }
  } else { 0 }
  found
}

pub(package) fn ty_list_mentions_type_var(types: i64) -> i64 {
  if types == 0 { 0 }
  else {
    let n = nlist_len(types)
    let mut found = 0
    for i in 0..n {
      if found == 0 and ty_mentions_type_var(nlist_get(types, i)) == 1 { found = 1 } else { 0 }
    }
    found
  }
}

pub(package) fn typeck_params_have_open_structural_shape(params: i64) -> i64 {
  if params == 0 { 0 }
  else {
    let mut found = 0
    for i in 0..nlist_len(params) {
      let param_ty = node_f3(nlist_get(params, i))
      if ty_is_record(param_ty) and ty_record_open(param_ty) == 1 { found = 1 } else { 0 }
    }
    found
  }
}

pub(package) fn typeck_params_have_structural_shape(params: i64) -> i64 {
  if params == 0 { 0 }
  else {
    let mut found = 0
    for i in 0..nlist_len(params) {
      if ty_is_record(node_f3(nlist_get(params, i))) { found = 1 } else { 0 }
    }
    found
  }
}

pub(package) fn typeck_fn_type_has_open_structural_shape(fn_ty: i64) -> i64 {
  if fn_ty == 0 or ty_tag(fn_ty) != 6 { 0 }
  else {
    let params = ty_f1(fn_ty)
    let mut found = 0
    for i in 0..nlist_len(params) {
      let param_ty = nlist_get(params, i)
      if ty_is_record(param_ty) and ty_record_open(param_ty) == 1 { found = 1 } else { 0 }
    }
    found
  }
}

pub(package) fn check_call_args_inner(node: i64, env: i64, ft: i64, src: i64, caller_eff: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let ns = node_f1(node)
  let nl = node_f2(node)
  let args = node_f3(node)
  let nargs = node_f4(node)
  let local_ty = tenv_lookup(env, src, ns, nl)
  if local_ty != 0 {
    if ty_tag(local_ty) == 6 { check_call_fn_type(node, local_ty, env, ft, src, caller_eff, tt) }
    else { if ty_tag(local_ty) == 14 { check_call_continuation_type(node, local_ty, env, ft, src, tt) }
    else { 0 }
    }
  } else {
    let callee_entry = ftypes_find(ft, src, ns, nl)
    let params = ftypes_entry_params(callee_entry)
    if params == 0 { 0 }
  else { if ftypes_entry_tparams(callee_entry) != 0 and node_tag(node) == 4 {
    -- Bare call to a generic callee. Synthesis solves type args from the
    -- arguments and rewrites the node to an explicit GenericCall; args were
    -- already recursed by the tag-4 arm, so only the post-args checks run
    -- here. Reading params and tparams from the same resolved entry also
    -- catches type variables that occur only in the result or effect set.
    synth_call(node, env, ft, src, tt)
    if node_tag(node) == 36 {
      check_generic_call_post_args(node, env, ft, src, caller_eff, tt)
    } else { if not call_entry_is_constructor(callee_entry) and not call_params_cover_tparams(params, ftypes_entry_tparams(callee_entry)) {
      typeck_error_maybe(src, ns, "type error: cannot infer generic call type arguments; write explicit type arguments")
      1
    } else {
      -- The arguments expose every type parameter, but an enclosing type
      -- variable defers their concrete identities until monomorphisation.
      check_call_args_declared(node, params, env, ft, src, caller_eff, tt)
    } }
  }
  else {
    check_call_args_declared(node, params, env, ft, src, caller_eff, tt)
  } }
  }
}

-- The ordinary declared-params arg check for non-generic calls.
pub(package) fn check_call_args_declared(node: i64, params: i64, env: i64, ft: i64, src: i64, caller_eff: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let ns = node_f1(node)
  let nl = node_f2(node)
  let args = node_f3(node)
  let nargs = node_f4(node)
  let nparams = nlist_len(params)
    let callee_entry = ftypes_find(ft, src, ns, nl)
    let callee_src = if callee_entry == 0 { src } else { ftypes_entry_source(callee_entry) }
    let mut errors = 0
    errors = errors + check_arity(nparams, nargs, src, ns)
    -- Effect checking: only when caller has explicit annotation
    let callee_eff = ftypes_lookup_effects(ft, src, ns, nl)
    errors = errors + check_effect_sig_available(
      callee_eff, src, ns, nl, caller_eff, tt, "call",
      if callee_entry == 0 { DiagnosticLocationNone }
      else { typeck_source_location(callee_src, ftypes_entry_name_start(callee_entry), ftypes_entry_name_len(callee_entry)) }
    )
    for i in 0..nargs {
      if i < nparams {
        let param = nlist_get(params, i)
        let param_ty = node_f3(param)
        if param_ty != 0 {
          let allow_direct_continuation_i64 = continuation_call_arg_accepts_direct(ft, src, ns, nl, i)
          errors = errors + check_arg_against_direct_param_mode_at(
            nlist_get(args, i), param_ty, env, ft, src, tt, ns, allow_direct_continuation_i64,
            typeck_source_location(callee_src, node_f1(param), node_f2(param))
          )
        } else { errors = errors }
      } else { errors = errors }
    }
    errors = errors + check_borrow_call_conflicts(args, nargs, src, ns)
    let exact_shapes = typeck_call_shape_type_args(args, nargs, params, 0, env, ft, src, tt)
    if exact_shapes != 0 {
      generic_call_rewrite_to_explicit(node, ns, nl, args, nargs, exact_shapes)
    } else { 0 }
    errors
}

-- Source borrow checking for non-owning slices (array/slice borrow checking).
--
-- The optimiser's BorrowOrigin/BorrowSummary plane proves where every lowered
-- slice came from. This source-side companion enforces the lifetime and
-- exclusivity contract while names and diagnostic positions still exist. An
-- origin is {owner name, lifetime class, mutability}: class 1 is a slice
-- parameter (caller-owned), class 2 is local storage, and class 3 is unknown.
-- Unknown origins overlap everything and may not escape.
pub(package) fn slice_borrow_origin(ns: i64, nl: i64, lifetime: i64, mutable: i64) -> i64 {
  node_new(0, ns, nl, lifetime, mutable)
}

pub(package) fn slice_borrow_origins_empty() -> i64 { nlist_new() }

pub(package) fn slice_borrow_origins_single(ns: i64, nl: i64, lifetime: i64, mutable: i64) -> i64 {
  let result = nlist_new_capacity(1)
  nlist_add(result, slice_borrow_origin(ns, nl, lifetime, mutable))
  result
}

pub(package) fn slice_borrow_origin_eq(left: i64, right: i64, src: i64) -> i64 {
  if node_f3(left) != node_f3(right) or node_f4(left) != node_f4(right) { 0 }
  else { if node_f3(left) == 3 { 1 }
  else { same_source_name(src, node_f1(left), node_f2(left), node_f1(right), node_f2(right)) } }
}

pub(package) fn slice_borrow_origins_contains(origins: i64, target: i64, src: i64) -> i64 {
  let mut found = 0
  for i in 0..nlist_len(origins) {
    if slice_borrow_origin_eq(nlist_get(origins, i), target, src) == 1 { found = 1 } else { 0 }
  }
  found
}

pub(package) fn slice_borrow_origins_union(left: i64, right: i64, src: i64) -> i64 {
  let result = nlist_new_capacity(nlist_len(left) + nlist_len(right))
  for i in 0..nlist_len(left) { nlist_add(result, nlist_get(left, i)) }
  for i in 0..nlist_len(right) {
    let origin = nlist_get(right, i)
    if slice_borrow_origins_contains(result, origin, src) == 0 { nlist_add(result, origin) } else { 0 }
  }
  result
}

pub(package) fn slice_borrow_origins_overlap(left: i64, right: i64, src: i64) -> i64 {
  let mut found = 0
  for li in 0..nlist_len(left) {
    let l = nlist_get(left, li)
    for ri in 0..nlist_len(right) {
      let r = nlist_get(right, ri)
      if node_f3(l) == 3 or node_f3(r) == 3 {
        found = 1
      } else { if same_source_name(src, node_f1(l), node_f2(l), node_f1(r), node_f2(r)) {
        found = 1
      } else { 0 } }
    }
  }
  found
}

pub(package) fn slice_borrow_origins_escape_kind(origins: i64) -> i64 {
  let mut kind = 0
  for i in 0..nlist_len(origins) {
    let lifetime = node_f3(nlist_get(origins, i))
    if lifetime == 2 { kind = 2 }
    else { if lifetime == 3 and kind == 0 { kind = 3 } else { 0 } }
  }
  kind
}

-- Binding information is {kind, view origins, contained origins, mutable}.
-- kind 1 is an owning array, 2 a slice, 3 an aggregate containing a borrow,
-- and 4 a growable Vector owner. Arrays have both their own storage origin and
-- (independently) any slice origins stored in their elements. Vector aliases
-- share origins because reallocation through any handle invalidates a view.
pub(package) fn slice_borrow_info(kind: i64, origins: i64, contained: i64, mutable: i64) -> i64 {
  node_new(0, kind, origins, contained, mutable)
}

pub(package) fn slice_borrow_info_kind(info: i64) -> i64 { if info == 0 { 0 } else { node_f1(info) } }
pub(package) fn slice_borrow_info_origins(info: i64) -> i64 { if info == 0 { slice_borrow_origins_empty() } else { node_f2(info) } }
pub(package) fn slice_borrow_info_contained(info: i64) -> i64 { if info == 0 { slice_borrow_origins_empty() } else { node_f3(info) } }
pub(package) fn slice_borrow_info_mutable(info: i64) -> i64 { if info == 0 { 0 } else { node_f4(info) } }

-- A compact persistent environment keeps shadowing exact without mutating the
-- ordinary type environment. Entry layout is {name start, name len, info,
-- rest}.
pub(package) fn slice_borrow_env_bind(env: i64, ns: i64, nl: i64, info: i64) -> i64 {
  node_new(0, ns, nl, info, env)
}

pub(package) fn slice_borrow_env_lookup(env: i64, src: i64, ns: i64, nl: i64) -> i64 {
  if env == 0 { 0 }
  else { if same_source_name(src, ns, nl, node_f1(env), node_f2(env)) { node_f3(env) }
  else { slice_borrow_env_lookup(node_f4(env), src, ns, nl) } }
}

pub(package) fn slice_borrow_type_list_contains(types: i64, tt: i64, depth: i64) -> i64 {
  if types == 0 { 0 }
  else {
    let mut found = 0
    for i in 0..nlist_len(types) {
      if slice_borrow_type_contains(nlist_get(types, i), tt, depth) == 1 { found = 1 } else { 0 }
    }
    found
  }
}

pub(package) fn slice_borrow_named_type_contains(ty: i64, tt: i64, depth: i64) -> i64 {
  if depth >= 8 { 1 }
  else {
    let entry = ttable_lookup_by_type_hash(tt, ty_f1(ty))
    if entry == 0 { 0 }
    else {
      let kind = mem_load64_at(entry, 16)
      let mut found = 0
      if kind == 0 {
        let fields = mem_load64_at(entry, 32)
        let count = mem_load64_at(entry, 24)
        let subst = type_cycle_subst_for_entry(entry, ty_f3(ty))
        for i in 0..count {
          let raw_ty = mem_load64_at(fields, i * 24 + 16)
          let field_ty = type_cycle_maybe_subst(raw_ty, subst)
          if slice_borrow_type_contains(field_ty, tt, depth + 1) == 1 { found = 1 } else { 0 }
        }
      } else { if kind == 1 {
        let variants = mem_load64_at(entry, 32)
        let count = mem_load64_at(entry, 24)
        let subst = type_cycle_subst_for_entry(entry, ty_f3(ty))
        for vi in 0..count {
          let npayloads = mem_load64_at(variants, vi * 40 + 24)
          let payloads = mem_load64_at(variants, vi * 40 + 32)
          for pi in 0..npayloads {
            let payload_ty = type_cycle_maybe_subst(nlist_get(payloads, pi), subst)
            if slice_borrow_type_contains(payload_ty, tt, depth + 1) == 1 { found = 1 } else { 0 }
          }
        }
      } else { 0 } }
      found
    }
  }
}

pub(package) fn slice_borrow_type_contains(ty: i64, tt: i64, depth: i64) -> i64 {
  if ty == 0 { 0 }
  else {
    match ty_tag(ty) {
      3 -> if slice_borrow_type_contains(ty_f1(ty), tt, depth) == 1 or slice_borrow_type_contains(ty_f2(ty), tt, depth) == 1 { 1 } else { 0 }
      4 -> if slice_borrow_type_contains(ty_f1(ty), tt, depth) == 1 or slice_borrow_type_contains(ty_f2(ty), tt, depth) == 1 { 1 } else { 0 }
      5 -> slice_borrow_type_contains(ty_f1(ty), tt, depth)
      7 -> slice_borrow_record_fields_contain(ty_record_fields(ty), tt, depth)
      8 -> slice_borrow_type_contains(ty_f2(ty), tt, depth)
      9 -> slice_borrow_named_type_contains(ty, tt, depth)
      11 -> slice_borrow_type_list_contains(ty_f2(ty), tt, depth)
      14 -> if slice_borrow_type_contains(ty_f1(ty), tt, depth) == 1 or slice_borrow_type_contains(ty_f2(ty), tt, depth) == 1 { 1 } else { 0 }
      15 -> slice_borrow_type_contains(ty_f1(ty), tt, depth)
      16 -> slice_borrow_type_contains(ty_f1(ty), tt, depth)
      17 -> slice_borrow_type_contains(ty_f1(ty), tt, depth)
      18 -> slice_borrow_type_contains(ty_f1(ty), tt, depth)
      19 -> slice_borrow_type_contains(ty_f1(ty), tt, depth)
      29 -> slice_borrow_type_contains(ty_f1(ty), tt, depth)
      22 -> slice_borrow_type_contains(ty_array_inner(ty), tt, depth)
      23 -> 1
      _ -> 0
    }
  }
}

pub(package) fn slice_borrow_record_fields_contain(fields: i64, tt: i64, depth: i64) -> i64 {
  let mut found = 0
  if fields != 0 {
    for i in 0..nlist_len(fields) {
      if slice_borrow_type_contains(ty_record_field_type(nlist_get(fields, i)), tt, depth) == 1 { found = 1 } else { 0 }
    }
  } else { 0 }
  found
}

pub(package) fn slice_borrow_unknown_origins(mutable: i64) -> i64 {
  slice_borrow_origins_single(0, 0, 3, mutable)
}

pub(package) fn slice_borrow_call_arg_origins(args: i64, nargs: i64, env: i64, tenv: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let mut result = slice_borrow_origins_empty()
  for i in 0..nargs {
    let arg = nlist_get(args, i)
    let arg_ty = synth(arg, tenv, ft, src, tt)
    if ty_is_slice(arg_ty) {
      result = slice_borrow_origins_union(result, slice_borrow_expr_view_origins(arg, env, tenv, ft, src, tt), src)
    } else { if ty_is_array(arg_ty) or typeck_type_is_vector(tt, arg_ty) == 1 {
      result = slice_borrow_origins_union(result, slice_borrow_info_origins(slice_borrow_info_for_expr(arg, env, tenv, ft, src, tt)), src)
    } else { 0 } }
  }
  result
}

pub(package) fn slice_borrow_lambda_capture_origins(lambda: i64, env: i64, src: i64) -> i64 {
  let params = node_f1(lambda)
  let body = node_f2(lambda)
  let mut result = slice_borrow_origins_empty()
  let mut current = env
  while current != 0 {
    if unique_params_bind_name(params, node_f3(lambda), src, src, node_f1(current), node_f2(current)) == 0 and unique_ref_count_name(body, src, src, node_f1(current), node_f2(current)) > 0 {
      let info = node_f3(current)
      let incoming = if slice_borrow_info_kind(info) == 2 { slice_borrow_info_origins(info) } else { slice_borrow_info_contained(info) }
      result = slice_borrow_origins_union(result, incoming, src)
    } else { 0 }
    current = node_f4(current)
  }
  result
}

pub(package) fn slice_borrow_record_origins(fields: i64, nfields: i64, env: i64, tenv: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let mut result = slice_borrow_origins_empty()
  for i in 0..nfields {
    let value = node_f3(nlist_get(fields, i))
    result = slice_borrow_origins_union(result, slice_borrow_expr_escape_origins(value, env, tenv, ft, src, tt), src)
  }
  result
}

pub(package) fn slice_borrow_array_origins(items: i64, count: i64, env: i64, tenv: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let mut result = slice_borrow_origins_empty()
  for i in 0..count {
    result = slice_borrow_origins_union(result, slice_borrow_expr_escape_origins(nlist_get(items, i), env, tenv, ft, src, tt), src)
  }
  result
}

pub(package) fn slice_borrow_expr_view_origins(node: i64, env: i64, tenv: i64, ft: i64, src: i64, tt: i64) -> i64 {
  if node == 0 { slice_borrow_origins_empty() }
  else {
    match node_tag(node) {
      2 -> slice_borrow_info_origins(slice_borrow_env_lookup(env, src, node_f1(node), node_f2(node)))
      4 -> {
        let local_callee_ty = tenv_lookup(tenv, src, node_f1(node), node_f2(node))
        if local_callee_ty != 0 and ty_tag(local_callee_ty) == 6 {
          let origin = tenv_lookup_value(tenv, src, node_f1(node), node_f2(node))
          if origin != 0 and node_tag(origin) == 29 {
            -- A literal local lambda has a sufficient summary: its result can
            -- only originate in its slice arguments or explicit captures.
            let from_args = slice_borrow_call_arg_origins(node_f3(node), node_f4(node), env, tenv, ft, src, tt)
            let from_captures = slice_borrow_lambda_capture_origins(origin, env, src)
            let result = slice_borrow_origins_union(from_args, from_captures, src)
            if nlist_len(result) == 0 { slice_borrow_unknown_origins(ty_slice_mutable(synth(node, tenv, ft, src, tt))) } else { result }
          } else {
            -- A parameter/opaque function value has no stable BorrowSummary
            -- contract, so its result cannot be guessed from its arguments.
            slice_borrow_unknown_origins(ty_slice_mutable(synth(node, tenv, ft, src, tt)))
          }
        } else {
          let result = slice_borrow_call_arg_origins(node_f3(node), node_f4(node), env, tenv, ft, src, tt)
          if nlist_len(result) == 0 { slice_borrow_unknown_origins(ty_slice_mutable(synth(node, tenv, ft, src, tt))) } else { result }
        }
      }
      5 -> slice_borrow_origins_union(
        slice_borrow_expr_view_origins(node_f2(node), env, tenv, ft, src, tt),
        slice_borrow_expr_view_origins(node_f3(node), env, tenv, ft, src, tt), src)
      6 -> {
        let value = node_f3(node)
        let info = slice_borrow_info_for_binding(value, node_f1(node), node_f2(node), env, tenv, ft, src, tt)
        let next_env = if info == 0 { env } else { slice_borrow_env_bind(env, node_f1(node), node_f2(node), info) }
        let value_ty = synth(value, tenv, ft, src, tt)
        let next_tenv = if node_tag(value) == 29 { tenv_bind_value(tenv, src, node_f1(node), node_f2(node), value_ty, value) } else { tenv_bind(tenv, src, node_f1(node), node_f2(node), value_ty) }
        slice_borrow_expr_view_origins(node_f4(node), next_env, next_tenv, ft, src, tt)
      }
      7 -> slice_borrow_expr_view_origins(node_f2(node), env, tenv, ft, src, tt)
      11 -> {
        let value = node_f3(node)
        let info = slice_borrow_info_for_binding(value, node_f1(node), node_f2(node), env, tenv, ft, src, tt)
        let next_env = if info == 0 { env } else { slice_borrow_env_bind(env, node_f1(node), node_f2(node), info) }
        let next_tenv = tenv_bind_mut(tenv, src, node_f1(node), node_f2(node), synth(value, tenv, ft, src, tt))
        slice_borrow_expr_view_origins(node_f4(node), next_env, next_tenv, ft, src, tt)
      }
      13 -> slice_borrow_info_contained(slice_borrow_info_for_expr(node_f1(node), env, tenv, ft, src, tt))
      15 -> {
        let arms = node_f2(node)
        let mut result = slice_borrow_origins_empty()
        for i in 0..node_f3(node) {
          result = slice_borrow_origins_union(result, slice_borrow_expr_view_origins(node_f2(nlist_get(arms, i)), env, tenv, ft, src, tt), src)
        }
        result
      }
      25 -> slice_borrow_expr_view_origins(node_f1(node), env, tenv, ft, src, tt)
      32 -> slice_borrow_unknown_origins(ty_slice_mutable(synth(node, tenv, ft, src, tt)))
      33 -> {
        let ret = node_f4(node)
        if ret == 0 { slice_borrow_expr_view_origins(node_f1(node), env, tenv, ft, src, tt) }
        else { slice_borrow_expr_view_origins(node_f3(ret), env, tenv, ft, src, tt) }
      }
      35 -> slice_borrow_expr_view_origins(node_f1(node), env, tenv, ft, src, tt)
      36 -> {
        -- The inner Call is representation, not an independent bare call.
        -- Synthesising it would run generic inference a second time and
        -- rewrite GenericCall(type_args, Call) into a nested GenericCall.
        let call_node = node_f2(node)
        let result = slice_borrow_call_arg_origins(generic_call_inner_args(call_node), generic_call_inner_arg_count(call_node), env, tenv, ft, src, tt)
        if nlist_len(result) == 0 { slice_borrow_unknown_origins(ty_slice_mutable(synth(node, tenv, ft, src, tt))) } else { result }
      }
      37 -> slice_borrow_expr_view_origins(node_f1(node), env, tenv, ft, src, tt)
      41 -> {
        let args = node_f3(node)
        let from_args = slice_borrow_call_arg_origins(args, nlist_len(args), env, tenv, ft, src, tt)
        let recv_ty = synth(node_f1(node), tenv, ft, src, tt)
        let result = if ty_is_slice(recv_ty) {
          slice_borrow_origins_union(slice_borrow_expr_view_origins(node_f1(node), env, tenv, ft, src, tt), from_args, src)
        } else { from_args }
        if nlist_len(result) == 0 { slice_borrow_unknown_origins(ty_slice_mutable(synth(node, tenv, ft, src, tt))) } else { result }
      }
      52 -> slice_borrow_expr_view_origins(node_f2(node), env, tenv, ft, src, tt)
      60 -> {
        let fact_ty = node_f3(node)
        if ty_is_slice(fact_ty) {
          let contained = slice_borrow_info_contained(slice_borrow_info_for_expr(node_f1(node), env, tenv, ft, src, tt))
          if nlist_len(contained) == 0 { slice_borrow_unknown_origins(ty_slice_mutable(fact_ty)) } else { contained }
        } else { slice_borrow_origins_empty() }
      }
      62 -> {
        let origins = slice_borrow_expr_view_origins(node_f1(node), env, tenv, ft, src, tt)
        if nlist_len(origins) == 0 {
          let fact = node_f4(node)
          slice_borrow_unknown_origins(if fact == 0 { 0 } else { node_f4(fact) })
        } else { origins }
      }
      _ -> {
        let ty = synth(node, tenv, ft, src, tt)
        if ty_is_slice(ty) { slice_borrow_unknown_origins(ty_slice_mutable(ty)) }
        else { slice_borrow_origins_empty() }
      }
    }
  }
}

pub(package) fn slice_borrow_expr_contained_origins(node: i64, env: i64, tenv: i64, ft: i64, src: i64, tt: i64) -> i64 {
  if node == 0 { slice_borrow_origins_empty() }
  else {
    match node_tag(node) {
      2 -> slice_borrow_info_contained(slice_borrow_env_lookup(env, src, node_f1(node), node_f2(node)))
      5 -> slice_borrow_origins_union(
        slice_borrow_expr_contained_origins(node_f2(node), env, tenv, ft, src, tt),
        slice_borrow_expr_contained_origins(node_f3(node), env, tenv, ft, src, tt), src)
      6 -> {
        let value = node_f3(node)
        let info = slice_borrow_info_for_binding(value, node_f1(node), node_f2(node), env, tenv, ft, src, tt)
        let next_env = if info == 0 { env } else { slice_borrow_env_bind(env, node_f1(node), node_f2(node), info) }
        let value_ty = synth(value, tenv, ft, src, tt)
        let next_tenv = if node_tag(value) == 29 { tenv_bind_value(tenv, src, node_f1(node), node_f2(node), value_ty, value) } else { tenv_bind(tenv, src, node_f1(node), node_f2(node), value_ty) }
        slice_borrow_expr_contained_origins(node_f4(node), next_env, next_tenv, ft, src, tt)
      }
      7 -> slice_borrow_expr_contained_origins(node_f2(node), env, tenv, ft, src, tt)
      11 -> {
        let value = node_f3(node)
        let info = slice_borrow_info_for_binding(value, node_f1(node), node_f2(node), env, tenv, ft, src, tt)
        let next_env = if info == 0 { env } else { slice_borrow_env_bind(env, node_f1(node), node_f2(node), info) }
        let next_tenv = tenv_bind_mut(tenv, src, node_f1(node), node_f2(node), synth(value, tenv, ft, src, tt))
        slice_borrow_expr_contained_origins(node_f4(node), next_env, next_tenv, ft, src, tt)
      }
      14 -> slice_borrow_record_origins(node_f3(node), node_f4(node), env, tenv, ft, src, tt)
      63 -> slice_borrow_origins_union(slice_borrow_expr_contained_origins(node_f1(node), env, tenv, ft, src, tt), slice_borrow_record_origins(node_f2(node), node_f3(node), env, tenv, ft, src, tt), src)
      15 -> {
        let arms = node_f2(node)
        let mut result = slice_borrow_origins_empty()
        for i in 0..node_f3(node) {
          result = slice_borrow_origins_union(result, slice_borrow_expr_contained_origins(node_f2(nlist_get(arms, i)), env, tenv, ft, src, tt), src)
        }
        result
      }
      25 -> slice_borrow_expr_contained_origins(node_f1(node), env, tenv, ft, src, tt)
      36 -> {
        let ty = synth(node, tenv, ft, src, tt)
        if slice_borrow_type_contains(ty, tt, 0) == 1 and ty_is_slice(ty) == 0 { slice_borrow_unknown_origins(0) }
        else { slice_borrow_origins_empty() }
      }
      37 -> slice_borrow_expr_contained_origins(node_f1(node), env, tenv, ft, src, tt)
      52 -> slice_borrow_expr_contained_origins(node_f2(node), env, tenv, ft, src, tt)
      58 -> slice_borrow_array_origins(node_f1(node), node_f2(node), env, tenv, ft, src, tt)
      _ -> {
        let ty = synth(node, tenv, ft, src, tt)
        if slice_borrow_type_contains(ty, tt, 0) == 1 and ty_is_slice(ty) == 0 {
          slice_borrow_unknown_origins(0)
        } else { slice_borrow_origins_empty() }
      }
    }
  }
}

pub(package) fn slice_borrow_expr_escape_origins(node: i64, env: i64, tenv: i64, ft: i64, src: i64, tt: i64) -> i64 {
  if node == 0 { slice_borrow_origins_empty() }
  else {
    let ty = synth(node, tenv, ft, src, tt)
    if ty_is_slice(ty) { slice_borrow_expr_view_origins(node, env, tenv, ft, src, tt) }
    else { slice_borrow_expr_contained_origins(node, env, tenv, ft, src, tt) }
  }
}

pub(package) fn slice_borrow_info_for_expr(node: i64, env: i64, tenv: i64, ft: i64, src: i64, tt: i64) -> i64 {
  if node == 0 { 0 }
  else {
    let ty = synth(node, tenv, ft, src, tt)
    if ty_is_array(ty) {
      let info = if node_tag(node) == 2 { slice_borrow_env_lookup(env, src, node_f1(node), node_f2(node)) } else { 0 }
      if info != 0 { info }
      else { slice_borrow_info(1, slice_borrow_unknown_origins(0), slice_borrow_expr_contained_origins(node, env, tenv, ft, src, tt), 0) }
    } else { if ty_is_slice(ty) {
      slice_borrow_info(2, slice_borrow_expr_view_origins(node, env, tenv, ft, src, tt), slice_borrow_origins_empty(), ty_slice_mutable(ty))
    } else { if typeck_type_is_vector(tt, ty) == 1 {
      let info = if node_tag(node) == 2 { slice_borrow_env_lookup(env, src, node_f1(node), node_f2(node)) } else { 0 }
      if info != 0 { info }
      else { slice_borrow_info(4, slice_borrow_unknown_origins(0), slice_borrow_origins_empty(), 0) }
    } else {
      let contained = slice_borrow_expr_contained_origins(node, env, tenv, ft, src, tt)
      if nlist_len(contained) == 0 { 0 } else { slice_borrow_info(3, slice_borrow_origins_empty(), contained, 0) }
    } } }
  }
}

pub(package) fn slice_borrow_expr_fresh_vector_declaration(node: i64, src: i64, ft: i64) -> i64 {
  let call = if node_tag(node) == 36 { node_f2(node) } else { node }
  if call == 0 { 0 }
  else { if node_tag(call) == 4 {
    ftypes_entry_decl_fact(ftypes_find(ft, src, node_f1(call), node_f2(call)))
  } else { if node_tag(call) == 32 {
    typeck_qualified_call_declaration(call)
  } else { if node_tag(call) == 41 {
    method_ref_declaration(node_f4(call))
  } else { 0 } } } }
}

-- Freshness is a property of the resolved vector operation, not its spelling.
-- This keeps aliases and qualified calls equivalent and prevents unrelated
-- same-named functions from acquiring the standard library's borrow facts.
pub(package) fn slice_borrow_expr_is_fresh_vector(node: i64, src: i64, ft: i64) -> i64 {
  let declaration = slice_borrow_expr_fresh_vector_declaration(node, src, ft)
  if typeck_decl_identity_is(declaration, "stdlib/vector", "new") == 1 { 1 }
  else { if typeck_decl_identity_is(declaration, "stdlib/vector", "with_capacity") == 1 { 1 }
  else { if typeck_decl_identity_is(declaration, "stdlib/vector", "map") == 1 { 1 }
  else { if typeck_decl_identity_is(declaration, "stdlib/vector", "slice") == 1 { 1 }
  else { if typeck_decl_identity_is(declaration, "stdlib/vector", "concat") == 1 { 1 }
  else { if typeck_decl_identity_is(declaration, "stdlib/vector", "filter") == 1 { 1 }
  else { if typeck_decl_identity_is(declaration, "stdlib/vector", "dedup_by") == 1 { 1 }
  else { if typeck_decl_identity_is(declaration, "stdlib/vector", "dedup") == 1 { 1 }
  else { if typeck_decl_identity_is(declaration, "stdlib/vector", "range") == 1 { 1 }
  else { if typeck_decl_identity_is(declaration, "stdlib/vector", "vector_map") == 1 { 1 }
  else { if typeck_decl_identity_is(declaration, "stdlib/vector", "vector_slice") == 1 { 1 }
  else { if typeck_decl_identity_is(declaration, "stdlib/vector", "vector_concat") == 1 { 1 }
  else { if typeck_decl_identity_is(declaration, "stdlib/vector", "vector_filter") == 1 { 1 }
  else { if typeck_decl_identity_is(declaration, "stdlib/vector", "vector_dedup_by") == 1 { 1 }
  else { if typeck_decl_identity_is(declaration, "stdlib/vector", "vector_dedup") == 1 { 1 } else { 0 } }
  } } } } } } } } } } } } } }
}

pub(package) fn slice_borrow_info_for_binding(node: i64, ns: i64, nl: i64, env: i64, tenv: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let ty = synth(node, tenv, ft, src, tt)
  if ty_is_array(ty) {
    slice_borrow_info(1, slice_borrow_origins_single(ns, nl, 2, 0), slice_borrow_expr_contained_origins(node, env, tenv, ft, src, tt), 0)
  } else { if ty_is_slice(ty) {
    slice_borrow_info(2, slice_borrow_expr_view_origins(node, env, tenv, ft, src, tt), slice_borrow_origins_empty(), ty_slice_mutable(ty))
  } else { if typeck_type_is_vector(tt, ty) == 1 {
    let existing = if node_tag(node) == 2 { slice_borrow_env_lookup(env, src, node_f1(node), node_f2(node)) } else { 0 }
    if existing != 0 { existing }
    else { if slice_borrow_expr_is_fresh_vector(node, src, ft) == 1 {
      slice_borrow_info(4, slice_borrow_origins_single(ns, nl, 2, 0), slice_borrow_origins_empty(), 0)
    } else { slice_borrow_info(4, slice_borrow_unknown_origins(0), slice_borrow_origins_empty(), 0) } }
  } else {
    let contained = slice_borrow_expr_contained_origins(node, env, tenv, ft, src, tt)
    if nlist_len(contained) == 0 { 0 } else { slice_borrow_info(3, slice_borrow_origins_empty(), contained, 0) }
  } } }
}

pub(package) fn slice_borrow_env_bind_param_list(params: i64, nparams: i64, env: i64, src: i64, tt: i64) -> i64 {
  let mut result = env
  for i in 0..nparams {
    let param = nlist_get(params, i)
    let ns = node_f1(param)
    let nl = node_f2(param)
    let ty = node_f3(param)
    if ty_is_slice(ty) {
      result = slice_borrow_env_bind(result, ns, nl, slice_borrow_info(2, slice_borrow_origins_single(ns, nl, 1, ty_slice_mutable(ty)), slice_borrow_origins_empty(), ty_slice_mutable(ty)))
    } else { if ty_is_array(ty) {
      let contained = if slice_borrow_type_contains(ty_array_inner(ty), tt, 0) == 1 { slice_borrow_unknown_origins(0) } else { slice_borrow_origins_empty() }
      result = slice_borrow_env_bind(result, ns, nl, slice_borrow_info(1, slice_borrow_origins_single(ns, nl, 1, 0), contained, 0))
    } else { if typeck_type_is_vector(tt, ty) == 1 {
      result = slice_borrow_env_bind(result, ns, nl, slice_borrow_info(4, slice_borrow_origins_single(ns, nl, 1, 0), slice_borrow_origins_empty(), 0))
    } else { if slice_borrow_type_contains(ty, tt, 0) == 1 {
      result = slice_borrow_env_bind(result, ns, nl, slice_borrow_info(3, slice_borrow_origins_empty(), slice_borrow_unknown_origins(0), 0))
    } else { 0 } } } }
  }
  result
}

pub(package) fn slice_borrow_tenv_bind_param_list(params: i64, nparams: i64, env: i64, src: i64) -> i64 {
  let mut result = env
  for i in 0..nparams {
    let param = nlist_get(params, i)
    let param_ty = node_f3(param)
    result = tenv_bind(result, src, node_f1(param), node_f2(param), if param_ty == 0 { ty_any() } else { param_ty })
  }
  result
}

-- Active borrow entry is {borrower name, origins, mutable}; the surrounding
-- link keeps the four-field raw node layout available.
pub(package) fn slice_borrow_active_push(active: i64, ns: i64, nl: i64, origins: i64, mutable: i64, parent: i64) -> i64 {
  let parent_ns = if parent != 0 and node_tag(parent) == 2 { node_f1(parent) } else { 0 }
  let parent_nl = if parent != 0 and node_tag(parent) == 2 { node_f2(parent) } else { 0 }
  node_new(0, node_new(0, ns, nl, origins, mutable), active, parent_ns, parent_nl)
}

pub(package) fn slice_borrow_active_entry_live(entry: i64, context: i64, src: i64) -> i64 {
  if context == 0 { 0 }
  else { if unique_ref_count_name(context, src, src, node_f1(entry), node_f2(entry)) > 0 { 1 } else { 0 } }
}

pub(package) fn slice_borrow_name_is(src: i64, node: i64, ns: i64, nl: i64) -> i64 {
  if node == 0 or node_tag(node) != 2 { 0 }
  else { if same_source_name(src, node_f1(node), node_f2(node), ns, nl) { 1 } else { 0 } }
}

pub(package) fn slice_borrow_new_conflicts(origins: i64, mutable: i64, allowed_source: i64, active: i64, context: i64, src: i64) -> i64 {
  let mut current = active
  let mut conflict = 0
  while current != 0 {
    let entry = node_f1(current)
    if slice_borrow_active_entry_live(entry, context, src) == 1 and slice_borrow_origins_overlap(origins, node_f3(entry), src) == 1 {
      let allowed = if allowed_source == 0 { 0 } else { slice_borrow_name_is(src, allowed_source, node_f1(entry), node_f2(entry)) }
      if allowed == 0 and (mutable == 1 or node_f4(entry) == 1) { conflict = 1 } else { 0 }
    } else { 0 }
    current = node_f2(current)
  }
  conflict
}

pub(package) fn slice_borrow_check_new(node: i64, allowed_source: i64, active: i64, context: i64, env: i64, tenv: i64, ft: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  let ty = synth(node, tenv, ft, src, tt)
  if ty_is_slice(ty) == 0 { 0 }
  else {
    let origins = slice_borrow_expr_view_origins(node, env, tenv, ft, src, tt)
    if slice_borrow_new_conflicts(origins, ty_slice_mutable(ty), allowed_source, active, context, src) == 1 {
      typeck_error_maybe(src, expr_diag_pos(node), "type error: slice borrow conflicts with a live exclusive borrow")
      1
    } else { 0 }
  }
}

pub(package) fn slice_borrow_check_access(base: i64, write: i64, active: i64, context: i64, env: i64, src: i64) -[Diagnose]> i64 {
  if base == 0 or node_tag(base) != 2 { 0 }
  else {
    let info = slice_borrow_env_lookup(env, src, node_f1(base), node_f2(base))
    let kind = slice_borrow_info_kind(info)
    if kind != 1 and kind != 2 and kind != 4 { 0 }
    else {
      let origins = slice_borrow_info_origins(info)
      let base_mutable_slice = if kind == 2 { slice_borrow_info_mutable(info) } else { 0 }
      -- A live reborrow freezes its parent, but the child itself must still be
      -- usable. Remember the direct parent on the active-link node so access
      -- through the child can ignore precisely that one capability.
      let mut parent_ns = 0
      let mut parent_nl = 0
      let mut parent_scan = active
      while parent_scan != 0 {
        let own = node_f1(parent_scan)
        if same_source_name(src, node_f1(base), node_f2(base), node_f1(own), node_f2(own)) {
          parent_ns = node_f3(parent_scan)
          parent_nl = node_f4(parent_scan)
        } else { 0 }
        parent_scan = node_f2(parent_scan)
      }
      let mut current = active
      let mut conflict = 0
      while current != 0 {
        let entry = node_f1(current)
        let same_borrower = if same_source_name(src, node_f1(base), node_f2(base), node_f1(entry), node_f2(entry)) { 1 } else { 0 }
        let is_parent = if parent_nl > 0 and same_source_name(src, parent_ns, parent_nl, node_f1(entry), node_f2(entry)) { 1 } else { 0 }
        if same_borrower == 0 and is_parent == 0 and slice_borrow_active_entry_live(entry, context, src) == 1 and slice_borrow_origins_overlap(origins, node_f3(entry), src) == 1 {
          if write == 1 or base_mutable_slice == 1 or node_f4(entry) == 1 { conflict = 1 } else { 0 }
        } else { 0 }
        current = node_f2(current)
      }
      if conflict == 1 {
        typeck_error_maybe(src, expr_diag_pos(base), if write == 1 { "type error: mutation conflicts with a live slice borrow" } else { "type error: access conflicts with a live mutable slice borrow" })
        1
      } else { 0 }
    }
  }
}

-- Vector's current handle API has interior mutation rather than a public
-- `mut` receiver type. While a zero-copy view is live, calls are therefore
-- conservative by default; only the canonical read-only operations may
-- observe the owner. Unknown wrappers remain potentially reallocating.
pub(package) fn slice_borrow_vector_call_is_read_only(src: i64, ns: i64, nl: i64) -> i64 {
  if src_eq(src, ns, nl, "vector_len") == 1 { 1 }
  else { if src_eq(src, ns, nl, "vector_capacity") == 1 { 1 }
  else { if src_eq(src, ns, nl, "vector_data") == 1 { 1 }
  else { if src_eq(src, ns, nl, "vector_element_size") == 1 { 1 }
  else { if src_eq(src, ns, nl, "vector_element_mode") == 1 { 1 }
  else { if src_eq(src, ns, nl, "vector_capacity_bytes") == 1 { 1 }
  else { if src_eq(src, ns, nl, "vector_is_empty") == 1 { 1 }
  else { if src_eq(src, ns, nl, "vector_in_bounds") == 1 { 1 }
  else { if src_eq(src, ns, nl, "vector_get") == 1 { 1 }
  else { if src_eq(src, ns, nl, "vector_get_in_bounds") == 1 { 1 }
  else { if src_eq(src, ns, nl, "vector_get_field_in_bounds") == 1 { 1 }
  else { if src_eq(src, ns, nl, "vector_get_option") == 1 { 1 }
  else { if src_eq(src, ns, nl, "vector_sum_i64") == 1 { 1 }
  else { if src_eq(src, ns, nl, "vector_slice") == 1 { 1 }
  else { if src_eq(src, ns, nl, "vector_concat") == 1 { 1 }
  else { if src_eq(src, ns, nl, "to_array") == 1 { 1 } else { 0 } }
  } } } } } } } } } } } } } } }
}

pub(package) fn slice_borrow_vector_method_is_read_only(method_hash: i64) -> i64 {
  if method_hash == effect_name_hash(__str_ptr("to_array"), 0, __str_len("to_array")) { 1 }
  else { 0 }
}

pub(package) fn slice_borrow_check_vector_expr_access(node: i64, write: i64, env: i64, active: i64, context: i64, tenv: i64, ft: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  let ty = synth(node, tenv, ft, src, tt)
  if typeck_type_is_vector(tt, ty) == 0 { 0 }
  else {
    let info = slice_borrow_info_for_expr(node, env, tenv, ft, src, tt)
    let origins = slice_borrow_info_origins(info)
    let mut current = active
    let mut conflict = 0
    while current != 0 {
      let entry = node_f1(current)
      if slice_borrow_active_entry_live(entry, context, src) == 1 and slice_borrow_origins_overlap(origins, node_f3(entry), src) == 1 {
        if write == 1 or node_f4(entry) == 1 { conflict = 1 } else { 0 }
      } else { 0 }
      current = node_f2(current)
    }
    if conflict == 1 {
      typeck_error_maybe(src, expr_diag_pos(node), if write == 1 { "type error: Vector mutation or reallocation conflicts with a live slice borrow" } else { "type error: Vector access conflicts with a live mutable slice borrow" })
      1
    } else { 0 }
  }
}

pub(package) fn slice_borrow_check_vector_call_args(args: i64, nargs: i64, read_only: i64, env: i64, active: i64, context: i64, tenv: i64, ft: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  let mut errors = 0
  for i in 0..nargs {
    errors = errors + slice_borrow_check_vector_expr_access(nlist_get(args, i), if read_only == 1 { 0 } else { 1 }, env, active, context, tenv, ft, src, tt)
  }
  errors
}

pub(package) fn slice_borrow_check_result(node: i64, env: i64, tenv: i64, ft: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  let origins = slice_borrow_expr_escape_origins(node, env, tenv, ft, src, tt)
  let result_ty = synth(node, tenv, ft, src, tt)
  let kind = slice_borrow_origins_escape_kind(origins)
  if nlist_len(origins) > 0 and ty_is_slice(result_ty) == 0 {
    -- BorrowSummary currently maps slice-valued returns. An aggregate can
    -- carry local slices internally, but it cannot cross the function/closure
    -- boundary until aggregate return summaries can map those fields.
    typeck_error_maybe(src, expr_diag_pos(node), "type error: slice-containing aggregate cannot escape its borrow scope")
    1
  } else { if kind == 2 {
    typeck_error_maybe(src, expr_diag_pos(node), "type error: slice borrow escapes its owner")
    1
  } else { if kind == 3 {
    typeck_error_maybe(src, expr_diag_pos(node), "type error: slice provenance is unknown at escape")
    1
  } else { 0 } } }
}

pub(package) fn slice_borrow_check_call_siblings(args: i64, nargs: i64, env: i64, tenv: i64, ft: i64, src: i64, tt: i64, pos: i64) -[Diagnose]> i64 {
  let mut conflict = 0
  for i in 0..nargs {
    let left = nlist_get(args, i)
    let left_ty = synth(left, tenv, ft, src, tt)
    if ty_is_slice(left_ty) {
      let left_origins = slice_borrow_expr_view_origins(left, env, tenv, ft, src, tt)
      for j in (i + 1)..nargs {
        let right = nlist_get(args, j)
        let right_ty = synth(right, tenv, ft, src, tt)
        if ty_is_slice(right_ty) and (ty_slice_mutable(left_ty) == 1 or ty_slice_mutable(right_ty) == 1) {
          if slice_borrow_origins_overlap(left_origins, slice_borrow_expr_view_origins(right, env, tenv, ft, src, tt), src) == 1 { conflict = 1 } else { 0 }
        } else { 0 }
      }
    } else { 0 }
  }
  if conflict == 1 {
    typeck_error_maybe(src, pos, "type error: call arguments contain overlapping mutable slice borrows")
    1
  } else { 0 }
}

-- A scoped Par body is called synchronously and cannot outlive the borrow.
-- A par.map worker may run on another thread, so its captured slice elements
-- additionally need a structural shareability proof. The classification is
-- packed beside the parser-produced source-site fact in lambda f4.
pub(package) fn slice_borrow_par_lambda_scope_body() -> i64 { 1 }
pub(package) fn slice_borrow_par_lambda_worker() -> i64 { 2 }
-- Structured tasks use the same lifetime slot as scoped Par, but keep a
-- distinct boundary kind because its callback may carry residual effects.
-- The value-specific Sendable producer consumes that distinction; the slice
-- borrower only needs to know that both worker kinds are joined by scope exit.
pub(package) fn slice_borrow_task_lambda_worker() -> i64 { 3 }

-- linear-resource layout: the shared structural linear-resource layout fact. This is the
-- single semantic producer for contagious aggregate linearity and, later, for
-- structural cleanup lowering. It runs after generic substitution and records
-- canonical storage positions rather than leaving lowering to rediscover type
-- syntax.
--
-- Fact node layout (reason lives in node tag):
--   f1 decision: 0 copyable, 1 finite linear aggregate, -1 unsupported
--   f2 cleanup-plan tree (zero for copyable/unsupported)
--   f3 first offending type (unsupported only)
--   f4 path to the first owned/offending component
--
-- Plan kinds:
--   1 owned leaf, 2 structural record, 3 tuple, 4 named record,
--   5 tagged variant, 6 opaque representation.
-- Product plan f2 is a list of linear child components. Variant plan f2 is a
-- list containing every constructor alternative, including alternatives with
-- no owned payload; cleanup must still distinguish those active tags before
-- releasing the ordinary managed backing.
--
-- Component kinds: 1 field, 2 tuple position, 3 variant payload. f1 is the
-- field/constructor hash, f2 the layout/payload index, f3 the word offset and
-- f4 the child plan. Variant-alternative nodes use kind 4 with f1 constructor
-- hash, f2 declaration index, f3 payload-component list and f4 payload words.
pub(package) fn typeck_linear_layout_decision_copyable() -> i64 { 0 }
pub(package) fn typeck_linear_layout_decision_linear() -> i64 { 1 }
pub(package) fn typeck_linear_layout_decision_unsupported() -> i64 { 0 - 1 }

pub(package) fn typeck_linear_layout_reason_none() -> i64 { 0 }
pub(package) fn typeck_linear_layout_reason_recursive() -> i64 { 1 }
pub(package) fn typeck_linear_layout_reason_container() -> i64 { 2 }
pub(package) fn typeck_linear_layout_reason_set_operator() -> i64 { 3 }
pub(package) fn typeck_linear_layout_reason_open_record() -> i64 { 4 }
pub(package) fn typeck_linear_layout_reason_unique() -> i64 { 5 }
pub(package) fn typeck_linear_layout_reason_unresolved() -> i64 { 6 }
pub(package) fn typeck_linear_layout_reason_unknown_nominal() -> i64 { 7 }

pub(package) fn typeck_linear_layout_fact(reason: i64, decision: i64, plan: i64, offender: i64, path: i64) -> i64 {
  node_new(reason, decision, plan, offender, path)
}

pub(package) fn typeck_linear_layout_fact_copyable() -> i64 {
  typeck_linear_layout_fact(typeck_linear_layout_reason_none(), typeck_linear_layout_decision_copyable(), 0, 0, 0)
}

pub(package) fn typeck_linear_layout_fact_linear(plan: i64, path: i64) -> i64 {
  typeck_linear_layout_fact(typeck_linear_layout_reason_none(), typeck_linear_layout_decision_linear(), plan, 0, path)
}

pub(package) fn typeck_linear_layout_fact_unsupported(ty: i64, reason: i64, path: i64) -> i64 {
  typeck_linear_layout_fact(reason, typeck_linear_layout_decision_unsupported(), 0, ty, path)
}

pub(package) fn typeck_linear_layout_fact_decision(fact: i64) -> i64 {
  if fact == 0 { typeck_linear_layout_decision_unsupported() } else { node_f1(fact) }
}
pub(package) fn typeck_linear_layout_fact_plan(fact: i64) -> i64 { if fact == 0 { 0 } else { node_f2(fact) } }
pub(package) fn typeck_linear_layout_fact_offender(fact: i64) -> i64 { if fact == 0 { 0 } else { node_f3(fact) } }
pub(package) fn typeck_linear_layout_fact_path(fact: i64) -> i64 { if fact == 0 { 0 } else { node_f4(fact) } }
pub(package) fn typeck_linear_layout_fact_reason(fact: i64) -> i64 {
  if fact == 0 { typeck_linear_layout_reason_unresolved() } else { node_tag(fact) }
}

pub(package) fn typeck_linear_layout_path_segment(kind: i64, key: i64, index: i64, offset: i64, rest: i64) -> i64 {
  node_new(kind, key, index, offset, rest)
}
pub(package) fn typeck_linear_layout_path_kind(path: i64) -> i64 { if path == 0 { 0 } else { node_tag(path) } }
pub(package) fn typeck_linear_layout_path_key(path: i64) -> i64 { if path == 0 { 0 } else { node_f1(path) } }
pub(package) fn typeck_linear_layout_path_index(path: i64) -> i64 { if path == 0 { 0 - 1 } else { node_f2(path) } }
pub(package) fn typeck_linear_layout_path_offset(path: i64) -> i64 { if path == 0 { 0 - 1 } else { node_f3(path) } }
pub(package) fn typeck_linear_layout_path_rest(path: i64) -> i64 { if path == 0 { 0 } else { node_f4(path) } }

pub(package) fn typeck_linear_layout_plan(kind: i64, ty: i64, children: i64, words: i64, identity: i64) -> i64 {
  node_new(kind, ty, children, words, identity)
}
pub(package) fn typeck_linear_layout_plan_kind(plan: i64) -> i64 { if plan == 0 { 0 } else { node_tag(plan) } }
pub(package) fn typeck_linear_layout_plan_type(plan: i64) -> i64 { if plan == 0 { 0 } else { node_f1(plan) } }
pub(package) fn typeck_linear_layout_plan_children(plan: i64) -> i64 { if plan == 0 { 0 } else { node_f2(plan) } }
pub(package) fn typeck_linear_layout_plan_words(plan: i64) -> i64 { if plan == 0 { 0 } else { node_f3(plan) } }
pub(package) fn typeck_linear_layout_plan_identity(plan: i64) -> i64 { if plan == 0 { 0 } else { node_f4(plan) } }

pub(package) fn typeck_linear_layout_type_identity(ty: i64) -> i64 {
  let shape = ty_semantic_hash(ty)
  if ty != 0 and ty_named_is_opaque(ty) {
    module_decl_fact_derived_native_key(ty_named_opaque_declaration(ty), shape)
  } else { shape }
}

pub(package) fn typeck_linear_layout_component(kind: i64, key: i64, index: i64, offset: i64, plan: i64) -> i64 {
  node_new(kind, key, index, offset, plan)
}
pub(package) fn typeck_linear_layout_component_kind(component: i64) -> i64 { if component == 0 { 0 } else { node_tag(component) } }
pub(package) fn typeck_linear_layout_component_key(component: i64) -> i64 { if component == 0 { 0 } else { node_f1(component) } }
pub(package) fn typeck_linear_layout_component_index(component: i64) -> i64 { if component == 0 { 0 - 1 } else { node_f2(component) } }
pub(package) fn typeck_linear_layout_component_offset(component: i64) -> i64 { if component == 0 { 0 - 1 } else { node_f3(component) } }
pub(package) fn typeck_linear_layout_component_plan(component: i64) -> i64 { if component == 0 { 0 } else { node_f4(component) } }

pub(package) fn typeck_linear_layout_variant_alternative(constructor_hash: i64, index: i64, payloads: i64, words: i64) -> i64 {
  node_new(4, constructor_hash, index, payloads, words)
}
pub(package) fn typeck_linear_layout_variant_hash(alternative: i64) -> i64 { if alternative == 0 { 0 } else { node_f1(alternative) } }
pub(package) fn typeck_linear_layout_variant_index(alternative: i64) -> i64 { if alternative == 0 { 0 - 1 } else { node_f2(alternative) } }
pub(package) fn typeck_linear_layout_variant_payloads(alternative: i64) -> i64 { if alternative == 0 { 0 } else { node_f3(alternative) } }
pub(package) fn typeck_linear_layout_variant_words(alternative: i64) -> i64 { if alternative == 0 { 0 } else { node_f4(alternative) } }

-- A consuming pattern derives a residual cleanup plan from the exact
-- substituted layout fact.  Give that residual its own semantic identity:
-- the parent and residual may both appear in one function's abort-fact table,
-- and aliasing their cleanup actions would make a split re-arm the detached
-- parent obligation.  The fold is over semantic component/alternative facts,
-- never source pattern syntax.
pub(package) fn typeck_linear_layout_residual_mix(seed: i64, value: i64) -> i64 {
  (seed * 1099511628211 + value + 1469598103934665603) band 9223372036854775807
}

pub(package) fn typeck_linear_layout_residual_component_identity(seed: i64, component: i64) -> i64 {
  let child = typeck_linear_layout_component_plan(component)
  let with_kind = typeck_linear_layout_residual_mix(seed, typeck_linear_layout_component_kind(component))
  let with_key = typeck_linear_layout_residual_mix(with_kind, typeck_linear_layout_component_key(component))
  let with_index = typeck_linear_layout_residual_mix(with_key, typeck_linear_layout_component_index(component) + 1)
  let with_offset = typeck_linear_layout_residual_mix(with_index, typeck_linear_layout_component_offset(component) + 1)
  typeck_linear_layout_residual_mix(with_offset, typeck_linear_layout_plan_identity(child))
}

pub(package) fn typeck_linear_layout_residual_components_identity(seed: i64, components: i64) -> i64 {
  let mut result = seed
  let count = if components == 0 { 0 } else { nlist_len(components) }
  for i in 0..count { result = typeck_linear_layout_residual_component_identity(result, nlist_get(components, i)) }
  result
}

pub(package) fn typeck_linear_layout_residual_alternatives_identity(seed: i64, alternatives: i64) -> i64 {
  let mut result = seed
  let count = if alternatives == 0 { 0 } else { nlist_len(alternatives) }
  for i in 0..count {
    let alternative = nlist_get(alternatives, i)
    result = typeck_linear_layout_residual_mix(result, typeck_linear_layout_variant_hash(alternative))
    result = typeck_linear_layout_residual_mix(result, typeck_linear_layout_variant_index(alternative) + 1)
    result = typeck_linear_layout_residual_components_identity(result, typeck_linear_layout_variant_payloads(alternative))
  }
  result
}

pub(package) fn typeck_linear_layout_residual_plan(parent: i64, children: i64) -> i64 {
  if parent == 0 or children == 0 or nlist_len(children) == 0 { 0 }
  else {
    let kind = typeck_linear_layout_plan_kind(parent)
    let seed = typeck_linear_layout_residual_mix(typeck_linear_layout_plan_identity(parent), 4 * 100 + 18)
    let identity = if kind == 5 {
      typeck_linear_layout_residual_alternatives_identity(seed, children)
    } else {
      typeck_linear_layout_residual_components_identity(seed, children)
    }
    typeck_linear_layout_plan(kind, typeck_linear_layout_plan_type(parent), children, typeck_linear_layout_plan_words(parent), identity)
  }
}

pub(package) fn typeck_linear_layout_residual_wrapper_plan(parent: i64, child: i64) -> i64 {
  if parent == 0 or child == 0 { 0 }
  else {
    let seed = typeck_linear_layout_residual_mix(typeck_linear_layout_plan_identity(parent), 4 * 100 + 19)
    let identity = typeck_linear_layout_residual_mix(seed, typeck_linear_layout_plan_identity(child))
    typeck_linear_layout_plan(6, typeck_linear_layout_plan_type(parent), child, typeck_linear_layout_plan_words(parent), identity)
  }
}

pub(package) fn typeck_linear_layout_residual_backing_plan(parent: i64) -> i64 {
  if parent == 0 { 0 }
  else {
    let identity = typeck_linear_layout_residual_mix(typeck_linear_layout_plan_identity(parent), 4 * 100 + 20)
    -- Kind 7 is an extraction residual, not a source-type classification:
    -- every linear child moved, but the consumed named aggregate's managed
    -- backing still has one exact release obligation.
    typeck_linear_layout_plan(7, typeck_linear_layout_plan_type(parent), 0, 1, identity)
  }
}

-- Internal analysis state: f1 fact, f2 unresolved nominal-cycle identities.
-- A revisit propagates its exact instantiated identity outward until the
-- matching nominal boundary. That boundary accepts a copyable fixed point but
-- rejects the SCC if any owned leaf participates in it.
pub(package) fn typeck_linear_layout_state(fact: i64, cycles: i64) -> i64 { node_new(0, fact, cycles, 0, 0) }
pub(package) fn typeck_linear_layout_state_fact(state: i64) -> i64 { node_f1(state) }
pub(package) fn typeck_linear_layout_state_cycles(state: i64) -> i64 { node_f2(state) }

pub(package) fn typeck_linear_layout_type_list_contains(types: i64, ty: i64) -> i64 {
  let mut found = 0
  let mut i = 0
  while types != 0 and i < nlist_len(types) and found == 0 {
    if ty_eq(nlist_get(types, i), ty) { found = 1 } else { i = i + 1 }
  }
  found
}

pub(package) fn typeck_linear_layout_type_list_add_unique(types: i64, ty: i64) -> i64 {
  if typeck_linear_layout_type_list_contains(types, ty) == 0 { nlist_add(types, ty) } else { types }
}

pub(package) fn typeck_linear_layout_cycle_union(left: i64, right: i64) -> i64 {
  let result = nlist_new()
  let left_count = if left == 0 { 0 } else { nlist_len(left) }
  let right_count = if right == 0 { 0 } else { nlist_len(right) }
  for i in 0..left_count { typeck_linear_layout_type_list_add_unique(result, nlist_get(left, i)) }
  for i in 0..right_count { typeck_linear_layout_type_list_add_unique(result, nlist_get(right, i)) }
  result
}

pub(package) fn typeck_linear_layout_cycle_without(cycles: i64, ty: i64) -> i64 {
  let result = nlist_new()
  let count = if cycles == 0 { 0 } else { nlist_len(cycles) }
  for i in 0..count {
    let candidate = nlist_get(cycles, i)
    if not ty_eq(candidate, ty) { typeck_linear_layout_type_list_add_unique(result, candidate) } else { 0 }
  }
  result
}

pub(package) fn typeck_linear_layout_stack_contains(stack: i64, ty: i64) -> i64 {
  if stack == 0 { 0 }
  else { if ty_eq(node_f1(stack), ty) { 1 } else { typeck_linear_layout_stack_contains(node_f2(stack), ty) } }
}

pub(package) fn typeck_linear_layout_prepend_path(fact: i64, kind: i64, key: i64, index: i64, offset: i64) -> i64 {
  if typeck_linear_layout_fact_decision(fact) == typeck_linear_layout_decision_copyable() { fact }
  else {
    typeck_linear_layout_fact(
      typeck_linear_layout_fact_reason(fact),
      typeck_linear_layout_fact_decision(fact),
      typeck_linear_layout_fact_plan(fact),
      typeck_linear_layout_fact_offender(fact),
      typeck_linear_layout_path_segment(kind, key, index, offset, typeck_linear_layout_fact_path(fact))
    )
  }
}

pub(package) fn typeck_linear_layout_named_hash_is(type_hash: i64, name: str) -> i64 {
  if type_hash == str_hash(__str_ptr(name), 0, __str_len(name)) { 1 } else { 0 }
}

pub(package) fn typeck_linear_layout_named_is_container(type_hash: i64) -> i64 {
  typeck_linear_layout_named_hash_is(type_hash, "Vector") == 1 or
    typeck_linear_layout_named_hash_is(type_hash, "PersistentVector") == 1 or
    typeck_linear_layout_named_hash_is(type_hash, "Map") == 1 or
    typeck_linear_layout_named_hash_is(type_hash, "Set") == 1 or
    typeck_linear_layout_named_hash_is(type_hash, "SortedMap") == 1 or
    typeck_linear_layout_named_hash_is(type_hash, "SortedSet") == 1
}

pub(package) fn typeck_linear_layout_first_noncopyable_arg(tt: i64, types: i64, stack: i64) -> i64 {
  let count = if types == 0 { 0 } else { nlist_len(types) }
  let mut state = typeck_linear_layout_state(typeck_linear_layout_fact_copyable(), nlist_new())
  let mut i = 0
  while i < count and typeck_linear_layout_fact_decision(typeck_linear_layout_state_fact(state)) == typeck_linear_layout_decision_copyable() {
    let child = typeck_linear_layout_type_inner(tt, nlist_get(types, i), stack)
    let fact = typeck_linear_layout_prepend_path(typeck_linear_layout_state_fact(child), 4, 0, i, 0)
    state = typeck_linear_layout_state(fact, typeck_linear_layout_cycle_union(typeck_linear_layout_state_cycles(state), typeck_linear_layout_state_cycles(child)))
    i = i + 1
  }
  state
}

pub(package) fn typeck_linear_layout_structural_record(tt: i64, ty: i64, stack: i64) -> i64 {
  if ty_record_open(ty) == 1 {
    let fields = ty_record_fields(ty)
    let mut found = typeck_linear_layout_state(typeck_linear_layout_fact_copyable(), nlist_new())
    let count = if fields == 0 { 0 } else { nlist_len(fields) }
    let mut i = 0
    while i < count and typeck_linear_layout_fact_decision(typeck_linear_layout_state_fact(found)) == typeck_linear_layout_decision_copyable() {
      found = typeck_linear_layout_type_inner(tt, ty_record_field_type(nlist_get(fields, i)), stack)
      i = i + 1
    }
    if typeck_linear_layout_fact_decision(typeck_linear_layout_state_fact(found)) == typeck_linear_layout_decision_copyable() { found }
    else { typeck_linear_layout_state(typeck_linear_layout_fact_unsupported(ty, typeck_linear_layout_reason_open_record(), typeck_linear_layout_fact_path(typeck_linear_layout_state_fact(found))), typeck_linear_layout_state_cycles(found)) }
  } else {
    let fields = ty_record_fields(ty)
    let count = if fields == 0 { 0 } else { nlist_len(fields) }
    let children = nlist_new()
    let mut cycles = nlist_new()
    let mut first = typeck_linear_layout_fact_copyable()
    let mut offset = 0
    let mut i = 0
    while i < count and typeck_linear_layout_fact_decision(first) != typeck_linear_layout_decision_unsupported() {
      let field = ty_record_field_at_layout_index(ty, i)
      let field_ty = ty_record_field_type(field)
      let child = typeck_linear_layout_type_inner(tt, field_ty, stack)
      let kind = if ty_record_tuple_kind(ty) == 1 { 2 } else { 1 }
      let key = if kind == 1 { ty_record_field_hash(field) } else { 0 }
      let child_fact = typeck_linear_layout_prepend_path(typeck_linear_layout_state_fact(child), kind, key, i, offset)
      cycles = typeck_linear_layout_cycle_union(cycles, typeck_linear_layout_state_cycles(child))
      if typeck_linear_layout_fact_decision(child_fact) == typeck_linear_layout_decision_unsupported() { first = child_fact }
      else { if typeck_linear_layout_fact_decision(child_fact) == typeck_linear_layout_decision_linear() {
        nlist_add(children, typeck_linear_layout_component(kind, key, i, offset, typeck_linear_layout_fact_plan(child_fact)))
        if typeck_linear_layout_fact_decision(first) == typeck_linear_layout_decision_copyable() { first = child_fact } else { 0 }
      } else { 0 } }
      let words = ty_value_storage_word_count(field_ty)
      offset = offset + if words > 0 { words } else { 1 }
      i = i + 1
    }
    if typeck_linear_layout_fact_decision(first) == typeck_linear_layout_decision_unsupported() {
      typeck_linear_layout_state(first, cycles)
    } else { if nlist_len(children) == 0 {
      typeck_linear_layout_state(typeck_linear_layout_fact_copyable(), cycles)
    } else {
      let kind = if ty_record_tuple_kind(ty) == 1 { 3 } else { 2 }
      let plan = typeck_linear_layout_plan(kind, ty, children, offset, typeck_linear_layout_type_identity(ty))
      typeck_linear_layout_state(typeck_linear_layout_fact_linear(plan, typeck_linear_layout_fact_path(first)), cycles)
    } }
  }
}

pub(package) fn typeck_linear_layout_named_record(tt: i64, ty: i64, entry: i64, stack: i64) -> i64 {
  let fields = mem_load64_at(entry, 32)
  let count = mem_load64_at(entry, 24)
  let entry_src = mem_load64_at(entry, 48)
  let subst = type_cycle_subst_for_entry(entry, ty_f3(ty))
  let children = nlist_new()
  let mut cycles = nlist_new()
  let mut first = typeck_linear_layout_fact_copyable()
  let mut offset = 0
  let mut i = 0
  while i < count and typeck_linear_layout_fact_decision(first) != typeck_linear_layout_decision_unsupported() {
    let raw_ty = mem_load64_at(fields, i * 24 + 16)
    let field_ty = type_cycle_maybe_subst(raw_ty, subst)
    let field_hash = str_hash(entry_src, mem_load64_at(fields, i * 24), mem_load64_at(fields, i * 24 + 8))
    let child = typeck_linear_layout_type_inner(tt, field_ty, stack)
    let child_fact = typeck_linear_layout_prepend_path(typeck_linear_layout_state_fact(child), 1, field_hash, i, offset)
    cycles = typeck_linear_layout_cycle_union(cycles, typeck_linear_layout_state_cycles(child))
    if typeck_linear_layout_fact_decision(child_fact) == typeck_linear_layout_decision_unsupported() { first = child_fact }
    else { if typeck_linear_layout_fact_decision(child_fact) == typeck_linear_layout_decision_linear() {
      nlist_add(children, typeck_linear_layout_component(1, field_hash, i, offset, typeck_linear_layout_fact_plan(child_fact)))
      if typeck_linear_layout_fact_decision(first) == typeck_linear_layout_decision_copyable() { first = child_fact } else { 0 }
    } else { 0 } }
    let words = ty_value_storage_word_count(field_ty)
    offset = offset + if words > 0 { words } else { 1 }
    i = i + 1
  }
  if typeck_linear_layout_fact_decision(first) == typeck_linear_layout_decision_unsupported() {
    typeck_linear_layout_state(first, cycles)
  } else { if nlist_len(children) == 0 {
    typeck_linear_layout_state(typeck_linear_layout_fact_copyable(), cycles)
  } else {
    let plan = typeck_linear_layout_plan(4, ty, children, offset, typeck_linear_layout_type_identity(ty))
    typeck_linear_layout_state(typeck_linear_layout_fact_linear(plan, typeck_linear_layout_fact_path(first)), cycles)
  } }
}

pub(package) fn typeck_linear_layout_named_variant(tt: i64, ty: i64, entry: i64, stack: i64) -> i64 {
  let variants = mem_load64_at(entry, 32)
  let count = mem_load64_at(entry, 24)
  let subst = type_cycle_subst_for_entry(entry, ty_f3(ty))
  let alternatives = nlist_new()
  let mut cycles = nlist_new()
  let mut first = typeck_linear_layout_fact_copyable()
  let mut vi = 0
  while vi < count and typeck_linear_layout_fact_decision(first) != typeck_linear_layout_decision_unsupported() {
    let constructor_hash = mem_load64_at(variants, vi * 40 + 16)
    let payloads = mem_load64_at(variants, vi * 40 + 32)
    let npayloads = mem_load64_at(variants, vi * 40 + 24)
    let payload_plans = nlist_new()
    let mut offset = 1
    let mut pi = 0
    while pi < npayloads and typeck_linear_layout_fact_decision(first) != typeck_linear_layout_decision_unsupported() {
      let payload_ty = type_cycle_maybe_subst(nlist_get(payloads, pi), subst)
      let child = typeck_linear_layout_type_inner(tt, payload_ty, stack)
      let child_fact = typeck_linear_layout_prepend_path(typeck_linear_layout_state_fact(child), 3, constructor_hash, pi, offset)
      cycles = typeck_linear_layout_cycle_union(cycles, typeck_linear_layout_state_cycles(child))
      if typeck_linear_layout_fact_decision(child_fact) == typeck_linear_layout_decision_unsupported() { first = child_fact }
      else { if typeck_linear_layout_fact_decision(child_fact) == typeck_linear_layout_decision_linear() {
        nlist_add(payload_plans, typeck_linear_layout_component(3, constructor_hash, pi, offset, typeck_linear_layout_fact_plan(child_fact)))
        if typeck_linear_layout_fact_decision(first) == typeck_linear_layout_decision_copyable() { first = child_fact } else { 0 }
      } else { 0 } }
      let words = ty_value_storage_word_count(payload_ty)
      offset = offset + if words > 0 { words } else { 1 }
      pi = pi + 1
    }
    nlist_add(alternatives, typeck_linear_layout_variant_alternative(constructor_hash, vi, payload_plans, offset))
    vi = vi + 1
  }
  if typeck_linear_layout_fact_decision(first) == typeck_linear_layout_decision_unsupported() {
    typeck_linear_layout_state(first, cycles)
  } else { if typeck_linear_layout_fact_decision(first) == typeck_linear_layout_decision_copyable() {
    typeck_linear_layout_state(first, cycles)
  } else {
    let plan = typeck_linear_layout_plan(5, ty, alternatives, 1, typeck_linear_layout_type_identity(ty))
    typeck_linear_layout_state(typeck_linear_layout_fact_linear(plan, typeck_linear_layout_fact_path(first)), cycles)
  } }
}

pub(package) fn typeck_linear_layout_named(tt: i64, ty: i64, stack: i64) -> i64 {
  let type_hash = ty_f1(ty)
  let arg_state = typeck_linear_layout_first_noncopyable_arg(tt, ty_f3(ty), stack)
  let arg_fact = typeck_linear_layout_state_fact(arg_state)
  if typeck_linear_layout_named_is_container(type_hash) == 1 and typeck_linear_layout_fact_decision(arg_fact) != typeck_linear_layout_decision_copyable() {
    typeck_linear_layout_state(typeck_linear_layout_fact_unsupported(typeck_linear_layout_fact_offender(arg_fact), typeck_linear_layout_reason_container(), typeck_linear_layout_fact_path(arg_fact)), typeck_linear_layout_state_cycles(arg_state))
  } else { if typeck_linear_layout_stack_contains(stack, ty) == 1 {
    let cycles = nlist_new()
    nlist_add(cycles, ty)
    typeck_linear_layout_state(typeck_linear_layout_fact_copyable(), cycles)
  } else {
    let entry = if ty_named_is_opaque(ty) { ttable_lookup_decl_fact(tt, ty_named_opaque_declaration(ty)) } else { type_cycle_entry_for_hash(tt, type_hash) }
    if entry == 0 {
      if typeck_linear_layout_fact_decision(arg_fact) == typeck_linear_layout_decision_copyable() {
        typeck_linear_layout_state(typeck_linear_layout_fact_copyable(), typeck_linear_layout_state_cycles(arg_state))
      } else {
        typeck_linear_layout_state(typeck_linear_layout_fact_unsupported(ty, typeck_linear_layout_reason_unknown_nominal(), typeck_linear_layout_fact_path(arg_fact)), typeck_linear_layout_state_cycles(arg_state))
      }
    } else {
      let next_stack = node_new(0, ty, stack, 0, 0)
      let kind = mem_load64_at(entry, 16)
      let analyzed = if kind == 0 { typeck_linear_layout_named_record(tt, ty, entry, next_stack) }
        else { if kind == 1 { typeck_linear_layout_named_variant(tt, ty, entry, next_stack) }
        else { if kind == 5 {
          let subst = type_cycle_subst_for_entry(entry, ty_f3(ty))
          let representation = type_cycle_maybe_subst(ttable_entry_opaque_representation(entry), subst)
          let child = typeck_linear_layout_type_inner(tt, representation, next_stack)
          let child_fact = typeck_linear_layout_state_fact(child)
          if typeck_linear_layout_fact_decision(child_fact) == typeck_linear_layout_decision_linear() {
            let plan = typeck_linear_layout_plan(6, ty, typeck_linear_layout_fact_plan(child_fact), ty_value_storage_word_count(representation), typeck_linear_layout_type_identity(ty))
            typeck_linear_layout_state(typeck_linear_layout_fact_linear(plan, typeck_linear_layout_fact_path(child_fact)), typeck_linear_layout_state_cycles(child))
          } else { child }
        } else { typeck_linear_layout_state(typeck_linear_layout_fact_copyable(), nlist_new()) } } }
      let fact = typeck_linear_layout_state_fact(analyzed)
      let cycles = typeck_linear_layout_state_cycles(analyzed)
      if typeck_linear_layout_type_list_contains(cycles, ty) == 1 {
        let remaining = typeck_linear_layout_cycle_without(cycles, ty)
        if typeck_linear_layout_fact_decision(fact) == typeck_linear_layout_decision_linear() {
          typeck_linear_layout_state(typeck_linear_layout_fact_unsupported(ty, typeck_linear_layout_reason_recursive(), typeck_linear_layout_fact_path(fact)), remaining)
        } else { typeck_linear_layout_state(fact, remaining) }
      } else { analyzed }
    }
  } }
}

pub(package) fn typeck_linear_layout_unsupported_wrapper(tt: i64, ty: i64, inner: i64, reason: i64, stack: i64) -> i64 {
  let child = typeck_linear_layout_type_inner(tt, inner, stack)
  let fact = typeck_linear_layout_state_fact(child)
  if typeck_linear_layout_fact_decision(fact) == typeck_linear_layout_decision_copyable() { child }
  else { typeck_linear_layout_state(typeck_linear_layout_fact_unsupported(ty, reason, typeck_linear_layout_fact_path(fact)), typeck_linear_layout_state_cycles(child)) }
}

pub(package) fn typeck_linear_layout_unsupported_binary(tt: i64, ty: i64, left: i64, right: i64, reason: i64, stack: i64) -> i64 {
  let left_state = typeck_linear_layout_type_inner(tt, left, stack)
  let left_fact = typeck_linear_layout_state_fact(left_state)
  if typeck_linear_layout_fact_decision(left_fact) != typeck_linear_layout_decision_copyable() {
    typeck_linear_layout_state(typeck_linear_layout_fact_unsupported(ty, reason, typeck_linear_layout_fact_path(left_fact)), typeck_linear_layout_state_cycles(left_state))
  } else {
    let right_state = typeck_linear_layout_type_inner(tt, right, stack)
    let right_fact = typeck_linear_layout_state_fact(right_state)
    if typeck_linear_layout_fact_decision(right_fact) == typeck_linear_layout_decision_copyable() {
      typeck_linear_layout_state(typeck_linear_layout_fact_copyable(), typeck_linear_layout_cycle_union(typeck_linear_layout_state_cycles(left_state), typeck_linear_layout_state_cycles(right_state)))
    } else {
      typeck_linear_layout_state(typeck_linear_layout_fact_unsupported(ty, reason, typeck_linear_layout_fact_path(right_fact)), typeck_linear_layout_cycle_union(typeck_linear_layout_state_cycles(left_state), typeck_linear_layout_state_cycles(right_state)))
    }
  }
}

pub(package) fn typeck_linear_layout_type_inner(tt: i64, ty: i64, stack: i64) -> i64 {
  if ty == 0 { typeck_linear_layout_state(typeck_linear_layout_fact_unsupported(ty, typeck_linear_layout_reason_unresolved(), 0), nlist_new()) }
  else {
    match ty_tag(ty) {
      0 -> typeck_linear_layout_state(typeck_linear_layout_fact_copyable(), nlist_new())
      1 -> typeck_linear_layout_state(typeck_linear_layout_fact_copyable(), nlist_new())
      2 -> typeck_linear_layout_state(typeck_linear_layout_fact_copyable(), nlist_new())
      3 -> typeck_linear_layout_unsupported_binary(tt, ty, ty_f1(ty), ty_f2(ty), typeck_linear_layout_reason_set_operator(), stack)
      4 -> typeck_linear_layout_unsupported_binary(tt, ty, ty_f1(ty), ty_f2(ty), typeck_linear_layout_reason_set_operator(), stack)
      5 -> typeck_linear_layout_unsupported_wrapper(tt, ty, ty_f1(ty), typeck_linear_layout_reason_set_operator(), stack)
      -- Function signatures may mention owned parameters/results without the
      -- function value storing those resources.
      6 -> typeck_linear_layout_state(typeck_linear_layout_fact_copyable(), nlist_new())
      7 -> typeck_linear_layout_structural_record(tt, ty, stack)
      8 -> typeck_linear_layout_unsupported_wrapper(tt, ty, ty_f2(ty), typeck_linear_layout_reason_set_operator(), stack)
      9 -> typeck_linear_layout_named(tt, ty, stack)
      12 -> typeck_linear_layout_state(typeck_linear_layout_fact_copyable(), nlist_new())
      14 -> typeck_linear_layout_state(typeck_linear_layout_fact_copyable(), nlist_new())
      15 -> typeck_linear_layout_state(typeck_linear_layout_fact_copyable(), nlist_new())
      16 -> typeck_linear_layout_state(typeck_linear_layout_fact_copyable(), nlist_new())
      17 -> typeck_linear_layout_state(typeck_linear_layout_fact_copyable(), nlist_new())
      18 -> typeck_linear_layout_state(typeck_linear_layout_fact_unsupported(ty, typeck_linear_layout_reason_unique(), 0), nlist_new())
      19 -> {
        -- `owned` is a named Drop-resource boundary and therefore always has
        -- one ABI owner lane even when an imported opaque resource hides its
        -- representation. The generic IR uses the same one-lane fallback;
        -- preserve it in the cleanup plan so effect transfers remain exact.
        let storage_words = ty_value_storage_word_count(ty)
        let plan = typeck_linear_layout_plan(1, ty, 0, if storage_words > 0 { storage_words } else { 1 }, typeck_linear_layout_type_identity(ty))
        typeck_linear_layout_state(typeck_linear_layout_fact_linear(plan, 0), nlist_new())
      }
      20 -> typeck_linear_layout_state(typeck_linear_layout_fact_copyable(), nlist_new())
      21 -> typeck_linear_layout_state(typeck_linear_layout_fact_copyable(), nlist_new())
      22 -> typeck_linear_layout_unsupported_wrapper(tt, ty, ty_array_inner(ty), typeck_linear_layout_reason_container(), stack)
      23 -> typeck_linear_layout_state(typeck_linear_layout_fact_copyable(), nlist_new())
      29 -> typeck_linear_layout_state(typeck_linear_layout_fact_copyable(), nlist_new())
      _ -> typeck_linear_layout_state(typeck_linear_layout_fact_copyable(), nlist_new())
    }
  }
}

pub(package) fn typeck_linear_layout_type(tt: i64, ty: i64) -> i64 {
  let cached = ttable_linear_layout_fact_lookup(tt, ty)
  if cached != 0 { cached }
  else {
    let state = typeck_linear_layout_type_inner(tt, ty, 0)
    let fact = typeck_linear_layout_state_fact(state)
    let resolved = if nlist_len(typeck_linear_layout_state_cycles(state)) > 0 and typeck_linear_layout_fact_decision(fact) == typeck_linear_layout_decision_linear() {
      typeck_linear_layout_fact_unsupported(ty, typeck_linear_layout_reason_recursive(), typeck_linear_layout_fact_path(fact))
    } else { fact }
    ttable_linear_layout_fact_store(tt, ty, resolved)
  }
}

-- structural Sendable: the shared structural Sendable fact. Sendability is a sealed
-- compiler predicate, not an open trait implementation. The fact separates
-- the structural decision from the boundary work still required by a value:
-- managed graph promotion, capture-specific closure proof, or scoped borrow
-- provenance. Consumers may be narrower while their transport mechanism is
-- incomplete, but they consume this fact instead of privately walking types.
--
-- Fact node layout (reason lives in node tag):
--   f1 decision: 1 accepted, 0 unresolved/evidence required, -1 rejected
--   f2 requirement bits
--   f3 first offending/unresolved type
--   f4 persistent component path (outermost segment first)
-- Requirement bits:
--   1 = managed reachable state needs transitive one-way promotion
--   2 = a concrete closure value must prove pure Sendable captures
--   4 = a slice value must prove immutable scoped-join provenance
--   8 = a named record is eligible for the current inline scalar transport
--       (this refines bit 1; it is not itself work required at the boundary)
pub(package) fn typeck_sendability_decision_yes() -> i64 { 1 }
pub(package) fn typeck_sendability_decision_unknown() -> i64 { 0 }
pub(package) fn typeck_sendability_decision_no() -> i64 { 0 - 1 }
pub(package) fn typeck_sendability_needs_promotion() -> i64 { 1 }
pub(package) fn typeck_sendability_needs_capture_proof() -> i64 { 2 }
pub(package) fn typeck_sendability_needs_scoped_borrow() -> i64 { 4 }
pub(package) fn typeck_sendability_inline_scalar_record() -> i64 { 8 }

pub(package) fn typeck_sendability_reason_none() -> i64 { 0 }
pub(package) fn typeck_sendability_reason_any() -> i64 { 1 }
pub(package) fn typeck_sendability_reason_effectful_function() -> i64 { 2 }
pub(package) fn typeck_sendability_reason_raw_pointer() -> i64 { 3 }
pub(package) fn typeck_sendability_reason_continuation() -> i64 { 4 }
pub(package) fn typeck_sendability_reason_mutable_slice() -> i64 { 5 }
pub(package) fn typeck_sendability_reason_owned_resource() -> i64 { 6 }
pub(package) fn typeck_sendability_reason_mutable_state() -> i64 { 7 }
pub(package) fn typeck_sendability_reason_runtime_token() -> i64 { 8 }
pub(package) fn typeck_sendability_reason_unsupported_type() -> i64 { 9 }
pub(package) fn typeck_sendability_reason_open_record() -> i64 { 10 }
pub(package) fn typeck_sendability_reason_type_evidence() -> i64 { 11 }
pub(package) fn typeck_sendability_reason_unknown_nominal() -> i64 { 12 }
pub(package) fn typeck_sendability_reason_capture_unproven() -> i64 { 13 }
pub(package) fn typeck_sendability_reason_mutable_capture() -> i64 { 14 }
pub(package) fn typeck_sendability_reason_linear_capture() -> i64 { 15 }

pub(package) fn typeck_sendability_fact(reason: i64, decision: i64, needs: i64, offender: i64, path: i64) -> i64 {
  node_new(reason, decision, needs, offender, path)
}

pub(package) fn typeck_sendability_fact_yes(needs: i64) -> i64 {
  typeck_sendability_fact(typeck_sendability_reason_none(), typeck_sendability_decision_yes(), needs, 0, 0)
}

pub(package) fn typeck_sendability_fact_unknown(ty: i64, reason: i64) -> i64 {
  typeck_sendability_fact(reason, typeck_sendability_decision_unknown(), 0, ty, 0)
}

pub(package) fn typeck_sendability_fact_no(ty: i64, reason: i64) -> i64 {
  typeck_sendability_fact(reason, typeck_sendability_decision_no(), 0, ty, 0)
}

pub(package) fn typeck_sendability_fact_decision(fact: i64) -> i64 { if fact == 0 { 0 - 1 } else { node_f1(fact) } }
pub(package) fn typeck_sendability_fact_needs(fact: i64) -> i64 { if fact == 0 { 0 } else { node_f2(fact) } }
pub(package) fn typeck_sendability_fact_offender(fact: i64) -> i64 { if fact == 0 { 0 } else { node_f3(fact) } }
pub(package) fn typeck_sendability_fact_path(fact: i64) -> i64 { if fact == 0 { 0 } else { node_f4(fact) } }
pub(package) fn typeck_sendability_fact_reason(fact: i64) -> i64 { if fact == 0 { typeck_sendability_reason_unsupported_type() } else { node_tag(fact) } }

-- Path segment kinds: 1 structural/named field hash, 2 tuple position,
-- 3 variant payload position, 4 nominal type argument, 5 closure capture.
-- Capture segments additionally carry the source-name span in f4 so a
-- consumer can diagnose the binding without rescanning the lambda body.
pub(package) fn typeck_sendability_path_segment(kind: i64, key: i64, index: i64, rest: i64) -> i64 {
  node_new(kind, key, index, rest, 0)
}
pub(package) fn typeck_sendability_capture_path_segment(key: i64, index: i64, rest: i64, span: i64) -> i64 {
  node_new(5, key, index, rest, span)
}
pub(package) fn typeck_sendability_path_kind(path: i64) -> i64 { if path == 0 { 0 } else { node_tag(path) } }
pub(package) fn typeck_sendability_path_key(path: i64) -> i64 { if path == 0 { 0 } else { node_f1(path) } }
pub(package) fn typeck_sendability_path_index(path: i64) -> i64 { if path == 0 { 0 - 1 } else { node_f2(path) } }
pub(package) fn typeck_sendability_path_rest(path: i64) -> i64 { if path == 0 { 0 } else { node_f3(path) } }
pub(package) fn typeck_sendability_path_span(path: i64) -> i64 { if path == 0 { 0 } else { node_f4(path) } }

pub(package) fn typeck_sendability_fact_prepend_path(fact: i64, kind: i64, key: i64, index: i64) -> i64 {
  if typeck_sendability_fact_decision(fact) == typeck_sendability_decision_yes() { fact }
  else {
    typeck_sendability_fact(
      typeck_sendability_fact_reason(fact),
      typeck_sendability_fact_decision(fact),
      typeck_sendability_fact_needs(fact),
      typeck_sendability_fact_offender(fact),
      typeck_sendability_path_segment(kind, key, index, typeck_sendability_fact_path(fact))
    )
  }
}

pub(package) fn typeck_sendability_fact_with_needs(fact: i64, needs: i64) -> i64 {
  if typeck_sendability_fact_decision(fact) != typeck_sendability_decision_yes() { fact }
  else {
    typeck_sendability_fact_yes(typeck_sendability_fact_needs(fact) bor needs)
  }
}

pub(package) fn typeck_sendability_fact_without_needs(fact: i64, needs: i64) -> i64 {
  if typeck_sendability_fact_decision(fact) != typeck_sendability_decision_yes() { fact }
  else { typeck_sendability_fact_yes(typeck_sendability_fact_needs(fact) band (0 - 1 - needs)) }
}

pub(package) fn typeck_sendability_fact_prepend_capture(fact: i64, key: i64, index: i64, span: i64) -> i64 {
  if typeck_sendability_fact_decision(fact) == typeck_sendability_decision_yes() { fact }
  else {
    typeck_sendability_fact(
      typeck_sendability_fact_reason(fact),
      typeck_sendability_fact_decision(fact),
      typeck_sendability_fact_needs(fact),
      typeck_sendability_fact_offender(fact),
      typeck_sendability_capture_path_segment(key, index, typeck_sendability_fact_path(fact), span)
    )
  }
}

pub(package) fn typeck_sendability_fact_combine(left: i64, right: i64) -> i64 {
  let ld = typeck_sendability_fact_decision(left)
  let rd = typeck_sendability_fact_decision(right)
  if ld == typeck_sendability_decision_no() { left }
  else { if rd == typeck_sendability_decision_no() { right }
  else { if ld == typeck_sendability_decision_unknown() { left }
  else { if rd == typeck_sendability_decision_unknown() { right }
  else { typeck_sendability_fact_yes(typeck_sendability_fact_needs(left) bor typeck_sendability_fact_needs(right)) } } } }
}

pub(package) fn typeck_sendability_visited_contains(visited: i64, ty: i64) -> i64 {
  let mut found = 0
  let mut i = 0
  while i < nlist_len(visited) and found == 0 {
    if ty_eq(nlist_get(visited, i), ty) { found = 1 } else { i = i + 1 }
  }
  found
}

pub(package) fn typeck_sendability_type_list(tt: i64, types: i64, visited: i64, path_kind: i64) -> i64 {
  let mut fact = typeck_sendability_fact_yes(0)
  let count = if types == 0 { 0 } else { nlist_len(types) }
  let mut i = 0
  while i < count and typeck_sendability_fact_decision(fact) == typeck_sendability_decision_yes() {
    let child = typeck_sendability_type_inner(tt, nlist_get(types, i), visited)
    fact = typeck_sendability_fact_combine(fact, typeck_sendability_fact_prepend_path(child, path_kind, 0, i))
    i = i + 1
  }
  fact
}

pub(package) fn typeck_sendability_record_fields(tt: i64, record_ty: i64, visited: i64) -> i64 {
  let fields = ty_record_fields(record_ty)
  let count = if fields == 0 { 0 } else { nlist_len(fields) }
  let path_kind = if ty_record_tuple_kind(record_ty) == 1 { 2 } else { 1 }
  let mut fact = typeck_sendability_fact_yes(0)
  let mut i = 0
  while i < count and typeck_sendability_fact_decision(fact) == typeck_sendability_decision_yes() {
    let field = ty_record_field_at_layout_index(record_ty, i)
    let child = typeck_sendability_type_inner(tt, ty_record_field_type(field), visited)
    let key = if path_kind == 1 { ty_record_field_hash(field) } else { 0 }
    fact = typeck_sendability_fact_combine(fact, typeck_sendability_fact_prepend_path(child, path_kind, key, i))
    i = i + 1
  }
  fact
}

pub(package) fn typeck_sendability_named_hash_is(type_hash: i64, name: str) -> i64 {
  if type_hash == str_hash(__str_ptr(name), 0, __str_len(name)) { 1 } else { 0 }
}

-- Trusted concurrency surfaces are classified from their resolved declaration
-- identity. A same-spelled declaration in another module is ordinary code and
-- never acquires boundary or runtime-token semantics from its short name.
pub(package) fn typeck_decl_identity_is(declaration: i64, module_path: str, name: str) -> i64 {
  if declaration == 0 { 0 }
  else {
    let module = module_decl_fact_module(declaration)
    if module == 0 or module_fact_entry_path_len(module) != __str_len(module_path) or
      module_decl_fact_name_len(declaration) != __str_len(name) { 0 }
    else { if src_eq_at(module_fact_entry_path_ptr(module), 0, __str_ptr(module_path), 0, __str_len(module_path)) == 0 { 0 }
    else { src_eq_at(module_decl_fact_name_ptr(declaration), 0, __str_ptr(name), 0, __str_len(name)) } }
  }
}

pub(package) fn typeck_named_is_task(tt: i64, ty: i64) -> i64 {
  if ty == 0 or ty_tag(ty) != 9 or not ty_named_is_opaque(ty) { 0 }
  else {
    let declaration = ty_named_opaque_declaration(ty)
    typeck_decl_identity_is(declaration, "stdlib/task", "Task")
  }
}

pub(package) fn typeck_type_list_contains_task(tt: i64, types: i64) -> bool {
  if types == 0 { false }
  else {
    let mut found = false
    for i in 0..nlist_len(types) {
      if typeck_ty_contains_task(tt, nlist_get(types, i)) { found = true } else { 0 }
    }
    found
  }
}

pub(package) fn typeck_record_fields_contain_task(tt: i64, fields: i64) -> bool {
  if fields == 0 { false }
  else {
    let mut found = false
    for i in 0..nlist_len(fields) {
      if typeck_ty_contains_task(tt, ty_record_field_type(nlist_get(fields, i))) { found = true } else { 0 }
    }
    found
  }
}

pub(package) fn typeck_ty_contains_task(tt: i64, ty: i64) -> bool {
  if ty == 0 { false }
  else { if typeck_named_is_task(tt, ty) == 1 { true }
  else {
    match ty_tag(ty) {
      3 -> typeck_ty_contains_task(tt, ty_f1(ty)) or typeck_ty_contains_task(tt, ty_f2(ty))
      4 -> typeck_ty_contains_task(tt, ty_f1(ty)) or typeck_ty_contains_task(tt, ty_f2(ty))
      5 -> typeck_ty_contains_task(tt, ty_f1(ty))
      6 -> typeck_type_list_contains_task(tt, ty_f1(ty)) or typeck_ty_contains_task(tt, ty_f2(ty))
      7 -> typeck_record_fields_contain_task(tt, ty_record_fields(ty))
      8 -> typeck_ty_contains_task(tt, ty_f2(ty))
      9 -> typeck_ty_contains_task(tt, ty_f2(ty)) or typeck_type_list_contains_task(tt, ty_f3(ty))
      11 -> typeck_type_list_contains_task(tt, ty_f2(ty))
      14 -> typeck_ty_contains_task(tt, ty_f1(ty)) or typeck_ty_contains_task(tt, ty_f2(ty))
      15 -> typeck_ty_contains_task(tt, ty_f1(ty))
      16 -> typeck_ty_contains_task(tt, ty_f1(ty))
      17 -> typeck_ty_contains_task(tt, ty_f1(ty))
      18 -> typeck_ty_contains_task(tt, ty_unique_inner(ty))
      19 -> typeck_ty_contains_task(tt, ty_owned_inner(ty))
      22 -> typeck_ty_contains_task(tt, ty_array_inner(ty))
      23 -> typeck_ty_contains_task(tt, ty_slice_inner(ty))
      _ -> false
    }
  } }
}

pub(package) fn typeck_sendability_named_is_mutable_state(type_hash: i64) -> i64 {
  typeck_sendability_named_hash_is(type_hash, "Vector") == 1
}

pub(package) fn typeck_sendability_named_is_runtime_token(type_hash: i64) -> i64 {
  typeck_sendability_named_hash_is(type_hash, "Iterator") == 1 or
    typeck_sendability_named_hash_is(type_hash, "Generator") == 1 or
    typeck_sendability_named_hash_is(type_hash, "ParTask") == 1
}

pub(package) fn typeck_sendability_named_is_persistent(type_hash: i64) -> i64 {
  typeck_sendability_named_hash_is(type_hash, "PersistentVector") == 1 or
    typeck_sendability_named_hash_is(type_hash, "Map") == 1 or
    typeck_sendability_named_hash_is(type_hash, "Set") == 1 or
    typeck_sendability_named_hash_is(type_hash, "SortedMap") == 1 or
    typeck_sendability_named_hash_is(type_hash, "SortedSet") == 1
}

pub(package) fn typeck_sendability_plain_inline_field(ty: i64) -> i64 {
  if ty == 0 or ty_tag(ty) != 2 { 0 }
  else { if ty_f1(ty) == PRIM_STR() or ty_f1(ty) == PRIM_NIL() { 0 } else { 1 } }
}

pub(package) fn typeck_sendability_named_entry(tt: i64, named_ty: i64, entry: i64, visited: i64) -> i64 {
  let kind = mem_load64_at(entry, 16)
  let subst = type_cycle_subst_for_entry(entry, ty_f3(named_ty))
  let mut fact = typeck_sendability_fact_yes(0)
  if kind == 0 {
    let fields = mem_load64_at(entry, 32)
    let count = mem_load64_at(entry, 24)
    let mut inline_scalar = if count > 0 { 1 } else { 0 }
    let mut i = 0
    while i < count and typeck_sendability_fact_decision(fact) == typeck_sendability_decision_yes() {
      let field_hash = str_hash(mem_load64_at(entry, 48), mem_load64_at(fields, i * 24), mem_load64_at(fields, i * 24 + 8))
      let field_ty = type_cycle_maybe_subst(mem_load64_at(fields, i * 24 + 16), subst)
      if typeck_sendability_plain_inline_field(field_ty) == 0 { inline_scalar = 0 } else { 0 }
      let child = typeck_sendability_type_inner(tt, field_ty, visited)
      fact = typeck_sendability_fact_combine(fact, typeck_sendability_fact_prepend_path(child, 1, field_hash, i))
      i = i + 1
    }
    if typeck_sendability_fact_decision(fact) == typeck_sendability_decision_yes() {
      let root_needs = typeck_sendability_needs_promotion() bor if inline_scalar == 1 { typeck_sendability_inline_scalar_record() } else { 0 }
      typeck_sendability_fact_with_needs(fact, root_needs)
    } else { fact }
  } else { if kind == 1 {
    let variants = mem_load64_at(entry, 32)
    let count = mem_load64_at(entry, 24)
    let mut vi = 0
    while vi < count and typeck_sendability_fact_decision(fact) == typeck_sendability_decision_yes() {
      let payloads = mem_load64_at(variants, vi * 40 + 32)
      let npayloads = mem_load64_at(variants, vi * 40 + 24)
      let mut pi = 0
      while pi < npayloads and typeck_sendability_fact_decision(fact) == typeck_sendability_decision_yes() {
        let payload_ty = type_cycle_maybe_subst(nlist_get(payloads, pi), subst)
        let child = typeck_sendability_type_inner(tt, payload_ty, visited)
        fact = typeck_sendability_fact_combine(fact, typeck_sendability_fact_prepend_path(child, 3, vi, pi))
        pi = pi + 1
      }
      vi = vi + 1
    }
    typeck_sendability_fact_with_needs(fact, typeck_sendability_needs_promotion())
  } else { if kind == 5 {
    -- Opaque identity is a typing boundary, not a semantic-fact boundary.
    -- Thread transport follows the fully substituted representation just as
    -- layout, ownership and ABI lanes do; constructor/projection authority
    -- remains private to the declaring module.
    let representation = type_cycle_maybe_subst(ttable_entry_opaque_representation(entry), subst)
    typeck_sendability_type_inner(tt, representation, visited)
  } else { typeck_sendability_fact_no(named_ty, typeck_sendability_reason_unknown_nominal()) } } }
}

pub(package) fn typeck_sendability_named(tt: i64, ty: i64, visited: i64) -> i64 {
  let type_hash = ty_f1(ty)
  if ty_is_rc(ty) == 1 {
    typeck_sendability_fact_with_needs(typeck_sendability_type_inner(tt, ty_rc_inner(ty), visited), typeck_sendability_needs_promotion())
  } else { if typeck_named_is_task(tt, ty) == 1 {
    typeck_sendability_fact_no(ty, typeck_sendability_reason_runtime_token())
  } else { if typeck_sendability_named_is_mutable_state(type_hash) == 1 {
    typeck_sendability_fact_no(ty, typeck_sendability_reason_mutable_state())
  } else { if typeck_sendability_named_is_runtime_token(type_hash) == 1 {
    typeck_sendability_fact_no(ty, typeck_sendability_reason_runtime_token())
  } else { if typeck_sendability_visited_contains(visited, ty) == 1 {
    -- Immutable recursive types use the greatest fixed point: a revisit is
    -- provisionally safe and any concrete rejecting leaf still wins outside.
    typeck_sendability_fact_yes(0)
  } else {
    nlist_add(visited, ty)
    if typeck_sendability_named_is_persistent(type_hash) == 1 {
      typeck_sendability_fact_with_needs(typeck_sendability_type_list(tt, ty_f3(ty), visited, 4), typeck_sendability_needs_promotion())
    } else {
      -- Opaque types carry their exact declaration identity because same-
      -- spelled wrappers from different modules may hide different
      -- representations. Never recover that semantic fact by head hash.
      let entry = if ty_named_is_opaque(ty) {
        ttable_lookup_decl_fact(tt, ty_named_opaque_declaration(ty))
      } else {
        type_cycle_entry_for_hash(tt, type_hash)
      }
      if entry == 0 { typeck_sendability_fact_no(ty, typeck_sendability_reason_unknown_nominal()) }
      else { typeck_sendability_named_entry(tt, ty, entry, visited) }
    }
  } } } } }
}

pub(package) fn typeck_sendability_type_inner(tt: i64, ty: i64, visited: i64) -> i64 {
  if ty == 0 { typeck_sendability_fact_no(ty, typeck_sendability_reason_unsupported_type()) }
  else {
    let tag = ty_tag(ty)
    match tag {
      0 -> typeck_sendability_fact_yes(0)
      1 -> typeck_sendability_fact_no(ty, typeck_sendability_reason_any())
      2 -> if ty_f1(ty) == PRIM_STR() { typeck_sendability_fact_yes(typeck_sendability_needs_promotion()) } else { typeck_sendability_fact_yes(0) }
      3 -> typeck_sendability_fact_combine(typeck_sendability_type_inner(tt, ty_f1(ty), visited), typeck_sendability_type_inner(tt, ty_f2(ty), visited))
      4 -> typeck_sendability_fact_combine(typeck_sendability_type_inner(tt, ty_f1(ty), visited), typeck_sendability_type_inner(tt, ty_f2(ty), visited))
      5 -> typeck_sendability_fact_no(ty, typeck_sendability_reason_unsupported_type())
      6 -> {
        let eff = ty_f3(ty)
        if eff != 0 and ty_tag(eff) == 10 and nlist_len(ty_f1(eff)) == 0 and ty_f2(eff) == 0 {
          typeck_sendability_fact_yes(typeck_sendability_needs_capture_proof())
        } else { typeck_sendability_fact_no(ty, typeck_sendability_reason_effectful_function()) }
      }
      7 -> if ty_record_open(ty) == 1 { typeck_sendability_fact_no(ty, typeck_sendability_reason_open_record()) } else { typeck_sendability_record_fields(tt, ty, visited) }
      8 -> typeck_sendability_fact_with_needs(typeck_sendability_type_inner(tt, ty_f2(ty), visited), typeck_sendability_needs_promotion())
      9 -> typeck_sendability_named(tt, ty, visited)
      12 -> typeck_sendability_fact_unknown(ty, typeck_sendability_reason_type_evidence())
      14 -> typeck_sendability_fact_no(ty, typeck_sendability_reason_continuation())
      15 -> typeck_sendability_fact_no(ty, typeck_sendability_reason_raw_pointer())
      16 -> typeck_sendability_fact_with_needs(typeck_sendability_type_inner(tt, ty_weak_inner(ty), visited), typeck_sendability_needs_promotion())
      17 -> typeck_sendability_fact_with_needs(typeck_sendability_type_inner(tt, ty_arc_inner(ty), visited), typeck_sendability_needs_promotion())
      18 -> typeck_sendability_type_inner(tt, ty_unique_inner(ty), visited)
      19 -> typeck_sendability_fact_no(ty, typeck_sendability_reason_owned_resource())
      22 -> typeck_sendability_fact_with_needs(typeck_sendability_type_inner(tt, ty_array_inner(ty), visited), typeck_sendability_needs_promotion())
      23 -> if ty_slice_mutable(ty) == 1 { typeck_sendability_fact_no(ty, typeck_sendability_reason_mutable_slice()) }
        else { typeck_sendability_fact_with_needs(typeck_sendability_type_inner(tt, ty_slice_inner(ty), visited), typeck_sendability_needs_scoped_borrow()) }
      _ -> typeck_sendability_fact_no(ty, typeck_sendability_reason_unsupported_type())
    }
  }
}

pub(package) fn typeck_sendability_type(tt: i64, ty: i64) -> i64 {
  typeck_sendability_type_inner(tt, ty, nlist_new())
}

-- Value sendability discharges requirements that a type alone cannot prove.
-- In particular, pure function types are only candidates: a concrete closure
-- must recursively prove every actual capture, and an immutable slice must
-- retain its scoped-join requirement for the boundary consumer.
pub(package) fn typeck_sendability_seen_capture_name(seen: i64, entry: i64) -> i64 {
  let mut found = 0
  let mut i = 0
  while i < nlist_len(seen) and found == 0 {
    let prior = nlist_get(seen, i)
    let entry_src = mem_load64_at(entry, 24)
    let prior_src = mem_load64_at(prior, 24)
    let entry_len = mem_load64_at(entry, 8)
    if entry_len == mem_load64_at(prior, 8) and src_eq_at(entry_src, mem_load64_at(entry, 0), prior_src + mem_load64_at(prior, 0), 0, entry_len) == 1 {
      found = 1
    } else { i = i + 1 }
  }
  found
}

pub(package) fn typeck_sendability_function_root(tt: i64, ty: i64, allow_effectful: i64) -> i64 {
  if allow_effectful == 1 and ty != 0 and ty_tag(ty) == 6 {
    typeck_sendability_fact_yes(typeck_sendability_needs_capture_proof())
  } else { typeck_sendability_type(tt, ty) }
}

pub(package) fn typeck_sendability_closure_capture_fact_with_mode(tt: i64, lambda: i64, outer_env: i64, ft: i64, src: i64, allow_effectful: i64) -> i64 {
  let lambda_ty = synth_lambda(lambda, outer_env, ft, src, tt)
  let root = typeck_sendability_function_root(tt, lambda_ty, allow_effectful)
  if typeck_sendability_fact_decision(root) != typeck_sendability_decision_yes() { root }
  else {
    let params = node_f1(lambda)
    let body = node_f2(lambda)
    let seen = nlist_new()
    let mut captures = typeck_sendability_fact_yes(0)
    let mut entry = outer_env
    let mut capture_index = 0
    while entry != 0 and typeck_sendability_fact_decision(captures) == typeck_sendability_decision_yes() {
      if typeck_sendability_seen_capture_name(seen, entry) == 0 {
        nlist_add(seen, entry)
        let entry_src = mem_load64_at(entry, 24)
        let ns = mem_load64_at(entry, 0)
        let nl = mem_load64_at(entry, 8)
        if unique_params_bind_name(params, node_f3(lambda), src, entry_src, ns, nl) == 0 and unique_ref_count_name(body, src, entry_src, ns, nl) > 0 {
          let capture_ty = mem_load64_at(entry, 16)
          let child = if mem_load64_at(entry, 40) == 1 {
            typeck_sendability_fact_no(capture_ty, typeck_sendability_reason_mutable_capture())
          } else { if typeck_ty_is_linear(tt, capture_ty) == 1 {
            typeck_sendability_fact_no(capture_ty, typeck_sendability_reason_linear_capture())
          } else {
            let type_fact = typeck_sendability_function_root(tt, capture_ty, allow_effectful)
            if typeck_sendability_fact_decision(type_fact) == typeck_sendability_decision_yes() and (typeck_sendability_fact_needs(type_fact) band typeck_sendability_needs_capture_proof()) != 0 {
              let origin = mem_load64_at(entry, 48)
              if origin != 0 and node_tag(origin) == 29 {
                typeck_sendability_closure_capture_fact_with_mode(tt, origin, mem_load64_at(entry, 32), ft, entry_src, allow_effectful)
              } else { typeck_sendability_fact_unknown(capture_ty, typeck_sendability_reason_capture_unproven()) }
            } else { type_fact }
          } }
          let key = str_hash(entry_src, ns, nl)
          captures = typeck_sendability_fact_combine(captures, typeck_sendability_fact_prepend_capture(child, key, capture_index, ns))
          capture_index = capture_index + 1
        } else { 0 }
      } else { 0 }
      entry = mem_load64_at(entry, 32)
    }
    if typeck_sendability_fact_decision(captures) == typeck_sendability_decision_yes() {
      typeck_sendability_fact_without_needs(
        typeck_sendability_fact_combine(root, captures),
        typeck_sendability_needs_capture_proof()
      )
    } else { captures }
  }
}

pub(package) fn typeck_sendability_closure_capture_fact(tt: i64, lambda: i64, outer_env: i64, ft: i64, src: i64) -> i64 {
  typeck_sendability_closure_capture_fact_with_mode(tt, lambda, outer_env, ft, src, 0)
}

pub(package) fn typeck_sendability_tenv_entry(env: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let mut entry = env
  let mut result = 0
  while entry != 0 and result == 0 {
    let entry_src = mem_load64_at(entry, 24)
    if nl == mem_load64_at(entry, 8) and src_eq_at(src, ns, entry_src + mem_load64_at(entry, 0), 0, nl) == 1 {
      result = entry
    } else { entry = mem_load64_at(entry, 32) }
  }
  result
}

pub(package) fn typeck_sendability_capture_path_type(path: i64, env: i64) -> i64 {
  if path == 0 or typeck_sendability_path_kind(path) != 5 { 0 }
  else {
    let key = typeck_sendability_path_key(path)
    let mut entry = env
    let mut result = 0
    while entry != 0 and result == 0 {
      let entry_src = mem_load64_at(entry, 24)
      if str_hash(entry_src, mem_load64_at(entry, 0), mem_load64_at(entry, 8)) == key {
        result = mem_load64_at(entry, 16)
      } else { entry = mem_load64_at(entry, 32) }
    }
    result
  }
}

pub(package) fn typeck_sendability_value_with_mode(tt: i64, value: i64, env: i64, ft: i64, src: i64, allow_effectful: i64) -> i64 {
  if value == 0 { typeck_sendability_fact_no(0, typeck_sendability_reason_unsupported_type()) }
  else { if node_tag(value) == 29 {
    typeck_sendability_closure_capture_fact_with_mode(tt, value, env, ft, src, allow_effectful)
  } else { if node_tag(value) == 2 {
    let entry = typeck_sendability_tenv_entry(env, src, node_f1(value), node_f2(value))
    if entry != 0 {
      let value_ty = mem_load64_at(entry, 16)
      let type_fact = typeck_sendability_function_root(tt, value_ty, allow_effectful)
      if typeck_sendability_fact_decision(type_fact) == typeck_sendability_decision_yes() and (typeck_sendability_fact_needs(type_fact) band typeck_sendability_needs_capture_proof()) != 0 {
        let origin = mem_load64_at(entry, 48)
        if origin != 0 and node_tag(origin) == 29 {
          typeck_sendability_closure_capture_fact_with_mode(tt, origin, mem_load64_at(entry, 32), ft, mem_load64_at(entry, 24), allow_effectful)
        } else { typeck_sendability_fact_unknown(value_ty, typeck_sendability_reason_capture_unproven()) }
      } else { type_fact }
    } else {
      let value_ty = ftypes_lookup_fn_type(ft, src, node_f1(value), node_f2(value))
      let type_fact = if value_ty == 0 { typeck_sendability_function_root(tt, synth(value, env, ft, src, tt), allow_effectful) }
        else { typeck_sendability_function_root(tt, value_ty, allow_effectful) }
      if value_ty != 0 { typeck_sendability_fact_without_needs(type_fact, typeck_sendability_needs_capture_proof()) }
      else { type_fact }
    }
  } else {
    let type_fact = typeck_sendability_function_root(tt, synth(value, env, ft, src, tt), allow_effectful)
    if typeck_sendability_fact_decision(type_fact) == typeck_sendability_decision_yes() and (typeck_sendability_fact_needs(type_fact) band typeck_sendability_needs_capture_proof()) != 0 {
      typeck_sendability_fact_unknown(typeck_sendability_fact_offender(type_fact), typeck_sendability_reason_capture_unproven())
    } else { type_fact }
  } } }
}

pub(package) fn typeck_sendability_value(tt: i64, value: i64, env: i64, ft: i64, src: i64) -> i64 {
  typeck_sendability_value_with_mode(tt, value, env, ft, src, 0)
}

pub(package) fn typeck_concurrency_boundary_none() -> i64 { 0 }
pub(package) fn typeck_concurrency_boundary_task_submit() -> i64 { 1 }
pub(package) fn typeck_concurrency_boundary_task_scope() -> i64 { 2 }
pub(package) fn typeck_concurrency_boundary_task_channel_scope() -> i64 { 3 }

pub(package) fn typeck_task_surface_decl_is(declaration: i64, name: str) -> i64 {
  typeck_decl_identity_is(declaration, "stdlib/task", name)
}

-- This is the single semantic producer for the structured-task
-- boundary. Consumers receive a kind from the resolved DeclId; they never
-- infer authority from a call's spelling or from an arbitrary matching
-- function signature.
pub(package) fn typeck_concurrency_boundary_for_entry(entry: i64) -> i64 {
  let declaration = ftypes_entry_decl_fact(entry)
  match declaration {
    candidate if typeck_task_surface_decl_is(candidate, "spawn") == 1 -> typeck_concurrency_boundary_task_submit()
    candidate if typeck_task_surface_decl_is(candidate, "with_sequential_channel") == 1 -> typeck_concurrency_boundary_task_channel_scope()
    candidate if typeck_task_surface_decl_is(candidate, "with_event_loop_channel") == 1 -> typeck_concurrency_boundary_task_channel_scope()
    candidate if typeck_task_surface_decl_is(candidate, "with_event_loop_channel_shutdown") == 1 -> typeck_concurrency_boundary_task_channel_scope()
    candidate if typeck_task_surface_decl_is(candidate, "with_sequential") == 1 -> typeck_concurrency_boundary_task_scope()
    candidate if typeck_task_surface_decl_is(candidate, "with_event_loop") == 1 -> typeck_concurrency_boundary_task_scope()
    candidate if typeck_task_surface_decl_is(candidate, "with_event_loop_shutdown") == 1 -> typeck_concurrency_boundary_task_scope()
    candidate if typeck_task_surface_decl_is(candidate, "with_sequential_cancellation") == 1 -> typeck_concurrency_boundary_task_scope()
    candidate if typeck_task_surface_decl_is(candidate, "with_sequential_deadline") == 1 -> typeck_concurrency_boundary_task_scope()
    _ -> typeck_concurrency_boundary_none()
  }
}

pub(package) fn check_task_concurrency_boundary_call(call_node: i64, entry: i64, env: i64, ft: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  let boundary = typeck_concurrency_boundary_for_entry(entry)
  let args = generic_call_inner_args(call_node)
  let nargs = generic_call_inner_arg_count(call_node)
  let scope_body_index = if boundary == typeck_concurrency_boundary_task_scope() and nargs == 1 { 0 }
    else { if boundary == typeck_concurrency_boundary_task_channel_scope() and nargs == 2 { 1 }
    else { 0 - 1 } }
  if scope_body_index >= 0 {
    let body = nlist_get(args, scope_body_index)
    if node_tag(body) == 29 {
      mem_store64_at(body, 32, lambda_ast_metadata_with_par_kind(node_f4(body), slice_borrow_par_lambda_scope_body()))
    } else { 0 }
    -- The scope's open effect parameter may remain unsolved by bare generic
    -- inference even when the body's value result is exact.  Read the body
    -- function's result directly so a move-only task cannot hide behind that
    -- unresolved tail and escape the structured scope.
    let body_ty = synth(body, env, ft, src, tt)
    let result_ty = if body_ty != 0 and ty_tag(body_ty) == 6 { ty_f2(body_ty) }
      else { ty_any() }
    if typeck_ty_contains_task(tt, result_ty) {
      typeck_error_maybe(src, generic_call_inner_name_start(call_node), "type error: Task cannot escape its structured task scope")
      1
    } else { 0 }
  } else { if boundary != typeck_concurrency_boundary_task_submit() or nargs != 1 { 0 }
  else {
    let worker = nlist_get(args, 0)
    if node_tag(worker) == 29 {
      mem_store64_at(worker, 32, lambda_ast_metadata_with_par_kind(node_f4(worker), slice_borrow_task_lambda_worker()))
    } else { 0 }
    let fact = typeck_sendability_value_with_mode(tt, worker, env, ft, src, 1)
    if typeck_sendability_fact_decision(fact) == typeck_sendability_decision_yes() { 0 }
    else {
      let path = typeck_sendability_fact_path(fact)
      let position = if typeck_sendability_path_kind(path) == 5 { typeck_sendability_path_span(path) }
        else { generic_call_inner_name_start(call_node) }
      typeck_error_maybe(src, position, "type error: task closure is not Sendable across a structured task boundary")
      1
    }
  } }
}

pub(package) fn check_task_concurrency_boundary(node: i64, entry: i64, env: i64, ft: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  check_task_concurrency_boundary_call(node_f2(node), entry, env, ft, src, tt)
}

pub(package) fn check_sendability_scoped_par_lambda(lambda: i64, env: i64, ft: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  if lambda_ast_par_kind(node_f4(lambda)) != slice_borrow_par_lambda_worker() { 0 }
  else {
    let fact = typeck_sendability_value(tt, lambda, env, ft, src)
    let path = typeck_sendability_fact_path(fact)
    let reason = typeck_sendability_fact_reason(fact)
    let capture_ty = typeck_sendability_capture_path_type(path, env)
    -- Slice captures retain the borrow checker's provenance/transport
    -- diagnostics. Mut and linear captures are rejected for every closure.
    if typeck_sendability_fact_decision(fact) != typeck_sendability_decision_yes() and
      typeck_sendability_path_kind(path) == 5 and not ty_is_slice(capture_ty) and
      reason != typeck_sendability_reason_mutable_capture() and reason != typeck_sendability_reason_linear_capture() {
      typeck_error_maybe(src, typeck_sendability_path_span(path), "type error: closure capture is not Sendable across scoped Par")
      1
    } else { 0 }
  }
}

-- The scoped slice worker has not yet gained managed-pointee promotion.
-- It can consume facts needing no boundary work, plus the existing named
-- scalar-record inline representation. This is intentionally a capability
-- check over the shared fact, not another recursive type classifier.
pub(package) fn typeck_sendability_fact_scoped_slice_transport_ready(fact: i64) -> i64 {
  if typeck_sendability_fact_decision(fact) != typeck_sendability_decision_yes() { 0 }
  else {
    let needs = typeck_sendability_fact_needs(fact)
    if needs == 0 or needs == (typeck_sendability_needs_promotion() bor typeck_sendability_inline_scalar_record()) { 1 } else { 0 }
  }
}

pub(package) fn slice_borrow_scoped_par_element_shareable(tt: i64, ty: i64) -> i64 {
  let fact = typeck_sendability_type(tt, ty)
  if ty_tag(ty) == 3 and ty_union_storage_class(ty) != 1 { 0 }
  else { typeck_sendability_fact_scoped_slice_transport_ready(fact) }
}

-- Scoped-Par lambda roles follow the resolved SDK declaration. This keeps
-- aliases and qualified calls equivalent and prevents an unrelated package's
-- `fork`, `map`, or policy helper from acquiring a concurrency boundary.
pub(package) type ParCallRole {
  ParCallNone,
  ParCallScopeSequential,
  ParCallScopePool,
  ParCallMap,
  ParCallFork
}

pub(package) fn typeck_par_decl_role(declaration: i64) -> ParCallRole {
  match declaration {
    candidate if typeck_decl_identity_is(candidate, "stdlib/par", "with_sequential") == 1 -> ParCallScopeSequential
    candidate if typeck_decl_identity_is(candidate, "stdlib/par", "with_pool") == 1 -> ParCallScopePool
    candidate if typeck_decl_identity_is(candidate, "stdlib/par", "map") == 1 -> ParCallMap
    candidate if typeck_decl_identity_is(candidate, "stdlib/par", "fork") == 1 -> ParCallFork
    _ -> ParCallNone
  }
}

pub(package) fn typeck_par_call_declaration(call_node: i64, src: i64, ft: i64) -> i64 {
  let call = if call_node != 0 and node_tag(call_node) == 36 { node_f2(call_node) } else { call_node }
  if call == 0 { 0 }
  else { if node_tag(call) == 4 {
    ftypes_entry_decl_fact(ftypes_find(ft, src, node_f1(call), node_f2(call)))
  } else { if node_tag(call) == 32 {
    typeck_qualified_call_declaration(call)
  } else { 0 } } }
}

pub(package) fn typeck_par_call_role(call_node: i64, src: i64, ft: i64) -> ParCallRole {
  typeck_par_decl_role(typeck_par_call_declaration(call_node, src, ft))
}

pub(package) fn slice_borrow_mark_scoped_par_expr_list(items: i64, count: i64, src: i64, in_scope: i64, ft: i64) -> i64 {
  for i in 0..count { slice_borrow_mark_scoped_par_expr(nlist_get(items, i), src, in_scope, ft) }
  0
}

pub(package) fn slice_borrow_mark_scoped_par_scope_args(args: i64, nargs: i64, body_index: i64, src: i64, in_scope: i64, ft: i64) -> i64 {
  for i in 0..nargs {
    let arg = nlist_get(args, i)
    if i == body_index and node_tag(arg) == 29 {
      mem_store64_at(arg, 32, lambda_ast_metadata_with_par_kind(node_f4(arg), slice_borrow_par_lambda_scope_body()))
      slice_borrow_mark_scoped_par_expr(node_f2(arg), src, 1, ft)
    } else { slice_borrow_mark_scoped_par_expr(arg, src, in_scope, ft) }
  }
  0
}

pub(package) fn slice_borrow_mark_scoped_par_call(call_node: i64, src: i64, in_scope: i64, ft: i64) -> i64 {
  let args = generic_call_inner_args(call_node)
  let nargs = generic_call_inner_arg_count(call_node)
  match typeck_par_call_role(call_node, src, ft) {
    ParCallScopeSequential -> if nargs == 1 {
      slice_borrow_mark_scoped_par_scope_args(args, nargs, 0, src, in_scope, ft)
    } else { slice_borrow_mark_scoped_par_expr_list(args, nargs, src, in_scope, ft) }
    ParCallScopePool -> if nargs == 3 {
      slice_borrow_mark_scoped_par_scope_args(args, nargs, 2, src, in_scope, ft)
    } else { slice_borrow_mark_scoped_par_expr_list(args, nargs, src, in_scope, ft) }
    ParCallMap -> if in_scope == 1 and nargs == 2 {
      slice_borrow_mark_scoped_par_expr(nlist_get(args, 0), src, in_scope, ft)
      let callback = nlist_get(args, 1)
      if node_tag(callback) == 29 {
        mem_store64_at(callback, 32, lambda_ast_metadata_with_par_kind(node_f4(callback), slice_borrow_par_lambda_worker()))
        slice_borrow_mark_scoped_par_expr(node_f2(callback), src, 0, ft)
      } else { slice_borrow_mark_scoped_par_expr(callback, src, in_scope, ft) }
    } else { slice_borrow_mark_scoped_par_expr_list(args, nargs, src, in_scope, ft) }
    ParCallFork -> if in_scope == 1 and nargs == 1 {
      let worker = nlist_get(args, 0)
      if node_tag(worker) == 29 {
        mem_store64_at(worker, 32, lambda_ast_metadata_with_par_kind(node_f4(worker), slice_borrow_par_lambda_worker()))
        slice_borrow_mark_scoped_par_expr(node_f2(worker), src, 0, ft)
      } else { slice_borrow_mark_scoped_par_expr(worker, src, in_scope, ft) }
    } else { slice_borrow_mark_scoped_par_expr_list(args, nargs, src, in_scope, ft) }
    _ -> slice_borrow_mark_scoped_par_expr_list(args, nargs, src, in_scope, ft)
  }
}

pub(package) fn slice_borrow_mark_scoped_par_expr(node: i64, src: i64, in_scope: i64, ft: i64) -> i64 {
  if node == 0 { 0 }
  else {
    let tag = node_tag(node)
    match tag {
      3 -> slice_borrow_mark_scoped_par_expr(node_f2(node), src, in_scope, ft) + slice_borrow_mark_scoped_par_expr(node_f3(node), src, in_scope, ft)
      4 -> slice_borrow_mark_scoped_par_call(node, src, in_scope, ft)
      5 -> slice_borrow_mark_scoped_par_expr(node_f1(node), src, in_scope, ft) + slice_borrow_mark_scoped_par_expr(node_f2(node), src, in_scope, ft) + slice_borrow_mark_scoped_par_expr(node_f3(node), src, in_scope, ft)
      6 -> slice_borrow_mark_scoped_par_expr(node_f3(node), src, in_scope, ft) + slice_borrow_mark_scoped_par_expr(node_f4(node), src, in_scope, ft)
      7 -> slice_borrow_mark_scoped_par_expr(node_f1(node), src, in_scope, ft) + slice_borrow_mark_scoped_par_expr(node_f2(node), src, in_scope, ft)
      10 -> slice_borrow_mark_scoped_par_expr(node_f1(node), src, in_scope, ft) + slice_borrow_mark_scoped_par_expr(node_f2(node), src, in_scope, ft)
      11 -> slice_borrow_mark_scoped_par_expr(node_f3(node), src, in_scope, ft) + slice_borrow_mark_scoped_par_expr(node_f4(node), src, in_scope, ft)
      12 -> slice_borrow_mark_scoped_par_expr(node_f3(node), src, in_scope, ft)
      13 -> slice_borrow_mark_scoped_par_expr(node_f1(node), src, in_scope, ft)
      14 -> {
        let fields = node_f3(node)
        for i in 0..node_f4(node) { slice_borrow_mark_scoped_par_expr(node_f3(nlist_get(fields, i)), src, in_scope, ft) }
        0
      }
      63 -> slice_borrow_mark_scoped_par_expr(node_f1(node), src, in_scope, ft) + slice_borrow_mark_scoped_par_expr_list(record_field_expr_nodes(node_f2(node), node_f3(node)), node_f3(node), src, in_scope, ft)
      15 -> {
        slice_borrow_mark_scoped_par_expr(node_f1(node), src, in_scope, ft)
        let arms = node_f2(node)
        for i in 0..node_f3(node) {
          let arm = nlist_get(arms, i)
          slice_borrow_mark_scoped_par_expr(node_f3(arm), src, in_scope, ft)
          slice_borrow_mark_scoped_par_expr(node_f2(arm), src, in_scope, ft)
        }
        0
      }
      22 -> slice_borrow_mark_scoped_par_expr(node_f1(node), src, in_scope, ft)
      25 -> slice_borrow_mark_scoped_par_expr(node_f1(node), src, in_scope, ft)
      26 -> slice_borrow_mark_scoped_par_expr(node_f1(node), src, in_scope, ft)
      29 -> slice_borrow_mark_scoped_par_expr(node_f2(node), src, if lambda_ast_par_kind(node_f4(node)) == slice_borrow_par_lambda_scope_body() { 1 } else { 0 }, ft)
      32 -> match typeck_par_call_role(node, src, ft) {
        ParCallNone -> slice_borrow_mark_scoped_par_expr(node_f1(node), src, in_scope, ft) + slice_borrow_mark_scoped_par_expr_list(node_f4(node), nlist_len(node_f4(node)), src, in_scope, ft)
        _ -> slice_borrow_mark_scoped_par_call(node, src, in_scope, ft)
      }
      33 -> {
        slice_borrow_mark_scoped_par_expr(node_f1(node), src, in_scope, ft)
        let clauses = node_f2(node)
        for i in 0..node_f3(node) { slice_borrow_mark_scoped_par_expr(node_f3(nlist_get(clauses, i)), src, in_scope, ft) }
        let ret = node_f4(node)
        if ret != 0 { slice_borrow_mark_scoped_par_expr(node_f3(ret), src, in_scope, ft) } else { 0 }
      }
      35 -> slice_borrow_mark_scoped_par_expr(node_f1(node), src, in_scope, ft)
      36 -> slice_borrow_mark_scoped_par_call(node_f2(node), src, in_scope, ft)
      37 -> slice_borrow_mark_scoped_par_expr(node_f1(node), src, in_scope, ft)
      41 -> slice_borrow_mark_scoped_par_expr(node_f1(node), src, in_scope, ft) + slice_borrow_mark_scoped_par_expr_list(node_f3(node), nlist_len(node_f3(node)), src, in_scope, ft)
      45 -> slice_borrow_mark_scoped_par_expr(node_f1(node), src, in_scope, ft)
      46 -> slice_borrow_mark_scoped_par_expr(node_f1(node), src, in_scope, ft) + slice_borrow_mark_scoped_par_expr(node_f2(node), src, in_scope, ft)
      47 -> slice_borrow_mark_scoped_par_expr(node_f3(node), src, in_scope, ft) + slice_borrow_mark_scoped_par_expr(node_f4(node), src, in_scope, ft)
      48 -> slice_borrow_mark_scoped_par_expr(node_f1(node), src, in_scope, ft)
      49 -> slice_borrow_mark_scoped_par_expr(node_f1(node), src, in_scope, ft)
      52 -> slice_borrow_mark_scoped_par_expr(node_f1(node), src, in_scope, ft) + slice_borrow_mark_scoped_par_expr(node_f2(node), src, in_scope, ft)
      55 -> slice_borrow_mark_scoped_par_expr(node_f2(node), src, in_scope, ft)
      56 -> slice_borrow_mark_scoped_par_expr(node_f1(node), src, in_scope, ft)
      57 -> slice_borrow_mark_scoped_par_expr(node_f1(node), src, in_scope, ft) + slice_borrow_mark_scoped_par_expr(node_f2(node), src, in_scope, ft)
      58 -> slice_borrow_mark_scoped_par_expr_list(node_f1(node), node_f2(node), src, in_scope, ft)
      59 -> slice_borrow_mark_scoped_par_expr(node_f1(node), src, in_scope, ft)
      60 -> slice_borrow_mark_scoped_par_expr(node_f1(node), src, in_scope, ft) + slice_borrow_mark_scoped_par_expr(node_f2(node), src, in_scope, ft)
      61 -> slice_borrow_mark_scoped_par_expr(node_f1(node), src, in_scope, ft) + slice_borrow_mark_scoped_par_expr(node_f2(node), src, in_scope, ft) + slice_borrow_mark_scoped_par_expr(node_f3(node), src, in_scope, ft)
      62 -> slice_borrow_mark_scoped_par_expr(node_f1(node), src, in_scope, ft) + slice_borrow_mark_scoped_par_expr(node_f2(node), src, in_scope, ft) + slice_borrow_mark_scoped_par_expr(node_f3(node), src, in_scope, ft)
      _ -> 0
    }
  }
}

pub(package) fn slice_borrow_check_expr_list(items: i64, count: i64, env: i64, active: i64, context: i64, tenv: i64, ft: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  let mut errors = 0
  for i in 0..count {
    let item = nlist_get(items, i)
    if node_tag(item) == 2 and typeck_type_is_vector(tt, synth(item, tenv, ft, src, tt)) == 0 { errors = errors + slice_borrow_check_access(item, 0, active, context, env, src) } else { 0 }
    errors = errors + slice_borrow_check_expr(item, env, active, context, tenv, ft, src, tt, 0)
  }
  errors
}

pub(package) fn slice_borrow_lambda_capture_errors(lambda: i64, env: i64, tenv: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  let params = node_f1(lambda)
  let body = node_f2(lambda)
  let par_kind = lambda_ast_par_kind(node_f4(lambda))
  let mut current = env
  let mut errors = 0
  while current != 0 {
    let info = node_f3(current)
    let origins = if slice_borrow_info_kind(info) == 2 { slice_borrow_info_origins(info) } else { slice_borrow_info_contained(info) }
    -- A closure has no surface lifetime parameter, so even caller-owned slice
    -- parameters cannot be captured by an arbitrary escaping closure. The two
    -- marked scoped-Par forms below are the only proven non-escaping/joined
    -- consumers; checking only local/unknown origin classes here would let an
    -- unjoined worker carry a caller's slice indefinitely.
    if nlist_len(origins) > 0 and unique_params_bind_name(params, node_f3(lambda), src, src, node_f1(current), node_f2(current)) == 0 {
      if unique_ref_count_name(body, src, src, node_f1(current), node_f2(current)) > 0 {
        if par_kind == slice_borrow_par_lambda_scope_body() and slice_borrow_info_kind(info) == 2 {
          errors = errors
        } else { if (par_kind == slice_borrow_par_lambda_worker() or par_kind == slice_borrow_task_lambda_worker()) and slice_borrow_info_kind(info) == 2 {
          let capture_ty = tenv_lookup(tenv, src, node_f1(current), node_f2(current))
          if ty_is_slice(capture_ty) and ty_slice_mutable(capture_ty) == 1 {
            if par_kind == slice_borrow_task_lambda_worker() {
              typeck_error_maybe(src, node_f1(current), "type error: mutable slice cannot cross a structured task boundary")
            } else { typeck_error_maybe(src, node_f1(current), "type error: mutable slice cannot cross a scoped Par boundary") }
            errors = errors + 1
          } else { if ty_is_slice(capture_ty) and slice_borrow_scoped_par_element_shareable(tt, ty_slice_inner(capture_ty)) == 1 {
            errors = errors
          } else {
            if par_kind == slice_borrow_task_lambda_worker() {
              typeck_error_maybe(src, node_f1(current), "type error: slice element type is not Sendable across a structured task boundary")
            } else { typeck_error_maybe(src, node_f1(current), "type error: slice element type is not Sendable across scoped Par") }
            errors = errors + 1
          } }
        } else {
          typeck_error_maybe(src, node_f1(current), "type error: slice borrow cannot be captured by an escaping closure")
          errors = errors + 1
        } }
      } else { 0 }
    } else { 0 }
    current = node_f4(current)
  }
  errors
}

pub(package) fn slice_borrow_check_expr(node: i64, env: i64, active: i64, live_context: i64, tenv: i64, ft: i64, src: i64, tt: i64, result_pos: i64) -[Diagnose]> i64 {
  if node == 0 { 0 }
  else {
    let tag = node_tag(node)
    -- Result-shaped control nodes delegate the check to their actual result
    -- expressions. This avoids duplicate diagnostics while still checking
    -- explicit returns nested below a non-result statement.
    let result_container = if tag == 5 or tag == 6 or tag == 7 or tag == 11 or tag == 15 or tag == 25 or tag == 33 or tag == 36 or tag == 37 or tag == 52 { 1 } else { 0 }
    let mut errors = if result_pos == 1 and result_container == 0 { slice_borrow_check_result(node, env, tenv, ft, src, tt) } else { 0 }
    match tag {
      3 -> errors + slice_borrow_check_expr(node_f2(node), env, active, live_context, tenv, ft, src, tt, 0) + slice_borrow_check_expr(node_f3(node), env, active, live_context, tenv, ft, src, tt, 0)
      4 -> {
        let args = node_f3(node)
        errors = errors + slice_borrow_check_call_siblings(args, node_f4(node), env, tenv, ft, src, tt, node_f1(node))
        errors = errors + slice_borrow_check_vector_call_args(args, node_f4(node), slice_borrow_vector_call_is_read_only(src, node_f1(node), node_f2(node)), env, active, live_context, tenv, ft, src, tt)
        errors + slice_borrow_check_expr_list(args, node_f4(node), env, active, live_context, tenv, ft, src, tt)
      }
      5 -> errors + slice_borrow_check_expr(node_f1(node), env, active, live_context, tenv, ft, src, tt, 0) + slice_borrow_check_expr(node_f2(node), env, active, node_f2(node), tenv, ft, src, tt, result_pos) + slice_borrow_check_expr(node_f3(node), env, active, node_f3(node), tenv, ft, src, tt, result_pos)
      6 -> {
        let value = node_f3(node)
        let body = node_f4(node)
        errors = errors + slice_borrow_check_expr(value, env, active, live_context, tenv, ft, src, tt, 0)
        let info = slice_borrow_info_for_binding(value, node_f1(node), node_f2(node), env, tenv, ft, src, tt)
        if slice_borrow_info_kind(info) == 2 and node_tag(value) != 62 {
          let allowed = if node_tag(value) == 2 { value } else { 0 }
          errors = errors + slice_borrow_check_new(value, allowed, active, live_context, env, tenv, ft, src, tt)
        } else { 0 }
        let next_env = if info == 0 { env } else { slice_borrow_env_bind(env, node_f1(node), node_f2(node), info) }
        let value_ty = synth(value, tenv, ft, src, tt)
        let next_tenv = if node_tag(value) == 29 { tenv_bind_value(tenv, src, node_f1(node), node_f2(node), value_ty, value) } else { tenv_bind(tenv, src, node_f1(node), node_f2(node), value_ty) }
        let parent = if node_tag(value) == 62 and node_tag(node_f1(value)) == 2 { node_f1(value) } else { if node_tag(value) == 2 { value } else { 0 } }
        let next_active = if slice_borrow_info_kind(info) == 2 and unique_ref_count_name(body, src, src, node_f1(node), node_f2(node)) > 0 {
          slice_borrow_active_push(active, node_f1(node), node_f2(node), slice_borrow_info_origins(info), slice_borrow_info_mutable(info), parent)
        } else { active }
        errors + slice_borrow_check_expr(body, next_env, next_active, body, next_tenv, ft, src, tt, result_pos)
      }
      7 -> errors + slice_borrow_check_expr(node_f1(node), env, active, node, tenv, ft, src, tt, 0) + slice_borrow_check_expr(node_f2(node), env, active, node_f2(node), tenv, ft, src, tt, result_pos)
      10 -> errors + slice_borrow_check_expr(node_f1(node), env, active, live_context, tenv, ft, src, tt, 0) + slice_borrow_check_expr(node_f2(node), env, active, live_context, tenv, ft, src, tt, 0)
      11 -> {
        let value = node_f3(node)
        let body = node_f4(node)
        errors = errors + slice_borrow_check_expr(value, env, active, live_context, tenv, ft, src, tt, 0)
        let info = slice_borrow_info_for_binding(value, node_f1(node), node_f2(node), env, tenv, ft, src, tt)
        if slice_borrow_info_kind(info) == 2 and node_tag(value) != 62 {
          let allowed = if node_tag(value) == 2 { value } else { 0 }
          errors = errors + slice_borrow_check_new(value, allowed, active, live_context, env, tenv, ft, src, tt)
        } else { 0 }
        let next_env = if info == 0 { env } else { slice_borrow_env_bind(env, node_f1(node), node_f2(node), info) }
        let value_ty = synth(value, tenv, ft, src, tt)
        let next_tenv = tenv_bind_mut(tenv, src, node_f1(node), node_f2(node), value_ty)
        let parent = if node_tag(value) == 62 and node_tag(node_f1(value)) == 2 { node_f1(value) } else { if node_tag(value) == 2 { value } else { 0 } }
        let next_active = if slice_borrow_info_kind(info) == 2 and unique_ref_count_name(body, src, src, node_f1(node), node_f2(node)) > 0 {
          slice_borrow_active_push(active, node_f1(node), node_f2(node), slice_borrow_info_origins(info), slice_borrow_info_mutable(info), parent)
        } else { active }
        errors + slice_borrow_check_expr(body, next_env, next_active, body, next_tenv, ft, src, tt, result_pos)
      }
      12 -> {
        let info = slice_borrow_env_lookup(env, src, node_f1(node), node_f2(node))
        if slice_borrow_info_kind(info) == 2 or nlist_len(slice_borrow_info_contained(info)) > 0 {
          typeck_error_maybe(src, node_f1(node), "type error: cannot reassign a binding that carries a slice borrow")
          errors = errors + 1
        } else { 0 }
        let target = node_new(2, node_f1(node), node_f2(node), 0, 0)
        errors + slice_borrow_check_access(target, 1, active, live_context, env, src) + slice_borrow_check_expr(node_f3(node), env, active, live_context, tenv, ft, src, tt, 0)
      }
      13 -> errors + slice_borrow_check_expr(node_f1(node), env, active, live_context, tenv, ft, src, tt, 0)
      14 -> {
        let fields = node_f3(node)
        for i in 0..node_f4(node) { errors = errors + slice_borrow_check_expr(node_f3(nlist_get(fields, i)), env, active, live_context, tenv, ft, src, tt, 0) }
        errors
      }
      63 -> errors + slice_borrow_check_expr(node_f1(node), env, active, live_context, tenv, ft, src, tt, 0) + slice_borrow_check_expr_list(record_field_expr_nodes(node_f2(node), node_f3(node)), node_f3(node), env, active, live_context, tenv, ft, src, tt)
      15 -> {
        errors = errors + slice_borrow_check_expr(node_f1(node), env, active, live_context, tenv, ft, src, tt, 0)
        let arms = node_f2(node)
        for i in 0..node_f3(node) {
          let arm = nlist_get(arms, i)
          errors = errors + slice_borrow_check_expr(node_f3(arm), env, active, node_f3(arm), tenv, ft, src, tt, 0)
          errors = errors + slice_borrow_check_expr(node_f2(arm), env, active, node_f2(arm), tenv, ft, src, tt, result_pos)
        }
        errors
      }
      22 -> errors + slice_borrow_check_expr(node_f1(node), env, active, live_context, tenv, ft, src, tt, 0)
      25 -> errors + slice_borrow_check_expr(node_f1(node), env, active, node_f1(node), tenv, ft, src, tt, 1)
      26 -> errors + slice_borrow_check_expr(node_f1(node), env, active, node_f1(node), tenv, ft, src, tt, 0)
      29 -> {
        errors = errors + slice_borrow_lambda_capture_errors(node, env, tenv, src, tt)
        let capture_origins = slice_borrow_lambda_capture_origins(node, env, src)
        if result_pos == 1 and nlist_len(capture_origins) > 0 {
          typeck_error_maybe(src, expr_diag_pos(node), "type error: escaping closure cannot capture a slice borrow")
          errors = errors + 1
        } else { 0 }
        let params = node_f1(node)
        let lambda_env = slice_borrow_env_bind_param_list(params, node_f3(node), env, src, tt)
        let lambda_tenv = slice_borrow_tenv_bind_param_list(params, node_f3(node), tenv, src)
        errors + slice_borrow_check_expr(node_f2(node), lambda_env, 0, node_f2(node), lambda_tenv, ft, src, tt, 1)
      }
      32 -> {
        let args = node_f4(node)
        if typeck_qualified_call_declaration(node) != 0 {
          errors = errors + slice_borrow_check_call_siblings(args, nlist_len(args), env, tenv, ft, src, tt, node_f2(node))
        } else {
          for i in 0..nlist_len(args) {
            let kind = slice_borrow_origins_escape_kind(slice_borrow_expr_escape_origins(nlist_get(args, i), env, tenv, ft, src, tt))
            if kind != 0 {
              typeck_error_maybe(src, expr_diag_pos(nlist_get(args, i)), "type error: slice borrow cannot enter effect handler state")
              errors = errors + 1
            } else { 0 }
          }
        }
        errors + slice_borrow_check_expr_list(args, nlist_len(args), env, active, live_context, tenv, ft, src, tt)
      }
      33 -> {
        errors = errors + slice_borrow_check_expr(node_f1(node), env, active, live_context, tenv, ft, src, tt, result_pos)
        let clauses = node_f2(node)
        for i in 0..node_f3(node) {
          let clause = nlist_get(clauses, i)
          let params = node_f2(clause)
          let clause_env = slice_borrow_env_bind_param_list(params, nlist_len(params), env, src, tt)
          let clause_tenv = slice_borrow_tenv_bind_param_list(params, nlist_len(params), tenv, src)
          errors = errors + slice_borrow_check_expr(node_f3(clause), clause_env, active, node_f3(clause), clause_tenv, ft, src, tt, result_pos)
        }
        let ret = node_f4(node)
        if ret != 0 { errors = errors + slice_borrow_check_expr(node_f3(ret), env, active, node_f3(ret), tenv, ft, src, tt, result_pos) } else { 0 }
        errors
      }
      35 -> {
        let kind = slice_borrow_origins_escape_kind(slice_borrow_expr_escape_origins(node_f1(node), env, tenv, ft, src, tt))
        if kind != 0 {
          typeck_error_maybe(src, expr_diag_pos(node_f1(node)), "type error: slice borrow cannot cross a continuation boundary")
          errors = errors + 1
        } else { 0 }
        errors + slice_borrow_check_expr(node_f1(node), env, active, live_context, tenv, ft, src, tt, 0)
      }
      36 -> {
        -- Check the represented call's arguments, but do not feed its inner
        -- Call node back through result checking: it is already covered by
        -- the outer explicit instantiation and must not be inferred again.
        let call_node = node_f2(node)
        let args = generic_call_inner_args(call_node)
        let nargs = generic_call_inner_arg_count(call_node)
        errors = errors + slice_borrow_check_call_siblings(args, nargs, env, tenv, ft, src, tt, generic_call_inner_name_start(call_node))
        if node_tag(call_node) == 4 {
          errors = errors + slice_borrow_check_vector_call_args(args, nargs, slice_borrow_vector_call_is_read_only(src, node_f1(call_node), node_f2(call_node)), env, active, live_context, tenv, ft, src, tt)
        } else { 0 }
        errors + slice_borrow_check_expr_list(args, nargs, env, active, live_context, tenv, ft, src, tt)
      }
      37 -> {
        let inner = node_f1(node)
        let value = node_f3(inner)
        let body = node_f4(inner)
        errors = errors + slice_borrow_check_expr(value, env, active, live_context, tenv, ft, src, tt, 0)
        let info = slice_borrow_info_for_binding(value, node_f1(inner), node_f2(inner), env, tenv, ft, src, tt)
        if slice_borrow_info_kind(info) == 2 and node_tag(value) != 62 {
          let allowed = if node_tag(value) == 2 { value } else { 0 }
          errors = errors + slice_borrow_check_new(value, allowed, active, live_context, env, tenv, ft, src, tt)
        } else { 0 }
        let next_env = if info == 0 { env } else { slice_borrow_env_bind(env, node_f1(inner), node_f2(inner), info) }
        let next_tenv = if node_tag(inner) == 11 { tenv_bind_mut(tenv, src, node_f1(inner), node_f2(inner), node_f2(node)) } else { if node_tag(value) == 29 { tenv_bind_value(tenv, src, node_f1(inner), node_f2(inner), node_f2(node), value) } else { tenv_bind(tenv, src, node_f1(inner), node_f2(inner), node_f2(node)) } }
        let parent = if node_tag(value) == 62 and node_tag(node_f1(value)) == 2 { node_f1(value) } else { if node_tag(value) == 2 { value } else { 0 } }
        let next_active = if slice_borrow_info_kind(info) == 2 and unique_ref_count_name(body, src, src, node_f1(inner), node_f2(inner)) > 0 {
          slice_borrow_active_push(active, node_f1(inner), node_f2(inner), slice_borrow_info_origins(info), slice_borrow_info_mutable(info), parent)
        } else { active }
        errors + slice_borrow_check_expr(body, next_env, next_active, body, next_tenv, ft, src, tt, result_pos)
      }
      41 -> {
        let recv = node_f1(node)
        let recv_ty = synth(recv, tenv, ft, src, tt)
        if typeck_type_is_vector(tt, recv_ty) == 1 {
          errors = errors + slice_borrow_check_vector_expr_access(recv, if slice_borrow_vector_method_is_read_only(node_f2(node)) == 1 { 0 } else { 1 }, env, active, live_context, tenv, ft, src, tt)
        } else { errors = errors + slice_borrow_check_access(recv, 0, active, live_context, env, src) }
        errors = errors + slice_borrow_check_expr(recv, env, active, live_context, tenv, ft, src, tt, 0)
        let args = node_f3(node)
        errors = errors + slice_borrow_check_call_siblings(args, nlist_len(args), env, tenv, ft, src, tt, expr_diag_pos(node))
        errors + slice_borrow_check_expr_list(args, nlist_len(args), env, active, live_context, tenv, ft, src, tt)
      }
      45 -> errors + slice_borrow_check_expr(node_f1(node), env, active, live_context, tenv, ft, src, tt, 0)
      46 -> errors + slice_borrow_check_expr(node_f1(node), env, active, live_context, tenv, ft, src, tt, 0) + slice_borrow_check_expr(node_f2(node), env, active, live_context, tenv, ft, src, tt, 0)
      47 -> errors + slice_borrow_check_access(node_f3(node), 0, active, live_context, env, src) + slice_borrow_check_expr(node_f3(node), env, active, live_context, tenv, ft, src, tt, 0) + slice_borrow_check_expr(node_f4(node), env, active, live_context, tenv, ft, src, tt, 0)
      48 -> errors + slice_borrow_check_expr(node_f1(node), env, active, live_context, tenv, ft, src, tt, 0)
      49 -> errors + slice_borrow_check_expr(node_f1(node), env, active, live_context, tenv, ft, src, tt, 0)
      52 -> errors + slice_borrow_check_expr(node_f1(node), env, active, live_context, tenv, ft, src, tt, 0) + slice_borrow_check_expr(node_f2(node), env, active, live_context, tenv, ft, src, tt, result_pos)
      58 -> errors + slice_borrow_check_expr_list(node_f1(node), node_f2(node), env, active, live_context, tenv, ft, src, tt)
      59 -> errors + slice_borrow_check_access(node_f1(node), 0, active, live_context, env, src)
      60 -> errors + slice_borrow_check_access(node_f1(node), 0, active, live_context, env, src) + slice_borrow_check_expr(node_f2(node), env, active, live_context, tenv, ft, src, tt, 0)
      61 -> errors + slice_borrow_check_access(node_f1(node), 1, active, live_context, env, src) + slice_borrow_check_expr(node_f2(node), env, active, live_context, tenv, ft, src, tt, 0) + slice_borrow_check_expr(node_f3(node), env, active, live_context, tenv, ft, src, tt, 0)
      62 -> {
        let allowed = if node_tag(node_f1(node)) == 2 { node_f1(node) } else { 0 }
        errors = errors + slice_borrow_check_new(node, allowed, active, live_context, env, tenv, ft, src, tt)
        errors + slice_borrow_check_expr(node_f2(node), env, active, live_context, tenv, ft, src, tt, 0) + slice_borrow_check_expr(node_f3(node), env, active, live_context, tenv, ft, src, tt, 0)
      }
      _ -> errors
    }
  }
}

pub(package) fn slice_borrow_expr_list_relevant(items: i64, count: i64, tt: i64) -> i64 {
  let mut found = 0
  for i in 0..count {
    if slice_borrow_expr_relevant(nlist_get(items, i), tt) == 1 { found = 1 } else { 0 }
  }
  found
}

pub(package) fn slice_borrow_param_list_relevant(params: i64, count: i64, tt: i64) -> i64 {
  let mut found = 0
  for i in 0..count {
    if slice_borrow_type_contains(node_f3(nlist_get(params, i)), tt, 0) == 1 { found = 1 } else { 0 }
  }
  found
}

-- Keep the lifetime checker off the overwhelmingly common slice-free
-- function. Besides being cheaper, this avoids allocating empty origin lists
-- for every scalar node in large numeric modules. Any explicit slice creation,
-- slice-bearing signature/annotation, or nested callable signature turns the
-- full walk on for the containing function.
pub(package) fn slice_borrow_expr_relevant(node: i64, tt: i64) -> i64 {
  if node == 0 { 0 }
  else {
    match node_tag(node) {
      3 -> if slice_borrow_expr_relevant(node_f2(node), tt) == 1 or slice_borrow_expr_relevant(node_f3(node), tt) == 1 { 1 } else { 0 }
      4 -> slice_borrow_expr_list_relevant(node_f3(node), node_f4(node), tt)
      5 -> if slice_borrow_expr_relevant(node_f1(node), tt) == 1 or slice_borrow_expr_relevant(node_f2(node), tt) == 1 or slice_borrow_expr_relevant(node_f3(node), tt) == 1 { 1 } else { 0 }
      6 -> if slice_borrow_expr_relevant(node_f3(node), tt) == 1 or slice_borrow_expr_relevant(node_f4(node), tt) == 1 { 1 } else { 0 }
      7 -> if slice_borrow_expr_relevant(node_f1(node), tt) == 1 or slice_borrow_expr_relevant(node_f2(node), tt) == 1 { 1 } else { 0 }
      10 -> if slice_borrow_expr_relevant(node_f1(node), tt) == 1 or slice_borrow_expr_relevant(node_f2(node), tt) == 1 { 1 } else { 0 }
      11 -> if slice_borrow_expr_relevant(node_f3(node), tt) == 1 or slice_borrow_expr_relevant(node_f4(node), tt) == 1 { 1 } else { 0 }
      12 -> slice_borrow_expr_relevant(node_f3(node), tt)
      13 -> slice_borrow_expr_relevant(node_f1(node), tt)
      14 -> {
        let fields = node_f3(node)
        let mut found = 0
        for i in 0..node_f4(node) { if slice_borrow_expr_relevant(node_f3(nlist_get(fields, i)), tt) == 1 { found = 1 } else { 0 } }
        found
      }
      63 -> if slice_borrow_expr_relevant(node_f1(node), tt) == 1 or slice_borrow_expr_list_relevant(record_field_expr_nodes(node_f2(node), node_f3(node)), node_f3(node), tt) == 1 { 1 } else { 0 }
      15 -> {
        let arms = node_f2(node)
        let mut found = slice_borrow_expr_relevant(node_f1(node), tt)
        for i in 0..node_f3(node) {
          let arm = nlist_get(arms, i)
          if slice_borrow_expr_relevant(node_f2(arm), tt) == 1 or slice_borrow_expr_relevant(node_f3(arm), tt) == 1 { found = 1 } else { 0 }
        }
        found
      }
      22 -> slice_borrow_expr_relevant(node_f1(node), tt)
      25 -> slice_borrow_expr_relevant(node_f1(node), tt)
      26 -> slice_borrow_expr_relevant(node_f1(node), tt)
      29 -> if slice_borrow_param_list_relevant(node_f1(node), node_f3(node), tt) == 1 or slice_borrow_expr_relevant(node_f2(node), tt) == 1 { 1 } else { 0 }
      32 -> if slice_borrow_expr_relevant(node_f1(node), tt) == 1 or slice_borrow_expr_list_relevant(node_f4(node), nlist_len(node_f4(node)), tt) == 1 { 1 } else { 0 }
      33 -> {
        let mut found = slice_borrow_expr_relevant(node_f1(node), tt)
        let clauses = node_f2(node)
        for i in 0..node_f3(node) {
          let clause = nlist_get(clauses, i)
          if slice_borrow_param_list_relevant(node_f2(clause), nlist_len(node_f2(clause)), tt) == 1 or slice_borrow_expr_relevant(node_f3(clause), tt) == 1 { found = 1 } else { 0 }
        }
        let ret = node_f4(node)
        if ret != 0 and slice_borrow_expr_relevant(node_f3(ret), tt) == 1 { found = 1 } else { 0 }
        found
      }
      35 -> slice_borrow_expr_relevant(node_f1(node), tt)
      36 -> slice_borrow_expr_relevant(node_f2(node), tt)
      37 -> if slice_borrow_type_contains(node_f2(node), tt, 0) == 1 or slice_borrow_expr_relevant(node_f1(node), tt) == 1 { 1 } else { 0 }
      41 -> if slice_borrow_expr_relevant(node_f1(node), tt) == 1 or slice_borrow_expr_list_relevant(node_f3(node), nlist_len(node_f3(node)), tt) == 1 { 1 } else { 0 }
      45 -> slice_borrow_expr_relevant(node_f1(node), tt)
      46 -> if slice_borrow_expr_relevant(node_f1(node), tt) == 1 or slice_borrow_expr_relevant(node_f2(node), tt) == 1 { 1 } else { 0 }
      47 -> if slice_borrow_expr_relevant(node_f3(node), tt) == 1 or slice_borrow_expr_relevant(node_f4(node), tt) == 1 { 1 } else { 0 }
      48 -> slice_borrow_expr_relevant(node_f1(node), tt)
      49 -> slice_borrow_expr_relevant(node_f1(node), tt)
      52 -> if slice_borrow_expr_relevant(node_f1(node), tt) == 1 or slice_borrow_expr_relevant(node_f2(node), tt) == 1 { 1 } else { 0 }
      55 -> slice_borrow_expr_relevant(node_f2(node), tt)
      56 -> slice_borrow_expr_relevant(node_f1(node), tt)
      57 -> if slice_borrow_expr_relevant(node_f1(node), tt) == 1 or slice_borrow_expr_relevant(node_f2(node), tt) == 1 { 1 } else { 0 }
      58 -> slice_borrow_expr_list_relevant(node_f1(node), node_f2(node), tt)
      59 -> slice_borrow_expr_relevant(node_f1(node), tt)
      60 -> if slice_borrow_expr_relevant(node_f1(node), tt) == 1 or slice_borrow_expr_relevant(node_f2(node), tt) == 1 { 1 } else { 0 }
      61 -> if slice_borrow_expr_relevant(node_f1(node), tt) == 1 or slice_borrow_expr_relevant(node_f2(node), tt) == 1 or slice_borrow_expr_relevant(node_f3(node), tt) == 1 { 1 } else { 0 }
      62 -> 1
      _ -> 0
    }
  }
}

pub(package) fn check_slice_borrow_contract(body: i64, params: i64, nparams: i64, ret_ty: i64, tenv: i64, ft: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  let signature_relevant = if slice_borrow_param_list_relevant(params, nparams, tt) == 1 or slice_borrow_type_contains(ret_ty, tt, 0) == 1 { 1 } else { 0 }
  if signature_relevant == 0 and slice_borrow_expr_relevant(body, tt) == 0 { 0 }
  else {
    let env = slice_borrow_env_bind_param_list(params, nparams, 0, src, tt)
    slice_borrow_check_expr(body, env, 0, body, tenv, ft, src, tt, 1)
  }
}

-- Resolve every type-bearing surface nested inside a function body before
-- synthesis. Function and declaration signatures have their own registry
-- prepass; locals used to miss that producer and therefore retained parsed
-- hash-only named atoms. Opaque identity makes that observably wrong: a
-- typed local could fail to match the exact opaque value returned by a
-- function even though both spellings named the same declaration.
pub(package) fn typeck_resolve_local_type_list(types: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  if types == 0 { 0 }
  else {
    let mut errors = 0
    for i in 0..nlist_len(types) {
      errors = errors + typeck_resolve_qualified_effects_in_ty(nlist_get(types, i), src, tt)
    }
    errors
  }
}

pub(package) fn typeck_resolve_local_param_types(params: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  if params == 0 { 0 }
  else {
    let mut errors = 0
    for i in 0..nlist_len(params) {
      let ty = node_f3(nlist_get(params, i))
      if ty != 0 { errors = errors + typeck_resolve_qualified_effects_in_ty(ty, src, tt) } else { errors = errors }
    }
    errors
  }
}

pub(package) fn typeck_resolve_local_pattern_types(pat: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  if pat == 0 { 0 }
  else {
    match node_tag(pat) {
      20 -> {
        let count = node_f4(pat)
        if count < 0 { typeck_resolve_local_pattern_list(node_f3(pat), 0 - count, src, tt) } else { 0 }
      }
      67 -> typeck_resolve_local_pattern_types(node_f1(pat), src, tt)
      60 -> typeck_resolve_qualified_effects_in_ty(node_f3(pat), src, tt)
      64 -> {
        let fields = node_f1(pat)
        let mut errors = 0
        for i in 0..node_f2(pat) {
          errors = errors + typeck_resolve_local_pattern_types(node_f3(nlist_get(fields, i)), src, tt)
        }
        errors
      }
      65 -> typeck_resolve_local_pattern_list(node_f1(pat), node_f2(pat), src, tt)
      _ -> 0
    }
  }
}

pub(package) fn typeck_resolve_local_pattern_list(patterns: i64, count: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  let mut errors = 0
  for i in 0..count {
    errors = errors + typeck_resolve_local_pattern_types(nlist_get(patterns, i), src, tt)
  }
  errors
}

pub(package) fn typeck_resolve_local_expr_list(nodes: i64, count: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  let mut errors = 0
  for i in 0..count {
    errors = errors + typeck_resolve_local_expr_types(nlist_get(nodes, i), src, tt)
  }
  errors
}

pub(package) fn typeck_resolve_local_expr_types(node: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  if node == 0 { 0 }
  else {
    match node_tag(node) {
      3 -> typeck_resolve_local_expr_types(node_f2(node), src, tt) + typeck_resolve_local_expr_types(node_f3(node), src, tt)
      4 -> typeck_resolve_local_expr_list(node_f3(node), node_f4(node), src, tt)
      5 -> typeck_resolve_local_expr_types(node_f1(node), src, tt) + typeck_resolve_local_expr_types(node_f2(node), src, tt) + typeck_resolve_local_expr_types(node_f3(node), src, tt)
      6 -> typeck_resolve_local_expr_types(node_f3(node), src, tt) + typeck_resolve_local_expr_types(node_f4(node), src, tt)
      7 -> typeck_resolve_local_expr_types(node_f1(node), src, tt) + typeck_resolve_local_expr_types(node_f2(node), src, tt)
      10 -> typeck_resolve_local_expr_types(node_f1(node), src, tt) + typeck_resolve_local_expr_types(node_f2(node), src, tt)
      11 -> typeck_resolve_local_expr_types(node_f3(node), src, tt) + typeck_resolve_local_expr_types(node_f4(node), src, tt)
      12 -> typeck_resolve_local_expr_types(node_f3(node), src, tt)
      13 -> {
        let fact = node_f4(node)
        let type_arg_errors = if fact != 0 and node_tag(fact) == 3 {
          typeck_resolve_local_type_list(node_f2(fact), src, tt)
        } else { 0 }
        type_arg_errors + typeck_resolve_local_expr_types(node_f1(node), src, tt)
      }
      14 -> {
        let fields = node_f3(node)
        let mut errors = 0
        for i in 0..node_f4(node) {
          errors = errors + typeck_resolve_local_expr_types(node_f3(nlist_get(fields, i)), src, tt)
        }
        errors
      }
      15 -> {
        let arms = node_f2(node)
        let mut errors = typeck_resolve_local_expr_types(node_f1(node), src, tt)
        for i in 0..node_f3(node) {
          let arm = nlist_get(arms, i)
          errors = errors + typeck_resolve_local_pattern_types(node_f1(arm), src, tt)
          errors = errors + typeck_resolve_local_expr_types(node_f2(arm), src, tt)
          if node_f3(arm) != 0 { errors = errors + typeck_resolve_local_expr_types(node_f3(arm), src, tt) } else { errors = errors }
        }
        errors
      }
      22 -> typeck_resolve_local_expr_types(node_f1(node), src, tt)
      25 -> typeck_resolve_local_expr_types(node_f1(node), src, tt)
      26 -> typeck_resolve_local_expr_types(node_f1(node), src, tt)
      29 -> typeck_resolve_local_param_types(node_f1(node), src, tt) + typeck_resolve_local_expr_types(node_f2(node), src, tt)
      32 -> typeck_resolve_local_expr_types(node_f1(node), src, tt) + typeck_resolve_local_expr_list(node_f4(node), nlist_len(node_f4(node)), src, tt)
      33 -> {
        let clauses = node_f2(node)
        let mut errors = typeck_resolve_local_expr_types(node_f1(node), src, tt)
        for i in 0..node_f3(node) {
          let clause = nlist_get(clauses, i)
          errors = errors + typeck_resolve_local_type_list(typeck_effect_ref_type_args(handler_clause_effect_ref_node(clause)), src, tt)
          errors = errors + typeck_resolve_local_param_types(node_f2(clause), src, tt)
          errors = errors + typeck_resolve_local_expr_types(node_f3(clause), src, tt)
        }
        let ret = node_f4(node)
        if ret != 0 { errors = errors + typeck_resolve_local_expr_types(node_f3(ret), src, tt) } else { errors = errors }
        errors
      }
      35 -> typeck_resolve_local_expr_types(node_f1(node), src, tt)
      36 -> typeck_resolve_local_type_list(node_f1(node), src, tt) + typeck_resolve_local_expr_types(node_f2(node), src, tt)
      37 -> typeck_resolve_qualified_effects_in_ty(node_f2(node), src, tt) + typeck_resolve_local_expr_types(node_f1(node), src, tt)
      41 -> typeck_resolve_local_expr_types(node_f1(node), src, tt) + typeck_resolve_local_expr_list(node_f3(node), nlist_len(node_f3(node)), src, tt)
      45 -> typeck_resolve_local_expr_types(node_f1(node), src, tt)
      46 -> typeck_resolve_local_expr_types(node_f1(node), src, tt) + typeck_resolve_local_expr_types(node_f2(node), src, tt)
      47 -> typeck_resolve_local_expr_types(node_f3(node), src, tt) + typeck_resolve_local_expr_types(node_f4(node), src, tt)
      48 -> typeck_resolve_local_expr_types(node_f1(node), src, tt)
      49 -> typeck_resolve_local_expr_types(node_f1(node), src, tt)
      52 -> typeck_resolve_local_expr_types(node_f1(node), src, tt) + typeck_resolve_local_expr_types(node_f2(node), src, tt)
      55 -> typeck_resolve_local_expr_types(node_f2(node), src, tt)
      56 -> typeck_resolve_local_expr_types(node_f1(node), src, tt)
      57 -> typeck_resolve_local_expr_types(node_f1(node), src, tt) + typeck_resolve_local_expr_types(node_f2(node), src, tt)
      58 -> typeck_resolve_local_expr_list(node_f1(node), node_f2(node), src, tt)
      59 -> typeck_resolve_local_expr_types(node_f1(node), src, tt)
      60 -> typeck_resolve_local_expr_types(node_f1(node), src, tt) + typeck_resolve_local_expr_types(node_f2(node), src, tt)
      61 -> typeck_resolve_local_expr_types(node_f1(node), src, tt) + typeck_resolve_local_expr_types(node_f2(node), src, tt) + typeck_resolve_local_expr_types(node_f3(node), src, tt)
      62 -> typeck_resolve_local_expr_types(node_f1(node), src, tt) + typeck_resolve_local_expr_types(node_f2(node), src, tt) + typeck_resolve_local_expr_types(node_f3(node), src, tt)
      63 -> typeck_resolve_local_expr_types(node_f1(node), src, tt) + typeck_resolve_local_expr_list(record_field_expr_nodes(node_f2(node), node_f3(node)), node_f3(node), src, tt)
      64 -> {
        let config = node_f1(node)
        let type_args = typeck_handler_config_type_args(config)
        let args = typeck_handler_config_args(config)
        let mut errors = if type_args == 0 { 0 } else { typeck_resolve_local_type_list(type_args, src, tt) }
        if args != 0 { errors = errors + typeck_resolve_local_expr_list(args, nlist_len(args), src, tt) } else { 0 }
        errors + typeck_resolve_local_expr_types(node_f2(node), src, tt)
      }
      _ -> 0
    }
  }
}

-- Module-handler implementation facts are definition-owned. Parse products
-- retain a raw tag-1 fact; checking publishes tag 2 with the exact effect
-- declaration and atom while leaving the raw syntax graph available to
-- module-product siblings.
pub(package) fn typeck_handler_implementation_raw(fact: i64) -> i64 {
  if fact != 0 and node_tag(fact) == 2 { node_f1(fact) } else { fact }
}

pub(package) fn typeck_handler_implementation_effect_ref(fact: i64) -> i64 {
  let raw = typeck_handler_implementation_raw(fact)
  if raw == 0 { 0 } else { node_f1(raw) }
}

pub(package) fn typeck_handler_implementation_params(fact: i64) -> i64 {
  let raw = typeck_handler_implementation_raw(fact)
  if raw == 0 { 0 } else { node_f2(raw) }
}

pub(package) fn typeck_handler_implementation_clauses(fact: i64) -> i64 {
  let raw = typeck_handler_implementation_raw(fact)
  if raw == 0 { 0 } else { node_f3(raw) }
}

pub(package) fn typeck_handler_implementation_metadata(fact: i64) -> i64 {
  let raw = typeck_handler_implementation_raw(fact)
  if raw == 0 { 0 } else { node_f4(raw) }
}

pub(package) fn typeck_handler_implementation_tparams(fact: i64) -> i64 {
  let meta = typeck_handler_implementation_metadata(fact)
  if meta == 0 { 0 } else { node_f1(meta) }
}

pub(package) fn typeck_handler_implementation_clause_count(fact: i64) -> i64 {
  let meta = typeck_handler_implementation_metadata(fact)
  if meta == 0 { 0 } else { node_f2(meta) }
}

pub(package) fn typeck_handler_implementation_visibility(fact: i64) -> i64 {
  let meta = typeck_handler_implementation_metadata(fact)
  if meta == 0 { module_visibility_private() } else { node_f3(meta) }
}

pub(package) fn typeck_handler_implementation_atom(fact: i64) -> i64 {
  if fact != 0 and node_tag(fact) == 2 { node_f3(fact) } else { 0 }
}

pub(package) fn typeck_handler_implementation_decl(fact: i64) -> i64 {
  if fact != 0 and node_tag(fact) == 2 { node_f2(fact) } else { 0 }
}

pub(package) fn typeck_handler_config_call(config: i64) -> i64 {
  if config != 0 and node_tag(config) == 36 { node_f2(config) } else { config }
}

pub(package) fn typeck_handler_config_type_args(config: i64) -> i64 {
  if config != 0 and node_tag(config) == 36 { node_f1(config) } else { 0 }
}

pub(package) fn typeck_handler_config_args(config: i64) -> i64 {
  let call = typeck_handler_config_call(config)
  if call != 0 and node_tag(call) == 4 { node_f3(call) } else { 0 }
}

pub(package) fn typeck_handler_config_arg_count(config: i64) -> i64 {
  let call = typeck_handler_config_call(config)
  if call != 0 and node_tag(call) == 4 { node_f4(call) } else { 0 - 1 }
}

pub(package) fn typeck_handler_config_name_start(config: i64) -> i64 {
  let call = typeck_handler_config_call(config)
  if call == 0 { 0 } else { node_f1(call) }
}

pub(package) fn typeck_handler_config_name_len(config: i64) -> i64 {
  let call = typeck_handler_config_call(config)
  if call == 0 { 0 } else { node_f2(call) }
}

pub(package) fn typeck_handler_implementation_visible_from(fact: i64, target_module: i64, caller_module: i64) -> i64 {
  if target_module == caller_module { 1 }
  else {
    let visibility = typeck_handler_implementation_visibility(fact)
    if visibility == module_visibility_public() { 1 }
    else { if visibility == module_visibility_package() and module_scope_same_package(target_module, caller_module) == 1 { 1 }
    else { 0 } }
  }
}

pub(package) fn typeck_handler_clause_matches_operation(clauses: i64, nclauses: i64, atom: i64, op: i64, clause_src: i64, op_src: i64) -> i64 {
  let wanted = effect_name_hash(op_src, node_f1(op), node_f2(op))
  let mut found = 0
  let mut i = 0
  while i < nclauses and found == 0 {
    let clause = nlist_get(clauses, i)
    if effect_atom_eq(handler_clause_atom(clause, clause_src), atom) and handler_clause_op_hash(clause, clause_src) == wanted {
      found = 1
    } else { i = i + 1 }
  }
  found
}

pub(package) fn typeck_resolve_handler_implementation(module_entry: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let current = module_fact_entry_handler_implementation(module_entry)
  if current == 0 or node_tag(current) == 2 { 0 }
  else {
    let src = module_fact_entry_source(module_entry)
    let effect_ref = typeck_handler_implementation_effect_ref(current)
    let params = typeck_handler_implementation_params(current)
    let clauses = typeck_handler_implementation_clauses(current)
    let nclauses = typeck_handler_implementation_clause_count(current)
    let tparams = typeck_handler_implementation_tparams(current)
    let saved_tparams = ttable_get_tparams(tt)
    ttable_set_tparams(tt, tparams)
    let mut errors = typeck_resolve_local_param_types(params, src, tt)
    typeck_resolve_effect_ref(effect_ref, tenv_new(), src, tt)
    errors = errors + check_effect_ref_type_arg_count(effect_ref, src, tt)
    errors = errors + check_effect_ref_trait_bounds(effect_ref, src, tt)
    let effect_entry = typeck_effect_ref_entry(effect_ref, src, tt)
    let effect_decl = if effect_entry == 0 { 0 }
      else {
        let ident = effect_ref_ident_node(effect_ref)
        if effect_ref_decl_fact(effect_ref) != 0 { effect_ref_decl_fact(effect_ref) }
        else { if ident == 0 { 0 } else { module_scope_lookup_declaration(tt, src, module_decl_namespace_effect(), src, node_f1(ident), node_f2(ident)) } }
      }
    if effect_entry == 0 or ttable_entry_kind(effect_entry) != 2 {
      typeck_error_maybe(src, typeck_effect_ref_name_start(effect_ref), "type error: handler implementation target is not an effect")
      errors = errors + 1
    } else { 0 }
    if effect_entry != 0 and typeck_effect_entry_has_hidden_operations(effect_entry, src, tt) {
      typeck_error_maybe(src, typeck_effect_ref_name_start(effect_ref), "type error: handler implementation cannot access every operation of this effect")
      errors = errors + 1
    } else { 0 }
    let atom = typeck_effect_ref_atom(effect_ref, src)
    let handled_hash = typeck_effect_ref_name_hash(effect_ref, src)
    for ci in 0..nclauses {
      let clause = nlist_get(clauses, ci)
      let clause_ref = handler_clause_effect_ref_node(clause)
      typeck_resolve_effect_ref(clause_ref, tenv_new(), src, tt)
      errors = errors + typeck_resolve_local_type_list(typeck_effect_ref_type_args(clause_ref), src, tt)
      errors = errors + typeck_resolve_local_param_types(node_f2(clause), src, tt)
      errors = errors + typeck_resolve_local_expr_types(node_f3(clause), src, tt)
      errors = errors + check_effect_ref_type_arg_count(clause_ref, src, tt)
      errors = errors + check_effect_ref_trait_bounds(clause_ref, src, tt)
      if typeck_effect_ref_name_hash(clause_ref, src) != handled_hash or not effect_atom_eq(handler_clause_atom(clause, src), atom) {
        typeck_error_maybe(src, handler_clause_op_name_start(clause), "type error: handler implementation clause effect mismatch")
        errors = errors + 1
      } else { 0 }
      let op = lookup_handler_clause_op(clause, src, tt)
      if op == 0 {
        typeck_error_maybe(src, handler_clause_op_name_start(clause), "type error: unknown effect operation in handler implementation")
        errors = errors + 1
      } else {
        errors = errors + check_arity(nlist_len(node_f3(op)), nlist_len(node_f2(clause)), src, handler_clause_op_name_start(clause))
        if node_f4(clause) != 0 and effect_op_is_deferred(op) == 0 {
          typeck_error_maybe(src, node_f1(node_f4(clause)), "type error: handler continuation requires deferred effect operation")
          errors = errors + 1
        } else { 0 }
      }
    }
    errors = errors + check_handler_duplicate_clauses(clauses, nclauses, src)
    if effect_entry != 0 and ttable_entry_kind(effect_entry) == 2 {
      let ops = ttable_entry_items(effect_entry)
      let op_src = ttable_entry_source(effect_entry)
      for oi in 0..ttable_entry_item_count(effect_entry) {
        let op = nlist_get(ops, oi)
        if node_tag(op) == 31 and typeck_effect_operation_visible(effect_entry, op, src, tt) and typeck_handler_clause_matches_operation(clauses, nclauses, atom, op, src, op_src) == 0 {
          typeck_error_maybe(src, typeck_effect_ref_name_start(effect_ref), "type error: handler implementation is missing an effect operation")
          errors = errors + 1
        } else { 0 }
      }
    } else { 0 }
    module_fact_set_handler_implementation(module_entry, node_new(2, current, effect_decl, atom, 0))
    ttable_set_tparams(tt, saved_tparams)
    errors
  }
}

-- Resolved installation fact: node(72, target ModuleId, implementation fact,
-- generic substitution, exact substituted effect atom).
pub(package) fn typeck_resolve_handler_configuration(config: i64, caller_src: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let ns = typeck_handler_config_name_start(config)
  let nl = typeck_handler_config_name_len(config)
  let target = module_scope_lookup_module(tt, caller_src, caller_src, ns, nl)
  let result = alloc_words(2)
  let mut errors = 0
  let mut fact = 0
  if target == 0 {
    typeck_error_maybe(caller_src, ns, "type error: handler configuration must name an imported module")
    errors = errors + 1
  } else {
    let implementation = module_fact_entry_handler_implementation(target)
    let caller_module = module_fact_find_source(tt, caller_src)
    if implementation == 0 or node_tag(implementation) != 2 {
      typeck_error_maybe(caller_src, ns, "type error: module does not export a handler implementation")
      errors = errors + 1
    } else { if typeck_handler_implementation_visible_from(implementation, target, caller_module) == 0 {
      typeck_error_maybe(caller_src, ns, "type error: handler implementation is not visible from this module")
      errors = errors + 1
    } else {
      let tparams = typeck_handler_implementation_tparams(implementation)
      let type_args = typeck_handler_config_type_args(config)
      let expected = if tparams == 0 { 0 } else { nlist_len(tparams) }
      let actual = if type_args == 0 { 0 } else { nlist_len(type_args) }
      if expected != actual {
        typeck_error_maybe(caller_src, ns, "type error: wrong number of handler type arguments")
        errors = errors + 1
      } else { 0 }
      if type_args != 0 { errors = errors + typeck_resolve_local_type_list(type_args, caller_src, tt) } else { 0 }
      if expected == actual and expected > 0 {
        errors = errors + check_trait_bounds_at(tparams, type_args, caller_src, ns, nl, module_fact_entry_source(target), tt, "handler configuration")
      } else { 0 }
      let subst = if expected > 0 and expected == actual { build_subst(tparams, type_args) } else { 0 }
      let raw_atom = typeck_handler_implementation_atom(implementation)
      let exact_atom = if subst == 0 { raw_atom } else { ty_subst(raw_atom, subst) }
      fact = node_new(72, target, implementation, subst, exact_atom)
    } }
  }
  mem_store64_at(result, 0, fact)
  mem_store64_at(result + 8, 0, errors)
  result
}

pub(package) fn typeck_resolve_module_handler_facts(tt: i64) -[Conformance, Diagnose]> i64 {
  module_scope_build_all(tt)
  let modules = module_fact_modules(tt)
  let mut errors = 0
  for i in 0..nlist_len(modules) {
    errors = errors + typeck_resolve_handler_implementation(nlist_get(modules, i), tt)
  }
  for mi in 0..nlist_len(modules) {
    let module_entry = nlist_get(modules, mi)
    let src = module_fact_entry_source(module_entry)
    let defaults = module_fact_entry_default_handlers(module_entry)
    let resolved = nlist_new()
    for di in 0..nlist_len(defaults) {
      let raw_default = nlist_get(defaults, di)
      if node_tag(raw_default) == 2 {
        nlist_add(resolved, raw_default)
      } else {
        let config = node_f1(raw_default)
        let resolution = typeck_resolve_handler_configuration(config, src, tt)
        errors = errors + mem_load64_at(resolution + 8, 0)
        let install = mem_load64_at(resolution, 0)
        if install != 0 {
          let atom = node_f4(install)
          let mut duplicate = 0
          for prior in 0..nlist_len(resolved) {
            let prior_install = node_f2(nlist_get(resolved, prior))
            if prior_install != 0 and effect_atom_eq(node_f4(prior_install), atom) { duplicate = 1 } else { 0 }
          }
          if duplicate == 1 {
            typeck_error_maybe(src, typeck_handler_config_name_start(config), "type error: duplicate module default for exact effect atom")
            errors = errors + 1
          } else {
            nlist_add(resolved, node_new(2, config, install, 0, node_f4(raw_default)))
          }
        } else { 0 }
      }
    }
    module_fact_set_default_handlers(module_entry, resolved)
  }
  errors
}

pub(package) fn typeck_wrap_module_default_handlers(fns: i64, tt: i64, only_unchecked: i64) -> i64 {
  for i in 0..nlist_len(fns) {
    let pair = nlist_get(fns, i)
    if only_unchecked == 0 or ttable_function_pair_is_checked(tt, pair) == 0 {
      let fn_src = node_f2(pair)
      let module_entry = module_fact_find_source(tt, fn_src)
      let defaults = if module_entry == 0 { 0 } else { module_fact_entry_default_handlers(module_entry) }
      let inner = fn_inner(node_f1(pair))
      let mut body = node_f4(inner)
      if defaults != 0 {
        for di in 0..nlist_len(defaults) {
          let default = nlist_get(defaults, di)
          if node_tag(default) == 2 and node_f2(default) != 0 {
            body = node_new(64, node_f1(default), body, node_f2(default), 0 - node_f4(default) - 1)
          } else { 0 }
        }
      } else { 0 }
      mem_store64_at(inner, 32, body)
    } else { 0 }
  }
  0
}

pub(package) fn check_fn(fn_node: i64, ft: i64, src: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  -- fn_node may be wrapped in tag-23 {inner, ret_type}
  let inner = if node_tag(fn_node) == 23 { node_f1(fn_node) } else { fn_node }
  let params = node_f3(inner)
  let body = node_f4(inner)
  let nparams = nlist_len(params)
  let ret_ty = fn_ret_type(fn_node)
  let mut errors = check_public_arc_params(tt, src, params) + check_public_arc_ty(tt, src, node_f1(inner), ret_ty)
  errors = errors + check_borrow_surface_params(src, params) + check_borrow_surface_ty(src, node_f1(inner), ret_ty)
  errors = errors + check_native_result_abi_ty(src, node_f1(inner), ret_ty)
  errors = errors + check_move_only_storage_params(tt, src, params) + check_move_only_storage_ty(tt, src, node_f1(inner), ret_ty)
  errors = errors + check_owned_resource_params(tt, src, params) + check_owned_resource_ty(tt, src, node_f1(inner), ret_ty)
  -- Build environment from params using their type annotations
  let mut env = tenv_new()
  for i in 0..nparams {
    let p = nlist_get(params, i)
    let param_ty = node_f3(p)
    -- If param has a type annotation (f3 != 0), use it; else default to any
    let ty = if param_ty != 0 { param_ty } else { ty_any() }
    env = tenv_bind_kind(env, src, node_f1(p), node_f2(p), ty, semantic_symbol_kind_parameter())
  }
  -- Store current function's tparams for generic method resolution
  let tparams = fn_tparams(fn_node)
  let saved_tparams = ttable_get_tparams(tt)
  ttable_set_tparams(tt, tparams)
  typeck_record_function_definition(tt, ft, src, node_f1(inner), node_f2(inner), env)
  for fact_pi in 0..nparams {
    let fact_param = nlist_get(params, fact_pi)
    let fact_param_ty = if node_f3(fact_param) != 0 { node_f3(fact_param) } else { ty_any() }
    typeck_record_binding_fact(tt, src, node_f1(fact_param), node_f2(fact_param), fact_param_ty, semantic_symbol_kind_parameter(), env)
  }
  let caller_eff = fn_effects(fn_node)
  errors = errors + check_effect_sig_trait_bounds_at(caller_eff, src, node_f1(inner), node_f2(inner), tt)
  let fn_decl = module_decl_fact_find(tt, src, module_decl_namespace_value(), src, node_f1(inner), node_f2(inner))
  let public_native_fn = if ttable_native_binding_source_find(tt, src) == 0 or fn_decl == 0 { 0 }
    else { if module_decl_fact_visibility_code(fn_decl) == module_visibility_public() { 1 } else { 0 } }
  if public_native_fn == 1 {
    errors = errors + check_native_binding_public_params(src, params)
    errors = errors + check_native_binding_public_ty(src, node_f1(inner), ret_ty)
    if effect_sig_find_atom_by_head(caller_eff, effect_hash_unsafe()) != 0 {
      typeck_error_maybe(src, node_f1(inner), "type error: native binding public wrapper cannot expose Unsafe")
      errors = errors + 1
    } else { 0 }
  } else { 0 }
  -- parameterized effects: expose the declared effect sig to synth-time perform checking
  -- (parameterized-atom instantiation), mirroring the tparams slot.
  let saved_fn_eff = ttable_get_current_fn_eff(tt)
  ttable_set_current_fn_eff(tt, caller_eff)
  -- set-theoretic surface: the declared effect list can carry unsupported-surface markers
  -- (effect type arguments); walk it like params and the return type.
  errors = errors + check_public_arc_ty(tt, src, node_f1(inner), caller_eff)
  errors = errors + check_owned_drop_param_effects(params, nparams, tt, src, caller_eff)
  errors = errors + typeck_resolve_local_expr_types(body, src, tt)
  prepare_expr_contextual(body, ret_ty, env, ft, src, tt)
  -- synth first to convert tag-32 dot-calls to tag-41 method calls
  let body_ty_pre = synth(body, env, ft, src, tt)
  -- Generic ctor inference pre-pass: result-position (and returned) bare
  -- generic ctors solve their type args from the declared return type
  -- and are rewritten to explicit GenericCall nodes BEFORE check_expr
  -- would flag their bare form. Gated on the return type being a named
  -- type — the only expected-type shape context inference can solve —
  -- so ordinary functions never pay for the walk.
  let body_ty = if ty_tag(ret_ty) == 9 and infer_generic_ctor_result(body, ret_ty, env, ft, src, tt) == 1 {
    synth(body, env, ft, src, tt)
  } else { body_ty_pre }
  -- Classify scoped Par lambdas before the ordinary checker reaches them.
  -- This producer is intentionally unconditional: Sendable captures are a
  -- general boundary law, not a side effect of the slice lifetime pass.
  slice_borrow_mark_scoped_par_expr(body, src, 0, ft)
  -- check_expr recurses deeper and resolves remaining tag-32 nodes
  errors = errors + check_expr(body, env, ft, src, caller_eff, tt)
  errors = errors + check_slice_borrow_contract(body, params, nparams, ret_ty, env, ft, src, tt)
  errors = errors + check_resume_scope(body, src, 0)
  errors = errors + check_continuation_param_usage_with_result(body, params, nparams, ret_ty, src, ft)
  if typeck_params_contain_unique(params) == 1 or typeck_ty_contains_unique(ret_ty) == 1 {
    errors = errors + check_unique_param_usage(params, nparams, body, src, tt)
    errors = errors + check_unique_linear_expr(body, env, ft, src, tt)
  } else { errors = errors }
  errors = errors + check_return_values_at(
    body, env, ft, src, ret_ty, tt,
    typeck_source_location(src, node_f1(inner), node_f2(inner))
  )
  -- Check return type: body type must be subtype of declared return type
  -- (the inference pre-pass above already resolved result-position ctors).
  if type_is_unknown_or_any(body_ty) and ty_contains_opaque(ret_ty) == 0 { errors = errors }
  else { if expr_matches_type_contextual(body, body_ty, ret_ty, src, ft) != 1 {
    typeck_report_expr_type_mismatch(
      src,
      body,
      ret_ty,
      body_ty,
      "return value",
      typeck_source_location(src, node_f1(inner), node_f2(inner)),
      tt
    )
    errors = errors + 1
  } else { errors = errors } }
  -- Restore previous function's tparams
  ttable_set_tparams(tt, saved_tparams)
  ttable_set_current_fn_eff(tt, saved_fn_eff)
  errors
}

-- Get return type from fn wrapper (tag-23 has ret_type at f2)
pub(package) fn fn_ret_type(fn_wrap: i64) -> i64 {
  if node_tag(fn_wrap) == 23 {
    let rt = node_f2(fn_wrap)
    if rt != 0 { rt } else { ty_any() }
  } else { ty_any() }
}

-- Get effect signature from fn wrapper (tag-23 has effects at f3)
pub(package) fn fn_effects(fn_wrap: i64) -> i64 {
  if node_tag(fn_wrap) == 23 {
    let eff = node_f3(fn_wrap)
    if eff != 0 { eff } else { 0 }
  } else { 0 }
}

-- Get type params from fn wrapper (tag-23 has tparams at f4)
pub(package) fn fn_tparams(fn_wrap: i64) -> i64 {
  if node_tag(fn_wrap) == 23 { node_f4(fn_wrap) } else { 0 }
}

-- Get inner fn from wrapper
pub(package) fn fn_inner(fn_wrap: i64) -> i64 {
  if node_tag(fn_wrap) == 23 { node_f1(fn_wrap) } else { fn_wrap }
}

-- Register variant constructors from the type table as synthetic functions in ftypes
-- So the type checker can verify constructor argument types
pub(package) fn register_ctors(ft: i64, tt: i64, user_src: i64) -> i64 {
  if tt == 0 { 0 }
  else {
    let n = mem_load64_at(tt, 8)
    let d = mem_load64_at(tt, 0)
    for ti in 0..n {
      let kind = mem_load64_at(d, ti * 64 + 16)
      if kind == 1 {
        let nvariants = mem_load64_at(d, ti * 64 + 24)
        let variants = mem_load64_at(d, ti * 64 + 32)
        let tparams = mem_load64_at(d, ti * 64 + 40)
        for vi in 0..nvariants {
          let v_ns = mem_load64_at(variants, vi * 40)
          let v_nl = mem_load64_at(variants, vi * 40 + 8)
          let npayloads = mem_load64_at(variants, vi * 40 + 24)
          -- Compute parent type hash for Named return type using entry's src
          let type_ns = mem_load64_at(d, ti * 64)
          let type_nl = mem_load64_at(d, ti * 64 + 8)
          let entry_src = mem_load64_at(d, ti * 64 + 48)
          let parent_decl = module_decl_fact_find(tt, entry_src, module_decl_namespace_type(), entry_src, type_ns, type_nl)
          let ctor_ret = typeck_named_type_from_declaration(tt, parent_decl, ctor_type_args_from_tparams(tparams))
          if npayloads > 0 {
            let params = nlist_new()
            let payload_types = mem_load64_at(variants, vi * 40 + 32)
            for pi in 0..npayloads {
              let pty = if payload_types != 0 { nlist_get(payload_types, pi) } else { ty_any() }
              nlist_add(params, node_new(2, 0, 0, pty, 0))
            }
            -- Key by the declaring buffer: v_ns/v_nl are offsets into
            -- entry_src, and ftypes hashes name bytes through the stored src.
            let ctor_entry = ftypes_add(ft, entry_src, v_ns, v_nl, ctor_ret, params, 0, tparams)
            let ctor_decl = module_decl_fact_find_member(tt, parent_decl, module_decl_namespace_constructor(), entry_src, v_ns, v_nl)
            mem_store64_at(ctor_entry, 80, ctor_decl)
          } else {
            -- Bare constructor (no payload): register with empty params
            let ctor_entry = ftypes_add(ft, entry_src, v_ns, v_nl, ctor_ret, nlist_new(), 0, tparams)
            let ctor_decl = module_decl_fact_find_member(tt, parent_decl, module_decl_namespace_constructor(), entry_src, v_ns, v_nl)
            mem_store64_at(ctor_entry, 80, ctor_decl)
          }
        }
      } else { if kind == 5 {
        let type_ns = mem_load64_at(d, ti * 64)
        let type_nl = mem_load64_at(d, ti * 64 + 8)
        let entry_src = mem_load64_at(d, ti * 64 + 48)
        let tparams = mem_load64_at(d, ti * 64 + 40)
        let declaration = module_decl_fact_find(tt, entry_src, module_decl_namespace_type(), entry_src, type_ns, type_nl)
        let type_args = ctor_type_args_from_tparams(tparams)
        let return_ty = typeck_named_type_from_declaration(tt, declaration, type_args)
        let params = nlist_new()
        nlist_add(params, node_new(2, 0, 0, ttable_entry_opaque_representation(d + ti * 64), 0))
        let ctor_entry = ftypes_add(ft, entry_src, type_ns, type_nl, return_ty, params, 0, tparams)
        mem_store64_at(ctor_entry, 80, declaration)
      } else { 0 } }
    }
    0
  }
}

pub(package) fn typeck_native_abi_type(kind: i64) -> i64 {
  if kind == pkg_native_abi_nil() { ty_nil() }
  else { if kind == pkg_native_abi_i8() { ty_i8() }
  else { if kind == pkg_native_abi_u8() { ty_u8() }
  else { if kind == pkg_native_abi_i16() { ty_i16() }
  else { if kind == pkg_native_abi_u16() { ty_u16() }
  else { if kind == pkg_native_abi_i32() { ty_i32() }
  else { if kind == pkg_native_abi_u32() { ty_u32() }
  else { if kind == pkg_native_abi_i64() { ty_i64() }
  else { if kind == pkg_native_abi_u64() { ty_u64() }
  else { if kind == pkg_native_abi_isize() { ty_isize() }
  else { if kind == pkg_native_abi_usize() { ty_usize() }
  else { if kind == pkg_native_abi_f32() { ty_f32() }
  else { if kind == pkg_native_abi_f64() { ty_f64() }
  else { if kind == pkg_native_abi_const_pointer() { ty_ptr(ty_u8()) }
  else { if kind == pkg_native_abi_mut_pointer() { ty_mut_ptr(ty_u8()) }
  else { if kind == pkg_native_abi_const_bytes() { ty_slice(ty_u8()) }
  else { if kind == pkg_native_abi_mut_bytes() { ty_mut_slice(ty_u8()) }
  else { ty_ptr(ty_any()) } } } } } } } } } } } } } } } } }
}

-- Manifest symbols are synthetic private functions in the exact trusted
-- binding module. Their signature is produced once from the ABI fact and the
-- raw call always requires Unsafe; no source spelling or backend recognizer
-- can mint native authority.
pub(package) fn register_native_binding_functions(ft: i64, tt: i64) -> i64 {
  let mut registered = 0
  for si in 0..ttable_native_binding_source_count(tt) {
    let source_entry = ttable_native_binding_source_at(tt, si)
    let src = ttable_native_binding_source_source(source_entry)
    let decls = ttable_native_binding_source_decls(source_entry)
    for di in 0..nlist_len(decls) {
      let decl_fact = nlist_get(decls, di)
      let symbol = ttable_native_decl_fact_symbol(decl_fact)
      let decl = ttable_native_decl_fact_decl(decl_fact)
      if ftypes_find_decl(ft, decl) == 0 {
        let params = nlist_new()
        let abi_params = pkg_native_symbol_params(symbol)
        for pi in 0..nlist_len(abi_params) {
          nlist_add(params, node_new(2, pkg_native_symbol_declaration_ptr(symbol) - src, pkg_native_symbol_declaration_len(symbol), typeck_native_abi_type(nlist_get(abi_params, pi)), 0 - 1))
        }
        let entry = ftypes_add(
          ft,
          src,
          pkg_native_symbol_declaration_ptr(symbol) - src,
          pkg_native_symbol_declaration_len(symbol),
          typeck_native_abi_type(pkg_native_symbol_result(symbol)),
          params,
          effect_sig_one(effect_hash_unsafe()),
          0
        )
        mem_store64_at(entry, 80, decl)
        registered = registered + 1
      } else { 0 }
    }
  }
  registered
}

pub(package) fn ctor_type_args_from_tparams(tparams: i64) -> i64 {
  if tparams == 0 { 0 }
  else {
    let args = nlist_new()
    let n = nlist_len(tparams)
    for i in 0..n {
      let tp = nlist_get(tparams, i)
      nlist_add(args, ty_var(node_f3(tp)))
    }
    args
  }
}

-- Add an effect to an effect set (for handler discharge — expands caller_eff)
-- If caller_eff is 0 (unannotated), returns 0 (no checking)
-- Otherwise, creates a new EffectSig with the added effect
pub(package) fn effect_add(eff: i64, eff_hash: i64) -> i64 {
  if eff == 0 { 0 }
  else {
    if eff_hash == 0 { eff }
    else {
      if ty_tag(eff) != 10 { eff }
      else {
        let old_list = ty_f1(eff)
        let new_list = nlist_new()
        -- Copy existing effects
        for i in 0..nlist_len(old_list) {
          nlist_add(new_list, nlist_get(old_list, i))
        }
        -- Add the new effect
        nlist_add(new_list, ty_effect_app(eff_hash))
        -- Handler expansion adds one concrete atom but must leave the
        -- caller's polymorphic remainder alone. Closing -[E]> here made
        -- the exact kernel state.run<S,T,E> shape reject f(): the handled
        -- State<S> was available, but the callback's E had disappeared.
        ty_effect_sig_with_tail(new_list, ty_f2(eff))
      }
    }
  }
}

-- parameterized effects: effect_add variant that appends a specific (possibly parameterized)
-- atom rather than a bare head, so a handle body's callees can charge
-- their instantiated atoms against the expanded set.
pub(package) fn effect_add_with_atom(eff: i64, eff_hash: i64, atom: i64) -> i64 {
  if atom == 0 { effect_add(eff, eff_hash) }
  else {
    if eff == 0 { 0 }
    else {
      if ty_tag(eff) != 10 { eff }
      else {
        let old_list = ty_f1(eff)
        let new_list = nlist_new()
        for i in 0..nlist_len(old_list) {
          nlist_add(new_list, nlist_get(old_list, i))
        }
        nlist_add(new_list, atom)
        ty_effect_sig_with_tail(new_list, ty_f2(eff))
      }
    }
  }
}

-- Check every function in the module — root and imported sources alike.
-- (Imported bodies were historically skipped, which let unknown calls,
-- effect drift, and type errors in use'd files pass with 0 errors.)
pub(package) fn typeck_resolve_qualified_trait_atom(atom: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  let base = trait_atom_base(atom)
  if base == 0 or ty_tag(base) != 28 { 0 }
  else {
    let module_ns = ty_f1(base)
    let module_nl = ty_f2(base)
    let trait_ns = ty_f3(base)
    let trait_nl = ty_f4(base)
    let decl = module_scope_lookup_qualified_declaration(tt, src, src, module_ns, module_nl, module_decl_namespace_trait(), src, trait_ns, trait_nl)
    if decl == 0 {
      check_module_member_resolution(node_new(2, module_ns, module_nl, 0, 0), trait_ns, trait_nl, src, tt)
    } else {
      mem_store64_at(base, 0, 27)
      mem_store64_at(base, 8, decl)
      mem_store64_at(base, 16, 0)
      mem_store64_at(base, 24, 0)
      mem_store64_at(base, 32, 0)
      0
    }
  }
}

pub(package) fn typeck_validate_trait_assoc_constraints(atom: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  let bindings = trait_atom_assoc_bindings(atom)
  if bindings == 0 { 0 }
  else {
    let trait_decl = typeck_trait_decl_from_atom(tt, trait_atom_base(atom))
    let trait_entry = if trait_decl == 0 { 0 } else { ttable_lookup_decl_fact(tt, trait_decl) }
    let trait_methods = if trait_entry == 0 { 0 } else { mem_load64_at(trait_entry, 32) }
    let trait_src = if trait_entry == 0 { src } else { mem_load64_at(trait_entry, 48) }
    let mut errors = 0
    for i in 0..nlist_len(bindings) {
      let binding = nlist_get(bindings, i)
      let assoc_hash = trait_assoc_binding_name(binding)
      let mut duplicate = false
      for prior in 0..i {
        if trait_assoc_binding_name(nlist_get(bindings, prior)) == assoc_hash { duplicate = true } else { duplicate = duplicate }
      }
      if duplicate {
        typeck_error_maybe(src, trait_assoc_binding_start(binding), "type error: duplicate associated type constraint")
        errors = errors + 1
      } else { if trait_methods == 0 or not trait_has_assoc_type(trait_methods, trait_src, assoc_hash) {
        typeck_error_maybe(src, trait_assoc_binding_start(binding), "type error: unknown associated type in trait constraint")
        errors = errors + 1
      } else { errors = errors } }
    }
    errors
  }
}

pub(package) fn typeck_resolve_qualified_trait_bounds(tparams: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  if tparams == 0 { 0 }
  else {
    let mut errors = 0
    for i in 0..nlist_len(tparams) {
      let bounds = node_f4(nlist_get(tparams, i))
      if bounds != 0 {
        for bi in 0..nlist_len(bounds) {
          let bound = nlist_get(bounds, bi)
          errors = errors + typeck_resolve_qualified_trait_atom(bound, src, tt)
          errors = errors + typeck_validate_trait_assoc_constraints(bound, src, tt)
        }
      } else { 0 }
    }
    errors
  }
}

pub(package) fn typeck_resolve_qualified_impl_traits(tt: i64) -[Diagnose]> i64 {
  if tt == 0 { 0 }
  else {
    module_scope_build_all(tt)
    let n = mem_load64_at(tt, 8)
    let d = mem_load64_at(tt, 0)
    let mut errors = 0
    for i in 0..n {
      let entry = d + i * 64
      if mem_load64_at(entry, 16) == 4 {
        let info = mem_load64_at(entry, 40)
        let src = mem_load64_at(entry, 48)
        if node_f1(info) == 0 {
          -- An inherent impl may target a type brought into this module by a
          -- selected or wildcard import. Parsing retained its method facts;
          -- now that scope is complete, attach them to the producer's exact
          -- type declaration instead of leaving anonymous method identities.
          let owner = module_scope_lookup_declaration(
            tt,
            src,
            module_decl_namespace_type(),
            src,
            mem_load64_at(entry, 0),
            mem_load64_at(entry, 8)
          )
          if owner != 0 {
            let methods = mem_load64_at(entry, 32)
            for mi in 0..nlist_len(methods) {
              let method = nlist_get(methods, mi)
              if node_tag(method) != 43 {
                let pair = module_fact_function_pair_for_node(tt, src, method)
                let declaration = if pair == 0 { 0 } else { node_tag(pair) }
                module_decl_fact_bind_owner(tt, declaration, owner)
              } else { 0 }
            }
          } else { 0 }
        } else { 0 }
        errors = errors + typeck_resolve_qualified_trait_bounds(node_f2(info), src, tt)
        let surface = node_f4(info)
        if surface != 0 and node_tag(surface) == 61 {
          let src = mem_load64_at(entry, 48)
          let module_ns = node_f1(surface)
          let module_nl = node_f2(surface)
          let trait_ns = node_f3(surface)
          let trait_nl = node_f4(surface)
          let decl = module_scope_lookup_qualified_declaration(tt, src, src, module_ns, module_nl, module_decl_namespace_trait(), src, trait_ns, trait_nl)
          if decl == 0 {
            errors = errors + check_module_member_resolution(node_new(2, module_ns, module_nl, 0, 0), trait_ns, trait_nl, src, tt)
            mem_store64_at(info, 32, 0)
          } else {
            mem_store64_at(info, 32, decl)
          }
        } else { 0 }
      } else { if mem_load64_at(entry, 16) == 3 {
        let src = mem_load64_at(entry, 48)
        let members = mem_load64_at(entry, 32)
        for mi in 0..nlist_len(members) {
          let member = nlist_get(members, mi)
          if node_tag(member) == 42 {
            let bounds = node_f3(member)
            if bounds != 0 {
              for bi in 0..nlist_len(bounds) {
                let bound = nlist_get(bounds, bi)
                errors = errors + typeck_resolve_qualified_trait_atom(bound, src, tt)
                errors = errors + typeck_validate_trait_assoc_constraints(bound, src, tt)
              }
            } else { 0 }
          } else { 0 }
        }
      } else { 0 } }
    }
    errors
  }
}

pub(package) fn typeck_resolve_qualified_effect_atom(atom: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  if atom == 0 or ty_tag(atom) != 26 { 0 }
  else {
    let module_ns = ty_f1(atom)
    let module_nl = ty_f2(atom)
    let effect_ns = ty_f3(atom)
    let meta = ty_f4(atom)
    let effect_nl = node_f1(meta)
    let args = node_f2(meta)
    let decl = module_scope_lookup_qualified_declaration(tt, src, src, module_ns, module_nl, module_decl_namespace_effect(), src, effect_ns, effect_nl)
    if decl == 0 {
      check_module_member_resolution(node_new(2, module_ns, module_nl, 0, 0), effect_ns, effect_nl, src, tt)
    } else {
      mem_store64_at(atom, 0, 25)
      mem_store64_at(atom, 8, decl)
      mem_store64_at(atom, 16, args)
      mem_store64_at(atom, 24, 0)
      mem_store64_at(atom, 32, 0)
      0
    }
  }
}

pub(package) fn typeck_opaque_decl_stack_contains(stack: i64, declaration: i64) -> i64 {
  let mut found = 0
  let mut i = 0
  while stack != 0 and i < nlist_len(stack) and found == 0 {
    if nlist_get(stack, i) == declaration { found = 1 } else { i = i + 1 }
  }
  found
}

pub(package) fn typeck_opaque_decl_stack_push(stack: i64, declaration: i64) -> i64 {
  let next = nlist_new()
  if stack != 0 { for i in 0..nlist_len(stack) { nlist_add(next, nlist_get(stack, i)) } } else { 0 }
  nlist_add(next, declaration)
  next
}

-- Resolve representation metadata for parsed nominal references. Ordinary
-- named atoms deliberately retain their existing hash identity; opaque atoms
-- carry their substituted ABI shape, while closed payloadless variants carry
-- the declaration fact that proves their scalar, unmanaged representation.
pub(package) fn typeck_resolve_named_representation(ty: i64, src: i64, tt: i64, stack: i64) -[Diagnose]> i64 {
  if not ty_named_is_surface(ty) { 0 }
  else {
    let name_start = ty_named_surface_start(ty)
    let name_len = ty_named_surface_len(ty)
    let declaration = module_scope_lookup_declaration(tt, src, module_decl_namespace_type(), src, name_start, name_len)
    let entry = ttable_lookup_decl_fact(tt, declaration)
    if entry != 0 and typeck_variant_entry_is_payloadless(entry) == 1 {
      ty_named_resolve_payloadless_variant(ty, declaration, mem_load64_at(entry, 56))
      0
    } else { if entry == 0 or mem_load64_at(entry, 16) != 5 { 0 }
    else {
      let type_args = ty_f3(ty)
      let actual = if type_args == 0 { 0 } else { nlist_len(type_args) }
      let tparams = mem_load64_at(entry, 40)
      let expected = if tparams == 0 { 0 } else { nlist_len(tparams) }
      if typeck_opaque_decl_stack_contains(stack, declaration) == 1 {
        typeck_error_maybe(src, name_start, "type error: opaque value representation is recursively defined")
        ty_named_resolve_opaque(ty, declaration, mem_load64_at(entry, 56), ty_any())
        1
      } else {
        let arity_errors = if actual != expected {
          typeck_error_maybe(src, name_start, "type error: opaque type argument count mismatch")
          1
        } else { 0 }
        let raw = ttable_entry_opaque_representation(entry)
        let representation = if arity_errors != 0 { ty_any() }
          else { if expected == 0 { raw } else { ty_subst(raw, type_cycle_subst_for_entry(entry, type_args)) } }
        ty_named_resolve_opaque(ty, declaration, mem_load64_at(entry, 56), representation)
        let entry_src = mem_load64_at(entry, 48)
        arity_errors + typeck_resolve_qualified_effects_in_ty_inner(representation, entry_src, tt, typeck_opaque_decl_stack_push(stack, declaration))
      }
    } }
  }
}

-- Conformance-table construction precedes ordinary signature diagnostics.
-- Resolve valid representation-bearing atoms in impl targets at that producer
-- seam, without broadening the diagnostic surface of embedded grammar hosts.
pub(package) fn typeck_prepare_impl_target_representation_ty(ty: i64, src: i64, tt: i64) -> i64 {
  if ty == 0 { 0 }
  else {
    match ty_tag(ty) {
      9 -> {
        let args = ty_f3(ty)
        if args != 0 {
          for i in 0..nlist_len(args) { typeck_prepare_impl_target_representation_ty(nlist_get(args, i), src, tt) }
        } else { 0 }
        if ty_named_is_surface(ty) {
          let name_start = ty_named_surface_start(ty)
          let name_len = ty_named_surface_len(ty)
          let declaration = module_scope_lookup_declaration(tt, src, module_decl_namespace_type(), src, name_start, name_len)
          let entry = ttable_lookup_decl_fact(tt, declaration)
          if entry != 0 and typeck_variant_entry_is_payloadless(entry) == 1 {
            ty_named_resolve_payloadless_variant(ty, declaration, mem_load64_at(entry, 56))
          } else { if entry != 0 and mem_load64_at(entry, 16) == 5 {
            let tparams = mem_load64_at(entry, 40)
            let expected = if tparams == 0 { 0 } else { nlist_len(tparams) }
            let actual = if args == 0 { 0 } else { nlist_len(args) }
            if actual == expected {
              let raw = ttable_entry_opaque_representation(entry)
              let representation = if expected == 0 { raw } else { ty_subst(raw, type_cycle_subst_for_entry(entry, args)) }
              ty_named_resolve_opaque(ty, declaration, mem_load64_at(entry, 56), representation)
            } else { 0 }
          } else { 0 } }
        } else { 0 }
      }
      3 -> typeck_prepare_impl_target_representation_ty(ty_f1(ty), src, tt) + typeck_prepare_impl_target_representation_ty(ty_f2(ty), src, tt)
      4 -> typeck_prepare_impl_target_representation_ty(ty_f1(ty), src, tt) + typeck_prepare_impl_target_representation_ty(ty_f2(ty), src, tt)
      14 -> typeck_prepare_impl_target_representation_ty(ty_f1(ty), src, tt) + typeck_prepare_impl_target_representation_ty(ty_f2(ty), src, tt)
      5 -> typeck_prepare_impl_target_representation_ty(ty_f1(ty), src, tt)
      8 -> typeck_prepare_impl_target_representation_ty(ty_f1(ty), src, tt)
      15 -> typeck_prepare_impl_target_representation_ty(ty_f1(ty), src, tt)
      16 -> typeck_prepare_impl_target_representation_ty(ty_f1(ty), src, tt)
      17 -> typeck_prepare_impl_target_representation_ty(ty_f1(ty), src, tt)
      18 -> typeck_prepare_impl_target_representation_ty(ty_f1(ty), src, tt)
      19 -> typeck_prepare_impl_target_representation_ty(ty_f1(ty), src, tt)
      29 -> typeck_prepare_impl_target_representation_ty(ty_f1(ty), src, tt)
      21 -> typeck_prepare_impl_target_representation_ty(ty_f1(ty), src, tt)
      22 -> typeck_prepare_impl_target_representation_ty(ty_f1(ty), src, tt)
      23 -> typeck_prepare_impl_target_representation_ty(ty_f1(ty), src, tt)
      _ -> 0
    }
  }
}

pub(package) fn typeck_prepare_impl_target_representations(tt: i64) -> i64 {
  if tt == 0 { 0 }
  else {
    let n = mem_load64_at(tt, 8)
    let d = mem_load64_at(tt, 0)
    for i in 0..n {
      let entry = d + i * 64
      if mem_load64_at(entry, 16) == 4 {
        typeck_prepare_impl_target_representation_ty(node_f3(mem_load64_at(entry, 40)), mem_load64_at(entry, 48), tt)
      } else { 0 }
    }
    0
  }
}

pub(package) fn typeck_resolve_qualified_effects_in_ty_inner(ty: i64, src: i64, tt: i64, opaque_stack: i64) -[Diagnose]> i64 {
  if ty == 0 { 0 }
  else {
    let tag = ty_tag(ty)
    if tag == 26 { typeck_resolve_qualified_effect_atom(ty, src, tt) }
    else { if tag == 10 {
      let mut errors = 0
      let atoms = ty_f1(ty)
      for i in 0..nlist_len(atoms) { errors = errors + typeck_resolve_qualified_effects_in_ty_inner(nlist_get(atoms, i), src, tt, opaque_stack) }
      errors
    } else { if tag == 11 or tag == 25 {
      let args = ty_f2(ty)
      let mut errors = 0
      if args != 0 {
        for i in 0..nlist_len(args) {
          errors = errors + typeck_resolve_qualified_effects_in_ty_inner(nlist_get(args, i), src, tt, opaque_stack)
        }
      } else { 0 }
      errors
    } else { if tag == 6 {
      let mut errors = typeck_resolve_qualified_effects_in_ty_inner(ty_f2(ty), src, tt, opaque_stack) + typeck_resolve_qualified_effects_in_ty_inner(ty_f3(ty), src, tt, opaque_stack)
      for i in 0..nlist_len(ty_f1(ty)) { errors = errors + typeck_resolve_qualified_effects_in_ty_inner(nlist_get(ty_f1(ty), i), src, tt, opaque_stack) }
      errors
    } else { if tag == 3 or tag == 4 or tag == 14 {
      typeck_resolve_qualified_effects_in_ty_inner(ty_f1(ty), src, tt, opaque_stack) + typeck_resolve_qualified_effects_in_ty_inner(ty_f2(ty), src, tt, opaque_stack)
    } else { if tag == 5 or tag == 8 or tag == 15 or tag == 16 or tag == 17 or tag == 18 or tag == 19 or tag == 21 or tag == 22 or tag == 23 or tag == 29 {
      typeck_resolve_qualified_effects_in_ty_inner(ty_f1(ty), src, tt, opaque_stack)
    } else { if tag == 9 {
      let mut errors = 0
      let args = ty_f3(ty)
      if args != 0 { for i in 0..nlist_len(args) { errors = errors + typeck_resolve_qualified_effects_in_ty_inner(nlist_get(args, i), src, tt, opaque_stack) } } else { 0 }
      if ty_named_is_surface(ty) { errors = errors + typeck_resolve_named_representation(ty, src, tt, opaque_stack) }
      else { if not ty_named_is_opaque(ty) { errors = errors + typeck_resolve_qualified_effects_in_ty_inner(ty_f2(ty), src, tt, opaque_stack) } else { 0 } }
      errors
    } else { if tag == 7 {
      let mut errors = 0
      let fields = ty_record_fields(ty)
      for i in 0..nlist_len(fields) { errors = errors + typeck_resolve_qualified_effects_in_ty_inner(ty_record_field_type(nlist_get(fields, i)), src, tt, opaque_stack) }
      errors
    } else { 0 } } } } } } } }
  }
}

pub(package) fn typeck_resolve_qualified_effects_in_ty(ty: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  typeck_resolve_qualified_effects_in_ty_inner(ty, src, tt, nlist_new())
}

pub(package) fn typeck_resolve_opaque_declarations(tt: i64, user_src: i64) -[Diagnose]> i64 {
  if tt == 0 { 0 }
  else {
    let n = mem_load64_at(tt, 8)
    let d = mem_load64_at(tt, 0)
    let mut errors = 0
    for i in 0..n {
      let entry = d + i * 64
      let kind = mem_load64_at(entry, 16)
      let entry_src = mem_load64_at(entry, 48)
      if kind == 5 and (user_src == 0 or entry_src == user_src) {
        let declaration = module_decl_fact_find(tt, entry_src, module_decl_namespace_type(), entry_src, mem_load64_at(entry, 0), mem_load64_at(entry, 8))
        let stack = if declaration == 0 { nlist_new() } else { typeck_opaque_decl_stack_push(nlist_new(), declaration) }
        errors = errors + typeck_resolve_qualified_effects_in_ty_inner(ttable_entry_opaque_representation(entry), entry_src, tt, stack)
      } else { errors = errors }
    }
    errors
  }
}

-- Records, variants, effect operations and trait methods live in the type
-- registry rather than the function catalog. Resolve their complete
-- signatures in the same identity prepass as ordinary functions so opaque
-- atoms (and qualified effects nested inside their types) cannot remain
-- surface-only placeholders.
pub(package) fn typeck_resolve_decl_signature_types(tt: i64, user_src: i64) -[Diagnose]> i64 {
  if tt == 0 { 0 }
  else {
    let n = mem_load64_at(tt, 8)
    let d = mem_load64_at(tt, 0)
    let mut errors = 0
    for i in 0..n {
      let entry = d + i * 64
      let kind = mem_load64_at(entry, 16)
      let entry_src = mem_load64_at(entry, 48)
      if (user_src == 0 or entry_src == user_src) and kind == 0 {
        let fields = mem_load64_at(entry, 32)
        for j in 0..mem_load64_at(entry, 24) {
          errors = errors + typeck_resolve_qualified_effects_in_ty(mem_load64_at(fields, j * 24 + 16), entry_src, tt)
        }
      } else { if (user_src == 0 or entry_src == user_src) and kind == 1 {
        let variants = mem_load64_at(entry, 32)
        for j in 0..mem_load64_at(entry, 24) {
          let payloads = mem_load64_at(variants, j * 40 + 32)
          for pi in 0..mem_load64_at(variants, j * 40 + 24) {
            errors = errors + typeck_resolve_qualified_effects_in_ty(nlist_get(payloads, pi), entry_src, tt)
          }
        }
      } else { if (kind == 2 or kind == 3 or kind == 4) and (user_src == 0 or entry_src == user_src) {
        let members = mem_load64_at(entry, 32)
        if kind == 4 {
          let impl_info = mem_load64_at(entry, 40)
          errors = errors + typeck_resolve_qualified_effects_in_ty(node_f3(impl_info), entry_src, tt)
        } else { errors = errors }
        for j in 0..mem_load64_at(entry, 24) {
          let member = nlist_get(members, j)
          if kind == 2 and node_tag(member) == 31 {
            errors = errors + typeck_resolve_qualified_effects_in_ty(effect_op_ret_type(member), entry_src, tt)
            let params = node_f3(member)
            for pi in 0..nlist_len(params) {
              errors = errors + typeck_resolve_qualified_effects_in_ty(node_f3(nlist_get(params, pi)), entry_src, tt)
            }
          } else { if kind == 3 and node_tag(member) == 39 {
            let meta = node_f4(member)
            errors = errors + typeck_resolve_qualified_effects_in_ty(node_f1(meta), entry_src, tt)
            errors = errors + typeck_resolve_qualified_effects_in_ty(node_f2(meta), entry_src, tt)
            let params = node_f3(member)
            for pi in 0..nlist_len(params) {
              errors = errors + typeck_resolve_qualified_effects_in_ty(node_f3(nlist_get(params, pi)), entry_src, tt)
            }
          } else { if kind == 4 and node_tag(member) == 43 {
            errors = errors + typeck_resolve_qualified_effects_in_ty(node_f3(member), entry_src, tt)
          } else { errors = errors } } }
        }
      } else { errors = errors } } }
    }
    errors
  }
}

pub(package) fn typeck_resolve_qualified_effects_in_fn(fn_node: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  let inner = fn_inner(fn_node)
  let params = node_f3(inner)
  let mut errors = typeck_resolve_qualified_effects_in_ty(fn_ret_type(fn_node), src, tt) + typeck_resolve_qualified_effects_in_ty(fn_effects(fn_node), src, tt) + typeck_resolve_qualified_trait_bounds(fn_tparams(fn_node), src, tt)
  for i in 0..nlist_len(params) { errors = errors + typeck_resolve_qualified_effects_in_ty(node_f3(nlist_get(params, i)), src, tt) }
  errors
}

pub(package) fn check_user_fns(fns: i64, user_src: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let n = nlist_len(fns)
  let ft = ftypes_new_with_ttable(tt)
  -- Every loaded function body is checked below, not just the root body's.
  -- Prepare every declaration signature on the same graph-wide basis as the
  -- ordinary function signatures so imported effect operations and trait
  -- methods cannot retain surface-only opaque placeholders.
  let mut signature_identity_errors = typeck_resolve_opaque_declarations(tt, 0) + typeck_resolve_decl_signature_types(tt, 0)
  for ri in 0..n {
    let pair = nlist_get(fns, ri)
    signature_identity_errors = signature_identity_errors + typeck_resolve_qualified_effects_in_fn(node_f1(pair), node_f2(pair), tt)
  }
  let handler_identity_errors = typeck_resolve_module_handler_facts(tt)
  typeck_wrap_module_default_handlers(fns, tt, 0)
  -- Pass 1: register all function return types
  for i in 0..n {
    let pair = nlist_get(fns, i)
    let fn_wrap = node_f1(pair)
    let fn_src = node_f2(pair)
    let inner = fn_inner(fn_wrap)
    let reg_entry = ftypes_add(ft, fn_src, node_f1(inner), node_f2(inner), fn_ret_type(fn_wrap), node_f3(inner), fn_effects(fn_wrap), fn_tparams(fn_wrap))
    if node_f3(pair) != 0 {
      mem_store64_at(reg_entry, 72, 1)
      if node_tag(pair) != 0 { mem_store64_at(reg_entry, 80, node_tag(pair)) } else { 0 }
    }
    else { ftypes_bind_decl_fact(reg_entry, tt, fn_src, node_f1(inner), node_f2(inner)) }
    ftypes_set_body_entry(reg_entry, node_f4(inner))
  }
  register_native_binding_functions(ft, tt)
  -- Register variant constructors from type table
  register_ctors(ft, tt, user_src)
  -- Retain the checker-owned resolved signature catalog as a semantic
  -- fact producer. Tooling reads this shared fact; it must not rebuild a
  -- parallel function/type index from AST nodes.
  ttable_set_checked_functions(tt, ft)
  -- Pass 2: check impl declarations and functions from user_src
  let mut total_errors = signature_identity_errors + handler_identity_errors + typeck_resolve_constants(tt, ft) + check_type_cycles(tt, user_src) + check_aggregate_release_mask_capacity(tt, user_src) + check_impl_decls(tt, user_src) + check_decl_signature_surfaces(tt, user_src) + check_reserved_structural_trait_decls(tt, user_src)
  for j in 0..n {
    let pair = nlist_get(fns, j)
    let fn_src = node_f2(pair)
    total_errors = total_errors + check_fn(node_f1(pair), ft, fn_src, tt)
  }
  total_errors = total_errors + check_imported_unsafe_raw_fns(fns, user_src, tt)
  total_errors = total_errors + check_strict_root_unsafe_raw_fns(fns, user_src, tt)
  total_errors
}

-- Extend an immutable checked project base with one root's newly parsed
-- functions. The inherited signature catalog and typed bodies stay exact;
-- only pairs absent from the checked-product set receive signature/body work.
-- Declaration-wide audits retain the ordinary root contract, and the combined
-- conformance table is rebuilt by the pipeline before this function runs.
pub(package) fn check_user_fns_extending_checked(fns: i64, user_src: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let inherited = ttable_get_checked_functions(tt)
  if inherited == 0 or nlist_len(ttable_checked_module_pairs(tt)) == 0 {
    check_user_fns(fns, user_src, tt)
  } else {
    let ft = inherited
    let n = nlist_len(fns)
    let mut signature_identity_errors = typeck_resolve_opaque_declarations(tt, 0) + typeck_resolve_decl_signature_types(tt, 0)
    for ri in 0..n {
      let pair = nlist_get(fns, ri)
      if ttable_function_pair_is_checked(tt, pair) == 0 {
        signature_identity_errors = signature_identity_errors + typeck_resolve_qualified_effects_in_fn(node_f1(pair), node_f2(pair), tt)
      } else { 0 }
    }
    let handler_identity_errors = typeck_resolve_module_handler_facts(tt)
    typeck_wrap_module_default_handlers(fns, tt, 1)
    for i in 0..n {
      let pair = nlist_get(fns, i)
      if ttable_function_pair_is_checked(tt, pair) == 0 {
        let fn_wrap = node_f1(pair)
        let fn_src = node_f2(pair)
        let inner = fn_inner(fn_wrap)
        let reg_entry = ftypes_add(ft, fn_src, node_f1(inner), node_f2(inner), fn_ret_type(fn_wrap), node_f3(inner), fn_effects(fn_wrap), fn_tparams(fn_wrap))
        if node_f3(pair) != 0 {
          mem_store64_at(reg_entry, 72, 1)
          if node_tag(pair) != 0 { mem_store64_at(reg_entry, 80, node_tag(pair)) } else { 0 }
        }
        else { ftypes_bind_decl_fact(reg_entry, tt, fn_src, node_f1(inner), node_f2(inner)) }
        ftypes_set_body_entry(reg_entry, node_f4(inner))
      } else { 0 }
    }
    register_native_binding_functions(ft, tt)
    -- This currently revisits inherited constructors. Their exact DeclId makes
    -- the duplicate entries semantically idempotent; a module-local type range
    -- can remove this residual setup cost after the body-reuse win is priced.
    register_ctors(ft, tt, user_src)
    ttable_set_checked_functions(tt, ft)
    let mut total_errors = signature_identity_errors + handler_identity_errors + typeck_resolve_constants(tt, ft) + check_type_cycles(tt, user_src) + check_aggregate_release_mask_capacity(tt, user_src) + check_impl_decls(tt, user_src) + check_decl_signature_surfaces(tt, user_src) + check_reserved_structural_trait_decls(tt, user_src)
    for j in 0..n {
      let pair = nlist_get(fns, j)
      if ttable_function_pair_is_checked(tt, pair) == 0 {
        total_errors = total_errors + check_fn(node_f1(pair), ft, node_f2(pair), tt)
      } else { 0 }
    }
    total_errors = total_errors + check_imported_unsafe_raw_fns(fns, user_src, tt)
    total_errors = total_errors + check_strict_root_unsafe_raw_fns(fns, user_src, tt)
    total_errors
  }
}

-- Check all functions in a module
pub(package) fn check_module(fns: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let n = nlist_len(fns)
  let ft = ftypes_new_with_ttable(tt)
  let mut signature_identity_errors = typeck_resolve_opaque_declarations(tt, 0) + typeck_resolve_decl_signature_types(tt, 0)
  for ri in 0..n {
    let pair = nlist_get(fns, ri)
    signature_identity_errors = signature_identity_errors + typeck_resolve_qualified_effects_in_fn(node_f1(pair), node_f2(pair), tt)
  }
  let handler_identity_errors = typeck_resolve_module_handler_facts(tt)
  typeck_wrap_module_default_handlers(fns, tt, 0)
  -- Pass 1: register all function return types (use declared type or any)
  for i in 0..n {
    let pair = nlist_get(fns, i)
    let fn_node = node_f1(pair)
    let fn_src = node_f2(pair)
    let inner = fn_inner(fn_node)
    let reg_entry = ftypes_add(ft, fn_src, node_f1(inner), node_f2(inner), fn_ret_type(fn_node), node_f3(inner), fn_effects(fn_node), fn_tparams(fn_node))
    if node_f3(pair) != 0 {
      mem_store64_at(reg_entry, 72, 1)
      if node_tag(pair) != 0 { mem_store64_at(reg_entry, 80, node_tag(pair)) } else { 0 }
    }
    else { ftypes_bind_decl_fact(reg_entry, tt, fn_src, node_f1(inner), node_f2(inner)) }
    ftypes_set_body_entry(reg_entry, node_f4(inner))
  }
  register_native_binding_functions(ft, tt)
  -- See check_user_fns: publish after every declaration has a stable DeclId
  -- and before body checking so diagnostics and facts describe one catalog.
  ttable_set_checked_functions(tt, ft)
  -- Pass 2: check impl declarations and all function bodies
  let mut total_errors = signature_identity_errors + handler_identity_errors + typeck_resolve_constants(tt, ft) + check_type_cycles(tt, 0) + check_aggregate_release_mask_capacity(tt, 0) + check_impl_decls(tt, 0) + check_decl_signature_surfaces(tt, 0) + check_reserved_structural_trait_decls(tt, 0)
  for j in 0..n {
    let pair = nlist_get(fns, j)
    let fn_node = node_f1(pair)
    let fn_src = node_f2(pair)
    total_errors = total_errors + check_fn(fn_node, ft, fn_src, tt)
  }
  total_errors
}
