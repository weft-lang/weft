-- compiler/typeck.weft — Bidirectional type checker
--
-- Synthesizes types bottom-up for expressions:
--   IntLit → i64, StringLit → str, true/false → bool
--   BinOp(+,-,*,/,%) → i64 (both operands must be i64)
--   BinOp(==,!=,<,>,<=,>=) → bool
--   BinOp(and,or) → bool
--   not expr → bool
--   if/else → unify branches
--   function call → return type of function
--
-- Reports type errors through Diagnose where migrated, with legacy direct
-- stderr emission still present in older checker paths.
-- Does NOT block compilation — errors are informational for now.

-- Dependencies: lib.weft, types.weft (loaded by caller)

use "runtime/alloc.weft"
use "runtime/memory.weft"
use "compiler/typecheck_effect.weft"

-- span is an offset into src; the diagnostic carries the absolute address so
-- the renderer can resolve which loaded source buffer it belongs to. Spans
-- already above the offset ceiling are assumed absolute and passed through.
fn typeck_error(src: i64, span: i64, msg: str) -[Diagnose]> i64 {
  let abs_span = if span < 0 { span }
    else { if span < diagnose_max_render_span() { src + span } else { span } }
  Diagnose.error(msg, abs_span)
}

fn typeck_error_maybe(src: i64, span: i64, msg: str) -[Diagnose]> i64 {
  let diag_span = if span > 0 { span } else { 0 - 1 }
  typeck_error(src, diag_span, msg)
}

-- Type environment: maps variable names to types
-- Linked list of {name_start, name_len, type, src, next, mutable, value_origin}
fn tenv_new() -> i64 { 0 }

fn tenv_bind_full(env: i64, src: i64, ns: i64, nl: i64, ty: i64, mutable: i64, value_origin: i64) -> i64 {
  let e = alloc_words(7)
  mem_store64_at(e, 0, ns)
  mem_store64_at(e, 8, nl)
  mem_store64_at(e, 16, ty)
  mem_store64_at(e, 24, src)
  mem_store64_at(e, 32, env)
  mem_store64_at(e, 40, mutable)
  mem_store64_at(e, 48, value_origin)
  e
}

fn tenv_bind_with_mut(env: i64, src: i64, ns: i64, nl: i64, ty: i64, mutable: i64) -> i64 {
  tenv_bind_full(env, src, ns, nl, ty, mutable, 0)
}

fn tenv_bind(env: i64, src: i64, ns: i64, nl: i64, ty: i64) -> i64 {
  tenv_bind_with_mut(env, src, ns, nl, ty, 0)
}

fn tenv_bind_value(env: i64, src: i64, ns: i64, nl: i64, ty: i64, value_origin: i64) -> i64 {
  tenv_bind_full(env, src, ns, nl, ty, 0, value_origin)
}

fn tenv_bind_mut(env: i64, src: i64, ns: i64, nl: i64, ty: i64) -> i64 {
  tenv_bind_with_mut(env, src, ns, nl, ty, 1)
}

fn tenv_lookup(env: i64, src: i64, ns: i64, nl: i64) -> i64 {
  if env == 0 { 0 }
  else {
    let e_ns = mem_load64_at(env, 0)
    let e_nl = mem_load64_at(env, 8)
    let e_src = mem_load64_at(env, 24)
    if e_nl == nl {
      if src_eq_at(src, ns, e_src + e_ns, 0, nl) == 1 {
        mem_load64_at(env, 16)
      } else { tenv_lookup(mem_load64_at(env, 32), src, ns, nl) }
    } else { tenv_lookup(mem_load64_at(env, 32), src, ns, nl) }
  }
}

fn tenv_lookup_value(env: i64, src: i64, ns: i64, nl: i64) -> i64 {
  if env == 0 { 0 }
  else {
    let e_ns = mem_load64_at(env, 0)
    let e_nl = mem_load64_at(env, 8)
    let e_src = mem_load64_at(env, 24)
    if e_nl == nl {
      if src_eq_at(src, ns, e_src + e_ns, 0, nl) == 1 {
        mem_load64_at(env, 48)
      } else { tenv_lookup_value(mem_load64_at(env, 32), src, ns, nl) }
    } else { tenv_lookup_value(mem_load64_at(env, 32), src, ns, nl) }
  }
}

fn tenv_lookup_mutable(env: i64, src: i64, ns: i64, nl: i64) -> i64 {
  if env == 0 { 0 }
  else {
    let e_ns = mem_load64_at(env, 0)
    let e_nl = mem_load64_at(env, 8)
    let e_src = mem_load64_at(env, 24)
    if e_nl == nl {
      if src_eq_at(src, ns, e_src + e_ns, 0, nl) == 1 {
        mem_load64_at(env, 40)
      } else { tenv_lookup_mutable(mem_load64_at(env, 32), src, ns, nl) }
    } else { tenv_lookup_mutable(mem_load64_at(env, 32), src, ns, nl) }
  }
}

-- Function type table: maps function names to {param_types, ret_type}
-- For now, a simple list. Built during pass 1 of type checking.
fn ftypes_new() -> i64 { nlist_new() }

fn ftypes_add(ft: i64, src: i64, ns: i64, nl: i64, ret_ty: i64, params: i64, effects: i64, tparams: i64) -> i64 {
  let e = alloc_words(10)
  mem_store64_at(e, 0, ns)
  mem_store64_at(e, 8, nl)
  mem_store64_at(e, 16, ret_ty)
  mem_store64_at(e, 24, src)
  mem_store64_at(e, 32, params)
  mem_store64_at(e, 40, effects)
  mem_store64_at(e, 48, tparams)
  mem_store64_at(e, 56, 0)
  -- Same-name collision chain (offset 64): distinct declarations sharing a
  -- name hash link here so lookups can prefer the caller's own source.
  mem_store64_at(e, 64, 0)
  -- offset 72: nonzero when this entry is an impl method registered under
  -- its bare name; such entries never shadow plain functions.
  mem_store64_at(e, 72, 0)
  nlist_add(ft, e)
  e
}

-- Function-type lookups were linear byte-compare scans per call
-- expression; a hash-ordered tree in the list's fourth header word
-- answers them. Finds interleave with adds during setup, so the index
-- tops up incrementally: on a length change only the new entries are
-- inserted (first-wins, matching the scan's first-declaration
-- resolution). Rollback-reused cache memory is rejected by the
-- owner + magic + monotone-length guard.
fn ftypes_index_magic() -> i64 { 91542376012 }

fn ftypes_index_insert(tree: i64, hash: i64, entry: i64) -> i64 {
  let leaf = node_new(0, hash, entry, 0, 0)
  if tree == 0 { leaf }
  else {
    let mut cur = tree
    let mut done = 0
    while done == 0 {
      let cur_hash = node_f1(cur)
      if hash < cur_hash {
        if node_f3(cur) == 0 {
          mem_store64_at(cur, 24, leaf)
          done = 1
        } else { cur = node_f3(cur) }
      } else { if hash > cur_hash {
        if node_f4(cur) == 0 {
          mem_store64_at(cur, 32, leaf)
          done = 1
        } else { cur = node_f4(cur) }
      } else {
        -- Same hash: keep first-wins head, chain the newcomer so lookups
        -- can prefer an entry declared in the caller's source.
        let mut chain = node_f2(cur)
        let mut linked = 0
        while linked == 0 {
          if chain == entry { linked = 1 }
          else { if mem_load64_at(chain, 64) == 0 {
            mem_store64_at(chain, 64, entry)
            linked = 1
          } else { chain = mem_load64_at(chain, 64) } }
        }
        done = 1
      } }
    }
    tree
  }
}

fn ftypes_index(ft: i64) -> i64 {
  let n = nlist_len(ft)
  let cached = mem_load64_at(ft, 24)
  let valid = if cached != 0 {
    if node_f3(cached) == ft and node_f4(cached) == ftypes_index_magic() and node_f2(cached) <= n { 1 } else { 0 }
  } else { 0 }
  if valid == 1 and node_f2(cached) == n {
    node_f1(cached)
  } else {
    let mut tree = if valid == 1 { node_f1(cached) } else { 0 }
    let mut i = if valid == 1 { node_f2(cached) } else { 0 }
    while i < n {
      let e = nlist_get(ft, i)
      tree = ftypes_index_insert(tree, str_hash(mem_load64_at(e, 24), mem_load64_at(e, 0), mem_load64_at(e, 8)), e)
      i = i + 1
    }
    mem_store64_at(ft, 24, node_new(0, tree, n, ft, ftypes_index_magic()))
    tree
  }
}

fn ftypes_find(ft: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let tree = ftypes_index(ft)
  let hash = str_hash(src, ns, nl)
  let mut cur = tree
  let mut result = 0
  while cur != 0 {
    let cur_hash = node_f1(cur)
    if hash == cur_hash {
      result = node_f2(cur)
      -- On a name collision, a non-method declaration in the caller's own
      -- source shadows imported ones; otherwise first declaration wins.
      let mut chain = mem_load64_at(result, 64)
      while chain != 0 {
        if mem_load64_at(chain, 24) == src and mem_load64_at(chain, 72) == 0 {
          result = chain
          chain = 0
        } else { chain = mem_load64_at(chain, 64) }
      }
      cur = 0
    } else { if hash < cur_hash { cur = node_f3(cur) } else { cur = node_f4(cur) } }
  }
  result
}

fn ftypes_set_body(ft: i64, src: i64, ns: i64, nl: i64, body: i64) -> i64 {
  let e = ftypes_find(ft, src, ns, nl)
  if e == 0 { 0 } else { mem_store64_at(e, 56, body) 1 }
}

fn ftypes_lookup_body(ft: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let e = ftypes_find(ft, src, ns, nl)
  if e == 0 { 0 } else { mem_load64_at(e, 56) }
}

-- Look up return type
fn ftypes_lookup(ft: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let e = ftypes_find(ft, src, ns, nl)
  if e == 0 { 0 } else { mem_load64_at(e, 16) }
}

-- Look up params list for a function
fn ftypes_lookup_params(ft: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let e = ftypes_find(ft, src, ns, nl)
  if e == 0 { 0 } else { mem_load64_at(e, 32) }
}

-- Look up effects for a function
fn ftypes_lookup_effects(ft: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let e = ftypes_find(ft, src, ns, nl)
  if e == 0 { 0 } else { mem_load64_at(e, 40) }
}

-- Look up type params for a function (for generics)
fn ftypes_lookup_tparams(ft: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let e = ftypes_find(ft, src, ns, nl)
  if e == 0 { 0 } else { mem_load64_at(e, 48) }
}

fn param_type_list(params: i64) -> i64 {
  let result = nlist_new()
  let n = nlist_len(params)
  for i in 0..n {
    let p = nlist_get(params, i)
    let ty = node_f3(p)
    if ty != 0 { nlist_add(result, ty) }
    else { nlist_add(result, ty_any()) }
  }
  result
}

fn ftypes_lookup_fn_type(ft: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let ret = ftypes_lookup(ft, src, ns, nl)
  if ret == 0 { 0 }
  else {
    let params = ftypes_lookup_params(ft, src, ns, nl)
    let effects = ftypes_lookup_effects(ft, src, ns, nl)
    ty_fn(param_type_list(params), ret, effects)
  }
}

-- ══════════════════════════════════════════════════════════════
-- Conformance table: maps (type_hash, trait_hash) → method list
-- Entry: [type_hash(8), trait_hash(8), methods_ptr(8)] = 24 bytes
-- Used by the DNF emptiness checker to determine if
-- a conjunction like `i64 & Display` is satisfiable.
-- ══════════════════════════════════════════════════════════════

fn ctable_new() -> i64 {
  let h = alloc_words(3)
  let d = alloc_words(2000)
  mem_store64_at(h, 0, d)
  mem_store64_at(h, 8, 0)
  mem_store64_at(h, 16, 500)
  h
}

fn ctable_add_full(ct: i64, type_hash: i64, trait_hash: i64, methods: i64, impl_tp: i64) -> i64 {
  let d = mem_load64_at(ct, 0)
  let n = mem_load64_at(ct, 8)
  let cap = mem_load64_at(ct, 16)
  if n >= cap { ct }
  else {
    mem_store64_at(d, n * 32, type_hash)
    mem_store64_at(d, n * 32 + 8, trait_hash)
    mem_store64_at(d, n * 32 + 16, methods)
    mem_store64_at(d, n * 32 + 24, impl_tp)
    mem_store64_at(ct, 8, n + 1)
    ct
  }
}

fn ctable_add(ct: i64, type_hash: i64, trait_hash: i64, methods: i64) -> i64 {
  ctable_add_full(ct, type_hash, trait_hash, methods, 0)
}

-- Check if (type_hash, trait_hash) exists in the conformance table.
-- For conditional impls with tparams, recursively checks that the
-- type args satisfy the impl's bounds.
fn ctable_conforms(ct: i64, type_hash: i64, trait_hash: i64) -> i64 {
  if ct == 0 { false }
  else {
    let d = mem_load64_at(ct, 0)
    let n = mem_load64_at(ct, 8)
    let mut i = 0
    let mut found = false
    while i < n {
      if mem_load64_at(d, i * 32) == type_hash {
        if mem_load64_at(d, i * 32 + 8) == trait_hash {
          found = true
          i = n
        } else { i = i + 1 }
      } else { i = i + 1 }
    }
    found
  }
}

-- Build conformance table from impl blocks in the ttable
-- Scans for kind=4 entries (impl blocks) and registers conformances
-- Look up a trait declaration in the ttable by name hash.
-- Returns the methods list (nlist of tag-39 nodes), or 0 if not found.
fn lookup_trait_methods(tt: i64, src: i64, trait_hash: i64) -> i64 {
  if tt == 0 { 0 }
  else {
    let n = mem_load64_at(tt, 8)
    let d = mem_load64_at(tt, 0)
    let mut i = 0
    let mut result = 0
    while i < n {
      let kind = mem_load64_at(d, i * 64 + 16)
      if kind == 3 {
        let t_ns = mem_load64_at(d, i * 64)
        let t_nl = mem_load64_at(d, i * 64 + 8)
        let t_src = mem_load64_at(d, i * 64 + 48)
        let t_hash = effect_name_hash(t_src, t_ns, t_nl)
        if t_hash == trait_hash {
          result = mem_load64_at(d, i * 64 + 32)
          i = n
        } else { i = i + 1 }
      } else { i = i + 1 }
    }
    result
  }
}

-- Verify that an impl block's methods match the trait declaration.
-- Returns number of errors found.
fn effect_sig_is_empty(eff: i64) -> bool {
  if eff == 0 { true }
  else {
    if ty_tag(eff) != 10 { true }
    else { nlist_len(ty_f1(eff)) == 0 and ty_f2(eff) == 0 }
  }
}

fn effect_sig_subset(actual: i64, expected: i64) -> bool {
  if actual == 0 { true }
  else {
    if expected == 0 { effect_sig_is_empty(actual) }
    else { effect_is_subset(actual, expected) }
  }
}

fn param_type_or_any(param: i64) -> i64 {
  let ty = node_f3(param)
  if ty != 0 { ty } else { ty_any() }
}

fn trait_method_ret_or_any(method: i64) -> i64 {
  let ret_wrap = node_f4(method)
  if ret_wrap == 0 { ty_any() }
  else {
    let ret_ty = node_f1(ret_wrap)
    if ret_ty != 0 { ret_ty } else { ty_any() }
  }
}

fn trait_method_effects(method: i64) -> i64 {
  let ret_wrap = node_f4(method)
  if ret_wrap == 0 { 0 } else { node_f2(ret_wrap) }
}

fn check_impl_method_signature(trait_method: i64, impl_method: i64, src: i64, type_ns: i64) -[Conformance, Diagnose]> i64 {
  let impl_inner = fn_inner(impl_method)
  let trait_params = node_f3(trait_method)
  let impl_params = node_f3(impl_inner)
  let ntrait = nlist_len(trait_params)
  let nimpl = nlist_len(impl_params)
  let mut errors = 0
  if nimpl != ntrait {
    typeck_error_maybe(src, type_ns, "type error: impl method arity mismatch")
    errors = errors + 1
  } else {
    for pi in 0..ntrait {
      let trait_param_ty = param_type_or_any(nlist_get(trait_params, pi))
      let impl_param_ty = param_type_or_any(nlist_get(impl_params, pi))
      -- Param 0 is self: its type is the impl target, not whatever the
      -- trait declaration wrote (there is no Self type yet). Skip it.
      if pi == 0 { 0 }
      else { if not is_subtype(trait_param_ty, impl_param_ty) {
        typeck_error_maybe(src, type_ns, "type error: impl method parameter type mismatch")
        errors = errors + 1
      } else { errors = errors } }
    }
  }
  let trait_ret = trait_method_ret_or_any(trait_method)
  let impl_ret = fn_ret_type(impl_method)
  if not is_subtype(impl_ret, trait_ret) {
    typeck_error_maybe(src, type_ns, "type error: impl method return type mismatch")
    errors = errors + 1
  } else { errors = errors }
  let trait_eff = trait_method_effects(trait_method)
  let impl_eff = fn_effects(impl_method)
  if not effect_sig_subset(impl_eff, trait_eff) {
    typeck_error_maybe(src, type_ns, "type error: impl method effect mismatch")
    errors = errors + 1
  } else { errors = errors }
  errors
}

fn trait_has_assoc_type(trait_methods: i64, src: i64, assoc_hash: i64) -> bool {
  let ntrait = nlist_len(trait_methods)
  let mut found = false
  let mut ti = 0
  while ti < ntrait {
    let tm = nlist_get(trait_methods, ti)
    if node_tag(tm) == 42 {
      let tm_hash = effect_name_hash(src, node_f1(tm), node_f2(tm))
      if tm_hash == assoc_hash {
        found = true
        ti = ntrait
      } else { ti = ti + 1 }
    } else { ti = ti + 1 }
  }
  found
}

fn check_impl_assoc_type(trait_member: i64, impl_methods: i64, src: i64, type_ns: i64) -[Diagnose]> i64 {
  let tm_ns = node_f1(trait_member)
  let tm_nl = node_f2(trait_member)
  let tm_hash = effect_name_hash(src, tm_ns, tm_nl)
  let nimpl = if impl_methods == 0 { 0 } else { nlist_len(impl_methods) }
  let mut found = false
  let mut errors = 0
  for ii in 0..nimpl {
    let im = nlist_get(impl_methods, ii)
    if node_tag(im) == 43 {
      let im_hash = effect_name_hash(src, node_f1(im), node_f2(im))
      if im_hash == tm_hash {
        if found {
          typeck_error_maybe(src, type_ns, "type error: duplicate associated type binding")
          errors = errors + 1
        } else {
          found = true
        }
      } else { errors = errors }
    } else { errors = errors }
  }
  if not found {
    typeck_error_maybe(src, type_ns, "type error: impl missing required associated type")
    errors = errors + 1
  } else { errors = errors }
  errors
}

fn check_impl_extra_assoc_types(impl_methods: i64, trait_methods: i64, src: i64, type_ns: i64) -[Diagnose]> i64 {
  let nimpl = if impl_methods == 0 { 0 } else { nlist_len(impl_methods) }
  let mut errors = 0
  for ii in 0..nimpl {
    let im = nlist_get(impl_methods, ii)
    if node_tag(im) == 43 {
      let im_hash = effect_name_hash(src, node_f1(im), node_f2(im))
      if not trait_has_assoc_type(trait_methods, src, im_hash) {
        typeck_error_maybe(src, type_ns, "type error: impl associated type is not declared by trait")
        errors = errors + 1
      } else { errors = errors }
    } else { errors = errors }
  }
  errors
}

fn verify_impl_methods(impl_methods: i64, trait_methods: i64, src: i64, type_ns: i64, trait_hash: i64) -[Conformance, Diagnose]> i64 {
  if trait_methods == 0 { 0 }
  else {
    let mut errors = 0
    -- Check each trait method is present in the impl
    let ntrait = nlist_len(trait_methods)
    let nimpl = if impl_methods == 0 { 0 } else { nlist_len(impl_methods) }
    for ti in 0..ntrait {
      let tm = nlist_get(trait_methods, ti)
      if node_tag(tm) == 39 {
        let tm_ns = node_f1(tm)
        let tm_nl = node_f2(tm)
        let tm_hash = effect_name_hash(src, tm_ns, tm_nl)
        -- Search impl methods for this name
        let mut found = false
        let mut found_method = 0
        let mut ii = 0
        while ii < nimpl {
          let im = nlist_get(impl_methods, ii)
          if node_tag(im) == 23 {
            let im_inner = node_f1(im)
            let im_ns = node_f1(im_inner)
            let im_nl = node_f2(im_inner)
            let im_hash = effect_name_hash(src, im_ns, im_nl)
            if im_hash == tm_hash {
              found = true
              found_method = im
              ii = nimpl
            } else { ii = ii + 1 }
          } else { ii = ii + 1 }
        }
        if not found {
          typeck_error_maybe(src, type_ns, "type error: impl missing required method")
          errors = errors + 1
        } else {
          errors = errors + check_impl_method_signature(tm, found_method, src, type_ns)
        }
      } else {
        if node_tag(tm) == 42 {
          errors = errors + check_impl_assoc_type(tm, impl_methods, src, type_ns)
        } else { errors = errors }
      }
    }
    errors = errors + check_impl_extra_assoc_types(impl_methods, trait_methods, src, type_ns)
    errors
  }
}

fn find_impl_method_by_hash(impl_methods: i64, src: i64, method_hash: i64) -> i64 {
  let nimpl = if impl_methods == 0 { 0 } else { nlist_len(impl_methods) }
  let mut result = 0
  let mut ii = 0
  while ii < nimpl {
    let im = nlist_get(impl_methods, ii)
    if node_tag(im) == 23 {
      let im_inner = node_f1(im)
      let im_hash = effect_name_hash(src, node_f1(im_inner), node_f2(im_inner))
      if im_hash == method_hash {
        result = im
        ii = nimpl
      } else { ii = ii + 1 }
    } else { ii = ii + 1 }
  }
  result
}

fn check_drop_impl_method_shape(impl_method: i64, src: i64, type_ns: i64) -[Conformance, Diagnose]> i64 {
  let impl_inner = fn_inner(impl_method)
  let params = node_f3(impl_inner)
  let nparams = nlist_len(params)
  let mut errors = 0
  if nparams != 1 {
    typeck_error_maybe(src, type_ns, "type error: Drop impl method arity mismatch")
    errors = errors + 1
  } else {
    let self_ty = param_type_or_any(nlist_get(params, 0))
    if not is_subtype(ty_i64(), self_ty) {
      typeck_error_maybe(src, type_ns, "type error: Drop impl method parameter type mismatch")
      errors = errors + 1
    } else { errors = errors }
  }
  let ret_ty = fn_ret_type(impl_method)
  if type_is_i64_like(ret_ty) == 1 or type_is_nil_exact(ret_ty) == 1 {
    errors
  } else {
    typeck_error_maybe(src, type_ns, "type error: Drop impl method return type mismatch")
    errors + 1
  }
}

fn check_drop_impl_methods(impl_methods: i64, src: i64, type_ns: i64, trait_hash: i64) -[Conformance, Diagnose]> i64 {
  if trait_hash != typeck_drop_trait_hash() { 0 }
  else {
    let drop_method = find_impl_method_by_hash(impl_methods, src, typeck_drop_method_hash())
    if drop_method == 0 {
      typeck_error_maybe(src, type_ns, "type error: Drop impl missing concrete drop method")
      1
    } else {
      check_drop_impl_method_shape(drop_method, src, type_ns)
    }
  }
}

fn check_impl_decls(tt: i64, user_src: i64) -[Conformance, Diagnose]> i64 {
  if tt == 0 { 0 }
  else {
    let n = mem_load64_at(tt, 8)
    let d = mem_load64_at(tt, 0)
    let mut errors = 0
    let seen = ctable_new()
    for i in 0..n {
      let kind = mem_load64_at(d, i * 64 + 16)
      let entry_src = mem_load64_at(d, i * 64 + 48)
      if kind == 4 and (user_src == 0 or entry_src == user_src) {
        let type_ns = mem_load64_at(d, i * 64)
        let type_nl = mem_load64_at(d, i * 64 + 8)
        let impl_info = mem_load64_at(d, i * 64 + 40)
        let trait_hash = node_f1(impl_info)
        if trait_hash != 0 {
          let methods = mem_load64_at(d, i * 64 + 32)
          let type_hash = mem_load64_at(d, i * 64 + 56)
          if ctable_conforms(seen, type_hash, trait_hash) == 1 {
            typeck_error_maybe(entry_src, type_ns, "type error: conflicting implementations of trait for type")
            errors = errors + 1
          } else {
            ctable_add_full(seen, type_hash, trait_hash, methods, node_f2(impl_info))
          }
          let trait_methods = lookup_trait_methods(tt, entry_src, trait_hash)
          errors = errors + verify_impl_methods(methods, trait_methods, entry_src, type_ns, trait_hash)
          errors = errors + check_drop_impl_methods(methods, entry_src, type_ns, trait_hash)
        } else { errors = errors }
      } else { errors = errors }
    }
    errors
  }
}

fn build_ctable(tt: i64, src: i64) -> i64 {
  let ct = ctable_new()
  if tt == 0 { ct }
  else {
    let n = mem_load64_at(tt, 8)
    let d = mem_load64_at(tt, 0)
    for i in 0..n {
      let kind = mem_load64_at(d, i * 64 + 16)
      if kind == 4 {
        -- impl block: tparams field (offset 40) stores node(trait_hash, impl_tparams)
        let type_ns = mem_load64_at(d, i * 64)
        let type_nl = mem_load64_at(d, i * 64 + 8)
        let impl_info = mem_load64_at(d, i * 64 + 40)
        let entry_src = mem_load64_at(d, i * 64 + 48)
        let trait_hash = node_f1(impl_info)
        let impl_tparams = node_f2(impl_info)
        let methods = mem_load64_at(d, i * 64 + 32)
        let type_hash = mem_load64_at(d, i * 64 + 56)
        if trait_hash != 0 {
          -- Trait impl: check coherence (no duplicate impls)
          if ctable_conforms(ct, type_hash, trait_hash) == 1 {
            0
          } else {
            ctable_add_full(ct, type_hash, trait_hash, methods, impl_tparams)
          }
        } else { 0 }
      } else { 0 }
    }
    ct
  }
}

fn type_cycle_hash_list_contains(list: i64, hash: i64) -> i64 {
  let mut i = 0
  let mut found = 0
  while i < nlist_len(list) {
    if nlist_get(list, i) == hash {
      found = 1
      i = nlist_len(list)
    } else { i = i + 1 }
  }
  found
}

fn type_cycle_entry_for_hash(tt: i64, type_hash: i64) -> i64 {
  if tt == 0 { 0 }
  else {
    let n = mem_load64_at(tt, 8)
    let d = mem_load64_at(tt, 0)
    let mut i = 0
    let mut result = 0
    while i < n {
      let entry = d + i * 64
      let kind = mem_load64_at(entry, 16)
      if kind == 0 or kind == 1 {
        let entry_src = mem_load64_at(entry, 48)
        let ns = mem_load64_at(entry, 0)
        let nl = mem_load64_at(entry, 8)
        if mem_load64_at(entry, 56) == type_hash {
          result = entry
          i = n
        } else { i = i + 1 }
      } else { i = i + 1 }
    }
    result
  }
}

fn type_cycle_mut_container_vector_hash() -> i64 { 6952878250872 }
fn type_cycle_mut_container_map_hash() -> i64 { 193464163 }
fn type_cycle_mut_container_set_hash() -> i64 { 193470833 }

fn type_cycle_is_mutable_strong_container_hash(type_hash: i64) -> i64 {
  type_hash == type_cycle_mut_container_vector_hash() or
    type_hash == type_cycle_mut_container_map_hash() or
    type_hash == type_cycle_mut_container_set_hash()
}

fn type_cycle_subst_for_entry(entry: i64, type_args: i64) -> i64 {
  if entry == 0 { 0 }
  else {
    let tparams = mem_load64_at(entry, 40)
    if tparams != 0 and type_args != 0 { build_subst(tparams, type_args) } else { 0 }
  }
}

fn type_cycle_maybe_subst(ty: i64, subst: i64) -> i64 {
  if subst != 0 { ty_subst(ty, subst) } else { ty }
}

fn type_cycle_strong_path_type_args(tt: i64, type_args: i64, target_hash: i64, visited: i64) -> bool {
  if type_args == 0 { false }
  else {
    let mut i = 0
    let mut found = false
    while i < nlist_len(type_args) {
      if type_cycle_strong_path_ty(tt, nlist_get(type_args, i), target_hash, visited) == 1 {
        found = true
        i = nlist_len(type_args)
      } else { i = i + 1 }
    }
    found
  }
}

fn type_cycle_strong_path_entry(tt: i64, entry: i64, type_args: i64, target_hash: i64, visited: i64) -> bool {
  if entry == 0 { false }
  else {
    let kind = mem_load64_at(entry, 16)
    let subst = type_cycle_subst_for_entry(entry, type_args)
    let mut found = false
    if kind == 0 {
      let nfields = mem_load64_at(entry, 24)
      let fields = mem_load64_at(entry, 32)
      let mut i = 0
      while i < nfields {
        let raw_ty = mem_load64_at(fields, i * 24 + 16)
        let field_ty = type_cycle_maybe_subst(raw_ty, subst)
        if type_cycle_strong_path_ty(tt, field_ty, target_hash, visited) == 1 {
          found = true
          i = nfields
        } else { i = i + 1 }
      }
    } else { if kind == 1 {
      let nvariants = mem_load64_at(entry, 24)
      let variants = mem_load64_at(entry, 32)
      let mut vi = 0
      while vi < nvariants {
        let npayloads = mem_load64_at(variants, vi * 40 + 24)
        let payloads = mem_load64_at(variants, vi * 40 + 32)
        let mut pi = 0
        while pi < npayloads {
          let raw_ty = nlist_get(payloads, pi)
          let payload_ty = type_cycle_maybe_subst(raw_ty, subst)
          if type_cycle_strong_path_ty(tt, payload_ty, target_hash, visited) == 1 {
            found = true
            pi = npayloads
            vi = nvariants
          } else { pi = pi + 1 }
        }
        if vi < nvariants { vi = vi + 1 } else { vi = vi }
      }
    } else { found = false } }
    found
  }
}

fn type_cycle_strong_path_hash(tt: i64, current_hash: i64, type_args: i64, target_hash: i64, visited: i64) -> bool {
  if current_hash == target_hash { true }
  else { if type_cycle_hash_list_contains(visited, current_hash) == 1 { false }
  else {
    nlist_add(visited, current_hash)
    type_cycle_strong_path_entry(tt, type_cycle_entry_for_hash(tt, current_hash), type_args, target_hash, visited)
  } }
}

fn type_cycle_strong_path_ty(tt: i64, ty: i64, target_hash: i64, visited: i64) -> bool {
  if ty == 0 { false }
  else {
    match ty_tag(ty) {
      3 -> type_cycle_strong_path_ty(tt, ty_f1(ty), target_hash, visited) or type_cycle_strong_path_ty(tt, ty_f2(ty), target_hash, visited)
      4 -> type_cycle_strong_path_ty(tt, ty_f1(ty), target_hash, visited) or type_cycle_strong_path_ty(tt, ty_f2(ty), target_hash, visited)
      5 -> type_cycle_strong_path_ty(tt, ty_f1(ty), target_hash, visited)
      8 -> type_cycle_strong_path_ty(tt, ty_f2(ty), target_hash, visited)
      9 -> {
        if ty_is_rc(ty) == 1 {
          type_cycle_strong_path_ty(tt, ty_rc_inner(ty), target_hash, visited)
        } else {
          let type_hash = ty_f1(ty)
          if type_cycle_is_mutable_strong_container_hash(type_hash) == 1 {
            type_cycle_strong_path_type_args(tt, ty_f3(ty), target_hash, visited)
          } else {
            type_cycle_strong_path_hash(tt, type_hash, ty_f3(ty), target_hash, visited)
          }
        }
      }
      16 -> false
      17 -> type_cycle_strong_path_ty(tt, ty_arc_inner(ty), target_hash, visited)
      18 -> type_cycle_strong_path_ty(tt, ty_unique_inner(ty), target_hash, visited)
      19 -> type_cycle_strong_path_ty(tt, ty_owned_inner(ty), target_hash, visited)
      _ -> false
    }
  }
}

fn type_cycle_hidden_capture_type_args(tt: i64, type_args: i64, visited: i64) -> bool {
  if type_args == 0 { false }
  else {
    let mut i = 0
    let mut found = false
    while i < nlist_len(type_args) {
      if type_cycle_hidden_capture_ty(tt, nlist_get(type_args, i), visited) == 1 {
        found = true
        i = nlist_len(type_args)
      } else { i = i + 1 }
    }
    found
  }
}

fn type_cycle_hidden_capture_entry(tt: i64, entry: i64, type_args: i64, visited: i64) -> bool {
  if entry == 0 { false }
  else {
    let kind = mem_load64_at(entry, 16)
    let subst = type_cycle_subst_for_entry(entry, type_args)
    let mut found = false
    if kind == 0 {
      let nfields = mem_load64_at(entry, 24)
      let fields = mem_load64_at(entry, 32)
      let mut i = 0
      while i < nfields {
        let raw_ty = mem_load64_at(fields, i * 24 + 16)
        let field_ty = type_cycle_maybe_subst(raw_ty, subst)
        if type_cycle_hidden_capture_ty(tt, field_ty, visited) == 1 {
          found = true
          i = nfields
        } else { i = i + 1 }
      }
    } else { if kind == 1 {
      let nvariants = mem_load64_at(entry, 24)
      let variants = mem_load64_at(entry, 32)
      let mut vi = 0
      while vi < nvariants {
        let npayloads = mem_load64_at(variants, vi * 40 + 24)
        let payloads = mem_load64_at(variants, vi * 40 + 32)
        let mut pi = 0
        while pi < npayloads {
          let raw_ty = nlist_get(payloads, pi)
          let payload_ty = type_cycle_maybe_subst(raw_ty, subst)
          if type_cycle_hidden_capture_ty(tt, payload_ty, visited) == 1 {
            found = true
            pi = npayloads
            vi = nvariants
          } else { pi = pi + 1 }
        }
        if vi < nvariants { vi = vi + 1 } else { vi = vi }
      }
    } else { found = false } }
    found
  }
}

fn type_cycle_hidden_capture_hash(tt: i64, type_hash: i64, type_args: i64, visited: i64) -> bool {
  if type_cycle_hash_list_contains(visited, type_hash) == 1 { false }
  else {
    nlist_add(visited, type_hash)
    type_cycle_hidden_capture_entry(tt, type_cycle_entry_for_hash(tt, type_hash), type_args, visited)
  }
}

fn type_cycle_hidden_capture_ty(tt: i64, ty: i64, visited: i64) -> bool {
  if ty == 0 { false }
  else {
    match ty_tag(ty) {
      3 -> type_cycle_hidden_capture_ty(tt, ty_f1(ty), visited) or type_cycle_hidden_capture_ty(tt, ty_f2(ty), visited)
      4 -> type_cycle_hidden_capture_ty(tt, ty_f1(ty), visited) or type_cycle_hidden_capture_ty(tt, ty_f2(ty), visited)
      5 -> type_cycle_hidden_capture_ty(tt, ty_f1(ty), visited)
      6 -> true
      8 -> type_cycle_hidden_capture_ty(tt, ty_f2(ty), visited)
      9 -> {
        if ty_is_rc(ty) == 1 {
          type_cycle_hidden_capture_ty(tt, ty_rc_inner(ty), visited)
        } else {
          let type_hash = ty_f1(ty)
          if type_cycle_is_mutable_strong_container_hash(type_hash) == 1 {
            type_cycle_hidden_capture_type_args(tt, ty_f3(ty), visited)
          } else {
            type_cycle_hidden_capture_hash(tt, type_hash, ty_f3(ty), visited)
          }
        }
      }
      14 -> true
      16 -> false
      17 -> type_cycle_hidden_capture_ty(tt, ty_arc_inner(ty), visited)
      18 -> type_cycle_hidden_capture_ty(tt, ty_unique_inner(ty), visited)
      19 -> type_cycle_hidden_capture_ty(tt, ty_owned_inner(ty), visited)
      _ -> false
    }
  }
}

fn check_type_cycle_hidden_capture_container(tt: i64, src: i64, diag_pos: i64, type_args: i64) -[Diagnose]> i64 {
  if type_cycle_hidden_capture_type_args(tt, type_args, nlist_new()) == 1 {
    typeck_error_maybe(src, diag_pos, "type error: closure capture cycle requires weak or id edge")
    1
  } else { 0 }
}

fn check_type_cycle_target(tt: i64, src: i64, diag_pos: i64, owner_hash: i64, target_hash: i64, type_args: i64, cycle_forming: i64) -[Diagnose]> i64 {
  if cycle_forming != 1 { 0 }
  else {
    if type_cycle_strong_path_hash(tt, target_hash, type_args, owner_hash, nlist_new()) == 1 {
      typeck_error_maybe(src, diag_pos, "type error: strong ownership cycle requires weak or id edge")
      1
    } else { 0 }
  }
}

fn check_type_cycle_ty(tt: i64, src: i64, diag_pos: i64, owner_hash: i64, ty: i64, cycle_forming: i64) -[Diagnose]> i64 {
  if ty == 0 { 0 }
  else {
    match ty_tag(ty) {
      3 -> check_type_cycle_ty(tt, src, diag_pos, owner_hash, ty_f1(ty), cycle_forming) + check_type_cycle_ty(tt, src, diag_pos, owner_hash, ty_f2(ty), cycle_forming)
      4 -> check_type_cycle_ty(tt, src, diag_pos, owner_hash, ty_f1(ty), cycle_forming) + check_type_cycle_ty(tt, src, diag_pos, owner_hash, ty_f2(ty), cycle_forming)
      5 -> check_type_cycle_ty(tt, src, diag_pos, owner_hash, ty_f1(ty), cycle_forming)
      8 -> check_type_cycle_ty(tt, src, diag_pos, owner_hash, ty_f2(ty), cycle_forming)
      9 -> {
        if ty_is_rc(ty) == 1 {
          check_type_cycle_ty(tt, src, diag_pos, owner_hash, ty_rc_inner(ty), cycle_forming)
        } else {
          let type_hash = ty_f1(ty)
          if type_cycle_is_mutable_strong_container_hash(type_hash) == 1 {
            check_type_cycle_hidden_capture_container(tt, src, diag_pos, ty_f3(ty)) +
              check_type_cycle_type_args(tt, src, diag_pos, owner_hash, ty_f3(ty), 1)
          } else {
            check_type_cycle_target(tt, src, diag_pos, owner_hash, type_hash, ty_f3(ty), cycle_forming)
          }
        }
      }
      16 -> 0
      17 -> check_type_cycle_ty(tt, src, diag_pos, owner_hash, ty_arc_inner(ty), cycle_forming)
      18 -> check_type_cycle_ty(tt, src, diag_pos, owner_hash, ty_unique_inner(ty), cycle_forming)
      19 -> check_type_cycle_ty(tt, src, diag_pos, owner_hash, ty_owned_inner(ty), cycle_forming)
      _ -> 0
    }
  }
}

fn check_type_cycle_type_args(tt: i64, src: i64, diag_pos: i64, owner_hash: i64, type_args: i64, cycle_forming: i64) -[Diagnose]> i64 {
  if type_args == 0 { 0 }
  else {
    let mut errors = 0
    let n = nlist_len(type_args)
    for i in 0..n {
      errors = errors + check_type_cycle_ty(tt, src, diag_pos, owner_hash, nlist_get(type_args, i), cycle_forming)
    }
    errors
  }
}

fn check_public_arc_type_list_inner(src: i64, diag_pos: i64, types: i64) -[Diagnose]> i64 {
  if types == 0 { 0 }
  else {
    let mut errors = 0
    let n = nlist_len(types)
    for i in 0..n {
      errors = errors + check_public_arc_ty_inner(src, diag_pos, nlist_get(types, i))
    }
    errors
  }
}

fn check_public_arc_effect_list_inner(src: i64, diag_pos: i64, effects: i64) -[Diagnose]> i64 {
  if effects == 0 { 0 }
  else {
    let mut errors = 0
    let n = nlist_len(effects)
    for i in 0..n {
      errors = errors + check_public_arc_ty_inner(src, diag_pos, nlist_get(effects, i))
    }
    errors
  }
}

fn check_public_arc_ty_inner(src: i64, diag_pos: i64, ty: i64) -[Diagnose]> i64 {
  if ty == 0 { 0 }
  else {
    match ty_tag(ty) {
      3 -> check_public_arc_ty_inner(src, diag_pos, ty_f1(ty)) + check_public_arc_ty_inner(src, diag_pos, ty_f2(ty))
      4 -> check_public_arc_ty_inner(src, diag_pos, ty_f1(ty)) + check_public_arc_ty_inner(src, diag_pos, ty_f2(ty))
      5 -> check_public_arc_ty_inner(src, diag_pos, ty_f1(ty))
      6 -> check_public_arc_type_list_inner(src, diag_pos, ty_f1(ty)) + check_public_arc_ty_inner(src, diag_pos, ty_f2(ty)) + check_public_arc_ty_inner(src, diag_pos, ty_f3(ty))
      8 -> check_public_arc_ty_inner(src, diag_pos, ty_f2(ty))
      9 -> check_public_arc_ty_inner(src, diag_pos, ty_f2(ty)) + check_public_arc_type_list_inner(src, diag_pos, ty_f3(ty))
      10 -> check_public_arc_effect_list_inner(src, diag_pos, ty_f1(ty))
      11 -> check_public_arc_type_list_inner(src, diag_pos, ty_f2(ty))
      14 -> check_public_arc_ty_inner(src, diag_pos, ty_f1(ty)) + check_public_arc_ty_inner(src, diag_pos, ty_f2(ty))
      15 -> check_public_arc_ty_inner(src, diag_pos, ty_f1(ty))
      16 -> check_public_arc_ty_inner(src, diag_pos, ty_f1(ty))
      17 -> {
        typeck_error_maybe(src, diag_pos, "type error: arc is not public syntax")
        1
      }
      18 -> check_public_arc_ty_inner(src, diag_pos, ty_f1(ty))
      19 -> check_public_arc_ty_inner(src, diag_pos, ty_f1(ty))
      _ -> 0
    }
  }
}

fn check_public_arc_ty(tt: i64, src: i64, diag_pos: i64, ty: i64) -[Diagnose]> i64 {
  if ttable_source_is_trusted(tt, src) == 1 { 0 }
  else { check_public_arc_ty_inner(src, diag_pos, ty) }
}

fn check_public_arc_type_list(tt: i64, src: i64, diag_pos: i64, types: i64) -[Diagnose]> i64 {
  if ttable_source_is_trusted(tt, src) == 1 { 0 }
  else { check_public_arc_type_list_inner(src, diag_pos, types) }
}

fn check_public_arc_params(tt: i64, src: i64, params: i64) -[Diagnose]> i64 {
  if ttable_source_is_trusted(tt, src) == 1 { 0 }
  else {
    let mut errors = 0
    let n = nlist_len(params)
    for i in 0..n {
      let p = nlist_get(params, i)
      errors = errors + check_public_arc_ty_inner(src, node_f1(p), node_f3(p))
    }
    errors
  }
}

fn check_move_only_storage_type_list_with(src: i64, diag_pos: i64, types: i64, allow_root: i64) -[Diagnose]> i64 {
  if types == 0 { 0 }
  else {
    let mut errors = 0
    let n = nlist_len(types)
    for i in 0..n {
      errors = errors + check_move_only_storage_ty_inner(src, diag_pos, nlist_get(types, i), allow_root)
    }
    errors
  }
}

fn check_move_only_storage_type_list_inner(src: i64, diag_pos: i64, types: i64) -[Diagnose]> i64 {
  check_move_only_storage_type_list_with(src, diag_pos, types, 1)
}

fn check_move_only_storage_ty_inner(src: i64, diag_pos: i64, ty: i64, allow_root: i64) -[Diagnose]> i64 {
  if ty == 0 { 0 }
  else {
    match ty_tag(ty) {
      3 -> check_move_only_storage_ty_inner(src, diag_pos, ty_f1(ty), 0) + check_move_only_storage_ty_inner(src, diag_pos, ty_f2(ty), 0)
      4 -> check_move_only_storage_ty_inner(src, diag_pos, ty_f1(ty), 0) + check_move_only_storage_ty_inner(src, diag_pos, ty_f2(ty), 0)
      5 -> check_move_only_storage_ty_inner(src, diag_pos, ty_f1(ty), 0)
      -- Function types mention owned/unique at their call boundary; the
      -- function value itself does not store that argument or result.
      6 -> 0
      8 -> check_move_only_storage_ty_inner(src, diag_pos, ty_f2(ty), 0)
      9 -> check_move_only_storage_type_list_with(src, diag_pos, ty_f3(ty), 0)
      14 -> 0
      16 -> check_move_only_storage_ty_inner(src, diag_pos, ty_f1(ty), 0)
      18 -> {
        if allow_root == 1 { check_move_only_storage_ty_inner(src, diag_pos, ty_f1(ty), 0) }
        else {
          typeck_error_maybe(src, diag_pos, "type error: move-only type cannot be nested in copyable storage")
          1
        }
      }
      19 -> {
        if allow_root == 1 { check_move_only_storage_ty_inner(src, diag_pos, ty_f1(ty), 0) }
        else {
          typeck_error_maybe(src, diag_pos, "type error: move-only type cannot be nested in copyable storage")
          1
        }
      }
      _ -> 0
    }
  }
}

fn check_move_only_storage_ty(src: i64, diag_pos: i64, ty: i64) -[Diagnose]> i64 {
  check_move_only_storage_ty_inner(src, diag_pos, ty, 1)
}

fn check_move_only_storage_field_ty(src: i64, diag_pos: i64, ty: i64) -[Diagnose]> i64 {
  check_move_only_storage_ty_inner(src, diag_pos, ty, 0)
}

fn check_move_only_storage_type_list(src: i64, diag_pos: i64, types: i64) -[Diagnose]> i64 {
  check_move_only_storage_type_list_inner(src, diag_pos, types)
}

fn check_move_only_storage_params(src: i64, params: i64) -[Diagnose]> i64 {
  let mut errors = 0
  let n = nlist_len(params)
  for i in 0..n {
    let p = nlist_get(params, i)
    errors = errors + check_move_only_storage_ty(src, node_f1(p), node_f3(p))
  }
  errors
}

fn check_type_cycles_entry(tt: i64, entry: i64) -[Diagnose]> i64 {
  let kind = mem_load64_at(entry, 16)
  let src = mem_load64_at(entry, 48)
  let type_ns = mem_load64_at(entry, 0)
  let type_nl = mem_load64_at(entry, 8)
  let owner_hash = type_name_hash(src, type_ns, type_nl)
  let mut errors = 0
  if kind == 0 {
    let nfields = mem_load64_at(entry, 24)
    let fields = mem_load64_at(entry, 32)
    for i in 0..nfields {
      let field_ty = mem_load64_at(fields, i * 24 + 16)
      errors = errors + check_public_arc_ty(tt, src, type_ns, field_ty)
      errors = errors + check_move_only_storage_field_ty(src, type_ns, field_ty)
      errors = errors + check_type_cycle_ty(tt, src, type_ns, owner_hash, field_ty, 0)
    }
  } else { if kind == 1 {
    let nvariants = mem_load64_at(entry, 24)
    let variants = mem_load64_at(entry, 32)
    for vi in 0..nvariants {
      let npayloads = mem_load64_at(variants, vi * 40 + 24)
      let payloads = mem_load64_at(variants, vi * 40 + 32)
      for pi in 0..npayloads {
        let payload_ty = nlist_get(payloads, pi)
        errors = errors + check_public_arc_ty(tt, src, type_ns, payload_ty)
        errors = errors + check_move_only_storage_field_ty(src, type_ns, payload_ty)
        errors = errors + check_type_cycle_ty(tt, src, type_ns, owner_hash, payload_ty, 0)
      }
    }
  } else { errors = errors } }
  errors
}

fn check_type_cycles(tt: i64, user_src: i64) -[Diagnose]> i64 {
  if tt == 0 { 0 }
  else {
    let n = mem_load64_at(tt, 8)
    let d = mem_load64_at(tt, 0)
    let mut errors = 0
    for i in 0..n {
      let entry = d + i * 64
      let kind = mem_load64_at(entry, 16)
      let entry_src = mem_load64_at(entry, 48)
      if (kind == 0 or kind == 1) and (user_src == 0 or entry_src == user_src) {
        errors = errors + check_type_cycles_entry(tt, entry)
      } else { errors = errors }
    }
    errors
  }
}

-- The compact rc header has 32 release-mask bits: two bits for each of
-- payload words 0..15. Records start at word 0; variants reserve word 0
-- for their tag. Wider all-unmanaged aggregates remain valid, but a
-- definitely- or potentially-managed field outside that window would
-- otherwise release shallow. Reject that layout while it is still a
-- source-level type fact.
fn check_aggregate_release_mask_capacity_entry(entry: i64) -[Diagnose]> i64 {
  let kind = mem_load64_at(entry, 16)
  let src = mem_load64_at(entry, 48)
  let type_ns = mem_load64_at(entry, 0)
  let mut overflow = 0
  if kind == 0 {
    let nfields = mem_load64_at(entry, 24)
    let fields = mem_load64_at(entry, 32)
    let mut i = 16
    while i < nfields and overflow == 0 {
      let field_ty = mem_load64_at(fields, i * 24 + 16)
      if ty_field_may_require_release_mask(field_ty) == 1 { overflow = 1 } else { i = i + 1 }
    }
  } else { if kind == 1 {
    let nvariants = mem_load64_at(entry, 24)
    let variants = mem_load64_at(entry, 32)
    let mut vi = 0
    while vi < nvariants and overflow == 0 {
      let npayloads = mem_load64_at(variants, vi * 40 + 24)
      let payloads = mem_load64_at(variants, vi * 40 + 32)
      let mut pi = 15
      while pi < npayloads and overflow == 0 {
        if ty_field_may_require_release_mask(nlist_get(payloads, pi)) == 1 { overflow = 1 } else { pi = pi + 1 }
      }
      vi = vi + 1
    }
  } else { 0 } }
  if overflow == 1 {
    typeck_error_maybe(src, type_ns, "type error: aggregate field may require release beyond 16-word mask")
    1
  } else { 0 }
}

fn check_aggregate_release_mask_capacity(tt: i64, user_src: i64) -[Diagnose]> i64 {
  if tt == 0 { 0 }
  else {
    let n = mem_load64_at(tt, 8)
    let d = mem_load64_at(tt, 0)
    let mut errors = 0
    for i in 0..n {
      let entry = d + i * 64
      let kind = mem_load64_at(entry, 16)
      let entry_src = mem_load64_at(entry, 48)
      if (kind == 0 or kind == 1) and (user_src == 0 or entry_src == user_src) {
        errors = errors + check_aggregate_release_mask_capacity_entry(entry)
      } else { 0 }
    }
    errors
  }
}

-- ══════════════════════════════════════════════════════════════
-- Trait bound checking at generic call sites
-- ══════════════════════════════════════════════════════════════

-- Check that each concrete type arg satisfies its declared trait bound.
-- tparams: list of node_new(2, ns, nl, var_id, bound)
-- type_args: list of concrete type nodes
-- Returns number of errors.
fn check_trait_bounds(tparams: i64, type_args: i64, src: i64, call_ns: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let n = nlist_len(tparams)
  let mut errors = 0
  for i in 0..n {
    let tp = nlist_get(tparams, i)
    let bounds = node_f4(tp)
    if bounds != 0 {
      -- bounds is an nlist of trait hashes
      if i < nlist_len(type_args) {
        let type_arg = nlist_get(type_args, i)
        let concrete_hash = type_hash_of(type_arg)
        -- Check each bound in the list
        let nbounds = nlist_len(bounds)
        for bi in 0..nbounds {
          let trait_hash = nlist_get(bounds, bi)
          if Conformance.conforms(concrete_hash, trait_hash) == 0 {
            typeck_error_maybe(src, call_ns, "type error: type does not satisfy trait bound")
            errors = errors + 1
          } else { errors = errors }
        }
      } else { errors = errors }
    } else { errors = errors }
  }
  errors
}

-- Get the type_hash of a concrete type (for conformance checking)
-- Matches the convention in type_name_hash: prims are negative, named are hashes
fn type_hash_of(ty: i64) -> i64 {
  let tag = ty_tag(ty)
  if tag == 2 { 0 - ty_f1(ty) - 1 }
  else { if tag == 9 { ty_f1(ty) }
  else { 0 } }
}

fn type_is_unknown_or_any(ty: i64) -> bool {
  if ty == 0 { true }
  else { ty_tag(ty) == 1 }
}

fn type_is_nil_exact(ty: i64) -> i64 {
  if type_is_unknown_or_any(ty) { false }
  else { ty_tag(ty) == 2 and ty_f1(ty) == PRIM_NIL() }
}

fn type_allows_nil(ty: i64) -[Conformance]> i64 {
  if type_is_unknown_or_any(ty) { false }
  else { is_subtype(ty_nil(), ty) }
}

fn type_union_with_nil_subtype_of(ty: i64, inner: i64) -[Conformance]> bool {
  if type_is_unknown_or_any(ty) { false }
  else { if type_is_unknown_or_any(inner) { false }
  else { if ty_tag(ty) != 3 { false }
  else {
    let lhs = ty_f1(ty)
    let rhs = ty_f2(ty)
    if type_is_nil_exact(lhs) == 1 { is_subtype(rhs, inner) }
    else { if type_is_nil_exact(rhs) == 1 { is_subtype(lhs, inner) }
    else { false } }
  } } }
}

fn type_nullable_equality_compatible(lhs_ty: i64, rhs_ty: i64) -[Conformance]> i64 {
  if type_is_nil_exact(lhs_ty) == 1 { type_allows_nil(rhs_ty) }
  else { if type_is_nil_exact(rhs_ty) == 1 { type_allows_nil(lhs_ty) }
  else { if type_union_with_nil_subtype_of(lhs_ty, rhs_ty) == 1 and is_subtype(rhs_ty, lhs_ty) { true }
  else { type_union_with_nil_subtype_of(rhs_ty, lhs_ty) == 1 and is_subtype(lhs_ty, rhs_ty) } } }
}

fn type_is_i64_like(ty: i64) -[Conformance]> i64 {
  if type_is_unknown_or_any(ty) { false }
  else { is_subtype(ty, ty_i64()) }
}

fn type_is_f64_exact(ty: i64) -> bool {
  if type_is_unknown_or_any(ty) { false }
  else { ty_tag(ty) == 2 and ty_f1(ty) == PRIM_F64() }
}

fn type_is_f32_exact(ty: i64) -> bool {
  if type_is_unknown_or_any(ty) { false }
  else { ty_tag(ty) == 2 and ty_f1(ty) == PRIM_F32() }
}

fn type_is_float_exact(ty: i64) -> i64 {
  type_is_f64_exact(ty) == 1 or type_is_f32_exact(ty) == 1
}

fn prim_is_integer(prim: i64) -> i64 {
  prim == PRIM_I64() or prim == PRIM_I32() or prim == PRIM_I8() or prim == PRIM_I16() or prim == PRIM_U8() or prim == PRIM_U16() or prim == PRIM_U32() or prim == PRIM_U64() or prim == PRIM_ISIZE() or prim == PRIM_USIZE()
}

fn prim_is_unsigned_integer(prim: i64) -> i64 {
  prim == PRIM_U8() or prim == PRIM_U16() or prim == PRIM_U32() or prim == PRIM_U64() or prim == PRIM_USIZE()
}

fn type_int_prim(ty: i64) -> i64 {
  if type_is_unknown_or_any(ty) { 0 - 1 }
  else { if ty_tag(ty) != 2 { 0 - 1 }
  else {
    let prim = ty_f1(ty)
    if prim_is_integer(prim) == 1 { prim } else { 0 - 1 }
  } }
}

fn type_is_integer_exact(ty: i64) -> i64 {
  type_int_prim(ty) >= 0
}

fn type_is_unsigned_integer_exact(ty: i64) -> i64 {
  let prim = type_int_prim(ty)
  if prim < 0 { 0 } else { prim_is_unsigned_integer(prim) }
}

fn type_is_numeric(ty: i64) -> bool {
  type_is_integer_exact(ty) == 1 or type_is_float_exact(ty) == 1
}

fn expr_is_zero_i64_lit(node: i64) -> bool {
  if node_tag(node) == 1 { node_f1(node) == 0 } else { false }
}

fn int_prim_positive_max(prim: i64) -> i64 {
  if prim == PRIM_I8() { 127 }
  else { if prim == PRIM_I16() { 32767 }
  else { if prim == PRIM_I32() { 2147483647 }
  else { if prim == PRIM_U8() { 255 }
  else { if prim == PRIM_U16() { 65535 }
  else { if prim == PRIM_U32() { 4294967295 }
  else { if prim == PRIM_U64() { 9223372036854775807 }
  else { if prim == PRIM_ISIZE() { 9223372036854775807 }
  else { if prim == PRIM_USIZE() { 9223372036854775807 }
  else { 9223372036854775807 } } } } } } } } }
}

fn int_prim_positive_max_str(prim: i64) -> str {
  if prim == PRIM_I8() { "127" }
  else { if prim == PRIM_I16() { "32767" }
  else { if prim == PRIM_I32() { "2147483647" }
  else { if prim == PRIM_U8() { "255" }
  else { if prim == PRIM_U16() { "65535" }
  else { if prim == PRIM_U32() { "4294967295" }
  else { if prim == PRIM_U64() { "18446744073709551615" }
  else { if prim == PRIM_ISIZE() { "9223372036854775807" }
  else { if prim == PRIM_USIZE() { "18446744073709551615" }
  else { "9223372036854775807" } } } } } } } } }
}

fn int_prim_negative_magnitude_max(prim: i64) -> i64 {
  if prim == PRIM_I8() { 128 }
  else { if prim == PRIM_I16() { 32768 }
  else { if prim == PRIM_I32() { 2147483648 }
  else { if prim == PRIM_ISIZE() { 9223372036854775807 }
  else { 9223372036854775807 } } } }
}

fn int_prim_negative_magnitude_max_str(prim: i64) -> str {
  if prim == PRIM_I8() { "128" }
  else { if prim == PRIM_I16() { "32768" }
  else { if prim == PRIM_I32() { "2147483648" }
  else { if prim == PRIM_ISIZE() { "9223372036854775808" }
  else { "9223372036854775808" } } } }
}

fn int_literal_has_span(node: i64) -> i64 {
  node != 0 and node_f3(node) > 0
}

fn int_literal_positive_fits_prim(node: i64, prim: i64, src: i64) -> i64 {
  if int_literal_has_span(node) == 1 {
    decimal_span_le_str(src, node_f2(node), node_f3(node), int_prim_positive_max_str(prim))
  } else {
    let value = node_f1(node)
    if value >= 0 and value <= int_prim_positive_max(prim) { 1 } else { 0 }
  }
}

fn int_literal_negative_magnitude_fits_prim(node: i64, prim: i64, src: i64) -> i64 {
  if prim_is_unsigned_integer(prim) == 1 { 0 }
  else { if int_literal_has_span(node) == 1 {
    decimal_span_le_str(src, node_f2(node), node_f3(node), int_prim_negative_magnitude_max_str(prim))
  } else {
    let mag = node_f1(node)
    if mag >= 0 and mag <= int_prim_negative_magnitude_max(prim) { 1 } else { 0 }
  } }
}

fn expr_is_contextual_int_lit_for_prim(node: i64, prim: i64, src: i64) -> i64 {
  if node == 0 { 0 }
  else {
    let tag = node_tag(node)
    if tag == 1 {
      int_literal_positive_fits_prim(node, prim, src)
    } else { if tag == 3 and node_f1(node) == 2 and expr_is_zero_i64_lit(node_f2(node)) == 1 and node_tag(node_f3(node)) == 1 {
      int_literal_negative_magnitude_fits_prim(node_f3(node), prim, src)
    } else { 0 } }
  }
}

fn expr_is_contextual_int_lit_shape(node: i64) -> i64 {
  if node == 0 { 0 }
  else {
    let tag = node_tag(node)
    if tag == 1 { 1 }
    else { if tag == 3 and node_f1(node) == 2 and expr_is_zero_i64_lit(node_f2(node)) == 1 and node_tag(node_f3(node)) == 1 { 1 }
    else { 0 } }
  }
}

fn expr_matches_int_prim_contextual(node: i64, node_ty: i64, prim: i64, src: i64) -> i64 {
  if expr_is_contextual_int_lit_shape(node) == 1 { expr_is_contextual_int_lit_for_prim(node, prim, src) }
  else { if type_int_prim(node_ty) == prim { 1 }
  else { expr_is_contextual_int_lit_for_prim(node, prim, src) }
  }
}

fn expr_contextual_int_lit_matches_type(node: i64, target_ty: i64, src: i64) -> i64 {
  let prim = type_int_prim(target_ty)
  if prim >= 0 { expr_is_contextual_int_lit_for_prim(node, prim, src) } else { 0 }
}

fn expr_is_contextual_f32_literal_tree(node: i64) -> i64 {
  if node == 0 { 0 }
  else {
    match node_tag(node) {
      54 -> 1
      3 -> {
        let op = node_f1(node)
        if op >= 1 and op <= 4 {
          if op == 2 and expr_is_zero_i64_lit(node_f2(node)) == 1 {
            expr_is_contextual_f32_literal_tree(node_f3(node))
          } else {
            expr_is_contextual_f32_literal_tree(node_f2(node)) == 1 and expr_is_contextual_f32_literal_tree(node_f3(node)) == 1
          }
        } else { 0 }
      }
      5 -> expr_is_contextual_f32_literal_tree(node_f2(node)) == 1 and expr_is_contextual_f32_literal_tree(node_f3(node)) == 1
      7 -> expr_is_contextual_f32_literal_tree(node_f2(node))
      _ -> 0
    }
  }
}

fn expr_matches_f32_contextual(node: i64, node_ty: i64) -> i64 {
  if type_is_f32_exact(node_ty) == 1 { 1 }
  else { expr_is_contextual_f32_literal_tree(node) }
}

-- Literal 0/1 in a bool-expected position: the singletons {0} and {1}
-- ARE false and true in the value model, so the literals check as bool.
fn expr_is_bool_int_literal(node: i64, src: i64) -> i64 {
  if node_tag(node) != 1 { 0 }
  else { if int_literal_has_span(node) == 1 {
    if node_f3(node) == 1 {
      let ch = mem_load8_at(src, node_f2(node))
      if ch == 48 or ch == 49 { 1 } else { 0 }
    } else { 0 }
  } else {
    if node_f1(node) == 0 or node_f1(node) == 1 { 1 } else { 0 }
  } }
}

fn type_is_bool_exact(ty: i64) -> i64 {
  if ty == 0 { 0 }
  else { if ty_tag(ty) != 2 { 0 } else { ty_f1(ty) == PRIM_BOOL() } }
}

fn expr_matches_type_contextual(node: i64, node_ty: i64, target_ty: i64, src: i64) -[Conformance]> i64 {
  if expr_is_contextual_int_lit_shape(node) == 1 and type_int_prim(target_ty) >= 0 {
    expr_contextual_int_lit_matches_type(node, target_ty, src)
  } else { if ty_is_unique(target_ty) == 1 {
    expr_matches_type_contextual(node, node_ty, ty_unique_inner(target_ty), src)
  } else { if ty_is_owned(target_ty) == 1 {
    expr_matches_type_contextual(node, node_ty, ty_owned_inner(target_ty), src)
  } else { if is_subtype(node_ty, target_ty) { 1 }
  else { if expr_contextual_int_lit_matches_type(node, target_ty, src) == 1 { 1 }
  else { if type_is_f32_exact(target_ty) == 1 { expr_is_contextual_f32_literal_tree(node) }
  else { if type_is_bool_exact(target_ty) == 1 { expr_is_bool_int_literal(node, src) }
  else { 0 } } } } } } }
}

-- ══════════════════════════════════════════════════════════════
-- Type synthesis: infer the type of an expression
-- ══════════════════════════════════════════════════════════════
-- Returns a type pointer (ty_i64(), ty_str(), etc.) or 0 for unknown

-- ══════════════════════════════════════════════════════════════
-- Guard narrowing (2n): `x != nil` and `x == nil` guards refine the
-- guarded ident's type in positions the short-circuit contract
-- (kernel.md §5.3.1) proves conditionally executed:
--   if x != nil { <x: T> } else { ... }
--   if x == nil { ... } else { <x: T> }
--   x != nil and <x: T>
--   x == nil or <x: T>
-- Only the NON-nil direction is bound (T <: T | nil, so narrowing can
-- only accept more programs, never reject working code), and only for
-- immutable bindings (assignment would invalidate the refinement).
-- ══════════════════════════════════════════════════════════════

-- The guarded ident node when cond is `x <op> nil` / `nil <op> x` with
-- the wanted comparison op (5 = ==, 6 = !=); 0 otherwise.
fn guard_nil_ident(cond: i64, want_op: i64) -> i64 {
  if node_tag(cond) != 3 { 0 }
  else { if node_f1(cond) != want_op { 0 }
  else {
    let lhs = node_f2(cond)
    let rhs = node_f3(cond)
    if node_tag(lhs) == 51 and node_tag(rhs) == 2 { rhs }
    else { if node_tag(rhs) == 51 and node_tag(lhs) == 2 { lhs } else { 0 } }
  } }
}

-- Env for the branch where the guard proves the ident non-nil: shadow
-- the binding with its nil-free type. Unchanged env when the guard
-- shape does not apply, the binding is mutable, or nil-free narrowing
-- would not change the type.
fn tenv_narrow_guard(env: i64, cond: i64, want_op: i64, src: i64) -> i64 {
  let ident = guard_nil_ident(cond, want_op)
  if ident == 0 { env }
  else {
    let ns = node_f1(ident)
    let nl = node_f2(ident)
    if tenv_lookup_mutable(env, src, ns, nl) == 1 { env }
    else {
      let ty = tenv_lookup(env, src, ns, nl)
      if ty == 0 { env }
      else {
        let narrowed = ty_narrow_drop_nil(ty)
        if narrowed == 0 { env } else { tenv_bind(env, src, ns, nl, narrowed) }
      }
    }
  }
}

fn synth(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let tag = node_tag(node)
  match tag {
    -- IntLit → i64
    1 -> ty_i64()
    -- Ident → lookup in environment or function table
    2 -> synth_ident(node, env, ft, src, tt)
    -- BinOp → depends on operator
    3 -> synth_binop(node, env, ft, src, tt)
    -- Call → return type of function
    4 -> synth_call(node, env, ft, src, tt)
    -- If/else → unify branches
    5 -> synth_if(node, env, ft, src, tt)
    -- Let → type of body
    6 -> synth_let(node, env, ft, src, tt)
    -- Block → type of last expression
    7 -> synth_block(node, env, ft, src, tt)
    -- StringLit → str
    9 -> ty_str()
    -- While → nil (loops don't produce values)
    10 -> ty_nil()
    -- LetMut → type of body
    11 -> synth_let_mut(node, env, ft, src, tt)
    -- Assign → nil
    12 -> ty_nil()
    -- FieldAccess → i64 (and annotate record offset when type is known)
    13 -> synth_field_access(node, env, ft, src, tt)
    -- RecordInit → Named(type_hash, i64) — nominal record type
    14 -> ty_named(effect_name_hash(src, node_f1(node), node_f2(node)), ty_i64())
    -- Match → type of first arm body (simplified)
    15 -> synth_match(node, env, ft, src, tt)
    -- Not → bool
    22 -> ty_bool()
    -- Return exits the current function/handler helper and produces no local value.
    25 -> ty_never()
    -- BoolLit → bool
    24 -> ty_bool()
    -- FloatLit → f64
    54 -> ty_f64()
    -- AddressOf → *T / *mut T
    55 -> synth_address_of(node, env, ft, src, tt)
    -- Deref → pointee type
    56 -> synth_deref(node, env, ft, src, tt)
    -- PtrAssign → nil
    57 -> ty_nil()
    -- Perform/dot-call → synthesize method resolution
    32 -> synth_dot_call(node, env, ft, src, tt)
    -- Already-resolved method call → recover the resolved method return type
    41 -> synth_resolved_method_call(node, tt)
    -- Handle → type of body (handler discharges an effect, doesn't change type)
    33 -> synth(node_f1(node), env, ft, src, tt)
    -- Resume → value sent back to the suspended perform site
    35 -> synth(node_f1(node), env, ft, src, tt)
    -- GenericCall → substitute type args into return type
    36 -> synth_generic_call(node, env, ft, src, tt)
    -- LetTyped → check annotation matches value type
    37 -> synth_let_typed(node, env, ft, src, tt)
    -- Lambda → synthesize a first-order function value type
    29 -> synth_lambda(node, env, ft, src, tt)
    -- Try → payload type of the Result-like named value
    45 -> synth_try(node, env, ft, src, tt)
    -- String interpolation concat → str
    46 -> ty_str()
    -- For-iterator → nil
    47 -> ty_nil()
    -- Optional chain → field payload, currently i64-shaped
    48 -> ty_i64()
    -- Loop → union of break payloads
    49 -> synth_loop(node, env, ft, src, tt)
    -- Synthetic nil expression used by omitted else branches
    51 -> ty_nil()
    -- Defer preserves the body's type; cleanup is effect/type checked separately.
    52 -> synth(node_f2(node), env, ft, src, tt)
    -- Unknown
    _ -> ty_any()
  }
}

fn synth_try(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let inner_ty = synth(node_f1(node), env, ft, src, tt)
  if ty_tag(inner_ty) == 9 {
    let args = ty_f3(inner_ty)
    if args != 0 {
      if nlist_len(args) > 0 { nlist_get(args, 0) } else { ty_i64() }
    } else { ty_i64() }
  } else { ty_i64() }
}

fn synth_loop_break_union(a: i64, b: i64) -> i64 {
  if a == 0 { b }
  else { if b == 0 { a }
  else { if ty_eq(a, b) { a } else { ty_union(a, b) } } }
}

fn synth_loop_break_type(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  if node == 0 { 0 }
  else {
    let tag = node_tag(node)
    match tag {
      26 -> {
        let value = node_f1(node)
        if value == 0 { ty_nil() } else { synth(value, env, ft, src, tt) }
      }
      5 -> synth_loop_break_union(
        synth_loop_break_type(node_f2(node), env, ft, src, tt),
        synth_loop_break_type(node_f3(node), env, ft, src, tt)
      )
      7 -> synth_loop_break_union(
        synth_loop_break_type(node_f1(node), env, ft, src, tt),
        synth_loop_break_type(node_f2(node), env, ft, src, tt)
      )
      6 -> {
        let val_ty = synth(node_f3(node), env, ft, src, tt)
        let next_env = tenv_bind(env, src, node_f1(node), node_f2(node), val_ty)
        synth_loop_break_type(node_f4(node), next_env, ft, src, tt)
      }
      11 -> {
        let val_ty = synth(node_f3(node), env, ft, src, tt)
        let next_env = tenv_bind_mut(env, src, node_f1(node), node_f2(node), val_ty)
        synth_loop_break_type(node_f4(node), next_env, ft, src, tt)
      }
      37 -> synth_loop_break_type(node_f1(node), env, ft, src, tt)
      52 -> synth_loop_break_union(
        synth_loop_break_type(node_f1(node), env, ft, src, tt),
        synth_loop_break_type(node_f2(node), env, ft, src, tt)
      )
      _ -> 0
    }
  }
}

fn synth_loop(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let break_ty = synth_loop_break_type(node_f1(node), env, ft, src, tt)
  if break_ty == 0 { ty_never() } else { break_ty }
}

fn lambda_param_ty(param: i64) -> i64 {
  let ann_ty = node_f3(param)
  if ann_ty != 0 { ann_ty } else { ty_i64() }
}

fn synth_lambda(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let params = node_f1(node)
  let body = node_f2(node)
  let nparams = node_f3(node)
  let param_tys = nlist_new()
  let mut lambda_env = env
  for i in 0..nparams {
    let p = nlist_get(params, i)
    let param_ty = lambda_param_ty(p)
    nlist_add(param_tys, param_ty)
    lambda_env = tenv_bind(lambda_env, src, node_f1(p), node_f2(p), param_ty)
  }
  ty_fn(param_tys, synth(body, lambda_env, ft, src, tt), infer_expr_effects(body, lambda_env, ft, src, tt))
}

fn synth_ident(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let ns = node_f1(node)
  let nl = node_f2(node)
  let ty = tenv_lookup(env, src, ns, nl)
  if ty == 0 {
    if ttable_variant_payload_count(tt, src, ns, nl) == 0 {
      let variant_ty = ftypes_lookup(ft, src, ns, nl)
      if variant_ty == 0 { ty_any() } else { variant_ty }
    } else {
      let fn_ty = ftypes_lookup_fn_type(ft, src, ns, nl)
      if fn_ty == 0 { ty_any() } else { fn_ty }
    }
  } else { ty }
}

fn synth_field_access(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let base = node_f1(node)
  let field_ns = node_f2(node)
  let field_nl = node_f3(node)
  let base_ty = synth(base, env, ft, src, tt)
  if ty_tag(base_ty) == 9 {
    let idx = ttable_find_field_by_type_hash(tt, ty_f1(base_ty), src, field_ns, field_nl)
    if idx >= 0 { mem_store64_at(node, 32, idx + 1) } else { 0 }
    let entry = ttable_lookup_by_type_hash(tt, ty_f1(base_ty))
    if entry != 0 {
      let entry_src = mem_load64_at(entry, 48)
      let field_ty = ttable_field_type(entry, entry_src, src, field_ns, field_nl)
      if field_ty != 0 { field_ty } else { ty_i64() }
    } else { ty_i64() }
  } else { ty_i64() }
}

fn synth_address_of(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let inner_ty = synth(node_f2(node), env, ft, src, tt)
  ty_ptr_with_mut(inner_ty, node_f1(node))
}

fn synth_deref(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let ptr_ty = synth(node_f1(node), env, ft, src, tt)
  if ty_is_ptr(ptr_ty) == 1 { ty_ptr_inner(ptr_ty) } else { ty_any() }
}

fn ty_for_int_prim(prim: i64) -> i64 {
  if prim == PRIM_I8() { ty_i8() }
  else { if prim == PRIM_I16() { ty_i16() }
  else { if prim == PRIM_I32() { ty_i32() }
  else { if prim == PRIM_U8() { ty_u8() }
  else { if prim == PRIM_U16() { ty_u16() }
  else { if prim == PRIM_U32() { ty_u32() }
  else { if prim == PRIM_U64() { ty_u64() }
  else { if prim == PRIM_ISIZE() { ty_isize() }
  else { if prim == PRIM_USIZE() { ty_usize() }
  else { ty_i64() } } } } } } } } }
}

fn int_binop_candidate_prim(lhs_ty: i64, rhs_ty: i64) -> i64 {
  let lhs_prim = type_int_prim(lhs_ty)
  let rhs_prim = type_int_prim(rhs_ty)
  if lhs_prim >= 0 and lhs_prim != PRIM_I64() { lhs_prim }
  else { if rhs_prim >= 0 and rhs_prim != PRIM_I64() { rhs_prim }
  else { PRIM_I64() } }
}

fn synth_int_binop_type(lhs: i64, rhs: i64, lhs_ty: i64, rhs_ty: i64, src: i64) -> i64 {
  let prim = int_binop_candidate_prim(lhs_ty, rhs_ty)
  if expr_matches_int_prim_contextual(lhs, lhs_ty, prim, src) == 1 and expr_matches_int_prim_contextual(rhs, rhs_ty, prim, src) == 1 {
    ty_for_int_prim(prim)
  } else { ty_i64() }
}

fn synth_numeric_binop_type(lhs: i64, rhs: i64, lhs_ty: i64, rhs_ty: i64, src: i64) -> i64 {
  let has_f32 = type_is_f32_exact(lhs_ty) == 1 or type_is_f32_exact(rhs_ty) == 1
  if has_f32 == 1 and expr_matches_f32_contextual(lhs, lhs_ty) == 1 and expr_matches_f32_contextual(rhs, rhs_ty) == 1 {
    ty_f32()
  } else { if type_is_f64_exact(lhs_ty) or type_is_f64_exact(rhs_ty) { ty_f64() }
  else { if type_is_f32_exact(lhs_ty) or type_is_f32_exact(rhs_ty) { ty_f32() }
  else { synth_int_binop_type(lhs, rhs, lhs_ty, rhs_ty, src) } } }
}

fn synth_binop(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let op = node_f1(node)
  let lhs = node_f2(node)
  let rhs = node_f3(node)
  let lhs_ty = synth(lhs, env, ft, src, tt)
  let rhs_ty = synth(rhs, env, ft, src, tt)
  match op {
    -- Arithmetic: f32/f64 stay in their exact float lane; otherwise integer.
    1 -> synth_numeric_binop_type(lhs, rhs, lhs_ty, rhs_ty, src)
    2 -> synth_numeric_binop_type(lhs, rhs, lhs_ty, rhs_ty, src)
    3 -> synth_numeric_binop_type(lhs, rhs, lhs_ty, rhs_ty, src)
    4 -> synth_numeric_binop_type(lhs, rhs, lhs_ty, rhs_ty, src)
    -- Modulo is i64-only.
    11 -> synth_int_binop_type(lhs, rhs, lhs_ty, rhs_ty, src)
    -- Comparison: ==,!=,<,>,<=,>= → bool
    5 -> ty_bool()
    6 -> ty_bool()
    7 -> ty_bool()
    8 -> ty_bool()
    9 -> ty_bool()
    10 -> ty_bool()
    -- Logical: and=12, or=13 → bool
    12 -> ty_bool()
    13 -> ty_bool()
    -- Bitwise: band=14..bshr=18 → integer operand type
    _ -> synth_int_binop_type(lhs, rhs, lhs_ty, rhs_ty, src)
  }
}

fn intrinsic_int_to_f64_arg_ty(src: i64, ns: i64, nl: i64) -> i64 {
  if src_eq(src, ns, nl, "__i8_to_f64") == 1 { ty_i8() }
  else { if src_eq(src, ns, nl, "__i16_to_f64") == 1 { ty_i16() }
  else { if src_eq(src, ns, nl, "__i32_to_f64") == 1 { ty_i32() }
  else { if src_eq(src, ns, nl, "__i64_to_f64") == 1 { ty_i64() }
  else { if src_eq(src, ns, nl, "__isize_to_f64") == 1 { ty_isize() }
  else { if src_eq(src, ns, nl, "__u8_to_f64") == 1 { ty_u8() }
  else { if src_eq(src, ns, nl, "__u16_to_f64") == 1 { ty_u16() }
  else { if src_eq(src, ns, nl, "__u32_to_f64") == 1 { ty_u32() }
  else { if src_eq(src, ns, nl, "__u64_to_f64") == 1 { ty_u64() }
  else { if src_eq(src, ns, nl, "__usize_to_f64") == 1 { ty_usize() }
  else { 0 } } } } } } } } } }
}

fn intrinsic_int_to_f32_arg_ty(src: i64, ns: i64, nl: i64) -> i64 {
  if src_eq(src, ns, nl, "__i8_to_f32") == 1 { ty_i8() }
  else { if src_eq(src, ns, nl, "__i16_to_f32") == 1 { ty_i16() }
  else { if src_eq(src, ns, nl, "__i32_to_f32") == 1 { ty_i32() }
  else { if src_eq(src, ns, nl, "__i64_to_f32") == 1 { ty_i64() }
  else { if src_eq(src, ns, nl, "__isize_to_f32") == 1 { ty_isize() }
  else { if src_eq(src, ns, nl, "__u8_to_f32") == 1 { ty_u8() }
  else { if src_eq(src, ns, nl, "__u16_to_f32") == 1 { ty_u16() }
  else { if src_eq(src, ns, nl, "__u32_to_f32") == 1 { ty_u32() }
  else { if src_eq(src, ns, nl, "__u64_to_f32") == 1 { ty_u64() }
  else { if src_eq(src, ns, nl, "__usize_to_f32") == 1 { ty_usize() }
  else { 0 } } } } } } } } } }
}

fn intrinsic_int_cast_arg_ty(src: i64, ns: i64, nl: i64) -> i64 {
  if src_eq(src, ns, nl, "__i8_to_i64") == 1 { ty_i8() }
  else { if src_eq(src, ns, nl, "__i16_to_i64") == 1 { ty_i16() }
  else { if src_eq(src, ns, nl, "__i32_to_i64") == 1 { ty_i32() }
  else { if src_eq(src, ns, nl, "__isize_to_i64") == 1 { ty_isize() }
  else { if src_eq(src, ns, nl, "__u8_to_u64") == 1 { ty_u8() }
  else { if src_eq(src, ns, nl, "__u16_to_u64") == 1 { ty_u16() }
  else { if src_eq(src, ns, nl, "__u32_to_u64") == 1 { ty_u32() }
  else { if src_eq(src, ns, nl, "__usize_to_u64") == 1 { ty_usize() }
  else { if src_eq(src, ns, nl, "__i64_to_i8") == 1 or src_eq(src, ns, nl, "__i64_to_i16") == 1 or src_eq(src, ns, nl, "__i64_to_i32") == 1 { ty_i64() }
  else { if src_eq(src, ns, nl, "__i64_to_isize") == 1 or src_eq(src, ns, nl, "__i64_to_u8") == 1 or src_eq(src, ns, nl, "__i64_to_u16") == 1 { ty_i64() }
  else { if src_eq(src, ns, nl, "__i64_to_u32") == 1 or src_eq(src, ns, nl, "__i64_to_u64") == 1 or src_eq(src, ns, nl, "__i64_to_usize") == 1 { ty_i64() }
  else { if src_eq(src, ns, nl, "__u64_to_i8") == 1 or src_eq(src, ns, nl, "__u64_to_i16") == 1 or src_eq(src, ns, nl, "__u64_to_i32") == 1 { ty_u64() }
  else { if src_eq(src, ns, nl, "__u64_to_i64") == 1 or src_eq(src, ns, nl, "__u64_to_isize") == 1 or src_eq(src, ns, nl, "__u64_to_u8") == 1 { ty_u64() }
  else { if src_eq(src, ns, nl, "__u64_to_u16") == 1 or src_eq(src, ns, nl, "__u64_to_u32") == 1 or src_eq(src, ns, nl, "__u64_to_usize") == 1 { ty_u64() }
  else { 0 } } } } } } } } } } } } } } }
}

fn intrinsic_int_cast_return_ty(src: i64, ns: i64, nl: i64) -> i64 {
  if src_eq(src, ns, nl, "__i8_to_i64") == 1 or src_eq(src, ns, nl, "__i16_to_i64") == 1 or src_eq(src, ns, nl, "__i32_to_i64") == 1 or src_eq(src, ns, nl, "__isize_to_i64") == 1 { ty_i64() }
  else { if src_eq(src, ns, nl, "__u8_to_u64") == 1 or src_eq(src, ns, nl, "__u16_to_u64") == 1 or src_eq(src, ns, nl, "__u32_to_u64") == 1 or src_eq(src, ns, nl, "__usize_to_u64") == 1 { ty_u64() }
  else { if src_eq(src, ns, nl, "__i64_to_i8") == 1 or src_eq(src, ns, nl, "__u64_to_i8") == 1 { ty_i8() }
  else { if src_eq(src, ns, nl, "__i64_to_i16") == 1 or src_eq(src, ns, nl, "__u64_to_i16") == 1 { ty_i16() }
  else { if src_eq(src, ns, nl, "__i64_to_i32") == 1 or src_eq(src, ns, nl, "__u64_to_i32") == 1 { ty_i32() }
  else { if src_eq(src, ns, nl, "__i64_to_isize") == 1 or src_eq(src, ns, nl, "__u64_to_isize") == 1 { ty_isize() }
  else { if src_eq(src, ns, nl, "__i64_to_u8") == 1 or src_eq(src, ns, nl, "__u64_to_u8") == 1 { ty_u8() }
  else { if src_eq(src, ns, nl, "__i64_to_u16") == 1 or src_eq(src, ns, nl, "__u64_to_u16") == 1 { ty_u16() }
  else { if src_eq(src, ns, nl, "__i64_to_u32") == 1 or src_eq(src, ns, nl, "__u64_to_u32") == 1 { ty_u32() }
  else { if src_eq(src, ns, nl, "__i64_to_u64") == 1 { ty_u64() }
  else { if src_eq(src, ns, nl, "__i64_to_usize") == 1 or src_eq(src, ns, nl, "__u64_to_usize") == 1 { ty_usize() }
  else { if src_eq(src, ns, nl, "__u64_to_i64") == 1 { ty_i64() }
  else { 0 } } } } } } } } } } } }
}

fn synth_intrinsic_call(src: i64, ns: i64, nl: i64) -> i64 {
  let int_cast_ret_ty = intrinsic_int_cast_return_ty(src, ns, nl)
  if int_cast_ret_ty != 0 { int_cast_ret_ty }
  else { if intrinsic_int_to_f64_arg_ty(src, ns, nl) != 0 { ty_f64() }
  else { if intrinsic_int_to_f32_arg_ty(src, ns, nl) != 0 { ty_f32() }
  else { if src_eq(src, ns, nl, "__f64_to_i64_trunc") == 1 { ty_i64() }
  else { if src_eq(src, ns, nl, "__f32_to_f64") == 1 { ty_f64() }
  else { if src_eq(src, ns, nl, "__f64_to_f32") == 1 { ty_f32() }
  else { if src_eq(src, ns, nl, "__f64_sqrt") == 1 { ty_f64() }
  else { if src_eq(src, ns, nl, "__f32_sqrt") == 1 { ty_f32() }
  else { if src_eq(src, ns, nl, "__raw_offset") == 1 { ty_any() }
  else { if src_eq(src, ns, nl, "__transmute") == 1 { ty_any() }
  else { if src_eq(src, ns, nl, "__int_to_ptr") == 1 { ty_any() }
  else { if src_eq(src, ns, nl, "__mem_load_sized") == 1 { ty_i64() }
  else { if src_eq(src, ns, nl, "__mem_store_sized") == 1 { ty_i64() }
  else { ty_i64() }
  } } } } } } } } } } } }
}

fn weak_ref_name(src: i64, ns: i64, nl: i64) -> i64 {
  src_eq(src, ns, nl, "weak_ref")
}

fn weak_load_name(src: i64, ns: i64, nl: i64) -> i64 {
  src_eq(src, ns, nl, "weak_load")
}

fn typeck_ty_is_weak_target(ty: i64) -> i64 {
  if ty == 0 { 0 }
  else {
    let kind = ty_field_release_mask_kind(ty)
    kind == 1 or kind == 2 or ty_is_arc(ty) == 1
  }
}

fn typeck_ty_is_weak_managed_ref(ty: i64) -> i64 {
  if ty == 0 { 0 }
  else { if ty_is_weak(ty) != 1 { 0 } else { typeck_ty_is_weak_target(ty_weak_inner(ty)) } }
}

fn synth_weak_ref_call(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  if node_f4(node) == 1 { ty_weak(synth(nlist_get(node_f3(node), 0), env, ft, src, tt)) }
  else { ty_i64() }
}

fn synth_weak_load_call(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  if node_f4(node) == 1 {
    let weak_ty = synth(nlist_get(node_f3(node), 0), env, ft, src, tt)
    if ty_is_weak(weak_ty) == 1 { ty_nullable(ty_weak_inner(weak_ty)) } else { ty_i64() }
  } else { ty_i64() }
}

fn synth_call(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let ns = node_f1(node)
  let nl = node_f2(node)
  if weak_ref_name(src, ns, nl) == 1 {
    synth_weak_ref_call(node, env, ft, src, tt)
  } else { if weak_load_name(src, ns, nl) == 1 {
    synth_weak_load_call(node, env, ft, src, tt)
  } else { if src_eq(src, ns, nl, "rc_default_alloc") == 1 {
    ty_rc(ty_i64())
  } else {
    if nl >= 2 {
      if mem_load8_at(src, ns) == 95 {
        if mem_load8_at(src, ns + 1) == 95 { synth_intrinsic_call(src, ns, nl) }
        else { synth_call_general(node, env, ft, src, tt) }
      } else { synth_call_general(node, env, ft, src, tt) }
    } else { synth_call_general(node, env, ft, src, tt) }
  }
  } }
}

-- Bare calls try generic type-arg inference first (which rewrites the
-- node to an explicit GenericCall when it solves); otherwise ordinary
-- return-type lookup.
fn synth_call_general(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let inferred = synth_call_infer_generic(node, env, ft, src, tt)
  if inferred != 0 { inferred }
  else { synth_call_lookup(env, ft, src, node_f1(node), node_f2(node)) }
}

fn synth_call_lookup(env: i64, ft: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let local_ty = tenv_lookup(env, src, ns, nl)
  if local_ty != 0 {
    if ty_tag(local_ty) == 6 { ty_f2(local_ty) }
    else { if ty_tag(local_ty) == 14 { ty_f2(local_ty) }
    else {
      let ret = ftypes_lookup(ft, src, ns, nl)
      if ret == 0 { ty_i64() } else { ret }
    } }
  } else {
    let ret = ftypes_lookup(ft, src, ns, nl)
    if ret == 0 { ty_i64() } else { ret }
  }
}

-- Build substitution from type params + explicit type args
fn build_subst(tparams: i64, type_args: i64) -> i64 {
  let s = subst_new()
  let n = nlist_len(tparams)
  for i in 0..n {
    if i < nlist_len(type_args) {
      let tp = nlist_get(tparams, i)
      let var_id = node_f3(tp)
      let concrete = nlist_get(type_args, i)
      subst_add(s, var_id, concrete)
    } else { 0 }
  }
  s
}

-- GenericCall: tag 36 = (type_args_list, inner_call_node, num_type_args, 0)
fn synth_generic_call(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let type_args = node_f1(node)
  let call_node = node_f2(node)
  let ns = node_f1(call_node)
  let nl = node_f2(call_node)
  let tparams = ftypes_lookup_tparams(ft, src, ns, nl)
  let ret_ty = ftypes_lookup(ft, src, ns, nl)
  if tparams == 0 {
    -- Not generic or not found: fall back to regular call synthesis
    if ret_ty == 0 { ty_i64() } else { ret_ty }
  } else {
    -- Check type arg count matches
    let n_tparams = nlist_len(tparams)
    let n_targs = nlist_len(type_args)
    if n_tparams != n_targs {
      if ret_ty == 0 { ty_any() } else { ret_ty }
    } else {
      -- Build substitution and apply to return type
      let s = build_subst(tparams, type_args)
      if ret_ty == 0 { ty_any() } else { ty_subst(ret_ty, s) }
    }
  }
}

-- ══════════════════════════════════════════════════════════════
-- Generic instantiation inference (2u follow-up)
--
-- Bare calls to generic ctors/functions solve their type args from
-- argument types (synth_call path); generic ctors in result positions
-- additionally solve from the expected type (return position, let
-- annotation, argument position, assignment). Successful inference
-- rewrites the node in place into the explicit GenericCall (tag 36)
-- shape the parser produces for name<targs>(args), so checking,
-- monomorphisation, and codegen all see the one explicit shape.
--
-- Inference only fires where the program would otherwise fail to
-- check (context sites are second-chance-on-mismatch; the synth_call
-- path only rewrites calls whose bare form cannot check against
-- var-typed params), so it strictly accepts more programs.
-- ══════════════════════════════════════════════════════════════

-- Structural type identity for conflict detection. Conservative: shapes
-- it does not model compare unequal, which aborts inference rather than
-- risking a wrong instantiation.
fn ty_infer_same(a: i64, b: i64) -> i64 {
  if a == b { 1 }
  else { if a == 0 or b == 0 { 0 }
  else {
    let atag = ty_tag(a)
    if atag != ty_tag(b) { 0 }
    else {
      match atag {
        0 -> 1
        1 -> 1
        2 -> if ty_f1(a) == ty_f1(b) { 1 } else { 0 }
        12 -> if ty_f1(a) == ty_f1(b) { 1 } else { 0 }
        3 -> if ty_infer_same(ty_f1(a), ty_f1(b)) == 1 { ty_infer_same(ty_f2(a), ty_f2(b)) } else { 0 }
        9 -> {
          if ty_f1(a) != ty_f1(b) { 0 }
          else { ty_infer_same_list(ty_f3(a), ty_f3(b)) }
        }
        16 -> ty_infer_same(ty_f1(a), ty_f1(b))
        17 -> ty_infer_same(ty_f1(a), ty_f1(b))
        18 -> ty_infer_same(ty_f1(a), ty_f1(b))
        19 -> ty_infer_same(ty_f1(a), ty_f1(b))
        _ -> 0
      }
    }
  } }
}

fn ty_infer_same_list(a: i64, b: i64) -> i64 {
  if a == 0 and b == 0 { 1 }
  else { if a == 0 or b == 0 { 0 }
  else {
    let n = nlist_len(a)
    if n != nlist_len(b) { 0 }
    else {
      let mut same = 1
      for i in 0..n {
        if ty_infer_same(nlist_get(a, i), nlist_get(b, i)) == 0 { same = 0 } else { 0 }
      }
      same
    }
  } }
}

-- Solve type vars in pat against a concrete type, extending s. Returns
-- 1 on success (bindings may or may not have been added), 0 on a
-- conflict with an existing binding. Shapes that carry no information
-- succeed without binding — validation stays with the ordinary checks
-- that run over the rewritten node.
fn ty_infer_solve(pat: i64, concrete: i64, s: i64) -> i64 {
  if pat == 0 or concrete == 0 { 1 }
  else {
    let ptag = ty_tag(pat)
    if ptag == 12 {
      -- A type-var "concrete" carries no information: it is either an
      -- unsolved nested ctor (its instantiation cascades later from the
      -- rewritten parameter type) or an enclosing template's tparam
      -- (templates stay unmutated by inference — mono owns them).
      if ty_tag(concrete) == 12 { 1 }
      else {
        let existing = subst_lookup(s, ty_f1(pat))
        if existing == 0 {
          if type_is_unknown_or_any(concrete) { 1 }
          else {
            subst_add(s, ty_f1(pat), concrete)
            1
          }
        } else {
          if type_is_unknown_or_any(concrete) { 1 } else { ty_infer_same(existing, concrete) }
        }
      }
    }
    else { if ptag == 9 and ty_tag(concrete) == 9 {
      if ty_f1(pat) != ty_f1(concrete) { 1 }
      else { ty_infer_solve_list(ty_f3(pat), ty_f3(concrete), s) }
    }
    else { if ptag == 3 and ty_tag(concrete) == 3 {
      if ty_infer_solve(ty_f1(pat), ty_f1(concrete), s) == 1 {
        ty_infer_solve(ty_f2(pat), ty_f2(concrete), s)
      } else { 0 }
    }
    else { if ptag == 6 and ty_tag(concrete) == 6 {
      if ty_infer_solve_list(ty_f1(pat), ty_f1(concrete), s) == 1 {
        ty_infer_solve(ty_f2(pat), ty_f2(concrete), s)
      } else { 0 }
    }
    else { if ty_tag(concrete) == ptag and (ptag == 16 or ptag == 17 or ptag == 18 or ptag == 19 or ptag == 15) {
      ty_infer_solve(ty_f1(pat), ty_f1(concrete), s)
    }
    else { 1 } } } } }
  }
}

fn ty_infer_solve_list(pats: i64, concretes: i64, s: i64) -> i64 {
  if pats == 0 or concretes == 0 { 1 }
  else {
    let n = nlist_len(pats)
    if n != nlist_len(concretes) { 1 }
    else {
      let mut ok = 1
      for i in 0..n {
        if ty_infer_solve(nlist_get(pats, i), nlist_get(concretes, i), s) == 0 { ok = 0 } else { 0 }
      }
      ok
    }
  }
}

-- Solved type-arg list in tparam order, or 0 if any tparam is unsolved.
fn generic_infer_solved_targs(tparams: i64, s: i64) -> i64 {
  let n = nlist_len(tparams)
  if n == 0 { 0 }
  else {
    let targs = nlist_new()
    let mut ok = 1
    for i in 0..n {
      let v = subst_lookup(s, node_f3(nlist_get(tparams, i)))
      if v == 0 { ok = 0 } else { nlist_add(targs, v) }
    }
    if ok == 1 { targs } else { 0 }
  }
}

-- Rewrite a bare call/ident node in place to GenericCall(targs, Call).
-- Tag 36 layout: f1=type_args_list, f2=inner_call_node, f3=count, f4=0.
fn generic_call_rewrite_to_explicit(node: i64, ns: i64, nl: i64, args: i64, nargs: i64, targs: i64) -> i64 {
  let inner = node_new(4, ns, nl, args, nargs)
  mem_store64_at(node, 0, 36)
  mem_store64_at(node, 8, targs)
  mem_store64_at(node, 16, inner)
  mem_store64_at(node, 24, nlist_len(targs))
  mem_store64_at(node, 32, 0)
  0
}

-- Argument-driven inference for a bare tag-4 call to a generic callee.
-- Returns the substituted return type after rewriting the node, or 0
-- when inference does not apply or does not fully solve.
fn synth_call_infer_generic(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let ns = node_f1(node)
  let nl = node_f2(node)
  if tenv_lookup(env, src, ns, nl) != 0 { 0 }
  else {
    let tparams = ftypes_lookup_tparams(ft, src, ns, nl)
    if tparams == 0 { 0 }
    else {
      let params = ftypes_lookup_params(ft, src, ns, nl)
      let args = node_f3(node)
      let nargs = node_f4(node)
      if params == 0 or nargs == 0 { 0 }
      else { if nlist_len(params) != nargs { 0 }
      else {
        let s = subst_new()
        let mut ok = 1
        for i in 0..nargs {
          let pty = node_f3(nlist_get(params, i))
          if pty != 0 {
            if ty_infer_solve(pty, synth(nlist_get(args, i), env, ft, src, tt), s) == 0 { ok = 0 } else { 0 }
          } else { 0 }
        }
        if ok == 0 { 0 }
        else {
          let targs = generic_infer_solved_targs(tparams, s)
          if targs == 0 { 0 }
          else {
            let ret_ty = ftypes_lookup(ft, src, ns, nl)
            generic_call_rewrite_to_explicit(node, ns, nl, args, nargs, targs)
            if ret_ty == 0 { ty_any() } else { ty_subst(ret_ty, s) }
          }
        }
      } }
    }
  }
}

-- Context-driven inference for a generic ctor meeting an expected type.
-- Ctors only: their declared return type is exactly parent<vars>, so
-- unifying it against the expected type either fully solves the
-- instantiation or leaves vars for payload args to fill.
fn try_infer_ctor_from_expected(node: i64, target_ty: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let tag = node_tag(node)
  let ns = node_f1(node)
  let nl = node_f2(node)
  if tag == 2 and tenv_lookup(env, src, ns, nl) != 0 { 0 }
  else { if ttable_variant_payload_count(tt, src, ns, nl) < 0 { 0 }
  else {
    let tparams = ftypes_lookup_tparams(ft, src, ns, nl)
    if tparams == 0 { 0 }
    else {
      let ret_ty = ftypes_lookup(ft, src, ns, nl)
      if ret_ty == 0 { 0 }
      else {
        let s = subst_new()
        if ty_infer_solve(ret_ty, target_ty, s) == 0 { 0 }
        else {
          let mut ok = 1
          if tag == 4 {
            let params = ftypes_lookup_params(ft, src, ns, nl)
            let args = node_f3(node)
            let nargs = node_f4(node)
            if params != 0 and nlist_len(params) == nargs {
              for i in 0..nargs {
                let pty = node_f3(nlist_get(params, i))
                if pty != 0 {
                  if ty_infer_solve(pty, synth(nlist_get(args, i), env, ft, src, tt), s) == 0 { ok = 0 } else { 0 }
                } else { 0 }
              }
            } else { 0 }
          } else { 0 }
          if ok == 0 { 0 }
          else {
            let targs = generic_infer_solved_targs(tparams, s)
            if targs == 0 { 0 }
            else {
              let args = if tag == 4 { node_f3(node) } else { nlist_new() }
              let nargs = if tag == 4 { node_f4(node) } else { 0 }
              generic_call_rewrite_to_explicit(node, ns, nl, args, nargs, targs)
              1
            }
          }
        }
      }
    }
  } }
}

-- Walk an expression tree trying ctor instantiation inference against
-- the expected type. is_result = 1 means the current node's value flows
-- to the expected type (block tails, if branches, match arm bodies, let
-- bodies); statement positions recurse with is_result = 0 purely to
-- reach `return` values, which are always result positions. Env is
-- threaded through let/pattern bindings the same way check_return_values
-- threads it. Returns 1 if any node was rewritten.
fn infer_generic_ctor_walk(node: i64, target_ty: i64, env: i64, ft: i64, src: i64, tt: i64, is_result: i64) -> i64 {
  if node == 0 or target_ty == 0 { 0 }
  else { if type_is_unknown_or_any(target_ty) { 0 }
  else {
    let tag = node_tag(node)
    if tag == 2 or tag == 4 {
      if is_result == 1 { try_infer_ctor_from_expected(node, target_ty, env, ft, src, tt) } else { 0 }
    }
    else { if tag == 25 {
      infer_generic_ctor_walk(node_f1(node), target_ty, env, ft, src, tt, 1)
    }
    else { if tag == 7 {
      let rest = node_f2(node)
      if rest == 0 { infer_generic_ctor_walk(node_f1(node), target_ty, env, ft, src, tt, is_result) }
      else {
        let a = infer_generic_ctor_walk(node_f1(node), target_ty, env, ft, src, tt, 0)
        let b = infer_generic_ctor_walk(rest, target_ty, env, ft, src, tt, is_result)
        if a == 1 or b == 1 { 1 } else { 0 }
      }
    }
    else { if tag == 5 {
      let c = infer_generic_ctor_walk(node_f1(node), target_ty, env, ft, src, tt, 0)
      let a = infer_generic_ctor_walk(node_f2(node), target_ty, env, ft, src, tt, is_result)
      let b = infer_generic_ctor_walk(node_f3(node), target_ty, env, ft, src, tt, is_result)
      if a == 1 or b == 1 or c == 1 { 1 } else { 0 }
    }
    else { if tag == 15 {
      let scr_ty = synth(node_f1(node), env, ft, src, tt)
      let arms = node_f2(node)
      let n_arms = node_f3(node)
      let mut any = infer_generic_ctor_walk(node_f1(node), target_ty, env, ft, src, tt, 0)
      for i in 0..n_arms {
        let arm = nlist_get(arms, i)
        let arm_env = bind_pattern(node_f1(arm), env, src, scr_ty, tt)
        if infer_generic_ctor_walk(node_f2(arm), target_ty, arm_env, ft, src, tt, is_result) == 1 { any = 1 } else { 0 }
      }
      any
    }
    else { if tag == 6 or tag == 11 {
      let a = infer_generic_ctor_walk(node_f3(node), target_ty, env, ft, src, tt, 0)
      let val_ty = synth(node_f3(node), env, ft, src, tt)
      let new_env = if tag == 11 { tenv_bind_mut(env, src, node_f1(node), node_f2(node), val_ty) }
        else { tenv_bind(env, src, node_f1(node), node_f2(node), val_ty) }
      let b = infer_generic_ctor_walk(node_f4(node), target_ty, new_env, ft, src, tt, is_result)
      if a == 1 or b == 1 { 1 } else { 0 }
    }
    else { if tag == 37 {
      let inner = node_f1(node)
      let ann_ty = node_f2(node)
      let a = infer_generic_ctor_walk(node_f3(inner), target_ty, env, ft, src, tt, 0)
      let new_env = if node_tag(inner) == 11 { tenv_bind_mut(env, src, node_f1(inner), node_f2(inner), ann_ty) }
        else { tenv_bind(env, src, node_f1(inner), node_f2(inner), ann_ty) }
      let b = infer_generic_ctor_walk(node_f4(inner), target_ty, new_env, ft, src, tt, is_result)
      if a == 1 or b == 1 { 1 } else { 0 }
    }
    else { if tag == 10 {
      let a = infer_generic_ctor_walk(node_f1(node), target_ty, env, ft, src, tt, 0)
      let b = infer_generic_ctor_walk(node_f2(node), target_ty, env, ft, src, tt, 0)
      if a == 1 or b == 1 { 1 } else { 0 }
    }
    else { if tag == 33 {
      infer_generic_ctor_walk(node_f1(node), target_ty, env, ft, src, tt, is_result)
    }
    else { if tag == 52 {
      infer_generic_ctor_walk(node_f2(node), target_ty, env, ft, src, tt, is_result)
    }
    else { 0 } } } } } } } } } }
  } }
}

fn infer_generic_ctor_result(node: i64, target_ty: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  infer_generic_ctor_walk(node, target_ty, env, ft, src, tt, 1)
}

fn check_generic_type_arg_count(tparams: i64, type_args: i64, src: i64, ns: i64) -[Diagnose]> i64 {
  if tparams == 0 { 0 }
  else {
    let n_tparams = nlist_len(tparams)
    let n_targs = nlist_len(type_args)
    if n_tparams != n_targs {
      typeck_error_maybe(src, ns, "type error: wrong number of type arguments")
      1
    } else { 0 }
  }
}

fn ttable_variant_name_is_cons(entry_src: i64, v_ns: i64, v_nl: i64) -> i64 {
  if v_nl == 4 {
    mem_load8_at(entry_src, v_ns) == 67 and
    mem_load8_at(entry_src, v_ns + 1) == 111 and
    mem_load8_at(entry_src, v_ns + 2) == 110 and
    mem_load8_at(entry_src, v_ns + 3) == 115
  } else { false }
}

fn ttable_variant_name_is_nil(entry_src: i64, v_ns: i64, v_nl: i64) -> i64 {
  if v_nl == 3 {
    mem_load8_at(entry_src, v_ns) == 78 and
    mem_load8_at(entry_src, v_ns + 1) == 105 and
    mem_load8_at(entry_src, v_ns + 2) == 108
  } else { false }
}

fn for_iter_item_type_from_collection(tt: i64, collection_ty: i64) -> i64 {
  if tt == 0 { ty_i64() }
  else { if ty_tag(collection_ty) != 9 { ty_i64() }
  else {
    let type_hash = ty_f1(collection_ty)
    let type_args = ty_f3(collection_ty)
    let n = mem_load64_at(tt, 8)
    let d = mem_load64_at(tt, 0)
    let mut ti = 0
    let mut result = ty_i64()
    while ti < n {
      let kind = mem_load64_at(d, ti * 64 + 16)
      if kind == 1 {
        let entry_src = mem_load64_at(d, ti * 64 + 48)
        let type_ns = mem_load64_at(d, ti * 64)
        let type_nl = mem_load64_at(d, ti * 64 + 8)
        if mem_load64_at(d, ti * 64 + 56) == type_hash {
          let nvariants = mem_load64_at(d, ti * 64 + 24)
          let variants = mem_load64_at(d, ti * 64 + 32)
          let tparams = mem_load64_at(d, ti * 64 + 40)
          let mut vi = 0
          while vi < nvariants {
            let v_ns = mem_load64_at(variants, vi * 40)
            let v_nl = mem_load64_at(variants, vi * 40 + 8)
            if ttable_variant_name_is_cons(entry_src, v_ns, v_nl) == 1 {
              let npayloads = mem_load64_at(variants, vi * 40 + 24)
              let payloads = mem_load64_at(variants, vi * 40 + 32)
              if npayloads > 0 {
                let pty = if payloads != 0 { nlist_get(payloads, 0) } else { ty_i64() }
                if tparams != 0 {
                  if type_args != 0 { result = ty_subst(pty, build_subst(tparams, type_args)) }
                  else { result = pty }
                } else { result = pty }
              } else { result = ty_i64() }
              vi = nvariants
              ti = n
            } else { vi = vi + 1 }
          }
          if ti < n { ti = ti + 1 } else { ti = ti }
        } else { ti = ti + 1 }
      } else { ti = ti + 1 }
    }
    result
  } }
}

fn for_iter_collection_has_list_shape(tt: i64, collection_ty: i64) -> i64 {
  if type_is_unknown_or_any(collection_ty) { 1 }
  else { if tt == 0 { 1 }
  else { if ty_tag(collection_ty) != 9 { 0 }
  else {
    let type_hash = ty_f1(collection_ty)
    let n = mem_load64_at(tt, 8)
    let d = mem_load64_at(tt, 0)
    let mut ti = 0
    let mut found_cons = 0
    let mut found_nil = 0
    while ti < n {
      let kind = mem_load64_at(d, ti * 64 + 16)
      if kind == 1 {
        let entry_src = mem_load64_at(d, ti * 64 + 48)
        let type_ns = mem_load64_at(d, ti * 64)
        let type_nl = mem_load64_at(d, ti * 64 + 8)
        if mem_load64_at(d, ti * 64 + 56) == type_hash {
          let nvariants = mem_load64_at(d, ti * 64 + 24)
          let variants = mem_load64_at(d, ti * 64 + 32)
          let mut vi = 0
          while vi < nvariants {
            let v_ns = mem_load64_at(variants, vi * 40)
            let v_nl = mem_load64_at(variants, vi * 40 + 8)
            if ttable_variant_name_is_cons(entry_src, v_ns, v_nl) == 1 { found_cons = 1 } else { found_cons = found_cons }
            if ttable_variant_name_is_nil(entry_src, v_ns, v_nl) == 1 { found_nil = 1 } else { found_nil = found_nil }
            vi = vi + 1
          }
          ti = n
        } else { ti = ti + 1 }
      } else { ti = ti + 1 }
    }
    found_cons == 1 and found_nil == 1
  } } }
}

fn for_iter_item_type(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  for_iter_item_type_from_collection(tt, synth(node_f3(node), env, ft, src, tt))
}

fn check_for_iter_collection(node: i64, env: i64, ft: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  let collection = node_f3(node)
  let collection_ty = synth(collection, env, ft, src, tt)
  if for_iter_collection_has_list_shape(tt, collection_ty) == 1 {
    0
  } else {
    let pos = if node_tag(collection) == 2 { node_f1(collection) } else { node_f1(node) }
    typeck_error_maybe(src, pos, "type error: for iterator requires a Cons/Nil list")
    1
  }
}

fn synth_if(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  -- Branches synth under the guard-narrowed env so
  -- `if x != nil { x } else { fallback }` reads T, not T | nil.
  let then_ty = synth(node_f2(node), tenv_narrow_guard(env, node_f1(node), 6, src), ft, src, tt)
  let else_node = node_f3(node)
  if else_node == 0 { ty_nil() }
  else {
    let else_ty = synth(else_node, tenv_narrow_guard(env, node_f1(node), 5, src), ft, src, tt)
    -- If both branches have the same type, use it
    if ty_eq(then_ty, else_ty) { then_ty }
    else { ty_union(then_ty, else_ty) }
  }
}

fn synth_let(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let ns = node_f1(node)
  let nl = node_f2(node)
  let val = node_f3(node)
  let body = node_f4(node)
  let val_ty = synth(val, env, ft, src, tt)
  let new_env = tenv_bind(env, src, ns, nl, val_ty)
  synth(body, new_env, ft, src, tt)
}

fn synth_let_mut(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let ns = node_f1(node)
  let nl = node_f2(node)
  let val = node_f3(node)
  let body = node_f4(node)
  let val_ty = synth(val, env, ft, src, tt)
  let new_env = tenv_bind_mut(env, src, ns, nl, val_ty)
  synth(body, new_env, ft, src, tt)
}

-- LetTyped: tag 37 wraps inner let (tag 6 or 11) with annotation type
fn synth_let_typed(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let inner = node_f1(node)
  let ann_ty = node_f2(node)
  let val = node_f3(inner)
  let body = node_f4(inner)
  let ns = node_f1(inner)
  let nl = node_f2(inner)
  let _val_ty = synth(val, env, ft, src, tt)
  let new_env = if node_tag(inner) == 11 {
    tenv_bind_mut(env, src, ns, nl, ann_ty)
  } else {
    tenv_bind(env, src, ns, nl, ann_ty)
  }
  synth(body, new_env, ft, src, tt)
}

fn synth_dot_call(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let lhs = node_f1(node)
  -- Disambiguate: is LHS an effect name (not in scope) or a value (in scope)?
  if node_tag(lhs) == 2 {
    let ns = node_f1(lhs)
    let nl = node_f2(lhs)
    let var_ty = tenv_lookup(env, src, ns, nl)
    if var_ty == 0 {
      -- Not in type env → effect perform.
      -- Look up the effect operation's return type from the type table.
      synth_effect_perform(node, src, tt)
    } else {
      -- In type env → method call. Resolve receiver type.
      synth_method_call(node, var_ty, env, ft, src, tt)
    }
  } else {
    -- Complex expression as receiver: synth type, then resolve method
    let recv_ty = synth(lhs, env, ft, src, tt)
    synth_method_call(node, recv_ty, env, ft, src, tt)
  }
}

fn effect_op_ret_type(op: i64) -> i64 {
  let meta = node_f4(op)
  if meta == 0 { 0 }
  else {
    if node_tag(meta) == 53 { node_f1(meta) } else { meta }
  }
}

fn effect_op_is_deferred(op: i64) -> i64 {
  let meta = node_f4(op)
  if meta == 0 { 0 }
  else {
    if node_tag(meta) == 53 { node_f2(meta) } else { 0 }
  }
}

fn type_list_single(ty: i64) -> i64 {
  let params = nlist_new()
  nlist_add(params, ty)
  params
}

fn continuation_fn_type(value_ty: i64, result_ty: i64) -> i64 {
  ty_continuation(value_ty, result_ty)
}

fn same_source_name(src: i64, a_ns: i64, a_nl: i64, b_ns: i64, b_nl: i64) -> bool {
  if a_nl != b_nl { false }
  else { src_eq_at(src, a_ns, src + b_ns, 0, a_nl) }
}

fn continuation_name_matches(cont: i64, src: i64, ns: i64, nl: i64) -> bool {
  if cont == 0 { false }
  else { same_source_name(src, ns, nl, node_f1(cont), node_f2(cont)) }
}

fn continuation_call_matches(node: i64, cont: i64, src: i64) -> i64 {
  if node_tag(node) == 4 {
    continuation_name_matches(cont, src, node_f1(node), node_f2(node))
  } else { 0 }
}

fn continuation_count_max(left: i64, right: i64) -> i64 {
  if left > right { left } else { right }
}

fn continuation_ref_count_list(list: i64, n: i64, cont: i64, src: i64) -> i64 {
  let mut count = 0
  for i in 0..n {
    count = count + continuation_ref_count(nlist_get(list, i), cont, src)
  }
  count
}

fn continuation_ref_count(node: i64, cont: i64, src: i64) -> i64 {
  if node == 0 { 0 }
  else {
    match node_tag(node) {
      2 -> continuation_name_matches(cont, src, node_f1(node), node_f2(node))
      3 -> continuation_ref_count(node_f2(node), cont, src) + continuation_ref_count(node_f3(node), cont, src)
      4 -> continuation_call_matches(node, cont, src) + continuation_ref_count_list(node_f3(node), node_f4(node), cont, src)
      5 -> continuation_ref_count(node_f1(node), cont, src) + continuation_ref_count(node_f2(node), cont, src) + continuation_ref_count(node_f3(node), cont, src)
      6 -> {
        let alias = continuation_alias_from_let(node, cont, src, 0)
        if alias != 0 {
          continuation_ref_count(node_f4(node), alias, src) + continuation_ref_count(node_f4(node), cont, src)
        } else {
          continuation_ref_count(node_f3(node), cont, src) + continuation_ref_count(node_f4(node), cont, src)
        }
      }
      7 -> continuation_ref_count(node_f1(node), cont, src) + continuation_ref_count(node_f2(node), cont, src)
      10 -> continuation_ref_count(node_f1(node), cont, src) + continuation_ref_count(node_f2(node), cont, src)
      11 -> continuation_ref_count(node_f3(node), cont, src) + continuation_ref_count(node_f4(node), cont, src)
      12 -> continuation_ref_count(node_f3(node), cont, src)
      57 -> continuation_ref_count(node_f1(node), cont, src) + continuation_ref_count(node_f2(node), cont, src)
      13 -> continuation_ref_count(node_f1(node), cont, src)
      14 -> {
        let fields = node_f3(node)
        let nfields = node_f4(node)
        let mut count = 0
        for ri in 0..nfields {
          count = count + continuation_ref_count(node_f3(nlist_get(fields, ri)), cont, src)
        }
        count
      }
      15 -> {
        let arms = node_f2(node)
        let n = node_f3(node)
        let mut count = continuation_ref_count(node_f1(node), cont, src)
        for i in 0..n {
          let arm = nlist_get(arms, i)
          let guard = node_f3(arm)
          if guard != 0 { count = count + continuation_ref_count(guard, cont, src) } else { count = count }
          count = count + continuation_ref_count(node_f2(arm), cont, src)
        }
        count
      }
      22 -> continuation_ref_count(node_f1(node), cont, src)
      25 -> continuation_ref_count(node_f1(node), cont, src)
      26 -> continuation_ref_count(node_f1(node), cont, src)
      29 -> continuation_ref_count(node_f2(node), cont, src)
      32 -> continuation_ref_count(node_f1(node), cont, src) + continuation_ref_count_list(node_f4(node), nlist_len(node_f4(node)), cont, src)
      33 -> continuation_ref_count(node_f1(node), cont, src)
      35 -> continuation_ref_count(node_f1(node), cont, src)
      36 -> {
        let call_node = node_f2(node)
        continuation_ref_count_list(node_f3(call_node), node_f4(call_node), cont, src)
      }
      37 -> continuation_ref_count(node_f1(node), cont, src)
      41 -> continuation_ref_count(node_f1(node), cont, src) + continuation_ref_count_list(node_f3(node), nlist_len(node_f3(node)), cont, src)
      45 -> continuation_ref_count(node_f1(node), cont, src)
      46 -> continuation_ref_count(node_f1(node), cont, src) + continuation_ref_count(node_f2(node), cont, src)
      47 -> continuation_ref_count(node_f3(node), cont, src) + continuation_ref_count(node_f4(node), cont, src)
      48 -> continuation_ref_count(node_f1(node), cont, src)
      49 -> continuation_ref_count(node_f1(node), cont, src)
      52 -> continuation_ref_count(node_f1(node), cont, src) + continuation_ref_count(node_f2(node), cont, src)
      _ -> 0
    }
  }
}

fn continuation_call_count(node: i64, cont: i64, src: i64, ft: i64) -> i64 {
  if node == 0 { 0 }
  else {
    match node_tag(node) {
      3 -> continuation_call_count(node_f2(node), cont, src, ft) + continuation_call_count(node_f3(node), cont, src, ft)
      4 -> continuation_call_matches(node, cont, src) + continuation_call_arg_count_list(node_f3(node), node_f4(node), cont, src, ft)
      5 -> {
        let cond_count = continuation_call_count(node_f1(node), cont, src, ft)
        let then_count = continuation_call_count(node_f2(node), cont, src, ft)
        let else_count = continuation_call_count(node_f3(node), cont, src, ft)
        cond_count + continuation_count_max(then_count, else_count)
      }
      6 -> {
        let alias = continuation_alias_from_let(node, cont, src, ft)
        if alias != 0 {
          continuation_call_count(node_f4(node), alias, src, ft) + continuation_call_count(node_f4(node), cont, src, ft)
        } else {
          continuation_call_count(node_f3(node), cont, src, ft) + continuation_call_count(node_f4(node), cont, src, ft)
        }
      }
      7 -> continuation_call_count(node_f1(node), cont, src, ft) + continuation_call_count(node_f2(node), cont, src, ft)
      10 -> continuation_call_count(node_f1(node), cont, src, ft) + continuation_call_count(node_f2(node), cont, src, ft)
      11 -> continuation_call_count(node_f3(node), cont, src, ft) + continuation_call_count(node_f4(node), cont, src, ft)
      12 -> continuation_call_count(node_f3(node), cont, src, ft)
      57 -> continuation_call_count(node_f1(node), cont, src, ft) + continuation_call_count(node_f2(node), cont, src, ft)
      13 -> continuation_call_count(node_f1(node), cont, src, ft)
      14 -> {
        let fields = node_f3(node)
        let nfields = node_f4(node)
        let mut count = 0
        for ri in 0..nfields {
          count = count + continuation_call_count(node_f3(nlist_get(fields, ri)), cont, src, ft)
        }
        count
      }
      15 -> {
        let arms = node_f2(node)
        let n = node_f3(node)
        let mut count = continuation_call_count(node_f1(node), cont, src, ft)
        for i in 0..n {
          let arm = nlist_get(arms, i)
          let guard = node_f3(arm)
          if guard != 0 { count = count + continuation_call_count(guard, cont, src, ft) } else { count = count }
          count = count + continuation_call_count(node_f2(arm), cont, src, ft)
        }
        count
      }
      22 -> continuation_call_count(node_f1(node), cont, src, ft)
      25 -> continuation_call_count(node_f1(node), cont, src, ft)
      26 -> continuation_call_count(node_f1(node), cont, src, ft)
      29 -> 0
      32 -> continuation_call_count(node_f1(node), cont, src, ft) + continuation_call_arg_count_list(node_f4(node), nlist_len(node_f4(node)), cont, src, ft)
      33 -> continuation_call_count(node_f1(node), cont, src, ft)
      35 -> continuation_call_count(node_f1(node), cont, src, ft)
      36 -> {
        let call_node = node_f2(node)
        continuation_call_arg_count_list(node_f3(call_node), node_f4(call_node), cont, src, ft)
      }
      37 -> continuation_call_count(node_f1(node), cont, src, ft)
      41 -> continuation_call_count(node_f1(node), cont, src, ft) + continuation_call_arg_count_list(node_f3(node), nlist_len(node_f3(node)), cont, src, ft)
      45 -> continuation_call_count(node_f1(node), cont, src, ft)
      46 -> continuation_call_count(node_f1(node), cont, src, ft) + continuation_call_count(node_f2(node), cont, src, ft)
      47 -> continuation_call_count(node_f3(node), cont, src, ft) + continuation_call_count(node_f4(node), cont, src, ft)
      48 -> continuation_call_count(node_f1(node), cont, src, ft)
      49 -> continuation_call_count(node_f1(node), cont, src, ft)
      52 -> continuation_call_count(node_f1(node), cont, src, ft) + continuation_call_count(node_f2(node), cont, src, ft)
      _ -> 0
    }
  }
}

fn continuation_call_count_list(list: i64, n: i64, cont: i64, src: i64, ft: i64) -> i64 {
  let mut count = 0
  for i in 0..n {
    count = count + continuation_call_count(nlist_get(list, i), cont, src, ft)
  }
  count
}

fn continuation_call_arg_count_list(list: i64, n: i64, cont: i64, src: i64, ft: i64) -> i64 {
  let mut count = 0
  for i in 0..n {
    let arg = nlist_get(list, i)
    if continuation_direct_ref(arg, cont, src) == 1 {
      count = count + 1
    } else {
      count = count + continuation_call_count(arg, cont, src, ft)
    }
  }
  count
}

fn continuation_direct_ref_count_list(list: i64, n: i64, cont: i64, src: i64) -> i64 {
  let mut count = 0
  for i in 0..n {
    if continuation_direct_ref(nlist_get(list, i), cont, src) == 1 {
      count = count + 1
    } else { count = count }
  }
  count
}

fn continuation_direct_result(node: i64, cont: i64, src: i64) -> i64 {
  if continuation_direct_ref(node, cont, src) == 1 { 1 }
  else { if node != 0 {
    if node_tag(node) == 25 { continuation_direct_ref(node_f1(node), cont, src) } else { 0 }
  } else { 0 } }
}

fn continuation_call_returns_direct_arg(call_node: i64, cont: i64, src: i64, ft: i64) -> i64 {
  if node_tag(call_node) != 4 { 0 }
  else {
    let entry = ftypes_find(ft, src, node_f1(call_node), node_f2(call_node))
    if entry == 0 { 0 }
    else {
      let fn_src = mem_load64_at(entry, 24)
      let ret_ty = mem_load64_at(entry, 16)
      let params = mem_load64_at(entry, 32)
      let body = mem_load64_at(entry, 56)
      if ty_is_continuation(ret_ty) == 0 or params == 0 or body == 0 { 0 }
      else {
        let args = node_f3(call_node)
        let nargs = node_f4(call_node)
        let mut result = 0
        for i in 0..nargs {
          if i < nlist_len(params) {
            let arg = nlist_get(args, i)
            let param = nlist_get(params, i)
            if continuation_direct_ref(arg, cont, src) == 1 and ty_is_continuation(node_f3(param)) == 1 and continuation_direct_result(body, param, fn_src) == 1 {
              result = 1
            } else { result = result }
          } else { result = result }
        }
        result
      }
    }
  }
}

fn continuation_value_returns_direct_arg(node: i64, cont: i64, src: i64, ft: i64) -> i64 {
  if node == 0 { 0 }
  else {
    match node_tag(node) {
      4 -> continuation_call_returns_direct_arg(node, cont, src, ft)
      36 -> continuation_call_returns_direct_arg(node_f2(node), cont, src, ft)
      37 -> continuation_value_returns_direct_arg(node_f1(node), cont, src, ft)
      _ -> 0
    }
  }
}

fn continuation_tail_call_count(node: i64, cont: i64, src: i64, ft: i64) -> i64 {
  if node == 0 { 0 }
  else {
    match node_tag(node) {
      4 -> continuation_call_matches(node, cont, src) + continuation_direct_ref_count_list(node_f3(node), node_f4(node), cont, src)
      5 -> continuation_tail_call_count(node_f2(node), cont, src, ft) + continuation_tail_call_count(node_f3(node), cont, src, ft)
      6 -> {
        let alias = continuation_alias_from_let(node, cont, src, ft)
        if alias != 0 {
          continuation_tail_call_count(node_f4(node), alias, src, ft) + continuation_tail_call_count(node_f4(node), cont, src, ft)
        } else { continuation_tail_call_count(node_f4(node), cont, src, ft) }
      }
      7 -> continuation_tail_call_count(node_f2(node), cont, src, ft)
      11 -> continuation_tail_call_count(node_f4(node), cont, src, ft)
      15 -> {
        let arms = node_f2(node)
        let n = node_f3(node)
        let mut count = 0
        for i in 0..n {
          count = count + continuation_tail_call_count(node_f2(nlist_get(arms, i)), cont, src, ft)
        }
        count
      }
      37 -> continuation_tail_call_count(node_f1(node), cont, src, ft)
      _ -> 0
    }
  }
}

fn continuation_alias_node(ns: i64, nl: i64) -> i64 {
  node_new(0, ns, nl, 0, 0)
}

fn continuation_alias_from_let(node: i64, cont: i64, src: i64, ft: i64) -> i64 {
  if node_tag(node) == 37 {
    continuation_alias_from_let(node_f1(node), cont, src, ft)
  } else { if node_tag(node) == 6 {
    let value = node_f3(node)
    if node_tag(value) == 2 {
      if continuation_name_matches(cont, src, node_f1(value), node_f2(value)) {
        continuation_alias_node(node_f1(node), node_f2(node))
      } else { 0 }
    } else {
      if continuation_value_returns_direct_arg(value, cont, src, ft) == 1 {
        continuation_alias_node(node_f1(node), node_f2(node))
      } else { 0 }
    }
  } else { 0 } }
}

fn check_continuation_capture(node: i64, cont: i64, src: i64, ft: i64) -> i64 {
  if node == 0 { 0 }
  else {
    match node_tag(node) {
      29 -> {
        0
      }
      3 -> check_continuation_capture(node_f2(node), cont, src, ft) + check_continuation_capture(node_f3(node), cont, src, ft)
      4 -> continuation_capture_list(node_f3(node), node_f4(node), cont, src, ft)
      5 -> check_continuation_capture(node_f1(node), cont, src, ft) + check_continuation_capture(node_f2(node), cont, src, ft) + check_continuation_capture(node_f3(node), cont, src, ft)
      6 -> {
        let alias = continuation_alias_from_let(node, cont, src, ft)
        if alias != 0 {
          check_continuation_capture(node_f4(node), alias, src, ft) + check_continuation_capture(node_f4(node), cont, src, ft)
        } else {
          check_continuation_capture(node_f3(node), cont, src, ft) + check_continuation_capture(node_f4(node), cont, src, ft)
        }
      }
      7 -> check_continuation_capture(node_f1(node), cont, src, ft) + check_continuation_capture(node_f2(node), cont, src, ft)
      10 -> check_continuation_capture(node_f1(node), cont, src, ft) + check_continuation_capture(node_f2(node), cont, src, ft)
      11 -> check_continuation_capture(node_f3(node), cont, src, ft) + check_continuation_capture(node_f4(node), cont, src, ft)
      12 -> check_continuation_capture(node_f3(node), cont, src, ft)
      57 -> check_continuation_capture(node_f1(node), cont, src, ft) + check_continuation_capture(node_f2(node), cont, src, ft)
      13 -> check_continuation_capture(node_f1(node), cont, src, ft)
      14 -> {
        let fields = node_f3(node)
        let nfields = node_f4(node)
        let mut errors = 0
        for ri in 0..nfields {
          errors = errors + check_continuation_capture(node_f3(nlist_get(fields, ri)), cont, src, ft)
        }
        errors
      }
      15 -> {
        let arms = node_f2(node)
        let n = node_f3(node)
        let mut errors = check_continuation_capture(node_f1(node), cont, src, ft)
        for i in 0..n {
          let arm = nlist_get(arms, i)
          let guard = node_f3(arm)
          if guard != 0 { errors = errors + check_continuation_capture(guard, cont, src, ft) } else { errors = errors }
          errors = errors + check_continuation_capture(node_f2(arm), cont, src, ft)
        }
        errors
      }
      22 -> check_continuation_capture(node_f1(node), cont, src, ft)
      25 -> check_continuation_capture(node_f1(node), cont, src, ft)
      26 -> check_continuation_capture(node_f1(node), cont, src, ft)
      32 -> check_continuation_capture(node_f1(node), cont, src, ft) + continuation_capture_list(node_f4(node), nlist_len(node_f4(node)), cont, src, ft)
      33 -> check_continuation_capture(node_f1(node), cont, src, ft)
      35 -> check_continuation_capture(node_f1(node), cont, src, ft)
      36 -> {
        let call_node = node_f2(node)
        continuation_capture_list(node_f3(call_node), node_f4(call_node), cont, src, ft)
      }
      37 -> check_continuation_capture(node_f1(node), cont, src, ft)
      41 -> check_continuation_capture(node_f1(node), cont, src, ft) + continuation_capture_list(node_f3(node), nlist_len(node_f3(node)), cont, src, ft)
      45 -> check_continuation_capture(node_f1(node), cont, src, ft)
      46 -> check_continuation_capture(node_f1(node), cont, src, ft) + check_continuation_capture(node_f2(node), cont, src, ft)
      47 -> check_continuation_capture(node_f3(node), cont, src, ft) + check_continuation_capture(node_f4(node), cont, src, ft)
      48 -> check_continuation_capture(node_f1(node), cont, src, ft)
      49 -> check_continuation_capture(node_f1(node), cont, src, ft)
      52 -> check_continuation_capture(node_f1(node), cont, src, ft) + check_continuation_capture(node_f2(node), cont, src, ft)
      _ -> 0
    }
  }
}

fn continuation_capture_list(list: i64, n: i64, cont: i64, src: i64, ft: i64) -> i64 {
  let mut errors = 0
  for i in 0..n {
    errors = errors + check_continuation_capture(nlist_get(list, i), cont, src, ft)
  }
  errors
}

fn continuation_direct_ref(node: i64, cont: i64, src: i64) -> i64 {
  if node == 0 { 0 }
  else { if node_tag(node) == 2 { continuation_name_matches(cont, src, node_f1(node), node_f2(node)) } else { 0 } }
}

fn check_continuation_escape(node: i64, cont: i64, src: i64, ft: i64) -[Diagnose]> i64 {
  check_continuation_escape_mode(node, cont, src, ft, 0)
}

fn check_continuation_value_escape(node: i64, cont: i64, src: i64, ft: i64) -[Diagnose]> i64 {
  check_continuation_escape_mode(node, cont, src, ft, 1)
}

fn continuation_call_arg_accepts_direct(ft: i64, src: i64, ns: i64, nl: i64, arg_index: i64) -> i64 {
  if (src_eq(src, ns, nl, "continuation_cell_store_i64_raw") == 1 or src_eq(src, ns, nl, "runtime_continuation_cell_store_i64") == 1) and arg_index == 1 { 1 }
  else { if ft == 0 { 0 }
  else { if ftypes_lookup_body(ft, src, ns, nl) == 0 { 0 }
  else {
    let params = ftypes_lookup_params(ft, src, ns, nl)
    if params == 0 { 0 }
    else { if arg_index >= nlist_len(params) { 0 }
    else { ty_is_continuation(node_f3(nlist_get(params, arg_index))) } }
  } } }
}

fn continuation_generic_call_arg_accepts_direct(ft: i64, src: i64, call_node: i64, type_args: i64, arg_index: i64) -> i64 {
  if ft == 0 { 0 }
  else {
    let ns = node_f1(call_node)
    let nl = node_f2(call_node)
    if ftypes_lookup_body(ft, src, ns, nl) == 0 { 0 }
    else {
      let tparams = ftypes_lookup_tparams(ft, src, ns, nl)
      let params = ftypes_lookup_params(ft, src, ns, nl)
      if tparams == 0 or params == 0 { 0 }
      else { if nlist_len(tparams) != nlist_len(type_args) { 0 }
      else { if arg_index >= nlist_len(params) { 0 }
      else {
        ty_is_continuation(node_f3(nlist_get(params, arg_index)))
      } } }
    }
  }
}

fn continuation_escape_call_args_mode(call_node: i64, cont: i64, src: i64, ft: i64, allow_direct_arg: i64) -[Diagnose]> i64 {
  let args = node_f3(call_node)
  let nargs = node_f4(call_node)
  let mut errors = 0
  for i in 0..nargs {
    let arg = nlist_get(args, i)
    let allow_arg = allow_direct_arg == 1 and continuation_call_arg_accepts_direct(ft, src, node_f1(call_node), node_f2(call_node), i) == 1
    errors = errors + check_continuation_escape_arg_mode(arg, cont, src, ft, allow_arg)
  }
  errors
}

fn continuation_escape_generic_call_args_mode(node: i64, cont: i64, src: i64, ft: i64, allow_direct_arg: i64) -[Diagnose]> i64 {
  let type_args = node_f1(node)
  let call_node = node_f2(node)
  let args = node_f3(call_node)
  let nargs = node_f4(call_node)
  let mut errors = 0
  for i in 0..nargs {
    let arg = nlist_get(args, i)
    let allow_arg = allow_direct_arg == 1 and continuation_generic_call_arg_accepts_direct(ft, src, call_node, type_args, i) == 1
    errors = errors + check_continuation_escape_arg_mode(arg, cont, src, ft, allow_arg)
  }
  errors
}

fn check_continuation_escape_mode(node: i64, cont: i64, src: i64, ft: i64, allow_direct_arg: i64) -[Diagnose]> i64 {
  if node == 0 { 0 }
  else {
    match node_tag(node) {
      2 -> {
        if continuation_name_matches(cont, src, node_f1(node), node_f2(node)) {
          typeck_error_maybe(src, node_f1(node), "type error: continuation cannot escape")
          1
        } else { 0 }
      }
      3 -> check_continuation_escape_mode(node_f2(node), cont, src, ft, allow_direct_arg) + check_continuation_escape_mode(node_f3(node), cont, src, ft, allow_direct_arg)
      4 -> continuation_escape_call_args_mode(node, cont, src, ft, allow_direct_arg)
      5 -> check_continuation_escape_mode(node_f1(node), cont, src, ft, allow_direct_arg) + check_continuation_escape_mode(node_f2(node), cont, src, ft, allow_direct_arg) + check_continuation_escape_mode(node_f3(node), cont, src, ft, allow_direct_arg)
      6 -> {
        let alias = continuation_alias_from_let(node, cont, src, ft)
        if alias != 0 {
          check_continuation_escape_mode(node_f4(node), alias, src, ft, allow_direct_arg) + check_continuation_escape_mode(node_f4(node), cont, src, ft, allow_direct_arg)
        } else {
          check_continuation_escape_mode(node_f3(node), cont, src, ft, allow_direct_arg) + check_continuation_escape_mode(node_f4(node), cont, src, ft, allow_direct_arg)
        }
      }
      7 -> check_continuation_escape_mode(node_f1(node), cont, src, ft, allow_direct_arg) + check_continuation_escape_mode(node_f2(node), cont, src, ft, allow_direct_arg)
      10 -> check_continuation_escape_mode(node_f1(node), cont, src, ft, allow_direct_arg) + check_continuation_escape_mode(node_f2(node), cont, src, ft, allow_direct_arg)
      11 -> check_continuation_escape_mode(node_f3(node), cont, src, ft, allow_direct_arg) + check_continuation_escape_mode(node_f4(node), cont, src, ft, allow_direct_arg)
      12 -> check_continuation_escape_mode(node_f3(node), cont, src, ft, allow_direct_arg)
      57 -> check_continuation_escape_mode(node_f1(node), cont, src, ft, allow_direct_arg) + check_continuation_escape_mode(node_f2(node), cont, src, ft, allow_direct_arg)
      13 -> check_continuation_escape_mode(node_f1(node), cont, src, ft, allow_direct_arg)
      14 -> {
        let fields = node_f3(node)
        let nfields = node_f4(node)
        let mut errors = 0
        for ri in 0..nfields {
          errors = errors + check_continuation_escape_mode(node_f3(nlist_get(fields, ri)), cont, src, ft, 0)
        }
        errors
      }
      15 -> {
        let arms = node_f2(node)
        let n = node_f3(node)
        let mut errors = check_continuation_escape_mode(node_f1(node), cont, src, ft, allow_direct_arg)
        for i in 0..n {
          let arm = nlist_get(arms, i)
          let guard = node_f3(arm)
          if guard != 0 { errors = errors + check_continuation_escape_mode(guard, cont, src, ft, allow_direct_arg) } else { errors = errors }
          errors = errors + check_continuation_escape_mode(node_f2(arm), cont, src, ft, allow_direct_arg)
        }
        errors
      }
      22 -> check_continuation_escape_mode(node_f1(node), cont, src, ft, allow_direct_arg)
      25 -> check_continuation_escape_mode(node_f1(node), cont, src, ft, allow_direct_arg)
      26 -> check_continuation_escape_mode(node_f1(node), cont, src, ft, allow_direct_arg)
      29 -> 0
      32 -> check_continuation_escape_mode(node_f1(node), cont, src, ft, allow_direct_arg) + continuation_escape_list_mode(node_f4(node), nlist_len(node_f4(node)), cont, src, ft, 0)
      33 -> check_continuation_escape_mode(node_f1(node), cont, src, ft, allow_direct_arg)
      35 -> check_continuation_escape_mode(node_f1(node), cont, src, ft, allow_direct_arg)
      36 -> {
        continuation_escape_generic_call_args_mode(node, cont, src, ft, allow_direct_arg)
      }
      37 -> check_continuation_escape_mode(node_f1(node), cont, src, ft, allow_direct_arg)
      41 -> check_continuation_escape_mode(node_f1(node), cont, src, ft, allow_direct_arg) + continuation_escape_list_mode(node_f3(node), nlist_len(node_f3(node)), cont, src, ft, 0)
      45 -> check_continuation_escape_mode(node_f1(node), cont, src, ft, allow_direct_arg)
      46 -> check_continuation_escape_mode(node_f1(node), cont, src, ft, allow_direct_arg) + check_continuation_escape_mode(node_f2(node), cont, src, ft, allow_direct_arg)
      47 -> check_continuation_escape_mode(node_f3(node), cont, src, ft, allow_direct_arg) + check_continuation_escape_mode(node_f4(node), cont, src, ft, allow_direct_arg)
      48 -> check_continuation_escape_mode(node_f1(node), cont, src, ft, allow_direct_arg)
      49 -> check_continuation_escape_mode(node_f1(node), cont, src, ft, allow_direct_arg)
      52 -> check_continuation_escape_mode(node_f1(node), cont, src, ft, allow_direct_arg) + check_continuation_escape_mode(node_f2(node), cont, src, ft, allow_direct_arg)
      _ -> 0
    }
  }
}

fn check_continuation_escape_arg_mode(node: i64, cont: i64, src: i64, ft: i64, allow_direct_arg: i64) -[Diagnose]> i64 {
  if allow_direct_arg == 1 and continuation_direct_ref(node, cont, src) == 1 { 0 }
  else { check_continuation_escape_mode(node, cont, src, ft, 0) }
}

fn continuation_escape_list_mode(list: i64, n: i64, cont: i64, src: i64, ft: i64, allow_direct_arg: i64) -[Diagnose]> i64 {
  let mut errors = 0
  for i in 0..n {
    errors = errors + check_continuation_escape_arg_mode(nlist_get(list, i), cont, src, ft, allow_direct_arg)
  }
  errors
}

fn continuation_escape_list(list: i64, n: i64, cont: i64, src: i64, ft: i64) -[Diagnose]> i64 {
  let mut errors = 0
  for i in 0..n {
    errors = errors + check_continuation_escape(nlist_get(list, i), cont, src, ft)
  }
  errors
}

fn continuation_lambda_alias_from_let(node: i64, cont: i64, src: i64) -> i64 {
  if node_tag(node) == 37 {
    continuation_lambda_alias_from_let(node_f1(node), cont, src)
  } else { if node_tag(node) == 6 {
    let value = node_f3(node)
    if node_tag(value) == 29 {
      if continuation_ref_count(node_f2(value), cont, src) > 0 {
        continuation_alias_node(node_f1(node), node_f2(node))
      } else { 0 }
    } else { 0 }
  } else { 0 } }
}

fn continuation_lambda_usage_list(list: i64, n: i64, cont: i64, src: i64, allow_non_tail: i64, ft: i64) -[Diagnose]> i64 {
  let mut errors = 0
  for i in 0..n {
    errors = errors + check_continuation_lambda_usage(nlist_get(list, i), cont, src, allow_non_tail, ft)
  }
  errors
}

fn check_continuation_lambda_alias_usage(body: i64, alias: i64, src: i64, allow_non_tail: i64, ft: i64) -[Diagnose]> i64 {
  let calls = continuation_call_count(body, alias, src, ft)
  let tail_calls = continuation_tail_call_count(body, alias, src, ft)
  let mut errors = check_continuation_escape(body, alias, src, ft) + check_continuation_lambda_usage(body, alias, src, allow_non_tail, ft)
  if calls > 1 {
    typeck_error_maybe(src, node_f1(alias), "type error: continuation used more than once")
    errors = errors + 1
  } else { errors = errors }
  if allow_non_tail == 0 and calls > tail_calls {
    typeck_error_maybe(src, node_f1(alias), "type error: continuation call must be tail position")
    errors = errors + 1
  } else { errors = errors }
  errors
}

fn check_continuation_lambda_body_usage(lambda: i64, cont: i64, src: i64, allow_non_tail: i64, ft: i64) -[Diagnose]> i64 {
  let body = node_f2(lambda)
  let calls = continuation_call_count(body, cont, src, ft)
  let tail_calls = continuation_tail_call_count(body, cont, src, ft)
  let mut errors = check_continuation_value_escape(body, cont, src, ft) + check_continuation_lambda_usage(body, cont, src, allow_non_tail, ft)
  if calls > 1 {
    typeck_error_maybe(src, node_f1(cont), "type error: continuation used more than once")
    errors = errors + 1
  } else { errors = errors }
  if allow_non_tail == 0 and calls > tail_calls {
    typeck_error_maybe(src, node_f1(cont), "type error: continuation call must be tail position")
    errors = errors + 1
  } else { errors = errors }
  errors
}

fn check_continuation_lambda_usage(node: i64, cont: i64, src: i64, allow_non_tail: i64, ft: i64) -[Diagnose]> i64 {
  if node == 0 { 0 }
  else {
    match node_tag(node) {
      29 -> {
        if continuation_ref_count(node_f2(node), cont, src) > 0 {
          typeck_error_maybe(src, node_f1(cont), "type error: continuation-capturing closure must stay local")
          1
        } else { 0 }
      }
      3 -> check_continuation_lambda_usage(node_f2(node), cont, src, allow_non_tail, ft) + check_continuation_lambda_usage(node_f3(node), cont, src, allow_non_tail, ft)
      4 -> continuation_lambda_usage_list(node_f3(node), node_f4(node), cont, src, allow_non_tail, ft)
      5 -> check_continuation_lambda_usage(node_f1(node), cont, src, allow_non_tail, ft) + check_continuation_lambda_usage(node_f2(node), cont, src, allow_non_tail, ft) + check_continuation_lambda_usage(node_f3(node), cont, src, allow_non_tail, ft)
      6 -> {
        let alias = continuation_alias_from_let(node, cont, src, ft)
        if alias != 0 {
          check_continuation_lambda_usage(node_f4(node), alias, src, allow_non_tail, ft) + check_continuation_lambda_usage(node_f4(node), cont, src, allow_non_tail, ft)
        } else {
          let lambda_alias = continuation_lambda_alias_from_let(node, cont, src)
          if lambda_alias != 0 {
            check_continuation_lambda_body_usage(node_f3(node), cont, src, allow_non_tail, ft) + check_continuation_lambda_alias_usage(node_f4(node), lambda_alias, src, allow_non_tail, ft) + check_continuation_lambda_usage(node_f4(node), cont, src, allow_non_tail, ft)
          } else {
            check_continuation_lambda_usage(node_f3(node), cont, src, allow_non_tail, ft) + check_continuation_lambda_usage(node_f4(node), cont, src, allow_non_tail, ft)
          }
        }
      }
      7 -> check_continuation_lambda_usage(node_f1(node), cont, src, allow_non_tail, ft) + check_continuation_lambda_usage(node_f2(node), cont, src, allow_non_tail, ft)
      10 -> check_continuation_lambda_usage(node_f1(node), cont, src, allow_non_tail, ft) + check_continuation_lambda_usage(node_f2(node), cont, src, allow_non_tail, ft)
      11 -> check_continuation_lambda_usage(node_f3(node), cont, src, allow_non_tail, ft) + check_continuation_lambda_usage(node_f4(node), cont, src, allow_non_tail, ft)
      12 -> check_continuation_lambda_usage(node_f3(node), cont, src, allow_non_tail, ft)
      57 -> check_continuation_lambda_usage(node_f1(node), cont, src, allow_non_tail, ft) + check_continuation_lambda_usage(node_f2(node), cont, src, allow_non_tail, ft)
      13 -> check_continuation_lambda_usage(node_f1(node), cont, src, allow_non_tail, ft)
      14 -> {
        let fields = node_f3(node)
        let nfields = node_f4(node)
        let mut errors = 0
        for ri in 0..nfields {
          errors = errors + check_continuation_lambda_usage(node_f3(nlist_get(fields, ri)), cont, src, allow_non_tail, ft)
        }
        errors
      }
      15 -> {
        let arms = node_f2(node)
        let n = node_f3(node)
        let mut errors = check_continuation_lambda_usage(node_f1(node), cont, src, allow_non_tail, ft)
        for i in 0..n {
          let arm = nlist_get(arms, i)
          let guard = node_f3(arm)
          if guard != 0 { errors = errors + check_continuation_lambda_usage(guard, cont, src, allow_non_tail, ft) } else { errors = errors }
          errors = errors + check_continuation_lambda_usage(node_f2(arm), cont, src, allow_non_tail, ft)
        }
        errors
      }
      22 -> check_continuation_lambda_usage(node_f1(node), cont, src, allow_non_tail, ft)
      25 -> check_continuation_lambda_usage(node_f1(node), cont, src, allow_non_tail, ft)
      26 -> check_continuation_lambda_usage(node_f1(node), cont, src, allow_non_tail, ft)
      32 -> check_continuation_lambda_usage(node_f1(node), cont, src, allow_non_tail, ft) + continuation_lambda_usage_list(node_f4(node), nlist_len(node_f4(node)), cont, src, allow_non_tail, ft)
      33 -> check_continuation_lambda_usage(node_f1(node), cont, src, allow_non_tail, ft)
      35 -> check_continuation_lambda_usage(node_f1(node), cont, src, allow_non_tail, ft)
      36 -> {
        let call_node = node_f2(node)
        continuation_lambda_usage_list(node_f3(call_node), node_f4(call_node), cont, src, allow_non_tail, ft)
      }
      37 -> check_continuation_lambda_usage(node_f1(node), cont, src, allow_non_tail, ft)
      41 -> check_continuation_lambda_usage(node_f1(node), cont, src, allow_non_tail, ft) + continuation_lambda_usage_list(node_f3(node), nlist_len(node_f3(node)), cont, src, allow_non_tail, ft)
      45 -> check_continuation_lambda_usage(node_f1(node), cont, src, allow_non_tail, ft)
      46 -> check_continuation_lambda_usage(node_f1(node), cont, src, allow_non_tail, ft) + check_continuation_lambda_usage(node_f2(node), cont, src, allow_non_tail, ft)
      47 -> check_continuation_lambda_usage(node_f3(node), cont, src, allow_non_tail, ft) + check_continuation_lambda_usage(node_f4(node), cont, src, allow_non_tail, ft)
      48 -> check_continuation_lambda_usage(node_f1(node), cont, src, allow_non_tail, ft)
      49 -> check_continuation_lambda_usage(node_f1(node), cont, src, allow_non_tail, ft)
      52 -> check_continuation_lambda_usage(node_f1(node), cont, src, allow_non_tail, ft) + check_continuation_lambda_usage(node_f2(node), cont, src, allow_non_tail, ft)
      _ -> 0
    }
  }
}

fn check_continuation_usage(body: i64, cont: i64, src: i64, allow_non_tail: i64, ft: i64) -[Diagnose]> i64 {
  check_continuation_usage_with_result(body, cont, src, allow_non_tail, 0, ft)
}

fn check_continuation_usage_with_result(body: i64, cont: i64, src: i64, allow_non_tail: i64, allow_direct_result: i64, ft: i64) -[Diagnose]> i64 {
  if cont == 0 { 0 }
  else {
    let result_use = if allow_direct_result == 1 { continuation_direct_result(body, cont, src) } else { 0 }
    let calls = continuation_call_count(body, cont, src, ft) + result_use
    let tail_calls = continuation_tail_call_count(body, cont, src, ft)
    let escape_errors = if result_use == 1 { 0 } else { check_continuation_value_escape(body, cont, src, ft) }
    let mut errors = check_continuation_capture(body, cont, src, ft) + escape_errors + check_continuation_lambda_usage(body, cont, src, allow_non_tail, ft)
    if calls > 1 {
      typeck_error_maybe(src, node_f1(cont), "type error: continuation used more than once")
      errors = errors + 1
    } else { errors = errors }
    if allow_non_tail == 0 and calls > tail_calls {
      typeck_error_maybe(src, node_f1(cont), "type error: continuation call must be tail position")
      errors = errors + 1
    } else {
      errors = errors
    }
    errors
  }
}

fn check_continuation_param_usage(body: i64, params: i64, nparams: i64, src: i64) -[Diagnose]> i64 {
  check_continuation_param_usage_with_result(body, params, nparams, ty_any(), src, 0)
}

fn check_continuation_param_usage_with_result(body: i64, params: i64, nparams: i64, ret_ty: i64, src: i64, ft: i64) -[Diagnose]> i64 {
  let mut errors = 0
  let allow_direct_result = ty_is_continuation(ret_ty)
  for i in 0..nparams {
    let p = nlist_get(params, i)
    if ty_is_continuation(node_f3(p)) == 1 {
      errors = errors + check_continuation_usage_with_result(body, p, src, 1, allow_direct_result, ft)
    } else { errors = errors }
  }
  errors
}

-- Synthesize the return type of an effect perform: EffectName.op(args)
-- Looks up the effect in ttable (kind=2) and finds the operation's return type.
fn synth_effect_perform(node: i64, src: i64, tt: i64) -> i64 {
  let lhs = node_f1(node)
  let op_hash = effect_name_hash(src, node_f2(node), node_f3(node))
  let eff_ns = node_f1(lhs)
  let eff_nl = node_f2(lhs)
  -- Look up effect in ttable
  if tt == 0 { ty_any() }
  else {
    let entry = ttable_lookup(tt, src, eff_ns, eff_nl)
    if entry == 0 { ty_any() }
    else {
      let kind = mem_load64_at(entry, 16)
      if kind != 2 { ty_any() }
      else {
        -- Found effect. Search its operations for matching op_hash.
        let entry_src = mem_load64_at(entry, 48)
        let nops = mem_load64_at(entry, 24)
        let ops = mem_load64_at(entry, 32)
        let mut i = 0
        let mut ret = ty_any()
        while i < nops {
          let op = nlist_get(ops, i)
          let op_name_hash = effect_name_hash(entry_src, node_f1(op), node_f2(op))
          if op_name_hash == op_hash {
            let op_ret = effect_op_ret_type(op)
            ret = if op_ret != 0 { op_ret } else { ty_any() }
            i = nops
          } else { i = i + 1 }
        }
        ret
      }
    }
  }
}

fn effect_sig_one(eff_hash: i64) -> i64 {
  let effects = nlist_new()
  nlist_add(effects, ty_effect_app(eff_hash))
  ty_effect_sig(effects)
}

fn effect_list_add_hash(effects: i64, eff_hash: i64) -> i64 {
  if eff_hash == 0 { 0 }
  else {
    let mut found = false
    let mut i = 0
    while i < nlist_len(effects) {
      let app = nlist_get(effects, i)
      if ty_f1(app) == eff_hash {
        found = true
        i = nlist_len(effects)
      } else { i = i + 1 }
    }
    if not found { nlist_add(effects, ty_effect_app(eff_hash)) } else { 0 }
  }
}

fn effect_list_merge_sig(effects: i64, eff: i64) -> i64 {
  if eff == 0 { 0 }
  else {
    if ty_tag(eff) != 10 { 0 }
    else {
      let apps = ty_f1(eff)
      let n = nlist_len(apps)
      for i in 0..n {
        effect_list_add_hash(effects, ty_f1(nlist_get(apps, i)))
      }
      0
    }
  }
}

fn effect_list_merge_except_hash(effects: i64, apps: i64, excluded_hash: i64) -> i64 {
  let n = nlist_len(apps)
  for i in 0..n {
    let eff_hash = ty_f1(nlist_get(apps, i))
    if eff_hash != excluded_hash { effect_list_add_hash(effects, eff_hash) } else { 0 }
  }
  0
}

fn infer_expr_effects(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let effects = nlist_new()
  collect_expr_effects(node, env, ft, src, tt, effects)
  ty_effect_sig(effects)
}

fn collect_call_effects(node: i64, env: i64, ft: i64, src: i64, effects: i64) -> i64 {
  let ns = node_f1(node)
  let nl = node_f2(node)
  let intrinsic_flags = intrinsic_semantic_effect_flags(src, ns, nl)
  if intrinsic_flags != 0 {
    if intrinsic_flags % 2 == 1 { effect_list_add_hash(effects, effect_hash_alloc()) } else { 0 }
    if intrinsic_flags / 2 % 2 == 1 { effect_list_add_hash(effects, effect_hash_unsafe()) } else { 0 }
  } else { if is_unsafe_raw_call_name(src, ns, nl) {
    effect_list_add_hash(effects, effect_hash_unsafe())
  } else {
    let local_ty = tenv_lookup(env, src, ns, nl)
    if local_ty != 0 {
      if ty_tag(local_ty) == 6 { effect_list_merge_sig(effects, ty_f3(local_ty)) }
      else { if ty_tag(local_ty) == 14 { 0 }
      else { effect_list_merge_sig(effects, ftypes_lookup_effects(ft, src, ns, nl)) }
      }
    } else { effect_list_merge_sig(effects, ftypes_lookup_effects(ft, src, ns, nl)) }
  } }
}

fn collect_expr_effects_list(list: i64, n: i64, env: i64, ft: i64, src: i64, tt: i64, effects: i64) -> i64 {
  for i in 0..n {
    collect_expr_effects(nlist_get(list, i), env, ft, src, tt, effects)
  }
  0
}

fn collect_expr_effects(node: i64, env: i64, ft: i64, src: i64, tt: i64, effects: i64) -> i64 {
  if node == 0 { 0 }
  else {
    let tag = node_tag(node)
    match tag {
      3 -> {
        collect_expr_effects(node_f2(node), env, ft, src, tt, effects)
        collect_expr_effects(node_f3(node), env, ft, src, tt, effects)
      }
      4 -> {
        collect_call_effects(node, env, ft, src, effects)
        collect_expr_effects_list(node_f3(node), node_f4(node), env, ft, src, tt, effects)
      }
      5 -> {
        collect_expr_effects(node_f1(node), env, ft, src, tt, effects)
        collect_expr_effects(node_f2(node), env, ft, src, tt, effects)
        collect_expr_effects(node_f3(node), env, ft, src, tt, effects)
      }
      6 -> {
        let val = node_f3(node)
        collect_expr_effects(val, env, ft, src, tt, effects)
        let val_ty = synth(val, env, ft, src, tt)
        let new_env = tenv_bind(env, src, node_f1(node), node_f2(node), val_ty)
        collect_expr_effects(node_f4(node), new_env, ft, src, tt, effects)
      }
      7 -> {
        collect_expr_effects(node_f1(node), env, ft, src, tt, effects)
        collect_expr_effects(node_f2(node), env, ft, src, tt, effects)
      }
      10 -> {
        collect_expr_effects(node_f1(node), env, ft, src, tt, effects)
        collect_expr_effects(node_f2(node), env, ft, src, tt, effects)
      }
      11 -> {
        let val = node_f3(node)
        collect_expr_effects(val, env, ft, src, tt, effects)
        let val_ty = synth(val, env, ft, src, tt)
        let new_env = tenv_bind_mut(env, src, node_f1(node), node_f2(node), val_ty)
        collect_expr_effects(node_f4(node), new_env, ft, src, tt, effects)
      }
      12 -> collect_expr_effects(node_f3(node), env, ft, src, tt, effects)
      57 -> {
        effect_list_add_hash(effects, effect_hash_unsafe())
        collect_expr_effects(node_f1(node), env, ft, src, tt, effects)
        collect_expr_effects(node_f2(node), env, ft, src, tt, effects)
      }
      13 -> collect_expr_effects(node_f1(node), env, ft, src, tt, effects)
      14 -> {
        let fields = node_f3(node)
        let nfields = node_f4(node)
        for ri in 0..nfields {
          collect_expr_effects(node_f3(nlist_get(fields, ri)), env, ft, src, tt, effects)
        }
        0
      }
      15 -> {
        collect_expr_effects(node_f1(node), env, ft, src, tt, effects)
        let scr_ty = synth(node_f1(node), env, ft, src, tt)
        let arms = node_f2(node)
        let narms = node_f3(node)
        for mi in 0..narms {
          let arm = nlist_get(arms, mi)
          let arm_env = bind_pattern(node_f1(arm), env, src, scr_ty, tt)
          let guard = node_f3(arm)
          if guard != 0 { collect_expr_effects(guard, arm_env, ft, src, tt, effects) } else { 0 }
          collect_expr_effects(node_f2(arm), arm_env, ft, src, tt, effects)
        }
        0
      }
      22 -> collect_expr_effects(node_f1(node), env, ft, src, tt, effects)
      25 -> collect_expr_effects(node_f1(node), env, ft, src, tt, effects)
      29 -> 0
      32 -> {
        let lhs = node_f1(node)
        if is_effect_ident(lhs, src, tt) {
          effect_list_add_hash(effects, effect_name_hash(src, node_f1(lhs), node_f2(lhs)))
        } else {
          collect_expr_effects(lhs, env, ft, src, tt, effects)
        }
        collect_expr_effects_list(node_f4(node), nlist_len(node_f4(node)), env, ft, src, tt, effects)
      }
      33 -> {
        let clauses = node_f2(node)
        let nclauses = node_f3(node)
        let handled_eff_hash = if nclauses > 0 {
          let cn = node_f1(nlist_get(clauses, 0))
          effect_name_hash(src, node_f1(cn), node_f2(cn))
        } else { 0 }
        let body_effects = nlist_new()
        collect_expr_effects(node_f1(node), env, ft, src, tt, body_effects)
        effect_list_merge_except_hash(effects, body_effects, handled_eff_hash)
        for ci in 0..nclauses {
          collect_expr_effects(node_f3(nlist_get(clauses, ci)), env, ft, src, tt, effects)
        }
        0
      }
      35 -> collect_expr_effects(node_f1(node), env, ft, src, tt, effects)
      36 -> {
        let call_node = node_f2(node)
        collect_call_effects(call_node, env, ft, src, effects)
        collect_expr_effects_list(node_f3(call_node), node_f4(call_node), env, ft, src, tt, effects)
      }
      37 -> collect_expr_effects(node_f1(node), env, ft, src, tt, effects)
      41 -> {
        effect_list_merge_sig(effects, ttable_lookup_method_effects(tt, node_f4(node), node_f2(node)))
        collect_expr_effects(node_f1(node), env, ft, src, tt, effects)
        collect_expr_effects_list(node_f3(node), nlist_len(node_f3(node)), env, ft, src, tt, effects)
      }
      45 -> {
        effect_list_add_hash(effects, 6384065697)
        collect_expr_effects(node_f1(node), env, ft, src, tt, effects)
      }
      46 -> {
        collect_expr_effects(node_f1(node), env, ft, src, tt, effects)
        collect_expr_effects(node_f2(node), env, ft, src, tt, effects)
      }
      47 -> {
        collect_expr_effects(node_f3(node), env, ft, src, tt, effects)
        let loop_env = tenv_bind(env, src, node_f1(node), node_f2(node), for_iter_item_type(node, env, ft, src, tt))
        collect_expr_effects(node_f4(node), loop_env, ft, src, tt, effects)
      }
      48 -> {
        effect_list_add_hash(effects, 210682486643)
        collect_expr_effects(node_f1(node), env, ft, src, tt, effects)
      }
      49 -> collect_expr_effects(node_f1(node), env, ft, src, tt, effects)
      52 -> {
        collect_expr_effects(node_f1(node), env, ft, src, tt, effects)
        collect_expr_effects(node_f2(node), env, ft, src, tt, effects)
      }
      55 -> {
        effect_list_add_hash(effects, effect_hash_unsafe())
        collect_expr_effects(node_f2(node), env, ft, src, tt, effects)
      }
      56 -> {
        effect_list_add_hash(effects, effect_hash_unsafe())
        collect_expr_effects(node_f1(node), env, ft, src, tt, effects)
      }
      _ -> 0
    }
  }
}

fn check_effect_hash_available(eff_hash: i64, src: i64, pos: i64, caller_eff: i64) -[Diagnose]> i64 {
  if caller_eff == 0 { 0 }
  else {
    if effect_is_subset(effect_sig_one(eff_hash), caller_eff) { 0 }
    else {
      typeck_error_maybe(src, pos, "type error: effect not available in caller")
      1
    }
  }
}

-- Qualified variant construction (Type.Variant / Type.Variant(args)) is
-- not a language form — kernel.md §3.2: constructors are bare values.
-- Detect a bare variant-type-name receiver so the checker rejects the
-- shape with a targeted diagnostic instead of letting it fall through
-- to the dynamic-perform / unknown-identifier paths (which used to
-- typecheck clean and BRK at runtime).
fn ident_names_variant_type(node: i64, env: i64, src: i64, tt: i64) -> i64 {
  if node_tag(node) != 2 { 0 }
  else { if tenv_lookup(env, src, node_f1(node), node_f2(node)) != 0 { 0 }
  else {
    let entry = ttable_lookup(tt, src, node_f1(node), node_f2(node))
    if entry == 0 { 0 }
    else { if mem_load64_at(entry + 16, 0) == 1 { 1 } else { 0 } }
  } }
}

fn check_effect_perform_available(node: i64, src: i64, caller_eff: i64, tt: i64) -[Diagnose]> i64 {
  let lhs = node_f1(node)
  if is_effect_ident(lhs, src, tt) {
    let eff_hash = effect_name_hash(src, node_f1(lhs), node_f2(lhs))
    check_effect_hash_available(eff_hash, src, node_f1(lhs), caller_eff)
  } else { 0 }
}

fn lookup_effect_perform_op(node: i64, src: i64, tt: i64) -> i64 {
  let lhs = node_f1(node)
  if tt == 0 { 0 }
  else {
    if is_effect_ident(lhs, src, tt) {
      let entry = ttable_lookup(tt, src, node_f1(lhs), node_f2(lhs))
      if entry == 0 { 0 }
      else {
        let entry_src = mem_load64_at(entry, 48)
        let op_hash = effect_name_hash(src, node_f2(node), node_f3(node))
        let nops = mem_load64_at(entry, 24)
        let ops = mem_load64_at(entry, 32)
        let mut i = 0
        let mut result = 0
        while i < nops {
          let op = nlist_get(ops, i)
          let op_name_hash = effect_name_hash(entry_src, node_f1(op), node_f2(op))
          if op_name_hash == op_hash {
            result = op
            i = nops
          } else { i = i + 1 }
        }
        result
      }
    } else { 0 }
  }
}

fn check_effect_perform_args(node: i64, env: i64, ft: i64, src: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let op = lookup_effect_perform_op(node, src, tt)
  if op == 0 { 0 }
  else {
    let params = node_f3(op)
    let args = node_f4(node)
    let nparams = nlist_len(params)
    let nargs = nlist_len(args)
    let mut errors = 0
    errors = errors + check_arity(nparams, nargs, src, node_f2(node))
    let ncheck = if nargs < nparams { nargs } else { nparams }
    for i in 0..ncheck {
      let param = nlist_get(params, i)
      let param_ty = node_f3(param)
      if param_ty != 0 {
        errors = errors + check_arg_against_param(nlist_get(args, i), param_ty, env, ft, src, tt, node_f2(node))
      } else { errors = errors }
    }
    errors
  }
}

fn check_arity(expected: i64, actual: i64, src: i64, pos: i64) -[Diagnose]> i64 {
  if expected == actual { 0 }
  else {
    typeck_error_maybe(src, pos, "type error: arity mismatch")
    1
  }
}

fn bind_capture_pattern(pat: i64, local_env: i64, src: i64) -> i64 {
  let tag = node_tag(pat)
  match tag {
    18 -> tenv_bind(local_env, src, node_f1(pat), node_f2(pat), ty_any())
    20 -> {
      let b_ns = node_f3(pat)
      let b_nl = node_f4(pat)
      if b_nl > 0 {
        tenv_bind(local_env, src, b_ns, b_nl, ty_any())
      } else { if b_nl < 0 {
        let bindings = b_ns
        let nb = 0 - b_nl
        let mut result = local_env
        for i in 0..nb {
          let b = nlist_get(bindings, i)
          if node_tag(b) == 18 {
            result = tenv_bind(result, src, node_f1(b), node_f2(b), ty_any())
          } else { result = result }
        }
        result
      } else { local_env } }
    }
    _ -> local_env
  }
}

fn bind_capture_params(params: i64, nparams: i64, local_env: i64, src: i64) -> i64 {
  let mut result = local_env
  for i in 0..nparams {
    let p = nlist_get(params, i)
    result = tenv_bind(result, src, node_f1(p), node_f2(p), ty_any())
  }
  result
}

fn check_mut_capture_name(ns: i64, nl: i64, outer_env: i64, local_env: i64, src: i64) -[Diagnose]> i64 {
  if tenv_lookup(local_env, src, ns, nl) != 0 { 0 }
  else {
    if tenv_lookup_mutable(outer_env, src, ns, nl) == 1 {
      typeck_error_maybe(src, ns, "type error: cannot capture mut binding")
      1
    } else { 0 }
  }
}

fn check_mut_capture_ident(node: i64, outer_env: i64, local_env: i64, src: i64) -[Diagnose]> i64 {
  check_mut_capture_name(node_f1(node), node_f2(node), outer_env, local_env, src)
}

fn check_mut_captures_list(list: i64, n: i64, outer_env: i64, local_env: i64, src: i64) -[Diagnose]> i64 {
  let mut errors = 0
  for i in 0..n {
    errors = errors + check_mut_captures(nlist_get(list, i), outer_env, local_env, src)
  }
  errors
}

fn check_mut_captures(node: i64, outer_env: i64, local_env: i64, src: i64) -[Diagnose]> i64 {
  if node == 0 { 0 }
  else {
    let tag = node_tag(node)
    match tag {
      2 -> check_mut_capture_ident(node, outer_env, local_env, src)
      3 -> check_mut_captures(node_f2(node), outer_env, local_env, src) + check_mut_captures(node_f3(node), outer_env, local_env, src)
      4 -> check_mut_capture_name(node_f1(node), node_f2(node), outer_env, local_env, src) + check_mut_captures_list(node_f3(node), node_f4(node), outer_env, local_env, src)
      5 -> check_mut_captures(node_f1(node), outer_env, local_env, src) + check_mut_captures(node_f2(node), outer_env, local_env, src) + check_mut_captures(node_f3(node), outer_env, local_env, src)
      6 -> {
        let val = node_f3(node)
        let body = node_f4(node)
        let new_local = tenv_bind(local_env, src, node_f1(node), node_f2(node), ty_any())
        check_mut_captures(val, outer_env, local_env, src) + check_mut_captures(body, outer_env, new_local, src)
      }
      7 -> check_mut_captures(node_f1(node), outer_env, local_env, src) + check_mut_captures(node_f2(node), outer_env, local_env, src)
      10 -> check_mut_captures(node_f1(node), outer_env, local_env, src) + check_mut_captures(node_f2(node), outer_env, local_env, src)
      11 -> {
        let val = node_f3(node)
        let body = node_f4(node)
        let new_local = tenv_bind(local_env, src, node_f1(node), node_f2(node), ty_any())
        check_mut_captures(val, outer_env, local_env, src) + check_mut_captures(body, outer_env, new_local, src)
      }
      12 -> check_mut_capture_name(node_f1(node), node_f2(node), outer_env, local_env, src) + check_mut_captures(node_f3(node), outer_env, local_env, src)
      57 -> check_mut_captures(node_f1(node), outer_env, local_env, src) + check_mut_captures(node_f2(node), outer_env, local_env, src)
      13 -> check_mut_captures(node_f1(node), outer_env, local_env, src)
      14 -> {
        let fields = node_f3(node)
        let nfields = node_f4(node)
        let mut errors = 0
        for i in 0..nfields {
          errors = errors + check_mut_captures(node_f3(nlist_get(fields, i)), outer_env, local_env, src)
        }
        errors
      }
      15 -> {
        let scrutinee = node_f1(node)
        let arms = node_f2(node)
        let n = node_f3(node)
        let mut errors = check_mut_captures(scrutinee, outer_env, local_env, src)
        for i in 0..n {
          let arm = nlist_get(arms, i)
          let arm_local = bind_capture_pattern(node_f1(arm), local_env, src)
          let guard = node_f3(arm)
          if guard != 0 { errors = errors + check_mut_captures(guard, outer_env, arm_local, src) } else { errors = errors }
          errors = errors + check_mut_captures(node_f2(arm), outer_env, arm_local, src)
        }
        errors
      }
      22 -> check_mut_captures(node_f1(node), outer_env, local_env, src)
      25 -> check_mut_captures(node_f1(node), outer_env, local_env, src)
      26 -> check_mut_captures(node_f1(node), outer_env, local_env, src)
      29 -> 0
      32 -> check_mut_captures(node_f1(node), outer_env, local_env, src) + check_mut_captures_list(node_f4(node), nlist_len(node_f4(node)), outer_env, local_env, src)
      33 -> {
        let clauses = node_f2(node)
        let nclauses = node_f3(node)
        let mut errors = check_mut_captures(node_f1(node), outer_env, local_env, src)
        for ci in 0..nclauses {
          let clause = nlist_get(clauses, ci)
          let params = node_f2(clause)
          let clause_local = bind_capture_params(params, nlist_len(params), local_env, src)
          errors = errors + check_mut_captures(node_f3(clause), outer_env, clause_local, src)
        }
        errors
      }
      35 -> check_mut_captures(node_f1(node), outer_env, local_env, src)
      36 -> {
        let call_node = node_f2(node)
        check_mut_capture_name(node_f1(call_node), node_f2(call_node), outer_env, local_env, src) + check_mut_captures_list(node_f3(call_node), node_f4(call_node), outer_env, local_env, src)
      }
      37 -> {
        let inner = node_f1(node)
        let val = node_f3(inner)
        let body = node_f4(inner)
        let new_local = tenv_bind(local_env, src, node_f1(inner), node_f2(inner), ty_any())
        check_mut_captures(val, outer_env, local_env, src) + check_mut_captures(body, outer_env, new_local, src)
      }
      41 -> check_mut_captures(node_f1(node), outer_env, local_env, src) + check_mut_captures_list(node_f3(node), nlist_len(node_f3(node)), outer_env, local_env, src)
      45 -> check_mut_captures(node_f1(node), outer_env, local_env, src)
      46 -> check_mut_captures(node_f1(node), outer_env, local_env, src) + check_mut_captures(node_f2(node), outer_env, local_env, src)
      47 -> {
        let loop_local = tenv_bind(local_env, src, node_f1(node), node_f2(node), ty_any())
        check_mut_captures(node_f3(node), outer_env, local_env, src) + check_mut_captures(node_f4(node), outer_env, loop_local, src)
      }
      48 -> check_mut_captures(node_f1(node), outer_env, local_env, src)
      49 -> check_mut_captures(node_f1(node), outer_env, local_env, src)
      52 -> check_mut_captures(node_f1(node), outer_env, local_env, src) + check_mut_captures(node_f2(node), outer_env, local_env, src)
      _ -> 0
    }
  }
}

fn check_closure_mut_captures(body: i64, params: i64, nparams: i64, outer_env: i64, src: i64) -[Diagnose]> i64 {
  let local_env = bind_capture_params(params, nparams, tenv_new(), src)
  check_mut_captures(body, outer_env, local_env, src)
}

fn check_resume_capture_list(list: i64, n: i64, src: i64, lambda_depth: i64) -[Diagnose]> i64 {
  let mut errors = 0
  for i in 0..n {
    errors = errors + check_resume_captures(nlist_get(list, i), src, lambda_depth)
  }
  errors
}

fn check_resume_captures(node: i64, src: i64, lambda_depth: i64) -[Diagnose]> i64 {
  if node == 0 { 0 }
  else {
    let tag = node_tag(node)
    match tag {
      3 -> check_resume_captures(node_f2(node), src, lambda_depth) + check_resume_captures(node_f3(node), src, lambda_depth)
      4 -> check_resume_capture_list(node_f3(node), node_f4(node), src, lambda_depth)
      5 -> check_resume_captures(node_f1(node), src, lambda_depth) + check_resume_captures(node_f2(node), src, lambda_depth) + check_resume_captures(node_f3(node), src, lambda_depth)
      6 -> check_resume_captures(node_f3(node), src, lambda_depth) + check_resume_captures(node_f4(node), src, lambda_depth)
      7 -> check_resume_captures(node_f1(node), src, lambda_depth) + check_resume_captures(node_f2(node), src, lambda_depth)
      10 -> check_resume_captures(node_f1(node), src, lambda_depth) + check_resume_captures(node_f2(node), src, lambda_depth)
      11 -> check_resume_captures(node_f3(node), src, lambda_depth) + check_resume_captures(node_f4(node), src, lambda_depth)
      12 -> check_resume_captures(node_f3(node), src, lambda_depth)
      57 -> check_resume_captures(node_f1(node), src, lambda_depth) + check_resume_captures(node_f2(node), src, lambda_depth)
      13 -> check_resume_captures(node_f1(node), src, lambda_depth)
      14 -> {
        let fields = node_f3(node)
        let nfields = node_f4(node)
        let mut errors = 0
        for ri in 0..nfields {
          errors = errors + check_resume_captures(node_f3(nlist_get(fields, ri)), src, lambda_depth)
        }
        errors
      }
      15 -> {
        let arms = node_f2(node)
        let n = node_f3(node)
        let mut errors = check_resume_captures(node_f1(node), src, lambda_depth)
        for i in 0..n {
          let arm = nlist_get(arms, i)
          let guard = node_f3(arm)
          if guard != 0 { errors = errors + check_resume_captures(guard, src, lambda_depth) } else { errors = errors }
          errors = errors + check_resume_captures(node_f2(arm), src, lambda_depth)
        }
        errors
      }
      22 -> check_resume_captures(node_f1(node), src, lambda_depth)
      25 -> check_resume_captures(node_f1(node), src, lambda_depth)
      26 -> check_resume_captures(node_f1(node), src, lambda_depth)
      29 -> check_resume_captures(node_f2(node), src, lambda_depth + 1)
      32 -> check_resume_captures(node_f1(node), src, lambda_depth) + check_resume_capture_list(node_f4(node), nlist_len(node_f4(node)), src, lambda_depth)
      33 -> check_resume_captures(node_f1(node), src, lambda_depth)
      35 -> {
        let nested = check_resume_captures(node_f1(node), src, lambda_depth)
        if lambda_depth > 0 {
          let pos = expr_diag_pos(node_f1(node))
          typeck_error_maybe(src, pos, "type error: cannot capture resume")
          nested + 1
        } else { nested }
      }
      36 -> {
        let call_node = node_f2(node)
        check_resume_capture_list(node_f3(call_node), node_f4(call_node), src, lambda_depth)
      }
      37 -> check_resume_captures(node_f1(node), src, lambda_depth)
      41 -> check_resume_captures(node_f1(node), src, lambda_depth) + check_resume_capture_list(node_f3(node), nlist_len(node_f3(node)), src, lambda_depth)
      45 -> check_resume_captures(node_f1(node), src, lambda_depth)
      46 -> check_resume_captures(node_f1(node), src, lambda_depth) + check_resume_captures(node_f2(node), src, lambda_depth)
      47 -> check_resume_captures(node_f3(node), src, lambda_depth) + check_resume_captures(node_f4(node), src, lambda_depth)
      48 -> check_resume_captures(node_f1(node), src, lambda_depth)
      49 -> check_resume_captures(node_f1(node), src, lambda_depth)
      52 -> check_resume_captures(node_f1(node), src, lambda_depth) + check_resume_captures(node_f2(node), src, lambda_depth)
      _ -> 0
    }
  }
}

fn check_resume_scope_list(list: i64, n: i64, src: i64, in_clause: i64) -[Diagnose]> i64 {
  let mut errors = 0
  for i in 0..n {
    errors = errors + check_resume_scope(nlist_get(list, i), src, in_clause)
  }
  errors
}

fn check_resume_scope(node: i64, src: i64, in_clause: i64) -[Diagnose]> i64 {
  if node == 0 { 0 }
  else {
    let tag = node_tag(node)
    match tag {
      3 -> check_resume_scope(node_f2(node), src, in_clause) + check_resume_scope(node_f3(node), src, in_clause)
      4 -> check_resume_scope_list(node_f3(node), node_f4(node), src, in_clause)
      5 -> check_resume_scope(node_f1(node), src, in_clause) + check_resume_scope(node_f2(node), src, in_clause) + check_resume_scope(node_f3(node), src, in_clause)
      6 -> check_resume_scope(node_f3(node), src, in_clause) + check_resume_scope(node_f4(node), src, in_clause)
      7 -> check_resume_scope(node_f1(node), src, in_clause) + check_resume_scope(node_f2(node), src, in_clause)
      10 -> check_resume_scope(node_f1(node), src, in_clause) + check_resume_scope(node_f2(node), src, in_clause)
      11 -> check_resume_scope(node_f3(node), src, in_clause) + check_resume_scope(node_f4(node), src, in_clause)
      12 -> check_resume_scope(node_f3(node), src, in_clause)
      57 -> check_resume_scope(node_f1(node), src, in_clause) + check_resume_scope(node_f2(node), src, in_clause)
      13 -> check_resume_scope(node_f1(node), src, in_clause)
      14 -> {
        let fields = node_f3(node)
        let nfields = node_f4(node)
        let mut errors = 0
        for ri in 0..nfields {
          errors = errors + check_resume_scope(node_f3(nlist_get(fields, ri)), src, in_clause)
        }
        errors
      }
      15 -> {
        let arms = node_f2(node)
        let n = node_f3(node)
        let mut errors = check_resume_scope(node_f1(node), src, in_clause)
        for i in 0..n {
          let arm = nlist_get(arms, i)
          let guard = node_f3(arm)
          if guard != 0 { errors = errors + check_resume_scope(guard, src, in_clause) } else { errors = errors }
          errors = errors + check_resume_scope(node_f2(arm), src, in_clause)
        }
        errors
      }
      22 -> check_resume_scope(node_f1(node), src, in_clause)
      25 -> check_resume_scope(node_f1(node), src, in_clause)
      26 -> check_resume_scope(node_f1(node), src, in_clause)
      29 -> check_resume_scope(node_f2(node), src, in_clause)
      32 -> check_resume_scope(node_f1(node), src, in_clause) + check_resume_scope_list(node_f4(node), nlist_len(node_f4(node)), src, in_clause)
      33 -> {
        let clauses = node_f2(node)
        let nclauses = node_f3(node)
        let mut errors = check_resume_scope(node_f1(node), src, in_clause)
        for ci in 0..nclauses {
          errors = errors + check_resume_scope(node_f3(nlist_get(clauses, ci)), src, 1)
        }
        errors
      }
      35 -> {
        let nested = check_resume_scope(node_f1(node), src, in_clause)
        if in_clause == 0 {
          let pos = expr_diag_pos(node_f1(node))
          typeck_error_maybe(src, pos, "type error: resume outside handler clause")
          nested + 1
        } else { nested }
      }
      36 -> {
        let call_node = node_f2(node)
        check_resume_scope_list(node_f3(call_node), node_f4(call_node), src, in_clause)
      }
      37 -> check_resume_scope(node_f1(node), src, in_clause)
      41 -> check_resume_scope(node_f1(node), src, in_clause) + check_resume_scope_list(node_f3(node), nlist_len(node_f3(node)), src, in_clause)
      45 -> check_resume_scope(node_f1(node), src, in_clause)
      46 -> check_resume_scope(node_f1(node), src, in_clause) + check_resume_scope(node_f2(node), src, in_clause)
      47 -> check_resume_scope(node_f3(node), src, in_clause) + check_resume_scope(node_f4(node), src, in_clause)
      48 -> check_resume_scope(node_f1(node), src, in_clause)
      49 -> check_resume_scope(node_f1(node), src, in_clause)
      52 -> check_resume_scope(node_f1(node), src, in_clause) + check_resume_scope(node_f2(node), src, in_clause)
      _ -> 0
    }
  }
}


-- Does this clause body contain a resume(...) call (AST tag 35)?
fn clause_body_has_resume(node: i64) -> bool {
  if node == 0 { false }
  else {
    let tag = node_tag(node)
    if tag == 35 { true }
    else { if tag == 3 { clause_body_has_resume(node_f2(node)) or clause_body_has_resume(node_f3(node)) }
    else { if tag == 4 { clause_body_has_resume_list(node_f3(node), node_f4(node)) }
    else { if tag == 5 { clause_body_has_resume(node_f1(node)) or clause_body_has_resume(node_f2(node)) or clause_body_has_resume(node_f3(node)) }
    else { if tag == 6 { clause_body_has_resume(node_f3(node)) or clause_body_has_resume(node_f4(node)) }
    else { if tag == 7 { clause_body_has_resume(node_f1(node)) or clause_body_has_resume(node_f2(node)) }
    else { if tag == 10 { clause_body_has_resume(node_f1(node)) or clause_body_has_resume(node_f2(node)) }
    else { if tag == 11 { clause_body_has_resume(node_f3(node)) or clause_body_has_resume(node_f4(node)) }
    else { if tag == 12 { clause_body_has_resume(node_f3(node)) }
    else { if tag == 13 { clause_body_has_resume(node_f1(node)) }
    else { if tag == 15 { clause_body_has_resume(node_f1(node)) or clause_body_has_resume_arms(node_f2(node), node_f3(node)) }
    else { if tag == 22 { clause_body_has_resume(node_f1(node)) }
    else { if tag == 25 { clause_body_has_resume(node_f1(node)) }
    else { if tag == 32 { clause_body_has_resume(node_f1(node)) or clause_body_has_resume_list(node_f4(node), nlist_len(node_f4(node))) }
    else { if tag == 36 { clause_body_has_resume(node_f2(node)) }
    else { if tag == 41 { clause_body_has_resume(node_f1(node)) or clause_body_has_resume_list(node_f3(node), nlist_len(node_f3(node))) }
    else { if tag == 57 { clause_body_has_resume(node_f1(node)) or clause_body_has_resume(node_f2(node)) }
    else { false } } } } } } } } } } } } } } } } }
  }
}

fn clause_body_has_resume_list(list: i64, n: i64) -> bool {
  let mut found = false
  let mut i = 0
  while i < n {
    if clause_body_has_resume(nlist_get(list, i)) { found = true i = n }
    else { i = i + 1 }
  }
  found
}

fn clause_body_has_resume_arms(arms: i64, n: i64) -> bool {
  let mut found = false
  let mut i = 0
  while i < n {
    if clause_body_has_resume(node_f2(nlist_get(arms, i))) { found = true i = n }
    else { i = i + 1 }
  }
  found
}

fn check_no_resume_with_continuation_list(list: i64, n: i64, src: i64) -[Diagnose]> i64 {
  let mut errors = 0
  for i in 0..n {
    errors = errors + check_no_resume_with_continuation(nlist_get(list, i), src)
  }
  errors
}

fn check_no_resume_with_continuation(node: i64, src: i64) -[Diagnose]> i64 {
  if node == 0 { 0 }
  else {
    match node_tag(node) {
      3 -> check_no_resume_with_continuation(node_f2(node), src) + check_no_resume_with_continuation(node_f3(node), src)
      4 -> check_no_resume_with_continuation_list(node_f3(node), node_f4(node), src)
      5 -> check_no_resume_with_continuation(node_f1(node), src) + check_no_resume_with_continuation(node_f2(node), src) + check_no_resume_with_continuation(node_f3(node), src)
      6 -> check_no_resume_with_continuation(node_f3(node), src) + check_no_resume_with_continuation(node_f4(node), src)
      7 -> check_no_resume_with_continuation(node_f1(node), src) + check_no_resume_with_continuation(node_f2(node), src)
      10 -> check_no_resume_with_continuation(node_f1(node), src) + check_no_resume_with_continuation(node_f2(node), src)
      11 -> check_no_resume_with_continuation(node_f3(node), src) + check_no_resume_with_continuation(node_f4(node), src)
      12 -> check_no_resume_with_continuation(node_f3(node), src)
      57 -> check_no_resume_with_continuation(node_f1(node), src) + check_no_resume_with_continuation(node_f2(node), src)
      13 -> check_no_resume_with_continuation(node_f1(node), src)
      14 -> {
        let fields = node_f3(node)
        let nfields = node_f4(node)
        let mut errors = 0
        for ri in 0..nfields {
          errors = errors + check_no_resume_with_continuation(node_f3(nlist_get(fields, ri)), src)
        }
        errors
      }
      15 -> {
        let arms = node_f2(node)
        let n = node_f3(node)
        let mut errors = check_no_resume_with_continuation(node_f1(node), src)
        for i in 0..n {
          let arm = nlist_get(arms, i)
          let guard = node_f3(arm)
          if guard != 0 { errors = errors + check_no_resume_with_continuation(guard, src) } else { errors = errors }
          errors = errors + check_no_resume_with_continuation(node_f2(arm), src)
        }
        errors
      }
      22 -> check_no_resume_with_continuation(node_f1(node), src)
      25 -> check_no_resume_with_continuation(node_f1(node), src)
      26 -> check_no_resume_with_continuation(node_f1(node), src)
      29 -> 0
      32 -> check_no_resume_with_continuation(node_f1(node), src) + check_no_resume_with_continuation_list(node_f4(node), nlist_len(node_f4(node)), src)
      33 -> check_no_resume_with_continuation(node_f1(node), src)
      35 -> {
        let nested = check_no_resume_with_continuation(node_f1(node), src)
        let pos = expr_diag_pos(node_f1(node))
        typeck_error_maybe(src, pos, "type error: use continuation binding instead of resume")
        nested + 1
      }
      36 -> {
        let call_node = node_f2(node)
        check_no_resume_with_continuation_list(node_f3(call_node), node_f4(call_node), src)
      }
      37 -> check_no_resume_with_continuation(node_f1(node), src)
      41 -> check_no_resume_with_continuation(node_f1(node), src) + check_no_resume_with_continuation_list(node_f3(node), nlist_len(node_f3(node)), src)
      45 -> check_no_resume_with_continuation(node_f1(node), src)
      46 -> check_no_resume_with_continuation(node_f1(node), src) + check_no_resume_with_continuation(node_f2(node), src)
      47 -> check_no_resume_with_continuation(node_f3(node), src) + check_no_resume_with_continuation(node_f4(node), src)
      48 -> check_no_resume_with_continuation(node_f1(node), src)
      49 -> check_no_resume_with_continuation(node_f1(node), src)
      52 -> check_no_resume_with_continuation(node_f1(node), src) + check_no_resume_with_continuation(node_f2(node), src)
      _ -> 0
    }
  }
}

fn lambda_span(lambda: i64) -> i64 {
  let params = node_f1(lambda)
  if nlist_len(params) > 0 {
    let p = nlist_get(params, 0)
    node_f1(p)
  } else { 0 }
}

fn check_lambda_against_fn(lambda: i64, expected: i64, env: i64, ft: i64, src: i64, tt: i64, pos: i64) -[Conformance, Diagnose]> i64 {
  if ty_tag(expected) != 6 { 0 }
  else {
    let params = node_f1(lambda)
    let body = node_f2(lambda)
    let nparams = node_f3(lambda)
    let expected_params = ty_f1(expected)
    let nexpected = nlist_len(expected_params)
    let mut errors = 0
    if nparams != nexpected {
      if pos > 0 {
        typeck_error(src, pos, "type error: argument type mismatch")
      } else {
        typeck_error(src, lambda_span(lambda), "type error: argument type mismatch")
      }
      errors = errors + 1
    } else { errors = errors }
    let nbind = if nparams < nexpected { nparams } else { nexpected }
    let mut lambda_env = env
    for i in 0..nbind {
      let p = nlist_get(params, i)
      let expected_param = nlist_get(expected_params, i)
      let ann_ty = node_f3(p)
      let bind_ty = if ann_ty != 0 {
        if not is_subtype(expected_param, ann_ty) {
          if pos > 0 {
            typeck_error(src, pos, "type error: argument type mismatch")
          } else {
            typeck_error(src, node_f1(p), "type error: argument type mismatch")
          }
          errors = errors + 1
        } else { errors = errors }
        ann_ty
      } else { expected_param }
      lambda_env = tenv_bind(lambda_env, src, node_f1(p), node_f2(p), bind_ty)
    }
    let body_ty = synth(body, lambda_env, ft, src, tt)
    errors = errors + check_closure_mut_captures(body, params, nparams, env, src)
    if typeck_type_list_contains_unique(expected_params) == 1 or typeck_params_contain_unique(params) == 1 or tenv_contains_unique(env) == 1 {
      errors = errors + check_closure_unique_captures(body, params, nparams, env, src)
      errors = errors + check_unique_param_usage_against_types(params, expected_params, nbind, body, src)
      errors = errors + check_unique_linear_expr(body, lambda_env, ft, src, tt)
    } else { errors = errors }
    errors = errors + check_expr(body, lambda_env, ft, src, ty_f3(expected), tt)
    errors = errors + check_return_values(body, lambda_env, ft, src, ty_f2(expected), tt)
    if type_is_unknown_or_any(body_ty) { errors = errors }
    else { if expr_matches_type_contextual(body, body_ty, ty_f2(expected), src) != 1 {
      if pos > 0 {
        typeck_error(src, pos, "type error: return type mismatch")
      } else {
        typeck_error(src, lambda_span(lambda), "type error: return type mismatch")
      }
      errors = errors + 1
    } else { errors = errors } }
    errors
  }
}

fn check_lambda_standalone(lambda: i64, env: i64, ft: i64, src: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let params = node_f1(lambda)
  let body = node_f2(lambda)
  let nparams = node_f3(lambda)
  let mut lambda_env = env
  for i in 0..nparams {
    let p = nlist_get(params, i)
    lambda_env = tenv_bind(lambda_env, src, node_f1(p), node_f2(p), lambda_param_ty(p))
  }
  let body_ty = synth(body, lambda_env, ft, src, tt)
  let unique_errors = if typeck_params_contain_unique(params) == 1 or tenv_contains_unique(env) == 1 {
    check_closure_unique_captures(body, params, nparams, env, src) +
      check_unique_param_usage(params, nparams, body, src) +
      check_unique_linear_expr(body, lambda_env, ft, src, tt)
  } else { 0 }
  check_closure_mut_captures(body, params, nparams, env, src) +
    unique_errors +
    check_expr(body, lambda_env, ft, src, infer_expr_effects(body, lambda_env, ft, src, tt), tt) +
    check_return_values(body, lambda_env, ft, src, body_ty, tt)
}

fn check_arg_against_param_mode(arg: i64, param_ty: i64, env: i64, ft: i64, src: i64, tt: i64, pos: i64, allow_direct_continuation_i64: i64) -[Conformance, Diagnose]> i64 {
  if param_ty == 0 { 0 }
  else {
    if ty_tag(param_ty) == 6 {
      if node_tag(arg) == 29 {
        check_lambda_against_fn(arg, param_ty, env, ft, src, tt, pos)
      } else {
        let arg_ty = synth(arg, env, ft, src, tt)
        if ty_is_continuation(arg_ty) == 1 {
          if ty_is_continuation(param_ty) == 0 and not (allow_direct_continuation_i64 == 1 and type_is_i64_like(param_ty) == 1) {
            typeck_error_maybe(src, pos, "type error: argument type mismatch")
            1
          } else { 0 }
        } else { if expr_matches_type_contextual(arg, arg_ty, param_ty, src) != 1 {
          typeck_error_maybe(src, pos, "type error: argument type mismatch")
          1
        } else { 0 } }
      }
    } else {
      let arg_ty = synth(arg, env, ft, src, tt)
      if ty_is_continuation(arg_ty) == 1 {
        if ty_is_continuation(param_ty) == 0 and not (allow_direct_continuation_i64 == 1 and type_is_i64_like(param_ty) == 1) {
          typeck_error_maybe(src, pos, "type error: argument type mismatch")
          1
        } else { 0 }
      } else { if expr_matches_type_contextual(arg, arg_ty, param_ty, src) != 1 {
        -- Second chance: generic ctor argument solves its type args from
        -- the declared parameter type.
        if infer_generic_ctor_result(arg, param_ty, env, ft, src, tt) == 1 and expr_matches_type_contextual(arg, synth(arg, env, ft, src, tt), param_ty, src) == 1 { 0 }
        else {
          typeck_error_maybe(src, pos, "type error: argument type mismatch")
          1
        }
      } else { 0 } }
    }
  }
}

fn check_arg_against_param(arg: i64, param_ty: i64, env: i64, ft: i64, src: i64, tt: i64, pos: i64) -[Conformance, Diagnose]> i64 {
  check_arg_against_param_mode(arg, param_ty, env, ft, src, tt, pos, 0)
}

fn is_intrinsic_name(src: i64, ns: i64, nl: i64) -> i64 {
  if nl >= 2 {
    if mem_load8_at(src, ns) == 95 {
      mem_load8_at(src, ns + 1) == 95
    } else { false }
  } else { false }
}

-- The closed set of compiler intrinsics. A "__" prefix alone does not make a
-- name an intrinsic — unknown "__" calls must fall through to normal
-- resolution so they get "unknown function" instead of silent acceptance.
fn is_known_intrinsic_name(src: i64, ns: i64, nl: i64) -> i64 {
  if intrinsic_int_cast_arg_ty(src, ns, nl) != 0 { true }
  else { if intrinsic_int_to_f64_arg_ty(src, ns, nl) != 0 { true }
  else { if intrinsic_int_to_f32_arg_ty(src, ns, nl) != 0 { true }
  else {
    src_eq(src, ns, nl, "__f64_to_i64_trunc") == 1 or
    src_eq(src, ns, nl, "__f32_to_f64") == 1 or
    src_eq(src, ns, nl, "__f64_to_f32") == 1 or
    src_eq(src, ns, nl, "__f64_sqrt") == 1 or
    src_eq(src, ns, nl, "__f32_sqrt") == 1 or
    src_eq(src, ns, nl, "__raw_offset") == 1 or
    src_eq(src, ns, nl, "__transmute") == 1 or
    src_eq(src, ns, nl, "__int_to_ptr") == 1 or
    src_eq(src, ns, nl, "__mem_load64") == 1 or
    src_eq(src, ns, nl, "__mem_store64") == 1 or
    src_eq(src, ns, nl, "__mem_load8") == 1 or
    src_eq(src, ns, nl, "__mem_store8") == 1 or
    src_eq(src, ns, nl, "__mem_load_sized") == 1 or
    src_eq(src, ns, nl, "__mem_store_sized") == 1 or
    src_eq(src, ns, nl, "__str_ptr") == 1 or
    src_eq(src, ns, nl, "__str_len") == 1 or
    src_eq(src, ns, nl, "__bump_alloc") == 1 or
    src_eq(src, ns, nl, "__syscall") == 1 or
    src_eq(src, ns, nl, "__runtime_state") == 1 or
    src_eq(src, ns, nl, "__set_runtime_state") == 1 or
    src_eq(src, ns, nl, "__set_handler_stack") == 1 or
    src_eq(src, ns, nl, "__call_i64") == 1 or
    src_eq(src, ns, nl, "__call_closure_i64") == 1 or
    src_eq(src, ns, nl, "__atomic_lock64") == 1 or
    src_eq(src, ns, nl, "__atomic_unlock64") == 1 or
    src_eq(src, ns, nl, "__fiber_suspend") == 1 or
    src_eq(src, ns, nl, "__fiber_resume") == 1 or
    src_eq(src, ns, nl, "__fiber_is_done") == 1 or
    src_eq(src, ns, nl, "__fiber_trampoline") == 1
  } } }
}

fn check_intrinsic_i64_to_f64_args(node: i64, env: i64, ft: i64, src: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let nargs = node_f4(node)
  if nargs != 1 {
    typeck_error_maybe(src, node_f1(node), "type error: arity mismatch")
    1
  } else {
    check_arg_against_param(nlist_get(node_f3(node), 0), ty_i64(), env, ft, src, tt, node_f1(node))
  }
}

fn check_intrinsic_f64_to_i64_trunc_args(node: i64, env: i64, ft: i64, src: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let nargs = node_f4(node)
  if nargs != 1 {
    typeck_error_maybe(src, node_f1(node), "type error: arity mismatch")
    1
  } else {
    check_arg_against_param(nlist_get(node_f3(node), 0), ty_f64(), env, ft, src, tt, node_f1(node))
  }
}

fn check_intrinsic_f32_to_f64_args(node: i64, env: i64, ft: i64, src: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let nargs = node_f4(node)
  if nargs != 1 {
    typeck_error_maybe(src, node_f1(node), "type error: arity mismatch")
    1
  } else {
    check_arg_against_param(nlist_get(node_f3(node), 0), ty_f32(), env, ft, src, tt, node_f1(node))
  }
}

fn check_intrinsic_f64_to_f32_args(node: i64, env: i64, ft: i64, src: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let nargs = node_f4(node)
  if nargs != 1 {
    typeck_error_maybe(src, node_f1(node), "type error: arity mismatch")
    1
  } else {
    check_arg_against_param(nlist_get(node_f3(node), 0), ty_f64(), env, ft, src, tt, node_f1(node))
  }
}

fn check_intrinsic_one_arg_type(node: i64, env: i64, ft: i64, src: i64, tt: i64, param_ty: i64) -[Conformance, Diagnose]> i64 {
  let nargs = node_f4(node)
  if nargs != 1 {
    typeck_error_maybe(src, node_f1(node), "type error: arity mismatch")
    1
  } else {
    check_arg_against_param(nlist_get(node_f3(node), 0), param_ty, env, ft, src, tt, node_f1(node))
  }
}

fn check_intrinsic_one_arg_any(node: i64, src: i64) -[Diagnose]> i64 {
  let nargs = node_f4(node)
  if nargs != 1 {
    typeck_error_maybe(src, node_f1(node), "type error: arity mismatch")
    1
  } else { 0 }
}

fn check_intrinsic_raw_offset_args(node: i64, env: i64, ft: i64, src: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let nargs = node_f4(node)
  if nargs != 2 {
    typeck_error_maybe(src, node_f1(node), "type error: arity mismatch")
    1
  } else {
    let ptr_arg = nlist_get(node_f3(node), 0)
    let off_arg = nlist_get(node_f3(node), 1)
    let ptr_ty = synth(ptr_arg, env, ft, src, tt)
    let mut errors = if type_is_unknown_or_any(ptr_ty) { 0 }
    else { if ty_is_ptr(ptr_ty) == 1 { 0 }
    else {
      typeck_error_maybe(src, expr_diag_pos(ptr_arg), "type error: argument type mismatch")
      1
    } }
    errors = errors + check_arg_against_param(off_arg, ty_i64(), env, ft, src, tt, node_f1(node))
    errors
  }
}

fn check_intrinsic_mem_load_sized_args(node: i64, env: i64, ft: i64, src: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let nargs = node_f4(node)
  if nargs != 3 {
    typeck_error_maybe(src, node_f1(node), "type error: arity mismatch")
    1
  } else {
    let args = node_f3(node)
    check_arg_against_param(nlist_get(args, 0), ty_i64(), env, ft, src, tt, node_f1(node)) +
    check_arg_against_param(nlist_get(args, 1), ty_i64(), env, ft, src, tt, node_f1(node)) +
    check_arg_against_param(nlist_get(args, 2), ty_i64(), env, ft, src, tt, node_f1(node))
  }
}

fn check_intrinsic_mem_store_sized_args(node: i64, env: i64, ft: i64, src: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let nargs = node_f4(node)
  if nargs != 4 {
    typeck_error_maybe(src, node_f1(node), "type error: arity mismatch")
    1
  } else {
    let args = node_f3(node)
    check_arg_against_param(nlist_get(args, 0), ty_i64(), env, ft, src, tt, node_f1(node)) +
    check_arg_against_param(nlist_get(args, 1), ty_i64(), env, ft, src, tt, node_f1(node)) +
    check_arg_against_param(nlist_get(args, 2), ty_i64(), env, ft, src, tt, node_f1(node))
  }
}

fn check_intrinsic_args(node: i64, env: i64, ft: i64, src: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let ns = node_f1(node)
  let nl = node_f2(node)
  let int_cast_arg_ty = intrinsic_int_cast_arg_ty(src, ns, nl)
  let int_to_f64_arg_ty = intrinsic_int_to_f64_arg_ty(src, ns, nl)
  let int_to_f32_arg_ty = intrinsic_int_to_f32_arg_ty(src, ns, nl)
  if int_cast_arg_ty != 0 {
    check_intrinsic_one_arg_type(node, env, ft, src, tt, int_cast_arg_ty)
  } else { if int_to_f64_arg_ty != 0 {
    check_intrinsic_one_arg_type(node, env, ft, src, tt, int_to_f64_arg_ty)
  } else { if int_to_f32_arg_ty != 0 {
    check_intrinsic_one_arg_type(node, env, ft, src, tt, int_to_f32_arg_ty)
  } else { if src_eq(src, ns, nl, "__f64_to_i64_trunc") == 1 {
    check_intrinsic_f64_to_i64_trunc_args(node, env, ft, src, tt)
  } else { if src_eq(src, ns, nl, "__f32_to_f64") == 1 {
    check_intrinsic_f32_to_f64_args(node, env, ft, src, tt)
  } else { if src_eq(src, ns, nl, "__f64_to_f32") == 1 {
    check_intrinsic_f64_to_f32_args(node, env, ft, src, tt)
  } else { if src_eq(src, ns, nl, "__f64_sqrt") == 1 {
    check_intrinsic_one_arg_type(node, env, ft, src, tt, ty_f64())
  } else { if src_eq(src, ns, nl, "__f32_sqrt") == 1 {
    check_intrinsic_one_arg_type(node, env, ft, src, tt, ty_f32())
  } else { if src_eq(src, ns, nl, "__raw_offset") == 1 {
    check_intrinsic_raw_offset_args(node, env, ft, src, tt)
  } else { if src_eq(src, ns, nl, "__transmute") == 1 {
    check_intrinsic_one_arg_any(node, src)
  } else { if src_eq(src, ns, nl, "__int_to_ptr") == 1 {
    check_intrinsic_one_arg_type(node, env, ft, src, tt, ty_i64())
  } else { if src_eq(src, ns, nl, "__mem_load_sized") == 1 {
    check_intrinsic_mem_load_sized_args(node, env, ft, src, tt)
  } else { if src_eq(src, ns, nl, "__mem_store_sized") == 1 {
    check_intrinsic_mem_store_sized_args(node, env, ft, src, tt)
  } else { if src_eq(src, ns, nl, "__atomic_lock64") == 1 {
    check_intrinsic_one_arg_type(node, env, ft, src, tt, ty_i64())
  } else { if src_eq(src, ns, nl, "__atomic_unlock64") == 1 {
    check_intrinsic_one_arg_type(node, env, ft, src, tt, ty_i64())
  } else { 0 } } } } } } } } } } } } } } }
}

fn effect_hash_unsafe() -> i64 {
  effect_name_hash(__str_ptr("Unsafe"), 0, 6)
}

fn effect_hash_alloc() -> i64 {
  effect_name_hash(__str_ptr("Alloc"), 0, 5)
}

fn intrinsic_alloc_effect_call_name(src: i64, ns: i64, nl: i64) -> i64 {
  if src_eq(src, ns, nl, "__bump_alloc") == 1 { true }
  else { src_eq(src, ns, nl, "alloc_bump") == 1 }
}

fn intrinsic_memory_effect_call_name(src: i64, ns: i64, nl: i64) -> i64 {
  if src_eq(src, ns, nl, "__mem_load64") == 1 { true }
  else { if src_eq(src, ns, nl, "__mem_load8") == 1 { true }
  else { if src_eq(src, ns, nl, "__mem_load_sized") == 1 { true }
  else { if src_eq(src, ns, nl, "__mem_store64") == 1 { true }
  else { if src_eq(src, ns, nl, "__mem_store8") == 1 { true }
  else { if src_eq(src, ns, nl, "__mem_store_sized") == 1 { true }
  else { if src_eq(src, ns, nl, "__atomic_lock64") == 1 { true }
  else { src_eq(src, ns, nl, "__atomic_unlock64") == 1 } } }
  } } } }
}

fn intrinsic_safe_memory_effect_call_name(src: i64, ns: i64, nl: i64) -> i64 {
  if src_eq(src, ns, nl, "vector_get") == 1 { true }
  else { if src_eq(src, ns, nl, "vector_set") == 1 { true }
  else { src_eq(src, ns, nl, "vector_len") } }
}

fn intrinsic_pure_effect_call_name(src: i64, ns: i64, nl: i64) -> i64 {
  if src_eq(src, ns, nl, "__f64_sqrt") == 1 { true }
  else { src_eq(src, ns, nl, "__f32_sqrt") == 1 }
}

fn intrinsic_semantic_effect_flags(src: i64, ns: i64, nl: i64) -> i64 {
  let alloc = if intrinsic_alloc_effect_call_name(src, ns, nl) == 1 { 1 } else { 0 }
  let unsafe = if intrinsic_memory_effect_call_name(src, ns, nl) == 1 or is_unsafe_raw_call_name(src, ns, nl) == 1 { 1 } else { 0 }
  let memory = if intrinsic_safe_memory_effect_call_name(src, ns, nl) == 1 { 1 } else { 0 }
  alloc + unsafe * 2 + memory * 8
}

fn is_got_call_name(src: i64, ns: i64, nl: i64) -> bool {
  if nl > 6 {
    src_eq_at(src, ns, __str_ptr("__got_"), 0, 6) == 1
  } else { false }
}

fn is_known_got_call_name(src: i64, ns: i64, nl: i64) -> bool {
  if is_got_call_name(src, ns, nl) {
    let rest_ns = ns + 6
    let rest_nl = nl - 6
    if src_eq(src, rest_ns, rest_nl, "posix_spawn") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "waitpid") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "exit") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "pthread_create") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "pthread_join") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "mmap") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "write") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "read") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "open") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "close") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "pthread_mutex_init") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "pthread_mutex_lock") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "pthread_mutex_unlock") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "pthread_mutex_destroy") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "pthread_cond_init") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "pthread_cond_wait") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "pthread_cond_signal") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "pthread_cond_broadcast") == 1 { true }
    else { if src_eq(src, rest_ns, rest_nl, "pthread_cond_destroy") == 1 { true }
    else { false } } } } } } } } } } } } } } } } } } }
  } else { false }
}

fn check_got_call_known(node: i64, src: i64) -[Diagnose]> i64 {
  let ns = node_f1(node)
  let nl = node_f2(node)
  if is_got_call_name(src, ns, nl) {
    if is_known_got_call_name(src, ns, nl) { 0 }
    else {
      typeck_error_maybe(src, ns, "type error: unknown GOT symbol")
      1
    }
  } else { 0 }
}

fn is_unsafe_raw_call_name(src: i64, ns: i64, nl: i64) -> bool {
  if src_eq(src, ns, nl, "__syscall") == 1 { true }
  else { if src_eq(src, ns, nl, "__raw_offset") == 1 { true }
  else { if src_eq(src, ns, nl, "__transmute") == 1 { true }
  else { if src_eq(src, ns, nl, "__int_to_ptr") == 1 { true }
  else { if src_eq(src, ns, nl, "__runtime_state") == 1 { true }
  else { if src_eq(src, ns, nl, "__set_runtime_state") == 1 { true }
  else { if src_eq(src, ns, nl, "__set_handler_stack") == 1 { true }
  else { if src_eq(src, ns, nl, "__call_i64") == 1 { true }
  else { if src_eq(src, ns, nl, "__call_closure_i64") == 1 { true }
  else { if src_eq(src, ns, nl, "__fiber_trampoline") == 1 { true }
  else { if src_eq(src, ns, nl, "__fiber_suspend") == 1 { true }
  else { if src_eq(src, ns, nl, "__fiber_resume") == 1 { true }
  else { if src_eq(src, ns, nl, "__fiber_is_done") == 1 { true }
  else { is_got_call_name(src, ns, nl) }
  } } } } } } } } } } } }
}

fn check_unsafe_raw_call_available(node: i64, src: i64, caller_eff: i64) -[Diagnose]> i64 {
  let ns = node_f1(node)
  let nl = node_f2(node)
  if is_unsafe_raw_call_name(src, ns, nl) {
    check_effect_hash_available(effect_hash_unsafe(), src, ns, caller_eff)
  } else { 0 }
}

fn check_imported_raw_call_sealed(node: i64, src: i64) -[Diagnose]> i64 {
  let ns = node_f1(node)
  let nl = node_f2(node)
  if intrinsic_alloc_effect_call_name(src, ns, nl) == 1 {
    typeck_error_maybe(src, ns, "type error: raw allocation is sealed to trusted runtime/platform code")
    1
  } else { if is_unsafe_raw_call_name(src, ns, nl) or is_unsafe_helper_call_name(src, ns, nl) == 1 or intrinsic_memory_effect_call_name(src, ns, nl) == 1 {
    typeck_error_maybe(src, ns, "type error: Unsafe is sealed to trusted runtime/platform code")
    1
  } else { 0 } }
}

fn is_unsafe_helper_call_name(src: i64, ns: i64, nl: i64) -> i64 {
  if src_eq(src, ns, nl, "unsafe_raw_offset") == 1 { true }
  else { if src_eq(src, ns, nl, "unsafe_raw_offset_mut") == 1 { true }
  else { if src_eq(src, ns, nl, "unsafe_transmute") == 1 { true }
  else { if src_eq(src, ns, nl, "unsafe_raw_syscall") == 1 { true }
  else { if src_eq(src, ns, nl, "unsafe_int_to_ptr") == 1 { true }
  else { if src_eq(src, ns, nl, "unsafe_runtime_state") == 1 { true }
  else { src_eq(src, ns, nl, "unsafe_raw_call_i64") } } } } } }
}

fn is_source_trust_grant_call_name(src: i64, ns: i64, nl: i64) -> i64 {
  if src_eq(src, ns, nl, "pipeline_mark_root_origin") == 1 { true }
  else { if src_eq(src, ns, nl, "pipeline_mark_root_origin_with_grant") == 1 { true }
  else { if src_eq(src, ns, nl, "pipeline_parse_source_with_trust") == 1 { true }
  else { if src_eq(src, ns, nl, "pipeline_parse_source_with_origin") == 1 { true }
  else { if src_eq(src, ns, nl, "pipeline_parse_source_with_diagnostics_and_trust") == 1 { true }
  else { if src_eq(src, ns, nl, "pipeline_parse_source_with_diagnostics_and_origin") == 1 { true }
  else { if src_eq(src, ns, nl, "pipeline_check_source_with_trust") == 1 { true }
  else { if src_eq(src, ns, nl, "pipeline_check_source_with_origin") == 1 { true }
  else { if src_eq(src, ns, nl, "pipeline_check_source_with_diagnostics_and_trust") == 1 { true }
  else { if src_eq(src, ns, nl, "pipeline_check_source_with_diagnostics_and_origin") == 1 { true }
  else { if src_eq(src, ns, nl, "pipeline_compile_native_source_with_trust") == 1 { true }
  else { if src_eq(src, ns, nl, "pipeline_compile_native_source_with_origin") == 1 { true }
  else { if src_eq(src, ns, nl, "ttable_mark_source_trust_grant_source") == 1 { true }
  else { src_eq(src, ns, nl, "ttable_mark_trusted_source") } }
  } } } } } } } } } } } }
}

fn check_imported_source_trust_grant_sealed(tt: i64, node: i64, src: i64) -[Diagnose]> i64 {
  let ns = node_f1(node)
  let nl = node_f2(node)
  if is_source_trust_grant_call_name(src, ns, nl) == 1 {
    if ttable_source_can_grant_trust(tt, src) == 1 { 0 }
    else {
      typeck_error_maybe(src, ns, "type error: source trust is sealed to trusted compiler/runtime code")
      1
    }
  } else { 0 }
}

fn is_internal_par_prepared_call_name(src: i64, ns: i64, nl: i64) -> i64 {
  if src_eq(src, ns, nl, "par_pthread_pool_submit_prepared") == 1 { true }
  else { src_eq(src, ns, nl, "par_pthread_pool_submit_prepared_result") == 1 }
}

fn check_internal_par_prepared_call_sealed(tt: i64, node: i64, src: i64) -[Diagnose]> i64 {
  if ttable_source_is_trusted(tt, src) == 1 { 0 }
  else {
    let ns = node_f1(node)
    let nl = node_f2(node)
    if is_internal_par_prepared_call_name(src, ns, nl) == 1 {
      typeck_error_maybe(src, ns, "type error: prepared Par submission is compiler-internal")
      1
    } else { 0 }
  }
}

fn check_imported_unsafe_perform_sealed(node: i64, src: i64) -[Diagnose]> i64 {
  let lhs = node_f1(node)
  if node_tag(lhs) == 2 {
    if src_eq(src, node_f1(lhs), node_f2(lhs), "Unsafe") == 1 {
      typeck_error_maybe(src, node_f1(lhs), "type error: Unsafe is sealed to trusted runtime/platform code")
      1
    } else { 0 }
  } else { 0 }
}

fn check_imported_unsafe_handle_sealed(handled_eff_hash: i64, clause_name: i64, src: i64) -[Diagnose]> i64 {
  if handled_eff_hash == effect_hash_unsafe() {
    typeck_error_maybe(src, node_f1(clause_name), "type error: Unsafe is sealed to trusted runtime/platform code")
    1
  } else { 0 }
}

fn check_imported_pointer_surface_sealed(node: i64, src: i64) -[Diagnose]> i64 {
  typeck_error_maybe(src, expr_diag_pos(node), "type error: Unsafe is sealed to trusted runtime/platform code")
  1
}

fn check_imported_unsafe_raw_expr_list(tt: i64, list: i64, n: i64, src: i64, caller_eff: i64) -[Diagnose]> i64 {
  let mut errors = 0
  for i in 0..n {
    errors = errors + check_imported_unsafe_raw_expr(tt, nlist_get(list, i), src, caller_eff)
  }
  errors
}

fn check_imported_unsafe_raw_record_fields(tt: i64, fields: i64, nfields: i64, src: i64, caller_eff: i64) -[Diagnose]> i64 {
  let mut errors = 0
  for i in 0..nfields {
    errors = errors + check_imported_unsafe_raw_expr(tt, node_f3(nlist_get(fields, i)), src, caller_eff)
  }
  errors
}

fn check_imported_unsafe_raw_match_arms(tt: i64, arms: i64, narms: i64, src: i64, caller_eff: i64) -[Diagnose]> i64 {
  let mut errors = 0
  for i in 0..narms {
    let arm = nlist_get(arms, i)
    errors = errors + check_imported_unsafe_raw_expr(tt, node_f2(arm), src, caller_eff)
    if node_f3(arm) != 0 {
      errors = errors + check_imported_unsafe_raw_expr(tt, node_f3(arm), src, caller_eff)
    } else { errors = errors }
  }
  errors
}

fn check_imported_unsafe_raw_handler_clauses(tt: i64, clauses: i64, nclauses: i64, handled_eff_hash: i64, src: i64, caller_eff: i64) -[Diagnose]> i64 {
  let mut errors = 0
  let clause_eff = if handled_eff_hash == effect_hash_unsafe() {
    effect_add(caller_eff, handled_eff_hash)
  } else { caller_eff }
  for i in 0..nclauses {
    errors = errors + check_imported_unsafe_raw_expr(tt, node_f3(nlist_get(clauses, i)), src, clause_eff)
  }
  errors
}

fn check_imported_unsafe_raw_expr(tt: i64, node: i64, src: i64, caller_eff: i64) -[Diagnose]> i64 {
  if node == 0 { 0 }
  else {
    match node_tag(node) {
      3 -> check_imported_unsafe_raw_expr(tt, node_f2(node), src, caller_eff) + check_imported_unsafe_raw_expr(tt, node_f3(node), src, caller_eff)
      4 -> check_got_call_known(node, src) + check_imported_raw_call_sealed(node, src) + check_imported_source_trust_grant_sealed(tt, node, src) + check_imported_unsafe_raw_expr_list(tt, node_f3(node), node_f4(node), src, caller_eff)
      5 -> check_imported_unsafe_raw_expr(tt, node_f1(node), src, caller_eff) + check_imported_unsafe_raw_expr(tt, node_f2(node), src, caller_eff) + check_imported_unsafe_raw_expr(tt, node_f3(node), src, caller_eff)
      6 -> check_imported_unsafe_raw_expr(tt, node_f3(node), src, caller_eff) + check_imported_unsafe_raw_expr(tt, node_f4(node), src, caller_eff)
      7 -> check_imported_unsafe_raw_expr(tt, node_f1(node), src, caller_eff) + check_imported_unsafe_raw_expr(tt, node_f2(node), src, caller_eff)
      10 -> check_imported_unsafe_raw_expr(tt, node_f1(node), src, caller_eff) + check_imported_unsafe_raw_expr(tt, node_f2(node), src, caller_eff)
      11 -> check_imported_unsafe_raw_expr(tt, node_f3(node), src, caller_eff) + check_imported_unsafe_raw_expr(tt, node_f4(node), src, caller_eff)
      12 -> check_imported_unsafe_raw_expr(tt, node_f3(node), src, caller_eff)
      57 -> check_imported_pointer_surface_sealed(node, src) + check_imported_unsafe_raw_expr(tt, node_f1(node), src, caller_eff) + check_imported_unsafe_raw_expr(tt, node_f2(node), src, caller_eff)
      13 -> check_imported_unsafe_raw_expr(tt, node_f1(node), src, caller_eff)
      14 -> check_imported_unsafe_raw_record_fields(tt, node_f3(node), node_f4(node), src, caller_eff)
      15 -> check_imported_unsafe_raw_expr(tt, node_f1(node), src, caller_eff) + check_imported_unsafe_raw_match_arms(tt, node_f2(node), node_f3(node), src, caller_eff)
      22 -> check_imported_unsafe_raw_expr(tt, node_f1(node), src, caller_eff)
      25 -> check_imported_unsafe_raw_expr(tt, node_f1(node), src, caller_eff)
      26 -> check_imported_unsafe_raw_expr(tt, node_f1(node), src, caller_eff)
      29 -> check_imported_unsafe_raw_expr(tt, node_f2(node), src, caller_eff)
      32 -> check_imported_unsafe_perform_sealed(node, src) + check_imported_unsafe_raw_expr(tt, node_f1(node), src, caller_eff) + check_imported_unsafe_raw_expr_list(tt, node_f4(node), nlist_len(node_f4(node)), src, caller_eff)
      33 -> {
        let clauses = node_f2(node)
        let nclauses = node_f3(node)
        let handled_eff_hash = if nclauses > 0 {
          let cn = node_f1(nlist_get(clauses, 0))
          effect_name_hash(src, node_f1(cn), node_f2(cn))
        } else { 0 }
        let first_name = if nclauses > 0 { node_f1(nlist_get(clauses, 0)) } else { node_new(0, 0, 0, 0, 0) }
        check_imported_unsafe_handle_sealed(handled_eff_hash, first_name, src) + check_imported_unsafe_raw_expr(tt, node_f1(node), src, effect_add(caller_eff, handled_eff_hash)) + check_imported_unsafe_raw_handler_clauses(tt, clauses, nclauses, handled_eff_hash, src, caller_eff)
      }
      35 -> check_imported_unsafe_raw_expr(tt, node_f1(node), src, caller_eff)
      36 -> {
        let call_node = node_f2(node)
        check_got_call_known(call_node, src) + check_imported_raw_call_sealed(call_node, src) + check_imported_source_trust_grant_sealed(tt, call_node, src) + check_imported_unsafe_raw_expr_list(tt, node_f3(call_node), node_f4(call_node), src, caller_eff)
      }
      37 -> check_imported_unsafe_raw_expr(tt, node_f1(node), src, caller_eff)
      41 -> check_imported_unsafe_raw_expr(tt, node_f1(node), src, caller_eff) + check_imported_unsafe_raw_expr_list(tt, node_f3(node), nlist_len(node_f3(node)), src, caller_eff)
      45 -> check_imported_unsafe_raw_expr(tt, node_f1(node), src, caller_eff)
      46 -> check_imported_unsafe_raw_expr(tt, node_f1(node), src, caller_eff) + check_imported_unsafe_raw_expr(tt, node_f2(node), src, caller_eff)
      47 -> check_imported_unsafe_raw_expr(tt, node_f3(node), src, caller_eff) + check_imported_unsafe_raw_expr(tt, node_f4(node), src, caller_eff)
      48 -> check_imported_unsafe_raw_expr(tt, node_f1(node), src, caller_eff)
      49 -> check_imported_unsafe_raw_expr(tt, node_f1(node), src, caller_eff)
      52 -> check_imported_unsafe_raw_expr(tt, node_f1(node), src, caller_eff) + check_imported_unsafe_raw_expr(tt, node_f2(node), src, caller_eff)
      55 -> check_imported_pointer_surface_sealed(node, src) + check_imported_unsafe_raw_expr(tt, node_f2(node), src, caller_eff)
      56 -> check_imported_pointer_surface_sealed(node, src) + check_imported_unsafe_raw_expr(tt, node_f1(node), src, caller_eff)
      _ -> 0
    }
  }
}

fn check_imported_unsafe_raw_fns(fns: i64, user_src: i64, tt: i64) -[Diagnose]> i64 {
  let mut errors = 0
  let n = nlist_len(fns)
  for i in 0..n {
    let pair = nlist_get(fns, i)
    let fn_src = node_f2(pair)
    if fn_src != user_src {
      if ttable_source_is_trusted(tt, fn_src) == 1 {
        errors = errors
      } else {
        let fn_wrap = node_f1(pair)
        let inner = fn_inner(fn_wrap)
        errors = errors + check_imported_unsafe_raw_expr(tt, node_f4(inner), fn_src, fn_effects(fn_wrap))
      }
    } else { errors = errors }
  }
  errors
}

fn check_strict_root_unsafe_raw_fns(fns: i64, user_src: i64, tt: i64) -[Diagnose]> i64 {
  if ttable_source_is_strict(tt, user_src) == 1 {
    let mut errors = 0
    let n = nlist_len(fns)
    for i in 0..n {
      let pair = nlist_get(fns, i)
      let fn_src = node_f2(pair)
      if fn_src == user_src {
        let fn_wrap = node_f1(pair)
        let inner = fn_inner(fn_wrap)
        errors = errors + check_imported_unsafe_raw_expr(tt, node_f4(inner), fn_src, fn_effects(fn_wrap))
      } else { errors = errors }
    }
    errors
  } else { 0 }
}

-- Variant name lookups prefer a declaration in the caller's own source
-- (local shadows imported), falling back to first declaration in table
-- order. field selects the per-variant payload count (offset 24) or the
-- per-type tparams (entry offset 40); mode 0 returns the variant field,
-- mode 1 the entry field.
-- Variant lookup goes through a name-hash index (open-addressed,
-- 32-byte entries [name_hash, ti, vi, entry_src]) built lazily and
-- rebuilt whenever the type-entry count changes. Probe order matches
-- the old linear scan's first-match order for equal names: entries
-- insert in table order and lookups walk the same chain. The
-- local-shadows-imported preference stays in the callers' two-pass
-- (same_src_only) structure.
fn ttable_variant_index_build(tt: i64) -> i64 {
  let n = mem_load64_at(tt, 8)
  let d = mem_load64_at(tt, 0)
  let mut total = 0
  let mut ti = 0
  while ti < n {
    if mem_load64_at(d, ti * 64 + 16) == 1 { total = total + mem_load64_at(d, ti * 64 + 24) } else { 0 }
    ti = ti + 1
  }
  let mut slots = 512
  while slots < total * 4 { slots = slots * 2 }
  let idx = cg_alloc_bytes(16 + slots * 32)
  mem_store64_at(idx, 0, slots)
  mem_store64_at(idx + 8, 0, n)
  ti = 0
  while ti < n {
    if mem_load64_at(d, ti * 64 + 16) == 1 {
      let entry_src = mem_load64_at(d, ti * 64 + 48)
      let nvariants = mem_load64_at(d, ti * 64 + 24)
      let variants = mem_load64_at(d, ti * 64 + 32)
      let mut vi = 0
      while vi < nvariants {
        let v_ns = mem_load64_at(variants, vi * 40)
        let v_nl = mem_load64_at(variants, vi * 40 + 8)
        let h = str_hash(entry_src, v_ns, v_nl)
        let mut slot = h band (slots - 1)
        while mem_load64_at(idx + 16 + slot * 32, 0) != 0 { slot = (slot + 1) band (slots - 1) }
        mem_store64_at(idx + 16 + slot * 32, 0, h)
        mem_store64_at(idx + 16 + slot * 32 + 8, 0, ti)
        mem_store64_at(idx + 16 + slot * 32 + 16, 0, vi)
        mem_store64_at(idx + 16 + slot * 32 + 24, 0, entry_src)
        vi = vi + 1
      }
    } else { 0 }
    ti = ti + 1
  }
  idx
}

fn ttable_variant_index(tt: i64) -> i64 {
  let idx = mem_load64_at(tt + 80, 0)
  if idx != 0 and mem_load64_at(idx + 8, 0) == mem_load64_at(tt, 8) { idx }
  else {
    let fresh = ttable_variant_index_build(tt)
    mem_store64_at(tt + 80, 0, fresh)
    fresh
  }
}

fn ttable_variant_scan(tt: i64, src: i64, ns: i64, nl: i64, same_src_only: i64, mode: i64, missing: i64) -> i64 {
  let idx = ttable_variant_index(tt)
  let slots = mem_load64_at(idx, 0)
  let d = mem_load64_at(tt, 0)
  let h = str_hash(src, ns, nl)
  let mut slot = h band (slots - 1)
  let mut probes = 0
  let mut result = missing
  let mut done = 0
  while done == 0 and probes < slots {
    let key = mem_load64_at(idx + 16 + slot * 32, 0)
    if key == 0 { done = 1 }
    else {
      if key == h {
        let entry_src = mem_load64_at(idx + 16 + slot * 32 + 24, 0)
        if same_src_only == 0 or entry_src == src {
          let ti = mem_load64_at(idx + 16 + slot * 32 + 8, 0)
          let vi = mem_load64_at(idx + 16 + slot * 32 + 16, 0)
          let variants = mem_load64_at(d, ti * 64 + 32)
          let v_ns = mem_load64_at(variants, vi * 40)
          let v_nl = mem_load64_at(variants, vi * 40 + 8)
          if v_nl == nl and src_eq_at(src, ns, entry_src + v_ns, 0, nl) == 1 {
            -- mode 0: payload count; 1: owner tparams; 2: variant
            -- record address; 3: owner entry address.
            result = if mode == 0 { mem_load64_at(variants, vi * 40 + 24) }
              else { if mode == 1 { mem_load64_at(d, ti * 64 + 40) }
              else { if mode == 2 { variants + vi * 40 }
              else { d + ti * 64 } } }
            done = 1
          } else { 0 }
        } else { 0 }
      } else { 0 }
      if done == 0 {
        slot = (slot + 1) band (slots - 1)
        probes = probes + 1
      } else { 0 }
    }
  }
  result
}

fn ttable_variant_payload_count(tt: i64, src: i64, ns: i64, nl: i64) -> i64 {
  if tt == 0 { 0 - 1 }
  else {
    let local = ttable_variant_scan(tt, src, ns, nl, 1, 0, 0 - 1)
    if local != 0 - 1 { local }
    else { ttable_variant_scan(tt, src, ns, nl, 0, 0, 0 - 1) }
  }
}

fn ttable_variant_tparams(tt: i64, src: i64, ns: i64, nl: i64) -> i64 {
  if tt == 0 { 0 }
  else {
    -- Resolve which TYPE owns the variant with local-shadows-imported
    -- preference; payload-count success implies the same entry wins here.
    let local = if ttable_variant_scan(tt, src, ns, nl, 1, 0, 0 - 1) != 0 - 1 { 1 } else { 0 }
    if local == 1 { ttable_variant_scan(tt, src, ns, nl, 1, 1, 0) }
    else { ttable_variant_scan(tt, src, ns, nl, 0, 1, 0) }
  }
}

fn check_ident_defined(node: i64, env: i64, ft: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  let ns = node_f1(node)
  let nl = node_f2(node)
  if tenv_lookup(env, src, ns, nl) != 0 { 0 }
  else {
    if ftypes_lookup_fn_type(ft, src, ns, nl) != 0 { 0 }
    else {
      if ttable_variant_payload_count(tt, src, ns, nl) == 0 { 0 }
      else {
        typeck_error(src, ns, "type error: unknown identifier")
        1
      }
    }
  }
}

fn check_call_defined(node: i64, env: i64, ft: i64, src: i64) -[Diagnose]> i64 {
  let ns = node_f1(node)
  let nl = node_f2(node)
  if weak_ref_name(src, ns, nl) == 1 or weak_load_name(src, ns, nl) == 1 { 0 }
  else { if is_got_call_name(src, ns, nl) {
    check_got_call_known(node, src)
  }
  else { if is_intrinsic_name(src, ns, nl) == 1 and is_known_intrinsic_name(src, ns, nl) == 1 { 0 }
  else {
    let local_ty = tenv_lookup(env, src, ns, nl)
    if local_ty != 0 {
      if ty_tag(local_ty) == 6 { 0 }
      else { if ty_tag(local_ty) == 14 { 0 }
      else {
        typeck_error(src, ns, "type error: called value is not a function")
        1
      } }
    } else {
      if ftypes_lookup_params(ft, src, ns, nl) != 0 { 0 }
      else {
        typeck_error(src, ns, "type error: unknown function")
        1
      }
    }
  } }
  }
}

fn check_generic_call_target_defined(node: i64, env: i64, ft: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  let ns = node_f1(node)
  let nl = node_f2(node)
  let local_ty = tenv_lookup(env, src, ns, nl)
  if local_ty != 0 {
    if ty_tag(local_ty) == 6 {
      typeck_error(src, ns, "type error: generic call target is not generic")
      1
    } else {
      typeck_error(src, ns, "type error: called value is not a function")
      1
    }
  } else {
    let variant_payload_count = ttable_variant_payload_count(tt, src, ns, nl)
    if variant_payload_count >= 0 {
      if ttable_variant_tparams(tt, src, ns, nl) != 0 {
        0
      } else {
        typeck_error(src, ns, "type error: generic call target is not generic")
        1
      }
    } else { if ftypes_lookup_params(ft, src, ns, nl) != 0 {
      typeck_error(src, ns, "type error: generic call target is not generic")
      1
    } else {
      typeck_error(src, ns, "type error: unknown function")
      1
    } }
  }
}

fn check_field_access(node: i64, env: i64, ft: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  let base = node_f1(node)
  let field_ns = node_f2(node)
  let field_nl = node_f3(node)
  let base_ty = synth(base, env, ft, src, tt)
  let tag = ty_tag(base_ty)
  if tag == 9 {
    let idx = ttable_find_field_by_type_hash(tt, ty_f1(base_ty), src, field_ns, field_nl)
    if idx >= 0 { 0 }
    else {
      typeck_error(src, field_ns, "type error: unknown field")
      1
    }
  } else {
    if tag == 1 { 0 }
    else {
      typeck_error(src, field_ns, "type error: field access on non-record")
      1
    }
  }
}

fn check_address_of(node: i64, env: i64, ft: i64, src: i64, caller_eff: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let target = node_f2(node)
  let mutable = node_f1(node)
  let mut errors = check_effect_hash_available(effect_hash_unsafe(), src, expr_diag_pos(node), caller_eff) + check_expr(target, env, ft, src, caller_eff, tt)
  if node_tag(target) != 2 {
    typeck_error_maybe(src, expr_diag_pos(target), "type error: address-of target must be a binding")
    errors = errors + 1
  } else { if mutable == 1 {
    if tenv_lookup_mutable(env, src, node_f1(target), node_f2(target)) != 1 {
      typeck_error_maybe(src, expr_diag_pos(target), "type error: cannot take mutable pointer to immutable binding")
      errors = errors + 1
    } else { errors = errors }
  } else { errors = errors } }
  errors
}

fn check_deref(node: i64, env: i64, ft: i64, src: i64, caller_eff: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let ptr = node_f1(node)
  let mut errors = check_effect_hash_available(effect_hash_unsafe(), src, expr_diag_pos(node), caller_eff) + check_expr(ptr, env, ft, src, caller_eff, tt)
  let ptr_ty = synth(ptr, env, ft, src, tt)
  if type_is_unknown_or_any(ptr_ty) { errors }
  else { if ty_is_ptr(ptr_ty) == 1 { errors }
  else {
    typeck_error_maybe(src, expr_diag_pos(ptr), "type error: dereference of non-pointer")
    errors + 1
  } }
}

fn check_ptr_assign(node: i64, env: i64, ft: i64, src: i64, caller_eff: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let ptr = node_f1(node)
  let val = node_f2(node)
  let mut errors = check_effect_hash_available(effect_hash_unsafe(), src, expr_diag_pos(node), caller_eff) + check_expr(ptr, env, ft, src, caller_eff, tt) + check_expr(val, env, ft, src, caller_eff, tt)
  let ptr_ty = synth(ptr, env, ft, src, tt)
  if type_is_unknown_or_any(ptr_ty) { errors }
  else { if ty_is_ptr(ptr_ty) != 1 {
    typeck_error_maybe(src, expr_diag_pos(ptr), "type error: dereference of non-pointer")
    errors + 1
  } else { if ty_ptr_mutable(ptr_ty) != 1 {
    typeck_error_maybe(src, expr_diag_pos(ptr), "type error: cannot write through immutable pointer")
    errors + 1
  } else {
    let target_ty = ty_ptr_inner(ptr_ty)
    let val_ty = synth(val, env, ft, src, tt)
    if type_is_unknown_or_any(target_ty) { errors }
    else { if type_is_unknown_or_any(val_ty) { errors }
    else { if expr_matches_type_contextual(val, val_ty, target_ty, src) == 1 { errors }
    else {
      typeck_error_maybe(src, expr_diag_pos(val), "type error: pointer assignment type mismatch")
      errors + 1
    } } }
  } } }
}

fn ttable_field_type(entry: i64, entry_src: i64, caller_src: i64, field_ns: i64, field_nl: i64) -> i64 {
  let idx = ttable_field_index(entry, entry_src, caller_src, field_ns, field_nl)
  if idx < 0 { 0 }
  else {
    let fields = mem_load64_at(entry, 32)
    mem_load64_at(fields, idx * 24 + 16)
  }
}

fn ttable_lookup_by_type_hash(tt: i64, type_hash: i64) -> i64 {
  if tt == 0 { 0 }
  else {
    let n = mem_load64_at(tt, 8)
    let d = mem_load64_at(tt, 0)
    let mut i = 0
    let mut result = 0
    while i < n {
      let kind = mem_load64_at(d, i * 64 + 16)
      if kind == 0 {
        let entry_src = mem_load64_at(d, i * 64 + 48)
        let type_ns = mem_load64_at(d, i * 64)
        let type_nl = mem_load64_at(d, i * 64 + 8)
        if str_hash(entry_src, type_ns, type_nl) == type_hash {
          result = d + i * 64
          i = n
        } else { i = i + 1 }
      } else { i = i + 1 }
    }
    result
  }
}

fn typecheck_resolve_type(tt: i64, name_src: i64, name_start: i64, name_len: i64) -> i64 {
  let entry = ttable_lookup(tt, name_src, name_start, name_len)
  if entry == 0 { 0 }
  else {
    let kind = mem_load64_at(entry, 16)
    if kind == 0 {
      let entry_src = mem_load64_at(entry, 48)
      let ns = mem_load64_at(entry, 0)
      let nl = mem_load64_at(entry, 8)
      ty_named(mem_load64_at(entry, 56), ty_i64())
    } else { 0 }
  }
}

fn typecheck_resolve_field_type(tt: i64, base_ty: i64, field_src: i64, field_start: i64, field_len: i64) -> i64 {
  if base_ty == 0 { 0 }
  else { if ty_tag(base_ty) != 9 { 0 }
  else {
    let entry = ttable_lookup_by_type_hash(tt, ty_f1(base_ty))
    if entry == 0 { 0 }
    else {
      let entry_src = mem_load64_at(entry, 48)
      ttable_field_type(entry, entry_src, field_src, field_start, field_len)
    }
  } }
}

fn typecheck_subtype(tt: i64, actual_ty: i64, expected_ty: i64) -> i64 {
  if actual_ty == 0 or expected_ty == 0 { 0 }
  else {
    let ct = ttable_get_ct(tt)
    handle is_subtype(actual_ty, expected_ty) {
      Conformance.conforms(th, trh) -> {
        if ct == 0 { resume(0) } else { resume(ctable_conforms(ct, th, trh)) }
      }
    }
  }
}

fn record_init_has_literal_field(fields: i64, nfields: i64, src: i64, entry_src: i64, field_ns: i64, field_nl: i64) -> bool {
  let mut found = false
  let mut i = 0
  while i < nfields {
    let field = nlist_get(fields, i)
    if node_f2(field) == field_nl {
      if src_eq_at(src, node_f1(field), entry_src + field_ns, 0, field_nl) == 1 {
        found = true
        i = nfields
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  found
}

fn check_record_init_duplicate_fields(fields: i64, nfields: i64, src: i64) -[Diagnose]> i64 {
  let mut errors = 0
  for i in 0..nfields {
    let field = nlist_get(fields, i)
    let f_ns = node_f1(field)
    let f_nl = node_f2(field)
    let mut j = i + 1
    while j < nfields {
      let other = nlist_get(fields, j)
      if node_f2(other) == f_nl {
        if src_eq_at(src, node_f1(other), src + f_ns, 0, f_nl) == 1 {
          typeck_error(src, node_f1(other), "type error: duplicate record field")
          errors = errors + 1
        } else { 0 }
      } else { 0 }
      j = j + 1
    }
  }
  errors
}

fn check_record_init_shape(node: i64, env: i64, ft: i64, src: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  if tt == 0 { 0 }
  else {
    let type_ns = node_f1(node)
    let type_nl = node_f2(node)
    let fields = node_f3(node)
    let nfields = node_f4(node)
    let entry = ttable_lookup(tt, src, type_ns, type_nl)
    if entry == 0 {
      typeck_error(src, type_ns, "type error: unknown record type")
      1
    } else {
      let kind = mem_load64_at(entry, 16)
      if kind != 0 {
        typeck_error(src, type_ns, "type error: not a record type")
        1
      } else {
        let mut errors = check_record_init_duplicate_fields(fields, nfields, src)
        let entry_src = mem_load64_at(entry, 48)
        for i in 0..nfields {
          let field = nlist_get(fields, i)
          let idx = ttable_field_index(entry, entry_src, src, node_f1(field), node_f2(field))
          if idx < 0 {
            typeck_error(src, node_f1(field), "type error: unknown record field")
            errors = errors + 1
          } else {
            let expected_ty = ttable_field_type(entry, entry_src, src, node_f1(field), node_f2(field))
            if expected_ty != 0 {
              let value_ty = synth(node_f3(field), env, ft, src, tt)
              if not is_subtype(value_ty, expected_ty) {
                typeck_error(src, node_f1(field), "type error: record field type mismatch")
                errors = errors + 1
              } else { errors = errors }
            } else { errors = errors }
          }
        }
        let decl_fields = mem_load64_at(entry, 32)
        let decl_count = mem_load64_at(entry, 24)
        for di in 0..decl_count {
          let f_ns = mem_load64_at(decl_fields, di * 24)
          let f_nl = mem_load64_at(decl_fields, di * 24 + 8)
          if not record_init_has_literal_field(fields, nfields, src, entry_src, f_ns, f_nl) {
            typeck_error(src, type_ns, "type error: missing record field")
            errors = errors + 1
          } else { errors = errors }
        }
        errors
      }
    }
  }
}

fn check_call_fn_type(node: i64, fn_ty: i64, env: i64, ft: i64, src: i64, caller_eff: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let ns = node_f1(node)
  let args = node_f3(node)
  let nargs = node_f4(node)
  let params = ty_f1(fn_ty)
  let nparams = nlist_len(params)
  let mut errors = 0
  errors = errors + check_arity(nparams, nargs, src, ns)
  let callee_eff = ty_f3(fn_ty)
  if caller_eff > 0 {
    if callee_eff > 0 {
      if not effect_is_subset(callee_eff, caller_eff) {
        typeck_error(src, ns, "type error: effect not available in caller")
        errors = errors + 1
      } else { errors = errors }
    } else { errors = errors }
  } else { errors = errors }
  for i in 0..nargs {
    if i < nparams {
      errors = errors + check_arg_against_param(nlist_get(args, i), nlist_get(params, i), env, ft, src, tt, ns)
    } else { errors = errors }
  }
  errors
}

fn check_call_continuation_type(node: i64, cont_ty: i64, env: i64, ft: i64, src: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let ns = node_f1(node)
  let args = node_f3(node)
  let nargs = node_f4(node)
  let mut errors = 0
  errors = errors + check_arity(1, nargs, src, ns)
  if nargs > 0 {
    errors = errors + check_arg_against_param(nlist_get(args, 0), ty_f1(cont_ty), env, ft, src, tt, ns)
  } else { errors = errors }
  errors
}


-- Method call on a type-variable receiver, left as tag 32 by synth: check
-- name and arguments against the bound trait's method table without
-- mutating the shared template node.
fn check_tyvar_method_call(node: i64, env: i64, ft: i64, src: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let method_hash = effect_name_hash(src, node_f2(node), node_f3(node))
  let lhs = node_f1(node)
  let var_ty = tenv_lookup(env, src, node_f1(lhs), node_f2(lhs))
  let var_id = ty_f1(var_ty)
  let tparams = ttable_get_tparams(tt)
  let trait_hash = if tparams != 0 {
    if var_id < nlist_len(tparams) {
      let tp = nlist_get(tparams, var_id)
      let bounds = node_f4(tp)
      if bounds != 0 {
        if nlist_len(bounds) > 0 { nlist_get(bounds, 0) } else { 0 }
      } else { 0 }
    } else { 0 }
  } else { 0 }
  if trait_hash == 0 { 0 }
  else {
    let params = ttable_lookup_method_params(tt, trait_hash, method_hash)
    let mut errors = 0
    let args = node_f4(node)
    let nargs = nlist_len(args)
    if params != 0 {
      let nparams = nlist_len(params)
      let expected = if nparams > 0 { nparams - 1 } else { 0 }
      errors = errors + check_arity(expected, nargs, src, node_f2(node))
      for i in 0..nargs {
        if i < expected {
          let param = nlist_get(params, i + 1)
          let param_ty = node_f3(param)
          if param_ty != 0 {
            errors = errors + check_arg_against_param(nlist_get(args, i), param_ty, env, ft, src, tt, node_f2(node))
          } else { errors = errors }
        } else { errors = errors }
      }
    } else {
      if method_hash == interp_display_hash() {
        typeck_error_maybe(src, node_f2(node), "type error: unknown method 'display' — string interpolation formats values via Display; add use \"stdlib/display.weft\"")
      } else {
        typeck_error_maybe(src, node_f2(node), "type error: unknown method")
      }
      errors = errors + 1
    }
    errors
  }
}

fn check_method_call(node: i64, env: i64, ft: i64, src: i64, caller_eff: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let recv = node_f1(node)
  let method_hash = node_f2(node)
  let args = node_f3(node)
  let nargs = nlist_len(args)
  let type_hash = node_f4(node)
  let params = ttable_lookup_method_params(tt, type_hash, method_hash)
  let mut errors = 0
  if params != 0 {
    let nparams = nlist_len(params)
    let expected = if nparams > 0 { nparams - 1 } else { 0 }
    errors = errors + check_arity(expected, nargs, src, expr_diag_pos(recv))
    for i in 0..nargs {
      if i < expected {
        let param = nlist_get(params, i + 1)
        let param_ty = node_f3(param)
        if param_ty != 0 {
          errors = errors + check_arg_against_param(nlist_get(args, i), param_ty, env, ft, src, tt, expr_diag_pos(recv))
        } else { errors = errors }
      } else { errors = errors }
    }
  } else {
    let recv_ty = synth(recv, env, ft, src, tt)
    if type_is_unknown_or_any(recv_ty) { errors = errors }
    else {
      let pos = expr_diag_pos(recv)
      if method_hash == interp_display_hash() {
        typeck_error_maybe(src, pos, "type error: unknown method 'display' — string interpolation formats values via Display; add use \"stdlib/display.weft\"")
      } else {
        typeck_error_maybe(src, pos, "type error: unknown method")
      }
      errors = errors + 1
    }
  }
  let method_eff = ttable_lookup_method_effects(tt, type_hash, method_hash)
  if caller_eff > 0 {
    if method_eff > 0 {
      if not effect_is_subset(method_eff, caller_eff) {
        let pos = expr_diag_pos(recv)
        typeck_error_maybe(src, pos, "type error: effect not available in caller")
        errors = errors + 1
      } else { errors = errors }
    } else { errors = errors }
  } else { errors = errors }
  errors
}

fn lookup_handler_clause_op(clause: i64, src: i64, tt: i64) -> i64 {
  let names = node_f1(clause)
  if tt == 0 { 0 }
  else {
    let entry = ttable_lookup(tt, src, node_f1(names), node_f2(names))
    if entry == 0 { 0 }
    else {
      let kind = mem_load64_at(entry, 16)
      if kind != 2 { 0 }
      else {
        let entry_src = mem_load64_at(entry, 48)
        let op_hash = effect_name_hash(src, node_f3(names), node_f4(names))
        let nops = mem_load64_at(entry, 24)
        let ops = mem_load64_at(entry, 32)
        let mut i = 0
        let mut result = 0
        while i < nops {
          let op = nlist_get(ops, i)
          let op_name_hash = effect_name_hash(entry_src, node_f1(op), node_f2(op))
          if op_name_hash == op_hash {
            result = op
            i = nops
          } else { i = i + 1 }
        }
        result
      }
    }
  }
}

fn handler_clause_matches_perform_node(clause: i64, node: i64, src: i64) -> i64 {
  if node == 0 { 0 }
  else { if node_tag(node) != 32 { 0 }
  else {
    let lhs = node_f1(node)
    if node_tag(lhs) != 2 { 0 }
    else {
      let names = node_f1(clause)
      if effect_name_hash(src, node_f1(names), node_f2(names)) != effect_name_hash(src, node_f1(lhs), node_f2(lhs)) { 0 }
      else { if effect_name_hash(src, node_f3(names), node_f4(names)) == effect_name_hash(src, node_f2(node), node_f3(node)) { 1 } else { 0 } }
    }
  } }
}

fn deferred_split_pure_context(node: i64) -> bool {
  if node == 0 { true }
  else {
    match node_tag(node) {
      1 -> true
      2 -> true
      3 -> deferred_split_pure_context(node_f2(node)) and deferred_split_pure_context(node_f3(node))
      5 -> deferred_split_pure_context(node_f1(node)) and deferred_split_pure_context(node_f2(node)) and deferred_split_pure_context(node_f3(node))
      24 -> true
      _ -> false
    }
  }
}

fn deferred_split_args_pure(args: i64, n: i64) -> i64 {
  let mut ok = 1
  let mut i = 0
  while i < n {
    if deferred_split_pure_context(nlist_get(args, i)) == 0 {
      ok = 0
      i = n
    } else { i = i + 1 }
  }
  ok
}

fn deferred_split_type_is_managed(ty: i64) -> bool {
  if ty == 0 { false }
  else { if ty_is_rc(ty) == 1 { true }
  else { if ty_tag(ty) == 6 { true }
  else { if typeck_ty_is_weak_managed_ref(ty) == 1 { true } else { false } } } }
}

fn deferred_split_name_in_params(params: i64, src: i64, ns: i64, nl: i64) -> bool {
  let mut found = false
  let mut i = 0
  let n = nlist_len(params)
  while i < n {
    let p = nlist_get(params, i)
    if node_f2(p) == nl and src_eq_at(src, ns, src + node_f1(p), 0, nl) == 1 {
      found = 1
      i = n
    } else { i = i + 1 }
  }
  found
}

fn deferred_split_expr_refs_only_params(node: i64, params: i64, src: i64) -> bool {
  if node == 0 { true }
  else {
    match node_tag(node) {
      1 -> true
      2 -> deferred_split_name_in_params(params, src, node_f1(node), node_f2(node))
      3 -> deferred_split_expr_refs_only_params(node_f2(node), params, src) and deferred_split_expr_refs_only_params(node_f3(node), params, src)
      5 -> deferred_split_expr_refs_only_params(node_f1(node), params, src) and deferred_split_expr_refs_only_params(node_f2(node), params, src) and deferred_split_expr_refs_only_params(node_f3(node), params, src)
      24 -> true
      _ -> false
    }
  }
}

fn deferred_split_param_type_by_name(params: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let mut result = 0
  let mut i = 0
  let n = nlist_len(params)
  while i < n {
    let p = nlist_get(params, i)
    if node_f2(p) == nl and src_eq_at(src, ns, src + node_f1(p), 0, nl) == 1 {
      result = node_f3(p)
      i = n
    } else { i = i + 1 }
  }
  result
}

fn deferred_split_expr_refs_managed_param(node: i64, params: i64, src: i64) -> bool {
  if node == 0 { false }
  else {
    match node_tag(node) {
      1 -> false
      2 -> deferred_split_type_is_managed(deferred_split_param_type_by_name(params, src, node_f1(node), node_f2(node)))
      3 -> deferred_split_expr_refs_managed_param(node_f2(node), params, src) or deferred_split_expr_refs_managed_param(node_f3(node), params, src)
      5 -> deferred_split_expr_refs_managed_param(node_f1(node), params, src) or deferred_split_expr_refs_managed_param(node_f2(node), params, src) or deferred_split_expr_refs_managed_param(node_f3(node), params, src)
      24 -> false
      _ -> false
    }
  }
}

fn deferred_split_target_args_supported(target: i64, params: i64, src: i64) -> i64 {
  let args = node_f4(target)
  let n = nlist_len(args)
  let mut ok = 1
  let mut i = 0
  while i < n {
    let arg = nlist_get(args, i)
    if deferred_split_pure_context(arg) == 0 or deferred_split_expr_refs_only_params(arg, params, src) == 0 or deferred_split_expr_refs_managed_param(arg, params, src) == 1 {
      ok = 0
      i = n
    } else { i = i + 1 }
  }
  ok
}

fn deferred_split_function_call_supports_clause(node: i64, clause: i64, src: i64, ft: i64) -> bool {
  if node_tag(node) != 4 { false }
  else {
    let params = ftypes_lookup_params(ft, src, node_f1(node), node_f2(node))
    let nargs = node_f4(node)
    if params == 0 { false }
    else { if nlist_len(params) != nargs { false }
    else { if deferred_split_args_pure(node_f3(node), nargs) == 0 { false }
  else {
    let body = ftypes_lookup_body(ft, src, node_f1(node), node_f2(node))
    if body == 0 { false }
    else {
      let target = deferred_split_find_target(body, clause, src, ft)
      if target == 0 { false }
      else { if deferred_split_target_args_supported(target, params, src) == 0 { false }
      else { deferred_split_body_supports_clause(body, clause, src, ft) } }
    }
  } } } }
}

fn deferred_split_find_target(node: i64, clause: i64, src: i64, ft: i64) -> i64 {
  if node == 0 { 0 }
  else { if handler_clause_matches_perform_node(clause, node, src) == 1 { node }
  else {
    match node_tag(node) {
      3 -> {
        let left = deferred_split_find_target(node_f2(node), clause, src, ft)
        if left != 0 { left } else { deferred_split_find_target(node_f3(node), clause, src, ft) }
      }
      6 -> deferred_split_find_target(node_f3(node), clause, src, ft)
      7 -> deferred_split_find_target(node_f1(node), clause, src, ft)
      37 -> deferred_split_find_target(node_f1(node), clause, src, ft)
      _ -> 0
    }
  } }
}

fn deferred_split_body_supports_clause(node: i64, clause: i64, src: i64, ft: i64) -> bool {
  if node == 0 { false }
  else { if handler_clause_matches_perform_node(clause, node, src) == 1 { true }
  else {
    match node_tag(node) {
      3 -> {
        let left = node_f2(node)
        let right = node_f3(node)
        (deferred_split_body_supports_clause(left, clause, src, ft) and deferred_split_pure_context(right)) or
        (deferred_split_body_supports_clause(right, clause, src, ft) and deferred_split_pure_context(left))
      }
      6 -> {
        deferred_split_body_supports_clause(node_f3(node), clause, src, ft) and deferred_split_pure_context(node_f4(node))
      }
      7 -> {
        deferred_split_body_supports_clause(node_f1(node), clause, src, ft) and deferred_split_pure_context(node_f2(node))
      }
      4 -> deferred_split_function_call_supports_clause(node, clause, src, ft)
      37 -> deferred_split_body_supports_clause(node_f1(node), clause, src, ft)
      _ -> false
    }
  } }
}

fn deferred_fiber_count_max(left: i64, right: i64) -> i64 {
  if left < 0 or right < 0 { 0 - 1 }
  else { if left > right { left } else { right } }
}

fn deferred_fiber_count_add(left: i64, right: i64) -> i64 {
  if left < 0 or right < 0 { 0 - 1 }
  else { left + right }
}

fn deferred_fiber_count_list(list: i64, n: i64, clause: i64, src: i64, env: i64, ft: i64) -> i64 {
  let mut count = 0
  for i in 0..n {
    count = deferred_fiber_count_add(count, deferred_fiber_perform_count(nlist_get(list, i), clause, src, env, ft))
  }
  count
}

fn deferred_fiber_params_unmanaged(params: i64) -> i64 {
  if params == 0 { 0 }
  else {
    let mut ok = 1
    let mut i = 0
    while i < nlist_len(params) {
      if deferred_split_type_is_managed(node_f3(nlist_get(params, i))) == 1 {
        ok = 0
        i = nlist_len(params)
      } else { i = i + 1 }
    }
    ok
  }
}

fn deferred_fiber_body_list_has_perform(list: i64, n: i64, clause: i64, src: i64) -> bool {
  let mut found = false
  let mut i = 0
  while i < n {
    if deferred_fiber_body_has_perform(nlist_get(list, i), clause, src) == 1 {
      found = true
      i = n
    } else { i = i + 1 }
  }
  found
}

fn deferred_fiber_body_has_perform(node: i64, clause: i64, src: i64) -> bool {
  if node == 0 { false }
  else {
    match node_tag(node) {
      3 -> deferred_fiber_body_has_perform(node_f2(node), clause, src) or deferred_fiber_body_has_perform(node_f3(node), clause, src)
      4 -> deferred_fiber_body_list_has_perform(node_f3(node), node_f4(node), clause, src)
      5 -> deferred_fiber_body_has_perform(node_f1(node), clause, src) or deferred_fiber_body_has_perform(node_f2(node), clause, src) or deferred_fiber_body_has_perform(node_f3(node), clause, src)
      6 -> deferred_fiber_body_has_perform(node_f3(node), clause, src) or deferred_fiber_body_has_perform(node_f4(node), clause, src)
      7 -> deferred_fiber_body_has_perform(node_f1(node), clause, src) or deferred_fiber_body_has_perform(node_f2(node), clause, src)
      11 -> deferred_fiber_body_has_perform(node_f3(node), clause, src) or deferred_fiber_body_has_perform(node_f4(node), clause, src)
      12 -> deferred_fiber_body_has_perform(node_f3(node), clause, src)
      57 -> deferred_fiber_body_has_perform(node_f1(node), clause, src) or deferred_fiber_body_has_perform(node_f2(node), clause, src)
      13 -> deferred_fiber_body_has_perform(node_f1(node), clause, src)
      14 -> deferred_fiber_body_list_has_perform(node_f3(node), node_f4(node), clause, src)
      15 -> {
        let arms = node_f2(node)
        let n = node_f3(node)
        let mut found = deferred_fiber_body_has_perform(node_f1(node), clause, src)
        let mut i = 0
        while i < n and found == 0 {
          let arm = nlist_get(arms, i)
          let guard = node_f3(arm)
          found = if guard != 0 { deferred_fiber_body_has_perform(guard, clause, src) } else { false }
          if found == 0 { found = deferred_fiber_body_has_perform(node_f2(arm), clause, src) } else { found = found }
          i = i + 1
        }
        found
      }
      22 -> deferred_fiber_body_has_perform(node_f1(node), clause, src)
      25 -> deferred_fiber_body_has_perform(node_f1(node), clause, src)
      26 -> deferred_fiber_body_has_perform(node_f1(node), clause, src)
      32 -> if handler_clause_matches_perform_node(clause, node, src) == 1 { true }
        else { deferred_fiber_body_list_has_perform(node_f4(node), nlist_len(node_f4(node)), clause, src) }
      35 -> deferred_fiber_body_has_perform(node_f1(node), clause, src)
      36 -> {
        let call_node = node_f2(node)
        deferred_fiber_body_list_has_perform(node_f3(call_node), node_f4(call_node), clause, src)
      }
      37 -> deferred_fiber_body_has_perform(node_f1(node), clause, src)
      41 -> deferred_fiber_body_has_perform(node_f1(node), clause, src) or deferred_fiber_body_list_has_perform(node_f3(node), nlist_len(node_f3(node)), clause, src)
      45 -> deferred_fiber_body_has_perform(node_f1(node), clause, src)
      46 -> deferred_fiber_body_has_perform(node_f1(node), clause, src) or deferred_fiber_body_has_perform(node_f2(node), clause, src)
      48 -> deferred_fiber_body_has_perform(node_f1(node), clause, src)
      52 -> deferred_fiber_body_has_perform(node_f1(node), clause, src) or deferred_fiber_body_has_perform(node_f2(node), clause, src)
      _ -> false
    }
  }
}

fn deferred_fiber_call_stores_continuation(node: i64, cont: i64, src: i64) -> i64 {
  if node_tag(node) != 4 { 0 }
  else {
    let stores = src_eq(src, node_f1(node), node_f2(node), "continuation_cell_store_i64") == 1 or
      src_eq(src, node_f1(node), node_f2(node), "continuation_cell_store_i64_raw") == 1 or
      src_eq(src, node_f1(node), node_f2(node), "runtime_continuation_cell_store_i64") == 1
    if stores == 0 { 0 }
    else {
      let args = node_f3(node)
      let nargs = node_f4(node)
      let mut found = 0
      let mut i = 0
      while i < nargs {
        if continuation_direct_ref(nlist_get(args, i), cont, src) == 1 {
          found = 1
          i = nargs
        } else { i = i + 1 }
      }
      found
    }
  }
}

fn deferred_fiber_body_stores_continuation(node: i64, cont: i64, src: i64) -> bool {
  if node == 0 { false }
  else {
    match node_tag(node) {
      3 -> deferred_fiber_body_stores_continuation(node_f2(node), cont, src) or deferred_fiber_body_stores_continuation(node_f3(node), cont, src)
      4 -> if deferred_fiber_call_stores_continuation(node, cont, src) == 1 { true }
        else { deferred_fiber_list_stores_continuation(node_f3(node), node_f4(node), cont, src) }
      6 -> deferred_fiber_body_stores_continuation(node_f3(node), cont, src) or deferred_fiber_body_stores_continuation(node_f4(node), cont, src)
      7 -> deferred_fiber_body_stores_continuation(node_f1(node), cont, src) or deferred_fiber_body_stores_continuation(node_f2(node), cont, src)
      37 -> deferred_fiber_body_stores_continuation(node_f1(node), cont, src)
      _ -> false
    }
  }
}

fn deferred_fiber_list_stores_continuation(list: i64, n: i64, cont: i64, src: i64) -> bool {
  let mut found = false
  let mut i = 0
  while i < n {
    if deferred_fiber_body_stores_continuation(nlist_get(list, i), cont, src) == 1 {
      found = 1
      i = n
    } else { i = i + 1 }
  }
  found
}

fn deferred_fiber_clause_stores_continuation(clause: i64, src: i64) -> i64 {
  let cont = node_f4(clause)
  if cont == 0 { 0 } else { deferred_fiber_body_stores_continuation(node_f3(clause), cont, src) }
}

fn deferred_fiber_direct_call_supported(node: i64, clause: i64, src: i64, ft: i64) -> i64 {
  if node_tag(node) != 4 { 0 }
  else {
    let params = ftypes_lookup_params(ft, src, node_f1(node), node_f2(node))
    let body = ftypes_lookup_body(ft, src, node_f1(node), node_f2(node))
    let ret_ty = ftypes_lookup(ft, src, node_f1(node), node_f2(node))
    if params == 0 or body == 0 { 0 }
    else { if deferred_fiber_clause_stores_continuation(clause, src) == 0 { 0 }
    else { if nlist_len(params) != node_f4(node) { 0 }
    else { if deferred_fiber_params_unmanaged(params) == 0 { 0 }
    else { if deferred_split_type_is_managed(ret_ty) == 1 { 0 }
    else { if deferred_fiber_body_has_perform(body, clause, src) == 1 { 1 } else { 0 } } } } } }
  }
}

fn deferred_fiber_dynamic_call_supported(node: i64, clause: i64, src: i64, env: i64) -> i64 {
  0
}

fn deferred_fiber_perform_count(node: i64, clause: i64, src: i64, env: i64, ft: i64) -> i64 {
  if node == 0 { 0 }
  else {
    match node_tag(node) {
      3 -> deferred_fiber_count_add(deferred_fiber_perform_count(node_f2(node), clause, src, env, ft), deferred_fiber_perform_count(node_f3(node), clause, src, env, ft))
      4 -> {
        let arg_count = deferred_fiber_count_list(node_f3(node), node_f4(node), clause, src, env, ft)
        let direct_count = if deferred_fiber_direct_call_supported(node, clause, src, ft) == 1 { 1 } else { 0 }
        let callee_count = if direct_count == 1 { 1 } else { deferred_fiber_dynamic_call_supported(node, clause, src, env) }
        deferred_fiber_count_add(arg_count, callee_count)
      }
      5 -> {
        let cond_count = deferred_fiber_perform_count(node_f1(node), clause, src, env, ft)
        let then_count = deferred_fiber_perform_count(node_f2(node), clause, src, env, ft)
        let else_count = deferred_fiber_perform_count(node_f3(node), clause, src, env, ft)
        deferred_fiber_count_add(cond_count, deferred_fiber_count_max(then_count, else_count))
      }
      6 -> deferred_fiber_count_add(deferred_fiber_perform_count(node_f3(node), clause, src, env, ft), deferred_fiber_perform_count(node_f4(node), clause, src, env, ft))
      7 -> deferred_fiber_count_add(deferred_fiber_perform_count(node_f1(node), clause, src, env, ft), deferred_fiber_perform_count(node_f2(node), clause, src, env, ft))
      10 -> 0 - 1
      11 -> deferred_fiber_count_add(deferred_fiber_perform_count(node_f3(node), clause, src, env, ft), deferred_fiber_perform_count(node_f4(node), clause, src, env, ft))
      12 -> deferred_fiber_perform_count(node_f3(node), clause, src, env, ft)
      57 -> deferred_fiber_count_add(deferred_fiber_perform_count(node_f1(node), clause, src, env, ft), deferred_fiber_perform_count(node_f2(node), clause, src, env, ft))
      13 -> deferred_fiber_perform_count(node_f1(node), clause, src, env, ft)
      14 -> {
        let fields = node_f3(node)
        let nfields = node_f4(node)
        let mut count = 0
        for ri in 0..nfields {
          count = deferred_fiber_count_add(count, deferred_fiber_perform_count(node_f3(nlist_get(fields, ri)), clause, src, env, ft))
        }
        count
      }
      15 -> {
        let arms = node_f2(node)
        let n = node_f3(node)
        let mut arm_max = 0
        for i in 0..n {
          let arm = nlist_get(arms, i)
          let guard = node_f3(arm)
          let guard_count = if guard != 0 { deferred_fiber_perform_count(guard, clause, src, env, ft) } else { 0 }
          let arm_count = deferred_fiber_count_add(guard_count, deferred_fiber_perform_count(node_f2(arm), clause, src, env, ft))
          arm_max = deferred_fiber_count_max(arm_max, arm_count)
        }
        deferred_fiber_count_add(deferred_fiber_perform_count(node_f1(node), clause, src, env, ft), arm_max)
      }
      22 -> deferred_fiber_perform_count(node_f1(node), clause, src, env, ft)
      25 -> deferred_fiber_perform_count(node_f1(node), clause, src, env, ft)
      26 -> deferred_fiber_perform_count(node_f1(node), clause, src, env, ft)
      32 -> if handler_clause_matches_perform_node(clause, node, src) == 1 { 1 }
        else { deferred_fiber_count_list(node_f4(node), nlist_len(node_f4(node)), clause, src, env, ft) }
      33 -> 0 - 1
      35 -> deferred_fiber_perform_count(node_f1(node), clause, src, env, ft)
      36 -> {
        let call_node = node_f2(node)
        deferred_fiber_count_list(node_f3(call_node), node_f4(call_node), clause, src, env, ft)
      }
      37 -> deferred_fiber_perform_count(node_f1(node), clause, src, env, ft)
      41 -> deferred_fiber_count_add(deferred_fiber_perform_count(node_f1(node), clause, src, env, ft), deferred_fiber_count_list(node_f3(node), nlist_len(node_f3(node)), clause, src, env, ft))
      45 -> deferred_fiber_perform_count(node_f1(node), clause, src, env, ft)
      46 -> deferred_fiber_count_add(deferred_fiber_perform_count(node_f1(node), clause, src, env, ft), deferred_fiber_perform_count(node_f2(node), clause, src, env, ft))
      47 -> 0 - 1
      48 -> deferred_fiber_perform_count(node_f1(node), clause, src, env, ft)
      49 -> 0 - 1
      52 -> deferred_fiber_count_add(deferred_fiber_perform_count(node_f1(node), clause, src, env, ft), deferred_fiber_perform_count(node_f2(node), clause, src, env, ft))
      _ -> 0
    }
  }
}

fn deferred_fiber_handle_supports_clause(handle_body: i64, clauses: i64, nclauses: i64, clause: i64, src: i64, env: i64, ft: i64) -> bool {
  if nclauses != 1 { false }
  else { if node_f4(clause) == 0 { false }
  else { if deferred_fiber_perform_count(handle_body, clause, src, env, ft) > 0 { true } else { false } } }
}

fn check_handler_clause(clause: i64, handled_eff_hash: i64, env: i64, ft: i64, src: i64, caller_eff: i64, tt: i64, cont_ctx: i64) -[Conformance, Diagnose]> i64 {
  let names = node_f1(clause)
  let params = node_f2(clause)
  let cbody = node_f3(clause)
  let clause_eff_hash = effect_name_hash(src, node_f1(names), node_f2(names))
  let clause_eff = if handled_eff_hash == effect_hash_unsafe() {
    effect_add(caller_eff, handled_eff_hash)
  } else { caller_eff }
  let mut errors = 0
  if handled_eff_hash != 0 {
    if clause_eff_hash != handled_eff_hash {
      typeck_error(src, node_f1(names), "type error: handler clause effect mismatch")
      errors = errors + 1
    } else { errors = errors }
  } else { errors = errors }
  let op = lookup_handler_clause_op(clause, src, tt)
  if op == 0 {
    typeck_error(src, node_f3(names), "type error: unknown effect operation")
    errors = errors + 1
    errors = errors + check_resume_captures(cbody, src, 0)
    errors = errors + check_closure_mut_captures(cbody, params, nlist_len(params), env, src)
    errors = errors + check_expr(cbody, env, ft, src, clause_eff, tt)
    errors
  } else {
    let op_params = node_f3(op)
    let cont = node_f4(clause)
    let nparams = nlist_len(params)
    let noparams = nlist_len(op_params)
    errors = errors + check_arity(noparams, nparams, src, node_f3(names))
    if cont != 0 {
      if effect_op_is_deferred(op) == 0 {
        typeck_error(src, node_f1(cont), "type error: handler continuation requires deferred effect operation")
        errors = errors + 1
      } else { errors = errors }
    } else { errors = errors }
    let nbind = if nparams < noparams { nparams } else { noparams }
    let mut clause_env = env
    for pi in 0..nbind {
      let param = nlist_get(params, pi)
      let op_param = nlist_get(op_params, pi)
      let op_ty = node_f3(op_param)
      let ann_ty = node_f3(param)
      let bind_ty = if ann_ty != 0 {
        if op_ty != 0 {
          if not is_subtype(op_ty, ann_ty) {
            typeck_error(src, node_f1(param), "type error: argument type mismatch")
            errors = errors + 1
          } else { errors = errors }
        } else { errors = errors }
        ann_ty
      } else {
        if op_ty != 0 { op_ty } else { ty_any() }
      }
      clause_env = tenv_bind(clause_env, src, node_f1(param), node_f2(param), bind_ty)
    }
    let handle_result_ty = node_f1(cont_ctx)
    let allow_non_tail = node_f2(cont_ctx)
    let op_ret = effect_op_ret_type(op)
    let expected_ret = if op_ret != 0 { op_ret } else { ty_any() }
    if cont != 0 {
      clause_env = tenv_bind(clause_env, src, node_f1(cont), node_f2(cont), continuation_fn_type(expected_ret, handle_result_ty))
    } else { clause_env = clause_env }
    let body_ty = synth(cbody, clause_env, ft, src, tt)
    errors = errors + check_resume_captures(cbody, src, 0)
    errors = errors + check_continuation_usage(cbody, cont, src, allow_non_tail, ft)
    if cont != 0 {
      errors = errors + check_no_resume_with_continuation(cbody, src)
    } else { errors = errors }
    errors = errors + check_closure_mut_captures(cbody, params, nparams, env, src)
    errors = errors + check_expr(cbody, clause_env, ft, src, clause_eff, tt)
    -- A clause that never resumes aborts the handle with its value: its
    -- body types against the handle result, not the operation's return.
    let clause_ret = if cont != 0 { handle_result_ty }
      else { if clause_body_has_resume(cbody) == 1 { expected_ret } else { handle_result_ty } }
    errors = errors + check_return_values(cbody, clause_env, ft, src, clause_ret, tt)
    if not is_subtype(body_ty, clause_ret) {
      typeck_error(src, node_f3(names), "type error: resume type mismatch")
      errors = errors + 1
    } else { errors = errors }
    errors
  }
}

fn handler_clause_eff_hash(clause: i64, src: i64) -> i64 {
  let names = node_f1(clause)
  effect_name_hash(src, node_f1(names), node_f2(names))
}

fn handler_clause_op_hash(clause: i64, src: i64) -> i64 {
  let names = node_f1(clause)
  effect_name_hash(src, node_f3(names), node_f4(names))
}

fn handler_has_clause(clauses: i64, nclauses: i64, eff_hash: i64, op_hash: i64, src: i64) -> bool {
  let mut i = 0
  let mut found = false
  while i < nclauses {
    let clause = nlist_get(clauses, i)
    if handler_clause_eff_hash(clause, src) == eff_hash {
      if handler_clause_op_hash(clause, src) == op_hash {
        found = true
        i = nclauses
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  found
}

fn check_handler_duplicate_clauses(clauses: i64, nclauses: i64, src: i64) -[Diagnose]> i64 {
  let mut errors = 0
  let mut i = 0
  while i < nclauses {
    let clause = nlist_get(clauses, i)
    let eff_hash = handler_clause_eff_hash(clause, src)
    let op_hash = handler_clause_op_hash(clause, src)
    let mut j = i + 1
    while j < nclauses {
      let other = nlist_get(clauses, j)
      if handler_clause_eff_hash(other, src) == eff_hash {
        if handler_clause_op_hash(other, src) == op_hash {
          let names = node_f1(other)
          typeck_error(src, node_f3(names), "type error: duplicate handler clause")
          errors = errors + 1
        } else { errors = errors }
      } else { errors = errors }
      j = j + 1
    }
    i = i + 1
  }
  errors
}

fn check_missing_handler_clause_for_perform(node: i64, clauses: i64, nclauses: i64, handled_eff_hash: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  let lhs = node_f1(node)
  if is_effect_ident(lhs, src, tt) {
    let eff_hash = effect_name_hash(src, node_f1(lhs), node_f2(lhs))
    if eff_hash == handled_eff_hash {
      let op_hash = effect_name_hash(src, node_f2(node), node_f3(node))
      if handler_has_clause(clauses, nclauses, eff_hash, op_hash, src) {
        0
      } else {
        typeck_error(src, node_f2(node), "type error: missing handler clause")
        1
      }
    } else { 0 }
  } else { 0 }
}

fn check_missing_handler_clauses(node: i64, clauses: i64, nclauses: i64, handled_eff_hash: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  if node == 0 { 0 }
  else {
    let tag = node_tag(node)
    let mut errors = 0
    match tag {
      3 -> {
        errors = errors + check_missing_handler_clauses(node_f2(node), clauses, nclauses, handled_eff_hash, src, tt)
        errors = errors + check_missing_handler_clauses(node_f3(node), clauses, nclauses, handled_eff_hash, src, tt)
        errors
      }
      4 -> {
        let args = node_f3(node)
        let nargs = node_f4(node)
        for i in 0..nargs {
          errors = errors + check_missing_handler_clauses(nlist_get(args, i), clauses, nclauses, handled_eff_hash, src, tt)
        }
        errors
      }
      5 -> {
        errors = errors + check_missing_handler_clauses(node_f1(node), clauses, nclauses, handled_eff_hash, src, tt)
        errors = errors + check_missing_handler_clauses(node_f2(node), clauses, nclauses, handled_eff_hash, src, tt)
        errors = errors + check_missing_handler_clauses(node_f3(node), clauses, nclauses, handled_eff_hash, src, tt)
        errors
      }
      6 -> {
        errors = errors + check_missing_handler_clauses(node_f3(node), clauses, nclauses, handled_eff_hash, src, tt)
        errors = errors + check_missing_handler_clauses(node_f4(node), clauses, nclauses, handled_eff_hash, src, tt)
        errors
      }
      7 -> {
        errors = errors + check_missing_handler_clauses(node_f1(node), clauses, nclauses, handled_eff_hash, src, tt)
        errors = errors + check_missing_handler_clauses(node_f2(node), clauses, nclauses, handled_eff_hash, src, tt)
        errors
      }
      10 -> {
        errors = errors + check_missing_handler_clauses(node_f1(node), clauses, nclauses, handled_eff_hash, src, tt)
        errors = errors + check_missing_handler_clauses(node_f2(node), clauses, nclauses, handled_eff_hash, src, tt)
        errors
      }
      11 -> {
        errors = errors + check_missing_handler_clauses(node_f3(node), clauses, nclauses, handled_eff_hash, src, tt)
        errors = errors + check_missing_handler_clauses(node_f4(node), clauses, nclauses, handled_eff_hash, src, tt)
        errors
      }
      12 -> check_missing_handler_clauses(node_f3(node), clauses, nclauses, handled_eff_hash, src, tt)
      57 -> check_missing_handler_clauses(node_f1(node), clauses, nclauses, handled_eff_hash, src, tt) + check_missing_handler_clauses(node_f2(node), clauses, nclauses, handled_eff_hash, src, tt)
      13 -> check_missing_handler_clauses(node_f1(node), clauses, nclauses, handled_eff_hash, src, tt)
      14 -> {
        let fields = node_f3(node)
        let nfields = node_f4(node)
        for ri in 0..nfields {
          let field = nlist_get(fields, ri)
          errors = errors + check_missing_handler_clauses(node_f3(field), clauses, nclauses, handled_eff_hash, src, tt)
        }
        errors
      }
      15 -> {
        errors = errors + check_missing_handler_clauses(node_f1(node), clauses, nclauses, handled_eff_hash, src, tt)
        let arms = node_f2(node)
        let narms = node_f3(node)
        for mi in 0..narms {
          let arm = nlist_get(arms, mi)
          errors = errors + check_missing_handler_clauses(node_f2(arm), clauses, nclauses, handled_eff_hash, src, tt)
          errors = errors + check_missing_handler_clauses(node_f3(arm), clauses, nclauses, handled_eff_hash, src, tt)
        }
        errors
      }
      22 -> check_missing_handler_clauses(node_f1(node), clauses, nclauses, handled_eff_hash, src, tt)
      25 -> check_missing_handler_clauses(node_f1(node), clauses, nclauses, handled_eff_hash, src, tt)
      26 -> check_missing_handler_clauses(node_f1(node), clauses, nclauses, handled_eff_hash, src, tt)
      32 -> {
        errors = errors + check_missing_handler_clause_for_perform(node, clauses, nclauses, handled_eff_hash, src, tt)
        let args = node_f4(node)
        let nargs = nlist_len(args)
        for ai in 0..nargs {
          errors = errors + check_missing_handler_clauses(nlist_get(args, ai), clauses, nclauses, handled_eff_hash, src, tt)
        }
        errors
      }
      35 -> check_missing_handler_clauses(node_f1(node), clauses, nclauses, handled_eff_hash, src, tt)
      36 -> {
        let call_node = node_f2(node)
        let args = node_f3(call_node)
        let nargs = node_f4(call_node)
        for ai in 0..nargs {
          errors = errors + check_missing_handler_clauses(nlist_get(args, ai), clauses, nclauses, handled_eff_hash, src, tt)
        }
        errors
      }
      37 -> check_missing_handler_clauses(node_f1(node), clauses, nclauses, handled_eff_hash, src, tt)
      41 -> {
        let args = node_f3(node)
        let nargs = nlist_len(args)
        for ai in 0..nargs {
          errors = errors + check_missing_handler_clauses(nlist_get(args, ai), clauses, nclauses, handled_eff_hash, src, tt)
        }
        errors
      }
      45 -> check_missing_handler_clauses(node_f1(node), clauses, nclauses, handled_eff_hash, src, tt)
      46 -> {
        errors = errors + check_missing_handler_clauses(node_f1(node), clauses, nclauses, handled_eff_hash, src, tt)
        errors = errors + check_missing_handler_clauses(node_f2(node), clauses, nclauses, handled_eff_hash, src, tt)
        errors
      }
      47 -> {
        errors = errors + check_missing_handler_clauses(node_f3(node), clauses, nclauses, handled_eff_hash, src, tt)
        errors = errors + check_missing_handler_clauses(node_f4(node), clauses, nclauses, handled_eff_hash, src, tt)
        errors
      }
      48 -> check_missing_handler_clauses(node_f1(node), clauses, nclauses, handled_eff_hash, src, tt)
      49 -> check_missing_handler_clauses(node_f1(node), clauses, nclauses, handled_eff_hash, src, tt)
      52 -> {
        errors = errors + check_missing_handler_clauses(node_f1(node), clauses, nclauses, handled_eff_hash, src, tt)
        errors = errors + check_missing_handler_clauses(node_f2(node), clauses, nclauses, handled_eff_hash, src, tt)
        errors
      }
      _ -> errors
    }
  }
}

fn method_impl_ret(method: i64, src: i64, method_hash: i64) -> i64 {
  if node_tag(method) == 43 { 0 }
  else {
    let inner = fn_inner(method)
    let mh = effect_name_hash(src, node_f1(inner), node_f2(inner))
    if mh == method_hash { fn_ret_type(method) } else { 0 }
  }
}

fn method_impl_params(method: i64, src: i64, method_hash: i64) -> i64 {
  if node_tag(method) == 43 { 0 }
  else {
    let inner = fn_inner(method)
    let mh = effect_name_hash(src, node_f1(inner), node_f2(inner))
    if mh == method_hash { node_f3(inner) } else { 0 }
  }
}

fn method_impl_effects(method: i64, src: i64, method_hash: i64) -> i64 {
  if node_tag(method) == 43 { 0 }
  else {
    let inner = fn_inner(method)
    let mh = effect_name_hash(src, node_f1(inner), node_f2(inner))
    if mh == method_hash { fn_effects(method) } else { 0 }
  }
}

fn method_trait_ret(method: i64, src: i64, method_hash: i64) -> i64 {
  if node_tag(method) == 39 {
    let mh = effect_name_hash(src, node_f1(method), node_f2(method))
    if mh == method_hash {
      let ret_wrap = node_f4(method)
      node_f1(ret_wrap)
    } else { 0 }
  } else { 0 }
}

fn method_trait_params(method: i64, src: i64, method_hash: i64) -> i64 {
  if node_tag(method) == 39 {
    let mh = effect_name_hash(src, node_f1(method), node_f2(method))
    if mh == method_hash { node_f3(method) } else { 0 }
  } else { 0 }
}

fn method_trait_effects(method: i64, src: i64, method_hash: i64) -> i64 {
  if node_tag(method) == 39 {
    let mh = effect_name_hash(src, node_f1(method), node_f2(method))
    if mh == method_hash {
      let ret_wrap = node_f4(method)
      node_f2(ret_wrap)
    } else { 0 }
  } else { 0 }
}

fn ttable_lookup_method_ret(tt: i64, type_hash: i64, method_hash: i64) -> i64 {
  if tt == 0 { 0 }
  else {
    let n = mem_load64_at(tt, 8)
    let d = mem_load64_at(tt, 0)
    let mut i = 0
    let mut result = 0
    while i < n {
      let entry = d + i * 64
      let entry_src = mem_load64_at(entry, 48)
      let ns = mem_load64_at(entry, 0)
      let nl = mem_load64_at(entry, 8)
      let kind = mem_load64_at(entry, 16)
      if kind == 3 or kind == 4 {
        let entry_hash = mem_load64_at(entry, 56)
        if entry_hash == type_hash {
          let methods = mem_load64_at(entry, 32)
          let nmethods = mem_load64_at(entry, 24)
          let mut mi = 0
          while mi < nmethods {
            let m = nlist_get(methods, mi)
            let ret = if kind == 3 { method_trait_ret(m, entry_src, method_hash) } else { method_impl_ret(m, entry_src, method_hash) }
            if ret != 0 { result = ret mi = nmethods i = n }
            else { mi = mi + 1 }
          }
          if result == 0 { i = i + 1 } else { i = n }
        } else { i = i + 1 }
      } else { i = i + 1 }
    }
    result
  }
}

fn ttable_lookup_method_params(tt: i64, type_hash: i64, method_hash: i64) -> i64 {
  if tt == 0 { 0 }
  else {
    let n = mem_load64_at(tt, 8)
    let d = mem_load64_at(tt, 0)
    let mut i = 0
    let mut result = 0
    while i < n {
      let entry = d + i * 64
      let entry_src = mem_load64_at(entry, 48)
      let ns = mem_load64_at(entry, 0)
      let nl = mem_load64_at(entry, 8)
      let kind = mem_load64_at(entry, 16)
      if kind == 3 or kind == 4 {
        let entry_hash = mem_load64_at(entry, 56)
        if entry_hash == type_hash {
          let methods = mem_load64_at(entry, 32)
          let nmethods = mem_load64_at(entry, 24)
          let mut mi = 0
          while mi < nmethods {
            let m = nlist_get(methods, mi)
            let params = if kind == 3 { method_trait_params(m, entry_src, method_hash) } else { method_impl_params(m, entry_src, method_hash) }
            if params != 0 { result = params mi = nmethods i = n }
            else { mi = mi + 1 }
          }
          if result == 0 { i = i + 1 } else { i = n }
        } else { i = i + 1 }
      } else { i = i + 1 }
    }
    result
  }
}

fn ttable_lookup_method_effects(tt: i64, type_hash: i64, method_hash: i64) -> i64 {
  if tt == 0 { 0 }
  else {
    let n = mem_load64_at(tt, 8)
    let d = mem_load64_at(tt, 0)
    let mut i = 0
    let mut result = 0
    while i < n {
      let entry = d + i * 64
      let entry_src = mem_load64_at(entry, 48)
      let ns = mem_load64_at(entry, 0)
      let nl = mem_load64_at(entry, 8)
      let kind = mem_load64_at(entry, 16)
      if kind == 3 or kind == 4 {
        let entry_hash = mem_load64_at(entry, 56)
        if entry_hash == type_hash {
          let methods = mem_load64_at(entry, 32)
          let nmethods = mem_load64_at(entry, 24)
          let mut mi = 0
          while mi < nmethods {
            let m = nlist_get(methods, mi)
            let effects = if kind == 3 { method_trait_effects(m, entry_src, method_hash) } else { method_impl_effects(m, entry_src, method_hash) }
            if effects != 0 { result = effects mi = nmethods i = n }
            else {
              let params = if kind == 3 { method_trait_params(m, entry_src, method_hash) } else { method_impl_params(m, entry_src, method_hash) }
              if params != 0 { mi = nmethods i = n } else { mi = mi + 1 }
            }
          }
          if result == 0 { i = i + 1 } else { i = n }
        } else { i = i + 1 }
      } else { i = i + 1 }
    }
    result
  }
}

fn typeck_drop_method_hash() -> i64 {
  effect_name_hash(__str_ptr("drop"), 0, 4)
}

fn typeck_drop_trait_hash() -> i64 {
  effect_name_hash(__str_ptr("Drop"), 0, 4)
}

fn typeck_owned_drop_type_hash(ty: i64) -> i64 {
  if ty_is_owned(ty) != 1 { 0 }
  else {
    let inner = ty_owned_inner(ty)
    if inner != 0 and ty_tag(inner) == 9 { ty_f1(inner) } else { 0 }
  }
}

fn typeck_owned_drop_conforms(tt: i64, type_hash: i64) -> i64 {
  if type_hash == 0 { 0 }
  else {
    let trait_hash = typeck_drop_trait_hash()
    if lookup_trait_methods(tt, __str_ptr("Drop"), trait_hash) == 0 { 0 }
    else {
      let ct = ttable_get_ct(tt)
      if ct == 0 { 0 } else { ctable_conforms(ct, type_hash, trait_hash) }
    }
  }
}

fn check_owned_drop_effect_available(ty: i64, tt: i64, src: i64, pos: i64, caller_eff: i64) -[Diagnose]> i64 {
  let type_hash = typeck_owned_drop_type_hash(ty)
  if type_hash == 0 { 0 }
  else {
    if typeck_owned_drop_conforms(tt, type_hash) != 1 { 0 }
    else {
      let method_hash = typeck_drop_method_hash()
      let params = ttable_lookup_method_params(tt, type_hash, method_hash)
      if params == 0 { 0 }
      else {
        let drop_eff = ttable_lookup_method_effects(tt, type_hash, method_hash)
        if effect_sig_subset(drop_eff, caller_eff) { 0 }
        else {
          typeck_error_maybe(src, pos, "type error: owned Drop effect not available in caller")
          1
        }
      }
    }
  }
}

fn check_owned_drop_param_effects(params: i64, nparams: i64, tt: i64, src: i64, caller_eff: i64) -[Diagnose]> i64 {
  let mut errors = 0
  for i in 0..nparams {
    let p = nlist_get(params, i)
    errors = errors + check_owned_drop_effect_available(node_f3(p), tt, src, node_f1(p), caller_eff)
  }
  errors
}

fn check_owned_resource_root(tt: i64, src: i64, pos: i64, ty: i64) -[Diagnose]> i64 {
  let type_hash = typeck_owned_drop_type_hash(ty)
  if type_hash == 0 {
    typeck_error_maybe(src, pos, "type error: owned type requires Drop resource conformance")
    1
  } else {
    if typeck_owned_drop_conforms(tt, type_hash) == 1 { 0 }
    else {
      typeck_error_maybe(src, pos, "type error: owned type requires Drop resource conformance")
      1
    }
  }
}

fn check_owned_resource_type_list(tt: i64, src: i64, pos: i64, types: i64) -[Diagnose]> i64 {
  if types == 0 { 0 }
  else {
    let mut errors = 0
    let n = nlist_len(types)
    for i in 0..n {
      errors = errors + check_owned_resource_ty(tt, src, pos, nlist_get(types, i))
    }
    errors
  }
}

fn check_owned_resource_ty(tt: i64, src: i64, pos: i64, ty: i64) -[Diagnose]> i64 {
  if ty == 0 { 0 }
  else {
    match ty_tag(ty) {
      3 -> check_owned_resource_ty(tt, src, pos, ty_f1(ty)) + check_owned_resource_ty(tt, src, pos, ty_f2(ty))
      4 -> check_owned_resource_ty(tt, src, pos, ty_f1(ty)) + check_owned_resource_ty(tt, src, pos, ty_f2(ty))
      5 -> check_owned_resource_ty(tt, src, pos, ty_f1(ty))
      6 -> check_owned_resource_type_list(tt, src, pos, ty_f1(ty)) + check_owned_resource_ty(tt, src, pos, ty_f2(ty))
      8 -> check_owned_resource_ty(tt, src, pos, ty_f2(ty))
      9 -> check_owned_resource_type_list(tt, src, pos, ty_f3(ty))
      14 -> check_owned_resource_ty(tt, src, pos, ty_f1(ty)) + check_owned_resource_ty(tt, src, pos, ty_f2(ty))
      15 -> check_owned_resource_ty(tt, src, pos, ty_f1(ty))
      16 -> check_owned_resource_ty(tt, src, pos, ty_f1(ty))
      18 -> check_owned_resource_ty(tt, src, pos, ty_f1(ty))
      19 -> check_owned_resource_root(tt, src, pos, ty)
      _ -> 0
    }
  }
}

fn check_owned_resource_params(tt: i64, src: i64, params: i64) -[Diagnose]> i64 {
  let mut errors = 0
  let n = nlist_len(params)
  for i in 0..n {
    let p = nlist_get(params, i)
    errors = errors + check_owned_resource_ty(tt, src, node_f1(p), node_f3(p))
  }
  errors
}

fn synth_resolved_method_call(node: i64, tt: i64) -> i64 {
  let method_hash = node_f2(node)
  let type_hash = node_f4(node)
  let method_ret = ttable_lookup_method_ret(tt, type_hash, method_hash)
  if method_ret != 0 { method_ret } else { ty_any() }
}

-- Resolve a method call given the receiver type.
-- Extracts type_hash from the receiver type, mutates node to tag 41
-- so codegen can do (type_hash, method_hash) lookup.
fn synth_method_call(node: i64, recv_ty: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  -- Perform node: f1=lhs, f2=op_ns, f3=op_nl, f4=args
  let method_hash = effect_name_hash(src, node_f2(node), node_f3(node))
  -- Extract type_hash from the receiver type
  -- Must match the convention in type_name_hash (parse.weft):
  -- Primitives: i64=-1, str=-2, bool=-3, nil=-4
  -- Named types: djb2 hash stored in ty_f1
  let type_hash = if ty_tag(recv_ty) == 9 {
    -- Named type: use the name hash
    ty_f1(recv_ty)
  } else { if ty_tag(recv_ty) == 2 {
    -- Primitive type: negative ID matching type_name_hash convention
    let pid = ty_f1(recv_ty)
    0 - pid - 1
  } else { if ty_tag(recv_ty) == 12 {
    -- TypeVar: look up bound from current function's tparams
    -- The bound's trait hash becomes the type_hash for method resolution
    let var_id = ty_f1(recv_ty)
    let tparams = ttable_get_tparams(tt)
    if tparams != 0 {
      if var_id < nlist_len(tparams) {
        let tp = nlist_get(tparams, var_id)
        let bounds = node_f4(tp)
        -- Use the first bound's trait hash as the type_hash
        -- (method resolution on a bounded type var resolves to the trait)
        if bounds != 0 {
          if nlist_len(bounds) > 0 { nlist_get(bounds, 0) } else { 0 }
        } else { 0 }
      } else { 0 }
    } else { 0 }
  } else { 0 } } }
  -- Mutate the node: change tag to 41, rearrange fields for MethodCall layout
  -- Tag 41 = MethodCall: f1=receiver, f2=method_hash, f3=args, f4=type_hash
  -- Perform layout was: f1=lhs, f2=op_ns, f3=op_nl, f4=args
  -- EXCEPT for a type-variable receiver: monomorphisation owns per-
  -- specialisation method resolution, and baking the trait hash into the
  -- shared template at check time pins every specialisation to one impl
  -- (num_bit_width<i16> answered 8). Type the call here, mutate nothing.
  if ty_tag(recv_ty) == 12 { 0 }
  else {
    let args = node_f4(node)
    mem_store64_at(node, 0, 41)
    mem_store64_at(node, 16, method_hash)
    mem_store64_at(node, 24, args)
    mem_store64_at(node, 32, type_hash)
  }
  let method_ret = ttable_lookup_method_ret(tt, type_hash, method_hash)
  if method_ret != 0 { method_ret }
  else {
    let mut fi = 0
    let mut ret = ty_any()
    while fi < nlist_len(ft) {
      let e = nlist_get(ft, fi)
      let e_ns = mem_load64_at(e, 0)
      let e_nl = mem_load64_at(e, 8)
      let e_src = mem_load64_at(e, 24)
      let fn_hash = effect_name_hash(e_src, e_ns, e_nl)
      if fn_hash == method_hash {
        let e_ret = mem_load64_at(e, 16)
        ret = if e_ret != 0 { e_ret } else { ty_any() }
        fi = nlist_len(ft)
      } else { fi = fi + 1 }
    }
    ret
  }
}

fn synth_block(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  -- Block has first and rest; type is type of rest (last expr)
  let rest = node_f2(node)
  if rest == 0 { synth(node_f1(node), env, ft, src, tt) }
  else { synth(rest, env, ft, src, tt) }
}

fn synth_match(node: i64, env: i64, ft: i64, src: i64, tt: i64) -> i64 {
  let scrutinee = node_f1(node)
  let arms = node_f2(node)
  let n_arms = node_f3(node)
  let scr_ty = synth(scrutinee, env, ft, src, tt)
  if n_arms == 0 { ty_nil() }
  else { synth_match_arms(arms, n_arms, env, ft, src, scr_ty, tt) }
}

fn synth_match_arms(arms: i64, n: i64, env: i64, ft: i64, src: i64, scr_ty: i64, tt: i64) -> i64 {
  -- Synthesize union of all arm body types
  let mut result = ty_never()
  for i in 0..n {
    let arm = nlist_get(arms, i)
    let pat = node_f1(arm)
    let body = node_f2(arm)
    -- Extend env with pattern bindings
    let arm_env = bind_pattern(pat, env, src, scr_ty, tt)
    let body_ty = synth(body, arm_env, ft, src, tt)
    -- Union all arm types
    result = if ty_eq(result, ty_never()) { body_ty }
      else { if ty_eq(result, body_ty) { result }
      else { ty_union(result, body_ty) } }
  }
  result
}

fn check_match_arm_type_consistency(arms: i64, n: i64, env: i64, ft: i64, src: i64, scr_ty: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  if n < 2 { 0 }
  else {
    let first_arm = nlist_get(arms, 0)
    let first_env = bind_pattern(node_f1(first_arm), env, src, scr_ty, tt)
    let expected = synth(node_f2(first_arm), first_env, ft, src, tt)
    let mut errors = 0
    for i in 1..n {
      let arm = nlist_get(arms, i)
      let arm_env = bind_pattern(node_f1(arm), env, src, scr_ty, tt)
      let got = synth(node_f2(arm), arm_env, ft, src, tt)
      if type_is_unknown_or_any(expected) { errors = errors }
      else { if type_is_unknown_or_any(got) { errors = errors }
      -- Arms must be comparable (one a subtype of the other), not equal:
      -- bool and i64 arms form a chain under bool <: i64 and union to i64,
      -- while genuinely unrelated arms (i64 vs str) still error.
      else { if not is_subtype(got, expected) and not is_subtype(expected, got) {
        typeck_error_maybe(src, pattern_diag_pos(node_f1(arm)), "type error: match arm type mismatch")
        errors = errors + 1
      } else { errors = errors } } }
    }
    errors
  }
}

fn match_arm_is_unguarded_catch_all(arm: i64) -> i64 {
  if node_f3(arm) == 0 {
    let pat = node_f1(arm)
    match node_tag(pat) {
      17 -> 1
      18 -> 1
      _ -> 0
    }
  } else { 0 }
}

fn match_arms_have_unguarded_catch_all(arms: i64, n: i64) -> i64 {
  let mut i = 0
  let mut result = 0
  while i < n {
    if match_arm_is_unguarded_catch_all(nlist_get(arms, i)) == 1 {
      result = 1
      i = n
    } else {
      i = i + 1
    }
  }
  result
}

fn match_ctor_patterns_same(left: i64, right: i64, src: i64) -> i64 {
  if node_f2(left) == node_f2(right) {
    src_eq_at(src, node_f1(left), src + node_f1(right), 0, node_f2(left))
  } else { 0 }
}

fn check_match_duplicate_ctor_arms(arms: i64, n: i64, src: i64) -[Diagnose]> i64 {
  let mut errors = 0
  let mut i = 0
  while i < n {
    let left_arm = nlist_get(arms, i)
    let left_pat = node_f1(left_arm)
    if node_f3(left_arm) == 0 and node_tag(left_pat) == 20 {
      let mut j = i + 1
      while j < n {
        let right_arm = nlist_get(arms, j)
        let right_pat = node_f1(right_arm)
        if node_f3(right_arm) == 0 and node_tag(right_pat) == 20 {
          if match_ctor_patterns_same(left_pat, right_pat, src) == 1 {
            typeck_error(src, node_f1(right_pat), "type error: duplicate match constructor arm")
            errors = errors + 1
            j = n
          } else { j = j + 1 }
        } else { j = j + 1 }
      }
    } else { 0 }
    i = i + 1
  }
  errors
}

fn match_arm_has_unguarded_ctor(arms: i64, n: i64, src: i64, entry_src: i64, variant_ns: i64, variant_nl: i64) -> i64 {
  let mut i = 0
  let mut result = 0
  while i < n {
    let arm = nlist_get(arms, i)
    let pat = node_f1(arm)
    if node_f3(arm) == 0 and node_tag(pat) == 20 {
      if node_f2(pat) == variant_nl {
        if src_eq_at(src, node_f1(pat), entry_src + variant_ns, 0, variant_nl) == 1 {
          result = 1
          i = n
        } else { i = i + 1 }
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  result
}

fn match_arms_cover_named_type_variants(arms: i64, n_arms: i64, src: i64, entry_src: i64, variants: i64, nvariants: i64) -> i64 {
  let mut vi = 0
  let mut result = 1
  while vi < nvariants {
    let v_ns = mem_load64_at(variants, vi * 40)
    let v_nl = mem_load64_at(variants, vi * 40 + 8)
    if match_arm_has_unguarded_ctor(arms, n_arms, src, entry_src, v_ns, v_nl) == 1 {
      vi = vi + 1
    } else {
      result = 0
      vi = nvariants
    }
  }
  result
}

fn match_arms_cover_named_type(tt: i64, src: i64, arms: i64, n_arms: i64, type_hash: i64) -> i64 {
  if tt == 0 { 0 }
  else {
    let n = mem_load64_at(tt, 8)
    let d = mem_load64_at(tt, 0)
    let mut ti = 0
    let mut result = 0
    while ti < n {
      let kind = mem_load64_at(d, ti * 64 + 16)
      if kind == 1 {
        let entry_src = mem_load64_at(d, ti * 64 + 48)
        let type_ns = mem_load64_at(d, ti * 64)
        let type_nl = mem_load64_at(d, ti * 64 + 8)
        if mem_load64_at(d, ti * 64 + 56) == type_hash {
          result = match_arms_cover_named_type_variants(arms, n_arms, src, entry_src, mem_load64_at(d, ti * 64 + 32), mem_load64_at(d, ti * 64 + 24))
          ti = n
        } else { ti = ti + 1 }
      } else { ti = ti + 1 }
    }
    result
  }
}

fn check_match_exhaustive(arms: i64, n: i64, src: i64, scr_ty: i64, tt: i64, pos: i64) -[Conformance, Diagnose]> i64 {
  if n == 0 {
    typeck_error_maybe(src, pos, "type error: non-exhaustive match")
    1
  } else { if match_arms_have_unguarded_catch_all(arms, n) == 1 {
    0
  } else { if type_is_unknown_or_any(scr_ty) {
    0
  } else {
    match ty_tag(scr_ty) {
      9 -> {
        if match_arms_cover_named_type(tt, src, arms, n, ty_f1(scr_ty)) == 1 { 0 }
        else {
          typeck_error_maybe(src, pos, "type error: non-exhaustive match")
          1
        }
      }
      _ -> {
        if not ty_is_empty(ty_inter(scr_ty, ty_i64())) {
          typeck_error_maybe(src, pos, "type error: non-exhaustive match")
          1
        } else { 0 }
      }
    }
  } } }
}

fn variant_payload_type(tt: i64, src: i64, tag_ns: i64, tag_nl: i64, scr_ty: i64, idx: i64) -> i64 {
  if tt == 0 { ty_i64() }
  else { if ty_tag(scr_ty) != 9 { ty_i64() }
  else {
    let type_hash = ty_f1(scr_ty)
    let type_args = ty_f3(scr_ty)
    let n = mem_load64_at(tt, 8)
    let d = mem_load64_at(tt, 0)
    let mut ti = 0
    let mut result = ty_i64()
    while ti < n {
      let kind = mem_load64_at(d, ti * 64 + 16)
      if kind == 1 {
        let entry_src = mem_load64_at(d, ti * 64 + 48)
        let type_ns = mem_load64_at(d, ti * 64)
        let type_nl = mem_load64_at(d, ti * 64 + 8)
        if mem_load64_at(d, ti * 64 + 56) == type_hash {
          let nvariants = mem_load64_at(d, ti * 64 + 24)
          let variants = mem_load64_at(d, ti * 64 + 32)
          let tparams = mem_load64_at(d, ti * 64 + 40)
          let mut vi = 0
          while vi < nvariants {
            let v_ns = mem_load64_at(variants, vi * 40)
            let v_nl = mem_load64_at(variants, vi * 40 + 8)
            if v_nl == tag_nl {
              if src_eq_at(src, tag_ns, entry_src + v_ns, 0, tag_nl) == 1 {
                let npayloads = mem_load64_at(variants, vi * 40 + 24)
                let payloads = mem_load64_at(variants, vi * 40 + 32)
                if idx < npayloads {
                  let pty = if payloads != 0 { nlist_get(payloads, idx) } else { ty_i64() }
                  if tparams != 0 {
                    if type_args != 0 { result = ty_subst(pty, build_subst(tparams, type_args)) }
                    else { result = pty }
                  } else { result = pty }
                } else { result = ty_i64() }
                vi = nvariants
                ti = n
              } else { vi = vi + 1 }
            } else { vi = vi + 1 }
          }
          if ti < n { ti = ti + 1 } else { ti = ti }
        } else { ti = ti + 1 }
      } else { ti = ti + 1 }
    }
    result
  } }
}

fn bind_ctor_pattern(pat: i64, env: i64, src: i64, scr_ty: i64, tt: i64) -> i64 {
  let tag_ns = node_f1(pat)
  let tag_nl = node_f2(pat)
  let b_ns = node_f3(pat)
  let b_nl = node_f4(pat)
  if b_nl > 0 {
    tenv_bind(env, src, b_ns, b_nl, variant_payload_type(tt, src, tag_ns, tag_nl, scr_ty, 0))
  } else { if b_nl < 0 {
    let bindings = b_ns
    let nb = 0 - b_nl
    let mut result = env
    for i in 0..nb {
      let b = nlist_get(bindings, i)
      if node_tag(b) == 18 {
        result = tenv_bind(result, src, node_f1(b), node_f2(b), variant_payload_type(tt, src, tag_ns, tag_nl, scr_ty, i))
      } else { result = result }
    }
    result
  } else { env } }
}

-- Bind pattern variables to the environment with the scrutinee type
fn bind_pattern(pat: i64, env: i64, src: i64, scr_ty: i64, tt: i64) -> i64 {
  let tag = node_tag(pat)
  match tag {
    -- Wildcard: no bindings
    17 -> env
    -- Binding: bind name to scrutinee type
    18 -> tenv_bind(env, src, node_f1(pat), node_f2(pat), scr_ty)
    -- IntLit pattern: no bindings
    19 -> env
    -- Constructor pattern: bind payload variables from the variant declaration.
    20 -> bind_ctor_pattern(pat, env, src, scr_ty, tt)
    _ -> env
  }
}

fn ctor_pattern_binding_count(pat: i64) -> i64 {
  let b_nl = node_f4(pat)
  if b_nl > 0 { 1 }
  else { if b_nl < 0 { 0 - b_nl } else { 0 } }
}

fn variant_payload_count_in_named_type(tt: i64, src: i64, tag_ns: i64, tag_nl: i64, type_hash: i64) -> i64 {
  if tt == 0 { 0 - 1 }
  else {
    let n = mem_load64_at(tt, 8)
    let d = mem_load64_at(tt, 0)
    let mut result = 0 - 1
    let mut ti = 0
    while ti < n {
      let kind = mem_load64_at(d, ti * 64 + 16)
      if kind == 1 {
        let entry_src = mem_load64_at(d, ti * 64 + 48)
        let type_ns = mem_load64_at(d, ti * 64)
        let type_nl = mem_load64_at(d, ti * 64 + 8)
        if mem_load64_at(d, ti * 64 + 56) == type_hash {
          let nvariants = mem_load64_at(d, ti * 64 + 24)
          let variants = mem_load64_at(d, ti * 64 + 32)
          let mut vi = 0
          while vi < nvariants {
            let v_ns = mem_load64_at(variants, vi * 40)
            let v_nl = mem_load64_at(variants, vi * 40 + 8)
            if v_nl == tag_nl {
              if src_eq_at(src, tag_ns, entry_src + v_ns, 0, tag_nl) == 1 {
                result = mem_load64_at(variants, vi * 40 + 24)
                vi = nvariants
                ti = n
              } else { vi = vi + 1 }
            } else { vi = vi + 1 }
          }
          if ti < n { ti = ti + 1 } else { ti = ti }
        } else { ti = ti + 1 }
      } else { ti = ti + 1 }
    }
    result
  }
}

fn pattern_diag_pos(pat: i64) -> i64 {
  let tag = node_tag(pat)
  match tag {
    18 -> node_f1(pat)
    19 -> if node_f3(pat) > 0 { node_f2(pat) } else { node_f1(pat) }
    20 -> node_f1(pat)
    _ -> 0
  }
}

fn check_pattern(pat: i64, scr_ty: i64, src: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let tag = node_tag(pat)
  match tag {
    19 -> check_int_pattern(pat, scr_ty, src)
    20 -> check_ctor_pattern(pat, scr_ty, src, tt)
    _ -> 0
  }
}

fn check_int_pattern(pat: i64, scr_ty: i64, src: i64) -[Conformance, Diagnose]> i64 {
  if type_is_unknown_or_any(scr_ty) { 0 }
  else {
    let prim = type_int_prim(scr_ty)
    if prim >= 0 {
      if int_literal_positive_fits_prim(pat, prim, src) == 1 { 0 }
      else {
        typeck_error(src, pattern_diag_pos(pat), "type error: literal pattern does not match scrutinee")
        1
      }
    } else { if ty_is_empty(ty_inter(scr_ty, ty_i64())) {
      typeck_error(src, pattern_diag_pos(pat), "type error: literal pattern does not match scrutinee")
      1
    } else { 0 } }
  }
}

fn check_ctor_pattern(pat: i64, scr_ty: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  let tag_ns = node_f1(pat)
  let tag_nl = node_f2(pat)
  let global_count = ttable_variant_payload_count(tt, src, tag_ns, tag_nl)
  if global_count < 0 {
    typeck_error(src, tag_ns, "type error: unknown constructor pattern")
    1
  } else {
    let payload_count = if type_is_unknown_or_any(scr_ty) {
      global_count
    } else { if ty_tag(scr_ty) == 9 {
      variant_payload_count_in_named_type(tt, src, tag_ns, tag_nl, ty_f1(scr_ty))
    } else { 0 - 1 } }
    if payload_count < 0 {
      typeck_error(src, tag_ns, "type error: constructor pattern does not match scrutinee")
      1
    } else {
      let bind_count = ctor_pattern_binding_count(pat)
      if bind_count == payload_count { 0 }
      else {
        typeck_error(src, tag_ns, "type error: constructor pattern arity mismatch")
        1
      }
    }
  }
}

-- ══════════════════════════════════════════════════════════════
-- Type checking: verify type constraints
-- ══════════════════════════════════════════════════════════════

-- Check a binary operation's operand types
fn check_binop(node: i64, env: i64, ft: i64, src: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let op = node_f1(node)
  let lhs = node_f2(node)
  let rhs = node_f3(node)
  let lhs_ty = synth(lhs, env, ft, src, tt)
  let rhs_ty = synth(rhs, env, ft, src, tt)
  -- Use LHS position for error reporting (best available)
  let pos = expr_diag_pos(lhs)
  match op {
    1 -> check_arith_operand_node(op, lhs, rhs, lhs_ty, rhs_ty, src, pos)
    2 -> check_arith_operand_node(op, lhs, rhs, lhs_ty, rhs_ty, src, pos)
    3 -> check_arith_operand_node(op, lhs, rhs, lhs_ty, rhs_ty, src, pos)
    4 -> check_arith_operand_node(op, lhs, rhs, lhs_ty, rhs_ty, src, pos)
    5 -> check_equality_operand(lhs, rhs, lhs_ty, rhs_ty, src, pos)
    6 -> check_equality_operand(lhs, rhs, lhs_ty, rhs_ty, src, pos)
    7 -> check_order_operand(lhs, rhs, lhs_ty, rhs_ty, src, pos)
    8 -> check_order_operand(lhs, rhs, lhs_ty, rhs_ty, src, pos)
    9 -> check_order_operand(lhs, rhs, lhs_ty, rhs_ty, src, pos)
    10 -> check_order_operand(lhs, rhs, lhs_ty, rhs_ty, src, pos)
    11 -> check_integer_operand_node(lhs, rhs, lhs_ty, rhs_ty, src, pos, "type error: arithmetic operand is not i64", "type error: arithmetic operand type mismatch")
    12 -> check_logical_operand(lhs_ty, rhs_ty, src, pos)
    13 -> check_logical_operand(lhs_ty, rhs_ty, src, pos)
    14 -> check_integer_operand_node(lhs, rhs, lhs_ty, rhs_ty, src, pos, "type error: bitwise operand is not i64", "type error: bitwise operand type mismatch")
    15 -> check_integer_operand_node(lhs, rhs, lhs_ty, rhs_ty, src, pos, "type error: bitwise operand is not i64", "type error: bitwise operand type mismatch")
    16 -> check_integer_operand_node(lhs, rhs, lhs_ty, rhs_ty, src, pos, "type error: bitwise operand is not i64", "type error: bitwise operand type mismatch")
    17 -> check_integer_operand_node(lhs, rhs, lhs_ty, rhs_ty, src, pos, "type error: bitwise operand is not i64", "type error: bitwise operand type mismatch")
    18 -> check_integer_operand_node(lhs, rhs, lhs_ty, rhs_ty, src, pos, "type error: bitwise operand is not i64", "type error: bitwise operand type mismatch")
    _ -> 0
  }
}

fn check_equality_operand(lhs: i64, rhs: i64, lhs_ty: i64, rhs_ty: i64, src: i64, pos: i64) -[Conformance, Diagnose]> i64 {
  if type_is_unknown_or_any(lhs_ty) { 0 }
  else { if type_is_unknown_or_any(rhs_ty) { 0 }
  else { if is_subtype(lhs_ty, ty_i64()) and is_subtype(rhs_ty, ty_i64()) { 0 }
  else { if type_is_integer_exact(lhs_ty) == 1 or type_is_integer_exact(rhs_ty) == 1 {
    let prim = int_binop_candidate_prim(lhs_ty, rhs_ty)
    if expr_matches_int_prim_contextual(lhs, lhs_ty, prim, src) == 1 and expr_matches_int_prim_contextual(rhs, rhs_ty, prim, src) == 1 { 0 }
    else {
      typeck_error_maybe(src, pos, "type error: equality operand mismatch")
      1
    }
  }
  else { if (type_is_f32_exact(lhs_ty) == 1 or type_is_f32_exact(rhs_ty) == 1) and expr_matches_f32_contextual(lhs, lhs_ty) == 1 and expr_matches_f32_contextual(rhs, rhs_ty) == 1 { 0 }
  else { if type_is_f64_exact(lhs_ty) and type_is_f64_exact(rhs_ty) { 0 }
  else { if type_nullable_equality_compatible(lhs_ty, rhs_ty) == 1 { 0 }
  else { if is_subtype(lhs_ty, rhs_ty) {
    if is_subtype(rhs_ty, lhs_ty) { 0 }
    else {
      typeck_error_maybe(src, pos, "type error: equality operand mismatch")
      1
    }
  } else {
    typeck_error_maybe(src, pos, "type error: equality operand mismatch")
    1
  } } } } } } } }
}

fn check_i64_operand(lhs_ty: i64, rhs_ty: i64, src: i64, pos: i64, msg: str) -[Conformance, Diagnose]> i64 {
  let mut errors = 0
  if type_is_unknown_or_any(lhs_ty) { errors = errors }
  else { if not is_subtype(lhs_ty, ty_i64()) {
    typeck_error_maybe(src, pos, msg)
    errors = errors + 1
  } else { errors = errors } }
  if type_is_unknown_or_any(rhs_ty) { errors = errors }
  else { if not is_subtype(rhs_ty, ty_i64()) {
    typeck_error_maybe(src, pos, msg)
    errors = errors + 1
  } else { errors = errors } }
  errors
}

fn check_numeric_pair_or_legacy(lhs: i64, rhs: i64, lhs_ty: i64, rhs_ty: i64, src: i64, pos: i64, legacy_msg: str, mismatch_msg: str) -[Diagnose]> i64 {
  if type_is_unknown_or_any(lhs_ty) or type_is_unknown_or_any(rhs_ty) { 0 }
  else {
    let prim = int_binop_candidate_prim(lhs_ty, rhs_ty)
    let both_int = expr_matches_int_prim_contextual(lhs, lhs_ty, prim, src) == 1 and expr_matches_int_prim_contextual(rhs, rhs_ty, prim, src) == 1
    let both_f32 = (type_is_f32_exact(lhs_ty) == 1 or type_is_f32_exact(rhs_ty) == 1) and expr_matches_f32_contextual(lhs, lhs_ty) == 1 and expr_matches_f32_contextual(rhs, rhs_ty) == 1
    let lhs_f = type_is_f64_exact(lhs_ty)
    let rhs_f = type_is_f64_exact(rhs_ty)
    if both_int { 0 }
    else { if both_f32 { 0 }
    else { if lhs_f and rhs_f { 0 }
    else { if type_is_numeric(lhs_ty) and type_is_numeric(rhs_ty) {
      typeck_error_maybe(src, pos, mismatch_msg)
      1
    } else {
      let mut errors = 0
      if not type_is_numeric(lhs_ty) {
        typeck_error_maybe(src, pos, legacy_msg)
        errors = errors + 1
      } else { errors = errors }
      if not type_is_numeric(rhs_ty) {
        typeck_error_maybe(src, pos, legacy_msg)
        errors = errors + 1
      } else { errors = errors }
      errors
    } } } }
  }
}

fn check_arith_operand_node(op: i64, lhs: i64, rhs: i64, lhs_ty: i64, rhs_ty: i64, src: i64, pos: i64) -[Diagnose]> i64 {
  if op == 2 and expr_is_zero_i64_lit(lhs) and node_tag(rhs) == 1 { 0 }
  else { if op == 2 and expr_is_zero_i64_lit(lhs) and type_is_f64_exact(rhs_ty) { 0 }
  else { if op == 2 and expr_is_zero_i64_lit(lhs) and type_is_f32_exact(rhs_ty) { 0 }
  else {
    check_numeric_pair_or_legacy(lhs, rhs, lhs_ty, rhs_ty, src, pos, "type error: arithmetic operand is not i64", "type error: arithmetic operand type mismatch")
  } } }
}

fn check_order_operand(lhs: i64, rhs: i64, lhs_ty: i64, rhs_ty: i64, src: i64, pos: i64) -[Diagnose]> i64 {
  check_numeric_pair_or_legacy(lhs, rhs, lhs_ty, rhs_ty, src, pos, "type error: comparison operand is not i64", "type error: comparison operand type mismatch")
}

fn check_integer_operand_node(lhs: i64, rhs: i64, lhs_ty: i64, rhs_ty: i64, src: i64, pos: i64, legacy_msg: str, mismatch_msg: str) -[Diagnose]> i64 {
  if type_is_unknown_or_any(lhs_ty) or type_is_unknown_or_any(rhs_ty) { 0 }
  else {
    let prim = int_binop_candidate_prim(lhs_ty, rhs_ty)
    let both_int = expr_matches_int_prim_contextual(lhs, lhs_ty, prim, src) == 1 and expr_matches_int_prim_contextual(rhs, rhs_ty, prim, src) == 1
    if both_int { 0 }
    else { if type_is_integer_exact(lhs_ty) == 1 {
      if type_is_integer_exact(rhs_ty) == 1 {
        typeck_error_maybe(src, pos, mismatch_msg)
        1
      } else {
        typeck_error_maybe(src, pos, legacy_msg)
        1
      }
    } else {
      typeck_error_maybe(src, pos, legacy_msg)
      1
    } }
  }
}

fn expr_diag_pos(node: i64) -> i64 {
  let tag = node_tag(node)
  if tag == 1 { if node_f3(node) > 0 { node_f2(node) } else { 0 } }
  else { if tag == 2 { node_f1(node) }
  else { if tag == 4 { node_f1(node) }
  else { if tag == 13 { node_f2(node) }
  else { if tag == 14 { node_f1(node) }
  -- Binary op: locate at the left operand so and/or/comparison chains
  -- report a real position instead of silently dropping the span.
  else { if tag == 3 { expr_diag_pos(node_f2(node)) }
  -- Not: locate at the operand.
  else { if tag == 22 { expr_diag_pos(node_f1(node)) }
  -- GenericCall: locate at the inner call.
  else { if tag == 36 { expr_diag_pos(node_f2(node)) }
  else { 0 } } } } } } } }
}

fn expr_int_literal_fits_default_i64(node: i64, src: i64) -> i64 {
  if expr_is_contextual_int_lit_shape(node) == 1 {
    expr_is_contextual_int_lit_for_prim(node, PRIM_I64(), src)
  } else { 1 }
}

fn check_default_i64_literal_expr(node: i64, src: i64) -[Diagnose]> i64 {
  if expr_int_literal_fits_default_i64(node, src) == 1 { 0 }
  else {
    typeck_error_maybe(src, expr_diag_pos(node), "type error: integer literal out of range")
    1
  }
}

fn check_bool_required(ty: i64, src: i64, pos: i64) -[Conformance, Diagnose]> i64 {
  if type_is_unknown_or_any(ty) { 0 }
  else { if is_subtype(ty, ty_bool()) { 0 }
  else {
    typeck_error_maybe(src, pos, "type error: boolean expression is not bool")
    1
  } }
}

fn check_bool_expr(node: i64, env: i64, ft: i64, src: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  check_bool_required(synth(node, env, ft, src, tt), src, expr_diag_pos(node))
}

fn check_logical_operand(lhs_ty: i64, rhs_ty: i64, src: i64, pos: i64) -[Conformance, Diagnose]> i64 {
  check_bool_required(lhs_ty, src, pos) + check_bool_required(rhs_ty, src, pos)
}

fn check_assign_target(node: i64, env: i64, ft: i64, src: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let ns = node_f1(node)
  let nl = node_f2(node)
  let val = node_f3(node)
  let target_ty = tenv_lookup(env, src, ns, nl)
  if target_ty == 0 {
    typeck_error_maybe(src, ns, "type error: unknown identifier")
    1
  } else {
    let mut errors = 0
    if tenv_lookup_mutable(env, src, ns, nl) == 0 {
      typeck_error_maybe(src, ns, "type error: cannot assign to immutable binding")
      errors = errors + 1
    } else { errors = errors }
    let val_ty = synth(val, env, ft, src, tt)
    if type_is_unknown_or_any(target_ty) { errors }
    else { if type_is_unknown_or_any(val_ty) { errors }
    else { if expr_matches_type_contextual(val, val_ty, target_ty, src) == 1 { errors }
    else { if infer_generic_ctor_result(val, target_ty, env, ft, src, tt) == 1 and expr_matches_type_contextual(val, synth(val, env, ft, src, tt), target_ty, src) == 1 { errors }
    else {
      typeck_error_maybe(src, ns, "type error: assignment type mismatch")
      errors + 1
    } } } }
  }
}

fn check_return_value_type(val: i64, env: i64, ft: i64, src: i64, ret_ty: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let val_ty = if val == 0 { ty_nil() } else { synth(val, env, ft, src, tt) }
  if type_is_unknown_or_any(val_ty) { 0 }
  else { if type_is_unknown_or_any(ret_ty) { 0 }
  else { if expr_matches_type_contextual(val, val_ty, ret_ty, src) == 1 { 0 }
  else { if infer_generic_ctor_result(val, ret_ty, env, ft, src, tt) == 1 and expr_matches_type_contextual(val, synth(val, env, ft, src, tt), ret_ty, src) == 1 { 0 }
  else {
    let pos = if val != 0 { expr_diag_pos(val) } else { 0 }
    typeck_error_maybe(src, pos, "type error: return type mismatch")
    1
  } } } }
}

fn check_return_values_list(list: i64, n: i64, env: i64, ft: i64, src: i64, ret_ty: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let mut errors = 0
  for i in 0..n {
    errors = errors + check_return_values(nlist_get(list, i), env, ft, src, ret_ty, tt)
  }
  errors
}

fn check_return_values(node: i64, env: i64, ft: i64, src: i64, ret_ty: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  if node == 0 { 0 }
  else {
    let tag = node_tag(node)
    match tag {
      3 -> check_return_values(node_f2(node), env, ft, src, ret_ty, tt) + check_return_values(node_f3(node), env, ft, src, ret_ty, tt)
      4 -> check_return_values_list(node_f3(node), node_f4(node), env, ft, src, ret_ty, tt)
      5 -> check_return_values(node_f1(node), env, ft, src, ret_ty, tt) + check_return_values(node_f2(node), env, ft, src, ret_ty, tt) + check_return_values(node_f3(node), env, ft, src, ret_ty, tt)
      6 -> {
        let val = node_f3(node)
        let val_ty = synth(val, env, ft, src, tt)
        let new_env = tenv_bind(env, src, node_f1(node), node_f2(node), val_ty)
        check_return_values(val, env, ft, src, ret_ty, tt) + check_return_values(node_f4(node), new_env, ft, src, ret_ty, tt)
      }
      7 -> check_return_values(node_f1(node), env, ft, src, ret_ty, tt) + check_return_values(node_f2(node), env, ft, src, ret_ty, tt)
      10 -> check_return_values(node_f1(node), env, ft, src, ret_ty, tt) + check_return_values(node_f2(node), env, ft, src, ret_ty, tt)
      11 -> {
        let val = node_f3(node)
        let val_ty = synth(val, env, ft, src, tt)
        let new_env = tenv_bind_mut(env, src, node_f1(node), node_f2(node), val_ty)
        check_return_values(val, env, ft, src, ret_ty, tt) + check_return_values(node_f4(node), new_env, ft, src, ret_ty, tt)
      }
      12 -> check_return_values(node_f3(node), env, ft, src, ret_ty, tt)
      57 -> check_return_values(node_f1(node), env, ft, src, ret_ty, tt) + check_return_values(node_f2(node), env, ft, src, ret_ty, tt)
      13 -> check_return_values(node_f1(node), env, ft, src, ret_ty, tt)
      14 -> {
        let fields = node_f3(node)
        let nfields = node_f4(node)
        let mut errors = 0
        for i in 0..nfields {
          errors = errors + check_return_values(node_f3(nlist_get(fields, i)), env, ft, src, ret_ty, tt)
        }
        errors
      }
      15 -> {
        let scrutinee = node_f1(node)
        let arms = node_f2(node)
        let n = node_f3(node)
        let scr_ty = synth(scrutinee, env, ft, src, tt)
        let mut errors = check_return_values(scrutinee, env, ft, src, ret_ty, tt)
        for i in 0..n {
          let arm = nlist_get(arms, i)
          let arm_env = bind_pattern(node_f1(arm), env, src, scr_ty, tt)
          let guard = node_f3(arm)
          if guard != 0 { errors = errors + check_return_values(guard, arm_env, ft, src, ret_ty, tt) } else { errors = errors }
          errors = errors + check_return_values(node_f2(arm), arm_env, ft, src, ret_ty, tt)
        }
        errors
      }
      22 -> check_return_values(node_f1(node), env, ft, src, ret_ty, tt)
      25 -> check_return_value_type(node_f1(node), env, ft, src, ret_ty, tt)
      26 -> check_return_values(node_f1(node), env, ft, src, ret_ty, tt)
      29 -> 0
      32 -> check_return_values(node_f1(node), env, ft, src, ret_ty, tt) + check_return_values_list(node_f4(node), nlist_len(node_f4(node)), env, ft, src, ret_ty, tt)
      33 -> check_return_values(node_f1(node), env, ft, src, ret_ty, tt)
      35 -> check_return_values(node_f1(node), env, ft, src, ret_ty, tt)
      36 -> {
        let call_node = node_f2(node)
        check_return_values_list(node_f3(call_node), node_f4(call_node), env, ft, src, ret_ty, tt)
      }
      37 -> check_return_values(node_f1(node), env, ft, src, ret_ty, tt)
      41 -> check_return_values(node_f1(node), env, ft, src, ret_ty, tt) + check_return_values_list(node_f3(node), nlist_len(node_f3(node)), env, ft, src, ret_ty, tt)
      45 -> check_return_values(node_f1(node), env, ft, src, ret_ty, tt)
      46 -> check_return_values(node_f1(node), env, ft, src, ret_ty, tt) + check_return_values(node_f2(node), env, ft, src, ret_ty, tt)
      47 -> {
        let loop_env = tenv_bind(env, src, node_f1(node), node_f2(node), for_iter_item_type(node, env, ft, src, tt))
        check_return_values(node_f3(node), env, ft, src, ret_ty, tt) + check_return_values(node_f4(node), loop_env, ft, src, ret_ty, tt)
      }
      48 -> check_return_values(node_f1(node), env, ft, src, ret_ty, tt)
      49 -> check_return_values(node_f1(node), env, ft, src, ret_ty, tt)
      52 -> check_return_values(node_f1(node), env, ft, src, ret_ty, tt) + check_return_values(node_f2(node), env, ft, src, ret_ty, tt)
      _ -> 0
    }
  }
}

fn unique_name_matches(use_src: i64, use_ns: i64, use_nl: i64, bind_src: i64, bind_ns: i64, bind_nl: i64) -> i64 {
  if use_nl != bind_nl { 0 }
  else { src_eq_at(use_src, use_ns, bind_src + bind_ns, 0, bind_nl) }
}

fn unique_ref_count_list(list: i64, n: i64, src: i64, bind_src: i64, bind_ns: i64, bind_nl: i64) -> i64 {
  let mut count = 0
  for i in 0..n {
    count = count + unique_ref_count_name(nlist_get(list, i), src, bind_src, bind_ns, bind_nl)
  }
  count
}

fn unique_params_bind_name(params: i64, nparams: i64, src: i64, bind_src: i64, bind_ns: i64, bind_nl: i64) -> i64 {
  let mut found = 0
  for i in 0..nparams {
    let p = nlist_get(params, i)
    if unique_name_matches(src, node_f1(p), node_f2(p), bind_src, bind_ns, bind_nl) == 1 {
      found = 1
    } else { found = found }
  }
  found
}

fn unique_pattern_binds_name(pat: i64, src: i64, bind_src: i64, bind_ns: i64, bind_nl: i64) -> i64 {
  if pat == 0 { 0 }
  else {
    let tag = node_tag(pat)
    match tag {
      18 -> unique_name_matches(src, node_f1(pat), node_f2(pat), bind_src, bind_ns, bind_nl)
      20 -> {
        let b_ns = node_f3(pat)
        let b_nl = node_f4(pat)
        if b_nl > 0 {
          unique_name_matches(src, b_ns, b_nl, bind_src, bind_ns, bind_nl)
        } else { if b_nl < 0 {
          let bindings = b_ns
          let nb = 0 - b_nl
          let mut found = 0
          for i in 0..nb {
            let b = nlist_get(bindings, i)
            if node_tag(b) == 18 {
              if unique_name_matches(src, node_f1(b), node_f2(b), bind_src, bind_ns, bind_nl) == 1 {
                found = 1
              } else { found = found }
            } else { found = found }
          }
          found
        } else { 0 } }
      }
      _ -> 0
    }
  }
}

fn unique_ref_count_name(node: i64, src: i64, bind_src: i64, bind_ns: i64, bind_nl: i64) -> i64 {
  if node == 0 { 0 }
  else {
    let tag = node_tag(node)
    match tag {
      2 -> unique_name_matches(src, node_f1(node), node_f2(node), bind_src, bind_ns, bind_nl)
      3 -> unique_ref_count_name(node_f2(node), src, bind_src, bind_ns, bind_nl) + unique_ref_count_name(node_f3(node), src, bind_src, bind_ns, bind_nl)
      4 -> unique_ref_count_list(node_f3(node), node_f4(node), src, bind_src, bind_ns, bind_nl)
      5 -> unique_ref_count_name(node_f1(node), src, bind_src, bind_ns, bind_nl) + unique_ref_count_name(node_f2(node), src, bind_src, bind_ns, bind_nl) + unique_ref_count_name(node_f3(node), src, bind_src, bind_ns, bind_nl)
      6 -> {
        let val = node_f3(node)
        let body = node_f4(node)
        let val_count = unique_ref_count_name(val, src, bind_src, bind_ns, bind_nl)
        if unique_name_matches(src, node_f1(node), node_f2(node), bind_src, bind_ns, bind_nl) == 1 {
          val_count
        } else { val_count + unique_ref_count_name(body, src, bind_src, bind_ns, bind_nl) }
      }
      7 -> unique_ref_count_name(node_f1(node), src, bind_src, bind_ns, bind_nl) + unique_ref_count_name(node_f2(node), src, bind_src, bind_ns, bind_nl)
      10 -> unique_ref_count_name(node_f1(node), src, bind_src, bind_ns, bind_nl) + unique_ref_count_name(node_f2(node), src, bind_src, bind_ns, bind_nl)
      11 -> {
        let val = node_f3(node)
        let body = node_f4(node)
        let val_count = unique_ref_count_name(val, src, bind_src, bind_ns, bind_nl)
        if unique_name_matches(src, node_f1(node), node_f2(node), bind_src, bind_ns, bind_nl) == 1 {
          val_count
        } else { val_count + unique_ref_count_name(body, src, bind_src, bind_ns, bind_nl) }
      }
      12 -> unique_ref_count_name(node_f3(node), src, bind_src, bind_ns, bind_nl)
      57 -> unique_ref_count_name(node_f1(node), src, bind_src, bind_ns, bind_nl) + unique_ref_count_name(node_f2(node), src, bind_src, bind_ns, bind_nl)
      13 -> unique_ref_count_name(node_f1(node), src, bind_src, bind_ns, bind_nl)
      14 -> {
        let fields = node_f3(node)
        let nfields = node_f4(node)
        let mut count = 0
        for i in 0..nfields {
          count = count + unique_ref_count_name(node_f3(nlist_get(fields, i)), src, bind_src, bind_ns, bind_nl)
        }
        count
      }
      15 -> {
        let arms = node_f2(node)
        let n = node_f3(node)
        let mut count = unique_ref_count_name(node_f1(node), src, bind_src, bind_ns, bind_nl)
        for i in 0..n {
          let arm = nlist_get(arms, i)
          let guard = node_f3(arm)
          if guard != 0 {
            count = count + unique_ref_count_name(guard, src, bind_src, bind_ns, bind_nl)
          } else { count = count }
          if unique_pattern_binds_name(node_f1(arm), src, bind_src, bind_ns, bind_nl) == 0 {
            count = count + unique_ref_count_name(node_f2(arm), src, bind_src, bind_ns, bind_nl)
          } else { count = count }
        }
        count
      }
      22 -> unique_ref_count_name(node_f1(node), src, bind_src, bind_ns, bind_nl)
      25 -> unique_ref_count_name(node_f1(node), src, bind_src, bind_ns, bind_nl)
      26 -> unique_ref_count_name(node_f1(node), src, bind_src, bind_ns, bind_nl)
      29 -> {
        if unique_params_bind_name(node_f1(node), node_f3(node), src, bind_src, bind_ns, bind_nl) == 1 { 0 }
        else { unique_ref_count_name(node_f2(node), src, bind_src, bind_ns, bind_nl) }
      }
      32 -> unique_ref_count_name(node_f1(node), src, bind_src, bind_ns, bind_nl) + unique_ref_count_list(node_f4(node), nlist_len(node_f4(node)), src, bind_src, bind_ns, bind_nl)
      33 -> {
        let clauses = node_f2(node)
        let nclauses = node_f3(node)
        let mut count = unique_ref_count_name(node_f1(node), src, bind_src, bind_ns, bind_nl)
        for ci in 0..nclauses {
          let clause = nlist_get(clauses, ci)
          if unique_params_bind_name(node_f2(clause), nlist_len(node_f2(clause)), src, bind_src, bind_ns, bind_nl) == 0 {
            count = count + unique_ref_count_name(node_f3(clause), src, bind_src, bind_ns, bind_nl)
          } else { count = count }
        }
        count
      }
      35 -> unique_ref_count_name(node_f1(node), src, bind_src, bind_ns, bind_nl)
      36 -> {
        let call_node = node_f2(node)
        unique_ref_count_list(node_f3(call_node), node_f4(call_node), src, bind_src, bind_ns, bind_nl)
      }
      37 -> unique_ref_count_name(node_f1(node), src, bind_src, bind_ns, bind_nl)
      41 -> unique_ref_count_name(node_f1(node), src, bind_src, bind_ns, bind_nl) + unique_ref_count_list(node_f3(node), nlist_len(node_f3(node)), src, bind_src, bind_ns, bind_nl)
      45 -> unique_ref_count_name(node_f1(node), src, bind_src, bind_ns, bind_nl)
      46 -> unique_ref_count_name(node_f1(node), src, bind_src, bind_ns, bind_nl) + unique_ref_count_name(node_f2(node), src, bind_src, bind_ns, bind_nl)
      47 -> {
        let collection_count = unique_ref_count_name(node_f3(node), src, bind_src, bind_ns, bind_nl)
        if unique_name_matches(src, node_f1(node), node_f2(node), bind_src, bind_ns, bind_nl) == 1 {
          collection_count
        } else { collection_count + unique_ref_count_name(node_f4(node), src, bind_src, bind_ns, bind_nl) }
      }
      48 -> unique_ref_count_name(node_f1(node), src, bind_src, bind_ns, bind_nl)
      49 -> unique_ref_count_name(node_f1(node), src, bind_src, bind_ns, bind_nl)
      52 -> unique_ref_count_name(node_f1(node), src, bind_src, bind_ns, bind_nl) + unique_ref_count_name(node_f2(node), src, bind_src, bind_ns, bind_nl)
      55 -> unique_ref_count_name(node_f1(node), src, bind_src, bind_ns, bind_nl)
      56 -> unique_ref_count_name(node_f1(node), src, bind_src, bind_ns, bind_nl)
      _ -> 0
    }
  }
}

fn typeck_ty_is_linear_root(ty: i64) -> i64 {
  ty_is_unique(ty) == 1 or ty_is_owned(ty) == 1
}

fn typeck_linear_use_twice_message(ty: i64) -> str {
  if ty_is_owned(ty) == 1 {
    "type error: owned value used more than once"
  } else {
    "type error: unique value used more than once"
  }
}

fn typeck_linear_capture_message(ty: i64) -> str {
  if ty_is_owned(ty) == 1 {
    "type error: owned value cannot be captured by closure"
  } else {
    "type error: unique value cannot be captured by closure"
  }
}

fn check_unique_param_usage(params: i64, nparams: i64, body: i64, src: i64) -[Diagnose]> i64 {
  let mut errors = 0
  for i in 0..nparams {
    let p = nlist_get(params, i)
    let param_ty = node_f3(p)
    if typeck_ty_is_linear_root(param_ty) == 1 {
      if unique_ref_count_name(body, src, src, node_f1(p), node_f2(p)) > 1 {
        typeck_error_maybe(src, node_f1(p), typeck_linear_use_twice_message(param_ty))
        errors = errors + 1
      } else { errors = errors }
    } else { errors = errors }
  }
  errors
}

fn check_unique_param_usage_against_types(params: i64, param_types: i64, nparams: i64, body: i64, src: i64) -[Diagnose]> i64 {
  let mut errors = 0
  for i in 0..nparams {
    let p = nlist_get(params, i)
    let param_ty = nlist_get(param_types, i)
    if typeck_ty_is_linear_root(param_ty) == 1 {
      if unique_ref_count_name(body, src, src, node_f1(p), node_f2(p)) > 1 {
        typeck_error_maybe(src, node_f1(p), typeck_linear_use_twice_message(param_ty))
        errors = errors + 1
      } else { errors = errors }
    } else { errors = errors }
  }
  errors
}

fn typeck_type_list_contains_unique(types: i64) -> bool {
  if types == 0 { false }
  else {
    let mut found = false
    for i in 0..nlist_len(types) {
      if typeck_ty_contains_unique(nlist_get(types, i)) == 1 { found = 1 } else { found = found }
    }
    found
  }
}

fn typeck_ty_contains_unique(ty: i64) -> bool {
  if ty == 0 { false }
  else {
    match ty_tag(ty) {
      3 -> typeck_ty_contains_unique(ty_f1(ty)) or typeck_ty_contains_unique(ty_f2(ty))
      4 -> typeck_ty_contains_unique(ty_f1(ty)) or typeck_ty_contains_unique(ty_f2(ty))
      5 -> typeck_ty_contains_unique(ty_f1(ty))
      6 -> typeck_type_list_contains_unique(ty_f1(ty)) or typeck_ty_contains_unique(ty_f2(ty))
      8 -> typeck_ty_contains_unique(ty_f2(ty))
      9 -> typeck_ty_contains_unique(ty_f2(ty)) or typeck_type_list_contains_unique(ty_f3(ty))
      11 -> typeck_type_list_contains_unique(ty_f2(ty))
      14 -> typeck_ty_contains_unique(ty_f1(ty)) or typeck_ty_contains_unique(ty_f2(ty))
      15 -> typeck_ty_contains_unique(ty_f1(ty))
      16 -> typeck_ty_contains_unique(ty_f1(ty))
      17 -> typeck_ty_contains_unique(ty_f1(ty))
      18 -> true
      19 -> true
      _ -> false
    }
  }
}

fn typeck_params_contain_unique(params: i64) -> i64 {
  if params == 0 { 0 }
  else {
    let mut found = 0
    for i in 0..nlist_len(params) {
      if typeck_ty_contains_unique(node_f3(nlist_get(params, i))) == 1 { found = 1 } else { found = found }
    }
    found
  }
}

fn tenv_contains_unique(env: i64) -> i64 {
  if env == 0 { 0 }
  else {
    if typeck_ty_contains_unique(mem_load64_at(env, 16)) == 1 { 1 }
    else { tenv_contains_unique(mem_load64_at(env, 32)) }
  }
}

fn check_unique_binding_usage(src: i64, ns: i64, nl: i64, binding_ty: i64, body: i64) -[Diagnose]> i64 {
  if typeck_ty_is_linear_root(binding_ty) == 1 {
    if unique_ref_count_name(body, src, src, ns, nl) > 1 {
      typeck_error_maybe(src, ns, typeck_linear_use_twice_message(binding_ty))
      1
    } else { 0 }
  } else { 0 }
}

fn check_unique_linear_expr_list(list: i64, n: i64, env: i64, ft: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  let mut errors = 0
  for i in 0..n {
    errors = errors + check_unique_linear_expr(nlist_get(list, i), env, ft, src, tt)
  }
  errors
}

fn check_unique_linear_expr(node: i64, env: i64, ft: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  if node == 0 { 0 }
  else {
    let tag = node_tag(node)
    match tag {
      3 -> check_unique_linear_expr(node_f2(node), env, ft, src, tt) + check_unique_linear_expr(node_f3(node), env, ft, src, tt)
      4 -> check_unique_linear_expr_list(node_f3(node), node_f4(node), env, ft, src, tt)
      5 -> check_unique_linear_expr(node_f1(node), env, ft, src, tt) + check_unique_linear_expr(node_f2(node), env, ft, src, tt) + check_unique_linear_expr(node_f3(node), env, ft, src, tt)
      6 -> {
        let val = node_f3(node)
        let body = node_f4(node)
        let val_ty = synth(val, env, ft, src, tt)
        let new_env = tenv_bind(env, src, node_f1(node), node_f2(node), val_ty)
        check_unique_linear_expr(val, env, ft, src, tt) +
          check_unique_binding_usage(src, node_f1(node), node_f2(node), val_ty, body) +
          check_unique_linear_expr(body, new_env, ft, src, tt)
      }
      7 -> check_unique_linear_expr(node_f1(node), env, ft, src, tt) + check_unique_linear_expr(node_f2(node), env, ft, src, tt)
      10 -> check_unique_linear_expr(node_f1(node), env, ft, src, tt) + check_unique_linear_expr(node_f2(node), env, ft, src, tt)
      11 -> {
        let val = node_f3(node)
        let body = node_f4(node)
        let val_ty = synth(val, env, ft, src, tt)
        let new_env = tenv_bind_mut(env, src, node_f1(node), node_f2(node), val_ty)
        check_unique_linear_expr(val, env, ft, src, tt) +
          check_unique_binding_usage(src, node_f1(node), node_f2(node), val_ty, body) +
          check_unique_linear_expr(body, new_env, ft, src, tt)
      }
      12 -> check_unique_linear_expr(node_f3(node), env, ft, src, tt)
      57 -> check_unique_linear_expr(node_f1(node), env, ft, src, tt) + check_unique_linear_expr(node_f2(node), env, ft, src, tt)
      13 -> check_unique_linear_expr(node_f1(node), env, ft, src, tt)
      14 -> {
        let fields = node_f3(node)
        let nfields = node_f4(node)
        let mut errors = 0
        for i in 0..nfields {
          errors = errors + check_unique_linear_expr(node_f3(nlist_get(fields, i)), env, ft, src, tt)
        }
        errors
      }
      15 -> {
        let scrutinee = node_f1(node)
        let scr_ty = synth(scrutinee, env, ft, src, tt)
        let arms = node_f2(node)
        let n = node_f3(node)
        let mut errors = check_unique_linear_expr(scrutinee, env, ft, src, tt)
        for i in 0..n {
          let arm = nlist_get(arms, i)
          let arm_env = bind_pattern(node_f1(arm), env, src, scr_ty, tt)
          let guard = node_f3(arm)
          if guard != 0 { errors = errors + check_unique_linear_expr(guard, arm_env, ft, src, tt) } else { errors = errors }
          errors = errors + check_unique_linear_expr(node_f2(arm), arm_env, ft, src, tt)
        }
        errors
      }
      22 -> check_unique_linear_expr(node_f1(node), env, ft, src, tt)
      25 -> check_unique_linear_expr(node_f1(node), env, ft, src, tt)
      26 -> check_unique_linear_expr(node_f1(node), env, ft, src, tt)
      29 -> 0
      32 -> check_unique_linear_expr(node_f1(node), env, ft, src, tt) + check_unique_linear_expr_list(node_f4(node), nlist_len(node_f4(node)), env, ft, src, tt)
      33 -> {
        let clauses = node_f2(node)
        let nclauses = node_f3(node)
        let mut errors = check_unique_linear_expr(node_f1(node), env, ft, src, tt)
        for ci in 0..nclauses {
          let clause = nlist_get(clauses, ci)
          let clause_env = bind_capture_params(node_f2(clause), nlist_len(node_f2(clause)), env, src)
          errors = errors + check_unique_linear_expr(node_f3(clause), clause_env, ft, src, tt)
        }
        errors
      }
      35 -> check_unique_linear_expr(node_f1(node), env, ft, src, tt)
      36 -> {
        let call_node = node_f2(node)
        check_unique_linear_expr_list(node_f3(call_node), node_f4(call_node), env, ft, src, tt)
      }
      37 -> {
        let inner = node_f1(node)
        let ann_ty = node_f2(node)
        let val = node_f3(inner)
        let body = node_f4(inner)
        let new_env = if node_tag(inner) == 11 {
          tenv_bind_mut(env, src, node_f1(inner), node_f2(inner), ann_ty)
        } else {
          tenv_bind(env, src, node_f1(inner), node_f2(inner), ann_ty)
        }
        check_unique_linear_expr(val, env, ft, src, tt) +
          check_unique_binding_usage(src, node_f1(inner), node_f2(inner), ann_ty, body) +
          check_unique_linear_expr(body, new_env, ft, src, tt)
      }
      41 -> check_unique_linear_expr(node_f1(node), env, ft, src, tt) + check_unique_linear_expr_list(node_f3(node), nlist_len(node_f3(node)), env, ft, src, tt)
      45 -> check_unique_linear_expr(node_f1(node), env, ft, src, tt)
      46 -> check_unique_linear_expr(node_f1(node), env, ft, src, tt) + check_unique_linear_expr(node_f2(node), env, ft, src, tt)
      47 -> {
        let loop_env = tenv_bind(env, src, node_f1(node), node_f2(node), for_iter_item_type(node, env, ft, src, tt))
        check_unique_linear_expr(node_f3(node), env, ft, src, tt) + check_unique_linear_expr(node_f4(node), loop_env, ft, src, tt)
      }
      48 -> check_unique_linear_expr(node_f1(node), env, ft, src, tt)
      49 -> check_unique_linear_expr(node_f1(node), env, ft, src, tt)
      52 -> check_unique_linear_expr(node_f1(node), env, ft, src, tt) + check_unique_linear_expr(node_f2(node), env, ft, src, tt)
      55 -> check_unique_linear_expr(node_f1(node), env, ft, src, tt)
      56 -> check_unique_linear_expr(node_f1(node), env, ft, src, tt)
      _ -> 0
    }
  }
}

fn check_unique_capture_name(ns: i64, nl: i64, outer_env: i64, local_env: i64, src: i64) -[Diagnose]> i64 {
  if tenv_lookup(local_env, src, ns, nl) != 0 { 0 }
  else {
    let outer_ty = tenv_lookup(outer_env, src, ns, nl)
    if typeck_ty_is_linear_root(outer_ty) == 1 {
      typeck_error_maybe(src, ns, typeck_linear_capture_message(outer_ty))
      1
    } else { 0 }
  }
}

fn check_unique_captures_list(list: i64, n: i64, outer_env: i64, local_env: i64, src: i64) -[Diagnose]> i64 {
  let mut errors = 0
  for i in 0..n {
    errors = errors + check_unique_captures(nlist_get(list, i), outer_env, local_env, src)
  }
  errors
}

fn check_unique_captures(node: i64, outer_env: i64, local_env: i64, src: i64) -[Diagnose]> i64 {
  if node == 0 { 0 }
  else {
    let tag = node_tag(node)
    match tag {
      2 -> check_unique_capture_name(node_f1(node), node_f2(node), outer_env, local_env, src)
      3 -> check_unique_captures(node_f2(node), outer_env, local_env, src) + check_unique_captures(node_f3(node), outer_env, local_env, src)
      4 -> check_unique_captures_list(node_f3(node), node_f4(node), outer_env, local_env, src)
      5 -> check_unique_captures(node_f1(node), outer_env, local_env, src) + check_unique_captures(node_f2(node), outer_env, local_env, src) + check_unique_captures(node_f3(node), outer_env, local_env, src)
      6 -> {
        let new_local = tenv_bind(local_env, src, node_f1(node), node_f2(node), ty_any())
        check_unique_captures(node_f3(node), outer_env, local_env, src) + check_unique_captures(node_f4(node), outer_env, new_local, src)
      }
      7 -> check_unique_captures(node_f1(node), outer_env, local_env, src) + check_unique_captures(node_f2(node), outer_env, local_env, src)
      10 -> check_unique_captures(node_f1(node), outer_env, local_env, src) + check_unique_captures(node_f2(node), outer_env, local_env, src)
      11 -> {
        let new_local = tenv_bind(local_env, src, node_f1(node), node_f2(node), ty_any())
        check_unique_captures(node_f3(node), outer_env, local_env, src) + check_unique_captures(node_f4(node), outer_env, new_local, src)
      }
      12 -> check_unique_captures(node_f3(node), outer_env, local_env, src)
      57 -> check_unique_captures(node_f1(node), outer_env, local_env, src) + check_unique_captures(node_f2(node), outer_env, local_env, src)
      13 -> check_unique_captures(node_f1(node), outer_env, local_env, src)
      14 -> {
        let fields = node_f3(node)
        let nfields = node_f4(node)
        let mut errors = 0
        for i in 0..nfields {
          errors = errors + check_unique_captures(node_f3(nlist_get(fields, i)), outer_env, local_env, src)
        }
        errors
      }
      15 -> {
        let arms = node_f2(node)
        let n = node_f3(node)
        let mut errors = check_unique_captures(node_f1(node), outer_env, local_env, src)
        for i in 0..n {
          let arm = nlist_get(arms, i)
          let arm_local = bind_capture_pattern(node_f1(arm), local_env, src)
          let guard = node_f3(arm)
          if guard != 0 { errors = errors + check_unique_captures(guard, outer_env, arm_local, src) } else { errors = errors }
          errors = errors + check_unique_captures(node_f2(arm), outer_env, arm_local, src)
        }
        errors
      }
      22 -> check_unique_captures(node_f1(node), outer_env, local_env, src)
      25 -> check_unique_captures(node_f1(node), outer_env, local_env, src)
      26 -> check_unique_captures(node_f1(node), outer_env, local_env, src)
      29 -> 0
      32 -> check_unique_captures(node_f1(node), outer_env, local_env, src) + check_unique_captures_list(node_f4(node), nlist_len(node_f4(node)), outer_env, local_env, src)
      33 -> check_unique_captures(node_f1(node), outer_env, local_env, src)
      35 -> check_unique_captures(node_f1(node), outer_env, local_env, src)
      36 -> {
        let call_node = node_f2(node)
        check_unique_captures_list(node_f3(call_node), node_f4(call_node), outer_env, local_env, src)
      }
      37 -> {
        let inner = node_f1(node)
        let new_local = tenv_bind(local_env, src, node_f1(inner), node_f2(inner), ty_any())
        check_unique_captures(node_f3(inner), outer_env, local_env, src) + check_unique_captures(node_f4(inner), outer_env, new_local, src)
      }
      41 -> check_unique_captures(node_f1(node), outer_env, local_env, src) + check_unique_captures_list(node_f3(node), nlist_len(node_f3(node)), outer_env, local_env, src)
      45 -> check_unique_captures(node_f1(node), outer_env, local_env, src)
      46 -> check_unique_captures(node_f1(node), outer_env, local_env, src) + check_unique_captures(node_f2(node), outer_env, local_env, src)
      47 -> {
        let loop_local = tenv_bind(local_env, src, node_f1(node), node_f2(node), ty_any())
        check_unique_captures(node_f3(node), outer_env, local_env, src) + check_unique_captures(node_f4(node), outer_env, loop_local, src)
      }
      48 -> check_unique_captures(node_f1(node), outer_env, local_env, src)
      49 -> check_unique_captures(node_f1(node), outer_env, local_env, src)
      52 -> check_unique_captures(node_f1(node), outer_env, local_env, src) + check_unique_captures(node_f2(node), outer_env, local_env, src)
      55 -> check_unique_captures(node_f1(node), outer_env, local_env, src)
      56 -> check_unique_captures(node_f1(node), outer_env, local_env, src)
      _ -> 0
    }
  }
}

fn check_closure_unique_captures(body: i64, params: i64, nparams: i64, outer_env: i64, src: i64) -[Diagnose]> i64 {
  let local_env = bind_capture_params(params, nparams, tenv_new(), src)
  check_unique_captures(body, outer_env, local_env, src)
}

-- Check all expressions in a function body
fn check_expr(node: i64, env: i64, ft: i64, src: i64, caller_eff: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let tag = node_tag(node)
  let mut errors = 0
  match tag {
    2 -> check_ident_defined(node, env, ft, src, tt)
    3 -> {
      -- BinOp: check operand types
      errors = errors + check_binop(node, env, ft, src, tt)
      -- Recursively check sub-expressions. Short-circuit rhs positions
      -- see the guard-narrowed env: `x != nil and use(x)` checks use(x)
      -- with x non-nil, `x == nil or use(x)` likewise (§5.3.1 licenses
      -- this: the rhs only evaluates when the guard passed/failed).
      errors = errors + check_expr(node_f2(node), env, ft, src, caller_eff, tt)
      let op = node_f1(node)
      let rhs_env = if op == 12 { tenv_narrow_guard(env, node_f2(node), 6, src) }
        else { if op == 13 { tenv_narrow_guard(env, node_f2(node), 5, src) } else { env } }
      errors = errors + check_expr(node_f3(node), rhs_env, ft, src, caller_eff, tt)
      errors
    }
    5 -> {
      -- If: check condition is bool-like, check branches under the
      -- guard-narrowed env (then sees `x != nil`, else sees the negation
      -- of `x == nil`).
      let cond = node_f1(node)
      let then_node = node_f2(node)
      errors = errors + check_expr(cond, env, ft, src, caller_eff, tt)
      errors = errors + check_bool_expr(cond, env, ft, src, tt)
      let then_env = tenv_narrow_guard(env, cond, 6, src)
      errors = errors + check_expr(then_node, then_env, ft, src, caller_eff, tt)
      let else_node = node_f3(node)
      if else_node != 0 {
        let else_env = tenv_narrow_guard(env, cond, 5, src)
        errors = errors + check_expr(else_node, else_env, ft, src, caller_eff, tt)
      } else { errors = errors }
      errors
    }
    6 -> {
      -- Let: check value, then check body with extended env
      let val = node_f3(node)
      let body = node_f4(node)
      errors = errors + check_expr(val, env, ft, src, caller_eff, tt)
      errors = errors + check_default_i64_literal_expr(val, src)
      let val_ty = synth(val, env, ft, src, tt)
      let new_env = if node_tag(val) == 29 {
        tenv_bind_value(env, src, node_f1(node), node_f2(node), val_ty, val)
      } else {
        tenv_bind(env, src, node_f1(node), node_f2(node), val_ty)
      }
      errors = errors + check_owned_drop_effect_available(val_ty, tt, src, node_f1(node), caller_eff)
      errors = errors + check_unique_binding_usage(src, node_f1(node), node_f2(node), val_ty, body)
      errors = errors + check_expr(body, new_env, ft, src, caller_eff, tt)
      errors
    }
    11 -> {
      -- LetMut: same as let
      let val = node_f3(node)
      let body = node_f4(node)
      errors = errors + check_expr(val, env, ft, src, caller_eff, tt)
      errors = errors + check_default_i64_literal_expr(val, src)
      let val_ty = synth(val, env, ft, src, tt)
      let new_env = tenv_bind_mut(env, src, node_f1(node), node_f2(node), val_ty)
      errors = errors + check_owned_drop_effect_available(val_ty, tt, src, node_f1(node), caller_eff)
      errors = errors + check_unique_binding_usage(src, node_f1(node), node_f2(node), val_ty, body)
      errors = errors + check_expr(body, new_env, ft, src, caller_eff, tt)
      errors
    }
    37 -> {
      -- LetTyped: check value against annotation, then check body
      let inner = node_f1(node)
      let ann_ty = node_f2(node)
      let val = node_f3(inner)
      let body = node_f4(inner)
      errors = errors + check_public_arc_ty(tt, src, node_f1(inner), ann_ty)
      errors = errors + check_move_only_storage_ty(src, node_f1(inner), ann_ty)
      errors = errors + check_owned_resource_ty(tt, src, node_f1(inner), ann_ty)
      errors = errors + check_expr(val, env, ft, src, caller_eff, tt)
      let val_ty = synth(val, env, ft, src, tt)
      if ann_ty != 0 {
        if val_ty != 0 {
          if expr_matches_type_contextual(val, val_ty, ann_ty, src) != 1 {
            -- Second chance: generic ctor solves type args from the annotation.
            if infer_generic_ctor_result(val, ann_ty, env, ft, src, tt) == 1 and expr_matches_type_contextual(val, synth(val, env, ft, src, tt), ann_ty, src) == 1 {
              errors = errors
            } else {
              typeck_error_maybe(src, node_f1(inner), "type error: value does not match let type annotation")
              errors = errors + 1
            }
          } else { errors = errors }
        } else { errors = errors }
      } else { errors = errors }
      errors = errors + check_owned_drop_effect_available(ann_ty, tt, src, node_f1(inner), caller_eff)
      let new_env = if node_tag(inner) == 11 {
        tenv_bind_mut(env, src, node_f1(inner), node_f2(inner), ann_ty)
      } else {
        if node_tag(val) == 29 {
          tenv_bind_value(env, src, node_f1(inner), node_f2(inner), ann_ty, val)
        } else {
          tenv_bind(env, src, node_f1(inner), node_f2(inner), ann_ty)
        }
      }
      errors = errors + check_unique_binding_usage(src, node_f1(inner), node_f2(inner), ann_ty, body)
      errors = errors + check_expr(body, new_env, ft, src, caller_eff, tt)
      errors
    }
    7 -> {
      -- Block: check first, then rest
      errors = errors + check_expr(node_f1(node), env, ft, src, caller_eff, tt)
      let rest = node_f2(node)
      if rest != 0 { errors = errors + check_expr(rest, env, ft, src, caller_eff, tt) } else { errors = errors }
      errors
    }
    10 -> {
      -- While: check condition and body
      errors = errors + check_expr(node_f1(node), env, ft, src, caller_eff, tt)
      errors = errors + check_bool_expr(node_f1(node), env, ft, src, tt)
      errors = errors + check_expr(node_f2(node), env, ft, src, caller_eff, tt)
      errors
    }
    12 -> {
      -- Assign: check assigned value
      errors = errors + check_expr(node_f3(node), env, ft, src, caller_eff, tt)
      errors = errors + check_assign_target(node, env, ft, src, tt)
      errors
    }
    57 -> check_ptr_assign(node, env, ft, src, caller_eff, tt)
    13 -> {
      if ident_names_variant_type(node_f1(node), env, src, tt) == 1 {
        -- Type.Variant nullary qualified construction: reject with the
        -- targeted message instead of "unknown identifier" on the type.
        typeck_error(src, node_f2(node), "type error: qualified constructor syntax is not supported; constructors are bare values")
        errors + 1
      } else {
        -- Field access: check base expression
        errors = errors + check_expr(node_f1(node), env, ft, src, caller_eff, tt)
        errors = errors + check_field_access(node, env, ft, src, tt)
        errors
      }
    }
    14 -> {
      -- Record init: check field value expressions
      let fields = node_f3(node)
      let nfields = node_f4(node)
      for ri in 0..nfields {
        let field = nlist_get(fields, ri)
        errors = errors + check_expr(node_f3(field), env, ft, src, caller_eff, tt)
      }
      errors = errors + check_record_init_shape(node, env, ft, src, tt)
      errors
    }
    22 -> {
      -- Not: check operand
      errors = errors + check_expr(node_f1(node), env, ft, src, caller_eff, tt)
      errors = errors + check_bool_expr(node_f1(node), env, ft, src, tt)
      errors
    }
    25 -> {
      let val = node_f1(node)
      if val != 0 { errors = errors + check_expr(val, env, ft, src, caller_eff, tt) } else { errors = errors }
      errors
    }
    26 -> {
      let val = node_f1(node)
      if val != 0 { errors = errors + check_expr(val, env, ft, src, caller_eff, tt) } else { errors = errors }
      errors
    }
    27 -> errors
    33 -> {
      -- Handle: check body with expanded effect set (handler discharges an effect)
      let handle_body = node_f1(node)
      let clauses = node_f2(node)
      let nclauses = node_f3(node)
      -- Get the handled effect hash from first clause's name_info
      let handled_eff_hash = if nclauses > 0 {
        let cn = node_f1(nlist_get(clauses, 0))
        effect_name_hash(src, node_f1(cn), node_f2(cn))
      } else { 0 }
      -- Expand caller_eff to include the handled effect
      let expanded_eff = effect_add(caller_eff, handled_eff_hash)
      -- Check structural handler shape before validating clause bodies.
      errors = errors + check_handler_duplicate_clauses(clauses, nclauses, src)
      -- Check body with expanded effects (body is allowed to perform the handled effect)
      errors = errors + check_expr(handle_body, env, ft, src, expanded_eff, tt)
      errors = errors + check_missing_handler_clauses(handle_body, clauses, nclauses, handled_eff_hash, src, tt)
      -- Check clause bodies (they run in the handler's scope, not the body's)
      -- Clause layout: f1=name_info, f2=params, f3=body, f4=0
      let handle_result_ty = synth(handle_body, env, ft, src, tt)
      for ci in 0..nclauses {
        let clause = nlist_get(clauses, ci)
        let allow_non_tail = if node_f4(clause) != 0 {
          deferred_split_body_supports_clause(handle_body, clause, src, ft) or
          deferred_fiber_handle_supports_clause(handle_body, clauses, nclauses, clause, src, env, ft)
        } else { 0 }
        errors = errors + check_handler_clause(clause, handled_eff_hash, env, ft, src, caller_eff, tt, node_new(0, handle_result_ty, allow_non_tail, 0, 0))
      }
      errors
    }
    4 -> {
      -- Call: check arguments recursively + check arg types match params.
      -- Bare calls to generic callees are handled inside check_call_args:
      -- var-typed params trigger type-arg inference there (rewriting the
      -- node to an explicit GenericCall) at zero cost to ordinary calls.
      let args = node_f3(node)
      let nargs = node_f4(node)
      for i in 0..nargs {
        errors = errors + check_expr(nlist_get(args, i), env, ft, src, caller_eff, tt)
      }
      errors = errors + check_call_defined(node, env, ft, src)
      errors = errors + check_internal_par_prepared_call_sealed(tt, node, src)
      errors = errors + check_unsafe_raw_call_available(node, src, caller_eff)
      -- Check arg types match declared param types
      errors = errors + check_call_args(node, env, ft, src, caller_eff, tt)
      errors = errors + check_scoped_region_helper(node, src)
      errors
    }
    36 -> {
      -- GenericCall: check inner call args with substituted param types
      let call_node = node_f2(node)
      let call_args = node_f3(call_node)
      let nargs = node_f4(call_node)
      -- Check arg expressions recursively
      for ai in 0..nargs {
        errors = errors + check_expr(nlist_get(call_args, ai), env, ft, src, caller_eff, tt)
      }
      errors = errors + check_generic_call_post_args(node, env, ft, src, caller_eff, tt)
      errors
    }
    15 -> {
      -- Match: check scrutinee + all arm bodies with pattern bindings
      let scrutinee = node_f1(node)
      let arms_list = node_f2(node)
      let n_arms = node_f3(node)
      errors = errors + check_expr(scrutinee, env, ft, src, caller_eff, tt)
      let scr_ty = synth(scrutinee, env, ft, src, tt)
      for mi in 0..n_arms {
        let arm = nlist_get(arms_list, mi)
        let pat = node_f1(arm)
        let body = node_f2(arm)
        let guard = node_f3(arm)
        errors = errors + check_pattern(pat, scr_ty, src, tt)
        let arm_env = bind_pattern(pat, env, src, scr_ty, tt)
        if guard != 0 {
          errors = errors + check_expr(guard, arm_env, ft, src, caller_eff, tt)
          errors = errors + check_bool_expr(guard, arm_env, ft, src, tt)
        } else { errors = errors }
        errors = errors + check_expr(body, arm_env, ft, src, caller_eff, tt)
      }
      errors = errors + check_match_arm_type_consistency(arms_list, n_arms, env, ft, src, scr_ty, tt)
      errors = errors + check_match_duplicate_ctor_arms(arms_list, n_arms, src)
      errors = errors + check_match_exhaustive(arms_list, n_arms, src, scr_ty, tt, expr_diag_pos(scrutinee))
      errors
    }
    29 -> check_lambda_standalone(node, env, ft, src, tt)
    32 -> {
      -- Perform/dot-call: resolve method calls (synth mutates tag 32 → 41)
      -- and recurse into args so nested method calls also get resolved
      synth_dot_call(node, env, ft, src, tt)
      let new_tag = node_tag(node)
      if new_tag == 41 {
        -- Resolved as method call: recurse into method args (f3 in tag 41)
        let ma = node_f3(node)
        let mn = nlist_len(ma)
        for mai in 0..mn {
          errors = errors + check_expr(nlist_get(ma, mai), env, ft, src, caller_eff, tt)
        }
        errors = errors + check_method_call(node, env, ft, src, caller_eff, tt)
        errors
      } else {
        -- Still tag 32: either a genuine effect perform, or a method call on
        -- a type-variable receiver that synth deliberately left unconverted
        -- (monomorphisation resolves it per specialisation).
        let lhs = node_f1(node)
        let recv_ty = if node_tag(lhs) == 2 { tenv_lookup(env, src, node_f1(lhs), node_f2(lhs)) } else { 0 }
        if recv_ty != 0 and ty_tag(recv_ty) == 12 {
          errors = errors + check_tyvar_method_call(node, env, ft, src, tt)
          let pa = node_f4(node)
          let pn = nlist_len(pa)
          for pai in 0..pn {
            errors = errors + check_expr(nlist_get(pa, pai), env, ft, src, caller_eff, tt)
          }
          errors
        } else { if ident_names_variant_type(lhs, env, src, tt) == 1 {
          -- Type.Variant(args): reject qualified construction outright —
          -- otherwise it lowers to an unhandled dynamic perform (BRK).
          typeck_error(src, node_f2(node), "type error: qualified constructor syntax is not supported; constructors are bare values")
          errors = errors + 1
          let pa = node_f4(node)
          let pn = nlist_len(pa)
          for pai in 0..pn {
            errors = errors + check_expr(nlist_get(pa, pai), env, ft, src, caller_eff, tt)
          }
          errors
        } else {
          -- Effect perform: recurse into perform args (f4 in tag 32)
          errors = errors + check_effect_perform_available(node, src, caller_eff, tt)
          errors = errors + check_effect_perform_args(node, env, ft, src, tt)
          let pa = node_f4(node)
          let pn = nlist_len(pa)
          for pai in 0..pn {
            errors = errors + check_expr(nlist_get(pa, pai), env, ft, src, caller_eff, tt)
          }
          errors
        } }
      }
    }
    41 -> {
      -- Already-resolved method call: recurse into args
      let ma = node_f3(node)
      let mn = nlist_len(ma)
      for mai in 0..mn {
        errors = errors + check_expr(nlist_get(ma, mai), env, ft, src, caller_eff, tt)
      }
      errors = errors + check_method_call(node, env, ft, src, caller_eff, tt)
      errors
    }
    35 -> {
      errors = errors + check_expr(node_f1(node), env, ft, src, caller_eff, tt)
      errors
    }
    46 -> {
      errors = errors + check_expr(node_f1(node), env, ft, src, caller_eff, tt)
      errors = errors + check_expr(node_f2(node), env, ft, src, caller_eff, tt)
      errors
    }
    45 -> {
      -- Try operator performs Fail.fail on Err.
      errors = errors + check_expr(node_f1(node), env, ft, src, caller_eff, tt)
      errors = errors + check_effect_hash_available(6384065697, src, 0, caller_eff)
      errors
    }
    47 -> {
      -- For-iterator: check collection and body with the item bound.
      errors = errors + check_expr(node_f3(node), env, ft, src, caller_eff, tt)
      errors = errors + check_for_iter_collection(node, env, ft, src, tt)
      let loop_env = tenv_bind(env, src, node_f1(node), node_f2(node), for_iter_item_type(node, env, ft, src, tt))
      errors = errors + check_expr(node_f4(node), loop_env, ft, src, caller_eff, tt)
      errors
    }
    48 -> {
      -- Optional chaining performs Maybe.none when the base is nil.
      errors = errors + check_expr(node_f1(node), env, ft, src, caller_eff, tt)
      errors = errors + check_effect_hash_available(210682486643, src, 0, caller_eff)
      errors
    }
    49 -> {
      errors = errors + check_expr(node_f1(node), env, ft, src, caller_eff, tt)
      errors
    }
    52 -> {
      errors = errors + check_expr(node_f1(node), env, ft, src, caller_eff, tt)
      errors = errors + check_expr(node_f2(node), env, ft, src, caller_eff, tt)
      errors
    }
    55 -> check_address_of(node, env, ft, src, caller_eff, tt)
    56 -> check_deref(node, env, ft, src, caller_eff, tt)
    _ -> errors
  }
}

-- Check function call argument types against declared parameter types
fn check_weak_ref_args(node: i64, env: i64, ft: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  if node_f4(node) != 1 {
    typeck_error_maybe(src, node_f1(node), "type error: arity mismatch")
    1
  } else {
    let arg = nlist_get(node_f3(node), 0)
    let arg_ty = synth(arg, env, ft, src, tt)
    if typeck_ty_is_weak_target(arg_ty) == 1 { 0 }
    else {
      typeck_error_maybe(src, expr_diag_pos(arg), "type error: weak_ref requires managed value")
      1
    }
  }
}

fn check_weak_load_args(node: i64, env: i64, ft: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  if node_f4(node) != 1 {
    typeck_error_maybe(src, node_f1(node), "type error: arity mismatch")
    1
  } else {
    let arg = nlist_get(node_f3(node), 0)
    let arg_ty = synth(arg, env, ft, src, tt)
    if typeck_ty_is_weak_managed_ref(arg_ty) == 1 { 0 }
    else {
      typeck_error_maybe(src, expr_diag_pos(arg), "type error: weak_load requires weak managed reference")
      1
    }
  }
}

fn region_scoped_arena_helper_name(src: i64, ns: i64, nl: i64) -> i64 {
  if src_eq(src, ns, nl, "with_scoped_arena_alloc") == 1 { 1 }
  else { src_eq(src, ns, nl, "with_scoped_arena_alloc_value") }
}

fn region_alloc_effect_call_name(src: i64, ns: i64, nl: i64) -> i64 {
  if src_eq(src, ns, nl, "alloc_effect") == 1 { 1 }
  else { if src_eq(src, ns, nl, "alloc_effect_zeroed") == 1 { 1 }
  else { src_eq(src, ns, nl, "alloc_effect_words") } }
}

fn region_promote_call_name(src: i64, ns: i64, nl: i64) -> i64 {
  src_eq(src, ns, nl, "region_promote_rc")
}

fn region_local_memory_call_name(src: i64, ns: i64, nl: i64) -> i64 {
  if src_eq(src, ns, nl, "__mem_load64") == 1 { 1 }
  else { if src_eq(src, ns, nl, "mem_load64") == 1 { 1 }
  else { if src_eq(src, ns, nl, "__mem_load8") == 1 { 1 }
  else { if src_eq(src, ns, nl, "mem_load8") == 1 { 1 }
  else { if src_eq(src, ns, nl, "__mem_load_sized") == 1 { 1 }
  else { if src_eq(src, ns, nl, "mem_load_sized") == 1 { 1 }
  else { if src_eq(src, ns, nl, "__mem_store64") == 1 { 1 }
  else { if src_eq(src, ns, nl, "mem_store64") == 1 { 1 }
  else { if src_eq(src, ns, nl, "__mem_store8") == 1 { 1 }
  else { if src_eq(src, ns, nl, "mem_store8") == 1 { 1 }
  else { if src_eq(src, ns, nl, "__mem_store_sized") == 1 { 1 }
  else { if src_eq(src, ns, nl, "mem_store_sized") == 1 { 1 }
  else { if src_eq(src, ns, nl, "__atomic_lock64") == 1 { 1 }
  else { src_eq(src, ns, nl, "__atomic_unlock64") } } } } } } } } } } } } }
}

fn region_alloc_perform(node: i64, src: i64) -> i64 {
  if node == 0 { 0 }
  else { if node_tag(node) != 32 { 0 }
  else {
    let lhs = node_f1(node)
    if node_tag(lhs) != 2 { 0 }
    else { if src_eq(src, node_f1(lhs), node_f2(lhs), "Alloc") != 1 { 0 }
    else { if src_eq(src, node_f2(node), node_f3(node), "alloc") == 1 { 1 } else { 0 } } }
  } }
}

fn region_free_perform(node: i64, src: i64) -> i64 {
  if node == 0 { 0 }
  else { if node_tag(node) != 32 { 0 }
  else {
    let lhs = node_f1(node)
    if node_tag(lhs) != 2 { 0 }
    else { if src_eq(src, node_f1(lhs), node_f2(lhs), "Alloc") != 1 { 0 }
    else { if src_eq(src, node_f2(node), node_f3(node), "free") == 1 { 1 } else { 0 } } }
  } }
}

fn region_expr_is_alloc_value(node: i64, src: i64) -> i64 {
  if node == 0 { 0 }
  else { if region_alloc_perform(node, src) == 1 { 1 }
  else { if node_tag(node) != 4 { 0 }
  else { region_alloc_effect_call_name(src, node_f1(node), node_f2(node)) } } }
}

fn region_name_list_contains(names: i64, src: i64, ns: i64, nl: i64) -> bool {
  if names == 0 { false }
  else {
    let n = nlist_len(names)
    let mut i = 0
    let mut found = false
    while i < n {
      let entry = nlist_get(names, i)
      if node_f2(entry) == nl and src_eq_at(src, ns, src + node_f1(entry), 0, nl) == 1 {
        found = 1
        i = n
      } else { i = i + 1 }
    }
    found
  }
}

fn region_name_list_copy(names: i64) -> i64 {
  let result = nlist_new()
  if names == 0 { result }
  else {
    let n = nlist_len(names)
    for i in 0..n {
      nlist_add(result, nlist_get(names, i))
    }
    result
  }
}

fn region_name_list_bind(names: i64, ns: i64, nl: i64) -> i64 {
  let result = region_name_list_copy(names)
  nlist_add(result, node_new(0, ns, nl, 0, 0))
  result
}

fn region_arg_list_mentions_region(args: i64, nargs: i64, names: i64, src: i64) -> bool {
  let mut i = 0
  let mut found = false
  while i < nargs {
    if region_expr_returns_region_value(nlist_get(args, i), names, src) == 1 {
      found = true
      i = nargs
    } else { i = i + 1 }
  }
  found
}

fn region_arg_at_mentions_region(args: i64, nargs: i64, idx: i64, names: i64, src: i64) -> i64 {
  if idx < 0 { 0 }
  else { if idx >= nargs { 0 }
  else { region_expr_returns_region_value(nlist_get(args, idx), names, src) } }
}

fn region_arg_range_mentions_region(args: i64, nargs: i64, start: i64, end: i64, names: i64, src: i64) -> bool {
  let mut i = start
  let mut found = false
  while i < end and i < nargs {
    if region_expr_returns_region_value(nlist_get(args, i), names, src) == 1 {
      found = 1
      i = end
    } else { i = i + 1 }
  }
  found
}

fn region_record_fields_return_region(fields: i64, nfields: i64, names: i64, src: i64) -> bool {
  let mut i = 0
  let mut found = false
  while i < nfields {
    let field = nlist_get(fields, i)
    if region_expr_returns_region_value(node_f3(field), names, src) == 1 {
      found = 1
      i = nfields
    } else { i = i + 1 }
  }
  found
}

fn region_handler_clauses_return_region(clauses: i64, nclauses: i64, names: i64, src: i64) -> bool {
  let mut i = 0
  let mut found = false
  while i < nclauses {
    let clause = nlist_get(clauses, i)
    if region_expr_returns_region_value(node_f3(clause), names, src) == 1 {
      found = true
      i = nclauses
    } else { i = i + 1 }
  }
  found
}

fn region_names_nonempty(names: i64) -> i64 {
  if names == 0 { 0 } else { if nlist_len(names) > 0 { 1 } else { 0 } }
}

fn region_deferred_handle_mentions_region(body: i64, names: i64, src: i64) -> i64 {
  if region_names_nonempty(names) == 1 { 1 }
  else { region_expr_mentions_region_name(body, names, src) }
}

fn region_deferred_handle_region_escape(body: i64, clauses: i64, nclauses: i64, names: i64, src: i64) -> i64 {
  if region_deferred_handle_mentions_region(body, names, src) != 1 { 0 }
  else {
    let mut found = 0
    let mut i = 0
    while i < nclauses {
      let clause = nlist_get(clauses, i)
      if node_f4(clause) != 0 {
        found = 1
        i = nclauses
      } else { i = i + 1 }
    }
    found
  }
}

fn region_lambda_captures_region(lambda: i64, names: i64, src: i64) -> i64 {
  if node_tag(lambda) != 29 { 0 }
  else { region_expr_mentions_region_name(node_f2(lambda), names, src) }
}

fn region_expr_returns_region_value(node: i64, names: i64, src: i64) -> bool {
  if node == 0 { false }
  else { if node_tag(node) == 4 and region_promote_call_name(src, node_f1(node), node_f2(node)) == 1 { false }
  else { if region_expr_is_alloc_value(node, src) == 1 { true }
  else {
    match node_tag(node) {
      2 -> region_name_list_contains(names, src, node_f1(node), node_f2(node))
      5 -> {
        let else_node = node_f3(node)
        region_expr_returns_region_value(node_f2(node), names, src) or
        if else_node == 0 { false } else { region_expr_returns_region_value(else_node, names, src) }
      }
      6 -> {
        let next_names = if region_expr_returns_region_value(node_f3(node), names, src) == 1 {
          region_name_list_bind(names, node_f1(node), node_f2(node))
        } else { names }
        region_expr_returns_region_value(node_f4(node), next_names, src)
      }
      11 -> {
        let next_names = if region_expr_returns_region_value(node_f3(node), names, src) == 1 {
          region_name_list_bind(names, node_f1(node), node_f2(node))
        } else { names }
        region_expr_returns_region_value(node_f4(node), next_names, src)
      }
      37 -> {
        let inner = node_f1(node)
        let next_names = if region_expr_returns_region_value(node_f3(inner), names, src) == 1 {
          region_name_list_bind(names, node_f1(inner), node_f2(inner))
        } else { names }
        region_expr_returns_region_value(node_f4(inner), next_names, src)
      }
      7 -> region_expr_returns_region_value(node_f2(node), names, src)
      14 -> region_record_fields_return_region(node_f3(node), node_f4(node), names, src)
      15 -> {
        let arms = node_f2(node)
        let n = node_f3(node)
        let mut i = 0
        let mut found = false
        while i < n {
          let arm = nlist_get(arms, i)
          if region_expr_returns_region_value(node_f2(arm), names, src) == 1 {
            found = 1
            i = n
          } else { i = i + 1 }
        }
        found
      }
      26 -> if node_f1(node) == 0 { false } else { region_expr_returns_region_value(node_f1(node), names, src) }
      33 -> {
        region_expr_returns_region_value(node_f1(node), names, src) or
        region_handler_clauses_return_region(node_f2(node), node_f3(node), names, src)
      }
      35 -> region_expr_returns_region_value(node_f1(node), names, src)
      _ -> false
    }
  } } }
}

fn region_expr_mentions_region_name(node: i64, names: i64, src: i64) -> bool {
  if node == 0 { false }
  else { if region_expr_returns_region_value(node, names, src) == 1 { true }
  else {
    match node_tag(node) {
      3 -> region_expr_mentions_region_name(node_f2(node), names, src) or region_expr_mentions_region_name(node_f3(node), names, src)
      4 -> region_arg_list_mentions_region(node_f3(node), node_f4(node), names, src)
      5 -> region_expr_mentions_region_name(node_f1(node), names, src) or region_expr_mentions_region_name(node_f2(node), names, src) or region_expr_mentions_region_name(node_f3(node), names, src)
      6 -> {
        let next_names = if region_expr_returns_region_value(node_f3(node), names, src) == 1 {
          region_name_list_bind(names, node_f1(node), node_f2(node))
        } else { names }
        region_expr_mentions_region_name(node_f3(node), names, src) or region_expr_mentions_region_name(node_f4(node), next_names, src)
      }
      7 -> region_expr_mentions_region_name(node_f1(node), names, src) or region_expr_mentions_region_name(node_f2(node), names, src)
      10 -> region_expr_mentions_region_name(node_f1(node), names, src) or region_expr_mentions_region_name(node_f2(node), names, src)
      11 -> {
        let next_names = if region_expr_returns_region_value(node_f3(node), names, src) == 1 {
          region_name_list_bind(names, node_f1(node), node_f2(node))
        } else { names }
        region_expr_mentions_region_name(node_f3(node), names, src) or region_expr_mentions_region_name(node_f4(node), next_names, src)
      }
      12 -> region_expr_mentions_region_name(node_f3(node), names, src)
      13 -> region_expr_mentions_region_name(node_f1(node), names, src)
      14 -> region_record_fields_return_region(node_f3(node), node_f4(node), names, src)
      15 -> {
        let mut found = region_expr_mentions_region_name(node_f1(node), names, src)
        let arms = node_f2(node)
        let n = node_f3(node)
        let mut i = 0
        while i < n {
          let arm = nlist_get(arms, i)
          if region_expr_mentions_region_name(node_f2(arm), names, src) == 1 or region_expr_mentions_region_name(node_f3(arm), names, src) == 1 {
            found = 1
            i = n
          } else { i = i + 1 }
        }
        found
      }
      22 -> region_expr_mentions_region_name(node_f1(node), names, src)
      25 -> region_expr_mentions_region_name(node_f1(node), names, src)
      26 -> if node_f1(node) == 0 { false } else { region_expr_mentions_region_name(node_f1(node), names, src) }
      29 -> region_expr_mentions_region_name(node_f2(node), names, src)
      32 -> region_expr_mentions_region_name(node_f1(node), names, src) or region_arg_list_mentions_region(node_f4(node), nlist_len(node_f4(node)), names, src)
      33 -> {
        let mut found = region_expr_mentions_region_name(node_f1(node), names, src)
        let clauses = node_f2(node)
        let nclauses = node_f3(node)
        let mut ci = 0
        while ci < nclauses {
          if region_expr_mentions_region_name(node_f3(nlist_get(clauses, ci)), names, src) == 1 {
            found = 1
            ci = nclauses
          } else { ci = ci + 1 }
        }
        found
      }
      35 -> region_expr_mentions_region_name(node_f1(node), names, src)
      36 -> region_arg_list_mentions_region(node_f3(node_f2(node)), node_f4(node_f2(node)), names, src)
      37 -> {
        let inner = node_f1(node)
        let next_names = if region_expr_returns_region_value(node_f3(inner), names, src) == 1 {
          region_name_list_bind(names, node_f1(inner), node_f2(inner))
        } else { names }
        region_expr_mentions_region_name(node_f3(inner), names, src) or region_expr_mentions_region_name(node_f4(inner), next_names, src)
      }
      41 -> region_arg_list_mentions_region(node_f3(node), nlist_len(node_f3(node)), names, src)
      45 -> region_expr_mentions_region_name(node_f1(node), names, src)
      46 -> region_expr_mentions_region_name(node_f1(node), names, src) or region_expr_mentions_region_name(node_f2(node), names, src)
      47 -> region_expr_mentions_region_name(node_f3(node), names, src) or region_expr_mentions_region_name(node_f4(node), names, src)
      48 -> region_expr_mentions_region_name(node_f1(node), names, src)
      49 -> region_expr_mentions_region_name(node_f1(node), names, src)
      52 -> region_expr_mentions_region_name(node_f1(node), names, src) or region_expr_mentions_region_name(node_f2(node), names, src)
      _ -> false
    }
  } }
}

fn region_store_value_escapes(args: i64, nargs: i64, value_idx: i64, names: i64, src: i64) -> bool {
  if region_arg_at_mentions_region(args, nargs, value_idx, names, src) != 1 { false }
  else { if region_arg_at_mentions_region(args, nargs, 0, names, src) == 1 { false } else { true } }
}

fn region_memory_call_region_arg_escape(node: i64, names: i64, src: i64) -> i64 {
  let args = node_f3(node)
  let nargs = node_f4(node)
  if src_eq(src, node_f1(node), node_f2(node), "__mem_load64") == 1 or src_eq(src, node_f1(node), node_f2(node), "mem_load64") == 1 {
    region_arg_range_mentions_region(args, nargs, 1, nargs, names, src)
  } else { if src_eq(src, node_f1(node), node_f2(node), "__mem_load8") == 1 or src_eq(src, node_f1(node), node_f2(node), "mem_load8") == 1 {
    region_arg_range_mentions_region(args, nargs, 1, nargs, names, src)
  } else { if src_eq(src, node_f1(node), node_f2(node), "__mem_load_sized") == 1 or src_eq(src, node_f1(node), node_f2(node), "mem_load_sized") == 1 {
    region_arg_range_mentions_region(args, nargs, 1, nargs, names, src)
  } else { if src_eq(src, node_f1(node), node_f2(node), "__mem_store64") == 1 or src_eq(src, node_f1(node), node_f2(node), "mem_store64") == 1 {
    region_store_value_escapes(args, nargs, 1, names, src)
  } else { if src_eq(src, node_f1(node), node_f2(node), "__mem_store8") == 1 or src_eq(src, node_f1(node), node_f2(node), "mem_store8") == 1 {
    region_store_value_escapes(args, nargs, 1, names, src)
  } else { if src_eq(src, node_f1(node), node_f2(node), "__mem_store_sized") == 1 or src_eq(src, node_f1(node), node_f2(node), "mem_store_sized") == 1 {
    region_arg_range_mentions_region(args, nargs, 1, 3, names, src) or
    region_store_value_escapes(args, nargs, 3, names, src)
  } else { 0 } } } } } }
}

fn region_promote_call_region_arg_escape(node: i64, names: i64, src: i64) -> i64 {
  let args = node_f3(node)
  let nargs = node_f4(node)
  region_arg_range_mentions_region(args, nargs, 1, nargs, names, src)
}

fn region_free_perform_region_arg_escape(node: i64, names: i64, src: i64) -> i64 {
  let args = node_f4(node)
  let nargs = nlist_len(args)
  region_arg_range_mentions_region(args, nargs, 1, nargs, names, src)
}

fn region_call_region_arg_escape(node: i64, names: i64, src: i64) -> i64 {
  if node_tag(node) == 4 {
    if region_promote_call_name(src, node_f1(node), node_f2(node)) == 1 {
      region_promote_call_region_arg_escape(node, names, src)
    } else { if region_local_memory_call_name(src, node_f1(node), node_f2(node)) == 1 {
      region_memory_call_region_arg_escape(node, names, src)
    } else { region_arg_list_mentions_region(node_f3(node), node_f4(node), names, src) } }
  } else { if region_free_perform(node, src) == 1 {
    region_free_perform_region_arg_escape(node, names, src)
  } else { region_arg_list_mentions_region(node_f4(node), nlist_len(node_f4(node)), names, src) } }
}

fn check_region_escape_error(src: i64, pos: i64) -[Diagnose]> i64 {
  typeck_error_maybe(src, pos, "type error: region value cannot escape scoped arena")
  1
}

fn check_region_body(node: i64, names: i64, src: i64, result_pos: i64) -[Diagnose]> i64 {
  if node == 0 { 0 }
  else {
    let mut errors = 0
    if result_pos == 1 and region_expr_returns_region_value(node, names, src) == 1 {
      errors = errors + check_region_escape_error(src, expr_diag_pos(node))
    } else { errors = errors }
    match node_tag(node) {
      3 -> check_region_body(node_f2(node), names, src, 0) + check_region_body(node_f3(node), names, src, 0) + errors
      4 -> {
        let args = node_f3(node)
        let nargs = node_f4(node)
        if region_call_region_arg_escape(node, names, src) == 1 {
          errors = errors + check_region_escape_error(src, node_f1(node))
        } else { errors = errors }
        let mut i = 0
        while i < nargs {
          errors = errors + check_region_body(nlist_get(args, i), names, src, 0)
          i = i + 1
        }
        errors
      }
      5 -> check_region_body(node_f1(node), names, src, 0) + check_region_body(node_f2(node), names, src, result_pos) + check_region_body(node_f3(node), names, src, result_pos) + errors
      6 -> {
        let val = node_f3(node)
        let body = node_f4(node)
        let next_names = if region_expr_returns_region_value(val, names, src) == 1 {
          region_name_list_bind(names, node_f1(node), node_f2(node))
        } else { names }
        errors + check_region_body(val, names, src, 0) + check_region_body(body, next_names, src, result_pos)
      }
      7 -> errors + check_region_body(node_f1(node), names, src, 0) + check_region_body(node_f2(node), names, src, result_pos)
      10 -> errors + check_region_body(node_f1(node), names, src, 0) + check_region_body(node_f2(node), names, src, 0)
      11 -> {
        let val = node_f3(node)
        let body = node_f4(node)
        let next_names = if region_expr_returns_region_value(val, names, src) == 1 {
          region_name_list_bind(names, node_f1(node), node_f2(node))
        } else { names }
        errors + check_region_body(val, names, src, 0) + check_region_body(body, next_names, src, result_pos)
      }
      12 -> errors + check_region_body(node_f3(node), names, src, 0)
      13 -> errors + check_region_body(node_f1(node), names, src, 0)
      14 -> {
        if region_record_fields_return_region(node_f3(node), node_f4(node), names, src) == 1 {
          errors = errors + check_region_escape_error(src, expr_diag_pos(node))
        } else { errors = errors }
        let fields = node_f3(node)
        let nfields = node_f4(node)
        for ri in 0..nfields {
          let field = nlist_get(fields, ri)
          errors = errors + check_region_body(node_f3(field), names, src, 0)
        }
        errors
      }
      15 -> {
        errors = errors + check_region_body(node_f1(node), names, src, 0)
        let arms = node_f2(node)
        let n = node_f3(node)
        for i in 0..n {
          let arm = nlist_get(arms, i)
          errors = errors + check_region_body(node_f3(arm), names, src, 0)
          errors = errors + check_region_body(node_f2(arm), names, src, result_pos)
        }
        errors
      }
      22 -> errors + check_region_body(node_f1(node), names, src, 0)
      25 -> {
        if region_expr_returns_region_value(node_f1(node), names, src) == 1 {
          errors + check_region_escape_error(src, expr_diag_pos(node_f1(node)))
        } else { errors + check_region_body(node_f1(node), names, src, 0) }
      }
      26 -> {
        let val = node_f1(node)
        if val != 0 and region_expr_returns_region_value(val, names, src) == 1 {
          errors + check_region_escape_error(src, expr_diag_pos(val))
        } else { errors + check_region_body(val, names, src, 0) }
      }
      29 -> {
        if region_lambda_captures_region(node, names, src) == 1 {
          errors + check_region_escape_error(src, expr_diag_pos(node))
        } else { errors }
      }
      32 -> {
        if region_call_region_arg_escape(node, names, src) == 1 {
          errors = errors + check_region_escape_error(src, expr_diag_pos(node))
        } else { errors = errors }
        let args = node_f4(node)
        let nargs = nlist_len(args)
        for pai in 0..nargs {
          errors = errors + check_region_body(nlist_get(args, pai), names, src, 0)
        }
        errors + check_region_body(node_f1(node), names, src, 0)
      }
      33 -> {
        if region_deferred_handle_region_escape(node_f1(node), node_f2(node), node_f3(node), names, src) == 1 {
          errors = errors + check_region_escape_error(src, expr_diag_pos(node))
        } else { errors = errors }
        errors = errors + check_region_body(node_f1(node), names, src, result_pos)
        let clauses = node_f2(node)
        let nclauses = node_f3(node)
        for hci in 0..nclauses {
          let clause = nlist_get(clauses, hci)
          errors = errors + check_region_body(node_f3(clause), names, src, result_pos)
        }
        errors
      }
      35 -> {
        let val = node_f1(node)
        if region_expr_returns_region_value(val, names, src) == 1 {
          errors + check_region_escape_error(src, expr_diag_pos(val))
        } else { errors + check_region_body(val, names, src, 0) }
      }
      36 -> {
        let call_node = node_f2(node)
        let args = node_f3(call_node)
        let nargs = node_f4(call_node)
        if region_arg_list_mentions_region(args, nargs, names, src) == 1 {
          errors = errors + check_region_escape_error(src, node_f1(call_node))
        } else { errors = errors }
        for gi in 0..nargs {
          errors = errors + check_region_body(nlist_get(args, gi), names, src, 0)
        }
        errors
      }
      37 -> {
        let inner = node_f1(node)
        let val = node_f3(inner)
        let body = node_f4(inner)
        let next_names = if region_expr_returns_region_value(val, names, src) == 1 {
          region_name_list_bind(names, node_f1(inner), node_f2(inner))
        } else { names }
        errors + check_region_body(val, names, src, 0) + check_region_body(body, next_names, src, result_pos)
      }
      41 -> {
        let args = node_f3(node)
        let nargs = nlist_len(args)
        if region_arg_list_mentions_region(args, nargs, names, src) == 1 {
          errors = errors + check_region_escape_error(src, expr_diag_pos(node))
        } else { errors = errors }
        for mi in 0..nargs {
          errors = errors + check_region_body(nlist_get(args, mi), names, src, 0)
        }
        errors
      }
      45 -> errors + check_region_body(node_f1(node), names, src, 0)
      46 -> errors + check_region_body(node_f1(node), names, src, 0) + check_region_body(node_f2(node), names, src, 0)
      47 -> errors + check_region_body(node_f3(node), names, src, 0) + check_region_body(node_f4(node), names, src, 0)
      48 -> errors + check_region_body(node_f1(node), names, src, 0)
      49 -> errors + check_region_body(node_f1(node), names, src, 0)
      52 -> errors + check_region_body(node_f1(node), names, src, 0) + check_region_body(node_f2(node), names, src, 0)
      _ -> errors
    }
  }
}

fn check_scoped_region_helper(node: i64, src: i64) -[Diagnose]> i64 {
  let call_node = if node_tag(node) == 36 { node_f2(node) } else { node }
  if node_tag(call_node) != 4 { 0 }
  else { if region_scoped_arena_helper_name(src, node_f1(call_node), node_f2(call_node)) != 1 { 0 }
  else { if node_f4(call_node) != 2 { 0 }
  else {
    let args = node_f3(call_node)
    let lambda = nlist_get(args, 1)
    if node_tag(lambda) != 29 { 0 }
    else { if node_f3(lambda) != 0 { 0 }
    else { check_region_body(node_f2(lambda), nlist_new(), src, 1) } }
  } } }
}

fn check_call_args(node: i64, env: i64, ft: i64, src: i64, caller_eff: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let call_ns = node_f1(node)
  let call_nl = node_f2(node)
  if weak_ref_name(src, call_ns, call_nl) == 1 { check_weak_ref_args(node, env, ft, src, tt) }
  else { if weak_load_name(src, call_ns, call_nl) == 1 { check_weak_load_args(node, env, ft, src, tt) }
  else { if call_nl >= 2 {
    if mem_load8_at(src, call_ns) == 95 {
      if mem_load8_at(src, call_ns + 1) == 95 { check_intrinsic_args(node, env, ft, src, tt) }
      else { check_call_args_inner(node, env, ft, src, caller_eff, tt) }
    } else { check_call_args_inner(node, env, ft, src, caller_eff, tt) }
  } else { check_call_args_inner(node, env, ft, src, caller_eff, tt) }
  } }
}

fn check_generator_i64_producer_supported(arg: i64, env: i64, ft: i64, src: i64) -> i64 {
  match node_tag(arg) {
    29 -> if node_f3(arg) == 0 { 1 } else { 0 }
    2 -> {
      let local_ty = tenv_lookup(env, src, node_f1(arg), node_f2(arg))
      if local_ty != 0 {
        let origin = tenv_lookup_value(env, src, node_f1(arg), node_f2(arg))
        if origin == 0 { 0 }
        else { if node_tag(origin) != 29 { 0 }
        else { if node_f3(origin) != 0 { 0 }
        else { if ty_tag(local_ty) != 6 { 0 }
        else { if nlist_len(ty_f1(local_ty)) == 0 { 1 } else { 0 } } } } }
      } else {
        let params = ftypes_lookup_params(ft, src, node_f1(arg), node_f2(arg))
        if params != 0 and nlist_len(params) == 0 { 1 } else { 0 }
      }
    }
    _ -> 0
  }
}

fn check_generator_i64_new_shape(node: i64, env: i64, ft: i64, src: i64) -[Diagnose]> i64 {
  if src_eq(src, node_f1(node), node_f2(node), "generator_i64_new") != 1 { 0 }
  else { if node_f4(node) != 1 { 0 }
  else {
    let arg = nlist_get(node_f3(node), 0)
    if check_generator_i64_producer_supported(arg, env, ft, src) == 1 { 0 }
    else {
      typeck_error(src, node_f1(node), "type error: generator producer must be literal zero-arg lambda, known zero-arg function, or known zero-arg closure")
      1
    }
  } }
}

fn check_generator_new_shape(node: i64, env: i64, ft: i64, src: i64) -[Diagnose]> i64 {
  if node_tag(node) != 36 { 0 }
  else {
    let call_node = node_f2(node)
    if src_eq(src, node_f1(call_node), node_f2(call_node), "generator_new") != 1 { 0 }
    else { if node_f4(call_node) != 1 { 0 }
    else { if nlist_len(node_f1(node)) != 2 { 0 }
    else {
      let arg = nlist_get(node_f3(call_node), 0)
      if check_generator_i64_producer_supported(arg, env, ft, src) == 1 { 0 }
      else {
        typeck_error(src, node_f1(call_node), "type error: generator producer must be literal zero-arg lambda, known zero-arg function, or known zero-arg closure")
        1
      }
    } } }
  }
}

-- Everything the GenericCall (tag 36) arm checks EXCEPT recursing into
-- the argument expressions: type-arg count, trait bounds, arity,
-- substituted param checks, effect availability. Shared by the tag-36
-- check_expr arm and the bare-generic-call inference path in
-- check_call_args_inner (whose caller already recursed into the args).
fn check_generic_call_post_args(node: i64, env: i64, ft: i64, src: i64, caller_eff: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let type_args = node_f1(node)
  let call_node = node_f2(node)
  let call_args = node_f3(call_node)
  let nargs = node_f4(call_node)
  let ns = node_f1(call_node)
  let nl = node_f2(call_node)
  let mut errors = check_public_arc_type_list(tt, src, ns, type_args)
  errors = errors + check_move_only_storage_type_list(src, ns, type_args)
  errors = errors + check_internal_par_prepared_call_sealed(tt, call_node, src)
  -- Check arg types against substituted param types
  let tparams = ftypes_lookup_tparams(ft, src, ns, nl)
  let params = ftypes_lookup_params(ft, src, ns, nl)
  if tparams != 0 {
    errors = errors + check_generic_type_arg_count(tparams, type_args, src, ns)
    errors = errors + check_generator_new_shape(node, env, ft, src)
    if params != 0 {
      errors = errors + check_arity(nlist_len(params), nargs, src, ns)
      let s = build_subst(tparams, type_args)
      -- Check trait bounds on type parameters
      errors = errors + check_trait_bounds(tparams, type_args, src, ns, tt)
      for pi in 0..nargs {
        if pi < nlist_len(params) {
          let param = nlist_get(params, pi)
          let param_ty = node_f3(param)
          if param_ty != 0 {
            let subst_ty = ty_subst(param_ty, s)
            errors = errors + check_arg_against_param(nlist_get(call_args, pi), subst_ty, env, ft, src, tt, ns)
          } else { errors = errors }
        } else { errors = errors }
      }
    } else { 0 }
  } else {
    errors = errors + check_generic_call_target_defined(call_node, env, ft, src, tt)
    errors = errors + check_call_args(call_node, env, ft, src, caller_eff, tt)
  }
  -- Effect checking for generic calls
  let callee_eff = ftypes_lookup_effects(ft, src, ns, nl)
  if caller_eff > 0 {
    if callee_eff > 0 {
      if not effect_is_subset(callee_eff, caller_eff) {
        typeck_error(src, ns, "type error: effect not available in caller")
        errors = errors + 1
      } else { errors = errors }
    } else { errors = errors }
  } else { errors = errors }
  errors = errors + check_scoped_region_helper(node, src)
  errors
}

-- 1 when any declared param type mentions a type variable — the marker
-- of a generic callee reached as a bare (unparameterized) call. Cheap:
-- walks the handful of param type nodes, no table lookups.
fn params_mention_type_var(params: i64) -> i64 {
  let n = nlist_len(params)
  let mut found = 0
  for i in 0..n {
    if found == 0 and ty_mentions_type_var(node_f3(nlist_get(params, i))) == 1 { found = 1 } else { 0 }
  }
  found
}

fn ty_mentions_type_var(ty: i64) -> i64 {
  if ty == 0 { 0 }
  else {
    let tag = ty_tag(ty)
    if tag == 12 { 1 }
    else { if tag == 9 { ty_list_mentions_type_var(ty_f3(ty)) }
    else { if tag == 3 or tag == 4 {
      if ty_mentions_type_var(ty_f1(ty)) == 1 { 1 } else { ty_mentions_type_var(ty_f2(ty)) }
    }
    else { if tag == 6 {
      if ty_list_mentions_type_var(ty_f1(ty)) == 1 { 1 } else { ty_mentions_type_var(ty_f2(ty)) }
    }
    else { if tag == 5 or tag == 15 or tag == 16 or tag == 17 or tag == 18 or tag == 19 {
      ty_mentions_type_var(ty_f1(ty))
    }
    else { 0 } } } } }
  }
}

fn ty_list_mentions_type_var(types: i64) -> i64 {
  if types == 0 { 0 }
  else {
    let n = nlist_len(types)
    let mut found = 0
    for i in 0..n {
      if found == 0 and ty_mentions_type_var(nlist_get(types, i)) == 1 { found = 1 } else { 0 }
    }
    found
  }
}

fn check_call_args_inner(node: i64, env: i64, ft: i64, src: i64, caller_eff: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let ns = node_f1(node)
  let nl = node_f2(node)
  let args = node_f3(node)
  let nargs = node_f4(node)
  let local_ty = tenv_lookup(env, src, ns, nl)
  if local_ty != 0 {
    if ty_tag(local_ty) == 6 { check_call_fn_type(node, local_ty, env, ft, src, caller_eff, tt) }
    else { if ty_tag(local_ty) == 14 { check_call_continuation_type(node, local_ty, env, ft, src, tt) }
    else { 0 }
    }
  } else {
    let params = ftypes_lookup_params(ft, src, ns, nl)
    if params == 0 { 0 }
  else { if params_mention_type_var(params) == 1 and node_tag(node) == 4 {
    -- Bare call to a generic callee (var-typed params betray it at zero
    -- lookup cost — an upfront tparams probe per call node cost ~5% on
    -- check_tree). Synthesis solves type args from the arguments and
    -- rewrites the node to an explicit GenericCall; args were already
    -- recursed by the tag-4 arm, so only the post-args checks run here.
    synth_call(node, env, ft, src, tt)
    if node_tag(node) == 36 {
      check_generic_call_post_args(node, env, ft, src, caller_eff, tt)
    } else {
      check_call_args_declared(node, params, env, ft, src, caller_eff, tt)
    }
  }
  else {
    check_call_args_declared(node, params, env, ft, src, caller_eff, tt)
  } }
  }
}

-- The ordinary declared-params arg check (shared by the plain path and
-- the bare-generic path when inference does not solve).
fn check_call_args_declared(node: i64, params: i64, env: i64, ft: i64, src: i64, caller_eff: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let ns = node_f1(node)
  let nl = node_f2(node)
  let args = node_f3(node)
  let nargs = node_f4(node)
  let nparams = nlist_len(params)
    let mut errors = 0
    errors = errors + check_generator_i64_new_shape(node, env, ft, src)
    errors = errors + check_arity(nparams, nargs, src, ns)
    -- Effect checking: only when caller has explicit annotation
    let callee_eff = ftypes_lookup_effects(ft, src, ns, nl)
    if caller_eff > 0 {
      if callee_eff > 0 {
        if not effect_is_subset(callee_eff, caller_eff) {
          typeck_error(src, ns, "type error: effect not available in caller")
          errors = errors + 1
        } else { errors = errors }
      } else { errors = errors }
    } else { errors = errors }
    for i in 0..nargs {
      if i < nparams {
        let param = nlist_get(params, i)
        let param_ty = node_f3(param)
        if param_ty != 0 {
          let allow_direct_continuation_i64 = continuation_call_arg_accepts_direct(ft, src, ns, nl, i)
          errors = errors + check_arg_against_param_mode(nlist_get(args, i), param_ty, env, ft, src, tt, ns, allow_direct_continuation_i64)
        } else { errors = errors }
      } else { errors = errors }
    }
    errors
}

fn check_fn(fn_node: i64, ft: i64, src: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  -- fn_node may be wrapped in tag-23 {inner, ret_type}
  let inner = if node_tag(fn_node) == 23 { node_f1(fn_node) } else { fn_node }
  let params = node_f3(inner)
  let body = node_f4(inner)
  let nparams = nlist_len(params)
  let ret_ty = fn_ret_type(fn_node)
  let mut errors = check_public_arc_params(tt, src, params) + check_public_arc_ty(tt, src, node_f1(inner), ret_ty)
  errors = errors + check_move_only_storage_params(src, params) + check_move_only_storage_ty(src, node_f1(inner), ret_ty)
  errors = errors + check_owned_resource_params(tt, src, params) + check_owned_resource_ty(tt, src, node_f1(inner), ret_ty)
  -- Build environment from params using their type annotations
  let mut env = tenv_new()
  for i in 0..nparams {
    let p = nlist_get(params, i)
    let param_ty = node_f3(p)
    -- If param has a type annotation (f3 != 0), use it; else default to any
    let ty = if param_ty != 0 { param_ty } else { ty_any() }
    env = tenv_bind(env, src, node_f1(p), node_f2(p), ty)
  }
  -- Store current function's tparams for generic method resolution
  let tparams = fn_tparams(fn_node)
  let saved_tparams = ttable_get_tparams(tt)
  ttable_set_tparams(tt, tparams)
  let caller_eff = fn_effects(fn_node)
  errors = errors + check_owned_drop_param_effects(params, nparams, tt, src, caller_eff)
  -- synth first to convert tag-32 dot-calls to tag-41 method calls
  let body_ty_pre = synth(body, env, ft, src, tt)
  -- Generic ctor inference pre-pass: result-position (and returned) bare
  -- generic ctors solve their type args from the declared return type
  -- and are rewritten to explicit GenericCall nodes BEFORE check_expr
  -- would flag their bare form. Gated on the return type being a named
  -- type — the only expected-type shape context inference can solve —
  -- so ordinary functions never pay for the walk.
  let body_ty = if ty_tag(ret_ty) == 9 and infer_generic_ctor_result(body, ret_ty, env, ft, src, tt) == 1 {
    synth(body, env, ft, src, tt)
  } else { body_ty_pre }
  -- check_expr recurses deeper and resolves remaining tag-32 nodes
  errors = errors + check_expr(body, env, ft, src, caller_eff, tt)
  errors = errors + check_resume_scope(body, src, 0)
  errors = errors + check_continuation_param_usage_with_result(body, params, nparams, ret_ty, src, ft)
  if typeck_params_contain_unique(params) == 1 or typeck_ty_contains_unique(ret_ty) == 1 {
    errors = errors + check_unique_param_usage(params, nparams, body, src)
    errors = errors + check_unique_linear_expr(body, env, ft, src, tt)
  } else { errors = errors }
  errors = errors + check_return_values(body, env, ft, src, ret_ty, tt)
  -- Check return type: body type must be subtype of declared return type
  -- (the inference pre-pass above already resolved result-position ctors).
  if type_is_unknown_or_any(body_ty) { errors = errors }
  else { if expr_matches_type_contextual(body, body_ty, ret_ty, src) != 1 {
    typeck_error_maybe(src, node_f1(inner), "type error: return type mismatch")
    errors = errors + 1
  } else { errors = errors } }
  -- Restore previous function's tparams
  ttable_set_tparams(tt, saved_tparams)
  errors
}

-- Get return type from fn wrapper (tag-23 has ret_type at f2)
fn fn_ret_type(fn_wrap: i64) -> i64 {
  if node_tag(fn_wrap) == 23 {
    let rt = node_f2(fn_wrap)
    if rt != 0 { rt } else { ty_any() }
  } else { ty_any() }
}

-- Get effect signature from fn wrapper (tag-23 has effects at f3)
fn fn_effects(fn_wrap: i64) -> i64 {
  if node_tag(fn_wrap) == 23 {
    let eff = node_f3(fn_wrap)
    if eff != 0 { eff } else { 0 }
  } else { 0 }
}

-- Get type params from fn wrapper (tag-23 has tparams at f4)
fn fn_tparams(fn_wrap: i64) -> i64 {
  if node_tag(fn_wrap) == 23 { node_f4(fn_wrap) } else { 0 }
}

-- Get inner fn from wrapper
fn fn_inner(fn_wrap: i64) -> i64 {
  if node_tag(fn_wrap) == 23 { node_f1(fn_wrap) } else { fn_wrap }
}

-- Register variant constructors from the type table as synthetic functions in ftypes
-- So the type checker can verify constructor argument types
fn register_ctors(ft: i64, tt: i64, user_src: i64) -> i64 {
  if tt == 0 { 0 }
  else {
    let n = mem_load64_at(tt, 8)
    let d = mem_load64_at(tt, 0)
    for ti in 0..n {
      let kind = mem_load64_at(d, ti * 64 + 16)
      if kind == 1 {
        let nvariants = mem_load64_at(d, ti * 64 + 24)
        let variants = mem_load64_at(d, ti * 64 + 32)
        let tparams = mem_load64_at(d, ti * 64 + 40)
        for vi in 0..nvariants {
          let v_ns = mem_load64_at(variants, vi * 40)
          let v_nl = mem_load64_at(variants, vi * 40 + 8)
          let npayloads = mem_load64_at(variants, vi * 40 + 24)
          -- Compute parent type hash for Named return type using entry's src
          let type_ns = mem_load64_at(d, ti * 64)
          let type_nl = mem_load64_at(d, ti * 64 + 8)
          let entry_src = mem_load64_at(d, ti * 64 + 48)
          let parent_hash = mem_load64_at(d, ti * 64 + 56)
          let ctor_ret = ctor_return_type(parent_hash, tparams)
          if npayloads > 0 {
            let params = nlist_new()
            let payload_types = mem_load64_at(variants, vi * 40 + 32)
            for pi in 0..npayloads {
              let pty = if payload_types != 0 { nlist_get(payload_types, pi) } else { ty_any() }
              nlist_add(params, node_new(2, 0, 0, pty, 0))
            }
            -- Key by the declaring buffer: v_ns/v_nl are offsets into
            -- entry_src, and ftypes hashes name bytes through the stored src.
            ftypes_add(ft, entry_src, v_ns, v_nl, ctor_ret, params, 0, tparams)
          } else {
            -- Bare constructor (no payload): register with empty params
            ftypes_add(ft, entry_src, v_ns, v_nl, ctor_ret, nlist_new(), 0, tparams)
          }
        }
      } else { 0 }
    }
    0
  }
}

fn ctor_type_args_from_tparams(tparams: i64) -> i64 {
  if tparams == 0 { 0 }
  else {
    let args = nlist_new()
    let n = nlist_len(tparams)
    for i in 0..n {
      let tp = nlist_get(tparams, i)
      nlist_add(args, ty_var(node_f3(tp)))
    }
    args
  }
}

fn ctor_return_type(parent_hash: i64, tparams: i64) -> i64 {
  let args = ctor_type_args_from_tparams(tparams)
  if args == 0 { ty_named(parent_hash, ty_i64()) }
  else { ty_named_app(parent_hash, ty_i64(), args) }
}

-- Add an effect to an effect set (for handler discharge — expands caller_eff)
-- If caller_eff is 0 (unannotated), returns 0 (no checking)
-- Otherwise, creates a new EffectSig with the added effect
fn effect_add(eff: i64, eff_hash: i64) -> i64 {
  if eff == 0 { 0 }
  else {
    if eff_hash == 0 { eff }
    else {
      if ty_tag(eff) != 10 { eff }
      else {
        let old_list = ty_f1(eff)
        let new_list = nlist_new()
        -- Copy existing effects
        for i in 0..nlist_len(old_list) {
          nlist_add(new_list, nlist_get(old_list, i))
        }
        -- Add the new effect
        nlist_add(new_list, ty_effect_app(eff_hash))
        ty_effect_sig(new_list)
      }
    }
  }
}

-- Check every function in the module — root and imported sources alike.
-- (Imported bodies were historically skipped, which let unknown calls,
-- effect drift, and type errors in use'd files pass with 0 errors.)
fn check_user_fns(fns: i64, user_src: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let n = nlist_len(fns)
  let ft = ftypes_new()
  -- Pass 1: register all function return types
  for i in 0..n {
    let pair = nlist_get(fns, i)
    let fn_wrap = node_f1(pair)
    let fn_src = node_f2(pair)
    let inner = fn_inner(fn_wrap)
    let reg_entry = ftypes_add(ft, fn_src, node_f1(inner), node_f2(inner), fn_ret_type(fn_wrap), node_f3(inner), fn_effects(fn_wrap), fn_tparams(fn_wrap))
    if node_f3(pair) != 0 { mem_store64_at(reg_entry, 72, 1) } else { 0 }
    ftypes_set_body(ft, fn_src, node_f1(inner), node_f2(inner), node_f4(inner))
  }
  -- Register variant constructors from type table
  register_ctors(ft, tt, user_src)
  -- Pass 2: check impl declarations and functions from user_src
  let mut total_errors = check_type_cycles(tt, user_src) + check_aggregate_release_mask_capacity(tt, user_src) + check_impl_decls(tt, user_src)
  for j in 0..n {
    let pair = nlist_get(fns, j)
    let fn_src = node_f2(pair)
    total_errors = total_errors + check_fn(node_f1(pair), ft, fn_src, tt)
  }
  total_errors = total_errors + check_imported_unsafe_raw_fns(fns, user_src, tt)
  total_errors = total_errors + check_strict_root_unsafe_raw_fns(fns, user_src, tt)
  total_errors
}

-- Check all functions in a module
fn check_module(fns: i64, tt: i64) -[Conformance, Diagnose]> i64 {
  let n = nlist_len(fns)
  let ft = ftypes_new()
  -- Pass 1: register all function return types (use declared type or any)
  for i in 0..n {
    let pair = nlist_get(fns, i)
    let fn_node = node_f1(pair)
    let fn_src = node_f2(pair)
    let inner = fn_inner(fn_node)
    ftypes_add(ft, fn_src, node_f1(inner), node_f2(inner), fn_ret_type(fn_node), node_f3(inner), fn_effects(fn_node), fn_tparams(fn_node))
    ftypes_set_body(ft, fn_src, node_f1(inner), node_f2(inner), node_f4(inner))
  }
  -- Pass 2: check impl declarations and all function bodies
  let mut total_errors = check_type_cycles(tt, 0) + check_aggregate_release_mask_capacity(tt, 0) + check_impl_decls(tt, 0)
  for j in 0..n {
    let pair = nlist_get(fns, j)
    let fn_node = node_f1(pair)
    let fn_src = node_f2(pair)
    total_errors = total_errors + check_fn(fn_node, ft, fn_src, tt)
  }
  total_errors
}
