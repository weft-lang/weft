  else { if src_eq(src, ns, nl, "__platform_exit") == 1 { true }
  else { if src_eq(src, ns, nl, "__platform_native_host_target") == 1 { true }
  else { src_eq(src, ns, nl, "__platform_terminal_is_tty") == 1 } } } } } } } } } } } } } } } } } } } } } } } } } }
