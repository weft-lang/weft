  else { 0 - 1 } } }
}

pub(package) fn intrinsic_platform_proc_arity(src: i64, ns: i64, nl: i64) -> i64 {
  if src_eq(src, ns, nl, "__platform_proc_pipe") == 1 { return 1 } else { 0 }
  if src_eq(src, ns, nl, "__platform_proc_set_cloexec") == 1 { return 1 } else { 0 }
  if src_eq(src, ns, nl, "__platform_proc_set_nonblocking") == 1 { return 1 } else { 0 }
  if src_eq(src, ns, nl, "__platform_proc_spawn") == 1 { return 5 } else { 0 }
  if src_eq(src, ns, nl, "__platform_proc_wait_blocking") == 1 { return 2 } else { 0 }
  if src_eq(src, ns, nl, "__platform_proc_wait_nonblocking") == 1 { return 2 } else { 0 }
  if src_eq(src, ns, nl, "__platform_proc_kill") == 1 { return 1 } else { 0 }
  if src_eq(src, ns, nl, "__platform_proc_id") == 1 { return 0 } else { 0 }
  if src_eq(src, ns, nl, "__platform_proc_fork") == 1 { return 0 } else { 0 }
  if src_eq(src, ns, nl, "__platform_proc_set_group") == 1 { return 1 } else { 0 }
  if src_eq(src, ns, nl, "__platform_proc_dup_to") == 1 { return 2 } else { 0 }
  if src_eq(src, ns, nl, "__platform_proc_exec") == 1 { return 3 } else { 0 }
  if src_eq(src, ns, nl, "__platform_proc_wait_usage") == 1 { return 4 } else { 0 }
  0 - 1
}

