    } else { i = i + 1 }
  }
  found
}

pub(package) fn deferred_fiber_clause_stores_continuation(clause: i64, src: i64) -> i64 {
  let cont = node_f4(clause)
  if cont == 0 { 0 } else { deferred_fiber_body_stores_continuation(node_f3(clause), cont, src) }
}

pub(package) fn deferred_fiber_direct_call_supported(node: i64, clause: i64, src: i64, ft: i64) -> i64 {
  if node_tag(node) != 4 { 0 }
  else {
    let params = ftypes_lookup_params(ft, src, node_f1(node), node_f2(node))
    let body = ftypes_lookup_body(ft, src, node_f1(node), node_f2(node))
    let ret_ty = ftypes_lookup(ft, src, node_f1(node), node_f2(node))
    if params == 0 or body == 0 { 0 }
    else { if deferred_fiber_clause_stores_continuation(clause, src) == 0 { 0 }
    else { if nlist_len(params) != node_f4(node) { 0 }
    else { if deferred_fiber_params_unmanaged(params) == 0 { 0 }
    else { if deferred_split_type_is_managed(ret_ty) == 1 { 0 }
    else { if deferred_fiber_body_has_perform(body, clause, src) == 1 { 1 } else { 0 } } } } } }
  }
}

pub(package) fn deferred_fiber_dynamic_call_supported(node: i64, clause: i64, src: i64, env: i64) -> i64 {
  0
}

pub(package) fn deferred_fiber_perform_count(node: i64, clause: i64, src: i64, env: i64, ft: i64) -> i64 {
  if node == 0 { 0 }
  else {
    match node_tag(node) {
      3 -> deferred_fiber_count_add(deferred_fiber_perform_count(node_f2(node), clause, src, env, ft), deferred_fiber_perform_count(node_f3(node), clause, src, env, ft))
      4 -> {
        let arg_count = deferred_fiber_count_list(node_f3(node), node_f4(node), clause, src, env, ft)
        let direct_count = if deferred_fiber_direct_call_supported(node, clause, src, ft) == 1 { 1 } else { 0 }
        let callee_count = if direct_count == 1 { 1 } else { deferred_fiber_dynamic_call_supported(node, clause, src, env) }
        deferred_fiber_count_add(arg_count, callee_count)
      }
      5 -> {
        let cond_count = deferred_fiber_perform_count(node_f1(node), clause, src, env, ft)
        let then_count = deferred_fiber_perform_count(node_f2(node), clause, src, env, ft)
        let else_count = deferred_fiber_perform_count(node_f3(node), clause, src, env, ft)
        deferred_fiber_count_add(cond_count, deferred_fiber_count_max(then_count, else_count))
      }
      6 -> deferred_fiber_count_add(deferred_fiber_perform_count(node_f3(node), clause, src, env, ft), deferred_fiber_perform_count(node_f4(node), clause, src, env, ft))
      7 -> deferred_fiber_count_add(deferred_fiber_perform_count(node_f1(node), clause, src, env, ft), deferred_fiber_perform_count(node_f2(node), clause, src, env, ft))
      10 -> 0 - 1
      11 -> deferred_fiber_count_add(deferred_fiber_perform_count(node_f3(node), clause, src, env, ft), deferred_fiber_perform_count(node_f4(node), clause, src, env, ft))
      12 -> deferred_fiber_perform_count(node_f3(node), clause, src, env, ft)
      57 -> deferred_fiber_count_add(deferred_fiber_perform_count(node_f1(node), clause, src, env, ft), deferred_fiber_perform_count(node_f2(node), clause, src, env, ft))
      13 -> deferred_fiber_perform_count(node_f1(node), clause, src, env, ft)
      59 -> deferred_fiber_perform_count(node_f1(node), clause, src, env, ft)
      60 -> deferred_fiber_count_add(deferred_fiber_perform_count(node_f1(node), clause, src, env, ft), deferred_fiber_perform_count(node_f2(node), clause, src, env, ft))
      61 -> deferred_fiber_count_add(deferred_fiber_perform_count(node_f1(node), clause, src, env, ft), deferred_fiber_count_add(deferred_fiber_perform_count(node_f2(node), clause, src, env, ft), deferred_fiber_perform_count(node_f3(node), clause, src, env, ft)))
      62 -> deferred_fiber_count_add(deferred_fiber_perform_count(node_f1(node), clause, src, env, ft), deferred_fiber_count_add(deferred_fiber_perform_count(node_f2(node), clause, src, env, ft), deferred_fiber_perform_count(node_f3(node), clause, src, env, ft)))
      14 -> {
        let fields = node_f3(node)
        let nfields = node_f4(node)
        let mut count = 0
        for ri in 0..nfields {
          count = deferred_fiber_count_add(count, deferred_fiber_perform_count(node_f3(nlist_get(fields, ri)), clause, src, env, ft))
        }
        count
      }
      63 -> deferred_fiber_count_add(deferred_fiber_perform_count(node_f1(node), clause, src, env, ft), deferred_fiber_count_list(record_field_expr_nodes(node_f2(node), node_f3(node)), node_f3(node), clause, src, env, ft))
      58 -> deferred_fiber_count_list(node_f1(node), node_f2(node), clause, src, env, ft)
      15 -> {
        let arms = node_f2(node)
        let n = node_f3(node)
        let mut arm_max = 0
        for i in 0..n {
          let arm = nlist_get(arms, i)
          let guard = node_f3(arm)
          let guard_count = if guard != 0 { deferred_fiber_perform_count(guard, clause, src, env, ft) } else { 0 }
          let arm_count = deferred_fiber_count_add(guard_count, deferred_fiber_perform_count(node_f2(arm), clause, src, env, ft))
          arm_max = deferred_fiber_count_max(arm_max, arm_count)
        }
        deferred_fiber_count_add(deferred_fiber_perform_count(node_f1(node), clause, src, env, ft), arm_max)
      }
      22 -> deferred_fiber_perform_count(node_f1(node), clause, src, env, ft)
      25 -> deferred_fiber_perform_count(node_f1(node), clause, src, env, ft)
      26 -> deferred_fiber_perform_count(node_f1(node), clause, src, env, ft)
      32 -> if handler_clause_matches_perform_node(clause, node, src) == 1 { 1 }
        else { deferred_fiber_count_list(node_f4(node), nlist_len(node_f4(node)), clause, src, env, ft) }
      33 -> 0 - 1
      35 -> deferred_fiber_perform_count(node_f1(node), clause, src, env, ft)
      36 -> {
        let call_node = node_f2(node)
        deferred_fiber_count_list(generic_call_inner_args(call_node), generic_call_inner_arg_count(call_node), clause, src, env, ft)
      }
      37 -> deferred_fiber_perform_count(node_f1(node), clause, src, env, ft)
      41 -> deferred_fiber_count_add(deferred_fiber_perform_count(node_f1(node), clause, src, env, ft), deferred_fiber_count_list(node_f3(node), nlist_len(node_f3(node)), clause, src, env, ft))
      45 -> deferred_fiber_perform_count(node_f1(node), clause, src, env, ft)
      46 -> deferred_fiber_count_add(deferred_fiber_perform_count(node_f1(node), clause, src, env, ft), deferred_fiber_perform_count(node_f2(node), clause, src, env, ft))
      47 -> 0 - 1
      48 -> deferred_fiber_perform_count(node_f1(node), clause, src, env, ft)
      49 -> 0 - 1
      52 -> deferred_fiber_count_add(deferred_fiber_perform_count(node_f1(node), clause, src, env, ft), deferred_fiber_perform_count(node_f2(node), clause, src, env, ft))
      _ -> 0
    }
  }
}

pub(package) fn deferred_fiber_semantic_body_supported(node: i64) -> bool {
  if node == 0 { false }
  else {
    match node_tag(node) {
      -- A known call (including a generic call) is the important dynamic
      -- effect boundary: its checked signature, not a callee-body syntax
      -- scan, says which deferred atom may reach the handler.
      4 -> true
      36 -> true
      -- Nested handlers remain one fiber body. Their own clauses are emitted
      -- out of line; the handled body is where suspension can arrive.
      33 -> deferred_fiber_semantic_body_supported(node_f1(node))
      37 -> deferred_fiber_semantic_body_supported(node_f1(node))
      _ -> false
    }
  }
}

pub(package) fn deferred_fiber_semantic_effect_supports_clause(handle_body: i64, clause: i64, src: i64, env: i64, ft: i64, tt: i64) -> bool {
  let op = lookup_handler_clause_op(clause, src, tt)
  if op == 0 or node_f4(clause) == 0 or
    deferred_fiber_semantic_body_supported(handle_body) == 0 or
    deferred_fiber_params_unmanaged(node_f3(op)) == 0 { false }
  else {
    let body_ty = synth(handle_body, env, ft, src, tt)
    if deferred_split_type_is_managed(body_ty) == 1 { false }
    else {
      let expected = handler_clause_atom(clause, src)
      let body_effects = infer_expr_effects(handle_body, env, ft, src, tt)
      let actual = effect_sig_find_atom_by_head(body_effects, effect_atom_head(expected))
      -- An absent atom makes the clause unreachable and is therefore safe;
      -- opaque residual tails may still deliver it dynamically. A known
      -- same-head atom must retain exact declaration/argument identity.
      actual == 0 or effect_atom_eq(actual, expected)
    }
  }
}

pub(package) fn deferred_fiber_handle_supports_clause(handle_body: i64, clauses: i64, nclauses: i64, clause: i64, src: i64, env: i64, ft: i64, tt: i64) -> bool {
  if node_f4(clause) == 0 { false }
  else { if nclauses == 1 and deferred_fiber_perform_count(handle_body, clause, src, env, ft) > 0 { true }
  else { deferred_fiber_semantic_effect_supports_clause(handle_body, clause, src, env, ft, tt) } }
}

pub(package) fn check_handler_clause(clause: i64, handled_eff_hash: i64, env: i64, ft: i64, src: i64, caller_eff: i64, tt: i64, cont_ctx: i64) -[Conformance, Diagnose]> i64 {
  let names = node_f1(clause)
  let params = node_f2(clause)
  let cbody = node_f3(clause)
  let effect_ref = handler_clause_effect_ref_node(clause)
  let eff_ident = handler_clause_effect_ident_node(clause)
  let clause_eff_hash = typeck_effect_ref_name_hash(effect_ref, src)
  let handled_atom = node_f4(cont_ctx)
  let clause_eff = if handled_eff_hash == effect_hash_unsafe() {
    effect_add(caller_eff, handled_eff_hash)
  } else { caller_eff }
  let mut errors = 0
  errors = errors + check_effect_ref_type_arg_count(effect_ref, src, tt)
  errors = errors + check_effect_ref_trait_bounds(effect_ref, src, tt)
  if handled_eff_hash != 0 {
    let atom_mismatch = if handled_atom != 0 and typeck_effect_ref_is_parameterized(effect_ref) == 1 {
      not effect_atom_eq(handler_clause_atom(clause, src), handled_atom)
    } else { false }
    if clause_eff_hash != handled_eff_hash or atom_mismatch {
      typeck_error(src, if eff_ident == 0 { 0 } else { node_f1(eff_ident) }, "type error: handler clause effect mismatch")
      errors = errors + 1
    } else { errors = errors }
  } else { errors = errors }
  let op = lookup_handler_clause_op(clause, src, tt)
  if op != 0 {
    let effect_entry = typeck_effect_ref_entry(effect_ref, src, tt)
    errors = errors + check_effect_operation_visible(
      effect_entry, op, src, handler_clause_op_name_start(clause), tt
    )
  } else { errors = errors }
  if op == 0 {
    typeck_error(src, handler_clause_op_name_start(clause), "type error: unknown effect operation")
    errors = errors + 1
    errors = errors + check_resume_captures(cbody, src, 0)
    errors = errors + check_closure_mut_captures(cbody, params, nlist_len(params), env, src)
    errors = errors + check_expr(cbody, env, ft, src, clause_eff, tt)
    errors
  } else {
    let op_params = node_f3(op)
    let effect_entry = typeck_effect_ref_entry(effect_ref, src, tt)
    let effect_src = if effect_entry == 0 { src } else { ttable_entry_source(effect_entry) }
    let cont = node_f4(clause)
    let nparams = nlist_len(params)
    let noparams = nlist_len(op_params)
    errors = errors + check_arity(noparams, nparams, src, handler_clause_op_name_start(clause))
    if cont != 0 {
      if effect_op_is_deferred(op) == 0 {
        typeck_error(src, node_f1(cont), "type error: handler continuation requires deferred effect operation")
        errors = errors + 1
      } else { errors = errors }
    } else { errors = errors }
    let nbind = if nparams < noparams { nparams } else { noparams }
    -- parameterized effects: instantiating substitution for a parameterized handled atom,
    -- carried in cont_ctx f3 (0 for bare effects).
    let hsubst = node_f3(cont_ctx)
    if cont != 0 and effect_op_params_have_borrow(op_params, hsubst) == 1 {
      typeck_error(src, node_f1(cont), "type error: borrowed effect parameter cannot enter a deferred continuation")
      errors = errors + 1
    } else { errors = errors }
    let mut clause_env = env
    for pi in 0..nbind {
      let param = nlist_get(params, pi)
      let op_param = nlist_get(op_params, pi)
      let raw_op_ty = node_f3(op_param)
      let op_ty = if raw_op_ty != 0 and hsubst != 0 { ty_subst(raw_op_ty, hsubst) } else { raw_op_ty }
      let raw_ann_ty = node_f3(param)
      let ann_ty = if raw_ann_ty != 0 and hsubst != 0 { ty_subst(raw_ann_ty, hsubst) } else { raw_ann_ty }
      let bind_ty = if ann_ty != 0 {
        if op_ty != 0 {
          if not is_subtype(op_ty, ann_ty) {
            typeck_report_type_mismatch(
              src, node_f1(param), node_f2(param), op_ty, ann_ty, "handler parameter",
              typeck_source_location(effect_src, node_f1(op_param), node_f2(op_param)), tt
            )
            errors = errors + 1
          } else { errors = errors }
        } else { errors = errors }
        ann_ty
      } else {
        if op_ty != 0 { op_ty } else { ty_any() }
      }
      clause_env = tenv_bind_kind(clause_env, src, node_f1(param), node_f2(param), bind_ty, semantic_symbol_kind_parameter())
      typeck_record_binding_fact(tt, src, node_f1(param), node_f2(param), bind_ty, semantic_symbol_kind_parameter(), clause_env)
    }
    let handle_result_ty = node_f1(cont_ctx)
    let allow_non_tail = node_f2(cont_ctx)
    let raw_op_ret = effect_op_ret_type(op)
    let op_ret = if raw_op_ret != 0 and hsubst != 0 { ty_subst(raw_op_ret, hsubst) } else { raw_op_ret }
    let expected_ret = if op_ret != 0 { op_ret } else { ty_any() }
    if cont != 0 {
      let cont_ty = continuation_fn_type(expected_ret, handle_result_ty)
      clause_env = tenv_bind_kind(clause_env, src, node_f1(cont), node_f2(cont), cont_ty, semantic_symbol_kind_parameter())
      typeck_record_binding_fact(tt, src, node_f1(cont), node_f2(cont), cont_ty, semantic_symbol_kind_parameter(), clause_env)
    } else { clause_env = clause_env }
    typeck_record_handler_clause_effect_facts(clause, clause_env, src, tt, op)
    let body_ty = synth(cbody, clause_env, ft, src, tt)
    errors = errors + check_resume_captures(cbody, src, 0)
    errors = errors + check_continuation_usage(cbody, cont, src, allow_non_tail, ft)
    if cont != 0 {
      errors = errors + check_no_resume_with_continuation(cbody, src)
    } else { errors = errors }
    -- Immediate handler frames borrow captures from their enclosing lexical
    -- frame and cannot outlive it. This admits a scoped resource borrow while
    -- continuing to reject mutable binding capture. Deferred clauses keep the
    -- ordinary escaping-closure fence because their continuation may outlive
    -- the current activation.
    errors = errors + if cont == 0 {
      check_immediate_handler_captures(cbody, params, nparams, env, src)
    } else {
      check_closure_mut_captures(cbody, params, nparams, env, src)
    }
    errors = errors + check_expr(cbody, clause_env, ft, src, clause_eff, tt)
    -- A clause that never resumes aborts the handle with its value: its
    -- body types against the handle result, not the operation's return.
    let clause_ret = if cont != 0 { handle_result_ty }
      else { if clause_body_has_resume(cbody) == 1 { expected_ret } else { handle_result_ty } }
    errors = errors + check_return_values_at(
      cbody, clause_env, ft, src, clause_ret, tt,
      typeck_source_location(effect_src, node_f1(op), node_f2(op))
    )
    if not is_subtype(body_ty, clause_ret) {
      typeck_report_expr_type_mismatch(
        src, cbody, clause_ret, body_ty, "handler clause result",
        typeck_source_location(effect_src, node_f1(op), node_f2(op)), tt
      )
      errors = errors + 1
    } else { errors = errors }
    errors
  }
}

pub(package) fn handler_clause_eff_hash(clause: i64, src: i64) -> i64 {
  typeck_effect_ref_name_hash(handler_clause_effect_ref_node(clause), src)
}

pub(package) fn handler_clause_op_hash(clause: i64, src: i64) -> i64 {
  effect_name_hash(src, handler_clause_op_name_start(clause), handler_clause_op_name_len(clause))
}

pub(package) fn handler_has_clause(clauses: i64, nclauses: i64, atom: i64, op_hash: i64, src: i64) -> bool {
  let mut i = 0
  let mut found = false
  while i < nclauses {
    let clause = nlist_get(clauses, i)
    if effect_atom_eq(handler_clause_atom(clause, src), atom) {
      if handler_clause_op_hash(clause, src) == op_hash {
        found = true
        i = nclauses
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  found
}

pub(package) fn check_handler_duplicate_clauses(clauses: i64, nclauses: i64, src: i64) -[Diagnose]> i64 {
  let mut errors = 0
  let mut i = 0
  while i < nclauses {
    let clause = nlist_get(clauses, i)
    let atom = handler_clause_atom(clause, src)
    let op_hash = handler_clause_op_hash(clause, src)
    let mut j = i + 1
    while j < nclauses {
      let other = nlist_get(clauses, j)
      if effect_atom_eq(handler_clause_atom(other, src), atom) {
        if handler_clause_op_hash(other, src) == op_hash {
          typeck_error(src, handler_clause_op_name_start(other), "type error: duplicate handler clause")
          errors = errors + 1
        } else { errors = errors }
      } else { errors = errors }
      j = j + 1
    }
    i = i + 1
  }
  errors
}

pub(package) fn check_missing_handler_clause_for_perform(node: i64, clauses: i64, nclauses: i64, handled_eff_hash: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  let lhs = node_f1(node)
  if typeck_is_effect_ref(lhs, src, tt) {
    let eff_hash = typeck_effect_ref_name_hash(lhs, src)
    let perform_atom = typeck_effect_ref_atom(lhs, src)
    let handled_atom = if nclauses > 0 { handler_clause_atom(nlist_get(clauses, 0), src) } else { 0 }
    if eff_hash == handled_eff_hash and handled_atom != 0 and effect_atom_eq(perform_atom, handled_atom) {
      let op_hash = effect_name_hash(src, node_f2(node), node_f3(node))
      if handler_has_clause(clauses, nclauses, handled_atom, op_hash, src) {
        0
      } else {
        typeck_error(src, node_f2(node), "type error: missing handler clause")
        1
      }
    } else { 0 }
  } else { 0 }
}

pub(package) fn check_missing_handler_clauses_list(items: i64, count: i64, clauses: i64, nclauses: i64, handled_eff_hash: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  let mut errors = 0
  for i in 0..count {
    errors = errors + check_missing_handler_clauses(nlist_get(items, i), clauses, nclauses, handled_eff_hash, src, tt)
  }
  errors
}

pub(package) fn check_missing_handler_clauses(node: i64, clauses: i64, nclauses: i64, handled_eff_hash: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  if node == 0 { 0 }
  else {
    let tag = node_tag(node)
    let mut errors = 0
    match tag {
      3 -> {
        errors = errors + check_missing_handler_clauses(node_f2(node), clauses, nclauses, handled_eff_hash, src, tt)
        errors = errors + check_missing_handler_clauses(node_f3(node), clauses, nclauses, handled_eff_hash, src, tt)
        errors
      }
      4 -> {
        let args = node_f3(node)
        let nargs = node_f4(node)
        for i in 0..nargs {
          errors = errors + check_missing_handler_clauses(nlist_get(args, i), clauses, nclauses, handled_eff_hash, src, tt)
        }
        errors
      }
      5 -> {
        errors = errors + check_missing_handler_clauses(node_f1(node), clauses, nclauses, handled_eff_hash, src, tt)
        errors = errors + check_missing_handler_clauses(node_f2(node), clauses, nclauses, handled_eff_hash, src, tt)
        errors = errors + check_missing_handler_clauses(node_f3(node), clauses, nclauses, handled_eff_hash, src, tt)
        errors
      }
      6 -> {
        errors = errors + check_missing_handler_clauses(node_f3(node), clauses, nclauses, handled_eff_hash, src, tt)
        errors = errors + check_missing_handler_clauses(node_f4(node), clauses, nclauses, handled_eff_hash, src, tt)
        errors
      }
      7 -> {
        errors = errors + check_missing_handler_clauses(node_f1(node), clauses, nclauses, handled_eff_hash, src, tt)
        errors = errors + check_missing_handler_clauses(node_f2(node), clauses, nclauses, handled_eff_hash, src, tt)
        errors
      }
      10 -> {
        errors = errors + check_missing_handler_clauses(node_f1(node), clauses, nclauses, handled_eff_hash, src, tt)
        errors = errors + check_missing_handler_clauses(node_f2(node), clauses, nclauses, handled_eff_hash, src, tt)
        errors
      }
      11 -> {
        errors = errors + check_missing_handler_clauses(node_f3(node), clauses, nclauses, handled_eff_hash, src, tt)
        errors = errors + check_missing_handler_clauses(node_f4(node), clauses, nclauses, handled_eff_hash, src, tt)
        errors
      }
      12 -> check_missing_handler_clauses(node_f3(node), clauses, nclauses, handled_eff_hash, src, tt)
      57 -> check_missing_handler_clauses(node_f1(node), clauses, nclauses, handled_eff_hash, src, tt) + check_missing_handler_clauses(node_f2(node), clauses, nclauses, handled_eff_hash, src, tt)
      13 -> check_missing_handler_clauses(node_f1(node), clauses, nclauses, handled_eff_hash, src, tt)
      59 -> check_missing_handler_clauses(node_f1(node), clauses, nclauses, handled_eff_hash, src, tt)
      60 -> check_missing_handler_clauses(node_f1(node), clauses, nclauses, handled_eff_hash, src, tt) + check_missing_handler_clauses(node_f2(node), clauses, nclauses, handled_eff_hash, src, tt)
      61 -> check_missing_handler_clauses(node_f1(node), clauses, nclauses, handled_eff_hash, src, tt) + check_missing_handler_clauses(node_f2(node), clauses, nclauses, handled_eff_hash, src, tt) + check_missing_handler_clauses(node_f3(node), clauses, nclauses, handled_eff_hash, src, tt)
      62 -> check_missing_handler_clauses(node_f1(node), clauses, nclauses, handled_eff_hash, src, tt) + check_missing_handler_clauses(node_f2(node), clauses, nclauses, handled_eff_hash, src, tt) + check_missing_handler_clauses(node_f3(node), clauses, nclauses, handled_eff_hash, src, tt)
      14 -> {
        let fields = node_f3(node)
        let nfields = node_f4(node)
        for ri in 0..nfields {
          let field = nlist_get(fields, ri)
          errors = errors + check_missing_handler_clauses(node_f3(field), clauses, nclauses, handled_eff_hash, src, tt)
        }
        errors
      }
      63 -> check_missing_handler_clauses(node_f1(node), clauses, nclauses, handled_eff_hash, src, tt) + check_missing_handler_clauses_list(record_field_expr_nodes(node_f2(node), node_f3(node)), node_f3(node), clauses, nclauses, handled_eff_hash, src, tt)
      58 -> {
        for ai in 0..node_f2(node) {
          errors = errors + check_missing_handler_clauses(nlist_get(node_f1(node), ai), clauses, nclauses, handled_eff_hash, src, tt)
        }
        errors
      }
      15 -> {
        errors = errors + check_missing_handler_clauses(node_f1(node), clauses, nclauses, handled_eff_hash, src, tt)
        let arms = node_f2(node)
        let narms = node_f3(node)
        for mi in 0..narms {
          let arm = nlist_get(arms, mi)
          errors = errors + check_missing_handler_clauses(node_f2(arm), clauses, nclauses, handled_eff_hash, src, tt)
          errors = errors + check_missing_handler_clauses(node_f3(arm), clauses, nclauses, handled_eff_hash, src, tt)
        }
        errors
      }
      22 -> check_missing_handler_clauses(node_f1(node), clauses, nclauses, handled_eff_hash, src, tt)
      25 -> check_missing_handler_clauses(node_f1(node), clauses, nclauses, handled_eff_hash, src, tt)
      26 -> check_missing_handler_clauses(node_f1(node), clauses, nclauses, handled_eff_hash, src, tt)
      32 -> {
        if typeck_qualified_call_declaration(node) == 0 {
          errors = errors + check_missing_handler_clause_for_perform(node, clauses, nclauses, handled_eff_hash, src, tt)
        } else { 0 }
        let args = node_f4(node)
        let nargs = nlist_len(args)
        for ai in 0..nargs {
          errors = errors + check_missing_handler_clauses(nlist_get(args, ai), clauses, nclauses, handled_eff_hash, src, tt)
        }
        errors
      }
      35 -> check_missing_handler_clauses(node_f1(node), clauses, nclauses, handled_eff_hash, src, tt)
      36 -> {
        let call_node = node_f2(node)
        let args = generic_call_inner_args(call_node)
        let nargs = generic_call_inner_arg_count(call_node)
        for ai in 0..nargs {
          errors = errors + check_missing_handler_clauses(nlist_get(args, ai), clauses, nclauses, handled_eff_hash, src, tt)
        }
        errors
      }
      37 -> check_missing_handler_clauses(node_f1(node), clauses, nclauses, handled_eff_hash, src, tt)
      41 -> {
        let args = node_f3(node)
        let nargs = nlist_len(args)
        for ai in 0..nargs {
          errors = errors + check_missing_handler_clauses(nlist_get(args, ai), clauses, nclauses, handled_eff_hash, src, tt)
        }
        errors
      }
      45 -> check_missing_handler_clauses(node_f1(node), clauses, nclauses, handled_eff_hash, src, tt)
      46 -> {
        errors = errors + check_missing_handler_clauses(node_f1(node), clauses, nclauses, handled_eff_hash, src, tt)
        errors = errors + check_missing_handler_clauses(node_f2(node), clauses, nclauses, handled_eff_hash, src, tt)
        errors
      }
      47 -> {
        errors = errors + check_missing_handler_clauses(node_f3(node), clauses, nclauses, handled_eff_hash, src, tt)
        errors = errors + check_missing_handler_clauses(node_f4(node), clauses, nclauses, handled_eff_hash, src, tt)
        errors
      }
      48 -> check_missing_handler_clauses(node_f1(node), clauses, nclauses, handled_eff_hash, src, tt)
      49 -> check_missing_handler_clauses(node_f1(node), clauses, nclauses, handled_eff_hash, src, tt)
      52 -> {
        errors = errors + check_missing_handler_clauses(node_f1(node), clauses, nclauses, handled_eff_hash, src, tt)
        errors = errors + check_missing_handler_clauses(node_f2(node), clauses, nclauses, handled_eff_hash, src, tt)
        errors
      }
      _ -> errors
    }
  }
}

