pub(package) fn ttable_lookup_method_effects(tt: i64, type_hash: i64, method_hash: i64) -> i64 {
  if tt == 0 { 0 }
  else {
    let n = mem_load64_at(tt, 8)
    let d = mem_load64_at(tt, 0)
    let mut i = 0
