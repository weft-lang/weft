  else { if src_eq(src, ns, nl, "__platform_rename") == 1 { true }
  else { if src_eq(src, ns, nl, "__platform_io_error") == 1 { true }
  else { if src_eq(src, ns, nl, "__platform_map_rw_anonymous") == 1 { true }
  else { if src_eq(src, ns, nl, "__platform_remap_rw_anonymous_fixed") == 1 { true }
  else { if src_eq(src, ns, nl, "__platform_unmap") == 1 { true }
