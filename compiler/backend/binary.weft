-- compiler/backend/binary.weft -- fixed-width fields of binary containers
--
-- Container layouts are computed in i64 arithmetic, but every emitted field
-- has a fixed unsigned width. A computed value outside its field's range is
-- a compiler defect, so these appends refuse it loudly instead of emitting
-- truncated bytes.

use stdlib/bytes as bytes
use stdlib/bytes.{Bytes}
use stdlib/bytes/builder.{Builder}
use stdlib/panic.{panic}
use stdlib/result.{Err, Ok}
use stdlib/string

fn binary_field_fits(value: i64, bits: i64) -> bool {
  value >= 0 and (bits >= 63 or value bshr bits == 0)
}

fn binary_field(value: i64, bits: i64) -> u64 {
  if not binary_field_fits(value, bits) {
    panic(i"binary field value {value} does not fit {bits} unsigned bits")
  }
  __i64_to_u64(value)
}

-- An unsigned count or offset of the builder, which fits i64.
pub(package) fn binary_len(out: borrow Builder) -> i64 {
  __u64_to_i64(__usize_to_u64(out.len()))
}

fn binary_offset(value: i64) -> usize {
  if value < 0 { panic(i"binary offset {value} is negative") }
  __i64_to_usize(value)
}

pub(package) fn binary_u8(out: borrow mut Builder, value: i64) -> nil {
  out.push(__u64_to_u8(binary_field(value, 8)))
}

pub(package) fn binary_u16(out: borrow mut Builder, value: i64) -> nil {
  out.append_u16_le(__u64_to_u16(binary_field(value, 16)))
}

pub(package) fn binary_u32(out: borrow mut Builder, value: i64) -> nil {
  out.append_u32_le(__u64_to_u32(binary_field(value, 32)))
}

pub(package) fn binary_u64(out: borrow mut Builder, value: i64) -> nil {
  out.append_u64_le(binary_field(value, 64))
}

-- Big-endian fields, as code-signature blobs store them.
pub(package) fn binary_u32_be(out: borrow mut Builder, value: i64) -> nil {
  binary_field(value, 32)
  for index in 0..4 { binary_u8(out, (value bshr (8 * (3 - index))) band 255) }
}

pub(package) fn binary_u64_be(out: borrow mut Builder, value: i64) -> nil {
  binary_field(value, 64)
  for index in 0..8 { binary_u8(out, (value bshr (8 * (7 - index))) band 255) }
}

-- Unsigned LEB128: seven value bits per byte, low group first.
pub(package) fn binary_uleb128(out: borrow mut Builder, value: i64) -> nil {
  let mut remaining = __u64_to_i64(binary_field(value, 64))
  let mut done = false
  while not done {
    let low = remaining band 127
    remaining = remaining bshr 7
    if remaining == 0 {
      binary_u8(out, low)
      done = true
    } else { binary_u8(out, low + 128) }
  }
}

-- A field whose format stores a two's-complement signed 32-bit integer.
pub(package) fn binary_i32(out: borrow mut Builder, value: i64) -> nil {
  if value < 0 - 2147483648 or value > 2147483647 {
    panic(i"binary field value {value} does not fit 32 signed bits")
  }
  out.append_u32_le(__u64_to_u32(__i64_to_u64(value band 4294967295)))
}

-- The UTF-8 bytes of `text` followed by one zero byte.
pub(package) fn binary_cstring(out: borrow mut Builder, text: str) -> nil {
  out.append_text(text)
  out.push(__i64_to_u8(0))
}

-- `text` padded with zero bytes to exactly `width` bytes, as fixed-size name
-- fields store it. Longer text is a layout defect.
pub(package) fn binary_fixed_text(out: borrow mut Builder, text: str, width: i64) -> nil {
  let start = binary_len(out)
  out.append_text(text)
  if binary_len(out) - start > width {
    panic(i"binary name {text} is longer than its {width}-byte field")
  }
  out.pad_to(binary_offset(start + width))
}

pub(package) fn binary_zeros(out: borrow mut Builder, count: i64) -> nil {
  out.append_zeros(binary_offset(count))
}

-- Zero bytes until the builder holds `length` bytes.
pub(package) fn binary_pad_to(out: borrow mut Builder, length: i64) -> nil {
  out.pad_to(binary_offset(length))
}

-- Overwrite the 32-bit field at `offset`, which the layout already wrote.
pub(package) fn binary_set_u32(out: borrow mut Builder, offset: i64, value: i64) -> nil {
  match out.set_u32_le(binary_offset(offset), __u64_to_u32(binary_field(value, 32))) {
    Ok(_) -> nil
    Err(_) -> panic(i"binary patch at {offset} lies outside the written bytes")
  }
}

-- A capacity hint from a computed size; nothing is reserved for a negative one.
pub(package) fn binary_capacity(size: i64) -> usize {
  if size <= 0 { __i64_to_usize(0) } else { __i64_to_usize(size) }
}

pub(package) fn binary_bytes_len(values: Bytes) -> i64 {
  __u64_to_i64(__usize_to_u64(values.len()))
}

-- The UTF-8 byte length of `text`, as string tables lay it out.
pub(package) fn binary_text_len(text: str) -> i64 {
  __u64_to_i64(__usize_to_u64(text.len()))
}
