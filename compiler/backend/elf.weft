-- compiler/backend/elf.weft -- deterministic ELF64/AArch64 executable emission
--
-- This Linux leaf emits a standalone ET_EXEC image with an RX load, optional
-- compiler-owned RW data or zero-fill storage, optional non-loaded DWARF
-- sections, and an explicit non-executable stack policy. It has no PT_INTERP,
-- dynamic section, libc dependency, or host linker step. Load segments use the
-- AArch64 64 KiB maximum page alignment so the same image remains valid on
-- 4 KiB, 16 KiB, and 64 KiB Linux kernels. The header, program-header and
-- debug-section writers are shared with the dynamic executable layout.

use compiler/backend/binary.{*}
use compiler/backend/dwarf.{NativeDwarfSections}
use stdlib/bytes.{Bytes}
use stdlib/bytes/builder as byte_builder
use stdlib/bytes/builder.{Builder}

pub(package) type ElfExecutableEmission {
  ElfExecutableEmitted(Bytes),
  ElfExecutableInvalidEntryOffset(i64, i64)
}

pub(package) fn elf_aarch64_image_base() -> i64 { 4194304 }

pub(package) fn elf_aarch64_code_file_offset() -> i64 { 4096 }

pub(package) fn elf_aarch64_segment_alignment() -> i64 { 65536 }

pub(package) fn elf_align(value: i64, alignment: i64) -> i64 {
  (value + alignment - 1) / alignment * alignment
}

pub(package) fn elf_aarch64_zero_fill_file_offset(code_size: i64) -> i64 {
  elf_align(elf_aarch64_code_file_offset() + code_size, elf_aarch64_segment_alignment())
}

-- The null section, three DWARF sections and their name table.
fn elf_debug_section_count() -> i64 { 5 }

-- "\0.debug_abbrev\0.debug_info\0.debug_line\0.shstrtab\0"
fn elf_debug_section_names_size() -> i64 { 49 }

-- The section-header table offset of an image whose loaded bytes end at
-- `loaded_file_size`, or zero when it carries no debug sections.
pub(package) fn elf_section_headers_offset(
  loaded_file_size: i64,
  debug: NativeDwarfSections?
) -> i64 {
  match debug {
    nil -> 0
    sections: NativeDwarfSections -> {
      let NativeDwarfSections(abbrev, info, line) = sections
      elf_align(
        loaded_file_size + binary_bytes_len(abbrev) + binary_bytes_len(info) +
          binary_bytes_len(line) + elf_debug_section_names_size(),
        8
      )
    }
  }
}

-- The ELF file header of an AArch64 executable. The section-name table is
-- the last section when the image carries sections.
pub(package) fn elf_emit_file_header(
  out: borrow mut Builder,
  entry_address: i64,
  program_count: i64,
  section_headers_offset: i64,
  debug: NativeDwarfSections?
) -> nil {
  let section_count = match debug {
    nil -> 0
    sections: NativeDwarfSections -> elf_debug_section_count()
  }
  binary_u8(out, 127)
  out.append_text("ELF")
  binary_u8(out, 2) -- ELFCLASS64
  binary_u8(out, 1) -- ELFDATA2LSB
  binary_u8(out, 1) -- EV_CURRENT
  binary_u8(out, 0) -- ELFOSABI_NONE / System V
  binary_zeros(out, 8)
  binary_u16(out, 2) -- ET_EXEC
  binary_u16(out, 183) -- EM_AARCH64
  binary_u32(out, 1) -- EV_CURRENT
  binary_u64(out, entry_address)
  binary_u64(out, 64) -- program-header table offset
  binary_u64(out, section_headers_offset)
  binary_u32(out, 0) -- AArch64 processor flags
  binary_u16(out, 64) -- ELF header size
  binary_u16(out, 56) -- program-header entry size
  binary_u16(out, program_count)
  binary_u16(out, if section_count > 0 { 64 } else { 0 })
  binary_u16(out, section_count)
  binary_u16(out, if section_count > 0 { section_count - 1 } else { 0 })
}

pub(package) fn elf_emit_program_header(
  out: borrow mut Builder,
  kind: i64,
  flags: i64,
  offset: i64,
  address: i64,
  file_size: i64,
  memory_size: i64,
  alignment: i64
) -> nil {
  binary_u32(out, kind)
  binary_u32(out, flags)
  binary_u64(out, offset)
  binary_u64(out, address)
  binary_u64(out, address)
  binary_u64(out, file_size)
  binary_u64(out, memory_size)
  binary_u64(out, alignment)
}

-- The RX segment mapping the headers and code from the start of the file.
pub(package) fn elf_emit_code_program_header(out: borrow mut Builder, file_size: i64) -> nil {
  elf_emit_program_header(
    out,
    1, -- PT_LOAD
    5, -- PF_R | PF_X
    0,
    elf_aarch64_image_base(),
    file_size,
    file_size,
    elf_aarch64_segment_alignment()
  )
}

-- An RW segment of `file_size` file bytes followed by zero fill up to
-- `memory_size`.
pub(package) fn elf_emit_data_program_header(
  out: borrow mut Builder,
  file_offset: i64,
  file_size: i64,
  memory_size: i64
) -> nil {
  elf_emit_program_header(
    out,
    1, -- PT_LOAD
    6, -- PF_R | PF_W
    file_offset,
    elf_aarch64_image_base() + file_offset,
    file_size,
    memory_size,
    elf_aarch64_segment_alignment()
  )
}

pub(package) fn elf_emit_non_executable_stack_program_header(out: borrow mut Builder) -> nil {
  -- PT_GNU_STACK with PF_R | PF_W, deliberately no PF_X.
  elf_emit_program_header(out, 1685382481, 6, 0, 0, 0, 0, 16)
}

fn elf_emit_section_header(
  out: borrow mut Builder,
  name: i64,
  kind: i64,
  offset: i64,
  size: i64,
  alignment: i64
) -> nil {
  binary_u32(out, name)
  binary_u32(out, kind)
  binary_u64(out, 0) -- non-allocated debug/string section
  binary_u64(out, 0)
  binary_u64(out, offset)
  binary_u64(out, size)
  binary_u32(out, 0)
  binary_u32(out, 0)
  binary_u64(out, alignment)
  binary_u64(out, 0)
}

-- The non-loaded DWARF sections, their names and the section-header table,
-- written after the loaded image ends at `loaded_file_size`.
pub(package) fn elf_emit_debug_sections(
  out: borrow mut Builder,
  loaded_file_size: i64,
  section_headers_offset: i64,
  debug: NativeDwarfSections?
) -> nil {
  match debug {
    nil -> nil
    sections: NativeDwarfSections -> {
      let NativeDwarfSections(abbrev, info, line) = sections
      let abbrev_offset = loaded_file_size
      let info_offset = abbrev_offset + binary_bytes_len(abbrev)
      let line_offset = info_offset + binary_bytes_len(info)
      let names_offset = line_offset + binary_bytes_len(line)
      binary_pad_to(out, abbrev_offset)
      out.append(abbrev)
      out.append(info)
      out.append(line)
      binary_u8(out, 0)
      binary_cstring(out, ".debug_abbrev")
      binary_cstring(out, ".debug_info")
      binary_cstring(out, ".debug_line")
      binary_cstring(out, ".shstrtab")
      binary_pad_to(out, section_headers_offset)
      elf_emit_section_header(out, 0, 0, 0, 0, 0)
      elf_emit_section_header(out, 1, 1, abbrev_offset, binary_bytes_len(abbrev), 1) -- PROGBITS
      elf_emit_section_header(out, 15, 1, info_offset, binary_bytes_len(info), 1)
      elf_emit_section_header(out, 27, 1, line_offset, binary_bytes_len(line), 1)
      elf_emit_section_header(
        out,
        39,
        3, -- STRTAB
        names_offset,
        elf_debug_section_names_size(),
        1
      )
    }
  }
}

--- Emit a standalone executable entering `code` at `entry_offset`. A
--- nonempty `data`, or a `data_memory_size` above zero, maps an RW segment at
--- the first segment boundary after the code: the data bytes followed by zero
--- fill up to `data_memory_size`. Debug sections follow the loaded image.
pub(package) fn emit_elf_aarch64_standalone_executable(
  code: Bytes,
  entry_offset: i64,
  data: Bytes,
  data_memory_size: i64,
  debug: NativeDwarfSections?
) -> ElfExecutableEmission {
  let code_size = binary_bytes_len(code)
  if entry_offset < 0 or entry_offset >= code_size {
    ElfExecutableInvalidEntryOffset(entry_offset, code_size)
  } else {
    let code_file_offset = elf_aarch64_code_file_offset()
    let code_file_size = code_file_offset + code_size
    let data_offset = elf_aarch64_zero_fill_file_offset(code_size)
    let data_size = binary_bytes_len(data)
    let memory_size = if data_memory_size > data_size { data_memory_size } else { data_size }
    let loaded_file_size = if memory_size > 0 { data_offset + data_size } else { code_file_size }
    let section_headers_offset = elf_section_headers_offset(loaded_file_size, debug)
    let file_size = match debug {
      nil -> loaded_file_size
      sections: NativeDwarfSections -> section_headers_offset +
        elf_debug_section_count() * 64
    }
    let mut out = byte_builder.with_capacity(binary_capacity(file_size))
    elf_emit_file_header(
      out,
      elf_aarch64_image_base() + code_file_offset + entry_offset,
      if memory_size > 0 { 3 } else { 2 },
      section_headers_offset,
      debug
    )
    elf_emit_code_program_header(out, code_file_size)
    if memory_size > 0 { elf_emit_data_program_header(out, data_offset, data_size, memory_size) }
    elf_emit_non_executable_stack_program_header(out)
    binary_pad_to(out, code_file_offset)
    out.append(code)
    if memory_size > 0 {
      binary_pad_to(out, data_offset)
      out.append(data)
    }
    elf_emit_debug_sections(out, loaded_file_size, section_headers_offset, debug)
    ElfExecutableEmitted(out.finish())
  }
}
