-- compiler/backend/object.weft -- Mach-O relocatable object emission (.o)
--
-- An open module, one without a closed entry graph, is emitted as a
-- relocatable object for a consumer's platform linker. External calls are
-- BL 0 plus ARM64_RELOC_BRANCH26 against undefined symbols, static
-- program-image slots live in a zero-fill __DATA,__wstatic section, and used
-- system libraries are recorded as LC_LINKER_OPTION commands.

use compiler/backend/binary.{*}
use compiler/storage.{compiler_capacity_hint}
use runtime/object_storage.{*}
use stdlib/bytes.{Bytes}
use stdlib/bytes/builder as byte_builder
use stdlib/bytes/builder.{Builder}
use stdlib/vector as vector
use stdlib/vector.{*}

-- A symbol-table entry: its name's offset in the string table, and section
-- 0 for undefined, 1 for __text or 2 for __wstatic. The tables hold only
-- scalar fields, so vectors store their entries inline.
pub(package) type ObjectSymbol {
  name_offset: i64,
  value: i64,
  section: i64
}

pub(package) type ObjectRelocationKind {
  ObjectBranch26,
  ObjectPage21,
  ObjectPageOff12,
  -- ARM64_RELOC_ADDEND carries the addend of the entry that follows it.
  ObjectAddend
}

-- A relocation as the format stores it: the site and the encoded info word.
pub(package) type ObjectRelocation {
  address: i64,
  info: i64
}

-- `target` is the symbol index, or the addend of an ObjectAddend entry.
pub(package) fn object_relocation(
  address: i64,
  target: i64,
  kind: ObjectRelocationKind
) -> ObjectRelocation {
  ObjectRelocation { address: address, info: target + object_relocation_kind_bits(kind) }
}

-- The pcrel, length, extern and type fields of each kind.
fn object_relocation_kind_bits(kind: ObjectRelocationKind) -> i64 {
  match kind {
    -- ARM64_RELOC_BRANCH26 (type 2), extern, length 2, pcrel: 0x2D000000
    ObjectBranch26 -> 754974720
    -- ARM64_RELOC_PAGE21 (type 3), extern, length 2, pcrel: 0x3D000000
    ObjectPage21 -> 1023410176
    -- ARM64_RELOC_PAGEOFF12 (type 4), extern, length 2: 0x4C000000
    ObjectPageOff12 -> 1275068416
    -- ARM64_RELOC_ADDEND (type 10), length 2: 0xA4000000
    ObjectAddend -> 2751463424
  }
}

-- Add a symbol, writing its name to the string table with the leading
-- underscore of C symbols.
pub(package) fn object_add_symbol(
  syms: borrow Vector<ObjectSymbol>,
  strings: borrow mut Builder,
  name: str,
  value: i64,
  section: i64
) -> nil {
  vector_push<ObjectSymbol>(
    syms,
    ObjectSymbol { name_offset: binary_len(strings), value: value, section: section }
  )
  binary_u8(strings, 95)
  binary_cstring(strings, name)
}

-- External symbol names for GOT indices used by linked user programs.
pub(package) fn got_sym_name(gi: i64) -> str {
  match gi {
    0 -> "posix_spawn"
    1 -> "waitpid"
    2 -> "exit"
    3 -> "pthread_create"
    4 -> "pthread_join"
    5 -> "mmap"
    6 -> "write"
    7 -> "read"
    8 -> "open"
    9 -> "close"
    10 -> "pthread_mutex_init"
    11 -> "pthread_mutex_lock"
    12 -> "pthread_mutex_unlock"
    13 -> "pthread_mutex_destroy"
    14 -> "pthread_cond_init"
    15 -> "pthread_cond_wait"
    16 -> "pthread_cond_signal"
    17 -> "pthread_cond_broadcast"
    18 -> "pthread_cond_destroy"
    19 -> "clock_gettime"
    20 -> "nanosleep"
    21 -> "getenv"
    22 -> "opendir"
    23 -> "readdir"
    24 -> "closedir"
    25 -> "stat"
    26 -> "mkdir"
    27 -> "remove"
    28 -> "rename"
    29 -> "getcwd"
    30 -> "__error"
    31 -> "pipe"
    32 -> "posix_spawn_file_actions_init"
    33 -> "posix_spawn_file_actions_adddup2"
    34 -> "posix_spawn_file_actions_addclose"
    35 -> "posix_spawn_file_actions_destroy"
    36 -> "kill"
    37 -> "getaddrinfo"
    38 -> "freeaddrinfo"
    39 -> "signal"
    40 -> "fork"
    _ -> "unknown"
  }
}

pub(package) fn got_sym_count() -> i64 { 41 }

-- The relocatable object for an open module's generated code.
pub(package) fn compile_object(code: Bytes, fm: i64) -> Bytes {
  -- Static program-image values live in a shared zerofill __DATA,__wstatic
  -- section; ADRP/ADD sites relocate against its base symbol with an
  -- ARM64_RELOC_ADDEND carrying the slot offset.
  let nslots = object_storage_static_value_slot_count(fm)
  let wsize = nslots * 16
  let code_size = binary_bytes_len(code)
  let wstatic_addr = (code_size + 15) / 16 * 16
  let native_external_count = object_storage_native_external_count(fm)
  -- Defined symbols come first: the startup entry, the embedded provenance
  -- table and an optional wstatic base. Relocation indices follow this order.
  let syms = vector.with_capacity<ObjectSymbol>(
    compiler_capacity_hint(got_sym_count() + native_external_count + 3)
  )
  let mut strings = byte_builder.new()
  binary_u8(strings, 0)
  object_add_symbol(syms, strings, "main", 0, 1)
  object_add_symbol(
    syms,
    strings,
    "weft_provenance",
    object_storage_native_provenance_table_offset(fm),
    1
  )
  if nslots > 0 { object_add_symbol(syms, strings, "weft_static_pairs", wstatic_addr, 2) }
  for gi in 0..got_sym_count() { object_add_symbol(syms, strings, got_sym_name(gi), 0, 0) }
  -- Manifest-native externals follow the fixed runtime bridge symbols. Their
  -- GOT indices are assigned lazily in the same used-list order, so relocation
  -- indices and undefined-symbol order share one deterministic source.
  for ni in 0..native_external_count {
    object_add_symbol(syms, strings, object_storage_native_external_symbol(fm, ni), 0, 0)
  }
  let extdef_shift = 1 + (if nslots > 0 { 1 } else { 0 })

  let gn = object_storage_got_patch_count(fm)
  let spn = object_storage_static_pair_patch_count(fm)
  let relocs = vector.with_capacity<ObjectRelocation>(
    compiler_capacity_hint(gn + spn * 4 + 2)
  )
  for i in 0..gn {
    -- Undefined symbols follow the defined ones.
    vector_push<ObjectRelocation>(
      relocs,
      object_relocation(
        object_storage_got_patch_code_pos(fm, i),
        object_storage_got_patch_index(fm, i) + 1 + extdef_shift,
        ObjectBranch26
      )
    )
  }
  -- Startup's provenance ADRP/ADD pair relocates against the local table
  -- symbol in __text. This remains ASLR- and final-link-placement-safe even
  -- when the table lies more than ADR's +/-1 MiB range from startup.
  let provenance_adrp_pos = object_storage_native_provenance_adrp_pos(fm)
  vector_push<ObjectRelocation>(relocs, object_relocation(provenance_adrp_pos, 1, ObjectPage21))
  vector_push<ObjectRelocation>(
    relocs,
    object_relocation(provenance_adrp_pos + 4, 1, ObjectPageOff12)
  )
  -- Static-pair ADRP/ADD sites: ADDEND must directly precede the entry
  -- it modifies. The wstatic base symbol has final index 2.
  for i in 0..spn {
    let adrp_pos = object_storage_static_pair_patch_code_pos(fm, i)
    let slot_off = object_storage_static_pair_patch_slot_off(fm, i)
    vector_push<ObjectRelocation>(relocs, object_relocation(adrp_pos, slot_off, ObjectAddend))
    vector_push<ObjectRelocation>(relocs, object_relocation(adrp_pos, 2, ObjectPage21))
    vector_push<ObjectRelocation>(relocs, object_relocation(adrp_pos + 4, slot_off, ObjectAddend))
    vector_push<ObjectRelocation>(relocs, object_relocation(adrp_pos + 4, 2, ObjectPageOff12))
  }

  emit_object_with_link_plan(code, relocs, syms, strings.finish(), wstatic_addr, wsize, fm)
}

fn object_system_library_link(fm: i64, index: i64) -> str? {
  let entry = object_storage_native_link_library_entry(fm, index)
  if object_storage_native_link_library_is_used(entry) == 1 and
    object_storage_native_link_library_kind(entry) == 1 {
      object_storage_native_link_library_link(entry)
    } else { nil }
}

fn object_link_option_size(link: str) -> i64 {
  (12 + 2 + binary_text_len(link) + 1 + 7) / 8 * 8
}

pub(package) fn object_link_option_argument_count(fm: i64) -> i64 {
  let mut count = 0
  for i in 0..object_storage_native_link_library_count(fm) {
    match object_system_library_link(fm, i) {
      nil -> nil
      link: str -> { count = count + 1 }
    }
  }
  count
}

pub(package) fn object_link_option_command_size(fm: i64) -> i64 {
  let mut size = 0
  for i in 0..object_storage_native_link_library_count(fm) {
    match object_system_library_link(fm, i) {
      nil -> nil
      link: str -> { size = size + object_link_option_size(link) }
    }
  }
  size
}

-- One LC_LINKER_OPTION `-l<name>` command per used system library.
pub(package) fn object_emit_link_options(o: borrow mut Builder, fm: i64) -> nil {
  for i in 0..object_storage_native_link_library_count(fm) {
    match object_system_library_link(fm, i) {
      nil -> nil
      link: str -> {
        let start = binary_len(o)
        let size = object_link_option_size(link)
        binary_u32(o, 45) -- cmd: LC_LINKER_OPTION
        binary_u32(o, size)
        binary_u32(o, 1)
        o.append_text("-l")
        binary_cstring(o, link)
        binary_pad_to(o, start + size)
      }
    }
  }
}

fn object_emit_symbol(o: borrow mut Builder, symbol: ObjectSymbol) -> nil {
  binary_u32(o, symbol.name_offset)
  if symbol.section >= 1 {
    binary_u8(o, 15) -- n_type: N_SECT | N_EXT
    binary_u8(o, symbol.section)
  } else {
    binary_u8(o, 1) -- n_type: N_UNDF | N_EXT
    binary_u8(o, 0) -- n_sect: NO_SECT
  }
  binary_u16(o, 0) -- n_desc
  binary_u64(o, if symbol.section >= 1 { symbol.value } else { 0 })
}

-- A complete object from generated code, its relocations, its symbols and
-- their string table, with a zerofill __wstatic section when `wsize` is
-- positive.
pub(package) fn emit_object_with_link_plan(
  code: Bytes,
  relocs: borrow Vector<ObjectRelocation>,
  syms: borrow Vector<ObjectSymbol>,
  strings: Bytes,
  wstatic_addr: i64,
  wsize: i64,
  fm: i64
) -> Bytes {
  let code_size = binary_bytes_len(code)
  let nrelocs = vector_len<ObjectRelocation>(relocs)
  let nsyms = vector_len<ObjectSymbol>(syms)
  let nsects = if wsize > 0 { 2 } else { 1 }
  let hdr_size = 32
  let seg_cmd_size = 72 + 80 * nsects
  let linker_option_cmd_size = object_link_option_command_size(fm)
  let cmds_size = seg_cmd_size + 24 + 24 + 80 + linker_option_cmd_size
  let code_off = hdr_size + cmds_size
  let reloc_off = code_off + code_size
  let sym_off = reloc_off + nrelocs * 8
  let str_off = sym_off + nsyms * 16

  let mut nextdef = 0
  for i in 0..nsyms {
    if vector_get_in_bounds<ObjectSymbol>(syms, i).section >= 1 { nextdef = nextdef + 1 }
  }
  let strsize = binary_bytes_len(strings)

  let mut o = byte_builder.with_capacity(binary_capacity(str_off + strsize))
  -- Mach-O header
  binary_u32(o, 4277009103) -- magic: 0xFEEDFACF
  binary_u32(o, 16777228) -- cputype: ARM64
  binary_u32(o, 0) -- cpusubtype: ALL
  binary_u32(o, 1) -- filetype: MH_OBJECT
  binary_u32(o, 4 + object_link_option_argument_count(fm)) -- ncmds
  binary_u32(o, cmds_size)
  binary_u32(o, 8192) -- flags: MH_SUBSECTIONS_VIA_SYMBOLS
  binary_u32(o, 0)

  -- LC_SEGMENT_64
  binary_u32(o, 25)
  binary_u32(o, seg_cmd_size)
  binary_zeros(o, 16) -- segname: empty
  binary_u64(o, 0) -- vmaddr
  binary_u64(o, if wsize > 0 { wstatic_addr + wsize } else { code_size }) -- vmsize
  binary_u64(o, code_off) -- fileoff
  binary_u64(o, code_size) -- filesize
  binary_u32(o, 7) -- maxprot: rwx
  binary_u32(o, 7) -- initprot: rwx
  binary_u32(o, nsects)
  binary_u32(o, 0)

  -- section_64 __TEXT,__text
  binary_fixed_text(o, "__text", 16)
  binary_fixed_text(o, "__TEXT", 16)
  binary_u64(o, 0) -- addr
  binary_u64(o, code_size)
  binary_u32(o, code_off)
  binary_u32(o, 2) -- align: 2^2
  binary_u32(o, reloc_off)
  binary_u32(o, nrelocs)
  -- S_REGULAR | S_ATTR_PURE_INSTRUCTIONS | S_ATTR_SOME_INSTRUCTIONS
  binary_u32(o, 2147484672)
  binary_zeros(o, 12)

  -- section_64 __DATA,__wstatic: zerofill static closure-pair slots
  if wsize > 0 {
    binary_fixed_text(o, "__wstatic", 16)
    binary_fixed_text(o, "__DATA", 16)
    binary_u64(o, wstatic_addr)
    binary_u64(o, wsize)
    binary_u32(o, 0) -- offset: zerofill has no file content
    binary_u32(o, 4) -- align: 2^4
    binary_u32(o, 0) -- reloff
    binary_u32(o, 0) -- nreloc
    binary_u32(o, 1) -- flags: S_ZEROFILL
    binary_zeros(o, 12)
  }

  -- LC_BUILD_VERSION
  binary_u32(o, 50)
  binary_u32(o, 24)
  binary_u32(o, 1) -- platform: PLATFORM_MACOS
  binary_u32(o, 917504) -- minos: 14.0.0
  binary_u32(o, 983040) -- sdk: 15.0.0
  binary_u32(o, 0) -- ntools

  -- Manifest-selected library directives, as compatibility metadata. Native
  -- product finalization consumes the same typed plan directly.
  object_emit_link_options(o, fm)

  -- LC_SYMTAB
  binary_u32(o, 2)
  binary_u32(o, 24)
  binary_u32(o, sym_off)
  binary_u32(o, nsyms)
  binary_u32(o, str_off)
  binary_u32(o, strsize)

  -- LC_DYSYMTAB: every defined symbol is external, then the undefined ones.
  binary_u32(o, 11)
  binary_u32(o, 80)
  binary_u32(o, 0) -- ilocalsym
  binary_u32(o, 0) -- nlocalsym
  binary_u32(o, 0) -- iextdefsym
  binary_u32(o, nextdef) -- nextdefsym
  binary_u32(o, nextdef) -- iundefsym
  binary_u32(o, nsyms - nextdef) -- nundefsym
  binary_zeros(o, 48)

  o.append(code)
  for i in 0..nrelocs {
    let relocation = vector_get_in_bounds<ObjectRelocation>(relocs, i)
    binary_u32(o, relocation.address)
    binary_u32(o, relocation.info)
  }
  -- nlist_64 entries: defined symbols, then undefined symbols.
  for i in 0..nsyms {
    let symbol = vector_get_in_bounds<ObjectSymbol>(syms, i)
    if symbol.section >= 1 {
      object_emit_symbol(o, symbol)
    }
  }
  for i in 0..nsyms {
    let symbol = vector_get_in_bounds<ObjectSymbol>(syms, i)
    if symbol.section == 0 {
      object_emit_symbol(o, symbol)
    }
  }
  o.append(strings)
  o.finish()
}
