-- compiler/backend/dwarf.weft -- minimal honest native debug information
--
-- This is a pure interpretation of the shared final-layout provenance facts.
-- It emits DWARF v4 compile-unit, subprogram and line-table data only: names,
-- source files/lines, exact code ranges and frame-base shape. Variable
-- locations are deliberately absent until the optimizer can provide them as
-- stable facts.

use compiler/backend/binary.{*}
use compiler/backend/link.{*}
use stdlib/bytes as bytes
use stdlib/bytes.{Bytes}
use stdlib/bytes/builder as byte_builder
use stdlib/bytes/builder.{Builder}
use stdlib/list.{*}
use stdlib/string.{str_eq}

pub(package) type NativeDwarfSections {
  NativeDwarfSections(Bytes, Bytes, Bytes)
}

pub(package) fn native_dwarf_abbrev(sections: NativeDwarfSections) -> Bytes {
  match sections { NativeDwarfSections(abbrev, info, line) -> abbrev }
}

pub(package) fn native_dwarf_info(sections: NativeDwarfSections) -> Bytes {
  match sections { NativeDwarfSections(abbrev, info, line) -> info }
}

pub(package) fn native_dwarf_line(sections: NativeDwarfSections) -> Bytes {
  match sections { NativeDwarfSections(abbrev, info, line) -> line }
}

-- Signed LEB128 of a nonnegative value: it ends only once the sign bit of the
-- last group is clear.
fn native_dwarf_sleb_positive(out: borrow mut Builder, value: i64) -> nil {
  let mut remaining = value
  let mut done = false
  while not done {
    let byte = remaining band 127
    remaining = remaining bshr 7
    if remaining == 0 and byte band 64 == 0 {
      binary_u8(out, byte)
      done = true
    } else { binary_u8(out, byte + 128) }
  }
}

pub(package) fn native_dwarf_file_index(files: List<str>, wanted: str, index: i64) -> i64 {
  match files {
    Nil -> 0
    Cons(file, rest) -> {
      if str_eq(file, wanted) == 1 { index }
      else { native_dwarf_file_index(rest, wanted, index + 1) }
    }
  }
}

pub(package) fn native_dwarf_collect_files(functions: List<NativeLinkDebugFunction>) -> List<str>
{
  let mut files = Nil<str>()
  let mut current = functions
  let mut done = false
  while done == false {
    match current {
      Nil -> { done = true 0 }
      Cons(function, rest) -> match function {
        NativeLinkDebugFunction(start, end, name, file, line, col, framed) -> {
          if native_dwarf_file_index(files, file, 1) == 0 {
            files = files.append(file)
          } else { 0 }
          current = rest
          0
        }
      }
    }
  }
  files
}

pub(package) fn native_dwarf_low_pc(functions: List<NativeLinkDebugFunction>) -> i64 {
  match functions {
    Nil -> 0
    Cons(NativeLinkDebugFunction(start, end, name, file, line, col, framed), rest) -> {
      let mut low = start
      let mut current = rest
      let mut done = false
      while done == false {
        match current {
          Nil -> { done = true 0 }
          Cons(
            NativeLinkDebugFunction(
              next_start,
              next_end,
              next_name,
              next_file,
              next_line,
              next_col,
              next_framed
            ),
            next_rest
          ) ->
            {
              if next_start < low { low = next_start } else { 0 }
              current = next_rest
              0
            }
        }
      }
      low
    }
  }
}

pub(package) fn native_dwarf_high_pc(functions: List<NativeLinkDebugFunction>) -> i64 {
  let mut high = 0
  let mut current = functions
  let mut done = false
  while done == false {
    match current {
      Nil -> { done = true 0 }
      Cons(NativeLinkDebugFunction(start, end, name, file, line, col, framed), rest) -> {
        if end > high { high = end } else { 0 }
        current = rest
        0
      }
    }
  }
  high
}

fn native_dwarf_emit_abbrev() -> Bytes {
  let mut output = byte_builder.with_capacity(96)
  -- Abbrev 1: one compile unit with child subprograms.
  binary_uleb128(output, 1)
  binary_uleb128(output, 17) -- DW_TAG_compile_unit
  binary_u8(output, 1)
  binary_uleb128(output, 37)
  binary_uleb128(output, 8) -- producer/string
  binary_uleb128(output, 19)
  binary_uleb128(output, 5) -- language/data2
  binary_uleb128(output, 3)
  binary_uleb128(output, 8) -- name/string
  binary_uleb128(output, 16)
  binary_uleb128(output, 23) -- stmt_list/sec_offset
  binary_uleb128(output, 17)
  binary_uleb128(output, 1) -- low_pc/addr
  binary_uleb128(output, 18)
  binary_uleb128(output, 7) -- high_pc/data8
  binary_uleb128(output, 27)
  binary_uleb128(output, 8) -- comp_dir/string
  binary_uleb128(output, 0)
  binary_uleb128(output, 0)
  -- Abbrev 2: a source-named function with exact final range.
  binary_uleb128(output, 2)
  binary_uleb128(output, 46) -- DW_TAG_subprogram
  binary_u8(output, 0)
  binary_uleb128(output, 3)
  binary_uleb128(output, 8) -- name/string
  binary_uleb128(output, 58)
  binary_uleb128(output, 6) -- decl_file/data4
  binary_uleb128(output, 59)
  binary_uleb128(output, 6) -- decl_line/data4
  binary_uleb128(output, 57)
  binary_uleb128(output, 6) -- decl_column/data4
  binary_uleb128(output, 17)
  binary_uleb128(output, 1) -- low_pc/addr
  binary_uleb128(output, 18)
  binary_uleb128(output, 7) -- high_pc/data8
  binary_uleb128(output, 64)
  binary_uleb128(output, 24) -- frame_base/exprloc
  binary_uleb128(output, 63)
  binary_uleb128(output, 25) -- external/flag_present
  binary_uleb128(output, 0)
  binary_uleb128(output, 0)
  binary_uleb128(output, 0)
  output.finish()
}

fn native_dwarf_emit_info(
  functions: List<NativeLinkDebugFunction>,
  files: List<str>,
  code_base: i64
) -> Bytes {
  let mut body = byte_builder.with_capacity(1024)
  let low = native_dwarf_low_pc(functions)
  let high = native_dwarf_high_pc(functions)
  let unit_name = match files {
    Nil -> "weft package"
    Cons(file, rest) -> file
  }
  binary_uleb128(body, 1)
  binary_cstring(body, "Weft")
  binary_u16(body, 32768) -- DW_LANG_lo_user: Weft's provisional code.
  binary_cstring(body, unit_name)
  binary_u32(body, 0)
  binary_u64(body, code_base + low)
  binary_u64(body, high - low)
  binary_cstring(body, ".")
  let mut current = functions
  let mut done = false
  while done == false {
    match current {
      Nil -> { done = true 0 }
      Cons(NativeLinkDebugFunction(start, end, name, file, line, col, framed), rest) -> {
        binary_uleb128(body, 2)
        binary_cstring(body, name)
        binary_u32(body, native_dwarf_file_index(files, file, 1))
        binary_u32(body, line)
        binary_u32(body, col)
        binary_u64(body, code_base + start)
        binary_u64(body, end - start)
        binary_uleb128(body, 1)
        binary_u8(body, if framed { 109 } else { 111 }) -- DW_OP_reg29 / DW_OP_reg31
        current = rest
        0
      }
    }
  }
  binary_uleb128(body, 0)
  -- The unit header: length after this field, version 4, abbrev offset and
  -- address size.
  let mut output = byte_builder.with_capacity(body.len() + 16)
  binary_u32(output, 2 + 4 + 1 + binary_len(body))
  binary_u16(output, 4)
  binary_u32(output, 0)
  binary_u8(output, 8)
  output.append_from(body)
  output.finish()
}

fn native_dwarf_emit_line_header(files: List<str>) -> owned Builder {
  let mut header = byte_builder.with_capacity(256)
  binary_u8(header, 1) -- minimum_instruction_length
  binary_u8(header, 1) -- maximum_operations_per_instruction
  binary_u8(header, 1) -- default_is_stmt
  binary_u8(header, 251) -- line_base = -5
  binary_u8(header, 14) -- line_range
  binary_u8(header, 13) -- opcode_base
  -- Standard-opcode argument counts for opcodes 1..12.
  binary_u8(header, 0)
  binary_u8(header, 1)
  binary_u8(header, 1)
  binary_u8(header, 1)
  binary_u8(header, 1)
  binary_u8(header, 0)
  binary_u8(header, 0)
  binary_u8(header, 0)
  binary_u8(header, 1)
  binary_u8(header, 0)
  binary_u8(header, 0)
  binary_u8(header, 1)
  binary_u8(header, 0) -- no include directories
  let mut current = files
  let mut done = false
  while done == false {
    match current {
      Nil -> { done = true 0 }
      Cons(file, rest) -> {
        binary_cstring(header, file)
        binary_uleb128(header, 0)
        binary_uleb128(header, 0)
        binary_uleb128(header, 0)
        current = rest
        0
      }
    }
  }
  binary_u8(header, 0)
  header
}

fn native_dwarf_emit_line_program(
  functions: List<NativeLinkDebugFunction>,
  files: List<str>,
  code_base: i64
) -> owned Builder {
  let mut program = byte_builder.with_capacity(1024)
  let mut current = functions
  let mut done = false
  while done == false {
    match current {
      Nil -> { done = true 0 }
      Cons(NativeLinkDebugFunction(start, end, name, file, line, col, framed), rest) -> {
        binary_u8(program, 0)
        binary_uleb128(program, 9)
        binary_u8(program, 2) -- DW_LNE_set_address
        binary_u64(program, code_base + start)
        binary_u8(program, 4) -- DW_LNS_set_file
        binary_uleb128(program, native_dwarf_file_index(files, file, 1))
        if line > 1 {
          binary_u8(program, 3) -- DW_LNS_advance_line
          native_dwarf_sleb_positive(program, line - 1)
        } else { 0 }
        if col > 0 {
          binary_u8(program, 5) -- DW_LNS_set_column
          binary_uleb128(program, col)
        } else { 0 }
        binary_u8(program, 1) -- DW_LNS_copy
        binary_u8(program, 2) -- DW_LNS_advance_pc
        binary_uleb128(program, end - start)
        binary_u8(program, 0)
        binary_uleb128(program, 1)
        binary_u8(program, 1) -- DW_LNE_end_sequence
        current = rest
        0
      }
    }
  }
  program
}

fn native_dwarf_emit_line(
  functions: List<NativeLinkDebugFunction>,
  files: List<str>,
  code_base: i64
) -> Bytes {
  let header = native_dwarf_emit_line_header(files)
  let program = native_dwarf_emit_line_program(functions, files, code_base)
  -- The table header: length after this field, version 4 and header length.
  let mut output = byte_builder.with_capacity(header.len() + program.len() + 16)
  binary_u32(output, 2 + 4 + binary_len(header) + binary_len(program))
  binary_u16(output, 4)
  binary_u32(output, binary_len(header))
  output.append_from(header)
  output.append_from(program)
  output.finish()
}

pub(package) fn native_dwarf_sections(
  debug_information: NativeLinkDebugInformation,
  code_base: i64
) -> NativeDwarfSections {
  match debug_information {
    NativeLinkDebugInformationAbsent -> NativeDwarfSections(
      bytes.empty(),
      bytes.empty(),
      bytes.empty()
    )
    NativeLinkDwarfFunctionLineInformation(functions) -> {
      if functions.is_empty() {
        NativeDwarfSections(bytes.empty(), bytes.empty(), bytes.empty())
      } else {
        let files = native_dwarf_collect_files(functions)
        NativeDwarfSections(
          native_dwarf_emit_abbrev(),
          native_dwarf_emit_info(functions, files, code_base),
          native_dwarf_emit_line(functions, files, code_base)
        )
      }
    }
  }
}
