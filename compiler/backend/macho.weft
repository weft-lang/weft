-- macho.weft — Mach-O binary format emission with ad-hoc code signing

use compiler/storage.{*}
use compiler/backend/aarch64/codegen.{bytes_set_u32, runtime_main_stack_size}
use compiler/backend/binary.{*}
use compiler/backend/dwarf.{*}
use compiler/backend/aarch64/encode.{*}
use compiler/backend/link.{*}
use compiler/backend/target.{*}
use runtime/sha256.{*}
use runtime/buffer.{*}
use runtime/macho_storage.{*}
use stdlib/bytes.{Bytes, bytes_storage}
use stdlib/bytes/builder as byte_builder
use stdlib/bytes/builder.{Builder}
use stdlib/num
use stdlib/option
use stdlib/string.{str_len}
use stdlib/list.{*}

pub(package) fn emit_pz2(o: borrow mut Builder) -> nil {
  binary_zeros(o, 6)
  binary_u64(o, 0)
  binary_u64(o, 4294967296)
  binary_u64(o, 0)
  binary_u64(o, 0)
  binary_u32(o, 0)
  binary_u32(o, 0)
  binary_u32(o, 0)
  binary_u32(o, 0)
}

pub(package) fn emit_pz(o: borrow mut Builder) -> nil {
  binary_u32(o, 25)
  binary_u32(o, 72)
  o.append_text("__PAGEZERO")
  emit_pz2(o)
}

-- Round up to page boundary (16384)
pub(package) fn page_round(n: i64) -> i64 { ((n + 16383) / 16384) * 16384 }

pub(package) fn emit_text_seg2(o: borrow mut Builder, ts: i64) -> nil {
  binary_zeros(o, 10)
  binary_u64(o, 4294967296)
  binary_u64(o, ts)
  binary_u64(o, 0)
  binary_u64(o, ts)
  binary_u32(o, 5)
  binary_u32(o, 5)
  binary_u32(o, 1)
  binary_u32(o, 0)
}

pub(package) fn emit_text_seg(o: borrow mut Builder, ts: i64) -> nil {
  binary_u32(o, 25)
  binary_u32(o, 152)
  o.append_text("__TEXT")
  emit_text_seg2(o, ts)
}

pub(package) fn emit_text_sec2(o: borrow mut Builder, code_size: i64) -> nil {
  binary_zeros(o, 10)
  binary_u64(o, 4294983680)
  binary_u64(o, code_size)
  binary_u32(o, 16384)
  binary_u32(o, 2)
  binary_u32(o, 0)
  binary_u32(o, 0)
  binary_u32(o, 2147484672)
  binary_u32(o, 0)
  binary_u32(o, 0)
  binary_u32(o, 0)
}

pub(package) fn emit_text_sec(o: borrow mut Builder, code_size: i64) -> nil {
  binary_fixed_text(o, "__text", 16)
  o.append_text("__TEXT")
  emit_text_sec2(o, code_size)
}

-- sig_off is also the __LINKEDIT vmaddr offset: the segment starts
-- directly after the __DATA zero-fill block (ts + ds).
pub(package) fn emit_linkedit_signed2(
  o: borrow mut Builder,
  ts: i64,
  sig_off: i64,
  linkedit_size: i64
) -> nil {
  binary_zeros(o, 6)
  binary_u64(o, 4294967296 + sig_off)
  binary_u64(o, linkedit_size)
  binary_u64(o, sig_off)
  binary_u64(o, linkedit_size)
  binary_u32(o, 1)
  binary_u32(o, 1)
  binary_u32(o, 0)
  binary_u32(o, 0)
}

pub(package) fn emit_linkedit_signed(
  o: borrow mut Builder,
  ts: i64,
  sig_off: i64,
  linkedit_size: i64
) -> nil {
  binary_u32(o, 25)
  binary_u32(o, 72)
  o.append_text("__LINKEDIT")
  emit_linkedit_signed2(o, ts, sig_off, linkedit_size)
}

pub(package) fn emit_main_lc(o: borrow mut Builder, entry: i64) -> nil {
  binary_u32(o, 2147483688)
  binary_u32(o, 24)
  binary_u64(o, 16384 + entry)
  binary_u64(o, runtime_main_stack_size())
}

pub(package) fn emit_dylinker(o: borrow mut Builder) -> nil {
  binary_u32(o, 14)
  binary_u32(o, 32)
  binary_u32(o, 12)
  binary_fixed_text(o, "/usr/lib/dyld", 20)
}

pub(package) fn native_link_macho_version(major: i64, minor: i64, patch: i64) -> i64 {
  major * 65536 + minor * 256 + patch
}

pub(package) fn native_link_macho_image_base() -> i64 { 4294967296 }

pub(package) fn native_link_macho_code_base() -> i64 {
  native_link_macho_image_base() + 16384
}

pub(package) fn native_link_macho_build_version_command_count(
  platform: NativeArtifactPlatformAbi
) -> i64 {
  match platform {
    NativeArtifactMacosPlatformAbi(major, minor, patch) -> 1
    NativeArtifactLinuxKernelAbi(major, minor, patch) -> 0
    NativeArtifactLinuxDynamicAbi(major, minor, patch, libc, loader) -> 0
    NativeArtifactPlatformAbiUnspecified -> 0
  }
}

pub(package) fn native_link_macho_build_version_command_size(
  platform: NativeArtifactPlatformAbi
) -> i64 {
  native_link_macho_build_version_command_count(platform) * 24
}

pub(package) fn native_link_dwarf_size(sections: NativeDwarfSections) -> i64 {
  binary_bytes_len(native_dwarf_abbrev(sections)) + binary_bytes_len(native_dwarf_info(sections)) +
    binary_bytes_len(native_dwarf_line(sections))
}

pub(package) fn native_link_dwarf_command_count(sections: NativeDwarfSections) -> i64 {
  if native_link_dwarf_size(sections) > 0 { 1 } else { 0 }
}

pub(package) fn native_link_dwarf_command_size(sections: NativeDwarfSections) -> i64 {
  native_link_dwarf_command_count(sections) * 312
}

pub(package) fn native_link_emit_dwarf_section(
  output: borrow mut Builder,
  name: str,
  address: i64,
  size: i64,
  offset: i64
) -> nil {
  binary_fixed_text(output, name, 16)
  binary_fixed_text(output, "__DWARF", 16)
  binary_u64(output, address)
  binary_u64(output, size)
  binary_u32(output, offset)
  binary_u32(output, 0)
  binary_u32(output, 0)
  binary_u32(output, 0)
  binary_u32(output, 0)
  binary_u32(output, 0)
  binary_u32(output, 0)
  binary_u32(output, 0)
}

pub(package) fn native_link_emit_dwarf_segment(
  output: borrow mut Builder,
  sections: NativeDwarfSections,
  dwarf_offset: i64,
  dwarf_vm_size: i64
) -> nil {
  let abbrev_size = binary_bytes_len(native_dwarf_abbrev(sections))
  let info_size = binary_bytes_len(native_dwarf_info(sections))
  let line_size = binary_bytes_len(native_dwarf_line(sections))
  let dwarf_size = abbrev_size + info_size + line_size
  if dwarf_size == 0 { nil }
  else {
    let vmaddr = native_link_macho_image_base() + dwarf_offset
    binary_u32(output, 25)
    binary_u32(output, 312)
    binary_fixed_text(output, "__DWARF", 16)
    binary_u64(output, vmaddr)
    binary_u64(output, dwarf_vm_size)
    binary_u64(output, dwarf_offset)
    binary_u64(output, dwarf_size)
    binary_u32(output, 1)
    binary_u32(output, 1)
    binary_u32(output, 3)
    binary_u32(output, 0)
    native_link_emit_dwarf_section(output, "__debug_abbrev", vmaddr, abbrev_size, dwarf_offset)
    native_link_emit_dwarf_section(
      output,
      "__debug_info",
      vmaddr + abbrev_size,
      info_size,
      dwarf_offset + abbrev_size
    )
    native_link_emit_dwarf_section(
      output,
      "__debug_line",
      vmaddr + abbrev_size + info_size,
      line_size,
      dwarf_offset + abbrev_size + info_size
    )
  }
}

pub(package) fn native_link_write_dwarf_sections(
  output: borrow mut Builder,
  sections: NativeDwarfSections
) -> nil {
  output.append(native_dwarf_abbrev(sections))
  output.append(native_dwarf_info(sections))
  output.append(native_dwarf_line(sections))
}

pub(package) fn native_link_emit_uuid(output: borrow mut Builder, identity: Bytes) -> nil {
  let digest = sha256_digest_of_storage(bytes_storage(identity))
  binary_u32(output, 27)
  binary_u32(output, 24)
  for i in 0..16 {
    let byte = __u64_to_i64(__u8_to_u64(digest.get(__i64_to_usize(i)).unwrap_or(0)))
    -- Apple Mach-O LC_UUID values use the version-3 bit pattern, including
    -- system binaries whose identity is derived deterministically by ld.
    if i == 6 { binary_u8(output, (byte band 15) + 48) }
    else if i == 8 { binary_u8(output, (byte band 63) + 128) }
    else { binary_u8(output, byte) }
  }
}

-- Each identity part is length-prefixed so adjacent parts cannot alias.
pub(package) fn native_link_macho_identity_bytes(output: borrow mut Builder, part: Bytes) -> nil {
  binary_u64(output, binary_bytes_len(part))
  output.append(part)
}

pub(package) fn native_link_macho_identity_text(output: borrow mut Builder, part: str) -> nil {
  binary_u64(output, str_len(part))
  output.append_text(part)
}

pub(package) fn native_link_macho_identity(
  code: Bytes,
  archive_data: Bytes,
  dwarf: NativeDwarfSections,
  rebase: Bytes,
  bind: Bytes,
  strings: Bytes,
  dylibs: List<str>,
  layout: NativeLinkImageLayout,
  platform: NativeArtifactPlatformAbi
) -> Bytes {
  let mut identity = byte_builder.with_capacity(
    __i64_to_usize(
      binary_bytes_len(code) + binary_bytes_len(archive_data) + native_link_dwarf_size(dwarf) +
        binary_bytes_len(rebase) + binary_bytes_len(bind) + binary_bytes_len(strings) +
        native_link_dylib_commands_size(dylibs) + 256
    )
  )
  native_link_macho_identity_bytes(identity, code)
  native_link_macho_identity_bytes(identity, archive_data)
  native_link_macho_identity_bytes(identity, native_dwarf_abbrev(dwarf))
  native_link_macho_identity_bytes(identity, native_dwarf_info(dwarf))
  native_link_macho_identity_bytes(identity, native_dwarf_line(dwarf))
  native_link_macho_identity_bytes(identity, rebase)
  native_link_macho_identity_bytes(identity, bind)
  native_link_macho_identity_bytes(identity, strings)
  let mut current_dylib = dylibs
  let mut dylibs_done = false
  while dylibs_done == false {
    match current_dylib {
      Nil -> { dylibs_done = true 0 }
      Cons(dylib, rest) -> {
        native_link_macho_identity_text(identity, dylib)
        current_dylib = rest
        0
      }
    }
  }
  match layout {
    NativeLinkImageLayout(
      stub_base,
      code_size,
      text_size,
      static_offset,
      static_size,
      archive_offset,
      archive_size,
      archive_align,
      data_size
    ) ->
      {
        binary_u64(identity, stub_base)
        binary_u64(identity, code_size)
        binary_u64(identity, text_size)
        binary_u64(identity, static_offset)
        binary_u64(identity, static_size)
        binary_u64(identity, archive_offset)
        binary_u64(identity, archive_size)
        binary_u64(identity, archive_align)
        binary_u64(identity, data_size)
      }
  }
  match platform {
    NativeArtifactMacosPlatformAbi(major, minor, patch) -> {
      binary_u64(identity, 1)
      binary_u64(identity, major)
      binary_u64(identity, minor)
      binary_u64(identity, patch)
    }
    NativeArtifactLinuxKernelAbi(major, minor, patch) -> {
      binary_u64(identity, 2)
      binary_u64(identity, major)
      binary_u64(identity, minor)
      binary_u64(identity, patch)
    }
    NativeArtifactLinuxDynamicAbi(major, minor, patch, libc, loader) -> {
      binary_u64(identity, 3)
      binary_u64(identity, major)
      binary_u64(identity, minor)
      binary_u64(identity, patch)
      native_link_macho_identity_text(identity, libc)
      native_link_macho_identity_text(identity, loader)
    }
    NativeArtifactPlatformAbiUnspecified -> binary_u64(identity, 0)
  }
  identity.finish()
}

pub(package) fn native_link_emit_macho_build_version(
  output: borrow mut Builder,
  platform: NativeArtifactPlatformAbi
) -> nil {
  match platform {
    NativeArtifactMacosPlatformAbi(major, minor, patch) -> {
      let version = native_link_macho_version(major, minor, patch)
      binary_u32(output, 50)
      binary_u32(output, 24)
      binary_u32(output, 1)
      binary_u32(output, version)
      binary_u32(output, version)
      binary_u32(output, 0)
    }
    NativeArtifactLinuxKernelAbi(major, minor, patch) -> nil
    NativeArtifactLinuxDynamicAbi(major, minor, patch, libc, loader) -> nil
    NativeArtifactPlatformAbiUnspecified -> nil
  }
}

-- LC_CODE_SIGNATURE load command (16 bytes)
pub(package) fn emit_codesig_lc(o: borrow mut Builder, dataoff: i64, datasize: i64) -> nil {
  binary_u32(o, 29)
  binary_u32(o, 16)
  binary_u32(o, dataoff)
  binary_u32(o, datasize)
}

-- The ad-hoc code signature over `prefix`, the image bytes it signs. The
-- blob sizes are fixed by the page count, so they are written before the
-- page hashes.
pub(package) fn emit_codesig(
  o: borrow mut Builder,
  prefix: Bytes,
  codelimit: i64,
  text_off: i64,
  text_size: i64
) -> i64 {
  let nhashes = (codelimit + 4095) / 4096
  let hash_off = 93
  let cdir_size = hash_off + nhashes * 32
  let total_size = 20 + cdir_size
  emit_cs_super(o, total_size)
  emit_cs_cdir(o, cdir_size, hash_off, nhashes, codelimit)
  emit_cs_exec(o, text_off, text_size)
  emit_cs_id(o)
  emit_cs_hashes(o, prefix, codelimit, nhashes)
  total_size
}

pub(package) fn emit_cs_super(o: borrow mut Builder, total_size: i64) -> nil {
  binary_u32_be(o, 4208856256)
  binary_u32_be(o, total_size)
  binary_u32_be(o, 1)
  binary_u32_be(o, 0)
  binary_u32_be(o, 20)
}

pub(package) fn emit_cs_cdir(
  o: borrow mut Builder,
  cdir_size: i64,
  hash_off: i64,
  nhashes: i64,
  codelimit: i64
) -> nil {
  binary_u32_be(o, 4208856066)
  binary_u32_be(o, cdir_size)
  binary_u32_be(o, 132096)
  binary_u32_be(o, 131074)
  binary_u32_be(o, hash_off)
  binary_u32_be(o, 88)
  binary_u32_be(o, 0)
  binary_u32_be(o, nhashes)
  binary_u32_be(o, codelimit)
  emit_cs_cdir2(o)
}

pub(package) fn emit_cs_cdir2(o: borrow mut Builder) -> nil {
  binary_u8(o, 32)
  binary_u8(o, 2)
  binary_u8(o, 0)
  binary_u8(o, 12)
  binary_u32_be(o, 0)
  binary_u32_be(o, 0)
  binary_u32_be(o, 0)
  binary_u32_be(o, 0)
  binary_u64_be(o, 0)
}

pub(package) fn emit_cs_exec(o: borrow mut Builder, text_off: i64, text_size: i64) -> nil {
  binary_u64_be(o, text_off)
  binary_u64_be(o, text_size)
  binary_u64_be(o, 1)
}

pub(package) fn emit_cs_id(o: borrow mut Builder) -> nil {
  binary_u8(o, 119)
  binary_u8(o, 101)
  binary_u8(o, 102)
  binary_u8(o, 116)
  binary_u8(o, 0)
}

pub(package) fn emit_cs_hashes(
  o: borrow mut Builder,
  prefix: Bytes,
  codelimit: i64,
  nhashes: i64
) -> nil {
  for page in 0..nhashes {
    let off = page * 4096
    let len = if off + 4096 > codelimit { codelimit - off } else { 4096 }
    o.append(sha256_digest_of_bytes_range(prefix, off, len))
  }
}

-- LC_SYMTAB with real offsets
pub(package) fn emit_symtab_real(
  o: borrow mut Builder,
  symoff: i64,
  nsyms: i64,
  stroff: i64,
  strsize: i64
) -> nil {
  binary_u32(o, 2)
  binary_u32(o, 24)
  binary_u32(o, symoff)
  binary_u32(o, nsyms)
  binary_u32(o, stroff)
  binary_u32(o, strsize)
}

-- LC_DYLD_INFO_ONLY with bind offsets
pub(package) fn emit_dyld_info_rebase_bind(
  o: borrow mut Builder,
  rebase_off: i64,
  rebase_size: i64,
  bind_off: i64,
  bind_size: i64
) -> nil {
  binary_u32(o, 2147483682)
  binary_u32(o, 48)
  binary_u32(o, rebase_off)
  binary_u32(o, rebase_size)
  binary_u32(o, bind_off)
  binary_u32(o, bind_size)
  binary_u32(o, 0)
  binary_u32(o, 0)
  binary_u32(o, 0)
  binary_u32(o, 0)
  binary_u32(o, 0)
  binary_u32(o, 0)
}

pub(package) fn emit_dysymtab_with_defined(
  o: borrow mut Builder,
  indirect_off: i64,
  defined: i64,
  undefined: i64
) -> nil {
  binary_u32(o, 11)
  binary_u32(o, 80)
  binary_u32(o, 0)
  binary_u32(o, 0)
  binary_u32(o, 0)
  binary_u32(o, defined)
  binary_u32(o, defined)
  binary_u32(o, undefined)
  binary_u32(o, 0)
  binary_u32(o, 0)
  binary_u32(o, 0)
  binary_u32(o, 0)
  binary_u32(o, 0)
  binary_u32(o, 0)
  binary_u32(o, indirect_off)
  binary_u32(o, undefined)
  binary_u32(o, 0)
  binary_u32(o, 0)
  binary_u32(o, 0)
  binary_u32(o, 0)
}

-- The Mach-O leaf owns managed output buffers; the shared native-link module
-- remains a pure typed graph producer with no internal ownership privilege.
pub(package) fn native_link_emit_bind_data(symbols: List<NativeLinkSymbol>) -> Bytes {
  let mut bind = byte_builder.with_capacity(
    binary_capacity(compiler_signed_count(symbols.len()) * 40 + 16)
  )
  if not symbols.is_empty() {
    binary_u8(bind, 81)
    binary_u8(bind, 114)
    binary_uleb128(bind, 0)
    let mut current = symbols
    let mut done = false
    while done == false {
      match current {
        Nil -> { done = true 0 }
        Cons(symbol, rest) -> {
          match symbol {
            NativeLinkUndefinedStrong(name, ordinal, origin) -> {
              if ordinal <= 15 {
                binary_u8(bind, 16 + ordinal)
              } else {
                binary_u8(bind, 32)
                binary_uleb128(bind, ordinal)
              }
              binary_u8(bind, 64)
              binary_u8(bind, 95)
              bind.append_text(name)
              binary_u8(bind, 0)
              binary_u8(bind, 144)
            }
          }
          current = rest
          0
        }
      }
    }
  } else { 0 }
  binary_u8(bind, 0)
  bind.finish()
}

pub(package) fn native_link_emit_rebase_data(
  relocations: List<NativeLinkRelocation>,
  archive_offset: i64
) -> Bytes {
  let mut rebase = byte_builder.with_capacity(
    binary_capacity(compiler_signed_count(relocations.len()) * 16 + 8)
  )
  let mut current = relocations
  let mut done = false
  let mut started = false
  while done == false {
    match current {
      Nil -> { done = true 0 }
      Cons(relocation, rest) -> {
        match relocation {
          NativeLinkArchiveDataAbsolute64(site, target, addend) -> {
            if not started {
              binary_u8(rebase, 17)
              started = true
            }
            binary_u8(rebase, 34)
            binary_uleb128(rebase, archive_offset + site)
            binary_u8(rebase, 81)
          }
          _ -> nil
        }
        current = rest
        0
      }
    }
  }
  binary_u8(rebase, 0)
  rebase.finish()
}

pub(package) fn native_link_debug_string_bytes(functions: List<NativeLinkDebugFunction>) -> i64 {
  match functions {
    Nil -> 0
    Cons(NativeLinkDebugFunction(start, end, name, file, line, col, framed), rest) -> {
      2 + str_len(name) + native_link_debug_string_bytes(rest)
    }
  }
}

pub(package) fn native_link_emit_strtab(
  symbols: List<NativeLinkSymbol>,
  debug_information: NativeLinkDebugInformation
) -> Bytes {
  let functions = native_link_debug_functions(debug_information)
  let mut strings = byte_builder.with_capacity(
    binary_capacity(
      compiler_signed_count(symbols.len()) * 32 + native_link_debug_string_bytes(functions) + 8
    )
  )
  binary_u8(strings, 0)
  let mut current_function = functions
  let mut functions_done = false
  while functions_done == false {
    match current_function {
      Nil -> { functions_done = true 0 }
      Cons(NativeLinkDebugFunction(start, end, name, file, line, col, framed), rest) -> {
        binary_u8(strings, 95)
        strings.append_text(name)
        binary_u8(strings, 0)
        current_function = rest
        0
      }
    }
  }
  let mut current = symbols
  let mut done = false
  while done == false {
    match current {
      Nil -> { done = true 0 }
      Cons(symbol, rest) -> {
        match symbol {
          NativeLinkUndefinedStrong(name, ordinal, origin) -> {
            binary_u8(strings, 95)
            strings.append_text(name)
            binary_u8(strings, 0)
          }
        }
        current = rest
        0
      }
    }
  }
  strings.finish()
}

pub(package) fn native_link_emit_nlists(
  output: borrow mut Builder,
  code_base: i64,
  debug_information: NativeLinkDebugInformation,
  symbols: List<NativeLinkSymbol>
) -> nil {
  let mut string_offset = 1
  let mut current_function = native_link_debug_functions(debug_information)
  let mut functions_done = false
  while functions_done == false {
    match current_function {
      Nil -> { functions_done = true 0 }
      Cons(NativeLinkDebugFunction(start, end, name, file, line, col, framed), rest) -> {
        binary_u32(output, string_offset)
        binary_u8(output, 15)
        binary_u8(output, 1)
        binary_u8(output, 0)
        binary_u8(output, 0)
        binary_u64(output, code_base + start)
        string_offset = string_offset + 2 + str_len(name)
        current_function = rest
        0
      }
    }
  }
  let mut current = symbols
  let mut done = false
  while done == false {
    match current {
      Nil -> { done = true 0 }
      Cons(symbol, rest) -> {
        match symbol {
          NativeLinkUndefinedStrong(name, ordinal, origin) -> {
            binary_u32(output, string_offset)
            binary_u8(output, 1)
            binary_u8(output, 0)
            binary_u8(output, 0)
            binary_u8(output, ordinal)
            binary_u64(output, 0)
            string_offset = string_offset + 2 + str_len(name)
          }
        }
        current = rest
        0
      }
    }
  }
  nil
}

pub(package) fn native_link_emit_dylib_commands(
  output: borrow mut Builder,
  dylibs: List<str>
) -> nil {
  let mut current = dylibs
  let mut done = false
  while done == false {
    match current {
      Nil -> { done = true 0 }
      Cons(path, rest) -> {
        let start = binary_len(output)
        let size = native_link_dylib_command_size(path)
        binary_u32(output, 12)
        binary_u32(output, size)
        binary_u32(output, 24)
        binary_u32(output, 0)
        binary_u32(output, 65536)
        binary_u32(output, 65536)
        output.append_text(path)
        binary_u8(output, 0)
        binary_pad_to(output, start + size)
        current = rest
        0
      }
    }
  }
  nil
}

pub(package) fn native_link_emit_data_segment(
  output: borrow mut Builder,
  text_size: i64,
  data_size: i64,
  symbol_count: i64,
  static_offset: i64,
  static_size: i64,
  archive_offset: i64,
  archive_size: i64,
  archive_align: i64
) -> nil {
  let section_count = 1 + (if static_size > 0 { 1 } else { 0 }) + (
    if archive_size > 0 { 1 } else { 0 }
  )
  let command_size = 72 + section_count * 80
  binary_u32(output, 25)
  binary_u32(output, command_size)
  binary_fixed_text(output, "__DATA", 16)
  binary_u64(output, 4294967296 + text_size)
  binary_u64(output, data_size)
  binary_u64(output, text_size)
  binary_u64(output, data_size)
  binary_u32(output, 3)
  binary_u32(output, 3)
  binary_u32(output, section_count)
  binary_u32(output, 0)
  binary_fixed_text(output, "__got", 16)
  binary_fixed_text(output, "__DATA", 16)
  binary_u64(output, 4294967296 + text_size)
  binary_u64(output, symbol_count * 8)
  binary_u32(output, text_size)
  binary_u32(output, 3)
  binary_u32(output, 0)
  binary_u32(output, 0)
  binary_u32(output, 6)
  binary_u32(output, 0)
  binary_u32(output, 0)
  binary_u32(output, 0)
  if static_size > 0 {
    binary_fixed_text(output, "__wstatic", 16)
    binary_fixed_text(output, "__DATA", 16)
    binary_u64(output, 4294967296 + text_size + static_offset)
    binary_u64(output, static_size)
    binary_u32(output, text_size + static_offset)
    binary_u32(output, 4)
    binary_u32(output, 0)
    binary_u32(output, 0)
    binary_u32(output, 0)
    binary_u32(output, 0)
    binary_u32(output, 0)
    binary_u32(output, 0)
  } else { nil }
  if archive_size > 0 {
    binary_fixed_text(output, "__archive", 16)
    binary_fixed_text(output, "__DATA", 16)
    binary_u64(output, 4294967296 + text_size + archive_offset)
    binary_u64(output, archive_size)
    binary_u32(output, text_size + archive_offset)
    binary_u32(output, archive_align)
    binary_u32(output, 0)
    binary_u32(output, 0)
    binary_u32(output, 0)
    binary_u32(output, 0)
    binary_u32(output, 0)
    binary_u32(output, 0)
  } else { nil }
  nil
}

pub(package) fn emit_native_link_macho(graph: NativeLinkGraph) -> Bytes {
  match graph {
    NativeLinkGraph(
      target,
      platform,
      debug_information,
      signing,
      trust_grants,
      original_code,
      archive_data,
      layout,
      libraries,
      placements,
      symbols,
      relocations,
      static_slots
    ) ->
      match layout {
        NativeLinkImageLayout(
          stub_base,
          code_size,
          text_size,
          static_offset,
          static_size,
          archive_offset,
          archive_size,
          archive_align,
          data_size
        ) ->
          {
            let symbol_count = compiler_signed_count(symbols.len())
            -- Stubs and relocations patch private copies of the graph's code
            -- and archive data, which then enter the image as bytes.
            let code = buf_new(code_size + 16)
            bscopy(code, buf_ptr(original_code), buf_len(original_code), 0)
            let linked_archive_data = buf_new(archive_size)
            bscopy(linked_archive_data, buf_ptr(archive_data), archive_size, 0)
            bpad(code, stub_base)
            native_link_emit_stubs(code, symbols, text_size, stub_base, 0)
            let code_base = native_link_macho_code_base()
            native_link_apply_relocations_at(
              code,
              linked_archive_data,
              relocations,
              code_base,
              native_link_macho_image_base() + text_size,
              stub_base,
              static_offset,
              archive_offset
            )
            let linked_code = buf_bytes(code)
            let linked_data = buf_bytes(linked_archive_data)
            let dwarf = native_dwarf_sections(debug_information, code_base)
            let dwarf_size = native_link_dwarf_size(dwarf)
            let dwarf_offset = text_size + data_size
            let linkedit_offset = if dwarf_size > 0 { page_round(dwarf_offset + dwarf_size) } else {
              dwarf_offset
            }
            let dwarf_vm_size = linkedit_offset - dwarf_offset
            let debug_functions = native_link_debug_functions(debug_information)
            let defined_symbol_count = compiler_signed_count(debug_functions.len())
            let rebase = native_link_emit_rebase_data(relocations, archive_offset)
            let bind = native_link_emit_bind_data(symbols)
            let strings = native_link_emit_strtab(symbols, debug_information)
            let rebase_size = binary_bytes_len(rebase)
            let rebase_padded = native_link_align(rebase_size, 8)
            let bind_size = binary_bytes_len(bind)
            let bind_padded = native_link_align(bind_size, 8)
            let strings_size = binary_bytes_len(strings)
            let indirect_size = symbol_count * 4
            let indirect_padded = native_link_align(indirect_size, 8)
            let total_symbol_count = defined_symbol_count + symbol_count
            let symtab_size = total_symbol_count * 16
            let linkedit_before_signature = rebase_padded + bind_padded + indirect_padded +
              symtab_size + strings_size
            let signature_offset = linkedit_offset + linkedit_before_signature
            let hash_count = (signature_offset + 4095) / 4096
            let signature_size = 20 + 93 + hash_count * 32
            let linkedit_size = page_round(linkedit_before_signature + signature_size)

            let dylibs = native_link_dylibs(libraries)
            let dylib_count = compiler_signed_count(dylibs.len())
            let identity = native_link_macho_identity(
              linked_code,
              linked_data,
              dwarf,
              rebase,
              bind,
              strings,
              dylibs,
              layout,
              platform
            )
            let data_command_size = 72 + (
              1 + (if static_size > 0 { 1 } else { 0 }) + (if archive_size > 0 { 1 } else { 0 })
            ) * 80
            let build_version_count = native_link_macho_build_version_command_count(platform)
            let dwarf_command_count = native_link_dwarf_command_count(dwarf)
            let commands_size = 72 + 152 + data_command_size + native_link_dwarf_command_size(
              dwarf
            ) + 72 + 24 + 24 + 32 + native_link_dylib_commands_size(dylibs) + 24 + 48 + 80 + 16 +
              native_link_macho_build_version_command_size(platform)
            -- Everything the signature covers, up to the signature itself.
            let mut head = byte_builder.with_capacity(binary_capacity(signature_offset))
            binary_u32(head, 4277009103)
            binary_u32(head, 16777228)
            binary_u32(head, 0)
            binary_u32(head, 2)
            binary_u32(head, 11 + dylib_count + build_version_count + dwarf_command_count)
            binary_u32(head, commands_size)
            binary_u32(head, 2097285)
            binary_u32(head, 0)
            emit_pz(head)
            emit_text_seg(head, text_size)
            emit_text_sec(head, code_size)
            native_link_emit_data_segment(
              head,
              text_size,
              data_size,
              symbol_count,
              static_offset,
              static_size,
              archive_offset,
              archive_size,
              archive_align
            )
            native_link_emit_dwarf_segment(head, dwarf, dwarf_offset, dwarf_vm_size)
            emit_linkedit_signed(head, text_size, linkedit_offset, linkedit_size)
            emit_main_lc(head, 0)
            emit_symtab_real(
              head,
              linkedit_offset + rebase_padded + bind_padded + indirect_padded,
              total_symbol_count,
              linkedit_offset + rebase_padded + bind_padded + indirect_padded + symtab_size,
              strings_size
            )
            emit_dylinker(head)
            native_link_emit_dylib_commands(head, dylibs)
            native_link_emit_uuid(head, identity)
            native_link_emit_macho_build_version(head, platform)
            emit_dyld_info_rebase_bind(
              head,
              linkedit_offset,
              rebase_size,
              linkedit_offset + rebase_padded,
              bind_size
            )
            emit_dysymtab_with_defined(
              head,
              linkedit_offset + rebase_padded + bind_padded,
              defined_symbol_count,
              symbol_count
            )
            emit_codesig_lc(head, signature_offset, signature_size)
            binary_pad_to(head, 16384)
            head.append(linked_code)
            binary_pad_to(head, text_size)
            binary_pad_to(head, text_size + archive_offset)
            head.append(linked_data)
            binary_pad_to(head, dwarf_offset)
            native_link_write_dwarf_sections(head, dwarf)
            binary_pad_to(head, linkedit_offset)
            head.append(rebase)
            binary_pad_to(head, linkedit_offset + rebase_padded)
            head.append(bind)
            binary_pad_to(head, linkedit_offset + rebase_padded + bind_padded)
            for i in 0..symbol_count { binary_u32(head, defined_symbol_count + i) }
            binary_pad_to(head, linkedit_offset + rebase_padded + bind_padded + indirect_padded)
            native_link_emit_nlists(head, code_base, debug_information, symbols)
            head.append(strings)
            binary_pad_to(head, signature_offset)
            let prefix = head.finish()
            let mut output = byte_builder.with_capacity(
              binary_capacity(linkedit_offset + linkedit_size)
            )
            output.append(prefix)
            emit_codesig(output, prefix, signature_offset, 16384, text_size - 16384)
            binary_pad_to(output, linkedit_offset + linkedit_size)
            output.finish()
          }
      }
  }
}
