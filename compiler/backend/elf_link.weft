-- compiler/backend/elf_link.weft -- shared LinkGraph to Linux ELF finalization
--
-- Applies the closed graph's stubs and relocations to the generated code and
-- archive data, then writes a standalone executable, or a dynamically linked
-- one with an interpreter and dynamic tables when the graph binds shared
-- libraries. ELF static archives are already resolved into the shared graph;
-- foreign inputs, unbound dynamic symbols and unimplemented relocations
-- remain typed failures. Compiler-owned zero-fill static slots become a
-- separate RW load segment.

use compiler/backend/binary.{*}
use compiler/backend/elf.{*}
use compiler/backend/dwarf.{*}
use compiler/storage.{compiler_signed_count}
use compiler/backend/link.{*}
use compiler/backend/target.{*}
use stdlib/bytes as bytes
use stdlib/bytes.{Bytes}
use stdlib/bytes/builder as byte_builder
use stdlib/bytes/builder.{Builder}
use stdlib/list.{Cons, List, Nil}

pub(package) type ElfNativeLinkEmission {
  ElfNativeLinkEmitted(Bytes),
  ElfNativeLinkTargetMismatch(NativeLinkTarget),
  ElfNativeLinkForeignInputsUnsupported(i64),
  ElfNativeLinkUnboundDynamicSymbols(i64),
  ElfNativeLinkRelocationsUnsupported(i64),
  ElfNativeLinkArchiveDataUnsupported(i64),
  ElfNativeLinkInvalidEntryOffset(i64, i64)
}

fn elf_link_executable_emission(emission: ElfExecutableEmission) -> ElfNativeLinkEmission {
  match emission {
    ElfExecutableEmitted(image) -> ElfNativeLinkEmitted(image)
    ElfExecutableInvalidEntryOffset(offset, emitted_code_size) -> ElfNativeLinkInvalidEntryOffset(
      offset,
      emitted_code_size
    )
  }
}

fn elf_link_unsupported_relocation_count(relocations: List<NativeLinkRelocation>) -> i64 {
  match relocations {
    Nil -> 0
    Cons(relocation, rest) -> {
      let unsupported = match relocation {
        NativeLinkBranch26(address, slot) -> 0
        NativeLinkJump26(address, slot) -> 0
        NativeLinkDirectBranch26(address, target) -> 0
        NativeLinkDirectJump26(address, target) -> 0
        NativeLinkArchivePage21(address, target, addend) -> 0
        NativeLinkArchivePageOff12(address, target, addend) -> 0
        NativeLinkArchiveDataAbsolute64(address, target, addend) -> 0
        NativeLinkPageAddress(address, NativeLinkCodeAddress(offset)) -> 0
        NativeLinkPageAddress(address, NativeLinkStaticAddress(offset)) -> 0
        _ -> 1
      }
      unsupported + elf_link_unsupported_relocation_count(rest)
    }
  }
}

fn elf_link_unsupported_library_count(libraries: List<NativeLinkLibrary>) -> i64 {
  match libraries {
    Nil -> 0
    Cons(library, rest) -> {
      let unsupported = match library {
        NativeLinkStaticArchive(name, path, content, license, artifact) -> 0
        NativeLinkDynamicLibrary(name, path, load_identity, content, license, loads) -> 0
        _ -> 1
      }
      unsupported + elf_link_unsupported_library_count(rest)
    }
  }
}

fn elf_link_dynamic_library_count(libraries: List<NativeLinkLibrary>) -> i64 {
  match libraries {
    Nil -> 0
    Cons(library, rest) -> match library {
      NativeLinkDynamicLibrary(name, path, load_identity, content, license, loads) -> 1 +
        elf_link_dynamic_library_count(rest)
      _ -> elf_link_dynamic_library_count(rest)
    }
  }
}

fn elf_link_dynamic_strings(
  libraries: List<NativeLinkLibrary>,
  symbols: List<NativeLinkSymbol>
) -> Bytes {
  let mut strings = byte_builder.new()
  binary_u8(strings, 0)
  for library in libraries {
    match library {
      NativeLinkDynamicLibrary(name, path, load_identity, content, license, loads) ->
        binary_cstring(
          strings,
          load_identity
        )
      _ -> nil
    }
  }
  for symbol in symbols {
    match symbol {
      NativeLinkUndefinedStrong(name, ordinal, origin) -> binary_cstring(strings, name)
    }
  }
  strings.finish()
}

-- Symbol names follow the leading null byte and the needed library names.
fn elf_link_dynamic_symbol_name_start(libraries: List<NativeLinkLibrary>) -> i64 {
  let mut start = 1
  for library in libraries {
    match library {
      NativeLinkDynamicLibrary(name, path, load_identity, content, license, loads) -> {
        start = start + binary_text_len(load_identity) + 1
      }
      _ -> nil
    }
  }
  start
}

fn elf_link_dynamic_symbols(symbols: List<NativeLinkSymbol>, name_offset: i64) -> Bytes {
  let mut table = byte_builder.new()
  binary_zeros(table, 24) -- the reserved null symbol
  let mut offset = name_offset
  for symbol in symbols {
    match symbol {
      NativeLinkUndefinedStrong(name, ordinal, origin) -> {
        binary_u32(table, offset)
        binary_u8(table, 16) -- STB_GLOBAL | STT_NOTYPE
        binary_u8(table, 0)
        binary_u16(table, 0)
        binary_u64(table, 0)
        binary_u64(table, 0)
        offset = offset + binary_text_len(name) + 1
      }
    }
  }
  table.finish()
}

fn elf_link_dynamic_relocations(symbols: List<NativeLinkSymbol>, data_address: i64) -> Bytes {
  let mut relocations = byte_builder.new()
  let mut slot = 0
  for _ in symbols {
    binary_u64(relocations, data_address + slot * 8)
    binary_u64(relocations, (slot + 1) * 4294967296 + 1025) -- R_AARCH64_GLOB_DAT
    binary_u64(relocations, 0)
    slot = slot + 1
  }
  relocations.finish()
}

fn elf_link_dynamic_entry(dynamic: borrow mut Builder, tag: i64, value: i64) -> nil {
  binary_u64(dynamic, tag)
  binary_u64(dynamic, value)
}

fn elf_link_dynamic_entries(
  libraries: List<NativeLinkLibrary>,
  string_address: i64,
  symbol_address: i64,
  string_size: i64,
  relocation_address: i64,
  relocation_size: i64
) -> Bytes {
  let mut dynamic = byte_builder.new()
  let mut string_offset = 1
  for library in libraries {
    match library {
      NativeLinkDynamicLibrary(name, path, load_identity, content, license, loads) -> {
        elf_link_dynamic_entry(dynamic, 1, string_offset) -- DT_NEEDED
        string_offset = string_offset + binary_text_len(load_identity) + 1
      }
      _ -> nil
    }
  }
  elf_link_dynamic_entry(dynamic, 5, string_address) -- DT_STRTAB
  elf_link_dynamic_entry(dynamic, 6, symbol_address) -- DT_SYMTAB
  elf_link_dynamic_entry(dynamic, 10, string_size) -- DT_STRSZ
  elf_link_dynamic_entry(dynamic, 11, 24) -- DT_SYMENT
  elf_link_dynamic_entry(dynamic, 7, relocation_address) -- DT_RELA
  elf_link_dynamic_entry(dynamic, 8, relocation_size) -- DT_RELASZ
  elf_link_dynamic_entry(dynamic, 9, 24) -- DT_RELAENT
  elf_link_dynamic_entry(dynamic, 21, 0) -- DT_DEBUG: loader rendezvous for debuggers
  elf_link_dynamic_entry(dynamic, 0, 0) -- DT_NULL
  dynamic.finish()
}

-- A dynamically linked executable: the interpreter path follows the program
-- headers, and the RW segment holds the linked data followed by the dynamic
-- string, symbol, relocation and entry tables.
fn elf_link_dynamic_executable(
  code: Bytes,
  data: Bytes,
  libraries: List<NativeLinkLibrary>,
  symbols: List<NativeLinkSymbol>,
  debug: NativeDwarfSections?
) -> Bytes {
  let image_base = elf_aarch64_image_base()
  let code_offset = elf_aarch64_code_file_offset()
  let program_count = 5
  let interpreter_offset = 64 + program_count * 56
  let interpreter = native_link_linux_aarch64_interpreter()
  let interpreter_size = binary_text_len(interpreter) + 1
  let data_offset = elf_aarch64_zero_fill_file_offset(binary_bytes_len(code))
  let data_address = image_base + data_offset
  let strings = elf_link_dynamic_strings(libraries, symbols)
  let symbol_table = elf_link_dynamic_symbols(
    symbols,
    elf_link_dynamic_symbol_name_start(libraries)
  )
  let string_offset = elf_align(binary_bytes_len(data), 8)
  let symbol_offset = elf_align(string_offset + binary_bytes_len(strings), 8)
  let relocation_offset = elf_align(symbol_offset + binary_bytes_len(symbol_table), 8)
  let relocations = elf_link_dynamic_relocations(symbols, data_address)
  let dynamic_offset = elf_align(relocation_offset + binary_bytes_len(relocations), 8)
  let dynamic = elf_link_dynamic_entries(
    libraries,
    data_address + string_offset,
    data_address + symbol_offset,
    binary_bytes_len(strings),
    data_address + relocation_offset,
    binary_bytes_len(relocations)
  )
  let dynamic_size = binary_bytes_len(dynamic)
  let data_file_size = dynamic_offset + dynamic_size
  let loaded_file_size = data_offset + data_file_size
  let section_headers_offset = elf_section_headers_offset(loaded_file_size, debug)
  let mut out = byte_builder.with_capacity(binary_capacity(loaded_file_size))
  elf_emit_file_header(
    out,
    image_base + code_offset,
    program_count,
    section_headers_offset,
    debug
  )
  elf_emit_code_program_header(out, code_offset + binary_bytes_len(code))
  elf_emit_data_program_header(out, data_offset, data_file_size, data_file_size)
  elf_emit_program_header(
    out,
    3, -- PT_INTERP
    4, -- PF_R
    interpreter_offset,
    image_base + interpreter_offset,
    interpreter_size,
    interpreter_size,
    1
  )
  elf_emit_program_header(
    out,
    2, -- PT_DYNAMIC
    6, -- PF_R | PF_W
    data_offset + dynamic_offset,
    data_address + dynamic_offset,
    dynamic_size,
    dynamic_size,
    8
  )
  elf_emit_non_executable_stack_program_header(out)
  binary_pad_to(out, interpreter_offset)
  binary_cstring(out, interpreter)
  binary_pad_to(out, code_offset)
  out.append(code)
  binary_pad_to(out, data_offset)
  out.append(data)
  binary_pad_to(out, data_offset + string_offset)
  out.append(strings)
  binary_pad_to(out, data_offset + symbol_offset)
  out.append(symbol_table)
  binary_pad_to(out, data_offset + relocation_offset)
  out.append(relocations)
  binary_pad_to(out, data_offset + dynamic_offset)
  out.append(dynamic)
  elf_emit_debug_sections(out, loaded_file_size, section_headers_offset, debug)
  out.finish()
}

fn elf_link_debug_sections(
  debug_information: NativeLinkDebugInformation,
  code_base: i64
) -> NativeDwarfSections? {
  match debug_information {
    NativeLinkDwarfFunctionLineInformation(functions) -> return native_dwarf_sections(
      debug_information,
      code_base
    )
    NativeLinkDebugInformationAbsent -> nil
  }
  nil
}

pub(package) fn emit_native_link_elf(graph: NativeLinkGraph) -> ElfNativeLinkEmission {
  match graph {
    NativeLinkGraph(
      target,
      platform,
      debug_information,
      signing,
      trust_grants,
      code,
      archive_data,
      layout,
      libraries,
      placements,
      symbols,
      relocations,
      static_slots
    ) ->
      {
        let unsupported_library_count = elf_link_unsupported_library_count(libraries)
        let dynamic_library_count = elf_link_dynamic_library_count(libraries)
        let symbol_count = compiler_signed_count(symbols.len())
        let unsupported_relocation_count = elf_link_unsupported_relocation_count(relocations)
        match target {
          NativeLinkMacosAarch64 -> ElfNativeLinkTargetMismatch(target)
          NativeLinkLinuxAarch64 -> {
            if unsupported_library_count != 0 {
              ElfNativeLinkForeignInputsUnsupported(unsupported_library_count)
            } else {
              if symbol_count != 0 and dynamic_library_count == 0 {
                ElfNativeLinkUnboundDynamicSymbols(symbol_count)
              } else {
                if unsupported_relocation_count != 0 {
                  ElfNativeLinkRelocationsUnsupported(unsupported_relocation_count)
                } else {
                  match layout {
                    NativeLinkImageLayout(
                      stub_base,
                      code_size,
                      text_size,
                      static_offset,
                      static_size,
                      archive_offset,
                      archive_size,
                      archive_align,
                      data_size
                    ) ->
                      {
                        let code_base = elf_aarch64_image_base() + elf_aarch64_code_file_offset()
                        let data_base = elf_aarch64_image_base() +
                          elf_aarch64_zero_fill_file_offset(code_size)
                        -- Stubs and relocations patch private builders over
                        -- the graph's code and archive data.
                        let mut linked_code = byte_builder.with_capacity(
                          binary_capacity(code_size)
                        )
                        linked_code.append(code)
                        let mut linked_archive_data = byte_builder.with_capacity(
                          binary_capacity(archive_size)
                        )
                        linked_archive_data.append(archive_data)
                        if dynamic_library_count > 0 {
                          binary_pad_to(linked_code, stub_base)
                          native_link_emit_stubs_at(
                            linked_code,
                            symbols,
                            code_base,
                            data_base,
                            stub_base,
                            0
                          )
                        }
                        native_link_apply_relocations_at(
                          linked_code,
                          linked_archive_data,
                          relocations,
                          code_base,
                          data_base,
                          stub_base,
                          static_offset,
                          archive_offset
                        )
                        let zero_fill_size = if static_slots > 0 { static_offset + static_size } else {
                          0
                        }
                        -- The archive data follows the GOT and static slots,
                        -- whose file bytes are zero.
                        let mut linked_data = byte_builder.with_capacity(
                          binary_capacity(archive_offset + archive_size)
                        )
                        binary_pad_to(linked_data, archive_offset)
                        linked_data.append(linked_archive_data.finish())
                        let linked_data_bytes = linked_data.finish()
                        let linked_bytes = linked_code.finish()
                        let debug = elf_link_debug_sections(debug_information, code_base)
                        if dynamic_library_count > 0 {
                          ElfNativeLinkEmitted(
                            elf_link_dynamic_executable(
                              linked_bytes,
                              linked_data_bytes,
                              libraries,
                              symbols,
                              debug
                            )
                          )
                        } else {
                          elf_link_executable_emission(
                            emit_elf_aarch64_standalone_executable(
                              linked_bytes,
                              0,
                              if archive_data.is_empty() { bytes.empty() } else {
                                linked_data_bytes
                              },
                              zero_fill_size,
                              debug
                            )
                          )
                        }
                      }
                  }
                }
              }
            }
          }
        }
      }
  }
}
