-- compiler/pretty.weft — Pretty-printer for the typed IR
--
-- The first "tool as handler configuration": uses the IR types
-- from ir.weft to produce human-readable output from AST nodes.
-- Proves the typed IR works for real compiler passes.

use "compiler/ir.weft"
use "stdlib/string.weft"

-- Pretty-print an expression to a string
fn pretty_expr(e: i64) -> i64 {
  match e {
    IntLit(v) -> int_to_str(v)
    BoolLit(v) -> if v == 1 { "true" } else { "false" }
    StringLit(ns, nl) -> "\"...\""
    Ident(ns, nl) -> "<ident>"
    BinOp(op, lhs, rhs) -> {
      let ls = pretty_expr(lhs)
      let rs = pretty_expr(rhs)
      let ops = pretty_op(op)
      str_concat(str_concat(str_concat("(", ls), str_concat(" {ops} ", rs)), ")")
    }
    Not(inner) -> str_concat("(not ", str_concat(pretty_expr(inner), ")"))
    If(cond, then_e, else_e) -> {
      let cs = pretty_expr(cond)
      let ts = pretty_expr(then_e)
      let es = pretty_expr(else_e)
      str_concat("if {cs} then {ts} else {es}")
    }
    Let(ns, nl, val, body) -> {
      let vs = pretty_expr(val)
      let bs = pretty_expr(body)
      str_concat("let _ = {vs} in {bs}")
    }
    Call(ns, nl, args, nargs) -> {
      let ns_str = int_to_str(nargs)
      str_concat("<call/{ns_str}>")
    }
    Block(first, rest) -> {
      if rest == 0 { pretty_expr(first) }
      else { str_concat(pretty_expr(first), str_concat("; ", pretty_expr(rest))) }
    }
    _ -> "<expr>"
  }
}

fn pretty_op(op: i64) -> i64 {
  match op {
    1 -> "+"
    2 -> "-"
    3 -> "*"
    4 -> "/"
    5 -> "=="
    6 -> "!="
    7 -> "<"
    8 -> ">"
    _ -> "?"
  }
}

-- Pretty-print a pattern
fn pretty_pattern(p: i64) -> i64 {
  match p {
    Wildcard -> "_"
    Binding(ns, nl) -> "<bind>"
    IntPattern(v) -> int_to_str(v)
    CtorPattern(ns, nl, binds, n) -> "<ctor>"
    _ -> "<pat>"
  }
}
