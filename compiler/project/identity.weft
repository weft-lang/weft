-- Retained semantic identities for typed compiler products.
--
-- These values own their logical spelling. The checker-storage registries in
-- project/module remain a transitional raw lookup representation; typed
-- products use these identities and never infer identity from an address.

use stdlib/source.{Span}

pub(package) type ModuleIdentity {
  NamedModuleIdentity(str, i64),
  AnonymousModuleIdentity(usize)
}

pub(package) type DeclarationNamespace {
  ValueDeclaration,
  TypeDeclaration,
  EffectDeclaration,
  TraitDeclaration,
  InherentMethodDeclaration,
  TraitMethodDeclaration,
  AssociatedTypeDeclaration,
  EffectOperationDeclaration,
  ConstructorDeclaration,
  RecordFieldDeclaration
}

-- A declaration name is a retained source span. Member identities retain
-- their exact owner rather than repeating or hashing its spelling.
pub(package) type DeclarationIdentity {
  ModuleDeclarationIdentity(ModuleIdentity, DeclarationNamespace, Span),
  MemberDeclarationIdentity(DeclarationIdentity, DeclarationNamespace, Span)
}

pub(package) type FunctionIdentity {
  DeclaredFunctionIdentity(DeclarationIdentity),
  ModuleFunctionIdentity(ModuleIdentity, usize)
}

pub(package) fn named_module_identity(path: str, package_id: i64) -> ModuleIdentity {
  NamedModuleIdentity(path, package_id)
}

pub(package) fn anonymous_module_identity(ordinal: usize) -> ModuleIdentity {
  AnonymousModuleIdentity(ordinal)
}

pub(package) fn module_identity_eq(left: ModuleIdentity, right: ModuleIdentity) -> bool {
  match (left, right) {
    (NamedModuleIdentity(left_path, left_package),
      NamedModuleIdentity(right_path, right_package)) ->
      left_package == right_package and left_path == right_path
    (AnonymousModuleIdentity(left_ordinal), AnonymousModuleIdentity(right_ordinal)) ->
      left_ordinal == right_ordinal
    _ -> false
  }
}

fn identity_name_eq(left: Span, right: Span) -> bool {
  if left.len() != right.len() { return false }
  let mut index: usize = 0
  while index < left.len() {
    if left.byte_at(index) != right.byte_at(index) { return false }
    index = index + 1
  }
  true
}

fn declaration_namespace_eq(
  left: DeclarationNamespace,
  right: DeclarationNamespace
) -> bool {
  match (left, right) {
    (ValueDeclaration, ValueDeclaration) -> true
    (TypeDeclaration, TypeDeclaration) -> true
    (EffectDeclaration, EffectDeclaration) -> true
    (TraitDeclaration, TraitDeclaration) -> true
    (InherentMethodDeclaration, InherentMethodDeclaration) -> true
    (TraitMethodDeclaration, TraitMethodDeclaration) -> true
    (AssociatedTypeDeclaration, AssociatedTypeDeclaration) -> true
    (EffectOperationDeclaration, EffectOperationDeclaration) -> true
    (ConstructorDeclaration, ConstructorDeclaration) -> true
    (RecordFieldDeclaration, RecordFieldDeclaration) -> true
    _ -> false
  }
}

pub(package) fn declaration_identity_eq(
  left: DeclarationIdentity,
  right: DeclarationIdentity
) -> bool {
  match (left, right) {
    (ModuleDeclarationIdentity(left_module, left_namespace, left_name),
      ModuleDeclarationIdentity(right_module, right_namespace, right_name)) ->
      declaration_namespace_eq(left_namespace, right_namespace) and
      module_identity_eq(left_module, right_module) and identity_name_eq(left_name, right_name)
    (MemberDeclarationIdentity(left_owner, left_namespace, left_name),
      MemberDeclarationIdentity(right_owner, right_namespace, right_name)) ->
      declaration_namespace_eq(left_namespace, right_namespace) and
      declaration_identity_eq(left_owner, right_owner) and identity_name_eq(left_name, right_name)
    _ -> false
  }
}

pub(package) fn declaration_identity_namespace(
  identity: DeclarationIdentity
) -> DeclarationNamespace {
  match identity {
    ModuleDeclarationIdentity(_, namespace, _) -> namespace
    MemberDeclarationIdentity(_, namespace, _) -> namespace
  }
}

pub(package) fn declaration_namespace_code(namespace: DeclarationNamespace) -> i64 {
  match namespace {
    ValueDeclaration -> 1
    TypeDeclaration -> 2
    EffectDeclaration -> 3
    TraitDeclaration -> 4
    InherentMethodDeclaration -> 5
    TraitMethodDeclaration -> 6
    AssociatedTypeDeclaration -> 7
    EffectOperationDeclaration -> 8
    ConstructorDeclaration -> 9
    RecordFieldDeclaration -> 10
  }
}

pub(package) fn declaration_identity_name(identity: DeclarationIdentity) -> Span {
  match identity {
    ModuleDeclarationIdentity(_, _, name) -> name
    MemberDeclarationIdentity(_, _, name) -> name
  }
}

pub(package) fn declaration_identity_owner(
  identity: DeclarationIdentity
) -> DeclarationIdentity? {
  match identity {
    MemberDeclarationIdentity(owner, _, _) -> return owner
    ModuleDeclarationIdentity(_, _, _) -> nil
  }
  nil
}
