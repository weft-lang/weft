-- Deterministic accelerators for retained semantic identities.
--
-- Hashes never establish identity. Callers use them only to reject unequal
-- candidates cheaply, then compare the complete retained values.

use compiler/project/identity.{
  AnonymousModuleIdentity,
  DeclarationIdentity,
  MemberDeclarationIdentity,
  ModuleDeclarationIdentity,
  ModuleIdentity,
  NamedModuleIdentity,
  declaration_identity_name,
  declaration_identity_namespace,
  declaration_namespace_code,
  module_identity_package
}
use stdlib/hash.{Hash}
use stdlib/num/scalar.{num_scalar_usize_to_i64}
use stdlib/option.{None, Some}

fn identity_mix(seed: i64, value: i64) -> i64 {
  seed * 1099511628211 + value
}

fn identity_usize_hash(value: usize) -> i64 {
  match num_scalar_usize_to_i64(value) {
    Some(converted) -> converted.hash()
    None -> 0
  }
}

fn identity_name_hash(identity: DeclarationIdentity) -> i64 {
  match declaration_identity_name(identity).text() {
    Some(name) -> name.hash()
    None -> 0
  }
}

pub(package) fn retained_module_identity_hash(identity: ModuleIdentity) -> i64 {
  let package_id = module_identity_package(identity)
  match identity {
    NamedModuleIdentity(path, _) -> identity_mix(
      identity_mix(101, package_id.hash()),
      path.hash()
    )
    AnonymousModuleIdentity(ordinal, _) -> identity_mix(
      identity_mix(103, package_id.hash()),
      identity_usize_hash(ordinal)
    )
  }
}

pub(package) fn retained_declaration_identity_hash(
  identity: DeclarationIdentity
) -> i64 {
  let namespace = declaration_namespace_code(
    declaration_identity_namespace(identity)
  )
  let name = identity_name_hash(identity)
  match identity {
    ModuleDeclarationIdentity(module, _, _) -> identity_mix(
      identity_mix(
        identity_mix(211, retained_module_identity_hash(module)),
        namespace
      ),
      name
    )
    MemberDeclarationIdentity(owner, _, _) -> identity_mix(
      identity_mix(
        identity_mix(223, retained_declaration_identity_hash(owner)),
        namespace
      ),
      name
    )
  }
}
