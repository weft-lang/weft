-- Typed checking of one prepared project root.
--
-- This is the project query the production check will run once the typed
-- checked-program path replaces the legacy checker. Until that single switch
-- it is reached only by the differential checker oracle, so ordinary compiler
-- builds neither import nor run it, and it is never cached beside the legacy
-- product. The returned table is only the source registry used to render
-- rejection locations; the typed program does not consult it.

use compiler/project/session.{
  ProjectDiagnostics,
  ProjectPreparedParseResult,
  ProjectPreparedParseSucceeded,
  ProjectQueryContext,
  ProjectSession,
  project_diagnostics_collect,
  project_diagnostics_with_sources,
  project_session_load_resolved_source,
  project_session_prepared_parse_with_acquire
}
use compiler/source/input.{SourceRequest}
use compiler/source/loading.{source_loader}
use compiler/weft/assemble.{assemble_weft_program_with_loader}
use compiler/weft/check/checked_program.{CheckedProgramResult, check_registered_program}
use compiler/weft/check/registration/scope.{RegistrationScope, registration_scope_find_source}
use compiler/weft/check/table.{ttable_program_entry_source_or, ttable_sdk_package_id}
use compiler/weft/products.{AstModule}
use runtime/source_acquire.{SourceAcquire}
use stdlib/diagnostic/schema.{DiagnosticClassType}
use stdlib/grammar.{Checked, CheckRejected}
use stdlib/option.{None, Some}

pub(package) type ProjectTypedCheckResult {
  ProjectTypedCheckCompleted(CheckedProgramResult, RegistrationScope, i64),
  ProjectTypedCheckLoadRejected(ProjectDiagnostics),
  ProjectTypedCheckRootUnregistered,
  ProjectTypedCheckParseFailed(ProjectPreparedParseResult)
}

pub(package) fn project_session_typed_check_with_acquire(
  session: ProjectSession,
  context: ProjectQueryContext
) -[SourceAcquire]> ProjectTypedCheckResult {
  match project_session_prepared_parse_with_acquire(session, context) {
    ProjectPreparedParseSucceeded(ast, n, _) -> match ast {
      AstModule(_, src, tt, owners, (_, registrations)) -> match registration_scope_find_source(
        registrations,
        ttable_program_entry_source_or(tt, src)
      ) {
        None -> ProjectTypedCheckRootUnregistered
        Some(root) -> {
          let diagnostics = project_diagnostics_with_sources(owners)
          let loader = source_loader(
            (request: SourceRequest) => project_session_load_resolved_source(
              session,
              context,
              tt,
              request
            ),
            owners
          )
          match project_diagnostics_collect(
            diagnostics,
            src,
            n,
            tt,
            DiagnosticClassType,
            () => assemble_weft_program_with_loader(ast, root.identity, loader)
          ) {
            CheckRejected -> ProjectTypedCheckLoadRejected(diagnostics)
            Checked(program) -> ProjectTypedCheckCompleted(
              check_registered_program(
                program.root,
                program.registrations,
                ttable_sdk_package_id(tt)
              ),
              program.registrations,
              tt
            )
          }
        }
      }
    }
    other -> ProjectTypedCheckParseFailed(other)
  }
}
