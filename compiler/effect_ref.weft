-- compiler/effect_ref.weft -- shared semantic effect-reference facts

use compiler/parse.{*}
use compiler/lib.{*}
use compiler/type_registry.{*}
use compiler/types.{*}
use runtime/memory.{*}

-- Effect references are bare identifiers, parameterized identifiers, or
-- module-qualified field nodes with the same optional generic wrapper.
pub(package) fn effect_ref_ident_node(node: i64) -> i64 {
  if node == 0 { 0 }
  else { if node_tag(node) == 2 { node }
  else { if node_tag(node) == 36 {
    let inner = node_f2(node)
    if inner != 0 and node_tag(inner) == 2 { inner } else { 0 }
  } else { 0 } } }
}

pub(package) fn effect_ref_type_args(node: i64) -> i64 {
  if node != 0 and node_tag(node) == 36 { node_f1(node) } else { 0 }
}

pub(package) fn effect_ref_is_qualified(node: i64) -> i64 {
  if effect_ref_ident_node(node) != 0 and node_tag(node) == 36 { 1 } else { 0 }
}

pub(package) fn effect_ref_name_hash(node: i64, src: i64) -> i64 {
  let ident = effect_ref_ident_node(node)
  if ident == 0 { 0 } else { effect_name_hash(src, node_f1(ident), node_f2(ident)) }
}

pub(package) fn effect_ref_atom(node: i64, src: i64) -> i64 {
  let hash = effect_ref_name_hash(node, src)
  if hash == 0 { 0 }
  else {
    let args = effect_ref_type_args(node)
    if args == 0 { ty_effect_app(hash) } else { ty_effect_app_args(hash, args) }
  }
}

pub(package) fn is_effect_ident(node: i64, src: i64, tt: i64) -> bool {
  let ident = effect_ref_ident_node(node)
  if ident == 0 { false }
  else {
    let entry = ttable_lookup(tt, src, node_f1(ident), node_f2(ident))
    if entry == 0 { false } else { mem_load64_at(entry + 16, 0) == 2 }
  }
}

pub(package) fn effect_ref_field_node(node: i64) -> i64 {
  if node == 0 { 0 }
  else { if node_tag(node) == 13 { node }
  else { if node_tag(node) == 36 {
    let inner = node_f2(node)
    if inner != 0 and node_tag(inner) == 13 { inner } else { 0 }
  } else { 0 } } }
}

pub(package) fn effect_ref_decl_fact(node: i64) -> i64 {
  let field = effect_ref_field_node(node)
  if field == 0 { 0 }
  else {
    let fact = node_f4(field)
    if fact != 0 and (node_tag(fact) == 2 or node_tag(fact) == 3) { node_f1(fact) } else { 0 }
  }
}
