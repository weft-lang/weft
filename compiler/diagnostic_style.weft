-- compiler/diagnostic_style.weft -- one terminal presentation policy

use compiler/lib.{eprint}
use compiler/type_registry.{ttable_get_diagnostic_color_mode, ttable_set_diagnostic_color_mode}
use runtime/alloc.{alloc_words}
use runtime/memory.{mem_store8_at}
use runtime/syscall.{sys_write}
use runtime/terminal.{terminal_stderr_color_enabled}

pub(package) fn diagnostic_style_plain() -> i64 { 0 }
pub(package) fn diagnostic_style_error() -> i64 { 1 }
pub(package) fn diagnostic_style_warning() -> i64 { 2 }
pub(package) fn diagnostic_style_note() -> i64 { 3 }
pub(package) fn diagnostic_style_related() -> i64 { 4 }

pub(package) fn diagnostic_style_enabled(tt: i64) -> i64 {
  if tt == 0 { 0 }
  else {
    let cached = ttable_get_diagnostic_color_mode(tt)
    if cached == 2 { 1 }
    else { if cached == 1 { 0 }
    else {
      let enabled = terminal_stderr_color_enabled()
      ttable_set_diagnostic_color_mode(tt, if enabled == 1 { 2 } else { 1 })
      enabled
    } }
  }
}

pub(package) fn diagnostic_style_escape(code: str) -> i64 {
  let esc = alloc_words(1)
  mem_store8_at(esc, 0, 27)
  sys_write(2, esc, 1)
  eprint(code)
}

pub(package) fn diagnostic_style_start(style: i64) -> i64 {
  match style {
    1 -> diagnostic_style_escape("[1;31m")
    2 -> diagnostic_style_escape("[1;33m")
    3 -> diagnostic_style_escape("[1;36m")
    4 -> diagnostic_style_escape("[1;34m")
    _ -> 0
  }
}

pub(package) fn diagnostic_style_reset(style: i64) -> i64 {
  if style == 0 { 0 } else { diagnostic_style_escape("[0m") }
}
