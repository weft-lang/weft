-- compiler/module_diagnostics.weft -- structured diagnostics over module facts

use compiler/lib.{*}
use compiler/module.{*}
use runtime/buffer.{*}
use runtime/string.{runtime_str_from_bytes_copy}
use stdlib/diagnostic.{*}
use stdlib/diagnostic/registry
use stdlib/diagnostic/schema.{*}

pub(package) fn module_diagnostic_name(src: i64, module_start: i64, module_len: i64, member_start: i64, member_len: i64) -> str {
  let name = buf_new(module_len + member_len + 1)
  bscopy(name, src + module_start, module_len, 0)
  bstr(name, ".")
  bscopy(name, src + member_start, member_len, 0)
  runtime_str_from_bytes_copy(buf_ptr(name), buf_len(name))
}

pub(package) fn module_diagnostic_message(prefix: str, name: str, suffix: str) -> str {
  let message = buf_new(__str_len(prefix) + __str_len(name) + __str_len(suffix) + 2)
  bstr(message, prefix)
  bstr(message, "'")
  bstr(message, name)
  bstr(message, "'")
  bstr(message, suffix)
  runtime_str_from_bytes_copy(buf_ptr(message), buf_len(message))
}

pub(package) fn module_diagnostic_decl_location(decl: i64) -> DiagnosticLocation {
  if decl == 0 { DiagnosticLocationNone }
  else {
    let source = module_decl_fact_source(decl)
    let span_ptr = module_decl_fact_source_span_ptr(decl)
    if span_ptr == 0 { DiagnosticLocationNone }
    else {
      let start = span_ptr - source
      DiagnosticSourceRange(DiagnosticSourceBuffer(source), start, start + module_decl_fact_name_len(decl))
    }
  }
}

pub(package) fn module_diagnostic_import_selection(entry: i64, import_entry: i64) -> i64 {
  if entry == 0 or import_entry == 0 { 0 }
  else {
    let mut found = 0
    let mut i = 0
    while i < module_import_fact_selection_count(import_entry) and found == 0 {
      let selection = module_import_fact_selection_at(import_entry, i)
      let alias_len = node_f4(selection)
      let local_ptr = if alias_len > 0 { node_f3(selection) } else { node_f1(selection) }
      let local_len = if alias_len > 0 { alias_len } else { node_f2(selection) }
      if local_len >= 0 and local_len == module_scope_entry_name_len(entry) and src_eq_at(local_ptr, 0, module_scope_entry_name_ptr(entry), 0, local_len) == 1 {
        found = selection
      } else { i = i + 1 }
    }
    found
  }
}

pub(package) fn module_diagnostic_import_name_ptr(entry: i64, import_entry: i64) -> i64 {
  let selection = module_diagnostic_import_selection(entry, import_entry)
  if selection != 0 { node_f1(selection) }
  else { if import_entry != 0 and module_import_fact_alias_len(import_entry) > 0 { module_import_fact_alias_ptr(import_entry) }
  else { module_scope_entry_name_ptr(entry) } }
}

pub(package) fn module_diagnostic_import_local_ptr(entry: i64, import_entry: i64) -> i64 {
  let selection = module_diagnostic_import_selection(entry, import_entry)
  if selection != 0 and node_f4(selection) > 0 { node_f3(selection) }
  else { if import_entry != 0 and module_import_fact_alias_len(import_entry) > 0 { module_import_fact_alias_ptr(import_entry) }
  else { module_scope_entry_name_ptr(entry) } }
}

pub(package) fn module_diagnostic_import_local_len(entry: i64, import_entry: i64) -> i64 {
  let selection = module_diagnostic_import_selection(entry, import_entry)
  if selection != 0 and node_f4(selection) > 0 { node_f4(selection) }
  else { if import_entry != 0 and module_import_fact_alias_len(import_entry) > 0 { module_import_fact_alias_len(import_entry) }
  else { module_scope_entry_name_len(entry) } }
}

pub(package) fn module_diagnostic_import_name_len(entry: i64, import_entry: i64) -> i64 {
  let selection = module_diagnostic_import_selection(entry, import_entry)
  if selection != 0 { node_f2(selection) }
  else { if import_entry != 0 and module_import_fact_alias_len(import_entry) > 0 { module_import_fact_alias_len(import_entry) }
  else { module_scope_entry_name_len(entry) } }
}

pub(package) fn module_diagnostic_import_location(entry: i64, import_entry: i64) -> DiagnosticLocation {
  if entry == 0 or import_entry == 0 { DiagnosticLocationNone }
  else {
    let source = module_fact_entry_source(module_scope_entry_module(entry))
    let name_ptr = module_diagnostic_import_name_ptr(entry, import_entry)
    let name_len = module_diagnostic_import_name_len(entry, import_entry)
    let start = name_ptr - source
    if source == 0 or name_ptr == 0 or name_len < 0 or start < 0 {
      let fallback = module_import_fact_source_offset(import_entry)
      if source == 0 or fallback < 0 { DiagnosticLocationNone }
      else { DiagnosticSourceRange(DiagnosticSourceBuffer(source), fallback, fallback + 3) }
    } else { DiagnosticSourceRange(DiagnosticSourceBuffer(source), start, start + name_len) }
  }
}

pub(package) fn module_diagnostic_import_local_location(entry: i64, import_entry: i64) -> DiagnosticLocation {
  if entry == 0 or import_entry == 0 { DiagnosticLocationNone }
  else {
    let source = module_fact_entry_source(module_scope_entry_module(entry))
    let name_ptr = module_diagnostic_import_local_ptr(entry, import_entry)
    let name_len = module_diagnostic_import_local_len(entry, import_entry)
    let start = name_ptr - source
    if source == 0 or name_ptr == 0 or name_len < 0 or start < 0 { module_diagnostic_import_location(entry, import_entry) }
    else { DiagnosticSourceRange(DiagnosticSourceBuffer(source), start, start + name_len) }
  }
}

pub(package) fn module_diagnostic_related_entry(entry: i64) -> DiagnosticRelatedLocationList {
  if entry == 0 { DiagnosticRelatedLocationNil }
  else { if module_scope_entry_kind(entry) == module_scope_kind_module() {
    let first_import = module_scope_entry_import(entry)
    if first_import == 0 { DiagnosticRelatedLocationNil }
    else { DiagnosticRelatedLocationCons(DiagnosticRelatedLocation("previous module binding", module_diagnostic_import_location(entry, first_import)), DiagnosticRelatedLocationNil) }
  }
  else {
    let target = module_scope_entry_target(entry)
    let conflict = module_scope_entry_conflict(entry)
    let rest = if conflict == 0 { DiagnosticRelatedLocationNil }
      else { DiagnosticRelatedLocationCons(DiagnosticRelatedLocation("conflicting declaration", module_diagnostic_decl_location(conflict)), DiagnosticRelatedLocationNil) }
    if target == 0 { rest }
    else { DiagnosticRelatedLocationCons(DiagnosticRelatedLocation("declaration is here", module_diagnostic_decl_location(target)), rest) }
  } }
}

pub(package) fn module_diagnostic_resolution_name(resolution: ModuleNameResolution) -> str {
  match resolution {
    MissingModuleName -> "missing"
    InvisibleModuleName -> "invisible"
    AmbiguousModuleName -> "ambiguous"
    WidenedReexportName -> "widened-reexport"
    ResolvedDeclarationName(id) -> "wrong-kind"
    ResolvedModuleName(id) -> "wrong-kind"
  }
}

pub(package) fn module_diagnostic_resolution_code(resolution: ModuleNameResolution) -> DiagnosticCode {
  match resolution {
    MissingModuleName -> registry.module_member_missing()
    InvisibleModuleName -> registry.module_member_invisible()
    AmbiguousModuleName -> registry.module_member_ambiguous()
    WidenedReexportName -> registry.module_reexport_widening()
    ResolvedDeclarationName(id) -> registry.module_member_wrong_kind()
    ResolvedModuleName(id) -> registry.module_member_wrong_kind()
  }
}

pub(package) fn module_diagnostic_resolution_message(resolution: ModuleNameResolution, name: str) -> str {
  match resolution {
    MissingModuleName -> module_diagnostic_message("unknown module member ", name, "")
    InvisibleModuleName -> module_diagnostic_message("module member ", name, " is not visible")
    AmbiguousModuleName -> module_diagnostic_message("module member ", name, " is ambiguous")
    WidenedReexportName -> module_diagnostic_message("module member ", name, " cannot be re-exported at wider visibility")
    ResolvedDeclarationName(id) -> module_diagnostic_message("module member ", name, " is not a function value")
    ResolvedModuleName(id) -> module_diagnostic_message("module member ", name, " is not a function value")
  }
}

pub(package) fn module_diagnostic_qualified_member(
  resolution: ModuleNameResolution,
  entry: i64,
  src: i64,
  module_start: i64,
  module_len: i64,
  member_start: i64,
  member_len: i64
) -> Diagnostic {
  let name = module_diagnostic_name(src, module_start, module_len, member_start, member_len)
  Diagnostic(
    DiagnosticSeverityError,
    DiagnosticClassModule,
    module_diagnostic_resolution_code(resolution),
    module_diagnostic_resolution_message(resolution, name),
    DiagnosticSourceRange(DiagnosticSourceBuffer(src), member_start, member_start + member_len),
    module_diagnostic_related_entry(entry),
    DiagnosticFieldCons(
      DiagnosticFieldText("qualified_name", name),
      DiagnosticFieldCons(DiagnosticFieldText("resolution", module_diagnostic_resolution_name(resolution)), DiagnosticFieldNil)
    )
  )
}

pub(package) fn module_diagnostic_scope_resolution(entry: i64) -> ModuleNameResolution {
  if module_scope_entry_status(entry) == module_scope_status_ambiguous() { AmbiguousModuleName() }
  else { if module_scope_entry_status(entry) == module_scope_status_missing() { MissingModuleName() }
  else { if module_scope_entry_status(entry) == module_scope_status_invisible() { InvisibleModuleName() }
  else { WidenedReexportName() } } }
}

pub(package) fn module_diagnostic_scope_name(entry: i64) -> str {
  let issue = module_scope_entry_kind(entry) == module_scope_kind_issue()
  let primary_import = if issue { module_scope_entry_import(entry) }
    else { if module_scope_entry_conflict_import(entry) != 0 { module_scope_entry_conflict_import(entry) }
    else { module_scope_entry_import(entry) } }
  let name_ptr = if issue { module_diagnostic_import_name_ptr(entry, primary_import) } else { module_scope_entry_name_ptr(entry) }
  let name_len = if issue { module_diagnostic_import_name_len(entry, primary_import) } else { module_scope_entry_name_len(entry) }
  runtime_str_from_bytes_copy(name_ptr, name_len)
}

pub(package) fn module_diagnostic_scope_message(entry: i64, name: str) -> str {
  let status = module_scope_entry_status(entry)
  if status == module_scope_status_missing() { module_diagnostic_message("unknown module member ", name, " in import") }
  else { if status == module_scope_status_invisible() { module_diagnostic_message("module member ", name, " is not visible in this import") }
  else { if status == module_scope_status_widened_reexport() { module_diagnostic_message("module member ", name, " cannot be re-exported at wider visibility") }
  else { if module_scope_entry_kind(entry) == module_scope_kind_issue() { module_diagnostic_message("module member ", name, " is ambiguous in this import") }
  else { module_diagnostic_message("module item ", name, " is ambiguous in this scope") } } } }
}

pub(package) fn module_diagnostic_scope_primary(entry: i64) -> DiagnosticLocation {
  if module_scope_entry_kind(entry) == module_scope_kind_issue() {
    module_diagnostic_import_location(entry, module_scope_entry_import(entry))
  } else { if module_scope_entry_conflict_import(entry) != 0 {
    module_diagnostic_import_local_location(entry, module_scope_entry_conflict_import(entry))
  } else { if module_scope_entry_conflict(entry) != 0 {
    module_diagnostic_decl_location(module_scope_entry_conflict(entry))
  } else { if module_scope_entry_import(entry) != 0 {
    module_diagnostic_import_location(entry, module_scope_entry_import(entry))
  } else { module_diagnostic_decl_location(module_scope_entry_target(entry)) } } } }
}

pub(package) fn module_diagnostic_scope_entry(entry: i64) -> Diagnostic {
  let resolution = module_diagnostic_scope_resolution(entry)
  let name = module_diagnostic_scope_name(entry)
  Diagnostic(
    DiagnosticSeverityError,
    DiagnosticClassModule,
    module_diagnostic_resolution_code(resolution),
    module_diagnostic_scope_message(entry, name),
    module_diagnostic_scope_primary(entry),
    module_diagnostic_related_entry(entry),
    DiagnosticFieldCons(
      DiagnosticFieldText("name", name),
      DiagnosticFieldCons(DiagnosticFieldText("resolution", module_diagnostic_resolution_name(resolution)), DiagnosticFieldNil)
    )
  )
}

pub(package) fn module_diagnose_scope_issues(tt: i64) -[Diagnose]> i64 {
  module_scope_build_all(tt)
  let scopes = module_fact_scopes(tt)
  let mut errors = 0
  for i in 0..nlist_len(scopes) {
    let entry = nlist_get(scopes, i)
    let issue = module_scope_entry_kind(entry) == module_scope_kind_issue()
    let collision = module_scope_entry_status(entry) == module_scope_status_ambiguous() and module_scope_entry_is_type_constructor_pair(entry) == 0
    if module_scope_entry_is_diagnosed(entry) == 0 and (issue or collision) {
      module_scope_entry_mark_diagnosed(entry)
      Diagnose.report(module_diagnostic_scope_entry(entry))
      errors = errors + 1
    } else { 0 }
  }
  errors
}
