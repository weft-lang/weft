-- compiler/module_diagnostics.weft -- structured diagnostics over module facts

use compiler/lib.{*}
use compiler/module.{*}
use runtime/buffer.{*}
use runtime/string.{runtime_str_from_bytes_copy}
use stdlib/diagnostic.{*}
use stdlib/diagnostic_registry.{*}
use stdlib/diagnostic_type.{*}

pub(package) fn module_diagnostic_name(src: i64, module_start: i64, module_len: i64, member_start: i64, member_len: i64) -> str {
  let name = buf_new(module_len + member_len + 1)
  bscopy(name, src + module_start, module_len, 0)
  bstr(name, ".")
  bscopy(name, src + member_start, member_len, 0)
  runtime_str_from_bytes_copy(buf_ptr(name), buf_len(name))
}

pub(package) fn module_diagnostic_message(prefix: str, name: str, suffix: str) -> str {
  let message = buf_new(__str_len(prefix) + __str_len(name) + __str_len(suffix) + 2)
  bstr(message, prefix)
  bstr(message, "'")
  bstr(message, name)
  bstr(message, "'")
  bstr(message, suffix)
  runtime_str_from_bytes_copy(buf_ptr(message), buf_len(message))
}

pub(package) fn module_diagnostic_decl_location(decl: i64) -> DiagnosticLocation {
  if decl == 0 { DiagnosticLocationNone }
  else {
    let source = module_decl_fact_source(decl)
    let start = module_decl_fact_name_ptr(decl) - source
    DiagnosticSourceRange(DiagnosticSourceBuffer(source), start, start + module_decl_fact_name_len(decl))
  }
}

pub(package) fn module_diagnostic_related_entry(entry: i64) -> DiagnosticRelatedLocationList {
  if entry == 0 or module_scope_entry_kind(entry) == module_scope_kind_module() { DiagnosticRelatedLocationNil }
  else {
    let target = module_scope_entry_target(entry)
    let conflict = module_scope_entry_conflict(entry)
    let rest = if conflict == 0 { DiagnosticRelatedLocationNil }
      else { DiagnosticRelatedLocationCons(DiagnosticRelatedLocation("conflicting declaration", module_diagnostic_decl_location(conflict)), DiagnosticRelatedLocationNil) }
    if target == 0 { rest }
    else { DiagnosticRelatedLocationCons(DiagnosticRelatedLocation("declaration is here", module_diagnostic_decl_location(target)), rest) }
  }
}

pub(package) fn module_diagnostic_resolution_name(resolution: ModuleNameResolution) -> str {
  match resolution {
    MissingModuleName -> "missing"
    InvisibleModuleName -> "invisible"
    AmbiguousModuleName -> "ambiguous"
    WidenedReexportName -> "widened-reexport"
    ResolvedDeclarationName(id) -> "wrong-kind"
    ResolvedModuleName(id) -> "wrong-kind"
  }
}

pub(package) fn module_diagnostic_resolution_code(resolution: ModuleNameResolution) -> DiagnosticCode {
  match resolution {
    MissingModuleName -> diagnostic_code_module_member_missing()
    InvisibleModuleName -> diagnostic_code_module_member_invisible()
    AmbiguousModuleName -> diagnostic_code_module_member_ambiguous()
    WidenedReexportName -> diagnostic_code_module_reexport_widening()
    ResolvedDeclarationName(id) -> diagnostic_code_module_member_wrong_kind()
    ResolvedModuleName(id) -> diagnostic_code_module_member_wrong_kind()
  }
}

pub(package) fn module_diagnostic_resolution_message(resolution: ModuleNameResolution, name: str) -> str {
  match resolution {
    MissingModuleName -> module_diagnostic_message("unknown module member ", name, "")
    InvisibleModuleName -> module_diagnostic_message("module member ", name, " is not visible")
    AmbiguousModuleName -> module_diagnostic_message("module member ", name, " is ambiguous")
    WidenedReexportName -> module_diagnostic_message("module member ", name, " cannot be re-exported at wider visibility")
    ResolvedDeclarationName(id) -> module_diagnostic_message("module member ", name, " is not a function value")
    ResolvedModuleName(id) -> module_diagnostic_message("module member ", name, " is not a function value")
  }
}

pub(package) fn module_diagnostic_qualified_member(
  resolution: ModuleNameResolution,
  entry: i64,
  src: i64,
  module_start: i64,
  module_len: i64,
  member_start: i64,
  member_len: i64
) -> Diagnostic {
  let name = module_diagnostic_name(src, module_start, module_len, member_start, member_len)
  diagnostic_new(
    DiagnosticSeverityError,
    DiagnosticClassModule,
    module_diagnostic_resolution_code(resolution),
    module_diagnostic_resolution_message(resolution, name),
    DiagnosticSourceRange(DiagnosticSourceBuffer(src), member_start, member_start + member_len),
    module_diagnostic_related_entry(entry),
    DiagnosticFieldCons(
      DiagnosticFieldText("qualified_name", name),
      DiagnosticFieldCons(DiagnosticFieldText("resolution", module_diagnostic_resolution_name(resolution)), DiagnosticFieldNil)
    )
  )
}
