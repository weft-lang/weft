pub(package) fn ir_handler_clause_body_list_len(clauses: IrHandlerClauseBodyList) -> i64 {
  match clauses {
    IrHandlerClauseBodyNil -> 0
    IrHandlerClauseBodyCons(clause, rest) -> 1 + ir_handler_clause_body_list_len(rest)
  }
}

pub(package) fn ir_handler_clause_body_list_nth(clauses: IrHandlerClauseBodyList, index: i64) -> IrHandlerClauseBody {
  match clauses {
    IrHandlerClauseBodyNil -> IrHandlerClauseBodyInvalid(1)
    IrHandlerClauseBodyCons(clause, rest) -> {
      if index <= 0 { clause } else { ir_handler_clause_body_list_nth(rest, index - 1) }
    }
  }
}

