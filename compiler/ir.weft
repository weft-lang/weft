pub(package) fn type_record_field_list_nth_type_tag_or(fields: TypeRecordFieldList, index: i64, default: i64) -> i64 {
  match fields {
    TypeRecordFieldListNil -> default
    TypeRecordFieldListCons(field, rest) -> {
      if index == 0 { type_record_field_type_tag_or(field, default) }
      else { type_record_field_list_nth_type_tag_or(rest, index - 1, default) }
    }
  }
}

pub(package) fn type_record_field_list_nth_type_prim_id_or(fields: TypeRecordFieldList, index: i64, default: i64) -> i64 {
  match fields {
    TypeRecordFieldListNil -> default
    TypeRecordFieldListCons(field, rest) -> {
      if index == 0 { type_record_field_type_prim_id_or(field, default) }
      else { type_record_field_list_nth_type_prim_id_or(rest, index - 1, default) }
    }
  }
}

pub(package) fn type_record_field_list_nth_type_child_count_or(fields: TypeRecordFieldList, index: i64, default: i64) -> i64 {
  match fields {
    TypeRecordFieldListNil -> default
    TypeRecordFieldListCons(field, rest) -> {
      if index == 0 { type_record_field_type_child_count_or(field, default) }
      else { type_record_field_list_nth_type_child_count_or(rest, index - 1, default) }
    }
  }
}

pub(package) fn type_record_field_list_nth_type_child_tag_or(fields: TypeRecordFieldList, field_index: i64, child_index: i64, default: i64) -> i64 {
  match fields {
    TypeRecordFieldListNil -> default
    TypeRecordFieldListCons(field, rest) -> {
      if field_index == 0 { type_record_field_type_child_tag_or(field, child_index, default) }
      else { type_record_field_list_nth_type_child_tag_or(rest, field_index - 1, child_index, default) }
    }
  }
}

pub(package) fn type_record_field_list_nth_type_child_prim_id_or(fields: TypeRecordFieldList, field_index: i64, child_index: i64, default: i64) -> i64 {
  match fields {
    TypeRecordFieldListNil -> default
    TypeRecordFieldListCons(field, rest) -> {
      if field_index == 0 { type_record_field_type_child_prim_id_or(field, child_index, default) }
      else { type_record_field_list_nth_type_child_prim_id_or(rest, field_index - 1, child_index, default) }
    }
  }
}

pub(package) fn type_record_field_list_type_tree_raw_bridge_slot_count(fields: TypeRecordFieldList) -> i64 {
  match fields {
    TypeRecordFieldListNil -> 0
    TypeRecordFieldListCons(field, rest) -> type_record_field_type_tree_raw_bridge_slot_count(field) + type_record_field_list_type_tree_raw_bridge_slot_count(rest)
  }
}

pub(package) fn type_record_field_list_type_tree_unknown_count(fields: TypeRecordFieldList) -> i64 {
  match fields {
    TypeRecordFieldListNil -> 0
    TypeRecordFieldListCons(field, rest) -> type_record_field_type_tree_unknown_count(field) + type_record_field_list_type_tree_unknown_count(rest)
  }
}

pub(package) type TypeVariant {
  TypeVariant(i64, i64, i64, TypeExprList),
  MissingTypeVariant
}

pub(package) type TypeVariantList {
  TypeVariantListNil,
  TypeVariantListCons(TypeVariant, TypeVariantList)
}

pub(package) fn type_variant_list_empty() -> TypeVariantList {
  TypeVariantListNil
}

pub(package) fn type_variant_list_from_array(variants: i64, index: i64, count: i64) -> TypeVariantList {
  if index >= count { TypeVariantListNil }
  else {
    let payload_count = types_storage_variant_payload_count(variants, index)
    let payloads = types_storage_variant_payloads(variants, index)
    let variant = TypeVariant(
      types_storage_variant_name_start(variants, index),
      types_storage_variant_name_len(variants, index),
      payload_count,
      type_expr_list_from_type_nodes(payloads)
    )
    TypeVariantListCons(variant, type_variant_list_from_array(variants, index + 1, count))
  }
}

pub(package) fn type_entry_variants(entry: TypeEntry) -> TypeVariantList {
  match entry {
    TypeVariantEntry(name, tparams, variants) -> variants
    _ -> TypeVariantListNil
  }
}

pub(package) fn type_variant_name_len_or(variant: TypeVariant, default: i64) -> i64 {
  match variant {
    TypeVariant(ns, nl, payload_count, payloads) -> nl
    MissingTypeVariant -> default
  }
}

pub(package) fn type_variant_payload_count_or(variant: TypeVariant, default: i64) -> i64 {
  match variant {
    TypeVariant(ns, nl, payload_count, payloads) -> payload_count
    MissingTypeVariant -> default
  }
}

pub(package) fn type_variant_payloads(variant: TypeVariant) -> TypeExprList {
  match variant {
    TypeVariant(ns, nl, payload_count, payloads) -> payloads
    MissingTypeVariant -> TypeExprListNil
  }
}

pub(package) fn type_variant_tree_raw_bridge_slot_count(variant: TypeVariant) -> i64 {
  match variant {
    TypeVariant(ns, nl, payload_count, payloads) -> type_expr_list_tree_raw_bridge_slot_count(payloads)
    MissingTypeVariant -> 0
  }
}

pub(package) fn type_variant_tree_unknown_count(variant: TypeVariant) -> i64 {
  match variant {
    TypeVariant(ns, nl, payload_count, payloads) -> type_expr_list_tree_unknown_count(payloads)
    MissingTypeVariant -> 1
  }
}

pub(package) fn type_variant_list_len(variants: TypeVariantList) -> i64 {
  match variants {
    TypeVariantListNil -> 0
    TypeVariantListCons(variant, rest) -> 1 + type_variant_list_len(rest)
  }
}

pub(package) fn type_variant_list_nth(variants: TypeVariantList, index: i64) -> TypeVariant {
  match variants {
    TypeVariantListNil -> MissingTypeVariant
    TypeVariantListCons(variant, rest) -> {
      if index == 0 { variant } else { type_variant_list_nth(rest, index - 1) }
    }
  }
}

pub(package) fn type_variant_list_nth_name_len_or(variants: TypeVariantList, index: i64, default: i64) -> i64 {
  type_variant_name_len_or(type_variant_list_nth(variants, index), default)
}

pub(package) fn type_variant_list_nth_payload_count_or(variants: TypeVariantList, index: i64, default: i64) -> i64 {
  type_variant_payload_count_or(type_variant_list_nth(variants, index), default)
}

pub(package) fn type_variant_list_nth_payload_type_tag_or(variants: TypeVariantList, variant_index: i64, payload_index: i64, default: i64) -> i64 {
  type_expr_list_nth_tag_or(type_variant_payloads(type_variant_list_nth(variants, variant_index)), payload_index, default)
}

pub(package) fn type_variant_list_nth_payload_type_prim_id_or(variants: TypeVariantList, variant_index: i64, payload_index: i64, default: i64) -> i64 {
  type_expr_list_nth_prim_id_or(type_variant_payloads(type_variant_list_nth(variants, variant_index)), payload_index, default)
}

pub(package) fn type_variant_list_tree_raw_bridge_slot_count(variants: TypeVariantList) -> i64 {
  match variants {
    TypeVariantListNil -> 0
    TypeVariantListCons(variant, rest) -> type_variant_tree_raw_bridge_slot_count(variant) + type_variant_list_tree_raw_bridge_slot_count(rest)
  }
}

pub(package) fn type_variant_list_tree_unknown_count(variants: TypeVariantList) -> i64 {
  match variants {
    TypeVariantListNil -> 0
    TypeVariantListCons(variant, rest) -> type_variant_tree_unknown_count(variant) + type_variant_list_tree_unknown_count(rest)
  }
}

-- ══════════════════════════════════════════════════════════════
-- Record fields
-- ══════════════════════════════════════════════════════════════

pub(package) type RecordFieldFact {
  ResolvedRecordFieldFact(TypeExpr, i64, i64), -- semantic field type, stable key, canonical word offset
  UnknownRecordFieldFact
}

pub(package) type RecordField {
  RecordField(i64, i64, Expr, RecordFieldFact), -- name span/key, typed value, checker-produced layout fact
  UnknownRecordField(i64)
}

pub(package) type RecordFieldList {
  RecordFieldListNil,
  RecordFieldListCons(RecordField, RecordFieldList)
}

pub(package) fn record_field_from_node(node: i64) -> RecordField {
  if raw_bridge_is_missing(node) == 1 { UnknownRecordField(0) }
  else {
    match node_tag(node) {
      2 -> RecordField(node_f1(node), node_f2(node), expr_from_node(node_f3(node)), record_field_fact_from_node(node_f4(node)))
      _ -> UnknownRecordField(node_tag(node))
    }
  }
}

pub(package) fn record_field_fact_from_node(node: i64) -> RecordFieldFact {
  if raw_bridge_is_missing(node) == 1 { UnknownRecordFieldFact }
  else { ResolvedRecordFieldFact(type_expr_from_node(node_f1(node)), node_f2(node), node_f3(node)) }
}

pub(package) fn record_field_fact_to_node(fact: RecordFieldFact) -> i64 {
  match fact {
    ResolvedRecordFieldFact(ty, field_hash, word_offset) -> node_new(1, type_expr_to_node(ty), field_hash, word_offset, 0)
    UnknownRecordFieldFact -> 0
  }
}

pub(package) fn record_field_resolved_type_node(field: RecordField) -> i64 {
  match field {
    RecordField(ns, nl, value, fact) -> match fact {
      ResolvedRecordFieldFact(ty, field_hash, word_offset) -> type_expr_to_node(ty)
      UnknownRecordFieldFact -> 0
    }
    UnknownRecordField(tag) -> 0
  }
}

pub(package) fn record_field_hash_or(field: RecordField, default: i64) -> i64 {
  match field {
    RecordField(ns, nl, value, fact) -> match fact {
      ResolvedRecordFieldFact(ty, field_hash, word_offset) -> field_hash
      UnknownRecordFieldFact -> default
    }
    UnknownRecordField(tag) -> default
  }
}

pub(package) fn record_field_word_offset_or(field: RecordField, default: i64) -> i64 {
  match field {
    RecordField(ns, nl, value, fact) -> match fact {
      ResolvedRecordFieldFact(ty, field_hash, word_offset) -> word_offset
      UnknownRecordFieldFact -> default
    }
    UnknownRecordField(tag) -> default
  }
}

pub(package) fn record_field_value_expr(field: RecordField) -> Expr {
  match field {
    RecordField(ns, nl, value, fact) -> value
    UnknownRecordField(tag) -> UnknownExpr(0)
  }
}

pub(package) fn record_field_name_len_or(field: RecordField, default: i64) -> i64 {
  match field {
    RecordField(ns, nl, value, fact) -> nl
    _ -> default
  }
}

pub(package) fn record_field_list_empty() -> RecordFieldList {
  RecordFieldListNil
}

pub(package) fn record_field_list_from_nodes(nodes: i64, index: i64, count: i64) -> RecordFieldList {
  if raw_bridge_is_missing(nodes) == 1 { RecordFieldListNil }
  else { if index >= count { RecordFieldListNil }
  else {
    RecordFieldListCons(record_field_from_node(nlist_get(nodes, index)), record_field_list_from_nodes(nodes, index + 1, count))
  } }
}

pub(package) fn expr_record_fields(expr: Expr) -> RecordFieldList {
  match expr {
    RecordInit(type_ns, type_nl, fields) -> fields
    RecordUpdate(base, fields, fact) -> fields
    _ -> RecordFieldListNil
  }
}

pub(package) fn expr_record_field_count_or(expr: Expr, default: i64) -> i64 {
  match expr {
    RecordInit(type_ns, type_nl, fields) -> record_field_list_len(fields)
    RecordUpdate(base, fields, fact) -> record_field_list_len(fields)
    _ -> default
  }
}

pub(package) fn expr_field_name_len_or(expr: Expr, default: i64) -> i64 {
  match expr {
    FieldAccess(base, field_ns, field_nl, fact) -> field_nl
    OptChain(base, field_ns, field_nl, effect_atom) -> field_nl
    _ -> default
  }
}

pub(package) fn expr_field_base_tag_or(expr: Expr, default: i64) -> i64 {
  match expr {
    FieldAccess(base, field_ns, field_nl, fact) -> expr_tag(base)
    IndexedLen(base, fixed_len) -> expr_tag(base)
    IndexedGet(base, index, element_ty, fixed_len) -> expr_tag(base)
    IndexedSlice(base, start, end, fact) -> expr_tag(base)
    OptChain(base, field_ns, field_nl, effect_atom) -> expr_tag(base)
    _ -> default
  }
}

pub(package) fn record_field_list_len(fields: RecordFieldList) -> i64 {
  match fields {
    RecordFieldListNil -> 0
    RecordFieldListCons(field, rest) -> 1 + record_field_list_len(rest)
  }
}

pub(package) fn record_field_list_nth_name_len_or(fields: RecordFieldList, index: i64, default: i64) -> i64 {
  match fields {
    RecordFieldListNil -> default
    RecordFieldListCons(field, rest) -> {
      if index == 0 { record_field_name_len_or(field, default) }
      else { record_field_list_nth_name_len_or(rest, index - 1, default) }
    }
  }
}

pub(package) fn record_field_list_nth_value_tag_or(fields: RecordFieldList, index: i64, default: i64) -> i64 {
  match fields {
    RecordFieldListNil -> default
    RecordFieldListCons(field, rest) -> {
      if index == 0 { expr_tag(record_field_value_expr(field)) }
      else { record_field_list_nth_value_tag_or(rest, index - 1, default) }
    }
  }
}

pub(package) fn record_field_list_count_value_tag(fields: RecordFieldList, tag: i64) -> i64 {
  match fields {
    RecordFieldListNil -> 0
    RecordFieldListCons(field, rest) -> {
      let add = if expr_tag(record_field_value_expr(field)) == tag { 1 } else { 0 }
      add + record_field_list_count_value_tag(rest, tag)
    }
  }
}

-- ══════════════════════════════════════════════════════════════
-- Parameters
-- ══════════════════════════════════════════════════════════════

pub(package) type Param {
  Param(i64, i64, TypeExpr, ParamLabel),  -- tag 2: f1=name_ns, f2=name_nl, typed f3=type, typed f4=label
  UnknownParam(i64)
}

pub(package) type ParamLabel {
  PositionalParamLabel,
  ExplicitParamLabel(i64, i64),
  ImplicitParamLabel,
  UnknownParamLabel
}

pub(package) type ParamList {
  ParamListNil,
  ParamListCons(Param, ParamList)
}

pub(package) fn param_label_from_raw(label: i64) -> ParamLabel {
  if label < 0 { PositionalParamLabel }
  else { if label == 0 { ImplicitParamLabel }
  else {
    if raw_bridge_is_missing(label) == 1 { UnknownParamLabel }
    else { if node_tag(label) == 2 { ExplicitParamLabel(node_f1(label), node_f2(label)) }
    else { UnknownParamLabel } }
  } }
}

pub(package) fn param_from_node(node: i64) -> Param {
  if raw_bridge_is_missing(node) == 1 { UnknownParam(0) }
  else {
    match node_tag(node) {
      2 -> Param(node_f1(node), node_f2(node), type_expr_from_node(node_f3(node)), param_label_from_raw(node_f4(node)))
      _ -> UnknownParam(node_tag(node))
    }
  }
}

pub(package) fn param_name_len_or(param: Param, default: i64) -> i64 {
  match param {
    Param(ns, nl, ty, label) -> nl
    UnknownParam(tag) -> default
  }
}

pub(package) fn param_has_type_annotation(param: Param) -> i64 {
  match param {
    Param(ns, nl, ty, label) -> {
      match ty {
        MissingTypeExpr -> 0
        _ -> 1
      }
    }
    UnknownParam(tag) -> 0
  }
}

pub(package) fn param_type_tag_or(param: Param, default: i64) -> i64 {
  match param {
    Param(ns, nl, ty, label) -> type_expr_tag_or(ty, default)
    UnknownParam(tag) -> default
  }
}

pub(package) fn param_type_prim_id_or(param: Param, default: i64) -> i64 {
  match param {
    Param(ns, nl, ty, label) -> type_expr_prim_id_or(ty, default)
    UnknownParam(tag) -> default
  }
}

pub(package) fn param_label_kind(param: Param) -> i64 {
  match param {
    Param(ns, nl, ty, label) -> {
      match label {
        PositionalParamLabel -> 1
        ExplicitParamLabel(label_ns, label_nl) -> 2
        ImplicitParamLabel -> 3
        UnknownParamLabel -> 0
      }
    }
    UnknownParam(tag) -> 0
  }
}

pub(package) fn param_call_label_len_or(param: Param, default: i64) -> i64 {
  match param {
    Param(ns, nl, ty, label) -> {
      match label {
        PositionalParamLabel -> default
        ExplicitParamLabel(label_ns, label_nl) -> label_nl
        ImplicitParamLabel -> nl
        UnknownParamLabel -> default
      }
    }
    UnknownParam(tag) -> default
  }
}

pub(package) fn param_raw_bridge_slot_count(param: Param) -> i64 {
  match param {
    Param(ns, nl, ty, label) -> 0
    UnknownParam(tag) -> 0
  }
}

pub(package) fn param_tree_raw_bridge_slot_count(param: Param) -> i64 {
  match param {
    Param(ns, nl, ty, label) -> param_raw_bridge_slot_count(param) + type_expr_tree_raw_bridge_slot_count(ty)
    UnknownParam(tag) -> param_raw_bridge_slot_count(param)
  }
}

pub(package) fn param_optional_type_tree_unknown_count(ty: TypeExpr) -> i64 {
  match ty {
    MissingTypeExpr -> 0
    _ -> type_expr_tree_unknown_count(ty)
  }
}

pub(package) fn param_tree_unknown_count(param: Param) -> i64 {
  match param {
    Param(ns, nl, ty, label) -> {
      let label_unknown = match label {
        UnknownParamLabel -> 1
        _ -> 0
      }
      label_unknown + param_optional_type_tree_unknown_count(ty)
    }
    UnknownParam(tag) -> 1
  }
}

pub(package) fn param_list_empty() -> ParamList {
  ParamListNil
}

pub(package) fn param_list_from_nodes(nodes: i64, index: i64, count: i64) -> ParamList {
  if raw_bridge_is_missing(nodes) == 1 { ParamListNil }
  else { if index >= count { ParamListNil }
  else {
    ParamListCons(param_from_node(nlist_get(nodes, index)), param_list_from_nodes(nodes, index + 1, count))
  } }
}

pub(package) fn param_list_from_param_nodes(params: i64) -> ParamList {
  if raw_bridge_is_missing(params) == 1 { ParamListNil } else { param_list_from_nodes(params, 0, raw_bridge_list_len_or_zero(params)) }
}

pub(package) fn param_list_len(params: ParamList) -> i64 {
  match params {
    ParamListNil -> 0
    ParamListCons(param, rest) -> 1 + param_list_len(rest)
  }
}

pub(package) fn param_list_nth_name_len_or(params: ParamList, index: i64, default: i64) -> i64 {
  match params {
    ParamListNil -> default
    ParamListCons(param, rest) -> {
      if index == 0 { param_name_len_or(param, default) }
      else { param_list_nth_name_len_or(rest, index - 1, default) }
    }
  }
}

pub(package) fn param_list_nth_label_kind_or(params: ParamList, index: i64, default: i64) -> i64 {
  match params {
    ParamListNil -> default
    ParamListCons(param, rest) -> {
      if index == 0 { param_label_kind(param) }
      else { param_list_nth_label_kind_or(rest, index - 1, default) }
    }
  }
}

pub(package) fn param_list_nth_call_label_len_or(params: ParamList, index: i64, default: i64) -> i64 {
  match params {
    ParamListNil -> default
    ParamListCons(param, rest) -> {
      if index == 0 { param_call_label_len_or(param, default) }
      else { param_list_nth_call_label_len_or(rest, index - 1, default) }
    }
  }
}

pub(package) fn param_list_nth_has_type_annotation_or(params: ParamList, index: i64, default: i64) -> i64 {
  match params {
    ParamListNil -> default
    ParamListCons(param, rest) -> {
      if index == 0 { param_has_type_annotation(param) }
      else { param_list_nth_has_type_annotation_or(rest, index - 1, default) }
    }
  }
}

pub(package) fn param_list_nth_type_tag_or(params: ParamList, index: i64, default: i64) -> i64 {
  match params {
    ParamListNil -> default
    ParamListCons(param, rest) -> {
      if index == 0 { param_type_tag_or(param, default) }
      else { param_list_nth_type_tag_or(rest, index - 1, default) }
    }
  }
}

pub(package) fn param_list_nth_type_prim_id_or(params: ParamList, index: i64, default: i64) -> i64 {
  match params {
    ParamListNil -> default
    ParamListCons(param, rest) -> {
      if index == 0 { param_type_prim_id_or(param, default) }
      else { param_list_nth_type_prim_id_or(rest, index - 1, default) }
    }
  }
}

pub(package) fn param_list_count_label_kind(params: ParamList, kind: i64) -> i64 {
  match params {
    ParamListNil -> 0
    ParamListCons(param, rest) -> {
      let add = if param_label_kind(param) == kind { 1 } else { 0 }
      add + param_list_count_label_kind(rest, kind)
    }
  }
}

pub(package) fn param_list_raw_bridge_slot_count(params: ParamList) -> i64 {
  match params {
    ParamListNil -> 0
    ParamListCons(param, rest) -> param_raw_bridge_slot_count(param) + param_list_raw_bridge_slot_count(rest)
  }
}

pub(package) fn param_list_tree_raw_bridge_slot_count(params: ParamList) -> i64 {
  match params {
    ParamListNil -> 0
    ParamListCons(param, rest) -> param_tree_raw_bridge_slot_count(param) + param_list_tree_raw_bridge_slot_count(rest)
  }
}

pub(package) fn param_list_tree_unknown_count(params: ParamList) -> i64 {
  match params {
    ParamListNil -> 0
    ParamListCons(param, rest) -> param_tree_unknown_count(param) + param_list_tree_unknown_count(rest)
  }
}

pub(package) fn expr_lambda_params(expr: Expr) -> ParamList {
  match expr {
    Lambda(params, body, source_site) -> params
    _ -> ParamListNil
  }
}

pub(package) fn expr_lambda_param_count_or(expr: Expr, default: i64) -> i64 {
  match expr {
    Lambda(params, body, source_site) -> param_list_len(params)
    _ -> default
  }
}

pub(package) fn expr_lambda_body_tag_or(expr: Expr, default: i64) -> i64 {
  match expr {
    Lambda(params, body, source_site) -> expr_tag(body)
    _ -> default
  }
}

-- ══════════════════════════════════════════════════════════════
-- Effect operations
-- ══════════════════════════════════════════════════════════════

pub(package) type TypeEffectOp {
  TypeEffectOp(i64, i64, ParamList, TypeExpr), -- tag 31: f1=name_ns, f2=name_nl, typed params/ret
  DeferredTypeEffectOp(i64, i64, ParamList, TypeExpr),
  MissingTypeEffectOp
}

pub(package) type TypeEffectOpList {
  TypeEffectOpListNil,
  TypeEffectOpListCons(TypeEffectOp, TypeEffectOpList)
}

pub(package) fn type_effect_op_list_empty() -> TypeEffectOpList {
  TypeEffectOpListNil
}

pub(package) fn type_effect_op_node_ret(node: i64) -> i64 {
  let meta = node_f4(node)
  if raw_bridge_is_missing(meta) == 1 { 0 }
  else {
    if node_tag(meta) == 53 { node_f1(meta) } else { meta }
  }
}

pub(package) fn type_effect_op_node_deferred(node: i64) -> i64 {
  let meta = node_f4(node)
  if raw_bridge_is_missing(meta) == 1 { 0 }
  else {
    if node_tag(meta) == 53 { node_f2(meta) } else { 0 }
  }
}

pub(package) fn type_effect_op_from_node(node: i64) -> TypeEffectOp {
  if raw_bridge_is_missing(node) == 1 { MissingTypeEffectOp }
  else {
    match node_tag(node) {
      31 -> {
        let params = param_list_from_param_nodes(node_f3(node))
        let ret_type = type_expr_from_node(type_effect_op_node_ret(node))
        if type_effect_op_node_deferred(node) == 1 {
          DeferredTypeEffectOp(node_f1(node), node_f2(node), params, ret_type)
        } else {
          TypeEffectOp(node_f1(node), node_f2(node), params, ret_type)
        }
      }
      _ -> MissingTypeEffectOp
    }
  }
}

