-- compiler/ir.weft — Typed IR for the Weft compiler
--
-- The compiler's internal representation as proper Weft types.
-- Replaces the raw `node_new(tag, f1, f2, f3, f4)` pattern with
-- typed constructors that the type system can reason about.
--
-- This is the "compiler as data" foundation: IR is a Weft type,
-- passes are functions over these types, tools are handler configs.

-- ══════════════════════════════════════════════════════════════
-- Expressions
-- ══════════════════════════════════════════════════════════════
-- Each variant corresponds to an AST tag in the current compiler.
-- The mapping is documented for migration purposes.

type Expr {
  -- Literals
  IntLit(i64),                    -- tag 1: f1=value
  StringLit(i64, i64),            -- tag 9: f1=src_offset, f2=length
  BoolLit(i64),                   -- tag 24: f1=value (1=true, 0=false)

  -- Variables and names
  Ident(i64, i64),                -- tag 2: f1=ns, f2=nl

  -- Operators
  BinOp(i64, i64, i64),           -- tag 3: f1=op_id, f2=lhs, f3=rhs

  -- Function calls
  Call(i64, i64, i64, i64),       -- tag 4: f1=ns, f2=nl, f3=args, f4=nargs
  GenericCall(i64, i64),          -- tag 36: f1=type_args, f2=inner_call

  -- Control flow
  If(i64, i64, i64),              -- tag 5: f1=cond, f2=then, f3=else
  While(i64, i64),                -- tag 10: f1=cond, f2=body
  Loop(i64),                      -- tag 49: f1=body
  Break(i64),                     -- tag 26: f1=value (0 for no value)
  Continue,                       -- tag 27
  Return(i64),                    -- tag 25: f1=value

  -- Bindings
  Let(i64, i64, i64, i64),        -- tag 6: f1=ns, f2=nl, f3=val, f4=body
  LetMut(i64, i64, i64, i64),     -- tag 11: f1=ns, f2=nl, f3=val, f4=body
  Assign(i64, i64, i64),          -- tag 12: f1=ns, f2=nl, f3=val

  -- Blocks
  Block(i64, i64),                -- tag 7: f1=first, f2=rest

  -- Records and fields
  FieldAccess(i64, i64, i64),     -- tag 13: f1=base, f2=field_ns, f3=field_nl
  RecordInit(i64, i64, i64, i64), -- tag 14: f1=type_ns, f2=type_nl, f3=fields, f4=nfields

  -- Pattern matching
  Match(i64, i64, i64),           -- tag 15: f1=scrutinee, f2=arms, f3=n_arms

  -- Boolean
  Not(i64),                       -- tag 22: f1=operand

  -- Lambdas
  Lambda(i64, i64, i64),          -- tag 29: f1=params, f2=body, f3=nparams

  -- Effects
  Perform(i64, i64, i64, i64),    -- tag 32: f1=lhs, f2=op_hash, f3=args, f4=nargs
  Handle(i64, i64, i64),          -- tag 33: f1=body, f2=clauses, f3=nclauses
  Resume(i64),                    -- tag 35: f1=value

  -- Typed method call (after typeck rewrite)
  MethodCall(i64, i64, i64, i64), -- tag 41: f1=recv, f2=method_hash, f3=args, f4=type_hash

  -- Sugar (desugared at parse time, but present in typed IR)
  Try(i64),                       -- tag 45: f1=inner (? operator)
  InterpConcat(i64, i64),         -- tag 46: f1=left, f2=right
  ForIter(i64, i64, i64, i64),    -- tag 47: f1=var_ns, f2=var_nl, f3=collection, f4=body
  OptChain(i64, i64, i64),        -- tag 48: f1=base, f2=field_ns, f3=field_nl

  -- Typed let (after typeck annotation)
  LetTyped(i64, i64)              -- tag 37: f1=inner, f2=ann_type
}

-- ══════════════════════════════════════════════════════════════
-- Patterns (for match arms)
-- ══════════════════════════════════════════════════════════════

type Pattern {
  Wildcard,                        -- tag 17
  Binding(i64, i64),               -- tag 18: f1=ns, f2=nl
  IntPattern(i64),                 -- tag 19: f1=value
  CtorPattern(i64, i64, i64, i64)  -- tag 20: f1=tag_ns, f2=tag_nl, f3=bindings, f4=count
}

-- ══════════════════════════════════════════════════════════════
-- Match arms
-- ══════════════════════════════════════════════════════════════

type MatchArm {
  Arm(i64, i64, i64)              -- tag 16: f1=pattern, f2=body, f3=guard
}

-- ══════════════════════════════════════════════════════════════
-- Declarations
-- ══════════════════════════════════════════════════════════════

type Decl {
  FnDecl(i64, i64, i64, i64),     -- tag 8: f1=ns, f2=nl, f3=params, f4=body
  FnDeclWrapped(i64, i64, i64, i64), -- tag 23: f1=inner, f2=ret_type, f3=eff_sig, f4=tparams
  TraitDecl(i64, i64, i64, i64),   -- tag 38: f1=ns, f2=nl, f3=methods, f4=nmethods
  ImplBlock(i64, i64, i64, i64),   -- tag 40: f1=type_ns, f2=type_nl, f3=methods, f4=trait_hash
  EffectDecl(i64, i64, i64, i64)   -- tag 30: f1=ns, f2=nl, f3=ops, f4=nops
}

-- ══════════════════════════════════════════════════════════════
-- Tag constants for backward compatibility
-- ══════════════════════════════════════════════════════════════
-- These map between the new type constructors and the old numeric tags.
-- Used during the migration period.

fn TAG_INTLIT() -> i64 { 1 }
fn TAG_IDENT() -> i64 { 2 }
fn TAG_BINOP() -> i64 { 3 }
fn TAG_CALL() -> i64 { 4 }
fn TAG_IF() -> i64 { 5 }
fn TAG_LET() -> i64 { 6 }
fn TAG_BLOCK() -> i64 { 7 }
fn TAG_FNDECL() -> i64 { 8 }
fn TAG_STRINGLIT() -> i64 { 9 }
fn TAG_WHILE() -> i64 { 10 }
fn TAG_LETMUT() -> i64 { 11 }
fn TAG_ASSIGN() -> i64 { 12 }
fn TAG_FIELDACCESS() -> i64 { 13 }
fn TAG_RECORDINIT() -> i64 { 14 }
fn TAG_MATCH() -> i64 { 15 }
fn TAG_MATCHARM() -> i64 { 16 }
fn TAG_WILDCARD() -> i64 { 17 }
fn TAG_BINDING() -> i64 { 18 }
fn TAG_INTPAT() -> i64 { 19 }
fn TAG_CTORPAT() -> i64 { 20 }
fn TAG_NOT() -> i64 { 22 }
fn TAG_FNDECLWRAP() -> i64 { 23 }
fn TAG_BOOLLIT() -> i64 { 24 }
fn TAG_RETURN() -> i64 { 25 }
fn TAG_BREAK() -> i64 { 26 }
fn TAG_CONTINUE() -> i64 { 27 }
fn TAG_LAMBDA() -> i64 { 29 }
fn TAG_EFFECTDECL() -> i64 { 30 }
fn TAG_PERFORM() -> i64 { 32 }
fn TAG_HANDLE() -> i64 { 33 }
fn TAG_RESUME() -> i64 { 35 }
fn TAG_GENERICCALL() -> i64 { 36 }
fn TAG_LETTYPED() -> i64 { 37 }
fn TAG_TRAITDECL() -> i64 { 38 }
fn TAG_IMPLBLOCK() -> i64 { 40 }
fn TAG_METHODCALL() -> i64 { 41 }
fn TAG_TRY() -> i64 { 45 }
fn TAG_INTERPCONCAT() -> i64 { 46 }
fn TAG_FORITER() -> i64 { 47 }
fn TAG_OPTCHAIN() -> i64 { 48 }
fn TAG_LOOP() -> i64 { 49 }
