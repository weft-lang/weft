pub(package) fn ir_function_list_empty() -> IrFunctionList {
  IrFunctionNil
}

pub(package) fn ir_function_list_prepend(f: IrFunction, rest: IrFunctionList) -> IrFunctionList {
  IrFunctionCons(f, rest)
}

pub(package) fn ir_function_list_len(functions: IrFunctionList) -> i64 {
  match functions {
    IrFunctionNil -> 0
    IrFunctionCons(f, rest) -> 1 + ir_function_list_len(rest)
  }
}

pub(package) fn ir_function_list_len_for_source(functions: IrFunctionList, source: i64) -> i64 {
  match functions {
    IrFunctionNil -> 0
    IrFunctionCons(f, rest) -> {
      match f {
        IrFunction(name_hash, param_count, blocks, src) -> {
          let here = if src == source { 1 } else { 0 }
          here + ir_function_list_len_for_source(rest, source)
        }
      }
    }
  }
}

pub(package) fn ir_function_list_inst_count(functions: IrFunctionList) -> i64 {
  match functions {
    IrFunctionNil -> 0
    IrFunctionCons(f, rest) -> ir_function_inst_count(f) + ir_function_list_inst_count(rest)
  }
}

pub(package) fn ir_function_list_inst_count_for_source(functions: IrFunctionList, source: i64) -> i64 {
  match functions {
    IrFunctionNil -> 0
    IrFunctionCons(f, rest) -> {
      match f {
        IrFunction(name_hash, param_count, blocks, src) -> {
          let here = if src == source { ir_block_list_inst_count(blocks) } else { 0 }
          here + ir_function_list_inst_count_for_source(rest, source)
        }
      }
    }
  }
}

pub(package) fn ir_function_list_inst_counts(functions: IrFunctionList) -> List<i64> {
  match functions {
    IrFunctionNil -> list_nil<i64>()
    IrFunctionCons(f, rest) -> list_cons<i64>(ir_function_inst_count(f), ir_function_list_inst_counts(rest))
  }
}

pub(package) fn ir_metric_identity_i64(x: i64) -> i64 {
  x
}

pub(package) fn ir_metric_nonnegative_i64(x: i64) -> i64 {
  if x >= 0 { 1 } else { 0 }
}

pub(package) fn ir_metric_sum_i64(acc: i64, x: i64) -> i64 {
  acc + x
}

pub(package) fn ir_function_list_pipeline_inst_count(functions: IrFunctionList) -> i64 {
  let counts = ir_function_list_inst_counts(functions)
  counts |> list_map<i64, i64>(ir_metric_identity_i64) |> list_filter<i64>(ir_metric_nonnegative_i64) |> list_fold<i64, i64>(0, ir_metric_sum_i64)
}

pub(package) fn ir_function_list_block_count(functions: IrFunctionList) -> i64 {
  match functions {
    IrFunctionNil -> 0
    IrFunctionCons(f, rest) -> ir_function_block_count(f) + ir_function_list_block_count(rest)
  }
}

pub(package) fn ir_function_list_block_count_for_source(functions: IrFunctionList, source: i64) -> i64 {
  match functions {
    IrFunctionNil -> 0
    IrFunctionCons(f, rest) -> {
      match f {
        IrFunction(name_hash, param_count, blocks, src) -> {
          let here = if src == source { ir_block_list_len(blocks) } else { 0 }
          here + ir_function_list_block_count_for_source(rest, source)
        }
      }
    }
  }
}

