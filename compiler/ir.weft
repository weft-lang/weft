pub(package) fn ir_binary_op_add() -> IrBinaryOp {
  IrAdd
}

pub(package) fn ir_binary_op_mul() -> IrBinaryOp {
  IrMul
}

pub(package) fn ir_binary_op_eq() -> IrBinaryOp {
  IrEq
}

pub(package) fn ir_binary_op_ne() -> IrBinaryOp {
  IrNe
}

pub(package) fn ir_binary_op_tag(op: IrBinaryOp) -> i64 {
  match op {
    IrBinaryUnknown -> 0
    IrAdd -> 1
    IrSub -> 2
    IrMul -> 3
    IrDiv -> 4
    IrEq -> 5
    IrNe -> 6
    IrLt -> 7
    IrGt -> 8
    IrLe -> 9
    IrGe -> 10
    IrMod -> 11
    IrAnd -> 12
    IrOr -> 13
    IrBand -> 14
    IrBor -> 15
    IrBxor -> 16
    IrBshl -> 17
    IrBshr -> 18
  }
}

pub(package) fn ir_binary_op_from_parser(op_id: i64) -> IrBinaryOp {
  match op_id {
    1 -> IrAdd
    2 -> IrSub
    3 -> IrMul
    4 -> IrDiv
    5 -> IrEq
    6 -> IrNe
    7 -> IrLt
    8 -> IrGt
    9 -> IrLe
    10 -> IrGe
    11 -> IrMod
    12 -> IrAnd
    13 -> IrOr
    14 -> IrBand
    15 -> IrBor
    16 -> IrBxor
    17 -> IrBshl
    18 -> IrBshr
    _ -> IrBinaryUnknown
  }
}

pub(package) fn ir_binary_op_is_supported(op: IrBinaryOp) -> i64 {
  match op {
    IrBinaryUnknown -> 0
    _ -> 1
  }
}

pub(package) fn ir_unary_op_not() -> IrUnaryOp {
  IrNot
}

pub(package) fn ir_unary_op_tag(op: IrUnaryOp) -> i64 {
  match op {
    IrUnaryUnknown -> 0
    IrNot -> 1
  }
}

