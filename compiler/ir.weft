-- ══════════════════════════════════════════════════════════════
-- Type expressions
-- ══════════════════════════════════════════════════════════════

pub(package) type TypeExpr {
  TypeExpr(i64, i64, i64, TypeExprList), -- tag, immediate payload, semantic metadata, and typed child expressions
  MissingTypeExpr
}

pub(package) type TypeExprList {
  TypeExprListNil,
  TypeExprListCons(TypeExpr, TypeExprList)
}

pub(package) type EffectAtomList {
  EffectAtomListNil,
  EffectAtomListCons(i64, EffectAtomList)
}

pub(package) type EffectSig {
  EffectSig(EffectAtomList, i64), -- concrete effect hashes plus optional tail variable
  MissingEffectSig
}

pub(package) fn type_expr_immediate_payload(ty: i64, tag: i64) -> i64 {
  if tag == 2 { ty_f1(ty) }
  else { if tag == 7 { ty_record_open(ty) + 2 * ty_record_tuple_kind(ty) }
  else { if tag == 8 { ty_f1(ty) }
  else { if tag == 9 { ty_f1(ty) }
  else { if tag == 10 { ty_f2(ty) }
  else { if tag == 11 { ty_f1(ty) }
  else { if tag == 12 { ty_f1(ty) }
  else { if tag == 13 { ty_f1(ty) }
  else { if tag == 15 { ty_f2(ty) }
  else { if tag == 20 { ty_f1(ty) }
  else { if tag == 21 { ty_f2(ty) }
  else { if tag == 22 { ty_f2(ty) }
  else { if tag == 23 { ty_f2(ty) }
  else { if tag == 29 { ty_f2(ty) }
  else { if tag == 24 { ty_record_field_hash(ty) }
  else { if tag == 25 { ty_f1(ty) }
  else { 0 } } } } } } } } } } } } } } } }
}

pub(package) fn type_expr_list_append(left: TypeExprList, right: TypeExprList) -> TypeExprList {
  match left {
    TypeExprListNil -> right
    TypeExprListCons(ty, rest) -> TypeExprListCons(ty, type_expr_list_append(rest, right))
  }
}

pub(package) fn type_expr_list_one_node(ty: i64) -> TypeExprList {
  if raw_bridge_is_missing(ty) == 1 { TypeExprListNil }
  else { TypeExprListCons(type_expr_from_node(ty), TypeExprListNil) }
}

pub(package) fn type_expr_list_two_nodes(first: i64, second: i64) -> TypeExprList {
  type_expr_list_append(type_expr_list_one_node(first), type_expr_list_one_node(second))
}

pub(package) fn type_expr_list_from_record_fields(fields: i64, index: i64, count: i64) -> TypeExprList {
  if raw_bridge_is_missing(fields) == 1 { TypeExprListNil }
  else { if index >= count { TypeExprListNil }
  else {
    let field = nlist_get(fields, index)
    let child = TypeExpr(24, ty_record_field_hash(field), 0, type_expr_list_one_node(ty_record_field_type(field)))
    TypeExprListCons(child, type_expr_list_from_record_fields(fields, index + 1, count))
  } }
}

pub(package) fn type_expr_children_from_node(ty: i64, tag: i64) -> TypeExprList {
  match tag {
    3 -> type_expr_list_two_nodes(ty_f1(ty), ty_f2(ty))
    4 -> type_expr_list_two_nodes(ty_f1(ty), ty_f2(ty))
    5 -> type_expr_list_one_node(ty_f1(ty))
    6 -> type_expr_list_append(type_expr_list_from_type_nodes(ty_f1(ty)), type_expr_list_one_node(ty_f2(ty)))
    7 -> type_expr_list_from_record_fields(ty_record_fields(ty), 0, raw_bridge_list_len_or_zero(ty_record_fields(ty)))
    8 -> type_expr_list_one_node(ty_f2(ty))
    9 -> type_expr_list_append(type_expr_list_one_node(ty_f2(ty)), type_expr_list_from_type_nodes(ty_f3(ty)))
    10 -> type_expr_list_from_type_nodes(ty_f1(ty))
    11 -> type_expr_list_from_type_nodes(ty_f2(ty))
    14 -> type_expr_list_two_nodes(ty_f1(ty), ty_f2(ty))
    15 -> type_expr_list_one_node(ty_f1(ty))
    16 -> type_expr_list_one_node(ty_f1(ty))
    17 -> type_expr_list_one_node(ty_f1(ty))
    18 -> type_expr_list_one_node(ty_f1(ty))
    19 -> type_expr_list_one_node(ty_f1(ty))
    21 -> type_expr_list_one_node(ty_f1(ty))
    22 -> type_expr_list_one_node(ty_f1(ty))
    23 -> type_expr_list_one_node(ty_f1(ty))
    24 -> type_expr_list_one_node(ty_record_field_type(ty))
    25 -> type_expr_list_from_type_nodes(ty_f2(ty))
    29 -> type_expr_list_one_node(ty_f1(ty))
    _ -> TypeExprListNil
  }
}

pub(package) fn type_expr_from_node(ty: i64) -> TypeExpr {
  if raw_bridge_is_missing(ty) == 1 { MissingTypeExpr }
  else {
    let tag = ty_tag(ty)
    let metadata = if tag == 9 { ty_f4(ty) } else { 0 }
    TypeExpr(tag, type_expr_immediate_payload(ty, tag), metadata, type_expr_children_from_node(ty, tag))
  }
}

pub(package) fn effect_atom_hash_or(node: i64, default: i64) -> i64 {
  if raw_bridge_is_missing(node) == 1 { default }
  else {
    if ty_tag(node) == 11 or ty_tag(node) == 25 { effect_atom_head(node) } else { default }
  }
}

pub(package) fn effect_atom_list_from_nodes(nodes: i64, index: i64, count: i64) -> EffectAtomList {
  if raw_bridge_is_missing(nodes) == 1 { EffectAtomListNil }
  else { if index >= count { EffectAtomListNil }
  else {
    EffectAtomListCons(effect_atom_hash_or(nlist_get(nodes, index), 0), effect_atom_list_from_nodes(nodes, index + 1, count))
  } }
}

pub(package) fn effect_atom_list_from_type_nodes(nodes: i64) -> EffectAtomList {
  if raw_bridge_is_missing(nodes) == 1 { EffectAtomListNil }
  else { effect_atom_list_from_nodes(nodes, 0, raw_bridge_list_len_or_zero(nodes)) }
}

pub(package) fn effect_atom_list_len(atoms: EffectAtomList) -> i64 {
  match atoms {
    EffectAtomListNil -> 0
    EffectAtomListCons(hash, rest) -> 1 + effect_atom_list_len(rest)
  }
}

pub(package) fn effect_atom_list_contains_hash(atoms: EffectAtomList, target_hash: i64) -> i64 {
  match atoms {
    EffectAtomListNil -> 0
    EffectAtomListCons(hash, rest) -> if hash == target_hash { 1 } else { effect_atom_list_contains_hash(rest, target_hash) }
  }
}

pub(package) fn effect_sig_from_node(sig: i64) -> EffectSig {
  if raw_bridge_is_missing(sig) == 1 { MissingEffectSig }
  else {
    if ty_tag(sig) == 10 {
      EffectSig(effect_atom_list_from_type_nodes(ty_f1(sig)), ty_f2(sig))
    } else {
      MissingEffectSig
    }
  }
}

pub(package) fn effect_sig_count_or(sig: EffectSig, default: i64) -> i64 {
  match sig {
    EffectSig(effects, tail_var) -> effect_atom_list_len(effects)
    MissingEffectSig -> default
  }
}

pub(package) fn effect_sig_tail_var_or(sig: EffectSig, default: i64) -> i64 {
  match sig {
    EffectSig(effects, tail_var) -> tail_var
    MissingEffectSig -> default
  }
}

pub(package) fn effect_sig_is_closed_or(sig: EffectSig, default: i64) -> i64 {
  match sig {
    EffectSig(effects, tail_var) -> if tail_var == 0 { 1 } else { 0 }
    MissingEffectSig -> default
  }
}

pub(package) fn effect_sig_contains_hash(sig: EffectSig, target_hash: i64) -> i64 {
  match sig {
    EffectSig(effects, tail_var) -> effect_atom_list_contains_hash(effects, target_hash)
    MissingEffectSig -> 0
  }
}

pub(package) fn effect_atom_list_raw_bridge_slot_count(atoms: EffectAtomList) -> i64 {
  match atoms {
    EffectAtomListNil -> 0
    EffectAtomListCons(hash, rest) -> effect_atom_list_raw_bridge_slot_count(rest)
  }
}

pub(package) fn effect_sig_tree_raw_bridge_slot_count(sig: EffectSig) -> i64 {
  match sig {
    EffectSig(effects, tail_var) -> effect_atom_list_raw_bridge_slot_count(effects)
    MissingEffectSig -> 0
  }
}

pub(package) fn effect_sig_tree_unknown_count(sig: EffectSig) -> i64 {
  match sig {
    EffectSig(effects, tail_var) -> 0
    MissingEffectSig -> 1
  }
}

pub(package) fn type_expr_tag_or(ty: TypeExpr, default: i64) -> i64 {
  match ty {
    MissingTypeExpr -> default
    TypeExpr(tag, payload, metadata, children) -> tag
  }
}

pub(package) fn type_expr_prim_id_or(ty: TypeExpr, default: i64) -> i64 {
  match ty {
    MissingTypeExpr -> default
    TypeExpr(tag, payload, metadata, children) -> if tag == 2 { payload } else { default }
  }
}

pub(package) fn type_expr_children(ty: TypeExpr) -> TypeExprList {
  match ty {
    MissingTypeExpr -> TypeExprListNil
    TypeExpr(tag, payload, metadata, children) -> children
  }
}

pub(package) fn type_expr_child_count_or(ty: TypeExpr, default: i64) -> i64 {
  match ty {
    MissingTypeExpr -> default
    TypeExpr(tag, payload, metadata, children) -> type_expr_list_len(children)
  }
}

pub(package) fn type_expr_nth_child_tag_or(ty: TypeExpr, index: i64, default: i64) -> i64 {
  type_expr_list_nth_tag_or(type_expr_children(ty), index, default)
}

pub(package) fn type_expr_nth_child_prim_id_or(ty: TypeExpr, index: i64, default: i64) -> i64 {
  type_expr_list_nth_prim_id_or(type_expr_children(ty), index, default)
}

pub(package) fn type_expr_raw_bridge_slot_count(ty: TypeExpr) -> i64 {
  match ty {
    MissingTypeExpr -> 0
    TypeExpr(tag, payload, metadata, children) -> 0
  }
}

pub(package) fn type_expr_tree_raw_bridge_slot_count(ty: TypeExpr) -> i64 {
  match ty {
    MissingTypeExpr -> 0
    TypeExpr(tag, payload, metadata, children) -> type_expr_raw_bridge_slot_count(ty) + type_expr_list_tree_raw_bridge_slot_count(children)
  }
}

pub(package) fn type_expr_tree_unknown_count(ty: TypeExpr) -> i64 {
  match ty {
    MissingTypeExpr -> 1
    TypeExpr(tag, payload, metadata, children) -> type_expr_list_tree_unknown_count(children)
  }
}

pub(package) fn type_expr_list_empty() -> TypeExprList {
  TypeExprListNil
}

pub(package) fn type_expr_list_from_nodes(types: i64, index: i64, count: i64) -> TypeExprList {
  if raw_bridge_is_missing(types) == 1 { TypeExprListNil }
  else { if index >= count { TypeExprListNil }
  else {
    TypeExprListCons(type_expr_from_node(nlist_get(types, index)), type_expr_list_from_nodes(types, index + 1, count))
  } }
}

pub(package) fn type_expr_list_from_type_nodes(types: i64) -> TypeExprList {
  if raw_bridge_is_missing(types) == 1 { TypeExprListNil } else { type_expr_list_from_nodes(types, 0, raw_bridge_list_len_or_zero(types)) }
}

pub(package) fn expr_generic_type_args(expr: Expr) -> TypeExprList {
  match expr {
    GenericCall(type_args, inner_call) -> type_args
    _ -> TypeExprListNil
  }
}

pub(package) fn expr_generic_type_arg_count_or(expr: Expr, default: i64) -> i64 {
  match expr {
    GenericCall(type_args, inner_call) -> type_expr_list_len(type_args)
    _ -> default
  }
}

pub(package) fn type_expr_list_len(types: TypeExprList) -> i64 {
  match types {
    TypeExprListNil -> 0
    TypeExprListCons(ty, rest) -> 1 + type_expr_list_len(rest)
  }
}

pub(package) fn type_expr_list_nth_tag_or(types: TypeExprList, index: i64, default: i64) -> i64 {
  match types {
    TypeExprListNil -> default
    TypeExprListCons(ty, rest) -> {
      if index == 0 { type_expr_tag_or(ty, default) }
      else { type_expr_list_nth_tag_or(rest, index - 1, default) }
    }
  }
}

pub(package) fn type_expr_list_nth_prim_id_or(types: TypeExprList, index: i64, default: i64) -> i64 {
  match types {
    TypeExprListNil -> default
    TypeExprListCons(ty, rest) -> {
      if index == 0 { type_expr_prim_id_or(ty, default) }
      else { type_expr_list_nth_prim_id_or(rest, index - 1, default) }
    }
  }
}

pub(package) fn type_expr_list_count_tag(types: TypeExprList, tag: i64) -> i64 {
  match types {
    TypeExprListNil -> 0
    TypeExprListCons(ty, rest) -> {
      let add = if type_expr_tag_or(ty, 0 - 1) == tag { 1 } else { 0 }
      add + type_expr_list_count_tag(rest, tag)
    }
  }
}

pub(package) fn type_expr_list_raw_bridge_slot_count(types: TypeExprList) -> i64 {
  match types {
    TypeExprListNil -> 0
    TypeExprListCons(ty, rest) -> type_expr_raw_bridge_slot_count(ty) + type_expr_list_raw_bridge_slot_count(rest)
  }
}

pub(package) fn type_expr_list_tree_unknown_count(types: TypeExprList) -> i64 {
  match types {
    TypeExprListNil -> 0
    TypeExprListCons(ty, rest) -> type_expr_tree_unknown_count(ty) + type_expr_list_tree_unknown_count(rest)
  }
}

pub(package) fn type_expr_list_tree_raw_bridge_slot_count(types: TypeExprList) -> i64 {
  match types {
    TypeExprListNil -> 0
    TypeExprListCons(ty, rest) -> type_expr_tree_raw_bridge_slot_count(ty) + type_expr_list_tree_raw_bridge_slot_count(rest)
  }
}

-- ══════════════════════════════════════════════════════════════
-- Type table entries
-- ══════════════════════════════════════════════════════════════

pub(package) type TypeEntry {
  TypeRecordEntry(TypeEntryName, TypeParamList, TypeRecordFieldList),
  TypeVariantEntry(TypeEntryName, TypeParamList, TypeVariantList),
  TypeEffectEntry(TypeEntryName, TypeParamList, TypeEffectOpList),
  TypeTraitEntry(TypeEntryName, TypeParamList, TypeTraitMemberList),
  TypeImplEntry(TypeEntryName, TypeParamList, TypeImplMemberList),
  TypeOpaqueEntry(TypeEntryName, TypeParamList),
  MissingTypeEntry
}

pub(package) type TypeEntryName {
  TypeEntryName(i64, i64, i64),
  MissingTypeEntryName
}

pub(package) type TypeEntryList {
  TypeEntryListNil,
  TypeEntryListCons(TypeEntry, TypeEntryList)
}

pub(package) fn type_entry_from_ptr(entry: i64) -> TypeEntry {
  if raw_bridge_is_missing(entry) == 1 { MissingTypeEntry }
  else {
    let ns = types_storage_type_entry_name_start(entry)
    let nl = types_storage_type_entry_name_len(entry)
    let kind = types_storage_type_entry_kind(entry)
    let count = types_storage_type_entry_payload_count(entry)
    let payload = types_storage_type_entry_payload(entry)
    let name = TypeEntryName(ns, nl, types_storage_type_entry_source(entry))
    let tparams = type_entry_type_param_list_from_raw(kind, types_storage_type_entry_type_params(entry))
    match kind {
      0 -> TypeRecordEntry(name, tparams, type_record_field_list_from_array(payload, 0, count))
      1 -> TypeVariantEntry(name, tparams, type_variant_list_from_array(payload, 0, count))
      2 -> TypeEffectEntry(name, tparams, type_effect_op_list_from_nodes(payload, 0, count))
      3 -> TypeTraitEntry(name, tparams, type_trait_member_list_from_nodes(payload, 0, count))
      4 -> TypeImplEntry(name, tparams, type_impl_member_list_from_nodes(payload, 0, count))
      5 -> TypeOpaqueEntry(name, tparams)
      _ -> MissingTypeEntry
    }
  }
}

pub(package) fn type_entry_name_start_from_info_or(name: TypeEntryName, default: i64) -> i64 {
  match name {
    TypeEntryName(ns, nl, src) -> ns
    MissingTypeEntryName -> default
  }
}

pub(package) fn type_entry_name_len_from_info_or(name: TypeEntryName, default: i64) -> i64 {
  match name {
    TypeEntryName(ns, nl, src) -> nl
    MissingTypeEntryName -> default
  }
}

pub(package) fn type_entry_source_from_info_or(name: TypeEntryName, default: i64) -> i64 {
  match name {
    TypeEntryName(ns, nl, src) -> src
    MissingTypeEntryName -> default
  }
}

pub(package) fn type_entry_kind_or(entry: TypeEntry, default: i64) -> i64 {
  match entry {
    TypeRecordEntry(name, tparams, fields) -> 0
    TypeVariantEntry(name, tparams, variants) -> 1
    TypeEffectEntry(name, tparams, ops) -> 2
    TypeTraitEntry(name, tparams, members) -> 3
    TypeImplEntry(name, tparams, members) -> 4
    TypeOpaqueEntry(name, tparams) -> 5
    MissingTypeEntry -> default
  }
}

pub(package) fn type_entry_name_len_or(entry: TypeEntry, default: i64) -> i64 {
  match entry {
    TypeRecordEntry(name, tparams, fields) -> type_entry_name_len_from_info_or(name, default)
    TypeVariantEntry(name, tparams, variants) -> type_entry_name_len_from_info_or(name, default)
    TypeEffectEntry(name, tparams, ops) -> type_entry_name_len_from_info_or(name, default)
    TypeTraitEntry(name, tparams, members) -> type_entry_name_len_from_info_or(name, default)
    TypeImplEntry(name, tparams, members) -> type_entry_name_len_from_info_or(name, default)
    TypeOpaqueEntry(name, tparams) -> type_entry_name_len_from_info_or(name, default)
    MissingTypeEntry -> default
  }
}

pub(package) fn type_entry_name_start_or(entry: TypeEntry, default: i64) -> i64 {
  match entry {
    TypeRecordEntry(name, tparams, fields) -> type_entry_name_start_from_info_or(name, default)
    TypeVariantEntry(name, tparams, variants) -> type_entry_name_start_from_info_or(name, default)
    TypeEffectEntry(name, tparams, ops) -> type_entry_name_start_from_info_or(name, default)
    TypeTraitEntry(name, tparams, members) -> type_entry_name_start_from_info_or(name, default)
    TypeImplEntry(name, tparams, members) -> type_entry_name_start_from_info_or(name, default)
    TypeOpaqueEntry(name, tparams) -> type_entry_name_start_from_info_or(name, default)
    MissingTypeEntry -> default
  }
}

pub(package) fn type_entry_source_or(entry: TypeEntry, default: i64) -> i64 {
  match entry {
    TypeRecordEntry(name, tparams, fields) -> type_entry_source_from_info_or(name, default)
    TypeVariantEntry(name, tparams, variants) -> type_entry_source_from_info_or(name, default)
    TypeEffectEntry(name, tparams, ops) -> type_entry_source_from_info_or(name, default)
    TypeTraitEntry(name, tparams, members) -> type_entry_source_from_info_or(name, default)
    TypeImplEntry(name, tparams, members) -> type_entry_source_from_info_or(name, default)
    TypeOpaqueEntry(name, tparams) -> type_entry_source_from_info_or(name, default)
    MissingTypeEntry -> default
  }
}

pub(package) fn type_entry_item_count_or(entry: TypeEntry, default: i64) -> i64 {
  match entry {
    TypeRecordEntry(name, tparams, fields) -> type_record_field_list_len(fields)
    TypeVariantEntry(name, tparams, variants) -> type_variant_list_len(variants)
    TypeEffectEntry(name, tparams, ops) -> type_effect_op_list_len(ops)
    TypeTraitEntry(name, tparams, members) -> type_trait_member_list_len(members)
    TypeImplEntry(name, tparams, members) -> type_impl_member_list_len(members)
    TypeOpaqueEntry(name, tparams) -> 0
    MissingTypeEntry -> default
  }
}

pub(package) fn type_entry_raw_bridge_slot_count(entry: TypeEntry) -> i64 {
  match entry {
    TypeRecordEntry(name, tparams, fields) -> 0
    TypeVariantEntry(name, tparams, variants) -> 0
    TypeEffectEntry(name, tparams, ops) -> 0
    TypeTraitEntry(name, tparams, members) -> 0
    TypeImplEntry(name, tparams, members) -> 0
    TypeOpaqueEntry(name, tparams) -> 0
    MissingTypeEntry -> 0
  }
}

pub(package) fn type_entry_unknown_count(entry: TypeEntry) -> i64 {
  match entry {
    MissingTypeEntry -> 1
    _ -> 0
  }
}

pub(package) fn type_entry_type_param_count_or(entry: TypeEntry, default: i64) -> i64 {
  match entry {
    TypeRecordEntry(name, tparams, fields) -> type_param_list_len(tparams)
    TypeVariantEntry(name, tparams, variants) -> type_param_list_len(tparams)
    TypeEffectEntry(name, tparams, ops) -> type_param_list_len(tparams)
    TypeTraitEntry(name, tparams, members) -> type_param_list_len(tparams)
    TypeImplEntry(name, tparams, members) -> type_param_list_len(tparams)
    TypeOpaqueEntry(name, tparams) -> type_param_list_len(tparams)
    MissingTypeEntry -> default
  }
}

pub(package) fn type_entry_list_empty() -> TypeEntryList {
  TypeEntryListNil
}

pub(package) fn type_entry_list_from_table(tt: i64, index: i64, count: i64) -> TypeEntryList {
  if index >= count { TypeEntryListNil }
  else {
    TypeEntryListCons(type_entry_from_ptr(types_storage_type_table_entry(tt, index)), type_entry_list_from_table(tt, index + 1, count))
  }
}

pub(package) fn type_entries_from_table(tt: i64) -> TypeEntryList {
  if raw_bridge_is_missing(tt) == 1 { TypeEntryListNil }
  else { type_entry_list_from_table(tt, 0, types_storage_type_table_count(tt)) }
}

pub(package) fn type_entry_list_from_table_source(tt: i64, index: i64, count: i64, src: i64) -> TypeEntryList {
  if index >= count { TypeEntryListNil }
  else {
    let entry = type_entry_from_ptr(types_storage_type_table_entry(tt, index))
    let rest = type_entry_list_from_table_source(tt, index + 1, count, src)
    if type_entry_source_or(entry, -1) == src { TypeEntryListCons(entry, rest) } else { rest }
  }
}

-- Stable AST/typed-module views describe the submitted root. Imported module
-- catalogs remain available to compiler internals through the full-table API.
pub(package) fn type_entries_from_table_source(tt: i64, src: i64) -> TypeEntryList {
  if raw_bridge_is_missing(tt) == 1 { TypeEntryListNil }
  else { type_entry_list_from_table_source(tt, 0, types_storage_type_table_count(tt), src) }
}

pub(package) fn type_entry_list_nth(entries: TypeEntryList, index: i64) -> TypeEntry {
  match entries {
    TypeEntryListNil -> MissingTypeEntry
    TypeEntryListCons(entry, rest) -> {
      if index == 0 { entry } else { type_entry_list_nth(rest, index - 1) }
    }
  }
}

pub(package) fn type_entry_list_len(entries: TypeEntryList) -> i64 {
  match entries {
    TypeEntryListNil -> 0
    TypeEntryListCons(entry, rest) -> 1 + type_entry_list_len(rest)
  }
}

pub(package) fn type_entry_list_count_kind(entries: TypeEntryList, kind: i64) -> i64 {
  match entries {
    TypeEntryListNil -> 0
    TypeEntryListCons(entry, rest) -> {
      let add = if type_entry_kind_or(entry, 0 - 1) == kind { 1 } else { 0 }
      add + type_entry_list_count_kind(rest, kind)
    }
  }
}

pub(package) fn type_entry_list_nth_kind_or(entries: TypeEntryList, index: i64, default: i64) -> i64 {
  match entries {
    TypeEntryListNil -> default
    TypeEntryListCons(entry, rest) -> {
      if index == 0 { type_entry_kind_or(entry, default) }
      else { type_entry_list_nth_kind_or(rest, index - 1, default) }
    }
  }
}

pub(package) fn type_entry_list_nth_name_len_or(entries: TypeEntryList, index: i64, default: i64) -> i64 {
  match entries {
    TypeEntryListNil -> default
    TypeEntryListCons(entry, rest) -> {
      if index == 0 { type_entry_name_len_or(entry, default) }
      else { type_entry_list_nth_name_len_or(rest, index - 1, default) }
    }
  }
}

pub(package) fn type_entry_list_nth_item_count_or(entries: TypeEntryList, index: i64, default: i64) -> i64 {
  match entries {
    TypeEntryListNil -> default
    TypeEntryListCons(entry, rest) -> {
      if index == 0 { type_entry_item_count_or(entry, default) }
      else { type_entry_list_nth_item_count_or(rest, index - 1, default) }
    }
  }
}

pub(package) fn type_entry_list_nth_type_param_count_or(entries: TypeEntryList, index: i64, default: i64) -> i64 {
  match entries {
    TypeEntryListNil -> default
    TypeEntryListCons(entry, rest) -> {
      if index == 0 { type_entry_type_param_count_or(entry, default) }
      else { type_entry_list_nth_type_param_count_or(rest, index - 1, default) }
    }
  }
}

pub(package) fn type_entry_list_raw_bridge_slot_count(entries: TypeEntryList) -> i64 {
  match entries {
    TypeEntryListNil -> 0
    TypeEntryListCons(entry, rest) -> type_entry_raw_bridge_slot_count(entry) + type_entry_list_raw_bridge_slot_count(rest)
  }
}

pub(package) fn type_entry_list_tree_unknown_count(entries: TypeEntryList) -> i64 {
  match entries {
    TypeEntryListNil -> 0
    TypeEntryListCons(entry, rest) -> type_entry_tree_unknown_count(entry) + type_entry_list_tree_unknown_count(rest)
  }
}

pub(package) type TypeParam {
  TypeParam(i64, i64, i64, TypeParamBoundList),  -- tag 2: f1=name_ns, f2=name_nl, f3=var_id, typed f4=bounds
  MissingTypeParam
}

pub(package) type TypeParamBoundList {
  TypeParamBoundListNil,
  TypeParamBoundListCons(i64, TypeParamBoundList)
}

pub(package) type TypeParamList {
  TypeParamListNil,
  TypeParamListCons(TypeParam, TypeParamList)
}

pub(package) fn type_param_bound_list_empty() -> TypeParamBoundList {
  TypeParamBoundListNil
}

pub(package) fn type_param_bound_list_from_hashes(bounds: i64, index: i64, count: i64) -> TypeParamBoundList {
  if index >= count { TypeParamBoundListNil }
  else {
    TypeParamBoundListCons(nlist_get(bounds, index), type_param_bound_list_from_hashes(bounds, index + 1, count))
  }
}

pub(package) fn type_param_bound_list_from_raw(bounds: i64) -> TypeParamBoundList {
  if raw_bridge_is_missing(bounds) == 1 { TypeParamBoundListNil }
  else { type_param_bound_list_from_hashes(bounds, 0, raw_bridge_list_len_or_zero(bounds)) }
}

pub(package) fn type_param_bound_list_len(bounds: TypeParamBoundList) -> i64 {
  match bounds {
    TypeParamBoundListNil -> 0
    TypeParamBoundListCons(hash, rest) -> 1 + type_param_bound_list_len(rest)
  }
}

pub(package) fn type_param_bound_list_nth_hash_or(bounds: TypeParamBoundList, index: i64, default: i64) -> i64 {
  match bounds {
    TypeParamBoundListNil -> default
    TypeParamBoundListCons(hash, rest) -> {
      if index == 0 { trait_atom_head(hash) } else { type_param_bound_list_nth_hash_or(rest, index - 1, default) }
    }
  }
}

pub(package) fn type_param_list_empty() -> TypeParamList {
  TypeParamListNil
}

pub(package) fn type_param_from_node(node: i64) -> TypeParam {
  if raw_bridge_is_missing(node) == 1 { MissingTypeParam }
  else {
    match node_tag(node) {
      2 -> TypeParam(node_f1(node), node_f2(node), node_f3(node), type_param_bound_list_from_raw(node_f4(node)))
      _ -> MissingTypeParam
    }
  }
}

pub(package) fn type_param_list_from_nodes(nodes: i64, index: i64, count: i64) -> TypeParamList {
  if raw_bridge_is_missing(nodes) == 1 { TypeParamListNil }
  else { if index >= count { TypeParamListNil }
  else {
    TypeParamListCons(type_param_from_node(nlist_get(nodes, index)), type_param_list_from_nodes(nodes, index + 1, count))
  } }
}

pub(package) fn type_param_list_from_type_param_nodes(params: i64) -> TypeParamList {
  if raw_bridge_is_missing(params) == 1 { TypeParamListNil } else { type_param_list_from_nodes(params, 0, raw_bridge_list_len_or_zero(params)) }
}

pub(package) fn type_entry_type_param_list_from_raw(kind: i64, params: i64) -> TypeParamList {
  if kind == 4 {
    if raw_bridge_is_missing(params) == 1 { TypeParamListNil } else { type_param_list_from_type_param_nodes(node_f2(params)) }
  } else {
    type_param_list_from_type_param_nodes(params)
  }
}

pub(package) fn type_entry_type_params(entry: TypeEntry) -> TypeParamList {
  match entry {
    TypeRecordEntry(name, tparams, fields) -> tparams
    TypeVariantEntry(name, tparams, variants) -> tparams
    TypeEffectEntry(name, tparams, ops) -> tparams
    TypeTraitEntry(name, tparams, members) -> tparams
    TypeImplEntry(name, tparams, members) -> tparams
    TypeOpaqueEntry(name, tparams) -> tparams
    MissingTypeEntry -> TypeParamListNil
  }
}

