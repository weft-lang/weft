fn ir_value_list_empty() -> IrValueList {
  IrValueNil
}

fn ir_value_list_prepend(value: i64, rest: IrValueList) -> IrValueList {
  IrValueCons(value, rest)
}

fn ir_value_list_append(left: IrValueList, right: IrValueList) -> IrValueList {
  match left {
    IrValueNil -> right
    IrValueCons(value, rest) -> IrValueCons(value, ir_value_list_append(rest, right))
  }
}

fn ir_value_list_len(values: IrValueList) -> i64 {
  match values {
    IrValueNil -> 0
    IrValueCons(value, rest) -> 1 + ir_value_list_len(rest)
  }
}

fn ir_record_field_list_empty() -> IrRecordFieldList {
  IrRecordFieldNil
}

fn ir_record_field_list_prepend(field_hash: i64, value: i64, rest: IrRecordFieldList) -> IrRecordFieldList {
  IrRecordFieldCons(field_hash, value, rest)
}

fn ir_record_field_list_append(left: IrRecordFieldList, right: IrRecordFieldList) -> IrRecordFieldList {
  match left {
    IrRecordFieldNil -> right
    IrRecordFieldCons(field_hash, value, rest) -> IrRecordFieldCons(field_hash, value, ir_record_field_list_append(rest, right))
  }
}

fn ir_record_field_list_len(fields: IrRecordFieldList) -> i64 {
  match fields {
    IrRecordFieldNil -> 0
    IrRecordFieldCons(field_hash, value, rest) -> 1 + ir_record_field_list_len(rest)
  }
}

fn ir_inst_list_empty() -> IrInstList {
  IrInstNil
}

fn ir_inst_list_prepend(inst: IrInst, rest: IrInstList) -> IrInstList {
  IrInstCons(inst, rest)
}

fn ir_inst_list_append(left: IrInstList, right: IrInstList) -> IrInstList {
  match left {
    IrInstNil -> right
    IrInstCons(inst, rest) -> IrInstCons(inst, ir_inst_list_append(rest, right))
  }
}

fn ir_inst_list_len(insts: IrInstList) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> 1 + ir_inst_list_len(rest)
  }
}

fn ir_inst_list_count_tag(insts: IrInstList, tag: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let add = if ir_inst_tag(inst) == tag { 1 } else { 0 }
      add + ir_inst_list_count_tag(rest, tag)
    }
  }
}

fn ir_inst_count_binary_op(inst: IrInst, op_tag: i64) -> i64 {
  match inst {
    IrConstI64(dst, value) -> 0
    IrStringLit(dst, start, len) -> 0
    IrStringConcatI64(dst, left, right) -> 0
    IrBinaryI64(dst, op, lhs, rhs) -> if ir_binary_op_tag(op) == op_tag { 1 } else { 0 }
    IrUnaryI64(dst, op, value) -> 0
    IrLambdaI64(dst, params, body, nparams) -> 0
    IrPerformI64(dst, effect_hash, op_hash, args) -> 0
    IrHandleI64(dst, body, clauses, nclauses) -> 0
    IrResumeI64(dst, value) -> 0
    IrTryI64(dst, value) -> 0
    IrCallI64(dst, callee_hash, args) -> 0
    IrIndirectCallI64(dst, callee, args) -> 0
    IrGenericCallI64(dst, callee_hash, type_args, args) -> 0
    IrMethodCallI64(dst, type_hash, method_hash, receiver, args) -> 0
    IrVariantInitI64(dst, tag_hash, payloads) -> 0
    IrVariantTagI64(dst, base) -> 0
    IrVariantPayloadI64(dst, base, index) -> 0
    IrRecordInitI64(dst, type_hash, fields) -> 0
    IrFieldLoadI64(dst, base, field_hash, field_index) -> 0
    IrSlotI64(slot) -> 0
    IrLoadI64(dst, slot) -> 0
    IrStoreI64(slot, value) -> 0
  }
}

fn ir_inst_count_unary_op(inst: IrInst, op_tag: i64) -> i64 {
  match inst {
    IrConstI64(dst, value) -> 0
    IrStringLit(dst, start, len) -> 0
    IrStringConcatI64(dst, left, right) -> 0
    IrBinaryI64(dst, op, lhs, rhs) -> 0
    IrUnaryI64(dst, op, value) -> if ir_unary_op_tag(op) == op_tag { 1 } else { 0 }
    IrLambdaI64(dst, params, body, nparams) -> 0
    IrPerformI64(dst, effect_hash, op_hash, args) -> 0
    IrHandleI64(dst, body, clauses, nclauses) -> 0
    IrResumeI64(dst, value) -> 0
    IrTryI64(dst, value) -> 0
    IrCallI64(dst, callee_hash, args) -> 0
    IrIndirectCallI64(dst, callee, args) -> 0
    IrGenericCallI64(dst, callee_hash, type_args, args) -> 0
    IrMethodCallI64(dst, type_hash, method_hash, receiver, args) -> 0
    IrVariantInitI64(dst, tag_hash, payloads) -> 0
    IrVariantTagI64(dst, base) -> 0
    IrVariantPayloadI64(dst, base, index) -> 0
    IrRecordInitI64(dst, type_hash, fields) -> 0
    IrFieldLoadI64(dst, base, field_hash, field_index) -> 0
    IrSlotI64(slot) -> 0
    IrLoadI64(dst, slot) -> 0
    IrStoreI64(slot, value) -> 0
  }
}

fn ir_inst_list_count_binary_op(insts: IrInstList, op: IrBinaryOp) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      ir_inst_count_binary_op(inst, ir_binary_op_tag(op)) + ir_inst_list_count_binary_op(rest, op)
    }
  }
}

fn ir_inst_list_count_unary_op(insts: IrInstList, op: IrUnaryOp) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      ir_inst_count_unary_op(inst, ir_unary_op_tag(op)) + ir_inst_list_count_unary_op(rest, op)
    }
  }
}

fn ir_inst_list_first_tag(insts: IrInstList) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> ir_inst_tag(inst)
  }
}

fn ir_inst_list_first_const_value_or(insts: IrInstList, default: i64) -> i64 {
  match insts {
    IrInstNil -> default
    IrInstCons(inst, rest) -> ir_inst_const_value_or(inst, default)
  }
}

fn ir_inst_list_first_string_len_or(insts: IrInstList, default: i64) -> i64 {
  match insts {
    IrInstNil -> default
    IrInstCons(inst, rest) -> {
      let n = ir_inst_string_len_or(inst, default)
      if n == default { ir_inst_list_first_string_len_or(rest, default) } else { n }
    }
  }
}

