      types_storage_record_field_name_start(fields, index),
      types_storage_record_field_name_len(fields, index),
      type_expr_from_node(types_storage_record_field_type_node(fields, index))
    )
    TypeRecordFieldListCons(field, type_record_field_list_from_array(fields, index + 1, count))
  }
}

