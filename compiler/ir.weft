pub(package) fn ir_value_list_empty() -> IrValueList {
  IrValueNil
}

pub(package) fn ir_value_list_prepend(value: i64, rest: IrValueList) -> IrValueList {
  IrValueCons(value, rest)
}

pub(package) fn ir_value_list_append(left: IrValueList, right: IrValueList) -> IrValueList {
  match left {
    IrValueNil -> right
    IrValueCons(value, rest) -> IrValueCons(value, ir_value_list_append(rest, right))
  }
}

pub(package) fn ir_value_list_len(values: IrValueList) -> i64 {
  match values {
    IrValueNil -> 0
    IrValueCons(value, rest) -> 1 + ir_value_list_len(rest)
  }
}

pub(package) fn ir_value_list_nth_or(values: IrValueList, index: i64, default: i64) -> i64 {
  match values {
    IrValueNil -> default
    IrValueCons(value, rest) -> if index == 0 { value } else { ir_value_list_nth_or(rest, index - 1, default) }
  }
}

pub(package) fn ir_value_list_contains(values: IrValueList, target: i64) -> i64 {
  match values {
    IrValueNil -> 0
    IrValueCons(value, rest) -> if value == target { 1 } else { ir_value_list_contains(rest, target) }
  }
}

pub(package) fn ir_value_list_all_unique(values: IrValueList) -> i64 {
  match values {
    IrValueNil -> 1
    IrValueCons(value, rest) -> {
      if ir_value_list_contains(rest, value) == 1 { 0 } else { ir_value_list_all_unique(rest) }
    }
  }
}

pub(package) fn ir_value_list_add_unique(values: IrValueList, value: i64) -> IrValueList {
  if ir_value_list_contains(values, value) == 1 { values }
  else { IrValueCons(value, values) }
}

pub(package) fn ir_value_list_union(left: IrValueList, right: IrValueList) -> IrValueList {
  match left {
    IrValueNil -> right
    IrValueCons(value, rest) -> ir_value_list_add_unique(ir_value_list_union(rest, right), value)
  }
}

pub(package) fn ir_value_list_subset(left: IrValueList, right: IrValueList) -> i64 {
  match left {
    IrValueNil -> 1
    IrValueCons(value, rest) -> {
      if ir_value_list_contains(right, value) != 1 { 0 } else { ir_value_list_subset(rest, right) }
    }
  }
}

pub(package) fn ir_value_list_set_eq(left: IrValueList, right: IrValueList) -> i64 {
  if ir_value_list_len(left) != ir_value_list_len(right) { 0 }
  else { ir_value_list_subset(left, right) }
}

pub(package) fn ir_borrow_owner_parameter(index: i64) -> IrBorrowOwner {
  IrBorrowOwnerParameter(index)
}

pub(package) fn ir_borrow_owner_value(value: i64) -> IrBorrowOwner {
  IrBorrowOwnerValue(value)
}

pub(package) fn ir_borrow_owner_unknown() -> IrBorrowOwner {
  IrBorrowOwnerUnknown
}

pub(package) fn ir_borrow_owner_parameter_index_or(owner: IrBorrowOwner, default: i64) -> i64 {
  match owner {
    IrBorrowOwnerParameter(index) -> index
    _ -> default
  }
}

pub(package) fn ir_borrow_owner_value_or(owner: IrBorrowOwner, default: i64) -> i64 {
  match owner {
    IrBorrowOwnerValue(value) -> value
    _ -> default
  }
}

pub(package) fn ir_borrow_owner_is_unknown(owner: IrBorrowOwner) -> i64 {
  match owner {
    IrBorrowOwnerUnknown -> 1
    _ -> 0
  }
}

pub(package) fn ir_borrow_origin(owner: IrBorrowOwner, start: i64, len: i64, mutable: i64) -> IrBorrowOrigin {
  IrBorrowOrigin(owner, start, len, mutable)
}

pub(package) fn ir_borrow_origin_start(origin: IrBorrowOrigin) -> i64 {
  match origin { IrBorrowOrigin(owner, start, len, mutable) -> start }
}

pub(package) fn ir_borrow_origin_len(origin: IrBorrowOrigin) -> i64 {
  match origin { IrBorrowOrigin(owner, start, len, mutable) -> len }
}

pub(package) fn ir_borrow_origin_mutable(origin: IrBorrowOrigin) -> i64 {
  match origin { IrBorrowOrigin(owner, start, len, mutable) -> mutable }
}

pub(package) fn ir_borrow_origin_owner(origin: IrBorrowOrigin) -> IrBorrowOwner {
  match origin { IrBorrowOrigin(owner, start, len, mutable) -> owner }
}

pub(package) fn ir_borrow_origin_list_empty() -> IrBorrowOriginList {
  IrBorrowOriginNil
}

pub(package) fn ir_borrow_origin_list_prepend(origin: IrBorrowOrigin, rest: IrBorrowOriginList) -> IrBorrowOriginList {
  IrBorrowOriginCons(origin, rest)
}

pub(package) fn ir_borrow_origin_list_len(origins: IrBorrowOriginList) -> i64 {
  match origins {
    IrBorrowOriginNil -> 0
    IrBorrowOriginCons(origin, rest) -> 1 + ir_borrow_origin_list_len(rest)
  }
}

pub(package) fn ir_borrow_owner_eq(left: IrBorrowOwner, right: IrBorrowOwner) -> i64 {
  match left {
    IrBorrowOwnerParameter(left_index) -> match right { IrBorrowOwnerParameter(right_index) -> if left_index == right_index { 1 } else { 0 } _ -> 0 }
    IrBorrowOwnerValue(left_value) -> match right { IrBorrowOwnerValue(right_value) -> if left_value == right_value { 1 } else { 0 } _ -> 0 }
    IrBorrowOwnerUnknown -> match right { IrBorrowOwnerUnknown -> 1 _ -> 0 }
  }
}

pub(package) fn ir_borrow_origin_eq(left: IrBorrowOrigin, right: IrBorrowOrigin) -> i64 {
  match left {
    IrBorrowOrigin(left_owner, left_start, left_len, left_mutable) -> {
      match right {
        IrBorrowOrigin(right_owner, right_start, right_len, right_mutable) -> {
          if ir_borrow_owner_eq(left_owner, right_owner) == 1 and left_start == right_start and left_len == right_len and left_mutable == right_mutable { 1 } else { 0 }
        }
      }
    }
  }
}

pub(package) fn ir_borrow_origin_list_contains(origins: IrBorrowOriginList, target: IrBorrowOrigin) -> i64 {
  match origins {
    IrBorrowOriginNil -> 0
    IrBorrowOriginCons(origin, rest) -> if ir_borrow_origin_eq(origin, target) == 1 { 1 } else { ir_borrow_origin_list_contains(rest, target) }
  }
}

pub(package) fn ir_borrow_origin_list_add_unique(origins: IrBorrowOriginList, origin: IrBorrowOrigin) -> IrBorrowOriginList {
  if ir_borrow_origin_list_contains(origins, origin) == 1 { origins }
  else { IrBorrowOriginCons(origin, origins) }
}

pub(package) fn ir_borrow_origin_list_union(incoming: IrBorrowOriginList, current: IrBorrowOriginList) -> IrBorrowOriginList {
  match incoming {
    IrBorrowOriginNil -> current
    IrBorrowOriginCons(origin, rest) -> ir_borrow_origin_list_add_unique(ir_borrow_origin_list_union(rest, current), origin)
  }
}

pub(package) fn ir_borrow_origin_rebase_mutable(origin: IrBorrowOrigin, head: i64, mutable: i64) -> IrBorrowOrigin {
  match origin {
    IrBorrowOrigin(owner, start, len, origin_mutable) -> IrBorrowOrigin(owner, head, head + 1, if mutable < 0 { origin_mutable } else { mutable })
  }
}

pub(package) fn ir_borrow_origin_rebase(origin: IrBorrowOrigin, head: i64) -> IrBorrowOrigin {
  ir_borrow_origin_rebase_mutable(origin, head, 0 - 1)
}

pub(package) fn ir_borrow_origin_list_union_rebased_mutable(incoming: IrBorrowOriginList, current: IrBorrowOriginList, head: i64, mutable: i64) -> IrBorrowOriginList {
  match incoming {
    IrBorrowOriginNil -> current
    IrBorrowOriginCons(origin, rest) -> {
      ir_borrow_origin_list_add_unique(ir_borrow_origin_list_union_rebased_mutable(rest, current, head, mutable), ir_borrow_origin_rebase_mutable(origin, head, mutable))
    }
  }
}

pub(package) fn ir_borrow_origin_list_union_rebased(incoming: IrBorrowOriginList, current: IrBorrowOriginList, head: i64) -> IrBorrowOriginList {
  ir_borrow_origin_list_union_rebased_mutable(incoming, current, head, 0 - 1)
}

pub(package) fn ir_borrow_origin_list_subset(left: IrBorrowOriginList, right: IrBorrowOriginList) -> i64 {
  match left {
    IrBorrowOriginNil -> 1
    IrBorrowOriginCons(origin, rest) -> {
      if ir_borrow_origin_list_contains(right, origin) != 1 { 0 } else { ir_borrow_origin_list_subset(rest, right) }
    }
  }
}

pub(package) fn ir_borrow_origin_list_set_eq(left: IrBorrowOriginList, right: IrBorrowOriginList) -> i64 {
  if ir_borrow_origin_list_len(left) != ir_borrow_origin_list_len(right) { 0 }
  else { ir_borrow_origin_list_subset(left, right) }
}

pub(package) fn ir_borrow_origin_list_rebased_contained(incoming: IrBorrowOriginList, current: IrBorrowOriginList, head: i64) -> i64 {
  match incoming {
    IrBorrowOriginNil -> 1
    IrBorrowOriginCons(origin, rest) -> {
      if ir_borrow_origin_list_contains(current, ir_borrow_origin_rebase(origin, head)) != 1 { 0 }
      else { ir_borrow_origin_list_rebased_contained(rest, current, head) }
    }
  }
}

pub(package) fn ir_borrow_origin_list_contains_parameter(origins: IrBorrowOriginList, index: i64) -> i64 {
  match origins {
    IrBorrowOriginNil -> 0
    IrBorrowOriginCons(origin, rest) -> {
      if ir_borrow_owner_parameter_index_or(ir_borrow_origin_owner(origin), 0 - 1) == index { 1 }
      else { ir_borrow_origin_list_contains_parameter(rest, index) }
    }
  }
}

pub(package) fn ir_borrow_origin_list_contains_unknown(origins: IrBorrowOriginList) -> i64 {
  match origins {
    IrBorrowOriginNil -> 0
    IrBorrowOriginCons(origin, rest) -> {
      if ir_borrow_owner_is_unknown(ir_borrow_origin_owner(origin)) == 1 { 1 }
      else { ir_borrow_origin_list_contains_unknown(rest) }
    }
  }
}

pub(package) fn ir_borrow_value_facts_empty() -> IrBorrowValueFactList {
  IrBorrowValueFactNil
}

pub(package) fn ir_borrow_value_facts_prepend(value: i64, origins: IrBorrowOriginList, rest: IrBorrowValueFactList) -> IrBorrowValueFactList {
  IrBorrowValueFactCons(value, origins, rest)
}

pub(package) fn ir_borrow_value_facts_find(facts: IrBorrowValueFactList, value: i64) -> IrBorrowOriginList {
  match facts {
    IrBorrowValueFactNil -> IrBorrowOriginNil
    IrBorrowValueFactCons(head, origins, rest) -> if head == value { origins } else { ir_borrow_value_facts_find(rest, value) }
  }
}

pub(package) fn ir_borrow_value_fact_count(facts: IrBorrowValueFactList) -> i64 {
  match facts {
    IrBorrowValueFactNil -> 0
    IrBorrowValueFactCons(value, origins, rest) -> 1 + ir_borrow_value_fact_count(rest)
  }
}

pub(package) fn ir_borrow_value_facts_count_parameter_owner(facts: IrBorrowValueFactList, index: i64) -> i64 {
  match facts {
    IrBorrowValueFactNil -> 0
    IrBorrowValueFactCons(value, origins, rest) -> ir_borrow_origin_list_contains_parameter(origins, index) + ir_borrow_value_facts_count_parameter_owner(rest, index)
  }
}

pub(package) fn ir_borrow_value_facts_count_unknown_owner(facts: IrBorrowValueFactList) -> i64 {
  match facts {
    IrBorrowValueFactNil -> 0
    IrBorrowValueFactCons(value, origins, rest) -> ir_borrow_origin_list_contains_unknown(origins) + ir_borrow_value_facts_count_unknown_owner(rest)
  }
}

pub(package) fn ir_borrow_value_facts_max_origin_count(facts: IrBorrowValueFactList, current: i64) -> i64 {
  match facts {
    IrBorrowValueFactNil -> current
    IrBorrowValueFactCons(value, origins, rest) -> {
      let n = ir_borrow_origin_list_len(origins)
      ir_borrow_value_facts_max_origin_count(rest, if n > current { n } else { current })
    }
  }
}

pub(package) fn ir_borrow_value_facts_set(facts: IrBorrowValueFactList, value: i64, origins: IrBorrowOriginList) -> IrBorrowValueFactList {
  match facts {
    IrBorrowValueFactNil -> IrBorrowValueFactCons(value, origins, IrBorrowValueFactNil)
    IrBorrowValueFactCons(head, current, rest) -> {
      if head == value { IrBorrowValueFactCons(value, origins, rest) }
      else { IrBorrowValueFactCons(head, current, ir_borrow_value_facts_set(rest, value, origins)) }
    }
  }
}

pub(package) fn ir_borrow_value_facts_merge_rebased(facts: IrBorrowValueFactList, value: i64, incoming: IrBorrowOriginList) -> IrBorrowValueFactList {
  let current = ir_borrow_value_facts_find(facts, value)
  ir_borrow_value_facts_set(facts, value, ir_borrow_origin_list_union_rebased(incoming, current, value))
}

pub(package) fn ir_borrow_value_facts_merge_rebased_mutable(facts: IrBorrowValueFactList, value: i64, incoming: IrBorrowOriginList, mutable: i64) -> IrBorrowValueFactList {
  let current = ir_borrow_value_facts_find(facts, value)
  ir_borrow_value_facts_set(facts, value, ir_borrow_origin_list_union_rebased_mutable(incoming, current, value, mutable))
}

pub(package) fn ir_borrow_param_facts_empty() -> IrBorrowParamFactList {
  IrBorrowParamFactNil
}

pub(package) fn ir_borrow_param_facts_prepend(index: i64, head: i64, mutable: i64, rest: IrBorrowParamFactList) -> IrBorrowParamFactList {
  IrBorrowParamFactCons(index, head, mutable, rest)
}

pub(package) fn ir_borrow_param_fact_count(facts: IrBorrowParamFactList) -> i64 {
  match facts {
    IrBorrowParamFactNil -> 0
    IrBorrowParamFactCons(index, head, mutable, rest) -> 1 + ir_borrow_param_fact_count(rest)
  }
}

pub(package) fn ir_borrow_param_fact_head_or(facts: IrBorrowParamFactList, target: i64, default: i64) -> i64 {
  match facts {
    IrBorrowParamFactNil -> default
    IrBorrowParamFactCons(index, head, mutable, rest) -> if index == target { head } else { ir_borrow_param_fact_head_or(rest, target, default) }
  }
}

pub(package) fn ir_borrow_param_fact_mutable_or(facts: IrBorrowParamFactList, target: i64, default: i64) -> i64 {
  match facts {
    IrBorrowParamFactNil -> default
    IrBorrowParamFactCons(index, head, mutable, rest) -> if index == target { mutable } else { ir_borrow_param_fact_mutable_or(rest, target, default) }
  }
}

pub(package) fn ir_borrow_summary_known(params: IrValueList) -> IrBorrowSummary {
  IrBorrowSummaryKnown(params)
}

pub(package) fn ir_borrow_summary_unknown() -> IrBorrowSummary {
  IrBorrowSummaryUnknown
}

pub(package) fn ir_borrow_summary_is_known(summary: IrBorrowSummary) -> i64 {
  match summary {
    IrBorrowSummaryKnown(params) -> 1
    IrBorrowSummaryUnknown -> 0
  }
}

pub(package) fn ir_borrow_summary_param_count_or(summary: IrBorrowSummary, default: i64) -> i64 {
  match summary {
    IrBorrowSummaryKnown(params) -> ir_value_list_len(params)
    IrBorrowSummaryUnknown -> default
  }
}

pub(package) fn ir_borrow_summary_params(summary: IrBorrowSummary) -> IrValueList {
  match summary {
    IrBorrowSummaryKnown(params) -> params
    IrBorrowSummaryUnknown -> IrValueNil
  }
}

pub(package) fn ir_borrow_summary_union(left: IrBorrowSummary, right: IrBorrowSummary) -> IrBorrowSummary {
  match left {
    IrBorrowSummaryUnknown -> IrBorrowSummaryUnknown
    IrBorrowSummaryKnown(left_params) -> {
      match right {
        IrBorrowSummaryUnknown -> IrBorrowSummaryUnknown
        IrBorrowSummaryKnown(right_params) -> IrBorrowSummaryKnown(ir_value_list_union(left_params, right_params))
      }
    }
  }
}

pub(package) fn ir_borrow_summary_eq(left: IrBorrowSummary, right: IrBorrowSummary) -> i64 {
  match left {
    IrBorrowSummaryUnknown -> match right { IrBorrowSummaryUnknown -> 1 _ -> 0 }
    IrBorrowSummaryKnown(left_params) -> {
      match right {
        IrBorrowSummaryKnown(right_params) -> ir_value_list_set_eq(left_params, right_params)
        _ -> 0
      }
    }
  }
}

pub(package) fn ir_borrow_facts_new(params: IrBorrowParamFactList, values: IrBorrowValueFactList, return_mutability: i64, summary: IrBorrowSummary) -> IrBorrowFacts {
  IrBorrowFacts(params, values, return_mutability, summary)
}

pub(package) fn ir_borrow_facts_empty() -> IrBorrowFacts {
  IrBorrowFacts(IrBorrowParamFactNil, IrBorrowValueFactNil, 0 - 1, IrBorrowSummaryKnown(IrValueNil))
}

pub(package) fn ir_borrow_facts_params(facts: IrBorrowFacts) -> IrBorrowParamFactList {
  match facts { IrBorrowFacts(params, values, return_mutability, summary) -> params }
}

pub(package) fn ir_borrow_facts_values(facts: IrBorrowFacts) -> IrBorrowValueFactList {
  match facts { IrBorrowFacts(params, values, return_mutability, summary) -> values }
}

pub(package) fn ir_borrow_facts_return_mutability(facts: IrBorrowFacts) -> i64 {
  match facts { IrBorrowFacts(params, values, return_mutability, summary) -> return_mutability }
}

pub(package) fn ir_borrow_facts_summary(facts: IrBorrowFacts) -> IrBorrowSummary {
  match facts { IrBorrowFacts(params, values, return_mutability, summary) -> summary }
}

pub(package) fn ir_borrow_facts_with_summary(facts: IrBorrowFacts, next_summary: IrBorrowSummary) -> IrBorrowFacts {
  match facts {
    IrBorrowFacts(params, values, return_mutability, summary) -> IrBorrowFacts(params, values, return_mutability, next_summary)
  }
}

pub(package) fn ir_borrow_facts_with_values(facts: IrBorrowFacts, next_values: IrBorrowValueFactList) -> IrBorrowFacts {
  match facts {
    IrBorrowFacts(params, values, return_mutability, summary) -> IrBorrowFacts(params, next_values, return_mutability, summary)
  }
}

pub(package) fn ir_borrow_origin_valid(origin: IrBorrowOrigin, logical_param_count: i64) -> i64 {
  match origin {
    IrBorrowOrigin(owner, start, len, mutable) -> {
      let owner_valid = match owner {
        IrBorrowOwnerParameter(index) -> if index >= 0 and index < logical_param_count { 1 } else { 0 }
        IrBorrowOwnerValue(value) -> if value >= 0 { 1 } else { 0 }
        IrBorrowOwnerUnknown -> 1
      }
      if owner_valid == 1 and start >= 0 and len >= 0 and (mutable == 0 or mutable == 1) { 1 } else { 0 }
    }
  }
}

pub(package) fn ir_borrow_origin_list_valid(origins: IrBorrowOriginList, logical_param_count: i64) -> i64 {
  match origins {
    IrBorrowOriginNil -> 0
    IrBorrowOriginCons(origin, rest) -> {
      if ir_borrow_origin_valid(origin, logical_param_count) != 1 { 0 }
      else {
        match rest {
          IrBorrowOriginNil -> 1
          _ -> ir_borrow_origin_list_valid(rest, logical_param_count)
        }
      }
    }
  }
}

pub(package) fn ir_borrow_value_facts_valid(facts: IrBorrowValueFactList, logical_param_count: i64, seen: IrValueList) -> i64 {
  match facts {
    IrBorrowValueFactNil -> 1
    IrBorrowValueFactCons(value, origins, rest) -> {
      if value < 0 or ir_value_list_contains(seen, value) == 1 or ir_borrow_origin_list_valid(origins, logical_param_count) != 1 { 0 }
      else { ir_borrow_value_facts_valid(rest, logical_param_count, IrValueCons(value, seen)) }
    }
  }
}

pub(package) fn ir_borrow_param_origin_present(index: i64, head: i64, mutable: i64, origins: IrBorrowOriginList) -> i64 {
  match origins {
    IrBorrowOriginNil -> 0
    IrBorrowOriginCons(origin, rest) -> {
      match origin {
        IrBorrowOrigin(owner, start, len, origin_mutable) -> {
          if ir_borrow_owner_parameter_index_or(owner, 0 - 1) == index and start == head and len == head + 1 and origin_mutable == mutable { 1 }
          else { ir_borrow_param_origin_present(index, head, mutable, rest) }
        }
      }
    }
  }
}

pub(package) fn ir_borrow_param_facts_valid(params: IrBorrowParamFactList, values: IrBorrowValueFactList, logical_param_count: i64, seen_indices: IrValueList, seen_heads: IrValueList) -> i64 {
  match params {
    IrBorrowParamFactNil -> 1
    IrBorrowParamFactCons(index, head, mutable, rest) -> {
      let origins = ir_borrow_value_facts_find(values, head)
      if index < 0 or index >= logical_param_count or head < 0 or (mutable != 0 and mutable != 1) or ir_value_list_contains(seen_indices, index) == 1 or ir_value_list_contains(seen_heads, head) == 1 or ir_borrow_param_origin_present(index, head, mutable, origins) != 1 { 0 }
      else { ir_borrow_param_facts_valid(rest, values, logical_param_count, IrValueCons(index, seen_indices), IrValueCons(head, seen_heads)) }
    }
  }
}

pub(package) fn ir_borrow_summary_valid(summary: IrBorrowSummary, return_mutability: i64, logical_param_count: i64) -> i64 {
  match summary {
    -- Unknown is always structurally valid: generic results can become slices
    -- only after substitution, and opaque function values remain deliberately
    -- conservative even when their current signature is not slice-shaped.
    IrBorrowSummaryUnknown -> 1
    IrBorrowSummaryKnown(params) -> {
      let mut valid = ir_value_list_all_unique(params)
      let mut cur = params
      let mut walking = 1
      while walking == 1 {
        match cur {
          IrValueNil -> { walking = 0 }
          IrValueCons(index, rest) -> {
            if index < 0 or index >= logical_param_count { valid = 0 } else { 0 }
            cur = rest
          }
        }
      }
      if return_mutability == 0 - 1 and ir_value_list_len(params) != 0 { 0 } else { valid }
    }
  }
}

pub(package) fn ir_borrow_facts_valid(facts: IrBorrowFacts, logical_param_count: i64) -> i64 {
  if ir_borrow_facts_invalid_code(facts, logical_param_count) == 0 { 1 } else { 0 }
}

pub(package) fn ir_borrow_facts_invalid_code(facts: IrBorrowFacts, logical_param_count: i64) -> i64 {
  match facts {
    IrBorrowFacts(params, values, return_mutability, summary) -> {
      if return_mutability < 0 - 1 or return_mutability > 1 { 1 }
      else { if ir_borrow_value_facts_valid(values, logical_param_count, IrValueNil) != 1 { 2 }
      else { if ir_borrow_param_facts_valid(params, values, logical_param_count, IrValueNil, IrValueNil) != 1 { 3 }
      else { if ir_borrow_summary_valid(summary, return_mutability, logical_param_count) != 1 { 4 } else { 0 } } } }
    }
  }
}

pub(package) fn ir_record_field_list_empty() -> IrRecordFieldList {
  IrRecordFieldNil
}

pub(package) fn ir_record_field_list_prepend(field_hash: i64, word_offset: i64, value: i64, rest: IrRecordFieldList) -> IrRecordFieldList {
  IrRecordFieldCons(field_hash, word_offset, value, rest)
}

pub(package) fn ir_record_field_list_append(left: IrRecordFieldList, right: IrRecordFieldList) -> IrRecordFieldList {
  match left {
    IrRecordFieldNil -> right
    IrRecordFieldCons(field_hash, word_offset, value, rest) -> IrRecordFieldCons(field_hash, word_offset, value, ir_record_field_list_append(rest, right))
  }
}

pub(package) fn ir_record_field_list_len(fields: IrRecordFieldList) -> i64 {
  match fields {
    IrRecordFieldNil -> 0
    IrRecordFieldCons(field_hash, word_offset, value, rest) -> 1 + ir_record_field_list_len(rest)
  }
}

pub(package) fn ir_record_layout_field_list_empty() -> IrRecordLayoutFieldList {
  IrRecordLayoutFieldNil
}

pub(package) fn ir_record_layout_field_list_prepend_word(field_hash: i64, byte_offset: i64, value: i64, managed_kind: i64, rest: IrRecordLayoutFieldList) -> IrRecordLayoutFieldList {
  IrRecordLayoutFieldWord(field_hash, byte_offset, value, managed_kind, rest)
}

pub(package) fn ir_record_layout_field_list_prepend_array(field_hash: i64, byte_offset: i64, storage: i64, byte_size: i64, leaf_count: i64, leaf_stride: i64, leaf_kind: i64, rest: IrRecordLayoutFieldList) -> IrRecordLayoutFieldList {
  IrRecordLayoutFieldArray(field_hash, byte_offset, storage, byte_size, leaf_count, leaf_stride, leaf_kind, rest)
}

pub(package) fn ir_record_layout_field_list_len(fields: IrRecordLayoutFieldList) -> i64 {
  match fields {
    IrRecordLayoutFieldNil -> 0
    IrRecordLayoutFieldWord(field_hash, byte_offset, value, managed_kind, rest) -> 1 + ir_record_layout_field_list_len(rest)
    IrRecordLayoutFieldArray(field_hash, byte_offset, data, byte_size, leaf_count, leaf_stride, leaf_kind, rest) -> 1 + ir_record_layout_field_list_len(rest)
  }
}

pub(package) fn ir_inst_list_empty() -> IrInstList {
  IrInstNil
}

pub(package) fn ir_inst_list_prepend(inst: IrInst, rest: IrInstList) -> IrInstList {
  IrInstCons(inst, rest)
}

pub(package) fn ir_inst_list_append(left: IrInstList, right: IrInstList) -> IrInstList {
  match left {
    IrInstNil -> right
    IrInstCons(inst, rest) -> IrInstCons(inst, ir_inst_list_append(rest, right))
  }
}

pub(package) fn ir_inst_list_len(insts: IrInstList) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> 1 + ir_inst_list_len(rest)
  }
}

pub(package) fn ir_inst_list_count_tag(insts: IrInstList, tag: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let add = if ir_inst_tag(inst) == tag { 1 } else { 0 }
      add + ir_inst_list_count_tag(rest, tag)
    }
  }
}

pub(package) fn ir_inst_count_binary_op(inst: IrInst, op_tag: i64) -> i64 {
  match inst {
    IrConstI64(dst, value) -> 0
    IrNilI64(dst) -> 0
    IrStringLit(dst, start, len) -> 0
    IrStringConcatI64(dst, left, right) -> 0
    IrBinaryI64(dst, op, lhs, rhs) -> if ir_binary_op_tag(op) == op_tag { 1 } else { 0 }
    IrFloatBinaryI64(dst, prim, op, lhs, rhs) -> if ir_binary_op_tag(op) == op_tag { 1 } else { 0 }
    IrUnaryI64(dst, op, value) -> 0
    IrClosureI64(dst, f, captures, eff) -> 0
    IrFunctionRefI64(dst, callee_hash) -> 0
    IrGenericFunctionRefI64(dst, callee_hash, type_args) -> 0
    IrAddressOfSlotI64(dst, slot) -> 0
    IrPtrLoadI64(dst, ptr) -> 0
    IrPtrStoreI64(dst, ptr, value) -> 0
    IrLoweringFailureI64(reason) -> 0
    IrPerformI64(dst, effect_hash, op_hash, args) -> 0
    IrHandlerDirectI64(dst, effect_hash, op_hash, handler_depth, clause_index, args) -> 0
    IrHandlerPopI64(frame) -> 0
    IrAbortLandingI64(dst) -> 0
    IrBindI64(ns, nl, value, ty) -> 0
    IrHandleI64(dst, src, body, clauses, nclauses, captures) -> 0
    IrDeferredHandleI64(dst, src, body, clauses, nclauses, captures, scratch_base) -> 0
    IrResumeI64(dst, value) -> 0
    IrTryI64(dst, value, effect_key) -> 0
    IrOptChainI64(dst, base, field_hash, field_index, effect_key) -> 0
    IrCallI64(dst, callee_hash, args) -> 0
    IrCallResultLaneI64(dst, lane) -> 0
    IrReturnLaneI64(lane, value) -> 0
    IrIndirectCallI64(dst, callee, args) -> 0
    IrGenericCallI64(dst, callee_hash, type_args, args) -> 0
    IrVectorGetI64(dst, vec, index, fallback, check_mode) -> 0
    IrVectorSetI64(dst, vec, index, value, check_mode) -> 0
    IrMethodCallI64(dst, type_hash, method_hash, receiver, args) -> 0
    IrOwnedDropI64(value, type_hash) -> 0
    IrArrayStorageI64(dst, byte_size, align) -> 0
    IrArrayCopyI64(dst_data, src_data, byte_size, leaf_count, leaf_stride, leaf_kind) -> 0
    IrArrayDropI64(data, leaf_count, leaf_stride, leaf_kind) -> 0
    IrVariantInitI64(dst, tag_hash, payloads, field_mask) -> 0
    IrVariantTagI64(dst, base) -> 0
    IrVariantPayloadI64(dst, base, index) -> 0
    IrRecordInitI64(dst, type_hash, fields) -> 0
    IrRecordLayoutInitI64(dst, type_hash, data_size, align, fields) -> 0
    IrRecordLayoutArrayLoadI64(dst_data, base, record_data_size, byte_offset, byte_size, leaf_count, leaf_stride, leaf_kind) -> 0
    IrRecordLayoutWordLoadI64(dst, base, record_data_size, field_hash, byte_offset) -> 0
    IrFieldLoadI64(dst, base, field_hash, field_index) -> 0
    IrSlotI64(slot) -> 0
    IrLoadI64(dst, slot) -> 0
    IrStoreI64(slot, value) -> 0
    IrManagedStakeI64(dst, value, cleanup_kind, delta, origin) -> 0
    IrManagedTransferI64(call_dst, callee_hash, value, arg_lane, cleanup_kind) -> 0
    IrReuseInitI64(token, constructor) -> ir_inst_count_binary_op(constructor, op_tag)
  }
}

pub(package) fn ir_inst_count_unary_op(inst: IrInst, op_tag: i64) -> i64 {
  match inst {
    IrConstI64(dst, value) -> 0
    IrArrayStorageI64(dst, byte_size, align) -> 0
    IrArrayCopyI64(dst_data, src_data, byte_size, leaf_count, leaf_stride, leaf_kind) -> 0
    IrArrayDropI64(data, leaf_count, leaf_stride, leaf_kind) -> 0
    IrNilI64(dst) -> 0
    IrStringLit(dst, start, len) -> 0
    IrStringConcatI64(dst, left, right) -> 0
    IrBinaryI64(dst, op, lhs, rhs) -> 0
    IrFloatBinaryI64(dst, prim, op, lhs, rhs) -> 0
    IrUnaryI64(dst, op, value) -> if ir_unary_op_tag(op) == op_tag { 1 } else { 0 }
    IrClosureI64(dst, f, captures, eff) -> 0
    IrFunctionRefI64(dst, callee_hash) -> 0
    IrGenericFunctionRefI64(dst, callee_hash, type_args) -> 0
    IrAddressOfSlotI64(dst, slot) -> 0
    IrPtrLoadI64(dst, ptr) -> 0
    IrPtrStoreI64(dst, ptr, value) -> 0
    IrLoweringFailureI64(reason) -> 0
    IrPerformI64(dst, effect_hash, op_hash, args) -> 0
    IrHandlerDirectI64(dst, effect_hash, op_hash, handler_depth, clause_index, args) -> 0
    IrHandlerPopI64(frame) -> 0
    IrAbortLandingI64(dst) -> 0
    IrBindI64(ns, nl, value, ty) -> 0
    IrHandleI64(dst, src, body, clauses, nclauses, captures) -> 0
    IrDeferredHandleI64(dst, src, body, clauses, nclauses, captures, scratch_base) -> 0
    IrResumeI64(dst, value) -> 0
    IrTryI64(dst, value, effect_key) -> 0
    IrOptChainI64(dst, base, field_hash, field_index, effect_key) -> 0
    IrCallI64(dst, callee_hash, args) -> 0
    IrCallResultLaneI64(dst, lane) -> 0
    IrReturnLaneI64(lane, value) -> 0
    IrIndirectCallI64(dst, callee, args) -> 0
    IrGenericCallI64(dst, callee_hash, type_args, args) -> 0
    IrVectorGetI64(dst, vec, index, fallback, check_mode) -> 0
    IrVectorSetI64(dst, vec, index, value, check_mode) -> 0
    IrMethodCallI64(dst, type_hash, method_hash, receiver, args) -> 0
    IrOwnedDropI64(value, type_hash) -> 0
    IrVariantInitI64(dst, tag_hash, payloads, field_mask) -> 0
    IrVariantTagI64(dst, base) -> 0
    IrVariantPayloadI64(dst, base, index) -> 0
    IrRecordInitI64(dst, type_hash, fields) -> 0
    IrRecordLayoutInitI64(dst, type_hash, data_size, align, fields) -> 0
    IrRecordLayoutArrayLoadI64(dst_data, base, record_data_size, byte_offset, byte_size, leaf_count, leaf_stride, leaf_kind) -> 0
    IrRecordLayoutWordLoadI64(dst, base, record_data_size, field_hash, byte_offset) -> 0
    IrFieldLoadI64(dst, base, field_hash, field_index) -> 0
    IrSlotI64(slot) -> 0
    IrLoadI64(dst, slot) -> 0
    IrStoreI64(slot, value) -> 0
    IrManagedStakeI64(dst, value, cleanup_kind, delta, origin) -> 0
    IrManagedTransferI64(call_dst, callee_hash, value, arg_lane, cleanup_kind) -> 0
    IrReuseInitI64(token, constructor) -> ir_inst_count_unary_op(constructor, op_tag)
  }
}

pub(package) fn ir_inst_list_count_binary_op(insts: IrInstList, op: IrBinaryOp) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      ir_inst_count_binary_op(inst, ir_binary_op_tag(op)) + ir_inst_list_count_binary_op(rest, op)
    }
  }
}

pub(package) fn ir_inst_list_count_unary_op(insts: IrInstList, op: IrUnaryOp) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      ir_inst_count_unary_op(inst, ir_unary_op_tag(op)) + ir_inst_list_count_unary_op(rest, op)
    }
  }
}

pub(package) fn ir_inst_list_first_tag(insts: IrInstList) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> ir_inst_tag(inst)
  }
}

pub(package) fn ir_inst_list_first_const_value_or(insts: IrInstList, default: i64) -> i64 {
  match insts {
    IrInstNil -> default
    IrInstCons(inst, rest) -> ir_inst_const_value_or(inst, default)
  }
}

pub(package) fn ir_inst_list_first_string_len_or(insts: IrInstList, default: i64) -> i64 {
  match insts {
    IrInstNil -> default
    IrInstCons(inst, rest) -> {
      let n = ir_inst_string_len_or(inst, default)
      if n == default { ir_inst_list_first_string_len_or(rest, default) } else { n }
    }
  }
}

