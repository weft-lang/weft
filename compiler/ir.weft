    }
  }
}

fn type_trait_member_list_count_kind(members: TypeTraitMemberList, kind: i64) -> i64 {
  match members {
    TypeTraitMemberListNil -> 0
    TypeTraitMemberListCons(member, rest) -> {
      let add = if type_trait_member_kind_or(member, 0 - 1) == kind { 1 } else { 0 }
      add + type_trait_member_list_count_kind(rest, kind)
    }
  }
}

fn type_trait_member_list_nth_kind_or(members: TypeTraitMemberList, index: i64, default: i64) -> i64 {
