fn ir_lowered_expr(value: i64, next_value: i64, insts: IrInstList) -> IrLoweredExpr {
  IrLoweredExpr(value, next_value, insts)
}

fn ir_lowered_expr_invalid(next_value: i64) -> IrLoweredExpr {
  IrLoweredExpr(-1, next_value, ir_inst_list_empty())
}

fn ir_lowered_expr_value(lowered: IrLoweredExpr) -> i64 {
  match lowered {
    IrLoweredExpr(value, next_value, insts) -> value
  }
}

fn ir_lowered_expr_next_value(lowered: IrLoweredExpr) -> i64 {
  match lowered {
    IrLoweredExpr(value, next_value, insts) -> next_value
  }
}

fn ir_lowered_expr_insts(lowered: IrLoweredExpr) -> IrInstList {
  match lowered {
    IrLoweredExpr(value, next_value, insts) -> insts
  }
}

fn ir_lowered_expr_is_valid(lowered: IrLoweredExpr) -> i64 {
  if ir_lowered_expr_value(lowered) >= 0 { 1 } else { 0 }
}

