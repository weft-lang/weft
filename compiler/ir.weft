fn ir_function_new(name_hash: i64, param_count: i64, entry: IrBlock) -> IrFunction {
  IrFunction(name_hash, param_count, ir_block_list_prepend(entry, ir_block_list_empty()))
}

fn ir_function_new_blocks(name_hash: i64, param_count: i64, blocks: IrBlockList) -> IrFunction {
  IrFunction(name_hash, param_count, blocks)
}

