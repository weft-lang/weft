type TypeTraitMember {
  TypeTraitMethod(i64, i64, ParamList, TypeExpr, EffectSig), -- tag 39: name, typed params/ret_type/effects
  TypeTraitAssocType(i64, i64),                         -- tag 42: associated type declaration
  MissingTypeTraitMember
}

type TypeTraitMemberList {
  TypeTraitMemberListNil,
  TypeTraitMemberListCons(TypeTraitMember, TypeTraitMemberList)
}

fn type_trait_member_list_empty() -> TypeTraitMemberList {
  TypeTraitMemberListNil
}

fn type_trait_member_from_node(node: i64) -> TypeTraitMember {
  if node == 0 { MissingTypeTraitMember }
  else {
    match node_tag(node) {
      39 -> {
        let ret_wrap = node_f4(node)
        let ret_type = if ret_wrap == 0 { 0 } else { node_f1(ret_wrap) }
        let effects = if ret_wrap == 0 { 0 } else { node_f2(ret_wrap) }
        TypeTraitMethod(node_f1(node), node_f2(node), param_list_from_param_nodes(node_f3(node)), type_expr_from_node(ret_type), effect_sig_from_node(effects))
      }
      42 -> TypeTraitAssocType(node_f1(node), node_f2(node))
      _ -> MissingTypeTraitMember
    }
  }
}

