-- Hoisted lambda (2k slice A): the body is a complete, ordinary
-- IrFunction (env as param 0 — the closure ABI is exactly a normal
-- call with the env pointer first). The inst carries the function
-- until the optimiser driver collects it into the module list;
-- emission references it by hash only. captures is the
-- pipeline_lambda_capture_entry nlist; evidence is the typed lowering
-- fact used both to populate the closure env and to route performs in
-- the ordinary synthetic function.
pub(package) fn ir_inst_closure_i64(dst: i64, f: IrFunction, captures: i64, facts: IrLambdaSemanticFacts) -> IrInst {
  IrClosureI64(dst, f, captures, facts)
}

