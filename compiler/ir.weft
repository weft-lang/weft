  IrMul
}

fn ir_binary_op_eq() -> IrBinaryOp {
  IrEq
}

fn ir_binary_op_tag(op: IrBinaryOp) -> i64 {
  match op {
    IrBinaryUnknown -> 0
    IrAdd -> 1
    IrSub -> 2
    IrMul -> 3
    IrDiv -> 4
    IrEq -> 5
    IrNe -> 6
    IrLt -> 7
    IrGt -> 8
    IrLe -> 9
    IrGe -> 10
    IrMod -> 11
    IrAnd -> 12
    IrOr -> 13
    IrBand -> 14
    IrBor -> 15
    IrBxor -> 16
    IrBshl -> 17
    IrBshr -> 18
  }
}

fn ir_binary_op_from_parser(op_id: i64) -> IrBinaryOp {
  match op_id {
    1 -> IrAdd
    2 -> IrSub
    3 -> IrMul
    4 -> IrDiv
    5 -> IrEq
    6 -> IrNe
    7 -> IrLt
    8 -> IrGt
    9 -> IrLe
    10 -> IrGe
    11 -> IrMod
    12 -> IrAnd
    13 -> IrOr
    14 -> IrBand
    15 -> IrBor
    16 -> IrBxor
    17 -> IrBshl
    18 -> IrBshr
    _ -> IrBinaryUnknown
  }
}

fn ir_binary_op_is_supported(op: IrBinaryOp) -> i64 {
  match op {
    IrBinaryUnknown -> 0
    _ -> 1
  }
}

fn ir_unary_op_not() -> IrUnaryOp {
  IrNot
}

fn ir_unary_op_tag(op: IrUnaryOp) -> i64 {
  match op {
    IrUnaryUnknown -> 0
    IrNot -> 1
  }
}

