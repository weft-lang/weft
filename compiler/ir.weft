  }
}

fn type_trait_member_list_nth(members: TypeTraitMemberList, index: i64) -> TypeTraitMember {
  match members {
    TypeTraitMemberListNil -> MissingTypeTraitMember
    TypeTraitMemberListCons(member, rest) -> {
