fn ir_function_list_empty() -> IrFunctionList {
  IrFunctionNil
}

fn ir_function_list_prepend(f: IrFunction, rest: IrFunctionList) -> IrFunctionList {
  IrFunctionCons(f, rest)
}

fn ir_function_list_len(functions: IrFunctionList) -> i64 {
  match functions {
    IrFunctionNil -> 0
    IrFunctionCons(f, rest) -> 1 + ir_function_list_len(rest)
  }
}

fn ir_function_list_inst_count(functions: IrFunctionList) -> i64 {
  match functions {
    IrFunctionNil -> 0
    IrFunctionCons(f, rest) -> ir_function_inst_count(f) + ir_function_list_inst_count(rest)
  }
}

fn ir_function_list_inst_counts(functions: IrFunctionList) -> i64 {
  match functions {
    IrFunctionNil -> Nil
    IrFunctionCons(f, rest) -> Cons<i64>(ir_function_inst_count(f), ir_function_list_inst_counts(rest))
  }
}

fn ir_metric_identity_i64(x: i64) -> i64 {
  x
}

fn ir_metric_nonnegative_i64(x: i64) -> i64 {
  if x >= 0 { 1 } else { 0 }
}

fn ir_metric_sum_i64(acc: i64, x: i64) -> i64 {
  acc + x
}

fn ir_function_list_pipeline_inst_count(functions: IrFunctionList) -> i64 {
  let counts = ir_function_list_inst_counts(functions)
  counts |> list_map<i64, i64>(ir_metric_identity_i64) |> list_filter<i64>(ir_metric_nonnegative_i64) |> list_fold<i64, i64>(0, ir_metric_sum_i64)
}

fn ir_function_list_block_count(functions: IrFunctionList) -> i64 {
  match functions {
    IrFunctionNil -> 0
    IrFunctionCons(f, rest) -> ir_function_block_count(f) + ir_function_list_block_count(rest)
  }
}

fn ir_function_list_block_param_count(functions: IrFunctionList) -> i64 {
  match functions {
    IrFunctionNil -> 0
    IrFunctionCons(f, rest) -> ir_function_block_param_count(f) + ir_function_list_block_param_count(rest)
  }
}

