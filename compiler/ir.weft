fn ir_term_none() -> IrTerminator {
  IrTermNone
}

fn ir_term_return(value: i64) -> IrTerminator {
  IrTermReturn(value)
}

fn ir_term_jump(target: i64) -> IrTerminator {
  IrTermJump(target, ir_value_list_empty())
}

fn ir_term_jump_args(target: i64, args: IrValueList) -> IrTerminator {
  IrTermJump(target, args)
}

fn ir_term_branch(cond: i64, then_block: i64, else_block: i64) -> IrTerminator {
  IrTermBranch(cond, then_block, else_block)
}

fn ir_term_tag(term: IrTerminator) -> i64 {
  match term {
    IrTermNone -> 0
    IrTermReturn(value) -> 1
    IrTermJump(target, args) -> 2
    IrTermBranch(cond, then_block, else_block) -> 3
  }
}

fn ir_term_return_value_or(term: IrTerminator, default: i64) -> i64 {
  match term {
    IrTermNone -> default
    IrTermReturn(value) -> value
    IrTermJump(target, args) -> default
    IrTermBranch(cond, then_block, else_block) -> default
  }
}

fn ir_term_jump_target_or(term: IrTerminator, default: i64) -> i64 {
  match term {
    IrTermNone -> default
    IrTermReturn(value) -> default
    IrTermJump(target, args) -> target
    IrTermBranch(cond, then_block, else_block) -> default
  }
}

fn ir_term_jump_arg_count_or(term: IrTerminator, default: i64) -> i64 {
  match term {
    IrTermNone -> default
    IrTermReturn(value) -> default
    IrTermJump(target, args) -> ir_value_list_len(args)
    IrTermBranch(cond, then_block, else_block) -> default
  }
}

fn ir_term_branch_then_or(term: IrTerminator, default: i64) -> i64 {
  match term {
    IrTermNone -> default
    IrTermReturn(value) -> default
    IrTermJump(target, args) -> default
    IrTermBranch(cond, then_block, else_block) -> then_block
  }
}

fn ir_term_branch_else_or(term: IrTerminator, default: i64) -> i64 {
  match term {
    IrTermNone -> default
    IrTermReturn(value) -> default
    IrTermJump(target, args) -> default
    IrTermBranch(cond, then_block, else_block) -> else_block
  }
}

fn ir_block_new(id: i64, insts: IrInstList) -> IrBlock {
  IrBlock(id, ir_value_list_empty(), insts, IrTermNone)
}

fn ir_block_new_term(id: i64, insts: IrInstList, term: IrTerminator) -> IrBlock {
  IrBlock(id, ir_value_list_empty(), insts, term)
}

fn ir_block_new_params(id: i64, params: IrValueList, insts: IrInstList, term: IrTerminator) -> IrBlock {
  IrBlock(id, params, insts, term)
}

fn ir_block_id(block: IrBlock) -> i64 {
  match block {
    IrBlock(id, params, insts, term) -> id
  }
}

fn ir_block_param_count(block: IrBlock) -> i64 {
  match block {
    IrBlock(id, params, insts, term) -> ir_value_list_len(params)
  }
}

fn ir_block_inst_count(block: IrBlock) -> i64 {
  match block {
    IrBlock(id, params, insts, term) -> ir_inst_list_len(insts)
  }
}

fn ir_block_count_tag(block: IrBlock, tag: i64) -> i64 {
  match block {
    IrBlock(id, params, insts, term) -> ir_inst_list_count_tag(insts, tag)
  }
}

fn ir_block_count_binary_op(block: IrBlock, op: IrBinaryOp) -> i64 {
  match block {
    IrBlock(id, params, insts, term) -> ir_inst_list_count_binary_op(insts, op)
  }
}

fn ir_block_count_unary_op(block: IrBlock, op: IrUnaryOp) -> i64 {
  match block {
    IrBlock(id, params, insts, term) -> ir_inst_list_count_unary_op(insts, op)
  }
}

fn ir_block_first_inst_tag(block: IrBlock) -> i64 {
  match block {
    IrBlock(id, params, insts, term) -> ir_inst_list_first_tag(insts)
  }
}

fn ir_block_first_const_value_or(block: IrBlock, default: i64) -> i64 {
  match block {
    IrBlock(id, params, insts, term) -> ir_inst_list_first_const_value_or(insts, default)
  }
}

