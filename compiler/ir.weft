pub(package) fn ir_inst_tag(inst: IrInst) -> i64 {
  match inst {
    IrConstI64(dst, value) -> 1
    IrNilI64(dst) -> 27
    IrStringLit(dst, start, len) -> 12
    IrStringConcatI64(dst, left, right) -> 21
    IrBinaryI64(dst, op, lhs, rhs) -> 2
    IrFloatBinaryI64(dst, prim, op, lhs, rhs) -> 30
    IrUnaryI64(dst, op, value) -> 3
    IrClosureI64(dst, f, captures, eff) -> 38
    IrFunctionRefI64(dst, callee_hash) -> 32
    IrGenericFunctionRefI64(dst, callee_hash, type_args) -> 40
    IrAddressOfSlotI64(dst, slot) -> 33
    IrPtrLoadI64(dst, ptr) -> 34
    IrPtrStoreI64(dst, ptr, value) -> 35
    IrLoweringFailureI64(reason) -> 36
    IrPerformI64(dst, effect_hash, op_hash, args) -> 18
    IrHandlerDirectI64(dst, effect_hash, op_hash, handler_depth, clause_index, args) -> 24
    IrHandlerPopI64(frame) -> 25
    IrAbortLandingI64(dst) -> 39
    IrBindI64(ns, nl, value, ty) -> 26
    IrHandleI64(dst, src, body, clauses, nclauses, captures) -> 19
    IrDeferredHandleI64(dst, src, body, clauses, nclauses, captures, scratch_base) -> 37
    IrResumeI64(dst, value) -> 20
    IrTryI64(dst, value, effect_key) -> 22
    IrOptChainI64(dst, base, field_hash, field_index, effect_key) -> 23
    IrCallI64(dst, callee_hash, args) -> 4
    IrCallResultLaneI64(dst, lane) -> 41
    IrReturnLaneI64(lane, value) -> 42
    IrIndirectCallI64(dst, callee, args) -> 16
    IrGenericCallI64(dst, callee_hash, type_args, args) -> 8
    IrVectorGetI64(dst, vec, index, default, check_mode) -> 28
    IrVectorSetI64(dst, vec, index, value, check_mode) -> 29
    IrMethodCallI64(dst, type_hash, method_hash, receiver, args) -> 9
    IrOwnedDropI64(value, type_hash) -> 31
    IrArrayStorageI64(dst, byte_size, align) -> 44
    IrArrayCopyI64(dst_data, src_data, byte_size, leaf_count, leaf_stride, leaf_kind) -> 45
    IrArrayDropI64(data, leaf_count, leaf_stride, leaf_kind) -> 43
    IrVariantInitI64(dst, tag_hash, payloads, field_mask) -> 13
    IrVariantTagI64(dst, base) -> 14
    IrVariantPayloadI64(dst, base, index) -> 15
    IrRecordInitI64(dst, type_hash, fields) -> 10
    IrRecordLayoutInitI64(dst, type_hash, data_size, align, fields) -> 46
    IrRecordLayoutArrayLoadI64(dst_data, base, record_data_size, byte_offset, byte_size, leaf_count, leaf_stride, leaf_kind) -> 47
    IrRecordLayoutWordLoadI64(dst, base, record_data_size, field_hash, byte_offset) -> 48
    IrFieldLoadI64(dst, base, field_hash, field_index) -> 11
    IrSlotI64(slot) -> 5
    IrLoadI64(dst, slot) -> 6
    IrStoreI64(slot, value) -> 7
    IrManagedStakeI64(dst, value, cleanup_kind, delta, origin) -> 50
    IrManagedTransferI64(call_dst, callee_hash, value, arg_lane, cleanup_kind) -> 51
    IrReuseInitI64(token, constructor) -> 49
  }
}

pub(package) fn ir_inst_const_value_or(inst: IrInst, default: i64) -> i64 {
  match inst {
    IrConstI64(dst, value) -> value
    IrNilI64(dst) -> 0
    IrStringLit(dst, start, len) -> default
    IrStringConcatI64(dst, left, right) -> default
    IrBinaryI64(dst, op, lhs, rhs) -> default
    IrFloatBinaryI64(dst, prim, op, lhs, rhs) -> default
    IrUnaryI64(dst, op, value) -> default
    IrClosureI64(dst, f, captures, eff) -> default
    IrFunctionRefI64(dst, callee_hash) -> default
    IrGenericFunctionRefI64(dst, callee_hash, type_args) -> default
    IrAddressOfSlotI64(dst, slot) -> default
    IrPtrLoadI64(dst, ptr) -> default
    IrPtrStoreI64(dst, ptr, value) -> default
    IrLoweringFailureI64(reason) -> default
    IrPerformI64(dst, effect_hash, op_hash, args) -> default
    IrHandlerDirectI64(dst, effect_hash, op_hash, handler_depth, clause_index, args) -> default
    IrHandlerPopI64(frame) -> default
    IrAbortLandingI64(dst) -> default
    IrBindI64(ns, nl, value, ty) -> default
    IrHandleI64(dst, src, body, clauses, nclauses, captures) -> default
    IrDeferredHandleI64(dst, src, body, clauses, nclauses, captures, scratch_base) -> default
    IrResumeI64(dst, value) -> default
    IrTryI64(dst, value, effect_key) -> default
    IrOptChainI64(dst, base, field_hash, field_index, effect_key) -> default
    IrCallI64(dst, callee_hash, args) -> default
    IrCallResultLaneI64(dst, lane) -> default
    IrReturnLaneI64(lane, value) -> default
    IrIndirectCallI64(dst, callee, args) -> default
    IrGenericCallI64(dst, callee_hash, type_args, args) -> default
    IrVectorGetI64(dst, vec, index, fallback, check_mode) -> default
    IrVectorSetI64(dst, vec, index, value, check_mode) -> default
    IrMethodCallI64(dst, type_hash, method_hash, receiver, args) -> default
    IrOwnedDropI64(value, type_hash) -> default
    IrArrayStorageI64(dst, byte_size, align) -> default
    IrArrayCopyI64(dst_data, src_data, byte_size, leaf_count, leaf_stride, leaf_kind) -> default
    IrArrayDropI64(data, leaf_count, leaf_stride, leaf_kind) -> default
    IrVariantInitI64(dst, tag_hash, payloads, field_mask) -> default
    IrVariantTagI64(dst, base) -> default
    IrVariantPayloadI64(dst, base, index) -> default
    IrRecordInitI64(dst, type_hash, fields) -> default
    IrRecordLayoutInitI64(dst, type_hash, data_size, align, fields) -> default
    IrRecordLayoutArrayLoadI64(dst_data, base, record_data_size, byte_offset, byte_size, leaf_count, leaf_stride, leaf_kind) -> default
    IrRecordLayoutWordLoadI64(dst, base, record_data_size, field_hash, byte_offset) -> default
    IrFieldLoadI64(dst, base, field_hash, field_index) -> default
    IrSlotI64(slot) -> default
    IrLoadI64(dst, slot) -> default
    IrStoreI64(slot, value) -> default
    IrManagedStakeI64(dst, value, cleanup_kind, delta, origin) -> default
    IrManagedTransferI64(call_dst, callee_hash, value, arg_lane, cleanup_kind) -> default
    IrReuseInitI64(token, constructor) -> ir_inst_const_value_or(constructor, default)
  }
}

