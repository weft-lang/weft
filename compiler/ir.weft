pub(package) type TypeImplMember {
  TypeImplMethod(i64, i64, ParamList, TypeExpr, EffectSig, Expr), -- tag 23 wrapper: name, typed params/ret/effects/body
  TypeImplAssocType(i64, i64, TypeExpr),                    -- tag 43: associated type binding
  MissingTypeImplMember
}

pub(package) type TypeImplMemberList {
  TypeImplMemberListNil,
  TypeImplMemberListCons(TypeImplMember, TypeImplMemberList)
}

pub(package) fn type_impl_member_list_empty() -> TypeImplMemberList {
  TypeImplMemberListNil
}

pub(package) fn type_impl_member_from_node(node: i64) -> TypeImplMember {
  if raw_bridge_is_missing(node) == 1 { MissingTypeImplMember }
  else {
    match node_tag(node) {
      23 -> {
        let inner = node_f1(node)
        let ns = if raw_bridge_is_missing(inner) == 1 { 0 } else { node_f1(inner) }
        let nl = if raw_bridge_is_missing(inner) == 1 { 0 } else { node_f2(inner) }
        let params = if raw_bridge_is_missing(inner) == 1 { ParamListNil } else { param_list_from_param_nodes(node_f3(inner)) }
        let body = if raw_bridge_is_missing(inner) == 1 { expr_from_node(0) } else { expr_from_node(node_f4(inner)) }
        TypeImplMethod(ns, nl, params, type_expr_from_node(node_f2(node)), effect_sig_from_node(node_f3(node)), body)
      }
      43 -> TypeImplAssocType(node_f1(node), node_f2(node), type_expr_from_node(node_f3(node)))
      _ -> MissingTypeImplMember
    }
  }
}

pub(package) fn type_impl_member_list_from_nodes(nodes: i64, index: i64, count: i64) -> TypeImplMemberList {
  if raw_bridge_is_missing(nodes) == 1 { TypeImplMemberListNil }
  else { if index >= count { TypeImplMemberListNil }
  else {
    TypeImplMemberListCons(type_impl_member_from_node(nlist_get(nodes, index)), type_impl_member_list_from_nodes(nodes, index + 1, count))
  } }
}

pub(package) fn type_impl_member_list_from_decl_nodes(nodes: i64) -> TypeImplMemberList {
  if raw_bridge_is_missing(nodes) == 1 { TypeImplMemberListNil }
  else { type_impl_member_list_from_nodes(nodes, 0, raw_bridge_list_len_or_zero(nodes)) }
}

