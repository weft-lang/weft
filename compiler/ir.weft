}

pub(package) fn type_impl_member_list_nth_name_len_or(members: TypeImplMemberList, index: i64, default: i64) -> i64 {
  type_impl_member_name_len_or(type_impl_member_list_nth(members, index), default)
}

pub(package) fn type_impl_member_list_nth_method_param_count_or(members: TypeImplMemberList, index: i64, default: i64) -> i64 {
  type_impl_member_method_param_count_or(type_impl_member_list_nth(members, index), default)
}

pub(package) fn type_impl_member_list_nth_method_param_name_len_or(members: TypeImplMemberList, member_index: i64, param_index: i64, default: i64) -> i64 {
  param_list_nth_name_len_or(type_impl_member_method_params(type_impl_member_list_nth(members, member_index)), param_index, default)
}

pub(package) fn type_impl_member_list_nth_method_param_type_tag_or(members: TypeImplMemberList, member_index: i64, param_index: i64, default: i64) -> i64 {
  param_list_nth_type_tag_or(type_impl_member_method_params(type_impl_member_list_nth(members, member_index)), param_index, default)
}

pub(package) fn type_impl_member_list_nth_method_param_type_prim_id_or(members: TypeImplMemberList, member_index: i64, param_index: i64, default: i64) -> i64 {
  param_list_nth_type_prim_id_or(type_impl_member_method_params(type_impl_member_list_nth(members, member_index)), param_index, default)
}

pub(package) fn type_impl_member_list_nth_method_return_type_tag_or(members: TypeImplMemberList, index: i64, default: i64) -> i64 {
  type_impl_member_method_return_type_tag_or(type_impl_member_list_nth(members, index), default)
}

pub(package) fn type_impl_member_list_nth_method_return_type_prim_id_or(members: TypeImplMemberList, index: i64, default: i64) -> i64 {
  type_impl_member_method_return_type_prim_id_or(type_impl_member_list_nth(members, index), default)
}

pub(package) fn type_impl_member_list_nth_method_effect_count_or(members: TypeImplMemberList, index: i64, default: i64) -> i64 {
  type_impl_member_method_effect_count_or(type_impl_member_list_nth(members, index), default)
}

pub(package) fn type_impl_member_list_nth_method_body_tag_or(members: TypeImplMemberList, index: i64, default: i64) -> i64 {
  type_impl_member_method_body_tag_or(type_impl_member_list_nth(members, index), default)
}

pub(package) fn type_impl_member_list_nth_assoc_type_tag_or(members: TypeImplMemberList, index: i64, default: i64) -> i64 {
  type_impl_member_assoc_type_tag_or(type_impl_member_list_nth(members, index), default)
}

pub(package) fn type_impl_member_list_nth_assoc_type_prim_id_or(members: TypeImplMemberList, index: i64, default: i64) -> i64 {
  type_impl_member_assoc_type_prim_id_or(type_impl_member_list_nth(members, index), default)
}

pub(package) fn type_impl_member_tree_unknown_count(member: TypeImplMember) -> i64 {
  match member {
    TypeImplMethod(ns, nl, params, ret_type, effects, body) -> param_list_tree_unknown_count(params) + type_expr_tree_unknown_count(ret_type) + effect_sig_tree_unknown_count(effects) + expr_tree_unknown_count(body)
    TypeImplAssocType(ns, nl, ty) -> type_expr_tree_unknown_count(ty)
    MissingTypeImplMember -> 1
  }
}

pub(package) fn type_impl_member_list_tree_unknown_count(members: TypeImplMemberList) -> i64 {
  match members {
    TypeImplMemberListNil -> 0
    TypeImplMemberListCons(member, rest) -> type_impl_member_tree_unknown_count(member) + type_impl_member_list_tree_unknown_count(rest)
  }
}

pub(package) fn type_impl_member_tree_raw_bridge_slot_count(member: TypeImplMember) -> i64 {
  match member {
    TypeImplMethod(ns, nl, params, ret_type, effects, body) -> param_list_tree_raw_bridge_slot_count(params) + type_expr_tree_raw_bridge_slot_count(ret_type) + effect_sig_tree_raw_bridge_slot_count(effects) + expr_tree_raw_bridge_slot_count(body)
    TypeImplAssocType(ns, nl, ty) -> type_expr_tree_raw_bridge_slot_count(ty)
    MissingTypeImplMember -> 0
  }
}

pub(package) fn type_impl_member_list_tree_raw_bridge_slot_count(members: TypeImplMemberList) -> i64 {
  match members {
    TypeImplMemberListNil -> 0
    TypeImplMemberListCons(member, rest) -> type_impl_member_tree_raw_bridge_slot_count(member) + type_impl_member_list_tree_raw_bridge_slot_count(rest)
  }
}

pub(package) fn type_entry_tree_raw_bridge_slot_count(entry: TypeEntry) -> i64 {
  let self = type_entry_raw_bridge_slot_count(entry)
  match entry {
    TypeRecordEntry(name, tparams, fields) -> self + type_param_list_tree_raw_bridge_slot_count(tparams) + type_record_field_list_type_tree_raw_bridge_slot_count(fields)
    TypeVariantEntry(name, tparams, variants) -> self + type_param_list_tree_raw_bridge_slot_count(tparams) + type_variant_list_tree_raw_bridge_slot_count(variants)
    TypeEffectEntry(name, tparams, ops) -> self + type_param_list_tree_raw_bridge_slot_count(tparams) + type_effect_op_list_tree_raw_bridge_slot_count(ops)
    TypeTraitEntry(name, tparams, members) -> self + type_param_list_tree_raw_bridge_slot_count(tparams) + type_trait_member_list_tree_raw_bridge_slot_count(members)
    TypeImplEntry(name, tparams, members) -> self + type_param_list_tree_raw_bridge_slot_count(tparams) + type_impl_member_list_tree_raw_bridge_slot_count(members)
    TypeOpaqueEntry(name, tparams) -> self + type_param_list_tree_raw_bridge_slot_count(tparams)
    _ -> self
  }
}

pub(package) fn type_entry_tree_unknown_count(entry: TypeEntry) -> i64 {
  let self = type_entry_unknown_count(entry)
  match entry {
    TypeRecordEntry(name, tparams, fields) -> self + type_param_list_tree_unknown_count(tparams) + type_record_field_list_type_tree_unknown_count(fields)
    TypeVariantEntry(name, tparams, variants) -> self + type_param_list_tree_unknown_count(tparams) + type_variant_list_tree_unknown_count(variants)
    TypeEffectEntry(name, tparams, ops) -> self + type_param_list_tree_unknown_count(tparams) + type_effect_op_list_tree_unknown_count(ops)
    TypeTraitEntry(name, tparams, members) -> self + type_param_list_tree_unknown_count(tparams) + type_trait_member_list_tree_unknown_count(members)
    TypeImplEntry(name, tparams, members) -> self + type_param_list_tree_unknown_count(tparams) + type_impl_member_list_tree_unknown_count(members)
    TypeOpaqueEntry(name, tparams) -> self + type_param_list_tree_unknown_count(tparams)
    _ -> self
  }
}

pub(package) fn type_entry_list_tree_raw_bridge_slot_count(entries: TypeEntryList) -> i64 {
  match entries {
    TypeEntryListNil -> 0
    TypeEntryListCons(entry, rest) -> type_entry_tree_raw_bridge_slot_count(entry) + type_entry_list_tree_raw_bridge_slot_count(rest)
  }
}

-- ══════════════════════════════════════════════════════════════
-- Handler clauses
-- ══════════════════════════════════════════════════════════════

pub(package) type HandlerClauseName {
  HandlerClauseName(Expr, i64, i64), -- effect reference, op_ns, op_nl
  UnknownHandlerClauseName
}

-- 4c §7.3: optional `return v -> expr` clause on a handle — transforms
-- the NORMAL completion value only; abortive clause values bypass it.
pub(package) type HandleReturn {
  NoHandleReturn,
  HandleReturnClause(i64, i64, Expr) -- binder_ns, binder_nl, body
}

pub(package) fn handle_return_from_node(node: i64) -> HandleReturn {
  if node == 0 { NoHandleReturn }
  else { HandleReturnClause(node_f1(node), node_f2(node), expr_from_node(node_f3(node))) }
}

pub(package) fn handle_return_to_node(hret: HandleReturn) -> i64 {
  match hret {
    NoHandleReturn -> 0
    HandleReturnClause(ns, nl, body) -> node_new(0, ns, nl, expr_to_node(body), 0)
  }
}

pub(package) fn handle_return_tree_unknown_count(hret: HandleReturn) -> i64 {
  match hret {
    NoHandleReturn -> 0
    HandleReturnClause(ns, nl, body) -> expr_tree_unknown_count(body)
  }
}

pub(package) fn handle_return_tree_raw_bridge_slot_count(hret: HandleReturn) -> i64 {
  match hret {
    NoHandleReturn -> 0
    HandleReturnClause(ns, nl, body) -> expr_tree_raw_bridge_slot_count(body)
  }
}

pub(package) type HandlerClause {
  HandlerClause(HandlerClauseName, ParamList, Expr, HandlerClauseContinuation), -- tag 34: typed name info/params/body/optional deferred continuation
  UnknownHandlerClause(i64)
}

pub(package) type HandlerClauseContinuation {
  HandlerClauseNoContinuation,
  HandlerClauseContinuation(i64, i64),
  UnknownHandlerClauseContinuation
}

pub(package) type HandlerClauseList {
  HandlerClauseListNil,
  HandlerClauseListCons(HandlerClause, HandlerClauseList)
}

pub(package) fn handler_clause_name_from_node(node: i64) -> HandlerClauseName {
  if raw_bridge_is_missing(node) == 1 { UnknownHandlerClauseName }
  else { HandlerClauseName(expr_from_node(node_f1(node)), node_f2(node), node_f3(node)) }
}

pub(package) fn handler_clause_continuation_from_node(node: i64) -> HandlerClauseContinuation {
  if raw_bridge_is_missing(node) == 1 { HandlerClauseNoContinuation }
  else {
    HandlerClauseContinuation(node_f1(node), node_f2(node))
  }
}

pub(package) fn handler_clause_from_node(node: i64) -> HandlerClause {
  if raw_bridge_is_missing(node) == 1 { UnknownHandlerClause(0) }
  else {
    match node_tag(node) {
      34 -> HandlerClause(handler_clause_name_from_node(node_f1(node)), param_list_from_param_nodes(node_f2(node)), expr_from_node(node_f3(node)), handler_clause_continuation_from_node(node_f4(node)))
      _ -> UnknownHandlerClause(node_tag(node))
    }
  }
}

pub(package) fn handler_clause_tag(clause: HandlerClause) -> i64 {
  match clause {
    HandlerClause(name_info, params, body, continuation) -> 34
    UnknownHandlerClause(tag) -> tag
  }
}

pub(package) fn handler_clause_body_expr(clause: HandlerClause) -> Expr {
  match clause {
    HandlerClause(name_info, params, body, continuation) -> body
    UnknownHandlerClause(tag) -> UnknownExpr(0)
  }
}

pub(package) fn handler_clause_param_count_or(clause: HandlerClause, default: i64) -> i64 {
  match clause {
    HandlerClause(name_info, params, body, continuation) -> param_list_len(params)
    UnknownHandlerClause(tag) -> default
  }
}

pub(package) fn handler_clause_params(clause: HandlerClause) -> ParamList {
  match clause {
    HandlerClause(name_info, params, body, continuation) -> params
    UnknownHandlerClause(tag) -> ParamListNil
  }
}

pub(package) fn handler_clause_continuation(clause: HandlerClause) -> HandlerClauseContinuation {
  match clause {
    HandlerClause(name_info, params, body, continuation) -> continuation
    UnknownHandlerClause(tag) -> UnknownHandlerClauseContinuation
  }
}

pub(package) fn handler_clause_has_continuation(clause: HandlerClause) -> i64 {
  match handler_clause_continuation(clause) {
    HandlerClauseContinuation(ns, nl) -> 1
    _ -> 0
  }
}

pub(package) fn handler_clause_continuation_name_len_or(clause: HandlerClause, default: i64) -> i64 {
  match handler_clause_continuation(clause) {
    HandlerClauseContinuation(ns, nl) -> nl
    _ -> default
  }
}

pub(package) fn handler_clause_effect_name_len_or(clause: HandlerClause, default: i64) -> i64 {
  match clause {
    HandlerClause(name_info, params, body, continuation) -> {
      match name_info {
        HandlerClauseName(effect_ref, op_ns, op_nl) -> {
          match effect_ref {
            Ident(eff_ns, eff_nl) -> eff_nl
            GenericCall(type_args, inner) -> {
              match inner {
                Ident(eff_ns, eff_nl) -> eff_nl
                _ -> default
              }
            }
            _ -> default
          }
        }
        UnknownHandlerClauseName -> default
      }
    }
    UnknownHandlerClause(tag) -> default
  }
}

pub(package) fn handler_clause_op_name_len_or(clause: HandlerClause, default: i64) -> i64 {
  match clause {
    HandlerClause(name_info, params, body, continuation) -> {
      match name_info {
        HandlerClauseName(effect_ref, op_ns, op_nl) -> op_nl
        UnknownHandlerClauseName -> default
      }
    }
    UnknownHandlerClause(tag) -> default
  }
}

pub(package) fn handler_clause_list_empty() -> HandlerClauseList {
  HandlerClauseListNil
}

pub(package) fn handler_clause_list_from_nodes(nodes: i64, index: i64, count: i64) -> HandlerClauseList {
  if raw_bridge_is_missing(nodes) == 1 { HandlerClauseListNil }
  else { if index >= count { HandlerClauseListNil }
  else {
    HandlerClauseListCons(handler_clause_from_node(nlist_get(nodes, index)), handler_clause_list_from_nodes(nodes, index + 1, count))
  } }
}

pub(package) fn expr_handle_clauses(expr: Expr) -> HandlerClauseList {
  match expr {
    Handle(body, clauses, hret) -> clauses
    _ -> HandlerClauseListNil
  }
}

pub(package) fn expr_handle_body_tag_or(expr: Expr, default: i64) -> i64 {
  match expr {
    Handle(body, clauses, hret) -> expr_tag(body)
    _ -> default
  }
}

pub(package) fn expr_handle_clause_count_or(expr: Expr, default: i64) -> i64 {
  match expr {
    Handle(body, clauses, hret) -> handler_clause_list_len(clauses)
    _ -> default
  }
}

pub(package) fn handler_clause_list_len(clauses: HandlerClauseList) -> i64 {
  match clauses {
    HandlerClauseListNil -> 0
    HandlerClauseListCons(clause, rest) -> 1 + handler_clause_list_len(rest)
  }
}

pub(package) fn handler_clause_list_nth(clauses: HandlerClauseList, index: i64) -> HandlerClause {
  match clauses {
    HandlerClauseListNil -> UnknownHandlerClause(0)
    HandlerClauseListCons(clause, rest) -> {
      if index == 0 { clause } else { handler_clause_list_nth(rest, index - 1) }
    }
  }
}

pub(package) fn handler_clause_list_nth_tag_or(clauses: HandlerClauseList, index: i64, default: i64) -> i64 {
  match clauses {
    HandlerClauseListNil -> default
    HandlerClauseListCons(clause, rest) -> {
      if index == 0 { handler_clause_tag(clause) }
      else { handler_clause_list_nth_tag_or(rest, index - 1, default) }
    }
  }
}

pub(package) fn handler_clause_list_nth_param_count_or(clauses: HandlerClauseList, index: i64, default: i64) -> i64 {
  match clauses {
    HandlerClauseListNil -> default
    HandlerClauseListCons(clause, rest) -> {
      if index == 0 { handler_clause_param_count_or(clause, default) }
      else { handler_clause_list_nth_param_count_or(rest, index - 1, default) }
    }
  }
}

pub(package) fn handler_clause_list_nth_params(clauses: HandlerClauseList, index: i64) -> ParamList {
  handler_clause_params(handler_clause_list_nth(clauses, index))
}

pub(package) fn handler_clause_list_nth_body_tag_or(clauses: HandlerClauseList, index: i64, default: i64) -> i64 {
  match clauses {
    HandlerClauseListNil -> default
    HandlerClauseListCons(clause, rest) -> {
      if index == 0 { expr_tag(handler_clause_body_expr(clause)) }
      else { handler_clause_list_nth_body_tag_or(rest, index - 1, default) }
    }
  }
}

pub(package) fn handler_clause_list_nth_effect_name_len_or(clauses: HandlerClauseList, index: i64, default: i64) -> i64 {
  match clauses {
    HandlerClauseListNil -> default
    HandlerClauseListCons(clause, rest) -> {
      if index == 0 { handler_clause_effect_name_len_or(clause, default) }
      else { handler_clause_list_nth_effect_name_len_or(rest, index - 1, default) }
    }
  }
}

pub(package) fn handler_clause_list_nth_op_name_len_or(clauses: HandlerClauseList, index: i64, default: i64) -> i64 {
  match clauses {
    HandlerClauseListNil -> default
    HandlerClauseListCons(clause, rest) -> {
      if index == 0 { handler_clause_op_name_len_or(clause, default) }
      else { handler_clause_list_nth_op_name_len_or(rest, index - 1, default) }
    }
  }
}

pub(package) fn handler_clause_list_nth_has_continuation_or(clauses: HandlerClauseList, index: i64, default: i64) -> i64 {
  match clauses {
    HandlerClauseListNil -> default
    HandlerClauseListCons(clause, rest) -> {
      if index == 0 { handler_clause_has_continuation(clause) }
      else { handler_clause_list_nth_has_continuation_or(rest, index - 1, default) }
    }
  }
}

pub(package) fn handler_clause_list_nth_continuation_name_len_or(clauses: HandlerClauseList, index: i64, default: i64) -> i64 {
  match clauses {
    HandlerClauseListNil -> default
    HandlerClauseListCons(clause, rest) -> {
      if index == 0 { handler_clause_continuation_name_len_or(clause, default) }
      else { handler_clause_list_nth_continuation_name_len_or(rest, index - 1, default) }
    }
  }
}

-- ══════════════════════════════════════════════════════════════
-- Patterns (for match arms)
-- ══════════════════════════════════════════════════════════════

pub(package) type Pattern {
  Wildcard,                        -- tag 17
  Binding(i64, i64),               -- tag 18: f1=ns, f2=nl
  IntPattern(i64, i64, i64),       -- tag 19: f1=value, f2/f3=optional source span
  CtorPattern(i64, i64, PatternList, i64), -- constructor span, typed bindings, optional DeclFact
  TypedBinding(i64, i64, i64),     -- tag 60: f1=ns, f2=nl, f3=annotation (a ty)
  NilPattern(i64, i64),            -- tag 61: f1=ns, f2=nl (source span of `nil`)
  RecordPattern(PatternFieldList), -- tag 64: selected named fields + checker layout facts
  TuplePattern(PatternList),       -- tag 65: exact positional children
  UnknownPattern(i64)
}

pub(package) type PatternList {
  PatternListNil,
  PatternListCons(Pattern, PatternList)
}

pub(package) type PatternField {
  PatternField(i64, i64, Pattern, FieldAccessFact), -- raw field tag 66
  UnknownPatternField(i64)
}

pub(package) type PatternFieldList {
  PatternFieldListNil,
  PatternFieldListCons(PatternField, PatternFieldList)
}

pub(package) fn pattern_field_from_node(node: i64) -> PatternField {
  if raw_bridge_is_missing(node) == 1 { UnknownPatternField(0) }
  else {
    match node_tag(node) {
      66 -> PatternField(node_f1(node), node_f2(node), pattern_from_node(node_f3(node)), field_access_fact_from_node(node_f4(node)))
      _ -> UnknownPatternField(node_tag(node))
    }
  }
}

pub(package) fn pattern_field_list_from_nodes(nodes: i64, index: i64, count: i64) -> PatternFieldList {
  if raw_bridge_is_missing(nodes) == 1 or index >= count { PatternFieldListNil }
  else { PatternFieldListCons(pattern_field_from_node(nlist_get(nodes, index)), pattern_field_list_from_nodes(nodes, index + 1, count)) }
}

pub(package) fn pattern_field_list_len(fields: PatternFieldList) -> i64 {
  match fields {
    PatternFieldListNil -> 0
    PatternFieldListCons(field, rest) -> 1 + pattern_field_list_len(rest)
  }
}

pub(package) fn pattern_ctor_binding_list_from_raw(bindings: i64, count: i64) -> PatternList {
  if count > 0 {
    PatternListCons(Binding(bindings, count), PatternListNil)
  } else {
    if count < 0 {
      if raw_bridge_is_missing(bindings) == 1 { PatternListNil } else { pattern_list_from_nodes(bindings, 0, 0 - count) }
    }
    else { PatternListNil }
  }
}

pub(package) fn pattern_from_node(node: i64) -> Pattern {
  if raw_bridge_is_missing(node) == 1 { UnknownPattern(0) }
  else {
    match node_tag(node) {
      17 -> Wildcard
      18 -> Binding(node_f1(node), node_f2(node))
      19 -> IntPattern(node_f1(node), node_f2(node), node_f3(node))
      20 -> CtorPattern(node_f1(node), node_f2(node), pattern_ctor_binding_list_from_raw(node_f3(node), node_f4(node)), 0)
      67 -> {
        let raw = node_f1(node)
        CtorPattern(node_f1(raw), node_f2(raw), pattern_ctor_binding_list_from_raw(node_f3(raw), node_f4(raw)), node_f2(node))
      }
      60 -> TypedBinding(node_f1(node), node_f2(node), node_f3(node))
      61 -> NilPattern(node_f1(node), node_f2(node))
      64 -> RecordPattern(pattern_field_list_from_nodes(node_f1(node), 0, node_f2(node)))
      65 -> TuplePattern(pattern_list_from_nodes(node_f1(node), 0, node_f2(node)))
      _ -> UnknownPattern(node_tag(node))
    }
  }
}

pub(package) fn pattern_tag(pattern: Pattern) -> i64 {
  match pattern {
    Wildcard -> 17
    Binding(ns, nl) -> 18
    IntPattern(value, start, len) -> 19
    CtorPattern(tag_ns, tag_nl, bindings, declaration) -> 20
    TypedBinding(ns, nl, ann) -> 60
    NilPattern(ns, nl) -> 61
    RecordPattern(fields) -> 64
    TuplePattern(items) -> 65
    UnknownPattern(tag) -> tag
  }
}

pub(package) fn pattern_ctor_binding_count_or(pattern: Pattern, default: i64) -> i64 {
  match pattern {
    CtorPattern(tag_ns, tag_nl, bindings, declaration) -> pattern_list_len(bindings)
    _ -> default
  }
}

pub(package) fn pattern_ctor_bindings(pattern: Pattern) -> PatternList {
  match pattern {
    CtorPattern(tag_ns, tag_nl, bindings, declaration) -> bindings
    _ -> PatternListNil
  }
}

pub(package) fn pattern_binding_name_len_or(pattern: Pattern, default: i64) -> i64 {
  match pattern {
    Binding(ns, nl) -> nl
    _ -> default
  }
}

pub(package) fn pattern_list_empty() -> PatternList {
  PatternListNil
}

pub(package) fn pattern_list_from_nodes(nodes: i64, index: i64, count: i64) -> PatternList {
  if raw_bridge_is_missing(nodes) == 1 { PatternListNil }
  else { if index >= count { PatternListNil }
  else {
    PatternListCons(pattern_from_node(nlist_get(nodes, index)), pattern_list_from_nodes(nodes, index + 1, count))
  } }
}

pub(package) fn pattern_list_len(patterns: PatternList) -> i64 {
  match patterns {
    PatternListNil -> 0
    PatternListCons(pattern, rest) -> 1 + pattern_list_len(rest)
  }
}

pub(package) fn pattern_list_count_tag(patterns: PatternList, tag: i64) -> i64 {
  match patterns {
    PatternListNil -> 0
    PatternListCons(pattern, rest) -> {
      let add = if pattern_tag(pattern) == tag { 1 } else { 0 }
      add + pattern_list_count_tag(rest, tag)
    }
  }
}

pub(package) fn pattern_list_nth_tag_or(patterns: PatternList, index: i64, default: i64) -> i64 {
  match patterns {
    PatternListNil -> default
    PatternListCons(pattern, rest) -> {
      if index == 0 { pattern_tag(pattern) }
      else { pattern_list_nth_tag_or(rest, index - 1, default) }
    }
  }
}

pub(package) fn pattern_list_nth_binding_name_len_or(patterns: PatternList, index: i64, default: i64) -> i64 {
  match patterns {
    PatternListNil -> default
    PatternListCons(pattern, rest) -> {
      if index == 0 { pattern_binding_name_len_or(pattern, default) }
      else { pattern_list_nth_binding_name_len_or(rest, index - 1, default) }
    }
  }
}

-- ══════════════════════════════════════════════════════════════
-- Match arms
-- ══════════════════════════════════════════════════════════════

pub(package) type MatchArm {
  Arm(Pattern, Expr, Expr, i64),  -- tag 16: typed pattern/body/guard, has_guard flag
  UnknownArm(i64)
}

pub(package) type MatchArmList {
  MatchArmListNil,
  MatchArmListCons(MatchArm, MatchArmList)
}

pub(package) fn match_arm_from_node(node: i64) -> MatchArm {
  if raw_bridge_is_missing(node) == 1 { UnknownArm(0) }
  else {
    match node_tag(node) {
      16 -> Arm(pattern_from_node(node_f1(node)), expr_from_node(node_f2(node)), expr_from_node(node_f3(node)), if node_f3(node) == 0 { 0 } else { 1 })
      _ -> UnknownArm(node_tag(node))
    }
  }
}

pub(package) fn match_arm_tag(arm: MatchArm) -> i64 {
  match arm {
    Arm(pattern, body, guard, has_guard) -> 16
    UnknownArm(tag) -> tag
  }
}

pub(package) fn match_arm_pattern(arm: MatchArm) -> Pattern {
  match arm {
    Arm(pattern, body, guard, has_guard) -> pattern
    UnknownArm(tag) -> UnknownPattern(0)
  }
}

pub(package) fn match_arm_body_expr(arm: MatchArm) -> Expr {
  match arm {
    Arm(pattern, body, guard, has_guard) -> body
    UnknownArm(tag) -> UnknownExpr(0)
  }
}

pub(package) fn match_arm_guard_expr(arm: MatchArm) -> Expr {
  match arm {
    Arm(pattern, body, guard, has_guard) -> guard
    UnknownArm(tag) -> UnknownExpr(0)
  }
}

pub(package) fn match_arm_has_guard(arm: MatchArm) -> i64 {
  match arm {
    Arm(pattern, body, guard, has_guard) -> has_guard
    UnknownArm(tag) -> 0
  }
}

pub(package) fn match_arm_list_empty() -> MatchArmList {
  MatchArmListNil
}

pub(package) fn match_arm_list_from_nodes(nodes: i64, index: i64, count: i64) -> MatchArmList {
  if raw_bridge_is_missing(nodes) == 1 { MatchArmListNil }
  else { if index >= count { MatchArmListNil }
  else {
    MatchArmListCons(match_arm_from_node(nlist_get(nodes, index)), match_arm_list_from_nodes(nodes, index + 1, count))
  } }
}

pub(package) fn expr_match_arms(expr: Expr) -> MatchArmList {
  match expr {
    Match(scrutinee, arms) -> arms
    _ -> MatchArmListNil
  }
}

pub(package) fn expr_match_scrutinee_tag_or(expr: Expr, default: i64) -> i64 {
  match expr {
    Match(scrutinee, arms) -> expr_tag(scrutinee)
    _ -> default
  }
}

pub(package) fn match_arm_list_len(arms: MatchArmList) -> i64 {
  match arms {
    MatchArmListNil -> 0
    MatchArmListCons(arm, rest) -> 1 + match_arm_list_len(rest)
  }
}

pub(package) fn match_arm_list_nth(arms: MatchArmList, index: i64) -> MatchArm {
  match arms {
    MatchArmListNil -> UnknownArm(0)
    MatchArmListCons(arm, rest) -> {
      if index == 0 { arm }
      else { match_arm_list_nth(rest, index - 1) }
    }
  }
}

pub(package) fn match_arm_list_count_pattern_tag(arms: MatchArmList, tag: i64) -> i64 {
  match arms {
    MatchArmListNil -> 0
    MatchArmListCons(arm, rest) -> {
      let add = if pattern_tag(match_arm_pattern(arm)) == tag { 1 } else { 0 }
      add + match_arm_list_count_pattern_tag(rest, tag)
    }
  }
}

pub(package) fn match_arm_list_nth_pattern_tag_or(arms: MatchArmList, index: i64, default: i64) -> i64 {
  match arms {
    MatchArmListNil -> default
    MatchArmListCons(arm, rest) -> if index == 0 { pattern_tag(match_arm_pattern(arm)) } else { match_arm_list_nth_pattern_tag_or(rest, index - 1, default) }
  }
}

pub(package) fn match_arm_list_nth_ctor_binding_count_or(arms: MatchArmList, index: i64, default: i64) -> i64 {
  match arms {
    MatchArmListNil -> default
    MatchArmListCons(arm, rest) -> if index == 0 { pattern_ctor_binding_count_or(match_arm_pattern(arm), default) } else { match_arm_list_nth_ctor_binding_count_or(rest, index - 1, default) }
  }
}

pub(package) fn match_arm_list_nth_ctor_bindings(arms: MatchArmList, index: i64) -> PatternList {
  match arms {
    MatchArmListNil -> PatternListNil
    MatchArmListCons(arm, rest) -> {
      if index == 0 { pattern_ctor_bindings(match_arm_pattern(arm)) }
      else { match_arm_list_nth_ctor_bindings(rest, index - 1) }
    }
  }
}

pub(package) fn match_arm_list_nth_ctor_binding_tag_or(arms: MatchArmList, index: i64, binding_index: i64, default: i64) -> i64 {
  pattern_list_nth_tag_or(match_arm_list_nth_ctor_bindings(arms, index), binding_index, default)
}

pub(package) fn match_arm_list_nth_ctor_binding_name_len_or(arms: MatchArmList, index: i64, binding_index: i64, default: i64) -> i64 {
  pattern_list_nth_binding_name_len_or(match_arm_list_nth_ctor_bindings(arms, index), binding_index, default)
}

pub(package) fn match_arm_list_nth_body_tag_or(arms: MatchArmList, index: i64, default: i64) -> i64 {
  match arms {
    MatchArmListNil -> default
    MatchArmListCons(arm, rest) -> if index == 0 { expr_tag(match_arm_body_expr(arm)) } else { match_arm_list_nth_body_tag_or(rest, index - 1, default) }
  }
}

pub(package) fn match_arm_list_nth_guard_tag_or(arms: MatchArmList, index: i64, default: i64) -> i64 {
  match arms {
    MatchArmListNil -> default
    MatchArmListCons(arm, rest) -> {
      if index == 0 {
        if match_arm_has_guard(arm) == 0 { default } else { expr_tag(match_arm_guard_expr(arm)) }
      } else { match_arm_list_nth_guard_tag_or(rest, index - 1, default) }
    }
  }
}

pub(package) fn match_arm_list_nth_has_guard_or(arms: MatchArmList, index: i64, default: i64) -> i64 {
  match arms {
    MatchArmListNil -> default
    MatchArmListCons(arm, rest) -> if index == 0 { match_arm_has_guard(arm) } else { match_arm_list_nth_has_guard_or(rest, index - 1, default) }
  }
}

pub(package) fn expr_node_tree_unknown_count(node: i64) -> i64 {
  if node == 0 { 0 } else { expr_tree_unknown_count(expr_from_node(node)) }
}

pub(package) fn expr_node_tree_raw_bridge_slot_count(node: i64) -> i64 {
  if node == 0 { 0 } else { expr_tree_raw_bridge_slot_count(expr_from_node(node)) }
}

pub(package) fn expr_list_tree_unknown_count(exprs: ExprList) -> i64 {
  match exprs {
    ExprListNil -> 0
    ExprListCons(expr, rest) -> expr_tree_unknown_count(expr) + expr_list_tree_unknown_count(rest)
  }
}

pub(package) fn expr_list_tree_raw_bridge_slot_count(exprs: ExprList) -> i64 {
  match exprs {
    ExprListNil -> 0
    ExprListCons(expr, rest) -> expr_tree_raw_bridge_slot_count(expr) + expr_list_tree_raw_bridge_slot_count(rest)
  }
}

pub(package) fn record_field_tree_unknown_count(field: RecordField) -> i64 {
  match field {
    RecordField(ns, nl, value, fact) -> expr_tree_unknown_count(value)
    UnknownRecordField(tag) -> 1
  }
}

pub(package) fn record_field_list_tree_unknown_count(fields: RecordFieldList) -> i64 {
  match fields {
    RecordFieldListNil -> 0
    RecordFieldListCons(field, rest) -> record_field_tree_unknown_count(field) + record_field_list_tree_unknown_count(rest)
  }
}

pub(package) fn record_field_tree_raw_bridge_slot_count(field: RecordField) -> i64 {
  match field {
    RecordField(ns, nl, value, fact) -> expr_tree_raw_bridge_slot_count(value)
    UnknownRecordField(tag) -> 0
  }
}

pub(package) fn record_field_list_tree_raw_bridge_slot_count(fields: RecordFieldList) -> i64 {
  match fields {
    RecordFieldListNil -> 0
    RecordFieldListCons(field, rest) -> record_field_tree_raw_bridge_slot_count(field) + record_field_list_tree_raw_bridge_slot_count(rest)
  }
}

pub(package) fn pattern_tree_unknown_count(pattern: Pattern) -> i64 {
  match pattern {
    CtorPattern(tag_ns, tag_nl, bindings, declaration) -> pattern_list_tree_unknown_count(bindings)
    RecordPattern(fields) -> pattern_field_list_tree_unknown_count(fields)
    TuplePattern(items) -> pattern_list_tree_unknown_count(items)
    UnknownPattern(tag) -> 1
    _ -> 0
  }
}

pub(package) fn pattern_field_tree_unknown_count(field: PatternField) -> i64 {
  match field {
    PatternField(ns, nl, pattern, fact) -> pattern_tree_unknown_count(pattern)
    UnknownPatternField(tag) -> 1
  }
}

pub(package) fn pattern_field_list_tree_unknown_count(fields: PatternFieldList) -> i64 {
  match fields {
    PatternFieldListNil -> 0
    PatternFieldListCons(field, rest) -> pattern_field_tree_unknown_count(field) + pattern_field_list_tree_unknown_count(rest)
  }
}

pub(package) fn pattern_list_tree_unknown_count(patterns: PatternList) -> i64 {
  match patterns {
    PatternListNil -> 0
    PatternListCons(pattern, rest) -> pattern_tree_unknown_count(pattern) + pattern_list_tree_unknown_count(rest)
  }
}

pub(package) fn pattern_tree_raw_bridge_slot_count(pattern: Pattern) -> i64 {
  match pattern {
    CtorPattern(tag_ns, tag_nl, bindings, declaration) -> pattern_list_tree_raw_bridge_slot_count(bindings)
    RecordPattern(fields) -> pattern_field_list_tree_raw_bridge_slot_count(fields)
    TuplePattern(items) -> pattern_list_tree_raw_bridge_slot_count(items)
    _ -> 0
  }
}

pub(package) fn pattern_field_tree_raw_bridge_slot_count(field: PatternField) -> i64 {
  match field {
    PatternField(ns, nl, pattern, fact) -> pattern_tree_raw_bridge_slot_count(pattern)
    UnknownPatternField(tag) -> 0
  }
}

pub(package) fn pattern_field_list_tree_raw_bridge_slot_count(fields: PatternFieldList) -> i64 {
  match fields {
    PatternFieldListNil -> 0
    PatternFieldListCons(field, rest) -> pattern_field_tree_raw_bridge_slot_count(field) + pattern_field_list_tree_raw_bridge_slot_count(rest)
  }
}

pub(package) fn pattern_list_tree_raw_bridge_slot_count(patterns: PatternList) -> i64 {
  match patterns {
    PatternListNil -> 0
    PatternListCons(pattern, rest) -> pattern_tree_raw_bridge_slot_count(pattern) + pattern_list_tree_raw_bridge_slot_count(rest)
  }
}

pub(package) fn handler_clause_tree_unknown_count(clause: HandlerClause) -> i64 {
  match clause {
    HandlerClause(name_info, params, body, continuation) -> {
      let name_unknown = match name_info {
        HandlerClauseName(effect_ref, op_ns, op_nl) -> expr_tree_unknown_count(effect_ref)
        UnknownHandlerClauseName -> 1
      }
      name_unknown + expr_tree_unknown_count(body)
    }
    UnknownHandlerClause(tag) -> 1
  }
}

pub(package) fn handler_clause_list_tree_unknown_count(clauses: HandlerClauseList) -> i64 {
  match clauses {
    HandlerClauseListNil -> 0
    HandlerClauseListCons(clause, rest) -> handler_clause_tree_unknown_count(clause) + handler_clause_list_tree_unknown_count(rest)
  }
}

pub(package) fn handler_clause_tree_raw_bridge_slot_count(clause: HandlerClause) -> i64 {
  match clause {
    HandlerClause(name_info, params, body, continuation) -> {
      let name_slots = match name_info {
        HandlerClauseName(effect_ref, op_ns, op_nl) -> expr_tree_raw_bridge_slot_count(effect_ref)
        UnknownHandlerClauseName -> 0
      }
      name_slots + param_list_tree_raw_bridge_slot_count(params) + expr_tree_raw_bridge_slot_count(body)
    }
    UnknownHandlerClause(tag) -> 0
  }
}

pub(package) fn handler_clause_list_tree_raw_bridge_slot_count(clauses: HandlerClauseList) -> i64 {
  match clauses {
    HandlerClauseListNil -> 0
    HandlerClauseListCons(clause, rest) -> handler_clause_tree_raw_bridge_slot_count(clause) + handler_clause_list_tree_raw_bridge_slot_count(rest)
  }
}

pub(package) fn match_arm_tree_unknown_count(arm: MatchArm) -> i64 {
  match arm {
    Arm(pattern, body, guard, has_guard) -> {
      let guard_unknowns = if has_guard == 0 { 0 } else { expr_tree_unknown_count(guard) }
      pattern_tree_unknown_count(pattern) + expr_tree_unknown_count(body) + guard_unknowns
    }
    UnknownArm(tag) -> 1
  }
}

pub(package) fn match_arm_list_tree_unknown_count(arms: MatchArmList) -> i64 {
  match arms {
    MatchArmListNil -> 0
    MatchArmListCons(arm, rest) -> match_arm_tree_unknown_count(arm) + match_arm_list_tree_unknown_count(rest)
  }
}

pub(package) fn match_arm_tree_raw_bridge_slot_count(arm: MatchArm) -> i64 {
  match arm {
    Arm(pattern, body, guard, has_guard) -> {
      let guard_slots = if has_guard == 0 { 0 } else { expr_tree_raw_bridge_slot_count(guard) }
      pattern_tree_raw_bridge_slot_count(pattern) + expr_tree_raw_bridge_slot_count(body) + guard_slots
    }
    UnknownArm(tag) -> 0
  }
}

pub(package) fn match_arm_list_tree_raw_bridge_slot_count(arms: MatchArmList) -> i64 {
  match arms {
    MatchArmListNil -> 0
    MatchArmListCons(arm, rest) -> match_arm_tree_raw_bridge_slot_count(arm) + match_arm_list_tree_raw_bridge_slot_count(rest)
  }
}

pub(package) fn expr_tree_unknown_count(expr: Expr) -> i64 {
  let self = expr_unknown_count(expr)
  match expr {
    BinOp(op, lhs, rhs) -> self + expr_tree_unknown_count(lhs) + expr_tree_unknown_count(rhs)
    Call(ns, nl, args) -> self + expr_list_tree_unknown_count(args)
    GenericCall(type_args, inner_call) -> self + expr_tree_unknown_count(inner_call)
    If(cond, then_expr, else_expr) -> self + expr_tree_unknown_count(cond) + expr_tree_unknown_count(then_expr) + expr_tree_unknown_count(else_expr)
    While(cond, body) -> self + expr_tree_unknown_count(cond) + expr_tree_unknown_count(body)
    Loop(body) -> self + expr_tree_unknown_count(body)
    Break(value) -> self + expr_tree_unknown_count(value)
    BreakNoValue -> self
    Return(value) -> self + expr_tree_unknown_count(value)
    ReturnNoValue -> self
    Defer(cleanup, body, source_site) -> self + expr_tree_unknown_count(cleanup) + expr_tree_unknown_count(body)
    Let(ns, nl, value, body) -> self + expr_tree_unknown_count(value) + expr_tree_unknown_count(body)
    LetMut(ns, nl, value, body) -> self + expr_tree_unknown_count(value) + expr_tree_unknown_count(body)
    Assign(ns, nl, value) -> self + expr_tree_unknown_count(value)
    AddressOf(mutable, target) -> self + expr_tree_unknown_count(target)
    Deref(ptr) -> self + expr_tree_unknown_count(ptr)
    PtrAssign(ptr, value) -> self + expr_tree_unknown_count(ptr) + expr_tree_unknown_count(value)
    Block(first, rest) -> self + expr_tree_unknown_count(first) + expr_tree_unknown_count(rest)
    FieldAccess(base, field_ns, field_nl, fact) -> self + expr_tree_unknown_count(base)
    IndexedLen(base, fixed_len) -> self + expr_tree_unknown_count(base)
    IndexedGet(base, index, element_ty, fixed_len) -> self + expr_tree_unknown_count(base) + expr_tree_unknown_count(index)
    IndexedSet(base, index, value, fact) -> self + expr_tree_unknown_count(base) + expr_tree_unknown_count(index) + expr_tree_unknown_count(value)
    IndexedSlice(base, start, end, fact) -> self + expr_tree_unknown_count(base) + expr_tree_unknown_count(start) + expr_tree_unknown_count(end)
    RecordInit(type_ns, type_nl, fields) -> self + record_field_list_tree_unknown_count(fields)
    RecordUpdate(base, fields, fact) -> self + expr_tree_unknown_count(base) + record_field_list_tree_unknown_count(fields)
    ArrayLiteral(elements, resolved_ty, span) -> self + expr_list_tree_unknown_count(elements)
    Match(scrutinee, arms) -> self + expr_tree_unknown_count(scrutinee) + match_arm_list_tree_unknown_count(arms)
    Not(operand) -> self + expr_tree_unknown_count(operand)
    Lambda(params, body, source_site) -> self + expr_tree_unknown_count(body)
    Perform(lhs, op_ns, op_nl, args) -> self + expr_tree_unknown_count(lhs) + expr_list_tree_unknown_count(args)
    Handle(body, clauses, hret) -> self + expr_tree_unknown_count(body) + handler_clause_list_tree_unknown_count(clauses) + handle_return_tree_unknown_count(hret)
    Resume(value) -> self + expr_tree_unknown_count(value)
    MethodCall(recv, method_hash, args, type_hash) -> self + expr_tree_unknown_count(recv) + expr_list_tree_unknown_count(args)
    Try(inner, effect_atom) -> self + expr_tree_unknown_count(inner)
    InterpConcat(left, right) -> self + expr_tree_unknown_count(left) + expr_tree_unknown_count(right)
    ForIter(var_ns, var_nl, collection, body) -> self + expr_tree_unknown_count(collection) + expr_tree_unknown_count(body)
    OptChain(base, field_ns, field_nl, effect_atom) -> self + expr_tree_unknown_count(base)
    LetTyped(inner, ann_type) -> self + expr_tree_unknown_count(inner)
    _ -> self
  }
}

-- 4j: handler-clause abort classification (THE fact; rule 10).
-- A clause that never resumes ABORTS the handle with its value (kernel
-- §7.3). Codegen must emit a different epilogue for those, so this is
-- the single producer for the typed-IR phase — consumers assert on it
-- rather than re-scanning clause bodies. A nested Handle's own clauses
-- are NOT scanned: a resume inside an inner handler resumes THAT
-- handler, not this clause. Must agree with typeck's node-phase
-- `clause_body_has_resume` (pinned by test/handler_abort_classification).
pub(package) fn expr_tree_has_resume(expr: Expr) -> i64 {
  match expr {
    Resume(value) -> 1
    BinOp(op, lhs, rhs) -> ir_or2(expr_tree_has_resume(lhs), expr_tree_has_resume(rhs))
    Call(ns, nl, args) -> expr_list_has_resume(args)
    GenericCall(type_args, inner_call) -> expr_tree_has_resume(inner_call)
    If(cond, then_expr, else_expr) -> ir_or2(expr_tree_has_resume(cond), ir_or2(expr_tree_has_resume(then_expr), expr_tree_has_resume(else_expr)))
    While(cond, body) -> ir_or2(expr_tree_has_resume(cond), expr_tree_has_resume(body))
    Loop(body) -> expr_tree_has_resume(body)
    Break(value) -> expr_tree_has_resume(value)
    Return(value) -> expr_tree_has_resume(value)
    Defer(cleanup, body, source_site) -> ir_or2(expr_tree_has_resume(cleanup), expr_tree_has_resume(body))
    Let(ns, nl, value, body) -> ir_or2(expr_tree_has_resume(value), expr_tree_has_resume(body))
    LetMut(ns, nl, value, body) -> ir_or2(expr_tree_has_resume(value), expr_tree_has_resume(body))
    Assign(ns, nl, value) -> expr_tree_has_resume(value)
    AddressOf(mutable, target) -> expr_tree_has_resume(target)
    Deref(ptr) -> expr_tree_has_resume(ptr)
    PtrAssign(ptr, value) -> ir_or2(expr_tree_has_resume(ptr), expr_tree_has_resume(value))
    Block(first, rest) -> ir_or2(expr_tree_has_resume(first), expr_tree_has_resume(rest))
    FieldAccess(base, field_ns, field_nl, fact) -> expr_tree_has_resume(base)
    IndexedLen(base, fixed_len) -> expr_tree_has_resume(base)
    IndexedGet(base, index, element_ty, fixed_len) -> ir_or2(expr_tree_has_resume(base), expr_tree_has_resume(index))
    IndexedSet(base, index, value, fact) -> ir_or2(expr_tree_has_resume(base), ir_or2(expr_tree_has_resume(index), expr_tree_has_resume(value)))
    IndexedSlice(base, start, end, fact) -> ir_or2(expr_tree_has_resume(base), ir_or2(expr_tree_has_resume(start), expr_tree_has_resume(end)))
    RecordInit(type_ns, type_nl, fields) -> record_field_list_has_resume(fields)
    RecordUpdate(base, fields, fact) -> ir_or2(expr_tree_has_resume(base), record_field_list_has_resume(fields))
    ArrayLiteral(elements, resolved_ty, span) -> expr_list_has_resume(elements)
    Match(scrutinee, arms) -> ir_or2(expr_tree_has_resume(scrutinee), match_arm_list_has_resume(arms))
    Not(operand) -> expr_tree_has_resume(operand)
    Lambda(params, body, source_site) -> expr_tree_has_resume(body)
    Perform(lhs, op_ns, op_nl, args) -> ir_or2(expr_tree_has_resume(lhs), expr_list_has_resume(args))
    Handle(body, clauses, hret) -> expr_tree_has_resume(body)
    MethodCall(recv, method_hash, args, type_hash) -> ir_or2(expr_tree_has_resume(recv), expr_list_has_resume(args))
    Try(inner, effect_atom) -> expr_tree_has_resume(inner)
    InterpConcat(left, right) -> ir_or2(expr_tree_has_resume(left), expr_tree_has_resume(right))
    ForIter(var_ns, var_nl, collection, body) -> ir_or2(expr_tree_has_resume(collection), expr_tree_has_resume(body))
    OptChain(base, field_ns, field_nl, effect_atom) -> expr_tree_has_resume(base)
    LetTyped(inner, ann_type) -> expr_tree_has_resume(inner)
    _ -> 0
  }
}

pub(package) fn ir_or2(a: i64, b: i64) -> i64 {
  if a == 1 { 1 } else { b }
}

pub(package) fn expr_list_has_resume(list: ExprList) -> i64 {
  match list {
    ExprListNil -> 0
    ExprListCons(head, rest) -> ir_or2(expr_tree_has_resume(head), expr_list_has_resume(rest))
  }
}

pub(package) fn record_field_list_has_resume(fields: RecordFieldList) -> i64 {
  match fields {
    RecordFieldListNil -> 0
    RecordFieldListCons(field, rest) -> {
      match field {
        RecordField(ns, nl, value, fact) -> ir_or2(expr_tree_has_resume(value), record_field_list_has_resume(rest))
        UnknownRecordField(tag) -> record_field_list_has_resume(rest)
      }
    }
  }
}

pub(package) fn match_arm_list_has_resume(arms: MatchArmList) -> i64 {
  match arms {
    MatchArmListNil -> 0
    MatchArmListCons(arm, rest) -> {
      match arm {
        Arm(pattern, body, guard, has_guard) -> ir_or2(expr_tree_has_resume(body), ir_or2(expr_tree_has_resume(guard), match_arm_list_has_resume(rest)))
        UnknownArm(tag) -> match_arm_list_has_resume(rest)
      }
    }
  }
}

-- 1 when the clause aborts the handle (never resumes). Deferred (`with k`)
-- clauses are NOT abortive in this sense: they reify the continuation, and
-- abandonment there is the §7.3 drop path (L3/B1.7), not the abort edge.
pub(package) fn handler_clause_is_abortive(clause: HandlerClause) -> i64 {
  match clause {
    HandlerClause(name, params, body, cont) -> {
      match cont {
        HandlerClauseNoContinuation -> if expr_tree_has_resume(body) == 1 { 0 } else { 1 }
        _ -> 0
      }
    }
    UnknownHandlerClause(tag) -> 0
  }
}

pub(package) fn handler_clause_list_has_abortive(clauses: HandlerClauseList) -> i64 {
  match clauses {
    HandlerClauseListNil -> 0
    HandlerClauseListCons(clause, rest) -> {
      if handler_clause_is_abortive(clause) == 1 { 1 }
      else { handler_clause_list_has_abortive(rest) }
    }
  }
}

pub(package) fn expr_tree_raw_bridge_slot_count(expr: Expr) -> i64 {
  let self = expr_raw_bridge_slot_count(expr)
  match expr {
    BinOp(op, lhs, rhs) -> self + expr_tree_raw_bridge_slot_count(lhs) + expr_tree_raw_bridge_slot_count(rhs)
    Call(ns, nl, args) -> self + expr_list_tree_raw_bridge_slot_count(args)
    GenericCall(type_args, inner_call) -> self + type_expr_list_tree_raw_bridge_slot_count(type_args) + expr_tree_raw_bridge_slot_count(inner_call)
    If(cond, then_expr, else_expr) -> self + expr_tree_raw_bridge_slot_count(cond) + expr_tree_raw_bridge_slot_count(then_expr) + expr_tree_raw_bridge_slot_count(else_expr)
    While(cond, body) -> self + expr_tree_raw_bridge_slot_count(cond) + expr_tree_raw_bridge_slot_count(body)
    Loop(body) -> self + expr_tree_raw_bridge_slot_count(body)
    Break(value) -> self + expr_tree_raw_bridge_slot_count(value)
    BreakNoValue -> self
    Return(value) -> self + expr_tree_raw_bridge_slot_count(value)
    ReturnNoValue -> self
    Defer(cleanup, body, source_site) -> self + expr_tree_raw_bridge_slot_count(cleanup) + expr_tree_raw_bridge_slot_count(body)
    Let(ns, nl, value, body) -> self + expr_tree_raw_bridge_slot_count(value) + expr_tree_raw_bridge_slot_count(body)
    LetMut(ns, nl, value, body) -> self + expr_tree_raw_bridge_slot_count(value) + expr_tree_raw_bridge_slot_count(body)
    Assign(ns, nl, value) -> self + expr_tree_raw_bridge_slot_count(value)
    AddressOf(mutable, target) -> self + expr_tree_raw_bridge_slot_count(target)
    Deref(ptr) -> self + expr_tree_raw_bridge_slot_count(ptr)
    PtrAssign(ptr, value) -> self + expr_tree_raw_bridge_slot_count(ptr) + expr_tree_raw_bridge_slot_count(value)
    Block(first, rest) -> self + expr_tree_raw_bridge_slot_count(first) + expr_tree_raw_bridge_slot_count(rest)
    FieldAccess(base, field_ns, field_nl, fact) -> self + expr_tree_raw_bridge_slot_count(base)
    IndexedLen(base, fixed_len) -> self + expr_tree_raw_bridge_slot_count(base)
    IndexedGet(base, index, element_ty, fixed_len) -> self + expr_tree_raw_bridge_slot_count(base) + expr_tree_raw_bridge_slot_count(index)
    IndexedSet(base, index, value, fact) -> self + expr_tree_raw_bridge_slot_count(base) + expr_tree_raw_bridge_slot_count(index) + expr_tree_raw_bridge_slot_count(value)
    IndexedSlice(base, start, end, fact) -> self + expr_tree_raw_bridge_slot_count(base) + expr_tree_raw_bridge_slot_count(start) + expr_tree_raw_bridge_slot_count(end)
    RecordInit(type_ns, type_nl, fields) -> self + record_field_list_tree_raw_bridge_slot_count(fields)
    RecordUpdate(base, fields, fact) -> self + expr_tree_raw_bridge_slot_count(base) + record_field_list_tree_raw_bridge_slot_count(fields)
    ArrayLiteral(elements, resolved_ty, span) -> self + expr_list_tree_raw_bridge_slot_count(elements)
    Match(scrutinee, arms) -> self + expr_tree_raw_bridge_slot_count(scrutinee) + match_arm_list_tree_raw_bridge_slot_count(arms)
    Not(operand) -> self + expr_tree_raw_bridge_slot_count(operand)
    Lambda(params, body, source_site) -> self + param_list_tree_raw_bridge_slot_count(params) + expr_tree_raw_bridge_slot_count(body)
    Perform(lhs, op_ns, op_nl, args) -> self + expr_tree_raw_bridge_slot_count(lhs) + expr_list_tree_raw_bridge_slot_count(args)
    Handle(body, clauses, hret) -> self + expr_tree_raw_bridge_slot_count(body) + handler_clause_list_tree_raw_bridge_slot_count(clauses) + handle_return_tree_raw_bridge_slot_count(hret)
    Resume(value) -> self + expr_tree_raw_bridge_slot_count(value)
    MethodCall(recv, method_hash, args, type_hash) -> self + expr_tree_raw_bridge_slot_count(recv) + expr_list_tree_raw_bridge_slot_count(args)
    Try(inner, effect_atom) -> self + expr_tree_raw_bridge_slot_count(inner)
    InterpConcat(left, right) -> self + expr_tree_raw_bridge_slot_count(left) + expr_tree_raw_bridge_slot_count(right)
    ForIter(var_ns, var_nl, collection, body) -> self + expr_tree_raw_bridge_slot_count(collection) + expr_tree_raw_bridge_slot_count(body)
    OptChain(base, field_ns, field_nl, effect_atom) -> self + expr_tree_raw_bridge_slot_count(base)
    LetTyped(inner, ann_type) -> self + expr_tree_raw_bridge_slot_count(inner) + type_expr_tree_raw_bridge_slot_count(ann_type)
    _ -> self
  }
}

-- Temporary native-emission bridge: the IR sidecar now stores typed handler
-- payloads, while the legacy native handler backend still consumes AST nodes.
-- Keep reconstruction here explicit so remaining raw dependencies are visible.

pub(package) fn type_expr_list_nth(types: TypeExprList, index: i64) -> TypeExpr {
  match types {
    TypeExprListNil -> MissingTypeExpr
    TypeExprListCons(ty, rest) -> {
      if index == 0 { ty } else { type_expr_list_nth(rest, index - 1) }
    }
  }
}

pub(package) fn type_expr_list_to_nodes_limit(types: TypeExprList, limit: i64, index: i64, nodes: i64) -> i64 {
  if index >= limit { nodes }
  else {
    match types {
      TypeExprListNil -> nodes
      TypeExprListCons(ty, rest) -> {
        nlist_add(nodes, type_expr_to_node(ty))
        type_expr_list_to_nodes_limit(rest, limit, index + 1, nodes)
      }
    }
  }
}

pub(package) fn type_expr_list_to_nodes_between(types: TypeExprList, start: i64, limit: i64, index: i64, nodes: i64) -> i64 {
  if index >= limit { nodes }
  else {
    match types {
      TypeExprListNil -> nodes
      TypeExprListCons(ty, rest) -> {
        if index >= start { nlist_add(nodes, type_expr_to_node(ty)) } else { 0 }
        type_expr_list_to_nodes_between(rest, start, limit, index + 1, nodes)
      }
    }
  }
}

pub(package) fn type_expr_list_to_nodes(types: TypeExprList) -> i64 {
  let nodes = nlist_new()
  type_expr_list_to_nodes_limit(types, type_expr_list_len(types), 0, nodes)
}

pub(package) fn type_expr_child_node_or(children: TypeExprList, index: i64, default: i64) -> i64 {
  let child = type_expr_list_nth(children, index)
  match child {
    MissingTypeExpr -> default
    _ -> type_expr_to_node(child)
  }
}

pub(package) fn type_expr_to_node(ty: TypeExpr) -> i64 {
  match ty {
    MissingTypeExpr -> 0
    TypeExpr(tag, payload, metadata, children) -> {
      match tag {
        0 -> ty_never()
        1 -> ty_any()
        2 -> ty_prim(payload)
        3 -> ty_union(type_expr_child_node_or(children, 0, ty_any()), type_expr_child_node_or(children, 1, ty_any()))
        4 -> ty_inter(type_expr_child_node_or(children, 0, ty_any()), type_expr_child_node_or(children, 1, ty_any()))
        5 -> ty_compl(type_expr_child_node_or(children, 0, ty_any()))
        6 -> {
          let count = type_expr_list_len(children)
          let params = nlist_new()
          let param_count = if count <= 0 { 0 } else { count - 1 }
          type_expr_list_to_nodes_limit(children, param_count, 0, params)
          let ret = if count <= 0 { ty_any() } else { type_expr_child_node_or(children, count - 1, ty_any()) }
          ty_fn(params, ret, ty_effect_pure())
        }
        7 -> ty_record_with_kind(type_expr_list_to_nodes(children), payload % 2, payload / 2)
        8 -> ty_new(8, payload, type_expr_child_node_or(children, 0, ty_any()), 0, 0)
        9 -> {
          let count = type_expr_list_len(children)
          let inner = type_expr_child_node_or(children, 0, ty_any())
          -- Preserve the canonical no-arguments representation across the
          -- raw/typed bridge. An allocated-but-empty list compares equal at
          -- the type layer, but hashes differently in monomorphisation and
          -- parameterized-effect dispatch.
          let args = if count > 1 { nlist_new() } else { 0 }
          if count > 1 { type_expr_list_to_nodes_between(children, 1, count, 0, args) } else { 0 }
          ty_named_with_metadata(payload, inner, args, metadata)
        }
        10 -> ty_effect_sig_with_tail(type_expr_list_to_nodes(children), payload)
        11 -> ty_new(11, payload, type_expr_list_to_nodes(children), 0, 0)
        12 -> ty_var(payload)
        13 -> ty_trait(payload)
        14 -> ty_continuation(type_expr_child_node_or(children, 0, ty_any()), type_expr_child_node_or(children, 1, ty_any()))
        15 -> ty_ptr_with_mut(type_expr_child_node_or(children, 0, ty_any()), payload)
        16 -> ty_weak(type_expr_child_node_or(children, 0, ty_any()))
        17 -> ty_arc(type_expr_child_node_or(children, 0, ty_any()))
        18 -> ty_unique(type_expr_child_node_or(children, 0, ty_any()))
        19 -> ty_owned(type_expr_child_node_or(children, 0, ty_any()))
        20 -> ty_unsupported(payload)
        21 -> ty_assoc(type_expr_child_node_or(children, 0, ty_any()), payload)
        22 -> ty_array(type_expr_child_node_or(children, 0, ty_any()), payload)
        23 -> ty_slice_with_mut(type_expr_child_node_or(children, 0, ty_any()), payload)
        24 -> ty_record_field(payload, type_expr_child_node_or(children, 0, ty_any()), 0, 0)
        25 -> ty_qualified_effect_app(payload, type_expr_list_to_nodes(children))
        29 -> ty_borrow_with_mut(type_expr_child_node_or(children, 0, ty_any()), payload)
        _ -> 0
      }
    }
  }
}

pub(package) fn param_label_to_node(label: ParamLabel) -> i64 {
  match label {
    PositionalParamLabel -> 0 - 1
    ExplicitParamLabel(label_ns, label_nl) -> node_new(2, label_ns, label_nl, 0, 0)
    ImplicitParamLabel -> 0
    UnknownParamLabel -> 0
  }
}

pub(package) fn param_to_node(param: Param) -> i64 {
  match param {
    Param(ns, nl, ty, label) -> node_new(2, ns, nl, type_expr_to_node(ty), param_label_to_node(label))
    UnknownParam(tag) -> 0
  }
}

pub(package) fn param_list_to_nodes_into(params: ParamList, nodes: i64) -> i64 {
  match params {
    ParamListNil -> nodes
    ParamListCons(param, rest) -> {
      nlist_add(nodes, param_to_node(param))
      param_list_to_nodes_into(rest, nodes)
    }
  }
}

pub(package) fn param_list_to_nodes(params: ParamList) -> i64 {
  param_list_to_nodes_into(params, nlist_new())
}

pub(package) fn expr_list_to_nodes_into(exprs: ExprList, nodes: i64) -> i64 {
  match exprs {
    ExprListNil -> nodes
    ExprListCons(expr, rest) -> {
        nlist_add(nodes, expr_to_node(expr))
      expr_list_to_nodes_into(rest, nodes)
    }
  }
}

pub(package) fn expr_list_to_nodes(exprs: ExprList) -> i64 {
  expr_list_to_nodes_into(exprs, nlist_new())
}

pub(package) fn record_field_to_node(field: RecordField) -> i64 {
  match field {
    RecordField(ns, nl, value, fact) -> node_new(2, ns, nl, expr_to_node(value), record_field_fact_to_node(fact))
    UnknownRecordField(tag) -> 0
  }
}

pub(package) fn record_field_list_to_nodes_into(fields: RecordFieldList, nodes: i64) -> i64 {
  match fields {
    RecordFieldListNil -> nodes
    RecordFieldListCons(field, rest) -> {
      nlist_add(nodes, record_field_to_node(field))
      record_field_list_to_nodes_into(rest, nodes)
    }
  }
}

pub(package) fn record_field_list_to_nodes(fields: RecordFieldList) -> i64 {
  record_field_list_to_nodes_into(fields, nlist_new())
}

pub(package) fn pattern_list_to_nodes_into(patterns: PatternList, nodes: i64) -> i64 {
  match patterns {
    PatternListNil -> nodes
    PatternListCons(pattern, rest) -> {
      nlist_add(nodes, pattern_to_node(pattern))
      pattern_list_to_nodes_into(rest, nodes)
    }
  }
}

pub(package) fn pattern_list_to_nodes(patterns: PatternList) -> i64 {
  pattern_list_to_nodes_into(patterns, nlist_new())
}

pub(package) fn pattern_field_to_node(field: PatternField) -> i64 {
  match field {
    PatternField(ns, nl, pattern, fact) -> node_new(66, ns, nl, pattern_to_node(pattern), field_access_fact_to_node(fact))
    UnknownPatternField(tag) -> node_new(tag, 0, 0, 0, 0)
  }
}

pub(package) fn pattern_field_list_to_nodes_into(fields: PatternFieldList, nodes: i64) -> i64 {
  match fields {
    PatternFieldListNil -> nodes
    PatternFieldListCons(field, rest) -> {
      nlist_add(nodes, pattern_field_to_node(field))
      pattern_field_list_to_nodes_into(rest, nodes)
    }
  }
}

pub(package) fn pattern_field_list_to_nodes(fields: PatternFieldList) -> i64 {
  pattern_field_list_to_nodes_into(fields, nlist_new())
}

pub(package) fn pattern_to_node(pattern: Pattern) -> i64 {
  match pattern {
    Wildcard -> node_new(17, 0, 0, 0, 0)
    Binding(ns, nl) -> node_new(18, ns, nl, 0, 0)
    IntPattern(value, start, len) -> node_new(19, value, start, len, 0)
    CtorPattern(tag_ns, tag_nl, bindings, declaration) -> {
      let count = pattern_list_len(bindings)
      let raw = if count == 0 {
        node_new(20, tag_ns, tag_nl, 0, 0)
      } else {
        node_new(20, tag_ns, tag_nl, pattern_list_to_nodes(bindings), 0 - count)
      }
      if declaration == 0 { raw } else { node_new(67, raw, declaration, 0, 0) }
    }
    TypedBinding(ns, nl, ann) -> node_new(60, ns, nl, ann, 0)
    NilPattern(ns, nl) -> node_new(61, ns, nl, 0, 0)
    RecordPattern(fields) -> node_new(64, pattern_field_list_to_nodes(fields), pattern_field_list_len(fields), 0, 0)
    TuplePattern(items) -> node_new(65, pattern_list_to_nodes(items), pattern_list_len(items), 0, 0)
    UnknownPattern(tag) -> node_new(tag, 0, 0, 0, 0)
  }
}

pub(package) fn match_arm_to_node(arm: MatchArm) -> i64 {
  match arm {
    Arm(pattern, body, guard, has_guard) -> {
      let guard_node = if has_guard == 0 { 0 } else { expr_to_node(guard) }
      node_new(16, pattern_to_node(pattern), expr_to_node(body), guard_node, 0)
    }
    UnknownArm(tag) -> node_new(tag, 0, 0, 0, 0)
  }
}

pub(package) fn match_arm_list_to_nodes_into(arms: MatchArmList, nodes: i64) -> i64 {
  match arms {
    MatchArmListNil -> nodes
    MatchArmListCons(arm, rest) -> {
      nlist_add(nodes, match_arm_to_node(arm))
      match_arm_list_to_nodes_into(rest, nodes)
    }
  }
}

pub(package) fn match_arm_list_to_nodes(arms: MatchArmList) -> i64 {
  match_arm_list_to_nodes_into(arms, nlist_new())
}

pub(package) fn handler_clause_name_to_node(name: HandlerClauseName) -> i64 {
  match name {
    HandlerClauseName(effect_ref, op_ns, op_nl) -> node_new(0, expr_to_node(effect_ref), op_ns, op_nl, 0)
    UnknownHandlerClauseName -> 0
  }
}

pub(package) fn handler_clause_continuation_to_node(continuation: HandlerClauseContinuation) -> i64 {
  match continuation {
    HandlerClauseNoContinuation -> 0
    HandlerClauseContinuation(ns, nl) -> node_new(0, ns, nl, 0, 0)
    UnknownHandlerClauseContinuation -> 0
  }
}

pub(package) fn handler_clause_to_node(clause: HandlerClause) -> i64 {
  match clause {
    HandlerClause(name_info, params, body, continuation) -> node_new(34, handler_clause_name_to_node(name_info), param_list_to_nodes(params), expr_to_node(body), handler_clause_continuation_to_node(continuation))
    UnknownHandlerClause(tag) -> node_new(tag, 0, 0, 0, 0)
  }
}

pub(package) fn handler_clause_list_to_nodes_into(clauses: HandlerClauseList, nodes: i64) -> i64 {
  match clauses {
    HandlerClauseListNil -> nodes
    HandlerClauseListCons(clause, rest) -> {
      nlist_add(nodes, handler_clause_to_node(clause))
      handler_clause_list_to_nodes_into(rest, nodes)
    }
  }
}

pub(package) fn handler_clause_list_to_nodes(clauses: HandlerClauseList) -> i64 {
  handler_clause_list_to_nodes_into(clauses, nlist_new())
}

pub(package) fn expr_to_node(expr: Expr) -> i64 {
  match expr {
    IntLit(value, start, len) -> node_new(1, value, start, len, 0)
    StringLit(start, len) -> node_new(9, start, len, 0, 0)
    BoolLit(value) -> node_new(24, value, 0, 0, 0)
    FloatLit(start, len) -> node_new(54, start, len, 0, 0)
    Ident(ns, nl) -> node_new(2, ns, nl, 0, 0)
    BorrowIdent(ns, nl, owner, mutable) -> node_new(2, ns, nl, node_new(68, owner, mutable, 0, 0), 0)
    BinOp(op, lhs, rhs) -> node_new(3, op, expr_to_node(lhs), expr_to_node(rhs), 0)
    Call(ns, nl, args) -> node_new(4, ns, nl, expr_list_to_nodes(args), expr_list_len(args))
    GenericCall(type_args, inner_call) -> node_new(36, type_expr_list_to_nodes(type_args), expr_to_node(inner_call), 0, 0)
    If(cond, then_expr, else_expr) -> node_new(5, expr_to_node(cond), expr_to_node(then_expr), expr_to_node(else_expr), 0)
    While(cond, body) -> node_new(10, expr_to_node(cond), expr_to_node(body), 0, 0)
    Loop(body) -> node_new(49, expr_to_node(body), 0, 0, 0)
    Break(value) -> node_new(26, expr_to_node(value), 0, 0, 0)
    BreakNoValue -> node_new(26, 0, 0, 0, 0)
    Continue -> node_new(27, 0, 0, 0, 0)
    Return(value) -> node_new(25, expr_to_node(value), 0, 0, 0)
    ReturnNoValue -> node_new(25, 0, 0, 0, 0)
    Defer(cleanup, body, source_site) -> node_new(52, expr_to_node(cleanup), expr_to_node(body), source_site, 0)
    Let(ns, nl, value, body) -> node_new(6, ns, nl, expr_to_node(value), expr_to_node(body))
    LetMut(ns, nl, value, body) -> node_new(11, ns, nl, expr_to_node(value), expr_to_node(body))
    Assign(ns, nl, value) -> node_new(12, ns, nl, expr_to_node(value), 0)
    AddressOf(mutable, target) -> node_new(55, mutable, expr_to_node(target), 0, 0)
    Deref(ptr) -> node_new(56, expr_to_node(ptr), 0, 0, 0)
    PtrAssign(ptr, value) -> node_new(57, expr_to_node(ptr), expr_to_node(value), 0, 0)
    Block(first, rest) -> node_new(7, expr_to_node(first), expr_to_node(rest), 0, 0)
    FieldAccess(base, field_ns, field_nl, fact) -> node_new(13, expr_to_node(base), field_ns, field_nl, field_access_fact_to_node(fact))
    IndexedLen(base, fixed_len) -> node_new(59, expr_to_node(base), fixed_len, 0, 0)
    IndexedGet(base, index, element_ty, fixed_len) -> node_new(60, expr_to_node(base), expr_to_node(index), element_ty, fixed_len)
    IndexedSet(base, index, value, fact) -> node_new(61, expr_to_node(base), expr_to_node(index), expr_to_node(value), fact)
    IndexedSlice(base, start, end, fact) -> node_new(62, expr_to_node(base), expr_to_node(start), expr_to_node(end), fact)
    RecordInit(type_ns, type_nl, fields) -> node_new(14, type_ns, type_nl, record_field_list_to_nodes(fields), record_field_list_len(fields))
    RecordUpdate(base, fields, fact) -> node_new(63, expr_to_node(base), record_field_list_to_nodes(fields), record_field_list_len(fields), record_update_fact_to_node(fact))
    ArrayLiteral(elements, resolved_ty, span) -> node_new(58, expr_list_to_nodes(elements), expr_list_len(elements), resolved_ty, span)
    Match(scrutinee, arms) -> node_new(15, expr_to_node(scrutinee), match_arm_list_to_nodes(arms), match_arm_list_len(arms), 0)
    Not(operand) -> node_new(22, expr_to_node(operand), 0, 0, 0)
    Lambda(params, body, source_site) -> node_new(29, param_list_to_nodes(params), expr_to_node(body), param_list_len(params), lambda_ast_metadata(source_site, 0))
    Perform(lhs, op_ns, op_nl, args) -> node_new(32, expr_to_node(lhs), op_ns, op_nl, expr_list_to_nodes(args))
    Handle(body, clauses, hret) -> node_new(33, expr_to_node(body), handler_clause_list_to_nodes(clauses), handler_clause_list_len(clauses), handle_return_to_node(hret))
    Resume(value) -> node_new(35, expr_to_node(value), 0, 0, 0)
    MethodCall(recv, method_hash, args, type_hash) -> node_new(41, expr_to_node(recv), method_hash, expr_list_to_nodes(args), type_hash)
    Try(inner, effect_atom) -> node_new(45, expr_to_node(inner), effect_atom, 0, 0)
    InterpConcat(left, right) -> node_new(46, expr_to_node(left), expr_to_node(right), 0, 0)
    ForIter(var_ns, var_nl, collection, body) -> node_new(47, var_ns, var_nl, expr_to_node(collection), expr_to_node(body))
    OptChain(base, field_ns, field_nl, effect_atom) -> node_new(48, expr_to_node(base), field_ns, field_nl, effect_atom)
    LetTyped(inner, ann_type) -> node_new(37, expr_to_node(inner), type_expr_to_node(ann_type), 0, 0)
    NilExpr -> node_new(51, 0, 0, 0, 0)
    UnknownExpr(tag) -> if tag == 0 { 0 } else { node_new(tag, 0, 0, 0, 0) }
  }
}

-- ══════════════════════════════════════════════════════════════
-- Declarations
-- ══════════════════════════════════════════════════════════════

pub(package) type Decl {
  FnDecl(i64, i64, ParamList, Expr), -- tag 8: f1=ns, f2=nl, typed params/body
  FnDeclWrapped(Decl, TypeExpr, EffectSig, TypeParamList), -- tag 23: typed inner/ret_type/effect sig/type params
  TraitDecl(i64, i64, TypeTraitMemberList), -- tag 38: f1=ns, f2=nl, typed methods
  ImplBlock(i64, i64, TypeImplMemberList, i64), -- tag 40: f1=type_ns, f2=type_nl, typed methods, f4=trait_hash
  EffectDecl(i64, i64, TypeEffectOpList),  -- tag 30: f1=ns, f2=nl, typed ops
  TestDecl(i64, i64, Expr),        -- tag 50: f1=ns, f2=nl, typed body
  UnknownDecl(i64)
}

pub(package) type DeclList {
  DeclListNil,
  DeclListCons(Decl, DeclList)
}

pub(package) fn decl_from_node(node: i64) -> Decl {
  if raw_bridge_is_missing(node) == 1 { UnknownDecl(0) }
  else {
    match node_tag(node) {
      8 -> FnDecl(node_f1(node), node_f2(node), param_list_from_param_nodes(node_f3(node)), expr_from_node(node_f4(node)))
      23 -> FnDeclWrapped(decl_from_node(node_f1(node)), type_expr_from_node(node_f2(node)), effect_sig_from_node(node_f3(node)), type_param_list_from_type_param_nodes(node_f4(node)))
      30 -> EffectDecl(node_f1(node), node_f2(node), type_effect_op_list_from_decl_nodes(node_f3(node), node_f4(node)))
      38 -> TraitDecl(node_f1(node), node_f2(node), type_trait_member_list_from_decl_nodes(node_f3(node), node_f4(node)))
      40 -> ImplBlock(node_f1(node), node_f2(node), type_impl_member_list_from_decl_nodes(node_f3(node)), node_f4(node))
      50 -> TestDecl(node_f1(node), node_f2(node), expr_from_node(node_f3(node)))
      _ -> UnknownDecl(node_tag(node))
    }
  }
}

pub(package) fn decl_list_empty() -> DeclList {
  DeclListNil
}

pub(package) fn decl_list_prepend(decl: Decl, rest: DeclList) -> DeclList {
  DeclListCons(decl, rest)
}

pub(package) fn decl_list_len(decls: DeclList) -> i64 {
  match decls {
    DeclListNil -> 0
    DeclListCons(decl, rest) -> 1 + decl_list_len(rest)
  }
}

pub(package) fn decl_list_count_tag(decls: DeclList, tag: i64) -> i64 {
  match decls {
    DeclListNil -> 0
    DeclListCons(decl, rest) -> {
      let add = if decl_tag(decl) == tag { 1 } else { 0 }
      add + decl_list_count_tag(rest, tag)
    }
  }
}

pub(package) fn decl_unknown_count(decl: Decl) -> i64 {
  match decl {
    UnknownDecl(tag) -> 1
    _ -> 0
  }
}

pub(package) fn decl_list_unknown_count(decls: DeclList) -> i64 {
  match decls {
    DeclListNil -> 0
    DeclListCons(decl, rest) -> decl_unknown_count(decl) + decl_list_unknown_count(rest)
  }
}

pub(package) fn decl_raw_bridge_slot_count(decl: Decl) -> i64 {
  match decl {
    FnDecl(ns, nl, params, body) -> 0
    FnDeclWrapped(inner, ret_type, eff_sig, tparams) -> 0
    TraitDecl(ns, nl, methods) -> 0
    ImplBlock(type_ns, type_nl, methods, trait_hash) -> 0
    EffectDecl(ns, nl, ops) -> 0
    TestDecl(ns, nl, body) -> 0
    UnknownDecl(tag) -> 0
  }
}

pub(package) fn decl_list_raw_bridge_slot_count(decls: DeclList) -> i64 {
  match decls {
    DeclListNil -> 0
    DeclListCons(decl, rest) -> decl_raw_bridge_slot_count(decl) + decl_list_raw_bridge_slot_count(rest)
  }
}

pub(package) fn decl_node_tree_unknown_count(node: i64) -> i64 {
  if node == 0 { 0 } else { decl_tree_unknown_count(decl_from_node(node)) }
}

pub(package) fn decl_node_tree_raw_bridge_slot_count(node: i64) -> i64 {
  if node == 0 { 0 } else { decl_tree_raw_bridge_slot_count(decl_from_node(node)) }
}

pub(package) fn decl_tree_unknown_count(decl: Decl) -> i64 {
  let self = decl_unknown_count(decl)
  match decl {
    FnDecl(ns, nl, params, body) -> self + param_list_tree_unknown_count(params) + expr_tree_unknown_count(body)
    FnDeclWrapped(inner, ret_type, eff_sig, tparams) -> self + decl_tree_unknown_count(inner) + type_expr_tree_unknown_count(ret_type) + effect_sig_tree_unknown_count(eff_sig) + type_param_list_tree_unknown_count(tparams)
    TraitDecl(ns, nl, methods) -> self + type_trait_member_list_tree_unknown_count(methods)
    ImplBlock(type_ns, type_nl, methods, trait_hash) -> self + type_impl_member_list_tree_unknown_count(methods)
    EffectDecl(ns, nl, ops) -> self + type_effect_op_list_tree_unknown_count(ops)
    TestDecl(ns, nl, body) -> self + expr_tree_unknown_count(body)
    _ -> self
  }
}

pub(package) fn decl_list_tree_unknown_count(decls: DeclList) -> i64 {
  match decls {
    DeclListNil -> 0
    DeclListCons(decl, rest) -> decl_tree_unknown_count(decl) + decl_list_tree_unknown_count(rest)
  }
}

pub(package) fn decl_tree_raw_bridge_slot_count(decl: Decl) -> i64 {
  let self = decl_raw_bridge_slot_count(decl)
  match decl {
    FnDecl(ns, nl, params, body) -> self + param_list_tree_raw_bridge_slot_count(params) + expr_tree_raw_bridge_slot_count(body)
    FnDeclWrapped(inner, ret_type, eff_sig, tparams) -> self + decl_tree_raw_bridge_slot_count(inner) + type_expr_tree_raw_bridge_slot_count(ret_type) + effect_sig_tree_raw_bridge_slot_count(eff_sig) + type_param_list_tree_raw_bridge_slot_count(tparams)
    TraitDecl(ns, nl, methods) -> self + type_trait_member_list_tree_raw_bridge_slot_count(methods)
    ImplBlock(type_ns, type_nl, methods, trait_hash) -> self + type_impl_member_list_tree_raw_bridge_slot_count(methods)
    EffectDecl(ns, nl, ops) -> self + type_effect_op_list_tree_raw_bridge_slot_count(ops)
    TestDecl(ns, nl, body) -> self + expr_tree_raw_bridge_slot_count(body)
    _ -> self
  }
}

pub(package) fn decl_list_tree_raw_bridge_slot_count(decls: DeclList) -> i64 {
  match decls {
    DeclListNil -> 0
    DeclListCons(decl, rest) -> decl_tree_raw_bridge_slot_count(decl) + decl_list_tree_raw_bridge_slot_count(rest)
  }
}

pub(package) fn decl_list_nth_tag_or(decls: DeclList, index: i64, default: i64) -> i64 {
  match decls {
    DeclListNil -> default
    DeclListCons(decl, rest) -> if index == 0 { decl_tag(decl) } else { decl_list_nth_tag_or(rest, index - 1, default) }
  }
}

pub(package) fn decl_list_nth_param_count_or(decls: DeclList, index: i64, default: i64) -> i64 {
  match decls {
    DeclListNil -> default
    DeclListCons(decl, rest) -> if index == 0 { decl_param_count_or(decl, default) } else { decl_list_nth_param_count_or(rest, index - 1, default) }
  }
}

pub(package) fn decl_list_nth_body_expr(decls: DeclList, index: i64) -> Expr {
  match decls {
    DeclListNil -> expr_from_node(0)
    DeclListCons(decl, rest) -> if index == 0 { decl_body_expr(decl) } else { decl_list_nth_body_expr(rest, index - 1) }
  }
}

pub(package) fn decl_list_from_fn_pairs(fns: i64, index: i64) -> DeclList {
  if raw_bridge_is_missing(fns) == 1 { DeclListNil }
  else { if index >= raw_bridge_list_len_or_zero(fns) { DeclListNil }
  else {
    let pair = nlist_get(fns, index)
    DeclListCons(decl_from_node(node_f1(pair)), decl_list_from_fn_pairs(fns, index + 1))
  } }
}

pub(package) fn decl_tag(decl: Decl) -> i64 {
  match decl {
    FnDecl(ns, nl, params, body) -> 8
    FnDeclWrapped(inner, ret_type, eff_sig, tparams) -> 23
    TraitDecl(ns, nl, methods) -> 38
    ImplBlock(type_ns, type_nl, methods, trait_hash) -> 40
    EffectDecl(ns, nl, ops) -> 30
    TestDecl(ns, nl, body) -> 50
    UnknownDecl(tag) -> tag
  }
}

pub(package) fn decl_is_function(decl: Decl) -> i64 {
  match decl {
    FnDecl(ns, nl, params, body) -> 1
    FnDeclWrapped(inner, ret_type, eff_sig, tparams) -> decl_is_function(inner)
    _ -> 0
  }
}

pub(package) fn decl_is_test(decl: Decl) -> i64 {
  match decl {
    TestDecl(ns, nl, body) -> 1
    _ -> 0
  }
}

pub(package) fn decl_param_count_or(decl: Decl, default: i64) -> i64 {
  match decl {
    FnDecl(ns, nl, params, body) -> param_list_len(params)
    FnDeclWrapped(inner, ret_type, eff_sig, tparams) -> decl_param_count_or(inner, default)
    _ -> default
  }
}

pub(package) fn decl_params(decl: Decl) -> ParamList {
  match decl {
    FnDecl(ns, nl, params, body) -> params
    FnDeclWrapped(inner, ret_type, eff_sig, tparams) -> decl_params(inner)
    _ -> ParamListNil
  }
}

pub(package) fn decl_name_start_or(decl: Decl, default: i64) -> i64 {
  match decl {
    FnDecl(ns, nl, params, body) -> ns
    FnDeclWrapped(inner, ret_type, eff_sig, tparams) -> decl_name_start_or(inner, default)
    TraitDecl(ns, nl, members) -> ns
    ImplBlock(type_ns, type_nl, members, trait_hash) -> type_ns
    EffectDecl(ns, nl, ops) -> ns
    TestDecl(ns, nl, body) -> ns
    _ -> default
  }
}

pub(package) fn decl_name_len_or(decl: Decl, default: i64) -> i64 {
  match decl {
    FnDecl(ns, nl, params, body) -> nl
    FnDeclWrapped(inner, ret_type, eff_sig, tparams) -> decl_name_len_or(inner, default)
    TraitDecl(ns, nl, members) -> nl
    ImplBlock(type_ns, type_nl, members, trait_hash) -> type_nl
    EffectDecl(ns, nl, ops) -> nl
    TestDecl(ns, nl, body) -> nl
    _ -> default
  }
}

pub(package) fn decl_return_type(decl: Decl) -> TypeExpr {
  match decl {
    FnDecl(ns, nl, params, body) -> type_expr_from_node(ty_any())
    FnDeclWrapped(inner, ret_type, eff_sig, tparams) -> ret_type
    _ -> MissingTypeExpr
  }
}

pub(package) fn decl_return_type_tag_or(decl: Decl, default: i64) -> i64 {
  type_expr_tag_or(decl_return_type(decl), default)
}

pub(package) fn decl_return_type_prim_id_or(decl: Decl, default: i64) -> i64 {
  type_expr_prim_id_or(decl_return_type(decl), default)
}

pub(package) fn decl_effect_sig(decl: Decl) -> EffectSig {
  match decl {
    FnDeclWrapped(inner, ret_type, eff_sig, tparams) -> eff_sig
    _ -> MissingEffectSig
  }
}

pub(package) fn decl_effect_count_or(decl: Decl, default: i64) -> i64 {
  match decl {
    FnDeclWrapped(inner, ret_type, eff_sig, tparams) -> effect_sig_count_or(eff_sig, default)
    _ -> default
  }
}

pub(package) fn decl_effect_tail_or(decl: Decl, default: i64) -> i64 {
  effect_sig_tail_var_or(decl_effect_sig(decl), default)
}

pub(package) fn decl_effect_ops(decl: Decl) -> TypeEffectOpList {
  match decl {
    EffectDecl(ns, nl, ops) -> ops
    _ -> TypeEffectOpListNil
  }
}

pub(package) fn decl_effect_op_count_or(decl: Decl, default: i64) -> i64 {
  match decl {
    EffectDecl(ns, nl, ops) -> type_effect_op_list_len(ops)
    _ -> default
  }
}

pub(package) fn decl_trait_members(decl: Decl) -> TypeTraitMemberList {
  match decl {
    TraitDecl(ns, nl, members) -> members
    _ -> TypeTraitMemberListNil
  }
}

pub(package) fn decl_trait_member_count_or(decl: Decl, default: i64) -> i64 {
  match decl {
    TraitDecl(ns, nl, members) -> type_trait_member_list_len(members)
    _ -> default
  }
}

pub(package) fn decl_impl_members(decl: Decl) -> TypeImplMemberList {
  match decl {
    ImplBlock(type_ns, type_nl, members, trait_hash) -> members
    _ -> TypeImplMemberListNil
  }
}

pub(package) fn decl_impl_member_count_or(decl: Decl, default: i64) -> i64 {
  match decl {
    ImplBlock(type_ns, type_nl, members, trait_hash) -> type_impl_member_list_len(members)
    _ -> default
  }
}

pub(package) fn decl_type_params(decl: Decl) -> TypeParamList {
  match decl {
    FnDeclWrapped(inner, ret_type, eff_sig, tparams) -> tparams
    _ -> TypeParamListNil
  }
}

pub(package) fn decl_type_param_count_or(decl: Decl, default: i64) -> i64 {
  match decl {
    FnDeclWrapped(inner, ret_type, eff_sig, tparams) -> type_param_list_len(tparams)
    _ -> default
  }
}

pub(package) fn decl_list_nth_type_params(decls: DeclList, index: i64) -> TypeParamList {
  match decls {
    DeclListNil -> TypeParamListNil
    DeclListCons(decl, rest) -> if index == 0 { decl_type_params(decl) } else { decl_list_nth_type_params(rest, index - 1) }
  }
}

pub(package) fn decl_list_nth_type_param_count_or(decls: DeclList, index: i64, default: i64) -> i64 {
  match decls {
    DeclListNil -> default
    DeclListCons(decl, rest) -> if index == 0 { decl_type_param_count_or(decl, default) } else { decl_list_nth_type_param_count_or(rest, index - 1, default) }
  }
}

pub(package) fn decl_list_nth_type_param_name_len_or(decls: DeclList, decl_index: i64, param_index: i64, default: i64) -> i64 {
  type_param_list_nth_name_len_or(decl_list_nth_type_params(decls, decl_index), param_index, default)
}

pub(package) fn decl_list_nth_type_param_bound_count_or(decls: DeclList, decl_index: i64, param_index: i64, default: i64) -> i64 {
  type_param_list_nth_bound_count_or(decl_list_nth_type_params(decls, decl_index), param_index, default)
}

pub(package) fn decl_body_expr(decl: Decl) -> Expr {
  match decl {
    FnDecl(ns, nl, params, body) -> body
    FnDeclWrapped(inner, ret_type, eff_sig, tparams) -> decl_body_expr(inner)
    TestDecl(ns, nl, body) -> body
    _ -> expr_from_node(0)
  }
}

-- ══════════════════════════════════════════════════════════════
-- ANF IR sidecar
-- ══════════════════════════════════════════════════════════════
-- This is the first typed target for optimiser tests. It intentionally starts
-- small and lives beside the legacy node/codegen path until lowering moves over.

pub(package) type IrBinaryOp {
  IrBinaryUnknown,
  IrAdd,
  IrSub,
  IrMul,
  IrDiv,
  IrEq,
  IrNe,
  IrLt,
  IrGt,
  IrLe,
  IrGe,
  IrMod,
  IrAnd,
  IrOr,
  IrBand,
  IrBor,
  IrBxor,
  IrBshl,
  IrBshr
}

pub(package) type IrUnaryOp {
  IrUnaryUnknown,
  IrNot
}

pub(package) type IrValueList {
  IrValueNil,
  IrValueCons(i64, IrValueList)
}

-- Borrow provenance is a typed semantic fact, never public lifetime syntax.
-- Parameter owners survive function summarisation; value owners name local
-- arrays/vectors/aggregates once slice construction lands; Unknown keeps
-- indirect/effect boundaries conservative without fabricating provenance.
pub(package) type IrBorrowOwner {
  IrBorrowOwnerParameter(i64),
  IrBorrowOwnerValue(i64),
  IrBorrowOwnerUnknown
}

-- owner, data/start SSA value, length SSA value, mutable capability bit.
pub(package) type IrBorrowOrigin {
  IrBorrowOrigin(IrBorrowOwner, i64, i64, i64)
}

pub(package) type IrBorrowOriginList {
  IrBorrowOriginNil,
  IrBorrowOriginCons(IrBorrowOrigin, IrBorrowOriginList)
}

-- One semantic slice head may have several origins after a CFG merge.
pub(package) type IrBorrowValueFactList {
  IrBorrowValueFactNil,
  IrBorrowValueFactCons(i64, IrBorrowOriginList, IrBorrowValueFactList)
}

-- logical parameter index, physical ABI head, mutable capability bit.
pub(package) type IrBorrowParamFactList {
  IrBorrowParamFactNil,
  IrBorrowParamFactCons(i64, i64, i64, IrBorrowParamFactList)
}

-- Known carries the exact set of logical caller parameters from which a
-- result borrow may derive. An empty Known set means no parameter borrow.
-- Unknown is the conservative result for an opaque call/effect boundary.
pub(package) type IrBorrowSummary {
  IrBorrowSummaryKnown(IrValueList),
  IrBorrowSummaryUnknown
}

-- Parameter slice facts, per-value origins, return mutability (-1 means the
-- result is not a slice), and the interprocedural result summary.
pub(package) type IrBorrowFacts {
  IrBorrowFacts(IrBorrowParamFactList, IrBorrowValueFactList, i64, IrBorrowSummary)
}

pub(package) type IrRecordFieldList {
  IrRecordFieldNil,
  -- field hash, physical word offset, SSA lane value, rest. Multi-word
  -- logical fields occupy consecutive entries with consecutive offsets.
  IrRecordFieldCons(i64, i64, i64, IrRecordFieldList)
}

-- Byte-accurate writes for an array-bearing managed record. Word entries
-- transfer one ordinary storage word; array entries carry a default-managed
-- array-storage handle whose data is copied as the complete inline byte
-- representation, plus its flattened managed-leaf plan.
-- Offsets are relative to the record's visible data region, after the hidden
-- runtime layout-descriptor word.
pub(package) type IrRecordLayoutFieldList {
  IrRecordLayoutFieldNil,
  IrRecordLayoutFieldWord(i64, i64, i64, i64, IrRecordLayoutFieldList),
  IrRecordLayoutFieldArray(i64, i64, i64, i64, i64, i64, i64, IrRecordLayoutFieldList)
}

-- Closure evidence is a lowering fact, not an emission-time AST query.
-- Bound carries the handled effect hash, the handler's ordered operation
-- hashes, and the synthetic function's SSA value containing the captured
-- ops-table pointer.
pub(package) type IrLambdaEvidence {
  IrLambdaEvidenceNone,
  IrLambdaEvidenceBound(i64, i64, i64)
}

-- Hoisted lambda bodies are ordinary IR functions and therefore need the same
-- semantic sidecars as named functions. The runtime evidence remains distinct;
-- semantic_fact and borrow are compile-time-only entries registered by the
-- optimiser driver before the carried function is detached from the closure.
pub(package) type IrLambdaSemanticFacts {
  IrLambdaSemanticFacts(IrLambdaEvidence, i64, IrBorrowFacts)
}

pub(package) fn ir_lambda_semantic_facts(evidence: IrLambdaEvidence, semantic_fact: i64, borrow: IrBorrowFacts) -> IrLambdaSemanticFacts {
  IrLambdaSemanticFacts(evidence, semantic_fact, borrow)
}

pub(package) fn ir_lambda_semantic_facts_evidence(facts: IrLambdaSemanticFacts) -> IrLambdaEvidence {
  match facts { IrLambdaSemanticFacts(evidence, semantic_fact, borrow) -> evidence }
}

pub(package) fn ir_lambda_semantic_facts_fact(facts: IrLambdaSemanticFacts) -> i64 {
  match facts { IrLambdaSemanticFacts(evidence, semantic_fact, borrow) -> semantic_fact }
}

pub(package) fn ir_lambda_semantic_facts_borrow(facts: IrLambdaSemanticFacts) -> IrBorrowFacts {
  match facts { IrLambdaSemanticFacts(evidence, semantic_fact, borrow) -> borrow }
}

-- Handler bodies cross the backend boundary as complete typed IR.
-- captures is the same lowering-owned entry list used by closures:
-- [source name span, enclosing SSA value, type node]. Source names are
-- consumed while lowering; native emission uses only the SSA value/type.
pub(package) type IrHandlerClauseBody {
  -- op hash, physical parameter lanes, captures, continuation flag,
  -- abortive flag, result cleanup kind, exact transferred parameter SSA + 1,
  -- continuation-input lanes, clause-result lanes, first SSA value, blocks.
  IrHandlerClauseBody(i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, IrBlockList),
  IrHandlerClauseBodyInvalid(i64)
}

pub(package) type IrHandlerClauseBodyList {
  IrHandlerClauseBodyNil,
  IrHandlerClauseBodyCons(IrHandlerClauseBody, IrHandlerClauseBodyList)
}

pub(package) type IrDeferredHandlerBody {
  -- captures, ops-table SSA value, first body SSA value, complete body CFG.
  -- captures, deferred-ops SSA value, result lanes, first SSA value, blocks.
  IrDeferredHandlerBody(i64, i64, i64, i64, IrBlockList),
  IrDeferredHandlerBodyInvalid(i64)
}

pub(package) type IrInst {
  IrConstI64(i64, i64),
  IrNilI64(i64),
  IrStringLit(i64, i64, i64),
  IrStringConcatI64(i64, i64, i64),
  IrBinaryI64(i64, IrBinaryOp, i64, i64),
  IrFloatBinaryI64(i64, i64, IrBinaryOp, i64, i64),
  IrUnaryI64(i64, IrUnaryOp, i64),
  IrClosureI64(i64, IrFunction, i64, IrLambdaSemanticFacts),
  IrFunctionRefI64(i64, i64),
  IrAddressOfSlotI64(i64, i64),
  IrPtrLoadI64(i64, i64),
  IrPtrStoreI64(i64, i64, i64),
  IrLoweringFailureI64(i64),
  IrPerformI64(i64, i64, i64, IrValueList),
  IrHandlerDirectI64(i64, i64, i64, i64, i64, IrValueList),
  IrHandlerPopI64(i64),
  -- Materialise x0 at an abort landing into the allocator-owned home.
  IrAbortLandingI64(i64),
  IrBindI64(i64, i64, i64, i64),
  -- dst, source origin, effect hash, lowered clauses, count, reserved.
  IrHandleI64(i64, i64, i64, IrHandlerClauseBodyList, i64, i64),
  -- dst, source origin, lowered body, lowered clauses, count,
  -- effect hash, deferred-runtime scratch base.
  IrDeferredHandleI64(i64, i64, IrDeferredHandlerBody, IrHandlerClauseBodyList, i64, i64, i64),
  IrResumeI64(i64, i64),
  IrTryI64(i64, i64, i64),
  IrOptChainI64(i64, i64, i64, i64, i64),
  IrCallI64(i64, i64, IrValueList),
  -- Additional lanes of a multi-word call result. The call defines lane 0;
  -- each following materialisation defines one ordinary SSA value from the
  -- corresponding ABI result lane. Positive lane encodings retain the compact
  -- legacy form where the call head is dst - lane; negative encodings carry an
  -- explicit call head for transformations which allocate non-consecutive SSA
  -- values. Use the helpers below rather than interpreting this field directly.
  IrCallResultLaneI64(i64, i64),
  -- Prepare a nonzero ABI return lane from an ordinary SSA value immediately
  -- before the function terminator prepares lane 0.
  IrReturnLaneI64(i64, i64),
  IrIndirectCallI64(i64, i64, IrValueList),
  IrGenericCallI64(i64, i64, TypeExprList, IrValueList),
  IrVectorGetI64(i64, i64, i64, i64, i64),
  IrVectorSetI64(i64, i64, i64, i64, i64),
  IrMethodCallI64(i64, i64, i64, i64, IrValueList),
  IrOwnedDropI64(i64, i64),
  -- dst data pointer, byte size, required stack alignment. The byte region is
  -- owned by the enclosing native frame; the SSA value is its stable address.
  IrArrayStorageI64(i64, i64, i64),
  -- fresh destination data, source data, byte size, managed leaf plan. The
  -- native consumer copies every byte, then retains each copied managed leaf.
  IrArrayCopyI64(i64, i64, i64, i64, i64, i64),
  -- data SSA, flattened leaf count, byte stride, managed drop kind.
  -- The layout producer owns these constants; consumers must not rescan types.
  IrArrayDropI64(i64, i64, i64, i64),
  -- dst, constructor tag hash, payload values, instantiated deep-release mask.
  IrVariantInitI64(i64, i64, IrValueList, i64),
  IrVariantTagI64(i64, i64),
  IrVariantPayloadI64(i64, i64, i64),
  IrRecordInitI64(i64, i64, IrRecordFieldList),
  -- dst, nominal type hash, visible data size/alignment, byte-accurate writes.
  IrRecordLayoutInitI64(i64, i64, i64, i64, IrRecordLayoutFieldList),
  -- Existing frame-owned destination, managed record owner, visible record
  -- size, field byte offset/size, and the array's flattened managed-leaf plan.
  -- Copying instead of exposing an interior pointer keeps owner liveness
  -- structural and preserves fixed-array value semantics.
  IrRecordLayoutArrayLoadI64(i64, i64, i64, i64, i64, i64, i64, i64),
  -- dst, managed record owner, visible record size, field identity and byte
  -- offset. Unlike the compact word-layout load, native addressing skips the
  -- described allocation's hidden descriptor word.
  IrRecordLayoutWordLoadI64(i64, i64, i64, i64, i64),
  IrFieldLoadI64(i64, i64, i64, i64),
  IrSlotI64(i64),
  IrLoadI64(i64, i64),
  IrStoreI64(i64, i64),
  -- Append-only IR extension: contextual generic references retain the
  -- base declaration and inferred args until specialisation discovery.
  IrGenericFunctionRefI64(i64, i64, TypeExprList),
  -- Compiler-owned managed-reference stake operation. dst preserves the
  -- runtime helper's result SSA, value names the stake's allocation,
  -- cleanup_kind selects rc/closure/weak transport, delta is exactly +1
  -- (acquire) or -1 (consume), and origin records the lowering-owned semantic
  -- reason for the stake. Keeping this semantic until the native boundary
  -- lets ownership passes reason about stakes without recognizing runtime
  -- helper spellings or sampled caller names.
  IrManagedStakeI64(i64, i64, i64, i64, i64),
  -- A caller's exact dying managed stake moves into one owned callee lane.
  -- call_dst/callee_hash bind the fact to the immediately following call;
  -- value, arg_lane, and cleanup_kind preserve allocation provenance and ABI
  -- ownership without manufacturing an SSA definition or runtime RC call.
  IrManagedTransferI64(i64, i64, i64, i64, i64),
  -- Linear frame-local reuse token plus the allocation it consumes. The
  -- ownership pass inserts this only around a constructor whose exact shape
  -- matches the dropped source; native emission must consume the token once.
  IrReuseInitI64(i64, IrInst)
}

pub(package) type IrInstList {
  IrInstNil,
  IrInstCons(IrInst, IrInstList)
}

pub(package) type IrTerminator {
  IrTermNone,
  IrTermReturn(i64),
  IrTermJump(i64, IrValueList),
  IrTermBranch(i64, i64, i64)
}

pub(package) type IrBlock {
  IrBlock(i64, IrValueList, IrInstList, IrTerminator)
}

pub(package) type IrBlockList {
  IrBlockListNil,
  IrBlockListCons(IrBlock, IrBlockList)
}

pub(package) type IrFunction {
  IrFunction(i64, i64, IrBlockList, i64)
}

pub(package) type IrFunctionList {
  IrFunctionNil,
  IrFunctionCons(IrFunction, IrFunctionList)
}

pub(package) type IrLoweredExpr {
  IrLoweredExpr(i64, i64, IrInstList)
}

