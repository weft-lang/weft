-- compiler/ir.weft — Typed IR for the Weft compiler
--
-- The compiler's internal representation as proper Weft types.
-- Replaces the raw `node_new(tag, f1, f2, f3, f4)` pattern with
-- typed constructors that the type system can reason about.
--
-- This is the "compiler as data" foundation: IR is a Weft type,
-- passes are functions over these types, tools are handler configs.

-- ══════════════════════════════════════════════════════════════
-- Expressions
-- ══════════════════════════════════════════════════════════════
-- Each variant corresponds to an AST tag in the current compiler.
-- The mapping is documented for migration purposes.

type Expr {
  -- Literals
  IntLit(i64),                    -- tag 1: f1=value
  StringLit(i64, i64),            -- tag 9: f1=src_offset, f2=length
  BoolLit(i64),                   -- tag 24: f1=value (1=true, 0=false)

  -- Variables and names
  Ident(i64, i64),                -- tag 2: f1=ns, f2=nl

  -- Operators
  BinOp(i64, i64, i64),           -- tag 3: f1=op_id, f2=lhs, f3=rhs

  -- Function calls
  Call(i64, i64, i64, i64),       -- tag 4: f1=ns, f2=nl, f3=args, f4=nargs
  GenericCall(i64, i64),          -- tag 36: f1=type_args, f2=inner_call

  -- Control flow
  If(i64, i64, i64),              -- tag 5: f1=cond, f2=then, f3=else
  While(i64, i64),                -- tag 10: f1=cond, f2=body
  Loop(i64),                      -- tag 49: f1=body
  Break(i64),                     -- tag 26: f1=value (0 for no value)
  Continue,                       -- tag 27
  Return(i64),                    -- tag 25: f1=value

  -- Bindings
  Let(i64, i64, i64, i64),        -- tag 6: f1=ns, f2=nl, f3=val, f4=body
  LetMut(i64, i64, i64, i64),     -- tag 11: f1=ns, f2=nl, f3=val, f4=body
  Assign(i64, i64, i64),          -- tag 12: f1=ns, f2=nl, f3=val

  -- Blocks
  Block(i64, i64),                -- tag 7: f1=first, f2=rest

  -- Records and fields
  FieldAccess(i64, i64, i64),     -- tag 13: f1=base, f2=field_ns, f3=field_nl
  RecordInit(i64, i64, i64, i64), -- tag 14: f1=type_ns, f2=type_nl, f3=fields, f4=nfields

  -- Pattern matching
  Match(i64, i64, i64),           -- tag 15: f1=scrutinee, f2=arms, f3=n_arms

  -- Boolean
  Not(i64),                       -- tag 22: f1=operand

  -- Lambdas
  Lambda(i64, i64, i64),          -- tag 29: f1=params, f2=body, f3=nparams

  -- Effects
  Perform(i64, i64, i64, i64),    -- tag 32: f1=lhs, f2=op_ns, f3=op_nl, f4=args
  Handle(i64, i64, i64),          -- tag 33: f1=body, f2=clauses, f3=nclauses
  Resume(i64),                    -- tag 35: f1=value

  -- Typed method call (after typeck rewrite)
  MethodCall(i64, i64, i64, i64), -- tag 41: f1=recv, f2=method_hash, f3=args, f4=type_hash

  -- Sugar (desugared at parse time, but present in typed IR)
  Try(i64),                       -- tag 45: f1=inner (? operator)
  InterpConcat(i64, i64),         -- tag 46: f1=left, f2=right
  ForIter(i64, i64, i64, i64),    -- tag 47: f1=var_ns, f2=var_nl, f3=collection, f4=body
  OptChain(i64, i64, i64),        -- tag 48: f1=base, f2=field_ns, f3=field_nl

  -- Typed let (after typeck annotation)
  LetTyped(i64, i64)              -- tag 37: f1=inner, f2=ann_type
}

-- ══════════════════════════════════════════════════════════════
-- Patterns (for match arms)
-- ══════════════════════════════════════════════════════════════

type Pattern {
  Wildcard,                        -- tag 17
  Binding(i64, i64),               -- tag 18: f1=ns, f2=nl
  IntPattern(i64),                 -- tag 19: f1=value
  CtorPattern(i64, i64, i64, i64)  -- tag 20: f1=tag_ns, f2=tag_nl, f3=bindings, f4=count
}

-- ══════════════════════════════════════════════════════════════
-- Match arms
-- ══════════════════════════════════════════════════════════════

type MatchArm {
  Arm(i64, i64, i64)              -- tag 16: f1=pattern, f2=body, f3=guard
}

-- ══════════════════════════════════════════════════════════════
-- Declarations
-- ══════════════════════════════════════════════════════════════

type Decl {
  FnDecl(i64, i64, i64, i64),     -- tag 8: f1=ns, f2=nl, f3=params, f4=body
  FnDeclWrapped(i64, i64, i64, i64), -- tag 23: f1=inner, f2=ret_type, f3=eff_sig, f4=tparams
  TraitDecl(i64, i64, i64, i64),   -- tag 38: f1=ns, f2=nl, f3=methods, f4=nmethods
  ImplBlock(i64, i64, i64, i64),   -- tag 40: f1=type_ns, f2=type_nl, f3=methods, f4=trait_hash
  EffectDecl(i64, i64, i64, i64)   -- tag 30: f1=ns, f2=nl, f3=ops, f4=nops
}

-- ══════════════════════════════════════════════════════════════
-- ANF IR sidecar
-- ══════════════════════════════════════════════════════════════
-- This is the first typed target for optimiser tests. It intentionally starts
-- small and lives beside the legacy node/codegen path until lowering moves over.

type IrBinaryOp {
  IrBinaryUnknown,
  IrAdd,
  IrSub,
  IrMul,
  IrDiv,
  IrEq,
  IrNe,
  IrLt,
  IrGt,
  IrLe,
  IrGe,
  IrMod,
  IrAnd,
  IrOr,
  IrBand,
  IrBor,
  IrBxor,
  IrBshl,
  IrBshr
}

type IrInst {
  IrConstI64(i64, i64),
  IrBinaryI64(i64, IrBinaryOp, i64, i64),
  IrReturn(i64)
}

type IrInstList {
  IrInstNil,
  IrInstCons(IrInst, IrInstList)
}

type IrBlock {
  IrBlock(i64, IrInstList)
}

type IrFunction {
  IrFunction(i64, i64, IrBlock)
}

type IrFunctionList {
  IrFunctionNil,
  IrFunctionCons(IrFunction, IrFunctionList)
}

type IrLoweredExpr {
  IrLoweredExpr(i64, i64, IrInstList)
}

fn ir_inst_const_i64(dst: i64, value: i64) -> IrInst {
  IrConstI64(dst, value)
}

fn ir_binary_op_add() -> IrBinaryOp {
  IrAdd
}

fn ir_binary_op_mul() -> IrBinaryOp {
  IrMul
}

fn ir_binary_op_tag(op: IrBinaryOp) -> i64 {
  match op {
    IrBinaryUnknown -> 0
    IrAdd -> 1
    IrSub -> 2
    IrMul -> 3
    IrDiv -> 4
    IrEq -> 5
    IrNe -> 6
    IrLt -> 7
    IrGt -> 8
    IrLe -> 9
    IrGe -> 10
    IrMod -> 11
    IrAnd -> 12
    IrOr -> 13
    IrBand -> 14
    IrBor -> 15
    IrBxor -> 16
    IrBshl -> 17
    IrBshr -> 18
  }
}

fn ir_binary_op_from_parser(op_id: i64) -> IrBinaryOp {
  match op_id {
    1 -> IrAdd
    2 -> IrSub
    3 -> IrMul
    4 -> IrDiv
    5 -> IrEq
    6 -> IrNe
    7 -> IrLt
    8 -> IrGt
    9 -> IrLe
    10 -> IrGe
    11 -> IrMod
    12 -> IrAnd
    13 -> IrOr
    14 -> IrBand
    15 -> IrBor
    16 -> IrBxor
    17 -> IrBshl
    18 -> IrBshr
    _ -> IrBinaryUnknown
  }
}

fn ir_binary_op_is_supported(op: IrBinaryOp) -> i64 {
  match op {
    IrBinaryUnknown -> 0
    _ -> 1
  }
}

fn ir_inst_binary_i64(dst: i64, op: IrBinaryOp, lhs: i64, rhs: i64) -> IrInst {
  IrBinaryI64(dst, op, lhs, rhs)
}

fn ir_inst_return(value: i64) -> IrInst {
  IrReturn(value)
}

fn ir_inst_tag(inst: IrInst) -> i64 {
  match inst {
    IrConstI64(dst, value) -> 1
    IrBinaryI64(dst, op, lhs, rhs) -> 2
    IrReturn(value) -> 3
  }
}

fn ir_inst_const_value_or(inst: IrInst, default: i64) -> i64 {
  match inst {
    IrConstI64(dst, value) -> value
    IrBinaryI64(dst, op, lhs, rhs) -> default
    IrReturn(value) -> default
  }
}

fn ir_inst_binary_op_or(inst: IrInst, default: i64) -> i64 {
  match inst {
    IrConstI64(dst, value) -> default
    IrBinaryI64(dst, op, lhs, rhs) -> ir_binary_op_tag(op)
    IrReturn(value) -> default
  }
}

fn ir_inst_list_empty() -> IrInstList {
  IrInstNil
}

fn ir_inst_list_prepend(inst: IrInst, rest: IrInstList) -> IrInstList {
  IrInstCons(inst, rest)
}

fn ir_inst_list_append(left: IrInstList, right: IrInstList) -> IrInstList {
  match left {
    IrInstNil -> right
    IrInstCons(inst, rest) -> IrInstCons(inst, ir_inst_list_append(rest, right))
  }
}

fn ir_inst_list_len(insts: IrInstList) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> 1 + ir_inst_list_len(rest)
  }
}

fn ir_inst_list_count_tag(insts: IrInstList, tag: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let add = if ir_inst_tag(inst) == tag { 1 } else { 0 }
      add + ir_inst_list_count_tag(rest, tag)
    }
  }
}

fn ir_inst_count_binary_op(inst: IrInst, op_tag: i64) -> i64 {
  match inst {
    IrConstI64(dst, value) -> 0
    IrBinaryI64(dst, op, lhs, rhs) -> if ir_binary_op_tag(op) == op_tag { 1 } else { 0 }
    IrReturn(value) -> 0
  }
}

fn ir_inst_list_count_binary_op(insts: IrInstList, op: IrBinaryOp) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      ir_inst_count_binary_op(inst, ir_binary_op_tag(op)) + ir_inst_list_count_binary_op(rest, op)
    }
  }
}

fn ir_inst_list_first_tag(insts: IrInstList) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> ir_inst_tag(inst)
  }
}

fn ir_inst_list_first_const_value_or(insts: IrInstList, default: i64) -> i64 {
  match insts {
    IrInstNil -> default
    IrInstCons(inst, rest) -> ir_inst_const_value_or(inst, default)
  }
}

fn ir_inst_list_first_binary_op_or(insts: IrInstList, default: i64) -> i64 {
  match insts {
    IrInstNil -> default
    IrInstCons(inst, rest) -> {
      let op = ir_inst_binary_op_or(inst, default)
      if op == default { ir_inst_list_first_binary_op_or(rest, default) } else { op }
    }
  }
}

fn ir_block_new(id: i64, insts: IrInstList) -> IrBlock {
  IrBlock(id, insts)
}

fn ir_block_id(block: IrBlock) -> i64 {
  match block {
    IrBlock(id, insts) -> id
  }
}

fn ir_block_inst_count(block: IrBlock) -> i64 {
  match block {
    IrBlock(id, insts) -> ir_inst_list_len(insts)
  }
}

fn ir_block_count_tag(block: IrBlock, tag: i64) -> i64 {
  match block {
    IrBlock(id, insts) -> ir_inst_list_count_tag(insts, tag)
  }
}

fn ir_block_count_binary_op(block: IrBlock, op: IrBinaryOp) -> i64 {
  match block {
    IrBlock(id, insts) -> ir_inst_list_count_binary_op(insts, op)
  }
}

fn ir_block_first_inst_tag(block: IrBlock) -> i64 {
  match block {
    IrBlock(id, insts) -> ir_inst_list_first_tag(insts)
  }
}

fn ir_block_first_const_value_or(block: IrBlock, default: i64) -> i64 {
  match block {
    IrBlock(id, insts) -> ir_inst_list_first_const_value_or(insts, default)
  }
}

fn ir_block_first_binary_op_or(block: IrBlock, default: i64) -> i64 {
  match block {
    IrBlock(id, insts) -> ir_inst_list_first_binary_op_or(insts, default)
  }
}

fn ir_function_new(name_hash: i64, param_count: i64, entry: IrBlock) -> IrFunction {
  IrFunction(name_hash, param_count, entry)
}

fn ir_function_param_count(f: IrFunction) -> i64 {
  match f {
    IrFunction(name_hash, param_count, entry) -> param_count
  }
}

fn ir_function_entry_block_id(f: IrFunction) -> i64 {
  match f {
    IrFunction(name_hash, param_count, entry) -> ir_block_id(entry)
  }
}

fn ir_function_inst_count(f: IrFunction) -> i64 {
  match f {
    IrFunction(name_hash, param_count, entry) -> ir_block_inst_count(entry)
  }
}

fn ir_function_count_tag(f: IrFunction, tag: i64) -> i64 {
  match f {
    IrFunction(name_hash, param_count, entry) -> ir_block_count_tag(entry, tag)
  }
}

fn ir_function_count_binary_op(f: IrFunction, op: IrBinaryOp) -> i64 {
  match f {
    IrFunction(name_hash, param_count, entry) -> ir_block_count_binary_op(entry, op)
  }
}

fn ir_function_first_inst_tag(f: IrFunction) -> i64 {
  match f {
    IrFunction(name_hash, param_count, entry) -> ir_block_first_inst_tag(entry)
  }
}

fn ir_function_first_const_value_or(f: IrFunction, default: i64) -> i64 {
  match f {
    IrFunction(name_hash, param_count, entry) -> ir_block_first_const_value_or(entry, default)
  }
}

fn ir_function_first_binary_op_or(f: IrFunction, default: i64) -> i64 {
  match f {
    IrFunction(name_hash, param_count, entry) -> ir_block_first_binary_op_or(entry, default)
  }
}

fn ir_function_list_empty() -> IrFunctionList {
  IrFunctionNil
}

fn ir_function_list_prepend(f: IrFunction, rest: IrFunctionList) -> IrFunctionList {
  IrFunctionCons(f, rest)
}

fn ir_function_list_len(functions: IrFunctionList) -> i64 {
  match functions {
    IrFunctionNil -> 0
    IrFunctionCons(f, rest) -> 1 + ir_function_list_len(rest)
  }
}

fn ir_function_list_inst_count(functions: IrFunctionList) -> i64 {
  match functions {
    IrFunctionNil -> 0
    IrFunctionCons(f, rest) -> ir_function_inst_count(f) + ir_function_list_inst_count(rest)
  }
}

fn ir_function_list_count_tag(functions: IrFunctionList, tag: i64) -> i64 {
  match functions {
    IrFunctionNil -> 0
    IrFunctionCons(f, rest) -> ir_function_count_tag(f, tag) + ir_function_list_count_tag(rest, tag)
  }
}

fn ir_function_list_count_binary_op(functions: IrFunctionList, op: IrBinaryOp) -> i64 {
  match functions {
    IrFunctionNil -> 0
    IrFunctionCons(f, rest) -> ir_function_count_binary_op(f, op) + ir_function_list_count_binary_op(rest, op)
  }
}

fn ir_function_list_first_inst_tag(functions: IrFunctionList) -> i64 {
  match functions {
    IrFunctionNil -> 0
    IrFunctionCons(f, rest) -> ir_function_first_inst_tag(f)
  }
}

fn ir_function_list_first_param_count(functions: IrFunctionList) -> i64 {
  match functions {
    IrFunctionNil -> 0
    IrFunctionCons(f, rest) -> ir_function_param_count(f)
  }
}

fn ir_function_list_first_block_id(functions: IrFunctionList) -> i64 {
  match functions {
    IrFunctionNil -> 0
    IrFunctionCons(f, rest) -> ir_function_entry_block_id(f)
  }
}

fn ir_function_list_first_const_value_or(functions: IrFunctionList, default: i64) -> i64 {
  match functions {
    IrFunctionNil -> default
    IrFunctionCons(f, rest) -> ir_function_first_const_value_or(f, default)
  }
}

fn ir_function_list_first_binary_op_or(functions: IrFunctionList, default: i64) -> i64 {
  match functions {
    IrFunctionNil -> default
    IrFunctionCons(f, rest) -> ir_function_first_binary_op_or(f, default)
  }
}

fn ir_lowered_expr(value: i64, next_value: i64, insts: IrInstList) -> IrLoweredExpr {
  IrLoweredExpr(value, next_value, insts)
}

fn ir_lowered_expr_invalid(next_value: i64) -> IrLoweredExpr {
  IrLoweredExpr(-1, next_value, ir_inst_list_empty())
}

fn ir_lowered_expr_value(lowered: IrLoweredExpr) -> i64 {
  match lowered {
    IrLoweredExpr(value, next_value, insts) -> value
  }
}

fn ir_lowered_expr_next_value(lowered: IrLoweredExpr) -> i64 {
  match lowered {
    IrLoweredExpr(value, next_value, insts) -> next_value
  }
}

fn ir_lowered_expr_insts(lowered: IrLoweredExpr) -> IrInstList {
  match lowered {
    IrLoweredExpr(value, next_value, insts) -> insts
  }
}

fn ir_lowered_expr_is_valid(lowered: IrLoweredExpr) -> i64 {
  if ir_lowered_expr_value(lowered) >= 0 { 1 } else { 0 }
}

-- ══════════════════════════════════════════════════════════════
-- Tag constants for backward compatibility
-- ══════════════════════════════════════════════════════════════
-- These map between the new type constructors and the old numeric tags.
-- Used during the migration period.

fn TAG_INTLIT() -> i64 { 1 }
fn TAG_IDENT() -> i64 { 2 }
fn TAG_BINOP() -> i64 { 3 }
fn TAG_CALL() -> i64 { 4 }
fn TAG_IF() -> i64 { 5 }
fn TAG_LET() -> i64 { 6 }
fn TAG_BLOCK() -> i64 { 7 }
fn TAG_FNDECL() -> i64 { 8 }
fn TAG_STRINGLIT() -> i64 { 9 }
fn TAG_WHILE() -> i64 { 10 }
fn TAG_LETMUT() -> i64 { 11 }
fn TAG_ASSIGN() -> i64 { 12 }
fn TAG_FIELDACCESS() -> i64 { 13 }
fn TAG_RECORDINIT() -> i64 { 14 }
fn TAG_MATCH() -> i64 { 15 }
fn TAG_MATCHARM() -> i64 { 16 }
fn TAG_WILDCARD() -> i64 { 17 }
fn TAG_BINDING() -> i64 { 18 }
fn TAG_INTPAT() -> i64 { 19 }
fn TAG_CTORPAT() -> i64 { 20 }
fn TAG_NOT() -> i64 { 22 }
fn TAG_FNDECLWRAP() -> i64 { 23 }
fn TAG_BOOLLIT() -> i64 { 24 }
fn TAG_RETURN() -> i64 { 25 }
fn TAG_BREAK() -> i64 { 26 }
fn TAG_CONTINUE() -> i64 { 27 }
fn TAG_LAMBDA() -> i64 { 29 }
fn TAG_EFFECTDECL() -> i64 { 30 }
fn TAG_PERFORM() -> i64 { 32 }
fn TAG_HANDLE() -> i64 { 33 }
fn TAG_RESUME() -> i64 { 35 }
fn TAG_GENERICCALL() -> i64 { 36 }
fn TAG_LETTYPED() -> i64 { 37 }
fn TAG_TRAITDECL() -> i64 { 38 }
fn TAG_IMPLBLOCK() -> i64 { 40 }
fn TAG_METHODCALL() -> i64 { 41 }
fn TAG_TRY() -> i64 { 45 }
fn TAG_INTERPCONCAT() -> i64 { 46 }
fn TAG_FORITER() -> i64 { 47 }
fn TAG_OPTCHAIN() -> i64 { 48 }
fn TAG_LOOP() -> i64 { 49 }
