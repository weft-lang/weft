      if kind == 3 { type_trait_member_list_from_nodes(type_entry_payload_ptr_or(payload_info, 0), 0, type_entry_payload_count_or(payload_info, 0)) } else { TypeTraitMemberListNil }
    }
    _ -> TypeTraitMemberListNil
  }
}

fn type_trait_member_kind_or(member: TypeTraitMember, default: i64) -> i64 {
