-- Native multi-result calls currently expose x1..x7. Eight is therefore both
-- the encoding radix and one greater than the largest valid physical lane.
pub(package) fn ir_call_result_lane_encode_for_head(call_dst: i64, lane: i64) -> i64 {
  0 - (call_dst * 8 + lane + 1)
}

pub(package) fn ir_call_result_lane_physical(encoded: i64) -> i64 {
  if encoded >= 0 { encoded } else { (0 - encoded - 1) % 8 }
}

pub(package) fn ir_call_result_lane_head(dst: i64, encoded: i64) -> i64 {
  if encoded >= 0 { dst - encoded } else { (0 - encoded - 1) / 8 }
}

pub(package) fn ir_inst_call_result_lane_for_head_i64(dst: i64, lane: i64, call_dst: i64) -> IrInst {
  IrCallResultLaneI64(dst, ir_call_result_lane_encode_for_head(call_dst, lane))
}

