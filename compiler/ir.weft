-- compiler/ir.weft — Typed IR for the Weft compiler
--
-- The compiler's internal representation as proper Weft types.
-- Replaces the raw `node_new(tag, f1, f2, f3, f4)` pattern with
-- typed constructors that the type system can reason about.
--
-- This is the "compiler as data" foundation: IR is a Weft type,
-- passes are functions over these types, tools are handler configs.

use compiler/lib.{*}
use compiler/types.{*}
use runtime/types_storage.{*}
use stdlib/list.{List, list_cons, list_filter, list_fold, list_map, list_nil}

-- Semantic value-shape facts describe how one logical typed value crosses
-- IR/ABI boundaries. A shape is an ordered nlist of register-lane classes;
-- zero means unknown/unsupported. Keeping lanes (rather than only a word
-- count) lets later tuples reuse the same producer for mixed GPR/FP shapes.
-- Physical register choice, stack placement, and spill encoding remain
-- codegen-local decisions.
pub(package) fn ir_value_lane_gpr() -> i64 { 1 }
pub(package) fn ir_value_lane_f32() -> i64 { 2 }
pub(package) fn ir_value_lane_f64() -> i64 { 3 }

pub(package) fn ir_value_shape_unknown() -> i64 { 0 }

pub(package) fn ir_value_shape_one(lane: i64) -> i64 {
  let shape = nlist_new_capacity(1)
  nlist_add(shape, lane)
  shape
}

pub(package) fn ir_value_shape_gpr_words(words: i64) -> i64 {
  if words <= 0 { ir_value_shape_unknown() }
  else {
    let shape = nlist_new_capacity(words)
    for i in 0..words { nlist_add(shape, ir_value_lane_gpr()) }
    shape
  }
}

pub(package) fn ir_value_shape_lane_count(shape: i64) -> i64 {
  if shape == 0 { 0 - 1 } else { nlist_len(shape) }
}

pub(package) fn ir_value_shape_lane_at_or(shape: i64, index: i64, default: i64) -> i64 {
  if shape == 0 or index < 0 or index >= nlist_len(shape) { default }
  else { nlist_get(shape, index) }
}

pub(package) fn ir_value_shape_is_single_gpr(shape: i64) -> i64 {
  if ir_value_shape_lane_count(shape) == 1 and ir_value_shape_lane_at_or(shape, 0, 0) == ir_value_lane_gpr() { 1 } else { 0 }
}

pub(package) fn ir_value_shape_kind_unknown() -> i64 { 0 }
pub(package) fn ir_value_shape_kind_gpr() -> i64 { 1 }
pub(package) fn ir_value_shape_kind_f32() -> i64 { 2 }
pub(package) fn ir_value_shape_kind_f64() -> i64 { 3 }
pub(package) fn ir_value_shape_kind_gpr_pair() -> i64 { 4 }

pub(package) fn ir_value_shape_kind_for_type(ty: i64) -> i64 {
  if ty == 0 { ir_value_shape_kind_unknown() }
  else {
    let tag = ty_tag(ty)
    let words = ty_value_storage_word_count(ty)
    if words == 0 {
      -- never has no returning value; open structural predicates, effects,
      -- variables, traits, projections, and fenced syntax have no complete
      -- concrete boundary representation fact.
      ir_value_shape_kind_unknown()
    } else { if tag == 7 {
      -- Structural aggregates can mix arbitrary lane classes, so the compact
      -- legacy kind enum cannot describe them. ir_value_shape_for_type builds
      -- their exact ordered shape directly below.
      ir_value_shape_kind_unknown()
    } else { if tag == 2 and ty_f1(ty) == PRIM_F32() {
      ir_value_shape_kind_f32()
    } else { if tag == 2 and ty_f1(ty) == PRIM_F64() {
      ir_value_shape_kind_f64()
    } else { if tag == 18 {
      ir_value_shape_kind_for_type(ty_unique_inner(ty))
    } else { if tag == 19 {
      ir_value_shape_kind_for_type(ty_owned_inner(ty))
    } else { if words == 2 {
      -- A slice is semantically (data, len), independent of mutability.
      ir_value_shape_kind_gpr_pair()
    } else {
      -- All remaining one-word representations are one GPR lane: integer/
      -- bool/nil scalars, handles, functions, pointers, fixed-array handles,
      -- and named record/variant values.
      ir_value_shape_kind_gpr()
    } } } } } } }
  }
}

pub(package) fn ir_value_shape_for_kind(kind: i64) -> i64 {
  if kind == ir_value_shape_kind_gpr() { ir_value_shape_gpr_words(1) }
  else { if kind == ir_value_shape_kind_f32() { ir_value_shape_one(ir_value_lane_f32()) }
  else { if kind == ir_value_shape_kind_f64() { ir_value_shape_one(ir_value_lane_f64()) }
  else { if kind == ir_value_shape_kind_gpr_pair() { ir_value_shape_gpr_words(2) }
  else { ir_value_shape_unknown() } } } }
}

pub(package) fn ir_value_shape_for_type(ty: i64) -> i64 {
  let words = ty_value_storage_word_count(ty)
  if words <= 0 { ir_value_shape_unknown() }
  else {
    let shape = nlist_new_capacity(words)
    let mut known = 1
    for lane in 0..words {
      let lane_class = ty_value_lane_class(ty, lane)
      if lane_class == ir_value_lane_gpr() or lane_class == ir_value_lane_f32() or lane_class == ir_value_lane_f64() {
        nlist_add(shape, lane_class)
      } else { known = 0 }
    }
    if known == 1 { shape } else { ir_value_shape_unknown() }
  }
}

-- ══════════════════════════════════════════════════════════════
-- Expressions
-- ══════════════════════════════════════════════════════════════
-- Each variant corresponds to an AST tag in the current compiler.
-- The mapping is documented for migration purposes.

pub(package) type Expr {
  -- Literals
  IntLit(i64, i64, i64),          -- tag 1: f1=raw value, f2/f3=optional source span
  StringLit(i64, i64),            -- tag 9: f1=src_offset, f2=length
  BoolLit(i64),                   -- tag 24: f1=value (1=true, 0=false)
  FloatLit(i64, i64),             -- tag 54: f1=src_offset, f2=length

  -- Variables and names
  Ident(i64, i64),                -- tag 2: f1=ns, f2=nl
  BorrowIdent(i64, i64, i64, i64), -- tag 2 + checker fact: ns, nl, exact owner, exclusive bit

  -- Operators
  BinOp(i64, Expr, Expr),         -- tag 3: f1=op_id, typed lhs/rhs

  -- Function calls
  Call(i64, i64, ExprList),       -- tag 4: f1=ns, f2=nl, typed args
  GenericCall(TypeExprList, Expr), -- tag 36: typed type args, typed inner call

  -- Control flow
  If(Expr, Expr, Expr),           -- tag 5: typed cond/then/else
  While(Expr, Expr),              -- tag 10: typed cond/body
  Loop(Expr),                     -- tag 49: typed body
  Break(Expr),                    -- tag 26: typed value
  BreakNoValue,                   -- tag 26: f1=0
  Continue,                       -- tag 27
  Return(Expr),                   -- tag 25: typed value
  ReturnNoValue,                  -- tag 25: f1=0
  Defer(Expr, Expr, i64),         -- tag 52: typed cleanup/body + stable source site

  -- Bindings
  Let(i64, i64, Expr, Expr),      -- tag 6: f1=ns, f2=nl, typed val/body
  LetMut(i64, i64, Expr, Expr),   -- tag 11: f1=ns, f2=nl, typed val/body
  Assign(i64, i64, Expr),         -- tag 12: f1=ns, f2=nl, typed val

  -- Pointers
  AddressOf(i64, Expr),           -- tag 55: f1=mutable flag, typed target
  Deref(Expr),                    -- tag 56: typed ptr
  PtrAssign(Expr, Expr),          -- tag 57: typed ptr/value

  -- Blocks
  Block(Expr, Expr),              -- tag 7: typed first/rest sequence

  -- Records and fields
  FieldAccess(Expr, i64, i64, FieldAccessFact), -- tag 13: typed base/name + checker-produced projection fact
  IndexedLen(Expr, i64),          -- tag 59: typed base, fixed length or -1 for the slice length lane
  IndexedGet(Expr, Expr, i64, i64), -- tag 60: typed base/index, element type, fixed length or -1 for slice
  IndexedSet(Expr, Expr, Expr, i64), -- tag 61: typed base/index/value + checker-produced indexed fact node
  IndexedSlice(Expr, Expr, Expr, i64), -- tag 62: typed base/start/end + checker-produced slice fact node
  RecordInit(i64, i64, RecordFieldList), -- tag 14: f1=type_ns, f2=type_nl, typed fields
  RecordUpdate(Expr, RecordFieldList, RecordUpdateFact), -- tag 63: evaluate-once base + typed update/result facts
  ArrayLiteral(ExprList, i64, i64), -- tag 58: typed elements, resolved [T; N] fact, source span

  -- Pattern matching
  Match(Expr, MatchArmList),      -- tag 15: typed scrutinee/arms

  -- Boolean
  Not(Expr),                      -- tag 22: typed operand

  -- Lambdas
  Lambda(ParamList, Expr, i64),   -- tag 29: typed params/body + stable source site

  -- Effects
  Perform(Expr, i64, i64, ExprList), -- tag 32: typed lhs/effect args
  Handle(Expr, HandlerClauseList, HandleReturn), -- tag 33: typed body/clauses/optional return clause (4c §7.3)
  Resume(Expr),                   -- tag 35: typed value

  -- Typed method call (after typeck rewrite)
  MethodCall(Expr, i64, ExprList, i64), -- tag 41: typed recv/args, f4=MethodRef fact

  -- Sugar (desugared at parse time, but present in typed IR)
  Try(Expr, i64),                 -- tag 45: typed inner + resolved Fail atom (? operator)
  InterpConcat(Expr, Expr),       -- tag 46: typed left/right
  ForIter(i64, i64, Expr, Expr),  -- tag 47: f1=var_ns, f2=var_nl, typed collection/body
  OptChain(Expr, i64, i64, i64),  -- tag 48: typed base/field + resolved Maybe atom

  -- Typed let (after typeck annotation)
  LetTyped(Expr, TypeExpr),       -- tag 37: typed inner let, typed annotation

  -- Synthetic parser nodes
  NilExpr,                        -- tag 51: omitted else branches yield nil

  -- Unknown/future parser node
  UnknownExpr(i64)
}

pub(package) type FieldAccessFact {
  ResolvedFieldAccessFact(TypeExpr, i64, TypeExpr, i64), -- field type, word offset, base type, structural bit
  ResolvedDeclarationAccessFact(i64), -- exact module member declaration fact
  ResolvedEffectAccessFact(i64, TypeExprList), -- exact effect declaration + optional atom args
  UnknownFieldAccessFact
}

pub(package) type RecordUpdateFact {
  ResolvedRecordUpdateFact(TypeExpr, TypeExpr), -- complete result type + concrete structural/nominal base type
  UnknownRecordUpdateFact
}

pub(package) fn record_update_fact_from_node(node: i64) -> RecordUpdateFact {
  if raw_bridge_is_missing(node) == 1 { UnknownRecordUpdateFact }
  else { ResolvedRecordUpdateFact(type_expr_from_node(node_f1(node)), type_expr_from_node(node_f2(node))) }
}

pub(package) fn record_update_fact_to_node(fact: RecordUpdateFact) -> i64 {
  match fact {
    ResolvedRecordUpdateFact(result_ty, base_ty) -> node_new(1, type_expr_to_node(result_ty), type_expr_to_node(base_ty), 0, 0)
    UnknownRecordUpdateFact -> 0
  }
}

pub(package) fn record_update_fact_result_type_node(fact: RecordUpdateFact) -> i64 {
  match fact {
    ResolvedRecordUpdateFact(result_ty, base_ty) -> type_expr_to_node(result_ty)
    UnknownRecordUpdateFact -> 0
  }
}

pub(package) fn record_update_fact_base_type_node(fact: RecordUpdateFact) -> i64 {
  match fact {
    ResolvedRecordUpdateFact(result_ty, base_ty) -> type_expr_to_node(base_ty)
    UnknownRecordUpdateFact -> 0
  }
}

pub(package) fn field_access_fact_from_node(node: i64) -> FieldAccessFact {
  if raw_bridge_is_missing(node) == 1 { UnknownFieldAccessFact }
  else { if node_tag(node) == 2 { ResolvedDeclarationAccessFact(node_f1(node)) }
  else { if node_tag(node) == 3 { ResolvedEffectAccessFact(node_f1(node), type_expr_list_from_type_nodes(node_f2(node))) }
  else { ResolvedFieldAccessFact(type_expr_from_node(node_f1(node)), node_f2(node), type_expr_from_node(node_f3(node)), node_f4(node)) } } }
}

pub(package) fn field_access_fact_to_node(fact: FieldAccessFact) -> i64 {
  match fact {
    ResolvedFieldAccessFact(field_ty, word_offset, base_ty, structural) -> node_new(1, type_expr_to_node(field_ty), word_offset, type_expr_to_node(base_ty), structural)
    ResolvedDeclarationAccessFact(decl) -> node_new(2, decl, 0, 0, 0)
    ResolvedEffectAccessFact(decl, args) -> node_new(3, decl, type_expr_list_to_nodes(args), 0, 0)
    UnknownFieldAccessFact -> 0
  }
}

pub(package) fn field_access_fact_declaration(fact: FieldAccessFact) -> i64 {
  match fact {
    ResolvedDeclarationAccessFact(decl) -> decl
    ResolvedEffectAccessFact(decl, args) -> decl
    _ -> 0
  }
}

pub(package) fn field_access_fact_field_type_node(fact: FieldAccessFact) -> i64 {
  match fact {
    ResolvedFieldAccessFact(field_ty, word_offset, base_ty, structural) -> type_expr_to_node(field_ty)
    _ -> 0
  }
}

pub(package) fn field_access_fact_base_type_node(fact: FieldAccessFact) -> i64 {
  match fact {
    ResolvedFieldAccessFact(field_ty, word_offset, base_ty, structural) -> type_expr_to_node(base_ty)
    _ -> 0
  }
}

pub(package) fn field_access_fact_word_offset_or(fact: FieldAccessFact, default: i64) -> i64 {
  match fact {
    ResolvedFieldAccessFact(field_ty, word_offset, base_ty, structural) -> word_offset
    _ -> default
  }
}

pub(package) fn field_access_fact_is_structural(fact: FieldAccessFact) -> i64 {
  match fact {
    ResolvedFieldAccessFact(field_ty, word_offset, base_ty, structural) -> structural
    _ -> 0
  }
}

pub(package) type ExprList {
  ExprListNil,
  ExprListCons(Expr, ExprList)
}

pub(package) fn raw_bridge_is_missing(ptr: i64) -> i64 {
  if ptr == 0 { 1 } else { if ptr < 4294967296 { 1 } else { 0 } }
}

pub(package) fn raw_bridge_list_len_or_zero(nodes: i64) -> i64 {
  if raw_bridge_is_missing(nodes) == 1 { 0 } else { nlist_len(nodes) }
}

pub(package) fn expr_from_node(node: i64) -> Expr {
  if raw_bridge_is_missing(node) == 1 { UnknownExpr(0) }
  else {
    match node_tag(node) {
      1 -> IntLit(node_f1(node), node_f2(node), node_f3(node))
      2 -> {
        let fact = node_f3(node)
        if fact != 0 and node_tag(fact) == 68 {
          BorrowIdent(node_f1(node), node_f2(node), node_f1(fact), node_f2(fact))
        } else { Ident(node_f1(node), node_f2(node)) }
      }
      3 -> BinOp(node_f1(node), expr_from_node(node_f2(node)), expr_from_node(node_f3(node)))
      4 -> Call(node_f1(node), node_f2(node), expr_list_from_nodes(node_f3(node), 0, node_f4(node)))
      5 -> If(expr_from_node(node_f1(node)), expr_from_node(node_f2(node)), expr_from_node(node_f3(node)))
      6 -> Let(node_f1(node), node_f2(node), expr_from_node(node_f3(node)), expr_from_node(node_f4(node)))
      7 -> Block(expr_from_node(node_f1(node)), expr_from_node(node_f2(node)))
      9 -> StringLit(node_f1(node), node_f2(node))
      10 -> While(expr_from_node(node_f1(node)), expr_from_node(node_f2(node)))
      11 -> LetMut(node_f1(node), node_f2(node), expr_from_node(node_f3(node)), expr_from_node(node_f4(node)))
      12 -> Assign(node_f1(node), node_f2(node), expr_from_node(node_f3(node)))
      13 -> FieldAccess(expr_from_node(node_f1(node)), node_f2(node), node_f3(node), field_access_fact_from_node(node_f4(node)))
      59 -> IndexedLen(expr_from_node(node_f1(node)), node_f2(node))
      60 -> IndexedGet(expr_from_node(node_f1(node)), expr_from_node(node_f2(node)), node_f3(node), node_f4(node))
      61 -> IndexedSet(expr_from_node(node_f1(node)), expr_from_node(node_f2(node)), expr_from_node(node_f3(node)), node_f4(node))
      62 -> IndexedSlice(expr_from_node(node_f1(node)), expr_from_node(node_f2(node)), expr_from_node(node_f3(node)), node_f4(node))
      14 -> RecordInit(node_f1(node), node_f2(node), record_field_list_from_nodes(node_f3(node), 0, node_f4(node)))
      63 -> RecordUpdate(expr_from_node(node_f1(node)), record_field_list_from_nodes(node_f2(node), 0, node_f3(node)), record_update_fact_from_node(node_f4(node)))
      15 -> Match(expr_from_node(node_f1(node)), match_arm_list_from_nodes(node_f2(node), 0, node_f3(node)))
      22 -> Not(expr_from_node(node_f1(node)))
      24 -> BoolLit(node_f1(node))
      25 -> if node_f1(node) == 0 { ReturnNoValue } else { Return(expr_from_node(node_f1(node))) }
      26 -> if node_f1(node) == 0 { BreakNoValue } else { Break(expr_from_node(node_f1(node))) }
      27 -> Continue
      29 -> Lambda(param_list_from_nodes(node_f1(node), 0, node_f3(node)), expr_from_node(node_f2(node)), lambda_ast_source_site(node_f4(node)))
      32 -> Perform(expr_from_node(node_f1(node)), node_f2(node), node_f3(node), expr_list_from_nodes(node_f4(node), 0, raw_bridge_list_len_or_zero(node_f4(node))))
      33 -> Handle(expr_from_node(node_f1(node)), handler_clause_list_from_nodes(node_f2(node), 0, node_f3(node)), handle_return_from_node(node_f4(node)))
      35 -> Resume(expr_from_node(node_f1(node)))
      36 -> GenericCall(type_expr_list_from_type_nodes(node_f1(node)), expr_from_node(node_f2(node)))
      37 -> LetTyped(expr_from_node(node_f1(node)), type_expr_from_node(node_f2(node)))
      41 -> MethodCall(expr_from_node(node_f1(node)), node_f2(node), expr_list_from_nodes(node_f3(node), 0, raw_bridge_list_len_or_zero(node_f3(node))), node_f4(node))
      45 -> Try(expr_from_node(node_f1(node)), node_f2(node))
      46 -> InterpConcat(expr_from_node(node_f1(node)), expr_from_node(node_f2(node)))
      47 -> ForIter(node_f1(node), node_f2(node), expr_from_node(node_f3(node)), expr_from_node(node_f4(node)))
      48 -> OptChain(expr_from_node(node_f1(node)), node_f2(node), node_f3(node), node_f4(node))
      49 -> Loop(expr_from_node(node_f1(node)))
      51 -> NilExpr
      52 -> Defer(expr_from_node(node_f1(node)), expr_from_node(node_f2(node)), node_f3(node))
      54 -> FloatLit(node_f1(node), node_f2(node))
      55 -> AddressOf(node_f1(node), expr_from_node(node_f2(node)))
      56 -> Deref(expr_from_node(node_f1(node)))
      57 -> PtrAssign(expr_from_node(node_f1(node)), expr_from_node(node_f2(node)))
      58 -> ArrayLiteral(expr_list_from_nodes(node_f1(node), 0, node_f2(node)), node_f3(node), node_f4(node))
      _ -> UnknownExpr(node_tag(node))
    }
  }
}

pub(package) fn expr_list_empty() -> ExprList {
  ExprListNil
}

pub(package) fn expr_list_prepend(expr: Expr, rest: ExprList) -> ExprList {
  ExprListCons(expr, rest)
}

pub(package) fn expr_list_from_nodes(nodes: i64, index: i64, count: i64) -> ExprList {
  if raw_bridge_is_missing(nodes) == 1 { ExprListNil }
  else { if index >= count { ExprListNil }
  else {
    ExprListCons(expr_from_node(nlist_get(nodes, index)), expr_list_from_nodes(nodes, index + 1, count))
  } }
}

pub(package) fn expr_list_len(exprs: ExprList) -> i64 {
  match exprs {
    ExprListNil -> 0
    ExprListCons(expr, rest) -> 1 + expr_list_len(rest)
  }
}

pub(package) fn expr_list_count_tag(exprs: ExprList, tag: i64) -> i64 {
  match exprs {
    ExprListNil -> 0
    ExprListCons(expr, rest) -> {
      let add = if expr_tag(expr) == tag { 1 } else { 0 }
      add + expr_list_count_tag(rest, tag)
    }
  }
}

pub(package) fn expr_list_nth_tag_or(exprs: ExprList, index: i64, default: i64) -> i64 {
  match exprs {
    ExprListNil -> default
    ExprListCons(expr, rest) -> if index == 0 { expr_tag(expr) } else { expr_list_nth_tag_or(rest, index - 1, default) }
  }
}

pub(package) fn expr_call_args(expr: Expr) -> ExprList {
  match expr {
    Call(ns, nl, args) -> args
    GenericCall(type_args, inner_call) -> expr_call_args(inner_call)
    MethodCall(recv, method_hash, args, type_hash) -> args
    Perform(lhs, op_ns, op_nl, args) -> args
    _ -> ExprListNil
  }
}

pub(package) fn expr_call_arg_count_or(expr: Expr, default: i64) -> i64 {
  match expr {
    Call(ns, nl, args) -> expr_list_len(args)
    GenericCall(type_args, inner_call) -> expr_call_arg_count_or(inner_call, default)
    MethodCall(recv, method_hash, args, type_hash) -> expr_list_len(args)
    Perform(lhs, op_ns, op_nl, args) -> expr_list_len(args)
    _ -> default
  }
}

pub(package) fn expr_array_element_count_or(expr: Expr, default: i64) -> i64 {
  match expr {
    ArrayLiteral(elements, resolved_ty, span) -> expr_list_len(elements)
    _ -> default
  }
}

pub(package) fn expr_array_element_tag_or(expr: Expr, index: i64, default: i64) -> i64 {
  match expr {
    ArrayLiteral(elements, resolved_ty, span) -> expr_list_nth_tag_or(elements, index, default)
    _ -> default
  }
}

pub(package) fn expr_array_resolved_type_node_or(expr: Expr, default: i64) -> i64 {
  match expr {
    ArrayLiteral(elements, resolved_ty, span) -> if resolved_ty == 0 { default } else { resolved_ty }
    _ -> default
  }
}

pub(package) fn expr_tag(expr: Expr) -> i64 {
  match expr {
    IntLit(value, start, len) -> 1
    StringLit(start, len) -> 9
    BoolLit(value) -> 24
    FloatLit(start, len) -> 54
    Ident(ns, nl) -> 2
    BorrowIdent(ns, nl, owner, mutable) -> 2
    BinOp(op, lhs, rhs) -> 3
    Call(ns, nl, args) -> 4
    GenericCall(type_args, inner_call) -> 36
    If(cond, then_expr, else_expr) -> 5
    While(cond, body) -> 10
    Loop(body) -> 49
    Break(value) -> 26
    BreakNoValue -> 26
    Continue -> 27
    Return(value) -> 25
    ReturnNoValue -> 25
    Defer(cleanup, body, source_site) -> 52
    Let(ns, nl, value, body) -> 6
    LetMut(ns, nl, value, body) -> 11
    Assign(ns, nl, value) -> 12
    AddressOf(mutable, target) -> 55
    Deref(ptr) -> 56
    PtrAssign(ptr, value) -> 57
    Block(first, rest) -> 7
    FieldAccess(base, field_ns, field_nl, fact) -> 13
    IndexedLen(base, fixed_len) -> 59
    IndexedGet(base, index, element_ty, fixed_len) -> 60
    IndexedSet(base, index, value, fact) -> 61
    IndexedSlice(base, start, end, fact) -> 62
    RecordInit(type_ns, type_nl, fields) -> 14
    RecordUpdate(base, fields, fact) -> 63
    ArrayLiteral(elements, resolved_ty, span) -> 58
    Match(scrutinee, arms) -> 15
    Not(operand) -> 22
    Lambda(params, body, source_site) -> 29
    Perform(lhs, op_ns, op_nl, args) -> 32
    Handle(body, clauses, hret) -> 33
    Resume(value) -> 35
    MethodCall(recv, method_hash, args, type_hash) -> 41
    Try(inner, effect_atom) -> 45
    InterpConcat(left, right) -> 46
    ForIter(var_ns, var_nl, collection, body) -> 47
    OptChain(base, field_ns, field_nl, effect_atom) -> 48
    LetTyped(inner, ann_type) -> 37
    NilExpr -> 51
    UnknownExpr(tag) -> tag
  }
}

pub(package) fn expr_unknown_count(expr: Expr) -> i64 {
  match expr {
    UnknownExpr(tag) -> 1
    _ -> 0
  }
}

pub(package) fn expr_list_unknown_count(exprs: ExprList) -> i64 {
  match exprs {
    ExprListNil -> 0
    ExprListCons(expr, rest) -> expr_unknown_count(expr) + expr_list_unknown_count(rest)
  }
}

pub(package) fn expr_raw_bridge_slot_count(expr: Expr) -> i64 {
  match expr {
    IntLit(value, start, len) -> 0
    StringLit(start, len) -> 0
    BoolLit(value) -> 0
    FloatLit(start, len) -> 0
    Ident(ns, nl) -> 0
    BorrowIdent(ns, nl, owner, mutable) -> 0
    BinOp(op, lhs, rhs) -> 0
    Call(ns, nl, args) -> 0
    GenericCall(type_args, inner_call) -> 0
    If(cond, then_expr, else_expr) -> 0
    While(cond, body) -> 0
    Loop(body) -> 0
    Break(value) -> 0
    BreakNoValue -> 0
    Continue -> 0
    Return(value) -> 0
    ReturnNoValue -> 0
    Defer(cleanup, body, source_site) -> 0
    Let(ns, nl, value, body) -> 0
    LetMut(ns, nl, value, body) -> 0
    Assign(ns, nl, value) -> 0
    AddressOf(mutable, target) -> 0
    Deref(ptr) -> 0
    PtrAssign(ptr, value) -> 0
    Block(first, rest) -> 0
    FieldAccess(base, field_ns, field_nl, fact) -> 0
    IndexedLen(base, fixed_len) -> 0
    IndexedGet(base, index, element_ty, fixed_len) -> 0
    IndexedSet(base, index, value, fact) -> 0
    IndexedSlice(base, start, end, fact) -> 0
    RecordInit(type_ns, type_nl, fields) -> 0
    RecordUpdate(base, fields, fact) -> 0
    ArrayLiteral(elements, resolved_ty, span) -> 0
    Match(scrutinee, arms) -> 0
    Not(operand) -> 0
    Lambda(params, body, source_site) -> 0
    Perform(lhs, op_ns, op_nl, args) -> 0
    Handle(body, clauses, hret) -> 0
    Resume(value) -> 0
    MethodCall(recv, method_hash, args, type_hash) -> 0
    Try(inner, effect_atom) -> 0
    InterpConcat(left, right) -> 0
    ForIter(var_ns, var_nl, collection, body) -> 0
    OptChain(base, field_ns, field_nl, effect_atom) -> 0
    LetTyped(inner, ann_type) -> 0
    NilExpr -> 0
    UnknownExpr(tag) -> 0
  }
}

pub(package) fn expr_list_raw_bridge_slot_count(exprs: ExprList) -> i64 {
  match exprs {
    ExprListNil -> 0
    ExprListCons(expr, rest) -> expr_raw_bridge_slot_count(expr) + expr_list_raw_bridge_slot_count(rest)
  }
}

