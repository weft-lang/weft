    IrHandleI64(dst, src, effect_hash, clauses, nclauses, reserved) -> effect_hash
    IrDeferredHandleI64(dst, src, body, clauses, nclauses, effect_hash, scratch_base) -> effect_hash
    _ -> default
  }
}

pub(package) fn ir_inst_handle_clause_list_count_or(inst: IrInst, default: i64) -> i64 {
  match inst {
    IrHandleI64(dst, src, body, clauses, nclauses, captures) -> ir_handler_clause_body_list_len(clauses)
    IrDeferredHandleI64(dst, src, body, clauses, nclauses, captures, scratch_base) -> ir_handler_clause_body_list_len(clauses)
    _ -> default
  }
}

pub(package) fn ir_inst_handle_clause_block_count_or(inst: IrInst, index: i64, default: i64) -> i64 {
  let body = match inst {
    IrHandleI64(dst, src, effect_hash, clauses, nclauses, reserved) -> ir_handler_clause_body_list_nth(clauses, index)
    IrDeferredHandleI64(dst, src, deferred_body, clauses, nclauses, effect_hash, scratch_base) -> ir_handler_clause_body_list_nth(clauses, index)
    _ -> IrHandlerClauseBodyInvalid(0)
  }
  match body {
    IrHandlerClauseBody(op_hash, nparams, captures, has_continuation, is_abortive, result_cleanup_kind, transferred_param_value_fact, resume_lanes, result_lanes, first_value, blocks) -> ir_block_list_len(blocks)
    IrHandlerClauseBodyInvalid(reason) -> default
  }
}

pub(package) fn ir_inst_handle_clause_has_continuation_or(inst: IrInst, index: i64, default: i64) -> i64 {
  match inst {
    IrHandleI64(dst, src, body, clauses, nclauses, captures) -> {
      match ir_handler_clause_body_list_nth(clauses, index) {
        IrHandlerClauseBody(op_hash, nparams, captures, has_continuation, is_abortive, result_cleanup_kind, transferred_param_value_fact, resume_lanes, result_lanes, first_value, blocks) -> has_continuation
        IrHandlerClauseBodyInvalid(reason) -> default
      }
    }
    IrDeferredHandleI64(dst, src, body, clauses, nclauses, captures, scratch_base) -> {
      match ir_handler_clause_body_list_nth(clauses, index) {
        IrHandlerClauseBody(op_hash, nparams, captures, has_continuation, is_abortive, result_cleanup_kind, transferred_param_value_fact, resume_lanes, result_lanes, first_value, blocks) -> has_continuation
        IrHandlerClauseBodyInvalid(reason) -> default
      }
    }
    _ -> default
  }
}

pub(package) fn ir_inst_handle_clause_is_abortive_or(inst: IrInst, index: i64, default: i64) -> i64 {
  match inst {
    IrHandleI64(dst, src, body, clauses, nclauses, abort_block) -> {
      match ir_handler_clause_body_list_nth(clauses, index) {
        IrHandlerClauseBody(op_hash, nparams, captures, has_continuation, is_abortive, result_cleanup_kind, transferred_param_value_fact, resume_lanes, result_lanes, first_value, blocks) -> is_abortive
        IrHandlerClauseBodyInvalid(reason) -> default
      }
    }
    IrDeferredHandleI64(dst, src, body, clauses, nclauses, captures, scratch_base) -> 0
    _ -> default
  }
}

