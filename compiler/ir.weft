-- Impl members
-- ══════════════════════════════════════════════════════════════

type TypeImplMember {
  TypeImplMethod(i64, i64, ParamList, TypeExpr, EffectSig, Expr), -- tag 23 wrapper: name, typed params/ret/effects/body
  TypeImplAssocType(i64, i64, TypeExpr),                    -- tag 43: associated type binding
  MissingTypeImplMember
}

type TypeImplMemberList {
  TypeImplMemberListNil,
  TypeImplMemberListCons(TypeImplMember, TypeImplMemberList)
}

fn type_impl_member_list_empty() -> TypeImplMemberList {
  TypeImplMemberListNil
}

fn type_impl_member_from_node(node: i64) -> TypeImplMember {
  if node == 0 { MissingTypeImplMember }
  else {
    match node_tag(node) {
      23 -> {
        let inner = node_f1(node)
        let ns = if inner == 0 { 0 } else { node_f1(inner) }
        let nl = if inner == 0 { 0 } else { node_f2(inner) }
        let params = if inner == 0 { ParamListNil } else { param_list_from_param_nodes(node_f3(inner)) }
        let body = if inner == 0 { expr_from_node(0) } else { expr_from_node(node_f4(inner)) }
        TypeImplMethod(ns, nl, params, type_expr_from_node(node_f2(node)), effect_sig_from_node(node_f3(node)), body)
      }
      43 -> TypeImplAssocType(node_f1(node), node_f2(node), type_expr_from_node(node_f3(node)))
      _ -> MissingTypeImplMember
    }
  }
}

fn type_impl_member_list_from_nodes(nodes: i64, index: i64, count: i64) -> TypeImplMemberList {
  if index >= count { TypeImplMemberListNil }
  else {
    TypeImplMemberListCons(type_impl_member_from_node(nlist_get(nodes, index)), type_impl_member_list_from_nodes(nodes, index + 1, count))
  }
}

fn type_impl_member_list_from_decl_nodes(nodes: i64) -> TypeImplMemberList {
  if nodes == 0 { TypeImplMemberListNil }
  else { type_impl_member_list_from_nodes(nodes, 0, nlist_len(nodes)) }
}

fn type_entry_impl_members(entry: TypeEntry) -> TypeImplMemberList {
  match entry {
    TypeEntryInfo(ns, nl, kind, payload_info) -> {
      if kind == 4 { type_impl_member_list_from_nodes(type_entry_payload_ptr_or(payload_info, 0), 0, type_entry_payload_count_or(payload_info, 0)) } else { TypeImplMemberListNil }
    }
    _ -> TypeImplMemberListNil
  }
}

