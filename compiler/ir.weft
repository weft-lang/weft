-- compiler/ir.weft — Typed IR for the Weft compiler
--
-- The compiler's internal representation as proper Weft types.
-- Replaces the raw `node_new(tag, f1, f2, f3, f4)` pattern with
-- typed constructors that the type system can reason about.
--
-- This is the "compiler as data" foundation: IR is a Weft type,
-- passes are functions over these types, tools are handler configs.

-- ══════════════════════════════════════════════════════════════
-- Expressions
-- ══════════════════════════════════════════════════════════════
-- Each variant corresponds to an AST tag in the current compiler.
-- The mapping is documented for migration purposes.

type Expr {
  -- Literals
  IntLit(i64),                    -- tag 1: f1=value
  StringLit(i64, i64),            -- tag 9: f1=src_offset, f2=length
  BoolLit(i64),                   -- tag 24: f1=value (1=true, 0=false)

  -- Variables and names
  Ident(i64, i64),                -- tag 2: f1=ns, f2=nl

  -- Operators
  BinOp(i64, i64, i64),           -- tag 3: f1=op_id, f2=lhs, f3=rhs

  -- Function calls
  Call(i64, i64, i64, i64),       -- tag 4: f1=ns, f2=nl, f3=args, f4=nargs
  GenericCall(i64, i64),          -- tag 36: f1=type_args, f2=inner_call

  -- Control flow
  If(i64, i64, i64),              -- tag 5: f1=cond, f2=then, f3=else
  While(i64, i64),                -- tag 10: f1=cond, f2=body
  Loop(i64),                      -- tag 49: f1=body
  Break(i64),                     -- tag 26: f1=value (0 for no value)
  Continue,                       -- tag 27
  Return(i64),                    -- tag 25: f1=value

  -- Bindings
  Let(i64, i64, i64, i64),        -- tag 6: f1=ns, f2=nl, f3=val, f4=body
  LetMut(i64, i64, i64, i64),     -- tag 11: f1=ns, f2=nl, f3=val, f4=body
  Assign(i64, i64, i64),          -- tag 12: f1=ns, f2=nl, f3=val

  -- Blocks
  Block(i64, i64),                -- tag 7: f1=first, f2=rest

  -- Records and fields
  FieldAccess(i64, i64, i64),     -- tag 13: f1=base, f2=field_ns, f3=field_nl
  RecordInit(i64, i64, i64, i64), -- tag 14: f1=type_ns, f2=type_nl, f3=fields, f4=nfields

  -- Pattern matching
  Match(i64, i64, i64),           -- tag 15: f1=scrutinee, f2=arms, f3=n_arms

  -- Boolean
  Not(i64),                       -- tag 22: f1=operand

  -- Lambdas
  Lambda(i64, i64, i64),          -- tag 29: f1=params, f2=body, f3=nparams

  -- Effects
  Perform(i64, i64, i64, i64),    -- tag 32: f1=lhs, f2=op_ns, f3=op_nl, f4=args
  Handle(i64, i64, i64),          -- tag 33: f1=body, f2=clauses, f3=nclauses
  Resume(i64),                    -- tag 35: f1=value

  -- Typed method call (after typeck rewrite)
  MethodCall(i64, i64, i64, i64), -- tag 41: f1=recv, f2=method_hash, f3=args, f4=type_hash

  -- Sugar (desugared at parse time, but present in typed IR)
  Try(i64),                       -- tag 45: f1=inner (? operator)
  InterpConcat(i64, i64),         -- tag 46: f1=left, f2=right
  ForIter(i64, i64, i64, i64),    -- tag 47: f1=var_ns, f2=var_nl, f3=collection, f4=body
  OptChain(i64, i64, i64),        -- tag 48: f1=base, f2=field_ns, f3=field_nl

  -- Typed let (after typeck annotation)
  LetTyped(i64, i64)              -- tag 37: f1=inner, f2=ann_type
}

-- ══════════════════════════════════════════════════════════════
-- Patterns (for match arms)
-- ══════════════════════════════════════════════════════════════

type Pattern {
  Wildcard,                        -- tag 17
  Binding(i64, i64),               -- tag 18: f1=ns, f2=nl
  IntPattern(i64),                 -- tag 19: f1=value
  CtorPattern(i64, i64, i64, i64)  -- tag 20: f1=tag_ns, f2=tag_nl, f3=bindings, f4=count
}

-- ══════════════════════════════════════════════════════════════
-- Match arms
-- ══════════════════════════════════════════════════════════════

type MatchArm {
  Arm(i64, i64, i64)              -- tag 16: f1=pattern, f2=body, f3=guard
}

-- ══════════════════════════════════════════════════════════════
-- Declarations
-- ══════════════════════════════════════════════════════════════

type Decl {
  FnDecl(i64, i64, i64, i64),     -- tag 8: f1=ns, f2=nl, f3=params, f4=body
  FnDeclWrapped(i64, i64, i64, i64), -- tag 23: f1=inner, f2=ret_type, f3=eff_sig, f4=tparams
  TraitDecl(i64, i64, i64, i64),   -- tag 38: f1=ns, f2=nl, f3=methods, f4=nmethods
  ImplBlock(i64, i64, i64, i64),   -- tag 40: f1=type_ns, f2=type_nl, f3=methods, f4=trait_hash
  EffectDecl(i64, i64, i64, i64)   -- tag 30: f1=ns, f2=nl, f3=ops, f4=nops
}

-- ══════════════════════════════════════════════════════════════
-- ANF IR sidecar
-- ══════════════════════════════════════════════════════════════
-- This is the first typed target for optimiser tests. It intentionally starts
-- small and lives beside the legacy node/codegen path until lowering moves over.

type IrBinaryOp {
  IrBinaryUnknown,
  IrAdd,
  IrSub,
  IrMul,
  IrDiv,
  IrEq,
  IrNe,
  IrLt,
  IrGt,
  IrLe,
  IrGe,
  IrMod,
  IrAnd,
  IrOr,
  IrBand,
  IrBor,
  IrBxor,
  IrBshl,
  IrBshr
}

type IrUnaryOp {
  IrUnaryUnknown,
  IrNot
}

type IrValueList {
  IrValueNil,
  IrValueCons(i64, IrValueList)
}

type IrRecordFieldList {
  IrRecordFieldNil,
  IrRecordFieldCons(i64, i64, IrRecordFieldList)
}

type IrInst {
  IrConstI64(i64, i64),
  IrStringLit(i64, i64, i64),
  IrStringConcatI64(i64, i64, i64),
  IrBinaryI64(i64, IrBinaryOp, i64, i64),
  IrUnaryI64(i64, IrUnaryOp, i64),
  IrLambdaI64(i64, i64, i64, i64),
  IrPerformI64(i64, i64, i64, IrValueList),
  IrHandleI64(i64, i64, i64, i64),
  IrResumeI64(i64, i64),
  IrTryI64(i64, i64),
  IrCallI64(i64, i64, IrValueList),
  IrIndirectCallI64(i64, i64, IrValueList),
  IrGenericCallI64(i64, i64, i64, IrValueList),
  IrMethodCallI64(i64, i64, i64, i64, IrValueList),
  IrVariantInitI64(i64, i64, IrValueList),
  IrVariantTagI64(i64, i64),
  IrVariantPayloadI64(i64, i64, i64),
  IrRecordInitI64(i64, i64, IrRecordFieldList),
  IrFieldLoadI64(i64, i64, i64, i64),
  IrSlotI64(i64),
  IrLoadI64(i64, i64),
  IrStoreI64(i64, i64)
}

type IrInstList {
  IrInstNil,
  IrInstCons(IrInst, IrInstList)
}

type IrTerminator {
  IrTermNone,
  IrTermReturn(i64),
  IrTermJump(i64, IrValueList),
  IrTermBranch(i64, i64, i64)
}

type IrBlock {
  IrBlock(i64, IrValueList, IrInstList, IrTerminator)
}

type IrBlockList {
  IrBlockListNil,
  IrBlockListCons(IrBlock, IrBlockList)
}

type IrFunction {
  IrFunction(i64, i64, IrBlockList)
}

type IrFunctionList {
  IrFunctionNil,
  IrFunctionCons(IrFunction, IrFunctionList)
}

type IrLoweredExpr {
  IrLoweredExpr(i64, i64, IrInstList)
}

fn ir_inst_const_i64(dst: i64, value: i64) -> IrInst {
  IrConstI64(dst, value)
}

fn ir_inst_string_lit(dst: i64, start: i64, len: i64) -> IrInst {
  IrStringLit(dst, start, len)
}

fn ir_inst_string_concat_i64(dst: i64, left: i64, right: i64) -> IrInst {
  IrStringConcatI64(dst, left, right)
}

fn ir_binary_op_add() -> IrBinaryOp {
  IrAdd
}

fn ir_binary_op_mul() -> IrBinaryOp {
  IrMul
}

fn ir_binary_op_eq() -> IrBinaryOp {
  IrEq
}

fn ir_binary_op_tag(op: IrBinaryOp) -> i64 {
  match op {
    IrBinaryUnknown -> 0
    IrAdd -> 1
    IrSub -> 2
    IrMul -> 3
    IrDiv -> 4
    IrEq -> 5
    IrNe -> 6
    IrLt -> 7
    IrGt -> 8
    IrLe -> 9
    IrGe -> 10
    IrMod -> 11
    IrAnd -> 12
    IrOr -> 13
    IrBand -> 14
    IrBor -> 15
    IrBxor -> 16
    IrBshl -> 17
    IrBshr -> 18
  }
}

fn ir_binary_op_from_parser(op_id: i64) -> IrBinaryOp {
  match op_id {
    1 -> IrAdd
    2 -> IrSub
    3 -> IrMul
    4 -> IrDiv
    5 -> IrEq
    6 -> IrNe
    7 -> IrLt
    8 -> IrGt
    9 -> IrLe
    10 -> IrGe
    11 -> IrMod
    12 -> IrAnd
    13 -> IrOr
    14 -> IrBand
    15 -> IrBor
    16 -> IrBxor
    17 -> IrBshl
    18 -> IrBshr
    _ -> IrBinaryUnknown
  }
}

fn ir_binary_op_is_supported(op: IrBinaryOp) -> i64 {
  match op {
    IrBinaryUnknown -> 0
    _ -> 1
  }
}

fn ir_unary_op_not() -> IrUnaryOp {
  IrNot
}

fn ir_unary_op_tag(op: IrUnaryOp) -> i64 {
  match op {
    IrUnaryUnknown -> 0
    IrNot -> 1
  }
}

fn ir_inst_binary_i64(dst: i64, op: IrBinaryOp, lhs: i64, rhs: i64) -> IrInst {
  IrBinaryI64(dst, op, lhs, rhs)
}

fn ir_inst_unary_i64(dst: i64, op: IrUnaryOp, value: i64) -> IrInst {
  IrUnaryI64(dst, op, value)
}

fn ir_inst_lambda_i64(dst: i64, params: i64, body: i64, nparams: i64) -> IrInst {
  IrLambdaI64(dst, params, body, nparams)
}

fn ir_inst_perform_i64(dst: i64, effect_hash: i64, op_hash: i64, args: IrValueList) -> IrInst {
  IrPerformI64(dst, effect_hash, op_hash, args)
}

fn ir_inst_handle_i64(dst: i64, body: i64, clauses: i64, nclauses: i64) -> IrInst {
  IrHandleI64(dst, body, clauses, nclauses)
}

fn ir_inst_resume_i64(dst: i64, value: i64) -> IrInst {
  IrResumeI64(dst, value)
}

fn ir_inst_try_i64(dst: i64, value: i64) -> IrInst {
  IrTryI64(dst, value)
}

fn ir_inst_call_i64(dst: i64, callee_hash: i64, args: IrValueList) -> IrInst {
  IrCallI64(dst, callee_hash, args)
}

fn ir_inst_indirect_call_i64(dst: i64, callee: i64, args: IrValueList) -> IrInst {
  IrIndirectCallI64(dst, callee, args)
}

fn ir_inst_generic_call_i64(dst: i64, callee_hash: i64, type_args: i64, args: IrValueList) -> IrInst {
  IrGenericCallI64(dst, callee_hash, type_args, args)
}

fn ir_inst_method_call_i64(dst: i64, type_hash: i64, method_hash: i64, receiver: i64, args: IrValueList) -> IrInst {
  IrMethodCallI64(dst, type_hash, method_hash, receiver, args)
}

fn ir_inst_variant_init_i64(dst: i64, tag_hash: i64, payloads: IrValueList) -> IrInst {
  IrVariantInitI64(dst, tag_hash, payloads)
}

fn ir_inst_variant_tag_i64(dst: i64, base: i64) -> IrInst {
  IrVariantTagI64(dst, base)
}

fn ir_inst_variant_payload_i64(dst: i64, base: i64, index: i64) -> IrInst {
  IrVariantPayloadI64(dst, base, index)
}

fn ir_inst_record_init_i64(dst: i64, type_hash: i64, fields: IrRecordFieldList) -> IrInst {
  IrRecordInitI64(dst, type_hash, fields)
}

fn ir_inst_field_load_i64(dst: i64, base: i64, field_hash: i64, field_index: i64) -> IrInst {
  IrFieldLoadI64(dst, base, field_hash, field_index)
}

fn ir_inst_slot_i64(slot: i64) -> IrInst {
  IrSlotI64(slot)
}

fn ir_inst_load_i64(dst: i64, slot: i64) -> IrInst {
  IrLoadI64(dst, slot)
}

fn ir_inst_store_i64(slot: i64, value: i64) -> IrInst {
  IrStoreI64(slot, value)
}

fn ir_inst_tag(inst: IrInst) -> i64 {
  match inst {
    IrConstI64(dst, value) -> 1
    IrStringLit(dst, start, len) -> 12
    IrStringConcatI64(dst, left, right) -> 21
    IrBinaryI64(dst, op, lhs, rhs) -> 2
    IrUnaryI64(dst, op, value) -> 3
    IrLambdaI64(dst, params, body, nparams) -> 17
    IrPerformI64(dst, effect_hash, op_hash, args) -> 18
    IrHandleI64(dst, body, clauses, nclauses) -> 19
    IrResumeI64(dst, value) -> 20
    IrTryI64(dst, value) -> 22
    IrCallI64(dst, callee_hash, args) -> 4
    IrIndirectCallI64(dst, callee, args) -> 16
    IrGenericCallI64(dst, callee_hash, type_args, args) -> 8
    IrMethodCallI64(dst, type_hash, method_hash, receiver, args) -> 9
    IrVariantInitI64(dst, tag_hash, payloads) -> 13
    IrVariantTagI64(dst, base) -> 14
    IrVariantPayloadI64(dst, base, index) -> 15
    IrRecordInitI64(dst, type_hash, fields) -> 10
    IrFieldLoadI64(dst, base, field_hash, field_index) -> 11
    IrSlotI64(slot) -> 5
    IrLoadI64(dst, slot) -> 6
    IrStoreI64(slot, value) -> 7
  }
}

fn ir_inst_const_value_or(inst: IrInst, default: i64) -> i64 {
  match inst {
    IrConstI64(dst, value) -> value
    IrStringLit(dst, start, len) -> default
    IrStringConcatI64(dst, left, right) -> default
    IrBinaryI64(dst, op, lhs, rhs) -> default
    IrUnaryI64(dst, op, value) -> default
    IrLambdaI64(dst, params, body, nparams) -> default
    IrPerformI64(dst, effect_hash, op_hash, args) -> default
    IrHandleI64(dst, body, clauses, nclauses) -> default
    IrResumeI64(dst, value) -> default
    IrTryI64(dst, value) -> default
    IrCallI64(dst, callee_hash, args) -> default
    IrIndirectCallI64(dst, callee, args) -> default
    IrGenericCallI64(dst, callee_hash, type_args, args) -> default
    IrMethodCallI64(dst, type_hash, method_hash, receiver, args) -> default
    IrVariantInitI64(dst, tag_hash, payloads) -> default
    IrVariantTagI64(dst, base) -> default
    IrVariantPayloadI64(dst, base, index) -> default
    IrRecordInitI64(dst, type_hash, fields) -> default
    IrFieldLoadI64(dst, base, field_hash, field_index) -> default
    IrSlotI64(slot) -> default
    IrLoadI64(dst, slot) -> default
    IrStoreI64(slot, value) -> default
  }
}

fn ir_inst_string_len_or(inst: IrInst, default: i64) -> i64 {
  match inst {
    IrConstI64(dst, value) -> default
    IrStringLit(dst, start, len) -> len
    IrStringConcatI64(dst, left, right) -> default
    IrBinaryI64(dst, op, lhs, rhs) -> default
    IrUnaryI64(dst, op, value) -> default
    IrLambdaI64(dst, params, body, nparams) -> default
    IrPerformI64(dst, effect_hash, op_hash, args) -> default
    IrHandleI64(dst, body, clauses, nclauses) -> default
    IrResumeI64(dst, value) -> default
    IrTryI64(dst, value) -> default
    IrCallI64(dst, callee_hash, args) -> default
    IrIndirectCallI64(dst, callee, args) -> default
    IrGenericCallI64(dst, callee_hash, type_args, args) -> default
    IrMethodCallI64(dst, type_hash, method_hash, receiver, args) -> default
    IrVariantInitI64(dst, tag_hash, payloads) -> default
    IrVariantTagI64(dst, base) -> default
    IrVariantPayloadI64(dst, base, index) -> default
    IrRecordInitI64(dst, type_hash, fields) -> default
    IrFieldLoadI64(dst, base, field_hash, field_index) -> default
    IrSlotI64(slot) -> default
    IrLoadI64(dst, slot) -> default
    IrStoreI64(slot, value) -> default
  }
}

fn ir_inst_binary_op_or(inst: IrInst, default: i64) -> i64 {
  match inst {
    IrConstI64(dst, value) -> default
    IrStringLit(dst, start, len) -> default
    IrStringConcatI64(dst, left, right) -> default
    IrBinaryI64(dst, op, lhs, rhs) -> ir_binary_op_tag(op)
    IrUnaryI64(dst, op, value) -> default
    IrLambdaI64(dst, params, body, nparams) -> default
    IrPerformI64(dst, effect_hash, op_hash, args) -> default
    IrHandleI64(dst, body, clauses, nclauses) -> default
    IrResumeI64(dst, value) -> default
    IrTryI64(dst, value) -> default
    IrCallI64(dst, callee_hash, args) -> default
    IrIndirectCallI64(dst, callee, args) -> default
    IrGenericCallI64(dst, callee_hash, type_args, args) -> default
    IrMethodCallI64(dst, type_hash, method_hash, receiver, args) -> default
    IrVariantInitI64(dst, tag_hash, payloads) -> default
    IrVariantTagI64(dst, base) -> default
    IrVariantPayloadI64(dst, base, index) -> default
    IrRecordInitI64(dst, type_hash, fields) -> default
    IrFieldLoadI64(dst, base, field_hash, field_index) -> default
    IrSlotI64(slot) -> default
    IrLoadI64(dst, slot) -> default
    IrStoreI64(slot, value) -> default
  }
}

fn ir_inst_call_arg_count_or(inst: IrInst, default: i64) -> i64 {
  match inst {
    IrConstI64(dst, value) -> default
    IrStringLit(dst, start, len) -> default
    IrStringConcatI64(dst, left, right) -> default
    IrBinaryI64(dst, op, lhs, rhs) -> default
