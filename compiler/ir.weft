pub(package) fn ir_managed_stake_origin_result_transfer() -> i64 { 1 }
pub(package) fn ir_managed_stake_origin_call_transport() -> i64 { 2 }
pub(package) fn ir_managed_stake_origin_binding() -> i64 { 3 }
pub(package) fn ir_managed_stake_origin_aggregate() -> i64 { 4 }
pub(package) fn ir_managed_stake_origin_arm_normalization() -> i64 { 5 }
pub(package) fn ir_managed_stake_origin_discard() -> i64 { 6 }
pub(package) fn ir_managed_stake_origin_cleanup() -> i64 { 7 }
