}

fn type_effect_op_list_nth_param_type_prim_id_or(ops: TypeEffectOpList, op_index: i64, param_index: i64, default: i64) -> i64 {
  param_list_nth_type_prim_id_or(type_effect_op_params(type_effect_op_list_nth(ops, op_index)), param_index, default)
}

fn type_effect_op_list_nth_return_type_tag_or(ops: TypeEffectOpList, index: i64, default: i64) -> i64 {
  type_effect_op_return_type_tag_or(type_effect_op_list_nth(ops, index), default)
}

fn type_effect_op_list_nth_return_type_prim_id_or(ops: TypeEffectOpList, index: i64, default: i64) -> i64 {
  type_effect_op_return_type_prim_id_or(type_effect_op_list_nth(ops, index), default)
}

fn type_effect_op_list_nth_is_deferred_or(ops: TypeEffectOpList, index: i64, default: i64) -> i64 {
  let op = type_effect_op_list_nth(ops, index)
  match op {
    MissingTypeEffectOp -> default
    _ -> type_effect_op_is_deferred(op)
  }
}

fn effect_sig_effect_count_or(sig: i64, default: i64) -> i64 {
  if sig == 0 { default }
  else {
    if ty_tag(sig) == 10 {
      let effects = ty_f1(sig)
      if effects == 0 { 0 } else { nlist_len(effects) }
    } else { default }
  }
}

