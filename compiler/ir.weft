pub(package) fn ir_block_list_param_count_for_id(blocks: IrBlockList, block_id: i64, default: i64) -> i64 {
  match blocks {
    IrBlockListNil -> default
    IrBlockListCons(block, rest) -> {
      if ir_block_id(block) == block_id {
        ir_block_param_count(block)
      } else {
        ir_block_list_param_count_for_id(rest, block_id, default)
      }
    }
  }
}

pub(package) fn ir_block_list_params_for_id(blocks: IrBlockList, block_id: i64) -> IrValueList {
  match blocks {
    IrBlockListNil -> IrValueNil
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> if id == block_id { params } else { ir_block_list_params_for_id(rest, block_id) }
      }
    }
  }
}

pub(package) fn ir_term_edges_match_block_params(term: IrTerminator, blocks: IrBlockList) -> i64 {
  match term {
    IrTermNone -> 0
    IrTermReturn(value) -> 1
    IrTermJump(target, args) -> {
      let expected = ir_block_list_param_count_for_id(blocks, target, 0 - 1)
      if expected == ir_value_list_len(args) { 1 } else { 0 }
    }
    IrTermBranch(cond, then_block, else_block) -> {
      let then_params = ir_block_list_param_count_for_id(blocks, then_block, 0 - 1)
      let else_params = ir_block_list_param_count_for_id(blocks, else_block, 0 - 1)
      if then_params == 0 {
        if else_params == 0 { 1 } else { 0 }
      } else {
        0
      }
    }
  }
}

pub(package) fn ir_block_edges_match_block_params(block: IrBlock, blocks: IrBlockList) -> i64 {
  match block {
    IrBlock(id, params, insts, term) -> ir_term_edges_match_block_params(term, blocks)
  }
}

pub(package) fn ir_block_list_edges_match_block_params_inner(blocks: IrBlockList, all_blocks: IrBlockList) -> i64 {
  match blocks {
    IrBlockListNil -> 1
    IrBlockListCons(block, rest) -> {
      if ir_block_edges_match_block_params(block, all_blocks) == 1 {
        ir_block_list_edges_match_block_params_inner(rest, all_blocks)
      } else {
        0
      }
    }
  }
}

pub(package) fn ir_block_list_edges_match_block_params(blocks: IrBlockList) -> i64 {
  ir_block_list_edges_match_block_params_inner(blocks, blocks)
}

pub(package) fn ir_function_edges_match_block_params(f: IrFunction) -> i64 {
  match f {
    IrFunction(name_hash, param_count, blocks, src) -> ir_block_list_edges_match_block_params(blocks)
  }
}

pub(package) fn ir_function_list_edges_match_block_params(functions: IrFunctionList) -> i64 {
  match functions {
    IrFunctionNil -> 1
    IrFunctionCons(f, rest) -> {
      if ir_function_edges_match_block_params(f) == 1 {
        ir_function_list_edges_match_block_params(rest)
      } else {
        0
      }
    }
  }
}

pub(package) fn ir_function_list_first_bad_edge_index_from(functions: IrFunctionList, index: i64, default: i64) -> i64 {
  match functions {
    IrFunctionNil -> default
    IrFunctionCons(f, rest) -> {
      if ir_function_edges_match_block_params(f) == 1 {
        ir_function_list_first_bad_edge_index_from(rest, index + 1, default)
      } else {
        index
      }
    }
  }
}

pub(package) fn ir_function_list_first_bad_edge_index_or(functions: IrFunctionList, default: i64) -> i64 {
  ir_function_list_first_bad_edge_index_from(functions, 0, default)
}

pub(package) fn ir_function_list_first_bad_edge_hash_or(functions: IrFunctionList, default: i64) -> i64 {
  match functions {
    IrFunctionNil -> default
    IrFunctionCons(f, rest) -> {
      if ir_function_edges_match_block_params(f) == 1 {
        ir_function_list_first_bad_edge_hash_or(rest, default)
      } else {
        match f {
          IrFunction(name_hash, param_count, blocks, src) -> name_hash
        }
      }
    }
  }
}

