-- compiler/ir.weft — Typed IR for the Weft compiler
--
-- The compiler's internal representation as proper Weft types.
-- Replaces the raw `node_new(tag, f1, f2, f3, f4)` pattern with
-- typed constructors that the type system can reason about.
--
-- This is the "compiler as data" foundation: IR is a Weft type,
-- passes are functions over these types, tools are handler configs.

use "stdlib/list.weft"

-- ══════════════════════════════════════════════════════════════
-- Expressions
-- ══════════════════════════════════════════════════════════════
-- Each variant corresponds to an AST tag in the current compiler.
-- The mapping is documented for migration purposes.

type Expr {
  -- Literals
  IntLit(i64),                    -- tag 1: f1=raw value, f2/f3=optional source span
  StringLit(i64, i64),            -- tag 9: f1=src_offset, f2=length
  BoolLit(i64),                   -- tag 24: f1=value (1=true, 0=false)

  -- Variables and names
  Ident(i64, i64),                -- tag 2: f1=ns, f2=nl

  -- Operators
  BinOp(i64, Expr, Expr),         -- tag 3: f1=op_id, typed lhs/rhs

  -- Function calls
  Call(i64, i64, ExprList),       -- tag 4: f1=ns, f2=nl, typed args
  GenericCall(TypeExprList, Expr), -- tag 36: typed type args, typed inner call

  -- Control flow
  If(Expr, Expr, Expr),           -- tag 5: typed cond/then/else
  While(Expr, Expr),              -- tag 10: typed cond/body
  Loop(Expr),                     -- tag 49: typed body
  Break(Expr),                    -- tag 26: typed value
  BreakNoValue,                   -- tag 26: f1=0
  Continue,                       -- tag 27
  Return(Expr),                   -- tag 25: typed value
  ReturnNoValue,                  -- tag 25: f1=0
  Defer(Expr, Expr),              -- tag 52: typed cleanup/body

  -- Bindings
  Let(i64, i64, Expr, Expr),      -- tag 6: f1=ns, f2=nl, typed val/body
  LetMut(i64, i64, Expr, Expr),   -- tag 11: f1=ns, f2=nl, typed val/body
  Assign(i64, i64, Expr),         -- tag 12: f1=ns, f2=nl, typed val

  -- Pointers
  AddressOf(i64, Expr),           -- tag 55: f1=mutable flag, typed target
  Deref(Expr),                    -- tag 56: typed ptr
  PtrAssign(Expr, Expr),          -- tag 57: typed ptr/value

  -- Blocks
  Block(Expr, Expr),              -- tag 7: typed first/rest sequence

  -- Records and fields
  FieldAccess(Expr, i64, i64),    -- tag 13: typed base, f2=field_ns, f3=field_nl
  RecordInit(i64, i64, RecordFieldList), -- tag 14: f1=type_ns, f2=type_nl, typed fields

  -- Pattern matching
  Match(Expr, MatchArmList),      -- tag 15: typed scrutinee/arms

  -- Boolean
  Not(Expr),                      -- tag 22: typed operand

  -- Lambdas
  Lambda(ParamList, Expr),        -- tag 29: typed params/body

  -- Effects
  Perform(Expr, i64, i64, ExprList), -- tag 32: typed lhs/effect args
  Handle(Expr, HandlerClauseList), -- tag 33: typed body/clauses
  Resume(Expr),                   -- tag 35: typed value

  -- Typed method call (after typeck rewrite)
  MethodCall(Expr, i64, ExprList, i64), -- tag 41: typed recv/args, f4=type_hash

  -- Sugar (desugared at parse time, but present in typed IR)
  Try(Expr),                      -- tag 45: typed inner (? operator)
  InterpConcat(Expr, Expr),       -- tag 46: typed left/right
  ForIter(i64, i64, Expr, Expr),  -- tag 47: f1=var_ns, f2=var_nl, typed collection/body
  OptChain(Expr, i64, i64),       -- tag 48: typed base, f2=field_ns, f3=field_nl

  -- Typed let (after typeck annotation)
  LetTyped(Expr, TypeExpr),       -- tag 37: typed inner let, typed annotation

  -- Synthetic parser nodes
  NilExpr,                        -- tag 51: omitted else branches yield nil

  -- Unknown/future parser node
  UnknownExpr(i64)
}

type ExprList {
  ExprListNil,
  ExprListCons(Expr, ExprList)
}

fn expr_from_node(node: i64) -> Expr {
  if node == 0 { UnknownExpr(0) }
  else {
    match node_tag(node) {
      1 -> IntLit(node_f1(node))
      2 -> Ident(node_f1(node), node_f2(node))
      3 -> BinOp(node_f1(node), expr_from_node(node_f2(node)), expr_from_node(node_f3(node)))
      4 -> Call(node_f1(node), node_f2(node), expr_list_from_nodes(node_f3(node), 0, node_f4(node)))
      5 -> If(expr_from_node(node_f1(node)), expr_from_node(node_f2(node)), expr_from_node(node_f3(node)))
      6 -> Let(node_f1(node), node_f2(node), expr_from_node(node_f3(node)), expr_from_node(node_f4(node)))
      7 -> Block(expr_from_node(node_f1(node)), expr_from_node(node_f2(node)))
      9 -> StringLit(node_f1(node), node_f2(node))
      10 -> While(expr_from_node(node_f1(node)), expr_from_node(node_f2(node)))
      11 -> LetMut(node_f1(node), node_f2(node), expr_from_node(node_f3(node)), expr_from_node(node_f4(node)))
      12 -> Assign(node_f1(node), node_f2(node), expr_from_node(node_f3(node)))
      13 -> FieldAccess(expr_from_node(node_f1(node)), node_f2(node), node_f3(node))
      14 -> RecordInit(node_f1(node), node_f2(node), record_field_list_from_nodes(node_f3(node), 0, node_f4(node)))
      15 -> Match(expr_from_node(node_f1(node)), match_arm_list_from_nodes(node_f2(node), 0, node_f3(node)))
      22 -> Not(expr_from_node(node_f1(node)))
      24 -> BoolLit(node_f1(node))
      25 -> if node_f1(node) == 0 { ReturnNoValue } else { Return(expr_from_node(node_f1(node))) }
      26 -> if node_f1(node) == 0 { BreakNoValue } else { Break(expr_from_node(node_f1(node))) }
      27 -> Continue
      29 -> Lambda(param_list_from_nodes(node_f1(node), 0, node_f3(node)), expr_from_node(node_f2(node)))
      32 -> Perform(expr_from_node(node_f1(node)), node_f2(node), node_f3(node), expr_list_from_nodes(node_f4(node), 0, nlist_len(node_f4(node))))
      33 -> Handle(expr_from_node(node_f1(node)), handler_clause_list_from_nodes(node_f2(node), 0, node_f3(node)))
      35 -> Resume(expr_from_node(node_f1(node)))
      36 -> GenericCall(type_expr_list_from_type_nodes(node_f1(node)), expr_from_node(node_f2(node)))
      37 -> LetTyped(expr_from_node(node_f1(node)), type_expr_from_node(node_f2(node)))
      41 -> MethodCall(expr_from_node(node_f1(node)), node_f2(node), expr_list_from_nodes(node_f3(node), 0, nlist_len(node_f3(node))), node_f4(node))
      45 -> Try(expr_from_node(node_f1(node)))
      46 -> InterpConcat(expr_from_node(node_f1(node)), expr_from_node(node_f2(node)))
      47 -> ForIter(node_f1(node), node_f2(node), expr_from_node(node_f3(node)), expr_from_node(node_f4(node)))
      48 -> OptChain(expr_from_node(node_f1(node)), node_f2(node), node_f3(node))
      49 -> Loop(expr_from_node(node_f1(node)))
      51 -> NilExpr
      52 -> Defer(expr_from_node(node_f1(node)), expr_from_node(node_f2(node)))
      55 -> AddressOf(node_f1(node), expr_from_node(node_f2(node)))
      56 -> Deref(expr_from_node(node_f1(node)))
      57 -> PtrAssign(expr_from_node(node_f1(node)), expr_from_node(node_f2(node)))
      _ -> UnknownExpr(node_tag(node))
    }
  }
}

fn expr_list_empty() -> ExprList {
  ExprListNil
}

fn expr_list_prepend(expr: Expr, rest: ExprList) -> ExprList {
  ExprListCons(expr, rest)
}

fn expr_list_from_nodes(nodes: i64, index: i64, count: i64) -> ExprList {
  if index >= count { ExprListNil }
  else {
    ExprListCons(expr_from_node(nlist_get(nodes, index)), expr_list_from_nodes(nodes, index + 1, count))
  }
}

fn expr_list_len(exprs: ExprList) -> i64 {
  match exprs {
    ExprListNil -> 0
    ExprListCons(expr, rest) -> 1 + expr_list_len(rest)
  }
}

fn expr_list_count_tag(exprs: ExprList, tag: i64) -> i64 {
  match exprs {
    ExprListNil -> 0
    ExprListCons(expr, rest) -> {
      let add = if expr_tag(expr) == tag { 1 } else { 0 }
      add + expr_list_count_tag(rest, tag)
    }
  }
}

fn expr_list_nth_tag_or(exprs: ExprList, index: i64, default: i64) -> i64 {
  match exprs {
    ExprListNil -> default
    ExprListCons(expr, rest) -> if index == 0 { expr_tag(expr) } else { expr_list_nth_tag_or(rest, index - 1, default) }
  }
}

fn expr_call_args(expr: Expr) -> ExprList {
  match expr {
    Call(ns, nl, args) -> args
    GenericCall(type_args, inner_call) -> expr_call_args(inner_call)
    MethodCall(recv, method_hash, args, type_hash) -> args
    Perform(lhs, op_ns, op_nl, args) -> args
    _ -> ExprListNil
  }
}

fn expr_call_arg_count_or(expr: Expr, default: i64) -> i64 {
  match expr {
    Call(ns, nl, args) -> expr_list_len(args)
    GenericCall(type_args, inner_call) -> expr_call_arg_count_or(inner_call, default)
    MethodCall(recv, method_hash, args, type_hash) -> expr_list_len(args)
    Perform(lhs, op_ns, op_nl, args) -> expr_list_len(args)
    _ -> default
  }
}

fn expr_tag(expr: Expr) -> i64 {
  match expr {
    IntLit(value) -> 1
    StringLit(start, len) -> 9
    BoolLit(value) -> 24
    Ident(ns, nl) -> 2
    BinOp(op, lhs, rhs) -> 3
    Call(ns, nl, args) -> 4
    GenericCall(type_args, inner_call) -> 36
    If(cond, then_expr, else_expr) -> 5
    While(cond, body) -> 10
    Loop(body) -> 49
    Break(value) -> 26
    BreakNoValue -> 26
    Continue -> 27
    Return(value) -> 25
    ReturnNoValue -> 25
    Defer(cleanup, body) -> 52
    Let(ns, nl, value, body) -> 6
    LetMut(ns, nl, value, body) -> 11
    Assign(ns, nl, value) -> 12
    AddressOf(mutable, target) -> 55
    Deref(ptr) -> 56
    PtrAssign(ptr, value) -> 57
    Block(first, rest) -> 7
    FieldAccess(base, field_ns, field_nl) -> 13
    RecordInit(type_ns, type_nl, fields) -> 14
    Match(scrutinee, arms) -> 15
    Not(operand) -> 22
    Lambda(params, body) -> 29
    Perform(lhs, op_ns, op_nl, args) -> 32
    Handle(body, clauses) -> 33
    Resume(value) -> 35
    MethodCall(recv, method_hash, args, type_hash) -> 41
    Try(inner) -> 45
    InterpConcat(left, right) -> 46
    ForIter(var_ns, var_nl, collection, body) -> 47
    OptChain(base, field_ns, field_nl) -> 48
    LetTyped(inner, ann_type) -> 37
    NilExpr -> 51
    UnknownExpr(tag) -> tag
  }
}

fn expr_unknown_count(expr: Expr) -> i64 {
  match expr {
    UnknownExpr(tag) -> 1
    _ -> 0
  }
}

fn expr_list_unknown_count(exprs: ExprList) -> i64 {
  match exprs {
    ExprListNil -> 0
    ExprListCons(expr, rest) -> expr_unknown_count(expr) + expr_list_unknown_count(rest)
  }
}

fn expr_raw_bridge_slot_count(expr: Expr) -> i64 {
  match expr {
    IntLit(value) -> 0
    StringLit(start, len) -> 0
    BoolLit(value) -> 0
    Ident(ns, nl) -> 0
    BinOp(op, lhs, rhs) -> 0
    Call(ns, nl, args) -> 0
    GenericCall(type_args, inner_call) -> 0
    If(cond, then_expr, else_expr) -> 0
    While(cond, body) -> 0
    Loop(body) -> 0
    Break(value) -> 0
    BreakNoValue -> 0
    Continue -> 0
    Return(value) -> 0
    ReturnNoValue -> 0
    Defer(cleanup, body) -> 0
    Let(ns, nl, value, body) -> 0
    LetMut(ns, nl, value, body) -> 0
    Assign(ns, nl, value) -> 0
    AddressOf(mutable, target) -> 0
    Deref(ptr) -> 0
    PtrAssign(ptr, value) -> 0
    Block(first, rest) -> 0
    FieldAccess(base, field_ns, field_nl) -> 0
    RecordInit(type_ns, type_nl, fields) -> 0
    Match(scrutinee, arms) -> 0
    Not(operand) -> 0
    Lambda(params, body) -> 0
    Perform(lhs, op_ns, op_nl, args) -> 0
    Handle(body, clauses) -> 0
    Resume(value) -> 0
    MethodCall(recv, method_hash, args, type_hash) -> 0
    Try(inner) -> 0
    InterpConcat(left, right) -> 0
    ForIter(var_ns, var_nl, collection, body) -> 0
    OptChain(base, field_ns, field_nl) -> 0
    LetTyped(inner, ann_type) -> 0
    NilExpr -> 0
    UnknownExpr(tag) -> 0
  }
}

fn expr_list_raw_bridge_slot_count(exprs: ExprList) -> i64 {
  match exprs {
    ExprListNil -> 0
    ExprListCons(expr, rest) -> expr_raw_bridge_slot_count(expr) + expr_list_raw_bridge_slot_count(rest)
  }
}

fn expr_int_value_or(expr: Expr, default: i64) -> i64 {
  match expr {
    IntLit(value) -> value
    _ -> default
  }
}

fn expr_if_then_tag_or(expr: Expr, default: i64) -> i64 {
  match expr {
    If(cond, then_expr, else_expr) -> expr_tag(then_expr)
    _ -> default
  }
}

fn expr_if_else_tag_or(expr: Expr, default: i64) -> i64 {
  match expr {
    If(cond, then_expr, else_expr) -> expr_tag(else_expr)
    _ -> default
  }
}

fn expr_if_cond_tag_or(expr: Expr, default: i64) -> i64 {
  match expr {
    If(cond, then_expr, else_expr) -> expr_tag(cond)
    _ -> default
  }
}

fn expr_while_cond_tag_or(expr: Expr, default: i64) -> i64 {
  match expr {
    While(cond, body) -> expr_tag(cond)
    _ -> default
  }
}

fn expr_while_body_tag_or(expr: Expr, default: i64) -> i64 {
  match expr {
    While(cond, body) -> expr_tag(body)
    _ -> default
  }
}

fn expr_loop_body_tag_or(expr: Expr, default: i64) -> i64 {
  match expr {
    Loop(body) -> expr_tag(body)
    _ -> default
  }
}

fn expr_bin_left_tag_or(expr: Expr, default: i64) -> i64 {
  match expr {
    BinOp(op, lhs, rhs) -> expr_tag(lhs)
    _ -> default
  }
}

fn expr_bin_right_tag_or(expr: Expr, default: i64) -> i64 {
  match expr {
    BinOp(op, lhs, rhs) -> expr_tag(rhs)
    _ -> default
  }
}

fn expr_not_operand_tag_or(expr: Expr, default: i64) -> i64 {
  match expr {
    Not(operand) -> expr_tag(operand)
    _ -> default
  }
}

fn expr_try_inner_tag_or(expr: Expr, default: i64) -> i64 {
  match expr {
    Try(inner) -> expr_tag(inner)
    _ -> default
  }
}

fn expr_resume_value_tag_or(expr: Expr, default: i64) -> i64 {
  match expr {
    Resume(value) -> expr_tag(value)
    _ -> default
  }
}

fn expr_return_value_tag_or(expr: Expr, default: i64) -> i64 {
  match expr {
    Return(value) -> expr_tag(value)
    ReturnNoValue -> default
    _ -> default
  }
}

fn expr_break_value_tag_or(expr: Expr, default: i64) -> i64 {
  match expr {
    Break(value) -> expr_tag(value)
    BreakNoValue -> default
    _ -> default
  }
}

fn expr_block_first_tag_or(expr: Expr, default: i64) -> i64 {
  match expr {
    Block(first, rest) -> expr_tag(first)
    _ -> default
  }
}

fn expr_block_rest_tag_or(expr: Expr, default: i64) -> i64 {
  match expr {
    Block(first, rest) -> expr_tag(rest)
    _ -> default
  }
}

fn expr_let_value_tag_or(expr: Expr, default: i64) -> i64 {
  match expr {
    Let(ns, nl, value, body) -> expr_tag(value)
    LetMut(ns, nl, value, body) -> expr_tag(value)
    _ -> default
  }
}

fn expr_let_body_tag_or(expr: Expr, default: i64) -> i64 {
  match expr {
    Let(ns, nl, value, body) -> expr_tag(body)
    LetMut(ns, nl, value, body) -> expr_tag(body)
    _ -> default
  }
}

fn expr_assign_value_tag_or(expr: Expr, default: i64) -> i64 {
  match expr {
    Assign(ns, nl, value) -> expr_tag(value)
    _ -> default
  }
}

fn expr_let_typed_inner_tag_or(expr: Expr, default: i64) -> i64 {
  match expr {
    LetTyped(inner, ann_type) -> expr_tag(inner)
    _ -> default
  }
}

fn expr_let_typed_ann_prim_or(expr: Expr, default: i64) -> i64 {
  match expr {
    LetTyped(inner, ann_type) -> type_expr_prim_id_or(ann_type, default)
    _ -> default
  }
}

fn expr_generic_inner_tag_or(expr: Expr, default: i64) -> i64 {
  match expr {
    GenericCall(type_args, inner_call) -> expr_tag(inner_call)
    _ -> default
  }
}

fn expr_perform_lhs_tag_or(expr: Expr, default: i64) -> i64 {
  match expr {
    Perform(lhs, op_ns, op_nl, args) -> expr_tag(lhs)
    _ -> default
  }
}

fn expr_method_receiver_tag_or(expr: Expr, default: i64) -> i64 {
  match expr {
    MethodCall(recv, method_hash, args, type_hash) -> expr_tag(recv)
    _ -> default
  }
}

fn expr_address_target_tag_or(expr: Expr, default: i64) -> i64 {
  match expr {
    AddressOf(mutable, target) -> expr_tag(target)
    _ -> default
  }
}

fn expr_deref_ptr_tag_or(expr: Expr, default: i64) -> i64 {
  match expr {
    Deref(ptr) -> expr_tag(ptr)
    _ -> default
  }
}

fn expr_ptr_assign_ptr_tag_or(expr: Expr, default: i64) -> i64 {
  match expr {
    PtrAssign(ptr, value) -> expr_tag(ptr)
    _ -> default
  }
}

fn expr_ptr_assign_value_tag_or(expr: Expr, default: i64) -> i64 {
  match expr {
    PtrAssign(ptr, value) -> expr_tag(value)
    _ -> default
  }
}

fn expr_defer_cleanup_tag_or(expr: Expr, default: i64) -> i64 {
  match expr {
    Defer(cleanup, body) -> expr_tag(cleanup)
    _ -> default
  }
}

fn expr_defer_body_tag_or(expr: Expr, default: i64) -> i64 {
  match expr {
    Defer(cleanup, body) -> expr_tag(body)
    _ -> default
  }
}

fn expr_interp_left_tag_or(expr: Expr, default: i64) -> i64 {
  match expr {
    InterpConcat(left, right) -> expr_tag(left)
    _ -> default
  }
}

fn expr_interp_right_tag_or(expr: Expr, default: i64) -> i64 {
  match expr {
    InterpConcat(left, right) -> expr_tag(right)
    _ -> default
  }
}

fn expr_for_iter_var_name_len_or(expr: Expr, default: i64) -> i64 {
  match expr {
    ForIter(var_ns, var_nl, collection, body) -> var_nl
    _ -> default
  }
}

fn expr_for_iter_collection_tag_or(expr: Expr, default: i64) -> i64 {
  match expr {
    ForIter(var_ns, var_nl, collection, body) -> expr_tag(collection)
    _ -> default
  }
}

fn expr_for_iter_body_tag_or(expr: Expr, default: i64) -> i64 {
  match expr {
    ForIter(var_ns, var_nl, collection, body) -> expr_tag(body)
    _ -> default
  }
}

-- ══════════════════════════════════════════════════════════════
-- Type expressions
-- ══════════════════════════════════════════════════════════════

type TypeExpr {
  TypeExpr(i64),
  MissingTypeExpr
}

type TypeExprList {
  TypeExprListNil,
  TypeExprListCons(TypeExpr, TypeExprList)
}

type EffectAtomList {
  EffectAtomListNil,
  EffectAtomListCons(i64, EffectAtomList)
}

type EffectSig {
  EffectSig(EffectAtomList, i64), -- concrete effect hashes plus optional tail variable
  MissingEffectSig
}

fn type_expr_from_node(ty: i64) -> TypeExpr {
  if ty == 0 { MissingTypeExpr } else { TypeExpr(ty) }
}

fn effect_atom_hash_or(node: i64, default: i64) -> i64 {
  if node == 0 { default }
  else {
    if ty_tag(node) == 11 { ty_f1(node) } else { default }
  }
}

fn effect_atom_list_from_nodes(nodes: i64, index: i64, count: i64) -> EffectAtomList {
  if index >= count { EffectAtomListNil }
  else {
    EffectAtomListCons(effect_atom_hash_or(nlist_get(nodes, index), 0), effect_atom_list_from_nodes(nodes, index + 1, count))
  }
}

fn effect_atom_list_from_type_nodes(nodes: i64) -> EffectAtomList {
  if nodes == 0 { EffectAtomListNil }
  else { effect_atom_list_from_nodes(nodes, 0, nlist_len(nodes)) }
}

fn effect_atom_list_len(atoms: EffectAtomList) -> i64 {
  match atoms {
    EffectAtomListNil -> 0
    EffectAtomListCons(hash, rest) -> 1 + effect_atom_list_len(rest)
  }
}

fn effect_sig_from_node(sig: i64) -> EffectSig {
  if sig == 0 { MissingEffectSig }
  else {
    if ty_tag(sig) == 10 {
      EffectSig(effect_atom_list_from_type_nodes(ty_f1(sig)), ty_f2(sig))
    } else {
      MissingEffectSig
    }
  }
}

fn effect_sig_count_or(sig: EffectSig, default: i64) -> i64 {
  match sig {
    EffectSig(effects, tail_var) -> effect_atom_list_len(effects)
    MissingEffectSig -> default
  }
}

fn effect_sig_tail_var_or(sig: EffectSig, default: i64) -> i64 {
  match sig {
    EffectSig(effects, tail_var) -> tail_var
    MissingEffectSig -> default
  }
}

fn type_expr_tag_or(ty: TypeExpr, default: i64) -> i64 {
  match ty {
    TypeExpr(raw) -> ty_tag(raw)
    MissingTypeExpr -> default
  }
}

fn type_expr_prim_id_or(ty: TypeExpr, default: i64) -> i64 {
  match ty {
    TypeExpr(raw) -> if ty_tag(raw) == 2 { ty_f1(raw) } else { default }
    MissingTypeExpr -> default
  }
}

fn type_expr_list_empty() -> TypeExprList {
  TypeExprListNil
}

fn type_expr_list_from_nodes(types: i64, index: i64, count: i64) -> TypeExprList {
  if index >= count { TypeExprListNil }
  else {
    TypeExprListCons(type_expr_from_node(nlist_get(types, index)), type_expr_list_from_nodes(types, index + 1, count))
  }
}

fn type_expr_list_from_type_nodes(types: i64) -> TypeExprList {
  if types == 0 { TypeExprListNil } else { type_expr_list_from_nodes(types, 0, nlist_len(types)) }
}

fn expr_generic_type_args(expr: Expr) -> TypeExprList {
  match expr {
    GenericCall(type_args, inner_call) -> type_args
    _ -> TypeExprListNil
  }
}

fn expr_generic_type_arg_count_or(expr: Expr, default: i64) -> i64 {
  match expr {
    GenericCall(type_args, inner_call) -> type_expr_list_len(type_args)
    _ -> default
  }
}

fn type_expr_list_len(types: TypeExprList) -> i64 {
  match types {
    TypeExprListNil -> 0
    TypeExprListCons(ty, rest) -> 1 + type_expr_list_len(rest)
  }
}

fn type_expr_list_nth_tag_or(types: TypeExprList, index: i64, default: i64) -> i64 {
  match types {
    TypeExprListNil -> default
    TypeExprListCons(ty, rest) -> {
      if index == 0 { type_expr_tag_or(ty, default) }
      else { type_expr_list_nth_tag_or(rest, index - 1, default) }
    }
  }
}

fn type_expr_list_nth_prim_id_or(types: TypeExprList, index: i64, default: i64) -> i64 {
  match types {
    TypeExprListNil -> default
    TypeExprListCons(ty, rest) -> {
      if index == 0 { type_expr_prim_id_or(ty, default) }
      else { type_expr_list_nth_prim_id_or(rest, index - 1, default) }
    }
  }
}

fn type_expr_list_count_tag(types: TypeExprList, tag: i64) -> i64 {
  match types {
    TypeExprListNil -> 0
    TypeExprListCons(ty, rest) -> {
      let add = if type_expr_tag_or(ty, 0 - 1) == tag { 1 } else { 0 }
      add + type_expr_list_count_tag(rest, tag)
    }
  }
}

-- ══════════════════════════════════════════════════════════════
-- Type table entries
-- ══════════════════════════════════════════════════════════════

type TypeEntry {
  TypeEntryInfo(i64, i64, i64, TypeEntryPayload),
  MissingTypeEntry
}

type TypeEntryList {
  TypeEntryListNil,
  TypeEntryListCons(TypeEntry, TypeEntryList)
}

fn type_entry_from_ptr(entry: i64) -> TypeEntry {
  if entry == 0 { MissingTypeEntry }
  else {
    let ns = __mem_load64(entry)
    let nl = __mem_load64(entry + 8)
    let kind = __mem_load64(entry + 16)
    let count = __mem_load64(entry + 24)
    let payload = __mem_load64(entry + 32)
    TypeEntryInfo(ns, nl, kind, TypeEntryPayload(count, payload, __mem_load64(entry + 40), __mem_load64(entry + 48)))
  }
}

fn type_entry_payload_count_or(payload_info: TypeEntryPayload, default: i64) -> i64 {
  match payload_info {
    TypeEntryPayload(count, payload, tparams, src) -> count
    MissingTypeEntryPayload -> default
  }
}

fn type_entry_payload_ptr_or(payload_info: TypeEntryPayload, default: i64) -> i64 {
  match payload_info {
    TypeEntryPayload(count, payload, tparams, src) -> payload
    MissingTypeEntryPayload -> default
  }
}

fn type_entry_payload_type_params_or(payload_info: TypeEntryPayload, default: i64) -> i64 {
  match payload_info {
    TypeEntryPayload(count, payload, tparams, src) -> tparams
    MissingTypeEntryPayload -> default
  }
}

fn type_entry_payload_source_or(payload_info: TypeEntryPayload, default: i64) -> i64 {
  match payload_info {
    TypeEntryPayload(count, payload, tparams, src) -> src
    MissingTypeEntryPayload -> default
  }
}

fn type_entry_kind_or(entry: TypeEntry, default: i64) -> i64 {
  match entry {
    TypeEntryInfo(ns, nl, kind, payload_info) -> kind
    MissingTypeEntry -> default
  }
}

fn type_entry_name_len_or(entry: TypeEntry, default: i64) -> i64 {
  match entry {
    TypeEntryInfo(ns, nl, kind, payload_info) -> nl
    MissingTypeEntry -> default
  }
}

fn type_entry_name_start_or(entry: TypeEntry, default: i64) -> i64 {
  match entry {
    TypeEntryInfo(ns, nl, kind, payload_info) -> ns
    MissingTypeEntry -> default
  }
}

fn type_entry_source_or(entry: TypeEntry, default: i64) -> i64 {
  match entry {
    TypeEntryInfo(ns, nl, kind, payload_info) -> type_entry_payload_source_or(payload_info, default)
    MissingTypeEntry -> default
  }
}

fn type_entry_item_count_or(entry: TypeEntry, default: i64) -> i64 {
  match entry {
    TypeEntryInfo(ns, nl, kind, payload_info) -> type_entry_payload_count_or(payload_info, default)
    MissingTypeEntry -> default
  }
}

fn type_entry_raw_bridge_slot_count(entry: TypeEntry) -> i64 {
  match entry {
    TypeEntryInfo(ns, nl, kind, payload_info) -> if type_entry_payload_count_or(payload_info, 0) == 0 { 0 } else { 1 }
    MissingTypeEntry -> 0
  }
}

fn type_entry_type_param_count_or(entry: TypeEntry, default: i64) -> i64 {
  match entry {
    TypeEntryInfo(ns, nl, kind, payload_info) -> type_param_list_len(type_entry_type_param_list_from_raw(kind, type_entry_payload_type_params_or(payload_info, 0)))
    MissingTypeEntry -> default
  }
}

fn type_entry_list_empty() -> TypeEntryList {
  TypeEntryListNil
}

fn type_entry_list_from_table(tt: i64, index: i64, count: i64) -> TypeEntryList {
  if index >= count { TypeEntryListNil }
  else {
    let entries = __mem_load64(tt)
    TypeEntryListCons(type_entry_from_ptr(entries + index * 56), type_entry_list_from_table(tt, index + 1, count))
  }
}

fn type_entries_from_table(tt: i64) -> TypeEntryList {
  if tt == 0 { TypeEntryListNil }
  else { type_entry_list_from_table(tt, 0, __mem_load64(tt + 8)) }
}

fn type_entry_list_nth(entries: TypeEntryList, index: i64) -> TypeEntry {
  match entries {
    TypeEntryListNil -> MissingTypeEntry
    TypeEntryListCons(entry, rest) -> {
      if index == 0 { entry } else { type_entry_list_nth(rest, index - 1) }
    }
  }
}

fn type_entry_list_len(entries: TypeEntryList) -> i64 {
  match entries {
    TypeEntryListNil -> 0
    TypeEntryListCons(entry, rest) -> 1 + type_entry_list_len(rest)
  }
}

fn type_entry_list_count_kind(entries: TypeEntryList, kind: i64) -> i64 {
  match entries {
    TypeEntryListNil -> 0
    TypeEntryListCons(entry, rest) -> {
      let add = if type_entry_kind_or(entry, 0 - 1) == kind { 1 } else { 0 }
      add + type_entry_list_count_kind(rest, kind)
    }
  }
}

fn type_entry_list_nth_kind_or(entries: TypeEntryList, index: i64, default: i64) -> i64 {
  match entries {
    TypeEntryListNil -> default
    TypeEntryListCons(entry, rest) -> {
      if index == 0 { type_entry_kind_or(entry, default) }
      else { type_entry_list_nth_kind_or(rest, index - 1, default) }
    }
  }
}

fn type_entry_list_nth_name_len_or(entries: TypeEntryList, index: i64, default: i64) -> i64 {
  match entries {
    TypeEntryListNil -> default
    TypeEntryListCons(entry, rest) -> {
      if index == 0 { type_entry_name_len_or(entry, default) }
      else { type_entry_list_nth_name_len_or(rest, index - 1, default) }
    }
  }
}

fn type_entry_list_nth_item_count_or(entries: TypeEntryList, index: i64, default: i64) -> i64 {
  match entries {
    TypeEntryListNil -> default
    TypeEntryListCons(entry, rest) -> {
      if index == 0 { type_entry_item_count_or(entry, default) }
      else { type_entry_list_nth_item_count_or(rest, index - 1, default) }
    }
  }
}

fn type_entry_list_nth_type_param_count_or(entries: TypeEntryList, index: i64, default: i64) -> i64 {
  match entries {
    TypeEntryListNil -> default
    TypeEntryListCons(entry, rest) -> {
      if index == 0 { type_entry_type_param_count_or(entry, default) }
      else { type_entry_list_nth_type_param_count_or(rest, index - 1, default) }
    }
  }
}

fn type_entry_list_raw_bridge_slot_count(entries: TypeEntryList) -> i64 {
  match entries {
    TypeEntryListNil -> 0
    TypeEntryListCons(entry, rest) -> type_entry_raw_bridge_slot_count(entry) + type_entry_list_raw_bridge_slot_count(rest)
  }
}

type TypeParam {
  TypeParam(i64, i64, i64, i64),  -- tag 2: f1=name_ns, f2=name_nl, f3=var_id, f4=bounds
  MissingTypeParam
}

type TypeParamList {
  TypeParamListNil,
  TypeParamListCons(TypeParam, TypeParamList)
}

fn type_param_list_empty() -> TypeParamList {
  TypeParamListNil
}

fn type_param_from_node(node: i64) -> TypeParam {
  if node == 0 { MissingTypeParam }
  else {
    match node_tag(node) {
      2 -> TypeParam(node_f1(node), node_f2(node), node_f3(node), node_f4(node))
      _ -> MissingTypeParam
    }
  }
}

fn type_param_list_from_nodes(nodes: i64, index: i64, count: i64) -> TypeParamList {
  if index >= count { TypeParamListNil }
  else {
    TypeParamListCons(type_param_from_node(nlist_get(nodes, index)), type_param_list_from_nodes(nodes, index + 1, count))
  }
}

fn type_param_list_from_type_param_nodes(params: i64) -> TypeParamList {
  if params == 0 { TypeParamListNil } else { type_param_list_from_nodes(params, 0, nlist_len(params)) }
}

fn type_entry_type_param_list_from_raw(kind: i64, params: i64) -> TypeParamList {
  if kind == 4 {
    if params == 0 { TypeParamListNil } else { type_param_list_from_type_param_nodes(node_f2(params)) }
  } else {
    type_param_list_from_type_param_nodes(params)
  }
}

fn type_entry_type_params(entry: TypeEntry) -> TypeParamList {
  match entry {
    TypeEntryInfo(ns, nl, kind, payload_info) -> type_entry_type_param_list_from_raw(kind, type_entry_payload_type_params_or(payload_info, 0))
    MissingTypeEntry -> TypeParamListNil
  }
}

fn type_param_name_len_or(param: TypeParam, default: i64) -> i64 {
  match param {
    TypeParam(ns, nl, var_id, bounds) -> nl
    MissingTypeParam -> default
  }
}

fn type_param_var_id_or(param: TypeParam, default: i64) -> i64 {
  match param {
    TypeParam(ns, nl, var_id, bounds) -> var_id
    MissingTypeParam -> default
  }
}

fn type_param_bound_count_or(param: TypeParam, default: i64) -> i64 {
  match param {
    TypeParam(ns, nl, var_id, bounds) -> if bounds == 0 { 0 } else { nlist_len(bounds) }
    MissingTypeParam -> default
  }
}

fn type_param_list_len(params: TypeParamList) -> i64 {
  match params {
    TypeParamListNil -> 0
    TypeParamListCons(param, rest) -> 1 + type_param_list_len(rest)
  }
}

fn type_param_list_nth(params: TypeParamList, index: i64) -> TypeParam {
  match params {
    TypeParamListNil -> MissingTypeParam
    TypeParamListCons(param, rest) -> {
      if index == 0 { param } else { type_param_list_nth(rest, index - 1) }
    }
  }
}

fn type_param_list_nth_name_len_or(params: TypeParamList, index: i64, default: i64) -> i64 {
  type_param_name_len_or(type_param_list_nth(params, index), default)
}

fn type_param_list_nth_var_id_or(params: TypeParamList, index: i64, default: i64) -> i64 {
  type_param_var_id_or(type_param_list_nth(params, index), default)
}

fn type_param_list_nth_bound_count_or(params: TypeParamList, index: i64, default: i64) -> i64 {
  type_param_bound_count_or(type_param_list_nth(params, index), default)
}

fn type_param_list_count_bound_count(params: TypeParamList, bound_count: i64) -> i64 {
  match params {
    TypeParamListNil -> 0
    TypeParamListCons(param, rest) -> {
      let add = if type_param_bound_count_or(param, 0 - 1) == bound_count { 1 } else { 0 }
      add + type_param_list_count_bound_count(rest, bound_count)
    }
  }
}

type TypeRecordField {
  TypeRecordField(i64, i64, TypeExpr),
  MissingTypeRecordField
}

type TypeRecordFieldList {
  TypeRecordFieldListNil,
  TypeRecordFieldListCons(TypeRecordField, TypeRecordFieldList)
}

fn type_record_field_list_empty() -> TypeRecordFieldList {
  TypeRecordFieldListNil
}

fn type_record_field_list_from_array(fields: i64, index: i64, count: i64) -> TypeRecordFieldList {
  if index >= count { TypeRecordFieldListNil }
  else {
    let base = fields + index * 24
    let field = TypeRecordField(__mem_load64(base), __mem_load64(base + 8), type_expr_from_node(__mem_load64(base + 16)))
    TypeRecordFieldListCons(field, type_record_field_list_from_array(fields, index + 1, count))
  }
}

fn type_entry_record_fields(entry: TypeEntry) -> TypeRecordFieldList {
  match entry {
    TypeEntryInfo(ns, nl, kind, payload_info) -> {
      if kind == 0 { type_record_field_list_from_array(type_entry_payload_ptr_or(payload_info, 0), 0, type_entry_payload_count_or(payload_info, 0)) } else { TypeRecordFieldListNil }
    }
    _ -> TypeRecordFieldListNil
  }
}

fn type_record_field_name_len_or(field: TypeRecordField, default: i64) -> i64 {
  match field {
    TypeRecordField(ns, nl, ty) -> nl
    MissingTypeRecordField -> default
  }
}

fn type_record_field_type_tag_or(field: TypeRecordField, default: i64) -> i64 {
  match field {
    TypeRecordField(ns, nl, ty) -> type_expr_tag_or(ty, default)
    MissingTypeRecordField -> default
  }
}

fn type_record_field_type_prim_id_or(field: TypeRecordField, default: i64) -> i64 {
  match field {
    TypeRecordField(ns, nl, ty) -> type_expr_prim_id_or(ty, default)
    MissingTypeRecordField -> default
  }
}

fn type_record_field_list_len(fields: TypeRecordFieldList) -> i64 {
  match fields {
    TypeRecordFieldListNil -> 0
    TypeRecordFieldListCons(field, rest) -> 1 + type_record_field_list_len(rest)
  }
}

fn type_record_field_list_nth_name_len_or(fields: TypeRecordFieldList, index: i64, default: i64) -> i64 {
  match fields {
    TypeRecordFieldListNil -> default
    TypeRecordFieldListCons(field, rest) -> {
      if index == 0 { type_record_field_name_len_or(field, default) }
      else { type_record_field_list_nth_name_len_or(rest, index - 1, default) }
    }
  }
}

fn type_record_field_list_nth_type_tag_or(fields: TypeRecordFieldList, index: i64, default: i64) -> i64 {
  match fields {
    TypeRecordFieldListNil -> default
    TypeRecordFieldListCons(field, rest) -> {
      if index == 0 { type_record_field_type_tag_or(field, default) }
      else { type_record_field_list_nth_type_tag_or(rest, index - 1, default) }
    }
  }
}

fn type_record_field_list_nth_type_prim_id_or(fields: TypeRecordFieldList, index: i64, default: i64) -> i64 {
  match fields {
    TypeRecordFieldListNil -> default
    TypeRecordFieldListCons(field, rest) -> {
      if index == 0 { type_record_field_type_prim_id_or(field, default) }
      else { type_record_field_list_nth_type_prim_id_or(rest, index - 1, default) }
    }
  }
}

type TypeVariant {
  TypeVariant(i64, i64, i64, TypeExprList),
  MissingTypeVariant
}

type TypeVariantList {
  TypeVariantListNil,
  TypeVariantListCons(TypeVariant, TypeVariantList)
}

fn type_variant_list_empty() -> TypeVariantList {
  TypeVariantListNil
}

fn type_variant_list_from_array(variants: i64, index: i64, count: i64) -> TypeVariantList {
  if index >= count { TypeVariantListNil }
  else {
    let base = variants + index * 40
    let payload_count = __mem_load64(base + 24)
    let payloads = __mem_load64(base + 32)
    let variant = TypeVariant(__mem_load64(base), __mem_load64(base + 8), payload_count, type_expr_list_from_type_nodes(payloads))
    TypeVariantListCons(variant, type_variant_list_from_array(variants, index + 1, count))
  }
}

fn type_entry_variants(entry: TypeEntry) -> TypeVariantList {
  match entry {
    TypeEntryInfo(ns, nl, kind, payload_info) -> {
      if kind == 1 { type_variant_list_from_array(type_entry_payload_ptr_or(payload_info, 0), 0, type_entry_payload_count_or(payload_info, 0)) } else { TypeVariantListNil }
    }
    _ -> TypeVariantListNil
  }
}

fn type_variant_name_len_or(variant: TypeVariant, default: i64) -> i64 {
  match variant {
    TypeVariant(ns, nl, payload_count, payloads) -> nl
    MissingTypeVariant -> default
  }
}

fn type_variant_payload_count_or(variant: TypeVariant, default: i64) -> i64 {
  match variant {
    TypeVariant(ns, nl, payload_count, payloads) -> payload_count
    MissingTypeVariant -> default
  }
}

fn type_variant_payloads(variant: TypeVariant) -> TypeExprList {
  match variant {
    TypeVariant(ns, nl, payload_count, payloads) -> payloads
    MissingTypeVariant -> TypeExprListNil
  }
}

fn type_variant_list_len(variants: TypeVariantList) -> i64 {
  match variants {
    TypeVariantListNil -> 0
    TypeVariantListCons(variant, rest) -> 1 + type_variant_list_len(rest)
  }
}

fn type_variant_list_nth(variants: TypeVariantList, index: i64) -> TypeVariant {
  match variants {
    TypeVariantListNil -> MissingTypeVariant
    TypeVariantListCons(variant, rest) -> {
      if index == 0 { variant } else { type_variant_list_nth(rest, index - 1) }
    }
  }
}

fn type_variant_list_nth_name_len_or(variants: TypeVariantList, index: i64, default: i64) -> i64 {
  type_variant_name_len_or(type_variant_list_nth(variants, index), default)
}

fn type_variant_list_nth_payload_count_or(variants: TypeVariantList, index: i64, default: i64) -> i64 {
  type_variant_payload_count_or(type_variant_list_nth(variants, index), default)
}

fn type_variant_list_nth_payload_type_tag_or(variants: TypeVariantList, variant_index: i64, payload_index: i64, default: i64) -> i64 {
  type_expr_list_nth_tag_or(type_variant_payloads(type_variant_list_nth(variants, variant_index)), payload_index, default)
}

fn type_variant_list_nth_payload_type_prim_id_or(variants: TypeVariantList, variant_index: i64, payload_index: i64, default: i64) -> i64 {
  type_expr_list_nth_prim_id_or(type_variant_payloads(type_variant_list_nth(variants, variant_index)), payload_index, default)
}

-- ══════════════════════════════════════════════════════════════
-- Record fields
-- ══════════════════════════════════════════════════════════════

type RecordField {
  RecordField(i64, i64, Expr),     -- f1=name_ns, f2=name_nl, typed value expr
  UnknownRecordField(i64)
}

type RecordFieldList {
  RecordFieldListNil,
  RecordFieldListCons(RecordField, RecordFieldList)
}

fn record_field_from_node(node: i64) -> RecordField {
  if node == 0 { UnknownRecordField(0) }
  else {
    match node_tag(node) {
      2 -> RecordField(node_f1(node), node_f2(node), expr_from_node(node_f3(node)))
      _ -> UnknownRecordField(node_tag(node))
    }
  }
}

fn record_field_value_expr(field: RecordField) -> Expr {
  match field {
    RecordField(ns, nl, value) -> value
    UnknownRecordField(tag) -> UnknownExpr(0)
  }
}

fn record_field_name_len_or(field: RecordField, default: i64) -> i64 {
  match field {
    RecordField(ns, nl, value) -> nl
    _ -> default
  }
}

fn record_field_list_empty() -> RecordFieldList {
  RecordFieldListNil
}

fn record_field_list_from_nodes(nodes: i64, index: i64, count: i64) -> RecordFieldList {
  if index >= count { RecordFieldListNil }
  else {
    RecordFieldListCons(record_field_from_node(nlist_get(nodes, index)), record_field_list_from_nodes(nodes, index + 1, count))
  }
}

fn expr_record_fields(expr: Expr) -> RecordFieldList {
  match expr {
    RecordInit(type_ns, type_nl, fields) -> fields
    _ -> RecordFieldListNil
  }
}

fn expr_record_field_count_or(expr: Expr, default: i64) -> i64 {
  match expr {
    RecordInit(type_ns, type_nl, fields) -> record_field_list_len(fields)
    _ -> default
  }
}

fn expr_field_name_len_or(expr: Expr, default: i64) -> i64 {
  match expr {
    FieldAccess(base, field_ns, field_nl) -> field_nl
    OptChain(base, field_ns, field_nl) -> field_nl
    _ -> default
  }
}

fn expr_field_base_tag_or(expr: Expr, default: i64) -> i64 {
  match expr {
    FieldAccess(base, field_ns, field_nl) -> expr_tag(base)
    OptChain(base, field_ns, field_nl) -> expr_tag(base)
    _ -> default
  }
}

fn record_field_list_len(fields: RecordFieldList) -> i64 {
  match fields {
    RecordFieldListNil -> 0
    RecordFieldListCons(field, rest) -> 1 + record_field_list_len(rest)
  }
}

fn record_field_list_nth_name_len_or(fields: RecordFieldList, index: i64, default: i64) -> i64 {
  match fields {
    RecordFieldListNil -> default
    RecordFieldListCons(field, rest) -> {
      if index == 0 { record_field_name_len_or(field, default) }
      else { record_field_list_nth_name_len_or(rest, index - 1, default) }
    }
  }
}

fn record_field_list_nth_value_tag_or(fields: RecordFieldList, index: i64, default: i64) -> i64 {
  match fields {
    RecordFieldListNil -> default
    RecordFieldListCons(field, rest) -> {
      if index == 0 { expr_tag(record_field_value_expr(field)) }
      else { record_field_list_nth_value_tag_or(rest, index - 1, default) }
    }
  }
}

fn record_field_list_count_value_tag(fields: RecordFieldList, tag: i64) -> i64 {
  match fields {
    RecordFieldListNil -> 0
    RecordFieldListCons(field, rest) -> {
      let add = if expr_tag(record_field_value_expr(field)) == tag { 1 } else { 0 }
      add + record_field_list_count_value_tag(rest, tag)
    }
  }
}

-- ══════════════════════════════════════════════════════════════
-- Parameters
-- ══════════════════════════════════════════════════════════════

type Param {
  Param(i64, i64, TypeExpr, i64),  -- tag 2: f1=name_ns, f2=name_nl, typed f3=type, f4=label
  UnknownParam(i64)
}

type ParamList {
  ParamListNil,
  ParamListCons(Param, ParamList)
}

fn param_from_node(node: i64) -> Param {
  if node == 0 { UnknownParam(0) }
  else {
    match node_tag(node) {
      2 -> Param(node_f1(node), node_f2(node), type_expr_from_node(node_f3(node)), node_f4(node))
      _ -> UnknownParam(node_tag(node))
    }
  }
}

fn param_name_len_or(param: Param, default: i64) -> i64 {
  match param {
    Param(ns, nl, ty, label) -> nl
    UnknownParam(tag) -> default
  }
}

fn param_has_type_annotation(param: Param) -> i64 {
  match param {
    Param(ns, nl, ty, label) -> {
      match ty {
        MissingTypeExpr -> 0
        _ -> 1
      }
    }
    UnknownParam(tag) -> 0
  }
}

fn param_type_tag_or(param: Param, default: i64) -> i64 {
  match param {
    Param(ns, nl, ty, label) -> type_expr_tag_or(ty, default)
    UnknownParam(tag) -> default
  }
}

fn param_type_prim_id_or(param: Param, default: i64) -> i64 {
  match param {
    Param(ns, nl, ty, label) -> type_expr_prim_id_or(ty, default)
    UnknownParam(tag) -> default
  }
}

fn param_label_kind(param: Param) -> i64 {
  match param {
    Param(ns, nl, ty, label) -> {
      if label < 0 { 1 } else { if label == 0 { 3 } else { 2 } }
    }
    UnknownParam(tag) -> 0
  }
}

fn param_call_label_len_or(param: Param, default: i64) -> i64 {
  match param {
    Param(ns, nl, ty, label) -> {
      if label < 0 { default }
      else { if label == 0 { nl } else { node_f2(label) } }
    }
    UnknownParam(tag) -> default
  }
}

fn param_list_empty() -> ParamList {
  ParamListNil
}

fn param_list_from_nodes(nodes: i64, index: i64, count: i64) -> ParamList {
  if index >= count { ParamListNil }
  else {
    ParamListCons(param_from_node(nlist_get(nodes, index)), param_list_from_nodes(nodes, index + 1, count))
  }
}

fn param_list_from_param_nodes(params: i64) -> ParamList {
  if params == 0 { ParamListNil } else { param_list_from_nodes(params, 0, nlist_len(params)) }
}

fn param_list_len(params: ParamList) -> i64 {
  match params {
    ParamListNil -> 0
    ParamListCons(param, rest) -> 1 + param_list_len(rest)
  }
}

fn param_list_nth_name_len_or(params: ParamList, index: i64, default: i64) -> i64 {
  match params {
    ParamListNil -> default
    ParamListCons(param, rest) -> {
      if index == 0 { param_name_len_or(param, default) }
      else { param_list_nth_name_len_or(rest, index - 1, default) }
    }
  }
}

fn param_list_nth_label_kind_or(params: ParamList, index: i64, default: i64) -> i64 {
  match params {
    ParamListNil -> default
    ParamListCons(param, rest) -> {
      if index == 0 { param_label_kind(param) }
      else { param_list_nth_label_kind_or(rest, index - 1, default) }
    }
  }
}

fn param_list_nth_call_label_len_or(params: ParamList, index: i64, default: i64) -> i64 {
  match params {
    ParamListNil -> default
    ParamListCons(param, rest) -> {
      if index == 0 { param_call_label_len_or(param, default) }
      else { param_list_nth_call_label_len_or(rest, index - 1, default) }
    }
  }
}

fn param_list_nth_has_type_annotation_or(params: ParamList, index: i64, default: i64) -> i64 {
  match params {
    ParamListNil -> default
    ParamListCons(param, rest) -> {
      if index == 0 { param_has_type_annotation(param) }
      else { param_list_nth_has_type_annotation_or(rest, index - 1, default) }
    }
  }
}

fn param_list_nth_type_tag_or(params: ParamList, index: i64, default: i64) -> i64 {
  match params {
    ParamListNil -> default
    ParamListCons(param, rest) -> {
      if index == 0 { param_type_tag_or(param, default) }
      else { param_list_nth_type_tag_or(rest, index - 1, default) }
    }
  }
}

fn param_list_nth_type_prim_id_or(params: ParamList, index: i64, default: i64) -> i64 {
  match params {
    ParamListNil -> default
    ParamListCons(param, rest) -> {
      if index == 0 { param_type_prim_id_or(param, default) }
      else { param_list_nth_type_prim_id_or(rest, index - 1, default) }
    }
  }
}

fn param_list_count_label_kind(params: ParamList, kind: i64) -> i64 {
  match params {
    ParamListNil -> 0
    ParamListCons(param, rest) -> {
      let add = if param_label_kind(param) == kind { 1 } else { 0 }
      add + param_list_count_label_kind(rest, kind)
    }
  }
}

fn expr_lambda_params(expr: Expr) -> ParamList {
  match expr {
    Lambda(params, body) -> params
    _ -> ParamListNil
  }
}

fn expr_lambda_param_count_or(expr: Expr, default: i64) -> i64 {
  match expr {
    Lambda(params, body) -> param_list_len(params)
    _ -> default
  }
}

fn expr_lambda_body_tag_or(expr: Expr, default: i64) -> i64 {
  match expr {
    Lambda(params, body) -> expr_tag(body)
    _ -> default
  }
}

-- ══════════════════════════════════════════════════════════════
-- Effect operations
-- ══════════════════════════════════════════════════════════════

type TypeEffectOp {
  TypeEffectOp(i64, i64, ParamList, TypeExpr), -- tag 31: f1=name_ns, f2=name_nl, typed params/ret
  DeferredTypeEffectOp(i64, i64, ParamList, TypeExpr),
  MissingTypeEffectOp
}

type TypeEffectOpList {
  TypeEffectOpListNil,
  TypeEffectOpListCons(TypeEffectOp, TypeEffectOpList)
}

fn type_effect_op_list_empty() -> TypeEffectOpList {
  TypeEffectOpListNil
}

fn type_effect_op_node_ret(node: i64) -> i64 {
  let meta = node_f4(node)
  if meta == 0 { 0 }
  else {
    if node_tag(meta) == 53 { node_f1(meta) } else { meta }
  }
}

fn type_effect_op_node_deferred(node: i64) -> i64 {
  let meta = node_f4(node)
  if meta == 0 { 0 }
  else {
    if node_tag(meta) == 53 { node_f2(meta) } else { 0 }
  }
}

fn type_effect_op_from_node(node: i64) -> TypeEffectOp {
  if node == 0 { MissingTypeEffectOp }
  else {
    match node_tag(node) {
      31 -> {
        let params = param_list_from_param_nodes(node_f3(node))
        let ret_type = type_expr_from_node(type_effect_op_node_ret(node))
        if type_effect_op_node_deferred(node) == 1 {
          DeferredTypeEffectOp(node_f1(node), node_f2(node), params, ret_type)
        } else {
          TypeEffectOp(node_f1(node), node_f2(node), params, ret_type)
        }
      }
      _ -> MissingTypeEffectOp
    }
  }
}

fn type_effect_op_list_from_nodes(nodes: i64, index: i64, count: i64) -> TypeEffectOpList {
  if index >= count { TypeEffectOpListNil }
  else {
    TypeEffectOpListCons(type_effect_op_from_node(nlist_get(nodes, index)), type_effect_op_list_from_nodes(nodes, index + 1, count))
  }
}

fn type_effect_op_list_from_decl_nodes(nodes: i64, count: i64) -> TypeEffectOpList {
  if nodes == 0 { TypeEffectOpListNil }
  else { type_effect_op_list_from_nodes(nodes, 0, count) }
}

fn type_entry_effect_ops(entry: TypeEntry) -> TypeEffectOpList {
  match entry {
    TypeEntryInfo(ns, nl, kind, payload_info) -> {
      if kind == 2 { type_effect_op_list_from_nodes(type_entry_payload_ptr_or(payload_info, 0), 0, type_entry_payload_count_or(payload_info, 0)) } else { TypeEffectOpListNil }
    }
    _ -> TypeEffectOpListNil
  }
}

fn type_effect_op_name_len_or(op: TypeEffectOp, default: i64) -> i64 {
  match op {
    TypeEffectOp(ns, nl, params, ret_type) -> nl
    DeferredTypeEffectOp(ns, nl, params, ret_type) -> nl
    MissingTypeEffectOp -> default
  }
}

fn type_effect_op_param_count_or(op: TypeEffectOp, default: i64) -> i64 {
  match op {
    TypeEffectOp(ns, nl, params, ret_type) -> param_list_len(params)
    DeferredTypeEffectOp(ns, nl, params, ret_type) -> param_list_len(params)
    MissingTypeEffectOp -> default
  }
}

fn type_effect_op_params(op: TypeEffectOp) -> ParamList {
  match op {
    TypeEffectOp(ns, nl, params, ret_type) -> params
    DeferredTypeEffectOp(ns, nl, params, ret_type) -> params
    MissingTypeEffectOp -> ParamListNil
  }
}

fn type_effect_op_return_type_tag_or(op: TypeEffectOp, default: i64) -> i64 {
  match op {
    TypeEffectOp(ns, nl, params, ret_type) -> type_expr_tag_or(ret_type, default)
    DeferredTypeEffectOp(ns, nl, params, ret_type) -> type_expr_tag_or(ret_type, default)
    MissingTypeEffectOp -> default
  }
}

fn type_effect_op_return_type_prim_id_or(op: TypeEffectOp, default: i64) -> i64 {
  match op {
    TypeEffectOp(ns, nl, params, ret_type) -> type_expr_prim_id_or(ret_type, default)
    DeferredTypeEffectOp(ns, nl, params, ret_type) -> type_expr_prim_id_or(ret_type, default)
    MissingTypeEffectOp -> default
  }
}

fn type_effect_op_is_deferred(op: TypeEffectOp) -> i64 {
  match op {
    TypeEffectOp(ns, nl, params, ret_type) -> 0
    DeferredTypeEffectOp(ns, nl, params, ret_type) -> 1
    MissingTypeEffectOp -> 0
  }
}

fn type_effect_op_list_len(ops: TypeEffectOpList) -> i64 {
  match ops {
    TypeEffectOpListNil -> 0
    TypeEffectOpListCons(op, rest) -> 1 + type_effect_op_list_len(rest)
  }
}

fn type_effect_op_list_nth(ops: TypeEffectOpList, index: i64) -> TypeEffectOp {
  match ops {
    TypeEffectOpListNil -> MissingTypeEffectOp
    TypeEffectOpListCons(op, rest) -> {
      if index == 0 { op } else { type_effect_op_list_nth(rest, index - 1) }
    }
  }
}

fn type_effect_op_list_nth_name_len_or(ops: TypeEffectOpList, index: i64, default: i64) -> i64 {
  type_effect_op_name_len_or(type_effect_op_list_nth(ops, index), default)
}

fn type_effect_op_list_nth_param_count_or(ops: TypeEffectOpList, index: i64, default: i64) -> i64 {
  type_effect_op_param_count_or(type_effect_op_list_nth(ops, index), default)
}

fn type_effect_op_list_nth_param_name_len_or(ops: TypeEffectOpList, op_index: i64, param_index: i64, default: i64) -> i64 {
  param_list_nth_name_len_or(type_effect_op_params(type_effect_op_list_nth(ops, op_index)), param_index, default)
}

fn type_effect_op_list_nth_param_has_type_annotation_or(ops: TypeEffectOpList, op_index: i64, param_index: i64, default: i64) -> i64 {
  param_list_nth_has_type_annotation_or(type_effect_op_params(type_effect_op_list_nth(ops, op_index)), param_index, default)
}

fn type_effect_op_list_nth_param_type_tag_or(ops: TypeEffectOpList, op_index: i64, param_index: i64, default: i64) -> i64 {
