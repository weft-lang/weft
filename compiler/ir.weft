  if raw_bridge_is_missing(nodes) == 1 { TypeTraitMemberListNil }
  else { if index >= count { TypeTraitMemberListNil }
  else {
    TypeTraitMemberListCons(type_trait_member_from_node(nlist_get(nodes, index)), type_trait_member_list_from_nodes(nodes, index + 1, count))
