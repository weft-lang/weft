pub(package) type TypeTraitMember {
  TypeTraitMethod(i64, i64, ParamList, TypeExpr, EffectSig), -- tag 39: name, typed params/ret_type/effects
  TypeTraitAssocType(i64, i64),                         -- tag 42: associated type declaration
  MissingTypeTraitMember
}

pub(package) type TypeTraitMemberList {
