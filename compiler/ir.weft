fn ir_block_list_empty() -> IrBlockList {
  IrBlockListNil
}

fn ir_block_list_prepend(block: IrBlock, rest: IrBlockList) -> IrBlockList {
  IrBlockListCons(block, rest)
}

fn ir_block_list_append(left: IrBlockList, right: IrBlockList) -> IrBlockList {
  match left {
    IrBlockListNil -> right
    IrBlockListCons(block, rest) -> IrBlockListCons(block, ir_block_list_append(rest, right))
  }
}

fn ir_block_list_len(blocks: IrBlockList) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> 1 + ir_block_list_len(rest)
  }
}

fn ir_block_list_inst_count(blocks: IrBlockList) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> ir_block_inst_count(block) + ir_block_list_inst_count(rest)
  }
}

fn ir_block_list_param_count(blocks: IrBlockList) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> ir_block_param_count(block) + ir_block_list_param_count(rest)
  }
}

fn ir_block_list_count_tag(blocks: IrBlockList, tag: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> ir_block_count_tag(block, tag) + ir_block_list_count_tag(rest, tag)
  }
}

fn ir_block_list_count_binary_op(blocks: IrBlockList, op: IrBinaryOp) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> ir_block_count_binary_op(block, op) + ir_block_list_count_binary_op(rest, op)
  }
}

fn ir_block_list_count_unary_op(blocks: IrBlockList, op: IrUnaryOp) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> ir_block_count_unary_op(block, op) + ir_block_list_count_unary_op(rest, op)
  }
}

fn ir_block_list_count_term_tag(blocks: IrBlockList, tag: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      let add = if ir_block_term_tag(block) == tag { 1 } else { 0 }
      add + ir_block_list_count_term_tag(rest, tag)
    }
  }
}

fn ir_block_list_first_block_id(blocks: IrBlockList) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> ir_block_id(block)
  }
}

fn ir_block_list_first_term_tag(blocks: IrBlockList) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> ir_block_term_tag(block)
  }
}

fn ir_block_list_first_inst_tag(blocks: IrBlockList) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> ir_block_first_inst_tag(block)
  }
}

fn ir_block_list_first_const_value_or(blocks: IrBlockList, default: i64) -> i64 {
  match blocks {
    IrBlockListNil -> default
    IrBlockListCons(block, rest) -> {
      let value = ir_block_first_const_value_or(block, default)
      if value == default { ir_block_list_first_const_value_or(rest, default) } else { value }
    }
  }
}

