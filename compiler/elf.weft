-- compiler/elf.weft -- deterministic ELF64/AArch64 executable emission
--
-- This Linux leaf emits a standalone ET_EXEC image with an RX load, optional
-- compiler-owned zero-fill RW storage, and an explicit non-executable stack
-- policy. It has no PT_INTERP, dynamic section, libc dependency, or host
-- linker step. Load segments use the AArch64 64 KiB maximum page alignment so
-- the same image remains valid on 4 KiB, 16 KiB, and 64 KiB Linux kernels.

use stdlib/bytes as bytes
use stdlib/bytes.{Bytes}
use stdlib/num.{num_i64_to_u8_checked}
use stdlib/option.{None, Some}
use stdlib/result.{Result}
use stdlib/vector as vector
use stdlib/vector.{*}

pub(package) type ElfExecutableEmission {
  ElfExecutableEmitted(Bytes),
  ElfExecutableInvalidEntryOffset(i64, i64)
}

pub(package) fn elf_aarch64_image_base() -> i64 { 4194304 }
pub(package) fn elf_aarch64_code_file_offset() -> i64 { 4096 }
pub(package) fn elf_aarch64_segment_alignment() -> i64 { 65536 }

fn elf_align(value: i64, alignment: i64) -> i64 {
  (value + alignment - 1) / alignment * alignment
}

pub(package) fn elf_aarch64_zero_fill_file_offset(code_size: i64) -> i64 {
  elf_align(elf_aarch64_code_file_offset() + code_size, elf_aarch64_segment_alignment())
}

fn elf_u8(output: Vector<u8>, value: i64) -> i64 {
  vector_push<u8>(output, num_i64_to_u8_checked(value).expect("ELF byte emission keeps values within u8 range"))
}

fn elf_u16(output: Vector<u8>, value: i64) -> i64 {
  elf_u8(output, value - value / 256 * 256)
  elf_u8(output, value / 256 - value / 65536 * 256)
}

fn elf_u32(output: Vector<u8>, value: i64) -> i64 {
  elf_u16(output, value - value / 65536 * 65536)
  elf_u16(output, value / 65536 - value / 4294967296 * 65536)
}

fn elf_u64(output: Vector<u8>, value: i64) -> i64 {
  elf_u32(output, value - value / 4294967296 * 4294967296)
  elf_u32(output, value / 4294967296)
}

fn elf_emit_ident(output: Vector<u8>) -> i64 {
  elf_u8(output, 127)
  elf_u8(output, 69)
  elf_u8(output, 76)
  elf_u8(output, 70)
  elf_u8(output, 2) -- ELFCLASS64
  elf_u8(output, 1) -- ELFDATA2LSB
  elf_u8(output, 1) -- EV_CURRENT
  elf_u8(output, 0) -- ELFOSABI_NONE / System V
  elf_u8(output, 0)
  for _ in 0..7 { elf_u8(output, 0) }
  1
}

fn elf_emit_load_program_header(output: Vector<u8>, file_size: i64) -> i64 {
  let image_base = elf_aarch64_image_base()
  elf_u32(output, 1) -- PT_LOAD
  elf_u32(output, 5) -- PF_R | PF_X
  elf_u64(output, 0)
  elf_u64(output, image_base)
  elf_u64(output, image_base)
  elf_u64(output, file_size)
  elf_u64(output, file_size)
  elf_u64(output, elf_aarch64_segment_alignment())
}

fn elf_emit_zero_fill_program_header(output: Vector<u8>, file_offset: i64, memory_size: i64) -> i64 {
  let address = elf_aarch64_image_base() + file_offset
  elf_u32(output, 1) -- PT_LOAD
  elf_u32(output, 6) -- PF_R | PF_W
  elf_u64(output, file_offset)
  elf_u64(output, address)
  elf_u64(output, address)
  elf_u64(output, 0) -- pure zero-fill; no segment bytes
  elf_u64(output, memory_size)
  elf_u64(output, elf_aarch64_segment_alignment())
}

fn elf_emit_data_program_header(output: Vector<u8>, file_offset: i64, file_size: i64, memory_size: i64) -> i64 {
  let address = elf_aarch64_image_base() + file_offset
  elf_u32(output, 1) -- PT_LOAD
  elf_u32(output, 6) -- PF_R | PF_W
  elf_u64(output, file_offset)
  elf_u64(output, address)
  elf_u64(output, address)
  elf_u64(output, file_size)
  elf_u64(output, memory_size)
  elf_u64(output, elf_aarch64_segment_alignment())
}

fn elf_emit_non_executable_stack_program_header(output: Vector<u8>) -> i64 {
  elf_u32(output, 1685382481) -- PT_GNU_STACK
  elf_u32(output, 6) -- PF_R | PF_W, deliberately no PF_X
  elf_u64(output, 0)
  elf_u64(output, 0)
  elf_u64(output, 0)
  elf_u64(output, 0)
  elf_u64(output, 0)
  elf_u64(output, 16)
}

fn elf_append_bytes(output: Vector<u8>, values: Bytes) -> i64 {
  for index in 0..values.len() {
    match values.get(index) {
      Some(value) -> vector_push<u8>(output, value)
      None -> 0
    }
  }
  0
}

fn elf_emit_section_header(output: Vector<u8>, name: i64, kind: i64, offset: i64, size: i64, alignment: i64) -> i64 {
  elf_u32(output, name)
  elf_u32(output, kind)
  elf_u64(output, 0) -- non-allocated debug/string section
  elf_u64(output, 0)
  elf_u64(output, offset)
  elf_u64(output, size)
  elf_u32(output, 0)
  elf_u32(output, 0)
  elf_u64(output, alignment)
  elf_u64(output, 0)
}

fn elf_emit_debug_section_names(output: Vector<u8>) -> i64 {
  elf_u8(output, 0)
  elf_append_bytes(output, bytes.from_str(".debug_abbrev"))
  elf_u8(output, 0)
  elf_append_bytes(output, bytes.from_str(".debug_info"))
  elf_u8(output, 0)
  elf_append_bytes(output, bytes.from_str(".debug_line"))
  elf_u8(output, 0)
  elf_append_bytes(output, bytes.from_str(".shstrtab"))
  elf_u8(output, 0)
}

pub(package) fn emit_elf_aarch64_standalone_executable_with_data_and_dwarf(
  code: Bytes,
  entry_offset: i64,
  data: Bytes,
  data_memory_size: i64,
  debug_abbrev: Bytes,
  debug_info: Bytes,
  debug_line: Bytes
) -> ElfExecutableEmission {
  let code_size = code.len()
  if entry_offset < 0 or entry_offset >= code_size {
    ElfExecutableInvalidEntryOffset(entry_offset, code_size)
  } else {
    let code_file_offset = elf_aarch64_code_file_offset()
    let code_file_size = code_file_offset + code_size
    let data_offset = elf_aarch64_zero_fill_file_offset(code_size)
    let data_size = data.len()
    let memory_size = if data_memory_size > data_size { data_memory_size } else { data_size }
    let loaded_file_size = if memory_size > 0 { data_offset + data_size } else { code_file_size }
    let abbrev_offset = loaded_file_size
    let info_offset = abbrev_offset + debug_abbrev.len()
    let line_offset = info_offset + debug_info.len()
    let names_offset = line_offset + debug_line.len()
    let names_size = 49
    let section_headers_offset = elf_align(names_offset + names_size, 8)
    let file_size = section_headers_offset + 5 * 64
    let output = vector.with_capacity<u8>(file_size)
    elf_emit_ident(output)
    elf_u16(output, 2)
    elf_u16(output, 183)
    elf_u32(output, 1)
    elf_u64(output, elf_aarch64_image_base() + code_file_offset + entry_offset)
    elf_u64(output, 64)
    elf_u64(output, section_headers_offset)
    elf_u32(output, 0)
    elf_u16(output, 64)
    elf_u16(output, 56)
    elf_u16(output, if memory_size > 0 { 3 } else { 2 })
    elf_u16(output, 64)
    elf_u16(output, 5)
    elf_u16(output, 4)
    elf_emit_load_program_header(output, code_file_size)
    if memory_size > 0 {
      if data_size > 0 { elf_emit_data_program_header(output, data_offset, data_size, memory_size) }
      else { elf_emit_zero_fill_program_header(output, data_offset, memory_size) }
    } else { 0 }
    elf_emit_non_executable_stack_program_header(output)
    while vector_len<u8>(output) < code_file_offset { elf_u8(output, 0) }
    elf_append_bytes(output, code)
    while vector_len<u8>(output) < data_offset and memory_size > 0 { elf_u8(output, 0) }
    elf_append_bytes(output, data)
    elf_append_bytes(output, debug_abbrev)
    elf_append_bytes(output, debug_info)
    elf_append_bytes(output, debug_line)
    elf_emit_debug_section_names(output)
    while vector_len<u8>(output) < section_headers_offset { elf_u8(output, 0) }
    elf_emit_section_header(output, 0, 0, 0, 0, 0)
    elf_emit_section_header(output, 1, 1, abbrev_offset, debug_abbrev.len(), 1)
    elf_emit_section_header(output, 15, 1, info_offset, debug_info.len(), 1)
    elf_emit_section_header(output, 27, 1, line_offset, debug_line.len(), 1)
    elf_emit_section_header(output, 39, 3, names_offset, names_size, 1)
    ElfExecutableEmitted(bytes.from_vector(output))
  }
}

pub(package) fn emit_elf_aarch64_standalone_executable_with_zero_fill_and_dwarf(
  code: Bytes,
  entry_offset: i64,
  zero_fill_size: i64,
  debug_abbrev: Bytes,
  debug_info: Bytes,
  debug_line: Bytes
) -> ElfExecutableEmission {
  let code_size = code.len()
  if entry_offset < 0 or entry_offset >= code_size {
    ElfExecutableInvalidEntryOffset(entry_offset, code_size)
  } else {
    let code_file_offset = elf_aarch64_code_file_offset()
    let code_file_size = code_file_offset + code_size
    let zero_fill_offset = elf_aarch64_zero_fill_file_offset(code_size)
    let loaded_file_size = if zero_fill_size > 0 { zero_fill_offset } else { code_file_size }
    let abbrev_offset = loaded_file_size
    let info_offset = abbrev_offset + debug_abbrev.len()
    let line_offset = info_offset + debug_info.len()
    let names_offset = line_offset + debug_line.len()
    let names_size = 49
    let section_headers_offset = elf_align(names_offset + names_size, 8)
    let file_size = section_headers_offset + 5 * 64
    let output = vector.with_capacity<u8>(file_size)
    elf_emit_ident(output)
    elf_u16(output, 2) -- ET_EXEC
    elf_u16(output, 183) -- EM_AARCH64
    elf_u32(output, 1) -- EV_CURRENT
    elf_u64(output, elf_aarch64_image_base() + code_file_offset + entry_offset)
    elf_u64(output, 64)
    elf_u64(output, section_headers_offset)
    elf_u32(output, 0)
    elf_u16(output, 64)
    elf_u16(output, 56)
    elf_u16(output, if zero_fill_size > 0 { 3 } else { 2 })
    elf_u16(output, 64)
    elf_u16(output, 5)
    elf_u16(output, 4)
    elf_emit_load_program_header(output, loaded_file_size)
    if zero_fill_size > 0 { elf_emit_zero_fill_program_header(output, zero_fill_offset, zero_fill_size) } else { 0 }
    elf_emit_non_executable_stack_program_header(output)
    while vector_len<u8>(output) < code_file_offset { elf_u8(output, 0) }
    elf_append_bytes(output, code)
    while vector_len<u8>(output) < loaded_file_size { elf_u8(output, 0) }
    elf_append_bytes(output, debug_abbrev)
    elf_append_bytes(output, debug_info)
    elf_append_bytes(output, debug_line)
    elf_emit_debug_section_names(output)
    while vector_len<u8>(output) < section_headers_offset { elf_u8(output, 0) }
    elf_emit_section_header(output, 0, 0, 0, 0, 0)
    elf_emit_section_header(output, 1, 1, abbrev_offset, debug_abbrev.len(), 1)
    elf_emit_section_header(output, 15, 1, info_offset, debug_info.len(), 1)
    elf_emit_section_header(output, 27, 1, line_offset, debug_line.len(), 1)
    elf_emit_section_header(output, 39, 3, names_offset, names_size, 1)
    ElfExecutableEmitted(bytes.from_vector(output))
  }
}

pub(package) fn emit_elf_aarch64_standalone_executable_with_data(code: Bytes, entry_offset: i64, data: Bytes, data_memory_size: i64) -> ElfExecutableEmission {
  let code_size = code.len()
  if entry_offset < 0 or entry_offset >= code_size {
    ElfExecutableInvalidEntryOffset(entry_offset, code_size)
  } else {
    let code_file_offset = elf_aarch64_code_file_offset()
    let code_file_size = code_file_offset + code_size
    let data_offset = elf_aarch64_zero_fill_file_offset(code_size)
    let data_size = data.len()
    let memory_size = if data_memory_size > data_size { data_memory_size } else { data_size }
    let file_size = if memory_size > 0 { data_offset + data_size } else { code_file_size }
    let output = vector.with_capacity<u8>(file_size)
    elf_emit_ident(output)
    elf_u16(output, 2)
    elf_u16(output, 183)
    elf_u32(output, 1)
    elf_u64(output, elf_aarch64_image_base() + code_file_offset + entry_offset)
    elf_u64(output, 64)
    elf_u64(output, 0)
    elf_u32(output, 0)
    elf_u16(output, 64)
    elf_u16(output, 56)
    elf_u16(output, if memory_size > 0 { 3 } else { 2 })
    elf_u16(output, 0)
    elf_u16(output, 0)
    elf_u16(output, 0)
    elf_emit_load_program_header(output, code_file_size)
    if memory_size > 0 {
      if data_size > 0 { elf_emit_data_program_header(output, data_offset, data_size, memory_size) }
      else { elf_emit_zero_fill_program_header(output, data_offset, memory_size) }
    } else { 0 }
    elf_emit_non_executable_stack_program_header(output)
    while vector_len<u8>(output) < code_file_offset { elf_u8(output, 0) }
    elf_append_bytes(output, code)
    while vector_len<u8>(output) < data_offset and memory_size > 0 { elf_u8(output, 0) }
    elf_append_bytes(output, data)
    ElfExecutableEmitted(bytes.from_vector(output))
  }
}

pub(package) fn emit_elf_aarch64_standalone_executable_with_zero_fill(code: Bytes, entry_offset: i64, zero_fill_size: i64) -> ElfExecutableEmission {
  let code_size = code.len()
  if entry_offset < 0 or entry_offset >= code_size {
    ElfExecutableInvalidEntryOffset(entry_offset, code_size)
  } else {
    let code_file_offset = elf_aarch64_code_file_offset()
    let code_file_size = code_file_offset + code_size
    let zero_fill_offset = elf_aarch64_zero_fill_file_offset(code_size)
    let file_size = if zero_fill_size > 0 { zero_fill_offset } else { code_file_size }
    let output = vector.with_capacity<u8>(file_size)
    elf_emit_ident(output)
    elf_u16(output, 2) -- ET_EXEC
    elf_u16(output, 183) -- EM_AARCH64
    elf_u32(output, 1) -- EV_CURRENT
    elf_u64(output, elf_aarch64_image_base() + code_file_offset + entry_offset)
    elf_u64(output, 64) -- program-header table offset
    elf_u64(output, 0) -- no section-header table in the standalone leaf
    elf_u32(output, 0) -- AArch64 processor flags
    elf_u16(output, 64) -- ELF header size
    elf_u16(output, 56) -- program-header entry size
    elf_u16(output, if zero_fill_size > 0 { 3 } else { 2 })
    elf_u16(output, 0)
    elf_u16(output, 0)
    elf_u16(output, 0)
    elf_emit_load_program_header(output, code_file_size)
    if zero_fill_size > 0 { elf_emit_zero_fill_program_header(output, zero_fill_offset, zero_fill_size) } else { 0 }
    elf_emit_non_executable_stack_program_header(output)
    while vector_len<u8>(output) < code_file_offset { elf_u8(output, 0) }
    for index in 0..code_size {
      match code.get(index) {
        Some(value) -> vector_push<u8>(output, value)
        None -> 0
      }
    }
    while vector_len<u8>(output) < file_size { elf_u8(output, 0) }
    ElfExecutableEmitted(bytes.from_vector(output))
  }
}

pub(package) fn emit_elf_aarch64_standalone_executable(code: Bytes, entry_offset: i64) -> ElfExecutableEmission {
  emit_elf_aarch64_standalone_executable_with_zero_fill(code, entry_offset, 0)
}
