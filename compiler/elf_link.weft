-- compiler/elf_link.weft -- shared LinkGraph to Linux ELF finalization
--
-- The strict ELF container remains pure over immutable Bytes. This bridge
-- copies only the compiler-owned generated-code buffer into that value model,
-- then rejects every graph feature whose Linux policy is not implemented yet.
-- ELF static archives are already resolved into the shared graph; dynamic
-- inputs, symbols, archive data, and unimplemented relocations remain typed
-- failures. Compiler-owned zero-fill static slots become a separate RW load
-- segment.

use compiler/elf.{*}
use compiler/dwarf.{*}
use compiler/lib.{bytes_u8_at}
use compiler/native_link.{*}
use compiler/native_target.{*}
use runtime/buffer.{bscopy, buf_len, buf_new, buf_ptr}
use stdlib/bytes.{*}
use stdlib/list.{Cons, List, Nil, list_len}
use stdlib/num.{num_i64_to_u8_checked, num_int_cast_value_or}
use stdlib/vector.{*}

pub(package) type ElfNativeLinkEmission {
  ElfNativeLinkEmitted(Bytes),
  ElfNativeLinkTargetMismatch(NativeLinkTarget),
  ElfNativeLinkForeignInputsUnsupported(i64),
  ElfNativeLinkDynamicSymbolsUnsupported(i64),
  ElfNativeLinkRelocationsUnsupported(i64),
  ElfNativeLinkArchiveDataUnsupported(i64),
  ElfNativeLinkInvalidEntryOffset(i64, i64)
}

fn elf_link_buffer_bytes(buffer: i64) -> Bytes {
  let len = buf_len(buffer)
  let output = vector_with_capacity<u8>(len)
  for index in 0..len {
    vector_push<u8>(output, num_int_cast_value_or<u8>(num_i64_to_u8_checked(bytes_u8_at(buf_ptr(buffer), len, index, 0)), 0))
  }
  bytes_from_vector(output)
}

fn elf_link_executable_emission(emission: ElfExecutableEmission) -> ElfNativeLinkEmission {
  match emission {
    ElfExecutableEmitted(image) -> ElfNativeLinkEmitted(image)
    ElfExecutableInvalidEntryOffset(offset, emitted_code_size) -> ElfNativeLinkInvalidEntryOffset(offset, emitted_code_size)
  }
}

fn elf_link_unsupported_relocation_count(relocations: List<NativeLinkRelocation>) -> i64 {
  match relocations {
    Nil -> 0
    Cons(relocation, rest) -> {
      let unsupported = match relocation {
        NativeLinkDirectBranch26(address, target) -> 0
        NativeLinkPageAddress(address, NativeLinkCodeAddress(offset)) -> 0
        NativeLinkPageAddress(address, NativeLinkStaticAddress(offset)) -> 0
        _ -> 1
      }
      unsupported + elf_link_unsupported_relocation_count(rest)
    }
  }
}

fn elf_link_unsupported_library_count(libraries: List<NativeLinkLibrary>) -> i64 {
  match libraries {
    Nil -> 0
    Cons(library, rest) -> {
      let unsupported = match library {
        NativeLinkStaticArchive(name, path, content, license, bytes, len) -> 0
        _ -> 1
      }
      unsupported + elf_link_unsupported_library_count(rest)
    }
  }
}

pub(package) fn emit_native_link_elf(graph: NativeLinkGraph) -> ElfNativeLinkEmission {
  match graph {
    NativeLinkGraph(target, platform, debug_information, signing, trust_grants, code, archive_data, layout, libraries, placements, symbols, relocations, static_slots) -> {
      let unsupported_library_count = elf_link_unsupported_library_count(libraries)
      let symbol_count = list_len<NativeLinkSymbol>(symbols)
      let unsupported_relocation_count = elf_link_unsupported_relocation_count(relocations)
      match target {
        NativeLinkMacosAarch64 -> ElfNativeLinkTargetMismatch(target)
        NativeLinkLinuxAarch64 -> {
          if unsupported_library_count != 0 {
            ElfNativeLinkForeignInputsUnsupported(unsupported_library_count)
          } else { if symbol_count != 0 {
            ElfNativeLinkDynamicSymbolsUnsupported(symbol_count)
          } else { if unsupported_relocation_count != 0 {
            ElfNativeLinkRelocationsUnsupported(unsupported_relocation_count)
          } else { if buf_len(archive_data) != 0 {
            ElfNativeLinkArchiveDataUnsupported(buf_len(archive_data))
          } else {
            let linked_code = buf_new(buf_len(code))
            bscopy(linked_code, buf_ptr(code), buf_len(code), 0)
            match layout {
              NativeLinkImageLayout(stub_base, code_size, text_size, static_offset, static_size, archive_offset, archive_size, archive_align, data_size) -> {
                let code_base = elf_aarch64_code_file_offset()
                let data_base = elf_aarch64_zero_fill_file_offset(buf_len(code))
                native_link_apply_relocations_at(linked_code, relocations, code_base, data_base, stub_base, static_offset, archive_offset)
                let zero_fill_size = if static_slots > 0 { static_offset + static_size } else { 0 }
                let linked_bytes = elf_link_buffer_bytes(linked_code)
                match debug_information {
                  NativeLinkDebugInformationAbsent -> elf_link_executable_emission(
                    emit_elf_aarch64_standalone_executable_with_zero_fill(linked_bytes, 0, zero_fill_size)
                  )
                  NativeLinkDwarfFunctionLineInformation(functions) -> {
                    let dwarf = native_dwarf_sections(
                      debug_information,
                      elf_aarch64_image_base() + elf_aarch64_code_file_offset()
                    )
                    elf_link_executable_emission(emit_elf_aarch64_standalone_executable_with_zero_fill_and_dwarf(
                      linked_bytes,
                      0,
                      zero_fill_size,
                      elf_link_buffer_bytes(native_dwarf_abbrev(dwarf)),
                      elf_link_buffer_bytes(native_dwarf_info(dwarf)),
                      elf_link_buffer_bytes(native_dwarf_line(dwarf))
                    ))
                  }
                }
              }
            }
          } } } }
        }
      }
    }
  }
}
