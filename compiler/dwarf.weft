-- compiler/dwarf.weft -- minimal honest native debug information
--
-- This is a pure interpretation of the shared final-layout provenance facts.
-- It emits DWARF v4 compile-unit, subprogram and line-table data only: names,
-- source files/lines, exact code ranges and frame-base shape. Variable
-- locations are deliberately absent until the optimizer can provide them as
-- stable facts.

use compiler/native_link.{*}
use runtime/buffer.{*}
use stdlib/list.{*}
use stdlib/string.{str_eq}

pub(package) type NativeDwarfSections {
  NativeDwarfSections(i64, i64, i64)
}

pub(package) fn native_dwarf_abbrev(sections: NativeDwarfSections) -> i64 {
  match sections { NativeDwarfSections(abbrev, info, line) -> abbrev }
}

pub(package) fn native_dwarf_info(sections: NativeDwarfSections) -> i64 {
  match sections { NativeDwarfSections(abbrev, info, line) -> info }
}

pub(package) fn native_dwarf_line(sections: NativeDwarfSections) -> i64 {
  match sections { NativeDwarfSections(abbrev, info, line) -> line }
}

pub(package) fn native_dwarf_u16(output: i64, value: i64) -> i64 {
  bu8(output, value band 255)
  bu8(output, value bshr 8 band 255)
}

pub(package) fn native_dwarf_uleb(output: i64, value: i64) -> i64 {
  let mut remaining = value
  let mut done = false
  while done == false {
    let byte = remaining band 127
    remaining = remaining bshr 7
    if remaining == 0 {
      bu8(output, byte)
      done = true
    } else { bu8(output, byte + 128) }
  }
  0
}

pub(package) fn native_dwarf_sleb_positive(output: i64, value: i64) -> i64 {
  let mut remaining = value
  let mut done = false
  while done == false {
    let byte = remaining band 127
    remaining = remaining bshr 7
    if remaining == 0 and byte band 64 == 0 {
      bu8(output, byte)
      done = true
    } else { bu8(output, byte + 128) }
  }
  0
}

pub(package) fn native_dwarf_cstring(output: i64, value: str) -> i64 {
  bstr(output, value)
  bu8(output, 0)
}

pub(package) fn native_dwarf_file_index(files: List<str>, wanted: str, index: i64) -> i64 {
  match files {
    Nil -> 0
    Cons(file, rest) -> {
      if str_eq(file, wanted) == 1 { index }
      else { native_dwarf_file_index(rest, wanted, index + 1) }
    }
  }
}

pub(package) fn native_dwarf_collect_files(functions: List<NativeLinkDebugFunction>) -> List<str> {
  let mut files = list_nil<str>()
  let mut current = functions
  let mut done = false
  while done == false {
    match current {
      Nil -> { done = true 0 }
      Cons(function, rest) -> match function {
        NativeLinkDebugFunction(start, end, name, file, line, col, framed) -> {
          if native_dwarf_file_index(files, file, 1) == 0 {
            files = list_append<str>(files, file)
          } else { 0 }
          current = rest
          0
        }
      }
    }
  }
  files
}

pub(package) fn native_dwarf_low_pc(functions: List<NativeLinkDebugFunction>) -> i64 {
  match functions {
    Nil -> 0
    Cons(NativeLinkDebugFunction(start, end, name, file, line, col, framed), rest) -> {
      let mut low = start
      let mut current = rest
      let mut done = false
      while done == false {
        match current {
          Nil -> { done = true 0 }
          Cons(NativeLinkDebugFunction(next_start, next_end, next_name, next_file, next_line, next_col, next_framed), next_rest) -> {
            if next_start < low { low = next_start } else { 0 }
            current = next_rest
            0
          }
        }
      }
      low
    }
  }
}

pub(package) fn native_dwarf_high_pc(functions: List<NativeLinkDebugFunction>) -> i64 {
  let mut high = 0
  let mut current = functions
  let mut done = false
  while done == false {
    match current {
      Nil -> { done = true 0 }
      Cons(NativeLinkDebugFunction(start, end, name, file, line, col, framed), rest) -> {
        if end > high { high = end } else { 0 }
        current = rest
        0
      }
    }
  }
  high
}

pub(package) fn native_dwarf_emit_abbrev() -> i64 {
  let output = buf_new(96)
  -- Abbrev 1: one compile unit with child subprograms.
  native_dwarf_uleb(output, 1)
  native_dwarf_uleb(output, 17) -- DW_TAG_compile_unit
  bu8(output, 1)
  native_dwarf_uleb(output, 37) native_dwarf_uleb(output, 8)  -- producer/string
  native_dwarf_uleb(output, 19) native_dwarf_uleb(output, 5)  -- language/data2
  native_dwarf_uleb(output, 3) native_dwarf_uleb(output, 8)   -- name/string
  native_dwarf_uleb(output, 16) native_dwarf_uleb(output, 23) -- stmt_list/sec_offset
  native_dwarf_uleb(output, 17) native_dwarf_uleb(output, 1)  -- low_pc/addr
  native_dwarf_uleb(output, 18) native_dwarf_uleb(output, 7)  -- high_pc/data8
  native_dwarf_uleb(output, 27) native_dwarf_uleb(output, 8)  -- comp_dir/string
  native_dwarf_uleb(output, 0) native_dwarf_uleb(output, 0)
  -- Abbrev 2: a source-named function with exact final range.
  native_dwarf_uleb(output, 2)
  native_dwarf_uleb(output, 46) -- DW_TAG_subprogram
  bu8(output, 0)
  native_dwarf_uleb(output, 3) native_dwarf_uleb(output, 8)   -- name/string
  native_dwarf_uleb(output, 58) native_dwarf_uleb(output, 6)  -- decl_file/data4
  native_dwarf_uleb(output, 59) native_dwarf_uleb(output, 6)  -- decl_line/data4
  native_dwarf_uleb(output, 57) native_dwarf_uleb(output, 6)  -- decl_column/data4
  native_dwarf_uleb(output, 17) native_dwarf_uleb(output, 1)  -- low_pc/addr
  native_dwarf_uleb(output, 18) native_dwarf_uleb(output, 7)  -- high_pc/data8
  native_dwarf_uleb(output, 64) native_dwarf_uleb(output, 24) -- frame_base/exprloc
  native_dwarf_uleb(output, 63) native_dwarf_uleb(output, 25) -- external/flag_present
  native_dwarf_uleb(output, 0) native_dwarf_uleb(output, 0)
  native_dwarf_uleb(output, 0)
  output
}

pub(package) fn native_dwarf_emit_info(functions: List<NativeLinkDebugFunction>, files: List<str>, code_base: i64) -> i64 {
  let body = buf_new(1024)
  let low = native_dwarf_low_pc(functions)
  let high = native_dwarf_high_pc(functions)
  let unit_name = match files {
    Nil -> "weft package"
    Cons(file, rest) -> file
  }
  native_dwarf_uleb(body, 1)
  native_dwarf_cstring(body, "Weft")
  native_dwarf_u16(body, 32768) -- DW_LANG_lo_user: Weft's provisional code.
  native_dwarf_cstring(body, unit_name)
  bu32(body, 0)
  bu64(body, code_base + low)
  bu64(body, high - low)
  native_dwarf_cstring(body, ".")
  let mut current = functions
  let mut done = false
  while done == false {
    match current {
      Nil -> { done = true 0 }
      Cons(NativeLinkDebugFunction(start, end, name, file, line, col, framed), rest) -> {
        native_dwarf_uleb(body, 2)
        native_dwarf_cstring(body, name)
        bu32(body, native_dwarf_file_index(files, file, 1))
        bu32(body, line)
        bu32(body, col)
        bu64(body, code_base + start)
        bu64(body, end - start)
        native_dwarf_uleb(body, 1)
        bu8(body, if framed { 109 } else { 111 }) -- DW_OP_reg29 / DW_OP_reg31
        current = rest
        0
      }
    }
  }
  native_dwarf_uleb(body, 0)
  let output = buf_new(buf_len(body) + 16)
  bu32(output, 2 + 4 + 1 + buf_len(body))
  native_dwarf_u16(output, 4)
  bu32(output, 0)
  bu8(output, 8)
  bscopy(output, buf_ptr(body), buf_len(body), 0)
  output
}

pub(package) fn native_dwarf_emit_line_header(files: List<str>) -> i64 {
  let header = buf_new(256)
  bu8(header, 1) -- minimum_instruction_length
  bu8(header, 1) -- maximum_operations_per_instruction
  bu8(header, 1) -- default_is_stmt
  bu8(header, 251) -- line_base = -5
  bu8(header, 14) -- line_range
  bu8(header, 13) -- opcode_base
  -- Standard-opcode argument counts for opcodes 1..12.
  bu8(header, 0) bu8(header, 1) bu8(header, 1) bu8(header, 1)
  bu8(header, 1) bu8(header, 0) bu8(header, 0) bu8(header, 0)
  bu8(header, 1) bu8(header, 0) bu8(header, 0) bu8(header, 1)
  bu8(header, 0) -- no include directories
  let mut current = files
  let mut done = false
  while done == false {
    match current {
      Nil -> { done = true 0 }
      Cons(file, rest) -> {
        native_dwarf_cstring(header, file)
        native_dwarf_uleb(header, 0)
        native_dwarf_uleb(header, 0)
        native_dwarf_uleb(header, 0)
        current = rest
        0
      }
    }
  }
  bu8(header, 0)
  header
}

pub(package) fn native_dwarf_emit_line_program(functions: List<NativeLinkDebugFunction>, files: List<str>, code_base: i64) -> i64 {
  let program = buf_new(1024)
  let mut current = functions
  let mut done = false
  while done == false {
    match current {
      Nil -> { done = true 0 }
      Cons(NativeLinkDebugFunction(start, end, name, file, line, col, framed), rest) -> {
        bu8(program, 0)
        native_dwarf_uleb(program, 9)
        bu8(program, 2) -- DW_LNE_set_address
        bu64(program, code_base + start)
        bu8(program, 4) -- DW_LNS_set_file
        native_dwarf_uleb(program, native_dwarf_file_index(files, file, 1))
        if line > 1 {
          bu8(program, 3) -- DW_LNS_advance_line
          native_dwarf_sleb_positive(program, line - 1)
        } else { 0 }
        if col > 0 {
          bu8(program, 5) -- DW_LNS_set_column
          native_dwarf_uleb(program, col)
        } else { 0 }
        bu8(program, 1) -- DW_LNS_copy
        bu8(program, 2) -- DW_LNS_advance_pc
        native_dwarf_uleb(program, end - start)
        bu8(program, 0)
        native_dwarf_uleb(program, 1)
        bu8(program, 1) -- DW_LNE_end_sequence
        current = rest
        0
      }
    }
  }
  program
}

pub(package) fn native_dwarf_emit_line(functions: List<NativeLinkDebugFunction>, files: List<str>, code_base: i64) -> i64 {
  let header = native_dwarf_emit_line_header(files)
  let program = native_dwarf_emit_line_program(functions, files, code_base)
  let output = buf_new(buf_len(header) + buf_len(program) + 16)
  bu32(output, 2 + 4 + buf_len(header) + buf_len(program))
  native_dwarf_u16(output, 4)
  bu32(output, buf_len(header))
  bscopy(output, buf_ptr(header), buf_len(header), 0)
  bscopy(output, buf_ptr(program), buf_len(program), 0)
  output
}

pub(package) fn native_dwarf_sections(debug_information: NativeLinkDebugInformation, code_base: i64) -> NativeDwarfSections {
  match debug_information {
    NativeLinkDebugInformationAbsent -> NativeDwarfSections(buf_new(0), buf_new(0), buf_new(0))
    NativeLinkDwarfFunctionLineInformation(functions) -> {
      if list_len<NativeLinkDebugFunction>(functions) == 0 {
        NativeDwarfSections(buf_new(0), buf_new(0), buf_new(0))
      } else {
        let files = native_dwarf_collect_files(functions)
        NativeDwarfSections(
          native_dwarf_emit_abbrev(),
          native_dwarf_emit_info(functions, files, code_base),
          native_dwarf_emit_line(functions, files, code_base)
        )
      }
    }
  }
}
