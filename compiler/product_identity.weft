-- compiler/product_identity.weft -- public compiler and schema identity
--
-- Release tooling, manifest/lock validation and emitted artifact facts consume
-- this typed value. Keeping the numbers here makes `weft --version` an
-- inspection of the compiler's actual compatibility policy rather than a
-- separately maintained banner.

use compiler/native_target.{NativeLinkTarget, native_link_supported_targets, native_link_target_name}
use stdlib/json.{Json, JsonEntry, json_array, json_entry, json_number, json_object, json_string, json_stringify}
use stdlib/list.{List, Nil, Cons, list_append, list_cons, list_nil}

pub(package) type WeftProductIdentity {
  WeftProductIdentity(str, str, i64, i64, i64, i64)
}

pub(package) fn weft_product_identity() -> WeftProductIdentity {
  WeftProductIdentity("0.1.0", "0.1", 1, 1, 1, 2)
}

pub(package) fn weft_compiler_version() -> str {
  match weft_product_identity() {
    WeftProductIdentity(compiler, language, manifest, lock, binding, facts) -> compiler
  }
}

pub(package) fn weft_language_version() -> str {
  match weft_product_identity() {
    WeftProductIdentity(compiler, language, manifest, lock, binding, facts) -> language
  }
}

pub(package) fn weft_manifest_schema_version() -> i64 {
  match weft_product_identity() {
    WeftProductIdentity(compiler, language, manifest, lock, binding, facts) -> manifest
  }
}

pub(package) fn weft_lock_schema_version() -> i64 {
  match weft_product_identity() {
    WeftProductIdentity(compiler, language, manifest, lock, binding, facts) -> lock
  }
}

pub(package) fn weft_native_binding_abi_version() -> i64 {
  match weft_product_identity() {
    WeftProductIdentity(compiler, language, manifest, lock, binding, facts) -> binding
  }
}

pub(package) fn weft_artifact_facts_schema_version() -> i64 {
  match weft_product_identity() {
    WeftProductIdentity(compiler, language, manifest, lock, binding, facts) -> facts
  }
}

pub(package) fn weft_product_target_names(targets: List<NativeLinkTarget>) -> List<Json> {
  match targets {
    Nil -> list_nil<Json>()
    Cons(target, rest) -> list_cons<Json>(
      json_string(native_link_target_name(target)),
      weft_product_target_names(rest)
    )
  }
}

pub(package) fn weft_product_identity_json(identity: WeftProductIdentity) -> Json {
  match identity {
    WeftProductIdentity(compiler, language, manifest, lock, binding, facts) -> {
      let mut fields = list_nil<JsonEntry>()
      fields = list_append<JsonEntry>(fields, json_entry("compiler_version", json_string(compiler)))
      fields = list_append<JsonEntry>(fields, json_entry("language_version", json_string(language)))
      fields = list_append<JsonEntry>(fields, json_entry("manifest_schema_version", json_number(manifest)))
      fields = list_append<JsonEntry>(fields, json_entry("lock_schema_version", json_number(lock)))
      fields = list_append<JsonEntry>(fields, json_entry("native_binding_abi_version", json_number(binding)))
      fields = list_append<JsonEntry>(fields, json_entry("artifact_facts_schema_version", json_number(facts)))
      fields = list_append<JsonEntry>(fields, json_entry("targets", json_array(weft_product_target_names(native_link_supported_targets()))))
      json_object(fields)
    }
  }
}

pub(package) fn weft_product_identity_json_render() -> str {
  json_stringify(weft_product_identity_json(weft_product_identity()))
}
