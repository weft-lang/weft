-- The native ABI shared by generated calls and runtime declarations.
-- This closed vocabulary reserves call identities, not source spellings.
-- The declaration producer additionally checks SDK origin and exact module.
use compiler/type_registry.{str_hash}
use stdlib/map as map
use stdlib/map.{Map}

pub(package) type RuntimeAbiEntry { name: str, module_path: str }

pub(package) fn runtime_abi_entries() -> Map<i64, RuntimeAbiEntry> {
  let mut entries = map.new<i64, RuntimeAbiEntry>()
  for name in [
    "alloc_bump",
    "alloc_words",
    "alloc_zeroed",
  ] {
    let key = str_hash(__str_ptr(name), 0, __str_len(name))
    entries = entries.insert(key, RuntimeAbiEntry { name: name, module_path: "runtime/alloc.weft" })
  }
  for name in [
    "closure_default_promote",
    "closure_default_release",
    "closure_default_release_promoted",
    "closure_default_retain",
    "continuation_resume_managed",
    "rc_array_storage_copy_for_mutation",
    "rc_array_storage_data",
    "rc_array_storage_new",
    "rc_array_storage_new_from_data",
    "rc_array_storage_prepare_mutation",
    "rc_deep_release_child",
    "rc_default_alloc",
    "rc_default_alloc_described",
    "rc_default_alloc_finalized",
    "rc_default_alloc_masked",
    "rc_default_alloc_masked_reuse",
    "rc_default_drop_reuse",
    "rc_default_promote",
    "rc_default_promote_maybe",
    "rc_default_release",
    "rc_default_release_promoted",
    "rc_default_retain",
    "rc_default_retain_promoted_slow",
    "rc_default_weak_load",
    "rc_default_weak_release",
    "rc_default_weak_retain",
    "rc_persistent_region_alloc",
    "rc_persistent_region_alloc_unlocked",
    "rc_persistent_region_new",
    "runtime_defer_abort_cleanup",
  ] {
    let key = str_hash(__str_ptr(name), 0, __str_len(name))
    entries = entries.insert(key, RuntimeAbiEntry { name: name, module_path: "runtime/rc.weft" })
  }
  for name in [
    "continuation_cleanup_desc_new",
    "continuation_cleanup_desc_set",
    "continuation_new_noop",
    "continuation_new_with_cleanup_desc",
    "continuation_set_segment",
    "fiber_is_done",
    "fiber_prompt_contains_sp",
    "fiber_prompt_enable_cleanup",
    "fiber_prompt_new",
    "fiber_resume",
    "fiber_segment_new",
    "fiber_suspend",
    "fiber_trampoline",
    "handler_find_entry",
  ] {
    let key = str_hash(__str_ptr(name), 0, __str_len(name))
    entries = entries.insert(key, RuntimeAbiEntry { name: name, module_path: "runtime/effects.weft" })
  }
  for name in [
    "map_storage_load_owned",
    "map_storage_retain_stored",
    "map_storage_retain_word",
  ] {
    let key = str_hash(__str_ptr(name), 0, __str_len(name))
    entries = entries.insert(key, RuntimeAbiEntry { name: name, module_path: "runtime/map_storage.weft" })
  }
  for name in [
    "mem_load64",
    "mem_load8",
    "mem_store64",
    "mem_store8",
  ] {
    let key = str_hash(__str_ptr(name), 0, __str_len(name))
    entries = entries.insert(key, RuntimeAbiEntry { name: name, module_path: "runtime/memory.weft" })
  }
  for name in [
    "vector_storage_load_value",
    "vector_storage_load_value_in_bounds",
    "vector_storage_store_value",
  ] {
    let key = str_hash(__str_ptr(name), 0, __str_len(name))
    entries = entries.insert(key, RuntimeAbiEntry { name: name, module_path: "runtime/vector_storage.weft" })
  }
  for name in [
    "rc_census_origin_aggregate_closure_release",
    "rc_census_origin_aggregate_closure_retain",
    "rc_census_origin_aggregate_rc_release",
    "rc_census_origin_aggregate_rc_retain",
    "rc_census_origin_aggregate_weak_release",
    "rc_census_origin_aggregate_weak_retain",
    "rc_census_origin_arm_normalization_closure_release",
    "rc_census_origin_arm_normalization_closure_retain",
    "rc_census_origin_arm_normalization_rc_release",
    "rc_census_origin_arm_normalization_rc_retain",
    "rc_census_origin_arm_normalization_weak_release",
    "rc_census_origin_arm_normalization_weak_retain",
    "rc_census_origin_binding_closure_release",
    "rc_census_origin_binding_closure_retain",
    "rc_census_origin_binding_rc_release",
    "rc_census_origin_binding_rc_retain",
    "rc_census_origin_binding_weak_release",
    "rc_census_origin_binding_weak_retain",
    "rc_census_origin_call_transport_closure_release",
    "rc_census_origin_call_transport_closure_retain",
    "rc_census_origin_call_transport_rc_release",
    "rc_census_origin_call_transport_rc_retain",
    "rc_census_origin_call_transport_weak_release",
    "rc_census_origin_call_transport_weak_retain",
    "rc_census_origin_cleanup_closure_release",
    "rc_census_origin_cleanup_closure_retain",
    "rc_census_origin_cleanup_rc_release",
    "rc_census_origin_cleanup_rc_retain",
    "rc_census_origin_cleanup_weak_release",
    "rc_census_origin_cleanup_weak_retain",
    "rc_census_origin_control_closure_release",
    "rc_census_origin_control_closure_retain",
    "rc_census_origin_control_rc_release",
    "rc_census_origin_control_rc_retain",
    "rc_census_origin_control_weak_release",
    "rc_census_origin_control_weak_retain",
    "rc_census_origin_discard_closure_release",
    "rc_census_origin_discard_closure_retain",
    "rc_census_origin_discard_rc_release",
    "rc_census_origin_discard_rc_retain",
    "rc_census_origin_discard_weak_release",
    "rc_census_origin_discard_weak_retain",
    "rc_census_origin_result_transfer_closure_release",
    "rc_census_origin_result_transfer_closure_retain",
    "rc_census_origin_result_transfer_rc_release",
    "rc_census_origin_result_transfer_rc_retain",
    "rc_census_origin_result_transfer_weak_release",
    "rc_census_origin_result_transfer_weak_retain",
    "rc_census_origin_unknown_closure_release",
    "rc_census_origin_unknown_closure_retain",
    "rc_census_origin_unknown_rc_release",
    "rc_census_origin_unknown_rc_retain",
    "rc_census_origin_unknown_weak_release",
    "rc_census_origin_unknown_weak_retain",
  ] {
    let key = str_hash(__str_ptr(name), 0, __str_len(name))
    entries = entries.insert(key, RuntimeAbiEntry { name: name, module_path: "runtime/rc_census_stakes.weft" })
  }
  for name in [
    "rc_census_report",
  ] {
    let key = str_hash(__str_ptr(name), 0, __str_len(name))
    entries = entries.insert(key, RuntimeAbiEntry { name: name, module_path: "runtime/rc_census.weft" })
  }
  for name in [
    "runtime_index_address",
    "runtime_index_address_full_proven",
    "runtime_index_address_lower_proven",
    "runtime_index_address_upper_proven",
    "runtime_mut_slice_address",
    "runtime_mut_slice_address_full_proven",
    "runtime_mut_slice_address_order_proven",
    "runtime_mut_slice_address_upper_proven",
    "runtime_slice_address",
    "runtime_slice_address_full_proven",
    "runtime_slice_address_order_proven",
    "runtime_slice_address_upper_proven",
    "runtime_trap",
  ] {
    let key = str_hash(__str_ptr(name), 0, __str_len(name))
    entries = entries.insert(key, RuntimeAbiEntry { name: name, module_path: "runtime/panic.weft" })
  }
  for name in [
    "runtime_par_task_scope_cleanup",
    "runtime_par_work_join",
    "runtime_par_work_new_raw",
    "runtime_par_work_pack",
    "runtime_par_work_result_move_to_expected",
    "runtime_par_work_result_publish",
    "runtime_par_work_result_store_lane",
    "runtime_par_work_scope_cleanup",
    "runtime_par_work_scope_new",
    "runtime_par_work_scope_track",
    "runtime_par_work_take",
  ] {
    let key = str_hash(__str_ptr(name), 0, __str_len(name))
    entries = entries.insert(key, RuntimeAbiEntry { name: name, module_path: "runtime/par_task.weft" })
  }
  for name in [
    "runtime_spawn_work_free_moved",
    "runtime_spawn_work_new_raw",
    "runtime_spawn_work_result_publish",
    "runtime_spawn_work_take",
  ] {
    let key = str_hash(__str_ptr(name), 0, __str_len(name))
    entries = entries.insert(key, RuntimeAbiEntry { name: name, module_path: "runtime/spawn_task.weft" })
  }
  for name in [
    "unsafe_transmute",
  ] {
    let key = str_hash(__str_ptr(name), 0, __str_len(name))
    entries = entries.insert(key, RuntimeAbiEntry { name: name, module_path: "runtime/unsafe.weft" })
  }
  entries
}
