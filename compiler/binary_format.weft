-- binary_format.weft — target binary format descriptors

pub(package) type BinaryFormat {
  MachOExecutable,
  MachOObject,
  ElfExecutable,
  ElfObject,
  UnsupportedBinaryFormat
}

pub(package) type BinaryFormatBackend {
  BinaryFormatBackendUnsupported,
  BinaryFormatBackendMachOExecutable,
  BinaryFormatBackendMachOObject
}

pub(package) fn binary_format_macho_executable() -> BinaryFormat { MachOExecutable }
pub(package) fn binary_format_macho_object() -> BinaryFormat { MachOObject }
pub(package) fn binary_format_elf_executable() -> BinaryFormat { ElfExecutable }
pub(package) fn binary_format_elf_object() -> BinaryFormat { ElfObject }
pub(package) fn binary_format_unsupported() -> BinaryFormat { UnsupportedBinaryFormat }

pub(package) fn binary_format_backend_unsupported() -> BinaryFormatBackend { BinaryFormatBackendUnsupported }
pub(package) fn binary_format_backend_macho_executable() -> BinaryFormatBackend { BinaryFormatBackendMachOExecutable }
pub(package) fn binary_format_backend_macho_object() -> BinaryFormatBackend { BinaryFormatBackendMachOObject }

pub(package) fn binary_format_backend_id(backend: BinaryFormatBackend) -> i64 {
  match backend {
    BinaryFormatBackendUnsupported -> 0
    BinaryFormatBackendMachOExecutable -> 1
    BinaryFormatBackendMachOObject -> 2
  }
}

pub(package) fn binary_format_is_supported(format: BinaryFormat) -> i64 {
  match format {
    MachOExecutable -> 1
    MachOObject -> 1
    ElfExecutable -> 0
    ElfObject -> 0
    UnsupportedBinaryFormat -> 0
  }
}

pub(package) fn binary_format_backend(format: BinaryFormat) -> BinaryFormatBackend {
  match format {
    MachOExecutable -> binary_format_backend_macho_executable()
    MachOObject -> binary_format_backend_macho_object()
    ElfExecutable -> binary_format_backend_unsupported()
    ElfObject -> binary_format_backend_unsupported()
    UnsupportedBinaryFormat -> binary_format_backend_unsupported()
  }
}

pub(package) fn binary_format_default_for_relocations(relocations: i64) -> BinaryFormat {
  if relocations > 0 {
    binary_format_macho_object()
  } else {
    binary_format_macho_executable()
  }
}

pub(package) fn binary_format_kind(format: BinaryFormat) -> i64 {
  match format {
    MachOExecutable -> 1
    MachOObject -> 2
    ElfExecutable -> 3
    ElfObject -> 4
    UnsupportedBinaryFormat -> 0
  }
}

pub(package) fn binary_format_name_len_or(format: BinaryFormat, default: i64) -> i64 {
  match format {
    MachOExecutable -> __str_len("macho-executable")
    MachOObject -> __str_len("macho-object")
    ElfExecutable -> __str_len("elf-executable")
    ElfObject -> __str_len("elf-object")
    UnsupportedBinaryFormat -> default
  }
}
