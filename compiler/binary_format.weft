-- binary_format.weft — target binary format descriptors

type BinaryFormat {
  MachOExecutable,
  MachOObject,
  UnsupportedBinaryFormat
}

fn binary_format_macho_executable() -> BinaryFormat { MachOExecutable }
fn binary_format_macho_object() -> BinaryFormat { MachOObject }
fn binary_format_unsupported() -> BinaryFormat { UnsupportedBinaryFormat }

fn binary_format_is_supported(format: BinaryFormat) -> i64 {
  match format {
    MachOExecutable -> 1
    MachOObject -> 1
    UnsupportedBinaryFormat -> 0
  }
}

fn binary_format_kind(format: BinaryFormat) -> i64 {
  match format {
    MachOExecutable -> 1
    MachOObject -> 2
    UnsupportedBinaryFormat -> 0
  }
}

fn binary_format_name_len_or(format: BinaryFormat, default: i64) -> i64 {
  match format {
    MachOExecutable -> __str_len("macho-executable")
    MachOObject -> __str_len("macho-object")
    UnsupportedBinaryFormat -> default
  }
}
