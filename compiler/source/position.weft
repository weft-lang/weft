-- compiler/source/position.weft -- shared UTF-8 source-position facts
--
-- Compiler spans stay byte offsets. This module is the one conversion
-- boundary for human scalar columns and protocol UTF-8/UTF-16/UTF-32 units.
-- Every algorithm reads its bytes through `SourceBytes`; malformed UTF-8 is
-- reported, never skipped.

use runtime/string.{runtime_str_utf8_decode}
use runtime/utf8.{Utf8StorageDecode, Utf8StorageMalformed, Utf8StorageScalar}
use stdlib/string.{str_byte_at, str_len}

--- Bytes a position is computed over. Source text implements it with
--- checked reads. Until the cutover, the legacy tables' raw views implement
--- it in compiler/storage, so one algorithm serves both without copying.
pub(package) trait SourceBytes {
  --- The number of bytes.
  fn byte_count(self) -> i64
  --- The byte at `index`, or 0 outside the bytes.
  fn byte(self, index: i64) -> i64
  --- The scalar starting at `index`, or why none does.
  fn scalar(self, index: i64) -> Utf8StorageDecode
}

impl SourceBytes for str {
  fn byte_count(self) -> i64 { str_len(self) }
  fn byte(self, index: i64) -> i64 { str_byte_at(self, index) }
  fn scalar(self, index: i64) -> Utf8StorageDecode { runtime_str_utf8_decode(self, index) }
}

pub type SourcePosition {
  SourcePositionKnown(i64, i64, i64, i64, i64),
  SourcePositionInvalid(i64)
}

--- The code units a column counts: UTF-8 bytes, UTF-16 code units or
--- Unicode scalars (UTF-32 code units).
pub(package) type SourcePositionEncoding {
  SourceUtf8Units,
  SourceUtf16Units,
  SourceUtf32Units
}

-- Return the strict UTF-8 sequence width at `pos`, or -1 for malformed input
-- or a position outside the bytes. Overlong encodings, surrogate code points
-- and scalars above U+10FFFF are malformed.
pub(package) fn source_position_utf8_width<S: SourceBytes>(bytes: S, pos: i64) -> i64 {
  match bytes.scalar(pos) {
    Utf8StorageScalar(next, scalar) -> next - pos
    Utf8StorageMalformed(offset) -> 0 - 1
  }
}

pub(package) fn source_position_utf8_scalar<S: SourceBytes>(bytes: S, pos: i64) -> i64 {
  match bytes.scalar(pos) {
    Utf8StorageScalar(next, scalar) -> scalar
    Utf8StorageMalformed(offset) -> 0 - 1
  }
}

pub(package) fn source_position_is_newline_at<S: SourceBytes>(bytes: S, pos: i64) -> i64 {
  if pos < 0 or pos >= bytes.byte_count() { 0 }
  else {
    let ch = bytes.byte(pos)
    if ch == 10 { 1 }
    else {
      if ch == 13 { if bytes.byte(pos + 1) == 10 { 2 } else { 1 } }
      else { 0 }
    }
  }
}

pub(package) fn source_position_at<S: SourceBytes>(bytes: S, byte_offset: i64) -> SourcePosition {
  let n = bytes.byte_count()
  let target = if byte_offset < 0 { 0 } else { if byte_offset > n { n } else { byte_offset } }
  let mut pos = 0
  let mut line = 0
  let mut byte_col = 0
  let mut scalar_col = 0
  let mut utf16_col = 0
  let mut invalid = 0 - 1
  while pos < target and invalid < 0 {
    let newline_width = source_position_is_newline_at(bytes, pos)
    if newline_width > 0 and pos + newline_width <= target {
      pos = pos + newline_width
      line = line + 1
      byte_col = 0
      scalar_col = 0
      utf16_col = 0
    } else {
      let width = source_position_utf8_width(bytes, pos)
      if width < 0 { invalid = pos }
      else {
        if pos + width > target {
          -- UTF-8 protocol cursors may address a byte inside a scalar. Preserve
          -- that byte column while scalar/UTF-16 columns stay at the preceding
          -- scalar boundary.
          byte_col = byte_col + target - pos
          pos = target
        } else {
          pos = pos + width
          byte_col = byte_col + width
          scalar_col = scalar_col + 1
          utf16_col = utf16_col + if width == 4 { 2 } else { 1 }
        }
      }
    }
  }
  if invalid >= 0 { SourcePositionInvalid(invalid) }
  else { SourcePositionKnown(target, line, byte_col, scalar_col, utf16_col) }
}

pub(package) fn source_position_is_valid(position: SourcePosition) -> i64 {
  match position {
    SourcePositionKnown(byte, line, byte_col, scalar_col, utf16_col) -> 1
    SourcePositionInvalid(at) -> 0
  }
}

pub(package) fn source_position_invalid_offset(position: SourcePosition) -> i64 {
  match position {
    SourcePositionKnown(byte, line, byte_col, scalar_col, utf16_col) -> 0 - 1
    SourcePositionInvalid(at) -> at
  }
}

pub(package) fn source_position_line0(position: SourcePosition) -> i64 {
  match position {
    SourcePositionKnown(byte, line, byte_col, scalar_col, utf16_col) -> line
    SourcePositionInvalid(at) -> 0 - 1
  }
}

pub(package) fn source_position_byte_column0(position: SourcePosition) -> i64 {
  match position {
    SourcePositionKnown(byte, line, byte_col, scalar_col, utf16_col) -> byte_col
    SourcePositionInvalid(at) -> 0 - 1
  }
}

pub(package) fn source_position_scalar_column0(position: SourcePosition) -> i64 {
  match position {
    SourcePositionKnown(byte, line, byte_col, scalar_col, utf16_col) -> scalar_col
    SourcePositionInvalid(at) -> 0 - 1
  }
}

pub(package) fn source_position_utf16_column0(position: SourcePosition) -> i64 {
  match position {
    SourcePositionKnown(byte, line, byte_col, scalar_col, utf16_col) -> utf16_col
    SourcePositionInvalid(at) -> 0 - 1
  }
}

pub(package) fn source_position_column0(
  position: SourcePosition,
  encoding: SourcePositionEncoding
) -> i64 {
  match encoding {
    SourceUtf8Units -> source_position_byte_column0(position)
    SourceUtf16Units -> source_position_utf16_column0(position)
    SourceUtf32Units -> source_position_scalar_column0(position)
  }
}

pub(package) fn source_position_unit_width(
  utf8_width: i64,
  encoding: SourcePositionEncoding
) -> i64 {
  match encoding {
    SourceUtf8Units -> utf8_width
    SourceUtf16Units -> if utf8_width == 4 { 2 } else { 1 }
    SourceUtf32Units -> 1
  }
}

pub(package) fn source_position_next_scalar_offset<S: SourceBytes>(
  bytes: S,
  byte_offset: i64
) -> i64 {
  let n = bytes.byte_count()
  let start = if byte_offset < 0 { 0 } else { if byte_offset > n { n } else { byte_offset } }
  if start >= n { n }
  else {
    let width = source_position_utf8_width(bytes, start)
    if width < 0 { start + 1 } else { start + width }
  }
}

-- Convert a zero-based protocol line/column back to a byte offset. Columns
-- beyond a line clamp to its end as required by LSP. A cursor inside a
-- multi-unit scalar clamps to that scalar's starting byte boundary.
pub(package) fn source_position_offset_for_line_column<S: SourceBytes>(
  bytes: S,
  target_line: i64,
  target_column: i64,
  encoding: SourcePositionEncoding
) -> i64 {
  let n = bytes.byte_count()
  let wanted_line = if target_line < 0 { 0 } else { target_line }
  let wanted_column = if target_column < 0 { 0 } else { target_column }
  let mut pos = 0
  let mut line = 0
  let mut invalid = 0
  while pos < n and line < wanted_line and invalid == 0 {
    let newline_width = source_position_is_newline_at(bytes, pos)
    if newline_width > 0 {
      pos = pos + newline_width
      line = line + 1
    } else {
      let width = source_position_utf8_width(bytes, pos)
      if width < 0 { invalid = 1 } else { pos = pos + width }
    }
  }
  if invalid == 1 { 0 - 1 }
  else {
    if line < wanted_line { n }
    else {
      let mut column = 0
      let mut done = 0
      while pos < n and done == 0 {
        let newline_width = source_position_is_newline_at(bytes, pos)
        if newline_width > 0 or column >= wanted_column { done = 1 }
        else {
          let width = source_position_utf8_width(bytes, pos)
          if width < 0 { invalid = 1 done = 1 }
          else {
            let units = source_position_unit_width(width, encoding)
            if column + units > wanted_column { done = 1 }
            else { column = column + units pos = pos + width }
          }
        }
      }
      if invalid == 1 { 0 - 1 } else { pos }
    }
  }
}
