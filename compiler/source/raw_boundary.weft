  let mut low: usize = 0
  let mut high: usize = paths.len
  while low < high {
    let middle = low + (high - low) / 2
    match paths[middle].compare(path) {
      Less -> { low = middle + 1 }
      Greater -> { high = middle }
      Equal -> return true
    }
  }
  false
}
