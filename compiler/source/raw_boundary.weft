-- compiler/source/raw_boundary.weft -- the raw-memory boundary of strict code
--
-- The trusted runtime ring is the only code that reaches raw memory through
-- untyped addresses. Every export of a trusted runtime module is raw to strict
-- code unless it belongs to that module's audited safe surface below: a safe
-- export takes and returns no raw address and establishes every invariant its
-- callers rely on. Strict code may bind any other export, or use the
-- __str_ptr/__str_len intrinsics, only while it is listed below. Trusted
-- modules bind anything.
--
-- The rule applies to each use, however it is named. A selected import
-- names each member it binds. A module alias binds no member itself, so each
-- qualified use through it is decided on its own, and so is each installation
-- of the module's handler implementation. A wildcard cannot select around raw
-- exports, so strict code may not take one from a ring module at all.
--
-- The list is transitional and only shrinks. A file leaves it when it stops
-- binding raw exports, and the stale-entry tool check rejects an entry that no
-- longer needs it. Re-exporting a raw export is refused even from a listed
-- file, so the list cannot be widened through a wrapper module. Adding a safe
-- export is a reviewed safety claim about that export. When no listed file
-- binds a raw export any more, honest `Unsafe` signatures replace this rule.

use stdlib/ord.{Equal, Greater, Less}
use stdlib/string
use stdlib/string.{str_concat, str_ends_with, str_len, str_slice_bytes, str_starts_with}

--- Whether a module may not bind a raw-memory import. A trusted module may
--- bind and re-export raw memory; a strict module on the transitional list may
--- only bind it privately; every other strict module may do neither.
pub(package) fn raw_boundary_import_refused(trusted: bool, path: str, reexported: bool) -> bool {
  if trusted { false } else if reexported { true } else { not raw_boundary_transitional(path) }
}

--- Whether a module belongs to the trusted runtime ring, whose exports are raw
--- to strict code unless audited safe. The ring is the trusted modules under
--- runtime/. Trusted native bindings elsewhere, including other packages',
--- answer to the native-binding surface rules instead: their raw handles are
--- typed pointers those rules can see. A trusted module another package places
--- under runtime/ is treated as ring code, which only over-refuses.
pub(package) fn raw_boundary_trusted_runtime(trusted: bool, path: str) -> bool {
  trusted and raw_boundary_ring_path(path)
}

--- Whether a module at this logical path can belong to the trusted runtime
--- ring. Only its trust decides whether it does.
pub(package) fn raw_boundary_ring_path(path: str) -> bool {
  str_starts_with(path, "runtime/") == 1
}

--- The logical module path of a source file path: relative, without any
--- leading `./`, and without one `.weft` suffix.
pub(package) fn raw_boundary_logical_path(file: str) -> str {
  let relative = raw_boundary_relative_path(file)
  if str_ends_with(relative, ".weft") == 1 {
    str_slice_bytes(relative, 0, str_len(relative) - 5)
  } else { relative }
}

fn raw_boundary_relative_path(file: str) -> str {
  if str_starts_with(file, "./") == 1 {
    raw_boundary_relative_path(str_slice_bytes(file, 2, str_len(file) - 2))
  } else { file }
}

-- Whether `key` is one of `values`, which are sorted.
fn sorted_contains(values: [str], key: str) -> bool {
  let mut low: usize = 0
  let mut high: usize = values.len
  while low < high {
    let middle = low + (high - low) / 2
    match values[middle].compare(key) {
      Less -> { low = middle + 1 }
      Greater -> { high = middle }
      Equal -> return true
    }
  }
  false
}

--- Whether strict code may install the handler implementation exported by the
--- trusted runtime module at this logical path. A safe handler takes no raw
--- address among its parameters and establishes every invariant its clauses
--- rely on, so installing it grants only the capability it interprets.
pub(package) fn raw_boundary_safe_handler(module: str) -> bool {
  let handlers = ["runtime/dns", "runtime/env", "runtime/process", "runtime/process_environment"]
  sorted_contains(handlers[..], module)
}

