-- compiler/source/raw_boundary.weft -- the raw-memory boundary of strict code
--
-- Raw memory is reachable only through the runtime's raw families:
-- runtime/memory, runtime/buffer and runtime/alloc, the address-taking and
-- storage-mutating members of runtime/string, and the __str_ptr/__str_len
-- intrinsics. Trusted runtime and platform leaves use them freely. Strict code
-- may reach them only while it is listed below.
--
-- The list is transitional and only shrinks. A file leaves it when it stops
-- reaching raw memory, and the stale-entry tool check rejects an entry that no
-- longer needs it. Re-exporting a raw member is refused even from a listed
-- file, so the list cannot be widened through a wrapper module. When no listed
-- file reaches a family any more, honest `Unsafe` signatures on that family
-- replace this rule.

use stdlib/ord.{Equal, Greater, Less}
use stdlib/string
use stdlib/string.{str_ends_with, str_len, str_slice_bytes, str_starts_with}

--- How a module's members relate to raw memory.
pub(package) type RawMemoryModule {
  --- Every member reaches raw memory.
  RawMemoryFamily,
  --- Only the named address-taking or storage-mutating members do; the
  --- module may be imported only by selecting other members.
  RawMemoryMembers,
  NotRawMemory
}

--- Classify a module by its logical path.
pub(package) fn raw_boundary_module(path: str) -> RawMemoryModule {
  if path == "runtime/memory" or path == "runtime/buffer" or path == "runtime/alloc" {
    RawMemoryFamily
  } else if path == "runtime/string" { RawMemoryMembers } else { NotRawMemory }
}

--- Whether a module may not bind a raw-memory import. A trusted module may
--- bind and re-export raw memory; a strict module on the transitional list may
--- only bind it privately; every other strict module may do neither.
pub(package) fn raw_boundary_import_refused(trusted: bool, path: str, reexported: bool) -> bool {
  if trusted { false } else if reexported { true } else { not raw_boundary_transitional(path) }
}

--- The logical module path of a source file path: relative, without any
--- leading `./`, and without one `.weft` suffix.
pub(package) fn raw_boundary_logical_path(file: str) -> str {
  let relative = raw_boundary_relative_path(file)
  if str_ends_with(relative, ".weft") == 1 {
    str_slice_bytes(relative, 0, str_len(relative) - 5)
  } else { relative }
}

fn raw_boundary_relative_path(file: str) -> str {
  if str_starts_with(file, "./") == 1 {
    raw_boundary_relative_path(str_slice_bytes(file, 2, str_len(file) - 2))
  } else { file }
}

--- Whether a member of runtime/string takes or returns a raw address, or
--- mutates string storage in place.
pub(package) fn raw_boundary_string_member(name: str) -> bool {
  let members = [
    "runtime_str_alloc_uninit",
    "runtime_str_builder_copy",
    "runtime_str_builder_set_byte",
    "runtime_str_cstring",
    "runtime_str_eq_at_bytes",
    "runtime_str_from_bytes",
    "runtime_str_from_bytes_copy",
    "runtime_str_promote",
    "runtime_str_ptr",
    "runtime_str_set_len",
    "runtime_str_storage_identity",
    "runtime_str_with_cstring_i64",
    "runtime_str_word_as_str"
  ]
  for member in members {
    if member == name { return true }
  }
  false
}

