-- Compiler-host source requests retain both resolver spelling and authority.
-- Acquisition is outside the public Grammar contract.

use stdlib/bytes.{Bytes, bytes_storage}
use stdlib/option.{None, Some}
use stdlib/source.{Source}
use stdlib/diagnostic/schema.{DiagnosticSourceBuffer}
use runtime/string.{runtime_str_from_bytes_copy, runtime_str_storage_identity}

-- The one place a source receives its identity. Identities name retained
-- text, never the transport buffer that happened to supply it. Until the
-- registry assigns ordinals, the identity is the text's storage identity,
-- which the private table uses to find the registered buffer.
pub(package) fn source_from_text(text: str) -> Source {
  Source { text: text, identity: DiagnosticSourceBuffer(runtime_str_storage_identity(text)) }
}

-- A source file's text is its exact bytes, malformed UTF-8 included; lexing
-- diagnoses malformed input rather than acquisition rejecting it.
pub(package) fn source_from_file_bytes(bytes: Bytes) -> Source {
  source_from_text(bytes_storage(bytes))
}

-- Acquisition returns a file's exact bytes; module loading and grammars
-- receive them as retained source text.
pub(package) fn source_load_result(bytes: Bytes?) -> SourceLoadResult {
  match bytes {
    nil -> SourceUnavailable
    loaded: Bytes -> SourceLoaded(source_from_file_bytes(loaded))
  }
}

--- A module's logical path without its `.weft` suffix.
pub(package) fn source_module_logical_path(path: str) -> str {
  if path.ends_with(".weft") {
    match path.slice(0, path.len() - 5) {
      Some(stem) -> stem
      None -> path
    }
  } else { path }
}

-- Native input boundary. Registration and parsing must use the returned source.
pub(package) fn source_from_bytes(bytes: i64, length: i64) -> Source {
  source_from_text(runtime_str_from_bytes_copy(bytes, length))
}

pub(package) type SourceRequest {
  physical_path: str,
  logical_path: str,
  package_id: i64
}

pub(package) type SourceLoadResult { SourceLoaded(Source), SourceUnavailable }
