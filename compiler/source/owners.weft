-- Managed backing storage for source-based compiler products. The private
-- parser and checker still store byte views; the products carrying those
-- views must retain their strings independently of a session or renderer.
-- Composition shares retained leaves instead of copying their string fields.
-- Independent products can keep the same backing storage alive without adding
-- a fresh string stake for every diagnostic, cache, and pipeline wrapper.

use compiler/source/input.{SourceRequest, SourceLoadResult, SourceLoaded, SourceUnavailable}
use stdlib/source.{Source}
use stdlib/list.{List, Cons, Nil}

type SourceBacking {
  NoSourceBacking,
    RetainedSourceText(str),
    RetainedModuleSource(SourceRequest, Source),
    SharedSourceBacking(SourceBacking, SourceBacking)
}

pub (package) type SourceOwners = opaque SourceBacking

pub (package) fn new() -> SourceOwners { SourceOwners(NoSourceBacking) }

pub (package) fn with_text(owners: SourceOwners, text: str) -> SourceOwners {
  combined(owners, SourceOwners(RetainedSourceText(text)))
}

pub (package) fn with_source(owners: SourceOwners, request: SourceRequest, source: Source) -> SourceOwners {
  combined(owners, SourceOwners(RetainedModuleSource(request, source)))
}

pub (package) fn lookup(owners: SourceOwners, request: SourceRequest) -> SourceLoadResult {
  let mut pending = match owners { SourceOwners(backing) -> Cons(backing, Nil<SourceBacking>()) }
  loop {
    match pending {
      Nil -> return SourceUnavailable
      Cons(backing, rest) -> {
        pending = rest
        match backing {
          RetainedModuleSource(registered, source) -> {
            if registered.package_id == request.package_id and registered.physical_path == request.physical_path {
              return SourceLoaded(source)
            }
          }
          SharedSourceBacking(left, right) -> { pending = Cons(left, Cons(right, pending)) }
          NoSourceBacking -> nil
          RetainedSourceText(_) -> nil
        }
      }
    }
  }
}

-- Source addresses are still the private checker's module-instance keys.
-- Distinct requests must not collapse when an immutable string is shared.
pub (package) fn contains_source_storage(owners: SourceOwners, source: Source) -> bool {
  let mut pending = match owners { SourceOwners(backing) -> Cons(backing, Nil<SourceBacking>()) }
  loop {
    match pending {
      Nil -> return false
      Cons(backing, rest) -> {
        pending = rest
        match backing {
          RetainedModuleSource(_, registered) -> {
            if __str_ptr(registered.text) == __str_ptr(source.text) { return true }
          }
          RetainedSourceText(text) -> {
            if __str_ptr(text) == __str_ptr(source.text) { return true }
          }
          SharedSourceBacking(left, right) -> { pending = Cons(left, Cons(right, pending)) }
          NoSourceBacking -> nil
        }
      }
    }
  }
}

pub (package) fn combined(left: SourceOwners, right: SourceOwners) -> SourceOwners {
  match left {
    SourceOwners(NoSourceBacking) -> right
    SourceOwners(left_values) -> match right {
      SourceOwners(NoSourceBacking) -> left
      SourceOwners(right_values) -> SourceOwners(SharedSourceBacking(left_values, right_values))
    }
  }
}
