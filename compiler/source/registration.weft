-- Host registration of source identity, trust and import traversal state.
-- Parsing a source range must not install native binding authority.

use compiler/storage.{*}
use compiler/project/module.{*}
use compiler/package/manifest.{*}
use compiler/package/diagnostics.{package_diagnose_native_target_missing}
use compiler/source/trust.{*}
use compiler/weft/check/table.{*}
use runtime/alloc.{*}
use runtime/memory.{*}
use stdlib/diagnostic/schema.{Diagnose}

pub(package) fn is_file_loaded(loaded: i64, src: i64, ns: i64, nl: i64, package_id: i64) -> bool {
  let mut i = 0
  let mut found = false
  while i < nlist_len(loaded) {
    let entry = nlist_get(loaded, i)
    let e_ptr = mem_load64_at(entry, 0)
    let e_len = mem_load64_at(entry, 8)
    if e_len == nl and mem_load64_at(entry, 16) == package_id {
      if src_eq_at(src, ns, e_ptr, 0, nl) == 1 {
        found = true
        i = nlist_len(loaded)
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  found
}

pub(package) fn mark_file_loaded(loaded: i64, src: i64, ns: i64, nl: i64, package_id: i64) -> i64
{
  let entry = alloc_words(3)
  mem_store64_at(entry, 0, src + ns)
  mem_store64_at(entry, 8, nl)
  mem_store64_at(entry, 16, package_id)
  nlist_add(loaded, entry)
}

pub(package) fn mark_trusted_import_source(
  tt: i64,
  path_ptr: i64,
  path_len: i64,
  file_buf: i64
) -> i64 {
  if file_buf == 0 { 0 }
  else {
    if source_trust_path_is_trusted_import(path_ptr, path_len) == 1 {
      ttable_mark_trusted_source(tt, file_buf)
    } else { 0 }
    if source_trust_path_can_grant_import_trust(path_ptr, path_len) == 1 {
      ttable_mark_source_trust_grant_source(tt, file_buf)
    } else { 0 }
  }
}

pub(package) fn source_register_native_binding_declarations(tt: i64, source_entry: i64) -> i64 {
  let src = ttable_native_binding_source_source(source_entry)
  let symbols = pkg_native_target_symbols(ttable_native_binding_source_target(source_entry))
  for i in 0..nlist_len(symbols) {
    let symbol = nlist_get(symbols, i)
    let decl = module_decl_fact_register_synthetic_private(
      tt,
      src,
      module_decl_namespace_value(),
      pkg_native_symbol_declaration_ptr(symbol),
      pkg_native_symbol_declaration_len(symbol)
    )
    ttable_native_binding_source_add_decl(source_entry, symbol, decl)
  }
  nlist_len(symbols)
}

pub(package) fn source_register_root_native_binding(tt: i64, src: i64) -[Diagnose]> i64 {
  let mut retained = 0
  let root_module = module_fact_find_source(tt, src)
  if root_module != 0 and module_fact_entry_anonymous(root_module) == 0 {
    let root_path = module_fact_entry_path_ptr(root_module)
    let root_len = module_fact_entry_path_len(root_module)
    let root_package = module_fact_entry_package(root_module)
    let binding_trust = pkg_binding_module_trust_state(tt, root_package, root_path, root_len)
    if binding_trust == 1 {
      ttable_mark_trusted_source(tt, src)
      let existing_native = ttable_native_binding_source_find(tt, src)
      let native_source = pkg_native_binding_source_register(
        tt,
        src,
        root_package,
        root_path,
        root_len
      )
      if native_source < 0 {
        package_diagnose_native_target_missing(tt, src, root_path, root_len, 0)
      } else if native_source > 0 and existing_native == 0 {
        source_register_native_binding_declarations(tt, native_source)
      }
      retained = native_source
    } else { 0 }
  } else { 0 }
  retained
}

-- Marks a path-aware root as loaded, so an import of the root's own logical
-- identity is deduplicated like any other. Cycles are diagnosed from the
-- module graph, not from traversal state.
pub(package) fn source_mark_root_loaded(tt: i64, src: i64) -> nil {
  let root_module = module_fact_find_source(tt, src)
  if root_module != 0 and module_fact_entry_anonymous(root_module) == 0 {
    let path = module_fact_entry_path_ptr(root_module)
    let length = module_fact_entry_path_len(root_module)
    let package_id = module_fact_entry_package(root_module)
    let loaded = mem_load64_at(tt, 24)
    if not is_file_loaded(loaded, path, 0, length, package_id) {
      mark_file_loaded(loaded, path, 0, length, package_id)
    }
  }
  nil
}

-- Validate manifest authority at the grant producer, independently of resolver
-- diagnostics. Calling this helper cannot make an ordinary module trusted.
pub(package) fn source_register_manifest_import_binding(
  tt: i64,
  source: i64,
  package_id: i64,
  path: i64,
  length: i64
) -> i64 {
  if pkg_binding_module_trust_state(tt, package_id, path, length) == 1 {
    ttable_mark_trusted_source(tt, source)
    pkg_native_binding_source_register(tt, source, package_id, path, length)
  } else { 0 }
}
