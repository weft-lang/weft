-- compiler/grammar/tool.weft -- grammar-neutral tool driving over package exports
--
-- The compiler knows nothing about any guest language. A grammar is a
-- manifest export (package, export name, module, declaration, optional
-- tooling module); the compiler generates a small driver program that
-- imports the export, builds it into the workspace target directory, and
-- talks to it over an interactive child session with the
-- `weft-grammar-tool/1` protocol. Host type queries are answered through the
-- ordinary host type-check handler behind a session-scoped token table.

use compiler/backend/target.{NativeLinkTarget, native_link_target_host, native_link_target_name}
use compiler/package/lock_data.{pkg_lock_parse}
use compiler/package/manifest.{*}
use compiler/pipeline.{*}
use compiler/sdk/identity.{weft_product_identity_json_render_with_sdk}
use compiler/sdk/source.{sdk_source_load_required}
use compiler/storage.{nlist_get, nlist_len, read_fd_all}
use compiler/weft/check/host_types as host_types
use compiler/weft/check/host_types.{HostTypeIdentity}
use compiler/weft/check/registration/scope.{RegistrationScope}
use compiler/weft/products.{TypedModule}
use compiler/weft/check/table.{ttable_sources}
use runtime/alloc.{alloc_zeroed}
use runtime/buffer.{buf_len, buf_ptr}
use runtime/memory.{mem_load8_at, mem_load64_at, mem_store8_at}
use runtime/sha256.{sha256}
use runtime/source_acquire.{SdkOrigin, SourceAcquire, EmbeddedSdk, CheckoutSdk, NoSdk}
use runtime/string.{runtime_str_byte_at, runtime_str_cstring, runtime_str_from_bytes_copy}
use runtime/dir_inspect as dir_inspect_handler
use runtime/file_read as file_read_handler
use runtime/syscall.{
  sys_close,
  sys_dir_mkdir,
  sys_dir_remove_directory,
  sys_open_read,
  sys_open_write_create_new,
  sys_proc_id,
  sys_remove,
  sys_rename,
  sys_write
}
use stdlib/bytes as bytes
use stdlib/bytes.{Bytes, bytes_concat}
use stdlib/diagnostic/schema.{*}
use stdlib/file as file
use stdlib/grammar.{CheckResult, Checked, CheckRejected}
use stdlib/grammar/tooling.{ToolTypeIdentity, tool_type_identity, tool_type_identity_token}
use stdlib/grammar/tooling/digest.{content_digest}
use stdlib/grammar/tooling/protocol.{*}
use stdlib/grammar/tooling/staging.{
  StagingArtifactMissing,
  StagingArtifactUnreadable,
  StagingCapability,
  StagingDigestMismatch,
  StagingDirectoryUnreadable,
  StagingExtraEntry,
