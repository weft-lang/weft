use stdlib/vector as vector
use stdlib/vector.{Vector, vector_get_in_bounds, vector_len, vector_push}

-- Resolution -------------------------------------------------------------
--- A grammar export resolved through package manifests.
pub(package) type GrammarToolExport {
  package_name: str,
  version: str,
  export: str,
  module: str,
  declaration: str,
  tooling: Option<str>,
  --- What a staging site of this export may receive, from the manifest's
  --- `execution`.
  capability: StagingCapability
}

--- The result of resolving a tool-facing grammar name.
pub(package) type GrammarToolResolution {
  GrammarToolResolved(GrammarToolExport),
  --- No manifest in scope exports a grammar under this name.
  GrammarToolUnknown,
  --- More than one package exports the bare name; the candidates are `package/export`.
  GrammarToolAmbiguous(List<str>)
}

fn manifest_package_name(m: i64) -> str {
  pkg_str_view(pkg_manifest_package_start(m), pkg_manifest_package_len(m))
}

--- The export of a manifest entry. `import_prefix` is how the driver source
--- reaches the package's modules: empty for the SDK and the workspace root,
--- whose modules import by their own paths, and `<package>/` for a
--- dependency, whose modules import through its package name.
fn export_of(m: i64, entry: i64, import_prefix: str) -> GrammarToolExport {
  GrammarToolExport {
    package_name: manifest_package_name(m),
    version: pkg_str_view(pkg_manifest_version_ptr(m), pkg_manifest_version_len(m)),
    export: pkg_str_view(pkg_export_name_ptr(entry), pkg_export_name_len(entry)),
    module: str_concat(
      import_prefix,
      pkg_str_view(pkg_export_module_ptr(entry), pkg_export_module_len(entry))
    ),
    declaration: pkg_str_view(
      pkg_export_declaration_ptr(entry),
      pkg_export_declaration_len(entry)
    ),
    tooling: if pkg_export_has_tooling(entry) {
      Some<str>(
        str_concat(
          import_prefix,
          pkg_str_view(pkg_export_tooling_module_ptr(entry), pkg_export_tooling_module_len(entry))
        )
      )
    } else { None<str>() },
    capability: pkg_export_capability(entry)
  }
}

-- The SDK manifest reached through the same acquisition the checker uses;
-- its diagnostics are the checker's business, not resolution's.
fn sdk_manifest() -[SourceAcquire]> i64 {
  let path = "weft.pkg"
  let loaded = handle sdk_source_load_required(__str_ptr(path), __str_len(path)) {
    Diagnose.report(diagnostic) -> resume(0)
    Diagnose.error(message, span) -> resume(0)
    Diagnose.warn(message, span) -> resume(0)
    Diagnose.note(message, span) -> resume(0)
  }
  let ptr = mem_load64_at(loaded, 0)
  let len = mem_load64_at(loaded, 8)
  if len <= 0 { 0 } else {
    let m = pkg_manifest_parse(ptr, len)
    if pkg_manifest_error_count(m) > 0 { 0 } else { m }
  }
}

fn root_manifest() -> i64 {
  let m = pkg_manifest_load_default()
  if pkg_manifest_error_count(m) > 0 or pkg_manifest_package_len(m) == 0 { 0 } else { m }
}

--- The workspace lock, when present, so remote dependencies resolve to their
--- cached roots exactly as the checker resolves them.
fn root_lock() -> i64 {
  let (ptr, len) = read_path("weft.lock")
  if ptr == 0 or len == 0 { 0 } else { pkg_lock_parse(runtime_str_from_bytes_copy(ptr, len)) }
}

--- The manifests of the workspace's direct dependencies, each with the
--- import prefix its modules are reached through. Only direct dependencies
--- are importable by a root module, so they are the whole set a driver can
--- name; a dependency whose root cannot be resolved contributes nothing.
fn dependency_manifests(root: i64) -> List<(i64, str)> {
  if root == 0 { Nil<(i64, str)>() } else {
    let lock = root_lock()
    let deps = pkg_manifest_deps(root)
    let mut found = Nil<(i64, str)>()
    for index in 0..nlist_len(deps) {
      let dep = nlist_get(deps, index)
      match pkg_dependency_root(dep, 0, 0, lock) {
        PackageDependencyRootReady(dep_root, _) -> {
          let m = pkg_manifest_load_at_root(__str_ptr(dep_root), __str_len(dep_root))
          if pkg_manifest_error_count(m) == 0 and pkg_manifest_package_len(m) > 0 {
            found = Cons((m, str_concat(pkg_dep_name(dep), "/")), found)
          } else { nil }
        }
        _ -> nil
      }
    }
    found.reverse()
  }
}

fn split_qualified(name: str) -> (Option<str>, str) {
  match name.find("/") {
    None -> (None<str>(), name)
    Some(index) -> {
      let split = __u64_to_i64(__usize_to_u64(index))
      (Some<str>(str_slice(name, 0, split)), str_slice(name, split + 1, __str_len(name)))
    }
  }
}

fn str_slice(text: str, start: i64, end: i64) -> str {
  runtime_str_from_bytes_copy(__str_ptr(text) + start, end - start)
}

fn find_in_manifest(m: i64, export: str, import_prefix: str) -> Option<GrammarToolExport> {
  if m == 0 { None<GrammarToolExport>() } else {
    let entry = pkg_manifest_find_export(
      m,
      pkg_export_kind_grammar(),
      __str_ptr(export),
      __str_len(export)
    )
    if entry == 0 { None<GrammarToolExport>() } else {
      Some<GrammarToolExport>(export_of(m, entry, import_prefix))
    }
  }
}

fn find_in_dependencies(
  manifests: List<(i64, str)>,
  export: str,
  found: List<GrammarToolExport>
) -> List<GrammarToolExport> {
  match manifests {
    Nil -> found
    Cons((m, prefix), rest) -> find_in_dependencies(
      rest,
      export,
      match find_in_manifest(m, export, prefix) {
        Some(candidate) -> Cons(candidate, found)
        None -> found
      }
    )
  }
}

--- Resolve a grammar name (`export` or `package/export`) against the
--- workspace manifest and the SDK manifest. A bare name exported by both
--- is ambiguous and names its candidates.
--- Resolve a tool-facing grammar name through every manifest a driver can
--- import from: the SDK, the workspace root and the root's direct
--- dependencies (path dependencies directly, remote ones through the lock
--- and cache). A bare name that more than one package exports is ambiguous
--- and must be qualified as `package/export`.
pub(package) fn grammar_tool_resolve(name: str) -[SourceAcquire]> GrammarToolResolution {
  let (qualifier, export) = split_qualified(name)
  let sdk = sdk_manifest()
  let root = root_manifest()
  -- In a checkout the workspace manifest is the SDK manifest; count it once.
  let same_package = sdk != 0 and root != 0 and str_eq(
    manifest_package_name(sdk),
    manifest_package_name(root)
  ) == 1
  let candidates = Nil<GrammarToolExport>()
  let with_sdk = match find_in_manifest(sdk, export, "") {
    Some(found) -> Cons(found, candidates)
    None -> candidates
  }
  let with_workspace = if same_package { with_sdk } else {
    match find_in_manifest(root, export, "") {
      Some(found) -> Cons(found, with_sdk)
      None -> with_sdk
    }
  }
  let with_root = find_in_dependencies(dependency_manifests(root), export, with_workspace)
  let matching = match qualifier {
    None -> with_root
    Some(package_name) -> with_root.filter(
      (candidate: GrammarToolExport) => str_eq(candidate.package_name, package_name) == 1
    )
  }
  match matching {
    Nil -> GrammarToolUnknown
    Cons(only, Nil) -> GrammarToolResolved(only)
    _ -> GrammarToolAmbiguous(
      matching.map<str>(
        (candidate: GrammarToolExport) => str_concat(
          candidate.package_name,
          str_concat("/", candidate.export)
        )
      )
    )
  }
}

--- The wire identity of a resolved export.
pub(package) fn grammar_tool_identity(export: GrammarToolExport) -> ToolGrammar {
  ToolGrammar {
    package_name: export.package_name,
    export: export.export,
    module: export.module,
    declaration: export.declaration
  }
}

-- Audit ------------------------------------------------------------------
--- One conformance `weft pkg audit` asks the checker about.
pub(package) type GrammarToolAuditStatus {
  GrammarToolAuditOk,
  --- The checker rejected the probe; its error messages follow.
  GrammarToolAuditFailed(List<str>),
  --- Not asked, because the export's `Grammar` conformance already failed.
  GrammarToolAuditNotChecked
}

--- What the audit reports for one grammar export: the declaration's `Grammar`
--- conformance and, when the export names a tooling module, the
--- `GrammarTooling` conformance that module must supply for the declaration.
pub(package) type GrammarToolAudit {
  grammar: GrammarToolAuditStatus,
  tooling: Option<GrammarToolAuditStatus>,
  --- The `GrammarStaging` conformance the tooling module must supply when
  --- the export's capability stages typed plans; absent otherwise.
  staging: Option<GrammarToolAuditStatus>
}

--- Which conformances one audit probe asks the checker about.
type AuditProbe {
  grammar_only: bool,
  tooling: bool,
  staging: bool,
  --- Prove the conformances agree on `Syntax` by handing one parse result
  --- to every checked conformance, as the generated driver does.
  agreement: bool
}

--- The grammar exports of the workspace manifest, in declaration order.
pub(package) fn grammar_tool_root_exports() -> List<GrammarToolExport> {
  let m = root_manifest()
  if m == 0 { Nil<GrammarToolExport>() } else {
    let entries = pkg_manifest_exports(m)
    let mut found = Nil<GrammarToolExport>()
    for index in 0..nlist_len(entries) {
      let entry = nlist_get(entries, index)
      if pkg_export_kind(entry) == pkg_export_kind_grammar() {
        found = Cons(export_of(m, entry, ""), found)
      } else { nil }
    }
    found.reverse()
  }
}

--- The audit probe: a root that instantiates bounded generics at the
--- exported declaration, so the checker itself decides each conformance and
--- reports the exact declaration and trait when one is missing. Nothing is
--- constructed or rescanned.
fn audit_probe_source(export: GrammarToolExport, probe: AuditProbe) -> str {
  let with_tooling = probe.tooling or probe.staging
  let tooling_import = if with_tooling {
    match export.tooling {
      Some(tooling) -> if str_eq(tooling, export.module) == 1 { "" } else {
        str_concat("use ", str_concat(tooling, " as tooling_conformance\n"))
      }
      None -> ""
    }
  } else { "" }
  let agreement_effects = if probe.staging {
    "-[TypeCheck<tooling.ToolTypeIdentity>, FileRead, staging.StagingSink, Diagnose]> conformance.StageResult"
  } else { "-[TypeCheck<tooling.ToolTypeIdentity>, Diagnose]> tooling.GrammarCheckOutcome" }
  -- The driver hands what `parse` produced to every conformance it drives,
  -- so they must agree on `Syntax`; these functions type-check only when
  -- they do. The combined probe chains the check into the stage exactly as
  -- the generated driver does; a single-conformance probe proves that one
  -- conformance's agreement with the grammar on its own.
  let agreement_body = if probe.staging and probe.tooling {
    "  match grammar.parse(source) {\n    Parsed(syntax) -> match conformance.host_check(grammar, syntax) {\n      tooling.GrammarChecked -> conformance.stage(grammar, syntax, staging.StagingHostTypes, staging.StagingTarget { capability: staging.StagingTypedPlan, platform: \"\" })\n      _ -> conformance.StageRefused(staging.StagingCheckRejected)\n    }\n    _ -> conformance.StageRefused(staging.StagingCheckRejected)\n  }\n"
  } else {
    if probe.staging {
      "  match grammar.parse(source) {\n    Parsed(syntax) -> conformance.stage(grammar, syntax, staging.StagingHostTypes, staging.StagingTarget { capability: staging.StagingTypedPlan, platform: \"\" })\n    _ -> conformance.StageRefused(staging.StagingCheckRejected)\n  }\n"
    } else {
      "  match grammar.parse(source) {\n    Parsed(syntax) -> conformance.host_check(grammar, syntax)\n    _ -> tooling.GrammarCheckRejected\n  }\n"
    }
  }
  "-- Generated grammar export audit probe for "
    |> str_concat(export.package_name)
    |> str_concat("/")
    |> str_concat(export.export)
    |> str_concat(". Regenerated by the compiler; do not edit.\n")
    |> str_concat("use ")
    |> str_concat(export.module)
    |> str_concat(".{")
    |> str_concat(export.declaration)
    |> str_concat("}\n")
    |> str_concat(tooling_import)
    |> str_concat("use stdlib/grammar.{Grammar, Parsed, ParseResult}\n")
    |> str_concat(
      if with_tooling {
        "use stdlib/grammar/tooling as tooling\nuse stdlib/grammar/tooling.{GrammarTooling}\nuse stdlib/grammar/tooling/conformance as conformance\nuse stdlib/diagnostic/schema.{Diagnose}\nuse stdlib/source.{Span}\nuse stdlib/typecheck.{TypeCheck}\n"
      } else { "" }
    )
    |> str_concat(
      if probe.staging {
        "use stdlib/file.{FileRead}\nuse stdlib/grammar/tooling/staging as staging\nuse stdlib/grammar/tooling/staging.{GrammarStaging}\n"
      } else { "" }
    )
    |> str_concat("\nfn audit_grammar<G: Grammar>() -> nil { nil }\n")
    |> str_concat(
      if probe.tooling { "\nfn audit_tooling<G: GrammarTooling>() -> nil { nil }\n" } else { "" }
    )
    |> str_concat(
      if probe.staging { "\nfn audit_staging<G: GrammarStaging>() -> nil { nil }\n" } else { "" }
    )
    |> str_concat(
      if with_tooling and probe.agreement {
        "\nfn audit_agreement(grammar: "
          |> str_concat(export.declaration)
          |> str_concat(", source: Span) ")
          |> str_concat(agreement_effects)
          |> str_concat(" {\n")
          |> str_concat(agreement_body)
          |> str_concat("}\n")
      } else { "" }
    )
    |> str_concat("\nfn main() -> i64 {\n  audit_grammar<")
    |> str_concat(export.declaration)
    |> str_concat(">()\n")
    |> str_concat(
      if probe.tooling {
        str_concat("  audit_tooling<", str_concat(export.declaration, ">()\n"))
      } else { "" }
    )
    |> str_concat(
      if probe.staging {
        str_concat("  audit_staging<", str_concat(export.declaration, ">()\n"))
      } else { "" }
    )
    |> str_concat("  0\n}\n")
}

fn probe_grammar() -> AuditProbe {
  AuditProbe { grammar_only: true, tooling: false, staging: false, agreement: false }
}

fn probe_tooling(agreement: bool) -> AuditProbe {
  AuditProbe { grammar_only: false, tooling: true, staging: false, agreement: agreement }
}

fn probe_staging(agreement: bool) -> AuditProbe {
  AuditProbe { grammar_only: false, tooling: false, staging: true, agreement: agreement }
}

fn probe_all(staging: bool) -> AuditProbe {
  AuditProbe { grammar_only: false, tooling: true, staging: staging, agreement: true }
}

fn messages_list(messages: Vector<str>, index: i64) -> List<str> {
  if index >= vector_len<str>(messages) { Nil<str>() } else {
    Cons(vector_get_in_bounds<str>(messages, index), messages_list(messages, index + 1))
  }
}

fn audit_check(source: str) -[SourceAcquire]> GrammarToolAuditStatus {
  let messages = vector.new<str>()
  let checked = handle pipeline_check_source_with_diagnostics(
    __str_ptr(source),
    __str_len(source)
  ) {
    Diagnose.report(diagnostic) -> {
      match diagnostic.severity() {
        DiagnosticSeverityError -> { vector_push<str>(messages, diagnostic.message()); nil }
        _ -> nil
      }
      resume(0)
    }
    Diagnose.error(message, span) -> { vector_push<str>(messages, message); resume(0) }
    Diagnose.warn(message, span) -> resume(0)
    Diagnose.note(message, span) -> resume(0)
  }
  let failed = match checked {
    CheckRejected -> true
    Checked(_) -> vector_len<str>(messages) > 0
  }
  if failed { GrammarToolAuditFailed(messages_list(messages, 0)) } else { GrammarToolAuditOk }
}

fn audit_of(
  grammar: GrammarToolAuditStatus,
  tooling: Option<GrammarToolAuditStatus>,
  staging: Option<GrammarToolAuditStatus>
) -> GrammarToolAudit {
  GrammarToolAudit { grammar: grammar, tooling: tooling, staging: staging }
}

fn audit_ok() -> Option<GrammarToolAuditStatus> {
  Some<GrammarToolAuditStatus>(GrammarToolAuditOk)
}

fn audit_not_checked() -> Option<GrammarToolAuditStatus> {
  Some<GrammarToolAuditStatus>(GrammarToolAuditNotChecked)
}

-- One conformance's status on its own: the conformance must exist and must
-- agree with the grammar on `Syntax`.
fn audit_conformance(
  export: GrammarToolExport,
  alone: AuditProbe,
  agreement: AuditProbe
) -[SourceAcquire]> GrammarToolAuditStatus {
  match audit_check(audit_probe_source(export, alone)) {
    GrammarToolAuditOk -> audit_check(audit_probe_source(export, agreement))
    failure -> failure
  }
}

--- Audit one export through the checker. Without a tooling module only the
--- `Grammar` conformance is probed. With one, a combined probe asks for
--- every conformance the export's capability needs and their `Syntax`
--- agreement at once, exactly as the generated driver composes them; when
--- it fails, each conformance is probed on its own, first for its
--- existence and then for its own agreement with the grammar, so the
--- reported diagnostics name exactly the missing conformance or the one
--- that disagrees.
pub(package) fn grammar_tool_audit(export: GrammarToolExport) -[SourceAcquire]> GrammarToolAudit {
  let stages = match export.capability { StagingTypedPlan -> true, StagingValidateOnly -> false }
  match export.tooling {
    None -> audit_of(
      audit_check(audit_probe_source(export, probe_grammar())),
      None<GrammarToolAuditStatus>(),
      if stages {
        Some<GrammarToolAuditStatus>(
          GrammarToolAuditFailed(
            Cons(
              "typed-plan execution requires a tooling module with GrammarStaging",
              Nil<str>()
            )
          )
        )
      } else { None<GrammarToolAuditStatus>() }
    )
    Some(_) -> match audit_check(audit_probe_source(export, probe_all(stages))) {
      GrammarToolAuditOk -> audit_of(
        GrammarToolAuditOk,
        audit_ok(),
        if stages { audit_ok() } else { None<GrammarToolAuditStatus>() }
      )
      GrammarToolAuditNotChecked -> audit_of(
        GrammarToolAuditNotChecked,
        audit_not_checked(),
        if stages { audit_not_checked() } else { None<GrammarToolAuditStatus>() }
      )
      GrammarToolAuditFailed(combined) -> match audit_check(
        audit_probe_source(export, probe_grammar())
      ) {
        GrammarToolAuditOk -> {
          let tooling = audit_conformance(export, probe_tooling(false), probe_tooling(true))
          let staging = if stages {
            audit_conformance(export, probe_staging(false), probe_staging(true))
          } else { GrammarToolAuditOk }
          -- Every conformance holds and agrees on its own, so the combined
          -- composition is what failed; its diagnostics are reported on the
          -- conformance the composition added last.
          let tooling_ok = match tooling { GrammarToolAuditOk -> true, _ -> false }
          let staging_ok = match staging { GrammarToolAuditOk -> true, _ -> false }
          if tooling_ok and staging_ok {
            if stages {
              audit_of(
                GrammarToolAuditOk,
                audit_ok(),
                Some<GrammarToolAuditStatus>(GrammarToolAuditFailed(combined))
              )
            } else {
              audit_of(
                GrammarToolAuditOk,
                Some<GrammarToolAuditStatus>(GrammarToolAuditFailed(combined)),
                None<GrammarToolAuditStatus>()
              )
            }
          } else {
            audit_of(
              GrammarToolAuditOk,
              Some<GrammarToolAuditStatus>(tooling),
              if stages { Some<GrammarToolAuditStatus>(staging) } else {
                None<GrammarToolAuditStatus>()
              }
            )
          }
        }
        grammar_failure -> audit_of(
          grammar_failure,
          audit_not_checked(),
          if stages { audit_not_checked() } else { None<GrammarToolAuditStatus>() }
        )
      }
    }
  }
}

pub(package) fn grammar_tool_audit_failed(audit: GrammarToolAudit) -> bool {
  let grammar_failed = match audit.grammar { GrammarToolAuditFailed(_) -> true, _ -> false }
  let tooling_failed = match audit.tooling {
    Some(GrammarToolAuditFailed(_)) -> true
    _ -> false
  }
  let staging_failed = match audit.staging {
    Some(GrammarToolAuditFailed(_)) -> true
    _ -> false
  }
  grammar_failed or tooling_failed or staging_failed
}

fn audit_status_json(status: GrammarToolAuditStatus) -> Json {
  let (name, diagnostics) = match status {
    GrammarToolAuditOk -> ("ok", Nil<str>())
    GrammarToolAuditNotChecked -> ("not_checked", Nil<str>())
    GrammarToolAuditFailed(messages) -> ("failed", messages)
  }
  json_object(
    Cons(
      json_entry("status", json_string(name)),
      Cons(
        json_entry(
          "diagnostics",
          json_array(diagnostics.map<Json>((message: str) => json_string(message)))
        ),
        Nil<JsonEntry>()
      )
    )
  )
}

--- The audit document entry for one export.
pub(package) fn grammar_tool_audit_json(
  export: GrammarToolExport,
  audit: GrammarToolAudit
) -> Json {
  let module_status = (status: Option<GrammarToolAuditStatus>) => match export.tooling {
    None -> match status {
      None -> json_null()
      Some(found) -> match audit_status_json(found) {
        JsonObject(fields) -> JsonObject(Cons(json_entry("module", json_null()), fields))
        other -> other
      }
    }
    Some(module) -> match status {
      None -> json_null()
      Some(found) -> match audit_status_json(found) {
        JsonObject(fields) -> JsonObject(Cons(json_entry("module", json_string(module)), fields))
        other -> other
      }
    }
  }
  json_object(
    Cons(
      json_entry("export", json_string(export.export)),
      Cons(
        json_entry("module", json_string(export.module)),
        Cons(
          json_entry("declaration", json_string(export.declaration)),
          Cons(
            json_entry("grammar", audit_status_json(audit.grammar)),
            Cons(
              json_entry("tooling", module_status(audit.tooling)),
              Cons(json_entry("staging", module_status(audit.staging)), Nil<JsonEntry>())
            )
          )
        )
      )
    )
  )
}

-- Driver source ----------------------------------------------------------
--- The generated driver program for an export. Its imports are the public
--- driver runtime, the three platform handlers it is allowed, the exported
--- type and, when the export names one, its tooling module.
pub(package) fn grammar_tool_driver_source(export: GrammarToolExport) -> str {
  let header = "-- Generated grammar tool driver for "
    |> str_concat(export.package_name)
    |> str_concat("/")
    |> str_concat(export.export)
    |> str_concat(". Regenerated by the compiler; do not edit.\n")
    |> str_concat("use stdlib/console/input as console_input\n")
    |> str_concat("use stdlib/console/terminal as console_terminal\n")
    |> str_concat("use stdlib/grammar/tooling/driver as driver\n")
    |> str_concat("use ")
    |> str_concat(export.module)
    |> str_concat(".{")
    |> str_concat(export.declaration)
    |> str_concat("}\n")
  match export.tooling {
    None -> header
      |> str_concat(
        "\nfn main() -> i64 {\n  with console_input() {\n    with console_terminal() {\n      driver.serve_parse_only((source) => "
      )
      |> str_concat(export.declaration)
      |> str_concat("().parse(source))\n    }\n  }\n}\n")
    Some(tooling) -> {
      let tooling_import = if str_eq(tooling, export.module) == 1 { "" }
      else { str_concat("use ", str_concat(tooling, " as tooling_conformance\n")) }
      let stages = match export.capability {
        StagingTypedPlan -> true,
        StagingValidateOnly -> false
      }
      let checking = "          (source) => "
        |> str_concat(export.declaration)
        |> str_concat("().parse(source),\n          (syntax) => conformance.host_check(")
        |> str_concat(export.declaration)
        |> str_concat(
          "(), syntax),\n          (syntax, context, limit) => conformance.context_check("
        )
        |> str_concat(export.declaration)
        |> str_concat("(), syntax, context, limit)")
      -- A staging driver installs the platform file writer around the whole
      -- server; only the sink handler inside `serve_staging` performs it.
      if stages {
        header
          |> str_concat("use runtime/file_read as file_read_handler\n")
          |> str_concat("use runtime/file_write as file_write_handler\n")
          |> str_concat("use stdlib/grammar/tooling/conformance as conformance\n")
          |> str_concat(tooling_import)
          |> str_concat(
            "\nfn main() -> i64 {\n  with console_input() {\n    with console_terminal() {\n      with file_read_handler() {\n        with file_write_handler() {\n          driver.serve_staging(\n  "
          )
          |> str_concat(checking)
          |> str_concat(",\n            ")
          |> str_concat(export.declaration)
          |> str_concat(
            "().stagings(),\n            (syntax, context, target) => conformance.stage("
          )
          |> str_concat(export.declaration)
          |> str_concat(
            "(), syntax, context, target)\n          )\n        }\n      }\n    }\n  }\n}\n"
          )
      } else {
        header
          |> str_concat("use runtime/file_read as file_read_handler\n")
          |> str_concat("use stdlib/grammar/tooling/conformance as conformance\n")
          |> str_concat(tooling_import)
          |> str_concat(
            "\nfn main() -> i64 {\n  with console_input() {\n    with console_terminal() {\n      with file_read_handler() {\n        driver.serve(\n"
          )
          |> str_concat(checking)
          |> str_concat("\n        )\n      }\n    }\n  }\n}\n")
      }
    }
  }
}

-- Products ---------------------------------------------------------------
--- Where driver products live for a target.
pub(package) fn grammar_tool_product_directory(target: NativeLinkTarget) -> str {
  str_concat("target/", str_concat(native_link_target_name(target), "/grammar-tools"))
}

--- The identity a product is built under: the product identity with the
--- SDK it selected, then the compiler executable digest when one is given.
fn product_identity(compiler_digest: str) -[SourceAcquire]> str {
  str_concat(
    weft_product_identity_json_render_with_sdk(SourceAcquire.sdk_origin()),
    compiler_digest
  )
}

fn identity_tag(identity: str) -> str {
  let digest = digest_raw(__str_ptr(identity), __str_len(identity))
  str_slice(digest, 7, 19)
}

--- Products are keyed by the identity that built them, so compilers that
--- differ never rebuild over each other's product.
fn product_stem(export: GrammarToolExport, target: NativeLinkTarget, identity: str) -> str {
  grammar_tool_product_directory(target)
    |> str_concat("/")
    |> str_concat(export.package_name)
    |> str_concat("-")
    |> str_concat(export.export)
    |> str_concat("-")
    |> str_concat(identity_tag(identity))
}

--- The product path for an export under the running compiler's identity.
pub(package) fn grammar_tool_product_path(
  export: GrammarToolExport,
  target: NativeLinkTarget,
  compiler_digest: str
) -[SourceAcquire]> str {
  product_stem(export, target, product_identity(compiler_digest))
}

fn ensure_directories(target: NativeLinkTarget) -> nil {
  sys_dir_mkdir(runtime_str_cstring("target"), 493)
  sys_dir_mkdir(runtime_str_cstring(str_concat("target/", native_link_target_name(target))), 493)
  sys_dir_mkdir(runtime_str_cstring(grammar_tool_product_directory(target)), 493)
  nil
}

fn write_all(fd: i64, ptr: i64, len: i64) -> i64 {
  let mut written = 0
  let mut failed = 0
  while written < len and failed == 0 {
    let count = sys_write(fd, ptr + written, len - written)
    if count <= 0 { failed = if count == 0 { 5 } else { 0 - count } } else {
      written = written + count
    }
  }
  failed
}

--- Claim a scratch file beside the final path that no other builder holds.
--- Returns the descriptor and the scratch path, or a negative descriptor
--- with the last error when no name could be claimed.
fn claim_scratch(path: str, mode: i64, attempt: i64) -> (i64, str) {
  let scratch = str_concat(path, str_concat(".tmp-", attempt.to_str()))
  let fd = sys_open_write_create_new(runtime_str_cstring(scratch), mode)
  if fd >= 0 or attempt >= 64 { (fd, scratch) } else {
    claim_scratch(path, mode, attempt + 1)
  }
}

--- Write a file beside its final path and rename it into place, so a reader
--- or a running driver never observes a partial product; concurrent
--- builders of one product each publish a complete file.
fn publish_file(path: str, ptr: i64, len: i64, mode: i64) -> i64 {
  let (fd, scratch) = claim_scratch(path, mode, 0)
  if fd < 0 { 0 - fd } else {
    let status = write_all(fd, ptr, len)
    sys_close(fd)
    if status != 0 {
      sys_remove(runtime_str_cstring(scratch))
      status
    } else {
      let renamed = sys_rename(runtime_str_cstring(scratch), runtime_str_cstring(path))
      if renamed < 0 {
        sys_remove(runtime_str_cstring(scratch))
        0 - renamed
      } else { 0 }
    }
  }
}

fn hex_digit(value: i64) -> i64 { if value < 10 { 48 + value } else { 87 + value } }

fn digest_raw(ptr: i64, len: i64) -> str {
  let raw = alloc_zeroed(32)
  sha256(ptr, len, raw)
  let text = alloc_zeroed(71)
  let prefix = "sha256:"
  for index in 0..7 { mem_store8_at(text, index, runtime_str_byte_at(prefix, index)) }
  for index in 0..32 {
    let byte = mem_load8_at(raw, index)
    mem_store8_at(text, 7 + index * 2, hex_digit(byte / 16))
    mem_store8_at(text, 8 + index * 2, hex_digit(byte - byte / 16 * 16))
  }
  runtime_str_from_bytes_copy(text, 71)
}

fn sdk_owned_path(path: str) -> bool {
  path.starts_with("stdlib/") or path.starts_with("runtime/") or path.starts_with("compiler/")
}

-- The stamp records the protocol, the compiler and SDK identity, the
-- driver source digest and the path and content digest of every module the
-- build loaded. Embedded SDK modules are covered by the identity alone.
fn stamp_render(identity: str, driver_digest: str, product_digest: str, tt: i64) -> str {
  let sources = ttable_sources(tt)
  let mut items = Nil<Json>()
  let mut index = 0
  while index < nlist_len(sources) {
    let entry = nlist_get(sources, index)
    let path_len = mem_load64_at(entry + 24, 0)
    if path_len > 0 {
      let path = pkg_str_view(mem_load64_at(entry + 16, 0), path_len)
      let content = digest_raw(mem_load64_at(entry, 0), mem_load64_at(entry + 8, 0))
      items = Cons(
        json_object(
          Cons(
            json_entry("path", json_string(path)),
            Cons(json_entry("content", json_string(content)), Nil<JsonEntry>())
          )
        ),
        items
      )
    } else { 0 }
    index = index + 1
  }
  let document = json_object(
    Cons(
      json_entry("protocol", json_string(protocol_name())),
      Cons(
        json_entry("compiler", json_string(identity)),
        Cons(
          json_entry("driver", json_string(driver_digest)),
          Cons(
            json_entry("product", json_string(product_digest)),
            Cons(json_entry("sources", json_array(items.reverse())), Nil<JsonEntry>())
          )
        )
      )
    )
  )
  match json_stringify(document) { Ok(text) -> text, Err(_) -> "" }
}

-- Read a whole file by path: (pointer, length), or a zero pointer when the
-- file cannot be opened.
fn read_path(path: str) -> (i64, i64) {
  let fd = sys_open_read(runtime_str_cstring(path))
  if fd < 0 { (0, 0) } else {
    let file = read_fd_all(fd)
    sys_close(fd)
    (mem_load64_at(file, 0), mem_load64_at(file, 8))
  }
}

fn file_digest(path: str) -> Option<str> {
  let (ptr, len) = read_path(path)
  if ptr == 0 { None<str>() } else { Some<str>(digest_raw(ptr, len)) }
}

fn sources_current(items: List<Json>, embedded_sdk: bool) -> bool {
  match items {
    Nil -> true
    Cons(item, rest) -> {
      let path = json_object_get_str(item, "path", "")
      let content = json_object_get_str(item, "content", "")
      let current = if embedded_sdk and sdk_owned_path(path) { true } else {
        match file_digest(path) {
          Some(actual) -> str_eq(actual, content) == 1
          None -> false
        }
      }
      if current { sources_current(rest, embedded_sdk) } else { false }
    }
  }
}

--- A cached product is current when its stamp names this protocol, this
--- compiler identity, this driver source and the digest of every loaded
--- source, and when the executable on disk still has the digest the stamp
--- recorded: a stamp and product published separately can never be taken
--- together unless they belong together.
fn stamp_current(
  stamp_path: str,
  product_path: str,
  identity: str,
  driver_digest: str,
  embedded_sdk: bool
) -> bool {
  let (ptr, len) = read_path(stamp_path)
  if ptr == 0 { false } else {
    match json_parse(runtime_str_from_bytes_copy(ptr, len)) {
      Err(_) -> false
      Ok(document) ->
        str_eq(json_object_get_str(document, "protocol", ""), protocol_name()) == 1 and
        str_eq(json_object_get_str(document, "compiler", ""), identity) == 1 and
        str_eq(json_object_get_str(document, "driver", ""), driver_digest) == 1 and
        match file_digest(product_path) {
          Some(actual) -> str_eq(actual, json_object_get_str(document, "product", "")) == 1
          None -> false
        } and
        match json_object_get(document, "sources") {
          Some(JsonArray(items)) -> sources_current(items, embedded_sdk)
          _ -> false
        }
    }
  }
}

fn typed_module_table(typed: TypedModule) -> i64 {
  match typed { TypedModule(fns, src, tt, owners, _) -> tt }
}

--- Whether a driver product is ready to run.
pub(package) type GrammarToolProduct {
  GrammarToolProductReady(str),
  --- The driver could not be built; the message carries the first diagnostics.
  GrammarToolProductFailed(str)
}

fn executable_kind(target: NativeLinkTarget) -> i64 {
  match target {
    NativeLinkMacosAarch64 -> pipeline_binary_kind_macho_executable()
    NativeLinkLinuxAarch64 -> pipeline_binary_kind_elf_executable()
  }
}

--- The digest of the running compiler's executable, for stamping products
--- built by a checkout compiler whose SDK identity carries no digest. An
--- empty path yields an empty digest and the stamp relies on the SDK
--- identity alone.
pub(package) fn grammar_tool_compiler_digest(executable: str) -> str {
  if __str_len(executable) == 0 { "" } else {
    let (ptr, len) = read_path(executable)
    if ptr == 0 { "" } else { digest_raw(ptr, len) }
  }
}

--- Build the driver product for an export unless the cached one is current.
--- `compiler_digest` distinguishes compilers that share a product identity,
--- which a checkout compiler does across its own rebuilds.
pub(package) fn grammar_tool_ensure_product(
  export: GrammarToolExport,
  target: NativeLinkTarget,
  compiler_digest: str
) -[SourceAcquire]> GrammarToolProduct {
  let identity = product_identity(compiler_digest)
  let embedded_sdk = match SourceAcquire.sdk_origin() { EmbeddedSdk(_) -> true, _ -> false }
  let source = grammar_tool_driver_source(export)
  let driver_digest = digest_raw(__str_ptr(source), __str_len(source))
  let stem = product_stem(export, target, identity)
  let stamp_path = str_concat(stem, ".stamp.json")
  let source_path = str_concat(stem, ".weft")
  if stamp_current(stamp_path, stem, identity, driver_digest, embedded_sdk) {
    GrammarToolProductReady(stem)
  } else {
    ensure_directories(target)
    publish_file(source_path, __str_ptr(source), __str_len(source), 420)
    let messages = vector.new<str>()
    let checked = handle pipeline_check_source_with_diagnostics(
      __str_ptr(source),
      __str_len(source)
    ) {
      Diagnose.report(diagnostic) -> {
        vector_push<str>(messages, diagnostic.message());
        resume(0)
      }
      Diagnose.error(message, span) -> { vector_push<str>(messages, message); resume(0) }
      Diagnose.warn(message, span) -> resume(0)
      Diagnose.note(message, span) -> resume(0)
    }
    match checked {
      CheckRejected -> GrammarToolProductFailed(
        str_concat("grammar tool driver did not check: ", first_message(messages))
      )
      Checked(typed) -> {
        let native = pipeline_lower_native_ir_for_target_closed(typed, target)
        match pipeline_checked_native_product(
          native,
          __str_ptr(source),
          PipelineNativeDebugInformationStripped
        ) {
          PipelineNativeProductFailed(_) -> GrammarToolProductFailed(
            "grammar tool driver did not link"
          )
          PipelineNativeProductReady(binary, facts) -> {
            let output = pipeline_binary_buf(binary)
            if pipeline_binary_kind(binary) != executable_kind(target) or buf_len(output) == 0 {
              GrammarToolProductFailed("grammar tool driver is not a host executable")
            } else {
              let product_digest = digest_raw(buf_ptr(output), buf_len(output))
              let status = publish_file(stem, buf_ptr(output), buf_len(output), 448)
              if status != 0 {
                GrammarToolProductFailed("grammar tool driver product could not be written")
              } else {
                let stamp = stamp_render(
                  identity,
                  driver_digest,
                  product_digest,
                  typed_module_table(typed)
                )
                publish_file(stamp_path, __str_ptr(stamp), __str_len(stamp), 420)
                GrammarToolProductReady(stem)
              }
            }
          }
        }
      }
    }
  }
}

fn first_message(messages: Vector<str>) -> str {
  if vector_len<str>(messages) == 0 { "no diagnostics" } else {
    vector_get_in_bounds<str>(messages, 0)
  }
}

-- Token table --------------------------------------------------------------
--- One issued host identity. Boxing it keeps the table's elements on the
--- managed word path of indexed storage.
pub(package) type GrammarToolIssued { GrammarToolIssued(HostTypeIdentity) }

--- Session-scoped tokens standing for host type identities. A token is the
--- position of the identity it was issued for; anything not issued in this
--- session answers `ForeignTypeIdentity` without reaching the checker.
pub(package) type GrammarToolTokens { issued: Vector<GrammarToolIssued> }

pub(package) fn grammar_tool_tokens() -> GrammarToolTokens {
  GrammarToolTokens { issued: vector.new<GrammarToolIssued>() }
}

fn issue(tokens: GrammarToolTokens, identity: HostTypeIdentity) -> ToolTypeIdentity {
  let issued = tokens.issued
  vector_push<GrammarToolIssued>(issued, GrammarToolIssued(identity))
  tool_type_identity(vector_len<GrammarToolIssued>(issued))
}

fn lookup(tokens: GrammarToolTokens, identity: ToolTypeIdentity) -> Option<HostTypeIdentity> {
  let issued = tokens.issued
  let token = tool_type_identity_token(identity)
  if token < 1 or token > vector_len<GrammarToolIssued>(issued) { None<HostTypeIdentity>() }
  else {
    match vector_get_in_bounds<GrammarToolIssued>(issued, token - 1) {
      GrammarToolIssued(host) -> Some<HostTypeIdentity>(host)
    }
  }
}

fn lookup_all(
  tokens: GrammarToolTokens,
  identities: List<ToolTypeIdentity>
) -> Option<List<HostTypeIdentity>> {
  match identities {
    Nil -> Some<List<HostTypeIdentity>>(Nil<HostTypeIdentity>())
    Cons(identity, rest) -> match lookup(tokens, identity) {
      None -> None<List<HostTypeIdentity>>()
      Some(host) -> match lookup_all(tokens, rest) {
        None -> None<List<HostTypeIdentity>>()
        Some(tail) -> Some<List<HostTypeIdentity>>(Cons(host, tail))
      }
    }
  }
}

fn issued_type(
  tokens: GrammarToolTokens,
  resolved: ResolvedType<HostTypeIdentity>
) -> ResolvedType<ToolTypeIdentity> {
  ResolvedType { identity: issue(tokens, resolved.identity), description: resolved.description }
}

fn issued_fields(
  tokens: GrammarToolTokens,
  fields: List<ResolvedField<HostTypeIdentity>>
) -> List<ResolvedField<ToolTypeIdentity>> {
  match fields {
    Nil -> Nil<ResolvedField<ToolTypeIdentity>>()
    Cons(field, rest) -> Cons(
      ResolvedField { selector: field.selector, value: issued_type(tokens, field.value) },
      issued_fields(tokens, rest)
    )
  }
}

--- Answer one driver query through the host type-check handler.
pub(package) fn grammar_tool_answer(
  tokens: GrammarToolTokens,
  query: ToolQuery
) -[TypeCheck<HostTypeIdentity>]> ToolReply {
  match query {
    ToolQueryResolve(request) -> match lookup_all(tokens, request.arguments) {
      None -> ToolReplyError(ForeignTypeIdentity)
      Some(arguments) -> match TypeCheck<HostTypeIdentity>.resolve(
        TypeName { qualifier: request.qualifier, name: request.name, arguments: arguments }
      ) {
        Ok(resolved) -> ToolReplyType(issued_type(tokens, resolved))
        Err(error) -> ToolReplyError(error)
      }
    }
    ToolQueryField(base, selector) -> match lookup(tokens, base) {
      None -> ToolReplyError(ForeignTypeIdentity)
      Some(host) -> match TypeCheck<HostTypeIdentity>.field(host, selector) {
        Ok(resolved) -> ToolReplyType(issued_type(tokens, resolved))
        Err(error) -> ToolReplyError(error)
      }
    }
    ToolQueryFields(base) -> match lookup(tokens, base) {
      None -> ToolReplyError(ForeignTypeIdentity)
      Some(host) -> match TypeCheck<HostTypeIdentity>.fields(host) {
        Ok(fields) -> ToolReplyFields(issued_fields(tokens, fields))
        Err(error) -> ToolReplyError(error)
      }
    }
    ToolQuerySubtype(actual, expected) -> match lookup(tokens, actual) {
      None -> ToolReplyError(ForeignTypeIdentity)
      Some(actual_host) -> match lookup(tokens, expected) {
        None -> ToolReplyError(ForeignTypeIdentity)
        Some(expected_host) -> match TypeCheck<HostTypeIdentity>.subtype(
          actual_host,
          expected_host
        ) {
          Ok(flag) -> ToolReplyBool(flag)
          Err(error) -> ToolReplyError(error)
        }
      }
    }
  }
}

-- Exchange -----------------------------------------------------------------
--- Why an exchange with a driver produced no response.
pub(package) type GrammarToolFailure {
  --- The driver product could not be started.
  GrammarToolStartFailed(i64),
  --- The deadline elapsed; the driver was killed and reaped.
  GrammarToolTimedOut,
  --- The driver ended without a response; its standard error text follows.
  GrammarToolDriverEnded(str),
  --- The driver wrote a line that is not a protocol message.
  GrammarToolProtocol(ToolProtocolError),
  --- The driver raised a type query for a request without host types.
  GrammarToolUnexpectedQuery,
  --- The driver answered for a different grammar than requested.
  GrammarToolGrammarMismatch,
  --- The session's request write could not complete.
  GrammarToolRequestNotDelivered,
  --- The session stream failed with a platform error code.
  GrammarToolStreamFailed(i64),
  --- The driver wrote more protocol output than the exchange accepts: a line
  --- longer than the frame limit, or output after its response beyond the
  --- session store. The limit that was exceeded follows.
  GrammarToolOutputExceeded(usize),
  --- The driver answered but did not exit cleanly; its termination and
  --- standard error text follow.
  GrammarToolDriverFailed(ProcTermination, str)
}

--- The outcome of one request.
pub(package) type GrammarToolExchange {
  GrammarToolAnswered(ToolResponse),
  GrammarToolFailed(GrammarToolFailure)
}

--- One host query and the canonical reply the compiler returned. Query
--- tokens retain their session-local numbers so replay can prove that a
--- fresh token table issues the same identities in the same order.
pub(package) type GrammarToolTranscriptEntry { query: ToolQuery, reply: str }

--- The complete observable protocol transcript for one successful exchange.
--- `complete` is false when its canonical lines exceed the cache ceiling;
--- the exchange remains valid, but cannot be reused without rerunning.
pub(package) type GrammarToolTranscript {
  request: str,
  entries: List<GrammarToolTranscriptEntry>,
  response: str,
  size: usize,
  complete: bool
}

type GrammarToolTranscriptState {
  request: str,
  entries: List<GrammarToolTranscriptEntry>,
  size: usize,
  complete: bool
}

type GrammarToolRecordedExchange {
  GrammarToolRecordedAnswered(ToolResponse, GrammarToolTranscript),
  GrammarToolRecordedFailed(GrammarToolFailure)
}

type ExchangeState {
  request: ToolRequest,
  deadline: Instant,
  host: bool,
  tokens: GrammarToolTokens,
  frames: FrameBuffer,
  stderr_text: Bytes,
  transcript: GrammarToolTranscriptState
}

--- The bounded standard error text of a driver: what the exchange kept while
--- it ran, then the tail the session captured at finish, capped together.
fn stderr_text_of(state: ExchangeState, output: ProcOutput) -> str {
  let tail = match output {
    ProcCompleted(_, _, text) -> text
    ProcTimedOut(_, _, text) -> text
    ProcFailed(_, _, text) -> text
  }
  match keep_stderr(state.stderr_text, bytes.from_str(tail)).to_utf8() {
    Ok(text) -> text
    Err(_) -> ""
  }
}

fn store_limit() -> usize { __i64_to_usize(4194304) }

fn read_limit() -> usize { __i64_to_usize(65536) }

--- Standard error text kept from a driver: the head of what it wrote, enough
--- to explain a failure without letting a chattering driver grow memory.
fn stderr_limit() -> usize { __i64_to_usize(65536) }

fn keep_stderr(kept: Bytes, chunk: Bytes) -> Bytes {
  if kept.len() >= stderr_limit() { kept } else {
    let joined = bytes_concat(kept, chunk)
    if joined.len() <= stderr_limit() { joined } else {
      joined.slice(__i64_to_usize(0), stderr_limit()).unwrap_or(kept)
    }
  }
}

--- The exchange after a response: the driver must exit cleanly before the
--- deadline, with nothing more than the bounded output the session stores.
fn transcript_add(
  state: GrammarToolTranscriptState,
  entry: GrammarToolTranscriptEntry
) -> GrammarToolTranscriptState {
  if not state.complete { state } else {
    let query_line = render_line(encode_query(entry.query))
    let next_size = state.size + query_line.len() + entry.reply.len()
    if next_size > transcript_ceiling() { state.{ complete: false } } else {
      state.{ entries: Cons(entry, state.entries), size: next_size }
    }
  }
}

fn transcript_finish(
  state: GrammarToolTranscriptState,
  response: ToolResponse
) -> GrammarToolTranscript {
  match encode_response(response) {
    Err(_) -> GrammarToolTranscript {
      request: state.request,
      entries: Nil<GrammarToolTranscriptEntry>(),
      response: "",
      size: state.size,
      complete: false
    }
    Ok(document) -> {
      let response_line = render_line(document)
      let next_size = state.size + response_line.len()
      let complete = state.complete and next_size <= transcript_ceiling()
      GrammarToolTranscript {
        request: state.request,
        entries: if complete { state.entries.reverse() } else {
          Nil<GrammarToolTranscriptEntry>()
        },
        response: if complete { response_line } else { "" },
        size: next_size,
        complete: complete
      }
    }
  }
}

fn answered(
  state: ExchangeState,
  response: ToolResponse,
  output: ProcOutput
) -> GrammarToolRecordedExchange {
  if not same_grammar(response.grammar, state.request.grammar) {
    GrammarToolRecordedFailed(GrammarToolGrammarMismatch)
  } else {
    match output {
      ProcCompleted(termination, _, _) -> match termination {
        ProcExited(status) -> if status == 0 {
          GrammarToolRecordedAnswered(response, transcript_finish(state.transcript, response))
        } else {
          GrammarToolRecordedFailed(
            GrammarToolDriverFailed(termination, stderr_text_of(state, output))
          )
        }
        ProcSignaled(_) ->
          GrammarToolRecordedFailed(
            GrammarToolDriverFailed(termination, stderr_text_of(state, output))
          )
      }
      ProcTimedOut(_, _, _) -> GrammarToolRecordedFailed(GrammarToolTimedOut)
      ProcFailed(ProcOutputLimitExceeded(limit), _, _) ->
        GrammarToolRecordedFailed(GrammarToolOutputExceeded(limit))
      ProcFailed(ProcStreamFailed(code), _, _) ->
        GrammarToolRecordedFailed(GrammarToolStreamFailed(code))
      ProcFailed(ProcSpawnFailed(code), _, _) ->
        GrammarToolRecordedFailed(GrammarToolStartFailed(code))
      ProcFailed(_, _, _) -> GrammarToolRecordedFailed(GrammarToolStreamFailed(0))
    }
  }
}

fn exchange_line(
  session: ProcSession,
  state: ExchangeState,
  line: Bytes
) -[Proc, TypeCheck<HostTypeIdentity>]> GrammarToolRecordedExchange {
  let decoded = match line.to_utf8() {
    Err(_) -> Err<ToolDriverMessage, ToolProtocolError>(ToolProtocolShape("line", "utf-8"))
    Ok(text) -> match parse_line(text) {
      Err(error) -> Err<ToolDriverMessage, ToolProtocolError>(error)
      Ok(document) -> decode_driver_message(document)
    }
  }
  match decoded {
    Err(error) -> {
      Proc.session_release(session)
      GrammarToolRecordedFailed(GrammarToolProtocol(error))
    }
    Ok(ToolDriverResponse(response)) ->
      answered(state, response, Proc.session_finish_until(session, state.deadline))
    Ok(ToolDriverQuery(query)) -> if not state.host {
      Proc.session_release(session)
      GrammarToolRecordedFailed(GrammarToolUnexpectedQuery)
    } else {
      let reply = grammar_tool_answer(state.tokens, query)
      let reply_line = render_line(encode_reply(reply))
      let (next, wrote) = Proc.session_write(
        session,
        bytes.from_str(reply_line),
        state.deadline
      )
      let next_state = state.{
        transcript: transcript_add(
          state.transcript,
          GrammarToolTranscriptEntry { query: query, reply: reply_line }
        )
      }
      match wrote {
        ProcWritten -> exchange_step(next, next_state)
        ProcWriteTimedOut(_) -> {
          Proc.session_release(next);
          GrammarToolRecordedFailed(GrammarToolTimedOut)
        }
        ProcWriteBlocked(_) -> {
          Proc.session_release(next);
          GrammarToolRecordedFailed(GrammarToolRequestNotDelivered)
        }
        -- Preserve the existing exchange behavior after a refused write, but
        -- never reuse it: the child may have observed only a prefix of the
        -- canonical reply.
        ProcWriteRefused(_) -> exchange_step(
          next,
          state.{ transcript: state.transcript.{ complete: false } }
        )
        ProcWriteFailed(ProcStreamFailed(code), _) -> {
          Proc.session_release(next);
          GrammarToolRecordedFailed(GrammarToolStreamFailed(code))
        }
        ProcWriteFailed(_, _) -> {
          Proc.session_release(next);
          GrammarToolRecordedFailed(GrammarToolRequestNotDelivered)
        }
      }
    }
  }
}

fn exchange_step(
  session: ProcSession,
  state: ExchangeState
) -[Proc, TypeCheck<HostTypeIdentity>]> GrammarToolRecordedExchange {
  match frame_buffer_take_line(state.frames) {
    Some(line) -> exchange_line(session, state, line)
    None -> {
      let (next, got) = Proc.session_read(session, read_limit(), state.deadline)
      match got {
        ProcReadChunk(ProcStdout, chunk) ->
          if frame_buffer_accept(state.frames, chunk, frame_limit()) {
            exchange_step(next, state)
          }
        else {
          Proc.session_release(next)
          GrammarToolRecordedFailed(GrammarToolOutputExceeded(frame_limit()))
        }
        ProcReadChunk(ProcStderr, chunk) -> exchange_step(
          next,
          state.{ stderr_text: keep_stderr(state.stderr_text, chunk) }
        )
        ProcReadEnded -> {
          let output = Proc.session_finish_until(next, state.deadline)
          GrammarToolRecordedFailed(GrammarToolDriverEnded(stderr_text_of(state, output)))
        }
        ProcReadTimedOut -> {
          Proc.session_release(next)
          GrammarToolRecordedFailed(GrammarToolTimedOut)
        }
        ProcReadFailed(ProcSpawnFailed(code)) -> {
          Proc.session_release(next);
          GrammarToolRecordedFailed(GrammarToolStartFailed(code))
        }
        ProcReadFailed(ProcStreamFailed(code)) -> {
          Proc.session_release(next);
          GrammarToolRecordedFailed(GrammarToolStreamFailed(code))
        }
        ProcReadFailed(_) -> {
          Proc.session_release(next);
          GrammarToolRecordedFailed(GrammarToolStreamFailed(0))
        }
      }
    }
  }
}

fn grammar_tool_exchange_recorded(
  product: str,
  request: ToolRequest,
  transcript_request: ToolRequest,
  host: bool,
  deadline: Instant
) -[Proc, TypeCheck<HostTypeIdentity>]> GrammarToolRecordedExchange {
  match (encode_request(request), encode_request(transcript_request)) {
    (Err(error), _) -> GrammarToolRecordedFailed(GrammarToolProtocol(error))
    (_, Err(error)) -> GrammarToolRecordedFailed(GrammarToolProtocol(error))
    (Ok(document), Ok(transcript_document)) -> {
      let request_line = render_line(document)
      let transcript_line = render_line(transcript_document)
      let session: owned ProcSession = Proc.open_session(product, Nil<str>(), store_limit())
      let (started, wrote) = Proc.session_write(session, bytes.from_str(request_line), deadline)
      let state = ExchangeState {
        request: request,
        deadline: deadline,
        host: host,
        tokens: grammar_tool_tokens(),
        frames: frame_buffer(),
        stderr_text: bytes.empty(),
        transcript: GrammarToolTranscriptState {
          request: transcript_line,
          entries: Nil<GrammarToolTranscriptEntry>(),
          size: transcript_line.len(),
          complete: transcript_line.len() <= transcript_ceiling()
        }
      }
      match wrote {
        ProcWritten -> exchange_step(started, state)
        ProcWriteFailed(ProcSpawnFailed(code), _) -> {
          Proc.session_release(started);
          GrammarToolRecordedFailed(GrammarToolStartFailed(code))
        }
        ProcWriteFailed(ProcStreamFailed(code), _) -> {
          Proc.session_release(started);
          GrammarToolRecordedFailed(GrammarToolStreamFailed(code))
        }
        ProcWriteTimedOut(_) -> {
          Proc.session_release(started);
          GrammarToolRecordedFailed(GrammarToolTimedOut)
        }
        _ -> {
          let output = Proc.session_finish_until(started, deadline)
          GrammarToolRecordedFailed(GrammarToolDriverEnded(stderr_text_of(state, output)))
        }
      }
    }
  }
}

--- Run one request against a driver product. Host type queries are answered
--- through the enclosing `TypeCheck<HostTypeIdentity>` handler when `host`
--- is set; otherwise any query fails the exchange.
pub(package) fn grammar_tool_exchange(
  product: str,
  request: ToolRequest,
  host: bool,
  deadline: Instant
) -[Proc, TypeCheck<HostTypeIdentity>]> GrammarToolExchange {
  match grammar_tool_exchange_recorded(product, request, request, host, deadline) {
    GrammarToolRecordedAnswered(response, _) -> GrammarToolAnswered(response)
    GrammarToolRecordedFailed(failure) -> GrammarToolFailed(failure)
  }
}

--- Run one request without host types: any type query fails the exchange.
pub(package) fn grammar_tool_exchange_without_host(
  product: str,
  request: ToolRequest,
  deadline: Instant
) -[Proc]> GrammarToolExchange {
  handle grammar_tool_exchange(product, request, false, deadline) {
    TypeCheck<HostTypeIdentity>.resolve(name) -> resume(
      Err<ResolvedType<HostTypeIdentity>, TypeQueryError>(TypeNotFound)
    )
    TypeCheck<HostTypeIdentity>.field(base, selector) -> resume(
      Err<ResolvedType<HostTypeIdentity>, TypeQueryError>(ForeignTypeIdentity)
    )
    TypeCheck<HostTypeIdentity>.fields(base) -> resume(
      Err<List<ResolvedField<HostTypeIdentity>>, TypeQueryError>(ForeignTypeIdentity)
    )
    TypeCheck<HostTypeIdentity>.subtype(actual, expected) -> resume(
      Err<bool, TypeQueryError>(ForeignTypeIdentity)
    )
  }
}

--- Run one request with host types answered from a checked host module.
pub(package) fn grammar_tool_exchange_with_host(
  product: str,
  request: ToolRequest,
  table: i64,
  source: i64,
  registrations: RegistrationScope,
  deadline: Instant
) -[Proc]> GrammarToolExchange {
  host_types.run(
    table,
    source,
    registrations,
    () => grammar_tool_exchange(product, request, true, deadline)
  )
}

fn grammar_tool_exchange_recorded_with_host(
  product: str,
  request: ToolRequest,
  transcript_request: ToolRequest,
  table: i64,
  source: i64,
  registrations: RegistrationScope,
  deadline: Instant
) -[Proc]> GrammarToolRecordedExchange {
  host_types.run(
    table,
    source,
    registrations,
    () => grammar_tool_exchange_recorded(
      product,
      request,
      transcript_request,
      true,
      deadline
    )
  )
}

--- Render a failure for tool output.
pub(package) fn grammar_tool_failure_message(failure: GrammarToolFailure) -> str {
  match failure {
    GrammarToolStartFailed(code) -> str_concat(
      "grammar tool driver could not be started (error ",
      str_concat(int_text(code), ")")
    )
    GrammarToolTimedOut -> "grammar tool driver did not answer before its deadline"
    GrammarToolDriverEnded(text) -> if __str_len(text) == 0 {
      "grammar tool driver ended without a response"
    } else { str_concat("grammar tool driver ended without a response: ", text) }
    GrammarToolProtocol(error) -> error_message(error)
    GrammarToolUnexpectedQuery ->
      "grammar tool driver raised a host type query without host types"
    GrammarToolGrammarMismatch -> "grammar tool driver answered for a different grammar"
    GrammarToolRequestNotDelivered -> "grammar tool driver did not accept the request"
    GrammarToolOutputExceeded(limit) -> str_concat(
      "grammar tool driver wrote more than ",
      str_concat(int_text(__u64_to_i64(__usize_to_u64(limit))), " bytes of protocol output")
    )
    GrammarToolDriverFailed(termination, text) -> {
      let ending = match termination {
        ProcExited(status) -> str_concat("exited with status ", int_text(status))
        ProcSignaled(signal) -> str_concat("was terminated by signal ", int_text(signal))
      }
      let head = str_concat("grammar tool driver answered but ", ending)
      if __str_len(text) == 0 { head } else { str_concat(head, str_concat(": ", text)) }
    }
    GrammarToolStreamFailed(code) -> str_concat(
      "grammar tool session failed (error ",
      str_concat(int_text(code), ")")
    )
  }
}

fn int_text(value: i64) -> str { value.to_str() }

-- Diagnostics --------------------------------------------------------------
fn anchor_location(
  location: DiagnosticLocation,
  source_name: str,
  buffer: i64
) -> DiagnosticLocation {
  anchor_location_at(location, source_name, buffer, __i64_to_usize(0))
}

-- The request's source text starts `shift` bytes into the buffer: a staged
-- literal's content offset, or zero when the request was the whole buffer.
fn anchor_location_at(
  location: DiagnosticLocation,
  source_name: str,
  buffer: i64,
  shift: usize
) -> DiagnosticLocation {
  match location {
    DiagnosticSourceRange(DiagnosticSourceNamed(name), start, end) ->
      if str_eq(name, source_name) == 1 {
        DiagnosticSourceRange(DiagnosticSourceBuffer(buffer), start + shift, end + shift)
      } else { location }
    _ -> location
  }
}

--- Re-anchor a driver diagnostic onto a staged literal inside the compiler's
--- source buffer: ranges naming the request's source identity become buffer
--- ranges shifted by the literal content's offset.
pub(package) fn grammar_tool_anchor_at(
  diagnostic: Diagnostic,
  source_name: str,
  buffer: i64,
  shift: usize
) -> Diagnostic {
  match grammar_tool_anchor(diagnostic, source_name, buffer) {
    Diagnostic(severity, class, code, message, primary, related, fields) ->
      Diagnostic(
        severity,
        class,
        code,
        message,
        shift_location(primary, buffer, shift),
        shift_related(related, buffer, shift),
        fields
      )
  }
}

fn shift_location(location: DiagnosticLocation, buffer: i64, shift: usize) -> DiagnosticLocation {
  match location {
    DiagnosticSourceRange(DiagnosticSourceBuffer(found), start, end) ->
      if found == buffer {
        DiagnosticSourceRange(DiagnosticSourceBuffer(buffer), start + shift, end + shift)
      }
    else { location }
    _ -> location
  }
}

fn shift_related(
  related: DiagnosticRelatedLocationList,
  buffer: i64,
  shift: usize
) -> DiagnosticRelatedLocationList {
  match related {
    DiagnosticRelatedLocationNil -> DiagnosticRelatedLocationNil
    DiagnosticRelatedLocationCons(DiagnosticRelatedLocation(message, location), rest) ->
      DiagnosticRelatedLocationCons(
        DiagnosticRelatedLocation(message, shift_location(location, buffer, shift)),
        shift_related(rest, buffer, shift)
      )
  }
}

fn anchor_related(
  related: DiagnosticRelatedLocationList,
  source_name: str,
  buffer: i64
) -> DiagnosticRelatedLocationList {
  match related {
    DiagnosticRelatedLocationNil -> DiagnosticRelatedLocationNil
    DiagnosticRelatedLocationCons(DiagnosticRelatedLocation(label, location), rest) ->
      DiagnosticRelatedLocationCons(
        DiagnosticRelatedLocation(label, anchor_location(location, source_name, buffer)),
        anchor_related(rest, source_name, buffer)
      )
  }
}

fn anchor_edits(
  edits: DiagnosticTextEditList,
  source_name: str,
  buffer: i64
) -> DiagnosticTextEditList {
  match edits {
    DiagnosticTextEditNil -> DiagnosticTextEditNil
    DiagnosticTextEditCons(DiagnosticTextEdit(location, text), rest) ->
      DiagnosticTextEditCons(
        DiagnosticTextEdit(anchor_location(location, source_name, buffer), text),
        anchor_edits(rest, source_name, buffer)
      )
  }
}

fn anchor_fields(
  fields: DiagnosticFieldList,
  source_name: str,
  buffer: i64
) -> DiagnosticFieldList {
  match fields {
    DiagnosticFieldNil -> DiagnosticFieldNil
    DiagnosticFieldCons(field, rest) -> {
      let anchored = match field {
        DiagnosticFieldLocation(name, location) -> DiagnosticFieldLocation(
          name,
          anchor_location(location, source_name, buffer)
        )
        DiagnosticFieldSuggestion(DiagnosticSuggestion(message, applicability, edits)) ->
          DiagnosticFieldSuggestion(
            DiagnosticSuggestion(message, applicability, anchor_edits(edits, source_name, buffer))
          )
        other -> other
      }
      DiagnosticFieldCons(anchored, anchor_fields(rest, source_name, buffer))
    }
  }
}

--- Re-anchor a driver diagnostic onto the compiler's source buffer: ranges
--- naming the request's source identity become buffer ranges with the same
--- offsets, so the existing renderers position them unchanged.
pub(package) fn grammar_tool_anchor(
  diagnostic: Diagnostic,
  source_name: str,
  buffer: i64
) -> Diagnostic {
  match diagnostic {
    Diagnostic(severity, class, code, message, primary, related, fields) ->
      Diagnostic(
        severity,
        class,
        code,
        message,
        anchor_location(primary, source_name, buffer),
        anchor_related(related, source_name, buffer),
        anchor_fields(fields, source_name, buffer)
      )
  }
}

-- Staging -------------------------------------------------------------------
--- A verified artifact: its bytes exactly as the driver wrote them, the
--- digest and size the compiler verified, the byte budget the sink enforced,
--- the package's facts envelope, the file reads the driver observed, and
--- the content-addressed store path the bytes now live at.
pub(package) type GrammarStagedArtifact {
  content: str,
  size: usize,
  budget: usize,
  bytes: Bytes,
  facts: Json,
  observed_inputs: List<ToolObservedInput>,
  store: str,
  host_transcript: str
}

pub(package) type GrammarValidatedStage {
  observed_inputs: List<ToolObservedInput>,
  host_transcript: str
}

--- What staging one site produced.
pub(package) type GrammarStageOutcome {
  --- The export emitted an artifact, verified and stored.
  GrammarStageStaged(GrammarStagedArtifact),
  --- The export checked the source and emits nothing; its observed reads.
  GrammarStageValidated(GrammarValidatedStage),
  --- The driver answered but withheld staging; the response carries the
  --- diagnostics and the refusal.
  GrammarStageRefused(ToolResponse),
  --- The exchange produced no response.
  GrammarStageFailed(GrammarToolFailure),
  --- The driver reported an artifact the sink directory does not hold.
  GrammarStageVerifyFailed(StagingVerifyFailure),
  --- The private sink directory could not be created; the error follows.
  GrammarStageSinkUnavailable(i64),
  --- The verified bytes could not be stored; the error follows.
  GrammarStageStoreFailed(i64)
}

--- Where staged artifacts live for a target, content-addressed per export.
pub(package) fn grammar_tool_artifact_directory(
  target: NativeLinkTarget,
  export: GrammarToolExport
) -> str {
  "target/"
    |> str_concat(native_link_target_name(target))
    |> str_concat("/grammar-artifacts/")
    |> str_concat(export.package_name)
    |> str_concat("-")
    |> str_concat(export.export)
}

fn stage_sink_root() -> str { ".weft/staging" }

-- One private directory per request: the process id and a build sequence
-- number, so concurrent builds and sequential sites never share one.
fn stage_sink_directory(sequence: i64) -> Result<str, i64> {
  sys_dir_mkdir(runtime_str_cstring(".weft"), 493)
  sys_dir_mkdir(runtime_str_cstring(stage_sink_root()), 448)
  let directory = stage_sink_root()
    |> str_concat("/")
    |> str_concat(sys_proc_id().to_str())
    |> str_concat("-")
    |> str_concat(sequence.to_str())
  let status = sys_dir_mkdir(runtime_str_cstring(directory), 448)
  if status < 0 { Err<str, i64>(0 - status) } else { Ok<str, i64>(directory) }
}

fn stage_sink_cleanup(directory: str) -> nil {
  sys_remove(runtime_str_cstring(str_concat(directory, "/artifact")))
  sys_dir_remove_directory(runtime_str_cstring(directory))
  nil
}

fn stage_verify(
  directory: str,
  artifact: ToolStagedArtifact
) -> Result<Bytes, StagingVerifyFailure> {
  match path.from_utf8(directory) {
    Err(_) -> Err<Bytes, StagingVerifyFailure>(StagingArtifactMissing)
    Ok(sink) -> with dir_inspect_handler() {
      with file_read_handler() {
        verify_artifact(sink, artifact.size, artifact.content, artifact.budget)
      }
    }
  }
}

fn digest_hex(content: str) -> str {
  match content.slice(__i64_to_usize(7), content.len()) {
    Some(hex) -> hex
    None -> content
  }
}

-- Move the verified artifact into the store. A file already present under
-- the same digest is the same bytes, so the sink copy is simply dropped.
fn stage_store(
  directory: str,
  target: NativeLinkTarget,
  export: GrammarToolExport,
  artifact: ToolStagedArtifact
) -> Result<str, i64> {
  ensure_directories(target)
  sys_dir_mkdir(
    runtime_str_cstring(
      str_concat("target/", str_concat(native_link_target_name(target), "/grammar-artifacts"))
    ),
    493
  )
  let store_directory = grammar_tool_artifact_directory(target, export)
  sys_dir_mkdir(runtime_str_cstring(store_directory), 493)
  let store = str_concat(store_directory, str_concat("/", digest_hex(artifact.content)))
  let (existing_ptr, existing_len) = read_path(store)
  if existing_ptr != 0 { Ok<str, i64>(store) } else {
    let sink_artifact = str_concat(directory, "/artifact")
    let renamed = sys_rename(runtime_str_cstring(sink_artifact), runtime_str_cstring(store))
    if renamed >= 0 { Ok<str, i64>(store) } else {
      -- A store on another filesystem cannot take the rename; publish the
      -- verified file's bytes beside the final path instead.
      let (ptr, len) = read_path(sink_artifact)
      if ptr == 0 { Err<str, i64>(0 - renamed) } else {
        let status = publish_file(store, ptr, len, 420)
        if status == 0 { Ok<str, i64>(store) } else { Err<str, i64>(status) }
      }
    }
  }
}

-- Cached staging -----------------------------------------------------------
-- The cache is deliberately private compiler data. Artifact facts expose
-- only its transcript digest; no cached query token or checked plan becomes
-- a public ABI.
type GrammarStageCacheIdentity {
  key: str,
  driver: str,
  request: str,
  path: str
}

type GrammarStageCacheRecord {
  transcript: GrammarToolTranscript,
  response: ToolResponse,
  store: str
}

fn stage_cache_directory(target: NativeLinkTarget, export: GrammarToolExport) -> str {
  "target/"
    |> str_concat(native_link_target_name(target))
    |> str_concat("/grammar-stage-cache/")
    |> str_concat(export.package_name)
    |> str_concat("-")
    |> str_concat(export.export)
}

fn stage_cache_ensure_directory(target: NativeLinkTarget, export: GrammarToolExport) -> nil {
  ensure_directories(target)
  sys_dir_mkdir(
    runtime_str_cstring(
      str_concat("target/", str_concat(native_link_target_name(target), "/grammar-stage-cache"))
    ),
    493
  )
  sys_dir_mkdir(runtime_str_cstring(stage_cache_directory(target, export)), 493)
  nil
}

fn stage_cache_identity(
  product: str,
  export: GrammarToolExport,
  target: NativeLinkTarget,
  request: ToolRequest
) -> GrammarStageCacheIdentity {
  match (file_digest(product), encode_request(request)) {
    (Some(driver), Ok(request_document)) -> {
      let request_line = render_line(request_document)
      let identity_entries = [
        json_entry("schema", json_number(1)),
        json_entry("protocol", json_string(protocol_name())),
        json_entry("driver", json_string(driver)),
        json_entry("version", json_string(export.version)),
        json_entry("request", request_document)
      ]
      let identity_document = json_object(list.from_slice(identity_entries[..]))
      match json_stringify(identity_document) {
        Err(_) -> GrammarStageCacheIdentity { key: "", driver: "", request: "", path: "" }
        Ok(identity) -> {
          let key = digest_raw(__str_ptr(identity), __str_len(identity))
          let directory = stage_cache_directory(target, export)
          GrammarStageCacheIdentity {
            key: key,
            driver: driver,
            request: request_line,
            path: str_concat(directory, str_concat("/", digest_hex(key)))
          }
        }
      }
    }
    _ -> GrammarStageCacheIdentity { key: "", driver: "", request: "", path: "" }
  }
}

fn transcript_text(transcript: GrammarToolTranscript) -> str {
  let mut text = transcript.request
  for entry in transcript.entries {
    text = str_concat(text, render_line(encode_query(entry.query)))
    text = str_concat(text, entry.reply)
  }
  str_concat(text, transcript.response)
}

fn transcript_digest(transcript: GrammarToolTranscript) -> str {
  if not transcript.complete { "" } else {
    let text = transcript_text(transcript)
    digest_raw(__str_ptr(text), __str_len(text))
  }
}

fn cache_entries_json(entries: List<GrammarToolTranscriptEntry>) -> List<Json> {
  entries.map<Json>(
    (entry: GrammarToolTranscriptEntry) => {
      let fields = [
        json_entry("query", encode_query(entry.query)),
        json_entry("reply", json_string(entry.reply))
      ]
      json_object(list.from_slice(fields[..]))
    }
  )
}

fn stage_cache_render(
  identity: GrammarStageCacheIdentity,
  record: GrammarStageCacheRecord
) -> Option<str> {
  match encode_response(record.response) {
    Err(_) -> None<str>()
    Ok(response) -> {
      let fields = [
        json_entry("schema", json_number(1)),
        json_entry("key", json_string(identity.key)),
        json_entry("driver", json_string(identity.driver)),
        json_entry("request", json_string(record.transcript.request)),
        json_entry("exchanges", json_array(cache_entries_json(record.transcript.entries))),
        json_entry("transcript", json_string(transcript_digest(record.transcript))),
        json_entry("response", response),
        json_entry("store", json_string(record.store))
      ]
      match json_stringify(json_object(list.from_slice(fields[..]))) {
        Ok(text) -> Some<str>(text)
        Err(_) -> None<str>()
      }
    }
  }
}

fn stage_cache_decode_entries(items: List<Json>) -> Option<List<GrammarToolTranscriptEntry>> {
  let mut decoded = Nil<GrammarToolTranscriptEntry>()
  let mut remaining = items
  let mut valid = true
  while valid and not remaining.is_empty() {
    match remaining {
      Nil -> nil
      Cons(item, rest) -> {
        remaining = rest
        match (json_object_get(item, "query"), json_object_get(item, "reply")) {
          (Some(query_document), Some(JsonString(reply))) -> match decode_query(query_document) {
            Err(_) -> { valid = false; nil }
            Ok(query) -> {
              decoded = Cons(GrammarToolTranscriptEntry { query: query, reply: reply }, decoded)
              nil
            }
          }
          _ -> { valid = false; nil }
        }
      }
    }
  }
  if valid { Some<List<GrammarToolTranscriptEntry>>(decoded.reverse()) } else {
    None<List<GrammarToolTranscriptEntry>>()
  }
}

fn stage_cache_decode(
  identity: GrammarStageCacheIdentity,
  text: str
) -> Option<GrammarStageCacheRecord> {
  match json.parse(text) {
    Err(_) -> None<GrammarStageCacheRecord>()
    Ok(document) -> if json_object_get_i64(document, "schema", 0) != 1 or
      str_eq(json_object_get_str(document, "key", ""), identity.key) == 0 or
      str_eq(json_object_get_str(document, "driver", ""), identity.driver) == 0 or
      str_eq(json_object_get_str(document, "request", ""), identity.request) == 0 {
        None<GrammarStageCacheRecord>()
      } else {
        match (json_object_get(document, "exchanges"), json_object_get(document, "response")) {
          (Some(JsonArray(items)), Some(response_document)) -> match stage_cache_decode_entries(
            items
          ) {
            None -> None<GrammarStageCacheRecord>()
            Some(entries) -> match decode_response(response_document) {
              Err(_) -> None<GrammarStageCacheRecord>()
              Ok(response) -> {
                let response_line = render_line(response_document)
                let transcript = GrammarToolTranscript {
                  request: identity.request,
                  entries: entries,
                  response: response_line,
                  size: 0,
                  complete: true
                }
                let size = transcript_text(transcript).len()
                let complete = transcript.{ size: size }
                if size > transcript_ceiling() or
                  str_eq(
                    json_object_get_str(document, "transcript", ""),
                    transcript_digest(complete)
                  ) == 0 {
                    None<GrammarStageCacheRecord>()
                  } else {
                    Some<GrammarStageCacheRecord>(
                      GrammarStageCacheRecord {
                        transcript: complete,
                        response: response,
                        store: json_object_get_str(document, "store", "")
                      }
                    )
                  }
              }
            }
          }
          _ -> None<GrammarStageCacheRecord>()
        }
      }
  }
}

fn stage_cache_replay_entries(
  entries: List<GrammarToolTranscriptEntry>,
  tokens: GrammarToolTokens
) -[TypeCheck<HostTypeIdentity>]> bool {
  let mut current = entries
  let mut valid = true
  while valid and not current.is_empty() {
    match current {
      Nil -> nil
      Cons(entry, rest) -> {
        current = rest
        let reply = render_line(encode_reply(grammar_tool_answer(tokens, entry.query)))
        valid = str_eq(reply, entry.reply) == 1
        nil
      }
    }
  }
  valid
}

fn stage_cache_replays(
  record: GrammarStageCacheRecord,
  table: i64,
  source: i64,
  registrations: RegistrationScope
) -> bool {
  host_types.run(
    table,
    source,
    registrations,
    () => stage_cache_replay_entries(record.transcript.entries, grammar_tool_tokens())
  )
}

fn stage_cache_observed_current(inputs: List<ToolObservedInput>) -> bool {
  with file_read_handler() {
    let mut remaining = inputs
    let mut current = true
    while current and not remaining.is_empty() {
      match remaining {
        Nil -> nil
        Cons(input, rest) -> {
          remaining = rest
          current = match input.outcome {
            ToolObservedFailure(_) -> false
            ToolObservedContent(size, digest) -> match file.read_all(input.path, input.limit) {
              Err(_) -> false
              Ok(content) -> content.len() == size and str_eq(content_digest(content), digest) ==
                1
            }
          }
          nil
        }
      }
    }
    current
  }
}

fn stage_cache_artifact(
  artifact: ToolStagedArtifact,
  record: GrammarStageCacheRecord
) -> Option<GrammarStagedArtifact> {
  if artifact.budget > byte_ceiling() or record.store == "" { None<GrammarStagedArtifact>() }
  else {
    match path.from_utf8(record.store) {
      Err(_) -> None<GrammarStagedArtifact>()
      Ok(store_path) -> with file_read_handler() {
        match file.read_all(store_path, artifact.budget) {
          Err(_) -> None<GrammarStagedArtifact>()
          Ok(content) -> if content.len() != artifact.size or
            str_eq(content_digest(content), artifact.content) == 0 {
              None<GrammarStagedArtifact>()
            } else {
              Some<GrammarStagedArtifact>(
                GrammarStagedArtifact {
                  content: artifact.content,
                  size: artifact.size,
                  budget: artifact.budget,
                  bytes: content,
                  facts: artifact.facts,
                  observed_inputs: record.response.observed_inputs,
                  store: record.store,
                  host_transcript: transcript_digest(record.transcript)
                }
              )
            }
        }
      }
    }
  }
}

fn stage_cache_outcome(
  identity: GrammarStageCacheIdentity,
  record: GrammarStageCacheRecord,
  request: ToolRequest,
  table: i64,
  source: i64,
  registrations: RegistrationScope
) -> Option<GrammarStageOutcome> {
  if str_eq(record.transcript.request, identity.request) == 0 or
    not same_grammar(record.response.grammar, request.grammar) or
    not stage_cache_observed_current(record.response.observed_inputs) or
    not stage_cache_replays(record, table, source, registrations) {
      None<GrammarStageOutcome>()
    } else {
      let digest = transcript_digest(record.transcript)
      match request.operation {
        ToolOperationCheck -> match record.response.check {
          ToolChecked -> Some<GrammarStageOutcome>(
            GrammarStageValidated(
              GrammarValidatedStage {
                observed_inputs: record.response.observed_inputs,
                host_transcript: digest
              }
            )
          )
          _ -> None<GrammarStageOutcome>()
        }
        ToolOperationStage(_) -> match record.response.stage {
          ToolStaged(artifact) -> match stage_cache_artifact(artifact, record) {
            Some(staged) -> Some<GrammarStageOutcome>(GrammarStageStaged(staged))
            None -> None<GrammarStageOutcome>()
          }
          ToolStagedNothing -> Some<GrammarStageOutcome>(
            GrammarStageValidated(
              GrammarValidatedStage {
                observed_inputs: record.response.observed_inputs,
                host_transcript: digest
              }
            )
          )
          _ -> None<GrammarStageOutcome>()
        }
      }
    }
}

fn stage_cache_lookup(
  identity: GrammarStageCacheIdentity,
  request: ToolRequest,
  table: i64,
  source: i64,
  registrations: RegistrationScope
) -> Option<GrammarStageOutcome> {
  if identity.path.len() == __i64_to_usize(0) { None<GrammarStageOutcome>() }
  else {
    match path.from_utf8(identity.path) {
      Err(_) -> None<GrammarStageOutcome>()
      Ok(record_path) -> with file_read_handler() {
        match file.read_all(record_path, transcript_ceiling() * __i64_to_usize(3)) {
          Err(_) -> None<GrammarStageOutcome>()
          Ok(content) -> match content.to_utf8() {
            Err(_) -> None<GrammarStageOutcome>()
            Ok(text) -> match stage_cache_decode(identity, text) {
              None -> None<GrammarStageOutcome>()
              Some(record) -> stage_cache_outcome(
                identity,
                record,
                request,
                table,
                source,
                registrations
              )
            }
          }
        }
      }
    }
  }
}

fn stage_cache_publish(
  identity: GrammarStageCacheIdentity,
  export: GrammarToolExport,
  target: NativeLinkTarget,
  record: GrammarStageCacheRecord
) -> nil {
  if identity.path.len() > __i64_to_usize(0) and record.transcript.complete and
    stage_cache_observed_current(record.response.observed_inputs) {
      match stage_cache_render(identity, record) {
        None -> nil
        Some(text) -> {
          stage_cache_ensure_directory(target, export)
          publish_file(identity.path, __str_ptr(text), __str_len(text), 420)
          nil
        }
      }
    } else { nil }
}

--- Stage one site: check the source against the host module's types and,
--- for a typed-plan export, drive the export's staging into a private sink
--- directory, verify what arrived against what the driver reported, and
--- store the bytes content-addressed. The sink directory is removed on
--- every path. `sequence` distinguishes sites within one build.
pub(package) fn grammar_tool_stage(
  product: str,
  export: GrammarToolExport,
  source_name: str,
  source_text: str,
  context: ToolContext,
  target: NativeLinkTarget,
  table: i64,
  source: i64,
  registrations: RegistrationScope,
  sequence: i64,
  deadline: Instant
) -[Proc]> GrammarStageOutcome {
  let grammar = grammar_tool_identity(export)
  match export.capability {
    StagingValidateOnly -> {
      let request = ToolRequest {
        grammar: grammar,
        source_name: source_name,
        source_text: source_text,
        context: context,
        operation: ToolOperationCheck
      }
      let cache_identity = stage_cache_identity(product, export, target, request)
      match stage_cache_lookup(cache_identity, request, table, source, registrations) {
        Some(cached) -> cached
        None -> match grammar_tool_exchange_recorded_with_host(
          product,
          request,
          request,
          table,
          source,
          registrations,
          deadline
        ) {
          GrammarToolRecordedFailed(failure) -> GrammarStageFailed(failure)
          GrammarToolRecordedAnswered(response, transcript) -> match response.check {
            ToolChecked -> {
              stage_cache_publish(
                cache_identity,
                export,
                target,
                GrammarStageCacheRecord {
                  transcript: transcript,
                  response: response,
                  store: ""
                }
              )
              GrammarStageValidated(
                GrammarValidatedStage {
                  observed_inputs: response.observed_inputs,
                  host_transcript: transcript_digest(transcript)
                }
              )
            }
            _ -> GrammarStageRefused(response)
          }
        }
      }
    }
    StagingTypedPlan -> {
      let semantic_request = ToolRequest {
        grammar: grammar,
        source_name: source_name,
        source_text: source_text,
        context: context,
        operation: ToolOperationStage(
          ToolStageTarget {
            capability: StagingTypedPlan,
            platform: native_link_target_name(target),
            sink: path.from_utf8("artifact").unwrap()
          }
        )
      }
      let cache_identity = stage_cache_identity(product, export, target, semantic_request)
      match stage_cache_lookup(
        cache_identity,
        semantic_request,
        table,
        source,
        registrations
      ) {
        Some(cached) -> cached
        None -> match stage_sink_directory(sequence) {
          Err(code) -> GrammarStageSinkUnavailable(code)
          Ok(directory) -> {
            let outcome = match path.from_utf8(directory) {
              Err(_) -> GrammarStageSinkUnavailable(22)
              Ok(sink) -> {
                let request = semantic_request.{
                  operation: ToolOperationStage(
                    ToolStageTarget {
                      capability: StagingTypedPlan,
                      platform: native_link_target_name(target),
                      sink: sink
                    }
                  )
                }
                match grammar_tool_exchange_recorded_with_host(
                  product,
                  request,
                  semantic_request,
                  table,
                  source,
                  registrations,
                  deadline
                ) {
                  GrammarToolRecordedFailed(failure) -> GrammarStageFailed(failure)
                  GrammarToolRecordedAnswered(response, transcript) -> match response.stage {
                    ToolStaged(artifact) -> if artifact.budget > byte_ceiling() {
                      GrammarStageVerifyFailed(StagingOverBudget(artifact.budget))
                    } else {
                      match stage_verify(directory, artifact) {
                        Err(failure) -> GrammarStageVerifyFailed(failure)
                        Ok(bytes) -> match stage_store(directory, target, export, artifact) {
                          Err(code) -> GrammarStageStoreFailed(code)
                          Ok(store) -> {
                            let record = GrammarStageCacheRecord {
                              transcript: transcript,
                              response: response,
                              store: store
                            }
                            stage_cache_publish(cache_identity, export, target, record)
                            GrammarStageStaged(
                              GrammarStagedArtifact {
                                content: artifact.content,
                                size: artifact.size,
                                budget: artifact.budget,
                                bytes: bytes,
                                facts: artifact.facts,
                                observed_inputs: response.observed_inputs,
                                store: store,
                                host_transcript: transcript_digest(transcript)
                              }
                            )
                          }
                        }
                      }
                    }
                    ToolStagedNothing -> {
                      stage_cache_publish(
                        cache_identity,
                        export,
                        target,
                        GrammarStageCacheRecord {
                          transcript: transcript,
                          response: response,
                          store: ""
                        }
                      )
                      GrammarStageValidated(
                        GrammarValidatedStage {
                          observed_inputs: response.observed_inputs,
                          host_transcript: transcript_digest(transcript)
                        }
                      )
                    }
                    _ -> GrammarStageRefused(response)
                  }
                }
              }
            }
            stage_sink_cleanup(directory)
            outcome
          }
        }
      }
    }
  }
}

--- Render a staging outcome that is not an artifact for tool output.
pub(package) fn grammar_stage_failure_message(outcome: GrammarStageOutcome) -> str {
  match outcome {
    GrammarStageStaged(_) -> "staged"
    GrammarStageValidated(_) -> "validated"
    GrammarStageRefused(response) -> match response.stage {
      ToolStageRefusedParseNotAccepted -> "the grammar did not accept the source"
      ToolStageRefusedCheckRejected -> "the grammar rejected the source"
      ToolStageRefusedNoStaging -> "the export does not stage typed plans"
      ToolStageRefusedNoTooling -> "the export has no tooling module"
      ToolStageContextUnavailable -> "the grammar's context was unavailable"
      ToolStageContextUnsupported(_) -> "the grammar does not stage against the requested context"
      ToolStageUnsupportedTarget -> "the grammar cannot stage for this target"
      ToolStageSinkRefused(name) -> str_concat("the sink refused a chunk: ", name)
      _ -> match response.check {
        ToolCheckRejected -> "the grammar rejected the source"
        ToolCheckRefusedParseNotAccepted -> "the grammar did not accept the source"
        ToolCheckUnsupported(_) -> "the grammar does not check against the requested context"
        ToolContextUnavailable -> "the grammar's context was unavailable"
        ToolCheckRefusedNoTooling -> "the export has no tooling module"
        _ -> "the driver withheld the site"
      }
    }
    GrammarStageFailed(failure) -> grammar_tool_failure_message(failure)
    GrammarStageVerifyFailed(failure) -> match failure {
      StagingDirectoryUnreadable(_) -> "the sink directory could not be listed"
      StagingArtifactMissing -> "the driver reported an artifact it did not write"
      StagingExtraEntry(_) -> "the driver wrote more than its artifact into the sink"
      StagingArtifactUnreadable(_) -> "the artifact could not be read back"
      StagingOverBudget(_) -> "the artifact exceeds the byte budget"
      StagingSizeMismatch(_, _) -> "the artifact's size is not the size the driver reported"
      StagingDigestMismatch(_, _) -> "the artifact's digest is not the digest the driver reported"
    }
    GrammarStageSinkUnavailable(code) -> str_concat(
      "the staging directory could not be created (error ",
      str_concat(int_text(code), ")")
    )
    GrammarStageStoreFailed(code) -> str_concat(
      "the artifact could not be stored (error ",
      str_concat(int_text(code), ")")
    )
  }
}
