-- compiler/grammar/tree_sitter.weft -- Tree-sitter interpretation of SyntaxGrammar
--
-- This module owns no Weft productions. It renders the development-only typed
-- graph into Tree-sitter's JavaScript grammar DSL.

use compiler/grammar/syntax.{*}
use stdlib/option.{None, Option, Some}
use stdlib/string/builder as builder
use stdlib/string/builder.{Builder}

fn tree_sitter_js_escape(byte: u8) -> str? {
  if byte == 39 { "\\'" }
  else if byte == 92 { "\\\\" }
  else if byte == 10 { "\\n" }
  else if byte == 13 { "\\r" }
  else if byte == 9 { "\\t" }
  else { nil }
}

-- Escapes are ASCII, so every copied run starts and ends on a scalar boundary.
fn tree_sitter_append_js_string(out: borrow mut Builder, value: str) -> nil {
  out.append("'")
  let mut run: usize = 0
  let mut i: usize = 0
  while i < value.len() {
    match value.byte_at(i) {
      Some(byte) -> match tree_sitter_js_escape(byte) {
        escape: str -> {
          out.append_range(value, run, i)
          out.append(escape)
          run = i + 1
        }
        nil -> nil
      }
      None -> nil
    }
    i = i + 1
  }
  out.append_range(value, run, value.len())
  out.append("'")
}

fn tree_sitter_append_expr(out: borrow mut Builder, expr: SyntaxExpr) -> nil {
  match expr {
    SyntaxLiteral(value) -> tree_sitter_append_js_string(out, value)
    SyntaxPattern(value) -> { out.append("/") out.append(value) out.append("/") }
    SyntaxRustPattern(value) -> {
      out.append("new RustRegex(")
      tree_sitter_append_js_string(out, value)
      out.append(")")
    }
    SyntaxReference(name) -> { out.append("$.") out.append(name) }
    SyntaxNamedAlias(value, name) -> {
      out.append("alias(")
      tree_sitter_append_expr(out, value)
      out.append(", $.")
      out.append(name)
      out.append(")")
    }
    SyntaxSequence(items) -> {
      out.append("seq(")
      tree_sitter_append_exprs(out, items)
      out.append(")")
    }
    SyntaxChoice(items) -> {
      out.append("choice(")
      tree_sitter_append_exprs(out, items)
      out.append(")")
    }
    SyntaxRepeat(value) -> {
      out.append("repeat(")
      tree_sitter_append_expr(out, value)
      out.append(")")
    }
    SyntaxRepeatOne(value) -> {
      out.append("repeat1(")
      tree_sitter_append_expr(out, value)
      out.append(")")
    }
    SyntaxOptional(value) -> {
      out.append("optional(")
      tree_sitter_append_expr(out, value)
      out.append(")")
    }
    SyntaxField(name, value) -> {
      out.append("field(")
      tree_sitter_append_js_string(out, name)
      out.append(", ")
      tree_sitter_append_expr(out, value)
      out.append(")")
    }
    SyntaxPrecedence(level, value) -> {
      out.append("prec(")
      out.append(level.display())
      out.append(", ")
      tree_sitter_append_expr(out, value)
      out.append(")")
    }
    SyntaxPrecedenceLeft(level, value) -> {
      out.append("prec.left(")
      out.append(level.display())
      out.append(", ")
      tree_sitter_append_expr(out, value)
      out.append(")")
    }
    SyntaxPrecedenceRight(value) -> {
      out.append("prec.right(")
      tree_sitter_append_expr(out, value)
      out.append(")")
    }
    SyntaxPrecedenceRightAt(level, value) -> {
      out.append("prec.right(")
      out.append(level.display())
      out.append(", ")
      tree_sitter_append_expr(out, value)
      out.append(")")
    }
    SyntaxToken(value) -> {
      out.append("token(")
      tree_sitter_append_expr(out, value)
      out.append(")")
    }
    SyntaxTokenImmediate(value) -> {
      out.append("token.immediate(")
      tree_sitter_append_expr(out, value)
      out.append(")")
    }
    SyntaxCommaSeparated(value) -> {
      out.append("commaSep(")
      tree_sitter_append_expr(out, value)
      out.append(")")
    }
    SyntaxCommaSeparatedOne(value) -> {
      out.append("commaSep1(")
      tree_sitter_append_expr(out, value)
      out.append(")")
    }
  }
}

fn tree_sitter_append_exprs(out: borrow mut Builder, items: SyntaxExprList) -> nil {
  let mut current = items
  let mut first = true
  let mut done = false
  while not done {
    match current {
      SyntaxExprNil -> { done = true }
      SyntaxExprCons(expr, rest) -> {
        if not first { out.append(", ") } else { first = false }
        tree_sitter_append_expr(out, expr)
        current = rest
      }
    }
  }
}

fn tree_sitter_append_conflicts(out: borrow mut Builder, conflicts: SyntaxConflictList) -> nil {
  let mut current = conflicts
  let mut done = false
  while not done {
    match current {
      SyntaxConflictNil -> { done = true }
      SyntaxConflictCons(items, rest) -> {
        out.append("    [")
        tree_sitter_append_exprs(out, items)
        out.append("],\n")
        current = rest
      }
    }
  }
}

fn tree_sitter_append_rules(out: borrow mut Builder, rules: SyntaxRuleList) -> nil {
  let mut current = rules
  let mut done = false
  while not done {
    match current {
      SyntaxRuleNil -> { done = true }
      SyntaxRuleCons(SyntaxRule(name, body), rest) -> {
        out.append("    ")
        out.append(name)
        out.append(": $ => ")
        tree_sitter_append_expr(out, body)
        out.append(",\n")
        current = rest
      }
    }
  }
}

pub(package) fn render(grammar: SyntaxGrammar) -> str {
  let mut out = builder.with_capacity(65536)
  match grammar {
    SyntaxGrammar(name, extras, word, supertypes, conflicts, rules) -> {
      out.append("/// <reference types=\"tree-sitter-cli/dsl\" />\n")
      out.append("// @generated by tools/tree_sitter_grammar.weft; do not edit.\n\n")
      out.append("module.exports = grammar({\n  name: ")
      tree_sitter_append_js_string(out, name)
      out.append(",\n  extras: $ => [")
      tree_sitter_append_exprs(out, extras)
      out.append("],\n")
      out.append("  word: $ => ")
      tree_sitter_append_expr(out, word)
      out.append(",\n")
      out.append("  supertypes: $ => [")
      tree_sitter_append_exprs(out, supertypes)
      out.append("],\n")
      out.append("  conflicts: $ => [\n")
      tree_sitter_append_conflicts(out, conflicts)
      out.append("  ],\n")
      out.append("  rules: {\n")
      tree_sitter_append_rules(out, rules)
      out.append("  },\n});\n\n")
      out.append("function commaSep(rule) { return optional(commaSep1(rule)); }\n")
      out.append(
        "function commaSep1(rule) { return seq(rule, repeat(seq(',', rule)), optional(',')); }\n"
      )
    }
  }
  out.finish()
}
