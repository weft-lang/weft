-- Compile-time context acquisition for registered embedded grammars.

use compiler/comptime/artifact.{ComptimeArtifactInputError}
use compiler/comptime/evaluate.{comptime_evaluate_file_reads}
use compiler/grammar/registry.{GrammarModuleSyntax, GrammarModuleSqlSyntax, GrammarModuleEinsumSyntax}
use compiler/backend/link.{NativeArtifactCompileTimeInputs}
use stdlib/diagnostic/schema.{Diagnose}
use stdlib/grammar.{CheckResult, Checked, CheckRejected}
use stdlib/grammar/sql/check as sql_check
use stdlib/grammar/sql/plan.{SqlPlan}
use stdlib/grammar/sql/syntax.{SqlSyntax}
use stdlib/grammar/sql/schema as sql_schema
use stdlib/grammar/sql/schema.{SqlSchemaError}
use stdlib/grammar/sql/schema_typecheck as schema_typecheck
use stdlib/grammar/sql/schema_typecheck.{SqlSchemaIdentity}
use stdlib/grammar/einsum/check as einsum_check
use stdlib/grammar/einsum/context as einsum_context
use stdlib/grammar/einsum/context.{EinsumContextError}
use stdlib/grammar/einsum/context_typecheck as einsum_context_typecheck
use stdlib/grammar/einsum/context_typecheck.{EinsumContextIdentity}
use stdlib/grammar/einsum/plan.{EinsumPlan}
use stdlib/grammar/einsum/syntax.{EinsumSyntax}
use stdlib/option.{Option, Some, None}
use stdlib/path.{Path}
use stdlib/result.{Result, Ok, Err}

-- A checked plan whose identity domain was acquired at compile time.
pub(package) type GrammarComptimePlan {
  GrammarComptimeSqlPlan(SqlPlan<SqlSchemaIdentity>),
  GrammarComptimeEinsumPlan(EinsumPlan<EinsumContextIdentity>)
}

-- A grammar check and the exact compile-time inputs used by its context.
pub(package) type GrammarComptimeCheck {
  result: CheckResult<GrammarComptimePlan>,
  inputs: NativeArtifactCompileTimeInputs
}

-- A failure to acquire a registered grammar's compile-time checking context.
pub(package) type GrammarComptimeError {
  GrammarComptimeInputFailed(ComptimeArtifactInputError),
  GrammarComptimeSqlSchemaRejected(SqlSchemaError, NativeArtifactCompileTimeInputs),
  GrammarComptimeEinsumContextRejected(EinsumContextError, NativeArtifactCompileTimeInputs)
}

-- Stable, grammar-neutral transport reason for a context acquisition failure.
pub(package) fn grammar_comptime_error_name(error: GrammarComptimeError) -> str {
  match error {
    GrammarComptimeInputFailed(_) -> "input_failed"
    GrammarComptimeSqlSchemaRejected(_, _) -> "context_rejected"
    GrammarComptimeEinsumContextRejected(_, _) -> "context_rejected"
  }
}

-- Preserve inputs that were successfully observed before grammar-specific
-- context validation rejected their value.
pub(package) fn grammar_comptime_error_inputs(error: GrammarComptimeError) -> Option<NativeArtifactCompileTimeInputs> {
  match error {
    GrammarComptimeSqlSchemaRejected(_, inputs) -> Some<NativeArtifactCompileTimeInputs>(inputs)
    GrammarComptimeEinsumContextRejected(_, inputs) -> Some<NativeArtifactCompileTimeInputs>(inputs)
    _ -> None<NativeArtifactCompileTimeInputs>()
  }
}

fn grammar_comptime_check_einsum(syntax: EinsumSyntax, path: Path, limit: usize) -[Diagnose]> Result<GrammarComptimeCheck, GrammarComptimeError> {
  match comptime_evaluate_file_reads(() => einsum_context.load(path, limit)) {
    Err(error) -> Err<GrammarComptimeCheck, GrammarComptimeError>(GrammarComptimeInputFailed(error))
    Ok(evaluation) -> match evaluation.value {
      Err(error) -> Err<GrammarComptimeCheck, GrammarComptimeError>(GrammarComptimeEinsumContextRejected(error, evaluation.inputs))
      Ok(context) -> {
        let checked = with einsum_context_typecheck(context) {
          einsum_check.checker<EinsumContextIdentity>(einsum_context_typecheck.operand_specs(context)).check(syntax)
        }
        let result = match checked {
          Checked(plan) -> Checked<GrammarComptimePlan>(GrammarComptimeEinsumPlan(plan))
          CheckRejected -> CheckRejected<GrammarComptimePlan>()
        }
        Ok<GrammarComptimeCheck, GrammarComptimeError>(GrammarComptimeCheck {
          result: result,
          inputs: evaluation.inputs
        })
      }
    }
  }
}

fn grammar_comptime_check_sql(syntax: SqlSyntax, path: Path, limit: usize) -[Diagnose]> Result<GrammarComptimeCheck, GrammarComptimeError> {
  match comptime_evaluate_file_reads(() => sql_schema.load(path, limit)) {
    Err(error) -> Err<GrammarComptimeCheck, GrammarComptimeError>(GrammarComptimeInputFailed(error))
    Ok(evaluation) -> match evaluation.value {
      Err(error) -> Err<GrammarComptimeCheck, GrammarComptimeError>(GrammarComptimeSqlSchemaRejected(error, evaluation.inputs))
      Ok(schema) -> {
        let checked = with schema_typecheck(schema) {
          sql_check.checker<SqlSchemaIdentity>().check(syntax)
        }
        let result = match checked {
          Checked(plan) -> Checked<GrammarComptimePlan>(GrammarComptimeSqlPlan(plan))
          CheckRejected -> CheckRejected<GrammarComptimePlan>()
        }
        Ok<GrammarComptimeCheck, GrammarComptimeError>(GrammarComptimeCheck {
          result: result,
          inputs: evaluation.inputs
        })
      }
    }
  }
}

-- Check one registered grammar using context acquired by ordinary compiled
-- Weft code from a bounded file. Module-specific context remains inside the
-- registry boundary; callers consume only the closed typed result.
pub(package) fn grammar_module_check_file_context(syntax: GrammarModuleSyntax, path: Path, limit: usize) -[Diagnose]> Result<GrammarComptimeCheck, GrammarComptimeError> {
  match syntax {
    GrammarModuleSqlSyntax(sql_syntax) -> grammar_comptime_check_sql(sql_syntax, path, limit)
    GrammarModuleEinsumSyntax(einsum_syntax) -> grammar_comptime_check_einsum(einsum_syntax, path, limit)
  }
}
