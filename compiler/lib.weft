-- lib.weft — shared utilities for the Weft compiler
-- Runtime primitives, debug output, char classification,
-- string comparison, node/list data structures, operator precedence

use "runtime/syscall.weft"
use "runtime/memory.weft"
use "runtime/alloc.weft"
use "runtime/buffer.weft"

-- Process management is in stdlib/process.weft (linked via GOT + ld).
-- The compiler itself stays static for bootstrap stability.

-- Read all bytes from an open file descriptor. Returns {ptr, len} pair.
fn read_fd_all(fd: i64) -> i64 {
  let chunk_size = 65536
  let scratch = alloc_words(chunk_size / 8)
  let out = buf_new(chunk_size)
  let mut done = 0
  while done == 0 {
    let n = sys_read(fd, scratch, chunk_size)
    if n > 0 {
      bscopy(out, scratch, n, 0)
      if n < chunk_size { done = 1 } else { 0 }
    } else {
      done = 1
    }
  }
  let result = alloc_words(2)
  mem_store64_at(result, 0, buf_ptr(out))
  mem_store64_at(result, 8, buf_len(out))
  result
}

fn read_stdin_all() -> i64 {
  read_fd_all(0)
}

-- Read an entire file into a bump-allocated buffer. Returns {ptr, len} pair.
fn read_file(path_str: i64) -> i64 {
  -- Need null-terminated path for sys_open
  let path_ptr = __str_ptr(path_str)
  let path_len = __str_len(path_str)
  let path_buf = alloc_zeroed(path_len + 1)
  mem_copy(path_buf, path_ptr, path_len)
  mem_store8_at(path_buf, path_len, 0)
  -- Open file (O_RDONLY = 0)
  let fd = sys_open(path_buf, 0, 0)
  let result = alloc_words(2)
  if fd < 0 {
    mem_store64_at(result, 0, 0)
    mem_store64_at(result, 8, 0)
  } else {
    let file = read_fd_all(fd)
    sys_close(fd)
    mem_store64_at(result, 0, mem_load64_at(file, 0))
    mem_store64_at(result, 8, mem_load64_at(file, 8))
  }
  result
}

-- ======================================================================
-- Print helpers (stderr for diagnostics)
-- ======================================================================

fn eprint(msg: str) -> i64 {
  sys_write(2, __str_ptr(msg), __str_len(msg))
}
fn eprint_nl() -> i64 {
  let b = alloc_zeroed(1)
  mem_store8_at(b, 0, 10)
  sys_write(2, b, 1)
}
-- Print source location: "line N, col M: "
fn eprint_span(src: i64, offset: i64) -> i64 {
  let mut i = 0
  let mut line = 1
  let mut col = 1
  while i < offset {
    if mem_load8_at(src, i) == 10 { line = line + 1 col = 1 }
    else { col = col + 1 }
    i = i + 1
  }
  eprint("line ")
  eprint_i(line)
  eprint(", col ")
  eprint_i(col)
  eprint(": ")
}

fn eprint_i(n: i64) -> i64 {
  if n < 0 { eprint("-") eprint_i(0 - n) }
  else {
    if n < 10 {
      let b = alloc_words(1)
      mem_store8_at(b, 0, 48 + n)
      sys_write(2, b, 1)
    } else {
      eprint_i(n / 10)
      let b = alloc_words(1)
      mem_store8_at(b, 0, 48 + n - n / 10 * 10)
      sys_write(2, b, 1)
    }
  }
}

-- ======================================================================
-- Character classification
-- ======================================================================

fn is_digit(ch: i64) -> i64 {
  if ch >= 48 { if ch <= 57 { 1 } else { 0 } } else { 0 }
}
fn is_alpha(ch: i64) -> i64 {
  if ch == 95 { 1 }
  else { if ch >= 65 { if ch <= 90 { 1 }
  else { if ch >= 97 { if ch <= 122 { 1 } else { 0 } } else { 0 } } }
  else { 0 } }
}
fn is_alnum(ch: i64) -> i64 {
  if is_alpha(ch) == 1 { 1 } else { is_digit(ch) }
}
fn is_ws(ch: i64) -> i64 {
  match ch {
    32 -> 1
    10 -> 1
    13 -> 1
    9 -> 1
    _ -> 0
  }
}

fn decimal_span_value_wrapping(src: i64, start: i64, len: i64) -> i64 {
  let mut acc = 0
  let mut i = 0
  while i < len {
    acc = acc * 10 + mem_load8_at(src, start + i) - 48
    i = i + 1
  }
  acc
}

fn decimal_span_le_str(src: i64, start: i64, len: i64, max: str) -> i64 {
  if len <= 0 { 0 }
  else {
    let mut skip = 0
    while skip < len and mem_load8_at(src, start + skip) == 48 {
      skip = skip + 1
    }
    let eff_start = if skip >= len { start + len - 1 } else { start + skip }
    let eff_len = if skip >= len { 1 } else { len - skip }
    let max_len = __str_len(max)
    if eff_len < max_len { 1 }
    else { if eff_len > max_len { 0 }
    else {
      let max_ptr = __str_ptr(max)
      let mut i = 0
      let mut done = 0
      let mut ok = 1
      while done == 0 {
        if i >= eff_len { done = 1 }
        else {
          let a = mem_load8_at(src, eff_start + i)
          let b = mem_load8_at(max_ptr, i)
          if a < b { ok = 1 done = 1 }
          else { if a > b { ok = 0 done = 1 }
          else { i = i + 1 } }
        }
      }
      ok
    } }
  }
}

-- ======================================================================
-- String comparison (byte-by-byte against source)
-- ======================================================================

fn src_eq_at(src: i64, start: i64, p: i64, i: i64, l: i64) -> i64 {
  if i >= l { 1 }
  else {
    let a = mem_load8(src + start + i)
    let b = mem_load8(p + i)
    if a != b { 0 } else { src_eq_at(src, start, p, i + 1, l) }
  }
}
fn src_eq(src: i64, start: i64, len: i64, s: str) -> i64 {
  let p = __str_ptr(s)
  let l = __str_len(s)
  if len != l { 0 }
  else { src_eq_at(src, start, p, 0, l) }
}

-- ======================================================================
-- AST nodes — bump-allocated tagged records
-- ======================================================================
-- Node format: [tag, field1, field2, field3, field4] (5 words = 40 bytes)
-- Tags: 1=IntLit(raw, span_start, span_len) 2=Ident 3=BinOp 4=Call 5=If 6=Let 7=Block 8=FnDecl

fn node_new(tag: i64, f1: i64, f2: i64, f3: i64, f4: i64) -> i64 {
  let n = alloc_words(5)
  mem_store64_at(n, 0, tag)
  mem_store64_at(n, 8, f1)
  mem_store64_at(n, 16, f2)
  mem_store64_at(n, 24, f3)
  mem_store64_at(n, 32, f4)
  n
}
fn node_tag(n: i64) -> i64 { mem_load64_at(n, 0) }
fn node_f1(n: i64) -> i64 { mem_load64_at(n, 8) }
fn node_f2(n: i64) -> i64 { mem_load64_at(n, 16) }
fn node_f3(n: i64) -> i64 { mem_load64_at(n, 24) }
fn node_f4(n: i64) -> i64 { mem_load64_at(n, 32) }

-- List of AST nodes (for fn params, call args, block stmts)
fn nlist_new() -> i64 {
  -- The fourth header word is a lazily built lookup index slot, used
  -- only by the decl-list lookups (2m); every other consumer ignores it.
  let h = alloc_words(4)
  let d = alloc_words(64)
  mem_store64_at(h, 0, d)
  mem_store64_at(h, 8, 0)
  mem_store64_at(h, 16, 64)
  mem_store64_at(h, 24, 0)
  h
}
fn nlist_add(l: i64, v: i64) -> i64 {
  let d = mem_load64_at(l, 0)
  let n = mem_load64_at(l, 8)
  let cap = mem_load64_at(l, 16)
  if n >= cap {
    let new_cap = cap * 2
    let new_d = alloc_words(new_cap)
    mem_copy(new_d, d, n * 8)
    mem_store64_at(l, 0, new_d)
    mem_store64_at(l, 16, new_cap)
    mem_store64_at(new_d, n * 8, v)
    mem_store64_at(l, 8, n + 1)
    l
  } else {
    mem_store64_at(d, n * 8, v)
    mem_store64_at(l, 8, n + 1)
    l
  }
}
fn nlist_get(l: i64, i: i64) -> i64 {
  let d = mem_load64_at(l, 0)
  mem_load64_at(d, i * 8)
}
fn nlist_len(l: i64) -> i64 { mem_load64_at(l, 8) }
fn nlist_set_len(l: i64, len: i64) -> i64 { mem_store64_at(l, 8, len) }

fn pack(node: i64, pos: i64) -> i64 {
  let r = alloc_words(2)
  mem_store64_at(r, 0, node)
  mem_store64_at(r, 8, pos)
  r
}
fn unpack_node(r: i64) -> i64 { mem_load64_at(r, 0) }
fn unpack_pos(r: i64) -> i64 { mem_load64_at(r, 8) }

fn op_prec(op_id: i64) -> i64 {
  -- Precedence (higher = tighter binding):
  -- *=3 /=4 %=11: prec 12 (multiplicative)
  -- +=1 -=2: prec 11 (additive)
  -- bshl=17 bshr=18: prec 10 (bitwise shift)
  -- band=14: prec 9
  -- bxor=16: prec 8
  -- bor=15: prec 7
  -- ==5 !=6 <7 >8 <=9 >=10: prec 6 (comparison)
  -- and=12: prec 5
  -- or=13: prec 4
  match op_id {
    1 -> 11
    2 -> 11
    3 -> 12
    4 -> 12
    5 -> 6
    6 -> 6
    7 -> 6
    8 -> 6
    9 -> 6
    10 -> 6
    11 -> 12
    12 -> 5
    13 -> 4
    14 -> 9
    15 -> 7
    16 -> 8
    17 -> 10
    18 -> 10
    19 -> 3
    20 -> 2
    _ -> 10
  }
}
