-- lib.weft — shared utilities for the Weft compiler
-- Syscall wrappers, memory, buffers, debug output, char classification,
-- string comparison, node/list data structures, operator precedence

-- ======================================================================
-- Syscall wrappers
-- ======================================================================

fn sys_write(fd: i64, buf: i64, len: i64) -> i64 {
  __syscall(4, fd, buf, len, 0, 0, 0)
}
fn sys_read(fd: i64, buf: i64, len: i64) -> i64 {
  __syscall(3, fd, buf, len, 0, 0, 0)
}
fn sys_open(path: i64, flags: i64, mode: i64) -> i64 {
  __syscall(5, path, flags, mode, 0, 0, 0)
}
fn sys_close(fd: i64) -> i64 {
  __syscall(6, fd, 0, 0, 0, 0, 0)
}

-- Copy n bytes from src to dst
fn mem_copy(dst: i64, src: i64, n: i64) -> i64 {
  let mut i = 0
  while i < n {
    __mem_store8(dst + i, __mem_load8(src + i))
    i = i + 1
  }
  0
}

-- Read an entire file into a bump-allocated buffer. Returns {ptr, len} pair.
fn read_file(path_str: i64) -> i64 {
  -- Need null-terminated path for sys_open
  let path_ptr = __str_ptr(path_str)
  let path_len = __str_len(path_str)
  let path_buf = __bump_alloc(path_len + 1)
  mem_copy(path_buf, path_ptr, path_len)
  __mem_store8(path_buf + path_len, 0)
  -- Open file (O_RDONLY = 0)
  let fd = sys_open(path_buf, 0, 0)
  let result = __bump_alloc(16)
  if fd < 0 {
    __mem_store64(result, 0)
    __mem_store64(result + 8, 0)
  } else {
    let buf = __bump_alloc(262144)
    let n = sys_read(fd, buf, 262144)
    sys_close(fd)
    __mem_store64(result, buf)
    __mem_store64(result + 8, n)
  }
  result
}

-- ======================================================================
-- Buffer primitives (byte buffer for building output)
-- ======================================================================

fn buf_new(cap: i64) -> i64 {
  let h = __bump_alloc(24)
  let d = __bump_alloc(cap)
  __mem_store64(h, d)
  __mem_store64(h + 8, 0)
  __mem_store64(h + 16, cap)
  h
}
fn buf_len(b: i64) -> i64 { __mem_load64(b + 8) }
fn buf_ptr(b: i64) -> i64 { __mem_load64(b) }
fn bu8(b: i64, v: i64) -> i64 {
  let d = __mem_load64(b)
  let l = __mem_load64(b + 8)
  let cap = __mem_load64(b + 16)
  if l >= cap {
    eprint("error: buffer overflow (")
    eprint_i(cap)
    eprint(" bytes)\n")
    b
  } else {
    __mem_store8(d + l, v)
    __mem_store64(b + 8, l + 1)
    b
  }
}
fn bu32(b: i64, v: i64) -> i64 {
  bu8(b, v - v / 256 * 256)
  bu8(b, v / 256 - v / 65536 * 256)
  bu8(b, v / 65536 - v / 16777216 * 256)
  bu8(b, v / 16777216 - v / 4294967296 * 256)
}
fn bu64(b: i64, v: i64) -> i64 {
  bu32(b, v - v / 4294967296 * 4294967296)
  bu32(b, v / 4294967296)
}
-- Copy 8 words (64 bytes) per call, then recurse for rest
fn bscopy64(dst: i64, src_p: i64, off: i64, rem: i64) -> i64 {
  if rem < 64 { off }
  else {
    __mem_store64(dst + off, __mem_load64(src_p + off))
    __mem_store64(dst + off + 8, __mem_load64(src_p + off + 8))
    __mem_store64(dst + off + 16, __mem_load64(src_p + off + 16))
    __mem_store64(dst + off + 24, __mem_load64(src_p + off + 24))
    __mem_store64(dst + off + 32, __mem_load64(src_p + off + 32))
    __mem_store64(dst + off + 40, __mem_load64(src_p + off + 40))
    __mem_store64(dst + off + 48, __mem_load64(src_p + off + 48))
    __mem_store64(dst + off + 56, __mem_load64(src_p + off + 56))
    bscopy64(dst, src_p, off + 64, rem - 64)
  }
}
-- Copy remaining bytes (< 64) one at a time
fn bscopy_tail(dst: i64, src_p: i64, off: i64, rem: i64) -> i64 {
  if rem <= 0 { 0 }
  else {
    __mem_store8(dst + off, __mem_load8(src_p + off))
    bscopy_tail(dst, src_p, off + 1, rem - 1)
  }
}
fn bscopy(b: i64, p: i64, l: i64, i: i64) -> i64 {
  let dst = __mem_load64(b)
  let cur = __mem_load64(b + 8)
  let total = l - i
  let done = bscopy64(dst + cur, p + i, 0, total)
  bscopy_tail(dst + cur, p + i, done, total - done)
  __mem_store64(b + 8, cur + total)
  b
}
fn bstr(b: i64, s: str) -> i64 {
  let p = __str_ptr(s)
  let l = __str_len(s)
  bscopy(b, p, l, 0)
}
-- Fill 64 bytes of zeros per call, then recurse
fn bfill64(d: i64, off: i64, rem: i64) -> i64 {
  if rem < 64 { off }
  else {
    __mem_store64(d + off, 0)
    __mem_store64(d + off + 8, 0)
    __mem_store64(d + off + 16, 0)
    __mem_store64(d + off + 24, 0)
    __mem_store64(d + off + 32, 0)
    __mem_store64(d + off + 40, 0)
    __mem_store64(d + off + 48, 0)
    __mem_store64(d + off + 56, 0)
    bfill64(d, off + 64, rem - 64)
  }
}
fn bfill_tail(d: i64, off: i64, rem: i64) -> i64 {
  if rem <= 0 { 0 }
  else {
    __mem_store8(d + off, 0)
    bfill_tail(d, off + 1, rem - 1)
  }
}
fn bfill_bulk(d: i64, off: i64, rem: i64) -> i64 {
  let done = bfill64(d, off, rem)
  bfill_tail(d, done, off + rem - done)
}
fn bfill(b: i64, n: i64) -> i64 {
  if n <= 0 { b }
  else {
    let d = __mem_load64(b)
    let l = __mem_load64(b + 8)
    bfill_bulk(d, l, n)
    __mem_store64(b + 8, l + n)
    b
  }
}
fn bpad(b: i64, t: i64) -> i64 {
  let l = buf_len(b)
  if l >= t { b } else { bfill(b, t - l) }
}

-- ======================================================================
-- Print helpers (stderr for diagnostics)
-- ======================================================================

fn eprint(msg: str) -> i64 {
  sys_write(2, __str_ptr(msg), __str_len(msg))
}
fn eprint_nl() -> i64 {
  let b = __bump_alloc(1)
  __mem_store8(b, 10)
  sys_write(2, b, 1)
}
fn eprint_i(n: i64) -> i64 {
  if n < 0 { eprint("-") eprint_i(0 - n) }
  else {
    if n < 10 {
      let b = __bump_alloc(8)
      __mem_store8(b, 48 + n)
      sys_write(2, b, 1)
    } else {
      eprint_i(n / 10)
      let b = __bump_alloc(8)
      __mem_store8(b, 48 + n - n / 10 * 10)
      sys_write(2, b, 1)
    }
  }
}

-- ======================================================================
-- Character classification
-- ======================================================================

fn is_digit(ch: i64) -> i64 {
  if ch >= 48 { if ch <= 57 { 1 } else { 0 } } else { 0 }
}
fn is_alpha(ch: i64) -> i64 {
  if ch == 95 { 1 }
  else { if ch >= 65 { if ch <= 90 { 1 }
  else { if ch >= 97 { if ch <= 122 { 1 } else { 0 } } else { 0 } } }
  else { 0 } }
}
fn is_alnum(ch: i64) -> i64 {
  if is_alpha(ch) == 1 { 1 } else { is_digit(ch) }
}
fn is_ws(ch: i64) -> i64 {
  match ch {
    32 -> 1
    10 -> 1
    13 -> 1
    9 -> 1
    _ -> 0
  }
}

-- ======================================================================
-- String comparison (byte-by-byte against source)
-- ======================================================================

fn src_eq_at(src: i64, start: i64, p: i64, i: i64, l: i64) -> i64 {
  if i >= l { 1 }
  else {
    let a = __mem_load8(src + start + i)
    let b = __mem_load8(p + i)
    if a != b { 0 } else { src_eq_at(src, start, p, i + 1, l) }
  }
}
fn src_eq(src: i64, start: i64, len: i64, s: str) -> i64 {
  let p = __str_ptr(s)
  let l = __str_len(s)
  if len != l { 0 }
  else { src_eq_at(src, start, p, 0, l) }
}

-- ======================================================================
-- AST nodes — bump-allocated tagged records
-- ======================================================================
-- Node format: [tag, field1, field2, field3, field4] (5 words = 40 bytes)
-- Tags: 1=IntLit 2=Ident 3=BinOp 4=Call 5=If 6=Let 7=Block 8=FnDecl

fn node_new(tag: i64, f1: i64, f2: i64, f3: i64, f4: i64) -> i64 {
  let n = __bump_alloc(40)
  __mem_store64(n, tag)
  __mem_store64(n + 8, f1)
  __mem_store64(n + 16, f2)
  __mem_store64(n + 24, f3)
  __mem_store64(n + 32, f4)
  n
}
fn node_tag(n: i64) -> i64 { __mem_load64(n) }
fn node_f1(n: i64) -> i64 { __mem_load64(n + 8) }
fn node_f2(n: i64) -> i64 { __mem_load64(n + 16) }
fn node_f3(n: i64) -> i64 { __mem_load64(n + 24) }
fn node_f4(n: i64) -> i64 { __mem_load64(n + 32) }

-- List of AST nodes (for fn params, call args, block stmts)
fn nlist_new() -> i64 {
  let h = __bump_alloc(24)
  let d = __bump_alloc(16384)
  __mem_store64(h, d)
  __mem_store64(h + 8, 0)
  __mem_store64(h + 16, 2048)
  h
}
fn nlist_add(l: i64, v: i64) -> i64 {
  let d = __mem_load64(l)
  let n = __mem_load64(l + 8)
  let cap = __mem_load64(l + 16)
  if n >= cap {
    eprint("error: list capacity exceeded (")
    eprint_i(cap)
    eprint(")\n")
    l
  } else {
    __mem_store64(d + n * 8, v)
    __mem_store64(l + 8, n + 1)
    l
  }
}
fn nlist_get(l: i64, i: i64) -> i64 {
  let d = __mem_load64(l)
  __mem_load64(d + i * 8)
}
fn nlist_len(l: i64) -> i64 { __mem_load64(l + 8) }

fn pack(node: i64, pos: i64) -> i64 { node * 1000000 + pos }
fn unpack_node(r: i64) -> i64 { r / 1000000 }
fn unpack_pos(r: i64) -> i64 { r - r / 1000000 * 1000000 }

fn op_prec(op_id: i64) -> i64 {
  -- Precedence (higher = tighter binding):
  -- *=3 /=4 %=11: prec 12 (multiplicative)
  -- +=1 -=2: prec 11 (additive)
  -- bshl=17 bshr=18: prec 10 (bitwise shift)
  -- band=14: prec 9
  -- bxor=16: prec 8
  -- bor=15: prec 7
  -- ==5 !=6 <7 >8 <=9 >=10: prec 6 (comparison)
  -- and=12: prec 5
  -- or=13: prec 4
  match op_id {
    1 -> 11
    2 -> 11
    3 -> 12
    4 -> 12
    5 -> 6
    6 -> 6
    7 -> 6
    8 -> 6
    9 -> 6
    10 -> 6
    11 -> 12
    12 -> 5
    13 -> 4
    14 -> 9
    15 -> 7
    16 -> 8
    _ -> 10
  }
}
