-- lib.weft — shared utilities for the Weft compiler
-- Runtime primitives, debug output, char classification,
-- string comparison, node/list data structures, operator precedence

use "runtime/syscall.weft"
use "runtime/memory.weft"
use "runtime/alloc.weft"
use "runtime/buffer.weft"

-- Process management is in stdlib/process.weft (linked via __got_* + ld).
-- The compiler itself stays static for bootstrap stability.

-- Read all bytes from an open file descriptor. Returns {ptr, len} pair.
fn read_fd_all(fd: i64) -> i64 {
  let chunk_size = 65536
  let scratch = alloc_bump(chunk_size)
  let out = buf_new(chunk_size)
  let mut done = 0
  while done == 0 {
    let n = sys_read(fd, scratch, chunk_size)
    if n > 0 {
      bscopy(out, scratch, n, 0)
      if n < chunk_size { done = 1 } else { 0 }
    } else {
      done = 1
    }
  }
  let result = alloc_bump(16)
  __mem_store64(result, buf_ptr(out))
  __mem_store64(result + 8, buf_len(out))
  result
}

fn read_stdin_all() -> i64 {
  read_fd_all(0)
}

-- Read an entire file into a bump-allocated buffer. Returns {ptr, len} pair.
fn read_file(path_str: i64) -> i64 {
  -- Need null-terminated path for sys_open
  let path_ptr = __str_ptr(path_str)
  let path_len = __str_len(path_str)
  let path_buf = alloc_bump(path_len + 1)
  mem_copy(path_buf, path_ptr, path_len)
  __mem_store8(path_buf + path_len, 0)
  -- Open file (O_RDONLY = 0)
  let fd = sys_open(path_buf, 0, 0)
  let result = alloc_bump(16)
  if fd < 0 {
    __mem_store64(result, 0)
    __mem_store64(result + 8, 0)
  } else {
    let file = read_fd_all(fd)
    sys_close(fd)
    __mem_store64(result, __mem_load64(file))
    __mem_store64(result + 8, __mem_load64(file + 8))
  }
  result
}

-- ======================================================================
-- Print helpers (stderr for diagnostics)
-- ======================================================================

fn eprint(msg: str) -> i64 {
  sys_write(2, __str_ptr(msg), __str_len(msg))
}
fn eprint_nl() -> i64 {
  let b = alloc_bump(1)
  __mem_store8(b, 10)
  sys_write(2, b, 1)
}
-- Print source location: "line N, col M: "
fn eprint_span(src: i64, offset: i64) -> i64 {
  let mut i = 0
  let mut line = 1
  let mut col = 1
  while i < offset {
    if __mem_load8(src + i) == 10 { line = line + 1 col = 1 }
    else { col = col + 1 }
    i = i + 1
  }
  eprint("line ")
  eprint_i(line)
  eprint(", col ")
  eprint_i(col)
  eprint(": ")
}

fn eprint_i(n: i64) -> i64 {
  if n < 0 { eprint("-") eprint_i(0 - n) }
  else {
    if n < 10 {
      let b = alloc_bump(8)
      __mem_store8(b, 48 + n)
      sys_write(2, b, 1)
    } else {
      eprint_i(n / 10)
      let b = alloc_bump(8)
      __mem_store8(b, 48 + n - n / 10 * 10)
      sys_write(2, b, 1)
    }
  }
}

-- ======================================================================
-- Character classification
-- ======================================================================

fn is_digit(ch: i64) -> i64 {
  if ch >= 48 { if ch <= 57 { 1 } else { 0 } } else { 0 }
}
fn is_alpha(ch: i64) -> i64 {
  if ch == 95 { 1 }
  else { if ch >= 65 { if ch <= 90 { 1 }
  else { if ch >= 97 { if ch <= 122 { 1 } else { 0 } } else { 0 } } }
  else { 0 } }
}
fn is_alnum(ch: i64) -> i64 {
  if is_alpha(ch) == 1 { 1 } else { is_digit(ch) }
}
fn is_ws(ch: i64) -> i64 {
  match ch {
    32 -> 1
    10 -> 1
    13 -> 1
    9 -> 1
    _ -> 0
  }
}

-- ======================================================================
-- String comparison (byte-by-byte against source)
-- ======================================================================

fn src_eq_at(src: i64, start: i64, p: i64, i: i64, l: i64) -> i64 {
  if i >= l { 1 }
  else {
    let a = __mem_load8(src + start + i)
    let b = __mem_load8(p + i)
    if a != b { 0 } else { src_eq_at(src, start, p, i + 1, l) }
  }
}
fn src_eq(src: i64, start: i64, len: i64, s: str) -> i64 {
  let p = __str_ptr(s)
  let l = __str_len(s)
  if len != l { 0 }
  else { src_eq_at(src, start, p, 0, l) }
}

-- ======================================================================
-- AST nodes — bump-allocated tagged records
-- ======================================================================
-- Node format: [tag, field1, field2, field3, field4] (5 words = 40 bytes)
-- Tags: 1=IntLit 2=Ident 3=BinOp 4=Call 5=If 6=Let 7=Block 8=FnDecl

fn node_new(tag: i64, f1: i64, f2: i64, f3: i64, f4: i64) -> i64 {
  let n = alloc_bump(40)
  __mem_store64(n, tag)
  __mem_store64(n + 8, f1)
  __mem_store64(n + 16, f2)
  __mem_store64(n + 24, f3)
  __mem_store64(n + 32, f4)
  n
}
fn node_tag(n: i64) -> i64 { __mem_load64(n) }
fn node_f1(n: i64) -> i64 { __mem_load64(n + 8) }
fn node_f2(n: i64) -> i64 { __mem_load64(n + 16) }
fn node_f3(n: i64) -> i64 { __mem_load64(n + 24) }
fn node_f4(n: i64) -> i64 { __mem_load64(n + 32) }

-- List of AST nodes (for fn params, call args, block stmts)
fn nlist_new() -> i64 {
  let h = alloc_bump(24)
  let d = alloc_bump(512)
  __mem_store64(h, d)
  __mem_store64(h + 8, 0)
  __mem_store64(h + 16, 64)
  h
}
fn nlist_add(l: i64, v: i64) -> i64 {
  let d = __mem_load64(l)
  let n = __mem_load64(l + 8)
  let cap = __mem_load64(l + 16)
  if n >= cap {
    let new_cap = cap * 2
    let new_d = alloc_bump(new_cap * 8)
    mem_copy(new_d, d, n * 8)
    __mem_store64(l, new_d)
    __mem_store64(l + 16, new_cap)
    __mem_store64(new_d + n * 8, v)
    __mem_store64(l + 8, n + 1)
    l
  } else {
    __mem_store64(d + n * 8, v)
    __mem_store64(l + 8, n + 1)
    l
  }
}
fn nlist_get(l: i64, i: i64) -> i64 {
  let d = __mem_load64(l)
  __mem_load64(d + i * 8)
}
fn nlist_len(l: i64) -> i64 { __mem_load64(l + 8) }

fn pack(node: i64, pos: i64) -> i64 {
  let r = alloc_bump(16)
  __mem_store64(r, node)
  __mem_store64(r + 8, pos)
  r
}
fn unpack_node(r: i64) -> i64 { __mem_load64(r) }
fn unpack_pos(r: i64) -> i64 { __mem_load64(r + 8) }

fn op_prec(op_id: i64) -> i64 {
  -- Precedence (higher = tighter binding):
  -- *=3 /=4 %=11: prec 12 (multiplicative)
  -- +=1 -=2: prec 11 (additive)
  -- bshl=17 bshr=18: prec 10 (bitwise shift)
  -- band=14: prec 9
  -- bxor=16: prec 8
  -- bor=15: prec 7
  -- ==5 !=6 <7 >8 <=9 >=10: prec 6 (comparison)
  -- and=12: prec 5
  -- or=13: prec 4
  match op_id {
    1 -> 11
    2 -> 11
    3 -> 12
    4 -> 12
    5 -> 6
    6 -> 6
    7 -> 6
    8 -> 6
    9 -> 6
    10 -> 6
    11 -> 12
    12 -> 5
    13 -> 4
    14 -> 9
    15 -> 7
    16 -> 8
    17 -> 10
    18 -> 10
    19 -> 3
    20 -> 2
    _ -> 10
  }
}
