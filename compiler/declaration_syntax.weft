-- Source declarations before host resolution. The private parser adapter
-- produces these values from the same parse that supplies compiler storage.

use compiler/import_syntax.{ImportSyntax, ImportDeclaration}
use compiler/ir.{*}
use compiler/lib.{*}
use compiler/module.{DeclVisibility}
use stdlib/list.{List}

pub(package) type FunctionSyntax {
  name: TypeNameRange,
  params: ParamList,
  result: TypeExpr,
  effects: EffectSig,
  type_params: TypeParamList,
  body: Expr
}

pub(package) type ConstantSyntax {
  name: TypeNameRange,
  declared_type: TypeExpr,
  initializer: Expr
}

pub(package) type ModuleHandlerSyntax {
  effect_reference: Expr,
  params: ParamList,
  clauses: HandlerClauseList,
  type_params: TypeParamList
}

pub(package) type TestSyntax {
  name: TypeNameRange,
  body: Expr
}

pub(package) type DeclarationSyntax {
  FunctionDefinition(FunctionSyntax),
  TypeDefinition(TypeEntry),
  ConstantDefinition(ConstantSyntax),
  HandlerDefinition(ModuleHandlerSyntax),
  DefaultHandlerDefinition(Expr),
  ImportDefinition(ImportSyntax),
  TestDefinition(TestSyntax),
  InvalidDefinition
}

pub(package) type DeclarationValidity { ParsedDeclaration, RecoveredDeclaration }

pub(package) type DeclarationParse {
  syntax: DeclarationSyntax,
  next: i64
}

pub(package) type SourceDeclaration {
  syntax: DeclarationSyntax,
  visibility: DeclVisibility,
  range: TypeNameRange,
  validity: DeclarationValidity
}

-- Function storage is a private compatibility bridge for the current checker.
-- The declaration values retain what parsing learned independently of it.
pub(package) type ParsedModuleSyntax {
  functions: i64,
  imports: List<ImportDeclaration>,
  declarations: List<SourceDeclaration>
}

pub(package) fn function_syntax_from_node(wrapper: i64) -> FunctionSyntax {
  let inner = node_f1(wrapper)
  FunctionSyntax {
    name: TypeNameRange { start: node_f1(inner), length: node_f2(inner) },
    params: param_list_from_param_nodes(node_f3(inner)),
    result: type_expr_from_node(node_f2(wrapper)),
    effects: effect_sig_from_node(node_f3(wrapper)),
    type_params: type_param_list_from_type_param_nodes(node_f4(wrapper)),
    body: expr_from_node(node_f4(inner))
  }
}

pub(package) fn module_handler_syntax_from_node(node: i64) -> DeclarationSyntax {
  if node == 0 { InvalidDefinition }
  else {
    let metadata = node_f4(node)
    HandlerDefinition(ModuleHandlerSyntax {
      effect_reference: expr_from_node(node_f1(node)),
      params: param_list_from_param_nodes(node_f2(node)),
      clauses: handler_clause_list_from_nodes(node_f3(node), 0, node_f2(metadata)),
      type_params: type_param_list_from_type_param_nodes(node_f1(metadata))
    })
  }
}
