-- compiler/native_target.weft -- shared native target identity and ABI policy
--
-- Target identity is semantic compiler data shared by lowering, linkage,
-- artifact facts and platform leaves. The integer conversion exists only for
-- the legacy raw function-map storage boundary; ordinary consumers match the
-- typed variants directly.

use runtime/syscall.{sys_native_host_target}

pub(package) type NativeLinkTarget {
  NativeLinkMacosAarch64,
  NativeLinkLinuxAarch64
}

pub(package) fn native_link_target_storage_kind(target: NativeLinkTarget) -> i64 {
  match target {
    NativeLinkMacosAarch64 -> 1
    NativeLinkLinuxAarch64 -> 2
  }
}

pub(package) fn native_link_target_from_storage_kind(kind: i64) -> NativeLinkTarget {
  if kind == 2 { NativeLinkLinuxAarch64 } else { NativeLinkMacosAarch64 }
}

-- The target a compiler emits for by default is the host it runs on, reported
-- by the sealed platform leaf rather than assumed. Callers that name a target
-- explicitly keep doing so; only the defaults consult this.
pub(package) fn native_link_target_host() -> NativeLinkTarget {
  native_link_target_from_storage_kind(sys_native_host_target())
}
