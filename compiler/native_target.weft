-- compiler/native_target.weft -- shared native target identity and ABI policy
--
-- Target identity is semantic compiler data shared by lowering, linkage,
-- artifact facts and platform leaves. The integer conversion exists only for
-- the legacy raw function-map storage boundary; ordinary consumers match the
-- typed variants directly.

use runtime/syscall.{sys_native_host_target}
use stdlib/list.{List, list_cons, list_nil}
use stdlib/string.{str_eq}

pub(package) type NativeLinkTarget {
  NativeLinkMacosAarch64,
  NativeLinkLinuxAarch64
}

pub(package) type NativeLinkTargetParse {
  NativeLinkTargetParsed(NativeLinkTarget),
  NativeLinkTargetUnsupported
}

pub(package) fn native_link_supported_targets() -> List<NativeLinkTarget> {
  list_cons<NativeLinkTarget>(
    NativeLinkMacosAarch64,
    list_cons<NativeLinkTarget>(NativeLinkLinuxAarch64, list_nil<NativeLinkTarget>())
  )
}

pub(package) fn native_link_target_name(target: NativeLinkTarget) -> str {
  match target {
    NativeLinkMacosAarch64 -> "macos-aarch64"
    NativeLinkLinuxAarch64 -> "linux-aarch64"
  }
}

pub(package) fn native_link_target_parse(name: str) -> NativeLinkTargetParse {
  if str_eq(name, native_link_target_name(NativeLinkMacosAarch64)) == 1 {
    NativeLinkTargetParsed(NativeLinkMacosAarch64)
  } else { if str_eq(name, native_link_target_name(NativeLinkLinuxAarch64)) == 1 {
    NativeLinkTargetParsed(NativeLinkLinuxAarch64)
  } else { NativeLinkTargetUnsupported } }
}

pub(package) fn native_link_target_is_host(target: NativeLinkTarget) -> bool {
  match target {
    NativeLinkMacosAarch64 -> match native_link_target_host() {
      NativeLinkMacosAarch64 -> true
      NativeLinkLinuxAarch64 -> false
    }
    NativeLinkLinuxAarch64 -> match native_link_target_host() {
      NativeLinkMacosAarch64 -> false
      NativeLinkLinuxAarch64 -> true
    }
  }
}

pub(package) fn native_link_target_storage_kind(target: NativeLinkTarget) -> i64 {
  match target {
    NativeLinkMacosAarch64 -> 1
    NativeLinkLinuxAarch64 -> 2
  }
}

pub(package) fn native_link_target_from_storage_kind(kind: i64) -> NativeLinkTarget {
  if kind == 2 { NativeLinkLinuxAarch64 } else { NativeLinkMacosAarch64 }
}

-- The target a compiler emits for by default is the host it runs on, reported
-- by the sealed platform leaf rather than assumed. Callers that name a target
-- explicitly keep doing so; only the defaults consult this.
pub(package) fn native_link_target_host() -> NativeLinkTarget {
  native_link_target_from_storage_kind(sys_native_host_target())
}
