-- parse.weft — recursive descent parser with Pratt precedence
-- Returns {node, pos} packed as node * 1000000 + pos

use "compiler/lex.weft"
use "compiler/types.weft"

-- Error recovery: skip to next declaration keyword (fn/type/use) or EOF
fn sync_to_decl(toks: i64, pos: i64) -> i64 {
  let mut p = pos
  let mut done = 0
  while done == 0 {
    let tag = tok_tag(toks, p)
    if tag == 7 { done = 1 }
    else { if tag == 3 {
      let kw = tok_v1(toks, p)
      if kw == 1 { done = 1 }
      else { if kw == 9 { done = 1 }
      else { if kw == 19 { done = 1 }
      else { p = p + 1 } } }
    } else { p = p + 1 } }
  }
  p
}

fn parse_ident_or_call(toks: i64, src: i64, pos: i64) -> i64 {
  let v1 = tok_v1(toks, pos)
  let v2 = tok_v2(toks, pos)
  -- Check if next token is (
  let next_tag = tok_tag(toks, pos + 1)
  let next_v1 = tok_v1(toks, pos + 1)
  if next_tag == 5 {
    if next_v1 == 1 {
      -- Function call: ident(args)
      parse_call(toks, src, pos, v1, v2)
    } else { if next_v1 == 3 {
      -- Check for record constructor: UpperCase { fields }
      let first_ch = __mem_load8(src + v1)
      if first_ch >= 65 {
        if first_ch <= 90 {
          parse_record_lit(toks, src, pos)
        } else { pack(node_new(2, v1, v2, 0, 0), pos + 1) }
      } else { pack(node_new(2, v1, v2, 0, 0), pos + 1) }
    } else {
      pack(node_new(2, v1, v2, 0, 0), pos + 1)
    } }
  } else {
    pack(node_new(2, v1, v2, 0, 0), pos + 1)
  }
}

fn parse_call(toks: i64, src: i64, pos: i64, name_start: i64, name_len: i64) -> i64 {
  -- pos is at ident, pos+1 is (, parse args until )
  let args = nlist_new()
  parse_call_args(toks, src, pos + 2, args, name_start, name_len)
}

fn parse_call_args(toks: i64, src: i64, pos: i64, args: i64, ns: i64, nl: i64) -> i64 {
  let mut p = pos
  let mut done = 0
  while done == 0 {
    let tag = tok_tag(toks, p)
    let v1 = tok_v1(toks, p)
    -- Check for )
    if tag == 5 {
      if v1 == 2 { done = 1 }
      else {
        let r = parse_expr(toks, src, p, 0)
        nlist_add(args, unpack_node(r))
        p = skip_comma(toks, unpack_pos(r))
      }
    } else {
      let r = parse_expr(toks, src, p, 0)
      nlist_add(args, unpack_node(r))
      p = skip_comma(toks, unpack_pos(r))
    }
  }
  pack(node_new(4, ns, nl, args, nlist_len(args)), p + 1)
}

fn skip_comma(toks: i64, pos: i64) -> i64 {
  if tok_tag(toks, pos) == 5 {
    match tok_v1(toks, pos) {
      5 -> pos + 1
      13 -> pos + 1
      _ -> pos
    }
  } else { pos }
}

fn parse_while(toks: i64, src: i64, pos: i64) -> i64 {
  -- pos is after "while" keyword
  let cond_r = parse_expr(toks, src, pos, 0)
  let cond = unpack_node(cond_r)
  let p1 = unpack_pos(cond_r)
  let body_r = parse_block(toks, src, p1 + 1)
  let body = unpack_node(body_r)
  let p2 = unpack_pos(body_r)
  pack(node_new(10, cond, body, 0, 0), p2)
}

-- Parse match expression: match expr { Pattern -> expr, ... }
-- AST tag 15 = Match(scrutinee, arms_list, num_arms, 0)
-- Each arm: node(16, pattern_node, body_node, 0, 0)
-- Pattern types:
--   node(17, 0, 0, 0, 0) = wildcard (_)
--   node(18, ns, nl, 0, 0) = binding (variable name)
--   node(19, value, 0, 0, 0) = int literal
--   node(20, tag_ns, tag_nl, binding_ns, binding_nl) = constructor (Tag(x))
fn parse_pattern(toks: i64, src: i64, pos: i64) -> i64 {
  let tag = tok_tag(toks, pos)
  let v1 = tok_v1(toks, pos)
  if tag == 2 {
    parse_pat_ident(toks, src, pos, v1)
  } else { if tag == 1 {
    pack(node_new(19, v1, 0, 0, 0), pos + 1)
  } else {
    pack(node_new(17, 0, 0, 0, 0), pos + 1)
  } }
}

-- Ident in pattern: wildcard (_), uppercase -> constructor, lowercase -> binding
fn parse_pat_ident(toks: i64, src: i64, pos: i64, v1: i64) -> i64 {
  let v2 = tok_v2(toks, pos)
  let first_ch = __mem_load8(src + v1)
  if first_ch == 95 {
    pack(node_new(17, 0, 0, 0, 0), pos + 1)
  } else { if first_ch >= 65 {
    if first_ch <= 90 {
      parse_pat_ctor(toks, pos, v1, v2)
    } else {
      pack(node_new(18, v1, v2, 0, 0), pos + 1)
    }
  } else {
    pack(node_new(18, v1, v2, 0, 0), pos + 1)
  } }
}

-- Constructor pattern: Name or Name(binding)
fn parse_pat_ctor(toks: i64, pos: i64, v1: i64, v2: i64) -> i64 {
  if tok_tag(toks, pos + 1) == 5 {
    if tok_v1(toks, pos + 1) == 1 {
      let b_ns = tok_v1(toks, pos + 2)
      let b_nl = tok_v2(toks, pos + 2)
      pack(node_new(20, v1, v2, b_ns, b_nl), pos + 4)
    } else {
      pack(node_new(20, v1, v2, 0, 0), pos + 1)
    }
  } else {
    pack(node_new(20, v1, v2, 0, 0), pos + 1)
  }
}


fn parse_match(toks: i64, src: i64, pos: i64) -> i64 {
  -- pos is after "match" keyword
  let scrutinee_r = parse_expr(toks, src, pos, 0)
  let scrutinee = unpack_node(scrutinee_r)
  let p1 = unpack_pos(scrutinee_r)
  -- expect {
  let arms = nlist_new()
  let p2 = parse_match_arms(toks, src, p1 + 1, arms)
  let n_arms = nlist_len(arms)
  let nd = node_new(15, scrutinee, arms, n_arms, 0)
  pack(nd, p2)
}
fn parse_match_arms(toks: i64, src: i64, pos: i64, arms: i64) -> i64 {
  -- Skip semicolons between arms (from newlines)
  let p = skip_semicolons(toks, pos)
  if tok_tag(toks, p) == 5 {
    if tok_v1(toks, p) == 4 { p + 1 }
    else { parse_one_match_arm(toks, src, p, arms) }
  } else {
    parse_one_match_arm(toks, src, p, arms)
  }
}
fn parse_one_match_arm(toks: i64, src: i64, pos: i64, arms: i64) -> i64 {
  -- Parse: pattern [if guard] -> expr
  let pat = parse_pattern(toks, src, pos)
  let pat_node = unpack_node(pat)
  let p1 = unpack_pos(pat)
  -- Check for guard: if (keyword 3)
  let guard_r = if tok_tag(toks, p1) == 3 {
    if tok_v1(toks, p1) == 3 {
      parse_expr(toks, src, p1 + 1, 0)
    } else { pack(0, p1) }
  } else { pack(0, p1) }
  let guard_node = unpack_node(guard_r)
  let p2 = unpack_pos(guard_r)
  -- Expect -> (Arrow, tag 6)
  let p3 = if tok_tag(toks, p2) == 6 { p2 + 1 } else { p2 }
  -- Parse body expression
  let body_r = parse_expr(toks, src, p3, 0)
  let body_node = unpack_node(body_r)
  let p4 = unpack_pos(body_r)
  let arm = node_new(16, pat_node, body_node, guard_node, 0)
  nlist_add(arms, arm)
  let p5 = skip_comma(toks, p4)
  parse_match_arms(toks, src, p5, arms)
}

fn parse_if(toks: i64, src: i64, pos: i64) -> i64 {
  -- pos is after "if" keyword
  let cond_r = parse_expr(toks, src, pos, 0)
  let cond = unpack_node(cond_r)
  let p1 = unpack_pos(cond_r)
  -- expect { then_block }
  let then_r = parse_block(toks, src, p1 + 1)
  let then_n = unpack_node(then_r)
  let p2 = unpack_pos(then_r)
  -- expect "else" { else_block }
  if tok_tag(toks, p2) == 3 {
    if tok_v1(toks, p2) == 4 {
      let else_r = parse_block(toks, src, p2 + 2)
      let else_n = unpack_node(else_r)
      let p3 = unpack_pos(else_r)
      pack(node_new(5, cond, then_n, else_n, 0), p3)
    } else {
      pack(node_new(5, cond, then_n, node_new(1, 0, 0, 0, 0), 0), p2)
    }
  } else {
    pack(node_new(5, cond, then_n, node_new(1, 0, 0, 0, 0), 0), p2)
  }
}

fn parse_let(toks: i64, src: i64, pos: i64) -> i64 {
  -- pos is after "let" keyword
  -- check for "mut"
  let is_mut = if tok_tag(toks, pos) == 3 {
    if tok_v1(toks, pos) == 5 { 1 } else { 0 }
  } else { 0 }
  let p = if is_mut == 1 { pos + 1 } else { pos }
  -- expect ident = expr
  let name_start = tok_v1(toks, p)
  let name_len = tok_v2(toks, p)
  -- skip ident, skip = (Punct 7)
  let val_r = parse_expr(toks, src, p + 2, 0)
  let val_n = unpack_node(val_r)
  let p2 = unpack_pos(val_r)
  -- the rest of the block is the body
  let body_r = parse_block_stmts(toks, src, p2)
  let body_n = unpack_node(body_r)
  let p3 = unpack_pos(body_r)
  -- tag 6 = Let (immutable), tag 11 = LetMut (mutable)
  let node_tag = if is_mut == 1 { 11 } else { 6 }
  pack(node_new(node_tag, name_start, name_len, val_n, body_n), p3)
}

fn parse_block(toks: i64, src: i64, pos: i64) -> i64 {
  -- pos is after {, parse stmts until }
  -- Handle EOF or unexpected token gracefully
  if tok_tag(toks, pos) == 7 { pack(node_new(1, 0, 0, 0, 0), pos) }
  else {
    let r = parse_block_stmts(toks, src, pos)
    let n = unpack_node(r)
    let p = unpack_pos(r)
    if tok_tag(toks, p) == 7 { pack(n, p) }
    else { pack(n, p + 1) }
  }
}

fn parse_block_stmts(toks: i64, src: i64, pos: i64) -> i64 {
  -- Skip leading semicolons (from newlines)
  let p0 = skip_semicolons(toks, pos)
  -- Parse expressions until } or EOF. Returns position AT } (not past it).
  let tag = tok_tag(toks, p0)
  let v1 = tok_v1(toks, p0)
  if tag == 5 {
    if v1 == 4 {
      pack(node_new(1, 0, 0, 0, 0), p0)
    } else {
      parse_block_one(toks, src, p0)
    }
  } else { if tag == 7 {
    pack(node_new(1, 0, 0, 0, 0), p0)
  } else {
    parse_block_one(toks, src, p0)
  } }
}

-- Check for assignment (ident = expr) before parsing as expression
fn parse_maybe_assign(toks: i64, src: i64, pos: i64) -> i64 {
  -- Assignment: Ident followed by = (Punct 7)
  if tok_tag(toks, pos) == 2 {
    if tok_tag(toks, pos + 1) == 5 {
      if tok_v1(toks, pos + 1) == 7 {
        let a_ns = tok_v1(toks, pos)
        let a_nl = tok_v2(toks, pos)
        let a_val_r = parse_expr(toks, src, pos + 2, 0)
        let a_node = node_new(12, a_ns, a_nl, unpack_node(a_val_r), 0)
        let a_pos = unpack_pos(a_val_r)
        pack(a_node, a_pos)
      } else { parse_expr(toks, src, pos, 0) }
    } else { parse_expr(toks, src, pos, 0) }
  } else { parse_expr(toks, src, pos, 0) }
}

fn parse_block_one(toks: i64, src: i64, pos: i64) -> i64 {
  let r = parse_maybe_assign(toks, src, pos)
  let n = unpack_node(r)
  let p = unpack_pos(r)
  -- Skip optional ; separator
  let p2 = skip_semicolons(toks, p)
  -- Check if next is } or eof — return AT } (don't consume)
  let next_tag = tok_tag(toks, p2)
  if next_tag == 5 {
    if tok_v1(toks, p2) == 4 { pack(n, p2) }
    else {
      let rest_r = parse_block_stmts(toks, src, p2)
      pack(node_new(7, n, unpack_node(rest_r), 0, 0), unpack_pos(rest_r))
    }
  } else { if next_tag == 7 {
    pack(n, p2)
  } else {
    -- More statements: wrap in Block(first, rest)
    let rest_r = parse_block_stmts(toks, src, p2)
    pack(node_new(7, n, unpack_node(rest_r), 0, 0), unpack_pos(rest_r))
  } }
}

fn skip_semicolons(toks: i64, pos: i64) -> i64 {
  let mut p = pos
  let mut done = 0
  while done == 0 {
    if tok_tag(toks, p) == 5 {
      if tok_v1(toks, p) == 13 { p = p + 1 }
      else { done = 1 }
    } else { done = 1 }
  }
  p
}

-- Parse record literal: Name { field: value, ... }
-- AST tag 14 = RecordInit, f1=type_ns, f2=type_nl, f3=fields_list, f4=num_fields
fn parse_record_lit(toks: i64, src: i64, pos: i64) -> i64 {
  let type_ns = tok_v1(toks, pos)
  let type_nl = tok_v2(toks, pos)
  -- skip Name {
  let fields = nlist_new()
  let end_pos = parse_record_lit_fields(toks, src, pos + 2, fields)
  let nf = nlist_len(fields)
  let nd = node_new(14, type_ns, type_nl, fields, nf)
  pack(nd, end_pos)
}
fn parse_record_lit_fields(toks: i64, src: i64, pos: i64, fields: i64) -> i64 {
  -- Check for } (closing brace) first
  if tok_tag(toks, pos) == 5 {
    if tok_v1(toks, pos) == 4 { pos + 1 } else { pos }
  } else {
    -- Field: name : value
    let f_ns = tok_v1(toks, pos)
    let f_nl = tok_v2(toks, pos)
    -- skip field_name :
    let val_r = parse_expr(toks, src, pos + 2, 0)
    let val_n = unpack_node(val_r)
    let val_p = unpack_pos(val_r)
    let pair = node_new(2, f_ns, f_nl, val_n, 0)
    nlist_add(fields, pair)
    let p2 = skip_comma(toks, val_p)
    parse_record_lit_fields(toks, src, p2, fields)
  }
}

-- parse_expr: combined primary + infix. No mutual recursion.
-- All sub-helpers (parse_if, parse_let, etc.) are defined BEFORE this.
fn parse_expr(toks: i64, src: i64, pos: i64, min_prec: i64) -> i64 {
  -- Parse primary
  let tag = tok_tag(toks, pos)
  let v1 = tok_v1(toks, pos)
  let lhs_r = if tag == 1 {
    -- IntLit
    pack(node_new(1, v1, 0, 0, 0), pos + 1)
  } else { if tag == 2 {
    -- Ident or call (record constructor handled in parse_ident_or_call)
    parse_ident_or_call(toks, src, pos)
  } else { if tag == 3 {
    if v1 == 3 { parse_if(toks, src, pos + 1) }
    else { if v1 == 2 { parse_let(toks, src, pos + 1) }
    else { if v1 == 8 { parse_while(toks, src, pos + 1) }
    else { if v1 == 10 { parse_match(toks, src, pos + 1) }
    else { if v1 == 11 {
      -- not expr: boolean negation (AST tag 22)
      let operand_r = parse_expr(toks, src, pos + 1, 13)
      let operand = unpack_node(operand_r)
      let op_pos = unpack_pos(operand_r)
      pack(node_new(22, operand, 0, 0, 0), op_pos)
    }
    else { if v1 == 20 {
      -- return expr (AST tag 25)
      let ret_r = parse_expr(toks, src, pos + 1, 0)
      pack(node_new(25, unpack_node(ret_r), 0, 0, 0), unpack_pos(ret_r))
    }
    else { if v1 == 21 {
      -- break (AST tag 26)
      pack(node_new(26, 0, 0, 0, 0), pos + 1)
    }
    else { if v1 == 22 {
      -- continue (AST tag 27)
      pack(node_new(27, 0, 0, 0, 0), pos + 1)
    }
    else { pack(node_new(1, 0, 0, 0, 0), pos + 1) } } } } } } } }
  } else { if tag == 5 {
    if v1 == 1 {
      let inner = parse_expr(toks, src, pos + 1, 0)
      let inner_node = unpack_node(inner)
      let inner_pos = unpack_pos(inner) + 1
      pack(inner_node, inner_pos)
    } else { if v1 == 3 {
      parse_block(toks, src, pos + 1)
    } else {
      pack(node_new(1, 0, 0, 0, 0), pos + 1)
    } }
  } else { if tag == 4 {
    if v1 == 2 {
      -- Unary minus: -expr -> 0 - expr
      let operand_r = parse_expr(toks, src, pos + 1, 10)
      let operand = unpack_node(operand_r)
      let operand_pos = unpack_pos(operand_r)
      pack(node_new(3, 2, node_new(1, 0, 0, 0, 0), operand, 0), operand_pos)
    } else {
      pack(node_new(1, 0, 0, 0, 0), pos + 1)
    }
  } else { if tag == 9 {
    -- BoolLit: AST tag 24 = BoolLit(value), codegen treats as IntLit
    pack(node_new(24, v1, 0, 0, 0), pos + 1)
  } else { if tag == 8 {
    -- StringLit: f1=source offset, f2=byte length
    pack(node_new(9, v1, tok_v2(toks, pos), 0, 0), pos + 1)
  } else {
    pack(node_new(1, 0, 0, 0, 0), pos + 1)
  } } } } } } }
  -- Infix loop (extract unpack calls to avoid arg clobbering)
  let lhs_node = unpack_node(lhs_r)
  let lhs_pos = unpack_pos(lhs_r)
  pe_infix(toks, src, lhs_node, lhs_pos, min_prec)
}

fn pe_infix(toks: i64, src: i64, lhs: i64, pos: i64, min_prec: i64) -> i64 {
  let tag = tok_tag(toks, pos)
  if tag == 4 {
    let op_id = tok_v1(toks, pos)
    let prec = op_prec(op_id)
    if prec > min_prec {
      let rhs_r = parse_expr(toks, src, pos + 1, prec)
      let rhs = unpack_node(rhs_r)
      let p2 = unpack_pos(rhs_r)
      let binop = node_new(3, op_id, lhs, rhs, 0)
      pe_infix(toks, src, binop, p2, min_prec)
    } else { pack(lhs, pos) }
  } else { if tag == 5 {
    if tok_v1(toks, pos) == 8 {
      -- Dot: field access. AST tag 13 = FieldAccess(base, field_ns, field_nl, 0)
      let field_ns = tok_v1(toks, pos + 1)
      let field_nl = tok_v2(toks, pos + 1)
      let fa = node_new(13, lhs, field_ns, field_nl, 0)
      pe_infix(toks, src, fa, pos + 2, min_prec)
    } else { pack(lhs, pos) }
  } else { pack(lhs, pos) } }
}

-- ══════════════════════════════════════════════════════════════
-- Type expression parser
-- ══════════════════════════════════════════════════════════════
-- Precedence: ~ (tightest) > & > | (loosest), ? is postfix

fn parse_type(toks: i64, src: i64, pos: i64) -> i64 {
  parse_type_union(toks, src, pos)
}

fn parse_type_union(toks: i64, src: i64, pos: i64) -> i64 {
  let lhs_r = parse_type_inter(toks, src, pos)
  let mut result = unpack_node(lhs_r)
  let mut p = unpack_pos(lhs_r)
  let mut done = 0
  while done == 0 {
    if tok_tag(toks, p) == 5 {
      if tok_v1(toks, p) == 9 {
        let rhs_r = parse_type_inter(toks, src, p + 1)
        result = ty_union(result, unpack_node(rhs_r))
        p = unpack_pos(rhs_r)
      } else { done = 1 }
    } else { done = 1 }
  }
  pack(result, p)
}

fn parse_type_inter(toks: i64, src: i64, pos: i64) -> i64 {
  let lhs_r = parse_type_prefix(toks, src, pos)
  let mut result = unpack_node(lhs_r)
  let mut p = unpack_pos(lhs_r)
  let mut done = 0
  while done == 0 {
    if tok_tag(toks, p) == 5 {
      if tok_v1(toks, p) == 10 {
        let rhs_r = parse_type_prefix(toks, src, p + 1)
        result = ty_inter(result, unpack_node(rhs_r))
        p = unpack_pos(rhs_r)
      } else { done = 1 }
    } else { done = 1 }
  }
  pack(result, p)
}

fn parse_type_prefix(toks: i64, src: i64, pos: i64) -> i64 {
  if tok_tag(toks, pos) == 5 {
    if tok_v1(toks, pos) == 11 {
      let inner_r = parse_type_prefix(toks, src, pos + 1)
      pack(ty_compl(unpack_node(inner_r)), unpack_pos(inner_r))
    } else { parse_type_postfix(toks, src, pos) }
  } else { parse_type_postfix(toks, src, pos) }
}

fn parse_type_postfix(toks: i64, src: i64, pos: i64) -> i64 {
  let base_r = parse_type_atom(toks, src, pos)
  let base = unpack_node(base_r)
  let p = unpack_pos(base_r)
  if tok_tag(toks, p) == 5 {
    if tok_v1(toks, p) == 12 {
      pack(ty_nullable(base), p + 1)
    } else { pack(base, p) }
  } else { pack(base, p) }
}

fn parse_type_atom(toks: i64, src: i64, pos: i64) -> i64 {
  let tag = tok_tag(toks, pos)
  if tag == 2 {
    let ns = tok_v1(toks, pos)
    let nl = tok_v2(toks, pos)
    pack(resolve_type_name(src, ns, nl), pos + 1)
  } else { if tag == 5 {
    if tok_v1(toks, pos) == 1 {
      let inner_r = parse_type(toks, src, pos + 1)
      let inner_ty = unpack_node(inner_r)
      let inner_pos = unpack_pos(inner_r) + 1
      pack(inner_ty, inner_pos)
    } else { pack(ty_any(), pos + 1) }
  } else { pack(ty_any(), pos + 1) } }
}

fn resolve_type_name(src: i64, ns: i64, nl: i64) -> i64 {
  if src_eq(src, ns, nl, "i64") == 1 { ty_i64() }
  else { if src_eq(src, ns, nl, "str") == 1 { ty_str() }
  else { if src_eq(src, ns, nl, "bool") == 1 { ty_bool() }
  else { if src_eq(src, ns, nl, "nil") == 1 { ty_nil() }
  else { if src_eq(src, ns, nl, "never") == 1 { ty_never() }
  else { if src_eq(src, ns, nl, "any") == 1 { ty_any() }
  else { ty_any() } } } } } }
}

-- Parse a function declaration
fn parse_fn_params(toks: i64, src: i64, pos: i64, params: i64) -> i64 {
  -- pos is after (, parse params until ) or EOF or declaration keyword
  let mut p = pos
  let mut done = 0
  while done == 0 {
    let tag = tok_tag(toks, p)
    if tag == 7 { done = 1 }
    else { if tag == 5 {
      if tok_v1(toks, p) == 2 { done = 1 }
      else { if tok_v1(toks, p) == 3 { done = 1 }
      else { p = parse_one_param(toks, src, p, params) } }
    } else { if tag == 3 {
      let kw = tok_v1(toks, p)
      -- Stop if we hit fn/type/use (declaration boundary)
      if kw == 1 { done = 1 }
      else { if kw == 9 { done = 1 }
      else { if kw == 19 { done = 1 }
      else { p = parse_one_param(toks, src, p, params) } } }
    } else { p = parse_one_param(toks, src, p, params) } } }
  }
  if tok_tag(toks, p) == 5 {
    if tok_v1(toks, p) == 2 { p + 1 } else { p }
  } else { p }
}

-- Skip a type annotation without allocating type nodes
fn skip_type_annotation(toks: i64, pos: i64) -> i64 {
  -- Skip one type atom (with optional prefix ~ and postfix ?)
  let p = skip_type_atom(toks, pos)
  -- Handle infix | or & by skipping the next type
  if tok_tag(toks, p) == 5 {
    if tok_v1(toks, p) == 9 { skip_type_annotation(toks, p + 1) }
    else { if tok_v1(toks, p) == 10 { skip_type_annotation(toks, p + 1) }
    else { p } }
  } else { p }
}

fn skip_type_atom(toks: i64, pos: i64) -> i64 {
  -- Handle prefix ~
  let p = if tok_tag(toks, pos) == 5 {
    if tok_v1(toks, pos) == 11 { pos + 1 } else { pos }
  } else { pos }
  -- Handle atom: ident or (grouped)
  let p2 = if tok_tag(toks, p) == 5 {
    if tok_v1(toks, p) == 1 { skip_type_parens(toks, p + 1) }
    else { p }
  } else { p + 1 }
  -- Handle postfix ?
  if tok_tag(toks, p2) == 5 {
    if tok_v1(toks, p2) == 12 { p2 + 1 } else { p2 }
  } else { p2 }
}

fn skip_type_parens(toks: i64, pos: i64) -> i64 {
  let mut p = pos
  let mut depth = 1
  while depth > 0 {
    if tok_tag(toks, p) == 5 {
      if tok_v1(toks, p) == 1 { depth = depth + 1 p = p + 1 }
      else { if tok_v1(toks, p) == 2 { depth = depth - 1 p = p + 1 }
      else { p = p + 1 } }
    } else { p = p + 1 }
  }
  p
}

-- Resolve simple type names without allocating complex type nodes
-- Returns a type pointer for i64/str/bool/nil/never/any, or 0 for complex types
fn resolve_simple_type(toks: i64, src: i64, pos: i64) -> i64 {
  if tok_tag(toks, pos) == 2 {
    -- Simple identifier type
    resolve_type_name(src, tok_v1(toks, pos), tok_v2(toks, pos))
  } else { 0 }
}

fn parse_one_param(toks: i64, src: i64, pos: i64, params: i64) -> i64 {
  let ns = tok_v1(toks, pos)
  let nl = tok_v2(toks, pos)
  -- Check for : after ident
  if tok_tag(toks, pos + 1) == 5 {
    if tok_v1(toks, pos + 1) == 6 {
      -- Has type annotation: parse the type
      let ty_r = parse_type(toks, src, pos + 2)
      let ty = unpack_node(ty_r)
      let after_ty = unpack_pos(ty_r)
      nlist_add(params, node_new(2, ns, nl, ty, 0))
      skip_comma(toks, after_ty)
    } else {
      -- No colon
      nlist_add(params, node_new(2, ns, nl, 0, 0))
      skip_comma(toks, pos + 1)
    }
  } else {
    nlist_add(params, node_new(2, ns, nl, 0, 0))
    skip_comma(toks, pos + 1)
  }
}

fn parse_fn(toks: i64, src: i64, pos: i64) -> i64 {
  -- pos is after "fn" keyword
  let name_start = tok_v1(toks, pos)
  let name_len = tok_v2(toks, pos)
  -- Check: is pos+1 an opening paren?
  let has_paren = if tok_tag(toks, pos + 1) == 5 {
    if tok_v1(toks, pos + 1) == 1 { 1 } else { 0 }
  } else { 0 }
  if has_paren == 0 {
    -- Malformed: no ( after name. Report error and sync.
    eprint_span(src, name_start)
    eprint("error: expected '(' after function name\n")
    let sync_p = sync_to_decl(toks, pos + 1)
    let dummy = node_new(8, name_start, name_len, nlist_new(), node_new(1, 0, 0, 0, 0))
    pack(node_new(23, dummy, 0, 0, 0), sync_p)
  } else {
    let params = nlist_new()
    let after_params = parse_fn_params(toks, src, pos + 2, params)
    -- parse optional -> type
    let ret_r = parse_ret_type(toks, src, after_params)
    let ret_type = unpack_node(ret_r)
    let p = unpack_pos(ret_r)
    -- expect {
    if tok_tag(toks, p) == 5 {
      if tok_v1(toks, p) == 3 {
        let body_r = parse_block(toks, src, p + 1)
        let body = unpack_node(body_r)
        let p2 = unpack_pos(body_r)
        let fn_inner = node_new(8, name_start, name_len, params, body)
        pack(node_new(23, fn_inner, ret_type, 0, 0), p2)
      } else {
        -- No { found: report and sync
        eprint_span(src, name_start)
        eprint("error: expected '{' in function body\n")
        let sync_p = sync_to_decl(toks, p)
        let dummy = node_new(8, name_start, name_len, params, node_new(1, 0, 0, 0, 0))
        pack(node_new(23, dummy, ret_type, 0, 0), sync_p)
      }
    } else {
      -- Not punctuation where { expected: report and sync
      eprint_span(src, name_start)
      eprint("error: expected '{' in function body\n")
      let sync_p = sync_to_decl(toks, p)
      let dummy = node_new(8, name_start, name_len, params, node_new(1, 0, 0, 0, 0))
      pack(node_new(23, dummy, ret_type, 0, 0), sync_p)
    }
  }
}

fn parse_ret_type(toks: i64, src: i64, pos: i64) -> i64 {
  if tok_tag(toks, pos) == 6 {
    parse_type(toks, src, pos + 1)
  } else { pack(0, pos) }
}

fn parse_module(toks: i64, src: i64, tt: i64) -> i64 {
  let fns = nlist_new()
  let mut p = 0
  let mut done = 0
  while done == 0 {
    let tag = tok_tag(toks, p)
    if tag == 7 { done = 1 }
    else { if tag == 3 {
      let kw = tok_v1(toks, p)
      if kw == 1 {
        let old_p = p
        let r = parse_fn(toks, src, p + 1)
        let new_p = unpack_pos(r)
        if new_p <= old_p {
          -- Parser stuck: report error and skip to next declaration
          eprint_span(src, tok_v1(toks, p + 1))
          eprint("error: malformed function declaration\n")
          p = sync_to_decl(toks, p + 1)
        } else {
          let pair = node_new(0, unpack_node(r), src, 0, 0)
          nlist_add(fns, pair)
          p = new_p
        }
      } else { if kw == 9 {
        let old_p = p
        let new_p = parse_type_decl(toks, src, p + 1, tt)
        if new_p <= old_p {
          eprint_span(src, tok_v1(toks, p + 1))
          eprint("error: malformed type declaration\n")
          p = sync_to_decl(toks, p + 1)
        } else { p = new_p }
      } else { if kw == 19 {
        p = parse_use(toks, src, p + 1, fns, tt)
      } else {
        p = p + 1
      } } }
    } else {
      -- Unexpected token at module level: skip to next declaration
      if tag != 5 {
        eprint_span(src, tok_v1(toks, p))
        eprint("error: unexpected token at module level\n")
      } else { 0 }
      p = p + 1
    } }
  }
  fns
}

fn is_file_loaded(loaded: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let mut i = 0
  let mut found = false
  while i < nlist_len(loaded) {
    let entry = nlist_get(loaded, i)
    let e_ptr = __mem_load64(entry)
    let e_len = __mem_load64(entry + 8)
    if e_len == nl {
      if src_eq_at(src, ns, e_ptr, 0, nl) == 1 {
        found = true
        i = nlist_len(loaded)
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  found
}

fn mark_file_loaded(loaded: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let entry = __bump_alloc(16)
  __mem_store64(entry, src + ns)
  __mem_store64(entry + 8, nl)
  nlist_add(loaded, entry)
}

fn parse_use(toks: i64, src: i64, pos: i64, fns: i64, tt: i64) -> i64 {
  let path_ns = tok_v1(toks, pos)
  let path_nl = tok_v2(toks, pos)
  let loaded = __mem_load64(tt + 24)
  if is_file_loaded(loaded, src, path_ns, path_nl) {
    pos + 1
  } else {
    mark_file_loaded(loaded, src, path_ns, path_nl)
    let path = __bump_alloc(16)
    __mem_store64(path, src + path_ns)
    __mem_store64(path + 8, path_nl)
    let file_r = read_file(path)
    let file_buf = __mem_load64(file_r)
    let file_len = __mem_load64(file_r + 8)
    if file_len > 0 {
      let file_toks = lex(file_buf, file_len)
      parse_use_module(file_toks, file_buf, fns, tt)
    } else { 0 }
    pos + 1
  }
}

fn parse_use_module(toks: i64, src: i64, fns: i64, tt: i64) -> i64 {
  let mut p = 0
  let mut done = 0
  while done == 0 {
    let tag = tok_tag(toks, p)
    if tag == 7 { done = 1 }
    else { if tag == 3 {
      let kw = tok_v1(toks, p)
      if kw == 1 {
        let old_p = p
        let r = parse_fn(toks, src, p + 1)
        let new_p = unpack_pos(r)
        if new_p <= old_p {
          eprint_span(src, tok_v1(toks, p + 1))
          eprint("error: malformed function declaration\n")
          p = sync_to_decl(toks, p + 1)
        } else {
          let pair = node_new(0, unpack_node(r), src, 0, 0)
          nlist_add(fns, pair)
          p = new_p
        }
      } else { if kw == 9 {
        let old_p = p
        let new_p = parse_type_decl(toks, src, p + 1, tt)
        if new_p <= old_p {
          eprint_span(src, tok_v1(toks, p + 1))
          eprint("error: malformed type declaration\n")
          p = sync_to_decl(toks, p + 1)
        } else { p = new_p }
      } else { if kw == 19 {
        p = parse_use(toks, src, p + 1, fns, tt)
      } else { p = p + 1 } } }
    } else { p = p + 1 } }
  }
  0
}

-- Parse type declaration: type Name { fields_or_variants }
fn parse_type_decl(toks: i64, src: i64, pos: i64, tt: i64) -> i64 {
  -- pos is after "type" keyword
  let type_ns = tok_v1(toks, pos)
  let type_nl = tok_v2(toks, pos)
  -- skip name, skip {
  let p = pos + 2
  -- Detect record vs variant: if first field has : -> record
  let first_tag = tok_tag(toks, p + 1)
  let first_v1 = tok_v1(toks, p + 1)
  if first_tag == 5 {
    if first_v1 == 6 {
      -- Record: fields are name: type, ...
      let fields = __bump_alloc(256)
      let end_pos = parse_record_fields(toks, src, p, fields)
      let nfields = __mem_load64(fields + 240)
      ttable_add(tt, type_ns, type_nl, 0, nfields, fields)
      end_pos
    } else {
      -- Variant: constructors are Name(type) or Name, ...
      let variants = __bump_alloc(512)
      let end_pos = parse_variant_fields(toks, src, p, variants, src)
      let nvariants = __mem_load64(variants + 496)
      ttable_add(tt, type_ns, type_nl, 1, nvariants, variants)
      end_pos
    }
  } else {
    -- Variant (starts with ident not followed by :)
    let variants = __bump_alloc(512)
    let end_pos = parse_variant_fields(toks, src, p, variants, src)
    let nvariants = __mem_load64(variants + 496)
    ttable_add(tt, type_ns, type_nl, 1, nvariants, variants)
    end_pos
  }
}

fn parse_record_fields(toks: i64, src: i64, pos: i64, fields: i64) -> i64 {
  -- Parse field_name: type, ...  until }
  let mut p = pos
  let mut i = 0
  let mut done = 0
  while done == 0 {
    let tag = tok_tag(toks, p)
    if tag == 5 {
      if tok_v1(toks, p) == 4 {
        -- } — end of fields
        done = 1
      } else {
        -- field_name: type
        let f_ns = tok_v1(toks, p)
        let f_nl = tok_v2(toks, p)
        __mem_store64(fields + i * 16, f_ns)
        __mem_store64(fields + i * 16 + 8, f_nl)
        p = skip_comma(toks, p + 3)
        i = i + 1
      }
    } else {
      let f_ns = tok_v1(toks, p)
      let f_nl = tok_v2(toks, p)
      __mem_store64(fields + i * 16, f_ns)
      __mem_store64(fields + i * 16 + 8, f_nl)
      p = skip_comma(toks, p + 3)
      i = i + 1
    }
  }
  __mem_store64(fields + 240, i)
  p + 1
}

fn parse_variant_fields(toks: i64, src: i64, pos: i64, variants: i64, src_base: i64) -> i64 {
  let mut p = pos
  let mut i = 0
  let mut done = 0
  while done == 0 {
    let tag = tok_tag(toks, p)
    if tag == 5 {
      if tok_v1(toks, p) == 4 {
        -- } — end of variants
        done = 1
      } else {
        p = p + 1
      }
    } else { if tag == 2 {
      -- Variant name
      let v_ns = tok_v1(toks, p)
      let v_nl = tok_v2(toks, p)
      let v_hash = str_hash(src_base, v_ns, v_nl)
      -- Check if followed by ( -> has payload
      let next_tag = tok_tag(toks, p + 1)
      let next_v1 = tok_v1(toks, p + 1)
      if next_tag == 5 {
        if next_v1 == 1 {
          -- Variant(type) — has 1 payload
          __mem_store64(variants + i * 32, v_ns)
          __mem_store64(variants + i * 32 + 8, v_nl)
          __mem_store64(variants + i * 32 + 16, v_hash)
          __mem_store64(variants + i * 32 + 24, 1)
          p = skip_comma(toks, p + 4)
          i = i + 1
        } else {
          -- No-payload variant
          __mem_store64(variants + i * 32, v_ns)
          __mem_store64(variants + i * 32 + 8, v_nl)
          __mem_store64(variants + i * 32 + 16, v_hash)
          __mem_store64(variants + i * 32 + 24, 0)
          p = skip_comma(toks, p + 1)
          i = i + 1
        }
      } else {
        -- No-payload variant (no punct after name)
        __mem_store64(variants + i * 32, v_ns)
        __mem_store64(variants + i * 32 + 8, v_nl)
        __mem_store64(variants + i * 32 + 16, v_hash)
        __mem_store64(variants + i * 32 + 24, 0)
        p = skip_comma(toks, p + 1)
        i = i + 1
      }
    } else {
      done = 1
    } }
  }
  __mem_store64(variants + 496, i)
  if tok_tag(toks, p) == 5 {
    if tok_v1(toks, p) == 4 { p + 1 } else { p }
  } else { p }
}
