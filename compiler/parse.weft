-- parse.weft — recursive descent parser with Pratt precedence
-- Parser functions return a two-word {node, pos} result cell.

use "compiler/lex.weft"
use "compiler/types.weft"
use "compiler/diagnose.weft"
use "compiler/package.weft"
use "compiler/source_trust.weft"
use "runtime/alloc.weft"
use "runtime/memory.weft"

-- span is an offset into src; the diagnostic carries the absolute address so
-- the renderer can resolve which loaded source buffer it belongs to.
fn parse_error(src: i64, span: i64, msg: str) -[Diagnose]> i64 {
  Diagnose.error(msg, if span >= 0 { src + span } else { span })
}

fn is_decl_keyword(kw: i64) -> bool {
  match kw {
    1 -> true    -- fn
    9 -> true    -- type
    19 -> true   -- use
    23 -> true   -- effect
    26 -> true   -- trait
    27 -> true   -- impl
    32 -> true   -- test
    _ -> false
  }
}

fn is_decl_start(toks: i64, pos: i64) -> i64 {
  if tok_tag(toks, pos) == 3 { is_decl_keyword(tok_v1(toks, pos)) } else { 0 }
}

-- Error recovery: skip to next declaration keyword (fn/type/use) or EOF
fn sync_to_decl(toks: i64, pos: i64) -> i64 {
  let mut p = pos
  let mut done = 0
  while done == 0 {
    let tag = tok_tag(toks, p)
    if tag == 7 { done = 1 }
    else { if tag == 3 {
      if is_decl_keyword(tok_v1(toks, p)) { done = 1 }
      else { p = p + 1 }
    } else { p = p + 1 } }
  }
  p
}

-- Lookahead: check if < at pos is a type arg delimiter (balanced > followed by ()
-- Tokens that can appear inside a type-argument list: identifiers,
-- comma, nested angles, the type operators | & ~ ?, parens and arrows
-- for function types, and effect-row/fixed-array brackets. Anything else proves the
-- `<` was a comparison. Without this guard the speculative scan below
-- ran to the next unrelated `>` in the file (or EOF): every `a < b`
-- comparison cost O(distance) — quadratic checking on comparison-heavy
-- files — and a later `> (` (e.g. `3 > (2 - 2)`) misparsed the
-- comparison as a generic call, rejecting valid programs.
fn is_type_arg_token(tag: i64, v1: i64) -> i64 {
  if tag == 1 { 1 }  -- integer length in [T; N]
  else { if tag == 2 { 1 }
  else { if tag == 6 { 1 }
  else { if tag == 11 { 1 }
  else { if tag == 12 { 1 }
  else { if tag == 3 {
    -- keyword `mut` for pointer types: *mut T
    if v1 == 5 { 1 } else { 0 }
  }
  else { if tag == 4 {
    -- < > nest; * heads pointer types (*mut i64)
    if v1 == 7 { 1 } else { if v1 == 8 { 1 } else { if v1 == 3 { 1 } else { 0 } } }
  }
  else { if tag == 5 {
    if v1 == 1 { 1 }
    else { if v1 == 2 { 1 }
    else { if v1 == 5 { 1 }
    else { if v1 == 9 { 1 }
    else { if v1 == 10 { 1 }
    else { if v1 == 11 { 1 }
    else { if v1 == 12 { 1 }
    else { if v1 == 13 { 1 }  -- ; in [T; N]
    else { if v1 == 14 { 1 }  -- ]
    else { if v1 == 17 { 1 } else { 0 } } } } } } } } } }
  } else { 0 } } } } } } } }
}

fn is_type_arg_start(toks: i64, pos: i64) -> i64 {
  let mut p = pos + 1
  let mut depth = 1
  let mut ok = 0
  let mut done = 0
  while done == 0 {
    let tag = tok_tag(toks, p)
    let v1 = tok_v1(toks, p)
    if tag == 7 { done = 1 }
    else { if is_type_arg_token(tag, v1) == 0 { done = 1 }
    else { if tag == 4 {
      if v1 == 7 { depth = depth + 1 p = p + 1 }
      else { if v1 == 8 {
        depth = depth - 1
        if depth == 0 {
          done = 1
          ok = if tok_tag(toks, p + 1) == 5 {
            -- Generic value calls use `(`; qualified effect references use
            -- `.` (`State<S>.get()`). Both make the angle list unambiguous.
            let next = tok_v1(toks, p + 1)
            if next == 1 or next == 8 { 1 } else { 0 }
          } else { 0 }
        } else { p = p + 1 }
      } else { p = p + 1 } }
    } else { p = p + 1 } } }
  }
  ok
}

-- Parse type arguments: <type1, type2, ...> — returns pack(nlist_of_types, pos_after_>)
fn parse_type_args(toks: i64, src: i64, pos: i64, tctx: i64) -> i64 {
  let args = nlist_new()
  let mut p = pos
  let mut done = 0
  while done == 0 {
    let tag = tok_tag(toks, p)
    if tag == 4 {
      if tok_v1(toks, p) == 8 { done = 1 }
      else {
        let ty_r = parse_type(toks, src, p, tctx)
        nlist_add(args, unpack_node(ty_r))
        p = skip_comma(toks, unpack_pos(ty_r))
      }
    } else { if tag == 7 { done = 1 }
    else {
      let ty_r = parse_type(toks, src, p, tctx)
      nlist_add(args, unpack_node(ty_r))
      p = skip_comma(toks, unpack_pos(ty_r))
    } }
  }
  let end = if tok_tag(toks, p) == 4 {
    if tok_v1(toks, p) == 8 { p + 1 } else { p }
  } else { p }
  pack(args, end)
}

-- Effect arrows spell their close as two ordinary punctuation tokens. Accept
-- the historical fused token as well so parser fixtures built from raw token
-- buffers remain valid during the transition.
fn parse_effect_close_end(toks: i64, pos: i64) -> i64 {
  if tok_tag(toks, pos) == 12 { pos + 1 }
  else { if tok_tag(toks, pos) == 5 and tok_v1(toks, pos) == 14 {
    if tok_tag(toks, pos + 1) == 4 and tok_v1(toks, pos + 1) == 8 { pos + 2 } else { pos }
  } else { pos } }
}

-- Parse generic call: name<type_args>(value_args)
-- AST tag 36 = GenericCall(type_args_list, inner_call_node, num_type_args, 0)
fn parse_generic_call(toks: i64, src: i64, pos: i64, ns: i64, nl: i64) -[Diagnose]> i64 {
  -- pos is at identifier, pos+1 is <
  let ta_r = parse_type_args(toks, src, pos + 2, mem_load64_at(toks, 24))
  let type_args = unpack_node(ta_r)
  let p = unpack_pos(ta_r)
  -- A dot after the type arguments is an instantiated effect reference;
  -- retain the same GenericCall wrapper around an Ident so the exact atom
  -- survives into checking and monomorphisation. Otherwise parse the normal
  -- generic value call.
  if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 8 {
    pack(node_new(36, type_args, node_new(2, ns, nl, 0, 0), nlist_len(type_args), 0), p)
  } else {
    let args = nlist_new()
    let call_r = parse_call_args(toks, src, p + 1, args, ns, nl)
    let call_node = unpack_node(call_r)
    let end = unpack_pos(call_r)
    pack(node_new(36, type_args, call_node, nlist_len(type_args), 0), end)
  }
}

fn parse_ident_or_call(toks: i64, src: i64, pos: i64) -[Diagnose]> i64 {
  let v1 = tok_v1(toks, pos)
  let v2 = tok_v2(toks, pos)
  if src_eq(src, v1, v2, "nil") == 1 {
    pack(parse_nil_expr(), pos + 1)
  } else {
    -- Check for generic call: name<type_args>(value_args)
    let next_tag = tok_tag(toks, pos + 1)
    let next_v1 = tok_v1(toks, pos + 1)
    if next_tag == 4 {
    if next_v1 == 7 {
      if is_type_arg_start(toks, pos + 1) == 1 {
        parse_generic_call(toks, src, pos, v1, v2)
      } else { pack(node_new(2, v1, v2, 0, 0), pos + 1) }
    } else { pack(node_new(2, v1, v2, 0, 0), pos + 1) }
  } else { if next_tag == 5 {
    if next_v1 == 1 {
      -- Function call: ident(args)
      parse_call(toks, src, pos, v1, v2)
    } else { if next_v1 == 3 {
      -- Check for record constructor: UpperCase { field: value, ... }
      -- Disambiguate from match arms / bare block: peek for ident followed by :
      let first_ch = mem_load8_at(src, v1)
      if first_ch >= 65 {
        if first_ch <= 90 {
          -- Uppercase + { — record literal only if second-inside token is :
          let inside_tag = tok_tag(toks, pos + 3)
          let inside_v1 = tok_v1(toks, pos + 3)
          if inside_tag == 5 {
            if inside_v1 == 6 {
              parse_record_lit(toks, src, pos)
            } else { pack(node_new(2, v1, v2, 0, 0), pos + 1) }
          } else { pack(node_new(2, v1, v2, 0, 0), pos + 1) }
        } else { pack(node_new(2, v1, v2, 0, 0), pos + 1) }
      } else { pack(node_new(2, v1, v2, 0, 0), pos + 1) }
    } else {
      pack(node_new(2, v1, v2, 0, 0), pos + 1)
    } }
  } else {
    pack(node_new(2, v1, v2, 0, 0), pos + 1)
  } } }
}

fn parse_call(toks: i64, src: i64, pos: i64, name_start: i64, name_len: i64) -[Diagnose]> i64 {
  -- pos is at ident, pos+1 is (, parse args until )
  let args = nlist_new()
  parse_call_args(toks, src, pos + 2, args, name_start, name_len)
}

fn parse_call_args(toks: i64, src: i64, pos: i64, args: i64, ns: i64, nl: i64) -[Diagnose]> i64 {
  let mut p = pos
  let mut done = 0
  while done == 0 {
    let tag = tok_tag(toks, p)
    let v1 = tok_v1(toks, p)
    -- Check for )
    if tag == 5 {
      if v1 == 2 { done = 1 }
      else {
        p = parse_one_call_arg(toks, src, p, args)
      }
    } else {
      p = parse_one_call_arg(toks, src, p, args)
    }
  }
  pack(node_new(4, ns, nl, args, nlist_len(args)), p + 1)
}

-- Parse one call argument. Handles named args: `label: expr`
-- Named args are detected when: ident followed by : followed by expr
-- (not a keyword, not at end of args)
fn parse_one_call_arg(toks: i64, src: i64, pos: i64, args: i64) -[Diagnose]> i64 {
  -- Check for named arg: ident : expr
  -- ident is tag 2, colon is tag 5 val 6
  let is_named = if tok_tag(toks, pos) == 2 {
    if tok_tag(toks, pos + 1) == 5 {
      if tok_v1(toks, pos + 1) == 6 {
        -- Could be named arg. But also could be `x: i64` in a lambda param.
        -- In call context, ident: is always a named arg label.
        1
      } else { 0 }
    } else { 0 }
  } else { 0 }
  if is_named == 1 {
    -- 4a S5: call-site argument labels were parsed and silently DISCARDED —
    -- never validated against the declaration, never reordered. Until
    -- named-argument semantics land (kernel §4.1/Appendix D, deferred per
    -- done/syntax-refinement.md), a label the user writes is a loud error,
    -- not a no-op.
    parse_error(src, tok_span(toks, pos), "error: call-site argument labels are not supported yet")
    let r = parse_expr(toks, src, pos + 2, 0)
    nlist_add(args, unpack_node(r))
    skip_comma(toks, unpack_pos(r))
  } else {
    let r = parse_expr(toks, src, pos, 0)
    nlist_add(args, unpack_node(r))
    skip_comma(toks, unpack_pos(r))
  }
}

fn skip_comma(toks: i64, pos: i64) -> i64 {
  if tok_tag(toks, pos) == 5 {
    match tok_v1(toks, pos) {
      5 -> pos + 1
      13 -> pos + 1
      _ -> pos
    }
  } else { pos }
}

-- Array literals use commas like call arguments and also accept the lexer's
-- automatic newline separator. A source `;` is deliberately distinct: the
-- kernel does not have Rust-style `[value; N]` repetition syntax.
fn parse_array_skip_newlines(toks: i64, src: i64, pos: i64) -> i64 {
  let mut p = pos
  let mut done = 0
  while done == 0 and tok_tag(toks, p) == 5 and tok_v1(toks, p) == 13 {
    let span = tok_span(toks, p)
    if mem_load8_at(src, span) == 59 { done = 1 } else { p = p + 1 }
  }
  p
}

fn parse_array_literal(toks: i64, src: i64, pos: i64) -[Diagnose]> i64 {
  let elements = nlist_new()
  let open_span = tok_span(toks, pos)
  let mut p = parse_array_skip_newlines(toks, src, pos + 1)
  let mut done = 0
  if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 14 { done = 1 p = p + 1 } else { 0 }
  while done == 0 {
    let elem_r = parse_expr(toks, src, p, 0)
    nlist_add(elements, unpack_node(elem_r))
    p = unpack_pos(elem_r)
    if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 14 {
      done = 1
      p = p + 1
    } else { if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 5 {
      p = parse_array_skip_newlines(toks, src, p + 1)
      if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 14 { done = 1 p = p + 1 } else { 0 }
    } else { if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 13 {
      let sep_span = tok_span(toks, p)
      if mem_load8_at(src, sep_span) == 59 {
        parse_error(src, sep_span, "error: array repetition syntax is not supported; write every element")
        done = 1
        p = parse_skip_balanced(toks, pos, 17, 14)
      } else {
        p = parse_array_skip_newlines(toks, src, p + 1)
        if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 14 { done = 1 p = p + 1 } else { 0 }
      }
    } else {
      parse_error(src, tok_span(toks, p), "error: expected ',' or ']' in array literal")
      done = 1
      p = parse_skip_balanced(toks, pos, 17, 14)
    } } }
  }
  pack(node_new(58, elements, nlist_len(elements), 0, open_span), p)
}

-- Parse for loop: for i in start..end { body } or for item in collection { body }
-- Range form: desugars to let mut i = start { while i < end { let i = i { body }; i = i + 1 } }
-- Iterator form: desugars to handle { let mut it = collection while true { let item = it.next() body } } { Fail.fail(_) -> resume(nil) }
fn parse_for(toks: i64, src: i64, pos: i64) -[Diagnose]> i64 {
  -- pos is after "for" keyword
  let var_ns = tok_v1(toks, pos)
  let var_nl = tok_v2(toks, pos)
  -- Expect "in" (keyword 30)
  let p1 = pos + 1
  let p2 = if tok_tag(toks, p1) == 3 {
    if tok_v1(toks, p1) == 30 { p1 + 1 } else { p1 }
  } else { p1 }
  -- Parse the iterable expression (range or collection)
  let iter_r = parse_expr(toks, src, p2, 0)
  let iter_node = unpack_node(iter_r)
  let p3 = unpack_pos(iter_r)
  -- Parse body block
  let body_r = parse_block(toks, src, p3 + 1)
  let body_node = unpack_node(body_r)
  let p4 = unpack_pos(body_r)
  -- Check if range form: BinOp(20, start, end)
  let is_range = if node_tag(iter_node) == 3 {
    if node_f1(iter_node) == 20 { 1 } else { 0 }
  } else { 0 }
  if is_range == 1 {
    parse_for_range(var_ns, var_nl, node_f2(iter_node), node_f3(iter_node), body_node, p4)
  } else {
    parse_for_iter(var_ns, var_nl, iter_node, body_node, p4)
  }
}

-- Range-based for: for i in start..end { body }
fn parse_for_range(var_ns: i64, var_nl: i64, range_start: i64, range_end: i64, body_node: i64, p4: i64) -> i64 {
  let incr = node_new(12, var_ns, var_nl, node_new(3, 1, node_new(2, var_ns, var_nl, 0, 0), node_new(1, 1, 0, 0, 0), 0), 0)
  let body_index = node_new(6, var_ns, var_nl, node_new(2, var_ns, var_nl, 0, 0), body_node)
  let body_with_incr = node_new(7, body_index, incr, 0, 0)
  let cond = node_new(3, 7, node_new(2, var_ns, var_nl, 0, 0), range_end, 0)
  let while_node = node_new(10, cond, body_with_incr, 0, 0)
  let for_node = node_new(11, var_ns, var_nl, range_start, while_node)
  pack(for_node, p4)
}

-- Iterator-based for: for item in collection { body }
-- Currently supports List iteration (Cons/Nil walk).
-- Desugars to:
--   let mut __cur = collection
--   let mut __done = 0
--   while __done == 0 {
--     let __tag = list_tag(__cur)
--     if __tag == Nil { __done = 1 }
--     else { let item = list_head(__cur)  body  __cur = list_tail(__cur) }
--   }
-- Uses AST tag 47 = ForIter(var_ns, var_nl, collection, body) for codegen.
fn parse_for_iter(var_ns: i64, var_nl: i64, collection: i64, body_node: i64, p4: i64) -> i64 {
  pack(node_new(47, var_ns, var_nl, collection, body_node), p4)
}

fn parse_while(toks: i64, src: i64, pos: i64) -[Diagnose]> i64 {
  -- pos is after "while" keyword
  let cond_r = parse_expr(toks, src, pos, 0)
  let cond = unpack_node(cond_r)
  let p1 = unpack_pos(cond_r)
  let body_r = parse_block(toks, src, p1 + 1)
  let body = unpack_node(body_r)
  let p2 = unpack_pos(body_r)
  pack(node_new(10, cond, body, 0, 0), p2)
}

-- Parse match expression: match expr { Pattern -> expr, ... }
-- AST tag 15 = Match(scrutinee, arms_list, num_arms, 0)
-- Each arm: node(16, pattern_node, body_node, 0, 0)
-- Pattern types:
--   node(17, 0, 0, 0, 0) = wildcard (_)
--   node(18, ns, nl, 0, 0) = binding (variable name)
--   node(19, value, start, len, 0) = int literal pattern
--   node(20, tag_ns, tag_nl, binding_ns, binding_nl) = constructor (Tag(x))
fn parse_pattern(toks: i64, src: i64, pos: i64) -> i64 {
  let tag = tok_tag(toks, pos)
  let v1 = tok_v1(toks, pos)
  if tag == 2 {
    parse_pat_ident(toks, src, pos, v1)
  } else { if tag == 1 {
    let lit_start = v1
    let lit_len = tok_v2(toks, pos)
    pack(node_new(19, decimal_span_value_wrapping(src, lit_start, lit_len), lit_start, lit_len, 0), pos + 1)
  } else {
    pack(node_new(17, 0, 0, 0, 0), pos + 1)
  } }
}

-- Ident in pattern: wildcard (_), uppercase -> constructor, `nil` ->
-- nil test (tag 61), lowercase -> binding — or typed binding (tag 60,
-- kernel §6.1) when a colon follows: `x: str -> ...`. The annotation
-- parses through parse_type, so it is a ty value like every other
-- annotation.
fn parse_pat_ident(toks: i64, src: i64, pos: i64, v1: i64) -> i64 {
  let v2 = tok_v2(toks, pos)
  let first_ch = mem_load8_at(src, v1)
  if first_ch == 95 {
    pack(node_new(17, 0, 0, 0, 0), pos + 1)
  } else { if first_ch >= 65 {
    if first_ch <= 90 {
      parse_pat_ctor(toks, src, pos, v1, v2)
    } else {
      parse_pat_lower_ident(toks, src, pos, v1, v2)
    }
  } else {
    parse_pat_lower_ident(toks, src, pos, v1, v2)
  } }
}

fn parse_pat_lower_ident(toks: i64, src: i64, pos: i64, v1: i64, v2: i64) -> i64 {
  if src_eq(src, v1, v2, "nil") == 1 {
    pack(node_new(61, v1, v2, 0, 0), pos + 1)
  } else {
    let has_colon = if tok_tag(toks, pos + 1) == 5 {
      if tok_v1(toks, pos + 1) == 6 { 1 } else { 0 }
    } else { 0 }
    if has_colon == 1 {
      let ty_r = parse_type(toks, src, pos + 2, 0)
      pack(node_new(60, v1, v2, unpack_node(ty_r), 0), unpack_pos(ty_r))
    } else {
      pack(node_new(18, v1, v2, 0, 0), pos + 1)
    }
  }
}

-- Constructor pattern: Name or Name(binding) or Name(b1, b2, ...)
-- For multi-payload: f3 = bindings list (nlist), f4 = num_bindings
-- For single-payload compat: f3 = binding_ns, f4 = binding_nl (when num=1)
-- New: tag 20 with f3 = nlist of binding nodes, f4 = count
fn parse_pat_ctor(toks: i64, src: i64, pos: i64, v1: i64, v2: i64) -> i64 {
  if tok_tag(toks, pos + 1) == 5 {
    if tok_v1(toks, pos + 1) == 1 {
      -- Has ( — parse bindings until )
      let bindings = nlist_new()
      let mut p = pos + 2
      let mut done = 0
      while done == 0 {
        if tok_tag(toks, p) == 5 {
          if tok_v1(toks, p) == 2 { done = 1 }
          else { if tok_v1(toks, p) == 5 { p = p + 1 }
          else { done = 1 } }
        } else { if tok_tag(toks, p) == 7 { done = 1 }
        else { if tok_tag(toks, p) == 2 {
          -- Binding or wildcard
          let b_ns = tok_v1(toks, p)
          let b_nl = tok_v2(toks, p)
          let first_ch = mem_load8_at(src, b_ns)
          if first_ch == 95 {
            nlist_add(bindings, node_new(17, 0, 0, 0, 0))
          } else {
            nlist_add(bindings, node_new(18, b_ns, b_nl, 0, 0))
          }
          p = p + 1
        } else { p = p + 1 } } }
      }
      -- Skip past )
      if tok_tag(toks, p) == 5 {
        if tok_v1(toks, p) == 2 { p = p + 1 } else { p = p }
      } else { p = p }
      let nb = nlist_len(bindings)
      if nb == 1 {
        -- Single binding: store directly in f3/f4 for backward compat
        let b = nlist_get(bindings, 0)
        if node_tag(b) == 18 {
          pack(node_new(20, v1, v2, node_f1(b), node_f2(b)), p)
        } else {
          pack(node_new(20, v1, v2, bindings, 0 - nb), p)
        }
      } else {
        -- Multi-binding: store list pointer in f3, count in f4
        -- Use a negative count to distinguish from single binding (nl > 0)
        pack(node_new(20, v1, v2, bindings, 0 - nb), p)
      }
    } else {
      pack(node_new(20, v1, v2, 0, 0), pos + 1)
    }
  } else {
    pack(node_new(20, v1, v2, 0, 0), pos + 1)
  }
}


fn parse_match(toks: i64, src: i64, pos: i64) -[Diagnose]> i64 {
  -- pos is after "match" keyword
  let scrutinee_r = parse_expr(toks, src, pos, 0)
  let scrutinee = unpack_node(scrutinee_r)
  let p1 = unpack_pos(scrutinee_r)
  -- expect {
  let arms = nlist_new()
  let p2 = parse_match_arms(toks, src, p1 + 1, arms)
  let n_arms = nlist_len(arms)
  let nd = node_new(15, scrutinee, arms, n_arms, 0)
  pack(nd, p2)
}
fn parse_match_arms(toks: i64, src: i64, pos: i64, arms: i64) -[Diagnose]> i64 {
  -- Skip semicolons between arms (from newlines)
  let p = skip_semicolons(toks, pos)
  if tok_tag(toks, p) == 5 {
    if tok_v1(toks, p) == 4 { p + 1 }
    else { parse_one_match_arm(toks, src, p, arms) }
  } else {
    parse_one_match_arm(toks, src, p, arms)
  }
}
fn parse_one_match_arm(toks: i64, src: i64, pos: i64, arms: i64) -[Diagnose]> i64 {
  -- Parse: pattern [if guard] -> expr
  let pat = parse_pattern(toks, src, pos)
  let pat_node = unpack_node(pat)
  let p1 = unpack_pos(pat)
  -- Check for guard: if (keyword 3)
  let guard_r = if tok_tag(toks, p1) == 3 {
    if tok_v1(toks, p1) == 3 {
      parse_expr(toks, src, p1 + 1, 0)
    } else { pack(0, p1) }
  } else { pack(0, p1) }
  let guard_node = unpack_node(guard_r)
  let p2 = unpack_pos(guard_r)
  -- Expect -> (Arrow, tag 6)
  let p3 = if tok_tag(toks, p2) == 6 { p2 + 1 } else { p2 }
  -- Parse body expression
  let body_r = parse_expr(toks, src, p3, 0)
  let body_node = unpack_node(body_r)
  let p4 = unpack_pos(body_r)
  let arm = node_new(16, pat_node, body_node, guard_node, 0)
  nlist_add(arms, arm)
  let p5 = skip_comma(toks, p4)
  parse_match_arms(toks, src, p5, arms)
}

fn parse_if(toks: i64, src: i64, pos: i64) -[Diagnose]> i64 {
  -- pos is after "if" keyword
  -- Check for "if let" → desugar to match
  if tok_tag(toks, pos) == 3 {
    if tok_v1(toks, pos) == 2 {
      parse_if_let(toks, src, pos + 1)
    } else { parse_if_cond(toks, src, pos) }
  } else { parse_if_cond(toks, src, pos) }
}

fn parse_nil_expr() -> i64 {
  node_new(51, 0, 0, 0, 0)
}

fn parse_discard_to_nil(expr: i64) -> i64 {
  node_new(7, expr, parse_nil_expr(), 0, 0)
}

-- Parse defer cleanup; rest-of-scope. AST tag 52 = Defer(cleanup, body).
-- The parser nests multiple defers so codegen's body-then-cleanup order is LIFO.
fn parse_defer(toks: i64, src: i64, pos: i64) -[Diagnose]> i64 {
  -- pos is after "defer" keyword
  let cleanup_r = parse_expr(toks, src, pos, 0)
  let cleanup = unpack_node(cleanup_r)
  let p1 = skip_semicolons(toks, unpack_pos(cleanup_r))
  let next_tag = tok_tag(toks, p1)
  let body_r = if next_tag == 5 {
    if tok_v1(toks, p1) == 4 { pack(parse_nil_expr(), p1) }
    else { parse_block_stmts(toks, src, p1) }
  } else { if next_tag == 7 {
    pack(parse_nil_expr(), p1)
  } else {
    parse_block_stmts(toks, src, p1)
  } }
  pack(node_new(52, cleanup, unpack_node(body_r), 0, 0), unpack_pos(body_r))
}

-- Parse if-let: if let Pattern = scrutinee { body } [else { else_body }]
-- Desugars to: match scrutinee { Pattern -> body, _ -> else_body }
fn parse_if_let(toks: i64, src: i64, pos: i64) -[Diagnose]> i64 {
  -- pos is after "let"
  -- Parse pattern
  let pat_r = parse_pattern(toks, src, pos)
  let pat = unpack_node(pat_r)
  let p1 = unpack_pos(pat_r)
  -- Expect = (punct tag 5, val 7)
  let p2 = if tok_tag(toks, p1) == 5 {
    if tok_v1(toks, p1) == 7 { p1 + 1 } else { p1 }
  } else { p1 }
  -- Parse scrutinee expression
  let scr_r = parse_expr(toks, src, p2, 0)
  let scrutinee = unpack_node(scr_r)
  let p3 = unpack_pos(scr_r)
  -- Parse then block
  let then_r = parse_block(toks, src, p3 + 1)
  let then_body = unpack_node(then_r)
  let p4 = unpack_pos(then_r)
  -- Build match: match scrutinee { Pattern -> then_body, _ -> else_body }
  let arms = nlist_new()
  if tok_tag(toks, p4) == 3 {
    if tok_v1(toks, p4) == 4 {
      let else_r = parse_block(toks, src, p4 + 2)
      let else_body = unpack_node(else_r)
      let p5 = unpack_pos(else_r)
      nlist_add(arms, node_new(16, pat, then_body, 0, 0))
      nlist_add(arms, node_new(16, node_new(17, 0, 0, 0, 0), else_body, 0, 0))
      pack(node_new(15, scrutinee, arms, 2, 0), p5)
    } else {
      nlist_add(arms, node_new(16, pat, parse_discard_to_nil(then_body), 0, 0))
      nlist_add(arms, node_new(16, node_new(17, 0, 0, 0, 0), parse_nil_expr(), 0, 0))
      pack(node_new(15, scrutinee, arms, 2, 0), p4)
    }
  } else {
    nlist_add(arms, node_new(16, pat, parse_discard_to_nil(then_body), 0, 0))
    nlist_add(arms, node_new(16, node_new(17, 0, 0, 0, 0), parse_nil_expr(), 0, 0))
    pack(node_new(15, scrutinee, arms, 2, 0), p4)
  }
}

fn parse_if_cond(toks: i64, src: i64, pos: i64) -[Diagnose]> i64 {
  -- Regular if: condition { body } else { body }
  let cond_r = parse_expr(toks, src, pos, 0)
  let cond = unpack_node(cond_r)
  let p1 = unpack_pos(cond_r)
  -- expect { then_block }
  let then_r = parse_block(toks, src, p1 + 1)
  let then_n = unpack_node(then_r)
  let p2 = unpack_pos(then_r)
  -- expect "else" { else_block }
  if tok_tag(toks, p2) == 3 {
    if tok_v1(toks, p2) == 4 {
      let else_r = parse_block(toks, src, p2 + 2)
      let else_n = unpack_node(else_r)
      let p3 = unpack_pos(else_r)
      pack(node_new(5, cond, then_n, else_n, 0), p3)
    } else {
      pack(node_new(5, cond, parse_discard_to_nil(then_n), parse_nil_expr(), 0), p2)
    }
  } else {
    pack(node_new(5, cond, parse_discard_to_nil(then_n), parse_nil_expr(), 0), p2)
  }
}

fn parse_let(toks: i64, src: i64, pos: i64) -[Diagnose]> i64 {
  -- pos is after "let" keyword
  -- check for "mut"
  let is_mut = if tok_tag(toks, pos) == 3 {
    if tok_v1(toks, pos) == 5 { 1 } else { 0 }
  } else { 0 }
  let p = if is_mut == 1 { pos + 1 } else { pos }
  -- expect ident [: type] = expr
  let name_start = tok_v1(toks, p)
  let name_len = tok_v2(toks, p)
  -- check for : (type annotation) after ident
  let has_ann = if tok_tag(toks, p + 1) == 5 {
    if tok_v1(toks, p + 1) == 6 { 1 } else { 0 }
  } else { 0 }
  let ann_r = if has_ann == 1 {
    let tctx = mem_load64_at(toks, 24)
    parse_type(toks, src, p + 2, tctx)
  } else { pack(0, p + 1) }
  let ann_type = unpack_node(ann_r)
  let p_eq = unpack_pos(ann_r)
  -- skip = (Punct 7)
  let val_r = parse_expr(toks, src, p_eq + 1, 0)
  let val_n = unpack_node(val_r)
  let p2 = unpack_pos(val_r)
  -- the rest of the block is the body
  let body_r = parse_block_stmts(toks, src, p2)
  let body_n = unpack_node(body_r)
  let p3 = unpack_pos(body_r)
  -- tag 6 = Let (immutable), tag 11 = LetMut (mutable)
  -- tag 37 = LetTyped wraps inner let with annotation type
  let node_tag = if is_mut == 1 { 11 } else { 6 }
  let inner = node_new(node_tag, name_start, name_len, val_n, body_n)
  if ann_type != 0 {
    pack(node_new(37, inner, ann_type, 0, 0), p3)
  } else {
    pack(inner, p3)
  }
}

fn parse_block(toks: i64, src: i64, pos: i64) -[Diagnose]> i64 {
  -- pos is after {, parse stmts until }
  -- Handle EOF or unexpected token gracefully
  if tok_tag(toks, pos) == 7 {
    parse_error(src, tok_span(toks, pos), "error: expected '}' before end of file")
    pack(node_new(1, 0, 0, 0, 0), pos)
  }
  else {
    let r = parse_block_stmts(toks, src, pos)
    let n = unpack_node(r)
    let p = unpack_pos(r)
    if tok_tag(toks, p) == 7 {
      parse_error(src, tok_span(toks, p), "error: expected '}' before end of file")
      pack(n, p)
    }
    else { if is_decl_start(toks, p) == 1 {
      parse_error(src, tok_span(toks, p), "error: expected '}' before declaration")
      pack(n, p)
    } else { pack(n, p + 1) } }
  }
}

fn parse_block_stmts(toks: i64, src: i64, pos: i64) -[Diagnose]> i64 {
  -- Skip leading semicolons (from newlines)
  let p0 = skip_semicolons(toks, pos)
  -- Parse expressions until } or EOF. Returns position AT } (not past it).
  let tag = tok_tag(toks, p0)
  let v1 = tok_v1(toks, p0)
  if is_decl_start(toks, p0) == 1 {
    pack(node_new(1, 0, 0, 0, 0), p0)
  } else { if tag == 5 {
    if v1 == 4 {
      pack(node_new(1, 0, 0, 0, 0), p0)
    } else {
      parse_block_one(toks, src, p0)
    }
  } else { if tag == 7 {
    pack(node_new(1, 0, 0, 0, 0), p0)
  } else {
    parse_block_one(toks, src, p0)
  } } }
}

fn parse_maybe_ptr_assign_from_lhs(toks: i64, src: i64, lhs_r: i64) -[Diagnose]> i64 {
  let lhs = unpack_node(lhs_r)
  let lhs_pos = unpack_pos(lhs_r)
  if node_tag(lhs) == 56 and tok_tag(toks, lhs_pos) == 5 and tok_v1(toks, lhs_pos) == 7 {
    let val_r = parse_expr(toks, src, lhs_pos + 1, 0)
    pack(node_new(57, node_f1(lhs), unpack_node(val_r), 0, 0), unpack_pos(val_r))
  } else { lhs_r }
}

-- Check for assignment before parsing as a plain expression.
fn parse_maybe_assign(toks: i64, src: i64, pos: i64) -[Diagnose]> i64 {
  -- Assignment: Ident followed by = (Punct 7)
  if tok_tag(toks, pos) == 2 {
    if tok_tag(toks, pos + 1) == 5 {
      if tok_v1(toks, pos + 1) == 7 {
        let a_ns = tok_v1(toks, pos)
        let a_nl = tok_v2(toks, pos)
        let a_val_r = parse_expr(toks, src, pos + 2, 0)
        let a_node = node_new(12, a_ns, a_nl, unpack_node(a_val_r), 0)
        let a_pos = unpack_pos(a_val_r)
        pack(a_node, a_pos)
      } else { parse_maybe_ptr_assign_from_lhs(toks, src, parse_expr(toks, src, pos, 0)) }
    } else { parse_maybe_ptr_assign_from_lhs(toks, src, parse_expr(toks, src, pos, 0)) }
  } else {
    parse_maybe_ptr_assign_from_lhs(toks, src, parse_expr(toks, src, pos, 0))
  }
}

fn parse_block_one(toks: i64, src: i64, pos: i64) -[Diagnose]> i64 {
  let r = parse_maybe_assign(toks, src, pos)
  let n = unpack_node(r)
  let p = unpack_pos(r)
  -- Skip optional ; separator
  let p2 = skip_semicolons(toks, p)
  -- Check if next is } or eof — return AT } (don't consume)
  let next_tag = tok_tag(toks, p2)
  if is_decl_start(toks, p2) == 1 {
    pack(n, p2)
  } else { if next_tag == 5 {
    if tok_v1(toks, p2) == 4 { pack(n, p2) }
    else {
      let rest_r = parse_block_stmts(toks, src, p2)
      pack(node_new(7, n, unpack_node(rest_r), 0, 0), unpack_pos(rest_r))
    }
  } else { if next_tag == 7 {
    pack(n, p2)
  } else {
    -- More statements: wrap in Block(first, rest)
    let rest_r = parse_block_stmts(toks, src, p2)
    pack(node_new(7, n, unpack_node(rest_r), 0, 0), unpack_pos(rest_r))
  } } }
}

fn skip_semicolons(toks: i64, pos: i64) -> i64 {
  let mut p = pos
  let mut done = 0
  while done == 0 {
    if tok_tag(toks, p) == 5 {
      if tok_v1(toks, p) == 13 { p = p + 1 }
      else { done = 1 }
    } else { done = 1 }
  }
  p
}

-- Parse record literal: Name { field: value, ... }
-- AST tag 14 = RecordInit, f1=type_ns, f2=type_nl, f3=fields_list, f4=num_fields
fn parse_record_lit(toks: i64, src: i64, pos: i64) -[Diagnose]> i64 {
  let type_ns = tok_v1(toks, pos)
  let type_nl = tok_v2(toks, pos)
  -- skip Name {
  let fields = nlist_new()
  let end_pos = parse_record_lit_fields(toks, src, pos + 2, fields)
  let nf = nlist_len(fields)
  let nd = node_new(14, type_ns, type_nl, fields, nf)
  pack(nd, end_pos)
}
fn parse_record_lit_fields(toks: i64, src: i64, pos: i64, fields: i64) -[Diagnose]> i64 {
  -- Check for } (closing brace) first
  if tok_tag(toks, pos) == 5 {
    if tok_v1(toks, pos) == 4 { pos + 1 } else { pos }
  } else {
    -- Field: name : value
    let f_ns = tok_v1(toks, pos)
    let f_nl = tok_v2(toks, pos)
    -- skip field_name :
    let val_r = parse_expr(toks, src, pos + 2, 0)
    let val_n = unpack_node(val_r)
    let val_p = unpack_pos(val_r)
    let pair = node_new(2, f_ns, f_nl, val_n, 0)
    nlist_add(fields, pair)
    let p2 = skip_comma(toks, val_p)
    parse_record_lit_fields(toks, src, p2, fields)
  }
}

-- ══════════════════════════════════════════════════════════════
-- Handle expression: handle body { Effect.op(params) -> expr ... }
-- AST tag 33 = HandleExpr(body, clauses_list, num_clauses, 0)
-- AST tag 34 = HandleClause(name_info, params_list, body, continuation_name)
-- Effect op metadata: tag 53 = EffectOpMeta(ret_type, deferred_flag, 0, 0)
-- ══════════════════════════════════════════════════════════════

fn parse_is_deferred_marker(toks: i64, src: i64, pos: i64) -> i64 {
  if tok_tag(toks, pos) == 5 {
    if tok_v1(toks, pos) == 16 {
      if tok_tag(toks, pos + 1) == 2 {
        if src_eq(src, tok_v1(toks, pos + 1), tok_v2(toks, pos + 1), "deferred") == 1 { 1 } else { 0 }
      } else { 0 }
    } else { 0 }
  } else { 0 }
}

fn effect_op_meta(ret_type: i64, deferred: i64) -> i64 {
  if deferred == 1 { node_new(53, ret_type, 1, 0, 0) } else { ret_type }
}

fn parse_handle_clause_continuation(toks: i64, src: i64, pos: i64) -> i64 {
  if tok_tag(toks, pos) == 2 {
    if src_eq(src, tok_v1(toks, pos), tok_v2(toks, pos), "with") == 1 {
      if tok_tag(toks, pos + 1) == 2 {
        pack(node_new(0, tok_v1(toks, pos + 1), tok_v2(toks, pos + 1), 0, 0), pos + 2)
      } else { pack(0, pos + 1) }
    } else { pack(0, pos) }
  } else { pack(0, pos) }
}

fn parse_handle_expr(toks: i64, src: i64, pos: i64) -[Diagnose]> i64 {
  -- pos is after "handle" keyword
  -- Parse body expression (the handled computation)
  let body_r = parse_expr(toks, src, pos, 0)
  let body = unpack_node(body_r)
  let p = unpack_pos(body_r)
  -- Expect { after body
  let p2 = if tok_tag(toks, p) == 5 {
    if tok_v1(toks, p) == 3 { p + 1 } else { p }
  } else { p }
  -- Parse handler clauses until }. The optional `return v -> expr` clause
  -- (4c, kernel §7.3) rides a side holder: [0] = clause node, [1] = count.
  let clauses = nlist_new()
  let ret_holder = alloc_words(2)
  mem_store64_at(ret_holder, 0, 0)
  mem_store64_at(ret_holder, 8, 0)
  let end = parse_handle_clauses(toks, src, p2, clauses, ret_holder)
  pack(node_new(33, body, clauses, nlist_len(clauses), mem_load64_at(ret_holder, 0)), end)
}

-- 4c (kernel §7.3): `return v -> expr` — transforms the handled
-- expression's NORMAL completion; abortive clause values bypass it.
-- Node shape: node(0, binder_ns, binder_nl, body, 0) in handle f4.
fn parse_handle_return_clause(toks: i64, src: i64, pos: i64, ret_holder: i64) -[Diagnose]> i64 {
  let has_binder = if tok_tag(toks, pos + 1) == 2 { 1 } else { 0 }
  if has_binder == 0 {
    parse_error(src, tok_span(toks, pos), "error: expected value binder after 'return' in handler")
  } else { 0 }
  let v_ns = tok_v1(toks, pos + 1)
  let v_nl = tok_v2(toks, pos + 1)
  let p = if has_binder == 1 { pos + 2 } else { pos + 1 }
  let p2 = if tok_tag(toks, p) == 6 { p + 1 } else { p }
  let body_r = parse_expr(toks, src, p2, 0)
  if mem_load64_at(ret_holder, 8) > 0 {
    parse_error(src, tok_span(toks, pos), "error: at most one return clause per handler")
  } else {
    mem_store64_at(ret_holder, 0, node_new(0, v_ns, v_nl, unpack_node(body_r), 0))
  }
  mem_store64_at(ret_holder, 8, mem_load64_at(ret_holder, 8) + 1)
  skip_comma(toks, unpack_pos(body_r))
}

fn parse_handle_clauses(toks: i64, src: i64, pos: i64, clauses: i64, ret_holder: i64) -[Diagnose]> i64 {
  let p = skip_semicolons(toks, pos)
  let tag = tok_tag(toks, p)
  if tag == 5 {
    if tok_v1(toks, p) == 4 { p + 1 }
    else { parse_one_handle_clause(toks, src, p, clauses, ret_holder) }
  } else { if tag == 7 { p }
  else { if tag == 3 {
    if tok_v1(toks, p) == 20 {
      -- return clause (4c)
      let p_ret = parse_handle_return_clause(toks, src, p, ret_holder)
      parse_handle_clauses(toks, src, p_ret, clauses, ret_holder)
    } else { parse_one_handle_clause(toks, src, p, clauses, ret_holder) }
  } else { parse_one_handle_clause(toks, src, p, clauses, ret_holder) } } }
}

-- Parse: Effect[<type_args>].op(params) [with k] -> body
fn parse_one_handle_clause(toks: i64, src: i64, pos: i64, clauses: i64, ret_holder: i64) -[Diagnose]> i64 {
  -- Parse the effect reference. Qualified references use the same raw
  -- GenericCall(type_args, Ident) shape as qualified perform receivers.
  let eff_ns = tok_v1(toks, pos)
  let eff_nl = tok_v2(toks, pos)
  let eff_r = if tok_tag(toks, pos + 1) == 4 and tok_v1(toks, pos + 1) == 7 {
    let ta_r = parse_type_args(toks, src, pos + 2, mem_load64_at(toks, 24))
    let type_args = unpack_node(ta_r)
    pack(node_new(36, type_args, node_new(2, eff_ns, eff_nl, 0, 0), nlist_len(type_args), 0), unpack_pos(ta_r))
  } else {
    pack(node_new(2, eff_ns, eff_nl, 0, 0), pos + 1)
  }
  let effect_ref = unpack_node(eff_r)
  let after_effect = unpack_pos(eff_r)
  -- Expect .
  let p = if tok_tag(toks, after_effect) == 5 {
    if tok_v1(toks, after_effect) == 8 { after_effect + 1 } else { after_effect }
  } else { after_effect }
  -- Parse op name
  let op_ns = tok_v1(toks, p)
  let op_nl = tok_v2(toks, p)
  -- Parse params: (params) or no params
  let params = nlist_new()
  let p2 = if tok_tag(toks, p + 1) == 5 {
    if tok_v1(toks, p + 1) == 1 {
      parse_fn_params(toks, src, p + 2, params, 0)
    } else { p + 1 }
  } else { p + 1 }
  -- Optional deferred-continuation binder: with k
  let cont_r = parse_handle_clause_continuation(toks, src, p2)
  let cont = unpack_node(cont_r)
  let p_cont = unpack_pos(cont_r)
  -- Expect -> (Arrow, tag 6)
  let p3 = if tok_tag(toks, p_cont) == 6 { p_cont + 1 } else { p_cont }
  -- Parse clause body
  let body_r = parse_expr(toks, src, p3, 0)
  -- Store the effect reference plus op span. The nested effect reference is
  -- the single syntax fact consumed by checking, lowering, and formatting.
  let name_info = node_new(0, effect_ref, op_ns, op_nl, 0)
  let clause = node_new(34, name_info, params, unpack_node(body_r), cont)
  nlist_add(clauses, clause)
  let p4 = skip_comma(toks, unpack_pos(body_r))
  parse_handle_clauses(toks, src, p4, clauses, ret_holder)
}

-- Parse effect declaration: effect Name { fn op(...) -> T ... }
-- AST tag 30 = EffectDecl, stored in effect table
fn parse_effect_decl(toks: i64, src: i64, pos: i64, tt: i64) -[Diagnose]> i64 {
  -- pos is after "effect" keyword
  let name_ns = tok_v1(toks, pos)
  let name_nl = tok_v2(toks, pos)
  -- 4c: optional <T, U> effect type parameters after the name (kernel §7.1).
  -- Op signatures parse with these as tctx so E in op types becomes a TypeVar.
  let tparams_r = if tok_tag(toks, pos + 1) == 4 {
    if tok_v1(toks, pos + 1) == 7 {
      parse_type_params(toks, src, pos + 2)
    } else { pack(0, pos + 1) }
  } else { pack(0, pos + 1) }
  let etparams = unpack_node(tparams_r)
  let p_tp = unpack_pos(tparams_r)
  -- skip {
  let mut p = if tok_tag(toks, p_tp) == 5 {
    if tok_v1(toks, p_tp) == 3 { p_tp + 1 } else { p_tp }
  } else { p_tp }
  -- Parse operation declarations until }
  let ops = nlist_new()
  let mut done = 0
  while done == 0 {
    let tag = tok_tag(toks, p)
    if tag == 5 and tok_v1(toks, p) == 4 { done = 1 }
    else { if tag == 7 { done = 1 }
    else {
      let is_deferred = parse_is_deferred_marker(toks, src, p)
      let fn_pos = if is_deferred == 1 { p + 2 } else { p }
      if tok_tag(toks, fn_pos) == 3 {
      if tok_v1(toks, fn_pos) == 1 {
        -- [@deferred] fn op(...) -> T
        let op_ns = tok_v1(toks, fn_pos + 1)
        let op_nl = tok_v2(toks, fn_pos + 1)
        let params = nlist_new()
        let after_params = parse_fn_params(toks, src, fn_pos + 3, params, etparams)
        let ret_r = parse_ret_type(toks, src, after_params, etparams)
        let ret_wrap = unpack_node(ret_r)
        let ret_type = node_f1(ret_wrap)
        nlist_add(ops, node_new(31, op_ns, op_nl, params, effect_op_meta(ret_type, is_deferred)))
        p = unpack_pos(ret_r)
      } else { p = p + 1 }
    } else { p = p + 1 } } }
  }
  -- Store in effect table (reuse ttable with kind=2 for effects).
  -- 4c: effect type parameters ride the entry's tparams slot like type decls.
  ttable_add(tt, src, name_ns, name_nl, 2, nlist_len(ops), ops, etparams)
  if tok_tag(toks, p) == 5 {
    if tok_v1(toks, p) == 4 { p + 1 } else { p }
  } else { p }
}

-- Lookahead: check if tokens starting at pos (inside parens) form a lambda param list
-- followed by ) and =>. Scans without consuming. Returns 1 if lambda, 0 if grouped expr.
fn is_lambda_start(toks: i64, pos: i64) -> bool {
  -- Parameter types use the full type grammar, including nested function
  -- types and [T]/[T; N]. Look through the balanced outer parens and let
  -- parse_fn_params validate the contents once a following => proves this
  -- is a lambda rather than a grouped expression.
  let mut p = pos
  let mut depth = 1
  let mut done = false
  let mut ok = false
  while done == 0 {
    let tag = tok_tag(toks, p)
    if tag == 7 { done = 1 }
    else { if tag == 5 {
      let v = tok_v1(toks, p)
      if v == 1 { depth = depth + 1 p = p + 1 }
      else { if v == 2 {
        depth = depth - 1
        if depth == 0 {
          done = 1
          if tok_tag(toks, p + 1) == 10 { ok = true } else { 0 }
        } else { p = p + 1 }
      } else { p = p + 1 } }
    } else { p = p + 1 } }
  }
  ok
}

-- Parse multi-param lambda: (x, y) => body or (x: i64, y: str) => body
-- pos is after the opening (
fn parse_multi_lambda(toks: i64, src: i64, pos: i64) -[Diagnose]> i64 {
  let params = nlist_new()
  let after_params = parse_fn_params(toks, src, pos, params, 0)
  -- after_params should be past ). Next should be => (tag 10).
  let p = if tok_tag(toks, after_params) == 10 { after_params + 1 } else { after_params }
  let body_r = parse_expr(toks, src, p, 0)
  let nparams = nlist_len(params)
  pack(node_new(29, params, unpack_node(body_r), nparams, 0), unpack_pos(body_r))
}

-- parse_expr: combined primary + infix. No mutual recursion.
-- All sub-helpers (parse_if, parse_let, etc.) are defined BEFORE this.
fn parse_expr(toks: i64, src: i64, pos: i64, min_prec: i64) -[Diagnose]> i64 {
  -- Parse primary
  let tag = tok_tag(toks, pos)
  let v1 = tok_v1(toks, pos)
  let lhs_r = if tag == 1 {
    -- IntLit
    let lit_start = v1
    let lit_len = tok_v2(toks, pos)
    pack(node_new(1, decimal_span_value_wrapping(src, lit_start, lit_len), lit_start, lit_len, 0), pos + 1)
  } else { if tag == 13 {
    -- FloatLit: preserve source span for exact codegen-side decimal lowering.
    pack(node_new(54, v1, tok_v2(toks, pos), 0, 0), pos + 1)
  } else { if tag == 2 {
    -- Ident or call (record constructor handled in parse_ident_or_call)
    parse_ident_or_call(toks, src, pos)
  } else { if tag == 3 {
    if v1 == 3 { parse_if(toks, src, pos + 1) }
    else { if v1 == 2 { parse_let(toks, src, pos + 1) }
    else { if v1 == 8 { parse_while(toks, src, pos + 1) }
    else { if v1 == 29 { parse_for(toks, src, pos + 1) }
    else { if v1 == 10 { parse_match(toks, src, pos + 1) }
    else { if v1 == 11 {
      -- not expr: boolean negation (AST tag 22)
      let operand_r = parse_expr(toks, src, pos + 1, 13)
      let operand = unpack_node(operand_r)
      let op_pos = unpack_pos(operand_r)
      pack(node_new(22, operand, 0, 0, 0), op_pos)
    }
    else { if v1 == 20 {
      -- return expr (AST tag 25)
      let ret_r = parse_expr(toks, src, pos + 1, 0)
      pack(node_new(25, unpack_node(ret_r), 0, 0, 0), unpack_pos(ret_r))
    }
    else { if v1 == 21 {
      -- break or break(expr) (AST tag 26, f1 = value or 0)
      if tok_tag(toks, pos + 1) == 5 {
        if tok_v1(toks, pos + 1) == 1 {
          -- break(expr)
          let val_r = parse_expr(toks, src, pos + 2, 0)
          let p_after = unpack_pos(val_r)
          -- Skip past )
          let p_close = if tok_tag(toks, p_after) == 5 {
            if tok_v1(toks, p_after) == 2 { p_after + 1 } else { p_after }
          } else { p_after }
          pack(node_new(26, unpack_node(val_r), 0, 0, 0), p_close)
        } else { pack(node_new(26, 0, 0, 0, 0), pos + 1) }
      } else { pack(node_new(26, 0, 0, 0, 0), pos + 1) }
    }
    else { if v1 == 22 {
      -- continue (AST tag 27)
      pack(node_new(27, 0, 0, 0, 0), pos + 1)
    }
    else { if v1 == 31 {
      -- loop { body } — infinite loop, value determined by break(expr)
      -- Desugars to while true { body } but with break-value support (tag 49)
      let body_r = parse_block(toks, src, pos + 2)
      pack(node_new(49, unpack_node(body_r), 0, 0, 0), unpack_pos(body_r))
    }
    else { if v1 == 33 {
      parse_defer(toks, src, pos + 1)
    }
    else { if v1 == 24 {
      -- handle expr { clauses }
      parse_handle_expr(toks, src, pos + 1)
    }
    else { if v1 == 25 {
      -- resume(val) — AST tag 35
      let val_r = parse_expr(toks, src, pos + 1, 0)
      pack(node_new(35, unpack_node(val_r), 0, 0, 0), unpack_pos(val_r))
    }
    else { pack(node_new(1, 0, 0, 0, 0), pos + 1) } } } } } } } } } } } } }
  } else { if tag == 5 {
    if v1 == 10 {
      -- &expr / &mut expr: trusted raw address-of (AST tag 55).
      let is_mut = if tok_tag(toks, pos + 1) == 3 {
        if tok_v1(toks, pos + 1) == 5 { 1 } else { 0 }
      } else { 0 }
      let operand_pos = if is_mut == 1 { pos + 2 } else { pos + 1 }
      let operand_r = parse_expr(toks, src, operand_pos, 13)
      pack(node_new(55, is_mut, unpack_node(operand_r), 0, 0), unpack_pos(operand_r))
    } else { if v1 == 1 {
      -- ( — could be grouped expr or multi-param lambda
      if is_lambda_start(toks, pos + 1) {
        parse_multi_lambda(toks, src, pos + 1)
      } else {
        let inner = parse_expr(toks, src, pos + 1, 0)
        let inner_node = unpack_node(inner)
        let inner_pos = unpack_pos(inner) + 1
        pack(inner_node, inner_pos)
      }
    } else { if v1 == 3 {
      parse_block(toks, src, pos + 1)
    } else { if v1 == 17 {
      parse_array_literal(toks, src, pos)
    } else {
      pack(node_new(1, 0, 0, 0, 0), pos + 1)
    } } } }
  } else { if tag == 4 {
    if v1 == 2 {
      -- Unary minus: -expr -> 0 - expr
      let operand_r = parse_expr(toks, src, pos + 1, 12)
      let operand = unpack_node(operand_r)
      let operand_pos = unpack_pos(operand_r)
      pack(node_new(3, 2, node_new(1, 0, 0, 0, 0), operand, 0), operand_pos)
    } else {
      pack(node_new(1, 0, 0, 0, 0), pos + 1)
    }
  } else { if tag == 9 {
    -- BoolLit: AST tag 24 = BoolLit(value), codegen treats as IntLit
    pack(node_new(24, v1, 0, 0, 0), pos + 1)
  } else { if tag == 8 {
    -- StringLit: f1=source offset, f2=byte length
    -- Check for interpolation: scan for { in string bytes
    let str_start = v1
    let str_len = tok_v2(toks, pos)
    if str_has_interp(src, str_start, str_len) == 1 {
      pack(parse_interp_string(toks, src, str_start, str_len), pos + 1)
    } else {
      pack(node_new(9, str_start, str_len, 0, 0), pos + 1)
    }
  } else {
    pack(node_new(1, 0, 0, 0, 0), pos + 1)
  } } } } } } } }
  -- Check for lambda: ident => body
  let lhs_node = unpack_node(lhs_r)
  let lhs_pos = unpack_pos(lhs_r)
  if tok_tag(toks, lhs_pos) == 10 {
    -- Fat arrow => : this is a lambda
    if node_tag(lhs_node) == 2 {
      -- Single-param: x => body
      let params = nlist_new()
      nlist_add(params, node_new(2, node_f1(lhs_node), node_f2(lhs_node), 0, 0))
      let body_r = parse_expr(toks, src, lhs_pos + 1, 0)
      pack(node_new(29, params, unpack_node(body_r), 1, 0), unpack_pos(body_r))
    } else {
      -- Parenthesized params: already parsed as expr, but we treat as error for now
      -- TODO: multi-param lambda support
      pe_infix(toks, src, lhs_node, lhs_pos, min_prec)
    }
  } else {
    pe_infix(toks, src, lhs_node, lhs_pos, min_prec)
  }
}

fn pe_infix(toks: i64, src: i64, lhs: i64, pos: i64, min_prec: i64) -[Diagnose]> i64 {
  let tag = tok_tag(toks, pos)
  if tag == 4 {
    let op_id = tok_v1(toks, pos)
    let prec = op_prec(op_id)
    if prec > min_prec {
      if op_id == 19 {
        -- Pipe: lhs |> f(args) → f(lhs, args)  or  lhs |> f → f(lhs)
        let rhs_r = parse_expr(toks, src, pos + 1, prec)
        let rhs = unpack_node(rhs_r)
        let p2 = unpack_pos(rhs_r)
        let piped = if node_tag(rhs) == 4 {
          -- RHS is Call(ns, nl, args, nargs): prepend lhs to args
          let new_args = nlist_new()
          nlist_add(new_args, lhs)
          let old_args = node_f3(rhs)
          let old_n = node_f4(rhs)
          let mut ai = 0
          while ai < old_n {
            nlist_add(new_args, nlist_get(old_args, ai))
            ai = ai + 1
          }
          node_new(4, node_f1(rhs), node_f2(rhs), new_args, nlist_len(new_args))
        } else { if node_tag(rhs) == 36 {
          let inner = node_f2(rhs)
          if node_tag(inner) == 4 {
            -- RHS is GenericCall(type_args, Call(...)): prepend lhs to inner args
            let new_args = nlist_new()
            nlist_add(new_args, lhs)
            let old_args = node_f3(inner)
            let old_n = node_f4(inner)
            let mut ai = 0
            while ai < old_n {
              nlist_add(new_args, nlist_get(old_args, ai))
              ai = ai + 1
            }
            let call_node = node_new(4, node_f1(inner), node_f2(inner), new_args, nlist_len(new_args))
            node_new(36, node_f1(rhs), call_node, node_f3(rhs), 0)
          } else {
            node_new(3, op_id, lhs, rhs, 0)
          }
        } else { if node_tag(rhs) == 2 {
          -- RHS is Ident: wrap as f(lhs)
          let args = nlist_new()
          nlist_add(args, lhs)
          node_new(4, node_f1(rhs), node_f2(rhs), args, 1)
        } else {
          -- Fallback: treat as binop (shouldn't happen in practice)
          node_new(3, op_id, lhs, rhs, 0)
        } } }
        pe_infix(toks, src, piped, p2, min_prec)
      } else {
        let rhs_r = parse_expr(toks, src, pos + 1, prec)
        let rhs = unpack_node(rhs_r)
        let p2 = unpack_pos(rhs_r)
        let binop = node_new(3, op_id, lhs, rhs, 0)
        pe_infix(toks, src, binop, p2, min_prec)
      }
    } else { pack(lhs, pos) }
  } else { if tag == 5 {
    if tok_v1(toks, pos) == 8 {
      if tok_tag(toks, pos + 1) == 4 and tok_v1(toks, pos + 1) == 3 {
        -- Dot-star: pointer dereference read (AST tag 56).
        let deref = node_new(56, lhs, 0, 0, 0)
        pe_infix(toks, src, deref, pos + 2, min_prec)
      } else {
      -- Dot: field access or method/effect call
      let field_ns = tok_v1(toks, pos + 1)
      let field_nl = tok_v2(toks, pos + 1)
      -- Check if field is followed by ( → method/effect perform call
      if tok_tag(toks, pos + 2) == 5 {
        if tok_v1(toks, pos + 2) == 1 {
          -- .name( → method call / effect perform
          -- AST tag 32 = Perform(base, op_ns, op_nl, args)
          let args = nlist_new()
          let call_r = parse_call_args(toks, src, pos + 3, args, 0, 0)
          let perform = node_new(32, lhs, field_ns, field_nl, args)
          pe_infix(toks, src, perform, unpack_pos(call_r), min_prec)
        } else {
          let fa = node_new(13, lhs, field_ns, field_nl, 0)
          pe_infix(toks, src, fa, pos + 2, min_prec)
        }
      } else {
        let fa = node_new(13, lhs, field_ns, field_nl, 0)
        pe_infix(toks, src, fa, pos + 2, min_prec)
      }
      }
    } else { if tok_v1(toks, pos) == 12 {
      -- ? postfix operator: desugar expr? to
      -- match expr { Ok(v) -> v, Err(e) -> Fail.fail(e) }
      let desugar = parse_question_mark(lhs)
      pe_infix(toks, src, desugar, pos + 1, min_prec)
    } else { if tok_v1(toks, pos) == 15 {
      -- ?. optional chaining: expr?.field desugars to
      -- AST tag 48 = OptChain(base, field_ns, field_nl)
      -- Codegen: if base is nil, perform Maybe.none(); else access field
      let field_ns = tok_v1(toks, pos + 1)
      let field_nl = tok_v2(toks, pos + 1)
      let chain = node_new(48, lhs, field_ns, field_nl, 0)
      pe_infix(toks, src, chain, pos + 2, min_prec)
    } else { pack(lhs, pos) } } }
  } else { pack(lhs, pos) } }
}

-- Desugar expr? into: match expr { Ok(v) -> v, Err(e) -> Fail.fail(e) }
-- Uses synthetic AST nodes for the match arms.
fn parse_question_mark(expr: i64) -> i64 {
  -- Build: match expr { Ok(v) -> v, Err(e) -> Fail.fail(e) }
  let arms = nlist_new()
  -- Arm 1: Ok(v) -> v
  -- Pattern: constructor "Ok" with binding "v"
  -- We need source offsets for "Ok" and "v" — use synthetic nodes with hash-based matching
  -- Since we can't create source text, use tag 20 (constructor pattern) with
  -- f1/f2 pointing to the string "Ok" in the source... but we don't have it.
  --
  -- Simpler approach: desugar to a tag-based check.
  -- Result layout: [tag_hash, payload]. Ok and Err have different tag_hashes.
  -- Check tag_hash: if it matches Ok's hash, extract payload. Else perform Fail.
  --
  -- Even simpler: use the existing match infrastructure but with constructor patterns.
  -- The issue is we need source offsets for "Ok", "Err", "v", "e".
  -- We don't have them — ? appears at an arbitrary point in the source.
  --
  -- Solution: desugar to if-else based on tag check instead of match.
  -- tag_hash of Ok = str_hash(src, ok_offset, 2). But we don't have src here.
  --
  -- Pragmatic solution: desugar to a function call.
  -- __try_result(expr) which is a runtime function that checks Ok/Err.
  -- This avoids needing synthetic AST nodes.
  --
  -- Actually the cleanest solution: new AST tag 45 = TryExpr(inner_expr)
  -- Codegen handles it by emitting the match + Fail.fail inline.
  node_new(45, expr, 0, 0, 0)
}

-- ══════════════════════════════════════════════════════════════
-- Type expression parser
-- ══════════════════════════════════════════════════════════════
-- Precedence: ~ (tightest) > & > | (loosest), ? is postfix

fn parse_type(toks: i64, src: i64, pos: i64, tctx: i64) -> i64 {
  parse_type_union(toks, src, pos, tctx)
}

fn parse_type_union(toks: i64, src: i64, pos: i64, tctx: i64) -> i64 {
  let lhs_r = parse_type_inter(toks, src, pos, tctx)
  let mut result = unpack_node(lhs_r)
  let mut p = unpack_pos(lhs_r)
  let mut done = 0
  while done == 0 {
    if tok_tag(toks, p) == 5 {
      if tok_v1(toks, p) == 9 {
        let rhs_r = parse_type_inter(toks, src, p + 1, tctx)
        result = ty_union(result, unpack_node(rhs_r))
        p = unpack_pos(rhs_r)
      } else { done = 1 }
    } else { done = 1 }
  }
  pack(result, p)
}

fn parse_type_inter(toks: i64, src: i64, pos: i64, tctx: i64) -> i64 {
  let lhs_r = parse_type_prefix(toks, src, pos, tctx)
  let mut result = unpack_node(lhs_r)
  let mut p = unpack_pos(lhs_r)
  let mut done = 0
  while done == 0 {
    if tok_tag(toks, p) == 5 {
      if tok_v1(toks, p) == 10 {
        let rhs_r = parse_type_prefix(toks, src, p + 1, tctx)
        result = ty_inter(result, unpack_node(rhs_r))
        p = unpack_pos(rhs_r)
      } else { done = 1 }
    } else { done = 1 }
  }
  pack(result, p)
}

fn parse_type_prefix(toks: i64, src: i64, pos: i64, tctx: i64) -> i64 {
  if tok_tag(toks, pos) == 4 {
    if tok_v1(toks, pos) == 3 {
      let is_mut = if tok_tag(toks, pos + 1) == 3 {
        if tok_v1(toks, pos + 1) == 5 { 1 } else { 0 }
      } else { 0 }
      let inner_pos = if is_mut == 1 { pos + 2 } else { pos + 1 }
      let inner_r = parse_type_prefix(toks, src, inner_pos, tctx)
      pack(ty_ptr_with_mut(unpack_node(inner_r), is_mut), unpack_pos(inner_r))
    } else { parse_type_postfix(toks, src, pos, tctx) }
  } else {
  if tok_tag(toks, pos) == 5 {
    if tok_v1(toks, pos) == 11 {
      let inner_r = parse_type_prefix(toks, src, pos + 1, tctx)
      pack(ty_compl(unpack_node(inner_r)), unpack_pos(inner_r))
    } else { parse_type_postfix(toks, src, pos, tctx) }
  } else { parse_type_postfix(toks, src, pos, tctx) }
  }
}

fn parse_type_postfix(toks: i64, src: i64, pos: i64, tctx: i64) -> i64 {
  let base_r = parse_type_atom(toks, src, pos, tctx)
  let mut base = unpack_node(base_r)
  let mut p = unpack_pos(base_r)
  let mut done = 0
  while done == 0 {
    if tok_tag(toks, p) == 5 {
      if tok_v1(toks, p) == 8 and tok_tag(toks, p + 1) == 2 {
        -- Associated-type projection: Self.Item (or T.Item in a generic
        -- signature). Keep the base structurally so substitution can replace
        -- Self/T before the impl binding is selected.
        base = ty_assoc(base, effect_name_hash(src, tok_v1(toks, p + 1), tok_v2(toks, p + 1)))
        p = p + 2
      } else { if tok_v1(toks, p) == 12 {
        base = ty_nullable(base)
        p = p + 1
      } else { done = 1 } }
    } else { done = 1 }
  }
  pack(base, p)
}

-- 4a: skip a balanced punct-delimited region starting at pos (which must be
-- at the opening token). Returns the position after the matching closer, or
-- after EOF. Used by the unsupported-surface fences to recover cleanly.
fn parse_skip_balanced(toks: i64, pos: i64, open_v1: i64, close_v1: i64) -> i64 {
  let mut depth = 0
  let mut p = pos
  let mut done = 0
  while done == 0 {
    let tag = tok_tag(toks, p)
    if tag == 7 { done = 1 }
    else { if tag == 5 {
      if tok_v1(toks, p) == open_v1 { depth = depth + 1 p = p + 1 }
      else { if tok_v1(toks, p) == close_v1 {
        depth = depth - 1
        p = p + 1
        if depth == 0 { done = 1 } else { 0 }
      } else { p = p + 1 } }
    } else { p = p + 1 } }
  }
  p
}

-- Parse the complete 4e Phase-A bracket type surface:
--   [T; N]  fixed array, [T] immutable slice, [mut T] mutable slice.
-- Invalid shapes remain marker atoms so this pure parser family does not
-- acquire Diagnose; the annotation surface walker emits the precise error.
fn parse_array_slice_type(toks: i64, src: i64, pos: i64, tctx: i64) -> i64 {
  let first = pos + 1
  let first_is_close = tok_tag(toks, first) == 5 and tok_v1(toks, first) == 14
  if first_is_close {
    pack(ty_unsupported(5), first + 1)
  } else {
    let is_mut = if tok_tag(toks, first) == 3 {
      if tok_v1(toks, first) == 5 { 1 } else { 0 }
    } else { 0 }
    let inner_pos = if is_mut == 1 { first + 1 } else { first }
    let missing_inner = tok_tag(toks, inner_pos) == 5 and tok_v1(toks, inner_pos) == 14
    if missing_inner {
      pack(ty_unsupported(5), inner_pos + 1)
    } else {
      let inner_r = parse_type(toks, src, inner_pos, tctx)
      let inner = unpack_node(inner_r)
      let p = unpack_pos(inner_r)
      if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 14 {
        pack(ty_slice_with_mut(inner, is_mut), p + 1)
      } else { if tok_tag(toks, p) == 5 and tok_v1(toks, p) == 13 {
        if is_mut == 1 {
          pack(ty_unsupported(8), parse_skip_balanced(toks, pos, 17, 14))
        } else {
          let length_pos = p + 1
          if tok_tag(toks, length_pos) != 1 {
            pack(ty_unsupported(6), parse_skip_balanced(toks, pos, 17, 14))
          } else {
            let after_length = length_pos + 1
            if tok_tag(toks, after_length) != 5 or tok_v1(toks, after_length) != 14 {
              pack(ty_unsupported(5), parse_skip_balanced(toks, pos, 17, 14))
            } else {
              let length_start = tok_v1(toks, length_pos)
              let length_len = tok_v2(toks, length_pos)
              if decimal_span_le_str(src, length_start, length_len, "9223372036854775807") == 0 {
                pack(ty_unsupported(7), after_length + 1)
              } else {
                pack(ty_array(inner, decimal_span_value_wrapping(src, length_start, length_len)), after_length + 1)
              }
            }
          }
        }
      } else {
        pack(ty_unsupported(5), parse_skip_balanced(toks, pos, 17, 14))
      } }
    }
  }
}

fn parse_type_atom(toks: i64, src: i64, pos: i64, tctx: i64) -> i64 {
  let tag = tok_tag(toks, pos)
  if tag == 2 {
    let ns = tok_v1(toks, pos)
    let nl = tok_v2(toks, pos)
    if src_eq(src, ns, nl, "rc") == 1 {
      let inner_r = parse_type_prefix(toks, src, pos + 1, tctx)
      pack(ty_rc(unpack_node(inner_r)), unpack_pos(inner_r))
    } else { if src_eq(src, ns, nl, "weak") == 1 {
      let inner_r = parse_type_prefix(toks, src, pos + 1, tctx)
      pack(ty_weak(unpack_node(inner_r)), unpack_pos(inner_r))
    } else { if src_eq(src, ns, nl, "arc") == 1 {
      let inner_r = parse_type_prefix(toks, src, pos + 1, tctx)
      pack(ty_arc(unpack_node(inner_r)), unpack_pos(inner_r))
    } else { if src_eq(src, ns, nl, "unique") == 1 {
      let inner_r = parse_type_prefix(toks, src, pos + 1, tctx)
      pack(ty_unique(unpack_node(inner_r)), unpack_pos(inner_r))
    } else { if src_eq(src, ns, nl, "owned") == 1 {
      let inner_r = parse_type_prefix(toks, src, pos + 1, tctx)
      pack(ty_owned(unpack_node(inner_r)), unpack_pos(inner_r))
    } else {
      let base = resolve_type_name(src, ns, nl, tctx)
      -- Check for <type_args> (generic type application)
      if tok_tag(toks, pos + 1) == 4 {
        if tok_v1(toks, pos + 1) == 7 {
          let ta_r = parse_type_args(toks, src, pos + 2, tctx)
          let args = unpack_node(ta_r)
          let applied = if src_eq(src, ns, nl, "Continuation") == 1 {
            if nlist_len(args) == 2 {
              ty_continuation(nlist_get(args, 0), nlist_get(args, 1))
            } else { ty_any() }
          } else { if ty_tag(base) == 9 {
            ty_named_app(ty_f1(base), ty_f2(base), args)
          } else { base } }
          pack(applied, unpack_pos(ta_r))
        } else { pack(base, pos + 1) }
      } else { pack(base, pos + 1) }
    } } } } }
  } else { if tag == 5 {
    if tok_v1(toks, pos) == 1 {
      -- ( ... ) — grouped type or function type params
      parse_type_paren(toks, src, pos, tctx)
    } else { if tok_v1(toks, pos) == 3 {
      -- { in type position: structural record types (4f). Marker, not any —
      -- the checker rejects it with a targeted diagnostic (4a S2).
      pack(ty_unsupported(1), parse_skip_balanced(toks, pos, 3, 4))
    } else { if tok_v1(toks, pos) == 17 {
      parse_array_slice_type(toks, src, pos, tctx)
    } else { pack(ty_any(), pos + 1) } } }
  } else { pack(ty_any(), pos + 1) } }
}

-- Parse (type, ...) and check if -> or -[ follows for function type
fn parse_type_paren(toks: i64, src: i64, pos: i64, tctx: i64) -> i64 {
  -- pos is at (. Collect param types.
  let params = nlist_new()
  let mut p = pos + 1
  let mut done = 0
  -- Handle empty parens ()
  if tok_tag(toks, p) == 5 {
    if tok_v1(toks, p) == 2 { done = 1 p = p + 1 } else { 0 }
  } else { 0 }
  while done == 0 {
    let ty_r = parse_type(toks, src, p, tctx)
    nlist_add(params, unpack_node(ty_r))
    p = unpack_pos(ty_r)
    -- Check for , or )
    if tok_tag(toks, p) == 5 {
      if tok_v1(toks, p) == 2 { done = 1 p = p + 1 }
      else { if tok_v1(toks, p) == 5 { p = p + 1 }
      else { done = 1 p = p + 1 } }
    } else { done = 1 }
  }
  -- p is after ). Check for -> (tag 6) or -[ (tag 11)
  if tok_tag(toks, p) == 6 {
    -- Pure function type: (params) -> ret
    let ret_r = parse_type(toks, src, p + 1, tctx)
    pack(ty_fn(params, unpack_node(ret_r), ty_effect_pure()), unpack_pos(ret_r))
  } else { if tok_tag(toks, p) == 11 {
    -- Effectful function type: (params) -[E]> ret
    let eff_r = parse_effect_list(toks, src, p + 1, tctx)
    let eff = unpack_node(eff_r)
    let p2 = unpack_pos(eff_r)
    let p3 = parse_effect_close_end(toks, p2)
    let ret_r = parse_type(toks, src, p3, tctx)
    pack(ty_fn(params, unpack_node(ret_r), eff), unpack_pos(ret_r))
  } else {
    -- Not a function type — grouped type (use first element)
    if nlist_len(params) == 1 {
      pack(nlist_get(params, 0), p)
    } else {
      -- Multiple types in parens without -> : tuple types (4f). Marker,
      -- not any — the checker rejects it with a targeted diagnostic (4a S8).
      pack(ty_unsupported(2), p)
    }
  } }
}

fn resolve_primitive_type_name(src: i64, ns: i64, nl: i64) -> i64 {
  if src_eq(src, ns, nl, "i64") == 1 { ty_i64() }
  else { if src_eq(src, ns, nl, "Int") == 1 { ty_i64() }
  else { if src_eq(src, ns, nl, "i32") == 1 { ty_i32() }
  else { if src_eq(src, ns, nl, "i8") == 1 { ty_i8() }
  else { if src_eq(src, ns, nl, "i16") == 1 { ty_i16() }
  else { if src_eq(src, ns, nl, "u8") == 1 { ty_u8() }
  else { if src_eq(src, ns, nl, "u16") == 1 { ty_u16() }
  else { if src_eq(src, ns, nl, "u32") == 1 { ty_u32() }
  else { if src_eq(src, ns, nl, "u64") == 1 { ty_u64() }
  else { if src_eq(src, ns, nl, "isize") == 1 { ty_isize() }
  else { if src_eq(src, ns, nl, "usize") == 1 { ty_usize() }
  else { if src_eq(src, ns, nl, "f64") == 1 { ty_f64() }
  else { if src_eq(src, ns, nl, "f32") == 1 { ty_f32() }
  else { if src_eq(src, ns, nl, "Float") == 1 { ty_f64() }
  else { if src_eq(src, ns, nl, "str") == 1 { ty_str() }
  else { if src_eq(src, ns, nl, "String") == 1 { ty_str() }
  else { if src_eq(src, ns, nl, "bool") == 1 { ty_bool() }
  else { if src_eq(src, ns, nl, "Bool") == 1 { ty_bool() }
  else { if src_eq(src, ns, nl, "nil") == 1 { ty_nil() }
  else { if src_eq(src, ns, nl, "Nil") == 1 { ty_nil() }
  else { if src_eq(src, ns, nl, "never") == 1 { ty_never() }
  else { if src_eq(src, ns, nl, "any") == 1 { ty_any() }
  else { 0 } } } } } } } } } } } } } } } } } } } } } }
}

fn resolve_type_name(src: i64, ns: i64, nl: i64, tctx: i64) -> i64 {
  let prim = resolve_primitive_type_name(src, ns, nl)
  if prim != 0 { prim }
  else { if src_eq(src, ns, nl, "Self") == 1 { ty_self() }
  else {
    let tv = resolve_type_var(src, ns, nl, tctx)
    if ty_tag(tv) == 12 { tv }
    else { ty_named(type_name_hash(src, ns, nl), ty_i64()) }
  } }
}

-- Look up a type variable name in the type param context
fn resolve_type_var(src: i64, ns: i64, nl: i64, tctx: i64) -> i64 {
  if tctx == 0 { ty_any() }
  else {
    let mut i = 0
    let mut result = ty_any()
    let n = nlist_len(tctx)
    while i < n {
      let tp = nlist_get(tctx, i)
      let tp_nl = node_f2(tp)
      if tp_nl == nl {
        if src_eq_at(src, ns, src + node_f1(tp), 0, nl) == 1 {
          result = ty_var(node_f3(tp))
          i = n
        } else { i = i + 1 }
      } else { i = i + 1 }
    }
    result
  }
}

-- Parse a function declaration
fn parse_fn_params(toks: i64, src: i64, pos: i64, params: i64, tctx: i64) -[Diagnose]> i64 {
  parse_fn_params_with_self(toks, src, pos, params, tctx, 0)
}

-- Trait and impl methods give a bare first `self` parameter its contextual
-- receiver type. Other unannotated parameters retain the existing `any`
-- fallback; `self` is the only annotation elision defined by the kernel.
fn parse_fn_params_with_self(toks: i64, src: i64, pos: i64, params: i64, tctx: i64, self_ty: i64) -[Diagnose]> i64 {
  -- pos is after (, parse params until ) or EOF or declaration keyword
  let mut p = pos
  let mut done = 0
  while done == 0 {
    let tag = tok_tag(toks, p)
    if tag == 7 { done = 1 }
    else { if tag == 5 {
      if tok_v1(toks, p) == 2 { done = 1 }
      else { if tok_v1(toks, p) == 3 { done = 1 }
      else { p = parse_one_param_with_self(toks, src, p, params, tctx, self_ty) } }
    } else { if tag == 3 {
      let kw = tok_v1(toks, p)
      -- Stop if we hit fn/type/use/trait/impl (declaration boundary)
      if kw == 1 { done = 1 }
      else { if kw == 9 { done = 1 }
      else { if kw == 19 { done = 1 }
      else { if kw == 26 { done = 1 }
      else { if kw == 27 { done = 1 }
      else {
        -- A keyword in parameter-name position (handle/match/test/...)
        -- silently derails the parse into an end-of-file mismatch; say
        -- what actually happened instead.
        parse_error(src, tok_span(toks, p), "error: keyword used as parameter name")
        p = p + 1
      } } } } }
    } else { p = parse_one_param_with_self(toks, src, p, params, tctx, self_ty) } } }
  }
  if tok_tag(toks, p) == 5 {
    if tok_v1(toks, p) == 2 { p + 1 } else { p }
  } else { p }
}

-- Skip a type annotation without allocating type nodes
fn skip_type_annotation(toks: i64, pos: i64) -> i64 {
  -- Skip one type atom (with optional prefix ~ and postfix ?)
  let p = skip_type_atom(toks, pos)
  -- Handle infix | or & by skipping the next type
  if tok_tag(toks, p) == 5 {
    if tok_v1(toks, p) == 9 { skip_type_annotation(toks, p + 1) }
    else { if tok_v1(toks, p) == 10 { skip_type_annotation(toks, p + 1) }
    else { p } }
  } else { p }
}

fn skip_type_atom(toks: i64, pos: i64) -> i64 {
  -- Handle prefix ~
  let p = if tok_tag(toks, pos) == 5 {
    if tok_v1(toks, pos) == 11 { pos + 1 } else { pos }
  } else { pos }
  -- Handle atom: ident or (grouped)
  let p2 = if tok_tag(toks, p) == 5 {
    if tok_v1(toks, p) == 1 { skip_type_parens(toks, p + 1) }
    else { p }
  } else { p + 1 }
  -- Handle postfix ?
  if tok_tag(toks, p2) == 5 {
    if tok_v1(toks, p2) == 12 { p2 + 1 } else { p2 }
  } else { p2 }
}

fn skip_type_parens(toks: i64, pos: i64) -> i64 {
  let mut p = pos
  let mut depth = 1
  while depth > 0 {
    if tok_tag(toks, p) == 5 {
      if tok_v1(toks, p) == 1 { depth = depth + 1 p = p + 1 }
      else { if tok_v1(toks, p) == 2 { depth = depth - 1 p = p + 1 }
      else { p = p + 1 } }
    } else { p = p + 1 }
  }
  p
}

-- Resolve simple type names without allocating complex type nodes
-- Returns a type pointer for i64/str/bool/nil/never/any, or 0 for complex types
fn resolve_simple_type(toks: i64, src: i64, pos: i64) -> i64 {
  if tok_tag(toks, pos) == 2 {
    -- Simple identifier type
    resolve_type_name(src, tok_v1(toks, pos), tok_v2(toks, pos), 0)
  } else { 0 }
}

-- Parse one function parameter. Supports three forms:
-- 1. `_ name: Type` — positional (f4 = -1)
-- 2. `label name: Type` — named with external label (f4 = label_node_ptr)
-- 3. `name: Type` — named, label == name (f4 = 0)
fn parse_one_param(toks: i64, src: i64, pos: i64, params: i64, tctx: i64) -> i64 {
  parse_one_param_with_self(toks, src, pos, params, tctx, 0)
}

fn parse_one_param_with_self(toks: i64, src: i64, pos: i64, params: i64, tctx: i64, self_ty: i64) -> i64 {
  let t0 = tok_tag(toks, pos)
  let v0 = tok_v1(toks, pos)
  -- Check for _ prefix (positional parameter)
  let is_positional = if t0 == 2 {
    if tok_v2(toks, pos) == 1 {
      if mem_load8_at(src, v0) == 95 { 1 } else { 0 }
    } else { 0 }
  } else { 0 }
  if is_positional == 1 {
    -- _ name: Type — positional parameter
    let name_ns = tok_v1(toks, pos + 1)
    let name_nl = tok_v2(toks, pos + 1)
    if tok_tag(toks, pos + 2) == 5 {
      if tok_v1(toks, pos + 2) == 6 {
        let ty_r = parse_type(toks, src, pos + 3, tctx)
        nlist_add(params, node_new(2, name_ns, name_nl, unpack_node(ty_r), 0 - 1))
        skip_comma(toks, unpack_pos(ty_r))
      } else {
        nlist_add(params, node_new(2, name_ns, name_nl, 0, 0 - 1))
        skip_comma(toks, pos + 2)
      }
    } else {
      nlist_add(params, node_new(2, name_ns, name_nl, 0, 0 - 1))
      skip_comma(toks, pos + 2)
    }
  } else {
    -- Check for label name: Type pattern (two idents before colon)
    -- Look ahead: is pos+1 also an ident, and pos+2 is colon?
    let has_label = if t0 == 2 {
      if tok_tag(toks, pos + 1) == 2 {
        if tok_tag(toks, pos + 2) == 5 {
          if tok_v1(toks, pos + 2) == 6 { 1 } else { 0 }
        } else { 0 }
      } else { 0 }
    } else { 0 }
    if has_label == 1 {
      -- label name: Type
      let label_ns = tok_v1(toks, pos)
      let label_nl = tok_v2(toks, pos)
      let name_ns = tok_v1(toks, pos + 1)
      let name_nl = tok_v2(toks, pos + 1)
      let ty_r = parse_type(toks, src, pos + 3, tctx)
      let label_info = node_new(2, label_ns, label_nl, 0, 0)
      nlist_add(params, node_new(2, name_ns, name_nl, unpack_node(ty_r), label_info))
      skip_comma(toks, unpack_pos(ty_r))
    } else {
      -- name: Type — named, label == name (default)
      let ns = tok_v1(toks, pos)
      let nl = tok_v2(toks, pos)
      if tok_tag(toks, pos + 1) == 5 {
        if tok_v1(toks, pos + 1) == 6 {
          let ty_r = parse_type(toks, src, pos + 2, tctx)
          nlist_add(params, node_new(2, ns, nl, unpack_node(ty_r), 0))
          skip_comma(toks, unpack_pos(ty_r))
        } else {
          -- A bare receiver is normally followed by a comma. This branch
          -- used to bypass contextual Self and leave `fn f(self, x: Self)`
          -- with an `any` receiver; trait and impl signatures could agree on
          -- the same mistake, hiding it until the body passed self onward.
          let inferred_self = if self_ty != 0 and nlist_len(params) == 0 {
            if src_eq(src, ns, nl, "self") == 1 { self_ty } else { 0 }
          } else { 0 }
          nlist_add(params, node_new(2, ns, nl, inferred_self, 0))
          skip_comma(toks, pos + 1)
        }
      } else {
        let inferred_self = if self_ty != 0 and nlist_len(params) == 0 {
          if src_eq(src, ns, nl, "self") == 1 { self_ty } else { 0 }
        } else { 0 }
        nlist_add(params, node_new(2, ns, nl, inferred_self, 0))
        skip_comma(toks, pos + 1)
      }
    }
  }
}

-- Parse type parameters: <T, U, V> or <T: Bound, U: Bound & Bound2>
-- Returns pack(nlist_of_params, pos_after_>)
-- Each param is node_new(2, name_start, name_len, var_id, bound)
-- bound = 0 (no bound) or trait_hash (single bound) or nlist of trait_hashes
fn parse_type_params(toks: i64, src: i64, pos: i64) -> i64 {
  parse_type_params_from_id(toks, src, pos, 0)
}

fn parse_type_params_from_id(toks: i64, src: i64, pos: i64, first_var_id: i64) -> i64 {
  let params = nlist_new()
  let mut p = pos
  let mut done = 0
  let mut var_id = first_var_id
  while done == 0 {
    let tag = tok_tag(toks, p)
    if tag == 4 {
      if tok_v1(toks, p) == 8 { done = 1 }
      else { done = 1 }
    } else { if tag == 2 {
      let ns = tok_v1(toks, p)
      let nl = tok_v2(toks, p)
      -- Check for : after type param name (bound syntax)
      let bound_r = parse_type_param_bound(toks, src, p + 1)
      let bound = unpack_node(bound_r)
      let after_bound = unpack_pos(bound_r)
      nlist_add(params, node_new(2, ns, nl, var_id, bound))
      var_id = var_id + 1
      p = skip_comma(toks, after_bound)
    } else { if tag == 7 { done = 1 }
    else { p = p + 1 } } }
  }
  -- Skip past >
  let end = if tok_tag(toks, p) == 4 {
    if tok_v1(toks, p) == 8 { p + 1 } else { p }
  } else { p }
  pack(params, end)
}

fn parse_type_param_lists_concat(outer: i64, inner: i64) -> i64 {
  if outer == 0 { inner }
  else { if inner == 0 { outer }
  else {
    let combined = nlist_new()
    for i in 0..nlist_len(outer) { nlist_add(combined, nlist_get(outer, i)) }
    for i in 0..nlist_len(inner) { nlist_add(combined, nlist_get(inner, i)) }
    combined
  } }
}

-- Parse optional bound after type param: `: TraitName` or `: Trait1 & Trait2`
-- Returns pack(bound, pos_after_bound)
-- bound = 0 (no bound), or trait_hash (single), or nlist of hashes (multiple)
-- Returns pack(bounds_list, pos) where bounds_list is an nlist of trait hashes,
-- or 0 if no bound. Always returns an nlist for consistency (even for single bounds).
fn parse_type_param_bound(toks: i64, src: i64, pos: i64) -> i64 {
  -- Check for : (punct tag 5, val 6)
  if tok_tag(toks, pos) == 5 {
    if tok_v1(toks, pos) == 6 {
      -- Has bound. Parse trait name(s). Always use a list.
      let bounds = nlist_new()
      let first_ns = tok_v1(toks, pos + 1)
      let first_nl = tok_v2(toks, pos + 1)
      nlist_add(bounds, effect_name_hash(src, first_ns, first_nl))
      -- Check for & (multiple bounds)
      let p = pos + 2
      if tok_tag(toks, p) == 5 {
        if tok_v1(toks, p) == 10 {
          let after = parse_more_bounds(toks, src, p + 1, bounds)
          pack(bounds, after)
        } else { pack(bounds, p) }
      } else { pack(bounds, p) }
    } else { pack(0, pos) }
  } else { pack(0, pos) }
}

-- Parse additional trait bounds after &: Trait2 [& Trait3 ...]
fn parse_more_bounds(toks: i64, src: i64, pos: i64, bounds: i64) -> i64 {
  if tok_tag(toks, pos) == 2 {
    let ns = tok_v1(toks, pos)
    let nl = tok_v2(toks, pos)
    nlist_add(bounds, effect_name_hash(src, ns, nl))
    let p = pos + 1
    -- Check for another &
    if tok_tag(toks, p) == 5 {
      if tok_v1(toks, p) == 10 {
        parse_more_bounds(toks, src, p + 1, bounds)
      } else { p }
    } else { p }
  } else { pos }
}

fn parse_fn(toks: i64, src: i64, pos: i64) -[Diagnose]> i64 {
  parse_fn_with_context(toks, src, pos, 0, 0)
}

fn parse_fn_with_self(toks: i64, src: i64, pos: i64, self_ty: i64) -[Diagnose]> i64 {
  parse_fn_with_context(toks, src, pos, self_ty, 0)
}

fn parse_fn_with_context(toks: i64, src: i64, pos: i64, self_ty: i64, outer_tparams: i64) -[Diagnose]> i64 {
  -- pos is after "fn" keyword
  let name_start = tok_v1(toks, pos)
  let name_len = tok_v2(toks, pos)
  -- Check for <T, U> type parameters after name
  let tparams_r = if tok_tag(toks, pos + 1) == 4 {
    if tok_v1(toks, pos + 1) == 7 {
      let first_var_id = if outer_tparams == 0 { 0 } else { nlist_len(outer_tparams) }
      parse_type_params_from_id(toks, src, pos + 2, first_var_id)
    } else { pack(0, pos + 1) }
  } else { pack(0, pos + 1) }
  let own_tparams = unpack_node(tparams_r)
  let tparams = parse_type_param_lists_concat(outer_tparams, own_tparams)
  let p_tp = unpack_pos(tparams_r)
  -- Check: is next an opening paren?
  let has_paren = if tok_tag(toks, p_tp) == 5 {
    if tok_v1(toks, p_tp) == 1 { 1 } else { 0 }
  } else { 0 }
  if has_paren == 0 {
    -- Malformed: no ( after name. Report error and sync.
    parse_error(src, name_start, "error: expected '(' after function name")
    let sync_p = sync_to_decl(toks, p_tp)
    let dummy = node_new(8, name_start, name_len, nlist_new(), node_new(1, 0, 0, 0, 0))
    pack(node_new(23, dummy, 0, 0, tparams), sync_p)
  } else {
    parse_fn_body_with_self(toks, src, name_start, name_len, p_tp, tparams, self_ty)
  }
}

fn parse_fn_body(toks: i64, src: i64, ns: i64, nl: i64, p_tp: i64, tparams: i64) -[Diagnose]> i64 {
  parse_fn_body_with_self(toks, src, ns, nl, p_tp, tparams, 0)
}

fn parse_fn_body_with_self(toks: i64, src: i64, ns: i64, nl: i64, p_tp: i64, tparams: i64, self_ty: i64) -[Diagnose]> i64 {
  -- Set tctx on token header so parse_let can resolve type vars
  let saved_tctx = mem_load64_at(toks, 24)
  mem_store64_at(toks, 24, tparams)
  let result = parse_fn_body_inner_with_self(toks, src, ns, nl, p_tp, tparams, self_ty)
  mem_store64_at(toks, 24, saved_tctx)
  result
}
fn parse_fn_body_inner(toks: i64, src: i64, ns: i64, nl: i64, p_tp: i64, tparams: i64) -[Diagnose]> i64 {
  parse_fn_body_inner_with_self(toks, src, ns, nl, p_tp, tparams, 0)
}

fn parse_fn_body_inner_with_self(toks: i64, src: i64, ns: i64, nl: i64, p_tp: i64, tparams: i64, self_ty: i64) -[Diagnose]> i64 {
  let params = nlist_new()
  let after_params = parse_fn_params_with_self(toks, src, p_tp + 1, params, tparams, self_ty)
  let ret_r = parse_ret_type(toks, src, after_params, tparams)
  let ret_wrap = unpack_node(ret_r)
  let ret_type = node_f1(ret_wrap)
  let eff_sig = node_f2(ret_wrap)
  let mut p = unpack_pos(ret_r)
  -- Check for where clause: `where A: Trait, B: Trait`
  if tok_tag(toks, p) == 2 {
    if src_eq(src, tok_v1(toks, p), tok_v2(toks, p), "where") == 1 {
      p = parse_where_clause(toks, src, p + 1, tparams)
    } else { p = p }
  } else { p = p }
  if tok_tag(toks, p) == 5 {
    if tok_v1(toks, p) == 3 {
      let body_r = parse_block(toks, src, p + 1)
      let body = unpack_node(body_r)
      let p2 = unpack_pos(body_r)
      let fn_inner = node_new(8, ns, nl, params, body)
      pack(node_new(23, fn_inner, ret_type, eff_sig, tparams), p2)
    } else {
      parse_error(src, ns, "error: expected '{' in function body")
      let sync_p = sync_to_decl(toks, p)
      let dummy = node_new(8, ns, nl, params, node_new(1, 0, 0, 0, 0))
      pack(node_new(23, dummy, ret_type, 0, tparams), sync_p)
    }
  } else {
    parse_error(src, ns, "error: expected '{' in function body")
    let sync_p = sync_to_decl(toks, p)
    let dummy = node_new(8, ns, nl, params, node_new(1, 0, 0, 0, 0))
    pack(node_new(23, dummy, ret_type, 0, tparams), sync_p)
  }
}

-- Resolve the rigid Self placeholder in an implementation signature before
-- it reaches the ordinary function checker and monomorphiser. The body is
-- shared unchanged: Self is contextual syntax only in method signatures.
fn parse_impl_method_subst_self(fn_wrap: i64, self_ty: i64) -> i64 {
  let subst = subst_new()
  subst_add(subst, 0 - 1, self_ty)
  let inner = node_f1(fn_wrap)
  let old_params = node_f3(inner)
  let params = nlist_new()
  for i in 0..nlist_len(old_params) {
    let param = nlist_get(old_params, i)
    nlist_add(params, node_new(node_tag(param), node_f1(param), node_f2(param), ty_subst(node_f3(param), subst), node_f4(param)))
  }
  let new_inner = node_new(node_tag(inner), node_f1(inner), node_f2(inner), params, node_f4(inner))
  node_new(node_tag(fn_wrap), new_inner, ty_subst(node_f2(fn_wrap), subst), ty_subst(node_f3(fn_wrap), subst), node_f4(fn_wrap))
}

-- Parse where clause: `where A: Trait1, B: Trait2 & Trait3`
-- Applies bounds to the existing tparams list by matching param names.
fn parse_where_clause(toks: i64, src: i64, pos: i64, tparams: i64) -> i64 {
  if tparams == 0 { pos }
  else {
    let mut p = pos
    let mut done = 0
    while done == 0 {
      -- Expect: ParamName : Trait [& Trait2] [, ...]
      if tok_tag(toks, p) == 2 {
        let param_ns = tok_v1(toks, p)
        let param_nl = tok_v2(toks, p)
        -- Check for : after param name
        if tok_tag(toks, p + 1) == 5 {
          if tok_v1(toks, p + 1) == 6 {
            -- Parse bounds
            let bounds = nlist_new()
            let bound_ns = tok_v1(toks, p + 2)
            let bound_nl = tok_v2(toks, p + 2)
            nlist_add(bounds, effect_name_hash(src, bound_ns, bound_nl))
            let mut bp = p + 3
            -- Check for & (additional bounds)
            let mut more = 1
            while more == 1 {
              if tok_tag(toks, bp) == 5 {
                if tok_v1(toks, bp) == 10 {
                  let nb_ns = tok_v1(toks, bp + 1)
                  let nb_nl = tok_v2(toks, bp + 1)
                  nlist_add(bounds, effect_name_hash(src, nb_ns, nb_nl))
                  bp = bp + 2
                } else { more = 0 }
              } else { more = 0 }
            }
            -- Find the matching type param and set its bound
            let ntp = nlist_len(tparams)
            let mut ti = 0
            while ti < ntp {
              let tp = nlist_get(tparams, ti)
              if node_f2(tp) == param_nl {
                if src_eq_at(src, param_ns, src + node_f1(tp), 0, param_nl) == 1 {
                  -- Set bound on this type param (overwrite f4)
                  mem_store64_at(tp, 32, bounds)
                  ti = ntp
                } else { ti = ti + 1 }
              } else { ti = ti + 1 }
            }
            p = skip_comma(toks, bp)
          } else { done = 1 }
        } else { done = 1 }
      } else { done = 1 }
    }
    p
  }
}

-- ══════════════════════════════════════════════════════════════
-- String interpolation: "hello {name}" desugars to str_concat chain
-- ══════════════════════════════════════════════════════════════

-- Check if a string literal contains {ident (interpolation marker)
-- Only triggers if { is followed by a letter or underscore (identifier start).
-- This avoids false positives on strings like "expected '{' in body".
fn str_has_interp(src: i64, start: i64, len: i64) -> i64 {
  let mut i = 0
  let mut found = 0
  while i < len - 1 {
    if mem_load8_at(src, start + i) == 123 {
      -- Check next char is identifier start (a-z, A-Z, _)
      let next = mem_load8_at(src, start + i + 1)
      if is_alpha(next) == 1 {
        found = 1
        i = len
      } else { if next == 95 { found = 1 i = len }
      else { i = i + 1 } }
    } else { i = i + 1 }
  }
  found
}

-- Parse an interpolated string into a str_concat chain.
-- "hello {name} world" → str_concat(str_concat("hello ", name.display()), " world")
-- Supports only simple identifiers inside {} (not complex expressions).
fn parse_interp_string(toks: i64, src: i64, start: i64, len: i64) -[Diagnose]> i64 {
  -- Walk the string, splitting on { and }
  -- Build a chain: start with the first literal segment, then concat each
  -- interpolated expression (via .display()) and the following literal.
  let mut result = 0
  let mut seg_start = start
  let mut i = 0
  while i < len {
    let ch = mem_load8_at(src, start + i)
    if ch == 123 {
      -- Found {: emit literal segment before it
      let seg_len = (start + i) - seg_start
      let lit = if seg_len > 0 { node_new(9, seg_start, seg_len, 0, 0) }
                else { node_new(9, start, 0, 0, 0) }
      let expr_start = start + i + 1
      let expr_end = interp_find_close(src, start, len, i)
      let expr_len = expr_end - i - 1
      let expr_node = parse_interp_expr(src, expr_start, expr_len)
      let concat_call = interp_concat2(lit, expr_node)
      -- Accumulate
      result = if result == 0 { concat_call }
               else { interp_concat2(result, concat_call) }
      -- Advance past }
      i = expr_end + 1
      seg_start = start + i
    } else { i = i + 1 }
  }
  -- Emit trailing literal segment
  let trailing_len = (start + len) - seg_start
  if trailing_len > 0 {
    let trailing = node_new(9, seg_start, trailing_len, 0, 0)
    result = if result == 0 { trailing }
             else { interp_concat2(result, trailing) }
  } else {
    if result == 0 { result = node_new(9, start, 0, 0, 0) } else { 0 }
  }
  result
}

fn interp_find_close(src: i64, start: i64, len: i64, open_i: i64) -> i64 {
  let mut j = open_i + 1
  let mut result = len
  let mut done = 0
  while done == 0 {
    if j >= len { done = 1 }
    else {
      if mem_load8_at(src, start + j) == 125 {
        result = j
        done = 1
      } else { j = j + 1 }
    }
  }
  result
}

fn parse_interp_expr(src: i64, start: i64, len: i64) -[Diagnose]> i64 {
  let inner_toks = lex_range(src, start, len)
  let expr_r = parse_expr(inner_toks, src, 0, 0)
  interp_display_node(unpack_node(expr_r), src)
}

fn interp_display_node(expr: i64, src: i64) -> i64 {
  let args = nlist_new()
  node_new(32, expr, __str_ptr("display") - src, 7, args)
}

-- Hash of "display" for method call dispatch
fn interp_display_hash() -> i64 {
  -- djb2 of "display": d=100, i=105, s=115, p=112, l=108, a=97, y=121
  let mut h = 5381
  h = h * 33 + 100
  h = h * 33 + 105
  h = h * 33 + 115
  h = h * 33 + 112
  h = h * 33 + 108
  h = h * 33 + 97
  h = h * 33 + 121
  h
}

-- Create a str_concat(a, b) call node
-- str_concat is looked up by name at codegen time
fn interp_concat_node(args: i64) -> i64 {
  -- We need ns/nl for "str_concat" in the source... but it's a stdlib function
  -- not in the current source. Use a synthetic Call node.
  -- Actually, we can't create a Call node without source offsets for the function name.
  -- Solution: use a new AST tag 46 = InterpConcat(left, right)
  let left = nlist_get(args, 0)
  let right = nlist_get(args, 1)
  node_new(46, left, right, 0, 0)
}

fn interp_concat2(left: i64, right: i64) -> i64 {
  node_new(46, left, right, 0, 0)
}

-- Parse return type and optional effect annotation
-- Returns pack(ret_node, pos) where ret_node = node_new(0, ret_type, effect_sig, 0, 0)
fn parse_ret_type(toks: i64, src: i64, pos: i64, tctx: i64) -> i64 {
  let tag = tok_tag(toks, pos)
  if tag == 6 {
    -- Pure arrow: -> type (explicitly pure = empty effect set)
    let ty_r = parse_type(toks, src, pos + 1, tctx)
    pack(node_new(0, unpack_node(ty_r), ty_effect_pure(), 0, 0), unpack_pos(ty_r))
  } else { if tag == 11 {
    -- Effect arrow: -[effects]> type
    let eff_r = parse_effect_list(toks, src, pos + 1, tctx)
    let eff_sig = unpack_node(eff_r)
    let p = unpack_pos(eff_r)
    let p2 = parse_effect_close_end(toks, p)
    let ty_r = parse_type(toks, src, p2, tctx)
    pack(node_new(0, unpack_node(ty_r), eff_sig, 0, 0), unpack_pos(ty_r))
  } else {
    pack(node_new(0, 0, 0, 0, 0), pos)
  } }
}

-- Hash function for effect names (same as str_hash in codegen.weft)
fn effect_name_hash(src: i64, start: i64, len: i64) -> i64 {
  let mut h = 5381
  let mut i = 0
  while i < len {
    h = h * 33 + mem_load8_at(src, start + i)
    i = i + 1
  }
  if h < 0 { 0 - h } else { h }
}

-- Parse comma-separated effect names between -[ and ]>
-- Returns pack(EffectSig_node, pos_at_]>)
-- Parse comma-separated effects between -[ and ]>
-- Supports effect variables: if an identifier matches a type param, it's a tail variable.
-- Returns pack(EffectSig_node, pos_at_]>)
-- 4a S1 residue, 4c-narrowed: type arguments on an effect VARIABLE (a
-- tparam used as an open tail, e.g. E<T>) remain undesigned and fenced.
-- Concrete effect names now parse their args for real (see
-- parse_effect_list below).
fn parse_effect_args_fence(toks: i64, effects: i64, pos: i64) -> i64 {
  if tok_tag(toks, pos) == 4 {
    if tok_v1(toks, pos) == 7 {
      nlist_add(effects, ty_unsupported(4))
      let mut p = pos + 1
      let mut done = 0
      while done == 0 {
        let tag = tok_tag(toks, p)
        if tag == 7 { done = 1 }
        else { if tag == 12 or (tag == 5 and tok_v1(toks, p) == 14) { done = 1 }
        else { if tag == 4 {
          if tok_v1(toks, p) == 8 { p = p + 1 done = 1 } else { p = p + 1 }
        } else { p = p + 1 } } }
      }
      p
    } else { pos }
  } else { pos }
}

fn parse_effect_list(toks: i64, src: i64, pos: i64, tctx: i64) -> i64 {
  let effects = nlist_new()
  let mut tail_var = 0
  let mut p = pos
  let mut done = 0
  while done == 0 {
    let tag = tok_tag(toks, p)
    if tag == 12 or (tag == 5 and tok_v1(toks, p) == 14) { done = 1 }
    else { if tag == 7 { done = 1 }
    else { if tag == 2 {
      let ns = tok_v1(toks, p)
      let nl = tok_v2(toks, p)
      -- Check if this identifier is a type parameter (effect variable)
      let var_id = find_tparam_id(tctx, src, ns, nl)
      if var_id >= 0 {
        -- Effect variable: set as tail
        tail_var = var_id + 1
        p = skip_comma(toks, parse_effect_args_fence(toks, effects, p + 1))
      } else {
        -- Concrete effect name, optionally parameterized (4c):
        -- State<SymTab> builds an atom carrying its type args.
        let hash = effect_name_hash(src, ns, nl)
        let has_args = if tok_tag(toks, p + 1) == 4 {
          if tok_v1(toks, p + 1) == 7 { 1 } else { 0 }
        } else { 0 }
        if has_args == 1 {
          let args_r = parse_type_args(toks, src, p + 2, tctx)
          nlist_add(effects, ty_effect_app_args(hash, unpack_node(args_r)))
          p = skip_comma(toks, unpack_pos(args_r))
        } else {
          nlist_add(effects, ty_effect_app(hash))
          p = skip_comma(toks, p + 1)
        }
      }
    } else {
      p = p + 1
    } } }
  }
  pack(ty_effect_sig_with_tail(effects, tail_var), p)
}

-- Find a type param by name, return its var_id or -1 if not found
fn find_tparam_id(tctx: i64, src: i64, ns: i64, nl: i64) -> i64 {
  if tctx == 0 { 0 - 1 }
  else {
    let n = nlist_len(tctx)
    let mut i = 0
    let mut result = 0 - 1
    while i < n {
      let tp = nlist_get(tctx, i)
      let tp_nl = node_f2(tp)
      if tp_nl == nl {
        if src_eq_at(src, ns, src + node_f1(tp), 0, nl) == 1 {
          result = node_f3(tp)
          i = n
        } else { i = i + 1 }
      } else { i = i + 1 }
    }
    result
  }
}

-- Compute a type_hash for a type name from source.
-- Primitives get negative IDs from type_hash_of: i64=-1, str=-2, bool=-3, nil=-4, f64=-5, i32=-6, i8=-7, ...
-- Named types get djb2 hash (always positive since 5381*33+ch > 0)
fn type_name_hash(src: i64, ns: i64, nl: i64) -> i64 {
  if src_eq(src, ns, nl, "i64") == 1 { 0 - 1 }
  else { if src_eq(src, ns, nl, "str") == 1 { 0 - 2 }
  else { if src_eq(src, ns, nl, "bool") == 1 { 0 - 3 }
  else { if src_eq(src, ns, nl, "nil") == 1 { 0 - 4 }
  else { if src_eq(src, ns, nl, "f64") == 1 { 0 - 5 }
  else { if src_eq(src, ns, nl, "i32") == 1 { 0 - 6 }
  else { if src_eq(src, ns, nl, "i8") == 1 { 0 - 7 }
  else { if src_eq(src, ns, nl, "i16") == 1 { 0 - 8 }
  else { if src_eq(src, ns, nl, "u8") == 1 { 0 - 9 }
  else { if src_eq(src, ns, nl, "u16") == 1 { 0 - 10 }
  else { if src_eq(src, ns, nl, "u32") == 1 { 0 - 11 }
  else { if src_eq(src, ns, nl, "u64") == 1 { 0 - 12 }
  else { if src_eq(src, ns, nl, "isize") == 1 { 0 - 13 }
  else { if src_eq(src, ns, nl, "usize") == 1 { 0 - 14 }
  else { if src_eq(src, ns, nl, "f32") == 1 { 0 - 15 }
  else { effect_name_hash(src, ns, nl) } } } } } } } } } } } } } } }
}

fn parse_assoc_member_hash(member: i64, src: i64) -> i64 {
  effect_name_hash(src, node_f1(member), node_f2(member))
}

fn parse_assoc_name_declared(members: i64, src: i64, name_hash: i64) -> bool {
  let mut found = false
  let mut i = 0
  while i < nlist_len(members) and not found {
    let member = nlist_get(members, i)
    let tag = node_tag(member)
    if (tag == 42 or tag == 43) and parse_assoc_member_hash(member, src) == name_hash {
      found = true
    } else { i = i + 1 }
  }
  found
}

fn parse_assoc_binding_type(members: i64, src: i64, name_hash: i64) -> i64 {
  let mut result = 0
  let mut i = 0
  while i < nlist_len(members) and result == 0 {
    let member = nlist_get(members, i)
    if node_tag(member) == 43 and parse_assoc_member_hash(member, src) == name_hash {
      result = node_f3(member)
    } else { i = i + 1 }
  }
  result
}

fn parse_assoc_mark_list(types: i64, members: i64, src: i64, self_ty: i64) -> i64 {
  if types == 0 { 0 }
  else {
    let result = nlist_new()
    for i in 0..nlist_len(types) {
      nlist_add(result, parse_assoc_mark_type(nlist_get(types, i), members, src, self_ty))
    }
    result
  }
}

-- Within a trait/impl signature, an unqualified declared associated name is
-- contextual syntax for Self.Name. Explicit Self.Name already has tag 21.
fn parse_assoc_mark_type(ty: i64, members: i64, src: i64, self_ty: i64) -> i64 {
  if ty == 0 { 0 }
  else {
    match ty_tag(ty) {
      3 -> ty_union(parse_assoc_mark_type(ty_f1(ty), members, src, self_ty), parse_assoc_mark_type(ty_f2(ty), members, src, self_ty))
      4 -> ty_inter(parse_assoc_mark_type(ty_f1(ty), members, src, self_ty), parse_assoc_mark_type(ty_f2(ty), members, src, self_ty))
      5 -> ty_compl(parse_assoc_mark_type(ty_f1(ty), members, src, self_ty))
      6 -> ty_fn(parse_assoc_mark_list(ty_f1(ty), members, src, self_ty), parse_assoc_mark_type(ty_f2(ty), members, src, self_ty), parse_assoc_mark_type(ty_f3(ty), members, src, self_ty))
      9 -> {
        if ty_f3(ty) == 0 and parse_assoc_name_declared(members, src, ty_f1(ty)) {
          ty_assoc(self_ty, ty_f1(ty))
        } else {
          ty_named_app(ty_f1(ty), parse_assoc_mark_type(ty_f2(ty), members, src, self_ty), parse_assoc_mark_list(ty_f3(ty), members, src, self_ty))
        }
      }
      10 -> ty_effect_sig_with_tail(parse_assoc_mark_list(ty_f1(ty), members, src, self_ty), ty_f2(ty))
      11 -> ty_effect_app_args(ty_f1(ty), parse_assoc_mark_list(ty_f2(ty), members, src, self_ty))
      14 -> ty_continuation(parse_assoc_mark_type(ty_f1(ty), members, src, self_ty), parse_assoc_mark_type(ty_f2(ty), members, src, self_ty))
      15 -> ty_ptr_with_mut(parse_assoc_mark_type(ty_f1(ty), members, src, self_ty), ty_f2(ty))
      16 -> ty_weak(parse_assoc_mark_type(ty_f1(ty), members, src, self_ty))
      17 -> ty_arc(parse_assoc_mark_type(ty_f1(ty), members, src, self_ty))
      18 -> ty_unique(parse_assoc_mark_type(ty_f1(ty), members, src, self_ty))
      19 -> ty_owned(parse_assoc_mark_type(ty_f1(ty), members, src, self_ty))
      21 -> ty_assoc(parse_assoc_mark_type(ty_f1(ty), members, src, self_ty), ty_f2(ty))
      22 -> ty_array(parse_assoc_mark_type(ty_f1(ty), members, src, self_ty), ty_f2(ty))
      23 -> ty_slice_with_mut(parse_assoc_mark_type(ty_f1(ty), members, src, self_ty), ty_f2(ty))
      _ -> ty
    }
  }
}

fn parse_assoc_resolve_list(types: i64, members: i64, src: i64, self_ty: i64, depth: i64) -> i64 {
  if types == 0 { 0 }
  else {
    let result = nlist_new()
    for i in 0..nlist_len(types) {
      nlist_add(result, parse_assoc_resolve_type_depth(nlist_get(types, i), members, src, self_ty, depth))
    }
    result
  }
}

fn parse_assoc_resolve_type_depth(ty: i64, members: i64, src: i64, self_ty: i64, depth: i64) -> i64 {
  if ty == 0 or depth > 16 { ty }
  else {
    match ty_tag(ty) {
      3 -> ty_union(parse_assoc_resolve_type_depth(ty_f1(ty), members, src, self_ty, depth), parse_assoc_resolve_type_depth(ty_f2(ty), members, src, self_ty, depth))
      4 -> ty_inter(parse_assoc_resolve_type_depth(ty_f1(ty), members, src, self_ty, depth), parse_assoc_resolve_type_depth(ty_f2(ty), members, src, self_ty, depth))
      5 -> ty_compl(parse_assoc_resolve_type_depth(ty_f1(ty), members, src, self_ty, depth))
      6 -> ty_fn(parse_assoc_resolve_list(ty_f1(ty), members, src, self_ty, depth), parse_assoc_resolve_type_depth(ty_f2(ty), members, src, self_ty, depth), parse_assoc_resolve_type_depth(ty_f3(ty), members, src, self_ty, depth))
      9 -> ty_named_app(ty_f1(ty), parse_assoc_resolve_type_depth(ty_f2(ty), members, src, self_ty, depth), parse_assoc_resolve_list(ty_f3(ty), members, src, self_ty, depth))
      10 -> ty_effect_sig_with_tail(parse_assoc_resolve_list(ty_f1(ty), members, src, self_ty, depth), ty_f2(ty))
      11 -> ty_effect_app_args(ty_f1(ty), parse_assoc_resolve_list(ty_f2(ty), members, src, self_ty, depth))
      14 -> ty_continuation(parse_assoc_resolve_type_depth(ty_f1(ty), members, src, self_ty, depth), parse_assoc_resolve_type_depth(ty_f2(ty), members, src, self_ty, depth))
      15 -> ty_ptr_with_mut(parse_assoc_resolve_type_depth(ty_f1(ty), members, src, self_ty, depth), ty_f2(ty))
      16 -> ty_weak(parse_assoc_resolve_type_depth(ty_f1(ty), members, src, self_ty, depth))
      17 -> ty_arc(parse_assoc_resolve_type_depth(ty_f1(ty), members, src, self_ty, depth))
      18 -> ty_unique(parse_assoc_resolve_type_depth(ty_f1(ty), members, src, self_ty, depth))
      19 -> ty_owned(parse_assoc_resolve_type_depth(ty_f1(ty), members, src, self_ty, depth))
      22 -> ty_array(parse_assoc_resolve_type_depth(ty_f1(ty), members, src, self_ty, depth), ty_f2(ty))
      23 -> ty_slice_with_mut(parse_assoc_resolve_type_depth(ty_f1(ty), members, src, self_ty, depth), ty_f2(ty))
      21 -> {
        let base = parse_assoc_resolve_type_depth(ty_f1(ty), members, src, self_ty, depth)
        let binding = if ty_eq(base, self_ty) { parse_assoc_binding_type(members, src, ty_f2(ty)) } else { 0 }
        if binding == 0 { ty_assoc(base, ty_f2(ty)) }
        else { parse_assoc_resolve_type_depth(binding, members, src, self_ty, depth + 1) }
      }
      _ -> ty
    }
  }
}

fn parse_assoc_resolve_type(ty: i64, members: i64, src: i64, self_ty: i64) -> i64 {
  parse_assoc_resolve_type_depth(ty, members, src, self_ty, 0)
}

fn parse_assoc_rewrite_params(params: i64, members: i64, src: i64, self_ty: i64, resolve: i64) -> i64 {
  for i in 0..nlist_len(params) {
    let param = nlist_get(params, i)
    let marked = parse_assoc_mark_type(node_f3(param), members, src, self_ty)
    let final_ty = if resolve == 1 { parse_assoc_resolve_type(marked, members, src, self_ty) } else { marked }
    mem_store64_at(param, 24, final_ty)
  }
  0
}

fn parse_trait_finalize_assoc(methods: i64, src: i64) -> i64 {
  for i in 0..nlist_len(methods) {
    let method = nlist_get(methods, i)
    if node_tag(method) == 39 {
      parse_assoc_rewrite_params(node_f3(method), methods, src, ty_self(), 0)
      let meta = node_f4(method)
      mem_store64_at(meta, 8, parse_assoc_mark_type(node_f1(meta), methods, src, ty_self()))
      mem_store64_at(meta, 16, parse_assoc_mark_type(node_f2(meta), methods, src, ty_self()))
    } else { 0 }
  }
  0
}

fn parse_impl_finalize_assoc(methods: i64, src: i64, self_ty: i64) -> i64 {
  -- Resolve binding chains first so every method sees the complete impl body,
  -- independent of declaration order.
  for i in 0..nlist_len(methods) {
    let member = nlist_get(methods, i)
    if node_tag(member) == 43 {
      let marked = parse_assoc_mark_type(node_f3(member), methods, src, self_ty)
      mem_store64_at(member, 24, parse_assoc_resolve_type(marked, methods, src, self_ty))
    } else { 0 }
  }
  for i in 0..nlist_len(methods) {
    let method = nlist_get(methods, i)
    if node_tag(method) == 23 {
      let inner = node_f1(method)
      parse_assoc_rewrite_params(node_f3(inner), methods, src, self_ty, 1)
      let marked_ret = parse_assoc_mark_type(node_f2(method), methods, src, self_ty)
      let marked_eff = parse_assoc_mark_type(node_f3(method), methods, src, self_ty)
      mem_store64_at(method, 16, parse_assoc_resolve_type(marked_ret, methods, src, self_ty))
      mem_store64_at(method, 24, parse_assoc_resolve_type(marked_eff, methods, src, self_ty))
    } else { 0 }
  }
  0
}

-- Parse trait declaration: trait Name { fn method(self) -> T ... }
-- Stores in ttable with kind=3, fields = list of method signature nodes
-- Each method sig: node_new(39, name_ns, name_nl, params, ret_type)
fn parse_trait_decl(toks: i64, src: i64, pos: i64, tt: i64) -[Diagnose]> i64 {
  -- pos is after "trait" keyword
  let name_ns = tok_v1(toks, pos)
  let name_nl = tok_v2(toks, pos)
  -- skip name, skip {
  let mut p = pos + 2
  -- Parse method signatures until }
  let methods = nlist_new()
  let mut done = 0
  while done == 0 {
    let tag = tok_tag(toks, p)
    if tag == 5 {
      if tok_v1(toks, p) == 4 { done = 1 }
      else { p = p + 1 }
    } else { if tag == 7 { done = 1 }
    else { if tag == 3 {
      if tok_v1(toks, p) == 1 {
        -- fn method(self, params...) -> RetType (no body)
        let m_ns = tok_v1(toks, p + 1)
        let m_nl = tok_v2(toks, p + 1)
        -- skip fn, name, (
        let params = nlist_new()
        let after_params = parse_fn_params_with_self(toks, src, p + 3, params, 0, ty_self())
        let ret_r = parse_ret_type(toks, src, after_params, 0)
        let ret_wrap = unpack_node(ret_r)
        let ret_type = node_f1(ret_wrap)
        let eff_sig = node_f2(ret_wrap)
        -- Pack ret_type and eff_sig together in f4
        nlist_add(methods, node_new(39, m_ns, m_nl, params, node_new(0, ret_type, eff_sig, 0, 0)))
        p = unpack_pos(ret_r)
      } else { if tok_v1(toks, p) == 9 {
        -- type Item[: Bound & ...] — associated type declaration (tag 42)
        let at_ns = tok_v1(toks, p + 1)
        let at_nl = tok_v2(toks, p + 1)
        let bounds_r = parse_type_param_bound(toks, src, p + 2)
        nlist_add(methods, node_new(42, at_ns, at_nl, unpack_node(bounds_r), 0))
        p = unpack_pos(bounds_r)
      } else { p = p + 1 } }
    } else { p = p + 1 } } }
  }
  parse_trait_finalize_assoc(methods, src)
  -- Store in ttable with kind=3 (trait)
  ttable_add(tt, src, name_ns, name_nl, 3, nlist_len(methods), methods, 0)
  if tok_tag(toks, p) == 5 {
    if tok_v1(toks, p) == 4 { p + 1 } else { p }
  } else { p }
}

-- Parse impl block: impl [TraitName for] TypeName { fn method(self) ... }
-- Stores in ttable with kind=4
-- ttable entry: (type_ns, type_nl, kind=4, num_methods, methods_list, trait_hash)
-- trait_hash = 0 for inherent impls, hash for trait impls
fn parse_impl_decl(toks: i64, src: i64, pos: i64, tt: i64, fns: i64) -[Diagnose]> i64 {
  -- pos is after "impl" keyword
  -- Check for <T, U> type parameters: impl<T: Bound> ...
  let mut p0 = pos
  let impl_tparams = if tok_tag(toks, p0) == 4 {
    if tok_v1(toks, p0) == 7 {
      let tp_r = parse_type_params(toks, src, p0 + 1)
      p0 = unpack_pos(tp_r)
      unpack_node(tp_r)
    } else { 0 }
  } else { 0 }
  -- Determine: trait impl or inherent impl. Trait names are currently bare;
  -- the target is a full type expression and may carry impl parameters.
  let first_ns = tok_v1(toks, p0)
  let first_nl = tok_v2(toks, p0)
  -- Check for "for": either identifier "for" (tag 2) or keyword for (tag 3, kw 29)
  let is_trait_impl = if tok_tag(toks, p0 + 1) == 2 {
    if src_eq(src, tok_v1(toks, p0 + 1), tok_v2(toks, p0 + 1), "for") == 1 { 1 } else { 0 }
  } else { if tok_tag(toks, p0 + 1) == 3 {
    if tok_v1(toks, p0 + 1) == 29 { 1 } else { 0 }
  } else { 0 } }
  let trait_hash = if is_trait_impl == 1 { effect_name_hash(src, first_ns, first_nl) } else { 0 }
  let target_pos = if is_trait_impl == 1 { p0 + 2 } else { p0 }
  let type_ns = tok_v1(toks, target_pos)
  let type_nl = tok_v2(toks, target_pos)
  let target_r = parse_type(toks, src, target_pos, impl_tparams)
  let self_ty = unpack_node(target_r)
  -- Continue at the opening brace after the complete target type.
  let mut p = unpack_pos(target_r)
  -- Skip { (expect punct tag 5, val 3)
  if tok_tag(toks, p) == 5 {
    if tok_v1(toks, p) == 3 { p = p + 1 } else { p = p }
  } else { p = p }
  -- Parse method implementations until }
  let methods = nlist_new()
  let mut done = 0
  while done == 0 {
    let tag = tok_tag(toks, p)
    if tag == 5 {
      if tok_v1(toks, p) == 4 { done = 1 }
      else { p = p + 1 }
    } else { if tag == 7 { done = 1 }
    else { if tag == 3 {
      if tok_v1(toks, p) == 9 {
        -- type Item = ConcreteType — associated type binding (tag 43)
        let at_ns = tok_v1(toks, p + 1)
        let at_nl = tok_v2(toks, p + 1)
        -- skip "type", name, "="
        let at_p = p + 3
        let at_ty_r = parse_type(toks, src, at_p, impl_tparams)
        let self_subst = subst_new()
        subst_add(self_subst, 0 - 1, self_ty)
        let at_ty = ty_subst(unpack_node(at_ty_r), self_subst)
        nlist_add(methods, node_new(43, at_ns, at_nl, at_ty, 0))
        p = unpack_pos(at_ty_r)
      } else { if tok_v1(toks, p) == 1 {
        -- fn method(self, ...) -> T { body }
        let old_p = p
        let r = parse_fn_with_context(toks, src, p + 1, self_ty, impl_tparams)
        let new_p = unpack_pos(r)
        if new_p <= old_p {
          parse_error(src, tok_span(toks, p + 1), "error: malformed method in impl block")
          p = p + 1
        } else {
          let fn_node = parse_impl_method_subst_self(unpack_node(r), self_ty)
          nlist_add(methods, fn_node)
          -- Also add to fns list as a qualified fn (type_hash + method pair)
          -- Store impl context: owner head in f3 and full target in f4.
          -- Lowering uses the target arguments to distinguish disjoint
          -- specialised impls that share one nominal head and method name.
          let type_hash = type_name_hash(src, type_ns, type_nl)
          let pair = node_new(0, fn_node, src, type_hash, self_ty)
          nlist_add(fns, pair)
          p = new_p
        }
      } else { p = p + 1 } }
    } else { p = p + 1 } } }
  }
  parse_impl_finalize_assoc(methods, src, self_ty)
  -- Store in ttable with kind=4 (impl block)
  -- Pack trait_hash and impl_tparams into tparams field as a node
  let impl_info = node_new(0, trait_hash, impl_tparams, self_ty, 0)
  ttable_add(tt, src, type_ns, type_nl, 4, nlist_len(methods), methods, impl_info)
  if tok_tag(toks, p) == 5 {
    if tok_v1(toks, p) == 4 { p + 1 } else { p }
  } else { p }
}

-- Parse: test "name" { body }
-- Creates a TestDecl node (tag 50): f1=name_ns, f2=name_nl, f3=body, f4=0
-- Added to fns list as a pair with f4=1 to mark it as a test (not a regular fn)
fn parse_test_decl(toks: i64, src: i64, pos: i64, fns: i64) -[Diagnose]> i64 {
  -- pos is after "test" keyword, expect string literal
  let name_ns = tok_v1(toks, pos)
  let name_nl = tok_v2(toks, pos)
  -- skip name string, expect {
  let p = pos + 1
  if tok_tag(toks, p) == 5 {
    if tok_v1(toks, p) == 3 {
      let body_r = parse_block(toks, src, p + 1)
      let body = unpack_node(body_r)
      let test_node = node_new(50, name_ns, name_nl, body, 0)
      -- Store as pair: f1=node, f2=src, f3=0 (not impl), f4=1 (is_test marker)
      let pair = node_new(0, test_node, src, 0, 1)
      nlist_add(fns, pair)
      unpack_pos(body_r)
    } else { p }
  } else { p }
}

fn parse_module(toks: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  let fns = nlist_new()
  -- The loop terminates on the EOF token (tag 7), but a sub-parser that
  -- consumes past EOF would leave p pointing beyond the buffer, and the
  -- token accessors are raw loads: the walk then reads unmapped memory
  -- and the compiler dies with SIGSEGV after megabytes of bogus
  -- diagnostics. The token count is the hard bound — a parser must
  -- never read past its own token stream.
  let ntoks = tok_count(toks)
  let mut p = 0
  let mut done = 0
  while done == 0 and p < ntoks {
    let tag = tok_tag(toks, p)
    if tag == 7 { done = 1 }
    else { if tag == 3 {
      let kw = tok_v1(toks, p)
      if kw == 1 {
        let old_p = p
        let r = parse_fn(toks, src, p + 1)
        let new_p = unpack_pos(r)
        if new_p <= old_p {
          -- Parser stuck: report error and skip to next declaration
          parse_error(src, tok_span(toks, p + 1), "error: malformed function declaration")
          p = sync_to_decl(toks, p + 1)
        } else {
          let pair = node_new(0, unpack_node(r), src, 0, 0)
          nlist_add(fns, pair)
          p = new_p
        }
      } else { if kw == 9 {
        let old_p = p
        let new_p = parse_type_decl(toks, src, p + 1, tt)
        if new_p <= old_p {
          parse_error(src, tok_span(toks, p + 1), "error: malformed type declaration")
          p = sync_to_decl(toks, p + 1)
        } else { p = new_p }
      } else { if kw == 23 {
        -- effect declaration
        p = parse_effect_decl(toks, src, p + 1, tt)
      } else { if kw == 26 {
        -- trait declaration
        p = parse_trait_decl(toks, src, p + 1, tt)
      } else { if kw == 27 {
        -- impl block
        p = parse_impl_decl(toks, src, p + 1, tt, fns)
      } else { if kw == 19 {
        p = parse_use(toks, src, p + 1, fns, tt)
      } else { if kw == 32 {
        -- test "name" { body }
        p = parse_test_decl(toks, src, p + 1, fns)
      } else {
        p = p + 1
      } } } } } } }
    } else {
      -- Unexpected token at module level: skip to next declaration
      if tag != 5 {
        parse_error(src, tok_span(toks, p), "error: unexpected token at module level")
      } else { 0 }
      p = p + 1
    } }
  }
  fns
}

fn is_file_loaded(loaded: i64, src: i64, ns: i64, nl: i64) -> bool {
  let mut i = 0
  let mut found = false
  while i < nlist_len(loaded) {
    let entry = nlist_get(loaded, i)
    let e_ptr = mem_load64_at(entry, 0)
    let e_len = mem_load64_at(entry, 8)
    if e_len == nl {
      if src_eq_at(src, ns, e_ptr, 0, nl) == 1 {
        found = true
        i = nlist_len(loaded)
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  found
}

fn mark_file_loaded(loaded: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let entry = alloc_words(2)
  mem_store64_at(entry, 0, src + ns)
  mem_store64_at(entry, 8, nl)
  nlist_add(loaded, entry)
}

-- 4a S6: import-cycle detection over the ttable h+96 in-progress stack.
-- Loading is strictly nested (single-threaded recursive descent), so pop
-- invalidates the most recent live entry (len := -1) rather than shrinking.
fn loading_stack_push(stack: i64, ptr: i64, len: i64) -> i64 {
  let entry = alloc_words(2)
  mem_store64_at(entry, 0, ptr)
  mem_store64_at(entry, 8, len)
  nlist_add(stack, entry)
}

fn loading_stack_pop(stack: i64) -> i64 {
  let mut i = nlist_len(stack) - 1
  let mut done = 0
  while done == 0 {
    if i < 0 { done = 1 }
    else {
      let entry = nlist_get(stack, i)
      if mem_load64_at(entry, 8) >= 0 {
        mem_store64_at(entry, 8, 0 - 1)
        done = 1
      } else { i = i - 1 }
    }
  }
  0
}

fn loading_stack_contains(stack: i64, src: i64, ns: i64, nl: i64) -> bool {
  let mut i = 0
  let mut found = false
  while i < nlist_len(stack) {
    let entry = nlist_get(stack, i)
    let e_ptr = mem_load64_at(entry, 0)
    let e_len = mem_load64_at(entry, 8)
    if e_len == nl {
      if src_eq_at(src, ns, e_ptr, 0, nl) == 1 {
        found = true
        i = nlist_len(stack)
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  found
}

fn mark_trusted_import_source(tt: i64, path_ptr: i64, path_len: i64, file_buf: i64) -> i64 {
  if file_buf == 0 { 0 }
  else {
    if source_trust_path_is_trusted_import(path_ptr, path_len) == 1 {
      ttable_mark_trusted_source(tt, file_buf)
    } else { 0 }
    if source_trust_path_can_grant_import_trust(path_ptr, path_len) == 1 {
      ttable_mark_source_trust_grant_source(tt, file_buf)
    } else { 0 }
  }
}

fn parse_use(toks: i64, src: i64, pos: i64, fns: i64, tt: i64) -[Diagnose]> i64 {
  let path_ns = tok_v1(toks, pos)
  let path_nl = tok_v2(toks, pos)
  let resolved = pkg_resolve_default_import(src + path_ns, path_nl)
  let resolved_ptr = pkg_resolve_ptr(resolved)
  let resolved_len = pkg_resolve_len(resolved)
  let loaded = mem_load64_at(tt, 24)
  if pkg_resolve_status(resolved) < 0 {
    pos + 1
  } else { if is_file_loaded(loaded, resolved_ptr, 0, resolved_len) {
    -- Already loaded: a diamond re-import stays silently deduped, but a
    -- file still on the in-progress stack is a genuine cycle (4a S6).
    if loading_stack_contains(mem_load64_at(tt, 96), resolved_ptr, 0, resolved_len) {
      parse_error(src, tok_span(toks, pos), "error: circular import")
    } else { 0 }
    pos + 1
  } else {
    mark_file_loaded(loaded, resolved_ptr, 0, resolved_len)
    let loading = mem_load64_at(tt, 96)
    loading_stack_push(loading, resolved_ptr, resolved_len)
    let path = alloc_words(2)
    mem_store64_at(path, 0, resolved_ptr)
    mem_store64_at(path, 8, resolved_len)
    let file_r = read_file(path)
    let file_buf = mem_load64_at(file_r, 0)
    let file_len = mem_load64_at(file_r, 8)
    if file_len > 0 {
      mark_trusted_import_source(tt, resolved_ptr, resolved_len, file_buf)
      ttable_register_source(tt, file_buf, file_len, resolved_ptr, resolved_len)
      let file_toks = lex(file_buf, file_len)
      parse_use_module(file_toks, file_buf, fns, tt)
    } else { 0 }
    loading_stack_pop(loading)
    pos + 1
  } }
}

fn parse_use_file(fns: i64, tt: i64, path_str: str) -[Diagnose]> i64 {
  let path_ptr = __str_ptr(path_str)
  let path_len = __str_len(path_str)
  let loaded = mem_load64_at(tt, 24)
  if is_file_loaded(loaded, path_ptr, 0, path_len) {
    0
  } else {
    mark_file_loaded(loaded, path_ptr, 0, path_len)
    let loading = mem_load64_at(tt, 96)
    loading_stack_push(loading, path_ptr, path_len)
    let path = alloc_words(2)
    mem_store64_at(path, 0, path_ptr)
    mem_store64_at(path, 8, path_len)
    let file_r = read_file(path)
    let file_buf = mem_load64_at(file_r, 0)
    let file_len = mem_load64_at(file_r, 8)
    if file_len > 0 {
      mark_trusted_import_source(tt, path_ptr, path_len, file_buf)
      ttable_register_source(tt, file_buf, file_len, path_ptr, path_len)
      let file_toks = lex(file_buf, file_len)
      parse_use_module(file_toks, file_buf, fns, tt)
    } else { 0 }
    loading_stack_pop(loading)
    0
  }
}

fn parse_use_module(toks: i64, src: i64, fns: i64, tt: i64) -[Diagnose]> i64 {
  let mut p = 0
  let mut done = 0
  while done == 0 {
    let tag = tok_tag(toks, p)
    if tag == 7 { done = 1 }
    else { if tag == 3 {
      let kw = tok_v1(toks, p)
      if kw == 1 {
        let old_p = p
        let r = parse_fn(toks, src, p + 1)
        let new_p = unpack_pos(r)
        if new_p <= old_p {
          parse_error(src, tok_span(toks, p + 1), "error: malformed function declaration")
          p = sync_to_decl(toks, p + 1)
        } else {
          let pair = node_new(0, unpack_node(r), src, 0, 0)
          nlist_add(fns, pair)
          p = new_p
        }
      } else { if kw == 9 {
        let old_p = p
        let new_p = parse_type_decl(toks, src, p + 1, tt)
        if new_p <= old_p {
          parse_error(src, tok_span(toks, p + 1), "error: malformed type declaration")
          p = sync_to_decl(toks, p + 1)
        } else { p = new_p }
      } else { if kw == 23 {
        -- effect declaration in imported module
        p = parse_effect_decl(toks, src, p + 1, tt)
      } else { if kw == 26 {
        -- trait declaration in imported module
        p = parse_trait_decl(toks, src, p + 1, tt)
      } else { if kw == 27 {
        -- impl block in imported module
        p = parse_impl_decl(toks, src, p + 1, tt, fns)
      } else { if kw == 19 {
        p = parse_use(toks, src, p + 1, fns, tt)
      } else { p = p + 1 } } } } } }
    } else { p = p + 1 } }
  }
  0
}

-- Parse type declaration: type Name<T, U> { fields_or_variants }
fn parse_type_decl(toks: i64, src: i64, pos: i64, tt: i64) -> i64 {
  -- pos is after "type" keyword
  let type_ns = tok_v1(toks, pos)
  let type_nl = tok_v2(toks, pos)
  -- Check for <T, U> type parameters after name
  let tparams_r = if tok_tag(toks, pos + 1) == 4 {
    if tok_v1(toks, pos + 1) == 7 {
      parse_type_params(toks, src, pos + 2)
    } else { pack(0, pos + 1) }
  } else { pack(0, pos + 1) }
  let tparams = unpack_node(tparams_r)
  let p_after = unpack_pos(tparams_r)
  -- Set tctx so field/payload types can reference type vars
  let saved_tctx = mem_load64_at(toks, 24)
  mem_store64_at(toks, 24, tparams)
  -- skip {
  let p = p_after + 1
  let result = parse_type_decl_body(toks, src, p, tt, type_ns, type_nl, tparams)
  mem_store64_at(toks, 24, saved_tctx)
  result
}
fn parse_type_decl_body(toks: i64, src: i64, p: i64, tt: i64, type_ns: i64, type_nl: i64, tparams: i64) -> i64 {
  -- Detect record vs variant: if first field has : -> record
  let first_tag = tok_tag(toks, p + 1)
  let first_v1 = tok_v1(toks, p + 1)
  if first_tag == 5 {
    if first_v1 == 6 {
      -- Record: fields are name: type, ...
      let fields = alloc_words(1024)
      let end_pos = parse_record_fields(toks, src, p, fields)
      let nfields = mem_load64_at(fields, 8184)
      ttable_add(tt, src, type_ns, type_nl, 0, nfields, fields, tparams)
      end_pos
    } else {
      -- Variant: constructors are Name(type) or Name, ...
      let variants = alloc_words(1024)
      let end_pos = parse_variant_fields(toks, src, p, variants, src)
      let nvariants = mem_load64_at(variants, 8184)
      ttable_add(tt, src, type_ns, type_nl, 1, nvariants, variants, tparams)
      end_pos
    }
  } else {
    -- Variant (starts with ident not followed by :)
    let variants = alloc_words(1024)
    let end_pos = parse_variant_fields(toks, src, p, variants, src)
    let nvariants = mem_load64_at(variants, 8184)
    ttable_add(tt, src, type_ns, type_nl, 1, nvariants, variants, tparams)
    end_pos
  }
}

fn parse_record_fields(toks: i64, src: i64, pos: i64, fields: i64) -> i64 {
  -- Parse field_name: type, ...  until }
  let mut p = pos
  let mut i = 0
  let mut done = 0
  while done == 0 {
    let tag = tok_tag(toks, p)
    if tag == 5 {
      if tok_v1(toks, p) == 4 {
        -- } — end of fields
        done = 1
      } else {
        -- field_name: type
        let f_ns = tok_v1(toks, p)
        let f_nl = tok_v2(toks, p)
        let ty_r = parse_type(toks, src, p + 2, mem_load64_at(toks, 24))
        mem_store64_at(fields, i * 24, f_ns)
        mem_store64_at(fields, i * 24 + 8, f_nl)
        mem_store64_at(fields, i * 24 + 16, unpack_node(ty_r))
        p = skip_comma(toks, unpack_pos(ty_r))
        i = i + 1
      }
    } else {
      let f_ns = tok_v1(toks, p)
      let f_nl = tok_v2(toks, p)
      let ty_r = parse_type(toks, src, p + 2, mem_load64_at(toks, 24))
      mem_store64_at(fields, i * 24, f_ns)
      mem_store64_at(fields, i * 24 + 8, f_nl)
      mem_store64_at(fields, i * 24 + 16, unpack_node(ty_r))
      p = skip_comma(toks, unpack_pos(ty_r))
      i = i + 1
    }
  }
  mem_store64_at(fields, 8184, i)
  p + 1
}

fn parse_variant_fields(toks: i64, src: i64, pos: i64, variants: i64, src_base: i64) -> i64 {
  let tctx = mem_load64_at(toks, 24)
  let mut p = pos
  let mut i = 0
  let mut done = 0
  while done == 0 {
    let tag = tok_tag(toks, p)
    if tag == 5 {
      if tok_v1(toks, p) == 4 {
        done = 1
      } else {
        p = p + 1
      }
    } else { if tag == 2 {
      let v_ns = tok_v1(toks, p)
      let v_nl = tok_v2(toks, p)
      let v_hash = str_hash(src_base, v_ns, v_nl)
      let next_tag = tok_tag(toks, p + 1)
      let next_v1 = tok_v1(toks, p + 1)
      if next_tag == 5 {
        if next_v1 == 1 {
          -- Variant(type, ...) — payload types are stored as a list.
          let payloads = nlist_new()
          let after_payloads = parse_variant_payload_types(toks, src, p + 2, tctx, payloads)
          mem_store64_at(variants, i * 40, v_ns)
          mem_store64_at(variants, i * 40 + 8, v_nl)
          mem_store64_at(variants, i * 40 + 16, v_hash)
          mem_store64_at(variants, i * 40 + 24, nlist_len(payloads))
          mem_store64_at(variants, i * 40 + 32, payloads)
          p = skip_comma(toks, after_payloads)
          i = i + 1
        } else {
          mem_store64_at(variants, i * 40, v_ns)
          mem_store64_at(variants, i * 40 + 8, v_nl)
          mem_store64_at(variants, i * 40 + 16, v_hash)
          mem_store64_at(variants, i * 40 + 24, 0)
          mem_store64_at(variants, i * 40 + 32, 0)
          p = skip_comma(toks, p + 1)
          i = i + 1
        }
      } else {
        mem_store64_at(variants, i * 40, v_ns)
        mem_store64_at(variants, i * 40 + 8, v_nl)
        mem_store64_at(variants, i * 40 + 16, v_hash)
        mem_store64_at(variants, i * 40 + 24, 0)
        mem_store64_at(variants, i * 40 + 32, 0)
        p = skip_comma(toks, p + 1)
        i = i + 1
      }
    } else {
      done = 1
    } }
  }
  mem_store64_at(variants, 8184, i)
  if tok_tag(toks, p) == 5 {
    if tok_v1(toks, p) == 4 { p + 1 } else { p }
  } else { p }
}

fn parse_variant_payload_types(toks: i64, src: i64, pos: i64, tctx: i64, payloads: i64) -> i64 {
  let mut p = pos
  let mut done = 0
  if tok_tag(toks, p) == 5 {
    if tok_v1(toks, p) == 2 { done = 1 p = p + 1 } else { 0 }
  } else { 0 }
  while done == 0 {
    let ty_r = parse_type(toks, src, p, tctx)
    nlist_add(payloads, unpack_node(ty_r))
    p = unpack_pos(ty_r)
    if tok_tag(toks, p) == 5 {
      if tok_v1(toks, p) == 5 { p = p + 1 }
      else { if tok_v1(toks, p) == 2 { done = 1 p = p + 1 }
      else { done = 1 } }
    } else { done = 1 }
  }
  p
}
