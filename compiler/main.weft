  mcp_result(McpOptCounters, members.reverse())
}

fn mcp_opt_counters(source: str) -[SourceAcquire]> str {
  match mcp_standalone_program(source_from_text(source)) {
    McpStandaloneParseErrors -> mcp_opt_counters_failure("parse errors")
    McpStandaloneParsed(
      AstModule(
        check_fns,
        check_src,
        check_tt,
        check_owners,
        (check_declarations, check_registrations)
      )
    ) -> {
      -- This is a source-local analysis surface, not an emitted artifact. Bind
      -- only dependencies reached by the submitted program so the counters do
      -- not measure the compiler's universal fatal-reporting runtime.
      let checked = handle {
        let loader = parse_source_loader_with_owners(check_tt, check_owners)
        let registrations = registration_builder_from_scope(check_registrations)
        pipeline_bind_runtime_preludes_inner_with_registration_scope(
          check_fns,
          check_src,
          check_tt,
          loader,
          registrations
        )
        weft_check.report(
          CheckProgram,
          AstModule(
            check_fns,
            check_src,
            check_tt,
            source_loader_owners(loader),
            (check_declarations, registration_builder_freeze(registrations))
          )
        )
      } {
        Diagnose.report(diagnostic) -> resume(0)
        Diagnose.error(msg, span) -> resume(0)
        Diagnose.warn(msg, span) -> resume(0)
        Diagnose.note(msg, span) -> resume(0)
      }
      match checked.result {
        CheckRejected -> mcp_opt_counters_failure("check errors")
        Checked(typed) -> {
          main_acquire_native_libraries(typed)
          let ir = pipeline_lower_checked_with_weft(typed)
          let optimised = pipeline_optimise_typed_ir(typed, ir)
          -- Armed emission: the residency audit and the emission allocation
          -- checker run over the emitted buffer, so their counters are live.
          mcp_opt_counters_result(
            pipeline_lower_native_module_with_audit(typed, optimised, 1),
            optimised
          )
        }
      }
    }
  }
}

-- Diagnostics -----------------------------------------------------------
fn mcp_diagnostics_result(items: MainJsonItems, functions: i64, check_errors: i64) -> str {
  let members = [
    jsonrpc_member("phase", JsonString("parse+check")),
    jsonrpc_member("diagnostics", JsonNumber(main_json_items_count(items))),
    jsonrpc_member("functions", JsonNumber(functions)),
    jsonrpc_member("check_errors", JsonNumber(check_errors)),
    jsonrpc_member("position_units", mcp_position_units()),
    jsonrpc_member("items", main_json_items_array(items))
  ]
  mcp_result(McpDiagnostics, main_in_order(members[..]))
}

-- Parse and check outside the session when it holds no product to render.
fn mcp_diagnostics_standalone(text: str) -> str {
  let source = source_from_text(text)
  let src = main_legacy_address(source.text)
  let n = str_len(text)
  let tt = ttable_new()
  pipeline_mark_root_origin(tt, src, 0, 1)
  let items = main_json_items()
  let ast = mcp_collect_diagnostics(items, src, n, tt, () => pipeline_parse_local(source, tt))
  let declarations = pipeline_ast_source_declarations(ast)
  let mut check_ast = ast
  let mut check_n = n
  if test_prepare.count(declarations) > 0 {
    let prefixed = test_prepare_source(source.text, test_prepare.count(declarations))
    let prepared = source_from_text(test_prepare_source_content(prefixed))
    let wrapped_src = main_legacy_address(prepared.text)
    let test_n = str_len(prepared.text)
    check_n = test_n
    let name_bank_start = test_prepare_source_wrapper_bank_start(prefixed)
    let wrapped_tt = ttable_new()
    main_mark_root_origin_with_grant(wrapped_tt, wrapped_src, 0, 1, 0)
    let parsed = mcp_collect_diagnostics(
      items,
      wrapped_src,
      test_n,
      wrapped_tt,
      () => pipeline_parse_local(prepared, wrapped_tt)
    )
    check_ast = match parsed {
      AstModule(functions, parsed_src, parsed_tt, owners, (declarations, registrations)) -> {
        let wrapped = test_prepare.wrap(
          functions,
          declarations,
          parsed_src,
          name_bank_start,
          parsed_tt,
          registrations
        )
        AstModule(
          wrapped.functions,
          parsed_src,
          parsed_tt,
          owners,
          (declarations, wrapped.registrations)
        )
      }
    }
  }
  let final_ast = check_ast
  let final_n = check_n
  match final_ast {
    AstModule(final_fns, final_src, final_tt, owners, (declarations, _)) -> {
      let checked = mcp_collect_diagnostics(
        items,
        final_src,
        final_n,
        final_tt,
        () => weft_check.report(CheckProgram, final_ast)
      )
      mcp_diagnostics_result(items, main_fns_source_count(final_fns, final_src), checked.errors)
    }
  }
}

fn mcp_diagnostics(session: ProjectSession, source: str) -[SourceAcquire]> str {
  let context = mcp_project_update_source(session, source)
  match project_session_check_with_acquire(session, context) {
    ProjectCheckSucceeded(typed, source_n, parse_diagnostics, check_diagnostics) ->
      mcp_project_diagnostics_result(typed, parse_diagnostics, check_diagnostics, 0)
    ProjectCheckFailed(typed, source_n, parse_diagnostics, check_diagnostics) ->
      mcp_project_diagnostics_result(
        typed,
        parse_diagnostics,
        check_diagnostics,
        project_diagnostics_error_count(check_diagnostics)
      )
    ProjectCheckParseFailed(ProjectPreparedParseFailed(ast, source_n, diagnostics)) -> {
      let items = main_json_items()
      mcp_diag_items_add_project(items, diagnostics)
      match ast {
        -- The checker does not run after a parse failure. Keep that distinct
        -- from the structured parse diagnostic count.
        AstModule(fns, src, tt, owners, (declarations, _)) -> mcp_diagnostics_result(
          items,
          main_fns_source_count(fns, src),
          0
        )
      }
    }
    -- Unset/cyclic/corrupt query state has no semantic product to render.
    _ -> mcp_diagnostics_standalone(source)
  }
}

fn mcp_project_diagnostics_result(
  typed: TypedModule,
  parse_diagnostics: ProjectDiagnostics,
  check_diagnostics: ProjectDiagnostics,
  check_errors: i64
) -> str {
  let items = main_json_items()
  mcp_diag_items_add_project(items, parse_diagnostics)
  mcp_diag_items_add_project(items, check_diagnostics)
  mcp_diagnostics_result(
    items,
    main_fns_source_count(pipeline_typed_fns(typed), mcp_typed_module_src(typed)),
    check_errors
  )
}

-- Formatting ------------------------------------------------------------
--- Where formatter diagnostics are projected: MCP items, or LSP items for
--- the document with this URI.
type MainDiagnosticWire {
  MainMcpWire,
  MainLspWire(LspServer, str)
}

-- LSP and MCP deliberately share this one adapter over the parse-only
-- formatter. The Diagnose handler is the typed transport boundary: it
-- projects each value while it is live.
fn main_format_transport(
  text: str,
  items: MainJsonItems,
  wire: MainDiagnosticWire,
  config: format_config.Config
) -> FormatterResult {
  let src = main_legacy_address(text)
  let n = str_len(text)
  let tt = ttable_new()
  pipeline_mark_root_origin(tt, src, 0, 1)
  match wire {
    MainMcpWire -> mcp_collect_diagnostics(
      items,
      src,
      n,
      tt,
      () => formatter_format_source_with_config(src, n, tt, config)
    )
    MainLspWire(server, uri) -> lsp_collect_diagnostics_into(
      items,
      server,
      uri,
      tt,
      src,
      n,
      () => formatter_format_source_with_config(src, n, tt, config)
    )
  }
}

--- The layout policy named by `key` in `options`: the defaults when absent,
--- `None` unless it is a positive integer.
fn main_format_config(options: Json, key: str) -> Option<format_config.Config> {
  match options.get(key) {
    None -> Some(format_config.defaults())
    Some(JsonNumber(length)) -> format_config.from_max_line_length(length)
    Some(_) -> None<format_config.Config>()
  }
}

fn mcp_format_source(source: str, config: format_config.Config) -> str {
  let items = main_json_items()
  match main_format_transport(source, items, MainMcpWire, config) {
    FormatterSuccess(formatted) -> {
      let members = [
        jsonrpc_member("formatted", JsonString(formatted)),
        jsonrpc_member("diagnostics", JsonNumber(main_json_items_count(items))),
        jsonrpc_member("position_units", mcp_position_units()),
        jsonrpc_member("items", main_json_items_array(items))
      ]
      mcp_result(McpFormatSource, main_in_order(members[..]))
    }
    FormatterFailure(error_count) -> {
      let members = [
        jsonrpc_member("tool", JsonString("format_source")),
        jsonrpc_member("ok", JsonBool(false)),
        jsonrpc_member("schema_version", JsonNumber(1)),
        jsonrpc_member("stability", JsonString("stable")),
        jsonrpc_member("error_count", JsonNumber(error_count)),
        jsonrpc_member("diagnostics", JsonNumber(main_json_items_count(items))),
        jsonrpc_member("position_units", mcp_position_units()),
        jsonrpc_member("items", main_json_items_array(items))
      ]
      jsonrpc_render(jsonrpc_object(members[..]))
    }
  }
}

-- ======================================================================
-- Tool: grammar_diagnostics — the grammar tool driver as a handler
-- configuration. The compiler resolves the export through the manifests in
-- scope, builds or reuses its driver product, and exchanges one request
-- over an interactive child session. Host type queries are answered from
-- the checked host module; every diagnostic is re-anchored onto the request
-- source before the shared item emitter renders it. The compiler never
-- imports the grammar.
-- ======================================================================
--- The host a grammar tool runs in: the process arguments the platform
--- handlers inherit the environment from, and the running compiler's
--- executable identity for driver product stamps. The digest is taken once
--- per server, on the first grammar request.
type MainGrammarHost { argc: i64, argv: i64, executable: str, digest: Vector<str> }

fn main_grammar_host(argc: i64, argv: i64) -> MainGrammarHost {
  let executable = mem_load64_at(argv, 0)
  MainGrammarHost {
    argc: argc,
    argv: argv,
    executable: if executable == 0 { "" } else {
      runtime_str_from_bytes_copy(executable, cstr_len(executable))
    },
    digest: vector.with_capacity<str>(__i64_to_usize(1))
  }
}

fn main_compiler_digest(host: MainGrammarHost) -> str {
  let digest = host.digest
  if vector_len<str>(digest) == 0 {
    vector_push<str>(digest, grammar_tool_compiler_digest(host.executable))
    nil
  } else { nil }
  vector_get_in_bounds<str>(digest, 0)
}

--- Run one exchange with the platform process and clock handlers installed
--- exactly around it; no other tool performs those effects, and checking
--- never runs beneath them. The caller keeps the checked host module alive
--- for the table and retained source it passes.
fn mcp_grammar_exchange(
  host: MainGrammarHost,
  product: str,
  request: ToolRequest,
  table: i64,
  source: i64,
  registrations: RegistrationScope,
  with_host_types: bool
) -> GrammarToolExchange {
  with process_handler(host.argc, host.argv) {
    platform_time.with_platform(
      () => {
        let deadline = mcp_grammar_deadline()
        if with_host_types {
          grammar_tool_exchange_with_host(
            product,
            request,
            table,
            source,
            registrations,
            deadline
          )
        } else { grammar_tool_exchange_without_host(product, request, deadline) }
      }
    )
  }
}

-- Grammar diagnostics ---------------------------------------------------
--- Which context a request names. Host source and context file are
--- exclusive by schema.
type McpGrammarContext {
  McpGrammarParseOnly,
  McpGrammarHostSource(str),
  McpGrammarContextFile(Path, usize)
}

fn mcp_grammar_context_file(file: str, arguments: Json) -> Result<McpGrammarContext, str> {
  let limit = mcp_argument_integer(arguments, "context_limit").unwrap_or(1048576)
  if limit <= 0 { return Err<McpGrammarContext, str>("invalid context limit") }
  match path.from_utf8(file) {
    Err(_) -> Err<McpGrammarContext, str>("invalid context file")
    Ok(context_path) -> Ok<McpGrammarContext, str>(
      McpGrammarContextFile(
        context_path,
        limit.to_usize_checked().expect("positive i64 context limit fits usize")
      )
    )
  }
}

fn mcp_grammar_context(arguments: Json) -> Result<McpGrammarContext, str> {
  match mcp_argument_text(arguments, "context_file") {
    file: str -> match mcp_argument_text(arguments, "host_source") {
      host: str -> Err<McpGrammarContext, str>(
        "host_source and context_file are mutually exclusive"
      )
      nil -> mcp_grammar_context_file(file, arguments)
    }
    nil -> match mcp_argument_text(arguments, "host_source") {
      host: str -> Ok<McpGrammarContext, str>(McpGrammarHostSource(host))
      nil -> Ok<McpGrammarContext, str>(McpGrammarParseOnly)
    }
  }
}

fn mcp_grammar_tool_context(context: McpGrammarContext) -> ToolContext {
  match context {
    McpGrammarParseOnly -> ToolNoContext
    McpGrammarHostSource(_) -> ToolHostContext
    McpGrammarContextFile(context_path, limit) -> ToolFileContext(context_path, limit)
  }
}

fn mcp_grammar_phase(context: McpGrammarContext) -> str {
  match context {
    McpGrammarParseOnly -> "parse"
    _ -> "parse+check"
  }
}

--- The source identity every driver diagnostic names for the request text.
fn mcp_grammar_source_name() -> str { "input" }

--- The exchange with the driver is bounded: a driver that does not answer
--- in time is killed and reaped. Building a cold driver product and checking
--- the host source happen before the deadline starts and are bounded by the
--- compiler's own limits, not by this one.
fn mcp_grammar_deadline() -[MonotonicClock]> Instant {
  monotonic.now().add(time.seconds(30))
}

fn mcp_grammar_candidates(candidates: List<str>) -> str {
  match candidates {
    Nil -> ""
    Cons(only, Nil) -> only
    Cons(first, rest) -> str_concat(first, str_concat(", ", mcp_grammar_candidates(rest)))
  }
}

--- Add every diagnostic as an item anchored on the request source and count
--- the errors among them.
fn mcp_grammar_items(items: MainJsonItems, source: str, diagnostics: List<Diagnostic>) -> i64 {
  let src = main_legacy_address(source)
  let mut errors = 0
  let mut remaining = diagnostics
  while not remaining.is_empty() {
    match remaining {
      Nil -> nil
      Cons(diagnostic, rest) -> {
        let anchored = grammar_tool_anchor(diagnostic, mcp_grammar_source_name(), src)
        mcp_diag_items_add_report(items, src, str_len(source), 0, anchored)
        errors = errors + match anchored.severity() {
          DiagnosticSeverityError -> 1
          _ -> 0
        }
        remaining = rest
      }
    }
  }
  errors
}

fn mcp_grammar_observed(inputs: List<ToolObservedInput>) -> Json {
  JsonArray(
    inputs.map<Json>(
      (input: ToolObservedInput) =>
        encode_observed(input).expect("observed input paths decode from UTF-8 wire text")
    )
  )
}

fn mcp_grammar_response(
  name: str,
  export: GrammarToolExport,
  context: McpGrammarContext,
  source: str,
  response: ToolResponse
) -> str {
  let items = main_json_items()
  let errors = mcp_grammar_items(items, source, response.diagnostics)
  -- Checking runs only on `Parsed` syntax, which the grammar contract defines
  -- as free of parse errors, so after an accepted parse every error reported
  -- is a check error.
  let check_errors = match response.parse {
    ParseOutcomeParsed -> errors
    _ -> 0
  }
  let members = [
    jsonrpc_member("grammar", JsonString(name)),
    jsonrpc_member("package", JsonString(export.package_name)),
    jsonrpc_member("version", JsonString(export.version)),
    jsonrpc_member("export", JsonString(export.export)),
    jsonrpc_member("phase", JsonString(mcp_grammar_phase(context))),
    jsonrpc_member("diagnostics", JsonNumber(main_json_items_count(items))),
    jsonrpc_member("check_errors", JsonNumber(check_errors)),
    jsonrpc_member("parse", JsonString(parse_name(response.parse))),
    jsonrpc_member("check", encode_check(response.check)),
    jsonrpc_member("observed_inputs", mcp_grammar_observed(response.observed_inputs)),
    jsonrpc_member("position_units", mcp_position_units()),
    jsonrpc_member("items", main_json_items_array(items))
  ]
  mcp_result(McpGrammarDiagnostics, main_in_order(members[..]))
}

fn mcp_grammar_answer(
  name: str,
  export: GrammarToolExport,
  context: McpGrammarContext,
  source: str,
  exchange: GrammarToolExchange
) -> McpOutcome {
  match exchange {
    GrammarToolFailed(failure) -> McpFailure(
      JsonRpcInternalError,
      grammar_tool_failure_message(failure)
    )
    GrammarToolAnswered(response) -> McpPayload(
      mcp_grammar_response(name, export, context, source, response)
    )
  }
}

fn mcp_grammar_diagnostics(
  arguments: Json,
  source: str,
  host: MainGrammarHost
) -[SourceAcquire]> McpOutcome {
  let name = match mcp_argument_text(arguments, "grammar") {
    nil -> return McpFailure(JsonRpcInvalidParams, "missing grammar")
    named: str -> named
  }
  let context = match mcp_grammar_context(arguments) {
    Err(message) -> return McpFailure(JsonRpcInvalidParams, message)
    Ok(context) -> context
  }
  match grammar_tool_resolve(name) {
    GrammarToolUnknown -> McpFailure(JsonRpcInvalidParams, "unknown grammar")
    GrammarToolAmbiguous(candidates) -> McpFailure(
      JsonRpcInvalidParams,
      str_concat("ambiguous grammar; name one of ", mcp_grammar_candidates(candidates))
    )
    GrammarToolResolved(export) -> match grammar_tool_ensure_product(
      export,
      native_link_target_host(),
      main_compiler_digest(host)
    ) {
      GrammarToolProductFailed(message) -> McpFailure(JsonRpcInternalError, message)
      GrammarToolProductReady(product) -> {
        let request = ToolRequest {
          grammar: grammar_tool_identity(export),
          source_name: mcp_grammar_source_name(),
          source_text: source,
          context: mcp_grammar_tool_context(context),
          operation: ToolOperationCheck
        }
        -- The checked host module owns the table and retained source the
        -- type-query handler reads; destructuring in the arm keeps it alive
        -- for the whole exchange.
        match context {
          McpGrammarHostSource(host_source) -> match mcp_check_source_quiet(host_source) {
            TypedModule(fns, host_src, tt, owners, registrations) -> mcp_grammar_answer(
              name,
              export,
              context,
              source,
              mcp_grammar_exchange(host, product, request, tt, host_src, registrations, true)
            )
          }
          _ -> mcp_grammar_answer(
            name,
            export,
            context,
            source,
            mcp_grammar_exchange(host, product, request, 0, 0, registration_scope(), false)
          )
        }
      }
    }
  }
}

-- Semantic facts --------------------------------------------------------
fn mcp_lookup_result(tool: McpTool, key: JsonEntry, envelope: SemanticFactEnvelope) -> str {
  mcp_result(tool, Cons(key, mcp_found_members(envelope)))
}

fn mcp_semantic_envelope_found(envelope: SemanticFactEnvelope) -> bool {
  match envelope {
    SemanticFactEnvelope(version, SemanticFactFound(fact)) -> true
    _ -> false
  }
}

fn mcp_type_lookup(session: ProjectSession, source: str, name: str) -[SourceAcquire]> str {
  match mcp_project_checked_source(session, source) {
    TypedModule(fns, checked_src, tt, owners, registrations) -> {
      let storage = registration_storage(tt, registrations)
      let entry = semantic_fact_resolve_function_entry(tt, checked_src, name, storage)
      let ownership = semantic_fact_ownership_from_borrow_summary(
        pipeline_ir_semantic_borrow_summary_for_entry(fns, tt, entry)
      )
      let function = semantic_fact_function_entry_with_ownership(tt, entry, ownership, storage)
      let fact = if mcp_semantic_envelope_found(function) { function } else {
        semantic_fact_query_type(tt, checked_src, name, storage)
      }
      mcp_lookup_result(McpTypeLookup, jsonrpc_member("name", JsonString(name)), fact)
    }
  }
}

fn mcp_effect_lookup(session: ProjectSession, source: str, name: str) -[SourceAcquire]> str {
  match mcp_project_checked_source(session, source) {
    TypedModule(fns, checked_src, tt, owners, registrations) -> {
      let storage = registration_storage(tt, registrations)
      mcp_lookup_result(
        McpEffectLookup,
        jsonrpc_member("name", JsonString(name)),
        semantic_fact_query_effect(tt, checked_src, name, storage)
      )
    }
  }
}

fn mcp_position_tool(
  tool: McpTool,
  arguments: Json,
  source: str,
  session: ProjectSession
) -[SourceAcquire]> McpOutcome {
  let offset = match mcp_argument_integer(arguments, "offset") {
    None -> return McpFailure(JsonRpcInvalidParams, "missing position offset")
    Some(value) -> value
  }
  if offset < 0 or offset > str_len(source) {
    return McpFailure(JsonRpcInvalidParams, "position offset out of range")
  }
  let key = jsonrpc_member("offset", JsonNumber(offset))
  match tool {
    McpConformanceAtPosition -> match mcp_argument_text(arguments, "trait") {
      nil -> McpFailure(JsonRpcInvalidParams, "missing trait name")
      trait_name: str -> match mcp_project_checked_source(session, source) {
        TypedModule(fns, checked_src, tt, owners, registrations) -> {
          let storage = registration_storage(tt, registrations)
          McpPayload(
            mcp_lookup_result(
              tool,
              key,
              semantic_fact_query_conformance_at(tt, checked_src, offset, trait_name, storage)
            )
          )
        }
      }
    }
    McpVisibleBindings -> match mcp_project_checked_source(session, source) {
      TypedModule(fns, checked_src, tt, owners, registrations) -> {
        let storage = registration_storage(tt, registrations)
        let bindings = semantic_fact_visible_bindings(tt, checked_src, offset, storage)
        let members = [key, jsonrpc_member("bindings", mcp_bindings(bindings))]
        McpPayload(mcp_result(tool, main_in_order(members[..])))
      }
    }
    _ -> match mcp_project_checked_source(session, source) {
      TypedModule(fns, checked_src, tt, owners, registrations) -> {
        let storage = registration_storage(tt, registrations)
        McpPayload(
          mcp_lookup_result(
            tool,
            key,
            semantic_fact_query_cursor_position(tt, checked_src, offset, storage)
          )
        )
      }
    }
  }
}

fn mcp_lookup_tool(
  tool: McpTool,
  arguments: Json,
  source: str,
  session: ProjectSession
) -[SourceAcquire]> McpOutcome {
  match mcp_argument_text(arguments, "name") {
    nil -> McpFailure(JsonRpcInvalidParams, "missing lookup name")
    name: str -> match tool {
      McpEffectLookup -> McpPayload(mcp_effect_lookup(session, source, name))
      _ -> McpPayload(mcp_type_lookup(session, source, name))
    }
  }
}

-- Dispatch and transports -----------------------------------------------
fn mcp_run_tool(
  tool: McpTool,
  arguments: Json,
  session: ProjectSession,
  host: MainGrammarHost
) -[SourceAcquire]> McpOutcome {
  let source = match mcp_argument_text(arguments, "source") {
    nil -> return McpFailure(JsonRpcInvalidParams, "missing source")
    text: str -> text
  }
  match tool {
    McpParseSummary -> McpPayload(mcp_parse_summary(session, source))
    McpCheckSummary -> McpPayload(mcp_check_summary(session, source))
    McpIrSummary -> McpPayload(mcp_ir_summary(session, source))
    McpTypeLookup -> mcp_lookup_tool(tool, arguments, source, session)
    McpEffectLookup -> mcp_lookup_tool(tool, arguments, source, session)
    McpDiagnostics -> McpPayload(mcp_diagnostics(session, source))
    McpGrammarDiagnostics -> mcp_grammar_diagnostics(arguments, source, host)
    McpOptCounters -> McpPayload(mcp_opt_counters(source))
    McpFactAtPosition -> mcp_position_tool(tool, arguments, source, session)
    McpVisibleBindings -> mcp_position_tool(tool, arguments, source, session)
    McpConformanceAtPosition -> mcp_position_tool(tool, arguments, source, session)
    McpFormatSource -> match main_format_config(arguments, "max_line_length") {
      Some(config) -> McpPayload(mcp_format_source(source, config))
      None -> McpFailure(JsonRpcInvalidParams, "max_line_length must be a positive integer")
    }
  }
}

fn mcp_one_shot_request(
  method: str,
  params: Json,
  session: ProjectSession,
  host: MainGrammarHost
) -[SourceAcquire]> McpOutcome {
  match mcp_request(method, params) {
    McpListTools -> McpPayload(mcp_tools_list_payload())
    McpCallTool(tool, arguments) -> mcp_run_tool(tool, arguments, session, host)
    McpToolNameMissing -> McpFailure(JsonRpcInvalidParams, "missing tool name")
    McpToolUnknown -> McpFailure(JsonRpcMethodNotFound, "unknown tool")
    _ -> McpFailure(JsonRpcMethodNotFound, "unknown method")
  }
}

-- The historical one-shot envelope answers every request as id 1, except a
-- document that could not be parsed, which has no id.
fn mcp_one_shot_id(code: JsonRpcErrorCode) -> JsonRpcId? {
  match code {
    JsonRpcParseError -> return nil
    _ -> nil
  }
  JsonRpcNumberId(1)
}

-- Legacy one-shot pipe: one request on standard input, one response on
-- standard output. Scripts and the tool boundary snapshots depend on this
-- exact wire format.
fn mcp_one_shot(
  session: ProjectSession,
  host: MainGrammarHost
) -[
  ConsoleRead,
  ConsoleWrite,
  SourceAcquire
]> nil {
  let outcome = match jsonrpc_decode(jsonrpc_read_all(jsonrpc_input())) {
    JsonRpcUnparsable -> McpFailure(JsonRpcParseError, "invalid json-rpc")
    JsonRpcInvalid(_) -> McpFailure(JsonRpcInvalidRequest, "invalid request")
    JsonRpcCall(_, method, params) -> mcp_one_shot_request(method, params, session, host)
    JsonRpcNotice(method, params) -> mcp_one_shot_request(method, params, session, host)
  }
  jsonrpc_write_text(
    match outcome {
      McpPayload(payload) -> jsonrpc_result(JsonRpcNumberId(1), payload)
      McpFailure(code, message) -> jsonrpc_error(mcp_one_shot_id(code), code, message)
    }
  )
}

fn run_mcp(argc: i64, argv: i64) -[SourceAcquire]> i64 {
  let session = project_session_new(1)
  let host = main_grammar_host(argc, argv)
  with console_input() {
    with console_terminal() { mcp_one_shot(session, host) }
  }
  0
}

fn mcp_serve_response(
  id: JsonRpcId,
  method: str,
  params: Json,
  session: ProjectSession,
  host: MainGrammarHost
) -[SourceAcquire]> str {
  match mcp_request(method, params) {
    McpInitialize(initialize) -> jsonrpc_result(
      id,
      mcp_initialize_payload(initialize, weft_compiler_version())
    )
    McpPing -> jsonrpc_result(id, "{}")
    McpListTools -> jsonrpc_result(id, mcp_serve_tools_list_payload())
    McpCallTool(tool, arguments) -> match mcp_run_tool(tool, arguments, session, host) {
      McpPayload(payload) -> jsonrpc_result(id, mcp_content(payload))
      McpFailure(code, message) -> jsonrpc_error(id, code, message)
    }
    McpToolNameMissing -> jsonrpc_error(id, JsonRpcInvalidParams, "missing tool name")
    McpToolUnknown -> jsonrpc_error(id, JsonRpcMethodNotFound, "unknown tool")
    McpMethodUnknown -> jsonrpc_error(id, JsonRpcMethodNotFound, "method not found")
  }
}

fn mcp_serve_message(
  message: JsonRpcMessage,
  session: ProjectSession,
  host: MainGrammarHost
) -[ConsoleWrite, SourceAcquire]> nil {
  match message {
    JsonRpcUnparsable -> jsonrpc_write_line(jsonrpc_error(nil, JsonRpcParseError, "parse error"))
    -- Notifications (initialized, cancelled, ...) are never answered.
    JsonRpcNotice(_, _) -> nil
    JsonRpcInvalid(JsonRpcIdAbsent) -> nil
    JsonRpcInvalid(JsonRpcIdUnusable) -> jsonrpc_write_line(
      jsonrpc_error(nil, JsonRpcInvalidRequest, "invalid request")
    )
    JsonRpcInvalid(JsonRpcIdGiven(id)) -> jsonrpc_write_line(
      jsonrpc_error(id, JsonRpcInvalidRequest, "invalid request")
    )
    JsonRpcCall(id, method, params) -> jsonrpc_write_line(
      mcp_serve_response(id, method, params, session, host)
    )
  }
}

-- `weft mcp serve`: the persistent MCP server. Newline-delimited JSON-RPC
-- with the initialize handshake, request-id echo, tools/list with input
-- schemas, and tools/call results wrapped as MCP content.
fn mcp_serve(
  session: ProjectSession,
  host: MainGrammarHost
) -[
  ConsoleRead,
  ConsoleWrite,
  SourceAcquire
]> nil {
  let input = jsonrpc_input()
  loop {
    match jsonrpc_read_line(input) {
      nil -> return nil
      line: Bytes -> if not line.is_empty() {
        mcp_serve_message(jsonrpc_decode(line), session, host)
      }
    }
  }
  nil
}

fn run_mcp_serve(argc: i64, argv: i64) -[SourceAcquire]> i64 {
  let session = project_session_new(1)
  let host = main_grammar_host(argc, argv)
  with console_input() {
    with console_terminal() { mcp_serve(session, host) }
  }
  0
}

-- ======================================================================
-- Tool: lsp — standard-stream language server
-- ======================================================================
fn lsp_reply(id: JsonRpcId?, result: str) -[ConsoleWrite]> nil {
  jsonrpc_write_frame(jsonrpc_result(id, result))
}

fn lsp_fail(id: JsonRpcId?, code: JsonRpcErrorCode, message: str) -[ConsoleWrite]> nil {
  jsonrpc_write_frame(jsonrpc_error(id, code, message))
}

fn lsp_project_overlay_identity() -> str { "lsp://active-documents" }

fn lsp_project_context(server: LspServer, uri: str, root: bool) -> ProjectQueryContext {
  project_query_context_with_overlay_set(
    0,
    uri,
    lsp_document_path(uri, lsp_server_workspace(server), root),
    project_source_origin_overlay(),
    0,
    1,
    lsp_project_overlay_identity()
  )
}

fn lsp_project_content(
  update: IncrementalInputUpdate<ProjectSourceSnapshot>,
  fallback: str
) -> str {
  match update {
    IncrementalInputInserted(ProjectSourcePresent(content)) -> content
    IncrementalInputChanged(ProjectSourcePresent(content)) -> content
    IncrementalInputUnchanged(ProjectSourcePresent(content)) -> content
    _ -> fallback
  }
}

fn lsp_project_sync_overlays(session: ProjectSession, server: LspServer) -> nil {
  let overlays = project_overlay_set_new()
  let mut remaining = lsp_open_documents(server)
  while not remaining.is_empty() {
    match remaining {
      Nil -> nil
      Cons(document, rest) -> {
        project_overlay_set_add(overlays, lsp_project_context(server, document.uri, false))
        remaining = rest
      }
    }
  }
  let index_context = project_query_context_with_overlay_set(
    0,
    "lsp://overlay-index",
    "",
    project_source_origin_overlay(),
    0,
    1,
    lsp_project_overlay_identity()
  )
  project_session_set_overlay_set(session, index_context, overlays)
  nil
}

-- Record a document's new text. The first document names the workspace when
-- `initialize` did not; the session's snapshot is the text documents keep,
-- so its storage identifies the document's diagnostics.
fn lsp_store_document(
  session: ProjectSession,
  server: LspServer,
  uri: str,
  text: str,
  version: i64
) -> LspDocument {
  if str_len(lsp_server_workspace(server)) == 0 {
    lsp_server_set_workspace(server, lsp_workspace_from_document(uri))
  }
  let content = lsp_project_content(
    project_session_set_source(session, lsp_project_context(server, uri, true), text),
    text
  )
  let document = LspDocument { uri: uri, text: content, version: version }
  lsp_server_store(server, document)
  lsp_project_sync_overlays(session, server)
  document
}

-- Checking --------------------------------------------------------------
fn lsp_check_quiet(
  server: LspServer,
  session: ProjectSession,
  document: LspDocument
) -[SourceAcquire]> TypedModule {
  match project_session_check_with_acquire(
    session,
    lsp_project_context(server, document.uri, true)
  ) {
    ProjectCheckSucceeded(typed, source_n, parse_diagnostics, check_diagnostics) -> typed
    ProjectCheckFailed(typed, source_n, parse_diagnostics, check_diagnostics) -> typed
    -- Preserve the historical recovery surface if an incremental query cannot
    -- provide a typed module. This is deliberately an exceptional fallback;
    -- normal diagnostics and semantic requests all share the cached result.
    _ -> mcp_check_source_quiet_with(
      document.text,
      lsp_document_path(document.uri, "", true),
      lsp_open_documents(server),
      document.uri,
      lsp_server_workspace(server)
    )
  }
}

-- Diagnostics -----------------------------------------------------------
-- A diagnostic located in another open document is published with that
-- document. A closed or disk-only dependency has no channel of its own, so
-- its diagnostics stay with the document that reached it.
fn lsp_diagnostic_belongs_to(server: LspServer, tt: i64, src: i64, span: i64) -> bool {
  let entry = ttable_find_source_entry(tt, span)
  if entry == 0 { return true }
  let owner = ttable_source_entry_buffer(entry)
  if owner == src { return true }
  let mut remaining = lsp_open_documents(server)
  loop {
    match remaining {
      Nil -> return true
      Cons(document, rest) -> {
        if runtime_str_storage_identity(document.text) == owner { return false }
        remaining = rest
      }
    }
  }
  true
}

fn lsp_severity(severity: DiagnosticSeverity) -> i64 {
  match severity {
    DiagnosticSeverityError -> 1
    DiagnosticSeverityWarning -> 2
    DiagnosticSeverityNote -> 3
  }
}

fn lsp_diag_item_members(
  src: i64,
  n: i64,
  severity: DiagnosticSeverity,
  message: str,
  absolute_span: i64,
  absolute_end: i64,
  code: DiagnosticCode,
  encoding: SourcePositionEncoding
) -> List<JsonEntry> {
  -- Spans are absolute addresses; reduce them to offsets in their source.
  let span = diagnose_normalize_span(src, absolute_span)
  let end_span = diagnose_normalize_span(src, absolute_end)
  let members = main_members()
    |> main_push("range", lsp_range(raw_source_view(src, n), span, end_span, encoding))
    |> main_push("severity", JsonNumber(lsp_severity(severity)))
    |> main_push("source", JsonString("weft"))
    |> main_push("message", JsonString(message))
  match code {
    DiagnosticCodeUnassigned -> members
    DiagnosticCodeAssigned(text) -> main_push(members, "code", JsonString(text))
  }
}

fn lsp_diagnostic_location_is_resolvable(
  tt: i64,
  root_src: i64,
  location: DiagnosticLocation
) -> bool {
  match location {
    DiagnosticLocationNone -> false
    DiagnosticSourceRange(source, start, end) -> match source {
      DiagnosticSourceUnknown -> false
      DiagnosticSourceBuffer(buffer) -> if buffer == root_src { true } else {
        let entry = main_diagnostic_source_entry(tt, source)
        entry != 0 and str_len(ttable_source_entry_path(entry)) > 0
      }
      DiagnosticSourceNamed(name) -> main_diagnostic_source_entry(tt, source) != 0
    }
  }
}

fn lsp_diagnostic_source_uri(
  server: LspServer,
  uri: str,
  tt: i64,
  root_src: i64,
  source: DiagnosticSource
) -> str {
  match source {
    DiagnosticSourceUnknown -> ""
    DiagnosticSourceNamed(name) -> lsp_definition_uri(name, lsp_server_workspace(server), uri)
    DiagnosticSourceBuffer(buffer) -> if buffer == root_src { uri } else {
      lsp_definition_uri(
        ttable_source_entry_path(main_diagnostic_source_entry(tt, source)),
        lsp_server_workspace(server),
        uri
      )
    }
  }
}

fn lsp_related_information_item(
  server: LspServer,
  uri: str,
  tt: i64,
  root_src: i64,
  root_n: i64,
  label: str,
  location: DiagnosticLocation
) -> Json {
  match location {
    DiagnosticLocationNone -> JsonNull
    DiagnosticSourceRange(source, start, end) -> {
      let entry = main_diagnostic_source_entry(tt, source)
      let source_ptr = match source {
        DiagnosticSourceUnknown -> 0
        DiagnosticSourceBuffer(buffer) -> buffer
        DiagnosticSourceNamed(name) -> ttable_source_entry_buffer(entry)
      }
      let source_n = if source_ptr == root_src { root_n } else { ttable_source_entry_len(entry) }
      let range = lsp_range(
        raw_source_view(source_ptr, source_n),
        diagnostic_location_clamp_offset(start, source_n),
        diagnostic_location_clamp_offset(end, source_n),
        lsp_server_encoding(server)
      )
      let target = main_members()
        |> main_push(
          "uri",
          JsonString(lsp_diagnostic_source_uri(server, uri, tt, root_src, source))
        )
        |> main_push("range", range)
        |> main_object
      main_members() |> main_push("location", target) |> main_push("message", JsonString(label)) |>
        main_object
    }
  }
}

-- The related locations a client can open, or `nil` when there are none.
fn lsp_related_information(
  server: LspServer,
  uri: str,
  tt: i64,
  root_src: i64,
  root_n: i64,
  related: DiagnosticRelatedLocationList
) -> List<Json> {
  let mut items = Nil<Json>()
  let mut current = related
  loop {
    match current {
      DiagnosticRelatedLocationNil -> return items.reverse()
      DiagnosticRelatedLocationCons(DiagnosticRelatedLocation(label, location), rest) -> {
        if lsp_diagnostic_location_is_resolvable(tt, root_src, location) {
          items = Cons(
            lsp_related_information_item(server, uri, tt, root_src, root_n, label, location),
            items
          )
        }
        current = rest
      }
    }
  }
  items.reverse()
}

fn lsp_diag_items_add_report(
  items: MainJsonItems,
  server: LspServer,
  uri: str,
  tt: i64,
  src: i64,
  n: i64,
  diagnostic: Diagnostic
) -> nil {
  if not lsp_diagnostic_belongs_to(server, tt, src, diagnose_report_absolute_span(diagnostic)) {
    return nil
  }
  let mut members = lsp_diag_item_members(
    src,
    n,
    diagnostic.severity(),
    diagnostic.message(),
    diagnose_report_absolute_span(diagnostic),
    diagnose_report_absolute_end(diagnostic),
    diagnostic.code(),
    lsp_server_encoding(server)
  )
  let related = match diagnostic {
    Diagnostic(severity, class, code, message, primary, related, fields) ->
      lsp_related_information(
        server,
        uri,
        tt,
        src,
        n,
        related
      )
  }
  if not related.is_empty() {
    members = main_push(members, "relatedInformation", JsonArray(related))
  }
  main_json_items_add(
    items,
    members |> main_push("data", main_diagnostic_json(src, n, tt, diagnostic)) |> main_object
  )
}

fn lsp_diag_items_add_legacy(
  items: MainJsonItems,
  server: LspServer,
  tt: i64,
  src: i64,
  n: i64,
  severity: DiagnosticSeverity,
  message: str,
  span: i64
) -> nil {
  if lsp_diagnostic_belongs_to(server, tt, src, span) {
    main_json_items_add(
      items,
      main_object(
        lsp_diag_item_members(
          src,
          n,
          severity,
          message,
          span,
          span,
          DiagnosticCodeUnassigned,
          lsp_server_encoding(server)
        )
      )
    )
  }
}

-- Collect every diagnostic `body` reports as an LSP item for `uri`.
fn lsp_collect_diagnostics_into<T>(
  items: MainJsonItems,
  server: LspServer,
  uri: str,
  tt: i64,
  src: i64,
  n: i64,
  body: () -[Diagnose]> T
) -> T {
  handle body() {
    Diagnose.report(diagnostic) -> {
      lsp_diag_items_add_report(items, server, uri, tt, src, n, diagnostic)
      resume(0)
    }
    Diagnose.error(msg, span) -> {
      lsp_diag_items_add_legacy(items, server, tt, src, n, DiagnosticSeverityError, msg, span)
      resume(0)
    }
    Diagnose.warn(msg, span) -> {
      lsp_diag_items_add_legacy(items, server, tt, src, n, DiagnosticSeverityWarning, msg, span)
      resume(0)
    }
    Diagnose.note(msg, span) -> {
      lsp_diag_items_add_legacy(items, server, tt, src, n, DiagnosticSeverityNote, msg, span)
      resume(0)
    }
  }
}

fn lsp_diag_items_add_project(
  items: MainJsonItems,
  server: LspServer,
  uri: str,
  diagnostics: ProjectDiagnostics
) -> nil {
  for i in 0..project_diagnostics_len(diagnostics) {
    let diagnostic = project_diagnostics_get(diagnostics, i)
    let src = project_diagnostics_item_source(diagnostics, i)
    let n = project_diagnostics_item_source_len(diagnostics, i)
    let tt = project_diagnostics_item_type_table(diagnostics, i)
    if project_diagnostics_item_is_legacy(diagnostics, i) {
      lsp_diag_items_add_legacy(
        items,
        server,
        tt,
        src,
        n,
        diagnostic.severity(),
        diagnostic.message(),
        diagnose_report_absolute_span(diagnostic)
      )
    } else { lsp_diag_items_add_report(items, server, uri, tt, src, n, diagnostic) }
  }
  nil
}

-- Parse and check outside the session when it holds no product to render.
fn lsp_collect_diagnostics_standalone(
  items: MainJsonItems,
  server: LspServer,
  document: LspDocument
) -[SourceAcquire]> nil {
  let source = source_from_text(document.text)
  let src = main_legacy_address(source.text)
  let n = str_len(source.text)
  let path = lsp_document_path(document.uri, "", true)
  let tt = ttable_new()
  main_mark_root_origin_with_grant(tt, src, 0, 1, 0)
  main_register_source_path_in_package(tt, src, n, main_legacy_address(path), str_len(path), 0)
  -- The table keeps views of these texts and paths for the whole scope.
  let owners = main_register_open_documents(
    tt,
    lsp_open_documents(server),
    document.uri,
    lsp_server_workspace(server)
  )
  let ast = lsp_collect_diagnostics_into(
    items,
    server,
    document.uri,
    tt,
    src,
    n,
    () => pipeline_parse_local(source, tt)
  )
  lsp_collect_diagnostics_into(
    items,
    server,
    document.uri,
    tt,
    src,
    n,
    () => weft_check.with_purpose(CheckProgram, ast)
  )
  nil
}

fn lsp_collect_diagnostics(
  items: MainJsonItems,
  server: LspServer,
  session: ProjectSession,
  document: LspDocument
) -[SourceAcquire]> nil {
  match project_session_check_with_acquire(
    session,
    lsp_project_context(server, document.uri, true)
  ) {
    ProjectCheckSucceeded(typed, source_n, parse_diagnostics, check_diagnostics) -> {
      lsp_diag_items_add_project(items, server, document.uri, parse_diagnostics)
      lsp_diag_items_add_project(items, server, document.uri, check_diagnostics)
    }
    ProjectCheckFailed(typed, source_n, parse_diagnostics, check_diagnostics) -> {
      lsp_diag_items_add_project(items, server, document.uri, parse_diagnostics)
      lsp_diag_items_add_project(items, server, document.uri, check_diagnostics)
    }
    ProjectCheckParseFailed(ProjectPreparedParseFailed(ast, source_n, diagnostics)) ->
      lsp_diag_items_add_project(items, server, document.uri, diagnostics)
    _ -> lsp_collect_diagnostics_standalone(items, server, document)
  }
}

-- Publish diagnostics for `uri`: those of its open document, or none once it
-- is closed.
fn lsp_publish(
  server: LspServer,
  session: ProjectSession,
  uri: str,
  document: Option<LspDocument>
) -[ConsoleWrite, SourceAcquire]> nil {
  let items = main_json_items()
  match document {
    Some(open) -> lsp_collect_diagnostics(items, server, session, open)
    None -> nil
  }
  let params = main_members()
    |> main_push("uri", JsonString(uri))
    |> main_push("diagnostics", main_json_items_array(items))
    |> main_object
  jsonrpc_write_frame(
    jsonrpc_notification("textDocument/publishDiagnostics", jsonrpc_render(params))
  )
}

-- A change can alter any open document's diagnostics, so each is published.
fn lsp_publish_open_documents(
  server: LspServer,
  session: ProjectSession
) -[ConsoleWrite, SourceAcquire]> nil {
  let mut remaining = lsp_open_documents(server)
  while not remaining.is_empty() {
    match remaining {
      Nil -> nil
      Cons(document, rest) -> {
        lsp_publish(server, session, document.uri, Some<LspDocument>(document))
        remaining = rest
      }
    }
  }
  nil
}

-- Documents -------------------------------------------------------------
fn lsp_open(
  server: LspServer,
  session: ProjectSession,
  uri: str,
  text: str,
  version: i64
) -[ConsoleWrite, SourceAcquire]> nil {
  lsp_store_document(session, server, uri, text, version)
  lsp_publish_open_documents(server, session)
}

-- Only a newer version replaces a document; a change without a version is
-- the next one.
fn lsp_change(
  server: LspServer,
  session: ProjectSession,
  uri: str,
  version: Option<i64>,
  text: str
) -[ConsoleWrite, SourceAcquire]> nil {
  match lsp_document(server, uri) {
    None -> nil
    Some(current) -> {
      let next = version.unwrap_or(current.version + 1)
      if next > current.version {
        lsp_store_document(session, server, uri, text, next)
        lsp_publish_open_documents(server, session)
      }
    }
  }
}

-- LSP requires clearing a closed document's diagnostics.
fn lsp_close(
  server: LspServer,
  session: ProjectSession,
  uri: str
) -[ConsoleWrite, SourceAcquire]> nil {
  if lsp_server_close(server, uri) {
    lsp_project_sync_overlays(session, server)
    lsp_publish(server, session, uri, None<LspDocument>())
    lsp_publish_open_documents(server, session)
  }
}

-- Requests --------------------------------------------------------------
fn lsp_semantic_fact_at(typed: TypedModule, offset: i64) -> SemanticFactEnvelope {
  match typed {
    TypedModule(fns, src, tt, owners, registrations) -> {
      let storage = registration_storage(tt, registrations)
      semantic_fact_query_cursor_position(tt, src, offset, storage)
    }
  }
}

fn lsp_hover_text(fact: SemanticFactEnvelope) -> str? {
  match fact {
    SemanticFactEnvelope(
      SemanticFactSchemaV1,
      SemanticFactFound(
        SemanticFactSymbol(SemanticSymbol(name, kind, ty, occurrence, definition))
      )
    ) -> return lsp_symbol_kind_label(kind)
      |> str_concat(" ")
      |> str_concat(name)
      |> str_concat(": ")
      |> str_concat(ty.render())
    SemanticFactEnvelope(
      SemanticFactSchemaV1,
      SemanticFactFound(
        SemanticFactEffectAtomUse(SemanticEffectAtomUse(atom, occurrence, definition))
      )
    ) -> return str_concat("effect ", atom.render())
    SemanticFactEnvelope(
      SemanticFactSchemaV1,
      SemanticFactFound(
        SemanticFactEffectOperationUse(
          SemanticEffectOperationUse(atom, name, ty, occurrence, definition)
        )
      )
    ) -> return "effect operation "
      |> str_concat(atom.render())
      |> str_concat(".")
      |> str_concat(name)
      |> str_concat(": ")
      |> str_concat(ty.render())
    SemanticFactEnvelope(
      SemanticFactSchemaV1,
      SemanticFactFound(
        SemanticFactAssociatedTypeUse(
          SemanticAssociatedTypeUse(base, name, resolved, occurrence, definition)
        )
      )
    ) -> return "associated type "
      |> str_concat(base.render())
      |> str_concat(".")
      |> str_concat(name)
      |> str_concat(" = ")
      |> str_concat(resolved.render())
    SemanticFactEnvelope(
      SemanticFactSchemaV1,
      SemanticFactFound(
        SemanticFactMatchArm(SemanticMatchArm(narrowed, residual, guarded, occurrence))
      )
    ) -> {
      let residual_label = if guarded { "; residual after guarded arm " } else {
        "; residual after arm "
      }
      let guard_note = if guarded { " (guards do not subtract)" } else { "" }
      return "match arm: narrowed "
        |> str_concat(narrowed.render())
        |> str_concat(residual_label)
        |> str_concat(residual.render())
        |> str_concat(guard_note)
    }
    _ -> nil
  }
  nil
}

fn lsp_hover(
  server: LspServer,
  session: ProjectSession,
  id: JsonRpcId?,
  uri: str,
  position: LspPosition
) -[ConsoleWrite, SourceAcquire]> nil {
  let document = match lsp_document(server, uri) {
    None -> return lsp_reply(id, "null")
    Some(open) -> open
  }
  let offset = lsp_offset(document.text, position, lsp_server_encoding(server))
  match lsp_hover_text(lsp_semantic_fact_at(lsp_check_quiet(server, session, document), offset)) {
    nil -> lsp_reply(id, "null")
    text: str -> {
      let contents = main_members()
        |> main_push("kind", JsonString("plaintext"))
        |> main_push("value", JsonString(text))
        |> main_object
      lsp_reply(id, jsonrpc_render(main_object(main_push(main_members(), "contents", contents))))
    }
  }
}

fn lsp_definition_location(fact: SemanticFactEnvelope) -> SemanticSourceLocationFact {
  match fact {
    SemanticFactEnvelope(
      SemanticFactSchemaV1,
      SemanticFactFound(
        SemanticFactSymbol(SemanticSymbol(name, kind, ty, occurrence, definition))
      )
    ) -> definition
    SemanticFactEnvelope(
      SemanticFactSchemaV1,
      SemanticFactFound(
        SemanticFactEffectAtomUse(SemanticEffectAtomUse(atom, occurrence, definition))
      )
    ) -> definition
    SemanticFactEnvelope(
      SemanticFactSchemaV1,
      SemanticFactFound(
        SemanticFactEffectOperationUse(
          SemanticEffectOperationUse(atom, name, ty, occurrence, definition)
        )
      )
    ) -> definition
    SemanticFactEnvelope(
      SemanticFactSchemaV1,
      SemanticFactFound(
        SemanticFactAssociatedTypeUse(
          SemanticAssociatedTypeUse(base, name, resolved, occurrence, definition)
        )
      )
    ) -> definition
    _ -> SemanticSourceLocationOther("none")
  }
}

fn lsp_definition(
  server: LspServer,
  session: ProjectSession,
  id: JsonRpcId?,
  uri: str,
  position: LspPosition
) -[ConsoleWrite, SourceAcquire]> nil {
  let document = match lsp_document(server, uri) {
    None -> return lsp_reply(id, "null")
    Some(open) -> open
  }
  let offset = lsp_offset(document.text, position, lsp_server_encoding(server))
  let typed = lsp_check_quiet(server, session, document)
  match lsp_definition_location(lsp_semantic_fact_at(typed, offset)) {
    SemanticSourceLocationOther(_) -> lsp_reply(id, "null")
    SemanticSourceLocation(path, start, length) -> match typed {
      TypedModule(fns, root_src, tt, owners, _) -> {
        let entry = if str_len(path) == 0 { ttable_find_source_buffer_entry(tt, root_src) } else {
          ttable_find_source_named(tt, path)
        }
        if entry == 0 { lsp_reply(id, "null") }
        else {
          let range = lsp_range(
            raw_source_view(ttable_source_entry_buffer(entry), ttable_source_entry_len(entry)),
            start,
            start + length,
            lsp_server_encoding(server)
          )
          let location = main_members()
            |> main_push(
              "uri",
              JsonString(lsp_definition_uri(path, lsp_server_workspace(server), document.uri))
            )
            |> main_push("range", range)
            |> main_object
          lsp_reply(id, jsonrpc_render(location))
        }
      }
    }
  }
}

fn lsp_keyword_completions() -> List<Json> {
  let handle_item = main_members()
    |> main_push("label", JsonString("handle"))
    |> main_push("kind", JsonNumber(14))
    |> main_object
  let perform_item = main_members()
    |> main_push("label", JsonString("perform"))
    |> main_push("kind", JsonNumber(14))
    |> main_object
  Cons(handle_item, Cons(perform_item, Nil<Json>()))
}

fn lsp_binding_completions(bindings: SemanticBindingFactList) -> List<Json> {
  let mut items = Nil<Json>()
  let mut current = bindings
  loop {
    match current {
      SemanticBindingFactListNil -> return items.reverse()
      SemanticBindingFactListCons(binding, rest) -> {
        match binding {
          SemanticBinding(name, kind, ty) -> {
            let item = main_members()
              |> main_push("label", JsonString(name))
              |> main_push("kind", JsonNumber(lsp_completion_kind(kind)))
              |> main_push("detail", JsonString(ty.render()))
              |> main_object
            items = Cons(item, items)
          }
          SemanticBindingOther(name) -> nil
        }
        current = rest
      }
      SemanticBindingFactListOther(name) -> return items.reverse()
    }
  }
  items.reverse()
}

fn lsp_completion_items(
  server: LspServer,
  session: ProjectSession,
  uri: str,
  position: LspPosition
) -[SourceAcquire]> List<Json> {
  let document = match lsp_document(server, uri) {
    None -> return lsp_keyword_completions()
    Some(open) -> open
  }
  let offset = lsp_offset(document.text, position, lsp_server_encoding(server))
  -- After a `.`, complete the fields or effect operations of what precedes it.
  let field_mode = offset > 0 and str_byte_at(document.text, offset - 1) == 46
  match lsp_check_quiet(server, session, document) {
    TypedModule(fns, typed_src, tt, owners, registrations) -> {
      let storage = registration_storage(tt, registrations)
      if field_mode {
        let bindings = match semantic_fact_effect_operations_at(tt, typed_src, offset, storage) {
          SemanticBindingFactListNil -> semantic_fact_fields_at(tt, typed_src, offset, storage)
          operations -> operations
        }
        lsp_binding_completions(bindings)
      } else {
        let visible = semantic_fact_visible_bindings(tt, typed_src, offset, storage)
        lsp_keyword_completions().concat(lsp_binding_completions(visible))
      }
    }
  }
}

fn lsp_completion(
  server: LspServer,
  session: ProjectSession,
  id: JsonRpcId?,
  uri: str,
  position: LspPosition
) -[ConsoleWrite, SourceAcquire]> nil {
  let result = main_members()
    |> main_push("isIncomplete", JsonBool(false))
    |> main_push("items", JsonArray(lsp_completion_items(server, session, uri, position)))
    |> main_object
  lsp_reply(id, jsonrpc_render(result))
}

fn lsp_formatting(
  server: LspServer,
  id: JsonRpcId?,
  uri: str,
  options: Option<Json>
) -[ConsoleWrite]> nil {
  let config = match options {
    None -> format_config.defaults()
    Some(JsonObject(members)) -> match main_format_config(JsonObject(members), "maxLineLength") {
      None -> return lsp_fail(
        id,
        JsonRpcInvalidParams,
        "maxLineLength must be a positive integer"
      )
      Some(valid) -> valid
    }
    Some(_) -> return lsp_fail(id, JsonRpcInvalidParams, "formatting options must be an object")
  }
  let document = match lsp_document(server, uri) {
    None -> return lsp_reply(id, "[]")
    Some(open) -> open
  }
  let items = main_json_items()
  match main_format_transport(document.text, items, MainLspWire(server, uri), config) {
    FormatterSuccess(formatted) -> {
      let edit = main_members()
        |> main_push("range", lsp_full_range(document.text, lsp_server_encoding(server)))
        |> main_push("newText", JsonString(formatted))
        |> main_object
      lsp_reply(id, jsonrpc_render(JsonArray(Cons(edit, Nil<Json>()))))
    }
    FormatterFailure(error_count) -> {
      let data = main_members()
        |> main_push("error_count", JsonNumber(error_count))
        |> main_push("diagnostics", main_json_items_array(items))
        |> main_object
      jsonrpc_write_frame(
        jsonrpc_error_with_data(
          id,
          JsonRpcRequestFailed,
          "formatting failed",
          jsonrpc_render(data)
        )
      )
    }
  }
}

fn lsp_dispatch(
  server: LspServer,
  session: ProjectSession,
  id: JsonRpcId?,
  method: str,
  params: Json
) -[ConsoleWrite, SourceAcquire]> nil {
  match lsp_request(method, params) {
    LspInitialize(root_uri, encoding) -> {
      match root_uri {
        uri: str -> if uri.starts_with("file://") {
          lsp_server_set_workspace(server, lsp_workspace_from_root_uri(uri))
        }
        nil -> nil
      }
      lsp_server_set_encoding(server, encoding)
      lsp_reply(id, lsp_initialize_result(encoding))
    }
    LspInitialized -> nil
    LspShutdown -> lsp_reply(id, "null")
    LspExit -> nil
    LspDidOpen(uri, text, version) -> lsp_open(server, session, uri, text, version)
    LspDidChange(uri, version, text) -> lsp_change(server, session, uri, version, text)
    LspDidClose(uri) -> lsp_close(server, session, uri)
    LspHover(uri, position) -> lsp_hover(server, session, id, uri, position)
    LspDefinition(uri, position) -> lsp_definition(server, session, id, uri, position)
    LspCompletion(uri, position) -> lsp_completion(server, session, id, uri, position)
    LspCodeAction -> lsp_reply(
      id,
      "[{\"title\":\"Consider par.map for pure map callbacks\",\"kind\":\"refactor.rewrite\"}]"
    )
    LspFormatting(uri, options) -> lsp_formatting(server, id, uri, options)
    LspMissingDocument -> nil
    LspUnknown -> match id {
      given: JsonRpcId -> lsp_fail(given, JsonRpcMethodNotFound, "unknown method")
      nil -> nil
    }
  }
}

fn lsp_handle(
  server: LspServer,
  session: ProjectSession,
  message: JsonRpcMessage
) -[ConsoleWrite, SourceAcquire]> nil {
  match message {
    JsonRpcUnparsable -> lsp_fail(nil, JsonRpcParseError, "invalid json-rpc")
    JsonRpcInvalid(field) -> lsp_fail(
      jsonrpc_reply_id(field),
      JsonRpcInvalidRequest,
      "invalid request"
    )
    JsonRpcCall(id, method, params) -> lsp_dispatch(server, session, id, method, params)
    JsonRpcNotice(method, params) -> lsp_dispatch(server, session, nil, method, params)
  }
}

fn lsp_is_exit(message: JsonRpcMessage) -> bool {
  match message {
    JsonRpcCall(_, method, _) -> method == "exit"
    JsonRpcNotice(method, _) -> method == "exit"
    _ -> false
  }
}

-- Content-Length framed messages until `exit` or end of input. A stream that
-- begins with a bare document is read to its end as concatenated documents.
fn lsp_serve(session: ProjectSession) -[ConsoleRead, ConsoleWrite, SourceAcquire]> nil {
  let server = lsp_server_new()
  let input = jsonrpc_input()
  loop {
    match jsonrpc_read_frame(input) {
      JsonRpcFrameEnd -> return nil
      JsonRpcFrameBroken -> return lsp_fail(nil, JsonRpcParseError, "invalid json-rpc")
      JsonRpcUnframed(text) -> {
        let messages = jsonrpc_decode_batch(text)
        for index in 0..vector_len<JsonRpcMessage>(messages) {
          lsp_handle(server, session, vector_get_in_bounds<JsonRpcMessage>(messages, index))
        }
        return nil
      }
      JsonRpcFramed(body) -> {
        let message = jsonrpc_decode(body)
        lsp_handle(server, session, message)
        if lsp_is_exit(message) { return nil }
      }
    }
  }
  nil
}

fn run_lsp() -[SourceAcquire]> i64 {
  let session = project_session_new(1)
  with console_input() {
    with console_terminal() { lsp_serve(session) }
  }
  0
}

-- The test driver still builds generated source and protocol lines in raw
-- buffers; these helpers go with that driver's typed rewrite.
-- ======================================================================
-- Tool: test — discover, compile and run test roots
-- ======================================================================
-- A test root compiles with a generated harness module (`tool/test/harness`)
-- whose `main` runs every wrapped test block under a `Test` handler. The
-- runner discovers roots, plans shared dependency products, and forks one
-- worker per root from the prepared compiler state; each worker compiles its
-- root, runs the executable under supervision, and leaves a measure for the
-- runner. Command policy and records live in `tool/test`.
--- A root's text and the path it came from; standard input has no path.
type MainTestRoot { text: str, path: str, trusted: bool, strict: bool, grants_trust: bool }

fn main_flag(value: bool) -> i64 { if value { 1 } else { 0 } }

fn main_test_root(path: str, text: str) -> MainTestRoot {
  let address = main_legacy_address(path)
  let length = str_len(path)
  MainTestRoot {
    text: text,
    path: path,
    trusted: cpath_is_trusted_source(address, length) == 1,
    strict: cpath_is_strict_source(address, length) == 1,
    grants_trust: cpath_can_grant_import_trust(address, length) == 1
  }
}

fn main_test_input_root(text: str) -> MainTestRoot {
  MainTestRoot { text: text, path: "", trusted: false, strict: true, grants_trust: false }
}

--- A root file's text; an empty file is as unusable as a missing one.
fn main_test_read_root(path: str) -[SourceAcquire]> Option<MainTestRoot> {
  match SourceAcquire.load(path, path, 0) {
    nil -> None<MainTestRoot>()
    bytes: Bytes -> {
      let text = bytes_storage(bytes)
      if str_len(text) == 0 { None<MainTestRoot>() } else {
        Some<MainTestRoot>(main_test_root(path, text))
      }
    }
  }
}

fn main_test_register_root(tt: i64, src: i64, n: i64, root: MainTestRoot) -[SourceAcquire]> i64 {
  if str_len(root.path) == 0 { main_register_source_path(tt, src, n, 0, 0) }
  else {
    main_register_source_path(tt, src, n, main_legacy_address(root.path), str_len(root.path))
  }
}

--- One root's compilation: an executable and what it must report, or the
--- outcome compilation already reached.
type MainTestBuild {
  MainTestBuilt(BinaryObject, MainTestExpectation),
  MainTestBuildFinished(TestOutcome)
}

type MainTestExpectation {
  --- Report through the structured result record.
  MainTestStructured,
  --- An executable-style program must exit with this status.
  MainTestExits(i64)
}

fn main_test_failed(message: str) -> MainTestBuild {
  eprint(message)
  MainTestBuildFinished(TestFailed(1))
}

fn main_test_native_debug_mode() -> PipelineNativeDebugMode {
  match native_link_target_host() {
    NativeLinkMacosAarch64 -> PipelineNativeDebugInformationIncluded
    -- Linux test execution is valid before ELF DWARF parity lands. Keep the
    -- runnable product quiet and stripped until minimal native emission supplies that emitter.
    NativeLinkLinuxAarch64 -> PipelineNativeDebugInformationStripped
  }
}

-- `WEFT_TEST_RC_QUARANTINE=1` builds every root with the `--rc-quarantine`
-- heap, so a stale retain or release names the release that freed it.
fn main_test_emit(
  typed: TypedModule,
  settings: TestSettings,
  product: PipelineOptimisedDependencyProduct
) -> BinaryObject {
  let reclamation = if settings.quarantine { PipelineNativeQuarantineFreed } else {
    PipelineNativeReuseFreed
  }
  if pipeline_optimised_dependency_product_is_available(product) == 1 {
    pipeline_emit_native_with_debug_mode_and_dependency_product(
      typed,
      main_test_native_debug_mode(),
      reclamation,
      product
    )
  } else {
    pipeline_emit_native_with_debug_mode(typed, main_test_native_debug_mode(), reclamation)
  }
}

--- A worker prepares and compiles one root against its private fork snapshot.
--- The runner's snapshot contains only immutable shared support modules.
type MainTestPreparation {
  -- Callable storage, source, table, wrapper bank, trust, owners, root syntax.
  MainTestPrepared(
    i64,
    i64,
    i64,
    i64,
    bool,
    SourceOwners,
    (List<SourceDeclaration>, RegistrationScope)
  ),
  MainTestPreparationFinished(TestOutcome),
}

fn main_test_add_wrappers(
  regular: i64,
  tests: List<TestSyntax>,
  src: i64,
  test_effects: EffectSig,
  name_bank_start: i64,
  tt: i64
) -> i64 {
  let mut index = 0
  for case_syntax in tests {
    test_prepare.add_wrapper(regular, case_syntax, src, test_effects, index, name_bank_start, tt)
    index = index + 1
  }
  regular
}

fn main_test_bind_harness_wrappers(
  tt: i64,
  harness_src: i64,
  root_src: i64,
  root_registrations: RegistrationScope,
  harness_registrations: RegistrationScope
) -> RegistrationScope {
  let root_module = module_fact_find_source(tt, root_src)
  let harness_module = module_fact_find_source(tt, harness_src)
  if root_module == 0 or harness_module == 0 {
    panic("test harness import has no legacy module registration")
  }
  else {
    let selections = nlist_new()
    nlist_add(selections, node_new(0, 0, 0 - 1, 0, 0))
    module_import_fact_register(
      tt,
      harness_src,
      root_module,
      selections,
      0,
      0,
      module_visibility_private(),
      0
    )
  }
  let combined = registration_scope_combined(root_registrations, harness_registrations)
  let root_registration = match registration_scope_find_source(combined, root_src) {
    Some(found) -> found
    None -> panic("test root has no retained module registration")
  }
  let harness_registration = match registration_scope_find_source(combined, harness_src) {
    Some(found) -> found
    None -> panic("test harness has no retained module registration")
  }
  let builder = registration_builder_from_scope(combined)
  registration_builder_add_import(
    builder,
    resolved_implicit_wildcard_import(
      harness_registration.identity,
      root_registration.identity
    )
  )
  registration_builder_freeze(builder)
}

fn main_test_declares_main(declarations: List<SourceDeclaration>, src: i64) -> bool {
  let mut found = false
  for declaration in declarations {
    match declaration.syntax {
      FunctionDefinition(function) -> {
        if src_eq(src, function.name.start, function.name.length, "main") == 1 { found = true }
      }
      _ -> nil
    }
  }
  found
}

fn main_test_prepare(
  root: MainTestRoot,
  tt: i64,
  inherited_registrations: borrow RegistrationScope
) -[SourceAcquire]> MainTestPreparation {
  -- Parse the user's source before adding the Test import prefix so parse
  -- diagnostics retain the user's original line/column coordinates.
  let source = source_from_text(root.text)
  let raw = main_legacy_address(source.text)
  let probe_tt = ttable_new()
  pipeline_mark_root_origin(probe_tt, raw, main_flag(root.trusted), main_flag(root.strict))
  main_test_register_root(probe_tt, raw, str_len(source.text), root)
  let probe_parsed = pipeline_parse_local_with_error_count(source, probe_tt)
  let probe_errors = match probe_parsed { PipelineParseResult(_, errors) -> errors }
  if probe_errors != 0 {
    eprint(i"test: parse failed with {probe_errors} errors\n")
    return MainTestPreparationFinished(TestFailed(1))
  }
  let probe_declarations = match probe_parsed {
    PipelineParseResult(AstModule(_, _, _, _, (declarations, _)), _) -> declarations
  }
  -- Prepare the final source before loading the module graph. The root-local
  -- parse above already discovered the exact test count, so the prepared
  -- source can take the one complete recursive parse used by checking and
  -- emission instead of first parsing an otherwise disposable prefixed copy.
  let banked = test_prepare_source(source.text, test_prepare.count(probe_declarations))
  let prepared = source_from_text(test_prepare_source_content(banked))
  let src = main_legacy_address(prepared.text)
  let name_bank_start = test_prepare_source_wrapper_bank_start(banked)
  pipeline_mark_root_origin(tt, src, main_flag(root.trusted), main_flag(root.strict))
  main_test_register_root(tt, src, str_len(prepared.text), root)
  let parsed = pipeline_parse_with_error_count(prepared, tt)
  let parse_errors = match parsed { PipelineParseResult(_, errors) -> errors }
  if parse_errors != 0 {
    eprint(i"test: parse failed with {parse_errors} errors\n")
    return MainTestPreparationFinished(TestFailed(1))
  }
  let (fns, declarations, registrations, owners) = match parsed {
    PipelineParseResult(
      AstModule(parsed_fns, _, _, parsed_owners, (parsed_declarations, parsed_registrations)),
      _
    ) -> (parsed_fns, parsed_declarations, parsed_registrations, parsed_owners)
  }
  if test_prepare.count(declarations) == 0 {
    -- A program root is only verified by running it against a declared exit
    -- code. Reporting success for an unrun `main` would hide checker and
    -- runtime failures behind a vacuous pass.
    if main_test_declares_main(declarations, src) {
      eprint("test: program root declares main without test blocks; ")
      eprint("declare `-- Expected exit code: N` to verify it as an expected-exit program\n")
      MainTestPreparationFinished(TestFailed(1))
    } else {
      eprint("test: no test blocks found\n")
      MainTestPreparationFinished(TestPassed)
    }
  } else {
    MainTestPrepared(
      fns,
      src,
      tt,
      name_bank_start,
      root.trusted,
      owners,
      (declarations, registration_scope_combined_borrowed(inherited_registrations, registrations))
    )
  }
}

fn main_test_build_tests(
  preparation: MainTestPreparation,
  settings: TestSettings,
  product: PipelineOptimisedDependencyProduct,
  host: MainGrammarHost
) -[SourceAcquire]> MainTestBuild {
  match preparation {
    MainTestPreparationFinished(outcome) -> MainTestBuildFinished(outcome)
    MainTestPrepared(fns, src, tt, name_bank_start, trusted, parsed_owners, syntax_product) -> {
      let declarations = syntax_product.0
      let registrations = syntax_product.1
      let regular = nlist_new()
      for i in 0..nlist_len(fns) { nlist_add(regular, nlist_get(fns, i)) }
      let tests = test_prepare.tests(declarations)
      let ntests = test_prepare.count(declarations)
      -- Each test block becomes a wrapper function with a reserved name, so
      -- test titles never collide with keywords or authored functions.
      main_test_add_wrappers(
        regular,
        tests,
        src,
        test_prepare.wrapper_effects(trusted),
        name_bank_start,
        tt
      )
      let harness = source_from_text(harness_source(tests, trusted))
      let harness_src = main_legacy_address(harness.text)
      -- The harness is compiler-generated trusted code. In an installed
      -- compiler it belongs to the SDK package, so package-private runtime
      -- support remains available without assigning the user source to that
      -- package. Checkout compilers preserve package zero byte semantics.
      let sdk_package = ttable_sdk_package_id(tt)
      let harness_package = if sdk_package > 0 { sdk_package } else { 0 }
      ttable_register_source_in_package(
        tt,
        harness_src,
        str_len(harness.text),
        0,
        0,
        harness_package
      )
      ttable_mark_trusted_source(tt, harness_src)
      let harness_loaded = pipeline_parse(harness, tt)
      let harness_fns = harness_loaded.functions
      let wrapper_registrations = test_prepare.wrapper_registrations(
        registrations,
        src,
        ntests,
        name_bank_start
      )
      let test_registrations = main_test_bind_harness_wrappers(
        tt,
        harness_src,
        src,
        registration_scope_combined(registrations, wrapper_registrations),
        harness_loaded.registrations
      )
      for hi in 0..nlist_len(harness_fns) { nlist_add(regular, nlist_get(harness_fns, hi)) }
      -- Preserve the user's source as the diagnostic/measurement root while
      -- selecting the compiler-generated main as this executable's entry.
      ttable_set_program_entry_source(tt, harness_src)
      -- Type-check is a hard boundary before typed-IR/native emission. Continuing
      -- after diagnostics leaves poisoned AST/typed state for lowering, which can
      -- turn an ordinary positive-test failure into a codegen crash.
      let purpose = if nlist_len(ttable_checked_module_pairs(tt)) > 0 { ExtendCheckedProgram } else {
        CheckProgram
      }
      let syntax = AstModule(
        regular,
        src,
        tt,
        source_owners.combined(parsed_owners, harness_loaded.owners),
        (declarations, test_registrations)
      )
      let checked = pipeline_report_check(syntax, purpose)
      match checked.result {
        CheckRejected -> main_test_failed(
          i"test: type check failed with {checked.errors} errors\n"
        )
        Checked(typed) -> if not main_test_stage_checked(typed, host) {
          MainTestBuildFinished(TestFailed(1))
        } else { MainTestBuilt(main_test_emit(typed, settings, product), MainTestStructured) }
      }
    }
  }
}

-- Executable-style roots keep their authored `main` as the entry point.
fn main_test_build_program(
  root: MainTestRoot,
  tt: i64,
  inherited_registrations: borrow RegistrationScope,
  expected: i64,
  settings: TestSettings,
  host: MainGrammarHost
) -[SourceAcquire]> MainTestBuild {
  let source = source_from_text(root.text)
  let src = main_legacy_address(source.text)
  main_mark_root_origin_with_grant(
    tt,
    src,
    main_flag(root.trusted),
    main_flag(root.strict),
    main_flag(root.grants_trust)
  )
  main_test_register_root(tt, src, str_len(source.text), root)
  match pipeline_parse_with_error_count(source, tt) {
    PipelineParseResult(AstModule(fns, _, _, parse_owners, (declarations, registrations)), errors) ->
      if errors != 0 {
        main_test_failed(i"test: legacy main parse failed with {errors} errors\n")
      }
    else {
      let syntax = AstModule(
        fns,
        src,
        tt,
        parse_owners,
        (
          declarations,
          registration_scope_combined_borrowed(inherited_registrations, registrations)
        )
      )
      let checked = main_check_native_report(syntax, NativeRuntime)
      match checked.result {
        CheckRejected -> main_test_failed(
          i"test: legacy main type check failed with {checked.errors} errors\n"
        )
        Checked(typed) -> if main_fns_have_root_main(fns, src) != 1 {
          main_test_failed("test: legacy expected-exit source is missing main\n")
        } else if not main_test_stage_checked(typed, host) {
          MainTestBuildFinished(TestFailed(1))
        } else {
          MainTestBuilt(
            main_test_emit(typed, settings, PipelineOptimisedDependencyProductUnavailable),
            MainTestExits(expected)
          )
        }
      }
    }
  }
}

fn main_test_build(
  root: MainTestRoot,
  tt: i64,
  registrations: borrow RegistrationScope,
  product: PipelineOptimisedDependencyProduct,
  settings: TestSettings,
  host: MainGrammarHost
) -[SourceAcquire]> MainTestBuild {
  match test_expected_exit(root.text) {
    TestDirectiveMalformed -> main_test_failed(
      "test: malformed legacy expected-exit directive (use 0..123)\n"
    )
    expected -> match test_run_budget(root.text) {
      TestDirectiveMalformed -> main_test_failed(
        "test: malformed run budget directive (use `-- Run budget: N s`, 1..3600)\n"
      )
      _ -> match expected {
        TestDirectiveValue(status) -> main_test_build_program(
          root,
          tt,
          registrations,
          status,
          settings,
          host
        )
        _ -> main_test_build_tests(
          main_test_prepare(root, tt, registrations),
          settings,
          product,
          host
        )
      }
    }
  }
}

-- Emission-only commands ------------------------------------------------------
fn main_test_emit_root(root: MainTestRoot, host: MainGrammarHost) -[SourceAcquire]> i64 {
  let registrations = registration_scope()
  let build = main_test_build_tests(
    main_test_prepare(root, ttable_new(), registrations),
    test_settings_unset(),
    PipelineOptimisedDependencyProductUnavailable,
    host
  )
  match build {
    MainTestBuildFinished(outcome) -> test_outcome_status(outcome)
    MainTestBuilt(binary, expectation) -> main_write_binary(binary)
  }
}

fn run_test(host: MainGrammarHost) -[SourceAcquire]> i64 {
  let raw_input = read_stdin_all()
  let text = runtime_str_from_bytes_copy(mem_load64_at(raw_input, 0), mem_load64_at(raw_input, 8))
  main_test_emit_root(main_test_input_root(text), host)
}

fn run_test_path(path: str, host: MainGrammarHost) -[SourceAcquire]> i64 {
  match main_test_read_root(path) {
    None -> {
      eprint("test: could not read input file\n")
      1
    }
    Some(root) -> main_test_emit_root(root, host)
  }
}

-- Workers -------------------------------------------------------------------
fn main_test_measure(
  outcome: TestOutcome,
  compile_millis: i64,
  link_millis: i64,
  run_millis: i64,
  usage: SupervisedUsage
) -> TestMeasure {
  TestMeasure {
    outcome: outcome,
    compile_millis: compile_millis,
    link_millis: link_millis,
    run_millis: run_millis,
    user_micros: usage.user_micros,
    system_micros: usage.system_micros,
    peak_rss_bytes: usage.peak_rss_bytes
  }
}

fn main_test_no_usage() -> SupervisedUsage {
  SupervisedUsage { user_micros: 0, system_micros: 0, peak_rss_bytes: 0 }
}

-- A structured executable exits 0 when every test passed and 1 otherwise,
-- and its result record must agree before the runner repeats it.
fn main_test_consume_result(
  result_file: Path,
  status: i64
) -[FileRead, ConsoleWrite]> TestOutcome {
  match test_read_scratch(result_file) {
    None -> TestResultInvalid
    Some(record) -> match test_counts_parse(record) {
      None -> TestResultInvalid
      Some(counts) -> {
        let expected = if counts.failed == 0 { 0 } else { 1 }
        if status != expected { TestResultInvalid } else {
          test_note(test_counts_render(counts))
          test_outcome_from_status(status)
        }
      }
    }
  }
}

fn main_test_judge(
  termination: SupervisedTermination,
  expectation: MainTestExpectation,
  result_file: Path
) -[FileRead, ConsoleWrite]> TestOutcome {
  match termination {
    SupervisedStopped -> TestTimedOut
    SupervisedFailed(error) -> TestUnsupervised
    SupervisedEnded(ended) -> {
      let status = test_exit_status(ended)
      match expectation {
        MainTestExits(expected) -> if status == expected { TestPassed } else {
          test_note(i"test: legacy main exited {status}, expected {expected}\n")
          TestExitMismatch
        }
        MainTestStructured -> if status == 0 or status == 1 {
          main_test_consume_result(result_file, status)
        } else { TestFailed(status) }
      }
    }
  }
}

-- Materialise and run one executable, measuring from the end of compilation.
fn main_test_execute(
  binary: BinaryObject,
  expectation: MainTestExpectation,
  run_limit: Duration,
  index: i64,
  compiled: Instant,
  compile_millis: i64
) -[FileRead, DirMutate, ConsoleWrite, MonotonicClock, Supervise]> TestMeasure {
  if pipeline_binary_kind(binary) != main_host_executable_kind() {
    test_note("test: native runner cannot execute this binary format\n")
    return main_test_measure(TestForeignExecutable, compile_millis, 0, 0, main_test_no_usage())
  }
  let contents = pipeline_binary_bytes(binary)
  if contents.is_empty() {
    -- Emission refused to produce an executable; the errors were already
    -- reported. Executing an empty file would only add a misleading 127.
    test_note("test: emission produced no executable\n")
    return main_test_measure(TestNoExecutable, compile_millis, 0, 0, main_test_no_usage())
  }
  let process = Supervise.process_id()
  let executable = test_scratch_path(TestExecutableFile, process, index)
  let result_file = test_scratch_path(TestResultFile, process, index)
  let result_text = test_scratch_text(TestResultFile, process, index)
  -- A live process cannot share this pid, so this only clears a stale file a
  -- crashed earlier process left after pid reuse.
  test_remove_scratch(result_file)
  let written = Supervise.write_executable(executable, contents)
  let linked = monotonic.now()
  let link_millis = linked.duration_since(compiled).milliseconds()
  let measure = match written {
    Err(error) -> main_test_measure(
      TestUnwritable,
      compile_millis,
      link_millis,
      0,
      main_test_no_usage()
    )
    Ok(_) -> {
      let args = match expectation {
        MainTestStructured -> Cons(result_text, Nil<str>())
        MainTestExits(expected) -> Nil<str>()
      }
      let exit = Supervise.run(executable, args, run_limit)
      let run_millis = monotonic.now().duration_since(linked).milliseconds()
      main_test_measure(
        main_test_judge(exit.termination, expectation, result_file),
        compile_millis,
        link_millis,
        run_millis,
        exit.usage
      )
    }
  }
  test_remove_scratch(executable)
  test_remove_scratch(result_file)
  measure
}

--- A root's compilation in its worker, with the stop its run phase gets.
type MainTestCompiled { build: MainTestBuild, run_limit: Duration }

-- Compile root `index` against its planned base. Compilation runs beneath
-- none of the runner's handlers, only the compiler's own SourceAcquire.
fn main_test_compile(
  roots: Vector<str>,
  index: i64,
  plan: MainTestPlan,
  settings: TestSettings,
  host: MainGrammarHost
) -[SourceAcquire]> MainTestCompiled {
  match main_test_read_root(vector_get_in_bounds<str>(roots, index)) {
    None -> {
      eprint("test: could not read input file\n")
      MainTestCompiled {
        build: MainTestBuildFinished(TestFailed(1)),
        run_limit: settings.run_limit
      }
    }
    Some(root) -> {
      let bases = plan.bases
      let build = match vector_get_in_bounds<MainTestRootBase>(bases, index) {
        MainTestUniversal -> {
          let registrations = plan.universal.registrations
          main_test_build(
            root,
            plan.universal.table,
            registrations,
            PipelineOptimisedDependencyProductUnavailable,
            settings,
            host
          )
        }
        MainTestShared(base, leader, product) -> {
          let registrations = main_test_checked_base_registrations(plan.session, leader)
          main_test_build(root, base, registrations, product, settings, host)
        }
      }
      MainTestCompiled { build: build, run_limit: test_run_limit(settings, root.text) }
    }
  }
}

fn main_test_now() -> Instant { platform_time.with_platform(() => monotonic.now()) }

-- A forked worker: compile its root, then run the executable, leave the
-- measure and exit inside a scope that holds nothing else.
fn main_test_worker(
  argc: i64,
  argv: i64,
  worker: TestWorker,
  roots: Vector<str>,
  plan: MainTestPlan,
  settings: TestSettings,
  host: MainGrammarHost
) -[SourceAcquire]> i64 {
  let start = main_test_now()
  let compiled = main_test_compile(roots, worker.root, plan, settings, host)
  let finished = main_test_now()
  let compile_millis = finished.duration_since(start).milliseconds()
  with dir_mutate() {
    with file_read() {
      with file_write() {
        with console_terminal() {
          platform_time.with_platform(
            () =>
              runtime_supervise(
                argc,
                argv,
                () => {
                  let measure = match compiled.build {
                    MainTestBuildFinished(outcome) -> main_test_measure(
                      outcome,
                      compile_millis,
                      0,
                      0,
                      main_test_no_usage()
                    )
                    MainTestBuilt(binary, expectation) -> main_test_execute(
                      binary,
                      expectation,
                      compiled.run_limit,
                      worker.root,
                      finished,
                      compile_millis
                    )
                  }
                  test_worker_finish(worker, measure)
                }
              )
          )
        }
      }
    }
  }
}

-- Planning ------------------------------------------------------------------
-- Count a planning query's errors without rendering them; the worker that
-- compiles the root reports its diagnostics canonically.
fn main_test_count_errors<T, E>(body: () -[Diagnose, E]> T) -[E]> (T, i64) {
  handle observe_errors(body) {
    Diagnose.report(diagnostic) -> resume(0)
    Diagnose.error(message, position) -> resume(0)
    Diagnose.warn(message, position) -> resume(0)
    Diagnose.note(message, position) -> resume(0)
  }
}

fn main_test_prewarm_file(
  tt: i64,
  fns: i64,
  path: str,
  loader: CompilerSourceLoader,
  registrations: RegistrationBuilder
) -[SourceAcquire]> i64 {
  let (_, errors) = main_test_count_errors(
    () => {
      pkg_install_sdk_for_table(tt, SourceAcquire.sdk_origin())
      parse_use_file_with_registration_scope(fns, tt, path, loader, registrations)
    }
  )
  errors
}

fn main_test_check_project_base(
  fns: i64,
  src: i64,
  tt: i64,
  loader: CompilerSourceLoader,
  registrations: RegistrationScope
) -[SourceAcquire]> (i64, RegistrationScope) {
  let (checked, errors) = main_test_count_errors(
    () =>
      pipeline_check_with_loader(
        AstModule(
          fns,
          src,
          tt,
          source_loader_owners(loader),
          (Nil<SourceDeclaration>(), registrations)
        ),
        CheckProgram,
        loader
      )
  )
  match checked {
    Checked(TypedModule(_, _, _, _, complete_registrations)) -> (errors, complete_registrations)
    CheckRejected -> (if errors == 0 { 1 } else { errors }, registrations)
  }
}

--- The shared support every root imports, parsed and checked once before
--- forking: the table, the owners of its sources, and its registrations.
type MainTestUniversalBase { table: i64, owners: SourceOwners, registrations: RegistrationScope }

fn main_test_universal_base() -[SourceAcquire]> MainTestUniversalBase {
  let tt = ttable_new()
  let loader = parse_source_loader_for_table(tt)
  let fns = nlist_new()
  let builder = registration_builder()
  -- Every generated test root imports Test, and every harness imports these
  -- five support modules. Parse them once before forking; module entries cache
  -- their function closures, while each child retains a root-local checker
  -- table snapshot and all subsequent mutations remain process-private.
  let mut errors = 0
  for support in main_test_support_modules() {
    errors = errors + main_test_prewarm_file(tt, fns, support, loader, builder)
  }
  let registrations = registration_builder_freeze(builder)
  let mut complete_registrations = registrations
  let sdk_package = ttable_sdk_package_id(tt)
  let test_package = if sdk_package > 0 { sdk_package } else { 0 }
  let test_path = "stdlib/test.weft"
  let test_module = module_fact_find_path(
    tt,
    main_legacy_address(test_path),
    str_len(test_path),
    test_package
  )
  if errors == 0 and test_module != 0 {
    let checked = main_test_check_project_base(
      fns,
      module_fact_entry_source(test_module),
      tt,
      loader,
      registrations
    )
    errors = errors + checked.0
    complete_registrations = checked.1
  } else if test_module == 0 { errors = errors + 1 }
  -- Missing/corrupt support must retain the canonical per-root diagnostic.
  -- Discard the partial cache and let each child take the normal load path.
  if errors == 0 {
    ttable_mark_checked_module_products(tt, fns)
    MainTestUniversalBase {
      table: tt,
      owners: source_loader_owners(loader),
      registrations: complete_registrations
    }
  } else {
    MainTestUniversalBase {
      table: ttable_new(),
      owners: source_owners.new(),
      registrations: registration_scope()
    }
  }
}

fn main_test_support_modules() -> List<str> {
  Cons(
    "stdlib/test.weft",
    Cons(
      "runtime/syscall.weft",
      Cons(
        "runtime/alloc.weft",
        Cons(
          "runtime/rc.weft",
          Cons("stdlib/string.weft", Cons("stdlib/test/report.weft", Nil<str>()))
        )
      )
    )
  )
}

--- What planning learned about one root: the exact imported-module closure
--- it could share, or nothing reusable.
type MainTestRootPlan {
  -- Path, text, exact dependency entries, checked pair count, source owners.
  MainTestReusableRoot(str, str, i64, i64, SourceOwners),
  MainTestUnplannedRoot
}

fn main_test_dependency_selection_is_named(selected: i64) -> bool {
  for i in 0..nlist_len(selected) {
    if module_fact_entry_anonymous(nlist_get(selected, i)) != 0 { return false }
  }
  true
}

fn main_test_dependency_pair_count(selected: i64) -> i64 {
  let mut count = 0
  for i in 0..nlist_len(selected) {
    count = count + nlist_len(module_fact_entry_function_pairs(nlist_get(selected, i)))
  }
  count
}

fn main_test_plan_root(
  tt: i64,
  path: str,
  loader: CompilerSourceLoader
) -[SourceAcquire]> MainTestRootPlan {
  match main_test_read_root(path) {
    None -> MainTestUnplannedRoot
    Some(root) -> {
      let source = source_from_text(root.text)
      let raw = main_legacy_address(source.text)
      main_mark_root_origin_with_grant(
        tt,
        raw,
        main_flag(root.trusted),
        main_flag(root.strict),
        main_flag(root.grants_trust)
      )
      main_test_register_root(tt, raw, str_len(source.text), root)
      -- Discovery needs the exact imported-module closure it may later share.
      -- Grammar.parse is intentionally root-local; use the source-acquiring
      -- module parser for this whole-graph planning query.
      let (_, errors) = main_test_count_errors(
        () => parse_registered_source_with_loader(source, tt, loader)
      )
      let root_module = module_fact_find_source(tt, raw)
      if errors != 0 or root_module == 0 { MainTestUnplannedRoot }
      else {
        let selected = module_product_collect_dependencies(tt, root_module)
        if nlist_len(selected) == 0 or not main_test_dependency_selection_is_named(selected) {
          MainTestUnplannedRoot
        } else {
          MainTestReusableRoot(
            path,
            root.text,
            selected,
            main_test_dependency_pair_count(selected),
            source_loader_owners(loader)
          )
        }
      }
    }
  }
}

fn main_test_plan_roots(roots: Vector<str>) -[SourceAcquire]> Vector<MainTestRootPlan> {
  let tt = ttable_new()
  let loader = parse_source_loader_for_table(tt)
  let plans: Vector<MainTestRootPlan> = vector.new<MainTestRootPlan>()
  for index in 0..vector_len<str>(roots) {
    vector_push<MainTestRootPlan>(
      plans,
      main_test_plan_root(tt, vector_get_in_bounds<str>(roots, index), loader)
    )
  }
  plans
}

fn main_test_dependency_selection_contains(selected: i64, wanted: i64) -> bool {
  for i in 0..nlist_len(selected) {
    if module_entry_identity_compare(nlist_get(selected, i), wanted) == 0 { return true }
  }
  false
}

fn main_test_dependency_selections_equal(left: i64, right: i64) -> bool {
  if nlist_len(left) != nlist_len(right) { return false }
  for i in 0..nlist_len(left) {
    if not main_test_dependency_selection_contains(right, nlist_get(left, i)) { return false }
  }
  true
}

-- Two roots share a base only when both are reusable with the same closure.
fn main_test_root_plans_equal(left: MainTestRootPlan, right: MainTestRootPlan) -> bool {
  match left {
    MainTestUnplannedRoot -> false
    MainTestReusableRoot(_, _, left_selected, _, _) -> match right {
      MainTestUnplannedRoot -> false
      MainTestReusableRoot(_, _, right_selected, _, _) ->
        main_test_dependency_selections_equal(left_selected, right_selected)
    }
  }
}

fn main_test_root_plan_pair_count(plan: MainTestRootPlan) -> i64 {
  match plan {
    MainTestReusableRoot(_, _, _, pair_count, _) -> pair_count
    MainTestUnplannedRoot -> 0
  }
}

fn main_test_query_context(path: str) -> ProjectQueryContext {
  let address = main_legacy_address(path)
  let length = str_len(path)
  project_query_context_with_trust(
    0,
    path,
    path,
    project_source_origin_disk(),
    0,
    1,
    cpath_is_trusted_source(address, length),
    cpath_is_strict_source(address, length),
    cpath_can_grant_import_trust(address, length)
  )
}

type MainTestCheckedBase {
  MainTestCheckedBaseReady(i64, PipelineOptimisedDependencyProduct),
  MainTestCheckedBaseInvalid,
}

fn main_test_checked_base(
  session: ProjectSession,
  plan: MainTestRootPlan,
  optimise: bool
) -[SourceAcquire]> MainTestCheckedBase {
  match plan {
    MainTestUnplannedRoot -> MainTestCheckedBaseInvalid
    MainTestReusableRoot(path, text, _, _, _) -> {
      let context = main_test_query_context(path)
      project_session_set_source(session, context, text)
      match project_session_checked_dependency_product_with_acquire(session, context) {
        ModuleCheckedInstance(fns, tt, owners, registrations) -> MainTestCheckedBaseReady(
          tt,
          if optimise {
            pipeline_optimised_dependency_product_build(
              TypedModule(fns, 0, tt, owners, registrations)
            )
          } else { PipelineOptimisedDependencyProductUnavailable }
        )
        InvalidModuleCheckedInstance -> MainTestCheckedBaseInvalid
      }
    }
  }
}

fn main_test_checked_base_registrations(
  session: ProjectSession,
  leader: str
) -[SourceAcquire]> RegistrationScope {
  match project_session_checked_dependency_registrations_with_acquire(
    session,
    main_test_query_context(leader)
  ) {
    Some(registrations) -> registrations
    None -> registration_scope()
  }
}

--- Where a root's worker starts: the universal support base, or the checked
--- dependency product it shares with its group's leader.
type MainTestRootBase {
  MainTestUniversal,
  -- Checked table, group leader path, optimised product.
  MainTestShared(i64, str, PipelineOptimisedDependencyProduct)
}

--- Planning's result: the universal base, each root's base, and the session
--- that owns every source and syntax graph the shared tables reference.
type MainTestPlan {
  universal: MainTestUniversalBase,
  bases: Vector<MainTestRootBase>,
  session: ProjectSession,
  totals: TestPlanTotals
}

-- Plan the group led by `leader`: share one checked base among every
-- unclaimed root with the same closure when the group is large enough and
-- the shared checking repays retaining it.
fn main_test_plan_group(
  plans: Vector<MainTestRootPlan>,
  leader_index: i64,
  claimed: Vector<bool>,
  bases: Vector<MainTestRootBase>,
  session: ProjectSession,
  thresholds: TestGroupThresholds,
  settings: TestSettings,
  totals: TestPlanTotals
) -[SourceAcquire, ConsoleWrite]> TestPlanTotals {
  let leader = vector_get_in_bounds<MainTestRootPlan>(plans, leader_index)
  let mut group_roots = 0
  for index in 0..vector_len<MainTestRootPlan>(plans) {
    if not vector_get_in_bounds<bool>(claimed, index) and main_test_root_plans_equal(
      leader,
      vector_get_in_bounds<MainTestRootPlan>(plans, index)
    ) { group_roots = group_roots + 1 }
  }
  let pair_count = main_test_root_plan_pair_count(leader)
  let optimise = test_group_optimises(thresholds, group_roots)
  if settings.plan_trace and group_roots > 1 {
    test_note(test_plan_group_trace(group_roots, pair_count, optimise))
  }
  if not test_group_shares(thresholds, group_roots, pair_count) {
    vector_set<bool>(claimed, leader_index, true)
    return totals
  }
  match main_test_checked_base(session, leader, optimise) {
    MainTestCheckedBaseInvalid -> {
      vector_set<bool>(claimed, leader_index, true)
      totals
    }
    MainTestCheckedBaseReady(base, product) -> {
      let leader_path = match leader {
        MainTestReusableRoot(path, _, _, _, _) -> path
        MainTestUnplannedRoot -> ""
      }
      for index in 0..vector_len<MainTestRootPlan>(plans) {
        if not vector_get_in_bounds<bool>(claimed, index) and main_test_root_plans_equal(
          leader,
          vector_get_in_bounds<MainTestRootPlan>(plans, index)
        ) {
          vector_set<bool>(claimed, index, true)
          vector_set<MainTestRootBase>(bases, index, MainTestShared(base, leader_path, product))
        }
      }
      let optimised_functions = if pipeline_optimised_dependency_product_is_available(product) ==
        1 {
          Some<i64>(
            ir_function_list_len(pipeline_optimised_dependency_product_functions(product))
          )
        } else { None<i64>() }
      test_plan_totals_add_group(totals, group_roots, pair_count, optimised_functions)
    }
  }
}

fn main_test_plan(
  roots: Vector<str>,
  jobs: i64,
  settings: TestSettings
) -[SourceAcquire, ConsoleWrite]> MainTestPlan {
  let universal = main_test_universal_base()
  let count = vector_len<str>(roots)
  let bases: Vector<MainTestRootBase> = vector.new<MainTestRootBase>()
  for index in 0..count { vector_push<MainTestRootBase>(bases, MainTestUniversal) }
  let session = project_session_new_with_root_registration(1, main_project_register_root)
  let mut totals = test_plan_totals_empty()
  if count > 1 {
    let plans = main_test_plan_roots(roots)
    let claimed: Vector<bool> = vector.new<bool>()
    for index in 0..count { vector_push<bool>(claimed, false) }
    let thresholds = test_group_thresholds(settings, count, jobs)
    for index in 0..count {
      if not vector_get_in_bounds<bool>(claimed, index) {
        totals = main_test_plan_group(
          plans,
          index,
          claimed,
          bases,
          session,
          thresholds,
          settings,
          totals
        )
      }
    }
    if settings.plan_trace { test_note(test_plan_trace(totals)) }
  }
  let db = project_session_database(session)
  MainTestPlan {
    universal: universal,
    bases: bases,
    session: session,
    totals: TestPlanTotals {
      groups: totals.groups,
      roots: totals.roots,
      reused_pairs: totals.reused_pairs,
      optimised_groups: totals.optimised_groups,
      optimised_roots: totals.optimised_roots,
      reused_optimised_functions: totals.reused_optimised_functions,
      query_hits: incremental_database_hit_count(db),
      query_misses: incremental_database_miss_count(db),
      query_executions: incremental_database_execution_count(db)
    }
  }
}

-- Supervision ---------------------------------------------------------------
-- A root's whole stop, from its declared run budget when it has one.
fn main_test_limit(
  roots: Vector<str>,
  index: i64,
  settings: TestSettings
) -[SourceAcquire]> Duration {
  match main_test_read_root(vector_get_in_bounds<str>(roots, index)) {
    None -> test_root_limit(settings, "")
    Some(root) -> test_root_limit(settings, root.text)
  }
}

fn main_test_report(
  settings: TestSettings,
  roots: i64,
  pool: TestPool,
  plan: TestPlanTotals,
  input_failures: i64,
  started: Instant,
  discovered: Instant,
  planning: Duration
) -> i64 {
  let summary = test_summary(roots, pool.failures, input_failures)
  let wall = main_test_now().duration_since(started)
  with console_terminal() {
    test_note(summary.text)
    if settings.report_metrics {
      test_note(
        test_measures_report(
          TestRunMeasures {
            roots: roots,
            wall: wall,
            discovery: discovered.duration_since(started),
            planning: planning,
            totals: pool.totals,
            plan: plan
          }
        )
      )
    }
  }
  if summary.succeeded { 0 } else { 1 }
}

-- Entry ---------------------------------------------------------------------
fn main_test_arguments(argc: i64, argv: i64) -> Vector<str> {
  with runtime_env(argc, argv) {
    let args: Vector<str> = vector.new<str>()
    for index in 2..Env.arg_count() {
      match Env.arg(index) {
        value: str -> {
          vector_push<str>(args, value)
          nil
        }
        nil -> nil
      }
    }
    args
  }
}

fn main_test_settings(argc: i64, argv: i64) -> TestSettings {
  with runtime_env(argc, argv) { test_settings() }
}

-- Discovery, planning and each worker's compilation run beneath none of the
-- scheduler's handlers; only the scheduling loop and each worker's
-- executable run do.
fn run_test_paths(
  argc: i64,
  argv: i64,
  inputs: Vector<str>,
  jobs: i64,
  host: MainGrammarHost
) -[SourceAcquire]> i64 {
  let settings = main_test_settings(argc, argv)
  let started = main_test_now()
  let discovery = with dir_inspect() { test_discover(inputs) }
  let problems = discovery.problems
  with console_terminal() {
    for index in 0..vector_len<TestDiscoveryProblem>(problems) {
      test_note(test_problem_text(vector_get_in_bounds<TestDiscoveryProblem>(problems, index)))
    }
  }
  let discovered = main_test_now()
  let roots = discovery.roots
  let count = vector_len<str>(roots)
  if count == 0 {
    return main_test_report(
      settings,
      0,
      TestPool { failures: 0, totals: test_totals_empty() },
      test_plan_totals_empty(),
      discovery.failed_inputs,
      started,
      discovered,
      time.milliseconds(0)
    )
  }
  let plan = with console_terminal() { main_test_plan(roots, jobs, settings) }
  let planning = main_test_now().duration_since(discovered)
  let scheduled = with dir_mutate() {
    with file_read() {
      with console_terminal() {
        platform_time.with_platform(
          () =>
            runtime_supervise(
              argc,
              argv,
              () =>
                test_schedule(
                  roots,
                  jobs,
                  settings,
                  (index: i64) => main_test_limit(roots, index, settings)
                )
            )
        )
      }
    }
  }
  match scheduled {
    TestWorkerStarted(worker) -> main_test_worker(argc, argv, worker, roots, plan, settings, host)
    TestRunnerFinished(pool) -> {
      -- Keep the checked-product owner live through the final child exit. Its
      -- source and AST values are the backing storage for inherited raw tables.
      project_session_database(plan.session)
      main_test_report(
        settings,
        count,
        pool,
        plan.totals,
        discovery.failed_inputs,
        started,
        discovered,
        planning
      )
    }
  }
}

fn run_test_command(argc: i64, argv: i64) -[SourceAcquire]> i64 {
  let host = main_grammar_host(argc, argv)
  match test_command(main_test_arguments(argc, argv)) {
    TestEmitInput -> run_test(host)
    TestEmitPath(path) -> run_test_path(path, host)
    TestRunInputs(inputs, jobs) -> run_test_paths(argc, argv, inputs, jobs, host)
    TestUsage -> {
      eprint("usage: weft test [--emit <path>] [--jobs N] <path...>\n")
      1
    }
    TestInvalidJobs -> {
      eprint("test: --jobs must be an integer from 1 to 64\n")
      1
    }
  }
}
