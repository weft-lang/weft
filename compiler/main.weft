-- Weft compiler — Layer 1
-- Compiles Weft source with arithmetic, control flow, functions to aarch64 Mach-O
-- Usage: ./weft < compiler/main.weft > output && chmod +x output

use "compiler/codegen.weft"
use "compiler/typeck.weft"
use "compiler/grammar.weft"
use "compiler/pipeline.weft"
use "runtime/alloc.weft"

-- ======================================================================
-- Main: read source, lex, parse, codegen, emit Mach-O
-- ======================================================================

-- The compile pipeline: parse → check → emit
-- Each phase is a function from pipeline.weft with declared effects.
-- Tools compose different subsets with different handlers.
fn compile(src: i64, n: i64) -> i64 {
  pipeline_compile_native_source(src, n)
}

-- Read a null-terminated C string length
fn cstr_len(ptr: i64) -> i64 {
  let mut i = 0
  while __mem_load8(ptr + i) != 0 { i = i + 1 }
  i
}

-- Compare C string at ptr with Weft string literal
fn cstr_eq(ptr: i64, s: str) -> i64 {
  let sptr = __str_ptr(s)
  let slen = __str_len(s)
  let clen = cstr_len(ptr)
  if clen != slen { 0 }
  else { src_eq_at(ptr, 0, sptr, 0, slen) }
}

-- Subcommand dispatch: weft [compile|fmt|check|ast] < input
-- Default (no args or "compile"): full compilation pipeline
fn main(argc: i64, argv: i64) -> i64 {
  if argc > 1 {
    let cmd = __mem_load64(argv + 8)
    if cstr_eq(cmd, "fmt") == 1 { run_fmt() }
    else { if cstr_eq(cmd, "check") == 1 { run_check() }
    else { if cstr_eq(cmd, "ast") == 1 { run_ast() }
    else { if cstr_eq(cmd, "test") == 1 { run_test() }
    else { if cstr_eq(cmd, "mcp") == 1 { run_mcp() }
    else {
      let input = read_stdin_all()
      let src = __mem_load64(input)
      let n = __mem_load64(input + 8)
      compile(src, n)
    } } } } }
  } else {
    let input = read_stdin_all()
    let src = __mem_load64(input)
    let n = __mem_load64(input + 8)
    compile(src, n)
  }
}

-- ======================================================================
-- Tool: fmt — format source code (parse only, pure)
-- Opinionated, no configuration. Like go fmt.
-- Rules:
--   2-space indent
--   Spaces around binary operators
--   { on same line as if/fn/match/while/for/loop/handle
--   Short single-expression fns on one line
--   Trailing commas in multi-line constructs
--   Blank line between top-level declarations
--   use declarations grouped at top
-- ======================================================================

fn emit_indent(level: i64) -> i64 {
  for i in 0..level { eprint("  ") }
  0
}

fn fmt_op(op: i64) -> i64 {
  match op {
    1 -> eprint(" + ")
    2 -> eprint(" - ")
    3 -> eprint(" * ")
    4 -> eprint(" / ")
    5 -> eprint(" == ")
    6 -> eprint(" != ")
    7 -> eprint(" < ")
    8 -> eprint(" > ")
    9 -> eprint(" <= ")
    10 -> eprint(" >= ")
    11 -> eprint(" % ")
    12 -> eprint(" and ")
    13 -> eprint(" or ")
    14 -> eprint(" band ")
    15 -> eprint(" bor ")
    16 -> eprint(" bxor ")
    17 -> eprint(" bshl ")
    18 -> eprint(" bshr ")
    19 -> eprint(" |> ")
    20 -> eprint("..")
    _ -> { eprint(" <op:") eprint_i(op) eprint("> ") }
  }
  0
}

-- Is this a "simple" expression that fits on one line?
fn is_simple(node: i64) -> bool {
  let tag = node_tag(node)
  match tag {
    1 -> true    -- IntLit
    2 -> true    -- Ident
    9 -> true    -- StringLit
    24 -> true   -- BoolLit
    27 -> true   -- Continue
    _ -> false
  }
}

fn fmt_expr(node: i64, src: i64, indent: i64) -> i64 {
  let tag = node_tag(node)
  match tag {
    1 -> eprint_i(node_f1(node))
    2 -> sys_write(2, src + node_f1(node), node_f2(node))
    3 -> {
      fmt_expr(node_f2(node), src, indent)
      fmt_op(node_f1(node))
      fmt_expr(node_f3(node), src, indent)
    }
    4 -> {
      sys_write(2, src + node_f1(node), node_f2(node))
      eprint("(")
      let args = node_f3(node)
      let nargs = node_f4(node)
      for i in 0..nargs {
        if i > 0 { eprint(", ") } else { 0 }
        fmt_expr(nlist_get(args, i), src, indent)
      }
      eprint(")")
    }
    5 -> {
      eprint("if ")
      fmt_expr(node_f1(node), src, indent)
      eprint(" {\n")
      emit_indent(indent + 1)
      fmt_expr(node_f2(node), src, indent + 1)
      eprint("\n")
      emit_indent(indent)
      if node_f3(node) != 0 {
        eprint("} else {\n")
        emit_indent(indent + 1)
        fmt_expr(node_f3(node), src, indent + 1)
        eprint("\n")
        emit_indent(indent)
        eprint("}")
      } else { eprint("}") }
    }
    6 -> {
      eprint("let ")
      sys_write(2, src + node_f1(node), node_f2(node))
      eprint(" = ")
      fmt_expr(node_f3(node), src, indent)
      eprint("\n")
      emit_indent(indent)
      fmt_expr(node_f4(node), src, indent)
    }
    7 -> {
      fmt_expr(node_f1(node), src, indent)
      if node_f2(node) != 0 {
        eprint("\n")
        emit_indent(indent)
        fmt_expr(node_f2(node), src, indent)
      } else { 0 }
    }
    9 -> {
      eprint("\"")
      sys_write(2, src + node_f1(node), node_f2(node))
      eprint("\"")
    }
    10 -> {
      eprint("while ")
      fmt_expr(node_f1(node), src, indent)
      eprint(" {\n")
      emit_indent(indent + 1)
      fmt_expr(node_f2(node), src, indent + 1)
      eprint("\n")
      emit_indent(indent)
      eprint("}")
    }
    11 -> {
      eprint("let mut ")
      sys_write(2, src + node_f1(node), node_f2(node))
      eprint(" = ")
      fmt_expr(node_f3(node), src, indent)
      eprint("\n")
      emit_indent(indent)
      fmt_expr(node_f4(node), src, indent)
    }
    12 -> {
      sys_write(2, src + node_f1(node), node_f2(node))
      eprint(" = ")
      fmt_expr(node_f3(node), src, indent)
    }
    13 -> {
      -- FieldAccess: base.field
      fmt_expr(node_f1(node), src, indent)
      eprint(".")
      sys_write(2, src + node_f2(node), node_f3(node))
    }
    14 -> {
      -- RecordInit: Type { field: val, ... }
      sys_write(2, src + node_f1(node), node_f2(node))
      eprint(" { ")
      let fields = node_f3(node)
      let nfields = node_f4(node)
      for i in 0..nfields {
        if i > 0 { eprint(", ") } else { 0 }
        let f = nlist_get(fields, i)
        sys_write(2, src + node_f1(f), node_f2(f))
        eprint(": ")
        fmt_expr(node_f3(f), src, indent)
      }
      eprint(" }")
    }
    15 -> {
      eprint("match ")
      fmt_expr(node_f1(node), src, indent)
      eprint(" {\n")
      let arms = node_f2(node)
      let narms = node_f3(node)
      for i in 0..narms {
        let arm = nlist_get(arms, i)
        emit_indent(indent + 1)
        fmt_pattern(node_f1(arm), src)
        if node_f3(arm) != 0 {
          eprint(" if ")
          fmt_expr(node_f3(arm), src, indent + 1)
        } else { 0 }
        eprint(" -> ")
        if is_simple(node_f2(arm)) {
          fmt_expr(node_f2(arm), src, indent + 1)
        } else {
          eprint("{\n")
          emit_indent(indent + 2)
          fmt_expr(node_f2(arm), src, indent + 2)
          eprint("\n")
          emit_indent(indent + 1)
          eprint("}")
        }
        eprint("\n")
      }
      emit_indent(indent)
      eprint("}")
    }
    22 -> { eprint("not ") fmt_expr(node_f1(node), src, indent) }
    24 -> { if node_f1(node) == 1 { eprint("true") } else { eprint("false") } }
    25 -> { eprint("return ") fmt_expr(node_f1(node), src, indent) }
    26 -> {
      -- Break
      eprint("break")
      if node_f1(node) != 0 {
        eprint("(")
        fmt_expr(node_f1(node), src, indent)
        eprint(")")
      } else { 0 }
    }
    27 -> eprint("continue")
    29 -> {
      -- Lambda
      let params = node_f1(node)
      let nparams = node_f3(node)
      if nparams == 1 {
        let p = nlist_get(params, 0)
        sys_write(2, src + node_f1(p), node_f2(p))
      } else {
        eprint("(")
        for i in 0..nparams {
          if i > 0 { eprint(", ") } else { 0 }
          let p = nlist_get(params, i)
          sys_write(2, src + node_f1(p), node_f2(p))
        }
        eprint(")")
      }
      eprint(" => ")
      fmt_expr(node_f2(node), src, indent)
    }
    32 -> {
      -- Perform: Effect.op(args) — f1=lhs, f2=op_ns, f3=op_nl, f4=args
      fmt_expr(node_f1(node), src, indent)
      eprint(".")
      sys_write(2, src + node_f2(node), node_f3(node))
      eprint("(")
      let args = node_f4(node)
      let nargs = nlist_len(args)
      for i in 0..nargs {
        if i > 0 { eprint(", ") } else { 0 }
        fmt_expr(nlist_get(args, i), src, indent)
      }
      eprint(")")
    }
    33 -> {
      -- Handle: f1=body, f2=clauses, f3=nclauses
      eprint("handle ")
      fmt_expr(node_f1(node), src, indent)
      eprint(" {\n")
      let clauses = node_f2(node)
      let nclauses = node_f3(node)
      for i in 0..nclauses {
        let clause = nlist_get(clauses, i)
        -- Clause: f1=name_info(eff_ns, eff_nl, op_ns, op_nl), f2=params, f3=body
        let names = node_f1(clause)
        emit_indent(indent + 1)
        sys_write(2, src + node_f1(names), node_f2(names))
        eprint(".")
        sys_write(2, src + node_f3(names), node_f4(names))
        eprint("(")
        let cparams = node_f2(clause)
        let ncp = nlist_len(cparams)
        for j in 0..ncp {
          if j > 0 { eprint(", ") } else { 0 }
          let cp = nlist_get(cparams, j)
          sys_write(2, src + node_f1(cp), node_f2(cp))
        }
        eprint(") -> ")
        if is_simple(node_f3(clause)) {
          fmt_expr(node_f3(clause), src, indent + 1)
        } else {
          eprint("{\n")
          emit_indent(indent + 2)
          fmt_expr(node_f3(clause), src, indent + 2)
          eprint("\n")
          emit_indent(indent + 1)
          eprint("}")
        }
        eprint("\n")
      }
      emit_indent(indent)
      eprint("}")
    }
    35 -> {
      -- Resume
      eprint("resume(")
      fmt_expr(node_f1(node), src, indent)
      eprint(")")
    }
    36 -> {
      -- GenericCall: inner call with type args
      -- f1=type_args, f2=inner_call
      fmt_expr(node_f2(node), src, indent)
    }
    37 -> {
      -- LetTyped: inner let with type annotation
      fmt_expr(node_f1(node), src, indent)
    }
    41 -> {
      -- MethodCall: recv.method(args) with type hash
      -- f1=recv, f2=method_hash, f3=args, f4=type_hash
      fmt_expr(node_f1(node), src, indent)
    }
    45 -> {
      -- Try: expr?
      fmt_expr(node_f1(node), src, indent)
      eprint("?")
    }
    46 -> {
      -- InterpConcat: string interpolation
      fmt_expr(node_f1(node), src, indent)
      fmt_expr(node_f2(node), src, indent)
    }
    47 -> {
      -- ForIter: for var in collection { body }
      eprint("for ")
      sys_write(2, src + node_f1(node), node_f2(node))
      eprint(" in ")
      fmt_expr(node_f3(node), src, indent)
      eprint(" {\n")
      emit_indent(indent + 1)
      fmt_expr(node_f4(node), src, indent + 1)
      eprint("\n")
      emit_indent(indent)
      eprint("}")
    }
    48 -> {
      -- OptChain: base?.field
      fmt_expr(node_f1(node), src, indent)
      eprint("?.")
      sys_write(2, src + node_f2(node), node_f3(node))
    }
    49 -> {
      -- Loop
      eprint("loop {\n")
      emit_indent(indent + 1)
      fmt_expr(node_f1(node), src, indent + 1)
      eprint("\n")
      emit_indent(indent)
      eprint("}")
    }
    _ -> { eprint("<expr:") eprint_i(tag) eprint(">") }
  }
  0
}

fn fmt_pattern(pat: i64, src: i64) -> i64 {
  let tag = node_tag(pat)
  match tag {
    17 -> eprint("_")
    18 -> sys_write(2, src + node_f1(pat), node_f2(pat))
    19 -> eprint_i(node_f1(pat))
    20 -> {
      sys_write(2, src + node_f1(pat), node_f2(pat))
      let count = node_f4(pat)
      if count > 0 {
        eprint("(")
        if count < 0 {
          -- Multi-binding: f3 is a bindings list
          let binds = node_f3(pat)
          let nb = 0 - count
          for i in 0..nb {
            if i > 0 { eprint(", ") } else { 0 }
            let b = nlist_get(binds, i)
            fmt_pattern(b, src)
          }
        } else {
          -- Single binding
          sys_write(2, src + node_f3(pat), count)
        }
        eprint(")")
      } else { 0 }
    }
    _ -> eprint("?")
  }
  0
}

fn fmt_fn(fn_wrap: i64, fn_src: i64) -> i64 {
  let fn_inner = if node_tag(fn_wrap) == 23 { node_f1(fn_wrap) } else { fn_wrap }
  let ns = node_f1(fn_inner)
  let nl = node_f2(fn_inner)
  let params = node_f3(fn_inner)
  let body = node_f4(fn_inner)
  let nparams = nlist_len(params)
  eprint("fn ")
  sys_write(2, fn_src + ns, nl)
  eprint("(")
  for i in 0..nparams {
    if i > 0 { eprint(", ") } else { 0 }
    let p = nlist_get(params, i)
    sys_write(2, fn_src + node_f1(p), node_f2(p))
    eprint(": i64")
  }
  eprint(") -> i64 ")
  -- Short functions on one line
  if is_simple(body) {
    eprint("{ ")
    fmt_expr(body, fn_src, 1)
    eprint(" }\n")
  } else {
    eprint("{\n")
    emit_indent(1)
    fmt_expr(body, fn_src, 1)
    eprint("\n}\n")
  }
  eprint("\n")
}

fn run_fmt() -> i64 {
  let input = read_stdin_all()
  let src = __mem_load64(input)
  let n = __mem_load64(input + 8)
  let ast = pipeline_parse_source(src, n)
  let fns = pipeline_ast_fns(ast)
  let nfns = nlist_len(fns)
  for i in 0..nfns {
    let pair = nlist_get(fns, i)
    fmt_fn(node_f1(pair), node_f2(pair))
  }
  0
}

-- ======================================================================
-- Tool: check — type check only (parse + check, no codegen)
-- ======================================================================

fn run_check() -> i64 {
  let input = read_stdin_all()
  let src = __mem_load64(input)
  let n = __mem_load64(input + 8)
  let typed = pipeline_check_source(src, n)
  let fns = pipeline_typed_fns(typed)
  let nfns = nlist_len(fns)
  eprint("check: ")
  eprint_i(nfns)
  eprint(" functions, 0 errors\n")
  0
}

-- ======================================================================
-- Tool: ast — dump AST structure (parse only)
-- ======================================================================

fn dump_node(node: i64, src: i64, indent: i64) -> i64 {
  let tag = node_tag(node)
  let mut j = 0
  while j < indent { eprint("  ") j = j + 1 }
  match tag {
    1 -> { eprint("IntLit(") eprint_i(node_f1(node)) eprint(")\n") }
    2 -> { eprint("Ident(") sys_write(2, src + node_f1(node), node_f2(node)) eprint(")\n") }
    3 -> {
      eprint("BinOp(op=") eprint_i(node_f1(node)) eprint(")\n")
      dump_node(node_f2(node), src, indent + 1)
      dump_node(node_f3(node), src, indent + 1)
    }
    4 -> {
      eprint("Call(") sys_write(2, src + node_f1(node), node_f2(node))
      eprint(", nargs=") eprint_i(node_f4(node)) eprint(")\n")
    }
    5 -> {
      eprint("If\n")
      dump_node(node_f1(node), src, indent + 1)
      dump_node(node_f2(node), src, indent + 1)
      if node_f3(node) != 0 { dump_node(node_f3(node), src, indent + 1) } else { 0 }
    }
    6 -> {
      eprint("Let(") sys_write(2, src + node_f1(node), node_f2(node)) eprint(")\n")
      dump_node(node_f3(node), src, indent + 1)
      dump_node(node_f4(node), src, indent + 1)
    }
    7 -> {
      eprint("Block\n")
      dump_node(node_f1(node), src, indent + 1)
      if node_f2(node) != 0 { dump_node(node_f2(node), src, indent + 1) } else { 0 }
    }
    9 -> eprint("StringLit\n")
    15 -> {
      eprint("Match(narms=") eprint_i(node_f3(node)) eprint(")\n")
      dump_node(node_f1(node), src, indent + 1)
    }
    24 -> {
      eprint("BoolLit(")
      if node_f1(node) == 1 { eprint("true") } else { eprint("false") }
      eprint(")\n")
    }
    52 -> {
      eprint("Defer\n")
      dump_node(node_f1(node), src, indent + 1)
      dump_node(node_f2(node), src, indent + 1)
    }
    _ -> { eprint("Node(tag=") eprint_i(tag) eprint(")\n") }
  }
  0
}

fn run_ast() -> i64 {
  let input = read_stdin_all()
  let src = __mem_load64(input)
  let n = __mem_load64(input + 8)
  let ast = pipeline_parse_source(src, n)
  let fns = pipeline_ast_fns(ast)
  let nfns = nlist_len(fns)
  eprint("--- AST: ")
  eprint_i(nfns)
  eprint(" functions ---\n\n")
  for i in 0..nfns {
    let pair = nlist_get(fns, i)
    let fn_wrap = node_f1(pair)
    let fn_src = node_f2(pair)
    let fn_inner = if node_tag(fn_wrap) == 23 { node_f1(fn_wrap) } else { fn_wrap }
    eprint("fn ")
    sys_write(2, fn_src + node_f1(fn_inner), node_f2(fn_inner))
    eprint(":\n")
    dump_node(node_f4(fn_inner), fn_src, 1)
    eprint("\n")
  }
  0
}

-- ======================================================================
-- Tool: mcp — stateless JSON-RPC compiler-as-data queries
-- ======================================================================

fn mcp_write(s: str) -> i64 {
  sys_write(1, __str_ptr(s), __str_len(s))
}

fn mcp_write_i(n: i64) -> i64 {
  if n < 0 { mcp_write("-") mcp_write_i(0 - n) }
  else {
    if n < 10 {
      let b = alloc_bump(8)
      __mem_store8(b, 48 + n)
      sys_write(1, b, 1)
    } else {
      mcp_write_i(n / 10)
      let b = alloc_bump(8)
      __mem_store8(b, 48 + n - n / 10 * 10)
      sys_write(1, b, 1)
    }
  }
}

fn mcp_write_json_byte(ch: i64) -> i64 {
  let b = alloc_bump(1)
  __mem_store8(b, ch)
  sys_write(1, b, 1)
}

fn mcp_write_json_bytes(ptr: i64, n: i64) -> i64 {
  mcp_write("\"")
  let mut i = 0
  while i < n {
    let ch = __mem_load8(ptr + i)
    if ch == 34 {
      mcp_write("\\\"")
    } else { if ch == 92 {
      mcp_write("\\\\")
    } else { if ch == 10 {
      mcp_write("\\n")
    } else { if ch == 13 {
      mcp_write("\\r")
    } else { if ch == 9 {
      mcp_write("\\t")
    } else {
      if ch >= 32 { mcp_write_json_byte(ch) } else { 0 }
    } } } } }
    i = i + 1
  }
  mcp_write("\"")
}

fn mcp_is_json_ws(ch: i64) -> i64 {
  match ch {
    32 -> 1
    10 -> 1
    13 -> 1
    9 -> 1
    _ -> 0
  }
}

fn mcp_skip_json_ws(src: i64, n: i64, pos: i64) -> i64 {
  let mut p = pos
  while p < n and mcp_is_json_ws(__mem_load8(src + p)) == 1 {
    p = p + 1
  }
  p
}

fn mcp_json_result(ok: i64, pos: i64) -> i64 {
  let result = alloc_bump(16)
  __mem_store64(result, ok)
  __mem_store64(result + 8, pos)
  result
}

fn mcp_json_ok(pos: i64) -> i64 { mcp_json_result(1, pos) }
fn mcp_json_bad(pos: i64) -> i64 { mcp_json_result(0, pos) }
fn mcp_json_result_ok(result: i64) -> i64 { __mem_load64(result) }
fn mcp_json_result_pos(result: i64) -> i64 { __mem_load64(result + 8) }

fn mcp_json_key_eq(src: i64, key_start: i64, key_len: i64, key: str) -> i64 {
  src_eq(src, key_start, key_len, key)
}

fn mcp_json_parse_string(src: i64, n: i64, pos: i64) -> i64 {
  if pos >= n { mcp_json_bad(pos) }
  else { if __mem_load8(src + pos) != 34 { mcp_json_bad(pos) }
  else {
    let mut p = pos + 1
    let mut done = 0
    let mut ok = 1
    while p < n and done == 0 and ok == 1 {
      let ch = __mem_load8(src + p)
      match ch {
        34 -> { done = 1 p = p + 1 }
        92 -> {
          if p + 1 >= n { ok = 0 }
          else {
            let esc = __mem_load8(src + p + 1)
            match esc {
              34 -> { p = p + 2 }
              47 -> { p = p + 2 }
              92 -> { p = p + 2 }
              98 -> { p = p + 2 }
              102 -> { p = p + 2 }
              110 -> { p = p + 2 }
              114 -> { p = p + 2 }
              116 -> { p = p + 2 }
              _ -> { ok = 0 }
            }
          }
        }
        10 -> { ok = 0 }
        13 -> { ok = 0 }
        _ -> {
          if ch < 32 { ok = 0 } else { p = p + 1 }
        }
      }
    }
    if ok == 1 and done == 1 { mcp_json_ok(p) } else { mcp_json_bad(p) }
  } }
}

fn mcp_json_parse_literal(src: i64, n: i64, pos: i64, literal: str) -> i64 {
  let len = __str_len(literal)
  if pos + len > n { mcp_json_bad(pos) }
  else {
    if src_eq(src, pos, len, literal) == 1 { mcp_json_ok(pos + len) }
    else { mcp_json_bad(pos) }
  }
}

fn mcp_json_parse_number(src: i64, n: i64, pos: i64) -> i64 {
  let mut p = pos
  if p < n and __mem_load8(src + p) == 45 { p = p + 1 } else { 0 }
  if p >= n { mcp_json_bad(pos) }
  else {
    let first = __mem_load8(src + p)
    if is_digit(first) == 0 { mcp_json_bad(pos) }
    else {
      if first == 48 { p = p + 1 }
      else {
        while p < n and is_digit(__mem_load8(src + p)) == 1 { p = p + 1 }
      }
      let mut ok = 1
      if p < n and __mem_load8(src + p) == 46 {
        p = p + 1
        if p >= n { ok = 0 }
        else {
          let mut ndigits = 0
          while p < n and is_digit(__mem_load8(src + p)) == 1 {
            p = p + 1
            ndigits = ndigits + 1
          }
          if ndigits == 0 { ok = 0 } else { 0 }
        }
      } else { 0 }
      if ok == 1 and p < n and (__mem_load8(src + p) == 101 or __mem_load8(src + p) == 69) {
        p = p + 1
        if p < n and (__mem_load8(src + p) == 43 or __mem_load8(src + p) == 45) { p = p + 1 } else { 0 }
        let mut ndigits = 0
        while p < n and is_digit(__mem_load8(src + p)) == 1 {
          p = p + 1
          ndigits = ndigits + 1
        }
        if ndigits == 0 { ok = 0 } else { 0 }
      } else { 0 }
      if ok == 1 { mcp_json_ok(p) } else { mcp_json_bad(pos) }
    }
  }
}

fn mcp_json_parse_array(src: i64, n: i64, pos: i64) -> i64 {
  let mut p = mcp_skip_json_ws(src, n, pos + 1)
  if p < n and __mem_load8(src + p) == 93 { mcp_json_ok(p + 1) }
  else {
    let mut ok = 1
    let mut done = 0
    while ok == 1 and done == 0 {
      let value = mcp_json_parse_value(src, n, p)
      if mcp_json_result_ok(value) == 0 { ok = 0 p = mcp_json_result_pos(value) }
      else {
        p = mcp_skip_json_ws(src, n, mcp_json_result_pos(value))
        if p < n and __mem_load8(src + p) == 44 {
          p = mcp_skip_json_ws(src, n, p + 1)
        } else { if p < n and __mem_load8(src + p) == 93 {
          p = p + 1
          done = 1
        } else { ok = 0 } }
      }
    }
    if ok == 1 { mcp_json_ok(p) } else { mcp_json_bad(p) }
  }
}

fn mcp_json_parse_object(src: i64, n: i64, pos: i64) -> i64 {
  let mut p = mcp_skip_json_ws(src, n, pos + 1)
  if p < n and __mem_load8(src + p) == 125 { mcp_json_ok(p + 1) }
  else {
    let mut ok = 1
    let mut done = 0
    while ok == 1 and done == 0 {
      let key = mcp_json_parse_string(src, n, p)
      if mcp_json_result_ok(key) == 0 { ok = 0 p = mcp_json_result_pos(key) }
      else {
        p = mcp_skip_json_ws(src, n, mcp_json_result_pos(key))
        if p >= n or __mem_load8(src + p) != 58 { ok = 0 }
        else {
          p = mcp_skip_json_ws(src, n, p + 1)
          let value = mcp_json_parse_value(src, n, p)
          if mcp_json_result_ok(value) == 0 { ok = 0 p = mcp_json_result_pos(value) }
          else {
            p = mcp_skip_json_ws(src, n, mcp_json_result_pos(value))
            if p < n and __mem_load8(src + p) == 44 {
              p = mcp_skip_json_ws(src, n, p + 1)
            } else { if p < n and __mem_load8(src + p) == 125 {
              p = p + 1
              done = 1
            } else { ok = 0 } }
          }
        }
      }
    }
    if ok == 1 { mcp_json_ok(p) } else { mcp_json_bad(p) }
  }
}

fn mcp_json_parse_value(src: i64, n: i64, pos: i64) -> i64 {
  let p = mcp_skip_json_ws(src, n, pos)
  if p >= n { mcp_json_bad(p) }
  else {
    let ch = __mem_load8(src + p)
    match ch {
      34 -> mcp_json_parse_string(src, n, p)
      45 -> mcp_json_parse_number(src, n, p)
      48 -> mcp_json_parse_number(src, n, p)
      49 -> mcp_json_parse_number(src, n, p)
      50 -> mcp_json_parse_number(src, n, p)
      51 -> mcp_json_parse_number(src, n, p)
      52 -> mcp_json_parse_number(src, n, p)
      53 -> mcp_json_parse_number(src, n, p)
      54 -> mcp_json_parse_number(src, n, p)
      55 -> mcp_json_parse_number(src, n, p)
      56 -> mcp_json_parse_number(src, n, p)
      57 -> mcp_json_parse_number(src, n, p)
      91 -> mcp_json_parse_array(src, n, p)
      123 -> mcp_json_parse_object(src, n, p)
      102 -> mcp_json_parse_literal(src, n, p, "false")
      110 -> mcp_json_parse_literal(src, n, p, "null")
      116 -> mcp_json_parse_literal(src, n, p, "true")
      _ -> mcp_json_bad(p)
    }
  }
}

fn mcp_json_root_object_start(src: i64, n: i64) -> i64 {
  let start = mcp_skip_json_ws(src, n, 0)
  if start >= n { 0 - 1 }
  else { if __mem_load8(src + start) != 123 { 0 - 1 }
  else {
    let parsed = mcp_json_parse_value(src, n, start)
    if mcp_json_result_ok(parsed) == 0 { 0 - 1 }
    else {
      let end = mcp_skip_json_ws(src, n, mcp_json_result_pos(parsed))
      if end == n { start } else { 0 - 1 }
    }
  } }
}

fn mcp_json_field_value_start(src: i64, n: i64, obj_start: i64, key_name: str) -> i64 {
  if obj_start < 0 { 0 - 1 }
  else { if obj_start >= n or __mem_load8(src + obj_start) != 123 { 0 - 1 }
  else {
    let mut p = mcp_skip_json_ws(src, n, obj_start + 1)
    let mut result = 0 - 1
    let mut done = 0
    if p < n and __mem_load8(src + p) == 125 { done = 1 } else { 0 }
    while done == 0 and p < n {
      let key_start = p + 1
      let key = mcp_json_parse_string(src, n, p)
      if mcp_json_result_ok(key) == 0 { done = 1 }
      else {
        let key_end = mcp_json_result_pos(key) - 1
        let key_len = key_end - key_start
        p = mcp_skip_json_ws(src, n, mcp_json_result_pos(key))
        if p >= n or __mem_load8(src + p) != 58 { done = 1 }
        else {
          let value_start = mcp_skip_json_ws(src, n, p + 1)
          let value = mcp_json_parse_value(src, n, value_start)
          if mcp_json_result_ok(value) == 0 { done = 1 }
          else {
            if mcp_json_key_eq(src, key_start, key_len, key_name) == 1 {
              result = value_start
              done = 1
            } else {
              p = mcp_skip_json_ws(src, n, mcp_json_result_pos(value))
              if p < n and __mem_load8(src + p) == 44 {
                p = mcp_skip_json_ws(src, n, p + 1)
              } else { done = 1 }
            }
          }
        }
      }
    }
    result
  } }
}

fn mcp_json_object_field_start(src: i64, n: i64, obj_start: i64, key_name: str) -> i64 {
  let value = mcp_json_field_value_start(src, n, obj_start, key_name)
  if value >= 0 and value < n and __mem_load8(src + value) == 123 { value } else { 0 - 1 }
}

fn mcp_json_string_value_eq(src: i64, n: i64, value_start: i64, expected: str) -> i64 {
  if value_start < 0 or value_start >= n { 0 }
  else { if __mem_load8(src + value_start) != 34 { 0 }
  else {
    let parsed = mcp_json_parse_string(src, n, value_start)
    if mcp_json_result_ok(parsed) == 0 { 0 }
    else {
      let content_start = value_start + 1
      let content_len = mcp_json_result_pos(parsed) - content_start - 1
      src_eq(src, content_start, content_len, expected)
    }
  } }
}

fn mcp_source_pair_missing() -> i64 {
  let pair = alloc_bump(16)
  __mem_store64(pair, 0)
  __mem_store64(pair + 8, 0)
  pair
}

fn mcp_decode_json_string_pair(src: i64, n: i64, value_start: i64) -> i64 {
  if value_start < 0 or value_start >= n { mcp_source_pair_missing() }
  else { if __mem_load8(src + value_start) != 34 { mcp_source_pair_missing() }
  else {
    let parsed = mcp_json_parse_string(src, n, value_start)
    if mcp_json_result_ok(parsed) == 0 { mcp_source_pair_missing() }
    else {
    let end = mcp_json_result_pos(parsed) - 1
    let out = alloc_bump(end - value_start + 1)
    let mut pos = value_start + 1
    let mut len = 0
    while pos < end {
      let ch = __mem_load8(src + pos)
      if ch == 92 and pos + 1 < end {
          let next = __mem_load8(src + pos + 1)
          if next == 110 {
            __mem_store8(out + len, 10)
          } else { if next == 34 {
            __mem_store8(out + len, 34)
          } else { if next == 92 {
            __mem_store8(out + len, 92)
          } else { if next == 47 {
            __mem_store8(out + len, 47)
          } else { if next == 114 {
            __mem_store8(out + len, 13)
          } else { if next == 116 {
            __mem_store8(out + len, 9)
          } else { if next == 98 {
            __mem_store8(out + len, 8)
          } else { if next == 102 {
            __mem_store8(out + len, 12)
          } else {
            __mem_store8(out + len, next)
          } } } } } } } }
          pos = pos + 2
          len = len + 1
        } else {
          __mem_store8(out + len, ch)
          pos = pos + 1
          len = len + 1
        }
    }
    let pair = alloc_bump(16)
    __mem_store64(pair, out)
    __mem_store64(pair + 8, len)
    pair
    }
  } }
}

fn mcp_extract_argument_string(src: i64, n: i64, root: i64, key_name: str) -> i64 {
  let params = mcp_json_object_field_start(src, n, root, "params")
  let args = mcp_json_object_field_start(src, n, params, "arguments")
  let value = mcp_json_field_value_start(src, n, args, key_name)
  mcp_decode_json_string_pair(src, n, value)
}

fn mcp_extract_source(src: i64, n: i64, root: i64) -> i64 {
  mcp_extract_argument_string(src, n, root, "source")
}

fn mcp_extract_lookup_name(src: i64, n: i64, root: i64) -> i64 {
  mcp_extract_argument_string(src, n, root, "name")
}

fn mcp_emit_error(id_null: i64, code: i64, message: str) -> i64 {
  mcp_write("{\"jsonrpc\":\"2.0\",\"id\":")
  if id_null == 1 { mcp_write("null") } else { mcp_write("1") }
  mcp_write(",\"error\":{\"code\":")
  mcp_write_i(code)
  mcp_write(",\"message\":\"")
  mcp_write(message)
  mcp_write("\"}}")
}

fn mcp_emit_tools_list() -> i64 {
  mcp_write("{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"tools\":[{\"name\":\"parse_summary\"},{\"name\":\"check_summary\"},{\"name\":\"ir_summary\"},{\"name\":\"type_lookup\"},{\"name\":\"effect_lookup\"},{\"name\":\"diagnostics\"}]}}")
}

fn mcp_begin_result(tool: str) -> i64 {
  mcp_write("{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"tool\":\"")
  mcp_write(tool)
  mcp_write("\",\"ok\":true")
}

fn mcp_end_result() -> i64 {
  mcp_write("}}")
}

fn mcp_parse_source_quiet(src: i64, n: i64) -> AstModule {
  handle pipeline_parse_source_with_diagnostics(src, n) {
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
}

fn mcp_check_source_quiet(src: i64, n: i64) -> TypedModule {
  handle pipeline_check_source_with_diagnostics(src, n) {
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
}

fn mcp_emit_parse_summary(src: i64, n: i64) -> i64 {
  let ast = mcp_parse_source_quiet(src, n)
  let fns = pipeline_ast_fns(ast)
  let body = pipeline_ast_first_body_expr(ast)
  mcp_begin_result("parse_summary")
  mcp_write(",\"functions\":")
  mcp_write_i(nlist_len(fns))
  mcp_write(",\"first_body_tag\":")
  mcp_write_i(expr_tag(body))
  mcp_end_result()
}

fn mcp_emit_check_summary(src: i64, n: i64) -> i64 {
  let typed = mcp_check_source_quiet(src, n)
  let fns = pipeline_typed_fns(typed)
  let body = pipeline_typed_first_body_expr(typed)
  mcp_begin_result("check_summary")
  mcp_write(",\"functions\":")
  mcp_write_i(nlist_len(fns))
  mcp_write(",\"first_body_tag\":")
  mcp_write_i(expr_tag(body))
  mcp_end_result()
}

fn mcp_emit_ir_summary(src: i64, n: i64) -> i64 {
  let typed = mcp_check_source_quiet(src, n)
  let ir = pipeline_lower_ir(typed)
  let functions = pipeline_ir_functions(ir)
  mcp_begin_result("ir_summary")
  mcp_write(",\"functions\":")
  mcp_write_i(ir_function_list_len(functions))
  mcp_write(",\"blocks\":")
  mcp_write_i(ir_function_list_block_count(functions))
  mcp_write(",\"insts\":")
  mcp_write_i(ir_function_list_inst_count(functions))
  mcp_end_result()
}

fn mcp_diag_entry(severity: i64, msg: str, span: i64) -> i64 {
  let entry = alloc_bump(32)
  __mem_store64(entry, severity)
  __mem_store64(entry + 8, __str_ptr(msg))
  __mem_store64(entry + 16, __str_len(msg))
  __mem_store64(entry + 24, span)
  entry
}

fn mcp_span_line(src: i64, span: i64) -> i64 {
  if span < 0 { 0 - 1 }
  else {
    let mut i = 0
    let mut line = 1
    while i < span {
      if __mem_load8(src + i) == 10 { line = line + 1 } else { 0 }
      i = i + 1
    }
    line
  }
}

fn mcp_span_col(src: i64, span: i64) -> i64 {
  if span < 0 { 0 - 1 }
  else {
    let mut i = 0
    let mut col = 1
    while i < span {
      if __mem_load8(src + i) == 10 { col = 1 } else { col = col + 1 }
      i = i + 1
    }
    col
  }
}

fn mcp_write_diag_severity(severity: i64) -> i64 {
  match severity {
    1 -> mcp_write("\"error\"")
    2 -> mcp_write("\"warn\"")
    3 -> mcp_write("\"note\"")
    _ -> mcp_write("\"unknown\"")
  }
}

fn mcp_emit_diag_item(src: i64, entry: i64) -> i64 {
  let severity = __mem_load64(entry)
  let msg_ptr = __mem_load64(entry + 8)
  let msg_len = __mem_load64(entry + 16)
  let span = __mem_load64(entry + 24)
  mcp_write("{\"severity\":")
  mcp_write_diag_severity(severity)
  mcp_write(",\"message\":")
  mcp_write_json_bytes(msg_ptr, msg_len)
  mcp_write(",\"span\":")
  mcp_write_i(span)
  mcp_write(",\"line\":")
  mcp_write_i(mcp_span_line(src, span))
  mcp_write(",\"col\":")
  mcp_write_i(mcp_span_col(src, span))
  mcp_write("}")
}

fn mcp_emit_diag_items(src: i64, diags: i64) -> i64 {
  let n = nlist_len(diags)
  mcp_write("[")
  for i in 0..n {
    if i > 0 { mcp_write(",") } else { 0 }
    mcp_emit_diag_item(src, nlist_get(diags, i))
  }
  mcp_write("]")
}

fn mcp_emit_diagnostics(src: i64, n: i64) -> i64 {
  let tt = ttable_new()
  let grammar = weft_grammar()
  let diags = nlist_new()
  let fns = handle grammar.parse(src, n, tt) {
    Diagnose.error(msg, span) -> { nlist_add(diags, mcp_diag_entry(1, msg, span)) resume(0) }
    Diagnose.warn(msg, span) -> { nlist_add(diags, mcp_diag_entry(2, msg, span)) resume(0) }
    Diagnose.note(msg, span) -> { nlist_add(diags, mcp_diag_entry(3, msg, span)) resume(0) }
  }
  let check_errors = handle grammar.check(fns, src, tt) {
    Diagnose.error(msg, span) -> { nlist_add(diags, mcp_diag_entry(1, msg, span)) resume(0) }
    Diagnose.warn(msg, span) -> { nlist_add(diags, mcp_diag_entry(2, msg, span)) resume(0) }
    Diagnose.note(msg, span) -> { nlist_add(diags, mcp_diag_entry(3, msg, span)) resume(0) }
  }
  mcp_begin_result("diagnostics")
  mcp_write(",\"phase\":\"parse+check\",\"diagnostics\":")
  mcp_write_i(nlist_len(diags))
  mcp_write(",\"functions\":")
  mcp_write_i(nlist_len(fns))
  mcp_write(",\"check_errors\":")
  mcp_write_i(check_errors)
  mcp_write(",\"items\":")
  mcp_emit_diag_items(src, diags)
  mcp_end_result()
}

fn mcp_type_tag_or(ty: i64, default: i64) -> i64 {
  if ty == 0 { default } else { ty_tag(ty) }
}

fn mcp_type_prim_id_or(ty: i64, default: i64) -> i64 {
  if ty == 0 { default }
  else { if ty_tag(ty) == 2 { ty_f1(ty) } else { default } }
}

fn mcp_effect_tail_or(eff: i64, default: i64) -> i64 {
  if eff == 0 { default }
  else { if ty_tag(eff) == 10 { ty_f2(eff) } else { default } }
}

fn mcp_name_bytes_eq(name_ptr: i64, name_n: i64, cand_ptr: i64, cand_n: i64) -> i64 {
  if name_n != cand_n { 0 } else { src_eq_at(name_ptr, 0, cand_ptr, 0, name_n) }
}

fn mcp_lookup_fn_pair(fns: i64, name_ptr: i64, name_n: i64) -> i64 {
  let n = nlist_len(fns)
  let mut i = 0
  let mut result = 0
  while i < n {
    let pair = nlist_get(fns, i)
    let fn_wrap = node_f1(pair)
    let fn_src = node_f2(pair)
    let inner = pipeline_fn_inner(fn_wrap)
    let ns = node_f1(inner)
    let nl = node_f2(inner)
    if mcp_name_bytes_eq(name_ptr, name_n, fn_src + ns, nl) == 1 {
      result = pair
      i = n
    } else {
      i = i + 1
    }
  }
  result
}

fn mcp_type_entry_raw(entry: TypeEntry) -> i64 {
  match entry {
    TypeEntry(raw) -> raw
    MissingTypeEntry -> 0
  }
}

fn mcp_type_entry_matches_name(raw: i64, name_ptr: i64, name_n: i64) -> i64 {
  if raw == 0 { 0 }
  else {
    let entry_src = __mem_load64(raw + 48)
    let ns = __mem_load64(raw)
    let nl = __mem_load64(raw + 8)
    mcp_name_bytes_eq(name_ptr, name_n, entry_src + ns, nl)
  }
}

fn mcp_lookup_type_entry_raw(entries: TypeEntryList, name_ptr: i64, name_n: i64, kind_filter: i64) -> i64 {
  let n = type_entry_list_len(entries)
  let mut i = 0
  let mut result = 0
  while i < n {
    let entry = type_entry_list_nth(entries, i)
    let raw = mcp_type_entry_raw(entry)
    let kind = type_entry_kind_or(entry, 0 - 1)
    let kind_ok = if kind_filter < 0 { 1 } else { if kind == kind_filter { 1 } else { 0 } }
    if kind_ok == 1 and mcp_type_entry_matches_name(raw, name_ptr, name_n) == 1 {
      result = raw
      i = n
    } else {
      i = i + 1
    }
  }
  result
}

fn mcp_write_type_entry_kind(kind: i64) -> i64 {
  match kind {
    0 -> mcp_write("\"record\"")
    1 -> mcp_write("\"variant\"")
    2 -> mcp_write("\"effect\"")
    3 -> mcp_write("\"trait\"")
    4 -> mcp_write("\"impl\"")
    _ -> mcp_write("\"unknown\"")
  }
}

fn mcp_emit_type_lookup_not_found(name_ptr: i64, name_n: i64) -> i64 {
  mcp_begin_result("type_lookup")
  mcp_write(",\"name\":")
  mcp_write_json_bytes(name_ptr, name_n)
  mcp_write(",\"found\":false")
  mcp_end_result()
}

fn mcp_emit_type_lookup_function(pair: i64, name_ptr: i64, name_n: i64) -> i64 {
  let fn_wrap = node_f1(pair)
  let inner = pipeline_fn_inner(fn_wrap)
  let params = node_f3(inner)
  let ret = fn_ret_type(fn_wrap)
  let eff = fn_effects(fn_wrap)
  let nparams = if params == 0 { 0 } else { nlist_len(params) }
  mcp_begin_result("type_lookup")
  mcp_write(",\"name\":")
  mcp_write_json_bytes(name_ptr, name_n)
  mcp_write(",\"found\":true,\"kind\":\"function\",\"params\":")
  mcp_write_i(nparams)
  mcp_write(",\"return_type_tag\":")
  mcp_write_i(mcp_type_tag_or(ret, 0 - 1))
  mcp_write(",\"return_type_prim\":")
  mcp_write_i(mcp_type_prim_id_or(ret, 0 - 1))
  mcp_write(",\"effects\":")
  mcp_write_i(effect_sig_effect_count_or(eff, 0))
  mcp_write(",\"effect_tail\":")
  mcp_write_i(mcp_effect_tail_or(eff, 0))
  mcp_end_result()
}

fn mcp_emit_type_lookup_entry(raw: i64, name_ptr: i64, name_n: i64) -> i64 {
  let entry = type_entry_from_ptr(raw)
  mcp_begin_result("type_lookup")
  mcp_write(",\"name\":")
  mcp_write_json_bytes(name_ptr, name_n)
  mcp_write(",\"found\":true,\"kind\":")
  mcp_write_type_entry_kind(type_entry_kind_or(entry, 0 - 1))
  mcp_write(",\"items\":")
  mcp_write_i(type_entry_item_count_or(entry, 0))
  mcp_write(",\"type_params\":")
  mcp_write_i(type_entry_type_param_count_or(entry, 0))
  mcp_end_result()
}

fn mcp_emit_type_lookup(src: i64, n: i64, name_ptr: i64, name_n: i64) -> i64 {
  let typed = mcp_check_source_quiet(src, n)
  let pair = mcp_lookup_fn_pair(pipeline_typed_fns(typed), name_ptr, name_n)
  if pair != 0 {
    mcp_emit_type_lookup_function(pair, name_ptr, name_n)
  } else {
    let entry = mcp_lookup_type_entry_raw(pipeline_typed_type_entries(typed), name_ptr, name_n, 0 - 1)
    if entry != 0 { mcp_emit_type_lookup_entry(entry, name_ptr, name_n) }
    else { mcp_emit_type_lookup_not_found(name_ptr, name_n) }
  }
}

fn mcp_effect_op_name_start_or(op: TypeEffectOp, default: i64) -> i64 {
  match op {
    TypeEffectOp(ns, nl, params, ret_type) -> ns
    DeferredTypeEffectOp(ns, nl, params, ret_type) -> ns
    MissingTypeEffectOp -> default
  }
}

fn mcp_emit_effect_lookup_not_found(name_ptr: i64, name_n: i64) -> i64 {
  mcp_begin_result("effect_lookup")
  mcp_write(",\"name\":")
  mcp_write_json_bytes(name_ptr, name_n)
  mcp_write(",\"found\":false")
  mcp_end_result()
}

fn mcp_emit_effect_lookup_entry(raw: i64, name_ptr: i64, name_n: i64) -> i64 {
  let entry = type_entry_from_ptr(raw)
  let entry_src = __mem_load64(raw + 48)
  let ops = type_entry_effect_ops(entry)
  let nops = type_effect_op_list_len(ops)
  let first = type_effect_op_list_nth(ops, 0)
  mcp_begin_result("effect_lookup")
  mcp_write(",\"name\":")
  mcp_write_json_bytes(name_ptr, name_n)
  mcp_write(",\"found\":true,\"kind\":\"effect\",\"ops\":")
  mcp_write_i(nops)
  mcp_write(",\"first_op\":")
  if nops == 0 { mcp_write("null") }
  else {
    let op_ns = mcp_effect_op_name_start_or(first, 0)
    let op_nl = type_effect_op_name_len_or(first, 0)
    mcp_write_json_bytes(entry_src + op_ns, op_nl)
  }
  mcp_write(",\"first_op_params\":")
  mcp_write_i(type_effect_op_param_count_or(first, 0 - 1))
  mcp_write(",\"first_op_return_type_tag\":")
  mcp_write_i(type_effect_op_return_type_tag_or(first, 0 - 1))
  mcp_write(",\"first_op_return_type_prim\":")
  mcp_write_i(type_effect_op_return_type_prim_id_or(first, 0 - 1))
  mcp_write(",\"first_op_deferred\":")
  mcp_write_i(type_effect_op_is_deferred(first))
  mcp_end_result()
}

fn mcp_emit_effect_lookup(src: i64, n: i64, name_ptr: i64, name_n: i64) -> i64 {
  let typed = mcp_check_source_quiet(src, n)
  let entry = mcp_lookup_type_entry_raw(pipeline_typed_type_entries(typed), name_ptr, name_n, 2)
  if entry != 0 { mcp_emit_effect_lookup_entry(entry, name_ptr, name_n) }
  else { mcp_emit_effect_lookup_not_found(name_ptr, name_n) }
}

fn mcp_dispatch_lookup_tool(req: i64, n: i64, root: i64, src: i64, src_n: i64, tool_id: i64) -> i64 {
  let name_pair = mcp_extract_lookup_name(req, n, root)
  let name_ptr = __mem_load64(name_pair)
  let name_n = __mem_load64(name_pair + 8)
  if name_ptr == 0 {
    mcp_emit_error(0, 0 - 32602, "missing lookup name")
  } else {
    match tool_id {
      4 -> mcp_emit_type_lookup(src, src_n, name_ptr, name_n)
      5 -> mcp_emit_effect_lookup(src, src_n, name_ptr, name_n)
      _ -> mcp_emit_error(0, 0 - 32601, "unknown tool")
    }
  }
}

fn mcp_dispatch_known_tool(req: i64, n: i64, root: i64, tool_id: i64) -> i64 {
  let pair = mcp_extract_source(req, n, root)
  let src = __mem_load64(pair)
  let src_n = __mem_load64(pair + 8)
  if src == 0 {
    mcp_emit_error(0, 0 - 32602, "missing source")
  } else {
    match tool_id {
      1 -> mcp_emit_parse_summary(src, src_n)
      2 -> mcp_emit_check_summary(src, src_n)
      3 -> mcp_emit_ir_summary(src, src_n)
      4 -> mcp_dispatch_lookup_tool(req, n, root, src, src_n, tool_id)
      5 -> mcp_dispatch_lookup_tool(req, n, root, src, src_n, tool_id)
      6 -> mcp_emit_diagnostics(src, src_n)
      _ -> mcp_emit_error(0, 0 - 32601, "unknown tool")
    }
  }
}

fn mcp_dispatch_tool(req: i64, n: i64, root: i64) -> i64 {
  let params = mcp_json_object_field_start(req, n, root, "params")
  let name_value = mcp_json_field_value_start(req, n, params, "name")
  if name_value < 0 {
    mcp_emit_error(0, 0 - 32602, "missing tool name")
  } else {
    if mcp_json_string_value_eq(req, n, name_value, "parse_summary") == 1 {
      mcp_dispatch_known_tool(req, n, root, 1)
    } else { if mcp_json_string_value_eq(req, n, name_value, "check_summary") == 1 {
      mcp_dispatch_known_tool(req, n, root, 2)
    } else { if mcp_json_string_value_eq(req, n, name_value, "ir_summary") == 1 {
      mcp_dispatch_known_tool(req, n, root, 3)
    } else { if mcp_json_string_value_eq(req, n, name_value, "type_lookup") == 1 {
      mcp_dispatch_known_tool(req, n, root, 4)
    } else { if mcp_json_string_value_eq(req, n, name_value, "effect_lookup") == 1 {
      mcp_dispatch_known_tool(req, n, root, 5)
    } else { if mcp_json_string_value_eq(req, n, name_value, "diagnostics") == 1 {
      mcp_dispatch_known_tool(req, n, root, 6)
    } else {
      mcp_emit_error(0, 0 - 32601, "unknown tool")
    } } } } } }
  }
}

fn run_mcp() -> i64 {
  let input = read_stdin_all()
  let req = __mem_load64(input)
  let n = __mem_load64(input + 8)
  let root = mcp_json_root_object_start(req, n)
  if root < 0 {
    mcp_emit_error(1, 0 - 32700, "invalid json-rpc")
  } else {
    let jsonrpc = mcp_json_field_value_start(req, n, root, "jsonrpc")
    let method = mcp_json_field_value_start(req, n, root, "method")
    if mcp_json_string_value_eq(req, n, jsonrpc, "2.0") == 0 {
      mcp_emit_error(0, 0 - 32600, "invalid request")
    } else { if method < 0 {
      mcp_emit_error(0, 0 - 32600, "invalid request")
    } else { if mcp_json_string_value_eq(req, n, method, "tools/list") == 1 {
      mcp_emit_tools_list()
    } else { if mcp_json_string_value_eq(req, n, method, "tools/call") == 1 {
      mcp_dispatch_tool(req, n, root)
    } else {
      mcp_emit_error(0, 0 - 32601, "unknown method")
    } } } }
  }
  0
}

-- ======================================================================
-- Tool: test — compile and run tests with Test effect handler
-- ======================================================================
-- The test runner:
-- 1. Parses source, finds test blocks (tag 50) and regular functions
-- 2. Registers the built-in Test effect assertion helpers
-- 3. Wraps each test body in a function + Test handler
-- 4. Builds a synthetic main that runs all tests, reports results
-- 5. Compiles to stdout (caller runs the binary)

-- Generate harness source that wraps each test body in a function
-- called __test_0, __test_1, etc. Then generates a main that calls
-- each wrapped test and reports results.
fn emit_harness_src(buf: i64, tests: i64, ntests: i64, src: i64) -> i64 {
  -- Emit test wrapper functions: fn __test_N() -> i64 { body }
  -- We can't easily regenerate source from AST, so instead we emit
  -- the test body as-is by copying source bytes for the block.
  -- This requires knowing the source range of each test body.
  --
  -- Simpler approach: compile test bodies directly. Each test block
  -- becomes a function __test_N with the test body. The harness main
  -- calls each one and checks the return value.
  --
  -- Since we can't regenerate source, we take a different approach:
  -- the test bodies stay as AST nodes in the fn list. We just add
  -- a synthesized main that calls them.
  0
}

fn test_assertion_bit_eq() -> i64 { 1 }
fn test_assertion_bit_ne() -> i64 { 2 }
fn test_assertion_bit_true() -> i64 { 4 }
fn test_assertion_bit_false() -> i64 { 8 }
fn test_assertion_bit_lt() -> i64 { 16 }
fn test_assertion_bit_le() -> i64 { 32 }
fn test_assertion_bit_gt() -> i64 { 64 }
fn test_assertion_bit_ge() -> i64 { 128 }
fn test_assertion_bit_str_eq() -> i64 { 256 }
fn test_assertion_bit_str_ne() -> i64 { 512 }
fn test_assertion_bit_snapshot() -> i64 { 1024 }
fn test_assertion_bit_forall_i64_range() -> i64 { 2048 }
fn test_assertion_bit_with_state_i64() -> i64 { 4096 }
fn test_assertion_bit_expect_fail_i64() -> i64 { 8192 }
fn test_assertion_bit_with_io_i64() -> i64 { 16384 }
fn test_assertion_bit_with_diagnose_i64() -> i64 { 32768 }

fn test_mask_has(mask: i64, bit: i64) -> i64 {
  if (mask / bit) % 2 == 1 { 1 } else { 0 }
}

fn test_mask_add(mask: i64, bit: i64) -> i64 {
  if test_mask_has(mask, bit) == 1 { mask } else { mask + bit }
}

fn test_mask_merge(a: i64, b: i64) -> i64 {
  let mut result = a
  let mut bit = 1
  while bit <= 32768 {
    if test_mask_has(b, bit) == 1 {
      result = test_mask_add(result, bit)
    } else { 0 }
    bit = bit * 2
  }
  result
}

fn test_assertion_bit_for_op(src: i64, ns: i64, nl: i64) -> i64 {
  if src_eq(src, ns, nl, "assert_eq") == 1 { test_assertion_bit_eq() }
  else { if src_eq(src, ns, nl, "assert_ne") == 1 { test_assertion_bit_ne() }
  else { if src_eq(src, ns, nl, "assert_true") == 1 { test_assertion_bit_true() }
  else { if src_eq(src, ns, nl, "assert_false") == 1 { test_assertion_bit_false() }
  else { if src_eq(src, ns, nl, "assert_lt") == 1 { test_assertion_bit_lt() }
  else { if src_eq(src, ns, nl, "assert_le") == 1 { test_assertion_bit_le() }
  else { if src_eq(src, ns, nl, "assert_gt") == 1 { test_assertion_bit_gt() }
  else { if src_eq(src, ns, nl, "assert_ge") == 1 { test_assertion_bit_ge() }
  else { if src_eq(src, ns, nl, "assert_str_eq") == 1 { test_assertion_bit_str_eq() }
  else { if src_eq(src, ns, nl, "assert_str_ne") == 1 { test_assertion_bit_str_ne() }
  else { if src_eq(src, ns, nl, "assert_snapshot") == 1 { test_assertion_bit_snapshot() }
  else { if src_eq(src, ns, nl, "forall_i64_range") == 1 { test_assertion_bit_forall_i64_range() }
  else { if src_eq(src, ns, nl, "with_state_i64") == 1 { test_assertion_bit_with_state_i64() }
  else { if src_eq(src, ns, nl, "expect_fail_i64") == 1 { test_assertion_bit_expect_fail_i64() }
  else { if src_eq(src, ns, nl, "with_io_i64") == 1 { test_assertion_bit_with_io_i64() }
  else { if src_eq(src, ns, nl, "with_diagnose_i64") == 1 { test_assertion_bit_with_diagnose_i64() }
  else { 0 } } } } } } } } } } } } } } } }
}

fn test_assertions_mask_expr_list(list: i64, n: i64, src: i64) -> i64 {
  let mut mask = 0
  for i in 0..n {
    mask = test_mask_merge(mask, test_assertions_mask_expr(nlist_get(list, i), src))
  }
  mask
}

fn test_assertions_mask_fields(fields: i64, n: i64, src: i64) -> i64 {
  let mut mask = 0
  for i in 0..n {
    mask = test_mask_merge(mask, test_assertions_mask_expr(node_f3(nlist_get(fields, i)), src))
  }
  mask
}

fn test_assertions_mask_match_arms(arms: i64, n: i64, src: i64) -> i64 {
  let mut mask = 0
  for i in 0..n {
    let arm = nlist_get(arms, i)
    mask = test_mask_merge(mask, test_assertions_mask_expr(node_f2(arm), src))
    let guard = node_f3(arm)
    if guard != 0 {
      mask = test_mask_merge(mask, test_assertions_mask_expr(guard, src))
    } else { 0 }
  }
  mask
}

fn test_assertions_mask_clauses(clauses: i64, n: i64, src: i64) -> i64 {
  let mut mask = 0
  for i in 0..n {
    mask = test_mask_merge(mask, test_assertions_mask_expr(node_f3(nlist_get(clauses, i)), src))
  }
  mask
}

fn test_assertions_mask_expr(node: i64, src: i64) -> i64 {
  if node == 0 { 0 }
  else {
    let tag = node_tag(node)
    let self_mask = if tag == 32 {
      let lhs = node_f1(node)
      if node_tag(lhs) == 2 {
        if src_eq(src, node_f1(lhs), node_f2(lhs), "Test") == 1 {
          test_assertion_bit_for_op(src, node_f2(node), node_f3(node))
        } else { 0 }
      } else { 0 }
    } else { 0 }
    let child_mask = match tag {
      3 -> test_mask_merge(test_assertions_mask_expr(node_f3(node), src), test_assertions_mask_expr(node_f4(node), src))
      4 -> test_assertions_mask_expr_list(node_f3(node), node_f4(node), src)
      5 -> test_mask_merge(test_assertions_mask_expr(node_f1(node), src), test_mask_merge(test_assertions_mask_expr(node_f2(node), src), test_assertions_mask_expr(node_f3(node), src)))
      6 -> test_mask_merge(test_assertions_mask_expr(node_f3(node), src), test_assertions_mask_expr(node_f4(node), src))
      7 -> test_mask_merge(test_assertions_mask_expr(node_f1(node), src), test_assertions_mask_expr(node_f2(node), src))
      10 -> test_mask_merge(test_assertions_mask_expr(node_f1(node), src), test_assertions_mask_expr(node_f2(node), src))
      11 -> test_mask_merge(test_assertions_mask_expr(node_f3(node), src), test_assertions_mask_expr(node_f4(node), src))
      12 -> test_assertions_mask_expr(node_f3(node), src)
      13 -> test_assertions_mask_expr(node_f1(node), src)
      14 -> test_assertions_mask_fields(node_f3(node), node_f4(node), src)
      15 -> test_mask_merge(test_assertions_mask_expr(node_f1(node), src), test_assertions_mask_match_arms(node_f2(node), node_f3(node), src))
      22 -> test_assertions_mask_expr(node_f1(node), src)
      25 -> test_assertions_mask_expr(node_f1(node), src)
      26 -> test_assertions_mask_expr(node_f1(node), src)
      29 -> test_assertions_mask_expr(node_f2(node), src)
      32 -> test_assertions_mask_expr_list(node_f4(node), nlist_len(node_f4(node)), src)
      33 -> test_mask_merge(test_assertions_mask_expr(node_f1(node), src), test_assertions_mask_clauses(node_f2(node), node_f3(node), src))
      35 -> test_assertions_mask_expr(node_f1(node), src)
      36 -> test_assertions_mask_expr_list(node_f3(node_f2(node)), node_f4(node_f2(node)), src)
      37 -> {
        let inner = node_f1(node)
        test_mask_merge(test_assertions_mask_expr(node_f3(inner), src), test_assertions_mask_expr(node_f4(inner), src))
      }
      41 -> test_assertions_mask_expr_list(node_f3(node), nlist_len(node_f3(node)), src)
      45 -> test_assertions_mask_expr(node_f1(node), src)
      46 -> test_mask_merge(test_assertions_mask_expr(node_f1(node), src), test_assertions_mask_expr(node_f2(node), src))
      47 -> test_mask_merge(test_assertions_mask_expr(node_f3(node), src), test_assertions_mask_expr(node_f4(node), src))
      48 -> test_assertions_mask_expr(node_f1(node), src)
      49 -> test_assertions_mask_expr(node_f1(node), src)
      52 -> test_mask_merge(test_assertions_mask_expr(node_f1(node), src), test_assertions_mask_expr(node_f2(node), src))
      _ -> 0
    }
    test_mask_merge(self_mask, child_mask)
  }
}

fn test_assertions_mask_tests(tests: i64, ntests: i64) -> i64 {
  let mut mask = 0
  for ti in 0..ntests {
    let pair = nlist_get(tests, ti)
    let test_node = node_f1(pair)
    let test_src = node_f2(pair)
    mask = test_mask_merge(mask, test_assertions_mask_expr(node_f3(test_node), test_src))
  }
  mask
}

fn test_assertions_mask_functions(fns: i64, nfns: i64, root_src: i64) -> i64 {
  let mut mask = 0
  for i in 0..nfns {
    let pair = nlist_get(fns, i)
    let fn_src = node_f2(pair)
    if fn_src == root_src {
      let fn_wrap = node_f1(pair)
      let fn_inner = if node_tag(fn_wrap) == 23 { node_f1(fn_wrap) } else { fn_wrap }
      if node_tag(fn_inner) == 8 {
        mask = test_mask_merge(mask, test_assertions_mask_expr(node_f4(fn_inner), fn_src))
      } else { 0 }
    } else { 0 }
  }
  mask
}

fn test_append_handler_clauses(buf: i64, mask: i64) -> i64 {
  if test_mask_has(mask, test_assertion_bit_eq()) == 1 {
    buf_append_str(buf, " Test.assert_eq(g, e) -> { if g != e { test_fail_assertion(\"assert_eq\") __mem_store64(st, 0) } else { 0 } resume(0) }")
  } else { 0 }
  if test_mask_has(mask, test_assertion_bit_ne()) == 1 {
    buf_append_str(buf, " Test.assert_ne(g, u) -> { if g == u { test_fail_assertion(\"assert_ne\") __mem_store64(st, 0) } else { 0 } resume(0) }")
  } else { 0 }
  if test_mask_has(mask, test_assertion_bit_true()) == 1 {
    buf_append_str(buf, " Test.assert_true(v) -> { if v { 0 } else { test_fail_assertion(\"assert_true\") __mem_store64(st, 0) } resume(0) }")
  } else { 0 }
  if test_mask_has(mask, test_assertion_bit_false()) == 1 {
    buf_append_str(buf, " Test.assert_false(v) -> { if v { test_fail_assertion(\"assert_false\") __mem_store64(st, 0) } else { 0 } resume(0) }")
  } else { 0 }
  if test_mask_has(mask, test_assertion_bit_lt()) == 1 {
    buf_append_str(buf, " Test.assert_lt(l, r) -> { if l < r { 0 } else { test_fail_assertion(\"assert_lt\") __mem_store64(st, 0) } resume(0) }")
  } else { 0 }
  if test_mask_has(mask, test_assertion_bit_le()) == 1 {
    buf_append_str(buf, " Test.assert_le(l, r) -> { if l <= r { 0 } else { test_fail_assertion(\"assert_le\") __mem_store64(st, 0) } resume(0) }")
  } else { 0 }
  if test_mask_has(mask, test_assertion_bit_gt()) == 1 {
    buf_append_str(buf, " Test.assert_gt(l, r) -> { if l > r { 0 } else { test_fail_assertion(\"assert_gt\") __mem_store64(st, 0) } resume(0) }")
  } else { 0 }
  if test_mask_has(mask, test_assertion_bit_ge()) == 1 {
    buf_append_str(buf, " Test.assert_ge(l, r) -> { if l >= r { 0 } else { test_fail_assertion(\"assert_ge\") __mem_store64(st, 0) } resume(0) }")
  } else { 0 }
  if test_mask_has(mask, test_assertion_bit_str_eq()) == 1 {
    buf_append_str(buf, " Test.assert_str_eq(g, e) -> { if str_eq(g, e) == 0 { test_fail_assertion(\"assert_str_eq\") __mem_store64(st, 0) } else { 0 } resume(0) }")
  } else { 0 }
  if test_mask_has(mask, test_assertion_bit_str_ne()) == 1 {
    buf_append_str(buf, " Test.assert_str_ne(g, u) -> { if str_eq(g, u) == 1 { test_fail_assertion(\"assert_str_ne\") __mem_store64(st, 0) } else { 0 } resume(0) }")
  } else { 0 }
  if test_mask_has(mask, test_assertion_bit_snapshot()) == 1 {
    buf_append_str(buf, " Test.assert_snapshot(g, e) -> { if str_eq(g, e) == 0 { test_fail_assertion(\"snapshot\") __mem_store64(st, 0) } else { 0 } resume(0) }")
  } else { 0 }
  if test_mask_has(mask, test_assertion_bit_forall_i64_range()) == 1 {
    buf_append_str(buf, " Test.forall_i64_range(s, e, prop) -> { let mut i = s let mut seen = 0 let mut failed = 0 while i < e { seen = 1 if prop(i) { 0 } else { failed = 1 i = e } i = i + 1 } if seen == 0 { test_fail_assertion(\"forall_i64_range_empty\") __mem_store64(st, 0) } else { if failed == 1 { test_fail_assertion(\"forall_i64_range\") __mem_store64(st, 0) } else { 0 } } resume(0) }")
  } else { 0 }
  if test_mask_has(mask, test_assertion_bit_with_state_i64()) == 1 {
    buf_append_str(buf, " Test.with_state_i64(init, body) -> { let cell = __bump_alloc(8) __mem_store64(cell, init) let result = handle body() { State.get() -> resume(__mem_load64(cell)) State.put(v) -> { __mem_store64(cell, v) resume(0) } } resume(result) }")
  } else { 0 }
  if test_mask_has(mask, test_assertion_bit_expect_fail_i64()) == 1 {
    buf_append_str(buf, " Test.expect_fail_i64(expected, body) -> { let seen = __bump_alloc(16) __mem_store64(seen, 0) __mem_store64(seen + 8, 0) let result = handle body() { Fail.fail(e) -> { __mem_store64(seen, 1) __mem_store64(seen + 8, e) resume(e) } } if __mem_load64(seen) == 0 { test_fail_assertion(\"expect_fail_missing\") __mem_store64(st, 0) } else { if __mem_load64(seen + 8) != expected { test_fail_assertion(\"expect_fail_i64\") __mem_store64(st, 0) } else { 0 } } resume(if __mem_load64(seen) == 1 { __mem_load64(seen + 8) } else { result }) }")
  } else { 0 }
  if test_mask_has(mask, test_assertion_bit_with_io_i64()) == 1 {
    buf_append_str(buf, " Test.with_io_i64(body) -> { let result = handle body() { IO.read(fd, out, len) -> { if len > 0 { __mem_store8(out, 65) } else { 0 } resume(if len > 0 { 1 } else { 0 }) } IO.write(fd, data, len) -> resume(len) IO.open(path, flags, mode) -> resume(100 + flags) IO.close(fd) -> resume(0) } resume(result) }")
  } else { 0 }
  if test_mask_has(mask, test_assertion_bit_with_diagnose_i64()) == 1 {
    buf_append_str(buf, " Test.with_diagnose_i64(body) -> { let result = handle body() { Diagnose.error(msg, span) -> resume(1) Diagnose.warn(msg, span) -> resume(2) Diagnose.note(msg, span) -> resume(3) } resume(result) }")
  } else { 0 }
  buf_len(buf)
}

fn run_test() -> i64 {
  -- Prepend the Test effect to the user source so Test operations are in the
  -- SAME source buffer as the tests that call them.
  let prefix = "effect State { fn get() -> i64 fn put(v: i64) -> i64 } effect Fail { fn fail(error: i64) -> i64 } effect IO { fn read(fd: i64, buf: i64, len: i64) -> i64 fn write(fd: i64, buf: i64, len: i64) -> i64 fn open(path: i64, flags: i64, mode: i64) -> i64 fn close(fd: i64) -> i64 } effect Diagnose { fn error(msg: str, span: i64) -> i64 fn warn(msg: str, span: i64) -> i64 fn note(msg: str, span: i64) -> i64 } effect Test { fn assert_eq(got: i64, expected: i64) -> i64 fn assert_ne(got: i64, unexpected: i64) -> i64 fn assert_true(value: bool) -> i64 fn assert_false(value: bool) -> i64 fn assert_lt(left: i64, right: i64) -> i64 fn assert_le(left: i64, right: i64) -> i64 fn assert_gt(left: i64, right: i64) -> i64 fn assert_ge(left: i64, right: i64) -> i64 fn assert_str_eq(got: str, expected: str) -> i64 fn assert_str_ne(got: str, unexpected: str) -> i64 fn assert_snapshot(got: str, expected: str) -> i64 fn forall_i64_range(start: i64, end: i64, property: (i64) -> bool) -> i64 fn with_state_i64(initial: i64, body: () -[State]> i64) -> i64 fn expect_fail_i64(expected: i64, body: () -[Fail]> i64) -> i64 fn with_io_i64(body: () -[IO]> i64) -> i64 fn with_diagnose_i64(body: () -[Diagnose]> i64) -> i64 } "
  let prefix_len = __str_len(prefix)
  let raw_input = read_stdin_all()
  let raw = __mem_load64(raw_input)
  let raw_n = __mem_load64(raw_input + 8)
  let src = alloc_bump(prefix_len + raw_n + 1)
  mem_copy(src, __str_ptr(prefix), prefix_len)
  mem_copy(src + prefix_len, raw, raw_n)
  let n = prefix_len + raw_n
  let grammar = weft_grammar()
  let tt = ttable_new()
  let fns = pipeline_parse(grammar, src, n, tt)
  -- Separate tests from regular functions
  let regular = nlist_new()
  let tests = nlist_new()
  let nfns = nlist_len(fns)
  for i in 0..nfns {
    let pair = nlist_get(fns, i)
    if node_f4(pair) == 1 {
      nlist_add(tests, pair)
    } else {
      nlist_add(regular, pair)
    }
  }
  let ntests = nlist_len(tests)
  if ntests == 0 {
    eprint("test: no test blocks found\n")
    0
  } else {
    -- Convert each test block into a wrapper function with t_ prefix
    -- to avoid keyword collisions (e.g., test "while" -> fn t_while)
    let test_effects = effect_sig_one(effect_name_hash(__str_ptr("Test"), 0, 4))
    for ti in 0..ntests {
      let pair = nlist_get(tests, ti)
      let test_node = node_f1(pair)
      let test_src = node_f2(pair)
      let name_ns = node_f1(test_node)
      let name_nl = node_f2(test_node)
      let body = node_f3(test_node)
      -- Create a prefixed name in a scratch buffer
      -- Prefix with "t_" (NOT "__t_" — double underscore is reserved for intrinsics)
      let pname = alloc_bump(name_nl + 2)
      __mem_store8(pname, 116)    -- t
      __mem_store8(pname + 1, 95) -- _
      mem_copy(pname + 2, test_src + name_ns, name_nl)
      let fn_inner = node_new(8, pname - test_src, name_nl + 2, nlist_new(), body)
      let fn_wrap = node_new(23, fn_inner, 0, test_effects, 0)
      let fn_pair = node_new(0, fn_wrap, test_src, 0, 0)
      nlist_add(regular, fn_pair)
    }
    -- Build harness: one handle block wrapping a run_all function
    -- This avoids generating N handle blocks (which blow the stack)
    let assertion_mask = test_mask_merge(test_assertions_mask_tests(tests, ntests), test_assertions_mask_functions(regular, nlist_len(regular), src))
    let harness_buf = buf_new(65536)
    let mut hp = 0
    -- Test effect already declared in prepended user source
    hp = buf_append_str(harness_buf, "use \"runtime/syscall.weft\" use \"stdlib/string.weft\" fn test_fail_assertion(name: str) -> i64 { sys_write(2, __str_ptr(\"test assertion failed: \"), __str_len(\"test assertion failed: \")) sys_write(2, __str_ptr(name), __str_len(name)) sys_write(2, __str_ptr(\"\\n\"), 1) 0 } ")
    -- run_all: calls each test, uses heap cell per test to track pass/fail
    hp = buf_append_str(harness_buf, "fn run_all(st: i64) -[Test]> i64 { let mut p = 0 let mut f = 0 ")
    for ti in 0..ntests {
      let pair = nlist_get(tests, ti)
      let test_node = node_f1(pair)
      let test_src = node_f2(pair)
      let name_ns = node_f1(test_node)
      let name_nl = node_f2(test_node)
      -- Reset state cell, call test wrapper (prefixed t_ to avoid keyword collisions)
      hp = buf_append_str(harness_buf, "__mem_store64(st, 1) t_")
      hp = buf_append_bytes(harness_buf, test_src + name_ns, name_nl)
      hp = buf_append_str(harness_buf, "() if __mem_load64(st) == 1 { p = p + 1 } else { f = f + 1 } ")
    }
    hp = buf_append_str(harness_buf, "f } ")
    -- Main: install ONE handler, call run_all inside it
    hp = buf_append_str(harness_buf, "fn main() -> i64 { let st = __bump_alloc(8) handle run_all(st) {")
    hp = test_append_handler_clauses(harness_buf, assertion_mask)
    hp = buf_append_str(harness_buf, " } }")
    let harness_src = buf_ptr(harness_buf)
    -- Parse the harness source through the same parse pass boundary
    let harness_fns = pipeline_parse(grammar, harness_src, hp, tt)
    -- Merge harness main into regular fns
    let hn = nlist_len(harness_fns)
    for hi in 0..hn {
      nlist_add(regular, nlist_get(harness_fns, hi))
    }
    -- Bind runtime prelude after synthesizing the harness: the harness itself
    -- uses handlers/closures even when the user test source is pure.
    pipeline_bind_runtime_preludes(regular, src, tt)
    -- Type check
    let typed = pipeline_check_fns(regular, src, tt)
    -- Compile
    let binary = pipeline_emit_native(typed)
    pipeline_write_binary(binary)
  }
}

-- Copy a string literal to a buffer, return new position
fn buf_append_str(b: i64, s: str) -> i64 {
  bstr(b, s)
  buf_len(b)
}

fn buf_append_bytes(b: i64, p: i64, n: i64) -> i64 {
  bscopy(b, p, n, 0)
  buf_len(b)
}

-- File discovery mode (weft test test/*.weft) is in run_tests.sh.
-- The compiler can't call posix_spawn directly (it's a static binary).
-- User programs that need process spawning emit .o files and link via ld.

-- Unused: kept for stdlib/process.weft compatibility
fn make_cstr(s: str) -> i64 {
  let p = __str_ptr(s)
  let l = __str_len(s)
  let buf = alloc_bump(l + 1)
  mem_copy(buf, p, l)
  __mem_store8(buf + l, 0)
  buf
}

fn cstr_copy_to(dst: i64, pos: i64, src: i64) -> i64 {
  let mut i = 0
  while __mem_load8(src + i) != 0 {
    __mem_store8(dst + pos + i, __mem_load8(src + i))
    i = i + 1
  }
  pos + i
}

-- File discovery (weft test test/*.weft) is handled by run_tests.sh.
-- User programs that need posix_spawn use the .o + ld pipeline.
