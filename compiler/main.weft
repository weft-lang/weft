-- Weft compiler — Layer 1
-- Milestone 1: minimal compiler that handles fn main() -> i64 { N }

-- ── Syscall wrappers ────────────────────────────────────────────────

fn sys_exit(code: i64) -> i64 {
  __syscall(1, code, 0, 0, 0, 0, 0)
}

fn sys_write(fd: i64, buf: i64, len: i64) -> i64 {
  __syscall(4, fd, buf, len, 0, 0, 0)
}

-- ── String helpers ──────────────────────────────────────────────────

fn print(msg: str) -> i64 {
  let ptr = __str_ptr(msg)
  let len = __str_len(msg)
  sys_write(1, ptr, len)
}

-- ── Entry point ─────────────────────────────────────────────────────

fn main() -> i64 {
  print("weft compiler v0")
  0
}
