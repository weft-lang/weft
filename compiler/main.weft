    )
    |> main_push(
      "remat_large_const_uses",
      JsonNumber(pipeline_native_remat_probe_count(native, 3))
    )
    |> main_push(
      "remat_movn_const_defs",
      JsonNumber(pipeline_native_remat_probe_count(native, 4))
    )
    |> main_push(
      "remat_movn_const_uses",
      JsonNumber(pipeline_native_remat_probe_count(native, 5))
    )
    |> main_push("leaf_fns", JsonNumber(pipeline_native_leaf_probe_count(native, 0)))
    |> main_push("leaf_fn_pairs", JsonNumber(pipeline_native_leaf_probe_count(native, 1)))
    |> main_push("leaf_small_fns", JsonNumber(pipeline_native_leaf_probe_count(native, 2)))
    |> main_push("leaf_small_fn_pairs", JsonNumber(pipeline_native_leaf_probe_count(native, 3)))
    |> main_push(
      "crossblock_barrier_free_defs",
      JsonNumber(pipeline_native_crossblock_probe_count(native, 0))
    )
    |> main_push(
      "crossblock_barrier_free_uses",
      JsonNumber(pipeline_native_crossblock_probe_count(native, 1))
    )
  members = members
    |> main_push("residual_slotlike", JsonNumber(pipeline_native_residual_probe_count(native, 0)))
    |> main_push(
      "residual_machinery_reads",
