-- Weft compiler — Layer 1
-- Compiles Weft source with arithmetic, control flow, functions to aarch64 Mach-O
-- Usage: ./weft < compiler/main.weft > output && codesign -s - output && chmod +x output

use "compiler/codegen.weft"
use "compiler/typeck.weft"
use "compiler/macho.weft"
use "compiler/grammar.weft"
use "compiler/pipeline.weft"

-- ======================================================================
-- Main: read source, lex, parse, codegen, emit Mach-O
-- ======================================================================

fn find_main_in_fmap(fm: i64) -> i64 {
  let n = __mem_load64(fm + 8)
  let d = __mem_load64(fm)
  let mut i = 0
  let mut result = 0
  while i < n {
    let e_src = __mem_load64(d + i * 32 + 24)
    let e_ns = __mem_load64(d + i * 32)
    let e_nl = __mem_load64(d + i * 32 + 8)
    if src_eq(e_src, e_ns, e_nl, "main") == 1 {
      result = __mem_load64(d + i * 32 + 16)
      i = n
    } else { i = i + 1 }
  }
  result
}

-- Emit heap initialization startup code (mmap 64MB, store in x28)
fn emit_heap_init(code: i64) -> i64 {
  -- STP x29, x30, [sp, #-16]! (save link register to return to dyld)
  bu32(code, encode_stp_pre(29, 30, 31, 0 - 16))
  -- mmap syscall: x16 = 0x020000C5 (BSD class | 197)
  bu32(code, encode_movz(16, 197, 0))
  bu32(code, encode_movk(16, 512, 16))
  -- x0 = 0 (addr = NULL)
  bu32(code, encode_movz(0, 0, 0))
  -- x1 = 128MB = 0x8000000
  bu32(code, encode_movz(1, 0, 0))
  bu32(code, encode_movk(1, 2048, 16))
  -- x2 = 3 (PROT_READ | PROT_WRITE)
  bu32(code, encode_movz(2, 3, 0))
  -- x3 = 4098 (MAP_PRIVATE | MAP_ANON)
  bu32(code, encode_movz(3, 4098, 0))
  -- x4 = -1 (fd): MOVN x4, #0 = 0x92800004 = 2457862148
  bu32(code, encode_movn(4, 0))
  -- x5 = 0 (offset)
  bu32(code, encode_movz(5, 0, 0))
  -- SVC #0x80 = 0xD4001001 = 3556773889
  bu32(code, encode_svc())
  -- MOV x28, x0 (bump pointer = mmap result)
  bu32(code, encode_add_imm(28, 0, 0))
  -- MOV x27, #0 (handler stack = empty)
  bu32(code, encode_movz(27, 0, 0))
  code
}

-- Patch 4 bytes at position pos in code buffer
fn bytes_set_u32(code: i64, pos: i64, val: i64) -> i64 {
  let d = buf_ptr(code)
  __mem_store8(d + pos, val - val / 256 * 256)
  __mem_store8(d + pos + 1, val / 256 - val / 65536 * 256)
  __mem_store8(d + pos + 2, val / 65536 - val / 16777216 * 256)
  __mem_store8(d + pos + 3, val / 16777216 - val / 4294967296 * 256)
  0
}

-- Patch all forward BL references using final fmap
fn patch_forward_refs(fm: i64, code: i64) -> i64 {
  let pn = __mem_load64(fm + 32)
  let pd = __mem_load64(fm + 24)
  let mut i = 0
  while i < pn {
    let pos = __mem_load64(pd + i * 32)
    let ns = __mem_load64(pd + i * 32 + 8)
    let nl = __mem_load64(pd + i * 32 + 16)
    let p_src = __mem_load64(pd + i * 32 + 24)
    let target = fmap_lookup(fm, p_src, ns, nl)
    bytes_set_u32(code, pos, encode_bl(target - pos))
    i = i + 1
  }
  0
}

-- The compile pipeline: parse → check → emit
-- Each phase is a function from pipeline.weft with declared effects.
-- Tools compose different subsets with different handlers.
fn compile(src: i64, n: i64) -> i64 {
  let grammar = weft_grammar()
  let tt = ttable_new()
  let fns = grammar.parse(src, n, tt)
  pipeline_check(fns, src, tt)
  let code = buf_new(524288)
  let fm = fmap_new()
  emit_heap_init(code)
  let bl_main_pos = buf_len(code)
  bu32(code, 0)
  bu32(code, encode_ldp_post(29, 30, 31, 16))
  bu32(code, encode_ret())
  fmap_set_tt(fm, tt)
  cg_module(fns, code, fm)
  patch_forward_refs(fm, code)
  let main_off = find_main_in_fmap(fm)
  bytes_set_u32(code, bl_main_pos, encode_bl(main_off - bl_main_pos))
  let o = emit_macho(code, 0)
  sys_write(1, buf_ptr(o), buf_len(o))
  0
}

fn main() -> i64 {
  let src = __bump_alloc(131072)
  let n = sys_read(0, src, 131072)
  compile(src, n)
}
