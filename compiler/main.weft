    |> main_push("residual_call_use", JsonNumber(pipeline_native_residual_probe_count(native, 2)))
    |> main_push(
      "residual_pool_full",
      JsonNumber(pipeline_native_residual_probe_count(native, 3))
    )
    |> main_push(
      "residual_cs_exhausted",
      JsonNumber(pipeline_native_residual_probe_count(native, 4))
    )
    |> main_push("residual_use_sum", JsonNumber(pipeline_native_residual_probe_count(native, 5)))
    |> main_push("split_candidate_defs", JsonNumber(pipeline_native_split_probe_count(native, 0)))
    |> main_push("split_segment_uses", JsonNumber(pipeline_native_split_probe_count(native, 1)))
    |> main_push("split_residents", JsonNumber(pipeline_native_split_probe_count(native, 2)))
    |> main_push("fwd_only_defs", JsonNumber(pipeline_native_split_probe_count(native, 3)))
  members = members
    |> main_push("fp_residents", JsonNumber(pipeline_native_fp_resident_count(native)))
    |> main_push("register_pinned", JsonNumber(pipeline_native_register_pinned_count(native)))
    |> main_push("pinned_slots", JsonNumber(pipeline_native_ir_pinned_slot_count(native)))
    |> main_push(
      "loop_pinned_slots",
      JsonNumber(pipeline_native_ir_loop_pinned_slot_count(native))
    )
    |> main_push("cs_residents", JsonNumber(pipeline_native_ir_cs_resident_count(native)))
    |> main_push("bank_swaps", JsonNumber(pipeline_native_bank_swap_count(native)))
