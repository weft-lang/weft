-- Weft compiler — Layer 1 (Milestone 1)
-- Currently: parses fn main() -> i64 { N } and returns N as exit code
-- Next: emit Mach-O binary (blocked on seed register allocation for large functions)
-- Usage: ./weft1 < input.weft; echo $?

fn sys_read(fd: i64, buf: i64, len: i64) -> i64 {
  __syscall(3, fd, buf, len, 0, 0, 0)
}

fn scan_brace(src: i64, pos: i64, len: i64) -> i64 {
  if pos >= len { 0 }
  else {
    let ch = __mem_load8(src + pos)
    if ch == 123 { pos + 1 }
    else { scan_brace(src, pos + 1, len) }
  }
}

fn skip_ws(src: i64, pos: i64, len: i64) -> i64 {
  if pos >= len { pos }
  else {
    let ch = __mem_load8(src + pos)
    if ch <= 32 { skip_ws(src, pos + 1, len) }
    else { pos }
  }
}

fn parse_num(src: i64, pos: i64, len: i64, acc: i64) -> i64 {
  if pos >= len { acc }
  else {
    let ch = __mem_load8(src + pos)
    if ch >= 48 {
      if ch <= 57 { parse_num(src, pos + 1, len, acc * 10 + ch - 48) }
      else { acc }
    } else { acc }
  }
}

fn main() -> i64 {
  let src = __bump_alloc(4096)
  let n = sys_read(0, src, 4096)
  let after = scan_brace(src, 0, n)
  let start = skip_ws(src, after, n)
  parse_num(src, start, n, 0)
}
