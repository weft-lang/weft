fn main_alloc_bytes(size: i64) -> i64 {
  alloc_words((size + 7) / 8)
}

-- ======================================================================
-- Main: read source, lex, parse, codegen, emit Mach-O
-- ======================================================================

-- The compile pipeline: parse → check → emit
-- Each phase is a function from pipeline.weft with declared effects.
-- Tools compose different subsets with different handlers.
fn main_write_binary(binary: BinaryObject) -> i64 {
  match binary {
    BinaryObject(o, kind) -> {
      if buf_len(o) == 0 {
        eprint("compile: no binary produced\n")
        1
      } else {
        sys_write(1, buf_ptr(o), buf_len(o))
        0
      }
    }
  }
}

fn compile(src: i64, n: i64) -[SourceAcquire]> i64 {
  compile_with_origin(src, n, 0, 1)
}

fn compile_with_trust(src: i64, n: i64, trusted: i64) -[SourceAcquire]> i64 {
  compile_with_origin(src, n, trusted, pipeline_strict_for_trust(trusted))
}

fn compile_with_origin(src: i64, n: i64, trusted: i64, strict: i64) -[SourceAcquire]> i64 {
  compile_with_origin_and_grant(src, n, trusted, strict, 0)
}

fn main_decl_is_root_main(decl: Decl, src: i64) -> i64 {
  match decl {
    FnDecl(ns, nl, params, body) -> src_eq(src, ns, nl, "main")
    FnDeclWrapped(inner, ret_type, eff_sig, tparams) -> main_decl_is_root_main(inner, src)
    _ -> 0
  }
}

fn main_fns_have_root_main(fns: i64, src: i64) -> i64 {
  let nfns = nlist_len(fns)
  let mut i = 0
  while i < nfns {
    let pair = nlist_get(fns, i)
    let pair_src = node_f2(pair)
    if pair_src == src and main_decl_is_root_main(decl_from_node(node_f1(pair)), src) == 1 {
      return 1
    } else { 0 }
    i = i + 1
  }
  0
}

fn main_fns_source_count(fns: i64, src: i64) -> i64 {
  let nfns = nlist_len(fns)
  let mut count = 0
  for i in 0..nfns {
    if node_f2(nlist_get(fns, i)) == src { count = count + 1 } else { 0 }
  }
  count
}

fn main_register_source_path(tt: i64, src: i64, n: i64, path_ptr: i64, path_len: i64) -> i64 {
  -- The effect-decomposed pipeline calls Grammar.lex + parse_tokens directly,
  -- so Grammar.parse no longer performs this registration for anonymous
  -- stdin roots. Diagnostics still need the source buffer even without a
  -- physical path in order to render excerpts and primary carets.
  ttable_register_source(tt, src, n, path_ptr, path_len)
  if path_len > 0 {
    -- A path-aware root is a package graph node even when the root source has
    -- no imports. This makes manifest exports and L7 package identity facts
    -- available to every path-form command, not only as an import side effect.
    pkg_identity_register_root(tt, pkg_manifest_load_default_for_table(tt))
    0
  } else { 0 }
}

fn main_check_source_with_path_and_origin_and_grant(src: i64, n: i64, path_ptr: i64, path_len: i64, trusted: i64, strict: i64, can_grant_trust: i64) -[SourceAcquire]> TypedModule {
  let grammar = weft_grammar()
  let tt = ttable_new()
  main_mark_root_origin_with_grant(tt, src, trusted, strict, can_grant_trust)
  main_register_source_path(tt, src, n, path_ptr, path_len)
  let ast = pipeline_parse_module(grammar, src, n, tt)
  match ast {
    AstModule(fns, ast_src, ast_tt) -> {
      pipeline_bind_runtime_preludes(fns, ast_src, ast_tt)
      pipeline_check_module(ast)
    }
  }
}

fn main_check_source_with_origin_and_grant(src: i64, n: i64, trusted: i64, strict: i64, can_grant_trust: i64) -[SourceAcquire]> TypedModule {
  main_check_source_with_path_and_origin_and_grant(src, n, 0, 0, trusted, strict, can_grant_trust)
}

type MainNativePreparation {
  MainNativePrepared(NativeModule),
  MainNativePreparationFailed(i64)
}

-- Compile and build are two Emit handlers over this one checked/lowered
-- product. The build handler retains the native link plan while the compile
-- handler writes the relocatable object to stdout.
fn main_prepare_native_for_target_with_path_and_origin_and_grant(src: i64, n: i64, path_ptr: i64, path_len: i64, trusted: i64, strict: i64, can_grant_trust: i64, target: NativeLinkTarget) -[SourceAcquire]> MainNativePreparation {
  let grammar = weft_grammar()
  let tt = ttable_new()
  ttable_set_native_compilation_target(tt, native_link_target_storage_kind(target))
  main_mark_root_origin_with_grant(tt, src, trusted, strict, can_grant_trust)
  main_register_source_path(tt, src, n, path_ptr, path_len)
  let parsed = pipeline_parse_with_error_count(grammar, src, n, tt)
  match parsed {
    PipelineParseResult(fns, parse_errors) -> {
      if parse_errors != 0 {
        eprint("compile: parse failed with ")
        eprint_i(parse_errors)
        eprint(" errors\n")
        MainNativePreparationFailed(1)
      } else {
      pipeline_bind_native_runtime_preludes(fns, src, tt)
      let errors = pipeline_check_fns_error_count(fns, src, tt)
      if errors != 0 {
        eprint("compile: type check failed with ")
        eprint_i(errors)
        eprint(" errors\n")
        MainNativePreparationFailed(1)
      } else {
        if main_fns_have_root_main(fns, src) != 1 {
          eprint("compile: missing main function\n")
          MainNativePreparationFailed(1)
        } else {
          -- The error-count pass above IS the check: both entries run the
          -- same pipeline_check with the same rendering handlers, and
          -- TypedModule is the same (fns, src, tt) triple — re-checking
          -- here re-did every declaration for nothing (~258 MB and a full
          -- checker pass per self-compile).
          let typed = TypedModule(fns, src, tt)
          let ir = pipeline_lower_ir(typed)
          let optimised = pipeline_optimise_typed_ir(typed, ir)
          MainNativePrepared(pipeline_lower_native_module_for_target_closed(typed, optimised, target))
        }
      }
      }
    }
  }
}

fn main_prepare_native_with_path_and_origin_and_grant(src: i64, n: i64, path_ptr: i64, path_len: i64, trusted: i64, strict: i64, can_grant_trust: i64) -[SourceAcquire]> MainNativePreparation {
  main_prepare_native_for_target_with_path_and_origin_and_grant(
    src,
    n,
    path_ptr,
    path_len,
    trusted,
    strict,
    can_grant_trust,
    native_link_target_host()
  )
}

fn compile_with_path_and_origin_and_grant(src: i64, n: i64, path_ptr: i64, path_len: i64, trusted: i64, strict: i64, can_grant_trust: i64) -[SourceAcquire]> i64 {
  match main_prepare_native_with_path_and_origin_and_grant(src, n, path_ptr, path_len, trusted, strict, can_grant_trust) {
    MainNativePreparationFailed(status) -> status
    MainNativePrepared(native) -> main_write_binary(pipeline_emit_checked_native_binary(native, src))
  }
}

fn main_rc_reclamation_site_report(census: i64) -> i64 {
  eprint("WEFT_RC_SITE_CENSUS 1")
  for i in 0..9 { eprint(" ") eprint_i(pipeline_rc_site_census_get(census, i)) }
  eprint(" ") eprint_i(pipeline_rc_site_census_total(census)) eprint("\n")
  eprint("rc site census: counted=") eprint_i(pipeline_rc_site_census_get(census, 0))
  eprint(" stack_inline=") eprint_i(pipeline_rc_site_census_get(census, 1))
  eprint(" region=") eprint_i(pipeline_rc_site_census_get(census, 2))
  eprint(" arena=") eprint_i(pipeline_rc_site_census_get(census, 3))
  eprint(" reuse=") eprint_i(pipeline_rc_site_census_get(census, 4))
  eprint(" unique=") eprint_i(pipeline_rc_site_census_get(census, 5))
  eprint(" owned=") eprint_i(pipeline_rc_site_census_get(census, 6))
  eprint(" frozen=") eprint_i(pipeline_rc_site_census_get(census, 7))
  eprint(" promotion_boundaries=") eprint_i(pipeline_rc_site_census_get(census, 8))
  eprint(" total=") eprint_i(pipeline_rc_site_census_total(census)) eprint("\n")
}

fn main_write_native_product_stdout(product: PipelineNativeProduct) -> i64 {
  match product {
    PipelineNativeProductFailed(binary) -> main_write_binary(binary)
    PipelineNativeProductReady(binary, facts) -> main_write_binary(binary)
  }
}

-- Compile an instrumented artifact without changing the ordinary compiler
-- configuration. The static class distribution is reported by this process;
-- the emitted program reports its exact dynamic helper-entry vector at exit.
fn compile_with_path_and_origin_and_grant_rc_census(src: i64, n: i64, path_ptr: i64, path_len: i64, trusted: i64, strict: i64, can_grant_trust: i64) -[SourceAcquire]> i64 {
  let grammar = weft_grammar()
  let tt = ttable_new()
  main_mark_root_origin_with_grant(tt, src, trusted, strict, can_grant_trust)
  main_register_source_path(tt, src, n, path_ptr, path_len)
  let parsed = pipeline_parse_with_error_count(grammar, src, n, tt)
  match parsed {
    PipelineParseResult(fns, parse_errors) -> {
      if parse_errors != 0 {
        eprint("compile: parse failed with ") eprint_i(parse_errors) eprint(" errors\n")
        1
      } else {
        pipeline_bind_native_runtime_preludes(fns, src, tt)
        pipeline_bind_rc_census_prelude(fns, src, tt)
        let errors = pipeline_check_fns_error_count(fns, src, tt)
        if errors != 0 {
          eprint("compile: type check failed with ") eprint_i(errors) eprint(" errors\n")
          1
        } else { if main_fns_have_root_main(fns, src) != 1 {
          eprint("compile: missing main function\n")
          1
        } else {
          let typed = TypedModule(fns, src, tt)
          let ir = pipeline_lower_ir(typed)
          let optimised = pipeline_optimise_typed_ir(typed, ir)
          let native = pipeline_lower_native_module_with_audit(typed, optimised, 2)
          let census = pipeline_rc_reclamation_site_census(optimised, native)
          main_rc_reclamation_site_report(census)
          main_write_native_product_stdout(
            pipeline_checked_native_product(native, src, PipelineNativeDebugInformationIncluded)
          )
        } }
      }
    }
  }
}

fn main_compile_elapsed_millis(start: i64, finish: i64) -> i64 {
  if start < 0 or finish < start { 0 } else { finish - start }
}

fn main_compile_report_metrics(source_millis: i64, parse_millis: i64, check_millis: i64, lower_millis: i64, optimise_millis: i64, native_millis: i64, package_millis: i64, write_millis: i64, total_millis: i64, checked_functions: i64, ir_functions: i64, native_functions: i64) -> i64 {
  eprint("WEFT_COMPILE_METRICS 1 ")
  eprint_i(source_millis) eprint(" ")
  eprint_i(parse_millis) eprint(" ")
  eprint_i(check_millis) eprint(" ")
  eprint_i(lower_millis) eprint(" ")
  eprint_i(optimise_millis) eprint(" ")
  eprint_i(native_millis) eprint(" ")
  eprint_i(package_millis) eprint(" ")
  eprint_i(write_millis) eprint(" ")
  eprint_i(total_millis) eprint(" ")
  eprint_i(checked_functions) eprint(" ")
  eprint_i(ir_functions) eprint(" ")
  eprint_i(native_functions) eprint("\n")
  eprint("compile metrics: total_ms=") eprint_i(total_millis)
  eprint(" source_ms=") eprint_i(source_millis)
  eprint(" parse_ms=") eprint_i(parse_millis)
  eprint(" check_ms=") eprint_i(check_millis)
  eprint(" lower_ms=") eprint_i(lower_millis)
  eprint(" optimise_ms=") eprint_i(optimise_millis)
  eprint(" native_ms=") eprint_i(native_millis)
  eprint(" package_ms=") eprint_i(package_millis)
  eprint(" write_ms=") eprint_i(write_millis)
  eprint(" checked_functions=") eprint_i(checked_functions)
  eprint(" ir_functions=") eprint_i(ir_functions)
  eprint(" native_functions=") eprint_i(native_functions)
  eprint("\n")
}

-- Measurement is an explicit tool composition over the ordinary compiler
-- stages. Binary bytes remain on stdout; the versioned ledger goes to stderr.
fn compile_with_path_and_origin_and_grant_metrics(src: i64, n: i64, path_ptr: i64, path_len: i64, trusted: i64, strict: i64, can_grant_trust: i64, source_millis: i64) -[SourceAcquire]> i64 {
  let started = main_test_now_millis()
  let grammar = weft_grammar()
  let tt = ttable_new()
  main_mark_root_origin_with_grant(tt, src, trusted, strict, can_grant_trust)
  main_register_source_path(tt, src, n, path_ptr, path_len)
  let parse_started = main_test_now_millis()
  let parsed = pipeline_parse_with_error_count(grammar, src, n, tt)
  let parse_finished = main_test_now_millis()
  match parsed {
    PipelineParseResult(fns, parse_errors) -> {
      if parse_errors != 0 {
        eprint("compile: parse failed with ")
        eprint_i(parse_errors)
        eprint(" errors\n")
        1
      } else {
        pipeline_bind_native_runtime_preludes(fns, src, tt)
        let check_started = main_test_now_millis()
        let errors = pipeline_check_fns_error_count(fns, src, tt)
        let check_finished = main_test_now_millis()
        if errors != 0 {
          eprint("compile: type check failed with ")
          eprint_i(errors)
          eprint(" errors\n")
          1
        } else { if main_fns_have_root_main(fns, src) != 1 {
          eprint("compile: missing main function\n")
          1
        } else {
          let typed = TypedModule(fns, src, tt)
          let lower_started = main_test_now_millis()
          let ir = pipeline_lower_ir(typed)
          let lower_finished = main_test_now_millis()
          let optimise_started = main_test_now_millis()
          let optimised = pipeline_optimise_typed_ir(typed, ir)
          let optimise_finished = main_test_now_millis()
          let native_started = main_test_now_millis()
          let native = pipeline_lower_native_module_closed(typed, optimised)
          let native_finished = main_test_now_millis()
          let package_started = main_test_now_millis()
          let binary = pipeline_emit_checked_native_binary(native, src)
          let package_finished = main_test_now_millis()
          let write_started = main_test_now_millis()
          let status = main_write_binary(binary)
          let finished = main_test_now_millis()
          main_compile_report_metrics(
            source_millis,
            main_compile_elapsed_millis(parse_started, parse_finished),
            main_compile_elapsed_millis(check_started, check_finished),
            main_compile_elapsed_millis(lower_started, lower_finished),
            main_compile_elapsed_millis(optimise_started, optimise_finished),
            main_compile_elapsed_millis(native_started, native_finished),
            main_compile_elapsed_millis(package_started, package_finished),
            main_compile_elapsed_millis(write_started, finished),
            source_millis + main_compile_elapsed_millis(started, finished),
            nlist_len(fns),
            ir_function_list_len(pipeline_ir_functions(optimised)),
            pipeline_native_function_count(native)
          )
          status
        } }
      }
    }
  }
}

fn compile_with_origin_and_grant(src: i64, n: i64, trusted: i64, strict: i64, can_grant_trust: i64) -[SourceAcquire]> i64 {
  compile_with_path_and_origin_and_grant(src, n, 0, 0, trusted, strict, can_grant_trust)
}

-- Read a null-terminated C string length
fn cstr_len(ptr: i64) -> i64 {
  let mut i = 0
  while mem_load8_at(ptr, i) != 0 { i = i + 1 }
  i
}

-- Compare C string at ptr with Weft string literal
fn cstr_eq(ptr: i64, s: str) -> i64 {
  let sptr = __str_ptr(s)
  let slen = __str_len(s)
  let clen = cstr_len(ptr)
  if clen != slen { 0 }
  else { src_eq_at(ptr, 0, sptr, 0, slen) }
}

fn cpath_file_pair(path: i64, len: i64) -> i64 {
  let pair = main_alloc_bytes(16)
  mem_store64_at(pair, 0, path)
  mem_store64_at(pair, 8, len)
  pair
}

fn read_cpath_file(path: i64, len: i64) -> i64 {
  read_file(cpath_file_pair(path, len))
}

fn cpath_is_trusted_source(path: i64, len: i64) -> i64 {
  source_trust_path_is_trusted_root(path, len)
}

fn cpath_is_strict_source(path: i64, len: i64) -> i64 {
  if cpath_is_trusted_source(path, len) == 1 { 0 } else { 1 }
}

fn cpath_can_grant_import_trust(path: i64, len: i64) -> i64 {
  source_trust_path_can_grant_import_trust(path, len)
}

fn compile_path(path: i64) -[SourceAcquire]> i64 {
  let len = cstr_len(path)
  let file = read_cpath_file(path, len)
  let src = mem_load64_at(file, 0)
  let n = mem_load64_at(file, 8)
  if n <= 0 {
    eprint("compile: could not read input file\n")
    1
  } else {
    compile_with_path_and_origin_and_grant(src, n, path, len, cpath_is_trusted_source(path, len), cpath_is_strict_source(path, len), cpath_can_grant_import_trust(path, len))
  }
}

fn main_executable_kind_for_target(target: NativeLinkTarget) -> i64 {
  match target {
    NativeLinkMacosAarch64 -> pipeline_binary_kind_macho_executable()
    NativeLinkLinuxAarch64 -> pipeline_binary_kind_elf_executable()
  }
}

fn main_host_executable_kind() -> i64 {
  main_executable_kind_for_target(native_link_target_host())
}

fn main_build_write_product(binary: BinaryObject, output_path: i64, target: NativeLinkTarget) -> i64 {
  match binary {
    BinaryObject(bytes, kind) -> {
      if buf_len(bytes) == 0 {
        eprint("build: no object produced\n")
        1
      } else {
        if kind == main_executable_kind_for_target(target) {
          let fd = sys_open_write_create_truncate(output_path, 448)
          let write_status = if fd < 0 { 0 - fd }
          else {
            let status = main_test_write_all(fd, buf_ptr(bytes), buf_len(bytes))
            sys_close(fd)
            status
          }
          if write_status != 0 {
            eprint("build: could not write native-linked executable\n")
            1
          } else { 0 }
        } else {
          eprint("build: native linker did not produce the host-target executable format\n")
          1
        }
      }
    }
  }
}

fn main_build_write_product_result(product: PipelineNativeProduct, output_path: i64, facts_path: i64, target: NativeLinkTarget) -> i64 {
  match product {
    PipelineNativeProductFailed(binary) -> main_build_write_product(binary, output_path, target)
    PipelineNativeProductReady(binary, facts) -> {
      let product_status = main_build_write_product(binary, output_path, target)
      if product_status != 0 or facts_path == 0 { product_status }
      else {
        let rendered = pipeline_native_artifact_facts_render(facts)
        let fd = sys_open_write_create_truncate(facts_path, 420)
        let write_status = if fd < 0 { 0 - fd }
        else {
          let status = main_test_write_all(fd, __str_ptr(rendered), __str_len(rendered))
          sys_close(fd)
          status
        }
        if write_status != 0 {
          eprint("build: could not write artifact facts\n")
          1
        } else { 0 }
      }
    }
  }
}

fn main_build_path(path: i64, output_path: i64, facts_path: i64, debug_mode: PipelineNativeDebugMode, target: NativeLinkTarget, envp: i64) -[SourceAcquire]> i64 {
  let len = cstr_len(path)
  let file = read_cpath_file(path, len)
  let src = mem_load64_at(file, 0)
  let n = mem_load64_at(file, 8)
  if n <= 0 {
    eprint("build: could not read input file\n")
    1
  } else {
    match main_prepare_native_for_target_with_path_and_origin_and_grant(src, n, path, len, cpath_is_trusted_source(path, len), cpath_is_strict_source(path, len), cpath_can_grant_import_trust(path, len), target) {
      MainNativePreparationFailed(status) -> status
      MainNativePrepared(native) -> main_build_write_product_result(pipeline_checked_native_product(native, src, debug_mode), output_path, facts_path, target)
    }
  }
}

fn main_target_argument(value: i64) -> NativeLinkTargetParse {
  runtime_str_from_bytes_copy(value, cstr_len(value))
    |> native_link_target_parse
}

type MainBuildInput {
  MainBuildPath(i64),
  MainBuildTarget(str)
}

type MainBuildOptions {
  MainBuildOptionsReady(MainBuildInput, i64, i64, PipelineNativeDebugMode, NativeLinkTarget),
  MainBuildOptionsInvalid
}

fn main_build_options(argc: i64, argv: i64) -> MainBuildOptions {
  let mut positional = 0
  let mut output_path = 0
  let mut facts_path = 0
  let mut debug_mode = PipelineNativeDebugInformationIncluded
  let mut target = native_link_target_host()
  let mut saw_output = false
  let mut saw_facts = false
  let mut saw_strip = false
  let mut saw_target = false
  let mut valid = true
  let mut index = 2
  while index < argc and valid {
    let option = mem_load64_at(argv, index * 8)
    if cstr_eq(option, "-o") == 1 {
      if saw_output or index + 1 >= argc { valid = false }
      else {
        output_path = mem_load64_at(argv, (index + 1) * 8)
        saw_output = true
        index = index + 2
      }
    } else { if cstr_eq(option, "--artifact-facts") == 1 {
      if saw_facts or index + 1 >= argc { valid = false }
      else {
        facts_path = mem_load64_at(argv, (index + 1) * 8)
        saw_facts = true
        index = index + 2
      }
    } else { if cstr_eq(option, "--strip-debug") == 1 {
      if saw_strip { valid = false }
      else {
        debug_mode = PipelineNativeDebugInformationStripped
        saw_strip = true
        index = index + 1
      }
    } else { if cstr_eq(option, "--target") == 1 {
      if saw_target or index + 1 >= argc { valid = false }
      else {
        match main_target_argument(mem_load64_at(argv, (index + 1) * 8)) {
          NativeLinkTargetParsed(selected) -> {
            target = selected
            saw_target = true
            index = index + 2
          }
          NativeLinkTargetUnsupported -> { valid = false }
        }
      }
    } else {
      if main_cstr_starts_with(option, "-") == 1 or positional != 0 { valid = false }
      else {
        positional = option
        index = index + 1
      }
    } } } }
  }
  if valid == false { MainBuildOptionsInvalid }
  else { if saw_output {
    if positional == 0 { MainBuildOptionsInvalid }
    else { MainBuildOptionsReady(MainBuildPath(positional), output_path, facts_path, debug_mode, target) }
  } else {
    if saw_facts { MainBuildOptionsInvalid }
    else {
      let selected = if positional == 0 { "" } else { runtime_str_from_bytes_copy(positional, cstr_len(positional)) }
      MainBuildOptionsReady(MainBuildTarget(selected), 0, 0, debug_mode, target)
    }
  } }
}

type MainProjectBinarySelection {
  MainProjectBinaryReady(str, str), -- name, source
  MainProjectBinaryFailed(i64)
}

fn main_project_binary(command: str, requested: str) -> MainProjectBinarySelection {
  let manifest = pkg_manifest_load_default()
  if pkg_manifest_package_len(manifest) <= 0 {
    eprint(command)
    eprint(": missing weft.pkg package identity\n")
    MainProjectBinaryFailed(1)
  } else { if pkg_manifest_error_count(manifest) > 0 {
    eprint(command)
    eprint(": malformed weft.pkg\n")
    MainProjectBinaryFailed(1)
  } else {
    match pkg_manifest_select_target(manifest, requested) {
      PackageTargetSelected(target) -> match target {
        PackageBinaryTarget(name, source) -> MainProjectBinaryReady(name, source)
        PackageLibraryTarget(name, source) -> {
          eprint(command)
          eprint(": target '")
          eprint(name)
          eprint("' is a source library, not an executable\n")
          MainProjectBinaryFailed(2)
        }
      }
      PackageTargetMissing -> {
        eprint(command)
        if __str_len(requested) == 0 {
          eprint(": manifest has no binary target\n")
        } else {
          eprint(": unknown target '")
          eprint(requested)
          eprint("'\n")
        }
        MainProjectBinaryFailed(2)
      }
      PackageTargetAmbiguous -> {
        eprint(command)
        eprint(": multiple binary targets; name one explicitly\n")
        MainProjectBinaryFailed(2)
      }
    }
  } }
}

fn main_directory_exists(path: str) -> bool {
  let stat = alloc_zeroed(sys_stat_scratch_size())
  if sys_stat_follow(runtime_str_cstring(path), stat) < 0 { false }
  else { (sys_stat_mode(stat) band 61440) == 16384 }
}

fn main_ensure_directory(path: str) -> bool {
  if main_directory_exists(path) { true }
  else {
    sys_dir_mkdir(runtime_str_cstring(path), 493)
    main_directory_exists(path)
  }
}

fn main_named_target_directory(target: NativeLinkTarget) -> str {
  str_concat("target/", native_link_target_name(target))
}

fn main_named_target_output(name: str, target: NativeLinkTarget) -> str {
  main_named_target_directory(target)
    |> str_concat("/")
    |> str_concat(name)
}

fn main_build_named(name: str, debug_mode: PipelineNativeDebugMode, target: NativeLinkTarget, envp: i64) -[SourceAcquire]> i64 {
  match main_project_binary("build", name) {
    MainProjectBinaryFailed(status) -> status
    MainProjectBinaryReady(target_name, source) -> {
      let platform_directory = main_named_target_directory(target)
      if main_ensure_directory("target") == false or main_ensure_directory(platform_directory) == false {
        eprint("build: could not create target directory\n")
        1
      } else {
        let output = main_named_target_output(target_name, target)
        let facts = str_concat(output, ".facts.json")
        let status = main_build_path(
          runtime_str_cstring(source),
          runtime_str_cstring(output),
          runtime_str_cstring(facts),
          debug_mode,
          target,
          envp
        )
        if status == 0 {
          oprint(output)
          oprint("\n")
        } else { 0 }
        status
      }
    }
  }
}

type MainRunInput {
  MainRunPath(i64),
  MainRunTarget(str)
}

type MainRunOptions {
  MainRunOptionsReady(MainRunInput, i64), -- input, first product argument
  MainRunOptionsInvalid
}

fn main_cstr_is_source_path(value: i64) -> bool {
  let len = cstr_len(value)
  let mut index = 0
  let mut slash = false
  while index < len and slash == false {
    if mem_load8_at(value, index) == 47 { slash = true } else { index = index + 1 }
  }
  slash or (len >= 5 and src_eq_at(value, len - 5, __str_ptr(".weft"), 0, 5) == 1)
}

fn main_run_options(argc: i64, argv: i64) -> MainRunOptions {
  if argc == 2 { MainRunOptionsReady(MainRunTarget(""), argc) }
  else {
    let input = mem_load64_at(argv, 16)
    if cstr_eq(input, "--") == 1 {
      MainRunOptionsReady(MainRunTarget(""), 3)
    } else {
      let selected = if main_cstr_is_source_path(input) {
        MainRunPath(input)
      } else { MainRunTarget(runtime_str_from_bytes_copy(input, cstr_len(input))) }
      if argc == 3 { MainRunOptionsReady(selected, argc) }
      else { if cstr_eq(mem_load64_at(argv, 24), "--") == 1 {
        MainRunOptionsReady(selected, 4)
      } else { MainRunOptionsInvalid } }
    }
  }
}

type MainRunMaterialization {
  MainRunMaterialized(i64),
  MainRunMaterializationFailed
}

fn main_run_temp_path(attempt: i64) -> i64 {
  let prefix = "/tmp/weft-run-"
  let pid = sys_proc_id()
  let prefix_len = __str_len(prefix)
  let len = prefix_len + main_test_decimal_len(pid) + 1 + main_test_decimal_len(attempt)
  let path = alloc_zeroed(len + 1)
  mem_copy(path, __str_ptr(prefix), prefix_len)
  let after_pid = main_test_write_decimal(path, prefix_len, pid)
  mem_store8_at(path, after_pid, 45)
  main_test_write_decimal(path, after_pid + 1, attempt)
  path
}

fn main_run_materialize_binary(binary: BinaryObject, attempt: i64) -> MainRunMaterialization {
  match binary {
    BinaryObject(bytes, kind) -> {
      if buf_len(bytes) == 0 or kind != main_host_executable_kind() {
        eprint("run: native linker did not produce a host executable\n")
        MainRunMaterializationFailed
      } else { if attempt >= 32 {
        eprint("run: could not create a private temporary executable\n")
        MainRunMaterializationFailed
      } else {
        let path = main_run_temp_path(attempt)
        let fd = sys_open_write_create_new(path, 448)
        if fd < 0 { main_run_materialize_binary(binary, attempt + 1) }
        else {
          let write_status = main_test_write_all(fd, buf_ptr(bytes), buf_len(bytes))
          let permission_status = if write_status == 0 { sys_file_chmod(fd, 448) } else { 0 }
          sys_close(fd)
          if write_status != 0 or permission_status < 0 {
            sys_remove(path)
            eprint("run: could not write a private temporary executable\n")
            MainRunMaterializationFailed
          } else { MainRunMaterialized(path) }
        }
      } }
    }
  }
}

fn main_run_materialize(product: PipelineNativeProduct) -> MainRunMaterialization {
  match product {
    PipelineNativeProductFailed(binary) -> main_run_materialize_binary(binary, 0)
    PipelineNativeProductReady(binary, facts) -> main_run_materialize_binary(binary, 0)
  }
}

fn main_run_child_argv(argc: i64, argv: i64, first_product_arg: i64, executable: i64) -> i64 {
  let argument_count = argc - first_product_arg
  let child_argv = alloc_zeroed((argument_count + 2) * 8)
  mem_store64_at(child_argv, 0, executable)
  for index in 0..argument_count {
    mem_store64_at(child_argv, (index + 1) * 8, mem_load64_at(argv, (first_product_arg + index) * 8))
  }
  child_argv
}

fn main_run_product(product: PipelineNativeProduct, argc: i64, argv: i64, first_product_arg: i64, envp: i64) -> i64 {
  match main_run_materialize(product) {
    MainRunMaterializationFailed -> 1
    MainRunMaterialized(executable) -> {
      let child_argv = main_run_child_argv(argc, argv, first_product_arg, executable)
      let child = sys_proc_fork()
      let status = if child < 0 {
        eprint("run: could not start product\n")
        1
      } else {
        if child == 0 {
          sys_proc_exec(executable, child_argv, envp)
          sys_exit(127)
          127
        } else {
          let status_ptr = alloc_zeroed(8)
          let waited = main_test_wait_blocking(child, status_ptr)
          if waited != child {
            eprint("run: could not wait for product\n")
            1
          } else { main_test_decode_wait_status(status_ptr) }
        }
      }
      sys_remove(executable)
      status
    }
  }
}

fn main_run_path(path: i64, argc: i64, argv: i64, first_product_arg: i64, envp: i64) -[SourceAcquire]> i64 {
  let len = cstr_len(path)
  let file = read_cpath_file(path, len)
  let src = mem_load64_at(file, 0)
  let n = mem_load64_at(file, 8)
  if n <= 0 {
    eprint("run: could not read input file\n")
    1
  } else {
    match main_prepare_native_for_target_with_path_and_origin_and_grant(
      src,
      n,
      path,
      len,
      cpath_is_trusted_source(path, len),
      cpath_is_strict_source(path, len),
      cpath_can_grant_import_trust(path, len),
      native_link_target_host()
    ) {
      MainNativePreparationFailed(status) -> status
      MainNativePrepared(native) -> main_run_product(
        pipeline_checked_native_product(native, src, PipelineNativeDebugInformationIncluded),
        argc,
        argv,
        first_product_arg,
        envp
      )
    }
  }
}

fn main_run_named(name: str, argc: i64, argv: i64, first_product_arg: i64, envp: i64) -[SourceAcquire]> i64 {
  match main_project_binary("run", name) {
    MainProjectBinaryFailed(status) -> status
    MainProjectBinaryReady(target_name, source) -> main_run_path(
      runtime_str_cstring(source),
      argc,
      argv,
      first_product_arg,
      envp
    )
  }
}

fn compile_path_metrics(path: i64) -[SourceAcquire]> i64 {
  let started = main_test_now_millis()
  let len = cstr_len(path)
  let file = read_cpath_file(path, len)
  let src = mem_load64_at(file, 0)
  let n = mem_load64_at(file, 8)
  let loaded = main_test_now_millis()
  if n <= 0 {
    eprint("compile: could not read input file\n")
    1
  } else {
    compile_with_path_and_origin_and_grant_metrics(
      src,
      n,
      path,
      len,
      cpath_is_trusted_source(path, len),
      cpath_is_strict_source(path, len),
      cpath_can_grant_import_trust(path, len),
      main_compile_elapsed_millis(started, loaded)
    )
  }
}

fn compile_path_rc_census(path: i64) -[SourceAcquire]> i64 {
  let len = cstr_len(path)
  let file = read_cpath_file(path, len)
  let src = mem_load64_at(file, 0)
  let n = mem_load64_at(file, 8)
  if n <= 0 {
    eprint("compile: could not read input file\n")
    1
  } else {
    compile_with_path_and_origin_and_grant_rc_census(
      src,
      n,
      path,
      len,
      cpath_is_trusted_source(path, len),
      cpath_is_strict_source(path, len),
      cpath_can_grant_import_trust(path, len)
    )
  }
}

-- Native test-runner process support stays behind sealed semantic platform
-- leaves so adding the runner does not turn the self-hosted compiler into a
-- relocatable object or expose target syscall numbers to ordinary code.
fn main_test_now_millis() -> i64 {
  let mark = alloc_bump_mark()
  let timespec = alloc_zeroed(16)
  let status = sys_time_realtime(timespec)
  let result = if status < 0 { 0 - 1 }
  else { mem_load64_at(timespec, 0) * 1000 + mem_load64_at(timespec, 8) / 1000000 }
  alloc_bump_restore_same_segment(mark)
  result
}

fn main_test_decimal_len(value: i64) -> i64 {
  if value < 10 { 1 } else { 1 + main_test_decimal_len(value / 10) }
}

fn main_test_write_decimal(dst: i64, pos: i64, value: i64) -> i64 {
  let next = if value < 10 { pos }
  else { main_test_write_decimal(dst, pos, value / 10) }
  mem_store8_at(dst, next, 48 + value - value / 10 * 10)
  next + 1
}

fn main_test_temp_path(index: i64) -> i64 {
  let prefix = "/tmp/weft-test-"
  let pid = sys_proc_id()
  let prefix_len = __str_len(prefix)
  let len = prefix_len + main_test_decimal_len(pid) + 1 + main_test_decimal_len(index)
  let path = alloc_zeroed(len + 1)
  mem_copy(path, __str_ptr(prefix), prefix_len)
  let after_pid = main_test_write_decimal(path, prefix_len, pid)
  mem_store8_at(path, after_pid, 45)
  main_test_write_decimal(path, after_pid + 1, index)
  path
}

fn main_test_result_path(index: i64) -> i64 {
  let prefix = "/tmp/weft-test-result-"
  let pid = sys_proc_id()
  let prefix_len = __str_len(prefix)
  let len = prefix_len + main_test_decimal_len(pid) + 1 + main_test_decimal_len(index)
  let path = alloc_zeroed(len + 1)
  mem_copy(path, __str_ptr(prefix), prefix_len)
  let after_pid = main_test_write_decimal(path, prefix_len, pid)
  mem_store8_at(path, after_pid, 45)
  main_test_write_decimal(path, after_pid + 1, index)
  path
}

fn main_test_metric_path(owner_pid: i64, index: i64) -> i64 {
  let prefix = "/tmp/weft-test-metric-"
  let prefix_len = __str_len(prefix)
  let len = prefix_len + main_test_decimal_len(owner_pid) + 1 + main_test_decimal_len(index)
  let path = alloc_zeroed(len + 1)
  mem_copy(path, __str_ptr(prefix), prefix_len)
  let after_pid = main_test_write_decimal(path, prefix_len, owner_pid)
  mem_store8_at(path, after_pid, 45)
  main_test_write_decimal(path, after_pid + 1, index)
  path
}

fn main_test_write_all(fd: i64, ptr: i64, len: i64) -> i64 {
  let mut offset = 0
  let mut error = 0
  while offset < len and error == 0 {
    let wrote = sys_write(fd, ptr + offset, len - offset)
    if wrote > 0 { offset = offset + wrote }
    else { error = if wrote < 0 { 0 - wrote } else { 5 } }
  }
  error
}

fn main_test_rusage_user_micros(usage: i64) -> i64 {
  mem_load64_at(usage, 0) * 1000000 + mem_load64_at(usage, 8)
}

fn main_test_rusage_system_micros(usage: i64) -> i64 {
  mem_load64_at(usage, 16) * 1000000 + mem_load64_at(usage, 24)
}

fn main_test_metrics_record_usage(metrics: i64, usage: i64) -> i64 {
  if metrics == 0 or usage == 0 { 0 }
  else {
    mem_store64_at(metrics, 32, mem_load64_at(metrics, 32) + main_test_rusage_user_micros(usage))
    mem_store64_at(metrics, 40, mem_load64_at(metrics, 40) + main_test_rusage_system_micros(usage))
    let peak = mem_load64_at(usage, 32)
    if peak > mem_load64_at(metrics, 48) { mem_store64_at(metrics, 48, peak) } else { 0 }
    peak
  }
}

fn main_test_wait_blocking_with_usage(pid: i64, status_ptr: i64, usage: i64) -> i64 {
  let mut done = 0
  let mut result = 0
  while done == 0 {
    let waited = sys_proc_wait_usage(pid, status_ptr, 0, usage)
    if waited == 0 - 4 { 0 }
    else {
      result = waited
      done = 1
    }
  }
  result
}

fn main_test_wait_blocking(pid: i64, status_ptr: i64) -> i64 {
  main_test_wait_blocking_with_usage(pid, status_ptr, 0)
}

fn main_test_decode_wait_status(status_ptr: i64) -> i64 {
  let raw = mem_load64_at(status_ptr, 0)
  let signal = raw band 127
  if signal == 0 { (raw bshr 8) band 255 } else { 128 + signal }
}

-- 256 denotes a runner timeout and 257 a spawn/wait platform error. Child
-- exit statuses remain the ordinary 0..255 range.
fn main_test_wait_with_metrics(pid: i64, timeout_millis: i64, metrics: i64) -> i64 {
  let mark = alloc_bump_mark()
  let status_ptr = alloc_zeroed(8)
  let usage = if metrics == 0 { 0 } else { alloc_zeroed(256) }
  let pause = alloc_zeroed(16)
  let start = main_test_now_millis()
  let deadline = if start < 0 { 0 - 1 } else { start + timeout_millis }
  let mut done = 0
  let mut result = 257
  while done == 0 {
    let waited = sys_proc_wait_usage(pid, status_ptr, 1, usage)
    if waited == pid {
      main_test_metrics_record_usage(metrics, usage)
      result = main_test_decode_wait_status(status_ptr)
      done = 1
    } else { if waited < 0 and waited != 0 - 4 {
      result = 257
      done = 1
    } else {
      let now = main_test_now_millis()
      if deadline >= 0 and (now < 0 or now >= deadline) {
        sys_proc_kill(pid)
        let reaped = main_test_wait_blocking_with_usage(pid, status_ptr, usage)
        if reaped == pid { main_test_metrics_record_usage(metrics, usage) } else { 0 }
        result = if reaped == pid { 256 } else { 257 }
        done = 1
      } else {
        -- The semantic sleep leaf selects Darwin libSystem or Linux nanosleep.
        mem_store64_at(pause, 0, 0)
        mem_store64_at(pause, 8, 10000000)
        sys_time_sleep(pause, 0)
      }
    } }
  }
  alloc_bump_restore_same_segment(mark)
  result
}

fn main_test_wait(pid: i64, timeout_millis: i64) -> i64 {
  main_test_wait_with_metrics(pid, timeout_millis, 0)
}

type MainTestStructuredResult {
  MainTestStructuredResult(i64, i64, i64), -- passed, failed, total
  InvalidMainTestStructuredResult
}

type MainTestWorkerMetric {
  -- Exact terminal status, compile/link/run wall milliseconds, descendant
  -- user/system microseconds, and maximum descendant resident set in bytes.
  MainTestWorkerMetric(i64, i64, i64, i64, i64, i64, i64),
  InvalidMainTestWorkerMetric
}

-- A worker prepares and compiles one root against its private fork snapshot.
-- The parent snapshot contains only immutable universal support modules.
type MainTestPreparation {
  MainTestPrepared(i64, i64, i64, i64, i64), -- fns, src, tt, wrapper bank, trusted
  MainTestPreparationComplete(i64),           -- terminal status, already diagnosed
}

type MainTestRootPlan {
  -- index, path, source, source length, exact dependency entries, pair count
  MainTestReusableRoot(i64, i64, i64, i64, i64, i64),
  MainTestUnplannedRoot(i64, i64),
}

type MainTestRootPlanList {
  MainTestRootPlanNil,
  MainTestRootPlanCons(MainTestRootPlan, MainTestRootPlanList),
}

type MainTestProjectBases {
  -- The session owns every source/AST graph referenced by the raw base tables.
  MainTestProjectBases(i64, ProjectSession),
}

fn main_test_parse_result_count(raw: i64, n: i64, pos_cell: i64, delimiter: i64) -> i64 {
  let start = mem_load64_at(pos_cell, 0)
  let mut pos = start
  let mut value = 0
  while pos < n and mem_load8_at(raw, pos) >= 48 and mem_load8_at(raw, pos) <= 57 {
    value = value * 10 + mem_load8_at(raw, pos) - 48
    pos = pos + 1
  }
  if pos == start or pos >= n or mem_load8_at(raw, pos) != delimiter {
    0 - 1
  } else {
    mem_store64_at(pos_cell, 0, pos + 1)
    value
  }
}

fn main_test_parse_result_file(path: i64) -> MainTestStructuredResult {
  let file = read_cpath_file(path, cstr_len(path))
  let raw = mem_load64_at(file, 0)
  let n = mem_load64_at(file, 8)
  let prefix = "WEFT_TEST_RESULT 1 "
  let prefix_len = __str_len(prefix)
  if n <= prefix_len or src_eq_at(raw, 0, __str_ptr(prefix), 0, prefix_len) == 0 {
    InvalidMainTestStructuredResult
  } else {
    let pos_cell = main_alloc_bytes(8)
    mem_store64_at(pos_cell, 0, prefix_len)
    let passed = main_test_parse_result_count(raw, n, pos_cell, 32)
    let failed = main_test_parse_result_count(raw, n, pos_cell, 32)
    let total = main_test_parse_result_count(raw, n, pos_cell, 10)
    if passed < 0 or failed < 0 or total < 0 or mem_load64_at(pos_cell, 0) != n or passed + failed != total {
      InvalidMainTestStructuredResult
    } else {
      MainTestStructuredResult(passed, failed, total)
    }
  }
}

fn main_test_parse_metric_file(path: i64) -> MainTestWorkerMetric {
  let file = read_cpath_file(path, cstr_len(path))
  let raw = mem_load64_at(file, 0)
  let n = mem_load64_at(file, 8)
  let prefix = "WEFT_TEST_METRIC 1 "
  let prefix_len = __str_len(prefix)
  if n <= prefix_len or src_eq_at(raw, 0, __str_ptr(prefix), 0, prefix_len) == 0 {
    InvalidMainTestWorkerMetric
  } else {
    let pos_cell = main_alloc_bytes(8)
    mem_store64_at(pos_cell, 0, prefix_len)
    let terminal_result = main_test_parse_result_count(raw, n, pos_cell, 32)
    let compile_millis = main_test_parse_result_count(raw, n, pos_cell, 32)
    let link_millis = main_test_parse_result_count(raw, n, pos_cell, 32)
    let run_millis = main_test_parse_result_count(raw, n, pos_cell, 32)
    let user_micros = main_test_parse_result_count(raw, n, pos_cell, 32)
    let system_micros = main_test_parse_result_count(raw, n, pos_cell, 32)
    let peak_rss_bytes = main_test_parse_result_count(raw, n, pos_cell, 10)
    if terminal_result < 0 or compile_millis < 0 or link_millis < 0 or run_millis < 0 or user_micros < 0 or system_micros < 0 or peak_rss_bytes < 0 or mem_load64_at(pos_cell, 0) != n {
      InvalidMainTestWorkerMetric
    } else {
      MainTestWorkerMetric(terminal_result, compile_millis, link_millis, run_millis, user_micros, system_micros, peak_rss_bytes)
    }
  }
}

fn main_test_write_metric_file(owner_pid: i64, index: i64, terminal_result: i64, metrics: i64) -> i64 {
  let start = mem_load64_at(metrics, 0)
  let finish = main_test_now_millis()
  let raw_compile_end = mem_load64_at(metrics, 8)
  let compile_end = if raw_compile_end >= start { raw_compile_end } else { finish }
  let raw_link_end = mem_load64_at(metrics, 16)
  let link_end = if raw_link_end >= compile_end { raw_link_end } else { compile_end }
  let raw_run_end = mem_load64_at(metrics, 24)
  let run_end = if raw_run_end >= link_end { raw_run_end } else { link_end }
  let compile_millis = if start < 0 or compile_end < start { 0 } else { compile_end - start }
  let link_millis = link_end - compile_end
  let run_millis = run_end - link_end
  let line = buf_new(160)
  bstr(line, "WEFT_TEST_METRIC 1 ")
  lsp_buf_append_i(line, terminal_result) bu8(line, 32)
  lsp_buf_append_i(line, compile_millis) bu8(line, 32)
  lsp_buf_append_i(line, link_millis) bu8(line, 32)
  lsp_buf_append_i(line, run_millis) bu8(line, 32)
  lsp_buf_append_i(line, mem_load64_at(metrics, 32)) bu8(line, 32)
  lsp_buf_append_i(line, mem_load64_at(metrics, 40)) bu8(line, 32)
  lsp_buf_append_i(line, mem_load64_at(metrics, 48)) bu8(line, 10)
  let path = main_test_metric_path(owner_pid, index)
  let fd = sys_open_write_create_truncate(path, 448)
  let result = if fd < 0 { 0 - fd }
  else {
    let error = main_test_write_all(fd, buf_ptr(line), buf_len(line))
    sys_close(fd)
    error
  }
  result
}

fn main_test_emit_structured_result(result: MainTestStructuredResult) -> i64 {
  match result {
    MainTestStructuredResult(passed, failed, total) -> {
      let line = buf_new(64)
      bstr(line, "WEFT_TEST_RESULT 1 ")
      lsp_buf_append_i(line, passed)
      bu8(line, 32)
      lsp_buf_append_i(line, failed)
      bu8(line, 32)
      lsp_buf_append_i(line, total)
      bu8(line, 10)
      sys_write(2, buf_ptr(line), buf_len(line))
    }
    InvalidMainTestStructuredResult -> 0
  }
}

fn main_test_consume_structured_result(result: MainTestStructuredResult, child_status: i64) -> i64 {
  match result {
    MainTestStructuredResult(passed, failed, total) -> {
      let expected_status = if failed == 0 { 0 } else { 1 }
      if child_status != expected_status {
        260
      } else {
        main_test_emit_structured_result(result)
        expected_status
      }
    }
    InvalidMainTestStructuredResult -> 260
  }
}

fn main_test_isolate_stdin() -> i64 {
  let path = "/dev/null"
  let fd = sys_open_read(__str_ptr(path))
  if fd < 0 { fd }
  else {
    -- Runner-only process setup stays local to the compiler CLI. Exporting a
    -- general runtime wrapper would add it to every generated test program's
    -- imported runtime graph and perturb whole-module semantic censuses.
    let status = if fd == 0 { 0 } else { sys_proc_dup_to(fd, 0) }
    if fd != 0 { sys_close(fd) } else { 0 }
    status
  }
}

fn main_test_native_debug_mode() -> PipelineNativeDebugMode {
  match native_link_target_host() {
    NativeLinkMacosAarch64 -> PipelineNativeDebugInformationIncluded
    -- Linux test execution is valid before ELF DWARF parity lands. Keep the
    -- runnable product quiet and stripped until 1e supplies that emitter.
    NativeLinkLinuxAarch64 -> PipelineNativeDebugInformationStripped
  }
}

-- expected_exit < 0 consumes the structured Test result sidecar. A
-- non-negative value is the legacy main-program contract and compares the
-- process status directly while retaining the same link/run isolation.
fn main_test_run_binary_with_expectation(binary: BinaryObject, envp: i64, index: i64, metrics: i64, expected_exit: i64) -> i64 {
  match binary {
    BinaryObject(bytes, kind) -> {
      let executable_kind = main_host_executable_kind()
      if kind != executable_kind {
        eprint("test: native runner cannot execute this binary format\n")
        258
      } else {
        let mark = alloc_bump_mark()
        let path = main_test_temp_path(index)
        let result_path = main_test_result_path(index)
        -- A live process cannot share our pid, so this only clears a stale file
        -- left by a crashed earlier process after pid reuse.
        sys_remove(path)
        sys_remove(result_path)
        let fd = sys_open_write_create_truncate(path, 448)
        let write_error = if fd < 0 { 0 - fd }
        else {
          let error = main_test_write_all(fd, buf_ptr(bytes), buf_len(bytes))
          let permission_status = if error == 0 { sys_file_chmod(fd, 448) } else { 0 }
          sys_close(fd)
          if error != 0 { error }
          else { if permission_status < 0 { 0 - permission_status } else { 0 } }
        }
        if metrics != 0 { mem_store64_at(metrics, 16, main_test_now_millis()) } else { 0 }
        let result = if write_error != 0 {
          259
        } else {
          let child_argv = alloc_zeroed(if expected_exit < 0 { 24 } else { 16 })
          mem_store64_at(child_argv, 0, path)
          if expected_exit < 0 { mem_store64_at(child_argv, 8, result_path) } else { 0 }
          let fork_result = sys_proc_fork()
          if fork_result < 0 { 257 }
          else {
            if fork_result == 0 {
              main_test_isolate_stdin()
              sys_proc_exec(path, child_argv, envp)
              sys_exit(127)
            } else {
              let child_status = main_test_wait_with_metrics(fork_result, main_test_run_timeout_millis(envp), metrics)
              if expected_exit >= 0 {
                if child_status == expected_exit { 0 }
                else {
                  eprint("test: legacy main exited ")
                  eprint_i(child_status)
                  eprint(", expected ")
                  eprint_i(expected_exit)
                  eprint("\n")
                  262
                }
              } else {
                if child_status == 0 or child_status == 1 {
                  main_test_consume_structured_result(main_test_parse_result_file(result_path), child_status)
                } else { child_status }
              }
            }
          }
        }
        if metrics != 0 { mem_store64_at(metrics, 24, main_test_now_millis()) } else { 0 }
        sys_remove(path)
        sys_remove(result_path)
        alloc_bump_restore_same_segment(mark)
        result
      }
    }
  }
}

fn main_test_run_binary(binary: BinaryObject, envp: i64, index: i64, metrics: i64) -> i64 {
  main_test_run_binary_with_expectation(binary, envp, index, metrics, 0 - 1)
}

fn main_test_eprint_cpath(path: i64) -> i64 {
  sys_write(2, path, cstr_len(path))
}

fn main_test_report(path: i64, result: i64, elapsed_millis: i64, peak_rss_bytes: i64) -> i64 {
  if result == 0 { eprint("  pass: ") } else { eprint("  FAIL: ") }
  main_test_eprint_cpath(path)
  eprint(" (")
  eprint_i(elapsed_millis)
  eprint(" ms")
  if result == 256 { eprint(", timeout") }
  else { if result == 261 {
    eprint(", peak RSS ")
    eprint_i((peak_rss_bytes + 1023) / 1024)
    eprint(" KB exceeded limit")
  }
  else { if result != 0 { eprint(", exit ") eprint_i(if result > 255 { 1 } else { result }) } else { 0 } }
  }
  eprint(")\n")
}

fn main_test_cpath_compare(left: i64, right: i64) -> i64 {
  let left_len = cstr_len(left)
  let right_len = cstr_len(right)
  let limit = if left_len < right_len { left_len } else { right_len }
  let mut i = 0
  let mut result = 0
  while i < limit and result == 0 {
    let a = mem_load8_at(left, i)
    let b = mem_load8_at(right, i)
    if a < b { result = 0 - 1 }
    else { if a > b { result = 1 } else { i = i + 1 } }
  }
  if result != 0 { result }
  else { if left_len < right_len { 0 - 1 }
  else { if left_len > right_len { 1 } else { 0 } } }
}

fn main_test_paths_add_sorted(paths: i64, path: i64) -> i64 {
  let n = nlist_len(paths)
  let mut insert = n
  let mut duplicate = 0
  let mut i = 0
  while i < n and insert == n and duplicate == 0 {
    let comparison = main_test_cpath_compare(path, nlist_get(paths, i))
    if comparison == 0 { duplicate = 1 }
    else { if comparison < 0 { insert = i } else { i = i + 1 } }
  }
  if duplicate == 1 { 0 }
  else {
    nlist_add(paths, path)
    let data = mem_load64_at(paths, 0)
    let mut move = n
    while move > insert {
      mem_store64_at(data, move * 8, mem_load64_at(data, (move - 1) * 8))
      move = move - 1
    }
    mem_store64_at(data, insert * 8, path)
    1
  }
}

fn main_test_copy_cpath(src: i64, len: i64) -> i64 {
  let path = main_alloc_bytes(len + 1)
  mem_copy(path, src, len)
  mem_store8_at(path, len, 0)
  path
}

fn main_test_join_path(prefix: i64, prefix_len: i64, name: i64, name_len: i64) -> i64 {
  let path = main_alloc_bytes(prefix_len + name_len + 1)
  if prefix_len > 0 { mem_copy(path, prefix, prefix_len) } else { 0 }
  mem_copy(path + prefix_len, name, name_len)
  mem_store8_at(path, prefix_len + name_len, 0)
  path
}

fn main_test_name_is_dot(name: i64, len: i64) -> i64 {
  if len == 1 and mem_load8_at(name, 0) == 46 { 1 }
  else { if len == 2 and mem_load8_at(name, 0) == 46 and mem_load8_at(name, 1) == 46 { 1 }
  else { 0 } }
}

fn main_test_name_is_weft(name: i64, len: i64) -> i64 {
  if len < 5 { 0 }
  else {
    mem_load8_at(name, len - 5) == 46 and
      mem_load8_at(name, len - 4) == 119 and
      mem_load8_at(name, len - 3) == 101 and
      mem_load8_at(name, len - 2) == 102 and
      mem_load8_at(name, len - 1) == 116
  }
}

-- Match one path segment. Shell-compatible '*' and '?' are enough here:
-- unquoted richer globs are expanded by the invoking shell before we run.
fn main_test_glob_matches(name: i64, name_len: i64, pattern: i64, pattern_len: i64) -> i64 {
  let mut ni = 0
  let mut pi = 0
  let mut star = 0 - 1
  let mut retry = 0
  let mut failed = 0
  while ni < name_len and failed == 0 {
    if pi < pattern_len and (mem_load8_at(pattern, pi) == 63 or mem_load8_at(pattern, pi) == mem_load8_at(name, ni)) {
      ni = ni + 1
      pi = pi + 1
    } else { if pi < pattern_len and mem_load8_at(pattern, pi) == 42 {
      star = pi
      pi = pi + 1
      retry = ni
    } else { if star >= 0 {
      retry = retry + 1
      ni = retry
      pi = star + 1
    } else {
      failed = 1
    } } }
  }
  while pi < pattern_len and mem_load8_at(pattern, pi) == 42 { pi = pi + 1 }
  if failed == 0 and pi == pattern_len { 1 } else { 0 }
}

fn main_test_path_has_glob(path: i64, len: i64) -> i64 {
  let mut i = 0
  let mut found = 0
  while i < len and found == 0 {
    let c = mem_load8_at(path, i)
    if c == 42 or c == 63 { found = 1 } else { i = i + 1 }
  }
  found
}

fn main_test_path_last_slash(path: i64, len: i64) -> i64 {
  let mut i = 0
  let mut slash = 0 - 1
  while i < len {
    if mem_load8_at(path, i) == 47 { slash = i } else { 0 }
    i = i + 1
  }
  slash
}

-- Returns (kind, device, inode, mode), where kind 1 is a directory and kind 2 is
-- another existing object. stat64 follows symlinks; the stable device/inode
-- identity lets recursive discovery follow useful aliases without cycles.
fn main_test_path_metadata(path: i64) -> i64 {
  let stat_buf = alloc_zeroed(sys_stat_scratch_size())
  let status = sys_stat_follow(path, stat_buf)
  if status < 0 { 0 }
  else {
    let mode = sys_stat_mode(stat_buf)
    let kind = if (mode band 61440) == 16384 { 1 } else { 2 }
    node_new(0, kind, sys_stat_device(stat_buf), sys_stat_inode(stat_buf), mode)
  }
}

fn main_test_directory_identity_add(visited: i64, metadata: i64) -> i64 {
  let device = node_f2(metadata)
  let inode = node_f3(metadata)
  let mut i = 0
  let mut duplicate = 0
  while i < nlist_len(visited) and duplicate == 0 {
    let identity = nlist_get(visited, i)
    if node_f1(identity) == device and node_f2(identity) == inode { duplicate = 1 }
    else { i = i + 1 }
  }
  if duplicate == 1 { 0 }
  else { nlist_add(visited, node_new(0, device, inode, 0, 0)) 1 }
}

fn main_test_directory_entry_name_len(entry: i64, record_len: i64) -> i64 {
  let name = sys_dir_entry_name(entry)
  let max_len = record_len - (name - entry)
  let mut len = 0
  while len < max_len and mem_load8_at(name, len) != 0 { len = len + 1 }
  if max_len > 0 and len < max_len { len } else { 0 - 1 }
}

-- pattern_len < 0 selects the directory form's canonical *.weft filter.
-- Native dirent layouts are interpreted only by semantic platform leaves.
fn main_test_collect_directory(paths: i64, dir_path: i64, prefix: i64, prefix_len: i64, pattern: i64, pattern_len: i64) -> i64 {
  let fd = sys_dir_open(dir_path)
  if fd < 0 { fd }
  else {
    let buf = main_alloc_bytes(16384)
    let base = main_alloc_bytes(8)
    mem_store64_at(base, 0, 0)
    let mut done = 0
    let mut error = 0
    while done == 0 {
      let count = sys_dir_read(fd, buf, 16384, base)
      if count == 0 { done = 1 }
      else { if count < 0 {
        error = count
        done = 1
      } else {
        let mut offset = 0
        while offset < count and error == 0 {
          let entry = buf + offset
          let record_len = sys_dir_entry_record_len(entry)
          let name_len = main_test_directory_entry_name_len(entry, record_len)
          if record_len <= 0 or offset + record_len > count or name_len < 0 {
            error = 0 - 5
          } else {
            let name = sys_dir_entry_name(entry)
            let selected = if main_test_name_is_dot(name, name_len) == 1 or sys_dir_entry_is_directory(entry) == 1 { 0 }
            else { if pattern_len < 0 { main_test_name_is_weft(name, name_len) }
            else { main_test_glob_matches(name, name_len, pattern, pattern_len) } }
            if selected == 1 {
              main_test_paths_add_sorted(paths, main_test_join_path(prefix, prefix_len, name, name_len))
            } else { 0 }
            offset = offset + record_len
          }
        }
      } }
    }
    sys_close(fd)
    error
  }
}

-- Scan one directory for recursive discovery. The result carries
-- (read error, number of matching .weft entries); child directories are
-- inserted into the lexicographically sorted pending list exactly once per
-- followed filesystem identity.
fn main_test_collect_directory_level(paths: i64, pending: i64, visited: i64, dir_path: i64) -> i64 {
  let fd = sys_dir_open(dir_path)
  if fd < 0 { node_new(0, fd, 0, 0, 0) }
  else {
    let dir_len = cstr_len(dir_path)
    let needs_slash = if dir_len > 0 and mem_load8_at(dir_path, dir_len - 1) == 47 { 0 } else { 1 }
    let prefix_len = dir_len + needs_slash
    let prefix = main_alloc_bytes(prefix_len + 1)
    mem_copy(prefix, dir_path, dir_len)
    if needs_slash == 1 { mem_store8_at(prefix, dir_len, 47) } else { 0 }
    mem_store8_at(prefix, prefix_len, 0)
    let buf = main_alloc_bytes(16384)
    let base = main_alloc_bytes(8)
    mem_store64_at(base, 0, 0)
    let mut done = 0
    let mut error = 0
    let mut matched = 0
    while done == 0 {
      let count = sys_dir_read(fd, buf, 16384, base)
      if count == 0 { done = 1 }
      else { if count < 0 {
        error = count
        done = 1
      } else {
        let mut offset = 0
        while offset < count and error == 0 {
          let entry = buf + offset
          let record_len = sys_dir_entry_record_len(entry)
          let name_len = main_test_directory_entry_name_len(entry, record_len)
          if record_len <= 0 or offset + record_len > count or name_len < 0 {
            error = 0 - 5
          } else {
            let name = sys_dir_entry_name(entry)
            if main_test_name_is_dot(name, name_len) == 0 {
              let child = main_test_join_path(prefix, prefix_len, name, name_len)
              let metadata = main_test_path_metadata(child)
              if metadata != 0 and node_f1(metadata) == 1 {
                if main_test_directory_identity_add(visited, metadata) == 1 {
                  main_test_paths_add_sorted(pending, child)
                } else { 0 }
              } else { if metadata != 0 and main_test_name_is_weft(name, name_len) == 1 {
                matched = matched + 1
                main_test_paths_add_sorted(paths, child)
              } else { 0 } }
            } else { 0 }
            offset = offset + record_len
          }
        }
      } }
    }
    sys_close(fd)
    node_new(0, error, matched, 0, 0)
  }
}

fn main_test_collect_directory_recursive(paths: i64, root: i64, root_metadata: i64, error_prefix: str) -> i64 {
  let pending = nlist_new()
  let visited = nlist_new()
  main_test_directory_identity_add(visited, root_metadata)
  main_test_paths_add_sorted(pending, root)
  let mut i = 0
  let mut failed = 0
  let mut matched = 0
  while i < nlist_len(pending) {
    let dir_path = nlist_get(pending, i)
    let result = main_test_collect_directory_level(paths, pending, visited, dir_path)
    if node_f1(result) < 0 {
      main_test_eprint_path_error(error_prefix, dir_path)
      failed = 1
    } else { matched = matched + node_f2(result) }
    i = i + 1
  }
  if failed == 1 { 0 - 1 } else { matched }
}

fn main_test_eprint_path_error(prefix: str, path: i64) -> i64 {
  eprint(prefix)
  main_test_eprint_cpath(path)
  eprint("\n")
}

-- Returns one failed discovery input or zero. Ordinary file paths, including
-- missing ones, stay in the work list so the compiler produces the canonical
-- path-aware diagnostic.
fn main_test_expand_arg(paths: i64, arg: i64) -> i64 {
  let len = cstr_len(arg)
  if main_test_path_has_glob(arg, len) == 1 {
    let slash = main_test_path_last_slash(arg, len)
    let prefix_len = slash + 1
    let dir_path = if slash < 0 { __str_ptr(".") }
    else { main_test_copy_cpath(arg, if slash == 0 { 1 } else { slash }) }
    let pattern = arg + prefix_len
    let pattern_len = len - prefix_len
    let before = nlist_len(paths)
    let status = main_test_collect_directory(paths, dir_path, arg, prefix_len, pattern, pattern_len)
    if status < 0 {
      main_test_eprint_path_error("test: could not expand pattern: ", arg)
      1
    } else { if nlist_len(paths) == before {
      main_test_eprint_path_error("test: no test files matched: ", arg)
      1
    } else { 0 } }
  } else {
    let metadata = main_test_path_metadata(arg)
    if metadata != 0 and node_f1(metadata) == 1 {
      let status = main_test_collect_directory_recursive(paths, arg, metadata, "test: could not list directory: ")
      if status < 0 {
        1
      } else { if status == 0 {
        main_test_eprint_path_error("test: no .weft files in directory: ", arg)
        1
      } else { 0 } }
  } else {
    main_test_paths_add_sorted(paths, arg)
    0
  } }
}

fn main_test_parse_jobs(raw: i64) -> i64 {
  let len = cstr_len(raw)
  let mut i = 0
  let mut value = 0
  let mut valid = if len == 0 { 0 } else { 1 }
  while i < len and valid == 1 {
    let digit = mem_load8_at(raw, i)
    if digit < 48 or digit > 57 { valid = 0 }
    else {
      value = value * 10 + digit - 48
      if value > 64 { valid = 0 } else { 0 }
      i = i + 1
    }
  }
  if valid == 1 and value > 0 { value } else { 0 }
}

fn main_test_root_timeout_millis(envp: i64) -> i64 {
  main_test_compile_timeout_millis(envp) + main_test_run_timeout_millis(envp)
}

fn main_test_prewarm_file(tt: i64, fns: i64, path: str) -[SourceAcquire]> i64 {
  let errors = alloc_words(1)
  mem_store64_at(errors, 0, 0)
  handle parse_use_file(fns, tt, path) {
    Diagnose.report(diagnostic) -> {
      if diagnose_report_severity_tag(diagnostic) == 1 {
        mem_store64_at(errors, 0, mem_load64_at(errors, 0) + 1)
      } else { 0 }
      resume(0)
    }
    Diagnose.error(msg, span) -> { mem_store64_at(errors, 0, mem_load64_at(errors, 0) + 1) resume(0) }
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
  mem_load64_at(errors, 0)
}

fn main_test_check_project_base(fns: i64, src: i64, tt: i64) -[SourceAcquire]> i64 {
  let errors = alloc_words(1)
  mem_store64_at(errors, 0, 0)
  let checker_errors = handle pipeline_check(weft_grammar(), fns, src, tt) {
    Diagnose.report(diagnostic) -> {
      if diagnose_report_severity_tag(diagnostic) == 1 {
        mem_store64_at(errors, 0, mem_load64_at(errors, 0) + 1)
      } else { 0 }
      resume(0)
    }
    Diagnose.error(msg, span) -> { mem_store64_at(errors, 0, mem_load64_at(errors, 0) + 1) resume(0) }
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
  checker_errors + mem_load64_at(errors, 0)
}

fn main_test_project_base() -[SourceAcquire]> i64 {
  let tt = ttable_new()
  let fns = nlist_new()
  let mut errors = 0
  -- Every generated test root imports Test, and every harness imports these
  -- five support modules. Parse them once before forking; module entries cache
  -- their function closures, while each child retains a root-local checker
  -- table snapshot and all subsequent mutations remain process-private.
  errors = errors + main_test_prewarm_file(tt, fns, "stdlib/test.weft")
  errors = errors + main_test_prewarm_file(tt, fns, "runtime/syscall.weft")
  errors = errors + main_test_prewarm_file(tt, fns, "runtime/alloc.weft")
  errors = errors + main_test_prewarm_file(tt, fns, "runtime/rc.weft")
  errors = errors + main_test_prewarm_file(tt, fns, "stdlib/string.weft")
  errors = errors + main_test_prewarm_file(tt, fns, "stdlib/test_report.weft")
  let test_module = module_fact_find_path(tt, __str_ptr("stdlib/test.weft"), __str_len("stdlib/test.weft"), 0)
  if errors == 0 and test_module != 0 {
    errors = errors + main_test_check_project_base(fns, module_fact_entry_source(test_module), tt)
  } else { if test_module == 0 { errors = errors + 1 } else { 0 } }
  -- Missing/corrupt support must retain the canonical per-root diagnostic.
  -- Discard the partial cache and let each child take the normal load path.
  if errors == 0 {
    ttable_mark_checked_module_products(tt, fns)
    tt
  } else { ttable_new() }
}

fn main_test_dependency_selection_is_named(selected: i64) -> i64 {
  let mut i = 0
  let mut named = 1
  while i < nlist_len(selected) and named == 1 {
    if module_fact_entry_anonymous(nlist_get(selected, i)) != 0 { named = 0 }
    else { i = i + 1 }
  }
  named
}

fn main_test_dependency_pair_count(selected: i64) -> i64 {
  let mut count = 0
  for i in 0..nlist_len(selected) {
    count = count + nlist_len(module_fact_entry_function_pairs(nlist_get(selected, i)))
  }
  count
}

fn main_test_discover_root(tt: i64, path: i64, index: i64) -[SourceAcquire]> MainTestRootPlan {
  let path_len = cstr_len(path)
  let file = read_cpath_file(path, path_len)
  let raw = mem_load64_at(file, 0)
  let raw_n = mem_load64_at(file, 8)
  if raw_n <= 0 { MainTestUnplannedRoot(index, path) }
  else {
    main_mark_root_origin_with_grant(
      tt,
      raw,
      cpath_is_trusted_source(path, path_len),
      cpath_is_strict_source(path, path_len),
      cpath_can_grant_import_trust(path, path_len)
    )
    main_register_source_path(tt, raw, raw_n, path, path_len)
    let errors = alloc_words(1)
    mem_store64_at(errors, 0, 0)
    let grammar = weft_grammar()
    -- Discovery needs the exact imported-module closure it may later share.
    -- Grammar.parse is intentionally root-local; use the source-acquiring
    -- module parser for this whole-graph planning query.
    let fns = handle parse_module(grammar.lex(raw, raw_n), raw, tt) {
      Diagnose.report(diagnostic) -> {
        if diagnose_report_severity_tag(diagnostic) == 1 {
          mem_store64_at(errors, 0, mem_load64_at(errors, 0) + 1)
        } else { 0 }
        resume(0)
      }
      Diagnose.error(msg, span) -> { mem_store64_at(errors, 0, mem_load64_at(errors, 0) + 1) resume(0) }
      Diagnose.warn(msg, span) -> resume(0)
      Diagnose.note(msg, span) -> resume(0)
    }
    let root_module = module_fact_find_source(tt, raw)
    if mem_load64_at(errors, 0) != 0 or root_module == 0 {
      MainTestUnplannedRoot(index, path)
    } else {
      let selected = module_product_collect_dependencies(tt, root_module)
      if nlist_len(selected) == 0 or main_test_dependency_selection_is_named(selected) == 0 {
        MainTestUnplannedRoot(index, path)
      } else {
        MainTestReusableRoot(index, path, raw, raw_n, selected, main_test_dependency_pair_count(selected))
      }
    }
  }
}

fn main_test_discover_roots(paths: i64) -[SourceAcquire]> MainTestRootPlanList {
  let tt = ttable_new()
  let mut plans = MainTestRootPlanNil
  for i in 0..nlist_len(paths) {
    plans = MainTestRootPlanCons(main_test_discover_root(tt, nlist_get(paths, i), i), plans)
  }
  plans
}

fn main_test_dependency_selection_contains(selected: i64, wanted: i64) -> i64 {
  let mut i = 0
  let mut found = 0
  while i < nlist_len(selected) and found == 0 {
    if module_entry_identity_compare(nlist_get(selected, i), wanted) == 0 { found = 1 }
    else { i = i + 1 }
  }
  found
}

fn main_test_dependency_selections_equal(left: i64, right: i64) -> i64 {
  if nlist_len(left) != nlist_len(right) { 0 }
  else {
    let mut i = 0
    let mut equal = 1
    while i < nlist_len(left) and equal == 1 {
      if main_test_dependency_selection_contains(right, nlist_get(left, i)) == 0 { equal = 0 }
      else { i = i + 1 }
    }
    equal
  }
}

fn main_test_root_plan_index(plan: MainTestRootPlan) -> i64 {
  match plan {
    MainTestReusableRoot(index, path, raw, raw_n, selected, pair_count) -> index
    MainTestUnplannedRoot(index, path) -> index
  }
}

fn main_test_root_plans_equal(left: MainTestRootPlan, right: MainTestRootPlan) -> i64 {
  match left {
    MainTestReusableRoot(left_index, left_path, left_raw, left_n, left_selected, left_pairs) -> match right {
      MainTestReusableRoot(right_index, right_path, right_raw, right_n, right_selected, right_pairs) -> main_test_dependency_selections_equal(left_selected, right_selected)
      MainTestUnplannedRoot(right_index, right_path) -> 0
    }
    MainTestUnplannedRoot(left_index, left_path) -> 0
  }
}

fn main_test_root_plan_group_count(plans: MainTestRootPlanList, leader: MainTestRootPlan, claimed: i64) -> i64 {
  match plans {
    MainTestRootPlanNil -> 0
    MainTestRootPlanCons(plan, rest) -> {
      let index = main_test_root_plan_index(plan)
      let here = if mem_load64_at(claimed, index * 8) == 0 and main_test_root_plans_equal(leader, plan) == 1 { 1 } else { 0 }
      here + main_test_root_plan_group_count(rest, leader, claimed)
    }
  }
}

fn main_test_root_plan_assign_group(plans: MainTestRootPlanList, leader: MainTestRootPlan, claimed: i64, bases: i64, base: i64) -> i64 {
  match plans {
    MainTestRootPlanNil -> 0
    MainTestRootPlanCons(plan, rest) -> {
      let index = main_test_root_plan_index(plan)
      if mem_load64_at(claimed, index * 8) == 0 and main_test_root_plans_equal(leader, plan) == 1 {
        mem_store64_at(claimed, index * 8, 1)
        mem_store64_at(bases, index * 8, base)
      } else { 0 }
      main_test_root_plan_assign_group(rest, leader, claimed, bases, base)
    }
  }
}

fn main_test_root_plan_checked_base(session: ProjectSession, plan: MainTestRootPlan) -[SourceAcquire]> i64 {
  match plan {
    MainTestReusableRoot(index, path, raw, raw_n, selected, pair_count) -> {
      let path_len = cstr_len(path)
      let source_path = runtime_str_from_bytes_copy(path, path_len)
      let context = project_query_context_with_trust(
        0,
        source_path,
        source_path,
        project_source_origin_disk(),
        0,
        1,
        cpath_is_trusted_source(path, path_len),
        cpath_is_strict_source(path, path_len),
        cpath_can_grant_import_trust(path, path_len)
      )
      project_session_set_source(session, context, runtime_str_from_bytes_copy(raw, raw_n))
      match project_session_checked_dependency_product_with_acquire(session, context) {
        ModuleCheckedInstance(fns, tt) -> tt
        InvalidModuleCheckedInstance -> 0
      }
    }
    MainTestUnplannedRoot(index, path) -> 0
  }
}

fn main_test_root_plan_pair_count(plan: MainTestRootPlan) -> i64 {
  match plan {
    MainTestReusableRoot(index, path, raw, raw_n, selected, pair_count) -> pair_count
    MainTestUnplannedRoot(index, path) -> 0
  }
}

fn main_test_plan_groups(plans: MainTestRootPlanList, all_plans: MainTestRootPlanList, session: ProjectSession, claimed: i64, bases: i64, metrics: i64) -[SourceAcquire]> i64 {
  match plans {
    MainTestRootPlanNil -> 0
    MainTestRootPlanCons(plan, rest) -> {
      let index = main_test_root_plan_index(plan)
      if mem_load64_at(claimed, index * 8) == 0 {
        let group_count = main_test_root_plan_group_count(all_plans, plan, claimed)
        let reused_roots = group_count - 1
        let pair_count = main_test_root_plan_pair_count(plan)
        let threshold = if reused_roots <= 0 { 0 } else { (32 + reused_roots - 1) / reused_roots }
        if group_count > 1 and pair_count >= threshold {
          let base = main_test_root_plan_checked_base(session, plan)
          if base != 0 {
            main_test_root_plan_assign_group(all_plans, plan, claimed, bases, base)
            mem_store64_at(metrics, 0, mem_load64_at(metrics, 0) + 1)
            mem_store64_at(metrics + 8, 0, mem_load64_at(metrics + 8, 0) + group_count)
            -- Count the exact declaration/function pairs whose checking is
            -- shared with an additional root. This is semantic work avoided,
            -- not an inferred wall-time saving.
            mem_store64_at(metrics + 16, 0, mem_load64_at(metrics + 16, 0) + pair_count * reused_roots)
          } else {
            mem_store64_at(claimed, index * 8, 1)
          }
        } else {
          mem_store64_at(claimed, index * 8, 1)
        }
      } else { 0 }
      main_test_plan_groups(rest, all_plans, session, claimed, bases, metrics)
    }
  }
}

fn main_test_env_flag(envp: i64, prefix: str) -> i64 {
  let prefix_len = __str_len(prefix)
  let mut i = 0
  let mut found = 0
  while mem_load64_at(envp, i * 8) != 0 and found == 0 {
    let entry = mem_load64_at(envp, i * 8)
    if cstr_len(entry) == prefix_len + 1 and src_eq_at(entry, 0, __str_ptr(prefix), 0, prefix_len) == 1 and mem_load8_at(entry, prefix_len) == 49 {
      found = 1
    } else { i = i + 1 }
  }
  found
}

fn main_test_env_positive_i64(envp: i64, prefix: str, maximum: i64, fallback: i64) -> i64 {
  let prefix_len = __str_len(prefix)
  let mut i = 0
  let mut result = fallback
  let mut found = 0
  while mem_load64_at(envp, i * 8) != 0 and found == 0 {
    let entry = mem_load64_at(envp, i * 8)
    let entry_len = cstr_len(entry)
    if entry_len > prefix_len and src_eq_at(entry, 0, __str_ptr(prefix), 0, prefix_len) == 1 {
      let mut pos = prefix_len
      let mut value = 0
      let mut valid = 1
      while pos < entry_len and valid == 1 {
        let digit = mem_load8_at(entry, pos)
        if digit < 48 or digit > 57 { valid = 0 }
        else {
          value = value * 10 + digit - 48
          if value > maximum { valid = 0 } else { 0 }
          pos = pos + 1
        }
      }
      if valid == 1 and value > 0 { result = value } else { 0 }
      found = 1
    } else { i = i + 1 }
  }
  result
}

fn main_test_compile_timeout_millis(envp: i64) -> i64 {
  main_test_env_positive_i64(envp, "WEFT_TEST_COMPILE_TIMEOUT=", 86400, 120) * 1000
}

fn main_test_run_timeout_millis(envp: i64) -> i64 {
  main_test_env_positive_i64(envp, "WEFT_TEST_RUN_TIMEOUT=", 86400, 120) * 1000
}

fn main_test_rss_limit_kb(envp: i64) -> i64 {
  let compile_limit = main_test_env_positive_i64(envp, "WEFT_TEST_COMPILE_RSS_LIMIT_KB=", 1000000000, 0)
  let run_limit = main_test_env_positive_i64(envp, "WEFT_TEST_RUN_RSS_LIMIT_KB=", 1000000000, 0)
  if compile_limit == 0 { run_limit }
  else { if run_limit == 0 { compile_limit }
  else { if compile_limit < run_limit { compile_limit } else { run_limit } } }
}

fn main_test_project_bases(paths: i64, envp: i64, aggregate_metrics: i64) -[SourceAcquire]> MainTestProjectBases {
  let count = nlist_len(paths)
  let bases = alloc_zeroed(count * 8)
  let session = project_session_new_with_root_registration(1, main_project_register_root)
  if count > 1 {
    let plans = main_test_discover_roots(paths)
    let claimed = alloc_zeroed(count * 8)
    let metrics = alloc_zeroed(24)
    main_test_plan_groups(plans, plans, session, claimed, bases, metrics)
    mem_store64_at(aggregate_metrics, 72, mem_load64_at(metrics, 0))
    mem_store64_at(aggregate_metrics, 80, mem_load64_at(metrics, 8))
    mem_store64_at(aggregate_metrics, 88, mem_load64_at(metrics, 16))
    if main_test_env_flag(envp, "WEFT_TEST_PLAN_TRACE=") == 1 {
      eprint("test plan: shared checked dependency groups=")
      eprint_i(mem_load64_at(metrics, 0))
      eprint(" roots=")
      eprint_i(mem_load64_at(metrics + 8, 0))
      eprint("\n")
    } else { 0 }
  } else { 0 }
  let db = project_session_database(session)
  mem_store64_at(aggregate_metrics, 96, incremental_database_hit_count(db))
  mem_store64_at(aggregate_metrics, 104, incremental_database_miss_count(db))
  mem_store64_at(aggregate_metrics, 112, incremental_database_execution_count(db))
  MainTestProjectBases(bases, session)
}

-- Compatibility directive for old executable-style tests. Values 124/125
-- remain reserved for the runner's timeout/RSS statuses, matching the former
-- shell gate. -1 means no directive; -2 means malformed/out of range.
fn main_test_expected_exit_code(raw: i64, n: i64) -> i64 {
  let prefix = "-- Expected exit code: "
  let prefix_len = __str_len(prefix)
  let mut start = 0
  while start + prefix_len <= n {
    if src_eq_at(raw, start, __str_ptr(prefix), 0, prefix_len) == 1 {
      let mut pos = start + prefix_len
      let digit_start = pos
      let mut value = 0
      while pos < n and mem_load8_at(raw, pos) >= 48 and mem_load8_at(raw, pos) <= 57 {
        value = value * 10 + mem_load8_at(raw, pos) - 48
        pos = pos + 1
      }
      let terminated = pos == n or mem_load8_at(raw, pos) == 10 or mem_load8_at(raw, pos) == 13
      if pos == digit_start or terminated == 0 or value >= 124 { return 0 - 2 }
      else { return value }
    } else { start = start + 1 }
  }
  0 - 1
}

fn main_test_run_legacy_source(path: i64, path_len: i64, src: i64, n: i64, tt: i64, envp: i64, index: i64, metrics: i64, expected_exit: i64) -[SourceAcquire]> i64 {
  if n <= 0 {
    eprint("test: could not read input file\n")
    1
  } else {
    let grammar = weft_grammar()
    main_mark_root_origin_with_grant(
      tt,
      src,
      cpath_is_trusted_source(path, path_len),
      cpath_is_strict_source(path, path_len),
      cpath_can_grant_import_trust(path, path_len)
    )
    main_register_source_path(tt, src, n, path, path_len)
    match pipeline_parse_with_error_count(grammar, src, n, tt) {
      PipelineParseResult(fns, parse_errors) -> {
        if parse_errors != 0 {
          eprint("test: legacy main parse failed with ")
          eprint_i(parse_errors)
          eprint(" errors\n")
          1
        } else {
          pipeline_bind_native_runtime_preludes(fns, src, tt)
          let errors = if nlist_len(ttable_checked_module_pairs(tt)) > 0 {
            handle pipeline_check_extending_checked(grammar, fns, src, tt) {
              Diagnose.report(diagnostic) -> { pipeline_diagnose_render_report(tt, diagnostic) resume(0) }
              Diagnose.error(msg, span) -> { pipeline_diagnose_render(tt, src, msg, span) resume(0) }
              Diagnose.warn(msg, span) -> { pipeline_diagnose_render(tt, src, msg, span) resume(0) }
              Diagnose.note(msg, span) -> { pipeline_diagnose_render(tt, src, msg, span) resume(0) }
            }
          } else { pipeline_check_fns_error_count(fns, src, tt) }
          if errors != 0 {
            eprint("test: legacy main type check failed with ")
            eprint_i(errors)
            eprint(" errors\n")
            1
          } else { if main_fns_have_root_main(fns, src) != 1 {
            eprint("test: legacy expected-exit source is missing main\n")
            1
          } else {
            let binary = pipeline_emit_native_with_debug_mode(TypedModule(fns, src, tt), main_test_native_debug_mode())
            if metrics != 0 { mem_store64_at(metrics, 8, main_test_now_millis()) } else { 0 }
            main_test_run_binary_with_expectation(binary, envp, index, metrics, expected_exit)
          } }
        }
      }
    }
  }
}

fn main_test_run_worker(path: i64, project_base: i64, envp: i64, index: i64, owner_pid: i64) -[SourceAcquire]> i64 {
  let metrics = alloc_zeroed(56)
  mem_store64_at(metrics, 0, main_test_now_millis())
  let path_len = cstr_len(path)
  let file = read_cpath_file(path, path_len)
  let raw = mem_load64_at(file, 0)
  let raw_n = mem_load64_at(file, 8)
  let expected_exit = if raw_n <= 0 { 0 - 1 } else { main_test_expected_exit_code(raw, raw_n) }
  let result = if raw_n <= 0 {
    eprint("test: could not read input file\n")
    1
  } else { if expected_exit == 0 - 2 {
    eprint("test: malformed legacy expected-exit directive (use 0..123)\n")
    1
  } else { if expected_exit >= 0 {
    main_test_run_legacy_source(path, path_len, raw, raw_n, project_base, envp, index, metrics, expected_exit)
  } else {
    main_test_finish_preparation_with_metrics(
      main_test_prepare_source_with_table(
        raw,
        raw_n,
        path,
        path_len,
        cpath_is_trusted_source(path, path_len),
        cpath_is_strict_source(path, path_len),
        project_base
      ),
      0,
      envp,
      index,
      metrics
    )
  } } }
  main_test_write_metric_file(owner_pid, index, result, metrics)
  result
}

fn main_test_spawn_worker(path: i64, project_base: i64, envp: i64, index: i64, owner_pid: i64) -[SourceAcquire]> i64 {
  let fork_result = sys_proc_fork()
  if fork_result < 0 { fork_result }
  else {
    if fork_result == 0 {
      -- A separate process group lets the scheduler kill both this compiler
      -- worker and any test executable it has spawned at the outer deadline.
      sys_proc_set_group(0)
      let result = main_test_run_worker(path, project_base, envp, index, owner_pid)
      sys_exit(if result > 255 { 1 } else { result })
      0
    } else {
      sys_proc_set_group(fork_result)
      fork_result
    }
  }
}

fn main_test_find_free_worker(pids: i64, jobs: i64) -> i64 {
  let mut i = 0
  let mut found = 0 - 1
  while i < jobs and found < 0 {
    if mem_load64_at(pids, i * 8) == 0 { found = i } else { i = i + 1 }
  }
  found
}

fn main_test_pause_poll(pause: i64) -> i64 {
  mem_store64_at(pause, 0, 0)
  mem_store64_at(pause, 8, 10000000)
  sys_time_sleep(pause, 0)
}

fn main_test_collect_worker_metric(owner_pid: i64, index: i64, metrics: i64, usage: i64, result_cell: i64) -> i64 {
  let worker_peak = main_test_metrics_record_usage(metrics, usage)
  let path = main_test_metric_path(owner_pid, index)
  let parsed = main_test_parse_metric_file(path)
  let peak = match parsed {
    MainTestWorkerMetric(terminal_result, compile_millis, link_millis, run_millis, user_micros, system_micros, child_peak) -> {
      mem_store64_at(result_cell, 0, terminal_result)
      mem_store64_at(metrics, 0, mem_load64_at(metrics, 0) + compile_millis)
      mem_store64_at(metrics, 8, mem_load64_at(metrics, 8) + link_millis)
      mem_store64_at(metrics, 16, mem_load64_at(metrics, 16) + run_millis)
      mem_store64_at(metrics, 24, mem_load64_at(metrics, 24) + 1)
      mem_store64_at(metrics, 32, mem_load64_at(metrics, 32) + user_micros)
      mem_store64_at(metrics, 40, mem_load64_at(metrics, 40) + system_micros)
      if child_peak > mem_load64_at(metrics, 48) { mem_store64_at(metrics, 48, child_peak) } else { 0 }
      if child_peak > worker_peak { child_peak } else { worker_peak }
    }
    InvalidMainTestWorkerMetric -> worker_peak
  }
  sys_remove(path)
  peak
}

fn main_test_run_paths_parallel(paths: i64, envp: i64, jobs: i64, metrics: i64) -[SourceAcquire]> i64 {
  let planning_start = main_test_now_millis()
  let count = nlist_len(paths)
  let pids = alloc_zeroed(jobs * 8)
  let worker_paths = alloc_zeroed(jobs * 8)
  let worker_indexes = alloc_zeroed(jobs * 8)
  let worker_results = alloc_zeroed(jobs * 8)
  let starts = alloc_zeroed(jobs * 8)
  let usages = alloc_zeroed(jobs * 256)
  let status_ptr = alloc_zeroed(8)
  let pause = alloc_zeroed(16)
  let owner_pid = sys_proc_id()
  let rss_limit_kb = main_test_rss_limit_kb(envp)
  let project_base = main_test_project_base()
  let planned_products = main_test_project_bases(paths, envp, metrics)
  let project_bases = match planned_products { MainTestProjectBases(bases, owner) -> bases }
  let project_owner = match planned_products { MainTestProjectBases(bases, owner) -> owner }
  let planning_end = main_test_now_millis()
  if planning_start >= 0 and planning_end >= planning_start {
    mem_store64_at(metrics, 56, planning_end - planning_start)
  } else { 0 }
  let mut next = 0
  let mut active = 0
  let mut failed = 0
  while next < count or active > 0 {
    while next < count and active < jobs {
      let slot = main_test_find_free_worker(pids, jobs)
      let path = nlist_get(paths, next)
      let start = main_test_now_millis()
      let planned_base = mem_load64_at(project_bases, next * 8)
      let worker_base = if planned_base == 0 { project_base } else { planned_base }
      sys_remove(main_test_metric_path(owner_pid, next))
      let pid = main_test_spawn_worker(path, worker_base, envp, next, owner_pid)
      if pid < 0 {
        main_test_report(path, 257, 0, 0)
        failed = failed + 1
      } else {
        mem_store64_at(pids, slot * 8, pid)
        mem_store64_at(worker_paths, slot * 8, path)
        mem_store64_at(worker_indexes, slot * 8, next)
        mem_store64_at(starts, slot * 8, start)
        active = active + 1
      }
      next = next + 1
    }

    let mut progressed = 0
    let mut slot = 0
    while slot < jobs {
      let pid = mem_load64_at(pids, slot * 8)
      if pid != 0 {
        mem_store64_at(status_ptr, 0, 0)
        let usage = usages + slot * 256
        let waited = sys_proc_wait_usage(pid, status_ptr, 1, usage)
        let now = main_test_now_millis()
        let start = mem_load64_at(starts, slot * 8)
        let expired = start >= 0 and now >= start and now - start >= main_test_root_timeout_millis(envp)
        let mut result = 0 - 1
        let mut complete = 0
        if waited == pid {
          result = main_test_decode_wait_status(status_ptr)
          complete = 1
        } else { if waited < 0 and waited != 0 - 4 {
          result = 257
          complete = 1
        } else { if expired {
          sys_proc_kill(0 - pid)
          let reaped = main_test_wait_blocking_with_usage(pid, status_ptr, usage)
          result = if reaped == pid { 256 } else { 257 }
          complete = 1
        } else { 0 } } }

        if complete == 1 {
          let path = mem_load64_at(worker_paths, slot * 8)
          let index = mem_load64_at(worker_indexes, slot * 8)
          let elapsed = if start < 0 or now < start { 0 } else { now - start }
          let result_cell = worker_results + slot * 8
          mem_store64_at(result_cell, 0, 0 - 1)
          let peak_rss_bytes = main_test_collect_worker_metric(owner_pid, index, metrics, usage, result_cell)
          let exact_result = mem_load64_at(result_cell, 0)
          if exact_result >= 0 { result = exact_result } else { 0 }
          if result == 0 and rss_limit_kb > 0 and peak_rss_bytes > rss_limit_kb * 1024 { result = 261 } else { 0 }
          main_test_report(path, result, elapsed, peak_rss_bytes)
          if result != 0 { failed = failed + 1 } else { 0 }
          mem_store64_at(pids, slot * 8, 0)
          active = active - 1
          progressed = 1
        } else { 0 }
      } else { 0 }
      slot = slot + 1
    }
    if active > 0 and progressed == 0 { main_test_pause_poll(pause) } else { 0 }
  }
  -- Keep the checked-product owner live through the final child exit. Its
  -- source and AST values are the backing storage for inherited raw tables.
  project_session_database(project_owner)
  failed
}

fn main_test_report_metrics(count: i64, wall_millis: i64, metrics: i64) -> i64 {
  eprint("WEFT_TEST_METRICS 2 ")
  eprint_i(count) eprint(" ")
  eprint_i(mem_load64_at(metrics, 24)) eprint(" ")
  eprint_i(wall_millis) eprint(" ")
  eprint_i(mem_load64_at(metrics, 64)) eprint(" ")
  eprint_i(mem_load64_at(metrics, 56)) eprint(" ")
  eprint_i(mem_load64_at(metrics, 0)) eprint(" ")
  eprint_i(mem_load64_at(metrics, 8)) eprint(" ")
  eprint_i(mem_load64_at(metrics, 16)) eprint(" ")
  eprint_i(mem_load64_at(metrics, 32)) eprint(" ")
  eprint_i(mem_load64_at(metrics, 40)) eprint(" ")
  eprint_i(mem_load64_at(metrics, 48)) eprint(" ")
  eprint_i(mem_load64_at(metrics, 72)) eprint(" ")
  eprint_i(mem_load64_at(metrics, 80)) eprint(" ")
  eprint_i(mem_load64_at(metrics, 88)) eprint(" ")
  eprint_i(mem_load64_at(metrics, 96)) eprint(" ")
  eprint_i(mem_load64_at(metrics, 104)) eprint(" ")
  eprint_i(mem_load64_at(metrics, 112)) eprint("\n")
  eprint("test metrics: roots=")
  eprint_i(count)
  eprint(" measured=") eprint_i(mem_load64_at(metrics, 24))
  eprint(" wall_ms=") eprint_i(wall_millis)
  eprint(" discovery_ms=") eprint_i(mem_load64_at(metrics, 64))
  eprint(" planning_ms=") eprint_i(mem_load64_at(metrics, 56))
  eprint(" compile_ms_sum=") eprint_i(mem_load64_at(metrics, 0))
  eprint(" link_ms_sum=") eprint_i(mem_load64_at(metrics, 8))
  eprint(" run_ms_sum=") eprint_i(mem_load64_at(metrics, 16))
  eprint(" cpu_user_us_sum=") eprint_i(mem_load64_at(metrics, 32))
  eprint(" cpu_system_us_sum=") eprint_i(mem_load64_at(metrics, 40))
  eprint(" peak_rss_kb=") eprint_i((mem_load64_at(metrics, 48) + 1023) / 1024)
  eprint(" shared_groups=") eprint_i(mem_load64_at(metrics, 72))
  eprint(" shared_roots=") eprint_i(mem_load64_at(metrics, 80))
  eprint(" reused_checked_pairs=") eprint_i(mem_load64_at(metrics, 88))
  eprint(" query_hits=") eprint_i(mem_load64_at(metrics, 96))
  eprint(" query_misses=") eprint_i(mem_load64_at(metrics, 104))
  eprint(" query_executions=") eprint_i(mem_load64_at(metrics, 112))
  eprint("\n")
}

fn run_test_paths(argc: i64, argv: i64, first_path: i64, jobs: i64) -[SourceAcquire]> i64 {
  let started = main_test_now_millis()
  let envp = argv + (argc + 1) * 8
  let paths = nlist_new()
  let metrics = alloc_zeroed(120)
  let mut discovery_failures = 0
  for i in first_path..argc {
    discovery_failures = discovery_failures + main_test_expand_arg(paths, mem_load64_at(argv, i * 8))
  }
  let discovery_end = main_test_now_millis()
  if started >= 0 and discovery_end >= started {
    mem_store64_at(metrics, 64, discovery_end - started)
  } else { 0 }
  let count = nlist_len(paths)
  let worker_failures = if count == 0 { 0 } else { main_test_run_paths_parallel(paths, envp, jobs, metrics) }
  let fail = discovery_failures + worker_failures
  let pass = count - worker_failures
  let final_fail = if count == 0 and fail == 0 {
    eprint("test: no test files provided\n")
    1
  } else { fail }
  eprint("\n")
  eprint_i(pass)
  eprint(" passed, ")
  eprint_i(final_fail)
  eprint(" failed\n")
  if main_test_env_flag(envp, "WEFT_TEST_METRICS=") == 1 {
    let finished = main_test_now_millis()
    let wall_millis = if started < 0 or finished < started { 0 } else { finished - started }
    main_test_report_metrics(count, wall_millis, metrics)
  } else { 0 }
  if final_fail == 0 { 0 } else { 1 }
}

fn main_pkg_native_wrapper_json(tt: i64, module_path: str, package_name: str, declaration: i64, fact: SemanticFunctionFact) -> Json {
  let signature_buffer = buf_new(128)
  docgen_append_function_signature(signature_buffer, tt, declaration)
  let signature = runtime_str_from_bytes_copy(buf_ptr(signature_buffer), buf_len(signature_buffer))
  match fact {
    SemanticFunction(name, parameters, result, effects, purity, ownership, shape, bounds) -> {
      list_cons<JsonEntry>(json_entry("package", json_string(package_name)),
        list_cons<JsonEntry>(json_entry("module", json_string(module_path)),
        list_cons<JsonEntry>(json_entry("name", json_string(name)),
        list_cons<JsonEntry>(json_entry("signature", json_string(signature)),
        list_cons<JsonEntry>(json_entry("effects", json_string(semantic_effect_set_render(effects))), list_nil<JsonEntry>()))))) |> json_object
    }
    SemanticFunctionOther(name) -> {
      list_cons<JsonEntry>(json_entry("package", json_string(package_name)),
        list_cons<JsonEntry>(json_entry("module", json_string(module_path)),
        list_cons<JsonEntry>(json_entry("name", json_string(name)),
        list_cons<JsonEntry>(json_entry("signature", json_string(signature)),
        list_cons<JsonEntry>(json_entry("effects", json_string("unknown")), list_nil<JsonEntry>()))))) |> json_object
    }
  }
}

fn main_pkg_native_wrapper_facts_from_table(tt: i64) -> List<Json> {
  let mut wrappers = list_nil<Json>()
  let checked_functions = ttable_get_checked_functions(tt)
  for source_index in 0..ttable_native_binding_source_count(tt) {
    let source_entry = ttable_native_binding_source_at(tt, source_index)
    let source = ttable_native_binding_source_source(source_entry)
    let module_entry = module_fact_find_source(tt, source)
    let package_id = ttable_native_binding_source_package(source_entry)
    let package_identity = pkg_identity_find_id(tt, package_id)
    let module_path = if module_entry == 0 { "unknown" }
      else { runtime_str_from_bytes_copy(module_fact_entry_path_ptr(module_entry), module_fact_entry_path_len(module_entry)) }
    let package_name = if package_identity == 0 { "unknown" }
      else { runtime_str_from_bytes_copy(pkg_identity_name_ptr(package_identity), pkg_identity_name_len(package_identity)) }
    for declaration_index in 0..module_fact_decl_count(tt) {
      let declaration = module_fact_decl_at(tt, declaration_index)
      if docgen_decl_is_public_root(declaration, source) and module_decl_fact_namespace(declaration) == module_decl_namespace_value() {
        let entry = if checked_functions == 0 { 0 } else { ftypes_find_decl(checked_functions, declaration) }
        match semantic_fact_function_entry(tt, entry) {
          SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactFunction(fact))) -> {
            wrappers = list_append<Json>(wrappers, main_pkg_native_wrapper_json(tt, module_path, package_name, declaration, fact))
            0
          }
          _ -> 0
        }
      } else { 0 }
    }
  }
  wrappers
}

fn main_pkg_native_wrapper_facts_for_manifest(source: str, manifest: i64) -[SourceAcquire]> Result<List<Json>, str> {
  let grammar = weft_grammar()
  let tt = ttable_new()
  let path = "native_audit.weft"
  if manifest != 0 { ttable_set_root_manifest(tt, manifest) } else { 0 }
  main_mark_root_origin_with_grant(tt, __str_ptr(source), 0, 1, 0)
  main_register_source_path(tt, __str_ptr(source), __str_len(source), __str_ptr(path), __str_len(path))
  match pipeline_parse_with_error_count(grammar, __str_ptr(source), __str_len(source), tt) {
    PipelineParseResult(fns, parse_errors) -> {
      if parse_errors != 0 { Err("pkg: native audit import graph did not parse") }
      else {
        let check_errors = pipeline_check_fns_error_count(fns, __str_ptr(source), tt)
        if check_errors != 0 { Err("pkg: native audit import graph did not check") }
        else { Ok(main_pkg_native_wrapper_facts_from_table(tt)) }
      }
    }
  }
}

fn main_pkg_native_wrapper_facts(source: str) -[SourceAcquire]> Result<List<Json>, str> {
  main_pkg_native_wrapper_facts_for_manifest(source, 0)
}

type MainPackageTrustReviewFacts {
  MainPackageTrustReviewFacts(str, str)
}

type MainPackageTrustDecision {
  MainPackageTrustReviewRequired,
  MainPackageTrustAccepted
}

fn main_pkg_trust_review_exact(facts: MainPackageTrustReviewFacts) -> str {
  match facts { MainPackageTrustReviewFacts(exact, capabilities) -> exact }
}

fn main_pkg_trust_review_capabilities(facts: MainPackageTrustReviewFacts) -> str {
  match facts { MainPackageTrustReviewFacts(exact, capabilities) -> capabilities }
}

fn main_pkg_store_owned_text(holder: i64, offset: i64, value: str) -> i64 {
  let stable = main_alloc_bytes(__str_len(value))
  mem_copy(stable, __str_ptr(value), __str_len(value))
  mem_store64_at(holder, offset, stable)
  mem_store64_at(holder, offset + 8, __str_len(value))
  0
}

fn main_pkg_trust_review_documents_into(holder: i64, manifest: i64, lock_data: i64, wrappers: List<Json>) -[FileRead]> i64 {
  match pkg_native_authority_document(manifest, lock_data, wrappers, PackageAuthorityExactIdentity) {
    Err(message) -> { pkg_stderr(message) pkg_stderr("\n") 1 }
    Ok(exact) -> match pkg_native_authority_document(manifest, lock_data, wrappers, PackageAuthorityCapabilities) {
      Err(message) -> { pkg_stderr(message) pkg_stderr("\n") 1 }
      Ok(capabilities) -> {
        main_pkg_store_owned_text(holder, 0, json_stringify(exact))
        main_pkg_store_owned_text(holder, 16, json_stringify(capabilities))
        0
      }
    }
  }
}

fn main_pkg_trust_review_facts(manifest: i64, lock_data: i64) -[SourceAcquire]> Result<MainPackageTrustReviewFacts, str> {
  match pkg_native_audit_import_source_for_manifest(manifest) {
    Err(message) -> Err(message)
    Ok(source) -> match main_pkg_native_wrapper_facts_for_manifest(source, manifest) {
      Err(message) -> Err(message)
      Ok(wrappers) -> {
        let holder = alloc_zeroed(32)
        let status = runtime_standalone_file_read(() => main_pkg_trust_review_documents_into(holder, manifest, lock_data, wrappers))
        if status != 0 { Err("pkg: could not produce trusted dependency review facts") }
        else { Ok(MainPackageTrustReviewFacts(
          runtime_str_from_bytes_copy(mem_load64_at(holder, 0), mem_load64_at(holder, 8)),
          runtime_str_from_bytes_copy(mem_load64_at(holder, 16), mem_load64_at(holder, 24))
        )) }
      }
    }
  }
}

fn main_pkg_native_audit_source_into(holder: i64) -[FileRead]> i64 {
  match pkg_native_audit_import_source() {
    Err(message) -> { pkg_stderr(message) pkg_stderr("\n") 1 }
    Ok(source) -> {
      let stable = main_alloc_bytes(__str_len(source))
      mem_copy(stable, __str_ptr(source), __str_len(source))
      mem_store64_at(holder, 0, stable)
      mem_store64_at(holder, 8, __str_len(source))
      0
    }
  }
}

fn main_pkg_cli_audit() -[SourceAcquire]> i64 {
  let source_holder = alloc_zeroed(16)
  let source_status = runtime_standalone_file_read(() => main_pkg_native_audit_source_into(source_holder))
  if source_status != 0 { source_status }
  else {
    let source = runtime_str_from_bytes_copy(mem_load64_at(source_holder, 0), mem_load64_at(source_holder, 8))
    match main_pkg_native_wrapper_facts(source) {
      Err(message) -> { pkg_stderr(message) pkg_stderr("\n") 1 }
      Ok(wrappers) -> runtime_standalone_file_read(() => pkg_cli_audit_with_wrappers(wrappers))
    }
  }
}

fn main_pkg_find_provider_in_path(name: str, directories: Vector<str>, index: i64) -> str {
  if index >= vector_len<str>(directories) { "" }
  else {
    let directory = vector_get_in_bounds<str>(directories, index)
    let base = if __str_len(directory) == 0 { "." } else { directory }
    let candidate = str_concat(str_concat(base, "/"), name)
    if main_path_exists(candidate) { candidate }
    else { main_pkg_find_provider_in_path(name, directories, index + 1) }
  }
}

fn main_pkg_provider(name: str, envp: i64) -> str {
  let path = main_environment_path(envp)
  if __str_len(path) == 0 { "" }
  else { main_pkg_find_provider_in_path(name, str_split(path, ":"), 0) }
}

fn main_pkg_stage_prefix() -> str {
  str_concat(".weft/staging/pkg-", runtime_int_to_str(sys_proc_id()))
}

fn main_pkg_with_acquisition(
  argc: i64,
  argv: i64,
  body: () -[PackageSourceAcquire, FileRead, FileWrite, DirInspect, DirMutate]> i64
) -> i64 {
  let envp = argv + (argc + 1) * 8
  let env = main_pkg_provider("env", envp)
  let git = main_pkg_provider("git", envp)
  let curl = main_pkg_provider("curl", envp)
  runtime_platform_proc(argc, argv, () =>
    package_source_with_process_providers(env, git, curl, () =>
      runtime_standalone_package_mutation_io_with(body)))
}

fn main_pkg_update_snapshot_into(holder: i64) -[FileRead]> i64 {
  match pkg_update_snapshot_files() {
    Err(message) -> { pkg_stderr(message) pkg_stderr("\n") 1 }
    Ok(snapshot) -> {
      main_pkg_store_owned_text(holder, 0, pkg_update_snapshot_manifest(snapshot))
      main_pkg_store_owned_text(holder, 16, pkg_update_snapshot_lock(snapshot))
      0
    }
  }
}

fn main_pkg_update_snapshot_from_holder(holder: i64) -> PackageUpdateSnapshot {
  PackageUpdateSnapshot(
    runtime_str_from_bytes_copy(mem_load64_at(holder, 0), mem_load64_at(holder, 8)),
    runtime_str_from_bytes_copy(mem_load64_at(holder, 16), mem_load64_at(holder, 24))
  )
}

fn main_pkg_update_read_snapshot() -> Result<PackageUpdateSnapshot, str> {
  let holder = alloc_zeroed(32)
  let status = runtime_standalone_file_read(() => main_pkg_update_snapshot_into(holder))
  if status != 0 { Err("pkg: could not snapshot dependency update files") }
  else { Ok(main_pkg_update_snapshot_from_holder(holder)) }
}

fn main_pkg_update_restore(snapshot: PackageUpdateSnapshot) -> i64 {
  runtime_standalone_file_write(() => pkg_update_restore_files(snapshot))
}

fn main_pkg_trust_review_document(
  package_name: str,
  before: MainPackageTrustReviewFacts,
  after: MainPackageTrustReviewFacts,
  decision: MainPackageTrustDecision
) -> str {
  let capabilities_changed = if str_eq(main_pkg_trust_review_capabilities(before), main_pkg_trust_review_capabilities(after)) == 1 { 0 } else { 1 }
  let decision_name = match decision {
    MainPackageTrustReviewRequired -> "review_required"
    MainPackageTrustAccepted -> "accepted"
  }
  let help = match decision {
    MainPackageTrustReviewRequired -> "review the before/after facts, then rerun the same update with --accept-trust-change"
    MainPackageTrustAccepted -> "the existing trusted module set now names the reviewed dependency identity"
  }
  let b = buf_new(1024)
  bstr(b, "{\"schema_version\":1,\"code\":\"E5014\",\"package\":")
  bstr(b, json_stringify(json_string(package_name)))
  bstr(b, ",\"decision\":")
  bstr(b, json_stringify(json_string(decision_name)))
  bstr(b, ",\"capabilities_changed\":")
  bstr(b, if capabilities_changed == 1 { "true" } else { "false" })
  bstr(b, ",\"before\":")
  bstr(b, main_pkg_trust_review_exact(before))
  bstr(b, ",\"after\":")
  bstr(b, main_pkg_trust_review_exact(after))
  bstr(b, ",\"help\":")
  bstr(b, json_stringify(json_string(help)))
  bstr(b, "}")
  runtime_str_from_bytes_copy(buf_ptr(b), buf_len(b))
}

fn main_pkg_update_trusted_candidate(
  argc: i64,
  argv: i64,
  name: str,
  snapshot: PackageUpdateSnapshot,
  before: MainPackageTrustReviewFacts,
  decision: MainPackageTrustDecision
) -[SourceAcquire]> i64 {
  match main_pkg_update_read_snapshot() {
    Err(message) -> { main_pkg_update_restore(snapshot) 1 }
    Ok(candidate_files) -> {
      let candidate_manifest_text = pkg_update_snapshot_manifest(candidate_files)
      let candidate_manifest = pkg_manifest_parse(__str_ptr(candidate_manifest_text), __str_len(candidate_manifest_text))
      let candidate_lock_text = pkg_update_snapshot_lock(candidate_files)
      let candidate_lock = pkg_lock_parse(candidate_lock_text)
      if pkg_manifest_error_count(candidate_manifest) > 0 or
        pkg_manifest_refresh_trust_identity_from_lock(candidate_manifest, candidate_lock, __str_ptr(name), __str_len(name)) != 0 {
        pkg_stderr("pkg: trusted dependency candidate identity is invalid\n")
        main_pkg_update_restore(snapshot)
        1
      } else { match main_pkg_trust_review_facts(candidate_manifest, candidate_lock) {
        Err(message) -> {
          pkg_stderr(message)
          pkg_stderr("\n")
          main_pkg_update_restore(snapshot)
          1
        }
        Ok(after) -> {
          let document = main_pkg_trust_review_document(name, before, after, decision)
          match decision {
            MainPackageTrustReviewRequired -> {
              if main_pkg_update_restore(snapshot) != 0 { 1 }
              else {
                pkg_stderr("error[E5014]: trusted dependency update requires explicit capability review\n")
                pkg_stderr(document)
                pkg_stderr("\n")
                1
              }
            }
            MainPackageTrustAccepted -> {
              let written = runtime_standalone_file_write(() => pkg_manifest_write(candidate_manifest))
              if written != 0 {
                main_pkg_update_restore(snapshot)
                1
              } else {
                let relocked = main_pkg_with_acquisition(argc, argv, () =>
                  pkg_cli_lock_with_notice(main_pkg_stage_prefix(), PackageLockQuiet))
                if relocked != 0 {
                  main_pkg_update_restore(snapshot)
                  1
                } else {
                  pkg_stdout("pkg: updated trusted dependency\n")
                  pkg_stdout(document)
                  pkg_stdout("\n")
                  0
                }
              }
            }
          }
        }
      } }
    }
  }
}

fn main_pkg_update(
  argc: i64,
  argv: i64,
  name_ptr: i64,
  name_len: i64,
  pin_ptr: i64,
  pin_len: i64,
  decision: MainPackageTrustDecision
) -[SourceAcquire]> i64 {
  match main_pkg_update_read_snapshot() {
    Err(message) -> 1
    Ok(snapshot) -> {
      let manifest_text = pkg_update_snapshot_manifest(snapshot)
      let manifest = pkg_manifest_parse(__str_ptr(manifest_text), __str_len(manifest_text))
      let grant = pkg_manifest_find_trust_grant(manifest, name_ptr, name_len)
      let old_lock = pkg_lock_parse(pkg_update_snapshot_lock(snapshot))
      if pkg_manifest_error_count(manifest) > 0 or pkg_lock_data_status(old_lock) != 1 {
        pkg_stderr("pkg: dependency update requires a valid manifest and lock\n")
        1
      } else {
        let name = runtime_str_from_bytes_copy(name_ptr, name_len)
        let before: Result<MainPackageTrustReviewFacts, str> = if grant == 0 {
          Ok<MainPackageTrustReviewFacts, str>(MainPackageTrustReviewFacts("", ""))
        }
          else { main_pkg_trust_review_facts(manifest, old_lock) }
        match before {
          Err(message) -> { pkg_stderr(message) pkg_stderr("\n") 1 }
          Ok(before_facts) -> {
            let updated = runtime_standalone_file_read_write(() =>
              pkg_cli_update_pin_with_notice(name_ptr, name_len, pin_ptr, pin_len, PackageUpdateQuiet))
            if updated != 0 { updated }
            else {
              let locked = main_pkg_with_acquisition(argc, argv, () =>
                pkg_cli_lock_with_notice(main_pkg_stage_prefix(), PackageLockQuiet))
              if locked != 0 {
                main_pkg_update_restore(snapshot)
                locked
              } else { if grant == 0 {
                pkg_stdout("pkg: updated dependency pin\n")
                pkg_stdout("pkg: wrote weft.lock\n")
                0
              } else {
                main_pkg_update_trusted_candidate(argc, argv, name, snapshot, before_facts, decision)
              } }
            }
          }
        }
      }
    }
  }
}

fn run_pkg(argc: i64, argv: i64) -[SourceAcquire]> i64 {
  if argc < 3 {
    pkg_stderr("usage: weft pkg init [name]\nusage: weft pkg add NAME PATH\nusage: weft pkg add NAME --git HTTPS_URL --revision HEX\nusage: weft pkg add NAME --archive HTTPS_URL --sha256 sha256:HEX\nusage: weft pkg lock\nusage: weft pkg fetch [--offline]\nusage: weft pkg update NAME (--revision HEX | --sha256 sha256:HEX) [--accept-trust-change]\nusage: weft pkg exports\nusage: weft pkg audit\n")
    1
  } else {
    let sub = mem_load64_at(argv, 16)
    if cstr_eq(sub, "init") == 1 {
      if argc > 3 {
        let name = mem_load64_at(argv, 24)
        runtime_standalone_file_write(() => pkg_cli_init(name, cstr_len(name)))
      } else {
        runtime_standalone_file_write(() => pkg_cli_init(__str_ptr("app"), __str_len("app")))
      }
    } else { if cstr_eq(sub, "add") == 1 {
      if argc == 5 {
        let name = mem_load64_at(argv, 24)
        let path = mem_load64_at(argv, 32)
        runtime_standalone_file_read_write(() => pkg_cli_add(name, cstr_len(name), path, cstr_len(path)))
      } else { if argc == 8 and cstr_eq(mem_load64_at(argv, 32), "--git") == 1 and cstr_eq(mem_load64_at(argv, 48), "--revision") == 1 {
        let name = mem_load64_at(argv, 24)
        let url_ptr = mem_load64_at(argv, 40)
        let pin_ptr = mem_load64_at(argv, 56)
        let source = PackageGitSource(runtime_str_from_bytes_copy(url_ptr, cstr_len(url_ptr)), runtime_str_from_bytes_copy(pin_ptr, cstr_len(pin_ptr)))
        runtime_standalone_file_read_write(() => pkg_cli_add_source(name, cstr_len(name), source))
      } else { if argc == 8 and cstr_eq(mem_load64_at(argv, 32), "--archive") == 1 and cstr_eq(mem_load64_at(argv, 48), "--sha256") == 1 {
        let name = mem_load64_at(argv, 24)
        let url_ptr = mem_load64_at(argv, 40)
        let pin_ptr = mem_load64_at(argv, 56)
        let source = PackageArchiveSource(runtime_str_from_bytes_copy(url_ptr, cstr_len(url_ptr)), runtime_str_from_bytes_copy(pin_ptr, cstr_len(pin_ptr)))
        runtime_standalone_file_read_write(() => pkg_cli_add_source(name, cstr_len(name), source))
      } else {
        pkg_stderr("usage: weft pkg add NAME PATH\nusage: weft pkg add NAME --git HTTPS_URL --revision HEX\nusage: weft pkg add NAME --archive HTTPS_URL --sha256 sha256:HEX\n")
        1
      } } }
    } else { if cstr_eq(sub, "lock") == 1 {
      main_pkg_with_acquisition(argc, argv, () => pkg_cli_lock(main_pkg_stage_prefix()))
    } else { if cstr_eq(sub, "fetch") == 1 {
      if argc == 3 { main_pkg_with_acquisition(argc, argv, () => pkg_cli_fetch_online(main_pkg_stage_prefix())) }
      else { if argc == 4 and cstr_eq(mem_load64_at(argv, 24), "--offline") == 1 {
        runtime_standalone_package_io(() => pkg_cli_fetch_offline())
      } else {
        pkg_stderr("usage: weft pkg fetch [--offline]\n")
        1
      } }
    } else { if cstr_eq(sub, "update") == 1 {
      if (argc == 6 or (argc == 7 and cstr_eq(mem_load64_at(argv, 48), "--accept-trust-change") == 1)) and
        (cstr_eq(mem_load64_at(argv, 32), "--revision") == 1 or cstr_eq(mem_load64_at(argv, 32), "--sha256") == 1) {
        let name = mem_load64_at(argv, 24)
        let pin = mem_load64_at(argv, 40)
        let decision = if argc == 7 { MainPackageTrustAccepted } else { MainPackageTrustReviewRequired }
        main_pkg_update(argc, argv, name, cstr_len(name), pin, cstr_len(pin), decision)
      } else {
        pkg_stderr("usage: weft pkg update NAME (--revision HEX | --sha256 sha256:HEX) [--accept-trust-change]\n")
        1
      }
    } else { if cstr_eq(sub, "exports") == 1 {
      runtime_standalone_file_read(() => pkg_cli_exports())
    } else { if cstr_eq(sub, "audit") == 1 {
      main_pkg_cli_audit()
    } else {
      pkg_stderr("pkg: unknown command\n")
      1
    } } } } } } }
  }
}

fn main_color_mode_arg(arg: i64) -> i64 {
  if cstr_eq(arg, "auto") == 1 { terminal_color_mode_auto() }
  else { if cstr_eq(arg, "always") == 1 { terminal_color_mode_always() }
  else { if cstr_eq(arg, "never") == 1 { terminal_color_mode_never() }
  else { 0 - 1 } } }
}

fn main_inline_color_mode_arg(arg: i64) -> i64 {
  if cstr_eq(arg, "--color=auto") == 1 { terminal_color_mode_auto() }
  else { if cstr_eq(arg, "--color=always") == 1 { terminal_color_mode_always() }
  else { if cstr_eq(arg, "--color=never") == 1 { terminal_color_mode_never() }
  else { 0 - 1 } } }
}

fn main_cstr_starts_with(ptr: i64, prefix: str) -> i64 {
  let prefix_len = __str_len(prefix)
  if cstr_len(ptr) < prefix_len { 0 }
  else { src_eq_at(ptr, 0, __str_ptr(prefix), 0, prefix_len) }
}

fn main_color_usage_error(message: str) -> i64 {
  eprint(message)
  eprint("usage: weft [--color auto|always|never] <command> [args...]\n")
  2
}

fn main_explain_code(code_ptr: i64) -> i64 {
  let mut index = 0
  while index < diagnostic_registry_count() {
    match diagnostic_registry_entry(index) {
      DiagnosticRegistryEntry(code, class, summary) -> {
        if cstr_eq(code_ptr, code) == 1 {
          oprint(code)
          oprint(" [")
          oprint(diagnostic_class_name(class))
          oprint("]\n")
          oprint(summary)
          oprint("\n\n")
          oprint(diagnostic_registry_explanation(index))
          oprint("\n")
          return 0
        } else { 0 }
      }
    }
    index = index + 1
  }
  eprint("explain: unknown diagnostic code: ")
  sys_write(2, code_ptr, cstr_len(code_ptr))
  eprint("\n")
  1
}

fn run_explain(argc: i64, argv: i64) -> i64 {
  if argc != 3 {
    eprint("usage: weft explain CODE\n")
    2
  } else { main_explain_code(mem_load64_at(argv, 16)) }
}

fn run_doc_path(path: i64) -[SourceAcquire]> i64 {
  let path_len = cstr_len(path)
  let file = read_cpath_file(path, path_len)
  let src = mem_load64_at(file, 0)
  let n = mem_load64_at(file, 8)
  if n <= 0 {
    eprint("doc: could not read input file\n")
    1
  } else {
    let grammar = weft_grammar()
    let tt = ttable_new()
    main_mark_root_origin_with_grant(tt, src, cpath_is_trusted_source(path, path_len), cpath_is_strict_source(path, path_len), cpath_can_grant_import_trust(path, path_len))
    main_register_source_path(tt, src, n, path, path_len)
    match pipeline_parse_with_error_count(grammar, src, n, tt) {
      PipelineParseResult(fns, parse_errors) -> {
        if parse_errors != 0 {
          eprint("doc: parse failed with ")
          eprint_i(parse_errors)
          eprint(" errors\n")
          1
        } else {
          let check_errors = pipeline_check_fns_error_count(fns, src, tt)
          if check_errors != 0 {
            eprint("doc: type check failed with ")
            eprint_i(check_errors)
            eprint(" errors\n")
            1
          } else {
            oprint(docgen_render_module(TypedModule(fns, src, tt), runtime_str_from_bytes_copy(path, path_len)))
            0
          }
        }
      }
    }
  }
}

fn run_doc(argc: i64, argv: i64) -[SourceAcquire]> i64 {
  if argc != 3 {
    eprint("usage: weft doc PATH\n")
    2
  } else { run_doc_path(mem_load64_at(argv, 16)) }
}

fn main_version_target_names(targets: List<NativeLinkTarget>, first: bool) -> i64 {
  match targets {
    Nil -> 0
    Cons(target, rest) -> {
      if first == false { oprint(",") } else { 0 }
      native_link_target_name(target) |> oprint
      main_version_target_names(rest, false)
    }
  }
}

fn main_version_human() -> i64 {
  match weft_product_identity() {
    WeftProductIdentity(compiler, language, manifest, lock, binding, facts) -> {
      oprint("weft ")
      oprint(compiler)
      oprint(" (language ")
      oprint(language)
      oprint("; manifest ")
      oprint_i(manifest)
      oprint("; lock ")
      oprint_i(lock)
      oprint("; native-binding ")
      oprint_i(binding)
      oprint("; artifact-facts ")
      oprint_i(facts)
      oprint("; targets ")
      main_version_target_names(native_link_supported_targets(), true)
      oprint(")\n")
      0
    }
  }
}

fn run_version(argc: i64, argv: i64) -> i64 {
  if argc == 2 { main_version_human() }
  else { if argc == 3 and cstr_eq(mem_load64_at(argv, 16), "--json") == 1 {
    weft_product_identity_json_render() |> oprint
    oprint("\n")
    0
  } else {
    eprint("usage: weft version [--json]\n")
    2
  } }
}

fn main_target_binary_format(target: NativeLinkTarget) -> str {
  match target {
    NativeLinkMacosAarch64 -> "mach-o-64"
    NativeLinkLinuxAarch64 -> "elf64"
  }
}

fn main_target_json(target: NativeLinkTarget) -> Json {
  let mut fields = list_nil<JsonEntry>()
  fields = list_append<JsonEntry>(fields, json_entry("target", json_string(native_link_target_name(target))))
  fields = list_append<JsonEntry>(fields, json_entry("host", json_bool(if native_link_target_is_host(target) { 1 } else { 0 })))
  fields = list_append<JsonEntry>(fields, json_entry("architecture", json_string("aarch64")))
  fields = list_append<JsonEntry>(fields, json_entry("binary_format", json_string(main_target_binary_format(target))))
  fields = list_append<JsonEntry>(fields, json_entry("minimum_platform_abi", native_link_artifact_platform_abi_json(native_link_target_platform_abi(target, list_nil<NativeLinkLibrary>()))))
  fields = list_append<JsonEntry>(fields, json_entry("standalone_default", json_bool(1)))
  fields = list_append<JsonEntry>(fields, json_entry("product_linker", json_string("weft-native")))
  json_object(fields)
}

fn main_target_list(targets: List<NativeLinkTarget>) -> i64 {
  match targets {
    Nil -> 0
    Cons(target, rest) -> {
      native_link_target_name(target) |> oprint
      oprint("\n")
      main_target_list(rest)
    }
  }
}

fn main_target_show(target: NativeLinkTarget) -> i64 {
  main_target_json(target) |> json_stringify |> oprint
  oprint("\n")
  0
}

fn run_target(argc: i64, argv: i64) -> i64 {
  if argc == 3 and cstr_eq(mem_load64_at(argv, 16), "list") == 1 {
    main_target_list(native_link_supported_targets())
  } else { if argc >= 3 and cstr_eq(mem_load64_at(argv, 16), "show") == 1 {
    if argc == 3 { main_target_show(native_link_target_host()) }
    else { if argc == 4 {
      match main_target_argument(mem_load64_at(argv, 24)) {
        NativeLinkTargetParsed(target) -> main_target_show(target)
        NativeLinkTargetUnsupported -> {
          eprint("target: unsupported target; expected macos-aarch64 or linux-aarch64\n")
          2
        }
      }
    } else {
      eprint("usage: weft target list\nusage: weft target show [macos-aarch64|linux-aarch64]\n")
      2
    } }
  } else {
    eprint("usage: weft target list\nusage: weft target show [macos-aarch64|linux-aarch64]\n")
    2
  } }
}

-- Subcommand dispatch after process-wide presentation options have been
-- removed. Default (no args or "compile") is the full compilation pipeline.
fn main_dispatch_unchecked(argc: i64, argv: i64) -[SourceAcquire]> i64 {
  if argc > 1 {
    let cmd = mem_load64_at(argv, 8)
    if cstr_eq(cmd, "--version") == 1 {
      if argc == 2 { main_version_human() }
      else {
        eprint("usage: weft --version\n")
        2
      }
    }
    else { if cstr_eq(cmd, "version") == 1 { run_version(argc, argv) }
    else { if cstr_eq(cmd, "target") == 1 { run_target(argc, argv) }
    else { if cstr_eq(cmd, "fmt") == 1 {
      run_fmt_command(argc, argv)
    }
    else { if cstr_eq(cmd, "check") == 1 {
      if argc > 2 {
        let first = mem_load64_at(argv, 16)
        if cstr_eq(first, "--jobs") == 1 or cstr_eq(first, "-j") == 1 {
          if argc < 5 {
            eprint("usage: weft check [--jobs N] <path...>\n")
            2
          } else {
            let jobs = main_test_parse_jobs(mem_load64_at(argv, 24))
            if jobs == 0 {
              eprint("check: --jobs must be an integer from 1 to 64\n")
              2
            } else { run_check_paths(argc, argv, 4, jobs) }
          }
        } else { if argc == 3 { run_check_path(first) }
        else { run_check_paths(argc, argv, 2, 4) } }
      } else { run_check() }
    }
    else { if cstr_eq(cmd, "ast") == 1 {
      if argc > 2 { run_ast_path(mem_load64_at(argv, 16)) } else { run_ast() }
    }
    else { if cstr_eq(cmd, "test") == 1 {
      if argc > 2 {
        let first = mem_load64_at(argv, 16)
        if cstr_eq(first, "--emit") == 1 {
          if argc == 3 { run_test() }
          else { if argc == 4 { run_test_path(mem_load64_at(argv, 24)) }
          else { eprint("usage: weft test [--emit <path>] [--jobs N] <path...>\n") 1 } }
        } else { if cstr_eq(first, "--jobs") == 1 or cstr_eq(first, "-j") == 1 {
          if argc < 5 {
            eprint("usage: weft test [--emit <path>] [--jobs N] <path...>\n")
            1
          } else {
            let jobs = main_test_parse_jobs(mem_load64_at(argv, 24))
            if jobs == 0 {
              eprint("test: --jobs must be an integer from 1 to 64\n")
              1
            } else { run_test_paths(argc, argv, 4, jobs) }
          }
        } else {
          run_test_paths(argc, argv, 2, 4)
        } }
      } else { run_test() }
    }
    else { if cstr_eq(cmd, "mcp") == 1 {
      if argc > 2 and cstr_eq(mem_load64_at(argv, 16), "serve") == 1 { run_mcp_serve() } else { run_mcp() }
    }
    else { if cstr_eq(cmd, "lsp") == 1 { run_lsp() }
    else { if cstr_eq(cmd, "pkg") == 1 { run_pkg(argc, argv) }
    else { if cstr_eq(cmd, "explain") == 1 { run_explain(argc, argv) }
    else { if cstr_eq(cmd, "doc") == 1 { run_doc(argc, argv) }
    else { if cstr_eq(cmd, "symbols") == 1 {
      if argc > 2 { run_symbols_path(mem_load64_at(argv, 16)) } else { 0 }
    }
    else { if cstr_eq(cmd, "run") == 1 {
      match main_run_options(argc, argv) {
        MainRunOptionsReady(input, first_product_arg) -> match input {
          MainRunPath(path) -> main_run_path(
            path,
            argc,
            argv,
            first_product_arg,
            argv + (argc + 1) * 8
          )
          MainRunTarget(name) -> main_run_named(
            name,
            argc,
            argv,
            first_product_arg,
            argv + (argc + 1) * 8
          )
        }
        MainRunOptionsInvalid -> {
          eprint("usage: weft run [TARGET|PATH] [-- ARG...]\n")
          2
        }
      }
    }
    else { if cstr_eq(cmd, "build") == 1 {
      match main_build_options(argc, argv) {
        MainBuildOptionsReady(input, output_path, facts_path, debug_mode, target) -> match input {
          MainBuildPath(path) -> main_build_path(
            path,
            output_path,
            facts_path,
            debug_mode,
            target,
            argv + (argc + 1) * 8
          )
          MainBuildTarget(name) -> main_build_named(
            name,
            debug_mode,
            target,
            argv + (argc + 1) * 8
          )
        }
        MainBuildOptionsInvalid -> {
          eprint("usage: weft build [TARGET] [--target macos-aarch64|linux-aarch64] [--strip-debug]\n")
          eprint("       weft build PATH -o OUTPUT [--target macos-aarch64|linux-aarch64] [--artifact-facts PATH] [--strip-debug]\n")
          2
        }
      }
    }
    else { if cstr_eq(cmd, "compile") == 1 {
      if argc > 2 and cstr_eq(mem_load64_at(argv, 16), "--metrics") == 1 {
        if argc == 4 { compile_path_metrics(mem_load64_at(argv, 24)) }
        else {
          eprint("usage: weft compile [--metrics] PATH\n")
          2
        }
      } else { if argc > 2 and cstr_eq(mem_load64_at(argv, 16), "--rc-census") == 1 {
        if argc == 4 { compile_path_rc_census(mem_load64_at(argv, 24)) }
        else {
          eprint("usage: weft compile [--metrics|--rc-census] PATH\n")
          2
        }
      } else { if argc > 2 { compile_path(mem_load64_at(argv, 16)) }
      else {
        let input = read_stdin_all()
        let src = mem_load64_at(input, 0)
        let n = mem_load64_at(input, 8)
        compile(src, n)
      } } }
    }
    else {
      let input = read_stdin_all()
      let src = mem_load64_at(input, 0)
      let n = mem_load64_at(input, 8)
      compile(src, n)
    } } } } } } } } } } } } } } } }
  } else {
    let input = read_stdin_all()
    let src = mem_load64_at(input, 0)
    let n = mem_load64_at(input, 8)
    compile(src, n)
  }
}

fn main_command_uses_package_cache(argc: i64, argv: i64) -> bool {
  if argc <= 1 { true }
  else {
    let command = mem_load64_at(argv, 8)
    if cstr_eq(command, "--version") == 1 or cstr_eq(command, "version") == 1 or cstr_eq(command, "target") == 1 or cstr_eq(command, "explain") == 1 or cstr_eq(command, "pkg") == 1 { false }
    else { true }
  }
}

fn main_package_cache_preflight() -> i64 {
  runtime_standalone_package_io(() => match pkg_lock_verify_project_cache() {
    PackageCacheVerified -> 0
    PackageCacheLockMalformed -> {
      eprint("error[E5005]: package lock is malformed or unsupported\n")
      1
    }
    PackageCacheMissing(name, content) -> {
      eprint("error[E5011]: locked dependency '")
      eprint(name)
      eprint("' is absent from the immutable package cache (")
      eprint(content)
      eprint(")\n")
      1
    }
    PackageCacheCorrupt(name, content) -> {
      eprint("error[E5012]: immutable cache content for dependency '")
      eprint(name)
      eprint("' does not match ")
      eprint(content)
      eprint("\n")
      1
    }
  })
}

fn main_dispatch(argc: i64, argv: i64) -[SourceAcquire]> i64 {
  if main_command_uses_package_cache(argc, argv) and main_package_cache_preflight() != 0 { 1 }
  else { main_dispatch_unchecked(argc, argv) }
}

type MainExecutableLocation {
  MainExecutableLocated(str),
  MainExecutableUnresolved
}

type MainSdkLayout {
  MainBundledSdk(str),
  MainCheckoutSdk
}

fn main_path_exists(path: str) -> bool {
  let stat = alloc_zeroed(sys_stat_scratch_size())
  sys_stat_follow(runtime_str_cstring(path), stat) >= 0
}

fn main_path_parent(path: str) -> str {
  let ptr = __str_ptr(path)
  let len = __str_len(path)
  let mut slash = 0 - 1
  let mut index = 0
  while index < len {
    if mem_load8_at(ptr, index) == 47 { slash = index } else { 0 }
    index = index + 1
  }
  if slash < 0 { "" }
  else { if slash == 0 { "/" }
  else { runtime_str_from_bytes_copy(ptr, slash) } }
}

fn main_environment_path(envp: i64) -> str {
  let mut index = 0
  let mut path = ""
  while mem_load64_at(envp, index * 8) != 0 and __str_len(path) == 0 {
    let entry = mem_load64_at(envp, index * 8)
    let len = cstr_len(entry)
    if len >= 5 and src_eq_at(entry, 0, __str_ptr("PATH="), 0, 5) == 1 {
      path = runtime_str_from_bytes_copy(entry + 5, len - 5)
    } else { 0 }
    index = index + 1
  }
  path
}

fn main_find_executable_in_path(name: str, directories: Vector<str>, index: i64) -> MainExecutableLocation {
  if index >= vector_len<str>(directories) { MainExecutableUnresolved }
  else {
    let directory = vector_get_in_bounds<str>(directories, index)
    let base = if __str_len(directory) == 0 { "." } else { directory }
    let candidate = str_concat(str_concat(base, "/"), name)
    if main_path_exists(candidate) { MainExecutableLocated(candidate) }
    else { main_find_executable_in_path(name, directories, index + 1) }
  }
}

fn main_executable_location(argv: i64, envp: i64) -> MainExecutableLocation {
  let raw = mem_load64_at(argv, 0)
  let name = runtime_str_from_bytes_copy(raw, cstr_len(raw))
  if str_contains(name, "/") == 1 { MainExecutableLocated(name) }
  else {
    let path = main_environment_path(envp)
    if __str_len(path) == 0 { MainExecutableUnresolved }
    else { main_find_executable_in_path(name, str_split(path, ":"), 0) }
  }
}

fn main_sdk_layout(argc: i64, argv: i64) -> MainSdkLayout {
  let envp = argv + (argc + 1) * 8
  match main_executable_location(argv, envp) {
    MainExecutableUnresolved -> MainCheckoutSdk
    MainExecutableLocated(executable) -> {
      let sdk = str_concat(main_path_parent(executable), "/../lib/weft")
      let stdlib_marker = str_concat(sdk, "/stdlib/test.weft")
      let runtime_marker = str_concat(sdk, "/runtime/syscall.weft")
      if main_path_exists(stdlib_marker) and main_path_exists(runtime_marker) {
        MainBundledSdk(sdk)
      } else { MainCheckoutSdk }
    }
  }
}

fn main_dispatch_standalone(argc: i64, argv: i64) -> i64 {
  match main_sdk_layout(argc, argv) {
    MainBundledSdk(root) -> source_acquire_with_sdk(root, () => main_dispatch(argc, argv))
    MainCheckoutSdk -> source_acquire_with_standalone(() => main_dispatch(argc, argv))
  }
}

-- Color is presentation-only state. Machine renderers consume the structured
-- Diagnostic unchanged, while the human handler consults this policy exactly
-- once per source registry. Explicit CLI settings override NO_COLOR/TERM.
fn main(argc: i64, argv: i64) -> i64 {
  let envp = argv + (argc + 1) * 8
  terminal_set_stderr_color_mode(terminal_environment_color_mode(envp))
  if argc > 1 {
    let option = mem_load64_at(argv, 8)
    let inline_mode = main_inline_color_mode_arg(option)
    if inline_mode >= 0 {
      terminal_set_stderr_color_mode(inline_mode)
      main_dispatch_standalone(argc - 1, argv + 8)
    } else { if cstr_eq(option, "--no-color") == 1 {
      terminal_set_stderr_color_mode(terminal_color_mode_never())
      main_dispatch_standalone(argc - 1, argv + 8)
    } else { if cstr_eq(option, "--color") == 1 {
      if argc < 3 { main_color_usage_error("weft: --color requires auto, always, or never\n") }
      else {
        let mode = main_color_mode_arg(mem_load64_at(argv, 16))
        if mode < 0 { main_color_usage_error("weft: invalid --color value; expected auto, always, or never\n") }
        else {
          terminal_set_stderr_color_mode(mode)
          main_dispatch_standalone(argc - 2, argv + 16)
        }
      }
    } else { if main_cstr_starts_with(option, "--color=") == 1 {
      main_color_usage_error("weft: invalid --color value; expected auto, always, or never\n")
    } else { main_dispatch_standalone(argc, argv) } } } }
  } else { main_dispatch_standalone(argc, argv) }
}

-- ======================================================================
-- Tool: symbols — dump emitted function offsets for profile attribution
-- Prints one authoritative native-provenance fact per emitted function,
-- using a checked declaration name where one exists and h<hash> otherwise.
-- ======================================================================

fn oprint(msg: str) -> i64 {
  sys_write(1, __str_ptr(msg), __str_len(msg))
}

fn oprint_i(n: i64) -> i64 {
  if n < 0 {
    oprint("-")
    oprint_i(0 - n)
  } else {
    if n < 10 {
      let b = alloc_words(1)
      mem_store8_at(b, 0, 48 + n)
      sys_write(1, b, 1)
    } else {
      oprint_i(n / 10)
      oprint_i(n - n / 10 * 10)
    }
  }
}

fn main_dump_symbol_facts(facts: PipelineNativeProvenanceFactList) -> i64 {
  match facts {
    PipelineNativeProvenanceFactNil -> 0
    PipelineNativeProvenanceFactCons(fact, rest) -> {
      match fact {
        PipelineNativeProvenanceFact(start, end, hash, framed, src, location) -> {
          oprint_i(start)
          oprint(" ")
          match location {
            PipelineNativeSourceUnknown -> { oprint("h") oprint_i(hash) }
            PipelineNativeSourceKnown(name_src, name_start, name_len, path_ptr, path_len, line, col) -> sys_write(1, name_src + name_start, name_len)
          }
          oprint("\n")
        }
      }
      main_dump_symbol_facts(rest)
    }
  }
}

fn main_dump_symbols(native: NativeModule) -> i64 {
  main_dump_symbol_facts(pipeline_native_provenance_facts(native))
}

fn run_symbols_path(path: i64) -[SourceAcquire]> i64 {
  let plen = cstr_len(path)
  let file = read_cpath_file(path, plen)
  let src = mem_load64_at(file, 0)
  let n = mem_load64_at(file, 8)
  let typed = main_check_source_with_path_and_origin_and_grant(src, n, path, plen, cpath_is_trusted_source(path, plen), cpath_is_strict_source(path, plen), cpath_can_grant_import_trust(path, plen))
  let ir = pipeline_lower_ir(typed)
  let optimised = pipeline_optimise_typed_ir(typed, ir)
  let native = pipeline_lower_native_module(typed, optimised)
  main_dump_symbols(native)
}

-- ======================================================================
-- Tool: fmt — shared lossless parse-only engine
-- ======================================================================
fn main_fmt_result(src: i64, n: i64, path: i64, path_len: i64, trusted: i64) -> FormatterResult {
  let strict = pipeline_strict_for_trust(trusted)
  let tt = ttable_new()
  main_mark_root_origin_with_grant(tt, src, trusted, strict, 0)
  main_register_source_path(tt, src, n, path, path_len)
  let result = handle formatter_format_source(src, n, tt) {
    Diagnose.report(diagnostic) -> { pipeline_diagnose_render_report(tt, diagnostic) resume(0) }
    Diagnose.error(msg, span) -> { pipeline_diagnose_render(tt, src, msg, span) resume(0) }
    Diagnose.warn(msg, span) -> { pipeline_diagnose_render(tt, src, msg, span) resume(0) }
    Diagnose.note(msg, span) -> { pipeline_diagnose_render(tt, src, msg, span) resume(0) }
  }
  result
}

fn run_fmt_source_with_path(src: i64, n: i64, path: i64, path_len: i64, trusted: i64) -> i64 {
  match main_fmt_result(src, n, path, path_len, trusted) {
    FormatterSuccess(formatted) -> {
      sys_write(1, __str_ptr(formatted), __str_len(formatted))
      0
    }
    FormatterFailure(error_count) -> {
      eprint("fmt: parse failed with ")
      eprint_i(error_count)
      eprint(" errors; no output written\n")
      1
    }
  }
}

fn run_fmt_source(src: i64, n: i64, trusted: i64) -> i64 {
  run_fmt_source_with_path(src, n, 0, 0, trusted)
}

fn run_fmt_path(path: i64) -> i64 {
  let len = cstr_len(path)
  let file = read_cpath_file(path, len)
  let src = mem_load64_at(file, 0)
  let n = mem_load64_at(file, 8)
  if src == 0 {
    main_test_eprint_path_error("fmt: could not read input file: ", path)
    1
  } else {
    run_fmt_source_with_path(src, n, path, len, cpath_is_trusted_source(path, len))
  }
}

fn run_fmt() -> i64 {
  let input = read_stdin_all()
  run_fmt_source(mem_load64_at(input, 0), mem_load64_at(input, 8), 0)
}

fn main_fmt_bytes_equal(src: i64, n: i64, formatted: str) -> i64 {
  if n != __str_len(formatted) { 0 }
  else {
    let formatted_src = __str_ptr(formatted)
    let mut i = 0
    let mut equal = 1
    while i < n and equal == 1 {
      if mem_load8_at(src, i) != mem_load8_at(formatted_src, i) { equal = 0 }
      else { i = i + 1 }
    }
    equal
  }
}

fn main_fmt_lstat_mode(path: i64) -> i64 {
  -- The semantic leaf reports the normalised stat record, so read the mode
  -- through its accessor rather than at a Darwin `struct stat` byte offset.
  let stat_buf = alloc_zeroed(sys_stat_scratch_size())
  let status = sys_stat_nofollow(path, stat_buf)
  if status < 0 { 0 - 1 }
  else { sys_stat_mode(stat_buf) }
}

fn main_fmt_temp_path(path: i64) -> i64 {
  main_test_join_path(path, cstr_len(path), __str_ptr(".weft-fmt.tmp"), __str_len(".weft-fmt.tmp"))
}

-- Replace through an exclusive same-directory temporary. The original path
-- is untouched until every byte is written, permissions are restored, data
-- is synced, and the final rename succeeds.
fn main_fmt_atomic_write(path: i64, formatted: str, source_mode: i64) -> i64 {
  let temp = main_fmt_temp_path(path)
  let fd = sys_open_write_create_new(temp, source_mode band 4095)
  if fd < 0 {
    main_test_eprint_path_error("fmt: could not create temporary file: ", temp)
    1
  } else {
    let permission_status = sys_file_chmod(fd, source_mode band 4095)
    let write_status = if permission_status < 0 { 0 - permission_status }
    else { main_test_write_all(fd, __str_ptr(formatted), __str_len(formatted)) }
    let sync_status = if write_status != 0 { 0 } else { sys_file_flush(fd) }
    let close_status = sys_close(fd)
    if write_status != 0 or sync_status < 0 or close_status < 0 {
      sys_remove(temp)
      main_test_eprint_path_error("fmt: could not write temporary file: ", temp)
      1
    } else {
      let rename_status = sys_rename(temp, path)
      if rename_status < 0 {
        sys_remove(temp)
        main_test_eprint_path_error("fmt: could not replace source file: ", path)
        1
      } else { 0 }
    }
  }
}

fn main_fmt_write_result(path: i64, metadata: i64, formatted: str) -> i64 {
  let mode = node_f4(metadata)
  let lstat_mode = main_fmt_lstat_mode(path)
  if (mode band 61440) != 32768 {
    main_test_eprint_path_error("fmt: source is not a regular file: ", path)
    1
  } else { if lstat_mode < 0 {
    main_test_eprint_path_error("fmt: could not inspect source file: ", path)
    1
  } else { if (lstat_mode band 61440) == 40960 {
    main_test_eprint_path_error("fmt: refusing to replace symbolic link: ", path)
    1
  } else { if (mode band 146) == 0 {
    main_test_eprint_path_error("fmt: source file is read-only: ", path)
    1
  } else {
    main_fmt_atomic_write(path, formatted, mode)
  } } } }
}

-- operation 1 checks without mutation; operation 2 atomically rewrites.
fn main_fmt_process_path(path: i64, operation: i64) -> i64 {
  let path_len = cstr_len(path)
  let file = read_cpath_file(path, path_len)
  let src = mem_load64_at(file, 0)
  let n = mem_load64_at(file, 8)
  if src == 0 {
    main_test_eprint_path_error("fmt: could not read input file: ", path)
    1
  } else {
    match main_fmt_result(src, n, path, path_len, cpath_is_trusted_source(path, path_len)) {
      FormatterFailure(error_count) -> {
        eprint("fmt: parse failed for ")
        main_test_eprint_cpath(path)
        eprint(" with ")
        eprint_i(error_count)
        eprint(" errors; source left unchanged\n")
        1
      }
      FormatterSuccess(formatted) -> {
        if main_fmt_bytes_equal(src, n, formatted) == 1 { 0 }
        else { if operation == 1 {
          main_test_eprint_path_error("fmt: would reformat: ", path)
          1
        } else {
          -- Metadata is needed only for replacement safety. Acquiring it
          -- after parsing keeps check mode identical to the proven
          -- single-path formatter allocation shape, including large files.
          let metadata = main_test_path_metadata(path)
          if metadata == 0 {
            main_test_eprint_path_error("fmt: could not inspect source file: ", path)
            1
          } else { main_fmt_write_result(path, metadata, formatted) }
        } }
      }
    }
  }
}

fn main_fmt_expand_arg(paths: i64, arg: i64) -> i64 {
  let metadata = main_test_path_metadata(arg)
  if metadata != 0 and node_f1(metadata) == 1 {
    let status = main_test_collect_directory_recursive(paths, arg, metadata, "fmt: could not list directory: ")
    if status < 0 { 1 }
    else { if status == 0 {
      main_test_eprint_path_error("fmt: no .weft files in directory: ", arg)
      1
    } else { 0 } }
  } else {
    main_test_paths_add_sorted(paths, arg)
    0
  }
}

fn main_fmt_process_path_isolated(path: i64, operation: i64, worker_argv: i64, envp: i64, status_ptr: i64) -> i64 {
  mem_store64_at(worker_argv, 16, if operation == 1 { __str_ptr("--internal-check-one") } else { __str_ptr("--internal-write-one") })
  mem_store64_at(worker_argv, 24, path)
  let fork_result = sys_proc_fork()
  if fork_result < 0 {
    main_test_eprint_path_error("fmt: could not start formatter worker: ", path)
    1
  } else {
    if fork_result == 0 {
      sys_proc_exec(mem_load64_at(worker_argv, 0), worker_argv, envp)
      sys_exit(127)
    } else {
      mem_store64_at(status_ptr, 0, 0)
      let waited = main_test_wait_blocking(fork_result, status_ptr)
      if waited != fork_result {
        main_test_eprint_path_error("fmt: formatter worker failed: ", path)
        1
      } else {
        let result = main_test_decode_wait_status(status_ptr)
        if result == 0 { 0 } else { 1 }
      }
    }
  }
}

fn run_fmt_paths(argc: i64, argv: i64, first_path: i64, operation: i64) -> i64 {
  let paths = nlist_new()
  let status_ptr = alloc_zeroed(8)
  let worker_argv = alloc_zeroed(40)
  let envp = argv + (argc + 1) * 8
  let worker_executable = match main_executable_location(argv, envp) {
    MainExecutableLocated(executable) -> runtime_str_cstring(executable)
    MainExecutableUnresolved -> mem_load64_at(argv, 0)
  }
  mem_store64_at(worker_argv, 0, worker_executable)
  mem_store64_at(worker_argv, 8, __str_ptr("fmt"))
  let mut failures = 0
  for i in first_path..argc {
    failures = failures + main_fmt_expand_arg(paths, mem_load64_at(argv, i * 8))
  }
  for i in 0..nlist_len(paths) {
    -- A path's parse/render state dies with its short-lived worker. This
    -- keeps corpus-sized invocations bounded without rewinding allocations
    -- that managed cleanup or process-global compiler state may still own.
    -- Waiting immediately retains deterministic path/diagnostic order.
    failures = failures + main_fmt_process_path_isolated(nlist_get(paths, i), operation, worker_argv, envp, status_ptr)
  }
  if failures == 0 { 0 } else { 1 }
}

fn run_fmt_command(argc: i64, argv: i64) -> i64 {
  if argc == 2 { run_fmt() }
  else {
    let first = mem_load64_at(argv, 16)
    if cstr_eq(first, "--internal-check-one") == 1 or cstr_eq(first, "--internal-write-one") == 1 {
      if argc == 4 {
        main_fmt_process_path(mem_load64_at(argv, 24), if cstr_eq(first, "--internal-check-one") == 1 { 1 } else { 2 })
      } else { 1 }
    } else { if cstr_eq(first, "--check") == 1 or cstr_eq(first, "--write") == 1 {
      if argc < 4 {
        eprint("usage: weft fmt [path]\nusage: weft fmt (--check | --write) <path...>\n")
        1
      } else {
        run_fmt_paths(argc, argv, 3, if cstr_eq(first, "--check") == 1 { 1 } else { 2 })
      }
    } else { if argc == 3 { run_fmt_path(first) }
    else {
      eprint("usage: weft fmt [path]\nusage: weft fmt (--check | --write) <path...>\n")
      1
    } } }
  }
}

-- ======================================================================
-- Tool: check — type check only (parse + check, no codegen)
-- ======================================================================

fn test_tool_prefix() -> str {
  let prefix = buf_new(32)
  bstr(prefix, "use stdlib/test.")
  bu8(prefix, 123)
  bu8(prefix, 42)
  bu8(prefix, 125)
  bu8(prefix, 32)
  runtime_str_from_bytes_copy(buf_ptr(prefix), buf_len(prefix))
}

fn test_source_with_prefix(raw: i64, raw_n: i64) -> i64 {
  test_source_with_prefix_and_wrappers(raw, raw_n, 0)
}

fn test_append_wrapper_name_bank(buf: i64, index: i64, count: i64) -> i64 {
  if index >= count { buf_len(buf) }
  else {
    test_append_harness_test_wrapper_name(buf, index)
    buf_append_str(buf, " ")
    test_append_wrapper_name_bank(buf, index + 1, count)
  }
}

fn test_source_with_prefix_and_wrappers(raw: i64, raw_n: i64, wrapper_count: i64) -> i64 {
  let prepared = test_prepare_source(runtime_str_from_bytes_copy(raw, raw_n), wrapper_count)
  let content = test_prepare_source_content(prepared)
  let content_len = __str_len(content)
  let src = main_alloc_bytes(content_len + 1)
  mem_copy(src, __str_ptr(content), content_len)
  mem_store8_at(src + content_len, 0, 0)
  node_new(0, src, content_len, test_prepare_source_wrapper_bank_start(prepared), 0)
}

fn test_source_wrapper_bank_start(prefixed: i64) -> i64 {
  node_f3(prefixed)
}

type TestHarnessDeclEntry {
  TestHarnessDeclEntry(Decl, i64), -- typed decl, source pointer
  UnknownTestHarnessDeclEntry
}

type TestHarnessDeclList {
  TestHarnessDeclListNil,
  TestHarnessDeclListCons(TestHarnessDeclEntry, TestHarnessDeclList)
}

fn test_harness_decl_entry_from_pair(pair: i64) -> TestHarnessDeclEntry {
  TestHarnessDeclEntry(decl_from_node(node_f1(pair)), node_f2(pair))
}

fn test_harness_decl_entry_is_test(entry: TestHarnessDeclEntry) -> i64 {
  match entry {
    TestHarnessDeclEntry(decl, decl_src) -> {
      match decl {
        TestDecl(ns, nl, body) -> 1
        _ -> 0
      }
    }
    UnknownTestHarnessDeclEntry -> 0
  }
}

fn test_harness_decl_list_empty() -> TestHarnessDeclList {
  TestHarnessDeclListNil
}

fn test_harness_decl_list_prepend(entry: TestHarnessDeclEntry, rest: TestHarnessDeclList) -> TestHarnessDeclList {
  TestHarnessDeclListCons(entry, rest)
}

fn test_harness_decl_list_len(entries: TestHarnessDeclList) -> i64 {
  match entries {
    TestHarnessDeclListNil -> 0
    TestHarnessDeclListCons(entry, rest) -> 1 + test_harness_decl_list_len(rest)
  }
}

fn test_harness_decl_list_reverse_into(entries: TestHarnessDeclList, acc: TestHarnessDeclList) -> TestHarnessDeclList {
  match entries {
    TestHarnessDeclListNil -> acc
    TestHarnessDeclListCons(entry, rest) -> test_harness_decl_list_reverse_into(rest, TestHarnessDeclListCons(entry, acc))
  }
}

fn test_harness_decl_list_reverse(entries: TestHarnessDeclList) -> TestHarnessDeclList {
  test_harness_decl_list_reverse_into(entries, TestHarnessDeclListNil)
}

fn fns_have_tests(fns: i64) -> i64 {
  test_prepare_fns_have_tests(fns)
}

fn fns_test_count(fns: i64) -> i64 {
  test_prepare_fns_test_count(fns)
}

fn check_wrap_test_blocks(fns: i64, name_bank_start: i64, tt: i64) -> i64 {
  test_prepare_wrap_fns(fns, name_bank_start, tt)
}

fn run_check_report(nfns: i64, errors: i64) -> i64 {
  eprint("check: ")
  eprint_i(nfns)
  eprint(" functions, ")
  eprint_i(errors)
  eprint(" errors\n")
  if errors == 0 { 0 } else { 1 }
}

fn main_render_project_diagnostics(diagnostics: ProjectDiagnostics) -> i64 {
  for i in 0..project_diagnostics_len(diagnostics) {
    let diagnostic = project_diagnostics_get(diagnostics, i)
    let src = project_diagnostics_item_source(diagnostics, i)
    let tt = project_diagnostics_item_type_table(diagnostics, i)
    if project_diagnostics_item_is_legacy(diagnostics, i) {
      pipeline_diagnose_render(tt, src, diagnose_report_message(diagnostic), diagnose_report_absolute_span(diagnostic))
    } else { pipeline_diagnose_render_report(tt, diagnostic) }
  }
  project_diagnostics_error_count(diagnostics)
}

fn main_project_typed_function_count(typed: TypedModule) -> i64 {
  match typed { TypedModule(fns, src, tt) -> nlist_len(fns) }
}

fn main_project_ast_function_count(ast: AstModule) -> i64 {
  match ast { AstModule(fns, src, tt) -> nlist_len(fns) }
}

fn run_check_project_parse_failure(result: ProjectPreparedParseResult) -> i64 {
  match result {
    ProjectPreparedParseFailed(ast, source_n, diagnostics) -> {
      let errors = main_render_project_diagnostics(diagnostics)
      run_check_report(main_project_ast_function_count(ast), errors)
    }
    ProjectPreparedParseSourceUnset -> { eprint("check: could not read input file\n") 1 }
    ProjectPreparedParseCycle(cycle) -> { eprint("check: project dependency cycle\n") 1 }
    ProjectPreparedParseCorrupt -> { eprint("check: project session is corrupt\n") 1 }
    ProjectPreparedParseSucceeded(ast, source_n, diagnostics) -> {
      let errors = main_render_project_diagnostics(diagnostics)
      run_check_report(main_project_ast_function_count(ast), errors)
    }
  }
}

fn run_check_project_result(result: ProjectCheckResult) -> i64 {
  match result {
    ProjectCheckSucceeded(typed, source_n, parse_diagnostics, check_diagnostics) -> {
      let errors = main_render_project_diagnostics(parse_diagnostics) + main_render_project_diagnostics(check_diagnostics)
      run_check_report(main_project_typed_function_count(typed), errors)
    }
    ProjectCheckFailed(typed, source_n, parse_diagnostics, check_diagnostics) -> {
      let errors = main_render_project_diagnostics(parse_diagnostics) + main_render_project_diagnostics(check_diagnostics)
      run_check_report(main_project_typed_function_count(typed), errors)
    }
    ProjectCheckParseFailed(parse) -> run_check_project_parse_failure(parse)
    ProjectCheckSourceUnset -> { eprint("check: could not read input file\n") 1 }
    ProjectCheckCycle(cycle) -> { eprint("check: project dependency cycle\n") 1 }
    ProjectCheckCorrupt -> { eprint("check: project session is corrupt\n") 1 }
  }
}

fn main_mark_root_origin_with_grant(tt: i64, src: i64, trusted: i64, strict: i64, can_grant_trust: i64) -> i64 {
  pipeline_mark_root_origin(tt, src, trusted, strict)
  if can_grant_trust == 1 {
    ttable_mark_source_trust_grant_source(tt, src)
  } else { 0 }
}

fn run_check_source_with_path(raw: i64, raw_n: i64, path_ptr: i64, path_len: i64, trusted: i64, strict: i64, can_grant_trust: i64) -[SourceAcquire]> i64 {
  let grammar = weft_grammar()
  let probe_tt = ttable_new()
  main_mark_root_origin_with_grant(probe_tt, raw, trusted, strict, can_grant_trust)
  main_register_source_path(probe_tt, raw, raw_n, path_ptr, path_len)
  match pipeline_parse_with_error_count(grammar, raw, raw_n, probe_tt) {
    PipelineParseResult(probe_fns, parse_errors) -> {
      if parse_errors != 0 {
        run_check_report(nlist_len(probe_fns), parse_errors)
      } else { if fns_have_tests(probe_fns) == 1 {
        let prefixed = test_source_with_prefix_and_wrappers(raw, raw_n, fns_test_count(probe_fns))
        let src = node_f1(prefixed)
        let n = node_f2(prefixed)
        let name_bank_start = test_source_wrapper_bank_start(prefixed)
        let tt = ttable_new()
        main_mark_root_origin_with_grant(tt, src, trusted, strict, can_grant_trust)
        main_register_source_path(tt, src, n, path_ptr, path_len)
        let fns = pipeline_parse(grammar, src, n, tt)
        let regular = check_wrap_test_blocks(fns, name_bank_start, tt)
        pipeline_bind_runtime_preludes(regular, src, tt)
        let errors = pipeline_check_fns_error_count(regular, src, tt)
        run_check_report(nlist_len(regular), errors)
      } else {
        pipeline_bind_runtime_preludes(probe_fns, raw, probe_tt)
        let errors = pipeline_check_fns_error_count(probe_fns, raw, probe_tt)
        run_check_report(nlist_len(probe_fns), errors)
      } }
    }
  }
}

fn main_project_register_root(tt: i64, src: i64, trusted: i64, strict: i64, can_grant_trust: i64) -> i64 {
  main_mark_root_origin_with_grant(tt, src, trusted, strict, can_grant_trust)
}

fn run_check_source(raw: i64, raw_n: i64, trusted: i64, strict: i64, can_grant_trust: i64) -[SourceAcquire]> i64 {
  run_check_source_with_path(raw, raw_n, 0, 0, trusted, strict, can_grant_trust)
}

fn main_check_context(path: i64) -> ProjectQueryContext {
  let len = cstr_len(path)
  let source_path = runtime_str_from_bytes_copy(path, len)
  project_query_context_with_trust(
    0,
    source_path,
    source_path,
    project_source_origin_disk(),
    0,
    1,
    cpath_is_trusted_source(path, len),
    cpath_is_strict_source(path, len),
    cpath_can_grant_import_trust(path, len)
  )
}

fn main_check_register_path(session: ProjectSession, path: i64) -> i64 {
  let len = cstr_len(path)
  let file = read_cpath_file(path, len)
  let src = mem_load64_at(file, 0)
  let n = mem_load64_at(file, 8)
  if n <= 0 {
    project_session_set_missing(session, main_check_context(path))
    0
  } else {
    project_session_set_source(session, main_check_context(path), runtime_str_from_bytes_copy(src, n))
    1
  }
}

fn main_check_registered_path(session: ProjectSession, path: i64) -[SourceAcquire]> i64 {
  run_check_project_result(project_session_check_with_acquire(session, main_check_context(path)))
}

fn run_check_path(path: i64) -[SourceAcquire]> i64 {
  let session = project_session_new_with_root_registration(1, main_project_register_root)
  main_check_register_path(session, path)
  main_check_registered_path(session, path)
}

fn main_check_output_path(owner_pid: i64, index: i64) -> i64 {
  let prefix = "/tmp/weft-check-output-"
  let prefix_len = __str_len(prefix)
  let len = prefix_len + main_test_decimal_len(owner_pid) + 1 + main_test_decimal_len(index)
  let path = alloc_zeroed(len + 1)
  mem_copy(path, __str_ptr(prefix), prefix_len)
  let after_pid = main_test_write_decimal(path, prefix_len, owner_pid)
  mem_store8_at(path, after_pid, 45)
  main_test_write_decimal(path, after_pid + 1, index)
  path
}

fn main_check_redirect_stderr(path: i64) -> i64 {
  let fd = sys_open_write_create_truncate(path, 384)
  if fd < 0 { 1 }
  else {
    let status = if fd == 2 { 0 } else { sys_proc_dup_to(fd, 2) }
    if fd != 2 { sys_close(fd) } else { 0 }
    if status < 0 { 1 } else { 0 }
  }
}

fn main_check_spawn_worker(session: ProjectSession, path: i64, index: i64, owner_pid: i64) -[SourceAcquire]> i64 {
  let output_path = main_check_output_path(owner_pid, index)
  sys_remove(output_path)
  let fork_result = sys_proc_fork()
  if fork_result < 0 { fork_result }
  else {
    if fork_result == 0 {
      if main_check_redirect_stderr(output_path) != 0 { sys_exit(2) }
      else { sys_exit(main_check_registered_path(session, path)) }
    } else { fork_result }
  }
}

fn main_check_replay_result(path: i64, owner_pid: i64, index: i64, result: i64, peak_rss_bytes: i64) -> i64 {
  eprint("==> ")
  main_test_eprint_cpath(path)
  eprint(" <==\n")
  let output_path = main_check_output_path(owner_pid, index)
  let output = read_cpath_file(output_path, cstr_len(output_path))
  let raw = mem_load64_at(output, 0)
  let n = mem_load64_at(output, 8)
  if raw != 0 and n > 0 { sys_write(2, raw, n) }
  else { if result != 0 {
    eprint("check: worker produced no diagnostic output\n")
  } else { 0 } }
  if result == 124 { eprint("check: worker timed out\n") }
  else { if result == 125 {
    eprint("check: worker exceeded ")
    eprint_i((peak_rss_bytes + 1023) / 1024)
    eprint(" KB RSS\n")
  } else { if result > 125 { eprint("check: worker failed\n") } else { 0 } } }
  sys_remove(output_path)
  0
}

fn main_check_run_paths_parallel(paths: i64, envp: i64, jobs: i64) -[SourceAcquire]> i64 {
  let count = nlist_len(paths)
  let pids = alloc_zeroed(jobs * 8)
  let indexes = alloc_zeroed(jobs * 8)
  let starts = alloc_zeroed(jobs * 8)
  let usages = alloc_zeroed(jobs * 256)
  let results = alloc_zeroed(count * 8)
  let peaks = alloc_zeroed(count * 8)
  let status_ptr = alloc_zeroed(8)
  let pause = alloc_zeroed(16)
  let owner_pid = sys_proc_id()
  let timeout_millis = main_test_compile_timeout_millis(envp)
  let rss_limit_kb = main_test_rss_limit_kb(envp)
  let session = project_session_new_with_root_registration(1, main_project_register_root)
  for i in 0..count {
    main_check_register_path(session, nlist_get(paths, i))
    mem_store64_at(results, i * 8, 0 - 1)
  }
  let mut next = 0
  let mut active = 0
  while next < count or active > 0 {
    while next < count and active < jobs {
      let slot = main_test_find_free_worker(pids, jobs)
      let pid = main_check_spawn_worker(session, nlist_get(paths, next), next, owner_pid)
      if pid < 0 {
        mem_store64_at(results, next * 8, 127)
      } else {
        mem_store64_at(pids, slot * 8, pid)
        mem_store64_at(indexes, slot * 8, next)
        mem_store64_at(starts, slot * 8, main_test_now_millis())
        active = active + 1
      }
      next = next + 1
    }
    let mut progressed = 0
    let mut slot = 0
    while slot < jobs {
      let pid = mem_load64_at(pids, slot * 8)
      if pid != 0 {
        mem_store64_at(status_ptr, 0, 0)
        let usage = usages + slot * 256
        let waited = sys_proc_wait_usage(pid, status_ptr, 1, usage)
        let now = main_test_now_millis()
        let start = mem_load64_at(starts, slot * 8)
        let expired = start >= 0 and now >= start and now - start >= timeout_millis
        let mut result = 0 - 1
        let mut complete = 0
        if waited == pid {
          result = main_test_decode_wait_status(status_ptr)
          complete = 1
        } else { if waited < 0 and waited != 0 - 4 {
          result = 127
          complete = 1
        } else { if expired {
          sys_proc_kill(pid)
          let reaped = main_test_wait_blocking_with_usage(pid, status_ptr, usage)
          result = if reaped == pid { 124 } else { 127 }
          complete = 1
        } else { 0 } } }
        if complete == 1 {
          let index = mem_load64_at(indexes, slot * 8)
          let peak = mem_load64_at(usage, 32)
          if result <= 1 and rss_limit_kb > 0 and peak > rss_limit_kb * 1024 { result = 125 } else { 0 }
          mem_store64_at(results, index * 8, result)
          mem_store64_at(peaks, index * 8, peak)
          mem_store64_at(pids, slot * 8, 0)
          active = active - 1
          progressed = 1
        } else { 0 }
      } else { 0 }
      slot = slot + 1
    }
    if active > 0 and progressed == 0 { main_test_pause_poll(pause) } else { 0 }
  }
  let mut failures = 0
  for i in 0..count {
    let result = mem_load64_at(results, i * 8)
    main_check_replay_result(nlist_get(paths, i), owner_pid, i, result, mem_load64_at(peaks, i * 8))
    if result == 0 { 0 } else { failures = failures + 1 }
  }
  -- The inherited workers retain source/query pointers owned by this session.
  project_session_database(session)
  failures
}

fn run_check_paths(argc: i64, argv: i64, first_path: i64, jobs: i64) -[SourceAcquire]> i64 {
  let paths = nlist_new()
  for i in first_path..argc { nlist_add(paths, mem_load64_at(argv, i * 8)) }
  if nlist_len(paths) == 0 {
    eprint("usage: weft check [--jobs N] <path...>\n")
    2
  } else {
    let failures = main_check_run_paths_parallel(paths, argv + (argc + 1) * 8, jobs)
    if failures == 0 { 0 } else { 1 }
  }
}

fn run_check() -[SourceAcquire]> i64 {
  let input = read_stdin_all()
  run_check_source(mem_load64_at(input, 0), mem_load64_at(input, 8), 0, 1, 0)
}

-- ======================================================================
-- Tool: ast — dump AST structure (parse only)
-- ======================================================================

fn dump_node(node: i64, src: i64, indent: i64) -> i64 {
  let tag = node_tag(node)
  let mut j = 0
  while j < indent { eprint("  ") j = j + 1 }
  match tag {
    1 -> {
      eprint("IntLit(")
      if node_f3(node) > 0 { sys_write(2, src + node_f2(node), node_f3(node)) } else { eprint_i(node_f1(node)) }
      eprint(")\n")
    }
    2 -> { eprint("Ident(") sys_write(2, src + node_f1(node), node_f2(node)) eprint(")\n") }
    3 -> {
      eprint("BinOp(op=") eprint_i(node_f1(node)) eprint(")\n")
      dump_node(node_f2(node), src, indent + 1)
      dump_node(node_f3(node), src, indent + 1)
    }
    4 -> {
      eprint("Call(") sys_write(2, src + node_f1(node), node_f2(node))
      eprint(", nargs=") eprint_i(node_f4(node)) eprint(")\n")
    }
    5 -> {
      eprint("If\n")
      dump_node(node_f1(node), src, indent + 1)
      dump_node(node_f2(node), src, indent + 1)
      if node_f3(node) != 0 { dump_node(node_f3(node), src, indent + 1) } else { 0 }
    }
    6 -> {
      eprint("Let(") sys_write(2, src + node_f1(node), node_f2(node)) eprint(")\n")
      dump_node(node_f3(node), src, indent + 1)
      dump_node(node_f4(node), src, indent + 1)
    }
    7 -> {
      eprint("Block\n")
      dump_node(node_f1(node), src, indent + 1)
      if node_f2(node) != 0 { dump_node(node_f2(node), src, indent + 1) } else { 0 }
    }
    9 -> eprint("StringLit\n")
    54 -> { eprint("FloatLit(") sys_write(2, src + node_f1(node), node_f2(node)) eprint(")\n") }
    15 -> {
      eprint("Match(narms=") eprint_i(node_f3(node)) eprint(")\n")
      dump_node(node_f1(node), src, indent + 1)
    }
    24 -> {
      eprint("BoolLit(")
      if node_f1(node) == 1 { eprint("true") } else { eprint("false") }
      eprint(")\n")
    }
    52 -> {
      eprint("Defer\n")
      dump_node(node_f1(node), src, indent + 1)
      dump_node(node_f2(node), src, indent + 1)
    }
    37 -> {
      eprint("LetTyped(type_tag=") eprint_i(node_tag(node_f2(node))) eprint(", type_payload=") eprint_i(node_f1(node_f2(node))) eprint(")\n")
      dump_node(node_f1(node), src, indent + 1)
    }
    _ -> { eprint("Node(tag=") eprint_i(tag) eprint(")\n") }
  }
  0
}

fn ast_dump_decl(decl: Decl, decl_src: i64) -> i64 {
  match decl {
    TestDecl(ns, nl, body) -> {
      eprint("test ")
      sys_write(2, decl_src + ns, nl)
      eprint(":\n")
      dump_node(expr_to_node(body), decl_src, 1)
      eprint("\n")
    }
    FnDecl(ns, nl, params, body) -> {
      eprint("fn ")
      sys_write(2, decl_src + ns, nl)
      eprint(":\n")
      dump_node(expr_to_node(body), decl_src, 1)
      eprint("\n")
    }
    FnDeclWrapped(inner, ret_type, eff_sig, tparams) -> ast_dump_decl(inner, decl_src)
    _ -> {
      eprint("decl tag=")
      eprint_i(decl_tag(decl))
      eprint("\n\n")
    }
  }
}

fn run_ast_source(src: i64, n: i64, trusted: i64) -> i64 {
  let tt = ttable_new()
  pipeline_mark_root_origin(tt, src, trusted, pipeline_strict_for_trust(trusted))
  let parsed = pipeline_parse_local_with_error_count(weft_grammar(), src, n, tt)
  let fns = match parsed { PipelineParseResult(parsed_fns, errors) -> parsed_fns }
  let nfns = nlist_len(fns)
  eprint("--- AST: ")
  eprint_i(nfns)
  eprint(" functions ---\n\n")
  for i in 0..nfns {
    let pair = nlist_get(fns, i)
    ast_dump_decl(decl_from_node(node_f1(pair)), node_f2(pair))
  }
  0
}

fn run_ast_path(path: i64) -> i64 {
  let len = cstr_len(path)
  let file = read_cpath_file(path, len)
  let src = mem_load64_at(file, 0)
  let n = mem_load64_at(file, 8)
  if n <= 0 {
    eprint("ast: could not read input file\n")
    1
  } else {
    run_ast_source(src, n, cpath_is_trusted_source(path, len))
  }
}

fn run_ast() -> i64 {
  let input = read_stdin_all()
  run_ast_source(mem_load64_at(input, 0), mem_load64_at(input, 8), 0)
}

-- ======================================================================
-- Tool: mcp — stateless JSON-RPC compiler-as-data queries
-- ======================================================================

-- MCP output writers append to a response buffer; the transport layer
-- (legacy one-shot envelope or the persistent serve loop) owns the
-- envelope and the actual stdout write.
fn mcp_write(b: i64, s: str) -> i64 {
  bstr(b, s)
  0
}

fn mcp_write_i(b: i64, n: i64) -> i64 {
  if n < 0 { mcp_write(b, "-") mcp_write_i(b, 0 - n) }
  else {
    if n < 10 {
      bu8(b, 48 + n)
    } else {
      mcp_write_i(b, n / 10)
      bu8(b, 48 + n - n / 10 * 10)
    }
    0
  }
}

fn mcp_write_json_byte(b: i64, ch: i64) -> i64 {
  bu8(b, ch)
  0
}

fn mcp_write_json_bytes(b: i64, ptr: i64, n: i64) -> i64 {
  mcp_write(b, "\"")
  let mut i = 0
  while i < n {
    let ch = mem_load8_at(ptr, i)
    if ch == 34 {
      mcp_write(b, "\\\"")
    } else { if ch == 92 {
      mcp_write(b, "\\\\")
    } else { if ch == 10 {
      mcp_write(b, "\\n")
    } else { if ch == 13 {
      mcp_write(b, "\\r")
    } else { if ch == 9 {
      mcp_write(b, "\\t")
    } else {
      if ch >= 32 { mcp_write_json_byte(b, ch) } else { 0 }
    } } } } }
    i = i + 1
  }
  mcp_write(b, "\"")
}

fn mcp_is_json_ws(ch: i64) -> i64 {
  match ch {
    32 -> 1
    10 -> 1
    13 -> 1
    9 -> 1
    _ -> 0
  }
}

fn mcp_skip_json_ws(src: i64, n: i64, pos: i64) -> i64 {
  let mut p = pos
  while p < n and mcp_is_json_ws(mem_load8_at(src, p)) == 1 {
    p = p + 1
  }
  p
}

fn mcp_json_result(ok: i64, pos: i64) -> i64 {
  let result = main_alloc_bytes(16)
  mem_store64_at(result, 0, ok)
  mem_store64_at(result, 8, pos)
  result
}

fn mcp_json_ok(pos: i64) -> i64 { mcp_json_result(1, pos) }
fn mcp_json_bad(pos: i64) -> i64 { mcp_json_result(0, pos) }
fn mcp_json_result_ok(result: i64) -> i64 { mem_load64_at(result, 0) }
fn mcp_json_result_pos(result: i64) -> i64 { mem_load64_at(result, 8) }

fn mcp_json_content_has_escape(src: i64, start: i64, len: i64) -> i64 {
  let mut i = 0
  let mut found = 0
  while i < len and found == 0 {
    if mem_load8_at(src, start + i) == 92 { found = 1 } else { i = i + 1 }
  }
  found
}

fn mcp_json_key_eq(src: i64, n: i64, key_start: i64, key_len: i64, key: str) -> i64 {
  if mcp_json_content_has_escape(src, key_start, key_len) == 0 { src_eq(src, key_start, key_len, key) }
  else {
    let decoded = mcp_decode_json_string_pair(src, n, key_start - 1)
    src_eq(mem_load64_at(decoded, 0), 0, mem_load64_at(decoded, 8), key)
  }
}

fn mcp_hex_digit_value(ch: i64) -> i64 {
  if ch >= 48 and ch <= 57 { ch - 48 }
  else { if ch >= 97 and ch <= 102 { ch - 87 }
  else { if ch >= 65 and ch <= 70 { ch - 55 }
  else { 0 - 1 } } }
}

-- Parse exactly four hex digits at pos; the code unit value, or -1.
fn mcp_json_hex4(src: i64, n: i64, pos: i64) -> i64 {
  if pos + 4 > n { 0 - 1 }
  else {
    let d0 = mcp_hex_digit_value(mem_load8_at(src, pos))
    let d1 = mcp_hex_digit_value(mem_load8_at(src + pos, 1))
    let d2 = mcp_hex_digit_value(mem_load8_at(src + pos, 2))
    let d3 = mcp_hex_digit_value(mem_load8_at(src + pos, 3))
    if d0 < 0 or d1 < 0 or d2 < 0 or d3 < 0 { 0 - 1 }
    else { d0 * 4096 + d1 * 256 + d2 * 16 + d3 }
  }
}

fn mcp_json_utf8_is_valid(src: i64, n: i64) -> i64 {
  let mut pos = 0
  let mut valid = 1
  while pos < n and valid == 1 {
    let width = source_position_utf8_width(src, n, pos)
    if width < 0 { valid = 0 } else { pos = pos + width }
  }
  valid
}

fn mcp_json_parse_string(src: i64, n: i64, pos: i64) -> i64 {
  if pos >= n { mcp_json_bad(pos) }
  else { if mem_load8_at(src, pos) != 34 { mcp_json_bad(pos) }
  else {
    let mut p = pos + 1
    let mut done = 0
    let mut ok = 1
    while p < n and done == 0 and ok == 1 {
      let ch = mem_load8_at(src, p)
      match ch {
        34 -> { done = 1 p = p + 1 }
        92 -> {
          if p + 1 >= n { ok = 0 }
          else {
            let esc = mem_load8_at(src + p, 1)
            match esc {
              34 -> { p = p + 2 }
              47 -> { p = p + 2 }
              92 -> { p = p + 2 }
              98 -> { p = p + 2 }
              102 -> { p = p + 2 }
              110 -> { p = p + 2 }
              114 -> { p = p + 2 }
              116 -> { p = p + 2 }
              117 -> {
                let first = mcp_json_hex4(src, n, p + 2)
                if first < 0 { ok = 0 }
                else { if first >= 55296 and first <= 56319 {
                  if p + 12 > n or mem_load8_at(src, p + 6) != 92 or mem_load8_at(src, p + 7) != 117 { ok = 0 }
                  else {
                    let low = mcp_json_hex4(src, n, p + 8)
                    if low < 56320 or low > 57343 { ok = 0 } else { p = p + 12 }
                  }
                } else { if first >= 56320 and first <= 57343 { ok = 0 }
                else { p = p + 6 } } }
              }
              _ -> { ok = 0 }
            }
          }
        }
        10 -> { ok = 0 }
        13 -> { ok = 0 }
        _ -> {
          if ch < 32 { ok = 0 } else { p = p + 1 }
        }
      }
    }
    if ok == 1 and done == 1 { mcp_json_ok(p) } else { mcp_json_bad(p) }
  } }
}

fn mcp_json_parse_literal(src: i64, n: i64, pos: i64, literal: str) -> i64 {
  let len = __str_len(literal)
  if pos + len > n { mcp_json_bad(pos) }
  else {
    if src_eq(src, pos, len, literal) == 1 { mcp_json_ok(pos + len) }
    else { mcp_json_bad(pos) }
  }
}

fn mcp_json_parse_number(src: i64, n: i64, pos: i64) -> i64 {
  let mut p = pos
  if p < n and mem_load8_at(src, p) == 45 { p = p + 1 } else { 0 }
  if p >= n { mcp_json_bad(pos) }
  else {
    let first = mem_load8_at(src, p)
    if is_digit(first) == 0 { mcp_json_bad(pos) }
    else {
      if first == 48 { p = p + 1 }
      else {
        while p < n and is_digit(mem_load8_at(src, p)) == 1 { p = p + 1 }
      }
      let mut ok = 1
      if p < n and mem_load8_at(src, p) == 46 {
        p = p + 1
        if p >= n { ok = 0 }
        else {
          let mut ndigits = 0
          while p < n and is_digit(mem_load8_at(src, p)) == 1 {
            p = p + 1
            ndigits = ndigits + 1
          }
          if ndigits == 0 { ok = 0 } else { 0 }
        }
      } else { 0 }
      if ok == 1 and p < n and (mem_load8_at(src, p) == 101 or mem_load8_at(src, p) == 69) {
        p = p + 1
        if p < n and (mem_load8_at(src, p) == 43 or mem_load8_at(src, p) == 45) { p = p + 1 } else { 0 }
        let mut ndigits = 0
        while p < n and is_digit(mem_load8_at(src, p)) == 1 {
          p = p + 1
          ndigits = ndigits + 1
        }
        if ndigits == 0 { ok = 0 } else { 0 }
      } else { 0 }
      if ok == 1 { mcp_json_ok(p) } else { mcp_json_bad(pos) }
    }
  }
}

fn mcp_json_parse_array(src: i64, n: i64, pos: i64) -> i64 {
  let mut p = mcp_skip_json_ws(src, n, pos + 1)
  if p < n and mem_load8_at(src, p) == 93 { mcp_json_ok(p + 1) }
  else {
    let mut ok = 1
    let mut done = 0
    while ok == 1 and done == 0 {
      let value = mcp_json_parse_value(src, n, p)
      if mcp_json_result_ok(value) == 0 { ok = 0 p = mcp_json_result_pos(value) }
      else {
        p = mcp_skip_json_ws(src, n, mcp_json_result_pos(value))
        if p < n and mem_load8_at(src, p) == 44 {
          p = mcp_skip_json_ws(src, n, p + 1)
        } else { if p < n and mem_load8_at(src, p) == 93 {
          p = p + 1
          done = 1
        } else { ok = 0 } }
      }
    }
    if ok == 1 { mcp_json_ok(p) } else { mcp_json_bad(p) }
  }
}

fn mcp_json_parse_object(src: i64, n: i64, pos: i64) -> i64 {
  let mut p = mcp_skip_json_ws(src, n, pos + 1)
  if p < n and mem_load8_at(src, p) == 125 { mcp_json_ok(p + 1) }
  else {
    let mut ok = 1
    let mut done = 0
    while ok == 1 and done == 0 {
      let key = mcp_json_parse_string(src, n, p)
      if mcp_json_result_ok(key) == 0 { ok = 0 p = mcp_json_result_pos(key) }
      else {
        p = mcp_skip_json_ws(src, n, mcp_json_result_pos(key))
        if p >= n or mem_load8_at(src, p) != 58 { ok = 0 }
        else {
          p = mcp_skip_json_ws(src, n, p + 1)
          let value = mcp_json_parse_value(src, n, p)
          if mcp_json_result_ok(value) == 0 { ok = 0 p = mcp_json_result_pos(value) }
          else {
            p = mcp_skip_json_ws(src, n, mcp_json_result_pos(value))
            if p < n and mem_load8_at(src, p) == 44 {
              p = mcp_skip_json_ws(src, n, p + 1)
            } else { if p < n and mem_load8_at(src, p) == 125 {
              p = p + 1
              done = 1
            } else { ok = 0 } }
          }
        }
      }
    }
    if ok == 1 { mcp_json_ok(p) } else { mcp_json_bad(p) }
  }
}

fn mcp_json_parse_value(src: i64, n: i64, pos: i64) -> i64 {
  let p = mcp_skip_json_ws(src, n, pos)
  if p >= n { mcp_json_bad(p) }
  else {
    let ch = mem_load8_at(src, p)
    match ch {
      34 -> mcp_json_parse_string(src, n, p)
      45 -> mcp_json_parse_number(src, n, p)
      48 -> mcp_json_parse_number(src, n, p)
      49 -> mcp_json_parse_number(src, n, p)
      50 -> mcp_json_parse_number(src, n, p)
      51 -> mcp_json_parse_number(src, n, p)
      52 -> mcp_json_parse_number(src, n, p)
      53 -> mcp_json_parse_number(src, n, p)
      54 -> mcp_json_parse_number(src, n, p)
      55 -> mcp_json_parse_number(src, n, p)
      56 -> mcp_json_parse_number(src, n, p)
      57 -> mcp_json_parse_number(src, n, p)
      91 -> mcp_json_parse_array(src, n, p)
      123 -> mcp_json_parse_object(src, n, p)
      102 -> mcp_json_parse_literal(src, n, p, "false")
      110 -> mcp_json_parse_literal(src, n, p, "null")
      116 -> mcp_json_parse_literal(src, n, p, "true")
      _ -> mcp_json_bad(p)
    }
  }
}

fn mcp_json_root_object_start(src: i64, n: i64) -> i64 {
  let start = mcp_skip_json_ws(src, n, 0)
  if mcp_json_utf8_is_valid(src, n) == 0 { 0 - 1 }
  else { if start >= n { 0 - 1 }
  else { if mem_load8_at(src, start) != 123 { 0 - 1 }
  else {
    let parsed = mcp_json_parse_value(src, n, start)
    if mcp_json_result_ok(parsed) == 0 { 0 - 1 }
    else {
      let end = mcp_skip_json_ws(src, n, mcp_json_result_pos(parsed))
      if end == n { start } else { 0 - 1 }
    }
  } } }
}

fn mcp_json_field_value_start(src: i64, n: i64, obj_start: i64, key_name: str) -> i64 {
  if obj_start < 0 { 0 - 1 }
  else { if obj_start >= n or mem_load8_at(src, obj_start) != 123 { 0 - 1 }
  else {
    let mut p = mcp_skip_json_ws(src, n, obj_start + 1)
    let mut result = 0 - 1
    let mut done = 0
    if p < n and mem_load8_at(src, p) == 125 { done = 1 } else { 0 }
    while done == 0 and p < n {
      let key_start = p + 1
      let key = mcp_json_parse_string(src, n, p)
      if mcp_json_result_ok(key) == 0 { done = 1 }
      else {
        let key_end = mcp_json_result_pos(key) - 1
        let key_len = key_end - key_start
        p = mcp_skip_json_ws(src, n, mcp_json_result_pos(key))
        if p >= n or mem_load8_at(src, p) != 58 { done = 1 }
        else {
          let value_start = mcp_skip_json_ws(src, n, p + 1)
          let value = mcp_json_parse_value(src, n, value_start)
          if mcp_json_result_ok(value) == 0 { done = 1 }
          else {
            if mcp_json_key_eq(src, n, key_start, key_len, key_name) == 1 {
              result = value_start
              done = 1
            } else {
              p = mcp_skip_json_ws(src, n, mcp_json_result_pos(value))
              if p < n and mem_load8_at(src, p) == 44 {
                p = mcp_skip_json_ws(src, n, p + 1)
              } else { done = 1 }
            }
          }
        }
      }
    }
    result
  } }
}

fn mcp_json_object_field_start(src: i64, n: i64, obj_start: i64, key_name: str) -> i64 {
  let value = mcp_json_field_value_start(src, n, obj_start, key_name)
  if value >= 0 and value < n and mem_load8_at(src, value) == 123 { value } else { 0 - 1 }
}

fn mcp_json_string_value_eq(src: i64, n: i64, value_start: i64, expected: str) -> i64 {
  if value_start < 0 or value_start >= n { 0 }
  else { if mem_load8_at(src, value_start) != 34 { 0 }
  else {
    let parsed = mcp_json_parse_string(src, n, value_start)
    if mcp_json_result_ok(parsed) == 0 { 0 }
    else {
      let content_start = value_start + 1
      let content_len = mcp_json_result_pos(parsed) - content_start - 1
      if mcp_json_content_has_escape(src, content_start, content_len) == 0 { src_eq(src, content_start, content_len, expected) }
      else {
        let decoded = mcp_decode_json_string_pair(src, n, value_start)
        src_eq(mem_load64_at(decoded, 0), 0, mem_load64_at(decoded, 8), expected)
      }
    }
  } }
}

fn mcp_source_pair_missing() -> i64 {
  let pair = main_alloc_bytes(16)
  mem_store64_at(pair, 0, 0)
  mem_store64_at(pair, 8, 0)
  pair
}

fn mcp_decode_json_string_pair(src: i64, n: i64, value_start: i64) -> i64 {
  if value_start < 0 or value_start >= n { mcp_source_pair_missing() }
  else { if mem_load8_at(src, value_start) != 34 { mcp_source_pair_missing() }
  else {
    let parsed = mcp_json_parse_string(src, n, value_start)
    if mcp_json_result_ok(parsed) == 0 { mcp_source_pair_missing() }
    else {
    let end = mcp_json_result_pos(parsed) - 1
    let out = main_alloc_bytes(end - value_start + 1)
    let mut pos = value_start + 1
    let mut len = 0
    while pos < end {
      let ch = mem_load8_at(src, pos)
      if ch == 92 and pos + 1 < end {
          let next = mem_load8_at(src + pos, 1)
          if next == 117 {
            -- \uXXXX: decode the code unit (surrogate pairs combine into one
            -- code point) and emit UTF-8. The parser already validated hex.
            let mut cp = mcp_json_hex4(src, n, pos + 2)
            pos = pos + 6
            if cp >= 55296 and cp <= 56319 and pos + 6 <= end and mem_load8_at(src, pos) == 92 and mem_load8_at(src + pos, 1) == 117 {
              let lo = mcp_json_hex4(src, n, pos + 2)
              if lo >= 56320 and lo <= 57343 {
                cp = 65536 + (cp - 55296) * 1024 + (lo - 56320)
                pos = pos + 6
              } else { 0 }
            } else { 0 }
            if cp < 128 {
              mem_store8_at(out, len, cp)
              len = len + 1
            } else { if cp < 2048 {
              mem_store8_at(out, len, 192 + cp / 64)
              mem_store8_at(out, len + 1, 128 + cp % 64)
              len = len + 2
            } else { if cp < 65536 {
              mem_store8_at(out, len, 224 + cp / 4096)
              mem_store8_at(out, len + 1, 128 + (cp / 64) % 64)
              mem_store8_at(out, len + 2, 128 + cp % 64)
              len = len + 3
            } else {
              mem_store8_at(out, len, 240 + cp / 262144)
              mem_store8_at(out, len + 1, 128 + (cp / 4096) % 64)
              mem_store8_at(out, len + 2, 128 + (cp / 64) % 64)
              mem_store8_at(out, len + 3, 128 + cp % 64)
              len = len + 4
            } } }
          } else {
          if next == 110 {
            mem_store8_at(out, len, 10)
          } else { if next == 34 {
            mem_store8_at(out, len, 34)
          } else { if next == 92 {
            mem_store8_at(out, len, 92)
          } else { if next == 47 {
            mem_store8_at(out, len, 47)
          } else { if next == 114 {
            mem_store8_at(out, len, 13)
          } else { if next == 116 {
            mem_store8_at(out, len, 9)
          } else { if next == 98 {
            mem_store8_at(out, len, 8)
          } else { if next == 102 {
            mem_store8_at(out, len, 12)
          } else {
            mem_store8_at(out, len, next)
          } } } } } } } }
          pos = pos + 2
          len = len + 1
          }
        } else {
          mem_store8_at(out, len, ch)
          pos = pos + 1
          len = len + 1
        }
    }
    let pair = main_alloc_bytes(16)
    mem_store64_at(pair, 0, out)
    mem_store64_at(pair, 8, len)
    pair
    }
  } }
}

fn mcp_extract_argument_string(src: i64, n: i64, root: i64, key_name: str) -> i64 {
  let params = mcp_json_object_field_start(src, n, root, "params")
  let args = mcp_json_object_field_start(src, n, params, "arguments")
  let value = mcp_json_field_value_start(src, n, args, key_name)
  mcp_decode_json_string_pair(src, n, value)
}

fn mcp_extract_source(src: i64, n: i64, root: i64) -> i64 {
  mcp_extract_argument_string(src, n, root, "source")
}

fn mcp_extract_lookup_name(src: i64, n: i64, root: i64) -> i64 {
  mcp_extract_argument_string(src, n, root, "name")
}

fn mcp_extract_grammar_name(src: i64, n: i64, root: i64) -> i64 {
  mcp_extract_argument_string(src, n, root, "grammar")
}

fn mcp_extract_host_source(src: i64, n: i64, root: i64) -> i64 {
  mcp_extract_argument_string(src, n, root, "host_source")
}

fn mcp_extract_argument_int(src: i64, n: i64, root: i64, key_name: str, default: i64) -> i64 {
  let params = mcp_json_object_field_start(src, n, root, "params")
  let args = mcp_json_object_field_start(src, n, params, "arguments")
  let value_start = mcp_json_field_value_start(src, n, args, key_name)
  if value_start < 0 or value_start >= n { default }
  else {
    let mut p = value_start
    let mut sign = 1
    if mem_load8_at(src, p) == 45 { sign = 0 - 1 p = p + 1 } else { 0 }
    let mut value = 0
    let mut seen = 0
    while p < n and is_digit(mem_load8_at(src, p)) == 1 {
      value = value * 10 + mem_load8_at(src, p) - 48
      seen = 1
      p = p + 1
    }
    if seen == 1 { value * sign } else { default }
  }
}

fn mcp_buf_reset(b: i64) -> i64 {
  mem_store64_at(b, 8, 0)
  0
}

-- Discard any partial payload, store the error message as the buffer
-- content, and return the JSON-RPC error code. Dispatch paths return
-- this code upward; 0 always means "buffer holds a result payload".
fn mcp_emit_error(b: i64, code: i64, message: str) -> i64 {
  mcp_buf_reset(b)
  bstr(b, message)
  code
}

fn mcp_emit_tools_list(b: i64) -> i64 {
  mcp_write(b, "{\"schema_version\":1,\"tools\":[{\"name\":\"parse_summary\",\"stability\":\"internal\"},{\"name\":\"check_summary\",\"stability\":\"internal\"},{\"name\":\"ir_summary\",\"stability\":\"internal\"},{\"name\":\"type_lookup\",\"stability\":\"stable\"},{\"name\":\"effect_lookup\",\"stability\":\"stable\"},{\"name\":\"diagnostics\",\"stability\":\"stable\"},{\"name\":\"grammar_parse\",\"stability\":\"internal\"},{\"name\":\"grammar_check\",\"stability\":\"internal\"},{\"name\":\"grammar_diagnostics\",\"stability\":\"stable\"},{\"name\":\"opt_counters\",\"stability\":\"internal\"},{\"name\":\"fact_at_position\",\"stability\":\"stable\"},{\"name\":\"visible_bindings\",\"stability\":\"stable\"},{\"name\":\"conformance_at_position\",\"stability\":\"stable\"},{\"name\":\"format_source\",\"stability\":\"stable\"}]}")
}

fn mcp_tool_stability(tool: str) -> str {
  if src_eq(__str_ptr(tool), 0, __str_len(tool), "diagnostics") == 1 or
    src_eq(__str_ptr(tool), 0, __str_len(tool), "grammar_diagnostics") == 1 or
    src_eq(__str_ptr(tool), 0, __str_len(tool), "type_lookup") == 1 or
    src_eq(__str_ptr(tool), 0, __str_len(tool), "effect_lookup") == 1 or
    src_eq(__str_ptr(tool), 0, __str_len(tool), "fact_at_position") == 1 or
    src_eq(__str_ptr(tool), 0, __str_len(tool), "visible_bindings") == 1 or
    src_eq(__str_ptr(tool), 0, __str_len(tool), "conformance_at_position") == 1 or
    src_eq(__str_ptr(tool), 0, __str_len(tool), "format_source") == 1 { "stable" }
  else { "internal" }
}

fn mcp_begin_result(b: i64, tool: str) -> i64 {
  mcp_write(b, "{\"tool\":\"")
  mcp_write(b, tool)
  mcp_write(b, "\",\"ok\":true,\"schema_version\":1,\"stability\":\"")
  mcp_write(b, mcp_tool_stability(tool))
  mcp_write(b, "\"")
}

fn mcp_end_result(b: i64) -> i64 {
  mcp_write(b, "}")
}

fn mcp_parse_source_quiet(src: i64, n: i64) -[SourceAcquire]> AstModule {
  handle pipeline_parse_source_with_diagnostics_and_origin(src, n, 0, 1) {
    Diagnose.report(diagnostic) -> resume(0)
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
}

fn mcp_register_source_overlays(tt: i64, overlays: i64, root_src: i64, root_path_ptr: i64, root_path_len: i64, workspace_ptr: i64, workspace_len: i64) -> i64 {
  if overlays != 0 {
    for i in 0..nlist_len(overlays) {
      let doc = nlist_get(overlays, i)
      let uri_ptr = mem_load64_at(doc, 0)
      let uri_len = mem_load64_at(doc + 8, 0)
      let doc_src = mem_load64_at(doc + 16, 0)
      let doc_len = mem_load64_at(doc + 24, 0)
      if uri_ptr != 0 and uri_len > 7 and doc_src != 0 and src_eq_at(uri_ptr, 0, __str_ptr("file://"), 0, 7) == 1 {
        let path_ptr = uri_ptr + 7
        let path_len = uri_len - 7
        let is_root = doc_src == root_src or (path_len == root_path_len and root_path_len > 0 and src_eq_at(path_ptr, 0, root_path_ptr, 0, path_len) == 1)
        if not is_root {
          let under_workspace = workspace_len > 0 and path_len > workspace_len and src_eq_at(path_ptr, 0, workspace_ptr, 0, workspace_len) == 1 and
            (workspace_len == 1 or mem_load8_at(path_ptr, workspace_len) == 47)
          let relative_start = if under_workspace { if workspace_len == 1 { 1 } else { workspace_len + 1 } } else { 0 }
          ttable_register_source(tt, doc_src, doc_len, path_ptr + relative_start, path_len - relative_start)
        } else { 0 }
      } else { 0 }
    }
  } else { 0 }
  0
}

fn mcp_check_source_quiet_inner_with_path_and_overlays(src: i64, n: i64, path_ptr: i64, path_len: i64, overlays: i64, workspace_ptr: i64, workspace_len: i64) -[Diagnose, SourceAcquire]> TypedModule {
  let grammar = weft_grammar()
  let probe_tt = ttable_new()
  main_mark_root_origin_with_grant(probe_tt, src, 0, 1, 0)
  main_register_source_path(probe_tt, src, n, path_ptr, path_len)
  mcp_register_source_overlays(probe_tt, overlays, src, path_ptr, path_len, workspace_ptr, workspace_len)
  let probe_fns = pipeline_parse(grammar, src, n, probe_tt)
  if fns_have_tests(probe_fns) == 1 {
    let prefixed = test_source_with_prefix_and_wrappers(src, n, fns_test_count(probe_fns))
    let test_src = node_f1(prefixed)
    let test_n = node_f2(prefixed)
    let name_bank_start = test_source_wrapper_bank_start(prefixed)
    let tt = ttable_new()
    main_mark_root_origin_with_grant(tt, test_src, 0, 1, 0)
    main_register_source_path(tt, test_src, test_n, path_ptr, path_len)
    mcp_register_source_overlays(tt, overlays, src, path_ptr, path_len, workspace_ptr, workspace_len)
    let fns = pipeline_parse(grammar, test_src, test_n, tt)
    let regular = check_wrap_test_blocks(fns, name_bank_start, tt)
    pipeline_bind_runtime_preludes(regular, test_src, tt)
    pipeline_check_fns_with_diagnostics(regular, test_src, tt)
  } else {
    pipeline_bind_runtime_preludes(probe_fns, src, probe_tt)
    pipeline_check_fns_with_diagnostics(probe_fns, src, probe_tt)
  }
}

fn mcp_check_source_quiet_inner_with_path(src: i64, n: i64, path_ptr: i64, path_len: i64) -[Diagnose, SourceAcquire]> TypedModule {
  mcp_check_source_quiet_inner_with_path_and_overlays(src, n, path_ptr, path_len, 0, 0, 0)
}

fn mcp_check_source_quiet_with_path(src: i64, n: i64, path_ptr: i64, path_len: i64) -[SourceAcquire]> TypedModule {
  handle mcp_check_source_quiet_inner_with_path(src, n, path_ptr, path_len) {
    Diagnose.report(diagnostic) -> resume(0)
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
}

fn mcp_check_source_quiet_with_path_and_overlays(src: i64, n: i64, path_ptr: i64, path_len: i64, overlays: i64, workspace_ptr: i64, workspace_len: i64) -[SourceAcquire]> TypedModule {
  handle mcp_check_source_quiet_inner_with_path_and_overlays(src, n, path_ptr, path_len, overlays, workspace_ptr, workspace_len) {
    Diagnose.report(diagnostic) -> resume(0)
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
}

fn mcp_check_source_quiet(src: i64, n: i64) -[SourceAcquire]> TypedModule {
  mcp_check_source_quiet_with_path(src, n, 0, 0)
}

fn mcp_project_context() -> ProjectQueryContext {
  project_query_context(0, "mcp://request.weft", "", project_source_origin_overlay(), 0, 1)
}

fn mcp_project_update_source(session: ProjectSession, src: i64, n: i64) -> ProjectQueryContext {
  let context = mcp_project_context()
  project_session_set_source(session, context, runtime_str_from_bytes_copy(src, n))
  context
}

fn mcp_project_checked_source(session: ProjectSession, src: i64, n: i64) -[SourceAcquire]> TypedModule {
  let context = mcp_project_update_source(session, src, n)
  match project_session_check_with_acquire(session, context) {
    ProjectCheckSucceeded(typed, source_n, parse_diagnostics, check_diagnostics) -> typed
    ProjectCheckFailed(typed, source_n, parse_diagnostics, check_diagnostics) -> typed
    -- Fact tools historically query the recovered typed module even when
    -- parsing failed. Preserve that behavior until recovery is a typed query.
    _ -> mcp_check_source_quiet(src, n)
  }
}

fn mcp_emit_parse_summary_from_ast(b: i64, ast: AstModule) -> i64 {
  match ast {
    AstModule(fns, src, tt) -> {
      let body = pipeline_ast_first_body_expr(ast)
      mcp_begin_result(b, "parse_summary")
      mcp_write(b, ",\"functions\":")
      mcp_write_i(b, main_fns_source_count(fns, src))
      mcp_write(b, ",\"first_body_tag\":")
      mcp_write_i(b, expr_tag(body))
      mcp_end_result(b)
    }
  }
}

fn mcp_emit_parse_summary(b: i64, session: ProjectSession, src: i64, n: i64) -[SourceAcquire]> i64 {
  let context = mcp_project_update_source(session, src, n)
  match project_session_parse_with_acquire(session, context) {
    ProjectParseSucceeded(ast, source_n, diagnostics) -> mcp_emit_parse_summary_from_ast(b, ast)
    ProjectParseFailed(ast, source_n, diagnostics) -> mcp_emit_parse_summary_from_ast(b, ast)
    -- Input was installed immediately above. These states signal an internal
    -- session invariant failure; preserve the historical tool result shape by
    -- falling back to an isolated parse rather than leaking cache machinery.
    _ -> mcp_emit_parse_summary_from_ast(b, mcp_parse_source_quiet(src, n))
  }
}

fn mcp_emit_check_summary_from_typed(b: i64, typed: TypedModule) -> i64 {
  let fns = pipeline_typed_fns(typed)
  let body = pipeline_typed_first_body_expr(typed)
  mcp_begin_result(b, "check_summary")
  mcp_write(b, ",\"functions\":")
  mcp_write_i(b, main_fns_source_count(fns, mcp_typed_module_src(typed)))
  mcp_write(b, ",\"first_body_tag\":")
  mcp_write_i(b, expr_tag(body))
  mcp_end_result(b)
}

fn mcp_emit_check_summary(b: i64, session: ProjectSession, src: i64, n: i64) -[SourceAcquire]> i64 {
  let context = mcp_project_update_source(session, src, n)
  match project_session_check_with_acquire(session, context) {
    ProjectCheckSucceeded(typed, source_n, parse_diagnostics, check_diagnostics) -> mcp_emit_check_summary_from_typed(b, typed)
    ProjectCheckFailed(typed, source_n, parse_diagnostics, check_diagnostics) -> mcp_emit_check_summary_from_typed(b, typed)
    -- Parse recovery and session invariant failures retain the historical
    -- isolated behavior until recovery itself is a typed cached product.
    _ -> mcp_emit_check_summary_from_typed(b, mcp_check_source_quiet(src, n))
  }
}

fn mcp_emit_ir_summary_result(b: i64, typed: TypedModule, check_errors: i64) -> i64 {
  let check_src = mcp_typed_module_src(typed)
  let functions = if check_errors == 0 { pipeline_ir_functions(pipeline_lower_ir(typed)) } else { ir_function_list_empty() }
  mcp_begin_result(b, "ir_summary")
  mcp_write(b, ",\"functions\":")
  mcp_write_i(b, ir_function_list_len_for_source(functions, check_src))
  mcp_write(b, ",\"blocks\":")
  mcp_write_i(b, ir_function_list_block_count_for_source(functions, check_src))
  mcp_write(b, ",\"insts\":")
  mcp_write_i(b, ir_function_list_inst_count_for_source(functions, check_src))
  mcp_end_result(b)
}

fn mcp_emit_ir_summary_legacy(b: i64, src: i64, n: i64) -[SourceAcquire]> i64 {
  let grammar = weft_grammar()
  let probe_tt = ttable_new()
  main_mark_root_origin_with_grant(probe_tt, src, 0, 1, 0)
  let probe_fns = pipeline_parse(grammar, src, n, probe_tt)
  let mut check_src = src
  let mut check_tt = probe_tt
  let mut check_fns = probe_fns
  if fns_have_tests(probe_fns) == 1 {
    let prefixed = test_source_with_prefix_and_wrappers(src, n, fns_test_count(probe_fns))
    check_src = node_f1(prefixed)
    let test_n = node_f2(prefixed)
    let name_bank_start = test_source_wrapper_bank_start(prefixed)
    check_tt = ttable_new()
    main_mark_root_origin_with_grant(check_tt, check_src, 0, 1, 0)
    let fns = pipeline_parse(grammar, check_src, test_n, check_tt)
    check_fns = check_wrap_test_blocks(fns, name_bank_start, check_tt)
  } else { 0 }
  let check_errors = handle grammar.check(check_fns, check_src, check_tt) {
    Diagnose.report(diagnostic) -> resume(0)
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
  -- grammar.check above already checked; wrap the triple, don't re-check.
  mcp_emit_ir_summary_result(b, TypedModule(check_fns, check_src, check_tt), check_errors)
}

fn mcp_emit_ir_summary(b: i64, session: ProjectSession, src: i64, n: i64) -[SourceAcquire]> i64 {
  let context = mcp_project_update_source(session, src, n)
  match project_session_check_with_acquire(session, context) {
    ProjectCheckSucceeded(typed, source_n, parse_diagnostics, check_diagnostics) -> mcp_emit_ir_summary_result(b, typed, 0)
    ProjectCheckFailed(typed, source_n, parse_diagnostics, check_diagnostics) -> mcp_emit_ir_summary_result(b, typed, 1)
    _ -> mcp_emit_ir_summary_legacy(b, src, n)
  }
}

fn mcp_write_counter(b: i64, name: str, value: i64) -> i64 {
  mcp_write(b, ",\"")
  mcp_write(b, name)
  mcp_write(b, "\":")
  mcp_write_i(b, value)
}

-- Def-shape spill census: four buckets per shape class (loads-0 defs,
-- loads-1 defs, loads-2+ defs, loads-2+ load sum).
fn mcp_write_shape_census(b: i64, native: NativeModule, shape: i64, l0: str, l1: str, d2: str, ls: str) -> i64 {
  mcp_write_counter(b, l0, pipeline_native_shape_census_count(native, 0, shape))
  mcp_write_counter(b, l1, pipeline_native_shape_census_count(native, 1, shape))
  mcp_write_counter(b, d2, pipeline_native_shape_census_count(native, 2, shape))
  mcp_write_counter(b, ls, pipeline_native_shape_census_count(native, 3, shape))
  0
}

-- opt_counters: run the full optimise + native-lower pipeline and report the
-- optimizer's per-pass site counters and the native emission counters
-- (sp_load/sp_store are the roadmap §3.1 decision units). Read-only plumbing
-- over counters the passes already maintain.
fn mcp_emit_opt_counters(b: i64, src: i64, n: i64) -[SourceAcquire]> i64 {
  let grammar = weft_grammar()
  let probe_tt = ttable_new()
  main_mark_root_origin_with_grant(probe_tt, src, 0, 1, 0)
  let probe_fns = pipeline_parse(grammar, src, n, probe_tt)
  let mut check_src = src
  let mut check_tt = probe_tt
  let mut check_fns = probe_fns
  if fns_have_tests(probe_fns) == 1 {
    let prefixed = test_source_with_prefix_and_wrappers(src, n, fns_test_count(probe_fns))
    check_src = node_f1(prefixed)
    let test_n = node_f2(prefixed)
    let name_bank_start = test_source_wrapper_bank_start(prefixed)
    check_tt = ttable_new()
    main_mark_root_origin_with_grant(check_tt, check_src, 0, 1, 0)
    let fns = pipeline_parse(grammar, check_src, test_n, check_tt)
    check_fns = check_wrap_test_blocks(fns, name_bank_start, check_tt)
  } else { 0 }
  -- This is a source-local analysis surface, not an emitted artifact. Bind
  -- only dependencies reached by the submitted program so the counters do
  -- not measure the compiler's universal fatal-reporting runtime.
  pipeline_bind_runtime_preludes(check_fns, check_src, check_tt)
  let check_errors = handle grammar.check(check_fns, check_src, check_tt) {
    Diagnose.report(diagnostic) -> resume(0)
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
  if check_errors != 0 {
    mcp_write(b, "{\"tool\":\"opt_counters\",\"ok\":false,\"reason\":\"check errors\"}")
  } else {
    let typed = TypedModule(check_fns, check_src, check_tt)
    let ir = pipeline_lower_ir(typed)
    let optimised = pipeline_optimise_typed_ir(typed, ir)
    -- Armed emission: the residency audit and the 2v allocation checker
    -- run over the emitted buffer, so their counters below are live.
    let native = pipeline_lower_native_module_with_audit(typed, optimised, 1)
    mcp_begin_result(b, "opt_counters")
    mcp_write_counter(b, "handler_inline_sites", pipeline_ir_handler_inline_sites(optimised))
    mcp_write_counter(b, "handler_residual_sites", pipeline_ir_handler_residual_sites(optimised))
    mcp_write_counter(b, "handler_evidence_candidate_sites", pipeline_ir_handler_evidence_candidate_sites(optimised))
    mcp_write_counter(b, "const_fold_sites", pipeline_ir_const_fold_sites(optimised))
    mcp_write_counter(b, "algebraic_fold_sites", pipeline_ir_algebraic_fold_sites(optimised))
    mcp_write_counter(b, "dead_inst_sites", pipeline_ir_dead_inst_sites(optimised))
    mcp_write_counter(b, "pure_call_dce_sites", pipeline_ir_pure_call_dce_sites(optimised))
    mcp_write_counter(b, "match_final_arm_elision_sites", pipeline_ir_match_final_arm_elision_sites(optimised))
    mcp_write_counter(b, "block_entry_narrowing_sites", pipeline_ir_block_entry_narrowing_sites(optimised))
    mcp_write_counter(b, "direct_call_inline_sites", pipeline_ir_direct_call_inline_sites(optimised))
    mcp_write_counter(b, "functions", pipeline_native_function_count(native))
    mcp_write_counter(b, "insts", pipeline_native_inst_count(native))
    mcp_write_counter(b, "sp_load", pipeline_native_sp_load_count(native))
    mcp_write_counter(b, "sp_store", pipeline_native_sp_store_count(native))
    mcp_write_counter(b, "sp_pair_load", pipeline_native_sp_pair_load_count(native))
    mcp_write_counter(b, "sp_pair_store", pipeline_native_sp_pair_store_count(native))
    mcp_write_counter(b, "sp_fp_pair_load", pipeline_native_sp_fp_pair_load_count(native))
    mcp_write_counter(b, "sp_fp_pair_store", pipeline_native_sp_fp_pair_store_count(native))
    mcp_write_counter(b, "rc_elision", pipeline_native_rc_elision_count(native))
