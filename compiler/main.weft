    mcp_end_result(b)
  }
}

fn mcp_diag_entry(severity: i64, msg: str, span: i64) -> i64 {
  let entry = main_alloc_bytes(32)
  mem_store64_at(entry, 0, severity)
  mem_store64_at(entry, 8, __str_ptr(msg))
  mem_store64_at(entry, 16, __str_len(msg))
  mem_store64_at(entry, 24, span)
  entry
}

fn mcp_span_line(src: i64, span: i64) -> i64 {
  if span < 0 { 0 - 1 }
  else {
    let mut i = 0
    let mut line = 1
    while i < span {
      if mem_load8_at(src, i) == 10 { line = line + 1 } else { 0 }
      i = i + 1
    }
    line
  }
}

fn mcp_span_col(src: i64, span: i64) -> i64 {
  if span < 0 { 0 - 1 }
  else {
    let mut i = 0
    let mut col = 1
    while i < span {
      if mem_load8_at(src, i) == 10 { col = 1 } else { col = col + 1 }
      i = i + 1
    }
    col
  }
}

fn mcp_write_diag_severity(b: i64, severity: i64) -> i64 {
  match severity {
    1 -> mcp_write(b, "\"error\"")
    2 -> mcp_write(b, "\"warn\"")
    3 -> mcp_write(b, "\"note\"")
    _ -> mcp_write(b, "\"unknown\"")
  }
}

fn mcp_emit_diag_item(b: i64, src: i64, entry: i64) -> i64 {
  let severity = mem_load64_at(entry, 0)
  let msg_ptr = mem_load64_at(entry, 8)
  let msg_len = mem_load64_at(entry, 16)
  -- Diagnostic spans are absolute addresses; reduce to a root-relative
  -- offset (or -1) so the line/col walk stays inside the buffer.
  let span = diagnose_normalize_span(src, mem_load64_at(entry, 24))
  mcp_write(b, "{\"severity\":")
  mcp_write_diag_severity(b, severity)
  mcp_write(b, ",\"message\":")
  mcp_write_json_bytes(b, msg_ptr, msg_len)
  mcp_write(b, ",\"span\":")
  mcp_write_i(b, span)
  mcp_write(b, ",\"line\":")
  mcp_write_i(b, mcp_span_line(src, span))
  mcp_write(b, ",\"col\":")
  mcp_write_i(b, mcp_span_col(src, span))
  mcp_write(b, "}")
}

fn mcp_emit_diag_items(b: i64, src: i64, diags: i64) -> i64 {
  let n = nlist_len(diags)
  mcp_write(b, "[")
  for i in 0..n {
    if i > 0 { mcp_write(b, ",") } else { 0 }
    mcp_emit_diag_item(b, src, nlist_get(diags, i))
  }
  mcp_write(b, "]")
}

fn mcp_emit_diagnostics(b: i64, src: i64, n: i64) -> i64 {
  let tt = ttable_new()
  pipeline_mark_root_origin(tt, src, 0, 1)
  let grammar = weft_grammar()
  let diags = nlist_new()
  let fns = handle grammar.parse(src, n, tt) {
    Diagnose.error(msg, span) -> { nlist_add(diags, mcp_diag_entry(1, msg, span)) resume(0) }
    Diagnose.warn(msg, span) -> { nlist_add(diags, mcp_diag_entry(2, msg, span)) resume(0) }
    Diagnose.note(msg, span) -> { nlist_add(diags, mcp_diag_entry(3, msg, span)) resume(0) }
  }
  let mut check_src = src
  let mut check_tt = tt
  let mut check_fns = fns
  if fns_have_tests(fns) == 1 {
    let prefixed = test_source_with_prefix_and_wrappers(src, n, fns_test_count(fns))
    check_src = node_f1(prefixed)
    let test_n = node_f2(prefixed)
    let name_bank_start = test_source_wrapper_bank_start(prefixed)
    check_tt = ttable_new()
    main_mark_root_origin_with_grant(check_tt, check_src, 0, 1, 0)
    let parsed = handle grammar.parse(check_src, test_n, check_tt) {
      Diagnose.error(msg, span) -> { nlist_add(diags, mcp_diag_entry(1, msg, span)) resume(0) }
      Diagnose.warn(msg, span) -> { nlist_add(diags, mcp_diag_entry(2, msg, span)) resume(0) }
      Diagnose.note(msg, span) -> { nlist_add(diags, mcp_diag_entry(3, msg, span)) resume(0) }
    }
    check_fns = check_wrap_test_blocks(parsed, name_bank_start)
  } else { 0 }
  let check_errors = handle grammar.check(check_fns, check_src, check_tt) {
    Diagnose.error(msg, span) -> { nlist_add(diags, mcp_diag_entry(1, msg, span)) resume(0) }
    Diagnose.warn(msg, span) -> { nlist_add(diags, mcp_diag_entry(2, msg, span)) resume(0) }
    Diagnose.note(msg, span) -> { nlist_add(diags, mcp_diag_entry(3, msg, span)) resume(0) }
  }
  mcp_begin_result(b, "diagnostics")
  mcp_write(b, ",\"phase\":\"parse+check\",\"diagnostics\":")
  mcp_write_i(b, nlist_len(diags))
  mcp_write(b, ",\"functions\":")
  mcp_write_i(b, nlist_len(check_fns))
  mcp_write(b, ",\"check_errors\":")
  mcp_write_i(b, check_errors)
  mcp_write(b, ",\"items\":")
  mcp_emit_diag_items(b, check_src, diags)
  mcp_end_result(b)
}

fn mcp_parse_grammar_module_quiet(module_id: i64, src: i64, n: i64, tt: i64) -> i64 {
  handle grammar_module_parse(module_id, src, n, tt) {
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
}

fn mcp_check_grammar_module_quiet(module_id: i64, ast: i64, src: i64, tt: i64) -> i64 {
  handle grammar_module_check_catalog(module_id, ast, src, tt) {
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
}

fn mcp_typed_module_tt(typed: TypedModule) -> i64 {
  match typed {
    TypedModule(fns, src, tt) -> tt
  }
}

fn mcp_host_type_table_quiet(host_src: i64, host_n: i64) -> i64 {
  mcp_typed_module_tt(mcp_check_source_quiet(host_src, host_n))
}

fn mcp_check_grammar_module_host_typecheck(module_id: i64, ast: i64, src: i64, host_tt: i64) -[Diagnose]> i64 {
  handle grammar_module_check_host(module_id, ast, src, host_tt) {
    TypeCheck.resolve_type(name_src, ns, nl) -> resume(typecheck_resolve_type(host_tt, name_src, ns, nl))
    TypeCheck.resolve_field_type(base_ty, field_src, ns, nl) -> resume(typecheck_resolve_field_type(host_tt, base_ty, field_src, ns, nl))
    TypeCheck.subtype(actual_ty, expected_ty) -> resume(typecheck_subtype(host_tt, actual_ty, expected_ty))
  }
}

fn mcp_check_grammar_module_host_quiet(module_id: i64, ast: i64, src: i64, host_src: i64, host_n: i64) -> i64 {
  let host_tt = mcp_host_type_table_quiet(host_src, host_n)
  handle mcp_check_grammar_module_host_typecheck(module_id, ast, src, host_tt) {
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
}

fn mcp_emit_grammar_module_table(b: i64, module_id: i64, src: i64, ast: i64) -> i64 {
  let table = grammar_module_table_node(module_id, ast)
  if table == 0 {
    mcp_write(b, "null")
  } else {
    mcp_write_json_bytes(b, src + grammar_module_ident_start(module_id, table), grammar_module_ident_len(module_id, table))
  }
}

fn mcp_emit_grammar_module_summary_fields(b: i64, module_id: i64, src: i64, ast: i64) -> i64 {
  mcp_write(b, ",\"grammar\":\"")
  mcp_write(b, grammar_module_name(module_id))
  mcp_write(b, "\",\"root_tag\":")
  mcp_write_i(b, grammar_module_root_tag(module_id, ast))
  mcp_write(b, ",\"columns\":")
  mcp_write_i(b, grammar_module_column_count(module_id, ast))
  mcp_write(b, ",\"star\":")
  mcp_write_i(b, grammar_module_star(module_id, ast))
  if grammar_module_distinct(module_id, ast) == 1 {
    mcp_write(b, ",\"distinct\":1")
  } else { 0 }
  mcp_write(b, ",\"table\":")
  mcp_emit_grammar_module_table(b, module_id, src, ast)
  mcp_write(b, ",\"where\":")
  mcp_write_i(b, grammar_module_has_where(module_id, ast))
}

fn mcp_emit_grammar_parse(b: i64, src: i64, n: i64, module_id: i64) -> i64 {
  let tt = ttable_new()
  let ast = mcp_parse_grammar_module_quiet(module_id, src, n, tt)
  mcp_begin_result(b, "grammar_parse")
  mcp_emit_grammar_module_summary_fields(b, module_id, src, ast)
  mcp_end_result(b)
}

fn mcp_emit_grammar_check(b: i64, src: i64, n: i64, module_id: i64) -> i64 {
  let tt = ttable_new()
  let ast = mcp_parse_grammar_module_quiet(module_id, src, n, tt)
  let check_errors = mcp_check_grammar_module_quiet(module_id, ast, src, tt)
  mcp_begin_result(b, "grammar_check")
  mcp_emit_grammar_module_summary_fields(b, module_id, src, ast)
  mcp_write(b, ",\"check_errors\":")
  mcp_write_i(b, check_errors)
  mcp_end_result(b)
}

fn mcp_emit_grammar_check_with_host(b: i64, src: i64, n: i64, module_id: i64, host_src: i64, host_n: i64) -> i64 {
  let tt = ttable_new()
  let ast = mcp_parse_grammar_module_quiet(module_id, src, n, tt)
  let check_errors = mcp_check_grammar_module_host_quiet(module_id, ast, src, host_src, host_n)
  mcp_begin_result(b, "grammar_check")
  mcp_emit_grammar_module_summary_fields(b, module_id, src, ast)
  mcp_write(b, ",\"check_errors\":")
  mcp_write_i(b, check_errors)
  mcp_end_result(b)
}

fn mcp_emit_grammar_diagnostics(b: i64, src: i64, n: i64, module_id: i64, host_src: i64, host_n: i64) -> i64 {
  let tt = ttable_new()
  let diags = nlist_new()
  let parse_count = main_alloc_bytes(8)
  mem_store64_at(parse_count, 0, 0)
  let ast = handle grammar_module_parse(module_id, src, n, tt) {
    Diagnose.error(msg, span) -> { nlist_add(diags, mcp_diag_entry(1, msg, span)) mem_store64_at(parse_count, 0, mem_load64_at(parse_count, 0) + 1) resume(0) }
    Diagnose.warn(msg, span) -> { nlist_add(diags, mcp_diag_entry(2, msg, span)) resume(0) }
    Diagnose.note(msg, span) -> { nlist_add(diags, mcp_diag_entry(3, msg, span)) resume(0) }
  }
  let check_errors = if mem_load64_at(parse_count, 0) > 0 { 0 }
  else {
    if host_src == 0 {
      handle grammar_module_check_catalog(module_id, ast, src, tt) {
        Diagnose.error(msg, span) -> { nlist_add(diags, mcp_diag_entry(1, msg, span)) resume(0) }
        Diagnose.warn(msg, span) -> { nlist_add(diags, mcp_diag_entry(2, msg, span)) resume(0) }
        Diagnose.note(msg, span) -> { nlist_add(diags, mcp_diag_entry(3, msg, span)) resume(0) }
      }
    } else {
      let host_tt = mcp_host_type_table_quiet(host_src, host_n)
      handle mcp_check_grammar_module_host_typecheck(module_id, ast, src, host_tt) {
        Diagnose.error(msg, span) -> { nlist_add(diags, mcp_diag_entry(1, msg, span)) resume(0) }
        Diagnose.warn(msg, span) -> { nlist_add(diags, mcp_diag_entry(2, msg, span)) resume(0) }
        Diagnose.note(msg, span) -> { nlist_add(diags, mcp_diag_entry(3, msg, span)) resume(0) }
      }
    }
  }
  mcp_begin_result(b, "grammar_diagnostics")
  mcp_write(b, ",\"grammar\":\"")
  mcp_write(b, grammar_module_name(module_id))
  mcp_write(b, "\",\"phase\":\"parse+check\",\"diagnostics\":")
  mcp_write_i(b, nlist_len(diags))
  mcp_write(b, ",\"check_errors\":")
  mcp_write_i(b, check_errors)
  mcp_write(b, ",\"items\":")
  mcp_emit_diag_items(b, src, diags)
  mcp_end_result(b)
}

fn mcp_dispatch_grammar_tool(b: i64, req: i64, n: i64, root: i64, src: i64, src_n: i64, tool_id: i64) -> i64 {
  let grammar_pair = mcp_extract_grammar_name(req, n, root)
  let host_pair = mcp_extract_host_source(req, n, root)
  let host_src = mem_load64_at(host_pair, 0)
  let host_n = mem_load64_at(host_pair, 8)
  let grammar_ptr = mem_load64_at(grammar_pair, 0)
  let grammar_n = mem_load64_at(grammar_pair, 8)
  if grammar_ptr == 0 {
    mcp_emit_error(b, 0 - 32602, "missing grammar")
  } else {
    let module_id = grammar_module_lookup(grammar_ptr, grammar_n)
    if module_id == grammar_module_unknown() {
      mcp_emit_error(b, 0 - 32602, "unknown grammar")
    } else {
      match tool_id {
        7 -> mcp_emit_grammar_parse(b, src, src_n, module_id)
        8 -> {
          if host_src == 0 { mcp_emit_grammar_check(b, src, src_n, module_id) }
          else { mcp_emit_grammar_check_with_host(b, src, src_n, module_id, host_src, host_n) }
        }
        9 -> mcp_emit_grammar_diagnostics(b, src, src_n, module_id, host_src, host_n)
        _ -> mcp_emit_error(b, 0 - 32601, "unknown tool")
      }
    }
  }
}

fn mcp_type_tag_or(ty: i64, default: i64) -> i64 {
  if ty == 0 { default } else { ty_tag(ty) }
}

fn mcp_type_prim_id_or(ty: i64, default: i64) -> i64 {
  if ty == 0 { default }
  else { if ty_tag(ty) == 2 { ty_f1(ty) } else { default } }
}

fn mcp_effect_tail_or(eff: i64, default: i64) -> i64 {
  if eff == 0 { default }
  else { if ty_tag(eff) == 10 { ty_f2(eff) } else { default } }
}

fn mcp_name_bytes_eq(name_ptr: i64, name_n: i64, cand_ptr: i64, cand_n: i64) -> i64 {
  if name_n != cand_n { 0 } else { src_eq_at(name_ptr, 0, cand_ptr, 0, name_n) }
}

type McpFunctionLookup {
  McpFunctionLookup(Decl, i64), -- function declaration, source pointer
  MissingMcpFunctionLookup
}

fn mcp_decl_is_function(decl: Decl) -> i64 {
  match decl {
    FnDecl(ns, nl, params, body) -> 1
    FnDeclWrapped(inner, ret_type, eff_sig, tparams) -> mcp_decl_is_function(inner)
    _ -> 0
  }
}

fn mcp_lookup_function_decl(fns: i64, name_ptr: i64, name_n: i64) -> McpFunctionLookup {
  let n = nlist_len(fns)
  let mut i = 0
  let mut result = MissingMcpFunctionLookup
  while i < n {
    let pair = nlist_get(fns, i)
    let fn_src = node_f2(pair)
    let decl = decl_from_node(node_f1(pair))
    let ns = decl_name_start_or(decl, 0)
    let nl = decl_name_len_or(decl, 0)
    if mcp_decl_is_function(decl) == 1 and mcp_name_bytes_eq(name_ptr, name_n, fn_src + ns, nl) == 1 {
      result = McpFunctionLookup(decl, fn_src)
      i = n
    } else {
      i = i + 1
    }
  }
  result
}

fn mcp_type_entry_matches_name(entry: TypeEntry, name_ptr: i64, name_n: i64) -> i64 {
  let entry_src = type_entry_source_or(entry, 0)
  if entry_src == 0 { 0 }
  else {
    let ns = type_entry_name_start_or(entry, 0)
    let nl = type_entry_name_len_or(entry, 0)
    mcp_name_bytes_eq(name_ptr, name_n, entry_src + ns, nl)
  }
}

fn mcp_lookup_type_entry(entries: TypeEntryList, name_ptr: i64, name_n: i64, kind_filter: i64) -> TypeEntry {
  let n = type_entry_list_len(entries)
  let mut i = 0
  let mut result = MissingTypeEntry
  while i < n {
    let entry = type_entry_list_nth(entries, i)
    let kind = type_entry_kind_or(entry, 0 - 1)
    let kind_ok = if kind_filter < 0 { 1 } else { if kind == kind_filter { 1 } else { 0 } }
    if kind_ok == 1 and mcp_type_entry_matches_name(entry, name_ptr, name_n) == 1 {
      result = entry
      i = n
    } else {
      i = i + 1
    }
  }
  result
}

fn mcp_write_type_entry_kind(b: i64, kind: i64) -> i64 {
  match kind {
    0 -> mcp_write(b, "\"record\"")
    1 -> mcp_write(b, "\"variant\"")
    2 -> mcp_write(b, "\"effect\"")
    3 -> mcp_write(b, "\"trait\"")
    4 -> mcp_write(b, "\"impl\"")
    _ -> mcp_write(b, "\"unknown\"")
  }
}

fn mcp_emit_type_lookup_not_found(b: i64, name_ptr: i64, name_n: i64) -> i64 {
  mcp_begin_result(b, "type_lookup")
  mcp_write(b, ",\"name\":")
  mcp_write_json_bytes(b, name_ptr, name_n)
  mcp_write(b, ",\"found\":false")
  mcp_end_result(b)
}

fn mcp_emit_type_lookup_function(b: i64, decl: Decl, name_ptr: i64, name_n: i64) -> i64 {
  let params = decl_params(decl)
  let nparams = param_list_len(params)
  mcp_begin_result(b, "type_lookup")
  mcp_write(b, ",\"name\":")
  mcp_write_json_bytes(b, name_ptr, name_n)
  mcp_write(b, ",\"found\":true,\"kind\":\"function\",\"params\":")
  mcp_write_i(b, nparams)
  mcp_write(b, ",\"return_type_tag\":")
  mcp_write_i(b, decl_return_type_tag_or(decl, 0 - 1))
  mcp_write(b, ",\"return_type_prim\":")
  mcp_write_i(b, decl_return_type_prim_id_or(decl, 0 - 1))
  mcp_write(b, ",\"effects\":")
  mcp_write_i(b, decl_effect_count_or(decl, 0))
  mcp_write(b, ",\"effect_tail\":")
  mcp_write_i(b, decl_effect_tail_or(decl, 0))
  mcp_end_result(b)
}

fn mcp_emit_type_lookup_entry(b: i64, entry: TypeEntry, name_ptr: i64, name_n: i64) -> i64 {
  mcp_begin_result(b, "type_lookup")
  mcp_write(b, ",\"name\":")
  mcp_write_json_bytes(b, name_ptr, name_n)
  mcp_write(b, ",\"found\":true,\"kind\":")
  mcp_write_type_entry_kind(b, type_entry_kind_or(entry, 0 - 1))
  mcp_write(b, ",\"items\":")
  mcp_write_i(b, type_entry_item_count_or(entry, 0))
  mcp_write(b, ",\"type_params\":")
  mcp_write_i(b, type_entry_type_param_count_or(entry, 0))
  mcp_end_result(b)
}

fn mcp_emit_type_lookup(b: i64, src: i64, n: i64, name_ptr: i64, name_n: i64) -> i64 {
  let typed = mcp_check_source_quiet(src, n)
  match mcp_lookup_function_decl(pipeline_typed_fns(typed), name_ptr, name_n) {
    McpFunctionLookup(decl, fn_src) -> mcp_emit_type_lookup_function(b, decl, name_ptr, name_n)
    MissingMcpFunctionLookup -> {
      let entry = mcp_lookup_type_entry(pipeline_typed_type_entries(typed), name_ptr, name_n, 0 - 1)
      if type_entry_kind_or(entry, 0 - 1) >= 0 { mcp_emit_type_lookup_entry(b, entry, name_ptr, name_n) }
      else { mcp_emit_type_lookup_not_found(b, name_ptr, name_n) }
    }
  }
}

fn mcp_effect_op_name_start_or(op: TypeEffectOp, default: i64) -> i64 {
  match op {
    TypeEffectOp(ns, nl, params, ret_type) -> ns
    DeferredTypeEffectOp(ns, nl, params, ret_type) -> ns
    MissingTypeEffectOp -> default
  }
}

fn mcp_emit_effect_lookup_not_found(b: i64, name_ptr: i64, name_n: i64) -> i64 {
  mcp_begin_result(b, "effect_lookup")
  mcp_write(b, ",\"name\":")
  mcp_write_json_bytes(b, name_ptr, name_n)
  mcp_write(b, ",\"found\":false")
  mcp_end_result(b)
}

fn mcp_emit_effect_lookup_entry(b: i64, entry: TypeEntry, name_ptr: i64, name_n: i64) -> i64 {
  let entry_src = type_entry_source_or(entry, 0)
  let ops = type_entry_effect_ops(entry)
  let nops = type_effect_op_list_len(ops)
  let first = type_effect_op_list_nth(ops, 0)
  mcp_begin_result(b, "effect_lookup")
  mcp_write(b, ",\"name\":")
  mcp_write_json_bytes(b, name_ptr, name_n)
  mcp_write(b, ",\"found\":true,\"kind\":\"effect\",\"ops\":")
  mcp_write_i(b, nops)
  mcp_write(b, ",\"first_op\":")
  if nops == 0 { mcp_write(b, "null") }
  else {
    let op_ns = mcp_effect_op_name_start_or(first, 0)
    let op_nl = type_effect_op_name_len_or(first, 0)
    mcp_write_json_bytes(b, entry_src + op_ns, op_nl)
  }
  mcp_write(b, ",\"first_op_params\":")
  mcp_write_i(b, type_effect_op_param_count_or(first, 0 - 1))
  mcp_write(b, ",\"first_op_return_type_tag\":")
  mcp_write_i(b, type_effect_op_return_type_tag_or(first, 0 - 1))
  mcp_write(b, ",\"first_op_return_type_prim\":")
  mcp_write_i(b, type_effect_op_return_type_prim_id_or(first, 0 - 1))
  mcp_write(b, ",\"first_op_deferred\":")
  mcp_write_i(b, type_effect_op_is_deferred(first))
  mcp_end_result(b)
}

fn mcp_emit_effect_lookup(b: i64, src: i64, n: i64, name_ptr: i64, name_n: i64) -> i64 {
  let typed = mcp_check_source_quiet(src, n)
  let entry = mcp_lookup_type_entry(pipeline_typed_type_entries(typed), name_ptr, name_n, 2)
  if type_entry_kind_or(entry, 0 - 1) >= 0 { mcp_emit_effect_lookup_entry(b, entry, name_ptr, name_n) }
  else { mcp_emit_effect_lookup_not_found(b, name_ptr, name_n) }
}

fn mcp_dispatch_lookup_tool(b: i64, req: i64, n: i64, root: i64, src: i64, src_n: i64, tool_id: i64) -> i64 {
  let name_pair = mcp_extract_lookup_name(req, n, root)
  let name_ptr = mem_load64_at(name_pair, 0)
  let name_n = mem_load64_at(name_pair, 8)
  if name_ptr == 0 {
    mcp_emit_error(b, 0 - 32602, "missing lookup name")
  } else {
    match tool_id {
      4 -> mcp_emit_type_lookup(b, src, src_n, name_ptr, name_n)
      5 -> mcp_emit_effect_lookup(b, src, src_n, name_ptr, name_n)
      _ -> mcp_emit_error(b, 0 - 32601, "unknown tool")
    }
  }
}

fn mcp_dispatch_known_tool(b: i64, req: i64, n: i64, root: i64, tool_id: i64) -> i64 {
  let pair = mcp_extract_source(req, n, root)
  let src = mem_load64_at(pair, 0)
  let src_n = mem_load64_at(pair, 8)
  if src == 0 {
    mcp_emit_error(b, 0 - 32602, "missing source")
  } else {
    match tool_id {
      1 -> mcp_emit_parse_summary(b, src, src_n)
      2 -> mcp_emit_check_summary(b, src, src_n)
      3 -> mcp_emit_ir_summary(b, src, src_n)
      4 -> mcp_dispatch_lookup_tool(b, req, n, root, src, src_n, tool_id)
      5 -> mcp_dispatch_lookup_tool(b, req, n, root, src, src_n, tool_id)
      6 -> mcp_emit_diagnostics(b, src, src_n)
      7 -> mcp_dispatch_grammar_tool(b, req, n, root, src, src_n, tool_id)
      8 -> mcp_dispatch_grammar_tool(b, req, n, root, src, src_n, tool_id)
      9 -> mcp_dispatch_grammar_tool(b, req, n, root, src, src_n, tool_id)
      10 -> mcp_emit_opt_counters(b, src, src_n)
      _ -> mcp_emit_error(b, 0 - 32601, "unknown tool")
    }
  }
}

fn mcp_dispatch_tool(b: i64, req: i64, n: i64, root: i64) -> i64 {
  let params = mcp_json_object_field_start(req, n, root, "params")
  let name_value = mcp_json_field_value_start(req, n, params, "name")
  if name_value < 0 {
    mcp_emit_error(b, 0 - 32602, "missing tool name")
  } else {
    if mcp_json_string_value_eq(req, n, name_value, "parse_summary") == 1 {
      mcp_dispatch_known_tool(b, req, n, root, 1)
    } else { if mcp_json_string_value_eq(req, n, name_value, "check_summary") == 1 {
      mcp_dispatch_known_tool(b, req, n, root, 2)
    } else { if mcp_json_string_value_eq(req, n, name_value, "ir_summary") == 1 {
      mcp_dispatch_known_tool(b, req, n, root, 3)
    } else { if mcp_json_string_value_eq(req, n, name_value, "type_lookup") == 1 {
      mcp_dispatch_known_tool(b, req, n, root, 4)
    } else { if mcp_json_string_value_eq(req, n, name_value, "effect_lookup") == 1 {
      mcp_dispatch_known_tool(b, req, n, root, 5)
    } else { if mcp_json_string_value_eq(req, n, name_value, "diagnostics") == 1 {
      mcp_dispatch_known_tool(b, req, n, root, 6)
    } else { if mcp_json_string_value_eq(req, n, name_value, "grammar_parse") == 1 {
      mcp_dispatch_known_tool(b, req, n, root, 7)
    } else { if mcp_json_string_value_eq(req, n, name_value, "grammar_check") == 1 {
      mcp_dispatch_known_tool(b, req, n, root, 8)
    } else { if mcp_json_string_value_eq(req, n, name_value, "grammar_diagnostics") == 1 {
      mcp_dispatch_known_tool(b, req, n, root, 9)
    } else { if mcp_json_string_value_eq(req, n, name_value, "opt_counters") == 1 {
      mcp_dispatch_known_tool(b, req, n, root, 10)
    } else {
      mcp_emit_error(b, 0 - 32601, "unknown tool")
    } } } } } } } } } }
  }
}

-- Process one JSON-RPC request. Returns 0 when b holds a result
-- payload, otherwise the JSON-RPC error code (b holds the message).
fn mcp_process_request(b: i64, req: i64, n: i64) -> i64 {
  let root = mcp_json_root_object_start(req, n)
  if root < 0 {
    mcp_emit_error(b, 0 - 32700, "invalid json-rpc")
  } else {
    let jsonrpc = mcp_json_field_value_start(req, n, root, "jsonrpc")
    let method = mcp_json_field_value_start(req, n, root, "method")
    if mcp_json_string_value_eq(req, n, jsonrpc, "2.0") == 0 {
      mcp_emit_error(b, 0 - 32600, "invalid request")
    } else { if method < 0 {
      mcp_emit_error(b, 0 - 32600, "invalid request")
    } else { if mcp_json_string_value_eq(req, n, method, "tools/list") == 1 {
      mcp_emit_tools_list(b)
    } else { if mcp_json_string_value_eq(req, n, method, "tools/call") == 1 {
      mcp_dispatch_tool(b, req, n, root)
    } else {
      mcp_emit_error(b, 0 - 32601, "unknown method")
    } } } }
  }
}

-- Legacy one-shot pipe: single request on stdin, raw JSON-RPC response
-- on stdout with the historical fixed id envelope. Scripts and the tool
-- boundary snapshots depend on this exact wire format.
fn run_mcp() -> i64 {
  let input = read_stdin_all()
  let req = mem_load64_at(input, 0)
  let n = mem_load64_at(input, 8)
  let b = buf_new(65536)
  let code = mcp_process_request(b, req, n)
  if code == 0 {
    oprint("{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":")
    sys_write(1, buf_ptr(b), buf_len(b))
    oprint("}")
  } else {
    oprint("{\"jsonrpc\":\"2.0\",\"id\":")
    if code == 0 - 32700 { oprint("null") } else { oprint("1") }
    oprint(",\"error\":{\"code\":")
    oprint_i(code)
    oprint(",\"message\":\"")
    sys_write(1, buf_ptr(b), buf_len(b))
    oprint("\"}}")
  }
  0
}

-- ======================================================================
-- weft mcp serve — persistent stdio MCP server. Newline-delimited
-- JSON-RPC with the initialize handshake, request-id echo, tools/list
-- with input schemas, and tools/call results wrapped as MCP content.
-- The bare `weft mcp` form stays the one-shot raw pipe above.
-- ======================================================================

fn mcp_buf_append_bytes(out: i64, ptr: i64, len: i64) -> i64 {
  let mut i = 0
  while i < len {
    bu8(out, mem_load8_at(ptr, i))
    i = i + 1
  }
  0
}

-- JSON-string-escape payload bytes into out (quotes not included).
fn mcp_buf_append_escaped(out: i64, ptr: i64, len: i64) -> i64 {
  let mut i = 0
  while i < len {
    let ch = mem_load8_at(ptr, i)
    if ch == 34 { bstr(out, "\\\"") }
    else { if ch == 92 { bstr(out, "\\\\") }
    else { if ch == 10 { bstr(out, "\\n") }
    else { if ch == 13 { bstr(out, "\\r") }
    else { if ch == 9 { bstr(out, "\\t") }
    else { if ch >= 32 { bu8(out, ch) } else { 0 } } } } } }
    i = i + 1
  }
  0
}

-- Appends bytes until newline or EOF. Returns 1 when a line is
-- available (possibly empty), 0 on EOF with nothing buffered.
fn mcp_serve_read_line(b: i64, scratch: i64) -> i64 {
  let mut done = 0
  let mut got = 0
  while done == 0 {
    let r = sys_read(0, scratch, 1)
    if r <= 0 {
      done = 1
      if buf_len(b) > 0 { got = 1 } else { 0 }
    } else {
      let ch = mem_load8_at(scratch, 0)
      if ch == 10 {
        done = 1
        got = 1
      } else { bu8(b, ch) }
    }
  }
  got
}

-- Raw byte span [start, end) of the request id value, or 0 when the
-- request carries no id (a notification — never answered).
fn mcp_request_id_span(req: i64, n: i64, root: i64) -> i64 {
  let start = mcp_json_field_value_start(req, n, root, "id")
  if start < 0 { 0 }
  else {
    let end_r = mcp_json_parse_value(req, n, start)
    if mcp_json_result_ok(end_r) == 0 { 0 }
    else {
      let pair = main_alloc_bytes(16)
      mem_store64_at(pair, 0, start)
      mem_store64_at(pair, 8, mcp_json_result_pos(end_r))
      pair
    }
  }
}

fn mcp_serve_write_response(out: i64) -> i64 {
  bstr(out, "\n")
  sys_write(1, buf_ptr(out), buf_len(out))
  0
}

-- Emit one framed response: result payload (code == 0) or JSON-RPC
-- error (code != 0, payload holds the message). id_span 0 → id null
-- (only used for parse errors; notifications never reach here).
fn mcp_serve_respond(req: i64, payload: i64, code: i64, id_span: i64, wrap_content: i64) -> i64 {
  let out = buf_new(buf_len(payload) + 512)
  bstr(out, "{\"jsonrpc\":\"2.0\",\"id\":")
  if id_span == 0 { bstr(out, "null") }
  else {
    let ids = mem_load64_at(id_span, 0)
    let ide = mem_load64_at(id_span, 8)
    mcp_buf_append_bytes(out, req + ids, ide - ids)
  }
  if code == 0 {
    if wrap_content == 1 {
      bstr(out, ",\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"")
      mcp_buf_append_escaped(out, buf_ptr(payload), buf_len(payload))
      bstr(out, "\"}],\"isError\":false}}")
    } else {
      bstr(out, ",\"result\":")
      mcp_buf_append_bytes(out, buf_ptr(payload), buf_len(payload))
      bstr(out, "}")
    }
  } else {
    bstr(out, ",\"error\":{\"code\":")
    lsp_buf_append_i(out, code)
    bstr(out, ",\"message\":\"")
    mcp_buf_append_escaped(out, buf_ptr(payload), buf_len(payload))
    bstr(out, "\"}}")
  }
  mcp_serve_write_response(out)
}

fn mcp_serve_initialize_payload(b: i64, req: i64, n: i64, root: i64) -> i64 {
  bstr(b, "{\"protocolVersion\":")
  let params = mcp_json_object_field_start(req, n, root, "params")
  let ver = mcp_json_field_value_start(req, n, params, "protocolVersion")
  let echoed = if ver >= 0 {
    let end_r = mcp_json_parse_string(req, n, ver)
    if mcp_json_result_ok(end_r) == 1 {
      mcp_buf_append_bytes(b, req + ver, mcp_json_result_pos(end_r) - ver)
      1
    } else { 0 }
  } else { 0 }
  if echoed == 0 { bstr(b, "\"2025-06-18\"") } else { 0 }
  bstr(b, ",\"capabilities\":{\"tools\":{}},\"serverInfo\":{\"name\":\"weft\",\"version\":\"0.1.0\"}}")
  0
}

fn mcp_serve_tools_list_payload(b: i64) -> i64 {
  bstr(b, "{\"tools\":[")
  bstr(b, "{\"name\":\"parse_summary\",\"description\":\"Parse Weft source and report function count and first body expression tag.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"source\":{\"type\":\"string\",\"description\":\"Weft source text\"}},\"required\":[\"source\"]}},")
  bstr(b, "{\"name\":\"check_summary\",\"description\":\"Parse and type-check Weft source; report function count and first body tag.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"source\":{\"type\":\"string\",\"description\":\"Weft source text\"}},\"required\":[\"source\"]}},")
  bstr(b, "{\"name\":\"ir_summary\",\"description\":\"Lower Weft source to typed IR; report function, block, and instruction counts.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"source\":{\"type\":\"string\",\"description\":\"Weft source text\"}},\"required\":[\"source\"]}},")
  bstr(b, "{\"name\":\"type_lookup\",\"description\":\"Look up a function, record, or variant type by name in Weft source.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"source\":{\"type\":\"string\",\"description\":\"Weft source text\"},\"name\":{\"type\":\"string\",\"description\":\"Identifier to look up\"}},\"required\":[\"source\",\"name\"]}},")
  bstr(b, "{\"name\":\"effect_lookup\",\"description\":\"Look up an effect declaration by name in Weft source.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"source\":{\"type\":\"string\",\"description\":\"Weft source text\"},\"name\":{\"type\":\"string\",\"description\":\"Effect name to look up\"}},\"required\":[\"source\",\"name\"]}},")
  bstr(b, "{\"name\":\"diagnostics\",\"description\":\"Parse and type-check Weft source; report all diagnostics with line and column.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"source\":{\"type\":\"string\",\"description\":\"Weft source text\"}},\"required\":[\"source\"]}},")
  bstr(b, "{\"name\":\"grammar_parse\",\"description\":\"Parse source with an embedded grammar module (e.g. mini_sql).\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"grammar\":{\"type\":\"string\",\"description\":\"Grammar module name\"},\"source\":{\"type\":\"string\",\"description\":\"Source text in the embedded language\"}},\"required\":[\"grammar\",\"source\"]}},")
  bstr(b, "{\"name\":\"grammar_check\",\"description\":\"Parse and check source with an embedded grammar module, optionally against host Weft types.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"grammar\":{\"type\":\"string\",\"description\":\"Grammar module name\"},\"source\":{\"type\":\"string\",\"description\":\"Source text in the embedded language\"},\"host_source\":{\"type\":\"string\",\"description\":\"Optional host Weft source providing table types\"}},\"required\":[\"grammar\",\"source\"]}},")
  bstr(b, "{\"name\":\"grammar_diagnostics\",\"description\":\"Report embedded-grammar diagnostics with line and column, optionally against host Weft types.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"grammar\":{\"type\":\"string\",\"description\":\"Grammar module name\"},\"source\":{\"type\":\"string\",\"description\":\"Source text in the embedded language\"},\"host_source\":{\"type\":\"string\",\"description\":\"Optional host Weft source providing table types\"}},\"required\":[\"grammar\",\"source\"]}},")
  bstr(b, "{\"name\":\"opt_counters\",\"description\":\"Compile Weft source through the optimiser and report per-pass site counters and native emission counters.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"source\":{\"type\":\"string\",\"description\":\"Weft source text\"}},\"required\":[\"source\"]}}")
  bstr(b, "]}")
  0
}

fn mcp_serve_handle_line(req: i64, n: i64) -> i64 {
  let root = mcp_json_root_object_start(req, n)
  if root < 0 {
    let msg = buf_new(64)
    bstr(msg, "parse error")
    mcp_serve_respond(req, msg, 0 - 32700, 0, 0)
  } else {
    let id_span = mcp_request_id_span(req, n, root)
    let method = mcp_json_field_value_start(req, n, root, "method")
    if id_span == 0 {
      -- Notification (initialized, cancelled, ...): no response.
      0
    } else { if method < 0 {
      let msg = buf_new(64)
      bstr(msg, "invalid request")
      mcp_serve_respond(req, msg, 0 - 32600, id_span, 0)
    } else { if mcp_json_string_value_eq(req, n, method, "initialize") == 1 {
      let b = buf_new(512)
      mcp_serve_initialize_payload(b, req, n, root)
      mcp_serve_respond(req, b, 0, id_span, 0)
    } else { if mcp_json_string_value_eq(req, n, method, "ping") == 1 {
      let b = buf_new(8)
      bstr(b, "{}")
      mcp_serve_respond(req, b, 0, id_span, 0)
    } else { if mcp_json_string_value_eq(req, n, method, "tools/list") == 1 {
      let b = buf_new(4096)
      mcp_serve_tools_list_payload(b)
      mcp_serve_respond(req, b, 0, id_span, 0)
    } else { if mcp_json_string_value_eq(req, n, method, "tools/call") == 1 {
      let b = buf_new(65536)
      let code = mcp_dispatch_tool(b, req, n, root)
      mcp_serve_respond(req, b, code, id_span, 1)
    } else {
      let msg = buf_new(64)
      bstr(msg, "method not found")
      mcp_serve_respond(req, msg, 0 - 32601, id_span, 0)
    } } } } } }
  }
}

fn run_mcp_serve() -> i64 {
  let scratch = main_alloc_bytes(8)
  let mut running = 1
  while running == 1 {
    let line = buf_new(4096)
    if mcp_serve_read_line(line, scratch) == 0 {
      running = 0
    } else {
      if buf_len(line) > 0 {
        mcp_serve_handle_line(buf_ptr(line), buf_len(line))
      } else { 0 }
    }
  }
  0
}

-- ======================================================================
-- Tool: lsp — stateless-ish stdio language server
-- ======================================================================

fn lsp_buf_append_i(b: i64, n: i64) -> i64 {
  if n < 0 {
    bstr(b, "-")
    lsp_buf_append_i(b, 0 - n)
  } else {
    if n < 10 {
      bu8(b, 48 + n)
    } else {
      lsp_buf_append_i(b, n / 10)
      bu8(b, 48 + n - n / 10 * 10)
    }
  }
  buf_len(b)
}

fn lsp_buf_append_json_bytes(b: i64, ptr: i64, n: i64) -> i64 {
  bstr(b, "\"")
  let mut i = 0
  while i < n {
    let ch = mem_load8_at(ptr, i)
    if ch == 34 {
      bstr(b, "\\\"")
    } else { if ch == 92 {
      bstr(b, "\\\\")
    } else { if ch == 10 {
      bstr(b, "\\n")
    } else { if ch == 13 {
      bstr(b, "\\r")
    } else { if ch == 9 {
      bstr(b, "\\t")
    } else {
      if ch >= 32 { bu8(b, ch) } else { 0 }
    } } } } }
    i = i + 1
  }
  bstr(b, "\"")
  buf_len(b)
}

fn lsp_write_body(body: i64) -> i64 {
  oprint("Content-Length: ")
  oprint_i(buf_len(body))
  let sep = main_alloc_bytes(4)
  mem_store8_at(sep, 0, 13)
  mem_store8_at(sep, 1, 10)
  mem_store8_at(sep, 2, 13)
  mem_store8_at(sep, 3, 10)
  sys_write(1, sep, 4)
  sys_write(1, buf_ptr(body), buf_len(body))
}

fn lsp_state_new() -> i64 {
  let st = main_alloc_bytes(40)
  mem_store64_at(st, 0, 0)
  mem_store64_at(st, 8, 0)
  mem_store64_at(st, 16, 0)
  mem_store64_at(st, 24, 0)
  mem_store64_at(st, 32, 0)
  st
}

fn lsp_state_uri_ptr(st: i64) -> i64 { mem_load64_at(st, 0) }
fn lsp_state_uri_len(st: i64) -> i64 { mem_load64_at(st, 8) }
fn lsp_state_src_ptr(st: i64) -> i64 { mem_load64_at(st, 16) }
fn lsp_state_src_len(st: i64) -> i64 { mem_load64_at(st, 24) }
fn lsp_state_version(st: i64) -> i64 { mem_load64_at(st, 32) }

fn lsp_state_set_doc(st: i64, uri_ptr: i64, uri_n: i64, src: i64, n: i64, version: i64) -> i64 {
  mem_store64_at(st, 0, uri_ptr)
  mem_store64_at(st, 8, uri_n)
  mem_store64_at(st, 16, src)
  mem_store64_at(st, 24, n)
  mem_store64_at(st, 32, version)
  0
}

fn lsp_state_uri_matches(st: i64, uri_ptr: i64, uri_n: i64) -> i64 {
  let cur_ptr = lsp_state_uri_ptr(st)
  let cur_n = lsp_state_uri_len(st)
  if cur_ptr == 0 { 0 }
  else { if uri_ptr == 0 { 1 }
  else { mcp_name_bytes_eq(cur_ptr, cur_n, uri_ptr, uri_n) } }
}

fn lsp_json_int_at(src: i64, n: i64, pos: i64, default: i64) -> i64 {
  if pos < 0 or pos >= n { default }
  else {
    let mut p = pos
    let mut sign = 1
    if mem_load8_at(src, p) == 45 { sign = 0 - 1 p = p + 1 } else { 0 }
    let mut value = 0
    let mut seen = 0
    while p < n and is_digit(mem_load8_at(src, p)) == 1 {
      value = value * 10 + mem_load8_at(src, p) - 48
      seen = 1
      p = p + 1
    }
    if seen == 1 { value * sign } else { default }
  }
}

fn lsp_json_first_array_object_start(src: i64, n: i64, value_start: i64) -> i64 {
  if value_start < 0 or value_start >= n { 0 - 1 }
  else { if mem_load8_at(src, value_start) != 91 { 0 - 1 }
  else {
    let p = mcp_skip_json_ws(src, n, value_start + 1)
    if p < n and mem_load8_at(src, p) == 123 { p } else { 0 - 1 }
  } }
}

fn lsp_extract_params_object(req: i64, n: i64, root: i64) -> i64 {
  mcp_json_object_field_start(req, n, root, "params")
}

fn lsp_extract_text_document_object(req: i64, n: i64, root: i64) -> i64 {
  let params = lsp_extract_params_object(req, n, root)
  mcp_json_object_field_start(req, n, params, "textDocument")
}

fn lsp_extract_text_document_string(req: i64, n: i64, root: i64, key: str) -> i64 {
  let doc = lsp_extract_text_document_object(req, n, root)
  let value = mcp_json_field_value_start(req, n, doc, key)
  mcp_decode_json_string_pair(req, n, value)
}

fn lsp_extract_text_document_version(req: i64, n: i64, root: i64, default: i64) -> i64 {
  let doc = lsp_extract_text_document_object(req, n, root)
  let value = mcp_json_field_value_start(req, n, doc, "version")
  lsp_json_int_at(req, n, value, default)
}

fn lsp_extract_position_line(req: i64, n: i64, root: i64) -> i64 {
  let params = lsp_extract_params_object(req, n, root)
  let pos = mcp_json_object_field_start(req, n, params, "position")
  lsp_json_int_at(req, n, mcp_json_field_value_start(req, n, pos, "line"), 0)
}

fn lsp_extract_position_character(req: i64, n: i64, root: i64) -> i64 {
  let params = lsp_extract_params_object(req, n, root)
  let pos = mcp_json_object_field_start(req, n, params, "position")
  lsp_json_int_at(req, n, mcp_json_field_value_start(req, n, pos, "character"), 0)
}

fn lsp_extract_change_text(req: i64, n: i64, root: i64) -> i64 {
  let params = lsp_extract_params_object(req, n, root)
  let changes = mcp_json_field_value_start(req, n, params, "contentChanges")
  let first = lsp_json_first_array_object_start(req, n, changes)
  let value = mcp_json_field_value_start(req, n, first, "text")
  mcp_decode_json_string_pair(req, n, value)
}

fn lsp_append_id_or_null(b: i64, req: i64, n: i64, root: i64) -> i64 {
  let id_start = mcp_json_field_value_start(req, n, root, "id")
  if id_start < 0 {
    bstr(b, "null")
  } else {
    let parsed = mcp_json_parse_value(req, n, id_start)
    if mcp_json_result_ok(parsed) == 0 { bstr(b, "null") }
    else { bscopy(b, req + id_start, mcp_json_result_pos(parsed) - id_start, 0) }
  }
  buf_len(b)
}

fn lsp_response_start(b: i64, req: i64, n: i64, root: i64) -> i64 {
  bstr(b, "{\"jsonrpc\":\"2.0\",\"id\":")
  lsp_append_id_or_null(b, req, n, root)
  bstr(b, ",\"result\":")
  buf_len(b)
}

fn lsp_emit_error_response(req: i64, n: i64, root: i64, code: i64, message: str) -> i64 {
  let body = buf_new(512)
  bstr(body, "{\"jsonrpc\":\"2.0\",\"id\":")
  if root < 0 { bstr(body, "null") } else { lsp_append_id_or_null(body, req, n, root) }
  bstr(body, ",\"error\":{\"code\":")
  lsp_buf_append_i(body, code)
  bstr(body, ",\"message\":")
  lsp_buf_append_json_bytes(body, __str_ptr(message), __str_len(message))
  bstr(body, "}}")
  lsp_write_body(body)
}

fn lsp_span_line0(src: i64, span: i64) -> i64 {
  if span < 0 { 0 }
  else {
    let mut i = 0
    let mut line = 0
    while i < span {
      if mem_load8_at(src, i) == 10 { line = line + 1 } else { 0 }
      i = i + 1
    }
    line
  }
}

fn lsp_span_col0(src: i64, span: i64) -> i64 {
  if span < 0 { 0 }
  else {
    let mut i = 0
    let mut col = 0
    while i < span {
      if mem_load8_at(src, i) == 10 { col = 0 } else { col = col + 1 }
      i = i + 1
    }
    col
  }
}

fn lsp_offset_for_line_col(src: i64, n: i64, line: i64, ch: i64) -> i64 {
  let mut i = 0
  let mut cur_line = 0
  let mut cur_ch = 0
  let mut done = 0
  while i < n and done == 0 {
    if cur_line == line and cur_ch == ch { done = 1 }
    else {
      let c = mem_load8_at(src, i)
      i = i + 1
      if c == 10 { cur_line = cur_line + 1 cur_ch = 0 }
      else { cur_ch = cur_ch + 1 }
    }
  }
  i
}

fn lsp_buf_append_range(b: i64, src: i64, start: i64, end_pos: i64) -> i64 {
  let s = if start < 0 { 0 } else { start }
  let e = if end_pos <= s { s + 1 } else { end_pos }
  bstr(b, "{\"start\":{\"line\":")
  lsp_buf_append_i(b, lsp_span_line0(src, s))
  bstr(b, ",\"character\":")
  lsp_buf_append_i(b, lsp_span_col0(src, s))
  bstr(b, "},\"end\":{\"line\":")
  lsp_buf_append_i(b, lsp_span_line0(src, e))
  bstr(b, ",\"character\":")
  lsp_buf_append_i(b, lsp_span_col0(src, e))
  bstr(b, "}}")
  buf_len(b)
}

fn lsp_collect_diagnostics(src: i64, n: i64) -> i64 {
  let tt = ttable_new()
  pipeline_mark_root_origin(tt, src, 0, 1)
  let grammar = weft_grammar()
  let diags = nlist_new()
  let fns = handle grammar.parse(src, n, tt) {
    Diagnose.error(msg, span) -> { nlist_add(diags, mcp_diag_entry(1, msg, span)) resume(0) }
    Diagnose.warn(msg, span) -> { nlist_add(diags, mcp_diag_entry(2, msg, span)) resume(0) }
    Diagnose.note(msg, span) -> { nlist_add(diags, mcp_diag_entry(3, msg, span)) resume(0) }
  }
  handle grammar.check(fns, src, tt) {
    Diagnose.error(msg, span) -> { nlist_add(diags, mcp_diag_entry(1, msg, span)) resume(0) }
    Diagnose.warn(msg, span) -> { nlist_add(diags, mcp_diag_entry(2, msg, span)) resume(0) }
    Diagnose.note(msg, span) -> { nlist_add(diags, mcp_diag_entry(3, msg, span)) resume(0) }
  }
  diags
}

fn lsp_buf_append_diag_item(b: i64, src: i64, entry: i64) -> i64 {
  let msg_ptr = mem_load64_at(entry, 8)
  let msg_len = mem_load64_at(entry, 16)
  -- Spans are absolute addresses; reduce to a root-relative offset so the
  -- line/col walk stays inside the buffer.
  let span = diagnose_normalize_span(src, mem_load64_at(entry, 24))
  bstr(b, "{\"range\":")
  lsp_buf_append_range(b, src, span, span + 1)
  bstr(b, ",\"severity\":1,\"source\":\"weft\",\"message\":")
  lsp_buf_append_json_bytes(b, msg_ptr, msg_len)
  bstr(b, "}")
  buf_len(b)
}

fn lsp_emit_publish_diagnostics(st: i64) -> i64 {
  let body = buf_new(4096)
  let src = lsp_state_src_ptr(st)
  let n = lsp_state_src_len(st)
  let diags = if src == 0 { nlist_new() } else { lsp_collect_diagnostics(src, n) }
  bstr(body, "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":")
  if lsp_state_uri_ptr(st) == 0 { lsp_buf_append_json_bytes(body, __str_ptr(""), 0) }
  else { lsp_buf_append_json_bytes(body, lsp_state_uri_ptr(st), lsp_state_uri_len(st)) }
  bstr(body, ",\"diagnostics\":[")
  for i in 0..nlist_len(diags) {
    if i > 0 { bstr(body, ",") } else { 0 }
    lsp_buf_append_diag_item(body, src, nlist_get(diags, i))
  }
  bstr(body, "]}}")
  lsp_write_body(body)
}

fn lsp_emit_initialize(req: i64, n: i64, root: i64) -> i64 {
  let body = buf_new(1024)
  lsp_response_start(body, req, n, root)
  bstr(body, "{\"capabilities\":{\"textDocumentSync\":1,\"hoverProvider\":true,\"definitionProvider\":true,\"completionProvider\":{\"triggerCharacters\":[\".\"]},\"codeActionProvider\":true}}}")
  lsp_write_body(body)
}

fn lsp_is_ident_char_at(src: i64, n: i64, pos: i64) -> i64 {
  if pos < 0 or pos >= n { 0 } else { is_alnum(mem_load8_at(src, pos)) }
}

fn lsp_identifier_bounds(src: i64, n: i64, offset: i64) -> i64 {
  let pair = main_alloc_bytes(16)
  let mut pos = offset
  if pos >= n { pos = n - 1 } else { 0 }
  if lsp_is_ident_char_at(src, n, pos) == 0 and pos > 0 and lsp_is_ident_char_at(src, n, pos - 1) == 1 {
    pos = pos - 1
  } else { 0 }
  if lsp_is_ident_char_at(src, n, pos) == 0 {
    mem_store64_at(pair, 0, 0)
    mem_store64_at(pair, 8, 0)
  } else {
    let mut s = pos
    let mut e = pos + 1
    while s > 0 and lsp_is_ident_char_at(src, n, s - 1) == 1 { s = s - 1 }
    while e < n and lsp_is_ident_char_at(src, n, e) == 1 { e = e + 1 }
    if is_alpha(mem_load8_at(src, s)) == 0 {
      mem_store64_at(pair, 0, 0)
      mem_store64_at(pair, 8, 0)
    } else {
      mem_store64_at(pair, 0, s)
      mem_store64_at(pair, 8, e - s)
    }
  }
  pair
}

fn lsp_find_let_binding_before(src: i64, n: i64, name_ptr: i64, name_n: i64, limit: i64) -> i64 {
  let mut i = 0
  let mut result = 0 - 1
  while i + 3 < limit and result < 0 {
    if src_eq(src, i, 3, "let") == 1 and (i == 0 or lsp_is_ident_char_at(src, n, i - 1) == 0) and lsp_is_ident_char_at(src, n, i + 3) == 0 {
      let mut p = i + 3
      while p < limit and is_ws(mem_load8_at(src, p)) == 1 { p = p + 1 }
      if p + 3 < limit and src_eq(src, p, 3, "mut") == 1 and lsp_is_ident_char_at(src, n, p + 3) == 0 {
        p = p + 3
        while p < limit and is_ws(mem_load8_at(src, p)) == 1 { p = p + 1 }
      } else { 0 }
      let mut e = p
      while e < limit and lsp_is_ident_char_at(src, n, e) == 1 { e = e + 1 }
      if e > p and mcp_name_bytes_eq(name_ptr, name_n, src + p, e - p) == 1 {
        result = p
      } else { 0 }
      i = e + 1
    } else {
      i = i + 1
    }
  }
  result
}

fn lsp_buf_append_type_entry_kind_text(b: i64, kind: i64) -> i64 {
  match kind {
    0 -> bstr(b, "record")
    1 -> bstr(b, "variant")
    2 -> bstr(b, "effect")
    3 -> bstr(b, "trait")
    4 -> bstr(b, "impl")
    _ -> bstr(b, "unknown")
  }
  buf_len(b)
}

fn lsp_emit_hover_null(req: i64, n: i64, root: i64) -> i64 {
  let body = buf_new(256)
  lsp_response_start(body, req, n, root)
  bstr(body, "null}")
  lsp_write_body(body)
}

fn lsp_emit_hover_value(req: i64, n: i64, root: i64, value: i64) -> i64 {
  let body = buf_new(512)
  lsp_response_start(body, req, n, root)
  bstr(body, "{\"contents\":{\"kind\":\"plaintext\",\"value\":")
  lsp_buf_append_json_bytes(body, buf_ptr(value), buf_len(value))
  bstr(body, "}}}")
  lsp_write_body(body)
}

fn lsp_emit_hover(req: i64, n: i64, root: i64, st: i64) -> i64 {
  let uri_pair = lsp_extract_text_document_string(req, n, root, "uri")
  let uri_ptr = mem_load64_at(uri_pair, 0)
  let uri_n = mem_load64_at(uri_pair, 8)
  let src = lsp_state_src_ptr(st)
  let src_n = lsp_state_src_len(st)
  if src == 0 or lsp_state_uri_matches(st, uri_ptr, uri_n) == 0 {
    lsp_emit_hover_null(req, n, root)
  } else {
    let off = lsp_offset_for_line_col(src, src_n, lsp_extract_position_line(req, n, root), lsp_extract_position_character(req, n, root))
    let bounds = lsp_identifier_bounds(src, src_n, off)
    let name_start = mem_load64_at(bounds, 0)
    let name_n = mem_load64_at(bounds, 8)
    if name_n == 0 {
      lsp_emit_hover_null(req, n, root)
    } else {
      let typed = mcp_check_source_quiet(src, src_n)
      let name_ptr = src + name_start
      match mcp_lookup_function_decl(pipeline_typed_fns(typed), name_ptr, name_n) {
        McpFunctionLookup(decl, fn_src) -> {
          let params = decl_params(decl)
          let value = buf_new(256)
          bstr(value, "function ")
          bscopy(value, name_ptr, name_n, 0)
          bstr(value, ": params=")
          lsp_buf_append_i(value, param_list_len(params))
          bstr(value, " return_type_tag=")
          lsp_buf_append_i(value, decl_return_type_tag_or(decl, 0 - 1))
          bstr(value, " effects=")
          lsp_buf_append_i(value, decl_effect_count_or(decl, 0))
          lsp_emit_hover_value(req, n, root, value)
        }
        MissingMcpFunctionLookup -> {
          let type_entry = mcp_lookup_type_entry(pipeline_typed_type_entries(typed), name_ptr, name_n, 0 - 1)
          if type_entry_kind_or(type_entry, 0 - 1) >= 0 {
            let value = buf_new(256)
            bstr(value, "type ")
            bscopy(value, name_ptr, name_n, 0)
            bstr(value, ": ")
            lsp_buf_append_type_entry_kind_text(value, type_entry_kind_or(type_entry, 0 - 1))
            bstr(value, " items=")
            lsp_buf_append_i(value, type_entry_item_count_or(type_entry, 0))
            lsp_emit_hover_value(req, n, root, value)
          } else {
            let let_pos = lsp_find_let_binding_before(src, src_n, name_ptr, name_n, name_start)
            if let_pos >= 0 {
              let value = buf_new(128)
              bstr(value, "local ")
              bscopy(value, name_ptr, name_n, 0)
              lsp_emit_hover_value(req, n, root, value)
            } else {
              lsp_emit_hover_null(req, n, root)
            }
          }
        }
      }
      }
    }
  }
}

fn lsp_emit_definition_location(req: i64, n: i64, root: i64, st: i64, def_start: i64, def_len: i64) -> i64 {
  let body = buf_new(512)
  lsp_response_start(body, req, n, root)
  bstr(body, "{\"uri\":")
  lsp_buf_append_json_bytes(body, lsp_state_uri_ptr(st), lsp_state_uri_len(st))
  bstr(body, ",\"range\":")
  lsp_buf_append_range(body, lsp_state_src_ptr(st), def_start, def_start + def_len)
  bstr(body, "}}")
  lsp_write_body(body)
}

fn lsp_emit_definition_null(req: i64, n: i64, root: i64) -> i64 {
  let body = buf_new(256)
  lsp_response_start(body, req, n, root)
  bstr(body, "null}")
  lsp_write_body(body)
}

fn lsp_emit_definition(req: i64, n: i64, root: i64, st: i64) -> i64 {
  let uri_pair = lsp_extract_text_document_string(req, n, root, "uri")
  let uri_ptr = mem_load64_at(uri_pair, 0)
  let uri_n = mem_load64_at(uri_pair, 8)
  let src = lsp_state_src_ptr(st)
  let src_n = lsp_state_src_len(st)
  if src == 0 or lsp_state_uri_matches(st, uri_ptr, uri_n) == 0 {
    lsp_emit_definition_null(req, n, root)
  } else {
    let off = lsp_offset_for_line_col(src, src_n, lsp_extract_position_line(req, n, root), lsp_extract_position_character(req, n, root))
    let bounds = lsp_identifier_bounds(src, src_n, off)
    let name_start = mem_load64_at(bounds, 0)
    let name_n = mem_load64_at(bounds, 8)
    if name_n == 0 {
      lsp_emit_definition_null(req, n, root)
    } else {
      let typed = mcp_check_source_quiet(src, src_n)
      let name_ptr = src + name_start
      match mcp_lookup_function_decl(pipeline_typed_fns(typed), name_ptr, name_n) {
        McpFunctionLookup(decl, fn_src) -> {
          if fn_src == src {
            lsp_emit_definition_location(req, n, root, st, decl_name_start_or(decl, 0), decl_name_len_or(decl, 0))
          } else {
            lsp_emit_definition_null(req, n, root)
          }
        }
        MissingMcpFunctionLookup -> {
          let entry = mcp_lookup_type_entry(pipeline_typed_type_entries(typed), name_ptr, name_n, 0 - 1)
          if type_entry_kind_or(entry, 0 - 1) >= 0 {
            if type_entry_source_or(entry, 0) == src {
              lsp_emit_definition_location(req, n, root, st, type_entry_name_start_or(entry, 0), type_entry_name_len_or(entry, 0))
            } else {
              lsp_emit_definition_null(req, n, root)
            }
          } else {
            let let_pos = lsp_find_let_binding_before(src, src_n, name_ptr, name_n, name_start)
            if let_pos >= 0 { lsp_emit_definition_location(req, n, root, st, let_pos, name_n) }
            else { lsp_emit_definition_null(req, n, root) }
          }
        }
      }
    }
    }
  }
}

fn lsp_emit_completion(req: i64, n: i64, root: i64) -> i64 {
  let body = buf_new(512)
  lsp_response_start(body, req, n, root)
  bstr(body, "{\"isIncomplete\":false,\"items\":[{\"label\":\"handle\",\"kind\":14},{\"label\":\"perform\",\"kind\":14},{\"label\":\"par_map\",\"kind\":3}]}}")
  lsp_write_body(body)
}

fn lsp_emit_code_action(req: i64, n: i64, root: i64) -> i64 {
  let body = buf_new(512)
  lsp_response_start(body, req, n, root)
  bstr(body, "[{\"title\":\"Consider par_map for pure map callbacks\",\"kind\":\"refactor.rewrite\"}]}")
  lsp_write_body(body)
}

fn lsp_handle_open(req: i64, n: i64, root: i64, st: i64) -> i64 {
  let uri_pair = lsp_extract_text_document_string(req, n, root, "uri")
  let text_pair = lsp_extract_text_document_string(req, n, root, "text")
  let version = lsp_extract_text_document_version(req, n, root, 1)
  lsp_state_set_doc(st, mem_load64_at(uri_pair, 0), mem_load64_at(uri_pair, 8), mem_load64_at(text_pair, 0), mem_load64_at(text_pair, 8), version)
  lsp_emit_publish_diagnostics(st)
}

fn lsp_handle_change(req: i64, n: i64, root: i64, st: i64) -> i64 {
  let uri_pair = lsp_extract_text_document_string(req, n, root, "uri")
  let uri_ptr = mem_load64_at(uri_pair, 0)
  let uri_n = mem_load64_at(uri_pair, 8)
  if lsp_state_uri_matches(st, uri_ptr, uri_n) == 0 {
    lsp_emit_publish_diagnostics(st)
  } else {
    let version = lsp_extract_text_document_version(req, n, root, lsp_state_version(st) + 1)
    if version < lsp_state_version(st) {
      lsp_emit_publish_diagnostics(st)
    } else {
      let text_pair = lsp_extract_change_text(req, n, root)
      lsp_state_set_doc(st, uri_ptr, uri_n, mem_load64_at(text_pair, 0), mem_load64_at(text_pair, 8), version)
      lsp_emit_publish_diagnostics(st)
    }
  }
}

fn lsp_process_body(req: i64, n: i64, st: i64) -> i64 {
  let root = mcp_json_root_object_start(req, n)
  if root < 0 {
    lsp_emit_error_response(req, n, root, 0 - 32700, "invalid json-rpc")
  } else {
    let jsonrpc = mcp_json_field_value_start(req, n, root, "jsonrpc")
    let method = mcp_json_field_value_start(req, n, root, "method")
    if mcp_json_string_value_eq(req, n, jsonrpc, "2.0") == 0 or method < 0 {
      lsp_emit_error_response(req, n, root, 0 - 32600, "invalid request")
    } else { if mcp_json_string_value_eq(req, n, method, "initialize") == 1 {
      lsp_emit_initialize(req, n, root)
    } else { if mcp_json_string_value_eq(req, n, method, "textDocument/didOpen") == 1 {
      lsp_handle_open(req, n, root, st)
    } else { if mcp_json_string_value_eq(req, n, method, "textDocument/didChange") == 1 {
      lsp_handle_change(req, n, root, st)
    } else { if mcp_json_string_value_eq(req, n, method, "textDocument/hover") == 1 {
      lsp_emit_hover(req, n, root, st)
    } else { if mcp_json_string_value_eq(req, n, method, "textDocument/definition") == 1 {
      lsp_emit_definition(req, n, root, st)
    } else { if mcp_json_string_value_eq(req, n, method, "textDocument/completion") == 1 {
      lsp_emit_completion(req, n, root)
    } else { if mcp_json_string_value_eq(req, n, method, "textDocument/codeAction") == 1 {
      lsp_emit_code_action(req, n, root)
    } else {
      lsp_emit_error_response(req, n, root, 0 - 32601, "unknown method")
    } } } } } } } }
  }
}

fn lsp_match_content_length(src: i64, pos: i64) -> i64 {
  src_eq(src, pos, 15, "Content-Length:")
}

fn lsp_header_end(src: i64, n: i64, pos: i64) -> i64 {
  let mut i = pos
  let mut result = 0 - 1
  while i + 3 < n and result < 0 {
    if mem_load8_at(src, i) == 13 and mem_load8_at(src + i, 1) == 10 and mem_load8_at(src + i, 2) == 13 and mem_load8_at(src + i, 3) == 10 {
      result = i
    } else {
      i = i + 1
    }
  }
  result
}

fn lsp_content_length(src: i64, n: i64, pos: i64, header_end: i64) -> i64 {
  let mut i = pos
  let mut result = 0 - 1
  while i + 15 <= header_end and result < 0 {
    if lsp_match_content_length(src, i) == 1 {
      let mut p = i + 15
      while p < header_end and is_ws(mem_load8_at(src, p)) == 1 { p = p + 1 }
      result = lsp_json_int_at(src, n, p, 0 - 1)
    } else {
      i = i + 1
    }
  }
  result
}

fn run_lsp() -> i64 {
  let input = read_stdin_all()
  let src = mem_load64_at(input, 0)
  let n = mem_load64_at(input, 8)
  let st = lsp_state_new()
  let mut pos = mcp_skip_json_ws(src, n, 0)
  let mut done = 0
  while pos < n and done == 0 {
    if mem_load8_at(src, pos) == 123 {
      let parsed = mcp_json_parse_value(src, n, pos)
      if mcp_json_result_ok(parsed) == 0 {
        lsp_emit_error_response(src + pos, n - pos, 0 - 1, 0 - 32700, "invalid json-rpc")
        done = 1
      } else {
        let end = mcp_json_result_pos(parsed)
        lsp_process_body(src + pos, end - pos, st)
        pos = mcp_skip_json_ws(src, n, end)
      }
    } else {
      let header_end = lsp_header_end(src, n, pos)
      if header_end < 0 {
        lsp_emit_error_response(src + pos, n - pos, 0 - 1, 0 - 32700, "invalid json-rpc")
        done = 1
      } else {
        let len = lsp_content_length(src, n, pos, header_end)
        let body_start = header_end + 4
        if len < 0 or body_start + len > n {
          lsp_emit_error_response(src + pos, n - pos, 0 - 1, 0 - 32700, "invalid json-rpc")
          done = 1
        } else {
          lsp_process_body(src + body_start, len, st)
          pos = mcp_skip_json_ws(src, n, body_start + len)
        }
      }
    }
  }
  0
}

-- ======================================================================
-- Tool: test — compile and run tests with Test effect handler
-- ======================================================================
-- The test runner:
-- 1. Parses source, finds test blocks (tag 50) and regular functions
-- 2. Registers the built-in Test effect assertion helpers
-- 3. Wraps each test body in a function + Test handler
-- 4. Builds a synthetic main that runs all tests, reports results
-- 5. Compiles to stdout (caller runs the binary)

-- Generate harness source that wraps each test body in a function
-- called __test_0, __test_1, etc. Then generates a main that calls
-- each wrapped test and reports results.
fn emit_harness_src(buf: i64, tests: i64, ntests: i64, src: i64) -> i64 {
  -- Emit test wrapper functions: fn __test_N() -> i64 { body }
  -- We can't easily regenerate source from AST, so instead we emit
  -- the test body as-is by copying source bytes for the block.
  -- This requires knowing the source range of each test body.
  --
  -- Simpler approach: compile test bodies directly. Each test block
  -- becomes a function __test_N with the test body. The harness main
  -- calls each one and checks the return value.
  --
  -- Since we can't regenerate source, we take a different approach:
  -- the test bodies stay as AST nodes in the fn list. We just add
  -- a synthesized main that calls them.
  0
}

fn test_assertion_bit_eq() -> i64 { 1 }
fn test_assertion_bit_ne() -> i64 { 2 }
fn test_assertion_bit_true() -> i64 { 4 }
fn test_assertion_bit_false() -> i64 { 8 }
fn test_assertion_bit_lt() -> i64 { 16 }
fn test_assertion_bit_le() -> i64 { 32 }
fn test_assertion_bit_gt() -> i64 { 64 }
fn test_assertion_bit_ge() -> i64 { 128 }
fn test_assertion_bit_str_eq() -> i64 { 256 }
fn test_assertion_bit_str_ne() -> i64 { 512 }
fn test_assertion_bit_snapshot() -> i64 { 1024 }
fn test_assertion_bit_forall_i64_range() -> i64 { 2048 }
fn test_assertion_bit_with_state_i64() -> i64 { 4096 }
fn test_assertion_bit_expect_fail_i64() -> i64 { 8192 }
fn test_assertion_bit_with_io_i64() -> i64 { 16384 }
fn test_assertion_bit_with_diagnose_i64() -> i64 { 32768 }

fn test_mask_has(mask: i64, bit: i64) -> i64 {
  if (mask / bit) % 2 == 1 { 1 } else { 0 }
}

fn test_mask_add(mask: i64, bit: i64) -> i64 {
  if test_mask_has(mask, bit) == 1 { mask } else { mask + bit }
}

fn test_mask_merge(a: i64, b: i64) -> i64 {
  let mut result = a
  let mut bit = 1
  while bit <= 32768 {
    if test_mask_has(b, bit) == 1 {
      result = test_mask_add(result, bit)
    } else { 0 }
    bit = bit * 2
  }
  result
}

fn test_assertion_bit_for_op(src: i64, ns: i64, nl: i64) -> i64 {
  if src_eq(src, ns, nl, "assert_eq") == 1 { test_assertion_bit_eq() }
  else { if src_eq(src, ns, nl, "assert_ne") == 1 { test_assertion_bit_ne() }
  else { if src_eq(src, ns, nl, "assert_true") == 1 { test_assertion_bit_true() }
  else { if src_eq(src, ns, nl, "assert_false") == 1 { test_assertion_bit_false() }
  else { if src_eq(src, ns, nl, "assert_lt") == 1 { test_assertion_bit_lt() }
  else { if src_eq(src, ns, nl, "assert_le") == 1 { test_assertion_bit_le() }
  else { if src_eq(src, ns, nl, "assert_gt") == 1 { test_assertion_bit_gt() }
  else { if src_eq(src, ns, nl, "assert_ge") == 1 { test_assertion_bit_ge() }
  else { if src_eq(src, ns, nl, "assert_str_eq") == 1 { test_assertion_bit_str_eq() }
  else { if src_eq(src, ns, nl, "assert_str_ne") == 1 { test_assertion_bit_str_ne() }
  else { if src_eq(src, ns, nl, "assert_snapshot") == 1 { test_assertion_bit_snapshot() }
  else { if src_eq(src, ns, nl, "forall_i64_range") == 1 { test_assertion_bit_forall_i64_range() }
  else { if src_eq(src, ns, nl, "with_state_i64") == 1 { test_assertion_bit_with_state_i64() }
  else { if src_eq(src, ns, nl, "expect_fail_i64") == 1 { test_assertion_bit_expect_fail_i64() }
  else { if src_eq(src, ns, nl, "with_io_i64") == 1 { test_assertion_bit_with_io_i64() }
  else { if src_eq(src, ns, nl, "with_diagnose_i64") == 1 { test_assertion_bit_with_diagnose_i64() }
  else { 0 } } } } } } } } } } } } } } } }
}

fn test_assertions_mask_expr_list(exprs: ExprList, src: i64) -> i64 {
  match exprs {
    ExprListNil -> 0
    ExprListCons(expr, rest) -> {
      test_mask_merge(test_assertions_mask_expr(expr, src), test_assertions_mask_expr_list(rest, src))
    }
  }
}

fn test_assertions_mask_record_fields(fields: RecordFieldList, src: i64) -> i64 {
  match fields {
    RecordFieldListNil -> 0
    RecordFieldListCons(field, rest) -> {
      let field_mask = match field {
        RecordField(ns, nl, value) -> test_assertions_mask_expr(value, src)
        UnknownRecordField(tag) -> 0
      }
      test_mask_merge(field_mask, test_assertions_mask_record_fields(rest, src))
    }
  }
}

fn test_assertions_mask_match_arms(arms: MatchArmList, src: i64) -> i64 {
  match arms {
    MatchArmListNil -> 0
    MatchArmListCons(arm, rest) -> {
      let arm_mask = match arm {
        Arm(pattern, body, guard, has_guard) -> {
          let guard_mask = if has_guard == 1 { test_assertions_mask_expr(guard, src) } else { 0 }
          test_mask_merge(test_assertions_mask_expr(body, src), guard_mask)
        }
        UnknownArm(tag) -> 0
      }
      test_mask_merge(arm_mask, test_assertions_mask_match_arms(rest, src))
    }
  }
}

fn test_assertions_mask_clauses(clauses: HandlerClauseList, src: i64) -> i64 {
  match clauses {
    HandlerClauseListNil -> 0
    HandlerClauseListCons(clause, rest) -> {
      let clause_mask = match clause {
        HandlerClause(name_info, params, body, continuation) -> test_assertions_mask_expr(body, src)
        UnknownHandlerClause(tag) -> 0
      }
      test_mask_merge(clause_mask, test_assertions_mask_clauses(rest, src))
    }
  }
}

fn test_assertions_mask_expr(expr: Expr, src: i64) -> i64 {
  let self_mask = match expr {
    Perform(lhs, op_ns, op_nl, args) -> {
      match lhs {
        Ident(ns, nl) -> {
          if src_eq(src, ns, nl, "Test") == 1 {
            test_assertion_bit_for_op(src, op_ns, op_nl)
          } else { 0 }
        }
        _ -> 0
      }
    }
    _ -> 0
  }
  let child_mask = match expr {
    IntLit(value, start, len) -> 0
    StringLit(start, len) -> 0
    BoolLit(value) -> 0
    FloatLit(start, len) -> 0
    Ident(ns, nl) -> 0
    BinOp(op, lhs, rhs) -> test_mask_merge(test_assertions_mask_expr(lhs, src), test_assertions_mask_expr(rhs, src))
    Call(ns, nl, args) -> test_assertions_mask_expr_list(args, src)
    GenericCall(type_args, inner_call) -> test_assertions_mask_expr(inner_call, src)
    If(cond, then_expr, else_expr) -> {
      test_mask_merge(test_assertions_mask_expr(cond, src), test_mask_merge(test_assertions_mask_expr(then_expr, src), test_assertions_mask_expr(else_expr, src)))
    }
    While(cond, body) -> test_mask_merge(test_assertions_mask_expr(cond, src), test_assertions_mask_expr(body, src))
    Loop(body) -> test_assertions_mask_expr(body, src)
    Break(value) -> test_assertions_mask_expr(value, src)
    BreakNoValue -> 0
    Continue -> 0
    Return(value) -> test_assertions_mask_expr(value, src)
    ReturnNoValue -> 0
    Defer(cleanup, body) -> test_mask_merge(test_assertions_mask_expr(cleanup, src), test_assertions_mask_expr(body, src))
    Let(ns, nl, value, body) -> test_mask_merge(test_assertions_mask_expr(value, src), test_assertions_mask_expr(body, src))
    LetMut(ns, nl, value, body) -> test_mask_merge(test_assertions_mask_expr(value, src), test_assertions_mask_expr(body, src))
    Assign(ns, nl, value) -> test_assertions_mask_expr(value, src)
    AddressOf(mutable, target) -> test_assertions_mask_expr(target, src)
    Deref(ptr) -> test_assertions_mask_expr(ptr, src)
    PtrAssign(ptr, value) -> test_mask_merge(test_assertions_mask_expr(ptr, src), test_assertions_mask_expr(value, src))
    Block(first, rest) -> test_mask_merge(test_assertions_mask_expr(first, src), test_assertions_mask_expr(rest, src))
    FieldAccess(base, field_ns, field_nl) -> test_assertions_mask_expr(base, src)
    RecordInit(type_ns, type_nl, fields) -> test_assertions_mask_record_fields(fields, src)
    Match(scrutinee, arms) -> test_mask_merge(test_assertions_mask_expr(scrutinee, src), test_assertions_mask_match_arms(arms, src))
    Not(operand) -> test_assertions_mask_expr(operand, src)
    Lambda(params, body) -> test_assertions_mask_expr(body, src)
    Perform(lhs, op_ns, op_nl, args) -> test_mask_merge(test_assertions_mask_expr(lhs, src), test_assertions_mask_expr_list(args, src))
    Handle(body, clauses) -> test_mask_merge(test_assertions_mask_expr(body, src), test_assertions_mask_clauses(clauses, src))
    Resume(value) -> test_assertions_mask_expr(value, src)
    MethodCall(recv, method_hash, args, type_hash) -> test_mask_merge(test_assertions_mask_expr(recv, src), test_assertions_mask_expr_list(args, src))
    Try(inner) -> test_assertions_mask_expr(inner, src)
    InterpConcat(left, right) -> test_mask_merge(test_assertions_mask_expr(left, src), test_assertions_mask_expr(right, src))
    ForIter(var_ns, var_nl, collection, body) -> test_mask_merge(test_assertions_mask_expr(collection, src), test_assertions_mask_expr(body, src))
    OptChain(base, field_ns, field_nl) -> test_assertions_mask_expr(base, src)
    LetTyped(inner, ann_type) -> test_assertions_mask_expr(inner, src)
    NilExpr -> 0
    UnknownExpr(tag) -> 0
  }
  test_mask_merge(self_mask, child_mask)
}

fn test_assertions_mask_decl_entry(entry: TestHarnessDeclEntry, root_src: i64, require_root: i64) -> i64 {
  match entry {
    TestHarnessDeclEntry(decl, decl_src) -> {
      if require_root == 1 and decl_src != root_src {
        0
      } else {
        test_assertions_mask_expr(decl_body_expr(decl), decl_src)
      }
    }
    UnknownTestHarnessDeclEntry -> 0
  }
}

fn test_assertions_mask_decl_entries(entries: TestHarnessDeclList, root_src: i64, require_root: i64) -> i64 {
  match entries {
    TestHarnessDeclListNil -> 0
    TestHarnessDeclListCons(entry, rest) -> {
      test_mask_merge(test_assertions_mask_decl_entry(entry, root_src, require_root), test_assertions_mask_decl_entries(rest, root_src, require_root))
    }
  }
}

fn test_append_handler_clauses(buf: i64, mask: i64) -> i64 {
  if test_mask_has(mask, test_assertion_bit_eq()) == 1 {
    buf_append_str(buf, " Test.assert_eq(g, e) -> { if g != e { test_fail_assertion_i2(\"assert_eq\", g, e) __mem_store64(st, 0) } else { 0 } resume(0) }")
  } else { 0 }
  if test_mask_has(mask, test_assertion_bit_ne()) == 1 {
    buf_append_str(buf, " Test.assert_ne(g, u) -> { if g == u { test_fail_assertion_i2(\"assert_ne\", g, u) __mem_store64(st, 0) } else { 0 } resume(0) }")
  } else { 0 }
  if test_mask_has(mask, test_assertion_bit_true()) == 1 {
    buf_append_str(buf, " Test.assert_true(v) -> { if v { 0 } else { test_fail_assertion(\"assert_true\") __mem_store64(st, 0) } resume(0) }")
  } else { 0 }
  if test_mask_has(mask, test_assertion_bit_false()) == 1 {
    buf_append_str(buf, " Test.assert_false(v) -> { if v { test_fail_assertion(\"assert_false\") __mem_store64(st, 0) } else { 0 } resume(0) }")
  } else { 0 }
  if test_mask_has(mask, test_assertion_bit_lt()) == 1 {
    buf_append_str(buf, " Test.assert_lt(l, r) -> { if l < r { 0 } else { test_fail_assertion_i2(\"assert_lt\", l, r) __mem_store64(st, 0) } resume(0) }")
  } else { 0 }
  if test_mask_has(mask, test_assertion_bit_le()) == 1 {
    buf_append_str(buf, " Test.assert_le(l, r) -> { if l <= r { 0 } else { test_fail_assertion_i2(\"assert_le\", l, r) __mem_store64(st, 0) } resume(0) }")
  } else { 0 }
  if test_mask_has(mask, test_assertion_bit_gt()) == 1 {
    buf_append_str(buf, " Test.assert_gt(l, r) -> { if l > r { 0 } else { test_fail_assertion_i2(\"assert_gt\", l, r) __mem_store64(st, 0) } resume(0) }")
  } else { 0 }
  if test_mask_has(mask, test_assertion_bit_ge()) == 1 {
    buf_append_str(buf, " Test.assert_ge(l, r) -> { if l >= r { 0 } else { test_fail_assertion_i2(\"assert_ge\", l, r) __mem_store64(st, 0) } resume(0) }")
  } else { 0 }
  if test_mask_has(mask, test_assertion_bit_str_eq()) == 1 {
    buf_append_str(buf, " Test.assert_str_eq(g, e) -> { if str_eq(g, e) == 0 { test_fail_assertion(\"assert_str_eq\") __mem_store64(st, 0) } else { 0 } resume(0) }")
  } else { 0 }
  if test_mask_has(mask, test_assertion_bit_str_ne()) == 1 {
    buf_append_str(buf, " Test.assert_str_ne(g, u) -> { if str_eq(g, u) == 1 { test_fail_assertion(\"assert_str_ne\") __mem_store64(st, 0) } else { 0 } resume(0) }")
  } else { 0 }
  if test_mask_has(mask, test_assertion_bit_snapshot()) == 1 {
    buf_append_str(buf, " Test.assert_snapshot(g, e) -> { if str_eq(g, e) == 0 { test_fail_assertion(\"snapshot\") __mem_store64(st, 0) } else { 0 } resume(0) }")
  } else { 0 }
  if test_mask_has(mask, test_assertion_bit_forall_i64_range()) == 1 {
    buf_append_str(buf, " Test.forall_i64_range(s, e, prop) -> { let mut i = s let mut seen = 0 let mut failed = 0 while i < e { seen = 1 if prop(i) { 0 } else { failed = 1 i = e } i = i + 1 } if seen == 0 { test_fail_assertion(\"forall_i64_range_empty\") __mem_store64(st, 0) } else { if failed == 1 { test_fail_assertion(\"forall_i64_range\") __mem_store64(st, 0) } else { 0 } } resume(0) }")
  } else { 0 }
  if test_mask_has(mask, test_assertion_bit_with_state_i64()) == 1 {
    buf_append_str(buf, " Test.with_state_i64(init, body) -> { let cell = __bump_alloc(8) __mem_store64(cell, init) let result = handle body() { State.get() -> resume(__mem_load64(cell)) State.put(v) -> { __mem_store64(cell, v) resume(0) } } resume(result) }")
  } else { 0 }
  if test_mask_has(mask, test_assertion_bit_expect_fail_i64()) == 1 {
    buf_append_str(buf, " Test.expect_fail_i64(expected, body) -> { let seen = __bump_alloc(16) __mem_store64(seen, 0) __mem_store64(seen + 8, 0) let result = handle body() { Fail.fail(e) -> { __mem_store64(seen, 1) __mem_store64(seen + 8, e) resume(e) } } if __mem_load64(seen) == 0 { test_fail_assertion(\"expect_fail_missing\") __mem_store64(st, 0) } else { if __mem_load64(seen + 8) != expected { test_fail_assertion(\"expect_fail_i64\") __mem_store64(st, 0) } else { 0 } } resume(if __mem_load64(seen) == 1 { __mem_load64(seen + 8) } else { result }) }")
  } else { 0 }
  if test_mask_has(mask, test_assertion_bit_with_io_i64()) == 1 {
    buf_append_str(buf, " Test.with_io_i64(body) -> { let result = handle body() { IO.read(fd, out, len) -> { if len > 0 { __mem_store8(out, 65) } else { 0 } resume(if len > 0 { 1 } else { 0 }) } IO.write(fd, data, len) -> resume(len) IO.open(path, flags, mode) -> resume(100 + flags) IO.close(fd) -> resume(0) } resume(result) }")
  } else { 0 }
  if test_mask_has(mask, test_assertion_bit_with_diagnose_i64()) == 1 {
    buf_append_str(buf, " Test.with_diagnose_i64(body) -> { let result = handle body() { Diagnose.error(msg, span) -> resume(1) Diagnose.warn(msg, span) -> resume(2) Diagnose.note(msg, span) -> resume(3) } resume(result) }")
  } else { 0 }
  buf_len(buf)
}

fn test_harness_chunk_size() -> i64 { 10 }

fn test_append_harness_chunk_name(buf: i64, chunk: i64) -> i64 {
  buf_append_str(buf, "run_chunk_")
  lsp_buf_append_i(buf, chunk)
  buf_len(buf)
}

fn test_append_harness_chunk_handled_name(buf: i64, chunk: i64) -> i64 {
  test_append_harness_chunk_name(buf, chunk)
  buf_append_str(buf, "_handled")
  buf_len(buf)
}

fn test_append_harness_test_wrapper_name(buf: i64, index: i64) -> i64 {
  buf_append_str(buf, "t_")
  lsp_buf_append_i(buf, index)
  buf_len(buf)
}

fn test_append_harness_test_call_entry(buf: i64, entry: TestHarnessDeclEntry, index: i64) -> i64 {
  match entry {
    TestHarnessDeclEntry(decl, test_src) -> {
      match decl {
        TestDecl(name_ns, name_nl, body) -> {
          -- Reset assertion state, call the stable generated test wrapper, then
          -- reclaim per-test compiler/runtime temporaries. Large compiler-as-data
          -- metric files build many AST/IR/native modules in one process; without
          -- this isolation the bump allocator grows for the whole file.
          buf_append_str(buf, "let m_")
          lsp_buf_append_i(buf, index)
          buf_append_str(buf, " = alloc_bump_mark() ")
          buf_append_str(buf, "__mem_store64(st, 1) ")
          test_append_harness_test_wrapper_name(buf, index)
          buf_append_str(buf, "() if __mem_load64(st) == 1 { p = p + 1 } else { f = f + 1 } ")
          buf_append_str(buf, "let h_")
          lsp_buf_append_i(buf, index)
          buf_append_str(buf, " = rc_default_heap_existing() if h_")
          lsp_buf_append_i(buf, index)
          buf_append_str(buf, " != 0 { heap_destroy(h_")
          lsp_buf_append_i(buf, index)
          buf_append_str(buf, ") __mem_store64(rc_default_heap_cell(), 0) } else { 0 } alloc_bump_restore_same_segment(m_")
          lsp_buf_append_i(buf, index)
          buf_append_str(buf, ") ")
        }
        _ -> 0
      }
    }
    UnknownTestHarnessDeclEntry -> 0
  }
  buf_len(buf)
}

fn test_append_harness_test_calls_range(buf: i64, tests: TestHarnessDeclList, index: i64, start: i64, end: i64) -> i64 {
  match tests {
    TestHarnessDeclListNil -> buf_len(buf)
    TestHarnessDeclListCons(entry, rest) -> {
      if index >= start and index < end {
        test_append_harness_test_call_entry(buf, entry, index)
      } else { 0 }
      if index + 1 < end {
        test_append_harness_test_calls_range(buf, rest, index + 1, start, end)
      } else {
        buf_len(buf)
      }
    }
  }
}

-- Trusted test sources give wrappers [Test, Unsafe] (linked tests perform
-- __got_* raw calls); the generated chain must declare the same effects or
-- the callee-subset check rejects the wrapper calls.
fn test_append_harness_chunk_fn(buf: i64, tests: TestHarnessDeclList, start: i64, end: i64, chunk: i64, trusted: i64) -> i64 {
  buf_append_str(buf, "fn ")
  test_append_harness_chunk_name(buf, chunk)
  if trusted == 1 {
    buf_append_str(buf, "(st: i64) -[Test, Unsafe]> i64 { let mut p = 0 let mut f = 0 ")
  } else {
    buf_append_str(buf, "(st: i64) -[Test]> i64 { let mut p = 0 let mut f = 0 ")
  }
  test_append_harness_test_calls_range(buf, tests, 0, start, end)
  buf_append_str(buf, "f } ")
  buf_len(buf)
}

fn test_append_harness_chunk_handler(buf: i64, chunk: i64, mask: i64, trusted: i64) -> i64 {
  buf_append_str(buf, "fn ")
  test_append_harness_chunk_handled_name(buf, chunk)
  if trusted == 1 {
    buf_append_str(buf, "() -[Unsafe]> i64 { let st = __bump_alloc(8) handle ")
  } else {
    buf_append_str(buf, "() -> i64 { let st = __bump_alloc(8) handle ")
  }
  test_append_harness_chunk_name(buf, chunk)
  buf_append_str(buf, "(st) {")
  test_append_handler_clauses(buf, mask)
  buf_append_str(buf, " } } ")
  buf_len(buf)
}

fn test_append_harness_run_all(buf: i64, chunks: i64, trusted: i64) -> i64 {
  if trusted == 1 {
    buf_append_str(buf, "fn run_all() -[Unsafe]> i64 { let mut f = 0 ")
  } else {
    buf_append_str(buf, "fn run_all() -> i64 { let mut f = 0 ")
  }
  let mut chunk = 0
  while chunk < chunks {
    buf_append_str(buf, "f = f + ")
    test_append_harness_chunk_handled_name(buf, chunk)
    buf_append_str(buf, "() ")
    chunk = chunk + 1
  }
  buf_append_str(buf, "f } ")
  buf_len(buf)
}

fn test_append_harness_run_all_direct(buf: i64, tests: TestHarnessDeclList, ntests: i64) -> i64 {
  buf_append_str(buf, "fn run_all(st: i64) -[Test]> i64 { let mut p = 0 let mut f = 0 ")
  test_append_harness_test_calls_range(buf, tests, 0, 0, ntests)
  buf_append_str(buf, "f } ")
  buf_len(buf)
}

fn test_wrapper_name_digit_count(index: i64) -> i64 {
  if index < 10 { 1 } else { 1 + test_wrapper_name_digit_count(index / 10) }
}

fn test_wrapper_name_len(index: i64) -> i64 {
  2 + test_wrapper_name_digit_count(index)
}

fn test_wrapper_name_offset_from_bank(name_bank_start: i64, index: i64) -> i64 {
  let mut offset = name_bank_start + 4
  let mut i = 0
  while i < index {
    offset = offset + test_wrapper_name_len(i) + 1
    i = i + 1
  }
  offset
}

fn test_add_wrapper_for_entry(regular: i64, entry: TestHarnessDeclEntry, test_effects: i64, index: i64, name_bank_start: i64) -> i64 {
  match entry {
    TestHarnessDeclEntry(decl, test_src) -> {
      match decl {
        TestDecl(name_ns, name_nl, typed_body) -> {
          -- Transitional Slice H adapter: wrapper synthesis still emits a raw
          -- function pair, but its body is rebuilt from the typed test decl.
          -- The identifier bytes live in the trailing generated-name comment
          -- of the same source buffer as the typed test body, so every raw node
          -- field remains a real source offset rather than an external pointer.
          let name_ns = test_wrapper_name_offset_from_bank(name_bank_start, index)
          let name_len = test_wrapper_name_len(index)
          let fn_inner = node_new(8, name_ns, name_len, nlist_new(), expr_to_node(typed_body))
          let fn_wrap = node_new(23, fn_inner, 0, test_effects, 0)
          let fn_pair = node_new(0, fn_wrap, test_src, 0, 0)
          nlist_add(regular, fn_pair)
        }
        _ -> 0
      }
    }
    UnknownTestHarnessDeclEntry -> 0
  }
}

fn test_add_wrappers_for_entries_at(regular: i64, entries: TestHarnessDeclList, test_effects: i64, index: i64, name_bank_start: i64) -> i64 {
  match entries {
    TestHarnessDeclListNil -> 0
    TestHarnessDeclListCons(entry, rest) -> {
      test_add_wrapper_for_entry(regular, entry, test_effects, index, name_bank_start)
      test_add_wrappers_for_entries_at(regular, rest, test_effects, index + 1, name_bank_start)
    }
  }
}

fn test_add_wrappers_for_entries(regular: i64, entries: TestHarnessDeclList, test_effects: i64, name_bank_start: i64) -> i64 {
  test_add_wrappers_for_entries_at(regular, entries, test_effects, 0, name_bank_start)
}

fn test_effects_for_source(trusted: i64) -> i64 {
  let test_effects = effect_sig_one(effect_name_hash(__str_ptr("Test"), 0, 4))
  if trusted == 1 {
    effect_add(test_effects, effect_hash_unsafe())
  } else { test_effects }
}

fn run_test_source(raw: i64, raw_n: i64, trusted: i64, strict: i64) -> i64 {
  -- Prepend the Test effect to the user source so Test operations are in the
  -- SAME source buffer as the tests that call them.
  let prefix = "effect State { fn get() -> i64 fn put(v: i64) -> i64 } effect Fail { fn fail(error: i64) -> i64 } effect IO { fn read(fd: i64, buf: i64, len: i64) -> i64 fn write(fd: i64, buf: i64, len: i64) -> i64 fn open(path: str, flags: i64, mode: i64) -> i64 fn close(fd: i64) -> i64 } effect Diagnose { fn error(msg: str, span: i64) -> i64 fn warn(msg: str, span: i64) -> i64 fn note(msg: str, span: i64) -> i64 } effect Test { fn assert_eq(got: i64, expected: i64) -> i64 fn assert_ne(got: i64, unexpected: i64) -> i64 fn assert_true(value: bool) -> i64 fn assert_false(value: bool) -> i64 fn assert_lt(left: i64, right: i64) -> i64 fn assert_le(left: i64, right: i64) -> i64 fn assert_gt(left: i64, right: i64) -> i64 fn assert_ge(left: i64, right: i64) -> i64 fn assert_str_eq(got: str, expected: str) -> i64 fn assert_str_ne(got: str, unexpected: str) -> i64 fn assert_snapshot(got: str, expected: str) -> i64 fn forall_i64_range(start: i64, end: i64, property: (i64) -> bool) -> i64 fn with_state_i64(initial: i64, body: () -[State]> i64) -> i64 fn expect_fail_i64(expected: i64, body: () -[Fail]> i64) -> i64 fn with_io_i64(body: () -[IO]> i64) -> i64 fn with_diagnose_i64(body: () -[Diagnose]> i64) -> i64 } "
  let prefix_len = __str_len(prefix)
  let src = main_alloc_bytes(prefix_len + raw_n + 1)
  mem_copy(src, __str_ptr(prefix), prefix_len)
  mem_copy(src + prefix_len, raw, raw_n)
  let n = prefix_len + raw_n
  let grammar = weft_grammar()
  let tt = ttable_new()
  pipeline_mark_root_origin(tt, src, trusted, strict)
  let fns = pipeline_parse(grammar, src, n, tt)
  -- Separate tests from regular functions
  let regular = nlist_new()
  let mut test_entries_rev = test_harness_decl_list_empty()
  let mut regular_entries_rev = test_harness_decl_list_empty()
  let nfns = nlist_len(fns)
  for i in 0..nfns {
    let pair = nlist_get(fns, i)
    let entry = test_harness_decl_entry_from_pair(pair)
    if test_harness_decl_entry_is_test(entry) == 1 {
      test_entries_rev = test_harness_decl_list_prepend(entry, test_entries_rev)
    } else {
      nlist_add(regular, pair)
      regular_entries_rev = test_harness_decl_list_prepend(entry, regular_entries_rev)
    }
  }
  let tests = test_harness_decl_list_reverse(test_entries_rev)
  let regular_entries = test_harness_decl_list_reverse(regular_entries_rev)
  let ntests = test_harness_decl_list_len(tests)
  if ntests == 0 {
    eprint("test: no test blocks found\n")
    0
  } else {
    let banked = test_source_with_prefix_and_wrappers(raw, raw_n, ntests)
    let src = node_f1(banked)
    let n = node_f2(banked)
    let name_bank_start = test_source_wrapper_bank_start(banked)
    let tt = ttable_new()
    pipeline_mark_root_origin(tt, src, trusted, strict)
    let fns = pipeline_parse(grammar, src, n, tt)
    let regular = nlist_new()
    let mut test_entries_rev = test_harness_decl_list_empty()
    let mut regular_entries_rev = test_harness_decl_list_empty()
    let nfns = nlist_len(fns)
    for i in 0..nfns {
      let pair = nlist_get(fns, i)
      let entry = test_harness_decl_entry_from_pair(pair)
      if test_harness_decl_entry_is_test(entry) == 1 {
        test_entries_rev = test_harness_decl_list_prepend(entry, test_entries_rev)
      } else {
        nlist_add(regular, pair)
        regular_entries_rev = test_harness_decl_list_prepend(entry, regular_entries_rev)
      }
    }
    let tests = test_harness_decl_list_reverse(test_entries_rev)
    let regular_entries = test_harness_decl_list_reverse(regular_entries_rev)
    let ntests = test_harness_decl_list_len(tests)
    -- Convert each test block into a wrapper function with t_ prefix
    -- to avoid keyword collisions (e.g., test "while" -> fn t_while)
    let test_effects = test_effects_for_source(trusted)
    test_add_wrappers_for_entries(regular, tests, test_effects, name_bank_start)
    -- Check the user/test wrapper module before generating the raw-memory
    -- assertion harness. This keeps ordinary type errors and sealed-Unsafe
    -- failures from flowing into harness parsing/lowering.
    pipeline_bind_runtime_preludes(regular, src, tt)
    let user_errors = pipeline_check_fns_error_count(regular, src, tt)
    if user_errors != 0 {
      eprint("test: type check failed with ")
      eprint_i(user_errors)
      eprint(" errors\n")
      1
    } else {
    -- Build harness: chunk large test files so no generated function becomes
    -- huge. Each chunk owns its assertion state cell and handler, so nested
    -- compiler invocations in one chunk cannot clobber the caller-held state
    -- used by a later chunk.
    let assertion_mask = test_mask_merge(test_assertions_mask_decl_entries(tests, src, 0), test_assertions_mask_decl_entries(regular_entries, src, 1))
    let harness_buf = buf_new(65536)
    let mut hp = 0
    -- Test effect already declared in prepended user source
    hp = buf_append_str(harness_buf, "use \"runtime/syscall.weft\" use \"runtime/alloc.weft\" use \"runtime/rc.weft\" use \"stdlib/string.weft\" fn test_fail_assertion(name: str) -> i64 { sys_write(2, __str_ptr(\"test assertion failed: \"), __str_len(\"test assertion failed: \")) sys_write(2, __str_ptr(name), __str_len(name)) sys_write(2, __str_ptr(\"\\n\"), 1) 0 } fn test_fail_assertion_i2(name: str, got: i64, expected: i64) -> i64 { sys_write(2, __str_ptr(\"test assertion failed: \"), __str_len(\"test assertion failed: \")) sys_write(2, __str_ptr(name), __str_len(name)) sys_write(2, __str_ptr(\" got=\"), __str_len(\" got=\")) let g = int_to_str(got) sys_write(2, __str_ptr(g), __str_len(g)) sys_write(2, __str_ptr(\" want=\"), __str_len(\" want=\")) let e = int_to_str(expected) sys_write(2, __str_ptr(e), __str_len(e)) sys_write(2, __str_ptr(\"\\n\"), 1) 0 } ")
    let chunk_size = test_harness_chunk_size()
    let chunks = (ntests + chunk_size - 1) / chunk_size
    let mut chunk = 0
    while chunk < chunks {
      let start = chunk * chunk_size
      let raw_end = start + chunk_size
      let end = if raw_end > ntests { ntests } else { raw_end }
      hp = test_append_harness_chunk_fn(harness_buf, tests, start, end, chunk, trusted)
      hp = test_append_harness_chunk_handler(harness_buf, chunk, assertion_mask, trusted)
      chunk = chunk + 1
    }
    hp = test_append_harness_run_all(harness_buf, chunks, trusted)
    if trusted == 1 {
      hp = buf_append_str(harness_buf, "fn main() -[Unsafe]> i64 { run_all() }")
    } else {
      hp = buf_append_str(harness_buf, "fn main() -> i64 { run_all() }")
    }
    let harness_src = buf_ptr(harness_buf)
    -- The harness is compiler-generated trusted code. It uses raw memory for
    -- assertion state cells while ordinary imported user code must not.
    ttable_mark_trusted_source(tt, harness_src)
    -- Parse the harness source through the same parse pass boundary
    let harness_fns = pipeline_parse(grammar, harness_src, hp, tt)
    -- Merge harness main into regular fns
    let hn = nlist_len(harness_fns)
    for hi in 0..hn {
      nlist_add(regular, nlist_get(harness_fns, hi))
    }
    -- Type-check is a hard boundary before typed-IR/native emission. Continuing
    -- after diagnostics leaves poisoned AST/typed state for lowering, which can
    -- turn an ordinary positive-test failure into a codegen crash.
    let errors = pipeline_check_fns_error_count(regular, src, tt)
    if errors != 0 {
      eprint("test: type check failed with ")
      eprint_i(errors)
      eprint(" errors\n")
      1
    } else {
      -- The gate above already checked the expanded module; wrapping the
      -- triple directly avoids a third full check of user + harness fns.
      let typed = TypedModule(regular, src, tt)
      let binary = pipeline_emit_native(typed)
      main_write_binary(binary)
    }
    }
  }
}

fn run_test_path(path: i64) -> i64 {
  let len = cstr_len(path)
  let file = read_cpath_file(path, len)
  let raw = mem_load64_at(file, 0)
  let raw_n = mem_load64_at(file, 8)
  if raw_n <= 0 {
    eprint("test: could not read input file\n")
    1
  } else {
    run_test_source(raw, raw_n, cpath_is_trusted_source(path, len), cpath_is_strict_source(path, len))
  }
}

fn run_test() -> i64 {
  let raw_input = read_stdin_all()
  run_test_source(mem_load64_at(raw_input, 0), mem_load64_at(raw_input, 8), 0, 1)
}

-- Copy a string literal to a buffer, return new position
fn buf_append_str(b: i64, s: str) -> i64 {
  bstr(b, s)
  buf_len(b)
}

fn buf_append_bytes(b: i64, p: i64, n: i64) -> i64 {
  bscopy(b, p, n, 0)
  buf_len(b)
}

-- File discovery mode (weft test test/*.weft) is in run_tests.sh.
-- The compiler can't call posix_spawn directly (it's a static binary).
-- User programs that need process spawning emit .o files and link via ld.

-- Unused: kept for stdlib/process.weft compatibility
fn make_cstr(s: str) -> i64 {
  let p = __str_ptr(s)
  let l = __str_len(s)
  let buf = main_alloc_bytes(l + 1)
  mem_copy(buf, p, l)
  mem_store8_at(buf, l, 0)
  buf
}

fn cstr_copy_to(dst: i64, pos: i64, src: i64) -> i64 {
  let mut i = 0
  while mem_load8_at(src, i) != 0 {
    mem_store8_at(dst + pos, i, mem_load8_at(src, i))
    i = i + 1
  }
  pos + i
}

-- File discovery (weft test test/*.weft) is handled by run_tests.sh.
-- User programs that need posix_spawn use the .o + ld pipeline.
