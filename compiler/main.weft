fn main_diag_items_count(count: i64) -> i64 {
  mem_load64_at(count, 0)
}

fn main_diag_items_begin(items: i64, count: i64) -> i64 {
  let current = main_diag_items_count(count)
  if current > 0 { bstr(items, ",") } else { 0 }
  mem_store64_at(count, 0, current + 1)
  current
}

fn main_diag_items_append_array(b: i64, items: i64) -> i64 {
  bstr(b, "[")
  bscopy(b, buf_ptr(items), buf_len(items), 0)
  bstr(b, "]")
  buf_len(b)
}

fn mcp_span_line(src: i64, span: i64) -> i64 {
  if span < 0 { 0 - 1 }
  else {
    let mut i = 0
    let mut line = 1
    while i < span {
      if mem_load8_at(src, i) == 10 { line = line + 1 } else { 0 }
      i = i + 1
    }
    line
  }
}

fn mcp_span_col(src: i64, span: i64) -> i64 {
  if span < 0 { 0 - 1 }
  else {
    let mut i = 0
    let mut col = 1
    while i < span {
      if mem_load8_at(src, i) == 10 { col = 1 } else { col = col + 1 }
      i = i + 1
    }
    col
  }
}

fn mcp_span_scalar_col(src: i64, n: i64, span: i64) -> i64 {
  if span < 0 { 0 - 1 }
  else {
    let col = source_position_scalar_column0(source_position_at(src, n, span))
    if col < 0 { 0 - 1 } else { col + 1 }
  }
}

fn mcp_span_utf16_col(src: i64, n: i64, span: i64) -> i64 {
  if span < 0 { 0 - 1 }
  else {
    let col = source_position_utf16_column0(source_position_at(src, n, span))
    if col < 0 { 0 - 1 } else { col + 1 }
  }
}

fn mcp_emit_position_units(b: i64) -> i64 {
  mcp_write(b, ",\"position_units\":{\"span\":\"utf-8-byte-offset\",\"line_base\":1,\"col\":\"utf-8-byte-column\",\"scalar_col\":\"unicode-scalar-column\",\"utf16_col\":\"utf-16-code-unit-column\"}")
}

fn mcp_write_diag_severity(b: i64, severity: i64) -> i64 {
  match severity {
    1 -> mcp_write(b, "\"error\"")
    2 -> mcp_write(b, "\"warn\"")
    3 -> mcp_write(b, "\"note\"")
    _ -> mcp_write(b, "\"unknown\"")
  }
}

fn mcp_emit_diag_item_prefix(b: i64, src: i64, n: i64, severity: i64, msg: str, absolute_span: i64, absolute_end: i64, code: str) -> i64 {
  -- Diagnostic spans are absolute addresses; reduce to a root-relative
  -- offset (or -1) so the line/col walk stays inside the buffer.
  let span = diagnose_normalize_span(src, absolute_span)
  let end_span = diagnose_normalize_span(src, absolute_end)
  mcp_write(b, "{\"severity\":")
  mcp_write_diag_severity(b, severity)
  mcp_write(b, ",\"message\":")
  mcp_write_json_str(b, msg)
  if __str_len(code) > 0 {
    mcp_write(b, ",\"code\":")
    mcp_write_json_str(b, code)
  } else { 0 }
  mcp_write(b, ",\"span\":")
  mcp_write_i(b, span)
  mcp_write(b, ",\"line\":")
  mcp_write_i(b, mcp_span_line(src, span))
  mcp_write(b, ",\"col\":")
  mcp_write_i(b, mcp_span_col(src, span))
  mcp_write(b, ",\"scalar_col\":")
  mcp_write_i(b, mcp_span_scalar_col(src, n, span))
  mcp_write(b, ",\"utf16_col\":")
  mcp_write_i(b, mcp_span_utf16_col(src, n, span))
  if end_span > span {
    mcp_write(b, ",\"end_span\":")
    mcp_write_i(b, end_span)
    mcp_write(b, ",\"end_line\":")
    mcp_write_i(b, mcp_span_line(src, end_span))
    mcp_write(b, ",\"end_col\":")
    mcp_write_i(b, mcp_span_col(src, end_span))
    mcp_write(b, ",\"end_scalar_col\":")
    mcp_write_i(b, mcp_span_scalar_col(src, n, end_span))
    mcp_write(b, ",\"end_utf16_col\":")
    mcp_write_i(b, mcp_span_utf16_col(src, n, end_span))
  } else { 0 }
  0
}

fn mcp_diag_items_append_report(items: i64, count: i64, src: i64, n: i64, tt: i64, diagnostic: Diagnostic) -> i64 {
  main_diag_items_begin(items, count)
  mcp_emit_diag_item_prefix(
    items,
    src,
    n,
    diagnose_report_severity_tag(diagnostic),
    diagnose_report_message(diagnostic),
    diagnose_report_absolute_span(diagnostic),
    diagnose_report_absolute_end(diagnostic),
    diagnose_report_code(diagnostic)
  )
  mcp_write(items, ",\"diagnostic\":")
  mcp_emit_diagnostic_value(items, src, n, tt, diagnostic)
  mcp_write(items, "}")
}

fn mcp_diag_items_append_legacy_with_code(items: i64, count: i64, src: i64, n: i64, severity: i64, msg: str, span: i64, end_span: i64, code: str) -> i64 {
  main_diag_items_begin(items, count)
  mcp_emit_diag_item_prefix(items, src, n, severity, msg, span, end_span, code)
  mcp_write(items, "}")
}

fn mcp_diag_items_append_legacy(items: i64, count: i64, src: i64, n: i64, severity: i64, msg: str, span: i64) -> i64 {
  mcp_diag_items_append_legacy_with_code(items, count, src, n, severity, msg, span, span, "")
}

-- LSP and MCP deliberately share this one adapter over the parse-only
-- formatter. The Diagnose handler is the typed transport boundary: it projects
-- each value directly into the requested wire buffer while the value is live,
-- avoiding a recursive generic carrier in the compiler's own source graph.
fn main_format_transport(src: i64, n: i64, items: i64, count: i64, st: i64, encoding: i64, lsp_mode: bool) -> FormatterResult {
  let tt = ttable_new()
  pipeline_mark_root_origin(tt, src, 0, 1)
  handle formatter_format_source(src, n, tt) {
    Diagnose.report(diagnostic) -> {
      if lsp_mode { lsp_diag_items_append_report(items, count, st, tt, src, n, diagnostic, encoding) }
      else { mcp_diag_items_append_report(items, count, src, n, tt, diagnostic) }
      resume(0)
    }
    Diagnose.error(msg, span) -> {
      if lsp_mode { lsp_diag_items_append_legacy(items, count, st, tt, src, n, 1, msg, span, encoding) }
      else { mcp_diag_items_append_legacy(items, count, src, n, 1, msg, span) }
      resume(0)
    }
    Diagnose.warn(msg, span) -> {
      if lsp_mode { lsp_diag_items_append_legacy(items, count, st, tt, src, n, 2, msg, span, encoding) }
      else { mcp_diag_items_append_legacy(items, count, src, n, 2, msg, span) }
      resume(0)
    }
    Diagnose.note(msg, span) -> {
      if lsp_mode { lsp_diag_items_append_legacy(items, count, st, tt, src, n, 3, msg, span, encoding) }
      else { mcp_diag_items_append_legacy(items, count, src, n, 3, msg, span) }
      resume(0)
    }
  }
}

fn mcp_emit_format_source(b: i64, src: i64, n: i64) -> i64 {
  let items = buf_new(4096)
  let count = main_alloc_bytes(8)
  mem_store64_at(count, 0, 0)
  match main_format_transport(src, n, items, count, 0, 0, false) {
    FormatterSuccess(formatted) -> {
      mcp_begin_result(b, "format_source")
      mcp_write(b, ",\"formatted\":")
      mcp_write_json_bytes(b, __str_ptr(formatted), __str_len(formatted))
      mcp_write(b, ",\"diagnostics\":")
      mcp_write_i(b, main_diag_items_count(count))
      mcp_emit_position_units(b)
      mcp_write(b, ",\"items\":")
      main_diag_items_append_array(b, items)
      mcp_end_result(b)
    }
    FormatterFailure(error_count) -> {
      mcp_write(b, "{\"tool\":\"format_source\",\"ok\":false,\"schema_version\":1,\"stability\":\"stable\",\"error_count\":")
      mcp_write_i(b, error_count)
      mcp_write(b, ",\"diagnostics\":")
      mcp_write_i(b, main_diag_items_count(count))
      mcp_emit_position_units(b)
      mcp_write(b, ",\"items\":")
      main_diag_items_append_array(b, items)
      mcp_write(b, "}")
    }
  }
}

fn mcp_emit_diagnostics_legacy(b: i64, src: i64, n: i64) -> i64 {
  let tt = ttable_new()
  pipeline_mark_root_origin(tt, src, 0, 1)
  let grammar = weft_grammar()
  let items = buf_new(65536)
  let count = main_alloc_bytes(8)
  mem_store64_at(count, 0, 0)
  let fns = handle grammar.parse(src, n, tt) {
    Diagnose.report(diagnostic) -> { mcp_diag_items_append_report(items, count, src, n, tt, diagnostic) resume(0) }
    Diagnose.error(msg, span) -> { mcp_diag_items_append_legacy(items, count, src, n, 1, msg, span) resume(0) }
    Diagnose.warn(msg, span) -> { mcp_diag_items_append_legacy(items, count, src, n, 2, msg, span) resume(0) }
    Diagnose.note(msg, span) -> { mcp_diag_items_append_legacy(items, count, src, n, 3, msg, span) resume(0) }
  }
  let mut check_src = src
  let mut check_n = n
  let mut check_tt = tt
  let mut check_fns = fns
  if fns_have_tests(fns) == 1 {
    let prefixed = test_source_with_prefix_and_wrappers(src, n, fns_test_count(fns))
    let wrapped_src = node_f1(prefixed)
    check_src = wrapped_src
    let test_n = node_f2(prefixed)
    check_n = test_n
    let name_bank_start = test_source_wrapper_bank_start(prefixed)
    let wrapped_tt = ttable_new()
    check_tt = wrapped_tt
    main_mark_root_origin_with_grant(wrapped_tt, wrapped_src, 0, 1, 0)
    let parsed = handle grammar.parse(wrapped_src, test_n, wrapped_tt) {
      Diagnose.report(diagnostic) -> { mcp_diag_items_append_report(items, count, wrapped_src, test_n, wrapped_tt, diagnostic) resume(0) }
      Diagnose.error(msg, span) -> { mcp_diag_items_append_legacy(items, count, wrapped_src, test_n, 1, msg, span) resume(0) }
      Diagnose.warn(msg, span) -> { mcp_diag_items_append_legacy(items, count, wrapped_src, test_n, 2, msg, span) resume(0) }
      Diagnose.note(msg, span) -> { mcp_diag_items_append_legacy(items, count, wrapped_src, test_n, 3, msg, span) resume(0) }
    }
    check_fns = check_wrap_test_blocks(parsed, name_bank_start, wrapped_tt)
  } else { 0 }
  let final_src = check_src
  let final_n = check_n
  let final_tt = check_tt
  let final_fns = check_fns
  let check_errors = handle grammar.check(final_fns, final_src, final_tt) {
    Diagnose.report(diagnostic) -> { mcp_diag_items_append_report(items, count, final_src, final_n, final_tt, diagnostic) resume(0) }
    Diagnose.error(msg, span) -> { mcp_diag_items_append_legacy(items, count, final_src, final_n, 1, msg, span) resume(0) }
    Diagnose.warn(msg, span) -> { mcp_diag_items_append_legacy(items, count, final_src, final_n, 2, msg, span) resume(0) }
    Diagnose.note(msg, span) -> { mcp_diag_items_append_legacy(items, count, final_src, final_n, 3, msg, span) resume(0) }
  }
  mcp_begin_result(b, "diagnostics")
  mcp_write(b, ",\"phase\":\"parse+check\",\"diagnostics\":")
  mcp_write_i(b, main_diag_items_count(count))
  mcp_write(b, ",\"functions\":")
  mcp_write_i(b, main_fns_source_count(final_fns, final_src))
  mcp_write(b, ",\"check_errors\":")
  mcp_write_i(b, check_errors)
  mcp_emit_position_units(b)
  mcp_write(b, ",\"items\":")
  main_diag_items_append_array(b, items)
  mcp_end_result(b)
}

fn mcp_diag_items_append_project(items: i64, count: i64, diagnostics: ProjectDiagnostics) -> i64 {
  for i in 0..project_diagnostics_len(diagnostics) {
    let diagnostic = project_diagnostics_get(diagnostics, i)
    let src = project_diagnostics_item_source(diagnostics, i)
    let n = project_diagnostics_item_source_len(diagnostics, i)
    let tt = project_diagnostics_item_type_table(diagnostics, i)
    if project_diagnostics_item_is_legacy(diagnostics, i) {
      mcp_diag_items_append_legacy(
        items,
        count,
        src,
        n,
        diagnose_report_severity_tag(diagnostic),
        diagnose_report_message(diagnostic),
        diagnose_report_absolute_span(diagnostic)
      )
    } else { mcp_diag_items_append_report(items, count, src, n, tt, diagnostic) }
  }
  main_diag_items_count(count)
}

fn mcp_emit_project_diagnostics_result(b: i64, typed: TypedModule, parse_diagnostics: ProjectDiagnostics, check_diagnostics: ProjectDiagnostics, check_errors: i64) -> i64 {
  let items = buf_new(65536)
  let count = main_alloc_bytes(8)
  mem_store64_at(count, 0, 0)
  mcp_diag_items_append_project(items, count, parse_diagnostics)
  mcp_diag_items_append_project(items, count, check_diagnostics)
  let final_src = mcp_typed_module_src(typed)
  mcp_begin_result(b, "diagnostics")
  mcp_write(b, ",\"phase\":\"parse+check\",\"diagnostics\":")
  mcp_write_i(b, main_diag_items_count(count))
  mcp_write(b, ",\"functions\":")
  mcp_write_i(b, main_fns_source_count(pipeline_typed_fns(typed), final_src))
  mcp_write(b, ",\"check_errors\":")
  mcp_write_i(b, check_errors)
  mcp_emit_position_units(b)
  mcp_write(b, ",\"items\":")
  main_diag_items_append_array(b, items)
  mcp_end_result(b)
}

fn mcp_emit_project_parse_diagnostics_result(b: i64, ast: AstModule, diagnostics: ProjectDiagnostics) -> i64 {
  let items = buf_new(65536)
  let count = main_alloc_bytes(8)
  mem_store64_at(count, 0, 0)
  mcp_diag_items_append_project(items, count, diagnostics)
  match ast {
    AstModule(fns, src, tt) -> {
      mcp_begin_result(b, "diagnostics")
      mcp_write(b, ",\"phase\":\"parse+check\",\"diagnostics\":")
      mcp_write_i(b, main_diag_items_count(count))
      mcp_write(b, ",\"functions\":")
      mcp_write_i(b, main_fns_source_count(fns, src))
      -- The checker does not run after a parse failure. Keep that distinct
      -- from the structured parse diagnostic count above.
      mcp_write(b, ",\"check_errors\":0")
      mcp_emit_position_units(b)
      mcp_write(b, ",\"items\":")
      main_diag_items_append_array(b, items)
      mcp_end_result(b)
    }
  }
}

fn mcp_emit_diagnostics(b: i64, session: ProjectSession, src: i64, n: i64) -[SourceAcquire]> i64 {
  let context = mcp_project_update_source(session, src, n)
  match project_session_check_with_acquire(session, context) {
    ProjectCheckSucceeded(typed, source_n, parse_diagnostics, check_diagnostics) -> mcp_emit_project_diagnostics_result(b, typed, parse_diagnostics, check_diagnostics, 0)
    ProjectCheckFailed(typed, source_n, parse_diagnostics, check_diagnostics) -> mcp_emit_project_diagnostics_result(
      b,
      typed,
      parse_diagnostics,
      check_diagnostics,
      project_diagnostics_error_count(check_diagnostics)
    )
    ProjectCheckParseFailed(ProjectPreparedParseFailed(ast, source_n, diagnostics)) ->
      mcp_emit_project_parse_diagnostics_result(b, ast, diagnostics)
    -- Unset/cyclic/corrupt query state has no semantic product to render.
    _ -> mcp_emit_diagnostics_legacy(b, src, n)
  }
}

fn mcp_parse_grammar_module_quiet(module_id: i64, src: i64, n: i64, tt: i64) -> i64 {
  handle grammar_module_parse(module_id, src, n, tt) {
    Diagnose.report(diagnostic) -> resume(0)
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
}

fn mcp_check_grammar_module_quiet(module_id: i64, ast: i64, src: i64, tt: i64) -> i64 {
  handle grammar_module_check_catalog(module_id, ast, src, tt) {
    Diagnose.report(diagnostic) -> resume(0)
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
}

fn mcp_typed_module_tt(typed: TypedModule) -> i64 {
  match typed {
    TypedModule(fns, src, tt) -> tt
  }
}

fn mcp_typed_module_src(typed: TypedModule) -> i64 {
  match typed {
    TypedModule(fns, src, tt) -> src
  }
}

fn mcp_host_type_table_quiet(host_src: i64, host_n: i64) -[SourceAcquire]> i64 {
  mcp_typed_module_tt(mcp_check_source_quiet(host_src, host_n))
}

fn mcp_check_grammar_module_host_typecheck(module_id: i64, ast: i64, src: i64, host_tt: i64, host_src: i64) -[Diagnose]> i64 {
  handle grammar_module_check_host(module_id, ast, src, host_tt) {
    TypeCheck.resolve_type(name_src, ns, nl) -> resume(typecheck_resolve_type_in_source(host_tt, host_src, name_src, ns, nl))
    TypeCheck.resolve_field_type(base_ty, field_src, ns, nl) -> resume(typecheck_resolve_field_type(host_tt, base_ty, field_src, ns, nl))
    TypeCheck.subtype(actual_ty, expected_ty) -> resume(typecheck_subtype(host_tt, actual_ty, expected_ty))
  }
}

fn mcp_check_grammar_module_host_quiet(module_id: i64, ast: i64, src: i64, host_src: i64, host_n: i64) -[SourceAcquire]> i64 {
  let host_tt = mcp_host_type_table_quiet(host_src, host_n)
  handle mcp_check_grammar_module_host_typecheck(module_id, ast, src, host_tt, host_src) {
    Diagnose.report(diagnostic) -> resume(0)
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
}

fn mcp_emit_grammar_module_table(b: i64, module_id: i64, src: i64, ast: i64) -> i64 {
  let table = grammar_module_table_node(module_id, ast)
  if table == 0 {
    mcp_write(b, "null")
  } else {
    mcp_write_json_bytes(b, src + grammar_module_ident_start(module_id, table), grammar_module_ident_len(module_id, table))
  }
}

fn mcp_emit_grammar_module_summary_fields(b: i64, module_id: i64, src: i64, ast: i64) -> i64 {
  mcp_write(b, ",\"grammar\":\"")
  mcp_write(b, grammar_module_name(module_id))
  mcp_write(b, "\",\"root_tag\":")
  mcp_write_i(b, grammar_module_root_tag(module_id, ast))
  mcp_write(b, ",\"columns\":")
  mcp_write_i(b, grammar_module_column_count(module_id, ast))
  mcp_write(b, ",\"star\":")
  mcp_write_i(b, grammar_module_star(module_id, ast))
  if grammar_module_distinct(module_id, ast) == 1 {
    mcp_write(b, ",\"distinct\":1")
  } else { 0 }
  mcp_write(b, ",\"table\":")
  mcp_emit_grammar_module_table(b, module_id, src, ast)
  mcp_write(b, ",\"where\":")
  mcp_write_i(b, grammar_module_has_where(module_id, ast))
}

fn mcp_emit_grammar_parse(b: i64, src: i64, n: i64, module_id: i64) -> i64 {
  let tt = ttable_new()
  let ast = mcp_parse_grammar_module_quiet(module_id, src, n, tt)
  mcp_begin_result(b, "grammar_parse")
  mcp_emit_grammar_module_summary_fields(b, module_id, src, ast)
  mcp_end_result(b)
}

fn mcp_emit_grammar_check(b: i64, src: i64, n: i64, module_id: i64) -> i64 {
  let tt = ttable_new()
  let ast = mcp_parse_grammar_module_quiet(module_id, src, n, tt)
  let check_errors = mcp_check_grammar_module_quiet(module_id, ast, src, tt)
  mcp_begin_result(b, "grammar_check")
  mcp_emit_grammar_module_summary_fields(b, module_id, src, ast)
  mcp_write(b, ",\"check_errors\":")
  mcp_write_i(b, check_errors)
  mcp_end_result(b)
}

fn mcp_emit_grammar_check_with_host(b: i64, src: i64, n: i64, module_id: i64, host_src: i64, host_n: i64) -[SourceAcquire]> i64 {
  let tt = ttable_new()
  let ast = mcp_parse_grammar_module_quiet(module_id, src, n, tt)
  let check_errors = mcp_check_grammar_module_host_quiet(module_id, ast, src, host_src, host_n)
  mcp_begin_result(b, "grammar_check")
  mcp_emit_grammar_module_summary_fields(b, module_id, src, ast)
  mcp_write(b, ",\"check_errors\":")
  mcp_write_i(b, check_errors)
  mcp_end_result(b)
}

fn mcp_emit_grammar_diagnostics(b: i64, src: i64, n: i64, module_id: i64, host_src: i64, host_n: i64) -[SourceAcquire]> i64 {
  let tt = ttable_new()
  let items = buf_new(65536)
  let count = main_alloc_bytes(8)
  mem_store64_at(count, 0, 0)
  let parse_count = main_alloc_bytes(8)
  mem_store64_at(parse_count, 0, 0)
  let ast = handle grammar_module_parse(module_id, src, n, tt) {
    Diagnose.report(diagnostic) -> {
      mcp_diag_items_append_report(items, count, src, n, tt, diagnostic)
      if diagnose_report_severity_tag(diagnostic) == 1 { mem_store64_at(parse_count, 0, mem_load64_at(parse_count, 0) + 1) } else { 0 }
      resume(0)
    }
    Diagnose.error(msg, span) -> { mcp_diag_items_append_legacy(items, count, src, n, 1, msg, span) mem_store64_at(parse_count, 0, mem_load64_at(parse_count, 0) + 1) resume(0) }
    Diagnose.warn(msg, span) -> { mcp_diag_items_append_legacy(items, count, src, n, 2, msg, span) resume(0) }
    Diagnose.note(msg, span) -> { mcp_diag_items_append_legacy(items, count, src, n, 3, msg, span) resume(0) }
  }
  let check_errors = if mem_load64_at(parse_count, 0) > 0 { 0 }
  else {
    if host_src == 0 {
      handle grammar_module_check_catalog(module_id, ast, src, tt) {
        Diagnose.report(diagnostic) -> { mcp_diag_items_append_report(items, count, src, n, tt, diagnostic) resume(0) }
        Diagnose.error(msg, span) -> { mcp_diag_items_append_legacy(items, count, src, n, 1, msg, span) resume(0) }
        Diagnose.warn(msg, span) -> { mcp_diag_items_append_legacy(items, count, src, n, 2, msg, span) resume(0) }
        Diagnose.note(msg, span) -> { mcp_diag_items_append_legacy(items, count, src, n, 3, msg, span) resume(0) }
      }
    } else {
      let host_tt = mcp_host_type_table_quiet(host_src, host_n)
      handle mcp_check_grammar_module_host_typecheck(module_id, ast, src, host_tt, host_src) {
        Diagnose.report(diagnostic) -> { mcp_diag_items_append_report(items, count, src, n, host_tt, diagnostic) resume(0) }
        Diagnose.error(msg, span) -> { mcp_diag_items_append_legacy(items, count, src, n, 1, msg, span) resume(0) }
        Diagnose.warn(msg, span) -> { mcp_diag_items_append_legacy(items, count, src, n, 2, msg, span) resume(0) }
        Diagnose.note(msg, span) -> { mcp_diag_items_append_legacy(items, count, src, n, 3, msg, span) resume(0) }
      }
    }
  }
  mcp_begin_result(b, "grammar_diagnostics")
  mcp_write(b, ",\"grammar\":\"")
  mcp_write(b, grammar_module_name(module_id))
  mcp_write(b, "\",\"phase\":\"parse+check\",\"diagnostics\":")
  mcp_write_i(b, main_diag_items_count(count))
  mcp_write(b, ",\"check_errors\":")
  mcp_write_i(b, check_errors)
  mcp_emit_position_units(b)
  mcp_write(b, ",\"items\":")
  main_diag_items_append_array(b, items)
  mcp_end_result(b)
}

fn mcp_dispatch_grammar_tool(b: i64, req: i64, n: i64, root: i64, src: i64, src_n: i64, tool_id: i64) -[SourceAcquire]> i64 {
  let grammar_pair = mcp_extract_grammar_name(req, n, root)
  let host_pair = mcp_extract_host_source(req, n, root)
  let host_src = mem_load64_at(host_pair, 0)
  let host_n = mem_load64_at(host_pair, 8)
  let grammar_ptr = mem_load64_at(grammar_pair, 0)
  let grammar_n = mem_load64_at(grammar_pair, 8)
  if grammar_ptr == 0 {
    mcp_emit_error(b, 0 - 32602, "missing grammar")
  } else {
    let module_id = grammar_module_lookup(grammar_ptr, grammar_n)
    if module_id == grammar_module_unknown() {
      mcp_emit_error(b, 0 - 32602, "unknown grammar")
    } else {
      match tool_id {
        7 -> mcp_emit_grammar_parse(b, src, src_n, module_id)
        8 -> {
          if host_src == 0 { mcp_emit_grammar_check(b, src, src_n, module_id) }
          else { mcp_emit_grammar_check_with_host(b, src, src_n, module_id, host_src, host_n) }
        }
        9 -> mcp_emit_grammar_diagnostics(b, src, src_n, module_id, host_src, host_n)
        _ -> mcp_emit_error(b, 0 - 32601, "unknown tool")
      }
    }
  }
}

fn mcp_name_bytes_eq(name_ptr: i64, name_n: i64, cand_ptr: i64, cand_n: i64) -> i64 {
  if name_n != cand_n { 0 } else { src_eq_at(name_ptr, 0, cand_ptr, 0, name_n) }
}

fn mcp_write_json_str(b: i64, value: str) -> i64 {
  mcp_write_json_bytes(b, __str_ptr(value), __str_len(value))
}

fn mcp_write_bool(b: i64, value: bool) -> i64 {
  if value { mcp_write(b, "true") } else { mcp_write(b, "false") }
}

fn mcp_emit_semantic_type_list(b: i64, types: SemanticTypeFactList) -> i64 {
  mcp_write(b, "[")
  let mut current = types
  let mut first = true
  let mut done = false
  while not done {
    match current {
      SemanticTypeFactListNil -> { done = true }
      SemanticTypeFactListCons(item, rest) -> {
        if not first { mcp_write(b, ",") } else { first = false }
        mcp_emit_semantic_type(b, item)
        current = rest
      }
      SemanticTypeFactListOther(name) -> {
        if not first { mcp_write(b, ",") } else { first = false }
        mcp_write(b, "{\"kind\":\"other\",\"name\":")
        mcp_write_json_str(b, name)
        mcp_write(b, "}")
        done = true
      }
    }
  }
  mcp_write(b, "]")
}

fn mcp_emit_semantic_record_fields(b: i64, fields: SemanticRecordFieldFactList) -> i64 {
  mcp_write(b, "[")
  let mut current = fields
  let mut first = true
  let mut done = false
  while not done {
    match current {
      SemanticRecordFieldFactListNil -> { done = true }
      SemanticRecordFieldFactListCons(field, rest) -> {
        if not first { mcp_write(b, ",") } else { first = false }
        match field {
          SemanticRecordField(name, index, ty) -> {
            mcp_write(b, "{\"name\":")
            mcp_write_json_str(b, name)
            mcp_write(b, ",\"index\":")
            mcp_write_i(b, index)
            mcp_write(b, ",\"type\":")
            mcp_emit_semantic_type(b, ty)
            mcp_write(b, "}")
          }
          SemanticRecordFieldOther(name) -> {
            mcp_write(b, "{\"kind\":\"other\",\"name\":")
            mcp_write_json_str(b, name)
            mcp_write(b, "}")
          }
        }
        current = rest
      }
      SemanticRecordFieldFactListOther(name) -> {
        if not first { mcp_write(b, ",") } else { first = false }
        mcp_write(b, "{\"kind\":\"other\",\"name\":")
        mcp_write_json_str(b, name)
        mcp_write(b, "}")
        done = true
      }
    }
  }
  mcp_write(b, "]")
}

fn mcp_emit_semantic_type(b: i64, ty: SemanticTypeFact) -> i64 {
  match ty {
    SemanticTypeBottom -> mcp_write(b, "{\"kind\":\"bottom\"}")
    SemanticTypeTop -> mcp_write(b, "{\"kind\":\"top\"}")
    SemanticTypePrimitive(name) -> { mcp_write(b, "{\"kind\":\"primitive\",\"name\":") mcp_write_json_str(b, name) mcp_write(b, "}") }
    SemanticTypeNamed(name, args) -> { mcp_write(b, "{\"kind\":\"named\",\"name\":") mcp_write_json_str(b, name) mcp_write(b, ",\"arguments\":") mcp_emit_semantic_type_list(b, args) mcp_write(b, "}") }
    SemanticTypeQualifiedNamed(module_name, name, args) -> { mcp_write(b, "{\"kind\":\"qualified_named\",\"module\":") mcp_write_json_str(b, module_name) mcp_write(b, ",\"name\":") mcp_write_json_str(b, name) mcp_write(b, ",\"arguments\":") mcp_emit_semantic_type_list(b, args) mcp_write(b, "}") }
    SemanticTypeVariable(name) -> { mcp_write(b, "{\"kind\":\"variable\",\"name\":") mcp_write_json_str(b, name) mcp_write(b, "}") }
    SemanticTypeUnion(left, right) -> { mcp_write(b, "{\"kind\":\"union\",\"left\":") mcp_emit_semantic_type(b, left) mcp_write(b, ",\"right\":") mcp_emit_semantic_type(b, right) mcp_write(b, "}") }
    SemanticTypeIntersection(left, right) -> { mcp_write(b, "{\"kind\":\"intersection\",\"left\":") mcp_emit_semantic_type(b, left) mcp_write(b, ",\"right\":") mcp_emit_semantic_type(b, right) mcp_write(b, "}") }
    SemanticTypeComplement(inner) -> { mcp_write(b, "{\"kind\":\"complement\",\"inner\":") mcp_emit_semantic_type(b, inner) mcp_write(b, "}") }
    SemanticTypeFunction(params, result, effects) -> { mcp_write(b, "{\"kind\":\"function\",\"parameters\":") mcp_emit_semantic_type_list(b, params) mcp_write(b, ",\"return_type\":") mcp_emit_semantic_type(b, result) mcp_write(b, ",\"effects\":") mcp_emit_semantic_effects(b, effects) mcp_write(b, "}") }
    SemanticTypeRecord(fields, open, tuple) -> { mcp_write(b, "{\"kind\":\"record\",\"fields\":") mcp_emit_semantic_record_fields(b, fields) mcp_write(b, ",\"open\":") mcp_write_bool(b, open) mcp_write(b, ",\"tuple\":") mcp_write_bool(b, tuple) mcp_write(b, "}") }
    SemanticTypeContinuation(input, result) -> { mcp_write(b, "{\"kind\":\"continuation\",\"input\":") mcp_emit_semantic_type(b, input) mcp_write(b, ",\"result\":") mcp_emit_semantic_type(b, result) mcp_write(b, "}") }
    SemanticTypePointer(inner, mutable) -> { mcp_write(b, "{\"kind\":\"pointer\",\"inner\":") mcp_emit_semantic_type(b, inner) mcp_write(b, ",\"mutable\":") mcp_write_bool(b, mutable) mcp_write(b, "}") }
    SemanticTypeWeak(inner) -> { mcp_write(b, "{\"kind\":\"weak\",\"inner\":") mcp_emit_semantic_type(b, inner) mcp_write(b, "}") }
    SemanticTypeUnique(inner) -> { mcp_write(b, "{\"kind\":\"unique\",\"inner\":") mcp_emit_semantic_type(b, inner) mcp_write(b, "}") }
    SemanticTypeOwned(inner) -> { mcp_write(b, "{\"kind\":\"owned\",\"inner\":") mcp_emit_semantic_type(b, inner) mcp_write(b, "}") }
    SemanticTypeBorrow(inner, mutable) -> { mcp_write(b, "{\"kind\":\"borrow\",\"inner\":") mcp_emit_semantic_type(b, inner) mcp_write(b, ",\"mutable\":") mcp_write_bool(b, mutable) mcp_write(b, "}") }
    SemanticTypeTrait(name) -> { mcp_write(b, "{\"kind\":\"trait\",\"name\":") mcp_write_json_str(b, name) mcp_write(b, "}") }
    SemanticTypeQualifiedTrait(module_name, name) -> { mcp_write(b, "{\"kind\":\"qualified_trait\",\"module\":") mcp_write_json_str(b, module_name) mcp_write(b, ",\"name\":") mcp_write_json_str(b, name) mcp_write(b, "}") }
    SemanticTypeArray(inner, length) -> { mcp_write(b, "{\"kind\":\"array\",\"element\":") mcp_emit_semantic_type(b, inner) mcp_write(b, ",\"length\":") mcp_write_i(b, length) mcp_write(b, "}") }
    SemanticTypeSlice(inner, mutable) -> { mcp_write(b, "{\"kind\":\"slice\",\"element\":") mcp_emit_semantic_type(b, inner) mcp_write(b, ",\"mutable\":") mcp_write_bool(b, mutable) mcp_write(b, "}") }
    SemanticTypeAssociated(base, name) -> { mcp_write(b, "{\"kind\":\"associated\",\"base\":") mcp_emit_semantic_type(b, base) mcp_write(b, ",\"name\":") mcp_write_json_str(b, name) mcp_write(b, "}") }
    SemanticTypeOther(name) -> { mcp_write(b, "{\"kind\":\"other\",\"name\":") mcp_write_json_str(b, name) mcp_write(b, "}") }
  }
}

fn mcp_emit_semantic_effect_atom(b: i64, atom: SemanticEffectAtomFact) -> i64 {
  match atom {
    SemanticEffectAtom(name, args) -> { mcp_write(b, "{\"name\":") mcp_write_json_str(b, name) mcp_write(b, ",\"arguments\":") mcp_emit_semantic_type_list(b, args) mcp_write(b, "}") }
    SemanticQualifiedEffectAtom(module_name, name, args) -> { mcp_write(b, "{\"module\":") mcp_write_json_str(b, module_name) mcp_write(b, ",\"name\":") mcp_write_json_str(b, name) mcp_write(b, ",\"arguments\":") mcp_emit_semantic_type_list(b, args) mcp_write(b, "}") }
    SemanticEffectAtomOther(name) -> { mcp_write(b, "{\"kind\":\"other\",\"name\":") mcp_write_json_str(b, name) mcp_write(b, "}") }
  }
}

fn mcp_emit_semantic_effect_atoms(b: i64, atoms: SemanticEffectAtomFactList) -> i64 {
  mcp_write(b, "[")
  let mut current = atoms
  let mut first = true
  let mut done = false
  while not done {
    match current {
      SemanticEffectAtomFactListNil -> { done = true }
      SemanticEffectAtomFactListCons(atom, rest) -> {
        if not first { mcp_write(b, ",") } else { first = false }
        mcp_emit_semantic_effect_atom(b, atom)
        current = rest
      }
      SemanticEffectAtomFactListOther(name) -> {
        if not first { mcp_write(b, ",") } else { first = false }
        mcp_write(b, "{\"kind\":\"other\",\"name\":")
        mcp_write_json_str(b, name)
        mcp_write(b, "}")
        done = true
      }
    }
  }
  mcp_write(b, "]")
}

fn mcp_emit_semantic_effects(b: i64, effects: SemanticEffectSetFact) -> i64 {
  match effects {
    SemanticEffectsClosed(atoms) -> { mcp_write(b, "{\"kind\":\"closed\",\"atoms\":") mcp_emit_semantic_effect_atoms(b, atoms) mcp_write(b, "}") }
    SemanticEffectsOpen(atoms, tail) -> { mcp_write(b, "{\"kind\":\"open\",\"atoms\":") mcp_emit_semantic_effect_atoms(b, atoms) mcp_write(b, ",\"tail\":") mcp_write_json_str(b, tail) mcp_write(b, "}") }
    SemanticEffectsOther(name) -> { mcp_write(b, "{\"kind\":\"other\",\"name\":") mcp_write_json_str(b, name) mcp_write(b, "}") }
  }
}

-- L8 wire projection. The producer-owned Diagnostic remains typed until this
-- boundary; MCP and LSP call the same serializer and never recover fields from
-- message text. Every union is emitted with an explicit kind, and the stable
-- v1 shape grows only additively.
fn mcp_emit_diagnostic_class(b: i64, class: DiagnosticClass) -> i64 {
  match class {
    DiagnosticClassParse -> mcp_write_json_str(b, "parse")
    DiagnosticClassType -> mcp_write_json_str(b, "type")
    DiagnosticClassEffect -> mcp_write_json_str(b, "effect")
    DiagnosticClassOwnership -> mcp_write_json_str(b, "ownership")
    DiagnosticClassModule -> mcp_write_json_str(b, "module")
    DiagnosticClassLink -> mcp_write_json_str(b, "link")
    DiagnosticClassGrammar -> mcp_write_json_str(b, "grammar")
    DiagnosticClassTool -> mcp_write_json_str(b, "tool")
    DiagnosticClassRuntime -> mcp_write_json_str(b, "runtime")
    DiagnosticClassTest -> mcp_write_json_str(b, "test")
    DiagnosticClassOther(name) -> mcp_write_json_str(b, name)
  }
}

fn main_diagnostic_source_entry(tt: i64, source: DiagnosticSource) -> i64 {
  if tt == 0 { 0 }
  else {
    match source {
      DiagnosticSourceBuffer(buffer) -> ttable_find_source_buffer_entry(tt, buffer)
      DiagnosticSourceNamed(name) -> ttable_find_source_path_entry(tt, __str_ptr(name), __str_len(name))
      DiagnosticSourceUnknown -> 0
    }
  }
}

fn main_diagnostic_source_index(tt: i64, entry: i64) -> i64 {
  if tt == 0 or entry == 0 { 0 - 1 }
  else {
    let sources = ttable_sources(tt)
    let mut i = 0
    let mut found = 0 - 1
    while i < nlist_len(sources) and found < 0 {
      if nlist_get(sources, i) == entry { found = i } else { i = i + 1 }
    }
    found
  }
}

fn mcp_emit_diagnostic_source(b: i64, root_src: i64, tt: i64, source: DiagnosticSource) -> i64 {
  match source {
    DiagnosticSourceUnknown -> mcp_write(b, "{\"kind\":\"unknown\"}")
    DiagnosticSourceNamed(name) -> {
      mcp_write(b, "{\"kind\":\"file\",\"path\":")
      mcp_write_json_str(b, name)
      mcp_write(b, "}")
    }
    DiagnosticSourceBuffer(buffer) -> {
      let entry = main_diagnostic_source_entry(tt, source)
      let path_len = if entry == 0 { 0 } else { mem_load64_at(entry + 24, 0) }
      if path_len > 0 {
        mcp_write(b, "{\"kind\":\"file\",\"path\":")
        mcp_write_json_bytes(b, mem_load64_at(entry + 16, 0), path_len)
        mcp_write(b, "}")
      } else { if buffer == root_src {
        mcp_write(b, "{\"kind\":\"input\"}")
      } else {
        mcp_write(b, "{\"kind\":\"buffer\",\"id\":")
        mcp_write_i(b, main_diagnostic_source_index(tt, entry))
        mcp_write(b, "}")
      } }
    }
  }
}

fn mcp_emit_diagnostic_location(b: i64, root_src: i64, root_n: i64, tt: i64, location: DiagnosticLocation) -> i64 {
  match location {
    DiagnosticLocationNone -> mcp_write(b, "null")
    DiagnosticSourceRange(source, start, end) -> {
      let entry = main_diagnostic_source_entry(tt, source)
      let source_ptr = match source {
        DiagnosticSourceBuffer(buffer) -> buffer
        DiagnosticSourceNamed(name) -> if entry == 0 { 0 } else { mem_load64_at(entry, 0) }
        DiagnosticSourceUnknown -> 0
      }
      let source_n = if entry != 0 { mem_load64_at(entry + 8, 0) }
        else { if source_ptr == root_src { root_n } else { 0 } }
      mcp_write(b, "{\"source\":")
      mcp_emit_diagnostic_source(b, root_src, tt, source)
      mcp_write(b, ",\"span\":")
      mcp_write_i(b, start)
      mcp_write(b, ",\"end_span\":")
      mcp_write_i(b, end)
      if source_ptr != 0 and source_n >= 0 and start >= 0 {
        mcp_write(b, ",\"line\":")
        mcp_write_i(b, mcp_span_line(source_ptr, start))
        mcp_write(b, ",\"col\":")
        mcp_write_i(b, mcp_span_col(source_ptr, start))
        mcp_write(b, ",\"scalar_col\":")
        mcp_write_i(b, mcp_span_scalar_col(source_ptr, source_n, start))
        mcp_write(b, ",\"utf16_col\":")
        mcp_write_i(b, mcp_span_utf16_col(source_ptr, source_n, start))
        mcp_write(b, ",\"end_line\":")
        mcp_write_i(b, mcp_span_line(source_ptr, end))
        mcp_write(b, ",\"end_col\":")
        mcp_write_i(b, mcp_span_col(source_ptr, end))
        mcp_write(b, ",\"end_scalar_col\":")
        mcp_write_i(b, mcp_span_scalar_col(source_ptr, source_n, end))
        mcp_write(b, ",\"end_utf16_col\":")
        mcp_write_i(b, mcp_span_utf16_col(source_ptr, source_n, end))
      } else { 0 }
      mcp_write(b, "}")
    }
  }
}

fn mcp_emit_diagnostic_related(b: i64, root_src: i64, root_n: i64, tt: i64, related: DiagnosticRelatedLocationList) -> i64 {
  mcp_write(b, "[")
  let mut current = related
  let mut first = true
  let mut done = false
  while not done {
    match current {
      DiagnosticRelatedLocationNil -> { done = true }
      DiagnosticRelatedLocationCons(item, rest) -> {
        if not first { mcp_write(b, ",") } else { first = false }
        match item {
          DiagnosticRelatedLocation(label, location) -> {
            mcp_write(b, "{\"label\":")
            mcp_write_json_str(b, label)
            mcp_write(b, ",\"location\":")
            mcp_emit_diagnostic_location(b, root_src, root_n, tt, location)
            mcp_write(b, "}")
          }
        }
        current = rest
      }
    }
  }
  mcp_write(b, "]")
}

fn mcp_emit_diagnostic_edits(b: i64, root_src: i64, root_n: i64, tt: i64, edits: DiagnosticTextEditList) -> i64 {
  mcp_write(b, "[")
  let mut current = edits
  let mut first = true
  let mut done = false
  while not done {
    match current {
      DiagnosticTextEditNil -> { done = true }
      DiagnosticTextEditCons(edit, rest) -> {
        if not first { mcp_write(b, ",") } else { first = false }
        match edit {
          DiagnosticTextEdit(location, replacement) -> {
            mcp_write(b, "{\"location\":")
            mcp_emit_diagnostic_location(b, root_src, root_n, tt, location)
            mcp_write(b, ",\"replacement\":")
            mcp_write_json_str(b, replacement)
            mcp_write(b, "}")
          }
        }
        current = rest
      }
    }
  }
  mcp_write(b, "]")
}

fn mcp_emit_diagnostic_suggestion(b: i64, root_src: i64, root_n: i64, tt: i64, suggestion: DiagnosticSuggestion) -> i64 {
  match suggestion {
    DiagnosticSuggestion(message, applicability, edits) -> {
      mcp_write(b, "{\"message\":")
      mcp_write_json_str(b, message)
      mcp_write(b, ",\"applicability\":")
      match applicability {
        DiagnosticSuggestionUnspecified -> mcp_write_json_str(b, "unspecified")
        DiagnosticSuggestionMachineApplicable -> mcp_write_json_str(b, "machine-applicable")
        DiagnosticSuggestionMaybeIncorrect -> mcp_write_json_str(b, "maybe-incorrect")
      }
      mcp_write(b, ",\"edits\":")
      mcp_emit_diagnostic_edits(b, root_src, root_n, tt, edits)
      mcp_write(b, "}")
    }
  }
}

fn mcp_emit_diagnostic_fields(b: i64, root_src: i64, root_n: i64, tt: i64, fields: DiagnosticFieldList) -> i64 {
  mcp_write(b, "[")
  let mut current = fields
  let mut first = true
  let mut done = false
  while not done {
    match current {
      DiagnosticFieldNil -> { done = true }
      DiagnosticFieldCons(field, rest) -> {
        if not first { mcp_write(b, ",") } else { first = false }
        match field {
          DiagnosticFieldText(name, value) -> { mcp_write(b, "{\"kind\":\"text\",\"name\":") mcp_write_json_str(b, name) mcp_write(b, ",\"value\":") mcp_write_json_str(b, value) mcp_write(b, "}") }
          DiagnosticFieldI64(name, value) -> { mcp_write(b, "{\"kind\":\"i64\",\"name\":") mcp_write_json_str(b, name) mcp_write(b, ",\"value\":") mcp_write_i(b, value) mcp_write(b, "}") }
          DiagnosticFieldBool(name, value) -> { mcp_write(b, "{\"kind\":\"bool\",\"name\":") mcp_write_json_str(b, name) mcp_write(b, ",\"value\":") mcp_write_bool(b, value) mcp_write(b, "}") }
          DiagnosticFieldLocation(name, location) -> { mcp_write(b, "{\"kind\":\"location\",\"name\":") mcp_write_json_str(b, name) mcp_write(b, ",\"value\":") mcp_emit_diagnostic_location(b, root_src, root_n, tt, location) mcp_write(b, "}") }
          DiagnosticFieldType(name, value) -> { mcp_write(b, "{\"kind\":\"type\",\"name\":") mcp_write_json_str(b, name) mcp_write(b, ",\"value\":") mcp_emit_semantic_type(b, value) mcp_write(b, "}") }
          DiagnosticFieldEffectAtom(name, value) -> { mcp_write(b, "{\"kind\":\"effect_atom\",\"name\":") mcp_write_json_str(b, name) mcp_write(b, ",\"value\":") mcp_emit_semantic_effect_atom(b, value) mcp_write(b, "}") }
          DiagnosticFieldEffectSet(name, value) -> { mcp_write(b, "{\"kind\":\"effect_set\",\"name\":") mcp_write_json_str(b, name) mcp_write(b, ",\"value\":") mcp_emit_semantic_effects(b, value) mcp_write(b, "}") }
          DiagnosticFieldSuggestion(suggestion) -> { mcp_write(b, "{\"kind\":\"suggestion\",\"value\":") mcp_emit_diagnostic_suggestion(b, root_src, root_n, tt, suggestion) mcp_write(b, "}") }
        }
        current = rest
      }
    }
  }
  mcp_write(b, "]")
}

fn mcp_emit_diagnostic_value(b: i64, root_src: i64, root_n: i64, tt: i64, diagnostic: Diagnostic) -> i64 {
  match diagnostic {
    Diagnostic(severity, class, code, message, primary, related, fields) -> {
      mcp_write(b, "{\"schema_version\":1,\"severity\":")
      mcp_write_diag_severity(b, match severity {
        DiagnosticSeverityError -> 1
        DiagnosticSeverityWarning -> 2
        DiagnosticSeverityNote -> 3
      })
      mcp_write(b, ",\"class\":")
      mcp_emit_diagnostic_class(b, class)
      mcp_write(b, ",\"code\":")
      match code {
        DiagnosticCodeUnassigned -> mcp_write(b, "null")
        DiagnosticCodeAssigned(value) -> mcp_write_json_str(b, value)
      }
      mcp_write(b, ",\"message\":")
      mcp_write_json_str(b, message)
      mcp_write(b, ",\"position_units\":{\"span\":\"utf-8-byte-offset\",\"line_base\":1,\"col\":\"utf-8-byte-column\",\"scalar_col\":\"unicode-scalar-column\",\"utf16_col\":\"utf-16-code-unit-column\"},\"primary\":")
      mcp_emit_diagnostic_location(b, root_src, root_n, tt, primary)
      mcp_write(b, ",\"related\":")
      mcp_emit_diagnostic_related(b, root_src, root_n, tt, related)
      mcp_write(b, ",\"fields\":")
      mcp_emit_diagnostic_fields(b, root_src, root_n, tt, fields)
      mcp_write(b, "}")
    }
  }
}

fn mcp_emit_semantic_parameters(b: i64, params: SemanticParameterFactList) -> i64 {
  mcp_write(b, "[")
  let mut current = params
  let mut first = true
  let mut done = false
  while not done {
    match current {
      SemanticParameterFactListNil -> { done = true }
      SemanticParameterFactListCons(param, rest) -> {
        if not first { mcp_write(b, ",") } else { first = false }
        match param {
          SemanticParameter(name, ty) -> { mcp_write(b, "{\"name\":") mcp_write_json_str(b, name) mcp_write(b, ",\"type\":") mcp_emit_semantic_type(b, ty) mcp_write(b, "}") }
          SemanticParameterOther(name) -> { mcp_write(b, "{\"kind\":\"other\",\"name\":") mcp_write_json_str(b, name) mcp_write(b, "}") }
        }
        current = rest
      }
      SemanticParameterFactListOther(name) -> {
        if not first { mcp_write(b, ",") } else { first = false }
        mcp_write(b, "{\"kind\":\"other\",\"name\":") mcp_write_json_str(b, name) mcp_write(b, "}")
        done = true
      }
    }
  }
  mcp_write(b, "]")
}

fn mcp_emit_semantic_bounds(b: i64, bounds: SemanticBoundsFact) -> i64 {
  match bounds {
    SemanticBoundsUnknown -> mcp_write(b, "{\"kind\":\"unknown\"}")
    SemanticBoundsTraits(traits) -> {
      mcp_write(b, "{\"kind\":\"traits\",\"traits\":[")
      let mut current = traits
      let mut first = true
      let mut done = false
      while not done {
        match current {
          SemanticTraitBoundFactListNil -> { done = true }
          SemanticTraitBoundFactListCons(bound, rest) -> {
            if not first { mcp_write(b, ",") } else { first = false }
            match bound {
              SemanticTraitBound(name) -> mcp_write_json_str(b, name)
              SemanticTraitBoundOther(name) -> { mcp_write(b, "{\"kind\":\"other\",\"name\":") mcp_write_json_str(b, name) mcp_write(b, "}") }
            }
            current = rest
          }
          SemanticTraitBoundFactListOther(name) -> {
            if not first { mcp_write(b, ",") } else { 0 }
            mcp_write(b, "{\"kind\":\"other\",\"name\":") mcp_write_json_str(b, name) mcp_write(b, "}")
            done = true
          }
        }
      }
      mcp_write(b, "]}")
    }
    SemanticBoundsTypeParameters(params) -> { mcp_write(b, "{\"kind\":\"type_parameters\",\"parameters\":") mcp_emit_semantic_type_parameters(b, params) mcp_write(b, "}") }
    SemanticBoundsOther(name) -> { mcp_write(b, "{\"kind\":\"other\",\"name\":") mcp_write_json_str(b, name) mcp_write(b, "}") }
  }
}

fn mcp_emit_semantic_type_parameters(b: i64, params: SemanticTypeParameterFactList) -> i64 {
  mcp_write(b, "[")
  let mut current = params
  let mut first = true
  let mut done = false
  while not done {
    match current {
      SemanticTypeParameterFactListNil -> { done = true }
      SemanticTypeParameterFactListCons(param, rest) -> {
        if not first { mcp_write(b, ",") } else { first = false }
        match param {
          SemanticTypeParameter(name, bounds) -> { mcp_write(b, "{\"name\":") mcp_write_json_str(b, name) mcp_write(b, ",\"bounds\":") mcp_emit_semantic_bounds(b, bounds) mcp_write(b, "}") }
          SemanticTypeParameterOther(name) -> { mcp_write(b, "{\"kind\":\"other\",\"name\":") mcp_write_json_str(b, name) mcp_write(b, "}") }
        }
        current = rest
      }
      SemanticTypeParameterFactListOther(name) -> {
        if not first { mcp_write(b, ",") } else { first = false }
        mcp_write(b, "{\"kind\":\"other\",\"name\":") mcp_write_json_str(b, name) mcp_write(b, "}")
        done = true
      }
    }
  }
  mcp_write(b, "]")
}

fn mcp_emit_semantic_purity(b: i64, purity: SemanticPurityFact) -> i64 {
  match purity {
    SemanticPurityPure -> mcp_write(b, "\"pure\"")
    SemanticPurityEffectful -> mcp_write(b, "\"effectful\"")
    SemanticPurityOpen -> mcp_write(b, "\"open\"")
    SemanticPurityOther(name) -> mcp_write_json_str(b, name)
  }
}

fn mcp_emit_semantic_ownership(b: i64, ownership: SemanticOwnershipFact) -> i64 {
  match ownership {
    SemanticOwnershipUnknown -> mcp_write(b, "{\"kind\":\"unknown\"}")
    SemanticOwnershipBorrowedParameters(indices) -> {
      mcp_write(b, "{\"kind\":\"borrowed_parameters\",\"indices\":[")
      let mut current = indices
      let mut first = true
      let mut done = false
      while not done {
        match current {
          SemanticIndexFactListNil -> { done = true }
          SemanticIndexFactListCons(index, rest) -> {
            if not first { mcp_write(b, ",") } else { first = false }
            mcp_write_i(b, index)
            current = rest
          }
          SemanticIndexFactListOther(name) -> { done = true }
        }
      }
      mcp_write(b, "]}")
    }
    SemanticOwnershipOther(name) -> { mcp_write(b, "{\"kind\":\"other\",\"name\":") mcp_write_json_str(b, name) mcp_write(b, "}") }
  }
}

fn mcp_emit_semantic_shape(b: i64, shape: SemanticValueShapeFact) -> i64 {
  match shape {
    SemanticValueShapeUnknown -> mcp_write(b, "{\"kind\":\"unknown\"}")
    SemanticValueShapeWords(count) -> { mcp_write(b, "{\"kind\":\"words\",\"count\":") mcp_write_i(b, count) mcp_write(b, "}") }
    SemanticValueShapeExactWords(count, lanes) -> {
      mcp_write(b, "{\"kind\":\"words\",\"count\":") mcp_write_i(b, count) mcp_write(b, ",\"lanes\":[")
      let mut current = lanes
      let mut first = true
      let mut done = false
      while not done {
        match current {
          SemanticValueLaneFactListNil -> { done = true }
          SemanticValueLaneFactListCons(lane, rest) -> {
            if not first { mcp_write(b, ",") } else { first = false }
            match lane {
              SemanticValueLaneGpr -> mcp_write(b, "\"gpr\"")
              SemanticValueLaneF32 -> mcp_write(b, "\"f32\"")
              SemanticValueLaneF64 -> mcp_write(b, "\"f64\"")
              SemanticValueLaneOther(name) -> { mcp_write(b, "{\"kind\":\"other\",\"name\":") mcp_write_json_str(b, name) mcp_write(b, "}") }
            }
            current = rest
          }
          SemanticValueLaneFactListOther(name) -> {
            if not first { mcp_write(b, ",") } else { 0 }
            mcp_write(b, "{\"kind\":\"other\",\"name\":") mcp_write_json_str(b, name) mcp_write(b, "}")
            done = true
          }
        }
      }
      mcp_write(b, "]}")
    }
    SemanticValueShapeOther(name) -> { mcp_write(b, "{\"kind\":\"other\",\"name\":") mcp_write_json_str(b, name) mcp_write(b, "}") }
  }
}

fn mcp_emit_semantic_effect_operations(b: i64, operations: SemanticEffectOperationFactList) -> i64 {
  mcp_write(b, "[")
  let mut current = operations
  let mut first = true
  let mut done = false
  while not done {
    match current {
      SemanticEffectOperationFactListNil -> { done = true }
      SemanticEffectOperationFactListCons(operation, rest) -> {
        if not first { mcp_write(b, ",") } else { first = false }
        match operation {
          SemanticEffectOperation(name, params, result, deferred) -> {
            mcp_write(b, "{\"name\":") mcp_write_json_str(b, name)
            mcp_write(b, ",\"parameters\":") mcp_emit_semantic_parameters(b, params)
            mcp_write(b, ",\"return_type\":") mcp_emit_semantic_type(b, result)
            mcp_write(b, ",\"deferred\":") mcp_write_bool(b, deferred)
            mcp_write(b, "}")
          }
          SemanticEffectOperationOther(name) -> { mcp_write(b, "{\"kind\":\"other\",\"name\":") mcp_write_json_str(b, name) mcp_write(b, "}") }
        }
        current = rest
      }
      SemanticEffectOperationFactListOther(name) -> {
        if not first { mcp_write(b, ",") } else { first = false }
        mcp_write(b, "{\"kind\":\"other\",\"name\":") mcp_write_json_str(b, name) mcp_write(b, "}")
        done = true
      }
    }
  }
  mcp_write(b, "]")
}

fn mcp_emit_semantic_symbol_kind(b: i64, kind: SemanticSymbolKind) -> i64 {
  match kind {
    SemanticSymbolFunction -> mcp_write(b, "\"function\"")
    SemanticSymbolConstructor -> mcp_write(b, "\"constructor\"")
    SemanticSymbolLocal -> mcp_write(b, "\"local\"")
    SemanticSymbolParameter -> mcp_write(b, "\"parameter\"")
    SemanticSymbolPattern -> mcp_write(b, "\"pattern\"")
    SemanticSymbolLoopBinding -> mcp_write(b, "\"loop_binding\"")
    SemanticSymbolModule -> mcp_write(b, "\"module\"")
    SemanticSymbolType -> mcp_write(b, "\"type\"")
    SemanticSymbolEffect -> mcp_write(b, "\"effect\"")
    SemanticSymbolTrait -> mcp_write(b, "\"trait\"")
    SemanticSymbolField -> mcp_write(b, "\"field\"")
    SemanticSymbolTuplePosition -> mcp_write(b, "\"tuple_position\"")
    SemanticSymbolEffectOperation -> mcp_write(b, "\"effect_operation\"")
    SemanticSymbolConstant -> mcp_write(b, "\"constant\"")
    SemanticSymbolKindOther(name) -> mcp_write_json_str(b, name)
  }
}

fn mcp_emit_semantic_source_location(b: i64, location: SemanticSourceLocationFact) -> i64 {
  match location {
    SemanticSourceLocation(path, start, len) -> {
      mcp_write(b, "{\"path\":") mcp_write_json_str(b, path)
      mcp_write(b, ",\"start\":") mcp_write_i(b, start)
      mcp_write(b, ",\"length\":") mcp_write_i(b, len)
      mcp_write(b, "}")
    }
    SemanticSourceLocationOther(name) -> { mcp_write(b, "{\"kind\":\"other\",\"name\":") mcp_write_json_str(b, name) mcp_write(b, "}") }
  }
}

fn mcp_emit_semantic_fact(b: i64, fact: SemanticFact) -> i64 {
  match fact {
    SemanticFactFunction(function) -> match function {
      SemanticFunction(name, params, result, effects, purity, ownership, shape, bounds) -> {
        mcp_write(b, "{\"kind\":\"function\",\"name\":") mcp_write_json_str(b, name)
        mcp_write(b, ",\"parameters\":") mcp_emit_semantic_parameters(b, params)
        mcp_write(b, ",\"return_type\":") mcp_emit_semantic_type(b, result)
        mcp_write(b, ",\"effects\":") mcp_emit_semantic_effects(b, effects)
        mcp_write(b, ",\"purity\":") mcp_emit_semantic_purity(b, purity)
        mcp_write(b, ",\"ownership\":") mcp_emit_semantic_ownership(b, ownership)
        mcp_write(b, ",\"return_shape\":") mcp_emit_semantic_shape(b, shape)
        mcp_write(b, ",\"bounds\":") mcp_emit_semantic_bounds(b, bounds)
        mcp_write(b, "}")
      }
      SemanticFunctionOther(name) -> { mcp_write(b, "{\"kind\":\"other\",\"name\":") mcp_write_json_str(b, name) mcp_write(b, "}") }
    }
    SemanticFactTypeDeclaration(declaration) -> match declaration {
      SemanticTypeDeclaration(name, kind, params, items) -> {
        mcp_write(b, "{\"kind\":\"type_declaration\",\"name\":") mcp_write_json_str(b, name)
        mcp_write(b, ",\"declaration_kind\":")
        match kind {
          SemanticTypeDeclarationRecord -> mcp_write(b, "\"record\"")
          SemanticTypeDeclarationVariant -> mcp_write(b, "\"variant\"")
          SemanticTypeDeclarationOpaque -> mcp_write(b, "\"opaque\"")
          SemanticTypeDeclarationTrait -> mcp_write(b, "\"trait\"")
          SemanticTypeDeclarationKindOther(other) -> mcp_write_json_str(b, other)
        }
        mcp_write(b, ",\"type_parameters\":") mcp_emit_semantic_type_parameters(b, params)
        mcp_write(b, ",\"items\":") mcp_write_i(b, items)
        mcp_write(b, "}")
      }
      SemanticTypeDeclarationOther(name) -> { mcp_write(b, "{\"kind\":\"other\",\"name\":") mcp_write_json_str(b, name) mcp_write(b, "}") }
    }
    SemanticFactEffectDeclaration(declaration) -> match declaration {
      SemanticEffectDeclaration(name, params, operations) -> {
        mcp_write(b, "{\"kind\":\"effect_declaration\",\"name\":") mcp_write_json_str(b, name)
        mcp_write(b, ",\"type_parameters\":") mcp_emit_semantic_type_parameters(b, params)
        mcp_write(b, ",\"operations\":") mcp_emit_semantic_effect_operations(b, operations)
        mcp_write(b, "}")
      }
      SemanticEffectDeclarationOther(name) -> { mcp_write(b, "{\"kind\":\"other\",\"name\":") mcp_write_json_str(b, name) mcp_write(b, "}") }
    }
    SemanticFactSymbol(symbol) -> match symbol {
      SemanticSymbol(name, kind, ty, occurrence, definition) -> {
        mcp_write(b, "{\"kind\":\"symbol\",\"name\":") mcp_write_json_str(b, name)
        mcp_write(b, ",\"symbol_kind\":") mcp_emit_semantic_symbol_kind(b, kind)
        mcp_write(b, ",\"type\":") mcp_emit_semantic_type(b, ty)
        mcp_write(b, ",\"occurrence\":") mcp_emit_semantic_source_location(b, occurrence)
        mcp_write(b, ",\"definition\":") mcp_emit_semantic_source_location(b, definition)
        mcp_write(b, "}")
      }
      SemanticSymbolOther(name) -> { mcp_write(b, "{\"kind\":\"other\",\"name\":") mcp_write_json_str(b, name) mcp_write(b, "}") }
    }
    SemanticFactEffectAtomUse(use_fact) -> match use_fact {
      SemanticEffectAtomUse(atom, occurrence, definition) -> {
        mcp_write(b, "{\"kind\":\"effect_atom_use\",\"atom\":") mcp_emit_semantic_effect_atom(b, atom)
        mcp_write(b, ",\"occurrence\":") mcp_emit_semantic_source_location(b, occurrence)
        mcp_write(b, ",\"definition\":") mcp_emit_semantic_source_location(b, definition)
        mcp_write(b, "}")
      }
      SemanticEffectAtomUseOther(name) -> { mcp_write(b, "{\"kind\":\"other\",\"name\":") mcp_write_json_str(b, name) mcp_write(b, "}") }
    }
    SemanticFactEffectOperationUse(use_fact) -> match use_fact {
      SemanticEffectOperationUse(atom, name, ty, occurrence, definition) -> {
        mcp_write(b, "{\"kind\":\"effect_operation_use\",\"atom\":") mcp_emit_semantic_effect_atom(b, atom)
        mcp_write(b, ",\"name\":") mcp_write_json_str(b, name)
        mcp_write(b, ",\"type\":") mcp_emit_semantic_type(b, ty)
        mcp_write(b, ",\"occurrence\":") mcp_emit_semantic_source_location(b, occurrence)
        mcp_write(b, ",\"definition\":") mcp_emit_semantic_source_location(b, definition)
        mcp_write(b, "}")
      }
      SemanticEffectOperationUseOther(name) -> { mcp_write(b, "{\"kind\":\"other\",\"name\":") mcp_write_json_str(b, name) mcp_write(b, "}") }
    }
    SemanticFactAssociatedTypeUse(use_fact) -> match use_fact {
      SemanticAssociatedTypeUse(base, name, resolved, occurrence, definition) -> {
        mcp_write(b, "{\"kind\":\"associated_type_use\",\"base\":") mcp_emit_semantic_type(b, base)
        mcp_write(b, ",\"name\":") mcp_write_json_str(b, name)
        mcp_write(b, ",\"resolved_type\":") mcp_emit_semantic_type(b, resolved)
        mcp_write(b, ",\"occurrence\":") mcp_emit_semantic_source_location(b, occurrence)
        mcp_write(b, ",\"definition\":") mcp_emit_semantic_source_location(b, definition)
        mcp_write(b, "}")
      }
      SemanticAssociatedTypeUseOther(name) -> { mcp_write(b, "{\"kind\":\"other\",\"name\":") mcp_write_json_str(b, name) mcp_write(b, "}") }
    }
    SemanticFactMatchArm(arm) -> match arm {
      SemanticMatchArm(narrowed, residual, guarded, occurrence) -> {
        mcp_write(b, "{\"kind\":\"match_arm\",\"narrowed_type\":") mcp_emit_semantic_type(b, narrowed)
        mcp_write(b, ",\"residual_type\":") mcp_emit_semantic_type(b, residual)
        mcp_write(b, ",\"guarded\":") mcp_write_bool(b, guarded)
        mcp_write(b, ",\"occurrence\":") mcp_emit_semantic_source_location(b, occurrence)
        mcp_write(b, "}")
      }
      SemanticMatchArmOther(name) -> { mcp_write(b, "{\"kind\":\"other\",\"name\":") mcp_write_json_str(b, name) mcp_write(b, "}") }
    }
    SemanticFactConformance(conformance) -> match conformance {
      SemanticConformance(ty, trait_name, decision) -> {
        mcp_write(b, "{\"kind\":\"conformance\",\"type\":") mcp_emit_semantic_type(b, ty)
        mcp_write(b, ",\"trait\":") mcp_write_json_str(b, trait_name)
        mcp_write(b, ",\"decision\":")
        match decision {
          SemanticConformanceYes -> mcp_write(b, "\"yes\"")
          SemanticConformanceNo -> mcp_write(b, "\"no\"")
          SemanticConformanceUnknown(reason) -> { mcp_write(b, "{\"kind\":\"unknown\",\"reason\":") mcp_write_json_str(b, reason) mcp_write(b, "}") }
          SemanticConformanceDecisionOther(name) -> { mcp_write(b, "{\"kind\":\"other\",\"name\":") mcp_write_json_str(b, name) mcp_write(b, "}") }
        }
        mcp_write(b, "}")
      }
      SemanticConformanceOther(name) -> { mcp_write(b, "{\"kind\":\"other\",\"name\":") mcp_write_json_str(b, name) mcp_write(b, "}") }
    }
    SemanticFactOther(name) -> { mcp_write(b, "{\"kind\":\"other\",\"name\":") mcp_write_json_str(b, name) mcp_write(b, "}") }
  }
}

fn mcp_semantic_envelope_found(envelope: SemanticFactEnvelope) -> bool {
  match envelope {
    SemanticFactEnvelope(version, SemanticFactFound(fact)) -> true
    _ -> false
  }
}

fn mcp_emit_semantic_lookup(b: i64, tool: str, name_ptr: i64, name_n: i64, envelope: SemanticFactEnvelope) -> i64 {
  mcp_begin_result(b, tool)
  mcp_write(b, ",\"name\":")
  mcp_write_json_bytes(b, name_ptr, name_n)
  match envelope {
    SemanticFactEnvelope(version, SemanticFactFound(fact)) -> {
      mcp_write(b, ",\"found\":true,\"fact\":")
      mcp_emit_semantic_fact(b, fact)
    }
    SemanticFactEnvelope(version, SemanticFactMissing) -> mcp_write(b, ",\"found\":false")
    SemanticFactEnvelope(version, SemanticFactResultOther(name)) -> { mcp_write(b, ",\"found\":false,\"other\":") mcp_write_json_str(b, name) }
    SemanticFactEnvelopeOther(name) -> { mcp_write(b, ",\"found\":false,\"other\":") mcp_write_json_str(b, name) }
  }
  mcp_end_result(b)
}

fn mcp_emit_type_lookup(b: i64, session: ProjectSession, src: i64, n: i64, name_ptr: i64, name_n: i64) -[SourceAcquire]> i64 {
  let typed = mcp_project_checked_source(session, src, n)
  let name = runtime_str_from_bytes_copy(name_ptr, name_n)
  match typed {
    TypedModule(fns, checked_src, tt) -> {
      let entry = semantic_fact_resolve_function_entry(tt, checked_src, name)
      let ownership = semantic_fact_ownership_from_borrow_summary(pipeline_ir_semantic_borrow_summary_for_entry(fns, tt, entry))
      let function = semantic_fact_function_entry_with_ownership(tt, entry, ownership)
      let fact = if mcp_semantic_envelope_found(function) { function } else { semantic_fact_query_type(tt, checked_src, name) }
      mcp_emit_semantic_lookup(b, "type_lookup", name_ptr, name_n, fact)
    }
  }
}

fn mcp_emit_effect_lookup(b: i64, session: ProjectSession, src: i64, n: i64, name_ptr: i64, name_n: i64) -[SourceAcquire]> i64 {
  let typed = mcp_project_checked_source(session, src, n)
  let name = runtime_str_from_bytes_copy(name_ptr, name_n)
  mcp_emit_semantic_lookup(b, "effect_lookup", name_ptr, name_n, semantic_fact_query_effect(mcp_typed_module_tt(typed), mcp_typed_module_src(typed), name))
}

fn mcp_emit_semantic_position_lookup(b: i64, tool: str, offset: i64, envelope: SemanticFactEnvelope) -> i64 {
  mcp_begin_result(b, tool)
  mcp_write(b, ",\"offset\":")
  mcp_write_i(b, offset)
  match envelope {
    SemanticFactEnvelope(version, SemanticFactFound(fact)) -> {
      mcp_write(b, ",\"found\":true,\"fact\":")
      mcp_emit_semantic_fact(b, fact)
    }
    SemanticFactEnvelope(version, SemanticFactMissing) -> mcp_write(b, ",\"found\":false")
    SemanticFactEnvelope(version, SemanticFactResultOther(name)) -> { mcp_write(b, ",\"found\":false,\"other\":") mcp_write_json_str(b, name) }
    SemanticFactEnvelopeOther(name) -> { mcp_write(b, ",\"found\":false,\"other\":") mcp_write_json_str(b, name) }
  }
  mcp_end_result(b)
}

fn mcp_emit_fact_at_position(b: i64, session: ProjectSession, src: i64, n: i64, offset: i64) -[SourceAcquire]> i64 {
  let typed = mcp_project_checked_source(session, src, n)
  mcp_emit_semantic_position_lookup(
    b,
    "fact_at_position",
    offset,
    semantic_fact_query_cursor_position(mcp_typed_module_tt(typed), mcp_typed_module_src(typed), offset)
  )
}

fn mcp_emit_semantic_bindings(b: i64, bindings: SemanticBindingFactList) -> i64 {
  mcp_write(b, "[")
  let mut current = bindings
  let mut first = true
  let mut done = false
  while not done {
    match current {
      SemanticBindingFactListNil -> { done = true }
      SemanticBindingFactListCons(binding, rest) -> {
        if not first { mcp_write(b, ",") } else { first = false }
        match binding {
          SemanticBinding(name, kind, ty) -> {
            mcp_write(b, "{\"name\":") mcp_write_json_str(b, name)
            mcp_write(b, ",\"symbol_kind\":") mcp_emit_semantic_symbol_kind(b, kind)
            mcp_write(b, ",\"type\":") mcp_emit_semantic_type(b, ty)
            mcp_write(b, "}")
          }
          SemanticBindingOther(name) -> { mcp_write(b, "{\"kind\":\"other\",\"name\":") mcp_write_json_str(b, name) mcp_write(b, "}") }
        }
        current = rest
      }
      SemanticBindingFactListOther(name) -> {
        if not first { mcp_write(b, ",") } else { 0 }
        mcp_write(b, "{\"kind\":\"other\",\"name\":") mcp_write_json_str(b, name) mcp_write(b, "}")
        done = true
      }
    }
  }
  mcp_write(b, "]")
}

fn mcp_emit_visible_bindings(b: i64, session: ProjectSession, src: i64, n: i64, offset: i64) -[SourceAcquire]> i64 {
  let typed = mcp_project_checked_source(session, src, n)
  mcp_begin_result(b, "visible_bindings")
  mcp_write(b, ",\"offset\":") mcp_write_i(b, offset)
  mcp_write(b, ",\"bindings\":")
  mcp_emit_semantic_bindings(b, semantic_fact_visible_bindings(mcp_typed_module_tt(typed), mcp_typed_module_src(typed), offset))
  mcp_end_result(b)
}

fn mcp_emit_conformance_at_position(b: i64, session: ProjectSession, src: i64, n: i64, offset: i64, trait_ptr: i64, trait_n: i64) -[SourceAcquire]> i64 {
  let typed = mcp_project_checked_source(session, src, n)
  let trait_name = runtime_str_from_bytes_copy(trait_ptr, trait_n)
  mcp_emit_semantic_position_lookup(
    b,
    "conformance_at_position",
    offset,
    semantic_fact_query_conformance_at(mcp_typed_module_tt(typed), mcp_typed_module_src(typed), offset, trait_name)
  )
}

fn mcp_dispatch_position_tool(b: i64, req: i64, n: i64, root: i64, src: i64, src_n: i64, tool_id: i64, session: ProjectSession) -[SourceAcquire]> i64 {
  let missing = 0 - 9223372036854775807
  let offset = mcp_extract_argument_int(req, n, root, "offset", missing)
  if offset == missing { mcp_emit_error(b, 0 - 32602, "missing position offset") }
  else { if offset < 0 or offset > src_n { mcp_emit_error(b, 0 - 32602, "position offset out of range") }
  else {
    match tool_id {
      11 -> mcp_emit_fact_at_position(b, session, src, src_n, offset)
      12 -> mcp_emit_visible_bindings(b, session, src, src_n, offset)
      13 -> {
        let trait_pair = mcp_extract_argument_string(req, n, root, "trait")
        let trait_ptr = mem_load64_at(trait_pair, 0)
        let trait_n = mem_load64_at(trait_pair, 8)
        if trait_ptr == 0 { mcp_emit_error(b, 0 - 32602, "missing trait name") }
        else { mcp_emit_conformance_at_position(b, session, src, src_n, offset, trait_ptr, trait_n) }
      }
      _ -> mcp_emit_error(b, 0 - 32601, "unknown tool")
    }
  } }
}

fn mcp_dispatch_lookup_tool(b: i64, req: i64, n: i64, root: i64, src: i64, src_n: i64, tool_id: i64, session: ProjectSession) -[SourceAcquire]> i64 {
  let name_pair = mcp_extract_lookup_name(req, n, root)
  let name_ptr = mem_load64_at(name_pair, 0)
  let name_n = mem_load64_at(name_pair, 8)
  if name_ptr == 0 {
    mcp_emit_error(b, 0 - 32602, "missing lookup name")
  } else {
    match tool_id {
      4 -> mcp_emit_type_lookup(b, session, src, src_n, name_ptr, name_n)
      5 -> mcp_emit_effect_lookup(b, session, src, src_n, name_ptr, name_n)
      _ -> mcp_emit_error(b, 0 - 32601, "unknown tool")
    }
  }
}

fn mcp_dispatch_known_tool(b: i64, req: i64, n: i64, root: i64, tool_id: i64, session: ProjectSession) -[SourceAcquire]> i64 {
  let pair = mcp_extract_source(req, n, root)
  let src = mem_load64_at(pair, 0)
  let src_n = mem_load64_at(pair, 8)
  if src == 0 {
    mcp_emit_error(b, 0 - 32602, "missing source")
  } else {
    match tool_id {
      1 -> mcp_emit_parse_summary(b, session, src, src_n)
      2 -> mcp_emit_check_summary(b, session, src, src_n)
      3 -> mcp_emit_ir_summary(b, session, src, src_n)
      4 -> mcp_dispatch_lookup_tool(b, req, n, root, src, src_n, tool_id, session)
      5 -> mcp_dispatch_lookup_tool(b, req, n, root, src, src_n, tool_id, session)
      6 -> mcp_emit_diagnostics(b, session, src, src_n)
      7 -> mcp_dispatch_grammar_tool(b, req, n, root, src, src_n, tool_id)
      8 -> mcp_dispatch_grammar_tool(b, req, n, root, src, src_n, tool_id)
      9 -> mcp_dispatch_grammar_tool(b, req, n, root, src, src_n, tool_id)
      10 -> mcp_emit_opt_counters(b, src, src_n)
      11 -> mcp_dispatch_position_tool(b, req, n, root, src, src_n, tool_id, session)
      12 -> mcp_dispatch_position_tool(b, req, n, root, src, src_n, tool_id, session)
      13 -> mcp_dispatch_position_tool(b, req, n, root, src, src_n, tool_id, session)
      14 -> mcp_emit_format_source(b, src, src_n)
      _ -> mcp_emit_error(b, 0 - 32601, "unknown tool")
    }
  }
}

fn mcp_dispatch_tool(b: i64, req: i64, n: i64, root: i64, session: ProjectSession) -[SourceAcquire]> i64 {
  let params = mcp_json_object_field_start(req, n, root, "params")
  let name_value = mcp_json_field_value_start(req, n, params, "name")
  if name_value < 0 {
    mcp_emit_error(b, 0 - 32602, "missing tool name")
  } else {
    if mcp_json_string_value_eq(req, n, name_value, "parse_summary") == 1 {
      mcp_dispatch_known_tool(b, req, n, root, 1, session)
    } else { if mcp_json_string_value_eq(req, n, name_value, "check_summary") == 1 {
      mcp_dispatch_known_tool(b, req, n, root, 2, session)
    } else { if mcp_json_string_value_eq(req, n, name_value, "ir_summary") == 1 {
      mcp_dispatch_known_tool(b, req, n, root, 3, session)
    } else { if mcp_json_string_value_eq(req, n, name_value, "type_lookup") == 1 {
      mcp_dispatch_known_tool(b, req, n, root, 4, session)
    } else { if mcp_json_string_value_eq(req, n, name_value, "effect_lookup") == 1 {
      mcp_dispatch_known_tool(b, req, n, root, 5, session)
    } else { if mcp_json_string_value_eq(req, n, name_value, "diagnostics") == 1 {
      mcp_dispatch_known_tool(b, req, n, root, 6, session)
    } else { if mcp_json_string_value_eq(req, n, name_value, "grammar_parse") == 1 {
      mcp_dispatch_known_tool(b, req, n, root, 7, session)
    } else { if mcp_json_string_value_eq(req, n, name_value, "grammar_check") == 1 {
      mcp_dispatch_known_tool(b, req, n, root, 8, session)
    } else { if mcp_json_string_value_eq(req, n, name_value, "grammar_diagnostics") == 1 {
      mcp_dispatch_known_tool(b, req, n, root, 9, session)
    } else { if mcp_json_string_value_eq(req, n, name_value, "opt_counters") == 1 {
      mcp_dispatch_known_tool(b, req, n, root, 10, session)
    } else { if mcp_json_string_value_eq(req, n, name_value, "fact_at_position") == 1 {
      mcp_dispatch_known_tool(b, req, n, root, 11, session)
    } else { if mcp_json_string_value_eq(req, n, name_value, "visible_bindings") == 1 {
      mcp_dispatch_known_tool(b, req, n, root, 12, session)
    } else { if mcp_json_string_value_eq(req, n, name_value, "conformance_at_position") == 1 {
      mcp_dispatch_known_tool(b, req, n, root, 13, session)
    } else { if mcp_json_string_value_eq(req, n, name_value, "format_source") == 1 {
      mcp_dispatch_known_tool(b, req, n, root, 14, session)
    } else {
      mcp_emit_error(b, 0 - 32601, "unknown tool")
    } } } } } } } } } } } } } }
  }
}

-- Process one JSON-RPC request. Returns 0 when b holds a result
-- payload, otherwise the JSON-RPC error code (b holds the message).
fn mcp_process_request(b: i64, req: i64, n: i64, session: ProjectSession) -[SourceAcquire]> i64 {
  let root = mcp_json_root_object_start(req, n)
  if root < 0 {
    mcp_emit_error(b, 0 - 32700, "invalid json-rpc")
  } else {
    let jsonrpc = mcp_json_field_value_start(req, n, root, "jsonrpc")
    let method = mcp_json_field_value_start(req, n, root, "method")
    if mcp_json_string_value_eq(req, n, jsonrpc, "2.0") == 0 {
      mcp_emit_error(b, 0 - 32600, "invalid request")
    } else { if method < 0 {
      mcp_emit_error(b, 0 - 32600, "invalid request")
    } else { if mcp_json_string_value_eq(req, n, method, "tools/list") == 1 {
      mcp_emit_tools_list(b)
    } else { if mcp_json_string_value_eq(req, n, method, "tools/call") == 1 {
      mcp_dispatch_tool(b, req, n, root, session)
    } else {
      mcp_emit_error(b, 0 - 32601, "unknown method")
    } } } }
  }
}

-- Legacy one-shot pipe: single request on stdin, raw JSON-RPC response
-- on stdout with the historical fixed id envelope. Scripts and the tool
-- boundary snapshots depend on this exact wire format.
fn run_mcp() -[SourceAcquire]> i64 {
  let input = read_stdin_all()
  let req = mem_load64_at(input, 0)
  let n = mem_load64_at(input, 8)
  let b = buf_new(65536)
  let code = mcp_process_request(b, req, n, project_session_new(1))
  if code == 0 {
    oprint("{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":")
    sys_write(1, buf_ptr(b), buf_len(b))
    oprint("}")
  } else {
    oprint("{\"jsonrpc\":\"2.0\",\"id\":")
    if code == 0 - 32700 { oprint("null") } else { oprint("1") }
    oprint(",\"error\":{\"code\":")
    oprint_i(code)
    oprint(",\"message\":\"")
    sys_write(1, buf_ptr(b), buf_len(b))
    oprint("\"}}")
  }
  0
}

-- ======================================================================
-- weft mcp serve — persistent stdio MCP server. Newline-delimited
-- JSON-RPC with the initialize handshake, request-id echo, tools/list
-- with input schemas, and tools/call results wrapped as MCP content.
-- The bare `weft mcp` form stays the one-shot raw pipe above.
-- ======================================================================

fn mcp_buf_append_bytes(out: i64, ptr: i64, len: i64) -> i64 {
  let mut i = 0
  while i < len {
    bu8(out, mem_load8_at(ptr, i))
    i = i + 1
  }
  0
}

-- JSON-string-escape payload bytes into out (quotes not included).
fn mcp_buf_append_escaped(out: i64, ptr: i64, len: i64) -> i64 {
  let mut i = 0
  while i < len {
    let ch = mem_load8_at(ptr, i)
    if ch == 34 { bstr(out, "\\\"") }
    else { if ch == 92 { bstr(out, "\\\\") }
    else { if ch == 10 { bstr(out, "\\n") }
    else { if ch == 13 { bstr(out, "\\r") }
    else { if ch == 9 { bstr(out, "\\t") }
    else { if ch >= 32 { bu8(out, ch) } else { 0 } } } } } }
    i = i + 1
  }
  0
}

-- Appends bytes until newline or EOF. Returns 1 when a line is
-- available (possibly empty), 0 on EOF with nothing buffered.
fn mcp_serve_read_line(b: i64, scratch: i64) -> i64 {
  let mut done = 0
  let mut got = 0
  while done == 0 {
    let r = sys_read(0, scratch, 1)
    if r <= 0 {
      done = 1
      if buf_len(b) > 0 { got = 1 } else { 0 }
    } else {
      let ch = mem_load8_at(scratch, 0)
      if ch == 10 {
        done = 1
        got = 1
      } else { bu8(b, ch) }
    }
  }
  got
}

-- Raw byte span [start, end) of the request id value, or 0 when the
-- request carries no id (a notification — never answered).
fn mcp_request_id_span(req: i64, n: i64, root: i64) -> i64 {
  let start = mcp_json_field_value_start(req, n, root, "id")
  if start < 0 { 0 }
  else {
    let end_r = mcp_json_parse_value(req, n, start)
    if mcp_json_result_ok(end_r) == 0 { 0 }
    else {
      let pair = main_alloc_bytes(16)
      mem_store64_at(pair, 0, start)
      mem_store64_at(pair, 8, mcp_json_result_pos(end_r))
      pair
    }
  }
}

fn mcp_serve_write_response(out: i64) -> i64 {
  bstr(out, "\n")
  sys_write(1, buf_ptr(out), buf_len(out))
  0
}

-- Emit one framed response: result payload (code == 0) or JSON-RPC
-- error (code != 0, payload holds the message). id_span 0 → id null
-- (only used for parse errors; notifications never reach here).
fn mcp_serve_respond(req: i64, payload: i64, code: i64, id_span: i64, wrap_content: i64) -> i64 {
  let out = buf_new(buf_len(payload) + 512)
  bstr(out, "{\"jsonrpc\":\"2.0\",\"id\":")
  if id_span == 0 { bstr(out, "null") }
  else {
    let ids = mem_load64_at(id_span, 0)
    let ide = mem_load64_at(id_span, 8)
    mcp_buf_append_bytes(out, req + ids, ide - ids)
  }
  if code == 0 {
    if wrap_content == 1 {
      bstr(out, ",\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"")
      mcp_buf_append_escaped(out, buf_ptr(payload), buf_len(payload))
      bstr(out, "\"}],\"isError\":false}}")
    } else {
      bstr(out, ",\"result\":")
      mcp_buf_append_bytes(out, buf_ptr(payload), buf_len(payload))
      bstr(out, "}")
    }
  } else {
    bstr(out, ",\"error\":{\"code\":")
    lsp_buf_append_i(out, code)
    bstr(out, ",\"message\":\"")
    mcp_buf_append_escaped(out, buf_ptr(payload), buf_len(payload))
    bstr(out, "\"}}")
  }
  mcp_serve_write_response(out)
}

fn mcp_serve_initialize_payload(b: i64, req: i64, n: i64, root: i64) -> i64 {
  bstr(b, "{\"protocolVersion\":")
  let params = mcp_json_object_field_start(req, n, root, "params")
  let ver = mcp_json_field_value_start(req, n, params, "protocolVersion")
  let echoed = if ver >= 0 {
    let end_r = mcp_json_parse_string(req, n, ver)
    if mcp_json_result_ok(end_r) == 1 {
      mcp_buf_append_bytes(b, req + ver, mcp_json_result_pos(end_r) - ver)
      1
    } else { 0 }
  } else { 0 }
  if echoed == 0 { bstr(b, "\"2025-06-18\"") } else { 0 }
  bstr(b, ",\"capabilities\":{\"tools\":{}},\"serverInfo\":{\"name\":\"weft\",\"version\":\"")
  bstr(b, weft_compiler_version())
  bstr(b, "\"}}")
  0
}

fn mcp_serve_tools_list_payload(b: i64) -> i64 {
  bstr(b, "{\"tools\":[")
  bstr(b, "{\"name\":\"parse_summary\",\"x-weft-stability\":\"internal\",\"description\":\"Parse Weft source and report function count and first body expression tag.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"source\":{\"type\":\"string\",\"description\":\"Weft source text\"}},\"required\":[\"source\"]}},")
  bstr(b, "{\"name\":\"check_summary\",\"x-weft-stability\":\"internal\",\"description\":\"Parse and type-check Weft source; report function count and first body tag.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"source\":{\"type\":\"string\",\"description\":\"Weft source text\"}},\"required\":[\"source\"]}},")
  bstr(b, "{\"name\":\"ir_summary\",\"x-weft-stability\":\"internal\",\"description\":\"Lower Weft source to typed IR; report function, block, and instruction counts.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"source\":{\"type\":\"string\",\"description\":\"Weft source text\"}},\"required\":[\"source\"]}},")
  bstr(b, "{\"name\":\"type_lookup\",\"x-weft-stability\":\"stable\",\"description\":\"Look up a semantic function or type-declaration fact by visible name, including optimizer-produced return provenance.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"source\":{\"type\":\"string\",\"description\":\"Weft source text\"},\"name\":{\"type\":\"string\",\"description\":\"Visible function, type, or trait name\"}},\"required\":[\"source\",\"name\"]}},")
  bstr(b, "{\"name\":\"effect_lookup\",\"x-weft-stability\":\"stable\",\"description\":\"Look up a checker-produced effect declaration and operation-signature fact by visible name.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"source\":{\"type\":\"string\",\"description\":\"Weft source text\"},\"name\":{\"type\":\"string\",\"description\":\"Visible effect name\"}},\"required\":[\"source\",\"name\"]}},")
  bstr(b, "{\"name\":\"diagnostics\",\"x-weft-stability\":\"stable\",\"description\":\"Parse and type-check Weft source; report all diagnostics with line and column.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"source\":{\"type\":\"string\",\"description\":\"Weft source text\"}},\"required\":[\"source\"]}},")
  bstr(b, "{\"name\":\"grammar_parse\",\"x-weft-stability\":\"internal\",\"description\":\"Parse source with an embedded grammar module (e.g. mini_sql).\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"grammar\":{\"type\":\"string\",\"description\":\"Grammar module name\"},\"source\":{\"type\":\"string\",\"description\":\"Source text in the embedded language\"}},\"required\":[\"grammar\",\"source\"]}},")
  bstr(b, "{\"name\":\"grammar_check\",\"x-weft-stability\":\"internal\",\"description\":\"Parse and check source with an embedded grammar module, optionally against host Weft types.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"grammar\":{\"type\":\"string\",\"description\":\"Grammar module name\"},\"source\":{\"type\":\"string\",\"description\":\"Source text in the embedded language\"},\"host_source\":{\"type\":\"string\",\"description\":\"Optional host Weft source providing table types\"}},\"required\":[\"grammar\",\"source\"]}},")
  bstr(b, "{\"name\":\"grammar_diagnostics\",\"x-weft-stability\":\"stable\",\"description\":\"Report embedded-grammar diagnostics with line and column, optionally against host Weft types.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"grammar\":{\"type\":\"string\",\"description\":\"Grammar module name\"},\"source\":{\"type\":\"string\",\"description\":\"Source text in the embedded language\"},\"host_source\":{\"type\":\"string\",\"description\":\"Optional host Weft source providing table types\"}},\"required\":[\"grammar\",\"source\"]}},")
  bstr(b, "{\"name\":\"opt_counters\",\"x-weft-stability\":\"internal\",\"description\":\"Compile Weft source through the optimiser and report per-pass site counters and native emission counters.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"source\":{\"type\":\"string\",\"description\":\"Weft source text\"}},\"required\":[\"source\"]}},")
  bstr(b, "{\"name\":\"fact_at_position\",\"x-weft-stability\":\"stable\",\"description\":\"Return the checker-produced semantic fact at a UTF-8 byte offset.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"source\":{\"type\":\"string\",\"description\":\"Weft source text\"},\"offset\":{\"type\":\"integer\",\"minimum\":0,\"description\":\"UTF-8 byte offset\"}},\"required\":[\"source\",\"offset\"]}},")
  bstr(b, "{\"name\":\"visible_bindings\",\"x-weft-stability\":\"stable\",\"description\":\"List checker-resolved typed bindings visible at a UTF-8 byte offset.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"source\":{\"type\":\"string\",\"description\":\"Weft source text\"},\"offset\":{\"type\":\"integer\",\"minimum\":0,\"description\":\"UTF-8 byte offset\"}},\"required\":[\"source\",\"offset\"]}},")
  bstr(b, "{\"name\":\"conformance_at_position\",\"x-weft-stability\":\"stable\",\"description\":\"Ask the checker whether the value type at a UTF-8 byte offset satisfies a visible trait.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"source\":{\"type\":\"string\",\"description\":\"Weft source text\"},\"offset\":{\"type\":\"integer\",\"minimum\":0,\"description\":\"UTF-8 byte offset\"},\"trait\":{\"type\":\"string\",\"description\":\"Visible trait name\"}},\"required\":[\"source\",\"offset\",\"trait\"]}},")
  bstr(b, "{\"name\":\"format_source\",\"x-weft-stability\":\"stable\",\"description\":\"Format Weft source with the lossless parse-only formatter.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"source\":{\"type\":\"string\",\"description\":\"Weft source text\"}},\"required\":[\"source\"]}}")
  bstr(b, "]}")
  0
}

fn mcp_serve_handle_line(req: i64, n: i64, session: ProjectSession) -[SourceAcquire]> i64 {
  let root = mcp_json_root_object_start(req, n)
  if root < 0 {
    let msg = buf_new(64)
    bstr(msg, "parse error")
    mcp_serve_respond(req, msg, 0 - 32700, 0, 0)
  } else {
    let id_span = mcp_request_id_span(req, n, root)
    let method = mcp_json_field_value_start(req, n, root, "method")
    if id_span == 0 {
      -- Notification (initialized, cancelled, ...): no response.
      0
    } else { if method < 0 {
      let msg = buf_new(64)
      bstr(msg, "invalid request")
      mcp_serve_respond(req, msg, 0 - 32600, id_span, 0)
    } else { if mcp_json_string_value_eq(req, n, method, "initialize") == 1 {
      let b = buf_new(512)
      mcp_serve_initialize_payload(b, req, n, root)
      mcp_serve_respond(req, b, 0, id_span, 0)
    } else { if mcp_json_string_value_eq(req, n, method, "ping") == 1 {
      let b = buf_new(8)
      bstr(b, "{}")
      mcp_serve_respond(req, b, 0, id_span, 0)
    } else { if mcp_json_string_value_eq(req, n, method, "tools/list") == 1 {
      let b = buf_new(4096)
      mcp_serve_tools_list_payload(b)
      mcp_serve_respond(req, b, 0, id_span, 0)
    } else { if mcp_json_string_value_eq(req, n, method, "tools/call") == 1 {
      let b = buf_new(65536)
      let code = mcp_dispatch_tool(b, req, n, root, session)
      mcp_serve_respond(req, b, code, id_span, 1)
    } else {
      let msg = buf_new(64)
      bstr(msg, "method not found")
      mcp_serve_respond(req, msg, 0 - 32601, id_span, 0)
    } } } } } }
  }
}

fn run_mcp_serve() -[SourceAcquire]> i64 {
  let scratch = main_alloc_bytes(8)
  let session = project_session_new(1)
  let mut running = 1
  while running == 1 {
    let line = buf_new(4096)
    if mcp_serve_read_line(line, scratch) == 0 {
      running = 0
    } else {
      if buf_len(line) > 0 {
        mcp_serve_handle_line(buf_ptr(line), buf_len(line), session)
      } else { 0 }
    }
  }
  0
}

-- ======================================================================
-- Tool: lsp — stateless-ish stdio language server
-- ======================================================================

fn lsp_buf_append_i(b: i64, n: i64) -> i64 {
  if n < 0 {
    bstr(b, "-")
    lsp_buf_append_i(b, 0 - n)
  } else {
    if n < 10 {
      bu8(b, 48 + n)
    } else {
      lsp_buf_append_i(b, n / 10)
      bu8(b, 48 + n - n / 10 * 10)
    }
  }
  buf_len(b)
}

fn lsp_buf_append_json_bytes(b: i64, ptr: i64, n: i64) -> i64 {
  bstr(b, "\"")
  let mut i = 0
  while i < n {
    let ch = mem_load8_at(ptr, i)
    if ch == 34 {
      bstr(b, "\\\"")
    } else { if ch == 92 {
      bstr(b, "\\\\")
    } else { if ch == 10 {
      bstr(b, "\\n")
    } else { if ch == 13 {
      bstr(b, "\\r")
    } else { if ch == 9 {
      bstr(b, "\\t")
    } else {
      if ch >= 32 { bu8(b, ch) } else { 0 }
    } } } } }
    i = i + 1
  }
  bstr(b, "\"")
  buf_len(b)
}

fn lsp_write_body(body: i64) -> i64 {
  oprint("Content-Length: ")
  oprint_i(buf_len(body))
  let sep = main_alloc_bytes(4)
  mem_store8_at(sep, 0, 13)
  mem_store8_at(sep, 1, 10)
  mem_store8_at(sep, 2, 13)
  mem_store8_at(sep, 3, 10)
  sys_write(1, sep, 4)
  sys_write(1, buf_ptr(body), buf_len(body))
}

fn lsp_state_new() -> i64 {
  let st = main_alloc_bytes(72)
  mem_store64_at(st, 0, 0)
  mem_store64_at(st, 8, 0)
  mem_store64_at(st, 16, 0)
  mem_store64_at(st, 24, 0)
  mem_store64_at(st, 32, 0)
  -- Active documents are persistent session entries with the same first five
  -- words as the selected-document cache above. Workspace root is a physical
  -- path (without file://), explicit from initialize or inferred once from
  -- the first opened document.
  mem_store64_at(st + 40, 0, nlist_new())
  mem_store64_at(st + 48, 0, 0)
  mem_store64_at(st + 56, 0, 0)
  -- LSP 3.17 defaults to UTF-16 unless initialize negotiates another
  -- PositionEncodingKind.
  mem_store64_at(st + 64, 0, source_position_encoding_utf16())
  st
}

fn lsp_state_uri_ptr(st: i64) -> i64 { mem_load64_at(st, 0) }
fn lsp_state_uri_len(st: i64) -> i64 { mem_load64_at(st, 8) }
fn lsp_state_src_ptr(st: i64) -> i64 { mem_load64_at(st, 16) }
fn lsp_state_src_len(st: i64) -> i64 { mem_load64_at(st, 24) }
fn lsp_state_version(st: i64) -> i64 { mem_load64_at(st, 32) }
fn lsp_state_documents(st: i64) -> i64 { mem_load64_at(st + 40, 0) }
fn lsp_state_workspace_ptr(st: i64) -> i64 { mem_load64_at(st + 48, 0) }
fn lsp_state_workspace_len(st: i64) -> i64 { mem_load64_at(st + 56, 0) }
fn lsp_state_position_encoding(st: i64) -> i64 { mem_load64_at(st + 64, 0) }

fn lsp_state_set_position_encoding(st: i64, encoding: i64) -> i64 {
  mem_store64_at(st + 64, 0, encoding)
  0
}

fn lsp_state_find_doc(st: i64, uri_ptr: i64, uri_n: i64) -> i64 {
  let docs = lsp_state_documents(st)
  let mut i = 0
  let mut result = 0
  while i < nlist_len(docs) and result == 0 {
    let doc = nlist_get(docs, i)
    let doc_uri = mem_load64_at(doc, 0)
    let doc_uri_n = mem_load64_at(doc + 8, 0)
    if doc_uri != 0 and uri_ptr != 0 and mcp_name_bytes_eq(doc_uri, doc_uri_n, uri_ptr, uri_n) == 1 {
      result = doc
    } else { i = i + 1 }
  }
  result
}

fn lsp_state_select_doc(st: i64, doc: i64) -> i64 {
  if doc == 0 { 0 }
  else {
    for i in 0..5 { mem_store64_at(st + i * 8, 0, mem_load64_at(doc + i * 8, 0)) }
    1
  }
}

fn lsp_state_select_uri(st: i64, uri_ptr: i64, uri_n: i64) -> i64 {
  lsp_state_select_doc(st, lsp_state_find_doc(st, uri_ptr, uri_n))
}

fn lsp_state_set_workspace_uri(st: i64, uri_ptr: i64, uri_n: i64) -> i64 {
  if uri_ptr != 0 and uri_n >= 7 and src_eq_at(uri_ptr, 0, __str_ptr("file://"), 0, 7) == 1 {
    let path_ptr = uri_ptr + 7
    let mut path_len = uri_n - 7
    while path_len > 1 and mem_load8_at(path_ptr, path_len - 1) == 47 { path_len = path_len - 1 }
    mem_store64_at(st + 48, 0, path_ptr)
    mem_store64_at(st + 56, 0, path_len)
  } else { 0 }
  0
}

fn lsp_state_infer_workspace(st: i64, uri_ptr: i64, uri_n: i64) -> i64 {
  if lsp_state_workspace_len(st) == 0 and uri_ptr != 0 and uri_n > 7 and src_eq_at(uri_ptr, 0, __str_ptr("file://"), 0, 7) == 1 {
    let path_ptr = uri_ptr + 7
    let path_len = uri_n - 7
    let mut slash = path_len
    while slash > 1 and mem_load8_at(path_ptr, slash - 1) != 47 { slash = slash - 1 }
    let root_len = if slash > 1 { slash - 1 } else { 1 }
    mem_store64_at(st + 48, 0, path_ptr)
    mem_store64_at(st + 56, 0, root_len)
  } else { 0 }
  0
}

fn lsp_project_overlay_identity() -> str { "lsp://active-documents" }

fn lsp_project_physical_path(st: i64, uri_ptr: i64, uri_n: i64, root: bool) -> str {
  if uri_ptr == 0 or uri_n <= 7 or src_eq_at(uri_ptr, 0, __str_ptr("file://"), 0, 7) == 0 { "" }
  else {
    let path_ptr = uri_ptr + 7
    let path_len = uri_n - 7
    let workspace_ptr = lsp_state_workspace_ptr(st)
    let workspace_len = lsp_state_workspace_len(st)
    let under_workspace = not root and workspace_len > 0 and path_len > workspace_len and
      src_eq_at(path_ptr, 0, workspace_ptr, 0, workspace_len) == 1 and
      (workspace_len == 1 or mem_load8_at(path_ptr, workspace_len) == 47)
    let relative_start = if under_workspace { if workspace_len == 1 { 1 } else { workspace_len + 1 } } else { 0 }
    runtime_str_from_bytes_copy(path_ptr + relative_start, path_len - relative_start)
  }
}

fn lsp_project_context(st: i64, uri_ptr: i64, uri_n: i64, root: bool) -> ProjectQueryContext {
  project_query_context_with_overlay_set(
    0,
    runtime_str_from_bytes_copy(uri_ptr, uri_n),
    lsp_project_physical_path(st, uri_ptr, uri_n, root),
    project_source_origin_overlay(),
    0,
    1,
    lsp_project_overlay_identity()
  )
}

fn lsp_project_selected_context(st: i64) -> ProjectQueryContext {
  lsp_project_context(st, lsp_state_uri_ptr(st), lsp_state_uri_len(st), true)
}

fn lsp_project_content(update: IncrementalInputUpdate<ProjectSourceSnapshot>, fallback: str) -> str {
  match update {
    IncrementalInputInserted(ProjectSourcePresent(content)) -> content
    IncrementalInputChanged(ProjectSourcePresent(content)) -> content
    IncrementalInputUnchanged(ProjectSourcePresent(content)) -> content
    _ -> fallback
  }
}

fn lsp_project_sync_overlays(session: ProjectSession, st: i64) -> i64 {
  let overlays = project_overlay_set_new()
  let docs = lsp_state_documents(st)
  for i in 0..nlist_len(docs) {
    let doc = nlist_get(docs, i)
    let uri_ptr = mem_load64_at(doc, 0)
    let uri_n = mem_load64_at(doc + 8, 0)
    if uri_ptr != 0 and mem_load64_at(doc + 16, 0) != 0 {
      project_overlay_set_add(overlays, lsp_project_context(st, uri_ptr, uri_n, false))
    } else { 0 }
  }
  let index_context = project_query_context_with_overlay_set(
    0,
    "lsp://overlay-index",
    "",
    project_source_origin_overlay(),
    0,
    1,
    lsp_project_overlay_identity()
  )
  project_session_set_overlay_set(session, index_context, overlays)
  0
}

fn lsp_state_set_doc(session: ProjectSession, st: i64, uri_ptr: i64, uri_n: i64, src: i64, n: i64, version: i64) -> i64 {
  lsp_state_infer_workspace(st, uri_ptr, uri_n)
  let incoming = runtime_str_from_bytes_copy(src, n)
  let content = lsp_project_content(project_session_set_source(session, lsp_project_context(st, uri_ptr, uri_n, true), incoming), incoming)
  let existing = lsp_state_find_doc(st, uri_ptr, uri_n)
  let doc = if existing != 0 { existing }
    else {
      let created = main_alloc_bytes(40)
      nlist_add(lsp_state_documents(st), created)
      created
    }
  mem_store64_at(doc, 0, uri_ptr)
  mem_store64_at(doc + 8, 0, uri_n)
  mem_store64_at(doc + 16, 0, __str_ptr(content))
  mem_store64_at(doc + 24, 0, __str_len(content))
  mem_store64_at(doc + 32, 0, version)
  lsp_state_select_doc(st, doc)
  lsp_project_sync_overlays(session, st)
  0
}

fn lsp_state_uri_matches(st: i64, uri_ptr: i64, uri_n: i64) -> i64 {
  let cur_ptr = lsp_state_uri_ptr(st)
  let cur_n = lsp_state_uri_len(st)
  if cur_ptr == 0 { 0 }
  else { if uri_ptr == 0 { 1 }
  else { mcp_name_bytes_eq(cur_ptr, cur_n, uri_ptr, uri_n) } }
}

fn lsp_state_remove_doc(st: i64, doc: i64) -> i64 {
  if doc != 0 {
    mem_store64_at(doc, 0, 0)
    mem_store64_at(doc + 8, 0, 0)
    mem_store64_at(doc + 16, 0, 0)
    mem_store64_at(doc + 24, 0, 0)
    mem_store64_at(doc + 32, 0, 0)
  } else { 0 }
  0
}

fn lsp_state_file_path(st: i64) -> i64 {
  let pair = main_alloc_bytes(16)
  let uri = lsp_state_uri_ptr(st)
  let n = lsp_state_uri_len(st)
  if uri != 0 and n > 7 and src_eq_at(uri, 0, __str_ptr("file://"), 0, 7) == 1 {
    mem_store64_at(pair, 0, uri + 7)
    mem_store64_at(pair, 8, n - 7)
  } else {
    mem_store64_at(pair, 0, 0)
    mem_store64_at(pair, 8, 0)
  }
  pair
}

fn lsp_check_state_quiet(st: i64, session: ProjectSession) -[SourceAcquire]> TypedModule {
  match project_session_check_with_acquire(session, lsp_project_selected_context(st)) {
    ProjectCheckSucceeded(typed, source_n, parse_diagnostics, check_diagnostics) -> typed
    ProjectCheckFailed(typed, source_n, parse_diagnostics, check_diagnostics) -> typed
    -- Preserve the historical recovery surface if an incremental query cannot
    -- provide a typed module. This is deliberately an exceptional fallback;
    -- normal diagnostics and semantic requests all share the cached result.
    _ -> {
      let path = lsp_state_file_path(st)
      mcp_check_source_quiet_with_path_and_overlays(
        lsp_state_src_ptr(st),
        lsp_state_src_len(st),
        mem_load64_at(path, 0),
        mem_load64_at(path, 8),
        lsp_state_documents(st),
        lsp_state_workspace_ptr(st),
        lsp_state_workspace_len(st)
      )
    }
  }
}

fn lsp_json_int_at(src: i64, n: i64, pos: i64, default: i64) -> i64 {
  if pos < 0 or pos >= n { default }
  else {
    let mut p = pos
    let mut sign = 1
    if mem_load8_at(src, p) == 45 { sign = 0 - 1 p = p + 1 } else { 0 }
    let mut value = 0
    let mut seen = 0
    while p < n and is_digit(mem_load8_at(src, p)) == 1 {
      value = value * 10 + mem_load8_at(src, p) - 48
      seen = 1
      p = p + 1
    }
    if seen == 1 { value * sign } else { default }
  }
}

fn lsp_json_first_array_object_start(src: i64, n: i64, value_start: i64) -> i64 {
  if value_start < 0 or value_start >= n { 0 - 1 }
  else { if mem_load8_at(src, value_start) != 91 { 0 - 1 }
  else {
    let p = mcp_skip_json_ws(src, n, value_start + 1)
    if p < n and mem_load8_at(src, p) == 123 { p } else { 0 - 1 }
  } }
}

fn lsp_extract_params_object(req: i64, n: i64, root: i64) -> i64 {
  mcp_json_object_field_start(req, n, root, "params")
}

fn lsp_extract_initialize_root_uri(req: i64, n: i64, root: i64) -> i64 {
  let params = lsp_extract_params_object(req, n, root)
  let value = mcp_json_field_value_start(req, n, params, "rootUri")
  mcp_decode_json_string_pair(req, n, value)
}

fn lsp_json_array_contains_string(src: i64, n: i64, array_start: i64, expected: str) -> i64 {
  if array_start < 0 or array_start >= n or mem_load8_at(src, array_start) != 91 { 0 }
  else {
    let mut p = mcp_skip_json_ws(src, n, array_start + 1)
    let mut found = 0
    let mut done = 0
    while p < n and found == 0 and done == 0 {
      if mem_load8_at(src, p) == 93 { done = 1 }
      else { if mcp_json_string_value_eq(src, n, p, expected) == 1 { found = 1 }
      else {
        let value = mcp_json_parse_value(src, n, p)
        if mcp_json_result_ok(value) == 0 { done = 1 }
        else {
          p = mcp_skip_json_ws(src, n, mcp_json_result_pos(value))
          if p < n and mem_load8_at(src, p) == 44 { p = mcp_skip_json_ws(src, n, p + 1) }
          else { done = 1 }
        }
      } }
    }
    found
  }
}

fn lsp_extract_initialize_position_encoding(req: i64, n: i64, root: i64) -> i64 {
  let params = lsp_extract_params_object(req, n, root)
  let capabilities = mcp_json_object_field_start(req, n, params, "capabilities")
  let general = mcp_json_object_field_start(req, n, capabilities, "general")
  let encodings = mcp_json_field_value_start(req, n, general, "positionEncodings")
  if lsp_json_array_contains_string(req, n, encodings, "utf-8") == 1 { source_position_encoding_utf8() }
  else { if lsp_json_array_contains_string(req, n, encodings, "utf-16") == 1 { source_position_encoding_utf16() }
  else { if lsp_json_array_contains_string(req, n, encodings, "utf-32") == 1 { source_position_encoding_utf32() }
  else { source_position_encoding_utf16() } } }
}

fn lsp_extract_text_document_object(req: i64, n: i64, root: i64) -> i64 {
  let params = lsp_extract_params_object(req, n, root)
  mcp_json_object_field_start(req, n, params, "textDocument")
}

fn lsp_extract_text_document_string(req: i64, n: i64, root: i64, key: str) -> i64 {
  let doc = lsp_extract_text_document_object(req, n, root)
  let value = mcp_json_field_value_start(req, n, doc, key)
  mcp_decode_json_string_pair(req, n, value)
}

fn lsp_extract_text_document_version(req: i64, n: i64, root: i64, default: i64) -> i64 {
  let doc = lsp_extract_text_document_object(req, n, root)
  let value = mcp_json_field_value_start(req, n, doc, "version")
  lsp_json_int_at(req, n, value, default)
}

fn lsp_extract_position_line(req: i64, n: i64, root: i64) -> i64 {
  let params = lsp_extract_params_object(req, n, root)
  let pos = mcp_json_object_field_start(req, n, params, "position")
  lsp_json_int_at(req, n, mcp_json_field_value_start(req, n, pos, "line"), 0)
}

fn lsp_extract_position_character(req: i64, n: i64, root: i64) -> i64 {
  let params = lsp_extract_params_object(req, n, root)
  let pos = mcp_json_object_field_start(req, n, params, "position")
  lsp_json_int_at(req, n, mcp_json_field_value_start(req, n, pos, "character"), 0)
}

fn lsp_extract_change_text(req: i64, n: i64, root: i64) -> i64 {
  let params = lsp_extract_params_object(req, n, root)
  let changes = mcp_json_field_value_start(req, n, params, "contentChanges")
  let first = lsp_json_first_array_object_start(req, n, changes)
  let value = mcp_json_field_value_start(req, n, first, "text")
  mcp_decode_json_string_pair(req, n, value)
}

fn lsp_append_id_or_null(b: i64, req: i64, n: i64, root: i64) -> i64 {
  let id_start = mcp_json_field_value_start(req, n, root, "id")
  if id_start < 0 {
    bstr(b, "null")
  } else {
    let parsed = mcp_json_parse_value(req, n, id_start)
    if mcp_json_result_ok(parsed) == 0 { bstr(b, "null") }
    else { bscopy(b, req + id_start, mcp_json_result_pos(parsed) - id_start, 0) }
  }
  buf_len(b)
}

fn lsp_response_start(b: i64, req: i64, n: i64, root: i64) -> i64 {
  bstr(b, "{\"jsonrpc\":\"2.0\",\"id\":")
  lsp_append_id_or_null(b, req, n, root)
  bstr(b, ",\"result\":")
  buf_len(b)
}

fn lsp_emit_error_response(req: i64, n: i64, root: i64, code: i64, message: str) -> i64 {
  let body = buf_new(512)
  bstr(body, "{\"jsonrpc\":\"2.0\",\"id\":")
  if root < 0 { bstr(body, "null") } else { lsp_append_id_or_null(body, req, n, root) }
  bstr(body, ",\"error\":{\"code\":")
  lsp_buf_append_i(body, code)
  bstr(body, ",\"message\":")
  lsp_buf_append_json_bytes(body, __str_ptr(message), __str_len(message))
  bstr(body, "}}")
  lsp_write_body(body)
}

fn lsp_emit_null_response(req: i64, n: i64, root: i64) -> i64 {
  let body = buf_new(128)
  lsp_response_start(body, req, n, root)
  bstr(body, "null}")
  lsp_write_body(body)
}

fn lsp_span_line0(src: i64, n: i64, span: i64) -> i64 {
  let line = source_position_line0(source_position_at(src, n, span))
  if line < 0 { 0 } else { line }
}

fn lsp_span_col0(src: i64, n: i64, span: i64, encoding: i64) -> i64 {
  let col = source_position_column0(source_position_at(src, n, span), encoding)
  if col < 0 { 0 } else { col }
}

fn lsp_offset_for_line_col(src: i64, n: i64, line: i64, ch: i64, encoding: i64) -> i64 {
  let offset = source_position_offset_for_line_column(src, n, line, ch, encoding)
  if offset < 0 { 0 } else { offset }
}

fn lsp_buf_append_range(b: i64, src: i64, src_n: i64, start: i64, end_pos: i64, encoding: i64) -> i64 {
  let s = if start < 0 { 0 } else { start }
  let e = if end_pos <= s { source_position_next_scalar_offset(src, src_n, s) } else { end_pos }
  bstr(b, "{\"start\":{\"line\":")
  lsp_buf_append_i(b, lsp_span_line0(src, src_n, s))
  bstr(b, ",\"character\":")
  lsp_buf_append_i(b, lsp_span_col0(src, src_n, s, encoding))
  bstr(b, "},\"end\":{\"line\":")
  lsp_buf_append_i(b, lsp_span_line0(src, src_n, e))
  bstr(b, ",\"character\":")
  lsp_buf_append_i(b, lsp_span_col0(src, src_n, e, encoding))
  bstr(b, "}}")
  buf_len(b)
}

fn lsp_diag_span_belongs_to_source(st: i64, tt: i64, src: i64, span: i64) -> i64 {
  let source_entry = ttable_find_source_entry(tt, span)
  if source_entry == 0 { 1 }
  else {
    let owner_src = mem_load64_at(source_entry, 0)
    if owner_src == src { 1 }
    else {
      -- An imported diagnostic moves to that document when it is active. A
      -- closed/disk-only dependency has no publication channel of its own, so
      -- retain the historical root notification instead of dropping it.
      let docs = lsp_state_documents(st)
      let mut i = 0
      let mut owner_is_open = 0
      while i < nlist_len(docs) and owner_is_open == 0 {
        let doc = nlist_get(docs, i)
        if mem_load64_at(doc, 0) != 0 and mem_load64_at(doc + 16, 0) == owner_src { owner_is_open = 1 }
        else { i = i + 1 }
      }
      if owner_is_open == 1 { 0 } else { 1 }
    }
  }
}

fn lsp_collect_diagnostics_legacy(st: i64, items: i64, count: i64) -> i64 {
  let src = lsp_state_src_ptr(st)
  let n = lsp_state_src_len(st)
  let tt = ttable_new()
  main_mark_root_origin_with_grant(tt, src, 0, 1, 0)
  let path = lsp_state_file_path(st)
  main_register_source_path(tt, src, n, mem_load64_at(path, 0), mem_load64_at(path, 8))
  mcp_register_source_overlays(tt, lsp_state_documents(st), src, mem_load64_at(path, 0), mem_load64_at(path, 8), lsp_state_workspace_ptr(st), lsp_state_workspace_len(st))
  let grammar = weft_grammar()
  let encoding = lsp_state_position_encoding(st)
  let fns = handle grammar.parse(src, n, tt) {
    Diagnose.report(diagnostic) -> { lsp_diag_items_append_report(items, count, st, tt, src, n, diagnostic, encoding) resume(0) }
    Diagnose.error(msg, span) -> { lsp_diag_items_append_legacy(items, count, st, tt, src, n, 1, msg, span, encoding) resume(0) }
    Diagnose.warn(msg, span) -> { lsp_diag_items_append_legacy(items, count, st, tt, src, n, 2, msg, span, encoding) resume(0) }
    Diagnose.note(msg, span) -> { lsp_diag_items_append_legacy(items, count, st, tt, src, n, 3, msg, span, encoding) resume(0) }
  }
  handle grammar.check(fns, src, tt) {
    Diagnose.report(diagnostic) -> { lsp_diag_items_append_report(items, count, st, tt, src, n, diagnostic, encoding) resume(0) }
    Diagnose.error(msg, span) -> { lsp_diag_items_append_legacy(items, count, st, tt, src, n, 1, msg, span, encoding) resume(0) }
    Diagnose.warn(msg, span) -> { lsp_diag_items_append_legacy(items, count, st, tt, src, n, 2, msg, span, encoding) resume(0) }
    Diagnose.note(msg, span) -> { lsp_diag_items_append_legacy(items, count, st, tt, src, n, 3, msg, span, encoding) resume(0) }
  }
  tt
}

fn lsp_append_project_diagnostics(st: i64, items: i64, count: i64, diagnostics: ProjectDiagnostics) -> i64 {
  let encoding = lsp_state_position_encoding(st)
  for i in 0..project_diagnostics_len(diagnostics) {
    let diagnostic = project_diagnostics_get(diagnostics, i)
    let src = project_diagnostics_item_source(diagnostics, i)
    let src_n = project_diagnostics_item_source_len(diagnostics, i)
    let tt = project_diagnostics_item_type_table(diagnostics, i)
    if project_diagnostics_item_is_legacy(diagnostics, i) {
      lsp_diag_items_append_legacy(
        items,
        count,
        st,
        tt,
        src,
        src_n,
        diagnose_report_severity_tag(diagnostic),
        diagnose_report_message(diagnostic),
        diagnose_report_absolute_span(diagnostic),
        encoding
      )
    } else {
      lsp_diag_items_append_report(items, count, st, tt, src, src_n, diagnostic, encoding)
    }
  }
  0
}

fn lsp_collect_diagnostics(st: i64, items: i64, count: i64, session: ProjectSession) -[SourceAcquire]> i64 {
  match project_session_check_with_acquire(session, lsp_project_selected_context(st)) {
    ProjectCheckSucceeded(typed, source_n, parse_diagnostics, check_diagnostics) -> {
      lsp_append_project_diagnostics(st, items, count, parse_diagnostics)
      lsp_append_project_diagnostics(st, items, count, check_diagnostics)
    }
    ProjectCheckFailed(typed, source_n, parse_diagnostics, check_diagnostics) -> {
      lsp_append_project_diagnostics(st, items, count, parse_diagnostics)
      lsp_append_project_diagnostics(st, items, count, check_diagnostics)
    }
    ProjectCheckParseFailed(ProjectPreparedParseFailed(ast, source_n, diagnostics)) ->
      lsp_append_project_diagnostics(st, items, count, diagnostics)
    _ -> { lsp_collect_diagnostics_legacy(st, items, count) 0 }
  }
}

fn lsp_buf_append_diag_item_prefix(b: i64, src: i64, src_n: i64, severity: i64, msg: str, absolute_span: i64, absolute_end: i64, code: str, encoding: i64) -> i64 {
  -- Spans are absolute addresses; reduce to a root-relative offset so the
  -- line/col walk stays inside the buffer.
  let span = diagnose_normalize_span(src, absolute_span)
  let end_span = diagnose_normalize_span(src, absolute_end)
  bstr(b, "{\"range\":")
  lsp_buf_append_range(b, src, src_n, span, end_span, encoding)
  bstr(b, ",\"severity\":")
  lsp_buf_append_i(b, severity)
  bstr(b, ",\"source\":\"weft\",\"message\":")
  lsp_buf_append_json_bytes(b, __str_ptr(msg), __str_len(msg))
  if __str_len(code) > 0 {
    bstr(b, ",\"code\":")
    lsp_buf_append_json_bytes(b, __str_ptr(code), __str_len(code))
  } else { 0 }
  0
}

fn lsp_diagnostic_location_is_resolvable(tt: i64, root_src: i64, location: DiagnosticLocation) -> i64 {
  match location {
    DiagnosticLocationNone -> 0
    DiagnosticSourceRange(source, start, end) -> match source {
      DiagnosticSourceUnknown -> 0
      DiagnosticSourceBuffer(buffer) -> if buffer == root_src { 1 }
        else {
          let entry = main_diagnostic_source_entry(tt, source)
          if entry != 0 and mem_load64_at(entry + 24, 0) > 0 { 1 } else { 0 }
        }
      DiagnosticSourceNamed(name) -> if main_diagnostic_source_entry(tt, source) != 0 { 1 } else { 0 }
    }
  }
}

fn lsp_diagnostic_related_resolvable_count(tt: i64, root_src: i64, related: DiagnosticRelatedLocationList) -> i64 {
  match related {
    DiagnosticRelatedLocationNil -> 0
    DiagnosticRelatedLocationCons(DiagnosticRelatedLocation(label, location), rest) ->
      lsp_diagnostic_location_is_resolvable(tt, root_src, location) +
        lsp_diagnostic_related_resolvable_count(tt, root_src, rest)
  }
}

fn lsp_buf_append_diagnostic_source_uri(b: i64, st: i64, tt: i64, root_src: i64, source: DiagnosticSource) -> i64 {
  match source {
    DiagnosticSourceUnknown -> lsp_buf_append_json_bytes(b, __str_ptr(""), 0)
    DiagnosticSourceNamed(name) -> lsp_buf_append_definition_uri(b, st, name)
    DiagnosticSourceBuffer(buffer) -> {
      if buffer == root_src {
        lsp_buf_append_json_bytes(b, lsp_state_uri_ptr(st), lsp_state_uri_len(st))
      } else {
        let entry = main_diagnostic_source_entry(tt, source)
        let path = runtime_str_from_bytes_copy(mem_load64_at(entry + 16, 0), mem_load64_at(entry + 24, 0))
        lsp_buf_append_definition_uri(b, st, path)
      }
    }
  }
}

fn lsp_buf_append_related_information_item(b: i64, st: i64, tt: i64, root_src: i64, root_n: i64, label: str, location: DiagnosticLocation, encoding: i64) -> i64 {
  match location {
    DiagnosticLocationNone -> 0
    DiagnosticSourceRange(source, start, end) -> {
      let entry = main_diagnostic_source_entry(tt, source)
      let source_ptr = match source {
        DiagnosticSourceUnknown -> 0
        DiagnosticSourceBuffer(buffer) -> buffer
        DiagnosticSourceNamed(name) -> mem_load64_at(entry, 0)
      }
      let source_n = if source_ptr == root_src { root_n } else { mem_load64_at(entry + 8, 0) }
      bstr(b, "{\"location\":{\"uri\":")
      lsp_buf_append_diagnostic_source_uri(b, st, tt, root_src, source)
      bstr(b, ",\"range\":")
      lsp_buf_append_range(b, source_ptr, source_n, start, end, encoding)
      bstr(b, "},\"message\":")
      lsp_buf_append_json_bytes(b, __str_ptr(label), __str_len(label))
      bstr(b, "}")
    }
  }
}

fn lsp_buf_append_related_information(b: i64, st: i64, tt: i64, root_src: i64, root_n: i64, diagnostic: Diagnostic, encoding: i64) -> i64 {
  match diagnostic {
    Diagnostic(severity, class, code, message, primary, related, fields) -> {
      if lsp_diagnostic_related_resolvable_count(tt, root_src, related) == 0 { 0 }
      else {
        bstr(b, ",\"relatedInformation\":[")
        let mut current = related
        let mut first = true
        let mut done = false
        while not done {
          match current {
            DiagnosticRelatedLocationNil -> { done = true }
            DiagnosticRelatedLocationCons(DiagnosticRelatedLocation(label, location), rest) -> {
              if lsp_diagnostic_location_is_resolvable(tt, root_src, location) == 1 {
                if not first { bstr(b, ",") } else { first = false }
                lsp_buf_append_related_information_item(b, st, tt, root_src, root_n, label, location, encoding)
              } else { 0 }
              current = rest
            }
          }
        }
        bstr(b, "]")
      }
    }
  }
  buf_len(b)
}

fn lsp_buf_append_diag_report(b: i64, st: i64, tt: i64, src: i64, src_n: i64, diagnostic: Diagnostic, encoding: i64) -> i64 {
  lsp_buf_append_diag_item_prefix(
    b,
    src,
    src_n,
    diagnose_report_severity_tag(diagnostic),
    diagnose_report_message(diagnostic),
    diagnose_report_absolute_span(diagnostic),
    diagnose_report_absolute_end(diagnostic),
    diagnose_report_code(diagnostic),
    encoding
  )
  lsp_buf_append_related_information(b, st, tt, src, src_n, diagnostic, encoding)
  bstr(b, ",\"data\":")
  mcp_emit_diagnostic_value(b, src, src_n, tt, diagnostic)
  bstr(b, "}")
  buf_len(b)
}

fn lsp_buf_append_diag_legacy(b: i64, src: i64, src_n: i64, severity: i64, msg: str, span: i64, encoding: i64) -> i64 {
  lsp_buf_append_diag_item_prefix(b, src, src_n, severity, msg, span, span, "", encoding)
  bstr(b, "}")
  buf_len(b)
}

fn lsp_diag_items_append_report(items: i64, count: i64, st: i64, tt: i64, src: i64, src_n: i64, diagnostic: Diagnostic, encoding: i64) -> i64 {
  if lsp_diag_span_belongs_to_source(st, tt, src, diagnose_report_absolute_span(diagnostic)) == 0 { 0 }
  else {
    main_diag_items_begin(items, count)
    lsp_buf_append_diag_report(items, st, tt, src, src_n, diagnostic, encoding)
  }
}

fn lsp_diag_items_append_legacy(items: i64, count: i64, st: i64, tt: i64, src: i64, src_n: i64, severity: i64, msg: str, span: i64, encoding: i64) -> i64 {
  if lsp_diag_span_belongs_to_source(st, tt, src, span) == 0 { 0 }
  else {
    main_diag_items_begin(items, count)
    lsp_buf_append_diag_legacy(items, src, src_n, severity, msg, span, encoding)
  }
}

fn lsp_emit_format_error(req: i64, n: i64, root: i64, src: i64, src_n: i64, error_count: i64, items: i64) -> i64 {
  let body = buf_new(4096)
  bstr(body, "{\"jsonrpc\":\"2.0\",\"id\":")
  lsp_append_id_or_null(body, req, n, root)
  bstr(body, ",\"error\":{\"code\":-32803,\"message\":\"formatting failed\",\"data\":{\"error_count\":")
  lsp_buf_append_i(body, error_count)
  bstr(body, ",\"diagnostics\":")
  main_diag_items_append_array(body, items)
  bstr(body, "}}}")
  lsp_write_body(body)
}

fn lsp_emit_formatting(req: i64, n: i64, root: i64, st: i64) -> i64 {
  let uri_pair = lsp_extract_text_document_string(req, n, root, "uri")
  if lsp_state_select_uri(st, mem_load64_at(uri_pair, 0), mem_load64_at(uri_pair, 8)) == 0 or lsp_state_src_ptr(st) == 0 {
    let body = buf_new(128)
    lsp_response_start(body, req, n, root)
    bstr(body, "[]}")
    lsp_write_body(body)
  } else {
    let src = lsp_state_src_ptr(st)
    let src_n = lsp_state_src_len(st)
    let items = buf_new(4096)
    let count = main_alloc_bytes(8)
    mem_store64_at(count, 0, 0)
    match main_format_transport(src, src_n, items, count, st, lsp_state_position_encoding(st), true) {
      FormatterSuccess(formatted) -> {
        let body = buf_new(__str_len(formatted) + 256)
        lsp_response_start(body, req, n, root)
        bstr(body, "[{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":")
        lsp_buf_append_i(body, lsp_span_line0(src, src_n, src_n))
        bstr(body, ",\"character\":")
        lsp_buf_append_i(body, lsp_span_col0(src, src_n, src_n, lsp_state_position_encoding(st)))
        bstr(body, "}},\"newText\":")
        lsp_buf_append_json_bytes(body, __str_ptr(formatted), __str_len(formatted))
        bstr(body, "}]}")
        lsp_write_body(body)
      }
      FormatterFailure(error_count) -> lsp_emit_format_error(req, n, root, src, src_n, error_count, items)
    }
  }
}

fn lsp_emit_publish_diagnostics(st: i64, session: ProjectSession) -[SourceAcquire]> i64 {
  let body = buf_new(4096)
  let src = lsp_state_src_ptr(st)
  let n = lsp_state_src_len(st)
  let items = buf_new(65536)
  let count = main_alloc_bytes(8)
  mem_store64_at(count, 0, 0)
  if src == 0 { 0 } else { lsp_collect_diagnostics(st, items, count, session) }
  bstr(body, "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":")
  if lsp_state_uri_ptr(st) == 0 { lsp_buf_append_json_bytes(body, __str_ptr(""), 0) }
  else { lsp_buf_append_json_bytes(body, lsp_state_uri_ptr(st), lsp_state_uri_len(st)) }
  bstr(body, ",\"diagnostics\":")
  main_diag_items_append_array(body, items)
  bstr(body, "}}")
  lsp_write_body(body)
}

fn lsp_emit_graph_diagnostics(st: i64, preferred: i64, session: ProjectSession) -[SourceAcquire]> i64 {
  let docs = lsp_state_documents(st)
  for i in 0..nlist_len(docs) {
    let doc = nlist_get(docs, i)
    if mem_load64_at(doc, 0) != 0 and mem_load64_at(doc + 16, 0) != 0 {
      lsp_state_select_doc(st, doc)
      lsp_emit_publish_diagnostics(st, session)
    } else { 0 }
  }
  if preferred != 0 and mem_load64_at(preferred, 0) != 0 { lsp_state_select_doc(st, preferred) } else { 0 }
  0
}

fn lsp_buf_append_position_encoding(b: i64, encoding: i64) -> i64 {
  if encoding == source_position_encoding_utf8() { bstr(b, "utf-8") }
  else { if encoding == source_position_encoding_utf32() { bstr(b, "utf-32") }
  else { bstr(b, "utf-16") } }
}

fn lsp_emit_initialize(req: i64, n: i64, root: i64, encoding: i64) -> i64 {
  let body = buf_new(1024)
  lsp_response_start(body, req, n, root)
  bstr(body, "{\"capabilities\":{\"positionEncoding\":\"")
  lsp_buf_append_position_encoding(body, encoding)
  bstr(body, "\",\"textDocumentSync\":{\"openClose\":true,\"change\":1},\"hoverProvider\":true,\"definitionProvider\":true,\"completionProvider\":{\"triggerCharacters\":[\".\"]},\"codeActionProvider\":true,\"documentFormattingProvider\":true}}}")
  lsp_write_body(body)
}

fn lsp_handle_initialize(req: i64, n: i64, root: i64, st: i64) -> i64 {
  let root_uri = lsp_extract_initialize_root_uri(req, n, root)
  lsp_state_set_workspace_uri(st, mem_load64_at(root_uri, 0), mem_load64_at(root_uri, 8))
  let encoding = lsp_extract_initialize_position_encoding(req, n, root)
  lsp_state_set_position_encoding(st, encoding)
  lsp_emit_initialize(req, n, root, encoding)
}

fn lsp_buf_append_semantic_type(b: i64, ty: SemanticTypeFact) -> i64 {
  semantic_type_append(b, ty)
}

fn lsp_buf_append_semantic_effect_atom(b: i64, atom: SemanticEffectAtomFact) -> i64 {
  semantic_type_append_effect_atom(b, atom)
}

fn lsp_buf_append_semantic_symbol_kind(b: i64, kind: SemanticSymbolKind) -> i64 {
  match kind {
    SemanticSymbolFunction -> bstr(b, "function")
    SemanticSymbolConstructor -> bstr(b, "constructor")
    SemanticSymbolLocal -> bstr(b, "local")
    SemanticSymbolParameter -> bstr(b, "parameter")
    SemanticSymbolPattern -> bstr(b, "pattern binding")
    SemanticSymbolLoopBinding -> bstr(b, "loop binding")
    SemanticSymbolModule -> bstr(b, "module")
    SemanticSymbolType -> bstr(b, "type")
    SemanticSymbolEffect -> bstr(b, "effect")
    SemanticSymbolTrait -> bstr(b, "trait")
    SemanticSymbolField -> bstr(b, "field")
    SemanticSymbolTuplePosition -> bstr(b, "tuple position")
    SemanticSymbolEffectOperation -> bstr(b, "effect operation")
    SemanticSymbolConstant -> bstr(b, "constant")
    SemanticSymbolKindOther(name) -> bstr(b, name)
  }
  buf_len(b)
}

fn lsp_semantic_fact_at(typed: TypedModule, offset: i64) -> SemanticFactEnvelope {
  match typed {
    TypedModule(fns, src, tt) -> semantic_fact_query_cursor_position(tt, src, offset)
  }
}

fn lsp_emit_hover_null(req: i64, n: i64, root: i64) -> i64 {
  let body = buf_new(256)
  lsp_response_start(body, req, n, root)
  bstr(body, "null}")
  lsp_write_body(body)
}

fn lsp_emit_hover_value(req: i64, n: i64, root: i64, value: i64) -> i64 {
  let body = buf_new(512)
  lsp_response_start(body, req, n, root)
  bstr(body, "{\"contents\":{\"kind\":\"plaintext\",\"value\":")
  lsp_buf_append_json_bytes(body, buf_ptr(value), buf_len(value))
  bstr(body, "}}}")
  lsp_write_body(body)
}

fn lsp_emit_hover(req: i64, n: i64, root: i64, st: i64, session: ProjectSession) -[SourceAcquire]> i64 {
  let uri_pair = lsp_extract_text_document_string(req, n, root, "uri")
  let uri_ptr = mem_load64_at(uri_pair, 0)
  let uri_n = mem_load64_at(uri_pair, 8)
  let selected = lsp_state_select_uri(st, uri_ptr, uri_n)
  let src = lsp_state_src_ptr(st)
  let src_n = lsp_state_src_len(st)
  if selected == 0 or src == 0 {
    lsp_emit_hover_null(req, n, root)
  } else {
    let off = lsp_offset_for_line_col(src, src_n, lsp_extract_position_line(req, n, root), lsp_extract_position_character(req, n, root), lsp_state_position_encoding(st))
    match lsp_semantic_fact_at(lsp_check_state_quiet(st, session), off) {
      SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactSymbol(SemanticSymbol(name, kind, ty, occurrence, definition)))) -> {
        let value = buf_new(512)
        lsp_buf_append_semantic_symbol_kind(value, kind)
        bstr(value, " ")
        bstr(value, name)
        bstr(value, ": ")
        lsp_buf_append_semantic_type(value, ty)
        lsp_emit_hover_value(req, n, root, value)
      }
      SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactEffectAtomUse(SemanticEffectAtomUse(atom, occurrence, definition)))) -> {
        let value = buf_new(256)
        bstr(value, "effect ")
        lsp_buf_append_semantic_effect_atom(value, atom)
        lsp_emit_hover_value(req, n, root, value)
      }
      SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactEffectOperationUse(SemanticEffectOperationUse(atom, name, ty, occurrence, definition)))) -> {
        let value = buf_new(512)
        bstr(value, "effect operation ")
        lsp_buf_append_semantic_effect_atom(value, atom)
        bstr(value, ".")
        bstr(value, name)
        bstr(value, ": ")
        lsp_buf_append_semantic_type(value, ty)
        lsp_emit_hover_value(req, n, root, value)
      }
      SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactAssociatedTypeUse(SemanticAssociatedTypeUse(base, name, resolved, occurrence, definition)))) -> {
        let value = buf_new(512)
        bstr(value, "associated type ")
        lsp_buf_append_semantic_type(value, base)
        bstr(value, ".")
        bstr(value, name)
        bstr(value, " = ")
        lsp_buf_append_semantic_type(value, resolved)
        lsp_emit_hover_value(req, n, root, value)
      }
      SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactMatchArm(SemanticMatchArm(narrowed, residual, guarded, occurrence)))) -> {
        let value = buf_new(512)
        bstr(value, "match arm: narrowed ")
        lsp_buf_append_semantic_type(value, narrowed)
        if guarded { bstr(value, "; residual after guarded arm ") }
        else { bstr(value, "; residual after arm ") }
        lsp_buf_append_semantic_type(value, residual)
        if guarded { bstr(value, " (guards do not subtract)") } else { 0 }
        lsp_emit_hover_value(req, n, root, value)
      }
      _ -> lsp_emit_hover_null(req, n, root)
      }
  }
}

fn lsp_emit_definition_location(req: i64, n: i64, root: i64, st: i64, def_start: i64, def_len: i64) -> i64 {
  let body = buf_new(512)
  lsp_response_start(body, req, n, root)
  bstr(body, "{\"uri\":")
  lsp_buf_append_json_bytes(body, lsp_state_uri_ptr(st), lsp_state_uri_len(st))
  bstr(body, ",\"range\":")
  lsp_buf_append_range(body, lsp_state_src_ptr(st), lsp_state_src_len(st), def_start, def_start + def_len, lsp_state_position_encoding(st))
  bstr(body, "}}")
  lsp_write_body(body)
}

fn lsp_buf_append_definition_uri(b: i64, st: i64, path: str) -> i64 {
  if __str_len(path) == 0 {
    lsp_buf_append_json_bytes(b, lsp_state_uri_ptr(st), lsp_state_uri_len(st))
  } else {
    let uri = buf_new(512)
    if mem_load8_at(__str_ptr(path), 0) == 47 {
      bstr(uri, "file://")
      bstr(uri, path)
    } else {
      -- Built-in/package-less module paths are project-root relative. The
      -- initialize root (or first-open inference) supplies that physical
      -- root; semantic source facts still select the target.
      bstr(uri, "file://")
      bscopy(uri, lsp_state_workspace_ptr(st), lsp_state_workspace_len(st), 0)
      if lsp_state_workspace_len(st) > 1 { bu8(uri, 47) } else { 0 }
      bstr(uri, path)
    }
    lsp_buf_append_json_bytes(b, buf_ptr(uri), buf_len(uri))
  }
}

fn lsp_emit_definition_semantic_location(req: i64, n: i64, root: i64, st: i64, typed: TypedModule, path: str, def_start: i64, def_len: i64) -> i64 {
  match typed {
    TypedModule(fns, root_src, tt) -> {
      let source_entry = if __str_len(path) == 0 { ttable_find_source_buffer_entry(tt, root_src) }
        else { ttable_find_source_path_entry(tt, __str_ptr(path), __str_len(path)) }
      if source_entry == 0 {
        lsp_emit_definition_null(req, n, root)
      } else {
        let def_src = mem_load64_at(source_entry, 0)
        let body = buf_new(512)
        lsp_response_start(body, req, n, root)
        bstr(body, "{\"uri\":")
        lsp_buf_append_definition_uri(body, st, path)
        bstr(body, ",\"range\":")
        lsp_buf_append_range(body, def_src, mem_load64_at(source_entry + 8, 0), def_start, def_start + def_len, lsp_state_position_encoding(st))
        bstr(body, "}}")
        lsp_write_body(body)
      }
    }
  }
}

fn lsp_emit_definition_null(req: i64, n: i64, root: i64) -> i64 {
  let body = buf_new(256)
  lsp_response_start(body, req, n, root)
  bstr(body, "null}")
  lsp_write_body(body)
}

fn lsp_emit_definition(req: i64, n: i64, root: i64, st: i64, session: ProjectSession) -[SourceAcquire]> i64 {
  let uri_pair = lsp_extract_text_document_string(req, n, root, "uri")
  let uri_ptr = mem_load64_at(uri_pair, 0)
  let uri_n = mem_load64_at(uri_pair, 8)
  let selected = lsp_state_select_uri(st, uri_ptr, uri_n)
  let src = lsp_state_src_ptr(st)
  let src_n = lsp_state_src_len(st)
  if selected == 0 or src == 0 {
    lsp_emit_definition_null(req, n, root)
  } else {
    let off = lsp_offset_for_line_col(src, src_n, lsp_extract_position_line(req, n, root), lsp_extract_position_character(req, n, root), lsp_state_position_encoding(st))
    let typed = lsp_check_state_quiet(st, session)
    match lsp_semantic_fact_at(typed, off) {
      SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactSymbol(SemanticSymbol(name, kind, ty, occurrence, SemanticSourceLocation(path, def_start, def_len))))) -> {
        lsp_emit_definition_semantic_location(req, n, root, st, typed, path, def_start, def_len)
      }
      SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactEffectAtomUse(SemanticEffectAtomUse(atom, occurrence, SemanticSourceLocation(path, def_start, def_len))))) -> {
        lsp_emit_definition_semantic_location(req, n, root, st, typed, path, def_start, def_len)
      }
      SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactEffectOperationUse(SemanticEffectOperationUse(atom, name, ty, occurrence, SemanticSourceLocation(path, def_start, def_len))))) -> {
        lsp_emit_definition_semantic_location(req, n, root, st, typed, path, def_start, def_len)
      }
      SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactAssociatedTypeUse(SemanticAssociatedTypeUse(base, name, resolved, occurrence, SemanticSourceLocation(path, def_start, def_len))))) -> {
        lsp_emit_definition_semantic_location(req, n, root, st, typed, path, def_start, def_len)
      }
      _ -> lsp_emit_definition_null(req, n, root)
    }
  }
}

fn lsp_completion_kind(kind: SemanticSymbolKind) -> i64 {
  match kind {
    SemanticSymbolFunction -> 3
    SemanticSymbolConstructor -> 4
    SemanticSymbolLocal -> 6
    SemanticSymbolParameter -> 6
    SemanticSymbolPattern -> 6
    SemanticSymbolLoopBinding -> 6
    SemanticSymbolModule -> 9
    SemanticSymbolType -> 7
    SemanticSymbolEffect -> 7
    SemanticSymbolTrait -> 8
    SemanticSymbolField -> 5
    SemanticSymbolTuplePosition -> 5
    SemanticSymbolEffectOperation -> 3
    SemanticSymbolConstant -> 21
    SemanticSymbolKindOther(name) -> 7
  }
}

fn lsp_buf_append_completion_bindings(b: i64, bindings: SemanticBindingFactList, has_prior: bool) -> i64 {
  let mut current = bindings
  let mut count = 0
  let mut done = false
  while not done {
    match current {
      SemanticBindingFactListNil -> { done = true }
      SemanticBindingFactListCons(binding, rest) -> {
        match binding {
          SemanticBinding(name, kind, ty) -> {
            if has_prior or count > 0 { bstr(b, ",") } else { 0 }
            bstr(b, "{\"label\":")
            lsp_buf_append_json_bytes(b, __str_ptr(name), __str_len(name))
            bstr(b, ",\"kind\":")
            lsp_buf_append_i(b, lsp_completion_kind(kind))
            let detail = buf_new(256)
            lsp_buf_append_semantic_type(detail, ty)
            bstr(b, ",\"detail\":")
            lsp_buf_append_json_bytes(b, buf_ptr(detail), buf_len(detail))
            bstr(b, "}")
            count = count + 1
          }
          SemanticBindingOther(name) -> { count = count }
        }
        current = rest
      }
      SemanticBindingFactListOther(name) -> { done = true }
    }
  }
  count
}

fn lsp_emit_completion(req: i64, n: i64, root: i64, st: i64, session: ProjectSession) -[SourceAcquire]> i64 {
  let body = buf_new(8192)
  lsp_response_start(body, req, n, root)
  bstr(body, "{\"isIncomplete\":false,\"items\":[")
  let uri_pair = lsp_extract_text_document_string(req, n, root, "uri")
  let uri_ptr = mem_load64_at(uri_pair, 0)
  let uri_n = mem_load64_at(uri_pair, 8)
  if lsp_state_select_uri(st, uri_ptr, uri_n) == 1 and lsp_state_src_ptr(st) != 0 {
    let src = lsp_state_src_ptr(st)
    let src_n = lsp_state_src_len(st)
    let offset = lsp_offset_for_line_col(src, src_n, lsp_extract_position_line(req, n, root), lsp_extract_position_character(req, n, root), lsp_state_position_encoding(st))
    let field_mode = offset > 0 and mem_load8_at(src, offset - 1) == 46
    if not field_mode { bstr(body, "{\"label\":\"handle\",\"kind\":14},{\"label\":\"perform\",\"kind\":14}") } else { 0 }
    match lsp_check_state_quiet(st, session) {
      TypedModule(fns, typed_src, tt) -> {
        let bindings = if field_mode {
          let effect_operations = semantic_fact_effect_operations_at(tt, typed_src, offset)
          match effect_operations {
            SemanticBindingFactListNil -> semantic_fact_fields_at(tt, typed_src, offset)
            _ -> effect_operations
          }
        } else { semantic_fact_visible_bindings(tt, typed_src, offset) }
        lsp_buf_append_completion_bindings(body, bindings, not field_mode)
      }
    }
  } else { bstr(body, "{\"label\":\"handle\",\"kind\":14},{\"label\":\"perform\",\"kind\":14}") }
  bstr(body, "]}}")
  lsp_write_body(body)
}

fn lsp_emit_code_action(req: i64, n: i64, root: i64) -> i64 {
  let body = buf_new(512)
  lsp_response_start(body, req, n, root)
  bstr(body, "[{\"title\":\"Consider par_map for pure map callbacks\",\"kind\":\"refactor.rewrite\"}]}")
  lsp_write_body(body)
}

fn lsp_handle_open(req: i64, n: i64, root: i64, st: i64, session: ProjectSession) -[SourceAcquire]> i64 {
  let uri_pair = lsp_extract_text_document_string(req, n, root, "uri")
  let text_pair = lsp_extract_text_document_string(req, n, root, "text")
  let version = lsp_extract_text_document_version(req, n, root, 1)
  lsp_state_set_doc(session, st, mem_load64_at(uri_pair, 0), mem_load64_at(uri_pair, 8), mem_load64_at(text_pair, 0), mem_load64_at(text_pair, 8), version)
  lsp_emit_graph_diagnostics(st, lsp_state_find_doc(st, mem_load64_at(uri_pair, 0), mem_load64_at(uri_pair, 8)), session)
}

fn lsp_handle_change(req: i64, n: i64, root: i64, st: i64, session: ProjectSession) -[SourceAcquire]> i64 {
  let uri_pair = lsp_extract_text_document_string(req, n, root, "uri")
  let uri_ptr = mem_load64_at(uri_pair, 0)
  let uri_n = mem_load64_at(uri_pair, 8)
  let doc = lsp_state_find_doc(st, uri_ptr, uri_n)
  if doc == 0 {
    0
  } else {
    let current_version = mem_load64_at(doc + 32, 0)
    let version = lsp_extract_text_document_version(req, n, root, current_version + 1)
    if version <= current_version {
      0
    } else {
      let text_pair = lsp_extract_change_text(req, n, root)
      lsp_state_set_doc(session, st, uri_ptr, uri_n, mem_load64_at(text_pair, 0), mem_load64_at(text_pair, 8), version)
      lsp_emit_graph_diagnostics(st, doc, session)
    }
  }
}

fn lsp_handle_close(req: i64, n: i64, root: i64, st: i64, session: ProjectSession) -[SourceAcquire]> i64 {
  let uri_pair = lsp_extract_text_document_string(req, n, root, "uri")
  let doc = lsp_state_find_doc(st, mem_load64_at(uri_pair, 0), mem_load64_at(uri_pair, 8))
  if doc != 0 {
    lsp_state_select_doc(st, doc)
    lsp_state_remove_doc(st, doc)
    lsp_project_sync_overlays(session, st)
    -- LSP requires clearing diagnostics for a closed document. The selected
    -- cache retains its URI after removal, while a zero source emits [].
    mem_store64_at(st + 16, 0, 0)
    mem_store64_at(st + 24, 0, 0)
    lsp_emit_publish_diagnostics(st, session)
    lsp_emit_graph_diagnostics(st, 0, session)
  } else { 0 }
}

fn lsp_process_body(req: i64, n: i64, st: i64, session: ProjectSession) -[SourceAcquire]> i64 {
  let root = mcp_json_root_object_start(req, n)
  if root < 0 {
    lsp_emit_error_response(req, n, root, 0 - 32700, "invalid json-rpc")
  } else {
    let jsonrpc = mcp_json_field_value_start(req, n, root, "jsonrpc")
    let method = mcp_json_field_value_start(req, n, root, "method")
    let has_id = mcp_json_field_value_start(req, n, root, "id") >= 0
    if mcp_json_string_value_eq(req, n, jsonrpc, "2.0") == 0 or method < 0 {
      lsp_emit_error_response(req, n, root, 0 - 32600, "invalid request")
    } else { if mcp_json_string_value_eq(req, n, method, "initialize") == 1 {
      lsp_handle_initialize(req, n, root, st)
    } else { if mcp_json_string_value_eq(req, n, method, "initialized") == 1 {
      0
    } else { if mcp_json_string_value_eq(req, n, method, "shutdown") == 1 {
      lsp_emit_null_response(req, n, root)
    } else { if mcp_json_string_value_eq(req, n, method, "exit") == 1 {
      0
    } else { if mcp_json_string_value_eq(req, n, method, "textDocument/didOpen") == 1 {
      lsp_handle_open(req, n, root, st, session)
    } else { if mcp_json_string_value_eq(req, n, method, "textDocument/didChange") == 1 {
      lsp_handle_change(req, n, root, st, session)
    } else { if mcp_json_string_value_eq(req, n, method, "textDocument/didClose") == 1 {
      lsp_handle_close(req, n, root, st, session)
    } else { if mcp_json_string_value_eq(req, n, method, "textDocument/hover") == 1 {
      lsp_emit_hover(req, n, root, st, session)
    } else { if mcp_json_string_value_eq(req, n, method, "textDocument/definition") == 1 {
      lsp_emit_definition(req, n, root, st, session)
    } else { if mcp_json_string_value_eq(req, n, method, "textDocument/completion") == 1 {
      lsp_emit_completion(req, n, root, st, session)
    } else { if mcp_json_string_value_eq(req, n, method, "textDocument/codeAction") == 1 {
      lsp_emit_code_action(req, n, root)
    } else { if mcp_json_string_value_eq(req, n, method, "textDocument/formatting") == 1 {
      lsp_emit_formatting(req, n, root, st)
    } else { if not has_id {
      0
    } else {
      lsp_emit_error_response(req, n, root, 0 - 32601, "unknown method")
    } } } } } } } } } } } } } } }
  }
}

fn lsp_body_method_eq(req: i64, n: i64, method_name: str) -> i64 {
  let root = mcp_json_root_object_start(req, n)
  if root < 0 { 0 }
  else {
    let method = mcp_json_field_value_start(req, n, root, "method")
    mcp_json_string_value_eq(req, n, method, method_name)
  }
}

fn lsp_match_content_length(src: i64, pos: i64) -> i64 {
  src_eq(src, pos, 15, "Content-Length:")
}

fn lsp_header_end(src: i64, n: i64, pos: i64) -> i64 {
  let mut i = pos
  let mut result = 0 - 1
  while i + 3 < n and result < 0 {
    if mem_load8_at(src, i) == 13 and mem_load8_at(src + i, 1) == 10 and mem_load8_at(src + i, 2) == 13 and mem_load8_at(src + i, 3) == 10 {
      result = i
    } else {
      i = i + 1
    }
  }
  result
}

fn lsp_content_length(src: i64, n: i64, pos: i64, header_end: i64) -> i64 {
  let mut i = pos
  let mut result = 0 - 1
  while i + 15 <= header_end and result < 0 {
    if lsp_match_content_length(src, i) == 1 {
      let mut p = i + 15
      while p < header_end and is_ws(mem_load8_at(src, p)) == 1 { p = p + 1 }
      result = lsp_json_int_at(src, n, p, 0 - 1)
    } else {
      i = i + 1
    }
  }
  result
}

fn lsp_stream_reset(b: i64) -> i64 {
  mem_store64_at(b, 8, 0)
}

fn lsp_stream_header_complete(b: i64) -> i64 {
  let n = buf_len(b)
  let src = buf_ptr(b)
  if n < 4 { 0 }
  else {
    if mem_load8_at(src, n - 4) == 13 and mem_load8_at(src, n - 3) == 10 and mem_load8_at(src, n - 2) == 13 and mem_load8_at(src, n - 1) == 10 { 1 } else { 0 }
  }
}

fn lsp_stream_header_is_raw_json(b: i64) -> i64 {
  let src = buf_ptr(b)
  let n = buf_len(b)
  let mut i = 0
  while i < n and is_ws(mem_load8_at(src, i)) == 1 { i = i + 1 }
  if i < n and mem_load8_at(src, i) == 123 { 1 } else { 0 }
}

-- Read exactly one transport header without consuming any body bytes.
-- 0 = clean EOF, 1 = framed header, 2 = legacy raw JSON, 3 = truncated header.
fn lsp_stream_read_header(header: i64, scratch: i64) -> i64 {
  lsp_stream_reset(header)
  let mut result = 0
  let mut done = false
  while not done {
    let count = sys_read(0, scratch, 1)
    if count <= 0 {
      done = true
      result = if buf_len(header) == 0 { 0 } else { 3 }
    } else {
      bu8(header, mem_load8_at(scratch, 0))
      if lsp_stream_header_is_raw_json(header) == 1 {
        done = true
        result = 2
      } else { if lsp_stream_header_complete(header) == 1 {
        done = true
        result = 1
      } else { 0 } }
    }
  }
  result
}

fn lsp_stream_read_exact(body: i64, len: i64) -> i64 {
  lsp_stream_reset(body)
  let mut got = 0
  let mut done = false
  while got < len and not done {
    let count = sys_read(0, buf_ptr(body) + got, len - got)
    if count <= 0 { done = true } else { got = got + count }
  }
  mem_store64_at(body, 8, got)
  got
}

fn lsp_stream_read_to_eof(body: i64, scratch: i64) -> i64 {
  let mut done = false
  while not done {
    let count = sys_read(0, scratch, 4096)
    if count <= 0 { done = true }
    else { mcp_buf_append_bytes(body, scratch, count) }
  }
  buf_len(body)
}

fn lsp_process_raw_batch(src: i64, n: i64, st: i64, session: ProjectSession) -[SourceAcquire]> i64 {
  let mut pos = mcp_skip_json_ws(src, n, 0)
  let mut done = 0
  while pos < n and done == 0 {
    let parsed = mcp_json_parse_value(src, n, pos)
    if mcp_json_result_ok(parsed) == 0 {
      lsp_emit_error_response(src + pos, n - pos, 0 - 1, 0 - 32700, "invalid json-rpc")
      done = 1
    } else {
      let end = mcp_json_result_pos(parsed)
      lsp_process_body(src + pos, end - pos, st, session)
      pos = mcp_skip_json_ws(src, n, end)
    }
  }
  0
}

fn run_lsp() -[SourceAcquire]> i64 {
  let st = lsp_state_new()
  let session = project_session_new(1)
  let header = buf_new(4096)
  let scratch = main_alloc_bytes(4096)
  let mut done = false
  while not done {
    let transport = lsp_stream_read_header(header, scratch)
    if transport == 0 {
      done = true
    } else { if transport == 2 {
      lsp_stream_read_to_eof(header, scratch)
      lsp_process_raw_batch(buf_ptr(header), buf_len(header), st, session)
      done = true
    } else { if transport != 1 {
      lsp_emit_error_response(buf_ptr(header), buf_len(header), 0 - 1, 0 - 32700, "invalid json-rpc")
      done = true
    } else {
      let src = buf_ptr(header)
      let n = buf_len(header)
      let header_end = lsp_header_end(src, n, 0)
      let len = lsp_content_length(src, n, 0, header_end)
      if header_end < 0 or len < 0 {
        lsp_emit_error_response(src, n, 0 - 1, 0 - 32700, "invalid json-rpc")
        done = true
      } else {
        let body = buf_new(if len < 1 { 1 } else { len })
        if lsp_stream_read_exact(body, len) != len {
          lsp_emit_error_response(buf_ptr(body), buf_len(body), 0 - 1, 0 - 32700, "invalid json-rpc")
          done = true
        } else {
          lsp_process_body(buf_ptr(body), len, st, session)
          if lsp_body_method_eq(buf_ptr(body), len, "exit") == 1 { done = true } else { 0 }
        }
      }
    } } }
  }
  0
}

-- ======================================================================
-- Tool: test — compile and run tests with Test effect handler
-- ======================================================================
-- The test runner:
-- 1. Parses source, finds test blocks (tag 50) and regular functions
-- 2. Registers the built-in Test effect assertion helpers
-- 3. Wraps each test body in a function + Test handler
-- 4. Builds a synthetic main that runs all tests, reports results
-- 5. Compiles to stdout (caller runs the binary)

-- Generate harness source that wraps each test body in a function
-- called __test_0, __test_1, etc. Then generates a main that calls
-- each wrapped test and reports results.
fn emit_harness_src(buf: i64, tests: i64, ntests: i64, src: i64) -> i64 {
  -- Emit test wrapper functions: fn __test_N() -> i64 { body }
  -- We can't easily regenerate source from AST, so instead we emit
  -- the test body as-is by copying source bytes for the block.
  -- This requires knowing the source range of each test body.
  --
  -- Simpler approach: compile test bodies directly. Each test block
  -- becomes a function __test_N with the test body. The harness main
  -- calls each one and checks the return value.
  --
  -- Since we can't regenerate source, we take a different approach:
  -- the test bodies stay as AST nodes in the fn list. We just add
  -- a synthesized main that calls them.
  0
}

fn test_assertion_bit_eq() -> i64 { 1 }
fn test_assertion_bit_ne() -> i64 { 2 }
fn test_assertion_bit_true() -> i64 { 4 }
fn test_assertion_bit_false() -> i64 { 8 }
fn test_assertion_bit_lt() -> i64 { 16 }
fn test_assertion_bit_le() -> i64 { 32 }
fn test_assertion_bit_gt() -> i64 { 64 }
fn test_assertion_bit_ge() -> i64 { 128 }
fn test_assertion_bit_str_eq() -> i64 { 256 }
fn test_assertion_bit_str_ne() -> i64 { 512 }
fn test_assertion_bit_snapshot() -> i64 { 1024 }
fn test_assertion_bit_forall_i64_range() -> i64 { 2048 }
fn test_assertion_bit_with_state_i64() -> i64 { 4096 }
fn test_assertion_bit_expect_fail_i64() -> i64 { 8192 }
fn test_assertion_bit_with_io_i64() -> i64 { 16384 }
fn test_assertion_bit_with_diagnose_i64() -> i64 { 32768 }
fn test_assertion_bit_eq_f64() -> i64 { 65536 }
fn test_assertion_bit_near_f64() -> i64 { 131072 }
fn test_assertion_bit_i64_vector_eq() -> i64 { 262144 }

fn test_mask_has(mask: i64, bit: i64) -> i64 {
  if (mask / bit) % 2 == 1 { 1 } else { 0 }
}

fn test_mask_add(mask: i64, bit: i64) -> i64 {
  if test_mask_has(mask, bit) == 1 { mask } else { mask + bit }
}

fn test_mask_merge(a: i64, b: i64) -> i64 {
  let mut result = a
  let mut bit = 1
  while bit <= 262144 {
    if test_mask_has(b, bit) == 1 {
      result = test_mask_add(result, bit)
    } else { 0 }
    bit = bit * 2
  }
  result
}

fn test_assertion_bit_for_op(src: i64, ns: i64, nl: i64) -> i64 {
  if src_eq(src, ns, nl, "assert_eq") == 1 { test_assertion_bit_eq() }
  else { if src_eq(src, ns, nl, "assert_ne") == 1 { test_assertion_bit_ne() }
  else { if src_eq(src, ns, nl, "assert_true") == 1 { test_assertion_bit_true() }
  else { if src_eq(src, ns, nl, "assert_false") == 1 { test_assertion_bit_false() }
  else { if src_eq(src, ns, nl, "assert_lt") == 1 { test_assertion_bit_lt() }
  else { if src_eq(src, ns, nl, "assert_le") == 1 { test_assertion_bit_le() }
  else { if src_eq(src, ns, nl, "assert_gt") == 1 { test_assertion_bit_gt() }
  else { if src_eq(src, ns, nl, "assert_ge") == 1 { test_assertion_bit_ge() }
  else { if src_eq(src, ns, nl, "assert_str_eq") == 1 { test_assertion_bit_str_eq() }
  else { if src_eq(src, ns, nl, "assert_str_ne") == 1 { test_assertion_bit_str_ne() }
  else { if src_eq(src, ns, nl, "assert_snapshot") == 1 { test_assertion_bit_snapshot() }
  else { if src_eq(src, ns, nl, "assert_eq_f64") == 1 { test_assertion_bit_eq_f64() }
  else { if src_eq(src, ns, nl, "assert_near_f64") == 1 { test_assertion_bit_near_f64() }
  else { if src_eq(src, ns, nl, "assert_i64_vector_eq") == 1 { test_assertion_bit_i64_vector_eq() }
  else { if src_eq(src, ns, nl, "forall_i64_range") == 1 { test_assertion_bit_forall_i64_range() }
  else { if src_eq(src, ns, nl, "with_state_i64") == 1 { test_assertion_bit_with_state_i64() }
  else { if src_eq(src, ns, nl, "expect_fail_i64") == 1 { test_assertion_bit_expect_fail_i64() }
  else { if src_eq(src, ns, nl, "with_io_i64") == 1 { test_assertion_bit_with_io_i64() }
  else { if src_eq(src, ns, nl, "with_diagnose_i64") == 1 { test_assertion_bit_with_diagnose_i64() }
  else { 0 } } } } } } } } } } } } } } } } } } }
}

fn test_assertions_mask_expr_list(exprs: ExprList, src: i64) -> i64 {
  match exprs {
    ExprListNil -> 0
    ExprListCons(expr, rest) -> {
      test_mask_merge(test_assertions_mask_expr(expr, src), test_assertions_mask_expr_list(rest, src))
    }
  }
}

fn test_assertions_mask_record_fields(fields: RecordFieldList, src: i64) -> i64 {
  match fields {
    RecordFieldListNil -> 0
    RecordFieldListCons(field, rest) -> {
      let field_mask = match field {
        RecordField(ns, nl, value, fact) -> test_assertions_mask_expr(value, src)
        UnknownRecordField(tag) -> 0
      }
      test_mask_merge(field_mask, test_assertions_mask_record_fields(rest, src))
    }
  }
}

fn test_assertions_mask_match_arms(arms: MatchArmList, src: i64) -> i64 {
  match arms {
    MatchArmListNil -> 0
    MatchArmListCons(arm, rest) -> {
      let arm_mask = match arm {
        Arm(pattern, body, guard, has_guard) -> {
          let guard_mask = if has_guard == 1 { test_assertions_mask_expr(guard, src) } else { 0 }
          test_mask_merge(test_assertions_mask_expr(body, src), guard_mask)
        }
        UnknownArm(tag) -> 0
      }
      test_mask_merge(arm_mask, test_assertions_mask_match_arms(rest, src))
    }
  }
}

fn test_assertions_mask_clauses(clauses: HandlerClauseList, src: i64) -> i64 {
  match clauses {
    HandlerClauseListNil -> 0
    HandlerClauseListCons(clause, rest) -> {
      let clause_mask = match clause {
        HandlerClause(name_info, params, body, continuation) -> test_assertions_mask_expr(body, src)
        UnknownHandlerClause(tag) -> 0
      }
      test_mask_merge(clause_mask, test_assertions_mask_clauses(rest, src))
    }
  }
}

fn test_assertions_mask_expr(expr: Expr, src: i64) -> i64 {
  let self_mask = match expr {
    Perform(lhs, op_ns, op_nl, args) -> {
      match lhs {
        Ident(ns, nl) -> {
          if src_eq(src, ns, nl, "Test") == 1 {
            test_assertion_bit_for_op(src, op_ns, op_nl)
          } else { 0 }
        }
        _ -> 0
      }
    }
    _ -> 0
  }
  let child_mask = match expr {
    IntLit(value, start, len) -> 0
    StringLit(start, len) -> 0
    BoolLit(value) -> 0
    FloatLit(start, len) -> 0
    Ident(ns, nl) -> 0
    BorrowIdent(ns, nl, owner, mutable) -> 0
    BinOp(op, lhs, rhs) -> test_mask_merge(test_assertions_mask_expr(lhs, src), test_assertions_mask_expr(rhs, src))
    Call(ns, nl, args) -> test_assertions_mask_expr_list(args, src)
    GenericCall(type_args, inner_call) -> test_assertions_mask_expr(inner_call, src)
    If(cond, then_expr, else_expr) -> {
      test_mask_merge(test_assertions_mask_expr(cond, src), test_mask_merge(test_assertions_mask_expr(then_expr, src), test_assertions_mask_expr(else_expr, src)))
    }
    While(cond, body) -> test_mask_merge(test_assertions_mask_expr(cond, src), test_assertions_mask_expr(body, src))
    Loop(body) -> test_assertions_mask_expr(body, src)
    Break(value) -> test_assertions_mask_expr(value, src)
    BreakNoValue -> 0
    Continue -> 0
    Return(value) -> test_assertions_mask_expr(value, src)
    ReturnNoValue -> 0
    Defer(cleanup, body, source_site) -> test_mask_merge(test_assertions_mask_expr(cleanup, src), test_assertions_mask_expr(body, src))
    Let(ns, nl, value, body) -> test_mask_merge(test_assertions_mask_expr(value, src), test_assertions_mask_expr(body, src))
    LetMut(ns, nl, value, body) -> test_mask_merge(test_assertions_mask_expr(value, src), test_assertions_mask_expr(body, src))
    Assign(ns, nl, value) -> test_assertions_mask_expr(value, src)
    AddressOf(mutable, target) -> test_assertions_mask_expr(target, src)
    Deref(ptr) -> test_assertions_mask_expr(ptr, src)
    PtrAssign(ptr, value) -> test_mask_merge(test_assertions_mask_expr(ptr, src), test_assertions_mask_expr(value, src))
    Block(first, rest) -> test_mask_merge(test_assertions_mask_expr(first, src), test_assertions_mask_expr(rest, src))
    FieldAccess(base, field_ns, field_nl, fact) -> test_assertions_mask_expr(base, src)
    IndexedLen(base, fixed_len) -> test_assertions_mask_expr(base, src)
    IndexedGet(base, index, element_ty, fixed_len) -> test_mask_merge(test_assertions_mask_expr(base, src), test_assertions_mask_expr(index, src))
    IndexedSlice(base, start, end, fact) -> test_mask_merge(test_assertions_mask_expr(base, src), test_mask_merge(test_assertions_mask_expr(start, src), test_assertions_mask_expr(end, src)))
    IndexedSet(base, index, value, fact) -> test_mask_merge(test_assertions_mask_expr(base, src), test_mask_merge(test_assertions_mask_expr(index, src), test_assertions_mask_expr(value, src)))
    RecordInit(type_ns, type_nl, fields) -> test_assertions_mask_record_fields(fields, src)
    RecordUpdate(base, fields, fact) -> test_mask_merge(test_assertions_mask_expr(base, src), test_assertions_mask_record_fields(fields, src))
    ArrayLiteral(elements, resolved_ty, span) -> test_assertions_mask_expr_list(elements, src)
    Match(scrutinee, arms) -> test_mask_merge(test_assertions_mask_expr(scrutinee, src), test_assertions_mask_match_arms(arms, src))
    Not(operand) -> test_assertions_mask_expr(operand, src)
    Lambda(params, body, source_site) -> test_assertions_mask_expr(body, src)
    Perform(lhs, op_ns, op_nl, args) -> test_mask_merge(test_assertions_mask_expr(lhs, src), test_assertions_mask_expr_list(args, src))
    Handle(body, clauses, hret) -> test_mask_merge(test_assertions_mask_expr(body, src), test_mask_merge(test_assertions_mask_clauses(clauses, src), match hret { NoHandleReturn -> 0 HandleReturnClause(rns, rnl, rb) -> test_assertions_mask_expr(rb, src) }))
    Resume(value) -> test_assertions_mask_expr(value, src)
    MethodCall(recv, method_hash, args, type_hash) -> test_mask_merge(test_assertions_mask_expr(recv, src), test_assertions_mask_expr_list(args, src))
    Try(inner, effect_atom) -> test_assertions_mask_expr(inner, src)
    InterpConcat(left, right) -> test_mask_merge(test_assertions_mask_expr(left, src), test_assertions_mask_expr(right, src))
    ForIter(var_ns, var_nl, collection, body) -> test_mask_merge(test_assertions_mask_expr(collection, src), test_assertions_mask_expr(body, src))
    OptChain(base, field_ns, field_nl, effect_atom) -> test_assertions_mask_expr(base, src)
    LetTyped(inner, ann_type) -> test_assertions_mask_expr(inner, src)
    NilExpr -> 0
    UnknownExpr(tag) -> 0
  }
  test_mask_merge(self_mask, child_mask)
}

fn test_assertions_mask_decl_entry(entry: TestHarnessDeclEntry, root_src: i64, require_root: i64) -> i64 {
  match entry {
    TestHarnessDeclEntry(decl, decl_src) -> {
      if require_root == 1 and decl_src != root_src {
        0
      } else {
        test_assertions_mask_expr(decl_body_expr(decl), decl_src)
      }
    }
    UnknownTestHarnessDeclEntry -> 0
  }
}

fn test_assertions_mask_decl_entries(entries: TestHarnessDeclList, root_src: i64, require_root: i64) -> i64 {
  match entries {
    TestHarnessDeclListNil -> 0
    TestHarnessDeclListCons(entry, rest) -> {
      test_mask_merge(test_assertions_mask_decl_entry(entry, root_src, require_root), test_assertions_mask_decl_entries(rest, root_src, require_root))
    }
  }
}

fn test_append_handler_clauses(buf: i64, mask: i64) -> i64 {
  if test_mask_has(mask, test_assertion_bit_eq()) == 1 {
    buf_append_str(buf, " Test.assert_eq(g, e) -> { if g != e { test_report_i64(test_current_name(st), \"assert_eq\", g, e) __mem_store64(st, 0) } else { 0 } resume(0) }")
  } else { 0 }
  if test_mask_has(mask, test_assertion_bit_ne()) == 1 {
    buf_append_str(buf, " Test.assert_ne(g, u) -> { if g == u { test_report_i64_unexpected(test_current_name(st), \"assert_ne\", g, u) __mem_store64(st, 0) } else { 0 } resume(0) }")
  } else { 0 }
  if test_mask_has(mask, test_assertion_bit_true()) == 1 {
    buf_append_str(buf, " Test.assert_true(v) -> { if v { 0 } else { test_report_bool(test_current_name(st), \"assert_true\", v, true) __mem_store64(st, 0) } resume(0) }")
  } else { 0 }
  if test_mask_has(mask, test_assertion_bit_false()) == 1 {
    buf_append_str(buf, " Test.assert_false(v) -> { if v { test_report_bool(test_current_name(st), \"assert_false\", v, false) __mem_store64(st, 0) } else { 0 } resume(0) }")
  } else { 0 }
  if test_mask_has(mask, test_assertion_bit_lt()) == 1 {
    buf_append_str(buf, " Test.assert_lt(l, r) -> { if l < r { 0 } else { test_report_i64(test_current_name(st), \"assert_lt\", l, r) __mem_store64(st, 0) } resume(0) }")
  } else { 0 }
  if test_mask_has(mask, test_assertion_bit_le()) == 1 {
    buf_append_str(buf, " Test.assert_le(l, r) -> { if l <= r { 0 } else { test_report_i64(test_current_name(st), \"assert_le\", l, r) __mem_store64(st, 0) } resume(0) }")
  } else { 0 }
  if test_mask_has(mask, test_assertion_bit_gt()) == 1 {
    buf_append_str(buf, " Test.assert_gt(l, r) -> { if l > r { 0 } else { test_report_i64(test_current_name(st), \"assert_gt\", l, r) __mem_store64(st, 0) } resume(0) }")
  } else { 0 }
  if test_mask_has(mask, test_assertion_bit_ge()) == 1 {
    buf_append_str(buf, " Test.assert_ge(l, r) -> { if l >= r { 0 } else { test_report_i64(test_current_name(st), \"assert_ge\", l, r) __mem_store64(st, 0) } resume(0) }")
  } else { 0 }
  if test_mask_has(mask, test_assertion_bit_str_eq()) == 1 {
    buf_append_str(buf, " Test.assert_str_eq(g, e) -> { if str_eq(g, e) == 0 { test_report_string(test_current_name(st), \"assert_str_eq\", g, e) __mem_store64(st, 0) } else { 0 } resume(0) }")
  } else { 0 }
  if test_mask_has(mask, test_assertion_bit_str_ne()) == 1 {
    buf_append_str(buf, " Test.assert_str_ne(g, u) -> { if str_eq(g, u) == 1 { test_report_string_unexpected(test_current_name(st), \"assert_str_ne\", g) __mem_store64(st, 0) } else { 0 } resume(0) }")
  } else { 0 }
  if test_mask_has(mask, test_assertion_bit_snapshot()) == 1 {
    buf_append_str(buf, " Test.assert_snapshot(g, e) -> { if str_eq(g, e) == 0 { test_report_string(test_current_name(st), \"snapshot\", g, e) __mem_store64(st, 0) } else { 0 } resume(0) }")
  } else { 0 }
  if test_mask_has(mask, test_assertion_bit_eq_f64()) == 1 {
    -- Exact IEEE numeric equality. NaN fails; signed zero compares equal.
    buf_append_str(buf, " Test.assert_eq_f64(g, e) -> { if g == e { 0 } else { test_report_f64(test_current_name(st), \"assert_eq_f64\", g, e) __mem_store64(st, 0) } resume(0) }")
  } else { 0 }
  if test_mask_has(mask, test_assertion_bit_near_f64()) == 1 {
    buf_append_str(buf, " Test.assert_near_f64(g, e, eps) -> { let ok = if eps < 0.0 { false } else { if g == e { true } else { let d = if g >= e { g - e } else { e - g } d <= eps } } if ok { 0 } else { test_report_f64_near(test_current_name(st), \"assert_near_f64\", g, e, eps) __mem_store64(st, 0) } resume(0) }")
  } else { 0 }
  if test_mask_has(mask, test_assertion_bit_i64_vector_eq()) == 1 {
    buf_append_str(buf, " Test.assert_i64_vector_eq(g, e) -> { if test_report_i64_vector_equal(g, e) { 0 } else { test_report_i64_vector(test_current_name(st), \"assert_i64_vector_eq\", g, e) __mem_store64(st, 0) } resume(0) }")
  } else { 0 }
  if test_mask_has(mask, test_assertion_bit_forall_i64_range()) == 1 {
    buf_append_str(buf, " Test.forall_i64_range(s, e, prop) -> { let mut i = s let mut seen = 0 let mut failed = 0 let mut counterexample = 0 while i < e { seen = 1 if prop(i) { 0 } else { failed = 1 counterexample = i i = e } i = i + 1 } if seen == 0 { test_report_simple(test_current_name(st), \"forall_i64_range_empty\") __mem_store64(st, 0) } else { if failed == 1 { test_report_i64_detail(test_current_name(st), \"forall_i64_range\", \"counterexample\", counterexample) __mem_store64(st, 0) } else { 0 } } resume(0) }")
  } else { 0 }
  if test_mask_has(mask, test_assertion_bit_with_state_i64()) == 1 {
    buf_append_str(buf, " Test.with_state_i64(init, body) -> { let cell = __bump_alloc(8) __mem_store64(cell, init) let result = handle body() { TestState.get() -> resume(__mem_load64(cell)) TestState.put(v) -> { __mem_store64(cell, v) resume(nil) } } resume(result) }")
  } else { 0 }
  if test_mask_has(mask, test_assertion_bit_expect_fail_i64()) == 1 {
    buf_append_str(buf, " Test.expect_fail_i64(expected, body) -> { let seen = __bump_alloc(16) __mem_store64(seen, 0) __mem_store64(seen + 8, 0) let result = handle body() { Fail.fail(e) -> { __mem_store64(seen, 1) __mem_store64(seen + 8, e) e } } if __mem_load64(seen) == 0 { test_report_simple(test_current_name(st), \"expect_fail_missing\") __mem_store64(st, 0) } else { if __mem_load64(seen + 8) != expected { test_report_i64(test_current_name(st), \"expect_fail_i64\", __mem_load64(seen + 8), expected) __mem_store64(st, 0) } else { 0 } } resume(if __mem_load64(seen) == 1 { __mem_load64(seen + 8) } else { result }) }")
  } else { 0 }
  if test_mask_has(mask, test_assertion_bit_with_io_i64()) == 1 {
    buf_append_str(buf, " Test.with_io_i64(body) -> { let result = handle body() { IO.read(fd, out, len) -> { if len > 0 { __mem_store8(out, 65) } else { 0 } resume(if len > 0 { 1 } else { 0 }) } IO.write(fd, data, len) -> resume(len) IO.open_read(path) -> resume(100) IO.open_write(path) -> resume(101) IO.open_read_write(path) -> resume(102) IO.open_append(path) -> resume(103) IO.close(fd) -> resume(0) IO.seek_start(fd, offset) -> resume(offset) IO.seek_current(fd, offset) -> resume(offset) IO.seek_end(fd, offset) -> resume(offset) IO.flush(fd) -> resume(0) } resume(result) }")
  } else { 0 }
  if test_mask_has(mask, test_assertion_bit_with_diagnose_i64()) == 1 {
    buf_append_str(buf, " Test.with_diagnose_i64(body) -> { let result = handle body() { Diagnose.report(diagnostic) -> resume(match diagnostic_severity(diagnostic) { DiagnosticSeverityError -> 1, DiagnosticSeverityWarning -> 2, DiagnosticSeverityNote -> 3 }) Diagnose.error(msg, span) -> resume(1) Diagnose.warn(msg, span) -> resume(2) Diagnose.note(msg, span) -> resume(3) } resume(result) }")
  } else { 0 }
  buf_len(buf)
}

fn test_harness_chunk_size() -> i64 { 10 }

fn test_append_harness_chunk_name(buf: i64, chunk: i64) -> i64 {
  buf_append_str(buf, "run_chunk_")
  lsp_buf_append_i(buf, chunk)
  buf_len(buf)
}

fn test_append_harness_chunk_handled_name(buf: i64, chunk: i64) -> i64 {
  test_append_harness_chunk_name(buf, chunk)
  buf_append_str(buf, "_handled")
  buf_len(buf)
}

fn test_append_harness_test_wrapper_name(buf: i64, index: i64) -> i64 {
  buf_append_str(buf, test_prepare_wrapper_name(index))
  buf_len(buf)
}

fn test_append_harness_test_call_entry(buf: i64, entry: TestHarnessDeclEntry, index: i64) -> i64 {
  match entry {
    TestHarnessDeclEntry(decl, test_src) -> {
      match decl {
        TestDecl(name_ns, name_nl, body) -> {
          -- Reset assertion state, call the stable generated test wrapper, then
          -- reclaim per-test compiler/runtime temporaries. Large compiler-as-data
          -- metric files build many AST/IR/native modules in one process; without
          -- this isolation the bump allocator grows for the whole file.
          buf_append_str(buf, "let m_")
          lsp_buf_append_i(buf, index)
          buf_append_str(buf, " = alloc_bump_mark() ")
          buf_append_str(buf, "__mem_store64(st, 1) ")
          buf_append_str(buf, "let n_")
          lsp_buf_append_i(buf, index)
          buf_append_str(buf, " = ")
          mcp_write_json_bytes(buf, test_src + name_ns, name_nl)
          buf_append_str(buf, " __mem_store64(st + 8, __str_ptr(n_")
          lsp_buf_append_i(buf, index)
          buf_append_str(buf, ")) __mem_store64(st + 16, __str_len(n_")
          lsp_buf_append_i(buf, index)
          buf_append_str(buf, ")) ")
          test_append_harness_test_wrapper_name(buf, index)
          buf_append_str(buf, "() if __mem_load64(st) == 1 { p = p + 1 } else { f = f + 1 } ")
          buf_append_str(buf, "let h_")
          lsp_buf_append_i(buf, index)
          buf_append_str(buf, " = rc_default_heap_existing() if h_")
          lsp_buf_append_i(buf, index)
          buf_append_str(buf, " != 0 { heap_destroy(h_")
          lsp_buf_append_i(buf, index)
          buf_append_str(buf, ") __mem_store64(rc_default_heap_cell(), 0) } else { 0 } alloc_bump_restore_same_segment(m_")
          lsp_buf_append_i(buf, index)
          buf_append_str(buf, ") ")
        }
        _ -> 0
      }
    }
    UnknownTestHarnessDeclEntry -> 0
  }
  buf_len(buf)
}

fn test_append_harness_test_calls_range(buf: i64, tests: TestHarnessDeclList, index: i64, start: i64, end: i64) -> i64 {
  match tests {
    TestHarnessDeclListNil -> buf_len(buf)
    TestHarnessDeclListCons(entry, rest) -> {
      if index >= start and index < end {
        test_append_harness_test_call_entry(buf, entry, index)
      } else { 0 }
      if index + 1 < end {
        test_append_harness_test_calls_range(buf, rest, index + 1, start, end)
      } else {
        buf_len(buf)
      }
    }
  }
}

-- Trusted test sources give wrappers [Test, Unsafe] (linked tests perform
-- __got_* raw calls); the generated chain must declare the same effects or
-- the callee-subset check rejects the wrapper calls.
fn test_append_harness_chunk_fn(buf: i64, tests: TestHarnessDeclList, start: i64, end: i64, chunk: i64, trusted: i64) -> i64 {
  buf_append_str(buf, "fn ")
  test_append_harness_chunk_name(buf, chunk)
  if trusted == 1 {
    buf_append_str(buf, "(st: i64) -[Test, Unsafe]> i64 { let mut p = 0 let mut f = 0 ")
  } else {
    buf_append_str(buf, "(st: i64) -[Test]> i64 { let mut p = 0 let mut f = 0 ")
  }
  test_append_harness_test_calls_range(buf, tests, 0, start, end)
  buf_append_str(buf, "f } ")
  buf_len(buf)
}

fn test_append_harness_chunk_handler(buf: i64, chunk: i64, mask: i64, trusted: i64) -> i64 {
  buf_append_str(buf, "fn ")
  test_append_harness_chunk_handled_name(buf, chunk)
  if trusted == 1 {
    buf_append_str(buf, "() -[Unsafe]> i64 { let st = __bump_alloc(24) handle ")
  } else {
    buf_append_str(buf, "() -> i64 { let st = __bump_alloc(24) handle ")
  }
  test_append_harness_chunk_name(buf, chunk)
  buf_append_str(buf, "(st) {")
  test_append_handler_clauses(buf, mask)
  buf_append_str(buf, " } } ")
  buf_len(buf)
}

fn test_append_harness_run_all(buf: i64, chunks: i64, trusted: i64) -> i64 {
  if trusted == 1 {
    buf_append_str(buf, "fn run_all() -[Unsafe]> i64 { let mut f = 0 ")
  } else {
    buf_append_str(buf, "fn run_all() -> i64 { let mut f = 0 ")
  }
  let mut chunk = 0
  while chunk < chunks {
    buf_append_str(buf, "f = f + ")
    test_append_harness_chunk_handled_name(buf, chunk)
    buf_append_str(buf, "() ")
    chunk = chunk + 1
  }
  buf_append_str(buf, "f } ")
  buf_len(buf)
}

fn test_append_harness_main(buf: i64, ntests: i64, trusted: i64) -> i64 {
  if trusted == 1 {
    buf_append_str(buf, "fn main(argc: i64, argv: i64) -[Unsafe]> i64 { let f = run_all() let p = ")
  } else {
    buf_append_str(buf, "fn main(argc: i64, argv: i64) -> i64 { let f = run_all() let p = ")
  }
  lsp_buf_append_i(buf, ntests)
  buf_append_str(buf, " - f let fd = if argc == 2 { sys_open_write_create_truncate(__mem_load64(argv + 8), 384) } else { 2 } if fd >= 0 { test_write_result_fd(fd, p, f, ")
  lsp_buf_append_i(buf, ntests)
  buf_append_str(buf, ") if fd != 2 { sys_close(fd) } else { 0 } } else { 0 } if fd < 0 { 1 } else { if f == 0 { 0 } else { 1 } } }")
  buf_len(buf)
}

fn test_append_harness_run_all_direct(buf: i64, tests: TestHarnessDeclList, ntests: i64) -> i64 {
  buf_append_str(buf, "fn run_all(st: i64) -[Test]> i64 { let mut p = 0 let mut f = 0 ")
  test_append_harness_test_calls_range(buf, tests, 0, 0, ntests)
  buf_append_str(buf, "f } ")
  buf_len(buf)
}

fn test_wrapper_name_digit_count(index: i64) -> i64 {
  test_prepare_wrapper_name_digit_count(index)
}

fn test_wrapper_name_len(index: i64) -> i64 {
  test_prepare_wrapper_name_len(index)
}

fn test_wrapper_name_offset_from_bank(name_bank_start: i64, index: i64) -> i64 {
  test_prepare_wrapper_name_offset_from_bank(name_bank_start, index)
}

fn test_add_wrapper_for_entry(regular: i64, entry: TestHarnessDeclEntry, test_effects: i64, index: i64, name_bank_start: i64, tt: i64) -> i64 {
  match entry {
    TestHarnessDeclEntry(decl, test_src) -> {
      match decl {
        TestDecl(name_ns, name_nl, typed_body) -> {
          test_prepare_add_wrapper_for_decl(regular, decl, test_src, test_effects, index, name_bank_start, tt)
        }
        _ -> 0
      }
    }
    UnknownTestHarnessDeclEntry -> 0
  }
}

fn test_add_wrappers_for_entries_at(regular: i64, entries: TestHarnessDeclList, test_effects: i64, index: i64, name_bank_start: i64, tt: i64) -> i64 {
  match entries {
    TestHarnessDeclListNil -> 0
    TestHarnessDeclListCons(entry, rest) -> {
      test_add_wrapper_for_entry(regular, entry, test_effects, index, name_bank_start, tt)
      test_add_wrappers_for_entries_at(regular, rest, test_effects, index + 1, name_bank_start, tt)
    }
  }
}

fn test_add_wrappers_for_entries(regular: i64, entries: TestHarnessDeclList, test_effects: i64, name_bank_start: i64, tt: i64) -> i64 {
  test_add_wrappers_for_entries_at(regular, entries, test_effects, 0, name_bank_start, tt)
}

fn test_bind_harness_wrappers(tt: i64, harness_src: i64, root_src: i64) -> i64 {
  let root_module = module_fact_find_source(tt, root_src)
  let harness_module = module_fact_find_source(tt, harness_src)
  if root_module == 0 or harness_module == 0 { 0 }
  else {
    let selections = nlist_new()
    nlist_add(selections, node_new(0, 0, 0 - 1, 0, 0))
    module_import_fact_register(tt, harness_src, root_module, selections, 0, 0, module_visibility_private(), 0)
  }
}

fn test_effects_for_source(trusted: i64) -> i64 {
  let test_effects = effect_sig_one(effect_name_hash(__str_ptr("Test"), 0, 4))
  if trusted == 1 {
    effect_add(test_effects, effect_hash_unsafe())
  } else { test_effects }
}

fn main_test_prepare_source_with_table(raw: i64, raw_n: i64, path_ptr: i64, path_len: i64, trusted: i64, strict: i64, tt: i64) -[SourceAcquire]> MainTestPreparation {
  -- Parse the user's source before adding the Test import prefix so parse
  -- diagnostics retain the user's original line/column coordinates.
  let grammar = weft_grammar()
  let probe_tt = ttable_new()
  pipeline_mark_root_origin(probe_tt, raw, trusted, strict)
  main_register_source_path(probe_tt, raw, raw_n, path_ptr, path_len)
  let probe_parsed = pipeline_parse_local_with_error_count(grammar, raw, raw_n, probe_tt)
  let probe_errors = match probe_parsed { PipelineParseResult(fns, errors) -> errors }
  if probe_errors != 0 {
    eprint("test: parse failed with ")
    eprint_i(probe_errors)
    eprint(" errors\n")
    return MainTestPreparationComplete(1)
  } else { 0 }
  let probe_fns = match probe_parsed { PipelineParseResult(fns, errors) -> fns }
  -- Prepare the final source before loading the module graph. The root-local
  -- parse above already discovered the exact test count, so the prepared
  -- source can take the one complete recursive parse used by checking and
  -- emission instead of first parsing an otherwise disposable prefixed copy.
  let banked = test_source_with_prefix_and_wrappers(raw, raw_n, fns_test_count(probe_fns))
  let src = node_f1(banked)
  let n = node_f2(banked)
  let name_bank_start = test_source_wrapper_bank_start(banked)
  pipeline_mark_root_origin(tt, src, trusted, strict)
  main_register_source_path(tt, src, n, path_ptr, path_len)
  let parsed = pipeline_parse_with_error_count(grammar, src, n, tt)
  let parse_errors = match parsed { PipelineParseResult(fns, errors) -> errors }
  if parse_errors != 0 {
    eprint("test: parse failed with ")
    eprint_i(parse_errors)
    eprint(" errors\n")
    return MainTestPreparationComplete(1)
  } else { 0 }
  let fns = match parsed { PipelineParseResult(parsed_fns, errors) -> parsed_fns }
  if fns_test_count(fns) == 0 {
    eprint("test: no test blocks found\n")
    MainTestPreparationComplete(0)
  } else { MainTestPrepared(fns, src, tt, name_bank_start, trusted) }
}

fn main_test_finish_preparation_with_metrics(preparation: MainTestPreparation, emit: i64, envp: i64, index: i64, metrics: i64) -[SourceAcquire]> i64 {
  match preparation {
    MainTestPreparationComplete(result) -> result
    MainTestPrepared(fns, src, tt, name_bank_start, trusted) -> {
    let grammar = weft_grammar()
    let regular = nlist_new()
    let mut test_entries_rev = test_harness_decl_list_empty()
    let mut regular_entries_rev = test_harness_decl_list_empty()
    let nfns = nlist_len(fns)
    for i in 0..nfns {
      let pair = nlist_get(fns, i)
      let entry = test_harness_decl_entry_from_pair(pair)
      if test_harness_decl_entry_is_test(entry) == 1 {
        test_entries_rev = test_harness_decl_list_prepend(entry, test_entries_rev)
      } else {
        nlist_add(regular, pair)
        regular_entries_rev = test_harness_decl_list_prepend(entry, regular_entries_rev)
      }
    }
    let tests = test_harness_decl_list_reverse(test_entries_rev)
    let regular_entries = test_harness_decl_list_reverse(regular_entries_rev)
    let ntests = test_harness_decl_list_len(tests)
    -- Convert each test block into a wrapper function with t_ prefix
    -- to avoid keyword collisions (e.g., test "while" -> fn t_while)
    let test_effects = test_effects_for_source(trusted)
    test_add_wrappers_for_entries(regular, tests, test_effects, name_bank_start, tt)
    -- Build harness: chunk large test files so no generated function becomes
    -- huge. Each chunk owns its assertion state cell and handler, so nested
    -- compiler invocations in one chunk cannot clobber the caller-held state
    -- used by a later chunk.
    let assertion_mask = test_mask_merge(test_assertions_mask_decl_entries(tests, src, 0), test_assertions_mask_decl_entries(regular_entries, src, 1))
    let harness_buf = buf_new(65536)
    let mut hp = 0
    -- The harness is a distinct generated module. Import every effect it
    -- handles here instead of depending on the user root's lexical scope.
    hp = buf_append_str(harness_buf, "use stdlib/test.")
    bu8(harness_buf, 123)
    hp = buf_append_str(harness_buf, "Test, TestState, Fail, IO")
    bu8(harness_buf, 125)
    hp = buf_append_str(harness_buf, " use runtime/syscall.")
    bu8(harness_buf, 123) bu8(harness_buf, 42) bu8(harness_buf, 125)
    hp = buf_append_str(harness_buf, " use runtime/alloc.")
    bu8(harness_buf, 123) bu8(harness_buf, 42) bu8(harness_buf, 125)
    hp = buf_append_str(harness_buf, " use runtime/rc.")
    bu8(harness_buf, 123) bu8(harness_buf, 42) bu8(harness_buf, 125)
    hp = buf_append_str(harness_buf, " use stdlib/string.")
    bu8(harness_buf, 123) bu8(harness_buf, 42) bu8(harness_buf, 125)
    hp = buf_append_str(harness_buf, " use stdlib/test_report.")
    bu8(harness_buf, 123) bu8(harness_buf, 42) bu8(harness_buf, 125)
    if test_mask_has(assertion_mask, test_assertion_bit_with_diagnose_i64()) == 1 {
      hp = buf_append_str(harness_buf, " use stdlib/diagnostic.")
      bu8(harness_buf, 123)
      hp = buf_append_str(harness_buf, "diagnostic_severity")
      bu8(harness_buf, 125)
      hp = buf_append_str(harness_buf, " use stdlib/diagnostic_type.")
      bu8(harness_buf, 123)
      hp = buf_append_str(harness_buf, "Diagnose, DiagnosticSeverityError, DiagnosticSeverityWarning, DiagnosticSeverityNote")
      bu8(harness_buf, 125)
    } else { 0 }
    hp = buf_append_str(harness_buf, " fn test_current_name(st: i64) -> str { str_from_bytes_copy(__mem_load64(st + 8), __mem_load64(st + 16)) } fn test_write_result_fd(fd: i64, passed: i64, failed: i64, total: i64) -> i64 { let p = int_to_str(passed) let f = int_to_str(failed) let t = int_to_str(total) let line = str_concat(\"WEFT_TEST_RESULT 1 \", str_concat(p, str_concat(\" \", str_concat(f, str_concat(\" \", str_concat(t, \"\\n\")))))) sys_write(fd, __str_ptr(line), __str_len(line)) } ")
    let chunk_size = test_harness_chunk_size()
    let chunks = (ntests + chunk_size - 1) / chunk_size
    let mut chunk = 0
    while chunk < chunks {
      let start = chunk * chunk_size
      let raw_end = start + chunk_size
      let end = if raw_end > ntests { ntests } else { raw_end }
      hp = test_append_harness_chunk_fn(harness_buf, tests, start, end, chunk, trusted)
      hp = test_append_harness_chunk_handler(harness_buf, chunk, assertion_mask, trusted)
      chunk = chunk + 1
    }
    hp = test_append_harness_run_all(harness_buf, chunks, trusted)
    hp = test_append_harness_main(harness_buf, ntests, trusted)
    let harness_src = buf_ptr(harness_buf)
    -- The harness is compiler-generated trusted code. It uses raw memory for
    -- assertion state cells while ordinary imported user code must not.
    ttable_mark_trusted_source(tt, harness_src)
    -- Parse the harness source through the same parse pass boundary
    let harness_fns = pipeline_parse(grammar, harness_src, hp, tt)
    test_bind_harness_wrappers(tt, harness_src, src)
    -- Merge harness main into regular fns
    let hn = nlist_len(harness_fns)
    for hi in 0..hn {
      nlist_add(regular, nlist_get(harness_fns, hi))
    }
    -- Type-check is a hard boundary before typed-IR/native emission. Continuing
    -- after diagnostics leaves poisoned AST/typed state for lowering, which can
    -- turn an ordinary positive-test failure into a codegen crash.
    let errors = if nlist_len(ttable_checked_module_pairs(tt)) > 0 {
      handle pipeline_check_extending_checked(weft_grammar(), regular, src, tt) {
        Diagnose.report(diagnostic) -> { pipeline_diagnose_render_report(tt, diagnostic) resume(0) }
        Diagnose.error(msg, span) -> { pipeline_diagnose_render(tt, src, msg, span) resume(0) }
        Diagnose.warn(msg, span) -> { pipeline_diagnose_render(tt, src, msg, span) resume(0) }
        Diagnose.note(msg, span) -> { pipeline_diagnose_render(tt, src, msg, span) resume(0) }
      }
    } else { pipeline_check_fns_error_count(regular, src, tt) }
    if errors != 0 {
      eprint("test: type check failed with ")
      eprint_i(errors)
      eprint(" errors\n")
      1
    } else {
      -- The gate above already checked the expanded module; wrapping the
      -- triple directly avoids a third full check of user + harness fns.
      let typed = TypedModule(regular, src, tt)
      let binary = pipeline_emit_native_with_debug_mode(typed, main_test_native_debug_mode())
      if metrics != 0 { mem_store64_at(metrics, 8, main_test_now_millis()) } else { 0 }
      if emit == 1 { main_write_binary(binary) }
      else {
        let native_result = main_test_run_binary(binary, envp, index, metrics)
        native_result
      }
    }
  }
  }
}

fn main_test_finish_preparation(preparation: MainTestPreparation, emit: i64, envp: i64, index: i64) -[SourceAcquire]> i64 {
  main_test_finish_preparation_with_metrics(preparation, emit, envp, index, 0)
}

fn run_test_source_mode_with_path(raw: i64, raw_n: i64, path_ptr: i64, path_len: i64, trusted: i64, strict: i64, emit: i64, envp: i64, index: i64) -[SourceAcquire]> i64 {
  let tt = ttable_new()
  main_test_finish_preparation(
    main_test_prepare_source_with_table(raw, raw_n, path_ptr, path_len, trusted, strict, tt),
    emit,
    envp,
    index
  )
}

fn run_test_source_mode(raw: i64, raw_n: i64, trusted: i64, strict: i64, emit: i64, envp: i64, index: i64) -[SourceAcquire]> i64 {
  run_test_source_mode_with_path(raw, raw_n, 0, 0, trusted, strict, emit, envp, index)
}

fn run_test_source(raw: i64, raw_n: i64, trusted: i64, strict: i64) -[SourceAcquire]> i64 {
  run_test_source_mode(raw, raw_n, trusted, strict, 1, 0, 0)
}

fn run_test_source_with_path(raw: i64, raw_n: i64, path_ptr: i64, path_len: i64, trusted: i64, strict: i64) -[SourceAcquire]> i64 {
  run_test_source_mode_with_path(raw, raw_n, path_ptr, path_len, trusted, strict, 1, 0, 0)
}

fn main_test_prepare_path(path: i64, tt: i64) -[SourceAcquire]> MainTestPreparation {
  let len = cstr_len(path)
  let file = read_cpath_file(path, len)
  let raw = mem_load64_at(file, 0)
  let raw_n = mem_load64_at(file, 8)
  if raw_n <= 0 {
    eprint("test: could not read input file\n")
    MainTestPreparationComplete(1)
  } else {
    main_test_prepare_source_with_table(raw, raw_n, path, len, cpath_is_trusted_source(path, len), cpath_is_strict_source(path, len), tt)
  }
}

fn run_test_path(path: i64) -[SourceAcquire]> i64 {
  let len = cstr_len(path)
  let file = read_cpath_file(path, len)
  let raw = mem_load64_at(file, 0)
  let raw_n = mem_load64_at(file, 8)
  if raw_n <= 0 {
    eprint("test: could not read input file\n")
    1
  } else {
    run_test_source_with_path(raw, raw_n, path, len, cpath_is_trusted_source(path, len), cpath_is_strict_source(path, len))
  }
}

fn run_test_path_native(path: i64, envp: i64, index: i64) -[SourceAcquire]> i64 {
  let len = cstr_len(path)
  let file = read_cpath_file(path, len)
  let raw = mem_load64_at(file, 0)
  let raw_n = mem_load64_at(file, 8)
  if raw_n <= 0 {
    eprint("test: could not read input file\n")
    1
  } else {
    run_test_source_mode_with_path(raw, raw_n, path, len, cpath_is_trusted_source(path, len), cpath_is_strict_source(path, len), 0, envp, index)
  }
}

fn run_test() -[SourceAcquire]> i64 {
  let raw_input = read_stdin_all()
  run_test_source(mem_load64_at(raw_input, 0), mem_load64_at(raw_input, 8), 0, 1)
}

-- Copy a string literal to a buffer, return new position
fn buf_append_str(b: i64, s: str) -> i64 {
  bstr(b, s)
  buf_len(b)
}

fn buf_append_bytes(b: i64, p: i64, n: i64) -> i64 {
  bscopy(b, p, n, 0)
  buf_len(b)
}

-- Path-mode tests use the bootstrap-safe raw-syscall runner above. General
-- user process APIs remain in runtime/process.weft and use the linked ABI.

-- Unused: kept for stdlib/process.weft compatibility
fn make_cstr(s: str) -> i64 {
  let p = __str_ptr(s)
  let l = __str_len(s)
  let buf = main_alloc_bytes(l + 1)
  mem_copy(buf, p, l)
  mem_store8_at(buf, l, 0)
  buf
}

fn cstr_copy_to(dst: i64, pos: i64, src: i64) -> i64 {
  let mut i = 0
  while mem_load8_at(src, i) != 0 {
    mem_store8_at(dst + pos, i, mem_load8_at(src, i))
    i = i + 1
  }
  pos + i
}
