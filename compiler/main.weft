    mcp_write_counter(b, "residual_pool_full", pipeline_native_residual_probe_count(native, 3))
    mcp_write_counter(b, "residual_cs_exhausted", pipeline_native_residual_probe_count(native, 4))
    mcp_write_counter(b, "residual_use_sum", pipeline_native_residual_probe_count(native, 5))
    mcp_write_counter(b, "split_candidate_defs", pipeline_native_split_probe_count(native, 0))
