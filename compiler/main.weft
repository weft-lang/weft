-- Weft compiler — Layer 1
-- Compiles Weft source with arithmetic, control flow, functions to aarch64 Mach-O
-- Usage: ./weft < compiler/main.weft > output && chmod +x output

use compiler/codegen.{*}
use compiler/diagnose.{*}
use compiler/effect_ref.{*}
use compiler/typeck.{*}
use compiler/grammar.{*}
use compiler/grammar_registry.{*}
use compiler/ir.{*}
use compiler/lib.{*}
use compiler/module.{*}
use compiler/package.{*}
use compiler/package_lock.{pkg_cli_lock}
use compiler/pipeline.{*}
use compiler/source_trust.{*}
use compiler/semantic_fact.{*}
use compiler/type_registry.{*}
use compiler/types.{*}
use runtime/alloc.{*}
use runtime/buffer.{*}
use runtime/dir_standalone.{runtime_standalone_dir}
use runtime/effects.{*}
use runtime/memory.{*}
use runtime/string.{runtime_str_from_bytes_copy}
use runtime/syscall.{*}
use runtime/test_harness.{*}
use stdlib/diagnostic_type.{*}

fn main_alloc_bytes(size: i64) -> i64 {
  alloc_words((size + 7) / 8)
}

-- ======================================================================
-- Main: read source, lex, parse, codegen, emit Mach-O
-- ======================================================================

-- The compile pipeline: parse → check → emit
-- Each phase is a function from pipeline.weft with declared effects.
-- Tools compose different subsets with different handlers.
fn main_write_binary(binary: BinaryObject) -> i64 {
  match binary {
    BinaryObject(o, kind) -> {
      if buf_len(o) == 0 {
        eprint("compile: no binary produced\n")
        1
      } else {
        sys_write(1, buf_ptr(o), buf_len(o))
        0
      }
    }
  }
}

fn compile(src: i64, n: i64) -> i64 {
  compile_with_origin(src, n, 0, 1)
}

fn compile_with_trust(src: i64, n: i64, trusted: i64) -> i64 {
  compile_with_origin(src, n, trusted, pipeline_strict_for_trust(trusted))
}

fn compile_with_origin(src: i64, n: i64, trusted: i64, strict: i64) -> i64 {
  compile_with_origin_and_grant(src, n, trusted, strict, 0)
}

fn main_decl_is_root_main(decl: Decl, src: i64) -> i64 {
  match decl {
    FnDecl(ns, nl, params, body) -> src_eq(src, ns, nl, "main")
    FnDeclWrapped(inner, ret_type, eff_sig, tparams) -> main_decl_is_root_main(inner, src)
    _ -> 0
  }
}

fn main_fns_have_root_main(fns: i64, src: i64) -> i64 {
  let nfns = nlist_len(fns)
  let mut i = 0
  while i < nfns {
    let pair = nlist_get(fns, i)
    let pair_src = node_f2(pair)
    if pair_src == src and main_decl_is_root_main(decl_from_node(node_f1(pair)), src) == 1 {
      return 1
    } else { 0 }
    i = i + 1
  }
  0
}

fn main_fns_source_count(fns: i64, src: i64) -> i64 {
  let nfns = nlist_len(fns)
  let mut count = 0
  for i in 0..nfns {
    if node_f2(nlist_get(fns, i)) == src { count = count + 1 } else { 0 }
  }
  count
}

fn main_register_source_path(tt: i64, src: i64, n: i64, path_ptr: i64, path_len: i64) -> i64 {
  if path_len > 0 {
    ttable_register_source(tt, src, n, path_ptr, path_len)
    -- A path-aware root is a package graph node even when the root source has
    -- no imports. This makes manifest exports and L7 package identity facts
    -- available to every path-form command, not only as an import side effect.
    pkg_identity_register_root(tt, pkg_manifest_load_default())
    0
  } else { 0 }
}

fn main_check_source_with_path_and_origin_and_grant(src: i64, n: i64, path_ptr: i64, path_len: i64, trusted: i64, strict: i64, can_grant_trust: i64) -> TypedModule {
  let grammar = weft_grammar()
  let tt = ttable_new()
  main_mark_root_origin_with_grant(tt, src, trusted, strict, can_grant_trust)
  main_register_source_path(tt, src, n, path_ptr, path_len)
  let ast = pipeline_parse_module(grammar, src, n, tt)
  match ast {
    AstModule(fns, ast_src, ast_tt) -> {
      pipeline_bind_runtime_preludes(fns, ast_src, ast_tt)
      pipeline_check_module(ast)
    }
  }
}

fn main_check_source_with_origin_and_grant(src: i64, n: i64, trusted: i64, strict: i64, can_grant_trust: i64) -> TypedModule {
  main_check_source_with_path_and_origin_and_grant(src, n, 0, 0, trusted, strict, can_grant_trust)
}

fn compile_with_path_and_origin_and_grant(src: i64, n: i64, path_ptr: i64, path_len: i64, trusted: i64, strict: i64, can_grant_trust: i64) -> i64 {
  let grammar = weft_grammar()
  let tt = ttable_new()
  main_mark_root_origin_with_grant(tt, src, trusted, strict, can_grant_trust)
  main_register_source_path(tt, src, n, path_ptr, path_len)
  let ast = pipeline_parse_module(grammar, src, n, tt)
  match ast {
    AstModule(fns, ast_src, ast_tt) -> {
      pipeline_bind_native_runtime_preludes(fns, ast_src, ast_tt)
      let errors = pipeline_check_fns_error_count(fns, ast_src, ast_tt)
      if errors != 0 {
        eprint("compile: type check failed with ")
        eprint_i(errors)
        eprint(" errors\n")
        1
      } else {
        if main_fns_have_root_main(fns, ast_src) != 1 {
          eprint("compile: missing main function\n")
          1
        } else {
          -- The error-count pass above IS the check: both entries run the
          -- same pipeline_check with the same rendering handlers, and
          -- TypedModule is the same (fns, src, tt) triple — re-checking
          -- here re-did every declaration for nothing (~258 MB and a full
          -- checker pass per self-compile).
          let typed = TypedModule(fns, ast_src, ast_tt)
          let binary = pipeline_emit_native(typed)
          main_write_binary(binary)
        }
      }
    }
  }
}

fn compile_with_origin_and_grant(src: i64, n: i64, trusted: i64, strict: i64, can_grant_trust: i64) -> i64 {
  compile_with_path_and_origin_and_grant(src, n, 0, 0, trusted, strict, can_grant_trust)
}

-- Read a null-terminated C string length
fn cstr_len(ptr: i64) -> i64 {
  let mut i = 0
  while mem_load8_at(ptr, i) != 0 { i = i + 1 }
  i
}

-- Compare C string at ptr with Weft string literal
fn cstr_eq(ptr: i64, s: str) -> i64 {
  let sptr = __str_ptr(s)
  let slen = __str_len(s)
  let clen = cstr_len(ptr)
  if clen != slen { 0 }
  else { src_eq_at(ptr, 0, sptr, 0, slen) }
}

fn cpath_file_pair(path: i64, len: i64) -> i64 {
  let pair = main_alloc_bytes(16)
  mem_store64_at(pair, 0, path)
  mem_store64_at(pair, 8, len)
  pair
}

fn read_cpath_file(path: i64, len: i64) -> i64 {
  read_file(cpath_file_pair(path, len))
}

fn cpath_is_trusted_source(path: i64, len: i64) -> i64 {
  source_trust_path_is_trusted_root(path, len)
}

fn cpath_is_strict_source(path: i64, len: i64) -> i64 {
  if cpath_is_trusted_source(path, len) == 1 { 0 } else { 1 }
}

fn cpath_can_grant_import_trust(path: i64, len: i64) -> i64 {
  source_trust_path_can_grant_import_trust(path, len)
}

fn compile_path(path: i64) -> i64 {
  let len = cstr_len(path)
  let file = read_cpath_file(path, len)
  let src = mem_load64_at(file, 0)
  let n = mem_load64_at(file, 8)
  if n <= 0 {
    eprint("compile: could not read input file\n")
    1
  } else {
    compile_with_path_and_origin_and_grant(src, n, path, len, cpath_is_trusted_source(path, len), cpath_is_strict_source(path, len), cpath_can_grant_import_trust(path, len))
  }
}

-- Native test-runner process support stays syscall-only so adding the runner
-- does not turn the self-hosted compiler into a relocatable object. Darwin's
-- raw fork result uses x1 to distinguish the child; the generic syscall
-- intrinsic exposes x0 only, so the child is identified by comparing the
-- returned child pid with getpid().
fn main_test_now_millis() -> i64 {
  let mark = alloc_bump_mark()
  let timeval = alloc_zeroed(16)
  let status = sys_raw(116, timeval, 0, 0, 0, 0, 0)
  let result = if status < 0 { 0 - 1 }
  else { mem_load64_at(timeval, 0) * 1000 + mem_load64_at(timeval, 8) / 1000 }
  alloc_bump_restore_same_segment(mark)
  result
}

fn main_test_decimal_len(value: i64) -> i64 {
  if value < 10 { 1 } else { 1 + main_test_decimal_len(value / 10) }
}

fn main_test_write_decimal(dst: i64, pos: i64, value: i64) -> i64 {
  let next = if value < 10 { pos }
  else { main_test_write_decimal(dst, pos, value / 10) }
  mem_store8_at(dst, next, 48 + value - value / 10 * 10)
  next + 1
}

fn main_test_temp_path(index: i64) -> i64 {
  let prefix = "/tmp/weft-test-"
  let pid = sys_raw(20, 0, 0, 0, 0, 0, 0)
  let prefix_len = __str_len(prefix)
  let len = prefix_len + main_test_decimal_len(pid) + 1 + main_test_decimal_len(index)
  let path = alloc_zeroed(len + 1)
  mem_copy(path, __str_ptr(prefix), prefix_len)
  let after_pid = main_test_write_decimal(path, prefix_len, pid)
  mem_store8_at(path, after_pid, 45)
  main_test_write_decimal(path, after_pid + 1, index)
  path
}

fn main_test_result_path(index: i64) -> i64 {
  let prefix = "/tmp/weft-test-result-"
  let pid = sys_raw(20, 0, 0, 0, 0, 0, 0)
  let prefix_len = __str_len(prefix)
  let len = prefix_len + main_test_decimal_len(pid) + 1 + main_test_decimal_len(index)
  let path = alloc_zeroed(len + 1)
  mem_copy(path, __str_ptr(prefix), prefix_len)
  let after_pid = main_test_write_decimal(path, prefix_len, pid)
  mem_store8_at(path, after_pid, 45)
  main_test_write_decimal(path, after_pid + 1, index)
  path
}

fn main_test_object_path(index: i64) -> i64 {
  let prefix = "/tmp/weft-test-object-"
  let pid = sys_raw(20, 0, 0, 0, 0, 0, 0)
  let prefix_len = __str_len(prefix)
  let len = prefix_len + main_test_decimal_len(pid) + 1 + main_test_decimal_len(index)
  let path = alloc_zeroed(len + 1)
  mem_copy(path, __str_ptr(prefix), prefix_len)
  let after_pid = main_test_write_decimal(path, prefix_len, pid)
  mem_store8_at(path, after_pid, 45)
  main_test_write_decimal(path, after_pid + 1, index)
  path
}

fn main_test_write_all(fd: i64, ptr: i64, len: i64) -> i64 {
  let mut offset = 0
  let mut error = 0
  while offset < len and error == 0 {
    let wrote = sys_write(fd, ptr + offset, len - offset)
    if wrote > 0 { offset = offset + wrote }
    else { error = if wrote < 0 { 0 - wrote } else { 5 } }
  }
  error
}

fn main_test_wait_blocking(pid: i64, status_ptr: i64) -> i64 {
  let mut done = 0
  let mut result = 0
  while done == 0 {
    let waited = sys_raw(7, pid, status_ptr, 0, 0, 0, 0)
    if waited == 0 - 4 { 0 }
    else {
      result = waited
      done = 1
    }
  }
  result
}

fn main_test_decode_wait_status(status_ptr: i64) -> i64 {
  let raw = mem_load64_at(status_ptr, 0)
  let signal = raw band 127
  if signal == 0 { (raw bshr 8) band 255 } else { 128 + signal }
}

-- 256 denotes a runner timeout and 257 a spawn/wait platform error. Child
-- exit statuses remain the ordinary 0..255 range.
fn main_test_wait(pid: i64, timeout_millis: i64) -> i64 {
  let mark = alloc_bump_mark()
  let status_ptr = alloc_zeroed(8)
  let pause = alloc_zeroed(16)
  let start = main_test_now_millis()
  let deadline = if start < 0 { 0 - 1 } else { start + timeout_millis }
  let mut done = 0
  let mut result = 257
  while done == 0 {
    let waited = sys_raw(7, pid, status_ptr, 1, 0, 0, 0)
    if waited == pid {
      result = main_test_decode_wait_status(status_ptr)
      done = 1
    } else { if waited < 0 and waited != 0 - 4 {
      result = 257
      done = 1
    } else {
      let now = main_test_now_millis()
      if deadline >= 0 and (now < 0 or now >= deadline) {
        sys_raw(37, pid, 9, 0, 0, 0, 0)
        let reaped = main_test_wait_blocking(pid, status_ptr)
        result = if reaped == pid { 256 } else { 257 }
        done = 1
      } else {
        -- select(0, NULL, NULL, NULL, 10ms) is the fixed-arity syscall sleep
        -- available on Darwin; nanosleep itself is a libc-only entry here.
        mem_store64_at(pause, 0, 0)
        mem_store64_at(pause, 8, 10000)
        sys_raw(93, 0, 0, 0, 0, pause, 0)
      }
    } }
  }
  alloc_bump_restore_same_segment(mark)
  result
}

type MainTestStructuredResult {
  MainTestStructuredResult(i64, i64, i64), -- passed, failed, total
  InvalidMainTestStructuredResult
}

fn main_test_parse_result_count(raw: i64, n: i64, pos_cell: i64, delimiter: i64) -> i64 {
  let start = mem_load64_at(pos_cell, 0)
  let mut pos = start
  let mut value = 0
  while pos < n and mem_load8_at(raw, pos) >= 48 and mem_load8_at(raw, pos) <= 57 {
    value = value * 10 + mem_load8_at(raw, pos) - 48
    pos = pos + 1
  }
  if pos == start or pos >= n or mem_load8_at(raw, pos) != delimiter {
    0 - 1
  } else {
    mem_store64_at(pos_cell, 0, pos + 1)
    value
  }
}

fn main_test_parse_result_file(path: i64) -> MainTestStructuredResult {
  let file = read_cpath_file(path, cstr_len(path))
  let raw = mem_load64_at(file, 0)
  let n = mem_load64_at(file, 8)
  let prefix = "WEFT_TEST_RESULT 1 "
  let prefix_len = __str_len(prefix)
  if n <= prefix_len or src_eq_at(raw, 0, __str_ptr(prefix), 0, prefix_len) == 0 {
    InvalidMainTestStructuredResult
  } else {
    let pos_cell = main_alloc_bytes(8)
    mem_store64_at(pos_cell, 0, prefix_len)
    let passed = main_test_parse_result_count(raw, n, pos_cell, 32)
    let failed = main_test_parse_result_count(raw, n, pos_cell, 32)
    let total = main_test_parse_result_count(raw, n, pos_cell, 10)
    if passed < 0 or failed < 0 or total < 0 or mem_load64_at(pos_cell, 0) != n or passed + failed != total {
      InvalidMainTestStructuredResult
    } else {
      MainTestStructuredResult(passed, failed, total)
    }
  }
}

fn main_test_emit_structured_result(result: MainTestStructuredResult) -> i64 {
  match result {
    MainTestStructuredResult(passed, failed, total) -> {
      let line = buf_new(64)
      bstr(line, "WEFT_TEST_RESULT 1 ")
      lsp_buf_append_i(line, passed)
      bu8(line, 32)
      lsp_buf_append_i(line, failed)
      bu8(line, 32)
      lsp_buf_append_i(line, total)
      bu8(line, 10)
      sys_write(2, buf_ptr(line), buf_len(line))
    }
    InvalidMainTestStructuredResult -> 0
  }
}

fn main_test_consume_structured_result(result: MainTestStructuredResult, child_status: i64) -> i64 {
  match result {
    MainTestStructuredResult(passed, failed, total) -> {
      let expected_status = if failed == 0 { 0 } else { 1 }
      if child_status != expected_status {
        260
      } else {
        main_test_emit_structured_result(result)
        expected_status
      }
    }
    InvalidMainTestStructuredResult -> 260
  }
}

-- GOT-bearing tests are native Mach-O objects. Invoke the platform compiler
-- driver as a linker so it selects the installed macOS SDK without a shell or
-- an SDK-path discovery subprocess. This runner-only path does not add a GOT
-- dependency to the directly executable self-hosted compiler.
fn main_test_link_object(object_path: i64, executable_path: i64, envp: i64) -> i64 {
  let clang_name = "/usr/bin/clang"
  let output_flag = "-o"
  let clang_path = main_test_copy_cpath(__str_ptr(clang_name), __str_len(clang_name))
  let dash_o = main_test_copy_cpath(__str_ptr(output_flag), __str_len(output_flag))
  let child_argv = alloc_zeroed(40)
  mem_store64_at(child_argv, 0, clang_path)
  mem_store64_at(child_argv, 8, dash_o)
  mem_store64_at(child_argv, 16, executable_path)
  mem_store64_at(child_argv, 24, object_path)
  let fork_result = sys_raw(2, 0, 0, 0, 0, 0, 0)
  if fork_result < 0 { 257 }
  else {
    let current_pid = sys_raw(20, 0, 0, 0, 0, 0, 0)
    if fork_result == current_pid {
      sys_raw(59, clang_path, child_argv, envp, 0, 0, 0)
      sys_exit(127)
    } else {
      main_test_wait(fork_result, 120000)
    }
  }
}

fn main_test_run_binary(binary: BinaryObject, envp: i64, index: i64) -> i64 {
  match binary {
    BinaryObject(bytes, kind) -> {
      let executable_kind = pipeline_binary_kind_macho_executable()
      let object_kind = pipeline_binary_kind_macho_object()
      if kind != executable_kind and kind != object_kind {
        eprint("test: native runner cannot execute this binary format\n")
        258
      } else {
        let mark = alloc_bump_mark()
        let path = main_test_temp_path(index)
        let object_path = main_test_object_path(index)
        let result_path = main_test_result_path(index)
        let write_path = if kind == object_kind { object_path } else { path }
        -- A live process cannot share our pid, so this only clears a stale file
        -- left by a crashed earlier process after pid reuse.
        sys_unlink(path)
        sys_unlink(object_path)
        sys_unlink(result_path)
        let fd = sys_open(write_path, 1537, 448)
        let write_error = if fd < 0 { 0 - fd }
        else {
          let error = main_test_write_all(fd, buf_ptr(bytes), buf_len(bytes))
          sys_close(fd)
          error
        }
        let link_status = if write_error == 0 and kind == object_kind {
          main_test_link_object(object_path, path, envp)
        } else { 0 }
        if link_status != 0 {
          eprint("test: could not link relocatable test object with /usr/bin/clang\n")
        } else { 0 }
        let chmod_status = if write_error == 0 and link_status == 0 { sys_raw(15, path, 448, 0, 0, 0, 0) } else { 0 - 1 }
        let result = if write_error != 0 or chmod_status < 0 or link_status != 0 {
          259
        } else {
          let child_argv = alloc_zeroed(24)
          mem_store64_at(child_argv, 0, path)
          mem_store64_at(child_argv, 8, result_path)
          let fork_result = sys_raw(2, 0, 0, 0, 0, 0, 0)
          if fork_result < 0 { 257 }
          else {
            let current_pid = sys_raw(20, 0, 0, 0, 0, 0, 0)
            if fork_result == current_pid {
              sys_raw(59, path, child_argv, envp, 0, 0, 0)
              sys_exit(127)
            } else {
              let child_status = main_test_wait(fork_result, 120000)
              if child_status == 0 or child_status == 1 {
                main_test_consume_structured_result(main_test_parse_result_file(result_path), child_status)
              } else { child_status }
            }
          }
        }
        sys_unlink(path)
        sys_unlink(object_path)
        sys_unlink(result_path)
        alloc_bump_restore_same_segment(mark)
        result
      }
    }
  }
}

fn main_test_eprint_cpath(path: i64) -> i64 {
  sys_write(2, path, cstr_len(path))
}

fn main_test_report(path: i64, result: i64, elapsed_millis: i64) -> i64 {
  if result == 0 { eprint("  pass: ") } else { eprint("  FAIL: ") }
  main_test_eprint_cpath(path)
  eprint(" (")
  eprint_i(elapsed_millis)
  eprint(" ms")
  if result == 256 { eprint(", timeout") }
  else { if result != 0 { eprint(", exit ") eprint_i(if result > 255 { 1 } else { result }) } else { 0 } }
  eprint(")\n")
}

fn main_test_cpath_compare(left: i64, right: i64) -> i64 {
  let left_len = cstr_len(left)
  let right_len = cstr_len(right)
  let limit = if left_len < right_len { left_len } else { right_len }
  let mut i = 0
  let mut result = 0
  while i < limit and result == 0 {
    let a = mem_load8_at(left, i)
    let b = mem_load8_at(right, i)
    if a < b { result = 0 - 1 }
    else { if a > b { result = 1 } else { i = i + 1 } }
  }
  if result != 0 { result }
  else { if left_len < right_len { 0 - 1 }
  else { if left_len > right_len { 1 } else { 0 } } }
}

fn main_test_paths_add_sorted(paths: i64, path: i64) -> i64 {
  let n = nlist_len(paths)
  let mut insert = n
  let mut duplicate = 0
  let mut i = 0
  while i < n and insert == n and duplicate == 0 {
    let comparison = main_test_cpath_compare(path, nlist_get(paths, i))
    if comparison == 0 { duplicate = 1 }
    else { if comparison < 0 { insert = i } else { i = i + 1 } }
  }
  if duplicate == 1 { 0 }
  else {
    nlist_add(paths, path)
    let data = mem_load64_at(paths, 0)
    let mut move = n
    while move > insert {
      mem_store64_at(data, move * 8, mem_load64_at(data, (move - 1) * 8))
      move = move - 1
    }
    mem_store64_at(data, insert * 8, path)
    1
  }
}

fn main_test_copy_cpath(src: i64, len: i64) -> i64 {
  let path = main_alloc_bytes(len + 1)
  mem_copy(path, src, len)
  mem_store8_at(path, len, 0)
  path
}

fn main_test_join_path(prefix: i64, prefix_len: i64, name: i64, name_len: i64) -> i64 {
  let path = main_alloc_bytes(prefix_len + name_len + 1)
  if prefix_len > 0 { mem_copy(path, prefix, prefix_len) } else { 0 }
  mem_copy(path + prefix_len, name, name_len)
  mem_store8_at(path, prefix_len + name_len, 0)
  path
}

fn main_test_name_is_dot(name: i64, len: i64) -> i64 {
  if len == 1 and mem_load8_at(name, 0) == 46 { 1 }
  else { if len == 2 and mem_load8_at(name, 0) == 46 and mem_load8_at(name, 1) == 46 { 1 }
  else { 0 } }
}

fn main_test_name_is_weft(name: i64, len: i64) -> i64 {
  if len < 5 { 0 }
  else {
    mem_load8_at(name, len - 5) == 46 and
      mem_load8_at(name, len - 4) == 119 and
      mem_load8_at(name, len - 3) == 101 and
      mem_load8_at(name, len - 2) == 102 and
      mem_load8_at(name, len - 1) == 116
  }
}

-- Match one path segment. Shell-compatible '*' and '?' are enough here:
-- unquoted richer globs are expanded by the invoking shell before we run.
fn main_test_glob_matches(name: i64, name_len: i64, pattern: i64, pattern_len: i64) -> i64 {
  let mut ni = 0
  let mut pi = 0
  let mut star = 0 - 1
  let mut retry = 0
  let mut failed = 0
  while ni < name_len and failed == 0 {
    if pi < pattern_len and (mem_load8_at(pattern, pi) == 63 or mem_load8_at(pattern, pi) == mem_load8_at(name, ni)) {
      ni = ni + 1
      pi = pi + 1
    } else { if pi < pattern_len and mem_load8_at(pattern, pi) == 42 {
      star = pi
      pi = pi + 1
      retry = ni
    } else { if star >= 0 {
      retry = retry + 1
      ni = retry
      pi = star + 1
    } else {
      failed = 1
    } } }
  }
  while pi < pattern_len and mem_load8_at(pattern, pi) == 42 { pi = pi + 1 }
  if failed == 0 and pi == pattern_len { 1 } else { 0 }
}

fn main_test_path_has_glob(path: i64, len: i64) -> i64 {
  let mut i = 0
  let mut found = 0
  while i < len and found == 0 {
    let c = mem_load8_at(path, i)
    if c == 42 or c == 63 { found = 1 } else { i = i + 1 }
  }
  found
}

fn main_test_path_last_slash(path: i64, len: i64) -> i64 {
  let mut i = 0
  let mut slash = 0 - 1
  while i < len {
    if mem_load8_at(path, i) == 47 { slash = i } else { 0 }
    i = i + 1
  }
  slash
}

-- Returns (kind, device, inode), where kind 1 is a directory and kind 2 is
-- another existing object. stat64 follows symlinks; the stable device/inode
-- identity lets recursive discovery follow useful aliases without cycles.
fn main_test_path_metadata(path: i64) -> i64 {
  let stat_buf = alloc_zeroed(144)
  let status = sys_raw(338, path, stat_buf, 0, 0, 0, 0)
  if status < 0 { 0 }
  else {
    let mode = mem_load8_at(stat_buf, 4) + mem_load8_at(stat_buf, 5) * 256
    let kind = if (mode band 61440) == 16384 { 1 } else { 2 }
    let device = mem_load8_at(stat_buf, 0) + mem_load8_at(stat_buf, 1) * 256 + mem_load8_at(stat_buf, 2) * 65536 + mem_load8_at(stat_buf, 3) * 16777216
    node_new(0, kind, device, mem_load64_at(stat_buf, 8), 0)
  }
}

fn main_test_directory_identity_add(visited: i64, metadata: i64) -> i64 {
  let device = node_f2(metadata)
  let inode = node_f3(metadata)
  let mut i = 0
  let mut duplicate = 0
  while i < nlist_len(visited) and duplicate == 0 {
    let identity = nlist_get(visited, i)
    if node_f1(identity) == device and node_f2(identity) == inode { duplicate = 1 }
    else { i = i + 1 }
  }
  if duplicate == 1 { 0 }
  else { nlist_add(visited, node_new(0, device, inode, 0, 0)) 1 }
}

-- pattern_len < 0 selects the directory form's canonical *.weft filter.
-- Darwin getdirentries64 records use the same 64-bit dirent layout pinned by
-- runtime/dir.weft: reclen@16, namlen@18, type@20, name@21.
fn main_test_collect_directory(paths: i64, dir_path: i64, prefix: i64, prefix_len: i64, pattern: i64, pattern_len: i64) -> i64 {
  let fd = sys_open(dir_path, 0, 0)
  if fd < 0 { fd }
  else {
    let buf = main_alloc_bytes(16384)
    let base = main_alloc_bytes(8)
    mem_store64_at(base, 0, 0)
    let mut done = 0
    let mut error = 0
    while done == 0 {
      let count = sys_raw(344, fd, buf, 16384, base, 0, 0)
      if count == 0 { done = 1 }
      else { if count < 0 {
        error = count
        done = 1
      } else {
        let mut offset = 0
        while offset < count and error == 0 {
          let entry = buf + offset
          let record_len = mem_load8_at(entry, 16) + mem_load8_at(entry, 17) * 256
          let name_len = mem_load8_at(entry, 18) + mem_load8_at(entry, 19) * 256
          if record_len < 21 or offset + record_len > count or name_len + 21 > record_len {
            error = 0 - 5
          } else {
            let name = entry + 21
            let entry_type = mem_load8_at(entry, 20)
            let selected = if main_test_name_is_dot(name, name_len) == 1 or entry_type == 4 { 0 }
            else { if pattern_len < 0 { main_test_name_is_weft(name, name_len) }
            else { main_test_glob_matches(name, name_len, pattern, pattern_len) } }
            if selected == 1 {
              main_test_paths_add_sorted(paths, main_test_join_path(prefix, prefix_len, name, name_len))
            } else { 0 }
            offset = offset + record_len
          }
        }
      } }
    }
    sys_close(fd)
    error
  }
}

-- Scan one directory for recursive discovery. The result carries
-- (read error, number of matching .weft entries); child directories are
-- inserted into the lexicographically sorted pending list exactly once per
-- followed filesystem identity.
fn main_test_collect_directory_level(paths: i64, pending: i64, visited: i64, dir_path: i64) -> i64 {
  let fd = sys_open(dir_path, 0, 0)
  if fd < 0 { node_new(0, fd, 0, 0, 0) }
  else {
    let dir_len = cstr_len(dir_path)
    let needs_slash = if dir_len > 0 and mem_load8_at(dir_path, dir_len - 1) == 47 { 0 } else { 1 }
    let prefix_len = dir_len + needs_slash
    let prefix = main_alloc_bytes(prefix_len + 1)
    mem_copy(prefix, dir_path, dir_len)
    if needs_slash == 1 { mem_store8_at(prefix, dir_len, 47) } else { 0 }
    mem_store8_at(prefix, prefix_len, 0)
    let buf = main_alloc_bytes(16384)
    let base = main_alloc_bytes(8)
    mem_store64_at(base, 0, 0)
    let mut done = 0
    let mut error = 0
    let mut matched = 0
    while done == 0 {
      let count = sys_raw(344, fd, buf, 16384, base, 0, 0)
      if count == 0 { done = 1 }
      else { if count < 0 {
        error = count
        done = 1
      } else {
        let mut offset = 0
        while offset < count and error == 0 {
          let entry = buf + offset
          let record_len = mem_load8_at(entry, 16) + mem_load8_at(entry, 17) * 256
          let name_len = mem_load8_at(entry, 18) + mem_load8_at(entry, 19) * 256
          if record_len < 21 or offset + record_len > count or name_len + 21 > record_len {
            error = 0 - 5
          } else {
            let name = entry + 21
            if main_test_name_is_dot(name, name_len) == 0 {
              let child = main_test_join_path(prefix, prefix_len, name, name_len)
              let metadata = main_test_path_metadata(child)
              if metadata != 0 and node_f1(metadata) == 1 {
                if main_test_directory_identity_add(visited, metadata) == 1 {
                  main_test_paths_add_sorted(pending, child)
                } else { 0 }
              } else { if metadata != 0 and main_test_name_is_weft(name, name_len) == 1 {
                matched = matched + 1
                main_test_paths_add_sorted(paths, child)
              } else { 0 } }
            } else { 0 }
            offset = offset + record_len
          }
        }
      } }
    }
    sys_close(fd)
    node_new(0, error, matched, 0, 0)
  }
}

fn main_test_collect_directory_recursive(paths: i64, root: i64, root_metadata: i64) -> i64 {
  let pending = nlist_new()
  let visited = nlist_new()
  main_test_directory_identity_add(visited, root_metadata)
  main_test_paths_add_sorted(pending, root)
  let mut i = 0
  let mut failed = 0
  let mut matched = 0
  while i < nlist_len(pending) {
    let dir_path = nlist_get(pending, i)
    let result = main_test_collect_directory_level(paths, pending, visited, dir_path)
    if node_f1(result) < 0 {
      main_test_eprint_path_error("test: could not list directory: ", dir_path)
      failed = 1
    } else { matched = matched + node_f2(result) }
    i = i + 1
  }
  if failed == 1 { 0 - 1 } else { matched }
}

fn main_test_eprint_path_error(prefix: str, path: i64) -> i64 {
  eprint(prefix)
  main_test_eprint_cpath(path)
  eprint("\n")
}

-- Returns one failed discovery input or zero. Ordinary file paths, including
-- missing ones, stay in the work list so the compiler produces the canonical
-- path-aware diagnostic.
fn main_test_expand_arg(paths: i64, arg: i64) -> i64 {
  let len = cstr_len(arg)
  if main_test_path_has_glob(arg, len) == 1 {
    let slash = main_test_path_last_slash(arg, len)
    let prefix_len = slash + 1
    let dir_path = if slash < 0 { __str_ptr(".") }
    else { main_test_copy_cpath(arg, if slash == 0 { 1 } else { slash }) }
    let pattern = arg + prefix_len
    let pattern_len = len - prefix_len
    let before = nlist_len(paths)
    let status = main_test_collect_directory(paths, dir_path, arg, prefix_len, pattern, pattern_len)
    if status < 0 {
      main_test_eprint_path_error("test: could not expand pattern: ", arg)
      1
    } else { if nlist_len(paths) == before {
      main_test_eprint_path_error("test: no test files matched: ", arg)
      1
    } else { 0 } }
  } else {
    let metadata = main_test_path_metadata(arg)
    if metadata != 0 and node_f1(metadata) == 1 {
      let status = main_test_collect_directory_recursive(paths, arg, metadata)
      if status < 0 {
        1
      } else { if status == 0 {
        main_test_eprint_path_error("test: no .weft files in directory: ", arg)
        1
      } else { 0 } }
  } else {
    main_test_paths_add_sorted(paths, arg)
    0
  } }
}

fn main_test_parse_jobs(raw: i64) -> i64 {
  let len = cstr_len(raw)
  let mut i = 0
  let mut value = 0
  let mut valid = if len == 0 { 0 } else { 1 }
  while i < len and valid == 1 {
    let digit = mem_load8_at(raw, i)
    if digit < 48 or digit > 57 { valid = 0 }
    else {
      value = value * 10 + digit - 48
      if value > 64 { valid = 0 } else { 0 }
      i = i + 1
    }
  }
  if valid == 1 and value > 0 { value } else { 0 }
}

fn main_test_spawn_worker(path: i64, envp: i64, index: i64) -> i64 {
  let fork_result = sys_raw(2, 0, 0, 0, 0, 0, 0)
  if fork_result < 0 { fork_result }
  else {
    let current_pid = sys_raw(20, 0, 0, 0, 0, 0, 0)
    if fork_result == current_pid {
      -- A separate process group lets the scheduler kill both this compiler
      -- worker and any test executable it has spawned at the outer deadline.
      sys_raw(82, 0, 0, 0, 0, 0, 0)
      let result = run_test_path_native(path, envp, index)
      sys_exit(if result > 255 { 1 } else { result })
      0
    } else {
      sys_raw(82, fork_result, fork_result, 0, 0, 0, 0)
      fork_result
    }
  }
}

fn main_test_find_free_worker(pids: i64, jobs: i64) -> i64 {
  let mut i = 0
  let mut found = 0 - 1
  while i < jobs and found < 0 {
    if mem_load64_at(pids, i * 8) == 0 { found = i } else { i = i + 1 }
  }
  found
}

fn main_test_pause_poll(pause: i64) -> i64 {
  mem_store64_at(pause, 0, 0)
  mem_store64_at(pause, 8, 10000)
  sys_raw(93, 0, 0, 0, 0, pause, 0)
}

fn main_test_run_paths_parallel(paths: i64, envp: i64, jobs: i64) -> i64 {
  let count = nlist_len(paths)
  let pids = alloc_zeroed(jobs * 8)
  let worker_paths = alloc_zeroed(jobs * 8)
  let starts = alloc_zeroed(jobs * 8)
  let status_ptr = alloc_zeroed(8)
  let pause = alloc_zeroed(16)
  let mut next = 0
  let mut active = 0
  let mut failed = 0
  while next < count or active > 0 {
    while next < count and active < jobs {
      let slot = main_test_find_free_worker(pids, jobs)
      let path = nlist_get(paths, next)
      let pid = main_test_spawn_worker(path, envp, next)
      if pid < 0 {
        main_test_report(path, 257, 0)
        failed = failed + 1
      } else {
        mem_store64_at(pids, slot * 8, pid)
        mem_store64_at(worker_paths, slot * 8, path)
        mem_store64_at(starts, slot * 8, main_test_now_millis())
        active = active + 1
      }
      next = next + 1
    }

    let mut progressed = 0
    let mut slot = 0
    while slot < jobs {
      let pid = mem_load64_at(pids, slot * 8)
      if pid != 0 {
        mem_store64_at(status_ptr, 0, 0)
        let waited = sys_raw(7, pid, status_ptr, 1, 0, 0, 0)
        let now = main_test_now_millis()
        let start = mem_load64_at(starts, slot * 8)
        let expired = start >= 0 and now >= start and now - start >= 240000
        let mut result = 0 - 1
        let mut complete = 0
        if waited == pid {
          result = main_test_decode_wait_status(status_ptr)
          complete = 1
        } else { if waited < 0 and waited != 0 - 4 {
          result = 257
          complete = 1
        } else { if expired {
          sys_raw(37, 0 - pid, 9, 0, 0, 0, 0)
          let reaped = main_test_wait_blocking(pid, status_ptr)
          result = if reaped == pid { 256 } else { 257 }
          complete = 1
        } else { 0 } } }

        if complete == 1 {
          let path = mem_load64_at(worker_paths, slot * 8)
          let elapsed = if start < 0 or now < start { 0 } else { now - start }
          main_test_report(path, result, elapsed)
          if result != 0 { failed = failed + 1 } else { 0 }
          mem_store64_at(pids, slot * 8, 0)
          active = active - 1
          progressed = 1
        } else { 0 }
      } else { 0 }
      slot = slot + 1
    }
    if active > 0 and progressed == 0 { main_test_pause_poll(pause) } else { 0 }
  }
  failed
}

fn run_test_paths(argc: i64, argv: i64, first_path: i64, jobs: i64) -> i64 {
  let envp = argv + (argc + 1) * 8
  let paths = nlist_new()
  let mut discovery_failures = 0
  for i in first_path..argc {
    discovery_failures = discovery_failures + main_test_expand_arg(paths, mem_load64_at(argv, i * 8))
  }
  let count = nlist_len(paths)
  let worker_failures = if count == 0 { 0 } else { main_test_run_paths_parallel(paths, envp, jobs) }
  let fail = discovery_failures + worker_failures
  let pass = count - worker_failures
  let final_fail = if count == 0 and fail == 0 {
    eprint("test: no test files provided\n")
    1
  } else { fail }
  eprint("\n")
  eprint_i(pass)
  eprint(" passed, ")
  eprint_i(final_fail)
  eprint(" failed\n")
  if final_fail == 0 { 0 } else { 1 }
}

fn run_pkg(argc: i64, argv: i64) -> i64 {
  if argc < 3 {
    pkg_stderr("usage: weft pkg init [name]\nusage: weft pkg add NAME PATH\nusage: weft pkg lock\nusage: weft pkg exports\n")
    1
  } else {
    let sub = mem_load64_at(argv, 16)
    if cstr_eq(sub, "init") == 1 {
      if argc > 3 {
        let name = mem_load64_at(argv, 24)
        pkg_cli_init(name, cstr_len(name))
      } else {
        pkg_cli_init(__str_ptr("app"), __str_len("app"))
      }
    } else { if cstr_eq(sub, "add") == 1 {
      if argc < 5 {
        pkg_stderr("usage: weft pkg add NAME PATH\n")
        1
      } else {
        let name = mem_load64_at(argv, 24)
        let path = mem_load64_at(argv, 32)
        pkg_cli_add(name, cstr_len(name), path, cstr_len(path))
      }
    } else { if cstr_eq(sub, "lock") == 1 {
      runtime_standalone_dir(() => pkg_cli_lock())
    } else { if cstr_eq(sub, "exports") == 1 {
      pkg_cli_exports()
    } else {
      pkg_stderr("pkg: unknown command\n")
      1
    } } } }
  }
}

-- Subcommand dispatch: weft [compile|fmt|check|ast] < input
-- Default (no args or "compile"): full compilation pipeline
fn main(argc: i64, argv: i64) -> i64 {
  if argc > 1 {
    let cmd = mem_load64_at(argv, 8)
    if cstr_eq(cmd, "fmt") == 1 {
      if argc > 2 { run_fmt_path(mem_load64_at(argv, 16)) } else { run_fmt() }
    }
    else { if cstr_eq(cmd, "check") == 1 {
      if argc > 2 { run_check_path(mem_load64_at(argv, 16)) } else { run_check() }
    }
    else { if cstr_eq(cmd, "ast") == 1 {
      if argc > 2 { run_ast_path(mem_load64_at(argv, 16)) } else { run_ast() }
    }
    else { if cstr_eq(cmd, "test") == 1 {
      if argc > 2 {
        let first = mem_load64_at(argv, 16)
        if cstr_eq(first, "--emit") == 1 {
          if argc == 3 { run_test() }
          else { if argc == 4 { run_test_path(mem_load64_at(argv, 24)) }
          else { eprint("usage: weft test [--emit <path>] [--jobs N] <path...>\n") 1 } }
        } else { if cstr_eq(first, "--jobs") == 1 or cstr_eq(first, "-j") == 1 {
          if argc < 5 {
            eprint("usage: weft test [--emit <path>] [--jobs N] <path...>\n")
            1
          } else {
            let jobs = main_test_parse_jobs(mem_load64_at(argv, 24))
            if jobs == 0 {
              eprint("test: --jobs must be an integer from 1 to 64\n")
              1
            } else { run_test_paths(argc, argv, 4, jobs) }
          }
        } else {
          run_test_paths(argc, argv, 2, 4)
        } }
      } else { run_test() }
    }
    else { if cstr_eq(cmd, "mcp") == 1 {
      if argc > 2 and cstr_eq(mem_load64_at(argv, 16), "serve") == 1 { run_mcp_serve() } else { run_mcp() }
    }
    else { if cstr_eq(cmd, "lsp") == 1 { run_lsp() }
    else { if cstr_eq(cmd, "pkg") == 1 { run_pkg(argc, argv) }
    else { if cstr_eq(cmd, "symbols") == 1 {
      if argc > 2 { run_symbols_path(mem_load64_at(argv, 16)) } else { 0 }
    }
    else { if cstr_eq(cmd, "compile") == 1 {
      if argc > 2 { compile_path(mem_load64_at(argv, 16)) }
      else {
        let input = read_stdin_all()
        let src = mem_load64_at(input, 0)
        let n = mem_load64_at(input, 8)
        compile(src, n)
      }
    }
    else {
      let input = read_stdin_all()
      let src = mem_load64_at(input, 0)
      let n = mem_load64_at(input, 8)
      compile(src, n)
    } } } } } } } } }
  } else {
    let input = read_stdin_all()
    let src = mem_load64_at(input, 0)
    let n = mem_load64_at(input, 8)
    compile(src, n)
  }
}

-- ======================================================================
-- Tool: symbols — dump emitted function offsets for profile attribution
-- Prints one authoritative native-provenance fact per emitted function,
-- using a checked declaration name where one exists and h<hash> otherwise.
-- ======================================================================

fn oprint(msg: str) -> i64 {
  sys_write(1, __str_ptr(msg), __str_len(msg))
}

fn oprint_i(n: i64) -> i64 {
  if n < 0 {
    oprint("-")
    oprint_i(0 - n)
  } else {
    if n < 10 {
      let b = alloc_words(1)
      mem_store8_at(b, 0, 48 + n)
      sys_write(1, b, 1)
    } else {
      oprint_i(n / 10)
      oprint_i(n - n / 10 * 10)
    }
  }
}

fn main_dump_symbol_facts(facts: PipelineNativeProvenanceFactList) -> i64 {
  match facts {
    PipelineNativeProvenanceFactNil -> 0
    PipelineNativeProvenanceFactCons(fact, rest) -> {
      match fact {
        PipelineNativeProvenanceFact(start, end, hash, framed, src, location) -> {
          oprint_i(start)
          oprint(" ")
          match location {
            PipelineNativeSourceUnknown -> { oprint("h") oprint_i(hash) }
            PipelineNativeSourceKnown(name_src, name_start, name_len, path_ptr, path_len, line, col) -> sys_write(1, name_src + name_start, name_len)
          }
          oprint("\n")
        }
      }
      main_dump_symbol_facts(rest)
    }
  }
}

fn main_dump_symbols(native: NativeModule) -> i64 {
  main_dump_symbol_facts(pipeline_native_provenance_facts(native))
}

fn run_symbols_path(path: i64) -> i64 {
  let plen = cstr_len(path)
  let file = read_cpath_file(path, plen)
  let src = mem_load64_at(file, 0)
  let n = mem_load64_at(file, 8)
  let typed = main_check_source_with_path_and_origin_and_grant(src, n, path, plen, cpath_is_trusted_source(path, plen), cpath_is_strict_source(path, plen), cpath_can_grant_import_trust(path, plen))
  let ir = pipeline_lower_ir(typed)
  let optimised = pipeline_optimise_typed_ir(typed, ir)
  let native = pipeline_lower_native_module(typed, optimised)
  main_dump_symbols(native)
}

-- ======================================================================
-- Tool: fmt — format source code (parse only, pure)
-- Opinionated, no configuration. Like go fmt.
-- Rules:
--   2-space indent
--   Spaces around binary operators
--   { on same line as if/fn/match/while/for/loop/handle
--   Short single-expression fns on one line
--   Trailing commas in multi-line constructs
--   Blank line between top-level declarations
--   use declarations grouped at top
-- ======================================================================

fn emit_indent(level: i64) -> i64 {
  for i in 0..level { eprint("  ") }
  0
}

fn fmt_op(op: i64) -> i64 {
  match op {
    1 -> eprint(" + ")
    2 -> eprint(" - ")
    3 -> eprint(" * ")
    4 -> eprint(" / ")
    5 -> eprint(" == ")
    6 -> eprint(" != ")
    7 -> eprint(" < ")
    8 -> eprint(" > ")
    9 -> eprint(" <= ")
    10 -> eprint(" >= ")
    11 -> eprint(" % ")
    12 -> eprint(" and ")
    13 -> eprint(" or ")
    14 -> eprint(" band ")
    15 -> eprint(" bor ")
    16 -> eprint(" bxor ")
    17 -> eprint(" bshl ")
    18 -> eprint(" bshr ")
    19 -> eprint(" |> ")
    20 -> eprint("..")
    _ -> { eprint(" <op:") eprint_i(op) eprint("> ") }
  }
  0
}

-- Is this a "simple" expression that fits on one line?
fn is_simple(node: i64) -> bool {
  let tag = node_tag(node)
  match tag {
    1 -> true    -- IntLit
    2 -> true    -- Ident
    9 -> true    -- StringLit
    24 -> true   -- BoolLit
    27 -> true   -- Continue
    54 -> true   -- FloatLit
    _ -> false
  }
}

fn fmt_expr(node: i64, src: i64, indent: i64) -> i64 {
  let tag = node_tag(node)
  match tag {
    1 -> if node_f3(node) > 0 { sys_write(2, src + node_f2(node), node_f3(node)) } else { eprint_i(node_f1(node)) }
    2 -> sys_write(2, src + node_f1(node), node_f2(node))
    54 -> sys_write(2, src + node_f1(node), node_f2(node))
    3 -> {
      fmt_expr(node_f2(node), src, indent)
      fmt_op(node_f1(node))
      fmt_expr(node_f3(node), src, indent)
    }
    4 -> {
      sys_write(2, src + node_f1(node), node_f2(node))
      eprint("(")
      let args = node_f3(node)
      let nargs = node_f4(node)
      for i in 0..nargs {
        if i > 0 { eprint(", ") } else { 0 }
        fmt_expr(nlist_get(args, i), src, indent)
      }
      eprint(")")
    }
    5 -> {
      eprint("if ")
      fmt_expr(node_f1(node), src, indent)
      eprint(" {\n")
      emit_indent(indent + 1)
      fmt_expr(node_f2(node), src, indent + 1)
      eprint("\n")
      emit_indent(indent)
      if node_f3(node) != 0 {
        eprint("} else {\n")
        emit_indent(indent + 1)
        fmt_expr(node_f3(node), src, indent + 1)
        eprint("\n")
        emit_indent(indent)
        eprint("}")
      } else { eprint("}") }
    }
    6 -> {
      eprint("let ")
      sys_write(2, src + node_f1(node), node_f2(node))
      eprint(" = ")
      fmt_expr(node_f3(node), src, indent)
      eprint("\n")
      emit_indent(indent)
      fmt_expr(node_f4(node), src, indent)
    }
    7 -> {
      fmt_expr(node_f1(node), src, indent)
      if node_f2(node) != 0 {
        eprint("\n")
        emit_indent(indent)
        fmt_expr(node_f2(node), src, indent)
      } else { 0 }
    }
    9 -> {
      eprint("\"")
      sys_write(2, src + node_f1(node), node_f2(node))
      eprint("\"")
    }
    10 -> {
      eprint("while ")
      fmt_expr(node_f1(node), src, indent)
      eprint(" {\n")
      emit_indent(indent + 1)
      fmt_expr(node_f2(node), src, indent + 1)
      eprint("\n")
      emit_indent(indent)
      eprint("}")
    }
    11 -> {
      eprint("let mut ")
      sys_write(2, src + node_f1(node), node_f2(node))
      eprint(" = ")
      fmt_expr(node_f3(node), src, indent)
      eprint("\n")
      emit_indent(indent)
      fmt_expr(node_f4(node), src, indent)
    }
    12 -> {
      sys_write(2, src + node_f1(node), node_f2(node))
      eprint(" = ")
      fmt_expr(node_f3(node), src, indent)
    }
    13 -> {
      -- FieldAccess: base.field
      fmt_expr(node_f1(node), src, indent)
      eprint(".")
      sys_write(2, src + node_f2(node), field_access_source_len(node_f3(node)))
    }
    14 -> {
      -- RecordInit: Type { field: val, ... }
      sys_write(2, src + node_f1(node), node_f2(node))
      eprint(" { ")
      let fields = node_f3(node)
      let nfields = node_f4(node)
      for i in 0..nfields {
        if i > 0 { eprint(", ") } else { 0 }
        let f = nlist_get(fields, i)
        sys_write(2, src + node_f1(f), node_f2(f))
        eprint(": ")
        fmt_expr(node_f3(f), src, indent)
      }
      eprint(" }")
    }
    15 -> {
      eprint("match ")
      fmt_expr(node_f1(node), src, indent)
      eprint(" {\n")
      let arms = node_f2(node)
      let narms = node_f3(node)
      for i in 0..narms {
        let arm = nlist_get(arms, i)
        emit_indent(indent + 1)
        fmt_pattern(node_f1(arm), src)
        if node_f3(arm) != 0 {
          eprint(" if ")
          fmt_expr(node_f3(arm), src, indent + 1)
        } else { 0 }
        eprint(" -> ")
        if is_simple(node_f2(arm)) {
          fmt_expr(node_f2(arm), src, indent + 1)
        } else {
          eprint("{\n")
          emit_indent(indent + 2)
          fmt_expr(node_f2(arm), src, indent + 2)
          eprint("\n")
          emit_indent(indent + 1)
          eprint("}")
        }
        eprint("\n")
      }
      emit_indent(indent)
      eprint("}")
    }
    22 -> { eprint("not ") fmt_expr(node_f1(node), src, indent) }
    24 -> { if node_f1(node) == 1 { eprint("true") } else { eprint("false") } }
    25 -> { eprint("return ") fmt_expr(node_f1(node), src, indent) }
    26 -> {
      -- Break
      eprint("break")
      if node_f1(node) != 0 {
        eprint("(")
        fmt_expr(node_f1(node), src, indent)
        eprint(")")
      } else { 0 }
    }
    27 -> eprint("continue")
    29 -> {
      -- Lambda
      let params = node_f1(node)
      let nparams = node_f3(node)
      if nparams == 1 {
        let p = nlist_get(params, 0)
        sys_write(2, src + node_f1(p), node_f2(p))
      } else {
        eprint("(")
        for i in 0..nparams {
          if i > 0 { eprint(", ") } else { 0 }
          let p = nlist_get(params, i)
          sys_write(2, src + node_f1(p), node_f2(p))
        }
        eprint(")")
      }
      eprint(" => ")
      fmt_expr(node_f2(node), src, indent)
    }
    32 -> {
      -- Perform: Effect.op(args) — f1=lhs, f2=op_ns, f3=op_nl, f4=args
      fmt_expr(node_f1(node), src, indent)
      eprint(".")
      sys_write(2, src + node_f2(node), node_f3(node))
      eprint("(")
      let args = node_f4(node)
      let nargs = nlist_len(args)
      for i in 0..nargs {
        if i > 0 { eprint(", ") } else { 0 }
        fmt_expr(nlist_get(args, i), src, indent)
      }
      eprint(")")
    }
    33 -> {
      -- Handle: f1=body, f2=clauses, f3=nclauses
      eprint("handle ")
      fmt_expr(node_f1(node), src, indent)
      eprint(" {\n")
      let clauses = node_f2(node)
      let nclauses = node_f3(node)
      for i in 0..nclauses {
        let clause = nlist_get(clauses, i)
        -- Clause: f1=name_info(eff_ns, eff_nl, op_ns, op_nl), f2=params, f3=body
        let names = node_f1(clause)
        emit_indent(indent + 1)
        sys_write(2, src + node_f1(names), node_f2(names))
        eprint(".")
        sys_write(2, src + node_f3(names), node_f4(names))
        eprint("(")
        let cparams = node_f2(clause)
        let ncp = nlist_len(cparams)
        for j in 0..ncp {
          if j > 0 { eprint(", ") } else { 0 }
          let cp = nlist_get(cparams, j)
          sys_write(2, src + node_f1(cp), node_f2(cp))
        }
        eprint(") -> ")
        if is_simple(node_f3(clause)) {
          fmt_expr(node_f3(clause), src, indent + 1)
        } else {
          eprint("{\n")
          emit_indent(indent + 2)
          fmt_expr(node_f3(clause), src, indent + 2)
          eprint("\n")
          emit_indent(indent + 1)
          eprint("}")
        }
        eprint("\n")
      }
      -- 4c: return clause (handle f4)
      let hret = node_f4(node)
      if hret != 0 {
        emit_indent(indent + 1)
        eprint("return ")
        sys_write(2, src + node_f1(hret), node_f2(hret))
        eprint(" -> ")
        if is_simple(node_f3(hret)) {
          fmt_expr(node_f3(hret), src, indent + 1)
        } else {
          eprint("{\n")
          emit_indent(indent + 2)
          fmt_expr(node_f3(hret), src, indent + 2)
          eprint("\n")
          emit_indent(indent + 1)
          eprint("}")
        }
        eprint("\n")
      } else { 0 }
      emit_indent(indent)
      eprint("}")
    }
    35 -> {
      -- Resume
      eprint("resume(")
      fmt_expr(node_f1(node), src, indent)
      eprint(")")
    }
    36 -> {
      -- GenericCall: inner call with type args
      -- f1=type_args, f2=inner_call
      fmt_expr(node_f2(node), src, indent)
    }
    37 -> {
      -- LetTyped: inner let with type annotation
      fmt_expr(node_f1(node), src, indent)
    }
    41 -> {
      -- MethodCall: recv.method(args) with type hash
      -- f1=recv, f2=method_hash, f3=args, f4=type_hash
      fmt_expr(node_f1(node), src, indent)
    }
    45 -> {
      -- Try: expr?
      fmt_expr(node_f1(node), src, indent)
      eprint("?")
    }
    46 -> {
      -- InterpConcat: string interpolation
      fmt_expr(node_f1(node), src, indent)
      fmt_expr(node_f2(node), src, indent)
    }
    47 -> {
      -- ForIter: for var in collection { body }
      eprint("for ")
      sys_write(2, src + node_f1(node), node_f2(node))
      eprint(" in ")
      fmt_expr(node_f3(node), src, indent)
      eprint(" {\n")
      emit_indent(indent + 1)
      fmt_expr(node_f4(node), src, indent + 1)
      eprint("\n")
      emit_indent(indent)
      eprint("}")
    }
    48 -> {
      -- OptChain: base?.field
      fmt_expr(node_f1(node), src, indent)
      eprint("?.")
      sys_write(2, src + node_f2(node), node_f3(node))
    }
    49 -> {
      -- Loop
      eprint("loop {\n")
      emit_indent(indent + 1)
      fmt_expr(node_f1(node), src, indent + 1)
      eprint("\n")
      emit_indent(indent)
      eprint("}")
    }
    _ -> { eprint("<expr:") eprint_i(tag) eprint(">") }
  }
  0
}

fn fmt_pattern(pat: i64, src: i64) -> i64 {
  let tag = node_tag(pat)
  match tag {
    17 -> eprint("_")
    18 -> sys_write(2, src + node_f1(pat), node_f2(pat))
    19 -> eprint_i(node_f1(pat))
    20 -> {
      sys_write(2, src + node_f1(pat), node_f2(pat))
      let count = node_f4(pat)
      if count > 0 {
        eprint("(")
        if count < 0 {
          -- Multi-binding: f3 is a bindings list
          let binds = node_f3(pat)
          let nb = 0 - count
          for i in 0..nb {
            if i > 0 { eprint(", ") } else { 0 }
            let b = nlist_get(binds, i)
            fmt_pattern(b, src)
          }
        } else {
          -- Single binding
          sys_write(2, src + node_f3(pat), count)
        }
        eprint(")")
      } else { 0 }
    }
    _ -> eprint("?")
  }
  0
}

fn fmt_params_typed(params: ParamList, src: i64, seen: i64) -> i64 {
  match params {
    ParamListNil -> 0
    ParamListCons(param, rest) -> {
      if seen > 0 { eprint(", ") } else { 0 }
      match param {
        Param(ns, nl, ty, label) -> sys_write(2, src + ns, nl)
        UnknownParam(tag) -> eprint("_")
      }
      eprint(": i64")
      fmt_params_typed(rest, src, seen + 1)
    }
  }
}

fn fmt_fn_typed(ns: i64, nl: i64, params: ParamList, body: Expr, fn_src: i64) -> i64 {
  let body_node = expr_to_node(body)
  eprint("fn ")
  sys_write(2, fn_src + ns, nl)
  eprint("(")
  fmt_params_typed(params, fn_src, 0)
  eprint(") -> i64 ")
  -- Short functions on one line
  if is_simple(body_node) {
    eprint("{ ")
    fmt_expr(body_node, fn_src, 1)
    eprint(" }\n")
  } else {
    eprint("{\n")
    emit_indent(1)
    fmt_expr(body_node, fn_src, 1)
    eprint("\n}\n")
  }
  eprint("\n")
}

fn fmt_test_typed(ns: i64, nl: i64, body: Expr, test_src: i64) -> i64 {
  let body_node = expr_to_node(body)
  eprint("test \"")
  sys_write(2, test_src + ns, nl)
  eprint("\" ")
  if is_simple(body_node) {
    eprint("{ ")
    fmt_expr(body_node, test_src, 1)
    eprint(" }\n")
  } else {
    eprint("{\n")
    emit_indent(1)
    fmt_expr(body_node, test_src, 1)
    eprint("\n}\n")
  }
  eprint("\n")
}

fn fmt_decl_typed(decl: Decl, decl_src: i64) -> i64 {
  match decl {
    FnDecl(ns, nl, params, body) -> fmt_fn_typed(ns, nl, params, body, decl_src)
    FnDeclWrapped(inner, ret_type, eff_sig, tparams) -> fmt_decl_typed(inner, decl_src)
    TestDecl(ns, nl, body) -> fmt_test_typed(ns, nl, body, decl_src)
    _ -> 0
  }
}

fn run_fmt_source(src: i64, n: i64, trusted: i64) -> i64 {
  let ast = pipeline_parse_source_with_trust(src, n, trusted)
  let fns = pipeline_ast_fns(ast)
  let nfns = nlist_len(fns)
  for i in 0..nfns {
    let pair = nlist_get(fns, i)
    fmt_decl_typed(decl_from_node(node_f1(pair)), node_f2(pair))
  }
  0
}

fn run_fmt_path(path: i64) -> i64 {
  let len = cstr_len(path)
  let file = read_cpath_file(path, len)
  let src = mem_load64_at(file, 0)
  let n = mem_load64_at(file, 8)
  if n <= 0 {
    eprint("fmt: could not read input file\n")
    1
  } else {
    run_fmt_source(src, n, cpath_is_trusted_source(path, len))
  }
}

fn run_fmt() -> i64 {
  let input = read_stdin_all()
  run_fmt_source(mem_load64_at(input, 0), mem_load64_at(input, 8), 0)
}

-- ======================================================================
-- Tool: check — type check only (parse + check, no codegen)
-- ======================================================================

fn test_tool_prefix() -> str {
  let prefix = buf_new(32)
  bstr(prefix, "use stdlib/test.")
  bu8(prefix, 123)
  bu8(prefix, 42)
  bu8(prefix, 125)
  bu8(prefix, 32)
  runtime_str_from_bytes_copy(buf_ptr(prefix), buf_len(prefix))
}

fn test_source_with_prefix(raw: i64, raw_n: i64) -> i64 {
  test_source_with_prefix_and_wrappers(raw, raw_n, 0)
}

fn test_append_wrapper_name_bank(buf: i64, index: i64, count: i64) -> i64 {
  if index >= count { buf_len(buf) }
  else {
    test_append_harness_test_wrapper_name(buf, index)
    buf_append_str(buf, " ")
    test_append_wrapper_name_bank(buf, index + 1, count)
  }
}

fn test_source_with_prefix_and_wrappers(raw: i64, raw_n: i64, wrapper_count: i64) -> i64 {
  let prefix = test_tool_prefix()
  let prefix_len = __str_len(prefix)
  let bank = buf_new(128)
  let bank_len = if wrapper_count <= 0 {
    0
  } else {
    buf_append_str(bank, "\n-- ")
    test_append_wrapper_name_bank(bank, 0, wrapper_count)
  }
  let src = main_alloc_bytes(prefix_len + raw_n + bank_len + 1)
  mem_copy(src, __str_ptr(prefix), prefix_len)
  mem_copy(src + prefix_len, raw, raw_n)
  if bank_len > 0 { mem_copy(src + prefix_len + raw_n, buf_ptr(bank), bank_len) } else { 0 }
  mem_store8_at(src + prefix_len + raw_n + bank_len, 0, 0)
  node_new(0, src, prefix_len + raw_n + bank_len, prefix_len + raw_n, 0)
}

fn test_source_wrapper_bank_start(prefixed: i64) -> i64 {
  node_f3(prefixed)
}

type TestHarnessDeclEntry {
  TestHarnessDeclEntry(Decl, i64), -- typed decl, source pointer
  UnknownTestHarnessDeclEntry
}

type TestHarnessDeclList {
  TestHarnessDeclListNil,
  TestHarnessDeclListCons(TestHarnessDeclEntry, TestHarnessDeclList)
}

fn test_harness_decl_entry_from_pair(pair: i64) -> TestHarnessDeclEntry {
  TestHarnessDeclEntry(decl_from_node(node_f1(pair)), node_f2(pair))
}

fn test_harness_decl_entry_is_test(entry: TestHarnessDeclEntry) -> i64 {
  match entry {
    TestHarnessDeclEntry(decl, decl_src) -> {
      match decl {
        TestDecl(ns, nl, body) -> 1
        _ -> 0
      }
    }
    UnknownTestHarnessDeclEntry -> 0
  }
}

fn test_harness_decl_list_empty() -> TestHarnessDeclList {
  TestHarnessDeclListNil
}

fn test_harness_decl_list_prepend(entry: TestHarnessDeclEntry, rest: TestHarnessDeclList) -> TestHarnessDeclList {
  TestHarnessDeclListCons(entry, rest)
}

fn test_harness_decl_list_len(entries: TestHarnessDeclList) -> i64 {
  match entries {
    TestHarnessDeclListNil -> 0
    TestHarnessDeclListCons(entry, rest) -> 1 + test_harness_decl_list_len(rest)
  }
}

fn test_harness_decl_list_reverse_into(entries: TestHarnessDeclList, acc: TestHarnessDeclList) -> TestHarnessDeclList {
  match entries {
    TestHarnessDeclListNil -> acc
    TestHarnessDeclListCons(entry, rest) -> test_harness_decl_list_reverse_into(rest, TestHarnessDeclListCons(entry, acc))
  }
}

fn test_harness_decl_list_reverse(entries: TestHarnessDeclList) -> TestHarnessDeclList {
  test_harness_decl_list_reverse_into(entries, TestHarnessDeclListNil)
}

fn fns_have_tests(fns: i64) -> i64 {
  let nfns = nlist_len(fns)
  let mut i = 0
  while i < nfns {
    let entry = test_harness_decl_entry_from_pair(nlist_get(fns, i))
    if test_harness_decl_entry_is_test(entry) == 1 { return 1 } else { 0 }
    i = i + 1
  }
  0
}

fn fns_test_count(fns: i64) -> i64 {
  let nfns = nlist_len(fns)
  let mut i = 0
  let mut count = 0
  while i < nfns {
    let entry = test_harness_decl_entry_from_pair(nlist_get(fns, i))
    if test_harness_decl_entry_is_test(entry) == 1 { count = count + 1 } else { 0 }
    i = i + 1
  }
  count
}

fn check_wrap_test_blocks(fns: i64, name_bank_start: i64, tt: i64) -> i64 {
  let regular = nlist_new()
  let nfns = nlist_len(fns)
  let test_effects = effect_sig_one(effect_name_hash(__str_ptr("Test"), 0, 4))
  let mut test_index = 0
  for i in 0..nfns {
    let pair = nlist_get(fns, i)
    let entry = test_harness_decl_entry_from_pair(pair)
    if test_harness_decl_entry_is_test(entry) == 1 {
      test_add_wrapper_for_entry(regular, entry, test_effects, test_index, name_bank_start, tt)
      test_index = test_index + 1
    } else {
      nlist_add(regular, pair)
    }
  }
  regular
}

fn run_check_report(nfns: i64, errors: i64) -> i64 {
  eprint("check: ")
  eprint_i(nfns)
  eprint(" functions, ")
  eprint_i(errors)
  eprint(" errors\n")
  if errors == 0 { 0 } else { 1 }
}

fn main_mark_root_origin_with_grant(tt: i64, src: i64, trusted: i64, strict: i64, can_grant_trust: i64) -> i64 {
  pipeline_mark_root_origin(tt, src, trusted, strict)
  if can_grant_trust == 1 {
    ttable_mark_source_trust_grant_source(tt, src)
  } else { 0 }
}

fn run_check_source_with_path(raw: i64, raw_n: i64, path_ptr: i64, path_len: i64, trusted: i64, strict: i64, can_grant_trust: i64) -> i64 {
  let grammar = weft_grammar()
  let probe_tt = ttable_new()
  main_mark_root_origin_with_grant(probe_tt, raw, trusted, strict, can_grant_trust)
  main_register_source_path(probe_tt, raw, raw_n, path_ptr, path_len)
  let probe_fns = pipeline_parse(grammar, raw, raw_n, probe_tt)
  if fns_have_tests(probe_fns) == 1 {
    let prefixed = test_source_with_prefix_and_wrappers(raw, raw_n, fns_test_count(probe_fns))
    let src = node_f1(prefixed)
    let n = node_f2(prefixed)
    let name_bank_start = test_source_wrapper_bank_start(prefixed)
    let tt = ttable_new()
    main_mark_root_origin_with_grant(tt, src, trusted, strict, can_grant_trust)
    main_register_source_path(tt, src, n, path_ptr, path_len)
    let fns = pipeline_parse(grammar, src, n, tt)
    let regular = check_wrap_test_blocks(fns, name_bank_start, tt)
    pipeline_bind_runtime_preludes(regular, src, tt)
    let errors = pipeline_check_fns_error_count(regular, src, tt)
    run_check_report(nlist_len(regular), errors)
  } else {
    pipeline_bind_runtime_preludes(probe_fns, raw, probe_tt)
    let errors = pipeline_check_fns_error_count(probe_fns, raw, probe_tt)
    run_check_report(nlist_len(probe_fns), errors)
  }
}

fn run_check_source(raw: i64, raw_n: i64, trusted: i64, strict: i64, can_grant_trust: i64) -> i64 {
  run_check_source_with_path(raw, raw_n, 0, 0, trusted, strict, can_grant_trust)
}

fn run_check_path(path: i64) -> i64 {
  let len = cstr_len(path)
  let file = read_cpath_file(path, len)
  let src = mem_load64_at(file, 0)
  let n = mem_load64_at(file, 8)
  if n <= 0 {
    eprint("check: could not read input file\n")
    1
  } else {
    run_check_source_with_path(src, n, path, len, cpath_is_trusted_source(path, len), cpath_is_strict_source(path, len), cpath_can_grant_import_trust(path, len))
  }
}

fn run_check() -> i64 {
  let input = read_stdin_all()
  run_check_source(mem_load64_at(input, 0), mem_load64_at(input, 8), 0, 1, 0)
}

-- ======================================================================
-- Tool: ast — dump AST structure (parse only)
-- ======================================================================

fn dump_node(node: i64, src: i64, indent: i64) -> i64 {
  let tag = node_tag(node)
  let mut j = 0
  while j < indent { eprint("  ") j = j + 1 }
  match tag {
    1 -> {
      eprint("IntLit(")
      if node_f3(node) > 0 { sys_write(2, src + node_f2(node), node_f3(node)) } else { eprint_i(node_f1(node)) }
      eprint(")\n")
    }
    2 -> { eprint("Ident(") sys_write(2, src + node_f1(node), node_f2(node)) eprint(")\n") }
    3 -> {
      eprint("BinOp(op=") eprint_i(node_f1(node)) eprint(")\n")
      dump_node(node_f2(node), src, indent + 1)
      dump_node(node_f3(node), src, indent + 1)
    }
    4 -> {
      eprint("Call(") sys_write(2, src + node_f1(node), node_f2(node))
      eprint(", nargs=") eprint_i(node_f4(node)) eprint(")\n")
    }
    5 -> {
      eprint("If\n")
      dump_node(node_f1(node), src, indent + 1)
      dump_node(node_f2(node), src, indent + 1)
      if node_f3(node) != 0 { dump_node(node_f3(node), src, indent + 1) } else { 0 }
    }
    6 -> {
      eprint("Let(") sys_write(2, src + node_f1(node), node_f2(node)) eprint(")\n")
      dump_node(node_f3(node), src, indent + 1)
      dump_node(node_f4(node), src, indent + 1)
    }
    7 -> {
      eprint("Block\n")
      dump_node(node_f1(node), src, indent + 1)
      if node_f2(node) != 0 { dump_node(node_f2(node), src, indent + 1) } else { 0 }
    }
    9 -> eprint("StringLit\n")
    54 -> { eprint("FloatLit(") sys_write(2, src + node_f1(node), node_f2(node)) eprint(")\n") }
    15 -> {
      eprint("Match(narms=") eprint_i(node_f3(node)) eprint(")\n")
      dump_node(node_f1(node), src, indent + 1)
    }
    24 -> {
      eprint("BoolLit(")
      if node_f1(node) == 1 { eprint("true") } else { eprint("false") }
      eprint(")\n")
    }
    52 -> {
      eprint("Defer\n")
      dump_node(node_f1(node), src, indent + 1)
      dump_node(node_f2(node), src, indent + 1)
    }
    37 -> {
      eprint("LetTyped(type_tag=") eprint_i(node_tag(node_f2(node))) eprint(", type_payload=") eprint_i(node_f1(node_f2(node))) eprint(")\n")
      dump_node(node_f1(node), src, indent + 1)
    }
    _ -> { eprint("Node(tag=") eprint_i(tag) eprint(")\n") }
  }
  0
}

fn ast_dump_decl(decl: Decl, decl_src: i64) -> i64 {
  match decl {
    TestDecl(ns, nl, body) -> {
      eprint("test ")
      sys_write(2, decl_src + ns, nl)
      eprint(":\n")
      dump_node(expr_to_node(body), decl_src, 1)
      eprint("\n")
    }
    FnDecl(ns, nl, params, body) -> {
      eprint("fn ")
      sys_write(2, decl_src + ns, nl)
      eprint(":\n")
      dump_node(expr_to_node(body), decl_src, 1)
      eprint("\n")
    }
    FnDeclWrapped(inner, ret_type, eff_sig, tparams) -> ast_dump_decl(inner, decl_src)
    _ -> {
      eprint("decl tag=")
      eprint_i(decl_tag(decl))
      eprint("\n\n")
    }
  }
}

fn run_ast_source(src: i64, n: i64, trusted: i64) -> i64 {
  let ast = pipeline_parse_source_with_trust(src, n, trusted)
  let fns = pipeline_ast_fns(ast)
  let nfns = nlist_len(fns)
  eprint("--- AST: ")
  eprint_i(nfns)
  eprint(" functions ---\n\n")
  for i in 0..nfns {
    let pair = nlist_get(fns, i)
    ast_dump_decl(decl_from_node(node_f1(pair)), node_f2(pair))
  }
  0
}

fn run_ast_path(path: i64) -> i64 {
  let len = cstr_len(path)
  let file = read_cpath_file(path, len)
  let src = mem_load64_at(file, 0)
  let n = mem_load64_at(file, 8)
  if n <= 0 {
    eprint("ast: could not read input file\n")
    1
  } else {
    run_ast_source(src, n, cpath_is_trusted_source(path, len))
  }
}

fn run_ast() -> i64 {
  let input = read_stdin_all()
  run_ast_source(mem_load64_at(input, 0), mem_load64_at(input, 8), 0)
}

-- ======================================================================
-- Tool: mcp — stateless JSON-RPC compiler-as-data queries
-- ======================================================================

-- MCP output writers append to a response buffer; the transport layer
-- (legacy one-shot envelope or the persistent serve loop) owns the
-- envelope and the actual stdout write.
fn mcp_write(b: i64, s: str) -> i64 {
  bstr(b, s)
  0
}

fn mcp_write_i(b: i64, n: i64) -> i64 {
  if n < 0 { mcp_write(b, "-") mcp_write_i(b, 0 - n) }
  else {
    if n < 10 {
      bu8(b, 48 + n)
    } else {
      mcp_write_i(b, n / 10)
      bu8(b, 48 + n - n / 10 * 10)
    }
    0
  }
}

fn mcp_write_json_byte(b: i64, ch: i64) -> i64 {
  bu8(b, ch)
  0
}

fn mcp_write_json_bytes(b: i64, ptr: i64, n: i64) -> i64 {
  mcp_write(b, "\"")
  let mut i = 0
  while i < n {
    let ch = mem_load8_at(ptr, i)
    if ch == 34 {
      mcp_write(b, "\\\"")
    } else { if ch == 92 {
      mcp_write(b, "\\\\")
    } else { if ch == 10 {
      mcp_write(b, "\\n")
    } else { if ch == 13 {
      mcp_write(b, "\\r")
    } else { if ch == 9 {
      mcp_write(b, "\\t")
    } else {
      if ch >= 32 { mcp_write_json_byte(b, ch) } else { 0 }
    } } } } }
    i = i + 1
  }
  mcp_write(b, "\"")
}

fn mcp_is_json_ws(ch: i64) -> i64 {
  match ch {
    32 -> 1
    10 -> 1
    13 -> 1
    9 -> 1
    _ -> 0
  }
}

fn mcp_skip_json_ws(src: i64, n: i64, pos: i64) -> i64 {
  let mut p = pos
  while p < n and mcp_is_json_ws(mem_load8_at(src, p)) == 1 {
    p = p + 1
  }
  p
}

fn mcp_json_result(ok: i64, pos: i64) -> i64 {
  let result = main_alloc_bytes(16)
  mem_store64_at(result, 0, ok)
  mem_store64_at(result, 8, pos)
  result
}

fn mcp_json_ok(pos: i64) -> i64 { mcp_json_result(1, pos) }
fn mcp_json_bad(pos: i64) -> i64 { mcp_json_result(0, pos) }
fn mcp_json_result_ok(result: i64) -> i64 { mem_load64_at(result, 0) }
fn mcp_json_result_pos(result: i64) -> i64 { mem_load64_at(result, 8) }

fn mcp_json_key_eq(src: i64, key_start: i64, key_len: i64, key: str) -> i64 {
  src_eq(src, key_start, key_len, key)
}

fn mcp_hex_digit_value(ch: i64) -> i64 {
  if ch >= 48 and ch <= 57 { ch - 48 }
  else { if ch >= 97 and ch <= 102 { ch - 87 }
  else { if ch >= 65 and ch <= 70 { ch - 55 }
  else { 0 - 1 } } }
}

-- Parse exactly four hex digits at pos; the code unit value, or -1.
fn mcp_json_hex4(src: i64, n: i64, pos: i64) -> i64 {
  if pos + 4 > n { 0 - 1 }
  else {
    let d0 = mcp_hex_digit_value(mem_load8_at(src, pos))
    let d1 = mcp_hex_digit_value(mem_load8_at(src + pos, 1))
    let d2 = mcp_hex_digit_value(mem_load8_at(src + pos, 2))
    let d3 = mcp_hex_digit_value(mem_load8_at(src + pos, 3))
    if d0 < 0 or d1 < 0 or d2 < 0 or d3 < 0 { 0 - 1 }
    else { d0 * 4096 + d1 * 256 + d2 * 16 + d3 }
  }
}

fn mcp_json_parse_string(src: i64, n: i64, pos: i64) -> i64 {
  if pos >= n { mcp_json_bad(pos) }
  else { if mem_load8_at(src, pos) != 34 { mcp_json_bad(pos) }
  else {
    let mut p = pos + 1
    let mut done = 0
    let mut ok = 1
    while p < n and done == 0 and ok == 1 {
      let ch = mem_load8_at(src, p)
      match ch {
        34 -> { done = 1 p = p + 1 }
        92 -> {
          if p + 1 >= n { ok = 0 }
          else {
            let esc = mem_load8_at(src + p, 1)
            match esc {
              34 -> { p = p + 2 }
              47 -> { p = p + 2 }
              92 -> { p = p + 2 }
              98 -> { p = p + 2 }
              102 -> { p = p + 2 }
              110 -> { p = p + 2 }
              114 -> { p = p + 2 }
              116 -> { p = p + 2 }
              117 -> {
                if mcp_json_hex4(src, n, p + 2) < 0 { ok = 0 } else { p = p + 6 }
              }
              _ -> { ok = 0 }
            }
          }
        }
        10 -> { ok = 0 }
        13 -> { ok = 0 }
        _ -> {
          if ch < 32 { ok = 0 } else { p = p + 1 }
        }
      }
    }
    if ok == 1 and done == 1 { mcp_json_ok(p) } else { mcp_json_bad(p) }
  } }
}

fn mcp_json_parse_literal(src: i64, n: i64, pos: i64, literal: str) -> i64 {
  let len = __str_len(literal)
  if pos + len > n { mcp_json_bad(pos) }
  else {
    if src_eq(src, pos, len, literal) == 1 { mcp_json_ok(pos + len) }
    else { mcp_json_bad(pos) }
  }
}

fn mcp_json_parse_number(src: i64, n: i64, pos: i64) -> i64 {
  let mut p = pos
  if p < n and mem_load8_at(src, p) == 45 { p = p + 1 } else { 0 }
  if p >= n { mcp_json_bad(pos) }
  else {
    let first = mem_load8_at(src, p)
    if is_digit(first) == 0 { mcp_json_bad(pos) }
    else {
      if first == 48 { p = p + 1 }
      else {
        while p < n and is_digit(mem_load8_at(src, p)) == 1 { p = p + 1 }
      }
      let mut ok = 1
      if p < n and mem_load8_at(src, p) == 46 {
        p = p + 1
        if p >= n { ok = 0 }
        else {
          let mut ndigits = 0
          while p < n and is_digit(mem_load8_at(src, p)) == 1 {
            p = p + 1
            ndigits = ndigits + 1
          }
          if ndigits == 0 { ok = 0 } else { 0 }
        }
      } else { 0 }
      if ok == 1 and p < n and (mem_load8_at(src, p) == 101 or mem_load8_at(src, p) == 69) {
        p = p + 1
        if p < n and (mem_load8_at(src, p) == 43 or mem_load8_at(src, p) == 45) { p = p + 1 } else { 0 }
        let mut ndigits = 0
        while p < n and is_digit(mem_load8_at(src, p)) == 1 {
          p = p + 1
          ndigits = ndigits + 1
        }
        if ndigits == 0 { ok = 0 } else { 0 }
      } else { 0 }
      if ok == 1 { mcp_json_ok(p) } else { mcp_json_bad(pos) }
    }
  }
}

fn mcp_json_parse_array(src: i64, n: i64, pos: i64) -> i64 {
  let mut p = mcp_skip_json_ws(src, n, pos + 1)
  if p < n and mem_load8_at(src, p) == 93 { mcp_json_ok(p + 1) }
  else {
    let mut ok = 1
    let mut done = 0
    while ok == 1 and done == 0 {
      let value = mcp_json_parse_value(src, n, p)
      if mcp_json_result_ok(value) == 0 { ok = 0 p = mcp_json_result_pos(value) }
      else {
        p = mcp_skip_json_ws(src, n, mcp_json_result_pos(value))
        if p < n and mem_load8_at(src, p) == 44 {
          p = mcp_skip_json_ws(src, n, p + 1)
        } else { if p < n and mem_load8_at(src, p) == 93 {
          p = p + 1
          done = 1
        } else { ok = 0 } }
      }
    }
    if ok == 1 { mcp_json_ok(p) } else { mcp_json_bad(p) }
  }
}

fn mcp_json_parse_object(src: i64, n: i64, pos: i64) -> i64 {
  let mut p = mcp_skip_json_ws(src, n, pos + 1)
  if p < n and mem_load8_at(src, p) == 125 { mcp_json_ok(p + 1) }
  else {
    let mut ok = 1
    let mut done = 0
    while ok == 1 and done == 0 {
      let key = mcp_json_parse_string(src, n, p)
      if mcp_json_result_ok(key) == 0 { ok = 0 p = mcp_json_result_pos(key) }
      else {
        p = mcp_skip_json_ws(src, n, mcp_json_result_pos(key))
        if p >= n or mem_load8_at(src, p) != 58 { ok = 0 }
        else {
          p = mcp_skip_json_ws(src, n, p + 1)
          let value = mcp_json_parse_value(src, n, p)
          if mcp_json_result_ok(value) == 0 { ok = 0 p = mcp_json_result_pos(value) }
          else {
            p = mcp_skip_json_ws(src, n, mcp_json_result_pos(value))
            if p < n and mem_load8_at(src, p) == 44 {
              p = mcp_skip_json_ws(src, n, p + 1)
            } else { if p < n and mem_load8_at(src, p) == 125 {
              p = p + 1
              done = 1
            } else { ok = 0 } }
          }
        }
      }
    }
    if ok == 1 { mcp_json_ok(p) } else { mcp_json_bad(p) }
  }
}

fn mcp_json_parse_value(src: i64, n: i64, pos: i64) -> i64 {
  let p = mcp_skip_json_ws(src, n, pos)
  if p >= n { mcp_json_bad(p) }
  else {
    let ch = mem_load8_at(src, p)
    match ch {
      34 -> mcp_json_parse_string(src, n, p)
      45 -> mcp_json_parse_number(src, n, p)
      48 -> mcp_json_parse_number(src, n, p)
      49 -> mcp_json_parse_number(src, n, p)
      50 -> mcp_json_parse_number(src, n, p)
      51 -> mcp_json_parse_number(src, n, p)
      52 -> mcp_json_parse_number(src, n, p)
      53 -> mcp_json_parse_number(src, n, p)
      54 -> mcp_json_parse_number(src, n, p)
      55 -> mcp_json_parse_number(src, n, p)
      56 -> mcp_json_parse_number(src, n, p)
      57 -> mcp_json_parse_number(src, n, p)
      91 -> mcp_json_parse_array(src, n, p)
      123 -> mcp_json_parse_object(src, n, p)
      102 -> mcp_json_parse_literal(src, n, p, "false")
      110 -> mcp_json_parse_literal(src, n, p, "null")
      116 -> mcp_json_parse_literal(src, n, p, "true")
      _ -> mcp_json_bad(p)
    }
  }
}

fn mcp_json_root_object_start(src: i64, n: i64) -> i64 {
  let start = mcp_skip_json_ws(src, n, 0)
  if start >= n { 0 - 1 }
  else { if mem_load8_at(src, start) != 123 { 0 - 1 }
  else {
    let parsed = mcp_json_parse_value(src, n, start)
    if mcp_json_result_ok(parsed) == 0 { 0 - 1 }
    else {
      let end = mcp_skip_json_ws(src, n, mcp_json_result_pos(parsed))
      if end == n { start } else { 0 - 1 }
    }
  } }
}

fn mcp_json_field_value_start(src: i64, n: i64, obj_start: i64, key_name: str) -> i64 {
  if obj_start < 0 { 0 - 1 }
  else { if obj_start >= n or mem_load8_at(src, obj_start) != 123 { 0 - 1 }
  else {
    let mut p = mcp_skip_json_ws(src, n, obj_start + 1)
    let mut result = 0 - 1
    let mut done = 0
    if p < n and mem_load8_at(src, p) == 125 { done = 1 } else { 0 }
    while done == 0 and p < n {
      let key_start = p + 1
      let key = mcp_json_parse_string(src, n, p)
      if mcp_json_result_ok(key) == 0 { done = 1 }
      else {
        let key_end = mcp_json_result_pos(key) - 1
        let key_len = key_end - key_start
        p = mcp_skip_json_ws(src, n, mcp_json_result_pos(key))
        if p >= n or mem_load8_at(src, p) != 58 { done = 1 }
        else {
          let value_start = mcp_skip_json_ws(src, n, p + 1)
          let value = mcp_json_parse_value(src, n, value_start)
          if mcp_json_result_ok(value) == 0 { done = 1 }
          else {
            if mcp_json_key_eq(src, key_start, key_len, key_name) == 1 {
              result = value_start
              done = 1
            } else {
              p = mcp_skip_json_ws(src, n, mcp_json_result_pos(value))
              if p < n and mem_load8_at(src, p) == 44 {
                p = mcp_skip_json_ws(src, n, p + 1)
              } else { done = 1 }
            }
          }
        }
      }
    }
    result
  } }
}

fn mcp_json_object_field_start(src: i64, n: i64, obj_start: i64, key_name: str) -> i64 {
  let value = mcp_json_field_value_start(src, n, obj_start, key_name)
  if value >= 0 and value < n and mem_load8_at(src, value) == 123 { value } else { 0 - 1 }
}

fn mcp_json_string_value_eq(src: i64, n: i64, value_start: i64, expected: str) -> i64 {
  if value_start < 0 or value_start >= n { 0 }
  else { if mem_load8_at(src, value_start) != 34 { 0 }
  else {
    let parsed = mcp_json_parse_string(src, n, value_start)
    if mcp_json_result_ok(parsed) == 0 { 0 }
    else {
      let content_start = value_start + 1
      let content_len = mcp_json_result_pos(parsed) - content_start - 1
      src_eq(src, content_start, content_len, expected)
    }
  } }
}

fn mcp_source_pair_missing() -> i64 {
  let pair = main_alloc_bytes(16)
  mem_store64_at(pair, 0, 0)
  mem_store64_at(pair, 8, 0)
  pair
}

fn mcp_decode_json_string_pair(src: i64, n: i64, value_start: i64) -> i64 {
  if value_start < 0 or value_start >= n { mcp_source_pair_missing() }
  else { if mem_load8_at(src, value_start) != 34 { mcp_source_pair_missing() }
  else {
    let parsed = mcp_json_parse_string(src, n, value_start)
    if mcp_json_result_ok(parsed) == 0 { mcp_source_pair_missing() }
    else {
    let end = mcp_json_result_pos(parsed) - 1
    let out = main_alloc_bytes(end - value_start + 1)
    let mut pos = value_start + 1
    let mut len = 0
    while pos < end {
      let ch = mem_load8_at(src, pos)
      if ch == 92 and pos + 1 < end {
          let next = mem_load8_at(src + pos, 1)
          if next == 117 {
            -- \uXXXX: decode the code unit (surrogate pairs combine into one
            -- code point) and emit UTF-8. The parser already validated hex.
            let mut cp = mcp_json_hex4(src, n, pos + 2)
            pos = pos + 6
            if cp >= 55296 and cp <= 56319 and pos + 6 <= end and mem_load8_at(src, pos) == 92 and mem_load8_at(src + pos, 1) == 117 {
              let lo = mcp_json_hex4(src, n, pos + 2)
              if lo >= 56320 and lo <= 57343 {
                cp = 65536 + (cp - 55296) * 1024 + (lo - 56320)
                pos = pos + 6
              } else { 0 }
            } else { 0 }
            if cp < 128 {
              mem_store8_at(out, len, cp)
              len = len + 1
            } else { if cp < 2048 {
              mem_store8_at(out, len, 192 + cp / 64)
              mem_store8_at(out, len + 1, 128 + cp % 64)
              len = len + 2
            } else { if cp < 65536 {
              mem_store8_at(out, len, 224 + cp / 4096)
              mem_store8_at(out, len + 1, 128 + (cp / 64) % 64)
              mem_store8_at(out, len + 2, 128 + cp % 64)
              len = len + 3
            } else {
              mem_store8_at(out, len, 240 + cp / 262144)
              mem_store8_at(out, len + 1, 128 + (cp / 4096) % 64)
              mem_store8_at(out, len + 2, 128 + (cp / 64) % 64)
              mem_store8_at(out, len + 3, 128 + cp % 64)
              len = len + 4
            } } }
          } else {
          if next == 110 {
            mem_store8_at(out, len, 10)
          } else { if next == 34 {
            mem_store8_at(out, len, 34)
          } else { if next == 92 {
            mem_store8_at(out, len, 92)
          } else { if next == 47 {
            mem_store8_at(out, len, 47)
          } else { if next == 114 {
            mem_store8_at(out, len, 13)
          } else { if next == 116 {
            mem_store8_at(out, len, 9)
          } else { if next == 98 {
            mem_store8_at(out, len, 8)
          } else { if next == 102 {
            mem_store8_at(out, len, 12)
          } else {
            mem_store8_at(out, len, next)
          } } } } } } } }
          pos = pos + 2
          len = len + 1
          }
        } else {
          mem_store8_at(out, len, ch)
          pos = pos + 1
          len = len + 1
        }
    }
    let pair = main_alloc_bytes(16)
    mem_store64_at(pair, 0, out)
    mem_store64_at(pair, 8, len)
    pair
    }
  } }
}

fn mcp_extract_argument_string(src: i64, n: i64, root: i64, key_name: str) -> i64 {
  let params = mcp_json_object_field_start(src, n, root, "params")
  let args = mcp_json_object_field_start(src, n, params, "arguments")
  let value = mcp_json_field_value_start(src, n, args, key_name)
  mcp_decode_json_string_pair(src, n, value)
}

fn mcp_extract_source(src: i64, n: i64, root: i64) -> i64 {
  mcp_extract_argument_string(src, n, root, "source")
}

fn mcp_extract_lookup_name(src: i64, n: i64, root: i64) -> i64 {
  mcp_extract_argument_string(src, n, root, "name")
}

fn mcp_extract_grammar_name(src: i64, n: i64, root: i64) -> i64 {
  mcp_extract_argument_string(src, n, root, "grammar")
}

fn mcp_extract_host_source(src: i64, n: i64, root: i64) -> i64 {
  mcp_extract_argument_string(src, n, root, "host_source")
}

fn mcp_buf_reset(b: i64) -> i64 {
  mem_store64_at(b, 8, 0)
  0
}

-- Discard any partial payload, store the error message as the buffer
-- content, and return the JSON-RPC error code. Dispatch paths return
-- this code upward; 0 always means "buffer holds a result payload".
fn mcp_emit_error(b: i64, code: i64, message: str) -> i64 {
  mcp_buf_reset(b)
  bstr(b, message)
  code
}

fn mcp_emit_tools_list(b: i64) -> i64 {
  mcp_write(b, "{\"schema_version\":1,\"tools\":[{\"name\":\"parse_summary\",\"stability\":\"internal\"},{\"name\":\"check_summary\",\"stability\":\"internal\"},{\"name\":\"ir_summary\",\"stability\":\"internal\"},{\"name\":\"type_lookup\",\"stability\":\"stable\"},{\"name\":\"effect_lookup\",\"stability\":\"stable\"},{\"name\":\"diagnostics\",\"stability\":\"stable\"},{\"name\":\"grammar_parse\",\"stability\":\"internal\"},{\"name\":\"grammar_check\",\"stability\":\"internal\"},{\"name\":\"grammar_diagnostics\",\"stability\":\"stable\"},{\"name\":\"opt_counters\",\"stability\":\"internal\"}]}")
}

fn mcp_tool_stability(tool: str) -> str {
  if src_eq(__str_ptr(tool), 0, __str_len(tool), "diagnostics") == 1 or
    src_eq(__str_ptr(tool), 0, __str_len(tool), "grammar_diagnostics") == 1 or
    src_eq(__str_ptr(tool), 0, __str_len(tool), "type_lookup") == 1 or
    src_eq(__str_ptr(tool), 0, __str_len(tool), "effect_lookup") == 1 { "stable" }
  else { "internal" }
}

fn mcp_begin_result(b: i64, tool: str) -> i64 {
  mcp_write(b, "{\"tool\":\"")
  mcp_write(b, tool)
  mcp_write(b, "\",\"ok\":true,\"schema_version\":1,\"stability\":\"")
  mcp_write(b, mcp_tool_stability(tool))
  mcp_write(b, "\"")
}

fn mcp_end_result(b: i64) -> i64 {
  mcp_write(b, "}")
}

fn mcp_parse_source_quiet(src: i64, n: i64) -> AstModule {
  handle pipeline_parse_source_with_diagnostics_and_origin(src, n, 0, 1) {
    Diagnose.report(diagnostic) -> resume(0)
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
}

fn mcp_check_source_quiet_inner_with_path(src: i64, n: i64, path_ptr: i64, path_len: i64) -[Diagnose]> TypedModule {
  let grammar = weft_grammar()
  let probe_tt = ttable_new()
  main_mark_root_origin_with_grant(probe_tt, src, 0, 1, 0)
  main_register_source_path(probe_tt, src, n, path_ptr, path_len)
  let probe_fns = pipeline_parse(grammar, src, n, probe_tt)
  if fns_have_tests(probe_fns) == 1 {
    let prefixed = test_source_with_prefix_and_wrappers(src, n, fns_test_count(probe_fns))
    let test_src = node_f1(prefixed)
    let test_n = node_f2(prefixed)
    let name_bank_start = test_source_wrapper_bank_start(prefixed)
    let tt = ttable_new()
    main_mark_root_origin_with_grant(tt, test_src, 0, 1, 0)
    main_register_source_path(tt, test_src, test_n, path_ptr, path_len)
    let fns = pipeline_parse(grammar, test_src, test_n, tt)
    let regular = check_wrap_test_blocks(fns, name_bank_start, tt)
    pipeline_bind_runtime_preludes(regular, test_src, tt)
    pipeline_check_fns_with_diagnostics(regular, test_src, tt)
  } else {
    pipeline_bind_runtime_preludes(probe_fns, src, probe_tt)
    pipeline_check_fns_with_diagnostics(probe_fns, src, probe_tt)
  }
}

fn mcp_check_source_quiet_with_path(src: i64, n: i64, path_ptr: i64, path_len: i64) -> TypedModule {
  handle mcp_check_source_quiet_inner_with_path(src, n, path_ptr, path_len) {
    Diagnose.report(diagnostic) -> resume(0)
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
}

fn mcp_check_source_quiet(src: i64, n: i64) -> TypedModule {
  mcp_check_source_quiet_with_path(src, n, 0, 0)
}

fn mcp_emit_parse_summary(b: i64, src: i64, n: i64) -> i64 {
  let ast = mcp_parse_source_quiet(src, n)
  let fns = pipeline_ast_fns(ast)
  let body = pipeline_ast_first_body_expr(ast)
  mcp_begin_result(b, "parse_summary")
  mcp_write(b, ",\"functions\":")
  mcp_write_i(b, main_fns_source_count(fns, src))
  mcp_write(b, ",\"first_body_tag\":")
  mcp_write_i(b, expr_tag(body))
  mcp_end_result(b)
}

fn mcp_emit_check_summary(b: i64, src: i64, n: i64) -> i64 {
  let typed = mcp_check_source_quiet(src, n)
  let fns = pipeline_typed_fns(typed)
  let body = pipeline_typed_first_body_expr(typed)
  mcp_begin_result(b, "check_summary")
  mcp_write(b, ",\"functions\":")
  mcp_write_i(b, main_fns_source_count(fns, mcp_typed_module_src(typed)))
  mcp_write(b, ",\"first_body_tag\":")
  mcp_write_i(b, expr_tag(body))
  mcp_end_result(b)
}

fn mcp_emit_ir_summary(b: i64, src: i64, n: i64) -> i64 {
  let grammar = weft_grammar()
  let probe_tt = ttable_new()
  main_mark_root_origin_with_grant(probe_tt, src, 0, 1, 0)
  let probe_fns = pipeline_parse(grammar, src, n, probe_tt)
  let mut check_src = src
  let mut check_tt = probe_tt
  let mut check_fns = probe_fns
  if fns_have_tests(probe_fns) == 1 {
    let prefixed = test_source_with_prefix_and_wrappers(src, n, fns_test_count(probe_fns))
    check_src = node_f1(prefixed)
    let test_n = node_f2(prefixed)
    let name_bank_start = test_source_wrapper_bank_start(prefixed)
    check_tt = ttable_new()
    main_mark_root_origin_with_grant(check_tt, check_src, 0, 1, 0)
    let fns = pipeline_parse(grammar, check_src, test_n, check_tt)
    check_fns = check_wrap_test_blocks(fns, name_bank_start, check_tt)
  } else { 0 }
  let check_errors = handle grammar.check(check_fns, check_src, check_tt) {
    Diagnose.report(diagnostic) -> resume(0)
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
  -- grammar.check above already checked; wrap the triple, don't re-check.
  let functions = if check_errors == 0 { pipeline_ir_functions(pipeline_lower_ir(TypedModule(check_fns, check_src, check_tt))) } else { ir_function_list_empty() }
  mcp_begin_result(b, "ir_summary")
  mcp_write(b, ",\"functions\":")
  mcp_write_i(b, ir_function_list_len_for_source(functions, check_src))
  mcp_write(b, ",\"blocks\":")
  mcp_write_i(b, ir_function_list_block_count_for_source(functions, check_src))
  mcp_write(b, ",\"insts\":")
  mcp_write_i(b, ir_function_list_inst_count_for_source(functions, check_src))
  mcp_end_result(b)
}

fn mcp_write_counter(b: i64, name: str, value: i64) -> i64 {
  mcp_write(b, ",\"")
  mcp_write(b, name)
  mcp_write(b, "\":")
  mcp_write_i(b, value)
}

-- Def-shape spill census: four buckets per shape class (loads-0 defs,
-- loads-1 defs, loads-2+ defs, loads-2+ load sum).
fn mcp_write_shape_census(b: i64, native: NativeModule, shape: i64, l0: str, l1: str, d2: str, ls: str) -> i64 {
  mcp_write_counter(b, l0, pipeline_native_shape_census_count(native, 0, shape))
  mcp_write_counter(b, l1, pipeline_native_shape_census_count(native, 1, shape))
  mcp_write_counter(b, d2, pipeline_native_shape_census_count(native, 2, shape))
  mcp_write_counter(b, ls, pipeline_native_shape_census_count(native, 3, shape))
  0
}

-- opt_counters: run the full optimise + native-lower pipeline and report the
-- optimizer's per-pass site counters and the native emission counters
-- (sp_load/sp_store are the roadmap §3.1 decision units). Read-only plumbing
-- over counters the passes already maintain.
fn mcp_emit_opt_counters(b: i64, src: i64, n: i64) -> i64 {
  let grammar = weft_grammar()
  let probe_tt = ttable_new()
  main_mark_root_origin_with_grant(probe_tt, src, 0, 1, 0)
  let probe_fns = pipeline_parse(grammar, src, n, probe_tt)
  let mut check_src = src
  let mut check_tt = probe_tt
  let mut check_fns = probe_fns
  if fns_have_tests(probe_fns) == 1 {
    let prefixed = test_source_with_prefix_and_wrappers(src, n, fns_test_count(probe_fns))
    check_src = node_f1(prefixed)
    let test_n = node_f2(prefixed)
    let name_bank_start = test_source_wrapper_bank_start(prefixed)
    check_tt = ttable_new()
    main_mark_root_origin_with_grant(check_tt, check_src, 0, 1, 0)
    let fns = pipeline_parse(grammar, check_src, test_n, check_tt)
    check_fns = check_wrap_test_blocks(fns, name_bank_start, check_tt)
  } else { 0 }
  -- This is a source-local analysis surface, not an emitted artifact. Bind
  -- only dependencies reached by the submitted program so the counters do
  -- not measure the compiler's universal fatal-reporting runtime.
  pipeline_bind_runtime_preludes(check_fns, check_src, check_tt)
  let check_errors = handle grammar.check(check_fns, check_src, check_tt) {
    Diagnose.report(diagnostic) -> resume(0)
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
  if check_errors != 0 {
    mcp_write(b, "{\"tool\":\"opt_counters\",\"ok\":false,\"reason\":\"check errors\"}")
  } else {
    let typed = TypedModule(check_fns, check_src, check_tt)
    let ir = pipeline_lower_ir(typed)
    let optimised = pipeline_optimise_typed_ir(typed, ir)
    -- Armed emission: the residency audit and the 2v allocation checker
    -- run over the emitted buffer, so their counters below are live.
    let native = pipeline_lower_native_module_with_audit(typed, optimised, 1)
    mcp_begin_result(b, "opt_counters")
    mcp_write_counter(b, "handler_inline_sites", pipeline_ir_handler_inline_sites(optimised))
    mcp_write_counter(b, "handler_residual_sites", pipeline_ir_handler_residual_sites(optimised))
    mcp_write_counter(b, "handler_evidence_candidate_sites", pipeline_ir_handler_evidence_candidate_sites(optimised))
    mcp_write_counter(b, "const_fold_sites", pipeline_ir_const_fold_sites(optimised))
    mcp_write_counter(b, "algebraic_fold_sites", pipeline_ir_algebraic_fold_sites(optimised))
    mcp_write_counter(b, "dead_inst_sites", pipeline_ir_dead_inst_sites(optimised))
    mcp_write_counter(b, "pure_call_dce_sites", pipeline_ir_pure_call_dce_sites(optimised))
    mcp_write_counter(b, "match_final_arm_elision_sites", pipeline_ir_match_final_arm_elision_sites(optimised))
    mcp_write_counter(b, "block_entry_narrowing_sites", pipeline_ir_block_entry_narrowing_sites(optimised))
    mcp_write_counter(b, "direct_call_inline_sites", pipeline_ir_direct_call_inline_sites(optimised))
    mcp_write_counter(b, "functions", pipeline_native_function_count(native))
    mcp_write_counter(b, "insts", pipeline_native_inst_count(native))
    mcp_write_counter(b, "sp_load", pipeline_native_sp_load_count(native))
    mcp_write_counter(b, "sp_store", pipeline_native_sp_store_count(native))
    mcp_write_counter(b, "sp_pair_load", pipeline_native_sp_pair_load_count(native))
    mcp_write_counter(b, "sp_pair_store", pipeline_native_sp_pair_store_count(native))
    mcp_write_counter(b, "sp_fp_pair_load", pipeline_native_sp_fp_pair_load_count(native))
    mcp_write_counter(b, "sp_fp_pair_store", pipeline_native_sp_fp_pair_store_count(native))
    mcp_write_counter(b, "rc_elision", pipeline_native_rc_elision_count(native))
    mcp_write_counter(b, "rc_borrowable_param_facts", pipeline_native_rc_borrowable_param_fact_count(native))
    mcp_write_counter(b, "managed_drop_specializations", pipeline_native_managed_drop_specialization_count(native))
    mcp_write_counter(b, "managed_reuse_candidates", pipeline_native_managed_reuse_candidate_count(native))
    mcp_write_counter(b, "managed_reuse_lowerings", pipeline_native_managed_reuse_lowering_count(native))
    mcp_write_counter(b, "static_pair_slots", pipeline_native_static_pair_slot_count(native))
    mcp_write_counter(b, "static_pair_sites", pipeline_native_static_pair_site_count(native))
    mcp_write_counter(b, "alloc_elisions", pipeline_native_alloc_elision_count(native))
    mcp_write_counter(b, "fusions", pipeline_native_fusion_count(native))
    mcp_write_counter(b, "indexed_bounds_elisions", pipeline_native_indexed_bounds_elision_count(native))
    mcp_write_counter(b, "indexed_full_bounds_elisions", pipeline_native_indexed_full_bounds_elision_count(native))
    mcp_write_counter(b, "vector_bounds_elisions", pipeline_native_vector_bounds_elision_count(native))
    mcp_write_counter(b, "vector_full_bounds_elisions", pipeline_native_vector_full_bounds_elision_count(native))
    mcp_write_counter(b, "vector_scaled_addrs", pipeline_native_vector_scaled_addr_count(native))
    mcp_write_counter(b, "vector_push_no_grows", pipeline_native_vector_push_no_grow_count(native))
    mcp_write_counter(b, "param_residents", pipeline_native_ir_param_resident_count(native))
    mcp_write_counter(b, "volatile_residents", pipeline_native_volatile_resident_count(native))
    mcp_write_counter(b, "call_window_residents", pipeline_native_call_window_resident_count(native))
    mcp_write_counter(b, "low_pool_residents", pipeline_native_low_pool_resident_count(native))
    mcp_write_counter(b, "dead_store_elisions", pipeline_native_dead_store_elision_count(native))
    mcp_write_counter(b, "remat_small_const_defs", pipeline_native_remat_probe_count(native, 0))
    mcp_write_counter(b, "remat_small_const_uses", pipeline_native_remat_probe_count(native, 1))
    mcp_write_counter(b, "remat_large_const_defs", pipeline_native_remat_probe_count(native, 2))
    mcp_write_counter(b, "remat_large_const_uses", pipeline_native_remat_probe_count(native, 3))
    mcp_write_counter(b, "remat_movn_const_defs", pipeline_native_remat_probe_count(native, 4))
