    mcp_write_counter(b, "leaf_small_fn_pairs", pipeline_native_leaf_probe_count(native, 3))
    mcp_write_counter(b, "crossblock_barrier_free_defs", pipeline_native_crossblock_probe_count(native, 0))
    mcp_write_counter(b, "crossblock_barrier_free_uses", pipeline_native_crossblock_probe_count(native, 1))
    mcp_write_counter(b, "residual_slotlike", pipeline_native_residual_probe_count(native, 0))
