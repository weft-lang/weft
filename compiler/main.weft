fn main_alloc_bytes(size: i64) -> i64 {
  alloc_words((size + 7) / 8)
}

-- ======================================================================
-- Main: read source, lex, parse, codegen, emit Mach-O
-- ======================================================================
-- The compile pipeline: parse → check → emit
-- Each phase is a function from pipeline.weft with declared effects.
-- Tools compose different subsets with different handlers.
fn main_write_binary(binary: BinaryObject) -> i64 {
  match binary {
    BinaryObject(o, kind) -> {
      if buf_len(o) == 0 {
        eprint("compile: no binary produced\n")
        1
      } else {
        sys_write(1, buf_ptr(o), buf_len(o))
        0
      }
    }
  }
}

fn compile(src: i64, n: i64, host: MainGrammarHost) -[SourceAcquire]> i64 {
  compile_with_origin(src, n, 0, 1, host)
}

fn compile_with_trust(src: i64, n: i64, trusted: i64, host: MainGrammarHost) -[SourceAcquire]> i64
{
  compile_with_origin(src, n, trusted, pipeline_strict_for_trust(trusted), host)
}

fn compile_with_origin(
  src: i64,
  n: i64,
  trusted: i64,
  strict: i64,
  host: MainGrammarHost
) -[SourceAcquire]> i64 {
  compile_with_origin_and_grant(src, n, trusted, strict, 0, host)
}

fn main_fns_have_root_main(fns: i64, src: i64) -> i64 {
  let nfns = nlist_len(fns)
  let mut i = 0
  while i < nfns {
    let pair = nlist_get(fns, i)
    if typeck_pair_is_root_entrypoint(pair, src) {
      return 1
    } else { 0 }
    i = i + 1
  }
  0
}

fn main_fns_source_count(fns: i64, src: i64) -> i64 {
  let nfns = nlist_len(fns)
  let mut count = 0
  for i in 0..nfns {
    if node_f2(nlist_get(fns, i)) == src { count = count + 1 } else { 0 }
  }
  count
}

fn main_register_source_path(
  tt: i64,
  src: i64,
  n: i64,
  path_ptr: i64,
  path_len: i64
) -[SourceAcquire]> i64 {
  -- Source origin and package identity belong to the host, before grammar
  -- parsing begins. Anonymous stdin roots also need a registered buffer so
  -- diagnostics can render excerpts and primary carets without a file path.
  let origin = SourceAcquire.sdk_origin()
  let sdk_package = handle pkg_install_sdk_for_table(tt, origin) {
    Diagnose.report(diagnostic) -> { pipeline_diagnose_render_report(tt, diagnostic) resume(0) }
    Diagnose.error(msg, span) -> { eprint(msg) resume(0) }
    Diagnose.warn(msg, span) -> { eprint(msg) resume(0) }
    Diagnose.note(msg, span) -> { eprint(msg) resume(0) }
  }
  let is_sdk_source = path_len > 0 and sdk_package > 0 and
    pkg_source_is_selected_sdk(origin, path_ptr, path_len) == 1
  if is_sdk_source {
    main_register_source_path_in_package(tt, src, n, path_ptr, path_len, sdk_package)
  } else {
    main_register_source_path_in_package(tt, src, n, path_ptr, path_len, 0)
  }
}

fn main_register_source_path_in_package(
  tt: i64,
  src: i64,
  n: i64,
  path_ptr: i64,
  path_len: i64,
  package_id: i64
) -> i64 {
  ttable_register_source_in_package(tt, src, n, path_ptr, path_len, package_id)
  if path_len > 0 {
    -- A path-aware root is a package graph node even when the root source has
    -- no imports. This makes manifest exports and L7 package identity facts
    -- available to every path-form command, not only as an import side effect.
    pkg_identity_register_root(tt, pkg_manifest_load_default_for_table(tt))
    0
  } else { 0 }
}

--- What a prepared product records in its artifact facts beyond the link
--- graph: its staging sites with their outcomes, and the compile-time inputs
--- the staging drivers observed.
type MainProductFacts {
  sites: List<NativeArtifactStagingSite>,
  inputs: NativeArtifactCompileTimeInputs
}

fn main_no_product_facts() -> MainProductFacts {
  MainProductFacts {
    sites: Nil<NativeArtifactStagingSite>(),
    inputs: Nil<NativeArtifactCompileTimeInput>()
  }
}

type MainNativePreparation {
  --- The lowered module, its root source and the product facts staging
  --- contributed.
  MainNativePrepared(NativeModule, Source, MainProductFacts),
  MainNativePreparationFailed(i64)
}

--- A site ready to stage: the checker's fact, the export it resolved to and
--- the driver product that will stage it.
type MainPreparedSite { fact: StagingSiteFact, export: GrammarToolExport, product: str }

--- One staged site: the checker's fact, the export it resolved to, the
--- driver product that staged it and what staging produced.
type MainStagedSite {
  fact: StagingSiteFact,
  export: GrammarToolExport,
  driver: str,
  outcome: GrammarStageOutcome
}

fn main_location_offsets(location: DiagnosticLocation) -> (i64, i64) {
  match location {
    DiagnosticSourceRange(_, start, end) -> (
      __u64_to_i64(__usize_to_u64(start)),
      __u64_to_i64(__usize_to_u64(end))
    )
    _ -> (0 - 1, 0 - 1)
  }
}

fn main_capability_name(capability: StagingCapability) -> str {
  match capability { StagingValidateOnly -> "validate_only", StagingTypedPlan -> "typed_plan" }
}

fn main_staging_context(context: StagingSiteContext) -> NativeArtifactStagingContext {
  match context {
    StagingSiteHostTypes -> NativeArtifactStagingHostTypes
    StagingSiteFile(context_path, limit) -> NativeArtifactStagingFile(
      path.from_utf8(context_path).unwrap(),
      limit
    )
  }
}

fn main_staging_site_fact(staged: MainStagedSite) -> NativeArtifactStagingSite {
  let fact = staged.fact
  let (site_start, site_end) = main_location_offsets(fact.site)
  let (source_start, source_end) = main_location_offsets(fact.source)
  NativeArtifactStagingSite {
    package_name: fact.export.package_name,
    version: fact.version,
    export: fact.export.export,
    module: fact.export.module,
    declaration: fact.export.declaration,
    execution: fact.execution,
    capability: main_capability_name(fact.capability),
    site_start: site_start,
    site_end: site_end,
    source_start: source_start,
    source_end: source_end,
    context: main_staging_context(fact.context),
    staged: match staged.outcome {
      GrammarStageStaged(artifact) -> NativeArtifactStagingStaged(
        staged.driver,
        artifact.content,
        __u64_to_i64(__usize_to_u64(artifact.size)),
        __u64_to_i64(__usize_to_u64(artifact.budget)),
        artifact.host_transcript,
        artifact.facts
      )
      GrammarStageValidated(validated) ->
        NativeArtifactStagingValidated(validated.host_transcript)
      _ -> NativeArtifactStagingValidated("")
    }
  }
}

--- The staging sites the checker recorded for a program, as facts.
fn main_staging_site_facts(typed: TypedModule) -> List<StagingSiteFact> {
  match typed {
    TypedModule(_, _, tt, _, _) -> staging_site_facts(tt)
  }
}

-- Observed inputs of every staged site, in site order, as compile-time
-- inputs. A failed read never reaches here: it fails the build when the
-- site is staged.
fn main_staged_inputs(staged: List<MainStagedSite>) -> NativeArtifactCompileTimeInputs {
  let mut inputs = Nil<NativeArtifactCompileTimeInput>()
  for site in staged {
    let observed = match site.outcome {
      GrammarStageStaged(artifact) -> artifact.observed_inputs
      GrammarStageValidated(validated) -> validated.observed_inputs
      _ -> Nil<ToolObservedInput>()
    }
    for input in observed {
      match input.outcome {
        ToolObservedContent(size, content) -> {
          inputs = inputs.append(
            NativeArtifactCompileTimeInput {
              path: input.path,
              limit: input.limit,
              size: size,
              content: content
            }
          )
        }
        ToolObservedFailure(_) -> nil
      }
    }
  }
  inputs
}

fn main_product_facts_of(staged: List<MainStagedSite>) -> MainProductFacts {
  MainProductFacts {
    sites: staged.map<NativeArtifactStagingSite>(
      (site: MainStagedSite) => main_staging_site_fact(site)
    ),
    inputs: main_staged_inputs(staged)
  }
}

fn main_site_source_buffer(site: StagingSiteFact) -> i64 {
  match site.source {
    DiagnosticSourceRange(DiagnosticSourceBuffer(buffer), _, _) -> buffer
    _ -> 0
  }
}

-- The physical source name belonging to this site, including imported
-- modules. Anonymous buffers retain the protocol's stable fallback name.
fn main_site_source_name(tt: i64, site: StagingSiteFact) -> str {
  let entry = ttable_find_source_buffer_entry(tt, main_site_source_buffer(site))
  if entry == 0 or mem_load64_at(entry + 24, 0) <= 0 { "embedded" } else {
    runtime_str_from_bytes_copy(mem_load64_at(entry + 16, 0), mem_load64_at(entry + 24, 0))
  }
}

fn main_site_value_source_name(tt: i64, site: StagingSiteFact) -> str {
  let (source_start, _) = main_location_offsets(site.source)
  str_concat(main_site_source_name(tt, site), str_concat("@", source_start.to_str()))
}

fn main_site_report(site: StagingSiteFact, command: str, message: str) -> nil {
  let (start, end) = main_location_offsets(site.site)
  eprint(command)
  eprint(": staging site for grammar `")
  eprint(site.export.export)
  eprint("` at bytes ")
  eprint_i(start)
  eprint("..")
  eprint_i(end)
  eprint(": ")
  eprint(message)
  eprint("\n")
  nil
}

--- Resolve every site's export and ensure its driver product before any
--- exchange, so staging itself needs only the process capability.
fn main_stage_prepare(
  sites: List<StagingSiteFact>,
  host: MainGrammarHost,
  command: str
) -[SourceAcquire]> Result<List<MainPreparedSite>, i64> {
  let mut prepared = Nil<MainPreparedSite>()
  let mut failed = 0
  for site in sites {
    if failed == 0 {
      let name = str_concat(site.export.package_name, str_concat("/", site.export.export))
      match grammar_tool_resolve(name) {
        GrammarToolResolved(export) -> match grammar_tool_ensure_product(
          export,
          native_link_target_host(),
          main_compiler_digest(host)
        ) {
          GrammarToolProductReady(product) -> {
            prepared = prepared.append(
              MainPreparedSite { fact: site, export: export, product: product }
            )
            nil
          }
          GrammarToolProductFailed(message) -> {
            main_site_report(site, command, message);
            failed = 1;
            nil
          }
        }
        GrammarToolUnknown -> {
          main_site_report(
            site,
            command,
            str_concat("export ", str_concat(name, " is not in any manifest in scope"))
          );
          failed = 1;
          nil
        }
        GrammarToolAmbiguous(_) -> {
          main_site_report(
            site,
            command,
            str_concat("export ", str_concat(name, " is ambiguous"))
          );
          failed = 1;
          nil
        }
      }
    } else { nil }
  }
  if failed != 0 { Err<List<MainPreparedSite>, i64>(1) } else {
    Ok<List<MainPreparedSite>, i64>(prepared)
  }
}

fn main_stage_deadline() -[MonotonicClock]> Instant {
  monotonic.now().add(time.seconds(30 + seconds_ceiling()))
}

-- Render a driver's diagnostics onto the staged literal in its owning
-- source. Driver offsets start at the literal's content.
fn main_render_site_diagnostics(
  tt: i64,
  site: StagingSiteFact,
  source_name: str,
  diagnostics: List<Diagnostic>
) -> nil {
  let src = main_site_source_buffer(site)
  let (source_start, _) = main_location_offsets(site.source)
  let (_, site_end) = main_location_offsets(site.site)
  -- The literal's content starts after its opening delimiter: the raw
  -- prefix and hashes, or one quote.
  let content_start = source_start + main_literal_content_offset(src, source_start)
  for diagnostic in diagnostics {
    pipeline_diagnose_render_report(
      tt,
      grammar_tool_anchor_at(diagnostic, source_name, src, __i64_to_usize(content_start))
    )
  }
  nil
}

fn main_literal_content_offset(src: i64, token_start: i64) -> i64 {
  if mem_load8_at(src, token_start) == 114 {
    let mut hashes = 0
    while mem_load8_at(src, token_start + 1 + hashes) == 35 { hashes = hashes + 1 }
    hashes + 2
  } else { 1 }
}

fn main_stage_failed(site: StagingSiteFact, command: str, outcome: GrammarStageOutcome) -> nil {
  main_site_report(
    site,
    command,
    str_concat("staging failed: ", grammar_stage_failure_message(outcome))
  )
}

--- Stage every prepared site in order under the process handlers. The
--- first refusal or failure ends the build after its diagnostics.
fn main_stage_exchanges(
  prepared: List<MainPreparedSite>,
  tt: i64,
  registrations: RegistrationScope,
  target: NativeLinkTarget,
  command: str
) -[Proc, MonotonicClock]> Result<List<MainStagedSite>, i64> {
  let mut staged = Nil<MainStagedSite>()
  let mut failed = 0
  let mut sequence = 0
  for entry in prepared {
    let site = entry.fact
    let export = entry.export
    let product = entry.product
    let source = main_site_source_buffer(site)
    let source_name = main_site_value_source_name(tt, site)
    if failed == 0 {
      let outcome = grammar_tool_stage(
        product,
        export,
        source_name,
        site.text,
        staging_site_tool_context(site.context),
        target,
        tt,
        source,
        registrations,
        sequence,
        main_stage_deadline()
      )
      sequence = sequence + 1
      match outcome {
        GrammarStageStaged(artifact) -> if main_observed_reads_failed(
          site,
          command,
          artifact.observed_inputs
        ) { failed = 1; nil } else {
          staged = staged.append(
            MainStagedSite { fact: site, export: export, driver: product, outcome: outcome }
          )
          nil
        }
        GrammarStageValidated(validated) -> if main_observed_reads_failed(
          site,
          command,
          validated.observed_inputs
        ) {
          failed = 1;
          nil
        } else {
          staged = staged.append(
            MainStagedSite { fact: site, export: export, driver: product, outcome: outcome }
          )
          nil
        }
        GrammarStageRefused(response) -> {
          main_render_site_diagnostics(tt, site, source_name, response.diagnostics)
          main_stage_failed(site, command, outcome)
          failed = 1
          nil
        }
        _ -> { main_stage_failed(site, command, outcome); failed = 1; nil }
      }
    } else { nil }
  }
  if failed != 0 { Err<List<MainStagedSite>, i64>(1) } else {
    Ok<List<MainStagedSite>, i64>(staged)
  }
}

-- A failed context read is a typed build failure, never a dependency fact.
fn main_observed_reads_failed(
  site: StagingSiteFact,
  command: str,
  observed: List<ToolObservedInput>
) -> bool {
  let mut failed = false
  for input in observed {
    match input.outcome {
      ToolObservedFailure(name) -> {
        main_site_report(
          site,
          command,
          str_concat(
            "the grammar could not read ",
            str_concat(input.path.to_utf8().unwrap_or("its context file"), str_concat(": ", name))
          )
        )
        failed = true
        nil
      }
      _ -> nil
    }
  }
  failed
}

fn main_stage_sites(
  typed: TypedModule,
  sites: List<StagingSiteFact>,
  target: NativeLinkTarget,
  host: MainGrammarHost,
  command: str
) -[SourceAcquire]> Result<List<MainStagedSite>, i64> {
  match main_stage_prepare(sites, host, command) {
    Err(status) -> Err<List<MainStagedSite>, i64>(status)
    Ok(prepared) -> match typed {
      TypedModule(_, _, tt, _, registrations) -> {
        with process_handler(host.argc, host.argv) {
          platform_time.with_platform(
            () => main_stage_exchanges(prepared, tt, registrations, target, command)
          )
        }
      }
    }
  }
}

--- Attach each verified result to the checker record that owns its source
--- call. Lowering consumes this fact directly, so staging never regenerates,
--- reparses or rechecks authored source.
fn main_materialize_staging_sites(
  typed: TypedModule,
  staged: List<MainStagedSite>,
  command: str
) -> i64 {
  match typed {
    TypedModule(_, _, tt, _, _) -> {
      let count = staging_site_record_count(tt)
      if count != __u64_to_i64(__usize_to_u64(staged.len())) {
        eprint(command)
        eprint(
          ": staged result count does not match the checked sites; the product was not written\n"
        )
        1
      } else {
        let mut index = 0
        let mut errors = 0
        let mut remaining = staged
        while index < count {
          match remaining {
            Cons(expected, rest) -> {
              remaining = rest
              let (site_start, _) = main_location_offsets(expected.fact.site)
              let source = main_site_source_buffer(expected.fact)
              let source_name = main_site_value_source_name(tt, expected.fact)
              let materialized = match expected.outcome {
                GrammarStageStaged(artifact) -> staging_site_materialize(
                  tt,
                  index,
                  source,
                  site_start,
                  2,
                  source_name,
                  artifact.content,
                  bytes_storage(artifact.bytes)
                )
                GrammarStageValidated(_) -> staging_site_materialize(
                  tt,
                  index,
                  source,
                  site_start,
                  1,
                  source_name,
                  "",
                  ""
                )
                _ -> false
              }
              if not materialized {
                eprint(command)
                eprint(
                  ": staged result does not match a lowerable checked site; the product was not written\n"
                )
                errors = errors + 1
              } else { 0 }
            }
            Nil -> { errors = errors + 1; nil }
          }
          index = index + 1
        }
        errors
      }
    }
  }
}

fn main_lower_prepared(
  typed: TypedModule,
  source: Source,
  target: NativeLinkTarget,
  reclamation: PipelineNativeReclamation,
  facts: MainProductFacts
) -[SourceAcquire]> MainNativePreparation {
  main_acquire_native_libraries(typed)
  let ir = pipeline_lower_checked_with_weft(typed)
  let optimised = pipeline_optimise_typed_ir(typed, ir)
  MainNativePrepared(
    pipeline_lower_native_module_for_target_closed_with_reclamation(
      typed,
      optimised,
      target,
      reclamation
    ),
    source,
    facts
  )
}

type MainSourceParsing {
  MainSourceParsed(AstModule, Source, ModuleIdentity),
  MainSourceParseFailed(i64)
}

fn main_acquire_native_libraries(typed: TypedModule) -[SourceAcquire]> i64 {
  match typed {
    TypedModule(fns, src, tt, owners, _) -> pkg_native_libraries_acquire(tt)
  }
}

-- Rendering is a host interpretation. Count errors without changing the
-- result or acquiring any of the body's residual capabilities.
fn main_report_diagnostics<T, E>(
  table: i64,
  source: i64,
  body: () -[Diagnose, E]> T
) -[E]> (T, i64) {
  handle observe_errors(body) {
    Diagnose.report(diagnostic) -> {
      pipeline_diagnose_render_report(table, diagnostic)
      resume(0)
    }
    Diagnose.error(message, position) -> {
      pipeline_diagnose_render(table, source, message, position)
      resume(0)
    }
    Diagnose.warn(message, position) -> {
      pipeline_diagnose_render(table, source, message, position);
      resume(0)
    }
    Diagnose.note(message, position) -> {
      pipeline_diagnose_render(table, source, message, position);
      resume(0)
    }
  }
}

-- Every native tool configuration parses through Grammar and retains the
-- source owner alongside the syntax until its final product has been emitted.
fn main_parse_native_source(
  src: i64,
  n: i64,
  path_ptr: i64,
  path_len: i64,
  trusted: i64,
  strict: i64,
  can_grant_trust: i64,
  target: NativeLinkTarget
) -[SourceAcquire]> MainSourceParsing {
  let content = runtime_str_from_bytes_copy(src, n)
  let root_src = __str_ptr(content)
  let source = Source { text: content, identity: DiagnosticSourceBuffer(root_src) }
  let tt = ttable_new()
  ttable_set_native_compilation_target(tt, native_link_target_storage_kind(target))
  main_mark_root_origin_with_grant(tt, root_src, trusted, strict, can_grant_trust)
  main_register_source_path(tt, root_src, n, path_ptr, path_len)
  let loader = parse_source_loader_for_table(tt)
  let (parsed, parse_error_count) = main_report_diagnostics(
    tt,
    root_src,
    () => parse_registered_source_with_loader(source, tt, loader)
  )
  if parse_error_count != 0 {
    eprint("compile: parse failed with ")
    eprint_i(parse_error_count)
    eprint(" errors\n")
    MainSourceParseFailed(1)
  } else {
    MainSourceParsed(
      AstModule(
        parsed.functions,
        root_src,
        tt,
        parsed.owners,
        (parsed.declarations, parsed.registrations)
      ),
      source,
      parsed.root
    )
  }
}

fn main_check_native_program(
  ast: AstModule,
  support: NativeRuntimeSupport
) -[SourceAcquire]> CheckResult<TypedModule> {
  match ast {
    AstModule(fns, src, tt, owners, _) -> {
      let report = main_check_native_report(ast, support)
      match report.result {
        CheckRejected -> {
          eprint("compile: type check failed with ")
          eprint_i(report.errors)
          eprint(" errors\n")
          CheckRejected<TypedModule>()
        }
        Checked(typed) -> if main_fns_have_root_main(fns, src) != 1 {
          eprint("compile: missing main function\n")
          CheckRejected<TypedModule>()
        } else { Checked(typed) }
      }
    }
  }
}

fn main_check_native_report(
  ast: AstModule,
  support: NativeRuntimeSupport
) -[SourceAcquire]> WeftCheckReport {
  match ast {
    AstModule(_, src, tt, owners, _) -> {
      let loader = parse_source_loader_with_owners(tt, owners)
      let (checked, error_count) = main_report_diagnostics(
        tt,
        src,
        () => check_weft_native_program_with_support_and_loader(ast, support, loader)
      )
      weft_check.report_value(checked, error_count, source_loader_owners(loader))
    }
  }
}

-- Compile and build are two Emit handlers over this one checked/lowered
-- product. The build handler retains the native link plan while the compile
-- handler writes the relocatable object to stdout.
-- A program with staging sites is checked, its sites are staged through
-- their driver products, and each verified result is attached to the site's
-- semantic fact for lowering. Every authored module is parsed and checked
-- exactly once.
--- A checked program ready for lowering: parsed, checked and with every
--- staging site verified and materialised, as `build` and `ir` both need.
type MainCheckedProgram {
  MainCheckedProgramReady(TypedModule, Source, MainProductFacts),
  MainCheckedProgramFailed(i64)
}

fn main_check_program_for_target_with_path_and_origin_and_grant(
  src: i64,
  n: i64,
  path_ptr: i64,
  path_len: i64,
  trusted: i64,
  strict: i64,
  can_grant_trust: i64,
  target: NativeLinkTarget,
  host: MainGrammarHost,
  command: str
) -[SourceAcquire]> MainCheckedProgram {
  match main_parse_native_source(
    src,
    n,
    path_ptr,
    path_len,
    trusted,
    strict,
    can_grant_trust,
    target
  ) {
    MainSourceParseFailed(status) -> MainCheckedProgramFailed(status)
    MainSourceParsed(ast, source, _) -> match main_check_native_program(ast, NativeRuntime) {
      CheckRejected -> MainCheckedProgramFailed(1)
      Checked(typed) -> {
        let sites = main_staging_site_facts(typed)
        if sites.is_empty() { MainCheckedProgramReady(typed, source, main_no_product_facts()) }
        else {
          match main_stage_sites(typed, sites, target, host, command) {
            Err(status) -> MainCheckedProgramFailed(status)
            Ok(staged) -> if main_materialize_staging_sites(typed, staged, command) != 0 {
              MainCheckedProgramFailed(1)
            } else { MainCheckedProgramReady(typed, source, main_product_facts_of(staged)) }
          }
        }
      }
    }
  }
}

fn main_prepare_native_for_target_with_path_and_origin_and_grant(
  src: i64,
  n: i64,
  path_ptr: i64,
  path_len: i64,
  trusted: i64,
  strict: i64,
  can_grant_trust: i64,
  target: NativeLinkTarget,
  reclamation: PipelineNativeReclamation,
  host: MainGrammarHost
) -[SourceAcquire]> MainNativePreparation {
  match main_check_program_for_target_with_path_and_origin_and_grant(
    src,
    n,
    path_ptr,
    path_len,
    trusted,
    strict,
    can_grant_trust,
    target,
    host,
    "build"
  ) {
    MainCheckedProgramFailed(status) -> MainNativePreparationFailed(status)
    MainCheckedProgramReady(typed, source, facts) -> main_lower_prepared(
      typed,
      source,
      target,
      reclamation,
      facts
    )
  }
}

fn main_prepare_native_with_path_and_origin_and_grant(
  src: i64,
  n: i64,
  path_ptr: i64,
  path_len: i64,
  trusted: i64,
  strict: i64,
  can_grant_trust: i64,
  host: MainGrammarHost
) -[SourceAcquire]> MainNativePreparation {
  main_prepare_native_for_target_with_path_and_origin_and_grant(
    src,
    n,
    path_ptr,
    path_len,
    trusted,
    strict,
    can_grant_trust,
    native_link_target_host(),
    PipelineNativeReuseFreed,
    host
  )
}

fn compile_with_path_and_origin_and_grant(
  src: i64,
  n: i64,
  path_ptr: i64,
  path_len: i64,
  trusted: i64,
  strict: i64,
  can_grant_trust: i64,
  host: MainGrammarHost
) -[SourceAcquire]> i64 {
  match main_prepare_native_with_path_and_origin_and_grant(
    src,
    n,
    path_ptr,
    path_len,
    trusted,
    strict,
    can_grant_trust,
    host
  ) {
    MainNativePreparationFailed(status) -> status
    MainNativePrepared(native, source, _) -> main_write_binary(
      pipeline_emit_checked_native_binary(native, __str_ptr(source.text))
    )
  }
}

fn main_rc_reclamation_site_report(census: i64) -> i64 {
  eprint("WEFT_RC_SITE_CENSUS 1")
  for i in 0..9 { eprint(" ") eprint_i(pipeline_rc_site_census_get(census, i)) }
  eprint(" ")
  eprint_i(pipeline_rc_site_census_total(census))
  eprint("\n")
  eprint("rc site census: counted=")
  eprint_i(pipeline_rc_site_census_get(census, 0))
  eprint(" stack_inline=")
  eprint_i(pipeline_rc_site_census_get(census, 1))
  eprint(" region=")
  eprint_i(pipeline_rc_site_census_get(census, 2))
  eprint(" arena=")
  eprint_i(pipeline_rc_site_census_get(census, 3))
  eprint(" reuse=")
  eprint_i(pipeline_rc_site_census_get(census, 4))
  eprint(" unique=")
  eprint_i(pipeline_rc_site_census_get(census, 5))
  eprint(" owned=")
  eprint_i(pipeline_rc_site_census_get(census, 6))
  eprint(" frozen=")
  eprint_i(pipeline_rc_site_census_get(census, 7))
  eprint(" promotion_boundaries=")
  eprint_i(pipeline_rc_site_census_get(census, 8))
  eprint(" total=")
  eprint_i(pipeline_rc_site_census_total(census))
  eprint("\n")
}

fn main_write_native_product_stdout(product: PipelineNativeProduct) -> i64 {
  match product {
    PipelineNativeProductFailed(binary) -> main_write_binary(binary)
    PipelineNativeProductReady(binary, facts) -> main_write_binary(binary)
  }
}

-- Compile an instrumented artifact without changing the ordinary compiler
-- configuration. The static class distribution is reported by this process;
-- the emitted program reports its exact dynamic helper-entry vector at exit.
fn compile_with_path_and_origin_and_grant_rc_census(
  src: i64,
  n: i64,
  path_ptr: i64,
  path_len: i64,
  trusted: i64,
  strict: i64,
  can_grant_trust: i64
) -[SourceAcquire]> i64 {
  match main_parse_native_source(
    src,
    n,
    path_ptr,
    path_len,
    trusted,
    strict,
    can_grant_trust,
    native_link_target_host()
  ) {
    MainSourceParseFailed(status) -> status
    MainSourceParsed(ast, source, _) -> match main_check_native_program(
      ast,
      NativeRuntimeWithRcCensus
    ) {
      CheckRejected -> 1
      Checked(typed) -> if main_refuse_staging_sites(main_staging_site_facts(typed), "compile") !=
        0 { 1 } else {
          main_acquire_native_libraries(typed)
          let ir = pipeline_lower_checked_with_weft(typed)
          let optimised = pipeline_optimise_typed_ir(typed, ir)
          let native = pipeline_lower_native_module_with_audit(typed, optimised, 2)
          let census = pipeline_rc_reclamation_site_census(optimised, native)
          main_rc_reclamation_site_report(census)
          main_write_native_product_stdout(
            pipeline_checked_native_product(
              native,
              __str_ptr(source.text),
              PipelineNativeDebugInformationIncluded
            )
          )
        }
    }
  }
}

-- Compile an image that measures the current checker's legacy storage traffic.
-- The emitted program reports exact dynamic entries into the selected facade
-- and allocation functions; ordinary compilation carries no counters.
fn compile_with_path_and_origin_and_grant_checker_storage_census(
  src: i64,
  n: i64,
  path_ptr: i64,
  path_len: i64,
  trusted: i64,
  strict: i64,
  can_grant_trust: i64,
  sdk_embed: MainSdkEmbedMode
) -[SourceAcquire]> i64 {
  match main_parse_native_source(
    src,
    n,
    path_ptr,
    path_len,
    trusted,
    strict,
    can_grant_trust,
    native_link_target_host()
  ) {
    MainSourceParseFailed(status) -> status
    MainSourceParsed(ast, source, _) -> match main_check_native_program(
      ast,
      NativeRuntimeWithCheckerStorageCensus
    ) {
      CheckRejected -> 1
      Checked(typed) -> if main_refuse_staging_sites(main_staging_site_facts(typed), "compile") !=
        0 { 1 }
      else {
        main_acquire_native_libraries(typed)
        let ir = pipeline_lower_checked_with_weft(typed)
        let optimised = pipeline_optimise_typed_ir(typed, ir)
        let native = pipeline_lower_native_module_with_audit(typed, optimised, 3)
        match main_build_native_with_sdk(native, sdk_embed) {
          MainSdkPreparationFailed(status) -> status
          MainSdkPrepared(ready, _) -> main_write_native_product_stdout(
            pipeline_checked_native_product(
              ready,
              __str_ptr(source.text),
              PipelineNativeDebugInformationIncluded
            )
          )
        }
      }
    }
  }
}

fn main_compile_elapsed_millis(start: i64, finish: i64) -> i64 {
  if start < 0 or finish < start { 0 } else { finish - start }
}

fn main_compile_report_metrics(
  source_millis: i64,
  parse_millis: i64,
  check_millis: i64,
  lower_millis: i64,
  optimise_millis: i64,
  native_millis: i64,
  package_millis: i64,
  write_millis: i64,
  total_millis: i64,
  checked_functions: i64,
  ir_functions: i64,
  native_functions: i64
) -> i64 {
  eprint("WEFT_COMPILE_METRICS 1 ")
  eprint_i(source_millis)
  eprint(" ")
  eprint_i(parse_millis)
  eprint(" ")
  eprint_i(check_millis)
  eprint(" ")
  eprint_i(lower_millis)
  eprint(" ")
  eprint_i(optimise_millis)
  eprint(" ")
  eprint_i(native_millis)
  eprint(" ")
  eprint_i(package_millis)
  eprint(" ")
  eprint_i(write_millis)
  eprint(" ")
  eprint_i(total_millis)
  eprint(" ")
  eprint_i(checked_functions)
  eprint(" ")
  eprint_i(ir_functions)
  eprint(" ")
  eprint_i(native_functions)
  eprint("\n")
  eprint("compile metrics: total_ms=")
  eprint_i(total_millis)
  eprint(" source_ms=")
  eprint_i(source_millis)
  eprint(" parse_ms=")
  eprint_i(parse_millis)
  eprint(" check_ms=")
  eprint_i(check_millis)
  eprint(" lower_ms=")
  eprint_i(lower_millis)
  eprint(" optimise_ms=")
  eprint_i(optimise_millis)
  eprint(" native_ms=")
  eprint_i(native_millis)
  eprint(" package_ms=")
  eprint_i(package_millis)
  eprint(" write_ms=")
  eprint_i(write_millis)
  eprint(" checked_functions=")
  eprint_i(checked_functions)
  eprint(" ir_functions=")
  eprint_i(ir_functions)
  eprint(" native_functions=")
  eprint_i(native_functions)
  eprint("\n")
}

-- Measurement is an explicit tool composition over the ordinary compiler
-- stages. Binary bytes remain on stdout; the versioned ledger goes to stderr.
fn compile_with_path_and_origin_and_grant_metrics(
  src: i64,
  n: i64,
  path_ptr: i64,
  path_len: i64,
  trusted: i64,
  strict: i64,
  can_grant_trust: i64,
  source_millis: i64
) -[SourceAcquire]> i64 {
  let started = main_test_now_millis()
  let parse_started = main_test_now_millis()
  let parsed = main_parse_native_source(
    src,
    n,
    path_ptr,
    path_len,
    trusted,
    strict,
    can_grant_trust,
    native_link_target_host()
  )
  let parse_finished = main_test_now_millis()
  match parsed {
    MainSourceParseFailed(status) -> status
    MainSourceParsed(ast, source, _) -> {
      let check_started = main_test_now_millis()
      let checked = main_check_native_program(ast, NativeRuntime)
      let check_finished = main_test_now_millis()
      match checked {
        CheckRejected -> 1
        Checked(typed) -> {
          main_acquire_native_libraries(typed)
          let lower_started = main_test_now_millis()
          let ir = pipeline_lower_checked_with_weft(typed)
          let lower_finished = main_test_now_millis()
          let optimise_started = main_test_now_millis()
          let optimised = pipeline_optimise_typed_ir(typed, ir)
          let optimise_finished = main_test_now_millis()
          let native_started = main_test_now_millis()
          let native = pipeline_lower_native_module_closed(typed, optimised)
          let native_finished = main_test_now_millis()
          let package_started = main_test_now_millis()
          let binary = pipeline_emit_checked_native_binary(native, __str_ptr(source.text))
          let package_finished = main_test_now_millis()
          let write_started = main_test_now_millis()
          let status = if main_refuse_staging_sites(main_staging_site_facts(typed), "compile") !=
            0 { 1 } else { main_write_binary(binary) }
          let finished = main_test_now_millis()
          main_compile_report_metrics(
            source_millis,
            main_compile_elapsed_millis(parse_started, parse_finished),
            main_compile_elapsed_millis(check_started, check_finished),
            main_compile_elapsed_millis(lower_started, lower_finished),
            main_compile_elapsed_millis(optimise_started, optimise_finished),
            main_compile_elapsed_millis(native_started, native_finished),
            main_compile_elapsed_millis(package_started, package_finished),
            main_compile_elapsed_millis(write_started, finished),
            source_millis + main_compile_elapsed_millis(started, finished),
            match typed { TypedModule(fns, _, _, owners, _) -> nlist_len(fns) },
            ir_function_list_len(pipeline_ir_functions(optimised)),
            pipeline_native_function_count(native)
          )
          status
        }
      }
    }
  }
}

fn compile_with_origin_and_grant(
  src: i64,
  n: i64,
  trusted: i64,
  strict: i64,
  can_grant_trust: i64,
  host: MainGrammarHost
) -[SourceAcquire]> i64 {
  compile_with_path_and_origin_and_grant(src, n, 0, 0, trusted, strict, can_grant_trust, host)
}

-- Read a null-terminated C string length
fn cstr_len(ptr: i64) -> i64 {
  let mut i = 0
  while mem_load8_at(ptr, i) != 0 { i = i + 1 }
  i
}

-- Compare C string at ptr with Weft string literal
fn cstr_eq(ptr: i64, s: str) -> i64 {
  let sptr = __str_ptr(s)
  let slen = __str_len(s)
  let clen = cstr_len(ptr)
  if clen != slen { 0 }
  else { src_eq_at(ptr, 0, sptr, 0, slen) }
}

fn cpath_file_pair(path: i64, len: i64) -> i64 {
  let pair = main_alloc_bytes(16)
  mem_store64_at(pair, 0, path)
  mem_store64_at(pair, 8, len)
  pair
}

fn read_cpath_file(path: i64, len: i64) -> i64 {
  read_file(cpath_file_pair(path, len))
}

fn cpath_is_trusted_source(path: i64, len: i64) -> i64 {
  source_trust_path_is_trusted_root(path, len)
}

fn cpath_is_strict_source(path: i64, len: i64) -> i64 {
  if cpath_is_trusted_source(path, len) == 1 { 0 } else { 1 }
}

fn cpath_can_grant_import_trust(path: i64, len: i64) -> i64 {
  source_trust_path_can_grant_import_trust(path, len)
}

fn compile_path(path: i64, host: MainGrammarHost) -[SourceAcquire]> i64 {
  let len = cstr_len(path)
  let file = read_cpath_file(path, len)
  let src = mem_load64_at(file, 0)
  let n = mem_load64_at(file, 8)
  if n <= 0 {
    eprint("compile: could not read input file\n")
    1
  } else {
    compile_with_path_and_origin_and_grant(
      src,
      n,
      path,
      len,
      cpath_is_trusted_source(path, len),
      cpath_is_strict_source(path, len),
      cpath_can_grant_import_trust(path, len),
      host
    )
  }
}

fn main_executable_kind_for_target(target: NativeLinkTarget) -> i64 {
  match target {
    NativeLinkMacosAarch64 -> pipeline_binary_kind_macho_executable()
    NativeLinkLinuxAarch64 -> pipeline_binary_kind_elf_executable()
  }
}

fn main_host_executable_kind() -> i64 {
  main_executable_kind_for_target(native_link_target_host())
}

fn main_build_write_product(
  binary: BinaryObject,
  output_path: i64,
  target: NativeLinkTarget
) -> i64 {
  match binary {
    BinaryObject(bytes, kind) -> {
      if buf_len(bytes) == 0 {
        eprint("build: no object produced\n")
        1
      } else {
        if kind == main_executable_kind_for_target(target) {
          let fd = sys_open_write_create_truncate(output_path, 448)
          let write_status = if fd < 0 { 0 - fd }
          else {
            let status = main_test_write_all(fd, buf_ptr(bytes), buf_len(bytes))
            sys_close(fd)
            status
          }
          if write_status != 0 {
            eprint("build: could not write native-linked executable\n")
            1
          } else { 0 }
        } else {
          eprint("build: native linker did not produce the host-target executable format\n")
          1
        }
      }
    }
  }
}

-- Until staging sites are lowered to `Staged<G>` values, a product that
-- contains one is refused: the site is a checked fact that tools and
-- artifact facts can inspect, but the primitive's body is a trap that must
-- never ship. Every emission path asks this before writing anything.
fn main_refuse_staging_sites(sites: List<StagingSiteFact>, command: str) -> i64 {
  let mut count = 0
  for site in sites {
    main_site_report(
      site,
      command,
      "is not staged on this path; build, compile or run the program instead"
    )
    count = count + 1
  }
  count
}

--- Stage and attach every site in a checked test program through the same
--- grammar-neutral driver path used by build and run. The generated harness
--- is already part of `typed`, so host type queries observe the exact program
--- that lowering will emit.
fn main_test_stage_checked(typed: TypedModule, host: MainGrammarHost) -[SourceAcquire]> bool {
  let sites = main_staging_site_facts(typed)
  if sites.is_empty() { true }
  else {
    match main_stage_sites(typed, sites, native_link_target_host(), host, "test") {
      Err(_) -> false
      Ok(staged) -> main_materialize_staging_sites(typed, staged, "test") == 0
    }
  }
}

fn main_build_write_facts(
  facts: NativeArtifactFacts,
  facts_path: i64,
  sdk: NativeArtifactSdk
) -> i64 {
  if facts_path == 0 { 0 } else {
    let rendered = pipeline_native_artifact_facts_render_with_sdk(facts, sdk)
    let fd = sys_open_write_create_truncate(facts_path, 420)
    let write_status = if fd < 0 { 0 - fd }
    else {
      let status = main_test_write_all(fd, __str_ptr(rendered), __str_len(rendered))
      sys_close(fd)
      status
    }
    if write_status != 0 {
      eprint("build: could not write artifact facts\n")
      1
    } else { 0 }
  }
}

-- The staging sites and the inputs their drivers observed join the
-- product's artifact facts.
fn main_product_with_facts(
  product: PipelineNativeProduct,
  facts: MainProductFacts
) -> PipelineNativeProduct {
  match product {
    PipelineNativeProductReady(binary, link_facts) -> {
      let with_sites = native_link_artifact_with_staging_sites(link_facts, facts.sites)
      let inputs = native_link_artifact_compile_time_inputs(with_sites).concat(facts.inputs)
      PipelineNativeProductReady(
        binary,
        native_link_artifact_with_compile_time_inputs(with_sites, inputs)
      )
    }
    failed -> failed
  }
}

fn main_build_write_product_result(
  product: PipelineNativeProduct,
  output_path: i64,
  facts_path: i64,
  target: NativeLinkTarget,
  sdk: NativeArtifactSdk
) -> i64 {
  match product {
    PipelineNativeProductFailed(binary) -> main_build_write_product(binary, output_path, target)
    PipelineNativeProductReady(binary, facts) -> {
      let product_status = main_build_write_product(binary, output_path, target)
      if product_status != 0 { product_status } else {
        main_build_write_facts(facts, facts_path, sdk)
      }
    }
  }
}

type MainSdkEmbedMode {
  MainSdkEmbedDisabled,
  MainSdkEmbedRoot(str)
}

type MainSdkPreparation {
  MainSdkPrepared(NativeModule, NativeArtifactSdk),
  MainSdkPreparationFailed(i64)
}

fn main_build_native_with_sdk(native: NativeModule, mode: MainSdkEmbedMode) -> MainSdkPreparation
{
  match mode {
    MainSdkEmbedDisabled -> MainSdkPrepared(native, NativeArtifactSdkAbsent)
    MainSdkEmbedRoot(root) -> match sdk_embed_build(root) {
      SdkArchiveBuildFailed(message) -> {
        eprint("build: could not construct embedded SDK: ")
        eprint(message)
        eprint("\n")
        MainSdkPreparationFailed(1)
      }
      SdkArchiveBuilt(archive, digest, count) -> {
        let embedded = pipeline_native_attach_sdk_archive(native, archive)
        if pipeline_native_embedded_sdk_archive_size(embedded) == 0 {
          eprint("build: could not attach embedded SDK\n")
          MainSdkPreparationFailed(1)
        } else { MainSdkPrepared(embedded, NativeArtifactSdkEmbedded(digest)) }
      }
    }
  }
}

fn main_build_path(
  path: i64,
  output_path: i64,
  facts_path: i64,
  debug_mode: PipelineNativeDebugMode,
  target: NativeLinkTarget,
  reclamation: PipelineNativeReclamation,
  envp: i64,
  sdk_embed: MainSdkEmbedMode,
  host: MainGrammarHost
) -[SourceAcquire]> i64 {
  let len = cstr_len(path)
  let file = read_cpath_file(path, len)
  let src = mem_load64_at(file, 0)
  let n = mem_load64_at(file, 8)
  if n <= 0 {
    eprint("build: could not read input file\n")
    1
  } else {
    match main_prepare_native_for_target_with_path_and_origin_and_grant(
      src,
      n,
      path,
      len,
      cpath_is_trusted_source(path, len),
      cpath_is_strict_source(path, len),
      cpath_can_grant_import_trust(path, len),
      target,
      reclamation,
      host
    ) {
      MainNativePreparationFailed(status) -> status
      MainNativePrepared(native, source, facts) -> match main_build_native_with_sdk(
        native,
        sdk_embed
      ) {
        MainSdkPreparationFailed(status) -> status
        MainSdkPrepared(ready, sdk) -> main_build_write_product_result(
          main_product_with_facts(
            pipeline_checked_native_product(ready, __str_ptr(source.text), debug_mode),
            facts
          ),
          output_path,
          facts_path,
          target,
          sdk
        )
      }
    }
  }
}

fn main_target_argument(value: i64) -> NativeLinkTargetParse {
  runtime_str_from_bytes_copy(value, cstr_len(value))
    |> native_link_target_parse
}

type MainBuildInput {
  MainBuildPath(i64),
  MainBuildTarget(str)
}

type MainBuildOptions {
  MainBuildOptionsReady(
    MainBuildInput,
    i64,
    i64,
    PipelineNativeDebugMode,
    NativeLinkTarget,
    MainSdkEmbedMode,
    PipelineNativeReclamation
  ),
  MainBuildOptionsInvalid
}

fn main_build_options(argc: i64, argv: i64) -> MainBuildOptions {
  let mut positional = 0
  let mut output_path = 0
  let mut facts_path = 0
  let mut debug_mode = PipelineNativeDebugInformationIncluded
  let mut target = native_link_target_host()
  let mut saw_output = false
  let mut saw_facts = false
  let mut saw_strip = false
  let mut saw_target = false
  let mut sdk_embed = MainSdkEmbedDisabled
  let mut saw_sdk_embed = false
  let mut reclamation = PipelineNativeReuseFreed
  let mut saw_quarantine = false
  let mut valid = true
  let mut index = 2
  while index < argc and valid {
    let option = mem_load64_at(argv, index * 8)
    if cstr_eq(option, "-o") == 1 {
      if saw_output or index + 1 >= argc { valid = false }
      else {
        output_path = mem_load64_at(argv, (index + 1) * 8)
        saw_output = true
        index = index + 2
      }
    } else {
      if cstr_eq(option, "--artifact-facts") == 1 {
        if saw_facts or index + 1 >= argc { valid = false }
        else {
          facts_path = mem_load64_at(argv, (index + 1) * 8)
          saw_facts = true
          index = index + 2
        }
      } else {
        if cstr_eq(option, "--strip-debug") == 1 {
          if saw_strip { valid = false }
          else {
            debug_mode = PipelineNativeDebugInformationStripped
            saw_strip = true
            index = index + 1
          }
        } else if cstr_eq(option, "--rc-quarantine") == 1 {
          if saw_quarantine { valid = false }
          else {
            reclamation = PipelineNativeQuarantineFreed
            saw_quarantine = true
            index = index + 1
          }
        } else {
          if cstr_eq(option, "--target") == 1 {
            if saw_target or index + 1 >= argc { valid = false }
            else {
              match main_target_argument(mem_load64_at(argv, (index + 1) * 8)) {
                NativeLinkTargetParsed(selected) -> {
                  target = selected
                  saw_target = true
                  index = index + 2
                }
                NativeLinkTargetUnsupported -> { valid = false }
              }
            }
          } else {
            if cstr_eq(option, "--embed-sdk") == 1 {
              if saw_sdk_embed or index + 1 >= argc { valid = false }
              else {
                let root = mem_load64_at(argv, (index + 1) * 8)
                sdk_embed = MainSdkEmbedRoot(runtime_str_from_bytes_copy(root, cstr_len(root)))
                saw_sdk_embed = true
                index = index + 2
              }
            } else {
              if main_cstr_starts_with(option, "-") == 1 or positional != 0 { valid = false }
              else {
                positional = option
                index = index + 1
              }
            }
          }
        }
      }
    }
  }
  if valid == false { MainBuildOptionsInvalid }
  else {
    if saw_output {
      if positional == 0 { MainBuildOptionsInvalid }
      else {
        MainBuildOptionsReady(
          MainBuildPath(positional),
          output_path,
          facts_path,
          debug_mode,
          target,
          sdk_embed,
          reclamation
        )
      }
    } else {
      if saw_facts or saw_sdk_embed { MainBuildOptionsInvalid }
      else {
        let selected = if positional == 0 { "" } else {
          runtime_str_from_bytes_copy(positional, cstr_len(positional))
        }
        MainBuildOptionsReady(
          MainBuildTarget(selected),
          0,
          0,
          debug_mode,
          target,
          MainSdkEmbedDisabled,
          reclamation
        )
      }
    }
  }
}

type MainProjectBinarySelection {
  MainProjectBinaryReady(str, str), -- name, source
  MainProjectBinaryFailed(i64)
}

fn main_project_binary(command: str, requested: str) -> MainProjectBinarySelection {
  let manifest = pkg_manifest_load_default()
  if pkg_manifest_package_len(manifest) <= 0 {
    eprint(command)
    eprint(": missing weft.pkg package identity\n")
    MainProjectBinaryFailed(1)
  } else {
    if pkg_manifest_error_count(manifest) > 0 {
      eprint(command)
      eprint(": malformed weft.pkg\n")
      MainProjectBinaryFailed(1)
    } else {
      match pkg_manifest_select_target(manifest, requested) {
        PackageTargetSelected(target) -> match target {
          PackageBinaryTarget(name, source) -> MainProjectBinaryReady(name, source)
          PackageLibraryTarget(name, source) -> {
            eprint(command)
            eprint(": target '")
            eprint(name)
            eprint("' is a source library, not an executable\n")
            MainProjectBinaryFailed(2)
          }
        }
        PackageTargetMissing -> {
          eprint(command)
          if __str_len(requested) == 0 {
            eprint(": manifest has no binary target\n")
          } else {
            eprint(": unknown target '")
            eprint(requested)
            eprint("'\n")
          }
          MainProjectBinaryFailed(2)
        }
        PackageTargetAmbiguous -> {
          eprint(command)
          eprint(": multiple binary targets; name one explicitly\n")
          MainProjectBinaryFailed(2)
        }
      }
    }
  }
}

fn main_directory_exists(path: str) -> bool {
  let stat = alloc_zeroed(sys_stat_scratch_size())
  if sys_stat_follow(runtime_str_cstring(path), stat) < 0 { false }
  else { (sys_stat_mode(stat) band 61440) == 16384 }
}

fn main_ensure_directory(path: str) -> bool {
  if main_directory_exists(path) { true }
  else {
    sys_dir_mkdir(runtime_str_cstring(path), 493)
    main_directory_exists(path)
  }
}

fn main_named_target_directory(target: NativeLinkTarget) -> str {
  str_concat("target/", native_link_target_name(target))
}

fn main_named_target_output(name: str, target: NativeLinkTarget) -> str {
  main_named_target_directory(target)
    |> str_concat("/")
    |> str_concat(name)
}

fn main_build_named(
  name: str,
  debug_mode: PipelineNativeDebugMode,
  target: NativeLinkTarget,
  reclamation: PipelineNativeReclamation,
  envp: i64,
  host: MainGrammarHost
) -[SourceAcquire]> i64 {
  match main_project_binary("build", name) {
    MainProjectBinaryFailed(status) -> status
    MainProjectBinaryReady(target_name, source) -> {
      let platform_directory = main_named_target_directory(target)
      if main_ensure_directory("target") == false or main_ensure_directory(platform_directory) ==
        false {
          eprint("build: could not create target directory\n")
          1
        } else {
          let output = main_named_target_output(target_name, target)
          let facts = str_concat(output, ".facts.json")
          let status = main_build_path(
            runtime_str_cstring(source),
            runtime_str_cstring(output),
            runtime_str_cstring(facts),
            debug_mode,
            target,
            reclamation,
            envp,
            MainSdkEmbedDisabled,
            host
          )
          if status == 0 {
            oprint(output)
            oprint("\n")
          } else { 0 }
          status
        }
    }
  }
}

type MainRunInput {
  MainRunPath(i64),
  MainRunTarget(str)
}

type MainRunOptions {
  MainRunOptionsReady(MainRunInput, i64), -- input, first product argument
  MainRunOptionsInvalid
}

fn main_cstr_is_source_path(value: i64) -> bool {
  let len = cstr_len(value)
  let mut index = 0
  let mut slash = false
  while index < len and slash == false {
    if mem_load8_at(value, index) == 47 { slash = true } else { index = index + 1 }
  }
  slash or (len >= 5 and src_eq_at(value, len - 5, __str_ptr(".weft"), 0, 5) == 1)
}

fn main_run_options(argc: i64, argv: i64) -> MainRunOptions {
  if argc == 2 { MainRunOptionsReady(MainRunTarget(""), argc) }
  else {
    let input = mem_load64_at(argv, 16)
    if cstr_eq(input, "--") == 1 {
      MainRunOptionsReady(MainRunTarget(""), 3)
    } else {
      let selected = if main_cstr_is_source_path(input) {
        MainRunPath(input)
      } else { MainRunTarget(runtime_str_from_bytes_copy(input, cstr_len(input))) }
      if argc == 3 { MainRunOptionsReady(selected, argc) }
      else {
        if cstr_eq(mem_load64_at(argv, 24), "--") == 1 {
          MainRunOptionsReady(selected, 4)
        } else { MainRunOptionsInvalid }
      }
    }
  }
}

type MainRunMaterialization {
  MainRunMaterialized(i64),
  MainRunMaterializationFailed
}

fn main_run_temp_path(attempt: i64) -> i64 {
  let prefix = "/tmp/weft-run-"
  let pid = sys_proc_id()
  let prefix_len = __str_len(prefix)
  let len = prefix_len + main_test_decimal_len(pid) + 1 + main_test_decimal_len(attempt)
  let path = alloc_zeroed(len + 1)
  mem_copy(path, __str_ptr(prefix), prefix_len)
  let after_pid = main_test_write_decimal(path, prefix_len, pid)
  mem_store8_at(path, after_pid, 45)
  main_test_write_decimal(path, after_pid + 1, attempt)
  path
}

fn main_run_materialize_binary(binary: BinaryObject, attempt: i64) -> MainRunMaterialization {
  match binary {
    BinaryObject(bytes, kind) -> {
      if buf_len(bytes) == 0 or kind != main_host_executable_kind() {
        eprint("run: native linker did not produce a host executable\n")
        MainRunMaterializationFailed
      } else {
        if attempt >= 32 {
          eprint("run: could not create a private temporary executable\n")
          MainRunMaterializationFailed
        } else {
          let path = main_run_temp_path(attempt)
          let fd = sys_open_write_create_new(path, 448)
          if fd < 0 { main_run_materialize_binary(binary, attempt + 1) }
          else {
            let write_status = main_test_write_all(fd, buf_ptr(bytes), buf_len(bytes))
            let permission_status = if write_status == 0 { sys_file_chmod(fd, 448) } else { 0 }
            sys_close(fd)
            if write_status != 0 or permission_status < 0 {
              sys_remove(path)
              eprint("run: could not write a private temporary executable\n")
              MainRunMaterializationFailed
            } else { MainRunMaterialized(path) }
          }
        }
      }
    }
  }
}

fn main_run_materialize(product: PipelineNativeProduct) -> MainRunMaterialization {
  match product {
    PipelineNativeProductFailed(binary) -> main_run_materialize_binary(binary, 0)
    PipelineNativeProductReady(binary, facts) -> main_run_materialize_binary(binary, 0)
  }
}

fn main_run_child_argv(argc: i64, argv: i64, first_product_arg: i64, executable: i64) -> i64 {
  let argument_count = argc - first_product_arg
  let child_argv = alloc_zeroed((argument_count + 2) * 8)
  mem_store64_at(child_argv, 0, executable)
  for index in 0..argument_count {
    mem_store64_at(
      child_argv,
      (index + 1) * 8,
      mem_load64_at(argv, (first_product_arg + index) * 8)
    )
  }
  child_argv
}

fn main_run_product(
  product: PipelineNativeProduct,
  argc: i64,
  argv: i64,
  first_product_arg: i64,
  envp: i64
) -> i64 {
  match main_run_materialize(product) {
    MainRunMaterializationFailed -> 1
    MainRunMaterialized(executable) -> {
      let child_argv = main_run_child_argv(argc, argv, first_product_arg, executable)
      let child = sys_proc_fork()
      let status = if child < 0 {
        eprint("run: could not start product\n")
        1
      } else {
        if child == 0 {
          sys_proc_exec(executable, child_argv, envp)
          sys_exit(127)
          127
        } else {
          let status_ptr = alloc_zeroed(8)
          let waited = main_test_wait_blocking(child, status_ptr)
          if waited != child {
            eprint("run: could not wait for product\n")
            1
          } else { main_test_decode_wait_status(status_ptr) }
        }
      }
      sys_remove(executable)
      status
    }
  }
}

fn main_run_path(
  path: i64,
  argc: i64,
  argv: i64,
  first_product_arg: i64,
  envp: i64
) -[SourceAcquire]> i64 {
  let len = cstr_len(path)
  let file = read_cpath_file(path, len)
  let src = mem_load64_at(file, 0)
  let n = mem_load64_at(file, 8)
  if n <= 0 {
    eprint("run: could not read input file\n")
    1
  } else {
    match main_prepare_native_for_target_with_path_and_origin_and_grant(
      src,
      n,
      path,
      len,
      cpath_is_trusted_source(path, len),
      cpath_is_strict_source(path, len),
      cpath_can_grant_import_trust(path, len),
      native_link_target_host(),
      PipelineNativeReuseFreed,
      main_grammar_host(argc, argv)
    ) {
      MainNativePreparationFailed(status) -> status
      MainNativePrepared(native, source, _) -> main_run_product(
        pipeline_checked_native_product(
          native,
          __str_ptr(source.text),
          PipelineNativeDebugInformationIncluded
        ),
        argc,
        argv,
        first_product_arg,
        envp
      )
    }
  }
}

fn main_run_named(
  name: str,
  argc: i64,
  argv: i64,
  first_product_arg: i64,
  envp: i64
) -[SourceAcquire]> i64 {
  match main_project_binary("run", name) {
    MainProjectBinaryFailed(status) -> status
    MainProjectBinaryReady(target_name, source) -> main_run_path(
      runtime_str_cstring(source),
      argc,
      argv,
      first_product_arg,
      envp
    )
  }
}

fn compile_path_metrics(path: i64) -[SourceAcquire]> i64 {
  let started = main_test_now_millis()
  let len = cstr_len(path)
  let file = read_cpath_file(path, len)
  let src = mem_load64_at(file, 0)
  let n = mem_load64_at(file, 8)
  let loaded = main_test_now_millis()
  if n <= 0 {
    eprint("compile: could not read input file\n")
    1
  } else {
    compile_with_path_and_origin_and_grant_metrics(
      src,
      n,
      path,
      len,
      cpath_is_trusted_source(path, len),
      cpath_is_strict_source(path, len),
      cpath_can_grant_import_trust(path, len),
      main_compile_elapsed_millis(started, loaded)
    )
  }
}

fn compile_path_rc_census(path: i64) -[SourceAcquire]> i64 {
  let len = cstr_len(path)
  let file = read_cpath_file(path, len)
  let src = mem_load64_at(file, 0)
  let n = mem_load64_at(file, 8)
  if n <= 0 {
    eprint("compile: could not read input file\n")
    1
  } else {
    compile_with_path_and_origin_and_grant_rc_census(
      src,
      n,
      path,
      len,
      cpath_is_trusted_source(path, len),
      cpath_is_strict_source(path, len),
      cpath_can_grant_import_trust(path, len)
    )
  }
}

fn compile_path_checker_storage_census(
  path: i64,
  sdk_embed: MainSdkEmbedMode
) -[SourceAcquire]> i64 {
  let len = cstr_len(path)
  let file = read_cpath_file(path, len)
  let src = mem_load64_at(file, 0)
  let n = mem_load64_at(file, 8)
  if n <= 0 {
    eprint("compile: could not read input file\n")
    1
  } else {
    compile_with_path_and_origin_and_grant_checker_storage_census(
      src,
      n,
      path,
      len,
      cpath_is_trusted_source(path, len),
      cpath_is_strict_source(path, len),
      cpath_can_grant_import_trust(path, len),
      sdk_embed
    )
  }
}

-- Native test-runner process support stays behind sealed semantic platform
-- leaves so adding the runner does not turn the self-hosted compiler into a
-- relocatable object or expose target syscall numbers to ordinary code.
-- Raw process, path and clock helpers still shared with the check, fmt, run
-- and build commands; each goes with its last caller's typed migration.
fn main_test_now_millis() -> i64 {
  let mark = alloc_bump_mark()
  let timespec = alloc_zeroed(16)
  let status = sys_time_realtime(timespec)
  let result = if status < 0 { 0 - 1 }
  else { mem_load64_at(timespec, 0) * 1000 + mem_load64_at(timespec, 8) / 1000000 }
  alloc_bump_restore_same_segment(mark)
  result
}

fn main_test_decimal_len(value: i64) -> i64 {
  if value < 10 { 1 } else { 1 + main_test_decimal_len(value / 10) }
}

fn main_test_write_decimal(dst: i64, pos: i64, value: i64) -> i64 {
  let next = if value < 10 { pos }
  else { main_test_write_decimal(dst, pos, value / 10) }
  mem_store8_at(dst, next, 48 + value - value / 10 * 10)
  next + 1
}

fn main_test_write_all(fd: i64, ptr: i64, len: i64) -> i64 {
  let mut offset = 0
  let mut error = 0
  while offset < len and error == 0 {
    let wrote = sys_write(fd, ptr + offset, len - offset)
    if wrote > 0 { offset = offset + wrote }
    else { error = if wrote < 0 { 0 - wrote } else { 5 } }
  }
  error
}

fn main_test_wait_blocking_with_usage(pid: i64, status_ptr: i64, usage: i64) -> i64 {
  let mut done = 0
  let mut result = 0
  while done == 0 {
    let waited = sys_proc_wait_usage(pid, status_ptr, 0, usage)
    if waited == 0 - 4 { 0 }
    else {
      result = waited
      done = 1
    }
  }
  result
}

fn main_test_wait_blocking(pid: i64, status_ptr: i64) -> i64 {
  main_test_wait_blocking_with_usage(pid, status_ptr, 0)
}

fn main_test_decode_wait_status(status_ptr: i64) -> i64 {
  let raw = mem_load64_at(status_ptr, 0)
  let signal = raw band 127
  if signal == 0 { (raw bshr 8) band 255 } else { 128 + signal }
}

fn main_test_eprint_cpath(path: i64) -> i64 {
  sys_write(2, path, cstr_len(path))
}

fn main_test_cpath_compare(left: i64, right: i64) -> i64 {
  let left_len = cstr_len(left)
  let right_len = cstr_len(right)
  let limit = if left_len < right_len { left_len } else { right_len }
  let mut i = 0
  let mut result = 0
  while i < limit and result == 0 {
    let a = mem_load8_at(left, i)
    let b = mem_load8_at(right, i)
    if a < b { result = 0 - 1 }
    else { if a > b { result = 1 } else { i = i + 1 } }
  }
  if result != 0 { result }
  else {
    if left_len < right_len { 0 - 1 }
    else { if left_len > right_len { 1 } else { 0 } }
  }
}

fn main_test_paths_add_sorted(paths: i64, path: i64) -> i64 {
  let n = nlist_len(paths)
  let mut insert = n
  let mut duplicate = 0
  let mut i = 0
  while i < n and insert == n and duplicate == 0 {
    let comparison = main_test_cpath_compare(path, nlist_get(paths, i))
    if comparison == 0 { duplicate = 1 }
    else { if comparison < 0 { insert = i } else { i = i + 1 } }
  }
  if duplicate == 1 { 0 }
  else {
    nlist_add(paths, path)
    let data = mem_load64_at(paths, 0)
    let mut move = n
    while move > insert {
      mem_store64_at(data, move * 8, mem_load64_at(data, (move - 1) * 8))
      move = move - 1
    }
    mem_store64_at(data, insert * 8, path)
    1
  }
}

fn main_test_join_path(prefix: i64, prefix_len: i64, name: i64, name_len: i64) -> i64 {
  let path = main_alloc_bytes(prefix_len + name_len + 1)
  if prefix_len > 0 { mem_copy(path, prefix, prefix_len) } else { 0 }
  mem_copy(path + prefix_len, name, name_len)
  mem_store8_at(path, prefix_len + name_len, 0)
  path
}

fn main_test_name_is_dot(name: i64, len: i64) -> i64 {
  if len == 1 and mem_load8_at(name, 0) == 46 { 1 }
  else {
    if len == 2 and mem_load8_at(name, 0) == 46 and mem_load8_at(name, 1) == 46 { 1 }
    else { 0 }
  }
}

fn main_test_name_is_weft(name: i64, len: i64) -> i64 {
  if len < 5 { 0 }
  else {
    mem_load8_at(name, len - 5) == 46 and
      mem_load8_at(name, len - 4) == 119 and
      mem_load8_at(name, len - 3) == 101 and
      mem_load8_at(name, len - 2) == 102 and
      mem_load8_at(name, len - 1) == 116
  }
}

-- Returns (kind, device, inode, mode), where kind 1 is a directory and kind 2 is
-- another existing object. stat64 follows symlinks; the stable device/inode
-- identity lets recursive discovery follow useful aliases without cycles.
fn main_test_path_metadata(path: i64) -> i64 {
  let stat_buf = alloc_zeroed(sys_stat_scratch_size())
  let status = sys_stat_follow(path, stat_buf)
  if status < 0 { 0 }
  else {
    let mode = sys_stat_mode(stat_buf)
    let kind = if (mode band 61440) == 16384 { 1 } else { 2 }
    node_new(0, kind, sys_stat_device(stat_buf), sys_stat_inode(stat_buf), mode)
  }
}

fn main_test_directory_identity_add(visited: i64, metadata: i64) -> i64 {
  let device = node_f2(metadata)
  let inode = node_f3(metadata)
  let mut i = 0
  let mut duplicate = 0
  while i < nlist_len(visited) and duplicate == 0 {
    let identity = nlist_get(visited, i)
    if node_f1(identity) == device and node_f2(identity) == inode { duplicate = 1 }
    else { i = i + 1 }
  }
  if duplicate == 1 { 0 }
  else { nlist_add(visited, node_new(0, device, inode, 0, 0)) 1 }
}

fn main_test_directory_entry_name_len(entry: i64, record_len: i64) -> i64 {
  let name = sys_dir_entry_name(entry)
  let max_len = record_len - (name - entry)
  let mut len = 0
  while len < max_len and mem_load8_at(name, len) != 0 { len = len + 1 }
  if max_len > 0 and len < max_len { len } else { 0 - 1 }
}

-- Scan one directory for recursive discovery. The result carries
-- (read error, number of matching .weft entries); child directories are
-- inserted into the lexicographically sorted pending list exactly once per
-- followed filesystem identity.
fn main_test_collect_directory_level(paths: i64, pending: i64, visited: i64, dir_path: i64) -> i64
{
  let fd = sys_dir_open(dir_path)
  if fd < 0 { node_new(0, fd, 0, 0, 0) }
  else {
    let dir_len = cstr_len(dir_path)
    let needs_slash = if dir_len > 0 and mem_load8_at(dir_path, dir_len - 1) == 47 { 0 } else {
      1
    }
    let prefix_len = dir_len + needs_slash
    let prefix = main_alloc_bytes(prefix_len + 1)
    mem_copy(prefix, dir_path, dir_len)
    if needs_slash == 1 { mem_store8_at(prefix, dir_len, 47) } else { 0 }
    mem_store8_at(prefix, prefix_len, 0)
    let buf = main_alloc_bytes(16384)
    let base = main_alloc_bytes(8)
    mem_store64_at(base, 0, 0)
    let mut done = 0
    let mut error = 0
    let mut matched = 0
    while done == 0 {
      let count = sys_dir_read(fd, buf, 16384, base)
      if count == 0 { done = 1 }
      else {
        if count < 0 {
          error = count
          done = 1
        } else {
          let mut offset = 0
          while offset < count and error == 0 {
            let entry = buf + offset
            let record_len = sys_dir_entry_record_len(entry)
            let name_len = main_test_directory_entry_name_len(entry, record_len)
            if record_len <= 0 or offset + record_len > count or name_len < 0 {
              error = 0 - 5
            } else {
              let name = sys_dir_entry_name(entry)
              if main_test_name_is_dot(name, name_len) == 0 {
                let child = main_test_join_path(prefix, prefix_len, name, name_len)
                let metadata = main_test_path_metadata(child)
                if metadata != 0 and node_f1(metadata) == 1 {
                  if main_test_directory_identity_add(visited, metadata) == 1 {
                    main_test_paths_add_sorted(pending, child)
                  } else { 0 }
                } else {
                  if metadata != 0 and main_test_name_is_weft(name, name_len) == 1 {
                    matched = matched + 1
                    main_test_paths_add_sorted(paths, child)
                  } else { 0 }
                }
              } else { 0 }
              offset = offset + record_len
            }
          }
        }
      }
    }
    sys_close(fd)
    node_new(0, error, matched, 0, 0)
  }
}

fn main_test_collect_directory_recursive(
  paths: i64,
  root: i64,
  root_metadata: i64,
  error_prefix: str
) -> i64 {
  let pending = nlist_new()
  let visited = nlist_new()
  main_test_directory_identity_add(visited, root_metadata)
  main_test_paths_add_sorted(pending, root)
  let mut i = 0
  let mut failed = 0
  let mut matched = 0
  while i < nlist_len(pending) {
    let dir_path = nlist_get(pending, i)
    let result = main_test_collect_directory_level(paths, pending, visited, dir_path)
    if node_f1(result) < 0 {
      main_test_eprint_path_error(error_prefix, dir_path)
      failed = 1
    } else { matched = matched + node_f2(result) }
    i = i + 1
  }
  if failed == 1 { 0 - 1 } else { matched }
}

fn main_test_eprint_path_error(prefix: str, path: i64) -> i64 {
  eprint(prefix)
  main_test_eprint_cpath(path)
  eprint("\n")
}

fn main_test_parse_jobs(raw: i64) -> i64 {
  let len = cstr_len(raw)
  let mut i = 0
  let mut value = 0
  let mut valid = if len == 0 { 0 } else { 1 }
  while i < len and valid == 1 {
    let digit = mem_load8_at(raw, i)
    if digit < 48 or digit > 57 { valid = 0 }
    else {
      value = value * 10 + digit - 48
      if value > 64 { valid = 0 } else { 0 }
      i = i + 1
    }
  }
  if valid == 1 and value > 0 { value } else { 0 }
}

fn main_test_env_positive_i64(envp: i64, prefix: str, maximum: i64, fallback: i64) -> i64 {
  if envp == 0 { return fallback }
  let prefix_len = __str_len(prefix)
  let mut i = 0
  let mut result = fallback
  let mut found = 0
  while mem_load64_at(envp, i * 8) != 0 and found == 0 {
    let entry = mem_load64_at(envp, i * 8)
    let entry_len = cstr_len(entry)
    if entry_len > prefix_len and src_eq_at(entry, 0, __str_ptr(prefix), 0, prefix_len) == 1 {
      let mut pos = prefix_len
      let mut value = 0
      let mut valid = 1
      while pos < entry_len and valid == 1 {
        let digit = mem_load8_at(entry, pos)
        if digit < 48 or digit > 57 { valid = 0 }
        else {
          value = value * 10 + digit - 48
          if value > maximum { valid = 0 } else { 0 }
          pos = pos + 1
        }
      }
      if valid == 1 and value > 0 { result = value } else { 0 }
      found = 1
    } else { i = i + 1 }
  }
  result
}

fn main_test_compile_timeout_millis(envp: i64) -> i64 {
  main_test_env_positive_i64(envp, "WEFT_TEST_COMPILE_TIMEOUT=", 86400, 120) * 1000
}

fn main_test_rss_limit_kb(envp: i64) -> i64 {
  let compile_limit = main_test_env_positive_i64(
    envp,
    "WEFT_TEST_COMPILE_RSS_LIMIT_KB=",
    1000000000,
    0
  )
  let run_limit = main_test_env_positive_i64(envp, "WEFT_TEST_RUN_RSS_LIMIT_KB=", 1000000000, 0)
  if compile_limit == 0 { run_limit }
  else {
    if run_limit == 0 { compile_limit }
    else { if compile_limit < run_limit { compile_limit } else { run_limit } }
  }
}

fn main_test_find_free_worker(pids: i64, jobs: i64) -> i64 {
  let mut i = 0
  let mut found = 0 - 1
  while i < jobs and found < 0 {
    if mem_load64_at(pids, i * 8) == 0 { found = i } else { i = i + 1 }
  }
  found
}

fn main_test_pause_poll(pause: i64) -> i64 {
  mem_store64_at(pause, 0, 0)
  mem_store64_at(pause, 8, 10000000)
  sys_time_sleep(pause, 0)
}

fn main_pkg_native_wrapper_json(
  tt: i64,
  module_path: str,
  package_name: str,
  declaration: i64,
  fact: SemanticFunctionFact,
  storage: borrow RegistrationStorage
) -> Json {
  let signature_buffer = buf_new(128)
  docgen_append_function_signature(signature_buffer, tt, declaration, storage)
  let signature = runtime_str_from_bytes_copy(
    buf_ptr(signature_buffer),
    buf_len(signature_buffer)
  )
  match fact {
    SemanticFunction(name, parameters, result, effects, purity, ownership, shape, bounds) -> {
      Cons<JsonEntry>(
        json_entry("package", json_string(package_name)),
        Cons<JsonEntry>(
          json_entry("module", json_string(module_path)),
          Cons<JsonEntry>(
            json_entry("name", json_string(name)),
            Cons<JsonEntry>(
              json_entry("signature", json_string(signature)),
              Cons<JsonEntry>(
                json_entry("effects", json_string(effects.render())),
                Nil<JsonEntry>()
              )
            )
          )
        )
      ) |> json_object
    }
    SemanticFunctionOther(name) -> {
      Cons<JsonEntry>(
        json_entry("package", json_string(package_name)),
        Cons<JsonEntry>(
          json_entry("module", json_string(module_path)),
          Cons<JsonEntry>(
            json_entry("name", json_string(name)),
            Cons<JsonEntry>(
              json_entry("signature", json_string(signature)),
              Cons<JsonEntry>(json_entry("effects", json_string("unknown")), Nil<JsonEntry>())
            )
          )
        )
      ) |> json_object
    }
  }
}

fn main_pkg_native_wrapper_facts_from_table(
  tt: i64,
  registrations: RegistrationScope
) -> List<Json> {
  let storage = registration_storage(tt, registrations)
  let mut wrappers = Nil<Json>()
  let checked_functions = ttable_get_checked_functions(tt)
  for source_index in 0..ttable_native_binding_source_count(tt) {
    let source_entry = ttable_native_binding_source_at(tt, source_index)
    let source = ttable_native_binding_source_source(source_entry)
    let module_entry = module_fact_find_source(tt, source)
    let package_id = ttable_native_binding_source_package(source_entry)
    let package_identity = pkg_identity_find_id(tt, package_id)
    let module_path = if module_entry == 0 { "unknown" }
    else {
      runtime_str_from_bytes_copy(
        module_fact_entry_path_ptr(module_entry),
        module_fact_entry_path_len(module_entry)
      )
    }
    let package_name = if package_identity == 0 { "unknown" }
    else {
      runtime_str_from_bytes_copy(
        pkg_identity_name_ptr(package_identity),
        pkg_identity_name_len(package_identity)
      )
    }
    for declaration_index in 0..module_fact_decl_count(tt) {
      let declaration = module_fact_decl_at(tt, declaration_index)
      if docgen_decl_is_public_root(declaration, source) and module_decl_fact_namespace(
        declaration
      ) == module_decl_namespace_value() {
        let entry = if checked_functions == 0 { 0 } else {
          ftypes_find_decl(checked_functions, declaration)
        }
        match semantic_fact_function_entry(tt, entry, storage) {
          SemanticFactEnvelope(
            SemanticFactSchemaV1,
            SemanticFactFound(SemanticFactFunction(fact))
          ) ->
            {
              wrappers = wrappers.append(
                main_pkg_native_wrapper_json(
                  tt,
                  module_path,
                  package_name,
                  declaration,
                  fact,
                  storage
                )
              )
              0
            }
          _ -> 0
        }
      } else { 0 }
    }
  }
  wrappers
}

fn main_pkg_native_wrapper_facts_for_manifest(
  source: str,
  manifest: i64
) -[SourceAcquire]> Result<List<Json>, str> {
  let tt = ttable_new()
  let path = "native_audit.weft"
  if manifest != 0 { ttable_set_root_manifest(tt, manifest) } else { 0 }
  main_mark_root_origin_with_grant(tt, __str_ptr(source), 0, 1, 0)
  main_register_source_path(
    tt,
    __str_ptr(source),
    __str_len(source),
    __str_ptr(path),
    __str_len(path)
  )
  match pipeline_parse_with_error_count(source_from_text(source), tt) {
    PipelineParseResult(AstModule(fns, src, ast_tt, parse_owners, syntax_product), parse_errors) ->
      {
        let declarations = syntax_product.0
        let registrations = syntax_product.1
        if parse_errors != 0 { Err("pkg: native audit import graph did not parse") }
        else {
          let check_errors = pipeline_report_check(
            AstModule(fns, src, ast_tt, parse_owners, (declarations, registrations)),
            CheckProgram
          )
          if check_errors.errors != 0 { Err("pkg: native audit import graph did not check") }
          else { Ok(main_pkg_native_wrapper_facts_from_table(tt, registrations)) }
        }
      }
  }
}

fn main_pkg_native_wrapper_facts(source: str) -[SourceAcquire]> Result<List<Json>, str> {
  main_pkg_native_wrapper_facts_for_manifest(source, 0)
}

type MainPackageTrustReviewFacts {
  MainPackageTrustReviewFacts(str, str)
}

type MainPackageTrustDecision {
  MainPackageTrustReviewRequired,
  MainPackageTrustAccepted
}

fn main_pkg_trust_review_exact(facts: MainPackageTrustReviewFacts) -> str {
  match facts { MainPackageTrustReviewFacts(exact, capabilities) -> exact }
}

fn main_pkg_trust_review_capabilities(facts: MainPackageTrustReviewFacts) -> str {
  match facts { MainPackageTrustReviewFacts(exact, capabilities) -> capabilities }
}

fn main_pkg_store_owned_text(holder: i64, offset: i64, value: str) -> i64 {
  let stable = main_alloc_bytes(__str_len(value))
  mem_copy(stable, __str_ptr(value), __str_len(value))
  mem_store64_at(holder, offset, stable)
  mem_store64_at(holder, offset + 8, __str_len(value))
  0
}

fn main_pkg_trust_review_documents_into(
  holder: i64,
  manifest: i64,
  lock_data: i64,
  wrappers: List<Json>
) -[FileRead]> i64 {
  match pkg_native_authority_document(
    manifest,
    lock_data,
    wrappers,
    PackageAuthorityExactIdentity
  ) {
    Err(message) -> { pkg_stderr(message) pkg_stderr("\n") 1 }
    Ok(exact) -> match pkg_native_authority_document(
      manifest,
      lock_data,
      wrappers,
      PackageAuthorityCapabilities
    ) {
      Err(message) -> { pkg_stderr(message) pkg_stderr("\n") 1 }
      Ok(capabilities) -> {
        main_pkg_store_owned_text(
          holder,
          0,
          json_stringify(exact).expect("package authority identity contains only finite JSON")
        )
        main_pkg_store_owned_text(
          holder,
          16,
          json_stringify(capabilities).expect(
            "package authority capabilities contain only finite JSON"
          )
        )
        0
      }
    }
  }
}

fn main_pkg_trust_review_facts(
  manifest: i64,
  lock_data: i64
) -[SourceAcquire]> Result<MainPackageTrustReviewFacts, str> {
  match pkg_native_audit_import_source_for_manifest(manifest) {
    Err(message) -> Err(message)
    Ok(source) -> match main_pkg_native_wrapper_facts_for_manifest(source, manifest) {
      Err(message) -> Err(message)
      Ok(wrappers) -> {
        let holder = alloc_zeroed(32)
        let status = runtime_standalone_file_read(
          () => main_pkg_trust_review_documents_into(holder, manifest, lock_data, wrappers)
        )
        if status != 0 { Err("pkg: could not produce trusted dependency review facts") }
        else {
          Ok(
            MainPackageTrustReviewFacts(
              runtime_str_from_bytes_copy(mem_load64_at(holder, 0), mem_load64_at(holder, 8)),
              runtime_str_from_bytes_copy(mem_load64_at(holder, 16), mem_load64_at(holder, 24))
            )
          )
        }
      }
    }
  }
}

fn main_pkg_native_audit_source_into(holder: i64) -[FileRead]> i64 {
  match pkg_native_audit_import_source() {
    Err(message) -> { pkg_stderr(message) pkg_stderr("\n") 1 }
    Ok(source) -> {
      let stable = main_alloc_bytes(__str_len(source))
      mem_copy(stable, __str_ptr(source), __str_len(source))
      mem_store64_at(holder, 0, stable)
      mem_store64_at(holder, 8, __str_len(source))
      0
    }
  }
}

-- Audit every grammar export of the workspace manifest through the checker;
-- returns the document entries and the number of exports that failed.
fn main_pkg_audit_grammar_exports(
  exports: List<GrammarToolExport>,
  entries: List<Json>,
  failures: i64
) -[SourceAcquire]> (List<Json>, i64) {
  match exports {
    Nil -> (entries.reverse(), failures)
    Cons(export, rest) -> {
      let audit = grammar_tool_audit(export)
      main_pkg_audit_grammar_exports(
        rest,
        Cons(grammar_tool_audit_json(export, audit), entries),
        failures + if grammar_tool_audit_failed(audit) { 1 } else { 0 }
      )
    }
  }
}

fn main_pkg_cli_audit() -[SourceAcquire]> i64 {
  let source_holder = alloc_zeroed(16)
  let source_status = runtime_standalone_file_read(
    () => main_pkg_native_audit_source_into(source_holder)
  )
  if source_status != 0 { source_status }
  else {
    let source = runtime_str_from_bytes_copy(
      mem_load64_at(source_holder, 0),
      mem_load64_at(source_holder, 8)
    )
    match main_pkg_native_wrapper_facts(source) {
      Err(message) -> { pkg_stderr(message) pkg_stderr("\n") 1 }
      Ok(wrappers) -> {
        let (grammar_exports, failures) = main_pkg_audit_grammar_exports(
          grammar_tool_root_exports(),
          Nil<Json>(),
          0
        )
        runtime_standalone_file_read(
          () => pkg_cli_audit_with_wrappers(wrappers, grammar_exports, failures)
        )
      }
    }
  }
}

fn main_pkg_find_provider_in_path(name: str, directories: Vector<str>, index: i64) -> str {
  if index >= vector_len<str>(directories) { "" }
  else {
    let directory = vector_get_in_bounds<str>(directories, index)
    let base = if __str_len(directory) == 0 { "." } else { directory }
    let candidate = str_concat(str_concat(base, "/"), name)
    if main_path_exists(candidate) { candidate }
    else { main_pkg_find_provider_in_path(name, directories, index + 1) }
  }
}

fn main_pkg_provider(name: str, envp: i64) -> str {
  let path = main_environment_path(envp)
  if __str_len(path) == 0 { "" }
  else { main_pkg_find_provider_in_path(name, str_split(path, ":"), 0) }
}

fn main_pkg_stage_prefix() -> str {
  str_concat(".weft/staging/pkg-", runtime_int_to_str(sys_proc_id()))
}

fn main_pkg_with_acquisition(
  argc: i64,
  argv: i64,
  body: () -[PackageSourceAcquire, FileRead, FileWrite, DirInspect, DirMutate]> i64
) -> i64 {
  let envp = argv + (argc + 1) * 8
  let env = main_pkg_provider("env", envp)
  let git = main_pkg_provider("git", envp)
  let curl = main_pkg_provider("curl", envp)
  with process_handler(argc, argv) {
    package_source_with_process_providers(
      env,
      git,
      curl,
      () =>
        runtime_standalone_package_mutation_io_with(body)
    )
  }
}

fn main_pkg_update_snapshot_into(holder: i64) -[FileRead]> i64 {
  match pkg_update_snapshot_files() {
    Err(message) -> { pkg_stderr(message) pkg_stderr("\n") 1 }
    Ok(snapshot) -> {
      main_pkg_store_owned_text(holder, 0, pkg_update_snapshot_manifest(snapshot))
      main_pkg_store_owned_text(holder, 16, pkg_update_snapshot_lock(snapshot))
      0
    }
  }
}

fn main_pkg_update_snapshot_from_holder(holder: i64) -> PackageUpdateSnapshot {
  PackageUpdateSnapshot(
    runtime_str_from_bytes_copy(mem_load64_at(holder, 0), mem_load64_at(holder, 8)),
    runtime_str_from_bytes_copy(mem_load64_at(holder, 16), mem_load64_at(holder, 24))
  )
}

fn main_pkg_update_read_snapshot() -> Result<PackageUpdateSnapshot, str> {
  let holder = alloc_zeroed(32)
  let status = runtime_standalone_file_read(() => main_pkg_update_snapshot_into(holder))
  if status != 0 { Err("pkg: could not snapshot dependency update files") }
  else { Ok(main_pkg_update_snapshot_from_holder(holder)) }
}

fn main_pkg_update_restore(snapshot: PackageUpdateSnapshot) -> i64 {
  runtime_standalone_file_write(() => pkg_update_restore_files(snapshot))
}

fn main_pkg_trust_review_document(
  package_name: str,
  before: MainPackageTrustReviewFacts,
  after: MainPackageTrustReviewFacts,
  decision: MainPackageTrustDecision
) -> str {
  let capabilities_changed = if str_eq(
    main_pkg_trust_review_capabilities(before),
    main_pkg_trust_review_capabilities(after)
  ) == 1 { 0 } else { 1 }
  let decision_name = match decision {
    MainPackageTrustReviewRequired -> "review_required"
    MainPackageTrustAccepted -> "accepted"
  }
  let help = match decision {
    MainPackageTrustReviewRequired ->
      "review the before/after facts, then rerun the same update with --accept-trust-change"
    MainPackageTrustAccepted ->
      "the existing trusted module set now names the reviewed dependency identity"
  }
  let b = buf_new(1024)
  bstr(b, "{\"schema_version\":1,\"code\":\"E5014\",\"package\":")
  bstr(b, json_stringify(json_string(package_name)).expect("JSON strings are always finite"))
  bstr(b, ",\"decision\":")
  bstr(b, json_stringify(json_string(decision_name)).expect("JSON strings are always finite"))
  bstr(b, ",\"capabilities_changed\":")
  bstr(b, if capabilities_changed == 1 { "true" } else { "false" })
  bstr(b, ",\"before\":")
  bstr(b, main_pkg_trust_review_exact(before))
  bstr(b, ",\"after\":")
  bstr(b, main_pkg_trust_review_exact(after))
  bstr(b, ",\"help\":")
  bstr(b, json_stringify(json_string(help)).expect("JSON strings are always finite"))
  bstr(b, "}")
  runtime_str_from_bytes_copy(buf_ptr(b), buf_len(b))
}

fn main_pkg_update_trusted_candidate(
  argc: i64,
  argv: i64,
  name: str,
  snapshot: PackageUpdateSnapshot,
  before: MainPackageTrustReviewFacts,
  decision: MainPackageTrustDecision
) -[SourceAcquire]> i64 {
  match main_pkg_update_read_snapshot() {
    Err(message) -> { main_pkg_update_restore(snapshot) 1 }
    Ok(candidate_files) -> {
      let candidate_manifest_text = pkg_update_snapshot_manifest(candidate_files)
      let candidate_manifest = pkg_manifest_parse(
        __str_ptr(candidate_manifest_text),
        __str_len(candidate_manifest_text)
      )
      let candidate_lock_text = pkg_update_snapshot_lock(candidate_files)
      let candidate_lock = pkg_lock_parse(candidate_lock_text)
      if pkg_manifest_error_count(candidate_manifest) > 0 or
        pkg_manifest_refresh_trust_identity_from_lock(
          candidate_manifest,
          candidate_lock,
          __str_ptr(name),
          __str_len(name)
        ) != 0 {
          pkg_stderr("pkg: trusted dependency candidate identity is invalid\n")
          main_pkg_update_restore(snapshot)
          1
        } else {
          match main_pkg_trust_review_facts(candidate_manifest, candidate_lock) {
            Err(message) -> {
              pkg_stderr(message)
              pkg_stderr("\n")
              main_pkg_update_restore(snapshot)
              1
            }
            Ok(after) -> {
              let document = main_pkg_trust_review_document(name, before, after, decision)
              match decision {
                MainPackageTrustReviewRequired -> {
                  if main_pkg_update_restore(snapshot) != 0 { 1 }
                  else {
                    pkg_stderr(
                      "error[E5014]: trusted dependency update requires explicit capability review\n"
                    )
                    pkg_stderr(document)
                    pkg_stderr("\n")
                    1
                  }
                }
                MainPackageTrustAccepted -> {
                  let written = runtime_standalone_file_write(
                    () => pkg_manifest_write(candidate_manifest)
                  )
                  if written != 0 {
                    main_pkg_update_restore(snapshot)
                    1
                  } else {
                    let relocked = main_pkg_with_acquisition(
                      argc,
                      argv,
                      () =>
                        pkg_cli_lock_with_notice(main_pkg_stage_prefix(), PackageLockQuiet)
                    )
                    if relocked != 0 {
                      main_pkg_update_restore(snapshot)
                      1
                    } else {
                      pkg_stdout("pkg: updated trusted dependency\n")
                      pkg_stdout(document)
                      pkg_stdout("\n")
                      0
                    }
                  }
                }
              }
            }
          }
        }
    }
  }
}

fn main_pkg_update(
  argc: i64,
  argv: i64,
  name_ptr: i64,
  name_len: i64,
  pin_ptr: i64,
  pin_len: i64,
  decision: MainPackageTrustDecision
) -[SourceAcquire]> i64 {
  match main_pkg_update_read_snapshot() {
    Err(message) -> 1
    Ok(snapshot) -> {
      let manifest_text = pkg_update_snapshot_manifest(snapshot)
      let manifest = pkg_manifest_parse(__str_ptr(manifest_text), __str_len(manifest_text))
      let grant = pkg_manifest_find_trust_grant(manifest, name_ptr, name_len)
      let old_lock = pkg_lock_parse(pkg_update_snapshot_lock(snapshot))
      if pkg_manifest_error_count(manifest) > 0 or pkg_lock_data_status(old_lock) != 1 {
        pkg_stderr("pkg: dependency update requires a valid manifest and lock\n")
        1
      } else {
        let name = runtime_str_from_bytes_copy(name_ptr, name_len)
        let before: Result<MainPackageTrustReviewFacts, str> = if grant == 0 {
          Ok<MainPackageTrustReviewFacts, str>(MainPackageTrustReviewFacts("", ""))
        }
        else { main_pkg_trust_review_facts(manifest, old_lock) }
        match before {
          Err(message) -> { pkg_stderr(message) pkg_stderr("\n") 1 }
          Ok(before_facts) -> {
            let updated = runtime_standalone_file_read_write(
              () =>
                pkg_cli_update_pin_with_notice(
                  name_ptr,
                  name_len,
                  pin_ptr,
                  pin_len,
                  PackageUpdateQuiet
                )
            )
            if updated != 0 { updated }
            else {
              let locked = main_pkg_with_acquisition(
                argc,
                argv,
                () =>
                  pkg_cli_lock_with_notice(main_pkg_stage_prefix(), PackageLockQuiet)
              )
              if locked != 0 {
                main_pkg_update_restore(snapshot)
                locked
              } else {
                if grant == 0 {
                  pkg_stdout("pkg: updated dependency pin\n")
                  pkg_stdout("pkg: wrote weft.lock\n")
                  0
                } else {
                  main_pkg_update_trusted_candidate(
                    argc,
                    argv,
                    name,
                    snapshot,
                    before_facts,
                    decision
                  )
                }
              }
            }
          }
        }
      }
    }
  }
}

fn run_pkg(argc: i64, argv: i64) -[SourceAcquire]> i64 {
  if argc < 3 {
    pkg_stderr(
      "usage: weft pkg init [name]\nusage: weft pkg add NAME PATH\nusage: weft pkg add NAME --git HTTPS_URL --revision HEX\nusage: weft pkg add NAME --archive HTTPS_URL --sha256 sha256:HEX\nusage: weft pkg lock\nusage: weft pkg fetch [--offline]\nusage: weft pkg update NAME (--revision HEX | --sha256 sha256:HEX) [--accept-trust-change]\nusage: weft pkg exports\nusage: weft pkg audit\n"
    )
    1
  } else {
    let sub = mem_load64_at(argv, 16)
    if cstr_eq(sub, "init") == 1 {
      if argc > 3 {
        let name = mem_load64_at(argv, 24)
        runtime_standalone_file_write(() => pkg_cli_init(name, cstr_len(name)))
      } else {
        runtime_standalone_file_write(() => pkg_cli_init(__str_ptr("app"), __str_len("app")))
      }
    } else {
      if cstr_eq(sub, "add") == 1 {
        if argc == 5 {
          let name = mem_load64_at(argv, 24)
          let path = mem_load64_at(argv, 32)
          runtime_standalone_file_read_write(
            () => pkg_cli_add(name, cstr_len(name), path, cstr_len(path))
          )
        } else {
          if argc == 8 and cstr_eq(mem_load64_at(argv, 32), "--git") == 1 and cstr_eq(
            mem_load64_at(argv, 48),
            "--revision"
          ) == 1 {
            let name = mem_load64_at(argv, 24)
            let url_ptr = mem_load64_at(argv, 40)
            let pin_ptr = mem_load64_at(argv, 56)
            let source = PackageGitSource(
              runtime_str_from_bytes_copy(url_ptr, cstr_len(url_ptr)),
              runtime_str_from_bytes_copy(pin_ptr, cstr_len(pin_ptr))
            )
            runtime_standalone_file_read_write(
              () => pkg_cli_add_source(name, cstr_len(name), source)
            )
          } else {
            if argc == 8 and cstr_eq(mem_load64_at(argv, 32), "--archive") == 1 and cstr_eq(
              mem_load64_at(argv, 48),
              "--sha256"
            ) == 1 {
              let name = mem_load64_at(argv, 24)
              let url_ptr = mem_load64_at(argv, 40)
              let pin_ptr = mem_load64_at(argv, 56)
              let source = PackageArchiveSource(
                runtime_str_from_bytes_copy(url_ptr, cstr_len(url_ptr)),
                runtime_str_from_bytes_copy(pin_ptr, cstr_len(pin_ptr))
              )
              runtime_standalone_file_read_write(
                () => pkg_cli_add_source(name, cstr_len(name), source)
              )
            } else {
              pkg_stderr(
                "usage: weft pkg add NAME PATH\nusage: weft pkg add NAME --git HTTPS_URL --revision HEX\nusage: weft pkg add NAME --archive HTTPS_URL --sha256 sha256:HEX\n"
              )
              1
            }
          }
        }
      } else {
        if cstr_eq(sub, "lock") == 1 {
          main_pkg_with_acquisition(argc, argv, () => pkg_cli_lock(main_pkg_stage_prefix()))
        } else {
          if cstr_eq(sub, "fetch") == 1 {
            if argc == 3 {
              main_pkg_with_acquisition(
                argc,
                argv,
                () => pkg_cli_fetch_online(main_pkg_stage_prefix())
              )
            }
            else {
              if argc == 4 and cstr_eq(mem_load64_at(argv, 24), "--offline") == 1 {
                runtime_standalone_package_io(() => pkg_cli_fetch_offline())
              } else {
                pkg_stderr("usage: weft pkg fetch [--offline]\n")
                1
              }
            }
          } else {
            if cstr_eq(sub, "update") == 1 {
              if (
                argc == 6 or (
                  argc == 7 and cstr_eq(mem_load64_at(argv, 48), "--accept-trust-change") == 1
                )
              ) and
                (
                  cstr_eq(mem_load64_at(argv, 32), "--revision") == 1 or cstr_eq(
                    mem_load64_at(argv, 32),
                    "--sha256"
                  ) == 1
                ) {
                  let name = mem_load64_at(argv, 24)
                  let pin = mem_load64_at(argv, 40)
                  let decision = if argc == 7 { MainPackageTrustAccepted } else {
                    MainPackageTrustReviewRequired
                  }
                  main_pkg_update(argc, argv, name, cstr_len(name), pin, cstr_len(pin), decision)
                } else {
                  pkg_stderr(
                    "usage: weft pkg update NAME (--revision HEX | --sha256 sha256:HEX) [--accept-trust-change]\n"
                  )
                  1
                }
            } else {
              if cstr_eq(sub, "exports") == 1 {
                runtime_standalone_file_read(() => pkg_cli_exports())
              } else {
                if cstr_eq(sub, "audit") == 1 {
                  main_pkg_cli_audit()
                } else {
                  pkg_stderr("pkg: unknown command\n")
                  1
                }
              }
            }
          }
        }
      }
    }
  }
}

fn main_color_mode_arg(arg: i64) -> i64 {
  if cstr_eq(arg, "auto") == 1 { terminal_color_mode_auto() }
  else {
    if cstr_eq(arg, "always") == 1 { terminal_color_mode_always() }
    else {
      if cstr_eq(arg, "never") == 1 { terminal_color_mode_never() }
      else { 0 - 1 }
    }
  }
}

fn main_inline_color_mode_arg(arg: i64) -> i64 {
  if cstr_eq(arg, "--color=auto") == 1 { terminal_color_mode_auto() }
  else {
    if cstr_eq(arg, "--color=always") == 1 { terminal_color_mode_always() }
    else {
      if cstr_eq(arg, "--color=never") == 1 { terminal_color_mode_never() }
      else { 0 - 1 }
    }
  }
}

fn main_cstr_starts_with(ptr: i64, prefix: str) -> i64 {
  let prefix_len = __str_len(prefix)
  if cstr_len(ptr) < prefix_len { 0 }
  else { src_eq_at(ptr, 0, __str_ptr(prefix), 0, prefix_len) }
}

fn main_color_usage_error(message: str) -> i64 {
  eprint(message)
  eprint("usage: weft [--color auto|always|never] <command> [args...]\n")
  2
}

fn main_explain_code(code_ptr: i64) -> i64 {
  let origin: usize = 0
  for index in origin..registry.len() {
    let entry = registry.get(index).unwrap()
    match entry.code {
      DiagnosticCodeAssigned(code) -> if cstr_eq(code_ptr, code) == 1 {
        oprint(code)
        oprint(" [")
        oprint(entry.class.name())
        oprint("]\n")
        oprint(entry.summary)
        oprint("\n\n")
        oprint(entry.explanation)
        oprint("\n")
        return 0
      }
      DiagnosticCodeUnassigned -> nil
    }
  }
  eprint("explain: unknown diagnostic code: ")
  sys_write(2, code_ptr, cstr_len(code_ptr))
  eprint("\n")
  1
}

fn run_explain(argc: i64, argv: i64) -> i64 {
  if argc != 3 {
    eprint("usage: weft explain CODE\n")
    2
  } else { main_explain_code(mem_load64_at(argv, 16)) }
}

fn run_doc_path(path: i64) -[SourceAcquire]> i64 {
  let path_len = cstr_len(path)
  let file = read_cpath_file(path, path_len)
  let n = mem_load64_at(file, 8)
  if n <= 0 {
    eprint("doc: could not read input file\n")
    1
  } else {
    let source = source_from_bytes(mem_load64_at(file, 0), n)
    let src = __str_ptr(source.text)
    let tt = ttable_new()
    main_mark_root_origin_with_grant(
      tt,
      src,
      cpath_is_trusted_source(path, path_len),
      cpath_is_strict_source(path, path_len),
      cpath_can_grant_import_trust(path, path_len)
    )
    main_register_source_path(tt, src, n, path, path_len)
    match pipeline_parse_with_error_count(source, tt) {
      PipelineParseResult(
        AstModule(fns, ast_src, ast_tt, parse_owners, syntax_product),
        parse_errors
      ) ->
        {
          let declarations = syntax_product.0
          let registrations = syntax_product.1
          if parse_errors != 0 {
            eprint("doc: parse failed with ")
            eprint_i(parse_errors)
            eprint(" errors\n")
            1
          } else {
            let check_errors = pipeline_report_check(
              AstModule(
                fns,
                ast_src,
                ast_tt,
                parse_owners,
                (declarations, registrations)
              ),
              CheckProgram
            )
            if check_errors.errors != 0 {
              eprint("doc: type check failed with ")
              eprint_i(check_errors.errors)
              eprint(" errors\n")
              1
            } else {
              oprint(
                docgen_render_module(
                  TypedModule(
                    fns,
                    src,
                    tt,
                    source_owners.combined(parse_owners, check_errors.owners),
                    registrations
                  ),
                  runtime_str_from_bytes_copy(path, path_len)
                )
              )
              0
            }
          }
        }
    }
  }
}

fn run_doc(argc: i64, argv: i64) -[SourceAcquire]> i64 {
  if argc != 3 {
    eprint("usage: weft doc PATH\n")
    2
  } else { run_doc_path(mem_load64_at(argv, 16)) }
}

fn main_version_target_names(targets: List<NativeLinkTarget>, first: bool) -> i64 {
  match targets {
    Nil -> 0
    Cons(target, rest) -> {
      if first == false { oprint(",") } else { 0 }
      native_link_target_name(target) |> oprint
      main_version_target_names(rest, false)
    }
  }
}

fn main_version_human(origin: SdkOrigin) -> i64 {
  match weft_product_identity() {
    WeftProductIdentity(compiler, language, manifest, lock, binding, facts) -> {
      oprint("weft ")
      oprint(compiler)
      oprint(" (language ")
      oprint(language)
      oprint("; manifest ")
      oprint_i(manifest)
      oprint("; lock ")
      oprint_i(lock)
      oprint("; native-binding ")
      oprint_i(binding)
      oprint("; artifact-facts ")
      oprint_i(facts)
      oprint("; targets ")
      main_version_target_names(native_link_supported_targets(), true)
      match origin {
        EmbeddedSdk(digest) -> { oprint("; sdk embedded ") oprint(digest) }
        CheckoutSdk(root) -> { oprint("; sdk checkout ") oprint(root) }
        NoSdk -> oprint("; sdk absent")
      }
      oprint(")\n")
      0
    }
  }
}

fn run_version(argc: i64, argv: i64) -[SourceAcquire]> i64 {
  if argc == 2 { main_version_human(SourceAcquire.sdk_origin()) }
  else {
    if argc == 3 and cstr_eq(mem_load64_at(argv, 16), "--json") == 1 {
      oprint(weft_product_identity_json_render_with_sdk(SourceAcquire.sdk_origin()))
      oprint("\n")
      0
    } else {
      eprint("usage: weft version [--json]\n")
      2
    }
  }
}

fn main_target_binary_format(target: NativeLinkTarget) -> str {
  match target {
    NativeLinkMacosAarch64 -> "mach-o-64"
    NativeLinkLinuxAarch64 -> "elf64"
  }
}

fn main_target_json(target: NativeLinkTarget) -> Json {
  let mut fields = Nil<JsonEntry>()
  fields = fields.append(json_entry("target", json_string(native_link_target_name(target))))
  fields = fields.append(json_entry("host", json_bool(native_link_target_is_host(target))))
  fields = fields.append(json_entry("architecture", json_string("aarch64")))
  fields = fields.append(
    json_entry("binary_format", json_string(main_target_binary_format(target)))
  )
  fields = fields.append(
    json_entry(
      "minimum_platform_abi",
      native_link_artifact_platform_abi_json(
        native_link_target_platform_abi(target, Nil<NativeLinkLibrary>())
      )
    )
  )
  fields = fields.append(json_entry("standalone_default", json_bool(true)))
  fields = fields.append(json_entry("product_linker", json_string("weft-native")))
  json_object(fields)
}

fn main_target_list(targets: List<NativeLinkTarget>) -> i64 {
  match targets {
    Nil -> 0
    Cons(target, rest) -> {
      native_link_target_name(target) |> oprint
      oprint("\n")
      main_target_list(rest)
    }
  }
}

fn main_target_show(target: NativeLinkTarget) -> i64 {
  oprint(
    json_stringify(main_target_json(target)).expect(
      "target descriptions contain only finite JSON"
    )
  )
  oprint("\n")
  0
}

fn run_target(argc: i64, argv: i64) -> i64 {
  if argc == 3 and cstr_eq(mem_load64_at(argv, 16), "list") == 1 {
    main_target_list(native_link_supported_targets())
  } else {
    if argc >= 3 and cstr_eq(mem_load64_at(argv, 16), "show") == 1 {
      if argc == 3 { main_target_show(native_link_target_host()) }
      else {
        if argc == 4 {
          match main_target_argument(mem_load64_at(argv, 24)) {
            NativeLinkTargetParsed(target) -> main_target_show(target)
            NativeLinkTargetUnsupported -> {
              eprint("target: unsupported target; expected macos-aarch64 or linux-aarch64\n")
              2
            }
          }
        } else {
          eprint(
            "usage: weft target list\nusage: weft target show [macos-aarch64|linux-aarch64]\n"
          )
          2
        }
      }
    } else {
      eprint("usage: weft target list\nusage: weft target show [macos-aarch64|linux-aarch64]\n")
      2
    }
  }
}

-- Subcommand dispatch after process-wide presentation options have been
-- removed. Default (no args or "compile") is the full compilation pipeline.
fn main_dispatch_unchecked(argc: i64, argv: i64) -[SourceAcquire]> i64 {
  if argc > 1 {
    let cmd = mem_load64_at(argv, 8)
    if cstr_eq(cmd, "--version") == 1 {
      if argc == 2 { main_version_human(SourceAcquire.sdk_origin()) }
      else {
        eprint("usage: weft --version\n")
        2
      }
    }
    else {
      if cstr_eq(cmd, "version") == 1 { run_version(argc, argv) }
      else {
        if cstr_eq(cmd, "target") == 1 { run_target(argc, argv) }
        else {
          if cstr_eq(cmd, "fmt") == 1 {
            run_fmt_command(argc, argv)
          }
          else {
            if cstr_eq(cmd, "check") == 1 {
              if argc > 2 {
                let first = mem_load64_at(argv, 16)
                if cstr_eq(first, "--jobs") == 1 or cstr_eq(first, "-j") == 1 {
                  if argc < 5 {
                    eprint("usage: weft check [--jobs N] <path...>\n")
                    2
                  } else {
                    let jobs = main_test_parse_jobs(mem_load64_at(argv, 24))
                    if jobs == 0 {
                      eprint("check: --jobs must be an integer from 1 to 64\n")
                      2
                    } else { run_check_paths(argc, argv, 4, jobs) }
                  }
                } else {
                  if argc == 3 { run_check_path(first) }
                  else { run_check_paths(argc, argv, 2, 4) }
                }
              } else { run_check() }
            }
            else {
              if cstr_eq(cmd, "ast") == 1 {
                if argc > 2 { run_ast_path(mem_load64_at(argv, 16)) } else { run_ast() }
              }
              else {
                if cstr_eq(cmd, "test") == 1 { run_test_command(argc, argv) }
                else {
                  if cstr_eq(cmd, "mcp") == 1 {
                    if argc > 2 and cstr_eq(mem_load64_at(argv, 16), "serve") == 1 {
                      run_mcp_serve(argc, argv)
                    } else { run_mcp(argc, argv) }
                  }
                  else {
                    if cstr_eq(cmd, "lsp") == 1 { run_lsp() }
                    else {
                      if cstr_eq(cmd, "pkg") == 1 { run_pkg(argc, argv) }
                      else {
                        if cstr_eq(cmd, "explain") == 1 { run_explain(argc, argv) }
                        else {
                          if cstr_eq(cmd, "doc") == 1 { run_doc(argc, argv) }
                          else {
                            if cstr_eq(cmd, "ir") == 1 {
                              run_ir(argc, argv, main_grammar_host(argc, argv))
                            }
                            else if cstr_eq(cmd, "symbols") == 1 {
                              if argc > 2 {
                                run_symbols_path(
                                  mem_load64_at(argv, 16),
                                  main_grammar_host(argc, argv)
                                )
                              } else { 0 }
                            }
                            else {
                              if cstr_eq(cmd, "run") == 1 {
                                match main_run_options(argc, argv) {
                                  MainRunOptionsReady(input, first_product_arg) -> match input {
                                    MainRunPath(path) -> main_run_path(
                                      path,
                                      argc,
                                      argv,
                                      first_product_arg,
                                      argv + (argc + 1) * 8
                                    )
                                    MainRunTarget(name) -> main_run_named(
                                      name,
                                      argc,
                                      argv,
                                      first_product_arg,
                                      argv + (argc + 1) * 8
                                    )
                                  }
                                  MainRunOptionsInvalid -> {
                                    eprint("usage: weft run [TARGET|PATH] [-- ARG...]\n")
                                    2
                                  }
                                }
                              }
                              else {
                                if cstr_eq(cmd, "build") == 1 {
                                  match main_build_options(argc, argv) {
                                    MainBuildOptionsReady(
                                      input,
                                      output_path,
                                      facts_path,
                                      debug_mode,
                                      target,
                                      sdk_embed,
                                      reclamation
                                    ) ->
                                      match input {
                                        MainBuildPath(path) -> main_build_path(
                                          path,
                                          output_path,
                                          facts_path,
                                          debug_mode,
                                          target,
                                          reclamation,
                                          argv + (argc + 1) * 8,
                                          sdk_embed,
                                          main_grammar_host(argc, argv)
                                        )
                                        MainBuildTarget(name) -> main_build_named(
                                          name,
                                          debug_mode,
                                          target,
                                          reclamation,
                                          argv + (argc + 1) * 8,
                                          main_grammar_host(argc, argv)
                                        )
                                      }
                                    MainBuildOptionsInvalid -> {
                                      eprint(
                                        "usage: weft build [TARGET] [--target macos-aarch64|linux-aarch64] [--strip-debug] [--rc-quarantine]\n"
                                      )
                                      eprint(
                                        "       weft build PATH -o OUTPUT [--target macos-aarch64|linux-aarch64] [--artifact-facts PATH] [--strip-debug] [--rc-quarantine] [--embed-sdk ROOT]\n"
                                      )
                                      2
                                    }
                                  }
                                }
                                else {
                                  if cstr_eq(cmd, "compile") == 1 {
                                    if argc > 2 and cstr_eq(mem_load64_at(argv, 16), "--metrics") ==
                                      1 {
                                        if argc == 4 {
                                          compile_path_metrics(mem_load64_at(argv, 24))
                                        }
                                        else {
                                          eprint(
                                            "usage: weft compile [--metrics|--rc-census|--checker-storage-census] PATH\n"
                                          )
                                          2
                                        }
                                      } else {
                                        if argc > 2 and cstr_eq(
                                          mem_load64_at(argv, 16),
                                          "--rc-census"
                                        ) == 1 {
                                          if argc == 4 {
                                            compile_path_rc_census(mem_load64_at(argv, 24))
                                          }
                                          else {
                                            eprint(
                                              "usage: weft compile [--metrics|--rc-census|--checker-storage-census] PATH\n"
                                            )
                                            2
                                          }
                                        } else {
                                          if argc > 2 and cstr_eq(
                                            mem_load64_at(argv, 16),
                                            "--checker-storage-census"
                                          ) == 1 {
                                            if argc == 4 {
                                              compile_path_checker_storage_census(
                                                mem_load64_at(argv, 24),
                                                MainSdkEmbedDisabled
                                              )
                                            }
                                            else {
                                              if argc == 6 and cstr_eq(
                                                mem_load64_at(argv, 24),
                                                "--embed-sdk"
                                              ) == 1 {
                                                let root = mem_load64_at(argv, 32)
                                                compile_path_checker_storage_census(
                                                  mem_load64_at(argv, 40),
                                                  MainSdkEmbedRoot(
                                                    runtime_str_from_bytes_copy(
                                                      root,
                                                      cstr_len(root)
                                                    )
                                                  )
                                                )
                                              }
                                              else {
                                                eprint(
                                                  "usage: weft compile --checker-storage-census [--embed-sdk ROOT] PATH\n"
                                                )
                                                2
                                              }
                                            }
                                          } else {
                                            if argc > 2 {
                                              compile_path(
                                                mem_load64_at(argv, 16),
                                                main_grammar_host(argc, argv)
                                              )
                                            }
                                            else {
                                              let input = read_stdin_all()
                                              let src = mem_load64_at(input, 0)
                                              let n = mem_load64_at(input, 8)
                                              compile(src, n, main_grammar_host(argc, argv))
                                            }
                                          }
                                        }
                                      }
                                  }
                                  else {
                                    let input = read_stdin_all()
                                    let src = mem_load64_at(input, 0)
                                    let n = mem_load64_at(input, 8)
                                    compile(src, n, main_grammar_host(argc, argv))
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  } else {
    let input = read_stdin_all()
    let src = mem_load64_at(input, 0)
    let n = mem_load64_at(input, 8)
    compile(src, n, main_grammar_host(argc, argv))
  }
}

fn main_command_uses_package_cache(argc: i64, argv: i64) -> bool {
  if argc <= 1 { true }
  else {
    let command = mem_load64_at(argv, 8)
    if cstr_eq(command, "--version") == 1 or cstr_eq(command, "version") == 1 or cstr_eq(
      command,
      "target"
    ) == 1 or cstr_eq(command, "explain") == 1 or cstr_eq(command, "pkg") == 1 { false }
    else { true }
  }
}

fn main_package_cache_preflight() -> i64 {
  runtime_standalone_package_io(
    () => match pkg_lock_verify_project_cache() {
      PackageCacheVerified -> 0
      PackageCacheLockMalformed -> {
        eprint("error[E5005]: package lock is malformed or unsupported\n")
        1
      }
      PackageCacheMissing(name, content) -> {
        eprint("error[E5011]: locked dependency '")
        eprint(name)
        eprint("' is absent from the immutable package cache (")
        eprint(content)
        eprint(")\n")
        1
      }
      PackageCacheCorrupt(name, content) -> {
        eprint("error[E5012]: immutable cache content for dependency '")
        eprint(name)
        eprint("' does not match ")
        eprint(content)
        eprint("\n")
        1
      }
    }
  )
}

fn main_dispatch(argc: i64, argv: i64) -[SourceAcquire]> i64 {
  if main_command_uses_package_cache(argc, argv) and main_package_cache_preflight() != 0 { 1 }
  else { main_dispatch_unchecked(argc, argv) }
}

type MainExecutableLocation {
  MainExecutableLocated(str),
  MainExecutableUnresolved
}

type MainSdkLayout {
  MainCheckoutSdk(str),
  MainEmbeddedSdk
}

fn main_path_exists(path: str) -> bool {
  let stat = alloc_zeroed(sys_stat_scratch_size())
  sys_stat_follow(runtime_str_cstring(path), stat) >= 0
}

fn main_path_parent(path: str) -> str {
  let ptr = __str_ptr(path)
  let len = __str_len(path)
  let mut slash = 0 - 1
  let mut index = 0
  while index < len {
    if mem_load8_at(ptr, index) == 47 { slash = index } else { 0 }
    index = index + 1
  }
  if slash < 0 { "" }
  else {
    if slash == 0 { "/" }
    else { runtime_str_from_bytes_copy(ptr, slash) }
  }
}

fn main_environment_path(envp: i64) -> str {
  let mut index = 0
  let mut path = ""
  while mem_load64_at(envp, index * 8) != 0 and __str_len(path) == 0 {
    let entry = mem_load64_at(envp, index * 8)
    let len = cstr_len(entry)
    if len >= 5 and src_eq_at(entry, 0, __str_ptr("PATH="), 0, 5) == 1 {
      path = runtime_str_from_bytes_copy(entry + 5, len - 5)
    } else { 0 }
    index = index + 1
  }
  path
}

fn main_find_executable_in_path(
  name: str,
  directories: Vector<str>,
  index: i64
) -> MainExecutableLocation {
  if index >= vector_len<str>(directories) { MainExecutableUnresolved }
  else {
    let directory = vector_get_in_bounds<str>(directories, index)
    let base = if __str_len(directory) == 0 { "." } else { directory }
    let candidate = str_concat(str_concat(base, "/"), name)
    if main_path_exists(candidate) { MainExecutableLocated(candidate) }
    else { main_find_executable_in_path(name, directories, index + 1) }
  }
}

fn main_executable_location(argv: i64, envp: i64) -> MainExecutableLocation {
  let raw = mem_load64_at(argv, 0)
  let name = runtime_str_from_bytes_copy(raw, cstr_len(raw))
  if str_contains(name, "/") == 1 { MainExecutableLocated(name) }
  else {
    let path = main_environment_path(envp)
    if __str_len(path) == 0 { MainExecutableUnresolved }
    else { main_find_executable_in_path(name, str_split(path, ":"), 0) }
  }
}

fn main_executable_is_in_working_directory(argv: i64, envp: i64) -> bool {
  match main_executable_location(argv, envp) {
    MainExecutableUnresolved -> false
    MainExecutableLocated(path) -> {
      let parent = main_path_parent(path)
      let executable_directory = alloc_zeroed(sys_stat_scratch_size())
      let working_directory = alloc_zeroed(sys_stat_scratch_size())
      sys_stat_follow(runtime_str_cstring(parent), executable_directory) >= 0 and
        sys_stat_follow(runtime_str_cstring("."), working_directory) >= 0 and
        sys_stat_device(executable_directory) == sys_stat_device(working_directory) and
        sys_stat_inode(executable_directory) == sys_stat_inode(working_directory)
    }
  }
}

fn main_sdk_layout(argv: i64, envp: i64) -> MainSdkLayout {
  let stdlib_marker = "stdlib/test.weft"
  let runtime_marker = "runtime/syscall.weft"
  let compiler_marker = "compiler/main.weft"
  let manifest_marker = "weft.pkg"
  -- Live source belongs to a compiler being developed in its own directory.
  -- A caller's lookalike SDK tree cannot select a different standard library.
  if main_executable_is_in_working_directory(argv, envp) and
    main_path_exists(stdlib_marker) and main_path_exists(runtime_marker) and
    main_path_exists(compiler_marker) and main_path_exists(manifest_marker) {
      MainCheckoutSdk(".")
    } else { MainEmbeddedSdk }
}

fn main_dispatch_standalone(argc: i64, argv: i64) -> i64 {
  match main_sdk_layout(argv, argv + (argc + 1) * 8) {
    MainCheckoutSdk(root) -> source_acquire_with_checkout(root, () => main_dispatch(argc, argv))
    MainEmbeddedSdk -> match source_acquire_with_embedded(() => main_dispatch(argc, argv)) {
      Ok(status) -> status
      Err(error) -> {
        pipeline_diagnose_render_report(ttable_new(), sdk_archive_diagnostic(error))
        1
      }
    }
  }
}

-- Color is presentation-only state. Machine renderers consume the structured
-- Diagnostic unchanged, while the human handler consults this policy exactly
-- once per source registry. Explicit CLI settings override NO_COLOR/TERM.
fn main(argc: i64, argv: i64) -> i64 {
  let envp = argv + (argc + 1) * 8
  terminal_set_stderr_color_mode(terminal_environment_color_mode(envp))
  if argc > 1 {
    let option = mem_load64_at(argv, 8)
    let inline_mode = main_inline_color_mode_arg(option)
    if inline_mode >= 0 {
      terminal_set_stderr_color_mode(inline_mode)
      main_dispatch_standalone(argc - 1, argv + 8)
    } else {
      if cstr_eq(option, "--no-color") == 1 {
        terminal_set_stderr_color_mode(terminal_color_mode_never())
        main_dispatch_standalone(argc - 1, argv + 8)
      } else {
        if cstr_eq(option, "--color") == 1 {
          if argc < 3 {
            main_color_usage_error("weft: --color requires auto, always, or never\n")
          }
          else {
            let mode = main_color_mode_arg(mem_load64_at(argv, 16))
            if mode < 0 {
              main_color_usage_error(
                "weft: invalid --color value; expected auto, always, or never\n"
              )
            }
            else {
              terminal_set_stderr_color_mode(mode)
              main_dispatch_standalone(argc - 2, argv + 16)
            }
          }
        } else {
          if main_cstr_starts_with(option, "--color=") == 1 {
            main_color_usage_error(
              "weft: invalid --color value; expected auto, always, or never\n"
            )
          } else { main_dispatch_standalone(argc, argv) }
        }
      }
    }
  } else { main_dispatch_standalone(argc, argv) }
}

-- ======================================================================
-- Tool: symbols — dump emitted function offsets for profile attribution
-- Prints one authoritative native-provenance fact per emitted function,
-- using a checked declaration name where one exists and h<hash> otherwise.
-- ======================================================================
fn oprint(msg: str) -> i64 {
  sys_write(1, __str_ptr(msg), __str_len(msg))
}

fn oprint_i(n: i64) -> i64 {
  if n < 0 {
    oprint("-")
    oprint_i(0 - n)
  } else {
    if n < 10 {
      let b = alloc_words(1)
      mem_store8_at(b, 0, 48 + n)
      sys_write(1, b, 1)
    } else {
      oprint_i(n / 10)
      oprint_i(n - n / 10 * 10)
    }
  }
}

fn main_dump_symbol_facts(facts: PipelineNativeProvenanceFactList) -> i64 {
  match facts {
    PipelineNativeProvenanceFactNil -> 0
    PipelineNativeProvenanceFactCons(fact, rest) -> {
      match fact {
        PipelineNativeProvenanceFact(start, end, hash, framed, src, location) -> {
          oprint_i(start)
          oprint(" ")
          match location {
            PipelineNativeSourceUnknown -> { oprint("h") oprint_i(hash) }
            PipelineNativeSourceKnown(
              name_src,
              name_start,
              name_len,
              path_ptr,
              path_len,
              line,
              col
            ) ->
              sys_write(1, name_src + name_start, name_len)
          }
          oprint("\n")
        }
      }
      main_dump_symbol_facts(rest)
    }
  }
}

fn main_dump_symbols(native: NativeModule) -> i64 {
  main_dump_symbol_facts(pipeline_native_provenance_facts(native))
}

fn run_symbols_path(path: i64, host: MainGrammarHost) -[SourceAcquire]> i64 {
  let plen = cstr_len(path)
  let file = read_cpath_file(path, plen)
  let src = mem_load64_at(file, 0)
  let n = mem_load64_at(file, 8)
  match main_prepare_native_with_path_and_origin_and_grant(
    src,
    n,
    path,
    plen,
    cpath_is_trusted_source(path, plen),
    cpath_is_strict_source(path, plen),
    cpath_can_grant_import_trust(path, plen),
    host
  ) {
    MainNativePreparationFailed(status) -> status
    MainNativePrepared(native, source, _) -> main_dump_symbols(native)
  }
}

-- ======================================================================
-- Tool: ir — render typed IR for compiler work
-- `weft ir [--stage lowered|optimised|native] [--facts cleanup] [--all |
-- --function NAME] FILE` checks FILE as `build` does, lowers it, and prints
-- the IR of its functions. Typed IR is an unstable tier: this text is a
-- debugging view, not an interface.
-- ======================================================================
--- `native` is the optimised IR after native preparation: exactly the
--- functions native emission consumes.
type MainIrStage {
  MainIrLowered,
  MainIrOptimised,
  MainIrNative
}

--- Emission facts to show beneath each body. Cleanup records describe native
--- emission, so they require (and imply) the native stage.
type MainIrFacts {
  MainIrNoFacts,
  MainIrCleanupFacts
}

--- Which functions to show: the root file's own (the default), every
--- function including the SDK closure, or one function by name.
type MainIrScope {
  MainIrRoot,
  MainIrEverything,
  MainIrFunction(str)
}

type MainIrOptions {
  MainIrOptionsReady(MainIrStage, MainIrFacts, MainIrScope, i64),
  MainIrOptionsInvalid(str)
}

fn main_ir_usage() -> str {
  "usage: weft ir [--stage lowered|optimised|native] [--facts cleanup] [--all | --function NAME] FILE\n"
}

fn main_ir_options(argc: i64, argv: i64) -> MainIrOptions {
  let mut stage = MainIrOptimised
  let mut staged = false
  let mut facts = MainIrNoFacts
  let mut scope = MainIrRoot
  let mut scoped = false
  let mut path = 0
  let mut problem = ""
  let mut i = 2
  while i < argc and problem.len() == 0 {
    let arg = mem_load64_at(argv, i * 8)
    if cstr_eq(arg, "--stage") == 1 {
      if i + 1 >= argc { problem = "--stage needs lowered, optimised or native" }
      else {
        let choice = mem_load64_at(argv, (i + 1) * 8)
        if cstr_eq(choice, "lowered") == 1 { stage = MainIrLowered }
        else if cstr_eq(choice, "optimised") == 1 { stage = MainIrOptimised }
        else if cstr_eq(choice, "native") == 1 { stage = MainIrNative }
        else { problem = "unknown stage (use lowered, optimised or native)" }
        staged = true
        i = i + 1
      }
    } else if cstr_eq(arg, "--facts") == 1 {
      if i + 1 >= argc { problem = "--facts needs cleanup" }
      else if cstr_eq(mem_load64_at(argv, (i + 1) * 8), "cleanup") == 1 {
        facts = MainIrCleanupFacts
        i = i + 1
      } else { problem = "unknown facts (use cleanup)" }
    } else if cstr_eq(arg, "--function") == 1 {
      if i + 1 >= argc { problem = "--function needs a function name" }
      else if scoped { problem = "choose one of --all and --function" }
      else {
        let name = mem_load64_at(argv, (i + 1) * 8)
        scope = MainIrFunction(runtime_str_from_bytes_copy(name, cstr_len(name)))
        scoped = true
        i = i + 1
      }
    } else if cstr_eq(arg, "--all") == 1 {
      if scoped { problem = "choose one of --all and --function" }
      else {
        scope = MainIrEverything
        scoped = true
      }
    } else if path == 0 { path = arg }
    else { problem = "expected exactly one input file" }
    i = i + 1
  }
  if problem.len() > 0 { MainIrOptionsInvalid(problem) }
  else if path == 0 { MainIrOptionsInvalid("expected an input file") }
  else {
    match facts {
      MainIrNoFacts -> MainIrOptionsReady(stage, facts, scope, path)
      MainIrCleanupFacts -> match stage {
        MainIrNative -> MainIrOptionsReady(stage, facts, scope, path)
        _ -> if staged {
          MainIrOptionsInvalid("--facts cleanup describes native emission (use --stage native)")
        } else { MainIrOptionsReady(MainIrNative, facts, scope, path) }
      }
    }
  }
}

fn main_ir_name_insert(names: Map<i64, str>, src: i64, start: i64, len: i64) -> Map<i64, str> {
  if len <= 0 { names }
  else {
    -- Declarations, constructors, fields and operations are keyed by the
    -- spelling hashes IR instructions store. A name spelled once may be keyed
    -- under more than one of them.
    let name = runtime_str_from_bytes_copy(src + start, len)
    names.insert(str_hash(src, start, len), name).insert(effect_name_hash(src, start, len), name).insert(
      field_access_key(src, start, len),
      name
    )
  }
}

-- Declared names by hash: functions from the checked function list, and
-- types, constructors, fields, effects and operations from the type table.
-- Specialisations and synthetic bodies have no entry and render as h<hash>.
fn main_ir_names(typed: TypedModule) -> Map<i64, str> {
  match typed {
    TypedModule(fns, _, tt, _, _) -> {
      let mut names = map.new<i64, str>()
      for i in 0..ttable_entry_count(tt) {
        let entry = ttable_entry_at(tt, i)
        let entry_src = ttable_entry_source(entry)
        let name_len = ttable_entry_name_len(entry)
        let kind = ttable_entry_kind(entry)
        if name_len > 0 {
          -- Checked effect atoms and resolved nominal references key by the
          -- declaration identity rather than by spelling.
          let name = runtime_str_from_bytes_copy(ttable_entry_name_ptr(entry), name_len)
          let namespace = if kind == 2 { module_decl_namespace_effect() }
          else if kind == 3 { module_decl_namespace_trait() }
          else { module_decl_namespace_type() }
          let identity = ty_declaration_identity_hash(
            module_decl_fact_find(
              tt,
              entry_src,
              namespace,
              entry_src,
              ttable_entry_name_start(entry),
              name_len
            )
          )
          -- An implementation entry is named and indexed by its target type,
          -- which is how primitive method receivers get their names.
          names = main_ir_name_insert(names, entry_src, ttable_entry_name_start(entry), name_len).insert(
            ttable_entry_name_hash(entry),
            name
          )
          if identity != 0 { names = names.insert(identity, name) } else { 0 }
        } else { 0 }
        let items = ttable_entry_items(entry)
        let count = ttable_entry_item_count(entry)
        if kind == 1 and items != 0 {
          for vi in 0..count {
            names = main_ir_name_insert(
              names,
              entry_src,
              ttable_entry_variant_name_start(entry, vi),
              ttable_entry_variant_name_len(entry, vi)
            )
          }
        } else if kind == 0 and items != 0 {
          for fi in 0..count {
            names = main_ir_name_insert(
              names,
              entry_src,
              ttable_entry_record_field_name_start(entry, fi),
              ttable_entry_record_field_name_len(entry, fi)
            )
          }
        } else if (kind == 2 or kind == 3) and items != 0 {
          -- Effect operations and trait methods are name nodes.
          for oi in 0..nlist_len(items) {
            let item = nlist_get(items, oi)
            names = main_ir_name_insert(names, entry_src, node_f1(item), node_f2(item))
          }
        } else { 0 }
      }
      -- Functions after types, so impl methods can name their owner. The
      -- native pair key is how calls reach module functions and methods.
      for i in 0..nlist_len(fns) {
        let pair = nlist_get(fns, i)
        let decl = decl_from_node(node_f1(pair))
        let fn_src = node_f2(pair)
        let name_start = decl_name_start_or(decl, 0)
        let name_len = decl_name_len_or(decl, 0)
        names = main_ir_name_insert(names, fn_src, name_start, name_len)
        if name_len > 0 and pipeline_decl_node_is_function(node_f1(pair)) == 1 {
          let name = runtime_str_from_bytes_copy(fn_src + name_start, name_len)
          let label = if node_f3(pair) == 0 { name }
          else {
            match names.get(pipeline_impl_pair_native_type_hash(pair)) {
              Some(owner) -> owner.concat(".").concat(name)
              None -> name
            }
          }
          names = names.insert(pipeline_fn_pair_key(pair), label)
        } else { 0 }
      }
      main_ir_pseudo_names(main_ir_intrinsic_names(names, tt))
    }
  }
}

-- Intrinsic calls are keyed by their spelling, and the intrinsic registry is
-- a spelling test rather than data. Name every `__identifier` the loaded
-- sources spell, which covers exactly the intrinsics this program calls.
fn main_ir_intrinsic_names(names: Map<i64, str>, tt: i64) -> Map<i64, str> {
  let sources = ttable_sources(tt)
  let mut result = names
  for si in 0..nlist_len(sources) {
    let entry = nlist_get(sources, si)
    let buffer = ttable_source_entry_buffer(entry)
    let length = ttable_source_entry_len(entry)
    let mut i = 0
    while i + 2 < length {
      let previous = if i == 0 { 32 } else { mem_load8_at(buffer, i - 1) }
      let boundary = not (
        (previous >= 97 and previous <= 122) or (previous >= 65 and previous <= 90) or (
          previous >= 48 and previous <= 57
        ) or previous == 95
      )
      if boundary and mem_load8_at(buffer, i) == 95 and mem_load8_at(buffer, i + 1) == 95 {
        let mut end = i + 2
        while end < length and (
          (mem_load8_at(buffer, end) >= 97 and mem_load8_at(buffer, end) <= 122) or (
            mem_load8_at(buffer, end) >= 48 and mem_load8_at(buffer, end) <= 57
          ) or mem_load8_at(buffer, end) == 95
        ) { end = end + 1 }
        if end > i + 2 {
          result = result.insert(
            str_hash(buffer, i, end - i),
            runtime_str_from_bytes_copy(buffer + i, end - i)
          )
        } else { 0 }
        i = end
      } else { i = i + 1 }
    }
  }
  result
}

-- Compiler-owned pseudo callees stand in for lowering-time operations until
-- native emission; they have no declaration of their own.
fn main_ir_pseudo_names(names: Map<i64, str>) -> Map<i64, str> {
  names.insert(pipeline_ir_pseudo_scaled_load64_hash(), "pseudo.scaled_load64").insert(
    pipeline_ir_pseudo_scaled_store64_hash(),
    "pseudo.scaled_store64"
  ).insert(pipeline_ir_pseudo_scaled_store64_discard_hash(), "pseudo.scaled_store64_discard").insert(
    pipeline_ir_pseudo_bridge_load64_hash(),
    "pseudo.bridge_load64"
  ).insert(pipeline_ir_pseudo_bridge_store64_hash(), "pseudo.bridge_store64").insert(
    pipeline_ir_pseudo_bridge_store64_discard_hash(),
    "pseudo.bridge_store64_discard"
  ).insert(pipeline_ir_pseudo_bridge_load8_hash(), "pseudo.bridge_load8").insert(
    pipeline_ir_pseudo_bridge_store8_hash(),
    "pseudo.bridge_store8"
  ).insert(pipeline_ir_pseudo_bridge_store8_discard_hash(), "pseudo.bridge_store8_discard").insert(
    pipeline_ir_pseudo_par_lowering_marker_hash(),
    "pseudo.par_lowering_marker"
  ).insert(
    pipeline_ir_pseudo_handler_cleanup_reactivate_hash(),
    "pseudo.handler_cleanup_reactivate"
  )
}

fn main_ir_plan_kind(kind: i64) -> str {
  match kind {
    1 -> "owned"
    2 -> "record"
    3 -> "tuple"
    4 -> "named"
    5 -> "variant"
    6 -> "opaque"
    _ -> "kind".concat(runtime_int_to_str(kind))
  }
}

fn main_ir_plan_text(names: Map<i64, str>, plan: i64) -> str {
  if plan == 0 { "plan{}" }
  else {
    let types = IrRenderContext {
      names: names,
      plan_text: (inner: i64) => "plan",
      cleanup: ir_render.no_cleanup
    }
    "plan{".concat(main_ir_plan_kind(typeck_linear_layout_plan_kind(plan))).concat(" ").concat(
      ir_render.type_text(types, typeck_linear_layout_plan_type(plan))
    ).concat(" words=").concat(runtime_int_to_str(typeck_linear_layout_plan_words(plan))).concat(
      "}"
    )
  }
}

-- Cleanup records are computed as native emission computes them: over one
-- map carrying the type table, the checked functions and the call contracts
-- of the prepared module.
fn main_ir_cleanup_map(typed: TypedModule, native: PipelineIrNativeInput) -> i64 {
  match typed {
    TypedModule(fns, _, tt, _, _) -> {
      let fm = fmap_new()
      fmap_set_tt(fm, tt)
      fmap_set_native_fns(fm, fns)
      fmap_set_native_call_contract_facts(
        fm,
        pipeline_ir_native_call_contract_facts(native.facts)
      )
      fm
    }
  }
}

fn main_ir_render(
  typed: TypedModule,
  stage: MainIrStage,
  facts: MainIrFacts,
  selection: IrRenderSelection
) -> str {
  let names = main_ir_names(typed)
  let plans = (plan: i64) => main_ir_plan_text(names, plan)
  let lowered = pipeline_lower_checked_with_weft(typed)
  match stage {
    MainIrLowered -> ir_render.render_selected(
      pipeline_ir_functions(lowered),
      IrRenderContext { names: names, plan_text: plans, cleanup: ir_render.no_cleanup },
      selection
    )
    MainIrOptimised -> ir_render.render_selected(
      pipeline_ir_functions(pipeline_optimise_typed_ir(typed, lowered)),
      IrRenderContext { names: names, plan_text: plans, cleanup: ir_render.no_cleanup },
      selection
    )
    MainIrNative -> {
      let native = pipeline_ir_native_input(typed, pipeline_optimise_typed_ir(typed, lowered), 0)
      let cleanup = match facts {
        MainIrNoFacts -> ir_render.no_cleanup
        MainIrCleanupFacts -> {
          let fm = main_ir_cleanup_map(typed, native)
          (blocks: IrBlockList) => pipeline_ir_abort_cleanup_records(blocks, fm)
        }
      }
      ir_render.render_selected(
        native.functions,
        IrRenderContext { names: names, plan_text: plans, cleanup: cleanup },
        selection
      )
    }
  }
}

fn run_ir(argc: i64, argv: i64, host: MainGrammarHost) -[SourceAcquire]> i64 {
  match main_ir_options(argc, argv) {
    MainIrOptionsInvalid(problem) -> {
      eprint("ir: ".concat(problem).concat("\n"))
      eprint(main_ir_usage())
      2
    }
    MainIrOptionsReady(stage, facts, scope, path) -> {
      let plen = cstr_len(path)
      let file = read_cpath_file(path, plen)
      let src = mem_load64_at(file, 0)
      let n = mem_load64_at(file, 8)
      if n <= 0 {
        eprint("ir: could not read input file\n")
        1
      } else {
        match main_check_program_for_target_with_path_and_origin_and_grant(
          src,
          n,
          path,
          plen,
          cpath_is_trusted_source(path, plen),
          cpath_is_strict_source(path, plen),
          cpath_can_grant_import_trust(path, plen),
          native_link_target_host(),
          host,
          "ir"
        ) {
          MainCheckedProgramFailed(status) -> status
          MainCheckedProgramReady(typed, _, _) -> {
            let root = match typed { TypedModule(_, root_src, _, _, _) -> root_src }
            let selection = match scope {
              MainIrRoot -> IrRenderSource(root)
              MainIrEverything -> IrRenderAll
              MainIrFunction(name) -> IrRenderNamed(name)
            }
            let text = main_ir_render(typed, stage, facts, selection)
            match scope {
              MainIrFunction(name) -> if text.len() == 0 {
                eprint("ir: no function named `".concat(name).concat("`\n"))
                1
              } else {
                oprint(text)
                0
              }
              _ -> {
                oprint(text)
                0
              }
            }
          }
        }
      }
    }
  }
}

-- ======================================================================
-- Tool: fmt — shared lossless parse-only engine
-- ======================================================================
fn main_fmt_result(
  src: i64,
  n: i64,
  path: i64,
  path_len: i64,
  trusted: i64,
  config: format_config.Config
) -> FormatterResult {
  let strict = pipeline_strict_for_trust(trusted)
  let tt = ttable_new()
  main_mark_root_origin_with_grant(tt, src, trusted, strict, 0)
  main_register_source_path_in_package(tt, src, n, path, path_len, 0)
  let result = handle formatter_format_source_with_config(src, n, tt, config) {
    Diagnose.report(diagnostic) -> { pipeline_diagnose_render_report(tt, diagnostic) resume(0) }
    Diagnose.error(msg, span) -> { pipeline_diagnose_render(tt, src, msg, span) resume(0) }
    Diagnose.warn(msg, span) -> { pipeline_diagnose_render(tt, src, msg, span) resume(0) }
    Diagnose.note(msg, span) -> { pipeline_diagnose_render(tt, src, msg, span) resume(0) }
  }
  result
}

fn run_fmt_source_with_path(
  src: i64,
  n: i64,
  path: i64,
  path_len: i64,
  trusted: i64,
  config: format_config.Config
) -> i64 {
  match main_fmt_result(src, n, path, path_len, trusted, config) {
    FormatterSuccess(formatted) -> {
      sys_write(1, __str_ptr(formatted), __str_len(formatted))
      0
    }
    FormatterFailure(error_count) -> {
      eprint("fmt: parse failed with ")
      eprint_i(error_count)
      eprint(" errors; no output written\n")
      1
    }
  }
}

fn run_fmt_source(src: i64, n: i64, trusted: i64, config: format_config.Config) -> i64 {
  run_fmt_source_with_path(src, n, 0, 0, trusted, config)
}

fn run_fmt_path(path: i64, config: format_config.Config) -> i64 {
  let len = cstr_len(path)
  let file = read_cpath_file(path, len)
  let src = mem_load64_at(file, 0)
  let n = mem_load64_at(file, 8)
  if src == 0 {
    main_test_eprint_path_error("fmt: could not read input file: ", path)
    1
  } else {
    run_fmt_source_with_path(src, n, path, len, cpath_is_trusted_source(path, len), config)
  }
}

fn run_fmt(config: format_config.Config) -> i64 {
  let input = read_stdin_all()
  run_fmt_source(mem_load64_at(input, 0), mem_load64_at(input, 8), 0, config)
}

fn main_fmt_bytes_equal(src: i64, n: i64, formatted: str) -> i64 {
  if n != __str_len(formatted) { 0 }
  else {
    let formatted_src = __str_ptr(formatted)
    let mut i = 0
    let mut equal = 1
    while i < n and equal == 1 {
      if mem_load8_at(src, i) != mem_load8_at(formatted_src, i) { equal = 0 }
      else { i = i + 1 }
    }
    equal
  }
}

fn main_fmt_lstat_mode(path: i64) -> i64 {
  -- The semantic leaf reports the normalised stat record, so read the mode
  -- through its accessor rather than at a Darwin `struct stat` byte offset.
  let stat_buf = alloc_zeroed(sys_stat_scratch_size())
  let status = sys_stat_nofollow(path, stat_buf)
  if status < 0 { 0 - 1 }
  else { sys_stat_mode(stat_buf) }
}

fn main_fmt_temp_path(path: i64) -> i64 {
  main_test_join_path(
    path,
    cstr_len(path),
    __str_ptr(".weft-fmt.tmp"),
    __str_len(".weft-fmt.tmp")
  )
}

-- Replace through an exclusive same-directory temporary. The original path
-- is untouched until every byte is written, permissions are restored, data
-- is synced, and the final rename succeeds.
fn main_fmt_atomic_write(path: i64, formatted: str, source_mode: i64) -> i64 {
  let temp = main_fmt_temp_path(path)
  let fd = sys_open_write_create_new(temp, source_mode band 4095)
  if fd < 0 {
    main_test_eprint_path_error("fmt: could not create temporary file: ", temp)
    1
  } else {
    let permission_status = sys_file_chmod(fd, source_mode band 4095)
    let write_status = if permission_status < 0 { 0 - permission_status }
    else { main_test_write_all(fd, __str_ptr(formatted), __str_len(formatted)) }
    let sync_status = if write_status != 0 { 0 } else { sys_file_flush(fd) }
    let close_status = sys_close(fd)
    if write_status != 0 or sync_status < 0 or close_status < 0 {
      sys_remove(temp)
      main_test_eprint_path_error("fmt: could not write temporary file: ", temp)
      1
    } else {
      let rename_status = sys_rename(temp, path)
      if rename_status < 0 {
        sys_remove(temp)
        main_test_eprint_path_error("fmt: could not replace source file: ", path)
        1
      } else { 0 }
    }
  }
}

fn main_fmt_write_result(path: i64, metadata: i64, formatted: str) -> i64 {
  let mode = node_f4(metadata)
  let lstat_mode = main_fmt_lstat_mode(path)
  if (mode band 61440) != 32768 {
    main_test_eprint_path_error("fmt: source is not a regular file: ", path)
    1
  } else {
    if lstat_mode < 0 {
      main_test_eprint_path_error("fmt: could not inspect source file: ", path)
      1
    } else {
      if (lstat_mode band 61440) == 40960 {
        main_test_eprint_path_error("fmt: refusing to replace symbolic link: ", path)
        1
      } else {
        if (mode band 146) == 0 {
          main_test_eprint_path_error("fmt: source file is read-only: ", path)
          1
        } else {
          main_fmt_atomic_write(path, formatted, mode)
        }
      }
    }
  }
}

-- operation 1 checks without mutation; operation 2 atomically rewrites.
fn main_fmt_process_path(path: i64, operation: i64, config: format_config.Config) -> i64 {
  let path_len = cstr_len(path)
  let file = read_cpath_file(path, path_len)
  let src = mem_load64_at(file, 0)
  let n = mem_load64_at(file, 8)
  if src == 0 {
    main_test_eprint_path_error("fmt: could not read input file: ", path)
    1
  } else {
    match main_fmt_result(src, n, path, path_len, cpath_is_trusted_source(path, path_len), config) {
      FormatterFailure(error_count) -> {
        eprint("fmt: parse failed for ")
        main_test_eprint_cpath(path)
        eprint(" with ")
        eprint_i(error_count)
        eprint(" errors; source left unchanged\n")
        1
      }
      FormatterSuccess(formatted) -> {
        if main_fmt_bytes_equal(src, n, formatted) == 1 { 0 }
        else {
          if operation == 1 {
            main_test_eprint_path_error("fmt: would reformat: ", path)
            1
          } else {
            -- Metadata is needed only for replacement safety. Acquiring it
            -- after parsing keeps check mode identical to the proven
            -- single-path formatter allocation shape, including large files.
            let metadata = main_test_path_metadata(path)
            if metadata == 0 {
              main_test_eprint_path_error("fmt: could not inspect source file: ", path)
              1
            } else { main_fmt_write_result(path, metadata, formatted) }
          }
        }
      }
    }
  }
}

fn main_fmt_expand_arg(paths: i64, arg: i64) -> i64 {
  let metadata = main_test_path_metadata(arg)
  if metadata != 0 and node_f1(metadata) == 1 {
    let status = main_test_collect_directory_recursive(
      paths,
      arg,
      metadata,
      "fmt: could not list directory: "
    )
    if status < 0 { 1 }
    else {
      if status == 0 {
        main_test_eprint_path_error("fmt: no .weft files in directory: ", arg)
        1
      } else { 0 }
    }
  } else {
    main_test_paths_add_sorted(paths, arg)
    0
  }
}

fn main_fmt_process_path_isolated(
  path: i64,
  operation: i64,
  worker_argv: i64,
  envp: i64,
  status_ptr: i64
) -> i64 {
  let operation_name = if operation == 1 { "--internal-check-one" } else {
    "--internal-write-one"
  }
  mem_store64_at(worker_argv, 16, runtime_str_cstring(operation_name))
  mem_store64_at(worker_argv, 48, path)
  let fork_result = sys_proc_fork()
  if fork_result < 0 {
    main_test_eprint_path_error("fmt: could not start formatter worker: ", path)
    1
  } else {
    if fork_result == 0 {
      sys_proc_exec(mem_load64_at(worker_argv, 0), worker_argv, envp)
      sys_exit(127)
    } else {
      mem_store64_at(status_ptr, 0, 0)
      let waited = main_test_wait_blocking(fork_result, status_ptr)
      if waited != fork_result {
        main_test_eprint_path_error("fmt: formatter worker failed: ", path)
        1
      } else {
        let result = main_test_decode_wait_status(status_ptr)
        if result == 0 { 0 } else { 1 }
      }
    }
  }
}

fn run_fmt_paths(
  argc: i64,
  argv: i64,
  requested: i64,
  operation: i64,
  config: format_config.Config
) -> i64 {
  let paths = nlist_new()
  let status_ptr = alloc_zeroed(8)
  let worker_argv = alloc_zeroed(64)
  let envp = argv + (argc + 1) * 8
  let worker_executable = match main_executable_location(argv, envp) {
    MainExecutableLocated(executable) -> runtime_str_cstring(executable)
    MainExecutableUnresolved -> mem_load64_at(argv, 0)
  }
  mem_store64_at(worker_argv, 0, worker_executable)
  mem_store64_at(worker_argv, 8, runtime_str_cstring("fmt"))
  mem_store64_at(worker_argv, 24, runtime_str_cstring("--max-line-length"))
  mem_store64_at(
    worker_argv,
    32,
    runtime_str_cstring(runtime_int_to_str(config.max_line_length()))
  )
  mem_store64_at(worker_argv, 40, runtime_str_cstring("--"))
  let mut failures = 0
  for i in 0..nlist_len(requested) {
    failures = failures + main_fmt_expand_arg(paths, nlist_get(requested, i))
  }
  for i in 0..nlist_len(paths) {
    -- A path's parse/render state dies with its short-lived worker. This
    -- keeps corpus-sized invocations bounded without rewinding allocations
    -- that managed cleanup or process-global compiler state may still own.
    -- Waiting immediately retains deterministic path/diagnostic order.
    failures = failures + main_fmt_process_path_isolated(
      nlist_get(paths, i),
      operation,
      worker_argv,
      envp,
      status_ptr
    )
  }
  if failures == 0 { 0 } else { 1 }
}

type FormatterCommandMode { FormatOutput, FormatCheck, FormatWrite }

fn main_fmt_usage() -> i64 {
  eprint("usage: weft fmt [--max-line-length N] [path]\n")
  eprint("usage: weft fmt [--max-line-length N] (--check | --write) <path...>\n")
  1
}

fn run_fmt_command(argc: i64, argv: i64) -> i64 {
  let requested = nlist_new()
  let mut config = format_config.defaults()
  let mut mode = FormatOutput
  let mut saw_width = false
  let mut internal_worker = false
  let mut options = true
  let mut i = 2
  -- Validate the complete request before starting workers or writing a file.
  while i < argc {
    let arg = mem_load64_at(argv, i * 8)
    if options and cstr_eq(arg, "--") == 1 {
      options = false
    } else if options and cstr_eq(arg, "--max-line-length") == 1 {
      if saw_width or i + 1 >= argc {
        eprint("fmt: --max-line-length requires one positive integer\n")
        return 1
      } else { 0 }
      i = i + 1
      let raw = mem_load64_at(argv, i * 8)
      match format_config.from_text(runtime_str_from_bytes_copy(raw, cstr_len(raw))) {
        Some(value) -> { config = value }
        None -> {
          eprint("fmt: --max-line-length requires one positive integer\n")
          return 1
        }
      }
      saw_width = true
    } else if options and (
      cstr_eq(arg, "--check") == 1 or cstr_eq(arg, "--internal-check-one") == 1
    ) {
      match mode { FormatOutput -> nil, _ -> { return main_fmt_usage() } }
      mode = FormatCheck
      internal_worker = cstr_eq(arg, "--internal-check-one") == 1
    } else if options and (
      cstr_eq(arg, "--write") == 1 or cstr_eq(arg, "--internal-write-one") == 1
    ) {
      match mode { FormatOutput -> nil, _ -> { return main_fmt_usage() } }
      mode = FormatWrite
      internal_worker = cstr_eq(arg, "--internal-write-one") == 1
    } else if options and cstr_len(arg) > 0 and mem_load8_at(arg, 0) == 45 {
      return main_fmt_usage()
    } else {
      nlist_add(requested, arg)
    }
    i = i + 1
  }
  let count = nlist_len(requested)
  match mode {
    FormatOutput -> {
      if count == 0 { run_fmt(config) }
      else if count == 1 { run_fmt_path(nlist_get(requested, 0), config) }
      else { main_fmt_usage() }
    }
    _ -> {
      let operation = match mode { FormatCheck -> 1, _ -> 2 }
      if count == 0 or (internal_worker and count != 1) { main_fmt_usage() }
      else if internal_worker {
        main_fmt_process_path(nlist_get(requested, 0), operation, config)
      }
      else { run_fmt_paths(argc, argv, requested, operation, config) }
    }
  }
}

-- ======================================================================
-- Tool: check — type check only (parse + check, no codegen)
-- ======================================================================
fn run_check_report(nfns: i64, errors: i64) -> i64 {
  eprint("check: ")
  eprint_i(nfns)
  eprint(" functions, ")
  eprint_i(errors)
  eprint(" errors\n")
  if errors == 0 { 0 } else { 1 }
}

fn main_render_project_diagnostics(diagnostics: ProjectDiagnostics) -> i64 {
  for i in 0..project_diagnostics_len(diagnostics) {
    let diagnostic = project_diagnostics_get(diagnostics, i)
    let src = project_diagnostics_item_source(diagnostics, i)
    let tt = project_diagnostics_item_type_table(diagnostics, i)
    if project_diagnostics_item_is_legacy(diagnostics, i) {
      pipeline_diagnose_render(
        tt,
        src,
        diagnose_report_message(diagnostic),
        diagnose_report_absolute_span(diagnostic)
      )
    } else { pipeline_diagnose_render_report(tt, diagnostic) }
  }
  project_diagnostics_error_count(diagnostics)
}

fn main_project_typed_function_count(typed: TypedModule) -> i64 {
  match typed { TypedModule(fns, src, tt, owners, _) -> nlist_len(fns) }
}

fn main_project_ast_function_count(ast: AstModule) -> i64 {
  match ast { AstModule(fns, _, _, _, _) -> nlist_len(fns) }
}

fn run_check_project_parse_failure(result: ProjectPreparedParseResult) -> i64 {
  match result {
    ProjectPreparedParseFailed(ast, source_n, diagnostics) -> {
      let errors = main_render_project_diagnostics(diagnostics)
      run_check_report(main_project_ast_function_count(ast), errors)
    }
    ProjectPreparedParseSourceUnset -> { eprint("check: could not read input file\n") 1 }
    ProjectPreparedParseCycle(cycle) -> { eprint("check: project dependency cycle\n") 1 }
    ProjectPreparedParseCorrupt -> { eprint("check: project session is corrupt\n") 1 }
    ProjectPreparedParseSucceeded(ast, source_n, diagnostics) -> {
      let errors = main_render_project_diagnostics(diagnostics)
      run_check_report(main_project_ast_function_count(ast), errors)
    }
  }
}

fn run_check_project_result(result: ProjectCheckResult) -> i64 {
  match result {
    ProjectCheckSucceeded(typed, source_n, parse_diagnostics, check_diagnostics) -> {
      let errors = main_render_project_diagnostics(parse_diagnostics) +
        main_render_project_diagnostics(check_diagnostics)
      run_check_report(main_project_typed_function_count(typed), errors)
    }
    ProjectCheckFailed(typed, source_n, parse_diagnostics, check_diagnostics) -> {
      let errors = main_render_project_diagnostics(parse_diagnostics) +
        main_render_project_diagnostics(check_diagnostics)
      run_check_report(main_project_typed_function_count(typed), errors)
    }
    ProjectCheckParseFailed(parse) -> run_check_project_parse_failure(parse)
    ProjectCheckSourceUnset -> { eprint("check: could not read input file\n") 1 }
    ProjectCheckCycle(cycle) -> { eprint("check: project dependency cycle\n") 1 }
    ProjectCheckCorrupt -> { eprint("check: project session is corrupt\n") 1 }
  }
}

fn main_mark_root_origin_with_grant(
  tt: i64,
  src: i64,
  trusted: i64,
  strict: i64,
  can_grant_trust: i64
) -> i64 {
  pipeline_mark_root_origin(tt, src, trusted, strict)
  if can_grant_trust == 1 {
    ttable_mark_source_trust_grant_source(tt, src)
  } else { 0 }
}

fn run_check_source_with_path(
  bytes: i64,
  raw_n: i64,
  path_ptr: i64,
  path_len: i64,
  trusted: i64,
  strict: i64,
  can_grant_trust: i64
) -[SourceAcquire]> i64 {
  let source = source_from_bytes(bytes, raw_n)
  let raw = __str_ptr(source.text)
  let probe_tt = ttable_new()
  main_mark_root_origin_with_grant(probe_tt, raw, trusted, strict, can_grant_trust)
  main_register_source_path(probe_tt, raw, raw_n, path_ptr, path_len)
  match pipeline_parse_with_error_count(source, probe_tt) {
    PipelineParseResult(
      AstModule(probe_fns, probe_src, probe_table, parse_owners, syntax_product),
      parse_errors
    ) ->
      {
        let declarations = syntax_product.0
        let probe_registrations = syntax_product.1
        if parse_errors != 0 {
          run_check_report(nlist_len(probe_fns), parse_errors)
        } else {
          if test_prepare.count(declarations) > 0 {
            let prefixed = test_prepare_source(source.text, test_prepare.count(declarations))
            let prepared = source_from_text(test_prepare_source_content(prefixed))
            let src = __str_ptr(prepared.text)
            let n = __str_len(prepared.text)
            let name_bank_start = test_prepare_source_wrapper_bank_start(prefixed)
            let tt = ttable_new()
            main_mark_root_origin_with_grant(tt, src, trusted, strict, can_grant_trust)
            main_register_source_path(tt, src, n, path_ptr, path_len)
            let fns_loaded = pipeline_parse(prepared, tt)
            let fns = fns_loaded.functions
            let wrapped = test_prepare.wrap(
              fns,
              fns_loaded.declarations,
              src,
              name_bank_start,
              tt,
              fns_loaded.registrations
            )
            let errors = pipeline_report_check(
              AstModule(
                wrapped.functions,
                src,
                tt,
                fns_loaded.owners,
                (fns_loaded.declarations, wrapped.registrations)
              ),
              CheckProgram
            )
            run_check_report(nlist_len(wrapped.functions), errors.errors)
          } else {
            let errors = pipeline_report_check(
              AstModule(
                probe_fns,
                probe_src,
                probe_table,
                parse_owners,
                (declarations, probe_registrations)
              ),
              CheckProgram
            )
            run_check_report(nlist_len(probe_fns), errors.errors)
          }
        }
      }
  }
}

fn main_project_register_root(
  tt: i64,
  src: i64,
  trusted: i64,
  strict: i64,
  can_grant_trust: i64
) -> i64 {
  main_mark_root_origin_with_grant(tt, src, trusted, strict, can_grant_trust)
}

fn run_check_source(
  raw: i64,
  raw_n: i64,
  trusted: i64,
  strict: i64,
  can_grant_trust: i64
) -[SourceAcquire]> i64 {
  run_check_source_with_path(raw, raw_n, 0, 0, trusted, strict, can_grant_trust)
}

fn main_check_context(path: i64) -> ProjectQueryContext {
  let len = cstr_len(path)
  let source_path = runtime_str_from_bytes_copy(path, len)
  project_query_context_with_trust(
    0,
    source_path,
    source_path,
    project_source_origin_disk(),
    0,
    1,
    cpath_is_trusted_source(path, len),
    cpath_is_strict_source(path, len),
    cpath_can_grant_import_trust(path, len)
  )
}

fn main_check_register_path(session: ProjectSession, path: i64) -> i64 {
  let len = cstr_len(path)
  let file = read_cpath_file(path, len)
  let src = mem_load64_at(file, 0)
  let n = mem_load64_at(file, 8)
  if n <= 0 {
    project_session_set_missing(session, main_check_context(path))
    0
  } else {
    project_session_set_source(
      session,
      main_check_context(path),
      runtime_str_from_bytes_copy(src, n)
    )
    1
  }
}

fn main_check_registered_path(session: ProjectSession, path: i64) -[SourceAcquire]> i64 {
  run_check_project_result(project_session_check_with_acquire(session, main_check_context(path)))
}

fn run_check_path(path: i64) -[SourceAcquire]> i64 {
  let session = project_session_new_with_root_registration(1, main_project_register_root)
  main_check_register_path(session, path)
  main_check_registered_path(session, path)
}

fn main_check_output_path(owner_pid: i64, index: i64) -> i64 {
  let prefix = "/tmp/weft-check-output-"
  let prefix_len = __str_len(prefix)
  let len = prefix_len + main_test_decimal_len(owner_pid) + 1 + main_test_decimal_len(index)
  let path = alloc_zeroed(len + 1)
  mem_copy(path, __str_ptr(prefix), prefix_len)
  let after_pid = main_test_write_decimal(path, prefix_len, owner_pid)
  mem_store8_at(path, after_pid, 45)
  main_test_write_decimal(path, after_pid + 1, index)
  path
}

fn main_check_redirect_stderr(path: i64) -> i64 {
  let fd = sys_open_write_create_truncate(path, 384)
  if fd < 0 { 1 }
  else {
    let status = if fd == 2 { 0 } else { sys_proc_dup_to(fd, 2) }
    if fd != 2 { sys_close(fd) } else { 0 }
    if status < 0 { 1 } else { 0 }
  }
}

fn main_check_spawn_worker(
  session: ProjectSession,
  path: i64,
  index: i64,
  owner_pid: i64
) -[SourceAcquire]> i64 {
  let output_path = main_check_output_path(owner_pid, index)
  sys_remove(output_path)
  let fork_result = sys_proc_fork()
  if fork_result < 0 { fork_result }
  else {
    if fork_result == 0 {
      if main_check_redirect_stderr(output_path) != 0 { sys_exit(2) }
      else { sys_exit(main_check_registered_path(session, path)) }
    } else { fork_result }
  }
}

fn main_check_replay_result(
  path: i64,
  owner_pid: i64,
  index: i64,
  result: i64,
  peak_rss_bytes: i64
) -> i64 {
  eprint("==> ")
  main_test_eprint_cpath(path)
  eprint(" <==\n")
  let output_path = main_check_output_path(owner_pid, index)
  let output = read_cpath_file(output_path, cstr_len(output_path))
  let raw = mem_load64_at(output, 0)
  let n = mem_load64_at(output, 8)
  if raw != 0 and n > 0 { sys_write(2, raw, n) }
  else {
    if result != 0 {
      eprint("check: worker produced no diagnostic output\n")
    } else { 0 }
  }
  if result == 124 { eprint("check: worker timed out\n") }
  else {
    if result == 125 {
      eprint("check: worker exceeded ")
      eprint_i((peak_rss_bytes + 1023) / 1024)
      eprint(" KB RSS\n")
    } else { if result > 125 { eprint("check: worker failed\n") } else { 0 } }
  }
  sys_remove(output_path)
  0
}

fn main_check_run_paths_parallel(paths: i64, envp: i64, jobs: i64) -[SourceAcquire]> i64 {
  let count = nlist_len(paths)
  let pids = alloc_zeroed(jobs * 8)
  let indexes = alloc_zeroed(jobs * 8)
  let starts = alloc_zeroed(jobs * 8)
  let usages = alloc_zeroed(jobs * 256)
  let results = alloc_zeroed(count * 8)
  let peaks = alloc_zeroed(count * 8)
  let status_ptr = alloc_zeroed(8)
  let pause = alloc_zeroed(16)
  let owner_pid = sys_proc_id()
  let timeout_millis = main_test_compile_timeout_millis(envp)
  let rss_limit_kb = main_test_rss_limit_kb(envp)
  let session = project_session_new_with_root_registration(1, main_project_register_root)
  for i in 0..count {
    main_check_register_path(session, nlist_get(paths, i))
    mem_store64_at(results, i * 8, 0 - 1)
  }
  let mut next = 0
  let mut active = 0
  while next < count or active > 0 {
    while next < count and active < jobs {
      let slot = main_test_find_free_worker(pids, jobs)
      let pid = main_check_spawn_worker(session, nlist_get(paths, next), next, owner_pid)
      if pid < 0 {
        mem_store64_at(results, next * 8, 127)
      } else {
        mem_store64_at(pids, slot * 8, pid)
        mem_store64_at(indexes, slot * 8, next)
        mem_store64_at(starts, slot * 8, main_test_now_millis())
        active = active + 1
      }
      next = next + 1
    }
    let mut progressed = 0
    let mut slot = 0
    while slot < jobs {
      let pid = mem_load64_at(pids, slot * 8)
      if pid != 0 {
        mem_store64_at(status_ptr, 0, 0)
        let usage = usages + slot * 256
        let waited = sys_proc_wait_usage(pid, status_ptr, 1, usage)
        let now = main_test_now_millis()
        let start = mem_load64_at(starts, slot * 8)
        let expired = start >= 0 and now >= start and now - start >= timeout_millis
        let mut result = 0 - 1
        let mut complete = 0
        if waited == pid {
          result = main_test_decode_wait_status(status_ptr)
          complete = 1
        } else {
          if waited < 0 and waited != 0 - 4 {
            result = 127
            complete = 1
          } else {
            if expired {
              sys_proc_kill(pid)
              let reaped = main_test_wait_blocking_with_usage(pid, status_ptr, usage)
              result = if reaped == pid { 124 } else { 127 }
              complete = 1
            } else { 0 }
          }
        }
        if complete == 1 {
          let index = mem_load64_at(indexes, slot * 8)
          let peak = mem_load64_at(usage, 32)
          if result <= 1 and rss_limit_kb > 0 and peak > rss_limit_kb * 1024 { result = 125 } else {
            0
          }
          mem_store64_at(results, index * 8, result)
          mem_store64_at(peaks, index * 8, peak)
          mem_store64_at(pids, slot * 8, 0)
          active = active - 1
          progressed = 1
        } else { 0 }
      } else { 0 }
      slot = slot + 1
    }
    if active > 0 and progressed == 0 { main_test_pause_poll(pause) } else { 0 }
  }
  let mut failures = 0
  for i in 0..count {
    let result = mem_load64_at(results, i * 8)
    main_check_replay_result(
      nlist_get(paths, i),
      owner_pid,
      i,
      result,
      mem_load64_at(peaks, i * 8)
    )
    if result == 0 { 0 } else { failures = failures + 1 }
  }
  -- The inherited workers retain source/query pointers owned by this session.
  project_session_database(session)
  failures
}

fn run_check_paths(argc: i64, argv: i64, first_path: i64, jobs: i64) -[SourceAcquire]> i64 {
  let paths = nlist_new()
  for i in first_path..argc { nlist_add(paths, mem_load64_at(argv, i * 8)) }
  if nlist_len(paths) == 0 {
    eprint("usage: weft check [--jobs N] <path...>\n")
    2
  } else {
    let failures = main_check_run_paths_parallel(paths, argv + (argc + 1) * 8, jobs)
    if failures == 0 { 0 } else { 1 }
  }
}

fn run_check() -[SourceAcquire]> i64 {
  let input = read_stdin_all()
  run_check_source(mem_load64_at(input, 0), mem_load64_at(input, 8), 0, 1, 0)
}

-- ======================================================================
-- Tool: ast — dump AST structure (parse only)
-- ======================================================================
fn run_ast_source(bytes: i64, n: i64, trusted: i64) -> i64 {
  let source = source_from_bytes(bytes, n)
  let src = __str_ptr(source.text)
  let tt = ttable_new()
  pipeline_mark_root_origin(tt, src, trusted, pipeline_strict_for_trust(trusted))
  let parsed = pipeline_parse_local_with_error_count(source, tt)
  let declarations = match parsed {
    PipelineParseResult(ast, _) -> pipeline_ast_source_declarations(ast)
  }
  eprint(inspection.render(declarations, source.text))
  0
}

fn run_ast_path(path: i64) -> i64 {
  let len = cstr_len(path)
  let file = read_cpath_file(path, len)
  let src = mem_load64_at(file, 0)
  let n = mem_load64_at(file, 8)
  if n <= 0 {
    eprint("ast: could not read input file\n")
    1
  } else {
    run_ast_source(src, n, cpath_is_trusted_source(path, len))
  }
}

fn run_ast() -> i64 {
  let input = read_stdin_all()
  run_ast_source(mem_load64_at(input, 0), mem_load64_at(input, 8), 0)
}

-- ======================================================================
-- Tools: mcp and lsp — JSON-RPC servers over the compiler's products
-- ======================================================================
-- The protocol surfaces are compiler/tool/{jsonrpc,mcp,lsp}; this section is
-- their handler configuration over the pipeline. Legacy parse and check
-- products still address sources by buffer, so their diagnostics and fact
-- queries are rendered through raw source views here until the typed checked
-- program replaces them.
-- Legacy parser, checker and formatter entry points read a source through
-- its address, and the legacy tables keep that address as a view. Every
-- such call goes through here; the caller retains the text.
fn main_legacy_address(text: str) -> i64 { __str_ptr(text) }

fn main_members() -> List<JsonEntry> { Nil<JsonEntry>() }

-- Members accumulate in reverse; `main_object` restores their order.
fn main_push(members: List<JsonEntry>, key: str, value: Json) -> List<JsonEntry> {
  Cons(JsonEntry(key, value), members)
}

fn main_object(reversed: List<JsonEntry>) -> Json { JsonObject(reversed.reverse()) }

fn main_in_order(members: [JsonEntry]) -> List<JsonEntry> {
  let mut listed = Nil<JsonEntry>()
  for member in members { listed = Cons(member, listed) }
  listed.reverse()
}

-- Unsigned values beyond the signed JSON number domain travel as decimal
-- text, as in the standard diagnostic codec.
fn main_u64_json(value: u64) -> Json {
  match value.to_i64_checked() {
    Ok(number) -> JsonNumber(number)
    Err(_) -> JsonString(num_render_u64(value))
  }
}

--- Rendered JSON values in report order.
type MainJsonItems { values: Vector<Json> }

fn main_json_items() -> MainJsonItems { MainJsonItems { values: vector.new<Json>() } }

fn main_json_items_add(items: MainJsonItems, value: Json) -> nil {
  let values = items.values
  vector_push<Json>(values, value)
  nil
}

fn main_json_items_count(items: MainJsonItems) -> i64 {
  let values = items.values
  vector_len<Json>(values)
}

fn main_json_items_array(items: MainJsonItems) -> Json {
  let values = items.values
  let mut listed = Nil<Json>()
  let mut index = vector_len<Json>(values)
  while index > 0 {
    index = index - 1
    listed = Cons(vector_get_in_bounds<Json>(values, index), listed)
  }
  JsonArray(listed)
}

--- One-based line and columns of a byte offset.
type MainSpanPosition { line: i64, col: i64, scalar_col: i64, utf16_col: i64 }

-- -1 throughout for an unknown offset or one after malformed text.
fn main_span_position<S: SourceBytes>(bytes: S, span: i64) -> MainSpanPosition {
  let unknown = MainSpanPosition { line: 0 - 1, col: 0 - 1, scalar_col: 0 - 1, utf16_col: 0 - 1 }
  if span < 0 { return unknown }
  let position = source_position_at(bytes, span)
  let line = source_position_line0(position)
  if line < 0 { return unknown }
  MainSpanPosition {
    line: line + 1,
    col: source_position_byte_column0(position) + 1,
    scalar_col: source_position_scalar_column0(position) + 1,
    utf16_col: source_position_utf16_column0(position) + 1
  }
}

fn main_push_position(
  members: List<JsonEntry>,
  prefix: str,
  position: MainSpanPosition
) -> List<JsonEntry> {
  members
    |> main_push(str_concat(prefix, "line"), JsonNumber(position.line))
    |> main_push(str_concat(prefix, "col"), JsonNumber(position.col))
    |> main_push(str_concat(prefix, "scalar_col"), JsonNumber(position.scalar_col))
    |> main_push(str_concat(prefix, "utf16_col"), JsonNumber(position.utf16_col))
}

-- Diagnostics ----------------------------------------------------------
fn main_diagnostic_source_entry(tt: i64, source: DiagnosticSource) -> i64 {
  if tt == 0 { 0 }
  else {
    match source {
      DiagnosticSourceBuffer(buffer) -> ttable_find_source_buffer_entry(tt, buffer)
      DiagnosticSourceNamed(name) -> ttable_find_source_named(tt, name)
      DiagnosticSourceUnknown -> 0
    }
  }
}

fn main_diagnostic_source_index(tt: i64, entry: i64) -> i64 {
  if tt == 0 or entry == 0 { 0 - 1 }
  else {
    let sources = ttable_sources(tt)
    let mut i = 0
    let mut found = 0 - 1
    while i < nlist_len(sources) and found < 0 {
      if nlist_get(sources, i) == entry { found = i } else { i = i + 1 }
    }
    found
  }
}

fn main_diagnostic_source_json(root_src: i64, tt: i64, source: DiagnosticSource) -> Json {
  match source {
    DiagnosticSourceUnknown -> main_object(
      main_push(main_members(), "kind", JsonString("unknown"))
    )
    DiagnosticSourceNamed(name) -> main_members()
      |> main_push("kind", JsonString("file"))
      |> main_push("path", JsonString(name))
      |> main_object
    DiagnosticSourceBuffer(buffer) -> {
      let entry = main_diagnostic_source_entry(tt, source)
      let path = if entry == 0 { "" } else { ttable_source_entry_path(entry) }
      if str_len(path) > 0 {
        main_members() |> main_push("kind", JsonString("file")) |> main_push(
          "path",
          JsonString(path)
        ) |>
          main_object
      } else if buffer == root_src {
        main_object(main_push(main_members(), "kind", JsonString("input")))
      } else {
        main_members()
          |> main_push("kind", JsonString("buffer"))
          |> main_push("id", JsonNumber(main_diagnostic_source_index(tt, entry)))
          |> main_object
      }
    }
  }
}

fn main_diagnostic_location_json(
  root_src: i64,
  root_n: i64,
  tt: i64,
  location: DiagnosticLocation
) -> Json {
  match location {
    DiagnosticLocationNone -> JsonNull
    DiagnosticSourceRange(source, start, end) -> {
      let entry = main_diagnostic_source_entry(tt, source)
      let source_ptr = match source {
        DiagnosticSourceBuffer(buffer) -> buffer
        DiagnosticSourceNamed(name) -> if entry == 0 { 0 } else {
          ttable_source_entry_buffer(entry)
        }
        DiagnosticSourceUnknown -> 0
      }
      let source_n = if entry != 0 { ttable_source_entry_len(entry) }
      else if source_ptr == root_src { root_n } else { 0 }
      let mut members = main_members()
        |> main_push("source", main_diagnostic_source_json(root_src, tt, source))
        |> main_push("span", main_u64_json(start.to_u64()))
        |> main_push("end_span", main_u64_json(end.to_u64()))
      if source_ptr != 0 and source_n >= 0 {
        let view = raw_source_view(source_ptr, source_n)
        members = members
          |> main_push_position(
            "",
            main_span_position(view, diagnostic_location_clamp_offset(start, source_n))
          )
          |> main_push_position(
            "end_",
            main_span_position(view, diagnostic_location_clamp_offset(end, source_n))
          )
      }
      main_object(members)
    }
  }
}

fn main_diagnostic_related_json(
  root_src: i64,
  root_n: i64,
  tt: i64,
  related: DiagnosticRelatedLocationList
) -> Json {
  let mut items = Nil<Json>()
  let mut current = related
  loop {
    match current {
      DiagnosticRelatedLocationNil -> return JsonArray(items.reverse())
      DiagnosticRelatedLocationCons(DiagnosticRelatedLocation(label, location), rest) -> {
        let item = main_members()
          |> main_push("label", JsonString(label))
          |> main_push("location", main_diagnostic_location_json(root_src, root_n, tt, location))
          |> main_object
        items = Cons(item, items)
        current = rest
      }
    }
  }
  JsonArray(items.reverse())
}

fn main_diagnostic_edits_json(
  root_src: i64,
  root_n: i64,
  tt: i64,
  edits: DiagnosticTextEditList
) -> Json {
  let mut items = Nil<Json>()
  let mut current = edits
  loop {
    match current {
      DiagnosticTextEditNil -> return JsonArray(items.reverse())
      DiagnosticTextEditCons(DiagnosticTextEdit(location, replacement), rest) -> {
        let item = main_members()
          |> main_push("location", main_diagnostic_location_json(root_src, root_n, tt, location))
          |> main_push("replacement", JsonString(replacement))
          |> main_object
        items = Cons(item, items)
        current = rest
      }
    }
  }
  JsonArray(items.reverse())
}

fn main_diagnostic_applicability_name(applicability: DiagnosticSuggestionApplicability) -> str {
  match applicability {
    DiagnosticSuggestionUnspecified -> "unspecified"
    DiagnosticSuggestionMachineApplicable -> "machine-applicable"
    DiagnosticSuggestionMaybeIncorrect -> "maybe-incorrect"
  }
}

fn main_diagnostic_field_json(
  root_src: i64,
  root_n: i64,
  tt: i64,
  field: DiagnosticField
) -> Json {
  match field {
    DiagnosticFieldText(name, value) -> main_diagnostic_named_field(
      "text",
      name,
      JsonString(value)
    )
    DiagnosticFieldI64(name, value) -> main_diagnostic_named_field("i64", name, JsonNumber(value))
    DiagnosticFieldU64(name, value) -> main_diagnostic_named_field(
      "u64",
      name,
      main_u64_json(value)
    )
    DiagnosticFieldBool(name, value) -> main_diagnostic_named_field("bool", name, JsonBool(value))
    DiagnosticFieldLocation(name, location) -> main_diagnostic_named_field(
      "location",
      name,
      main_diagnostic_location_json(root_src, root_n, tt, location)
    )
    DiagnosticFieldType(name, value) -> main_diagnostic_named_field(
      "type",
      name,
      semantic_json.encode_type(value)
    )
    DiagnosticFieldEffectAtom(name, value) -> main_diagnostic_named_field(
      "effect_atom",
      name,
      semantic_json.encode_effect_atom(value)
    )
    DiagnosticFieldEffectSet(name, value) -> main_diagnostic_named_field(
      "effect_set",
      name,
      semantic_json.encode_effect_set(value)
    )
    DiagnosticFieldSuggestion(DiagnosticSuggestion(message, applicability, edits)) -> {
      let suggestion = main_members()
        |> main_push("message", JsonString(message))
        |> main_push(
          "applicability",
          JsonString(main_diagnostic_applicability_name(applicability))
        )
        |> main_push("edits", main_diagnostic_edits_json(root_src, root_n, tt, edits))
        |> main_object
      main_members()
        |> main_push("kind", JsonString("suggestion"))
        |> main_push("value", suggestion)
        |> main_object
    }
    _ -> main_object(main_push(main_members(), "kind", JsonString("other")))
  }
}

fn main_diagnostic_named_field(kind: str, name: str, value: Json) -> Json {
  main_members()
    |> main_push("kind", JsonString(kind))
    |> main_push("name", JsonString(name))
    |> main_push("value", value)
    |> main_object
}

fn main_diagnostic_fields_json(
  root_src: i64,
  root_n: i64,
  tt: i64,
  fields: DiagnosticFieldList
) -> Json {
  let mut items = Nil<Json>()
  let mut current = fields
  loop {
    match current {
      DiagnosticFieldNil -> return JsonArray(items.reverse())
      DiagnosticFieldCons(field, rest) -> {
        items = Cons(main_diagnostic_field_json(root_src, root_n, tt, field), items)
        current = rest
      }
    }
  }
  JsonArray(items.reverse())
}

-- L8 wire projection shared by MCP items and LSP diagnostic data. The
-- producer-owned Diagnostic stays typed until here; fields are never
-- recovered from message text, and the v1 shape grows only additively.
fn main_diagnostic_json(root_src: i64, root_n: i64, tt: i64, diagnostic: Diagnostic) -> Json {
  match diagnostic {
    Diagnostic(severity, class, code, message, primary, related, fields) -> main_members()
      |> main_push("schema_version", JsonNumber(1))
      |> main_push("severity", JsonString(diagnostic_json.severity_name(severity)))
      |> main_push("class", JsonString(diagnostic_json.class_name(class)))
      |> main_push(
        "code",
        match code {
          DiagnosticCodeUnassigned -> JsonNull
          DiagnosticCodeAssigned(value) -> JsonString(value)
        }
      )
      |> main_push("message", JsonString(message))
      |> main_push("position_units", mcp_position_units())
      |> main_push("primary", main_diagnostic_location_json(root_src, root_n, tt, primary))
      |> main_push("related", main_diagnostic_related_json(root_src, root_n, tt, related))
      |> main_push("fields", main_diagnostic_fields_json(root_src, root_n, tt, fields))
      |> main_object
  }
}

-- An MCP diagnostic item's position members. Legacy diagnostics carry
-- absolute spans; they are reduced to offsets in their source first.
fn mcp_diag_item_members(
  src: i64,
  n: i64,
  severity: DiagnosticSeverity,
  message: str,
  absolute_span: i64,
  absolute_end: i64,
  code: DiagnosticCode
) -> List<JsonEntry> {
  let view = raw_source_view(src, n)
  let span = diagnose_normalize_span(src, absolute_span)
  let end_span = diagnose_normalize_span(src, absolute_end)
  let mut members = main_members()
    |> main_push("severity", JsonString(diagnostic_json.severity_name(severity)))
    |> main_push("message", JsonString(message))
  members = match code {
    DiagnosticCodeUnassigned -> members
    DiagnosticCodeAssigned(text) -> main_push(members, "code", JsonString(text))
  }
  members = members
    |> main_push("span", JsonNumber(span))
    |> main_push_position("", main_span_position(view, span))
  if end_span > span {
    members = members
      |> main_push("end_span", JsonNumber(end_span))
      |> main_push_position("end_", main_span_position(view, end_span))
  }
  members
}

fn mcp_diag_items_add_report(
  items: MainJsonItems,
  src: i64,
  n: i64,
  tt: i64,
  diagnostic: Diagnostic
) -> nil {
  let item = mcp_diag_item_members(
    src,
    n,
    diagnostic.severity(),
    diagnostic.message(),
    diagnose_report_absolute_span(diagnostic),
    diagnose_report_absolute_end(diagnostic),
    diagnostic.code()
  )
    |> main_push("diagnostic", main_diagnostic_json(src, n, tt, diagnostic))
    |> main_object
  main_json_items_add(items, item)
}

fn mcp_diag_items_add_legacy(
  items: MainJsonItems,
  src: i64,
  n: i64,
  severity: DiagnosticSeverity,
  message: str,
  span: i64
) -> nil {
  main_json_items_add(
    items,
    main_object(
      mcp_diag_item_members(src, n, severity, message, span, span, DiagnosticCodeUnassigned)
    )
  )
}

-- Collect every diagnostic `body` reports as an MCP item.
fn mcp_collect_diagnostics<T>(
  items: MainJsonItems,
  src: i64,
  n: i64,
  tt: i64,
  body: () -[Diagnose]> T
) -> T {
  handle body() {
    Diagnose.report(diagnostic) -> {
      mcp_diag_items_add_report(items, src, n, tt, diagnostic)
      resume(0)
    }
    Diagnose.error(msg, span) -> {
      mcp_diag_items_add_legacy(items, src, n, DiagnosticSeverityError, msg, span)
      resume(0)
    }
    Diagnose.warn(msg, span) -> {
      mcp_diag_items_add_legacy(items, src, n, DiagnosticSeverityWarning, msg, span)
      resume(0)
    }
    Diagnose.note(msg, span) -> {
      mcp_diag_items_add_legacy(items, src, n, DiagnosticSeverityNote, msg, span)
      resume(0)
    }
  }
}

fn mcp_diag_items_add_project(items: MainJsonItems, diagnostics: ProjectDiagnostics) -> nil {
  for i in 0..project_diagnostics_len(diagnostics) {
    let diagnostic = project_diagnostics_get(diagnostics, i)
    let src = project_diagnostics_item_source(diagnostics, i)
    let n = project_diagnostics_item_source_len(diagnostics, i)
    if project_diagnostics_item_is_legacy(diagnostics, i) {
      mcp_diag_items_add_legacy(
        items,
        src,
        n,
        diagnostic.severity(),
        diagnostic.message(),
        diagnose_report_absolute_span(diagnostic)
      )
    } else {
      mcp_diag_items_add_report(
        items,
        src,
        n,
        project_diagnostics_item_type_table(diagnostics, i),
        diagnostic
      )
    }
  }
  nil
}

-- Checking --------------------------------------------------------------
fn mcp_quiet<T>(body: () -[Diagnose]> T) -> T {
  handle body() {
    Diagnose.report(diagnostic) -> resume(0)
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
}

fn mcp_parse_source_quiet(source: str) -[SourceAcquire]> AstModule {
  handle pipeline_parse_source_with_diagnostics_and_origin(
    main_legacy_address(source),
    str_len(source),
    0,
    1
  ) {
    Diagnose.report(diagnostic) -> resume(0)
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
}

-- Register the other open documents as the sources their paths load. Paths
-- under the workspace are named relative to it, as imports spell them.
fn main_register_open_documents(
  tt: i64,
  documents: List<LspDocument>,
  root_uri: str,
  workspace: str
) -> SourceOwners {
  let mut owners = source_owners.new()
  let mut remaining = documents
  while not remaining.is_empty() {
    match remaining {
      Nil -> nil
      Cons(document, rest) -> {
        remaining = rest
        let path = lsp_document_path(document.uri, workspace, false)
        if str_len(path) > 0 and document.uri != root_uri {
          let request = SourceRequest { physical_path: path, logical_path: path, package_id: 0 }
          owners = source_owners.with_source(owners, request, source_from_text(document.text))
          ttable_register_source_text(tt, document.text, path)
          nil
        }
      }
    }
  }
  owners
}

-- The legacy table keeps a view of the root path; the checked product's
-- owners retain it.
fn main_prepare_checked_root(
  tt: i64,
  source: Source,
  path: str,
  documents: List<LspDocument>,
  root_uri: str,
  workspace: str
) -[SourceAcquire]> SourceOwners {
  let src = main_legacy_address(source.text)
  main_mark_root_origin_with_grant(tt, src, 0, 1, 0)
  main_register_source_path(
    tt,
    src,
    str_len(source.text),
    main_legacy_address(path),
    str_len(path)
  )
  source_owners.with_text(main_register_open_documents(tt, documents, root_uri, workspace), path)
}

fn mcp_check_source_inner(
  text: str,
  path: str,
  documents: List<LspDocument>,
  root_uri: str,
  workspace: str
) -[Diagnose, SourceAcquire]> TypedModule {
  let source = source_from_text(text)
  let probe_tt = ttable_new()
  let probe_owners = main_prepare_checked_root(
    probe_tt,
    source,
    path,
    documents,
    root_uri,
    workspace
  )
  let probe_parsed = pipeline_parse_with_source_owners(source, probe_tt, probe_owners)
  let (probe_fns, probe_loaded_owners, probe_declarations, probe_registrations) = match probe_parsed {
    PipelineParseResult(AstModule(fns, _, _, owners, (declarations, registrations)), _) -> (
      fns,
      owners,
      declarations,
      registrations
    )
  }
  let src = main_legacy_address(source.text)
  if test_prepare.count(probe_declarations) > 0 {
    let prefixed = test_prepare_source(source.text, test_prepare.count(probe_declarations))
    let prepared = source_from_text(test_prepare_source_content(prefixed))
    let test_src = main_legacy_address(prepared.text)
    let name_bank_start = test_prepare_source_wrapper_bank_start(prefixed)
    let tt = ttable_new()
    let overlay_owners = main_prepare_checked_root(
      tt,
      prepared,
      path,
      documents,
      root_uri,
      workspace
    )
    let parsed = pipeline_parse_with_source_owners(prepared, tt, overlay_owners)
    let (fns, parsed_owners, declarations, registrations) = match parsed {
      PipelineParseResult(AstModule(fns, _, _, owners, (declarations, registrations)), _) -> (
        fns,
        owners,
        declarations,
        registrations
      )
    }
    let wrapped = test_prepare.wrap(
      fns,
      declarations,
      test_src,
      name_bank_start,
      tt,
      registrations
    )
    let report = pipeline_check_report(
      AstModule(
        wrapped.functions,
        test_src,
        tt,
        parsed_owners,
        (declarations, wrapped.registrations)
      ),
      CheckProgram
    )
    -- Fact queries may inspect recovered state; this is not an accepted product.
    match report.result {
      Checked(typed) -> typed,
      CheckRejected -> TypedModule(
        wrapped.functions,
        test_src,
        tt,
        report.owners,
        wrapped.registrations
      )
    }
  } else {
    let report = pipeline_check_report(
      AstModule(
        probe_fns,
        src,
        probe_tt,
        probe_loaded_owners,
        (probe_declarations, probe_registrations)
      ),
      CheckProgram
    )
    match report.result {
      Checked(typed) -> typed,
      CheckRejected -> TypedModule(probe_fns, src, probe_tt, report.owners, probe_registrations)
    }
  }
}

-- Check a source outside the project session, keeping recovered state for
-- fact queries.
fn mcp_check_source_quiet_with(
  text: str,
  path: str,
  documents: List<LspDocument>,
  root_uri: str,
  workspace: str
) -[SourceAcquire]> TypedModule {
  handle mcp_check_source_inner(text, path, documents, root_uri, workspace) {
    Diagnose.report(diagnostic) -> resume(0)
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
}

fn mcp_check_source_quiet(text: str) -[SourceAcquire]> TypedModule {
  mcp_check_source_quiet_with(text, "", Nil<LspDocument>(), "", "")
}

fn mcp_project_context() -> ProjectQueryContext {
  project_query_context(0, "mcp://request.weft", "", project_source_origin_overlay(), 0, 1)
}

fn mcp_project_update_source(session: ProjectSession, source: str) -> ProjectQueryContext {
  let context = mcp_project_context()
  project_session_set_source(session, context, source)
  context
}

fn mcp_project_checked_source(session: ProjectSession, source: str) -[SourceAcquire]> TypedModule
{
  let context = mcp_project_update_source(session, source)
  match project_session_check_with_acquire(session, context) {
    ProjectCheckSucceeded(typed, source_n, parse_diagnostics, check_diagnostics) -> typed
    ProjectCheckFailed(typed, source_n, parse_diagnostics, check_diagnostics) -> typed
    -- Fact tools historically query the recovered typed module even when
    -- parsing failed. Preserve that behavior until recovery is a typed query.
    _ -> mcp_check_source_quiet(source)
  }
}

fn mcp_typed_module_tt(typed: TypedModule) -> i64 {
  match typed {
    TypedModule(fns, src, tt, owners, _) -> tt
  }
}

fn mcp_typed_module_src(typed: TypedModule) -> i64 {
  match typed {
    TypedModule(fns, src, tt, owners, _) -> src
  }
}

fn mcp_typed_module_registrations(typed: TypedModule) -> RegistrationScope {
  match typed {
    TypedModule(_, _, _, _, registrations) -> registrations
  }
}

-- Summaries -------------------------------------------------------------
fn mcp_parse_summary_from_ast(ast: AstModule) -> str {
  match ast {
    AstModule(fns, src, tt, owners, (declarations, _)) -> {
      let members = [
        jsonrpc_member("functions", JsonNumber(main_fns_source_count(fns, src))),
        jsonrpc_member("first_body_tag", JsonNumber(expr_tag(pipeline_ast_first_body_expr(ast))))
      ]
      mcp_result(McpParseSummary, main_in_order(members[..]))
    }
  }
}

fn mcp_parse_summary(session: ProjectSession, source: str) -[SourceAcquire]> str {
  let context = mcp_project_update_source(session, source)
  match project_session_parse_with_acquire(session, context) {
    ProjectParseSucceeded(ast, source_n, diagnostics) -> mcp_parse_summary_from_ast(ast)
    ProjectParseFailed(ast, source_n, diagnostics) -> mcp_parse_summary_from_ast(ast)
    -- Input was installed immediately above. These states signal an internal
    -- session invariant failure; preserve the historical tool result shape by
    -- falling back to an isolated parse rather than leaking cache machinery.
    _ -> mcp_parse_summary_from_ast(mcp_parse_source_quiet(source))
  }
}

fn mcp_check_summary_from_typed(typed: TypedModule) -> str {
  let members = [
    jsonrpc_member(
      "functions",
      JsonNumber(main_fns_source_count(pipeline_typed_fns(typed), mcp_typed_module_src(typed)))
    ),
    jsonrpc_member("first_body_tag", JsonNumber(expr_tag(pipeline_typed_first_body_expr(typed))))
  ]
  mcp_result(McpCheckSummary, main_in_order(members[..]))
}

fn mcp_check_summary(session: ProjectSession, source: str) -[SourceAcquire]> str {
  let context = mcp_project_update_source(session, source)
  match project_session_check_with_acquire(session, context) {
    ProjectCheckSucceeded(typed, source_n, parse_diagnostics, check_diagnostics) ->
      mcp_check_summary_from_typed(typed)
    ProjectCheckFailed(typed, source_n, parse_diagnostics, check_diagnostics) ->
      mcp_check_summary_from_typed(typed)
    -- Parse recovery and session invariant failures retain the historical
    -- isolated behavior until recovery itself is a typed cached product.
    _ -> mcp_check_summary_from_typed(mcp_check_source_quiet(source))
  }
}

fn mcp_ir_summary_result(result: CheckResult<TypedModule>) -> str {
  let (check_src, functions) = match result {
    Checked(typed) -> (
      mcp_typed_module_src(typed),
      pipeline_ir_functions(pipeline_lower_checked_with_weft(typed))
    )
    CheckRejected -> (0, ir_function_list_empty())
  }
  let members = [
    jsonrpc_member("functions", JsonNumber(ir_function_list_len_for_source(functions, check_src))),
    jsonrpc_member(
      "blocks",
      JsonNumber(ir_function_list_block_count_for_source(functions, check_src))
    ),
    jsonrpc_member(
      "insts",
      JsonNumber(ir_function_list_inst_count_for_source(functions, check_src))
    )
  ]
  mcp_result(McpIrSummary, main_in_order(members[..]))
}

--- A standalone checked program for an analysis tool: the submitted source,
--- wrapped as a test program when it declares tests.
type McpStandaloneProgram {
  McpStandaloneParsed(AstModule),
  McpStandaloneParseErrors
}

fn mcp_standalone_program(source: Source) -[SourceAcquire]> McpStandaloneProgram {
  let src = main_legacy_address(source.text)
  let probe_tt = ttable_new()
  main_mark_root_origin_with_grant(probe_tt, src, 0, 1, 0)
  let (probe_fns, probe_owners, probe_declarations, probe_registrations) = match pipeline_parse_with_error_count(
    source,
    probe_tt
  ) {
    PipelineParseResult(AstModule(fns, _, _, owners, (declarations, registrations)), 0) -> (
      fns,
      owners,
      declarations,
      registrations
    )
    _ -> return McpStandaloneParseErrors
  }
  if test_prepare.count(probe_declarations) == 0 {
    return McpStandaloneParsed(
      AstModule(
        probe_fns,
        src,
        probe_tt,
        probe_owners,
        (probe_declarations, probe_registrations)
      )
    )
  }
  let prefixed = test_prepare_source(source.text, test_prepare.count(probe_declarations))
  let prepared = source_from_text(test_prepare_source_content(prefixed))
  let check_src = main_legacy_address(prepared.text)
  let name_bank_start = test_prepare_source_wrapper_bank_start(prefixed)
  let check_tt = ttable_new()
  main_mark_root_origin_with_grant(check_tt, check_src, 0, 1, 0)
  match pipeline_parse_with_error_count(prepared, check_tt) {
    PipelineParseResult(AstModule(fns, _, _, owners, (declarations, registrations)), 0) -> {
      let wrapped = test_prepare.wrap(
        fns,
        declarations,
        check_src,
        name_bank_start,
        check_tt,
        registrations
      )
      McpStandaloneParsed(
        AstModule(
          wrapped.functions,
          check_src,
          check_tt,
          owners,
          (declarations, wrapped.registrations)
        )
      )
    }
    _ -> McpStandaloneParseErrors
  }
}

fn mcp_ir_summary_standalone(source: str) -[SourceAcquire]> str {
  match mcp_standalone_program(source_from_text(source)) {
    McpStandaloneParseErrors -> mcp_ir_summary_result(CheckRejected<TypedModule>())
    McpStandaloneParsed(program) -> {
      let checked = mcp_quiet(() => weft_check.report(CheckProgram, program))
      mcp_ir_summary_result(checked.result)
    }
  }
}

fn mcp_ir_summary(session: ProjectSession, source: str) -[SourceAcquire]> str {
  let context = mcp_project_update_source(session, source)
  match project_session_check_with_acquire(session, context) {
    ProjectCheckSucceeded(typed, source_n, parse_diagnostics, check_diagnostics) ->
      mcp_ir_summary_result(Checked(typed))
    ProjectCheckFailed(typed, source_n, parse_diagnostics, check_diagnostics) ->
      mcp_ir_summary_result(CheckRejected<TypedModule>())
    _ -> mcp_ir_summary_standalone(source)
  }
}

fn main_push_shape_census(
  members: List<JsonEntry>,
  native: NativeModule,
  shape: i64,
  loads0: str,
  loads1: str,
  defs2: str,
  load_sum: str
) -> List<JsonEntry> {
  members
    |> main_push(loads0, JsonNumber(pipeline_native_shape_census_count(native, 0, shape)))
    |> main_push(loads1, JsonNumber(pipeline_native_shape_census_count(native, 1, shape)))
    |> main_push(defs2, JsonNumber(pipeline_native_shape_census_count(native, 2, shape)))
    |> main_push(load_sum, JsonNumber(pipeline_native_shape_census_count(native, 3, shape)))
}

fn mcp_opt_counters_failure(reason: str) -> str {
  let members = [
    jsonrpc_member("tool", JsonString("opt_counters")),
    jsonrpc_member("ok", JsonBool(false)),
    jsonrpc_member("reason", JsonString(reason))
  ]
  jsonrpc_render(jsonrpc_object(members[..]))
}

-- The optimizer's per-pass site counters and the native emission counters
-- for one source (`sp_load`/`sp_store` are the native-memory decision
-- units): read-only plumbing over counters the passes already maintain.
fn mcp_opt_counters_result(native: NativeModule, optimised: IrModule) -> str {
  let mut members = main_members()
  members = members
    |> main_push("handler_inline_sites", JsonNumber(pipeline_ir_handler_inline_sites(optimised)))
    |> main_push(
      "handler_residual_sites",
      JsonNumber(pipeline_ir_handler_residual_sites(optimised))
    )
    |> main_push(
      "handler_evidence_candidate_sites",
      JsonNumber(pipeline_ir_handler_evidence_candidate_sites(optimised))
    )
    |> main_push("const_fold_sites", JsonNumber(pipeline_ir_const_fold_sites(optimised)))
    |> main_push("algebraic_fold_sites", JsonNumber(pipeline_ir_algebraic_fold_sites(optimised)))
    |> main_push("dead_inst_sites", JsonNumber(pipeline_ir_dead_inst_sites(optimised)))
    |> main_push("pure_call_dce_sites", JsonNumber(pipeline_ir_pure_call_dce_sites(optimised)))
    |> main_push(
      "match_final_arm_elision_sites",
      JsonNumber(pipeline_ir_match_final_arm_elision_sites(optimised))
    )
    |> main_push(
      "block_entry_narrowing_sites",
      JsonNumber(pipeline_ir_block_entry_narrowing_sites(optimised))
    )
    |> main_push(
      "direct_call_inline_sites",
      JsonNumber(pipeline_ir_direct_call_inline_sites(optimised))
    )
  members = members
    |> main_push("functions", JsonNumber(pipeline_native_function_count(native)))
    |> main_push("insts", JsonNumber(pipeline_native_inst_count(native)))
    |> main_push("sp_load", JsonNumber(pipeline_native_sp_load_count(native)))
    |> main_push("sp_store", JsonNumber(pipeline_native_sp_store_count(native)))
    |> main_push("sp_pair_load", JsonNumber(pipeline_native_sp_pair_load_count(native)))
    |> main_push("sp_pair_store", JsonNumber(pipeline_native_sp_pair_store_count(native)))
    |> main_push("sp_fp_pair_load", JsonNumber(pipeline_native_sp_fp_pair_load_count(native)))
    |> main_push("sp_fp_pair_store", JsonNumber(pipeline_native_sp_fp_pair_store_count(native)))
    |> main_push("rc_elision", JsonNumber(pipeline_native_rc_elision_count(native)))
    |> main_push(
      "rc_borrowable_param_facts",
      JsonNumber(pipeline_native_rc_borrowable_param_fact_count(native))
    )
  members = members
    |> main_push(
      "managed_drop_specializations",
      JsonNumber(pipeline_native_managed_drop_specialization_count(native))
    )
    |> main_push(
      "managed_reuse_candidates",
      JsonNumber(pipeline_native_managed_reuse_candidate_count(native))
    )
    |> main_push(
      "managed_reuse_lowerings",
      JsonNumber(pipeline_native_managed_reuse_lowering_count(native))
    )
    |> main_push("static_pair_slots", JsonNumber(pipeline_native_static_pair_slot_count(native)))
    |> main_push("static_pair_sites", JsonNumber(pipeline_native_static_pair_site_count(native)))
    |> main_push("alloc_elisions", JsonNumber(pipeline_native_alloc_elision_count(native)))
    |> main_push("fusions", JsonNumber(pipeline_native_fusion_count(native)))
    |> main_push(
      "indexed_bounds_elisions",
      JsonNumber(pipeline_native_indexed_bounds_elision_count(native))
    )
    |> main_push(
      "indexed_full_bounds_elisions",
      JsonNumber(pipeline_native_indexed_full_bounds_elision_count(native))
    )
    |> main_push(
      "vector_bounds_elisions",
      JsonNumber(pipeline_native_vector_bounds_elision_count(native))
    )
  members = members
    |> main_push(
      "vector_full_bounds_elisions",
      JsonNumber(pipeline_native_vector_full_bounds_elision_count(native))
    )
    |> main_push(
      "vector_scaled_addrs",
      JsonNumber(pipeline_native_vector_scaled_addr_count(native))
    )
    |> main_push(
      "vector_push_no_grows",
      JsonNumber(pipeline_native_vector_push_no_grow_count(native))
    )
    |> main_push("param_residents", JsonNumber(pipeline_native_ir_param_resident_count(native)))
    |> main_push(
      "volatile_residents",
      JsonNumber(pipeline_native_volatile_resident_count(native))
    )
    |> main_push(
      "call_window_residents",
      JsonNumber(pipeline_native_call_window_resident_count(native))
    )
    |> main_push(
      "low_pool_residents",
      JsonNumber(pipeline_native_low_pool_resident_count(native))
