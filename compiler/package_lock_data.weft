-- compiler/package_lock_data.weft -- shared deterministic lock schema
--
-- This module owns the semantic representation and strict parser used by
-- both import resolution and `weft pkg lock`. Filesystem traversal and
-- writing remain in package_lock.weft.

use compiler/lib.{*}
use compiler/product_identity.{weft_language_version, weft_lock_schema_version, weft_manifest_schema_version}
use runtime/alloc.{*}
use runtime/memory.{*}
use runtime/string.{*}
use stdlib/json.{*}
use stdlib/list.{*}
use stdlib/option.{*}
use stdlib/ord.{*}
use stdlib/string.{*}

-- Raw package-lock entry layout (8 words): name, version, source, content,
-- each as ptr/len. The compiler's graph tables use compact raw handles; this
-- keeps lock identities in that same stable representation.
pub(package) fn pkg_lock_copy_text(value: str) -> i64 {
  let copy = alloc_zeroed(__str_len(value))
  mem_copy(copy, __str_ptr(value), __str_len(value))
  copy
}

pub(package) fn pkg_lock_entry_new(name: str, version: str, source: str, content: str) -> i64 {
  let entry = alloc_words(8)
  mem_store64_at(entry, 0, pkg_lock_copy_text(name))
  mem_store64_at(entry, 8, __str_len(name))
  mem_store64_at(entry, 16, pkg_lock_copy_text(version))
  mem_store64_at(entry, 24, __str_len(version))
  mem_store64_at(entry, 32, pkg_lock_copy_text(source))
  mem_store64_at(entry, 40, __str_len(source))
  mem_store64_at(entry, 48, pkg_lock_copy_text(content))
  mem_store64_at(entry, 56, __str_len(content))
  entry
}

pub(package) fn pkg_lock_entry_name_ptr(entry: i64) -> i64 { mem_load64_at(entry, 0) }
pub(package) fn pkg_lock_entry_name_len(entry: i64) -> i64 { mem_load64_at(entry, 8) }
pub(package) fn pkg_lock_entry_version_ptr(entry: i64) -> i64 { mem_load64_at(entry, 16) }
pub(package) fn pkg_lock_entry_version_len(entry: i64) -> i64 { mem_load64_at(entry, 24) }
pub(package) fn pkg_lock_entry_source_ptr(entry: i64) -> i64 { mem_load64_at(entry, 32) }
pub(package) fn pkg_lock_entry_source_len(entry: i64) -> i64 { mem_load64_at(entry, 40) }
pub(package) fn pkg_lock_entry_content_ptr(entry: i64) -> i64 { mem_load64_at(entry, 48) }
pub(package) fn pkg_lock_entry_content_len(entry: i64) -> i64 { mem_load64_at(entry, 56) }

pub(package) fn pkg_lock_entry_name(entry: i64) -> str {
  runtime_str_from_bytes(pkg_lock_entry_name_ptr(entry), pkg_lock_entry_name_len(entry))
}

pub(package) fn pkg_lock_entry_version(entry: i64) -> str {
  runtime_str_from_bytes(pkg_lock_entry_version_ptr(entry), pkg_lock_entry_version_len(entry))
}

pub(package) fn pkg_lock_entry_source(entry: i64) -> str {
  runtime_str_from_bytes(pkg_lock_entry_source_ptr(entry), pkg_lock_entry_source_len(entry))
}

pub(package) fn pkg_lock_entry_content(entry: i64) -> str {
  runtime_str_from_bytes(pkg_lock_entry_content_ptr(entry), pkg_lock_entry_content_len(entry))
}

pub(package) fn pkg_lock_entry_compare(a: i64, b: i64) -> Ordering {
  pkg_lock_entry_name(a).compare(pkg_lock_entry_name(b))
}

pub(package) fn pkg_lock_entry_identity_equal(entry: i64, version: str, source: str, content: str) -> i64 {
  if str_eq(pkg_lock_entry_version(entry), version) == 1 and str_eq(pkg_lock_entry_source(entry), source) == 1 and str_eq(pkg_lock_entry_content(entry), content) == 1 { 1 } else { 0 }
}

-- Raw lock-data layout: parse status and an nlist of entry handles.
-- Status 0 = absent/unlocked, 1 = valid, -1 = malformed/unsupported.
pub(package) fn pkg_lock_data_new(status: i64) -> i64 {
  let data = alloc_words(2)
  mem_store64_at(data, 0, status)
  mem_store64_at(data, 8, nlist_new())
  data
}

pub(package) fn pkg_lock_data_absent() -> i64 { pkg_lock_data_new(0) }
pub(package) fn pkg_lock_data_status(data: i64) -> i64 { mem_load64_at(data, 0) }
pub(package) fn pkg_lock_data_entries(data: i64) -> i64 { mem_load64_at(data, 8) }
pub(package) fn pkg_lock_data_count(data: i64) -> i64 { nlist_len(pkg_lock_data_entries(data)) }
pub(package) fn pkg_lock_data_entry_at(data: i64, index: i64) -> i64 { nlist_get(pkg_lock_data_entries(data), index) }

pub(package) fn pkg_lock_data_find_name(data: i64, name_ptr: i64, name_len: i64) -> i64 {
  let entries = pkg_lock_data_entries(data)
  let mut i = 0
  let mut found = 0
  while i < nlist_len(entries) and found == 0 {
    let entry = nlist_get(entries, i)
    if name_len == pkg_lock_entry_name_len(entry) and src_eq_at(name_ptr, 0, pkg_lock_entry_name_ptr(entry), 0, name_len) == 1 {
      found = entry
    } else { i = i + 1 }
  }
  found
}

pub(package) fn pkg_lock_json_key_count(value: Json, wanted: str) -> i64 {
  let mut entries = json_object_entries(value)
  let mut count = 0
  let mut done = false
  while not done {
    match entries {
      Nil -> { done = true }
      Cons(entry, rest) -> {
        if str_eq(json_entry_key(entry), wanted) == 1 { count = count + 1 } else { 0 }
        entries = rest
      }
    }
  }
  count
}

pub(package) fn pkg_lock_root_key_allowed(key: str) -> i64 {
  if str_eq(key, "lock_version") == 1 or str_eq(key, "manifest_version") == 1 or str_eq(key, "weft") == 1 or str_eq(key, "packages") == 1 { 1 } else { 0 }
}

pub(package) fn pkg_lock_entry_key_allowed(key: str) -> i64 {
  if str_eq(key, "name") == 1 or str_eq(key, "version") == 1 or str_eq(key, "source") == 1 or str_eq(key, "content") == 1 { 1 } else { 0 }
}

pub(package) fn pkg_lock_object_keys_allowed(value: Json, entry_mode: i64) -> i64 {
  let mut entries = json_object_entries(value)
  let mut ok = 1
  let mut done = false
  while not done and ok == 1 {
    match entries {
      Nil -> { done = true }
      Cons(entry, rest) -> {
        let allowed = if entry_mode == 1 { pkg_lock_entry_key_allowed(json_entry_key(entry)) } else { pkg_lock_root_key_allowed(json_entry_key(entry)) }
        if allowed == 0 { ok = 0 } else { 0 }
        entries = rest
      }
    }
  }
  ok
}

pub(package) fn pkg_lock_name_valid(name: str) -> i64 {
  if str_len(name) <= 0 { 0 }
  else {
    let mut i = 0
    let mut ok = 1
    while i < str_len(name) {
      let ch = str_byte_at(name, i)
      if ch == 47 or ch == 92 or ch == 46 { ok = 0 } else { 0 }
      i = i + 1
    }
    ok
  }
}

pub(package) fn pkg_lock_version_valid(version: str) -> i64 {
  if str_len(version) <= 0 { 0 }
  else {
    let mut i = 0
    let mut ok = 1
    while i < str_len(version) {
      let ch = str_byte_at(version, i)
      let alpha = if ch >= 65 and ch <= 90 { 1 } else { if ch >= 97 and ch <= 122 { 1 } else { 0 } }
      let digit = if ch >= 48 and ch <= 57 { 1 } else { 0 }
      if alpha == 0 and digit == 0 and ch != 46 and ch != 43 and ch != 45 { ok = 0 } else { 0 }
      i = i + 1
    }
    ok
  }
}

pub(package) fn pkg_lock_source_path_valid(source: str) -> i64 {
  if str_eq(source, "path:.") == 1 { 1 }
  else { if str_starts_with(source, "path:") == 0 or str_len(source) <= 5 { 0 }
  else {
    let mut i = 5
    let mut segment_start = 5
    let mut ok = 1
    if str_byte_at(source, 5) == 47 or str_byte_at(source, 5) == 126 { ok = 0 } else { 0 }
    while i <= str_len(source) {
      if i == str_len(source) or str_byte_at(source, i) == 47 {
        let segment_len = i - segment_start
        if segment_len <= 0 { ok = 0 }
        else { if segment_len == 1 and str_byte_at(source, segment_start) == 46 { ok = 0 }
        else { if segment_len == 2 and str_byte_at(source, segment_start) == 46 and str_byte_at(source, segment_start + 1) == 46 { ok = 0 } else { 0 } } }
        segment_start = i + 1
      } else { 0 }
      i = i + 1
    }
    ok
  } }
}

pub(package) fn pkg_lock_https_url_valid_at(source: str, start: i64) -> i64 {
  let len = str_len(source) - start
  if len <= 8 or str_eq(str_slice_bytes(source, start, 8), "https://") == 0 { 0 }
  else {
    let mut index = start + 8
    let mut ok = 1
    while index < str_len(source) {
      let ch = str_byte_at(source, index)
      if ch < 33 or ch > 126 or ch == 35 or ch == 64 or ch == 92 { ok = 0 } else { 0 }
      index = index + 1
    }
    ok
  }
}

pub(package) fn pkg_lock_hex_at(source: str, start: i64, len: i64) -> i64 {
  let mut index = 0
  let mut ok = 1
  while index < len {
    let ch = str_byte_at(source, start + index)
    if (ch < 48 or ch > 57) and (ch < 97 or ch > 102) { ok = 0 } else { 0 }
    index = index + 1
  }
  ok
}

pub(package) fn pkg_lock_source_git_valid(source: str) -> i64 {
  if str_starts_with(source, "git:") == 0 { 0 }
  else {
    let separator = if str_len(source) > 45 and str_byte_at(source, 44) == 58 { 44 }
      else { if str_len(source) > 69 and str_byte_at(source, 68) == 58 { 68 } else { 0 } }
    if separator == 0 or pkg_lock_hex_at(source, 4, separator - 4) == 0 { 0 }
    else { pkg_lock_https_url_valid_at(source, separator + 1) }
  }
}

pub(package) fn pkg_lock_source_archive_valid(source: str) -> i64 {
  if str_len(source) <= 80 or str_starts_with(source, "archive:sha256:") == 0 or str_byte_at(source, 79) != 58 { 0 }
  else { if pkg_lock_hex_at(source, 15, 64) == 0 { 0 }
  else { pkg_lock_https_url_valid_at(source, 80) } }
}

pub(package) fn pkg_lock_source_valid(source: str) -> i64 {
  if pkg_lock_source_path_valid(source) == 1 { 1 }
  else { if pkg_lock_source_git_valid(source) == 1 { 1 }
  else { pkg_lock_source_archive_valid(source) } }
}

pub(package) fn pkg_lock_content_valid(content: str) -> i64 {
  if str_len(content) != 71 or str_starts_with(content, "sha256:") == 0 { 0 }
  else {
    let mut i = 7
    let mut ok = 1
    while i < 71 {
      let ch = str_byte_at(content, i)
      if (ch < 48 or ch > 57) and (ch < 97 or ch > 102) { ok = 0 } else { 0 }
      i = i + 1
    }
    ok
  }
}

pub(package) fn pkg_lock_parse_entry(value: Json) -> i64 {
  if json_kind(value) != 5 or json_object_len(value) != 4 or pkg_lock_object_keys_allowed(value, 1) == 0 { 0 }
  else { if pkg_lock_json_key_count(value, "name") != 1 or pkg_lock_json_key_count(value, "version") != 1 or pkg_lock_json_key_count(value, "source") != 1 or pkg_lock_json_key_count(value, "content") != 1 { 0 }
  else {
    let name_value = json_object_get(value, "name").unwrap_or(json_null())
    let version_value = json_object_get(value, "version").unwrap_or(json_null())
    let source_value = json_object_get(value, "source").unwrap_or(json_null())
    let content_value = json_object_get(value, "content").unwrap_or(json_null())
    if json_kind(name_value) != 3 or json_kind(version_value) != 3 or json_kind(source_value) != 3 or json_kind(content_value) != 3 { 0 }
    else {
      let name = json_string_value(name_value, "")
      let version = json_string_value(version_value, "")
      let source = json_string_value(source_value, "")
      let content = json_string_value(content_value, "")
      if pkg_lock_name_valid(name) == 0 or pkg_lock_version_valid(version) == 0 or pkg_lock_source_valid(source) == 0 or pkg_lock_content_valid(content) == 0 { 0 }
      else { pkg_lock_entry_new(name, version, source, content) }
    }
  } }
}

pub(package) fn pkg_lock_parse(source: str) -> i64 {
  let data = pkg_lock_data_new(0 - 1)
  match json_parse(source) {
    Err(JsonInvalidSyntax(offset)) -> data
    Ok(root) -> {
      if json_kind(root) != 5 or json_object_len(root) != 4 or pkg_lock_object_keys_allowed(root, 0) == 0 { data }
      else { if pkg_lock_json_key_count(root, "lock_version") != 1 or pkg_lock_json_key_count(root, "manifest_version") != 1 or pkg_lock_json_key_count(root, "weft") != 1 or pkg_lock_json_key_count(root, "packages") != 1 { data }
      else {
        let lock_version = json_object_get(root, "lock_version").unwrap_or(json_null())
        let manifest_version = json_object_get(root, "manifest_version").unwrap_or(json_null())
        let weft = json_object_get(root, "weft").unwrap_or(json_null())
        let packages = json_object_get(root, "packages").unwrap_or(json_null())
        if json_kind(lock_version) != 2 or json_number_value(lock_version, 0) != weft_lock_schema_version() or json_kind(manifest_version) != 2 or json_number_value(manifest_version, 0) != weft_manifest_schema_version() or json_kind(weft) != 3 or str_eq(json_string_value(weft, ""), weft_language_version()) == 0 or json_kind(packages) != 4 or json_array_len(packages) <= 0 { data }
        else {
          let mut items = json_array_items(packages)
          let mut ok = 1
          let mut done = false
          while not done and ok == 1 {
            match items {
              Nil -> { done = true }
              Cons(value, rest) -> {
                let entry = pkg_lock_parse_entry(value)
                if entry == 0 { ok = 0 }
                else {
                  let entries = pkg_lock_data_entries(data)
                  let count = nlist_len(entries)
                  if count > 0 {
                    match pkg_lock_entry_compare(nlist_get(entries, count - 1), entry) {
                      Less -> {
                        nlist_add(entries, entry)
                        nil
                      }
                      _ -> { ok = 0 }
                    }
                  } else {
                    nlist_add(entries, entry)
                  }
                }
                items = rest
              }
            }
          }
          if ok == 1 { mem_store64_at(data, 0, 1) } else { 0 }
          data
        }
      }
      }
    }
  }
}
