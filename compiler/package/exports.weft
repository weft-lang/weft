-- compiler/package/exports.weft -- package-qualified grammar/tool discovery.
--
-- Manifest metadata resolves back to ordinary module declaration facts. It
-- never creates another namespace and cannot widen declaration visibility.

use compiler/diagnostic/render.{*}
use compiler/storage.{*}
use compiler/project/identity.{
  DeclarationIdentity,
  DeclarationNamespace,
  NamedModuleIdentity,
  ModuleDeclarationIdentity,
  declaration_namespace_code,
  ValueDeclaration,
  TypeDeclaration,
  named_module_identity
}
use compiler/weft/check/registration/scope.{
  RegistrationScope,
  registration_scope_find,
  registration_scope_find_declaration,
  registration_scope_has_other_declaration
}
use compiler/package/manifest.{*}
use runtime/buffer.{*}
use runtime/memory.{mem_load64_at}
use runtime/string.{runtime_str_from_bytes_copy}
use stdlib/diagnostic.{*}
use stdlib/diagnostic/registry
use stdlib/diagnostic/schema.{*}

pub(package) fn package_export_status_pending() -> i64 { 0 }

pub(package) fn package_export_status_resolved() -> i64 { 1 }

pub(package) fn package_export_status_missing_declaration() -> i64 { 0 - 1 }

pub(package) fn package_export_status_wrong_kind() -> i64 { 0 - 2 }

pub(package) fn package_export_status_not_public() -> i64 { 0 - 3 }

pub(package) type PackageExportResolution {
  PackageExportPending,
  PackageExportResolved(DeclarationIdentity),
  PackageExportMissingDeclaration,
  PackageExportWrongKind,
  PackageExportNotPublic
}

pub(package) fn package_export_resolution_status(resolution: PackageExportResolution) -> i64 {
  match resolution {
    PackageExportPending -> package_export_status_pending()
    PackageExportResolved(_) -> package_export_status_resolved()
    PackageExportMissingDeclaration -> package_export_status_missing_declaration()
    PackageExportWrongKind -> package_export_status_wrong_kind()
    PackageExportNotPublic -> package_export_status_not_public()
  }
}

pub(package) fn package_export_expected_namespace(
  entry: i64
) -> DeclarationNamespace {
  if pkg_export_kind(entry) == pkg_export_kind_grammar() { TypeDeclaration }
  else { ValueDeclaration }
}

-- Resolution is lazy: only a module already selected into the package graph
-- is audited. A future build/run consumer can select an export module through
-- the same resolver, then call this exact fact producer.
pub(package) fn package_export_resolve_loaded(
  registrations: RegistrationScope,
  package_id: i64,
  entry: i64
) -> PackageExportResolution {
  let module = named_module_identity(
    pkg_str_view(pkg_export_module_ptr(entry), pkg_export_module_len(entry)),
    package_id
  )
  let resolution = match registration_scope_find(registrations, module) {
    None -> PackageExportPending()
    Some(_) -> {
      let expected = package_export_expected_namespace(entry)
      let declaration = pkg_str_view(
        pkg_export_declaration_ptr(entry),
        pkg_export_declaration_len(entry)
      )
      match registration_scope_find_declaration(
        registrations,
        module,
        expected,
        declaration
      ) {
        Some(registered) -> if match registered.visibility {
          PublicVisibility -> false
          _ -> true
        } {
          PackageExportNotPublic()
        } else { PackageExportResolved(registered.identity) }
        None -> if registration_scope_has_other_declaration(
          registrations,
          module,
          expected,
          declaration
        ) { PackageExportWrongKind() }
        else { PackageExportMissingDeclaration() }
      }
    }
  }
  pkg_export_set_audit_state(entry, package_export_resolution_status(resolution))
  resolution
}

--- Whether an already-audited export names this exact typed declaration.
---
--- Resolution and visibility remain owned by `package_export_resolve_loaded`.
--- Consumers which retain a declaration identity can join it back to manifest
--- metadata without reopening the raw checker table or repeating resolution.
pub(package) fn package_export_matches_declaration(
  package_id: i64,
  entry: i64,
  declaration: DeclarationIdentity
) -> bool {
  if pkg_export_audit_state(entry) != package_export_status_resolved() { return false }
  match declaration {
    ModuleDeclarationIdentity(NamedModuleIdentity(module, owner), namespace, name) ->
      owner == package_id and
      declaration_namespace_code(namespace) == declaration_namespace_code(
        package_export_expected_namespace(entry)
      ) and module == pkg_str_view(pkg_export_module_ptr(entry), pkg_export_module_len(entry)) and
      match name.text() {
        Some(spelling) -> spelling == pkg_str_view(
          pkg_export_declaration_ptr(entry),
          pkg_export_declaration_len(entry)
        )
        None -> false
      }
    _ -> false
  }
}

pub(package) fn package_export_kind_name(entry: i64) -> str {
  if pkg_export_kind(entry) == pkg_export_kind_grammar() { "grammar" } else { "tool" }
}

pub(package) fn package_export_problem(status: i64) -> str {
  if status == package_export_status_missing_declaration() {
    "does not name a declaration in its module"
  }
  else {
    if status == package_export_status_wrong_kind() { "names the wrong declaration kind" }
    else {
      if status == package_export_status_not_public() { "names a declaration that is not public" }
      else { "is invalid" }
    }
  }
}

pub(package) fn package_export_message(entry: i64, status: i64) -> str {
  let b = buf_new(
    pkg_export_name_len(entry) + pkg_export_module_len(entry) + pkg_export_declaration_len(entry) +
      96
  )
  bstr(b, "package ")
  bstr(b, package_export_kind_name(entry))
  bstr(b, " export '")
  bscopy(b, pkg_export_name_ptr(entry), pkg_export_name_len(entry), 0)
  bstr(b, "' ")
  bstr(b, package_export_problem(status))
  bstr(b, ": ")
  bscopy(b, pkg_export_module_ptr(entry), pkg_export_module_len(entry), 0)
  bstr(b, ".")
  bscopy(b, pkg_export_declaration_ptr(entry), pkg_export_declaration_len(entry), 0)
  runtime_str_from_bytes_copy(buf_ptr(b), buf_len(b))
}

pub(package) fn package_export_diagnose(identity: i64, entry: i64, status: i64) -[Diagnose]> i64 {
  if pkg_export_is_diagnosed(entry) == 1 { 0 }
  else {
    pkg_export_mark_diagnosed(entry)
    Diagnose.report(
      Diagnostic(
        DiagnosticSeverityError,
        DiagnosticClassLink,
        registry.package_export_invalid(),
        package_export_message(entry, status),
        DiagnosticLocationNone,
        DiagnosticRelatedLocationNil,
        DiagnosticFieldCons(
          DiagnosticFieldText(
            "package",
            pkg_str_view(pkg_identity_name_ptr(identity), pkg_identity_name_len(identity))
          ),
          DiagnosticFieldCons(
            DiagnosticFieldText("kind", package_export_kind_name(entry)),
            DiagnosticFieldCons(
              DiagnosticFieldText(
                "export",
                pkg_str_view(pkg_export_name_ptr(entry), pkg_export_name_len(entry))
              ),
              DiagnosticFieldCons(
                DiagnosticFieldText(
                  "module",
                  pkg_str_view(pkg_export_module_ptr(entry), pkg_export_module_len(entry))
                ),
                DiagnosticFieldCons(
                  DiagnosticFieldText(
                    "declaration",
                    pkg_str_view(
                      pkg_export_declaration_ptr(entry),
                      pkg_export_declaration_len(entry)
                    )
                  ),
                  DiagnosticFieldNil
                )
              )
            )
          )
        )
      )
    )
  }
}

pub(package) fn package_export_audit_loaded(
  tt: i64,
  registrations: RegistrationScope
) -[Diagnose]> i64 {
  let identities = pkg_identity_entries(tt)
  let mut errors = 0
  for i in 0..nlist_len(identities) {
    let identity = nlist_get(identities, i)
    let exports = pkg_manifest_exports(pkg_identity_manifest(identity))
    for j in 0..nlist_len(exports) {
      let entry = nlist_get(exports, j)
      let status = package_export_resolution_status(
        package_export_resolve_loaded(registrations, mem_load64_at(identity, 16), entry)
      )
      if status < 0 {
        package_export_diagnose(identity, entry, status)
        errors = errors + 1
      } else { 0 }
    }
  }
  errors
}
