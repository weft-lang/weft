-- The ABI kinds a manifest-declared native function crosses.
--
-- The manifest's JSON spelling and compact storage codes are boundary
-- encodings; checking, lowering and facts consume these variants.

pub(package) type NativeAbiType {
  NativeAbiNil,
  NativeAbiI8,
  NativeAbiU8,
  NativeAbiI16,
  NativeAbiU16,
  NativeAbiI32,
  NativeAbiU32,
  NativeAbiI64,
  NativeAbiU64,
  NativeAbiIsize,
  NativeAbiUsize,
  NativeAbiF32,
  NativeAbiF64,
  NativeAbiOpaquePointer,
  NativeAbiConstPointer,
  NativeAbiMutPointer,
  NativeAbiConstBytes,
  NativeAbiMutBytes
}
