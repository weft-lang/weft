-- compiler/module_product.weft -- instantiate immutable parsed module graphs.
--
-- A project parse table may contain products for many roots. It is never a
-- checker environment: this module copies exactly one root's import closure
-- into a fresh table, remapping every mutable module/declaration/function-pair
-- identity while retaining immutable source bytes, syntax, and package data.

use compiler/lib.{*}
use compiler/module.{*}
use compiler/package.{pkg_table_clone_resolution_state}
use compiler/parse.{mark_file_loaded}
use compiler/typeck.{*}
use compiler/type_registry.{*}
use runtime/alloc.{*}
use runtime/memory.{*}

pub(package) type ModuleParseInstance {
  ModuleParseInstance(i64, i64), -- root-local function pairs, fresh checker table
    InvalidModuleParseInstance
}

pub(package) type ModuleCheckedInstance {
  ModuleCheckedInstance(i64, i64), -- exact checked function pairs, fresh extensible table
    InvalidModuleCheckedInstance
}

pub(package) fn module_product_map_capacity(expected: i64) -> i64 {
  let mut capacity = 8
  while capacity < expected * 2 { capacity = capacity * 2 }
  capacity
}

-- Exact pointer remapping is a hot composition primitive. A linear old/new
-- pair list made a large dependency closure quadratic in its declaration
-- count; this zero-key open-addressed map retains full pointer equality while
-- making lookup and insertion constant-time at a maximum 50% load.
pub(package) fn module_product_map_new(expected: i64) -> i64 {
  let capacity = module_product_map_capacity(expected)
  node_new(0, capacity, alloc_zeroed(capacity * 16), 0, 0)
}

pub(package) fn module_product_map_index(map: i64, key: i64) -> i64 {
  ((key / 8) * 1000003) band (node_f1(map) - 1)
}

pub(package) fn module_product_map_put(map: i64, key: i64, value: i64) -> i64 {
  let capacity = node_f1(map)
  let entries = node_f2(map)
  let mut index = module_product_map_index(map, key)
  let mut done = 0
  while done == 0 {
    let old_key = mem_load64_at(entries, index * 16)
    if old_key == 0 or old_key == key {
      mem_store64_at(entries, index * 16, key)
      mem_store64_at(entries, index * 16 + 8, value)
      done = 1
    } else { index = (index + 1) band (capacity - 1) }
  }
  value
}

pub(package) fn module_product_map_find(map: i64, wanted: i64) -> i64 {
  if wanted == 0 { 0 }
  else {
    let capacity = node_f1(map)
    let entries = node_f2(map)
    let mut index = module_product_map_index(map, wanted)
    let mut result = 0
    let mut done = 0
    while done == 0 {
      let key = mem_load64_at(entries, index * 16)
      if key == 0 { done = 1 }
      else { if key == wanted {
          result = mem_load64_at(entries, index * 16 + 8)
          done = 1
        } else { index = (index + 1) band (capacity - 1) } }
    }
    result
  }
}

pub(package) fn module_product_collect_closure(source_tt: i64, module_entry: i64, selected: i64) -> i64 {
  if module_entry == 0 or module_entry_list_contains(selected, module_entry) == 1 { selected }
  else {
    nlist_add(selected, module_entry)
    for i in 0..module_fact_import_count(source_tt) {
      let import_entry = module_fact_import_at(source_tt, i)
      if module_import_fact_importer(import_entry) == module_entry {
        module_product_collect_closure(source_tt, module_import_fact_target(import_entry), selected)
      } else { 0 }
    }
    selected
  }
}

-- Collect the exact dependency forest below one root without selecting the
-- root itself. A scheduler can intersect or group these immutable identities,
-- then instantiate only a closure-closed forest into a checker universe.
pub(package) fn module_product_collect_dependencies(source_tt: i64, root_module: i64) -> i64 {
  let selected = nlist_new()
  if root_module != 0 {
    for i in 0..module_fact_import_count(source_tt) {
      let import_entry = module_fact_import_at(source_tt, i)
      if module_import_fact_importer(import_entry) == root_module {
        module_product_collect_closure(source_tt, module_import_fact_target(import_entry), selected)
      } else { 0 }
    }
  } else { 0 }
  selected
}

pub(package) fn module_product_selection_is_closed(source_tt: i64, selected: i64) -> i64 {
  let mut closed = 1
  let mut i = 0
  while i < module_fact_import_count(source_tt) and closed == 1 {
    let import_entry = module_fact_import_at(source_tt, i)
    if module_entry_list_contains(selected, module_import_fact_importer(import_entry)) == 1 and module_entry_list_contains(selected, module_import_fact_target(import_entry)) == 0 {
      closed = 0
    } else { i = i + 1 }
  }
  closed
}

-- Impl entries retain method/type payloads that can carry declaration-derived
-- native dispatch identity. The parsed-product copier remaps registries and
-- function pairs, but deliberately does not mutate the producer's shared AST
-- and type graphs. Until those payloads are deep-cloned and every embedded
-- DeclId is remapped, presenting such a product as a fresh checker universe
-- can check cleanly and later emit a missing-method trap. Checked products do
-- not need this fence because they preserve producer identities exactly.
pub(package) fn module_parse_product_selection_is_identity_complete(source_tt: i64, selected: i64) -> i64 {
  let mut complete = 1
  let mut i = 0
  while i < ttable_entry_count(source_tt) and complete == 1 {
    let entry = ttable_entry_at(source_tt, i)
    if module_product_selected_source(selected, ttable_entry_source(entry)) == 1 and ttable_entry_kind(entry) == 4 {
      complete = 0
    } else { i = i + 1 }
  }
  complete
}

pub(package) fn module_product_selected_source(selected: i64, src: i64) -> i64 {
  let mut i = 0
  let mut found = 0
  while i < nlist_len(selected) and found == 0 {
    if module_fact_entry_source(nlist_get(selected, i)) == src { found = 1 }
    else { i = i + 1 }
  }
  found
}

pub(package) fn module_product_clone_modules(source_tt: i64, dest_tt: i64, selected: i64, module_map: i64) -> i64 {
  for i in 0..nlist_len(selected) {
    let old_module = nlist_get(selected, i)
    let src = module_fact_entry_source(old_module)
    let source_entry = ttable_find_source_buffer_entry(source_tt, src)
    let source_len = if source_entry == 0 { 0 } else { mem_load64_at(source_entry + 8, 0) }
    let physical_ptr = if source_entry == 0 { 0 } else { mem_load64_at(source_entry + 16, 0) }
    let physical_len = if source_entry == 0 { 0 } else { mem_load64_at(source_entry + 24, 0) }
    let package_id = module_fact_entry_package(old_module)
    ttable_register_source_in_package(dest_tt, src, source_len, physical_ptr, physical_len, package_id)
    let new_module = module_fact_find_source(dest_tt, src)
    if module_fact_entry_anonymous(old_module) == 0 {
      module_fact_upgrade_named(new_module, module_fact_entry_path_ptr(old_module), module_fact_entry_path_len(old_module), package_id)
      mark_file_loaded(mem_load64_at(dest_tt, 24), module_fact_entry_path_ptr(old_module), 0, module_fact_entry_path_len(old_module), package_id)
    } else { 0 }
    ttable_copy_source_policy(source_tt, dest_tt, src)
    -- Handler declaration syntax is immutable and source-relative. Parsed
    -- products may share it exactly like function/type syntax; checking
    -- publishes a fresh resolved fact on the destination module entry.
    module_fact_set_handler_implementation(new_module, module_fact_entry_handler_implementation(old_module))
    let old_defaults = module_fact_entry_default_handlers(old_module)
    for default_index in 0..nlist_len(old_defaults) {
      module_fact_add_default_handler(new_module, nlist_get(old_defaults, default_index))
    }
    module_product_map_put(module_map, old_module, new_module)
  }
  dest_tt
}

pub(package) fn module_product_clone_types(source_tt: i64, dest_tt: i64, selected: i64) -> i64 {
  for i in 0..ttable_entry_count(source_tt) {
    let entry = ttable_entry_at(source_tt, i)
    if module_product_selected_source(selected, ttable_entry_source(entry)) == 1 {
      ttable_add(
        dest_tt,
        ttable_entry_source(entry),
        mem_load64_at(entry, 0),
        ttable_entry_name_len(entry),
        ttable_entry_kind(entry),
        ttable_entry_item_count(entry),
        ttable_entry_items(entry),
        ttable_entry_tparams(entry)
      )
    } else { 0 }
  }
  dest_tt
}

pub(package) fn module_product_clone_decl(source_tt: i64, dest_tt: i64, old_decl: i64, module_map: i64, decl_map: i64) -> i64 {
  let existing = module_product_map_find(decl_map, old_decl)
  if existing != 0 { existing }
  else {
    let old_module = module_decl_fact_module(old_decl)
    let new_module = module_product_map_find(module_map, old_module)
    if new_module == 0 { 0 }
    else {
      let old_owner = module_decl_fact_owner(old_decl)
      let new_owner = if old_owner == 0 { 0 }
      else { module_product_clone_decl(source_tt, dest_tt, old_owner, module_map, decl_map) }
      let src = module_fact_entry_source(old_module)
      let new_decl = module_decl_fact_register(
        dest_tt,
        src,
        new_owner,
        module_decl_fact_namespace(old_decl),
        module_decl_fact_name_ptr(old_decl) - src,
        module_decl_fact_name_len(old_decl),
        module_decl_fact_visibility_code(old_decl)
      )
      let old_constant = module_decl_fact_constant_fact(old_decl)
      if old_constant != 0 {
        module_decl_fact_bind_constant_fact(
          new_decl,
          node_new(
            0,
            module_constant_fact_declared_type(old_constant),
            module_constant_fact_initializer(old_constant),
            module_constant_fact_state(old_constant),
            module_constant_fact_value(old_constant)
          )
        )
      } else { 0 }
      module_product_map_put(decl_map, old_decl, new_decl)
      new_decl
    }
  }
}

pub(package) fn module_product_clone_declarations(source_tt: i64, dest_tt: i64, selected: i64, module_map: i64, decl_map: i64) -> i64 {
  for i in 0..module_fact_decl_count(source_tt) {
    let old_decl = module_fact_decl_at(source_tt, i)
    if module_entry_list_contains(selected, module_decl_fact_module(old_decl)) == 1 {
      module_product_clone_decl(source_tt, dest_tt, old_decl, module_map, decl_map)
    } else { 0 }
  }
  dest_tt
}

pub(package) fn module_product_clone_imports(source_tt: i64, dest_tt: i64, selected: i64, module_map: i64) -> i64 {
  for i in 0..module_fact_import_count(source_tt) {
    let old_import = module_fact_import_at(source_tt, i)
    let old_importer = module_import_fact_importer(old_import)
    let old_target = module_import_fact_target(old_import)
    if module_entry_list_contains(selected, old_importer) == 1 and module_entry_list_contains(selected, old_target) == 1 {
      module_import_fact_register_at(
        dest_tt,
        module_fact_entry_source(old_importer),
        module_product_map_find(module_map, old_target),
        mem_load64_at(old_import + 16, 0),
        module_import_fact_alias_ptr(old_import),
        module_import_fact_alias_len(old_import),
        module_import_fact_visibility_code(old_import),
        module_import_fact_is_weak(old_import),
        module_import_fact_source_offset(old_import)
      )
    } else { 0 }
  }
  dest_tt
}

pub(package) fn module_product_clone_pairs(source_tt: i64, dest_tt: i64, selected: i64, decl_map: i64, pair_map: i64) -> i64 {
  for i in 0..nlist_len(selected) {
    let old_module = nlist_get(selected, i)
    let pairs = module_fact_entry_function_pairs(old_module)
    for pair_index in 0..nlist_len(pairs) {
      let old_pair = nlist_get(pairs, pair_index)
      let new_decl = module_product_map_find(decl_map, node_tag(old_pair))
      if new_decl != 0 {
        let new_pair = node_new(new_decl, node_f1(old_pair), node_f2(old_pair), node_f3(old_pair), node_f4(old_pair))
        module_decl_fact_bind_function_pair(new_decl, new_pair)
        module_fact_cache_function_pair(dest_tt, module_fact_entry_source(old_module), new_pair)
        module_product_map_put(pair_map, old_pair, new_pair)
      } else { 0 }
    }
  }
  dest_tt
}

pub(package) fn module_product_root_pairs(root_fns: i64, pair_map: i64) -> i64 {
  let result = nlist_new_capacity(nlist_len(root_fns))
  for i in 0..nlist_len(root_fns) {
    let old_pair = nlist_get(root_fns, i)
    let new_pair = module_product_map_find(pair_map, old_pair)
    -- Test declarations have no declaration fact and remain immutable syntax
    -- pairs until the root-local harness creates ordinary wrapper functions.
    nlist_add(result, if new_pair == 0 { old_pair } else { new_pair })
  }
  result
}

pub(package) fn module_product_selected_pairs(source_fns: i64, selected: i64, pair_map: i64) -> i64 {
  let result = nlist_new_capacity(nlist_len(source_fns))
  for i in 0..nlist_len(source_fns) {
    let old_pair = nlist_get(source_fns, i)
    if module_product_selected_source(selected, node_f2(old_pair)) == 1 {
      let new_pair = module_product_map_find(pair_map, old_pair)
      if new_pair != 0 { nlist_add(result, new_pair) } else { 0 }
    } else { 0 }
  }
  result
}

pub(package) fn module_product_pair_count(selected: i64) -> i64 {
  let mut count = 0
  for i in 0..nlist_len(selected) {
    count = count + nlist_len(module_fact_entry_function_pairs(nlist_get(selected, i)))
  }
  count
}

pub(package) fn module_parse_product_instantiate(source_tt: i64, root_src: i64, root_fns: i64) -> ModuleParseInstance {
  let root_module = module_fact_find_source(source_tt, root_src)
  if root_module == 0 { InvalidModuleParseInstance }
  else {
    let selected = module_product_collect_closure(source_tt, root_module, nlist_new())
    if module_parse_product_selection_is_identity_complete(source_tt, selected) == 0 { InvalidModuleParseInstance }
    else {
      let dest_tt = ttable_new()
      pkg_table_clone_resolution_state(source_tt, dest_tt)
      let module_map = module_product_map_new(nlist_len(selected))
      module_product_clone_modules(source_tt, dest_tt, selected, module_map)
      module_product_clone_types(source_tt, dest_tt, selected)
      let decl_map = module_product_map_new(module_fact_decl_count(source_tt))
      module_product_clone_declarations(source_tt, dest_tt, selected, module_map, decl_map)
      module_product_clone_imports(source_tt, dest_tt, selected, module_map)
      let pair_map = module_product_map_new(module_product_pair_count(selected))
      module_product_clone_pairs(source_tt, dest_tt, selected, decl_map, pair_map)
      ModuleParseInstance(module_product_root_pairs(root_fns, pair_map), dest_tt)
    }
  }
}

pub(package) fn module_parse_product_instantiate_selected(source_tt: i64, selected: i64, source_fns: i64) -> ModuleParseInstance {
  if nlist_len(selected) == 0 or module_product_selection_is_closed(source_tt, selected) == 0 or module_parse_product_selection_is_identity_complete(source_tt, selected) == 0 { InvalidModuleParseInstance }
  else {
    let dest_tt = ttable_new()
    pkg_table_clone_resolution_state(source_tt, dest_tt)
    let module_map = module_product_map_new(nlist_len(selected))
    module_product_clone_modules(source_tt, dest_tt, selected, module_map)
    module_product_clone_types(source_tt, dest_tt, selected)
    let decl_map = module_product_map_new(module_fact_decl_count(source_tt))
    module_product_clone_declarations(source_tt, dest_tt, selected, module_map, decl_map)
    module_product_clone_imports(source_tt, dest_tt, selected, module_map)
    let pair_map = module_product_map_new(module_product_pair_count(selected))
    module_product_clone_pairs(source_tt, dest_tt, selected, decl_map, pair_map)
    ModuleParseInstance(module_product_selected_pairs(source_fns, selected, pair_map), dest_tt)
  }
}

-- Checked products retain producer-owned ModuleId/DeclId identity. Typed
-- bodies, resolved types, lexical environments, and semantic facts may all
-- carry those exact pointers, so remapping after checking would require an
-- unsound second semantic traversal. The entries themselves are immutable at
-- this boundary; destination-owned lists, indices, and function catalog cells
-- make the resulting table independently extensible.
pub(package) fn module_checked_product_is_complete(source_tt: i64, selected: i64) -> i64 {
  let mut complete = if ttable_get_checked_functions(source_tt) == 0 { 0 } else { 1 }
  let mut i = 0
  while i < nlist_len(selected) and complete == 1 {
    let module_entry = nlist_get(selected, i)
    if ttable_module_source_is_checked(source_tt, module_fact_entry_source(module_entry)) == 0 {
      complete = 0
    } else { i = i + 1 }
  }
  complete
}

pub(package) fn module_checked_product_share_modules(source_tt: i64, dest_tt: i64, selected: i64) -> i64 {
  for i in 0..nlist_len(selected) {
    let module_entry = nlist_get(selected, i)
    -- Install the exact immutable identity before source registration so the
    -- registry observes it instead of minting a replacement ModuleId.
    nlist_add(module_fact_modules(dest_tt), module_entry)
    let src = module_fact_entry_source(module_entry)
    let source_entry = ttable_find_source_buffer_entry(source_tt, src)
    let source_len = if source_entry == 0 { 0 } else { mem_load64_at(source_entry + 8, 0) }
    let physical_ptr = if source_entry == 0 { 0 } else { mem_load64_at(source_entry + 16, 0) }
    let physical_len = if source_entry == 0 { 0 } else { mem_load64_at(source_entry + 24, 0) }
    let package_id = module_fact_entry_package(module_entry)
    ttable_register_source_in_package(dest_tt, src, source_len, physical_ptr, physical_len, package_id)
    if module_fact_entry_anonymous(module_entry) == 0 {
      mark_file_loaded(mem_load64_at(dest_tt, 24), module_fact_entry_path_ptr(module_entry), 0, module_fact_entry_path_len(module_entry), package_id)
    } else { 0 }
    ttable_copy_source_policy(source_tt, dest_tt, src)
  }
  dest_tt
}

pub(package) fn module_checked_product_share_declarations(source_tt: i64, dest_tt: i64, selected: i64) -> i64 {
  let dest_decls = module_fact_decls(dest_tt)
  for i in 0..module_fact_decl_count(source_tt) {
    let declaration = module_fact_decl_at(source_tt, i)
    let module_entry = module_decl_fact_module(declaration)
    if module_entry_list_contains(selected, module_entry) == 1 {
      nlist_add(dest_decls, declaration)
      let namespace = module_decl_fact_namespace(declaration)
      let name_ptr = module_decl_fact_name_ptr(declaration)
      let name_len = module_decl_fact_name_len(declaration)
      let owner = module_decl_fact_owner(declaration)
      module_fact_index_add(dest_decls, module_decl_fact_lookup_key(module_entry, 0, namespace, name_ptr, name_len), declaration)
      if owner != 0 {
        module_fact_index_add(dest_decls, module_decl_fact_lookup_key(0, owner, namespace, name_ptr, name_len), declaration)
      } else { 0 }
    } else { 0 }
  }
  dest_tt
}

pub(package) fn module_checked_product_share_imports(source_tt: i64, dest_tt: i64, selected: i64) -> i64 {
  let dest_imports = module_fact_imports(dest_tt)
  for i in 0..module_fact_import_count(source_tt) {
    let import_entry = module_fact_import_at(source_tt, i)
    if module_entry_list_contains(selected, module_import_fact_importer(import_entry)) == 1 and module_entry_list_contains(selected, module_import_fact_target(import_entry)) == 1 {
      nlist_add(dest_imports, import_entry)
    } else { 0 }
  }
  dest_tt
}

pub(package) fn module_checked_product_share_scopes(source_tt: i64, dest_tt: i64, selected: i64) -> i64 {
  let dest_scopes = module_fact_scopes(dest_tt)
  for i in 0..module_fact_scope_count(source_tt) {
    let scope_entry = module_fact_scope_at(source_tt, i)
    if module_entry_list_contains(selected, module_scope_entry_module(scope_entry)) == 1 {
      nlist_add(dest_scopes, scope_entry)
      if module_scope_entry_kind(scope_entry) != module_scope_kind_issue() {
        module_fact_index_add(dest_scopes, module_scope_lookup_key(module_scope_entry_module(scope_entry), module_scope_entry_name_ptr(scope_entry), module_scope_entry_name_len(scope_entry)), scope_entry)
      } else { 0 }
    } else { 0 }
  }
  dest_tt
}

pub(package) fn module_checked_product_clone_function_catalog(source_tt: i64, dest_tt: i64, selected: i64) -> i64 {
  let source_ft = ttable_get_checked_functions(source_tt)
  let dest_ft = ftypes_new_with_ttable(dest_tt)
  for i in 0..nlist_len(source_ft) {
    let entry = nlist_get(source_ft, i)
    if module_product_selected_source(selected, ftypes_entry_source(entry)) == 1 {
      let cloned = ftypes_add(
        dest_ft,
        ftypes_entry_source(entry),
        ftypes_entry_name_start(entry),
        ftypes_entry_name_len(entry),
        ftypes_entry_return_type(entry),
        ftypes_entry_params(entry),
        ftypes_entry_effects(entry),
        ftypes_entry_tparams(entry)
      )
      ftypes_set_body_entry(cloned, mem_load64_at(entry + 56, 0))
      mem_store64_at(cloned + 72, 0, mem_load64_at(entry + 72, 0))
      mem_store64_at(cloned + 80, 0, ftypes_entry_decl_fact(entry))
    } else { 0 }
  }
  ttable_set_checked_functions(dest_tt, dest_ft)
  dest_ft
}

pub(package) fn module_checked_product_share_semantic_facts(source_tt: i64, dest_tt: i64, selected: i64) -> i64 {
  let source_facts = ttable_semantic_symbol_facts(source_tt)
  let dest_facts = ttable_semantic_symbol_facts(dest_tt)
  for i in 0..nlist_len(source_facts) {
    let fact = nlist_get(source_facts, i)
    if module_product_selected_source(selected, semantic_symbol_fact_use_source(fact)) == 1 {
      nlist_add(dest_facts, fact)
    } else { 0 }
  }
  dest_tt
}

pub(package) fn module_checked_product_pairs(root_fns: i64, selected: i64, source_tt: i64) -> i64 {
  let result = nlist_new_capacity(nlist_len(root_fns))
  for i in 0..nlist_len(root_fns) {
    let pair = nlist_get(root_fns, i)
    if module_product_selected_source(selected, node_f2(pair)) == 1 and ttable_function_pair_is_checked(source_tt, pair) == 1 {
      nlist_add(result, pair)
    } else { 0 }
  }
  result
}

pub(package) fn module_checked_product_instantiate(source_tt: i64, root_src: i64, root_fns: i64) -> ModuleCheckedInstance {
  let root_module = module_fact_find_source(source_tt, root_src)
  if root_module == 0 { InvalidModuleCheckedInstance }
  else {
    let selected = module_product_collect_closure(source_tt, root_module, nlist_new())
    if module_checked_product_is_complete(source_tt, selected) == 0 { InvalidModuleCheckedInstance }
    else {
      let dest_tt = ttable_new()
      pkg_table_clone_resolution_state(source_tt, dest_tt)
      module_checked_product_share_modules(source_tt, dest_tt, selected)
      module_product_clone_types(source_tt, dest_tt, selected)
      module_checked_product_share_declarations(source_tt, dest_tt, selected)
      module_checked_product_share_imports(source_tt, dest_tt, selected)
      module_checked_product_share_scopes(source_tt, dest_tt, selected)
      module_checked_product_clone_function_catalog(source_tt, dest_tt, selected)
      module_checked_product_share_semantic_facts(source_tt, dest_tt, selected)
      let fns = module_checked_product_pairs(root_fns, selected, source_tt)
      ttable_mark_checked_module_products(dest_tt, fns)
      ModuleCheckedInstance(fns, dest_tt)
    }
  }
}

pub(package) fn module_checked_product_instantiate_selected(source_tt: i64, selected: i64, source_fns: i64) -> ModuleCheckedInstance {
  if nlist_len(selected) == 0 or module_product_selection_is_closed(source_tt, selected) == 0 or module_checked_product_is_complete(source_tt, selected) == 0 {
    InvalidModuleCheckedInstance
  } else {
    let dest_tt = ttable_new()
    pkg_table_clone_resolution_state(source_tt, dest_tt)
    module_checked_product_share_modules(source_tt, dest_tt, selected)
    module_product_clone_types(source_tt, dest_tt, selected)
    module_checked_product_share_declarations(source_tt, dest_tt, selected)
    module_checked_product_share_imports(source_tt, dest_tt, selected)
    module_checked_product_share_scopes(source_tt, dest_tt, selected)
    module_checked_product_clone_function_catalog(source_tt, dest_tt, selected)
    module_checked_product_share_semantic_facts(source_tt, dest_tt, selected)
    let fns = module_checked_product_pairs(source_fns, selected, source_tt)
    ttable_mark_checked_module_products(dest_tt, fns)
    ModuleCheckedInstance(fns, dest_tt)
  }
}
