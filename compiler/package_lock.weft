-- compiler/package_lock.weft -- deterministic local package graph locking

use compiler/lib.{*}
use compiler/package.{*}
use compiler/package_lock_data.{*}
use compiler/package_source.{PackageProviderFailed, PackageProviderFailure, PackageProviderRejected, PackageProviderResult, PackageProviderSucceeded, PackageProviderUnavailable, PackageSourceAcquire, PackageSourceStageReady, PackageSourceStageUnavailable, package_source_claim_stage, package_source_ensure_directory, package_source_extract_archive, package_source_maximum_archive_bytes, package_source_remove_tree}
use compiler/product_identity.{weft_language_version, weft_lock_schema_version, weft_manifest_schema_version}
use compiler/sha256.{sha256}
use runtime/alloc.{*}
use runtime/buffer.{*}
use runtime/memory.{*}
use runtime/string.{runtime_str_from_bytes_copy}
use stdlib/bytes as bytes
use stdlib/bytes.{Bytes}
use stdlib/dir as dir
use stdlib/dir.{DirDirectory, DirFile, DirInspect, DirMetadata, DirMutate, DirOther}
use stdlib/file as file
use stdlib/file.{FileRead, FileWrite}
use stdlib/json.{*}
use stdlib/list.{*}
use stdlib/option.{*}
use stdlib/ord.{*}
use stdlib/path.{Path}
use stdlib/result.{*}
use stdlib/string.{*}
use stdlib/vector.{*}

pub(package) type PackageContentEntry {
  PackageContentEntry(str, Vector<u8>)
}

pub(package) type PackageCacheVerification {
  PackageCacheVerified,
  PackageCacheLockMalformed,
  PackageCacheMissing(str, str),
  PackageCacheCorrupt(str, str)
}

pub(package) type PackageRemoteSourceParse {
  PackageRemoteSourceParsed(PackageDependencySource),
  PackageRemoteSourceInvalid
}

pub(package) type PackageRemoteAcquisition {
  PackageRemoteAcquired(str, str, str),
  PackageRemoteProviderFailed(PackageProviderFailure),
  PackageRemoteRejected(str)
}

pub(package) type PackageLockCollection {
  PackageLockCollected,
  PackageLockManifestInvalid,
  PackageLockNameMismatch,
  PackageLockIdentityConflict,
  PackageLockCycle,
  PackageLockTraversalFailed,
  PackageLockAcquisitionFailed(PackageRemoteAcquisition)
}

pub(package) type PackageLockNotice {
  PackageLockAnnounce,
  PackageLockQuiet
}

pub(package) fn pkg_content_entry(path: str, content: str) -> PackageContentEntry {
  PackageContentEntry(path, bytes.from_str(content).to_vector())
}

pub(package) fn pkg_content_entry_bytes(path: str, content: Bytes) -> PackageContentEntry {
  PackageContentEntry(path, content.to_vector())
}

pub(package) fn pkg_content_entry_path(entry: PackageContentEntry) -> str {
  match entry { PackageContentEntry(path, content) -> path }
}

pub(package) fn pkg_content_entry_compare(a: PackageContentEntry, b: PackageContentEntry) -> Ordering {
  ord_compare<str>(pkg_content_entry_path(a), pkg_content_entry_path(b))
}

pub(package) fn pkg_lock_hex_digit(value: i64) -> i64 {
  if value < 10 { 48 + value } else { 87 + value }
}

pub(package) fn pkg_lock_digest_hex(raw: i64) -> str {
  let b = buf_new(71)
  bstr(b, "sha256:")
  for i in 0..32 {
    let byte = mem_load8_at(raw, i)
    bu8(b, pkg_lock_hex_digit(byte / 16))
    bu8(b, pkg_lock_hex_digit(byte - byte / 16 * 16))
  }
  runtime_str_from_bytes_copy(buf_ptr(b), buf_len(b))
}

pub(package) fn pkg_content_digest(entries: Vector<PackageContentEntry>) -> str {
  vector_sort_by<PackageContentEntry>(entries, pkg_content_entry_compare)
  let bytes = buf_new(4096)
  bstr(bytes, "weft-package-content-v1")
  bu8(bytes, 0)
  for i in 0..vector_len<PackageContentEntry>(entries) {
    match vector_get_in_bounds<PackageContentEntry>(entries, i) {
      PackageContentEntry(path, content) -> {
        bu64(bytes, str_len(path))
        bscopy(bytes, __str_ptr(path), str_len(path), 0)
        bu64(bytes, vector_len<u8>(content))
        bscopy(bytes, vector_data<u8>(content), vector_len<u8>(content), 0)
      }
    }
  }
  let out = alloc_zeroed(32)
  sha256(buf_ptr(bytes), buf_len(bytes), out)
  pkg_lock_digest_hex(out)
}

pub(package) fn pkg_lock_join_path(root: str, rel: str) -> str {
  if str_len(rel) == 0 { root }
  else { if str_len(root) == 0 or str_eq(root, ".") == 1 { rel }
  else { if str_ends_with(root, "/") == 1 { str_concat(root, rel) }
  else { str_concat(root, str_concat("/", rel)) } } }
}

pub(package) fn pkg_lock_join_rel(parent: str, name: str) -> str {
  if str_len(parent) == 0 { name } else { str_concat(parent, str_concat("/", name)) }
}

pub(package) fn pkg_lock_directory_identity_add(identities: Vector<i64>, metadata: DirMetadata) -> i64 {
  let mut i = 0
  let mut duplicate = false
  while i < vector_len<i64>(identities) and duplicate == false {
    if vector_get_in_bounds<i64>(identities, i) == metadata.device and vector_get_in_bounds<i64>(identities, i + 1) == metadata.inode {
      duplicate = true
    } else { i = i + 2 }
  }
  if duplicate { 0 }
  else {
    vector_push<i64>(identities, metadata.device)
    vector_push<i64>(identities, metadata.inode)
    1
  }
}

pub(package) fn pkg_lock_rel_is_dependency_tree(manifest: i64, rel: str) -> i64 {
  let deps = pkg_manifest_deps(manifest)
  let mut i = 0
  let mut found = 0
  while i < nlist_len(deps) and found == 0 {
    let dep = nlist_get(deps, i)
    match pkg_dep_source(dep) {
      PackagePathSource(dep_path) -> if str_eq(rel, dep_path) == 1 { found = 1 }
        else {
          let prefix = str_concat(dep_path, "/")
          if str_starts_with(rel, prefix) == 1 { found = 1 } else { i = i + 1 }
        }
      _ -> { i = i + 1 }
    }
  }
  found
}

pub(package) fn pkg_lock_should_skip_dir(name: str) -> i64 {
  if str_eq(name, ".git") == 1 or str_eq(name, ".weft") == 1 { 1 } else { 0 }
}

pub(package) fn pkg_lock_collect_source_entries_with_policy(root: str, manifest: i64, out: Vector<PackageContentEntry>, strict_cache: bool) -[DirInspect, FileRead]> i64 {
  let pending = vector_new<str>()
  let identities = vector_new<i64>()
  vector_push<str>(pending, "")
  match dir.metadata(pkg_safe_path(root)) {
    Err(error) -> 1
    Ok(root_metadata) -> {
      if root_metadata.exists == false or not root_metadata.kind.eq(DirDirectory) { 2 }
      else {
        pkg_lock_directory_identity_add(identities, root_metadata)
        let mut index = 0
        let mut failure = 0
        while index < vector_len<str>(pending) and failure == 0 {
          let rel_dir = vector_get_in_bounds<str>(pending, index)
          let directory = pkg_lock_join_path(root, rel_dir)
          match dir.list(pkg_safe_path(directory)) {
            Err(error) -> {
              failure = 1
              0
            }
            Ok(path_entries) -> {
              let entries = vector_new<str>()
              let mut entry_index = 0
              while entry_index < vector_len<Path>(path_entries) and failure == 0 {
                match vector_get_in_bounds<Path>(path_entries, entry_index).to_utf8() {
                  Err(error) -> { failure = 1 0 }
                  Ok(name) -> { vector_push<str>(entries, name) 0 }
                }
                entry_index = entry_index + 1
              }
              vector_sort<str>(entries)
              let mut i = 0
              while i < vector_len<str>(entries) and failure == 0 {
                let name = vector_get_in_bounds<str>(entries, i)
                let rel = pkg_lock_join_rel(rel_dir, name)
                if (strict_cache or pkg_lock_rel_is_dependency_tree(manifest, rel) == 0) and (strict_cache == false or str_len(rel) <= 4096) {
                  let path = pkg_lock_join_path(root, rel)
                  match dir.symlink_metadata(pkg_safe_path(path)) {
                    Err(error) -> {
                      failure = 1
                      0
                    }
                    Ok(metadata) -> {
                      if metadata.exists and metadata.kind.eq(DirDirectory) and pkg_lock_should_skip_dir(name) == 0 {
                        if vector_len<str>(pending) >= 100000 { failure = 1 }
                        else { if pkg_lock_directory_identity_add(identities, metadata) == 1 { vector_push<str>(pending, rel) }
                        else { if strict_cache { failure = 1 } else { 0 } } }
                      } else { if metadata.exists and metadata.kind.eq(DirFile) and (strict_cache or str_eq(rel, "weft.pkg") == 1 or str_ends_with(rel, ".weft") == 1) {
                        if vector_len<PackageContentEntry>(out) >= 100000 or (strict_cache and pkg_lock_directory_identity_add(identities, metadata) == 0) { failure = 1 }
                        else { match file.read_all(pkg_safe_path(path), pkg_safe_read_limit()) {
                          Err(error) -> { failure = 1 0 }
                          Ok(content) -> { vector_push<PackageContentEntry>(out, pkg_content_entry_bytes(rel, content)) 0 }
                        } }
                      } else { if metadata.exists and metadata.kind.eq(DirDirectory) and pkg_lock_should_skip_dir(name) == 1 and strict_cache {
                        failure = 1
                      } else { if strict_cache and (metadata.exists == false or metadata.kind.eq(DirOther)) { failure = 1 } else { 0 } } } }
                      0
                    }
                  }
                } else { if strict_cache { failure = 1 } else { 0 } }
                i = i + 1
              }
              vector_sort<str>(pending)
              0
            }
          }
          index = index + 1
        }
        failure
      }
    }
  }
}

pub(package) fn pkg_lock_collect_source_entries(root: str, manifest: i64, out: Vector<PackageContentEntry>) -[DirInspect, FileRead]> i64 {
  pkg_lock_collect_source_entries_with_policy(root, manifest, out, false)
}

pub(package) fn pkg_lock_collect_cached_source_entries(root: str, manifest: i64, out: Vector<PackageContentEntry>) -[DirInspect, FileRead]> i64 {
  pkg_lock_collect_source_entries_with_policy(root, manifest, out, true)
}

pub(package) fn pkg_lock_entry_find(entries: Vector<i64>, name: str) -> i64 {
  let mut i = 0
  let mut found = 0 - 1
  while i < vector_len<i64>(entries) and found < 0 {
    if str_eq(pkg_lock_entry_name(vector_get_in_bounds<i64>(entries, i)), name) == 1 { found = i }
    else { i = i + 1 }
  }
  found
}

pub(package) fn pkg_lock_remote_source_parse(source: str) -> PackageRemoteSourceParse {
  if pkg_lock_source_git_valid(source) == 1 {
    let separator = if str_byte_at(source, 44) == 58 { 44 } else { 68 }
    PackageRemoteSourceParsed(PackageGitSource(
      str_slice_bytes(source, separator + 1, str_len(source) - separator - 1),
      str_slice_bytes(source, 4, separator - 4)
    ))
  } else { if pkg_lock_source_archive_valid(source) == 1 {
    PackageRemoteSourceParsed(PackageArchiveSource(
      str_slice_bytes(source, 80, str_len(source) - 80),
      str_slice_bytes(source, 8, 71)
    ))
  } else { PackageRemoteSourceInvalid } }
}

pub(package) fn pkg_cache_root_matches(root: str, name: str, version: str, content: str) -[DirInspect, FileRead]> bool {
  match dir.symlink_metadata(pkg_safe_path(root)) {
    Err(error) -> false
    Ok(metadata) -> if metadata.exists == false or not metadata.kind.eq(DirDirectory) {
      false
    } else {
      let manifest = pkg_safe_manifest_load_at_root(root)
      if pkg_manifest_error_count(manifest) > 0 or pkg_manifest_package_eq(manifest, name) == 0 or pkg_manifest_weft_eq(manifest, weft_language_version()) == 0 or (str_len(version) > 0 and pkg_manifest_version_eq(manifest, version) == 0) {
        false
      } else {
        let files = vector_new<PackageContentEntry>()
        pkg_lock_collect_cached_source_entries(root, manifest, files) == 0 and str_eq(pkg_content_digest(files), content) == 1
      }
    }
  }
}

pub(package) fn pkg_remote_tree_identity(root: str, expected_name: str) -[DirInspect, FileRead]> PackageRemoteAcquisition {
  let manifest = pkg_safe_manifest_load_at_root(root)
  if pkg_manifest_error_count(manifest) > 0 or pkg_manifest_package_len(manifest) <= 0 or pkg_manifest_schema_version(manifest) != weft_manifest_schema_version() or pkg_manifest_weft_eq(manifest, weft_language_version()) == 0 {
    PackageRemoteRejected("remote source has a malformed or incompatible weft.pkg")
  } else { if pkg_manifest_package_eq(manifest, expected_name) == 0 {
    PackageRemoteRejected("remote source package name does not match the dependency key")
  } else {
    let files = vector_new<PackageContentEntry>()
    if pkg_lock_collect_cached_source_entries(root, manifest, files) != 0 {
      PackageRemoteRejected("remote source tree is unsafe or unreadable")
    } else {
      PackageRemoteAcquired(
        root,
        pkg_str_view(pkg_manifest_version_ptr(manifest), pkg_manifest_version_len(manifest)),
        pkg_content_digest(files)
      )
    }
  } }
}

pub(package) fn pkg_remote_provider(source: PackageDependencySource, stage: str) -[PackageSourceAcquire]> PackageProviderResult {
  let archive = str_concat(stage, "/source.tar")
  match source {
    PackagePathSource(path) -> PackageProviderFailed(PackageProviderRejected("path sources do not use remote acquisition"))
    PackageGitSource(url, revision) -> PackageSourceAcquire.git_archive(url, revision, pkg_safe_path(str_concat(stage, "/repository.git")), pkg_safe_path(archive))
    PackageArchiveSource(url, checksum) -> PackageSourceAcquire.https_archive(url, pkg_safe_path(archive), package_source_maximum_archive_bytes())
  }
}

pub(package) fn pkg_remote_transport_checksum(source: PackageDependencySource) -> str {
  match source {
    PackageArchiveSource(url, checksum) -> checksum
    _ -> ""
  }
}

pub(package) fn pkg_remote_admit(
  acquired: PackageRemoteAcquisition,
  expected_name: str,
  expected_version: str,
  expected_content: str
) -[DirInspect, DirMutate, FileRead]> PackageRemoteAcquisition {
  match acquired {
    PackageRemoteAcquired(tree, version, content) -> if str_len(expected_version) > 0 and str_eq(version, expected_version) == 0 {
      PackageRemoteRejected("remote source package version does not match weft.lock")
    } else { if str_len(expected_content) > 0 and str_eq(content, expected_content) == 0 {
      PackageRemoteRejected("remote source tree does not match the locked content digest")
    } else { if package_source_ensure_directory(".weft/cache/sha256") == false {
      PackageRemoteRejected("package cache directory is unavailable")
    } else {
      let destination = pkg_cache_root_for_content(content)
      let existing = pkg_cache_root_matches(destination, expected_name, version, content)
      if existing == false {
        match dir.symlink_metadata(pkg_safe_path(destination)) {
          Err(error) -> PackageRemoteRejected("package cache destination cannot be inspected")
          Ok(metadata) -> {
            let removed = if metadata.exists { package_source_remove_tree(destination) } else { true }
            if removed == false { PackageRemoteRejected("corrupt package cache entry cannot be replaced") }
            else { match dir.rename(pkg_safe_path(tree), pkg_safe_path(destination)) {
              Ok(value) -> PackageRemoteAcquired(destination, version, content)
              Err(error) -> if pkg_cache_root_matches(destination, expected_name, version, content) {
                PackageRemoteAcquired(destination, version, content)
              } else { PackageRemoteRejected("package cache admission was not atomic") }
            } }
          }
        }
      } else {
        PackageRemoteAcquired(destination, version, content)
      }
    } } }
    PackageRemoteProviderFailed(failure) -> PackageRemoteProviderFailed(failure)
    PackageRemoteRejected(message) -> PackageRemoteRejected(message)
  }
}

pub(package) fn pkg_remote_acquire(
  expected_name: str,
  source: PackageDependencySource,
  expected_version: str,
  expected_content: str,
  stage_prefix: str,
  next_stage: Vector<i64>
) -[PackageSourceAcquire, DirInspect, DirMutate, FileRead, FileWrite]> PackageRemoteAcquisition {
  match package_source_claim_stage(stage_prefix, next_stage) {
    PackageSourceStageUnavailable -> PackageRemoteRejected("a private package staging directory could not be created")
    PackageSourceStageReady(stage) -> {
      let archive = str_concat(stage, "/source.tar")
      let tree = str_concat(stage, "/tree")
      let acquired = match pkg_remote_provider(source, stage) {
        PackageProviderFailed(failure) -> PackageRemoteProviderFailed(failure)
        PackageProviderSucceeded -> match package_source_extract_archive(archive, pkg_remote_transport_checksum(source), tree) {
          Err(message) -> PackageRemoteRejected(message)
          Ok(value) -> pkg_remote_tree_identity(tree, expected_name)
        }
      }
      let admitted = pkg_remote_admit(acquired, expected_name, expected_version, expected_content)
      if package_source_remove_tree(stage) { admitted }
      else { PackageRemoteRejected("private package staging cleanup failed") }
    }
  }
}

pub(package) fn pkg_remote_cached_or_acquire(
  dep: i64,
  previous_lock: i64,
  stage_prefix: str,
  next_stage: Vector<i64>
) -[PackageSourceAcquire, DirInspect, DirMutate, FileRead, FileWrite]> PackageRemoteAcquisition {
  let name = pkg_dep_name(dep)
  let source = pkg_dep_source(dep)
  let source_identity = pkg_dependency_source_identity(source, "")
  let previous = if previous_lock == 0 { 0 }
    else { pkg_lock_data_find_name(previous_lock, __str_ptr(name), __str_len(name)) }
  if previous != 0 and str_eq(pkg_lock_entry_source(previous), source_identity) == 1 {
    let content = pkg_lock_entry_content(previous)
    let version = pkg_lock_entry_version(previous)
    let root = pkg_cache_root_for_content(content)
    if pkg_cache_root_matches(root, name, version, content) {
      PackageRemoteAcquired(root, version, content)
    } else { pkg_remote_acquire(name, source, version, content, stage_prefix, next_stage) }
  } else {
    pkg_remote_acquire(name, source, "", "", stage_prefix, next_stage)
  }
}

pub(package) fn pkg_lock_collect_package(
  root: str,
  expected_name: str,
  source: str,
  strict_tree: bool,
  previous_lock: i64,
  stage_prefix: str,
  next_stage: Vector<i64>,
  entries: Vector<i64>,
  stack: Vector<str>
) -[PackageSourceAcquire, DirInspect, DirMutate, FileRead, FileWrite]> PackageLockCollection {
  let manifest = pkg_safe_manifest_load_at_root(root)
  if pkg_manifest_error_count(manifest) > 0 or pkg_manifest_package_len(manifest) <= 0 or pkg_manifest_schema_version(manifest) != weft_manifest_schema_version() or pkg_manifest_weft_eq(manifest, weft_language_version()) == 0 { PackageLockManifestInvalid }
  else {
    let name = pkg_str_view(pkg_manifest_package_start(manifest), pkg_manifest_package_len(manifest))
    if str_len(expected_name) > 0 and str_eq(name, expected_name) == 0 { PackageLockNameMismatch }
    else { if vector_contains<str>(stack, name) { PackageLockCycle }
    else {
      let files = vector_new<PackageContentEntry>()
      let file_status = if strict_tree { pkg_lock_collect_cached_source_entries(root, manifest, files) }
        else { pkg_lock_collect_source_entries(root, manifest, files) }
      if file_status != 0 { PackageLockTraversalFailed }
      else {
        let version = pkg_str_view(pkg_manifest_version_ptr(manifest), pkg_manifest_version_len(manifest))
        let content = pkg_content_digest(files)
        let existing_index = pkg_lock_entry_find(entries, name)
        if existing_index >= 0 {
          if pkg_lock_entry_identity_equal(vector_get_in_bounds<i64>(entries, existing_index), version, source, content) == 1 { PackageLockCollected }
          else { PackageLockIdentityConflict }
        } else {
          vector_push<i64>(entries, pkg_lock_entry_new(name, version, source, content))
          vector_push<str>(stack, name)
          let deps = pkg_manifest_deps(manifest)
          let mut i = 0
          let mut result = PackageLockCollected
          while i < nlist_len(deps) {
            let should_continue = match result { PackageLockCollected -> true _ -> false }
            if should_continue == false { i = nlist_len(deps) }
            else {
            let dep = nlist_get(deps, i)
            let dep_name = pkg_dep_name(dep)
            match pkg_dep_source(dep) {
              PackagePathSource(dep_rel) -> {
                let dep_root = pkg_lock_join_path(root, dep_rel)
                result = pkg_lock_collect_package(dep_root, dep_name, str_concat("path:", dep_root), false, previous_lock, stage_prefix, next_stage, entries, stack)
              }
              PackageGitSource(url, revision) -> match pkg_remote_cached_or_acquire(dep, previous_lock, stage_prefix, next_stage) {
                PackageRemoteAcquired(dep_root, dep_version, dep_content) -> {
                  result = pkg_lock_collect_package(dep_root, dep_name, pkg_dependency_source_identity(PackageGitSource(url, revision), ""), true, previous_lock, stage_prefix, next_stage, entries, stack)
                }
                failure -> { result = PackageLockAcquisitionFailed(failure) }
              }
              PackageArchiveSource(url, checksum) -> match pkg_remote_cached_or_acquire(dep, previous_lock, stage_prefix, next_stage) {
                PackageRemoteAcquired(dep_root, dep_version, dep_content) -> {
                  result = pkg_lock_collect_package(dep_root, dep_name, pkg_dependency_source_identity(PackageArchiveSource(url, checksum), ""), true, previous_lock, stage_prefix, next_stage, entries, stack)
                }
                failure -> { result = PackageLockAcquisitionFailed(failure) }
              }
            }
            i = i + 1
            }
          }
          vector_pop<str>(stack)
          result
        }
      }
    } }
  }
}

pub(package) fn pkg_lock_entry_json(entry: i64) -> Json {
  json_object(
    list_cons<JsonEntry>(json_entry("name", json_string(pkg_lock_entry_name(entry))),
    list_cons<JsonEntry>(json_entry("version", json_string(pkg_lock_entry_version(entry))),
    list_cons<JsonEntry>(json_entry("source", json_string(pkg_lock_entry_source(entry))),
    list_cons<JsonEntry>(json_entry("content", json_string(pkg_lock_entry_content(entry))), list_nil<JsonEntry>()))))
  )
}

pub(package) fn pkg_lock_to_json(entries: Vector<i64>) -> Json {
  vector_sort_by<i64>(entries, pkg_lock_entry_compare)
  let mut packages: List<Json> = list_nil<Json>()
  let mut i = vector_len<i64>(entries) - 1
  while i >= 0 {
    packages = list_cons<Json>(pkg_lock_entry_json(vector_get_in_bounds<i64>(entries, i)), packages)
    i = i - 1
  }
  json_object(
    list_cons<JsonEntry>(json_entry("lock_version", json_number(weft_lock_schema_version())),
    list_cons<JsonEntry>(json_entry("manifest_version", json_number(weft_manifest_schema_version())),
    list_cons<JsonEntry>(json_entry("weft", json_string(weft_language_version())),
    list_cons<JsonEntry>(json_entry("packages", json_array(packages)), list_nil<JsonEntry>()))))
  )
}

pub(package) fn pkg_lock_render_into(buf: i64, entries: Vector<i64>) -> i64 {
  bstr(buf, json_stringify(pkg_lock_to_json(entries)).expect("package locks contain only finite JSON"))
  bu8(buf, 10)
  buf_len(buf)
}

pub(package) fn pkg_lock_file_path() -> i64 {
  let path = alloc_words(2)
  mem_store64_at(path, 0, __str_ptr("weft.lock"))
  mem_store64_at(path, 8, __str_len("weft.lock"))
  path
}

pub(package) fn pkg_lock_load_safe() -[FileRead]> i64 {
  match file.read_all(pkg_safe_path("weft.lock"), pkg_safe_read_limit()) {
    Err(error) -> pkg_lock_data_absent()
    Ok(bytes) -> {
      let values = bytes.to_vector()
      if vector_len<u8>(values) == 0 { pkg_lock_data_absent() }
      else { pkg_lock_parse(runtime_str_from_bytes_copy(vector_data<u8>(values), vector_len<u8>(values))) }
    }
  }
}

pub(package) fn pkg_lock_verify_cache_data(data: i64) -[DirInspect, FileRead]> PackageCacheVerification {
  if pkg_lock_data_status(data) < 0 { PackageCacheLockMalformed }
  else {
    let mut index = 0
    let mut result = PackageCacheVerified
    while index < pkg_lock_data_count(data) {
      let entry = pkg_lock_data_entry_at(data, index)
      let source = pkg_lock_entry_source(entry)
      if str_starts_with(source, "path:") == 0 {
        let name = pkg_lock_entry_name(entry)
        let content = pkg_lock_entry_content(entry)
        let root = pkg_cache_root_for_content(content)
        match dir.symlink_metadata(pkg_safe_path(root)) {
          Err(error) -> { result = PackageCacheMissing(name, content) }
          Ok(metadata) -> if metadata.exists == false {
            result = PackageCacheMissing(name, content)
          } else { if not metadata.kind.eq(DirDirectory) {
            result = PackageCacheCorrupt(name, content)
          } else {
            let manifest = pkg_safe_manifest_load_at_root(root)
            let name_ok = pkg_manifest_package_eq(manifest, name)
            let version_ok = pkg_manifest_version_eq(manifest, pkg_lock_entry_version(entry))
            if pkg_manifest_error_count(manifest) > 0 or name_ok == 0 or version_ok == 0 or pkg_manifest_weft_eq(manifest, weft_language_version()) == 0 {
              result = PackageCacheCorrupt(name, content)
            } else {
              let files = vector_new<PackageContentEntry>()
              let status = pkg_lock_collect_cached_source_entries(root, manifest, files)
              if status != 0 or str_eq(pkg_content_digest(files), content) == 0 {
                result = PackageCacheCorrupt(name, content)
              } else { 0 }
            }
          } }
        }
      } else { 0 }
      match result {
        PackageCacheVerified -> { index = index + 1 }
        _ -> { index = pkg_lock_data_count(data) }
      }
    }
    result
  }
}

pub(package) fn pkg_lock_verify_cache() -[DirInspect, FileRead]> PackageCacheVerification {
  pkg_lock_verify_cache_data(pkg_lock_load_safe())
}

-- A malformed lock must not make path-only projects depend on the remote
-- cache preflight. Their normal resolver retains the source-located E5005
-- diagnostic. A direct remote declaration cannot resolve without a semantic
-- lock, so it fails before any command starts consuming the graph.
pub(package) fn pkg_lock_verify_project_cache() -[DirInspect, FileRead]> PackageCacheVerification {
  let data = pkg_lock_load_safe()
  if pkg_lock_data_status(data) >= 0 { pkg_lock_verify_cache_data(data) }
  else {
    let manifest = pkg_safe_manifest_load_at_root("")
    if pkg_manifest_error_count(manifest) == 0 and pkg_manifest_has_remote_dependencies(manifest) {
      PackageCacheLockMalformed
    } else { PackageCacheVerified }
  }
}

pub(package) fn pkg_remote_failure_print(failure: PackageRemoteAcquisition) -> i64 {
  match failure {
    PackageRemoteAcquired(root, version, content) -> 0
    PackageRemoteProviderFailed(PackageProviderUnavailable(provider)) -> {
      pkg_stderr("error[E5013]: package source provider is unavailable: ")
      pkg_stderr(provider)
      pkg_stderr("\n")
      1
    }
    PackageRemoteProviderFailed(PackageProviderRejected(message)) -> {
      pkg_stderr("error[E5013]: package source provider refused acquisition: ")
      pkg_stderr(message)
      pkg_stderr("\n")
      1
    }
    PackageRemoteRejected(message) -> {
      pkg_stderr("error[E5013]: package source was rejected: ")
      pkg_stderr(message)
      pkg_stderr("\n")
      1
    }
  }
}

pub(package) fn pkg_lock_collection_error(status: PackageLockCollection) -> i64 {
  match status {
    PackageLockCollected -> 0
    PackageLockManifestInvalid -> { pkg_stderr("pkg: malformed or missing package manifest\n") 1 }
    PackageLockNameMismatch -> { pkg_stderr("pkg: dependency key does not match package name\n") 1 }
    PackageLockIdentityConflict -> { pkg_stderr("pkg: package identity conflict in dependency graph\n") 1 }
    PackageLockCycle -> { pkg_stderr("pkg: package dependency cycle\n") 1 }
    PackageLockTraversalFailed -> { pkg_stderr("pkg: could not traverse package source tree\n") 1 }
    PackageLockAcquisitionFailed(failure) -> pkg_remote_failure_print(failure)
  }
}

pub(package) fn pkg_cache_verification_print(status: PackageCacheVerification) -> i64 {
  match status {
    PackageCacheVerified -> { pkg_stdout("pkg: immutable package cache verified\n") 0 }
    PackageCacheLockMalformed -> { pkg_stderr("error[E5005]: package lock is malformed or unsupported\n") 1 }
    PackageCacheMissing(name, content) -> {
      pkg_stderr("error[E5011]: locked dependency '")
      pkg_stderr(name)
      pkg_stderr("' is absent from the immutable package cache (")
      pkg_stderr(content)
      pkg_stderr(")\n")
      1
    }
    PackageCacheCorrupt(name, content) -> {
      pkg_stderr("error[E5012]: immutable cache content for dependency '")
      pkg_stderr(name)
      pkg_stderr("' does not match ")
      pkg_stderr(content)
      pkg_stderr("\n")
      1
    }
  }
}

pub(package) fn pkg_cli_lock_with_notice(stage_prefix: str, notice: PackageLockNotice) -[PackageSourceAcquire, DirInspect, DirMutate, FileRead, FileWrite]> i64 {
  let entries = vector_new<i64>()
  let stack = vector_new<str>()
  let next_stage = vector_new<i64>()
  vector_push<i64>(next_stage, 0)
  let previous = pkg_lock_load_safe()
  if pkg_lock_data_status(previous) < 0 { pkg_cache_verification_print(PackageCacheLockMalformed) }
  else {
    let status = pkg_lock_collect_package(".", "", "path:.", false, previous, stage_prefix, next_stage, entries, stack)
    if pkg_lock_collection_error(status) != 0 { 1 }
    else {
    let b = buf_new(1024)
    pkg_lock_render_into(b, entries)
    match file.atomic_replace_text(
      pkg_safe_path("weft.lock"),
      runtime_str_from_bytes_copy(buf_ptr(b), buf_len(b))
    ) {
      Err(error) -> {
        pkg_stderr("pkg: could not write weft.lock\n")
        1
      }
      Ok(count) -> {
        match notice {
          PackageLockAnnounce -> pkg_stdout("pkg: wrote weft.lock\n")
          PackageLockQuiet -> 0
        }
        0
      }
    }
  } }
}

pub(package) fn pkg_cli_lock(stage_prefix: str) -[PackageSourceAcquire, DirInspect, DirMutate, FileRead, FileWrite]> i64 {
  pkg_cli_lock_with_notice(stage_prefix, PackageLockAnnounce)
}

pub(package) fn pkg_cli_fetch_offline() -[DirInspect, FileRead]> i64 {
  let data = pkg_lock_load_safe()
  if pkg_lock_data_status(data) != 1 { pkg_cache_verification_print(PackageCacheLockMalformed) }
  else { data |> pkg_lock_verify_cache_data |> pkg_cache_verification_print }
}

pub(package) fn pkg_cli_fetch_online(stage_prefix: str) -[PackageSourceAcquire, DirInspect, DirMutate, FileRead, FileWrite]> i64 {
  let data = pkg_lock_load_safe()
  if pkg_lock_data_status(data) != 1 { pkg_cache_verification_print(PackageCacheLockMalformed) }
  else {
    let next_stage = vector_new<i64>()
    vector_push<i64>(next_stage, 0)
    let mut index = 0
    let mut ok = true
    while index < pkg_lock_data_count(data) and ok {
      let entry = pkg_lock_data_entry_at(data, index)
      let source_text = pkg_lock_entry_source(entry)
      if str_starts_with(source_text, "path:") == 1 { 0 }
      else {
        let name = pkg_lock_entry_name(entry)
        let version = pkg_lock_entry_version(entry)
        let content = pkg_lock_entry_content(entry)
        let root = pkg_cache_root_for_content(content)
        if pkg_cache_root_matches(root, name, version, content) { 0 }
        else { match pkg_lock_remote_source_parse(source_text) {
          PackageRemoteSourceInvalid -> { ok = false 0 }
          PackageRemoteSourceParsed(source) -> match pkg_remote_acquire(name, source, version, content, stage_prefix, next_stage) {
            PackageRemoteAcquired(acquired_root, acquired_version, acquired_content) -> 0
            failure -> { ok = pkg_remote_failure_print(failure) == 0 0 }
          }
        } }
      }
      index = index + 1
    }
    if ok == false { 1 }
    else { pkg_lock_verify_cache_data(data) |> pkg_cache_verification_print }
  }
}
