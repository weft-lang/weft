-- compiler/type_registry.weft -- shared semantic type/source registry

use compiler/lib.{*}
use compiler/module.{*}
use compiler/types.{*}
use runtime/alloc.{*}
use runtime/memory.{*}

pub(package) fn type_registry_alloc_bytes(size: i64) -> i64 {
  alloc_words((size + 7) / 8)
}

pub(package) fn ttable_new() -> i64 {
  let h = type_registry_alloc_bytes(248)
  let d = type_registry_alloc_bytes(6400)
  mem_store64_at(h, 0, d)
  mem_store64_at(h + 8, 0, 0)
  mem_store64_at(h + 16, 0, 100)
  -- Loaded files list for use dedup (stored at h+24)
  mem_store64_at(h + 24, 0, nlist_new())
  -- Conformance table pointer (stored at h+32, set by compile)
  mem_store64_at(h + 32, 0, 0)
  -- Current function's tparams (stored at h+40, set by check_fn)
  mem_store64_at(h + 40, 0, 0)
  -- Trusted source buffers for sealed runtime/platform internals (h+48)
  mem_store64_at(h + 48, 0, nlist_new())
  -- Strict root source buffers loaded from ordinary path-aware CLI inputs (h+56)
  mem_store64_at(h + 56, 0, nlist_new())
  -- Sources allowed to grant import trust while the parser owns use-loading (h+64)
  mem_store64_at(h + 64, 0, nlist_new())
  -- Source registry: (buf, len, path_ptr, path_len) per loaded buffer (h+72).
  -- Lets diagnostics resolve an absolute span to its owning file.
  mem_store64_at(h + 72, 0, nlist_new())
  -- Variant-name hash index (h+80, managed-reference caching): lazily built, staleness-
  -- checked against the entry count. Kills the O(types x variants)
  -- linear scan under the payload-less-ctor classifiers.
  mem_store64_at(h + 80, 0, 0)
  mem_store64_at(h + 88, 0, 0)
  -- Import in-progress stack for cycle detection (h+96, set-theoretic surface): files whose
  -- use-loading has begun but not finished. A use that resolves to a file on
  -- this stack is a circular import and gets a diagnostic; a file merely in
  -- the h+24 loaded list is a diamond re-import and stays silently deduped.
  mem_store64_at(h + 96, 0, nlist_new())
  -- Current function's declared effect sig (h+104, parameterized effects): set by check_fn
  -- like the tparams slot; lets synth-time perform checking find the
  -- parameterized atom that instantiates a generic effect's op types.
  mem_store64_at(h + 104, 0, 0)
  -- Module/declaration/import/scope semantic-fact registries (h+112..136).
  module_fact_tables_init(h)
  -- Package-identity interner (h+144). Package ids are compact graph
  -- handles allocated only after full-name equality; hashes are never used as
  -- semantic identity.
  mem_store64_at(h + 144, 0, nlist_new())
  -- package resolution parsed root lock data (h+152). Zero means resolution has not loaded a
  -- lock yet; the cached data itself distinguishes absent, valid, malformed.
  mem_store64_at(h + 152, 0, 0)
  -- Checker-owned function facts (h+160). The type checker publishes its
  -- resolved signature table here after pass 1 so tooling consumers never
  -- need to recover types/effects by walking syntax or typed IR.
  mem_store64_at(h + 160, 0, 0)
  -- Checker-owned position facts (h+168). Each checked symbol occurrence
  -- points at the binding/declaration identity selected by the real lexical
  -- environment and module resolver, together with its narrowed type.
  mem_store64_at(h + 168, 0, nlist_new())
  -- Checker-owned active handler stack (h+176). Diagnostics use this resolved
  -- scope fact to explain same-head parameter mismatches without rescanning
  -- syntax or guessing from the available effect set.
  mem_store64_at(h + 176, 0, 0)
  -- Lazily cached human-renderer color mode (h+184): 0 unknown, 1 plain,
  -- 2 ANSI. One registry corresponds to one command/pipeline invocation.
  mem_store64_at(h + 184, 0, 0)
  -- Parsed root manifest (h+192). Root imports share this immutable value;
  -- reparsing weft.pkg for every edge retained a complete JSON value graph per
  -- import and made project builds pathologically slower than loose files.
  mem_store64_at(h + 192, 0, 0)
  -- Checked module product state (h+200): immutable source and function-pair
  -- sets established before a project worker forks. A child may extend the
  -- checker catalog without rechecking these typed bodies.
  mem_store64_at(h + 200, 0, node_new(0, nlist_new(), nlist_new(), 0, 0))
  -- Semantic linear-layout fact cache buckets (h+208). Lowering and
  -- linear-use checking ask for the same substituted layouts repeatedly. The
  -- facts contain persistent plan graphs, so rebuilding them in the process
  -- bump arena caused compilation memory to grow with query count rather than
  -- with the number of distinct semantic types. Allocate the bucket vector
  -- with the registry itself, below any per-function scratch mark: entries
  -- may be cleared before a bump restore, but the vector must survive it.
  mem_store64_at(h + 208, 0, alloc_zeroed(1024 * 8))
  -- Manifest-native binding source facts (h+216). Each entry joins one exact
  -- trusted source buffer to its package binding and selected target, plus
  -- the synthetic private declarations registered from that target. This is
  -- the semantic producer consumed by checking, lowering and audit; none of
  -- those consumers may rediscover native authority from source spellings.
  mem_store64_at(h + 216, 0, nlist_new())
  -- Selected native compilation target (h+224). Zero means the sealed host
  -- target; an explicit cross-build records the manifest-storage target before
  -- imports are parsed so checking and lowering consume one target fact.
  mem_store64_at(h + 224, 0, 0)
  -- Compiler-selected installed SDK package id (h+232). Zero preserves the
  -- checkout model in which compiler/runtime/stdlib belong to package zero;
  -- a positive id names the adjacent release SDK as its own package.
  mem_store64_at(h + 232, 0, 0)
  -- Type-entry lookup indices (h+240): exact declaration identity first and
  -- a collision-preserving name-hash fallback for unresolved legacy atoms.
  -- The indices belong to this registry; declaration facts remain immutable
  -- and may be shared by independently instantiated checked products.
  mem_store64_at(h + 240, 0, node_new(0, alloc_zeroed(1024 * 8), alloc_zeroed(1024 * 8), 0, 0))
  h
}

pub(package) fn ttable_type_hash_bucket_count() -> i64 { 1024 }

pub(package) fn ttable_type_decl_index_add(tt: i64, declaration: i64, index: i64) -> i64 {
  if declaration == 0 { 0 }
  else {
    let buckets = node_f1(mem_load64_at(tt + 240, 0))
    let bucket = (declaration / 8) band (ttable_type_hash_bucket_count() - 1)
    let head = mem_load64_at(buckets + bucket * 8, 0)
    let entry = node_new(0, declaration, index, 0, head)
    mem_store64_at(buckets + bucket * 8, 0, entry)
    entry
  }
}

pub(package) fn ttable_type_decl_index_find(tt: i64, declaration: i64) -> i64 {
  if tt == 0 or declaration == 0 { 0 }
  else {
    let buckets = node_f1(mem_load64_at(tt + 240, 0))
    let bucket = (declaration / 8) band (ttable_type_hash_bucket_count() - 1)
    let mut current = mem_load64_at(buckets + bucket * 8, 0)
    let mut found = 0
    while current != 0 and found == 0 {
      if node_f1(current) == declaration {
        found = mem_load64_at(tt, 0) + node_f2(current) * 64
      } else { current = node_f4(current) }
    }
    found
  }
}

pub(package) fn ttable_type_hash_index_add(tt: i64, hash: i64, kind: i64, index: i64) -> i64 {
  let buckets = node_f2(mem_load64_at(tt + 240, 0))
  let bucket = hash band (ttable_type_hash_bucket_count() - 1)
  let head = mem_load64_at(buckets + bucket * 8, 0)
  let entry = node_new(kind, hash, index, 0, head)
  mem_store64_at(buckets + bucket * 8, 0, entry)
  entry
}

pub(package) fn ttable_type_hash_index_find(tt: i64, hash: i64, kind: i64) -> i64 {
  if tt == 0 { 0 }
  else {
    let buckets = node_f2(mem_load64_at(tt + 240, 0))
    let bucket = hash band (ttable_type_hash_bucket_count() - 1)
    let mut current = mem_load64_at(buckets + bucket * 8, 0)
    let mut found_index = 0 - 1
    while current != 0 {
      if node_f1(current) == hash and (kind < 0 or node_tag(current) == kind) {
        -- Entries are prepended; retaining the last match preserves the
        -- registry's historical first-declaration lookup order.
        found_index = node_f2(current)
      } else { 0 }
      current = node_f4(current)
    }
    if found_index < 0 { 0 } else { mem_load64_at(tt, 0) + found_index * 64 }
  }
}

pub(package) fn ttable_set_sdk_package_id(tt: i64, package_id: i64) -> i64 {
  mem_store64_at(tt + 232, 0, package_id)
  package_id
}

pub(package) fn ttable_sdk_package_id(tt: i64) -> i64 {
  mem_load64_at(tt + 232, 0)
}

pub(package) fn ttable_set_native_compilation_target(tt: i64, target: i64) -> i64 {
  mem_store64_at(tt + 224, 0, target)
  target
}

pub(package) fn ttable_native_compilation_target(tt: i64) -> i64 {
  mem_load64_at(tt + 224, 0)
}

pub(package) fn ttable_linear_layout_cache_bucket_count() -> i64 { 1024 }

pub(package) fn ttable_linear_layout_cache_buckets(tt: i64) -> i64 {
  let current = mem_load64_at(tt + 208, 0)
  if current != 0 { current }
  else {
    let buckets = alloc_zeroed(ttable_linear_layout_cache_bucket_count() * 8)
    mem_store64_at(tt + 208, 0, buckets)
    buckets
  }
}

-- Per-function optimiser facts live in its bump scratch window. Snapshotting
-- only the persistent bucket heads lets those facts memoize within the pass;
-- restoring the heads before the bump rollback unlinks exactly the scratch
-- entries without throwing away facts established during checking/lowering.
pub(package) fn ttable_linear_layout_cache_checkpoint(tt: i64) -> i64 {
  if tt == 0 { 0 }
  else {
    let bytes = ttable_linear_layout_cache_bucket_count() * 8
    let checkpoint = alloc_words(ttable_linear_layout_cache_bucket_count())
    mem_copy(checkpoint, ttable_linear_layout_cache_buckets(tt), bytes)
    checkpoint
  }
}

pub(package) fn ttable_linear_layout_cache_restore(tt: i64, checkpoint: i64) -> i64 {
  if tt == 0 or checkpoint == 0 { 0 }
  else { mem_copy(ttable_linear_layout_cache_buckets(tt), checkpoint, ttable_linear_layout_cache_bucket_count() * 8) 0 }
}

-- Cache entry: registry version in tag, semantic hash/type/fact in f1..f3,
-- and the bucket chain in f4. The entry count versions facts because a named
-- type that was unresolved at one point can acquire a definition later in
-- the same project session.
pub(package) fn ttable_linear_layout_fact_lookup(tt: i64, ty: i64) -> i64 {
  if tt == 0 or ty == 0 { 0 }
  else {
    let buckets = mem_load64_at(tt + 208, 0)
    if buckets == 0 { 0 }
    else {
      let hash = ty_semantic_hash(ty)
      let bucket = hash band (ttable_linear_layout_cache_bucket_count() - 1)
      let version = ttable_entry_count(tt)
      let mut entry = mem_load64_at(buckets + bucket * 8, 0)
      let mut fact = 0
      while entry != 0 and fact == 0 {
        let cached_ty = node_f2(entry)
        let cached_fact = node_f3(entry)
        if node_tag(entry) == version and node_f1(entry) == hash and cached_ty != 0 and cached_fact != 0 and (cached_ty == ty or ty_eq(cached_ty, ty)) {
          fact = cached_fact
        } else { entry = node_f4(entry) }
      }
      fact
    }
  }
}

pub(package) fn ttable_linear_layout_fact_store(tt: i64, ty: i64, fact: i64) -> i64 {
  if tt == 0 or ty == 0 or fact == 0 { fact }
  else {
    let hash = ty_semantic_hash(ty)
    let buckets = ttable_linear_layout_cache_buckets(tt)
    let bucket = hash band (ttable_linear_layout_cache_bucket_count() - 1)
    let head = mem_load64_at(buckets + bucket * 8, 0)
    let entry = node_new(ttable_entry_count(tt), hash, ty, fact, head)
    mem_store64_at(buckets + bucket * 8, 0, entry)
    fact
  }
}
pub(package) fn ttable_sources(tt: i64) -> i64 { mem_load64_at(tt + 72, 0) }

pub(package) fn ttable_find_source_buffer_entry(tt: i64, buf: i64) -> i64 {
  let sources = ttable_sources(tt)
  let n = nlist_len(sources)
  let mut i = 0
  let mut found = 0
  while i < n {
    let entry = nlist_get(sources, i)
    if mem_load64_at(entry, 0) == buf {
      found = entry
      i = n
    } else { i = i + 1 }
  }
  found
}

pub(package) fn ttable_find_source_path_entry(tt: i64, path_ptr: i64, path_len: i64) -> i64 {
  let sources = ttable_sources(tt)
  let mut i = 0
  let mut found = 0
  while i < nlist_len(sources) and found == 0 {
    let entry = nlist_get(sources, i)
    let entry_len = mem_load64_at(entry + 24, 0)
    if entry_len == path_len and path_len > 0 and src_eq_at(mem_load64_at(entry + 16, 0), 0, path_ptr, 0, path_len) == 1 {
      found = entry
    } else { i = i + 1 }
  }
  found
}

pub(package) fn ttable_register_source_in_package(tt: i64, buf: i64, len: i64, path_ptr: i64, path_len: i64, package_id: i64) -> i64 {
  let existing = ttable_find_source_buffer_entry(tt, buf)
  if existing != 0 {
    -- A path-aware caller may pre-register the root before Grammar.parse,
    -- whose generic entrypoint then attempts a pathless registration. Keep
    -- one canonical record and only upgrade missing origin data.
    if mem_load64_at(existing + 24, 0) == 0 and path_len > 0 {
      mem_store64_at(existing + 16, 0, path_ptr)
      mem_store64_at(existing + 24, 0, path_len)
      module_fact_register_source(tt, buf, path_ptr, path_len, package_id)
    } else { 0 }
    existing
  } else {
    let e = type_registry_alloc_bytes(32)
    mem_store64_at(e, 0, buf)
    mem_store64_at(e + 8, 0, len)
    mem_store64_at(e + 16, 0, path_ptr)
    mem_store64_at(e + 24, 0, path_len)
    nlist_add(ttable_sources(tt), e)
    module_fact_register_source(tt, buf, path_ptr, path_len, package_id)
    e
  }
}

pub(package) fn ttable_register_source(tt: i64, buf: i64, len: i64, path_ptr: i64, path_len: i64) -> i64 {
  ttable_register_source_in_package(tt, buf, len, path_ptr, path_len, 0)
}
pub(package) fn ttable_find_source_entry(tt: i64, span: i64) -> i64 {
  -- Absolute span -> registry entry whose [buf, buf+len) contains it; 0 if none.
  let sources = ttable_sources(tt)
  let n = nlist_len(sources)
  let mut i = 0
  let mut found = 0
  while i < n {
    let e = nlist_get(sources, i)
    let buf = mem_load64_at(e, 0)
    let len = mem_load64_at(e + 8, 0)
    if span >= buf and span < buf + len { found = e i = n } else { i = i + 1 }
  }
  found
}
pub(package) fn ttable_set_ct(tt: i64, ct: i64) -> i64 { mem_store64_at(tt + 32, 0, ct) 0 }
pub(package) fn ttable_get_ct(tt: i64) -> i64 { mem_load64_at(tt + 32, 0) }
pub(package) fn ttable_set_tparams(tt: i64, tp: i64) -> i64 { mem_store64_at(tt + 40, 0, tp) 0 }
pub(package) fn ttable_get_tparams(tt: i64) -> i64 { mem_load64_at(tt + 40, 0) }
pub(package) fn ttable_set_current_fn_eff(tt: i64, eff: i64) -> i64 { mem_store64_at(tt + 104, 0, eff) 0 }
pub(package) fn ttable_get_current_fn_eff(tt: i64) -> i64 { mem_load64_at(tt + 104, 0) }
pub(package) fn ttable_set_checked_functions(tt: i64, functions: i64) -> i64 { mem_store64_at(tt + 160, 0, functions) 0 }
pub(package) fn ttable_get_checked_functions(tt: i64) -> i64 { mem_load64_at(tt + 160, 0) }
pub(package) fn ttable_set_current_handler(tt: i64, handler: i64) -> i64 { mem_store64_at(tt + 176, 0, handler) 0 }
pub(package) fn ttable_get_current_handler(tt: i64) -> i64 { mem_load64_at(tt + 176, 0) }
pub(package) fn ttable_set_diagnostic_color_mode(tt: i64, mode: i64) -> i64 { mem_store64_at(tt + 184, 0, mode) 0 }
pub(package) fn ttable_get_diagnostic_color_mode(tt: i64) -> i64 { mem_load64_at(tt + 184, 0) }
pub(package) fn ttable_set_root_manifest(tt: i64, manifest: i64) -> i64 { mem_store64_at(tt + 192, 0, manifest) 0 }
pub(package) fn ttable_get_root_manifest(tt: i64) -> i64 { mem_load64_at(tt + 192, 0) }
pub(package) fn ttable_entry_count(tt: i64) -> i64 { mem_load64_at(tt + 8, 0) }
pub(package) fn ttable_entry_at(tt: i64, index: i64) -> i64 { mem_load64_at(tt, 0) + index * 64 }
pub(package) fn ttable_checked_module_state(tt: i64) -> i64 { mem_load64_at(tt + 200, 0) }
pub(package) fn ttable_checked_module_sources(tt: i64) -> i64 { node_f1(ttable_checked_module_state(tt)) }
pub(package) fn ttable_checked_module_pairs(tt: i64) -> i64 { node_f2(ttable_checked_module_state(tt)) }

pub(package) fn ttable_module_source_is_checked(tt: i64, src: i64) -> i64 {
  module_fact_pair_list_contains(ttable_checked_module_sources(tt), src)
}

pub(package) fn ttable_function_pair_is_checked(tt: i64, pair: i64) -> i64 {
  module_fact_pair_list_contains(ttable_checked_module_pairs(tt), pair)
}

pub(package) fn ttable_mark_checked_module_products(tt: i64, fns: i64) -> i64 {
  let sources = ttable_checked_module_sources(tt)
  for i in 0..module_fact_module_count(tt) {
    let src = module_fact_entry_source(module_fact_module_at(tt, i))
    if module_fact_pair_list_contains(sources, src) == 0 { nlist_add(sources, src) } else { 0 }
  }
  let pairs = ttable_checked_module_pairs(tt)
  for i in 0..nlist_len(fns) {
    let pair = nlist_get(fns, i)
    if module_fact_pair_list_contains(pairs, pair) == 0 { nlist_add(pairs, pair) } else { 0 }
  }
  tt
}
pub(package) fn semantic_symbol_kind_function() -> i64 { 1 }
pub(package) fn semantic_symbol_kind_constructor() -> i64 { 2 }
pub(package) fn semantic_symbol_kind_local() -> i64 { 3 }
pub(package) fn semantic_symbol_kind_parameter() -> i64 { 4 }
pub(package) fn semantic_symbol_kind_pattern() -> i64 { 5 }
pub(package) fn semantic_symbol_kind_loop() -> i64 { 6 }
pub(package) fn semantic_symbol_kind_effect_atom() -> i64 { 7 }
pub(package) fn semantic_symbol_kind_effect_operation() -> i64 { 8 }
pub(package) fn semantic_symbol_kind_associated_type() -> i64 { 9 }
pub(package) fn semantic_symbol_kind_tuple_position() -> i64 { 10 }
pub(package) fn semantic_symbol_kind_match_arm() -> i64 { 11 }
pub(package) fn semantic_symbol_kind_constant() -> i64 { 12 }
pub(package) fn ttable_semantic_symbol_facts(tt: i64) -> i64 { mem_load64_at(tt + 168, 0) }

-- Match-arm context is checker-owned producer data. Stable consumers receive
-- the projected narrowed/residual types and guard bit, never this allocation.
pub(package) fn semantic_match_arm_context(residual: i64, guarded: i64) -> i64 {
  let context = type_registry_alloc_bytes(16)
  mem_store64_at(context, 0, residual)
  mem_store64_at(context + 8, 0, guarded)
  context
}
pub(package) fn semantic_match_arm_context_residual(context: i64) -> i64 { mem_load64_at(context, 0) }
pub(package) fn semantic_match_arm_context_guarded(context: i64) -> i64 { mem_load64_at(context + 8, 0) }

-- Entry layout (88 bytes): occurrence source/start/len, definition
-- source/start/len, resolved type, type-parameter scope, symbol kind, and the
-- lexical environment visible at the occurrence. The latter is producer data
-- for completion; stable consumers receive projected bindings, never this
-- linked-list representation. Context (offset 80) carries a resolved exact
-- effect atom for effect-use facts, match-arm residual/guard data for match
-- facts, and is zero for ordinary symbols.
pub(package) fn ttable_add_semantic_symbol_fact(tt: i64, use_src: i64, use_start: i64, use_len: i64, def_src: i64, def_start: i64, def_len: i64, ty: i64, tparams: i64, kind: i64, env: i64, context: i64) -> i64 {
  let facts = ttable_semantic_symbol_facts(tt)
  -- Append is deliberately O(1). A few checker analyses revisit the same
  -- source occurrence under a refined environment; queries walk newest-first
  -- so the last (most precise) fact wins without making compilation quadratic.
  let entry = type_registry_alloc_bytes(88)
  mem_store64_at(entry, 0, use_src)
  mem_store64_at(entry + 8, 0, use_start)
  mem_store64_at(entry + 16, 0, use_len)
  mem_store64_at(entry + 24, 0, def_src)
  mem_store64_at(entry + 32, 0, def_start)
  mem_store64_at(entry + 40, 0, def_len)
  mem_store64_at(entry + 48, 0, ty)
  mem_store64_at(entry + 56, 0, tparams)
  mem_store64_at(entry + 64, 0, kind)
  mem_store64_at(entry + 72, 0, env)
  mem_store64_at(entry + 80, 0, context)
  nlist_add(facts, entry)
  entry
}

pub(package) fn ttable_find_semantic_symbol_fact(tt: i64, src: i64, offset: i64) -> i64 {
  let facts = ttable_semantic_symbol_facts(tt)
  let mut i = nlist_len(facts)
  let mut result = 0
  -- Most facts use newest-wins refinement. A typed match binder deliberately
  -- has two facts on the same span: ordinary binding identity for body uses,
  -- and the richer arm-level narrowed/residual fact for the declaration
  -- occurrence. Later synth/recovery walks may append the binding again, so
  -- retain it as fallback while continuing to seek the arm fact.
  while i > 0 {
    i = i - 1
    let entry = nlist_get(facts, i)
    let start = mem_load64_at(entry + 8, 0)
    let len = mem_load64_at(entry + 16, 0)
    if mem_load64_at(entry, 0) == src and offset >= start and offset < start + len {
      if mem_load64_at(entry + 64, 0) == semantic_symbol_kind_match_arm() {
        result = entry
        i = 0
      } else { if result == 0 { result = entry } else { 0 } }
    } else { 0 }
  }
  result
}

pub(package) fn ttable_find_semantic_symbol_fact_before(tt: i64, src: i64, offset: i64) -> i64 {
  let facts = ttable_semantic_symbol_facts(tt)
  let mut i = 0
  let mut result = 0
  let mut best_start = 0 - 1
  while i < nlist_len(facts) {
    let entry = nlist_get(facts, i)
    let start = mem_load64_at(entry + 8, 0)
    let len = mem_load64_at(entry + 16, 0)
    if mem_load64_at(entry, 0) == src and start + len <= offset and start > best_start {
      result = entry
      best_start = start
    } else { 0 }
    i = i + 1
  }
  result
}

pub(package) fn semantic_symbol_fact_use_source(entry: i64) -> i64 { mem_load64_at(entry, 0) }
pub(package) fn semantic_symbol_fact_use_start(entry: i64) -> i64 { mem_load64_at(entry + 8, 0) }
pub(package) fn semantic_symbol_fact_use_len(entry: i64) -> i64 { mem_load64_at(entry + 16, 0) }
pub(package) fn semantic_symbol_fact_definition_source(entry: i64) -> i64 { mem_load64_at(entry + 24, 0) }
pub(package) fn semantic_symbol_fact_definition_start(entry: i64) -> i64 { mem_load64_at(entry + 32, 0) }
pub(package) fn semantic_symbol_fact_definition_len(entry: i64) -> i64 { mem_load64_at(entry + 40, 0) }
pub(package) fn semantic_symbol_fact_type(entry: i64) -> i64 { mem_load64_at(entry + 48, 0) }
pub(package) fn semantic_symbol_fact_tparams(entry: i64) -> i64 { mem_load64_at(entry + 56, 0) }
pub(package) fn semantic_symbol_fact_kind(entry: i64) -> i64 { mem_load64_at(entry + 64, 0) }
pub(package) fn semantic_symbol_fact_environment(entry: i64) -> i64 { mem_load64_at(entry + 72, 0) }
pub(package) fn semantic_symbol_fact_context(entry: i64) -> i64 { mem_load64_at(entry + 80, 0) }
pub(package) fn ttable_get_trusted_sources(tt: i64) -> i64 { mem_load64_at(tt + 48, 0) }
pub(package) fn ttable_get_strict_sources(tt: i64) -> i64 { mem_load64_at(tt + 56, 0) }
pub(package) fn ttable_get_source_trust_grant_sources(tt: i64) -> i64 { mem_load64_at(tt + 64, 0) }
pub(package) fn ttable_source_is_trusted(tt: i64, src: i64) -> i64 {
  let trusted = ttable_get_trusted_sources(tt)
  let mut i = 0
  let mut found = 0
  while i < nlist_len(trusted) {
    if nlist_get(trusted, i) == src {
      found = 1
      i = nlist_len(trusted)
    } else { i = i + 1 }
  }
  found
}
pub(package) fn ttable_mark_trusted_source(tt: i64, src: i64) -> i64 {
  if ttable_source_is_trusted(tt, src) == 1 { 0 }
  else { nlist_add(ttable_get_trusted_sources(tt), src) }
}
pub(package) fn ttable_source_can_grant_trust(tt: i64, src: i64) -> i64 {
  let sources = ttable_get_source_trust_grant_sources(tt)
  let mut i = 0
  let mut found = 0
  while i < nlist_len(sources) {
    if nlist_get(sources, i) == src {
      found = 1
      i = nlist_len(sources)
    } else { i = i + 1 }
  }
  found
}
pub(package) fn ttable_mark_source_trust_grant_source(tt: i64, src: i64) -> i64 {
  if ttable_source_can_grant_trust(tt, src) == 1 { 0 }
  else { nlist_add(ttable_get_source_trust_grant_sources(tt), src) }
}
pub(package) fn ttable_source_is_strict(tt: i64, src: i64) -> i64 {
  let strict = ttable_get_strict_sources(tt)
  let mut i = 0
  let mut found = 0
  while i < nlist_len(strict) {
    if nlist_get(strict, i) == src {
      found = 1
      i = nlist_len(strict)
    } else { i = i + 1 }
  }
  found
}
pub(package) fn ttable_mark_strict_source(tt: i64, src: i64) -> i64 {
  if ttable_source_is_strict(tt, src) == 1 { 0 }
  else { nlist_add(ttable_get_strict_sources(tt), src) }
}

-- Native source entry: package id in tag; source, binding, selected target and
-- declaration facts in f1..f4. A declaration fact is node(symbol, DeclId).
pub(package) fn ttable_native_binding_sources(tt: i64) -> i64 { mem_load64_at(tt + 216, 0) }
pub(package) fn ttable_native_binding_source_count(tt: i64) -> i64 { nlist_len(ttable_native_binding_sources(tt)) }
pub(package) fn ttable_native_binding_source_at(tt: i64, index: i64) -> i64 { nlist_get(ttable_native_binding_sources(tt), index) }
pub(package) fn ttable_native_binding_source_package(entry: i64) -> i64 { node_tag(entry) }
pub(package) fn ttable_native_binding_source_source(entry: i64) -> i64 { node_f1(entry) }
pub(package) fn ttable_native_binding_source_binding(entry: i64) -> i64 { node_f2(entry) }
pub(package) fn ttable_native_binding_source_target(entry: i64) -> i64 { node_f3(entry) }
pub(package) fn ttable_native_binding_source_decls(entry: i64) -> i64 { node_f4(entry) }

pub(package) fn ttable_native_binding_source_find(tt: i64, src: i64) -> i64 {
  let entries = ttable_native_binding_sources(tt)
  let mut i = 0
  let mut found = 0
  while i < nlist_len(entries) and found == 0 {
    let entry = nlist_get(entries, i)
    if ttable_native_binding_source_source(entry) == src { found = entry } else { i = i + 1 }
  }
  found
}

pub(package) fn ttable_mark_native_binding_source(tt: i64, src: i64, package_id: i64, binding: i64, target: i64) -> i64 {
  let existing = ttable_native_binding_source_find(tt, src)
  if existing != 0 { existing }
  else {
    let entry = node_new(package_id, src, binding, target, nlist_new())
    nlist_add(ttable_native_binding_sources(tt), entry)
    entry
  }
}

pub(package) fn ttable_native_binding_source_add_decl(entry: i64, symbol: i64, decl: i64) -> i64 {
  let fact = node_new(0, symbol, decl, 0, 0)
  nlist_add(ttable_native_binding_source_decls(entry), fact)
  fact
}

pub(package) fn ttable_native_decl_fact_symbol(fact: i64) -> i64 { node_f1(fact) }
pub(package) fn ttable_native_decl_fact_decl(fact: i64) -> i64 { node_f2(fact) }

-- Resolve a synthetic native declaration back to its manifest symbol fact.
-- DeclId is the join key: lowering must never rediscover this relationship
-- from the declaration spelling, which is module-private and may collide.
pub(package) fn ttable_native_symbol_for_decl(tt: i64, decl: i64) -> i64 {
  let mut source_index = 0
  let mut found = 0
  while source_index < ttable_native_binding_source_count(tt) and found == 0 {
    let decls = ttable_native_binding_source_decls(ttable_native_binding_source_at(tt, source_index))
    let mut decl_index = 0
    while decl_index < nlist_len(decls) and found == 0 {
      let fact = nlist_get(decls, decl_index)
      if ttable_native_decl_fact_decl(fact) == decl {
        found = ttable_native_decl_fact_symbol(fact)
      } else { decl_index = decl_index + 1 }
    }
    source_index = source_index + 1
  }
  found
}

-- Copy an already-established source policy into a fresh semantic table.
-- This cannot mint authority: every positive bit must exist in source_tt.
pub(package) fn ttable_copy_source_policy(source_tt: i64, dest_tt: i64, src: i64) -> i64 {
  if ttable_source_is_trusted(source_tt, src) == 1 and ttable_source_is_trusted(dest_tt, src) == 0 {
    nlist_add(ttable_get_trusted_sources(dest_tt), src)
  } else { 0 }
  if ttable_source_is_strict(source_tt, src) == 1 { ttable_mark_strict_source(dest_tt, src) } else { 0 }
  if ttable_source_can_grant_trust(source_tt, src) == 1 and ttable_source_can_grant_trust(dest_tt, src) == 0 {
    nlist_add(ttable_get_source_trust_grant_sources(dest_tt), src)
  } else { 0 }
  let native = ttable_native_binding_source_find(source_tt, src)
  if native != 0 and ttable_native_binding_source_find(dest_tt, src) == 0 {
    nlist_add(ttable_native_binding_sources(dest_tt), native)
  } else { 0 }
  0
}
-- Entry layout: [ns(8), nl(8), kind(8), nfields(8), items(8), tparams(8), src(8), hash(8)] = 64 bytes.
-- Kinds: 0 record, 1 variant, 2 effect, 3 trait, 4 impl, 5 opaque
-- value type. For kind 5, nfields is zero and items is the representation type.
-- src stored per entry for cross-file name resolution
pub(package) fn ttable_add(tt: i64, src: i64, ns: i64, nl: i64, kind: i64, nfields: i64, fields: i64, tparams: i64) -> i64 {
  let n = mem_load64_at(tt + 8, 0)
  let cap = mem_load64_at(tt + 16, 0)
  if n >= cap {
    let d = mem_load64_at(tt, 0)
    let new_cap = cap * 2
    let new_d = type_registry_alloc_bytes(new_cap * 64)
    mem_copy(new_d, d, n * 64)
    mem_store64_at(tt, 0, new_d)
    mem_store64_at(tt + 16, 0, new_cap)
    0
  } else { 0 }
  let d = mem_load64_at(tt, 0)
  mem_store64_at(d + n * 64, 0, ns)
  mem_store64_at(d + n * 64 + 8, 0, nl)
  mem_store64_at(d + n * 64 + 16, 0, kind)
  mem_store64_at(d + n * 64 + 24, 0, nfields)
  mem_store64_at(d + n * 64 + 32, 0, fields)
  mem_store64_at(d + n * 64 + 40, 0, tparams)
  mem_store64_at(d + n * 64 + 48, 0, src)
  let name_hash = if kind == 3 { effect_name_hash(src, ns, nl) } else { type_name_hash(src, ns, nl) }
  mem_store64_at(d + n * 64 + 56, 0, name_hash)
  ttable_type_hash_index_add(tt, name_hash, kind, n)
  if kind == 0 or kind == 1 or kind == 5 {
    ttable_type_decl_index_add(
      tt,
      module_decl_fact_find(tt, src, module_decl_namespace_type(), src, ns, nl),
      n
    )
  } else { 0 }
  mem_store64_at(tt + 8, 0, n + 1)
  tt
}
pub(package) fn ttable_lookup(tt: i64, src: i64, ns: i64, nl: i64) -> i64 {
  -- Returns pointer to type entry, or 0 if not found
  -- Uses entry's stored src for cross-file correctness
  let n = mem_load64_at(tt + 8, 0)
  let d = mem_load64_at(tt, 0)
  let mut i = 0
  let mut result = 0
  while i < n {
    let e_ns = mem_load64_at(d + i * 64, 0)
    let e_nl = mem_load64_at(d + i * 64 + 8, 0)
    if e_nl == nl {
      let e_src = mem_load64_at(d + i * 64 + 48, 0)
      if src_eq_at(src, ns, e_src + e_ns, 0, nl) == 1 {
        result = d + i * 64
        i = n
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  result
}

pub(package) fn ttable_kind_matches_decl_namespace(kind: i64, namespace: i64) -> i64 {
  if namespace == module_decl_namespace_type() { if kind == 0 or kind == 1 or kind == 5 { 1 } else { 0 } }
  else { if namespace == module_decl_namespace_effect() { if kind == 2 { 1 } else { 0 } }
  else { if namespace == module_decl_namespace_trait() { if kind == 3 { 1 } else { 0 } }
  else { 0 } } }
}

pub(package) fn ttable_entry_opaque_representation(entry: i64) -> i64 {
  if entry != 0 and mem_load64_at(entry + 16, 0) == 5 { mem_load64_at(entry + 32, 0) } else { 0 }
}

-- Exact bridge from the semantic declaration fact to the bootstrap type-table
-- storage. This is the only sanctioned place for recovering the old entry;
-- callers resolve identity first and never pick a same-spelled global entry.
pub(package) fn ttable_lookup_decl_fact(tt: i64, decl: i64) -> i64 {
  if decl == 0 { 0 }
  else {
    let module_entry = module_decl_fact_module(decl)
    let decl_src = module_fact_entry_source(module_entry)
    let name_ptr = module_decl_fact_name_ptr(decl)
    let name_len = module_decl_fact_name_len(decl)
    let namespace = module_decl_fact_namespace(decl)
    let n = mem_load64_at(tt + 8, 0)
    let d = mem_load64_at(tt, 0)
    let mut i = 0
    let mut result = ttable_type_decl_index_find(tt, decl)
    let was_indexed = if result == 0 { 0 } else { 1 }
    while i < n and result == 0 {
      let entry = d + i * 64
      let entry_src = mem_load64_at(entry + 48, 0)
      let entry_len = mem_load64_at(entry + 8, 0)
      let kind = mem_load64_at(entry + 16, 0)
      if entry_src == decl_src and entry_len == name_len and ttable_kind_matches_decl_namespace(kind, namespace) == 1 {
        if src_eq_at(entry_src, mem_load64_at(entry, 0), name_ptr, 0, name_len) == 1 {
          result = entry
        } else { i = i + 1 }
      } else { i = i + 1 }
    }
    if result != 0 and was_indexed == 0 { ttable_type_decl_index_add(tt, decl, (result - d) / 64) } else { 0 }
    result
  }
}

pub(package) fn ttable_lookup_resolved_decl(tt: i64, caller_src: i64, namespace: i64, name_src: i64, name_start: i64, name_len: i64) -> i64 {
  let caller_module = module_fact_find_source(tt, caller_src)
  if caller_module == 0 {
    -- Embedded grammars ask about host types using their own source buffer.
    -- Until the TypeCheck effect carries an explicit host ModuleId, preserve
    -- that deliberate cross-language catalog lookup.
    ttable_lookup(tt, name_src, name_start, name_len)
  } else {
    let decl = module_scope_lookup_declaration(tt, caller_src, namespace, name_src, name_start, name_len)
    ttable_lookup_decl_fact(tt, decl)
  }
}
-- Get field index by name from a record type entry
-- entry_src = the source buffer the entry was parsed from
-- caller_src = the source buffer the lookup name is from
pub(package) fn ttable_field_index(entry: i64, entry_src: i64, caller_src: i64, field_ns: i64, field_nl: i64) -> i64 {
  let nfields = mem_load64_at(entry + 24, 0)
  let fields = mem_load64_at(entry + 32, 0)
  let mut i = 0
  let mut result = 0 - 1
  while i < nfields {
    let f_ns = mem_load64_at(fields + i * 24, 0)
    let f_nl = mem_load64_at(fields + i * 24 + 8, 0)
    if f_nl == field_nl {
      if src_eq_at(caller_src, field_ns, entry_src + f_ns, 0, field_nl) == 1 {
        result = i
        i = nfields
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  result
}

-- Find variant info by name. Returns tag_hash or -1 if not found.
-- Uses the entry's stored src for cross-file name comparison.
pub(package) fn ttable_find_field_by_type_hash(tt: i64, type_hash: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let n = mem_load64_at(tt + 8, 0)
  let d = mem_load64_at(tt, 0)
  let mut i = 0
  let mut result = 0 - 1
  while i < n {
    let kind = mem_load64_at(d + i * 64 + 16, 0)
    if kind == 0 {
      let entry_src = mem_load64_at(d + i * 64 + 48, 0)
      let type_ns = mem_load64_at(d + i * 64, 0)
      let type_nl = mem_load64_at(d + i * 64 + 8, 0)
      if str_hash(entry_src, type_ns, type_nl) == type_hash {
        let idx = ttable_field_index(d + i * 64, entry_src, src, ns, nl)
        if idx >= 0 { result = idx i = n } else { i = i + 1 }
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  result
}

pub(package) fn ttable_hash_has_kind(tt: i64, target_hash: i64, target_kind: i64) -> i64 {
  if tt == 0 { 0 }
  else {
    let n = mem_load64_at(tt + 8, 0)
    let d = mem_load64_at(tt, 0)
    let mut i = 0
    let mut found = 0
    while i < n {
      let entry = d + i * 64
      let kind = mem_load64_at(entry + 16, 0)
      if kind == target_kind {
        let entry_src = mem_load64_at(entry + 48, 0)
        let ns = mem_load64_at(entry, 0)
        let nl = mem_load64_at(entry + 8, 0)
        let entry_hash = mem_load64_at(entry, 56)
        if entry_hash == target_hash {
          found = 1
          i = n
        } else { i = i + 1 }
      } else { i = i + 1 }
    }
    found
  }
}

pub(package) fn ttable_hash_is_trait(tt: i64, target_hash: i64) -> i64 {
  ttable_hash_has_kind(tt, target_hash, 3)
}

-- parameterized effects: entry lookup by cached name hash + kind. Returns entry ptr or 0.
pub(package) fn ttable_find_entry_by_hash_kind(tt: i64, target_hash: i64, target_kind: i64) -> i64 {
  ttable_type_hash_index_find(tt, target_hash, target_kind)
}

pub(package) fn ttable_entry_tparams(entry: i64) -> i64 {
  if entry == 0 { 0 } else { mem_load64_at(entry + 40, 0) }
}

pub(package) fn ttable_entry_name_ptr(entry: i64) -> i64 {
  if entry == 0 { 0 } else { mem_load64_at(entry + 48, 0) + mem_load64_at(entry, 0) }
}

pub(package) fn ttable_entry_name_len(entry: i64) -> i64 {
  if entry == 0 { 0 } else { mem_load64_at(entry + 8, 0) }
}

pub(package) fn ttable_entry_kind(entry: i64) -> i64 {
  if entry == 0 { 0 - 1 } else { mem_load64_at(entry + 16, 0) }
}

pub(package) fn ttable_entry_item_count(entry: i64) -> i64 {
  if entry == 0 { 0 } else { mem_load64_at(entry + 24, 0) }
}

pub(package) fn ttable_entry_items(entry: i64) -> i64 {
  if entry == 0 { 0 } else { mem_load64_at(entry + 32, 0) }
}

pub(package) fn ttable_entry_source(entry: i64) -> i64 {
  if entry == 0 { 0 } else { mem_load64_at(entry + 48, 0) }
}

-- Simple string hash for variant tags (compile-time). The eight-wide
-- form is bit-identical to the byte loop: djb2's update distributes over
-- wrapping i64 arithmetic (h8 = h0*33^8 + sum b_i*33^(7-i)), and it cuts
-- the loop-carried multiply chain from eight to one per eight bytes.
-- Byte extraction shifts then masks, so the arithmetic-shift sign smear
-- never reaches a term.
pub(package) fn str_hash(src: i64, start: i64, len: i64) -> i64 {
  let mut h = 5381
  let mut i = 0
  while i + 8 <= len {
    let w = mem_load64(src + start + i)
    let wide = h * 1406408618241
    let t0 = (w band 255) * 42618442977
    let t1 = ((w bshr 8) band 255) * 1291467969
    let t2 = ((w bshr 16) band 255) * 39135393
    let t3 = ((w bshr 24) band 255) * 1185921
    let t4 = ((w bshr 32) band 255) * 35937
    let t5 = ((w bshr 40) band 255) * 1089
    let t6 = ((w bshr 48) band 255) * 33
    let t7 = (w bshr 56) band 255
    h = wide + t0 + t1 + t2 + t3 + t4 + t5 + t6 + t7
    i = i + 8
  }
  while i < len {
    h = h * 33 + mem_load8(src + start + i)
    i = i + 1
  }
  if h < 0 { 0 - h } else { h }
}

pub(package) fn effect_name_hash(src: i64, start: i64, len: i64) -> i64 {
  str_hash(src, start, len)
}

-- FieldAccess uses a negative source length for tuple positions. Tuple types
-- reserve the keys -1, -2, ... for positions 0, 1, ...; named fields retain
-- their ordinary stable source hash. Keeping this conversion shared prevents
-- the checker and lowering from independently interpreting surface spelling.
pub(package) fn field_access_is_tuple_position(name_len: i64) -> i64 {
  if name_len < 0 { 1 } else { 0 }
}

pub(package) fn field_access_source_len(name_len: i64) -> i64 {
  if name_len < 0 { 0 - name_len } else { name_len }
}

pub(package) fn field_access_tuple_position(src: i64, name_start: i64, name_len: i64) -> i64 {
  if name_len < 0 { decimal_span_value_wrapping(src, name_start, 0 - name_len) } else { 0 - 1 }
}

pub(package) fn field_access_key(src: i64, name_start: i64, name_len: i64) -> i64 {
  if name_len < 0 { 0 - field_access_tuple_position(src, name_start, name_len) - 1 }
  else { str_hash(src, name_start, name_len) }
}

pub(package) fn type_name_hash(src: i64, ns: i64, nl: i64) -> i64 {
  if src_eq(src, ns, nl, "i64") == 1 { 0 - 1 }
  else { if src_eq(src, ns, nl, "str") == 1 { 0 - 2 }
  else { if src_eq(src, ns, nl, "bool") == 1 { 0 - 3 }
  else { if src_eq(src, ns, nl, "nil") == 1 { 0 - 4 }
  else { if src_eq(src, ns, nl, "f64") == 1 { 0 - 5 }
  else { if src_eq(src, ns, nl, "i32") == 1 { 0 - 6 }
  else { if src_eq(src, ns, nl, "i8") == 1 { 0 - 7 }
  else { if src_eq(src, ns, nl, "i16") == 1 { 0 - 8 }
  else { if src_eq(src, ns, nl, "u8") == 1 { 0 - 9 }
  else { if src_eq(src, ns, nl, "u16") == 1 { 0 - 10 }
  else { if src_eq(src, ns, nl, "u32") == 1 { 0 - 11 }
  else { if src_eq(src, ns, nl, "u64") == 1 { 0 - 12 }
  else { if src_eq(src, ns, nl, "isize") == 1 { 0 - 13 }
  else { if src_eq(src, ns, nl, "usize") == 1 { 0 - 14 }
  else { if src_eq(src, ns, nl, "f32") == 1 { 0 - 15 }
  else { effect_name_hash(src, ns, nl) } } } } } } } } } } } } } } }
}
