-- Relocatable inputs retain their container identity through the shared link
-- graph. Target selection chooses the parser; later semantic operations match
-- this typed variant directly rather than guessing from bytes or projecting an
-- ELF object into a Mach-O-shaped record.
pub(package) type NativeLinkElfObject {
  NativeLinkElfObject(i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, List<NativeLinkObjectDataSection>)
