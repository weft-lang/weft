      list_cons<JsonEntry>(json_entry("name", json_string(name)),
      list_cons<JsonEntry>(json_entry("content", json_string(content)),
      list_cons<JsonEntry>(json_entry("symbols", native_link_artifact_symbol_facts_json(symbols)), list_nil<JsonEntry>())))
    ) |> json_object
