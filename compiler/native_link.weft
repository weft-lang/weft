        0
      }
    }
  }
  json_array(items)
}

pub(package) fn native_link_artifact_member_fact_json(fact: NativeArtifactMemberFact) -> Json {
  match fact {
    NativeArtifactMemberFact(ordinal, name, content, symbols) -> list_cons<JsonEntry>(
