pub(package) fn native_link_plan_library_count(plan: NativeLinkPlan) -> i64 {
  list_len<NativeLinkLibrary>(native_link_plan_libraries(plan))
}

pub(package) fn native_link_plan_import_count(plan: NativeLinkPlan) -> i64 {
  list_len<NativeLinkImport>(native_link_plan_imports(plan))
}

pub(package) fn native_link_plan_relocation_count(plan: NativeLinkPlan) -> i64 {
  list_len<NativeLinkPlanRelocation>(native_link_plan_relocations(plan))
}

pub(package) fn native_link_dynamic_load_from_command(command: i64, identity: NativeLinkByteView) -> NativeLinkDynamicLoad {
  match command {
    12 -> NativeLinkRequiredDynamicLoad(identity)
    2147483672 -> NativeLinkWeakDynamicLoad(identity)
    2147483679 -> NativeLinkReexportDynamicLoad(identity)
    2147483683 -> NativeLinkUpwardDynamicLoad(identity)
    _ -> NativeLinkLazyDynamicLoad(identity)
  }
}

-- Parse the install identity and exact dependency closure from an acquired
-- aarch64 Mach-O dylib. The selected path remains provenance: only LC_ID_DYLIB
-- and the typed LC_LOAD_* family become loader semantics.
pub(package) fn native_link_macho_dynamic_image(bytes: i64, len: i64) -> NativeLinkDynamicImageParse {
  if len < 32 or bytes_u32_le_at(bytes, len, 0, 0) != 4277009103 or
    bytes_u32_le_at(bytes, len, 4, 0) != 16777228 or bytes_u32_le_at(bytes, len, 12, 0) != 6 {
    NativeLinkDynamicImageMalformed
  } else {
    let command_count = bytes_u32_le_at(bytes, len, 16, 0)
    let command_bytes = bytes_u32_le_at(bytes, len, 20, 0)
    let command_end = 32 + command_bytes
    if command_end > len {
      NativeLinkDynamicImageMalformed
    } else {
      let mut cursor = 32
      let mut index = 0
      let mut malformed = false
      let mut identity_ptr = 0
      let mut identity_len = 0
      let mut loads = list_nil<NativeLinkDynamicLoad>()
      while index < command_count and malformed == false {
        let command = bytes_u32_le_at(bytes, command_end, cursor, 0 - 1)
        let command_size = bytes_u32_le_at(bytes, command_end, cursor + 4, 0)
        if command_size < 8 or command_size % 8 != 0 or cursor + command_size > command_end {
          malformed = true
        } else {
          if command == 13 or command == 12 or command == 2147483672 or
            command == 2147483679 or command == 2147483683 or command == 32 {
            let name_offset = bytes_u32_le_at(bytes, command_end, cursor + 8, 0)
            let name_start = cursor + name_offset
            let name_len = if name_offset < 24 or name_start >= cursor + command_size { 0 - 1 }
            else { bytes_cstr_len_bounded(bytes, cursor + command_size, name_start) }
            if name_len <= 0 { malformed = true }
            else { if command == 13 {
              if identity_len != 0 { malformed = true }
              else {
                identity_ptr = bytes + name_start
                identity_len = name_len
              }
            } else {
              let load_identity = NativeLinkByteView(bytes + name_start, name_len)
              loads = list_append<NativeLinkDynamicLoad>(loads, native_link_dynamic_load_from_command(command, load_identity))
            } }
          } else { 0 }
          cursor = cursor + command_size
          index = index + 1
        }
      }
      if malformed or cursor != command_end { NativeLinkDynamicImageMalformed }
      else { if identity_len == 0 { NativeLinkDynamicImageIdentityMissing }
      else { NativeLinkDynamicImageParsed(NativeLinkDynamicImage(NativeLinkByteView(identity_ptr, identity_len), loads)) } }
    }
  }
}

pub(package) fn native_link_elf_virtual_file_offset(bytes: i64, len: i64, program_offset: i64, program_count: i64, address: i64) -> i64 {
  let mut index = 0
  let mut found = 0 - 1
  while index < program_count and found < 0 {
    let program = program_offset + index * 56
    if bytes_u32_le_at(bytes, len, program, 0) == 1 {
      let file_offset = bytes_u64_le_at(bytes, len, program + 8, 0 - 1)
      let virtual_address = bytes_u64_le_at(bytes, len, program + 16, 0 - 1)
      let file_size = bytes_u64_le_at(bytes, len, program + 32, 0 - 1)
      if file_offset >= 0 and virtual_address >= 0 and file_size >= 0 and
        address >= virtual_address and address < virtual_address + file_size {
        found = file_offset + address - virtual_address
      } else { index = index + 1 }
    } else { index = index + 1 }
  }
  if found >= 0 and found < len { found } else { 0 - 1 }
}

-- Parse the loader identity and exact DT_NEEDED closure from an acquired
-- AArch64 ELF shared object. PT_DYNAMIC and PT_LOAD are the semantic source;
-- section names and the selected filesystem path are not loader metadata.
pub(package) fn native_link_elf_dynamic_image(bytes: i64, len: i64) -> NativeLinkDynamicImageParse {
  if len < 64 or bytes_u32_le_at(bytes, len, 0, 0) != 1179403647 or
    bytes_u8_at(bytes, len, 4, 0) != 2 or bytes_u8_at(bytes, len, 5, 0) != 1 or
    bytes_u8_at(bytes, len, 6, 0) != 1 or native_link_u16_le_at(bytes, len, 16, 0) != 3 or
    native_link_u16_le_at(bytes, len, 18, 0) != 183 or bytes_u32_le_at(bytes, len, 20, 0) != 1 or
    native_link_u16_le_at(bytes, len, 54, 0) != 56 {
    NativeLinkDynamicImageMalformed
  } else {
    let program_offset = bytes_u64_le_at(bytes, len, 32, 0 - 1)
    let program_count = native_link_u16_le_at(bytes, len, 56, 0)
    let mut malformed = program_count == 0 or program_offset < 0 or program_offset + program_count * 56 > len
    let mut dynamic_offset = 0 - 1
    let mut dynamic_size = 0
    let mut program_index = 0
    while program_index < program_count and malformed == false {
      let program = program_offset + program_index * 56
      if bytes_u32_le_at(bytes, len, program, 0) == 2 {
        let offset = bytes_u64_le_at(bytes, len, program + 8, 0 - 1)
        let size = bytes_u64_le_at(bytes, len, program + 32, 0 - 1)
        if dynamic_offset >= 0 or offset < 0 or size < 16 or size % 16 != 0 or offset + size > len {
          malformed = true
        } else {
          dynamic_offset = offset
          dynamic_size = size
        }
      } else { 0 }
      program_index = program_index + 1
    }
    let mut string_address = 0 - 1
    let mut string_size = 0 - 1
    let mut identity_index = 0 - 1
    let mut needed = list_nil<i64>()
    let mut cursor = dynamic_offset
    let mut terminated = false
    while malformed == false and terminated == false and cursor >= 0 and cursor < dynamic_offset + dynamic_size {
      let tag = bytes_u64_le_at(bytes, len, cursor, 0 - 1)
      let value = bytes_u64_le_at(bytes, len, cursor + 8, 0 - 1)
      if tag < 0 or value < 0 { malformed = true }
      else {
        match tag {
          0 -> { terminated = true 0 }
          1 -> { needed = list_append<i64>(needed, value) 0 }
          5 -> { if string_address < 0 { string_address = value } else { malformed = true } 0 }
          10 -> { if string_size < 0 { string_size = value } else { malformed = true } 0 }
          14 -> { if identity_index < 0 { identity_index = value } else { malformed = true } 0 }
          _ -> 0
        }
        cursor = cursor + 16
      }
    }
    if terminated == false { malformed = true } else { 0 }
    let string_offset = if malformed { 0 - 1 }
      else { native_link_elf_virtual_file_offset(bytes, len, program_offset, program_count, string_address) }
    if string_offset < 0 or string_size <= 0 or string_offset + string_size > len { malformed = true } else { 0 }
    if malformed { NativeLinkDynamicImageMalformed }
    else {
      if identity_index < 0 { NativeLinkDynamicImageIdentityMissing }
      else {
        let identity_start = string_offset + identity_index
        let identity_len = if identity_index >= string_size { 0 - 1 }
          else { bytes_cstr_len_bounded(bytes, string_offset + string_size, identity_start) }
        if identity_len <= 0 { NativeLinkDynamicImageMalformed }
        else {
          let mut loads = list_nil<NativeLinkDynamicLoad>()
          let mut current = needed
          let mut loads_malformed = false
          let mut done = false
          while done == false and loads_malformed == false {
            match current {
              Nil -> { done = true 0 }
              Cons(index, rest) -> {
                let start = string_offset + index
                let needed_len = if index >= string_size { 0 - 1 }
                  else { bytes_cstr_len_bounded(bytes, string_offset + string_size, start) }
                if needed_len <= 0 { loads_malformed = true }
                else {
                  loads = list_append<NativeLinkDynamicLoad>(loads, NativeLinkRequiredDynamicLoad(NativeLinkByteView(bytes + start, needed_len)))
                  current = rest
                }
                0
              }
            }
          }
          if loads_malformed { NativeLinkDynamicImageMalformed }
          else {
            NativeLinkDynamicImageParsed(NativeLinkDynamicImage(NativeLinkByteView(bytes + identity_start, identity_len), loads))
          }
        }
      }
    }
  }
}

pub(package) fn native_link_dynamic_image_for_target(bytes: i64, len: i64, target: NativeLinkTarget) -> NativeLinkDynamicImageParse {
  match target {
    NativeLinkMacosAarch64 -> native_link_macho_dynamic_image(bytes, len)
    NativeLinkLinuxAarch64 -> native_link_elf_dynamic_image(bytes, len)
  }
}

pub(package) fn native_link_dynamic_image_identity(image: NativeLinkDynamicImage) -> NativeLinkByteView {
  match image { NativeLinkDynamicImage(identity, loads) -> identity }
}

pub(package) fn native_link_dynamic_image_loads(image: NativeLinkDynamicImage) -> List<NativeLinkDynamicLoad> {
  match image { NativeLinkDynamicImage(identity, loads) -> loads }
}

pub(package) fn native_link_dynamic_load_view(load: NativeLinkDynamicLoad) -> NativeLinkByteView {
  match load {
    NativeLinkRequiredDynamicLoad(identity) -> identity
    NativeLinkWeakDynamicLoad(identity) -> identity
    NativeLinkReexportDynamicLoad(identity) -> identity
    NativeLinkUpwardDynamicLoad(identity) -> identity
    NativeLinkLazyDynamicLoad(identity) -> identity
  }
}

pub(package) fn native_link_dynamic_load_identity(load: NativeLinkDynamicLoad) -> str {
  let view = native_link_dynamic_load_view(load)
  pkg_str_view(native_link_byte_view_ptr(view), native_link_byte_view_len(view))
}

pub(package) fn native_link_byte_view_ptr(view: NativeLinkByteView) -> i64 {
  match view { NativeLinkByteView(ptr, len) -> ptr }
}

pub(package) fn native_link_byte_view_len(view: NativeLinkByteView) -> i64 {
  match view { NativeLinkByteView(ptr, len) -> len }
}

